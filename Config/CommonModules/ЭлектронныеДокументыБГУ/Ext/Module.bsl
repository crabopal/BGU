// Работа с деревом данных ФНС.

// Подготавливает данные для электронного документа типа УПД (информация продавца).
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо 
//                                    создать электронный документ.
//  СтруктураЭД - Структура - структура данных для формирования электронного документа.
//  ДеревоДанных - ДеревоЗначений - дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеДляУПДИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	ДанныеЗаполнены = Ложь;
	ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ, ДанныеЗаполнены);
	
	Если НЕ Отказ Тогда
		Если НЕ ДанныеЗаполнены Тогда
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

// Подготавливает данные для электронного документа типа УПД (информация продавца).
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо 
//                                    создать электронный документ.
//  СтруктураЭД - Структура - структура данных для формирования электронного документа.
//  ДеревоДанных - ДеревоЗначений - дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь, ДанныеЗаполнены = Ложь) Экспорт
	
	ЭтоИсправительныйСФ = Ложь;
	ТипДокумента = ТипЗнч(СсылкаНаОбъект);
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ДокументСсылкаСЧФ = СсылкаНаОбъект;
		Если СтруктураЭД.Функция = "СЧФДОП" Тогда //СЧФДОПУПД
			Если ЗначениеЗаполнено(ДокументСсылкаСЧФ.ДокументОснование) Тогда
				ДокументСсылкаДОП = ДокументСсылкаСЧФ.ДокументОснование;
			Иначе
				ШаблонСообщения = НСтр("ru = 'Для %1 универсальный передаточный документ не применяется.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ДокументСсылкаСЧФ);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ЭтоИсправительныйСФ = Истина;
		ДокументСсылкаСЧФ = СсылкаНаОбъект;
		
		Если ТипЗнч(ДокументСсылкаСЧФ.ИсправляемыйДокумент) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
			
			ЗаполнитьДанныеДляКСЧФИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных);
			ДанныеЗаполнены = Истина;
			
			Возврат;
		КонецЕсли;	
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
				ИЛИ	ТипДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг")
				ИЛИ	ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовОС")
				ИЛИ	ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовИК")
				ИЛИ	ТипДокумента = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
				ИЛИ	ТипДокумента = Тип("ДокументСсылка.ЭлектронныйПередаточныйДокументУслугиРаботы") Тогда
		
		ДокументСсылкаДОП = СсылкаНаОбъект;
		СчетФактура = НайтиПодчиненныйСчетФактуруВыданный(ДокументСсылкаДОП);
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ДокументСсылкаСЧФ = СчетФактура;
		Иначе
			Отказ = Истина;
			ШаблонСообщения = НСтр("ru = 'По документу %1 счет-фактура не выписан.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ДокументСсылкаДОП);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
	Иначе
		ДокументСсылкаДОП = Неопределено;
		СчетФактура = НайтиПодчиненныйСчетФактуруВыданный(СсылкаНаОбъект);
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ДокументСсылкаСЧФ = СчетФактура;
		Иначе
			Отказ = Истина;
			ШаблонСообщения = НСтр("ru = 'По документу %1 счет-фактура не выписан.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, СсылкаНаОбъект);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоИсправительныйСФ Тогда
		ПодготовитьДанныеПоИсправительномуСчетуФактуреУПД(ДокументСсылкаСЧФ, СтруктураЭД, ДеревоДанных, Отказ);
		ДанныеЗаполнены = Истина;
	Иначе
		ПодготовитьДанныеПоСчетуФактуреУПД(ДокументСсылкаСЧФ, СтруктураЭД, ДеревоДанных, Отказ);
		ДанныеЗаполнены = Истина;
	КонецЕсли;	
	
КонецПроцедуры

// Подготавливает данные для электронного документа типа УПД (информация продавца).
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо 
//                                    создать электронный документ.
//  СтруктураЭД - Структура - структура данных для формирования электронного документа.
//  ДеревоДанных - ДеревоЗначений - дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	
	ТипДокумента = ТипЗнч(СсылкаНаОбъект);
	
	ЭтоРеализация = Ложь;
	ЭтоТовары = Ложь;
	ЭтоУслуги = Ложь;
	ЭтоСчетФактура = Ложь;
	Если ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ЭтоРеализация = Истина;
		ЭтоТовары = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		ЭтоРеализация = Истина;
		ЭтоТовары = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		ЭтоРеализация = Истина;
		ЭтоТовары = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
		ЭтоРеализация = Истина;
		ЭтоТовары = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ЭтоРеализация = Истина;
		ЭтоУслуги = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЭлектронныйПередаточныйДокументУслугиРаботы") Тогда
		ЭтоРеализация = Истина;
		ЭтоУслуги = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЭтоСчетФактура = Истина;
	КонецЕсли;	
	
	Если ЭтоРеализация Тогда
		ДокументСсылкаДОП = СсылкаНаОбъект;
		Если СтруктураЭД.Функция = "СЧФДОП" Тогда //СЧФДОПУПД
			СчетФактура = НайтиПодчиненныйСчетФактуруВыданный(ДокументСсылкаДОП);
			Если ЗначениеЗаполнено(СчетФактура) Тогда
				ДокументСсылкаСЧФ = СчетФактура;
			Иначе
				Отказ = Истина;
				ШаблонСообщения = НСтр("ru = 'По документу %1 счет-фактура не выписан.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ДокументСсылкаДОП);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ЭтоСчетФактура Тогда
		ДокументСсылкаСЧФ = СсылкаНаОбъект;
		Если ЗначениеЗаполнено(ДокументСсылкаСЧФ.ДокументОснование) Тогда
			ДокументСсылкаДОП = ДокументСсылкаСЧФ.ДокументОснование;
			ТипДокумента = ТипЗнч(ДокументСсылкаДОП);
			
			Если ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
				ЭтоРеализация = Истина;
				ЭтоТовары = Истина;
			ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
				ЭтоРеализация = Истина;
				ЭтоТовары = Истина;
			ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
				ЭтоРеализация = Истина;
				ЭтоТовары = Истина;
			ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
				ЭтоРеализация = Истина;
				ЭтоТовары = Истина;
			ИначеЕсли	ТипДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
				ЭтоРеализация = Истина;
				ЭтоУслуги = Истина;
			ИначеЕсли	ТипДокумента = Тип("ДокументСсылка.ЭлектронныйПередаточныйДокументУслугиРаботы") Тогда
				ЭтоРеализация = Истина;
				ЭтоУслуги = Истина;
			КонецЕсли;	
		Иначе
			Отказ = Истина;
			ШаблонСообщения = НСтр("ru = 'Для %1 универсальный передаточный документ не применяется.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ДокументСсылкаСЧФ);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоРеализация Тогда
		Если СтруктураЭД.Функция = "ДОП" Тогда //ДОПУПД
			Если ЭтоТовары Тогда 
				ЗаполнитьДанныеПоТорг12ПродавецУПД(ДокументСсылкаДОП, СтруктураЭД, ДеревоДанных, Отказ);
			ИначеЕсли ЭтоУслуги Тогда
				ЗаполнитьДанныеПоАкт501ИсполнительУПД(ДокументСсылкаДОП, СтруктураЭД, ДеревоДанных, Отказ);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Подготавливает данные для электронного документа типа УКД (информация продавца).
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо
//                                    создать электронный документ.
//  СтруктураЭД - Структура - структура данных для формирования электронного документа.
//  ДеревоДанных - ДеревоЗначений - дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеДляУКДИнформацияПродавцаФНС(Знач Основание, Знач Настройки, Данные, Описание, Отказ) Экспорт
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	СсылкаНаОбъект = Основание;
	
	ЗаполнитьДанныеДляДИСИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, Данные, Отказ);
	
	ЗаполнитьДанныеДляКСЧФИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, Данные, Отказ);
	
КонецПроцедуры

// Подготавливает данные для электронного документа типа УКД (информация продавца).
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо
//                                    создать электронный документ.
//  СтруктураЭД - Структура - структура данных для формирования электронного документа.
//  ДеревоДанных - ДеревоЗначений - дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеДляДИСИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	
	
	
КонецПроцедуры

// Подготавливает данные для электронного документа типа УКД (информация покупателя).
//
// Параметры:
//  СсылкаНаЭД - Ссылка - ссылка на ЭД, по которому необходимо сформировать электронный документ.
//  СтруктураЭД - Структура - структура данных для формирования электронного документа.
//  ДеревоДанных - ДеревоЗначений - дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеДляУКДИнформацииПокупателяФНС(Основания, ДеревоДанных, Отказ)Экспорт
	
	ОрганизацияСоставитель = Справочники.Организации.ПустаяСсылка();
	Если Основания.Количество() = 0 Тогда
		ЕдинственнаяОрганизация(ОрганизацияСоставитель);
	Иначе	
		Для Каждого ТекСтрока Из Основания Цикл
			ОрганизацияСоставитель = ТекСтрока.Организация;
		КонецЦикла;
	КонецЕсли;
	
	СведенияОПокупателе = Новый Структура;
	Если ЗначениеЗаполнено(ОрганизацияСоставитель) Тогда
		ПолучитьДанныеЮрФизЛица(ОрганизацияСоставитель, СведенияОПокупателе);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СведенияОПокупателе.ПолноеНаименование);
	КонецЕсли;	

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаСогласования", ТекущаяДатаСеанса());
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", "С изменением стоимости согласен.");
	
КонецПроцедуры

// Подготавливает данные для электронного документа типа УКД (информация продавца).
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо
//                                    создать электронный документ.
//  СтруктураЭД - Структура - структура данных для формирования электронного документа.
//  ДеревоДанных - ДеревоЗначений - дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеДляКСЧФИнформацияПродавцаФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	
	ТипДокумента = ТипЗнч(СсылкаНаОбъект);
	
	Если ТипДокумента = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		ПодготовитьДанныеПоКорректировочномуСчетуФактуреУКД(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Истина, Отказ);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ПодготовитьДанныеПоИсправительномуСчетуФактуре_КорректировкаУКД(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ);
		
	Иначе
		ШаблонСообщения = НСтр("ru = 'Для %1 универсальный передаточный документ не применяется.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, СсылкаНаОбъект);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Работа с деревом данных ФНС. Служебные

Процедура ЗаполнитьДанныеПоТорг12ПродавецУПД(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	НетЗамечанийКДокументу = Документы[СсылкаНаОбъект.Метаданные().Имя].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ДанныеДляПечати = Документы[СсылкаНаОбъект.Метаданные().Имя].ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
	РеквизитыШапки = ДанныеДляПечати[0].Выбрать();
	ТабличнаяЧасть = ДанныеДляПечати[1].Выгрузить();
	ДобавитьИДНоменклатурыВТаблицу(ТабличнаяЧасть);
	
	РеквизитыШапки.Следующий();
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", РеквизитыШапки.Номер);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  РеквизитыШапки.Дата);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаОтгрузкиТоваров", РеквизитыШапки.Дата);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки", РеквизитыШапки.ДокументОснование);
	
	Если СтруктураЭД.Функция = "ДОП" Тогда //ДОПУПД
	
		Грузоотправитель = ?(ЗначениеЗаполнено(РеквизитыШапки.Грузоотправитель), РеквизитыШапки.Грузоотправитель, РеквизитыШапки.Организация);
		СчетГрузоотправителя = ?(ЗначениеЗаполнено(РеквизитыШапки.СчетГрузоотправителя), РеквизитыШапки.СчетГрузоотправителя, РеквизитыШапки.РеквизитыЛицевогоСчета);
		ЛСГрузоотправителя = ?(Грузоотправитель = РеквизитыШапки.Организация, РеквизитыШапки.ЛицевойСчет, Неопределено);
		
		Грузополучатель = ?(ЗначениеЗаполнено(РеквизитыШапки.Грузополучатель), РеквизитыШапки.Грузополучатель, РеквизитыШапки.Контрагент);
		СчетГрузополучателя = ?(ЗначениеЗаполнено(РеквизитыШапки.СчетГрузополучателя), РеквизитыШапки.СчетГрузополучателя, РеквизитыШапки.СчетПлательщика);
		
		ЗаполнитьДанныеУчастникаУПД(Грузоотправитель, "СведенияОГрузоотправителе.Грузоотправитель", РеквизитыШапки.Дата, ДеревоДанных, 
								 ЛСГрузоотправителя, СчетГрузоотправителя);
		ЗаполнитьДанныеУчастникаУПД(Грузополучатель, "СведенияОГрузополучателе", РеквизитыШапки.Дата, ДеревоДанных,  
								СчетГрузополучателя);
		ЗаполнитьДанныеУчастникаУПД(РеквизитыШапки.Организация, "СведенияОПродавце", РеквизитыШапки.Дата, ДеревоДанных, 
								РеквизитыШапки.ЛицевойСчет, РеквизитыШапки.РеквизитыЛицевогоСчета);
		ЗаполнитьДанныеУчастникаУПД(РеквизитыШапки.Контрагент, "СведенияОПокупателе", РеквизитыШапки.Дата, ДеревоДанных, 
								РеквизитыШапки.СчетПлательщика,,,,,);
								
		СоставительДокументаНаименование = РеквизитыШапки.Организация.НаименованиеПолное;
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СоставительДокументаНаименование);
		
		Если Грузоотправитель = РеквизитыШапки.Организация Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"СведенияОГрузоотправителе.ОнЖе", Истина);
		КонецЕсли;
		
		ИдентификаторГосКонтракта = ИдентификаторГосКонтрактаГОЗ(РеквизитыШапки.Договор);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", ИдентификаторГосКонтракта);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаНаименование", ВалютаРегУчета.Наименование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаКурс", РеквизитыШапки.Курс);
			
		ТаблицаТоваров = СоздатьТаблицуТоваровУПД();
		НомерСтроки = 1;
		ТолькоУслуги = Ложь;
		
		Для Каждого ТекСтрока Из ТабличнаяЧасть Цикл
			НоваяСтрока = ТаблицаТоваров.Добавить();
			НоваяСтрока.НомерСтроки = НомерСтроки;
			
			НоваяСтрока.ТоварИдентификатор = ТекСтрока.Номенклатура.УникальныйИдентификатор();
			НоваяСтрока.ТоварНаименование  = ТекСтрока.НаименованиеНоменклатуры;
			НоваяСтрока.ТоварКод           = ТекСтрока.КодТовара;
			
			Если ЗначениеЗаполнено(ТекСтрока.Номенклатура.СтранаПроисхождения) Тогда
				СведенияОТаможеннойДекларации = Новый ТаблицаЗначений;
				СведенияОТаможеннойДекларации.Колонки.Добавить("СтранаПроисхожденияКод", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
				СведенияОТаможеннойДекларации.Колонки.Добавить("ТаможеннаяДекларацияНомер", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(29)));
				СтрокаТД = СведенияОТаможеннойДекларации.Добавить();
				СтранаПроисхожденияКод = ?(ЗначениеЗаполнено(ТекСтрока.Номенклатура.СтранаПроисхождения), ТекСтрока.Номенклатура.СтранаПроисхождения.Код, "");
				СтрокаТД.СтранаПроисхожденияКод = СтранаПроисхожденияКод;
				СтрокаТД.ТаможеннаяДекларацияНомер = ?(ЗначениеЗаполнено(ТекСтрока.Номенклатура.НомерГТД), ТекСтрока.Номенклатура.НомерГТД.Код, "");
				Если НЕ(СтранаПроисхожденияКод = "") Тогда
					НоваяСтрока.СведенияОТаможеннойДекларации = СведенияОТаможеннойДекларации;
					НоваяСтрока.СтранаПроисхожденияНаименование = ?(ЗначениеЗаполнено(ТекСтрока.Номенклатура.СтранаПроисхождения), ТекСтрока.Номенклатура.СтранаПроисхождения.Наименование, "");
					
					ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(НоваяСтрока.СведенияОТаможеннойДекларации, "СтранаПроисхожденияКод",,,
						НСтр("ru = 'Не заполнен код страны происхождения'"));
				КонецЕсли;
			КонецЕсли;
			Если ПустаяСтрока(ТекСтрока.БазоваяЕдиницаКод) Тогда
				ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрока.Номенклатура, "ЕдиницаИзмерения");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда // берем значение ед. измерения из карточки номенклатуры
					РеквизитыЕдиницыИзмерения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдиницаИзмерения, "Наименование, Код");
					НоваяСтрока.ЕдиницаИзмеренияКод          = СокрЛП(РеквизитыЕдиницыИзмерения.Код);
					НоваяСтрока.ЕдиницаИзмеренияНаименование = СокрЛП(РеквизитыЕдиницыИзмерения.Наименование);
				КонецЕсли;
			Иначе
				НоваяСтрока.ЕдиницаИзмеренияКод          = СокрЛП(ТекСтрока.БазоваяЕдиницаКод);
				НоваяСтрока.ЕдиницаИзмеренияНаименование = СокрЛП(ТекСтрока.ЕдиницаИзмерения);
			КонецЕсли;
			
			НоваяСтрока.Признак = ТекСтрока.Признак;
			НоваяСтрока.ПризнакДополнительнаяИнформация = ТекСтрока.ПризнакДополнительнаяИнформация;
			
			НоваяСтрока.Количество					= ТекСтрока.Количество;
			НоваяСтрока.ЦенаЗаЕдиницуИзмерения		= ТекСтрока.Цена ;
			НоваяСтрока.СтоимостьТоваровБезНалога	= ТекСтрока.СуммаСНДС - ТекСтрока.СуммаНДС;
			НоваяСтрока.СтоимостьТоваровСНалогом   	= ТекСтрока.СуммаСНДС;
			НоваяСтрока.СуммаНалога                	= ТекСтрока.СуммаНДС;
			НоваяСтрока.НалоговаяСтавка				= ТекСтрока.СтавкаНДС;
			
			НоваяСтрока.СуммаАкциза                 = 0;
			
			Сопоставление = Новый Структура;
			Сопоставление.Вставить("Наименование", НоваяСтрока.ТоварНаименование);
			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(НоваяСтрока.ЕдиницаИзмеренияКод);
			
			Сопоставление.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения.Наименование);
			Сопоставление.Вставить("Артикул", "");
			
			ХарактеристикаНаименование = "";
			Сопоставление.Вставить("Характеристика", ХарактеристикаНаименование);
			ШтрихкодыТовара = "";
			Сопоставление.Вставить("Штрихкод", ШтрихкодыТовара);
			УпаковкаИБ = "";
			
			Сопоставление.Вставить("НоменклатураИБ", ТекСтрока.Номенклатура);
			Сопоставление.Вставить("ХарактеристикаИБ", ХарактеристикаНаименование);
			Сопоставление.Вставить("УпаковкаИБ", УпаковкаИБ);
			НоваяСтрока.Сопоставление = Сопоставление;
			
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
			"Количество", "Количество", "Количество", 
			НСтр("ru = 'Не указано количество товара в табличной части.'"));
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
			"ЕдиницаИзмеренияНаименование", "ЕдиницаИзмеренияНаименование", "ЕдиницаИзмерения", 
			НСтр("ru = 'Не заполнена наименование единицы измерения в справочнике ""Номенклатура"".'"));
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
			"ЕдиницаИзмеренияКод", "ЕдиницаИзмеренияКод", "ЕдиницаИзмерения", 
			НСтр("ru = 'Не заполнен код единицы измерения в справочнике ""Номенклатура"".'"));
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "СведенияОТоварах");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);

		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогом"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСуммаНалога", ТаблицаТоваров.Итог("СуммаНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоКоличество", ТаблицаТоваров.Итог("Количество"));
		
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", Перечисления.ВидыОперацийЭД.ПродажаКомиссия);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", НСтр("ru = 'Товары переданы.'"));
	
	Если Не ЗначениеЗаполнено(РеквизитыШапки.Валюта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ВалютаДокумента");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(РеквизитыШапки.Валюта, 
			"Объект.Код");
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыШапки.ВалютаКод, ПараметрыОбработкиОшибок);
	
	ОснованиеОтгрузкиТоваров = Новый ТаблицаЗначений;
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНаименование");
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНомер");
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДата");
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДопСведения");
	
	Если ЗначениеЗаполнено(РеквизитыШапки.ДокументОснованиеДата)
		ИЛИ ЗначениеЗаполнено(РеквизитыШапки.ДокументОснованиеНомер) Тогда
		НоваяСтрока = ОснованиеОтгрузкиТоваров.Добавить();
		НоваяСтрока.ДокументНаименование = РеквизитыШапки.ДокументОснованиеНаименование;
		НоваяСтрока.ДокументНомер = РеквизитыШапки.ДокументОснованиеНомер;
		НоваяСтрока.ДокументДата = НачалоДня(РеквизитыШапки.ДокументОснованиеДата);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ОснованиеОтгрузкиТоваров,
		"ДокументДата", "ДокументДата", "Объект.Договор.ДатаДоговора", 
		НСтр("ru = 'Не заполнена дата договора для реквизита ""Договор"".'"));
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованиеОтгрузкиТоваров, "ОснованиеОтгрузкиТоваров");
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОТранспортировке", "");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ИныеСведенияОбОтгрузке", "");
	
	ТранспортнаяНакладная = Новый ТаблицаЗначений;
	ТранспортнаяНакладная.Колонки.Добавить("ТранспортнаяНакладнаяНомер");
	ТранспортнаяНакладная.Колонки.Добавить("ТранспортнаяНакладнаяДата");
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТранспортнаяНакладная, "ТранспортнаяНакладная");
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПоАкт501ИсполнительУПД(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	НетЗамечанийКДокументу = Документы[СсылкаНаОбъект.Метаданные().Имя].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДляЭД = Документы[СсылкаНаОбъект.Метаданные().Имя].ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
	Если ДанныеДляЭД.Шапка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	РеквизитыШапки    = ДанныеДляЭД.Шапка[0];
	ТабличнаяЧасть = ДанныеДляЭД.ТабЧасть;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", РеквизитыШапки.НомерАкта);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  РеквизитыШапки.ДатаАкта);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", Перечисления.ВидыОперацийЭД.ПродажаКомиссия);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", НСтр("ru = 'Услуги оказаны в полном объеме.'"));

	Если Не ЗначениеЗаполнено(РеквизитыШапки.Валюта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ВалютаДокумента");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(РеквизитыШапки.Валюта, 
			"Объект.Код");
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыШапки.ВалютаКод, ПараметрыОбработкиОшибок);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаОтгрузкиТоваров", РеквизитыШапки.ДатаАкта);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки", РеквизитыШапки.ДокументОснование);
	
	ЗаполнитьДанныеУчастникаУПД(РеквизитыШапки.Организация, "СведенияОПродавце", РеквизитыШапки.ДатаАкта, ДеревоДанных, 
							, );
	ЗаполнитьДанныеУчастникаУПД(РеквизитыШапки.Контрагент, "СведенияОПокупателе", РеквизитыШапки.ДатаАкта, ДеревоДанных, 
							,,,,,);
								
	СоставительДокументаНаименование = РеквизитыШапки.Организация.НаименованиеПолное;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СоставительДокументаНаименование", СоставительДокументаНаименование);
			
	ОснованиеОтгрузкиТоваров = Новый ТаблицаЗначений;
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНаименование");
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНомер");
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДата");
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДопСведения");
	
	НоваяСтрока = ОснованиеОтгрузкиТоваров.Добавить();
	НоваяСтрока.ДокументНаименование = ?(ЗначениеЗаполнено(РеквизитыШапки.ДокументОснованиеНаименование), РеквизитыШапки.ДокументОснованиеНаименование, "Отсутствует");
	НоваяСтрока.ДокументНомер = РеквизитыШапки.ДокументОснованиеНомер;
	НоваяСтрока.ДокументДата = РеквизитыШапки.ДокументОснованиеДата;
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ОснованиеОтгрузкиТоваров,
		"ДокументДата", , ,
		НСтр("ru = 'Не заполнена дата договора для реквизита ""Договор"".'"));
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованиеОтгрузкиТоваров, "ОснованиеОтгрузкиТоваров");
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОТранспортировке", "");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ИныеСведенияОбОтгрузке", "");
	
	Если СтруктураЭД.Функция = "ДОП" Тогда //ДОПУПД
		ТаблицаТоваров = СоздатьТаблицуТоваровУПД();
		НомерСтроки = 1;
		ТолькоУслуги = Истина;
				
		Для каждого ТекСтрока Из ТабличнаяЧасть Цикл
			НоваяСтрока = ТаблицаТоваров.Добавить();
			НоваяСтрока.НомерСтроки = НомерСтроки;
			
			НоваяСтрока.ТоварИдентификатор = ТекСтрока.Номенклатура.УникальныйИдентификатор();
			Если ЗначениеЗаполнено(ТекСтрока.Описание) Тогда
				НаименованиеНоменклатуры = ТекСтрока.Описание;	
			Иначе
				НаименованиеНоменклатуры = ТекСтрока.НаименованиеНоменклатуры;	
			КонецЕсли;	
			НоваяСтрока.ТоварНаименование  = НаименованиеНоменклатуры;
			НоваяСтрока.ТоварКод           = ТекСтрока.КодТовара;
			
			Если ПустаяСтрока(ТекСтрока.ЕдиницаИзмеренияКод) Тогда
				ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрока.Номенклатура, "ЕдиницаИзмерения");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда // берем значение ед. измерения из карточки номенклатуры
					РеквизитыЕдиницыИзмерения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдиницаИзмерения, "Наименование, Код");
					НоваяСтрока.ЕдиницаИзмеренияКод          = СокрЛП(РеквизитыЕдиницыИзмерения.Код);
					НоваяСтрока.ЕдиницаИзмеренияНаименование = СокрЛП(РеквизитыЕдиницыИзмерения.Наименование);
				КонецЕсли;
			Иначе
					НоваяСтрока.ЕдиницаИзмеренияКод          = СокрЛП(ТекСтрока.ЕдиницаИзмеренияКод);
					НоваяСтрока.ЕдиницаИзмеренияНаименование = СокрЛП(ТекСтрока.ЕдиницаИзмеренияНаименование);
			КонецЕсли;
			
			НоваяСтрока.Признак = "3";
			
			НоваяСтрока.Количество					= ТекСтрока.Количество;
			НоваяСтрока.ЦенаЗаЕдиницуИзмерения		= ТекСтрока.Цена ;
			НоваяСтрока.СтоимостьТоваровБезНалога	= ТекСтрока.СуммаСНДС - ТекСтрока.СуммаНДС;
			НоваяСтрока.СтоимостьТоваровСНалогом   	= ТекСтрока.СуммаСНДС;
			НоваяСтрока.СуммаНалога                	= ТекСтрока.СуммаНДС;
			НоваяСтрока.НалоговаяСтавка				= ТекСтрока.СтавкаНДС;
			
			НоваяСтрока.СуммаАкциза               	= 0;
			
			Сопоставление = Новый Структура;
			Сопоставление.Вставить("Наименование", ТекСтрока.НаименованиеНоменклатуры);
			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(НоваяСтрока.ЕдиницаИзмеренияКод);
			
			Сопоставление.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения.Наименование);
			Сопоставление.Вставить("Артикул", "");
			
			ХарактеристикаНаименование = "";
			Сопоставление.Вставить("Характеристика", ХарактеристикаНаименование);
			ШтрихкодыТовара = "";
			Сопоставление.Вставить("Штрихкод", ШтрихкодыТовара);
			УпаковкаИБ = "";
			
			Сопоставление.Вставить("НоменклатураИБ", ТекСтрока.Номенклатура);
			Сопоставление.Вставить("ХарактеристикаИБ", ХарактеристикаНаименование);
			Сопоставление.Вставить("УпаковкаИБ", УпаковкаИБ);
			НоваяСтрока.Сопоставление = Сопоставление;
			
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
			"Количество", , ,
			НСтр("ru = 'Не указано количество услуг в табличной части.'"));
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
			"ЕдиницаИзмеренияНаименование", , ,
			НСтр("ru = 'Не заполнена наименование единицы измерения в справочнике ""Номенклатура"".'"));
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
			"ЕдиницаИзмеренияКод", , ,
			НСтр("ru = 'Не заполнен код единицы измерения в справочнике ""Номенклатура"".'"));
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "СведенияОТоварах");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогом"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСуммаНалога", ТаблицаТоваров.Итог("СуммаНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоКоличество", ТаблицаТоваров.Итог("Количество"));

	КонецЕсли;
		
КонецПроцедуры

// Подготавливает данные для электронного документа типа СчетФактураВыданный.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ПодготовитьДанныеПоСчетуФактуреУПД(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь)
	НетЗамечанийКДокументу = Документы["СчетФактураВыданный"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокумента = Документы.СчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект, Ложь);
	
	ТаблицаСФ	= ДанныеДокумента["Шапка"];
	ТаблицаНФА	= ДанныеДокумента["ТабЧастьНФА"];
	ТаблицаПРД	= ДанныеДокумента["ТабЧастьПРД"];
	
	СтороныСделки	= ДанныеДокумента["СтороныСделки"];
	НомерДокумента	= ДанныеДокумента["НомерДокумента"];
	
	Для Каждого РеквизитыСФ Из ТаблицаСФ Цикл
		
		СчетФактураШкурыЛом = УчетНДСПовтИсп.ШкурыЛом(РеквизитыСФ.ПричинаНалогообложения);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаСчетаФактуры", СсылкаНаОбъект);
		
		Если Не ЗначениеЗаполнено(РеквизитыСФ.ВалютаКод) Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
				"Объект.ВалютаДокумента");
		Иначе
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект.ВалютаДокумента, 
				"Объект.Код");
		КонецЕсли;
		
		ДокументОснование = РеквизитыСФ.ДокументОснование;
		ВидСчетаФактуры = "Реализация";
		СчетФактураНаАванс = РеквизитыСФ.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный;
		
		Если СтруктураЭД.Функция = "СЧФДОП" Тогда // УПД СФ + первичка СЧФДОПУПД
			Если СчетФактураНаАванс Тогда 
				ВидСчетаФактуры = "Авансовый";
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", 
					НСтр("ru = 'Регистрация счет-фактуры на аванс'"));
				Иначе
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", 
					НСтр("ru = 'Регистрация счет-фактуры'"));
			КонецЕсли;
		КонецЕсли;	
		
		МассивДокОснований = Новый Массив;
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			МассивДокОснований.Добавить(ДокументОснование);
			
			ТекстоваяИнформация = Новый ТаблицаЗначений;
			ТекстоваяИнформация.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
			ТекстоваяИнформация.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(30)));
			
			НоваяСтрока = ТекстоваяИнформация.Добавить();
			НоваяСтрока.Идентификатор = "ВидДокументаОснования";
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
				НоваяСтрока.Значение = НСтр("ru = 'АктОбОказанииУслуг'");
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйПередаточныйДокументУслугиРаботы") Тогда
				НоваяСтрока.Значение = НСтр("ru = 'ЭлектронныйПередаточныйДокументУслугиРаботы'");
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
				НоваяСтрока.Значение = НСтр("ru = 'НакладнаяНаРеализациюТорг12'");
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
				НоваяСтрока.Значение = НСтр("ru = 'НакладнаяНаОтпускМ15'");
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
				НоваяСтрока.Значение = НСтр("ru = 'ПередачаОбъектовОС'");
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
				НоваяСтрока.Значение = НСтр("ru = 'ПередачаОбъектовИК'");
			Иначе
				НоваяСтрока.Значение = НСтр("ru = 'ДокументАванса'");
			КонецЕсли;	
			
			НоваяСтрока = ТекстоваяИнформация.Добавить();
			НоваяСтрока.Идентификатор = "НомерДокументаОснования";
			НоваяСтрока.Значение = СокрЛП(ДокументОснование.Номер);

			НоваяСтрока = ТекстоваяИнформация.Добавить();
			НоваяСтрока.Идентификатор = "ДатаДокументаОснования";
			НоваяСтрока.Значение = Формат(ДокументОснование.Дата, "ДФ=dd.MM.yyyy");
			
			ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТекстоваяИнформация, "ДопДанныеДокументаОтгрузки.ТекстоваяИнформация");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", МассивДокОснований);
		
		ОснованиеОтгрузкиТоваров = Новый ТаблицаЗначений;
		ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНаименование");
		ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНомер");
		ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДата");
		ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДопСведения");
		
		Если ЗначениеЗаполнено(РеквизитыСФ.Договор)	 Тогда
			НоваяСтрока = ОснованиеОтгрузкиТоваров.Добавить();
			НоваяСтрока.ДокументНаименование = РеквизитыСФ.Договор.ВидОбязательства;
			НоваяСтрока.ДокументНомер = РеквизитыСФ.Договор.НомерДоговора;
			НоваяСтрока.ДокументДата = НачалоДня(РеквизитыСФ.Договор.ДатаДоговора);
			
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ОснованиеОтгрузкиТоваров,
			"ДокументДата", , ,
			НСтр("ru = 'Не заполнена дата договора для реквизита ""Договор"".'"));
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованиеОтгрузкиТоваров, "ОснованиеОтгрузкиТоваров");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", ВидСчетаФактуры);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДокумента.Номер);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента", РеквизитыСФ.Дата);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", Перечисления.ВидыОперацийЭД.ПродажаКомиссия);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыСФ.ВалютаКод, ПараметрыОбработкиОшибок);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", РеквизитыСФ.ИдентификаторГосКонтракта);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаНаименование", РеквизитыСФ.ВалютаНаименованиеПолное);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаКурс", РеквизитыСФ.ВалютаКурс);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", ВидСчетаФактуры(РеквизитыСФ.ПричинаНалогообложения));
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СоставительДокументаНаименование", РеквизитыСФ.Организация.НаименованиеПолное);
		
		// Продавец
		ЗаполнитьДанныеУчастникаУПД(
			СтороныСделки.Продавец.Ссылка,
			"СведенияОПродавце",
			РеквизитыСФ.Дата,
			ДеревоДанных,
			,
			,
			,
			,
			Истина,
			,
			,
			СтороныСделки);
		
		// Покупатель
		ЗаполнитьДанныеУчастникаУПД(
			СтороныСделки.Покупатель.Ссылка,
			"СведенияОПокупателе",
			РеквизитыСФ.Дата,
			ДеревоДанных,
			,
			,
			,
			,
			Истина
			,
			,
			,
			СтороныСделки);
								
		// Грузоотправитель
		ЗаполнитьДанныеУчастникаУПД(
			СтороныСделки.Грузоотправитель.Ссылка,
			"СведенияОГрузоотправителе.Грузоотправитель",
			РеквизитыСФ.Дата,
			ДеревоДанных,
			,
			,
			,
			,
			Истина,
			,
			,
			СтороныСделки);
		
		ОнЖе = СтороныСделки.Грузоотправитель.СовпадаетСПродавцом;
		
		Если ОнЖе Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					"СведенияОГрузоотправителе.ОнЖе", ОнЖе);
		КонецЕсли;
		
		// Грузополучатель
		ЗаполнитьДанныеУчастникаУПД(
			СтороныСделки.Грузополучатель.Ссылка,
			"СведенияОГрузополучателе",
			РеквизитыСФ.Дата,
			ДеревоДанных,
			,
			,
			,
			,
			Истина,
			,
			,
			СтороныСделки);
									
		// Таблица ПРД
		ПлатежныеДокументы = Неопределено;
		ЗаполнитьТаблицуПлатежныхДокументовУПД(ПлатежныеДокументы, ТаблицаПРД);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ПлатежныеДокументы, "ПлатежноРасчетныеДокументы");
		
		// Таблица НФА
		ТаблицаТоваров = Неопределено;
		ТолькоУслуги = Неопределено;
		ЗаполнитьТаблицуТоваровУПД(ТаблицаТоваров, ТолькоУслуги, ТаблицаНФА, СчетФактураШкурыЛом);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "СведенияОТоварах");
		
		ТекстОшибки = НСтр("ru = 'Возникла ошибка при заполнении страны происхождения в сведениях по ГТД. Возможные причины:
		|	- не заполнена колонка ""Страна происхождения""
		|	- указанной страны нет в классификаторе стран мира'");
		ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных,
			"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.СтранаПроисхожденияКод", ТекстОшибки);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогом"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСуммаНалога", ТаблицаТоваров.Итог("СуммаНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоКоличество", ТаблицаТоваров.Итог("Количество"));
		
		// Передача данных об авансах
		Если СчетФактураНаАванс И ТаблицаТоваров.Количество() > 0 Тогда
			
			// добавление доп. данных
			ТаблицаДопДанных = Новый ТаблицаЗначений;
			ТаблицаДопДанных.Колонки.Добавить("Идентификатор");
			ТаблицаДопДанных.Колонки.Добавить("Значение");
			
			ТаблицаАвансы = Новый ТаблицаЗначений;
			ТаблицаАвансы.Колонки.Добавить("Сумма");
			ТаблицаАвансы.Колонки.Добавить("СуммаНДС");
			ТаблицаАвансы.Колонки.Добавить("СтавкаНДС");
			
			Для Каждого СтрокаДанных Из ТаблицаТоваров Цикл
				
				СтрокаАвансы = ТаблицаАвансы.Добавить();
				СтрокаАвансы.Сумма = СтрокаДанных.СтоимостьТоваровСНалогом;
				СтрокаАвансы.СуммаНДС = СтрокаДанных.СуммаНалога;
				СтрокаАвансы.СтавкаНДС = СтрокаДанных.НалоговаяСтавка;
				
			КонецЦикла;
			
			СтрокаТаблицы = ТаблицаДопДанных.Добавить();
			СтрокаТаблицы.Идентификатор = "Авансы";
			СтрокаТаблицы.Значение = ОбщегоНазначения.ЗначениеВСтрокуXML(ТаблицаАвансы);
			
			ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаДопДанных, "ДопДанныеСчетаФактуры.ТекстоваяИнформация");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

// Подготавливает данные для электронного документа типа ИсправительныйСчетФактураВыданный,
// исправляющего корректировочный счет-фактуру.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ПодготовитьДанныеПоИсправительномуСчетуФактуреУПД(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь)
	
	НетЗамечанийКДокументу = Документы["ИсправительныйСчетФактураВыданный"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокумента = Документы.ИсправительныйСчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект,, Ложь);
	
	ТаблицаСФ	= ДанныеДокумента["Шапка"];
	ТаблицаНФА	= ДанныеДокумента["ТабЧастьНФА"];
	ТаблицаПРД	= ДанныеДокумента["ТабЧастьПРД"];
	
	СтороныСделки	= ДанныеДокумента["СтороныСделки"];
	НомерДокумента	= ДанныеДокумента["НомерДокумента"];
	
	Для Каждого РеквизитыИСФ Из ТаблицаСФ Цикл
		
		СчетФактураШкурыЛом = УчетНДСПовтИсп.ШкурыЛом(РеквизитыИСФ.ПричинаНалогообложения);
		
		Если Не ЗначениеЗаполнено(РеквизитыИСФ.КодВалюты) Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
				"Объект.ВалютаДокумента");
		Иначе
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект.ВалютаДокумента, 
				"Объект.Код");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаСчетаФактуры", СсылкаНаОбъект);
		
		ВидОперации = Перечисления.ВидыОперацийЭД.Исправление;
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", ВидОперации);
		
		ВидСчетаФактуры = "Реализация";
		СчетФактураНаАванс = РеквизитыИСФ.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный;
		
		Если СтруктураЭД.Функция = "СЧФДОП" Тогда // УПД СФ + первичка СЧФДОПУПД
			Если СчетФактураНаАванс Тогда 
				ВидСчетаФактуры = "Авансовый";
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", 
					НСтр("ru = 'Регистрация исправления счет-фактуры на аванс'"));
				Иначе
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", 
					НСтр("ru = 'Регистрация исправления счет-фактуры'"));
			КонецЕсли;
		КонецЕсли;	
		
		МассивДокОснований = Новый Массив;
		ДокументОснование = РеквизитыИСФ.ДокументОснование;
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			МассивДокОснований.Добавить(ДокументОснование);
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", МассивДокОснований);
		
		ОснованиеОтгрузкиТоваров = Новый ТаблицаЗначений;
		ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНаименование");
		ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНомер");
		ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДата");
		ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДопСведения");
		
		Если ЗначениеЗаполнено(РеквизитыИСФ.Договор)	 Тогда
			НоваяСтрока = ОснованиеОтгрузкиТоваров.Добавить();
			НоваяСтрока.ДокументНаименование = РеквизитыИСФ.Договор.ВидОбязательства;
			НоваяСтрока.ДокументНомер = РеквизитыИСФ.Договор.НомерДоговора;
			НоваяСтрока.ДокументДата = НачалоДня(РеквизитыИСФ.Договор.ДатаДоговора);
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ОснованиеОтгрузкиТоваров,
			"ДокументДата", , ,
			НСтр("ru = 'Не заполнена дата договора для реквизита ""Договор"".'"));
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованиеОтгрузкиТоваров, "ОснованиеОтгрузкиТоваров");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДокумента.Номер);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента", РеквизитыИСФ.ДатаСчетаФактуры);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления", РеквизитыИСФ.НомерИсправления);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления", РеквизитыИСФ.ДатаИсправления);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыИСФ.КодВалюты, ПараметрыОбработкиОшибок);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", РеквизитыИСФ.ИдентификаторГосКонтракта);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаНаименование", РеквизитыИСФ.ВалютаПредставление);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаКурс", РеквизитыИСФ.Курс);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", ВидСчетаФактуры(РеквизитыИСФ.ПричинаНалогообложения));
		
		// Продавец
		ЗаполнитьДанныеУчастникаУПД(
			СтороныСделки.Продавец.Ссылка,
			"СведенияОПродавце",
			РеквизитыИСФ.ДатаИсправления,
			ДеревоДанных,
			,
			,
			,
			,
			Истина,
			,
			,
			СтороныСделки);
			
		// Покупатель
		ЗаполнитьДанныеУчастникаУПД(
			СтороныСделки.Покупатель.Ссылка,
			"СведенияОПокупателе",
			РеквизитыИСФ.ДатаИсправления,
			ДеревоДанных,
			,
			,
			,
			,
			Истина,
			,
			,
			СтороныСделки);
			
		// Грузоотправитель
		ЗаполнитьДанныеУчастникаУПД(
			СтороныСделки.Грузоотправитель.Ссылка,
			"СведенияОГрузоотправителе.Грузоотправитель",
			РеквизитыИСФ.ДатаИсправления,
			ДеревоДанных,
			,
			,
			,
			,
			Истина,
			,
			,
			СтороныСделки);
		
		ОнЖе = СтороныСделки.Грузоотправитель.СовпадаетСПродавцом;
		
		Если ОнЖе Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					"СведенияОГрузоотправителе.ОнЖе", ОнЖе);
		КонецЕсли;
		
		// Грузополучатель
		ЗаполнитьДанныеУчастникаУПД(
			СтороныСделки.Грузополучатель.Ссылка,
			"СведенияОГрузополучателе",
			РеквизитыИСФ.ДатаИсправления,
			ДеревоДанных,
			,
			,
			,
			,
			Истина,
			,
			,
			СтороныСделки);
			
		СведенияОПродавце = Новый Структура;
		ПолучитьДанныеЮрФизЛица(РеквизитыИСФ.Организация, СведенияОПродавце);
								
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СведенияОПродавце.ПолноеНаименование);
								
		// Таблица ПРД
		ПлатежныеДокументы = Неопределено;
		ЗаполнитьТаблицуПлатежныхДокументовУПД(ПлатежныеДокументы, ТаблицаПРД);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ПлатежныеДокументы, "ПлатежноРасчетныеДокументы");
		
		// Таблица НФА
		ТаблицаТоваров = Неопределено;
		ТолькоУслуги = Неопределено;
		ЗаполнитьТаблицуТоваровУПД(ТаблицаТоваров, ТолькоУслуги, ТаблицаНФА, СчетФактураШкурыЛом);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "СведенияОТоварах");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);
		
		ТекстОшибки = НСтр("ru = 'Возникла ошибка при заполнении страны происхождения в сведениях по ГТД. Возможные причины:
		|	- не заполнена колонка ""Страна происхождения""
		|	- указанной страны нет в классификаторе стран мира'");
		ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных,
			"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.СтранаПроисхожденияКод", ТекстОшибки);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогом"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСуммаНалога", ТаблицаТоваров.Итог("СуммаНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоКоличество", ТаблицаТоваров.Итог("Количество"));
	КонецЦикла;
	
КонецПроцедуры	

// Подготавливает данные для электронного документа типа ИсправительныйСчетФактураВыданный,
// исправляющего корректировочный счет-фактуру.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ПодготовитьДанныеПоИсправительномуСчетуФактуре_КорректировкаУКД(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь)
	
	НетЗамечанийКДокументу = Документы["ИсправительныйСчетФактураВыданный"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		Сообщить(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ДанныеДокумента = Документы.ИсправительныйСчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект, "Корректировка", Ложь);
	
	ЕстьЭлектронноеАктирование = Истина;
	
	ТаблицаСФ	= ДанныеДокумента["Шапка"];
	ТаблицаНФА	= ДанныеДокумента["ТабЧастьНФА"];
	
	СтороныСделки	= ДанныеДокумента["СтороныСделки"];
	НомерДокумента	= ДанныеДокумента["НомерДокумента"];
	
	Для Каждого РеквизитыИСФ Из ТаблицаСФ Цикл
		
		СчетФактураШкурыЛом = УчетНДСПовтИсп.ШкурыЛом(РеквизитыИСФ.ПричинаНалогообложения);
		
		Если Не ЗначениеЗаполнено(РеквизитыИСФ.КодВалюты) Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
				"Объект.ВалютаДокумента");
		Иначе
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект.ВалютаДокумента, 
				"Объект.Код");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидДокумента", "Корректировка"); // или "Возврат"
		
		// Реквизиты КСФ
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаКорректировочногоСчетаФактуры", СсылкаНаОбъект);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДокумента.НомерКСФ);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  РеквизитыИСФ.Дата);
		
		НомерИсправления = РеквизитыИСФ.НомерИсправленияКорректировки;
		Если ЗначениеЗаполнено(НомерИсправления) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления", НомерИсправления);
		КонецЕсли;
		
		ДатаИсправления = РеквизитыИСФ.ДатаИсправленияКорректировки;
		Если ЗначениеЗаполнено(ДатаИсправления) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления", ДатаИсправления);
		КонецЕсли;
		
		// Реквизиты СФ
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсходногоДокумента", НомерДокумента.Номер);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсходногоДокумента",  РеквизитыИСФ.ДатаСчетаФактуры);
		
		НомерИсправленияНомерИсходногоДокумента = РеквизитыИСФ.НомерИсправления;
		Если ЗначениеЗаполнено(НомерИсправленияНомерИсходногоДокумента) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправленияНомерИсходногоДокумента", НомерИсправленияНомерИсходногоДокумента);
		КонецЕсли;
		
		ДатаИсправленияНомерИсходногоДокумента = РеквизитыИСФ.ДатаИсправления;
		Если ЗначениеЗаполнено(ДатаИсправленияНомерИсходногоДокумента) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправленияНомерИсходногоДокумента", ДатаИсправленияНомерИсходногоДокумента);
		КонецЕсли;
		
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыИСФ.КодВалюты, ПараметрыОбработкиОшибок);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", РеквизитыИСФ.ИдентификаторГосКонтракта);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаНаименование", РеквизитыИСФ.ВалютаПредставление);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаКурс", РеквизитыИСФ.Курс);
		
		// Продавец
		ЗаполнитьДанныеУчастникаУПД(
			СтороныСделки.Продавец.Ссылка,
			"СведенияОПродавце",
			РеквизитыИСФ.Дата,
			ДеревоДанных,
			,
			,
			,
			,
			Истина,
			,
			,
			СтороныСделки);
			
		// Покупатель
		ЗаполнитьДанныеУчастникаУПД(
			СтороныСделки.Покупатель.Ссылка,
			"СведенияОПокупателе",
			РеквизитыИСФ.Дата,
			ДеревоДанных,
			,
			,
			,
			,
			Истина,
			,
			,
			СтороныСделки);
		
		СведенияОПродавце = Новый Структура;
		ПолучитьДанныеЮрФизЛица(РеквизитыИСФ.Организация, СведенияОПродавце);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СведенияОПродавце.ПолноеНаименование);
		
		Если ЗначениеЗаполнено(РеквизитыИСФ.Договор) Тогда
			ОснованиеКорректировки = Новый ТаблицаЗначений;
			ОснованиеКорректировки.Колонки.Добавить("ДокументНаименование");
			ОснованиеКорректировки.Колонки.Добавить("ДокументНомер");
			ОснованиеКорректировки.Колонки.Добавить("ДокументДата");
			ОснованиеКорректировки.Колонки.Добавить("ДокументДопСведения");
			
			НоваяСтрока = ОснованиеКорректировки.Добавить();
			НоваяСтрока.ДокументНаименование = РеквизитыИСФ.Договор.ВидОбязательства;
			НоваяСтрока.ДокументНомер = РеквизитыИСФ.Договор.НомерДоговора;
			НоваяСтрока.ДокументДата = РеквизитыИСФ.Договор.ДатаДоговора;
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ОснованиеКорректировки,
				"ДокументДата", , ,
				НСтр("ru = 'Не заполнена дата договора для реквизита ""Договор"".'"));
			
			ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованиеКорректировки, "ОснованиеКорректировки");
		КонецЕсли;
		
		// Таблица НФА
		ТаблицаТоваров = Неопределено;
		ТолькоУслуги = Неопределено;
		ЗаполнитьТаблицуТоваровУКД(ТаблицаТоваров, ТолькоУслуги, ТаблицаНФА, СчетФактураШкурыЛом);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "СведенияОТоварах");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровБезНалогаУвеличение", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалогаУвеличение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровСНалогомУвеличение", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогомУвеличение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСуммаНалогаУвеличение", ТаблицаТоваров.Итог("СуммаНалогаУвеличение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровБезНалогаУменьшение", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалогаУменьшение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровСНалогомУменьшение", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогомУменьшение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСуммаНалогаУменьшение", ТаблицаТоваров.Итог("СуммаНалогаУменьшение"));
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", "Исправительный счет-фактура");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаНаправленияНаСогласование", РеквизитыИСФ.Дата);
		
	КонецЦикла;	
КонецПроцедуры	

// Подготавливает данные для электронного документа типа КорректировочныйСчетФактураВыданный.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ПодготовитьДанныеПоКорректировочномуСчетуФактуреУКД(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, ЭтоСчетФактура = Ложь, Отказ = Ложь) Экспорт
	НетЗамечанийКДокументу = Документы["КорректировочныйСчетФактураВыданный"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокумента = Документы.КорректировочныйСчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
	
	ТаблицаСФ	= ДанныеДокумента["Шапка"];
	ТаблицаНФА	= ДанныеДокумента["ТабЧастьНФА"];
	
	СтороныСделки	= ДанныеДокумента["СтороныСделки"];
	НомерДокумента	= ДанныеДокумента["НомерДокумента"];
	
	Для Каждого РеквизитыКСФ Из ТаблицаСФ Цикл
		
		СчетФактураШкурыЛом = УчетНДСПовтИсп.ШкурыЛом(РеквизитыКСФ.ПричинаНалогообложения);
		
		Если Не ЗначениеЗаполнено(РеквизитыКСФ.ВалютаКод) Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
				"Объект.ВалютаДокумента");
		Иначе
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект.ВалютаДокумента, 
				"Объект.Код");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидДокумента", "Корректировка"); // или "Возврат"
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", "Предлагаю изменить стоимость");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаНаправленияНаСогласование", РеквизитыКСФ.Дата);
	
		КорректируемыйСФ = РеквизитыКСФ.ДокументОснование;
		
		// Реквизиты КСФ
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаКорректировочногоСчетаФактуры", СсылкаНаОбъект);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДокумента.НомерКСФ);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  РеквизитыКСФ.Дата);
		
		// Исправления отсутствуют, поэтому не записываем номер и дату исправления
		
		// Реквизиты СФ
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсходногоДокумента", НомерДокумента.Номер);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсходногоДокумента",  РеквизитыКСФ.ДатаСчетаФактуры);
		
		НомерИсправленияИсходногоДокумента = РеквизитыКСФ.НомерИсправления;
		Если ЗначениеЗаполнено(НомерИсправленияИсходногоДокумента) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправленияИсходногоДокумента",	НомерИсправленияИсходногоДокумента);
		КонецЕсли;
		
		ДатаИсправленияИсходногоДокумента = РеквизитыКСФ.ДатаИсправления;
		Если ЗначениеЗаполнено(ДатаИсправленияИсходногоДокумента) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправленияИсходногоДокумента",	ДатаИсправленияИсходногоДокумента);
		КонецЕсли;
		
		СведенияОПродавце = Новый Структура;
		ПолучитьДанныеЮрФизЛица(РеквизитыКСФ.Организация, СведенияОПродавце);
		
		СведенияОПокупателе = Новый Структура;
		ПолучитьДанныеЮрФизЛица(РеквизитыКСФ.Контрагент, СведенияОПокупателе);
		
		// Продавец
		ЗаполнитьДанныеУчастникаУПД(
			СтороныСделки.Продавец.Ссылка,
			"СведенияОПродавце",
			РеквизитыКСФ.Дата,
			ДеревоДанных,
			,
			,
			,
			,
			Истина,
			,
			,
			СтороныСделки);
			
		// Покупатель
		ЗаполнитьДанныеУчастникаУПД(
			СтороныСделки.Покупатель.Ссылка,
			"СведенияОПокупателе",
			РеквизитыКСФ.Дата,
			ДеревоДанных,
			,
			,
			,
			,
			Истина,
			,
			,
			СтороныСделки);
			
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СведенияОПродавце.ПолноеНаименование);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыКСФ.ВалютаКод, ПараметрыОбработкиОшибок);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", РеквизитыКСФ.ИдентификаторГосКонтракта);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаНаименование", РеквизитыКСФ.ВалютаПредставление);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаКурс", РеквизитыКСФ.Курс);
			
		ДанныеДокументаОснования = ДокументОснованиеСЧФ(КорректируемыйСФ);
		ЭтоУслуги = ДанныеДокументаОснования.ЭтоУслуги;
		
		ОснованиеКорректировки = Новый ТаблицаЗначений;
		ОснованиеКорректировки.Колонки.Добавить("ДокументНаименование");
		ОснованиеКорректировки.Колонки.Добавить("ДокументНомер");
		ОснованиеКорректировки.Колонки.Добавить("ДокументДата");
		ОснованиеКорректировки.Колонки.Добавить("ДокументДопСведения");
		
		Если ЗначениеЗаполнено(РеквизитыКСФ.Договор) Тогда
			НоваяСтрока = ОснованиеКорректировки.Добавить();
			НоваяСтрока.ДокументНаименование = РеквизитыКСФ.Договор.ВидОбязательства;
			НоваяСтрока.ДокументНомер = РеквизитыКСФ.Договор.НомерДоговора;
			НоваяСтрока.ДокументДата = РеквизитыКСФ.Договор.ДатаДоговора;
		Иначе	
			НоваяСтрока = ОснованиеКорректировки.Добавить();
			НоваяСтрока.ДокументНаименование = "Отсутствует";
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ОснованиеКорректировки,
			"ДокументДата", , ,
			НСтр("ru = 'Не заполнена дата договора для реквизита ""Договор"".'"));
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованиеКорректировки, "ОснованиеКорректировки");
		
		// Таблица НФА
		ТаблицаТоваров = Неопределено;
		ТолькоУслуги = Неопределено;
		ЗаполнитьТаблицуТоваровУКД(ТаблицаТоваров, ТолькоУслуги, ТаблицаНФА, СчетФактураШкурыЛом);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "СведенияОТоварах");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровБезНалогаУвеличение", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалогаУвеличение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровСНалогомУвеличение", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогомУвеличение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСуммаНалогаУвеличение", ТаблицаТоваров.Итог("СуммаНалогаУвеличение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровБезНалогаУменьшение", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалогаУменьшение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровСНалогомУменьшение", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогомУменьшение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСуммаНалогаУменьшение", ТаблицаТоваров.Итог("СуммаНалогаУменьшение"));
			
	КонецЦикла;
	
КонецПроцедуры	
	
Процедура НайтиСоздатьДокументПередачаТоваров(ДеревоДанных, СсылкаНаВладельца, СпособОбработки, ОписаниеОшибки) Экспорт
	
	Записывать = Истина;
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.ЭлектронныйДокументПоставщика.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		
		НайтиСсылкуНаОбъект("Валюты", ДокументОбъект.ВалютаДокумента,
			ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
		ВидОперации = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации");
		Если Не ЗначениеЗаполнено(ВидОперации) Тогда
			ВидОперации = Перечисления.ВидыОперацийЭД.ПродажаКомиссия;
		КонецЕсли;
		
		ИдентификаторДокументаОснованияЭДО = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДопДанные.Подписанные.ИдентификаторДокументаОснования", Ложь);
		Если ЗначениеЗаполнено(ИдентификаторДокументаОснованияЭДО) Тогда
			ДокументОбъект.ИдентификаторДокументаОснованияЭДО = ИдентификаторДокументаОснованияЭДО;
		КонецЕсли;
		
		ДокументОбъект.СведенияОЗаполненииДокумента = "";
		ДокументОбъект.ТипФорматаЭД = 1;
				
		// Сведения о поставщике.
		ИННПоставщика = ""; КПППоставщика = "";
		ВидУчастника = "Поставщик";
		Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
			КПППоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
			ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
			Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
			Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
			Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
			
			ПредставлениеПоставщика = Фамилия + " " + Имя + " " + Отчество; 
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
			
			ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		КонецЕсли;
		Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("Контрагенты", ИННПоставщика, КПППоставщика, Контрагент);
		ДокументОбъект.Контрагент = Контрагент;
		
		// Сведения о покупателе.
		ИННПокупателя = ""; КПППокупателя = "";
		ВидУчастника = "Плательщик";
		Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
			КПППокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
			ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
			Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
			Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
			Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
			
			ПредставлениеПокупателя = Фамилия + " " + Имя + " " + Отчество; 
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
			
			ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		КонецЕсли;
		Организация = Справочники.Организации.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("Организации", ИННПокупателя, КПППокупателя, Организация);
		ДокументОбъект.Организация = Организация;
		
		// Сведения о грузополучателе.
		ИННГрузополучателя = ""; КППГрузополучателя = "";
		ПредставлениеГрузополучателя = "";
		ВидУчастника = "Грузополучатель";
		Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
			
			ИННГрузополучателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
			КППГрузополучателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
			ПредставлениеГрузополучателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
			
			ИННГрузополучателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
			Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
			Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
			Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
			
			ПредставлениеГрузополучателя = Фамилия + " " + Имя + " " + Отчество; 
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
			
			ИННГрузополучателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
			
			ПредставлениеГрузополучателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		КонецЕсли;
		Грузополучатель = Справочники.Контрагенты.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("Контрагенты", ИННГрузополучателя, КППГрузополучателя, Грузополучатель);
		Если НЕ ЗначениеЗаполнено(Грузополучатель) И ЗначениеЗаполнено(ИННГрузополучателя) Тогда
			ТекстЗамечания =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не заполнен грузополучатель. Не найден контрагент %1 с ИНН %2 и КПП %3'"), ПредставлениеГрузополучателя, ИННГрузополучателя, КППГрузополучателя);
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Заполнение документа на основе ЭД завершилось с замечаниями. %1'"), ТекстЗамечания)
				+ Символы.ПС;
			ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
				2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
			ДокументОбъект.СведенияОЗаполненииДокумента = ДокументОбъект.СведенияОЗаполненииДокумента + ТекстЗамечания + Символы.ПС;	
		КонецЕсли;
		ДокументОбъект.Грузополучатель = Грузополучатель;
		
		ДокументСделкиНаименование = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументСделкиНаименование");
		ДокументСделкиНомер = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументСделкиНомер");
		ДокументСделкиДата = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументСделкиДата");
		
		РеквизитыДоговора = Новый Структура;
		РеквизитыДоговора.Вставить("Организация", Организация);
		РеквизитыДоговора.Вставить("НомерДоговора", ДокументСделкиНомер);
		РеквизитыДоговора.Вставить("ДатаДоговора", ?(НЕ Значениезаполнено(ДокументСделкиДата),Дата(1,1,1),Дата(ДокументСделкиДата)));
		РеквизитыДоговора.Вставить("Владелец", Контрагент);
		
		Договор = ДоговорКонтрагентаПоРеквизитам(РеквизитыДоговора);		
		
		Если Договор = Неопределено Тогда
			Договор = ДоговорПоНастройкеЭДО(Контрагент, Организация);
		КонецЕсли;
		
		ДокументОбъект.Договор = Договор;
		
		НомерДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерТоварнойНакладной");
		ДатаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаТоварнойНакладной");
		
		ДокументОбъект.ВидПервичногоДокумента = НСтр("ru = 'Накладная ""ТОРГ-12""'");
		ДокументОбъект.НомерПервичногоДокумента = НомерДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = ДатаДокумента;
		
		ДокументОбъект.СписокНоменклатуры.Очистить();
		
		// Сведения таблицы.
		СтрокаТаблицаТоваров = ДеревоДанных.Строки.Найти("ТаблицаТоваров", "ПолныйПуть");
		Для Каждого Товар Из СтрокаТаблицаТоваров.Строки Цикл
			
			ВидТовара = ЗначениеРеквизитаВДереве(Товар, "ТаблицаТоваров.НомерСтроки.ДопДанныеПодписанные.ТаблицаДокумента", Ложь);
			
			НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
			
			// Обязательные реквизиты:
			НоваяСтрока.СтавкаНДС = ЗначениеРеквизитаВДереве(Товар, "ТаблицаТоваров.НомерСтроки.СтавкаНДС");
			НоваяСтрока.Всего = ЗначениеРеквизитаВДереве(Товар, "ТаблицаТоваров.НомерСтроки.СуммаСНДС");
			НоваяСтрока.СуммаНДС = ЗначениеРеквизитаВДереве(Товар, "ТаблицаТоваров.НомерСтроки.СуммаНДС");
			
			// Необязательные реквизиты:
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
			ЕдиницыИзмеренияКод = ЗначениеРеквизитаВДереве(Товар, "ТаблицаТоваров.НомерСтроки.БазоваяЕдиницаКод");
			
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", ЕдиницаИзмерения, ЕдиницыИзмеренияКод);
			НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;	
			НоваяСтрока.ЕдиницаИзмеренияКод = ЕдиницыИзмеренияКод;
			НоваяСтрока.Количество = ЗначениеРеквизитаВДереве(Товар, "ТаблицаТоваров.НомерСтроки.МассаНетто");
			НоваяСтрока.Сумма = ЗначениеРеквизитаВДереве(Товар, "ТаблицаТоваров.НомерСтроки.СуммаБезНДС");
			
			Цена = ЗначениеРеквизитаВДереве(Товар, "ТаблицаТоваров.НомерСтроки.Цена");
			НоваяСтрока.Цена = Цена;
			//дозаполнение количества 
			МассаНетто = ЗначениеРеквизитаВДереве(Товар, "ТаблицаТоваров.НомерСтроки.МассаНетто");
			КоличествоМест = ЗначениеРеквизитаВДереве(Товар, "ТаблицаТоваров.НомерСтроки.КоличествоМест");
			КоличествоВОдномМесте = ЗначениеРеквизитаВДереве(Товар, "ТаблицаТоваров.НомерСтроки.КоличествоВОдномМесте");
			НоваяСтрока.Количество = МассаНетто;
			
			// Сопоставление
			СведенияОТоваре = Товар;
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
				"ТаблицаТоваров.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
				
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"ТаблицаТоваров.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					НоваяСтрока.ИдентификаторПоставщика = Идентификатор;
				КонецЕсли;
				
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"ТаблицаТоваров.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"ТаблицаТоваров.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ВидТовара = "ВозвратнаяТара" Тогда
				НоваяСтрока.ПризнакНоменклатуры = "ВТ";
			КонецЕсли;
			
			Если (НоваяСтрока.Количество = 0) ИЛИ (НоваяСтрока.Количество = Неопределено) Тогда
				НоваяСтрока.Количество = 1;
			КонецЕсли;	
			Если (НоваяСтрока.Цена = 0) ИЛИ (НоваяСтрока.Цена = Неопределено) Тогда
				НоваяСтрока.Цена = НоваяСтрока.Сумма;
			КонецЕсли;	
			
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоПоНакладной.СуммаСНДС");
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ОбменСКонтрагентами.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

Процедура НайтиСоздатьДокументПередачаРезультатовРабот(ДеревоДанных, СсылкаНаВладельца, СпособОбработки, ОписаниеОшибки) Экспорт
	
	Записывать = Истина;
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.ПоступлениеУслугРабот.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		
		НайтиСсылкуНаОбъект("Валюты", ДокументОбъект.ВалютаДокумента,
			ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
		ВидОперации = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации");
		Если Не ЗначениеЗаполнено(ВидОперации) Тогда
			ВидОперации = Перечисления.ВидыОперацийЭД.ПродажаКомиссия;
		КонецЕсли;
		
		ИдентификаторДокументаОснованияЭДО = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДопДанные.Подписанные.ИдентификаторДокументаОснования", Ложь);
		Если ЗначениеЗаполнено(ИдентификаторДокументаОснованияЭДО) Тогда
			ДокументОбъект.ИдентификаторДокументаОснованияЭДО = ИдентификаторДокументаОснованияЭДО;
		КонецЕсли;
		
		// Сведения о поставщике.
		ИННПоставщика = ""; КПППоставщика = "";
		ВидУчастника = "Заказчик";
		Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
			КПППоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
			ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
			
		иначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
			Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
			Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
			Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
			
			ПредставлениеПоставщика = Фамилия + " " + Имя + " " + Отчество; 
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
			
			ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		КонецЕсли;
		
		Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("Контрагенты", ИННПоставщика, КПППоставщика, Контрагент);
		ДокументОбъект.Контрагент = Контрагент;
		
		// Сведения о покупателе.
		ИННПокупателя = ""; КПППокупателя = "";
		ВидУчастника = "Исполнитель";
		Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
			КПППокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
			ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
			Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
			Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
			Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
			
			ПредставлениеПокупателя = Фамилия + " " + Имя + " " + Отчество; 
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
			
			ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		КонецЕсли;
		Организация = Справочники.Организации.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("Организации", ИННПокупателя, КПППокупателя, Организация);
		ДокументОбъект.Организация = Организация;
		
		ДокументСделкиНаименование = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументСделкиНаименование");
		ДокументСделкиНомер = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументСделкиНомер");
		ДокументСделкиДата = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументСделкиДата");
		
		РеквизитыДоговора = Новый Структура;
		РеквизитыДоговора.Вставить("Организация", Организация);
		РеквизитыДоговора.Вставить("НомерДоговора", ДокументСделкиНомер);
		РеквизитыДоговора.Вставить("ДатаДоговора", ?(НЕ Значениезаполнено(ДокументСделкиДата),Дата(1,1,1),Дата(ДокументСделкиДата)));
		РеквизитыДоговора.Вставить("Владелец", Контрагент);
		
		Договор = ДоговорКонтрагентаПоРеквизитам(РеквизитыДоговора);		
		
		Если Договор = Неопределено Тогда
			Договор = ДоговорПоНастройкеЭДО(Контрагент, Организация);
		КонецЕсли;
		
		ДокументОбъект.Договор = Договор;
		
		ДокументОбъект.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
		
		НомерДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерАкта");
		ДатаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаАкта");
		
		ДокументОбъект.ВидПервичногоДокумента = "Акт об оказании услуг";
		ДокументОбъект.НомерПервичногоДокумента = НомерДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = ДатаДокумента;
		
		ДокументОбъект.УслугиИРаботы.Очистить();
		
		// Сведения таблицы.
		СтрокаТаблицаТоваров = ДеревоДанных.Строки.Найти("ТаблицаУслуг", "ПолныйПуть");
		Для Каждого Товар Из СтрокаТаблицаТоваров.Строки Цикл
			
			НоваяСтрока = ДокументОбъект.УслугиИРаботы.Добавить();
			
			// Обязательные реквизиты:
			НоваяСтрока.СтавкаНДС = ЗначениеРеквизитаВДереве(Товар, "ТаблицаУслуг.НомерСтроки.СтавкаНДС");
			НоваяСтрока.Всего = ЗначениеРеквизитаВДереве(Товар, "ТаблицаУслуг.НомерСтроки.СуммаСНДС");
			НоваяСтрока.СуммаНДС = ЗначениеРеквизитаВДереве(Товар, "ТаблицаУслуг.НомерСтроки.СуммаНДС");
			
			// Необязательные реквизиты:
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", НоваяСтрока.ЕдиницаИзмерения,
				ЗначениеРеквизитаВДереве(Товар, "ТаблицаУслуг.НомерСтроки.ЕдиницаИзмеренияКод"));
			НоваяСтрока.Количество = ЗначениеРеквизитаВДереве(Товар, "ТаблицаУслуг.НомерСтроки.Количество");
			НоваяСтрока.Сумма = ЗначениеРеквизитаВДереве(Товар, "ТаблицаУслуг.НомерСтроки.СуммаБезНДС");
			
			// Сопоставление
			СведенияОТоваре = Товар;
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
				"ТаблицаУслуг.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
				
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"ТаблицаУслуг.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					НоваяСтрока.ИдентификаторПоставщика = Идентификатор;
				КонецЕсли;
				
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"ТаблицаУслуг.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"ТаблицаУслуг.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
				
			КонецЕсли;
			
			НоваяСтрока.Содержание = НоваяСтрока.Номенклатура.НаименованиеПолное;	
			
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ОписаниеУслуги.СуммаСНДСИтого");
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ОбменСКонтрагентами.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

//создание УПД
Процедура НайтиСоздатьУниверсальныйПередаточныйДокумент(ДеревоДанных, СсылкиНаВладельцев = Неопределено, СпособОбработки = Неопределено, ОписаниеОшибки) Экспорт

	Записывать = Истина;
	ВидПервичногоДокумента = НСтр("ru = 'Универсальный передаточный документ'");
	
	ПервичныйДокумент = Неопределено;
	СчетФактура = Неопределено;
	
	СпособОбработкиПервичногоДокумента = "";
	СпособОбработкиСчетаФактуры = "";
	
	Если ЗначениеЗаполнено(СпособОбработки) И ТипЗнч(СпособОбработки) = Тип("Структура") Тогда
		
		Если СпособОбработки.Свойство("ПервичныйДокумент") Тогда
			СпособОбработкиПервичногоДокумента = СпособОбработки.ПервичныйДокумент;
		КонецЕсли;
		
		Если СпособОбработки.Свойство("СчетФактура") Тогда
			СпособОбработкиСчетаФактуры = СпособОбработки.СчетФактура;
		КонецЕсли;
		
	КонецЕсли;	
	
	Если СсылкиНаВладельцев <> Неопределено Тогда
		Для каждого Строка Из СсылкиНаВладельцев Цикл
			Если ТипЗнч(Строка) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				СчетФактура = Строка;
			Иначе
				ПервичныйДокумент = Строка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ФункцияУПД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "Функция");
	ДокументыУчета = Новый Массив;
	
	Если ФункцияУПД = "ДОП" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьУПДДокументОПередаче(ДеревоДанных, ПервичныйДокумент, Записывать, СпособОбработки, ОписаниеОшибки, ВидПервичногоДокумента);
		Если ПервичныйДокумент <> Неопределено Тогда
			ДокументыУчета.Добавить(ПервичныйДокумент);
		КонецЕсли;
	КонецЕсли;
	
	// Заполним основание в СФ.
	ДокументыОснованияСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		ПервичныйДокумент = ДокументыОснованияСчетаФактуры;
	КонецЕсли;
	ДокументыОснованияСчетаФактуры = Новый Массив;
	ДокументыОснованияСчетаФактуры.Добавить(ПервичныйДокумент);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", ДокументыОснованияСчетаФактуры);
	
	НайтиСоздатьУПДСчетФактуру(ДеревоДанных, СчетФактура, Записывать, СпособОбработки, ОписаниеОшибки, ВидПервичногоДокумента);
	
	ДокументыУчета.Добавить(СчетФактура);
	
	СсылкиНаВладельцев = ДокументыУчета;
	
КонецПроцедуры

Процедура НайтиСоздатьУПДДокументОПередаче(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина, СпособОбработки = "", ОписаниеОшибки, ВидПервичногоДокумента = "") Экспорт

	ТолькоУслуги = ТолькоУслугиПоСведениямОТоварах(ДеревоДанных);
	ДокументИзЕИС = ЭлектронныйДокументИзЕИС(ДеревоДанных);
	
	Если ТолькоУслуги И НЕ ДокументИзЕИС Тогда
		НайтиСоздатьУПДДокументОПередачеУслугРабот(ДеревоДанных, СсылкаНаВладельца, Записывать, ВидПервичногоДокумента);	
	Иначе
		НайтиСоздатьУПДДокументОПередачеТоваров(ДеревоДанных, СсылкаНаВладельца, Записывать, ВидПервичногоДокумента);
	КонецЕсли;	
	
КонецПроцедуры	

Процедура НайтиСоздатьУПДДокументОПередачеТоваров(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина, ВидПервичногоДокумента = "")
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.ЭлектронныйДокументПоставщика.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		
		ДокументОбъект.СведенияОЗаполненииДокумента = "";
		
		НайтиСсылкуНаОбъект("Валюты", ДокументОбъект.ВалютаДокумента,
			ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
		ВидОперации = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации");
		Если Не ЗначениеЗаполнено(ВидОперации) Тогда
			ВидОперации = Перечисления.ВидыОперацийЭД.ПродажаКомиссия;
		КонецЕсли;
		
		ДокументОбъект.ТипФорматаЭД = 0;
		
		// Сведения о поставщике.
		ИННПоставщика = ""; КПППоставщика = "";
		ВидУчастника = "СведенияОПродавце";
		Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
			КПППоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
			ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
			Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
			Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
			Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
			
			ПредставлениеПоставщика = Фамилия + " " + Имя + " " + Отчество; 
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
			
			ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		КонецЕсли;
		Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("Контрагенты", ИННПоставщика, КПППоставщика, Контрагент);
		ДокументОбъект.Контрагент = Контрагент;
		
		// Сведения о покупателе.
		ИННПокупателя = ""; КПППокупателя = "";
		ВидУчастника = "СведенияОПокупателе";
		Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
			КПППокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
			ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
			Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
			Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
			Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
			
			ПредставлениеПокупателя = Фамилия + " " + Имя + " " + Отчество; 
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
			
			ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		КонецЕсли;
		Организация = Справочники.Организации.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("Организации", ИННПокупателя, КПППокупателя, Организация);
		ДокументОбъект.Организация = Организация;
		
		//Грузополучатель
		ИННГрузополучателя = ""; КППГрузополучателя = "";
		ВидУчастника = "СведенияОГрузополучателе";
		ПредставлениеГрузополучателя = "";
		Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
			
			ИННГрузополучателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
			КППГрузополучателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
			ПредставлениеГрузополучателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
			
			ИННГрузополучателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
			Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
			Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
			Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
			
			ПредставлениеГрузополучателя = Фамилия + " " + Имя + " " + Отчество; 
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
			
			ИННГрузополучателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
			
			ПредставлениеГрузополучателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		КонецЕсли;
		Грузополучатель = Справочники.Контрагенты.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("Контрагенты", ИННГрузополучателя, КППГрузополучателя, Грузополучатель);
		Если НЕ ЗначениеЗаполнено(Грузополучатель) И ЗначениеЗаполнено(ИННГрузополучателя) Тогда
			ТекстЗамечания =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не заполнен грузополучатель. Не найден контрагент %1 с ИНН %2 и КПП %3'"), ПредставлениеГрузополучателя, ИННГрузополучателя, КППГрузополучателя);
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Заполнение документа на основе ЭД завершилось с замечаниями. %1'"), ТекстЗамечания)
				+ Символы.ПС;
			ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
				2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
			ДокументОбъект.СведенияОЗаполненииДокумента = ДокументОбъект.СведенияОЗаполненииДокумента + ТекстЗамечания + Символы.ПС;	
		КонецЕсли;	
		
		ДокументОбъект.Грузополучатель = Грузополучатель;
		
		// Поиск и заполнения договора контрагента.
		Договор = Справочники.Договоры.ПустаяСсылка();
		ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
		Если Не ОснованияОтгрузки = Неопределено Тогда
			Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
				ДоговорНомер = ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
				Если ЗначениеЗаполнено(ДоговорНомер) Тогда
					
					ДоговорДата = ДатаИзСтроки(ЗначениеРеквизитаВДереве(
						СтрокаОснованиеОтгрузки, 
						"ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата"));
					
					СвойстваДоговора = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация", ДоговорНомер, ДоговорДата, Контрагент, Организация);
					
					Договор = Справочники.Договоры.ПустаяСсылка();
					НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , СвойстваДоговора);
					
				КонецЕсли;
				Прервать;
			КонецЦикла;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Договор) Тогда
			Договор = ДоговорПоНастройкеЭДО(Контрагент, Организация);
		КонецЕсли;
		
		ДокументОбъект.Договор = Договор;
		
		НомерДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
		ДатаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента");
		
		Если ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
			ДокументОбъект.ВидПервичногоДокумента = ВидПервичногоДокумента;
		Иначе	
			ДокументОбъект.ВидПервичногоДокумента = "Универсальный передаточный документ";
		КонецЕсли;
		ДокументОбъект.НомерПервичногоДокумента = НомерДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = ДатаДокумента;
		
		ДокументОбъект.СписокНоменклатуры.Очистить();
		
		// Сведения таблицы.
		СтрокаТаблицаТоваров = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
		Для Каждого Товар Из СтрокаТаблицаТоваров.Строки Цикл
			
			ЭтоВозвратнаяТара = Ложь;
			Признак = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.Признак");
			ПризнакДополнительнаяИнформация = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.ПризнакДополнительнаяИнформация");
			
			Если Признак = "3" Тогда
				//услуги (признак БП)
				НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
				НоваяСтрока.ПризнакНоменклатуры = Признак;
			ИначеЕсли Признак = "4" Тогда
				//ПО (признак БП)
				НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
				НоваяСтрока.ПризнакНоменклатуры = Признак;
			ИначеЕсли (Признак = "1" И ПризнакДополнительнаяИнформация = "ВТ") Тогда
				//Возвратная тара 
				ЭтоВозвратнаяТара = Истина;
				НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
				НоваяСтрока.ПризнакНоменклатуры = "1ВТ";
			Иначе
				НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
				НоваяСтрока.ПризнакНоменклатуры = Признак;
			КонецЕсли;
			
			// Обязательные реквизиты:
			СтавкаНДС = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
			
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
			КонецЕсли;	
			
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаНДС = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СуммаНалога");
			НоваяСтрока.Всего = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
			
			// Необязательные реквизиты:
			ЕдиницаИзмеренияКод = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод");
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", НоваяСтрока.ЕдиницаИзмерения, ЕдиницаИзмеренияКод);
			НоваяСтрока.ЕдиницаИзмеренияКод = ЕдиницаИзмеренияКод;
			
			НоваяСтрока.Количество = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.Количество");
			НоваяСтрока.Сумма = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
			
			Если (НоваяСтрока.Количество = 0) ИЛИ (НоваяСтрока.Количество = Неопределено) Тогда
				НоваяСтрока.Количество = 1;
				Если (НоваяСтрока.Цена = 0) ИЛИ (НоваяСтрока.Цена = Неопределено) Тогда
					НоваяСтрока.Цена = НоваяСтрока.Сумма;
				КонецЕсли;	
			Иначе	
				НоваяСтрока.Цена = НоваяСтрока.Сумма/НоваяСтрока.Количество;
			КонецЕсли;
			
			// Сопоставление
			СведенияОТоваре = Товар;
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
				"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
				
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					НоваяСтрока.ИдентификаторПоставщика = Идентификатор;
				КонецЕсли;
				
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом");
		
		ДокументОбъект.СведенияОЗаполненииДокумента = СокрЛП(ДокументОбъект.СведенияОЗаполненииДокумента);
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ОбменСКонтрагентами.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
		
		//Заполнение документа-основания 
		МассивДокОснований = Новый Массив;
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			МассивДокОснований.Добавить(СсылкаНаВладельца);
		КонецЕсли;
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", МассивДокОснований);
		
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

Процедура НайтиСоздатьУПДДокументОПередачеУслугРабот(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина, ВидПервичногоДокумента = "")
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.ПоступлениеУслугРабот.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		
		Если НЕ ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
			Возврат;
		КонецЕсли;	
		
		НайтиСсылкуНаОбъект("Валюты", ДокументОбъект.ВалютаДокумента,
			ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
		ВидОперации = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации");
		Если Не ЗначениеЗаполнено(ВидОперации) Тогда
			ВидОперации = Перечисления.ВидыОперацийЭД.ПродажаКомиссия;
		КонецЕсли;
		
		// Сведения о поставщике.
		ИННПоставщика = ""; КПППоставщика = "";
		ВидУчастника = "СведенияОПродавце";
		Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
			КПППоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
			ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
			Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
			Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
			Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
			
			ПредставлениеПоставщика = Фамилия + " " + Имя + " " + Отчество; 
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
			
			ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		КонецЕсли;
		Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("Контрагенты", ИННПоставщика, КПППоставщика, Контрагент);
		ДокументОбъект.Контрагент = Контрагент;
		
		// Сведения о покупателе.
		ИННПокупателя = ""; КПППокупателя = "";
		ВидУчастника = "СведенияОПокупателе";
		Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
			КПППокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
			ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
			Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
			Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
			Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
			
			ПредставлениеПокупателя = Фамилия + " " + Имя + " " + Отчество; 
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
			
			ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		КонецЕсли;
		Организация = Справочники.Организации.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("Организации", ИННПокупателя, КПППокупателя, Организация);
		ДокументОбъект.Организация = Организация;
		
		// Поиск и заполнения договора контрагента.
		ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
		Если Не ОснованияОтгрузки = Неопределено Тогда
			Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
				ДоговорНомер = ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
				Если ЗначениеЗаполнено(ДоговорНомер) Тогда
					
					ДоговорДата = ДатаИзСтроки(ЗначениеРеквизитаВДереве(
						СтрокаОснованиеОтгрузки, 
						"ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата"));
					
					СвойстваДоговора = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация", ДоговорНомер, ДоговорДата, ДокументОбъект.Контрагент, Организация);
					
					Договор = Справочники.Договоры.ПустаяСсылка();
					НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , СвойстваДоговора);
					
					ДокументОбъект.Договор = Договор;
				КонецЕсли;
				Прервать;
			КонецЦикла;
		КонецЕсли;
		
		Договор = ДоговорПоНастройкеЭДО(Контрагент, Организация);
		
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Договор) Тогда
			ДокументОбъект.Договор = Договор;
		КонецЕсли;	
		
		ДокументОбъект.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
		
		НомерДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
		ДатаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента");
		Если ВидПервичногоДокумента = "" Тогда
			ДокументОбъект.ВидПервичногоДокумента = "Акт об оказании услуг";
		Иначе	
			ДокументОбъект.ВидПервичногоДокумента = "Универсальный передаточный документ";
		КонецЕсли;
		ДокументОбъект.НомерПервичногоДокумента = НомерДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = ДатаДокумента;
		
		ДокументОбъект.УслугиИРаботы.Очистить();
		ДокументОбъект.ЗачетАвансов.Очистить();
			
		// Сведения таблицы.
		СтрокаТаблицаТоваров = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
		Для Каждого Товар Из СтрокаТаблицаТоваров.Строки Цикл
			
			НоваяСтрока = ДокументОбъект.УслугиИРаботы.Добавить();
			
			// Обязательные реквизиты:
			СтавкаНДС = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
			
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
			КонецЕсли;	
			
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаНДС = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СуммаНалога");
			НоваяСтрока.Всего = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
				
			// Необязательные реквизиты:
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", НоваяСтрока.ЕдиницаИзмерения,
				ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод"));
			НоваяСтрока.Количество = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.Количество");
			НоваяСтрока.Сумма = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
			
			// Сопоставление
			СведенияОТоваре = Товар;
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
				"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
				
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					НоваяСтрока.ИдентификаторПоставщика = Идентификатор;
				КонецЕсли;
				
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
				
			КонецЕсли;
			
			// Заполним номенклатуру поставщика
			
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом");
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ОбменСКонтрагентами.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
		
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

Процедура НайтиСоздатьУПДСчетФактуру(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина,  СпособОбработки, ОписаниеОшибки, ВидПервичногоДокумента = "")  Экспорт

	Если ТипСчетФактурыУПД(ДеревоДанных) = "ИсправлениеРеализации" Тогда
		НайтиСоздатьУПДИсправительныйСчетФактуру(ДеревоДанных, СсылкаНаВладельца, Записывать);
		Возврат;
	ИначеЕсли ТипСчетФактурыУПД(ДеревоДанных) = "ИсправлениеКорректировки" Тогда	
		НайтиСоздатьУПДИсправительныйСчетФактуру(ДеревоДанных, СсылкаНаВладельца, Записывать, "Корректировка");
		Возврат;
	КонецЕсли;	
		
	ДанныеЗаполненияШапки = Новый Структура;
	ДанныеЗаполненияШапки.Вставить("ЭДПоставщика", Документы.ЭлектронныйДокументПоставщика.ПустаяСсылка());
	
	ДокументыОснованияСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	
	ТаблицаОснований = Новый ТаблицаЗначений;
	ТаблицаОснований = Документы.СчетФактураПолученный.ПустаяСсылка().ДокументыОснования.ВыгрузитьКолонки();
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		Для Каждого ДокументОснования Из ДокументыОснованияСчетаФактуры Цикл
			Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				ДанныеЗаполненияШапки.ЭДПоставщика = ДокументОснования;
			Иначе	
				СтрокаТаблицы = ТаблицаОснований.Добавить();
				СтрокаТаблицы.ДокументОснование = ДокументОснования;
			КонецЕсли;	
			
		КонецЦикла;
	КонецЕсли;
	ТаблицаОснований.Свернуть("ДокументОснование");
	
	Если ТаблицаОснований.Количество() = 0 Тогда
		ТекстоваяИнформация = ДеревоДанных.Строки.Найти("ДопДанныеДокументаОтгрузки.ТекстоваяИнформация", "ПолныйПуть", Истина);
		ВидДокументаОснования = "";
		НомерДокументаОснования = "";
		ДатаДокументаОснования = Дата(1,1,1);
		Если ТекстоваяИнформация <> Неопределено Тогда
			Для Каждого СтрокаТекстовойИнформации Из ТекстоваяИнформация.Строки Цикл
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "ВидДокументаОснования" Тогда
					ВидДокументаОснования = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение");
				КонецЕсли;
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "НомерДокументаОснования" Тогда
					НомерПервичногоДокумента = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение");
				КонецЕсли;
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "ДатаДокументаОснования" Тогда
					ДатаПервичногоДокумента = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;	
	ДанныеЗаполненияШапки.Вставить("ДокументыОснования", ТаблицаОснований);
	
	ДанныеЗаполненияШапки.Вставить("ДатаПолучения", ТекущаяДатаСеанса());
	
	НомерДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДатаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента");
	
	ВалКод = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод");
	Если НЕ ВалКод = "643" Тогда
		ДанныеЗаполненияШапки.Вставить("ВИностраннойВалюте", Истина);
	КонецЕсли;
	Валюта = Справочники.Валюты.ПустаяСсылка();
	НайтиСсылкуНаОбъект("Валюты", Валюта, ВалКод);
