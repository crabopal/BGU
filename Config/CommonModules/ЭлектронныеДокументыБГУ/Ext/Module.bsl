							ДокументПоставщикаXDTO.СписокНоменклатурыПоставщика.Добавить(СтрокаСпискаНоменклатурыXDTO);
						КонецЦикла;
					КонецЕсли;
					
					//Сведения о прослеживаемости
					Если (ТипФорматаЭДП = 3) Тогда
						Для каждого ТекДанные Из ЭлектронныйДокументПоставщика.СведенияПрослеживаемости Цикл
							СтрокаСпискаПрослеживаемостиXDTO = СоздатьОбъектXDTO(ДокументПоставщикаXDTO, "СведенияОПрослеживаемости");
							
							ПараметрыОтбора = Новый Структура;
							ПараметрыОтбора.Вставить("ИдентификаторСтроки", ТекДанные.ИдентификаторСтроки);
							НайденныеСтроки = СписокНоменклатурыCИдентификаторами.НайтиСтроки(ПараметрыОтбора);
							
							GUIDНоменклатурыСписка = "";
							ЕдИзмКод = "";
							ЕдИзмНаим = "";
							ПолноеНаимНоменклатуры = "";
							Если НайденныеСтроки.Количество()>0 Тогда
								НайденнаяНоменклатура = НайденныеСтроки[0].Номенклатура;
								ЕдИзм = НайденныеСтроки[0].ЕдиницаИзмерения;
								
								Если ЗначениеЗаполнено(НайденнаяНоменклатура) Тогда
									GUIDНоменклатурыСписка = Строка(НайденнаяНоменклатура.УникальныйИдентификатор());
									
									ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НайденнаяНоменклатура, "НаименованиеПолное");
									ПолноеНаимНоменклатуры = ДанныеНоменклатуры.НаименованиеПолное;
									
									ДанныеЕдИзм = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдИзм, "Код, Наименование");
									ЕдИзмКод = СокрЛП(ДанныеЕдИзм.Код);
									ЕдИзмНаим = СокрЛП(ДанныеЕдИзм.Наименование);
								КонецЕсли;
							КонецЕсли;							
							СтрокаСпискаПрослеживаемостиXDTO.Установить("GUIDНоменклатуры", GUIDНоменклатурыСписка);
							СтрокаСпискаПрослеживаемостиXDTO.Установить("ПолноеНаимНоменклатуры", ПолноеНаимНоменклатуры);
							
							РНПТ = "";
							Если ЗначениеЗаполнено(ТекДанные.РНПТ) Тогда
								ДанныеРНПТ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекДанные.РНПТ, "Код");
								РНПТ = ДанныеРНПТ.Код;
							КонецЕсли;
							СтрокаСпискаПрослеживаемостиXDTO.Установить("РНПТ", СокрЛП(РНПТ));
							СтрокаСпискаПрослеживаемостиXDTO.Установить("КоличествоУчетное", ТекДанные.Количество);
							СтрокаСпискаПрослеживаемостиXDTO.Установить("Количество", ТекДанные.КоличествоПрослеживаемости);
							СтрокаСпискаПрослеживаемостиXDTO.Установить("ЕдИзмКод", ЕдИзмКод);
							СтрокаСпискаПрослеживаемостиXDTO.Установить("ЕдИзмНаим", ЕдИзмНаим);
							СтрокаСпискаПрослеживаемостиXDTO.Установить("ИдентификаторСтроки", СокрЛП(ТекДанные.ИдентификаторСтроки));
							
							ДокументПоставщикаXDTO.СведенияОПрослеживаемости.Добавить(СтрокаСпискаПрослеживаемостиXDTO);
						КонецЦикла;
					КонецЕсли;	
					
					ДокументXDTO.ДокументыПоставщика.Добавить(ДокументПоставщикаXDTO);
					
				ИначеЕсли (ТипФорматаЭДП = 7) ИЛИ (ТипФорматаЭДП = 8) Тогда
					СписокНоменклатурыCИдентификаторами = Новый ТаблицаЗначений;
					СписокНоменклатурыCИдентификаторами.Колонки.Добавить("Номенклатура");
					СписокНоменклатурыCИдентификаторами.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
					СписокНоменклатурыCИдентификаторами.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
					
					ДокументПоставщикаXDTO = СоздатьОбъектXDTO(ДокументXDTO, "ДокументыПоставщика");
					
					ВидДокумента = НСтр("ru = 'Акт о приеме-передаче объектов нефинансовых активов'");
					ДатаДокумента = Формат(ДокументПриложения.Дата, "ДФ=dd.MM.yyyy");
					НомерДокумента = ДокументПриложения.Номер;
					
					НФАПоДокументуПереданыЭлектроннымАктом = НФАПоДокументуПереданыЭлектроннымАктом(ДокументПриложения);
					ДокументПоставщикаXDTO.НФАПереданыЭлектроннымАктом = НФАПоДокументуПереданыЭлектроннымАктом;
					ДокументПоставщикаXDTO.СведенияПолучателяНФА = Ложь;
					
					ДокументПоставщикаXDTO.Установить("ВидДокумента", ВидДокумента);
					ДокументПоставщикаXDTO.Установить("Дата", ДатаДокумента);
					ДокументПоставщикаXDTO.Установить("Номер", НомерДокумента);
					
					НаименованиеДокументаПоставщика = СокрЛП(ВидДокумента) + " от " + ДатаДокумента + " № " 
						+ СокрЛП(НомерДокумента);
					ДокументПоставщикаXDTO.Установить("Наим", НаименованиеДокументаПоставщика);
					
					Если (ТипИзвещения = 25) Тогда
						ДокументПоставщикаXDTO.СведенияПолучателяНФА = Истина;
					КонецЕсли;	
					
					ЭлектронныйДокументПоставщика = ДокументПриложения;
					ДокументПоставщикаXDTO.Установить("СуммаДокумента", ЭлектронныйДокументПоставщика.СуммаДокумента);
					ДокументПоставщикаXDTO.Установить("GUIDДокумента", Строка(ЭлектронныйДокументПоставщика.УникальныйИдентификатор()));
					ДокументПоставщикаXDTO.Установить("ТипФорматаЭД", Формат(ТипФорматаЭДП,"ЧЦ=10"));
					ДокументПоставщикаXDTO.Установить("СуммаВключаетНДС", ?(ЭлектронныйДокументПоставщика.СуммаВключаетНДС,"Да","Нет"));
					
					Если ТипФорматаЭДП = 7 Тогда
						ВалютаДокумента = ЭлектронныйДокументПоставщика.ВалютаДокумента;
					Иначе
						ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
					КонецЕсли;	
					
					Если ЗначениеЗаполнено(ВалютаДокумента) Тогда
						ДокументПоставщикаXDTO.Установить("ВалютаКод", ВалютаДокумента.Код);
						ДокументПоставщикаXDTO.Установить("ВалютаНаим", СокрЛП(ВалютаДокумента));
					Иначе
						ДокументПоставщикаXDTO.Установить("ВалютаКод", "");
						ДокументПоставщикаXDTO.Установить("ВалютаНаим", "");
					КонецЕсли;
					
					Для каждого ТекНоменклатура Из ЭлектронныйДокументПоставщика.ОсновныеСредства Цикл
						Номенклатура = ТекНоменклатура.ОсновноеСредство;
						СтрокаСпискаНоменклатурыXDTO = СоздатьОбъектXDTO(ДокументПоставщикаXDTO, "СписокНоменклатурыПоставщика");
						СтрокаСпискаНоменклатурыXDTO.Установить("GUIDНоменклатуры", Строка(Номенклатура.УникальныйИдентификатор()));
						
						ЗначенияРеквизитовНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "GUIDНоменклатурыОтправителя");
						
						GUIDНоменклатурыОтправителя = ЗначенияРеквизитовНоменклатуры.GUIDНоменклатурыОтправителя;
						Если НЕ ЗначениеЗаполнено(GUIDНоменклатурыОтправителя) Тогда
							GUIDНоменклатурыСтр = ИдентификаторНоменклатурыОтправителяЭД(ЭлектронныйДокументПоставщика.Контрагент, Номенклатура);
							GUIDНоменклатурыОтправителя = СтрЗаменить(GUIDНоменклатурыСтр, "#", "");
						КонецЕсли;
						
						СтрокаСпискаНоменклатурыXDTO.Установить("GUIDНоменклатурыОтправителя", Строка(GUIDНоменклатурыОтправителя));
						
						СтрокаСпискаНоменклатурыXDTO.Установить("НаимНоменклатуры", Номенклатура.Наименование);
						СтрокаСпискаНоменклатурыXDTO.Установить("ПолноеНаимНоменклатуры", Номенклатура.НаименованиеПолное);
						СтрокаСпискаНоменклатурыXDTO.Установить("СтавкаНДС", СтавкаНДССтрокой(ТекНоменклатура.СтавкаНДС));
						РодительскаяГруппа = ТекНоменклатура.ОсновноеСредство.Родитель;
						СтрокаСпискаНоменклатурыXDTO.Установить("ГруппаСправочника", СокрЛП(РодительскаяГруппа));
						СтрокаСпискаНоменклатурыXDTO.Установить("НоменклатурныйНомер", Номенклатура.НоменклатурныйНомер);
						ПризнакНоменклатуры = НСтр("ru = '1ОС'");
						СтрокаСпискаНоменклатурыXDTO.Установить("ПризнакНоменклатуры", ПризнакНоменклатуры);
						Цена = 0;
						Сумма = 0;
						Всего = 0;
						Если ТекНоменклатура.СуммаПродажи <> 0 Тогда
							Цена = ТекНоменклатура.ЦенаПродажи;
							Сумма = ТекНоменклатура.СуммаПродажи;
						Иначе
							Если ТекНоменклатура.Количество = 0 Тогда
								Цена = ТекНоменклатура.Сумма;
							Иначе	
								Цена = Окр(ТекНоменклатура.Сумма/ТекНоменклатура.Количество, 2);
							КонецЕсли;
							Сумма = ТекНоменклатура.Сумма;
						КонецЕсли;
						Если ТекНоменклатура.Всего = 0 Тогда
							Всего = Сумма;
						Иначе
							Всего = ТекНоменклатура.Всего;
						КонецЕсли;	
						
						СтрокаСпискаНоменклатурыXDTO.Установить("Цена", Формат(Цена, "ЧЦ=17; ЧДЦ=2"));
						СтрокаСпискаНоменклатурыXDTO.Установить("Сумма", Формат(Сумма, "ЧЦ=17; ЧДЦ=2"));
						СтрокаСпискаНоменклатурыXDTO.Установить("Количество", Формат(ТекНоменклатура.Количество, "ЧЦ=17; ЧДЦ=3"));
						СтрокаСпискаНоменклатурыXDTO.Установить("СуммаНДС", Формат(ТекНоменклатура.СуммаНДС, "ЧЦ=17; ЧДЦ=2"));
						СтрокаСпискаНоменклатурыXDTO.Установить("Всего", Формат(Всего, "ЧЦ=17; ЧДЦ=2"));
						
						Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
							СтрокаСпискаНоменклатурыXDTO.Установить("ТипСправочника", НСтр("ru = 'ОсновныеСредства'"));
							СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмКод", "");
							СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмНаим", "");
							
							СтрокаСпискаНоменклатурыXDTO.Установить("ТипНоменклатуры", "");
							
							СтрокаСпискаНоменклатурыXDTO.Установить("СтранаПроисхожденияКод", "");
							СтрокаСпискаНоменклатурыXDTO.Установить("СтранаПроисхождения", "");
							
							СтрокаСпискаНоменклатурыXDTO.Установить("НомерГТД", "");
							
							СтрокаСпискаНоменклатурыXDTO.Установить("КодОКДП", "");
							СтрокаСпискаНоменклатурыXDTO.Установить("ТНВЭД", "");
							
							СтруктураСведенияОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "ВидНФА,ТипНФА,КодОКОФ,
							|ГрупповойУчет,АмортизационнаяГруппа,Назначение,Сведения,ИзготовительОС, GUIDНоменклатурыОтправителя");
							
							СтрокаСпискаНоменклатурыXDTO.Установить("ВидНФА", XMLстрока(СтруктураСведенияОС.ВидНФА));
							СтрокаСпискаНоменклатурыXDTO.Установить("ТипНФА", XMLстрока(СтруктураСведенияОС.ТипНФА));
							СтрокаСпискаНоменклатурыXDTO.Установить("GUIDНоменклатурыОтправителя", XMLстрока(СтруктураСведенияОС.GUIDНоменклатурыОтправителя));
							
							ПустоеЗначениеРеквизита = НСтр("ru = ''");
							
							Если ЗначениеЗаполнено(СтруктураСведенияОС.КодОКОФ) Тогда
								СтруктураОКОФ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураСведенияОС.КодОКОФ, "Код");
								СтрокаСпискаНоменклатурыXDTO.Установить("КодОКОФ", XMLстрока(СтруктураОКОФ.Код));
							Иначе
								СтрокаСпискаНоменклатурыXDTO.Установить("КодОКОФ", XMLстрока(ПустоеЗначениеРеквизита));
							КонецЕсли;
							
							Если (ТипФорматаЭДП = 7) Тогда
								НоваяНоменклатураИGUID = СписокНоменклатурыCИдентификаторами.Добавить();
								НоваяНоменклатураИGUID.Номенклатура = Номенклатура;
								НоваяНоменклатураИGUID.ИдентификаторСтроки = ТекНоменклатура.ИдентификаторСтроки;
								НоваяНоменклатураИGUID.ЕдиницаИзмерения = Штуки();
								
								Если ЗначениеЗаполнено(ТекНоменклатура.СтранаПроисхождения) Тогда
									СтранаПроисхождения = ТекНоменклатура.СтранаПроисхождения;
									
									ДанныеСтраны = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтранаПроисхождения, "Код, Наименование");
									
									СтрокаСпискаНоменклатурыXDTO.Установить("СтранаПроисхожденияКод", ДанныеСтраны.Код);
									СтрокаСпискаНоменклатурыXDTO.Установить("СтранаПроисхождения", ДанныеСтраны.Наименование);
								КонецЕсли;
								
								Если ЗначениеЗаполнено(Номенклатура.КодТНВЭД) Тогда
									НомерТНВЭД = Номенклатура.КодТНВЭД;
									СтрокаСпискаНоменклатурыXDTO.Установить("ТНВЭД", СокрЛП(НомерТНВЭД.Код));
								Иначе	
									СтрокаСпискаНоменклатурыXDTO.Установить("ТНВЭД", "");
								КонецЕсли;

								Если ЗначениеЗаполнено(Номенклатура.ОКП) Тогда
									НомерОКП = Номенклатура.ОКП;
									СтрокаСпискаНоменклатурыXDTO.Установить("КодОКДП", СокрЛП(НомерОКП.Код));
								Иначе	
									СтрокаСпискаНоменклатурыXDTO.Установить("КодОКДП", "");
								КонецЕсли;

								Если Номенклатура.ПрослеживаемыйТовар Тогда
									СтрокаСпискаНоменклатурыXDTO.Установить("ПрослеживаемыйТовар", XMLстрока(НСтр("ru = 'Да'")));
								Иначе
									СтрокаСпискаНоменклатурыXDTO.Установить("ПрослеживаемыйТовар", XMLстрока(НСтр("ru = 'Нет'")));
								КонецЕсли;
								
								СтрокаСпискаНоменклатурыXDTO.Установить("ИдентификаторСтроки", ТекНоменклатура.ИдентификаторСтроки);
							Иначе	
								СтрокаСпискаНоменклатурыXDTO.Установить("ИдентификаторСтроки", "");
							КонецЕсли;
							
							Если ЗначениеЗаполнено(СтруктураСведенияОС.АмортизационнаяГруппа) Тогда
								СтрокаСпискаНоменклатурыXDTO.Установить("АмортизационнаяГруппа", XMLстрока(СтруктураСведенияОС.АмортизационнаяГруппа));
							Иначе
								СтрокаСпискаНоменклатурыXDTO.Установить("АмортизационнаяГруппа", XMLстрока(ПустоеЗначениеРеквизита));
							КонецЕсли;
							
							Если СтруктураСведенияОС.ГрупповойУчет Тогда
								СтрокаСпискаНоменклатурыXDTO.Установить("ГрупповойУчет", XMLстрока(НСтр("ru = 'Да'")));
							Иначе
								СтрокаСпискаНоменклатурыXDTO.Установить("ГрупповойУчет", XMLстрока(НСтр("ru = 'Нет'")));
							КонецЕсли;
					
							СтрокаСпискаНоменклатурыXDTO.Установить("Назначение", XMLстрока(СтруктураСведенияОС.Назначение));
							СтрокаСпискаНоменклатурыXDTO.Установить("Сведения", XMLстрока(СтруктураСведенияОС.Сведения));
							Если ЗначениеЗаполнено(СтруктураСведенияОС.ИзготовительОС) Тогда
								СтруктураИзготовительОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураСведенияОС.ИзготовительОС, "КодОКПО,НаименованиеПолное");

								СтрокаСпискаНоменклатурыXDTO.Установить("Изготовитель", XMLстрока(СтруктураИзготовительОС.НаименованиеПолное));
								СтрокаСпискаНоменклатурыXDTO.Установить("ИзготовительОКПО", XMLстрока(СтруктураИзготовительОС.КодОКПО));
							Иначе
								СтрокаСпискаНоменклатурыXDTO.Установить("Изготовитель", XMLстрока(ПустоеЗначениеРеквизита));
								СтрокаСпискаНоменклатурыXDTO.Установить("ИзготовительОКПО", XMLстрока(ПустоеЗначениеРеквизита));
							КонецЕсли;
							
							Если ЗначениеЗаполнено(ТекНоменклатура.ИнвентарныйНомер) Тогда
								СтруктураИнвНомер = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекНоменклатура.ИнвентарныйНомер, "Код");
								СтрокаСпискаНоменклатурыXDTO.Установить("ИнвентарныйНомер", XMLстрока(СтруктураИнвНомер.Код));
								СтрокаСпискаНоменклатурыXDTO.Установить("GUIDИнвентарногоНомера", Строка(ТекНоменклатура.ИнвентарныйНомер.УникальныйИдентификатор()));
								СтрокаСпискаНоменклатурыXDTO.Установить("ИнвентарныйНомерУОтправителя", "");
							Иначе
								СтрокаСпискаНоменклатурыXDTO.Установить("ИнвентарныйНомер", "");
								СтрокаСпискаНоменклатурыXDTO.Установить("GUIDИнвентарногоНомера", "");
								СтрокаСпискаНоменклатурыXDTO.Установить("ИнвентарныйНомерУОтправителя", "");
							КонецЕсли;
							
							Если ЗначениеЗаполнено(ТекНоменклатура.СчетУчета) Тогда
								СтруктураСчетУчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекНоменклатура.СчетУчета, "Код");
								СтрокаСпискаНоменклатурыXDTO.Установить("СчетУчета", XMLстрока(СтруктураСчетУчета.Код));
							Иначе
								СтрокаСпискаНоменклатурыXDTO.Установить("СчетУчета", XMLстрока(ПустоеЗначениеРеквизита));
							КонецЕсли;
							
							Если (ТипФорматаЭДП = 7) Тогда
								СтрокаСпискаНоменклатурыXDTO.Установить("СуммаАмортизации", Формат(ТекНоменклатура.СуммаАмортизации + ТекНоменклатура.СуммаАмортизацииЗаТекущийМесяц, "ЧЦ=15; ЧДЦ=2"));
								СтрокаСпискаНоменклатурыXDTO.Установить("СуммаОбесценения", Формат(ТекНоменклатура.СуммаОбесценения, "ЧЦ=15; ЧДЦ=2"));
							ИначеЕсли (ТипФорматаЭДП = 8) Тогда
								СуммаОбесценения = 0;
								СтрокаСпискаНоменклатурыXDTO.Установить("СуммаАмортизации", Формат(ТекНоменклатура.СуммаАмортизации + ТекНоменклатура.СуммаАмортизацииЗаТекущийМесяц, "ЧЦ=15; ЧДЦ=2"));
								СтрокаСпискаНоменклатурыXDTO.Установить("СуммаОбесценения", Формат(СуммаОбесценения, "ЧЦ=15; ЧДЦ=2"));
							КонецЕсли;
							
							ДатаВводаВЭксплуатациюОС = ДатаВводаВЭксплуатацию(ТекНоменклатура.ОсновноеСредство, ТекНоменклатура.ИнвентарныйНомер, ЭлектронныйДокументПоставщика.Организация, ЭлектронныйДокументПоставщика.Дата);
							Если ЗначениеЗаполнено(ДатаВводаВЭксплуатациюОС) Тогда
								ДатаВЭ = Формат(ДатаВводаВЭксплуатациюОС, "ДФ=dd.MM.yyyy");
								СтрокаСпискаНоменклатурыXDTO.Установить("ДатаВводаВЭксплуатацию", ДатаВЭ);
							Иначе
								СтрокаСпискаНоменклатурыXDTO.Установить("ДатаВводаВЭксплуатацию", XMLстрока(ПустоеЗначениеРеквизита));
							КонецЕсли;
						КонецЕсли;	
						
						ДокументПоставщикаXDTO.СписокНоменклатурыПоставщика.Добавить(СтрокаСпискаНоменклатурыXDTO);
					КонецЦикла;
					
					//Сведения о прослеживаемости
					Если (ТипФорматаЭДП = 7) Тогда
						Для каждого ТекДанные Из ЭлектронныйДокументПоставщика.СведенияПрослеживаемости Цикл
							СтрокаСпискаПрослеживаемостиXDTO = СоздатьОбъектXDTO(ДокументПоставщикаXDTO, "СведенияОПрослеживаемости");
							
							ПараметрыОтбора = Новый Структура;
							ПараметрыОтбора.Вставить("ИдентификаторСтроки", ТекДанные.ИдентификаторСтроки);
							НайденныеСтроки = СписокНоменклатурыCИдентификаторами.НайтиСтроки(ПараметрыОтбора);
							
							GUIDНоменклатурыСписка = "";
							ЕдИзмКод = "";
							ЕдИзмНаим = "";
							ПолноеНаимНоменклатуры = "";
							
							Если НайденныеСтроки.Количество()>0 Тогда
								НайденнаяНоменклатура = НайденныеСтроки[0].Номенклатура;
								ЕдИзм = НайденныеСтроки[0].ЕдиницаИзмерения;
								
								Если ЗначениеЗаполнено(НайденнаяНоменклатура) Тогда
									GUIDНоменклатурыСписка = Строка(НайденнаяНоменклатура.УникальныйИдентификатор());
									
									ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НайденнаяНоменклатура, "НаименованиеПолное");
									ПолноеНаимНоменклатуры = ДанныеНоменклатуры.НаименованиеПолное;
									
									ДанныеЕдИзм = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдИзм, "Код, Наименование");
									ЕдИзмКод = СокрЛП(ДанныеЕдИзм.Код);
									ЕдИзмНаим = СокрЛП(ДанныеЕдИзм.Наименование);
								КонецЕсли;
							КонецЕсли;							
							СтрокаСпискаПрослеживаемостиXDTO.Установить("GUIDНоменклатуры", GUIDНоменклатурыСписка);
							СтрокаСпискаПрослеживаемостиXDTO.Установить("ПолноеНаимНоменклатуры", ПолноеНаимНоменклатуры);
							
							РНПТ = "";
							Если ЗначениеЗаполнено(ТекДанные.РНПТ) Тогда
								ДанныеРНПТ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекДанные.РНПТ, "Код");
								РНПТ = ДанныеРНПТ.Код;
							КонецЕсли;
							СтрокаСпискаПрослеживаемостиXDTO.Установить("РНПТ", СокрЛП(РНПТ));
							СтрокаСпискаПрослеживаемостиXDTO.Установить("КоличествоУчетное", ТекДанные.Количество);
							СтрокаСпискаПрослеживаемостиXDTO.Установить("Количество", ТекДанные.КоличествоПрослеживаемости);
							СтрокаСпискаПрослеживаемостиXDTO.Установить("ЕдИзмКод", ЕдИзмКод);
							СтрокаСпискаПрослеживаемостиXDTO.Установить("ЕдИзмНаим", ЕдИзмНаим);
							СтрокаСпискаПрослеживаемостиXDTO.Установить("ИдентификаторСтроки", СокрЛП(ТекДанные.ИдентификаторСтроки));
							
							ДокументПоставщикаXDTO.СведенияОПрослеживаемости.Добавить(СтрокаСпискаПрослеживаемостиXDTO);
						КонецЦикла;
					КонецЕсли;	
					
					ДокументXDTO.ДокументыПоставщика.Добавить(ДокументПоставщикаXDTO);
					
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
		СписокНоменклатурыCИдентификаторами = Новый ТаблицаЗначений;
		СписокНоменклатурыCИдентификаторами.Колонки.Добавить("Номенклатура");
		СписокНоменклатурыCИдентификаторами.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
		СписокНоменклатурыCИдентификаторами.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
		
		Для каждого ТекСтрока Из Приложения Цикл
			ДокументПриложения = ТекСтрока.ДокументПриложения;
			Если ЗначениеЗаполнено(ДокументПриложения) Тогда
				Если ТипЗнч(ДокументПриложения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
					ДокументПоставщикаXDTO = СоздатьОбъектXDTO(ДокументXDTO, "ДокументыПоставщика");
					
					ДатаДокумента = Формат(ТекСтрока.ДатаДокумента, "ДФ=dd.MM.yyyy");
					
					ДокументПоставщикаXDTO.Установить("ВидДокумента", ТекСтрока.ВидДокумента);
					ДокументПоставщикаXDTO.Установить("Дата", ДатаДокумента);
					ДокументПоставщикаXDTO.Установить("Номер", ТекСтрока.НомерДокумента);
					НаименованиеДокументаПоставщика = СокрЛП(ТекСтрока.ВидДокумента) + " от " + ДатаДокумента + " № " 
						+ СокрЛП(ТекСтрока.НомерДокумента);
					ДокументПоставщикаXDTO.Установить("Наим", НаименованиеДокументаПоставщика);
					
					ЭлектронныйДокументПоставщика = ДокументПриложения;
					ДокументПоставщикаXDTO.Установить("СуммаДокумента", ЭлектронныйДокументПоставщика.СуммаДокумента);
					ДокументПоставщикаXDTO.Установить("GUIDДокумента", Строка(ЭлектронныйДокументПоставщика.УникальныйИдентификатор()));
					ДокументПоставщикаXDTO.Установить("ТипФорматаЭД", Формат(ЭлектронныйДокументПоставщика.ТипФорматаЭД,"ЧЦ=10"));
					ДокументПоставщикаXDTO.Установить("СуммаВключаетНДС", ?(ЭлектронныйДокументПоставщика.СуммаВключаетНДС,"Да","Нет"));
					Если ЗначениеЗаполнено(ЭлектронныйДокументПоставщика.ВалютаДокумента) Тогда
						ДокументПоставщикаXDTO.Установить("ВалютаКод", ЭлектронныйДокументПоставщика.ВалютаДокумента.Код);
						ДокументПоставщикаXDTO.Установить("ВалютаНаим", СокрЛП(ЭлектронныйДокументПоставщика.ВалютаДокумента));
					КонецЕсли;
					
					Для каждого ТекНоменклатура Из ЭлектронныйДокументПоставщика.СписокНоменклатуры Цикл
						Номенклатура = ТекНоменклатура.Номенклатура;
						СтрокаСпискаНоменклатурыXDTO = СоздатьОбъектXDTO(ДокументПоставщикаXDTO, "СписокНоменклатурыПоставщика");
						СтрокаСпискаНоменклатурыXDTO.Установить("ИдентификаторСтроки", ТекНоменклатура.ИдентификаторСтроки);
						СтрокаСпискаНоменклатурыXDTO.Установить("GUIDНоменклатуры", Строка(Номенклатура.УникальныйИдентификатор()));
						
						ЗначенияРеквизитовНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "GUIDНоменклатурыОтправителя");
						СтрокаСпискаНоменклатурыXDTO.Установить("GUIDНоменклатурыОтправителя", Строка(ЗначенияРеквизитовНоменклатуры.GUIDНоменклатурыОтправителя));
						
						СтрокаСпискаНоменклатурыXDTO.Установить("НаимНоменклатуры", Номенклатура.Наименование);
						СтрокаСпискаНоменклатурыXDTO.Установить("ПолноеНаимНоменклатуры", Номенклатура.НаименованиеПолное);
						СтрокаСпискаНоменклатурыXDTO.Установить("СтавкаНДС", СтавкаНДССтрокой(ТекНоменклатура.СтавкаНДС));
						РодительскаяГруппа = ТекНоменклатура.Номенклатура.Родитель;
						СтрокаСпискаНоменклатурыXDTO.Установить("ГруппаСправочника", СокрЛП(РодительскаяГруппа));
						СтрокаСпискаНоменклатурыXDTO.Установить("НоменклатурныйНомер", Номенклатура.НоменклатурныйНомер);
						СтрокаСпискаНоменклатурыXDTO.Установить("ПризнакНоменклатуры", ТекНоменклатура.ПризнакНоменклатуры);
						СтрокаСпискаНоменклатурыXDTO.Установить("Цена", Формат(ТекНоменклатура.Цена, "ЧЦ=17; ЧДЦ=2"));
						СтрокаСпискаНоменклатурыXDTO.Установить("Сумма", Формат(ТекНоменклатура.Сумма, "ЧЦ=17; ЧДЦ=2"));
						СтрокаСпискаНоменклатурыXDTO.Установить("Количество", Формат(ТекНоменклатура.Количество, "ЧЦ=17; ЧДЦ=3"));
						СтрокаСпискаНоменклатурыXDTO.Установить("СуммаНДС", Формат(ТекНоменклатура.СуммаНДС, "ЧЦ=17; ЧДЦ=2"));
						СтрокаСпискаНоменклатурыXDTO.Установить("Всего", Формат(ТекНоменклатура.Всего, "ЧЦ=17; ЧДЦ=2"));

						Если Номенклатура.ПрослеживаемыйТовар Тогда
							СтрокаСпискаНоменклатурыXDTO.Установить("ПрослеживаемыйТовар", XMLстрока(НСтр("ru = 'Да'")));
							
							НоваяНоменклатураИGUID = СписокНоменклатурыCИдентификаторами.Добавить();
							НоваяНоменклатураИGUID.Номенклатура = Номенклатура;
							НоваяНоменклатураИGUID.ИдентификаторСтроки = ТекНоменклатура.ИдентификаторСтроки;
							НоваяНоменклатураИGUID.ЕдиницаИзмерения = ТекНоменклатура.ЕдиницаИзмерения;
						Иначе
							СтрокаСпискаНоменклатурыXDTO.Установить("ПрослеживаемыйТовар", XMLстрока(НСтр("ru = 'Нет'")));
						КонецЕсли;
						
						Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
							СтрокаСпискаНоменклатурыXDTO.Установить("ТипСправочника", НСтр("ru = 'ОсновныеСредства'"));
							СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмКод", "");
							СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмНаим", "");
							СтрокаСпискаНоменклатурыXDTO.Установить("ТипНоменклатуры", "");
							СтрокаСпискаНоменклатурыXDTO.Установить("СтранаПроисхожденияКод", "");
							СтрокаСпискаНоменклатурыXDTO.Установить("СтранаПроисхождения", "");
							СтрокаСпискаНоменклатурыXDTO.Установить("НомерГТД", "");
							СтрокаСпискаНоменклатурыXDTO.Установить("КодОКДП", "");
							СтрокаСпискаНоменклатурыXDTO.Установить("ТНВЭД", "");
							
							Если ЗначениеЗаполнено(Номенклатура.ВидНФА) Тогда
								ВидНФА = Номенклатура.ВидНФА;
								СтрокаСпискаНоменклатурыXDTO.Установить("ВидНФА", XMLстрока(ВидНФА));
							Иначе	
								СтрокаСпискаНоменклатурыXDTO.Установить("ВидНФА", "");
							КонецЕсли;
							
							Если ЗначениеЗаполнено(Номенклатура.ТипНФА) Тогда
								ТипНФА = Номенклатура.ТипНФА;
								СтрокаСпискаНоменклатурыXDTO.Установить("ТипНФА", XMLстрока(ТипНФА));
							Иначе	
								СтрокаСпискаНоменклатурыXDTO.Установить("ТипНФА", "");
							КонецЕсли;
							
						ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
							СтрокаСпискаНоменклатурыXDTO.Установить("ТипСправочника", НСтр("ru = 'Номенклатура'"));
							Если ЗначениеЗаполнено(Номенклатура.ЕдиницаИзмерения) Тогда
								ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
								СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмКод", ЕдиницаИзмерения.Код);
								СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмНаим", ЕдиницаИзмерения.Наименование);
							Иначе	
								СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмКод", "");
								СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмНаим", "");
							КонецЕсли;
							
							СтрокаСпискаНоменклатурыXDTO.Установить("ТипНоменклатуры", XMLстрока(Номенклатура.ТипНоменклатуры));
							
							Если ЗначениеЗаполнено(Номенклатура.СтранаПроисхождения) Тогда
								СтранаПроисхождения = Номенклатура.СтранаПроисхождения;
								СтрокаСпискаНоменклатурыXDTO.Установить("СтранаПроисхожденияКод", СтранаПроисхождения.Код);
								СтрокаСпискаНоменклатурыXDTO.Установить("СтранаПроисхождения", СтранаПроисхождения.Наименование);
