// Кэширует значения колонок "НомерСтроки, МаркируемыеУпаковки" из коллекции данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура КэшироватьРеквизитыМаркировкиАктаОРасхожденияхБой(КоллекцияДанных, Кэш) Экспорт
	
	РеквизитыМаркировки = КоллекцияДанных.Выгрузить(, КэшируемыеРеквизитыМаркировкиБой());
	Кэш.Вставить("РеквизитыМаркировкиБой", РеквизитыМаркировки);
	
КонецПроцедуры

// Кэширует значения колонок "НомерСтроки, МаркируемыеУпаковки" из коллекции данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура КэшироватьРеквизитыМаркировкиАктаОРасхожденияхНедостача(КоллекцияДанных, Кэш) Экспорт
	
	РеквизитыМаркировки = КоллекцияДанных.Выгрузить(, КэшируемыеРеквизитыМаркировкиНедостача());
	Кэш.Вставить("РеквизитыМаркировкиНедостача", РеквизитыМаркировки);
	
КонецПроцедуры

// Кэширует значения колонок "НомерСтроки, МаркируемыеУпаковки" из коллекции данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура КэшироватьРеквизитыМаркировкиАктаОРасхожденияхИзлишки(КоллекцияДанных, Кэш) Экспорт
	
	РеквизитыМаркировки = КоллекцияДанных.Выгрузить(, КэшируемыеРеквизитыМаркировкиИзлишки());
	Кэш.Вставить("РеквизитыМаркировкиИзлишки", РеквизитыМаркировки);
	
КонецПроцедуры

#КонецОбласти

#Область УКД_2020

// Подготавливает данные для электронного документа типа КорректировочныйСчетФактураВыданный.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ЗаполнитьДанныеУКДИнформацияПродавцаФНС_2020(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		ДокументПрошелКонтроль = Документы.КорректировочныйСчетФактураВыданный.ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
		ДанныеДокумента = Документы.КорректировочныйСчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ДокументПрошелКонтроль = Документы.ИсправительныйСчетФактураВыданный.ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
		ДанныеДокумента = Документы.ИсправительныйСчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект, "КСФ", Ложь);
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Если НЕ ДокументПрошелКонтроль Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	Шапка = ДанныеДокумента["Шапка"][0];
	
	СтороныСделки	= ДанныеДокумента["СтороныСделки"];
	НомерДокумента	= ДанныеДокумента["НомерДокумента"];
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Контракт = ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(Шапка.Договор);
	ЕстьЭлектронноеАктирование = ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС()
		И ЗначениеЗаполнено(Контракт)
		И ЭлектронноеАктированиеЕИС.ОбменПоОрганизацииВключен(Шапка.Организация);
	ДанныеДокумента.Вставить("ЕстьЭлектронноеАктирование", ЕстьЭлектронноеАктирование);
	
	ДанныеЭлектронногоАктирования = Неопределено;
	ДанныеПриложенияЕИС = Неопределено;
	Если ЕстьЭлектронноеАктирование Тогда
		ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеЭлектронногоАктированияУКД(ДанныеДокумента, Шапка);
		ДанныеЭлектронногоАктирования = ДанныеДокумента.ДанныеЭлектронногоАктирования;
		ДанныеПриложенияЕИС = ЭлектронноеАктированиеЕИС.НовыеДанныеПриложенияКТитулуПродавцаУКД();
		
		ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеДереваДляЭлектронногоАктированияЕИС(ДеревоДанных,
			ДанныеЭлектронногоАктирования,
			Шапка,
			ДанныеПриложенияЕИС,
			Истина);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидДокумента", "Корректировка"); // или "Возврат"
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СоставительДокументаНаименование", Шапка.Организация.НаименованиеПолное);
	
	Если ЗначениеЗаполнено(Шапка.ДокументОснование) Тогда
		ДокументыОснования = Новый Массив();
		ДокументыОснования.Добавить(Шапка.ДокументОснование);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", ДокументыОснования);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаКорректировочногоСчетаФактуры", СсылкаНаОбъект);
	
	// Номер, дата КСФ
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДляПечати(СсылкаНаОбъект, НомерДокумента.НомерКСФ));
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента", Шапка.Дата);
	
	НомерИсправления = Шапка.НомерИсправленияКорректировки;
	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления", НомерИсправления);
	КонецЕсли;
	
	ДатаИсправления = Шапка.ДатаИсправленияКорректировки;
	Если ЗначениеЗаполнено(ДатаИсправления) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления", ДатаИсправления);
	КонецЕсли;
	
	ЗаполнитьИсходныеДокументыУКД_2020(ДеревоДанных, ДанныеДокумента);
	
	Если ЗначениеЗаполнено(Шапка.ВалютаКод) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект.ВалютаДокумента, 
			"Объект.Код");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ВалютаДокумента");
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", Шапка.ВалютаКод, ПараметрыОбработкиОшибок);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", "Предлагаю изменить стоимость");
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаНаправленияНаСогласование", Шапка.Дата);
	
	ОснованиеКорректировки = Новый ТаблицаЗначений;
	ОснованиеКорректировки.Колонки.Добавить("ДокументНаименование", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(255,ДопустимаяДлина.Фиксированная)));
	ОснованиеКорректировки.Колонки.Добавить("ДокументНомер", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(255,ДопустимаяДлина.Фиксированная)));
	ОснованиеКорректировки.Колонки.Добавить("ДокументДата", Новый ОписаниеТипов("Дата",,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ОснованиеКорректировки.Колонки.Добавить("ДокументДопСведения", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(1000,ДопустимаяДлина.Фиксированная)));
	
	// Проверка заполненности всех реквизитов этой таблицы выполняется заранее (см. ДокументПрошелКонтроль).
	// Это сделано из-за даты договора (она может быть пустой).
	// Если на текущем этапе выполнить установку пустой даты
	// соответствующему параметру типа ON_NKORSCHFDOPPR_2020.ДатаТип,
	// то будет вызвано исключение, т.к. пустая дата несовместима с этим типом.
	
	Если ЗначениеЗаполнено(Шапка.Договор) Тогда
		НоваяСтрока = ОснованиеКорректировки.Добавить();
		НоваяСтрока.ДокументНаименование = Шапка.Договор.ВидОбязательства;
		НоваяСтрока.ДокументНомер = Шапка.Договор.НомерДоговора;
		НоваяСтрока.ДокументДата = Шапка.Договор.ДатаДоговора;
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованиеКорректировки, "ОснованиеКорректировки");
	КонецЕсли;
	
	// Продавец
	ЗаполнитьСведенияОбУчастникеУКД_2020(ДеревоДанных, СтороныСделки, "СведенияОПродавце", СсылкаНаОбъект,, ДанныеЭлектронногоАктирования);
	
	// Покупатель
	ЗаполнитьСведенияОбУчастникеУКД_2020(ДеревоДанных, СтороныСделки, "СведенияОПокупателе", СсылкаНаОбъект,, ДанныеЭлектронногоАктирования);
	
	// ДополнительныеСведенияОбУчастниках
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", Шапка.ИдентификаторГосКонтракта);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДополнительныеСведенияОбУчастниках.ВалютаНаименование", Шапка.ВалютаПредставление);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДополнительныеСведенияОбУчастниках.ВалютаКурс", Шапка.Курс);

	//доп. данные маркировки
	Если Шапка.СведенияОВыбытииМаркированныхТоваров > 0 Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОВыбытииМаркированныхТоваров",  Шапка.СведенияОВыбытииМаркированныхТоваров);
	КонецЕсли;
	
	// Таблица Сведения о товарах
	СведенияОТоварах = ЗаполнитьТаблицуТоваровУКД_2020(ДанныеДокумента, ДанныеЭлектронногоАктирования, ДанныеПриложенияЕИС);
	
	ТаблицаТоваров = СведенияОТоварах.ТаблицаТоваров;
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "СведенияОТоварах");
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", СведенияОТоварах.ТолькоУслуги);
	
	// ВсегоИзмененияСтоимости
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровБезНалогаУвеличение", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалогаУвеличение"));
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровСНалогомУвеличение", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогомУвеличение"));
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоИзмененияСтоимости.ВсегоСуммаНалогаУвеличение", ТаблицаТоваров.Итог("СуммаНалогаУвеличение"));
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровБезНалогаУменьшение", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалогаУменьшение"));
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровСНалогомУменьшение", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогомУменьшение"));
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоИзмененияСтоимости.ВсегоСуммаНалогаУменьшение", ТаблицаТоваров.Итог("СуммаНалогаУменьшение"));
	
КонецПроцедуры	

Процедура ЗаполнитьИсходныеДокументыУКД_2020(ДеревоДанных, ДанныеДокумента)
	
	ПутьЭлементаТаблицы = "ИсходныеДокументы";
	
	ТаблицаИсходныеДокументы = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, ПутьЭлементаТаблицы);
	
	Шапка			= ДанныеДокумента.Шапка[0];
	НомерДокумента	= ДанныеДокумента.НомерДокумента;
	
	НоваяСтрока = ТаблицаИсходныеДокументы.Добавить();
	НоваяСтрока.НомерИсходногоДокумента = НомерДокумента.Номер;
	НоваяСтрока.ДатаИсходногоДокумента = Шапка.ДатаСчетаФактуры;
	
	НомерИсправленияИсходногоДокумента = Шапка.НомерИсправления;
	ДатаИсправленияИсходногоДокумента = Шапка.ДатаИсправления;
	
	Если ЗначениеЗаполнено(НомерИсправленияИсходногоДокумента)
		Или ЗначениеЗаполнено(ДатаИсправленияИсходногоДокумента) Тогда
		
		ТаблицаИсправлений = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, "ИсходныеДокументы.НомерСтроки.ИсправленияИсходногоДокумента");
			
		НоваяСтрокаИсправления = ТаблицаИсправлений.Добавить();
		НоваяСтрокаИсправления.НомерИсправленияИсходногоДокумента = НомерИсправленияИсходногоДокумента;
		НоваяСтрокаИсправления.ДатаИсправленияИсходногоДокумента = ДатаИсправленияИсходногоДокумента;
		
		НоваяСтрока.ИсправленияИсходногоДокумента = ТаблицаИсправлений;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаИсходныеДокументы, ПутьЭлементаТаблицы);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОбУчастникеУКД_2020(ДеревоДанных, СтороныСделки, ИмяКонтейнера, СсылкаНаОбъект, СчетСсылка = Неопределено, ДанныеЭлектронногоАктирования = Неопределено);
	
	ЭтоЭлектронноеАктированиеЕИС = Ложь;
	Если ТипЗнч(ДанныеЭлектронногоАктирования) = Тип("Структура") Тогда
		ЭтоЭлектронноеАктированиеЕИС = Истина;
	КонецЕсли;	
	
	Если ИмяКонтейнера = "СведенияОПродавце" Тогда
		СторонаСделки = СтороныСделки.Продавец;
		
	ИначеЕсли ИмяКонтейнера = "СведенияОПокупателе" Тогда
		СторонаСделки = СтороныСделки.Покупатель;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ПолеДляСообщений = ?(ТипЗнч(СторонаСделки.Ссылка) = Тип("СправочникСсылка.Контрагенты"), "Объект.Контрагент", "Объект.Организация");
	
	//
	// ТипУчастника
	//
	
	ДанныеЮрФизЛица = Неопределено;
	ПолучитьДанныеЮрФизЛица(СторонаСделки.Ссылка, ДанныеЮрФизЛица);
	
	Если СторонаСделки.ЯвляетсяФизЛицом Тогда
		СвидетельствоОРегистрацииИП = Неопределено;
		ДанныеСвидетельстваОРегистрацииИП(СторонаСделки.Ссылка, СвидетельствоОРегистрацииИП);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".ТипУчастника.ИП.ИНН",
			СторонаСделки.ИНН,
			ПолеДляСообщений);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".ТипУчастника.ИП.СвидетельствоОГосРегистрации",
			СвидетельствоОРегистрацииИП,
			ПолеДляСообщений);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".ТипУчастника.ИП.Фамилия",
			ДанныеЮрФизЛица.Фамилия,
			ПолеДляСообщений);
			
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".ТипУчастника.ИП.Имя",
			ДанныеЮрФизЛица.Имя,
			ПолеДляСообщений);
			
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".ТипУчастника.ИП.Отчество",
			ДанныеЮрФизЛица.Отчество,
			ПолеДляСообщений);
		
		//ЗначенияПараметров.Вставить("ИныеСведения",					"");
	Иначе
		НаименованиеОрганизации = СторонаСделки.Наименование;
		Если ЭтоЭлектронноеАктированиеЕИС И ИмяКонтейнера = "СведенияОПродавце" Тогда
			ПолноеНаименованиеПоставщикаЕИС = ДанныеЭлектронногоАктирования.ДанныеГосконтракта[0].ПолноеНаименованиеПоставщика;
			Если ЗначениеЗаполнено(ПолноеНаименованиеПоставщикаЕИС) Тогда
				НаименованиеОрганизации = ПолноеНаименованиеПоставщикаЕИС;
			Иначе	
				НаименованиеОрганизации = ЭлектронноеАктированиеЕИС.НаименованиеОрганизацииДляЭД(СторонаСделки.Ссылка);
			КонецЕсли;
		ИначеЕсли ЭтоЭлектронноеАктированиеЕИС И ИмяКонтейнера = "СведенияОПокупателе" Тогда
			ПолноеНаименованиеЗаказчикаЕИС = ДанныеЭлектронногоАктирования.ДанныеГосконтракта[0].ПолноеНаименованиеЗаказчика;
			Если ЗначениеЗаполнено(ПолноеНаименованиеЗаказчикаЕИС) Тогда
				НаименованиеОрганизации = ПолноеНаименованиеЗаказчикаЕИС;
			Иначе	
				НаименованиеОрганизации = СторонаСделки.Наименование;
			КонецЕсли;
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".ТипУчастника.ЮЛ.НаименованиеОрганизации",
			НаименованиеОрганизации,
			ПолеДляСообщений);

		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".ТипУчастника.ЮЛ.ИНН",
			СторонаСделки.ИНН,
			ПолеДляСообщений);
			
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".ТипУчастника.ЮЛ.КПП",
			СторонаСделки.КПП,
			ПолеДляСообщений);
	КонецЕсли;
	
	//
	// Адрес
	//
	
	СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СторонаСделки.Адрес.JsonИлиXML);
	
	КодСтраныРоссия = "643";
	
	Если НЕ ЗначениеЗаполнено(СведенияОбАдресе.КодСтраны) Тогда
		СведенияОбАдресе.КодСтраны = КодСтраныРоссия;
	КонецЕсли;
	
	Если УправлениеКонтактнойИнформациейКлиентСервер.ЭтоАдресВСвободнойФорме(СведенияОбАдресе.ТипАдреса)
		ИЛИ СведенияОбАдресе.КодСтраны <> КодСтраныРоссия Тогда
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".Адрес.АдресИнформация.КодСтраны",
			СведенияОбАдресе.КодСтраны,
			ПолеДляСообщений);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".Адрес.АдресИнформация.АдресТекст",
			СторонаСделки.Адрес.Представление, // СведенияОбАдресе.Представление
			ПолеДляСообщений);
			
	Иначе
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".Адрес.АдресРФ.Индекс",
			СведенияОбАдресе.Индекс,
			ПолеДляСообщений);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".Адрес.АдресРФ.КодРегиона",
			СведенияОбАдресе.КодРегиона,
			ПолеДляСообщений);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".Адрес.АдресРФ.Район",
			СведенияОбАдресе.Район,
			ПолеДляСообщений);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".Адрес.АдресРФ.Город",
			СведенияОбАдресе.Город,
			ПолеДляСообщений);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".Адрес.АдресРФ.НаселенныйПункт",
			СведенияОбАдресе.НаселенныйПункт,
			ПолеДляСообщений);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".Адрес.АдресРФ.Улица",
			СведенияОбАдресе.Улица,
			ПолеДляСообщений);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".Адрес.АдресРФ.Дом",
			СведенияОбАдресе.Здание.Номер,
			ПолеДляСообщений);
			
		Если СведенияОбАдресе.Корпуса.Количество() > 0 Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ИмяКонтейнера + ".Адрес.АдресРФ.Корпус",
				СведенияОбАдресе.Корпуса[0].Номер,
				ПолеДляСообщений);
		КонецЕсли;
		
		Если СведенияОбАдресе.Помещения.Количество() > 0 Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных,
				ИмяКонтейнера + ".Адрес.АдресРФ.Квартира",
				СведенияОбАдресе.Помещения[0].Номер,
				ПолеДляСообщений);
		КонецЕсли;
	КонецЕсли;	
	
	// КодГАР
	
	//
	// КонтактныеСведения
	//
	Телефон = "";
	Если ДанныеЮрФизЛица.Свойство("Телефоны", Телефон) И ЗначениеЗаполнено(Телефон) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".КонтактныеСведения.Телефон",
			Телефон,
			ПолеДляСообщений);
	КонецЕсли;
	
	ЭлектроннаяПочта = "";
	Если ДанныеЮрФизЛица.Свойство("ЭлектроннаяПочта", ЭлектроннаяПочта) И ЗначениеЗаполнено(ЭлектроннаяПочта) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".КонтактныеСведения.ЭлектроннаяПочта",
			ЭлектроннаяПочта,
			ПолеДляСообщений);
	КонецЕсли;
	
	//
	// БанковскиеРеквизиты
	//
	
	Если ЗначениеЗаполнено(СчетСсылка) Тогда
		
		Если ТипЗнч(СчетСсылка) = Тип("СправочникСсылка.РеквизитыЛицевыхСчетов") Тогда
			// Переданы банковские реквизиты учреждения
			
			ЛицевойСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетСсылка, "Владелец");
			
			РасчетныеРеквизиты = Новый Структура();
			РасчетныеРеквизиты.Вставить("НомерСчетаПолучателя",			"СчетНомер");
			РасчетныеРеквизиты.Вставить("НаименованиеБанкаПолучателя",	"Банк");
			РасчетныеРеквизиты.Вставить("БикБанкаПолучателя",			"БИК");
			РасчетныеРеквизиты.Вставить("СчетБанкаПолучателя",			"КоррСчет");
			
		    ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, СчетСсылка, РасчетныеРеквизиты);
			
			НомерСчета					= РасчетныеРеквизиты.НомерСчетаПолучателя;
			НаименованиеБанка			= РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
			БИКБанка					= РасчетныеРеквизиты.БикБанкаПолучателя;
			КорреспондентскийСчетБанка	= РасчетныеРеквизиты.СчетБанкаПолучателя;

		Иначе
			// Переданы банковские реквизиты контрагента
			// ТипЗнч(СчетСсылка) = Тип("СправочникСсылка.БанковскиеИКазначейскиеСчета")
			
			Если ТипЗнч(СчетСсылка.КассовыйОрган) = Тип("СправочникСсылка.Банки") Тогда
				НомерСчета = СокрЛП(СчетСсылка.Код);
				
				НаименованиеБанка = СчетСсылка.КассовыйОрган.Наименование;
				
				БИКБанка = СокрЛП(СчетСсылка.КассовыйОрган.Код);
				
			ИначеЕсли ТипЗнч(СчетСсылка.КассовыйОрган) = Тип("СправочникСсылка.Казначейства") Тогда	
				НомерСчета = СокрЛП(СчетСсылка.СчетКазначейства.Код);
				
				НаименованиеБанка = СчетСсылка.СчетКазначейства.КассовыйОрган.Наименование
					+ " " + СчетСсылка.СчетКазначейства.КассовыйОрган.Город
					+ ", Казначейство: "
					+ СчетСсылка.КассовыйОрган.Наименование
					+ " (" + СчетСсылка.Владелец.НаименованиеСокращенное
					+ ", л/с " + СокрЛП(СчетСсылка.Код) + ")";
										
				БИКБанка = СчетСсылка.СчетКазначейства.КассовыйОрган.Код;
			КонецЕсли;
			
			КорреспондентскийСчетБанка = "";
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".БанковскиеРеквизиты.НомерСчета",
			НомерСчета,
			ПолеДляСообщений);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".БанковскиеРеквизиты.НаименованиеБанка",
			НаименованиеБанка,
			ПолеДляСообщений);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".БанковскиеРеквизиты.БИКБанка",
			БИКБанка,
			ПолеДляСообщений);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".БанковскиеРеквизиты.КорреспондентскийСчетБанка",
			КорреспондентскийСчетБанка,
			ПолеДляСообщений);
	КонецЕсли;
	
	КодПоОКПО = "";
	Если ДанныеЮрФизЛица.Свойство("КодПоОКПО", КодПоОКПО) И ЗначениеЗаполнено(КодПоОКПО) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных,
			ИмяКонтейнера + ".КодОКПО",
			КодПоОКПО,
			ПолеДляСообщений);
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьТаблицуТоваровУКД_2020(ДанныеДокумента, ДанныеЭлектронногоАктирования = Неопределено, ДанныеПриложенияЕИС = Неопределено)
	
	Шапка					= ДанныеДокумента["Шапка"][0];
	ТаблицаНФА				= ДанныеДокумента["ТабЧастьНФА"];
	ТаблицаКодовМаркировки	= ДанныеДокумента["ТабЧастьМаркировкаТоваров"];
	
	ЭтоЭлектронноеАктированиеЕИС = Ложь;
	Если ТипЗнч(ДанныеЭлектронногоАктирования) = Тип("Структура") Тогда
		ЭтоЭлектронноеАктированиеЕИС = Истина;
	КонецЕсли;	
	
	СчетФактураШкурыЛом = УчетНДСПовтИсп.ШкурыЛом(Шапка.ПричинаНалогообложения);
	
	СтавкаНДСИсчисляетсяНалоговымАгентом = УчетНДСКлиентСервер.ТекстСтавкиНДСИсчисляетсяНалоговымАгентом();
	
	ТаблицаТоваров = СоздатьТаблицуТоваровУКД_2020();
	
	ТолькоУслуги = Истина;
			
	НомерСтроки = 0;
	
	Для Каждого ТекСтрока Из ТаблицаНФА Цикл
		НомерСтроки = НомерСтроки + 1;
		
		НалоговаяСтавкаДоИзменения = ?(СчетФактураШкурыЛом, СтавкаНДСИсчисляетсяНалоговымАгентом, ТекСтрока.СтавкаНДСДоИзменения);
		НалоговаяСтавка = ?(СчетФактураШкурыЛом, СтавкаНДСИсчисляетсяНалоговымАгентом, ТекСтрока.СтавкаНДС);
		ЕдиницаИзмеренияКод = СокрЛП(ТекСтрока.ЕдиницаИзмеренияКод);
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.НомерСтроки	= НомерСтроки;
		
		Признак = "1";
		
		Если ТипЗнч(ТекСтрока.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
			ТоварНаименование = ТекСтрока.НФА.НаименованиеПолное;
			
			Признак = ПризнакТовараЕдиногоДокумента(ТекСтрока.НФА);
			
		ИначеЕсли ТипЗнч(ТекСтрока.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ТоварНаименование = ТекСтрока.НФА.НаименованиеПолное;
			
		Иначе
			ТоварНаименование = ТекСтрока.НФА;
		КонецЕсли;
		
		НоваяСтрока.ТоварНаименование							= ТоварНаименование;
		
		НоваяСтрока.ЕдиницаИзмеренияКодДоКорректировки			= ЕдиницаИзмеренияКод;
		НоваяСтрока.ЕдиницаИзмеренияКод							= ЕдиницаИзмеренияКод;
		
		НоваяСтрока.КоличествоДоКорректировки					= ТекСтрока.КоличествоДоИзменения;
		НоваяСтрока.Количество									= ТекСтрока.Количество;
		
		НоваяСтрока.ЦенаЗаЕдиницуИзмеренияДоКорректировки		= ТекСтрока.ЦенаДоИзменения;
		НоваяСтрока.ЦенаЗаЕдиницуИзмерения						= ТекСтрока.Цена;
		
		НоваяСтрока.СтоимостьТоваровБезНалогаДоКорректировки	= ТекСтрока.СуммаДоИзменения;
		НоваяСтрока.СтоимостьТоваровБезНалога					= ТекСтрока.Сумма;
		
		НоваяСтрока.СтоимостьТоваровБезНалогаУвеличение			= ТекСтрока.СуммаУвеличение;
		НоваяСтрока.СтоимостьТоваровБезНалогаУменьшение			= ТекСтрока.СуммаУменьшение;
		
		НоваяСтрока.НалоговаяСтавкаДоКорректировки				= НалоговаяСтавкаДоИзменения;
		НоваяСтрока.НалоговаяСтавка								= НалоговаяСтавка;
		
		НоваяСтрока.СуммаНалогаДоКорректировки					= ТекСтрока.СуммаНДСДоИзменения;
		НоваяСтрока.СуммаНалога									= ТекСтрока.СуммаНДС;
		
		НоваяСтрока.СуммаНалогаУвеличение						= ТекСтрока.СуммаНДСУвеличение;
		НоваяСтрока.СуммаНалогаУменьшение						= ТекСтрока.СуммаНДСУменьшение;
		
		НоваяСтрока.СтоимостьТоваровСНалогомДоКорректировки		= ТекСтрока.ВсегоДоИзменения;
		НоваяСтрока.СтоимостьТоваровСНалогом					= ТекСтрока.Всего;
		
		НоваяСтрока.СтоимостьТоваровСНалогомУвеличение			= ТекСтрока.ВсегоУвеличение;
		НоваяСтрока.СтоимостьТоваровСНалогомУменьшение			= ТекСтрока.ВсегоУменьшение;
		
		НоваяСтрока.СуммаАкцизаДоКорректировки					= ТекСтрока.СуммаАкцизаДоИзменения;
		НоваяСтрока.СуммаАкциза									= ТекСтрока.СуммаАкциза;
		НоваяСтрока.СуммаАкцизаУвеличение						= ТекСтрока.СуммаАкцизаУвеличение;
		НоваяСтрока.СуммаАкцизаУменьшение						= ТекСтрока.СуммаАкцизаУменьшение;
		
		Если ТолькоУслуги И (НЕ ПризнакУслуги(Признак)) Тогда
			ТолькоУслуги = Ложь;
		КонецЕсли;
		
		// Дополнительные сведения
		Если ЗначениеЗаполнено(ЕдиницаИзмеренияКод) Тогда
			НоваяСтрока.НаименованиеЕдиницыИзмеренияДоКорректировки		= ТекСтрока.ЕдиницаИзмеренияНаименование;
			НоваяСтрока.НаименованиеЕдиницыИзмеренияПослеКорректировки	= ТекСтрока.ЕдиницаИзмеренияНаименование;
		КонецЕсли;
		
		НоваяСтрока.КодВидаТовара = "-";
		
		Если СчетФактураШкурыЛом Тогда
			ОчищающаяСтруктура = Новый Структура("
				|СуммаНалогаДоКорректировки,
				|СуммаНалога,
				|СтоимостьТоваровСНалогомДоКорректировки,
				|СтоимостьТоваровСНалогом,
				|СуммаНалогаУвеличение,
				|СуммаНалогаУменьшение,
				|СтоимостьТоваровСНалогомУвеличение,
				|СтоимостьТоваровСНалогомУменьшение");
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчищающаяСтруктура);
		КонецЕсли;
		
		Сопоставление = Новый Структура();
		
		Сопоставление.Вставить("Наименование",			НоваяСтрока.ТоварНаименование);
		Сопоставление.Вставить("ЕдиницаИзмерения",		ТекСтрока.ЕдиницаИзмеренияНаименование);
		Сопоставление.Вставить("ЕдиницаИзмеренияКод",	ТекСтрока.ЕдиницаИзмеренияКод);
		Сопоставление.Вставить("НоменклатураИБ",		ТекСтрока.НФА);
		
		НоваяСтрока.Сопоставление = Сопоставление;
		
		//заполнение данных объемно-сортового учета маркированных товаров
		НоваяСтрока.СведенияОбъемноСортовогоУчетаДоИзменения		= ТекСтрока.СведенияОбъемноСортовогоУчетаДоИзменения;
		НоваяСтрока.СведенияОбъемноСортовогоУчетаМаркированныхТоваров	= ТекСтрока.СведенияОбъемноСортовогоУчетаМаркированныхТоваров;
		
		ЗаполнитьМаркировкуУпаковокУКД_2020(НоваяСтрока,
			ДанныеДокумента,
			ТекСтрока,
			Шапка.Ссылка,
			"СоставНФА");
			
		// Прослеживаемость
		Если ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
			НоваяСтрока.СведенияОПрослеживаемости = ТекСтрока.СведенияОПрослеживаемости;
		КонецЕсли;
		// Прослеживаемость
		
		// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			НоваяСтрока.ИдентификаторСтроки = ТекСтрока.ИдентификаторСтроки;
			ЭлектронноеАктированиеБГУ.
				ЗаполнитьДанныеПоСтрокеТоваровУКД(
					НоваяСтрока, ТекСтрока, ДанныеЭлектронногоАктирования, ДанныеПриложенияЕИС);
		КонецЕсли;
		// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	КонецЦикла;
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"Количество", , ,
		НСтр("ru = 'Не указано количество в табличной части.'"));
		
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"ЕдиницаИзмеренияКодДоКорректировки", , ,
		НСтр("ru = 'Не указан код единицы измерения до корректировки в табличной части.'"));
		
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"ЕдиницаИзмеренияКод", , ,
		НСтр("ru = 'Не указан код единицы измерения в табличной части.'"));
		
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаТоваров", ТаблицаТоваров);
	Результат.Вставить("ТолькоУслуги", ТолькоУслуги);
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьТаблицуТоваровУКД_2020()
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("НомерСтроки");
	ТаблицаТоваров.Колонки.Добавить("ТоварНаименование");
	ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмеренияКодДоКорректировки");
	ТаблицаТоваров.Колонки.Добавить("ЕдиницаИзмеренияКод");
	ТаблицаТоваров.Колонки.Добавить("КоличествоДоКорректировки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(26,11)));
	ТаблицаТоваров.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(26,11)));
	ТаблицаТоваров.Колонки.Добавить("ЦенаЗаЕдиницуИзмеренияДоКорректировки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(26,11)));
	ТаблицаТоваров.Колонки.Добавить("ЦенаЗаЕдиницуИзмерения", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(26,11)));
	ТаблицаТоваров.Колонки.Добавить("СтоимостьТоваровБезНалогаДоКорректировки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СтоимостьТоваровБезНалога", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СтоимостьТоваровБезНалогаУвеличение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СтоимостьТоваровБезНалогаУменьшение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("НалоговаяСтавкаДоКорректировки");
	ТаблицаТоваров.Колонки.Добавить("НалоговаяСтавка");
	ТаблицаТоваров.Колонки.Добавить("СуммаНалогаДоКорректировки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СуммаНалога", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СуммаНалогаУвеличение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СуммаНалогаУменьшение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СуммаАкцизаДоКорректировки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СуммаАкциза", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СуммаАкцизаУвеличение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СуммаАкцизаУменьшение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СтоимостьТоваровСНалогомДоКорректировки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СтоимостьТоваровСНалогом", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СтоимостьТоваровСНалогомУвеличение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	ТаблицаТоваров.Колонки.Добавить("СтоимостьТоваровСНалогомУменьшение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	
	ТаблицаТоваров.Колонки.Добавить("ДокументОснование");
	
	ТаблицаТоваров.Колонки.Добавить("ХарактеристикаОписаниеТовара", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(1000)));
	ТаблицаТоваров.Колонки.Добавить("СортТовара", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(10)));
	ТаблицаТоваров.Колонки.Добавить("АртикулТовара", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	ТаблицаТоваров.Колонки.Добавить("КодТовара", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	ТаблицаТоваров.Колонки.Добавить("НаименованиеЕдиницыИзмеренияДоКорректировки", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(255)));
	ТаблицаТоваров.Колонки.Добавить("НаименованиеЕдиницыИзмеренияПослеКорректировки", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(255)));
	ТаблицаТоваров.Колонки.Добавить("КодВидаТовара", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(10,ДопустимаяДлина.Фиксированная)));
	
	//СведенияОПрослеживаемости
	
	ТаблицаТоваров.Колонки.Добавить("СведенияОМаркировкеДо");
	ТаблицаТоваров.Колонки.Добавить("СведенияОМаркировкеПосле");
	ТаблицаТоваров.Колонки.Добавить("ДопДанныеПодписанные", Новый ОписаниеТипов("Соответствие"));
	ТаблицаТоваров.Колонки.Добавить("Сопоставление", Новый ОписаниеТипов("Структура"));
	
	ТаблицаТоваров.Колонки.Добавить("СведенияОПрослеживаемости", Новый ОписаниеТипов("ТаблицаЗначений"));
	ТаблицаТоваров.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));

	ТаблицаТоваров.Колонки.Добавить("СведенияОбъемноСортовогоУчетаМаркированныхТоваров", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	ТаблицаТоваров.Колонки.Добавить("СведенияОбъемноСортовогоУчетаДоИзменения", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	
	ТаблицаТоваров.Колонки.Добавить("ИдентификаторСтрокиГосконтрактаЕИС");
	ТаблицаТоваров.Колонки.Добавить("ИдентификаторМестаПоставкиЕИС");
	
	Возврат ТаблицаТоваров;
	
КонецФункции	

Процедура ЗаполнитьМаркировкуУпаковокУКД_2020(СтрокаТовара, ДанныеДокумента, ТекСтрокаНФА, Документ, НаименованиеТЧ)
	
	ПутьКДаннымДляОшибки = СтрШаблон("Объект.%1[%2].МаркируемыеУпаковки",
		НаименованиеТЧ,
		СтрокаТовара.НомерСтроки - 1);
		
	Если ЗначениеЗаполнено(СтрокаТовара.СведенияОбъемноСортовогоУчетаМаркированныхТоваров) Тогда
		ИндивидуальныеУпаковкиДо = Новый ТаблицаЗначений;
		ИндивидуальныеУпаковкиДо.Колонки.Добавить("Код");
		
		ИндивидуальныеУпаковкиПосле = Новый ТаблицаЗначений;
		ИндивидуальныеУпаковкиПосле.Колонки.Добавить("Код");

		ТаблицаКодов = Новый ТаблицаЗначений;
		ТаблицаКодов.Колонки.Добавить("Код");

		КодОСУДо = СтрЗаменить(СтрокаТовара.СведенияОбъемноСортовогоУчетаДоИзменения, "(", "");
		КодОСУДо = СтрЗаменить(КодОСУДо, ")", "");

		КодОСУПосле = СтрЗаменить(СтрокаТовара.СведенияОбъемноСортовогоУчетаМаркированныхТоваров, "(", "");
		КодОСУПосле = СтрЗаменить(КодОСУПосле, ")", "");
		
		НоваяСтрока = ТаблицаКодов.Добавить();
		НоваяСтрока.Код = СокрЛП(КодОСУДо);
		
		НоваяСтрока = ИндивидуальныеУпаковкиДо.Добавить();
		НоваяСтрока.Код = СокрЛП(КодОСУДо);

		НоваяСтрока = ТаблицаКодов.Добавить();
		НоваяСтрока.Код = СокрЛП(КодОСУПосле);
		
		НоваяСтрока = ИндивидуальныеУпаковкиПосле.Добавить();
		НоваяСтрока.Код = СокрЛП(КодОСУПосле);
		
		ТранспортныеУпаковкиДо = Новый ТаблицаЗначений;
		ТранспортныеУпаковкиДо.Колонки.Добавить("Код");
		
		ТранспортныеУпаковкиПосле = Новый ТаблицаЗначений;
		ТранспортныеУпаковкиПосле.Колонки.Добавить("Код");

		СведенияОМаркировкеДо = Новый Структура;
		СведенияОМаркировкеДо.Вставить("ИндивидуальныеУпаковки", ИндивидуальныеУпаковкиДо);
		СведенияОМаркировкеДо.Вставить("ТранспортныеУпаковки", ТранспортныеУпаковкиДо);
		
		СведенияОМаркировкеПосле = Новый Структура;
		СведенияОМаркировкеПосле.Вставить("ИндивидуальныеУпаковки", ИндивидуальныеУпаковкиПосле);
		СведенияОМаркировкеПосле.Вставить("ТранспортныеУпаковки", ТранспортныеУпаковкиПосле);
		
		СтрокаТовара.СведенияОМаркировкеДо = СведенияОМаркировкеДо;
		
		СтрокаТовара.СведенияОМаркировкеПосле = СведенияОМаркировкеПосле;
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаКодов,
			"Код", Документ, ПутьКДаннымДляОшибки);
		
	Иначе		
		КодыУпаковокКСФ = ДанныеДокумента["ТабЧастьМаркировкаТоваров"];
		
		КодыУпаковокСФ = ДанныеДокумента["КодыУпаковокИзСФ"];
		
		ТаблицаКодов = Новый ТаблицаЗначений;
		ТаблицаКодов.Колонки.Добавить("Код");
		
		ИндивидуальныеУпаковкиДо = Новый ТаблицаЗначений;
		ИндивидуальныеУпаковкиДо.Колонки.Добавить("Код");
		
		ИндивидуальныеУпаковкиПосле = Новый ТаблицаЗначений;
		ИндивидуальныеУпаковкиПосле.Колонки.Добавить("Код");
		
		ТранспортныеУпаковкиДо = Новый ТаблицаЗначений;
		ТранспортныеУпаковкиДо.Колонки.Добавить("Код");
		
		ТранспортныеУпаковкиПосле = Новый ТаблицаЗначений;
		ТранспортныеУпаковкиПосле.Колонки.Добавить("Код");
		
		ПараметрыПоиска = Новый Структура("ИдентификаторСтроки", ТекСтрокаНФА.ИдентификаторСтроки);
		
		МассивСтрок = КодыУпаковокКСФ.НайтиСтроки(ПараметрыПоиска);
		
		// "До"
		Поиск = Новый Структура("НомерСтроки", ТекСтрокаНФА.НомерСтроки);
		МассивСтрокДо = КодыУпаковокСФ.НайтиСтроки(Поиск);
		
		Если МассивСтрокДо.Количество() > 0 Тогда
			ТаблицаМаркировкиИзСФ = МассивСтрокДо[0]["ТаблицаМаркировкиИзСФ"];
			
			Для Каждого СтрокаТаблицыДо Из ТаблицаМаркировкиИзСФ Цикл
				НоваяСтрока = ТаблицаКодов.Добавить();
				НоваяСтрока.Код = СокрЛП(СтрокаТаблицыДо.НомерУпаковки);
				
				Если СтрокаТаблицыДо.ТипУпаковки = НСтр("ru = 'Транспортная упаковка'") Тогда
					НоваяСтрока = ТранспортныеУпаковкиДо.Добавить();
				Иначе
					НоваяСтрока = ИндивидуальныеУпаковкиДо.Добавить();
				КонецЕсли;
				
				НоваяСтрока.Код = СокрЛП(СтрокаТаблицыДо.НомерУпаковки);
			КонецЦикла;
		КонецЕсли;
		
		// "После"
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			НоваяСтрока = ТаблицаКодов.Добавить();
			НоваяСтрока.Код = СокрЛП(СтрокаТаблицы.НомерУпаковки);
			
			Если СтрокаТаблицы.ТипУпаковки = НСтр("ru = 'Транспортная упаковка'") Тогда
				НоваяСтрока = ТранспортныеУпаковкиПосле.Добавить();
			Иначе
				НоваяСтрока = ИндивидуальныеУпаковкиПосле.Добавить();
			КонецЕсли;
			
			НоваяСтрока.Код = СокрЛП(СтрокаТаблицы.НомерУпаковки);
		КонецЦикла;
		
		Если МассивСтрок.Количество() > 0 Тогда
			СведенияОМаркировкеДо = Новый Структура;
			СведенияОМаркировкеДо.Вставить("ИндивидуальныеУпаковки", ИндивидуальныеУпаковкиДо);
			СведенияОМаркировкеДо.Вставить("ТранспортныеУпаковки", ТранспортныеУпаковкиДо);
			
			СведенияОМаркировкеПосле = Новый Структура;
			СведенияОМаркировкеПосле.Вставить("ИндивидуальныеУпаковки", ИндивидуальныеУпаковкиПосле);
			СведенияОМаркировкеПосле.Вставить("ТранспортныеУпаковки", ТранспортныеУпаковкиПосле);
			
			СтрокаТовара.СведенияОМаркировкеДо = СведенияОМаркировкеДо;
			
			СтрокаТовара.СведенияОМаркировкеПосле = СведенияОМаркировкеПосле;
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаКодов,
				"Код", Документ, ПутьКДаннымДляОшибки);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура НайтиСоздатьУКД_2020(ДеревоДанных, СсылкиНаВладельцев = Неопределено, СпособОбработки = Неопределено, ОписаниеОшибки = "") Экспорт
	
	Записывать = Истина;
	СсылкаНаВладельца = Неопределено;
	
	Если ТипЗнч(СсылкиНаВладельцев) = Тип("Массив") И СсылкиНаВладельцев.Количество() > 0 Тогда
		СсылкаНаВладельца = СсылкиНаВладельцев[0];
	КонецЕсли;
	
	ДанныеЗаполненияШапки = Новый Структура;
	
	ДокументыОснованияСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	НомерДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДатаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента");
	НомерИсходногоДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсходногоДокумента");
	ДатаИсходногоДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсходногоДокумента");
	
	ДанныеЗаполненияШапки.Вставить("ДатаПолучения", ТекущаяДатаСеанса());
	
	ДанныеЗаполненияШапки.Вставить("НомерИсправления", ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления"));
	ДанныеЗаполненияШапки.Вставить("ДатаИсправления", ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления"));
	Если ЗначениеЗаполнено(ДанныеЗаполненияШапки.НомерИсправления)
		И ЗначениеЗаполнено(ДанныеЗаполненияШапки.ДатаИсправления) Тогда
		
		ДанныеЗаполненияШапки.Вставить("Исправление", Истина);
	КонецЕсли;
	
	НомерИсходногоДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсходногоДокумента");
	ДанныеЗаполненияШапки.Вставить("НомерИсходногоДокумента", НомерИсходногоДокумента);
	ДатаИсходногоДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсходногоДокумента");	
	ДанныеЗаполненияШапки.Вставить("ДатаИсходногоДокумента", ДатаИсходногоДокумента);
	
	Если ЗначениеЗаполнено(ДанныеЗаполненияШапки.НомерИсходногоДокумента)
		И ЗначениеЗаполнено(ДанныеЗаполненияШапки.ДатаИсходногоДокумента) Тогда
		
		ДанныеЗаполненияШапки.Вставить("Корректировочный", Истина);
		ДанныеЗаполненияШапки.Вставить("НомерИсправленияИсходногоДокумента",
			ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправленияИсходногоДокумента"));
		ДанныеЗаполненияШапки.Вставить("ДатаИсправленияИсходногоДокумента",
			ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправленияИсходногоДокумента"));
	КонецЕсли;
		
	ВалКод = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод");
	Если НЕ ВалКод = "643" Тогда
		ДанныеЗаполненияШапки.Вставить("ВИностраннойВалюте", Истина);
	КонецЕсли;
	Валюта = Справочники.Валюты.ПустаяСсылка();
	НайтиСсылкуНаОбъект("Валюты", Валюта, ВалКод);
	ДанныеЗаполненияШапки.Вставить("ВалютаДокумента", Валюта);
	
	// Сведения о поставщике.
	ИННПоставщика = ""; КПППоставщика = "";
	ВидУчастника = "СведенияОПродавце";
	
	Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
		
		ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
		КПППоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
		ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
		
	ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
		
		ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
		Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
		Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
		Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
		
		ПредставлениеПоставщика = Фамилия + " " + Имя + " " + Отчество; 
	ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
		
		ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
		
	ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
		
		ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
	КонецЕсли;
	
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	СсылкаНаОбъектПоИННКПП("Контрагенты", ИННПоставщика, КПППоставщика, Контрагент);
	ДанныеЗаполненияШапки.Вставить("Контрагент", Контрагент);
	
	// Сведения о покупателе.
	ИННПокупателя = ""; КПППокупателя = "";
	ВидУчастника = "СведенияОПокупателе";
	Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
		
		ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
		КПППокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
		ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
		
	ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
		
		ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
		Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
		Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
		Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
		
		ПредставлениеПокупателя = Фамилия + " " + Имя + " " + Отчество; 
	ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
		
		ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
		
	ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
		
		ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
	КонецЕсли;
	Организация = Справочники.Организации.ПустаяСсылка();
	СсылкаНаОбъектПоИННКПП("Организации", ИННПокупателя, КПППокупателя, Организация);
	ДанныеЗаполненияШапки.Вставить("Организация", Организация);
	
	// Поиск и заполнения договора контрагента.
	Договор = Справочники.Договоры.ПустаяСсылка();
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеКорректировки", "ПолныйПуть");
	Если Не ОснованияОтгрузки = Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеКорректировки.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ДатаИзСтроки(ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, 
					"ОснованиеКорректировки.НомерСтроки.ДокументДата"));
				
				СвойстваДоговора = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация", ДоговорНомер, ДоговорДата, Контрагент, Организация);
				
				Договор = Справочники.Договоры.ПустаяСсылка();
				НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , СвойстваДоговора);
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Договор = ДоговорПоНастройкеЭДО(Контрагент, Организация);
	КонецЕсли;	
		
	ДанныеЗаполненияШапки.Вставить("Договор", Договор);
	
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть").Строки;
	Если ЗначениеЗаполнено(СведенияОТоварах) Тогда
		ТаблицаТоваров = Документы.КорректировочныйСчетФактураПолученный.ПустаяСсылка().СоставНФА.ВыгрузитьКолонки();
		Для Каждого ТекТовар Из СведенияОТоварах Цикл
			СтрокаТаблицы = ТаблицаТоваров.Добавить();
			
			Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
			Если ЗначениеЗаполнено(Номенклатура) Тогда
				НФА = Номенклатура;
			Иначе
				НФА = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.ТоварНаименование");
			КонецЕсли;
			СтрокаТаблицы.НФА = НФА;
			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", ЕдиницаИзмерения,
				ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод"));
			СтрокаТаблицы.ЕдиницаИзмерения = ЕдиницаИзмерения;
			
			КоличествоДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.КоличествоДоКорректировки");
			СтрокаТаблицы.КоличествоДоИзменения = КоличествоДоИзменения;
			
			СтрокаТаблицы.Количество = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.Количество");
			
			ЦенаДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмеренияДоКорректировки");
			
			Цена = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
			СтрокаТаблицы.СуммаДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалогаДоКорректировки");
			СтрокаТаблицы.Сумма = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
			СтавкаНДСДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавкаДоКорректировки");
			
			СтавкаНДС = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
			
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
			КонецЕсли;	
			
			СтрокаТаблицы.СтавкаНДСДоИзменения = СтавкаНДСДоИзменения;
			СтрокаТаблицы.СтавкаНДС = СтавкаНДС;
			СтрокаТаблицы.СуммаНДСДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаНалогаДоКорректировки");
			СтрокаТаблицы.СуммаНДС = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаНалога");
			СтрокаТаблицы.ВсегоДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогомДоКорректировки");
			СтрокаТаблицы.Всего = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
			
			РазницаСуммы = СтрокаТаблицы.Сумма - СтрокаТаблицы.СуммаДоИзменения;
			Если РазницаСуммы > 0 Тогда
				СтрокаТаблицы.СуммаУвеличение = РазницаСуммы;
				СтрокаТаблицы.СуммаУменьшение = 0;
			Иначе
				СтрокаТаблицы.СуммаУменьшение = (-1)*РазницаСуммы;
				СтрокаТаблицы.СуммаУвеличение = 0;
			КонецЕсли;
			
			РазницаСуммыНДС = СтрокаТаблицы.СуммаНДС - СтрокаТаблицы.СуммаНДСДоИзменения;
			
			Если РазницаСуммыНДС > 0 Тогда
				СтрокаТаблицы.СуммаНДСУвеличение = РазницаСуммыНДС;
				СтрокаТаблицы.СуммаНДСУменьшение = 0;
				СтрокаТаблицы.НДСКВычету = Истина;
				СтрокаТаблицы.Счет30304 = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04");
			Иначе
				СтрокаТаблицы.СуммаНДСУменьшение = (-1)*РазницаСуммыНДС;
				СтрокаТаблицы.СуммаНДСУвеличение = 0;
			КонецЕсли;
			
			РазницаСуммыВсего = СтрокаТаблицы.Всего - СтрокаТаблицы.ВсегоДоИзменения;
			Если РазницаСуммыВсего > 0 Тогда
				СтрокаТаблицы.ВсегоУвеличение = РазницаСуммыВсего;
				СтрокаТаблицы.ВсегоУменьшение = 0;
			Иначе
				СтрокаТаблицы.ВсегоУменьшение = (-1)*РазницаСуммыВсего;
				СтрокаТаблицы.ВсегоУвеличение = 0;
			КонецЕсли;
			
			СтрокаТаблицы.СуммаАкцизаДоИзменения	= ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаАкцизаДоКорректировки");
			СтрокаТаблицы.СуммаАкциза				= ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаАкциза");
			СтрокаТаблицы.СуммаАкцизаУвеличение		= ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаАкцизаУвеличение");
			СтрокаТаблицы.СуммаАкцизаУменьшение		= ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаАкцизаУменьшение");
		КонецЦикла;
	КонецЕсли;
	ДанныеЗаполненияШапки.Вставить("СоставНФА", ТаблицаТоваров);
	
	//Заполнение прочих реквизитов по-умолчанию
	ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВКнигеПродажПокупок;
	ДанныеЗаполненияШапки.Вставить("ВариантРегистрации", ВариантРегистрации);
	
	КодСпособаВыставления = 2;
	ДанныеЗаполненияШапки.Вставить("КодСпособаВыставления", КодСпособаВыставления);
	
	КодВидаОперации = "01";
	ДанныеЗаполненияШапки.Вставить("КодВидаОперации", КодВидаОперации);
	
	НаименованиеПродавца = Контрагент.НаименованиеСокращенное;
	ДанныеЗаполненияШапки.Вставить("НаименованиеПродавца", НаименованиеПродавца);
	ДанныеЗаполненияШапки.Вставить("ИННПродавца", ИННПоставщика);
	ДанныеЗаполненияШапки.Вставить("КПППродавца", КПППоставщика);
	
	ДанныеЗаполненияШапки.Вставить("НомерПервичногоДокумента", НомерДокумента);
	ДанныеЗаполненияШапки.Вставить("ДатаПервичногоДокумента", ДатаДокумента);
	
	ДанныеЗаполненияШапки.Вставить("НомерСчетаФактуры", НомерИсходногоДокумента);
	ДанныеЗаполненияШапки.Вставить("ДатаСчетаФактуры", ДатаИсходногоДокумента);
	
	//Запись
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда 
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.КорректировочныйСчетФактураПолученный.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеЗаполненияШапки);
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		
		СчетФактураПолученный = ОпределитьСчетФактуруПолученый(ДокументОбъект,
			ДанныеЗаполненияШапки.Организация, 
			ДанныеЗаполненияШапки.НомерИсходногоДокумента,
			ДанныеЗаполненияШапки.ДатаИсходногоДокумента,
			Ложь);
			
		Если ЗначениеЗаполнено(СчетФактураПолученный) Тогда
			ДокументОбъект.ДокументОснование = СчетФактураПолученный;	
			ДокументОбъект.ИсправляемыйДокумент = СчетФактураПолученный;
			Если ТипЗнч(СчетФактураПолученный) = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный") Тогда
				ДокументОбъект.ИсправляемыйДокумент = СчетФактураПолученный.ИсправляемыйДокумент;
				ДатаИсправляемогоСчетаФактуры = ДокументОбъект.ИсправляемыйДокумент.Дата;
			ИначеЕсли ТипЗнч(СчетФактураПолученный) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				ДатаИсправляемогоСчетаФактуры = СчетФактураПолученный.Дата;
			КонецЕсли;	
			ДокументОбъект.ПричинаНалогообложения = СчетФактураПолученный.ПричинаНалогообложения;
			Если ДанныеЗаполненияШапки.ДатаИсходногоДокумента = Дата(1,1,1) Тогда
				ДанныеЗаполненияШапки.ДатаИсходногоДокумента = СчетФактураПолученный.Дата;
				ДокументОбъект.ДатаСчетаФактуры = СчетФактураПолученный.Дата;
			КонецЕсли;	
		Иначе
			ДокументОбъект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Покупка;
		КонецЕсли;		
		ДокументОбъект.ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВКнигеПродажПокупок;
		
		ДокументОбъект.СоставНФА.Очистить();
		Если ДанныеЗаполненияШапки.Свойство("СоставНФА") И ЗначениеЗаполнено(ДанныеЗаполненияШапки.СоставНФА) Тогда
			ДокументОбъект.СоставНФА.Загрузить(ДанныеЗаполненияШапки.СоставНФА);
		КонецЕсли;
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
		
		Если ТипЗнч(СсылкиНаВладельцев) = Тип("Массив") Тогда
			Если СсылкиНаВладельцев.Найти(СсылкаНаВладельца) = Неопределено Тогда
				СсылкиНаВладельцев.Добавить(СсылкаНаВладельца);
			КонецЕсли;
		Иначе
			СсылкиНаВладельцев = Новый Массив();
			СсылкиНаВладельцев.Добавить(СсылкаНаВладельца);
		КонецЕсли;
	
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, , СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

// Заполняет вид организации или контрагента по признакам
//
// Параметры:
//  ПроверяемоеЛицо - ОпределяемыйТип.УчастникЭДО
//  Признаки - Структура:
//   * ЭтоЮрЛицо - Булево
//   * ЭтоИП - Булево
//   * ЭтоФизЛицо - Булево
//   * ЭтоИностранноеЛицо - Булево
//
Процедура ПриОпределенииТипаУчастникаЭДО(ПроверяемоеЛицо, Признаки) Экспорт

	КодТипаЮрФизЛица = 1;
	Если ТипЗнч(ПроверяемоеЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Контрагенты.Ссылка КАК Ссылка,
		               |	ВЫБОР
		               |		КОГДА ТИПЗНАЧЕНИЯ(Контрагенты.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ЮридическиеЛица)
		               |			ТОГДА 1
		               |		КОГДА ТИПЗНАЧЕНИЯ(Контрагенты.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ФизическиеЛица)
		               |				И ВЫРАЗИТЬ(Контрагенты.ЮридическоеФизическоеЛицо КАК Справочник.ФизическиеЛица).ОГРНИП = """"
		               |			ТОГДА 2
		               |		КОГДА ТИПЗНАЧЕНИЯ(Контрагенты.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ФизическиеЛица)
		               |				И НЕ ВЫРАЗИТЬ(Контрагенты.ЮридическоеФизическоеЛицо КАК Справочник.ФизическиеЛица).ОГРНИП = """"
		               |			ТОГДА 3
		               |	КОНЕЦ КАК КодТипаЮрФизЛица
		               |ИЗ
		               |	Справочник.Контрагенты КАК Контрагенты
		               |ГДЕ
		               |	Контрагенты.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ПроверяемоеЛицо);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			КодТипаЮрФизЛица = Выборка.КодТипаЮрФизЛица;
		КонецЕсли;	
	КонецЕсли;	
	Признаки.ЭтоЮрЛицо = ?(КодТипаЮрФизЛица = 1, Истина, Ложь);
	Признаки.ЭтоФизЛицо = ?(КодТипаЮрФизЛица = 2, Истина, Ложь);
	Признаки.ЭтоИП =?(КодТипаЮрФизЛица = 3, Истина, Ложь);
	Признаки.ЭтоИностранноеЛицо = Ложь;
	
КонецПроцедуры

// Создание контрагента в информационной базе по реквизитам.
//
// Параметры:
//   РеквизитыКонтрагента - Структура - реквизиты необходимые для создания контрагента.
//    * ИНН - Строка - ИНН контрагента.
//    * КПП - Строка - КПП контрагента.
//    * Наименование - Строка - наименование контрагента.
//   Контрагент - СправочникСсылка - ссылка на созданного контрагента.
//   Отказ - Булево - признак ошибки.
//
Процедура СоздатьКонтрагентаПоРеквизитам(Знач РеквизитыКонтрагента, Контрагент, Отказ = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Справочники.Контрагенты.ПустаяСсылка();

	//Проверка наличия контрагента
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("ИНН", "");
	ДанныеПроверки.Вставить("КПП", "");
	ЗаполнитьЗначенияСвойств(ДанныеПроверки, РеквизитыКонтрагента); 

	КонтрагентПроверки = Справочники.Контрагенты.ПустаяСсылка();
	
	СсылкаНаОбъектПоИННКПП("Контрагенты", ДанныеПроверки.ИНН, ДанныеПроверки.КПП, КонтрагентПроверки, ТекущаяДатаСеанса());
	Если ЗначениеЗаполнено(КонтрагентПроверки) Тогда
		Контрагент = КонтрагентПроверки;
		
		Возврат;
	КонецЕсли;
	
	РеквизитыКонтрагента.Вставить("ЭтоЭлектронныйДокумент", Истина);
	ИННОбъекта = РеквизитыКонтрагента.ИНН;
	КППОбъекта = РеквизитыКонтрагента.КПП;
	
	ЕстьДанныеФИО = Ложь;
	Фамилия = "";
	Если РеквизитыКонтрагента.Свойство("Фамилия") Тогда
		Фамилия = РеквизитыКонтрагента.Фамилия;
		ЕстьДанныеФИО = Истина;
	КонецЕсли;	
	Имя = "";
	Если РеквизитыКонтрагента.Свойство("Имя") Тогда
		Имя = РеквизитыКонтрагента.Имя;
		ЕстьДанныеФИО = Истина;
	КонецЕсли;	
	Отчество = "";
	Если РеквизитыКонтрагента.Свойство("Отчество") Тогда
		Отчество = РеквизитыКонтрагента.Отчество;
		ЕстьДанныеФИО = Истина;
	КонецЕсли;	
	
	НовоеЛицо = Ложь;
	Если СтрДлина(ИННОбъекта) > 10 ИЛИ НЕ ЗначениеЗаполнено(ИННОбъекта) Тогда   
		
		ЭтоЮрЛицо = Ложь;
		
		КонтрагентПроверки = Справочники.ФизическиеЛица.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("ФизическиеЛица", ДанныеПроверки.ИНН, ДанныеПроверки.КПП, КонтрагентПроверки, ТекущаяДатаСеанса());
		Если ЗначениеЗаполнено(КонтрагентПроверки) Тогда
			ТекЛицо = КонтрагентПроверки.ПолучитьОбъект();
        Иначе
			//Создаем физ. лицо
			ТекЛицо = Справочники.ФизическиеЛица.СоздатьЭлемент();
			ТекЛицо.СтранаРегистрации = Справочники.СтраныМира.Россия;
			НовоеЛицо = Истина;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТекЛицо,РеквизитыКонтрагента);
		ТекстСправочник = НСтр("ru = 'Физические лица'");
	Иначе
		ЭтоЮрЛицо = Истина;
		
		КонтрагентПроверки = Справочники.ЮридическиеЛица.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("ЮридическиеЛица", ДанныеПроверки.ИНН, ДанныеПроверки.КПП, КонтрагентПроверки, ТекущаяДатаСеанса());
		Если ЗначениеЗаполнено(КонтрагентПроверки) Тогда
			ТекЛицо = КонтрагентПроверки.ПолучитьОбъект();
        Иначе
			//Создаем юр. лицо
			ТекЛицо = Справочники.ЮридическиеЛица.СоздатьЭлемент();
			ТекЛицо.СтранаРегистрации = Справочники.СтраныМира.Россия;
		КонецЕсли;
	
		ЗаполнитьЗначенияСвойств(ТекЛицо,РеквизитыКонтрагента);
		Если НЕ ЗначениеЗаполнено(ТекЛицо.НаименованиеПолное) Тогда
			ТекЛицо.НаименованиеПолное = РеквизитыКонтрагента.Наименование;
		КонецЕсли;
		ТекстСправочник = НСтр("ru = 'Юридические лица'");
	КонецЕсли;
	
	ТекЛицоУспешноЗаписано = Ложь;
	Попытка
		ТекЛицо.Записать();
		ТекЛицоУспешноЗаписано = Истина;
	Исключение
		Отказ = Истина;
		ТекстДействия = НСтр("ru = 'Запись нового элемента справочника '")+ТекстСправочник;
		
		ЗаписьЖурналаРегистрации(
			ТекстДействия,
			УровеньЖурналаРегистрации.Ошибка,
			ТекЛицо.Метаданные(),
			ТекЛицо,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ТекстОшибки = НСтр("ru = 'Ошибка при записи нового элемента справочника '") + ТекстСправочник +
			НСтр("ru = '|Подробности см. в Журнале регистрации.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
	
	Если ТекЛицоУспешноЗаписано Тогда	
		//Создаем контрагента
		
		Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(Контрагент, РеквизитыКонтрагента);
		Если НЕ ЗначениеЗаполнено(Контрагент.ТипКонтрагента) Тогда
			Если ЭтоЮрЛицо Тогда
				Контрагент.ТипКонтрагента = Справочники.ТипыКонтрагентов.НайтиПоКоду("4"); 
			ИначеЕсли ЗначениеЗаполнено(ИННОбъекта) Тогда 
				Контрагент.ТипКонтрагента = Справочники.ТипыКонтрагентов.НайтиПоКоду("6");
			Иначе
				Контрагент.ТипКонтрагента = Справочники.ТипыКонтрагентов.НайтиПоКоду("7");
			КонецЕсли;
		КонецЕсли;
		Контрагент.НаименованиеСокращенное = РеквизитыКонтрагента.Наименование;
		Контрагент.ВидКонтрагента = ?(ЭтоЮрЛицо, Перечисления.ЮрФизЛицо.ЮрЛицо ,Перечисления.ЮрФизЛицо.ФизЛицо);
		Контрагент.ИНН = ИННОбъекта;
		Контрагент.КПП = КППОбъекта;
		
		Контрагент.ЮридическоеФизическоеЛицо = ТекЛицо.Ссылка;
	
		Если ЭтоЮрЛицо Тогда
			РеквизитыКонтрагентаПоЕГРН = РаботаСКонтрагентами.ИнформацияОСвязяхЮридическогоЛицаПоИНН(ИННОбъекта);
		Иначе
			РеквизитыКонтрагентаПоЕГРН = РаботаСКонтрагентами.ИнформацияОСвязяхПредпринимателяПоИНН(ИННОбъекта);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(РеквизитыКонтрагентаПоЕГРН.ОписаниеОшибки) Тогда // удалось получить данные контрагента из ЕГРН
			РеквизитыКонтрагента = РеквизитыКонтрагентаПоЕГРН;
		КонецЕсли;
		
		Если ЭтоЮрЛицо Тогда
			ТаблицаКИ = УправлениеКонтактнойИнформацией.НоваяКонтактнаяИнформация(Ложь);
			
			Если РеквизитыКонтрагента.Свойство("ЮридическийАдрес") Тогда
				Если РеквизитыКонтрагента.ЮридическийАдрес <> Неопределено Тогда
					СтрокаКИ = ТаблицаКИ.Добавить();
					СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
					СтрокаКИ.Значение = РеквизитыКонтрагента.ЮридическийАдрес.КонтактнаяИнформация;
					
					СтрокаКИ = ТаблицаКИ.Добавить();
					СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты;
					СтрокаКИ.Значение = РеквизитыКонтрагента.ЮридическийАдрес.КонтактнаяИнформация;
				КонецЕсли;
			КонецЕсли;
			
			Если РеквизитыКонтрагента.Свойство("Телефон") Тогда
				Если РеквизитыКонтрагента.Телефон <> Неопределено Тогда
					СтрокаКИ = ТаблицаКИ.Добавить();
					СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты;
					СтрокаКИ.Значение = РеквизитыКонтрагента.Телефон.КонтактнаяИнформация;
				КонецЕсли;
			КонецЕсли;
			
			Если ТаблицаКИ.Количество() > 0 Тогда
				КонтрагентОбъект = Контрагент.ЮридическоеФизическоеЛицо.ПолучитьОбъект();
				УправлениеКонтактнойИнформацией.УстановитьКонтактнуюИнформациюОбъекта(КонтрагентОбъект, ТаблицаКИ);
			КонецЕсли;
		Иначе
			
			Контрагент.КПП = "";
			Если РеквизитыКонтрагента.Свойство("Пол") Тогда
				Если РеквизитыКонтрагента.Пол <> Неопределено Тогда
					ТекЛицо.Пол = ?(РеквизитыКонтрагента.Пол = "1", Перечисления.ПолФизическогоЛица.Мужской, Перечисления.ПолФизическогоЛица.Женский);
				КонецЕсли;  
			ИначеЕсли ЗначениеЗаполнено(Отчество) Тогда
				ТекЛицо.Пол = КорреспондентыКлиентСервер.ОпределитьПолПоОтчеству(Отчество);
			Иначе
				ТекЛицо.Пол = Перечисления.ПолФизическогоЛица.Мужской;
			КонецЕсли;	
			Если РеквизитыКонтрагента.Свойство("РегистрационныйНомер") Тогда
				ТекЛицо.ОГРНИП = РеквизитыКонтрагента.РегистрационныйНомер;
			КонецЕсли;	
			Если РеквизитыКонтрагента.Свойство("ДатаРегистрации") Тогда
				ТекЛицо.ДатаРегистрации = РеквизитыКонтрагента.ДатаРегистрации;
			КонецЕсли;	
			Если РеквизитыКонтрагента.Свойство("РегистрацияВПенсионномФонде") Тогда
				Если РеквизитыКонтрагента.РегистрацияВПенсионномФонде <> Неопределено Тогда
					ТекЛицо.СтраховойНомерПФР = РеквизитыКонтрагента.РегистрацияВПенсионномФонде.РегистрационныйНомерПФР;
				КонецЕсли;
			КонецЕсли;	
		
			Если РеквизитыКонтрагента.Свойство("НаименованиеСокращенное") Тогда
				Контрагент.НаименованиеСокращенное = РеквизитыКонтрагента.НаименованиеСокращенное;
			КонецЕсли;	
			
			Если РеквизитыКонтрагента.Свойство("СвидетельствоОРегистрации") Тогда
				СвидетельствоОРегистрации = РеквизитыКонтрагента.СвидетельствоОРегистрации;
				Если СвидетельствоОРегистрации <> Неопределено Тогда
					Если СвидетельствоОРегистрации.Свойство("Серия") И СвидетельствоОРегистрации.Свойство("Номер") Тогда
						ТекЛицо.СвидетельствоСерияНомер = СвидетельствоОРегистрации.Серия + " " + СвидетельствоОРегистрации.Номер;
					КонецЕсли;
					Если СвидетельствоОРегистрации.Свойство("Дата") Тогда
						ТекЛицо.СвидетельствоДата = СвидетельствоОРегистрации.Дата;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
			
			ТекЛицо.Записать();
			
			ИзменилисьДанныеФИО = Ложь;
			Если ЕстьДанныеФИО Тогда
			 	ДанныеРС = ФИОФЛ(ТекЛицо.Ссылка);
				ФамилияРС = ДанныеРС.Фамилия;
				ИмяРС = ДанныеРС.Имя;
				ОтчествоРС = ДанныеРС.Отчество;
				
				Если ЗначениеЗаполнено(Фамилия) Тогда
					Если НЕ ВРЕГ(СокрЛП(ФамилияРС)) = ВРЕГ(СокрЛП(Фамилия)) Тогда
						ИзменилисьДанныеФИО = Истина;
					КонецЕсли;
				КонецЕсли;	
				Если ЗначениеЗаполнено(Имя) Тогда
					Если НЕ ВРЕГ(СокрЛП(ИмяРС)) = ВРЕГ(СокрЛП(Имя)) Тогда
						ИзменилисьДанныеФИО = Истина;
					КонецЕсли;
				КонецЕсли;	
				Если ЗначениеЗаполнено(Отчество) Тогда
					Если НЕ ВРЕГ(СокрЛП(ОтчествоРС)) = ВРЕГ(СокрЛП(Отчество)) Тогда
						ИзменилисьДанныеФИО = Истина;
					КонецЕсли;
				КонецЕсли;
				
				Если ИзменилисьДанныеФИО Тогда
					НоваяЗапись = РегистрыСведений.ФИОФизическихЛиц.СоздатьМенеджерЗаписи();
					Если НовоеЛицо Тогда
						НоваяЗапись.Период = '19800101';
					Иначе
						НоваяЗапись.Период = НачалоДня(ТекущаяДатаСеанса())-1;
					КонецЕсли;
					НоваяЗапись.ФизическоеЛицо = ТекЛицо.Ссылка;
					НоваяЗапись.Фамилия  = Фамилия;
					НоваяЗапись.Имя      = Имя;
					НоваяЗапись.Отчество = Отчество;
					НоваяЗапись.Записать(Ложь);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		
		Попытка
			Контрагент.Записать();
			Результат = Контрагент.Ссылка;
		Исключение
			Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Запись нового элемента справочника Контрагенты'"),
				УровеньЖурналаРегистрации.Ошибка,
				Контрагент.Метаданные(),
				Контрагент,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ТекстОшибки = НСтр("ru = 'Ошибка при записи нового элемента справочника Контрагенты
				|Подробности см. в Журнале регистрации.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
	Контрагент = Результат;
КонецПроцедуры

Процедура СоздатьДоговорПоРеквизитам(Знач РеквизитыДоговора, Договор, Отказ = Ложь) Экспорт
	Если НЕ ЗначениеЗаполнено(РеквизитыДоговора.ДатаДоговора) Тогда
		Возврат;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(РеквизитыДоговора.ВидДоговора) Тогда
		РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
	КонецЕсли;	
	
	Результат = Справочники.Договоры.СоздатьЭлемент();
	Результат.Организация = РеквизитыДоговора.Организация;
	Результат.НомерДоговора = РеквизитыДоговора.НомерДоговора;
	Результат.ДатаДоговора = РеквизитыДоговора.ДатаДоговора;
	Результат.Контрагент = РеквизитыДоговора.Владелец;
	Результат.ВидДоговора = РеквизитыДоговора.ВидДоговора;
	
	Результат.ВидОбязательства = НСтр("ru = 'Государственный контракт'");
	
	Если ЗначениеЗаполнено(РеквизитыДоговора.НаименованиеДоговора) Тогда
		Результат.Наименование = РеквизитыДоговора.НаименованиеДоговора;
	Иначе	
		ТекстНаименования = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 от %3 № %2'"),
			Результат.ВидОбязательства, РеквизитыДоговора.НомерДоговора, Формат(РеквизитыДоговора.ДатаДоговора, "ДФ=dd.MM.yyyy"));
		
		Результат.Наименование = ТекстНаименования;
	КонецЕсли;
	
	Попытка
		Результат.Записать();
		Договор = Результат.Ссылка;
	Исключение
		Отказ = Истина;
			
		ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Запись нового элемента справочника Договоры'"),
				УровеньЖурналаРегистрации.Ошибка,
				Результат.Метаданные(),
				Результат,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ТекстОшибки = НСтр("ru = 'Ошибка при записи нового элемента справочника Договоры
				|Подробности см. в Журнале регистрации.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры	

Процедура СформироватьТекстНДСЭтапаОплаты(СоответствиеСтавокНДС, ПроцентПлатежа, ТекстНДС) Экспорт
	
	ТекстНДС = "";
	
	Если СоответствиеСтавокНДС.Количество() > 0 Тогда
		
		Для Каждого ТекСтавкаНДС Из СоответствиеСтавокНДС Цикл
			
			Если ТекСтавкаНДС.Значение <> 0 Тогда
				
				ТекстНДС = ТекстНДС + ?(ПустаяСтрока(ТекстНДС), НСтр("ru='НДС(%СтавкаНДС%) %СуммаНДС%'"),
					НСтр("ru=', НДС(%СтавкаНДС%) %СуммаНДС%'"));
				ТекстНДС = СтрЗаменить(ТекстНДС, "%СтавкаНДС%", ТекСтавкаНДС.Ключ);
				ТекстНДС = СтрЗаменить(ТекстНДС, "%СуммаНДС%",  Формат(ТекСтавкаНДС.Значение / 100 * ПроцентПлатежа, "ЧЦ=15; ЧДЦ=2"));
			
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстНДС) Тогда
		ТекстНДС = НСтр("ru='В т.ч. '") + ТекстНДС;
	Иначе
		ТекстНДС = НСтр("ru='Без налога (НДС)'");
	КонецЕсли;
	
КонецПроцедуры

