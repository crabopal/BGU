Функция ПередаваемыеЗУПоДокументам(ДокументыПринятияКУчету, ДокументыСписания)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументыПринятияКУчету", ДокументыПринятияКУчету);
	Запрос.УстановитьПараметр("ДокументыСписания", ДокументыСписания);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.ОсновноеСредство КАК Номенклатура,
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.Количество КАК Количество,
	               |	ВЫБОР
	               |		КОГДА ПринятиеКУчетуОбъектовОСОсновныеСредства.Количество = 0
	               |			ТОГДА ПринятиеКУчетуОбъектовОСОсновныеСредства.Сумма
	               |		ИНАЧЕ ПринятиеКУчетуОбъектовОСОсновныеСредства.Сумма / ПринятиеКУчетуОбъектовОСОсновныеСредства.Количество
	               |	КОНЕЦ КАК Цена,
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.Сумма КАК СуммаБезНДС,
	               |	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.Сумма КАК Сумма,
	               |	0 КАК СуммаНДС,
	               |	""1ЗУ"" КАК ПризнакНоменклатуры,
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.КФО КАК КФО,
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.СчетУчетаОС КАК СчетУчета,
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	               |	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер КАК КадастровыйНомер,
	               |	ЛОЖЬ КАК Списано
	               |ИЗ
	               |	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ПринятиеКУчетуОбъектовОСОсновныеСредства
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияКадастровогоУчета.СрезПоследних КАК СведенияКадастровогоУчетаСрезПоследних
	               |		ПО ПринятиеКУчетуОбъектовОСОсновныеСредства.ОсновноеСредство = СведенияКадастровогоУчетаСрезПоследних.ОсновноеСредство
	               |			И ПринятиеКУчетуОбъектовОСОсновныеСредства.ИнвентарныйНомер = СведенияКадастровогоУчетаСрезПоследних.ИнвентарныйНомер
	               |ГДЕ
	               |	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка В(&ДокументыПринятияКУчету)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПринятиеКУчетуОбъектовИКОсновныеСредства.ОсновноеСредство,
	               |	ПринятиеКУчетуОбъектовИКОсновныеСредства.Количество,
	               |	ВЫБОР
	               |		КОГДА ПринятиеКУчетуОбъектовИКОсновныеСредства.Количество = 0
	               |			ТОГДА ПринятиеКУчетуОбъектовИКОсновныеСредства.Сумма
	               |		ИНАЧЕ ПринятиеКУчетуОбъектовИКОсновныеСредства.Сумма / ПринятиеКУчетуОбъектовИКОсновныеСредства.Количество
	               |	КОНЕЦ,
	               |	ПринятиеКУчетуОбъектовИКОсновныеСредства.Сумма,
	               |	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка),
	               |	ПринятиеКУчетуОбъектовИКОсновныеСредства.Сумма,
	               |	0,
	               |	""1ЗУ"",
	               |	ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет),
	               |	ПринятиеКУчетуОбъектовИКОсновныеСредства.СчетУчетаОС,
	               |	ПринятиеКУчетуОбъектовИКОсновныеСредства.ИнвентарныйНомер,
	               |	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер,
	               |	ЛОЖЬ
	               |ИЗ
	               |	Документ.ПринятиеКУчетуОбъектовИК.ОсновныеСредства КАК ПринятиеКУчетуОбъектовИКОсновныеСредства
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияКадастровогоУчета.СрезПоследних КАК СведенияКадастровогоУчетаСрезПоследних
