		Торг12Ссылка = РеквизитыСФ.ДокументОснование;
		РасчетныеСчета = Неопределено;
		ЗаполнитьРасчетныеСчетаУПД(РасчетныеСчета, Торг12Ссылка);
				
		// Продавец
		ЗаполнитьДанныеУчастникаУПД_2019(
			ДеревоДанных,
			"СведенияОПродавце",
			"СведенияОбУчастнике",
			СтороныСделки.Продавец.Ссылка,
			РеквизитыСФ.Дата,
			Истина,
			РасчетныеСчета.Продавец,
			СтороныСделки,
			,
			ДанныеЭлектронногоАктирования);
			
		// Покупатель
		ЗаполнитьДанныеУчастникаУПД_2019(
			ДеревоДанных,
			"СведенияОПокупателе",
			"СведенияОбУчастнике",
			СтороныСделки.Покупатель.Ссылка,
			РеквизитыСФ.Дата,
			Истина,
			РасчетныеСчета.Покупатель,
			СтороныСделки,
			,
			ДанныеЭлектронногоАктирования);
			
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
			СоставительДокумента = ЭлектронноеАктированиеБГУ.СоставительДокумента(СтороныСделки.Продавец.Ссылка);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"СоставительДокументаНаименование", СоставительДокумента);
			// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СоставительДокументаНаименование", РеквизитыСФ.Организация.НаименованиеПолное);
		КонецЕсли;
		
		// Таблица ПРД
		ПлатежныеДокументы = Неопределено;
		ЗаполнитьТаблицуПлатежныхДокументовУПД(ПлатежныеДокументы, ТаблицаПРД);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ПлатежныеДокументы, "ПлатежноРасчетныеДокументы");
		
		// Таблица НФА
		ТаблицаТоваров = Неопределено;
		ТолькоУслуги = Неопределено;
		ДанныеКодовМаркировки = Новый Структура;
		ДанныеКодовМаркировки.Вставить("СсылкаНаОбъект", СсылкаНаОбъект);
		ДанныеКодовМаркировки.Вставить("ТаблицаКодовМаркировки", ТаблицаКодовМаркировки);
		
		ДанныеАктированияДокументаРеализации = Новый Структура;
		ДанныеАктированияДокументаРеализации.Вставить("ЕстьЭлектронноеАктирование", ЕстьЭлектронноеАктирование);
		Если ЕстьЭлектронноеАктирование Тогда
			Если ЗначениеЗаполнено(ДокументОснование) Тогда
				ТаблицаАктированияДокументаРеализации = ДокументОснование.ДанныеДляАктированияЕИС.Выгрузить();
				ДанныеАктированияДокументаРеализации.Вставить("ДанныеШапки", ДанныеДокумента.Шапка[0]);
				ДанныеАктированияДокументаРеализации.Вставить("СсылкаНаОбъект", СсылкаНаОбъект);
				ДанныеАктированияДокументаРеализации.Вставить("ДанныеЭлектронногоАктирования", ДанныеДокумента.ДанныеЭлектронногоАктирования);
				ДанныеАктированияДокументаРеализации.Вставить("ДанныеПриложенияЕИС", ДанныеПриложенияЕИС);
				ДанныеАктированияДокументаРеализации.Вставить("ТаблицаАктирования", ТаблицаАктированияДокументаРеализации);
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьДопДанныеПрослеживаемостиВТаблицеНФА(СсылкаНаОбъект.ДокументОснование, ТаблицаНФА);
		
		Параметры = НовыйПараметрыЗаполнитьТаблицуТоваровУПД_2019();
		Параметры.ТолькоУслуги			= ТолькоУслуги;
		Параметры.ТаблицаНФА			= ТаблицаНФА;
		Параметры.СчетФактураНаАванс	= СчетФактураНаАванс;
		Параметры.СчетФактураШкурыЛом	= СчетФактураШкурыЛом;
		Параметры.ДанныеКодовМаркировки								= ДанныеКодовМаркировки;
		Параметры.НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд	= НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд;
		Параметры.ДанныеАктированияЕИС								= ДанныеАктированияДокументаРеализации;
		
		ЗаполнитьТаблицуТоваровУПД_2019(ТаблицаТоваров, Параметры);
		
		ТолькоУслуги = Параметры.ТолькоУслуги;
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "СведенияОТоварах");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);
		
		ЭтоАванс = УчетНДСПовтИсп.Аванс(РеквизитыСФ.ПричинаНалогообложения);
		ЭтоНалоговыйАгент = УчетНДСПовтИсп.НалоговыйАгент(РеквизитыСФ.ПричинаНалогообложения);
		
		ИспользоватьПрочеркГрузоотправительГрузополучатель = (ТолькоУслуги ИЛИ ЭтоНалоговыйАгент ИЛИ ЭтоАванс);
			
		// Грузоотправитель
		Если НЕ ИспользоватьПрочеркГрузоотправительГрузополучатель Тогда
			ОнЖе = СтороныСделки.Грузоотправитель.СовпадаетСПродавцом;
			
			Если ОнЖе Тогда
				ТаблицаГрузоотправителей = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
					ДеревоДанных, "СведенияОГрузоотправителе");
					
				ТаблицаГрузоотправителей.Колонки.Добавить("СведенияОбУчастнике");
				
				ТаблицаГрузоотправителей.Добавить().ОнЖе = ОнЖе;
				
				ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_2019(ТаблицаГрузоотправителей, "Грузоотправитель");
				
				ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаГрузоотправителей, "СведенияОГрузоотправителе");
			Иначе	
				ЗаполнитьДанныеУчастникаГрузооборотаУПД_2019(
					ДеревоДанных,
					"СведенияОГрузоотправителе",
					"СведенияОбУчастнике",
					СтороныСделки.Грузоотправитель.Ссылка,
					РеквизитыСФ.Дата,
					Истина,
					РасчетныеСчета.Грузоотправитель,
					ОнЖе,
					СтороныСделки,
					ДанныеЭлектронногоАктирования);
			КонецЕсли;
		КонецЕсли;
		
		// Грузополучатель
		Если НЕ ИспользоватьПрочеркГрузоотправительГрузополучатель Тогда
			ЗаполнитьДанныеУчастникаГрузооборотаУПД_2019(
				ДеревоДанных,
				"СведенияОГрузополучателе",
				"СведенияОбУчастнике",
				СтороныСделки.Грузополучатель.Ссылка,
				РеквизитыСФ.Дата,
				Истина,
				РасчетныеСчета.Грузополучатель,
				,
				СтороныСделки,
				ДанныеЭлектронногоАктирования);
		КонецЕсли;
		
		ТекстОшибки = НСтр("ru = 'Возникла ошибка при заполнении страны происхождения в сведениях по ГТД. Возможные причины:
		|	- не заполнена колонка ""Страна происхождения""
		|	- указанной страны нет в классификаторе стран мира'");
		ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных,
			"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.СтранаПроисхожденияКод", ТекстОшибки);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогом"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСуммаНалога", ТаблицаТоваров.Итог("СуммаНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоКоличество", ТаблицаТоваров.Итог("Количество"));
		
		// Передача данных об авансах
		Если СчетФактураНаАванс И ТаблицаТоваров.Количество() > 0 Тогда
			
			// добавление доп. данных
			ТаблицаДопДанных = Новый ТаблицаЗначений;
			ТаблицаДопДанных.Колонки.Добавить("Идентификатор");
			ТаблицаДопДанных.Колонки.Добавить("Значение");
			
			ТаблицаАвансы = Новый ТаблицаЗначений;
			ТаблицаАвансы.Колонки.Добавить("Сумма");
			ТаблицаАвансы.Колонки.Добавить("СуммаНДС");
			ТаблицаАвансы.Колонки.Добавить("СтавкаНДС");
			
			Для Каждого СтрокаДанных Из ТаблицаТоваров Цикл
				
				СтрокаАвансы = ТаблицаАвансы.Добавить();
				СтрокаАвансы.Сумма = СтрокаДанных.СтоимостьТоваровСНалогом;
				СтрокаАвансы.СуммаНДС = СтрокаДанных.СуммаНалога;
				СтрокаАвансы.СтавкаНДС = СтрокаДанных.НалоговаяСтавка;
				
			КонецЦикла;
			
			ТаблицаАвансы.Свернуть("СтавкаНДС", "Сумма,СуммаНДС");
			
			СтрокаТаблицы = ТаблицаДопДанных.Добавить();
			СтрокаТаблицы.Идентификатор = "Авансы";
			СтрокаТаблицы.Значение = ОбщегоНазначения.ЗначениеВСтрокуXML(ТаблицаАвансы);
			
			ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаДопДанных, "ДопДанныеСчетаФактуры.ТекстоваяИнформация");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

// Подготавливает данные для электронного документа типа ИсправительныйСчетФактураВыданный,
// исправляющего корректировочный счет-фактуру.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ПодготовитьДанныеПоИсправительномуСчетуФактуре_КорректировкаУКД_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь)
	
	НетЗамечанийКДокументу = Документы["ИсправительныйСчетФактураВыданный"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		Сообщить(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокумента = Документы.ИсправительныйСчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект, "Корректировка", Ложь);
	
	ЕстьЭлектронноеАктирование = Ложь;
	
	ТаблицаСФ	= ДанныеДокумента["Шапка"];
	ТаблицаНФА	= ДанныеДокумента["ТабЧастьНФА"];
	ТаблицаПРД	= ДанныеДокумента["ТабЧастьПРД"];
	
	СтороныСделки	= ДанныеДокумента["СтороныСделки"];
	НомерДокумента	= ДанныеДокумента["НомерДокумента"];
	
	Для Каждого РеквизитыИСФ Из ТаблицаСФ Цикл
		
		СчетФактураШкурыЛом = УчетНДСПовтИсп.ШкурыЛом(РеквизитыИСФ.ПричинаНалогообложения);

		Если Не ЗначениеЗаполнено(РеквизитыИСФ.КодВалюты) Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
				"Объект.ВалютаДокумента");
		Иначе
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект.ВалютаДокумента, 
				"Объект.Код");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидДокумента", "Корректировка"); // или "Возврат"
		
		ВидОперации = Перечисления.ВидыОперацийЭД.Исправление;
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", ВидОперации);
		
		// Реквизиты КСФ
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаКорректировочногоСчетаФактуры", СсылкаНаОбъект);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДляПечати(СсылкаНаОбъект, НомерДокумента.НомерКСФ));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  РеквизитыИСФ.Дата);
		
		НомерИсправления = РеквизитыИСФ.НомерИсправленияКорректировки;
		Если ЗначениеЗаполнено(НомерИсправления) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления", НомерИсправления);
		КонецЕсли;
		
		ДатаИсправления = РеквизитыИСФ.НомерИсправленияКорректировки;
		Если ЗначениеЗаполнено(ДатаИсправления) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления", ДатаИсправления);
		КонецЕсли;
		
		// Реквизиты СФ
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсходногоДокумента", НомерДокумента.Номер);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсходногоДокумента", РеквизитыИСФ.ДатаСчетаФактуры);
		
		НомерИсправленияИсходногоДокумента = РеквизитыИСФ.НомерИсправления;
		Если ЗначениеЗаполнено(НомерИсправленияИсходногоДокумента) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправленияИсходногоДокумента", НомерИсправленияИсходногоДокумента);
		КонецЕсли;
		
		ДатаИсправленияИсходногоДокумента = РеквизитыИСФ.ДатаИсправления;
		Если ЗначениеЗаполнено(ДатаИсправленияИсходногоДокумента) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправленияИсходногоДокумента", ДатаИсправленияИсходногоДокумента);
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыИСФ.КодВалюты, ПараметрыОбработкиОшибок);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", РеквизитыИСФ.ИдентификаторГосКонтракта);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаНаименование", РеквизитыИСФ.ВалютаПредставление);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаКурс", РеквизитыИСФ.Курс);
		
		// Продавец
		ЗаполнитьДанныеУчастникаУПД_2019(
			ДеревоДанных,
			"СведенияОПродавце",
			"СведенияОбУчастнике",
			СтороныСделки.Продавец.Ссылка,
			РеквизитыИСФ.Дата,
			Истина,
			,
			СтороныСделки);
		
		// Покупатель
		ЗаполнитьДанныеУчастникаУПД_2019(
			ДеревоДанных,
			"СведенияОПокупателе",
			"СведенияОбУчастнике",
			СтороныСделки.Покупатель.Ссылка,
			РеквизитыИСФ.Дата,
			Истина,
			,
			СтороныСделки);
			
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", РеквизитыИСФ.Организация.НаименованиеПолное);
			
		ОснованиеКорректировки = Новый ТаблицаЗначений;
		ОснованиеКорректировки.Колонки.Добавить("ДокументНаименование");
		ОснованиеКорректировки.Колонки.Добавить("ДокументНомер");
		ОснованиеКорректировки.Колонки.Добавить("ДокументДата");
		ОснованиеКорректировки.Колонки.Добавить("ДокументДопСведения");
		Если ЗначениеЗаполнено(РеквизитыИСФ.Договор) Тогда
			НоваяСтрока = ОснованиеКорректировки.Добавить();
			НоваяСтрока.ДокументНаименование = РеквизитыИСФ.Договор.ВидОбязательства;
			НоваяСтрока.ДокументНомер = РеквизитыИСФ.Договор.НомерДоговора;
			НоваяСтрока.ДокументДата = РеквизитыИСФ.Договор.ДатаДоговора;
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ОснованиеКорректировки,
			"ДокументДата", , ,
			НСтр("ru = 'Не заполнена дата договора для реквизита ""Договор"".'"));
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованиеКорректировки, "ОснованиеОтгрузкиТоваров");
			
		// Таблица НФА
		ТаблицаТоваров = Неопределено;
		ТолькоУслуги = Неопределено;
		ЗаполнитьТаблицуТоваровУКД(ТаблицаТоваров, ТолькоУслуги, ТаблицаНФА, СчетФактураШкурыЛом);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "СведенияОТоварах");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровБезНалогаУвеличение", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалогаУвеличение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровСНалогомУвеличение", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогомУвеличение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСуммаНалогаУвеличение", ТаблицаТоваров.Итог("СуммаНалогаУвеличение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровБезНалогаУменьшение", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалогаУменьшение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровСНалогомУменьшение", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогомУменьшение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСуммаНалогаУменьшение", ТаблицаТоваров.Итог("СуммаНалогаУменьшение"));
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", "Исправительный счет-фактура");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаНаправленияНаСогласование", РеквизитыИСФ.Дата);
		
	КонецЦикла;	
КонецПроцедуры	

// Подготавливает данные для электронного документа типа КорректировочныйСчетФактураВыданный.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ПодготовитьДанныеПоКорректировочномуСчетуФактуреУКД_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	НетЗамечанийКДокументу = Документы["КорректировочныйСчетФактураВыданный"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокумента = Документы.КорректировочныйСчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
	ЕстьЭлектронноеАктирование = Ложь;
	
	ТаблицаСФ	= ДанныеДокумента["Шапка"];
	ТаблицаНФА	= ДанныеДокумента["ТабЧастьНФА"];
	
	СтороныСделки	= ДанныеДокумента["СтороныСделки"];
	НомерДокумента	= ДанныеДокумента["НомерДокумента"];
	
	Для Каждого РеквизитыКСФ Из ТаблицаСФ Цикл
		
		СчетФактураШкурыЛом = УчетНДСПовтИсп.ШкурыЛом(РеквизитыКСФ.ПричинаНалогообложения);
		
		Если Не ЗначениеЗаполнено(РеквизитыКСФ.ВалютаКод) Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
				"Объект.ВалютаДокумента");
		Иначе
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект.ВалютаДокумента, 
				"Объект.Код");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", "Предлагаю изменить стоимость");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаНаправленияНаСогласование", РеквизитыКСФ.Дата);
	
		КорректируемыйСФ = РеквизитыКСФ.ДокументОснование;
		
		// Реквизиты КСФ
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаКорректировочногоСчетаФактуры", СсылкаНаОбъект);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДляПечати(СсылкаНаОбъект, НомерДокумента.НомерКСФ));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  РеквизитыКСФ.Дата);
		
		НомерИсправления = РеквизитыКСФ.НомерИсправления;
		Если ЗначениеЗаполнено(НомерИсправления) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления", НомерИсправления);
		КонецЕсли;
		
		ДатаИсправления = РеквизитыКСФ.ДатаИсправления;
		Если ЗначениеЗаполнено(ДатаИсправления) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления", ДатаИсправления);
		КонецЕсли;
		
		// Реквизиты СФ
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсходногоДокумента", НомерДокумента.Номер);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсходногоДокумента",  РеквизитыКСФ.ДатаСчетаФактуры);
		
		НомерИсправленияИсходногоДокумента = РеквизитыКСФ.НомерИсправленияКорректировки;
		Если ЗначениеЗаполнено(НомерИсправленияИсходногоДокумента) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправленияИсходногоДокумента", НомерИсправленияИсходногоДокумента);
		КонецЕсли;
		
		ДатаИсправленияИсходногоДокумента = РеквизитыКСФ.ДатаИсправленияКорректировки;
		Если ЗначениеЗаполнено(ДатаИсправленияИсходногоДокумента) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправленияИсходногоДокумента", ДатаИсправленияИсходногоДокумента);
		КонецЕсли;
		
		// Продавец
		ЗаполнитьДанныеУчастникаУПД_2019(
			ДеревоДанных,
			"СведенияОПродавце",
			"СведенияОбУчастнике",
			СтороныСделки.Продавец.Ссылка,
			РеквизитыКСФ.Дата,
			Истина,
			,
			СтороныСделки);
			
		// Покупатель
		ЗаполнитьДанныеУчастникаУПД_2019(
			ДеревоДанных,
			"СведенияОПокупателе",
			"СведенияОбУчастнике",
			СтороныСделки.Покупатель.Ссылка,
			РеквизитыКСФ.Дата,
			Истина,
			,
			СтороныСделки);
			
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", РеквизитыКСФ.Организация.ПолноеНаименование);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыКСФ.ВалютаКод, ПараметрыОбработкиОшибок);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", РеквизитыКСФ.ИдентификаторГосКонтракта);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаНаименование", РеквизитыКСФ.ВалютаПредставление);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаКурс", РеквизитыКСФ.Курс);
			
		ДанныеДокументаОснования = ДокументОснованиеСЧФ(КорректируемыйСФ);
		ЭтоУслуги = ДанныеДокументаОснования.ЭтоУслуги;
		
		ОснованиеКорректировки = Новый ТаблицаЗначений;
		ОснованиеКорректировки.Колонки.Добавить("ДокументНаименование");
		ОснованиеКорректировки.Колонки.Добавить("ДокументНомер");
		ОснованиеКорректировки.Колонки.Добавить("ДокументДата");
		ОснованиеКорректировки.Колонки.Добавить("ДокументДопСведения");
		
		Если ЗначениеЗаполнено(РеквизитыКСФ.Договор) Тогда
			НоваяСтрока = ОснованиеКорректировки.Добавить();
			НоваяСтрока.ДокументНаименование = РеквизитыКСФ.Договор.ВидОбязательства;
			НоваяСтрока.ДокументНомер = РеквизитыКСФ.Договор.НомерДоговора;
			НоваяСтрока.ДокументДата = РеквизитыКСФ.Договор.ДатаДоговора;
		Иначе	
			НоваяСтрока = ОснованиеКорректировки.Добавить();
			НоваяСтрока.ДокументНаименование = "Отсутствует";
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ОснованиеКорректировки,
			"ДокументДата", , ,
			НСтр("ru = 'Не заполнена дата договора для реквизита ""Договор"".'"));
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованиеКорректировки, "ОснованиеКорректировки");
		
		// Таблица НФА
		ТаблицаТоваров = Неопределено;
		ТолькоУслуги = Неопределено;
		ЗаполнитьТаблицуТоваровУКД(ТаблицаТоваров, ТолькоУслуги, ТаблицаНФА, СчетФактураШкурыЛом);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "СведенияОТоварах");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровБезНалогаУвеличение", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалогаУвеличение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровСНалогомУвеличение", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогомУвеличение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСуммаНалогаУвеличение", ТаблицаТоваров.Итог("СуммаНалогаУвеличение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровБезНалогаУменьшение", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалогаУменьшение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровСНалогомУменьшение", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогомУменьшение"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоИзмененияСтоимости.ВсегоСуммаНалогаУменьшение", ТаблицаТоваров.Итог("СуммаНалогаУменьшение"));
			
	КонецЦикла;
	
КонецПроцедуры	

Процедура ЗаполнитьДанныеУчастникаУПД_2019(ДеревоДанных, Путь, ИмяКолонки, Знач Участник, ДатаДанных, ЭтоСчетФактура = Ложь, 
	РасчетныйСчет = Неопределено, 
	СтороныСделки = Неопределено,
	ОбособленноеПодразделениеКПП = "",
	ДанныеЭлектронногоАктирования = Неопределено) Экспорт
	
	ТаблицаУчастников = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		ДеревоДанных, Путь);
	ТаблицаУчастников.Колонки.Добавить(ИмяКолонки);
	ДанныеУчастника = ПолучитьДанныеУчастникаУПД_2019(Участник, ДатаДанных, ЭтоСчетФактура, РасчетныйСчет, СтороныСделки, Путь, ДанныеЭлектронногоАктирования);
	Если ЗначениеЗаполнено(ОбособленноеПодразделениеКПП) Тогда
		ДанныеУчастника.СведенияОбУчастнике.КПП = ОбособленноеПодразделениеКПП;
		ДанныеУчастника.ТипУчастника.ЮЛ.КПП = ОбособленноеПодразделениеКПП;
	КонецЕсли;	
	СтрокаУчастника = ТаблицаУчастников.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаУчастника, ДанныеУчастника);
	ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_2019(ТаблицаУчастников);
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаУчастников, Путь);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеУчастникаГрузооборотаУПД_2019(ДеревоДанных, Путь, ИмяКолонки, Знач Участник, ДатаДанных, ЭтоСчетФактура = Ложь, РасчетныйСчет = Неопределено, ОнЖе = Ложь, СтороныСделки = Неопределено, ДанныеЭлектронногоАктирования = Неопределено) Экспорт
	ТаблицаУчастниковДляПроверки = Новый ТаблицаЗначений;
	
	ТаблицаУчастников = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		ДеревоДанных, Путь);
	ТаблицаУчастников.Колонки.Добавить(ИмяКолонки);
	ДанныеУчастника = ПолучитьДанныеУчастникаУПД_2019(Участник, ДатаДанных, ЭтоСчетФактура, РасчетныйСчет, СтороныСделки, Путь, ДанныеЭлектронногоАктирования);
	СтрокаУчастника = ТаблицаУчастников.Добавить();
	
	Если Путь = НСтр("ru = 'СведенияОГрузоотправителе'") Тогда
		СтрокаУчастника.ОнЖе = ОнЖе;
		СтрокаУчастника.СведенияОбУчастнике = ДанныеУчастника.СведенияОбУчастнике;
		СтрокаУчастника.Грузоотправитель = ДанныеУчастника;
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_2019(ТаблицаУчастников, "Грузоотправитель");
	ИначеЕсли Путь = НСтр("ru = 'СведенияОГрузополучателе'") Тогда	
		СтрокаУчастника.СведенияОбУчастнике = ДанныеУчастника.СведенияОбУчастнике;
		ЗаполнитьЗначенияСвойств(СтрокаУчастника, ДанныеУчастника); 
		ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_2019(ТаблицаУчастников);
	КонецЕсли;	
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаУчастников, Путь);
	
КонецПроцедуры

Функция ПолучитьДанныеУчастникаУПД_2019(Знач Участник, ДатаДанных, ЭтоСчетФактура = Ложь, РасчетныйСчет = Неопределено, СтороныСделки = Неопределено, Путь, ДанныеЭлектронногоАктирования = Неопределено) Экспорт
	ЭтоЭлектронноеАктированиеЕИС = Ложь;
	Если ТипЗнч(ДанныеЭлектронногоАктирования) = Тип("Структура") Тогда
		ЭтоЭлектронноеАктированиеЕИС = Истина;
	КонецЕсли;	
	
	СведенияОбУчастнике = Новый Структура;
	
	ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике, ДатаДанных, ЭтоСчетФактура);
	
	Если СтороныСделки <> Неопределено Тогда
		Если Путь = "СведенияОПродавце" Тогда
			СторонаСделки = СтороныСделки.Продавец;
			
		ИначеЕсли Путь = "СведенияОПокупателе" Тогда
			СторонаСделки = СтороныСделки.Покупатель;
			
		ИначеЕсли Путь = "СведенияОГрузоотправителе" Тогда
			СторонаСделки = СтороныСделки.Грузоотправитель;
			
		ИначеЕсли Путь = "СведенияОГрузополучателе" Тогда
			СторонаСделки = СтороныСделки.Грузополучатель;
		КонецЕсли;
		
		ОбновляемыеСвойства = Новый Структура();
		ОбновляемыеСвойства.Вставить("ИНН", СторонаСделки.ИНН);
		Если СторонаСделки.Свойство("КПП") Тогда
			ОбновляемыеСвойства.Вставить("КПП", СторонаСделки.КПП);
		КонецЕсли;	
		ОбновляемыеСвойства.Вставить("ОфициальноеНаименование", СведенияОбУчастнике.ПолноеНаименование);
		
		ЗаполнитьЗначенияСвойств(СведенияОбУчастнике, ОбновляемыеСвойства);
	КонецЕсли;
	
	СведенияОбУчастнике.Вставить("Ссылка", Участник);
	
	Данные = Новый Структура("СведенияОбУчастнике", СведенияОбУчастнике);
	
	Данные.Вставить("ТипУчастника", Новый Структура);
	
	Если СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		
		Если ЭтоЭлектронноеАктированиеЕИС И Путь = "СведенияОПродавце" Тогда
			ПолноеНаименованиеПоставщикаЕИС = ДанныеЭлектронногоАктирования.ДанныеГосконтракта[0].ПолноеНаименованиеПоставщика;
			Если ЗначениеЗаполнено(ПолноеНаименованиеПоставщикаЕИС) Тогда
				НаименованиеОрганизации = ПолноеНаименованиеПоставщикаЕИС;
			Иначе	
				НаименованиеОрганизации = ЭлектронноеАктированиеЕИС.НаименованиеОрганизацииДляЭД(Участник);
			КонецЕсли;
		ИначеЕсли ЭтоЭлектронноеАктированиеЕИС И Путь = "СведенияОПокупателе" Тогда
			ПолноеНаименованиеЗаказчикаЕИС = ДанныеЭлектронногоАктирования.ДанныеГосконтракта[0].ПолноеНаименованиеЗаказчика;
			Если ЗначениеЗаполнено(ПолноеНаименованиеЗаказчикаЕИС) Тогда
				НаименованиеОрганизации = ПолноеНаименованиеЗаказчикаЕИС;
			Иначе	
				НаименованиеОрганизации = СведенияОбУчастнике.ОфициальноеНаименование;
			КонецЕсли;
		Иначе
			НаименованиеОрганизации = СведенияОбУчастнике.ОфициальноеНаименование;
		КонецЕсли;
		
		Если ЭтоЭлектронноеАктированиеЕИС И Путь = "СведенияОПокупателе" Тогда
			Данные.Вставить("ИнформацияДляУчастника", ЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаПокупателя());
		ИначеЕсли ЭтоЭлектронноеАктированиеЕИС И Путь = "СведенияОГрузополучателе" Тогда
			Данные.Вставить("ИнформацияДляУчастника", ЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаГрузополучателя());
		КонецЕсли;
		
		Данные.ТипУчастника.Вставить("ЮЛ", Новый Структура);
		Данные.ТипУчастника.ЮЛ.Вставить("НаименованиеОрганизации", НаименованиеОрганизации);
		Данные.ТипУчастника.ЮЛ.Вставить("ИНН", СведенияОбУчастнике.ИНН);
		Данные.ТипУчастника.ЮЛ.Вставить("КПП", СведенияОбУчастнике.КПП);
		
	Иначе
		СвидетельствоОРегистрацииИП = "";
		ДанныеСвидетельстваОРегистрацииИП(СведенияОбУчастнике.Ссылка, СвидетельствоОРегистрацииИП);
		Если ЗначениеЗаполнено(СвидетельствоОРегистрацииИП) Тогда
			Данные.ТипУчастника.Вставить("ИП", Новый Структура);
			Данные.ТипУчастника.ИП.Вставить("ИНН", СведенияОбУчастнике.ИНН);
			Данные.ТипУчастника.ИП.Вставить("Фамилия", СведенияОбУчастнике.Фамилия);
			Данные.ТипУчастника.ИП.Вставить("Имя", СведенияОбУчастнике.Имя);
			Данные.ТипУчастника.ИП.Вставить("Отчество", СведенияОбУчастнике.Отчество);
			Данные.ТипУчастника.ИП.Вставить("СвидетельствоОГосРегистрации", СвидетельствоОРегистрацииИП);
		Иначе
			Данные.ТипУчастника.Вставить("ФЛ", Новый Структура);
			Данные.ТипУчастника.ФЛ.Вставить("ИНН", СведенияОбУчастнике.ИНН);
			Данные.ТипУчастника.ФЛ.Вставить("Фамилия", СведенияОбУчастнике.Фамилия);
			Данные.ТипУчастника.ФЛ.Вставить("Имя", СведенияОбУчастнике.Имя);
			Данные.ТипУчастника.ФЛ.Вставить("Отчество", СведенияОбУчастнике.Отчество);
		КонецЕсли;	
	КонецЕсли;
	
	Если СтороныСделки <> Неопределено Тогда
		
		СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СторонаСделки.Адрес.JsonИлиXML);
		
		КодСтраныРоссия = "643";
		
		Если НЕ ЗначениеЗаполнено(СведенияОбАдресе.КодСтраны) Тогда
			СведенияОбАдресе.КодСтраны = КодСтраныРоссия;
		КонецЕсли;
		
		Если УправлениеКонтактнойИнформациейКлиентСервер.ЭтоАдресВСвободнойФорме(СведенияОбАдресе.ТипАдреса)
			Или СведенияОбАдресе.ТипАдреса = "Муниципальный"
			ИЛИ СведенияОбАдресе.КодСтраны <> КодСтраныРоссия Тогда
			
			ИмяКоллекции = "АдресИнформация";
		Иначе
			
			ИмяКоллекции = "АдресРФ";
		КонецЕсли;	
		
		Если ИмяКоллекции = "АдресИнформация" Тогда
			Коллекция = Новый Структура();
			Коллекция.Вставить("КодСтраны",		СведенияОбАдресе.КодСтраны);
			Коллекция.Вставить("АдресТекст",	СторонаСделки.Адрес.Представление); // СведенияОбАдресе.Представление
			
		ИначеЕсли ИмяКоллекции = "АдресРФ" Тогда
			Коллекция = ПолучитьАдресКЛАДР(СведенияОбАдресе);
			
		КонецЕсли;
		
		Адрес = Новый Структура(ИмяКоллекции, Коллекция);
		
		Данные.Вставить("Адрес", Адрес);
		
	Иначе
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Участник", Участник);
		
		ПолучитьАдресСтруктурой(СтруктураПараметров, "Участник", "Юр");
		
		АдресУчастника = СтруктураПараметров.СтруктураАдреса;
		
		ВидАдреса = ?(АдресУчастника.АдресРФ, "АдресРФ", "АдресИнформация");
		
		АдресВСвободнойФорме = АдресЮридическийУКонтрагентаВСвободнойФорме(Участник);
		
		Если ЗначениеЗаполнено(АдресВСвободнойФорме.АдресТекст) Тогда
			АдресУчастника = АдресВСвободнойФорме;
			
			ВидАдреса = "АдресИнформация";
		Иначе	
			Если ВидАдреса = "АдресРФ" Тогда 
				Если (СтрДлина(АдресУчастника.Кварт)>20) ИЛИ (СтрДлина(АдресУчастника.Корпус)>20) Тогда
					ВидАдреса = "АдресИнформация";
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
		
		Если ВидАдреса = "АдресРФ" Тогда
			Данные.Вставить("Адрес", Новый Структура);
			Данные.Адрес.Вставить("АдресРФ", АдресУчастника);
		ИначеЕсли ВидАдреса = "АдресИнформация" Тогда
			Данные.Вставить("Адрес", Новый Структура);
			Данные.Адрес.Вставить("АдресИнформация", АдресУчастника);
		Иначе
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			Если ТипЗнч(Участник) = Тип("СправочникСсылка.Организации") Тогда
				ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
			КонецЕсли;
			
			ВидКонтактнойИнформации = ?(ТипЗнч(Участник) = Тип("СправочникСсылка.Контрагенты"),
				Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
			
			Данные.Вставить("Адрес", Новый Структура);
			Данные.Адрес.Вставить("АвтоматическиЗаполняемый", Новый Структура);
			Данные.Адрес.АвтоматическиЗаполняемый.Вставить("ОбъектКонтактнойИнформации", Участник);
			Данные.Адрес.АвтоматическиЗаполняемый.Вставить("ВидКонтактнойИнформации", ВидКонтактнойИнформации);
		КонецЕсли;
		
	КонецЕсли;	
	
	Данные.Вставить("КонтактныеСведения", Новый Структура);
	
	Телефон = "";
	Если СведенияОбУчастнике.Свойство("Телефоны", Телефон) И ЗначениеЗаполнено(Телефон) Тогда
		Данные.КонтактныеСведения.Вставить("Телефон", Телефон);
	КонецЕсли;
	
	ЭлектроннаяПочта = "";
	Если СведенияОбУчастнике.Свойство("ЭлектроннаяПочта", ЭлектроннаяПочта) И ЗначениеЗаполнено(ЭлектроннаяПочта) Тогда
		Данные.КонтактныеСведения.Вставить("ЭлектроннаяПочта", ЭлектроннаяПочта);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РасчетныйСчет) Тогда
		Данные.Вставить("БанковскиеРеквизиты", ПолучитьБанковскиеРеквизитыУчастникаУПД_2019(РасчетныйСчет));
	КонецЕсли;
	
	КодПоОКПО = "";
	
	Если СведенияОбУчастнике.Свойство("КодПоОКПО", КодПоОКПО) И ЗначениеЗаполнено(КодПоОКПО) Тогда
		Данные.Вставить("КодОКПО", КодПоОКПО);
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьБанковскиеРеквизитыУчастникаУПД_2019(РасчетныйСчет)
	
	ЛицевойСчет		= РасчетныйСчет;
	РеквизитыСчета	= РасчетныйСчет;
	
	Если ТипЗнч(РасчетныйСчет) = Тип("СправочникСсылка.РеквизитыЛицевыхСчетов") Тогда
		ЛицевойСчет = РасчетныйСчет.Владелец;
	КонецЕсли;
	
	СтруктураПлатежныхРеквизитов = Новый Структура();
	СтруктураПлатежныхРеквизитов.Вставить("ИННПолучателя",					"ИНН");
	СтруктураПлатежныхРеквизитов.Вставить("КПППолучателя",					"КПП");
	СтруктураПлатежныхРеквизитов.Вставить("ТекстПолучателя",				"Корреспондент");
	СтруктураПлатежныхРеквизитов.Вставить("НомерСчетаПолучателя",			"СчетНомер");
	СтруктураПлатежныхРеквизитов.Вставить("НаименованиеБанкаПолучателя",	"Банк");
	СтруктураПлатежныхРеквизитов.Вставить("БикБанкаПолучателя",				"БИК");
	СтруктураПлатежныхРеквизитов.Вставить("СчетБанкаПолучателя",			"КоррСчет");
	
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыСчета, СтруктураПлатежныхРеквизитов);
	
	БанковскиеРеквизиты = Новый Структура();
	БанковскиеРеквизиты.Вставить("НомерСчета",					СокрЛП(СтруктураПлатежныхРеквизитов.НомерСчетаПолучателя));
	БанковскиеРеквизиты.Вставить("НаименованиеБанка",			СокрЛП(СтруктураПлатежныхРеквизитов.НаименованиеБанкаПолучателя));
	БанковскиеРеквизиты.Вставить("БИКБанка",					СокрЛП(СтруктураПлатежныхРеквизитов.БикБанкаПолучателя));
	БанковскиеРеквизиты.Вставить("КорреспондентскийСчетБанка",	СокрЛП(СтруктураПлатежныхРеквизитов.СчетБанкаПолучателя));
	
	Возврат БанковскиеРеквизиты;
	
КонецФункции

Процедура ЗаполнитьРеквизитыЛицевогоСчета(ЛицевойСчет, РеквизитыЛицевогоСчета)
	Если Не ЗначениеЗаполнено(РеквизитыЛицевогоСчета) И ЗначениеЗаполнено(ЛицевойСчет) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	РеквизитыЛицевыхСчетов.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
		               |ГДЕ
		               |	РеквизитыЛицевыхСчетов.Владелец = &ЛицевойСчет
		               |	И РеквизитыЛицевыхСчетов.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			РеквизитыЛицевогоСчета = Выборка.Ссылка;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

Процедура ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_2019(ТаблицаУчастников, ПутьКУчастнику = "")
	
	ПутьКПолю = ?(ЗначениеЗаполнено(ПутьКУчастнику), ПутьКУчастнику + ".", "");
	
	Для каждого СтрокаТаблицы Из ТаблицаУчастников Цикл
		
		Сведения = СтрокаТаблицы.СведенияОбУчастнике;
		Если Не ЗначениеЗаполнено(Сведения) Тогда
			Продолжить;
		КонецЕсли;
		
		Участник = ?(ЗначениеЗаполнено(ПутьКУчастнику), СтрокаТаблицы[ПутьКУчастнику], СтрокаТаблицы);
		
		Если Участник.ТипУчастника.Свойство("ЮЛ") Тогда
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ЮЛ.НаименованиеОрганизации", Сведения.Ссылка, "Объект.НаименованиеПолное");
				
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ЮЛ.ИНН", Сведения.Ссылка, "Объект.ИНН");
				
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ЮЛ.КПП", Сведения.Ссылка, "Объект.КПП");
				
		ИначеЕсли Участник.ТипУчастника.Свойство("ИЛ") Тогда
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИЛ.НаименованиеОрганизации", Сведения.Ссылка, "Объект.НаименованиеПолное");
				
		ИначеЕсли Участник.ТипУчастника.Свойство("ИП") Тогда
			
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИП.ИНН", Сведения.Ссылка, "Объект.ИНН");
				
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИП.Фамилия", Сведения.Ссылка, "Объект.НаименованиеПолное");
				
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИП.Имя", Сведения.Ссылка, "Объект.НаименованиеПолное");
				
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "ТипУчастника.ИП.Отчество", Сведения.Ссылка, "Объект.НаименованиеПолное");
				
			Если ТипЗнч(Сведения.Ссылка) = Тип("СправочникСсылка.Организации") Тогда
				
				ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
					ПутьКПолю + "ТипУчастника.ИП.СвидетельствоОГосРегистрации", Сведения.Ссылка, "Объект.СвидетельствоСерияНомер");
				
			КонецЕсли;
			
		КонецЕсли;
		
		ПостфиксПоляАдрес = ?(ТипЗнч(Сведения.Ссылка) = Тип("СправочникСсылка.Контрагенты"), "Контрагента", "Организации");
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
			ПутьКПолю + "Адрес.АвтоматическиЗаполняемый", Сведения.Ссылка, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес);
			
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
			ПутьКПолю + "КонтактныеСведения.Телефон", Сведения.Ссылка);
			
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
			ПутьКПолю + "КонтактныеСведения.ЭлектроннаяПочта", Сведения.Ссылка);
			
		НомерСчета = "";
		Если Сведения.Свойство("НомерСчета", НомерСчета) И ЗначениеЗаполнено(НомерСчета) Тогда
			
			Если Сведения.Свойство("БанковскийСчетСсылка") Тогда
				ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
					ПутьКПолю + "БанковскиеРеквизиты.НомерСчета", Сведения.БанковскийСчетСсылка, "Объект.НомерСчета");
			КонецЕсли;
				
			Банк = ""; БИК = ""; КоррСчет = "";
			Если Сведения.Свойство("Банк", Банк) И ЗначениеЗаполнено(Банк) Тогда
				Если Сведения.Свойство("БанкСсылка") Тогда
					ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
						ПутьКПолю + "БанковскиеРеквизиты.НаименованиеБанка", Сведения.БанкСсылка, "Объект.Наименование");
				КонецЕсли;
			КонецЕсли;
			Если Сведения.Свойство("БИК", БИК) И ЗначениеЗаполнено(БИК) Тогда
				Если Сведения.Свойство("БанкСсылка") Тогда
					ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
						ПутьКПолю + "БанковскиеРеквизиты.БИКБанка", Сведения.БанкСсылка, "Объект.Код");
				КонецЕсли;
			КонецЕсли;
			Если Сведения.Свойство("КоррСчет", КоррСчет) И ЗначениеЗаполнено(КоррСчет) Тогда
				Если Сведения.Свойство("БанкСсылка") Тогда
					ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
						ПутьКПолю + "БанковскиеРеквизиты.КорреспондентскийСчетБанка", Сведения.БанкСсылка, "Объект.КоррСчет");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		КодПоОКПО = "";
		Если Сведения.Свойство("КодПоОКПО", КодПоОКПО) И ЗначениеЗаполнено(КодПоОКПО) Тогда
			ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(СтрокаТаблицы,
				ПутьКПолю + "КодОКПО", Сведения.Ссылка, "Объект.КодПоОКПО");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПоТорг12ПродавецУПД_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	НетЗамечанийКДокументу = Документы[СсылкаНаОбъект.Метаданные().Имя].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	

	ДанныеДляЭД = Новый Структура;
	ДанныеДляПечати = Документы[СсылкаНаОбъект.Метаданные().Имя].ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
	РеквизитыШапки = ДанныеДляПечати[0].Выбрать();
	ТабличнаяЧасть = ДанныеДляПечати[1].Выгрузить();
	ТаблицаКодовМаркировки = ДанныеДляПечати[2].Выгрузить();
	ТаблицаНомеровПрослеживаемости = ДанныеДляПечати[3].Выгрузить();
	ДобавитьИДНоменклатурыВТаблицу(ТабличнаяЧасть);
	
	ДополнительныеПараметрыДокументаРеализации = Новый Структура();
	ДополнительныеПараметрыДокументаРеализации.Вставить("ТаблицаНомеровПрослеживаемости", ТаблицаНомеровПрослеживаемости);
	
	ДобавитьКэшСведенийОПрослеживаемостиПоТорг12ПродавецУПД_2019(ДополнительныеПараметрыДокументаРеализации, ТабличнаяЧасть);	
	
	РеквизитыШапки.Следующий();
	
	Если Не ЗначениеЗаполнено(РеквизитыШапки.Валюта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ВалютаДокумента");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(РеквизитыШапки.Валюта, 
			"Объект.Код");
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыШапки.ВалютаКод, ПараметрыОбработкиОшибок);
	ВалютаРегУчета = ?(ЗначениеЗаполнено(РеквизитыШапки.ВалютаКод), РеквизитыШапки.ВалютаКод, Константы.ВалютаРегламентированногоУчета.Получить());

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДляПечати(СсылкаНаОбъект, РеквизитыШапки.Номер));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  РеквизитыШапки.Дата);
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Контракт = ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(РеквизитыШапки.Договор);
	ЕстьЭлектронноеАктирование = ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС()
		И ЗначениеЗаполнено(Контракт)
		И ЭлектронноеАктированиеЕИС.ОбменПоОрганизацииВключен(РеквизитыШапки.Организация);
	ДанныеДляЭД.Вставить("ЕстьЭлектронноеАктирование", ЕстьЭлектронноеАктирование);
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаОтгрузкиТоваров", РеквизитыШапки.Дата);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки", РеквизитыШапки.ДокументОснование);

	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Если ЕстьЭлектронноеАктирование Тогда
		ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеЭлектронногоАктирования(ДанныеДляЭД, РеквизитыШапки);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ЭтоЭлектронноеАктированиеЕИС = Ложь;
	ДанныеЭлектронногоАктирования = Неопределено;
	Если ДанныеДляЭД.Свойство("ДанныеЭлектронногоАктирования") И ЕстьЭлектронноеАктирование Тогда
		ЭтоЭлектронноеАктированиеЕИС = Истина;
		ДанныеЭлектронногоАктирования = ДанныеДляЭД.ДанныеЭлектронногоАктирования;
		ДанныеПриложенияЕИС = ЭлектронноеАктированиеЕИС.НовыеДанныеПриложенияКТитулуПродавцаУПД();
		ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеДереваДляЭлектронногоАктированияЕИС(ДеревоДанных,
			ДанныеЭлектронногоАктирования,
			РеквизитыШапки, //ДанныеДляЭД.Шапка[0]
			ДанныеПриложенияЕИС,
			Ложь);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС

	Если ЭтоЭлектронноеАктированиеЕИС Тогда
		// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		СоставительДокумента = ЭлектронноеАктированиеБГУ.СоставительДокумента(РеквизитыШапки.Организация);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СоставительДокумента);
		// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	КонецЕсли;
	
	//доп. данные маркировки
	Если РеквизитыШапки.СведенияОВыбытииМаркированныхТоваров > 0 Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОВыбытииМаркированныхТоваров",  РеквизитыШапки.СведенияОВыбытииМаркированныхТоваров);
	КонецЕсли;
	
	Если СтруктураЭД.Функция = "ДОП" Тогда //ДОПУПД
		ДанныеАктированияДокументаРеализации = Новый Структура;
		ДанныеАктированияДокументаРеализации.Вставить("ЕстьЭлектронноеАктирование", ЕстьЭлектронноеАктирование);
		Если ЕстьЭлектронноеАктирование Тогда
			Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
				ТаблицаАктированияДокументаРеализации = СсылкаНаОбъект.ДанныеДляАктированияЕИС.Выгрузить();
				ДанныеАктированияДокументаРеализации.Вставить("ДанныеШапки", РеквизитыШапки); //ДанныеДляЭД.Шапка[0]
				ДанныеАктированияДокументаРеализации.Вставить("СсылкаНаОбъект", СсылкаНаОбъект);
				ДанныеАктированияДокументаРеализации.Вставить("ДанныеЭлектронногоАктирования", ДанныеДляЭД.ДанныеЭлектронногоАктирования);
				ДанныеАктированияДокументаРеализации.Вставить("ДанныеПриложенияЕИС", ДанныеПриложенияЕИС);
				ДанныеАктированияДокументаРеализации.Вставить("ТаблицаАктирования", ТаблицаАктированияДокументаРеализации);
			КонецЕсли;
		КонецЕсли;
		
		ДанныеАктированияЕИС = ДанныеАктированияДокументаРеализации;
		
		СтороныСделки = УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СсылкаНаОбъект);
		
		Если СтороныСделки <> Неопределено Тогда
			РасчетныеСчета = Неопределено;
			ЗаполнитьРасчетныеСчетаУПД(РасчетныеСчета, СсылкаНаОбъект);
			
			// Продавец
			ЗаполнитьДанныеУчастникаУПД_2019(
				ДеревоДанных,
				"СведенияОПродавце",
				"СведенияОбУчастнике", 
				СтороныСделки.Продавец.Ссылка,
				РеквизитыШапки.Дата,
				Ложь,
				РасчетныеСчета.Продавец,
				СтороныСделки,
				,
				ДанныеЭлектронногоАктирования);
			
			// Покупатель
			ЗаполнитьДанныеУчастникаУПД_2019(
				ДеревоДанных,
				"СведенияОПокупателе",
				"СведенияОбУчастнике",
				СтороныСделки.Покупатель.Ссылка,
				РеквизитыШапки.Дата,
				Ложь,
				РасчетныеСчета.Покупатель,
				СтороныСделки,
				,
				ДанныеЭлектронногоАктирования);
				
			// Грузоотправитель
			ОнЖе = СтороныСделки.Грузоотправитель.СовпадаетСПродавцом;
			
			Если ОнЖе Тогда
				ТаблицаГрузоотправителей = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
					ДеревоДанных, "СведенияОГрузоотправителе");
					
				ТаблицаГрузоотправителей.Колонки.Добавить("СведенияОбУчастнике");
				
				ТаблицаГрузоотправителей.Добавить().ОнЖе = ОнЖе;
				
				ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаГрузоотправителей, "СведенияОГрузоотправителе");
			Иначе	
				ЗаполнитьДанныеУчастникаГрузооборотаУПД_2019(
					ДеревоДанных,
					"СведенияОГрузоотправителе",
					"СведенияОбУчастнике",
					СтороныСделки.Грузоотправитель.Ссылка,
					РеквизитыШапки.Дата,
					Ложь,
					РасчетныеСчета.Грузоотправитель,
					ОнЖе,
					СтороныСделки,
					ДанныеЭлектронногоАктирования);
			КонецЕсли;
			
			// Грузополучатель
			ЗаполнитьДанныеУчастникаГрузооборотаУПД_2019(
				ДеревоДанных,
				"СведенияОГрузополучателе",
				"СведенияОбУчастнике",
				СтороныСделки.Грузополучатель.Ссылка,
				РеквизитыШапки.Дата,
				Ложь,
				РасчетныеСчета.Грузополучатель,
				,
				СтороныСделки,
				ДанныеЭлектронногоАктирования);
		Иначе
			ОнЖе = Ложь;
			Если ЗначениеЗаполнено(РеквизитыШапки.Грузоотправитель) Тогда
				Если РеквизитыШапки.Грузоотправитель.ИНН = РеквизитыШапки.Организация.ИНН Тогда
					ОнЖе = Истина;
				Иначе
					ЗаполнитьДанныеУчастникаГрузооборотаУПД_2019(ДеревоДанных, "СведенияОГрузоотправителе", "СведенияОбУчастнике",
						РеквизитыШапки.Грузоотправитель, РеквизитыШапки.Дата, Ложь, РеквизитыШапки.ЛицевойСчет, ОнЖе,,ДанныеЭлектронногоАктирования);
				КонецЕсли;	
			Иначе
				ОнЖе = Истина;
			КонецЕсли;
			Если ОнЖе Тогда
				ТаблицаГрузоотправителей = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
					ДеревоДанных, "СведенияОГрузоотправителе");
				ТаблицаГрузоотправителей.Колонки.Добавить("СведенияОбУчастнике");
			
				ТаблицаГрузоотправителей.Добавить().ОнЖе = ОнЖе;
