// Создание элементов справочников

// Находит ссылку на объект ИБ по типу, ИД и дополнительным реквизитам
// 
// Параметры:
//  ТипОбъекта - Строка, идентификатор типа объекта, который необходимо найти,
//  ИДОбъекта - Строка, идентификатор объекта заданного типа,
//  ДополнительныеРеквизиты - Структура, набор дополнительных полей объекта для поиска.
//
Процедура НайтиСсылкуНаОбъект(ТипОбъекта, Результат, ИдОбъекта = "", ДополнительныеРеквизиты = Неопределено) Экспорт
	
	Результат = Неопределено;

	Если ТипОбъекта = "Валюты" ИЛИ ТипОбъекта = "Банки" Тогда
		Результат = НайтиСсылкуНаОбъектПоРеквизиту(ТипОбъекта, "Код", ИдОбъекта);
	ИначеЕсли ТипОбъекта = "ЕдиницыИзмерения" Тогда
		Если ЗначениеЗаполнено(ИдОбъекта) Тогда
			ИдОбъекта = СокрЛП(ИдОбъекта);
			Результат = НайтиСсылкуНаОбъектПоРеквизиту("КлассификаторЕдиницИзмерения", "Код", ИдОбъекта);
		Иначе
			Результат = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
		КонецЕсли;
	ИначеЕсли (ТипОбъекта = "Контрагенты" ИЛИ ТипОбъекта = "Организации") И ЗначениеЗаполнено(ДополнительныеРеквизиты) Тогда
		ПараметрПоиска = "";
		ИНН = "";
		КПП = "";
		
		Если ДополнительныеРеквизиты.Свойство("ИНН") Тогда
			ИНН = ДополнительныеРеквизиты.ИНН;
		КонецЕсли;
		
		Если ДополнительныеРеквизиты.Свойство("КПП") Тогда
			КПП = ДополнительныеРеквизиты.КПП;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИНН) Тогда
			Результат = Неопределено;
			СсылкаНаОбъектПоИННКПП(ТипОбъекта, ИНН, КПП, Результат);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Результат) И ДополнительныеРеквизиты.Свойство("Наименование", ПараметрПоиска) Тогда
			Результат = НайтиСсылкуНаОбъектПоРеквизиту(ТипОбъекта, "Наименование", ПараметрПоиска);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Результат) И ТипОбъекта = "Контрагенты" Тогда
			Если ДополнительныеРеквизиты.Свойство("СоздатьКонтрагентаПриОтсутствии") Тогда
				Если ДополнительныеРеквизиты.СоздатьКонтрагентаПриОтсутствии Тогда
					Результат = СоздатьКонтрагента(ИНН, КПП, ПараметрПоиска);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = "Номенклатура" И ЗначениеЗаполнено(ДополнительныеРеквизиты) Тогда
		ПараметрПоиска = "";
		Контрагент = "";
		Наименование = ДополнительныеРеквизиты.Наименование;
		Если ДополнительныеРеквизиты.Свойство("Идентификатор", ПараметрПоиска)
			И ДополнительныеРеквизиты.Свойство("Владелец", Контрагент) Тогда // по Идентификатору
			Результат = НайтиСсылкуНаНоменклатуруПоставщикаПоИдентификатору(ПараметрПоиска, Контрагент);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Результат) И ДополнительныеРеквизиты.Свойство("Артикул", ПараметрПоиска) Тогда // по Коду номенклатуры своей компании
			Результат = НайтиСсылкуНаОбъектПоРеквизиту(ТипОбъекта, "Код", ПараметрПоиска);
		КонецЕсли;
	ИначеЕсли ТипОбъекта = "ВидыКонтактнойИнформации" Тогда
		Результат = Неопределено;
		Если ИдОбъекта = "ТелефонКонтрагента" Тогда
			Результат = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты;
		ИначеЕсли ИдОбъекта = "EmailКонтрагента" Тогда
			Результат = Справочники.ВидыКонтактнойИнформации.EmailКонтрагенты;
		ИначеЕсли ИдОбъекта = "ДругаяИнформацияКонтрагента" Тогда
			Результат = Справочники.ВидыКонтактнойИнформации.ДругаяИнформацияКонтрагенты;
		ИначеЕсли ИдОбъекта = "ФактАдресКонтрагента" Тогда
			Результат = Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты;
		ИначеЕсли ИдОбъекта = "ЮрАдресКонтрагента" Тогда
			Результат = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
		ИначеЕсли ИдОбъекта = "EmailКонтактногоЛица" Тогда
			Результат = Справочники.ВидыКонтактнойИнформации.EmailОтветственногоЛицаКонтрагета;
		Иначе
			ПредопределенныеЭлементы = Метаданные.Справочники.ВидыКонтактнойИнформации.ПолучитьИменаПредопределенных();
			Если НЕ (ПредопределенныеЭлементы.Найти(ИдОбъекта) = Неопределено) Тогда
				Результат = Справочники.ВидыКонтактнойИнформации[ИдОбъекта];
			КонецЕсли;	
		КонецЕсли;	
	ИначеЕсли ТипОбъекта = "СтраныМира" Тогда
		Результат = НайтиСсылкуНаОбъектПоРеквизиту("СтраныМира", "Код", ИдОбъекта);
	ИначеЕсли ТипОбъекта = "БанковскиеСчетаКонтрагентов" Тогда
		Если ДополнительныеРеквизиты.Свойство("Владелец") Тогда
			Результат = СчетКонтрагента(ДополнительныеРеквизиты.Владелец, ДополнительныеРеквизиты.НомерСчета);
		Иначе
			Результат = СчетКонтрагента(Справочники.Контрагенты.ПустаяСсылка(), ДополнительныеРеквизиты.НомерСчета);
		КонецЕсли;
	ИначеЕсли ТипОбъекта = "БанковскиеСчетаОрганизаций" Тогда
		Организация = Справочники.Организации.ПустаяСсылка();
		Если ДополнительныеРеквизиты.Свойство("Владелец") Тогда
			Организация = ДополнительныеРеквизиты.Владелец;
		КонецЕсли;	
		Результат = СчетОрганизации(Организация, ДополнительныеРеквизиты.НомерСчета);
	ИначеЕсли ВРег(ТипОбъекта) = ВРег("ДоговорыКонтрагентов") Тогда
		Результат = ДоговорКонтрагентаПоРеквизитам(ДополнительныеРеквизиты);
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьКонтрагента(ИНН, КПП, Наименование) 
	
	РеквизитыКонтрагента = Новый Структура();
	РеквизитыКонтрагента.Вставить("ИНН", ИНН);
	РеквизитыКонтрагента.Вставить("КПП", КПП);
	РеквизитыКонтрагента.Вставить("Наименование", Наименование);
	
	СтруктураРеквизитов = Новый Структура();
	СтруктураРеквизитов.Вставить("РеквизитыКонтрагента", РеквизитыКонтрагента);
	СтруктураРеквизитов.Вставить("ИНН", ИНН);
	СтруктураРеквизитов.Вставить("КПП", КПП);
	СтруктураРеквизитов.Вставить("Наименование", Наименование);
	
	Результат = Справочники.Контрагенты.ПустаяСсылка();
	
	СоздатьКонтрагентаПоРеквизитам(СтруктураРеквизитов, Результат, Ложь);

	Возврат Результат;
	
КонецФункции	

// Находит ссылку на справочник по переданному реквизиту.
//
// Параметры:
//  ИмяСправочника - Строка, имя справочника, объект которого надо найти,
//  ИмяРеквизита - Строка, имя реквизита, по которому будет проведен поиск,
//  ЗначРеквизита - произвольное значение, значение реквизита, по которому будет проведен поиск,
//  Владелец - Ссылка на владельца для поиска в иерархическом справочнике.
//
Функция НайтиСсылкуНаОбъектПоРеквизиту(ИмяСправочника, ИмяРеквизита, ЗначРеквизита, Владелец = Неопределено) Экспорт
	
	Результат = Неопределено;
	
	ОбъектМетаданных = Метаданные.Справочники[ИмяСправочника];
	Если НЕ ОбщегоНазначения.ЭтоСтандартныйРеквизит(ОбъектМетаданных.СтандартныеРеквизиты, ИмяРеквизита)
		И НЕ ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИскСправочник.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК ИскСправочник
	|ГДЕ
	|	ИскСправочник." + ИмяРеквизита + " = &ЗначРеквизита";
	
	Если ЗначениеЗаполнено(Владелец) Тогда
		Запрос.Текст = Запрос.Текст + " И ИскСправочник.Владелец = &Владелец";
		Запрос.УстановитьПараметр("Владелец", Владелец);
	КонецЕсли;
	Запрос.УстановитьПараметр("ЗначРеквизита", ЗначРеквизита);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит элемент справочника по реквизитам ИНН и КПП
// Если элемент не найден возвращаем Неопределено
// Параметры:
//  ТипОбъекта - Строка, имя справочника в метаданных;
//  ИНН - строка;
//  КПП - строка;
//  Организация - Организация, ссылка на элемент справочника организации
//
// Возвращаемое значение:
//  Результат - ссылка на справочник или неопределено
//
Процедура СсылкаНаОбъектПоИННКПП(ТипОбъекта, ИНН, КПП, Результат, ДатаСведений = Неопределено, ЮрФизЛицо = "") Экспорт
	
	Результат = Неопределено;
	
	Если ИНН = "" Тогда
		Возврат; 	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если ТипОбъекта = "Организации" Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка,
		|	УчетныеЗаписиЭДО.ИдентификаторЭДО КАК ИдентификаторЭДО,
		|	Организации.ПометкаУдаления КАК ПометкаУдаления,
		|	ЕстьNULL(НастройкиОбменаЕИСДляЗаказчиков.ОбменВключен, ЛОЖЬ) КАК ОбменСЕИСВключен
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеЗаписиЭДО КАК УчетныеЗаписиЭДО
		|		ПО (Организации.Ссылка = УчетныеЗаписиЭДО.Организация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиОбменаЕИСДляЗаказчиков КАК НастройкиОбменаЕИСДляЗаказчиков
		|		ПО (Организации.Ссылка = НастройкиОбменаЕИСДляЗаказчиков.Организация)
		|ГДЕ
		|	Организации.ИНН = &ИНН
		|	И Организации.УчетПереданныхПолномочий = ЛОЖЬ";
		Если ЗначениеЗаполнено(КПП) Тогда
			ТекстЗапроса = ТекстЗапроса + " И
				|	Организации.КПП = &КПП";
			Запрос.УстановитьПараметр("КПП", КПП);
		КонецЕсли;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ИНН", ИНН);
		ОрганизацииОтбора = Запрос.Выполнить().Выгрузить();
		Если ОрганизацииОтбора.Количество() = 1 Тогда
			Результат = ОрганизацииОтбора[0].Ссылка;
		ИначеЕсли ОрганизацииОтбора.Количество() > 1 Тогда
			Для Каждого ТекСтрока Из ОрганизацииОтбора Цикл
				ТекОрганизация = ТекСтрока.Ссылка;	
				Если ЗначениеЗаполнено(ТекСтрока.ИдентификаторЭДО) И ТекСтрока.ПометкаУдаления = Ложь  Тогда
					Результат = ТекСтрока.Ссылка;
					
					Прервать;
				КонецЕсли;	
				Если ТекСтрока.ОбменСЕИСВключен И ТекСтрока.ПометкаУдаления = Ложь  Тогда
					Результат = ТекСтрока.Ссылка;
					
					Прервать;
				КонецЕсли;	
			КонецЦикла;
			Если НЕ ЗначениеЗаполнено(Результат) Тогда
				Для Каждого ТекСтрока Из ОрганизацииОтбора Цикл
					ТекОрганизация = ТекСтрока.Ссылка;	

					Если ТекСтрока.ПометкаУдаления = Ложь Тогда
						Результат = ТекСтрока.Ссылка;
					
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
				
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(Результат) Тогда
				Результат = ОрганизацииОтбора[0].Ссылка;
			КонецЕсли;	
		КонецЕсли;	
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка
		|ИЗ
		|	Справочник." + ТипОбъекта + " КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.ПометкаУдаления = Ложь";
		Если ЗначениеЗаполнено(КПП) Тогда
			ТекстЗапроса = ТекстЗапроса + " И
				|	Контрагенты.КПП = &КПП";
		КонецЕсли;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Если ЗначениеЗаполнено(КПП) Тогда
			Запрос.УстановитьПараметр("КПП", КПП);
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		Иначе
			Если (ТипОбъекта = "Контрагенты") И ЗначениеЗаполнено(КПП) Тогда
				ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				               |	КонтрагентыКППИстория.Ссылка КАК Ссылка
				               |ИЗ
				               |	Справочник.Контрагенты.КППИстория КАК КонтрагентыКППИстория
				               |ГДЕ
				               |	КонтрагентыКППИстория.КПП = &КПП
				               |	И КонтрагентыКППИстория.Ссылка.ИНН = &ИНН";	
				Запрос.Текст = ТекстЗапроса;
				Запрос.УстановитьПараметр("ИНН", ИНН);
				Запрос.УстановитьПараметр("КПП", КПП);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Результат = Выборка.Ссылка;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

// Заполняет реквизиты объекта данными из структуры реквизитов.
//
// Параметры:
//  СтруктураРеквизитов - структура - перечень значений реквизитов
//
// Возвращаемое значение:
//  Контрагент.Ссылка - ссылка на справочник контрагентов
//
Процедура ЗаполнитьРеквизитыКонтрагента(СтруктураРеквизитов, Результат) Экспорт
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(СтруктураРеквизитов.Контрагент) Тогда
		Контрагент = СтруктураРеквизитов.Контрагент.ПолучитьОбъект();
		Контрагент.Наименование = СтруктураРеквизитов.Наименование;
		Контрагент.НаименованиеПолное = СтруктураРеквизитов.Наименование;
		ИНН_КПП        = СтруктураРеквизитов.ИНН_КПП;
		Контрагент.ИНН = Сред(ИНН_КПП, 1, Найти(ИНН_КПП, "/") - 1);
		Контрагент.КПП = Сред(ИНН_КПП, Найти(ИНН_КПП, "/") + 1);
		Если СтрДлина(СокрЛП(Контрагент.ИНН))>10 Тогда
			Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо;
		Иначе
			Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо;
		КонецЕсли;
		Контрагент.Записать();
		
		Результат = Контрагент.Ссылка;
	Иначе
		Результат = Справочники.Контрагенты.ПустаяСсылка();
		СоздатьКонтрагентаПоРеквизитам(СтруктураРеквизитов, Результат, Ложь);
	КонецЕсли;
	
КонецПроцедуры

// Заполняет структуру реквизитов товара
//
// Параметры:
//  РеквизитыНоменклатуры - Структура, содержащая параметры поиска 
//  СтруктураВозврата -Структура содержащая ссылки на номенклатуру, характеристику, упаковку
//  ИД - идентификатор обмена ЭД
//
Процедура ПолучитьРеквизитыТовара(РеквизитыНоменклатуры, СтруктураВозврата, ИД = Неопределено) Экспорт
	
	ПараметрПоиска = "";
	НоменклатураПоставщика = Неопределено;
	Если РеквизитыНоменклатуры.Свойство("НоменклатураПоставщика", НоменклатураПоставщика) Тогда
		СтруктураВозврата.Номенклатура = НоменклатураПоставщика.Номенклатура;
	Иначе
		СтруктураВозврата.Номенклатура = Неопределено;
	КонецЕсли;
	
	СтруктураВозврата.Характеристика = Неопределено;
	СтруктураВозврата.Упаковка = Неопределено;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПолучитьИДКонтрагента.
Процедура ПолучитьИДКонтрагента(Контрагент, ВидКонтрагента, ИдКонтрагента) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат
	КонецЕсли;
	
	Если ВРег(ВидКонтрагента) = ВРег("Организация") Тогда
		ИдКонтрагента = Контрагент.ИНН + "_" + Контрагент.КПП;
	ИначеЕсли ВРег(ВидКонтрагента) = ВРег("Контрагент") Тогда
		ИдКонтрагента = Контрагент.ИНН + "_" + Контрагент.КПП;
	КонецЕсли;
	
КонецПроцедуры


