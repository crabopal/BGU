		КонецЕсли;		
		
		ДокументОбъект.СоставНФА.Очистить();
		Если ДанныеЗаполненияШапки.Свойство("СоставНФА") И ЗначениеЗаполнено(ДанныеЗаполненияШапки.СоставНФА) Тогда
			ДозаполнитьСторноИсправительногоСчетаФактурыПолученного(ДанныеЗаполненияШапки.СоставНФА, СчетФактураПолученный, ИсправлениеСФ);
			ДокументОбъект.СоставНФА.Загрузить(ДанныеЗаполненияШапки.СоставНФА);
		КонецЕсли;
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры	

//создание УКД
Процедура НайтиСоздатьУниверсальныйКорректировочныйДокумент(ДеревоДанных, СсылкиНаВладельцев = Неопределено, СпособОбработки, ОписаниеОшибки) Экспорт
	
	Записывать = Истина;
	ВидПервичногоДокумента = НСтр("ru = 'Универсальный корректировочный документ'");
	
	ПервичныйДокумент = Неопределено;
	СчетФактура = Неопределено;
	
	ДокументыУчета = Новый Массив;
	
	НайтиСоздатьУКДДокументОбИзмененииСтоимости(ДеревоДанных, ПервичныйДокумент, Записывать);
	Если ПервичныйДокумент <> Неопределено Тогда
		ДокументыУчета.Добавить(ПервичныйДокумент);
	КонецЕсли;	
	
	// Заполним основание в СФ
	ДокументыОснованияСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		ДокументыОснованияСчетаФактуры = "";
	КонецЕсли;
	
	Если ПервичныйДокумент <> Неопределено Тогда
		ДокументыОснованияСчетаФактуры = Новый Массив;
		ДокументыОснованияСчетаФактуры.Добавить(ПервичныйДокумент);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", ДокументыОснованияСчетаФактуры);
	КонецЕсли;
	
	НайтиСоздатьУКДСчетФактуру(ДеревоДанных, СчетФактура, Записывать, ВидПервичногоДокумента);
	ДокументыУчета.Добавить(СчетФактура);
	
	СсылкиНаВладельцев = ДокументыУчета;
	
КонецПроцедуры	

Процедура НайтиСоздатьУКДДокументОбИзмененииСтоимости(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина) Экспорт
	
	ТекстСообщения = НСтр("ru = 'Заполнение документа изменения стоимости на основе ЭД не предумотрено. Следует вручную ввести документ сторно для изменяемого документа.'");
	
	ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
		2, УровеньЖурналаРегистрации.Ошибка, , );
		
КонецПроцедуры	

Процедура НайтиСоздатьУКДСчетФактуру(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина, ВидПервичногоДокумента = "")  Экспорт
	
	ДанныеЗаполненияШапки = Новый Структура;
	
	ДокументыОснованияСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	НомерДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДатаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента");
	НомерИсходногоДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсходногоДокумента");
	ДатаИсходногоДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсходногоДокумента");
	
	ДанныеЗаполненияШапки.Вставить("ДатаПолучения", ТекущаяДатаСеанса());
	
	ДанныеЗаполненияШапки.Вставить("НомерИсправления", ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления"));
	ДанныеЗаполненияШапки.Вставить("ДатаИсправления", ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления"));
	Если ЗначениеЗаполнено(ДанныеЗаполненияШапки.НомерИсправления)
		И ЗначениеЗаполнено(ДанныеЗаполненияШапки.ДатаИсправления) Тогда
		
		ДанныеЗаполненияШапки.Вставить("Исправление", Истина);
	КонецЕсли;
	
	НомерИсходногоДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсходногоДокумента");
	ДанныеЗаполненияШапки.Вставить("НомерИсходногоДокумента", НомерИсходногоДокумента);
	ДатаИсходногоДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсходногоДокумента");	
	ДанныеЗаполненияШапки.Вставить("ДатаИсходногоДокумента", ДатаИсходногоДокумента);
	
	Если ЗначениеЗаполнено(ДанныеЗаполненияШапки.НомерИсходногоДокумента)
		И ЗначениеЗаполнено(ДанныеЗаполненияШапки.ДатаИсходногоДокумента) Тогда
		
		ДанныеЗаполненияШапки.Вставить("Корректировочный", Истина);
		ДанныеЗаполненияШапки.Вставить("НомерИсправленияИсходногоДокумента",
			ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправленияИсходногоДокумента"));
		ДанныеЗаполненияШапки.Вставить("ДатаИсправленияИсходногоДокумента",
			ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправленияИсходногоДокумента"));
	КонецЕсли;
		
	ВалКод = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод");
	Если НЕ ВалКод = "643" Тогда
		ДанныеЗаполненияШапки.Вставить("ВИностраннойВалюте", Истина);
	КонецЕсли;
	Валюта = Справочники.Валюты.ПустаяСсылка();
	НайтиСсылкуНаОбъект("Валюты", Валюта, ВалКод);
	ДанныеЗаполненияШапки.Вставить("ВалютаДокумента", Валюта);
	
	// Сведения о поставщике.
	ИННПоставщика = ""; КПППоставщика = "";
	ВидУчастника = "СведенияОПродавце";
	
	Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
		
		ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
		КПППоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
		ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
		
	ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
		
		ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
		Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
		Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
		Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
		
		ПредставлениеПоставщика = Фамилия + " " + Имя + " " + Отчество; 
	ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
		
		ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
		
	ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
		
		ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
	КонецЕсли;
	
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	СсылкаНаОбъектПоИННКПП("Контрагенты", ИННПоставщика, КПППоставщика, Контрагент);
	ДанныеЗаполненияШапки.Вставить("Контрагент", Контрагент);
	
	// Сведения о покупателе.
	ИННПокупателя = ""; КПППокупателя = "";
	ВидУчастника = "СведенияОПокупателе";
	Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
		
		ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
		КПППокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
		ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
		
	ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
		
		ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
		Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
		Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
		Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
		
		ПредставлениеПокупателя = Фамилия + " " + Имя + " " + Отчество; 
	ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
		
		ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
		
	ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
		
		ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
	КонецЕсли;
	Организация = Справочники.Организации.ПустаяСсылка();
	СсылкаНаОбъектПоИННКПП("Организации", ИННПокупателя, КПППокупателя, Организация);
	ДанныеЗаполненияШапки.Вставить("Организация", Организация);
	
	// Поиск и заполнения договора контрагента.
	Договор = Справочники.Договоры.ПустаяСсылка();
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеКорректировки", "ПолныйПуть");
	Если Не ОснованияОтгрузки = Неопределено Тогда
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеКорректировки.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ДатаИзСтроки(ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, 
					"ОснованиеКорректировки.НомерСтроки.ДокументДата"));
				
				СвойстваДоговора = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация", ДоговорНомер, ДоговорДата, Контрагент, Организация);
				
				Договор = Справочники.Договоры.ПустаяСсылка();
				НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , СвойстваДоговора);
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Договор = ДоговорПоНастройкеЭДО(Контрагент, Организация);
	КонецЕсли;	
		
	ДанныеЗаполненияШапки.Вставить("Договор", Договор);
	
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть").Строки;
	Если ЗначениеЗаполнено(СведенияОТоварах) Тогда
		ТаблицаТоваров = Документы.КорректировочныйСчетФактураПолученный.ПустаяСсылка().СоставНФА.ВыгрузитьКолонки();
		Для Каждого ТекТовар Из СведенияОТоварах Цикл
			СтрокаТаблицы = ТаблицаТоваров.Добавить();
			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", ЕдиницаИзмерения, 
				ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод"));

			СтрокаТаблицы.ЕдиницаИзмерения = ЕдиницаИзмерения; 	
			КоличествоДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.КоличествоДоКорректировки");
			СтрокаТаблицы.КоличествоДоИзменения = КоличествоДоИзменения;
			СтрокаТаблицы.Количество = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.Количество");
			ЦенаДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмеренияДоКорректировки");
			Цена = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.ЦенаЗаЕдиницуИзмерения");
			СтрокаТаблицы.СуммаДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалогаДоКорректировки");
			СтрокаТаблицы.Сумма = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
			СтавкаНДСДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавкаДоКорректировки");
			
			СтавкаНДС = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
			
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
			КонецЕсли;	
			
			СтрокаТаблицы.СтавкаНДСДоИзменения = СтавкаНДСДоИзменения;
			СтрокаТаблицы.СтавкаНДС = СтавкаНДС;
			СтрокаТаблицы.СуммаНДСДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаНалогаДоКорректировки");
			СтрокаТаблицы.СуммаНДС = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаНалога");
			СтрокаТаблицы.ВсегоДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогомДоКорректировки");
			СтрокаТаблицы.Всего = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
			
			РазницаСуммы = СтрокаТаблицы.Сумма - СтрокаТаблицы.СуммаДоИзменения;
			Если РазницаСуммы > 0 Тогда
				СтрокаТаблицы.СуммаУвеличение = РазницаСуммы;
				СтрокаТаблицы.СуммаУменьшение = 0;
			Иначе
				СтрокаТаблицы.СуммаУменьшение = (-1)*РазницаСуммы;
				СтрокаТаблицы.СуммаУвеличение = 0;
			КонецЕсли;
			
			РазницаСуммыНДС = СтрокаТаблицы.СуммаНДС - СтрокаТаблицы.СуммаНДСДоИзменения;
			
			Если РазницаСуммыНДС > 0 Тогда
				СтрокаТаблицы.СуммаНДСУвеличение = РазницаСуммыНДС;
				СтрокаТаблицы.СуммаНДСУменьшение = 0;
				СтрокаТаблицы.НДСКВычету = Истина;
				СтрокаТаблицы.Счет30304 = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04");
			Иначе
				СтрокаТаблицы.СуммаНДСУменьшение = (-1)*РазницаСуммыНДС;
				СтрокаТаблицы.СуммаНДСУвеличение = 0;
			КонецЕсли;
			
			РазницаСуммыВсего = СтрокаТаблицы.Всего - СтрокаТаблицы.ВсегоДоИзменения;
			Если РазницаСуммыВсего > 0 Тогда
				СтрокаТаблицы.ВсегоУвеличение = РазницаСуммыВсего;
				СтрокаТаблицы.ВсегоУменьшение = 0;
			Иначе
				СтрокаТаблицы.ВсегоУменьшение = (-1)*РазницаСуммыВсего;
				СтрокаТаблицы.ВсегоУвеличение = 0;
			КонецЕсли;
			
			// Сопоставление
			СведенияОТоваре = ТекТовар;
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
				"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
				
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					ИдентификаторПоставщика = Идентификатор;
				КонецЕсли;
				
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					СтрокаТаблицы.НФА = Номенклатура;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					СтрокаТаблицы.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
				
			КонецЕсли;
			
			// Заполним номенклатуру поставщика
		КонецЦикла;
	КонецЕсли;
	ДанныеЗаполненияШапки.Вставить("СоставНФА", ТаблицаТоваров);
	
	//Заполнение прочих реквизитов по-умолчанию
	ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВКнигеПродажПокупок;
	ДанныеЗаполненияШапки.Вставить("ВариантРегистрации", ВариантРегистрации);
	
	КодСпособаВыставления = 2;
	ДанныеЗаполненияШапки.Вставить("КодСпособаВыставления", КодСпособаВыставления);
	
	КодВидаОперации = "01";
	ДанныеЗаполненияШапки.Вставить("КодВидаОперации", КодВидаОперации);
	
	НаименованиеПродавца = Контрагент.НаименованиеСокращенное;
	ДанныеЗаполненияШапки.Вставить("НаименованиеПродавца", НаименованиеПродавца);
	ДанныеЗаполненияШапки.Вставить("ИННПродавца", ИННПоставщика);
	ДанныеЗаполненияШапки.Вставить("КПППродавца", КПППоставщика);
	
	ДанныеЗаполненияШапки.Вставить("НомерПервичногоДокумента", НомерДокумента);
	ДанныеЗаполненияШапки.Вставить("ДатаПервичногоДокумента", ДатаДокумента);
	
	ДанныеЗаполненияШапки.Вставить("НомерСчетаФактуры", НомерИсходногоДокумента);
	ДанныеЗаполненияШапки.Вставить("ДатаСчетаФактуры", ДатаИсходногоДокумента);
	
	//Запись
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда 
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.КорректировочныйСчетФактураПолученный.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеЗаполненияШапки);
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		
		СчетФактураПолученный = ОпределитьСчетФактуруПолученый(ДокументОбъект,
			ДанныеЗаполненияШапки.Организация, 
			ДанныеЗаполненияШапки.НомерИсходногоДокумента,
			ДанныеЗаполненияШапки.ДатаИсходногоДокумента,
			Ложь);
			
		Если ЗначениеЗаполнено(СчетФактураПолученный) Тогда
			ДокументОбъект.ДокументОснование = СчетФактураПолученный;	
			ДокументОбъект.ИсправляемыйДокумент = СчетФактураПолученный;
			Если ТипЗнч(СчетФактураПолученный) = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный") Тогда
				ДокументОбъект.ИсправляемыйДокумент = СчетФактураПолученный.ИсправляемыйДокумент;
				ДатаИсправляемогоСчетаФактуры = ДокументОбъект.ИсправляемыйДокумент.Дата;
			ИначеЕсли ТипЗнч(СчетФактураПолученный) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				ДатаИсправляемогоСчетаФактуры = СчетФактураПолученный.Дата;
			КонецЕсли;	
			ДокументОбъект.ПричинаНалогообложения = СчетФактураПолученный.ПричинаНалогообложения;
			Если ДанныеЗаполненияШапки.ДатаИсходногоДокумента = Дата(1,1,1) Тогда
				ДанныеЗаполненияШапки.ДатаИсходногоДокумента = СчетФактураПолученный.Дата;
				ДокументОбъект.ДатаСчетаФактуры = СчетФактураПолученный.Дата;
			КонецЕсли;	
		Иначе
			ДокументОбъект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Покупка;
		КонецЕсли;		
		ДокументОбъект.ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВКнигеПродажПокупок;
		
		ДокументОбъект.СоставНФА.Очистить();
		Если ДанныеЗаполненияШапки.Свойство("СоставНФА") И ЗначениеЗаполнено(ДанныеЗаполненияШапки.СоставНФА) Тогда
			ДокументОбъект.СоставНФА.Загрузить(ДанныеЗаполненияШапки.СоставНФА);
		КонецЕсли;
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, , СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункцииУПД

Функция НайтиПодчиненныйСчетФактуруВыданный(ДокументОснование, ИсключаемыйСФ = Неопределено, СтруктураОтбора = Неопределено)
	Перем СчетФактура;
	
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.Документы.СчетФактураВыданный) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ИсключаемыйСФ",     ИсключаемыйСФ);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураВыданный.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.ПометкаУдаления = ЛОЖЬ
	|	И (СчетФактураВыданный.ДокументОснование = &ДокументОснование
	|			ИЛИ СчетФактураВыданный.ДокументОснованиеЭДО = &ДокументОснование)";
	
	Если ЗначениеЗаполнено(ИсключаемыйСФ) Тогда
		Запрос.Текст = Запрос.Текст 
			+ " И СчетФактураВыданный.ДокументОснование <> &ИсключаемыйСФ";
	КонецЕсли;
	
	Если ТипЗнч(СтруктураОтбора) = Тип("Структура") Тогда
		ТекстУсловия = "";
		Для Каждого КлючЗначение Из СтруктураОтбора Цикл
			ТекстУсловия = ТекстУсловия + "
			| И ";
			
			Если ТипЗнч(КлючЗначение.Значение) = Тип("СписокЗначений") 
				ИЛИ ТипЗнч(КлючЗначение.Значение) = Тип("Массив") Тогда
				ТекстУсловия = ТекстУсловия + "СчетФактураВыданный.ДокументОснование." + КлючЗначение.Ключ + " В (&" + КлючЗначение.Ключ + ")";
			Иначе
				ТекстУсловия = ТекстУсловия + "СчетФактураВыданный.ДокументОснование." + КлючЗначение.Ключ + " = &" + КлючЗначение.Ключ;
			КонецЕсли;
			
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
			
		КонецЦикла;
		Запрос.Текст = Запрос.Текст + ТекстУсловия;
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СчетФактура = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат СчетФактура;
	
КонецФункции	

Функция НайтиПодчиненныйИсправительныйСчетФактуруВыданный(ПервичныйДокументПередачи)
	
	Перем СчетФактура;
	
	Если Не ЗначениеЗаполнено(ПервичныйДокументПередачи) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.Документы.ИсправительныйСчетФактураВыданный) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПервичныйДокументПередачи", ПервичныйДокументПередачи);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИсправительныйСчетФактураВыданный.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИсправительныйСчетФактураВыданный КАК ИсправительныйСчетФактураВыданный
	|ГДЕ
	|	ИсправительныйСчетФактураВыданный.ПометкаУдаления = ЛОЖЬ
	|	И ИсправительныйСчетФактураВыданный.ДокументКорректировки = &ПервичныйДокументПередачи";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СчетФактура = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат СчетФактура;
	
КонецФункции	

Процедура ЗаполнитьДанныеУчастникаУПД(Участник, 
								ВидУчастника, 
								ДатаДанных, 
								ДеревоДанных, 
								ЛицевойСчет = Неопределено, 
								РеквизитыЛицевогоСчета = Неопределено, 
								ЕстьКонтакт = Истина,
								ЕстьОКПО = Истина,
								ЭтоСчетФактура = Ложь,
								ВидАдреса = "АдресРФ",
								КорневойЭлементДерева = "",
								СтороныСделки = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Участник) Тогда
		Возврат;
	КонецЕсли;
		
	СведенияОбУчастнике = Новый Структура;
	ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике, ДатаДанных, ЭтоСчетФактура);
	
	Если СтороныСделки <> Неопределено Тогда
		Если ВидУчастника = "СведенияОПродавце" Тогда
			СторонаСделки = СтороныСделки.Продавец;
			
		ИначеЕсли ВидУчастника = "СведенияОПокупателе" Тогда
			СторонаСделки = СтороныСделки.Покупатель;
			
		ИначеЕсли ВидУчастника = "СведенияОГрузоотправителе" Тогда
			СторонаСделки = СтороныСделки.Грузоотправитель;
			
		ИначеЕсли ВидУчастника = "СведенияОГрузополучателе" Тогда
			СторонаСделки = СтороныСделки.Грузополучатель;
		КонецЕсли;
		
		ОбновляемыеСвойства = Новый Структура();
		ОбновляемыеСвойства.Вставить("ИНН", СторонаСделки.ИНН);
		Если СторонаСделки.Свойство("КПП") Тогда
			ОбновляемыеСвойства.Вставить("КПП", СторонаСделки.КПП);
		КонецЕсли;
		ОбновляемыеСвойства.Вставить("ОфициальноеНаименование", СторонаСделки.Наименование);
		
		ЗаполнитьЗначенияСвойств(СведенияОбУчастнике, ОбновляемыеСвойства);
		
		АдресУчастника = СторонаСделки.Адрес.Представление;
		
		ВидАдреса = "АдресИнформация";
		
	Иначе
		АдресУчастника = "";
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Участник", Участник);
		
		ПолучитьАдресСтруктурой(СтруктураПараметров, "Участник", "Юр");
		АдресУчастника = СтруктураПараметров.СтруктураАдреса;
		ВидАдреса = ?(АдресУчастника.АдресРФ, "АдресРФ", "АдресИнформация");
		
		АдресВСвободнойФорме = АдресЮридическийУКонтрагентаВСвободнойФорме(Участник);
		
		Если ЗначениеЗаполнено(АдресВСвободнойФорме.АдресТекст) Тогда
			АдресУчастника = АдресВСвободнойФорме;
			
			ВидАдреса = "АдресИнформация";
		Иначе	
			Если ВидАдреса = "АдресРФ" Тогда 
				Если (СтрДлина(АдресУчастника.Кварт)>20) ИЛИ (СтрДлина(АдресУчастника.Корпус)>20) Тогда
					ВидАдреса = "АдресИнформация";
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
		
	КонецЕсли;
	
	Если СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН", СведенияОбУчастнике.ИНН);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП", СведенияОбУчастнике.КПП);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации", СведенияОбУчастнике.ОфициальноеНаименование);
		
	Иначе
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН", СведенияОбУчастнике.ИНН);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия", СведенияОбУчастнике.Фамилия);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя", СведенияОбУчастнике.Имя);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество", СведенияОбУчастнике.Отчество);
	КонецЕсли;	
	
	ЗаполнитьАдресВДеревеУПД(ДеревоДанных, АдресУчастника, ВидАдреса, ВидУчастника, КорневойЭлементДерева);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".КонтактныеСведения.Телефон", СведенияОбУчастнике.Телефоны);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".КонтактныеСведения.ЭлектроннаяПочта", СведенияОбУчастнике.ЭлектроннаяПочта);
	
	Если ЛицевойСчет <> Неопределено Тогда
		
		ЗаполнитьРеквизитыЛицевогоСчета(ЛицевойСчет, РеквизитыЛицевогоСчета);
		
		РасчетныеРеквизиты = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	    ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, РасчетныеРеквизиты);
		
		ТекстБанка = "";
		ТекстБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
		НомерСчета = РасчетныеРеквизиты.НомерСчетаПолучателя;
		
		Если НЕ ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
			РасчетныеРеквизиты.НомерСчетаПолучателя = СокрЛП(ЛицевойСчет.Код);
			Если ТипЗнч(ЛицевойСчет) = Тип("СправочникСсылка.БанковскиеИКазначейскиеСчета") Тогда
				Если ТипЗнч(ЛицевойСчет.КассовыйОрган) = Тип("СправочникСсылка.Банки") Тогда
					ТекстБанка = ЛицевойСчет.КассовыйОрган.Наименование;
					РасчетныеРеквизиты.БикБанкаПолучателя = СокрЛП(ЛицевойСчет.КассовыйОрган.Код);
					НомерСчета = СокрЛП(РасчетныеРеквизиты.НомерСчетаПолучателя);
				ИначеЕсли ТипЗнч(ЛицевойСчет.КассовыйОрган) = Тип("СправочникСсылка.Казначейства") Тогда	
					ТекстБанка = ЛицевойСчет.СчетКазначейства.КассовыйОрган.Наименование + " " + ЛицевойСчет.СчетКазначейства.КассовыйОрган.Город + ", Казначейство: " +
					ЛицевойСчет.КассовыйОрган.Наименование + " ("+ЛицевойСчет.Владелец.НаименованиеСокращенное+", л/с "+ СокрЛП(ЛицевойСчет.Код)+")";
					РасчетныеРеквизиты.БикБанкаПолучателя = ЛицевойСчет.СчетКазначейства.КассовыйОрган.Код;
					НомерСчета = СокрЛП(ЛицевойСчет.СчетКазначейства.Код);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ТекстБанка = РеквизитыЛицевогоСчета.КассовыйОрган.Наименование;
			РасчетныеРеквизиты.БикБанкаПолучателя = РеквизитыЛицевогоСчета.КассовыйОрган.Код;
			НомерСчета = СокрЛП(РеквизитыЛицевогоСчета.Владелец.Код);
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.НомерСчета", НомерСчета);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.НаименованиеБанка", ТекстБанка);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.БИКБанка", РасчетныеРеквизиты.БикБанкаПолучателя);
	КонецЕсли;	
	Если ЕстьОКПО Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".КодОКПО", СведенияОбУчастнике.КодПоОКПО);
	КонецЕсли;	
КонецПроцедуры	

Функция ДокументОснованиеСЧФ(СчетФактура)
	Результат = Новый Структура("НаименованиеДокументаОснования, ЭтоУслуги", "", Ложь);
	
	ДокументОснование = СчетФактура.ДокументОснование;
	
	Если ЗначениеЗаполнено(СчетФактура.ДокументОснование) Тогда
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			Результат.НаименованиеДокументаОснования = "Счет-фактура № "+НомерДляПечати(ДокументОснование, ДокументОснование.Дата)+" от "+Формат(ДокументОснование.Дата, "ДФ=dd.MM.yyyy");
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") 
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
			Результат.НаименованиеДокументаОснования = "Накладная № "+НомерДляПечати(ДокументОснование, ДокументОснование.Дата)+" от "+Формат(ДокументОснование.Дата, "ДФ=dd.MM.yyyy");
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.АктОбОказанииУслуг") 
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СдачаЭтапаРабот") Тогда
			Результат.ЭтоУслуги = Истина;
			Результат.НаименованиеДокументаОснования = "Акт об оказании услуг № "+НомерДляПечати(ДокументОснование, ДокументОснование.Дата)+" от "+Формат(ДокументОснование.Дата, "ДФ=dd.MM.yyyy");
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов") Тогда
			ДокументОснованиеЭДО = СчетФактура.ДокументОснованиеЭДО;
			Если ЗначениеЗаполнено(ДокументОснованиеЭДО) Тогда
				Результат.ЭтоУслуги = Истина;
				
				СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора = ЭлектронныеДокументыБГУ.ЗначениеНастройкиСоздаватьПередаточныеДокументыПоКонтрагентуИДоговору(ДокументОснованиеЭДО.Организация);
				
				РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснованиеЭДО, "Контрагент, Договор");
				Если НЕ СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора И ДокументОснованиеЭДО.ИдентификаторыСтрокДокументаОснования.Количество()>0 Тогда
					РеквизитыДокумента.Вставить("ИдентификаторЭД", ДокументОснованиеЭДО.ИдентификаторыСтрокДокументаОснования[0].ИдентификаторЭД);
				КонецЕсли;	
				
				Результат.НаименованиеДокументаОснования = "Передаточный документ (акт) № "+НомерПередаточногоДокументаЭД(ДокументОснование, РеквизитыДокумента, СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора)+" от "+Формат(ДокументОснованиеЭДО.Дата, "ДФ=dd.MM.yyyy");
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НачислениеДоходов") Тогда
			ДокументОснованиеЭДО = СчетФактура.ДокументОснованиеЭДО;
			Если ЗначениеЗаполнено(ДокументОснованиеЭДО) Тогда
				Результат.ЭтоУслуги = Истина;
				
				СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора = ЭлектронныеДокументыБГУ.ЗначениеНастройкиСоздаватьПередаточныеДокументыПоКонтрагентуИДоговору(ДокументОснованиеЭДО);
				
				РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснованиеЭДО, "Контрагент, Договор");
				Если НЕ СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора И ДокументОснованиеЭДО.ИдентификаторыСтрокДокументаОснования.Количество()>0 Тогда
					РеквизитыДокумента.Вставить("ИдентификаторЭД", ДокументОснованиеЭДО.ИдентификаторыСтрокДокументаОснования[0].ИдентификаторЭД);
				КонецЕсли;	
				
				Результат.НаименованиеДокументаОснования = "Передаточный документ (акт) № "+НомерПередаточногоДокументаЭД(ДокументОснование, РеквизитыДокумента, СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора)+" от "+Формат(ДокументОснованиеЭДО.Дата, "ДФ=dd.MM.yyyy");
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПередачаЗдания") 
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектаОС") 
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовОС") 
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовИК") 
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПередачаГруппОбъектовОС") Тогда
			Результат.НаименованиеДокументаОснования = "Акт № "+НомерДляПечати(ДокументОснование, ДокументОснование.Дата)+" от "+Формат(ДокументОснование.Дата, "ДФ=dd.MM.yyyy");
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер")
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КассовоеПоступление") 
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОперацияБух") Тогда
			Результат.НаименованиеДокументаОснования = "Оплата аванса № "+НомерДляПечати(ДокументОснование, ДокументОснование.Дата)+" от "+Формат(ДокументОснование.Дата, "ДФ=dd.MM.yyyy");
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция НомерДляПечати(ДокументСсылка, ДокументНомер) Экспорт
	
	Возврат РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		ДокументСсылка, ДокументНомер);
	
КонецФункции	

Функция ТипСчетФактурыУПД(ДеревоДанных)
	
	ВидОперацииИсправления = "Реализация";
	
	ВидОперации = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации");

	НомерИсправления = ДеревоДанных.Строки.Найти("НомерИсправления", "ПолныйПуть");
	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		НомерИсправления = НомерИсправления.Значение;
	КонецЕсли;	
	НомерКорСчетаФактуры = ДеревоДанных.Строки.Найти("НомерКорСчетаФактуры", "ПолныйПуть");
	Если ЗначениеЗаполнено(НомерКорСчетаФактуры) Тогда
		НомерКорСчетаФактуры = НомерКорСчетаФактуры.Значение;
	КонецЕсли;	

	Если ЗначениеЗаполнено(ВидОперации) Тогда
		Если ВидОперации = Перечисления.ВидыОперацийЭД.Исправление Тогда
			ВидОперацииИсправления = "ИсправлениеРеализации";
		ИначеЕсли ВидОперации = Перечисления.ВидыОперацийЭД.Корректировка Тогда
			Если ЗначениеЗаполнено(НомерИсправления) Тогда
				ВидОперацииИсправления = "ИсправлениеКорректировки";
			Иначе
				ВидОперацииИсправления = "Корректировка";
			КонецЕсли;	
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(НомерИсправления) Тогда
			Если ЗначениеЗаполнено(НомерКорСчетаФактуры) Тогда	
				ВидОперацииИсправления = "ИсправлениеКорректировки";
			Иначе
				ВидОперацииИсправления = "ИсправлениеРеализации";
			КонецЕсли;	
		ИначеЕсли ЗначениеЗаполнено(НомерКорСчетаФактуры) Тогда	
			ВидОперацииИсправления = "Корректировка";
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ВидОперацииИсправления;
КонецФункции

Функция ТипыНоменклатурыУслугРабот() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ТипыНоменклатуры.Работа);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.Госуслуга);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.УслугиАренды);
	
	Возврат Результат;
КонецФункции	

Функция ПризнакТовараЕдиногоДокумента(Товар) Экспорт
	
	Если ТипЗнч(Товар) = Тип("СправочникСсылка.Номенклатура") Тогда
		Если ЗначениеЗаполнено(Товар) Тогда
			Если Товар.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Госуслуга 
				ИЛИ Товар.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ГруппаУслуг 
				ИЛИ Товар.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга
				ИЛИ Товар.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.УслугиАренды Тогда
				Возврат "3"; // Услуга
			ИначеЕсли Товар.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
				Возврат "2"; // Работа
			Иначе
				Возврат "1"; // Имущество
			КонецЕсли;
		Иначе
			Возврат "1"; // Имущество
		КонецЕсли;
	ИначеЕсли ТипЗнч(Товар) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		Если Товар.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
			Возврат "4"; // Имущественные права;
		Иначе
			Возврат "1"; // Имущество
		КонецЕсли;	
	КонецЕсли;
	
	Возврат "5"; // Иное
КонецФункции

Функция ПризнакТарыЕдиногоДокумента(Товар) Экспорт
	
	Если ТипЗнч(Товар) = Тип("СправочникСсылка.Номенклатура") Тогда
		Если ЗначениеЗаполнено(Товар) Тогда
			Если Товар.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Тара Тогда
				Возврат "ВТ";
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ""; // Иное
КонецФункции

Функция ПризнакУслуги(Знач Признак)
	Результат = Ложь;
	
	Если (Признак = "2") ИЛИ (Признак = "3") Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ДоговорПоНастройкеЭДО(Контрагент, Организация)
	Результат = Справочники.Договоры.ПустаяСсылка();
	
	ЕстьПравоДоступа = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.НастройкиОтправкиЭлектронныхДокументов);
	
	Если НЕ ЕстьПравоДоступа Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(Организация) Тогда
		Запрос = Новый Запрос;
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	НастройкиОтправкиЭлектронныхДокументов.Договор КАК Договор
		               |ИЗ
		               |	РегистрСведений.НастройкиОтправкиЭлектронныхДокументов КАК НастройкиОтправкиЭлектронныхДокументов
		               |ГДЕ
		               |	НастройкиОтправкиЭлектронныхДокументов.Получатель = &Контрагент
		               |	И НастройкиОтправкиЭлектронныхДокументов.Отправитель = &Организация";
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("Организация", Организация);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если РезультатЗапроса.Количество() = 1 Тогда
			Результат = РезультатЗапроса[0].Договор;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ВидимостьЭлементовЭДО(Контрагент, Организация) Экспорт
	Результат = Ложь;

	УстановитьПривилегированныйРежим(Истина);
	
	ВключенаОпцияЭДО = ПолучитьФункциональнуюОпцию("ИспользоватьОбменЭД");
	
	Если ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(Организация) И ВключенаОпцияЭДО Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	НастройкиОтправкиЭлектронныхДокументов.Договор КАК Договор,
					|	НастройкиОтправкиЭлектронныхДокументов.ИдентификаторОтправителя КАК ИдентификаторОтправителя,
					|	НастройкиОтправкиЭлектронныхДокументов.ИдентификаторПолучателя КАК ИдентификаторПолучателя
					|ИЗ
					|	РегистрСведений.НастройкиОтправкиЭлектронныхДокументовПоВидам КАК НастройкиОтправкиЭлектронныхДокументов
					|ГДЕ
					|	НастройкиОтправкиЭлектронныхДокументов.Получатель = &Контрагент
					|	И НастройкиОтправкиЭлектронныхДокументов.Отправитель = &Организация
					|	И НЕ НастройкиОтправкиЭлектронныхДокументов.ИдентификаторПолучателя = """"";
		
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("Организация", Организация);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если РезультатЗапроса.Количество() > 0 Тогда
			Результат = Истина;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ТолькоУслугиПоСведениямОТоварах(ДеревоДанных)
	Результат = Истина;
	
	// Сведения таблицы.
	СтрокаТаблицаТоваров = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
	Для Каждого Товар Из СтрокаТаблицаТоваров.Строки Цикл
		
		Признак = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.Признак");
		
		Если НЕ ПризнакУслуги(Признак) Тогда
			Результат = Ложь;	
		КонецЕсли;	
	КонецЦикла;
	
	Организация = Справочники.Организации.ПустаяСсылка();
 	ИННПокупателя = ""; КПППокупателя = "";
	ВидУчастника = "СведенияОПокупателе.НомерСтроки";
	Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
		ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
		КПППокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
		СсылкаНаОбъектПоИННКПП("Организации", ИННПокупателя, КПППокупателя, Организация);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) И Результат Тогда
		Результат = НЕ ИспользоватьЭДПДляОтраженияВУчетеПоставкиУслугРабот(Организация);
	КонецЕсли;	
		
	Возврат Результат;
КонецФункции

Функция ДокументСсылкаНаПоступлениеПоТОРГ12(Организация, Контрагент, НомерДокументаПередачи, ДатаДокументаПередачи) Экспорт
	Результат = Документы.ЭлектронныйДокументПоставщика.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ПоступлениеМЗ.Ссылка
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика КАК ПоступлениеМЗ
	               |ГДЕ
	               |	ПоступлениеМЗ.Организация = &Организация
	               |	И ПоступлениеМЗ.Контрагент = &Контрагент
	               |	И ПоступлениеМЗ.ДатаПервичногоДокумента = &ДатаПервичногоДокумента
	               |	И ПоступлениеМЗ.НомерПервичногоДокумента = &НомерПервичногоДокумента
	               |	И ПоступлениеМЗ.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Организация", Организация);			   
	Запрос.УстановитьПараметр("Контрагент", Контрагент);			   
	Запрос.УстановитьПараметр("НомерПервичногоДокумента", НомерДокументаПередачи);			   
	Запрос.УстановитьПараметр("ДатаПервичногоДокумента", ДатаДокументаПередачи);			   
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.Ссылка;	
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции

Функция ДляДокументаСуществуетЭД(ДокументСсылка) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостоянияЭД.СсылкаНаОбъект КАК СсылкаНаОбъект
	|ИЗ
	|	РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
	|ГДЕ
	|	СостоянияЭД.СсылкаНаОбъект = &ДокументСсылка
	|	И СостоянияЭД.СостояниеЭДО <> ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовЭДО.НеСформирован)";
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Истина;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции	

Процедура ЗаполнитьСчетаФактурыПоДокументамОснования(МассивОснований, МассивСФ, НаправлениеЭД) Экспорт
	НаправленияДокументов = ОбменСКонтрагентами.НаправленияДокументов();
	
	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СчетФактураДокументыОснования.Ссылка КАК Ссылка
		|ИЗ
		|	&СчетФактураДокументыОснования КАК СчетФактураДокументыОснования
		|ГДЕ
		|	СчетФактураДокументыОснования.ДокументОснование В(&ДокументыОснования)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИсправительныйСчетФактура.Ссылка
		|ИЗ
		|	&ИсправительныйСчетФактураДокументыОснования КАК ИсправительныйСчетФактура
		|ГДЕ
		|	ИсправительныйСчетФактура.ДокументОснование В(&ДокументыОснования)
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КорректировочныйСчетФактура.Ссылка
		|ИЗ
		|	&КорректировочныйСчетФактураДокументыОснования КАК КорректировочныйСчетФактура
		|ГДЕ
		|	КорректировочныйСчетФактура.ДокументОснование В(&ДокументыОснования)";
	
	Если НаправлениеЭД = НаправленияДокументов.Входящий Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СчетФактураДокументыОснования",
			"Документ.СчетФактураПолученный.ДокументыОснования");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИсправительныйСчетФактураДокументыОснования",
			"Документ.ИсправительныйСчетФактураПолученный");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КорректировочныйСчетФактураДокументыОснования",
			"Документ.КорректировочныйСчетФактураПолученный");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СчетФактураДокументыОснования",
			"Документ.СчетФактураВыданный");   
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИсправительныйСчетФактураДокументыОснования",
			"Документ.ИсправительныйСчетФактураВыданный");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КорректировочныйСчетФактураДокументыОснования",
			"Документ.КорректировочныйСчетФактураВыданный");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДокументыОснования", МассивОснований);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		МассивСФ = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
КонецПроцедуры

// Определяет является ли документ информационной базы счет-фактурой.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ информационной базы.
//  Результат - Булево - является ли документ счет-фактурой.
//
Процедура ОпределитьДокументЯвляетсяСчетомФактурой(ДокументСсылка, Результат) Экспорт
	Результат = Ложь;
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.СчетФактураПолученный")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный") Тогда
		
		Результат = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ДатаИзСтроки(Строка)
	
	Если ПустаяСтрока(Строка) Тогда 
		Возврат Дата('00010101');
	Иначе
		Возврат Дата(Сред(Строка, 7, 4) + Сред(Строка, 4, 2) + Сред(Строка, 1, 2) + "000000");
	КонецЕсли;
	
КонецФункции

