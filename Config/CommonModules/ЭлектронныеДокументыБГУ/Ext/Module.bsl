		Если ЭтоАдресВременногоХранилища(ПрисоединенныйФайл.Ссылка) Тогда
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ПрисоединенныйФайл.Ссылка);
			Расширение     =  ПрисоединенныйФайл.Расширение;
		Иначе
			ДанныеФайла = РаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл.Ссылка);
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
			Расширение     = ДанныеФайла.Расширение;
		КонецЕсли;
		ТекстовоеСодержимое = Base64Строка(ДвоичныеДанные);
		
		ИмяПриложенногоФайла = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='%1.%2'"), ПрисоединенныйФайл.Наименование, ПрисоединенныйФайл.Расширение);
		
		СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "ФайлыПриложений");
		
		СтрокаТаблицыXDTO.Установить("ИмяФайла", ИмяПриложенногоФайла);
		СтрокаТаблицыXDTO.Установить("НаименованиеДокумента", ТекСтрока.НаименованиеДокументаФайла);
		СтрокаТаблицыXDTO.Установить("КодВидаСведений", КодВидаСведенийАктаПриемаПередачиНФА(ВидСведений));
		СтрокаТаблицыXDTO.Установить("СодержимоеФайла", XMLСтрока(ТекстовоеСодержимое));
		
		ТаблицаXDTO.ФайлыПриложений.Добавить(СтрокаТаблицыXDTO);
	КонецЦикла;
	
	//ФайлыПредставленияАкта

	//MXL
	
	Расширение = "MXL";
	
	Если ИспользуетсяПОД Тогда
		ИдентификаторПечати = "ОтветныйАктПриемаПередачи0510448";
		СведенияПредставленияВнутреннегоЭД = СведенияПредставленияВнутреннегоЭДПОД(ДокументПринятияКУчету, ИдентификаторПечати, ДатаИсходящегоДокумента, НомерИсходящегоДокумента, Расширение);
	Иначе
		СведенияПредставленияВнутреннегоЭД = СведенияПредставленияВнутреннегоЭД(СтруктураДанных.Организация, ВнутреннийЭД, ДатаИсходящегоДокумента, НомерИсходящегоДокумента, Расширение);
	КонецЕсли;
	
	СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "ФайлыПредставленияАкта");
	СтрокаТаблицыXDTO.Установить("ИмяФайла", СведенияПредставленияВнутреннегоЭД.ИмяПриложенногоФайла);
	СтрокаТаблицыXDTO.Установить("КодВидаСведений", СведенияПредставленияВнутреннегоЭД.КодВидаСведений);
	СтрокаТаблицыXDTO.Установить("СодержимоеФайла", XMLСтрока(СведенияПредставленияВнутреннегоЭД.ТекстовоеСодержимое));
	ТаблицаXDTO.ФайлыПредставленияАкта.Добавить(СтрокаТаблицыXDTO);

	// PDF
	
	Расширение = "PDF";

	Если ИспользуетсяПОД Тогда
		ИдентификаторПечати = "ОтветныйАктПриемаПередачи0510448";
		СведенияПредставленияВнутреннегоЭД = СведенияПредставленияВнутреннегоЭДПОД(ДокументПринятияКУчету, ИдентификаторПечати, ДатаИсходящегоДокумента, НомерИсходящегоДокумента, Расширение);
	Иначе
		СведенияПредставленияВнутреннегоЭД = СведенияПредставленияВнутреннегоЭД(СтруктураДанных.Организация, ВнутреннийЭД, ДатаИсходящегоДокумента, НомерИсходящегоДокумента, Расширение);
	КонецЕсли;
	
	СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "ФайлыПредставленияАкта");
	СтрокаТаблицыXDTO.Установить("ИмяФайла", СведенияПредставленияВнутреннегоЭД.ИмяПриложенногоФайла);
	СтрокаТаблицыXDTO.Установить("КодВидаСведений", СведенияПредставленияВнутреннегоЭД.КодВидаСведений);
	СтрокаТаблицыXDTO.Установить("СодержимоеФайла", XMLСтрока(СведенияПредставленияВнутреннегоЭД.ТекстовоеСодержимое));
	ТаблицаXDTO.ФайлыПредставленияАкта.Добавить(СтрокаТаблицыXDTO);
	
	ДокументXDTO.ТабличныеСведения.Добавить(ТаблицаXDTO);

	ДокументXDTO.Установить("Пояснение", СтруктураДанных.Пояснение);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОДолжностномЛицеАктаОПриемеПередачеНФАПоСтруктуре(ДокументXDTO, ДанныеСотрудника, КемВыступает)
	Если ДанныеСотрудника.Фамилия = Неопределено Тогда
		ДанныеСотрудника.Фамилия = "";
	КонецЕсли;	
	Если ДанныеСотрудника.Имя = Неопределено Тогда
		ДанныеСотрудника.Имя = "";
	КонецЕсли;	
	Если ДанныеСотрудника.Отчество = Неопределено Тогда
		ДанныеСотрудника.Отчество = "";
	КонецЕсли;	
	
	ДолжностноеЛицоXDTO = СоздатьОбъектXDTO(ДокументXDTO, КемВыступает);
	ДолжностноеЛицоXDTO.Установить("Должность", ДанныеСотрудника.Должность);
	ДолжностноеЛицоXDTO.Установить("Фамилия", ДанныеСотрудника.Фамилия);
	ДолжностноеЛицоXDTO.Установить("Имя", ДанныеСотрудника.Имя);
	ДолжностноеЛицоXDTO.Установить("Отчество", ДанныеСотрудника.Отчество);
	
	Если НЕ (КемВыступает = "РуководительОтправителя"
		ИЛИ КемВыступает = "РуководительПолучателя") Тогда
		КонтактXDTO = СоздатьОбъектXDTO(ДолжностноеЛицоXDTO, "Контакт");
		Если ЗначениеЗаполнено(ДанныеСотрудника.Телефон) Тогда
			КонтактXDTO.Установить("Телефон", ДанныеСотрудника.Телефон);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеСотрудника.ЭлектронныйАдрес) Тогда
			КонтактXDTO.Установить("ЭлектронныйАдрес", ДанныеСотрудника.ЭлектронныйАдрес);
		КонецЕсли;
		ДолжностноеЛицоXDTO.Установить("Контакт", КонтактXDTO);
	КонецЕсли;	
	
	ДокументXDTO[КемВыступает] = ДолжностноеЛицоXDTO;
КонецПроцедуры

Процедура СформироватьТабличныйДокументДляЭлектронногоАктаОПриемеПередачеОбъектовНФА(ДокументXDTO, ПараметрыЗаполнения, ТабличныйДокумент)

	Для Каждого СтрокаТаблицыXDTO Из ДокументXDTO.ТабличныеСведения[0].ФайлыПредставленияАкта Цикл
		КодВидаСведений = СтрокаТаблицыXDTO.КодВидаСведений;
		Если КодВидаСведений = 1 Тогда
			ИмяФайла = СтрокаТаблицыXDTO.ИмяФайла;
			СодержимоеФайлаBase64 = СтрЗаменить(СтрокаТаблицыXDTO.СодержимоеФайла, "  ", Символы.ВК);
			ДвоичныеДанные = Base64Значение(СодержимоеФайлаBase64);

			Если ДвоичныеДанные = Неопределено Тогда

				ТекстСообщения = НСтр("ru = 'Не удалось получить данные представления документа в электронном документе.
					|Следует проверить наличие внутреннего электронного документа для документа-основания.'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
				Возврат;
			КонецЕсли;
			
			ТабличныйДокумент = ТабличныйДокументИзДвоичныхДанных(ДвоичныеДанные);
			
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
		
КонецПроцедуры	

Функция ТабличныйДокументИзДвоичныхДанных(ДвоичныеДанные) Экспорт
	Результат = Новый ТабличныйДокумент;
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ВременныйКаталог = ФайловаяСистема.СоздатьВременныйКаталог();
	ВременныйФайл = ВременныйКаталог + "Act448.mxl";
	
	ДвоичныеДанные.Записать(ВременныйФайл);
	
	Результат.Прочитать(ВременныйФайл);

	Попытка
		ФайловаяСистема.УдалитьВременныйКаталог(ВременныйКаталог);
	Исключение
		// Обработка исключения не требуется
	КонецПопытки;
	
	Возврат Результат; 
КонецФункции	

Функция ДвоичныеДанныеДокумента(ОбъектУчета, ИдентификаторКомандыПечати) Экспорт
	
	МетаданныеОбъекта = ОбъектУчета.Метаданные();
	
	ПолноеИмяФормы = МетаданныеОбъекта.ОсновнаяФормаОбъекта.Имя;
	СписокОбъектов = Новый Массив();
	СписокОбъектов.Добавить(МетаданныеОбъекта);
	
	КомандыПечати = УправлениеПечатью.КомандыПечатиФормы(ПолноеИмяФормы, СписокОбъектов);
	НайденнаяКоманда = КомандыПечати.Найти(ИдентификаторКомандыПечати, "Идентификатор");
	Если НайденнаяКоманда = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КомандаПечатиВФайл = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НайденнаяКоманда);
	
	МассивОбъектовУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОбъектУчета);
	
	НастройкиСохранения = УправлениеПечатью.НастройкиСохранения();
	НастройкиСохранения.ФорматыСохранения.Добавить(ТипФайлаТабличногоДокумента.MXL);
	
	РезультатПечати = УправлениеПечатью.НапечататьВФайл(КомандаПечатиВФайл, МассивОбъектовУчета, НастройкиСохранения);

	Если ЗначениеЗаполнено(РезультатПечати) Тогда
		Возврат РезультатПечати[0].ДвоичныеДанные;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ДвоичныеДанныеДокументаPDF(ОбъектУчета, ИдентификаторКомандыПечати) Экспорт
	
	МетаданныеОбъекта = ОбъектУчета.Метаданные();
	
	ПолноеИмяФормы = МетаданныеОбъекта.ОсновнаяФормаОбъекта.Имя;
	СписокОбъектов = Новый Массив();
	СписокОбъектов.Добавить(МетаданныеОбъекта);
	
	КомандыПечати = УправлениеПечатью.КомандыПечатиФормы(ПолноеИмяФормы, СписокОбъектов);
	НайденнаяКоманда = КомандыПечати.Найти(ИдентификаторКомандыПечати, "Идентификатор");
	Если НайденнаяКоманда = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КомандаПечатиВФайл = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НайденнаяКоманда);
	
	МассивОбъектовУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОбъектУчета);
	
	НастройкиСохранения = УправлениеПечатью.НастройкиСохранения();
	НастройкиСохранения.ФорматыСохранения.Добавить(ТипФайлаТабличногоДокумента.PDF_A_3);
	
	РезультатПечати = УправлениеПечатью.НапечататьВФайл(КомандаПечатиВФайл, МассивОбъектовУчета, НастройкиСохранения);

	Если ЗначениеЗаполнено(РезультатПечати) Тогда
		Возврат РезультатПечати[0].ДвоичныеДанные;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ДвоичныеДанныеПредставленияДокументаПОД(ОбъектУчета, ИдентификаторКомандыПечати, Формат) Экспорт

	МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
	СведенияОПервичиномДокументе = МодульПроцессыОбработкиДокументов.ПолучитьПредставлениеФормуляровПервичногоДокумента(ОбъектУчета);
	Если ТипЗнч(СведенияОПервичиномДокументе) = Тип("Соответствие") Тогда
		СведенияОФормуляреПервичиногоДокумента = СведенияОПервичиномДокументе.Получить(ИдентификаторКомандыПечати); 
	Иначе
		СведенияОФормуляреПервичиногоДокумента = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОФормуляреПервичиногоДокумента) Тогда
		
		Возврат МодульПроцессыОбработкиДокументов.ДвоичныеДанныеВизуализацииТекущегоПервичногоДокумента(
			ОбъектУчета, СведенияОПервичиномДокументе, ИдентификаторКомандыПечати, Формат)
		
	Иначе
		
		МетаданныеОбъекта = ОбъектУчета.Метаданные();
		
		ПолноеИмяФормы = МетаданныеОбъекта.ОсновнаяФормаОбъекта.Имя;
		СписокОбъектов = Новый Массив();
		СписокОбъектов.Добавить(МетаданныеОбъекта);
		
		КомандыПечати = УправлениеПечатью.КомандыПечатиФормы(ПолноеИмяФормы, СписокОбъектов);
		НайденнаяКоманда = КомандыПечати.Найти(ИдентификаторКомандыПечати, "Идентификатор");
		Если НайденнаяКоманда = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		КомандаПечатиВФайл = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НайденнаяКоманда);
		
		МассивОбъектовУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОбъектУчета);
		
		НастройкиСохранения = УправлениеПечатью.НастройкиСохранения();
		НастройкиСохранения.ФорматыСохранения.Добавить(Формат);
		
		РезультатПечати = УправлениеПечатью.НапечататьВФайл(КомандаПечатиВФайл, МассивОбъектовУчета, НастройкиСохранения);
		
		Если ЗначениеЗаполнено(РезультатПечати) Тогда
			Возврат РезультатПечати[0].ДвоичныеДанные;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ОбработкаВходящегоЭлектронногоАктаОПриемеПередачеОбъектовНФА(СсылкиНаОбъекты, ДокументXDTO, РежимЗаписи, ДатаСведений)

	#Область СозданиеВходящегоАктаОПриемеПередачеОбъектовНФА

	Попытка                   
		Если ЗначениеЗаполнено(СсылкиНаОбъекты) Тогда
			ДокументОбъект = СсылкиНаОбъекты[0].ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			
			ДокументОбъект = Документы.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
			ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
		КонецЕсли;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		
		ДокументОбъект.ФайлыПриложений.Очистить();
		
		ТипАкта = ЧислоИзСтрокиЭД(ДокументXDTO.ТипАкта);
		ДокументОбъект.ТипЭлектронногоАкта = ТипАкта;
		
		Если ТипАкта = ТипАктаПередающейСтороны() Тогда
			ДокументОбъект.GUIDВходящегоДокумента = ДокументXDTO.GUIDАкта;
		ИначеЕсли ТипАкта = ТипАктаОтветногоПринимающейСтороны() Тогда
			GUIDВходящегоАкта = ДокументXDTO.GUIDВходящегоАкта;
			Если ЗначениеЗаполнено(GUIDВходящегоАкта) Тогда
				ДокументОбъект.GUIDВходящегоДокумента = GUIDВходящегоАкта;
				НайденныйИсходящийАкт = Документы.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ПолучитьСсылку(Новый УникальныйИдентификатор(GUIDВходящегоАкта)); 
				ДокументОбъект.ДокументОснование = НайденныйИсходящийАкт;
			КонецЕсли;
		КонецЕсли;
		
		ДокументОбъект.СуммаДокумента = ДокументXDTO.СуммаДокумента;
		ДокументОбъект.КФОУОтправителя = ДокументXDTO.КФО;
		ДокументОбъект.ВидИмуществаУОтправителя = ДокументXDTO.ВидИмущества;
		ДокументОбъект.КодВидаИмуществаУОтправителя = ДокументXDTO.КодВидаИмущества;
		ДокументОбъект.КодВидаПередачиНФА = ДокументXDTO.КодВидаПередачиНФА;
		ДокументОбъект.КодВалюты = ДокументXDTO.КодВалюты;
		ДокументОбъект.ТипДокументаОснования = ДокументXDTO.ТипДокументаОснования;
		ДокументОбъект.КодВидаОперации = ДокументXDTO.КодВидаОперации;
			
		ДокументОбъект.ВидПервичногоДокумента = ДокументXDTO.Наим;
		ДокументОбъект.НомерПервичногоДокумента = ДокументXDTO.Номер;
		ДокументОбъект.ДатаПервичногоДокумента = ДокументXDTO.Дата;
		
		ДокументОбъект.Пояснение = ДокументXDTO.Пояснение;
		
		ЭтоВозвратНФА = ДокументXDTO.ВозвратНФАОтправителю;
