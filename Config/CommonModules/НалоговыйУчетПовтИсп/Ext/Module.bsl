
#Область ПрограммныйИнтерфейс

// Возвращает таблицу правил определения прямых расходов НУ для заданного вида затрат.
//
Функция ПравилаОпределенияПрямыхРасходов(ВидЗатрат, Организация, ГодДействия) Экспорт
	
	Возврат НалоговыйУчет.ПравилаОпределенияПрямыхРасходов(ВидЗатрат, Организация, ГодДействия);
	
КонецФункции

Функция ВедетсяУчетКапВложенийНУПоПодразделениям(Знач НаДату = Неопределено) Экспорт
	
	Возврат БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("Н08", , НаДату).УчетПоПодразделениям;
	
КонецФункции

Функция ВедетсяУчетКапВложенийНУПоКПС(Знач НаДату = Неопределено) Экспорт
	
	Возврат НалоговыйУчет.ВедетсяУчетКапВложенийНУПоКПС(НаДату);
	
КонецФункции

Функция ВедетсяУчетКапВложенийНУПоЦМО(Знач НаДату = Неопределено) Экспорт
	
	Возврат НалоговыйУчет.ВедетсяУчетКапВложенийНУПоЦМО(НаДату);
	
КонецФункции

#Область УстаревшиеПроцедурыИФункции

// Устарела. Следует использовать функцию НалоговыйУчетКлиентСервер.ВидСчетаБУ().
Функция ВидСчетаБУ(СчетБУ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетБУ", СчетБУ);
	
	Запрос.Текст = 
		НалоговыйУчет.ТекстЗапросаСчетаУчетаВнеоборотныхАктивов() +
		НалоговыйУчет.ТекстЗапросаСчетаУчетаМПЗ() +
		НалоговыйУчет.ТекстЗапросаСчетаУчетаЗатрат() +
		НалоговыйУчет.ТекстЗапросаСчетаУчетаРасчетов() +
		НалоговыйУчет.ТекстЗапросаСчетаУчетаДоходовРасходов() +
		НалоговыйУчет.ТекстЗапросаСчетаУчетаРасходовБудущихПериодов() +
		НалоговыйУчет.ТекстЗапросаСчетаУчетаРезервовПредстоящихРасходов();
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК СчетБУ,
	|	ВЫБОР
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаОсновныхСредств.Счет
	|				ИЗ
	|					СчетаУчетаОсновныхСредств)
	|			ТОГДА ""СчетОС""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаНематериальныхАктивов.Счет
	|				ИЗ
	|					СчетаУчетаНематериальныхАктивов)
	|			ТОГДА ""СчетНМА""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаНепроизведенныхАктивов.Счет
	|				ИЗ
	|					СчетаУчетаНепроизведенныхАктивов)
	|			ТОГДА ""СчетНПА""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаАмортизации.Счет
	|				ИЗ
	|					СчетаУчетаАмортизации)
	|			ТОГДА ВЫБОР
	|					КОГДА ЕПСБУ.Ссылка В
	|							(ВЫБРАТЬ
	|								СчетаУчетаАмортизацииНМА.Счет
	|							ИЗ
	|								СчетаУчетаАмортизацииНМА)
	|						ТОГДА ""СчетАмортизацииНМА""
	|					ИНАЧЕ ""СчетАмортизацииОС""
	|				КОНЕЦ
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаВложенийВоВнеоборотныеАктивы.Счет
	|				ИЗ
	|					СчетаУчетаВложенийВоВнеоборотныеАктивы)
	|			ТОГДА ""СчетВложенийВНА""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаВложенийВМатериальныеЗапасы.Счет
	|				ИЗ
	|					СчетаУчетаВложенийВМатериальныеЗапасы)
	|			ТОГДА ""СчетВложенийМЗ""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаМатериальныхЗапасов.Счет
	|				ИЗ
	|					СчетаУчетаМатериальныхЗапасов)
	|			ТОГДА ВЫБОР
	|					КОГДА ЕПСБУ.Ссылка В
	|							(ВЫБРАТЬ
	|								СчетаУчетаГотовойПродукции.Счет
	|							ИЗ
	|								СчетаУчетаГотовойПродукции)
	|						ТОГДА ""СчетГотовойПродукции""
	|					КОГДА ЕПСБУ.Ссылка В
	|							(ВЫБРАТЬ
	|								СчетаУчетаТоваровНаСкладах.Счет
	|							ИЗ
	|								СчетаУчетаТоваровНаСкладах)
	|						ТОГДА ""СчетТоваровНаСкладах""
	|					КОГДА ЕПСБУ.Ссылка В
	|							(ВЫБРАТЬ
	|								СчетаУчетаТоваровВРознице.Счет
	|							ИЗ
	|								СчетаУчетаТоваровВРознице)
	|						ТОГДА ""СчетТоваровВРознице""
	|					КОГДА ЕПСБУ.Ссылка В
	|							(ВЫБРАТЬ
	|								СчетаУчетаТорговойНаценки.Счет
	|							ИЗ
	|								СчетаУчетаТорговойНаценки)
	|						ТОГДА ""СчетТорговойНаценки""
	|					ИНАЧЕ ""СчетМатериалов""
	|				КОНЕЦ
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаСебестоимостиГотовойПродукции.Счет
	|				ИЗ
	|					СчетаУчетаСебестоимостиГотовойПродукции
	|	
	|				ОБЪЕДИНИТЬ ВСЕ
	|	
	|				ВЫБРАТЬ
	|					СчетаУчетаНакладныхРасходов.Счет
	|				ИЗ
	|					СчетаУчетаНакладныхРасходов
	|	
	|				ОБЪЕДИНИТЬ ВСЕ
	|	
	|				ВЫБРАТЬ
	|					СчетаУчетаОбщехозяйственныхРасходов.Счет
	|				ИЗ
	|					СчетаУчетаОбщехозяйственныхРасходов
	|	
	|				ОБЪЕДИНИТЬ ВСЕ
	|	
	|				ВЫБРАТЬ
	|					СчетаУчетаИздержекОбращения.Счет
	|				ИЗ
	|					СчетаУчетаИздержекОбращения)
	|			ТОГДА ""СчетЗатрат""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаРасчетовСПокупателями.Счет
	|				ИЗ
	|					СчетаУчетаРасчетовСПокупателями)
	|			ТОГДА ""СчетРасчетовСПокупателями""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаРасчетовСПоставщиками.Счет
	|				ИЗ
	|					СчетаУчетаРасчетовСПоставщиками)
	|			ТОГДА ""СчетРасчетовСПоставщиками""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаРасчетовСПодотчетнымиЛицами.Счет
	|				ИЗ
	|					СчетаУчетаРасчетовСПодотчетнымиЛицами)
	|			ТОГДА ""СчетРасчетовСПодотчетнымиЛицами""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаРасчетовСПерсоналом.Счет
	|				ИЗ
	|					СчетаУчетаРасчетовСПерсоналом)
	|			ТОГДА ""СчетРасчетовСПерсоналом""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаРасчетовПоНалогамИСборам.Счет
	|				ИЗ
	|					СчетаУчетаРасчетовПоНалогамИСборам)
	|			ТОГДА ""СчетРасчетовПоНалогамИСборам""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаПрочихРасчетов.Счет
	|				ИЗ
	|					СчетаУчетаПрочихРасчетов)
	|			ТОГДА ""СчетПрочихРасчетов""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаПрочихДоходов.Счет
	|				ИЗ
	|					СчетаУчетаПрочихДоходов)
	|			ТОГДА ""СчетПрочихДоходов""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаПрочихРасходов.Счет
	|				ИЗ
	|					СчетаУчетаПрочихРасходов)
	|			ТОГДА ""СчетПрочихРасходов""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаРасходовБудущихПериодов.Счет
	|				ИЗ
	|					СчетаУчетаРасходовБудущихПериодов)
	|			ТОГДА ""СчетРБП""
	|		КОГДА ЕПСБУ.Ссылка В
	|				(ВЫБРАТЬ
	|					СчетаУчетаРезервовПредстоящихРасходов.Счет
	|				ИЗ
	|					СчетаУчетаРезервовПредстоящихРасходов)
	|			ТОГДА ""СчетРезервовПредстоящихРасходов""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ВидСчетаБУ
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка = &СчетБУ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВидСчетаБУ;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Устарела. Для определения счета расходов НУ с учетом правил определения прямых и косвенных расходов
// следует использовать функцию НалоговыйУчетКлиентСервер.СчетРасходовНУ().
Функция ПолучитьДатуДействующихПравилОпределенияПрямыхРасходовПроизводстваВНУ(Организация, Период) Экспорт
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("КонДата",     КонецГода(Период));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	//Ищем дату действующих правил
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Периоды.ПериодДействия КАК ПериодДействия
	|ИЗ
	|	РегистрСведений.МетодыОпределенияПрямыхРасходовПроизводстваВНУ КАК Периоды
	|ГДЕ
	|	Периоды.Организация = &Организация
	|	И Периоды.ПериодДействия <= &КонДата
	|
	|СГРУППИРОВАТЬ ПО
	|	Периоды.ПериодДействия
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПериодДействия УБЫВ";
	
	Периоды = Запрос.Выполнить().Выгрузить();
	Если Периоды.Количество() > 0 Тогда
		Возврат Периоды[0].ПериодДействия;
	Иначе
		Возврат '00010101';
	КонецЕсли;
	
КонецФункции

// Устарела. Для определения счета расходов НУ с учетом правил определения прямых и косвенных расходов
// следует использовать функцию НалоговыйУчетКлиентСервер.СчетРасходовНУ().
Функция ПолучитьСчетРасходовНУ(СчетБУ, КорСчетБУ, ВидЗатрат, ДатаДействующихПравил, Организация, ИФО, Подразделение) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ПериодДействия", ДатаДействующихПравил);
	Запрос.УстановитьПараметр("Организация",    Организация);
	Запрос.УстановитьПараметр("ИФО",            ИФО);
	Запрос.УстановитьПараметр("Подразделение",  Подразделение);
	Запрос.УстановитьПараметр("СчетБУ",         СчетБУ);
	Запрос.УстановитьПараметр("СчетЗатрат",     СчетБУ);
	Запрос.УстановитьПараметр("КорСчетЗатрат",  КорСчетБУ);
	Запрос.УстановитьПараметр("ВидЗатрат",      ВидЗатрат);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&ИФО КАК ИФО,
	|	&Подразделение КАК Подразделение,
	|	&СчетБУ КАК СчетБУ,
	|	&СчетЗатрат КАК СчетЗатрат,
	|	&КорСчетЗатрат КАК КорСчетЗатрат,
	|	&ВидЗатрат КАК ВидЗатрат
	|ПОМЕСТИТЬ ВремТаблица";
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
	
	ТекстЗапроса = ТекстЗапроса +
		НалоговыйУчет.ТекстЗапросаСчетаУчетаЗатрат() +
		НалоговыйУчет.ТекстЗапросаСчетаУчетаДоходовРасходов() +
		НалоговыйУчет.ТекстЗапросаСписокПрямыхРасходовНУ("ВремТаблица", ДатаДействующихПравил, Организация);
	
	ТекстЗапроса = ТекстЗапроса +
	"ВЫБРАТЬ
	|	ТаблицаПараметров.СчетБУ КАК СчетБУ,
	|	ВЫБОР
	|		КОГДА ТаблицаПараметров.СчетБУ В
	|				(ВЫБРАТЬ
	|					СчетаУчетаСебестоимостиГотовойПродукции.Счет
	|				ИЗ
	|					СчетаУчетаСебестоимостиГотовойПродукции)
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(СписокПрямыхРасходовНУ.ВидЗатратНУ, 0) = 0
	|						ТОГДА &СчетКосвенныеРасходыПроизводстваНУ
	|					ИНАЧЕ &СчетПрямыеРасходыПроизводстваНУ
	|				КОНЕЦ
	|		КОГДА ТаблицаПараметров.СчетБУ В
	|				(ВЫБРАТЬ
	|					СчетаУчетаНакладныхРасходов.Счет
	|				ИЗ
	|					СчетаУчетаНакладныхРасходов)
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(СписокПрямыхРасходовНУ.ВидЗатратНУ, 0) = 0
	|						ТОГДА &СчетКосвенныеНакладныеРасходыНУ
	|					ИНАЧЕ &СчетПрямыеНакладныеРасходыНУ
	|				КОНЕЦ
	|		КОГДА ТаблицаПараметров.СчетБУ В
	|				(ВЫБРАТЬ
	|					СчетаУчетаОбщехозяйственныхРасходов.Счет
	|				ИЗ
	|					СчетаУчетаОбщехозяйственныхРасходов)
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(СписокПрямыхРасходовНУ.ВидЗатратНУ, 0) = 0
	|						ТОГДА &СчетКосвенныеОбщехозяйственныеРасходыНУ
	|					ИНАЧЕ &СчетПрямыеОбщехозяйственныеРасходыНУ
	|				КОНЕЦ
	|		КОГДА ТаблицаПараметров.СчетБУ В
	|				(ВЫБРАТЬ
	|					СчетаУчетаИздержекОбращения.Счет
	|				ИЗ
	|					СчетаУчетаИздержекОбращения)
	|			ТОГДА &СчетИздержкиОбращенияНУ
	|		КОГДА ТаблицаПараметров.СчетБУ В
	|				(ВЫБРАТЬ
	|					СчетаУчетаПрочихРасходов.Счет
	|				ИЗ
	|					СчетаУчетаПрочихРасходов)
	|			ТОГДА &СчетПрочиеРасходыНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ КАК СчетНУ
	|ИЗ
	|	ВремТаблица КАК ТаблицаПараметров
	|		ЛЕВОЕ СОЕДИНЕНИЕ СписокПрямыхРасходовНУ_ВремТаблица КАК СписокПрямыхРасходовНУ
	|		ПО (СписокПрямыхРасходовНУ.ВидЗатратНУ = ТаблицаПараметров.ВидЗатрат.ВидРасходовНУ)
	|			И (ВЫБОР
	|				КОГДА СписокПрямыхРасходовНУ.ИФО <> НЕОПРЕДЕЛЕНО
	|					ТОГДА СписокПрямыхРасходовНУ.ИФО = ТаблицаПараметров.ИФО
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА СписокПрямыхРасходовНУ.Подразделение <> НЕОПРЕДЕЛЕНО
	|					ТОГДА СписокПрямыхРасходовНУ.Подразделение = ТаблицаПараметров.Подразделение
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА СписокПрямыхРасходовНУ.СчетЗатрат <> НЕОПРЕДЕЛЕНО
	|					ТОГДА СписокПрямыхРасходовНУ.СчетЗатрат = ТаблицаПараметров.СчетЗатрат
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА СписокПрямыхРасходовНУ.КорСчетЗатрат <> НЕОПРЕДЕЛЕНО
	|					ТОГДА СписокПрямыхРасходовНУ.КорСчетЗатрат = ТаблицаПараметров.КорСчетЗатрат
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА СписокПрямыхРасходовНУ.ВидЗатрат <> НЕОПРЕДЕЛЕНО
	|					ТОГДА СписокПрямыхРасходовНУ.ВидЗатрат = ТаблицаПараметров.ВидЗатрат
	|				ИНАЧЕ ИСТИНА
