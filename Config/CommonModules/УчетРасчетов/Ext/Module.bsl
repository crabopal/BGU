// * НДСКРаспределениюРезерв - Булево - 
// * ПринятьНДСКВычетуРезерв - Булево - 
// * ОтразитьВГрафикеИсполненияДоговора - ПеречислениеСсылка.СтатусыДокументовКонтрольИсполненияДоговоров - 
Функция ПустаяТаблицаПоступлениеУслугРаботРезерв() Экспорт

	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	ПустаяТаблица = ПустаяТаблицаПоступлениеУслугРаботПоСчетамЗатрат();
	
	// Количество и стоимость услуг, работ.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСВалРезерв", ОписаниеТипаСуммы); // Сумма НДС резерва в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРубРезерв", ОписаниеТипаСуммы); // Сумма НДС резерва в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаВалРезерв", ОписаниеТипаСуммы); // Сумма резерва с НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРубРезерв", ОписаниеТипаСуммы); // Сумма резерва с НДС в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Поступление услуг, работ".
// 
// Параметры:
//  ТаблицаДокумента Таблица документа
//  ТаблицаРасчетовСЗачетомАвансов - Неопределено - Таблица расчетов с зачетом авансов
//  Реквизиты - Структура
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. ПустаяТаблицаПоступлениеУслугРаботРезерв 
Функция ТаблицаПоступлениеУслугРаботРезерв(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов=Неопределено, Реквизиты, Отказ) Экспорт
	
	ТаблицаПоступление = ПустаяТаблицаПоступлениеУслугРаботРезерв();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаПоступление;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
//	РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СтрокаПоступление = ТаблицаПоступление.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоступление, СтрокаДокумента);
		
		СтрокаПоступление.СуммаРуб    = СтрокаДокумента.Сумма;
		СтрокаПоступление.СуммаНДСРуб = СтрокаДокумента.СуммаНДС;
		СтрокаПоступление.СуммаРубРезерв = СтрокаДокумента.СуммаРезерв;
		СтрокаПоступление.СуммаНДСРубРезерв = СтрокаДокумента.СуммаНДСРезерв;
		СтрокаПоступление.СуммаВал    = СтрокаДокумента.Сумма;
		СтрокаПоступление.СуммаНДСВал = СтрокаДокумента.СуммаНДС;
		СтрокаПоступление.СуммаВалРезерв = СтрокаДокумента.СуммаРезерв;
		СтрокаПоступление.СуммаНДСВалРезерв = СтрокаДокумента.СуммаНДСРезерв;
		
	КонецЦикла;
	
	Возврат ТаблицаПоступление;
	
КонецФункции

// Дополнительные расходы, включаемые в стоимость материальных запасов.

// Структура таблицы источника данных "Поступление доп. расходов".
//
Функция ПустаяТаблицаПоступлениеДопРасходов() Экспорт

	ОписаниеТиповСубконто  = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета услуг, работ.
	ПустаяТаблица.Колонки.Добавить("Номенклатура",        Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("Содержание",          Новый ОписаниеТипов("Строка"));
	ПустаяТаблица.Колонки.Добавить("КЭК",                 Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("ВидЗатрат",           Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	
	// Счет и аналитика учета вложений в НФА.
	ПустаяТаблица.Колонки.Добавить("СчетВложений",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("ПартияВложений",        ПланыВидовХарактеристик.ВидыСубконто.Партии.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("КПСВложений",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("ПодразделениеВложений", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("ЦМОВложений",           Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ПустаяТаблица.Колонки.Добавить("НоменклатураВложений",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("ОсновноеСредствоВложений",  Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	
	// Поставщик.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Количество и стоимость услуг, работ.
	ПустаяТаблица.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ПустаяТаблица.Колонки.Добавить("СуммаНДСВал",   ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",   ОписаниеТипаСуммы); // Сумма НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",      ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",      ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("НДСКРаспределению", Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("ПринятьНДСКВычету", Новый ОписаниеТипов("Булево"));
	
	// Контроль исполнения договоров.
	ПустаяТаблица.Колонки.Добавить("ОтразитьВГрафикеИсполненияДоговора",
		Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыДокументовКонтрольИсполненияДоговоров"));
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Поступление доп. расходов".
//
Функция ТаблицаПоступлениеДопРасходов(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов=Неопределено, Реквизиты, Отказ) Экспорт
	
	ТаблицаПоступление = ПустаяТаблицаПоступлениеДопРасходов();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаПоступление;
	КонецЕсли;
	Если НЕ Реквизиты.Свойство("ПартияВложений")
	 ИЛИ НЕ Реквизиты.Свойство("СчетВложений")
	 	И ТипЗнч(Реквизиты.ПартияВложений) <> Тип("ДокументСсылка.ПоступлениеОС")
	 ИЛИ НЕ Реквизиты.Свойство("БазаРаспределения") Тогда
		Возврат ТаблицаПоступление;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
	// Подготовим таблицу базы распределения доп. расходов
	// по остаткам вложений, по указанной партии материальных запасов.
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	Если ТипЗнч(Реквизиты.ПартияВложений) = Тип("ДокументСсылка.ПоступлениеОС") Тогда
		БазаРаспределения = УправлениеОсновнымиСредствами.БазаРаспределенияРасходовНаСоставПартии(
			Реквизиты.ПартияВложений, Реквизиты.БазаРаспределения);
		ИмяКолонкиПоступления = "ОсновноеСредствоВложений";
		ИмяКолонкиРаспределения = "ВнеоборотныйАктив";
	Иначе
		БазаРаспределения = УправлениеМатериальнымиЗапасами.СформироватьБазуРаспределенияРасходовНаПартию(
			ПериодОстатков, Реквизиты.ПартияВложений, Реквизиты.БазаРаспределения, Реквизиты.СчетВложений);
		ИмяКолонкиПоступления = "НоменклатураВложений";
		ИмяКолонкиРаспределения = "Номенклатура";
	КонецЕсли;
	
	Если БазаРаспределения.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru='Не обнаружено остатков вложений на счете ""%1"" по указанной партии ""%2"".'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
			Реквизиты.СчетВложений,
			Реквизиты.ПартияВложений);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка,,, Отказ);
		Возврат ТаблицаПоступление;
	КонецЕсли;
	
	КоэффициентыРаспределения = БазаРаспределения.ВыгрузитьКолонку("БазаРаспределения");
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		// Распределяем сумму услуг на все вложения по данной партии.
		МассивСуммВал = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаДокумента.Сумма,
			КоэффициентыРаспределения);
		МассивСуммРуб = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаДокумента.СуммаРуб,
			КоэффициентыРаспределения);
		МассивСуммНДСВал = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаДокумента.СуммаНДС,
			КоэффициентыРаспределения);
		МассивСуммНДСРуб = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаДокумента.СуммаНДСРуб,
			КоэффициентыРаспределения);
		
		Для Инд = 0 По БазаРаспределения.Количество() - 1 Цикл
			
			СтрокаРаспределения = БазаРаспределения[Инд];
			
			СтрокаПоступление = ТаблицаПоступление.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПоступление, СтрокаДокумента);
			
			СтрокаПоступление.КФО = СтрокаДокумента.КФО;
			
			Если ЗначениеЗаполнено(СтрокаРаспределения.СчетВложений) Тогда
				СтрокаПоступление.СчетВложений      = СтрокаРаспределения.СчетВложений;
			Иначе
				СтрокаПоступление.СчетВложений      = Реквизиты.СчетВложений;
			КонецЕсли;
			СтрокаПоступление.ПартияВложений        = Реквизиты.ПартияВложений;
			СтрокаПоступление.КПСВложений           = СтрокаРаспределения.КПС;
			СтрокаПоступление.ПодразделениеВложений = СтрокаРаспределения.Подразделение;
			СтрокаПоступление.ЦМОВложений           = СтрокаРаспределения.ЦМО;
			СтрокаПоступление[ИмяКолонкиПоступления]  = СтрокаРаспределения[ИмяКолонкиРаспределения];
			
			СтрокаПоступление.СуммаРуб    = ?(МассивСуммРуб = Неопределено,    0, МассивСуммРуб[Инд]);
			СтрокаПоступление.СуммаВал    = ?(МассивСуммВал = Неопределено,    0, МассивСуммВал[Инд]);
			СтрокаПоступление.СуммаНДСРуб = ?(МассивСуммНДСРуб = Неопределено, 0, МассивСуммНДСРуб[Инд]);
			СтрокаПоступление.СуммаНДСВал = ?(МассивСуммНДСВал = Неопределено, 0, МассивСуммНДСВал[Инд]);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаПоступление;
	
КонецФункции

// Услуги оказанные

Функция ПустаяТаблицаРеализацияУслугРаботПоДокументу() Экспорт
	
	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ")); // 120, 130, 180.
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Номенклатура, содержание оказанных услуг.
	ПустаяТаблица.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("Содержание",    ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(254));
	// Покупатель.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Аналитика доходов БУ и НУ.
	ПустаяТаблица.Колонки.Добавить("КодЦели",               Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	ПустаяТаблица.Колонки.Добавить("ВидОперацииДБП",        Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийНачисленияДБП"));
	ПустаяТаблица.Колонки.Добавить("СчетДБП",               Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СчетДоходов",           Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СубконтоДоходов1" ,     Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	ПустаяТаблица.Колонки.Добавить("СубконтоДоходов2" ,     Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	ПустаяТаблица.Колонки.Добавить("СубконтоДоходов3" ,     Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	ПустаяТаблица.Колонки.Добавить("ВидДеятельностиНУ",     Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДеятельностиДляНалоговогоУчетаЗатрат"));
	ПустаяТаблица.Колонки.Добавить("СчетДоходовНУ",         Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СтатьяПрочихДоходовНУ", Новый ОписаниеТипов("СправочникСсылка.ПрочиеДоходыИРасходы"));
	// Контроль исполнения договоров.
	ПустаяТаблица.Колонки.Добавить("ОтразитьВГрафикеИсполненияДоговора",
		Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыДокументовКонтрольИсполненияДоговоров"));
	// Количественные и суммовые характеристики.
	ПустаяТаблица.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("Сумма",         ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ПустаяТаблица.Колонки.Добавить("СуммаНДС",      ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРубПоКурсуДБП", ОписаниеТипаСуммы); // Сумма в рублях по курсу доходов будущих периодов, определяемому по остатку 401.4х.
	
	ПустаяТаблица.Колонки.Добавить("КомиссионнаяТорговля", Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("Комитент",             Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("ДоговорКомитента",     Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	
	Возврат ПустаяТаблица;
	
КонецФункции

// Услуги оказанные

// Подготавливает таблицу документа (в унифицированном формате) для учета реализации услуг, работ.
//
Функция ПодготовитьТаблицуРеализацияУслугРаботПоДокументу(Документ, Параметры = Неопределено) Экспорт
	
	ТаблицаДокумента = ПустаяТаблицаРеализацияУслугРаботПоДокументу();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	Если НЕ Параметры.Свойство("КЭК") Тогда
		Если Параметры.Свойство("КЭКРасчетов") И ЗначениеЗаполнено(Параметры.КЭКРасчетов) Тогда
			Параметры.Вставить("КЭК", Параметры.КЭКРасчетов);
		Иначе
			Параметры.Вставить("КЭК", Справочники.КОСГУ.ПустаяСсылка());
		КонецЕсли;
	КонецЕсли;
	Если НЕ Параметры.Свойство("ОтразитьВГрафикеИсполненияДоговора") Тогда
		// Если в документе, таб.части и типовой операции нет реквизита ОтразитьВГрафикеИсполненияДоговора,
		// по умолчанию будем отражать в графике исполнения договора.
		Параметры.Вставить("ОтразитьВГрафикеИсполненияДоговора",
			Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас);
	КонецЕсли;
	
	МетаданныеДокумента = Документ.Метаданные();
	Если МетаданныеДокумента.Имя = "НачислениеЗаУслугиОбразования" Тогда
		Возврат Документы.НачислениеЗаУслугиОбразования.ПодготовитьТаблицуРеализацияУслугРаботПоДокументу(Документ, Параметры);
	ИначеЕсли МетаданныеДокумента.Имя = "НачислениеСтудентамЗаПрочиеУслуги" Тогда
		Возврат Документы.НачислениеСтудентамЗаПрочиеУслуги.ПодготовитьТаблицуРеализацияУслугРаботПоДокументу(Документ, Параметры);
	ИначеЕсли МетаданныеДокумента.Имя = "СписаниеДоходовБудущихПериодов" Тогда
		Возврат Документы.СписаниеДоходовБудущихПериодов.ПодготовитьТаблицуРеализацияУслугРаботПоДокументу(Документ, Параметры);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ЕстьТабЧастьУслугиОказанные  = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("УслугиОказанные", МетаданныеДокумента);
	ЕстьТабЧастьСоставЭтапаРабот = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("СоставЭтапаРабот", МетаданныеДокумента);
	ЕстьТабЧастьНачисления       = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("Начисления", МетаданныеДокумента);
	
	Если ЕстьТабЧастьУслугиОказанные Тогда
		
		Если НЕ Параметры.Свойство("СчетДоходов") Тогда
			Параметры.Вставить("СчетДоходов", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
		КонецЕсли;
		Если НЕ Параметры.Свойство("СубконтоДоходов1") Тогда
			Параметры.Вставить("СубконтоДоходов1", "");
		КонецЕсли;
		Если НЕ Параметры.Свойство("СубконтоДоходов2") Тогда
			Параметры.Вставить("СубконтоДоходов2", "");
		КонецЕсли;
		Если НЕ Параметры.Свойство("СубконтоДоходов3") Тогда
			Параметры.Вставить("СубконтоДоходов3", "");
		КонецЕсли;
		Если НЕ Параметры.Свойство("ВидДеятельностиНУ") Тогда
			Параметры.Вставить("ВидДеятельностиНУ", Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ПустаяСсылка());
		КонецЕсли;
		Если НЕ Параметры.Свойство("СчетДоходовНУ") Тогда
			Параметры.Вставить("СчетДоходовНУ", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
		КонецЕсли;
		Если НЕ Параметры.Свойство("СтатьяПрочихДоходовНУ") Тогда
			Параметры.Вставить("СтатьяПрочихДоходовНУ", Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка());
		КонецЕсли;
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "УслугиОказанные",
			"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,Контрагент,Договор,ВалютаДокумента,
			|Номенклатура,СодержаниеУслуги,Количество,Сумма,Всего,СтавкаНДС,КомиссионнаяТорговля,Комитент,ДоговорКомитента,СуммаНДС,
			|СчетДоходов,СубконтоДоходов1,СубконтоДоходов2,СубконтоДоходов3,ВидДеятельностиНУ,СчетДоходовНУ,СтатьяПрочихДоходовНУ,
			|ОтразитьВГрафикеИсполненияДоговора",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""УслугиОказанные"" КАК ИмяСписка,
		|	""Услуги"" КАК СинонимСписка,
		|	УслугиОказанные.НомерСтроки КАК НомерСтроки,
		|	УслугиОказанные.ИФО КАК ИФО,
		|	УслугиОказанные.КФО КАК КФО,
		|	УслугиОказанные.КПС КАК КПС,
		|	УслугиОказанные.КЭК КАК КЭК,
		|	УслугиОказанные.Подразделение КАК Подразделение,
		|	УслугиОказанные.Номенклатура КАК Номенклатура,
		|	УслугиОказанные.СодержаниеУслуги КАК Содержание,
		|	УслугиОказанные.Контрагент КАК Контрагент,
		|	УслугиОказанные.Договор КАК Договор,
		|	УслугиОказанные.СчетДоходов КАК СчетДоходов,
		|	УслугиОказанные.СубконтоДоходов1 КАК СубконтоДоходов1,
		|	УслугиОказанные.СубконтоДоходов2 КАК СубконтоДоходов2,
		|	УслугиОказанные.СубконтоДоходов3 КАК СубконтоДоходов3,
		|	УслугиОказанные.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
		|	УслугиОказанные.СчетДоходовНУ КАК СчетДоходовНУ,
		|	УслугиОказанные.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ,
		|	УслугиОказанные.ОтразитьВГрафикеИсполненияДоговора КАК ОтразитьВГрафикеИсполненияДоговора,
		|	УслугиОказанные.ВалютаДокумента КАК Валюта,
		|	УслугиОказанные.Количество КАК Количество,
		|	УслугиОказанные.Всего КАК Сумма,
		|	УслугиОказанные.СтавкаНДС КАК СтавкаНДС,
		|	УслугиОказанные.КомиссионнаяТорговля КАК КомиссионнаяТорговля,
		|	УслугиОказанные.Комитент КАК Комитент,
		|	УслугиОказанные.ДоговорКомитента КАК ДоговорКомитента,
		|	УслугиОказанные.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	ТаблицаУслугиОказанные КАК УслугиОказанные
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	ИначеЕсли ЕстьТабЧастьСоставЭтапаРабот Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "СоставЭтапаРабот",
			"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,Контрагент,Договор,ВалютаДокумента,
			|Номенклатура,Содержание,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС,
			|СчетДБП,ВидДеятельностиНУ,СчетДоходовНУ,
			|ОтразитьВГрафикеИсполненияДоговора",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""СоставЭтапаРабот"" КАК ИмяСписка,
		|	""Состав этапа работ"" КАК СинонимСписка,
		|	СоставЭтапаРабот.НомерСтроки КАК НомерСтроки,
		|	СоставЭтапаРабот.ИФО КАК ИФО,
		|	СоставЭтапаРабот.КФО КАК КФО,
		|	СоставЭтапаРабот.КПС КАК КПС,
		|	СоставЭтапаРабот.КЭК КАК КЭК,
		|	СоставЭтапаРабот.Подразделение КАК Подразделение,
		|	СоставЭтапаРабот.Номенклатура КАК Номенклатура,
		|	СоставЭтапаРабот.Содержание КАК Содержание,
		|	СоставЭтапаРабот.Контрагент КАК Контрагент,
		|	СоставЭтапаРабот.Договор КАК Договор,
		|	СоставЭтапаРабот.СчетДБП КАК СчетДБП,
		|	НЕОПРЕДЕЛЕНО КАК СчетДоходов,
		|	НЕОПРЕДЕЛЕНО КАК СубконтоДоходов1,
		|	НЕОПРЕДЕЛЕНО КАК СубконтоДоходов2,
		|	НЕОПРЕДЕЛЕНО КАК СубконтоДоходов3,
		|	СоставЭтапаРабот.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
		|	СоставЭтапаРабот.СчетДоходовНУ КАК СчетДоходовНУ,
		|	НЕОПРЕДЕЛЕНО КАК СтатьяПрочихДоходовНУ,
		|	СоставЭтапаРабот.ОтразитьВГрафикеИсполненияДоговора КАК ОтразитьВГрафикеИсполненияДоговора,
		|	СоставЭтапаРабот.ВалютаДокумента КАК Валюта,
		|	СоставЭтапаРабот.Количество КАК Количество,
		|	СоставЭтапаРабот.Всего КАК Сумма,
		|	СоставЭтапаРабот.СтавкаНДС КАК СтавкаНДС,
		|	СоставЭтапаРабот.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	ТаблицаСоставЭтапаРабот КАК СоставЭтапаРабот
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	ИначеЕсли ЕстьТабЧастьНачисления Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Начисления",
			"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,Контрагент,ДоговорКонтрагента,ВалютаДокумента,
			|Номенклатура,Количество,Сумма,СтавкаНДС,СуммаНДС,УчитыватьНДС,СуммаВключаетНДС,
			|СчетДоходов,СубконтоДоходов1,СубконтоДоходов2,СубконтоДоходов3,ВидДеятельностиНУ,СчетДоходовНУ,СтатьяПрочихДоходовНУ,
			|ОтразитьВГрафикеИсполненияДоговора",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""Начисления"" КАК ИмяСписка,
		|	""Начисления"" КАК СинонимСписка,
		|	Начисления.НомерСтроки КАК НомерСтроки,
		|	Начисления.ИФО КАК ИФО,
		|	Начисления.КФО КАК КФО,
		|	Начисления.КПС КАК КПС,
		|	Начисления.КЭК КАК КЭК,
		|	Начисления.Подразделение КАК Подразделение,
		|	Начисления.Номенклатура КАК Номенклатура,
		|	ВЫРАЗИТЬ(ВЫРАЗИТЬ(Начисления.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное КАК СТРОКА(254)) КАК Содержание,
		|	Начисления.Контрагент КАК Контрагент,
		|	Начисления.ДоговорКонтрагента КАК Договор,
		|	Начисления.СчетДоходов КАК СчетДоходов,
		|	Начисления.СубконтоДоходов1 КАК СубконтоДоходов1,
		|	Начисления.СубконтоДоходов2 КАК СубконтоДоходов2,
		|	Начисления.СубконтоДоходов3 КАК СубконтоДоходов3,
		|	Начисления.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
		|	Начисления.СчетДоходовНУ КАК СчетДоходовНУ,
		|	Начисления.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ,
		|	Начисления.ОтразитьВГрафикеИсполненияДоговора КАК ОтразитьВГрафикеИсполненияДоговора,
		|	Начисления.ВалютаДокумента КАК Валюта,
		|	Начисления.Количество КАК Количество,
		|	ВЫБОР
		|		КОГДА Начисления.УчитыватьНДС
		|				И НЕ Начисления.СуммаВключаетНДС
		|			ТОГДА Начисления.Сумма + Начисления.СуммаНДС
		|		ИНАЧЕ Начисления.Сумма
		|	КОНЕЦ КАК Сумма,
		|	Начисления.СтавкаНДС КАК СтавкаНДС,
		|	Начисления.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	ТаблицаНачисления КАК Начисления
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		
	КонецЕсли;
	
	РеализацияУслугРабот = Запрос.Выполнить().Выгрузить();
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// Счет расчетов.
	СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Реализация",
		Документ.Дата, Документ.Организация, Документ.ИФО);
	
	Для Каждого Строка Из РеализацияУслугРабот Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Не ИспользоватьВалютныйУчет И Не ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СчетРасчетов) Тогда
			НоваяСтрока.СчетРасчетов = СчетРасчетов;
		ИначеЕсли ЗначениеЗаполнено(НоваяСтрока.КЭК) Тогда
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрока.КЭК,
				?(Параметры.Свойство("СчетРасчетов") И ЗначениеЗаполнено(Параметры.СчетРасчетов), Параметры.СчетРасчетов, "205.00"), ,
				Документ.Дата, Документ.Организация, Строка.ИФО);
		Иначе // По умолчанию - 205.31.
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.31", Документ.Дата, Документ.Организация);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.КЭК) Тогда
			НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(НоваяСтрока.СчетРасчетов);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

