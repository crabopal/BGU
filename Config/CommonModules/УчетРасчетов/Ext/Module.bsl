		Запрос.УстановитьПараметр("ЭтоПоступлениеДенежныхСредств", ЭтоПоступлениеДенежныхСредств);
		Запрос.УстановитьПараметр("ОтражениеАвансаУСН",
			?(Реквизиты.Свойство("ОтражениеАвансаУСН"), Реквизиты.ОтражениеАвансаУСН,
				Перечисления.ПорядокОтраженияАвансовУСН.ПустаяСсылка()));
		
		ДвижениеДенежныхСредств = Запрос.Выполнить().Выгрузить();
		
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("КорСчет", МетаданныеДокумента) Тогда
			
			Если БухгалтерскийУчет.СчетВИерархии(Документ.КорСчет, "206.00") Тогда
				// В новых типовых операциях, вместо доп.реквизита "Авансовый платеж",
				// счет расчетов 206.00 или 302.00 устанавливается явно в реквизите КорСчет.
				Реквизиты.Вставить("ЭтоАвансовыйПлатеж", Истина);
			КонецЕсли;
			
			Если БухгалтерскийУчет.СчетВИерархии(Документ.КорСчет, "208.00") Тогда
				// Для корректного определения счета расчетов по КЭК далее.
				Реквизиты.Вставить("СчетРасчетов", Документ.КорСчет);
			КонецЕсли;
			
		КонецЕсли;
		
		ЕстьКонвертацияВалюты = Ложь;
		Если МетаданныеДокумента.Имя = "КассовоеВыбытие" Тогда
			ВалютаИТипЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ.ЛицевойСчет, "ВалютаСчета, ТипЛицевогоСчета");
			ВалютаЛицевогоСчета = ВалютаИТипЛицевогоСчета.ВалютаСчета;
			ТипЛицевогоСчета = ВалютаИТипЛицевогоСчета.ТипЛицевогоСчета;
			Если ЗначениеЗаполнено(ВалютаЛицевогоСчета)
				И Документ.ВалютаДокумента <> ВалютаЛицевогоСчета
				И ТипЛицевогоСчета = ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Банковский")
				И БухгалтерскийУчет.СчетВИерархии(Документ.КорСчет, "206.00, 302.00") Тогда
				ЕстьКонвертацияВалюты = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если (МетаданныеДокумента.Имя = "ЗаявкаНаКассовыйРасход" ИЛИ МетаданныеДокумента.Имя = "РСКППеречисление")
			И Документ.ВалютаДокумента <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()
			И БухгалтерскийУчет.СчетВИерархии(Документ.КорСчет, "206.00, 302.00")
			И (НЕ ЗначениеЗаполнено(Документ.Договор)
				ИЛИ НЕ РаботаСОбязательствами.СведенияОВалютеОбязательства(Документ.Договор).ОплатаВРублях) Тогда
			
			КурсПересчета = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Документ.Ссылка).Курс;
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(
				Документ.СуммаДокументаВВалюте * КурсПересчета, ДвижениеДенежныхСредств, "СуммаРуб", "СуммаРасчетов");
			
			Если КурсПересчета = 0 Тогда
				ТекстСообщения = НСтр("ru = 'Курс иностранной валюты выписки не заполнен, проводки будут сформированы с нулевой суммой!'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка, , "Объект");
			КонецЕсли;
			
		КонецЕсли;
		
		ОбязательноУказыватьПодразделение = Ложь;
		
		Для Каждого Строка Из ДвижениеДенежныхСредств Цикл
			
			Если НЕ ЗначениеЗаполнено(Строка.ИсточникСредств) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru='ИсточникСредств'"),
					Строка.НомерСтроки, Строка.СинонимСписка);
				ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].ИсточникСредств";
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Строка.КПС) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru='КБК'"), Строка.НомерСтроки, Строка.СинонимСписка);
				ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].КБКНазначениеПлатежа";
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Строка.КЭК)
				И НЕ ЭтоКорСчет30401 Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru='КОСГУ'"), Строка.НомерСтроки, Строка.СинонимСписка);
				ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].КОСГУНазначениеПлатежа";
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
			КонецЕсли;
			
			Если Отказ Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = РасшифровкаПлатежа.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
			НоваяСтрока.ЭтоАвансовыйПлатеж = Реквизиты.Свойство("ЭтоАвансовыйПлатеж") И Реквизиты.ЭтоАвансовыйПлатеж;
			
			НоваяСтрока.НазначениеПлатежа = СокрЛП(Строка.СтрокаНазначениеПлатежа);
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.СчетРасчетов) И Реквизиты.Свойство("СчетРасчетов") Тогда
				// Автоматическое определение счета при проведении работает только если в расшифровке платежа СчетРасчетов не заполнен.
				Если БухгалтерскийУчет.СчетВИерархии(Реквизиты.СчетРасчетов, "205.00") Тогда
					Если ИспользуетсяСчетАП Тогда
						НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
							Строка.КЭК, "205.00", , ПериодОстатков, Документ.Организация, Строка.ИФО);
					ИначеЕсли НЕ НоваяСтрока.ЭтоАвансовыйПлатеж Тогда
						НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
							Строка.КЭК, "205.00", , ПериодОстатков, Документ.Организация, Строка.ИФО);
					Иначе // "Старые" счета учета авансов полученных получаем без ограничения по дате действия.
						НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
							Строка.КЭК, "205.2А,205.3А,205.7А,205.8А");
					КонецЕсли;
				ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Реквизиты.СчетРасчетов, "209.00") Тогда
					Если ИспользуетсяСчетАП Тогда
						НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
							Строка.КЭК, "209.00", , ПериодОстатков, Документ.Организация, Строка.ИФО);
					ИначеЕсли НЕ НоваяСтрока.ЭтоАвансовыйПлатеж Тогда
						НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
							Строка.КЭК, "209.00", , ПериодОстатков, Документ.Организация, Строка.ИФО);
					Иначе // "Старые" счета учета авансов полученных получаем без ограничения по дате действия.
						НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
							Строка.КЭК, "209.7А,209.8А");
					КонецЕсли;
				ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Реквизиты.СчетРасчетов, "206.00,302.00") Тогда
					НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
						Строка.КЭК, ?(НоваяСтрока.ЭтоАвансовыйПлатеж, "206.00", "302.00"), , ПериодОстатков, Документ.Организация, Строка.ИФО);
				ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Реквизиты.СчетРасчетов, "208.00") Тогда
					НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
						Строка.КЭК, "208.00", , ПериодОстатков, Документ.Организация, Строка.ИФО);
				ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Реквизиты.СчетРасчетов, "207.00,301.00,304.01,304.03,210.05") Тогда
					НоваяСтрока.СчетРасчетов = Реквизиты.СчетРасчетов; // Счет расчетов не определяется по КЭК, передается параметром.
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НоваяСтрока.СчетРасчетов) Тогда
				
				СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетРасчетов);
				ОбязательноУказыватьПодразделение = ОбязательноУказыватьПодразделение
					ИЛИ (СвойстваСчетаРасчетов.УчетПоПодразделениям И НЕ СвойстваСчетаРасчетов.РазрешитьНеУказыватьПодразделение);
				
				Если ЗаполнениеДоговораОбязательно(НоваяСтрока.СчетРасчетов) Тогда
					
					Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("Договор", МетаданныеДокумента, Строка.ИмяСписка) Тогда
						
						Если НЕ ЗначениеЗаполнено(Строка.Договор) Тогда
							ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
								МетаданныеДокумента.ТабличныеЧасти[Строка.ИмяСписка].Реквизиты.Договор.Синоним,
								Строка.НомерСтроки, Строка.СинонимСписка);
							ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].Договор";
							БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
						КонецЕсли;
						
					ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Договор", МетаданныеДокумента) Тогда
						
						Если НЕ ЗначениеЗаполнено(Документ.Договор) Тогда
							ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
								"Поле", "Заполнение", НСтр("ru = 'Договор'"));
							БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.Договор", Отказ);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				ТекстСообщения = НСтр("ru='Невозможно определить счет расчетов с контрагентом по КОСГУ ""%1"".
					|Проверьте настройки соответствия аналитических счетов КОСГУ.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Строка.КЭК);
				ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].КОСГУНазначениеПлатежа";
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
			КонецЕсли;
			
			Если ЕстьКонвертацияВалюты Тогда
				НоваяСтрока.ПроданнаяВалюта = ВалютаЛицевогоСчета;
				Если ДвижениеДенежныхСредств.Индекс(Строка) = ДвижениеДенежныхСредств.Количество() - 1 Тогда
					НоваяСтрока.СуммаПроданнойВалюты = Документ.СуммаПроданнойВалюты - РасшифровкаПлатежа.Итог("СуммаПроданнойВалюты");
				Иначе
					НоваяСтрока.СуммаПроданнойВалюты = Документ.СуммаПроданнойВалюты*Строка.СуммаРасчетов/ДвижениеДенежныхСредств.Итог("СуммаРасчетов");
				КонецЕсли;
			Иначе
				НоваяСтрока.ПроданнаяВалюта = Строка.Валюта;
				НоваяСтрока.СуммаПроданнойВалюты = Строка.СуммаРасчетов;
			КонецЕсли;   
			
			//00-00014281 - добавляем подразделение из шапки
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.Подразделение) И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Подразделение", МетаданныеДокумента) Тогда
				НоваяСтрока.Подразделение = Документ.Подразделение; 
			КонецЕсли;	
			
			//00-00014281 перенесено внутрь цикла, проверка подразделения в строке
			Если ИспользоватьУчетПоПодразделениям И ОбязательноУказыватьПодразделение
				И НЕ ЗначениеЗаполнено(НоваяСтрока.Подразделение) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru='Подразделение'"));
				ТекстСообщения = ТекстСообщения + НСтр("ru='. Учет расчетов ведется по подразделениям.'");
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.Подразделение", Отказ);
			КонецЕсли;
			
		КонецЦикла;
				
	ИначеЕсли МетаданныеДокумента.Имя = "ЗаявкаНаВозврат"
		  ИЛИ МетаданныеДокумента.Имя = "ЗаявкаНаКассовыйРасходСокращенная"
		  ИЛИ МетаданныеДокумента.Имя = "ЭквайринговаяОперация" Тогда
		
		// Проверим обязательные реквизиты шапки.
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Контрагент", МетаданныеДокумента)
		   И НЕ ЗначениеЗаполнено(Документ.Контрагент) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'Получатель платежа'"));
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.Контрагент", Отказ);
		КонецЕсли;
		Если Отказ Тогда
			Возврат РасшифровкаПлатежа;
		КонецЕсли;
		
		Если МетаданныеДокумента.Имя = "ЭквайринговаяОперация" Тогда
		
			ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Документ",
				"ИФО,КФО,КБКНазначениеПлатежа,КОСГУНазначениеПлатежа,Подразделение,Контрагент,Договор,
				|СчетРасчетов,СпособПогашенияЗадолженности,ДопСубконтоРасчетов,ВидРасчетов,ОплатитьДо,
				|ИсточникСредств,ДопКлассификация,КодМероприятия,КодЦели,ОтражениеАвансаУСН,СуммаДокумента",
				Документ, Реквизиты);
			
			Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ
			|	&ЭтоПоступлениеДенежныхСредств КАК ЭтоПоступление,
			|	РасшифровкаПлатежа.ИФО КАК ИФО,
			|	РасшифровкаПлатежа.Подразделение КАК Подразделение,
			|	РасшифровкаПлатежа.КФО КАК КФО,
			|	РасшифровкаПлатежа.КБКНазначениеПлатежа КАК КПС,
			|	РасшифровкаПлатежа.КОСГУНазначениеПлатежа КАК КЭК,
			|	РасшифровкаПлатежа.Контрагент КАК Контрагент,
			|	РасшифровкаПлатежа.Договор КАК Договор,
			|	РасшифровкаПлатежа.Договор.ВидДоговора КАК ВидДоговора,
			|	РасшифровкаПлатежа.Договор.ВестиГрафикПлатежей КАК ВестиГрафикПлатежей,
			|	&ВалютаРеглУчета КАК Валюта,
			|	РасшифровкаПлатежа.СчетРасчетов КАК СчетРасчетов,
			|	РасшифровкаПлатежа.СпособПогашенияЗадолженности КАК СпособПогашенияЗадолженности,
			|	РасшифровкаПлатежа.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
			|	РасшифровкаПлатежа.ВидРасчетов КАК ВидРасчетов,
			|	РасшифровкаПлатежа.ОплатитьДо КАК ОплатитьДо,
			|	РасшифровкаПлатежа.ИсточникСредств КАК ИсточникСредств,
			|	РасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
			|	РасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
			|	РасшифровкаПлатежа.КодЦели КАК КодЦели,
			|	&НазначениеПлатежа КАК НазначениеПлатежа,
			|	"""" КАК СтрокаНазначениеПлатежа,
			|	РасшифровкаПлатежа.СуммаДокумента КАК СуммаРасчетов,
			|	РасшифровкаПлатежа.СуммаДокумента КАК СуммаРуб,
			|	РасшифровкаПлатежа.ОтражениеАвансаУСН КАК ОтражениеАвансаУСН
			|ИЗ
			|	Документ КАК РасшифровкаПлатежа";
			
			Если Документ.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой Или
				Документ.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЧерезСервисПриемаПлатежей Или
				Документ.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЭлектроннымиСредствамиПлатежаПоРеестру Тогда 
				ЭтоПоступлениеДенежныхСредств = Истина;
			Иначе
				ЭтоПоступлениеДенежныхСредств = Ложь;
			КонецЕсли;
			Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
			Запрос.УстановитьПараметр("ЭтоПоступлениеДенежныхСредств", ЭтоПоступлениеДенежныхСредств);
			Запрос.УстановитьПараметр("НазначениеПлатежа", ?(ЭтоПоступлениеДенежныхСредств,
				НСтр("ru='Оплата платежной картой'"),
				НСтр("ru='Возврат оплаты платежной картой'")) );
				
		ИначеЕсли МетаданныеДокумента.Имя = "ЗаявкаНаВозврат" Тогда
			
			ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Документ",
				"ИФО,КФО,КБКНазначениеПлатежа,КОСГУНазначениеПлатежа,Подразделение,Контрагент,Договор,
				|СчетРасчетов,СпособПогашенияЗадолженности,ДопСубконтоРасчетов,ВидРасчетов,ОплатитьДо,
				|ИсточникСредств,ДопКлассификация,КодМероприятия,КодЦели,ВалютаДокумента,
				|НазначениеПлатежа,СуммаДокумента,СуммаДокументаВВалюте",
				Документ, Реквизиты);
			
			Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ
			|	ЛОЖЬ КАК ЭтоПоступление,
			|	РасшифровкаПлатежа.ИФО КАК ИФО,
			|	РасшифровкаПлатежа.Подразделение КАК Подразделение,
			|	РасшифровкаПлатежа.КФО КАК КФО,
			|	РасшифровкаПлатежа.КБКНазначениеПлатежа КАК КПС,
			|	РасшифровкаПлатежа.КОСГУНазначениеПлатежа КАК КЭК,
			|	РасшифровкаПлатежа.Контрагент КАК Контрагент,
			|	РасшифровкаПлатежа.Договор КАК Договор,
			|	РасшифровкаПлатежа.Договор.ВидДоговора КАК ВидДоговора,
			|	РасшифровкаПлатежа.Договор.ВестиГрафикПлатежей КАК ВестиГрафикПлатежей,
			|	РасшифровкаПлатежа.ВалютаДокумента КАК Валюта,
			|	РасшифровкаПлатежа.СчетРасчетов КАК СчетРасчетов,
			|	РасшифровкаПлатежа.СпособПогашенияЗадолженности КАК СпособПогашенияЗадолженности,
			|	РасшифровкаПлатежа.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
			|	РасшифровкаПлатежа.ВидРасчетов КАК ВидРасчетов,
			|	РасшифровкаПлатежа.ОплатитьДо КАК ОплатитьДо,
			|	РасшифровкаПлатежа.ИсточникСредств КАК ИсточникСредств,
			|	РасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
			|	РасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
			|	РасшифровкаПлатежа.КодЦели КАК КодЦели,
			|	РасшифровкаПлатежа.НазначениеПлатежа КАК НазначениеПлатежа,
			|	РасшифровкаПлатежа.СуммаДокументаВВалюте КАК СуммаРасчетов,
			|	РасшифровкаПлатежа.СуммаДокумента КАК СуммаРуб,
			|	ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияАвансовУСН.ПустаяСсылка) КАК ОтражениеАвансаУСН
			|ИЗ
			|	Документ КАК РасшифровкаПлатежа";
			
		Иначе
			
			// В этих документах расчеты только в рублях, даже если документ оформлен в валюте.
			ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Документ",
				"ИФО,КФО,КБКНазначениеПлатежа,КОСГУНазначениеПлатежа,Подразделение,Контрагент,Договор,
				|СчетРасчетов,СпособПогашенияЗадолженности,ДопСубконтоРасчетов,ВидРасчетов,ОплатитьДо,
				|ИсточникСредств,ДопКлассификация,КодМероприятия,КодЦели,
				|НазначениеПлатежа,СуммаДокумента",
				Документ, Реквизиты);
			
			Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ
			|	ЛОЖЬ КАК ЭтоПоступление,
			|	РасшифровкаПлатежа.ИФО КАК ИФО,
			|	РасшифровкаПлатежа.Подразделение КАК Подразделение,
			|	РасшифровкаПлатежа.КФО КАК КФО,
			|	РасшифровкаПлатежа.КБКНазначениеПлатежа КАК КПС,
			|	РасшифровкаПлатежа.КОСГУНазначениеПлатежа КАК КЭК,
			|	РасшифровкаПлатежа.Контрагент КАК Контрагент,
			|	РасшифровкаПлатежа.Договор КАК Договор,
			|	РасшифровкаПлатежа.Договор.ВидДоговора КАК ВидДоговора,
			|	РасшифровкаПлатежа.Договор.ВестиГрафикПлатежей КАК ВестиГрафикПлатежей,
			|	&ВалютаРеглУчета КАК Валюта,
			|	РасшифровкаПлатежа.СчетРасчетов КАК СчетРасчетов,
			|	РасшифровкаПлатежа.СпособПогашенияЗадолженности КАК СпособПогашенияЗадолженности,
			|	РасшифровкаПлатежа.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
			|	РасшифровкаПлатежа.ВидРасчетов КАК ВидРасчетов,
			|	РасшифровкаПлатежа.ОплатитьДо КАК ОплатитьДо,
			|	РасшифровкаПлатежа.ИсточникСредств КАК ИсточникСредств,
			|	РасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
			|	РасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
			|	РасшифровкаПлатежа.КодЦели КАК КодЦели,
			|	РасшифровкаПлатежа.НазначениеПлатежа КАК НазначениеПлатежа,
			|	РасшифровкаПлатежа.СуммаДокумента КАК СуммаРасчетов,
			|	РасшифровкаПлатежа.СуммаДокумента КАК СуммаРуб,
			|	ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияАвансовУСН.ПустаяСсылка) КАК ОтражениеАвансаУСН
			|ИЗ
			|	Документ КАК РасшифровкаПлатежа";
			Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
			
		КонецЕсли;
		
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("КорСчет", МетаданныеДокумента) Тогда
			
			Если БухгалтерскийУчет.СчетВИерархии(Документ.КорСчет, "206.00") Тогда
				// В новых типовых операциях, вместо доп.реквизита "Авансовый платеж",
				// счет расчетов 206.00 или 302.00 устанавливается явно в реквизите КорСчет.
				Реквизиты.Вставить("ЭтоАвансовыйПлатеж", Истина);
			КонецЕсли;
			
			Если БухгалтерскийУчет.СчетВИерархии(Документ.КорСчет, "208.00") Тогда
				// Для корректного определения счета расчетов по КЭК далее.
				Реквизиты.Вставить("СчетРасчетов", Документ.КорСчет);
			КонецЕсли;
			
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			НоваяСтрока = РасшифровкаПлатежа.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			НоваяСтрока.ЭтоАвансовыйПлатеж = Реквизиты.Свойство("ЭтоАвансовыйПлатеж") И Реквизиты.ЭтоАвансовыйПлатеж;
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.СчетРасчетов) И Реквизиты.Свойство("СчетРасчетов") Тогда
				// Автоматическое определение счета при проведении работает только если в расшифровке платежа СчетРасчетов не заполнен.
				Если БухгалтерскийУчет.СчетВИерархии(Реквизиты.СчетРасчетов, "205.00") Тогда
					Если ИспользуетсяСчетАП Тогда
						НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
							Выборка.КЭК, "205.00", , ПериодОстатков, Документ.Организация, Выборка.ИФО);
					ИначеЕсли НЕ НоваяСтрока.ЭтоАвансовыйПлатеж Тогда
						НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
							Выборка.КЭК, "205.00", , ПериодОстатков, Документ.Организация, Выборка.ИФО);
					Иначе // "Старые" счета учета авансов полученных получаем без ограничения по дате действия.
						НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
							Выборка.КЭК, "205.2А,205.3А,205.7А,205.8А");
					КонецЕсли;
				ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Реквизиты.СчетРасчетов, "209.00") Тогда
					Если ИспользуетсяСчетАП Тогда
						НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
							Выборка.КЭК, "209.00", , ПериодОстатков, Документ.Организация, Выборка.ИФО);
					ИначеЕсли НЕ НоваяСтрока.ЭтоАвансовыйПлатеж Тогда
						НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
							Выборка.КЭК, "209.00", , ПериодОстатков, Документ.Организация, Выборка.ИФО);
					Иначе // "Старые" счета учета авансов полученных получаем без ограничения по дате действия.
						НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
							Выборка.КЭК, "209.7А,209.8А");
					КонецЕсли;
				ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Реквизиты.СчетРасчетов, "206.00,302.00") Тогда
					НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
						Выборка.КЭК, ?(НоваяСтрока.ЭтоАвансовыйПлатеж, "206.00", "302.00"), , ПериодОстатков, Документ.Организация, Выборка.ИФО);
				ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Реквизиты.СчетРасчетов, "208.00") Тогда
					НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
						Выборка.КЭК, "208.00", , ПериодОстатков, Документ.Организация, Выборка.ИФО);
				ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Реквизиты.СчетРасчетов, "207.00,301.00,304.01,304.03") Тогда
					НоваяСтрока.СчетРасчетов = Реквизиты.СчетРасчетов; // Счет расчетов не определяется по КЭК, передается параметром.
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.СчетРасчетов) Тогда
				ТекстСообщения = НСтр("ru='Невозможно определить счет расчетов с контрагентом по КОСГУ ""%1"".
					|Проверьте настройки соответствия аналитических счетов КОСГУ.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Выборка.КЭК);
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.КОСГУНазначениеПлатежа", Отказ);
			Иначе
				
				Если ЗаполнениеДоговораОбязательно(НоваяСтрока.СчетРасчетов) Тогда
					
					Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Договор", МетаданныеДокумента) Тогда
						Если НЕ ЗначениеЗаполнено(Документ.Договор) Тогда
							ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
								"Поле", "Заполнение", НСтр("ru = 'Договор'"));
							БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.Договор", Отказ);
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				
				СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетРасчетов);
				
				Если ИспользоватьУчетПоПодразделениям
				   И СвойстваСчетаРасчетов.УчетПоПодразделениям И НЕ СвойстваСчетаРасчетов.РазрешитьНеУказыватьПодразделение
				   И НЕ ЗначениеЗаполнено(Документ.Подразделение) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
						"Поле", "Заполнение", МетаданныеДокумента.Реквизиты.Подразделение.Синоним);
					ТекстСообщения = ТекстСообщения + НСтр("ru='. Учет расчетов ведется по подразделениям.'");
					БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.Подразделение", Отказ);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежа Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаРасшифровки.СпособПогашенияЗадолженности) Тогда
			СтрокаРасшифровки.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
		КонецЕсли;
		Если СтрокаРасшифровки.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.НеПогашать Тогда
			СтрокаРасшифровки.ЭтоАвансовыйПлатеж = Истина;
		КонецЕсли;
		
		ПараметрыДопСубконтоРасчетов = УчетРасчетов.ПараметрыДопСубконтоРасчетов(СтрокаРасшифровки.СчетРасчетов);
		СтрокаРасшифровки.ВидДопСубконтоРасчетов = ПараметрыДопСубконтоРасчетов.ВидСубконто;
		
	КонецЦикла;
	
	Возврат РасшифровкаПлатежа;
	
КонецФункции

// Розничные продажи с использованием ККТ.

Функция ПодготовитьТаблицуРасшифровкаПлатежаПоОтчетуПоКассовойСмене(ОтчетПоКассовойСмене, Реквизиты, Отказ) Экспорт
	
	РасшифровкаПлатежа = ПустаяТаблицаРасшифровкаПлатежаУнифицированная();
	
	Если Не ЗначениеЗаполнено(ОтчетПоКассовойСмене) Тогда
		БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(НСтр("ru='Не указан отчет по кассовой смене.'"),
			"Объект.ДокументОснование", Отказ);
		Возврат РасшифровкаПлатежа;
	КонецЕсли;
	
	Счет20531 = БухгалтерскийУчет.СчетПоКоду("205.31");
	СписокСчетовОтбора = Новый Массив;
	Если Реквизиты.Ссылка.КорСчет = Счет20531 Тогда
		СписокСчетовОтбора.Добавить(Счет20531);
		СписокСчетовОтбора.Добавить(ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	Иначе
		СписокСчетовОтбора.Добавить(Реквизиты.Ссылка.КорСчет);
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОтчетПоКассовойСмене", ОтчетПоКассовойСмене);
	Запрос.УстановитьПараметр("ПриходныйКассовыйОрдер", Реквизиты.Ссылка);
	Запрос.УстановитьПараметр("СписокСчетовОтбора", СписокСчетовОтбора);
	Запрос.УстановитьПараметр("ИФО", Реквизиты.Ссылка.ИФО);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПриходныйКассовыйОрдер.Ссылка КАК Ссылка,
	|	ПриходныйКассовыйОрдер.ДокументОснование КАК ДокументОснование,
	|	ПриходныйКассовыйОрдер.ИФО КАК ИФО,
	|	ПриходныйКассовыйОрдер.Подразделение КАК Подразделение,
	|	ПриходныйКассовыйОрдер.КорСчет КАК КорСчет,
	|	ПриходныйКассовыйОрдер.Основание КАК Основание,
	|	ПриходныйКассовыйОрдер.ВалютаДокумента КАК ВалютаДокумента
	|ПОМЕСТИТЬ ПриходныйКассовыйОрдер
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	ПриходныйКассовыйОрдер.Ссылка = &ПриходныйКассовыйОрдер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Расшифровка платежа"" КАК ИмяСписка,
	|	""Расшифровка платежа"" КАК СинонимСписка,
	|	ОтчетПоКассовойСменеОплатаНаличными.НомерСтроки КАК НомерСтроки,
	|	ИСТИНА КАК ЭтоПоступление,
	|	ЛОЖЬ КАК ЭтоАвансовыйПлатеж,
	|	ПриходныйКассовыйОрдер.ИФО КАК ИФО,
	|	ВЫРАЗИТЬ(ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты КАК Справочник.СтатьиАналитикиОплатыЧекаККМ).КФО КАК КФО,
	|	ВЫРАЗИТЬ(ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты КАК Справочник.СтатьиАналитикиОплатыЧекаККМ).КПС КАК КПС,
	|	ВЫРАЗИТЬ(ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты КАК Справочник.СтатьиАналитикиОплатыЧекаККМ).КЭК КАК КЭК,
	|	ПриходныйКассовыйОрдер.Подразделение КАК Подразделение,
	|	ОтчетПоКассовойСменеОплатаНаличными.Контрагент КАК Контрагент,
	|	ОтчетПоКассовойСменеОплатаНаличными.Договор КАК Договор,
	|	ОтчетПоКассовойСменеОплатаНаличными.Договор.ВестиГрафикПлатежей КАК ВестиГрафикПлатежей,
	|	ПриходныйКассовыйОрдер.КорСчет КАК СчетРасчетов,
	|	ПриходныйКассовыйОрдер.ВалютаДокумента КАК Валюта,
	|	ОтчетПоКассовойСменеОплатаНаличными.Сумма КАК СуммаРасчетов,
	|	ОтчетПоКассовойСменеОплатаНаличными.Сумма КАК СуммаРуб,
	|	ВЫБОР
	|		КОГДА ОтчетПоКассовойСменеОплатаНаличными.СистемаНалогообложенияЧекаККМ = ЗНАЧЕНИЕ(Перечисление.ВидыСистемыНалогообложенияЧекаККМ.ЕНВД)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияАвансовУСН.ДоходЕНВД)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияАвансовУСН.ДоходУСН)
	|	КОНЕЦ КАК ОтражениеАвансаУСН,
	|	ЗНАЧЕНИЕ(Справочник.ИсточникиСредств.ПустаяСсылка) КАК ИсточникСредств,
	|	ВЫРАЗИТЬ(ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты КАК Справочник.СтатьиАналитикиОплатыЧекаККМ).ДопКлассификация КАК ДопКлассификация,
	|	ВЫРАЗИТЬ(ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты КАК Справочник.СтатьиАналитикиОплатыЧекаККМ).КодМероприятия КАК КодМероприятия,
	|	ВЫРАЗИТЬ(ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты КАК Справочник.СтатьиАналитикиОплатыЧекаККМ).КодЦели КАК КодЦели,
	|	ПриходныйКассовыйОрдер.Основание КАК НазначениеПлатежа,
	|	ОтчетПоКассовойСменеОплатаНаличными.ПризнакСпособаРасчетаЧекаККМ КАК ПризнакСпособаРасчетаЧекаККМ,
	|	ОтчетПоКассовойСменеОплатаНаличными.ВидРасчетов КАК ВидРасчетов,
	|	ОтчетПоКассовойСменеОплатаНаличными.ОплатитьДо КАК ОплатитьДо
	|ИЗ
	|	Документ.ОтчетПоКассовойСмене.ОплатаНаличными КАК ОтчетПоКассовойСменеОплатаНаличными
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|		ПО (ИСТИНА)
	|ГДЕ
	|	ОтчетПоКассовойСменеОплатаНаличными.Ссылка = &ОтчетПоКассовойСмене
	|	И ВЫРАЗИТЬ(ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты КАК Справочник.СтатьиАналитикиОплатыЧекаККМ).СчетУчета В (&СписокСчетовОтбора)
	|	И ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты.ИФО = &ИФО";
	
	ДвижениеДенежныхСредств = Запрос.Выполнить().Выгрузить();
	ДвижениеДенежныхСредств.Свернуть("ИмяСписка, СинонимСписка, ЭтоПоступление, ЭтоАвансовыйПлатеж, ИФО,
	|КФО, КПС, КЭК, Подразделение, Контрагент, Договор, ВестиГрафикПлатежей, СчетРасчетов, Валюта, ОтражениеАвансаУСН, ИсточникСредств,
	|ДопКлассификация, КодМероприятия, КодЦели, НазначениеПлатежа, ПризнакСпособаРасчетаЧекаККМ, ВидРасчетов, ОплатитьДо", "СуммаРасчетов, СуммаРуб");
	
	НетКолонкиСчетАвансов = (РасшифровкаПлатежа.Колонки.Найти("СчетАвансов") = Неопределено);
	Если НетКолонкиСчетАвансов Тогда
		РасшифровкаПлатежа.Колонки.Добавить("СчетАвансов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	КонецЕсли;
	
	Для Каждого Строка Из ДвижениеДенежныхСредств Цикл
		
		НоваяСтрока = РасшифровкаПлатежа.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Строка.ПризнакСпособаРасчетаЧекаККМ = Перечисления.ПризнакиСпособаРасчета.ПредоплатаЧастичная Или
			Строка.ПризнакСпособаРасчетаЧекаККМ = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная Тогда 
			ЭтоАвансовыйПлатеж = Истина;
		Иначе
			ЭтоАвансовыйПлатеж = Ложь;
		КонецЕсли;	
		НоваяСтрока.ЭтоАвансовыйПлатеж = ЭтоАвансовыйПлатеж;		
		Если НоваяСтрока.ЭтоАвансовыйПлатеж Тогда 
			НоваяСтрока.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.НеПогашать;
		Иначе
			НоваяСтрока.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.ВидРасчетов) Тогда 
			НоваяСтрока.ВидРасчетов = Строка.ВидРасчетов;
		Иначе	
			НоваяСтрока.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
		КонецЕсли;	
		НоваяСтрока.ОплатитьДо = Строка.ОплатитьДо;
		
		ПараметрыДопСубконтоРасчетов = УчетРасчетов.ПараметрыДопСубконтоРасчетов(НоваяСтрока.СчетРасчетов);
		НоваяСтрока.ВидДопСубконтоРасчетов = ПараметрыДопСубконтоРасчетов.ВидСубконто;
		
		// Определим счета авансов, если они еще не указаны в таблице.
		Если НетКолонкиСчетАвансов Тогда
			ПериодОстатков = УчетРасчетов.ПериодПолученияОстатков(Реквизиты, "Дата");
			НоваяСтрока.СчетАвансов = УчетРасчетов.ОпределитьСчетАвансов(Строка.СчетРасчетов,
				ПериодОстатков, Реквизиты.Организация);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РасшифровкаПлатежа;
	
КонецФункции

// Перечисление компенсации родительской платы.

Функция ДетализироватьРасшифровкуПлатежаПоПолучателямКомпенсации(РасшифровкаПлатежа, Документ, Параметры = Неопределено, Отказ) Экспорт
	
	Если Не ЗначениеЗаполнено(Параметры.ВедомостьКомпенсацииРодительскойПлаты)
		ИЛИ ТипЗнч(Параметры.ВедомостьКомпенсацииРодительскойПлаты) <> Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
		Возврат РасшифровкаПлатежа; // Ведомость компенсации родительской платы не указана.
		// Будем считать получателем компенсации контрагента, указанного в расчетно-платежном документе.
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	// Список сотрудников из ведомости компенсации родительской платы поместим в виртуальную таблицу.
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ВедомостьКомпенсации",
		"Ребенок,Договор,Плательщик,СуммаКомпенсации,КПС,КФО,Аннулировано",
		Параметры.ВедомостьКомпенсацииРодительскойПлаты, Параметры);
	
	// Сохраним все колонки унифицированной таблицы расшифровки платежа.
	Запрос.УстановитьПараметр("РасшифровкаПлатежаУнифицированная", РасшифровкаПлатежа);
	ИменаОбщихПолей = Новый Массив;
	ОбщиеПоляЗапроса = "";
	КолонкиЗаполняемыеИзВедомости = Новый Структура("Контрагент,Договор,СуммаРасчетов,СуммаРуб,СуммаПроданнойВалюты");
	Для Каждого Колонка Из РасшифровкаПлатежа.Колонки Цикл
		Если КолонкиЗаполняемыеИзВедомости.Свойство(Колонка.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ИменаОбщихПолей.Добавить(Колонка.Имя);
		ОбщиеПоляЗапроса = ?(ЗначениеЗаполнено(ОбщиеПоляЗапроса), ОбщиеПоляЗапроса + ",", "") + "
			|	РасшифровкаПлатежа." + Колонка.Имя + " КАК " + Колонка.Имя;
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	&ОбщиеПоляЗапроса
	|ПОМЕСТИТЬ ТаблицаРасшифровкаПлатежаУнифицированная
	|ИЗ
	|	&РасшифровкаПлатежаУнифицированная КАК РасшифровкаПлатежа
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ОбщиеПоляЗапроса,
	|	ВедомостьКомпенсации.Ребенок КАК Ребенок,
	|	ВедомостьКомпенсации.Плательщик КАК Контрагент,
	|	ВедомостьКомпенсации.Договор КАК Договор,
	|	ВедомостьКомпенсации.СуммаКомпенсации КАК СуммаРасчетов,
	|	ВедомостьКомпенсации.СуммаКомпенсации КАК СуммаПроданнойВалюты,
	|	ВедомостьКомпенсации.СуммаКомпенсации КАК СуммаРуб
	|ПОМЕСТИТЬ РаспределенныеСуммы
	|ИЗ
	|	ТаблицаРасшифровкаПлатежаУнифицированная КАК РасшифровкаПлатежа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаВедомостьКомпенсации КАК ВедомостьКомпенсации
	|		ПО РасшифровкаПлатежа.КФО = ВедомостьКомпенсации.КФО
	|		И РасшифровкаПлатежа.КПС = ВедомостьКомпенсации.КПС
	|ГДЕ
	|	НЕ ВедомостьКомпенсации.Аннулировано
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ОбщиеПоляЗапроса
	|ПОМЕСТИТЬ НераспределеннаяСтрокаПлатежа
	|ИЗ
	|	ТаблицаРасшифровкаПлатежаУнифицированная КАК РасшифровкаПлатежа
	|		ЛЕВОЕ СОЕДИНЕНИЕ РаспределенныеСуммы КАК РаспределенныеСуммы
	|		ПО &УсловиеСоединенияНераспределеннаяСтрокаПлатежа
	|ГДЕ
	|	&ПервоеОбщееПолеРаспределенныеСуммы ЕСТЬ NULL
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ОбщиеПоляЗапроса,
	|	ВедомостьКомпенсации.Ребенок КАК Ребенок,
	|	ВедомостьКомпенсации.Плательщик КАК Контрагент,
	|	ВедомостьКомпенсации.Договор КАК Договор,
	|	ВедомостьКомпенсации.СуммаКомпенсации КАК СуммаРасчетов,
	|	ВедомостьКомпенсации.СуммаКомпенсации КАК СуммаПроданнойВалюты,
	|	ВедомостьКомпенсации.СуммаКомпенсации КАК СуммаРуб
	|ИЗ
	|	НераспределеннаяСтрокаПлатежа КАК РасшифровкаПлатежа,
	|	ТаблицаВедомостьКомпенсации КАК ВедомостьКомпенсации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РаспределенныеСуммы КАК РаспределенныеСуммы
	|		ПО ВедомостьКомпенсации.Ребенок = РаспределенныеСуммы.Ребенок
	|		И ВедомостьКомпенсации.Плательщик = РаспределенныеСуммы.Контрагент
	|		И ВедомостьКомпенсации.Договор = РаспределенныеСуммы.Договор
	|		И ВедомостьКомпенсации.СуммаКомпенсации = РаспределенныеСуммы.СуммаРасчетов
	|		И ВедомостьКомпенсации.СуммаКомпенсации = РаспределенныеСуммы.СуммаПроданнойВалюты
	|		И ВедомостьКомпенсации.СуммаКомпенсации = РаспределенныеСуммы.СуммаРуб
	|ГДЕ
	|	РаспределенныеСуммы.Ребенок ЕСТЬ NULL
	|	И НЕ ВедомостьКомпенсации.Аннулировано
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ОбщиеПоляЗапроса,
	|	РасшифровкаПлатежа.Ребенок КАК Ребенок,
	|	РасшифровкаПлатежа.Контрагент КАК Контрагент,
	|	РасшифровкаПлатежа.Договор КАК Договор,
	|	РасшифровкаПлатежа.СуммаРасчетов КАК СуммаРасчетов,
	|	РасшифровкаПлатежа.СуммаПроданнойВалюты КАК СуммаПроданнойВалюты,
	|	РасшифровкаПлатежа.СуммаРуб КАК СуммаРуб
	|ИЗ
	|	РаспределенныеСуммы КАК РасшифровкаПлатежа
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИСТИНА
	|ИЗ
	|	НераспределеннаяСтрокаПлатежа КАК НераспределеннаяСтрокаПлатежа
	|";
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ОбщиеПоляЗапроса",
		ТекстВыборкиПолей("РасшифровкаПлатежа", ИменаОбщихПолей));
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&УсловиеСоединенияНераспределеннаяСтрокаПлатежа",
		ТекстСоединенияТаблиц("РасшифровкаПлатежа", "РаспределенныеСуммы", ИменаОбщихПолей));
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ПервоеОбщееПолеРаспределенныеСуммы",
		ПервоеОбщееПоле("РаспределенныеСуммы", ИменаОбщихПолей));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДвижениеДенежныхСредств = РезультатЗапроса[РезультатЗапроса.Вграница() - 1].Выгрузить();
	НераспределенныеСтроки = РезультатЗапроса[РезультатЗапроса.Вграница()].Выгрузить();
	
	Если Документ.СуммаДокумента <> ДвижениеДенежныхСредств.Итог("СуммаРасчетов") Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Сумма платежа %1 не совпадает с итогом по ведомости ""%2"": %3'"),
			Документ.СуммаДокумента,
			Параметры.ВедомостьКомпенсацииРодительскойПлаты,
			ДвижениеДенежныхСредств.Итог("СуммаРасчетов"));
		БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "СуммаДокумента", Отказ);
		Возврат РасшифровкаПлатежа;
	КонецЕсли;
	
	ПредставлениеПериода = БухгалтерскиеОперации.ПолучитьПредставлениеПериода(
		НачалоДня(Параметры.ВедомостьКомпенсацииРодительскойПлаты.НачалоПериода),
		КонецДня(Параметры.ВедомостьКомпенсацииРодительскойПлаты.КонецПериода));
	
	Для Каждого СтрокаТаблицы Из ДвижениеДенежныхСредств Цикл
		
		СтрокаТаблицы.НазначениеПлатежа =
			?(ПустаяСтрока(СтрокаТаблицы.НазначениеПлатежа), "", СтрокаТаблицы.НазначениеПлатежа + ": ")
			+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1, %2",
				СтрокаТаблицы.Ребенок, ПредставлениеПериода);
		
	КонецЦикла;
	
	Возврат ДвижениеДенежныхСредств;
	
КонецФункции

Функция ТекстВыборкиПолей(ИмяТаблицы, Поля)
	
	ВсеПоля = Новый Массив;
	ШаблонПоля = ИмяТаблицы + ".%1 КАК %1";
	Для Каждого Поле Из Поля Цикл
		ВсеПоля.Добавить(СтрШаблон(ШаблонПоля, Поле));
	КонецЦикла;
	Возврат СтрСоединить(ВсеПоля, "," + Символы.ПС + Символы.Таб);
	
КонецФункции

Функция ТекстСоединенияТаблиц(ЛеваяТаблица, ПраваяТаблица, Поля)
	ВсеУсловия = Новый Массив;
	ШаблонУсловия = ЛеваяТаблица + ".%1 = " + ПраваяТаблица + ".%1";
	Для Каждого Поле Из Поля Цикл
		ВсеУсловия.Добавить(СтрШаблон(ШаблонУсловия, Поле));
	КонецЦикла;
	Возврат СтрСоединить(ВсеУсловия, Символы.ПС + Символы.Таб + "И ");
КонецФункции

Функция ПервоеОбщееПоле(ИмяТаблицы, Поля)
	Возврат ИмяТаблицы + "." + Поля[0];
КонецФункции

// Перечисление сотрудникам по "Ведомости в банк".

Функция ДетализироватьРасшифровкуПлатежаПоВедомостиПеречислений(РасшифровкаПлатежа, Документ, Параметры = Неопределено, Отказ) Экспорт
	
	Если Не ЗначениеЗаполнено(Параметры.ВедомостьНаВыплатуВБанк)
		ИЛИ ТипЗнч(Параметры.ВедомостьНаВыплатуВБанк) <> Тип("ДокументСсылка.ВедомостьНаВыплатуВБанк") Тогда
		Возврат РасшифровкаПлатежа;
		// Если ведомости нет, то получателем является контрагент из в расчетно-платежного документа.
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	// Список сотрудников из ведомости перечислений поместим в виртуальную таблицу.
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "РасшифровкаПлатежа",
		"СотрудникКонтрагент,Сотрудник,Контрагент,ОснованиеПринятияОбязательства,КФО,КПС,КЭК,КодЦели,КодМероприятия,ДопКлассификация,Сумма",
		Параметры.ВедомостьНаВыплатуВБанк, Параметры);
	
	// Сохраним все колонки унифицированной таблицы расшифровки платежа.
	Запрос.УстановитьПараметр("РасшифровкаПлатежаУнифицированная", РасшифровкаПлатежа);
	ОбщиеПоляЗапроса = "";
	Для Каждого Колонка Из РасшифровкаПлатежа.Колонки Цикл
		Если СтрНайти("Контрагент,Договор,СуммаРасчетов,СуммаРуб,СуммаПроданнойВалюты", Колонка.Имя) > 0 Тогда
			Продолжить; // Эти колонки заполним по ведомости перечислений.
		КонецЕсли;
		ОбщиеПоляЗапроса = ?(ЗначениеЗаполнено(ОбщиеПоляЗапроса), ОбщиеПоляЗапроса + ",", "") + "
			|	РасшифровкаПлатежа." + Колонка.Имя + " КАК " + Колонка.Имя;
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ" + ОбщиеПоляЗапроса + "
	|ПОМЕСТИТЬ ТаблицаРасшифровкаПлатежаУнифицированная
	|ИЗ
	|	&РасшифровкаПлатежаУнифицированная КАК РасшифровкаПлатежа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ" + ОбщиеПоляЗапроса + ",
	|	ВЫБОР
	|		КОГДА ВедомостьПеречислений.СотрудникКонтрагент = 0
	|			ТОГДА ВедомостьПеречислений.Сотрудник.Контрагент
	|		ИНАЧЕ ВедомостьПеречислений.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|	ВедомостьПеречислений.ОснованиеПринятияОбязательства КАК Договор,
	|	ВедомостьПеречислений.Сумма КАК СуммаРасчетов,
	|	ВедомостьПеречислений.Сумма КАК СуммаПроданнойВалюты,
	|	ВедомостьПеречислений.Сумма КАК СуммаРуб
	|ИЗ
	|	ТаблицаРасшифровкаПлатежаУнифицированная КАК РасшифровкаПлатежа
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаРасшифровкаПлатежа КАК ВедомостьПеречислений
	|		ПО РасшифровкаПлатежа.КФО = ВедомостьПеречислений.КФО
	|			И РасшифровкаПлатежа.КПС = ВедомостьПеречислений.КПС
	|			И РасшифровкаПлатежа.КЭК = ВедомостьПеречислений.КЭК
	|			И РасшифровкаПлатежа.КодЦели = ВедомостьПеречислений.КодЦели
	|			И РасшифровкаПлатежа.КодМероприятия = ВедомостьПеречислений.КодМероприятия
	|			И РасшифровкаПлатежа.ДопКлассификация = ВедомостьПеречислений.ДопКлассификация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьНомерРеестраВВедомости(Ведомость) Экспорт
	
	Если Не ЗначениеЗаполнено(Ведомость.НастройкаВыгрузки) Тогда
		Возврат;
	КонецЕсли;
	
	Год = Год(Ведомость.Дата);
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.НумераторРеестровКомпенсацииРодительскойПлаты");
	ЭлементБлокировки.УстановитьЗначение("НастройкаВыгрузкиКомпенсацииРодительскойПлаты", Ведомость.НастройкаВыгрузки);
	ЭлементБлокировки.УстановитьЗначение("Год", Год);
	Блокировка.Заблокировать();
	
	Запись = РегистрыСведений.НумераторРеестровКомпенсацииРодительскойПлаты.СоздатьМенеджерЗаписи();
	Запись.НастройкаВыгрузкиКомпенсацииРодительскойПлаты = Ведомость.НастройкаВыгрузки;
	Запись.Год = Год;
	Запись.Прочитать();
	
	Если Запись.Выбран() Тогда
		НомерРеестраВРегистре = Запись.ТекущийНомерВыгрузки;
	Иначе
		НомерРеестраВРегистре = 0;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ведомость.НомерРеестра) Тогда
		Если Не Ведомость.ЭтоНовый() Тогда
			// Если документ не новый и уже содержится в задании на экспорт, то номер реестра не присваивается
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена
			|ГДЕ
			|	НЕ ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка.ПометкаУдаления
			|	И ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Объект = &Ведомость";
			Запрос.УстановитьПараметр("Ведомость", Ведомость.Ссылка);
			Если Не Запрос.Выполнить().Пустой() Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Ведомость.НомерРеестра = НомерРеестраВРегистре + 1;
	Иначе
		// Проверка, что указанный номер реестра уже не используется в другом документе
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВедомостьНаВыплатуВБанк.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ВедомостьНаВыплатуВБанк КАК ВедомостьНаВыплатуВБанк
		|ГДЕ
		|	ВедомостьНаВыплатуВБанк.Ссылка <> &Ссылка
		|	И ВедомостьНаВыплатуВБанк.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ГОД) И &Дата
		|	И ВедомостьНаВыплатуВБанк.НастройкаВыгрузки = &НастройкаВыгрузки
		|	И ВедомостьНаВыплатуВБанк.НомерРеестра = &НомерРеестра
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВедомостьКомпенсацииРодительскойПлатыКВыплате.Ссылка
		|ИЗ
		|	Документ.ВедомостьКомпенсацииРодительскойПлатыКВыплате КАК ВедомостьКомпенсацииРодительскойПлатыКВыплате
		|ГДЕ
		|	ВедомостьКомпенсацииРодительскойПлатыКВыплате.Ссылка <> &Ссылка
		|	И ВедомостьКомпенсацииРодительскойПлатыКВыплате.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ГОД) И &Дата
		|	И ВедомостьКомпенсацииРодительскойПлатыКВыплате.НастройкаВыгрузки = &НастройкаВыгрузки
		|	И ВедомостьКомпенсацииРодительскойПлатыКВыплате.НомерРеестра = &НомерРеестра";
		
		Запрос.УстановитьПараметр("Ссылка", Ведомость.Ссылка);
		Запрос.УстановитьПараметр("Дата", Ведомость.Дата);
		Запрос.УстановитьПараметр("НастройкаВыгрузки", Ведомость.НастройкаВыгрузки);
		Запрос.УстановитьПараметр("НомерРеестра", Ведомость.НомерРеестра);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Выбранный номер реестра уже используется в документе %1.
					|Рекомендуется указать другой номер либо очистить его - тогда он автоматически будет присвоен при записи документа.'"),
				Выборка.Ссылка);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Ведомость.НомерРеестра > НомерРеестраВРегистре Тогда
		Запись.НастройкаВыгрузкиКомпенсацииРодительскойПлаты = Ведомость.НастройкаВыгрузки;
		Запись.Год = Год;
		Запись.ТекущийНомерВыгрузки = Ведомость.НомерРеестра;
		Запись.Записать();
	КонецЕсли;
	
КонецПроцедуры

// Остатки задолженности.

Функция ОстаткиЗадолженности(Период, РасшифровкаПлатежа, Реквизиты) Экспорт
	
	Если РасшифровкаПлатежа.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МоментВремени", Период);
	Запрос.УстановитьПараметр("Организация",   Реквизиты.Организация);
	
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет", Реквизиты.ИспользоватьВалютныйУчет);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("УчитыватьЗадолженностьЕНВД",
		?(Реквизиты.Свойство("УчитыватьЗадолженностьЕНВД"), Реквизиты.УчитыватьЗадолженностьЕНВД, Ложь));
	
	ПараметрыОтбора = ПараметрыОтбораОстатковЗадолженности(РасшифровкаПлатежа, Реквизиты);
	КолонкиПараметровУчета = 
		"УчетПоИФО, УчетПоКПС, УчетПоПодразделениям,
		|КонтрагентЕстьСубконто,ДоговорЕстьСубконто,
		|ДопАналитикаЕстьСубконто,ДопАналитикаВидСубконто";
	ТаблицаПараметровУчета = ПараметрыОтбора.Скопировать();
	ТаблицаПараметровУчета.Свернуть(КолонкиПараметровУчета);
	ТаблицаПараметровУчета.Колонки.Добавить("НомераСубконто", Новый ОписаниеТипов("Соответствие"));
	
	// Блокируем регистр бухгалтерии для получения остатков.
	УстанавливатьБлокировку = ?(Реквизиты.Свойство("ТиповаяОперация"), Реквизиты.ТиповаяОперация.УстанавливатьБлокировку, Ложь);
	Если УстанавливатьБлокировку Тогда
		
		//Блокировка = Новый БлокировкаДанных;
		//
		//Для Каждого СтрокаСчета Из ТаблицаСчетов Цикл
		//
		//	ДанныеСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаСчета.СчетРасчетов);
		//	
		//	ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
		//	ЭлементБлокировки.УстановитьЗначение("Период",      Новый Диапазон(, Реквизиты.Дата));
		//	ЭлементБлокировки.УстановитьЗначение("Организация", Реквизиты.Организация);
		//	ЭлементБлокировки.УстановитьЗначение("КФО",         СтрокаСчета.КФО);
		//	
		//	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		//		ЭлементБлокировки.УстановитьЗначение("ИФО", СтрокаСчета.ИФО);
		//	КонецЕсли;
		//	
		//	ЭлементБлокировки.УстановитьЗначение("Счет", СтрокаСчета.СчетРасчетов);
		//	
		//	ОтборПоСчету = Новый Структура("ВидАванса,ИФО,КФО,СчетРасчетов,СчетАвансов",
		//		СтрокаСчета.ИФО, СтрокаСчета.КФО, СтрокаСчета.СчетРасчетов, СтрокаСчета.СчетАвансов);
		//	ТаблицаДоговоровПоСчету = ТаблицаДоговоров.Скопировать(ОтборПоСчету, "Контрагент,Договор");
		//	ЭлементБлокировки.ИсточникДанных = ТаблицаДоговоровПоСчету;
		//	
		//	Для НомерСубконто = 1 По ДанныеСчета.КоличествоСубконто Цикл
		//		Если ДанныеСчета["ВидСубконто" + НомерСубконто] = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
		//			ЭлементБлокировки.ИспользоватьИзИсточникаДанных(
		//				ПланыВидовХарактеристик.ВидыСубконто.Контрагенты, "Контрагент");
		//		ИначеЕсли ДанныеСчета["ВидСубконто" + НомерСубконто] = ПланыВидовХарактеристик.ВидыСубконто.Договоры Тогда
		//			ЭлементБлокировки.ИспользоватьИзИсточникаДанных(
		//				ПланыВидовХарактеристик.ВидыСубконто.Договоры, "Договор");
		//		КонецЕсли;
		//	КонецЦикла;
		//	
		//КонецЦикла;
		//
		//Блокировка.Заблокировать();
		
	КонецЕсли;
	
	// Текст запроса по остаткам формируется для каждого набора параметров учета расчетов.
	ТекстОбщегоЗапроса = "";
	Для НомерЗапроса=1 По ТаблицаПараметровУчета.Количество() Цикл
		
		НаборПараметровУчета = ТаблицаПараметровУчета[НомерЗапроса-1];
		
		Если НЕ НаборПараметровУчета.КонтрагентЕстьСубконто Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСубконто = Новый Массив;
		
		// Контрагент.
		МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
		НаборПараметровУчета.НомераСубконто.Вставить("Контрагент", 1);
		
		// Договор.
		Если НаборПараметровУчета.ДоговорЕстьСубконто Тогда
			
			МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
			НаборПараметровУчета.НомераСубконто.Вставить("Договор",
				НаборПараметровУчета.НомераСубконто.Количество() + 1);
			
		КонецЕсли;
		
		// ДопАналитика (документ расчетов или др.).
		Если НаборПараметровУчета.ДопАналитикаЕстьСубконто Тогда
			
			МассивСубконто.Добавить(НаборПараметровУчета.ДопАналитикаВидСубконто);
			НаборПараметровУчета.НомераСубконто.Вставить("ДопАналитика",
				НаборПараметровУчета.НомераСубконто.Количество() + 1);
			
		КонецЕсли;
		
		// Добавляем виртуальную таблицу.
		Запрос.Текст = Запрос.Текст + ТекстЗапросаОстаткиЗадолженности(НаборПараметровУчета, НомерЗапроса);
		
		// Устанавливаем параметры виртуальной таблицы.
		Отбор = Новый Структура(КолонкиПараметровУчета);
		ЗаполнитьЗначенияСвойств(Отбор, НаборПараметровУчета);
		ОтборОстатков = ПараметрыОтбора.Скопировать(Отбор);
		
		Запрос.УстановитьПараметр("Счета" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("СчетОстатков")) );
		Запрос.УстановитьПараметр("ИФО" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("ИФО")) );
		Запрос.УстановитьПараметр("КФО" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("КФО")) );
		Запрос.УстановитьПараметр("КПС" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("КПС")) );
		Запрос.УстановитьПараметр("Подразделение" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("Подразделение")) );
		Запрос.УстановитьПараметр("Контрагенты" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("Контрагент")) );
		Запрос.УстановитьПараметр("Договоры" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("Договор")) );
		Запрос.УстановитьПараметр("УчетПоПодразделениям" + НомерЗапроса,
			НаборПараметровУчета.УчетПоПодразделениям);
		Запрос.УстановитьПараметр("УчетПоКПС" + НомерЗапроса,
			НаборПараметровУчета.УчетПоКПС);
		Запрос.УстановитьПараметр("ДопАналитикаВидСубконто" + НомерЗапроса,
			НаборПараметровУчета.ДопАналитикаВидСубконто);
		
		Запрос.УстановитьПараметр("Субконто" + НомерЗапроса, МассивСубконто);
		
		// Соединение виртуальных таблиц.
		Если НЕ ПустаяСтрока(ТекстОбщегоЗапроса) Тогда
			ТекстОбщегоЗапроса = ТекстОбщегоЗапроса + "
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|";
		КонецЕсли;
		
		ТекстОбщегоЗапроса = ТекстОбщегоЗапроса +
		"ВЫБРАТЬ
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.СчетРасчетов КАК СчетРасчетов,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.УчетПоПодразделениям КАК УчетПоПодразделениям,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.УчетПоКПС КАК УчетПоКПС,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.ИФО КАК ИФО,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.КФО КАК КФО,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.КПС КАК КПС,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.Подразделение КАК Подразделение,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.Контрагент КАК Контрагент,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.Договор КАК Договор,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.ВидДопСубконтоРасчетов КАК ВидДопСубконтоРасчетов,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.Валюта КАК Валюта,
		|	СУММА(ТаблицаОстаткиЗадолженности_НомерЗапроса.СуммаРасчетов) КАК СуммаРасчетов,
		|	СУММА(ТаблицаОстаткиЗадолженности_НомерЗапроса.СуммаРуб) КАК СуммаРуб,
		|	СУММА(ТаблицаОстаткиЗадолженности_НомерЗапроса.СуммаЕНВДРуб) КАК СуммаЕНВДРуб
		|ИЗ
		|	ОстаткиЗадолженности_НомерЗапроса КАК ТаблицаОстаткиЗадолженности_НомерЗапроса
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.СчетРасчетов,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.УчетПоПодразделениям,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.УчетПоКПС,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.ИФО,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.КФО,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.КПС,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.Подразделение,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.Контрагент,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.Договор,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.ДопСубконтоРасчетов,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.ВидДопСубконтоРасчетов,
		|	ТаблицаОстаткиЗадолженности_НомерЗапроса.Валюта";
		
		ТекстОбщегоЗапроса = СтрЗаменить(ТекстОбщегоЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + ТекстОбщегоЗапроса;
	Если ПустаяСтрока(Запрос.Текст) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	ОстаткиЗадолженности = Запрос.Выполнить().Выгрузить();
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиЗадолженности, "ДопСубконтоРасчетов", "ДатаДокументаРасчетов");
	
	Возврат ОстаткиЗадолженности;
	
КонецФункции

Функция ПараметрыОтбораОстатковЗадолженности(ТаблицаДокумента, Реквизиты)
	
	ЭтоРасшифровкаПлатежа = ( ТаблицаДокумента.Колонки.Найти("ЭтоАвансовыйПлатеж") <> Неопределено );
	
	ПараметрыОтбора = ТаблицаДокумента.СкопироватьКолонки("ИФО,КФО,КПС,Подразделение,Контрагент,Договор");
	ПараметрыОтбора.Колонки.Добавить("СчетОстатков", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		Если ЭтоРасшифровкаПлатежа Тогда
			Если СтрокаДокумента.ЭтоАвансовыйПлатеж
			   И ((СтрокаДокумента.ВидАванса = "Полученный" И СтрокаДокумента.ЭтоПоступление)  // Получили аванс от покупателя.
			 ИЛИ (СтрокаДокумента.ВидАванса = "Выданный" И НЕ СтрокаДокумента.ЭтоПоступление)) // Выдали аванс поставщику.
			Тогда
				Продолжить; // Не нужно погашать задолженность.
			ИначеЕсли СтрокаДокумента.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.НеПогашать Тогда
				Продолжить; // Не нужно погашать задолженность.
			КонецЕсли;
		КонецЕсли;
		
		Отбор = ПараметрыОтбора.Добавить();
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
		Если ЭтоРасшифровкаПлатежа Тогда
			Отбор.СчетОстатков = СтрокаДокумента.СчетРасчетов;
		Иначе // Документы списания дебиторской и кредиторской задолженности.
			Отбор.СчетОстатков = СтрокаДокумента.Счет;
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыОтбора.Колонки.Добавить("УчетПоИФО",            Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("УчетПоКПС",            Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("УчетПоПодразделениям", Новый ОписаниеТипов("Булево"));
	
	ПараметрыОтбора.Колонки.Добавить("КонтрагентЕстьСубконто",   Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("ДоговорЕстьСубконто",      Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("ДопАналитикаЕстьСубконто", Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("ДопАналитикаВидСубконто",  Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	
	Для Каждого Отбор Из ПараметрыОтбора Цикл
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Отбор.СчетОстатков);
		
		Отбор.УчетПоИФО = Реквизиты.ИспользоватьУчетПоИФО;
		Отбор.УчетПоКПС = СвойстваСчета.УчетПоКПС;
		Отбор.УчетПоПодразделениям =
			Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям;
		
		Для Индекс = 1 По СвойстваСчета.КоличествоСубконто Цикл
		
			ВидСубконто = СвойстваСчета["ВидСубконто" + Индекс];
			Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
				Отбор.КонтрагентЕстьСубконто = Истина;
				
			ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Договоры Тогда
				Отбор.ДоговорЕстьСубконто = Истина;
				
			Иначе
				Отбор.ДопАналитикаЕстьСубконто = Истина;
				Отбор.ДопАналитикаВидСубконто  = ВидСубконто;
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ПараметрыОтбора;
	
КонецФункции

Функция ТекстЗапросаОстаткиЗадолженности(ПараметрыУчета, НомерЗапроса)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Остатки.Счет КАК СчетРасчетов,
	|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
	|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.Контрагент КАК Контрагент,
	|	Остатки.Договор КАК Договор,
	|	Остатки.ДопАналитика КАК ДопСубконтоРасчетов,
	|	&ДопАналитикаВидСубконто_НомерЗапроса КАК ВидДопСубконтоРасчетов,
	|	ЕСТЬNULL(Остатки.Валюта, &ВалютаРеглУчета) КАК Валюта,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|				И Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаОстаток
	|		ИНАЧЕ Остатки.СуммаОстаток
	|	КОНЕЦ КАК СуммаРасчетов,
	|	Остатки.СуммаОстаток КАК СуммаРуб,
	|	ВЫБОР
	|		КОГДА &УчитыватьЗадолженностьЕНВД
	|				И Остатки.Счет.НалоговыйУчетЕНВД
	|			ТОГДА Остатки.СуммаЕНВДОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаЕНВДРуб
	|ПОМЕСТИТЬ ОстаткиЗадолженности_НомерЗапроса
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&МоментВремени,
	|			Счет В (&Счета_НомерЗапроса),
	|			&Субконто_НомерЗапроса,
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКФО
	|				И &УсловиеПоКонтрагентам
	|				И &УсловиеПоДоговорам
	|				И &УсловиеПоКПС
	|				И &УсловиеПоПодразделению) КАК Остатки";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоИФО",
		?(ПараметрыУчета.УчетПоИФО, "ИФО В (&ИФО_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКФО", "КФО В (&КФО_НомерЗапроса)");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКПС",
		?(ПараметрыУчета.УчетПоКПС, "КПС В (&КПС_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению",
		?(ПараметрыУчета.УчетПоПодразделениям, "Подразделение В (&Подразделение_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКонтрагентам",
		"Субконто"+ПараметрыУчета.НомераСубконто["Контрагент"]+" В (&Контрагенты_НомерЗапроса)");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДоговорам",
		?(ПараметрыУчета.ДоговорЕстьСубконто,
		"Субконто"+ПараметрыУчета.НомераСубконто["Договор"]+" В (&Договоры_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.Контрагент",
		"Остатки.Субконто"+ПараметрыУчета.НомераСубконто["Контрагент"]);
	Если ПараметрыУчета.ДоговорЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.Договор",
			"Остатки.Субконто"+ПараметрыУчета.НомераСубконто["Договор"]);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.Договор",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	Если ПараметрыУчета.ДопАналитикаЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.ДопАналитика",
			"ЕСТЬNULL(Остатки.Субконто"+ПараметрыУчета.НомераСубконто["ДопАналитика"] + ", НЕОПРЕДЕЛЕНО)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.ДопАналитика",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Если НЕ ПараметрыУчета.УчетПоКПС Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.КПС", "ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоИФО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоПодразделениям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
	
	Возврат ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
	
КонецФункции

Функция ОстаткиЗадолженностиПоПлатежамВБюджеты(Период, ТаблицаДокумента, Реквизиты) Экспорт
	
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МоментВремени", Период);
	Запрос.УстановитьПараметр("Организация",   Реквизиты.Организация);
	
	Запрос.УстановитьПараметр("Счета30300",
		ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("Счет")) );
	Запрос.УстановитьПараметр("ИФО",
		ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("ИФО")) );
	Запрос.УстановитьПараметр("КФО",
		ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("КФО")) );
	Запрос.УстановитьПараметр("КПС",
		ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("КПС")) );
	Запрос.УстановитьПараметр("ВидНалогаИлиПлатежа",
		ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("ВидНалогаИлиПлатежа")) );
	
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет", Реквизиты.ИспользоватьВалютныйУчет);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Счет.УчетПоКПС КАК УчетПоКПС,
	|	Остатки.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	Остатки.Счет.Валютный КАК Валютный,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	ВЫБОР
	|		КОГДА Остатки.Субконто1 ССЫЛКА Справочник.ВидыНалоговИПлатежей
	|			ТОГДА Остатки.Субконто1
	|		КОГДА Остатки.Субконто2 ССЫЛКА Справочник.ВидыНалоговИПлатежей
	|			ТОГДА Остатки.Субконто2
	|		КОГДА Остатки.Субконто3 ССЫЛКА Справочник.ВидыНалоговИПлатежей
	|			ТОГДА Остатки.Субконто3
	|	КОНЕЦ КАК ВидНалогаИлиПлатежа,
	|	ВЫБОР
	|		КОГДА Остатки.Субконто1 ССЫЛКА Справочник.НалогиИПлатежиОрганизации
	|			ТОГДА Остатки.Субконто1
	|		КОГДА Остатки.Субконто2 ССЫЛКА Справочник.НалогиИПлатежиОрганизации
	|			ТОГДА Остатки.Субконто2
	|		КОГДА Остатки.Субконто3 ССЫЛКА Справочник.НалогиИПлатежиОрганизации
	|			ТОГДА Остатки.Субконто3
	|	КОНЕЦ КАК НалогСборПлатеж,
	|	ВЫБОР
	|		КОГДА НЕ Остатки.Субконто1 ССЫЛКА Справочник.ВидыНалоговИПлатежей
	|				И НЕ Остатки.Субконто1 ССЫЛКА Справочник.НалогиИПлатежиОрганизации
	|			ТОГДА Остатки.Субконто1
	|		КОГДА НЕ Остатки.Субконто1 ССЫЛКА Справочник.ВидыНалоговИПлатежей
	|				И НЕ Остатки.Субконто2 ССЫЛКА Справочник.НалогиИПлатежиОрганизации
	|			ТОГДА Остатки.Субконто2
	|		КОГДА НЕ Остатки.Субконто1 ССЫЛКА Справочник.ВидыНалоговИПлатежей
	|				И НЕ Остатки.Субконто3 ССЫЛКА Справочник.НалогиИПлатежиОрганизации
	|			ТОГДА Остатки.Субконто3
	|	КОНЕЦ КАК ДопСубконто,
	|	ЕСТЬNULL(Остатки.Валюта, &ВалютаРеглУчета) КАК Валюта,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|				И Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаОстаток
	|		ИНАЧЕ Остатки.СуммаОстаток
	|	КОНЕЦ КАК СуммаВал,
	|	Остатки.СуммаОстаток КАК СуммаРуб
	|ПОМЕСТИТЬ Остатки30300
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&МоментВремени, Счет В (&Счета30300), , Организация = &Организация) КАК Остатки
	|ГДЕ
	|	&УсловиеПоИФО
	|	И &УсловиеПоКФО
	|	И &УсловиеПоКПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки30300.Счет КАК Счет,
	|	Остатки30300.УчетПоКПС КАК УчетПоКПС,
	|	Остатки30300.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	Остатки30300.Валютный КАК Валютный,
	|	Остатки30300.ИФО КАК ИФО,
	|	Остатки30300.КФО КАК КФО,
	|	Остатки30300.КПС КАК КПС,
	|	Остатки30300.Подразделение КАК Подразделение,
	|	Остатки30300.Субконто1 КАК Субконто1,
	|	Остатки30300.Субконто2 КАК Субконто2,
	|	Остатки30300.Субконто3 КАК Субконто3,
	|	Остатки30300.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа,
	|	Остатки30300.НалогСборПлатеж КАК НалогСборПлатеж,
	|	Остатки30300.ДопСубконто КАК ДопСубконто,
	|	Остатки30300.Валюта КАК Валюта,
	|	Остатки30300.СуммаВал КАК СуммаВал,
	|	Остатки30300.СуммаРуб КАК СуммаРуб
	|ИЗ
	|	Остатки30300 КАК Остатки30300
	|ГДЕ
	|	&УсловиеПоВидНалогаИлиПлатежа";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО",
		?(Реквизиты.ИспользоватьУчетПоИФО, "ИФО В (&ИФО)", "ИСТИНА") );
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "КФО В (&КФО)");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКПС", "КПС В (&КПС)");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоВидНалогаИлиПлатежа",
		"Остатки30300.ВидНалогаИлиПлатежа В (&ВидНалогаИлиПлатежа)");
	
	ОстаткиЗадолженности = Запрос.Выполнить().Выгрузить();
	
	Возврат ОстаткиЗадолженности;
	
КонецФункции

// Контроль остатков по счетам расчетов при проведении документов списания дебиторской и кредиторской задолженности.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.СписаниеВосстановлениеЗадолженностиПоДоходам,
//                   ДокументОбъект.СписаниеКредиторскойЗадолженности,
//                   ДокументОбъект.ВосстановлениеКредиторскойЗадолженности - документ списания дебиторской, кредиторской задолженности;
//  ТолькоОдобренныеОбъектыГолосования - Булево - при контроле остатков учитывать только строки документа, одобренные комиссией.
// 
Функция ОстаткиЗадолженностиПревышены(ДокументОбъект, ТолькоОдобренныеОбъектыГолосования = Истина) Экспорт
	
	ОстаткиПревышены = Ложь;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка", ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация", ДокументОбъект.Организация);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет", ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументОбъект.Ссылка);
	Если ЗначениеЗаполнено(ДатаПроведения) Тогда
		ПериодОстатков = Новый Граница(ДатаПроведения, ВидГраницы.Исключая);
	Иначе
		ПериодОстатков = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если МетаданныеДокумента.Имя = "СписаниеКредиторскойЗадолженности" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Задолженность",
			"НомерСтроки,ИдентификаторСтроки,ИФО,КФО,КПС,Подразделение,Счет,
			|Контрагент,Договор,ДопСубконтоРасчетов,
			|ВидНалогаИлиПлатежа,НалогСборПлатеж,
			|Валюта,СписатьСумма,СписатьСуммаВал",
			ДокументОбъект, Реквизиты);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	Задолженность.НомерСтроки КАК НомерСтроки,
		|	Задолженность.ИФО КАК ИФО,
		|	Задолженность.КФО КАК КФО,
		|	Задолженность.КПС КАК КПС,
		|	Задолженность.Подразделение КАК Подразделение,
		|	Задолженность.Счет КАК Счет,
		|	Задолженность.Контрагент КАК Контрагент,
		|	Задолженность.Договор КАК Договор,
		|	Задолженность.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
		|	Задолженность.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа,
		|	Задолженность.НалогСборПлатеж КАК НалогСборПлатеж,
		|	Задолженность.Валюта КАК Валюта,
		|	Задолженность.СписатьСумма КАК СписатьСумма,
		|	Задолженность.СписатьСуммаВал КАК СписатьСуммаВал
		|ИЗ
		|	ТаблицаЗадолженность КАК Задолженность
		|ГДЕ
		|	&УсловиеТолькоОдобренныеОбъектыГолосования
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Задолженность.НомерСтроки КАК НомерСтроки,
		|	Задолженность.ИФО КАК ИФО,
		|	Задолженность.КФО КАК КФО,
		|	Задолженность.КПС КАК КПС,
		|	Задолженность.Подразделение КАК Подразделение,
		|	Задолженность.Счет КАК Счет,
		|	Задолженность.Контрагент КАК Контрагент,
		|	Задолженность.Договор КАК Договор,
		|	Задолженность.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
		|	Задолженность.Валюта КАК Валюта,
		|	Задолженность.СписатьСумма КАК СписатьСумма,
		|	Задолженность.СписатьСуммаВал КАК СписатьСуммаВал
		|ИЗ
		|	ТаблицаЗадолженность КАК Задолженность
		|ГДЕ
		|	&УсловиеТолькоОдобренныеОбъектыГолосования
		|	И НЕ Задолженность.Счет В (&Счета30300)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Задолженность.НомерСтроки КАК НомерСтроки,
		|	Задолженность.ИФО КАК ИФО,
		|	Задолженность.КФО КАК КФО,
		|	Задолженность.КПС КАК КПС,
		|	Задолженность.Подразделение КАК Подразделение,
		|	Задолженность.Счет КАК Счет,
		|	Задолженность.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа,
		|	Задолженность.НалогСборПлатеж КАК НалогСборПлатеж,
		|	Задолженность.Валюта КАК Валюта,
		|	Задолженность.СписатьСумма КАК СписатьСумма,
		|	Задолженность.СписатьСуммаВал КАК СписатьСуммаВал
		|ИЗ
		|	ТаблицаЗадолженность КАК Задолженность
		|ГДЕ
		|	&УсловиеТолькоОдобренныеОбъектыГолосования
		|	И Задолженность.Счет В(&Счета30300)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		Запрос.УстановитьПараметр("Счета30300", БухгалтерскийУчет.СписокСчетов("303.00"));
		
		Если ТолькоОдобренныеОбъектыГолосования Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТолькоОдобренныеОбъектыГолосования",
				"Задолженность.ИдентификаторСтроки В(&ОдобренныеОбъектыГолосования)");
			ОдобренныеОбъектыГолосования = ОбщегоНазначенияБГУ.ОдобренныеОбъектыГолосования(ДокументОбъект.Ссылка);
			Запрос.УстановитьПараметр("ОдобренныеОбъектыГолосования", ОдобренныеОбъектыГолосования);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТолькоОдобренныеОбъектыГолосования", "ИСТИНА");
		КонецЕсли;
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ЗадолженностьКСписанию = РезультатЗапроса[1].Выгрузить();
		ЗадолженностьКроме30300 = РезультатЗапроса[2].Выгрузить();
		Задолженность30300 = РезультатЗапроса[3].Выгрузить();
		
		ОстаткиЗадолженности = УчетРасчетов.ОстаткиЗадолженности(ПериодОстатков, ЗадолженностьКроме30300, Реквизиты);
		ОстаткиЗадолженности30300 = УчетРасчетов.ОстаткиЗадолженностиПоПлатежамВБюджеты(ПериодОстатков, Задолженность30300, Реквизиты);
		
	ИначеЕсли МетаданныеДокумента.Имя = "ВосстановлениеКредиторскойЗадолженности" Тогда
		
		Если ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийВосстановленияКредиторскойЗадолженности.ВосстановлениеЗадолженностиРанееНеУчитываемой Тогда
			Возврат ОстаткиПревышены; // Не требуется проверять остатки.
		КонецЕсли;
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Задолженность",
			"НомерСтроки,ИдентификаторСтроки,ИФО,КФО,КПС,Подразделение,Счет,
			|Контрагент,Договор,ДопСубконтоРасчетов,
			|Валюта,ВосстановитьСумма,ВосстановитьСуммаВал",
			ДокументОбъект, Реквизиты);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	Задолженность.НомерСтроки КАК НомерСтроки,
		|	Задолженность.ИФО КАК ИФО,
		|	Задолженность.КФО КАК КФО,
		|	Задолженность.КПС КАК КПС,
		|	Задолженность.Подразделение КАК Подразделение,
		|	Задолженность.Счет КАК Счет,
		|	Задолженность.Контрагент КАК Контрагент,
		|	Задолженность.Договор КАК Договор,
		|	Задолженность.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
		|	Задолженность.Валюта КАК Валюта,
		|	Задолженность.ВосстановитьСумма КАК СписатьСумма,
		|	Задолженность.ВосстановитьСуммаВал КАК СписатьСуммаВал
		|ИЗ
		|	ТаблицаЗадолженность КАК Задолженность
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ЗадолженностьКСписанию = РезультатЗапроса[1].Выгрузить(); // Списание задолженности со счета 20 "Задолженность, невостребованная кредиторами".
		
		ОстаткиЗадолженности = УчетРасчетов.ОстаткиЗадолженности(ПериодОстатков, ЗадолженностьКСписанию, Реквизиты);
		ОстаткиЗадолженности30300 = Новый ТаблицаЗначений;
		
	Иначе // СписаниеВосстановлениеЗадолженностиПоДоходам
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Задолженность",
			"НомерСтроки,ИдентификаторСтроки,ИФО,КФО,КПС,Подразделение,Счет,
			|Контрагент,Договор,ДопСубконтоРасчетов,
			|Валюта,СписатьСумма,СписатьСуммаВал",
			ДокументОбъект, Реквизиты);
		
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	Задолженность.НомерСтроки КАК НомерСтроки,
		|	Задолженность.ИФО КАК ИФО,
		|	Задолженность.КФО КАК КФО,
		|	Задолженность.КПС КАК КПС,
		|	Задолженность.Подразделение КАК Подразделение,
		|	Задолженность.Счет КАК Счет,
		|	Задолженность.Контрагент КАК Контрагент,
		|	Задолженность.Договор КАК Договор,
		|	Задолженность.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
		|	Задолженность.Валюта КАК Валюта,
		|	Задолженность.СписатьСумма КАК СписатьСумма,
		|	Задолженность.СписатьСуммаВал КАК СписатьСуммаВал
		|ИЗ
		|	ТаблицаЗадолженность КАК Задолженность
		|ГДЕ
		|	&УсловиеТолькоОдобренныеОбъектыГолосования
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		Если ТолькоОдобренныеОбъектыГолосования Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТолькоОдобренныеОбъектыГолосования",
				"Задолженность.ИдентификаторСтроки В(&ОдобренныеОбъектыГолосования)");
			ОдобренныеОбъектыГолосования = ОбщегоНазначенияБГУ.ОдобренныеОбъектыГолосования(ДокументОбъект.Ссылка);
			Запрос.УстановитьПараметр("ОдобренныеОбъектыГолосования", ОдобренныеОбъектыГолосования);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТолькоОдобренныеОбъектыГолосования", "ИСТИНА");
		КонецЕсли;
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ЗадолженностьКСписанию = РезультатЗапроса[1].Выгрузить();
		
		ОстаткиЗадолженности = УчетРасчетов.ОстаткиЗадолженности(ПериодОстатков, ЗадолженностьКСписанию, Реквизиты);
		ОстаткиЗадолженности30300 = Новый ТаблицаЗначений;
		
	КонецЕсли;
	
	Для Каждого СтрокаЗадолженность Из ЗадолженностьКСписанию Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("КФО", СтрокаЗадолженность.КФО);
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаЗадолженность.Счет);
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", ДокументОбъект.ИФО);
		КонецЕсли;
		Если СвойстваСчета.УчетПоКПС Тогда
			Отбор.Вставить("КПС", СтрокаЗадолженность.КПС);
		КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", СтрокаЗадолженность.Подразделение);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчета.Валютный Тогда
			Отбор.Вставить("Валюта", СтрокаЗадолженность.Валюта);
		КонецЕсли;
		
		ОстатокРуб = 0;
		ОстатокВал = 0;
		ЗнакОстатка = ?(МетаданныеДокумента.Имя = "СписаниеКредиторскойЗадолженности" И НЕ СвойстваСчета.Забалансовый, -1, 1);
		
		Если БухгалтерскийУчет.СчетВИерархии(СтрокаЗадолженность.Счет, "303.00") Тогда
			
			Отбор.Вставить("Счет", СтрокаЗадолженность.Счет);
			Если ЗначениеЗаполнено(СтрокаЗадолженность.ВидНалогаИлиПлатежа) Тогда
				Отбор.Вставить("ВидНалогаИлиПлатежа", СтрокаЗадолженность.ВидНалогаИлиПлатежа)
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаЗадолженность.НалогСборПлатеж) Тогда
				Отбор.Вставить("НалогСборПлатеж", СтрокаЗадолженность.НалогСборПлатеж)
			КонецЕсли;
			
			Если ОстаткиЗадолженности30300.Количество() > 0 Тогда
				НайденныеСтрокиОстатков = ОстаткиЗадолженности30300.НайтиСтроки(Отбор);
				Для Каждого СтрокаОстатков Из НайденныеСтрокиОстатков Цикл
					ОстатокРуб = ОстатокРуб + ЗнакОстатка * СтрокаОстатков.СуммаРуб;
					ОстатокВал = ОстатокВал + ЗнакОстатка * СтрокаОстатков.СуммаВал;
				КонецЦикла;
			КонецЕсли;
			
		Иначе // Счета расчетов.
			
			Отбор.Вставить("СчетРасчетов", СтрокаЗадолженность.Счет);
			Если БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоКонтрагентам(СтрокаЗадолженность.Счет) Тогда
				Отбор.Вставить("Контрагент", СтрокаЗадолженность.Контрагент)
			КонецЕсли;
			Если БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(СтрокаЗадолженность.Счет) Тогда
				Отбор.Вставить("Договор", СтрокаЗадолженность.Договор)
			КонецЕсли;
			Если ПараметрыДопСубконтоРасчетов(СтрокаЗадолженность.Счет).Использование // Есть доп.субконто расчетов.
				И (СтрокаЗадолженность.ДопСубконтоРасчетов <> Неопределено) Тогда // Значение Неопределено - при заполненении из инв.описи.
				Отбор.Вставить("ДопСубконтоРасчетов", СтрокаЗадолженность.ДопСубконтоРасчетов)
			КонецЕсли;
			
			Если ОстаткиЗадолженности.Количество() > 0 Тогда
				НайденныеСтрокиОстатков = ОстаткиЗадолженности.НайтиСтроки(Отбор);
				Для Каждого СтрокаОстатков Из НайденныеСтрокиОстатков Цикл
					ОстатокРуб = ОстатокРуб + ЗнакОстатка * СтрокаОстатков.СуммаРуб;
					ОстатокВал = ОстатокВал + ЗнакОстатка * СтрокаОстатков.СуммаРасчетов;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
		ЭтоРасчетыВВалюте = Реквизиты.ИспользоватьВалютныйУчет
			И ЗначениеЗаполнено(СтрокаЗадолженность.Валюта)
			И СтрокаЗадолженность.Валюта <> ВалютаРегламентированногоУчета;
		
		Если СтрокаЗадолженность.СписатьСумма > ОстатокРуб
			ИЛИ (ЭтоРасчетыВВалюте И СтрокаЗадолженность.СписатьСуммаВал > ОстатокВал) Тогда
			
			ИмяПоляСумма = ?(МетаданныеДокумента.Имя = "ВосстановлениеКредиторскойЗадолженности", "ВосстановитьСумма", "СписатьСумма");
			
			Если ЭтоРасчетыВВалюте Тогда
				ТекстОшибки = НСтр("ru='Указана сумма списания, превышающая остаток задолженности по счету бухгалтерского учета %1.
					|
					|Указана сумма списания: %2 (%5); Остаток задолженности: %3 (%6); Превышение: %4 (%7)'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					СтрокаЗадолженность.Счет,
					ОбщегоНазначенияБГУ.ФорматСумм(СтрокаЗадолженность.СписатьСуммаВал, СтрокаЗадолженность.Валюта, "0"),
					ОбщегоНазначенияБГУ.ФорматСумм(ОстатокВал, СтрокаЗадолженность.Валюта, "0"),
					ОбщегоНазначенияБГУ.ФорматСумм(СтрокаЗадолженность.СписатьСуммаВал - ОстатокВал, СтрокаЗадолженность.Валюта, "0"),
					ОбщегоНазначенияБГУ.ФорматСумм(СтрокаЗадолженность.СписатьСумма, ВалютаРегламентированногоУчета, "0"),
					ОбщегоНазначенияБГУ.ФорматСумм(ОстатокРуб, ВалютаРегламентированногоУчета, "0"),
					ОбщегоНазначенияБГУ.ФорматСумм(СтрокаЗадолженность.СписатьСумма - ОстатокРуб, ВалютаРегламентированногоУчета, "0"));
				ПолеСумма = "Задолженность[" + Формат(СтрокаЗадолженность.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоляСумма + "Вал";
			Иначе
				ТекстОшибки = НСтр("ru='Указана сумма списания, превышающая остаток задолженности по счету бухгалтерского учета %1.
					|
					|Указана сумма списания: %2; Остаток задолженности: %3; Превышение: %4'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					СтрокаЗадолженность.Счет,
					ОбщегоНазначенияБГУ.ФорматСумм(СтрокаЗадолженность.СписатьСумма, ВалютаРегламентированногоУчета, "0"),
					ОбщегоНазначенияБГУ.ФорматСумм(ОстатокРуб, ВалютаРегламентированногоУчета, "0"),
					ОбщегоНазначенияБГУ.ФорматСумм(СтрокаЗадолженность.СписатьСумма - ОстатокРуб, ВалютаРегламентированногоУчета, "0"));
				ПолеСумма = "Задолженность[" + Формат(СтрокаЗадолженность.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоляСумма;
			КонецЕсли;
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, ПолеСумма, "Объект");
			ОстаткиПревышены = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОстаткиПревышены;
	
КонецФункции

// Погашение задолженности.

// Структура таблицы расчетов с погашением задолженности.
//
Функция ПустаяТаблицаРасчетовСПогашениемЗадолженности() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Способ погашения задолженности, установленный в документе: Автоматичеки, Погасить задолженность, Не погашать.
	ПустаяТаблица.Колонки.Добавить("СпособПогашенияЗадолженности",
		Новый ОписаниеТипов("ПеречислениеСсылка.СпособыПогашенияЗадолженности"));
	
	// Признак аванса. После погашения задолженности, сумма аванса (превышения над остатком имеющейся задолженности)
	// добавляется в таблицу последней строкой.
	ПустаяТаблица.Колонки.Добавить("ЭтоАванс", Новый ОписаниеТипов("Булево"));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("КЭК",                    Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",           Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СчетАвансов",            Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",             Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",                Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("ДопСубконтоРасчетов",    Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	ПустаяТаблица.Колонки.Добавить("ВидДопСубконтоРасчетов", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ПустаяТаблица.Колонки.Добавить("Валюта",                 Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Суммы расчетов.
	ПустаяТаблица.Колонки.Добавить("ОстатокРасчетов",        ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРасчетов",          ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",               ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРубПоКурсуАванса",  ОписаниеТипаСуммы);
	
	// Конвертация валюты
	ПустаяТаблица.Колонки.Добавить("ПроданнаяВалюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ПустаяТаблица.Колонки.Добавить("СуммаПроданнойВалюты", ОписаниеТипаСуммы);
	
	// Для целей налогового учета при УСН.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",       ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("ОтражениеАвансаУСН", Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокОтраженияАвансовУСН"));
	
	// Учет полученных авансов на забалансовом счете АП.
	ПустаяТаблица.Колонки.Добавить("ОстатокРасчетовАП", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("ДокументАванса",    Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ВидДоговора",            Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
	ПустаяТаблица.Колонки.Добавить("РасчетыВВалюте",         Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("УчетАгентскогоНДС",      Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("ИсточникСредств",        Новый ОписаниеТипов("СправочникСсылка.ИсточникиСредств,СправочникСсылка.РазделыЛицевыхСчетов"));
	ПустаяТаблица.Колонки.Добавить("ДопКлассификация",       Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ПустаяТаблица.Колонки.Добавить("КодМероприятия",         Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ПустаяТаблица.Колонки.Добавить("КодЦели",                Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	ПустаяТаблица.Колонки.Добавить("НазначениеПлатежа",      ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(254));
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу расчетов с погашением задолженности.
//
Функция ТаблицаРасчетовСПогашениемЗадолженности(РасшифровкаПлатежа, Реквизиты, Отказ) Экспорт
	
	ТаблицаРасчетов = ПустаяТаблицаРасчетовСПогашениемЗадолженности();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("УчитыватьЗадолженностьЕНВД",       УчетнаяПолитика.ПрименяетсяУСН И УчетнаяПолитика.ПлательщикЕНВД);
	
	РасшифровкаПлатежа = ДобавитьСлужебныеКолонкиРасчетовСКонтрагентами(РасшифровкаПлатежа, Реквизиты);
	
	ПроверитьКорректностьНастройкиСчетовРасчетов(РасшифровкаПлатежа, Реквизиты);
	
	// Получим остатки задолженности со счетов бухгалтерского учета.
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты.Ссылка));
	ОстаткиЗадолженности = ОстаткиЗадолженности(ПериодОстатков, РасшифровкаПлатежа, Реквизиты);
	
	// При возврате полученных авансов, нужно определить ДокументАванса из остатков по счету АП.
	ДополнитьОстаткиЗадолженностиДокументамиАвансовПолученных(ПериодОстатков, ОстаткиЗадолженности, РасшифровкаПлатежа, Реквизиты);
	
	// Погасим задолженность, выделим аванс.
	Для Каждого СтрокаПлатежа Из РасшифровкаПлатежа Цикл
		
		НераспределенныйОстаток = СтрокаПлатежа.СуммаРасчетов;
		НераспределенныйОстатокВВалютеСписания = СтрокаПлатежа.СуммаПроданнойВалюты;
		
		Если СтрокаПлатежа.СпособПогашенияЗадолженности <> Перечисления.СпособыПогашенияЗадолженности.НеПогашать Тогда
		
			Отбор = Новый Структура("КФО,СчетРасчетов,Контрагент",
				СтрокаПлатежа.КФО,
				СтрокаПлатежа.СчетРасчетов,
				СтрокаПлатежа.Контрагент);
			
			Если ЗначениеЗаполнено(СтрокаПлатежа.Договор)
			   И БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(СтрокаПлатежа.СчетРасчетов) Тогда
				Отбор.Вставить("Договор", СтрокаПлатежа.Договор);
			КонецЕсли;
			
			Если СтрокаПлатежа.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.ПоДокументу Тогда
				Отбор.Вставить("ВидДопСубконтоРасчетов", СтрокаПлатежа.ВидДопСубконтоРасчетов);
				Отбор.Вставить("ДопСубконтоРасчетов",    СтрокаПлатежа.ДопСубконтоРасчетов);
			КонецЕсли;
			
			СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаПлатежа.СчетРасчетов);
			Если Реквизиты.ИспользоватьУчетПоИФО Тогда
				Отбор.Вставить("ИФО", СтрокаПлатежа.ИФО);
			КонецЕсли;
			Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
				Отбор.Вставить("КПС", СтрокаПлатежа.КПС);
			КонецЕсли;
			Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
				Отбор.Вставить("Подразделение", СтрокаПлатежа.Подразделение);
			КонецЕсли;
			Если Реквизиты.ИспользоватьВалютныйУчет Тогда
				Отбор.Вставить("Валюта", СтрокаПлатежа.Валюта);
			КонецЕсли;
			
			НайденныеОстаткиЗадолженности = ?(ОстаткиЗадолженности.Количество() > 0, ОстаткиЗадолженности.НайтиСтроки(Отбор),
				ОстаткиЗадолженности.СкопироватьКолонки());
			
			ДобавитьСтрокиПогашенияЗадолженности(
				ТаблицаРасчетов,
				НераспределенныйОстаток,
				НераспределенныйОстатокВВалютеСписания,
				НайденныеОстаткиЗадолженности,
				СтрокаПлатежа,
				Реквизиты,
				Отказ);
			
		КонецЕсли;
		
		ДобавитьСтрокуАванса(
			ТаблицаРасчетов,
			НераспределенныйОстаток,
			НераспределенныйОстатокВВалютеСписания,
			СтрокаПлатежа,
			Реквизиты);
		
	КонецЦикла;
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

Процедура ДополнитьОстаткиЗадолженностиДокументамиАвансовПолученных(ПериодОстатков, ОстаткиЗадолженности, РасшифровкаПлатежа, Реквизиты)
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ОстаткиЗадолженности.Колонки.Добавить("СуммаРасчетовАП", ОписаниеТипаСуммы);
	ОстаткиЗадолженности.Колонки.Добавить("ДокументАванса", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	Если ОстаткиЗадолженности.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОтборВозвратПолученныхАвансов = Новый Структура;
	ОтборВозвратПолученныхАвансов.Вставить("ЭтоПоступление", Ложь);
	ОтборВозвратПолученныхАвансов.Вставить("ВидАванса", "Полученный");
	ВозвратПолученныхАвансов = РасшифровкаПлатежа.НайтиСтроки(ОтборВозвратПолученныхАвансов);
	Если ВозвратПолученныхАвансов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаОтборАвансов = РасшифровкаПлатежа.СкопироватьКолонки();
	Для Каждого СтрокаВозвратПолученныхАвансов Из ВозвратПолученныхАвансов Цикл
		
		Если БухгалтерскийУчет.СчетВИерархии(СтрокаВозвратПолученныхАвансов.СчетАвансов, "АП")
			И СтрокаВозвратПолученныхАвансов.СпособПогашенияЗадолженности <> Перечисления.СпособыПогашенияЗадолженности.НеПогашать Тогда
			НоваяСтрока = ТаблицаОтборАвансов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВозвратПолученныхАвансов);
		КонецЕсли;
		
	КонецЦикла;
	ОстаткиАвансовПолученных = ОстаткиАвансов(ПериодОстатков, ТаблицаОтборАвансов, Реквизиты);
	Если ОстаткиАвансовПолученных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоСтрокЗадолженности = ОстаткиЗадолженности.Количество();
	Для НомерСтроки = 1 По КоличествоСтрокЗадолженности Цикл
		
		СтрокаЗадолженности = ОстаткиЗадолженности[КоличествоСтрокЗадолженности - НомерСтроки];
		
		Если СтрокаЗадолженности.СуммаРасчетов >= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(СтрокаЗадолженности.СчетРасчетов) Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("КФО,Контрагент,Договор",
			СтрокаЗадолженности.КФО,
			СтрокаЗадолженности.Контрагент,
			СтрокаЗадолженности.Договор);
		
		Отбор.Вставить("КЭК", БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(СтрокаЗадолженности.СчетРасчетов));
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаЗадолженности.СчетРасчетов);
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", СтрокаЗадолженности.ИФО);
		КонецЕсли;
		Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
			Отбор.Вставить("КПС", СтрокаЗадолженности.КПС);
		КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", СтрокаЗадолженности.Подразделение);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
			Отбор.Вставить("Валюта", СтрокаЗадолженности.Валюта);
		Иначе
			Отбор.Вставить("Валюта", Константы.ВалютаРегламентированногоУчета.Получить());
		КонецЕсли;
		
		Если СтрокаЗадолженности.ВидДопСубконтоРасчетов = ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов
			И ЗначениеЗаполнено(СтрокаЗадолженности.ДопСубконтоРасчетов) Тогда
			// Учет на счете АП всегда ведется по документам расчетов.
			Отбор.Вставить("ДопСубконтоАвансов", СтрокаЗадолженности.ДопСубконтоРасчетов);
		КонецЕсли;
		
		НайденныеОстаткиАвансов = ОстаткиАвансовПолученных.НайтиСтроки(Отбор);
		
		Если НайденныеОстаткиАвансов.Количество() > 0 Тогда
			
			Для Каждого СтрокаАвансов Из НайденныеОстаткиАвансов Цикл
				
				Если Не БухгалтерскийУчет.СчетВИерархии(СтрокаАвансов.СчетАвансов, "АП") Тогда
					Продолжить;
				КонецЕсли;
				
				Знак = -1;
				ПогашеннаяСуммаРасчетов = Мин(Знак*СтрокаЗадолженности.СуммаРасчетов, Знак*СтрокаАвансов.СуммаРасчетов);
				ПогашеннаяСуммаРуб      = Мин(Знак*СтрокаЗадолженности.СуммаРуб,      Знак*СтрокаАвансов.СуммаРуб);
				ПогашеннаяСуммаЕНВДРуб  = Мин(Знак*СтрокаЗадолженности.СуммаЕНВДРуб,  Знак*СтрокаАвансов.СуммаЕНВДРуб);
				
				Если ПогашеннаяСуммаРасчетов > 0 Тогда
					
					// Дополним остатки задолженности документами авансов.
					НоваяСтрока = ОстаткиЗадолженности.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗадолженности, , "СуммаРасчетов, СуммаРуб, СуммаЕНВДРуб");
					
					Если Не ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
						НоваяСтрока.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
					КонецЕсли;
					
					// Заполним информацию о найденном авансе полученном на счете АП.
					НоваяСтрока.СуммаРасчетовАП = СтрокаАвансов.СуммаРасчетов;
					НоваяСтрока.ДокументАванса  = СтрокаАвансов.ДопСубконтоАвансов;
					
					НоваяСтрока.СуммаРасчетов  = Знак*ПогашеннаяСуммаРасчетов;
					НоваяСтрока.СуммаРуб       = Знак*ПогашеннаяСуммаРуб;
					НоваяСтрока.СуммаЕНВДРуб   = Знак*ПогашеннаяСуммаЕНВДРуб;
					
					// Уменьшим остаток задолженности без документов авансов.
					СтрокаЗадолженности.СуммаРасчетов = СтрокаЗадолженности.СуммаРасчетов - НоваяСтрока.СуммаРасчетов;
					СтрокаЗадолженности.СуммаРуб      = СтрокаЗадолженности.СуммаРуб      - НоваяСтрока.СуммаРуб;
					СтрокаЗадолженности.СуммаЕНВДРуб  = СтрокаЗадолженности.СуммаЕНВДРуб  - НоваяСтрока.СуммаЕНВДРуб;
					
					// Уменьшим остаток нераспределенных авансов.
					СтрокаАвансов.СуммаРасчетов = СтрокаАвансов.СуммаРасчетов - НоваяСтрока.СуммаРасчетов;
					СтрокаАвансов.СуммаРуб      = СтрокаАвансов.СуммаРуб      - НоваяСтрока.СуммаРуб;
					СтрокаАвансов.СуммаЕНВДРуб  = СтрокаАвансов.СуммаЕНВДРуб  - НоваяСтрока.СуммаЕНВДРуб;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтрокиПогашенияЗадолженности(ТаблицаРасчетов, НераспределеннаяСумма, НераспределеннаяСуммаВВалютеСписания, ОстаткиЗадолженности, СтрокаПлатежа, Реквизиты, Отказ)
	
	Знак = ?(СтрокаПлатежа.ЭтоПоступление, +1, -1);
		
	Для Каждого СтрокаОстатка Из ОстаткиЗадолженности Цикл
		
		Если НераспределеннаяСумма <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПогашеннаяСумма = Мин(НераспределеннаяСумма, Знак * СтрокаОстатка.СуммаРасчетов);
		Если ПогашеннаяСумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРасчетов = ТаблицаРасчетов.Добавить();
		СтрокаРасчетов.ЭтоАванс = Ложь;
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаОстатка,
			"ИФО,КФО,КПС,Подразделение,Валюта,
			|СчетРасчетов,Контрагент,Договор,ДопСубконтоРасчетов,ВидДопСубконтоРасчетов");
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаПлатежа,
			"ИмяСписка,СинонимСписка,НомерСтроки,СчетАвансов,КЭК,ВидДоговора,РасчетыВВалюте,УчетАгентскогоНДС,
			|ПроданнаяВалюта,
			|ИсточникСредств,ДопКлассификация,КодМероприятия,КодЦели,НазначениеПлатежа,СпособПогашенияЗадолженности");
		
		// Если у счета расчетов нет субконто "Договоры", то при наличии задолженности
		// договор в строке расчетов не заполнится, а он нужен для заполнения характеристики движения.
		Если НЕ ЗначениеЗаполнено(СтрокаРасчетов.Договор) И ЗначениеЗаполнено(СтрокаПлатежа.Договор) Тогда
			СтрокаРасчетов.Договор = СтрокаПлатежа.Договор;
		КонецЕсли;
		
		СтрокаРасчетов.ОстатокРасчетов = Знак * СтрокаОстатка.СуммаРасчетов;
		СтрокаРасчетов.СуммаРасчетов   = ПогашеннаяСумма;
		
		Если ПогашеннаяСумма = НераспределеннаяСумма Тогда
			СтрокаРасчетов.СуммаПроданнойВалюты = НераспределеннаяСуммаВВалютеСписания;
		Иначе
			СтрокаРасчетов.СуммаПроданнойВалюты = Окр(НераспределеннаяСуммаВВалютеСписания * ПогашеннаяСумма / НераспределеннаяСумма, 2);
		КонецЕсли;
		
		// При погашении задолженности по авансам полученным сохраним информацию со счета АП.
		СтрокаРасчетов.ОстатокРасчетовАП = Знак * СтрокаОстатка.СуммаРасчетовАП;
		СтрокаРасчетов.ДокументАванса    = СтрокаОстатка.ДокументАванса;
		
		КоэффициентКурсаАванса = ?(НЕ СтрокаПлатежа.РасчетыВВалюте, 1,
			?(СтрокаОстатка.СуммаРасчетов = 0, 0, СтрокаОстатка.СуммаРуб / СтрокаОстатка.СуммаРасчетов));
		
		КоэффициентРуб = ?(НЕ СтрокаПлатежа.РасчетыВВалюте, 1,
			?(СтрокаПлатежа.СуммаРасчетов = 0, 0, СтрокаПлатежа.СуммаРуб / СтрокаПлатежа.СуммаРасчетов));
		
		СтрокаРасчетов.СуммаРубПоКурсуАванса = Окр(ПогашеннаяСумма * КоэффициентКурсаАванса, 2);
		СтрокаРасчетов.СуммаРуб              = Окр(ПогашеннаяСумма * КоэффициентРуб, 2);
		
		Если Реквизиты.УчитыватьЗадолженностьЕНВД Тогда
			
			Если ПогашеннаяСумма = Знак * СтрокаОстатка.СуммаРасчетов Тогда
				СтрокаРасчетов.СуммаЕНВДРуб = Знак * СтрокаОстатка.СуммаЕНВДРуб;
			Иначе
				СтрокаРасчетов.СуммаЕНВДРуб = Окр(СтрокаОстатка.СуммаЕНВДРуб * (ПогашеннаяСумма / СтрокаОстатка.СуммаРасчетов), 2);
			КонецЕсли;
			
			СтрокаОстатка.СуммаЕНВДРуб = СтрокаОстатка.СуммаЕНВДРуб - Знак * СтрокаРасчетов.СуммаЕНВДРуб;
		
		КонецЕсли;
		
		НераспределеннаяСумма = НераспределеннаяСумма - ПогашеннаяСумма;
		НераспределеннаяСуммаВВалютеСписания = НераспределеннаяСуммаВВалютеСписания - СтрокаРасчетов.СуммаПроданнойВалюты;
		
		СтрокаОстатка.СуммаРасчетов = СтрокаОстатка.СуммаРасчетов - Знак * СтрокаРасчетов.СуммаРасчетов;
		СтрокаОстатка.СуммаРуб      = СтрокаОстатка.СуммаРуб      - Знак * СтрокаРасчетов.СуммаРубПоКурсуАванса;
		
	КонецЦикла;
	
	// При погашении задолженности вручную нераспределенный остаток означает,
	// что указанная сумма погашения превышает остаток по документу (доп.субконто расчетов).
	Если СтрокаПлатежа.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.ПоДокументу
		И НераспределеннаяСумма > 0 Тогда
		
		Если ЗначениеЗаполнено(СтрокаПлатежа.ДопСубконтоРасчетов) Тогда
			ТекстОшибки = НСтр("ru='Указана сумма погашения, превышающая остаток задолженности по документу (доп.аналитике) расчетов: ""%4"".
				|
				|Указана сумма погашения: %1; Остаток задолженности: %2; Превышение: %3'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОбщегоНазначенияБГУ.ФорматСумм(СтрокаПлатежа.СуммаРасчетов, СтрокаПлатежа.Валюта, "0"),
				ОбщегоНазначенияБГУ.ФорматСумм(СтрокаПлатежа.СуммаРасчетов - НераспределеннаяСумма, СтрокаПлатежа.Валюта, "0"),
				ОбщегоНазначенияБГУ.ФорматСумм(НераспределеннаяСумма, СтрокаПлатежа.Валюта, "0"),
				СтрокаПлатежа.ДопСубконтоРасчетов);
		Иначе
			ТекстОшибки = НСтр("ru='Указана сумма погашения, превышающая остаток задолженности.
				|
				|Указана сумма погашения: %1; Остаток задолженности: %2; Превышение: %3'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОбщегоНазначенияБГУ.ФорматСумм(СтрокаПлатежа.СуммаРасчетов, СтрокаПлатежа.Валюта, "0"),
				ОбщегоНазначенияБГУ.ФорматСумм(СтрокаПлатежа.СуммаРасчетов - НераспределеннаяСумма, СтрокаПлатежа.Валюта, "0"),
				ОбщегоНазначенияБГУ.ФорматСумм(НераспределеннаяСумма, СтрокаПлатежа.Валюта, "0"));
		КонецЕсли;
		
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("СуммаВал", Реквизиты.Ссылка.Метаданные(), "РасшифровкаПлатежа") Тогда
			ПолеСумма = "РасшифровкаПлатежа[" + Формат(СтрокаПлатежа.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СуммаВал";
		Иначе
			ПолеСумма = "РасшифровкаПлатежа[" + Формат(СтрокаПлатежа.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Сумма";
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, ПолеСумма, "Объект");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуАванса(ТаблицаРасчетов, НераспределеннаяСумма, НераспределеннаяСуммаВВалютеСписания, СтрокаПлатежа, Реквизиты)
	
	Если НераспределеннаяСумма <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРасчетов = ТаблицаРасчетов.Добавить();
	СтрокаРасчетов.ЭтоАванс = Истина;
	
	ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаПлатежа,
		"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,
		|СчетРасчетов,СчетАвансов,Контрагент,Договор,Валюта,СпособПогашенияЗадолженности,
		|ПроданнаяВалюта,
		|ВидДоговора,РасчетыВВалюте,УчетАгентскогоНДС,ИсточникСредств,ДопКлассификация,КодМероприятия,КодЦели,НазначениеПлатежа");
	
	Если УчетРасчетовКлиентСервер.ВедетсяУчетПоДокументамРасчетов(
			Реквизиты.Организация, Реквизиты.Дата, СтрокаПлатежа.КФО, СтрокаПлатежа.Валюта, СтрокаПлатежа.СчетРасчетов) Тогда
		СтрокаРасчетов.ВидДопСубконтоРасчетов = СтрокаПлатежа.ВидДопСубконтоРасчетов;
		СтрокаРасчетов.ДопСубконтоРасчетов    = Реквизиты.Ссылка;
	ИначеЕсли ЗначениеЗаполнено(СтрокаПлатежа.ВидДопСубконтоРасчетов)
		И СтрокаПлатежа.ВидДопСубконтоРасчетов <> ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов Тогда
		СтрокаРасчетов.ВидДопСубконтоРасчетов = СтрокаПлатежа.ВидДопСубконтоРасчетов;
		СтрокаРасчетов.ДопСубконтоРасчетов    = СтрокаПлатежа.ДопСубконтоРасчетов;
	КонецЕсли;
	
	Если СтрокаПлатежа.ЭтоПоступление И СтрокаПлатежа.ВидАванса = "Полученный" Тогда
		СтрокаРасчетов.ДокументАванса = Реквизиты.Ссылка;
	КонецЕсли;
	
	СтрокаРасчетов.СуммаРасчетов = НераспределеннаяСумма;
	СтрокаРасчетов.СуммаПроданнойВалюты = НераспределеннаяСуммаВВалютеСписания;
	
	КоэффициентРуб = ?(НЕ СтрокаПлатежа.РасчетыВВалюте, 1,
		?(СтрокаПлатежа.СуммаРасчетов = 0, 0, СтрокаПлатежа.СуммаРуб / СтрокаПлатежа.СуммаРасчетов));
	
	СтрокаРасчетов.СуммаРуб              = Окр(НераспределеннаяСумма * КоэффициентРуб, 2);
	СтрокаРасчетов.СуммаРубПоКурсуАванса = СтрокаРасчетов.СуммаРуб;
	
	Если Реквизиты.УчитыватьЗадолженностьЕНВД
	   И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаПлатежа.КФО)
	   И УчетРасчетов.ВедетсяУчетАвансовПолученных(СтрокаПлатежа.СчетРасчетов) Тогда
	
		СтрокаРасчетов.ОтражениеАвансаУСН = СтрокаПлатежа.ОтражениеАвансаУСН;
		Если СтрокаПлатежа.ОтражениеАвансаУСН = Перечисления.ПорядокОтраженияАвансовУСН.ДоходЕНВД Тогда
			СтрокаРасчетов.СуммаЕНВДРуб = СтрокаРасчетов.СуммаРуб;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДенежныеОбязательства

// Структура таблицы принятых денежных обязательств.
//
Функция ПустаяТаблицаПринятыеДенежныеОбязательства() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Суммы обязательств.
	ПустаяТаблица.Колонки.Добавить("СуммаВал", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРуб", ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу принятых денежных обязательств.
//
Функция ТаблицаПринятыеДенежныеОбязательства(ТаблицаРасчетовСЗачетомАвансов, ТаблицыПоступления, Реквизиты = Неопределено, Отказ = Неопределено) Экспорт
	
	ДенежныеОбязательства = ПустаяТаблицаПринятыеДенежныеОбязательства();
	Если ТипЗнч(Реквизиты) = Тип("Структура") Тогда
		ЗаполнятьКЭК = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Реквизиты, "ЗаполнятьКЭК", Ложь);
	Иначе
		ЗаполнятьКЭК = Ложь;
	КонецЕсли;
	
	// По обычным договорам с поставщиками денежные обязательства будем признавать на сумму,
	// оставшуюся после зачета всех авансов.
	СтрокиОбязательств = ТаблицаРасчетовСЗачетомАвансов.НайтиСтроки(
		Новый Структура("ЭтоЗачетАванса", Ложь));
	Для Каждого СтрокаОбязательств Из СтрокиОбязательств Цикл
		
		Если БухгалтерскийУчет.СчетВИерархии(СтрокаОбязательств.СчетРасчетов, "303.00") Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДенежныеОбязательства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОбязательств,
			"ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта");
		
		НоваяСтрока.СуммаВал = СтрокаОбязательств.СуммаРасчетов;
		НоваяСтрока.СуммаРуб = СтрокаОбязательств.СуммаРубПоКурсуАванса;
		
		Если ЗаполнятьКЭК Тогда
			НоваяСтрока.КЭК = СтрокаОбязательств.КЭК;
		КонецЕсли;
		
	КонецЦикла;
	
	// По агентским договорам (в части НДС) к сумме денежного обязательства добавим сумму НДС.
	Для Каждого ТаблицаПоступления Из ТаблицыПоступления Цикл
		ЕстьКолонкаКЭК = ТаблицаПоступления.Значение.Колонки.Найти("КЭК");
		Для Каждого СтрокаПоступления Из ТаблицаПоступления.Значение Цикл
			
			Если УчетРасчетов.УчетАгентскогоНДС(СтрокаПоступления.Договор) Тогда
				
				НоваяСтрока = ДенежныеОбязательства.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПоступления,
					"ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта");
				
				НоваяСтрока.СуммаВал = СтрокаПоступления.СуммаНДСВал;
				НоваяСтрока.СуммаРуб = СтрокаПоступления.СуммаНДСРуб;
		
				Если ЗаполнятьКЭК И ЕстьКолонкаКЭК Тогда
					НоваяСтрока.КЭК = СтрокаОбязательств.КЭК;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	ДенежныеОбязательства.Свернуть("ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта,КЭК",
		"СуммаВал,СуммаРуб");
	
	Возврат ДенежныеОбязательства;
	
КонецФункции

// Структура таблицы принятых денежных обязательств при отражении зарплаты в учете.
//
Функция ПустаяТаблицаПринятыеДенежныеОбязательстваПоОплатеТруда() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Аналитика операции.
	ПустаяТаблица.Колонки.Добавить("ВидОперации",   Новый ОписаниеТипов("СправочникСсылка.ВидыОперацийОтраженияЗарплаты"));
	ПустаяТаблица.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	// Сумма обязательств.
	ПустаяТаблица.Колонки.Добавить("Сумма", ОписаниеТипаСуммы);
	// Вспомогательные реквизиты.
	ПустаяТаблица.Колонки.Добавить("ДопКлассификация",   Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ПустаяТаблица.Колонки.Добавить("КодМероприятия",     Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ПустаяТаблица.Колонки.Добавить("КодЦели",            Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу принятых денежных обязательств при отражении зарплаты в учете.
//
Функция ТаблицаПринятыеДенежныеОбязательстваПоОплатеТруда(Документ, Параметры, Отказ) Экспорт
	
	ДенежныеОбязательства = ПустаяТаблицаПринятыеДенежныеОбязательстваПоОплатеТруда();
	
	ВидыОперацийФСС = Новый Массив;
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаПодземныхИВредныхРаботах);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаПодземныхИВредныхРаботахБезСпецОценки);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаПодземныхИВредныхРаботахСпецОценка);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаТяжелыхИПрочихРаботах);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахБезСпецОценки);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахСпецОценка);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРДополнительнаяНаДоплатуКПенсииШахтерам);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРНакопительная);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРСтраховая);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРДополнительнаяЛетныхЭкипажей);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРДополнительная);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРПоСуммарномуТарифу);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ТФОМС);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ФСС);
	ВидыОперацийФСС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ФФОМС);
	
	ВидыОперацийФСС_НС = Новый Массив;
	ВидыОперацийФСС_НС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Начисление_НСиПЗ);
	ВидыОперацийФСС_НС.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_Страхование);
	
	Счет30302 = ПланыСчетов.ЕПСБУ.НайтиПоКоду("303.02");
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Операции",
		"НомерСтроки,ИФО,КФО,Счет,КПС,КЭК,Подразделение,
		|ВидОперации,Контрагент,Договор,ВалютаДокумента,
		|ДопКлассификация,КодМероприятия,КодЦели,Сумма",
		Документ, Параметры);
		
	Запрос.УстановитьПараметр("ВидыОперацийФСС", ВидыОперацийФСС);
	Запрос.УстановитьПараметр("ВидыОперацийФССНС", ВидыОперацийФСС_НС);
	Запрос.УстановитьПараметр("Счет30302", Счет30302);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ФСС) КАК ВидОперации,
	|	Операции.ИФО КАК ИФО,
	|	Операции.КФО КАК КФО,
	|	Операции.КПС КАК КПС,
	|	Операции.КЭК КАК КЭК,
	|	Операции.Подразделение КАК Подразделение,
	|	Операции.Контрагент КАК Контрагент,
	|	Операции.Договор КАК Договор,
	|	Операции.ДопКлассификация КАК ДопКлассификация,
	|	Операции.КодМероприятия КАК КодМероприятия,
	|	Операции.КодЦели КАК КодЦели,
	|	СУММА(-Операции.Сумма) КАК Сумма
	|ИЗ
	|	ТаблицаОперации КАК Операции
	|ГДЕ
	|	(Операции.ВидОперации В (&ВидыОперацийФСС)
	|				И Операции.Счет = &Счет30302
	|			%ОтборУменьшениеДО%)
	|СГРУППИРОВАТЬ ПО
	|	Операции.ИФО,
	|	Операции.КФО,
	|	Операции.КПС,
	|	Операции.КЭК,
	|	Операции.Подразделение,
	|	Операции.Контрагент,
	|	Операции.Договор,
	|	Операции.ДопКлассификация,
	|	Операции.КодМероприятия,
	|	Операции.КодЦели
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_Страхование),
	|	Операции.ИФО,
	|	Операции.КФО,
	|	Операции.КПС,
	|	Операции.КЭК,
	|	Операции.Подразделение,
	|	Операции.Контрагент,
	|	Операции.Договор,
	|	Операции.ДопКлассификация,
	|	Операции.КодМероприятия,
	|	Операции.КодЦели,
	|	СУММА(-Операции.Сумма)
	|ИЗ
	|	ТаблицаОперации КАК Операции
	|ГДЕ
	|	(Операции.ВидОперации В (&ВидыОперацийФССНС)
	|				И Операции.Счет = &Счет30302
	|			ИЛИ Операции.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийОтраженияЗарплаты.ЗП_Начисление_НСиПЗ))
	|СГРУППИРОВАТЬ ПО
	|	Операции.ИФО,
	|	Операции.КФО,
	|	Операции.КПС,
	|	Операции.КЭК,
	|	Операции.Подразделение,
	|	Операции.Контрагент,
	|	Операции.Договор,
	|	Операции.ДопКлассификация,
	|	Операции.КодМероприятия,
	|	Операции.КодЦели
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""Операции"" КАК ИмяСписка,
	|	""Операции"" КАК СинонимСписка,
	|	Операции.НомерСтроки КАК НомерСтроки,
	|	Операции.ИФО КАК ИФО,
	|	Операции.КФО КАК КФО,
	|	Операции.КПС КАК КПС,
	|	Операции.КЭК КАК КЭК,
	|	Операции.Подразделение КАК Подразделение,
	|	Операции.ВидОперации КАК ВидОперации,
	|	Операции.ВидОперации.Код КАК КодВидаОперации,
	|	Операции.Контрагент КАК Контрагент,
	|	Операции.Договор КАК Договор,
	|	Операции.ВалютаДокумента КАК Валюта,
	|	Операции.ДопКлассификация КАК ДопКлассификация,
	|	Операции.КодМероприятия КАК КодМероприятия,
	|	Операции.КодЦели КАК КодЦели,
	|	Операции.Сумма КАК Сумма
	|ИЗ
	|	ТаблицаОперации КАК Операции
	|ГДЕ
	|	Операции.ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_НДФЛ)
	|	И Операции.ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_ПФРДополнительная)
	|	И Операции.ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_Разные)
	|	И Операции.ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОперацийОтраженияЗарплаты.ЗП_Удержания_НДФЛСПревышения)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Если Документ.Дата >= Дата("20230101") Тогда
		ТекстОтбораУменьшениеДО = "";
	Иначе
		ТекстОтбораУменьшениеДО = "ИЛИ Операции.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийОтраженияЗарплаты.ЗП_Начисление_ПособияФСС2010)";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"%ОтборУменьшениеДО%",
			ТекстОтбораУменьшениеДО);
	
	Результат = Запрос.ВыполнитьПакет();
	ТаблицаУменьшениеДО = Результат[1].Выгрузить();
	ТаблицаОперации = Результат[2].Выгрузить();
	
	Для Каждого СтрокаОперации Из ТаблицаОперации Цикл
		
		НоваяСтрока = ДенежныеОбязательства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОперации);
		
	КонецЦикла;
	
	// Уменьшим страховые взносы в ФСС на начисления за счет ФСС (встречные требования).
	Для Каждого СтрокаУменьшениеДО Из ТаблицаУменьшениеДО Цикл
		
		НоваяСтрока = ДенежныеОбязательства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаУменьшениеДО);
		
	КонецЦикла;

	Возврат ДенежныеОбязательства;
	
КонецФункции

// Формирует таблицу принятых денежных обязательств при отражении в учете начисленных процентов, пени, штрафов к уплате.
//
Функция ТаблицаПринятыеДенежныеОбязательстваПоПроцентамПениШтрафамКУплате(Документ, Параметры = Неопределено) Экспорт
	
	ДенежныеОбязательства = ПустаяТаблицаПринятыеДенежныеОбязательства();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Начисления",
		"ИФО,КФО,КПС,Подразделение,Контрагент,Договор,Валюта,СчетРасчетов,Сумма,СуммаВал", Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	Начисления.ИФО КАК ИФО,
	|	Начисления.КФО КАК КФО,
	|	Начисления.КПС КАК КПС,
	|	Начисления.Подразделение КАК Подразделение,
	|	Начисления.СчетРасчетов КАК СчетРасчетов,
	|	Начисления.Контрагент КАК Контрагент,
	|	Начисления.Договор КАК Договор,
	|	Начисления.Валюта КАК Валюта,
	|	Начисления.Сумма КАК СуммаРуб,
	|	Начисления.СуммаВал КАК СуммаВал
	|ИЗ
	|	ТаблицаНачисления КАК Начисления";
	
	Начисления = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Начисления Цикл
		
		НоваяСтрока = ДенежныеОбязательства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла;
	
	ДенежныеОбязательства.Свернуть("ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта",
		"СуммаВал,СуммаРуб");
	
	Возврат ДенежныеОбязательства;
	
КонецФункции

// Рассчитывает денежные обязательства в документах поступления товаров, работ, услуг.
// Документ должен быть не проведен.
//
// Параметры:
//  Объект						 - ДокументОбъект,
//  ПериодОстатков				 - Граница - граница для получения таблицы расчетов по документу,
//  Отказ						 - Булево - возвращаемое значение. Равен ИСТИНА, если возникли ошибки при расчете.
// 
// Возвращаемое значение:
// ТаблицаЗначений - таблица сумм денежных обязательств
//
Функция ДенежныеОбязательстваПоПоступлениюТРУ(Объект, ПериодОстатков, Отказ = Ложь) Экспорт

	ТаблицаОбязательств = Новый ТаблицаЗначений;
	ТаблицаОбязательств.Колонки.Добавить("КФО",   			Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаОбязательств.Колонки.Добавить("КПС",   			Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаОбязательств.Колонки.Добавить("КЭК",   			Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаОбязательств.Колонки.Добавить("Контрагент",		Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаОбязательств.Колонки.Добавить("Договор",   		Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаОбязательств.Колонки.Добавить("Подразделение", 	Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаОбязательств.Колонки.Добавить("Сумма", 			Новый ОписаниеТипов("Число"));
	
	ПараметрыЗаполнения = Новый Структура("ПериодОстатков, Организация, Дата, Ссылка, КЭКРасчетов, СчетРасчетов, КПС, СпособЗачетаАванса ,КПСРасчетовВТЧ");
	
	ПараметрыЗаполнения.ПериодОстатков = ПериодОстатков;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "СчетРасчетов") Тогда
		ПараметрыЗаполнения.СчетРасчетов = Объект.СчетРасчетов;
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеМЗВПути") Тогда
		ПараметрыЗаполнения.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.34", Объект.Дата, Объект.Организация);
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "КПСРасчетов") Тогда
		ПараметрыЗаполнения.КПС = Объект.КПСРасчетов;
	Иначе
		ПараметрыЗаполнения.КПС = Неопределено;
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "НесколькоКПСРасчетов") Тогда
		ПараметрыЗаполнения.КПСРасчетовВТЧ = Объект.НесколькоКПСРасчетов;
	Иначе
		ПараметрыЗаполнения.КПСРасчетовВТЧ = Ложь;
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "СпособЗачетаАванса") Тогда
		ПараметрыЗаполнения.СпособЗачетаАванса = Объект.СпособЗачетаАванса;
	КонецЕсли;
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат") Тогда
		ПараметрыЗаполнения.Вставить("Курс", Объект.Курс);
		ПараметрыЗаполнения.Вставить("Кратность", Объект.Кратность);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, Объект, "Организация, Дата, Ссылка");
	
	РасчетыПоДокументу = ПодготовитьТаблицуРасчетовПоДокументу(Объект, ПараметрыЗаполнения, Отказ);
	
	Если Отказ Тогда
		Возврат ТаблицаОбязательств;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "НомерКорректировки") И Объект.НомерКорректировки > 0 Тогда
		ПараметрыЗаполнения.Вставить("НомерКорректировки", Объект.НомерКорректировки);
		ПараметрыЗаполнения.Вставить("КорректируемыйДокумент", Объект.ДокументОснование);
	КонецЕсли;
	
	Если ПараметрыЗаполнения.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.ПоДокументу Тогда
		
		ВалютаРубль = Константы.ВалютаРегламентированногоУчета.Получить();
		
		ЗачетАвансовПоДокументу = ПустаяТаблицаЗачетАвансовПоДокументу();
		Для Каждого СтрокаАванса Из Объект.ЗачетАвансов Цикл
			НоваяСтрокаЗачета = ЗачетАвансовПоДокументу.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаЗачета, Объект);
			ЗаполнитьЗначенияСвойств(НоваяСтрокаЗачета, СтрокаАванса);
			Если Не ЗначениеЗаполнено(НоваяСтрокаЗачета.СчетРасчетов) Тогда
				НоваяСтрокаЗачета.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрокаЗачета.КЭК, "302.00", ,
					Объект.Дата, Объект.Организация);
			КонецЕсли;
			НоваяСтрокаЗачета.СчетАвансов = ОпределитьСчетАвансов(НоваяСтрокаЗачета.СчетРасчетов,
				Объект.Дата, Объект.Организация);
			НоваяСтрокаЗачета.СуммаРасчетов = СтрокаАванса.СуммаЗачета;
			НоваяСтрокаЗачета.ЭтоПоступление = Истина;
			НоваяСтрокаЗачета.Валюта = ?(ЗначениеЗаполнено(НоваяСтрокаЗачета.Валюта), НоваяСтрокаЗачета.Валюта, ВалютаРубль);
		КонецЦикла;
		
	Иначе
		ЗачетАвансовПоДокументу = ПустаяТаблицаЗачетАвансовПоДокументу();
	КонецЕсли;
	РасчетыСЗачетомАвансов = ТаблицаРасчетовСЗачетомАвансов(РасчетыПоДокументу, ЗачетАвансовПоДокументу, ПараметрыЗаполнения, Отказ);
	
	Если Отказ Тогда
		Возврат ТаблицаОбязательств;
	КонецЕсли;
	
	ТаблицыПоступления = Новый Структура;
	
	РассчитыватьКЭКВКаждойСтроке = ТипЗнч(Объект) = Тип("ДокументОбъект.АктПриемкиТоваровРаботУслуг");
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.АктПриемкиТоваровРаботУслуг") Тогда
		ТаблицаПоступления = УправлениеМатериальнымиЗапасами.ПустаяТаблицаПоступлениеМатериальныхЗапасов();
		
		МатериальныеЗапасыДокумента = УправлениеМатериальнымиЗапасами.ПодготовитьТаблицуПоступлениеМатериальныхЗапасовПоДокументу(Объект,, Отказ);
		ТаблицаПоступленияМЗ = УправлениеМатериальнымиЗапасами.ТаблицаПоступлениеМатериальныхЗапасов(МатериальныеЗапасыДокумента, РасчетыСЗачетомАвансов);
		Для каждого СтрокаПоступленияМЗ Из ТаблицаПоступленияМЗ Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаПоступления.Добавить(), СтрокаПоступленияМЗ);
		КонецЦикла;
		
		ПараметрыЗаполнения.Вставить("ВидЗатрат", ПредопределенноеЗначение("Справочник.ВидыЗатрат.ПустаяСсылка"));
		ОСДокумента = УправлениеОсновнымиСредствами.ПодготовитьТаблицуПоступлениеОсновныхСредствПоДокументу(Объект, ПараметрыЗаполнения, Отказ);
		ТаблицаПоступленияОС = УправлениеОсновнымиСредствами.ТаблицаПоступлениеОсновныхСредств(ОСДокумента, РасчетыСЗачетомАвансов, ПараметрыЗаполнения, Отказ);
		Для каждого СтрокаПоступленияОС Из ТаблицаПоступленияОС Цикл
			СтрокаПоступления = ТаблицаПоступления.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПоступления, СтрокаПоступленияОС);
			СтрокаПоступления.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(СтрокаПоступленияОС.СчетРасчетов)
		КонецЦикла;
		
		ТабДокумента = ПодготовитьТаблицуПоступлениеУслугРаботПоДокументу(Объект, ПараметрыЗаполнения); 
		ТаблицаПоступленияУслуг = ТаблицаПоступлениеУслугРабот(ТабДокумента, РасчетыСЗачетомАвансов, ПараметрыЗаполнения, Отказ);
		Для каждого СтрокаПоступленияУслуг Из ТаблицаПоступленияУслуг Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаПоступления.Добавить(), СтрокаПоступленияУслуг);
		КонецЦикла;
		ТаблицыПоступления.Вставить("ПоступлениеМатериальныхЗапасов", ТаблицаПоступления);
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("Материалы", Объект.Метаданные()) Тогда
		МатериальныеЗапасыДокумента = УправлениеМатериальнымиЗапасами.ПодготовитьТаблицуПоступлениеМатериальныхЗапасовПоДокументу(Объект, ПараметрыЗаполнения, Отказ);
		Если Отказ Тогда
			Возврат ТаблицаОбязательств;
		КонецЕсли;
		ТаблицаПоступления = УправлениеМатериальнымиЗапасами.ТаблицаПоступлениеМатериальныхЗапасов(МатериальныеЗапасыДокумента, РасчетыСЗачетомАвансов);
		ВозвратнаяТараДокумента = УправлениеМатериальнымиЗапасами.ПодготовитьТаблицуПоступлениеВозвратнойТарыПоДокументу(Объект, ПараметрыЗаполнения, Отказ);
		Если Отказ Тогда
			Возврат ТаблицаОбязательств;
		КонецЕсли;
		Для каждого СтрокаВозвратнойТары Из ВозвратнаяТараДокумента Цикл
			НоваяСтрока = ТаблицаПоступления.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВозвратнойТары);
			НоваяСтрока.СуммаРуб = СтрокаВозвратнойТары.Сумма;
		КонецЦикла;
		ТаблицыПоступления.Вставить("ПоступлениеМатериальныхЗапасов", ТаблицаПоступления);
	
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("КапВложения", Объект.Метаданные()) Тогда
		ПараметрыЗаполнения.Вставить("ВидЗатрат", ПредопределенноеЗначение("Справочник.ВидыЗатрат.ПустаяСсылка"));
		ОСДокумента = УправлениеОсновнымиСредствами.ПодготовитьТаблицуПоступлениеОсновныхСредствПоДокументу(Объект, ПараметрыЗаполнения, Отказ);
		Если Отказ Тогда
			Возврат ТаблицаОбязательств;
		КонецЕсли;
		ТаблицаПоступления = УправлениеОсновнымиСредствами.ТаблицаПоступлениеОсновныхСредств(ОСДокумента, РасчетыСЗачетомАвансов, ПараметрыЗаполнения, Отказ);
		Если Отказ Тогда
			Возврат ТаблицаОбязательств;
		КонецЕсли;
		ТаблицыПоступления.Вставить("ПоступлениеОсновныхСредств", ТаблицаПоступления);
		
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("ПраваПользования", Объект.Метаданные())
		Или ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("УслугиИРаботы", Объект.Метаданные()) Тогда
			
		ТабДокумента = ПодготовитьТаблицуПоступлениеУслугРаботПоДокументу(Объект, ПараметрыЗаполнения); 
		ТаблицаПоступления = ТаблицаПоступлениеУслугРабот(ТабДокумента, РасчетыСЗачетомАвансов, ПараметрыЗаполнения, Отказ);
		Если Отказ Тогда
			Возврат ТаблицаОбязательств;
		КонецЕсли;
		ТаблицыПоступления.Вставить("ПоступлениеУслугРабот", ТаблицаПоступления);
	КонецЕсли;
	
	ПараметрыРасчетаДО = Новый Структура;
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.АктПриемкиТоваровРаботУслуг") Тогда
		ПараметрыРасчетаДО.Вставить("ЗаполнятьКЭК", Истина);
	КонецЕсли;
	ТаблицаДО = ТаблицаПринятыеДенежныеОбязательства(РасчетыСЗачетомАвансов, ТаблицыПоступления, ПараметрыРасчетаДО);
	
	КЭК340 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("340");
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеУслугРабот")
		Или ТипЗнч(Объект) = Тип("ДокументОбъект.АктПриемкиТоваровРаботУслуг") Тогда
		ИспользоватьДетальныйКЭК = Истина;
	Иначе
		Если ЗначениеЗаполнено(ПараметрыЗаполнения.СчетРасчетов) Тогда
			КЭКРасчетов = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчетуСУчетомПоступленияМЗ(ПараметрыЗаполнения.СчетРасчетов);
		Иначе
			КЭКРасчетов = Справочники.КОСГУ.ПустаяСсылка();
		КонецЕсли;
		ИспользоватьДетальныйКЭК = КЭКРасчетов = КЭК340;
	КонецЕсли;
	
	ПринятьВсеОбязательства = (ТипЗнч(ТаблицаПоступления) = Тип("ТаблицаЗначений"))  
	                          И (ТаблицаПоступления.Итог("СуммаРуб") = ТаблицаДО.Итог("СуммаРуб"));
		
	Если ПринятьВсеОбязательства И ИспользоватьДетальныйКЭК  Тогда
		
		Для Каждого СтрМатериалы Из ТаблицаПоступления Цикл
			НовСтрДО = ТаблицаОбязательств.Добавить();
			НовСтрДО.КФО   = СтрМатериалы.КФО;
			Если ПараметрыЗаполнения.КПСРасчетовВТЧ Тогда
				НовСтрДО.КПС   = ?(ЗначениеЗаполнено(СтрМатериалы.КПСРасчетов), СтрМатериалы.КПСРасчетов,
				?(ЗначениеЗаполнено(ПараметрыЗаполнения.КПС), ПараметрыЗаполнения.КПС, СтрМатериалы.КПС));
			Иначе
				НовСтрДО.КПС   = ?(ЗначениеЗаполнено(ПараметрыЗаполнения.КПС), ПараметрыЗаполнения.КПС, СтрМатериалы.КПС);
			КонецЕсли;
			НовСтрДО.КЭК   = СтрМатериалы.КЭК;
			НовСтрДО.Сумма = СтрМатериалы.СуммаРуб;
		КонецЦикла;
		
	Иначе
		
		ДетальныеКЭК340 = ДетальныеКЭК340();
		ПоступлениеМЗПоРазнымКЭК = ЕстьРазныеДетальныеКЭК340(ТаблицаПоступления, ДетальныеКЭК340);
		Если ИспользоватьДетальныйКЭК Тогда
			ИспользуемыеКОСГУ = ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаПоступления, "КЭК", Истина);
			Если ИспользуемыеКОСГУ.Количество() = 1 И ЗначениеЗаполнено(ИспользуемыеКОСГУ[0]) Тогда
				КОСГУ = ИспользуемыеКОСГУ[0];
			Иначе
				КОСГУ = Справочники.КОСГУ.ПустаяСсылка();
			КонецЕсли;
		Иначе
			КОСГУ = КЭКРасчетов;
		КонецЕсли;
		
		Для Каждого СтрТаблицаДО Из ТаблицаДО Цикл
			НовСтрДО = ТаблицаОбязательств.Добавить();
			НовСтрДО.Контрагент= СтрТаблицаДО.Контрагент;
			НовСтрДО.Договор= СтрТаблицаДО.Договор;
			НовСтрДО.Подразделение= СтрТаблицаДО.Подразделение;
			НовСтрДО.КФО   = СтрТаблицаДО.КФО;
			НовСтрДО.КПС   = СтрТаблицаДО.КПС;
			Если РассчитыватьКЭКВКаждойСтроке Тогда
				Если ДетальныеКЭК340.Получить(СтрТаблицаДО.КЭК) <> Неопределено
					И ПоступлениеМЗПоРазнымКЭК Тогда
					НовСтрДО.КЭК = КЭК340;
				ИначеЕсли ЗначениеЗаполнено(СтрТаблицаДО.КЭК) Тогда
					НовСтрДО.КЭК = СтрТаблицаДО.КЭК;
				Иначе
					НовСтрДО.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчетуСУчетомПоступленияМЗ(СтрТаблицаДО.СчетРасчетов);
				КонецЕсли;
			Иначе
				НовСтрДО.КЭК   = ?(ЗначениеЗаполнено(КОСГУ), КОСГУ, БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчетуСУчетомПоступленияМЗ(СтрТаблицаДО.СчетРасчетов));
			КонецЕсли;
			НовСтрДО.Сумма = СтрТаблицаДО.СуммаРуб;
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаОбязательств.Свернуть("Контрагент,Договор,Подразделение,КФО,КПС,КЭК", "Сумма");
	
	Возврат ТаблицаОбязательств;

КонецФункции

Функция ДетальныеКЭК340()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОСГУ.Ссылка
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Ссылка В ИЕРАРХИИ (&КЭК340)";
	Запрос.УстановитьПараметр("КЭК340", БухгалтерскийУчетПовтИсп.КЭКПоКоду("340"));
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЕстьРазныеДетальныеКЭК340(Таблица, ДетальныеКЭК)
	Если Таблица = Неопределено ИЛИ Таблица.Колонки.Найти("КЭК") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИспользованныеКЭК = Новый Соответствие;
	Для Каждого Строка Из Таблица Цикл
		Если ДетальныеКЭК.Получить(Строка.КЭК) <> Неопределено Тогда
			ИспользованныеКЭК.Вставить(Строка.КЭК, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат ИспользованныеКЭК.Количество() > 1;
КонецФункции

#КонецОбласти

#Область УчетУслугРабот

// Исходные данные документа.

// Пустая таблица поступление услуг работ по документу.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица поступление услуг работ по документу:
// * ИмяСписка - Строка 
// * СинонимСписка - Строка 
// * НомерСтроки - Строка 
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - 
// * КФО - ПеречислениеСсылка.КВД - 
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов - 
// * Подразделение - СправочникСсылка.Подразделения - 
// * Номенклатура - СправочникСсылка.Номенклатура - 
// * Содержание - Строка - 
// * КЭК - СправочникСсылка.КОСГУ - 
// * ВидЗатрат - СправочникСсылка.ВидыЗатрат - 
// * ПодразделениеЗатрат - СправочникСсылка.Подразделения - 
// * СубконтоЗатрат1 - Характеристика.ВидыСубконто 
// * СубконтоЗатрат2 - Характеристика.ВидыСубконто 
// * СубконтоЗатрат3 - Характеристика.ВидыСубконто
// * СчетРасчетов - ПланСчетовСсылка.ЕПСБУ - 
// * Контрагент - СправочникСсылка.Контрагенты - 
// * Договор - СправочникСсылка.Договоры - 
// * Валюта - СправочникСсылка.Валюты - 
// * Количество - Число 
// * Сумма - Число
// * СтавкаНДС - ПеречислениеСсылка.СтавкиНДС - 
// * СуммаНДС - Число
// * НДСКРаспределению - Булево - 
// * ПринятьНДСКВычету - Булево - 
// * ОтразитьВГрафикеИсполненияДоговора - ПеречислениеСсылка.СтатусыДокументовКонтрольИсполненияДоговоров - 
Функция ПустаяТаблицаПоступлениеУслугРаботПоДокументу() Экспорт
	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТипаСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ТаблицаДокумента = Новый ТаблицаЗначений;
	// Идентификация строки.
	ТаблицаДокумента.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ТаблицаДокумента.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДокумента.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДокумента.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДокумента.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета услуг, работ.
	ТаблицаДокумента.Колонки.Добавить("Номенклатура",        Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДокумента.Колонки.Добавить("Содержание",          Новый ОписаниеТипов("Строка"));
	ТаблицаДокумента.Колонки.Добавить("КЭК",                 Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаДокумента.Колонки.Добавить("ВидЗатрат",           Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ТаблицаДокумента.Колонки.Добавить("ПодразделениеЗатрат", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаДокумента.Колонки.Добавить("СчетЗатрат", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("СубконтоЗатрат1", ОписаниеТипаСубконто);
	ТаблицаДокумента.Колонки.Добавить("СубконтоЗатрат2", ОписаниеТипаСубконто);
	ТаблицаДокумента.Колонки.Добавить("СубконтоЗатрат3", ОписаниеТипаСубконто);
	// Контрагент (поставщик, покупатель).
	ТаблицаДокумента.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДокумента.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаДокумента.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаДокумента.Колонки.Добавить("Комитент",      Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДокумента.Колонки.Добавить("ДоговорКомитента",     Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаДокумента.Колонки.Добавить("КомиссионнаяТорговля", Новый ОписаниеТипов("Булево"));
	// Количество и суммовые показатели поступивших услуг, работ.
	ТаблицаДокумента.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ТаблицаДокумента.Колонки.Добавить("Сумма",         ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ТаблицаДокумента.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ТаблицаДокумента.Колонки.Добавить("СуммаНДС",      ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	ТаблицаДокумента.Колонки.Добавить("СуммаРезерв", ОписаниеТипаСуммы); // Сумма резерва с НДС в валюте документа.
	ТаблицаДокумента.Колонки.Добавить("СуммаНДСРезерв", ОписаниеТипаСуммы); // Сумма резерва НДС в валюте документа.
	// Дополнительные колонки.
	ТаблицаДокумента.Колонки.Добавить("НДСКРаспределению", Новый ОписаниеТипов("Булево"));
	ТаблицаДокумента.Колонки.Добавить("ПринятьНДСКВычету", Новый ОписаниеТипов("Булево"));
	ТаблицаДокумента.Колонки.Добавить("ОтразитьВГрафикеИсполненияДоговора",
		Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыДокументовКонтрольИсполненияДоговоров"));
	Возврат ТаблицаДокумента; 	
КонецФункции

// Подготавливает таблицу документа (в унифицированном формате) для поступления услуг, работ.
//
Функция ПодготовитьТаблицуПоступлениеУслугРаботПоДокументу(Документ, Параметры = Неопределено) Экспорт
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	Если НЕ Параметры.Свойство("ОтразитьВГрафикеИсполненияДоговора") Тогда
		// Если в документе, таб.части и типовой операции нет реквизита ОтразитьВГрафикеИсполненияДоговора,
		// по умолчанию будем отражать в графике исполнения договора.
		Параметры.Вставить("ОтразитьВГрафикеИсполненияДоговора",
			Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас);
	КонецЕсли;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат") Тогда
		Возврат Документы.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.ТаблицаПоступлениеУслугРаботПоДокументу(
			Документ, Параметры);
	КонецЕсли;
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	ТаблицаДокумента = ПустаяТаблицаПоступлениеУслугРаботПоДокументу();
	
	Если МетаданныеДокумента.Имя = "НачислениеАмортизацииПравПользованияОС" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ПраваПользования",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,ПодразделениеРасходов,Контрагент,Договор,Валюта,НДСКРаспределению,
			|ОсновноеСредство,СчетУчета,СчетРасходов,СубконтоРасходов1,СубконтоРасходов2,СубконтоРасходов3,КЭКРасходов,
