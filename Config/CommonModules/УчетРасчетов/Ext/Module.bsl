	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",            Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",            Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",            Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК",            Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("Подразделение",  Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",   Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",     Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",        Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",         Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Суммовые показатели операции.
	ПустаяТаблица.Колонки.Добавить("СуммаРасчетов",  ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",       ОписаниеТипаСуммы);
	// Конвертация валюты
	ПустаяТаблица.Колонки.Добавить("ПроданнаяВалюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ПустаяТаблица.Колонки.Добавить("СуммаПроданнойВалюты", ОписаниеТипаСуммы);
	// Порядок погашения задолженности.
	ПустаяТаблица.Колонки.Добавить("СпособПогашенияЗадолженности", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыПогашенияЗадолженности"));
	ПустаяТаблица.Колонки.Добавить("ДопСубконтоРасчетов",          Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	ПустаяТаблица.Колонки.Добавить("ВидДопСубконтоРасчетов",       Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	// Порядок отражения аванса от покупателя в налоговом учете при УСН.
	ПустаяТаблица.Колонки.Добавить("ОтражениеАвансаУСН", Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокОтраженияАвансовУСН"));
	// Отражение оплаты по графику платежей.
	ПустаяТаблица.Колонки.Добавить("ВестиГрафикПлатежей", Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("ВидРасчетов", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыРасчетовПоЗаймам"));
	ПустаяТаблица.Колонки.Добавить("ОплатитьДо",  Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	// Вспомогательные реквизиты.
	ПустаяТаблица.Колонки.Добавить("ВидДоговора",        Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
	ПустаяТаблица.Колонки.Добавить("ИсточникСредств",    Новый ОписаниеТипов("СправочникСсылка.ИсточникиСредств,СправочникСсылка.РазделыЛицевыхСчетов"));
	ПустаяТаблица.Колонки.Добавить("ДопКлассификация",   Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ПустаяТаблица.Колонки.Добавить("КодМероприятия",     Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ПустаяТаблица.Колонки.Добавить("КодЦели",            Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	ПустаяТаблица.Колонки.Добавить("НазначениеПлатежа",  ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(210));
	
	Возврат ПустаяТаблица;

КонецФункции

// Подготавливает таблицу расшифровки платежа (в унифицированном формате) по документу.
//
Функция ПодготовитьТаблицуРасшифровкаПлатежаПоДокументу(Документ, Реквизиты = Неопределено, Отказ) Экспорт
	
	РасшифровкаПлатежа = ПустаяТаблицаРасшифровкаПлатежаУнифицированная();
	
	Если Реквизиты = Неопределено Тогда
		Реквизиты = Новый Структура;
	КонецЕсли;
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты, "Дата"));
	ИспользуетсяСчетАП = (ПериодОстатков >= ДатаПереходаНаЗабалансовыйСчетАП(Документ.Организация));
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ЭтоКорСчет30401 = Ложь;
	Если Реквизиты.Свойство("СчетРасчетов") И ЗначениеЗаполнено(Реквизиты.СчетРасчетов) Тогда
		ЭтоКорСчет30401 = БухгалтерскийУчет.СчетВИерархии(Реквизиты.СчетРасчетов, "304.01");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	Если МетаданныеДокумента.Имя = "ПриходныйКассовыйОрдер"
	 ИЛИ МетаданныеДокумента.Имя = "РасходныйКассовыйОрдер" Тогда
		
		// ПодразделениеКор
		СвойстваКорСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Документ.КорСчет);
		Если ИспользоватьУчетПоПодразделениям
			И СвойстваКорСчета.УчетПоПодразделениям И НЕ СвойстваКорСчета.РазрешитьНеУказыватьПодразделение
			И НЕ ЗначениеЗаполнено(Документ.ПодразделениеКор) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'Подразделение (кор.)'"));
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.ПодразделениеКор", Отказ);
		КонецЕсли;
		
		// Контрагент
		Если НЕ ЗначениеЗаполнено(Документ.Контрагент) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'Контрагент'"));
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.Контрагент", Отказ);
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат РасшифровкаПлатежа;
		КонецЕсли;
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "РасшифровкаПлатежа",
			"НомерСтроки,ИФО,КФО,КПС,КЭК,ПодразделениеКор,КорСчет,Контрагент,Договор,ВалютаДокумента,
			|СчетРасчетов,СпособПогашенияЗадолженности,ДопСубконтоРасчетов,ВидРасчетов,ОплатитьДо,
			|ДопКлассификация,КодМероприятия,КодЦели,Сумма",
			Документ, Реквизиты);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""РасшифровкаПлатежа"" КАК ИмяСписка,
		|	""Расшифровка платежа"" КАК СинонимСписка,
		|	РасшифровкаПлатежа.НомерСтроки КАК НомерСтроки,
		|	&ЭтоПоступлениеДенежныхСредств КАК ЭтоПоступление,
		|	РасшифровкаПлатежа.ИФО КАК ИФО,
		|	РасшифровкаПлатежа.ПодразделениеКор КАК Подразделение,
		|	РасшифровкаПлатежа.КФО КАК КФО,
		|	РасшифровкаПлатежа.КПС КАК КПС,
		|	РасшифровкаПлатежа.КЭК КАК КЭК,
		|	РасшифровкаПлатежа.КорСчет КАК КорСчет,
		|	РасшифровкаПлатежа.Контрагент КАК Контрагент,
		|	РасшифровкаПлатежа.Договор КАК Договор,
		|	РасшифровкаПлатежа.Договор.ВидДоговора КАК ВидДоговора,
		|	РасшифровкаПлатежа.Договор.ВестиГрафикПлатежей КАК ВестиГрафикПлатежей,
		|	РасшифровкаПлатежа.ВалютаДокумента КАК Валюта,
		|	РасшифровкаПлатежа.СчетРасчетов КАК СчетРасчетов,
		|	РасшифровкаПлатежа.СпособПогашенияЗадолженности КАК СпособПогашенияЗадолженности,
		|	РасшифровкаПлатежа.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
		|	РасшифровкаПлатежа.ВидРасчетов КАК ВидРасчетов,
		|	РасшифровкаПлатежа.ОплатитьДо КАК ОплатитьДо,
		|	РасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
		|	РасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
		|	РасшифровкаПлатежа.КодЦели КАК КодЦели,
		|	РасшифровкаПлатежа.Сумма КАК СуммаРасчетов,
		|	&ОтражениеАвансаУСН КАК ОтражениеАвансаУСН
		|ИЗ
		|	ТаблицаРасшифровкаПлатежа КАК РасшифровкаПлатежа
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		ЭтоПоступлениеДенежныхСредств = (МетаданныеДокумента.Имя = "ПриходныйКассовыйОрдер");
		Запрос.УстановитьПараметр("ЭтоПоступлениеДенежныхСредств", ЭтоПоступлениеДенежныхСредств);
		Запрос.УстановитьПараметр("ОтражениеАвансаУСН",
			?(Реквизиты.Свойство("ОтражениеАвансаУСН"), Реквизиты.ОтражениеАвансаУСН,
				Перечисления.ПорядокОтраженияАвансовУСН.ПустаяСсылка()));
		
		ДвижениеДенежныхСредств = Запрос.Выполнить().Выгрузить();
		Для Каждого Строка Из ДвижениеДенежныхСредств Цикл
			
			Если НЕ ЗначениеЗаполнено(Строка.КФО) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'КФО'"),
					Строка.НомерСтроки, "Расшифровка платежа");
				ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].КФО";
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Строка.КПС) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'КПС'"),
					Строка.НомерСтроки, "Расшифровка платежа");
				ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].КПС";
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Строка.КЭК)
				И НЕ ЭтоКорСчет30401 Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'КЭК'"),
					Строка.НомерСтроки, "Расшифровка платежа");
				ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].КЭК";
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
			КонецЕсли;
			
			Если Отказ Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = РасшифровкаПлатежа.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
			// Устарело. Для поддержки случая, когда в качестве кор.счета в ПКО выбран 205.хА.
			НоваяСтрока.ЭтоАвансовыйПлатеж = МетаданныеДокумента.Имя = "ПриходныйКассовыйОрдер"
				И БухгалтерскийУчет.СчетВИерархии(Строка.КорСчет, "205.2А,205.3А,205.7А,205.8А,209.7А,209.8А");
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.СчетРасчетов) Тогда
				// Автоматическое определение счета при проведении работает только если в расшифровке платежа СчетРасчетов не заполнен.
				СвойстваКорСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Строка.КорСчет);
				Если СвойстваКорСчета.ЭлементГруппа Тогда
					НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
						Строка.КЭК, Строка.КорСчет,, ПериодОстатков, Документ.Организация, Строка.ИФО);
				Иначе
					НоваяСтрока.СчетРасчетов = Строка.КорСчет;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НоваяСтрока.СчетРасчетов) Тогда
				
				Если ЗаполнениеДоговораОбязательно(НоваяСтрока.СчетРасчетов) Тогда
					
					Если НЕ ЗначениеЗаполнено(Документ.Договор) Тогда
						ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
							"Поле", "Заполнение", НСтр("ru = 'Договор'"));
						БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.Договор", Отказ);
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				ТекстСообщения = НСтр("ru='Невозможно определить счет расчетов с контрагентом по КОСГУ ""%1"".
					|Проверьте настройки соответствия аналитических счетов КОСГУ.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Строка.КЭК);
				ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].КОСГУНазначениеПлатежа";
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
			КонецЕсли;
			
			КурсДокумента = ?(Реквизиты.Кратность = 0, Реквизиты.Курс, Реквизиты.Курс / Реквизиты.Кратность);
			НоваяСтрока.СуммаРуб = Окр(НоваяСтрока.СуммаРасчетов * КурсДокумента, 2);
			
		КонецЦикла;
		
	ИначеЕсли МетаданныеДокумента.Имя = "КассовоеПоступление"
		  ИЛИ МетаданныеДокумента.Имя = "ПоступлениеНаСчет"
		  ИЛИ МетаданныеДокумента.Имя = "КассовоеВыбытие"
		  ИЛИ МетаданныеДокумента.Имя = "ЗаявкаНаКассовыйРасход"
		  ИЛИ МетаданныеДокумента.Имя = "ПлатежноеПоручение" 
		  ИЛИ МетаданныеДокумента.Имя = "РСКППеречисление" 
		  ИЛИ МетаданныеДокумента.Имя = "РСКПВозврат" Тогда
		
		// Проверим обязательные реквизиты шапки.
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Контрагент", МетаданныеДокумента)
		   И НЕ ЗначениеЗаполнено(Документ.Контрагент) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'Контрагент'"));
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.Контрагент", Отказ);
		КонецЕсли;
		Если Отказ Тогда
			Возврат РасшифровкаПлатежа;
		КонецЕсли;
		
		Если МетаданныеДокумента.Имя = "ПлатежноеПоручение" Тогда
		
			// В этих документах расчеты только в рублях, даже если документ оформлен в валюте.
			ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "РасшифровкаПлатежа",
				"НомерСтроки,ИФО,КФО,КБКНазначениеПлатежа,КОСГУНазначениеПлатежа,Подразделение,
				|Контрагент,Договор,ИсточникСредств,ДопКлассификация,КодМероприятия,КодЦели,
				|СчетРасчетов,СпособПогашенияЗадолженности,ДопСубконтоРасчетов,ВидРасчетов,ОплатитьДо,
				|НазначениеПлатежа,СтрокаНазначениеПлатежа,Сумма",
				Документ, Реквизиты);
			
			Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ
			|	""РасшифровкаПлатежа"" КАК ИмяСписка,
			|	""Расшифровка платежа"" КАК СинонимСписка,
			|	РасшифровкаПлатежа.НомерСтроки КАК НомерСтроки,
			|	ЛОЖЬ КАК ЭтоПоступление,
			|	РасшифровкаПлатежа.ИФО КАК ИФО,
			|	РасшифровкаПлатежа.Подразделение КАК Подразделение,
			|	РасшифровкаПлатежа.КФО КАК КФО,
			|	РасшифровкаПлатежа.КБКНазначениеПлатежа КАК КПС,
			|	РасшифровкаПлатежа.КОСГУНазначениеПлатежа КАК КЭК,
			|	РасшифровкаПлатежа.Контрагент КАК Контрагент,
			|	РасшифровкаПлатежа.Договор КАК Договор,
			|	РасшифровкаПлатежа.Договор.ВидДоговора КАК ВидДоговора,
			|	РасшифровкаПлатежа.Договор.ВестиГрафикПлатежей КАК ВестиГрафикПлатежей,
			|	&ВалютаРеглУчета КАК Валюта,
			|	РасшифровкаПлатежа.СчетРасчетов КАК СчетРасчетов,
			|	РасшифровкаПлатежа.СпособПогашенияЗадолженности КАК СпособПогашенияЗадолженности,
			|	РасшифровкаПлатежа.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
			|	РасшифровкаПлатежа.ВидРасчетов КАК ВидРасчетов,
			|	РасшифровкаПлатежа.ОплатитьДо КАК ОплатитьДо,
			|	РасшифровкаПлатежа.ИсточникСредств КАК ИсточникСредств,
			|	РасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
			|	РасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
			|	РасшифровкаПлатежа.КодЦели КАК КодЦели,
			|	РасшифровкаПлатежа.НазначениеПлатежа КАК НазначениеПлатежа,
			|	РасшифровкаПлатежа.СтрокаНазначениеПлатежа КАК СтрокаНазначениеПлатежа,
			|	РасшифровкаПлатежа.Сумма КАК СуммаРасчетов,
			|	РасшифровкаПлатежа.Сумма КАК СуммаРуб,
			|	&ОтражениеАвансаУСН КАК ОтражениеАвансаУСН
			|ИЗ
			|	ТаблицаРасшифровкаПлатежа КАК РасшифровкаПлатежа
			|
			|УПОРЯДОЧИТЬ ПО
			|	НомерСтроки";
			Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()); 
			
