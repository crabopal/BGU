	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Учет НДС.
	ПустаяТаблица.Колонки.Добавить("СчетНДС",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СтавкаНДС",   Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ПустаяТаблица.Колонки.Добавить("СуммаНДС",    ОписаниеТипаСуммы); // Сумма НДС в валюте.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСВал", ОписаниеТипаСуммы); // Сумма НДС в валюте.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб", ОписаниеТипаСуммы); // Сумма НДС в рублях.
	
	// Суммы таможенных платежей.
	ПустаяТаблица.Колонки.Добавить("Сумма",       ОписаниеТипаСуммы); // Сумма с НДС в валюте.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",    ОписаниеТипаСуммы); // Сумма с НДС в валюте.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",    ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ВидТаможенныхПлатежей", Новый ОписаниеТипов("Строка"));
	ПустаяТаблица.Колонки.Добавить("Содержание",            Новый ОписаниеТипов("Строка"));
	
	Возврат ПустаяТаблица;

КонецФункции

// Структура таблицы источника данных "Таможенные штрафы".
//
Функция ПустаяТаблицаТаможенныеШтрафы() Экспорт

	ОписаниеТиповСубконто  = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Расчеты с таможней.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Сумма штрафов.
	ПустаяТаблица.Колонки.Добавить("Сумма",         ОписаниеТипаСуммы); // Сумма с НДС в валюте.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",      ОписаниеТипаСуммы); // Сумма с НДС в валюте.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",      ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("Содержание",    Новый ОписаниеТипов("Строка"));
	
	Возврат ПустаяТаблица;

КонецФункции

// Подготавливает таблицу таможенных платежей (сборы, пошлины, НДС), связанных с приобретением материальных запасов,
// по документу "Таможенная декларация по импорту" (ГТДИмпорт).
//
Функция ПодготовитьТаблицуТаможенныеПлатежиПоМатериальнымЗапасамПоДокументу(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ТаблицаДокумента = УчетРасчетов.ПустаяТаблицаТаможенныеПлатежиПоМатериальнымЗапасам();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Если Документ.УчитыватьНДС Тогда
		
		Если НЕ ЗначениеЗаполнено(Документ.СчетРасчетовНДС) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'Счет расчетов по НДС'"));
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.СчетРасчетовНДС", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Документ.КПССчетРасчетовНДС) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'КПС счета расчетов по НДС'"));
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.КПССчетРасчетовНДС", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	НомераТаблиц = Новый Структура;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Разделы",
		"НомерСтроки,СтавкаНДС,НДСВВалюте,ПошлинаВВалюте",
		Документ, Параметры, "НомерСтроки");
	НомераТаблиц.Вставить("ТаблицаРазделы", НомераТаблиц.Количество());
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
		"ИФО,КФО,КПС,Подразделение,Контрагент,Договор,ВалютаДокумента,НомерРаздела,
		|НомерСтроки,СчетВложений,НФА,ДокументПартии,ВидЗатрат,ФактурнаяСтоимость,
		|УчитыватьНДС,СчетРасчетовНДС,КПССчетРасчетовНДС,СчетНДС,СуммаНДС,
		|СчетРасчетов,СуммаПошлины",
		Документ, Параметры, "НомерРаздела");
	НомераТаблиц.Вставить("ТаблицаМатериалы", НомераТаблиц.Количество());
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Материалы"" КАК ИмяСписка,
	|	""Материалы"" КАК СинонимСписка,
	|	Материалы.НомерСтроки КАК НомерСтроки,
	|	Материалы.ИФО КАК ИФО,
	|	Материалы.КФО КАК КФО,
	|	Материалы.КПС КАК КПС,
	|	Материалы.Подразделение КАК Подразделение,
	|	Материалы.СчетРасчетов КАК СчетРасчетов,
	|	Материалы.Контрагент КАК Контрагент,
	|	Материалы.Договор КАК Договор,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Разделы.ПошлинаВВалюте, ЛОЖЬ)
	|			ТОГДА Материалы.ВалютаДокумента
	|		ИНАЧЕ &ВалютаРеглУчета
	|	КОНЕЦ КАК Валюта,
	|	Материалы.СчетВложений КАК СчетВложений,
	|	Материалы.КПС КАК КПСВложений,
	|	Материалы.Подразделение КАК ПодразделениеВложений,
	|	Материалы.НФА КАК НоменклатураВложений,
	|	Материалы.ДокументПартии КАК ПартияВложений,
	|	Материалы.ВидЗатрат КАК ВидЗатратВложений,
	|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетНДС,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	|	0 КАК СуммаНДС,
	|	0 КАК СуммаНДСРуб,
	|	Материалы.СуммаПошлины КАК Сумма,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Разделы.ПошлинаВВалюте, ЛОЖЬ)
	|			ТОГДА Материалы.СуммаПошлины * &КурсДокумента
	|		ИНАЧЕ Материалы.СуммаПошлины
	|	КОНЕЦ КАК СуммаРуб,
	|	""Пошлина"" КАК ВидТаможенныхПлатежей
	|ИЗ
	|	ТаблицаМатериалы КАК Материалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаРазделы КАК Разделы
	|		ПО Материалы.НомерРаздела = Разделы.НомерСтроки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Материалы"",
	|	""Материалы"",
	|	Материалы.НомерСтроки,
	|	Материалы.ИФО,
	|	Материалы.КФО,
	|	Материалы.КПССчетРасчетовНДС,
	|	Материалы.Подразделение,
	|	Материалы.СчетРасчетовНДС,
	|	Материалы.Контрагент,
	|	Материалы.Договор,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Разделы.НДСВВалюте, ЛОЖЬ)
	|			ТОГДА Материалы.ВалютаДокумента
	|		ИНАЧЕ &ВалютаРеглУчета
	|	КОНЕЦ,
	|	Материалы.СчетВложений,
	|	Материалы.КПС,
	|	Материалы.Подразделение,
	|	Материалы.НФА,
	|	Материалы.ДокументПартии,
	|	Материалы.ВидЗатрат,
	|	Материалы.СчетНДС,
	|	ЕСТЬNULL(Разделы.СтавкаНДС, ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)),
	|	Материалы.СуммаНДС,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Разделы.НДСВВалюте, ЛОЖЬ)
	|			ТОГДА Материалы.СуммаНДС * &КурсДокумента
	|		ИНАЧЕ Материалы.СуммаНДС
	|	КОНЕЦ,
	|	Материалы.СуммаНДС,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Разделы.НДСВВалюте, ЛОЖЬ)
	|			ТОГДА Материалы.СуммаНДС * &КурсДокумента
	|		ИНАЧЕ Материалы.СуммаНДС
	|	КОНЕЦ,
	|	""НДС""
	|ИЗ
	|	ТаблицаМатериалы КАК Материалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаРазделы КАК Разделы
	|		ПО Материалы.НомерРаздела = Разделы.НомерСтроки";
	//|ГДЕ
	//|	Материалы.УчитыватьНДС";
	НомераТаблиц.Вставить("ТаможенныеПошлиныИНДС", НомераТаблиц.Количество());
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	""Материалы"" КАК ИмяСписка,
	|	""Материалы"" КАК СинонимСписка,
	|	Материалы.НомерСтроки КАК НомерСтроки,
	|	Материалы.ИФО КАК ИФО,
	|	Материалы.КФО КАК КФО,
	|	Материалы.КПС КАК КПС,
	|	Материалы.Подразделение КАК Подразделение,
	|	Материалы.СчетРасчетов КАК СчетРасчетов,
	|	Материалы.Контрагент КАК Контрагент,
	|	Материалы.Договор КАК Договор,
	|	Материалы.СчетВложений КАК СчетВложений,
	|	Материалы.КПС КАК КПСВложений,
	|	Материалы.Подразделение КАК ПодразделениеВложений,
	|	Материалы.НФА КАК НоменклатураВложений,
	|	Материалы.ДокументПартии КАК ПартияВложений,
	|	Материалы.ВидЗатрат КАК ВидЗатратВложений,
	|	Материалы.ФактурнаяСтоимость КАК ФактурнаяСтоимость,
	|	0 КАК ТаможенныйСбор,
	|	0 КАК ТаможенныйСборВал,
	|	""Сбор"" КАК ВидТаможенныхПлатежей
	|ИЗ
	|	ТаблицаМатериалы КАК Материалы";
	НомераТаблиц.Вставить("ТаможенныеСборы", НомераТаблиц.Количество());
	
	ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	КурсДокумента = Документ.Курс / ?(Документ.Кратность = 0, 1, Документ.Кратность);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
	Запрос.УстановитьПараметр("КурсДокумента",   КурсДокумента);
	
	Результат = Запрос.ВыполнитьПакет();
	
	// Добавляем таможенные пошлины и НДС.
	ТаможенныеПошлиныИНДС = Результат[НомераТаблиц.ТаможенныеПошлиныИНДС].Выгрузить();
	Для Каждого Строка Из ТаможенныеПошлиныИНДС Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Строка.ВидТаможенныхПлатежей = "Пошлина" Тогда
			
			НоваяСтрока.Содержание = НСтр("ru='Таможенная пошлина'");
			
		ИначеЕсли Строка.ВидТаможенныхПлатежей = "НДС" Тогда
			
			НоваяСтрока.Содержание = НСтр("ru='НДС, уплаченный таможенным органам'");
			
			Если НЕ ЗначениеЗаполнено(Строка.СчетНДС) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Счет НДС'"),
					Строка.НомерСтроки, Строка.СинонимСписка);
				ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].СчетНДС";
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Таможенный сбор (в рублях и в валюте) распределим по строкам таблиц "Материалы" и "Основные средства"
	// пропорционально фактурной стоимости.
	ТаможенныеСборы = Результат[НомераТаблиц.ТаможенныеСборы].Выгрузить();
	
	БазаРаспределения = Новый Массив;
	БазаРаспределения.Добавить(Документ.Материалы.Итог("ФактурнаяСтоимость"));
	БазаРаспределения.Добавить(Документ.ОсновныеСредства.Итог("ФактурнаяСтоимость"));
	
	Если Документ.ТаможенныйСбор > 0 Тогда
		
		РаспределениеТаможенныйСбор = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			Документ.ТаможенныйСбор, БазаРаспределения); // Распределяем между материалами и основными средствами.
		
		Если РаспределениеТаможенныйСбор <> Неопределено Тогда
			ТаможенныйСборПоМатериалам = РаспределениеТаможенныйСбор[0];
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ТаможенныйСборПоМатериалам,
				ТаможенныеСборы, "ТаможенныйСбор", "ФактурнаяСтоимость"); // Распределяем по фактурной стоимости.
		Иначе
			ТекстСообщения = НСтр("ru='Невозможно распределить таможенный сбор по объектам приобретенных активов.
				|Не указана фактурная стоимость приобретенных материалов, основных средств.'");
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.ТаможенныйСбор", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Документ.ТаможенныйСборВал > 0 Тогда
		
		РаспределениеТаможенныйСборВал = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			Документ.ТаможенныйСборВал, БазаРаспределения); // Распределяем между материалами и основными средствами.
		
		Если РаспределениеТаможенныйСборВал <> Неопределено Тогда
			ТаможенныйСборВалПоМатериалам = РаспределениеТаможенныйСборВал[0];
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ТаможенныйСборВалПоМатериалам,
				ТаможенныеСборы, "ТаможенныйСборВал", "ФактурнаяСтоимость"); // Распределяем по фактурной стоимости.
		Иначе
			ТекстСообщения = НСтр("ru='Невозможно распределить таможенный сбор (в валюте) по объектам приобретенных активов.
				|Не указана фактурная стоимость приобретенных материалов, основных средств.'");
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.ТаможенныйСборВал", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	// Добавляем таможенный сбор.
	Для Каждого Строка Из ТаможенныеСборы Цикл
		
		Если Строка.ТаможенныйСбор > 0 Тогда
			
			НоваяСтрока = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
			НоваяСтрока.Валюта   = ВалютаРегламентированногоУчета;
			НоваяСтрока.Сумма    = Строка.ТаможенныйСбор;
			НоваяСтрока.СуммаВал = Строка.ТаможенныйСбор;
			НоваяСтрока.СуммаРуб = Строка.ТаможенныйСбор;
			
			НоваяСтрока.Содержание = НСтр("ru='Таможенный сбор'");
			
		КонецЕсли;
		
		Если Строка.ТаможенныйСборВал > 0 Тогда
			
			НоваяСтрока = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
			НоваяСтрока.Валюта   = Документ.ВалютаДокумента;
			НоваяСтрока.Сумма    = Строка.ТаможенныйСборВал;
			НоваяСтрока.СуммаВал = Строка.ТаможенныйСборВал;
			НоваяСтрока.СуммаРуб = Строка.ТаможенныйСборВал * КурсДокумента;
			
			НоваяСтрока.Содержание = НСтр("ru='Таможенный сбор (в валюте)'");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Подготавливает таблицу таможенных платежей (сборы, пошлины, НДС), связанных с приобретением внеоборотных активов,
// по документу "Таможенная декларация по импорту" (ГТДИмпорт).
//
Функция ПодготовитьТаблицуТаможенныеПлатежиПоВнеоборотнымАктивамПоДокументу(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ТаблицаДокумента = УчетРасчетов.ПустаяТаблицаТаможенныеПлатежиПоВнеоборотнымАктивам();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Если Документ.УчитыватьНДС Тогда
		
		Если НЕ ЗначениеЗаполнено(Документ.СчетРасчетовНДС) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'Счет расчетов по НДС'"));
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.СчетРасчетовНДС", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Документ.КПССчетРасчетовНДС) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'КПС счета расчетов по НДС'"));
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.КПССчетРасчетовНДС", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	НомераТаблиц = Новый Структура;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Разделы",
		"НомерСтроки,СтавкаНДС,НДСВВалюте,ПошлинаВВалюте",
		Документ, Параметры, "НомерСтроки");
	НомераТаблиц.Вставить("ТаблицаРазделы", НомераТаблиц.Количество());
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ОсновныеСредства",
		"ИФО,КФО,КПС,Подразделение,Контрагент,Договор,ВалютаДокумента,НомерРаздела,
		|НомерСтроки,СчетВложений,НФА,ДокументПартии,ВидЗатрат,ФактурнаяСтоимость,
		|УчитыватьНДС,СчетРасчетовНДС,КПССчетРасчетовНДС,СчетНДС,СуммаНДС,
		|СчетРасчетов,СуммаПошлины",
		Документ, Параметры, "НомерРаздела");
	НомераТаблиц.Вставить("ТаблицаМатериалы", НомераТаблиц.Количество());
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""ОсновныеСредства"" КАК ИмяСписка,
	|	""Основные средства"" КАК СинонимСписка,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ИФО КАК ИФО,
	|	ОсновныеСредства.КФО КАК КФО,
	|	ОсновныеСредства.КПС КАК КПС,
	|	ОсновныеСредства.Подразделение КАК Подразделение,
	|	ОсновныеСредства.СчетРасчетов КАК СчетРасчетов,
	|	ОсновныеСредства.Контрагент КАК Контрагент,
	|	ОсновныеСредства.Договор КАК Договор,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Разделы.ПошлинаВВалюте, ЛОЖЬ)
	|			ТОГДА ОсновныеСредства.ВалютаДокумента
	|		ИНАЧЕ &ВалютаРеглУчета
	|	КОНЕЦ КАК Валюта,
	|	ОсновныеСредства.СчетВложений КАК СчетВложений,
	|	ОсновныеСредства.КПС КАК КПСВложений,
	|	ОсновныеСредства.Подразделение КАК ПодразделениеВложений,
	|	ОсновныеСредства.НФА КАК ВнеоборотныйАктив,
	|	ОсновныеСредства.ДокументПартии КАК ДокументПартии,
	|	ОсновныеСредства.ВидЗатрат КАК ВидЗатрат,
	|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетНДС,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	|	0 КАК СуммаНДС,
	|	0 КАК СуммаНДСРуб,
	|	ОсновныеСредства.СуммаПошлины КАК Сумма,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Разделы.ПошлинаВВалюте, ЛОЖЬ)
	|			ТОГДА ОсновныеСредства.СуммаПошлины * &КурсДокумента
	|		ИНАЧЕ ОсновныеСредства.СуммаПошлины
	|	КОНЕЦ КАК СуммаРуб,
	|	""Пошлина"" КАК ВидТаможенныхПлатежей
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаРазделы КАК Разделы
	|		ПО ОсновныеСредства.НомерРаздела = Разделы.НомерСтроки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""ОсновныеСредства"",
	|	""Основные средства"",
	|	ОсновныеСредства.НомерСтроки,
	|	ОсновныеСредства.ИФО,
	|	ОсновныеСредства.КФО,
	|	ОсновныеСредства.КПССчетРасчетовНДС,
	|	ОсновныеСредства.Подразделение,
	|	ОсновныеСредства.СчетРасчетовНДС,
	|	ОсновныеСредства.Контрагент,
	|	ОсновныеСредства.Договор,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Разделы.НДСВВалюте, ЛОЖЬ)
	|			ТОГДА ОсновныеСредства.ВалютаДокумента
	|		ИНАЧЕ &ВалютаРеглУчета
	|	КОНЕЦ,
	|	ОсновныеСредства.СчетВложений,
	|	ОсновныеСредства.КПС,
	|	ОсновныеСредства.Подразделение,
	|	ОсновныеСредства.НФА,
	|	ОсновныеСредства.ДокументПартии,
	|	ОсновныеСредства.ВидЗатрат,
	|	ОсновныеСредства.СчетНДС,
	|	ЕСТЬNULL(Разделы.СтавкаНДС, ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)),
	|	ОсновныеСредства.СуммаНДС,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Разделы.НДСВВалюте, ЛОЖЬ)
	|			ТОГДА ОсновныеСредства.СуммаНДС * &КурсДокумента
	|		ИНАЧЕ ОсновныеСредства.СуммаНДС
	|	КОНЕЦ,
	|	ОсновныеСредства.СуммаНДС,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Разделы.НДСВВалюте, ЛОЖЬ)
	|			ТОГДА ОсновныеСредства.СуммаНДС * &КурсДокумента
	|		ИНАЧЕ ОсновныеСредства.СуммаНДС
	|	КОНЕЦ,
	|	""НДС""
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаРазделы КАК Разделы
	|		ПО ОсновныеСредства.НомерРаздела = Разделы.НомерСтроки";
	//|ГДЕ
	//|	ОсновныеСредства.УчитыватьНДС";
	НомераТаблиц.Вставить("ТаможенныеПошлиныИНДС", НомераТаблиц.Количество());
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	""ОсновныеСредства"" КАК ИмяСписка,
	|	""Основные средства"" КАК СинонимСписка,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ИФО КАК ИФО,
	|	ОсновныеСредства.КФО КАК КФО,
	|	ОсновныеСредства.КПС КАК КПС,
	|	ОсновныеСредства.Подразделение КАК Подразделение,
	|	ОсновныеСредства.СчетРасчетов КАК СчетРасчетов,
	|	ОсновныеСредства.Контрагент КАК Контрагент,
	|	ОсновныеСредства.Договор КАК Договор,
	|	ОсновныеСредства.СчетВложений КАК СчетВложений,
	|	ОсновныеСредства.КПС КАК КПСВложений,
	|	ОсновныеСредства.Подразделение КАК ПодразделениеВложений,
	|	ОсновныеСредства.НФА КАК ВнеоборотныйАктив,
	|	ОсновныеСредства.ДокументПартии КАК ДокументПартии,
	|	ОсновныеСредства.ВидЗатрат КАК ВидЗатрат,
	|	ОсновныеСредства.ФактурнаяСтоимость КАК ФактурнаяСтоимость,
	|	0 КАК ТаможенныйСбор,
	|	0 КАК ТаможенныйСборВал,
	|	""Сбор"" КАК ВидТаможенныхПлатежей
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ОсновныеСредства";
	НомераТаблиц.Вставить("ТаможенныеСборы", НомераТаблиц.Количество());
	
	ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	КурсДокумента = Документ.Курс / ?(Документ.Кратность = 0, 1, Документ.Кратность);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
	Запрос.УстановитьПараметр("КурсДокумента",   КурсДокумента);
	
	Результат = Запрос.ВыполнитьПакет();
	
	// Добавляем таможенные пошлины и НДС.
	ТаможенныеПошлиныИНДС = Результат[НомераТаблиц.ТаможенныеПошлиныИНДС].Выгрузить();
	Для Каждого Строка Из ТаможенныеПошлиныИНДС Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Строка.ВидТаможенныхПлатежей = "Пошлина" Тогда
			
			НоваяСтрока.Содержание = НСтр("ru='Таможенная пошлина'");
			
		ИначеЕсли Строка.ВидТаможенныхПлатежей = "НДС" Тогда
			
			НоваяСтрока.Содержание = НСтр("ru='НДС, уплаченный таможенным органам'");
			
			Если НЕ ЗначениеЗаполнено(Строка.СчетНДС) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Счет НДС'"),
					Строка.НомерСтроки, Строка.СинонимСписка);
				ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].СчетНДС";
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Таможенный сбор (в рублях и в валюте) распределим по строкам таблиц "Материалы" и "Основные средства"
	// пропорционально фактурной стоимости.
	ТаможенныеСборы = Результат[НомераТаблиц.ТаможенныеСборы].Выгрузить();
	
	БазаРаспределения = Новый Массив;
	БазаРаспределения.Добавить(Документ.ОсновныеСредства.Итог("ФактурнаяСтоимость"));
	БазаРаспределения.Добавить(Документ.Материалы.Итог("ФактурнаяСтоимость"));
	
	Если Документ.ТаможенныйСбор > 0 Тогда
		
		РаспределениеТаможенныйСбор = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			Документ.ТаможенныйСбор, БазаРаспределения); // Распределяем между материалами и основными средствами.
		
		Если РаспределениеТаможенныйСбор <> Неопределено Тогда
			ТаможенныйСборПоОсновнымСредствам = РаспределениеТаможенныйСбор[0];
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ТаможенныйСборПоОсновнымСредствам,
				ТаможенныеСборы, "ТаможенныйСбор", "ФактурнаяСтоимость"); // Распределяем по фактурной стоимости.
		Иначе
			ТекстСообщения = НСтр("ru='Невозможно распределить таможенный сбор по объектам приобретенных активов.
				|Не указана фактурная стоимость приобретенных материалов, основных средств.'");
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.ТаможенныйСбор", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Документ.ТаможенныйСборВал > 0 Тогда
		
		РаспределениеТаможенныйСборВал = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			Документ.ТаможенныйСборВал, БазаРаспределения); // Распределяем между материалами и основными средствами.
		
		Если РаспределениеТаможенныйСборВал <> Неопределено Тогда
			ТаможенныйСборВалПоОсновнымСредствам = РаспределениеТаможенныйСборВал[0];
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ТаможенныйСборВалПоОсновнымСредствам,
				ТаможенныеСборы, "ТаможенныйСборВал", "ФактурнаяСтоимость"); // Распределяем по фактурной стоимости.
		Иначе
			ТекстСообщения = НСтр("ru='Невозможно распределить таможенный сбор (в валюте) по объектам приобретенных активов.
				|Не указана фактурная стоимость приобретенных материалов, основных средств.'");
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "Объект.ТаможенныйСборВал", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	// Добавляем таможенный сбор.
	Для Каждого Строка Из ТаможенныеСборы Цикл
		
		Если Строка.ТаможенныйСбор > 0 Тогда
			
			НоваяСтрока = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
			НоваяСтрока.Валюта   = ВалютаРегламентированногоУчета;
			НоваяСтрока.Сумма    = Строка.ТаможенныйСбор;
			НоваяСтрока.СуммаВал = Строка.ТаможенныйСбор;
			НоваяСтрока.СуммаРуб = Строка.ТаможенныйСбор;
			
			НоваяСтрока.Содержание = НСтр("ru='Таможенный сбор'");
			
		КонецЕсли;
		
		Если Строка.ТаможенныйСборВал > 0 Тогда
			
			НоваяСтрока = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
			НоваяСтрока.Валюта   = Документ.ВалютаДокумента;
			НоваяСтрока.Сумма    = Строка.ТаможенныйСборВал;
			НоваяСтрока.СуммаВал = Строка.ТаможенныйСборВал;
			НоваяСтрока.СуммаРуб = Строка.ТаможенныйСборВал * КурсДокумента;
			
			НоваяСтрока.Содержание = НСтр("ru='Таможенный сбор (в валюте)'");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Подготавливает таблицу таможенных штрафов, включаемых в расходы организации,
// по документу "Таможенная декларация по импорту" (ГТДИмпорт).
//
Функция ПодготовитьТаблицуТаможенныеШтрафыПоДокументу(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ТаблицаДокумента = УчетРасчетов.ПустаяТаблицаТаможенныеШтрафы();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Документ",
		"ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ВалютаДокумента,
		|ТаможенныйШтраф,ТаможенныйШтрафВал",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	ШтрафыРуб.ИФО КАК ИФО,
	|	ШтрафыРуб.КФО КАК КФО,
	|	ШтрафыРуб.КПС КАК КПС,
	|	ШтрафыРуб.Подразделение КАК Подразделение,
	|	ШтрафыРуб.СчетРасчетов КАК СчетРасчетов,
	|	ШтрафыРуб.Контрагент КАК Контрагент,
	|	ШтрафыРуб.Договор КАК Договор,
	|	&ВалютаРеглУчета КАК Валюта,
	|	ШтрафыРуб.ТаможенныйШтраф КАК Сумма,
	|	ШтрафыРуб.ТаможенныйШтраф КАК СуммаРуб
	|ИЗ
	|	Документ КАК ШтрафыРуб
	|ГДЕ
	|	ШтрафыРуб.ТаможенныйШтраф <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ШтрафыВал.ИФО,
	|	ШтрафыВал.КФО,
	|	ШтрафыВал.КПС,
	|	ШтрафыВал.Подразделение,
	|	ШтрафыВал.СчетРасчетов,
	|	ШтрафыВал.Контрагент,
	|	ШтрафыВал.Договор,
	|	ШтрафыВал.ВалютаДокумента,
	|	ШтрафыВал.ТаможенныйШтрафВал,
	|	ШтрафыВал.ТаможенныйШтрафВал * &КурсДокумента
	|ИЗ
	|	Документ КАК ШтрафыВал
	|ГДЕ
	|	ШтрафыВал.ТаможенныйШтрафВал <> 0";
	
	ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	КурсДокумента = Документ.Курс / ?(Документ.Кратность = 0, 1, Документ.Кратность);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
	Запрос.УстановитьПараметр("КурсДокумента",   КурсДокумента);
	
	ТаможенныеШтрафы = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из ТаможенныеШтрафы Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если НоваяСтрока.Валюта = ВалютаРегламентированногоУчета Тогда
			НоваяСтрока.Содержание = НСтр("ru='Таможенный штраф'");
		Иначе
			НоваяСтрока.Содержание = НСтр("ru='Таможенный штраф (в валюте)'");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Подготавливает таблицу таможенных платежей для использования в качестве источника данных.
//
Функция ПодготовитьТаблицуТаможенныхПлатежей(ТаблицаТаможенныеПлатежи, ТаблицаРасчетовСЗачетомАвансов=Неопределено, Реквизиты, Отказ) Экспорт
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	Если ТаблицаРасчетовСЗачетомАвансов <> Неопределено Тогда
		УчетРасчетов.СкорректироватьСуммыРубПоКурсуАвансов(
			ТаблицаТаможенныеПлатежи, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	КонецЕсли;
	
	ЕстьНДСВТаблице = (ТаблицаТаможенныеПлатежи.Колонки.Найти("СуммаНДС") <> Неопределено);
	Для Каждого СтрокаДокумента Из ТаблицаТаможенныеПлатежи Цикл
		
		СтрокаДокумента.СуммаВал = СтрокаДокумента.Сумма;
		
		Если ЕстьНДСВТаблице Тогда
			СтрокаДокумента.СуммаНДСВал = СтрокаДокумента.СуммаНДС;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаТаможенныеПлатежи;
	
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция СрокиИсполненияИСуммыОбязательствПоДоговорам(СписокДоговоров, НаДату = Неопределено) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("НаДату", ?(ЗначениеЗаполнено(НаДату), КонецДня(НаДату), НаДату));
	ЗапросПоиск.УстановитьПараметр("СписокДоговоров", СписокДоговоров);
	ЗапросПоиск.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Период КАК Период,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Регистратор КАК Регистратор,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство КАК Договор,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.НачалоДействия КАК НачалоДействия,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ОкончаниеДействия КАК ОкончаниеДействия,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.СрокИсполнения КАК СрокИсполнения,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ВалютаРасчетов КАК ВалютаРасчетов,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Сумма КАК Сумма,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.СуммаВВалюте КАК СуммаВВалюте,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.АвансПроцентом КАК АвансПроцентом,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.СуммаАванса КАК СуммаАванса,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.КурсРасчетов КАК КурсРасчетов,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.КратностьРасчетов КАК КратностьРасчетов,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ПроцентПоЗайму КАК ПроцентПоЗайму,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.КазначейскоеСопровождение КАК КазначейскоеСопровождение,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ОплатаВРублях КАК ОплатаВРублях,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ВидОбязательства КАК ВидОбязательства,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ИФО КАК ИФО,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ПервичныйДокумент КАК ПервичныйДокумент,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.СрокИсполнения КАК ОкончаниеДоговора,
	|	ВЫБОР
	|		КОГДА &НаДату = НЕОПРЕДЕЛЕНО
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ СрокиИсполненияИСуммыОбязательствСрезПоследних.СрокИсполнения <= &НаДату
	|	КОНЕЦ КАК ДоговорПросрочен
	|ИЗ
	|	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(&НаДату, Обязательство В (&СписокДоговоров)) КАК СрокиИсполненияИСуммыОбязательствСрезПоследних";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Функция ДатаВозникновенияЗадолженности(Договор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Договор,
	|	Договоры.ДатаДоговора КАК ДатаДоговора
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|ГДЕ
	|	Договоры.Ссылка = &Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство КАК Договор,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.НачалоДействия КАК НачалоДействия
	|ИЗ
	|	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(
	|			,
	|			Обязательство = &Договор
	|				И НачалоДействия <> &ПустаяДата) КАК СрокиИсполненияИСуммыОбязательствСрезПоследних";
	
	Результат = Запрос.ВыполнитьПакет();
	ВыборкаДоговоры = Результат[0].Выбрать();
	ВыборкаСрокиИсполненияИСуммыОбязательств = Результат[1].Выбрать();
	Если ВыборкаСрокиИсполненияИСуммыОбязательств.Следующий() Тогда
		// Если срок действия договора установлен документом "Регистрация обязательств и сведений по договорам",
		// дата возникновения задолженности определяется из реквизита "Срок действия - с" (группа реквизитов "Сроки договора (обязательства)").
		Возврат ВыборкаСрокиИсполненияИСуммыОбязательств.НачалоДействия;
	ИначеЕсли ВыборкаДоговоры.Следующий() Тогда
		// В противном случае дата возникновения задолженности соответствует дате договора – реквизит "Вид обязательства - от" справочника "Договоры".
		Возврат ВыборкаДоговоры.ДатаДоговора;
	КонецЕсли;
	
	Возврат Дата(1,1,1);
	
КонецФункции

Функция ДатыВозникновенияЗадолженности(Договоры) Экспорт
	
	ДатыВозникновенияЗадолженности = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договоры", Договоры);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Договор,
	|	Договоры.ДатаДоговора КАК ДатаДоговора
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|ГДЕ
	|	Договоры.Ссылка В(&Договоры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство КАК Договор,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.НачалоДействия КАК НачалоДействия
	|ИЗ
	|	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(
	|			,
	|			Обязательство В (&Договоры)
	|				И НачалоДействия <> &ПустаяДата) КАК СрокиИсполненияИСуммыОбязательствСрезПоследних";
	
	Результат = Запрос.ВыполнитьПакет();
	ВыборкаДоговоры = Результат[0].Выбрать();
	ВыборкаСрокиИсполненияИСуммыОбязательств = Результат[1].Выбрать();
	
	Пока ВыборкаСрокиИсполненияИСуммыОбязательств.Следующий() Цикл
		// Если срок действия договора установлен документом "Регистрация обязательств и сведений по договорам",
		// дата возникновения задолженности определяется из реквизита "Срок действия - с" (группа реквизитов "Сроки договора (обязательства)").
		ДатыВозникновенияЗадолженности.Вставить(ВыборкаСрокиИсполненияИСуммыОбязательств.Договор,
			ВыборкаСрокиИсполненияИСуммыОбязательств.НачалоДействия);
	КонецЦикла;
	
	Пока ВыборкаДоговоры.Следующий() Цикл
		Если ДатыВозникновенияЗадолженности.Получить(ВыборкаДоговоры.Договор) = Неопределено Тогда
			// В противном случае дата возникновения задолженности соответствует дате договора – реквизит "Вид обязательства - от" справочника "Договоры".
			ДатыВозникновенияЗадолженности.Вставить(ВыборкаДоговоры.Договор,
				ВыборкаДоговоры.ДатаДоговора);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДатыВозникновенияЗадолженности;
	
КонецФункции

Процедура РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты) Экспорт
	
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат; // Нечего корректировать.
	КонецЕсли;
	
	Если Реквизиты.Свойство("Курс") И Реквизиты.Свойство("Кратность") Тогда
		КурсДокумента = ?(Реквизиты.Курс = 0, 1, Реквизиты.Курс)
			/ ?(Реквизиты.Кратность = 0, 1, Реквизиты.Кратность);
	Иначе
		КурсДокумента = 1;
	КонецЕсли;
	
	// Рассчитаем рублевые суммы, если они не рассчитаны в исходной таблице документа.
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	// СуммаРуб
	Если ТаблицаДокумента.Колонки.Найти("Сумма") <> Неопределено
		И ТаблицаДокумента.Колонки.Найти("СуммаРуб") = Неопределено Тогда
		
		ТаблицаДокумента.Колонки.Добавить("СуммаРуб", ОписаниеТипаСуммы);
		
		// Откат исправления ошибки 00-00269317. Неправильно брать итог по таблице расчетов
		// при агентском НДС и при отрицательных суммах в акте об оказании услуг.
		//Если ТаблицаРасчетовСЗачетомАвансов = Неопределено Тогда
			ИтогСуммаРуб = Окр(ТаблицаДокумента.Итог("Сумма") * КурсДокумента, 2);
		//Иначе
		//	ИтогСуммаРуб = ТаблицаРасчетовСЗачетомАвансов.Итог("СуммаРуб");
		//КонецЕсли;
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ИтогСуммаРуб, ТаблицаДокумента, "СуммаРуб", "Сумма");
		
	КонецЕсли;
	
	// СуммаНДСРуб
	Если ТаблицаДокумента.Колонки.Найти("СуммаНДС") <> Неопределено
		И ТаблицаДокумента.Колонки.Найти("СуммаНДСРуб") = Неопределено Тогда
		
		ТаблицаДокумента.Колонки.Добавить("СуммаНДСРуб", ОписаниеТипаСуммы);
		
		ИтогСуммаНДСРуб = Окр(ТаблицаДокумента.Итог("СуммаНДС") * КурсДокумента, 2);
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ИтогСуммаНДСРуб, ТаблицаДокумента, "СуммаНДСРуб", "СуммаНДС");
		
	КонецЕсли;
	
	УчетРасчетов.СкорректироватьСуммыРубПоКурсуАвансов(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
КонецПроцедуры

Процедура СкорректироватьСуммыРубПоКурсуАвансов(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты) Экспорт
	
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат; // Нечего корректировать.
	КонецЕсли;
	
	Если ТаблицаРасчетовСЗачетомАвансов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ТаблицаДокумента.Колонки.Добавить("КорректировкаДоКурсаАванса",    ОписаниеТипаСуммы);
	ТаблицаДокумента.Колонки.Добавить("КорректировкаДоКурсаАвансаНДС", ОписаниеТипаСуммы);
	
	ЕстьСчетРасчетовВТаблице = (ТаблицаДокумента.Колонки.Найти("СчетРасчетов") <> Неопределено);
	ЕстьКПСРасчетовВТаблице  = (ТаблицаДокумента.Колонки.Найти("КПСРасчетов") <> Неопределено);
	ЕстьКонтрагентВТаблице   = (ТаблицаДокумента.Колонки.Найти("Контрагент") <> Неопределено);
	ЕстьДоговорВТаблице      = (ТаблицаДокумента.Колонки.Найти("Договор") <> Неопределено);
	ЕстьНДСВТаблице          = (ТаблицаДокумента.Колонки.Найти("СуммаНДСРуб") <> Неопределено);
	
	Для Каждого СтрокаРасчетов Из ТаблицаРасчетовСЗачетомАвансов Цикл
		
		Если НЕ СтрокаРасчетов.РасчетыВВалюте Тогда
			Продолжить; // Нет валютных авансов.
		КонецЕсли;
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасчетов.СчетРасчетов);
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("КФО", СтрокаРасчетов.КФО);
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			ОтборСтрок.Вставить("ИФО", СтрокаРасчетов.ИФО);
		КонецЕсли;
		Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
			ОтборСтрок.Вставить("КПС", СтрокаРасчетов.КПС);
		КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			ОтборСтрок.Вставить("Подразделение", СтрокаРасчетов.Подразделение);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
			ОтборСтрок.Вставить("Валюта", СтрокаРасчетов.Валюта);
		КонецЕсли;
		Если ЕстьСчетРасчетовВТаблице Тогда
			ОтборСтрок.Вставить("СчетРасчетов", СтрокаРасчетов.СчетРасчетов);
		КонецЕсли;
		Если ЕстьКонтрагентВТаблице Тогда
			ОтборСтрок.Вставить("Контрагент", СтрокаРасчетов.Контрагент);
		КонецЕсли;
		Если ЕстьДоговорВТаблице Тогда
			ОтборСтрок.Вставить("Договор", СтрокаРасчетов.Договор);
		КонецЕсли;
		
		ОбщаяСуммаРасчетов = ТаблицаРасчетовСЗачетомАвансов.Скопировать(ОтборСтрок).Итог("СуммаРасчетов");
		Если ОбщаяСуммаРасчетов = 0
		 ИЛИ СтрокаРасчетов.СуммаРасчетов = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СвойстваСчетаРасчетов.УчетПоКПС И ЕстьКПСРасчетовВТаблице Тогда
			// КПС расчетов в отдельной колонке "КПСРасчетов".
			ОтборСтрок.Удалить("КПС");
			ОтборСтрок.Вставить("КПСРасчетов", СтрокаРасчетов.КПС);
		КонецЕсли;
		
		СтрокиДокумента     = ТаблицаДокумента.НайтиСтроки(ОтборСтрок);
		КопияСтрокДокумента = ТаблицаДокумента.Скопировать(ОтборСтрок);
		
		// Если в документе несколько табличных частей, которые влияют на расчеты с контрагентами,
		// то сумму корректировки нужно распределить по всем этим табличным частям.
		СуммаРасчетовПоСтрокам = ?(СтрокаРасчетов.УчетАгентскогоНДС И ЕстьНДСВТаблице,
			КопияСтрокДокумента.Итог("Сумма") - КопияСтрокДокумента.Итог("СуммаНДС"),
			КопияСтрокДокумента.Итог("Сумма"));
		
		// База распределения - доля расчетов по отобранным строкам документа в общей сумме расчетов.
		БазаРаспределения = Новый Массив;
		БазаРаспределения.Добавить(СуммаРасчетовПоСтрокам);
		БазаРаспределения.Добавить(ОбщаяСуммаРасчетов - СуммаРасчетовПоСтрокам);
		
		// Сумма корректировки, относящаяся к отобранным строкам документа.
		СуммаКорректировки = СтрокаРасчетов.СуммаРубПоКурсуАванса - СтрокаРасчетов.СуммаРуб;
		Если СуммаКорректировки = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		РаспределениеПоСтрокам = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СуммаКорректировки, БазаРаспределения);
		КорректировкаДоКурсаАванса = РаспределениеПоСтрокам[0];
		
		// Сумма корректировки НДС.
		//НДСПоКурсуАвансов = СтрокаРасчетов.УчетАгентскогоНДС И ЕстьНДСВТаблице;
		НДСПоКурсуАвансов = Ложь; // Сейчас агентский НДС учитывается по курсу поступления.
		Если НДСПоКурсуАвансов Тогда
			
			ДоляНДС = СтрокаРасчетов.СуммаРасчетов / ОбщаяСуммаРасчетов;
			
			СуммаНДСПоКурсуАванса = ДоляНДС * КопияСтрокДокумента.Итог("СуммаНДС")
				* СтрокаРасчетов.СуммаРубПоКурсуАванса / СтрокаРасчетов.СуммаРасчетов;
			
			КорректировкаНДСДоКурсаАванса = СуммаНДСПоКурсуАванса - ДоляНДС * КопияСтрокДокумента.Итог("СуммаНДСРуб");
			
		Иначе
			КорректировкаНДСДоКурсаАванса = 0;
		КонецЕсли;
		
		Если КорректировкаНДСДоКурсаАванса <> 0 Тогда
			
			// Корректировка колонки СуммаНДСРуб  - рассчитаем и сохраним в отдельной колонке.
			ИтогКорректировкаДоКурсаАвансаНДС = КопияСтрокДокумента.Итог("КорректировкаДоКурсаАвансаНДС");
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(
				ИтогКорректировкаДоКурсаАвансаНДС + КорректировкаНДСДоКурсаАванса,
				СтрокиДокумента, "КорректировкаДоКурсаАвансаНДС", "СуммаНДС");
			
		КонецЕсли;
		
		Если КорректировкаДоКурсаАванса + КорректировкаНДСДоКурсаАванса <> 0 Тогда
			
			// Корректировка колонки СуммаРуб - рассчитаем и сохраним в отдельной колонке.
			ИтогКорректировкаДоКурсаАванса = КопияСтрокДокумента.Итог("КорректировкаДоКурсаАванса");
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(
				ИтогКорректировкаДоКурсаАванса + КорректировкаДоКурсаАванса + КорректировкаНДСДоКурсаАванса,
				СтрокиДокумента, "КорректировкаДоКурсаАванса", "Сумма");
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Корректируем сумму и НДС в рублях до курса аванса (в части зачтенного аванса).
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СтрокаДокумента.СуммаРуб = СтрокаДокумента.СуммаРуб
			+ СтрокаДокумента.КорректировкаДоКурсаАванса;
		
		Если ЕстьНДСВТаблице Тогда
			СтрокаДокумента.СуммаНДСРуб = СтрокаДокумента.СуммаНДСРуб
				+ СтрокаДокумента.КорректировкаДоКурсаАвансаНДС;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Определяет счет расчетов по переданным параметрам.
//
Функция ОпределитьСчетРасчетовПоПараметрам(Параметры, ВидОперации, Знач НаДату = Неопределено, Знач Организация = Неопределено, Знач ИФО = Неопределено) Экспорт
	
	Если Параметры.Свойство("КЭКРасчетов") И ЗначениеЗаполнено(Параметры.КЭКРасчетов) Тогда // Определяем по КЭК 
		
		// Для КОСГУ 172 счет расчетов определятеся по аналитеческой группе доходов (аналитческой группе КИФ).
		// Чтобы корректно определитьсчет расчетов, необходимо передать КПС.
		Если Параметры.Свойство("КПС") И ЗначениеЗаполнено(Параметры.КПС) Тогда
			КПСРасчетов = Параметры.КПС;
		Иначе
			КПСРасчетов = Неопределено;
		КонецЕсли;	
		
		Если Параметры.Свойство("СчетРасчетов") И ЗначениеЗаполнено(Параметры.СчетРасчетов) Тогда
			Возврат БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
				Параметры.КЭКРасчетов, Параметры.СчетРасчетов, , НаДату, Организация, ИФО, КПСРасчетов);
		ИначеЕсли ВидОперации = "Поступление" Тогда
			Возврат БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
				Параметры.КЭКРасчетов, "302.00", , НаДату, Организация, ИФО, КПСРасчетов);
		ИначеЕсли ВидОперации = "Реализация" Тогда
			Возврат БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
				Параметры.КЭКРасчетов, "205.00", , НаДату, Организация, ИФО, КПСРасчетов);
		КонецЕсли;
		
	ИначеЕсли Параметры.Свойство("СчетРасчетов") И ЗначениеЗаполнено(Параметры.СчетРасчетов) Тогда
		
		Если ТипЗнч(Параметры.СчетРасчетов) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
			СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Параметры.СчетРасчетов);
			Если НЕ СвойстваСчетаРасчетов.ЗапретитьИспользоватьВПроводках
			   И НЕ СвойстваСчетаРасчетов.ЭлементГруппа Тогда
				Возврат Параметры.СчетРасчетов; // Явно указан.
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	
КонецФункции

// Определяет счет авансов по счету расчетов.
//
Функция ОпределитьСчетАвансов(СчетРасчетов, Знач НаДату = Неопределено, Знач Организация = Неопределено) Экспорт
	
	СчетАвансов = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	Если НЕ ЗначениеЗаполнено(СчетРасчетов) Тогда
		Возврат СчетАвансов;
	КонецЕсли;
	
	КодСчетаРасчетов = Строка(СчетРасчетов);
	
	Если УчетРасчетов.ВедетсяУчетАвансовПолученных(СчетРасчетов) Тогда // Отдельные субсчета 205.00, 209.00.
		
		// Сначала попытаемся найти забалансовый счет учета авансов полученных "АП".
		Если ЗначениеЗаполнено(НаДату) И ЗначениеЗаполнено(Организация)
			И (НаДату >= ДатаПереходаНаЗабалансовыйСчетАП(Организация)) Тогда
			
			Если БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(СчетРасчетов) Тогда
				СчетАвансов = БухгалтерскийУчет.СчетПоКоду("АП", НаДату, Неопределено);
			Иначе
				// Для счетов 205.81, 209.81, 209.82 без субконто "Договоры"
				// учет авансов полученных на счете "АП" не ведется.
				СчетАвансов = СчетРасчетов;
			КонецЕсли;
			
		КонецЕсли;
		
		// Если не нашли забалансовый счет, определим счет учета авансов полученных "по старому".
		Если НЕ ЗначениеЗаполнено(СчетАвансов) Тогда
			// Для счетов 205.хх, 209.хх счета авансов образуются
			// путем добавления буквы "А" в последний разряд кода - 205.хА, 209.хА.
			СчетАвансов = БухгалтерскийУчет.СчетПоКоду(Лев(КодСчетаРасчетов, 5) + "А", Неопределено, Неопределено);
		КонецЕсли;
		
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетРасчетов, "206.00") Тогда
		
		// Это и есть счет авансов выданных.
		СчетАвансов = СчетРасчетов;
		
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетРасчетов, "302.00") Тогда
		
		// Для счетов 302.хх счета авансов имеют вид 206.хх.
		СчетАвансов = БухгалтерскийУчет.СчетПоКоду("206." + Прав(КодСчетаРасчетов, 2), НаДату, Организация);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СчетАвансов) Тогда
		СчетАвансов = СчетРасчетов; // Нет отдельного счета авансов, авансы учитываются на том же счете.
	КонецЕсли;
	
	Возврат СчетАвансов;
	
КонецФункции

// Возвращает соответствующие счета авансов для выбранных счетов расчетов.
//
Функция СоответствиеСчетовАвансовСчетамРасчетов(СчетаРасчетов = "205.00,302.00", Знач НаДату = Неопределено, Знач Организация = Неопределено) Экспорт
	
	СоответствиеСчетовАвансовСчетамРасчетов = Новый Соответствие;
	
	СписокСчетовРасчетов = БухгалтерскийУчет.СписокСчетов(СчетаРасчетов, НаДату, , Организация);
	Для Каждого СчетРасчетов Из СписокСчетовРасчетов Цикл
		СчетАвансов = ОпределитьСчетАвансов(СчетРасчетов, НаДату, Организация);
		СоответствиеСчетовАвансовСчетамРасчетов.Вставить(СчетРасчетов, СчетАвансов);
	КонецЦикла;
	
	Возврат СоответствиеСчетовАвансовСчетамРасчетов;
	
КонецФункции

// Определяет счет расчетов по приобретению внеоборотных активов (ВНА).
//
Функция СчетРасчетовПоПриобретениюВНА(СчетУчетаВНА, СчетРасчетов = "302.00", Знач НаДату = Неопределено, Знач Организация = Неопределено) Экспорт
	
	СчетаВложенийВОС	= "106.11,106.21,106.31,106.41,106.51,106.52,106.КС,107.11,107.21,107.31,107.41";
	СчетаВложенийВНМА	= "106.22,106.32,106.42,106.2D,106.2I,106.2N,106.2R,106.3D,106.3I,106.3N,106.3R,106.54,106.9I";
	СчетаВложенийВНПА	= "106.13,106.43,106.55";
	СчетаВложенийВППНПА	= "106.60";
	
	Если ЗначениеЗаполнено(СчетУчетаВНА) Тогда
		
		Если СчетРасчетов = "208.00" Или БухгалтерскийУчет.СчетВИерархии(СчетРасчетов, "208.00") Тогда
			
			Если БухгалтерскийУчет.СчетВИерархии(СчетУчетаВНА, СчетаВложенийВОС) Тогда
				Возврат БухгалтерскийУчет.СчетПоКоду("208.31", НаДату, Организация);
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаВНА, СчетаВложенийВНМА) Тогда
				Возврат БухгалтерскийУчет.СчетПоКоду("208.32", НаДату, Организация);
			КонецЕсли;
			
		Иначе // 302.00
			
			Если БухгалтерскийУчет.СчетВИерархии(СчетУчетаВНА, СчетаВложенийВОС) Тогда
				Возврат БухгалтерскийУчет.СчетПоКоду("302.31", НаДату, Организация);
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаВНА, СчетаВложенийВНМА) Тогда
				Возврат БухгалтерскийУчет.СчетПоКоду("302.32", НаДату, Организация);
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаВНА, СчетаВложенийВНПА) Тогда
				Возврат БухгалтерскийУчет.СчетПоКоду("302.33", НаДату, Организация);
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаВНА, СчетаВложенийВППНПА) Тогда
				Возврат БухгалтерскийУчет.СчетПоКоду("302.26", НаДату, Организация);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	
КонецФункции

Функция СчетРасчетовПоАренднойПлате(СчетУчетаПравПользования, Знач НаДату = Неопределено, Знач Организация = Неопределено) Экспорт
	
	Если БухгалтерскийУчет.СчетВИерархии(СчетУчетаПравПользования, "111.49") Тогда
		Возврат БухгалтерскийУчет.СчетПоКоду("302.29", НаДату, Организация);
	Иначе
		Возврат БухгалтерскийУчет.СчетПоКоду("302.24", НаДату, Организация);
	КонецЕсли;
	
КонецФункции

Функция СчетРасчетовПредоставленногоЗайма(Договор, НаДату) Экспорт  
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТипыРасчетовПоКредитамСрезПоследних.ТипРасчетов КАК Счет
	|ИЗ
	|	РегистрСведений.ТипыРасчетовПоКредитам.СрезПоследних(&Период, Договор = &Договор) КАК ТипыРасчетовПоКредитамСрезПоследних";
	Запрос.УстановитьПараметр("Период", НаДату);
	Запрос.УстановитьПараметр("Договор", Договор); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Счет;
	Иначе
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Процедура ЗачетАвансовВыданныхОбработкаПроверкиЗаполнения(Объект, НепроверяемыеРеквизиты, Отказ) Экспорт

	Если Объект.СпособЗачетаАванса <> Перечисления.СпособыЗачетаАвансов.ПоДокументу Тогда
		НепроверяемыеРеквизиты.Добавить("ЗачетАвансов");
	КонецЕсли;
	
	ИмяТЧ = "";
	ПредставлениеТЧ = "";
	ИмяРеквизита = "";
	СуммаДокумента = 0;
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеУслугРабот")
			Или ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеУслугРаботПоСчетамУчетаЗатрат") Тогда
		ИмяТЧ = "УслугиИРаботы";
		ПредставлениеТЧ = "Услуги и работы";
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеОС") 
		ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеОСВПути")
		Или ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеОСИК") Тогда
		ИмяТЧ = "КапВложения";
		ПредставлениеТЧ = "Кап. вложения";
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеМЗ") Тогда
		ИмяРеквизита = "СуммаДокумента";
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеМЗВПути") Тогда
		ИмяРеквизита = "ВсегоПоДокументу";
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ПриходныйОрдерФондовый") Тогда
		ИмяРеквизита = "СуммаДокумента";
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ФормированиеВложенийВФинансовыеАктивы") Тогда
		ИмяРеквизита = "СуммаДокумента";
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ГТДИмпорт") Тогда
		Возврат; // пока не проверяется
	КонецЕсли;
	
	Если ИмяТЧ <> "" Тогда
		СуммаДокумента = Объект[ИмяТЧ].Итог("Всего");
	ИначеЕсли ИмяРеквизита <> "" Тогда
		СуммаДокумента = Объект[ИмяРеквизита];
	КонецЕсли;
	
	ВалютаДокумента = ?(ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ВалютаДокумента", Объект.Метаданные()),
		Объект.ВалютаДокумента, БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	
	СуммаАванса = Объект.ЗачетАвансов.Итог("СуммаЗачета");
	Если Не СуммаАванса = 0 И СуммаАванса > СуммаДокумента Тогда
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Сумма зачета аванса (%1) превышает сумму документа (%2).'"),
			ОбщегоНазначенияБГУ.ФорматСумм(СуммаАванса, ВалютаДокумента),
			ОбщегоНазначенияБГУ.ФорматСумм(СуммаДокумента, ВалютаДокумента));
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, "ЗачетАвансов[0].СуммаЗачета", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция ПериодПолученияОстатков(Документ, ТипВозвращаемогоЗначения = "Граница") Экспорт
	
	ПериодОстатков = ?(ТипВозвращаемогоЗначения = "Дата", Документ.Дата,
		Новый Граница(Документ.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	
	// Если документ проводится другой датой, отличной от даты документа, остатки нужно получать на дату исполнения.
	ДокументыСОтложеннымИсполнением =
		Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Измерения.ПлатежноРасчетныйДокумент.Тип;
	Если ДокументыСОтложеннымИсполнением.СодержитТип(ТипЗнч(Документ.Ссылка)) Тогда
		ДатаИсполненияДокумента = БухгалтерскиеОперации.ДатаИсполненияДокумента(Документ.Ссылка);
		Если ЗначениеЗаполнено(ДатаИсполненияДокумента) И ДатаИсполненияДокумента > Документ.Дата Тогда
			// Остатки определяем на дату исполнения, только если она больше даты документа.
			ПериодОстатков = ?(ТипВозвращаемогоЗначения = "Дата", ДатаИсполненияДокумента,
				Новый Граница(ДатаИсполненияДокумента, ВидГраницы.Исключая));
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПериодОстатков;
	
КонецФункции

Функция ДатаПереходаНаЗабалансовыйСчетАП(Знач Организация) Экспорт
	
	ДатаПереходаНаРедакцию64н = БухгалтерскийУчетПовтИсп.ДатаПереходаНаРедакциюПС(Организация, Дата('20180101'));
	
	Если ЗначениеЗаполнено(ДатаПереходаНаРедакцию64н) Тогда
		
		// Перевод учета авансов полученных на забалансовый счет АП совпадает с началом применения организацией
		// редакции плана счетов по Приказу Минфина России от 31.03.2018 N 64н.
		Возврат ДатаПереходаНаРедакцию64н;
		
	Иначе
		
		Возврат КонецГода('20180101');
		
	КонецЕсли;
	
КонецФункции

Функция ВедетсяУчетАвансовПолученных(СчетРасчетов) Экспорт
	
	Возврат БухгалтерскийУчет.СчетВИерархии(СчетРасчетов, "205.20,205.30,205.70,205.80,209.70,209.80,210.05");
	
КонецФункции

Функция УчетАгентскогоНДС(Договор) Экспорт
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		
		Возврат Ложь;
		
	ИначеЕсли ТипЗнч(Договор) = Тип("Структура") Тогда
		
		Возврат Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			И (Договор.ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговор
			ИЛИ Договор.ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговорНерезидент);
		
	ИначеЕсли ТипЗнч(Договор) = Тип("СправочникСсылка.Договоры") Тогда
		
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора,ТипДоговораНДС");
		
		Возврат РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			И (РеквизитыДоговора.ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговор
			ИЛИ РеквизитыДоговора.ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговорНерезидент);
		
	КонецЕсли;
	
КонецФункции

// Счет расчетов, доп.субконто расчетов в расшифровке платежа и других документах.

Функция ИспользуетсяНастройкаПогашенияЗадолженности(СчетРасчетов) Экспорт
	
	Возврат БухгалтерскийУчет.СчетВИерархии(СчетРасчетов, "205.00,209.00,206.00,302.00,210.05")
		И НЕ БухгалтерскийУчет.СчетВИерархии(СчетРасчетов, "205.2А,205.3А,205.7А,205.8А,209.7А,209.8А");
	
КонецФункции

Функция ПараметрыДопСубконтоРасчетов(СчетРасчетов) Экспорт
	
	ПараметрыДопСубконто = Новый Структура;
	ПараметрыДопСубконто.Вставить("Использование", Ложь);
	ПараметрыДопСубконто.Вставить("НомерСубконто", 0);
	ПараметрыДопСубконто.Вставить("ВидСубконто", ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
	ПараметрыДопСубконто.Вставить("Обязательный", Ложь);
	
	Если НЕ ЗначениеЗаполнено(СчетРасчетов) Тогда
		Возврат ПараметрыДопСубконто;
	КонецЕсли;
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетРасчетов);
	Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
	
		ВидСубконто = СвойстваСчета["ВидСубконто" + НомерСубконто];
		Если ВидСубконто = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты")
		 ИЛИ ВидСубконто = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Договоры") Тогда
			Продолжить; // Пропускаем.
		Иначе
			ПараметрыДопСубконто.Использование = Истина;
			ПараметрыДопСубконто.НомерСубконто = НомерСубконто;
			ПараметрыДопСубконто.ВидСубконто   = ВидСубконто;
			ПараметрыДопСубконто.Обязательный  = СвойстваСчета["ВидСубконто" + НомерСубконто + "Обязательный"];
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ПараметрыДопСубконто;
	
КонецФункции

Процедура ЗаполнитьПараметрыСчетаРасчетовВРасшифровкеПлатежа(Расшифровка, Знач КЭК, Знач КорСчет, Знач НаДату, Знач Организация, Знач ИФО, ТолькоДинамическиеКолонки = Ложь) Экспорт
	
	Если Расшифровка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РасшифровкаОбъект = ?(ТипЗнч(Расшифровка) = Тип("ФормаКлиентскогоПриложения"), Расшифровка.Объект, Расшифровка);
	
	Если УчетРасчетов.ИспользуетсяНастройкаПогашенияЗадолженности(КорСчет) Тогда
		
		Если НЕ ТолькоДинамическиеКолонки Тогда // Перезаполняем счет расчетов по КЭК и КорСчету.
			Если КорСчет = БухгалтерскийУчет.СчетПоКоду("205.00", Неопределено, Неопределено)
			 ИЛИ КорСчет = БухгалтерскийУчет.СчетПоКоду("209.00", Неопределено, Неопределено) Тогда
				// В расчетно-платежных документах кор.счета 205.00 и 209.00 в шапке объединены.
				РасшифровкаОбъект.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
					КЭК, "205.00,209.00",, НаДату, Организация, ИФО);
			Иначе
				// Для остальных кор.счетов (206.00, 302.00 и пр.) ищем только в рамках кор.счета в шапке документа.
				РасшифровкаОбъект.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
					КЭК, КорСчет,, НаДату, Организация, ИФО);
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыДопСубконтоРасчетов = ПараметрыДопСубконтоРасчетов(РасшифровкаОбъект.СчетРасчетов);
		
		Расшифровка.ДопСубконтоРасчетовВид   = ПараметрыДопСубконтоРасчетов.ВидСубконто;
		Расшифровка.ДопСубконтоРасчетовНомер = ПараметрыДопСубконтоРасчетов.НомерСубконто;
		
		Если ПараметрыДопСубконтоРасчетов.Использование = Ложь Тогда
			Расшифровка.ДопСубконтоРасчетовДоступность = 0; // Не показывать.
		ИначеЕсли ПараметрыДопСубконтоРасчетов.Обязательный Тогда
			Расшифровка.ДопСубконтоРасчетовДоступность = 1; // Обязательное субконто.
		Иначе
			Расшифровка.ДопСубконтоРасчетовДоступность = 2; // Необязательное субконто.
		КонецЕсли;
		
		Если НЕ ТолькоДинамическиеКолонки Тогда
			
			Если ПараметрыДопСубконтоРасчетов.Использование = Истина Тогда
				РасшифровкаОбъект.ДопСубконтоРасчетов = Расшифровка.ДопСубконтоРасчетовВид.ТипЗначения.ПривестиЗначение(
					РасшифровкаОбъект.ДопСубконтоРасчетов);
			Иначе
				РасшифровкаОбъект.ДопСубконтоРасчетов = Неопределено;
				РасшифровкаОбъект.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Расшифровка.ДопСубконтоРасчетовВид = ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
		Расшифровка.ДопСубконтоРасчетовНомер = 0;
		Расшифровка.ДопСубконтоРасчетовДоступность = 0;
		
		Если НЕ ТолькоДинамическиеКолонки Тогда
			
			РасшифровкаОбъект.СчетРасчетов = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
			РасшифровкаОбъект.ДопСубконтоРасчетов = Неопределено;
			РасшифровкаОбъект.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеТаблицыРасшифровкаПлатежа(УсловноеОформление, ПрефиксИмени = "РасшифровкаПлатежа", ИмяТаблицы = "РасшифровкаПлатежа") Экспорт
	
	// Счет расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ПрефиксИмени + "СчетРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".СчетРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<авто>'"));
	
	// Доступность реквизитов "Способ погашения задолженности" и "Доп. аналитика расчетов".
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ПрефиксИмени + "СпособПогашенияЗадолженности");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ПрефиксИмени + "ДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".СчетРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// Если "Способ погашения задолженности" не заполнен, значит погашаем автоматически.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ПрефиксИмени + "СпособПогашенияЗадолженности");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".СпособПогашенияЗадолженности", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Автоматически'"));
	
	// Для доп.субконто "Документы расчетов".
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ПрефиксИмени + "ДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ДопСубконтоРасчетовВид", ВидСравненияКомпоновкиДанных.Равно,
			ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".СпособПогашенияЗадолженности", ВидСравненияКомпоновкиДанных.НеРавно,
			Перечисления.СпособыПогашенияЗадолженности.ПоДокументу);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Обязательное доп.субконто расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ПрефиксИмени + "ДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ДопСубконтоРасчетовДоступность", ВидСравненияКомпоновкиДанных.Равно, 1);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ДопСубконтоРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
	// Необязательное доп.субконто расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ПрефиксИмени + "ДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ДопСубконтоРасчетовДоступность", ВидСравненияКомпоновкиДанных.Равно, 2);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ДопСубконтоРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<...>");
	
	// Нет доп.субконто расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ПрефиксИмени + "ДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ДопСубконтоРасчетовДоступность", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Автоматически определять дату оплаты по графику платежей.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ПрефиксИмени + "ОплатитьДо");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ОплатитьДо", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<авто>");
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыСчетаИДопСубконтоРасчетов(Начисление, Знач КЭК, Знач КорСчет, Знач НаДату, Знач Организация, Знач ИФО, ТолькоДинамическиеКолонки = Ложь) Экспорт
	
	Если Начисление = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НачислениеОбъект = ?(ТипЗнч(Начисление) = Тип("ФормаКлиентскогоПриложения"), Начисление.Объект, Начисление);
	
	Если НЕ ТолькоДинамическиеКолонки Тогда // Перезаполняем счет расчетов по КЭК и КорСчету.
		НачислениеОбъект.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
			КЭК, КорСчет,, НаДату, Организация, ИФО);
	КонецЕсли;
	
	ПараметрыДопСубконтоРасчетов = ПараметрыДопСубконтоРасчетов(НачислениеОбъект.СчетРасчетов);
	
	Начисление.ДопСубконтоРасчетовВид   = ПараметрыДопСубконтоРасчетов.ВидСубконто;
	Начисление.ДопСубконтоРасчетовНомер = ПараметрыДопСубконтоРасчетов.НомерСубконто;
	
	Если ПараметрыДопСубконтоРасчетов.Использование = Ложь Тогда
		Начисление.ДопСубконтоРасчетовДоступность = 0; // Не показывать.
	ИначеЕсли ПараметрыДопСубконтоРасчетов.Обязательный Тогда
		Начисление.ДопСубконтоРасчетовДоступность = 1; // Обязательное субконто.
	Иначе
		Начисление.ДопСубконтоРасчетовДоступность = 2; // Необязательное субконто.
	КонецЕсли;
	
	Если НЕ ТолькоДинамическиеКолонки Тогда
		
		Если ПараметрыДопСубконтоРасчетов.Использование = Истина Тогда
			НачислениеОбъект.ДопСубконтоРасчетов = Начисление.ДопСубконтоРасчетовВид.ТипЗначения.ПривестиЗначение(
				НачислениеОбъект.ДопСубконтоРасчетов);
		Иначе
			НачислениеОбъект.ДопСубконтоРасчетов = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеСчетаИДопСубконтоРасчетов(УсловноеОформление, ИмяТаблицы, АвтоОпределениеСчетаРасчетов = Ложь) Экспорт
	
	// Счет расчетов.
	Если АвтоОпределениеСчетаРасчетов Тогда
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяТаблицы + "СчетРасчетов");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"Объект." + ИмяТаблицы + ".СчетРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<авто>'"));
	КонецЕсли;
	
	// Доступность реквизитов "Способ погашения задолженности" и "Доп. аналитика расчетов".
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяТаблицы + "ДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".СчетРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не используется>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// Для доп.субконто "Документы расчетов".
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяТаблицы + "ДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ДопСубконтоРасчетовВид", ВидСравненияКомпоновкиДанных.Равно,
			ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Обязательное доп.субконто расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяТаблицы + "ДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ДопСубконтоРасчетовДоступность", ВидСравненияКомпоновкиДанных.Равно, 1);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ДопСубконтоРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
	// Необязательное доп.субконто расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяТаблицы + "ДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ДопСубконтоРасчетовДоступность", ВидСравненияКомпоновкиДанных.Равно, 2);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ДопСубконтоРасчетов", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<...>");
	
	// Нет доп.субконто расчетов.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяТаблицы + "ДопСубконтоРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТаблицы + ".ДопСубконтоРасчетовДоступность", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры

#Область УстаревшиеПроцедурыИФункции

Процедура РассчитатьСуммыРубПоКурсуДокумента(ТаблицаДокумента, Реквизиты) Экспорт
	
	Если Реквизиты.Свойство("Курс") И Реквизиты.Свойство("Кратность") Тогда
		КурсДокумента = ?(Реквизиты.Курс = 0, 1, Реквизиты.Курс)
			/ ?(Реквизиты.Кратность = 0, 1, Реквизиты.Кратность);
	Иначе
		КурсДокумента = 1;
	КонецЕсли;
	
	// Рассчитаем рублевые суммы, если они не рассчитаны в исходной таблице документа.
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	// СуммаРуб
	Если ТаблицаДокумента.Колонки.Найти("Сумма") <> Неопределено
	   И ТаблицаДокумента.Колонки.Найти("СуммаРуб") = Неопределено Тогда
		ТаблицаДокумента.Колонки.Добавить("СуммаРуб", ОписаниеТипаСуммы);
		
		ИтогСуммаРуб = Окр(ТаблицаДокумента.Итог("Сумма") *КурсДокумента, 2);
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ИтогСуммаРуб, ТаблицаДокумента, "СуммаРуб", "Сумма");
		
	КонецЕсли;
	
	// СуммаНДСРуб
	Если ТаблицаДокумента.Колонки.Найти("СуммаНДС") <> Неопределено
	   И ТаблицаДокумента.Колонки.Найти("СуммаНДСРуб") = Неопределено Тогда
		ТаблицаДокумента.Колонки.Добавить("СуммаНДСРуб", ОписаниеТипаСуммы);
		
		ИтогСуммаНДСРуб = Окр(ТаблицаДокумента.Итог("СуммаНДС") * КурсДокумента, 2);
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ИтогСуммаНДСРуб, ТаблицаДокумента, "СуммаНДСРуб", "СуммаНДС");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДобавитьСлужебныеКолонкиРасчетовСКонтрагентами(ТаблицаДокумента, Реквизиты)
	
	Если ТаблицаДокумента = Неопределено Тогда
		Возврат ТаблицаДокумента;
	КонецЕсли;
	
	НетКолонкиСуммаРуб = (ТаблицаДокумента.Колонки.Найти("СуммаРуб") = Неопределено);
	Если НетКолонкиСуммаРуб Тогда
		ТаблицаДокумента.Колонки.Добавить("СуммаРуб", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18, 2));
	КонецЕсли;
	
	НетКолонкиСчетАвансов = (ТаблицаДокумента.Колонки.Найти("СчетАвансов") = Неопределено);
	Если НетКолонкиСчетАвансов Тогда
		ТаблицаДокумента.Колонки.Добавить("СчетАвансов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	КонецЕсли;
	
	ТаблицаДокумента.Колонки.Добавить("ВидАванса",         ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(10));
	ТаблицаДокумента.Колонки.Добавить("РасчетыВВалюте",    Новый ОписаниеТипов("Булево"));
	ТаблицаДокумента.Колонки.Добавить("Курс",              ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10, 4));
	ТаблицаДокумента.Колонки.Добавить("Кратность",         ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10, 0));
	Если ТаблицаДокумента.Колонки.Найти("ВидДоговора") = Неопределено Тогда
		ТаблицаДокумента.Колонки.Добавить("ВидДоговора",   Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
	КонецЕсли;
	ТаблицаДокумента.Колонки.Добавить("УчетАгентскогоНДС", Новый ОписаниеТипов("Булево"));
	
	РеквизитыДоговоров = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("Договор")),
			"ВидДоговора,ТипДоговораНДС");
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		// Определим счета авансов, если они еще не указаны в таблице.
		Если НетКолонкиСчетАвансов Тогда
			ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
				УчетРасчетов.ПериодПолученияОстатков(Реквизиты, "Дата"));
			СтрокаДокумента.СчетАвансов = УчетРасчетов.ОпределитьСчетАвансов(СтрокаДокумента.СчетРасчетов,
				ПериодОстатков, Реквизиты.Организация);
		КонецЕсли;
		
		// Определим вид аванса: выданный или полученный.
		Если БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетРасчетов, "205.00") 
			ИЛИ БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетРасчетов, "210.05")
			ИЛИ БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетРасчетов, "209.00") Тогда
			СтрокаДокумента.ВидАванса = "Полученный";
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетРасчетов, "206.00") Тогда
			СтрокаДокумента.ВидАванса = "Выданный";
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетРасчетов, "302.00") Тогда
			СтрокаДокумента.ВидАванса = "Выданный";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.Договор) Тогда
			СтрокаДокумента.ВидДоговора = РеквизитыДоговоров[СтрокаДокумента.Договор].ВидДоговора;
			СтрокаДокумента.УчетАгентскогоНДС = УчетРасчетов.УчетАгентскогоНДС(РеквизитыДоговоров[СтрокаДокумента.Договор]);
		Иначе
			СтрокаДокумента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПустаяСсылка();
			СтрокаДокумента.УчетАгентскогоНДС = Ложь;
		КонецЕсли;
		
		СтрокаДокумента.РасчетыВВалюте = Реквизиты.ИспользоватьВалютныйУчет И
			(СтрокаДокумента.Валюта <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
		
		Если СтрокаДокумента.РасчетыВВалюте Тогда
			
			Если НЕ (Реквизиты.Свойство("Курс") И Реквизиты.Свойство("Кратность")) Тогда
				КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрокаДокумента.Валюта, НачалоДня(Реквизиты.Дата));
				СтрокаДокумента.Курс      = КурсКратность.Курс;
				СтрокаДокумента.Кратность = КурсКратность.Кратность;
			Иначе
				СтрокаДокумента.Курс      = Реквизиты.Курс;
				СтрокаДокумента.Кратность = Реквизиты.Кратность;
			КонецЕсли;
			
			Если НетКолонкиСуммаРуб Тогда
				КурсДокумента = ?(СтрокаДокумента.Кратность = 0, СтрокаДокумента.Курс,
									СтрокаДокумента.Курс / СтрокаДокумента.Кратность);
				СтрокаДокумента.СуммаРуб = Окр(СтрокаДокумента.СуммаРасчетов * КурсДокумента, 2);
			Иначе
				// Колонка "СуммаРуб" уже рассчитана.
			КонецЕсли;
			
		Иначе
			СтрокаДокумента.СуммаРуб  = СтрокаДокумента.СуммаРасчетов;
			СтрокаДокумента.Курс      = 1;
			СтрокаДокумента.Кратность = 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

Процедура ПроверитьКорректностьНастройкиСчетовРасчетов(ТаблицаДокумента, Реквизиты)
	
	Если ТаблицаДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Реквизиты.ИспользоватьВалютныйУчет Тогда
		
		Отбор = Новый Структура("РасчетыВВалюте", Истина);
		СтрокиРасчетыВВалюте = ТаблицаДокумента.Скопировать(Отбор, "СчетРасчетов,СчетАвансов,Валюта");
		СтрокиРасчетыВВалюте.Свернуть("СчетРасчетов,СчетАвансов,Валюта");
		Для Каждого СтрокаРасчетов Из СтрокиРасчетыВВалюте Цикл
			
			Если БухгалтерскийУчет.СчетВИерархии(СтрокаРасчетов.СчетРасчетов, "302.00")
				И БухгалтерскийУчет.СчетВИерархии(СтрокаРасчетов.СчетАвансов, "206.00") Тогда
				
				// Оба счета - 302.хх и 206.хх - должны быть валютными.
				СвойстваСчетаАвансов  = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасчетов.СчетАвансов);
				СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасчетов.СчетРасчетов);
				Если НЕ СвойстваСчетаРасчетов.Валютный ИЛИ НЕ СвойстваСчетаАвансов.Валютный Тогда
					ТекстОшибки = НСтр("ru='Внимание! Для корректного отражения в учете расчетов в валюте %1 необходимо установить валютный учет на счетах %2 и %3.
						|Установите признак ""Валютный"" в настройках указанных счетов (в разделе ""Учет и отчетность - План счетов (ЕПСБУ)"").'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
						СтрокаРасчетов.Валюта,
						СтрокаРасчетов.СчетРасчетов,
						СтрокаРасчетов.СчетАвансов);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, , "Объект");
				КонецЕсли;
				
			Иначе
				
				// Счет авансов совпадает со счетом расчетов. Либо счет авансов АП - всегда валютный.
				СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасчетов.СчетРасчетов);
				Если НЕ СвойстваСчетаРасчетов.Валютный Тогда
					ТекстОшибки = НСтр("ru='Внимание! Для корректного отражения в учете расчетов в валюте %1 необходимо установить валютный учет на счете %2.
						|Установите признак ""Валютный"" в настройке указанного счета (в разделе ""Учет и отчетность - План счетов (ЕПСБУ)"").'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
						СтрокаРасчетов.Валюта,
						СтрокаРасчетов.СчетРасчетов);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, , "Объект");
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнениеДоговораОбязательно(СчетРасчетов)
	
	Если ЗначениеЗаполнено(СчетРасчетов) Тогда
		
		ВидСубконтоДоговоры = СчетРасчетов.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
		Если ЗначениеЗаполнено(ВидСубконтоДоговоры) Тогда
			Возврат ВидСубконтоДоговоры.Обязательный;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти
