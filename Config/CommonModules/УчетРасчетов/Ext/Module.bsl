	|	""НДС"",
	|	ОсновныеСредства.ИФО,
	|	ОсновныеСредства.КФО,
	|	ОсновныеСредства.КПС,
	|	ОсновныеСредства.Подразделение,
	|	ОсновныеСредства.СчетРасчетовНДС,
	|	ОсновныеСредства.Контрагент,
	|	ОсновныеСредства.Договор,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Разделы.НДСВВалюте, ЛОЖЬ)
	|			ТОГДА ОсновныеСредства.ВалютаДокумента
	|		ИНАЧЕ &ВалютаРеглУчета
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.УчитыватьНДС
	|			ТОГДА ОсновныеСредства.СуммаНДС
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.УчитыватьНДС
	|			ТОГДА ОсновныеСредства.СуммаНДС
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаРазделы КАК Разделы
	|		ПО ОсновныеСредства.НомерРаздела = Разделы.НомерСтроки";
	НомераТаблиц.Вставить("ПошлиныНДСПоОсновнымСредствам", НомераТаблиц.Количество());
	
	Если Параметры.ПоВсемКФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СборыРуб.КФО",
			"ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СборыВал.КФО",
			"ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ШтрафыРуб.КФО",
			"ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ШтрафыВал.КФО",
			"ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Материалы.КФО",
			"ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОсновныеСредства.КФО",
			"ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
	КонецЕсли;
	Если Параметры.ПоВсемКПС Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СборыРуб.КПС",
			"ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СборыВал.КПС",
			"ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ШтрафыРуб.КПС",
			"ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ШтрафыВал.КПС",
			"ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Материалы.КПС",
			"ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОсновныеСредства.КПС",
			"ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаможенныеСборы = Результат[НомераТаблиц.ТаможенныеСборы].Выгрузить();
	Для Каждого СтрокаТаблицы Из ТаможенныеСборы Цикл
		
		НоваяСтрока = ТаблицаРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.ЭтоПоступление = Истина;
		
	КонецЦикла;
	
	ТаможенныеШтрафы = Результат[НомераТаблиц.ТаможенныеШтрафы].Выгрузить();
	Для Каждого СтрокаТаблицы Из ТаможенныеШтрафы Цикл
		
		НоваяСтрока = ТаблицаРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.ЭтоПоступление = Истина;
		
	КонецЦикла;
	
	ПошлиныНДСПоМатериалам = Результат[НомераТаблиц.ПошлиныНДСПоМатериалам].Выгрузить();
	Для Каждого СтрокаТаблицы Из ПошлиныНДСПоМатериалам Цикл
		
		НоваяСтрока = ТаблицаРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.ЭтоПоступление = Истина;
		
	КонецЦикла;
	
	ПошлиныНДСПоОсновнымСредствам = Результат[НомераТаблиц.ПошлиныНДСПоОсновнымСредствам].Выгрузить();
	Для Каждого СтрокаТаблицы Из ПошлиныНДСПоОсновнымСредствам Цикл
		
		НоваяСтрока = ТаблицаРасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.ЭтоПоступление = Истина;
		
	КонецЦикла;
	
	ТаблицаРасчетов.Свернуть("ЭтоПоступление,ИФО,КФО,КПС,КЭК,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта",
		"СуммаНДС,СуммаРасчетов");
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

// Остатки авансов (выданных и полученных).

Функция ОстаткиАвансов(Период, ТаблицаДокумента, Реквизиты) Экспорт
	
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	ИначеЕсли Реквизиты.Свойство("СпособЗачетаАванса")
			И Реквизиты.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.НеЗачитывать Тогда
		Возврат Новый ТаблицаЗначений; // Не нужно зачитывать авансы.
	КонецЕсли;
	Если НЕ Реквизиты.Свойство("ПоВсемКФО") Тогда
		Реквизиты.Вставить("ПоВсемКФО", Ложь);
	КонецЕсли;
	Если НЕ Реквизиты.Свойство("ПоВсемКПС") Тогда
		Реквизиты.Вставить("ПоВсемКПС", Ложь);
	КонецЕсли;
	
	УчитыватьКорректировку = Реквизиты.Свойство("КорректируемыйДокумент");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МоментВремени", Период);
	Запрос.УстановитьПараметр("Организация",   Реквизиты.Организация);
	
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет", ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("УчитыватьЗадолженностьЕНВД",
		?(Реквизиты.Свойство("УчитыватьЗадолженностьЕНВД"), Реквизиты.УчитыватьЗадолженностьЕНВД, Ложь));
	
	ПараметрыОтбора = ПараметрыОтбораОстатковАвансов(ТаблицаДокумента, Реквизиты);
	КолонкиПараметровУчета = 
		"УчетПоИФО, УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям, ПоВсемКФО, ПоВсемКПС,
		|КонтрагентЕстьСубконто,ДоговорЕстьСубконто,
		|ДопАналитикаЕстьСубконто,ДопАналитикаВидСубконто, АвансыПоДебету";
	ТаблицаПараметровУчета = ПараметрыОтбора.Скопировать();
	ТаблицаПараметровУчета.Свернуть(КолонкиПараметровУчета);
	ТаблицаПараметровУчета.Колонки.Добавить("НомераСубконто", Новый ОписаниеТипов("Соответствие"));
	
	// Блокируем регистр бухгалтерии для получения остатков.
	УстанавливатьБлокировку = ?(Реквизиты.Свойство("ТиповаяОперация"), Реквизиты.ТиповаяОперация.УстанавливатьБлокировку, Ложь);
	Если УстанавливатьБлокировку Тогда
		
	КонецЕсли;
	
	// Текст запроса по остаткам формируется для каждого набора параметров учета расчетов.
	ТекстОбщегоЗапроса = "";
	Для НомерЗапроса=1 По ТаблицаПараметровУчета.Количество() Цикл
		
		НаборПараметровУчета = ТаблицаПараметровУчета[НомерЗапроса-1];
		
		Если НЕ НаборПараметровУчета.КонтрагентЕстьСубконто Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСубконто = Новый Массив;
		
		// Контрагент.
		МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
		НаборПараметровУчета.НомераСубконто.Вставить("Контрагент", 1);
		
		// Договор.
		Если НаборПараметровУчета.ДоговорЕстьСубконто Тогда
			
			МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
			НаборПараметровУчета.НомераСубконто.Вставить("Договор",
				НаборПараметровУчета.НомераСубконто.Количество() + 1);
			
		КонецЕсли;
		
		// ДопАналитика (документ расчетов или др.).
		Если НаборПараметровУчета.ДопАналитикаЕстьСубконто Тогда
			
			МассивСубконто.Добавить(НаборПараметровУчета.ДопАналитикаВидСубконто);
			НаборПараметровУчета.НомераСубконто.Вставить("ДопАналитика",
				НаборПараметровУчета.НомераСубконто.Количество() + 1);
			
		КонецЕсли;
		
		// Добавляем виртуальную таблицу.
		ТекстЗапроса = ТекстЗапросаОстаткиАвансов(НаборПараметровУчета, НомерЗапроса);
		Если УчитыватьКорректировку Тогда
			ТекстЗапросаКорректировки = ТекстЗапросаЗачетАвансаВКорректируемыхДокументах(НаборПараметровУчета, НомерЗапроса);
			ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("Все") + ТекстЗапросаКорректировки;
			Запрос.УстановитьПараметр("КорректируемыйДокумент", КорректируемыеДокументы(Реквизиты.КорректируемыйДокумент, Реквизиты.НомерКорректировки));
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов();
		
		// Устанавливаем параметры виртуальной таблицы.
		Отбор = Новый Структура(КолонкиПараметровУчета);
		ЗаполнитьЗначенияСвойств(Отбор, НаборПараметровУчета);
		ОтборОстатков = ПараметрыОтбора.Скопировать(Отбор);
		
		Запрос.УстановитьПараметр("Счета" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("СчетОстатков")) );
		Запрос.УстановитьПараметр("ИФО" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("ИФО")) );
		Запрос.УстановитьПараметр("КФО" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("КФО")) );
		Запрос.УстановитьПараметр("КПС" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("КПС")) );
		Запрос.УстановитьПараметр("КЭК" + НомерЗапроса,
			ДополнитьГрупповымКЭК440(ОтборОстатков.ВыгрузитьКолонку("КЭК")) );
		Запрос.УстановитьПараметр("Подразделение" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("Подразделение")) );
		Запрос.УстановитьПараметр("Контрагенты" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("Контрагент")) );
		Запрос.УстановитьПараметр("Договоры" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("Договор")) );
		Запрос.УстановитьПараметр("УчетПоПодразделениям" + НомерЗапроса,
			НаборПараметровУчета.УчетПоПодразделениям);
		Запрос.УстановитьПараметр("УчетПоКПС" + НомерЗапроса,
			НаборПараметровУчета.УчетПоКПС);
		Запрос.УстановитьПараметр("ДопАналитикаВидСубконто" + НомерЗапроса,
			НаборПараметровУчета.ДопАналитикаВидСубконто);
		
		Запрос.УстановитьПараметр("Субконто" + НомерЗапроса, МассивСубконто);
		
		// Соединение виртуальных таблиц.
		Если НЕ ПустаяСтрока(ТекстОбщегоЗапроса) Тогда
			ТекстОбщегоЗапроса = ТекстОбщегоЗапроса + "
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|";
		КонецЕсли;
		
		ТекстОбщегоЗапроса = ТекстОбщегоЗапроса +
		"ВЫБРАТЬ
		|	ТаблицаОстаткиАвансов_НомерЗапроса.СчетАвансов КАК СчетАвансов,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.УчетПоПодразделениям КАК УчетПоПодразделениям,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.УчетПоКПС КАК УчетПоКПС,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.ИФО КАК ИФО,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.КФО КАК КФО,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.КПС КАК КПС,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.КЭК КАК КЭК,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.Подразделение КАК Подразделение,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.Контрагент КАК Контрагент,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.Договор КАК Договор,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.ДопСубконтоАвансов КАК ДопСубконтоАвансов,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.ВидДопСубконтоАвансов КАК ВидДопСубконтоАвансов,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.Валюта КАК Валюта,
		|	СУММА(ТаблицаОстаткиАвансов_НомерЗапроса.СуммаРасчетов) КАК СуммаРасчетов,
		|	СУММА(ТаблицаОстаткиАвансов_НомерЗапроса.СуммаРуб) КАК СуммаРуб,
		|	СУММА(ТаблицаОстаткиАвансов_НомерЗапроса.СуммаЕНВДРуб) КАК СуммаЕНВДРуб
		|ИЗ
		|	ОстаткиАвансов_НомерЗапроса КАК ТаблицаОстаткиАвансов_НомерЗапроса
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаОстаткиАвансов_НомерЗапроса.СчетАвансов,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.УчетПоПодразделениям,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.УчетПоКПС,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.ИФО,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.КФО,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.КПС,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.КЭК,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.Подразделение,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.Контрагент,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.Договор,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.ДопСубконтоАвансов,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.ВидДопСубконтоАвансов,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.Валюта";
		
		ТекстОбщегоЗапроса = СтрЗаменить(ТекстОбщегоЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + ТекстОбщегоЗапроса;
	Если ПустаяСтрока(Запрос.Текст) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	ОстаткиАвансов = Запрос.Выполнить().Выгрузить();
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиАвансов, "ДопСубконтоАвансов", "ДатаДокументаАвансов");
	
	Возврат ОстаткиАвансов;
	
КонецФункции

Функция ДополнитьГрупповымКЭК440(НачальныеКЭК)
	
	ГрупповойКЭК = БухгалтерскийУчетПовтИсп.КЭКпоКоду("440");
	ДетальныеКЭК440 = ПолучитьДетальныеКЭК440();
	
	НовыеКЭК = Новый Соответствие;
	Для Каждого КЭК Из НачальныеКЭК Цикл
		
		НовыеКЭК.Вставить(КЭК);
		Если ДетальныеКЭК440.Получить(КЭК) <> Неопределено Тогда
			НовыеКЭК.Вставить(ГрупповойКЭК);
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Новый Массив;
	Для Каждого КлючЗначение Из НовыеКЭК Цикл
		Результат.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыОтбораОстатковАвансов(ТаблицаДокумента, Реквизиты)
	
	ПараметрыОтбора = ТаблицаДокумента.СкопироватьКолонки("ИФО,КФО,КПС,КЭК,Подразделение,Контрагент,Договор,СчетРасчетов");
	ПараметрыОтбора.Колонки.Добавить("СчетОстатков", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		Отбор = ПараметрыОтбора.Добавить();
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
		Отбор.СчетОстатков = СтрокаДокумента.СчетАвансов;
		
		Если СтрокаДокумента.СчетРасчетов <> СтрокаДокумента.СчетАвансов Тогда
			Отбор = ПараметрыОтбора.Добавить();
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
			Отбор.СчетОстатков = СтрокаДокумента.СчетРасчетов;
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыОтбора.Колонки.Добавить("УчетПоИФО",            Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("УчетПоКПС",            Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("УчетПоКЭК",            Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("УчетПоПодразделениям", Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("ПоВсемКФО",            Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("ПоВсемКПС",            Новый ОписаниеТипов("Булево"));
	
	ПараметрыОтбора.Колонки.Добавить("КонтрагентЕстьСубконто",   Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("ДоговорЕстьСубконто",      Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("ДопАналитикаЕстьСубконто", Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("ДопАналитикаВидСубконто",  Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ПараметрыОтбора.Колонки.Добавить("АвансыПоДебету",           Новый ОписаниеТипов("Булево"));
	
	Для Каждого Отбор Из ПараметрыОтбора Цикл
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Отбор.СчетОстатков);
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Отбор.СчетРасчетов);
		
		Отбор.УчетПоИФО = Реквизиты.ИспользоватьУчетПоИФО;
		Отбор.УчетПоКПС = СвойстваСчета.УчетПоКПС;
		Отбор.ПоВсемКФО = Реквизиты.ПоВсемКФО;
		Отбор.ПоВсемКПС = Реквизиты.ПоВсемКПС;
		
		ЭтоЗабалансовыйСчетАвансовПолученных = БухгалтерскийУчет.СчетВИерархии(Отбор.СчетОстатков, "АП");
		Отбор.АвансыПоДебету = ЭтоЗабалансовыйСчетАвансовПолученных ИЛИ БухгалтерскийУчет.СчетВИерархии(Отбор.СчетОстатков, "205.00");;
		
		// Отбор остатков по КЭК выполняется только для авансов полученных на забалансовом счете АП.
		// На остальных счетах КЭК либо не используются, либо используются КЭК "Увеличение/уменьшение задолженности".
		Отбор.УчетПоКЭК = ЭтоЗабалансовыйСчетАвансовПолученных;
		
		Отбор.УчетПоПодразделениям = Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям;
		Если ЭтоЗабалансовыйСчетАвансовПолученных И НЕ СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			// Если на счете расчетов учет по подразделениям не ведется,
			// остатки авансов полученных по забалансовому счету АП будут учтены по пустому подразделению.
			Отбор.Подразделение = Справочники.Подразделения.ПустаяСсылка();
		КонецЕсли;
		
		Для Индекс = 1 По СвойстваСчета.КоличествоСубконто Цикл
		
			ВидСубконто = СвойстваСчета["ВидСубконто" + Индекс];
			Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
				Отбор.КонтрагентЕстьСубконто = Истина;
				
			ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Договоры Тогда
				Отбор.ДоговорЕстьСубконто = Истина;
				
			Иначе
				Отбор.ДопАналитикаЕстьСубконто = Истина;
				Отбор.ДопАналитикаВидСубконто  = ВидСубконто;
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ПараметрыОтбора;
	
КонецФункции

Функция ТекстЗапросаОстаткиАвансов(ПараметрыУчета, НомерЗапроса)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Остатки.Счет КАК СчетАвансов,
	|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
	|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	Остатки.КЭК КАК КЭК,
	|	Остатки.Подразделение КАК Подразделение,
	|	&ОстаткиКонтрагент КАК Контрагент,
	|	&ОстаткиДоговор КАК Договор,
	|	&ОстаткиДопАналитика КАК ДопСубконтоАвансов,
	|	&ДопАналитикаВидСубконто_НомерЗапроса КАК ВидДопСубконтоАвансов,
	|	ЕСТЬNULL(Остатки.Валюта, &ВалютаРеглУчета) КАК Валюта,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|				И Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаОстаток
	|		ИНАЧЕ Остатки.СуммаОстаток
	|	КОНЕЦ КАК СуммаРасчетов,
	|	Остатки.СуммаОстаток КАК СуммаРуб,
	|	ВЫБОР
	|		КОГДА &УчитыватьЗадолженностьЕНВД
	|				И Остатки.Счет.НалоговыйУчетЕНВД
	|			ТОГДА Остатки.СуммаЕНВДОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаЕНВДРуб
	|ПОМЕСТИТЬ ОстаткиАвансов_НомерЗапроса
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&МоментВремени,
	|			Счет В (&Счета_НомерЗапроса),
	|			&Субконто_НомерЗапроса,
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКФО
	|				И &УсловиеПоКонтрагентам
	|				И &УсловиеПоДоговорам
	|				И &УсловиеПоКПС
	|				И &УсловиеПоКЭК
	|				И &УсловиеПоПодразделению) КАК Остатки";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоИФО",
		?(ПараметрыУчета.УчетПоИФО, "ИФО В (&ИФО_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКФО",
		?(НЕ ПараметрыУчета.ПоВсемКФО, "КФО В (&КФО_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКПС",
		?(ПараметрыУчета.УчетПоКПС И НЕ ПараметрыУчета.ПоВсемКПС, "КПС В (&КПС_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКЭК",
		?(ПараметрыУчета.УчетПоКЭК, "КЭК В (&КЭК_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению",
		?(ПараметрыУчета.УчетПоПодразделениям, "Подразделение В (&Подразделение_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКонтрагентам",
		"Субконто"+ПараметрыУчета.НомераСубконто["Контрагент"]+" В (&Контрагенты_НомерЗапроса)");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДоговорам",
		?(ПараметрыУчета.ДоговорЕстьСубконто,
		"Субконто"+ПараметрыУчета.НомераСубконто["Договор"]+" В (&Договоры_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОстаткиКонтрагент",
		"Остатки.Субконто"+ПараметрыУчета.НомераСубконто["Контрагент"]);
	Если ПараметрыУчета.ДоговорЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОстаткиДоговор",
			"Остатки.Субконто"+ПараметрыУчета.НомераСубконто["Договор"]);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОстаткиДоговор",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	Если ПараметрыУчета.ДопАналитикаЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОстаткиДопАналитика",
			"ЕСТЬNULL(Остатки.Субконто"+ПараметрыУчета.НомераСубконто["ДопАналитика"] + ", НЕОПРЕДЕЛЕНО)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОстаткиДопАналитика",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Если НЕ ПараметрыУчета.УчетПоКЭК Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.КЭК", "ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоКПС Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.КПС", "ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоИФО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоПодразделениям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаЗачетАвансаВКорректируемыхДокументах(ПараметрыУчета, НомерЗапроса)
	
	Если ПараметрыУчета.АвансыПоДебету Тогда
		Возврат ТекстЗапросаЗачетАвансаВКорректируемыхДокументахДт(ПараметрыУчета, НомерЗапроса);
	Иначе
		Возврат ТекстЗапросаЗачетАвансаВКорректируемыхДокументахКт(ПараметрыУчета, НомерЗапроса);
	КонецЕсли;

КонецФункции

Функция ТекстЗапросаЗачетАвансаВКорректируемыхДокументахКт(ПараметрыУчета, НомерЗапроса)
	
	ТекстЗапросаЗачетАванса = ЧастьТекстаЗапросаЗачетАвансаВКорректируемыхДокументах(1, "СчетКт");
	ТекстЗапросаЗачетАванса = СтрЗаменить(ТекстЗапросаЗачетАванса, "&УсловиеСчет", "СчетКт В (&Счета_НомерЗапроса)");
	
	ТекстЗапросаРасчеты = ЧастьТекстаЗапросаЗачетАвансаВКорректируемыхДокументах(-1, "СчетДт");
	ТекстЗапросаРасчеты = СтрЗаменить(ТекстЗапросаРасчеты, "&УсловиеСчет", "СчетКт В (&Счета1) И СчетДт В (&Счета1)");
	
	ТекстЗапроса = ТекстЗапросаЗачетАванса + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("Все") + ТекстЗапросаРасчеты;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоИФО",
		?(ПараметрыУчета.УчетПоИФО, "ИФО В (&ИФО_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКФО",
		?(НЕ ПараметрыУчета.ПоВсемКФО, "КФО В (&КФО_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКПС",
		?(ПараметрыУчета.УчетПоКПС И НЕ ПараметрыУчета.ПоВсемКПС, "КПСКт В (&КПС_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКЭК",
		?(ПараметрыУчета.УчетПоКЭК, "КЭККт В (&КЭК_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению",
		?(ПараметрыУчета.УчетПоПодразделениям, "ПодразделениеКт В (&Подразделение_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКонтрагентам",
		"СубконтоКт"+ПараметрыУчета.НомераСубконто["Контрагент"]+" В (&Контрагенты_НомерЗапроса)");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДоговорам",
		?(ПараметрыУчета.ДоговорЕстьСубконто,
		"СубконтоКт"+ПараметрыУчета.НомераСубконто["Договор"]+" В (&Договоры_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКонтрагент",
		"ДвиженияДокумента.СубконтоКт"+ПараметрыУчета.НомераСубконто["Контрагент"]);
	Если ПараметрыУчета.ДоговорЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДоговор",
			"ДвиженияДокумента.СубконтоКт"+ПараметрыУчета.НомераСубконто["Договор"]);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДоговор",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	Если ПараметрыУчета.ДопАналитикаЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДопАналитика",
			"ЕСТЬNULL(ДвиженияДокумента.СубконтоКт"+ПараметрыУчета.НомераСубконто["ДопАналитика"] + ", НЕОПРЕДЕЛЕНО)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДопАналитика",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Если НЕ ПараметрыУчета.УчетПоКЭК Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокумента.КЭККт", "ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоКПС Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокумента.КПСКт", "ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоИФО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокумента.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоПодразделениям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокумента.ПодразделениеКт", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ЧастьТекстаЗапросаЗачетАвансаВКорректируемыхДокументах(Множитель, ИспользуемыйСчет)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&ИспользуемыйСчет КАК Счет,
	|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям_НомерЗапроса,
	|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС_НомерЗапроса,
	|	ДвиженияДокумента.ИФО КАК ИФО,
	|	ДвиженияДокумента.КФО КАК КФО,
	|	ДвиженияДокумента.КПСКт КАК КПС,
	|	ДвиженияДокумента.КЭККт КАК КЭК,
	|	ДвиженияДокумента.ПодразделениеКт КАК Подразделение,
	|	&ПолеКонтрагент КАК Контрагент,
	|	&ПолеДоговор КАК Договор,
	|	&ПолеДопАналитика КАК ДопАналитика,
	|	&ДопАналитикаВидСубконто_НомерЗапроса КАК ВидДопСубконтоАвансов,
	|	ЕСТЬNULL(ДвиженияДокумента.ВалютаКт, &ВалютаРеглУчета) КАК Валюта,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|				И ДвиженияДокумента.СчетКт.Валютный
	|			ТОГДА &Множитель * ДвиженияДокумента.ВалютнаяСуммаКт
	|		ИНАЧЕ &Множитель * ДвиженияДокумента.Сумма
	|	КОНЕЦ КАК СуммаРасчетов,
	|	&Множитель * ДвиженияДокумента.Сумма КАК СуммаРуб,
	|	ВЫБОР
	|		КОГДА &УчитыватьЗадолженностьЕНВД
	|				И ДвиженияДокумента.СчетКт.НалоговыйУчетЕНВД
	|			ТОГДА &Множитель * ДвиженияДокумента.СуммаЕНВД
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаЕНВДРуб
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В (&КорректируемыйДокумент)
	|				И &УсловиеСчет
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКПС
	|				И &УсловиеПоКЭК
	|				И &УсловиеПоПодразделению
	|				И &УсловиеПоКонтрагентам
	|				И &УсловиеПоДоговорам
	|				И &УсловиеПоИФО,
	|			,
	|			) КАК ДвиженияДокумента";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Множитель", Множитель);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИспользуемыйСчет", "ДвиженияДокумента." + ИспользуемыйСчет);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаЗачетАвансаВКорректируемыхДокументахДт(ПараметрыУчета, НомерЗапроса)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДвиженияДокумента.СчетДт КАК Счет,
	|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям_НомерЗапроса,
	|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС_НомерЗапроса,
	|	ДвиженияДокумента.ИФО КАК ИФО,
	|	ДвиженияДокумента.КФО КАК КФО,
	|	ДвиженияДокумента.КПСДт КАК КПС,
	|	ДвиженияДокумента.КЭКДт КАК КЭК,
	|	ДвиженияДокумента.ПодразделениеДт КАК Подразделение,
	|	&ПолеКонтрагент КАК Контрагент,
	|	&ПолеДоговор КАК Договор,
	|	&ПолеДопАналитика КАК ДопАналитика,
	|	&ДопАналитикаВидСубконто_НомерЗапроса КАК ВидДопСубконтоАвансов,
	|	ЕСТЬNULL(ДвиженияДокумента.ВалютаДт, &ВалютаРеглУчета) КАК Валюта,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|				И ДвиженияДокумента.СчетКт.Валютный
	|			ТОГДА &Множитель * ДвиженияДокумента.ВалютнаяСуммаДт
	|		ИНАЧЕ &Множитель * ДвиженияДокумента.Сумма
	|	КОНЕЦ КАК СуммаРасчетов,
	|	&Множитель * ДвиженияДокумента.Сумма КАК СуммаРуб,
	|	ВЫБОР
	|		КОГДА &УчитыватьЗадолженностьЕНВД
	|				И ДвиженияДокумента.СчетКт.НалоговыйУчетЕНВД
	|			ТОГДА &Множитель * ДвиженияДокумента.СуммаЕНВД
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаЕНВДРуб
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В (&КорректируемыйДокумент)
	|				И СчетДт В (&Счета_НомерЗапроса)
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКПС
	|				И &УсловиеПоКЭК
	|				И &УсловиеПоПодразделению
	|				И &УсловиеПоКонтрагентам
	|				И &УсловиеПоДоговорам
	|				И &УсловиеПоИФО,
	|			,
	|			) КАК ДвиженияДокумента";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Множитель", -1);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИспользуемыйСчет", "ДвиженияДокумента.СчетДт");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоИФО",
		?(ПараметрыУчета.УчетПоИФО, "ИФО В (&ИФО_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКФО",
		?(НЕ ПараметрыУчета.ПоВсемКФО, "КФО В (&КФО_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКПС",
		?(ПараметрыУчета.УчетПоКПС И НЕ ПараметрыУчета.ПоВсемКПС, "КПСДт В (&КПС_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКЭК",
		?(ПараметрыУчета.УчетПоКЭК, "КЭКДт В (&КЭК_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению",
		?(ПараметрыУчета.УчетПоПодразделениям, "ПодразделениеДт В (&Подразделение_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКонтрагентам",
		"СубконтоДт"+ПараметрыУчета.НомераСубконто["Контрагент"]+" В (&Контрагенты_НомерЗапроса)");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДоговорам",
		?(ПараметрыУчета.ДоговорЕстьСубконто,
		"СубконтоДт"+ПараметрыУчета.НомераСубконто["Договор"]+" В (&Договоры_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКонтрагент",
		"ДвиженияДокумента.СубконтоДт"+ПараметрыУчета.НомераСубконто["Контрагент"]);
	Если ПараметрыУчета.ДоговорЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДоговор",
			"ДвиженияДокумента.СубконтоДт"+ПараметрыУчета.НомераСубконто["Договор"]);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДоговор",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	Если ПараметрыУчета.ДопАналитикаЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДопАналитика",
			"ЕСТЬNULL(ДвиженияДокумента.СубконтоДт"+ПараметрыУчета.НомераСубконто["ДопАналитика"] + ", НЕОПРЕДЕЛЕНО)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДопАналитика",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Если НЕ ПараметрыУчета.УчетПоКЭК Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокумента.КЭКДт", "ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоКПС Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокумента.КПСДт", "ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоИФО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокумента.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоПодразделениям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокумента.ПодразделениеДт", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция КорректируемыеДокументы(Знач КорректируемыйДокумент, Знач НомерКорректировки)
	
	Результат = Новый Массив;
	Результат.Добавить(КорректируемыйДокумент);
	
	Пока НомерКорректировки > 1 Цикл
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КорректируемыйДокумент,
			"ДокументОснование, НомерКорректировки");
		Если Не ЗначениеЗаполнено(КорректируемыйДокумент) Тогда
			Прервать;
		КонецЕсли; 
		КорректируемыйДокумент = ДанныеДокумента.ДокументОснование;
		НомерКорректировки = ДанныеДокумента.НомерКорректировки;
		Если Результат.Найти(КорректируемыйДокумент) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Документ корректируется несколько раз: %1'"), КорректируемыйДокумент);
		КонецЕсли;
		Результат.Добавить(КорректируемыйДокумент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Зачет авансов.

// Структура таблицы расчетов с зачетом авансов.
//
Функция ПустаяТаблицаРасчетовСЗачетомАвансов() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Признак зачета аванса. Устанавливается для строк зачтенных авансов.
	// Остаток суммы расчетов (акта, накладной), оставшийся после зачета всех авансов, добавляется в таблицу последней строкой.
	ПустаяТаблица.Колонки.Добавить("ЭтоЗачетАванса", Новый ОписаниеТипов("Булево"));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",            Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",            Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",            Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение",  Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("КЭК",                   Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СчетАвансов",           Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",            Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",               Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("ДопСубконтоАвансов",    Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	ПустаяТаблица.Колонки.Добавить("ВидДопСубконтоАвансов", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ПустаяТаблица.Колонки.Добавить("Валюта",                Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Суммы расчетов.
	ПустаяТаблица.Колонки.Добавить("ОстатокРасчетов",       ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРасчетов",         ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",              ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРубПоКурсуАванса", ОписаниеТипаСуммы);
	// Для целей налогового учета при УСН.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",          ОписаниеТипаСуммы);
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ВидДоговора",           Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
	ПустаяТаблица.Колонки.Добавить("РасчетыВВалюте",        Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("УчетАгентскогоНДС",     Новый ОписаниеТипов("Булево"));

	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу расчетов с зачетом авансов.
//
Функция ТаблицаРасчетовСЗачетомАвансов(ТаблицаДокумента, ТаблицаЗачетАвансовПоДокументу = Неопределено, Реквизиты, Отказ) Экспорт
	
	ТаблицаРасчетов = ПустаяТаблицаРасчетовСЗачетомАвансов();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("УчитыватьЗадолженностьЕНВД",       УчетнаяПолитика.ПрименяетсяУСН И УчетнаяПолитика.ПлательщикЕНВД);
	
	Если НЕ Реквизиты.Свойство("СпособЗачетаАванса") ИЛИ НЕ ЗначениеЗаполнено(Реквизиты.СпособЗачетаАванса) Тогда
		Реквизиты.Вставить("СпособЗачетаАванса", Перечисления.СпособыЗачетаАвансов.Автоматически);
	КонецЕсли;
	Если НЕ Реквизиты.Свойство("ПоВсемКФО") Тогда
		Реквизиты.Вставить("ПоВсемКФО", Ложь);
	КонецЕсли;
	Если НЕ Реквизиты.Свойство("ПоВсемКПС") Тогда
		Реквизиты.Вставить("ПоВсемКПС", Ложь);
	КонецЕсли;
	Если НЕ Реквизиты.Свойство("ВидДеятельностиУСН") Тогда
		Реквизиты.Вставить("ВидДеятельностиУСН", Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения);
	КонецЕсли;
	
	ДобавитьСлужебныеКолонкиРасчетовСКонтрагентами(ТаблицаДокумента, Реквизиты);
	ДобавитьСлужебныеКолонкиРасчетовСКонтрагентами(ТаблицаЗачетАвансовПоДокументу, Реквизиты);
	
	ПроверитьКорректностьНастройкиСчетовРасчетов(ТаблицаДокумента, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		// При поступлении ценностей по договору, по которому организация выступает налоговым агентом по НДС,
		// сумма расчетов не включает НДС, т.к. сумма НДС оплачивается в налоговую инспекцию, а не поставщику.
		Если СтрокаДокумента.ЭтоПоступление И СтрокаДокумента.УчетАгентскогоНДС Тогда
			
			СтрокаДокумента.СуммаРасчетов = СтрокаДокумента.СуммаРасчетов - СтрокаДокумента.СуммаНДС;
			
			КурсДокумента = ?(СтрокаДокумента.Кратность = 0, СтрокаДокумента.Курс,
								СтрокаДокумента.Курс / СтрокаДокумента.Кратность);
			СтрокаДокумента.СуммаРуб = СтрокаДокумента.СуммаРуб - Окр(СтрокаДокумента.СуммаНДС * КурсДокумента, 2);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Подготовим таблицу остатков авансов.
	Если Реквизиты.Свойство("ПериодОстатков") Тогда // Период остатков указан явно.
		ПериодОстатков = Реквизиты.ПериодОстатков;
	ИначеЕсли Не ЗначениеЗаполнено(Реквизиты.Ссылка) Тогда // Новый документ.
		ПериодОстатков = Новый Граница(КонецДня(Реквизиты.Дата), ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	ОстаткиАвансов = ОстаткиАвансов(ПериодОстатков, ТаблицаДокумента, Реквизиты);
	
	Если Реквизиты.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.ПоДокументу Тогда
		
		Для Каждого СтрокаДокумента Из ТаблицаЗачетАвансовПоДокументу Цикл
			
			НераспределенныйОстаток = СтрокаДокумента.СуммаРасчетов;
			
			Если ОстаткиАвансов.Количество() > 0 Тогда
			
				Отбор = НовыйОтборАвансов(СтрокаДокумента.СчетАвансов, СтрокаДокумента, Реквизиты);
				Если ЗначениеЗаполнено(СтрокаДокумента.ДокументАванса) Тогда
					Отбор.Вставить("ВидДопСубконтоАвансов", ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов);
				КонецЕсли;
				Отбор.Вставить("ДопСубконтоАвансов",    СтрокаДокумента.ДокументАванса);
				НайденныеОстаткиАвансов = ОстаткиАвансов.НайтиСтроки(Отбор);
				
				ДобавитьСтрокиЗачтенныхАвансов(
					ТаблицаРасчетов,
					НераспределенныйОстаток,
					НайденныеОстаткиАвансов,
					СтрокаДокумента,
					Реквизиты);
				
				Если СтрокаДокумента.СчетАвансов <> СтрокаДокумента.СчетРасчетов
				И Не БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетАвансов, "АП") Тогда
				
					// Зачет остатков долга ("аванса"), образовавшихся на счете расчетов, например, при возвратах.
					Отбор = НовыйОтборАвансов(СтрокаДокумента.СчетРасчетов, СтрокаДокумента, Реквизиты);
					НайденныеОстаткиАвансов = ОстаткиАвансов.НайтиСтроки(Отбор);
					
					ДобавитьСтрокиЗачтенныхАвансов(
						ТаблицаРасчетов,
						НераспределенныйОстаток,
						НайденныеОстаткиАвансов,
						СтрокаДокумента,
						Реквизиты);
				
				КонецЕсли;
				
			КонецЕсли;
			
			// При зачете авансов "по документу" нераспределенный остаток означает,
			// что указанная сумма зачета превышает остаток аванса.
			Если НераспределенныйОстаток > 0 Тогда
				
				ТекстОшибки = НСтр("ru='Указана сумма зачета, превышающая остаток незачтенного аванса.
					|
					|Документ аванса: ""%1""
					|Указана сумма зачета: %2 %3; Остаток аванса: %4 %3; Превышение: %5 %3'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					СтрокаДокумента.ДокументАванса,
					СтрокаДокумента.СуммаРасчетов,
					СтрокаДокумента.Валюта,
					СтрокаДокумента.СуммаРасчетов - НераспределенныйОстаток,
					НераспределенныйОстаток);
				
				ПолеСуммаЗачета = "ЗачетАвансов[" + Формат(СтрокаДокумента.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СуммаЗачета";
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, ПолеСуммаЗачета, "Объект", Отказ);
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Сумму расчетов, оставшуюся после зачета всех авансов, добавляем отдельной строкой.
		Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
			
			Отбор = Новый Структура("ЭтоПоступление,ИФО,КФО,КПС,Подразделение,СчетРасчетов,СчетАвансов,Контрагент,Договор,Валюта");
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
			ЗачетноАвансов = ТаблицаЗачетАвансовПоДокументу.Скопировать(Отбор);
			
			ДобавитьСтрокуЗадолженности(
				ТаблицаРасчетов,
				СтрокаДокумента.СуммаРасчетов - ЗачетноАвансов.Итог("СуммаРасчетов"),
				СтрокаДокумента,
				Реквизиты);
			
		КонецЦикла;
		
	Иначе // Автоматически или НеЗачитывать
		
		ДетальныеКЭК440 = ПолучитьДетальныеКЭК440();
		
		Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
			
			НераспределенныйОстаток = СтрокаДокумента.СуммаРасчетов;
			
			Если Реквизиты.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически
			   И ОстаткиАвансов.Количество() > 0 Тогда
			
				Отбор = НовыйОтборАвансов(СтрокаДокумента.СчетАвансов, СтрокаДокумента, Реквизиты);
				НайденныеОстаткиАвансов = ОстаткиАвансов.НайтиСтроки(Отбор);
				
				Если НайденныеОстаткиАвансов.Количество() = 0
					И ДетальныеКЭК440.Получить(
						ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отбор, "КЭК")) <> Неопределено Тогда
					// Если не найдены авансы по детальному КЭК, нужно проверить авансы по групповому КЭК
					Отбор.КЭК = БухгалтерскийУчетПовтИсп.КЭКпоКоду("440");
					НайденныеОстаткиАвансов = ОстаткиАвансов.НайтиСтроки(Отбор);
				КонецЕсли;
				
				ДобавитьСтрокиЗачтенныхАвансов(
					ТаблицаРасчетов,
					НераспределенныйОстаток,
					НайденныеОстаткиАвансов,
					СтрокаДокумента,
					Реквизиты);
				
				Если СтрокаДокумента.СчетАвансов <> СтрокаДокумента.СчетРасчетов
				И Не БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетАвансов, "АП") Тогда
				
					// Зачет остатков долга ("аванса"), образовавшихся на счете расчетов, например, при возвратах.
					Отбор = НовыйОтборАвансов(СтрокаДокумента.СчетРасчетов, СтрокаДокумента, Реквизиты);
					НайденныеОстаткиАвансов = ОстаткиАвансов.НайтиСтроки(Отбор);
					
					ДобавитьСтрокиЗачтенныхАвансов(
						ТаблицаРасчетов,
						НераспределенныйОстаток,
						НайденныеОстаткиАвансов,
						СтрокаДокумента,
						Реквизиты);
				
				КонецЕсли;
				
			КонецЕсли;
			
			// Сумму расчетов, оставшуюся после зачета всех авансов, добавляем отдельной строкой.
			ДобавитьСтрокуЗадолженности(
				ТаблицаРасчетов,
				НераспределенныйОстаток,
				СтрокаДокумента,
				Реквизиты);
			
		КонецЦикла;
	
	КонецЕсли;
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

Функция ПолучитьДетальныеКЭК440()
	Результат = Новый Соответствие;
	Результат.Вставить(БухгалтерскийУчетПовтИсп.КЭКпоКоду("441"), Истина);
	Результат.Вставить(БухгалтерскийУчетПовтИсп.КЭКпоКоду("442"), Истина);
	Результат.Вставить(БухгалтерскийУчетПовтИсп.КЭКпоКоду("443"), Истина);
	Результат.Вставить(БухгалтерскийУчетПовтИсп.КЭКпоКоду("444"), Истина);
	Результат.Вставить(БухгалтерскийУчетПовтИсп.КЭКпоКоду("445"), Истина);
	Результат.Вставить(БухгалтерскийУчетПовтИсп.КЭКпоКоду("446"), Истина);
	Возврат Результат;
КонецФункции

Функция НовыйОтборАвансов(СчетАвансов, СтрокаДокумента, Реквизиты)
	
	Отбор = Новый Структура("СчетАвансов,Контрагент",
		СчетАвансов, СтрокаДокумента.Контрагент);
	
	Если ЗначениеЗаполнено(СтрокаДокумента.Договор)
	   И БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(СчетАвансов) Тогда
		Отбор.Вставить("Договор", СтрокаДокумента.Договор);
	КонецЕсли;
	
	СвойстваСчетаАвансов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетАвансов);
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		Отбор.Вставить("ИФО", СтрокаДокумента.ИФО);
	КонецЕсли;
	Если НЕ Реквизиты.ПоВсемКФО Тогда
		Отбор.Вставить("КФО",СтрокаДокумента.КФО);
	КонецЕсли;
	Если СвойстваСчетаАвансов.УчетПоКПС И НЕ Реквизиты.ПоВсемКПС Тогда
		Отбор.Вставить("КПС", СтрокаДокумента.КПС);
	КонецЕсли;
	
	ЭтоЗабалансовыйСчетАвансовПолученных = БухгалтерскийУчет.СчетВИерархии(СчетАвансов, "АП");
	
	Если Реквизиты.ИспользоватьУчетПоПодразделениям Тогда
		Если ЭтоЗабалансовыйСчетАвансовПолученных Тогда
			// По забалансовому счету авансов полученных АП отбираем остатки по подразделениям,
			// только если на счете расчетов ведется учет по подразделениям.
			СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаДокумента.СчетРасчетов);
			Если СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
				Отбор.Вставить("Подразделение", СтрокаДокумента.Подразделение);
			КонецЕсли;
		Иначе
			Если СвойстваСчетаАвансов.УчетПоПодразделениям Тогда
				Отбор.Вставить("Подразделение", СтрокаДокумента.Подразделение);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Реквизиты.ИспользоватьВалютныйУчет Тогда
		Отбор.Вставить("Валюта", СтрокаДокумента.Валюта);
	КонецЕсли;
	
	// Отбор остатков по КЭК выполняется только для авансов полученных на забалансовом счете АП.
	// На остальных счетах КЭК либо не используются, либо используются КЭК "Увеличение/уменьшение задолженности".
	Если ЭтоЗабалансовыйСчетАвансовПолученных Тогда
		Отбор.Вставить("КЭК", СтрокаДокумента.КЭК);
	КонецЕсли;
	
	Возврат Отбор;
	
КонецФункции

Процедура ДобавитьСтрокиЗачтенныхАвансов(ТаблицаРасчетов, НераспределеннаяСумма, ОстаткиАвансов, СтрокаДокумента, Реквизиты)

	ЕстьКолонкиНомераСтроки = (ТаблицаРасчетов.Колонки.Найти("ИмяСписка") <> Неопределено)
							И (ТаблицаРасчетов.Колонки.Найти("СинонимСписка") <> Неопределено)
							И (ТаблицаРасчетов.Колонки.Найти("НомерСтроки") <> Неопределено);
	
	Знак = ?(СтрокаДокумента.ЭтоПоступление, +1, -1);
	
	Для Каждого СтрокаОстатка Из ОстаткиАвансов Цикл

		Если НераспределеннаяСумма <= 0 Тогда
			Прервать;
		КонецЕсли;

		ЗачитываемыйАванс = Мин(НераспределеннаяСумма, Знак * СтрокаОстатка.СуммаРасчетов);
		Если ЗачитываемыйАванс <= 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаРасчетов = ТаблицаРасчетов.Добавить();
		СтрокаРасчетов.ЭтоЗачетАванса = Истина;

		ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаОстатка,
			"ИФО,КФО,КПС,КЭК,Подразделение,Валюта,
			|СчетАвансов,Контрагент,Договор,ДопСубконтоАвансов,ВидДопСубконтоАвансов");

		ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаДокумента,
			"СчетРасчетов,ВидДоговора,РасчетыВВалюте,УчетАгентскогоНДС"
			+ ?(ЕстьКолонкиНомераСтроки, ",ИмяСписка,СинонимСписка,НомерСтроки", ""));

		СтрокаРасчетов.ОстатокРасчетов = Знак * СтрокаОстатка.СуммаРасчетов;
		СтрокаРасчетов.СуммаРасчетов   = ЗачитываемыйАванс;

		КоэффициентКурсаАванса = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаОстатка.СуммаРасчетов = 0, 0, СтрокаОстатка.СуммаРуб / СтрокаОстатка.СуммаРасчетов));

		КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаДокумента.СуммаРасчетов = 0, 0, СтрокаДокумента.СуммаРуб / СтрокаДокумента.СуммаРасчетов));

		СтрокаРасчетов.СуммаРубПоКурсуАванса = Окр(ЗачитываемыйАванс * КоэффициентКурсаАванса, 2);
		СтрокаРасчетов.СуммаРуб              = Окр(ЗачитываемыйАванс * КоэффициентРуб, 2);

		Если Реквизиты.УчитыватьЗадолженностьЕНВД Тогда

			Если ЗачитываемыйАванс = Знак * СтрокаОстатка.СуммаРасчетов Тогда
				СтрокаРасчетов.СуммаЕНВДРуб = Знак * СтрокаОстатка.СуммаЕНВДРуб;
			Иначе
				СтрокаРасчетов.СуммаЕНВДРуб = Окр(СтрокаОстатка.СуммаЕНВДРуб * (ЗачитываемыйАванс / СтрокаОстатка.СуммаРасчетов), 2);
			КонецЕсли;

			СтрокаОстатка.СуммаЕНВДРуб = СтрокаОстатка.СуммаЕНВДРуб - Знак * СтрокаРасчетов.СуммаЕНВДРуб;

		КонецЕсли;

		НераспределеннаяСумма = НераспределеннаяСумма - ЗачитываемыйАванс;

		СтрокаОстатка.СуммаРасчетов = СтрокаОстатка.СуммаРасчетов - Знак * СтрокаРасчетов.СуммаРасчетов;
		СтрокаОстатка.СуммаРуб      = СтрокаОстатка.СуммаРуб      - Знак * СтрокаРасчетов.СуммаРубПоКурсуАванса;

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтрокуЗадолженности(ТаблицаРасчетов, НераспределеннаяСумма, СтрокаДокумента, Реквизиты)

	Если НераспределеннаяСумма <= 0 И СтрокаДокумента.СуммаРасчетов >= 0 Тогда
		Возврат;
	КонецЕсли;

	ЕстьКолонкиНомераСтроки = (ТаблицаРасчетов.Колонки.Найти("ИмяСписка") <> Неопределено)
							И (ТаблицаРасчетов.Колонки.Найти("СинонимСписка") <> Неопределено)
							И (ТаблицаРасчетов.Колонки.Найти("НомерСтроки") <> Неопределено);
	
	СтрокаРасчетов = ТаблицаРасчетов.Добавить();
	СтрокаРасчетов.ЭтоЗачетАванса = Ложь;

	ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаДокумента,
		"ИФО,КФО,КПС,КЭК,Подразделение,СчетРасчетов,СчетАвансов,Контрагент,Договор,Валюта,
		|ВидДоговора,РасчетыВВалюте,УчетАгентскогоНДС"
		+ ?(ЕстьКолонкиНомераСтроки, ",ИмяСписка,СинонимСписка,НомерСтроки", ""));

	СтрокаРасчетов.СуммаРасчетов = НераспределеннаяСумма;

	КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
		?(СтрокаДокумента.СуммаРасчетов = 0, 0, СтрокаДокумента.СуммаРуб / СтрокаДокумента.СуммаРасчетов));

	СтрокаРасчетов.СуммаРуб              = Окр(НераспределеннаяСумма * КоэффициентРуб, 2);
	СтрокаРасчетов.СуммаРубПоКурсуАванса = СтрокаРасчетов.СуммаРуб;

	Если Реквизиты.УчитыватьЗадолженностьЕНВД
	   И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаДокумента.КФО)
	   И Реквизиты.ВидДеятельностиУСН = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда

		СтрокаРасчетов.СуммаЕНВДРуб = СтрокаРасчетов.СуммаРуб;

	КонецЕсли;

КонецПроцедуры



// Расчеты по оплате труда.

// Подготавливает таблицу документа (в унифицированном формате) для отражения расчетов по оплате труда.
//
Функция ПодготовитьТаблицуРасчетовПоОплатеТрудаПоДокументу(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ТаблицаРасчетов = Новый ТаблицаЗначений;
	// Признак поступления ценностей: материальных запасов, услуг и пр.
	ТаблицаРасчетов.Колонки.Добавить("ЭтоПоступление", Новый ОписаниеТипов("Булево"));
	// Общие разрезы учета.
	ТаблицаРасчетов.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаРасчетов.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаРасчетов.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаРасчетов.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета расчетов с контрагентами.
	ТаблицаРасчетов.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаРасчетов.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаРасчетов.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаРасчетов.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаРасчетов.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Суммовые показатели операции.
	ТаблицаРасчетов.Колонки.Добавить("СуммаРасчетов", ОписаниеТипаСуммы);
	
	МетаданныеДокумента = Документ.Метаданные();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если МетаданныеДокумента.Имя = "ОтражениеЗарплатыВУчете" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Операции",
			"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,
			|ВидОперации,ОсновнойКонтрагент,Контрагент,Договор,ВалютаДокумента,Сумма",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""Операции"" КАК ИмяСписка,
		|	""Операции"" КАК СинонимСписка,
		|	Операции.НомерСтроки КАК НомерСтроки,
		|	Операции.ИФО КАК ИФО,
		|	Операции.КФО КАК КФО,
		|	Операции.КПС КАК КПС,
		|	Операции.КЭК КАК КЭК,
		|	Операции.Подразделение КАК Подразделение,
		|	Операции.ВидОперации.Код КАК ВидОперации,
		|	ВЫБОР
		|		КОГДА Операции.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|			ТОГДА Операции.ОсновнойКонтрагент
		|		ИНАЧЕ Операции.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА Операции.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		|		ИНАЧЕ Операции.Договор
		|	КОНЕЦ КАК Договор,
		|	Операции.ВалютаДокумента КАК Валюта,
		|	Операции.Сумма КАК Сумма
		|ИЗ
		|	ТаблицаОперации КАК Операции
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		РасчетыПоОплатеТруда = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаДокумента Из РасчетыПоОплатеТруда Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаДокумента.Контрагент) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru = 'Контрагент'"), СтрокаДокумента.НомерСтроки, СтрокаДокумента.СинонимСписка);
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1.
						|Если учет расчетов с персоналом ведется сводно по всем работникам, необходимо указать основного контрагента.'"),
						ТекстСообщения);
				ПолеКолонки = "Объект." + СтрокаДокумента.ИмяСписка + "[" + Формат(СтрокаДокумента.НомерСтроки-1, "ЧН=0; ЧГ=") + "].Контрагент";
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
			КонецЕсли;
			
			ЭтоНачисление = (Найти(СтрокаДокумента.ВидОперации, "Начисление") > 0);
			ЭтоУдержания  = (Найти(СтрокаДокумента.ВидОперации, "Удержания")  > 0);
			
			Если ЭтоНачисление Тогда
				
				НоваяСтрока = ТаблицаРасчетов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
				НоваяСтрока.ЭтоПоступление = Истина;
				
				НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
					СтрокаДокумента.КЭК, "302.00", , Документ.Дата, Документ.Организация, СтрокаДокумента.ИФО);
				
				НоваяСтрока.СуммаРасчетов = СтрокаДокумента.Сумма;
				
			ИначеЕсли ЭтоУдержания Тогда
				
				НоваяСтрока = ТаблицаРасчетов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
				НоваяСтрока.ЭтоПоступление = Истина;
				
				НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
					СтрокаДокумента.КЭК, "302.00", , Документ.Дата, Документ.Организация, СтрокаДокумента.ИФО);
				
				НоваяСтрока.СуммаРасчетов = - СтрокаДокумента.Сумма;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаРасчетов.Свернуть("ЭтоПоступление,ИФО,КФО,КПС,Подразделение,КЭК,СчетРасчетов,Контрагент,Договор,Валюта", "СуммаРасчетов");
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

// Структура таблицы расчетов по оплате труда.
//
Функция ПустаяТаблицаРасчетовПоОплатеТруда() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Признак зачета аванса. Устанавливается для строк зачтенных авансов.
	// Остаток платежа, оставшийся после зачета всех авансов, добавляется в таблицу последней строкой.
	ПустаяТаблица.Колонки.Добавить("ЭтоЗачетАванса", Новый ОписаниеТипов("Булево"));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",            Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",            Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",            Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение",  Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("КЭК",                   Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СчетАвансов",           Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",            Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",               Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("ДопСубконтоАвансов",    Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	ПустаяТаблица.Колонки.Добавить("ВидДопСубконтоАвансов", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ПустаяТаблица.Колонки.Добавить("Валюта",                Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Суммы расчетов.
	ПустаяТаблица.Колонки.Добавить("ОстатокРасчетов",       ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРасчетов",         ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",              ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРубПоКурсуАванса", ОписаниеТипаСуммы);
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ВидДоговора",           Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
	ПустаяТаблица.Колонки.Добавить("РасчетыВВалюте",        Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("УчетАгентскогоНДС",     Новый ОписаниеТипов("Булево"));

	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу расчетов по оплате труда.
//
Функция ТаблицаРасчетовПоОплатеТруда(ТаблицаДокумента, Реквизиты, Отказ) Экспорт
	
	ТаблицаРасчетов = ПустаяТаблицаРасчетовПоОплатеТруда();
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("УчитыватьЗадолженностьЕНВД",       Ложь);
	
	ДобавитьСлужебныеКолонкиРасчетовСКонтрагентами(ТаблицаДокумента, Реквизиты);
	
	// Подготовим таблицу остатков авансов.
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	ОстаткиАвансов = ОстаткиАвансов(ПериодОстатков, ТаблицаДокумента, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		НераспределенныйОстаток = СтрокаДокумента.СуммаРасчетов;
		
		Если ОстаткиАвансов.Количество() > 0 Тогда
		
			Отбор = НовыйОтборАвансов(СтрокаДокумента.СчетАвансов, СтрокаДокумента, Реквизиты);
			НайденныеОстаткиАвансов = ОстаткиАвансов.НайтиСтроки(Отбор);
			
			ДобавитьСтрокиЗачтенныхАвансов(
				ТаблицаРасчетов,
				НераспределенныйОстаток,
				НайденныеОстаткиАвансов,
				СтрокаДокумента,
				Реквизиты);
			
			Если СтрокаДокумента.СчетАвансов <> СтрокаДокумента.СчетРасчетов Тогда
			
				// Зачет остатков долга ("аванса"), образовавшихся на счете расчетов.
				Отбор = НовыйОтборАвансов(СтрокаДокумента.СчетРасчетов, СтрокаДокумента, Реквизиты);
				НайденныеОстаткиАвансов = ОстаткиАвансов.НайтиСтроки(Отбор);
				
				ДобавитьСтрокиЗачтенныхАвансов(
					ТаблицаРасчетов,
					НераспределенныйОстаток,
					НайденныеОстаткиАвансов,
					СтрокаДокумента,
					Реквизиты);
			
			КонецЕсли;
			
		КонецЕсли;
		
		// Сумму расчетов, оставшуюся после зачета всех авансов, добавляем отдельной строкой.
		ДобавитьСтрокуЗадолженности(
			ТаблицаРасчетов,
			НераспределенныйОстаток,
			СтрокаДокумента,
			Реквизиты);
		
	КонецЦикла;
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

#КонецОбласти

