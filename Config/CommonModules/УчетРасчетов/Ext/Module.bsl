Функция ПустаяТаблицаПоступлениеУслугРаботПоСчетамЗатрат() Экспорт

	ОписаниеТиповСубконто  = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ПустаяТаблица = ПустаяТаблицаПоступлениеУслугРабот();
	
	// Счет и аналитика учета услуг, работ.
	ПустаяТаблица.Колонки.Добавить("СчетЗатрат", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатрат1", ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатрат2", ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатрат3", ОписаниеТиповСубконто);
	
	ПустаяТаблица.Колонки.Добавить("ОтражатьВНалоговомУчете", Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("СчетЗатратНУ", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатратНУ1", ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатратНУ2", ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатратНУ3", ОписаниеТиповСубконто);
	
	Возврат ПустаяТаблица;

