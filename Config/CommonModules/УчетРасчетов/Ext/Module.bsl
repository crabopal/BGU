// Формирует таблицу источника данных "Реализация услуг, работ".
//
Функция ТаблицаРеализацияУслугРабот(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов=Неопределено, Реквизиты, Отказ) Экспорт
	
	ТаблицаРеализация = ПустаяТаблицаРеализацияУслугРабот();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаРеализация;
	КонецЕсли;
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	УчетРасчетов.РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СтрокаСписание = ТаблицаРеализация.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписание, СтрокаДокумента);
		
		СтрокаСписание.СуммаВал    = СтрокаДокумента.Сумма;
		СтрокаСписание.СуммаНДСВал = СтрокаДокумента.СуммаНДС;
		
	КонецЦикла;
	
	Возврат ТаблицаРеализация;
	
КонецФункции

