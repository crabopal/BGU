
#Область СлужебныйПрограммныйИнтерфейс

// Данные счетов учета МЗ.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ТолькоБалансовые - Булево
//  Включать106 - Булево - Включать106
//  Включать113 - Булево - Включать113
//  Включать108 - Булево - Включать108
// 
// Возвращаемое значение:
//  см. УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов
Функция ДанныеСчетовУчетаМЗ(Организация, ТолькоБалансовые, Включать106 = ЛОЖЬ, Включать113 = Ложь, Включать108 = Ложь) Экспорт
	ПараметрыДанныхСчетов = УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ(Организация, ТолькоБалансовые);
	ПараметрыДанныхСчетов.Включать106 = Включать106;
	ПараметрыДанныхСчетов.Включать108 = Включать108;
	ПараметрыДанныхСчетов.Включать113 = Включать113;
	Возврат УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов);
КонецФункции

Функция СчетаУчетаМатериальныхЗапасов() Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счет105", БухгалтерскийУчет.СписокСчетов("105.00"));
	Запрос.УстановитьПараметр("Счет113", БухгалтерскийУчет.СписокСчетов("113.00"));
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка КАК СчетМЗ,
	               |	ЕПСБУ107.Ссылка КАК СчетВПути,
	               |	ЕПСБУ.Код КАК СчетМЗКод,
	               |	ЕПСБУ107.Код КАК СчетВПутиКод
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоМЗ
	               |		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконтоМЗ.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоЦМО
	               |		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконтоЦМО.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ107
	               |		ПО (ЕПСБУ107.Код = ""107."" + ПОДСТРОКА(ЕПСБУ.Код, 5, 1) + ""3"")
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В(&Счет105)
	               |	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	               |	И ЕПСБУВидыСубконтоМЗ.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	               |	И ЕПСБУВидыСубконтоЦМО.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО)
	               |	И ПОДСТРОКА(ЕПСБУ.Код, 6, 1) <> ""8""
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка,
	               |	ЕПСБУ107.Ссылка,
	               |	ЕПСБУ.Код,
	               |	ЕПСБУ107.Код
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУРодитель
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ107
	               |			ПО (ЕПСБУ107.Код = ""107."" + ПОДСТРОКА(ЕПСБУРодитель.Код, 5, 1) + ""3"")
	               |		ПО ЕПСБУ.Родитель = ЕПСБУРодитель.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоМЗ
	               |		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконтоМЗ.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоЦМО
	               |		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконтоЦМО.Ссылка
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В(&Счет105)
	               |	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	               |	И ЕПСБУВидыСубконтоМЗ.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	               |	И ЕПСБУВидыСубконтоЦМО.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО)
	               |	И ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""8""
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка КАК СчетМЗ,
	               |	ЕПСБУ107.Ссылка КАК СчетВПути,
	               |	ЕПСБУ.Код КАК СчетМЗКод,
	               |	ЕПСБУ107.Код КАК СчетВПутиКод
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоМЗ
	               |		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконтоМЗ.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоЦМО
	               |		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконтоЦМО.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ107
	               |		ПО (ЕПСБУ107.Код = ""107."" + ПОДСТРОКА(ЕПСБУ.Код, 5, 1) + ""4"")
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В(&Счет113)
	               |	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	               |	И ЕПСБУВидыСубконтоМЗ.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	               |	И ЕПСБУВидыСубконтоЦМО.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО)
	               |";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // СчетаУчетаМатериальныхЗапасов()

// Счет в пути по счету учета МЗ.
// 
// Параметры:
//  СчетУчетаМЗ - ПланСчетовСсылка.ЕПСБУ
//              - Строка
// 
// Возвращаемое значение:
//  ПланСчетовСсылка.ЕПСБУ - Счет в пути по счету учета МЗ
Функция СчетВПутиПоСчетуУчетаМЗ(Знач СчетУчетаМЗ) Экспорт

	Если ТипЗнч(СчетУчетаМЗ) = Тип("Строка") Тогда
		СчетУчетаМЗ = БухгалтерскийУчет.СчетПоКоду(СчетУчетаМЗ);
		Если Не ЗначениеЗаполнено(СчетУчетаМЗ) Тогда
			Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;

	СчетаУчета = УправлениеМатериальнымиЗапасамиПовтИсп.СчетаУчетаМатериальныхЗапасов();
	СтрокаСчета = СчетаУчета.Найти(СчетУчетаМЗ, "СчетМЗ");
	Если СтрокаСчета = Неопределено Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	Иначе
		Возврат СтрокаСчета.СчетВПути;
	КонецЕсли;

КонецФункции // СчетВПутиПоСчетуУчетаМЗ()

Функция ПолучитьВидыДополнительнойАналитикиУчетаМЗ() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУВидыСубконто.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСубконтоНоменклатура,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСубконтоЦМО,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСубконтоПартии,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|					И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО)
	|					И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСубконтоДоп,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|					И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО)
	|					И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии)
	|				ТОГДА ЕПСБУВидыСубконто.НомерСтроки
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК НомерСубконтоДоп,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|				ТОГДА ЕПСБУВидыСубконто.НомерСтроки
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК НомерСубконтоКонтрагенты
	|ПОМЕСТИТЬ СчетаУчетаМЗ
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУВидыСубконто.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаУчетаМЗ.Ссылка КАК СчетУчета,
	|	ЕПСБУВидыСубконто.ВидСубконто КАК ВидДополнительнойАналитики
	|ИЗ
	|	СчетаУчетаМЗ КАК СчетаУчетаМЗ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО СчетаУчетаМЗ.НомерСубконтоДоп = ЕПСБУВидыСубконто.НомерСтроки
	|			И СчетаУчетаМЗ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|ГДЕ
	|	СчетаУчетаМЗ.Ссылка.ТипСчета <> ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Налоговый)
	|	И СчетаУчетаМЗ.ЕстьСубконтоНоменклатура = ИСТИНА
	|	И СчетаУчетаМЗ.ЕстьСубконтоДоп = ИСТИНА
	|	И НЕ СчетаУчетаМЗ.Ссылка В (&СчетаДопАналитикаКонтрагенты)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СчетаУчетаМЗ.Ссылка,
	|	ЕПСБУВидыСубконто.ВидСубконто
	|ИЗ
	|	СчетаУчетаМЗ КАК СчетаУчетаМЗ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО СчетаУчетаМЗ.НомерСубконтоКонтрагенты = ЕПСБУВидыСубконто.НомерСтроки
	|			И СчетаУчетаМЗ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|ГДЕ
	|	СчетаУчетаМЗ.Ссылка.ТипСчета <> ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Налоговый)
	|	И СчетаУчетаМЗ.ЕстьСубконтоНоменклатура = ИСТИНА
	|	И СчетаУчетаМЗ.Ссылка В(&СчетаДопАналитикаКонтрагенты)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СчетаУчетаМЗ.Ссылка,
	|	ЕПСБУВидыСубконто.ВидСубконто
	|ИЗ
	|	СчетаУчетаМЗ КАК СчетаУчетаМЗ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО СчетаУчетаМЗ.НомерСубконтоДоп = ЕПСБУВидыСубконто.НомерСтроки
	|			И СчетаУчетаМЗ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|ГДЕ
	|	СчетаУчетаМЗ.Ссылка В(&СчетаНУ)
	|	И СчетаУчетаМЗ.ЕстьСубконтоНоменклатура = ИСТИНА
	|	И СчетаУчетаМЗ.ЕстьСубконтоДоп = ИСТИНА";
	
	Запрос.УстановитьПараметр("СчетаНУ", БухгалтерскийУчет.СписокСчетов("Н10,Н41.01,Н43"));
	Запрос.УстановитьПараметр("СчетаДопАналитикаКонтрагенты", БухгалтерскийУчет.СписокСчетов("27.02"));
	
	ВидыДополнительнойАналитики = Новый Соответствие;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВидыДополнительнойАналитики.Вставить(Выборка.СчетУчета, Выборка.ВидДополнительнойАналитики);
	КонецЦикла;
	
	Возврат Новый ФиксированноеСоответствие(ВидыДополнительнойАналитики);
	
КонецФункции

Функция ПолучитьВидыДополнительногоСубконтоУчетаМЗ() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУВидыСубконто.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСубконтоКонтрагенты,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСубконтоНоменклатура,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|					И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|					И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСубконтоДоп,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|					И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|					И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии)
	|				ТОГДА ЕПСБУВидыСубконто.НомерСтроки
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК НомерСубконтоДоп
	|ПОМЕСТИТЬ СчетаУчетаМЗ
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУВидыСубконто.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаУчетаМЗ.Ссылка КАК СчетУчета,
	|	ЕПСБУВидыСубконто.ВидСубконто КАК ВидДополнительногоСубконто
	|ИЗ
	|	СчетаУчетаМЗ КАК СчетаУчетаМЗ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО СчетаУчетаМЗ.НомерСубконтоДоп = ЕПСБУВидыСубконто.НомерСтроки
	|			И СчетаУчетаМЗ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|ГДЕ
	|	СчетаУчетаМЗ.Ссылка.ТипСчета <> ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Налоговый)
	|	И СчетаУчетаМЗ.ЕстьСубконтоНоменклатура
	|	И СчетаУчетаМЗ.ЕстьСубконтоКонтрагенты
	|	И СчетаУчетаМЗ.ЕстьСубконтоДоп
	|	И СчетаУчетаМЗ.Ссылка В(&СчетаДопАналитикаКонтрагенты)";
	
	Запрос.УстановитьПараметр("СчетаДопАналитикаКонтрагенты", БухгалтерскийУчет.СписокСчетов("27.02"));

	ВидыДополнительногоСубконто = Новый Соответствие;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВидыДополнительногоСубконто.Вставить(Выборка.СчетУчета, Выборка.ВидДополнительногоСубконто);
	КонецЦикла;
	
	Возврат Новый ФиксированноеСоответствие(ВидыДополнительногоСубконто);
	
КонецФункции

// Свойства счета для учета МЗ.
// 
// Параметры:
//  Счет - ПланСчетовСсылка.ЕПСБУ -
//  ДопАналитикаВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто -
//  ДопИзмерениеВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто -
//  ПартияВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто -
// 
// Возвращаемое значение:
//  Структура - Свойства счета для учета МЗ:
// * УчетПоКПС - Булево -
// * УчетПоПодразделениям - Булево -
// * ДопАналитикаЕстьСубконто - Булево -
// * ДопАналитикаСуммовой - Булево -
// * ДопАналитикаКоличественный - Булево -
// * ДопАналитикаОбязательный - Булево -
// * ДопАналитикаТолькоОбороты - Булево -
// * ДопИзмерениеЕстьСубконто - Булево -
// * ДопИзмерениеСуммовой - Булево -
// * ДопИзмерениеКоличественный - Булево -
// * ДопИзмерениеОбязательный - Булево -
// * ДопИзмерениеТолькоОбороты - Булево -
// * ПартияЕстьСубконто - Булево -
// * ПартияСуммовой - Булево -
// * ПартияКоличественный - Булево -
// * ПартияОбязательный - Булево -
// * ПартияТолькоОбороты - Булево -
Функция СвойстваСчетаДляУчетаМЗ(Счет, ДопАналитикаВидСубконто, ДопИзмерениеВидСубконто, ПартияВидСубконто) Экспорт
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
	Результат = Новый Структура;
	Результат.Вставить("УчетПоКПС", СвойстваСчета.УчетПоКПС);
	Результат.Вставить("УчетПоПодразделениям", СвойстваСчета.УчетПоПодразделениям);
	Результат.Вставить("ДопАналитикаЕстьСубконто", Ложь);
	Результат.Вставить("ДопАналитикаСуммовой", Ложь);
	Результат.Вставить("ДопАналитикаКоличественный", Ложь);
	Результат.Вставить("ДопАналитикаОбязательный", Ложь);
	Результат.Вставить("ДопАналитикаТолькоОбороты", Ложь);
	Результат.Вставить("ДопИзмерениеЕстьСубконто", Ложь);
	Результат.Вставить("ДопИзмерениеСуммовой", Ложь);
	Результат.Вставить("ДопИзмерениеКоличественный", Ложь);
	Результат.Вставить("ДопИзмерениеОбязательный", Ложь);
	Результат.Вставить("ДопИзмерениеТолькоОбороты", Ложь);
	Результат.Вставить("ПартияЕстьСубконто", Ложь);
	Результат.Вставить("ПартияСуммовой", Ложь);
	Результат.Вставить("ПартияКоличественный", Ложь);
	Результат.Вставить("ПартияОбязательный", Ложь);
	Результат.Вставить("ПартияТолькоОбороты", Ложь);
	
	Для Индекс = 1 По СвойстваСчета.КоличествоСубконто Цикл
	
		ВидСубконто         = СвойстваСчета["ВидСубконто" + Индекс];
		ВидСубконтоСуммовой = СвойстваСчета["ВидСубконто" + Индекс + "Суммовой"];
		ВидСубконтоКоличественный = СвойстваСчета["ВидСубконто" + Индекс + "Количественный"];
		ВидСубконтоОбязательный = СвойстваСчета["ВидСубконто" + Индекс + "Обязательный"];
		ВидСубконтоТолькоОбороты = СвойстваСчета["ВидСубконто" + Индекс + "ТолькоОбороты"];
			
		Если ВидСубконто = ДопАналитикаВидСубконто Тогда
			Результат.ДопАналитикаЕстьСубконто = Истина;
			Результат.ДопАналитикаСуммовой     = ВидСубконтоСуммовой;
			Результат.ДопАналитикаКоличественный     = ВидСубконтоКоличественный;
			Результат.ДопАналитикаОбязательный     = ВидСубконтоОбязательный;
			Результат.ДопАналитикаТолькоОбороты       = ВидСубконтоТолькоОбороты;
				
		ИначеЕсли ВидСубконто = ДопИзмерениеВидСубконто Тогда
			Результат.ДопИзмерениеЕстьСубконто = Истина;
			Результат.ДопИзмерениеСуммовой     = ВидСубконтоСуммовой;
			Результат.ДопИзмерениеКоличественный     = ВидСубконтоКоличественный;
			Результат.ДопИзмерениеОбязательный     = ВидСубконтоОбязательный;
			Результат.ДопИзмерениеТолькоОбороты       = ВидСубконтоТолькоОбороты;
				
		ИначеЕсли ВидСубконто = ПартияВидСубконто Тогда
			// Если в доп.аналитике или доп.измерении не указана конкретная партия списания,
			// будет применяться партионный учет при списании по субконто "Партия".
			Результат.ПартияЕстьСубконто = Истина;
			Результат.ПартияСуммовой     = ВидСубконтоСуммовой;
			Результат.ПартияКоличественный     = ВидСубконтоКоличественный;
			Результат.ПартияОбязательный     = ВидСубконтоОбязательный;
			Результат.ПартияТолькоОбороты       = ВидСубконтоТолькоОбороты;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Параметры учета ИК по ЦМО и подразделениям.
// Для оптимизации кэширования вызывать нужно на дату последнего изменения учетной политики.
// Учитывает ФО ИспользоватьУчетПоПодразделениям
// 
// Параметры:
//  Счет - ПланСчетовСсылка.ЕПСБУ
//  Организация - СправочникСсылка.Организации
//  Дата - Дата
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. УправлениеМатериальнымиЗапасами.НовыйПараметрыУчетаИКпоЦМОиПодразделениям:
// * УчетПоПодразделениям - Булево - 
// * УчетПоЦМО - Булево - 
Функция ПараметрыУчетаИКпоЦМОиПодразделениям(Счет, Организация, Дата) Экспорт
	Результат = УправлениеМатериальнымиЗапасами.СохраненныеПараметрыУчетаИКпоЦМОиПодразделениям(Счет,
		Организация, Дата);
	Результат.УчетПоПодразделениям = Результат.УчетПоПодразделениям
		И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	Возврат Новый ФиксированнаяСтруктура(Результат);
КонецФункции

Функция СчетаУчетаПрослеживаемыхМЗ(Дата, Организация) Экспорт
	
	КодыСчетов =
	"105.00,
	|02.4,
	|07.1,
	|07.2,
	|09,
	|12,
	|13.2,
	|27.02";
	СписокСчетов = БухгалтерскийУчет.СписокСчетов(КодыСчетов, Дата, Истина, Организация);
	Результат = Новый Соответствие;
	Для каждого Счет Из СписокСчетов Цикл
		Результат.Вставить(Счет, Истина);
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Результат);
	
КонецФункции

#КонецОбласти
