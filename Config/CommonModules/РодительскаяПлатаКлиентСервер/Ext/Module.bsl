// ЭКСПОРТНЫЕ ПРОЦЕДУРЫ МОДУЛЯ

#Область ПрограммныйИнтерфейс

Функция ПолучитьЗначениеСтавки(Ставка, РабочихДней = 0, ДнейПосещения = 0, НачалоПериода, КонецПериода, ПрерыватьПоОшибке = Ложь) Экспорт 
	
	Перем Результат;
	
	Результат = 0;
	
	Если ТипЗнч(НачалоПериода) <> Тип("Дата") ИЛИ ТипЗнч(КонецПериода) <> Тип("Дата") 
	 ИЛИ ТипЗнч(Ставка) <> Тип("СправочникСсылка.СтавкиОплатыОбразование") Тогда
		
		Если ПрерыватьПоОшибке  Тогда
			
			ТекстОшибки = НСтр("ru='Переданы недопустимые параметры расчета ставки оплаты! 
									     |(Ставка """ + Ставка + """, начало периода """ + НачалоПериода + """, конец периода """ + КонецПериода + """'");
		
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли; 
		
	Иначе
		
		КоличествоДнейДействия = День(КонецПериода) - День(НачалоПериода) + 1;
		КоличествоДнейВПериоде = День(КонецМесяца(КонецПериода)); 
		ДанныеСтавки = РаботаСоСтудентамиПовтИсп.ПолучитьДанныеСтавки(Ставка, НачалоПериода);
		
		Если ДанныеСтавки.ЭтоФиксированнаяСтавкаЗаПериод Тогда
			
			Если КоличествоДнейДействия <> КоличествоДнейВПериоде Тогда
				Результат = ДанныеСтавки.СуммаНачисления / КоличествоДнейВПериоде * КоличествоДнейДействия;
			Иначе
				Результат = ДанныеСтавки.СуммаНачисления;
			КонецЕсли; 
			
		Иначе
			
			Мультипликатор = Месяц(КонецПериода) - Месяц(НачалоПериода) + 1 + (Год(КонецПериода) - Год(НачалоПериода)) * 12;
				
			СуммаФиксированнаяСтавкаЗаМесяц = ДанныеСтавки.СуммаФиксированнаяСтавкаЗаМесяц  * Мультипликатор / КоличествоДнейВПериоде * КоличествоДнейДействия;
			СуммаПеременнойСтавки = ?(РабочихДней = 0, 0, ДанныеСтавки.СуммаПеременнаяСтавкаЗаМесяц * Мультипликатор * ДнейПосещения / РабочихДней);
			СуммаЗаДни = ДанныеСтавки.СуммаСтавкаЗаДень * ДнейПосещения;
			
			Результат = СуммаФиксированнаяСтавкаЗаМесяц + СуммаПеременнойСтавки + СуммаЗаДни;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСуммуОплаты(Ставка, РабочихДней = 0, ДнейПосещения = 0, НачалоПериода, КонецПериода, Льгота, ПрерыватьПоОшибке = Ложь) Экспорт
	
	 Возврат ПолучитьЗначениеСтавки(Ставка, РабочихДней, ДнейПосещения, НачалоПериода, КонецПериода, ПрерыватьПоОшибке) * РаботаСоСтудентамиПовтИсп.ПолучитьКоэффициентЛьготы(Льгота);
	
КонецФункции	

// Текст тэга HTML для вставки в поле, содержащее представление формулы
//
// Параметры:
//  Тип				 - Строка - 
//  Индекс			 - Строка, Число - 
//  ИДСтроки		 - Строка, Число - 
//  ИмяДляФормулы	 - Строка - 
// 
// Возвращаемое значение:
// Строка - 
//
Функция ТэгОперанда(Тип, Индекс, ИДСтроки, ИмяДляФормулы) Экспорт
	Возврат СтрШаблон("<SPAN class=%1 id=%2 dataFld=%3>%4</SPAN>",
		Тип,
		Индекс,
		ИДСтроки,
		ИмяДляФормулы);
КонецФункции

// Возвращает выражение для вычисляемого поля СКД по переданной функции из формулы расчета РП.
//
// Параметры:
//  ИмяФункции		 - Строка - 
//  ТаблицаОперандов - ТаблицаЗначений - таблица предопределенных операндов
//  Период			 - Строка - значение периода, для подстановки в вызываемую функцию
// 
// Возвращаемое значение:
// Строка - 
//
Функция ВыражениеДляСКДПоФормуле(Знач ИмяФункции, ТаблицаОперандов, Период) Экспорт
	
	Если СтрЗаканчиваетсяНа(ИмяФункции, "()") Тогда
		ИмяФункции = Лев(ИмяФункции, СтрДлина(ИмяФункции) - 2);
	КонецЕсли;
	
	СтрокаОписанияФункции = ОписаниеФункции(ИмяФункции, ТаблицаОперандов);
	
	Если СтрокаОписанияФункции = Неопределено Тогда
		ВызватьИсключение "Не найдена функция";
	КонецЕсли;
	
	ПараметрыФункции = Новый Массив;
	КоличествоПараметров = 6;
	Для Индекс = 1 По КоличествоПараметров Цикл
		
		ЗначениеПараметра = СтрокаОписанияФункции["Параметр" + Индекс];
		
		Если Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			Прервать;
		КонецЕсли;
		
		Если СтрНачинаетсяС(ЗначениеПараметра, "Период") Тогда
			ПараметрФункции = ВыражениеДляПериода(Период, ЗначениеПараметра);
		ИначеЕсли СтрЗаканчиваетсяНа(ЗначениеПараметра, "()") Тогда
			ПараметрФункции = ВыражениеДляСКДПоФормуле(ЗначениеПараметра, ТаблицаОперандов, Период);
		Иначе
			ПараметрФункции = ЗначениеПараметра;
		КонецЕсли;
		ПараметрыФункции.Добавить(ПараметрФункции);
		
	КонецЦикла;
	
	Возврат СтрШаблон("РасчетыПоРодительскойПлате.%1(%2)", ИмяФункции, СтрСоединить(ПараметрыФункции, ","));
	
КонецФункции

// Возвращает структуру для заполнения имени функции и значений параметров.
//
// Параметры:
//  СтрокаТаблицы	 - СтрокаТаблицыЗначений - 
// 
// Возвращаемое значение:
// Структура - 
//
Функция ШаблонОписанияФункции(СтрокаТаблицы = Неопределено) Экспорт
	
	Описание = Новый Структура("ИмяФункции,
		|Параметр1,
		|Параметр2,
		|Параметр3,
		|Параметр4,
		|Параметр5,
		|Параметр6");
		
	Если СтрокаТаблицы <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Описание, СтрокаТаблицы);
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "ИмяДляФормулы")
			И НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "ИмяФункции") Тогда
			Описание.ИмяФункции = СтрокаТаблицы.ИмяДляФормулы;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыражениеДляПериода(Период, Параметр)
	Результат = "";
	
	Если Период = "ПериодДокумента" Тогда
		Результат = ?(Прав(Параметр, 5)="ДатаН",
			"НачалоПериода",
			"КонецПериода");
			
	ИначеЕсли Период = "ПредыдущийМесяц" Тогда
		Результат = ?(Прав(Параметр, 5)="ДатаН",
			"НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаНачала,""МЕСЯЦ"",-1),""МЕСЯЦ"")",
			"КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаОкончания,""МЕСЯЦ"",-1),""МЕСЯЦ"")");
			
	ИначеЕсли Период = "ТекущийКвартал" Тогда
		Результат = ?(Прав(Параметр, 5)="ДатаН",
			"НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""КВАРТАЛ"")",
			"КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""КВАРТАЛ"")");
			
	ИначеЕсли Период = "ПредыдущийКвартал" Тогда
		Результат = ?(Прав(Параметр, 5)="ДатаН",
			"НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаНачала,""КВАРТАЛ"",-1),""КВАРТАЛ"")",
			"КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаОкончания,""КВАРТАЛ"",-1),""КВАРТАЛ"")");
		
	ИначеЕсли Период = "ТекущееПолугодие" Тогда
		Результат = ?(Прав(Параметр, 5)="ДатаН",
			"НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""ПОЛУГОДИЕ"")",
			"КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""ПОЛУГОДИЕ"")");
			
	ИначеЕсли Период = "ПредыдущееПолугодие" Тогда
		Результат = ?(Прав(Параметр, 5)="ДатаН",
			"НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаНачала,""ПОЛУГОДИЕ"",-1),""ПОЛУГОДИЕ"")",
			"КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаОкончания,""ПОЛУГОДИЕ"",-1),""ПОЛУГОДИЕ"")");	
	
	Иначе
		ВызватьИсключение "Не известный период - " + Период;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеФункции(Знач ИмяФункции, ТаблицаОперандов)
	
	СтрокиТаблицы = ТаблицаОперандов.НайтиСтроки(Новый Структура("ИмяДляФормулы", ИмяФункции));
	Если СтрокиТаблицы.Количество() > 0 Тогда
		Возврат ШаблонОписанияФункции(СтрокиТаблицы[0]);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти
