////////////////////////////////////////////////////////////////////////////////
// Дополнительные настройки формата.

Процедура ДополнительныеНастройкиФорматаПередНачаломИзменения(ЭлементТаблицаДопНастроек) Экспорт 
	
	Если ЭлементТаблицаДопНастроек.Имя <> "ДополнительныеНастройкиФормата" Тогда 
		Возврат;
	КонецЕсли;	
	
	Если ЭлементТаблицаДопНастроек.ТекущийЭлемент.Имя <> "ДополнительныеНастройкиФорматаЗначение" Тогда 
		Возврат;
	КонецЕсли;	
	
	ЭлементТаблицаДопНастроек.ТекущийЭлемент.РежимВыбораИзСписка =  ЭлементТаблицаДопНастроек.ТекущиеДанные.ВыбиратьИзСписка;
	// всегда очищаем список выбора, т.к. на 8.3.5 он отображается, не зависимо от флага ВыбиратьИзСписка
	ЭлементТаблицаДопНастроек.ТекущийЭлемент.СписокВыбора.Очистить(); 
	Если  ЭлементТаблицаДопНастроек.ТекущиеДанные.ВыбиратьИзСписка Тогда 		
		Для Каждого СтрокаИсходногоСписка Из ЭлементТаблицаДопНастроек.ТекущиеДанные.СписокВыбора Цикл 
			НоваяСтока = ЭлементТаблицаДопНастроек.ТекущийЭлемент.СписокВыбора.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтока,СтрокаИсходногоСписка);
		КонецЦикла;
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ДополнительныеНастройкиФорматаЗначениеПриИзменении(ЭлементТаблицаДопНастроек) Экспорт 
	
	Если ЭлементТаблицаДопНастроек.Имя <> "ДополнительныеНастройкиФормата" Тогда 
		Возврат;
	КонецЕсли;
	
	//СтруктураСтроки = Новый Структура("ВыбиратьИзСписка,СписокВыбора,Значение");
	//ЗаполнитьЗначенияСвойств(СтруктураСтроки,ЭлементТаблицаДопНастроек.ТекущиеДанные);
	
	ЭлементТаблицаДопНастроек.ТекущиеДанные.ПредставлениеЗначения = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьПредставлениеЗначения(ЭлементТаблицаДопНастроек.ТекущиеДанные);
	
КонецПроцедуры

// Дополнительные настройки формата.
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// Формирование пакетов
// Программный интерфейс

функция СформироватьСтруктуруФормированияПакетов() Экспорт 
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Отказ",Ложь);
	СтруктураДанных.Вставить("ЧастьПакетовНеВыгруженна",Ложь);
	СтруктураДанных.Вставить("Обработка");
	СтруктураДанных.Вставить("КоличествоСформированныхПакетов",0);
	СтруктураДанных.Вставить("НомерОбрабатываемогоПакета",0);
	СтруктураДанных.Вставить("МассивПакетов",Новый Массив);
	СтруктураДанных.Вставить("ИмяТипаОбработки","ОбработкаОбъект.ВыгрузкаОтчетностиОрганизаций");
	
	Возврат СтруктураДанных;
	
КонецФункции	

Процедура СформироватьПакеты(СтруктураДанных, Форма, ОбработкаЗавершения = Неопределено) Экспорт 
	
	ДополнительныеПараметры =  Новый Структура;
	ДополнительныеПараметры.Вставить("Этап","Начало");
	ДополнительныеПараметры.Вставить("СтруктураДанных",СтруктураДанных);
	ДополнительныеПараметры.Вставить("Форма",Форма);
	ДополнительныеПараметры.Вставить("ОбработкаЗавершения",ОбработкаЗавершения);
	
	СформироватьПакетыВнутр(Неопределено, ДополнительныеПараметры);
	
КонецПроцедуры	

// Программный интерфейс
////////////////////////////////////////////////////////////////////////////////
// Служебные

Процедура СформироватьПакетыВнутр(Реузультат, ДополнительныеПараметры) Экспорт 
	
	СтруктураДанных = ДополнительныеПараметры.СтруктураДанных;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СформироватьПакетыВнутр",ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент,ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап <> "Завершение" Тогда  
		
		Если СтруктураДанных.Отказ Тогда 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;	
	
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		
		ДополнительныеПараметры.Этап = "ПоискЗависимостей";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ПоискЗависимостей" Тогда 
		
		Состояние(НСтр("ru = 'Поиск зависимостей.'"),,,БиблиотекаКартинок.ДлительнаяОперация48);
		
		ДополнительныеПараметры.Этап = "ФормированиеПакетов";
				
		ДополнительныеПараметрыЗависимостей = Новый Структура;
		ДополнительныеПараметрыЗависимостей.Вставить("Этап", "Начало");
		ДополнительныеПараметрыЗависимостей.Вставить("Форма", ДополнительныеПараметры.Форма);
		ДополнительныеПараметрыЗависимостей.Вставить("ДействиеПослеЗависимостей",ОписаниеОповещения);
		ДополнительныеПараметрыЗависимостей.Вставить("ОбщиеДопПарметы", ДополнительныеПараметры);
		
		
		ПроверитьЗависимости(Неопределено, ДополнительныеПараметрыЗависимостей);
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "ФормированиеПакетов" Тогда 
		
		Состояние(НСтр("ru = 'Формирование пакетов.'"),,,БиблиотекаКартинок.ДлительнаяОперация48);
		ВыгрузкаРегламентированнойБухгалтерскойОтчетности.СформироватьПакеты(ДополнительныеПараметры.СтруктураДанных);
		
		ДополнительныеПараметры.Этап = "ДобавлениеПодписей";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "ДобавлениеПодписей" Тогда 		
		
		Состояние(НСтр("ru = 'Добавление подписей.'"),,,БиблиотекаКартинок.ДлительнаяОперация48);
		
		ДополнительныеПараметры.Этап = "ПослеДобавленияПодписей";
		
		ДополнительныеПараметрыДляПодписей = Новый Структура;
		ДополнительныеПараметрыДляПодписей.Вставить("Этап", "Начало");
		ДополнительныеПараметрыДляПодписей.Вставить("ДействиеПослеПодписей",ОписаниеОповещения);
		ДополнительныеПараметрыДляПодписей.Вставить("ОбщиеДопПарметы", ДополнительныеПараметры);
		
		ДобавитьПодписиВПакеты(Неопределено,ДополнительныеПараметрыДляПодписей);
		
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "ПослеДобавленияПодписей" Тогда 
			
		Если Строка(СтруктураДанных.Обработка.СпособВыгрузки) = "Web-сервис" Тогда
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
		Иначе
			
			ДополнительныеПараметры.Этап = "ОтправкаПакетов";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
		КонецЕсли;
			
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "ОтправкаПакетов" Тогда 
		
		Состояние(НСтр("ru = 'Отправка пакетов.'"),,,БиблиотекаКартинок.ДлительнаяОперация48);
		
		ДополнительныеПараметры.Этап = "ФормированиеПротокола";
		
		ДополнительныеПараметрыДляОтправки = Новый Структура;
		ДополнительныеПараметрыДляОтправки.Вставить("Этап", "Начало");
		ДополнительныеПараметрыДляОтправки.Вставить("ДействиеПослеОтправки",ОписаниеОповещения);
		ДополнительныеПараметрыДляОтправки.Вставить("СтруктураДанных", ДополнительныеПараметры.СтруктураДанных);
		
		
		ОтправитьПакетыПослеФормирования(Неопределено, ДополнительныеПараметрыДляОтправки);
		
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "ФормированиеПротокола" Тогда
		
		Состояние(НСтр("ru = 'Формирование протокола.'"),,,БиблиотекаКартинок.ДлительнаяОперация48);
		ОтображатьПротокол = Истина;
		// Для отправки отчета в ФНС протокол печатать не требуется - протокол будет предоставлен при отправке или получении.
		Если ДополнительныеПараметры.СтруктураДанных.Свойство("Обработка") 
			И ДополнительныеПараметры.СтруктураДанных.Обработка.СпособВыгрузки = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайлов.ОбменСФНС") Тогда
			
			ОтображатьПротокол = Ложь;
		КонецЕсли;	
		
		Если ОтображатьПротокол Тогда
			ПоказатьПротокол(ДополнительныеПараметры.СтруктураДанных, ДополнительныеПараметры.Форма);
		КонецЕсли;	
				
		ДополнительныеПараметры.Этап = "Завершение";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
		
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда	
		Состояние();
		
		Если СтруктураДанных.Отказ Тогда
			ПоказатьОповещениеПользователя(НСтр("ru = 'Отмена выгрузки.'"),,НСтр("ru = 'Не удалось выгрузить отчеты.'"),БиблиотекаКартинок.Ошибка32);
		ИначеЕсли Строка(СтруктураДанных.Обработка.СпособВыгрузки) = "Web-сервис" Тогда
			Если СтруктураДанных.ЧастьПакетовНеВыгруженна Тогда 
				ПоказатьОповещениеПользователя(НСтр("ru = 'Частичная выгрузка.'"),,НСтр("ru = 'Часть пакетов сформировать не удалось.'"),БиблиотекаКартинок.Предупреждение32);
			Иначе 
				ПоказатьОповещениеПользователя(НСтр("ru = 'Готово.'"),,НСтр("ru = 'Пакеты успешно сформированы.'"),БиблиотекаКартинок.Успешно32);
			КонецЕсли;
			РезультатОтправки = Новый Структура("Результат,МассивПакетов",Не СтруктураДанных.Отказ,СтруктураДанных.МассивПакетов);
		Иначе
			Если СтруктураДанных.ЧастьПакетовНеВыгруженна Тогда 
				ПоказатьОповещениеПользователя(НСтр("ru = 'Частичная выгрузка.'"),,НСтр("ru = 'Часть пакетов выгрузить не удалось.'"),БиблиотекаКартинок.Предупреждение32);
			Иначе 
				ПоказатьОповещениеПользователя(НСтр("ru = 'Готово.'"),,НСтр("ru = 'Отчеты успешно выгружены.'"),БиблиотекаКартинок.Успешно32);
			КонецЕсли;
			РезультатОтправки = Не СтруктураДанных.Отказ;
		КонецЕсли;
		
		Если ДополнительныеПараметры.ОбработкаЗавершения <> Неопределено Тогда			
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗавершения,РезультатОтправки);
		КонецЕсли;	
		
	КонецЕсли;	
	
	
КонецПроцедуры

Процедура ПроверитьЗависимости(Результат, ДополнительныеПараметры) Экспорт 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьЗависимости",ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент,ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда
		
		ВыгрузкаРегламентированнойБухгалтерскойОтчетности.ЗаполнитьЗависимости(ДополнительныеПараметры.ОбщиеДопПарметы.СтруктураДанных);
		
		Если ДополнительныеПараметры.ОбщиеДопПарметы.СтруктураДанных.Отказ Тогда 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
			
			Возврат;
		КонецЕсли;
		
		Если ДополнительныеПараметры.ОбщиеДопПарметы.СтруктураДанных.Обработка.Зависимости.Количество() = 0 Тогда 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
			
			Возврат;
		КонецЕсли;
		
		НеЗаполненные = ДополнительныеПараметры.ОбщиеДопПарметы.СтруктураДанных.Обработка.Зависимости.НайтиСтроки(Новый Структура("ВыбранныйОтчет",ПредопределенноеЗначение("Документ.УниверсальныйРегламентированныйОтчет.ПустаяСсылка")));
		
		Если НеЗаполненные.Количество() = 0 Тогда 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
			
			Возврат;
		КонецЕсли;
		
		ДополнительныеПараметры.Этап = "ОбработкаРезультатаРешения";
		
		ПараметрыФормы = Новый Структура("Объект",ДополнительныеПараметры.ОбщиеДопПарметы.СтруктураДанных.Обработка);
		ОткрытьФорму("Обработка.ВыгрузкаОтчетностиОрганизаций.Форма.ФормаРешенияПоЗависимостям",ПараметрыФормы, ДополнительныеПараметры.Форма,,,,ОписаниеОповещения);
		
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "ОбработкаРезультатаРешения" Тогда
		
		Если ТипЗнч(Результат) <> Тип("Структура") Или Не Результат.ПродолжитьВыгрузку Тогда 
			ДополнительныеПараметры.ОбщиеДопПарметы.СтруктураДанных.Отказ = Истина;
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
			
			Возврат;
		КонецЕсли;
		
		КопироватьДанныеФормы(Результат.Объект, ДополнительныеПараметры.ОбщиеДопПарметы.СтруктураДанных.Обработка);
		
		ДополнительныеПараметры.Этап = "Завершение";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения,Неопределено);
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ДействиеПослеЗависимостей);
		
	КонецЕсли;   
	
КонецПроцедуры	


Процедура ДобавитьПодписиВПакеты(Реузультат, ДополнительныеПараметры) Экспорт 
	СтруктураДанных = ДополнительныеПараметры.ОбщиеДопПарметы.СтруктураДанных;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьПодписиВПакеты",ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент,ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		Если Не ЗначениеЗаполнено(СтруктураДанных.Обработка.ЭлектронныеЦифровыеПодписи) Тогда 
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ДействиеПослеПодписей);
			Возврат;
		КонецЕсли;
		
		ВозможноДляЭтогоСпособа = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ИспользоватьЭПДляСпособаВыгрузки(ДополнительныеПараметры.ОбщиеДопПарметы.СтруктураДанных.Обработка.СпособВыгрузки);
		Если Не ВозможноДляЭтогоСпособа Тогда 
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ДействиеПослеПодписей);
			Возврат;
		КонецЕсли;
		
		
		ДополнительныеПараметры.Вставить("НомераПактовДляОбработки");
		ДополнительныеПараметры.Вставить("НомерТекущегоПакета");
		ДополнительныеПараметры.Вставить("СтруктураДанныхПодписей");
		
		
		
		НомераПактовДляОбработки = Новый Массив;
		Для Н = 0 По СтруктураДанных.КоличествоСформированныхПакетов-1 Цикл 
			
			НомераПактовДляОбработки.Добавить(Н);
			
		КонецЦикла;
		ДополнительныеПараметры.НомераПактовДляОбработки = НомераПактовДляОбработки;
		
		ДополнительныеПараметры.Этап = "1";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Неопределено)
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "1" Тогда	
		
		Если не ЗначениеЗаполнено(ДополнительныеПараметры.НомераПактовДляОбработки) Тогда 
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ДействиеПослеПодписей);
			Возврат;
		КонецЕсли;
		
		ДополнительныеПараметры.НомерТекущегоПакета = ДополнительныеПараметры.НомераПактовДляОбработки[0];
		
		СтруктураДанных.НомерОбрабатываемогоПакета = ДополнительныеПараметры.НомерТекущегоПакета;
		СтруктураДанныхПодписей = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент.СформироватьСтруктуруДанныхДляУстановкиПодписей();
		СтруктураДанныхПодписей.РежимПредварительногоВыбораСертификатов = Истина;
		СтруктураДанныхПодписей.УидФормы = ДополнительныеПараметры.ОбщиеДопПарметы.Форма.УникальныйИдентификатор;
		
		Для Каждого СтрокаСертификата Из СтруктураДанных.Обработка.ЭлектронныеЦифровыеПодписи Цикл 
			
			ОписаниеСертификата = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьПустуюСтруктуруПараметров("МассивОписанийСертификатов");
			СтруктураДанныхПодписей.МассивОписанийСертификатов.Добавить(ОписаниеСертификата);
			
			ЗаполнитьЗначенияСвойств(ОписаниеСертификата,СтрокаСертификата,"КомуВыданСертификат,Отпечаток,ДатаПодписи,Комментарий,УстановившийПодпись");
			Если ЗначениеЗаполнено(СтрокаСертификата.СертификатСсылка) Тогда 
				ОписаниеСертификата.СертификатСсылка = СтрокаСертификата.СертификатСсылка; 
			Иначе 
				ОписаниеСертификата.Сертификат = БюджетнаяОтчетностьКлиентСервер.ПрочитатьЗначениеИзXML(СтрокаСертификата.Сертификат,Тип("ДвоичныеДанные"));
			КонецЕсли;
			
		КонецЦикла;
		ВыгрузкаРегламентированнойБухгалтерскойОтчетности.ЗаполнитьОписаниеФайловДляФормированияПодписей(СтруктураДанных, СтруктураДанныхПодписей);
		
		ДополнительныеПараметры.Этап = "2";
		ДополнительныеПараметры.СтруктураДанныхПодписей = СтруктураДанныхПодписей;
		
		Если ЗначениеЗаполнено(СтруктураДанныхПодписей.ФайлыДляСозданияПодписей) Тогда 
			ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент.СоздатьПодписи(СтруктураДанныхПодписей,ОписаниеОповещения);
			
		Иначе 
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		КонецЕсли;
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "2" Тогда	
		
		ДополнительныеПараметры.НомераПактовДляОбработки.Удалить(0);
		
		ВыгрузкаРегламентированнойБухгалтерскойОтчетности.ДобавитьНовыеПодписиВПакет(СтруктураДанных, ДополнительныеПараметры.СтруктураДанныхПодписей);
		
		ДополнительныеПараметры.Этап = "1";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры


Процедура ОтправитьПакетыПослеФормирования(Реузультат, ДополнительныеПараметры)Экспорт 
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда
		
		ДополнительныеПараметры.Этап = "Завершение";
		
		ДополнительныеПараметрыОтправки = Новый Структура;
		ДополнительныеПараметрыОтправки.Вставить("Этап","Начало");
		ДополнительныеПараметрыОтправки.Вставить("ОбработкаЗавершения", Новый ОписаниеОповещения("ОтправитьПакетыПослеФормирования",ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент,ДополнительныеПараметры));
		ДополнительныеПараметрыОтправки.Вставить("Пакеты",ДополнительныеПараметры.СтруктураДанных.МассивПакетов);
		
		
		ОтправитьПакеты(Неопределено , ДополнительныеПараметрыОтправки);
		
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда
		
		Если Реузультат.ПакетовПропущенно > 0 тогда 
			ДополнительныеПараметры.СтруктураДанных.ЧастьПакетовНеВыгруженна = Истина;
		КонецЕсли;	
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ДействиеПослеОтправки);
		
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПоказатьПротокол(СтруктураДанных, Форма)
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Документ.ПакетВыгрузкиОтчетности",
	"ПротоколВыгрузки",
	СтруктураДанных.МассивПакетов,
	Форма);
	
КонецПроцедуры

// Служебные
// Формирование пакетов
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// Отправка пакетов
// Программный интерфейс

Процедура ОтправитьПакеты(Результат , ДополнительныеПараметры) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОтправитьПакеты",ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент,ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда
		
		Если ДополнительныеПараметры.Пакеты.Количество() = 0 Тогда 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		КонецЕсли;
		
		ДополнительныеПараметры.Вставить("ДанныеОтправки",СформироватьСтруктуруДанныхОтправки());
		
		ДополнительныеПараметры.ДанныеОтправки.ПакетыДляОтправки = ДополнительныеПараметры.Пакеты;
		
		ВыгрузкаРегламентированнойБухгалтерскойОтчетности.ВыполнитьВыгрузкуДанныхНаСервере(ДополнительныеПараметры.ДанныеОтправки);
		
		ДополнительныеПараметры.Этап = "ВыгрузкаВКаталог";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ВыгрузкаВКаталог" Тогда
		
		
		ДополнительныеПараметры.Этап = "ВыгрузкаВФНС";
		
		ДополнительныеПараметрыВыгрузкиВКаталог = Новый Структура;
		ДополнительныеПараметрыВыгрузкиВКаталог.Вставить("Этап","Начало");
		ДополнительныеПараметрыВыгрузкиВКаталог.Вставить("ДанныеОтправки",ДополнительныеПараметры.ДанныеОтправки);
		ДополнительныеПараметрыВыгрузкиВКаталог.Вставить("ОбработкаЗавершения",ОписаниеОповещения);
		
		ВыгрузкаВКаталогКлиент(Неопределено, ДополнительныеПараметрыВыгрузкиВКаталог);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ВыгрузкаВФНС" Тогда
		
		
		ВыгрузкаВФНСКлиент(ДополнительныеПараметры.ДанныеОтправки);
		
		ДополнительныеПараметры.Этап = "ОкончаниеОтправки";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ОкончаниеОтправки" Тогда
		
		Если ДополнительныеПараметры.ДанныеОтправки.Свойство("БезОчистки") = Ложь Тогда
			ОчиститьХранилище(ДополнительныеПараметры.ДанныеОтправки);
		КонецЕсли;	
		ПоказатьОповещенияПользователя(ДополнительныеПараметры.ДанныеОтправки);
		
		ДополнительныеПараметры.Этап = "Завершение";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда
		
		Результат = Новый Структура;
		Результат.Вставить("ПакетовПропущенно",0);
		Результат.Вставить("ПакетовОтправленно",0);
		
		Результат.ПакетовПропущенно = ДополнительныеПараметры.ДанныеОтправки.ПропущенныеПакеты.Количество();
		Результат.ПакетовОтправленно = ДополнительныеПараметры.ДанныеОтправки.ОтправленныеПакеты.Количество(); 
		
		Если ДополнительныеПараметры.Свойство("ОбработкаЗавершения") Тогда 
			
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗавершения,Результат);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Программный интерфейс
////////////////////////////////////////////////////////////////////////////////
// Общие

Функция СформироватьСтруктуруДанныхОтправки()
	
	ДанныеОтправки = Новый Структура;
	ДанныеОтправки.Вставить("ПакетыДляОтправки");
	ДанныеОтправки.Вставить("ПропущенныеПакеты",Новый Массив);
	ДанныеОтправки.Вставить("ОтправленныеПакеты",Новый Массив);
	ДанныеОтправки.Вставить("ПакетыДляОтправки");
	ДанныеОтправки.Вставить("ВременныеФайлы",Новый Массив);
	ДанныеОтправки.Вставить("ВременныеДанныеВХранилище",Новый Массив);
	
	ДанныеОтправки.Вставить("ОповещенияПользователя", Новый Массив);
	ДанныеОтправки.Вставить("ШаблонСтрокиОповещенияПользователя",Новый Структура);
	ДанныеОтправки.ШаблонСтрокиОповещенияПользователя.Вставить("Текст");
	ДанныеОтправки.ШаблонСтрокиОповещенияПользователя.Вставить("Пояснение");
	ДанныеОтправки.ШаблонСтрокиОповещенияПользователя.Вставить("НавигационнаяСсылка");
	ДанныеОтправки.ШаблонСтрокиОповещенияПользователя.Вставить("Картинка");
	
	
	ДанныеОтправки.Вставить("ДанныеВыгрузкиВКаталог",Новый Структура);
	ДанныеОтправки.ДанныеВыгрузкиВКаталог.Вставить("ИспользоватьВыгрузку",Ложь);
	ДанныеОтправки.ДанныеВыгрузкиВКаталог.Вставить("МассивПакетов",Новый Массив);
	ДанныеОтправки.ДанныеВыгрузкиВКаталог.Вставить("ПолучаемыеФайлы",Новый Массив);
	ДанныеОтправки.ДанныеВыгрузкиВКаталог.Вставить("ДанныеПакетов",Новый Массив);
	ДанныеОтправки.ДанныеВыгрузкиВКаталог.Вставить("ОписаниеСтруктураДанныхПакетов","Пакет,Путь,Организация,Период,ПолучаемыеФайлы");
	
	
	ДанныеОтправки.Вставить("ДанныеВыгрузкиНаФТП",Новый Структура);
	ДанныеОтправки.ДанныеВыгрузкиНаФТП.Вставить("ИспользоватьВыгрузку",Ложь);
	ДанныеОтправки.ДанныеВыгрузкиНаФТП.Вставить("МассивПакетов",Новый Массив);
	ДанныеОтправки.ДанныеВыгрузкиНаФТП.Вставить("ДанныеПакетов",Новый Массив);
	ДанныеОтправки.ДанныеВыгрузкиНаФТП.Вставить("ОписаниеСтруктураДанныхПакетов","Пакет,Организация,Период,FTPСервер,FTPПорт,FTPПуть,FTPПользователь,FTPПароль");
	
	ДанныеОтправки.Вставить("ДанныеВыгрузкиЧерезEmail",Новый Структура);
	ДанныеОтправки.ДанныеВыгрузкиЧерезEmail.Вставить("ИспользоватьВыгрузку",Ложь);
	ДанныеОтправки.ДанныеВыгрузкиЧерезEmail.Вставить("МассивПакетов",Новый Массив);
	ДанныеОтправки.ДанныеВыгрузкиЧерезEmail.Вставить("ДанныеПакетов",Новый Массив);
	ДанныеОтправки.ДанныеВыгрузкиЧерезEmail.Вставить("ОписаниеСтруктураДанныхПакетов","Пакет,Организация,Период,УчетнаяЗаписьЭлектроннойПочты,Получатели");
	
	ДанныеОтправки.Вставить("ДанныеВыгрузкиВФНС",Новый Структура);
	ДанныеОтправки.ДанныеВыгрузкиВФНС.Вставить("ИспользоватьВыгрузку",Ложь);
	ДанныеОтправки.ДанныеВыгрузкиВФНС.Вставить("МассивПакетов",Новый Массив);
	ДанныеОтправки.ДанныеВыгрузкиВФНС.Вставить("МассивДокументов",Новый Массив);
	
	
	Возврат ДанныеОтправки;
	
КонецФункции

Процедура ОчиститьХранилище(ДанныеОтправки)
	
	Для Каждого АдресДляОчистки Из ДанныеОтправки.ВременныеДанныеВХранилище Цикл 
		
		УдалитьИзВременногоХранилища(АдресДляОчистки);
		
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ПоказатьОповещенияПользователя(ДанныеОтправки)
	
	Для Каждого ДанныеОповещения Из ДанныеОтправки.ОповещенияПользователя Цикл 
		
		Текст = Неопределено;
		Пояснение = Неопределено;
		НавигационнаяСсылка = Неопределено;
		Картинка = Неопределено;
		
		Если ТипЗнч(ДанныеОповещения.Текст) = Тип("Строка") Тогда 
			Текст = ДанныеОповещения.Текст;
		КонецЕсли;
		Если ТипЗнч(ДанныеОповещения.Пояснение) = Тип("Строка") Тогда 
			Пояснение = ДанныеОповещения.Пояснение;
		КонецЕсли;
		Если ТипЗнч(ДанныеОповещения.НавигационнаяСсылка) = Тип("Строка") Тогда 
			НавигационнаяСсылка = ДанныеОповещения.НавигационнаяСсылка;
		КонецЕсли;
		Если ТипЗнч(ДанныеОповещения.Картинка) = Тип("Картинка") Тогда 
			Картинка = ДанныеОповещения.Картинка;
		КонецЕсли;
		
		ПоказатьОповещениеПользователя(Текст, НавигационнаяСсылка, Пояснение, Картинка);
		
	КонецЦикла;
	
КонецПроцедуры	

// Общие
////////////////////////////////////////////////////////////////////////////////
// Каталог

Процедура ВыгрузкаВКаталогКлиент(Результат, ДополнительныеПараметры) Экспорт 
	ДанныеВыгрузки = ДополнительныеПараметры.ДанныеОтправки.ДанныеВыгрузкиВКаталог;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузкаВКаталогКлиент", ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда
		
		Если ДанныеВыгрузки.ИспользоватьВыгрузку = Ложь Тогда 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
			Возврат;
		КонецЕсли;
		
		ДополнительныеПараметры.Этап = "РезультатПодключенияРасширения";
		БюджетнаяОтчетностьКлиентПереопределяемый.ПоказатьВопросОбУстановкеРасширенияРаботыСФайлами(ОписаниеОповещения);
				
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "РезультатПодключенияРасширения" Тогда
		
		Если Результат Тогда 
			
			ДополнительныеПараметры.Вставить("ДанныеПакетовВнутр",ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ДанныеВыгрузки.ДанныеПакетов));
			
			ДополнительныеПараметры.Этап = "ЦиклВыгрузкиНачалоЦикла";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		Иначе 
			
			ДополнительныеПараметры.Этап = "ВыгрузкаБезРасширения";
			ДополнительныеПараметры.ДанныеОтправки.Вставить("БезОчистки");
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		КонецЕсли;

		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ВыгрузкаБезРасширения" Тогда
		
		Для Каждого ДанныеПакета Из ДанныеВыгрузки.ДанныеПакетов Цикл
			
			Если Не ЗначениеЗаполнено(ДанныеПакета.ПолучаемыеФайлы) Тогда 
				Шаблон = НСтр("ru = 'Нет файлов по пакету ""%1 (""%2"" ""%3"")"".'");
				Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,ДанныеПакета.Пакет, ДанныеПакета.Организация, ДанныеПакета.Период);
				ОбщегоНазначенияКлиент.СообщитьПользователю(Сообщение);
				
				ДополнительныеПараметры.ДанныеОтправки.ПропущенныеПакеты.Добавить(ДанныеПакета.Пакет);
				
				Продолжить;
			КонецЕсли;
			
			Для Каждого ПолучаемыйФайл Из ДанныеПакета.ПолучаемыеФайлы Цикл
				Попытка
					ПолучитьФайл(ПолучаемыйФайл.Хранение, ПолучаемыйФайл.Имя, Истина);
					
				Исключение
					Шаблон = НСтр("ru = 'Ошибка получения файла ""%1"".
					|%2'");
					Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ПолучаемыйФайл.Имя, ОписаниеОшибки());
					ОбщегоНазначенияКлиент.СообщитьПользователю(Сообщение);
					
					Продолжить;
				КонецПопытки;
			КонецЦикла;
			
			Шаблон = НСтр("ru = '%1 (""%2"" ""%3"") успешно сохранен в каталог ""%4"".'");
			Пояснение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДанныеПакета.Пакет, ДанныеПакета.Организация, ДанныеПакета.Период, ДанныеПакета.Путь);
			
			СтруктураОповещения = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительныеПараметры.ДанныеОтправки.ШаблонСтрокиОповещенияПользователя);
			СтруктураОповещения.Текст = НСтр("ru = 'Пакет успешно сохранен в каталог.'");
			СтруктураОповещения.Пояснение = Пояснение;
			СтруктураОповещения.НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ДанныеПакета.Пакет);
			СтруктураОповещения.Картинка = БиблиотекаКартинок.Успешно32;
			
			ДополнительныеПараметры.ДанныеОтправки.ОповещенияПользователя.Добавить(СтруктураОповещения);
			
			ДополнительныеПараметры.ДанныеОтправки.ОтправленныеПакеты.Добавить(ДанныеПакета.Пакет);
			
		КонецЦикла;
		
		ДополнительныеПараметры.Этап = "Завершение";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклВыгрузкиНачалоЦикла" Тогда
		
		Если не ЗначениеЗаполнено(ДополнительныеПараметры.ДанныеПакетовВнутр) Тогда 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
			
		КонецЕсли;	
		
		
		ДополнительныеПараметры.Вставить("ТекущаяСтрока",ДополнительныеПараметры.ДанныеПакетовВнутр[0]);	
		
		ДанныеПакета = ДополнительныеПараметры.ТекущаяСтрока;
		
		
		Если Не ЗначениеЗаполнено(ДанныеПакета.ПолучаемыеФайлы) Тогда 
			Шаблон = НСтр("ru = 'Нет файлов по пакету ""%1 (""%2"" ""%3"")"".'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,ДанныеПакета.Пакет, ДанныеПакета.Организация, ДанныеПакета.Период);
			ОбщегоНазначенияКлиент.СообщитьПользователю(Сообщение);
			
			ДополнительныеПараметры.ДанныеОтправки.ПропущенныеПакеты.Добавить(ДанныеПакета.Пакет);
			
			ДополнительныеПараметры.Этап = "ЦиклВыгрузкиКонецЦикла";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
		КонецЕсли;
		
		
		ДополнительныеПараметры.Вставить("НужноВыбратьНовыйКаталог",Ложь);
		ДополнительныеПараметры.Вставить("ФайлКаталогВыгрузки",Новый Файл(ДанныеПакета.Путь));
		
		ДополнительныеПараметры.Этап = "ЦиклВыгрузкиРезультатПроверкиСуществованияКаталога";
		ДополнительныеПараметры.ФайлКаталогВыгрузки.НачатьПроверкуСуществования(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклВыгрузкиРезультатПроверкиСуществованияКаталога" Тогда
		
		ДанныеПакета = ДополнительныеПараметры.ТекущаяСтрока;
		
		
		Если Результат = Ложь Тогда 
			
			
			Заголовок = НСтр("ru = 'Каталог выгрузки не существует.'");
			Шаблон = НСтр("ru = 'Каталог ""%1"" не найден.'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,ДанныеПакета.Путь);
			
			
			ДополнительныеПараметры.Этап = "ЦиклВыгрузкиПеревыборКаталога";
			ПоказатьПредупреждение(Новый ОписаниеОповещения("ПослеВыводаПредупреждения",ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент,Новый Структура("ОбработкаЗавершения",ОписаниеОповещения)),Сообщение,,Заголовок);
			
		Иначе 
			
			ДополнительныеПараметры.Этап = "ЦиклВыгрузкиРезультатПроверкиЧтоТоЧтоЕстьЭтоКаталог";
			ДополнительныеПараметры.ФайлКаталогВыгрузки.НачатьПроверкуЭтоКаталог(ОписаниеОповещения);
			
		КонецЕсли;
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклВыгрузкиРезультатПроверкиЧтоТоЧтоЕстьЭтоКаталог" Тогда
		
		ДанныеПакета = ДополнительныеПараметры.ТекущаяСтрока;
		
		
		Если Результат = Ложь Тогда 
			СтруктураИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеПакета.Путь);
			
			Заголовок = НСтр("ru = 'Каталог выгрузки не существует.'");
			Шаблон = НСтр("ru = 'В каталоге ""%1"" существует файл с именем ""%2"".'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДополнительныеПараметры.ФайлКаталогВыгрузки.Путь, ДополнительныеПараметры.ФайлКаталогВыгрузки.Имя);
			
			ДополнительныеПараметры.Этап = "ЦиклВыгрузкиПеревыборКаталога";
			ПоказатьПредупреждение(Новый ОписаниеОповещения("ПослеВыводаПредупреждения",ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент,Новый Структура("ОбработкаЗавершения",ОписаниеОповещения)),Сообщение,,Заголовок);
			
		Иначе 
			
			ДополнительныеПараметры.Этап = "ЦиклВыгрузкиФормированиеПолныхПутей";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		КонецЕсли;
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклВыгрузкиПеревыборКаталога" Тогда
		
		ДанныеПакета = ДополнительныеПараметры.ТекущаяСтрока;
		
		
		
		ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		ДиалогВыбора.Заголовок = НСтр("ru = 'Выберете новый каталог для выгрузки.'");
		
		ДополнительныеПараметры.Этап = "ЦиклВыгрузкиПеревыборКаталогаРезультат";
		ДиалогВыбора.Показать(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклВыгрузкиПеревыборКаталогаРезультат" Тогда
		
		ДанныеПакета = ДополнительныеПараметры.ТекущаяСтрока;
		
		
		Если Результат = Неопределено Тогда 
			
			Шаблон = НСтр("ru = '""%1 (""%2"" ""%3"")"" пропущен.'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДанныеПакета.Пакет, ДанныеПакета.Организация, ДанныеПакета.Период);
			ОбщегоНазначенияКлиент.СообщитьПользователю(Сообщение);
			
			ДополнительныеПараметры.Этап = "ЦиклВыгрузкиКонецЦикла";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
			
		Иначе 
			
			ДанныеПакета.Путь = Результат[0];
			
			ДополнительныеПараметры.Этап = "ЦиклВыгрузкиФормированиеПолныхПутей";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
			
		КонецЕсли;
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклВыгрузкиФормированиеПолныхПутей" Тогда
		
		ДанныеПакета = ДополнительныеПараметры.ТекущаяСтрока;
		
		Для Каждого ПолучаемыйФайл Из ДанныеПакета.ПолучаемыеФайлы Цикл
			
			ПолучаемыйФайл.Имя = ОбщегоНазначенияКлиентСервер.ПолучитьПолноеИмяФайла(ДанныеПакета.Путь,ПолучаемыйФайл.Имя);
			
		КонецЦикла;	
		
		ДополнительныеПараметры.Этап = "ЦиклВыгрузкиРешениеПроблемыДублированияФайлов";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклВыгрузкиРешениеПроблемыДублированияФайлов" Тогда
		
		ДанныеПакета = ДополнительныеПараметры.ТекущаяСтрока;
		
		ДополнительныеПараметры.Этап = "ЦиклВыгрузкиПолучениеФайлов";
		
		ДополнительныеПараметрыРешенияПроблемыДублирования = Новый Структура;
		ДополнительныеПараметрыРешенияПроблемыДублирования.Вставить("Этап","Начало");
		ДополнительныеПараметрыРешенияПроблемыДублирования.Вставить("ОбработкаЗавершения",ОписаниеОповещения);
		ДополнительныеПараметрыРешенияПроблемыДублирования.Вставить("ПолучаемыеФайлы",ДанныеПакета.ПолучаемыеФайлы);
		
		ПроверитьИРешитьПроблемуДублированияФайлов(Неопределено, ДополнительныеПараметрыРешенияПроблемыДублирования); 
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклВыгрузкиПолучениеФайлов" Тогда
		
		ДанныеПакета = ДополнительныеПараметры.ТекущаяСтрока;
		
		Если Не ЗначениеЗаполнено(ДанныеПакета.ПолучаемыеФайлы) Тогда 
			
			ДополнительныеПараметры.Этап = "ЦиклВыгрузкиКонецЦикла";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			// Значит пропустили все файлы.
			
		Иначе 	
			
			ДополнительныеПараметры.Этап = "ЦиклВыгрузкиЗавершениеОбработкиПакета";
			НачатьПолучениеФайлов(ОписаниеОповещения,ДанныеПакета.ПолучаемыеФайлы,,Ложь);
			
		КонецЕсли;	
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклВыгрузкиЗавершениеОбработкиПакета" Тогда
		
		ДанныеПакета = ДополнительныеПараметры.ТекущаяСтрока;
		
		Шаблон = НСтр("ru = '%1 (""%2"" ""%3"") успешно сохранен в каталог ""%4"".'");
		Пояснение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДанныеПакета.Пакет, ДанныеПакета.Организация, ДанныеПакета.Период, ДанныеПакета.Путь);
		
		СтруктураОповещения = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительныеПараметры.ДанныеОтправки.ШаблонСтрокиОповещенияПользователя);
		СтруктураОповещения.Текст = НСтр("ru = 'Пакет успешно сохранен в каталог.'");
		СтруктураОповещения.Пояснение = Пояснение;
		СтруктураОповещения.НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ДанныеПакета.Пакет);
		СтруктураОповещения.Картинка = БиблиотекаКартинок.Успешно32;
		
		ДополнительныеПараметры.ДанныеОтправки.ОповещенияПользователя.Добавить(СтруктураОповещения);
		
		ДополнительныеПараметры.ДанныеОтправки.ОтправленныеПакеты.Добавить(ДанныеПакета.Пакет);
		
		ДополнительныеПараметры.Этап = "ЦиклВыгрузкиКонецЦикла";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклВыгрузкиКонецЦикла" Тогда
		
		ДополнительныеПараметры.ДанныеПакетовВнутр.Удалить(0);
		ДополнительныеПараметры.Этап = "ЦиклВыгрузкиНачалоЦикла";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда
		
		
		Если ДополнительныеПараметры.Свойство("ОбработкаЗавершения") Тогда 
			
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗавершения);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеВыводаПредупреждения(Результат) Экспорт
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если Результат.Свойство("ОбработкаЗавершения") Тогда
		ВыполнитьОбработкуОповещения(Результат.ОбработкаЗавершения);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьИРешитьПроблемуДублированияФайлов(Результат, ДополнительныеПараметры) Экспорт 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьИРешитьПроблемуДублированияФайлов", ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
				
		ДополнительныеПараметры.Вставить("ФайлыДляПроверки",ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ДополнительныеПараметры.ПолучаемыеФайлы));
		ДополнительныеПараметры.Вставить("ФайлыДляПринятияРешений",Новый Массив);
		
		
		ДополнительныеПараметры.Этап = "ЦиклПроверкиНачалоЦикла";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклПроверкиНачалоЦикла" Тогда
		
		Если Не ЗначениеЗаполнено(ДополнительныеПараметры.ФайлыДляПроверки) Тогда 
			
			ДополнительныеПараметры.Этап = "ОбработкаРезультатаЦиклаПроверки";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
			
		КонецЕсли;
		
		ДополнительныеПараметры.Вставить("ТекущаяСтрока",ДополнительныеПараметры.ФайлыДляПроверки[0]);
		
		
		ШаблонИмениФайла = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьШаблонУникальногоИмениФайла(ДополнительныеПараметры.ТекущаяСтрока.Имя);
		
		ДополнительныеПараметры.Этап = "ЦиклПроверкиРезультатПолученияУникальногоИмени";
		
		ДополнительныеПараметрыПолученияУникальногоИмени = Новый Структура;
		ДополнительныеПараметрыПолученияУникальногоИмени.Вставить("Этап","Начало");
		ДополнительныеПараметрыПолученияУникальногоИмени.Вставить("ШаблонПутиФайла",ШаблонИмениФайла);
		ДополнительныеПараметрыПолученияУникальногоИмени.Вставить("Итератор",0);
		ДополнительныеПараметрыПолученияУникальногоИмени.Вставить("ОбработкаЗавершения",ОписаниеОповещения);
		
		
		ПолучитьУникальноеИмяФайла(Неопределено, ДополнительныеПараметрыПолученияУникальногоИмени);
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклПроверкиРезультатПолученияУникальногоИмени" Тогда
		
		Если ДополнительныеПараметры.ТекущаяСтрока.Имя = Результат Тогда 
			ДополнительныеПараметры.Этап = "ЦиклПроверкиКонецЦикла";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
		КонецЕсли;	
		
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("ПолучаемыйФайл",ДополнительныеПараметры.ТекущаяСтрока);
		СтруктураСтроки.Вставить("ВозможноеНовоеИмяФайла",Результат);
		ДополнительныеПараметры.ФайлыДляПринятияРешений.Добавить(СтруктураСтроки);
		
		ДополнительныеПараметры.Этап = "ЦиклПроверкиКонецЦикла";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклПроверкиКонецЦикла" Тогда
		
		ДополнительныеПараметры.ФайлыДляПроверки.Удалить(0);
		
		ДополнительныеПараметры.Этап = "ЦиклПроверкиНачалоЦикла";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ОбработкаРезультатаЦиклаПроверки" Тогда
		
		Если Не ЗначениеЗаполнено(ДополнительныеПараметры.ФайлыДляПринятияРешений) Тогда 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
			
		КонецЕсли;
		
		Заголовок = НСтр("ru = 'Файл с таким именем уже существует. '");
		ШаблонВопроса = НСтр("ru = 'В каталоге ""%1"" уже существует файл с именем ""%2"".
		|
		|Выберите действие, которое нужно сделать.
		|Заменить: Существующий файл будет заменен новым.
		|
		|Переименовать: Новый файл будет сохранен с именем ""%3"".
		|
		|Пропустить: Новый файл сохранен не будет.'");
		
		ШаблонФлажка = НСтр("ru = 'Сделать это для остальных %1 конфликтов'");
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("Заменить",НСтр("ru = 'Заменить'"));
		Кнопки.Добавить("Пропустить",НСтр("ru = 'Пропустить'"));
		Кнопки.Добавить("Переименовать",НСтр("ru = 'Переименовать'"));

		
		
		ДополнительныеПараметры.Вставить("Заголовок",Заголовок);
		ДополнительныеПараметры.Вставить("ШаблонВопроса",ШаблонВопроса);
		ДополнительныеПараметры.Вставить("ШаблонФлажка",ШаблонФлажка);
		ДополнительныеПараметры.Вставить("Кнопки",Кнопки);
		ДополнительныеПараметры.Вставить("ДействиеВместоВопроса","");
		
		ДополнительныеПараметры.Этап = "ЦиклПринятияРешенийНачалоЦикла";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклПринятияРешенийНачалоЦикла" Тогда
		
		Если Не ЗначениеЗаполнено(ДополнительныеПараметры.ФайлыДляПринятияРешений) Тогда 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
			
		КонецЕсли;
		
		ДополнительныеПараметры.Вставить("ТекущаяСтрока",ДополнительныеПараметры.ФайлыДляПринятияРешений[0]);
		
		Если ЗначениеЗаполнено(ДополнительныеПараметры.ДействиеВместоВопроса) Тогда 
			
			ДополнительныеПараметры.Этап = "ЦиклПринятияРешенийПрименениеВыбранногоДействия";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения,ДополнительныеПараметры.ДействиеВместоВопроса);
			
		Иначе
			
			ДополнительныеПараметры.Этап = "ЦиклПринятияРешенийПоказатьВопрос";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		КонецЕсли;	
		
		
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклПринятияРешенийПоказатьВопрос" Тогда
		
		
		СтруктураИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДополнительныеПараметры.ТекущаяСтрока.ПолучаемыйФайл.Имя);
		СтруктураИмениВозможногоФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДополнительныеПараметры.ТекущаяСтрока.ВозможноеНовоеИмяФайла);
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ДополнительныеПараметры.ШаблонВопроса, СтруктураИмениФайла.Путь, СтруктураИмениФайла.Имя, СтруктураИмениВозможногоФайла.Имя);
		
		СтруктураПараметровФормы = Новый Структура;
		СтруктураПараметровФормы.Вставить("Заголовок",ДополнительныеПараметры.Заголовок);
		СтруктураПараметровФормы.Вставить("ТекстСообщения",ТекстВопроса);
		
		СтруктураПараметровФормы.Вставить("Кнопки",ДополнительныеПараметры.Кнопки);
		СтруктураПараметровФормы.Вставить("КнопкаПоУмолчанию","Заменить");
		
		Если ДополнительныеПараметры.ФайлыДляПринятияРешений.Количество() > 1 Тогда 
			ТекстФлажка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ДополнительныеПараметры.ШаблонФлажка, ДополнительныеПараметры.ФайлыДляПринятияРешений.Количество()); 
			СтруктураПараметровФормы.Вставить("ПредлагатьБольшеНеЗадаватьЭтотВопрос",Истина);
			СтруктураПараметровФормы.Вставить("ТекстФлажка",ТекстФлажка);
		КонецЕсли;
		
		ДополнительныеПараметры.Этап = "ЦиклПринятияРешенийОбработкаРезультатаВопроса";
		ОткрытьФорму("ОбщаяФорма.Вопрос",СтруктураПараметровФормы,,,,,ОписаниеОповещения);
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклПринятияРешенийОбработкаРезультатаВопроса" Тогда
		
		Если Результат = Неопределено Тогда 
			
			ВыбранноеДействие = "Переименовать";
		Иначе
			
			ВыбранноеДействие = Результат.Значение;
			Если Результат.БольшеНеЗадаватьЭтотВопрос Тогда 
				ДополнительныеПараметры.ДействиеВместоВопроса = Результат.Значение;
			КонецЕсли;	
		КонецЕсли;
		
		ДополнительныеПараметры.Этап = "ЦиклПринятияРешенийПрименениеВыбранногоДействия";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, ВыбранноеДействие);
		
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклПринятияРешенийПрименениеВыбранногоДействия" Тогда
		
		
		Если Результат = "Заменить" Тогда 
			// ничего не делаем
			
		ИначеЕсли Результат = "Пропустить" Тогда
			ДополнительныеПараметры.ПолучаемыеФайлы.Удалить(ДополнительныеПараметры.ПолучаемыеФайлы.Найти(ДополнительныеПараметры.ТекущаяСтрока.ПолучаемыйФайл));
			
		ИначеЕсли Результат = "Переименовать" Тогда 
			ДополнительныеПараметры.ТекущаяСтрока.ПолучаемыйФайл.Имя = ДополнительныеПараметры.ТекущаяСтрока.ВозможноеНовоеИмяФайла;
			
		Иначе 
			ВызватьИсключение "Неизвестное действие.";
		КонецЕсли;
		
		ДополнительныеПараметры.Этап = "ЦиклПринятияРешенийКонецЦикла";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЦиклПринятияРешенийКонецЦикла" Тогда
		
		ДополнительныеПараметры.ФайлыДляПринятияРешений.Удалить(0);
		
		ДополнительныеПараметры.Этап = "ЦиклПринятияРешенийНачалоЦикла";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда
		
		
		Если ДополнительныеПараметры.Свойство("ОбработкаЗавершения") Тогда 
			
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗавершения);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Каталог
////////////////////////////////////////////////////////////////////////////////
// ФНС

Процедура ВыгрузкаВФНСКлиент(ДанныеОтправки)
	ДанныеВыгрузки = ДанныеОтправки.ДанныеВыгрузкиВФНС;
	Если ДанныеВыгрузки.ИспользоватьВыгрузку = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СписокДокументов",ДанныеВыгрузки.МассивДокументов);
	ОткрытьФорму("Документ.ЭлектронныйДокументБухгалтерскийОтчет.Форма.ЭлектронныеДокументыДляФНС",СтруктураПараметров);
	
КонецПроцедуры

// ФНС
// Отправка пакетов
////////////////////////////////////////////////////////////////////////////////
// ЭЦП

Функция СформироватьСтруктуруДанныхДляУстановкиПодписей() Экспорт 
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Отказ",Ложь);
	СтруктураДанных.Вставить("ОписаниеПодписываемогоОбъекта","");// Используется для формы выбора сертификатов.
	СтруктураДанных.Вставить("РежимПредварительногоВыбораСертификатов",Ложь);
	СтруктураДанных.Вставить("УидФормы");
	СтруктураДанных.Вставить("ПерсональныеНастройкиРаботыСЭЦП", ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентПереопределяемый.ПолучитьПерсональныеНастройкиРаботыСЭЦП());
	СтруктураДанных.Вставить("МассивОписанийСертификатов",Новый Массив);
	СтруктураДанных.Вставить("ФайлыДляСозданияПодписей",Новый Массив);	
		
	Возврат СтруктураДанных;
	
КонецФункции



Процедура ВыбратьСертификатыДляПодписи(СтруктураДанных, Форма = Неопределено) Экспорт  
	Если СтруктураДанных.Отказ Тогда 
		Возврат;
	КонецЕсли;	
	
	Если Не СтруктураДанных.РежимПредварительногоВыбораСертификатов Тогда 
		Возврат;
	КонецЕсли;	
	
	ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентПереопределяемый.ВыбратьСертификатыДляПодписиВнутр(СтруктураДанных,Форма);
	
КонецПроцедуры	

функция ДобавитьПодписьВСтруктуру(СтруктураДанных,Подпись) Экспорт 
	
	ОписаниеСертификата = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьПустуюСтруктуруПараметров("МассивОписанийСертификатов");
	ОписаниеСертификата.СертификатСсылка = Подпись;
	ДанныеСертификата = ВыгрузкаРегламентированнойБухгалтерскойОтчетности.ПолучитьДанныеСертификата(Подпись);
	ОписаниеСертификата.КомуВыданСертификат = ДанныеСертификата.КомуВыдан;
	ОписаниеСертификата.Отпечаток = ДанныеСертификата.Отпечаток;
	ОписаниеСертификата.ДатаПодписи = ТекущаяДата();
	ОписаниеСертификата.УстановившийПодпись = ПользователиКлиентСервер.ТекущийПользователь();
	
	СтруктураДанных.МассивОписанийСертификатов.Добавить(ОписаниеСертификата);
	
	Возврат ОписаниеСертификата;
	
КонецФункции

Процедура СоздатьПодписи(СтруктураДанных, ОбработкаЗаписи = Неопределено) Экспорт 
	Если СтруктураДанных.Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентПереопределяемый.СоздатьПодписиВнутр(СтруктураДанных, ОбработкаЗаписи);
	
КонецПроцедуры	

Процедура ОткрытьСертификат(ТекущийСертификат) Экспорт
	Если ТекущийСертификат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийСертификат.СертификатСсылка) Тогда 
		
		ПоказатьЗначение(,ТекущийСертификат.СертификатСсылка);
		
	Иначе 
		
		ДвоичныеДанныеСертификата = БюджетнаяОтчетностьКлиентСервер.ПрочитатьЗначениеИзXML(ТекущийСертификат.Сертификат, Тип("ДвоичныеДанные"));
		СертификатКриптографии = Новый СертификатКриптографии(ДвоичныеДанныеСертификата);
		ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентПереопределяемый.ОткрытьСертификатСоСтруктурой(ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентПереопределяемый.ЗаполнитьСтруктуруСертификата(СертификатКриптографии), ТекущийСертификат.Отпечаток, Неопределено);
		
	КонецЕсли;
КонецПроцедуры		

// ЭЦП
////////////////////////////////////////////////////////////////////////////////
// Прочее

Процедура ПолучитьУникальноеИмяФайла(Результат, ДополнительныеПараметры) Экспорт 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолучитьУникальноеИмяФайла", ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент, ДополнительныеПараметры);
	
	ШаблонПутиФайла = ДополнительныеПараметры.ШаблонПутиФайла;
	Итератор = ДополнительныеПараметры.Итератор;
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		Если Найти(ШаблонПутиФайла,"%1") = 0 Тогда 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, ШаблонПутиФайла);
			Возврат; 
			
		КонецЕсли;	
		
		ПодставляемоеЗначение = "";
		Если Итератор > 0 Тогда 
			ПодставляемоеЗначение = "("+Итератор+")";
		КонецЕсли;
		ПроверяемыйПуть = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПутиФайла,ПодставляемоеЗначение);
		
		ДополнительныеПараметры.Вставить("ПроверяемыйПуть",ПроверяемыйПуть);
		
		ДополнительныеПараметры.Этап = "ПослеИнициализацииФайла";
		
		Файл = Новый Файл;
		Файл.НачатьИнициализацию(ОписаниеОповещения ,ПроверяемыйПуть);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ПослеИнициализацииФайла" Тогда	
		
		ДополнительныеПараметры.Этап = "ПослеПроверкиСущесвования";
		Результат.НачатьПроверкуСуществования(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ПослеПроверкиСущесвования" Тогда	
		
		Если Результат = Ложь Тогда
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, ДополнительныеПараметры.ПроверяемыйПуть);
			
		Иначе 
			
			ДополнительныеПараметры.Этап = "Завершение";
			
			ДополнительныеПараметрыСледующейИтерации = Новый Структура;
			ДополнительныеПараметрыСледующейИтерации.Вставить("Этап","Начало");
			ДополнительныеПараметрыСледующейИтерации.Вставить("ШаблонПутиФайла",ШаблонПутиФайла);
			ДополнительныеПараметрыСледующейИтерации.Вставить("Итератор",Итератор + 1);
			ДополнительныеПараметрыСледующейИтерации.Вставить("ОбработкаЗавершения",ОписаниеОповещения);
			
			ПолучитьУникальноеИмяФайла(Неопределено, ДополнительныеПараметрыСледующейИтерации);
			
		КонецЕсли;	
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда	
		
		Если ДополнительныеПараметры.Свойство("ОбработкаЗавершения") Тогда 
			
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗавершения, Результат);
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры	

