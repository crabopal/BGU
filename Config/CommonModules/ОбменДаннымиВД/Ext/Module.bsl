КонецПроцедуры

//@skip-check method-too-many-params
Процедура ЗаполнитьПоляПоискаПоПараметрамОбмена(ПоляПоиска, ДополнительныеРеквизиты, ИспользуемыйВариантУчета,
		СтатьяАналитики, КонтрагентПолучательИмуществаТЧ, МетаданныеДокумента, ТиповаяОперация, ПараметрыОбъекта,
		ДопРеквизитыОперации)
	Для каждого ПараметрВариантаУчета Из ИспользуемыйВариантУчета.ПараметрыОбмена Цикл
		
		Если НЕ ЗначениеЗаполнено(ПараметрВариантаУчета.ЗначениеПараметра) Тогда
			Продолжить;
		КонецЕсли;
		
		СоставЗначенияПараметра = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(
			ВРег(ПараметрВариантаУчета.ЗначениеПараметра));
		Если СоставЗначенияПараметра[0] = "ДОКУМЕНТ" Тогда
			ЗаполнитьПоляПоискаПоПараметрамОбменаДокумент(ПоляПоиска, СтатьяАналитики, МетаданныеДокумента,
				ПараметрыОбъекта, ПараметрВариантаУчета, СоставЗначенияПараметра);
		ИначеЕсли СоставЗначенияПараметра[0] = "ДОПОЛНИТЕЛЬНЫЙРЕКВИЗИТ" Тогда
			Если ДопРеквизитыОперации = Неопределено Тогда
				ДопРеквизитыОперации = Справочники.ТиповыеОперации
					.ДополнительныеРеквизитыТиповойОперации(ТиповаяОперация);
			КонецЕсли;
			ЗаполнитьПоляПоискаПоПараметрамОбменаДополнительныйРеквизит(ДополнительныеРеквизиты, СтатьяАналитики,
				КонтрагентПолучательИмуществаТЧ, ПараметрыОбъекта, ДопРеквизитыОперации, СоставЗначенияПараметра,
				ПараметрВариантаУчета);
		КонецЕсли;

	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьПоляПоискаПоПараметрамОбменаДополнительныйРеквизит(ДополнительныеРеквизиты, СтатьяАналитики,
		КонтрагентПолучательИмуществаТЧ, ПараметрыОбъекта, ДопРеквизитыОперации, СоставЗначенияПараметра,
		ПараметрВариантаУчета)
	Для каждого ТекДопРеквизитОперации Из ДопРеквизитыОперации Цикл
		Если ВРЕГ(ТекДопРеквизитОперации.ИмяДляФормулы) <> СоставЗначенияПараметра[1] Тогда
			Продолжить;
		КонецЕсли;
		Если ПараметрВариантаУчета.ИмяПараметра = "КонтрагентПолучательИмущества" Тогда
			Если ЗначениеЗаполнено(КонтрагентПолучательИмуществаТЧ) Тогда
				ДополнительныеРеквизиты.Вставить(ТекДопРеквизитОперации.Ссылка, КонтрагентПолучательИмуществаТЧ);
			Иначе
				ДополнительныеРеквизиты.Вставить(ТекДопРеквизитОперации.Ссылка,
					ПараметрыОбъекта.Получить(ПараметрВариантаУчета.ИмяПараметра));
			КонецЕсли;
		Иначе
			//@skip-check empty-except-statement
			Попытка
				ДополнительныеРеквизиты.Вставить(ТекДопРеквизитОперации.Ссылка,
					СтатьяАналитики[ПараметрВариантаУчета.ИмяПараметра]);
			Исключение
				// ошибочный параметр обрабатывать не требуется
			КонецПопытки;
		КонецЕсли;
		Прервать;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьПоляПоискаПоПараметрамОбменаДокумент(ПоляПоиска, СтатьяАналитики, МетаданныеДокумента,
		ПараметрыОбъекта, ПараметрВариантаУчета, СоставЗначенияПараметра)
	Если ПараметрВариантаУчета.ИмяПараметра = "КонтрагентПолучательИмущества" Тогда
		// Определить тип значения принимающего рекивизита.
		// В разных местах это может быть "Контрагент" или "Сотрудник".
		МетаданныеРеквизита = МетаданныеДокумента.Реквизиты[СоставЗначенияПараметра[1]];
		Если ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(МетаданныеРеквизита.Тип,
				Тип("СправочникСсылка.Контрагенты")) Тогда
			ИспользуемоеИмяПараметра = "КонтрагентПолучательИмущества";
		ИначеЕсли ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(МетаданныеРеквизита.Тип,
				Тип("СправочникСсылка.Сотрудники")) Тогда
	        ИспользуемоеИмяПараметра = "СотрудникПолучатель";
		Иначе
			// Другие типы этого параметра не поддерживаются
			Возврат;
		КонецЕсли;
	Иначе
		ИспользуемоеИмяПараметра = ПараметрВариантаУчета.ИмяПараметра;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтатьяАналитики, ИспользуемоеИмяПараметра) Тогда
		ПоляПоиска.Вставить(СоставЗначенияПараметра[1], СтатьяАналитики[ИспользуемоеИмяПараметра]);
	ИначеЕсли ПараметрыОбъекта.Получить(ИспользуемоеИмяПараметра) <> Неопределено Тогда
		ПоляПоиска.Вставить(СоставЗначенияПараметра[1], ПараметрыОбъекта.Получить(ИспользуемоеИмяПараметра));
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьПоляПоискаПоРеквизитамОперации(ДополнительныеРеквизиты, ИспользуемыйВариантУчета, ТиповаяОперация,
		ДопРеквизитыОперации)
	Для каждого ЗначениеДопРеквизита Из ИспользуемыйВариантУчета.РеквизитыОперации Цикл
		Если ЗначениеДопРеквизита.УстанавливатьЗначение <> Истина Тогда
			Продолжить;
		КонецЕсли;
		Если ДопРеквизитыОперации = Неопределено Тогда
			ДопРеквизитыОперации = Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(ТиповаяОперация);
		КонецЕсли;
		Для каждого ТекДопРеквизитОперации Из ДопРеквизитыОперации Цикл
			Если ВРЕГ(ТекДопРеквизитОперации.ИмяДляФормулы) = ВРЕГ(ЗначениеДопРеквизита.ИмяРеквизита) Тогда
				ДополнительныеРеквизиты.Вставить(ТекДопРеквизитОперации.Ссылка, ЗначениеДопРеквизита.ЗначениеРеквизита);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьПоляПоискаПоРеквизитамДокумента(ПоляПоиска, ИспользуемыйВариантУчета)
	Для каждого ЗначениеРеквизитаДокумента Из ИспользуемыйВариантУчета.РеквизитыДокумента Цикл
		Если ЗначениеРеквизитаДокумента.УстанавливатьЗначение = Истина Тогда
			Если ЗначениеРеквизитаДокумента.ИмяРеквизита = "ПервичныйДокумент" Тогда
				ЗначениеРеквизита = ПервичныеДокументыБГУ.НайтиПоИдентификатору(
					ЗначениеРеквизитаДокумента.ЗначениеРеквизита);
			Иначе
				ЗначениеРеквизита = ЗначениеРеквизитаДокумента.ЗначениеРеквизита;
			КонецЕсли;
			ПоляПоиска.Вставить(ЗначениеРеквизитаДокумента.ИмяРеквизита, ЗначениеРеквизита);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция РанееСозданныеДокументыПоИдИсточника(ПараметрыЗагрузкиОбъекта)
	Параметры = ПараметрыЗагрузкиОбъекта.Параметры;
	ПараметрыОбъекта = ПараметрыЗагрузкиОбъекта.ПараметрыОбъекта;
	ИдИсточника = ПараметрыОбъекта.Получить("ИДИсточника");
	Результат = Новый Массив;
	Если ИДИсточника = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника,
	|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы,
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника,
	|	СоответствияОбъектовИнформационныхБаз.ТипПриемника,
	|	СоответствияОбъектовИнформационныхБаз.ТипИсточника
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	|ГДЕ
	|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы = &УзелИнформационнойБазы
	|	И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника = &ИдИсточника
	|	И НЕ СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника В (&ОбработанныеДокументы)";
	Запрос.УстановитьПараметр("УзелИнформационнойБазы", Параметры.УзелОбменаЗагрузкаДанныхСсылка);
	Запрос.УстановитьПараметр("ИдИсточника", Строка(ИдИсточника));
	Запрос.УстановитьПараметр("ОбработанныеДокументы", Параметры.ДокументыСТекущимИдИсточника);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.УникальныйИдентификаторИсточника);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьРанееСозданныеДокументыПоИдИсточника(ИдентификаторДокумента, ПараметрыЗагрузкиОбъекта)
	
	РанееСозданныеДокументы = РанееСозданныеДокументыПоИдИсточника(ПараметрыЗагрузкиОбъекта);
	
	ОбработкаЗагрузки = ПараметрыЗагрузкиОбъекта.ОбработкаЗагрузки;
	Для Каждого ПрежнийДокумент Из РанееСозданныеДокументы Цикл
		
		// удалим возможные предупреждения по документу	
		НаборЗаписей = РегистрыСведений.РезультатыОбменаДанными.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПроблемныйОбъект.Установить(ПрежнийДокумент);
		НаборЗаписей.Записать(Истина);
		
		ДокументОбъект = ПрежнийДокумент.ПолучитьОбъект();
		Если НЕ ДокументОбъект.ПометкаУдаления Тогда
			Если ДокументОбъект.Проведен Тогда
				ОбработкаЗагрузки.ОтменитьПроведениеОбъектаВИБ(ДокументОбъект, ТипЗнч(ДокументОбъект), Истина);
			КонецЕсли;
			ОбработкаЗагрузки.УстановитьПометкуУдаленияУОбъекта(ДокументОбъект, Истина, "Документ");
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ПровестиДокумент(Объект, ПараметрыЗагрузкиОбъекта)

	ПараметрыОбъекта = ПараметрыЗагрузкиОбъекта.ПараметрыОбъекта;
	Параметры = ПараметрыЗагрузкиОбъекта.Параметры;
	ОбработкаЗагрузки = ПараметрыЗагрузкиОбъекта.ОбработкаЗагрузки;
	СвойстваДляОтложенногоПроведения = ПараметрыЗагрузкиОбъекта.ДополнительныеСвойстваДляОтложенногоПроведения;

	Если ПараметрыЗагрузкиОбъекта.ПараметрыОбъекта.Получить("Проведен") = Истина Тогда
		РежимЗаписи = "Проведение";
	ИначеЕсли Объект.Проведен Тогда
		РежимЗаписи = "ОтменаПроведения";
	Иначе
		РежимЗаписи = "Запись";
	КонецЕсли;
	
	Если Объект.ПометкаУдаления
		И (РежимЗаписи = РежимЗаписиДокумента.Проведение) Тогда
		
		Объект.ПометкаУдаления = Ложь;
		
	КонецЕсли;
	
	ОтправкаНазад = Ложь;
	ТипОбъекта = ТипЗнч(Объект);
	Если РежимЗаписи = "Запись" Тогда
		
		Объект.ПометкаУдаления = ПараметрыОбъекта.Получить("ПометкаУдаления") = Истина;
		ОбработкаЗагрузки.ЗаписатьОбъектВИБ(Объект, ТипОбъекта,, ОтправкаНазад);
		
	ИначеЕсли РежимЗаписи = "ОтменаПроведения" Тогда
		
		ОбработкаЗагрузки.ОтменитьПроведениеОбъектаВИБ(Объект, ТипОбъекта, Истина);
		
	ИначеЕсли РежимЗаписи = "Проведение" Тогда
	
		Объект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
		
		ОбработкаЗагрузки.ОтменитьПроведениеОбъектаВИБ(Объект, ТипОбъекта, Истина);
		
		Если Объект.Ссылка <> Неопределено И Не Параметры.НеПроводитьДокументы Тогда
			СтрокаТаблицы = ОбработкаЗагрузки.ДокументыДляОтложенногоПроведения().Добавить();
			СтрокаТаблицы.ДокументСсылка = Объект.Ссылка;
			СтрокаТаблицы.ДатаДокумента  = Объект.Дата;
			
			// удалим данные авто проведения механизма Типовых операций
			Если Объект.ДополнительныеСвойства.Свойство("ДанныеАвтоПроведения") тОгда
				Объект.ДополнительныеСвойства.Удалить("ДанныеАвтоПроведения");
			КонецЕсли;
				
			СвойстваДляОтложенногоПроведения.Вставить(Объект.Ссылка, Объект.ДополнительныеСвойства);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура СгруппироватьВариантыУчетаПоСпособуРеализации(ВариантыУчета, СгруппированныеВариантыУчета)

	// Собрать таблицу значений вида
	// ВариантУчета
	// ИдентификаторДокумента
	// ТиповаяОперация
	// НеВыгружать
	// РеквизитДокумента_<ИмяРеквизита_1>    // РеквизитДокумента = РД
	// РеквизитДокумента_<ИмяРеквизита_2>
	// .................................
	// РеквизитДокумента_<ИмяРеквизита_N>
	// Параметр_<ИмяПараметра_1>            // Параметр = П
	// Параметр_<ИмяПараметра_2>
	// .................................
	// Параметр_<ИмяПараметра_M>
	// РеквизитОперации_<ИмяРеквизита_1>    // РеквизитОперации = РО
	// РеквизитОперации_<ИмяРеквизита_2>
	// .................................
	// РеквизитОперации_<ИмяРеквизита_K>
	
	// ТаблицаВариантов используется для опеределения одинаковых реализаций разных вариантов учета с текущими данными
	ТаблицаВариантов = Новый ТаблицаЗначений;
	ТаблицаВариантов.Колонки.Добавить("ВариантУчета");
	ТаблицаВариантов.Колонки.Добавить("ВариантУчетаФактический");
	ТаблицаВариантов.Колонки.Добавить("ВариантУчетаПорядок");
	ТаблицаВариантов.Колонки.Добавить("СтатьяАналитики");
	ТаблицаВариантов.Колонки.Добавить("ИдентификаторДокумента");
	ТаблицаВариантов.Колонки.Добавить("ТиповаяОперация");
	ТаблицаВариантов.Колонки.Добавить("НеВыгружать");
	//	ТаблицаВариантов.Колонки.Добавить("КФО"); по КФО не надо, т.к. есть документы, где КФО в таблице. 
	// Надо делать анализ на уровне документа
	ТаблицаВариантов.Колонки.Добавить("ИФО");
	ТаблицаВариантов.Колонки.Добавить("Контрагент");
	ИменаДинамическихКолонок = "";
	ИменаСтатическихКолонок = "ИдентификаторДокумента,ТиповаяОперация,НеВыгружать,ИФО,Контрагент"; //,КФО
	
	// Таблица значений ВариантыУчета содержит 2 колонки: ВариантУчета и СтатьяАналитики из входящего документа
	
	// Добавим колонки в таблицу ТаблицаВариантов
	УникальныеВариантыУчета = ВариантыУчета.Скопировать(,"ВариантУчета");
	УникальныеВариантыУчета.Свернуть("ВариантУчета");
	Для каждого СтрокаВариантУчета Из УникальныеВариантыУчета Цикл
		
		ВариантУчета = СтрокаВариантУчета.ВариантУчета;
		Если Не ЗначениеЗаполнено(ВариантУчета) Тогда
			Продолжить;
		КонецЕсли;
		
		СоставПоследовательности = Новый Массив;
		
		Если ВариантУчета.СпособФормированияОперации = Перечисления.СпособыФормированияОперацийУчетаВещевогоДовольствия
				.ПоследовательностьОпераций Тогда
			Для каждого ЭлементВарианта Из ВариантУчета.СоставПоследовательностиОпераций Цикл
				
				Если ЗначениеЗаполнено(ЭлементВарианта.ОперацияУчетаВещевогоДовольствия) Тогда
					СоставПоследовательности.Добавить(ЭлементВарианта.ОперацияУчетаВещевогоДовольствия);
				КонецЕсли;
			
			КонецЦикла;
		Иначе
			СоставПоследовательности.Добавить(ВариантУчета);
		КонецЕсли;
		
		Для каждого ВариантУчета Из СоставПоследовательности Цикл
		
			Для каждого ИмяРеквизита Из ВариантУчета.РеквизитыДокумента Цикл
				Если ИмяРеквизита = "НеПересчитыватьСумму" Тогда
					// Реквизит "НеПересчитыватьСумму" не должен устанавливаться пользователем явно.
					// Он устанавливается автоматически, в зависимости от настройки обмена на стороне БГУ.
					Продолжить;
				КонецЕсли;
				
				Если ИмяРеквизита.УстанавливатьЗначение Тогда
					ИмяКолонки = "РД_" + ИмяРеквизита.ИмяРеквизита;
					Если ТаблицаВариантов.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
						ТаблицаВариантов.Колонки.Добавить(ИмяКолонки);
						ИменаДинамическихКолонок = ИменаДинамическихКолонок + "," + ИмяКолонки;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла; 
		
			Для каждого ИмяРеквизита Из ВариантУчета.ПараметрыОбмена Цикл
				ИмяКолонки = "П_" + ИмяРеквизита.ИмяПараметра;
				Если ТаблицаВариантов.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
					ТаблицаВариантов.Колонки.Добавить(ИмяКолонки);
					ИменаДинамическихКолонок = ИменаДинамическихКолонок + "," + ИмяКолонки;
				КонецЕсли;
			КонецЦикла; 
		
			Для каждого ИмяРеквизита Из ВариантУчета.РеквизитыОперации Цикл
				Если ИмяРеквизита.УстанавливатьЗначение Тогда
					ИмяКолонки = "РО_" + ИмяРеквизита.ИмяРеквизита;
					Если ТаблицаВариантов.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
						ТаблицаВариантов.Колонки.Добавить(ИмяКолонки);
						ИменаДинамическихКолонок = ИменаДинамическихКолонок + "," + ИмяКолонки;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		
		КонецЦикла;
	
	КонецЦикла;
	// Теперь ТаблицаВариантов содержит колонки, по которым сможем свернуть,
	// чтобы найти уникальные сочетания требуемых значений
	
	// заполним полученную таблицу
	// В колонку ВариантУчетаФактический записывается фактически используемый вариант учета
	// В колонку ВариантУчета записывается вариант учета из исходной таблицы ВариантыУчета
	УникальныеВариантыУчета = ВариантыУчета.Скопировать(,"ВариантУчета,СтатьяАналитики");
	УникальныеВариантыУчета.Свернуть("ВариантУчета,СтатьяАналитики");
	Для каждого СтрокаВариантУчета Из УникальныеВариантыУчета Цикл
		
		ВариантУчета = СтрокаВариантУчета.ВариантУчета;
		Если Не ЗначениеЗаполнено(ВариантУчета) Тогда
			Продолжить;
		КонецЕсли;
		
		СоставПоследовательности = Новый Массив;
		ИсходныйВариантУчета = ВариантУчета;
		
		Если ВариантУчета.СпособФормированияОперации = Перечисления.СпособыФормированияОперацийУчетаВещевогоДовольствия
				.ПоследовательностьОпераций Тогда
			Для каждого ЭлементВарианта Из ВариантУчета.СоставПоследовательностиОпераций Цикл
				Если ЗначениеЗаполнено(ЭлементВарианта.ОперацияУчетаВещевогоДовольствия) Тогда
					СоставПоследовательности.Добавить(ЭлементВарианта.ОперацияУчетаВещевогоДовольствия);
				КонецЕсли;
			КонецЦикла;
		Иначе
			СоставПоследовательности.Добавить(ВариантУчета);
		КонецЕсли;
		
		ВариантУчетаПорядок = 0;
		Для каждого ВариантУчета Из СоставПоследовательности Цикл
			ВариантУчетаПорядок = ВариантУчетаПорядок + 1;
			СтатьяАналитики = СтрокаВариантУчета.СтатьяАналитики;
			НоваяСтрока = ТаблицаВариантов.Добавить();
			НоваяСтрока.ВариантУчета = ИсходныйВариантУчета;
			НоваяСтрока.ВариантУчетаФактический = ВариантУчета;
			НоваяСтрока.ВариантУчетаПорядок = ВариантУчетаПорядок;
			НоваяСтрока.СтатьяАналитики = СтатьяАналитики;
			НоваяСтрока.ИдентификаторДокумента = ВариантУчета.ИдентификаторДокумента;
			НоваяСтрока.ТиповаяОперация = ВариантУчета.ТиповаяОперация;
			НоваяСтрока.НеВыгружать = (ВариантУчета.СпособФормированияОперации
				= Перечисления.СпособыФормированияОперацийУчетаВещевогоДовольствия.ОперацияНеПереносится);
			ДанныеСтатьиАналитики = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтатьяАналитики, "ИФО, КФО");
			НоваяСтрока.ИФО = ДанныеСтатьиАналитики.ИФО;
			
			Для каждого ИмяРеквизита Из ВариантУчета.РеквизитыДокумента Цикл
				Если ИмяРеквизита.УстанавливатьЗначение Тогда
					НоваяСтрока["РД_" + ИмяРеквизита.ИмяРеквизита] = ИмяРеквизита.ЗначениеРеквизита;
				КонецЕсли;
			КонецЦикла;
			
			Для каждого ИмяРеквизита Из ВариантУчета.ПараметрыОбмена Цикл
				НоваяСтрока["П_" + ИмяРеквизита.ИмяПараметра] = ВРЕГ(ИмяРеквизита);
				Если ТаблицаВариантов.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
					ТаблицаВариантов.Колонки.Добавить(ИмяКолонки);
					ИменаДинамическихКолонок = ИменаДинамическихКолонок + "," + ИмяКолонки;
				КонецЕсли;
			КонецЦикла;
		
			Для каждого ИмяРеквизита Из ВариантУчета.РеквизитыОперации Цикл
				Если ИмяРеквизита.УстанавливатьЗначение Тогда
					НоваяСтрока["РО_" + ИмяРеквизита.ИмяРеквизита] = ИмяРеквизита.ЗначениеРеквизита;
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	// Теперь ТаблицаВариантов содержит все необходимые данные для свертки
	
	ТаблицаНастроек = ТаблицаВариантов.Скопировать(,ИменаСтатическихКолонок + ИменаДинамическихКолонок);
	ТаблицаНастроек.Свернуть(ИменаСтатическихКолонок + ИменаДинамическихКолонок);
	
	// на первом уровне будут добавлены идентификаторы создаваемых документов
	// на втором уровне будут содержаться сочетания вариант учета (выбранный в документе) и статьи аналитики
	СгруппированныеВариантыУчета = Новый ДеревоЗначений;
	СгруппированныеВариантыУчета.Колонки.Добавить("ВариантУчета");
	СгруппированныеВариантыУчета.Колонки.Добавить("ВариантУчетаФактический");
	СгруппированныеВариантыУчета.Колонки.Добавить("ИдентификаторДокумента");
	СгруппированныеВариантыУчета.Колонки.Добавить("СдвигВремениДокумента", Новый ОписаниеТипов("Число")); // в дальнейшем будет содержать число секунд для корректировки
	СгруппированныеВариантыУчета.Колонки.Добавить("СтатьяАналитики");
	
	Для каждого ТекНастройка Из ТаблицаНастроек Цикл
	
		Отбор = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТекНастройка);
		ПодходящиеВарианты = ТаблицаВариантов.Скопировать(ТаблицаВариантов.НайтиСтроки(Отбор));
		
		ТаблицаИдентификаторов = ПодходящиеВарианты.Скопировать(,
			"ВариантУчетаПорядок,ИдентификаторДокумента,ВариантУчета,ВариантУчетаФактический");
		ТаблицаИдентификаторов.Свернуть(
			"ВариантУчетаПорядок,ИдентификаторДокумента,ВариантУчета,ВариантУчетаФактический");
		ТаблицаИдентификаторов.Сортировать("ВариантУчетаПорядок");
		
		ОтборИдентификатора = Новый Структура("ВариантУчетаПорядок,ИдентификаторДокумента,ВариантУчета");
		Для каждого СтрокаИдентификатора Из ТаблицаИдентификаторов Цикл
		
			НоваяСтрокаИдентификатора = СгруппированныеВариантыУчета.Строки.Добавить();
			НоваяСтрокаИдентификатора.ИдентификаторДокумента = СтрокаИдентификатора.ИдентификаторДокумента;
			НоваяСтрокаИдентификатора.ВариантУчетаФактический = СтрокаИдентификатора.ВариантУчетаФактический;
			НоваяСтрокаИдентификатора.ВариантУчета = СтрокаИдентификатора.ВариантУчета;
			НоваяСтрокаИдентификатора.СдвигВремениДокумента = 0;
			
			ЗаполнитьЗначенияСвойств(ОтборИдентификатора, СтрокаИдентификатора);
			ВариантыТекущегоИдентификатора = ПодходящиеВарианты.НайтиСтроки(ОтборИдентификатора);
			
			Для каждого ТекСтрокаВарианта Из ВариантыТекущегоИдентификатора Цикл
				ДетальнаяСтрока = НоваяСтрокаИдентификатора.Строки.Добавить();
				ДетальнаяСтрока.ВариантУчета = ТекСтрокаВарианта.ВариантУчета;
				ДетальнаяСтрока.СтатьяАналитики = ТекСтрокаВарианта.СтатьяАналитики;
			КонецЦикла;
		
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьКорректировкуВремениДокумента(СгруппированныеВариантыУчета,ПараметрыОбъекта)

	РазличныеВариантыУчета = Новый Массив;
	Для каждого СтрокаВариантаУчета Из СгруппированныеВариантыУчета.Строки Цикл
		Если РазличныеВариантыУчета.Найти(СтрокаВариантаУчета.ВариантУчета) = Неопределено Тогда
			РазличныеВариантыУчета.Добавить(СтрокаВариантаУчета.ВариантУчета);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ПроверяемыйВариантУчета Из РазличныеВариантыУчета Цикл
	
		ВетвиПроверяемогоВариантаУчета = СгруппированныеВариантыУчета.Строки.НайтиСтроки(
			Новый Структура("ВариантУчета", ПроверяемыйВариантУчета), Ложь);
		КоличествоИдентификаторов = ВетвиПроверяемогоВариантаУчета.Количество();
		Если КоличествоИдентификаторов > 1 Тогда
			// требуется корректировка времени создаваемых документов
			// документы разных видов будут располагаться на оси времени последовательно,
			// чтобы сохранить порядок поступления и списания МЗ
			
			_ТипДата = Новый ОписаниеТипов("Дата");
			ДатаДокумента = _ТипДата.ПривестиЗначение(ПараметрыОбъекта.Получить("Дата"));
			Если (ДатаДокумента + КоличествоИдентификаторов) <= КонецДня(ДатаДокумента) Тогда
				// можно просто добавлять секунду каждому следующему идентификатору
				Корректировка = 0;
			Иначе
				// видимо, документ уже в конце дня
				// заранее уменьшим время первого идентификатора и будем увеличивать у следующих
				Корректировка = -(КоличествоИдентификаторов - 1);
			КонецЕсли;
			Для каждого ВерхняяГруппаВариантовУчета Из ВетвиПроверяемогоВариантаУчета Цикл
				ВерхняяГруппаВариантовУчета.СдвигВремениДокумента = Корректировка;
				Корректировка = Корректировка + 1;
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьСоответствиеОбъектовИБ(Объект, ПараметрыОбъекта, ТипДокумента, Параметры)

	СоответствияОбъектов = Новый Структура;
	СоответствияОбъектов.Вставить("УникальныйИдентификаторИсточника");
	СоответствияОбъектов.Вставить("УзелИнформационнойБазы", Параметры.УзелОбменаЗагрузкаДанныхСсылка);
	СоответствияОбъектов.Вставить("УникальныйИдентификаторПриемника", Строка(ПараметрыОбъекта.Получить("ИДИсточника")));
	СоответствияОбъектов.Вставить("ТипИсточника", "ДокументСсылка." + ТипДокумента);
	СоответствияОбъектов.Вставить("ТипПриемника", ПараметрыОбъекта.Получить("ВидДокументаСтрокой"));
	
	Объект.ДополнительныеСвойства.Вставить("СоответствияОбъектовИнформационныхБаз", СоответствияОбъектов);

КонецПроцедуры

#КонецОбласти
