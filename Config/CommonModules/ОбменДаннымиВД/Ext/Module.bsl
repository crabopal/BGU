
#Область ПрограммныйИнтерфейс

// После загрузки параметров.
// 
// Параметры:
//  Параметры - Структура:
Процедура ПослеЗагрузкиПараметров(Параметры) Экспорт
	Параметры.Вставить("МассивДокументов",Неопределено);
	Параметры.Вставить("ДокументыСТекущимИдИсточника");
	Параметры.Вставить("РанееСозданныеДокументыСТекущимИдИсточника");
	Параметры.Вставить("НеПроводитьДокументы", Ложь);
	Параметры.Вставить("Счета27", БухгалтерскийУчет.СписокСчетов("27"));
	
	// описываем возможные виды документов
	
	ОписанияДокументов = Новый Соответствие; // Соответствие из СправочникСсылка.ИдентификаторыОбъектовМетаданных
	
	// ПоступлениеМЗ
	СтруктураРеквизитов = НовыйОписаниеДокумента(Тип("ДокументСсылка.ПоступлениеМЗ"));
	СтруктураРеквизитов.ИмяТЧМатериалы = "Материалы";
	СтруктураРеквизитов.ЕстьОтправитель = Ложь;
	СтруктураРеквизитов.ЕстьПолучательВШапке = Истина;
	СтруктураРеквизитов.ИмяЦМОПолучательВШапке = "ЦМО";
	СтруктураРеквизитов.ИмяПодразделениеПолучательВШапке = "Подразделение";
	СтруктураРеквизитов.ЕстьПолучательВТЧ = Ложь;
	ОписанияДокументов.Вставить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(СтруктураРеквизитов.ОписаниеТипаДокумента), СтруктураРеквизитов);
	
	// НакладнаяНаОтпускМ15
	СтруктураРеквизитов = НовыйОписаниеДокумента(Тип("ДокументСсылка.НакладнаяНаОтпускМ15"));
	СтруктураРеквизитов.ИмяТЧМатериалы = "Материалы";
	СтруктураРеквизитов.ЕстьОтправитель = Истина;
	СтруктураРеквизитов.ИмяЦМООтправитель = "ЦМО";
	СтруктураРеквизитов.ИмяПодразделениеОтправитель = "Подразделение";
	СтруктураРеквизитов.ЕстьПолучательВШапке = Ложь;
	СтруктураРеквизитов.ЕстьПолучательВТЧ = Ложь;
	ОписанияДокументов.Вставить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(СтруктураРеквизитов.ОписаниеТипаДокумента), СтруктураРеквизитов);
	
	// ТребованиеНакладная0315006
	СтруктураРеквизитов = НовыйОписаниеДокумента(Тип("ДокументСсылка.ТребованиеНакладная0315006"));
	СтруктураРеквизитов.ИмяТЧМатериалы = "Материалы";
	СтруктураРеквизитов.ЕстьОтправитель = Истина;
	СтруктураРеквизитов.ИмяЦМООтправитель = "ЦМООтправитель";
	СтруктураРеквизитов.ИмяПодразделениеОтправитель = "ПодразделениеОтправитель";
	СтруктураРеквизитов.ЕстьПолучательВШапке = Истина;
	СтруктураРеквизитов.ИмяЦМОПолучательВШапке = "ЦМОПолучатель";
	СтруктураРеквизитов.ИмяПодразделениеПолучательВШапке = "ПодразделениеПолучатель";
	СтруктураРеквизитов.ЕстьПолучательВТЧ = Ложь;
	ОписанияДокументов.Вставить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(СтруктураРеквизитов.ОписаниеТипаДокумента), СтруктураРеквизитов);
	
	// АктСписанияМЗ
	СтруктураРеквизитов = НовыйОписаниеДокумента(Тип("ДокументСсылка.АктСписанияМЗ"));
	СтруктураРеквизитов.ИмяТЧМатериалы = "Материалы";
	СтруктураРеквизитов.ЕстьОтправитель = Истина;
	СтруктураРеквизитов.ИмяЦМООтправитель = "ЦМООтправитель";
	СтруктураРеквизитов.ИмяПодразделениеОтправитель = "ПодразделениеОтправитель";
	СтруктураРеквизитов.ЕстьПолучательВШапке = Ложь;
	СтруктураРеквизитов.ЕстьПолучательВТЧ = Ложь;
	ОписанияДокументов.Вставить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(СтруктураРеквизитов.ОписаниеТипаДокумента), СтруктураРеквизитов);
	
	// АктСписанияМягкогоИХозИнвентаря
	СтруктураРеквизитов = НовыйОписаниеДокумента(Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаря"));
	СтруктураРеквизитов.ИмяТЧМатериалы = "Материалы";
	СтруктураРеквизитов.ЕстьОтправитель = Истина;
	СтруктураРеквизитов.ИмяЦМООтправитель = "ЦМООтправитель";
	СтруктураРеквизитов.ИмяПодразделениеОтправитель = "ПодразделениеОтправитель";
	СтруктураРеквизитов.ЕстьПолучательВШапке = Ложь;
	СтруктураРеквизитов.ЕстьПолучательВТЧ = Ложь;
	ОписанияДокументов.Вставить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(СтруктураРеквизитов.ОписаниеТипаДокумента), СтруктураРеквизитов);
	
	// НакладнаяНаОтпускМ15
	СтруктураРеквизитов = НовыйОписаниеДокумента(Тип("ДокументСсылка.НакладнаяНаОтпускМ15"));
	СтруктураРеквизитов.ИмяТЧМатериалы = "Материалы";
	СтруктураРеквизитов.ЕстьОтправитель = Истина;
	СтруктураРеквизитов.ИмяЦМООтправитель = "ЦМО";
	СтруктураРеквизитов.ИмяПодразделениеОтправитель = "Подразделение";
	СтруктураРеквизитов.ЕстьПолучательВШапке = Ложь;
	СтруктураРеквизитов.ЕстьПолучательВТЧ = Ложь;
	ОписанияДокументов.Вставить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(СтруктураРеквизитов.ОписаниеТипаДокумента), СтруктураРеквизитов);
	
	// ВедомостьНаВыдачуМЗНаНуждыУчреждения
	СтруктураРеквизитов = НовыйОписаниеДокумента(Тип("ДокументСсылка.ВедомостьНаВыдачуМЗНаНуждыУчреждения"));
	СтруктураРеквизитов.ИмяТЧМатериалы = "МатериальныеЗапасы";
	СтруктураРеквизитов.ЕстьОтправитель = Истина;
	СтруктураРеквизитов.ИмяЦМООтправитель = "ЦМО";
	СтруктураРеквизитов.ИмяПодразделениеОтправитель = "Подразделение";
	СтруктураРеквизитов.ЕстьПолучательВШапке = Ложь;
	СтруктураРеквизитов.ЕстьПолучательВТЧ = Истина;
	СтруктураРеквизитов.ИмяЦМОПолучательВТЧ = "ЦМОПолучатель";
	СтруктураРеквизитов.ИмяПодразделениеПолучательВТЧ = "ПодразделениеПолучатель";
	ОписанияДокументов.Вставить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(СтруктураРеквизитов.ОписаниеТипаДокумента), СтруктураРеквизитов);
	
	// Сторно
	СтруктураРеквизитов = НовыйОписаниеДокумента(Тип("ДокументСсылка.Сторно"));
	ОписанияДокументов.Вставить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(СтруктураРеквизитов.ОписаниеТипаДокумента), СтруктураРеквизитов);
	
	Параметры.Вставить("ОписанияДокументов", ОписанияДокументов);

КонецПроцедуры

// После получения узлов обмена.
// 
// Параметры:
//  Параметры - Структура
//  УзелОбменаЗагрузкаДанных - ПланОбменаСсылка.ОбменВДБГУ2
Процедура ПослеПолученияУзловОбмена(Параметры, УзелОбменаЗагрузкаДанных) Экспорт
	Параметры.Вставить("УзелОбменаЗагрузкаДанныхСсылка", УзелОбменаЗагрузкаДанных);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбменВДБГУ2.ЗагружатьСуммыВыбытияМЗ,
	|	ОбменВДБГУ2.ЗапрещатьПовторнуюЗагрузкуОбъектов,
	|	ОбменВДБГУ2.НеПроводитьДокументы
	|ИЗ
	|	ПланОбмена.ОбменВДБГУ2 КАК ОбменВДБГУ2
	|ГДЕ
	|	ОбменВДБГУ2.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбменВДБГУ2ЦМОСлужебные.ЦМО,
	|	ОбменВДБГУ2ЦМОСлужебные.ЦМО.Владелец КАК Организация,
	|	ОбменВДБГУ2ЦМОСлужебные.Подразделение
	|ИЗ
	|	ПланОбмена.ОбменВДБГУ2.ЦМОСлужебные КАК ОбменВДБГУ2ЦМОСлужебные
	|ГДЕ
	|	ОбменВДБГУ2ЦМОСлужебные.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Параметры.УзелОбменаЗагрузкаДанныхСсылка);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	НастройкиПланаОбмена = РезультатЗапроса[0].Выбрать();
	НастройкиПланаОбмена.Следующий();
	
	Параметры.Вставить("ЗагружатьСуммыВыбытияМЗ", НастройкиПланаОбмена.ЗагружатьСуммыВыбытияМЗ);
	Параметры.Вставить("ЗапрещатьПовторнуюЗагрузкуОбъектов", НастройкиПланаОбмена.ЗапрещатьПовторнуюЗагрузкуОбъектов);
	Параметры.Вставить("НеПроводитьДокументы", НастройкиПланаОбмена.НеПроводитьДокументы);
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса[1].Выбрать();
	СоответствиеЦМО = Новый Соответствие;
	СоответствиеПодразделений = Новый Соответствие;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СоответствиеЦМО.Вставить(ВыборкаДетальныеЗаписи.Организация,ВыборкаДетальныеЗаписи.ЦМО);
		СоответствиеПодразделений.Вставить(ВыборкаДетальныеЗаписи.Организация,ВыборкаДетальныеЗаписи.Подразделение);
	КонецЦикла;
	
	Параметры.Вставить("СоответствиеЦМО",СоответствиеЦМО);
	Параметры.Вставить("СоответствиеПодразделений",СоответствиеПодразделений);
КонецПроцедуры

// После загрузки объекта.
// 
// Параметры:
//  ПараметрыЗагрузкиОбъекта - Структура:
//   * ФайлОбмена - ЧтениеXML
//   * Ссылка - ЛюбаяСсылка
//   * Объект - Произвольный
//   * ПараметрыОбъекта - Соответствие из Строка
//   * ИмяТипаОбъекта - Строка
//   * Параметры - Соответствие из Строка
//   * ОбработкаЗагрузки - ОбработкаОбъект.КонвертацияОбъектовИнформационныхБаз
//   * УзелОбменаЗагрузкаДанных - ПланОбменаСсылка.ОбменВДБГУ2
//   * ДополнительныеСвойстваДляОтложенногоПроведения - Соответствие из Структура
//  Отказ - Булево
//  ОбъектМодифицирован - Булево
//  ОбъектНайден - Булево
Процедура ПослеЗагрузкиОбъекта(ПараметрыЗагрузкиОбъекта, Отказ, ОбъектМодифицирован, ОбъектНайден) Экспорт
	
	Если ПараметрыЗагрузкиОбъекта.ИмяТипаОбъекта = "Документ" Тогда
		Если ПараметрыЗагрузкиОбъекта.ПараметрыОбъекта.Получить("ВидДокументаСтрокой") <> "ДокументСсылка.Сторно" Тогда
			ОбщиеДействияПослеЗагрузкиДокумента(ПараметрыЗагрузкиОбъекта, Отказ);
		Иначе
			ЗагрузитьДокументСторно(ПараметрыЗагрузкиОбъекта, Отказ);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Проверяет, что документ загружен из ВД, по данным регистра ОбъектыЗагруженныеИзВД.
// 
// Параметры:
//  Ссылка - ЛюбаяСсылка
// 
// Возвращаемое значение:
//  Булево - Документ загружен из ВД
Функция ДокументЗагруженИзВД(Ссылка) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	РегистрСведений.ОбъектыЗагруженныеИзВД КАК ОбъектыЗагруженныеИзВД
	|ГДЕ
	|	ОбъектыЗагруженныеИзВД.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Ссылка);
	УстановитьПривилегированныйРежим(Истина);
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Новый описание документа.
// 
// Возвращаемое значение:
//  Структура - Новый описание документа:
// * ИмяТипаДокумента - Строка - 
// * ОписаниеТипаДокумента - Тип - 
// * МетаданныеДокумента - ОбъектМетаданных - 
// * ИмяТЧМатериалы - Строка - 
// * ЕстьОтправитель - Булево - 
// * ИмяЦМООтправитель - Строка - 
// * ИмяПодразделениеОтправитель - Строка - 
// * ИмяСотрудникОтправитель - Строка - 
// * ИмяКонтрагентОтправитель - Строка - 
// * ЕстьПолучательВШапке - Булево - 
// * ИмяЦМОПолучательВШапке - Строка - 
// * ИмяПодразделениеПолучательВШапке - Строка - 
// * ИмяСотрудникПолучательВШапке - Строка - 
// * ИмяКонтрагентПолучательВШапке - Строка - 
// * ЕстьПолучательВТЧ - Булево - 
// * ИмяЦМОПолучательВТЧ - Строка - 
// * ИмяПодразделениеПолучательВТЧ - Строка - 
// * ИмяСотрудникПолучательВТЧ - Строка - 
// * ИмяКонтрагентПолучательВТЧ - Строка - 
Функция НовыйОписаниеДокумента(ТипДокумента = Неопределено)
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ИмяТипаДокумента", "");
	СтруктураРеквизитов.Вставить("ОписаниеТипаДокумента");
	СтруктураРеквизитов.Вставить("МетаданныеДокумента");
	СтруктураРеквизитов.Вставить("ИмяТЧМатериалы", "");
	СтруктураРеквизитов.Вставить("ЕстьОтправитель", Ложь);
	СтруктураРеквизитов.Вставить("ИмяЦМООтправитель", "");
	СтруктураРеквизитов.Вставить("ИмяПодразделениеОтправитель", "");
	СтруктураРеквизитов.Вставить("ИмяСотрудникОтправитель", "");
	СтруктураРеквизитов.Вставить("ИмяКонтрагентОтправитель", "");
	СтруктураРеквизитов.Вставить("ЕстьПолучательВШапке", Ложь);
	СтруктураРеквизитов.Вставить("ИмяЦМОПолучательВШапке", "");
	СтруктураРеквизитов.Вставить("ИмяПодразделениеПолучательВШапке", "");
	СтруктураРеквизитов.Вставить("ИмяСотрудникПолучательВШапке", "");
	СтруктураРеквизитов.Вставить("ИмяКонтрагентПолучательВШапке", "");
	СтруктураРеквизитов.Вставить("ЕстьПолучательВТЧ", Ложь);
	СтруктураРеквизитов.Вставить("ИмяЦМОПолучательВТЧ", "");
	СтруктураРеквизитов.Вставить("ИмяПодразделениеПолучательВТЧ", "");
	СтруктураРеквизитов.Вставить("ИмяСотрудникПолучательВТЧ", "");
	СтруктураРеквизитов.Вставить("ИмяКонтрагентПолучательВТЧ", "");
	Если ТипДокумента <> Неопределено Тогда
		СтруктураРеквизитов.ОписаниеТипаДокумента = ТипДокумента;
		СтруктураРеквизитов.МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипДокумента);
		СтруктураРеквизитов.ИмяТипаДокумента = СтруктураРеквизитов.МетаданныеДокумента.Имя;
	КонецЕсли; 
	//@skip-check constructor-function-return-section
	Возврат СтруктураРеквизитов;
КонецФункции

Процедура ВыполнитьДействияПослеЗагрузкиДокумента(ЗагруженныйДокумент, ПараметрыЗагрузкиОбъекта)
	Параметры = ПараметрыЗагрузкиОбъекта.Параметры;
	Параметры.ДокументыСТекущимИдИсточника.Добавить(ЗагруженныйДокумент.Ссылка);
КонецПроцедуры

Процедура ЗагрузитьДокументСторно(ПараметрыЗагрузкиОбъекта, Отказ)
	Отказ = Истина;
	Параметры = ПараметрыЗагрузкиОбъекта.Параметры; 
	Параметры.ДокументыСТекущимИдИсточника = Новый Массив;
	ПараметрыОбъекта = ПараметрыЗагрузкиОбъекта.ПараметрыОбъекта;
	ПометкаУдаления = ПараметрыОбъекта.Получить("ПометкаУдаления") = Истина;
	// Документ загружается только если он не помечен на удаление.
	// Если установлена пометка удаления, то нужно только пометить на удаление все ранее загруженные 
	// документы по этому ИДИсточника.
	Если Не ПометкаУдаления Тогда
		СторнируемыеДокументы = ПолучитьДокументыПоИдИсточника(
			ПараметрыОбъекта.Получить("ИДСторнируемогоДокумента"));
		ОписаниеДокумента = Параметры.ОписанияДокументов.Получить(
			ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.Сторно"))); // см. НовыйОписаниеДокумента
		МетаданныеДокумента = ОписаниеДокумента.МетаданныеДокумента;
		ТипДокумента = ОписаниеДокумента.МетаданныеДокумента.Имя;
		Для Каждого СторнируемыйДокумент Из СторнируемыеДокументы Цикл
			Объект = Документы.Сторно.СоздатьДокумент();
			ЗаполнитьШапкуДокумента (Объект, МетаданныеДокумента, ПараметрыЗагрузкиОбъекта);
			Объект.ДокументОснование = СторнируемыйДокумент;
			Объект.ЗаполнитьПоДокументуОснованию(Истина, Ложь);
			УстановитьСоответствиеОбъектовИБ (Объект, ПараметрыОбъекта, ТипДокумента,
				Параметры);
			// принудительно отменяем проведение
			Объект.Проведен = Ложь;
			Объект.ПометкаУдаления = ПометкаУдаления;
			Если Объект.ЭтоНовый() Тогда
				Объект.УстановитьНовыйНомер();
			КонецЕсли;
			Объект.ДополнительныеСвойства.Вставить("НеРегистрироватьОбъектыЗагруженныеИзВД", Истина);
			ПараметрыЗагрузкиОбъекта.ОбработкаЗагрузки.ЗаписатьОбъектВИБ(Объект, ТипЗнч(Объект));
			Объект.ДополнительныеСвойства.Удалить("НеРегистрироватьОбъектыЗагруженныеИзВД");
			
			ПровестиДокумент (Объект, ПараметрыЗагрузкиОбъекта);
			РегистрыСведений.ОбъектыЗагруженныеИзВД.ОбновитьЗаписьПриЗагрузке(Объект,
				Параметры.УзелОбменаЗагрузкаДанныхСсылка,
				Параметры.ЗапрещатьПовторнуюЗагрузкуОбъектов,
				ПараметрыОбъекта.Получить("ПредставлениеИсходногоДокумента"),
				Строка(ПараметрыОбъекта.Получить("ИДИсточника")));
			
			ВыполнитьДействияПослеЗагрузкиДокумента(Объект, ПараметрыЗагрузкиОбъекта);
		КонецЦикла;
	КонецЕсли;
	
	ИдентификаторДокумента = ПараметрыЗагрузкиОбъекта.ПараметрыОбъекта.Получить("ИдДокумента");
	ПроверитьРанееСозданныеДокументыПоИдИсточника (ИдентификаторДокумента, ПараметрыЗагрузкиОбъекта);
	
КонецПроцедуры

Функция ПолучитьДокументыПоИдИсточника(ИдИсточника)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	|ГДЕ
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника = &ИдИсточника";
	Запрос.УстановитьПараметр("ИдИсточника", Строка(ИдИсточника));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("УникальныйИдентификаторИсточника");
	
КонецФункции

Процедура ДобавитьПредупреждениеОЗапретеЗагрузки(ПараметрыЗагрузкиОбъекта, РанееСозданныеДокументы, ПричиныБлокировки)
	
	ОписанияПричинБлокировки = Новый Массив;
	Для Каждого КлючИЗначение Из ПричиныБлокировки Цикл
		ОписанияПричинБлокировки.Добавить(
			РегистрыСведений.ОбъектыЗагруженныеИзВД.НаименованиеПричины(
				КлючИЗначение.Ключ,
				ОбщегоНазначения.КодОсновногоЯзыка()));
	КонецЦикла;
	
	ЗагружаемыйДокумент = РанееСозданныеДокументы[0];
	СтрокаСообщения = СтрШаблон(НСтр("ru = 'Не удалось загрузить изменения документа %1, ранее загруженного из другой информационной базы.
		|По причине:
		|%2.'",
		ОбщегоНазначения.КодОсновногоЯзыка()),
		Строка(ЗагружаемыйДокумент),
		СтрСоединить(ОписанияПричинБлокировки, "," + Символы.ПС));
	
	ЗаписьЖурналаРегистрации(ОбменДаннымиСервер.СобытиеЖурналаРегистрацииОбменДанными(),
		УровеньЖурналаРегистрации.Предупреждение,,,
		СтрокаСообщения);

	Попытка
		РегистрыСведений.РезультатыОбменаДанными.ЗарегистрироватьОшибкуПроверкиОбъекта(ЗагружаемыйДокумент,
			ПараметрыЗагрузкиОбъекта.УзелОбменаЗагрузкаДанных,
			СтрокаСообщения, Перечисления.ТипыПроблемОбменаДанными.НепроведенныйДокумент);
	Исключение
		СтрокаСообщения = НСтр("ru = 'Ошибка при записи результата обмена данными для объекта ""%1:
							   |%2'", ОбщегоНазначения.КодОсновногоЯзыка());
		ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, 
			Строка(ЗагружаемыйДокумент), ОписаниеОшибки);
		
		ЗаписьЖурналаРегистрации(ОбменДаннымиСервер.СобытиеЖурналаРегистрацииОбменДанными(),
			УровеньЖурналаРегистрации.Ошибка,,, СтрокаСообщения);	
	КонецПопытки	
КонецПроцедуры

Процедура ОбщиеДействияПослеЗагрузкиДокумента(ПараметрыЗагрузкиОбъекта, Отказ)

	Отказ = Истина;
	ПараметрыОбъекта = ПараметрыЗагрузкиОбъекта.ПараметрыОбъекта;
	Параметры = ПараметрыЗагрузкиОбъекта.Параметры;
	УзелОбменаЗагрузкаДанных = ПараметрыЗагрузкиОбъекта.УзелОбменаЗагрузкаДанных;
	
	ТаблицаМатериалы = ПараметрыОбъекта.Получить("МатериалыТабличнаяЧасть");
	Если ТаблицаМатериалы <> Неопределено Тогда
		
		ДополнитьПолучателемТаблицуМатериалы(ТаблицаМатериалы, ПараметрыОбъекта);
		
		Параметры.ДокументыСТекущимИдИсточника = Новый Массив;
		Параметры.РанееСозданныеДокументыСТекущимИдИсточника = РанееСозданныеДокументыПоИдИсточника(
			ПараметрыЗагрузкиОбъекта);
		СостояниеЗапрета = РегистрыСведений.ОбъектыЗагруженныеИзВД.ПричиныБлокировки(
			Параметры.РанееСозданныеДокументыСТекущимИдИсточника);
		Если СостояниеЗапрета <> Неопределено Тогда
			ДобавитьПредупреждениеОЗапретеЗагрузки(ПараметрыЗагрузкиОбъекта,
				Параметры.РанееСозданныеДокументыСТекущимИдИсточника,
				СостояниеЗапрета);
			Возврат;
		КонецЕсли;
		
		ВариантыУчета = ТаблицаМатериалы.Скопировать(,"ВариантУчета, СтатьяАналитики");
		
		СгруппированныеВариантыУчета = Неопределено;
		СгруппироватьВариантыУчетаПоСпособуРеализации (ВариантыУчета, СгруппированныеВариантыУчета);
		УстановитьКорректировкуВремениДокумента (СгруппированныеВариантыУчета,ПараметрыОбъекта);
		
		Для каждого ВерхняяГруппаВариантовУчета Из СгруппированныеВариантыУчета.Строки Цикл
			// на верхнем уровне - идентификатор документа
			Для каждого ГруппаВариантовУчета Из ВерхняяГруппаВариантовУчета.Строки Цикл
				
				Если ГруппаВариантовУчета.ВариантУчета.СпособФормированияОперации
						= Перечисления.СпособыФормированияОперацийУчетаВещевогоДовольствия.ОперацияНеПереносится Тогда
					Продолжить;
				КонецЕсли;
				
				ТаблицаВариантовУчета = Неопределено;
				ДополнительноРазделитьТаблицуВариантовУчетаПоКФО (ВерхняяГруппаВариантовУчета, ТаблицаВариантовУчета);
				
				ТаблицаКФО = ТаблицаВариантовУчета.Скопировать(,"КФО");
				ТаблицаКФО.Свернуть("КФО");
				КФОДокумента = ТаблицаКФО.ВыгрузитьКолонку("КФО");
				Для каждого ТекКФОДокумента Из КФОДокумента Цикл
					
					ДопустимыеВариантыУчета = Новый ТаблицаЗначений;
					ДопустимыеВариантыУчета.Колонки.Добавить("ВариантУчета");
					ДопустимыеВариантыУчета.Колонки.Добавить("СтатьяАналитики");
					Для каждого СтрокаВариантаУчета Из ТаблицаВариантовУчета Цикл
						
						Если ЗначениеЗаполнено(ГруппаВариантовУчета.СтатьяАналитики)
							И ГруппаВариантовУчета.СтатьяАналитики <> СтрокаВариантаУчета.СтатьяАналитики Тогда
							Продолжить;
						КонецЕсли;
							
						Если СтрокаВариантаУчета.КФО = ТекКФОДокумента Тогда
							СтрокаДопустимогоВарианта = ДопустимыеВариантыУчета.Добавить();
							ЗаполнитьЗначенияСвойств(СтрокаДопустимогоВарианта, СтрокаВариантаУчета);
							СтрокаДопустимогоВарианта.ВариантУчета = СтрокаВариантаУчета.ВариантУчета;
						КонецЕсли;
						
					КонецЦикла; 
					
					Если ДопустимыеВариантыУчета.Количество() = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					ИспользуемыйВариантУчета = ВерхняяГруппаВариантовУчета.ВариантУчетаФактический;
					СтатьяАналитики = ДопустимыеВариантыУчета[0].СтатьяАналитики;
					Объект = Неопределено;
					
					ОписаниеДокумента = Параметры.ОписанияДокументов.Получить(
						ВерхняяГруппаВариантовУчета.ИдентификаторДокумента);
					Если ОписаниеДокумента = Неопределено Тогда
						
						ЗаписатьОшибкуПоискаОписанияДокумента (ВерхняяГруппаВариантовУчета, УзелОбменаЗагрузкаДанных);
						Продолжить;
						
					КонецЕсли;
					ТипДокумента = ОписаниеДокумента.МетаданныеДокумента.Имя;
					ПоляПоиска = Новый Структура;
					ДополнительныеРеквизиты = Неопределено;
					
					СтрокаСвертки = "ЦМООтправитель, ПодразделениеОтправитель";
					Если НЕ ОписаниеДокумента.ЕстьПолучательВТЧ Тогда
						СтрокаСвертки = СтрокаСвертки + ", ЦМОПолучатель, ПодразделениеПолучатель";
					КонецЕслИ;
					
					ПолучателиИзТЧ = ТаблицаМатериалы.Скопировать(,СтрокаСвертки);
					ПолучателиИзТЧ.Свернуть(СтрокаСвертки);
					ОтборПолучателейТЧ = Новый Структура(СтрокаСвертки);
					ОтборДопустимыхСтрок = Новый Структура("ВариантУчета, СтатьяАналитики");
					
					Для каждого СтрокаПолучателейИзТЧ Из ПолучателиИзТЧ Цикл
						
						ЗаполнитьЗначенияСвойств(ОтборПолучателейТЧ, СтрокаПолучателейИзТЧ);
						ОбрабатываемаяТЧМатериалы = ТаблицаМатериалы.СкопироватьКолонки();
						
						Для Каждого СтрокаМатериалы Из ТаблицаМатериалы.Скопировать(ОтборПолучателейТЧ) Цикл
							
							ЗаполнитьЗначенияСвойств(ОтборДопустимыхСтрок, СтрокаМатериалы);
							Если ДопустимыеВариантыУчета.НайтиСтроки(ОтборДопустимыхСтрок).Количество() > 0 Тогда
								ЗаполнитьЗначенияСвойств(ОбрабатываемаяТЧМатериалы.Добавить(), СтрокаМатериалы);
							КонецЕсли;
							
						КонецЦикла;
						
						Если ОбрабатываемаяТЧМатериалы.Количество() = 0 Тогда
							Продолжить;
						КонецЕсли;
						
						//@skip-check query-in-loop
						ВыполнитьЗагрузкуДокумента (Объект, ТипДокумента, ПоляПоиска, ДополнительныеРеквизиты,
							ИспользуемыйВариантУчета, СтатьяАналитики, ОписаниеДокумента,
							ОбрабатываемаяТЧМатериалы, ВерхняяГруппаВариантовУчета, ДопустимыеВариантыУчета,
							ГруппаВариантовУчета, ТекКФОДокумента,
							ПараметрыЗагрузкиОбъекта);
						
					КонецЦикла;
					
				КонецЦикла;
			КонецЦикла;
			
		КонецЦикла;
		
		// установить пометку удаления ранее загруженным документам с этим ИД
		Если СгруппированныеВариантыУчета.Строки.Количество() > 0 Тогда
			ИдентификаторДокумента = ГруппаВариантовУчета.ИдентификаторДокумента;
			ПроверитьРанееСозданныеДокументыПоИдИсточника (ИдентификаторДокумента, ПараметрыЗагрузкиОбъекта);
		КонецЕсли;
		
	КонецЕсли;
	

КонецПроцедуры

//@skip-check method-too-many-params
Процедура ВыполнитьЗагрузкуДокумента(Объект, ТипДокумента, ПоляПоиска, ДополнительныеРеквизиты,
	ИспользуемыйВариантУчета, 
	СтатьяАналитики, ОписаниеДокумента, ОбрабатываемаяТЧМатериалы, ВерхняяГруппаВариантовУчета, 
	ДопустимыеВариантыУчета, ГруппаВариантовУчета, ТекКФОДокумента, ПараметрыЗагрузкиОбъекта)

	Параметры = ПараметрыЗагрузкиОбъекта.Параметры;
	ПараметрыОбъекта = ПараметрыЗагрузкиОбъекта.ПараметрыОбъекта;

	ЕстьКолонкаКонтрагентПолучательИмущества
		= (ОбрабатываемаяТЧМатериалы.Колонки.Найти("КонтрагентПолучательИмущества") <> Неопределено);
	
	Если ЕстьКолонкаКонтрагентПолучательИмущества И ОбрабатываемаяТЧМатериалы.Количество() > 0 Тогда
		КонтрагентПолучательИмуществаТЧ = ОбрабатываемаяТЧМатериалы[0].КонтрагентПолучательИмущества;
	Иначе
		КонтрагентПолучательИмуществаТЧ = Неопределено;
	КонецЕсли;
	
	МетаданныеДокумента = ОписаниеДокумента.МетаданныеДокумента;
	НайтиРанееСозданныйОбъект (Объект, ТипДокумента, ПоляПоиска, ДополнительныеРеквизиты, ИспользуемыйВариантУчета, 
		СтатьяАналитики, КонтрагентПолучательИмуществаТЧ,МетаданныеДокумента, ПараметрыЗагрузкиОбъекта);
	ЗаполнитьРеквизитыОбъектаПоУмолчанию (Объект);
	ЗаполнитьШапкуДокумента (Объект, МетаданныеДокумента, ПараметрыЗагрузкиОбъекта);
	
	// Заполнить реквизиты документа по варианту учета
	ПараметрыОбъекта.Вставить("ВариантУчета", ИспользуемыйВариантУчета);
	ЗаполнитьРеквизитыОбъектаПослеЗагрузкиОбъекта (Объект,ПараметрыОбъекта);
	
	Объект.Дата = Объект.Дата + ВерхняяГруппаВариантовУчета.СдвигВремениДокумента;
	
	ЗаполнитьПоляОтправителяВШапке (ОписаниеДокумента, Объект, ОбрабатываемаяТЧМатериалы, ПараметрыЗагрузкиОбъекта);
	ЗаполнитьПоляПолучателяВШапке (ОписаниеДокумента, Объект, ПараметрыЗагрузкиОбъекта);
	
	ИмяТаблицыМатериалы = ОписаниеДокумента.ИмяТЧМатериалы;
	ЗаполнитьТЧМатериалы(Объект, ТипДокумента, СтатьяАналитики, ОписаниеДокумента, ОбрабатываемаяТЧМатериалы,
		ДопустимыеВариантыУчета, ЕстьКолонкаКонтрагентПолучательИмущества, Параметры, ИмяТаблицыМатериалы,
		ПараметрыОбъекта);
	
	Если МетаданныеДокумента.ТабличныеЧасти.Найти("Комиссия") <> Неопределено Тогда
		ЗагрузитьКомиссию (Объект, ПараметрыОбъекта);
	КонецЕсли;
	
	Если Объект.ЭтоНовый() Тогда
		Объект.УстановитьНовыйНомер();
	КонецЕсли;
	
	ПараметрыОбъекта.Вставить("ВариантУчета", ИспользуемыйВариантУчета);
	ПараметрыОбъекта.Вставить("КФО", ТекКФОДокумента);
	ПараметрыОбъекта.Вставить("КПС", СтатьяАналитики.КПС);
	ПараметрыОбъекта.Вставить("ИФО", СтатьяАналитики.ИФО);
	ЗаполнитьРеквизитыОбъектаПослеЗагрузкиОбъекта (Объект,ПараметрыОбъекта);
	Если ОписаниеДокумента.ИмяТипаДокумента = "ВедомостьНаВыдачуМЗНаНуждыУчреждения" И Объект.ОтразитьНаСчете27 Тогда
		// В ведомости выдачи МЗ необходимо заполнить сотрудника в поле ЦМОПолучатель
		
		Для каждого НоваяСтрокаДокумента Из Объект[ИмяТаблицыМатериалы] Цикл
		
			//@skip-check bsl-legacy-check-string-literal
			НоваяСтрокаДокумента.ЦМОПолучатель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				НоваяСтрокаДокумента.ЦМОПолучатель, "Сотрудник");
		
		КонецЦикла;
			
	ИначеЕсли ОписаниеДокумента.ИмяТипаДокумента = "АктСписанияМягкогоИХозИнвентаря"
		И Объект.ВыдатьВЛичноеПользование Тогда
		// Необходимо заполнить сотрудника в поле ПолучательИмущества
		
		Если ОбрабатываемаяТЧМатериалы.Количество() > 0
				И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбрабатываемаяТЧМатериалы[0],
				"СотрудникПолучатель") Тогда
			Объект.ПолучательИмущества = ОбрабатываемаяТЧМатериалы[0].СотрудникПолучатель;
		Иначе
			Объект.ПолучательИмущества = ПараметрыОбъекта.Получить("СотрудникПолучатель");
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеМЗ")
			И Объект.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования Тогда
		Объект.ПолучательИмущества = ПараметрыОбъекта.Получить("СотрудникОтправитель");
	КонецЕсли;
	
	УстановитьСоответствиеОбъектовИБ (Объект, ПараметрыОбъекта, ТипДокумента, Параметры);
	// принудительно отменяем проведение
	Объект.Проведен = Ложь;
	Объект.ПометкаУдаления = (ПараметрыОбъекта.Получить("ПометкаУдаления") = Истина);
	Объект.ДополнительныеСвойства.Вставить("НеРегистрироватьОбъектыЗагруженныеИзВД", Истина);
	ПараметрыЗагрузкиОбъекта.ОбработкаЗагрузки.ЗаписатьОбъектВИБ(Объект, ТипЗнч(Объект));
	Объект.ДополнительныеСвойства.Удалить("НеРегистрироватьОбъектыЗагруженныеИзВД");
	
	ЗаполнитьРеквизитыОперацииПослеЗагрузкиОбъекта (Объект,ПараметрыОбъекта,КонтрагентПолучательИмуществаТЧ);
	ПровестиДокумент (Объект, ПараметрыЗагрузкиОбъекта);
	
	РегистрыСведений.ОбъектыЗагруженныеИзВД.ОбновитьЗаписьПриЗагрузке(Объект,
		Параметры.УзелОбменаЗагрузкаДанныхСсылка,
		Параметры.ЗапрещатьПовторнуюЗагрузкуОбъектов,
		ПараметрыОбъекта.Получить("ПредставлениеИсходногоДокумента"),
		Строка(ПараметрыОбъекта.Получить("ИДИсточника")));
	
	ВыполнитьДействияПослеЗагрузкиДокумента(Объект, ПараметрыЗагрузкиОбъекта);

КонецПроцедуры

Процедура ПересчитатьКолонкуВсего(Таблица, СуммаВключаетНДС)
	Для каждого СтрокаМатериалы Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрокаМатериалы.Всего) Тогда
			Продолжить;
		КонецЕсли;
		СтруктураПараметров = Новый Структура("Сумма, СтавкаНДС",
			СтрокаМатериалы.Сумма, СтрокаМатериалы.СтавкаНДС);
		СтрокаМатериалы.СуммаНДС = УправлениеНФАКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтруктураПараметров,
			СуммаВключаетНДС);
		СтруктураПараметров.Вставить("СуммаНДС", СтрокаМатериалы.СуммаНДС);
		СтрокаМатериалы.Всего = УправлениеНФАКлиентСервер.РассчитатьВсегоТабЧасти(СтруктураПараметров,
			СуммаВключаетНДС);
	КонецЦикла;	
КонецПроцедуры

//@skip-check method-too-many-params
Процедура ЗаполнитьТЧМатериалы(Объект, ТипДокумента, СтатьяАналитики, ОписаниеДокумента, ОбрабатываемаяТЧМатериалы,
		ДопустимыеВариантыУчета, ЕстьКолонкаКонтрагентПолучательИмущества, Параметры, ИмяТаблицыМатериалы,
		ПараметрыОбъекта)
	
	ЭтоДвижениеПоСчету27 = (ОписаниеДокумента.ИмяТипаДокумента = "ПоступлениеМЗ"
			Или ОписаниеДокумента.ИмяТипаДокумента = "АктСписанияМЗ"
			Или ОписаниеДокумента.ИмяТипаДокумента = "АктСписанияМягкогоИХозИнвентаря"
			Или ОписаниеДокумента.ИмяТипаДокумента = "НакладнаяНаОтпускМ15")
		И Параметры.Счета27.Найти(Объект.СчетУчета) <> Неопределено;
	ЕстьКолонкаЗатребовано = ОбрабатываемаяТЧМатериалы.Колонки.Найти("КоличествоЗатребовано") <> Неопределено;
	КонтрагентПолучательИмущества = ПараметрыОбъекта.Получить("КонтрагентПолучательИмущества");
	
	ОтборСтрок = Новый Структура("ВариантУчета, СтатьяАналитики");
	Для каждого СтрокаМатериалы Из ОбрабатываемаяТЧМатериалы Цикл
		
		ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаМатериалы);
		Если ДопустимыеВариантыУчета.НайтиСтроки(ОтборСтрок).Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаДокумента = Объект[ИмяТаблицыМатериалы].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, СтрокаМатериалы);
		ЗаполнитьРеквизитыСтрокиИзСтатьиАналитики (НоваяСтрокаДокумента, СтатьяАналитики, Объект,ТипДокумента);
		
		Если ОписаниеДокумента.ИмяТипаДокумента = "АктСписанияМЗ"
				Или ОписаниеДокумента.ИмяТипаДокумента = "АктСписанияМягкогоИХозИнвентаря" Тогда
			Если ЕстьКолонкаЗатребовано Тогда
				НоваяСтрокаДокумента.КоличествоНорма = СтрокаМатериалы.КоличествоЗатребовано;
			Иначе
				НоваяСтрокаДокумента.КоличествоНорма = НоваяСтрокаДокумента.Количество;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоДвижениеПоСчету27 Тогда
			НоваяСтрокаДокумента.СчетУчета = Объект.СчетУчета;
			Если ЕстьКолонкаКонтрагентПолучательИмущества Тогда
				НоваяСтрокаДокумента.ДополнительнаяАналитикаСчета = СтрокаМатериалы.КонтрагентПолучательИмущества;
			Иначе
				НоваяСтрокаДокумента.ДополнительнаяАналитикаСчета = КонтрагентПолучательИмущества;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ПоступлениеМЗ") Тогда
		ПересчитатьКолонкуВсего(Объект[ИмяТаблицыМатериалы], Объект.СуммаВключаетНДС);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнительноРазделитьТаблицуВариантовУчетаПоКФО(ВерхняяГруппаВариантовУчета, ТаблицаВариантовУчета)

	ТаблицаВариантовУчета = Новый ТаблицаЗначений;
	ТаблицаВариантовУчета.Колонки.Добавить("ВариантУчета");
	ТаблицаВариантовУчета.Колонки.Добавить("СтатьяАналитики");
	ТаблицаВариантовУчета.Колонки.Добавить("КФО");
	
	Для каждого СтрокаВариантаУчета Из ВерхняяГруппаВариантовУчета.Строки Цикл
	
		НоваяСтрокаВариантаУчета = ТаблицаВариантовУчета.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаВариантаУчета, СтрокаВариантаУчета);
		//@skip-check bsl-legacy-check-string-literal
		НоваяСтрокаВариантаУчета.КФО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаВариантаУчета.СтатьяАналитики,
			"КФО");
	
	КонецЦикла; 
	ТаблицаВариантовУчета.Свернуть("ВариантУчета, СтатьяАналитики, КФО");

КонецПроцедуры

Процедура ДобавитьКолонкуВТаблицуМатериалы(ТаблицаМатериалы, ИмяКолонки, ТипКолонки, Значение)
	Если ТаблицаМатериалы.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		ТаблицаМатериалы.Колонки.Добавить(ИмяКолонки,
			Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипКолонки)));
		Если ЗначениеЗаполнено(Значение) Тогда
			ТаблицаМатериалы.ЗаполнитьЗначения(Значение, ИмяКолонки);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ДополнитьПолучателемТаблицуМатериалы(ТаблицаМатериалы,ПараметрыОбъекта)

	ДобавитьКолонкуВТаблицуМатериалы(ТаблицаМатериалы, "ЦМОПолучатель",
		Тип("СправочникСсылка.ЦМО"), ПараметрыОбъекта.Получить("ЦМОПолучатель"));
	ДобавитьКолонкуВТаблицуМатериалы(ТаблицаМатериалы, "ПодразделениеПолучатель",
		Тип("СправочникСсылка.Подразделения"), ПараметрыОбъекта.Получить("ПодразделениеПолучатель"));
	ДобавитьКолонкуВТаблицуМатериалы(ТаблицаМатериалы, "ЦМООтправитель",
		Тип("СправочникСсылка.ЦМО"), ПараметрыОбъекта.Получить("ЦМООтправитель"));
	ДобавитьКолонкуВТаблицуМатериалы(ТаблицаМатериалы, "ПодразделениеОтправитель",
		Тип("СправочникСсылка.Подразделения"), ПараметрыОбъекта.Получить("ПодразделениеОтправитель"));

КонецПроцедуры

Процедура ЗагрузитьКомиссию(Объект, ПараметрыОбъекта)

	ТаблицаКомиссия = ПараметрыОбъекта.Получить("СоставКомиссииТабличнаяЧасть");
	Если ТаблицаКомиссия <> Неопределено Тогда
		
		Для каждого СтрокаКомиссия Из ТаблицаКомиссия Цикл
			НоваяСтрокаДокумента = Объект.СоставКомиссии.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, СтрокаКомиссия);
		КонецЦикла; 
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьОшибкуПоискаОписанияДокумента(ВерхняяГруппаВариантовУчета, УзелОбменаЗагрузкаДанных)

	ТекстОшибки = НСтр("ru = 'Ошибка при загрузке документа:
		|Не найдено описание загружаемого документа для варианта учета.
		|Подробности:
		|Представление ВерхняяГруппаВариантовУчета.ВариантУчета: %1
		|ВерхняяГруппаВариантовУчета.ВариантУчета: %2
		|Представление ВерхняяГруппаВариантовУчета.ВариантУчетаФактический: %3
		|ВерхняяГруппаВариантовУчета.ВариантУчетаФактический: %4
		|ВерхняяГруппаВариантовУчета.ИдентификаторДокумента: %5'");
		
	ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
		Строка(ВерхняяГруппаВариантовУчета.ВариантУчета),
		ОбщегоНазначения.ЗначениеВСтрокуXML(ВерхняяГруппаВариантовУчета.ВариантУчета),
		Строка(ВерхняяГруппаВариантовУчета.ВариантУчетаФактический),
		ОбщегоНазначения.ЗначениеВСтрокуXML(ВерхняяГруппаВариантовУчета.ВариантУчетаФактический),
		Строка(ВерхняяГруппаВариантовУчета.ИдентификаторДокумента));
		
	ЗаписьЖурналаРегистрации(ОбменДаннымиСервер.КлючСообщенияЖурналаРегистрации(УзелОбменаЗагрузкаДанных,
		НСтр("ru = 'Получение данных'")),
		УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки);
	

КонецПроцедуры

Процедура ЗаполнитьПоляОтправителяВШапке(ОписаниеДокумента, Объект, ОбрабатываемаяТЧМатериалы, ПараметрыЗагрузкиОбъекта)

	Если Не ОписаниеДокумента.ЕстьОтправитель Тогда
		Возврат;
	КонецЕсли;
		
	ПараметрыОбъекта = ПараметрыЗагрузкиОбъекта.ПараметрыОбъекта;
	Параметры = ПараметрыЗагрузкиОбъекта.Параметры;
	ЦМООтправительСлужебный = ПараметрыОбъекта.Получить("ЦМООтправительСлужебный") = Истина;
	
	Если ЗначениеЗаполнено(ОписаниеДокумента.ИмяЦМООтправитель) Тогда
		
		Если НЕ ЦМООтправительСлужебный Тогда
			ЦМО = ОбрабатываемаяТЧМатериалы[0].ЦМООтправитель;
		Иначе
			ЦМО = Неопределено;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЦМО) Тогда
			ЦМО = Параметры.СоответствиеЦМО[Объект.Организация];
		КонецЕсли;
		Объект[ОписаниеДокумента.ИмяЦМООтправитель] = ЦМО;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеДокумента.ИмяПодразделениеОтправитель) Тогда
		
		Если НЕ ЦМООтправительСлужебный Тогда
			Подразделение = ОбрабатываемаяТЧМатериалы[0].ПодразделениеОтправитель;
		Иначе
			Подразделение = Неопределено;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Подразделение) Тогда
			Подразделение = Параметры.СоответствиеПодразделений[Объект.Организация];
		КонецЕсли;
		Объект[ОписаниеДокумента.ИмяПодразделениеОтправитель] = Подразделение;
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаполнитьПоляПолучателяВШапке(ОписаниеДокумента, Объект, ПараметрыЗагрузкиОбъекта)

	Если Не ОписаниеДокумента.ЕстьПолучательВШапке Тогда
		Возврат;
	КонецЕсли;
		
	ПараметрыОбъекта = ПараметрыЗагрузкиОбъекта.ПараметрыОбъекта;
	Параметры = ПараметрыЗагрузкиОбъекта.Параметры;
	ЦМОПолучательСлужебный = ПараметрыОбъекта.Получить("ЦМОПолучательСлужебный") = Истина;
	
	Если ЗначениеЗаполнено(ОписаниеДокумента.ИмяЦМОПолучательВШапке) Тогда
		
		Если НЕ ЦМОПолучательСлужебный Тогда
			ЦМО = ПараметрыОбъекта.Получить("ЦМОПолучатель");
		Иначе
			ЦМО = Неопределено;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЦМО) Тогда
			ЦМО = Параметры.СоответствиеЦМО[Объект.Организация];
		КонецЕсли;
		Объект[ОписаниеДокумента.ИмяЦМОПолучательВШапке] = ЦМО;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеДокумента.ИмяПодразделениеПолучательВШапке) Тогда
		
		Если НЕ ЦМОПолучательСлужебный Тогда
			Подразделение = ПараметрыОбъекта.Получить("ПодразделениеПолучатель");
		Иначе
			Подразделение = Неопределено;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Подразделение) Тогда
			Подразделение = Параметры.СоответствиеПодразделений[Объект.Организация];
		КонецЕсли;
		Объект[ОписаниеДокумента.ИмяПодразделениеПолучательВШапке] = Подразделение;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьРеквизитыОбъектаПослеЗагрузкиОбъекта(Объект, ПараметрыОбъекта)

	ВариантУчета = ПараметрыОбъекта.Получить("ВариантУчета");
	Если ВариантУчета = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Для каждого НастройкаДокумента Из ВариантУчета.РеквизитыДокумента Цикл
	
		Если НастройкаДокумента.УстанавливатьЗначение Тогда
		
			Если НастройкаДокумента.ИмяРеквизита = "ПервичныйДокумент"
					И ТипЗнч(НастройкаДокумента.ЗначениеРеквизита) = Тип("Строка")
					И ЗначениеЗаполнено(НастройкаДокумента.ЗначениеРеквизита) Тогда
				Объект[НастройкаДокумента.ИмяРеквизита] = ПервичныеДокументыБГУ.НайтиПоИдентификатору(
					НастройкаДокумента.ЗначениеРеквизита);
			Иначе
				Объект[НастройкаДокумента.ИмяРеквизита] = НастройкаДокумента.ЗначениеРеквизита;
			КонецЕсли;
		
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого ДополнительныйПараметр Из ВариантУчета.ПараметрыОбмена Цикл
		
		ЧастиИмениПараметра = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(
			ВРЕГ(ДополнительныйПараметр.ЗначениеПараметра));
		Если ЧастиИмениПараметра.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЧастиИмениПараметра[0] = "ДОКУМЕНТ" Тогда
			
			Если ДополнительныйПараметр.ИмяПараметра = "КонтрагентПолучательИмущества" Тогда
				
				Если ТипЗнч(Объект[ЧастиИмениПараметра[1]]) = Тип("СправочникСсылка.Контрагенты") Тогда
					Объект[ЧастиИмениПараметра[1]] = ПараметрыОбъекта.Получить("КонтрагентПолучательИмущества");
				ИначеЕсли ТипЗнч(Объект[ЧастиИмениПараметра[1]]) = Тип("СправочникСсылка.Сотрудники") Тогда
					Объект[ЧастиИмениПараметра[1]] = ПараметрыОбъекта.Получить("СотрудникПолучатель");
				КонецЕсли;
				
			Иначе
				Объект[ЧастиИмениПараметра[1]] = ПараметрыОбъекта.Получить(ДополнительныйПараметр.ИмяПараметра);
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьРеквизитыОбъектаПоУмолчанию(Объект)

	ЗаполнениеРеквизитовОбъектов.ЗаполнитьРеквизитыОбъектовПоУмолчаниюОбработкаЗаполнения(Объект,
		Неопределено, Неопределено, Истина);

КонецПроцедуры

Процедура ЗаполнитьРеквизитыОперацииПослеЗагрузкиОбъекта(Объект, ПараметрыОбъекта, КонтрагентПолучательИмуществаТЧ)

	ВариантУчета = ПараметрыОбъекта.Получить("ВариантУчета");
	
	Если ВариантУчета = Неопределено Тогда
		ТиповаяОперация = Неопределено;
	Иначе
		ТиповаяОперация = ВариантУчета.ТиповаяОперация;;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТиповаяОперация) Тогда
		Возврат;
	КонецЕсли;
		
	ДополнительныеРеквизиты = Новый Структура;
	Для каждого ЗначениеДопРеквизита Из ВариантУчета.РеквизитыОперации Цикл
		Если ЗначениеДопРеквизита.УстанавливатьЗначение Тогда
			ДополнительныеРеквизиты.Вставить(ЗначениеДопРеквизита.ИмяРеквизита, ЗначениеДопРеквизита.ЗначениеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ДополнительныйПараметр Из ВариантУчета.ПараметрыОбмена Цикл
	
		ЧастиИмениПараметра = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(
			ВРЕГ(ДополнительныйПараметр.ЗначениеПараметра));
		Если ЧастиИмениПараметра.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЧастиИмениПараметра[0] = "ДОПОЛНИТЕЛЬНЫЙРЕКВИЗИТ" Тогда
			Если ДополнительныйПараметр.ИмяПараметра = "КонтрагентПолучательИмущества"
					И ЗначениеЗаполнено(КонтрагентПолучательИмуществаТЧ) Тогда
				ДополнительныеРеквизиты.Вставить(ЧастиИмениПараметра[1], КонтрагентПолучательИмуществаТЧ);
			Иначе
				ДополнительныеРеквизиты.Вставить(ЧастиИмениПараметра[1],
					ПараметрыОбъекта.Получить(ДополнительныйПараметр.ИмяПараметра));
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	БухгалтерскиеОперацииСервер.ЗаписатьДанныеТиповойОперацииОбъекта(Объект, ТиповаяОперация, ДополнительныеРеквизиты);

КонецПроцедуры

Процедура ЗаполнитьРеквизитыСтрокиИзСтатьиАналитики(НоваяСтрокаДокумента, СтатьяАналитики, Объект, ТипДокумента)

	ДанныеСтатьиАналитики = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтатьяАналитики, "КФО, КПС");
	ЗаполнитьЗначенияСвойств(НоваяСтрокаДокумента, ДанныеСтатьиАналитики);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрокаДокумента, "КЭК") Тогда
		Если ТипДокумента = "АктСписанияМЗ"
			ИЛИ ТипДокумента = "АктСписанияМягкогоИХозИнвентаря"
			ИЛИ ТипДокумента = "ВедомостьНаВыдачуМЗНаНуждыУчреждения"
			ИЛИ ТипДокумента = "НакладнаяНаОтпускМ15"
			ИЛИ ТипДокумента = "ТребованиеНакладная0315006" Тогда
			ДтКт = "Кт";
		ИначеЕсли ТипДокумента = "ПоступлениеМЗ" Тогда
			ДтКт = "Дт";
		Иначе
			ДтКт = "";
		КонецЕсли;
		Если ЗначениеЗаполнено(ДтКт) Тогда
			//@skip-check bsl-legacy-check-string-literal
			ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрокаДокумента.Номенклатура,
				"ТипНоменклатуры"); 
			НоваяСтрокаДокумента.КЭК = БухгалтерскийУчет.КЭКНоменклатуры(Объект.Организация, Объект.ИФО, Неопределено,
					Объект.Дата, НоваяСтрокаДокумента.СчетУчета, ТипНоменклатуры, ДтКт);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьШапкуДокумента(Объект, МетаданныеДокумента, ПараметрыЗагрузкиОбъекта)

	Параметры = ПараметрыЗагрузкиОбъекта.Параметры;
	ПараметрыОбъекта = ПараметрыЗагрузкиОбъекта.ПараметрыОбъекта;
	
	Объект.Дата = ПараметрыОбъекта.Получить("Дата");
	Для каждого РеквизитМетаданного Из МетаданныеДокумента.Реквизиты Цикл
	
		ЗначениеПараметра = ПараметрыОбъекта.Получить(РеквизитМетаданного.Имя);
		Если ЗначениеПараметра <> Неопределено Тогда
			Объект[РеквизитМетаданного.Имя] = ЗначениеПараметра;
		КонецЕсли;
	
	КонецЦикла;
	Объект.Комментарий = СокрП(Объект.Комментарий) + "//"
		+ ПараметрыОбъекта.Получить("ПредставлениеИсходногоДокумента");
	
	Если Объект.Метаданные().Реквизиты.Найти("НеПересчитыватьСумму") <> Неопределено Тогда
		Объект.НеПересчитыватьСумму = Параметры.ЗагружатьСуммыВыбытияМЗ;
	КонецЕсли;

КонецПроцедуры

//@skip-check method-too-many-params
Процедура НайтиРанееСозданныйОбъект(Объект, ТипДокумента, ПоляПоиска, ДополнительныеРеквизиты, ИспользуемыйВариантУчета,
		СтатьяАналитики, КонтрагентПолучательИмуществаТЧ, МетаданныеДокумента, ПараметрыЗагрузкиОбъекта)

	ПараметрыОбъекта = ПараметрыЗагрузкиОбъекта.ПараметрыОбъекта;
	ИдИсточника = ПараметрыОбъекта.Получить("ИДИсточника");

	НайденныйОбъект = Неопределено;
	Если ЗначениеЗаполнено(ИдИсточника) Тогда
		Если ДополнительныеРеквизиты = Неопределено Тогда
			ДополнительныеРеквизиты = Новый Соответствие;
		КонецЕсли;
		НайденныйОбъект = НайтиРанееСозданныйОбъектПоИдИсточника(Объект, ТипДокумента, ПоляПоиска,
			ДополнительныеРеквизиты, ИспользуемыйВариантУчета, СтатьяАналитики, КонтрагентПолучательИмуществаТЧ,
			МетаданныеДокумента, ПараметрыЗагрузкиОбъекта, ПараметрыОбъекта, ИдИсточника);
	КонецЕсли;
	 
	Если НайденныйОбъект = Неопределено Тогда
		Объект = Документы[ТипДокумента].СоздатьДокумент();
	Иначе
		Объект = НайденныйОбъект;
	КонецЕсли;

КонецПроцедуры

//@skip-check method-too-many-params
Функция НайтиРанееСозданныйОбъектПоИдИсточника(Объект, ТипДокумента, ПоляПоиска, ДополнительныеРеквизиты,
		ИспользуемыйВариантУчета, СтатьяАналитики, КонтрагентПолучательИмуществаТЧ, МетаданныеДокумента,
		ПараметрыЗагрузкиОбъекта, ПараметрыОбъекта, ИдИсточника)
	
	ТиповаяОперация = ИспользуемыйВариантУчета.ТиповаяОперация;
	ДопРеквизитыОперации = Неопределено;
	ЗаполнитьПоляПоискаПоИспользуемомуВариантуУчета(ПоляПоиска, ДополнительныеРеквизиты, ИспользуемыйВариантУчета,
		СтатьяАналитики, КонтрагентПолучательИмуществаТЧ, МетаданныеДокумента, ТиповаяОперация, ПараметрыОбъекта,
		ДопРеквизитыОперации); 
	
	ТекстЗапроса = Новый Массив;
	Запрос = Новый Запрос;
	ТекстЗапроса.Добавить(СтрЗаменить(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВыбираемыйДокумент.Ссылка
	|ИЗ
	|	#ВыбираемыйДокумент КАК ВыбираемыйДокумент
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектов
	|		ПО ВыбираемыйДокумент.Ссылка = СоответствияОбъектов.УникальныйИдентификаторИсточника
	|ГДЕ
	|	СоответствияОбъектов.УникальныйИдентификаторПриемника = &ИДИсточника
	|	И СоответствияОбъектов.ТипИсточника = &ТипИсточникаСтрокой
	|	И СоответствияОбъектов.УзелИнформационнойБазы = &УзелИнформационнойБазы
	|	И ВыбираемыйДокумент.Ссылка Не В (&ТолькоЧтоСозданныеДокументы)",
	"#ВыбираемыйДокумент", "Документ." + ТипДокумента));
	
	Запрос.УстановитьПараметр("ИДИСточника", Строка(ИдИсточника));
	Запрос.УстановитьПараметр("ТипИсточникаСтрокой", "ДокументСсылка." + ТипДокумента);
	Запрос.УстановитьПараметр("УзелИнформационнойБазы", ПараметрыЗагрузкиОбъекта.УзелОбменаЗагрузкаДанных);
	Запрос.УстановитьПараметр("ТолькоЧтоСозданныеДокументы",
		ПараметрыЗагрузкиОбъекта.Параметры.ДокументыСТекущимИдИсточника);
	ШаблонУсловия = "
		|	И ВыбираемыйДокумент.%1 = &%1";
	Для каждого ПолеПоиска Из ПоляПоиска Цикл
		ТекстЗапроса.Добавить(СтрШаблон(ШаблонУсловия, ПолеПоиска.Ключ));
		Запрос.УстановитьПараметр(ПолеПоиска.Ключ, ПолеПоиска.Значение);
	КонецЦикла;
	Если ЗначениеЗаполнено(ТиповаяОперация) Тогда
		ТекстЗапроса.Добавить("
		|	И ИСТИНА В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИСТИНА КАК Поле1
		|			ИЗ
		|				РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		|			ГДЕ
		|				ОперацииДокументов.Документ = ВыбираемыйДокумент.Ссылка
		|				И ОперацииДокументов.Операция = &ТиповаяОперация)");
		Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	КонецЕсли;
	
	НомерРеквизита = 0;
	ШаблонУсловияДопРеквизита = "
		|	И ИСТИНА В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИСТИНА КАК Поле1
		|			ИЗ
		|				РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
		|			ГДЕ
		|				ЗначенияДополнительныхРеквизитовОпераций.Объект = ВыбираемыйДокумент.Ссылка
		|				И ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации = &РеквизитОперации%1
		|				И ЗначенияДополнительныхРеквизитовОпераций.Значение = &Значение%1)";
	Для каждого ДополнительныйРеквизит Из ДополнительныеРеквизиты Цикл
		НомерРеквизита = НомерРеквизита + 1;
		ТекстЗапроса.Добавить(СтрШаблон(ШаблонУсловияДопРеквизита, НомерРеквизита));
		Запрос.УстановитьПараметр("РеквизитОперации" + НомерРеквизита, ДополнительныйРеквизит.Ключ);
		Запрос.УстановитьПараметр("Значение" + НомерРеквизита, ДополнительныйРеквизит.Значение);
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Для каждого ДвижениеДокумента Из Объект.Движения Цикл
			ДвижениеДокумента.Записывать = Истина;
			ДвижениеДокумента.Очистить();
		КонецЦикла; 
		МетаданныеОбъекта = Объект.Метаданные();
		Для каждого ТаблицаДокумента Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		
			Объект[ТаблицаДокумента.Имя].Очистить();
		
		КонецЦикла;
		Возврат Объект;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

//@skip-check method-too-many-params
Процедура ЗаполнитьПоляПоискаПоИспользуемомуВариантуУчета(ПоляПоиска, ДополнительныеРеквизиты, ИспользуемыйВариантУчета,
		СтатьяАналитики, КонтрагентПолучательИмуществаТЧ, МетаданныеДокумента, ТиповаяОперация, ПараметрыОбъекта,
