#Область ПрограммныйИнтерфейс

Процедура ПриСозданииНаСервере(Знач ВладелецЭлементов, Знач ПолеДляЭлементов, Знач ПолеКнопокКоманд = Неопределено, Знач Корень = Неопределено, ПовторноеЧтение = Ложь) Экспорт
	
	Форма = РеестрИмуществаКлиентСервер.ПолучитьРодителяПоТипуЭлемента(ПолеДляЭлементов, Тип("ФормаКлиентскогоПриложения"));
	
	Если Корень = Неопределено Тогда
		Корень = Справочники.РеквизитыСведенийОбИмуществе.ПустаяСсылка();
	КонецЕсли;
	
	ДанныеФормы = РеестрИмуществаПовтИсп.ПолучитьДанныеФормы(ВладелецЭлементов, Корень);
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизитыФормы = Новый СписокЗначений;
	
	// СОЗДАНИЕ ФОРМЫ
	
	Если Не ПовторноеЧтение Тогда
		ДобавитьСлужебныеРеквизиты(ДобавляемыеРеквизиты);
	КонецЕсли;
	
	// Создание реквизитов формы
	Для Каждого Реквизит Из ДанныеФормы.РеквизитыФормы Цикл
		ДобавляемыеРеквизиты.Добавить(Реквизит);
		Если Реквизит.Путь = "" Тогда
			ДобавляемыеРеквизитыФормы.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Для Каждого ДанныеСписка Из ДанныеФормы.ДанныеСписков Цикл
		Форма[ДанныеСписка.Имя].ТипЗначения = ДанныеСписка.Тип;
	КонецЦикла;
	
	// Создание элементов формы
	
	Если Не ПовторноеЧтение Тогда
		СоздатьСлужебныеЭлементыФормы(Форма, ПолеКнопокКоманд);
	КонецЕсли;
	
	СоздатьЭлементыФормы(Форма, ДанныеФормы.ЭлементыФормы, ПолеДляЭлементов);
	
	// ЗАПОЛНЕНИЕ ФОРМЫ ДАННЫМИ
	
	// Заполнение служебными данными
	Форма.СлужебноеПоле_ВладелецЭлементов = ВладелецЭлементов;
	//Форма.СлужебноеПоле_Корень = Корень;
	Форма.СлужебноеПоле_ТаблицыФормы.Загрузить(ДанныеФормы.ТаблицыФормы);
	Форма.СлужебноеПоле_ДобавленныеРеквизитыФормы = ДобавляемыеРеквизитыФормы;
	
	Форма.СлужебноеПоле_АдресМакетаКомпоновкиЗаполнение			= ПолучитьАдресМакетаКомпоновкиФормулы(Форма, ДанныеФормы.МакетыКомпоновки.Заполнение);
	Форма.СлужебноеПоле_АдресМакетаКомпоновкиСвойстваЭлементов	= ПолучитьАдресМакетаКомпоновкиФормулы(Форма, ДанныеФормы.МакетыКомпоновки.СвойстваЭлементов);
	Форма.СлужебноеПоле_АдресМакетаКомпоновкиКомментарий		= ПолучитьАдресМакетаКомпоновкиФормулы(Форма, ДанныеФормы.МакетыКомпоновки.Комментарий);
	
	Форма.Элементы.ФормаЗаполнитьРеквизиты.Доступность				= Не ПустаяСтрока(Форма.СлужебноеПоле_АдресМакетаКомпоновкиЗаполнение);
	Форма.Элементы.ФормаПроверитьЗаполнениеРеквизитов.Доступность	= Не ПустаяСтрока(Форма.СлужебноеПоле_АдресМакетаКомпоновкиКомментарий);
	
	// Заполнение данными документа
	
	Если Форма.Параметры.Свойство("ДанныеРеквизитов") Тогда
		РеестрИмуществаКлиентСервер.ЗаполнитьФормуДанными(Форма, Форма.Параметры.ДанныеРеквизитов);
	ИначеЕсли Форма.Объект.ЗначенияРеквизитов.Количество() > 0 Тогда
		ЗагрузитьЗначенияРеквизитов(Форма);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.СлужебноеПоле_АдресМакетаКомпоновкиСвойстваЭлементов) Тогда
		УстановитьСвойстваЭлементовФормы(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЧтенииНаСервере(ВладелецЭлементов, ПолеДляЭлементов, ПолеКнопокКоманд = Неопределено) Экспорт
	
	Форма = РеестрИмуществаКлиентСервер.ПолучитьРодителяПоТипуЭлемента(ПолеДляЭлементов, Тип("ФормаКлиентскогоПриложения"));
	
	ПовторноеЧтение = (РеестрИмуществаКлиентСервер.ПолучитьЭлементФормыПоИмени(Форма, "СлужебноеПоле_ВладелецЭлементов") <> Неопределено);
	
	Если ПовторноеЧтение Тогда
		
		КоличествоЭлементов = ПолеДляЭлементов.ПодчиненныеЭлементы.Количество();
		Для НомерЭлемента = 1 По КоличествоЭлементов Цикл
			Форма.Элементы.Удалить(ПолеДляЭлементов.ПодчиненныеЭлементы[КоличествоЭлементов - НомерЭлемента]);	
		КонецЦикла;
		
		УдаляемыеРеквизиты = Форма.СлужебноеПоле_ДобавленныеРеквизитыФормы.ВыгрузитьЗначения();
		Если УдаляемыеРеквизиты.Количество() > 0 Тогда
			Форма.ИзменитьРеквизиты(, УдаляемыеРеквизиты);
		КонецЕсли;
		
		ПриСозданииНаСервере(ВладелецЭлементов, ПолеДляЭлементов, ПолеКнопокКоманд,, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписьюНаСервере(Отказ, Объект, Форма) Экспорт
	
	Если ТипЗнч(Объект.Ссылка) = Тип("СправочникСсылка.ОбъектыРеестраИмущества") Тогда
		Отказ = Не Форма.ПроверитьЗаполнение();
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СпискиЗначений = Новый Массив;
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеВвода);
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеНадписи);
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Форма.СлужебноеПоле_ВладелецЭлементов);
	Запрос.УстановитьПараметр("СпискиЗначений", СпискиЗначений);
	Запрос.УстановитьПараметр("Надпись", Перечисления.ВидыРеквизитовСведенийОбИмуществе.ДекорацияНадпись);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыСведенийОбИмуществе.Ссылка КАК Реквизит,
	|	РеквизитыСведенийОбИмуществе.Родитель КАК Родитель,
	|	РеквизитыСведенийОбИмуществе.ИмяДляФормулы КАК ИмяДляФормулы,
	|	ВЫБОР
	|		КОГДА РеквизитыСведенийОбИмуществе.ВидРеквизита В (&СпискиЗначений)
	|			ТОГДА ""Значение""
	|		ИНАЧЕ РеквизитыСведенийОбИмуществе.ИмяДляФормулы
	|	КОНЕЦ КАК ИмяРеквизита,
	|	ВЫБОР
	|		КОГДА РеквизитыСведенийОбИмуществе.ВидРеквизита В (&СпискиЗначений)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоСписокЗначений
	|ИЗ
	|	Справочник.РеквизитыСведенийОбИмуществе КАК РеквизитыСведенийОбИмуществе
	|ГДЕ
	|	РеквизитыСведенийОбИмуществе.Владелец = &Владелец
	|	И НЕ РеквизитыСведенийОбИмуществе.ЭтоГруппа
	|	И НЕ РеквизитыСведенийОбИмуществе.ПометкаУдаления
	|	И РеквизитыСведенийОбИмуществе.ВидРеквизита <> &Надпись
	|	И НЕ РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ
	|				(ВЫБРАТЬ
	|					Р.Ссылка
	|				ИЗ
	|					Справочник.РеквизитыСведенийОбИмуществе КАК Р
	|				ГДЕ
	|					Р.ЭтоГруппа
	|					И Р.ПометкаУдаления
	|					И Р.Владелец = &Владелец)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Префикс = РеестрИмуществаКлиентСервер.ПрефиксЭлементовФормы();
	
	ЗначенияРеквизитов = Объект.ЗначенияРеквизитов;
	ЗначенияРеквизитов.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		Таблицы = ФункцияИмяТаблицыРеквизиты(Выборка);
		СохранитьРеквизитыРекурсивно(Форма, ЗначенияРеквизитов, Таблицы, 0, Выборка, ИдСтроки());
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриИзмененииРеквизита(Форма) Экспорт
	
	УстановитьСвойстваЭлементовФормы(Форма);
	
КонецПроцедуры

Процедура ПриНачалеРедактированияТаблицы(ИмяЭлемента, Форма) Экспорт
	
	Элемент = Форма[Сред(ИмяЭлемента, 17)];
	Таблица = ДанныеФормыВЗначение(Элемент, Тип("ТаблицаЗначений"));
	ТекущаяСтрока = Элемент.НайтиПоИдентификатору(Форма.Элементы[ИмяЭлемента].ТекущаяСтрока);
	ВыполнитьОчисткуСервер(Таблица, ТекущаяСтрока);
	
КонецПроцедуры

Функция ВыборВТаблице(Форма) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВладелецРеквизитов",	Форма.СлужебноеПоле_ВладелецЭлементов);
	ПараметрыФормы.Вставить("ТолькоПросмотр",		Форма.ТолькоПросмотр);
	
	ТаблицыФормы = Форма.СлужебноеПоле_ТаблицыФормы.Выгрузить();
	Таблица = ТаблицыФормы.Найти(Форма.ТекущийЭлемент.Имя, "Имя");
	
	Если Таблица <> Неопределено Тогда	
		
		ПараметрыФормы.Вставить("Заголовок",	Таблица.Ссылка.Наименование);
		ПараметрыФормы.Вставить("Корень",		Таблица.Ссылка);
		
		ИсточникиДанных = Новый Массив;		
		ТипОбъекта = ОбщегоНазначенияБГУ.ВернутьСтрокуТипаПоТипу(ТипЗнч(Форма.Объект.Ссылка), "Объект");
		ИсточникиДанных.Добавить(Новый Структура("ИмяИсточника,Источник,ТипИсточника", "Объект", Форма.Объект, ТипОбъекта));
		
		Если ТипОбъекта = "ДокументОбъект.РегистрацияСведенийОбИмуществе" Тогда // Нужно вынести условие в модуль
			ИсточникиДанных.Добавить(Новый Структура("ИмяИсточника,Источник,ТипИсточника", "РеестровыйУчет", Форма.РеестровыйУчет, "РегистрСведенийМенеджерЗаписи.СведенияРеестровогоУчетаИмущества"));
		КонецЕсли;
		
		ПараметрыФормы.Вставить("ИсточникиДанных", ИсточникиДанных);
		
		ДанныеСтрокиФормы = Форма[Таблица.Ссылка.ИмяДляФормулы].НайтиПоИдентификатору(Форма.ТекущийЭлемент.ТекущаяСтрока);
		Табл = Форма.РеквизитФормыВЗначение(Таблица.Ссылка.ИмяДляФормулы);
		ДанныеЗаполнения = Новый Структура;
		Для Каждого Колонка Из Табл.Колонки Цикл
			ДанныеЗаполнения.Вставить(Колонка.Имя, ЗначениеРеквизитаФормы(ДанныеСтрокиФормы[Колонка.Имя]));
		КонецЦикла;
		
		ПараметрыФормы.Вставить("ДанныеРеквизитов", ДанныеЗаполнения);
		
	КонецЕсли;
	
	Возврат ПараметрыФормы;
	
КонецФункции

Процедура ЗаполнитьРеквизиты(Форма) Экспорт
	
	Результат = ПолучитьРезультатВычисленияФормул(Форма, "Заполнение");
	
	Для Каждого Реквизит Из Результат Цикл
		
		Если ТипЗнч(Реквизит.Значение) = Тип("ТаблицаЗначений") Тогда
			Форма[Реквизит.Ключ].Загрузить(Реквизит.Значение);
		Иначе
			Форма[Реквизит.Ключ] = Реквизит.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
	//Форма.Модифицированность = Истина;
	
	Если ЗначениеЗаполнено(Форма.СлужебноеПоле_АдресМакетаКомпоновкиСвойстваЭлементов) Тогда
		УстановитьСвойстваЭлементовФормы(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполненияНаСервере(Форма, Отказ, ПроверяемыеРеквизиты) Экспорт
	
	Ошибки = Неопределено;
	
	Если ЗначениеЗаполнено(Форма.СлужебноеПоле_АдресМакетаКомпоновкиКомментарий) Тогда
		
		Результат = ПолучитьРезультатВычисленияФормул(Форма, "Комментарий");
		Префикс = РеестрИмуществаКлиентСервер.ПрефиксЭлементовФормы();
		
		Для Каждого Реквизит Из Результат Цикл
			Если Не ПустаяСтрока(Реквизит.Значение) Тогда
				ТекстОшибки = НСтр("ru ='" + Реквизит.Значение + "'");
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, Реквизит.Ключ, ТекстОшибки, "");
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	
КонецПроцедуры

Функция ПолучитьЗначениеЭлементаОтбора(Отбор, ИмяЭлемента) Экспорт
	
	Для Каждого Элемент Из Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяЭлемента) Тогда
				Возврат Элемент.ПравоеЗначение;
			КонецЕсли;
		Иначе
			Возврат ПолучитьЗначениеЭлементаОтбора(Элемент, ИмяЭлемента);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции


