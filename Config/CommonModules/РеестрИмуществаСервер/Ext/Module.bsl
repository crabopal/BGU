Процедура ВыполнитьРегламентноеЗадание(Операция)
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Организация,
	|	Настройки.ВидОбмена,
	|	Настройки.НастройкаОбмена
	|ИЗ
	|	Справочник.НастройкиОбменаСистемаУчетаИмущества КАК Настройки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО (ИСТИНА)
	|ГДЕ
	|	НЕ Настройки.ПометкаУдаления
	|	И НЕ Организации.ПометкаУдаления";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Выборка Из Результат Цикл
		Настройки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Выборка);
		Обработки.ОбменССистемойУчетаИмущества.ВыполнитьОперацию(Операция, Настройки);
	КонецЦикла;
	
КонецПроцедуры


