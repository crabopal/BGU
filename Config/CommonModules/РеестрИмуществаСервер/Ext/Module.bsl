Процедура ДобавитьОшибку(ТаблицаОшибок, ТекстОшибки, ПолеФайла = "")
	
	Ошибка = ТаблицаОшибок.Добавить();
	Ошибка.ПолеФайла = ПолеФайла;
	Ошибка.Ошибка = ТекстОшибки;
	
КонецПроцедуры

Процедура ОбработатьОтветИзСервиса(ЗаданиеНаЭкспорт) Экспорт
	
	Для Каждого СтрокаРезультата Из ЗаданиеНаЭкспорт.ОбъектыОбмена Цикл
		
		ТаблицаОшибок = ЭкспортФайлов.ПолучитьТаблицуОшибок(СтрокаРезультата);
		
		Если ТаблицаОшибок.Количество() = 0 Тогда
			
			ОтветИзСервиса = ЭкспортФайлов.РазобратьОтветИзСервиса(СтрокаРезультата.ОтветWebСервиса, ТаблицаОшибок);
			
			Для Каждого ДетальныйОтветИзСервиса Из ОтветИзСервиса Цикл
				ОбработатьДетальныйОтветИзСервиса(СтрокаРезультата.Объект, ДетальныйОтветИзСервиса, ТаблицаОшибок);
			КонецЦикла;
			
			Если ТаблицаОшибок.Количество() > 0 Тогда
				СтрокаРезультата.Описание = "Подробно...";
				СтрокаРезультата.ОписаниеОшибки = ЗначениеВСтрокуВнутр(ТаблицаОшибок);
			Иначе
				СтрокаРезультата.Описание = "Операция успешна!";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Документы.ЗаданиеНаИмпортДанныхБанкиКС.СформироватьЗаданиеНаИмпорт(ЗаданиеНаЭкспорт,, Истина);
	
КонецПроцедуры

Процедура ОбработатьДетальныйОтветИзСервиса(Документ, ОтветWebСервиса, ТаблицаОшибок)
	
	Если ПустаяСтрока(ОтветWebСервиса.Ответ) Тогда
		ДобавитьОшибку(ТаблицаОшибок, "Сервис дал пустой ответ", ОтветWebСервиса.ИмяФайла);
		Возврат;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(УдалитьЗаголовкиИзТекста(ОтветWebСервиса.Ответ));
	
	ПостроительDOM = Новый ПостроительDOM;
	Попытка
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	Исключение
		ДобавитьОшибку(ТаблицаОшибок, "Не удалось разобрать ответ", ОтветWebСервиса.ИмяФайла);
		Возврат;
	КонецПопытки;
	
	ОбъектСхемы = ДокументDOM.ПервыйДочерний.ДочерниеУзлы[1].ПервыйДочерний;
	
	Если ОбъектСхемы <> Неопределено И ОбъектСхемы.ЛокальноеИмя = "Fault" Тогда // Ошибки
		
		ТекстОшибки = ПолучитьЗначениеЭлемента(ОбъектСхемы, "Reason");
		
		Если ТекстОшибки = "ValidationFailed" Тогда // Ошибки валидности
			
			Ошибки = ОбъектСхемы.ПолучитьЭлементыПоИмени("ValidationError");
			Для Каждого Ошибка Из Ошибки Цикл
				ТекстОшибки = ПолучитьТекстОшибки(Ошибка.ПервыйДочерний.ТекстовоеСодержимое);
				СвойстваОшибки = Ошибка.ПолучитьЭлементыПоИмени("PropertyNames");
				Для Каждого СвойствоОшибки Из Ошибка.ПоследнийДочерний.ДочерниеУзлы Цикл
					ТекстОшибки = ТекстОшибки + Символы.ПС + " - " + ПолучитьТекстОшибки(СвойствоОшибки.ТекстовоеСодержимое);
				КонецЦикла;
				ДобавитьОшибку(ТаблицаОшибок, ТекстОшибки, ОтветWebСервиса.ИмяФайла);
			КонецЦикла;
			
		Иначе
			
			Ошибки = ОбъектСхемы.ПолучитьЭлементыПоИмени("Message");
			Для Каждого Ошибка Из Ошибки Цикл
				ДобавитьОшибку(ТаблицаОшибок, ПолучитьТекстОшибки(Ошибка.ПервыйДочерний.ТекстовоеСодержимое)); 
			КонецЦикла;
			Если Ошибки.Количество() = 0 Тогда
				ДобавитьОшибку(ТаблицаОшибок, ПолучитьТекстОшибки(ТекстОшибки), ОтветWebСервиса.ИмяФайла);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УдалитьЗаголовкиИзТекста(Знач Текст)
	
	ТекстБуф = Текст;
	Поз = Найти(ТекстБуф, "<");
	
	Пока Поз > 0 Цикл
		
		Поз2 = Мин(Найти(Сред(ТекстБуф, Поз), " "), Найти(Сред(ТекстБуф, Поз), ">"));
		Если Поз2 > 0 Тогда
			Ключ = Сред(ТекстБуф, Поз + 1, Поз2 - 2);
			Поз3 = СтрНайти(ТекстБуф, "</" + Ключ + ">", НаправлениеПоиска.СКонца); 
			Если Поз3 > Поз2 Тогда
				Возврат Сред(ТекстБуф, Поз, Поз3 + СтрДлина(Ключ) + 3 - Поз);
			КонецЕсли;
		КонецЕсли;
		
		ТекстБуф = Сред(ТекстБуф, Поз + Поз2);
		Поз = Найти(ТекстБуф, "<");
		
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

