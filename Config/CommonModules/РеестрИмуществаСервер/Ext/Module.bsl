Функция ВыгрузитьЭлементы(ТипЭлементов) Экспорт
	
	ДокументDOM = Новый ДокументDOM();
	//КорневойЭлемент = ДобавитьЭлемент(ДокументDOM, "ПоставляемыеНастройкиРеестраИмущества");
	//КорневойЭлемент.УстановитьАтрибут("Версия", Метаданные.Версия);
	
	Если ТипЭлементов = "ВидыКартСведенийОбИмуществе" Тогда
		ВыгрузитьВидыКарт(ДокументDOM);
	ИначеЕсли ТипЭлементов = "ВидыОбъектовРеестраИмущества" Тогда
		ВыгрузитьВидыОбъектов(ДокументDOM);
	Иначе
		Возврат "";
	КонецЕсли;
	
	Возврат ДокументDOMвТекстXML(ДокументDOM);
	
КонецФункции

Процедура ВыгрузитьВидыКарт(ЭлементРодитель, ЭлементСсылка = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыКартСведенийОбИмуществе.Ссылка КАК Ссылка,
	|	ВидыКартСведенийОбИмуществе.ЭтоГруппа,
	|	ВидыКартСведенийОбИмуществе.Наименование,
	|	ВидыКартСведенийОбИмуществе.Код,
	|	ВидыКартСведенийОбИмуществе.ТипОбъектаУчета,
	|	ВидыКартСведенийОбИмуществе.ОтборОбъектаУчета,
	|	ВидыКартСведенийОбИмуществе.СтатусПоУмолчанию,
	|	ВидыКартСведенийОбИмуществе.Раздел
	|ИЗ
	|	Справочник.ВидыКартСведенийОбИмуществе КАК ВидыКартСведенийОбИмуществе
	|ГДЕ
	|	НЕ ВидыКартСведенийОбИмуществе.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыКартСведенийОбИмуществе.Код ИЕРАРХИЯ";
	
	Если ЭлементСсылка <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ", "ГДЕ ВидыКартСведенийОбИмуществе.Ссылка = &Ссылка И ");
		Запрос.УстановитьПараметр("Ссылка", ЭлементСсылка);
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ОбходПоВидамКарт(Результат, ЭлементРодитель, ЭлементСсылка <> Неопределено);
	
КонецПроцедуры

Процедура ОбходПоВидамКарт(ДеревоКарт, ЭлементРодитель, Копирование)
	
	Если ДеревоКарт.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементВидыКарт = ДобавитьЭлемент(ЭлементРодитель, "ВидыКартСведенийОбИмуществе");
	
	Для Каждого ВидКарты Из ДеревоКарт.Строки Цикл
		
		Элемент = ДобавитьЭлемент(ЭлементВидыКарт, "ВидКартыСведенийОбИмуществе");
		
		Элемент.УстановитьАтрибут("Ссылка"			, ГУИД(ВидКарты));
		Элемент.УстановитьАтрибут("ЭтоГруппа"		, Формат(ВидКарты.ЭтоГруппа));
		Элемент.УстановитьАтрибут("СлужебноеИмя"	, "ВидКарты_" + ВидКарты.Код);
		Элемент.УстановитьАтрибут("Наименование"	, ВидКарты.Наименование);
		Элемент.УстановитьАтрибут("Код"				, ВидКарты.Код); // Для совместимости с прошлой версией РИ
		
		Если ВидКарты.ЭтоГруппа Тогда
			ОбходПоВидамКарт(ВидКарты, Элемент, Копирование);
		Иначе
			Элемент.УстановитьАтрибут("ТипОбъектаУчета"		, ОбщегоНазначения.ЗначениеВСтрокуXML(ВидКарты.ТипОбъектаУчета.Получить()));
			Элемент.УстановитьАтрибут("ОтборОбъектаУчета"	, ОбработатьСсылки(ВидКарты.ОтборОбъектаУчета, Копирование, Истина));
			Элемент.УстановитьАтрибут("СтатусПоУмолчанию"	, ВидКарты.СтатусПоУмолчанию.Код);
			Элемент.УстановитьАтрибут("Раздел"				, ВидКарты.Раздел);
			ВыгрузитьРеквизиты(Элемент, ВидКарты.Ссылка, Копирование);
			ВыгрузитьПечатныеФормы(Элемент, ВидКарты.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьВидыОбъектов(ЭлементРодитель, ЭлементСсылка = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыОбъектовРеестраИмущества.Ссылка КАК Ссылка,
	|	ВидыОбъектовРеестраИмущества.Наименование,
	|	ВидыОбъектовРеестраИмущества.ФормулаПредставления,
	|	ВидыОбъектовРеестраИмущества.ПоказатьПолеФайлы
	|ИЗ
	|	Справочник.ВидыОбъектовРеестраИмущества КАК ВидыОбъектовРеестраИмущества
	|ГДЕ
	|	НЕ ВидыОбъектовРеестраИмущества.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыОбъектовРеестраИмущества.Код";
	
	Если ЭлементСсылка <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ", "ГДЕ ВидыОбъектовРеестраИмущества.Ссылка = &Ссылка И ");
		Запрос.УстановитьПараметр("Ссылка", ЭлементСсылка);
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементВидыОбъектов = ДобавитьЭлемент(ЭлементРодитель, "ВидыОбъектовРеестраИмущества");
	
	Для Каждого ВидОбъекта Из Результат Цикл
		
		Элемент = ДобавитьЭлемент(ЭлементВидыОбъектов, "ВидОбъектаРеестраИмущества");
		
		Элемент.УстановитьАтрибут("Ссылка"				, ГУИД(ВидОбъекта));
		Элемент.УстановитьАтрибут("СлужебноеИмя"		, "ВидОбъекта_" + ВидОбъекта.Ссылка.Код);
		Элемент.УстановитьАтрибут("Наименование"		, ВидОбъекта.Наименование);
		Элемент.УстановитьАтрибут("ФормулаПредставления", ВидОбъекта.ФормулаПредставления);
		Элемент.УстановитьАтрибут("ПоказатьПолеФайлы"	, Формат(ВидОбъекта.ПоказатьПолеФайлы));
		
		ВыгрузитьРеквизиты(Элемент, ВидОбъекта.Ссылка, ЭлементСсылка <> Неопределено);
		ВыгрузитьФормуСписка(ВидОбъекта.Ссылка, Элемент);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьРеквизиты(ЭлементРодитель, Владелец, Копирование)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыСведенийОбИмуществе.Ссылка КАК Ссылка,
	|	РеквизитыСведенийОбИмуществе.ЭтоГруппа,
	|	РеквизитыСведенийОбИмуществе.Наименование,
	|	РеквизитыСведенийОбИмуществе.РеквизитДопУпорядочивания КАК РеквизитДопУпорядочивания,
	|	РеквизитыСведенийОбИмуществе.ИмяДляФормулы,
	|	РеквизитыСведенийОбИмуществе.ТипРеквизита,
	|	РеквизитыСведенийОбИмуществе.ВидРеквизита,
	|	РеквизитыСведенийОбИмуществе.Группировка,
	|	РеквизитыСведенийОбИмуществе.Отображение,
	|	РеквизитыСведенийОбИмуществе.ОтображатьЗаголовок,
	|	РеквизитыСведенийОбИмуществе.ПоложениеЗаголовка,
	|	РеквизитыСведенийОбИмуществе.Высота,
	|	РеквизитыСведенийОбИмуществе.ВысотаЗаголовка,
	|	РеквизитыСведенийОбИмуществе.РастягиватьПоВертикали,
	|	РеквизитыСведенийОбИмуществе.РастягиватьПоГоризонтали,
	|	РеквизитыСведенийОбИмуществе.РедактироватьВДиалоге,
	|	РеквизитыСведенийОбИмуществе.КнопкаРегулирования,
	|	РеквизитыСведенийОбИмуществе.КнопкаОткрытия,
	|	РеквизитыСведенийОбИмуществе.ОтборЭлементов,
	|	РеквизитыСведенийОбИмуществе.ОтборЗначений,
	|	РеквизитыСведенийОбИмуществе.СвязиПараметровВыбора,
	|	РеквизитыСведенийОбИмуществе.БыстрыйВыбор,
	|	РеквизитыСведенийОбИмуществе.Обязательное,
	|	РеквизитыСведенийОбИмуществе.Недоступное,
	|	РеквизитыСведенийОбИмуществе.ФормулаЗаполнение,
	|	РеквизитыСведенийОбИмуществе.ФормулаОбязательность,
	|	РеквизитыСведенийОбИмуществе.ФормулаНедоступность,
	|	РеквизитыСведенийОбИмуществе.ФормулаКомментарий,
	|	РеквизитыСведенийОбИмуществе.СписокВыбора.(
	|		Значение,
	|		Представление
	|	)
	|ИЗ
	|	Справочник.РеквизитыСведенийОбИмуществе КАК РеквизитыСведенийОбИмуществе
	|ГДЕ
	|	РеквизитыСведенийОбИмуществе.Владелец = &Владелец
	|	И НЕ РеквизитыСведенийОбИмуществе.ПометкаУдаления
	|	И НЕ РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ
	|				(ВЫБРАТЬ
	|					Р.Ссылка
	|				ИЗ
	|					Справочник.РеквизитыСведенийОбИмуществе КАК Р
	|				ГДЕ
	|					Р.ЭтоГруппа
	|					И Р.ПометкаУдаления
	|					И Р.Владелец = &Владелец)
	|
	|УПОРЯДОЧИТЬ ПО
	|	РеквизитДопУпорядочивания ИЕРАРХИЯ";
	
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Если Результат.Строки.Количество() > 0 Тогда
		ЭлементРеквизиты = ДобавитьЭлемент(ЭлементРодитель, "РеквизитыСведенийОбИмуществе");
		ОбходПоРеквизитам(Результат, ЭлементРеквизиты, Копирование);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбходПоРеквизитам(ДеревоРеквизитов, ЭлементРодитель, Копирование)
	
	Ф = "ЧН=; ЧГ=";
	
	Для Каждого Реквизит Из ДеревоРеквизитов.Строки Цикл
		
		ЭлементРеквизит = ДобавитьЭлемент(ЭлементРодитель, "РеквизитСведенийОбИмуществе");
		
		ЭлементРеквизит.УстановитьАтрибут("Ссылка"						, ГУИД(Реквизит));
		ЭлементРеквизит.УстановитьАтрибут("ЭтоГруппа"					, Строка(Реквизит.ЭтоГруппа));
		ЭлементРеквизит.УстановитьАтрибут("Наименование"				, Реквизит.Наименование);
		ЭлементРеквизит.УстановитьАтрибут("РеквизитДопУпорядочивания"	, Формат(Реквизит.РеквизитДопУпорядочивания, Ф));
		ЭлементРеквизит.УстановитьАтрибут("ИмяДляФормулы"				, Реквизит.ИмяДляФормулы);
		ЭлементРеквизит.УстановитьАтрибут("ВидРеквизита"				, ОбщегоНазначения.ИмяЗначенияПеречисления(Реквизит.ВидРеквизита));
		ЭлементРеквизит.УстановитьАтрибут("РастягиватьПоГоризонтали"	, Формат(Реквизит.РастягиватьПоГоризонтали, Ф));
		ЭлементРеквизит.УстановитьАтрибут("Обязательное"				, Формат(Реквизит.Обязательное, Ф));
		ЭлементРеквизит.УстановитьАтрибут("Недоступное"					, Формат(Реквизит.Недоступное, Ф));
		ЭлементРеквизит.УстановитьАтрибут("ФормулаЗаполнение"			, ЗаменитьСимволы(Реквизит.ФормулаЗаполнение));
		ЭлементРеквизит.УстановитьАтрибут("ФормулаОбязательность"		, ЗаменитьСимволы(Реквизит.ФормулаОбязательность));
		ЭлементРеквизит.УстановитьАтрибут("ФормулаНедоступность"		, ЗаменитьСимволы(Реквизит.ФормулаНедоступность));
		ЭлементРеквизит.УстановитьАтрибут("ФормулаКомментарий"			, ЗаменитьСимволы(Реквизит.ФормулаКомментарий));
		
		Если Реквизит.ЭтоГруппа Тогда
			
			ЭлементРеквизит.УстановитьАтрибут("Группировка"				, Формат(Реквизит.Группировка, Ф));
			ЭлементРеквизит.УстановитьАтрибут("Отображение"				, Формат(Реквизит.Отображение, Ф));
			ЭлементРеквизит.УстановитьАтрибут("ОтображатьЗаголовок"		, Формат(Реквизит.ОтображатьЗаголовок, Ф));
			ЭлементРеквизит.УстановитьАтрибут("РедактироватьВДиалоге"	, Формат(Реквизит.РедактироватьВДиалоге, Ф));
			
			ЭлементРеквизиты = ДобавитьЭлемент(ЭлементРеквизит, "РеквизитыСведенийОбИмуществе");
			ОбходПоРеквизитам(Реквизит, ЭлементРеквизиты, Копирование);
			
			ВыгрузитьФормуСписка(Реквизит.Ссылка, ЭлементРеквизит);
			
		Иначе
			
			//ЭлементРеквизит.УстановитьАтрибут("ТипРеквизита"			, ОбщегоНазначения.ЗначениеВСтрокуXML(Реквизит.ТипРеквизита.ТипЗначения));
			ЭлементРеквизит.УстановитьАтрибут("ПоложениеЗаголовка"		, Формат(Реквизит.ПоложениеЗаголовка, Ф));
			ЭлементРеквизит.УстановитьАтрибут("Высота"					, Формат(Реквизит.Высота, Ф));
			ЭлементРеквизит.УстановитьАтрибут("ВысотаЗаголовка"			, Формат(Реквизит.ВысотаЗаголовка, Ф));
			ЭлементРеквизит.УстановитьАтрибут("РастягиватьПоВертикали"	, Формат(Реквизит.РастягиватьПоВертикали, Ф));
			ЭлементРеквизит.УстановитьАтрибут("КнопкаРегулирования"		, Формат(Реквизит.КнопкаРегулирования, Ф));
			ЭлементРеквизит.УстановитьАтрибут("КнопкаОткрытия"			, Формат(Реквизит.КнопкаОткрытия, Ф));
			ЭлементРеквизит.УстановитьАтрибут("СвязиПараметровВыбора"	, Реквизит.СвязиПараметровВыбора);
			ЭлементРеквизит.УстановитьАтрибут("ОтборЭлементов"			, ОбработатьСсылки(Реквизит.ОтборЭлементов, Копирование, Истина));
			ЭлементРеквизит.УстановитьАтрибут("ОтборЗначений"			, ОбработатьСсылки(Реквизит.ОтборЗначений, Копирование, Истина));
			ЭлементРеквизит.УстановитьАтрибут("БыстрыйВыбор"			, Формат(Реквизит.БыстрыйВыбор, Ф));
			
			ВыгрузитьТипРеквизита(Реквизит.ТипРеквизита, ЭлементРеквизит, Копирование); 
			
			ВыгрузитьСписокВыбора(Реквизит.СписокВыбора, ЭлементРеквизит, Копирование);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьТипРеквизита(ТипРеквизита, ЭлементРодитель, Копирование)
	
	Если Не ЗначениеЗаполнено(ТипРеквизита) Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементТипРеквизита = ДобавитьЭлемент(ЭлементРодитель, "ТипРеквизита");
	
	ЭлементТипРеквизита.УстановитьАтрибут("Ссылка", ГУИД(ТипРеквизита));
	
	Если Не Копирование Тогда
		ЭлементТипРеквизита.УстановитьАтрибут("Наименование" , Строка(ТипРеквизита.Наименование));
		ЭлементТипРеквизита.УстановитьАтрибут("Тип"			 , ОбщегоНазначения.ЗначениеВСтрокуXML(ТипРеквизита.ТипЗначения));
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьФормуСписка(Владелец, ЭлементРодитель)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыФормыСписка.Ссылка,
	|	РеквизитыФормыСписка.Наименование,
	|	РеквизитыФормыСписка.РеквизитДопУпорядочивания КАК РеквизитДопУпорядочивания,
	|	РеквизитыФормыСписка.ЭтоГруппа,
	|	РеквизитыФормыСписка.ОтображатьВШапке,
	|	РеквизитыФормыСписка.ИмяДляФормулы,
	|	РеквизитыФормыСписка.РеквизитТаблицы
	|ИЗ
	|	Справочник.РеквизитыФормыСпискаСведенийОбИмуществе КАК РеквизитыФормыСписка
	|ГДЕ
	|	НЕ РеквизитыФормыСписка.ПометкаУдаления
	|	И РеквизитыФормыСписка.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	РеквизитДопУпорядочивания ИЕРАРХИЯ";
	
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ОбходПоРеквизитамФормыСписка(Результат, ЭлементРодитель);
	
КонецПроцедуры

Процедура ОбходПоРеквизитамФормыСписка(Дерево, ЭлементРодитель)
	
	Если Дерево.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементФормаСписка = ДобавитьЭлемент(ЭлементРодитель, "РеквизитыФормыСпискаСведенийОбИмуществе");
	
	Для Каждого Реквизит Из Дерево.Строки Цикл
		
		ЭлементРеквизит = ДобавитьЭлемент(ЭлементФормаСписка, "РеквизитФормыСписка");
		
		ЭлементРеквизит.УстановитьАтрибут("Ссылка"						, ГУИД(Реквизит));
		ЭлементРеквизит.УстановитьАтрибут("ЭтоГруппа"					, Формат(Реквизит.ЭтоГруппа));
		ЭлементРеквизит.УстановитьАтрибут("Наименование"				, Реквизит.Наименование);
		ЭлементРеквизит.УстановитьАтрибут("РеквизитДопУпорядочивания"	, Формат(Реквизит.РеквизитДопУпорядочивания));
		
		Если Реквизит.ЭтоГруппа Тогда
			ЭлементРеквизит.УстановитьАтрибут("ОтображатьВШапке", Формат(Реквизит.ОтображатьВШапке));
			ЭлементРеквизит.УстановитьАтрибут("ИмяДляФормулы"	, Реквизит.ИмяДляФормулы);
			ОбходПоРеквизитамФормыСписка(Реквизит, ЭлементРеквизит);
		Иначе
			ЭлементРеквизит.УстановитьАтрибут("РеквизитТаблицы"	, ГУИД(Реквизит.РеквизитТаблицы));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьСписокВыбора(Список, ЭлементРодитель, Копирование)
	
	Если Список.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементСписокВыбора = ДобавитьЭлемент(ЭлементРодитель, "СписокВыбора");
	Для Каждого СтрокаСписка Из Список Цикл
		
		Если СтрокаСписка.Значение = Неопределено Тогда
			Значение = "Неопределено";
		ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗнч(СтрокаСписка.Значение)) Тогда
			Значение = ОбщегоНазначения.ЗначениеВСтрокуXML(СтрокаСписка.Значение);
			Значение = ОбработатьСсылки(Значение, Копирование, Истина);
		Иначе
			Значение = Формат(СтрокаСписка.Значение, "ЧН=; ЧГ=; ДФ=yyyyMMddhhmmss");
		КонецЕсли;
		
		ЭлементСписка = ДобавитьЭлемент(ЭлементСписокВыбора, "ЭлементСписка");
		ЭлементСписка.УстановитьАтрибут("Значение"		, Значение);
		ЭлементСписка.УстановитьАтрибут("Представление"	, СтрокаСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьПечатныеФормы(ЭлементРодитель, Владелец)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПечатныеФормы.Ссылка КАК Ссылка,
	|	ПечатныеФормы.Наименование,
	|	ПечатныеФормы.ПравилаПечати.(
	|		ИмяСекции,
	|		ТаблицаДанных,
	|		ВидПовтора,
	|		СтраницаС,
	|		СтраницаПо,
	|		Макет
	|	),
	|	ПечатныеФормы.ПараметрыПечати.(
	|		ИдентификаторПравила,
	|		ПараметрПечати,
	|		Формула
	|	)
	|ИЗ
	|	Справочник.ПечатныеФормыВидовКартСведенийОбИмуществе КАК ПечатныеФормы
	|ГДЕ
	|	ПечатныеФормы.Владелец = &Владелец
	|	И НЕ ПечатныеФормы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Результат = Запрос.Выполнить().Выгрузить();
	
	// Выгрузка печатных форм
	Если Результат.Количество() > 0 Тогда
		
		Ф = "ЧН=; ЧГ=";
		
		ЭлементПечатныеФормы = ДобавитьЭлемент(ЭлементРодитель, "ПечатныеФормыВидовКартСведенийОбИмуществе");
		
		Для Каждого ПечатнаяФорма Из Результат Цикл
		
			ЭлементПечатнаяФорма = ДобавитьЭлемент(ЭлементПечатныеФормы, "ПечатнаяФормаВидовКартСведенийОбИмуществе");
			
			ЭлементПечатнаяФорма.УстановитьАтрибут("Ссылка"			, ГУИД(ПечатнаяФорма));		
			ЭлементПечатнаяФорма.УстановитьАтрибут("Наименование"	, ПечатнаяФорма.Наименование);
			
			// Выгрузка правил печати
			Если ПечатнаяФорма.ПравилаПечати.Количество() > 0  Тогда
				
				ЭлементПравилаПечати = ДобавитьЭлемент(ЭлементПечатнаяФорма, "ПравилаПечати");
				
				Для Каждого ПравилоПечати Из ПечатнаяФорма.ПравилаПечати Цикл
					
					ЭлементПравилоПечати = ДобавитьЭлемент(ЭлементПравилаПечати, "ПравилоПечати");
					
					ЭлементПравилоПечати.УстановитьАтрибут("ИмяСекции"		, ПравилоПечати.ИмяСекции);
					ЭлементПравилоПечати.УстановитьАтрибут("ТаблицаДанных"	, ПравилоПечати.ТаблицаДанных);
					ЭлементПравилоПечати.УстановитьАтрибут("ВидПовтора"		, Формат(ПравилоПечати.ВидПовтора, Ф));
					ЭлементПравилоПечати.УстановитьАтрибут("СтраницаС"		, Формат(ПравилоПечати.СтраницаС, Ф));
					ЭлементПравилоПечати.УстановитьАтрибут("СтраницаПо"		, Формат(ПравилоПечати.СтраницаПо, Ф));
					ЭлементПравилоПечати.УстановитьАтрибут("Макет"			, ЗаменитьСимволы(ПравилоПечати.Макет));
					
				КонецЦикла;
			КонецЕсли;
			
			// Выгрузка параметров печати
			Если ПечатнаяФорма.ПараметрыПечати.Количество() > 0  Тогда
				
				ЭлементПараметрыПечати = ДобавитьЭлемент(ЭлементПечатнаяФорма, "ПараметрыПечати");
				
				Для Каждого ПараметрПечати Из ПечатнаяФорма.ПараметрыПечати Цикл
					
					ЭлементПараметрПечати = ДобавитьЭлемент(ЭлементПараметрыПечати, "ПараметрПечати");
					
					ЭлементПараметрПечати.УстановитьАтрибут("ИдентификаторПравила"	, Формат(ПараметрПечати.ИдентификаторПравила, Ф));
					ЭлементПараметрПечати.УстановитьАтрибут("ПараметрПечати"		, ПараметрПечати.ПараметрПечати);
					ЭлементПараметрПечати.УстановитьАтрибут("Формула"				, ЗаменитьСимволы(ПараметрПечати.Формула));
					
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьЭлемент(ЭлементDOM, Поле)
	
	Узел = ЭлементDOM.ДокументВладелец.СоздатьЭлемент(Поле);
	ЭлементDOM.ДобавитьДочерний(Узел);
	
	Возврат Узел;
	
КонецФункции

Функция ГУИД(Элемент)
	
	Возврат Строка(Элемент.Ссылка.УникальныйИдентификатор());
	
КонецФункции

Функция ДокументDOMвТекстXML(ДокументDOM)
	
	ДокументDOM.НормализоватьДокумент();
	
	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.УстановитьСтроку();
	ФайлDOM = Новый ЗаписьDOM();
	ФайлDOM.Записать(ДокументDOM, ЗаписьXML);
	ТекстXML = ЗаписьXML.Закрыть();
	
	Возврат ТекстXML;
	
КонецФункции


//////////////////////////////////////////////////////////////////////////////
// Загрузка

Функция ЗагрузитьЭлементы(МассивКЗагрузке = Неопределено, ТекстМакета = "") Экспорт
	
	УспешнаяЗагрузка = Истина;
	
	НачатьТранзакцию();
	
	Попытка
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ТекстМакета);
		
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		
		ПараметрыЗагрузки = Новый Структура;
		ПараметрыЗагрузки.Вставить("СоответствиеОбъектов", Новый Соответствие);
		ПараметрыЗагрузки.Вставить("МассивКЗагрузке", ?(МассивКЗагрузке = Неопределено, Новый Массив, МассивКЗагрузке));
		ПараметрыЗагрузки.Вставить("Копирование", Ложь);
		
		ЗагрузитьЭлементыУзла(ДокументDOM,, ПараметрыЗагрузки);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		УспешнаяЗагрузка = Ложь;
		//ТекстОшибки = НСтр("ru = 'Произошла ошибка при загрузке справочника ""Виды карт сведений об имуществе""'");
		//ЗаписьЖурналаРегистрации(НСтр("ru = 'Загрузка видов карт реестра имущества'"), УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки);
		ОтменитьТранзакцию();
	КонецПопытки;
	
	//КонецЕсли;
	
	Возврат УспешнаяЗагрузка;
	
КонецФункции

Процедура ЗагрузитьЭлементыУзла(Узел, Родитель = Неопределено, ПараметрыЗагрузки)
	
	Для Каждого ЗагружаемыйУзел Из Узел.ДочерниеУзлы Цикл
		
		Если ЗагружаемыйУзел.ИмяУзла = "ВидыКартСведенийОбИмуществе" Тогда
			ЗагрузитьВидыКарт(ЗагружаемыйУзел, Родитель, ПараметрыЗагрузки);
		ИначеЕсли ЗагружаемыйУзел.ИмяУзла = "ВидыОбъектовРеестраИмущества" Тогда
			ЗагрузитьВидыОбъектов(ЗагружаемыйУзел, Родитель, ПараметрыЗагрузки);
		ИначеЕсли ЗагружаемыйУзел.ИмяУзла = "РеквизитыСведенийОбИмуществе" Тогда
			ЗагрузитьРеквизиты(ЗагружаемыйУзел, Родитель, ПараметрыЗагрузки);
		ИначеЕсли ЗагружаемыйУзел.ИмяУзла = "СписокВыбора" Тогда
			ЗагрузитьСписокВыбора(ЗагружаемыйУзел, Родитель, ПараметрыЗагрузки);
		ИначеЕсли ЗагружаемыйУзел.ИмяУзла = "РеквизитыФормыСпискаСведенийОбИмуществе" Тогда
			ЗагрузитьРеквизитыФормыСписка(ЗагружаемыйУзел, Родитель, ПараметрыЗагрузки)
		ИначеЕсли ЗагружаемыйУзел.ИмяУзла = "ПечатныеФормыВидовКартСведенийОбИмуществе" Тогда
			ЗагрузитьПечатныеФормы(ЗагружаемыйУзел, Родитель, ПараметрыЗагрузки);
		ИначеЕсли ЗагружаемыйУзел.ИмяУзла = "ПравилаПечати" Тогда
			ЗагрузитьПравилаПечати(ЗагружаемыйУзел, Родитель, ПараметрыЗагрузки);
		ИначеЕсли ЗагружаемыйУзел.ИмяУзла = "ПараметрыПечати" Тогда
			ЗагрузитьПараметрыПечати(ЗагружаемыйУзел, Родитель, ПараметрыЗагрузки)
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьВидыКарт(УзелРодитель, Родитель, ПараметрыЗагрузки)
	
	Для Каждого Узел Из УзелРодитель.ДочерниеУзлы Цикл
		
		Если ТипЗнч(Узел) <> Тип("ЭлементDOM") Тогда
			Продолжить;
		КонецЕсли;
		
		Менеджер = Справочники.ВидыКартСведенийОбИмуществе;
		Объект = ПолучитьОбъектПоСсылкеУзла(Узел, Менеджер, ПараметрыЗагрузки, Истина, Истина);
		
		Если ПараметрыЗагрузки.МассивКЗагрузке.Количество() = 0 Или ПараметрыЗагрузки.МассивКЗагрузке.Найти(Узел.ПолучитьАтрибут("СлужебноеИмя")) <> Неопределено Тогда
			
			Объект.Родитель = Родитель;
			Объект.Наименование = Узел.ПолучитьАтрибут("Наименование");
			
			Если Не Объект.ЭтоГруппа Тогда
				Объект.ТипОбъектаУчета = Новый ХранилищеЗначения(ОбщегоНазначения.ЗначениеИзСтрокиXML(Узел.ПолучитьАтрибут("ТипОбъектаУчета")));
				Объект.ОтборОбъектаУчета = ОбработатьСсылки(Узел.ПолучитьАтрибут("ОтборОбъектаУчета"), ПараметрыЗагрузки.Копирование); 
				Объект.СтатусПоУмолчанию = Справочники.СтатусыКартРеестраИмущества.НайтиПоКоду(Узел.ПолучитьАтрибут("СтатусПоУмолчанию"));
				Объект.Раздел = Узел.ПолучитьАтрибут("Раздел"); 
			КонецЕсли;
			
			Если Объект.Код = "" Тогда
				Объект.УстановитьНовыйКод();
			КонецЕсли;
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(Объект, Истина, ПараметрыЗагрузки.Копирование);
			ПараметрыЗагрузки.СоответствиеОбъектов.Вставить(ПолучитьСсылкуОбъекта(Узел, Менеджер), Объект.Ссылка);
			
			Если Не Объект.ЭтоГруппа Тогда
				ПометитьНаУдалениеПодчиненные(Объект.Ссылка, "Справочник.РеквизитыСведенийОбИмуществе");
			КонецЕсли;
			
		КонецЕсли;
		
		ЗагрузитьЭлементыУзла(Узел, Объект.Ссылка, ПараметрыЗагрузки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьВидыОбъектов(УзелРодитель, Родитель, ПараметрыЗагрузки)
	
	Для Каждого Узел Из УзелРодитель.ДочерниеУзлы Цикл
		
		Если ТипЗнч(Узел) <> Тип("ЭлементDOM") Тогда
			Продолжить;
		КонецЕсли;
		
		Менеджер = Справочники.ВидыОбъектовРеестраИмущества;
		Объект = ПолучитьОбъектПоСсылкеУзла(Узел, Менеджер, ПараметрыЗагрузки);
		
		Если ПараметрыЗагрузки.МассивКЗагрузке.Количество() = 0 Или ПараметрыЗагрузки.МассивКЗагрузке.Найти(Узел.ПолучитьАтрибут("СлужебноеИмя")) <> Неопределено Тогда
			
			
			Объект.Наименование			= Узел.ПолучитьАтрибут("Наименование");
			Объект.ФормулаПредставления	= Узел.ПолучитьАтрибут("ФормулаПредставления");
			Объект.ПоказатьПолеФайлы	= Узел.ПолучитьАтрибут("ПоказатьПолеФайлы");
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(Объект, Истина, ПараметрыЗагрузки.Копирование);
			ПараметрыЗагрузки.СоответствиеОбъектов.Вставить(ПолучитьСсылкуОбъекта(Узел, Менеджер), Объект.Ссылка);
			
			ПометитьНаУдалениеПодчиненные(Объект.Ссылка, "Справочник.РеквизитыСведенийОбИмуществе");
			
		КонецЕсли;
		
		ЗагрузитьЭлементыУзла(Узел, Объект.Ссылка, ПараметрыЗагрузки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьРеквизиты(УзелРодитель, Родитель, ПараметрыЗагрузки)
	
	Для Каждого Узел Из УзелРодитель.ДочерниеУзлы Цикл
		
		Если ТипЗнч(Узел) <> Тип("ЭлементDOM") Тогда
			Продолжить;
		КонецЕсли;
		
		Менеджер = Справочники.РеквизитыСведенийОбИмуществе;
		РеквизитОбъект = ПолучитьОбъектПоСсылкеУзла(Узел, Менеджер, ПараметрыЗагрузки, Истина);
		
		УстановитьКорни(РеквизитОбъект, Родитель);
		
		РеквизитОбъект.Наименование					= Узел.ПолучитьАтрибут("Наименование");
		
		РеквизитОбъект.ИмяДляФормулы				= Узел.ПолучитьАтрибут("ИмяДляФормулы");
		РеквизитОбъект.РеквизитДопУпорядочивания	= Узел.ПолучитьАтрибут("РеквизитДопУпорядочивания");
		РеквизитОбъект.ВидРеквизита					= Перечисления.ВидыРеквизитовСведенийОбИмуществе[Узел.ПолучитьАтрибут("ВидРеквизита")];
		РеквизитОбъект.РастягиватьПоГоризонтали		= Узел.ПолучитьАтрибут("РастягиватьПоГоризонтали");
		РеквизитОбъект.Обязательное					= Узел.ПолучитьАтрибут("Обязательное");
		РеквизитОбъект.Недоступное					= Узел.ПолучитьАтрибут("Недоступное");
		РеквизитОбъект.ФормулаЗаполнение			= ЗаменитьСимволы(Узел.ПолучитьАтрибут("ФормулаЗаполнение")		, Истина);
		РеквизитОбъект.ФормулаОбязательность		= ЗаменитьСимволы(Узел.ПолучитьАтрибут("ФормулаОбязательность")	, Истина);
		РеквизитОбъект.ФормулаНедоступность			= ЗаменитьСимволы(Узел.ПолучитьАтрибут("ФормулаНедоступность")	, Истина);
		РеквизитОбъект.ФормулаКомментарий			= ЗаменитьСимволы(Узел.ПолучитьАтрибут("ФормулаКомментарий")	, Истина);
		
		Если РеквизитОбъект.ЭтоГруппа Тогда
			
			РеквизитОбъект.Группировка				= Узел.ПолучитьАтрибут("Группировка");
			РеквизитОбъект.Отображение				= Узел.ПолучитьАтрибут("Отображение");
			РеквизитОбъект.ОтображатьЗаголовок		= Узел.ПолучитьАтрибут("ОтображатьЗаголовок");
			РеквизитОбъект.РедактироватьВДиалоге	= Узел.ПолучитьАтрибут("РедактироватьВДиалоге");
			
		Иначе
			
			РеквизитОбъект.ТипРеквизита				= ТипыРеквизитовНайтиПоТипу(Узел, ПараметрыЗагрузки);
			РеквизитОбъект.ПоложениеЗаголовка		= Узел.ПолучитьАтрибут("ПоложениеЗаголовка");
			РеквизитОбъект.Высота					= Узел.ПолучитьАтрибут("Высота");
			РеквизитОбъект.ВысотаЗаголовка			= Узел.ПолучитьАтрибут("ВысотаЗаголовка");
			РеквизитОбъект.РастягиватьПоВертикали	= Узел.ПолучитьАтрибут("РастягиватьПоВертикали");
			РеквизитОбъект.КнопкаРегулирования		= Узел.ПолучитьАтрибут("КнопкаРегулирования");
			РеквизитОбъект.КнопкаОткрытия			= Узел.ПолучитьАтрибут("КнопкаОткрытия");
			РеквизитОбъект.СвязиПараметровВыбора	= Узел.ПолучитьАтрибут("СвязиПараметровВыбора");
			РеквизитОбъект.ОтборЭлементов			= ОбработатьСсылки(Узел.ПолучитьАтрибут("ОтборЭлементов"), ПараметрыЗагрузки.Копирование);
			РеквизитОбъект.ОтборЗначений			= ОбработатьСсылки(Узел.ПолучитьАтрибут("ОтборЗначений"), ПараметрыЗагрузки.Копирование);
			РеквизитОбъект.БыстрыйВыбор				= Узел.ПолучитьАтрибут("БыстрыйВыбор");
			
			РеквизитОбъект.СписокВыбора.Очистить();
			
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(РеквизитОбъект, Истина);
		ПараметрыЗагрузки.СоответствиеОбъектов.Вставить(ПолучитьСсылкуОбъекта(Узел, Менеджер), РеквизитОбъект.Ссылка);
		
		Если РеквизитОбъект.ЭтоГруппа Тогда
			ПометитьНаУдалениеПодчиненные(РеквизитОбъект.Ссылка, "Справочник.РеквизитыФормыСпискаСведенийОбИмуществе");
		КонецЕсли;
		
		ЗагрузитьЭлементыУзла(Узел, РеквизитОбъект.Ссылка, ПараметрыЗагрузки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьСписокВыбора(УзелРодитель, Родитель, ПараметрыЗагрузки)
	
	ВладелецОбъект = Родитель.ПолучитьОбъект();
	ВладелецОбъект.СписокВыбора.Очистить();
	
	Для Каждого Узел Из УзелРодитель.ДочерниеУзлы Цикл
		
		Если ТипЗнч(Узел) <> Тип("ЭлементDOM") Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементСписка = ВладелецОбъект.СписокВыбора.Добавить();
		Значение = Узел.ПолучитьАтрибут("Значение");
		
		Если Значение = "Неопределено" Тогда
			Значение = Неопределено;
		ИначеЕсли ОбщегоНазначенияБГУКлиентСервер.ЭтоСтрокаXML(Значение) Тогда
			Значение = ОбработатьСсылки(Значение, ПараметрыЗагрузки.Копирование);
			Значение = ОбщегоНазначения.ЗначениеИзСтрокиXML(Значение);
		Иначе
			Значение = ВладелецОбъект.ТипРеквизита.ТипЗначения.ПривестиЗначение(Значение)
		КонецЕсли;
		
		ЭлементСписка.Значение = Значение;
		ЭлементСписка.Представление = Узел.ПолучитьАтрибут("Представление");
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(ВладелецОбъект, Истина);
	
КонецПроцедуры

Процедура ЗагрузитьРеквизитыФормыСписка(УзелРодитель, Родитель, ПараметрыЗагрузки)
	
	Для Каждого Узел Из УзелРодитель.ДочерниеУзлы Цикл
		
		Если ТипЗнч(Узел) <> Тип("ЭлементDOM") Тогда
			Продолжить;
		КонецЕсли;
		
		Менеджер = Справочники.РеквизитыФормыСпискаСведенийОбИмуществе;
		ЭлементСсылка = Неопределено;
		РеквизитОбъект = ПолучитьОбъектПоСсылкеУзла(Узел, Менеджер, ПараметрыЗагрузки, Истина);
		
		УстановитьКорни(РеквизитОбъект, Родитель);
		
		РеквизитОбъект.Наименование	= Узел.ПолучитьАтрибут("Наименование");
		РеквизитОбъект.РеквизитДопУпорядочивания = Узел.ПолучитьАтрибут("РеквизитДопУпорядочивания");
		
		Если РеквизитОбъект.ЭтоГруппа Тогда
			РеквизитОбъект.ОтображатьВШапке = Узел.ПолучитьАтрибут("ОтображатьВШапке");
			РеквизитОбъект.ИмяДляФормулы = Узел.ПолучитьАтрибут("ИмяДляФормулы");
			
		Иначе
			//ГУИД = Новый УникальныйИдентификатор(Узел.ПолучитьАтрибут("РеквизитТаблицы"));
			//Рекв = Справочники.РеквизитыСведенийОбИмуществе.ПолучитьСсылку(ГУИД);
			Рекв = ПолучитьСсылкуОбъекта(Узел, Справочники.РеквизитыСведенийОбИмуществе, "РеквизитТаблицы");
			РеквизитОбъект.РеквизитТаблицы = ПараметрыЗагрузки.СоответствиеОбъектов[Рекв];
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(РеквизитОбъект, Истина);
		ЗагрузитьЭлементыУзла(Узел, РеквизитОбъект.Ссылка, ПараметрыЗагрузки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьПечатныеФормы(УзелРодитель, Родитель, ПараметрыЗагрузки)
	
	Для Каждого Узел Из УзелРодитель.ДочерниеУзлы Цикл
		
		Если ТипЗнч(Узел) <> Тип("ЭлементDOM") Тогда
			Продолжить;
		КонецЕсли;
		
		Менеджер = Справочники.ПечатныеФормыВидовКартСведенийОбИмуществе;
		ПечатнаяФормаОбъект = ПолучитьОбъектПоСсылкеУзла(Узел, Менеджер, ПараметрыЗагрузки);
		
		УстановитьКорни(ПечатнаяФормаОбъект, Родитель);
		
		ПечатнаяФормаОбъект.Наименование = Узел.ПолучитьАтрибут("Наименование");
		
		Если ПечатнаяФормаОбъект.Код = "" Тогда
			ПечатнаяФормаОбъект.УстановитьНовыйКод();
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(ПечатнаяФормаОбъект, Истина);
		ЗагрузитьЭлементыУзла(Узел, ПечатнаяФормаОбъект.Ссылка, ПараметрыЗагрузки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьПравилаПечати(УзелРодитель, Родитель, ПараметрыЗагрузки)
	
	ВладелецОбъект = Родитель.ПолучитьОбъект();
	ВладелецОбъект.ПравилаПечати.Очистить();
	
	Для Каждого Узел Из УзелРодитель.ДочерниеУзлы Цикл
		
		Если ТипЗнч(Узел) <> Тип("ЭлементDOM") Тогда
			Продолжить;
		КонецЕсли;
		
		ПравилоПечати = ВладелецОбъект.ПравилаПечати.Добавить();
		
		ПравилоПечати.ИмяСекции		= Узел.ПолучитьАтрибут("ИмяСекции");
		ПравилоПечати.ТаблицаДанных	= Узел.ПолучитьАтрибут("ТаблицаДанных");
		ПравилоПечати.ВидПовтора	= Узел.ПолучитьАтрибут("ВидПовтора");
		ПравилоПечати.СтраницаС		= Узел.ПолучитьАтрибут("СтраницаС");
		ПравилоПечати.СтраницаПо	= Узел.ПолучитьАтрибут("СтраницаПо");
		ПравилоПечати.Макет			= ЗаменитьСимволы(Узел.ПолучитьАтрибут("Макет"), Истина);
		
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(ВладелецОбъект, Истина);
	
КонецПроцедуры

Процедура ЗагрузитьПараметрыПечати(УзелРодитель, Родитель, ПараметрыЗагрузки)
	
	ВладелецОбъект = Родитель.ПолучитьОбъект();
	ВладелецОбъект.ПараметрыПечати.Очистить();
	
	Для Каждого Узел Из УзелРодитель.ДочерниеУзлы Цикл
		
		Если ТипЗнч(Узел) <> Тип("ЭлементDOM") Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрПечати = ВладелецОбъект.ПараметрыПечати.Добавить();
		
		ПараметрПечати.ИдентификаторПравила	= Узел.ПолучитьАтрибут("ИдентификаторПравила");
		ПараметрПечати.ПараметрПечати		= Узел.ПолучитьАтрибут("ПараметрПечати");		
		ПараметрПечати.Формула				= ЗаменитьСимволы(Узел.ПолучитьАтрибут("Формула"), Истина);
		
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(ВладелецОбъект, Истина);
	
КонецПроцедуры


Функция ПолучитьОбъектПоСсылкеУзла(Узел, Менеджер, ПараметрыЗагрузки, Иерархический = Ложь, ПолучатьПоКоду = Ложь)
	
	ЭлементСсылка = ПолучитьСсылкуОбъекта(Узел, Менеджер,, ПолучатьПоКоду);
	
	Если Иерархический Тогда
		ЭтоГруппа = ?(ВРег(СокрЛП(Узел.ПолучитьАтрибут("ЭтоГруппа"))) = "ДА", Истина, Ложь);
		НеверныйТипЭлемента = ЭлементСсылка.ЭтоГруппа <> ЭтоГруппа;
	Иначе
		ЭтоГруппа = Ложь;
		НеверныйТипЭлемента = Ложь;
	КонецЕсли;
	
	Если ПараметрыЗагрузки.Копирование Тогда
		ЭлементОбъект = ?(ЭтоГруппа, Менеджер.СоздатьГруппу(), Менеджер.СоздатьЭлемент());
	Иначе
		Если ОбщегоНазначения.СсылкаСуществует(ЭлементСсылка) Тогда		
			Если НеверныйТипЭлемента Тогда
				ЭлементСсылка.ПолучитьОбъект().Удалить();
				ЭлементОбъект = ?(ЭтоГруппа, Менеджер.СоздатьГруппу(), Менеджер.СоздатьЭлемент());
				ЭлементОбъект.УстановитьСсылкуНового(ЭлементСсылка);
			Иначе
				ЭлементОбъект = ЭлементСсылка.ПолучитьОбъект();
				ЭлементОбъект.ПометкаУдаления = Ложь;
			КонецЕсли;
		Иначе
			ЭлементОбъект = ?(ЭтоГруппа, Менеджер.СоздатьГруппу(), Менеджер.СоздатьЭлемент());
			ЭлементОбъект.УстановитьСсылкуНового(ЭлементСсылка);
		КонецЕсли;
	КонецЕсли;	
	
	//ПараметрыЗагрузки.СоответствиеОбъектов.Вставить(ЭлементСсылка, ЭлементОбъект.Ссылка);
	
	Возврат ЭлементОбъект;
	
КонецФункции

Функция ПолучитьСсылкуОбъекта(Узел, Менеджер, ИмяАтрибута = "Ссылка", ПолучатьПоКоду = Ложь)
	
	ГУИД = Новый УникальныйИдентификатор(Узел.ПолучитьАтрибут(ИмяАтрибута));
	ЭлементСсылка = Менеджер.ПолучитьСсылку(ГУИД);
	
	Если ПолучатьПоКоду И Не ОбщегоНазначения.СсылкаСуществует(ЭлементСсылка) Тогда
		ЭлементСсылка = Менеджер.НайтиПоКоду(Узел.ПолучитьАтрибут("Код"));
	КонецЕсли;
	
	Возврат ЭлементСсылка;
	
КонецФункции

Процедура УстановитьКорни(ЭлементОбъект, Родитель)
	
	Если ТипЗнч(ЭлементОбъект.Ссылка) = ТипЗнч(Родитель) Тогда
		ЭлементОбъект.Родитель = Родитель;
		ЭлементОбъект.Владелец = Родитель.Владелец;
	Иначе
		//ЭлементОбъект.Родитель = Неопределено;
		ЭлементОбъект.Владелец = Родитель;
	КонецЕсли;
	
КонецПроцедуры

Функция ТипыРеквизитовНайтиПоТипу(УзелРеквизита, ПараметрыЗагрузки)
	
	Для Каждого Узел Из УзелРеквизита.ДочерниеУзлы Цикл
		Если Узел.ИмяУзла = "ТипРеквизита" Тогда
			
			Менеджер = ПланыВидовХарактеристик.ТипыРеквизитовСведенийОбИмуществе;
			ТипСсылка = ПолучитьСсылкуОбъекта(Узел, Менеджер);
			
			Если ПараметрыЗагрузки.Копирование Тогда
				Возврат ТипСсылка;
			Иначе
				ТипЗначения = ОбщегоНазначения.ЗначениеИзСтрокиXML(Узел.ПолучитьАтрибут("Тип"));
				
				Если ОбщегоНазначения.СсылкаСуществует(ТипСсылка) Тогда
					ТипОбъект = ТипСсылка.ПолучитьОбъект();
				Иначе
					Элемент = Менеджер.Выбрать();
					//ТипСсылка = Неопределено;
					Пока Элемент.Следующий() Цикл
						Если Элемент.ТипЗначения = ТипЗначения Тогда
							Возврат Элемент.Ссылка;
							//Прервать;
						КонецЕсли;
					КонецЦикла;
					//ТипОбъект = ?(ТипСсылка = Неопределено, Менеджер.СоздатьЭлемент(), ТипСсылка.ПолучитьОбъект());
					ТипОбъект = Менеджер.СоздатьЭлемент(); 
				КонецЕсли;
				
				ТипОбъект.Наименование		= Узел.ПолучитьАтрибут("Наименование");
				ТипОбъект.ТипЗначения		= ТипЗначения;
				ТипОбъект.ПометкаУдаления	= Ложь;
				
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(ТипОбъект, Истина);
				
				Возврат ТипОбъект.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПланыВидовХарактеристик.ТипыРеквизитовСведенийОбИмуществе.ПустаяСсылка();
	
КонецФункции

Процедура ПометитьНаУдалениеПодчиненные(Владелец, ИмяПодчиененныхМетаданных)
	
	//МассивЗагружаемых = Новый Массив;
	//
	//Если Реквизиты <> Неопределено Тогда
	//	УзлыРеквизиты = Реквизиты.ПолучитьЭлементыПоИмени("РеквизитСведенийОбИмуществе");
	//	Для Каждого Узел Из УзлыРеквизиты Цикл
	// 	   ГУИД = Новый УникальныйИдентификатор(Узел.ПолучитьАтрибут("Ссылка"));
	// 	   МассивЗагружаемых.Добавить(Справочники.РеквизитыСведенийОбИмуществе.ПолучитьСсылку(ГУИД));
	//	КонецЦикла;
	//КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Элементы.Ссылка
	|ИЗ
	|	" + ИмяПодчиененныхМетаданных + " КАК Элементы
	|ГДЕ
	|	Элементы.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", Владелец);
	//Запрос.УстановитьПараметр("МассивЗагружаемых", МассивЗагружаемых);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЭлементОбъект.ОбменДанными.Загрузка = Истина;
		ЭлементОбъект.УстановитьПометкуУдаления(Истина, Ложь);
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаменитьСимволы(Знач ВхСтрока, Загрузка = Ложь)
	
	ЗаменяемыеСимволы = Новый Массив;
	ЗаменяемыеСимволы.Добавить(Символы.Таб);
	ЗаменяемыеСимволы.Добавить(Символы.ПС);
	
	Для Каждого ЗаменяемыйСимвол Из ЗаменяемыеСимволы Цикл
		ПсевдонимСимвола = "#" + Формат(КодСимвола(ЗаменяемыйСимвол, 1),"ЧГ=");
		Если Загрузка Тогда
			ЧтоЗаменяем		= ПсевдонимСимвола;
			НаЧтоЗаменяем	= ЗаменяемыйСимвол;
		Иначе
			ЧтоЗаменяем		= ЗаменяемыйСимвол;
			НаЧтоЗаменяем	= ПсевдонимСимвола;
		КонецЕсли;
		ВхСтрока = СтрЗаменить(ВхСтрока, ЧтоЗаменяем, НаЧтоЗаменяем);
	КонецЦикла;
	
	Возврат ВхСтрока;
	
КонецФункции


//////////////////////////////////////////////////////////////////////////////
// Загрузка выгрузка

Процедура ОбновитьПоставляемыеДанные(Перезаполнять = Истина, Принудительно = Ложь) Экспорт
	
	Если Не Принудительно И Не Константы.ИспользоватьИнтеграциюРФИ.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	Справочники.СтатусыКартРеестраИмущества.ЗаполнитьПоУмолчанию(Перезаполнять);	
	Справочники.ЗначенияРеквизитовСведенийОбИмуществе.ЗаполнитьПоУмолчанию(Перезаполнять);
	РегистрыСведений.СвязиЗначенийРеквизитовСведенийОбИмуществе.ЗаполнитьПоУмолчанию(Перезаполнять);
	Справочники.ВидыОбъектовРеестраИмущества.ЗаполнитьПоУмолчанию(Перезаполнять);
	Справочники.ВидыКартСведенийОбИмуществе.ЗаполнитьПоУмолчанию(Перезаполнять);
	
КонецПроцедуры

Функция СкопироватьУзел(ЭлементСсылка) Экспорт
	
	ДокументDOM = Новый ДокументDOM();
	
	Если ТипЗнч(ЭлементСсылка) = Тип("СправочникСсылка.ВидыКартСведенийОбИмуществе") Тогда
		ВыгрузитьВидыКарт(ДокументDOM, ЭлементСсылка);
		Родитель = ЭлементСсылка.Родитель;
	ИначеЕсли ТипЗнч(ЭлементСсылка) = Тип("СправочникСсылка.ВидыОбъектовРеестраИмущества") Тогда
		ВыгрузитьВидыОбъектов(ДокументDOM, ЭлементСсылка);
		Родитель = Неопределено;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		
		ПараметрыЗагрузки = Новый Структура;
		ПараметрыЗагрузки.Вставить("СоответствиеОбъектов", Новый Соответствие);
		ПараметрыЗагрузки.Вставить("МассивКЗагрузке", Новый Массив);
		ПараметрыЗагрузки.Вставить("Копирование", Истина);
		
		ЗагрузитьЭлементыУзла(ДокументDOM, Родитель, ПараметрыЗагрузки);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		//ТекстОшибки = НСтр("ru = 'Произошла ошибка при копировании'");
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Копирование'"), УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.ВидыКартСведенийОбИмуществе,ЭлементСсылка);
		ОтменитьТранзакцию();
	КонецПопытки; 
	
	Возврат ПараметрыЗагрузки.СоответствиеОбъектов[ЭлементСсылка];
	
КонецФункции

Функция ОбработатьСсылки(Текст, Копирование, Выгрузка = Ложь)
	
	Если Копирование Или ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	
	ТипыОбъектов = Новый Массив;
	ТипыОбъектов.Добавить("ПланСчетов.ЕПСБУ");
	ТипыОбъектов.Добавить("Справочник.ЗначенияРеквизитовСведенийОбИмуществе,Код,Родитель.Код");
	ТипыОбъектов.Добавить("Справочник.ОбщероссийскийКлассификаторОсновныхФондов");
	
	Возврат ПоменятьМестамиСсылкуИКод(Текст, ТипыОбъектов, Выгрузка);
	
КонецФункции

Функция ПоменятьМестамиСсылкуИКод(Знач Текст, ТипыОбъектов, СсылкуНаКод = Ложь) Экспорт
	
	Для Каждого СтруктураПоля Из ТипыОбъектов Цикл
		
		Результат = "";
		
		ДанныеПоля = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтруктураПоля);
		ТипИмяОбъекта = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ДанныеПоля[0], "|");
		ТипОбъекта = ТипИмяОбъекта[0];
		ИмяОбъекта = Сред(ТипОбъекта, Найти(ТипОбъекта, ".") + 1);
		СинонимОбъекта = ?(ТипИмяОбъекта.Количество() > 1, ТипИмяОбъекта[1], ИмяОбъекта);
		
		ДанныеПоля.Удалить(0);
		
		Если ДанныеПоля.Количество() = 0 Тогда
			ДанныеПоля.Добавить("Код");	
		КонецЕсли;
		
		ПолеПоиска = "Ref." + ?(СсылкуНаКод, ИмяОбъекта, СинонимОбъекта) + """>";
		ПолеЗамены = "Ref." + ?(СсылкуНаКод, СинонимОбъекта, ИмяОбъекта) + """>";
		
		Пока Найти(Текст, ПолеПоиска) > 0 Цикл
			
			НачалоЗаменяемого	= Найти(Текст, ПолеПоиска);		
			ДлинаЗаменяемого	= Найти(Сред(Текст, НачалоЗаменяемого),"</") - 1;
			
			ЧтоЗаменяем = Сред(Текст, НачалоЗаменяемого + СтрДлина(ПолеПоиска), ДлинаЗаменяемого - СтрДлина(ПолеПоиска));
			НаЧтоЗаменяем = ?(СсылкуНаКод, ПолучитьКодПоСтруктуреПоля(ТипОбъекта, ДанныеПоля, ЧтоЗаменяем), ПолучитьСсылкуПоСтруктуреПоля(ТипОбъекта, ДанныеПоля, ЧтоЗаменяем));
			
			Результат = Результат + Сред(Текст, 1, НачалоЗаменяемого - 1) + ПолеЗамены + НаЧтоЗаменяем; 
			Текст = Сред(Текст, НачалоЗаменяемого + ДлинаЗаменяемого); 		
			
		КонецЦикла;
		
		Текст = Результат + Текст;
		
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

Функция ПолучитьСсылкуПоСтруктуреПоля(ТипОбъекта, ДанныеПоля, ЧтоЗаменяем)
	
	ПустаяСсылка = "00000000-0000-0000-0000-000000000000";
	
	Если ЧтоЗаменяем = "" Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;
	
	ДанныеПоиска = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ЧтоЗаменяем);
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Таблица.Ссылка КАК Ссылка
	|ИЗ
	|	" + ТипОбъекта + " КАК Таблица
	|ГДЕ
	|	[Условие]";
	
	Условие = "";
	
	Для НомерПоля = 0 По ДанныеПоля.Количество() - 1 Цикл
		
		Условие = Условие + "
			| "  + ?(Условие = "", "", "И ") + "ЕстьNULL(" + СокрЛП(ДанныеПоля[НомерПоля]) + ","""") = &П" + НомерПоля;
			Запрос.УстановитьПараметр("П" + НомерПоля, ДанныеПоиска[НомерПоля]); 
		
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "[Условие]", Условие);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Строка(Выборка.Ссылка.УникальныйИдентификатор());
	Иначе
		Возврат ПустаяСсылка;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьКодПоСтруктуреПоля(ТипОбъекта, ДанныеПоля, ЧтоЗаменяем)
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	[ДопПоля] КАК Код
	|ИЗ
	|	" + ТипОбъекта + " КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ТипОбъекта).ПолучитьСсылку(Новый УникальныйИдентификатор(ЧтоЗаменяем)));
	
	ДопПоля = "";
	
	Для НомерПоля = 0 По ДанныеПоля.Количество() - 1 Цикл
		
		ДопПоля = ДопПоля + ?(ДопПоля = "", "", " + "","" + ") + "ЕстьNULL(" + СокрЛП(ДанныеПоля[НомерПоля]) + ", """")";
		
	КонецЦикла;
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "[ДопПоля]", ДопПоля);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Код;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции


