Функция ФункцияИмяТаблицыРеквизиты(Реквизит)
	
	Таблицы = Новый Массив;
	
	ТекРеквизит = Реквизит.Родитель;
	
	Пока ЗначениеЗаполнено(ТекРеквизит) Цикл
		Если ТекРеквизит.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.Таблица Тогда
			//Таблицы.Вставить(Таблицы.Количество(), ТекРеквизит.ИмяДляФормулы);
			Таблицы.Вставить(0, ТекРеквизит.ИмяДляФормулы);
		КонецЕсли;
		ТекРеквизит = ТекРеквизит.Родитель;
	КонецЦикла;
	
	Если Реквизит.ЭтоСписокЗначений Тогда
		Таблицы.Добавить(Реквизит.ИмяДляФормулы);
	КонецЕсли;
	
	Возврат Таблицы;
	
КонецФункции


