Процедура ЗагрузитьЗначенияРеквизитов(Форма)
	
	СпискиЗначений = Новый Массив;
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеВвода);
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеНадписи);
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СпискиЗначений", СпискиЗначений);
	Запрос.УстановитьПараметр("Адрес", Перечисления.ВидыРеквизитовСведенийОбИмуществе.Адрес);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДокумента.ИдентификаторСтрокиТабличнойЧасти,
	|	ДанныеДокумента.РеквизитСведений,
	|	ДанныеДокумента.Значение
	|ПОМЕСТИТЬ ДанныеДокумента
	|ИЗ
	|	&ДанныеДокумента КАК ДанныеДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеквизитыСведенийОбИмуществе.Ссылка,
	|	РеквизитыСведенийОбИмуществе.Родитель,
	|	ВЫБОР
	|		КОГДА РеквизитыСведенийОбИмуществе.ВидРеквизита = &Адрес
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоАдрес,
	|	ВЫБОР
	|		КОГДА РеквизитыСведенийОбИмуществе.ВидРеквизита В (&СпискиЗначений)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоСписокЗначений
	|ПОМЕСТИТЬ РеквизитыВладельца
	|ИЗ
	|	Справочник.РеквизитыСведенийОбИмуществе КАК РеквизитыСведенийОбИмуществе
	|ГДЕ
	|	НЕ РеквизитыСведенийОбИмуществе.ЭтоГруппа
	|	И НЕ РеквизитыСведенийОбИмуществе.ПометкаУдаления
	|	И РеквизитыСведенийОбИмуществе.Владелец = &Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеквизитыВладельца.Родитель КАК Родитель,
	|	ВЫБОР
	|		КОГДА РеквизитыВладельца.ЭтоСписокЗначений
	|			ТОГДА ""Значение""
	|		ИНАЧЕ РеквизитыВладельца.Ссылка.ИмяДляФормулы
	|	КОНЕЦ КАК ИмяРеквизита,
	|	РеквизитыВладельца.Ссылка.ИмяДляФормулы КАК ИмяДляФормулы,
	|	РеквизитыВладельца.ЭтоАдрес КАК ЭтоАдрес,
	|	РеквизитыВладельца.ЭтоСписокЗначений,
	|	ДанныеДокумента.Значение,
	|	ДанныеДокумента.ИдентификаторСтрокиТабличнойЧасти КАК НомерСтроки
	|ИЗ
	|	ДанныеДокумента КАК ДанныеДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РеквизитыВладельца КАК РеквизитыВладельца
	|		ПО ДанныеДокумента.РеквизитСведений = РеквизитыВладельца.Ссылка";
	
	Запрос.УстановитьПараметр("Владелец", Форма.СлужебноеПоле_ВладелецЭлементов);
	Запрос.УстановитьПараметр("ДанныеДокумента", Форма.Объект.ЗначенияРеквизитов.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Таблицы = ФункцияИмяТаблицыРеквизиты(Выборка);
		Источник = ПолучитьИсточник(Форма, Таблицы, Выборка.НомерСтроки);
		
		Источник[Выборка.ИмяРеквизита] = Выборка.Значение;
		
		Если Выборка.ЭтоАдрес Тогда
			Источник[Выборка.ИмяРеквизита + "_ПредставлениеАдреса"] = ПредставлениеАдреса(Выборка.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеАдреса(Значение) Экспорт
	
	АдресJSON = РаботаСАдресами.КонтактнаяИнформацияВСтруктуруJSON(Значение, Перечисления.ТипыКонтактнойИнформации.Адрес);
	
	Возврат АдресJSON.Value;
	
КонецФункции

Функция ПолучитьИсточник(Форма, Таблицы, НомерСтроки)
	
	Источник = Форма;
	
	Номера = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(НомерСтроки, "/");
	Глубина = Таблицы.Количество() - 1;
	
	Для Сч = 0 По Глубина Цикл
		Табл = Источник[Таблицы[Сч]];
		НомСтр = Число(Номера[Сч]);
		Пока Табл.Количество() < НомСтр Цикл
			Табл.Добавить();
		КонецЦикла;
		Источник = Табл[НомСтр - 1];
	КонецЦикла;
	
	Возврат Источник;
	
КонецФункции

