// Избавиться от этой функции
Функция ПолучитьСостояниеКарты(Отбор) Экспорт 
	
	Результат = Новый Структура("Период,Организация,ОбъектУчета,ВидКарты,Статус,Документ,Идентификатор,ИдентификаторЗапроса",
								'00010101',
								Справочники.Организации.ПустаяСсылка(),
								Неопределено,
								Справочники.ВидыКартСведенийОбИмуществе.ПустаяСсылка(),
								Справочники.СтатусыКартРеестраИмущества.ПустаяСсылка(),
								Документы.РегистрацияСведенийОбИмуществе.ПустаяСсылка(),
								"",
								"");
	
	// Если передана пустая структура, возвращаем пустой ключ регистра
	Если Отбор.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ *
	|ИЗ
	|	РегистрСведений.СостояниеКартРеестраИмущества.СрезПоследних(%1, %2) КАК Состояние";
	
	Условия = Новый Массив;
	СтрокаПериод = ""; 
	Для Каждого КлючОтбора Из Отбор Цикл
		Если КлючОтбора.Ключ = "Срез" Тогда
			СтрокаПериод = "&Срез";
			Запрос.УстановитьПараметр("Срез", КлючОтбора.Значение);
		Иначе
			Условия.Добавить(КлючОтбора.Ключ + "=" + "&" + КлючОтбора.Ключ);
			Запрос.УстановитьПараметр(КлючОтбора.Ключ, КлючОтбора.Значение);
		КонецЕсли;
	КонецЦикла;
	
	// Любой отбор без документа выполняется только с учетом проведенных документов
	Если Не Отбор.Свойство("Документ") Тогда
		Условия.Добавить("Документ.Проведен");
	КонецЕсли;
	
	СтрокаУсловия = СтрСоединить(Условия, " И ");
	
	Запрос.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапроса, СтрокаПериод, СтрокаУсловия);         
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаЗначенийВСписокЗначений(Таблица) Экспорт
	
	СписокЗначений = Новый СписокЗначений;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СписокЗначений.Добавить(СтрокаТаблицы.Значение, СтрокаТаблицы.Представление);
	КонецЦикла;
	
	Возврат СписокЗначений;
	
КонецФункции

Функция ПолучитьФормулуВычисляемогоПараметра(Значение) Экспорт
	
	Результат = "";
	ОписаниеОшибки = "";
	
	БухгалтерскиеОперацииСервер.ОбработатьФормулуРеквизитаПроводки(Значение, Результат,
		"", Новый Массив, "", "", ОписаниеОшибки, Ложь, Новый Массив, Новый Массив);
	
	Если ОписаниеОшибки <> "" Тогда
		ОписаниеОшибки = Сред(ОписаниеОшибки, Найти(ОписаниеОшибки, ":") + 1);
		ОписаниеОшибки = Сред(ОписаниеОшибки, Найти(ОписаниеОшибки, ":") + 1);
		ВызватьИсключение СокрЛП(ОписаниеОшибки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеРеквизитаФормы(Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("ДанныеФормыКоллекция") Тогда
		
		Табл = Значение.Выгрузить();
		Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(Табл);
		
	Иначе
		Возврат Значение;
	КонецЕсли;
	
КонецФункции

Функция НевыводимыйРеквизит(Поле) Экспорт
	
	РазложениеИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка(Поле), ".");
	ПоследнееПоле = ВРЕГ(РазложениеИмени[РазложениеИмени.ВГраница()]);
	
	Возврат ПоследнееПоле = "ВЕРСИЯДАННЫХ"
			ИЛИ ПоследнееПоле = "СИСТЕМНЫЕПОЛЯ"
			ИЛИ ПоследнееПоле = "ССЫЛКА"
			ИЛИ ПоследнееПоле = "ИМЯПРЕДОПРЕДЕЛЕННЫХДАННЫХ"
			ИЛИ ПоследнееПоле = "ПРЕДОПРЕДЕЛЕННЫЙ"
			ИЛИ ПоследнееПоле = "ПОМЕТКАУДАЛЕНИЯ"
			ИЛИ ПоследнееПоле = "ПРОВЕДЕН"
			ИЛИ Найти(Строка(Поле), "[") > 0;
	
КонецФункции

Процедура УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры) Экспорт
	
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);
	
	Если Не Параметры.Свойство("ПредустановленныйОтборЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ПредустановленныйОтборЗначений = Параметры.ПредустановленныйОтборЗначений;
	
	Если ТипЗнч(ПредустановленныйОтборЗначений) = Тип("Строка") Тогда
		ТаблицаНастроек = ОбщегоНазначения.ЗначениеИзСтрокиXML(ПредустановленныйОтборЗначений);
	Иначе
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементНастройки Из ТаблицаНастроек Цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ОсновнаяТаблица.Значение КАК Значение 
		|ИЗ
		|	РегистрСведений.СвязиЗначенийРеквизитовСведенийОбИмуществе КАК ОсновнаяТаблица";
		
		РеестрИмуществаСервер.СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, ЭлементНастройки.УсловиеСвязи);
		//Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОсновнаяТаблица.Связи.", "ТаблицаСвязей."); // Нужна эта строка?
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		СписокЗначений = Новый СписокЗначений;
		
		Пока Выборка.Следующий() Цикл
			СписокЗначений.Добавить(Выборка.Значение);
		КонецЦикла;
		
		Если СписокЗначений.Количество() = 0 Тогда
			СписокЗначений.Добавить();
		КонецЕсли;
		
		ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(Список.Отбор,
			ЭлементНастройки.Реквизит,
			?(СписокЗначений.Количество() = 1, ВидСравненияКомпоновкиДанных.Равно, ВидСравненияКомпоновкиДанных.ВСписке),
			?(СписокЗначений.Количество() = 1, СписокЗначений[0].Значение, СписокЗначений));
		
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в запрос условие из отбора компоновки данных
//
// Параметры:
//  Запрос - Запрос - запрос, в который будет добавлено условие и помещены параметры.
//  Отбор  - НастройкиКомпоновкиДанных - настройки, содержащие отбор компоновки данных.
//         - Строка - сериализованное значение настроек компоновки данных.
//  НомерПараметра - Число - порядковый номер параметра. Является счетчиком. Необходим,
//                          когда в один запрос добавляется условие из нескольких отборов
//                          комопновки данных, чтобы параметры не пересекались.
//  Префикс - Строка - "ГДЕ|И|ИЛИ|<Пустая строка>". Префикс, который будет добавлен перед условием.
//  ТолькоПараметры - Булево - если Истина, тогда условие не добавляется в запрос.
//
// Возвращаемое значение:
//  Строка - текст условия
//
// Примеры использования:
//  1. В исходном запросе нет условий
//  	СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, Отбор); 
//  2. В исходном запросе уже есть условие
//      СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, Отбор, "И|ИЛИ");
//  3. Нужно получить текст условия, но не добавлять его в запрос
//      Условие = СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, Отбор, "",, Истина);
// 4. В исходном запросе уже есть условие. В запрос добавляется условие из нескольких отборов конъюнкцией 
//      СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, Отбор, "И", НомерПараметра);
//
Функция СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, Отбор, Префикс = "ГДЕ", НомерПараметра = 1, ТолькоПараметры = Ложь) Экспорт
	
	Если ТипЗнч(Отбор) = Тип("Строка") Тогда
		
		Если ПустаяСтрока(Отбор) Тогда		
			Возврат "";
		КонецЕсли;
		
		НастройкиОтбора = ОбщегоНазначения.ЗначениеИзСтрокиXML(Отбор);
		
	Иначе		
		НастройкиОтбора = Отбор;
	КонецЕсли;
	
	Условие = "";
	ОбщегоНазначенияБГУ.СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, Условие, НастройкиОтбора.Отбор.Элементы, Истина, НомерПараметра, "И");
	
	Если Условие = "" Тогда
		Возврат "";
	КонецЕсли;
	
	Условие = " " + Префикс + " (" + Условие + ")";
	
	Если Не ТолькоПараметры Тогда
		Запрос.Текст = Запрос.Текст + Условие;
	КонецЕсли;
	
	Возврат Условие;
	
КонецФункции

#КонецОбласти


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПолучитьАдресМакетаКомпоновкиФормулы(Форма, ПредставлениеМакетаКомпоновки)
	
	Если ПустаяСтрока(ПредставлениеМакетаКомпоновки) Тогда
		Возврат "";
	Иначе
		МакетКомпоновки = ОбщегоНазначения.ЗначениеИзСтрокиXML(ПредставлениеМакетаКомпоновки);
		Возврат ПоместитьВоВременноеХранилище(МакетКомпоновки, Форма.УникальныйИдентификатор);
	КонецЕсли;
	
КонецФункции

Процедура УстановитьСвойстваЭлементовФормы(Форма)
	
	Результат = ПолучитьРезультатВычисленияФормул(Форма, "СвойстваЭлементов");
	ПрефиксЭлементов = РеестрИмуществаКлиентСервер.ПрефиксЭлементовФормы();
	
	Для Каждого Реквизит Из Результат Цикл
		
		Поз = Найти(Реквизит.Ключ, "_");
		СвойствоЭлемента = Сред(Реквизит.Ключ, 1, Поз - 1);
		ИмяЭлемента = Сред(Реквизит.Ключ, Поз + 1);
		
		Элемент = Форма.Элементы[ПрефиксЭлементов + ИмяЭлемента];
		
		Если СвойствоЭлемента = "Обязательность" Тогда
			Элемент.ОтметкаНезаполненного = Реквизит.Значение;
			Элемент.АвтоОтметкаНезаполненного = Реквизит.Значение;
		ИначеЕсли СвойствоЭлемента = "Недоступность" Тогда
			Элемент.ТолькоПросмотр = Реквизит.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОписаниеТипаПоОпианиюТипов(ИсходныеОписанияТипа)
	
	Типы = Новый Массив;
	
	Для Каждого Описание Из ИсходныеОписанияТипа Цикл
		Для Каждого ТипОписания Из Описание.Типы() Цикл
			Если Типы.Найти(ТипОписания) = Неопределено Тогда
				Типы.Добавить(ТипОписания);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Новый ОписаниеТипов(Типы);
	
КонецФункции

Процедура ВыполнитьОчисткуСервер(Таблица, ТекущаяСтрока)
	
	Для Каждого Реквизит Из Таблица.Колонки Цикл
		Если Реквизит.ТипЗначения.СодержитТип(Тип("ТаблицаЗначений")) Тогда
			Для Каждого СтрокаТаблицы Из ТекущаяСтрока[Реквизит.Имя] Цикл
				ВыполнитьОчисткуСервер(Таблица[0][Реквизит.Имя], СтрокаТаблицы);
			КонецЦикла;
		ИначеЕсли Реквизит.Имя = "ГУИД" Тогда
			ТекущаяСтрока[Реквизит.Имя] = "";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьРеквизит(СтрокаТаблицы, Источник, ИмяРеквизита, Знач ИмяКолонки = "")
	
	Если ИмяКолонки = "" Тогда
		ИмяКолонки = ИмяРеквизита;
	КонецЕсли;
	
	СтрокаТаблицы.Владелец().Колонки.Добавить(ИмяКолонки);
	Значение = Источник[ИмяРеквизита];
	
	СтрокаТаблицы[ИмяКолонки] = ?(ТипЗнч(Значение) = Тип("ДанныеФормыКоллекция") Или ТипЗнч(Значение) = Тип("СписокЗначений"), Значение.Количество(), Значение);
	
КонецПроцедуры

Функция ПолучитьРезультатВычисленияФормул(Форма, ИмяПоляФункции)
	
	Таблица = Новый ТаблицаЗначений;
	СтрокаТаблицы = Таблица.Добавить();
	
	РеквизитыОбъекта = РеестрИмуществаПовтИсп.ПолучитьРеквизитыОбъекта(Форма.СлужебноеПоле_ВладелецЭлементов);
	Для Каждого Реквизит Из РеквизитыОбъекта Цикл
		ДобавитьРеквизит(СтрокаТаблицы, Форма[Реквизит.Источник], Реквизит.ИмяРеквизита, Реквизит.Поле);
	КонецЦикла;
	
	Для Каждого Реквизит Из Форма.СлужебноеПоле_ДобавленныеРеквизитыФормы Цикл
		ДобавитьРеквизит(СтрокаТаблицы, Форма, Реквизит.Значение, "Реквизиты_" + Реквизит.Значение);
	КонецЦикла;
	
	ВнешниеНаборыДанных = Новый Структура("ДанныеДокумента", Таблица);
	
	МакетКомпоновки = ПолучитьИзВременногоХранилища(Форма["СлужебноеПоле_АдресМакетаКомпоновки" + ИмяПоляФункции]);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных,, Истина); 
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Результат[0]);
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Обработка данных при обмене (служебные)

Процедура ДобавитьВТаблицуКолонкиВидаКарты(Таблица, МассивСсылок, Префикс = "") Экспорт
	
	Владельцы = Новый Массив;
	Для Каждого Элемент Из МассивСсылок Цикл
		Владелец = ?(ТипЗнч(Элемент) = Тип("ДокументСсылка.РегистрацияСведенийОбИмуществе"), Элемент.ОбъектУчетаИмущества.ВидКарты, Элемент.Владелец);
		Владельцы.Добавить(Владелец);
	КонецЦикла;
	
	СпискиЗначений = Новый Массив;
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеВвода);
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеНадписи);
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Префикс", Префикс);
	Запрос.УстановитьПараметр("СпискиЗначений", СпискиЗначений);
	Запрос.УстановитьПараметр("Надпись", Перечисления.ВидыРеквизитовСведенийОбИмуществе.ДекорацияНадпись);
	Запрос.УстановитьПараметр("Владельцы", Владельцы);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыСведенийОбИмуществе.ИмяДляФормулы,
	|	РеквизитыСведенийОбИмуществе.ВидРеквизита,
	|	РеквизитыСведенийОбИмуществе.ТипРеквизита.ТипЗначения КАК ТипЗначения
	|ПОМЕСТИТЬ Реквизиты
	|ИЗ
	|	Справочник.РеквизитыСведенийОбИмуществе КАК РеквизитыСведенийОбИмуществе
	|ГДЕ
	|	НЕ РеквизитыСведенийОбИмуществе.ПометкаУдаления
	|	И НЕ РеквизитыСведенийОбИмуществе.ЭтоГруппа
	|	И РеквизитыСведенийОбИмуществе.ВидРеквизита <> &Надпись"
	+ ?(Владельцы.Количество() = 0, "", "
	|	И (РеквизитыСведенийОбИмуществе.Владелец В (&Владельцы)
	|			ИЛИ РеквизитыСведенийОбИмуществе.Владелец ССЫЛКА Справочник.ВидыОбъектовРеестраИмущества)") + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Префикс + ВЫБОР
	|		КОГДА Реквизиты.ВидРеквизита В (&СпискиЗначений)
	|			ТОГДА ""Значение""
	|		ИНАЧЕ Реквизиты.ИмяДляФормулы
	|	КОНЕЦ КАК Имя,
	|	Реквизиты.ТипЗначения КАК Тип
	|ИЗ
	|	Реквизиты КАК Реквизиты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Ссылка"",
	|	Реквизиты.ТипЗначения
	|ИЗ
	|	Реквизиты КАК Реквизиты
	|ГДЕ
	|	Реквизиты.ВидРеквизита В (&СпискиЗначений)
	|ИТОГИ ПО
	|	Имя";
	
	Колонки = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	// Создание колонок таблицы
	Для Каждого Колонка Из Колонки.Строки Цикл
		ОписаниеТипаКолонки = ОписаниеТипаПоОпианиюТипов(Колонка.Строки.ВыгрузитьКолонку("Тип"));
		Таблица.Колонки.Добавить(Колонка.Имя, ОписаниеТипаКолонки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьВТаблицуСведения(Таблица, СсылкаОбъекта, СсылкаДокумента, Параметры, ИмяТЧ, Печать = Ложь, ИмяТабЧастиРодитель = "", НомерСтрокиРодитель = "") Экспорт
	
	СпискиЗначений = Новый Массив;
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеВвода);
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеНадписи);
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица);	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СсылкаОбъекта",	СсылкаОбъекта);
	Запрос.УстановитьПараметр("Префикс",		Параметры.Префикс); 
	Запрос.УстановитьПараметр("СпискиЗначений",	СпискиЗначений);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&Префикс + ВЫБОР
	|		КОГДА Реквизиты.РеквизитСведений.ВидРеквизита В (&СпискиЗначений)
	|			ТОГДА ""Значение""
	|		ИНАЧЕ Реквизиты.РеквизитСведений.ИмяДляФормулы
	|	КОНЕЦ КАК ИмяКолонки,
	|	Реквизиты.Значение,
	|	Реквизиты.ИдентификаторСтрокиТабличнойЧасти КАК НомерСтроки,
	|	Реквизиты.РеквизитСведений.Ссылка КАК Реквизит,
	|	ВЫБОР
	|		КОГДА Реквизиты.РеквизитСведений.ВидРеквизита В (&СпискиЗначений)
	|			ТОГДА Реквизиты.РеквизитСведений.ИмяДляФормулы
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК СписокЗначений,
	|	ВЫБОР
	|		КОГДА Реквизиты.Значение ССЫЛКА Справочник.ОбъектыРеестраИмущества
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоОбъект
	|ИЗ
	|	Документ.РегистрацияСведенийОбИмуществе.ЗначенияРеквизитов КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка = &СсылкаОбъекта";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.РегистрацияСведенийОбИмуществе", ОбщегоНазначенияБГУ.ВернутьСтрокуТипаПоТипу(ТипЗнч(СсылкаОбъекта), "Запрос"));
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЭтоОбъект = ТипЗнч(СсылкаОбъекта) = Тип("СправочникСсылка.ОбъектыРеестраИмущества");
	
	Пока Выборка.Следующий() Цикл
		
		СлужебныеПоля = ПолучитьЗначенияСлужебныхПолей(Выборка, СсылкаДокумента, ИмяТЧ, Печать, ИмяТабЧастиРодитель, НомерСтрокиРодитель);
		СтрокиТаблицы = Таблица.НайтиСтроки(СлужебныеПоля);
		
		Если СтрокиТаблицы.Количество() = 0 Тогда
			СтрокаТаблицы = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СлужебныеПоля);
		Иначе
			СтрокаТаблицы = СтрокиТаблицы[0];
		КонецЕсли;
		
		Если Таблица.Колонки.Найти(Выборка.ИмяКолонки) <> Неопределено Тогда
			СтрокаТаблицы[Выборка.ИмяКолонки] = Выборка.Значение;
		КонецЕсли;
		
		Если ЭтоОбъект Тогда
			СтрокаТаблицы.Ссылка = СсылкаОбъекта;
		КонецЕсли;
		
		Если Выборка.ЭтоОбъект Тогда
			Если Печать Тогда
				ДобавитьВТаблицуСведения(Таблица, Выборка.Значение, СсылкаДокумента, Параметры, ИмяТЧ, Печать,
										СлужебныеПоля.СлужебноеПоле_Путь + "." + Выборка.ИмяКолонки,
										СлужебныеПоля.СлужебноеПоле_НомераСтрокПути + "." + Строка(СлужебныеПоля.СлужебноеПоле_НомерСтрокиПоля));
			Иначе
				ДобавитьВТаблицуСведения(Таблица, Выборка.Значение, СсылкаДокумента, Параметры, ИмяТЧ, Печать,
										СлужебныеПоля.ИмяТабЧасти + "__" + Выборка.ИмяКолонки,
										СлужебныеПоля.НомерСтроки_Гл + "__" + Строка(СлужебныеПоля.НомерСтроки));
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЗначенияСлужебныхПолей(Источник, СсылкаДокумента, ИмяТЧ, Печать, ИмяТабЧастиРодитель, НомерСтрокиРодитель, Префикс = "")
	
	Если Печать Тогда
		
		Результат = Новый Структура("Документ, СлужебноеПоле_Путь, СлужебноеПоле_НомераСтрокПути, СлужебноеПоле_НомерСтрокиПоля, НомерСтроки");
		
		Результат.Документ = СсылкаДокумента;
		
		ИмяТабЧасти = РеестрИмуществаКлиентСервер.ПолучитьПутьРеквизита(Источник.Реквизит);
		ИмяТабЧасти	= ИмяТабЧастиРодитель + ?(ИмяТабЧастиРодитель <> "" И ИмяТабЧасти <> "", ".", "") + ИмяТабЧасти;
		Если Не ПустаяСтрока(Источник.СписокЗначений) Тогда
			ИмяТабЧасти = ИмяТабЧасти + ?(ИмяТабЧасти = "", "", ".") + Источник.СписокЗначений;
		КонецЕсли;
		Результат.СлужебноеПоле_Путь = ВРег(ИмяТабЧасти);
		
		Если ПустаяСтрока(Источник.НомерСтроки) Тогда
			Результат.СлужебноеПоле_НомерСтрокиПоля = 1;
			Результат.СлужебноеПоле_НомераСтрокПути = НомерСтрокиРодитель;
		Иначе
			ПозРазд = СтрНайти(Источник.НомерСтроки, "/", НаправлениеПоиска.СКонца);
			НомерСтрокиСтрока = Сред(Источник.НомерСтроки, ПозРазд + 1);
			Результат.СлужебноеПоле_НомерСтрокиПоля = Число(НомерСтрокиСтрока);
			Результат.СлужебноеПоле_НомераСтрокПути =  НомерСтрокиРодитель + ?(НомерСтрокиРодитель = "", "", ".") + "1" + ?(ПозРазд = 0, "", "." + СтрЗаменить(Сред(Источник.НомерСтроки, 1, ПозРазд - 1), "/", "."));
		КонецЕсли;
		
		Результат.НомерСтроки = Результат.СлужебноеПоле_НомерСтрокиПоля;
		
	Иначе
		
		Результат = Новый Структура("СсылкаДокумента,ПолеСвязи,НомерСтроки,НомерСтроки_Гл,ИмяТабЧасти,ИмяТабЧасти_Гл");
		
		Результат.СсылкаДокумента = СсылкаДокумента;
		Результат.ПолеСвязи = Истина;
		
		Если ПустаяСтрока(Источник.НомерСтроки) Тогда
			Результат.НомерСтроки = 1;
			Результат.НомерСтроки_Гл = НомерСтрокиРодитель;
		Иначе
			ПозРазд = СтрНайти(Источник.НомерСтроки, "/", НаправлениеПоиска.СКонца);
			НомерСтрокиСтрока = Сред(Источник.НомерСтроки, ПозРазд + 1);
			Результат.НомерСтроки = Число(НомерСтрокиСтрока);
			Результат.НомерСтроки_Гл =  НомерСтрокиРодитель + "__1" + ?(ПозРазд = 0, "", "__" + СтрЗаменить(Сред(Источник.НомерСтроки, 1, ПозРазд - 1), "/", "__"));
		КонецЕсли;
		
		ИмяТабЧасти = РеестрИмуществаКлиентСервер.ПолучитьПутьРеквизита(Источник.Реквизит);
		ИмяТабЧасти = СтрЗаменить(ИмяТабЧасти, ".", "__");
		ИмяТабЧасти	= ИмяТабЧастиРодитель + ?(ИмяТабЧастиРодитель <> "" И ИмяТабЧасти <> "", "__", "") + ИмяТабЧасти;
		Если Не ПустаяСтрока(Источник.СписокЗначений) Тогда
			ИмяТабЧасти = ИмяТабЧасти + ?(ИмяТабЧасти = "", "", "__") + Источник.СписокЗначений;
		КонецЕсли;
		Результат.ИмяТабЧасти = ВРег(?(ИмяТабЧасти = "", ИмяТЧ, ИмяТабЧасти));
		
		Поз = СтрНайти(ИмяТабЧасти, "__", НаправлениеПоиска.СКонца);
		ИмяТабЧасти = ?(Поз = 0, ?(ИмяТабЧасти = "", "", ИмяТЧ), Сред(ИмяТабЧасти, 1, Поз - 1));
		Результат.ИмяТабЧасти_Гл = ВРег(ИмяТабЧасти);		
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

