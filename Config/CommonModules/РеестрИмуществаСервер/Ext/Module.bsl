Процедура СформироватьЗаданиеНаИмпорт(ОбъектОбмена = Неопределено, Задание, Файл) Экспорт
	
	//СоответствиеФорматовИмпортаЭкспорта = Новый Соответствие;
	//СоответствиеФорматовИмпортаЭкспорта.Вставить("GetCard", "GetCardResponse");
	////СоответствиеФорматовИмпортаЭкспорта.Вставить("GetCard", ?(ОбъектОбмена.Объект.ВидКарты.Раздел = "ShareOfRight", "GetCardShareOfRightResponse","GetCardResponse"));
	//СоответствиеФорматовИмпортаЭкспорта.Вставить("GetAllDictionaries", "GetAllDictionariesResponse");
	////СоответствиеФорматовИмпортаЭкспорта.Вставить("GetCardStates", "GetCardStatesResponse");
	//
	//ИмяФорматаИмпорта = СоответствиеФорматовИмпортаЭкспорта.Получить(ОбъектОбмена.Формат.Наименование);	
	//Если ИмяФорматаИмпорта = Неопределено Тогда	
	//	ИмяФорматаИмпорта = "GetCardStatesResponse"; // Формат по умолчанию
	//КонецЕсли;
	//
	//// Альтернативный вариант:
	////ИмяФорматаИмпорта = ОбъектОбмена.Формат.Наименование + "Response";
	
	ЧтениеТекста = Новый ЧтениеТекста(Файл.ПолноеИмя);
	СодержаниеФайла = ЧтениеТекста.Прочитать();
	
	Если ПустаяСтрока(СодержаниеФайла) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФорматаИмпорта = "";
	Если Задание.ДополнительныеСвойства.Свойство("ИмяФорматаИмпорта", ИмяФорматаИмпорта) Тогда
		//
	ИначеЕсли Найти(СодержаниеФайла, "IRightholderService/GetShareOfRightFromRegisterResponse") > 0 Тогда
		ИмяФорматаИмпорта = "GetCardShareOfRightResponse";
	ИначеЕсли Найти(СодержаниеФайла, "IRightholderService/GetCardStatesResponse") > 0 Тогда
		//ИмяФорматаИмпорта = "GetCardStatesResponse";
		//Если ОбъектОбмена.Формат.Наименование = "GetCardStates" Тогда 
		ИмяФорматаИмпорта = "GetCardStatesResponse";
		//Иначе
		//	ИмяФорматаИмпорта = "DownloadCardResponse";
		//КонецЕсли;
	ИначеЕсли Найти(СодержаниеФайла, "IRightholderService/GetAllDictionariesResponse") > 0 Тогда
		ИмяФорматаИмпорта = "GetAllDictionariesResponse";
	ИначеЕсли Найти(СодержаниеФайла, "IRightholderService/Get") > 0 Тогда
		ИмяФорматаИмпорта = "GetCardResponse";
	ИначеЕсли Найти(СодержаниеФайла, "AddImageToDocumentResponse") > 0 Тогда
		Возврат;
	ИначеЕсли Найти(СодержаниеФайла, ":Fault>") = 0 Тогда
		ИмяФорматаИмпорта = "GetCardStatesResponse"; // Формат по умолчанию
	Иначе
		Возврат;
	КонецЕсли;
	
	ФорматОбмена = Справочники.ФорматыОбменаБанкиКС.НайтиПоНаименованию(ИмяФорматаИмпорта,,,Задание.ВидОбмена);
	Если ФорматОбмена.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	НовСтр = Задание.ФайлыОбмена.Добавить();
	НовСтр.Формат = ФорматОбмена;
	НовСтр.ТипОбъекта = "Структура";
	НовСтр.Загрузить = Истина;
	НовСтр.ИмяФайлаЗагрузки = Файл.Имя;
	НовСтр.ПолноеИмяФайла   = Файл.ПолноеИмя;
	
	ДвоичныеДанные 					= Новый ДвоичныеДанные(Файл.ПолноеИмя);
	АдресФайлаВоВременномХранилище 	= ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	РаботаСФайлами.ДобавитьФайл(
		Новый Структура("ВладелецФайлов, ИмяБезРасширения, РасширениеБезТочки, Автор, ВремяИзмененияУниверсальное",
		Задание.Ссылка,
		Лев(Файл.Имя, Найти(Файл.Имя, ".") - 1),
		Сред(Файл.Имя, Найти(Файл.Имя, ".") + 1),
		ПользователиКлиентСервер.ТекущийПользователь(),
		УниверсальноеВремя(ТекущаяДатаСеанса())),
		АдресФайлаВоВременномХранилище);
	
КонецПроцедуры

Процедура ОбработатьДанныеИмпорта(Задание, Формат, РезультатВыполнения) Экспорт
	
	Если Формат.Наименование = "DownloadCardResponse" Тогда
		ЗагрузитьСостояниеКарт(Задание.Организация, РезультатВыполнения, Задание, Истина);
	ИначеЕсли Формат.Наименование = "GetAllDictionariesResponse" Тогда
		ЗагрузитьСправочники(Задание.Организация, РезультатВыполнения);
	ИначеЕсли Формат.Наименование = "GetCardResponse" Или Формат.Наименование = "GetCardShareOfRightResponse" Тогда	
		ЗагрузитьКарту(Задание.Организация, РезультатВыполнения, Задание);
	ИначеЕсли Формат.Наименование = "GetCardStatesResponse" Тогда
		ЗагрузитьСостояниеКарт(Задание.Организация, РезультатВыполнения, Задание);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьСправочники(Организация, Данные)
	
	мСправочник = Метаданные.Справочники.ЗначенияРеквизитовСведенийОбИмуществе;
	
	ЗначенияСправочников = Новый ТаблицаЗначений;
	ЗначенияСправочников.Колонки.Добавить("Код",			мСправочник.СтандартныеРеквизиты.Код.Тип);
	ЗначенияСправочников.Колонки.Добавить("Наименование",	мСправочник.Реквизиты.НаименованиеПолное.Тип);
	ЗначенияСправочников.Колонки.Добавить("КодСправочника",	мСправочник.СтандартныеРеквизиты.Код.Тип);
	ЗначенияСправочников.Колонки.Добавить("ЭтоСправочник",	мСправочник.СтандартныеРеквизиты.ЭтоГруппа.Тип);
	ЗначенияСправочников.Колонки.Добавить("НеИспользуется",	мСправочник.Реквизиты.НеИспользуется.Тип);
	
	Связи = Новый ТаблицаЗначений;
	Связи.Колонки.Добавить("Код",					мСправочник.СтандартныеРеквизиты.Код.Тип);
	Связи.Колонки.Добавить("КодСправочника",		мСправочник.СтандартныеРеквизиты.Код.Тип);
	Связи.Колонки.Добавить("Раздел",				Метаданные.РегистрыСведений.СвязиЗначенийРеквизитовСведенийОбИмуществе.Измерения.Раздел.Тип);
	Связи.Колонки.Добавить("КоллекцияДокументов",	Метаданные.РегистрыСведений.СвязиЗначенийРеквизитовСведенийОбИмуществе.Измерения.КоллекцияДокументов.Тип);
	
	Для Каждого СтрокаДанных Из Данные Цикл
		
		НоваяСтрока = ЗначенияСправочников.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		НоваяСтрока.НеИспользуется = Не СтрокаДанных.Актуально;
		
		Если СтрокаДанных.ЭтоСправочник = Ложь Тогда
			НоваяСтрока = Связи.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		КонецЕсли;
		
	КонецЦикла;
	
	// Загрузка справочник значений
	
	ЗначенияСправочников.Свернуть("Код,Наименование,КодСправочника,ЭтоСправочник,НеИспользуется");
	Справочники.ЗначенияРеквизитовСведенийОбИмуществе.ЗагрузитьЗначенияРеквизитов(ЗначенияСправочников);
	
	// Загрузка связей
	
	Связи.Свернуть("Код,КодСправочника,Раздел,КоллекцияДокументов");
	РегистрыСведений.СвязиЗначенийРеквизитовСведенийОбИмуществе.ЗагрузитьЗначения(Связи);
	
КонецПроцедуры

Процедура ЗагрузитьКарту(Организация, Данные, Задание)
	перем АдресДанных;
	
	ДанныеКарты = СформироватьДанныеКарты(Организация, Данные);
	
	Если ДанныеКарты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Задание.ДополнительныеСвойства.Свойство("АдресДанных", АдресДанных) Тогда
		
		Таблица = ПолучитьИзВременногоХранилища(АдресДанных);
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), ДанныеКарты);
		ПоместитьВоВременноеХранилище(Таблица, АдресДанных);
		
	Иначе
		
		Если ЗначениеЗаполнено(ДанныеКарты.ОбъектУчетаИмущества) Тогда
			СоздатьКарту(Организация, ДанныеКарты);
		Иначе
			// Сообщить, что не удалось найти объект учета имущества, для которого выполнена загрузка данных
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьКарту(Организация, ДанныеКарты) Экспорт
	
	// Записываем сведения реестрового учета
	
	Запись = РегистрыСведений.СведенияРеестровогоУчетаИмущества.СоздатьМенеджерЗаписи();
	Запись.Организация = Организация;
	ЗаполнитьЗначенияСвойств(Запись, ДанныеКарты, "ОбъектУчетаИмущества,СистемныйНомер,НомерКарты,РеестровыйНомер,ДатаУчета");
	Запись.Записать();
	
	// Записываем статус
	
	СостояниеКарты = Новый Структура("Статус,ДатаСтатуса");
	ЗаполнитьЗначенияСвойств(СостояниеКарты, ДанныеКарты);
	
	Если ЗначениеЗаполнено(СостояниеКарты.Статус) И ЗначениеЗаполнено(СостояниеКарты.ДатаСтатуса) Тогда 
		Запись = РегистрыСведений.СостояниеОбъектовУчетаРеестраИмущества.СоздатьМенеджерЗаписи();
		Запись.Организация = Организация;
		Запись.ОбъектУчетаИмущества = ДанныеКарты.ОбъектУчетаИмущества;
		Запись.Статус = СостояниеКарты.Статус;
		Запись.Период = СостояниеКарты.ДатаСтатуса;
		//ЗаполнитьЗначенияСвойств(Запись, ДанныеКарты, "ОбъектУчетаИмущества,Статус,ДатаСтатуса");
		Запись.Записать();
	КонецЕсли;
	
	// Записываем сведения (карту)
	
	Документ = Документы.РегистрацияСведенийОбИмуществе.СоздатьДокумент();
	Документ.Заполнить(ДанныеКарты.ОбъектУчетаИмущества);
	Документ.ЗначенияРеквизитов.Загрузить(ДанныеКарты.ЗначенияРеквизитов);
	
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Документ.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗагрузитьСостояниеКарт(Организация, Данные, Задание = Неопределено, ПервоначальнаяЗагрузка = Ложь) Экспорт
	перем АдресДанных;
	
	Если Задание <> Неопределено И Задание.ДополнительныеСвойства.Свойство("АдресДанных", АдресДанных) Тогда
		
		Таблица = ПолучитьИзВременногоХранилища(АдресДанных);
		
		Если Таблица = Неопределено Тогда
			Таблица = Новый ТаблицаЗначений;
			Если ПервоначальнаяЗагрузка Тогда
				Таблица.Колонки.Добавить("Идентификатор");
				Таблица.Колонки.Добавить("ВидКарты");
				Таблица.Колонки.Добавить("Статус");
				Таблица.Колонки.Добавить("Период");
				Если Данные.Колонки.Найти("ПометкаУдаления") <> Неопределено Тогда
					Данные = Данные.НайтиСтроки(Новый Структура("ПометкаУдаления", Ложь));
				КонецЕсли;
			Иначе
				Таблица.Колонки.Добавить("Объект");
				Таблица.Колонки.Добавить("Период");
				Таблица.Колонки.Добавить("Статус");
				Таблица.Колонки.Добавить("ЭтоЗапрос");
				Таблица.Колонки.Добавить("Проводить");
				Таблица.Колонки.Добавить("Идентификатор");
			КонецЕсли;
		КонецЕсли;
		
		Для Каждого Строка Из Данные Цикл
			ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Строка);
		КонецЦикла;
		ПоместитьВоВременноеХранилище(Таблица, АдресДанных);
		
	Иначе
		
		ЗаписиКарты = Данные.Скопировать(Новый Структура("ЭтоЗапрос", Ложь), "Период,Объект,Статус");
		
		Если ЗаписиКарты.Количество() > 0 Тогда
			
			Для Каждого Запись Из ЗаписиКарты Цикл
				Если ЗначениеЗаполнено(Запись.Объект) Тогда
					НоваяЗапись = РегистрыСведений.СостояниеОбъектовУчетаРеестраИмущества.СоздатьМенеджерЗаписи();
					НоваяЗапись.Организация = Организация;
					НоваяЗапись.ОбъектУчетаИмущества = Запись.Объект;
					НоваяЗапись.Период = Запись.Период;
					НоваяЗапись.Статус  = Запись.Статус;
					НоваяЗапись.Записать();
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		ЗаписиЗапросы = Данные.Скопировать(Новый Структура("ЭтоЗапрос", Истина), "Объект,Статус,Идентификатор,Проводить");
		
		Если ЗаписиЗапросы.Количество() > 0 Тогда
			
			Для Каждого Запись Из ЗаписиЗапросы Цикл
				
				Если Не ЗначениеЗаполнено(Запись.Объект) Тогда
					Продолжить;
				КонецЕсли;
				
				Если Запись.Проводить Тогда
					НачатьТранзакцию();
				КонецЕсли;
				
				НоваяЗапись = РегистрыСведений.СостояниеКартРеестраИмущества.СоздатьМенеджерЗаписи();
				НоваяЗапись.Организация = Организация;
				НоваяЗапись.Карта = Запись.Объект;
				НоваяЗапись.Статус = Запись.Статус;
				НоваяЗапись.Идентификатор = Запись.Идентификатор;
				НоваяЗапись.Записать();
				
				Если Запись.Проводить Тогда
					Попытка
						Запись.Объект.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение);
						ЗафиксироватьТранзакцию();
					Исключение
						// Сообщить, не удалось сохранить статус
						ОтменитьТранзакцию();
					КонецПопытки;
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьДанныеКарты(Организация, Данные)
	
	ОсновныеДанные = Данные.Найти("", "СлужебноеПоле_ТабличнаяЧасть");
	
	Если ОсновныеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Формируем структуру карты, получаем данные об объекте учета
	
	Результат = Новый Структура;
	Результат.Вставить("ОбъектУчетаИмущества",			ОсновныеДанные.ОбъектУчетаИмущества);
	Результат.Вставить("Организация",					Организация);
	Результат.Вставить("ОбъектУчета",					ОсновныеДанные.ОбъектУчета);
	Результат.Вставить("ВидКарты",						ОсновныеДанные.ВидКарты);
	Результат.Вставить("Идентификатор",					ОсновныеДанные.Идентификатор);
	Результат.Вставить("НомерКарты",					ОсновныеДанные.НомерКарты);
	Результат.Вставить("РеестровыйНомер",				ОсновныеДанные.РеестровыйНомер);
	Результат.Вставить("ДатаУчета",						ОсновныеДанные.ДатаУчета);
	Результат.Вставить("СистемныйНомер",				ОсновныеДанные.СистемныйНомер);
	Результат.Вставить("ПредставлениеРеквизитовКарты",	ОсновныеДанные.ПредставлениеРеквизитовКарты);
	
	ЗначенияРеквизитов = Новый ТаблицаЗначений;
	ЗначенияРеквизитов.Колонки.Добавить("РеквизитСведений");
	ЗначенияРеквизитов.Колонки.Добавить("Значение");
	ЗначенияРеквизитов.Колонки.Добавить("ИдентификаторСтрокиТабличнойЧасти");
	
	Результат.Вставить("ЗначенияРеквизитов", ЗначенияРеквизитов);
	
	// Получаем значения реквизитов
	ВидКарты = ?(ЗначениеЗаполнено(Результат.ОбъектУчетаИмущества), Результат.ОбъектУчетаИмущества.ВидКарты, Результат.ВидКарты);
	ПрочитатьЗначенияРеквизитовОбъекта(Данные, ВидКарты, Результат.ЗначенияРеквизитов);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТабличнуюЧастьРеквизита(Знач Реквизит, ЭтоОбъект)
	
	Путь = ?(ЭтоОбъект И Реквизит.ВидРеквизита <> Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеВвода
		И Реквизит.ВидРеквизита <> Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица, Реквизит.ИмяДляФормулы, "");
	
	ТекЭлемент = Реквизит;
	
	Пока Не ТекЭлемент.Пустая() Цикл
		Если ТекЭлемент.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.Таблица
			Или ТекЭлемент.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеВвода
			Или ТекЭлемент.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица Тогда
			Путь = ТекЭлемент.ИмяДляФормулы + ?(Путь = "", "", ".") + Путь;
		КонецЕсли;
		ТекЭлемент = ТекЭлемент.Родитель;
	КонецЦикла;
	
	Возврат Путь;
	
КонецФункции

Функция ПрочитатьЗначениеАдреса(Данные, ИмяРеквизита)
	Перем Значение;
	
	Контекст = УправлениеКонтактнойИнформациейКлиентСервер.СтруктураКонтактнойИнформацииПоТипу(Перечисления.ТипыКонтактнойИнформации.Адрес);
	Контекст.Вставить("КодРегиона", "");
	ДанныеСтруктурой = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Данные);
	
	Для Каждого ЧастьАдреса Из Контекст Цикл
		ДанныеСтруктурой.Свойство(ИмяРеквизита + "_" + ЧастьАдреса.Ключ, Значение);
		Контекст[ЧастьАдреса.Ключ] = ?(ЗначениеЗаполнено(Значение), Значение, "");
	КонецЦикла;
	
	Если Контекст.Страна = "" И Контекст.КодСтраны <> "" Тогда
		ДанныеКлассификатора = РаботаСАдресами.ТаблицаКлассификатора();
		СтрокаДанных = ДанныеКлассификатора.Найти(ВРег(Контекст.КодСтраны), "КодАльфа2");
		Если СтрокаДанных <> Неопределено Тогда
			Контекст.Страна = СтрокаДанных.Наименование;
		КонецЕсли;
	КонецЕсли;
	
	Результат = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВXML(Контекст,, Перечисления.ТипыКонтактнойИнформации.Адрес);
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьОбъектРеестраИмущества(СтрокаОбъекта, ИмяРеквизита, ОтборЭлементов);
	
	ИмяКолонкиСсылки = "Ссылка";
	Если СтрокаОбъекта.Владелец().Колонки.Найти(ИмяКолонкиСсылки) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначениеСсылки = СтрокаОбъекта[ИмяКолонкиСсылки];
	Если Не ЗначениеЗаполнено(ЗначениеСсылки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОбъектСсылка = Справочники.ОбъектыРеестраИмущества.ПолучитьСсылку(Новый УникальныйИдентификатор(ЗначениеСсылки));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ОбъектСсылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбъектыРеестраИмущества.Ссылка
	|ИЗ
	|	Справочник.ОбъектыРеестраИмущества КАК ОбъектыРеестраИмущества
	|ГДЕ
	|	ОбъектыРеестраИмущества.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Элемент = Выборка.Ссылка.ПолучитьОбъект();
		Элемент.ЗначенияРеквизитов.Очистить();
	Иначе
		Настройки = ОбщегоНазначения.ЗначениеИзСтрокиXML(ОтборЭлементов);
		ВидОбъекта = ПолучитьЗначениеЭлементаОтбора(Настройки.Отбор, "Владелец");
		
		Если Не ЗначениеЗаполнено(ВидОбъекта) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Элемент = Справочники.ОбъектыРеестраИмущества.СоздатьЭлемент();
		Элемент.УстановитьСсылкуНового(ОбъектСсылка);
		Элемент.Владелец = ВидОбъекта;
		
	КонецЕсли;
	
	Данные = СтрокаОбъекта.Владелец().Скопировать(ОбщегоНазначенияБГУ.Массив(СтрокаОбъекта));
	
	ПрочитатьЗначенияРеквизитовОбъекта(Данные, Элемент.Владелец, Элемент.ЗначенияРеквизитов, СтрокаОбъекта.СлужебноеПоле_ТабличнаяЧасть);
	
	Элемент.Записать();
	Возврат Элемент.Ссылка;
	
КонецФункции

Процедура ПрочитатьЗначенияРеквизитовОбъекта(Данные, Владелец, ЗначенияРеквизитов, Путь = "")
	
	СпискиЗначений = Новый Массив;
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеВвода);
	СпискиЗначений.Добавить(Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("СпискиЗначений", СпискиЗначений);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыСведенийОбИмуществе.Ссылка КАК Реквизит,
	|	РеквизитыСведенийОбИмуществе.ИмяДляФормулы КАК ИмяРеквизита,
	|	ВЫБОР
	|		КОГДА РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Адрес)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоАдрес,
	|	РеквизитыСведенийОбИмуществе.ТипРеквизита.ТипЗначения КАК ТипЗначения,
	|	РеквизитыСведенийОбИмуществе.ОтборЭлементов
	|ИЗ
	|	Справочник.РеквизитыСведенийОбИмуществе КАК РеквизитыСведенийОбИмуществе
	|ГДЕ
	|	РеквизитыСведенийОбИмуществе.Владелец = &Владелец
	|	И НЕ РеквизитыСведенийОбИмуществе.ПометкаУдаления
	|	И (НЕ РеквизитыСведенийОбИмуществе.ЭтоГруппа
	|				И РеквизитыСведенийОбИмуществе.ВидРеквизита <> ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.ДекорацияНадпись)
	|			ИЛИ РеквизитыСведенийОбИмуществе.ВидРеквизита В (&СпискиЗначений))
	|	И НЕ РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ
	|				(ВЫБРАТЬ
	|					Р.Ссылка
	|				ИЗ
	|					Справочник.РеквизитыСведенийОбИмуществе КАК Р
	|				ГДЕ
	|					Р.ЭтоГруппа
	|					И Р.ПометкаУдаления
	|					И Р.Владелец = &Владелец)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ИмяРеквизита = Выборка.ИмяРеквизита;
		
		ЭтоОбъектРеестраИмущества = Выборка.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ОбъектыРеестраИмущества"));
		
		Если Данные.Колонки.Найти(ИмяРеквизита) = Неопределено И Не Выборка.ЭтоАдрес И Не ЭтоОбъектРеестраИмущества Тогда
			Продолжить;
		КонецЕсли;
		
		//ПутьРеквизита = РеестрИмуществаКлиентСервер.ПолучитьПутьРеквизита(Выборка.Реквизит);
		ПутьРеквизита = ПолучитьТабличнуюЧастьРеквизита(Выборка.Реквизит, ЭтоОбъектРеестраИмущества);
		ПутьРеквизита = ВРег(Путь + ?(ЗначениеЗаполнено(Путь) И ЗначениеЗаполнено(ПутьРеквизита), ".", "") + ПутьРеквизита);
		
		СтрокиДанных = Данные.НайтиСтроки(Новый Структура("СлужебноеПоле_ТабличнаяЧасть", ПутьРеквизита));
		
		Для Каждого СтрокаДанных Из СтрокиДанных Цикл
			
			Если Выборка.ЭтоАдрес Тогда
				Значение = ПрочитатьЗначениеАдреса(СтрокаДанных, ИмяРеквизита);
			ИначеЕсли ЭтоОбъектРеестраИмущества Тогда
				Значение = ПрочитатьОбъектРеестраИмущества(СтрокаДанных, ИмяРеквизита, Выборка.ОтборЭлементов);
			Иначе
				Значение = СтрокаДанных[ИмяРеквизита];
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Значение) Тогда
				СтрокаРезультата = ЗначенияРеквизитов.Добавить();
				СтрокаРезультата.РеквизитСведений = Выборка.Реквизит;
				СтрокаРезультата.Значение = Выборка.ТипЗначения.ПривестиЗначение(Значение);
				СтрокаРезультата.ИдентификаторСтрокиТабличнойЧасти = ИдентификаторСтрокиРеквизита(СтрокаДанных.СлужебноеПоле_ИдентификаторСтроки, Путь);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИдентификаторСтрокиРеквизита(ИдентификаторСтроки, Путь)
	
	Глубина = 1 + ?(Путь = "", 0, 1) + СтрЧислоВхождений(Путь, ".");
	
	НомераТаблиц = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИдентификаторСтроки, "/");
	
	Для Сч = 1 По Глубина Цикл
		НомераТаблиц.Удалить(0);	
	КонецЦикла;
	
	Результат = СтрСоединить(НомераТаблиц, "/");
	
	Возврат Результат;
	
КонецФункции

