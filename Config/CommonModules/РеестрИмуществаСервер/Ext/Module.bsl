Функция ПолучитьТекстОшибки(Текст)
	
	РасшифровкаОшибки = Новый Соответствие;
	РасшифровкаОшибки.Вставить("An error occurred when verifying security for the message.",	"Ошибка проверки безопасности");
	РасшифровкаОшибки.Вставить("Unknown Username or Incorrect Password",						"Неверный логин или пароль");
	//РасшифровкаОшибки.Вставить("The creator of this fault did not specify a Reason.",			"Ошибка регистрации карты:");
	//РасшифровкаОшибки.Вставить("ValidationFailed",												"Запрос выполнен с ошибками:");
	
	ТекстРасшифровки = РасшифровкаОшибки[Текст];
	
	Если ТекстРасшифровки = Неопределено Тогда	
		
		Если Лев(Текст, 3) = "The" И Прав(Текст, 18) = "field is required." Тогда
			ИмяПоля = СокрЛП(Сред(Текст, 4, СтрДлина(Текст) - 4 - 18 + 1));
			ТекстРасшифровки = "Свойство " + ИмяПоля + " обязательно для заполнения.";
		Иначе
			ТекстРасшифровки = Текст;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекстРасшифровки;
	
КонецФункции

Функция ПолучитьЭлемент(ЭлементDOM, ИмяЭлемента)
	
	Для Каждого Узел Из ЭлементDOM.ДочерниеУзлы Цикл
		Если Узел.ЛокальноеИмя = ИмяЭлемента Тогда
			Возврат Узел;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьЗначениеЭлемента(ЭлементDOM, ИмяЭлемента)
	
	Элемент = ПолучитьЭлемент(ЭлементDOM, ИмяЭлемента); 
	Возврат ?(Элемент = Неопределено, Неопределено, Элемент.ТекстовоеСодержимое);
	
КонецФункции

Процедура СохранитьРеквизитыРекурсивно(Источник, Приемник, Таблицы, НомерТаблицы, Выборка, Номер)
	
	Если НомерТаблицы < Таблицы.Количество() Тогда
		
		Таблица = Источник[Таблицы[НомерТаблицы]];
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			СохранитьРеквизитыРекурсивно(СтрокаТаблицы, Приемник, Таблицы, НомерТаблицы + 1, Выборка, ИдСтроки(Таблица.Индекс(СтрокаТаблицы), Номер));
		КонецЦикла;
		
	Иначе
		
		УстановитьУникальныйИдентификатор(Выборка, Источник);
		
		Значение = Источник[Выборка.ИмяРеквизита];
		
		Если ЗначениеЗаполнено(Значение) Тогда
			НовыеДанные = Приемник.Добавить();
			НовыеДанные.РеквизитСведений = Выборка.Реквизит;
			НовыеДанные.Значение = Значение;
			НовыеДанные.ИдентификаторСтрокиТабличнойЧасти = Номер;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьУникальныйИдентификатор(Выборка, Источник)
	
	Если Выборка.Реквизит.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.Идентификатор
		И ПустаяСтрока(Источник[Выборка.ИмяРеквизита]) Тогда
		Источник[Выборка.ИмяРеквизита] = Новый УникальныйИдентификатор;
	КонецЕсли;
	
КонецПроцедуры


Функция ИдСтроки(Номер = -1, ИсходныйНомер = "")
	
	//Возврат Формат(Номер, "ЧН=0; ЧГ=") + ?(ИсходныйНомер = "", "", "/") + ИсходныйНомер;
	Возврат ИсходныйНомер + ?(ИсходныйНомер = "", "", "/") + Формат(Номер + 1, "ЧГ=");
	
КонецФункции


Процедура ДобавитьСлужебныеРеквизиты(ДобавляемыеРеквизиты)
	
	//ТипОбъектаУчета = Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства,СправочникСсылка.Организации,СправочникСсылка.Контрагенты");
	ТипВладельца = Новый ОписаниеТипов("СправочникСсылка.ВидыКартСведенийОбИмуществе,СправочникСсылка.ВидыОбъектовРеестраИмущества");
	ТипРеквизит = Новый ОписаниеТипов("СправочникСсылка.РеквизитыСведенийОбИмуществе");
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СлужебноеПоле_ВладелецЭлементов", ТипВладельца));
	//ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СлужебноеПоле_Корень", ТипРеквизит));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СлужебноеПоле_ДобавленныеРеквизитыФормы", Новый ОписаниеТипов("СписокЗначений")));
	
	РеквизитИмя = "СлужебноеПоле_ТаблицыФормы";
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(РеквизитИмя, Новый ОписаниеТипов("ТаблицаЗначений")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Имя", ТипСтрока, РеквизитИмя));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Ссылка", ТипРеквизит, РеквизитИмя));
	
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СлужебноеПоле_АдресМакетаКомпоновкиЗаполнение", ТипСтрока));
	//ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СлужебноеПоле_АдресМакетаКомпоновкиОбязательность", ТипСтрока));
	//ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СлужебноеПоле_АдресМакетаКомпоновкиНедоступность", ТипСтрока));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СлужебноеПоле_АдресМакетаКомпоновкиСвойстваЭлементов", ТипСтрока));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СлужебноеПоле_АдресМакетаКомпоновкиКомментарий", ТипСтрока));
	
КонецПроцедуры

Процедура СоздатьСлужебныеЭлементыФормы(Форма, Знач ПолеКнопокКоманд)
	
	ГруппаКнопок = ?(ПолеКнопокКоманд = Неопределено, Форма.КоманднаяПанель, ПолеКнопокКоманд);
	
	КомандаЗаполнить = Форма.Команды.Добавить("ЗаполнитьРеквизиты");
	КомандаЗаполнить.Картинка = БиблиотекаКартинок.ЗаполнитьФорму;
	КомандаЗаполнить.Действие = "Подключаемый_ЗаполнитьРеквизиты";
	КомандаЗаполнить.Подсказка = "Заполнить";
	КомандаЗаполнить.ИзменяетСохраняемыеДанные = Истина;
	
	КнопкаЗаполнить = Форма.Элементы.Добавить("ФормаЗаполнитьРеквизиты", Тип("КнопкаФормы"), ГруппаКнопок);
	КнопкаЗаполнить.ИмяКоманды = "ЗаполнитьРеквизиты";
	
	КомандаПроверить = Форма.Команды.Добавить("ПроверитьЗаполнениеРеквизитов");
	КомандаПроверить.Картинка = БиблиотекаКартинок.СинтаксическийКонтроль; //БиблиотекаКартинок.ПравилоПроверки;
	КомандаПроверить.Действие = "Подключаемый_ПроверитьЗаполнениеРеквизитов";
	КомандаПроверить.Подсказка = "Проверить заполнение";
	
	КнопкаПроверить = Форма.Элементы.Добавить("ФормаПроверитьЗаполнениеРеквизитов", Тип("КнопкаФормы"), ГруппаКнопок);
	КнопкаПроверить.ИмяКоманды = "ПроверитьЗаполнениеРеквизитов";
	
КонецПроцедуры

Процедура СоздатьЭлементыФормы(Знач Форма, Знач ДеревоЭлементов, Знач ПолеДляЭлементов)
	
	Для Каждого ТекСтрокаДерева Из ДеревоЭлементов.Строки Цикл
		ДобавитьПолеФормы(Форма, ТекСтрокаДерева, ПолеДляЭлементов);
	КонецЦикла;
	
КонецПроцедуры


Процедура ДобавитьПолеФормы(Форма, ТекСтрокаДерева, ПолеДляЭлементов)
	
	НовыйЭлемент = Форма.Элементы.Найти(ТекСтрокаДерева.Имя);
	Если НовыйЭлемент = Неопределено Тогда
		НовыйЭлемент = Форма.Элементы.Добавить(ТекСтрокаДерева.Имя, ТекСтрокаДерева.ТипЭлемента, ПолеДляЭлементов);
	Иначе
		ТекстСообщения = НСтр("ru='Элемент формы с именем """ + ТекСтрокаДерева.Имя + """ уже существует'");
		ЗаписьЖурналаРегистрации("РеестрИмуществаСервер.ДобавитьПолеФормы",
		УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
		ВызватьИсключение "Не удалось создать элемент формы. См. журнал регистрации";
	КонецЕсли;
	
	Свойства = ТекСтрокаДерева.СвойстваЭлемента;
	
	Если Свойства.Свойство("Вид") Тогда
		НовыйЭлемент.Вид = Свойства.Вид;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НовыйЭлемент, Свойства);
	
	Если Свойства.Свойство("СписокВыбора") Тогда
		Для Каждого ЭлементСписка Из Свойства.СписокВыбора Цикл
			НовыйЭлемент.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
		КонецЦикла;
	КонецЕсли;
	
	Если Свойства.Свойство("СобытияЭлемента") Тогда
		Для Каждого СтрокаСобытий Из Свойства.СобытияЭлемента Цикл
			НовыйЭлемент.УстановитьДействие(СтрокаСобытий.ИмяСобытия, СтрокаСобытий.Действие);
		КонецЦикла;
	КонецЕсли;
	
	СоздатьЭлементыФормы(Форма, ТекСтрокаДерева, НовыйЭлемент);
	
КонецПроцедуры



Процедура ВыбратьДобавляемыеРеквизиты(Дерево, ДобавляемыеРеквизиты)
	
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		
		Если СтрокаДерева.ТипЭлемента.СодержитТип(Тип("ПолеФормы")) Тогда
			ДобавляемыеРеквизиты.Добавить(
								Новый РеквизитФормы(СтрокаДерева.Имя,
													СтрокаДерева.ТипЗначения,
													СтрокаДерева.Путь,
													СтрокаДерева.Заголовок,
													Истина));
			//ПутиДобавляемыхРеквизитов.Добавить(СтрокаДерева.ПутьКДанным);
			
		ИначеЕсли СтрокаДерева.ТипЭлемента.СодержитТип(Тип("ГруппаФормы")) Тогда
			ВыбратьДобавляемыеРеквизиты(СтрокаДерева, ДобавляемыеРеквизиты);
			
		ИначеЕсли СтрокаДерева.ТипЭлемента.СодержитТип(Тип("ТаблицаФормы")) Тогда
			ДобавляемыеРеквизиты.Добавить(
								Новый РеквизитФормы(СтрокаДерева.Имя,
													Новый ОписаниеТипов("ТаблицаЗначений"),
													СтрокаДерева.Путь,
													СтрокаДерева.Заголовок,
													Истина));
			//ПутиДобавляемыхРеквизитов.Добавить(СтрокаДерева.ПутьКДанным);
			ВыбратьДобавляемыеРеквизиты(СтрокаДерева, ДобавляемыеРеквизиты);
				
		КонецЕсли;
		
		Если СтрокаДерева.ЭтоАдрес Тогда
			
			ДобавляемыеРеквизиты.Добавить(
								Новый РеквизитФормы(СтрокаДерева.Имя + "_ПредставлениеАдреса",
													Новый ОписаниеТипов("СписокЗначений, Строка"),
													СтрокаДерева.Путь,
													СтрокаДерева.Заголовок,
													Истина));
													
			//ПутиДобавляемыхРеквизитов.Добавить(СтрокаДерева.ПутьКДанным + "ЗначенияПолей");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

