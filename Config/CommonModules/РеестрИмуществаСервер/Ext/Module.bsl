// Обработка данных при обмене

// Отправка

Функция ТаблицаСведенийОбИмуществе(ОбъектСсылка = Неопределено, Знач ИмяТЧ = "", Знач Условие = "") Экспорт
	
	МассивСсылок = ?(ТипЗнч(ОбъектСсылка) = Тип("Массив"), ОбъектСсылка, ОбщегоНазначенияБГУ.Массив(ОбъектСсылка));
	
	Таблица = Новый ТаблицаЗначений;
	
	Таблица.Колонки.Добавить("ИмяТабЧасти");
	Таблица.Колонки.Добавить("НомерСтроки");
	Таблица.Колонки.Добавить("ИмяТабЧасти_Гл");
	Таблица.Колонки.Добавить("НомерСтроки_Гл");	
	Таблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
	Таблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	
	Параметры = ПарсингУсловия(Условие);
	
	ДобавитьВТаблицуКолонкиВидаКарты(Таблица, МассивСсылок, Параметры.Префикс); 
	
	Для Каждого СсылкаОбъекта Из МассивСсылок Цикл
		ДобавитьВТаблицуСведения(Таблица, СсылкаОбъекта, СсылкаОбъекта, Параметры, ИмяТЧ);
	КонецЦикла;
	
	Для Каждого СсылкаДокумента Из МассивСсылок Цикл
		Если Таблица.НайтиСтроки(Новый Структура("СсылкаДокумента,ИмяТабЧасти", СсылкаДокумента,ВРег(ИмяТЧ))).Количество() = 0 Тогда
			СтрокаТаблицы = Таблица.Добавить();
			СтрокаТаблицы.ИмяТабЧасти = ВРег(ИмяТЧ);
			СтрокаТаблицы.НомерСтроки = 1;
			СтрокаТаблицы.ИмяТабЧасти_Гл = "";
			СтрокаТаблицы.НомерСтроки_Гл = "";
			СтрокаТаблицы.СсылкаДокумента = СсылкаДокумента;
			СтрокаТаблицы.ПолеСвязи = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ТаблицаФайлов(ОбъектСсылка = Неопределено, Знач ИмяТЧ = "", Знач Условие = "") Экспорт
	
	МассивСсылок = ?(ТипЗнч(ОбъектСсылка) = Тип("Массив"), ОбъектСсылка, ОбщегоНазначенияБГУ.Массив(ОбъектСсылка));
	
	Таблица = Новый ТаблицаЗначений;
	
	Таблица.Колонки.Добавить("ИмяТабЧасти");
	Таблица.Колонки.Добавить("НомерСтроки");
	Таблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
	Таблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	
	Таблица.Колонки.Добавить("ГУИД");
	Таблица.Колонки.Добавить("Наименование");
	Таблица.Колонки.Добавить("Ссылка");
	Таблица.Колонки.Добавить("УникальныйПутьКФайлу");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегистрацияСведенийОбИмуществеЗначенияРеквизитов.Ссылка КАК СсылкаДокумента,
	|	РегистрацияСведенийОбИмуществеЗначенияРеквизитов.Значение КАК СсылкаВладельца,
	|	ОбъектыРеестраИмуществаПрисоединенныеФайлы.Ссылка КАК СсылкаФайла,
	|	ОбъектыРеестраИмуществаПрисоединенныеФайлы.Наименование,
	|	ОбъектыРеестраИмуществаПрисоединенныеФайлы.Расширение
	|ИЗ
	|	Документ.РегистрацияСведенийОбИмуществе.ЗначенияРеквизитов КАК РегистрацияСведенийОбИмуществеЗначенияРеквизитов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыРеестраИмуществаПрисоединенныеФайлы КАК ОбъектыРеестраИмуществаПрисоединенныеФайлы
	|		ПО РегистрацияСведенийОбИмуществеЗначенияРеквизитов.Значение = ОбъектыРеестраИмуществаПрисоединенныеФайлы.ВладелецФайла
	|ГДЕ
	|	РегистрацияСведенийОбИмуществеЗначенияРеквизитов.Ссылка В(&МассивСсылок)
	|	И РегистрацияСведенийОбИмуществеЗначенияРеквизитов.Значение ССЫЛКА Справочник.ОбъектыРеестраИмущества
	|	И НЕ ОбъектыРеестраИмуществаПрисоединенныеФайлы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	СсылкаДокумента,
	|	СсылкаВладельца,
	|	СсылкаФайла";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Сч = 1;
	
	Пока Выборка.СледующийПоЗначениюПоля("СсылкаВладельца") Цикл
		
		НоваяСтрока = Таблица.Добавить();
		
		НоваяСтрока.ИмяТабЧасти = ВРег(ИмяТЧ);
		НоваяСтрока.НомерСтроки = Сч;
		НоваяСтрока.СсылкаДокумента = Выборка.СсылкаДокумента;
		НоваяСтрока.ПолеСвязи = Истина;
		
		НоваяСтрока.ГУИД = Выборка.СсылкаВладельца.УникальныйИдентификатор();
		НоваяСтрока.Наименование = Выборка.Наименование + ?(ЗначениеЗаполнено(Выборка.Наименование) И ЗначениеЗаполнено(Выборка.Расширение),".", "") + Выборка.Расширение;
		НоваяСтрока.Ссылка = Выборка.СсылкаФайла;
		НоваяСтрока.УникальныйПутьКФайлу = СтрЗаменить(Новый УникальныйИдентификатор(), "-", "");
		
		Сч = Сч + 1;
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

