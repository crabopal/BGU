// Процедуры управления вызовами пользовательского кода

// Возвращает зарезервированное имя процедуры-обработчика события
//
Функция ПолучитьИмяОбработчикаСобытия(Знач ТипЗначения, Знач Событие) Экспорт
	
	Результат = "";
	
	ТаблицаСобытий = ПользовательскиеАлгоритмыПовтИсп.ПолучитьТаблицуСобытий(Метаданные.НайтиПоТипу(ТипЗначения).ПолноеИмя());
	
	СтрокаТаблицыСобытий = ТаблицаСобытий.Найти(Событие, "Идентификатор");
	Если СтрокаТаблицыСобытий <> Неопределено Тогда
		Результат = СтрокаТаблицыСобытий.ИмяПроцедуры;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьИмяОбработчикаСобытия()

// Формирует служебный объект, необходимый для вызовов вложенных процедур в модулях.
//
Функция ПодготовитьДескрипторМодуля(Знач Модуль) Экспорт

	СписокПроцедур = ПолучитьСписокПроцедурМодуля(Модуль);
	
	Дескриптор = Новый Структура;
	Дескриптор.Вставить("Ссылка"         ,Модуль);
	Дескриптор.Вставить("ПроцедурыМодуля", Новый Структура);
	
	Для Каждого ИмяПроцедуры Из СписокПроцедур Цикл
		ОписательПроцедуры = Новый Структура;
		ОписательПроцедуры.Вставить("ИмяПроцедуры"      ,ИмяПроцедуры.Значение);
		ОписательПроцедуры.Вставить("РодительскийМодуль",Дескриптор);
		Дескриптор.ПроцедурыМодуля.Вставить(ИмяПроцедуры.Значение,ОписательПроцедуры);
	КонецЦикла;
	
	Возврат Дескриптор;

КонецФункции // ПодготовитьДескрипторМодуля()

// Определяет, что в модуле определен обработчик указанного события
//
Функция ОбработчикСобытияОпределен(Знач Модуль, Знач Событие) Экспорт

	ИмяОбработчика = ПолучитьИмяОбработчикаСобытия(ТипЗнч(Модуль),Событие);
	
	Запрос       = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ПроцедураОпределена
	|ИЗ
	|	РегистрСведений.ТекстыПользовательскихПроцедур КАК ТекстыПользовательскихПроцедур
	|ГДЕ
	|	ТекстыПользовательскихПроцедур.Модуль = &Модуль
	|	И ТекстыПользовательскихПроцедур.ИмяПроцедуры = &ИмяПроцедуры";
	
	Запрос.УстановитьПараметр("Модуль"      ,Модуль);
	Запрос.УстановитьПараметр("ИмяПроцедуры",ИмяОбработчика);
	
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции // ПроцедураОпределена()

// Освобождение памяти объекта-дескриптора.
//
Процедура ОсвободитьДескрипторМодуля(Дескриптор) Экспорт

	Если ТипЗнч(Дескриптор) = Тип("Структура") и Дескриптор.Свойство("ПроцедурыМодуля") Тогда
		
		Для Каждого Элемент Из Дескриптор.ПроцедурыМодуля Цикл
			// Это вложенный дескриптор.
			ОсвободитьДескрипторМодуля(Элемент.Значение);
		КонецЦикла;
		
		Дескриптор.ПроцедурыМодуля.Очистить();
		Дескриптор.Очистить();
		Дескриптор = Неопределено;
		
	КонецЕсли;

КонецПроцедуры // ОсвободитьДескрипторМодуля()

// Получает из ИБ текст процедуры.
//
Функция ПолучитьТекстПроцедуры(Знач Ссылка, Знач ИмяПроцедуры) Экспорт

	Возврат ПользовательскиеАлгоритмыПовтИсп.ПолучитьТекстПроцедуры(Ссылка, ИмяПроцедуры);

КонецФункции // ПолучитьТекстПроцедуры()


// Процедуры организации пользовательского интерфейса

// Добавляет в форму реквизиты, необходимые для организации интерфейса редактирования процедур
//
Процедура ПриСозданииНаСервереФормыРедактированияКода(Знач ЭтаФорма, Знач ИмяГруппыДляЭлементаСписка, Знач ИмяГруппыДляТекстаПроцедуры, Знач ИмяСобытия) Экспорт

	МассивРеквизитов = Новый Массив;
	
	// Создание таблицы редактирования процедур
	РедактируемыеПроцедуры = ПолучитьТаблицуРедактируемыхПроцедур();
	
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ТаблицаРедактированияПроцедур", Новый ОписаниеТипов("ТаблицаЗначений"),,,Истина));
	Для Каждого Колонка Из РедактируемыеПроцедуры.Колонки Цикл
		МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения,"ТаблицаРедактированияПроцедур"));
	КонецЦикла;

	// Добавление реквизита с идентификатором текущей процедуры
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ТекущаяПроцедура",Новый ОписаниеТипов("УникальныйИдентификатор,Строка")));
	// Добавление реквизита редактирования текста процедуры
	МассивРеквизитов.Добавить(Новый РеквизитФормы("ТекстПроцедуры",Новый ОписаниеТипов("ТекстовыйДокумент")));
	
	// Запуск модификации реквизитов формы
	ЭтаФорма.ИзменитьРеквизиты(МассивРеквизитов);
	
	// Настройка списка процедур
	ИмяТекущейПроцедуры           = ПолучитьИмяОбработчикаСобытия(ТипЗнч(ЭтаФорма.Объект.Ссылка), ИмяСобытия);
	ИдентификаторТекущейПроцедуры = Неопределено;
	
	Если ЗначениеЗаполнено(ЭтаФорма.Параметры.ЗначениеКопирования) Тогда
		СписокПроцедурМодуля = ПолучитьСписокПроцедурМодуля(ЭтаФорма.Параметры.ЗначениеКопирования);
	Иначе
		СписокПроцедурМодуля = ПолучитьСписокПроцедурМодуля(ЭтаФорма.Объект.Ссылка);
	КонецЕсли;
	
	Для Каждого ИмяПроцедуры Из СписокПроцедурМодуля Цикл
		
		СтрРедактируемых              = РедактируемыеПроцедуры.Добавить();
		СтрРедактируемых.ИмяПроцедуры = ИмяПроцедуры.Значение;
		Если ЗначениеЗаполнено(ЭтаФорма.Параметры.ЗначениеКопирования) Тогда
			СтрРедактируемых.ТекстПроцедуры = ПользовательскиеАлгоритмыПовтИсп.ПолучитьТекстПроцедуры(ЭтаФорма.Параметры.ЗначениеКопирования,СтрРедактируемых.ИмяПроцедуры);
			СтрРедактируемых.Загружена      = Истина;
		КонецЕсли;
		
		СтрРедактируемых.Идентификатор = Новый УникальныйИдентификатор;
		
		Если ИмяТекущейПроцедуры = СтрРедактируемых.ИмяПроцедуры Тогда
			ИдентификаторТекущейПроцедуры = СтрРедактируемых.Идентификатор;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВДанныеФормы(РедактируемыеПроцедуры, ЭтаФорма.ТаблицаРедактированияПроцедур);
	
	// Настройка поля выбора текущей процедуры
	ЭлементСписка = ЭтаФорма.Элементы.Добавить("ТекущаяПроцедура",Тип("ПолеФормы"),ЭтаФорма.Элементы[ИмяГруппыДляЭлементаСписка]);
	ЭлементСписка.Заголовок           = "Процедура";
	ЭлементСписка.ПутьКДанным         = "ТекущаяПроцедура";
	ЭлементСписка.Вид                 = ВидПоляФормы.ПолеВвода;
	ЭлементСписка.РежимВыбораИзСписка = Истина;
	ЭлементСписка.КнопкаОткрытия      = Истина;
	ЭлементСписка.УстановитьДействие("ОбработкаВыбора", "Подключаемый_ТекущаяПроцедураОбработкаВыбора");
	ЭлементСписка.УстановитьДействие("Открытие"       , "Подключаемый_ТекущаяПроцедураОткрытие");
	
	// Настройка поля текстового документа
	ЭлементТекст = ЭтаФорма.Элементы.Добавить("ТекстПроцедуры",Тип("ПолеФормы"),ЭтаФорма.Элементы[ИмяГруппыДляТекстаПроцедуры]);
	ЭлементТекст.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ЭлементТекст.ПутьКДанным        = "ТекстПроцедуры";
	ЭлементТекст.Вид                = ВидПоляФормы.ПолеТекстовогоДокумента;
	
	ПользовательскиеАлгоритмыКлиентСервер.ОбновитьОтображениеТекстаПроцедуры(ЭтаФорма, ЭтаФорма.ТаблицаРедактированияПроцедур, ИдентификаторТекущейПроцедуры);
	
КонецПроцедуры // ПриСозданииНаСервереФормыРедактированияКода()

// Обработчик записи на сервере формы редактирования пользовательского кода
//
Процедура ПриЗаписиНаСервереФормыРедактированияКода(Знач ЭтаФорма, Знач ТекущийОбъект) Экспорт

	ПользовательскиеАлгоритмыКлиентСервер.СохранитьТекущиеДанные(ЭтаФорма);
	
	БлокировкаДанных  = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ТекстыПользовательскихПроцедур");
	ЭлементБлокировки.УстановитьЗначение("Модуль",ТекущийОбъект.Ссылка);
	
	БлокировкаДанных.Заблокировать();
	
	НаборЗаписей = РегистрыСведений.ТекстыПользовательскихПроцедур.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Модуль.Установить(ТекущийОбъект.Ссылка);
	НаборЗаписей.Прочитать();
	
	ТаблицаРегистра = НаборЗаписей.Выгрузить(,"ИмяПроцедуры,ТекстПроцедуры");
	НаборЗаписей.Очистить();
	
	Для Каждого СтрРедактируемых Из ЭтаФорма.ТаблицаРедактированияПроцедур Цикл
		Если Не СтрРедактируемых.Загружена Тогда
			СтрРегистра = ТаблицаРегистра.Найти(СтрРедактируемых.ИмяПроцедуры,"ИмяПроцедуры");
			Если Не СтрРегистра = Неопределено Тогда
				СтрРедактируемых.ТекстПроцедуры = СтрРегистра.ТекстПроцедуры;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ПустаяСтрока(СтрРедактируемых.ТекстПроцедуры) Тогда
			ЗаписьРегистра = НаборЗаписей.Добавить();
			ЗаписьРегистра.Модуль         = ТекущийОбъект.Ссылка;
			ЗаписьРегистра.ИмяПроцедуры   = СтрРедактируемых.ИмяПроцедуры;
			ЗаписьРегистра.ТекстПроцедуры = СтрРедактируемых.ТекстПроцедуры;
		КонецЕсли;
		
	КонецЦикла;
	
	НаборЗаписей.Записать();

КонецПроцедуры // ПриЗаписиНаСервереФормыРедактированияКода()


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
//

// Процедуры организации пользовательского интерфейса


// Формирует список выбора, используемый в формах редактирования кода.
//
//
Функция ДобавитьВСписокСобытия(Модуль, СуществующиеЗначения) Экспорт 

	СписокРезультат = СуществующиеЗначения.Скопировать();
	
	ТаблицаСобытий = ПользовательскиеАлгоритмыПовтИсп.ПолучитьТаблицуСобытий(Модуль.Метаданные().ПолноеИмя()).Скопировать();
	
	Для Каждого ЭлементСписка Из СписокРезультат Цикл
		
		СтрокаТаблицыСобытий = ТаблицаСобытий.Найти(ЭлементСписка.Представление, "ИмяПроцедуры");
		
		Если СтрокаТаблицыСобытий <> Неопределено Тогда
			ТаблицаСобытий.Удалить(СтрокаТаблицыСобытий);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаТаблицыСобытий Из ТаблицаСобытий Цикл
		СписокРезультат.Добавить(СтрокаТаблицыСобытий.ИмяПроцедуры, "<" + СтрокаТаблицыСобытий.ИмяПроцедуры + ">");
	КонецЦикла;

	Возврат СписокРезультат;
	
КонецФункции // ПолучитьСписокВыбораПроцедурМодуля()

// Возвращает список имен процедур, сохраненных в регистре ТекстыПользовательскихПроцедур
//
Функция ПолучитьСписокПроцедурМодуля(Модуль)

	Возврат ПользовательскиеАлгоритмыПовтИсп.ПолучитьСписокПроцедурМодуля(Модуль);

КонецФункции // ПолучитьСписокПроцедурМодуля()

// Создает пустую таблицу редактируемых процедур.
//
Функция ПолучитьТаблицуРедактируемыхПроцедур()

	РедактируемыеПроцедуры = Новый ТаблицаЗначений;
	РедактируемыеПроцедуры.Колонки.Добавить("ИмяПроцедуры"     ,Новый ОписаниеТипов("Строка"));
	РедактируемыеПроцедуры.Колонки.Добавить("ТекстПроцедуры"   ,Новый ОписаниеТипов("Строка"));
	РедактируемыеПроцедуры.Колонки.Добавить("Загружена"        ,Новый ОписаниеТипов("Булево"));
	РедактируемыеПроцедуры.Колонки.Добавить("Идентификатор"    ,Новый ОписаниеТипов("УникальныйИдентификатор")); // Ключ, не зависящий от имени.
	
	Возврат РедактируемыеПроцедуры;

КонецФункции // ПолучитьТаблицуРедактируемыхПроцедур()




