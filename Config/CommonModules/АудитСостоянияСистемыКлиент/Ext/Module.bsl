#Область СлужебныйПрограммныйИнтерфейс

// Метод предназначен для отображения пользователю дополнительной информации о проблеме.
// Если поведение не переопределяется прикладной подсистемой, 
//	отображается стандартная форма проблемы.
//
// Параметры:
//	Идентификатор - строка, указанная при регистрации проверки, 
//		см. ЗарегистрироватьПроверкуСостоянияСистемы.
//	Проблема - идентификатор выявленной проблемы, позволяет получить 
//		дополнительную информацию по проблеме при помощи метода 
//		АудитСостоянияСистемы.ДополнительнаяИнформацияПоПроблеме.
//
Процедура ПоказатьДополнительнуюИнформациюОПроблеме(ИдентификаторПроверки, Проблема, Организация) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	АудитСостоянияСистемыКлиентПереопределяемый.ПоказатьДополнительнуюИнформациюОПроблеме(ИдентификаторПроверки, Проблема, СтандартнаяОбработка);
	
	Если Не СтандартнаяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	// Отображаем штатную форму дополнительной информации о проблеме.
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдентификаторПроверки", ИдентификаторПроверки);
	ПараметрыФормы.Вставить("Проблема", Проблема);
	ПараметрыФормы.Вставить("Организация", Организация);
	
	ОткрытьФорму("РегистрСведений.ПроблемыСостоянияСистемы.Форма.ФормаПроблемы", ПараметрыФормы);
	
КонецПроцедуры

Процедура ПодключитьДлительнуюОперацию(Форма, Результат, ПараметрыОбработчикаОжидания, ФормаДлительнойОперации) Экспорт
	
	Если Не Результат.ЗаданиеВыполнено Тогда
		
		Форма.ИдентификаторЗадания = Результат.ИдентификаторЗадания;
		Форма.АдресХранилища		 = Результат.АдресХранилища;
		
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		Форма.ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(Форма, Форма.ИдентификаторЗадания);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьВыполнениеЗадания(Форма, ПараметрыОбработчикаОжидания, ФормаДлительнойОперации) Экспорт
	
	Попытка
		Если ФормаДлительнойОперации.Открыта()
			И ФормаДлительнойОперации.ИдентификаторЗадания = Форма.ИдентификаторЗадания Тогда
			Если Форма.ЗаданиеВыполнено(Форма.ИдентификаторЗадания) Тогда
				ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			Иначе
				ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
				Форма.ПодключитьОбработчикОжидания(
					"Подключаемый_ПроверитьВыполнениеЗадания",
					ПараметрыОбработчикаОжидания.ТекущийИнтервал,
					Истина);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
