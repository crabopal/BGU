
#Область ПрограммныйИнтерфейс

Функция ОбщееСокрЛП(Значение) Экспорт
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	Иначе
		Возврат СокрЛП(Значение);
	КонецЕсли;
КонецФункции

Функция ОбщееЧисло(Значение) Экспорт
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	Иначе
		Возврат Число(Значение);
	КонецЕсли;
КонецФункции

// Процедура заменяет использованные в формуле условные операторы "?" на конструкцию "Выбор"
//
Процедура ЗаменитьУсловныйОператор(Выражение) Экспорт

	Пока Найти(Выражение, "?") Цикл
		
		ВрВыражение = Выражение;
		ВрФормула = "";
		Позиция = Найти(Выражение, "?");
		ВрФормула = Лев(ВрВыражение, Позиция-1) + " Выбор Когда ";
		ВрВыражение = Сред(ВрВыражение, Позиция + 2);
		// ищем ЗПТ
		СчетчикСкобок=0;
		СчетчикКавычек=0;
		
		Счетчик = 1;
		Пока Счетчик < СтрДлина(ВрВыражение) Цикл
			ТекСимвол = Сред(ВрВыражение, Счетчик, 1);
			Если ТекСимвол = "(" Тогда
				СчетчикСкобок = СчетчикСкобок + 1;
			ИначеЕсли ТекСимвол = """" Тогда
				СчтечикКавычек = ?(СчетчикКавычек = 0, 1, 0);
			ИначеЕсли ТекСимвол = ")" Тогда
				СчетчикСкобок = СчетчикСкобок - 1;
			ИначеЕсли ТекСимвол = "," Тогда
				Если СчетчикСкобок = 0 И СчетчикКавычек = 0 Тогда
					ВрФормула = ВрФормула + Лев(ВрВыражение, Счетчик-1)+ " Тогда ";
					ВрВыражение = Сред(ВрВыражение, Счетчик + 1);
					Прервать;
				КонецЕсли;
			КонецЕслИ;
			Счетчик = Счетчик+1;
		КонецЦикла;				
		// ищем ЗПТ
		СчетчикСкобок=0;
		СчетчикКавычек=0;
		
		Счетчик = 1;
		Пока Счетчик < СтрДлина(ВрВыражение) Цикл
			ТекСимвол = Сред(ВрВыражение, Счетчик, 1);
			Если ТекСимвол = "(" Тогда
				СчетчикСкобок = СчетчикСкобок + 1;
			ИначеЕсли ТекСимвол = """" Тогда
				СчтечикКавычек = ?(СчетчикКавычек = 0, 1, 0);
			ИначеЕсли ТекСимвол = ")" Тогда
				СчетчикСкобок = СчетчикСкобок - 1;
			ИначеЕсли ТекСимвол = "," Тогда
				Если СчетчикСкобок = 0 И СчетчикКавычек = 0 Тогда
					ВрФормула = ВрФормула + Лев(ВрВыражение, Счетчик-1)+ " Иначе ";
					ВрВыражение = Сред(ВрВыражение, Счетчик + 1);
					Прервать;
				КонецЕсли;
			КонецЕслИ;
			Счетчик = Счетчик+1;
		КонецЦикла;				
		// ищем завершающую скобку
		СчетчикСкобок=0;
		СчетчикКавычек=0;
		
		Счетчик = 1;
		Пока Счетчик <= СтрДлина(ВрВыражение) Цикл
			ТекСимвол = Сред(ВрВыражение, Счетчик, 1);
			Если ТекСимвол = "(" Тогда
				СчетчикСкобок = СчетчикСкобок + 1;
			ИначеЕсли ТекСимвол = """" Тогда
				СчтечикКавычек = ?(СчетчикКавычек = 0, 1, 0);
			ИначеЕсли ТекСимвол = ")" Тогда
				Если СчетчикСкобок = 0 И СчетчикКавычек = 0 Тогда
					ВрФормула = ВрФормула + Лев(ВрВыражение, Счетчик-1)+ " Конец ";
					ВрВыражение = Сред(ВрВыражение, Счетчик + 1);
					Прервать;
				КонецЕсли;
				СчетчикСкобок = СчетчикСкобок - 1;
			КонецЕслИ;
			Счетчик = Счетчик+1;
		КонецЦикла;				
		
		Выражение = ВрФормула + ВрВыражение;
		
	КонецЦикла; 
	

КонецПроцедуры
	
// Процедура заменет использованные в формуле строковые функции Лев(), Прав(), Сред() на конструкцию "Подстрока"
//
Процедура ЗаменитьСтроковыеФункции(Выражение) Экспорт
	
	//Лев
	Пока Найти(ВРег(Выражение), "ЛЕВ(") Цикл
		
		ВрВыражение = Выражение;
		ВрФормула = "";
		Позиция = Найти(ВРег(Выражение), "ЛЕВ(");
		ВрФормула = Лев(ВрВыражение, Позиция-1) + " Подстрока(";
		ВрВыражение = Сред(ВрВыражение, Позиция + 4);
		// ищем ЗПТ
		СчетчикСкобок=0;
		СчетчикКавычек=0;
		
		Счетчик = 1;
		Пока Счетчик < СтрДлина(ВрВыражение) Цикл
			ТекСимвол = Сред(ВрВыражение, Счетчик, 1);
			Если ТекСимвол = "(" Тогда
				СчетчикСкобок = СчетчикСкобок + 1;
			ИначеЕсли ТекСимвол = """" Тогда
				СчтечикКавычек = ?(СчетчикКавычек = 0, 1, 0);
			ИначеЕсли ТекСимвол = ")" Тогда
				СчетчикСкобок = СчетчикСкобок - 1;
			ИначеЕсли ТекСимвол = "," Тогда
				Если СчетчикСкобок = 0 И СчетчикКавычек = 0 Тогда
					ВрФормула = ВрФормула + Лев(ВрВыражение, Счетчик-1)+ " , 1,";
					ВрВыражение = Сред(ВрВыражение, Счетчик + 1);
					Прервать;
				КонецЕсли;
			КонецЕслИ;
			Счетчик = Счетчик+1;
		КонецЦикла;	
		Выражение = ВрФормула + ВрВыражение;
	КонецЦикла;
	
	//Прав
	Пока Найти(ВРег(Выражение), "ПРАВ(") Цикл
		Текст = "";
		КолСимволов = 0;
		ВрВыражение = Выражение;
		ВрФормула = "";
		Позиция = Найти(ВРег(Выражение), "ПРАВ(");
		ВрФормула = Лев(ВрВыражение, Позиция-1) + " Подстрока(";
		ВрВыражение = Сред(ВрВыражение, Позиция + 5);
		// ищем ЗПТ
		СчетчикСкобок=0;
		СчетчикКавычек=0;
		
		Счетчик = 1;
		Пока Счетчик < СтрДлина(ВрВыражение) Цикл
			ТекСимвол = Сред(ВрВыражение, Счетчик, 1);
			Если ТекСимвол = "(" Тогда
				СчетчикСкобок = СчетчикСкобок + 1;
			ИначеЕсли ТекСимвол = """" Тогда
				СчтечикКавычек = ?(СчетчикКавычек = 0, 1, 0);
			ИначеЕсли ТекСимвол = ")" Тогда
				СчетчикСкобок = СчетчикСкобок - 1;
			ИначеЕсли ТекСимвол = "," Тогда
				Если СчетчикСкобок = 0 И СчетчикКавычек = 0 Тогда
					Текст = Лев(ВрВыражение, Счетчик-1);
					ВрФормула = ВрФормула + Лев(ВрВыражение, Счетчик-1)+ ", ";
					ВрВыражение = Сред(ВрВыражение, Счетчик + 1);
					Прервать;
				КонецЕсли;
			КонецЕслИ;
			Счетчик = Счетчик+1;
		КонецЦикла;	
		
		// ищем завершающую скобку
		СчетчикСкобок=0;
		СчетчикКавычек=0;
		
		Счетчик = 1;
		Пока Счетчик <= СтрДлина(ВрВыражение) Цикл
			ТекСимвол = Сред(ВрВыражение, Счетчик, 1);
			Если ТекСимвол = "(" Тогда
				СчетчикСкобок = СчетчикСкобок + 1;
			ИначеЕсли ТекСимвол = """" Тогда
				СчтечикКавычек = ?(СчетчикКавычек = 0, 1, 0);
			ИначеЕсли ТекСимвол = ")" Тогда
				Если СчетчикСкобок = 0 И СчетчикКавычек = 0 Тогда
					КолСимволов = Лев(ВрВыражение, Счетчик-1);
					ВрФормула = ВрФормула + " ДлинаСтроки("+Текст + ") + 1 - " + КолСимволов + ", " + КолСимволов + ")";
					ВрВыражение = Сред(ВрВыражение, Счетчик + 1);
					Прервать;
				КонецЕсли;
				СчетчикСкобок = СчетчикСкобок - 1;
			КонецЕслИ;
			Счетчик = Счетчик+1;
		КонецЦикла;				
		
		Выражение = ВрФормула + ВрВыражение;
		
	КонецЦикла; 
	
	//Сред
	Пока Найти(ВРег(Выражение), "СРЕД(") Цикл
		Текст = "";
		КолСимволов = 0;
		ВрВыражение = Выражение;
		ВрФормула = "";
		Позиция = Найти(ВРег(Выражение), "СРЕД(");
		ВрФормула = Лев(ВрВыражение, Позиция-1) + " Подстрока(";
		ВрВыражение = Сред(ВрВыражение, Позиция + 5);
		// ищем ЗПТ
		СчетчикСкобок=0;
		СчетчикКавычек=0;
		
		Счетчик = 1;
		Пока Счетчик < СтрДлина(ВрВыражение) Цикл
			ТекСимвол = Сред(ВрВыражение, Счетчик, 1);
			Если ТекСимвол = "(" Тогда
				СчетчикСкобок = СчетчикСкобок + 1;
			ИначеЕсли ТекСимвол = """" Тогда
				СчтечикКавычек = ?(СчетчикКавычек = 0, 1, 0);
			ИначеЕсли ТекСимвол = ")" Тогда
				СчетчикСкобок = СчетчикСкобок - 1;
			ИначеЕсли ТекСимвол = "," Тогда
				Если СчетчикСкобок = 0 И СчетчикКавычек = 0 Тогда
					Текст = Лев(ВрВыражение, Счетчик-1);
					ВрФормула = ВрФормула + Лев(ВрВыражение, Счетчик-1)+ ", ";
					ВрВыражение = Сред(ВрВыражение, Счетчик + 1);
					Прервать;
				КонецЕсли;
			КонецЕслИ;
			Счетчик = Счетчик+1;
		КонецЦикла;	
		
		// ищем ЗПТ или завершающую скобку
		СчетчикСкобок=0;
		СчетчикКавычек=0;
		ВыражениеЗакрыто = Ложь;
		Счетчик = 1;
		Пока Счетчик < СтрДлина(ВрВыражение) Цикл
			ТекСимвол = Сред(ВрВыражение, Счетчик, 1);
			Если ТекСимвол = "(" Тогда
				СчетчикСкобок = СчетчикСкобок + 1;
			ИначеЕсли ТекСимвол = """" Тогда
				СчтечикКавычек = ?(СчетчикКавычек = 0, 1, 0);
			ИначеЕсли ТекСимвол = ")" Тогда
				Если СчетчикСкобок = 0 И СчетчикКавычек = 0 Тогда
					НомерСимвола = Лев(ВрВыражение, Счетчик-1);
					ВрФормула = ВрФормула + НомерСимвола+ ", ДлинаСтроки(" + Текст + ") + 1 - " + НомерСимвола + ") ";
					ВрВыражение = Сред(ВрВыражение, Счетчик + 1);
					ВыражениеЗакрыто = Истина;
					Прервать;
				КонецЕсли;
				СчетчикСкобок = СчетчикСкобок - 1;
			ИначеЕсли ТекСимвол = "," Тогда
				Если СчетчикСкобок = 0 И СчетчикКавычек = 0 Тогда
					НомерСимвола = Лев(ВрВыражение, Счетчик-1);
					ВрФормула = ВрФормула + НомерСимвола+ ", ";
					ВрВыражение = Сред(ВрВыражение, Счетчик + 1);
					Прервать;
				КонецЕсли;
			КонецЕслИ;
			Счетчик = Счетчик+1;
		КонецЦикла;	
		
		Если НЕ ВыражениеЗакрыто Тогда
			// ищем завершающую скобку
			СчетчикСкобок=0;
			СчетчикКавычек=0;
			
			Счетчик = 1;
			Пока Счетчик <= СтрДлина(ВрВыражение) Цикл
				ТекСимвол = Сред(ВрВыражение, Счетчик, 1);
				Если ТекСимвол = "(" Тогда
					СчетчикСкобок = СчетчикСкобок + 1;
				ИначеЕсли ТекСимвол = """" Тогда
					СчтечикКавычек = ?(СчетчикКавычек = 0, 1, 0);
				ИначеЕсли ТекСимвол = ")" Тогда
					Если СчетчикСкобок = 0 И СчетчикКавычек = 0 Тогда
						КолСимволов = Лев(ВрВыражение, Счетчик-1);
						ВрФормула = ВрФормула + КолСимволов + ")";
						ВрВыражение = Сред(ВрВыражение, Счетчик + 1);
						Прервать;
					КонецЕсли;
					СчетчикСкобок = СчетчикСкобок - 1;
				КонецЕслИ;
				Счетчик = Счетчик+1;
			КонецЦикла;				
		КонецЕсли;
		Выражение = ВрФормула + ВрВыражение;
		
	КонецЦикла; 

КонецПроцедуры

// Процедура заменет использованные в формуле строковые конструкции переданные в параметре СоответствиеЗамены
// СоответствиеЗамены - соответствие, в котором ключ - искомая конструкция, а значение - конструкция, на которую
// будет заменена искомая конструкция
Процедура ЗаменитьСоответсвия(Текст,СоответствиеЗамены) Экспорт
	НадоПреобразовывать = Ложь;
	Для Каждого ЭлМас Из СоответствиеЗамены Цикл
		Если Найти(ВРЕГ(Текст), ВРЕГ(ЭлМас.Ключ))>0 Тогда
			НадоПреобразовывать = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НадоПреобразовывать Тогда
		ВрФормула = "";
		Пока Истина Цикл
			МинПозиция = 1000000;
		    Для Каждого ЭлМас Из СоответствиеЗамены Цикл
				ТекПозиция = Найти(ВРЕГ(Текст), ВРЕГ(ЭлМас.Ключ));
				ТекПозиция = ?(ТекПозиция=0, 1000000,ТекПозиция);
				Если ТекПозиция < МинПозиция Тогда
					МинПозиция = ТекПозиция;
					ЭлементЗначение = ЭлМас.Значение;
					ЭлементКлюч = ЭлМас.Ключ;
				КонецЕсли;
			КонецЦикла;
						
			Позиция = МинПозиция;
			
			ВрФормула = ВрФормула + Лев(Текст, Позиция-1) + ЭлементЗначение;
			Текст = Сред(Текст, Позиция+СтрДлина(ЭлементКлюч));
			
			НадоПреобразовывать = Ложь;
			Для Каждого ЭлМас Из СоответствиеЗамены Цикл
				Если Найти(ВРЕГ(Текст), ВРЕГ(ЭлМас.Ключ))>0 Тогда
					НадоПреобразовывать = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ НадоПреобразовывать Тогда
				ВрФормула = ВрФормула + Текст;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Текст = ВрФормула;
	КонецЕсли;
КонецПроцедуры


// Процедура проверяет получение значений реквизитов имен, переданных в параметре в массиве 
//	Выражение - текст, предназначенный для замены обращений к реквизитам;
//  МассивИмен - массив, содержащий имена объектов ("Документ","СтрокаТаблицы","Объект") - замена через 2 точки
//("Документ.Контрагент.Код","СтрокаТаблицы.ОсновноеСредство.Организация.Код" и т.д.);
//	МассивИменЧерезОднуТочку - массив, содержащий имена объектов ("Объект","Документ" и т.д.) - если имя объекта 
//	присутствует в обеих массивах, то для будет замена реквизитов получаемых через 1 точку ("Объект.Код","Объект.Контрагент.Код" и тд).
// Все найденые обращения после второй(первой) точки заменяются на вызов серверной процедуры, возвращающей значение реквизита.
// 
Процедура ПроверитьПолучениеРеквизитовСсылок(Выражение,МассивИмен,МассивИменЧерезОднуТочку = Неопределено) Экспорт
	Если МассивИменЧерезОднуТочку = Неопределено Тогда
		МассивИменЧерезОднуТочку = Новый Массив;
	КонецЕсли;
	ТекФормула = Выражение;
	НадоПреобразовывать = Ложь;
	Для Каждого ЭлМас Из МассивИмен Цикл
		Если Найти(ВРЕГ(ТекФормула), ВРЕГ(ЭлМас)+".")>0 Тогда
			НадоПреобразовывать = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НадоПреобразовывать Тогда
		ВрФормула = "";
		//МассивПозиций = Новый Массив;	
		Пока Истина Цикл
			МинПозиция = 1000000;
		    Для Каждого ЭлМас Из МассивИмен Цикл
				ТекПозиция = Найти(ВРЕГ(ТекФормула), ВРЕГ(ЭлМас)+".");
				ТекПозиция = ?(ТекПозиция=0, 1000000,ТекПозиция);
				//МассивПозиций.Добавить(ТекПозиция);
				Если ТекПозиция < МинПозиция Тогда
					МинПозиция = ТекПозиция;
					ИндексЭлемента = МассивИмен.Найти(ЭлМас);
				КонецЕсли;
			КонецЦикла;
						
			Позиция = МинПозиция;
			
			ВрФормула = ВрФормула + Лев(ТекФормула, Позиция-1);
			ТекФормула = Сред(ТекФормула, Позиция);
			Если МассивИменЧерезОднуТочку.Найти(МассивИмен.Получить(ИндексЭлемента)) = Неопределено Тогда 
				НачСимвол = СтрДлина(МассивИмен.Получить(ИндексЭлемента))+2;
			Иначе
				НачСимвол = 1;
			КонецЕсли;
			ПерваяТочка=0;
			
			Для Сч=НачСимвол По СтрДлина(ТекФормула) Цикл
				ТекСимвол = Сред(ТекФормула, Сч, 1);
				Если	ТекСимвол = "," или
						ТекСимвол = ")" или
						ТекСимвол = " " или
						ТекСимвол = "-" или
						ТекСимвол = "+" или
						ТекСимвол = "=" или
						ТекСимвол = "/" или
						ТекСимвол = "*" или
						ТекСимвол = ">" или 
						ТекСимвол = "<" или
			 			ТекСимвол = "%" или
						ТекСимвол = Символы.ПС Тогда
					Прервать;
				КонецЕсли;
				Если ТекСимвол = "." Тогда
					ПерваяТочка = ?(ПерваяТочка=0, Сч, ПерваяТочка);
				КонецЕсли;
			КонецЦикла; 
			
			Если ПерваяТочка<>0 Тогда
				ТекРеквизит = Лев(ТекФормула, ПерваяТочка-1);
				ВрФормула = ВрФормула + 
							"БухгалтерскиеОперацииСервер.ЗначениеРеквизита(" +
							ТекРеквизит +
							", """+Сред(ТекФормула, ПерваяТочка+1, Сч - ПерваяТочка - 1) + """)";
			Иначе				
				ТекРеквизит = Лев(ТекФормула, Сч-1);
				ВрФормула = ВрФормула + ТекРеквизит;
			КонецЕсли;
			ТекФормула = Сред(ТекФормула, Сч);
			НадоПреобразовывать = Ложь;
			Для Каждого ЭлМас Из МассивИмен Цикл
				Если Найти(ВРЕГ(ТекФормула), ВРЕГ(ЭлМас)+".")>0 Тогда
					НадоПреобразовывать = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ НадоПреобразовывать Тогда
				ВрФормула = ВрФормула + ТекФормула;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Выражение = ВрФормула;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПолучениеПредопределенныхЭлементов(Выражение) Экспорт
	СтруктураИмен = Новый Структура;
	СтруктураИмен.Вставить(НРег("ПланыВидовХарактеристик"),"ПланВидовХарактеристик");
	СтруктураИмен.Вставить(НРег("Справочники"),"Справочник");
	СтруктураИмен.Вставить(НРег("Перечисления"),"Перечисление");
	СтруктураИмен.Вставить(НРег("ПланыСчетов"),"ПланСчетов");
	ТекФормула = Выражение;
	
	НадоПреобразовывать = Ложь;
	Для Каждого ЭлМас Из СтруктураИмен Цикл
		Если Найти(ВРЕГ(ТекФормула), ВРЕГ(ЭлМас.Ключ)+".")>0 Тогда
			НадоПреобразовывать = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НадоПреобразовывать Тогда
		ВрФормула = "";
		Пока Истина Цикл
			МинПозиция = 1000000;
		    Для Каждого ЭлМас Из СтруктураИмен Цикл
				ТекПозиция = Найти(ВРЕГ(ТекФормула), ВРЕГ(ЭлМас.Ключ)+".");
				ТекПозиция = ?(ТекПозиция=0, 1000000,ТекПозиция);
				Если ТекПозиция < МинПозиция Тогда
					МинПозиция = ТекПозиция;
				КонецЕсли;
			КонецЦикла;
						
			Позиция = МинПозиция;
			
			ВрФормула = ВрФормула + Лев(ТекФормула, Позиция-1);
			ТекФормула = Сред(ТекФормула, Позиция);
			НачСимвол = 1;
			ПерваяТочка=0;
			
			Для Сч=НачСимвол По СтрДлина(ТекФормула) Цикл
				ТекСимвол = Сред(ТекФормула, Сч, 1);
				Если	ТекСимвол = "," или
						ТекСимвол = ")" или
						ТекСимвол = " " или
						ТекСимвол = "-" или
						ТекСимвол = "+" или
						ТекСимвол = "=" или
						ТекСимвол = "/" или
						ТекСимвол = "*" или
						ТекСимвол = ">" или 
						ТекСимвол = "<" или
			 			ТекСимвол = "%" или
						ТекСимвол = Символы.ПС Тогда
					Прервать;
				КонецЕсли;
				Если ТекСимвол = "." Тогда
					ПерваяТочка = ?(ПерваяТочка=0, Сч, ПерваяТочка);
				КонецЕсли;
			КонецЦикла; 
			
			Если ПерваяТочка<>0 Тогда
				ТекРеквизит = Лев(ТекФормула, ПерваяТочка-1);
				ВрФормула = ВрФормула + 
							"Значение("+СтруктураИмен[НРег(ТекРеквизит)] +"."+Сред(ТекФормула, ПерваяТочка+1, Сч - ПерваяТочка - 1) + ")";
			Иначе				
				ТекРеквизит = Лев(ТекФормула, Сч-1);
				ВрФормула = ВрФормула + ТекРеквизит;
			КонецЕсли;
			ТекФормула = Сред(ТекФормула, Сч);
			НадоПреобразовывать = Ложь;
			Для Каждого ЭлМас Из СтруктураИмен Цикл
				Если Найти(ВРЕГ(ТекФормула), ВРЕГ(ЭлМас.Ключ)+".")>0 Тогда
					НадоПреобразовывать = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ НадоПреобразовывать Тогда
				ВрФормула = ВрФормула + ТекФормула;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Выражение = ВрФормула;
	КонецЕсли;

КонецПроцедуры

// Работа со схемой компоновки данных

// Процедура добавляет поле в НаборДанных. Реквизит "Поле" и путь к данным создаваемого поля формируется как Префикс+"."+ИмяПоля.
// Если Префикс не задан, то просто ИмяПоля.
// Если Тип(НаборДанных) = Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных"), то при формировании реквизита "Поле"
// используется "Префикс", иначе "Префикс2".
// Параметры
// НаборДанных -	НаборДанныхОбъектСхемыКомпоновкиДанных или
//					НаборДанныхОбъединениеСхемыКомпоновкиДанных - набор данных в который добавляются поля
// ИмяПоля - Строка - имя добавляемого поля
// Префикс - Строка
// Префикс2 - Строка
// ТипЗначения - ОписаниеТипов - если задан, то создаваемому полю устанавливается тип значения
//
Процедура ДобавитьПолеВНаборДанных(НаборДанных,знач ИмяПоля, Префикс, Префикс2="", ТипЗначения=Неопределено,БезИмениТЧ = Ложь) Экспорт

	Если НаборДанных.Поля.Найти(Префикс+?(ПустаяСтрока(Префикс),"",".")+ИмяПоля) = Неопределено Тогда
		НовПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Если Тип(НаборДанных) = Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных") Тогда
			НовПоле.Поле = Префикс+?(ПустаяСтрока(Префикс),"",".")+ИмяПоля;
		Иначе
			НовПоле.Поле = Префикс2 + ИмяПоля;
		КонецЕсли;
		Если БезИмениТЧ Тогда
			ИмяПоля = Сред(ИмяПоля,Найти(ИмяПоля,"_")+1);
		КонецЕсли;
		НовПоле.ПутьКДанным = Префикс+?(ПустаяСтрока(Префикс),"",".")+ИмяПоля;
		Если ЗначениеЗаполнено(ТипЗначения) Тогда
			НовПоле.ТипЗначения = ТипЗначения;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры // ДобавитьПолеВНаборДанных()

Функция ДобавитьПолеНабораДанныхСхемыКомпоновкиДанных(НаборДанных, Поле, ПутьКДанным = "", ДополнительныеПараметры = Неопределено) Экспорт
	
	НовПоле = НаборДанных.Поля.Найти(Поле);
	Если НовПоле = Неопределено Тогда
		НовПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовПоле.Поле = Поле;
	КонецЕсли;
	НовПоле.ПутьКДанным = ?(ПустаяСтрока(ПутьКДанным), Поле, ПутьКДанным);
	
	Если ДополнительныеПараметры = Неопределено Тогда
		Возврат НовПоле;
	КонецЕсли;
	
	ТипЗначения = Неопределено;
	ДоступныеЗначения = Неопределено;
	Если ДополнительныеПараметры.Свойство("ТипЗначения", ТипЗначения) Тогда
		НовПоле.ТипЗначения = ТипЗначения;
	КонецЕсли;
	Если ДополнительныеПараметры.Свойство("ДоступныеЗначения", ДоступныеЗначения) Тогда
		НовПоле.УстановитьДоступныеЗначения(ДоступныеЗначения);
	КонецЕсли;
	
	Возврат НовПоле;
	
КонецФункции

Процедура УстановитьЗначениеПараметраРедактированияПоляНабораДанных(Поле, ПараметрРедактирования, Значение, Использование = Истина) Экспорт
	
	Если ПараметрРедактирования = "СвязиПараметровВыбора" Тогда
		
		СвязьПараметровВыбора = Поле.ПараметрыРедактирования.Элементы.Найти("СвязиПараметровВыбора");
		СвязьПараметровВыбора.Использование = Использование;
		
		Связь = СвязьПараметровВыбора.Значение.Найти(Значение.Поле);
		Если Связь = Неопределено Тогда
			Связь = СвязьПараметровВыбора.Значение.Добавить();
			Связь.Поле = Новый ПолеКомпоновкиДанных(Значение.Поле);
		КонецЕсли;
		Если ЗначениеЗаполнено(Значение.Имя) Тогда
			Связь.Имя = Значение.Имя;
		КонецЕсли;
		Если ЗначениеЗаполнено(Значение.ИзменениеЗначения) Тогда
			Связь.ИзменениеЗначения = ?(Значение.ИзменениеЗначения = "Очищать", РежимИзмененияСвязанногоЗначения.Очищать, РежимИзмененияСвязанногоЗначения.НеИзменять);
		КонецЕсли;
		
	ИначеЕсли ПараметрРедактирования = "ПараметрыВыбора" Тогда
		
		ПараметрВыбора = Поле.ПараметрыРедактирования.Элементы.Найти("ПараметрыВыбора");
		ПараметрВыбора.Использование = Использование;
		
		Параметр = ПараметрВыбора.Значение.Найти(Значение.ИмяПараметра);
		Если Параметр = Неопределено Тогда
			Параметр = ПараметрВыбора.Значение.Добавить();
			Параметр.Имя = Значение.ИмяПараметра;
		КонецЕсли;
		Параметр.Значение = Значение.ЗначениеПараметра;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Добавить элемент отбора компоновки данных
//
// Параметры:
//  Коллекция		 - КоллекцияЭлементовОтбораКомпоновкиДанных	 -
//  ЛевоеЗначение	 - Строка	 - 
//  ВидСравнения	 - ВидСравненияКомпоновкиДанных	 - По умолчанию Равно
//  ПравоеЗначение	 - Произвольное	 - 
//  Использование	 - Булево	 - 
//  Идентификатор	 - Строка	 - 
//
Процедура ДобавитьЭлементОтбораКомпоновкиДанных(Коллекция, ЛевоеЗначение, ВидСравнения = Неопределено, ПравоеЗначение = Неопределено, Использование = Истина, Идентификатор = "") Экспорт
	
	НовЭлемент = Коллекция.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЛевоеЗначение);
	НовЭлемент.ВидСравнения = ?(ВидСравнения = Неопределено, ВидСравненияКомпоновкиДанных.Равно, ВидСравнения);
	Если ПравоеЗначение <> Неопределено Тогда
		Если ТипЗнч(ПравоеЗначение) = Тип("Массив") Тогда
			ВрПравЭлемент = Новый СписокЗначений;
			ВрПравЭлемент.ЗагрузитьЗначения(ПравоеЗначение);
			НовЭлемент.ПравоеЗначение = ВрПравЭлемент;
		Иначе
			НовЭлемент.ПравоеЗначение = ПравоеЗначение;
		КонецЕсли;
	КонецЕсли;
	НовЭлемент.Использование = Использование;
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		НовЭлемент.ИдентификаторПользовательскойНастройки = Идентификатор;
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьГруппуОтбораКомпоновкиДанных(Коллекция, Знач ТипГруппы) Экспорт

	Если ТипЗнч(ТипГруппы) = Тип("Строка") Тогда
		ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных[ТипГруппы];
	КонецЕсли;
	ГруппаОтбора = Коллекция.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппы;
	Возврат ГруппаОтбора;

КонецФункции // ДобавитьГруппуОтбораКомпоновкиДанных()

// Добавляет в коллекцию оформляемых полей компоновки данных новое поле
//
// Параметры:
//	КоллекцияОформляемыхПолей 	- коллекция оформляемых полей КД
//	ИмяПоля						- Строка - имя поля
//
// Возвращаемое значение:
//	ОформляемоеПолеКомпоновкиДанных - созданное поле
//
// Пример:
// 	Форма.УсловноеОформление.Элементы[0].Поля
//
Функция ДобавитьОформляемоеПоле(КоллекцияОформляемыхПолей, ИмяПоля) Экспорт
	
	ПолеЭлемента 		= КоллекцияОформляемыхПолей.Элементы.Добавить();
	ПолеЭлемента.Поле 	= Новый ПолеКомпоновкиДанных(ИмяПоля);

	Возврат ПолеЭлемента;
	
КонецФункции

// Копирует элементы отбора компоновки данных
// Параметры:
//	КоллекцияПриемник - ОтборКомпоновкиДанных
//	КоллекцияИсточник - ОтборКомпоновкиДанных
//
// Пример использования:
//	ОбщийМодульСКД.СкопироватьОтборНастроекКомпоновкиДанных(КомпоновщикНастроек.Настройки.Отбор, Список.Отбор);
//
Процедура СкопироватьОтборНастроекКомпоновкиДанных(КоллекцияПриемник, КоллекцияИсточник) Экспорт

	Для каждого ЭлементОтбора Из КоллекцияИсточник.Элементы Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			НоваяГруппа = КоллекцияПриемник.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НоваяГруппа, ЭлементОтбора);
			СкопироватьОтборНастроекКомпоновкиДанных(НоваяГруппа, ЭлементОтбора);
		Иначе
			НовыйЭлемент = КоллекцияПриемник.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ЭлементОтбора);
		КонецЕсли;
	
	КонецЦикла;
		
КонецПроцедуры // СкопироватьОтборСКД()

Процедура СкопироватьПараметрыНастроекКомпоновкиДанных(КоллекцияПриемник, КоллекцияИсточник) Экспорт

	Для каждого Параметр Из КоллекцияИсточник.Элементы Цикл
	
		НовыйПараметр = КоллекцияПриемник.Элементы.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйПараметр, Параметр);
	
	КонецЦикла; 

КонецПроцедуры // СкопироватьПараметрыСКД()

Процедура ЗаполнитьПараметрыНастроекКомпоновкиДанных(КоллекцияПриемник, КоллекцияИсточник) Экспорт
	
	Для каждого Параметр Из КоллекцияИсточник.Элементы Цикл
		
		КоллекцияПриемник.УстановитьЗначениеПараметра(Параметр.Параметр, Параметр.Значение);
		
		//НовыйПараметр = КоллекцияПриемник.Элементы.Добавить();
		//ЗаполнитьЗначенияСвойств(НовыйПараметр, Параметр);
	
	КонецЦикла; 
	
КонецПроцедуры

// Добавляет вычисляемое поле в СКД
//
Процедура ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновки, ПутьКДанным, Выражение, Заголовок = "") Экспорт
	ВычисляемоеПоле = СхемаКомпоновки.ВычисляемыеПоля.Найти(ПутьКДанным);
	Если ВычисляемоеПоле=Неопределено Тогда
		ВычисляемоеПоле = СхемаКомпоновки.ВычисляемыеПоля.Добавить();
		ВычисляемоеПоле.ПутьКДанным = ПутьКДанным;
		ВычисляемоеПоле.Выражение = Выражение;
		ВычисляемоеПоле.Заголовок = ?(ПустаяСтрока(Заголовок), ПутьКДанным, Заголовок);
	Иначе
		ВычисляемоеПоле.Выражение = "Выбор 
									|	Когда ЗначениеЗаполнено("+ВычисляемоеПоле.Выражение+") 
									|		Тогда "+ВычисляемоеПоле.Выражение+" 
									|	Иначе "+Выражение+" 
									|Конец";
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьПолеГруппировкиКомпоновкиДанных(Группировка, ИмяПоля) Экспорт
	ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
КонецПроцедуры

Процедура ДобавитьВыбранноеПолеКомпоновкиДанных(Выбор, ИмяПоля, Знач Тип = Неопределено, Использование = Истина, Заголовок = "", РежимОтображения = Неопределено, Родитель = Неопределено) Экспорт
	
	Если Тип = Неопределено Тогда
		Тип = Тип("ВыбранноеПолеКомпоновкиДанных");
	КонецЕсли;
	ВыбранноеПоле = Выбор.Элементы.Добавить(Тип);
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ВыбранноеПоле.Использование = Использование;
	Если НЕ ПустаяСтрока(Заголовок) Тогда
		ВыбранноеПоле.Заголовок = Заголовок;
	КонецЕсли;
	Если ЗначениеЗаполнено(РежимОтображения) Тогда
		ВыбранноеПоле.РежимОтображения = РежимОтображения;
	КонецЕсли;
	Если ЗначениеЗаполнено(Родитель) Тогда
		ВыбранноеПоле.Родитель = Родитель;
	КонецЕсли;
	
КонецПроцедуры

Функция ПреобразоватьВыражениеСКД(Знач ТекстВыражения, РазрешенныеОбщиеМодули=Неопределено, ЗаменяемыеСлова=Неопределено, ЗаменяющиеСлова = Неопределено, ИспользуемыеРеквизиты = Неопределено, Отказ = Ложь, ОписаниеОшибки = "") Экспорт
	
	ВыражениеРезультат = "";
	Если РазрешенныеОбщиеМодули = Неопределено Тогда
		РазрешенныеОбщиеМодули = Новый Массив;
	КонецЕсли;
	
	Если ИспользуемыеРеквизиты = Неопределено Тогда
		ИспользуемыеРеквизиты = Новый Массив;
	КонецЕсли;
	//РазрешенныеОбщиеМодули.Добавить(ВРЕГ("БиблиотекаФункцийОбмена")); 
	//РазрешенныеОбщиеМодули.Добавить(ВРЕГ("БухгалтерскиеОперации")); 
	
	Если ЗаменяемыеСлова=Неопределено Тогда
		ЗаменяемыеСлова = Новый Массив;
	КонецЕсли;
	//ЗаменяемыеСлова.Добавить(ВРЕГ("Значение"));
	
	Если ЗаменяющиеСлова=Неопределено Тогда
		ЗаменяющиеСлова = Новый Массив;
	КонецЕсли;
	//ЗаменяющиеСлова.Добавить("<ЗНАЧЕНИЕ>");
	
	НомерСимвола=0;
	ДлинаВыражения = СтрДлина(ТекстВыражения);
	
	ТекущееСлово = "";
	МассивСлов = Новый Массив;
	ОткрытыеКонструкции = Новый Массив; //1-Скобка, 2-кавычка, 3-одиночная кавычка
	КавычкаОткрыта = Ложь;
	СкобкаОткрыта = Ложь;
	РазборСлова = Ложь;
	ЕстьОператорВыбора = Ложь;
	
	Пока Истина Цикл
		НомерСимвола = НомерСимвола + 1;
		Если НомерСимвола > ДлинаВыражения Тогда
			Прервать;
		КонецЕсли;
		
		ТекущийСимвол = Сред(ТекстВыражения, НомерСимвола, 1);
		
		Если ТекущийСимвол = "?" Тогда
			// особый разбор. необходимо разобрать в "Выбор"
			ЕстьОператорВыбора = Истина;
		ИначеЕсли (ЭтоБуква(ТекущийСимвол) ИЛИ ТекущийСимвол = "_") И НЕ КавычкаОткрыта Тогда
			Если РазборСлова Тогда
				ТекущееСлово = ТекущееСлово + ТекущийСимвол;
			Иначе
				ТекущееСлово = ТекущийСимвол;
				РазборСлова = Истина;
			КонецЕсли;
			Продолжить;
		ИначеЕсли ТекущийСимвол = """" Тогда
			Если НЕ КавычкаОткрыта Тогда
				ОткрытыеКонструкции.Добавить("""");
				КавычкаОткрыта=Истина;
			Иначе
				Если ОткрытыеКонструкции[ОткрытыеКонструкции.ВГраница()] <> """" Тогда
					// ОШИБКА. ОЖИДАЕТСЯ "
					Отказ = Истина;
					ОписаниеОшибки = ВРег("ru='Синтаксическая ошибка. Ожидается """"(символ ""двойная кавычка"")'");
					Возврат ВыражениеРезультат;
				Иначе
					Если РазборСлова Тогда	
						ОбработатьКонецСлова(ТекущееСлово, МассивСлов, РазборСлова);
						ВывестиСлово(МассивСлов, ВыражениеРезультат, ИспользуемыеРеквизиты);
					КонецЕсли;
					ОткрытыеКонструкции.Удалить(ОткрытыеКонструкции.ВГраница());
					КавычкаОткрыта = Ложь;
				КонецЕсли;						
			КонецЕсли;						
		ИначеЕсли ТекущийСимвол = ")" Тогда
			
			Если ОткрытыеКонструкции[ОткрытыеКонструкции.ВГраница()] <> "("	Тогда
				// ОШИБКА. ОЖИДАЕТСЯ ")"
				Отказ = Истина;
				ОписаниеОшибки = НСтр("ru='Синтаксическая ошибка. Ожидается "")""(символ ""закрывающая скобка"")'");
				Возврат ВыражениеРезультат;
			Иначе
				ОткрытыеКонструкции.Удалить(ОткрытыеКонструкции.ВГраница());
			КонецЕсли;
			Если РазборСлова Тогда	
				МассивСлов.Добавить(ТекущееСлово);
				Если МассивСлов.Количество()=1 Тогда
					ПозицияЗаменяемогоСлова = ЗаменяемыеСлова.Найти(ВРег(ТекущееСлово)); 	
					Если ПозицияЗаменяемогоСлова<>Неопределено Тогда
						ТекущееСлово = ЗаменяющиеСлова[ПозицияЗаменяемогоСлова];
					КонецЕсли;
					ВыражениеРезультат = ВыражениеРезультат + ТекущееСлово;
				Иначе
					ВывестиСлово(МассивСлов, ВыражениеРезультат, ИспользуемыеРеквизиты);
				КонецЕслИ;
				МассивСлов.Очистить();
				ТекущееСлово="";
				РазборСлова=Ложь;
			КонецЕсли;
		ИначеЕсли ТекущийСимвол = "="
			ИЛИ ТекущийСимвол = "+"
			ИЛИ ТекущийСимвол = ">"
			ИЛИ ТекущийСимвол = "<"
			ИЛИ ТекущийСимвол = "%"
			ИЛИ ТекущийСимвол = "/"
			ИЛИ ТекущийСимвол = "-"
			ИЛИ ТекущийСимвол = "*"
			ИЛИ ТекущийСимвол = " "
			ИЛИ ТекущийСимвол = Символы.Таб
			ИЛИ ТекущийСимвол = Символы.ВК
			ИЛИ ТекущийСимвол = Символы.НПП
			ИЛИ ТекущийСимвол = Символы.ПФ
			ИЛИ ТекущийСимвол = Символы.ПС 
			ИЛИ ТекущийСимвол = "," Тогда
			Если НЕ КавычкаОткрыта Тогда
				Если РазборСлова Тогда	
					МассивСлов.Добавить(ТекущееСлово);
					Если МассивСлов.Количество()=1 Тогда
						ПозицияЗаменяемогоСлова = ЗаменяемыеСлова.Найти(ВРег(ТекущееСлово)); 	
						Если ПозицияЗаменяемогоСлова<>Неопределено Тогда
							ТекущееСлово = ЗаменяющиеСлова[ПозицияЗаменяемогоСлова];
						КонецЕсли;
						ВыражениеРезультат = ВыражениеРезультат + ТекущееСлово;
					Иначе
						ВывестиСлово(МассивСлов, ВыражениеРезультат, ИспользуемыеРеквизиты);
					КонецЕслИ;
					МассивСлов.Очистить();
					ТекущееСлово="";
					РазборСлова=Ложь;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТекущийСимвол = "(" Тогда
			ОткрытыеКонструкции.Добавить("(");
			Если РазборСлова Тогда	
				ОбработатьКонецСлова(ТекущееСлово, МассивСлов, РазборСлова);
				ОбработатьНачалоФункции(МассивСлов, ВыражениеРезультат, РазрешенныеОбщиеМодули, Отказ, ОписаниеОшибки);
				Если Отказ Тогда
					Возврат ВыражениеРезультат;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ТекущийСимвол = "." Тогда
			Если РазборСлова Тогда
				ОбработатьКонецСлова(ТекущееСлово, МассивСлов, РазборСлова);
				Продолжить;
			КонецЕсли;
		ИначеЕсли ЭтоЦифра(ТекущийСимвол) И НЕ КавычкаОткрыта Тогда
			Если РазборСлова Тогда
				ТекущееСлово = ТекущееСлово + ТекущийСимвол;
				Продолжить;
			Иначе
				
			КонецЕсли;
			
			
		КонецЕсли;
			
		ВыражениеРезультат = ВыражениеРезультат + ТекущийСимвол;
	КонецЦикла;
	Если РазборСлова Тогда
		ОбработатьКонецСлова(ТекущееСлово, МассивСлов, РазборСлова);
		Если МассивСлов.Количество()=1 Тогда
			ПозицияЗаменяемогоСлова = ЗаменяемыеСлова.Найти(ВРег(МассивСлов[0])); 	
			Если ПозицияЗаменяемогоСлова<>Неопределено Тогда
				ВыражениеРезультат = ВыражениеРезультат + ЗаменяющиеСлова[ПозицияЗаменяемогоСлова];
			Иначе
				ВыражениеРезультат = ВыражениеРезультат + МассивСлов[0];	
			КонецЕсли;
		Иначе
			ВывестиСлово(МассивСлов, ВыражениеРезультат, ИспользуемыеРеквизиты);
		КонецЕслИ;
	КонецЕсли;	
	
	Если ЕстьОператорВыбора Тогда
		ЗаменитьУсловныйОператор(ВыражениеРезультат);
	КонецЕсли;
	
	// Отсортируем массив использованных реквизитов по убыванию количества точек
	// Для того чтобы при замене на параметры не подменить случайно часть параметра
	// замена производится от максимального количества точек к минимальному
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("Строка"));
	ТаблицаЗначений.Колонки.Добавить("КоличествоТочек", Новый ОписаниеТипов("Число"));
	Для Каждого ТекРеквизит Из ИспользуемыеРеквизиты Цикл
		НовСтр = ТаблицаЗначений.Добавить();
		НовСтр.Реквизит = ТекРеквизит;
		НовСтр.КоличествоТочек = СтрЧислоВхождений(ТекРеквизит, ".");
	КонецЦикла;
	ТаблицаЗначений.Свернуть("Реквизит,КоличествоТочек");
	ТаблицаЗначений.Сортировать("КоличествоТочек убыв");
	ИспользуемыеРеквизиты = ТаблицаЗначений.ВыгрузитьКолонку("Реквизит");
	
	Возврат ВыражениеРезультат;
	
КонецФункции

Функция СхемаКомпоновкиДанныхИзДинамическогоСписка(ДинамическийСписок, ТаблицаФормы) Экспорт

	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	Источник = СхемаКомпоновки.ИсточникиДанных.Добавить();
	Источник.Имя = "Источник1";
	Источник.ТипИсточникаДанных = "Local";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "НаборДанных1";
	НаборДанных.ИсточникДанных = "Источник1";
	НаборДанных.Запрос = ДинамическийСписок.ТекстЗапроса;
	
	Настройки = СхемаКомпоновки.НастройкиПоУмолчанию;
	
	СкопироватьПараметрыНастроекКомпоновкиДанных(Настройки.ПараметрыДанных,	ДинамическийСписок.Параметры);
	СкопироватьОтборНастроекКомпоновкиДанных(Настройки.Отбор,				ДинамическийСписок.Отбор);
	
	НовоеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	НовоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОсновноеСредство");
	Для каждого ПодчиненныйЭлемент Из ТаблицаФормы.ПодчиненныеЭлементы Цикл
	
		Если ПодчиненныйЭлемент.Видимость = Истина Тогда
			
			ЧастиИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПодчиненныйЭлемент.ПутьКДанным, ".");
			Если ЧастиИмени.Количество() = 2 Тогда
				НовоеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
				НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(ЧастиИмени[1]);
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла; 
	
    ЭлементыГруппировки = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ЭлементыГруппировки.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	
	Возврат СхемаКомпоновки;

КонецФункции // СхемаКомпоновкиДанныхИзДинамическогоСписка()

Функция СпециальныйСимвол(Литерал) Экспорт
	
	Возврат Символы[Литерал];
	
КонецФункции	

Функция ЗаменитьПараметром(Выражение,МассивИмен,СхемаКомпоновки) Экспорт
	
	ТекФормула = Выражение;
	НадоПреобразовывать = Ложь;
	Для Каждого ЭлМас Из МассивИмен Цикл
		ПозЭл = Найти(ВРЕГ(ТекФормула), ВРЕГ(ЭлМас));
		ПозЭлСТочкой = Найти(ВРЕГ(ТекФормула), "."+ВРЕГ(ЭлМас));
		ПозЭлСКавычкой = Найти(ВРЕГ(ТекФормула), """"+ВРЕГ(ЭлМас));
		Если ПозЭл>0 И (ПозЭлСТочкой + 1 <>ПозЭл ИЛИ ПозЭлСТочкой = 0) И (ПозЭлСКавычкой + 1 <>ПозЭл ИЛИ ПозЭлСКавычкой = 0)  Тогда
			НадоПреобразовывать = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НадоПреобразовывать Тогда
		ВрФормула = "";
		//МассивПозиций = Новый Массив;	
		Пока Истина Цикл
			МинПозиция = 1000000;
		    Для Каждого ЭлМас Из МассивИмен Цикл
				ТекПозиция = Найти(ВРЕГ(ТекФормула), ВРЕГ(ЭлМас));
				ТекПозиция = ?(ТекПозиция=0, 1000000,ТекПозиция);
				//МассивПозиций.Добавить(ТекПозиция);
				Если ТекПозиция < МинПозиция Тогда
					МинПозиция = ТекПозиция;
					ИндексЭлемента = МассивИмен.Найти(ЭлМас);
				КонецЕсли;
			КонецЦикла;
			Если МинПозиция <> 1 И МинПозиция <> 1000000 Тогда
				Если Сред(ТекФормула, МинПозиция - 1, 1) = "." Тогда
					ВрФормула = ВрФормула + Лев(ТекФормула, МинПозиция + СтрДлина(ЭлМас));
					ТекФормула = Сред(ТекФормула, МинПозиция + СтрДлина(ЭлМас)+1);
               		Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Позиция = МинПозиция;
			
			ВрФормула = ВрФормула + Лев(ТекФормула, Позиция-1);
			ТекФормула = Сред(ТекФормула, Позиция);
			НачСимвол = 1;
			ПерваяТочка=0;
			
			Для Сч=НачСимвол По СтрДлина(ТекФормула) Цикл
				ТекСимвол = Сред(ТекФормула, Сч, 1);
				Если	ТекСимвол = "," или
						ТекСимвол = ")" или
						ТекСимвол = "=" или
						ТекСимвол = " " или
						ТекСимвол = "-" или
						ТекСимвол = "+" или
						ТекСимвол = "/" или
						ТекСимвол = "*" или
						ТекСимвол = ">" или 
						ТекСимвол = "<" или
			 			ТекСимвол = "%" или
						ТекСимвол = Символы.ПС Тогда
					Прервать;
				КонецЕсли;
				Если ТекСимвол = "." Тогда
					ПерваяТочка = ?(ПерваяТочка=0, Сч, ПерваяТочка);
				КонецЕсли;
			КонецЦикла; 
			
			Если ПерваяТочка<>0 Тогда
				Если МассивИмен.Получить(ИндексЭлемента) = "ДопПараметр" Тогда
					ИмяПараметра = Сред(ТекФормула, ПерваяТочка+1, Сч - ПерваяТочка - 1);
					ВрФормула = ВрФормула +"&"+ ИмяПараметра;
					Если СхемаКомпоновки.Параметры.Найти(ИмяПараметра)=Неопределено Тогда
						НовПараметр = СхемаКомпоновки.Параметры.Добавить();
						НовПараметр.Имя = ИмяПараметра;
						НовПараметр.ОграничениеИспользования = Истина;
					КонецЕсли;
				Иначе
					ТекРеквизит = Лев(ТекФормула, ПерваяТочка-1);
					ВрФормула = ВрФормула + 
								"БухгалтерскиеОперацииСервер.ЗначениеРеквизита(&" +
								ТекРеквизит +
								", """+Сред(ТекФормула, ПерваяТочка+1, Сч - ПерваяТочка - 1) + """)";
				КонецЕсли;
			Иначе				
				ТекРеквизит = МассивИмен.Получить(ИндексЭлемента);
				ДлинаРеквизита = СтрДлина(ТекРеквизит);
				ВрФормула = ВрФормула +"&"+ ТекРеквизит+Сред(ТекФормула,ДлинаРеквизита+1, Сч-1-ДлинаРеквизита);
			КонецЕсли;
			ТекФормула = Сред(ТекФормула, Сч);
			НадоПреобразовывать = Ложь;
			Для Каждого ЭлМас Из МассивИмен Цикл
				ПозЭл = Найти(ВРЕГ(ТекФормула), ВРЕГ(ЭлМас));
				ПозЭлСТочкой = Найти(ВРЕГ(ТекФормула), "."+ВРЕГ(ЭлМас));
				ПозЭлСКавычкой = Найти(ВРЕГ(ТекФормула), """"+ВРЕГ(ЭлМас));
				Если ПозЭл>0 И (ПозЭлСТочкой + 1 <> ПозЭл ИЛИ ПозЭлСТочкой = 0) И (ПозЭлСКавычкой + 1 <> ПозЭл ИЛИ ПозЭлСКавычкой = 0) Тогда
					НадоПреобразовывать = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ НадоПреобразовывать Тогда
				ВрФормула = ВрФормула + ТекФормула;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Выражение = ВрФормула;
	КонецЕсли;
	Возврат Выражение;
	
КонецФункции

Процедура ДополнитьОтборНастроекКД(НовыеНастройкиКДОтборЭлементы, НовыеПользовательскиеНастройкиКДЭлементы) Экспорт
	
	Для Каждого ЭлементОтбора Из НовыеНастройкиКДОтборЭлементы Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ДополнитьОтборНастроекКД(ЭлементОтбора.Элементы, НовыеПользовательскиеНастройкиКДЭлементы);
		Иначе
			ЭлементПользовательскихНастроек = НовыеПользовательскиеНастройкиКДЭлементы.Найти(ЭлементОтбора.ИдентификаторПользовательскойНастройки);
			Если ТипЗнч(ЭлементПользовательскихНастроек) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда 
				ЭлементОтбора.ПравоеЗначение = ЭлементПользовательскихНастроек.ПравоеЗначение;
				ЭлементОтбора.Использование =  ЭлементПользовательскихНастроек.Использование;
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЦикла	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьКонецСлова(ТекущееСлово, МассивСлов, РазборСлова, РазрешенныеОбщиеМодули = Неопределено, ЗаменяемыеСлова = Неопределено, ЗаменяющиеСлова = Неопределено)
	МассивСлов.Добавить(ТекущееСлово);
	ТекущееСлово="";
	РазборСлова=Ложь;
КонецПроцедуры

Процедура ВывестиСлово(МассивСлов, ТекстРезультат, ИспользуемыеРеквизы)

	СформированноеСлово="";
	Если МассивСлов.Количество() = 3 Тогда
		// проверим вывод предопределенных значений
		Если ВРЕГ(МассивСлов[0]) = "ПЕРЕЧИСЛЕНИЯ" Тогда
			ТекстРезультат = ТекстРезультат+"Значение(Перечисление."+МассивСлов[1]+"."+МассивСлов[2]+")";
			Возврат;
		ИначеЕсли ВРЕГ(МассивСлов[0]) = "СПРАВОЧНИКИ" Тогда
			ТекстРезультат = ТекстРезультат+"Значение(Справочник."+МассивСлов[1]+"."+МассивСлов[2]+")";
			Возврат;
		КонецЕсли;
	КонецЕсли;
		
	Для Счетчик = 0 По МассивСлов.ВГраница() Цикл
		Если Счетчик>0 Тогда
			СформированноеСлово = СформированноеСлово + ".";
		КонецЕсли;
	    СформированноеСлово = СформированноеСлово + МассивСлов[Счетчик];
	КонецЦикла;
	ТекстРезультат = ТекстРезультат + СформированноеСлово;
	Если МассивСлов.Количество()>1 Тогда
		ИспользуемыеРеквизы.Добавить(СформированноеСлово);
	КонецЕсли;
	МассивСлов.Очистить();
	

КонецПроцедуры // ВывестиСлово()

Процедура ОбработатьНачалоФункции(МассивСлов, ТекстРезультат, РазрешенныеОбщиеМодули, Отказ, ОписаниеОшибки)

	Если МассивСлов.Количество() = 1 Тогда // встроенная функция . нельзя исполнять функции 
		Если ВРЕГ(МассивСлов[0]) = "ВЫПОЛНИТЬ" Тогда
			Отказ = Истина;
			ОписаниеОшибки = НСтр("ru='Запрещено использовать функцию ""Выполнить"" в выражениях'");
			ТекстРезультат = ТекстРезультат + МассивСлов[0];
			Возврат;
		КонецЕсли;
	ИначеЕсли МассивСлов.Количество() = 2 И РазрешенныеОбщиеМодули.Найти(ВРег(МассивСлов[0])) = Неопределено Тогда
		// НЕРАЗРЕШЕННЫЙ ОБЩИЙ МОДУЛЬ
		Отказ = Истина;
		ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НСтр("ru='Использование общего модуля [ИмяМодуля] запрещено'"), Новый Структура("ИмяМодуля",МассивСлов[0]));
		ВывестиСлово(МассивСлов, ТекстРезультат, Новый Массив);
		Возврат;
	Иначе	
	КонецЕсли;
	
	Для Счетчик = 0 По МассивСлов.ВГраница() Цикл
		Если Счетчик>0 Тогда
			ТекстРезультат = ТекстРезультат + ".";
		КонецЕсли;
	    ТекстРезультат = ТекстРезультат + МассивСлов[Счетчик];
	КонецЦикла;
	МассивСлов.Очистить();

КонецПроцедуры // ОбработатьНачалоФункции()

