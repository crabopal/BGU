
#Область ПрограммныйИнтерфейс

// Возвращает базу распределения для данного вида общих затрат, ИФО и КФО
// Параметры:
//  МетодыРаспределенияКосвенныхЗатрат - см. ТаблицаЗначений
//  ВидОбщихЗатрат - ПеречислениеСсылка.ВидыОбщихЗатратНаПроизводство
//  ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//  КФО - ПеречислениеСсылка.КВД
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.БазыРаспределенияКосвенныхЗатрат
//
Функция БазаРаспределенияОбщихЗатрат(МетодыРаспределенияКосвенныхЗатрат, ВидОбщихЗатрат, ИФО, КФО) Экспорт
	
	ПараметрыРаспределения = ПараметрыБазыРаспределенияОбщихЗатрат(МетодыРаспределенияКосвенныхЗатрат,
		ВидОбщихЗатрат, ИФО, КФО);
		
	Если ПараметрыРаспределения <> Неопределено Тогда
		Возврат ПараметрыРаспределения.БазаРаспределения;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает базу распределения для данного вида общих затрат, ИФО и КФО
// Параметры:
//  МетодыРаспределенияКосвенныхЗатрат - см. ТаблицаЗначений
//  ВидОбщихЗатрат - ПеречислениеСсылка.ВидыОбщихЗатратНаПроизводство
//  ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//  КФО - ПеречислениеСсылка.КВД
// 
// Возвращаемое значение:
//  СтрокаТаблицыЗначений
//
Функция ПараметрыБазыРаспределенияОбщихЗатрат(МетодыРаспределенияКосвенныхЗатрат, ВидОбщихЗатрат, ИФО, КФО) Экспорт

	Отбор = Новый Структура("ВидОбщихЗатрат, ИФО, КФО", ВидОбщихЗатрат, ИФО, КФО);
	МассивСтрок = МетодыРаспределенияКосвенныхЗатрат.НайтиСтроки(Отбор);
	
	Если МассивСтрок.Количество() = 1 Тогда
		Возврат МассивСтрок[0];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИФО) Тогда
		
		Отбор.ИФО = ПредопределенноеЗначение("Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка");
		МассивСтрок = МетодыРаспределенияКосвенныхЗатрат.НайтиСтроки(Отбор);
		
		Если МассивСтрок.Количество() = 1 Тогда
			Возврат МассивСтрок[0];
		КонецЕсли;
		
	КонецЕсли;
	
	Отбор = Новый Структура("ВидОбщихЗатрат, ОсновнаяБаза", ВидОбщихЗатрат, Истина);
	МассивСтрок = МетодыРаспределенияКосвенныхЗатрат.НайтиСтроки(Отбор);
	
	Если МассивСтрок.Количество() = 1 Тогда
		Возврат МассивСтрок[0];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СтрокаБазыРаспределенияОбщихЗатрат(МетодыРаспределенияКосвенныхЗатрат, ВидОбщихЗатрат, ИФО, КФО, БазаРаспределения) Экспорт

	Отбор = Новый Структура("ВидОбщихЗатрат, ИФО, КФО, БазаРаспределения", ВидОбщихЗатрат, ИФО, КФО, БазаРаспределения);
	МассивСтрок = МетодыРаспределенияКосвенныхЗатрат.НайтиСтроки(Отбор);
	
	Если МассивСтрок.Количество() = 1 Тогда
		Возврат МассивСтрок[0];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИФО) Тогда
		
		Отбор.ИФО = ПредопределенноеЗначение("Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка");
		МассивСтрок = МетодыРаспределенияКосвенныхЗатрат.НайтиСтроки(Отбор);
		
		Если МассивСтрок.Количество() = 1 Тогда
			Возврат МассивСтрок[0];
		КонецЕсли;
		
	КонецЕсли;
	
	Отбор = Новый Структура("ВидОбщихЗатрат, ОсновнаяБаза, БазаРаспределения", ВидОбщихЗатрат, Истина, БазаРаспределения);
	МассивСтрок = МетодыРаспределенияКосвенныхЗатрат.НайтиСтроки(Отбор);
	
	Если МассивСтрок.Количество() = 1 Тогда
		Возврат МассивСтрок[0];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СчетСписанияПроизводственныхРасходовНУ(СчетУчетаРасходов, ВидРасходовНУ) Экспорт
	
	Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетУчетаРасходов, "Н20.01,Н25.01,Н26.01,Н20.11,Н25.11,Н26.11") Тогда
		
		Возврат БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("Н90.03");
			// Стоимость реализованных товаров, работ, услуг собственного производства.
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетУчетаРасходов, "Н44")
		И ВидРасходовНУ = ПредопределенноеЗначение("Перечисление.ВидыРасходовНУ.ТранспортныеРасходы") Тогда
		
		Возврат БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("Н90.05"); // Транспортные расходы.
		
	Иначе
		Возврат БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("Н90.06"); // Косвенные расходы.
	КонецЕсли;
	
КонецФункции

