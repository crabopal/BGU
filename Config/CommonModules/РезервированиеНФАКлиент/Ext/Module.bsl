// @strict-types


#Область ПрограммныйИнтерфейс

// При изменении переключателя резервирования.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * ПереключательРезервирование - Число
//  Объект - ДанныеФормыСтруктура:
//   * Резервировать - Булево
Процедура ПриИзмененииПереключателяРезервирования(Форма, Объект) Экспорт
	Объект.Резервировать = Булево(Форма.ПереключательРезервирование);
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// При изменении флажка "Аннулировано".
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктура:
//    ** Проведен - Булево
//    ** Аннулирован - Булево
//  ОповещениеПослеУстановкиФлажка - ОписаниеОповещения
Процедура ПриИзмененииФлажкаАннулирован(Форма, ОповещениеПослеУстановкиФлажка = Неопределено) Экспорт
	Объект = Форма.Объект;
	
	Если Не Объект.Аннулирован Тогда
		Если ОповещениеПослеУстановкиФлажка <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОповещениеПослеУстановкиФлажка, Неопределено);
		КонецЕсли;	
		Возврат;
	КонецЕсли;
	
	Если Объект.Проведен Тогда
		Объект.Аннулирован = Ложь;
		ПоказатьПредупреждение(, НСтр("ru = 'Перед аннулированием документа необходимо отменить проведение'"));
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Аннулированный документ нельзя будет провести.
		|Продолжить?'");
	ДополнительныеПараметры = Новый Структура("Форма, ОповещениеПослеУстановкиФлажка",
		Форма, ОповещениеПослеУстановкиФлажка);
	
	ОбработкаОтвета = Новый ОписаниеОповещения("ПослеВопросаПриУстановкеФлажкаАннулирован",
		ЭтотОбъект,
		ДополнительныеПараметры);
	ПоказатьВопрос(ОбработкаОтвета, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// После вопроса при установке флажка "Аннулировано".
// 
// Параметры:
//  Ответ - КодВозвратаДиалога
//  ДополнительныеПараметры - Структура:
//   * Форма - ФормаКлиентскогоПриложения:
//     ** Объект - ДанныеФормыСтруктура:
//       *** Проведен - Булево
//       *** Аннулирован - Булево
//   * ОповещениеПослеУстановкиФлажка - ОписаниеОповещения
Процедура ПослеВопросаПриУстановкеФлажкаАннулирован(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Форма = ДополнительныеПараметры.Форма;
		Форма.Объект.Аннулирован = Ложь;
	Иначе
		Если ДополнительныеПараметры.ОповещениеПослеУстановкиФлажка <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеПослеУстановкиФлажка, Неопределено);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
