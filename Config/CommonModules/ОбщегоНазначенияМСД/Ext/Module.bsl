
#Область ПрограммныйИнтерфейс 

// Выгружает пакет XDTO в файл.
//
// Параметры:
//  ПространствоИмен - 	Строка
//  ПутьКФайлу		 - 	Строка
//
Процедура ВыгрузитьПакетXDTO(ПространствоИмен, ПутьКФайлу) Экспорт
	
	НаборСхем = ФабрикаXDTO.ЭкспортСхемыXML(ПространствоИмен);
	
	СхемаXML = НаборСхем.Получить(0);
	
	СхемаXML.ОбновитьЭлементDOM();
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ПутьКФайлу);
	
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(СхемаXML.ДокументDOM, ЗаписьXML);
	
	ЗаписьXML.Закрыть();
	
КонецПроцедуры

// Функция производит поиск элемент справочника ПериодыМСД.
//
// Параметры:
//  Периодичность	 - 	ПеречислениеСсылка.ПериодичностьМСД - Тип периода
//  ДатаНачала		 - 	Дата - Дата начала периода
//  ДатаОкончания	 - 	Дата - Дата окончания периода
// 
// Возвращаемое значение:
//  СправочникСсылка.ПериодыМСД - Ссылка на найденный или созданный период
//
Функция НайтиОтчетныйПериод(Периодичность, ДатаНачала, ДатаОкончания = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ПериодыМСД.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПериодыМСД КАК ПериодыМСД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСрокахПредоставленияДанныхМСД КАК СведенияОСрокахПредоставленияДанныхМСД
	|		ПО ПериодыМСД.Ссылка = СведенияОСрокахПредоставленияДанныхМСД.ПериодДанных
	|ГДЕ
	|	ПериодыМСД.ДатаНачала = &ДатаНачала
	|	И &ОтборДатаОкончания
	|	И &ОтборПериодичность
	|	И СведенияОСрокахПредоставленияДанныхМСД.Срок <> ДАТАВРЕМЯ(1, 1, 1)";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("Периодичность", Периодичность);
	
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		Запрос.УстановитьПараметр("ДатаОкончания", НачалоДня(ДатаОкончания));
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборДатаОкончания", "ПериодыМСД.ДатаОкончания = &ДатаОкончания");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборДатаОкончания", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Периодичность) Тогда
		Запрос.УстановитьПараметр("Периодичность", Периодичность);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПериодичность", ?(ТипЗнч(Периодичность) = Тип("ПеречислениеСсылка.ПериодичностьМСД"), "ПериодыМСД.Периодичность = &Периодичность","ПериодыМСД.Периодичность В (&Периодичность)"));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПериодичность", "ИСТИНА");
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru='Не найден утвержденный период: Периодичность %1; ДатаНачала %2; ДатаОкончания %3'"), Периодичность, ДатаНачала, ?(ЗначениеЗаполнено(ДатаОкончания), ДатаОкончания, НСтр("ru='Не задан'")));
		ЗаписьЖурналаРегистрации(НСтр("ru='ОтчетныеПериодыМСД.ПоискОтчетногоПериода'", ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Информация,,, ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
КонецФункции

// Функция производит поиск элемент справочника Периоды.
//
// Параметры:
//  Дата - 	Дата - Дата, на которую нужно получить версию
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//  	* Версия  			- 	Строка
//  	* ДатаУтверждения   - 	Строка
//
Функция ТекущаяВерсияТаксономии(Дата = Неопределено, Организация) Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	СтатусыВерсийЕФСрезПоследних.Версия КАК Версия,
	                      |	СтатусыВерсийЕФСрезПоследних.ДатаУтверждения КАК ДатаУтверждения,
	                      |	СтатусыВерсийЕФСрезПоследних.Период КАК Период
	                      |ИЗ
	                      |	РегистрСведений.СтатусыВерсийЕФ.СрезПоследних(
	                      |			&Дата,
	                      |			Организация = &Организация
	                      |				И Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВерсийЕФ.Утвержден)
	                      |				И &Дата <= ВЫБОР
	                      |					КОГДА ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	                      |						ТОГДА ДАТАВРЕМЯ(3999, 12, 31, 23, 59, 59)
	                      |					ИНАЧЕ ДатаОкончания
	                      |				КОНЕЦ) КАК СтатусыВерсийЕФСрезПоследних
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	СтатусыВерсийЕФСрезПоследних.Период УБЫВ
	                      |ИТОГИ ПО
	                      |	Период");    
	
	Запрос.УстановитьПараметр("Дата", Дата); 
	Запрос.УстановитьПараметр("Организация", Организация); 
	КодПоРПБС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "КодПоРПБС");

	ВыборкаПериод = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Если ВыборкаПериод.Следующий() Тогда
		
		Выборка = ВыборкаПериод.Выбрать();
		ТаблицаВерсии = Новый ТаблицаЗначений;
		ТаблицаВерсии.Колонки.Добавить("Версия");
		ТаблицаВерсии.Колонки.Добавить("ДатаУтверждения"); 
		ТаблицаВерсии.Колонки.Добавить("Период");
		ТаблицаВерсии.Колонки.Добавить("Вес"); 
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаВерсии.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);			
			МассивВерсия = СтрРазделить(НоваяСтрока.Версия, ".");
			КоличествоВерсия = МассивВерсия.Количество();
			Если КоличествоВерсия Тогда
				Если КоличествоВерсия = 5 Тогда
					Если МассивВерсия[3] = СокрЛП(КодПоРПБС) Тогда
						НоваяСтрока.Вес = 3;	
					Иначе
						НоваяСтрока.Вес = 2;
					КонецЕсли;	
				Иначе
					НоваяСтрока.Вес = 1;	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
		
		ТаблицаВерсии.Сортировать("Вес УБЫВ");
		
		Для каждого СтрокаТаблицы Из ТаблицаВерсии Цикл
			Возврат Новый Структура("Версия, ДатаУтверждения, Период", СтрокаТаблицы.Версия, СтрокаТаблицы.ДатаУтверждения, СтрокаТаблицы.Период);	
		КонецЦикла;	
	КонецЕсли;
	
КонецФункции

// Определяет следующие свойств регламентных заданий:
//  - зависимость от функциональных опций.
//  - возможность выполнения в различных режимах работы программы.
//  - прочие параметры.
//
// Параметры:
//  Настройки - ТаблицаЗначений - таблица значений с колонками:
//    * РегламентноеЗадание - ОбъектМетаданных:РегламентноеЗадание - регламентное задание.
//    * ФункциональнаяОпция - ОбъектМетаданных:ФункциональнаяОпция - функциональная опция,
//        от которой зависит регламентное задание.
//    * ЗависимостьПоИ      - Булево - если регламентное задание зависит более, чем
//        от одной функциональной опции и его необходимо включать только тогда,
//        когда все функциональные опции включены, то следует указывать Истина
//        для каждой зависимости.
//        По умолчанию Ложь - если хотя бы одна функциональная опция включена,
//        то регламентное задание тоже включено.
//    * ВключатьПриВключенииФункциональнойОпции - Булево, Неопределено - если Ложь, то при
//        включении функциональной опции регламентное задание не будет включаться. Значение
//        Неопределено соответствует значению Истина.
//        По умолчанию - неопределено.
//    * ДоступноВПодчиненномУзлеРИБ - Булево, Неопределено - Истина или Неопределено, если регламентное
//        задание доступно в РИБ.
//        По умолчанию - неопределено.
//    * ДоступноВАвтономномРабочемМесте - Булево, Неопределено - Истина или Неопределено, если регламентное
//        задание доступно в автономном рабочем месте.
//        По умолчанию - неопределено.
//    * ДоступноВМоделиСервиса      - Булево, Неопределено - Истина или Неопределено, если регламентное
//        задание доступно в модели сервиса.
//        По умолчанию - неопределено.
//    * РаботаетСВнешнимиРесурсами  - Булево - Истина, если регламентное задание модифицирует данные
//        во внешних источниках (получение почты, синхронизация данных и т.п.).
//        По умолчанию - Ложь.
//    * Параметризуется             - Булево - Истина, если регламентное задание параметризованное.
//        По умолчанию - Ложь.
//
// Например:
//	Настройка = Настройки.Добавить();
//	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.ОбновлениеСтатусовДоставкиSMS;
//	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.ИспользоватьПочтовыйКлиент;
//	Настройка.ДоступноВМоделиСервиса = Ложь;
//
Процедура ПриОпределенииНастроекРегламентныхЗаданий(Настройки) Экспорт
	
	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.ОтправкаПакетаВМСД;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.ИспользуетсяИнтеграцияСМСД;
	
	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.ПолучениеСообщенийМСДИзОчередиЕСМВ;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.ИспользуетсяИнтеграцияСМСД;
	
	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.СверкаДанныхСМСД;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.ИспользуетсяИнтеграцияСМСД;
	
	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.ФормированиеДанныхДляМСД;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.ИспользуетсяИнтеграцияСМСД;

КонецПроцедуры

Процедура ДоступФормыОбменаНаКлиенте(ИмяКомпьютера, НачальнаяСтраницаИзменена = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина); 
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользуетсяИнтеграцияСМСД") Тогда 
		Возврат;	
	КонецЕсли;
	
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		Если НЕ ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ДоступнаФормаОбменаНаКлиенте = Ложь;

	МодульПользователи = ОбщегоНазначения.ОбщийМодуль("Пользователи");
	Если Константы.АвтоматическаяОтправкаПакетовДанныхМСД.Получить() ИЛИ Константы.АвтоматическийЗапросСроковТаксономииМСД.Получить() Тогда
		Если ИнтеграцииЕСМВСМЭВ.ОтправлятьЗапросыНаКлиенте() ИЛИ ИнтеграцииЕСМВСМЭВ.ОтправлятьФайлыНаКлиенте() Тогда
			ДоступнаФормаОбменаНаКлиенте = (Константы.ПользовательКлиентМСД.Получить() = МодульПользователи.ТекущийПользователь() 
			И Константы.ИмяКомпьютераКлиентМСД.Получить() = ИмяКомпьютера);
		КонецЕсли;
	КонецЕсли; 
	
	УстановитьНастройкиНачальнойСтраницы(ДоступнаФормаОбменаНаКлиенте, НачальнаяСтраницаИзменена);	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры 

Процедура УстановитьНастройкиНачальнойСтраницы(ДоступнаФормаОбменаНаКлиенте, НачальнаяСтраницаИзменена = Ложь, Пользователь = "") Экспорт
	
	ФормаПрисутствуетНаНачальнойСтранице = Ложь;
	
	Попытка
		НастройкиНачальнойСтраницы = ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиНачальнойСтраницы",,,Пользователь);
	Исключение
		Возврат;
	КонецПопытки;
	Если НастройкиНачальнойСтраницы = Неопределено Тогда
		НастройкиНачальнойСтраницы = Новый НастройкиНачальнойСтраницы;
	КонецЕсли;
		
	СоставФормНачальнойСтраницы  = НастройкиНачальнойСтраницы.ПолучитьСоставФорм();
	
	ПроверитьКолонкуНаНаличиеФормы(СоставФормНачальнойСтраницы.ЛеваяКолонка, ДоступнаФормаОбменаНаКлиенте, ФормаПрисутствуетНаНачальнойСтранице, НачальнаяСтраницаИзменена);
	ПроверитьКолонкуНаНаличиеФормы(СоставФормНачальнойСтраницы.ПраваяКолонка, ДоступнаФормаОбменаНаКлиенте, ФормаПрисутствуетНаНачальнойСтранице, НачальнаяСтраницаИзменена);
	
	Если ДоступнаФормаОбменаНаКлиенте И НЕ ФормаПрисутствуетНаНачальнойСтранице Тогда
		СоставФормНачальнойСтраницы.ПраваяКолонка.Добавить("ОбщаяФорма.АвтоматическийОбменКлиентМСД");
		НачальнаяСтраницаИзменена = Истина;
	КонецЕсли;
	
	Если НачальнаяСтраницаИзменена Тогда
		НастройкиНачальнойСтраницы.УстановитьСоставФорм(СоставФормНачальнойСтраницы);
		ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиНачальнойСтраницы",,НастройкиНачальнойСтраницы,,Пользователь);
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПроверитьКолонкуНаНаличиеФормы(КолонкаФормы, ДоступнаФормаОбменаНаКлиенте, ФормаПрисутствуетНаНачальнойСтранице, НачальнаяСтраницаИзменена) Экспорт
	
	Для Каждого ФормаЛеваяКолонка Из КолонкаФормы Цикл
		Если ФормаЛеваяКолонка = "ОбщаяФорма.АвтоматическийОбменКлиентМСД" Тогда
			ФормаПрисутствуетНаНачальнойСтранице = Истина;
			Если НЕ ДоступнаФормаОбменаНаКлиенте Тогда
				КолонкаФормы.Удалить(КолонкаФормы.Найти(ФормаЛеваяКолонка));
				НачальнаяСтраницаИзменена = Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	
	
#КонецОбласти
