// @strict-types

#Область СлужебныйПрограммныйИнтерфейс

// Движения документов при передаче пользование контрагенту.
// 
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//  ТаблицаЗначений
Функция ДвиженияДокументовПриПередачеВПользованиеКонтрагентуЗабаланс(МассивОбъектов) Экспорт
	Запрос = Новый Запрос;
	ЧастиЗапроса = Новый Массив; // Массив из Строка
	ЧастиЗапроса.Добавить(ТекстЗапросаДвиженияПриПередачеВПользованиеКонтрагентуЗабаланс());
	ЧастиЗапроса.Добавить(ТекстЗапросаСоответствиеСчетовПередачиВПользованиеКонтрагентуЗабаланс());
	НомерЗапроса = 1;
	ПараметрыРаспределения = Новый Массив; // Массив из Структура
	ДокументыПоТипам = ОбщегоНазначенияБГУ.ДокументыПоТипам(МассивОбъектов);
	Для Каждого Документ Из ДокументыПоТипам Цикл
		Если Не ЕстьФункцияТекстЗапросаПриПередачеВПользованиеКонтрагентуЗабаланс(Документ.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Документ.Значение[0]);
		//@skip-check dynamic-access-method-not-found
		ТекстЗапросаПоВидуДокумента = МенеджерДокумента.ТекстЗапросаТаблицыДляРасчетаДвиженийПриПередачеВПользованиеКонтрагентуЗабаланс(); // Строка
		ЧастиЗапроса.Добавить(
			СтрЗаменить(ТекстЗапросаПоВидуДокумента,
				"&МассивОбъектов",
				"&МассивОбъектов" + НомерЗапроса));
		Запрос.УстановитьПараметр("МассивОбъектов" + НомерЗапроса, Документ.Значение);
		//@skip-check dynamic-access-method-not-found
		//@skip-check invocation-parameter-type-intersect
		ПараметрыРаспределения.Добавить(МенеджерДокумента.ПараметрыРаспределенияЗабалансовыхДвижений());
		НомерЗапроса = НомерЗапроса + 1;
	КонецЦикла;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	ПроверятьСуммыРезервов = РезервированиеНФА.ИспользуетсяРезервированиеСумм();
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ПроверятьСуммыРезервов", ПроверятьСуммыРезервов);
	СчетаПередачи = Новый Массив; // Массив из ПланСчетовСсылка.ЕПСБУ
	Счет25 = БухгалтерскийУчет.СчетПоКоду("25");
	Если ЗначениеЗаполнено(Счет25) Тогда
		СчетаПередачи.Добавить(Счет25);
	КонецЕсли;
	Счет26 = БухгалтерскийУчет.СчетПоКоду("26");
	Если ЗначениеЗаполнено(Счет26) Тогда
		СчетаПередачи.Добавить(Счет26);
	КонецЕсли;
	Запрос.УстановитьПараметр("СчетаПередачи", СчетаПередачи);
	СчетаМЗ = Новый Массив; // Массив из ПланСчетовСсылка.ЕПСБУ
	Счет10856 = БухгалтерскийУчет.СчетПоКоду("108.56");
	Если ЗначениеЗаполнено(Счет10856) Тогда
		СчетаМЗ.Добавить(Счет10856);
	КонецЕсли;
	Счет10857 = БухгалтерскийУчет.СчетПоКоду("108.57");
	Если ЗначениеЗаполнено(Счет10857) Тогда
		СчетаМЗ.Добавить(Счет10857);
	КонецЕсли;
	Запрос.УстановитьПараметр("СчетаМЗ", СчетаМЗ);
	Запрос.УстановитьПараметр("СчетУчета", БухгалтерскийУчет.СчетПоКоду("108.56"));
	Запрос.УстановитьПараметр("ВалютаРубль", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("Передача25", Перечисления.ВидыПередачиИК.ПередачаПоДоговоруАренды);
	Запрос.УстановитьПараметр("Передача26", Перечисления.ВидыПередачиИК.ПередачаПоДоговоруБезвмозмездногоПользования);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ТаблицаДвиженийЗаб = РезультатЗапроса[0].Выгрузить();
	
	ТаблицаРезультат = ТаблицаДвиженийЗаб.СкопироватьКолонки();
	ИндексПервогоЗапросаДокумента = 4;
	ИндексТипаДокумента = 0;
	Отбор = Новый Структура("Ссылка", Неопределено);	
	Для Каждого Документ Из ДокументыПоТипам Цикл
	
		ПараметрыРаспределенияДвиженийЗаб = ПараметрыРаспределения[ИндексТипаДокумента];
		
		ВыборкаДокумент = РезультатЗапроса[ИндексПервогоЗапросаДокумента + ИндексТипаДокумента].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДокумент.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Отбор, ВыборкаДокумент);
			ТаблицаДвиженийДокументаЗаб = ТаблицаДвиженийЗаб.Скопировать(Отбор);
			ЗаполнитьЗначенияСвойств(ПараметрыРаспределенияДвиженийЗаб, ВыборкаДокумент,
				"Организация, ИФО, Дата");
			ПараметрыРаспределенияДвиженийЗаб.ВыборкаМатериалы = ВыборкаДокумент.Выбрать();
			ПараметрыРаспределенияДвиженийЗаб.ТаблицаДвижений = ТаблицаДвиженийДокументаЗаб;
			УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти(ПараметрыРаспределенияДвиженийЗаб);
			Для Каждого Строка Из ТаблицаДвиженийДокументаЗаб Цикл
				ЗаполнитьЗначенияСвойств(ТаблицаРезультат.Добавить(), Строка);	
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьФункцияТекстЗапросаПриПередачеВПользованиеКонтрагентуЗабаланс(Ключ)
	Возврат Ключ = Тип("ДокументСсылка.НакладнаяНаОтпускИК");
КонецФункции

Функция ТекстЗапросаСоответствиеСчетовПередачиВПользованиеКонтрагентуЗабаланс()
	Возврат
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 1, 2) = ""25""
	|			ТОГДА &Передача25
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 1, 2) = ""26""
	|			ТОГДА &Передача26
	|	КОНЕЦ КАК ВидПередачи,
	|	ПОДСТРОКА(ЕПСБУ.Код, 4, 1) КАК ПодКод,
	|	ЕПСБУ.УчетПоКПС КАК УчетПоКПС,
	|	ЕПСБУ.УчетПоКЭК КАК УчетПоКЭК
	|ПОМЕСТИТЬ СчетаПередачи
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
	|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&СчетаПередачи)
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ПОДСТРОКА(ЕПСБУ.Код, 5, 1) КАК ПодКод
	|ПОМЕСТИТЬ СчетаУчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
	|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&СчетаМЗ)
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаУчета.Ссылка КАК СчетУчета,
	|	СчетаПередачи.Ссылка КАК СчетПередачи,
	|	СчетаПередачи.ВидПередачи КАК ВидПередачи,
	|	СчетаПередачи.УчетПоКПС КАК УчетПоКПС,
	|	СчетаПередачи.УчетПоКЭК КАК УчетПоКЭК
	|ПОМЕСТИТЬ СоответствиеСчетов
	|ИЗ
	|	СчетаУчета КАК СчетаУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетаПередачи КАК СчетаПередачи
	|		ПО (СчетаПередачи.ПодКод = СчетаУчета.ПодКод)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетУчета,
	|	ВидПередачи";
	
КонецФункции

Функция ТекстЗапросаДвиженияПриПередачеВПользованиеКонтрагентуЗабаланс()
	Возврат
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Документ.НакладнаяНаОтпускИК) КАК Ссылка,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетУчета,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.Номенклатура)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	КОНЕЦ КАК НоменклатураСсылка,
	|	ВЫБОР
	|		КОГДА НЕ ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1
	|		КОГДА НЕ ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2
	|		КОГДА НЕ ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	КОНЕЦ КАК ДопСубконто,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт КАК Количество,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт КАК КоличествоОстаток,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК СуммаОстаток,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПССсылка,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭКСсылка,
	|	0 КАК НомерСтрокиДокумента
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В (&МассивОбъектов)
	|				И СчетКт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|				И (ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|					ИЛИ ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|					ИЛИ ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|ГДЕ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт > 0";
	
КонецФункции


#КонецОбласти