#Область ПрограммныйИнтерфейс

// Возращает код по сводному реестру получателей бюджетных средств учреждения области данных.
// 
// Возвращаемое значение:
//  Булево - КодПоРПБС учреждения области данных
//
Функция ПолучитьКодРПБСОбластиДанных() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекущаяОрганизация = ПараметрыСеанса.ТекущаяОрганизация;
	Если Не ЗначениеЗаполнено(ТекущаяОрганизация) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяОрганизация, "КодПоРПБС");
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция КодыПоРПБС(Организация = Неопределено)Экспорт 
	
	Результат = Новый Структура("КодГлавы, КодПоРПБС", "", ""); 
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЕСТЬNULL(ГлавыПоБюджетнойКлассификации.Код, """") КАК КодГлавы,
	                      |	Организации.КодПоРПБС КАК КодПоРПБС
	                      |ИЗ
	                      |	Справочник.Организации КАК Организации
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГлавыПоБюджетнойКлассификации КАК ГлавыПоБюджетнойКлассификации
	                      |		ПО Организации.КодПоППП = ГлавыПоБюджетнойКлассификации.Ссылка
	                      |ГДЕ
	                      |	Организации.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", ?(Организация = Неопределено, Справочники.Организации.ОрганизацияПоУмолчанию(), Организация));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции  

// Возвращает данные о программе
// 
// Возвращаемое значение:
//	- Структура:
//		* Имя - Строка - Имя программы
// 		* Версия - Строка - Версия программы
// 		* Поставщик - Строка - Поставщик программы
//
Функция ДанныеОПрограмме() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", 		Метаданные.Имя);
	Результат.Вставить("Версия", 	Метаданные.Версия);
	Результат.Вставить("Поставщик", Метаданные.Поставщик);
	МодульСбораДанныхПереопределяемый.ДанныеОПрограмме(Результат);
	
	Возврат Результат
	
КонецФункции

Функция ВыполнятьПроверкуПриВыгрузке() Экспорт
	
	Возврат Ложь;
	
КонецФункции 

#КонецОбласти

