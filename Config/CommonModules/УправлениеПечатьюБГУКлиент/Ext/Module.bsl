Функция ПечатьТТН(ПараметрыПечати) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Документ", ?(ПараметрыПечати.ОбъектыПечати.Количество() > 0, ПараметрыПечати.ОбъектыПечати[0], Неопределено));
	ОткрытьФорму("Обработка.ПечатьТТН.Форма.Форма", ПараметрыФормы);
	
КонецФункции

Функция ДвиженияДокумента(ПараметрыПечати) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Документ", ?(ПараметрыПечати.ОбъектыПечати.Количество() > 0, ПараметрыПечати.ОбъектыПечати[0], Неопределено));
	ОткрытьФорму("Отчет.ДвиженияДокументаБГУ.Форма.ФормаОтчета", ПараметрыФормы, ,Новый УникальныйИдентификатор);
	
КонецФункции

Функция ДвиженияОС(ПараметрыПечати) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОсновноеСредство", ?(ПараметрыПечати.ОбъектыПечати.Количество() > 0, ПараметрыПечати.ОбъектыПечати[0], Неопределено));
	ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ДвиженияОС", ПараметрыФормы,, Новый УникальныйИдентификатор);
	
КонецФункции

Процедура ОткрытьФормуНастройкиQRкода(ФормаВладелец, СтандартнаяОбработка, ВидОбменаДляQRКода, ФорматОбменаДляQRКода, ИмяОбъекта = "") Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ИмяОбъектаМетаданных = ИмяОбъекта; 
	
	Если НЕ ЗначениеЗаполнено(ИмяОбъектаМетаданных) Тогда
		МассивИмен = ОбщегоНазначенияКлиентСервер.РазложитьСтрокуПоТочкамИСлэшам(ФормаВладелец.ИмяФормы);
		ИмяОбъектаМетаданных = МассивИмен[0] + "." + МассивИмен[1];
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ИмяОбъектаМетаданных", ИмяОбъектаМетаданных);
	ПараметрыОткрытия.Вставить("ВидОбменаДляQRКода", ВидОбменаДляQRКода);
	ПараметрыОткрытия.Вставить("ФорматОбменаДляQRКода", ФорматОбменаДляQRКода);
		
	ОткрытьФорму("ОбщаяФорма.НастройкаQRкода", ПараметрыОткрытия, ФормаВладелец);
	
КонецПроцедуры	

Процедура ОбработатНастройкиQRкода(ВыбранноеЗначение, ИсточникВыбора, ВидОбменаДляQRКода, ФорматОбменаДляQRКода, НадписьНастройкаQRкода) Экспорт
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.НастройкаQRкода" Тогда
		
		ВидОбменаДляQRКода = ВыбранноеЗначение.ВидОбменаДляQRКода;
		ФорматОбменаДляQRКода = ВыбранноеЗначение.ФорматОбменаДляQRКода;
		
		НадписьНастройкаQRкода = УправлениеПечатьюБГУКлиентСервер.СформироватьНадписьНастройкаQRкода(ВидОбменаДляQRКода, ФорматОбменаДляQRКода);
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОткрытьОтчетОборотыРНПТМЗ(Номенклатура, ПараметрыВыполненияКоманды) Экспорт

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	ПараметрыФормы.Вставить("КлючВарианта", "КонтекстныйВариант");
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "КонтекстныйВариант");
	
	Отбор = Новый Структура("Номенклатура", Номенклатура);
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("Отчет.ОборотыРНПТМЗ.Форма", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	
КонецПРоцедуры

Процедура ОткрытьОтчетОборотыРНПТОС(ОсновноеСредство, ПараметрыВыполненияКоманды) Экспорт

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	ПараметрыФормы.Вставить("КлючВарианта", "КонтекстныйВариант");
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "КонтекстныйВариант");
	
	Отбор = Новый Структура("ОсновноеСредство", ОсновноеСредство);
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("Отчет.ОборотыРНПТОС.Форма", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	
КонецПРоцедуры

// См. УправлениеПечатьюКлиентПереопределяемый.ПечатьДокументовВыполнитьКоманду
Процедура ПечатьДокументовВыполнитьКоманду(Форма, Команда, ПродолжитьВыполнениеНаСервере, ДополнительныеПараметры) Экспорт
	
	РегистрыУчетаКлиент.ОбработчикКомандыРаботыСРегистромУчета(Форма, Команда, "ТекущаяПечатнаяФорма");
	
КонецПроцедуры

// Используется как обработчик печати инвентарной карточки при ее формировании из формы карточки 
// основного средства. Там есть необходимость передать в параметры печати значение реквизита формы "ДатаСведений".
// Это можно сделать только через такой отдельный обработчик
Функция НапечататьИнвентарнуюКарточку61н(ПараметрыПечати) Экспорт
	Параметры = Новый Структура("ДатаСведений", '00010101');            
	Если ПараметрыПечати.Свойство("ДополнительныеПараметры") 
		И ПараметрыПечати.ДополнительныеПараметры.Свойство("ДатаСведений") Тогда
		Параметры.ДатаСведений = ПараметрыПечати.ДополнительныеПараметры.ДатаСведений;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Параметры.ДатаСведений) Тогда
		ЗаполнитьЗначенияСвойств(Параметры, ПараметрыПечати.Форма);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Параметры.ДатаСведений) Тогда
		Параметры.ДатаСведений = КонецДня(Параметры.ДатаСведений);
	КонецЕсли;	
	
	ДопПараметры = ?(ПараметрыПечати.Свойство("ДополнительныеПараметры"), ПараметрыПечати.ДополнительныеПараметры, Новый Структура);
	ДопПараметры.Вставить("ДатаСведений");
	ЗаполнитьЗначенияСвойств(ДопПараметры, Параметры);
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
		"Справочник.ОсновныеСредства", "ИнвентарнаяКарточка61н", ПараметрыПечати.ОбъектыПечати, ПараметрыПечати.Форма, ДопПараметры);

	Возврат "";
КонецФункции	

