//

Функция ОшибкаПакетЗавершен(Знач Пакет)
	Возврат НСтр("ru = 'Попытка модификации завершенного пакета.'");
КонецФункции

Функция ОшибкаЧастьНеСуществует(Знач Пакет, Знач ИмяЧасти)
	Возврат СтрЗаменить(НСтр("ru = 'Часть %ИмяЧасти% не существует.'"), "%ИмяЧасти%", ИмяЧасти);
КонецФункции

Функция ОшибкаЧастьУжеСуществует(Знач Пакет, Знач ИмяЧасти)
	Возврат СтрЗаменить(НСтр("ru = 'Часть ‘%ИмяЧасти%’ уже была добавлена в пакет.'"), "%ИмяЧасти%", ИмяЧасти)
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ЧТЕНИЯ И ЗАПИСИ
//

Процедура ЗаписатьСвязиXDTO(Знач Пакет, Знач ИмяЧасти, Знач СвязиЧастиXDTO)
	
	ИмяФайла = СформироватьИмяФайлаДляЧасти(Пакет, ПолучитьИмяЧастиСвязейЧасти(ИмяЧасти));
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, СвязиЧастиXDTO,
		"Relationships",
		"http://schemas.openxmlformats.org/package/2006/relationships",
		ФормаXML.Элемент,
		НазначениеТипаXML.Неявное);
	
	ЗаписьXML.Закрыть();
	
КонецПроцедуры

Процедура ЗаписатьТипыСодержимогоXDTO(Знач Пакет, Знач ТипыСодержимогоXDTO)
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(Пакет.РабочийКаталог + "/[Content_Types].xml");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ТипыСодержимогоXDTO,
		"Types",
		"http://schemas.openxmlformats.org/package/2006/content-types",
		ФормаXML.Элемент,
		НазначениеТипаXML.Неявное);
	ЗаписьXML.Закрыть();
	
КонецПроцедуры

Процедура ЗаписатьЯдерныеСвойства(Знач Пакет)
	
	Если НЕ Пакет.Свойство("ЯдерныеСвойства") Тогда
		Возврат;
	КонецЕсли;
	
	ДокументDOM = Новый ДокументDOM("http://schemas.openxmlformats.org/package/2006/metadata/core-properties", "coreProperties");
	
	ДокументDOM.ЭлементДокумента.УстановитьСоответствиеПространстваИмен("cp", "http://schemas.openxmlformats.org/package/2006/metadata/core-properties", Истина);
	ДокументDOM.ЭлементДокумента.УстановитьСоответствиеПространстваИмен("dc", "http://purl.org/dc/elements/1.1/");
	ДокументDOM.ЭлементДокумента.УстановитьСоответствиеПространстваИмен("dcterms", "http://purl.org/dc/terms/");
	ДокументDOM.ЭлементДокумента.УстановитьСоответствиеПространстваИмен("dcmitype", "http://purl.org/dc/dcmitype/");
	
	ДокументDOM.ЭлементДокумента.Префикс = "cp";
	
	СоответствияПИ = ДокументDOM.ЭлементДокумента.ПолучитьСоответствияПространствИмен();
	
	Для каждого КлючИЗначение Из Пакет.ЯдерныеСвойства Цикл
		
		Если НЕ ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		ПозДвоеточия = Найти(КлючИЗначение.Ключ, ":");
		Если ПозДвоеточия <> "" Тогда
			Префикс = Лев(КлючИЗначение.Ключ, ПозДвоеточия - 1);
		Иначе
			Префикс  = "";
		КонецЕсли;
		
		URIПространстваИмен = СоответствияПИ[Префикс];
		
		Если ПустаяСтрока(URIПространстваИмен) Тогда
			URIПространстваИмен = "http://schemas.openxmlformats.org/package/2006/metadata/core-properties";
		КонецЕсли;
		
		ЭлементСвойстваDOM = ДокументDOM.СоздатьЭлемент(URIПространстваИмен, КлючИЗначение.Ключ);
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Дата") Тогда
			ЭлементСвойстваDOM.ТекстовоеСодержимое = XMLСтрока(КлючИЗначение.Значение) + "Z";
		Иначе
			ЭлементСвойстваDOM.ТекстовоеСодержимое = XMLСтрока(КлючИЗначение.Значение);
		КонецЕсли;
		
		ДокументDOM.ЭлементДокумента.ДобавитьДочерний(ЭлементСвойстваDOM);
		
	КонецЦикла;
	
	ЗаписьXML = ЗаписьДобавитьXMLЧасть(Пакет, "/docProps/core.xml", "application/vnd.openxmlformats-package.core-properties+xml");
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	
	ЗаписьДобавитьСвязь(Пакет,
		"",
		"http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties",
		"docProps/core.xml");
	
КонецПроцедуры // ЗаписатьЯдерныеСвойства()

Функция НайтиZipЭлемент(Знач ЧтениеZip, Знач ПолноеИмя)
	
	НРегПолноеИмя = НРег(ПолноеИмя);
	
	Для каждого ZipЭлемент Из ЧтениеZip Цикл
		Если НРег(СтрЗаменить(ZipЭлемент.ПолноеИмя, ПолучитьРазделительПути(), "/")) = НРегПолноеИмя Тогда
			Возврат ZipЭлемент;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция СформироватьИмяФайлаДляЧасти(Знач Пакет, Знач ИмяЧасти)
	
	Файл = Новый Файл(ИмяЧасти);
	
	Каталог = Пакет.РабочийКаталог + "/" + СтрЗаменить(Файл.Путь, "\", "/");
	ФайлКаталога = Новый Файл(Каталог);
	Если НЕ ФайлКаталога.Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;
	
	ИмяФайла = Файл.Имя;
	
	Возврат Каталог + ИмяФайла;
	
КонецФункции

Функция ПолучитьИмяЧастиСвязейЧасти(Знач ИмяЧасти)
	
	Файл = Новый Файл(ИмяЧасти);
	ИмяЧастиСвязейЧасти = СтрЗаменить(Файл.Путь, ПолучитьРазделительПути(), "/") + "_rels" + "/" + Файл.Имя + ".rels";
	Возврат ИмяЧастиСвязейЧасти;
	
КонецФункции

#КонецОбласти

