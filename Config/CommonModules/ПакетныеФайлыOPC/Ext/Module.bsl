////////////////////////////////////////////////////////////////////////////////
// Модуль содержит функции для работы с файлами, созданными согласно          //
// спецификации Open Packaging Convention. //                                 //
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

///////////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ ЧТЕНИЯ ПАКЕТНЫХ ФАЙЛОВ
//

// Открывает пакет для чтения.
//
// Параметры:
//  ИмяФайла     - Строка. Имя файла пакета.
//
// Возвращаемое значение:
//  Структура. Системное описание пакета. Значение передается функциям
//  с префиксом "Чтение" первым параметром.
//
Функция ЧтениеОткрыть(Знач ИмяФайла) Экспорт
	
	Результат = Новый Структура();
	
	ЧтениеZipФайла = Новый ЧтениеZipФайла;
	ЧтениеZipФайла.Открыть(ИмяФайла);
	
	РабочийКаталог = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(РабочийКаталог);
	
	Результат.Вставить("ИмяФайла",        ИмяФайла);
	Результат.Вставить("ЧтениеZip",       ЧтениеZipФайла);
	Результат.Вставить("РабочийКаталог",  РабочийКаталог);
	Результат.Вставить("ОткрытыеЧасти",   Новый Соответствие);
	Результат.Вставить("ТипыСодержимого", Неопределено);
	Результат.Вставить("УдалитьВременныеФайлы", Истина);
	
	Возврат Результат;
	
КонецФункции

// Извлекает часть из пакета.
//
// Параметры:
//  Пакет        - Структура. Описание пакета, полученное функцией
//                 ЧтениеОткрыть.
//  ИмяЧасти     - Строка. Имя части в пакете.
//
// Возвращаемое значение:
//  Имя созданного временного файла с содержимым части.
//
Функция ЧтениеПолучитьЧасть(Знач Пакет, Знач ИмяЧасти) Экспорт
	
	Если Лев(ИмяЧасти, 1) = "/" Тогда
		ИмяЧасти = Сред(ИмяЧасти, 2);
	КонецЕсли;
	
	Результат = Пакет.ОткрытыеЧасти[НРег(ИмяЧасти)];
	Если Результат = Неопределено Тогда
		
		ZipЭлементФайлаСсылок = НайтиZipЭлемент(Пакет.ЧтениеZip, ИмяЧасти);
		Если ZipЭлементФайлаСсылок <> Неопределено Тогда
			
			Пакет.ЧтениеZip.Извлечь(ZipЭлементФайлаСсылок,
				Пакет.РабочийКаталог,
				РежимВосстановленияПутейФайловZIP.Восстанавливать);
			
			Файл = Новый Файл(Пакет.РабочийКаталог + "/" + ИмяЧасти);
			
			Результат = Файл.ПолноеИмя;
			Пакет.ОткрытыеЧасти[НРег(ИмяЧасти)] = Результат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЧтениеПолучитьXMLЧасть(Знач Пакет, Знач ИмяЧасти, Знач ПараметрыЧтенияXML = Неопределено, Знач НаборСхемXML = Неопределено, Знач Кодировка = Неопределено) Экспорт
	
	ИмяФайла = ЧтениеПолучитьЧасть(Пакет, ИмяЧасти);
	ЧтениеXML = Новый ЧтениеXML;
	
	Попытка
		ЧтениеXML.ОткрытьФайл(ИмяФайла, ПараметрыЧтенияXML, НаборСхемXML, Кодировка);
	Исключение
		ЧтениеXML.ОткрытьФайл(ИмяФайла);
	КонецПопытки;

	Возврат ЧтениеXML;
	
КонецФункции

Функция ЧтениеПолучитьСвязиЧастиXDTO(Знач Пакет, Знач ИмяЧасти) Экспорт
	
	Перем RelationshipsXDTO;
	
	ИмяЧастиСвязейЧасти = ПолучитьИмяЧастиСвязейЧасти(ИмяЧасти);
	
	ИмяФайлаЧасти = ЧтениеПолучитьЧасть(Пакет, ИмяЧастиСвязейЧасти);

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайлаЧасти);
	RelationshipsXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML,
							ФабрикаXDTO.Тип("http://schemas.openxmlformats.org/package/2006/relationships", "CT_Relationships"));
	
	Возврат RelationshipsXDTO;
	
КонецФункции

Процедура ЧтениеЗакрыть(Знач Пакет) Экспорт
	
	Пакет.ОткрытыеЧасти.Очистить();
	
	Если Пакет.УдалитьВременныеФайлы Тогда
		УдалитьФайлы(Пакет.РабочийКаталог);
	КонецЕсли;
	
КонецПроцедуры

Функция ЧтениеПолучитьТипСодержимого(Знач Пакет, Знач ИмяЧасти) Экспорт
	
	Если Лев(ИмяЧасти, 1) = "/" Тогда
		ИмяЧасти = Сред(ИмяЧасти, 2);
	КонецЕсли;
	
	Если Пакет.ТипыСодержимого = Неопределено Тогда
		
		ZipЭлементТиповСодержимого = НайтиZipЭлемент(Пакет.ЧтениеZip, "[Content_Types].xml");
		Если ZipЭлементТиповСодержимого = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Пакетный файл имеет неправильный формат: отсутствует список типов содержимого частей пакета.'");
		КонецЕсли;
		
		Пакет.ЧтениеZip.Извлечь(ZipЭлементТиповСодержимого,
			Пакет.РабочийКаталог,
			РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(Пакет.РабочийКаталог + "/" + "[Content_Types].xml");
		
		Пакет.ТипыСодержимого = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML,
			ФабрикаXDTO.Тип("http://schemas.openxmlformats.org/package/2006/content-types", "CT_Types"));
		
	КонецЕсли;
	
	Для каждого Override Из Пакет.ТипыСодержимого.Override Цикл
		ИмяЧастиВСписке = Override.PartName;
		Если Лев(ИмяЧастиВСписке, 1) = "/" Тогда
			ИмяЧастиВСписке = Сред(ИмяЧастиВСписке, 2);
		КонецЕсли;
		Если НРег(ИмяЧастиВСписке) = НРег(ИмяЧасти) Тогда
			Возврат Override.ContentType;
		КонецЕсли;
	КонецЦикла;
	
	Файл = Новый Файл(ИмяЧасти);
	Расширение = Сред(Файл.Расширение, 2);
	Для каждого Default Из Пакет.ТипыСодержимого.Default Цикл
		Если НРег(Default.Extension) = НРег(Расширение) Тогда
			Возврат Default.ContentType;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ СОЗДАНИЯ ПАКЕТНЫХ ФАЙЛОВ
//

Функция ЗаписьСоздать(Знач ИмяФайла, Знач УровеньСжатия = Неопределено, Знач Комментарий = Неопределено, Знач Пароль = Неопределено) Экспорт
	
	Результат = Новый Структура;
	
	УровеньСжатия = ?(УровеньСжатия = Неопределено, УровеньСжатияZIP.Оптимальный, УровеньСжатия);
	
	ЗаписьZipФайла = Новый ЗаписьZipФайла;
	ЗаписьZipФайла.Открыть(ИмяФайла,
		Пароль,
		Комментарий,
		МетодСжатияZIP.Сжатие,
		УровеньСжатия,
		МетодШифрованияZIP.Zip20);
	
	РабочийКаталог = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(РабочийКаталог);
	
	Результат.Вставить("ИмяФайла",  ИмяФайла);
	Результат.Вставить("ЗаписьZip", ЗаписьZipФайла);
	Результат.Вставить("ДобавленныеЧасти", Новый Соответствие);
	Результат.Вставить("РабочийКаталог", РабочийКаталог);
	Результат.Вставить("Завершен", Ложь);
	Результат.Вставить("УдалитьВременныеФайлы", Истина);
	
	Возврат Результат;
	
КонецФункции

Функция ЗаписьДобавитьЧасть(Знач Пакет, Знач ИмяЧасти, Знач ТипСодержимого = "application/octet-stream") Экспорт
	
	Если Пакет.Завершен Тогда
		ВызватьИсключение ОшибкаПакетЗавершен(Пакет);
	КонецЕсли;
	
	ОписаниеЧасти = Пакет.ДобавленныеЧасти[НРег(ИмяЧасти)];
	Если ОписаниеЧасти <> Неопределено Тогда
		ВызватьИсключение ОшибкаЧастьУжеСуществует(Пакет, ОписаниеЧасти.ИмяЧасти);
	КонецЕсли;
	
	ОписаниеЧасти = Новый Структура;
	ОписаниеЧасти.Вставить("ИмяЧасти", ИмяЧасти);
	ОписаниеЧасти.Вставить("ИмяФайла", СформироватьИмяФайлаДляЧасти(Пакет, ИмяЧасти));
	ОписаниеЧасти.Вставить("ТипСодержимого", ТипСодержимого);
	Пакет.ДобавленныеЧасти[НРег(ИмяЧасти)] = ОписаниеЧасти;
	
	Возврат ОписаниеЧасти.ИмяФайла;
	
КонецФункции

Функция ЗаписьДобавитьXMLЧасть(Знач Пакет, Знач ИмяЧасти, Знач ТипСодержимого = "text/xml") Экспорт
	
	ИмяФайла = ЗаписьДобавитьЧасть(Пакет, ИмяЧасти, ТипСодержимого);
	Результат = Новый ЗаписьXML;
	Результат.ОткрытьФайл(ИмяФайла);
	Возврат Результат;
	
КонецФункции

Процедура ЗаписьДобавитьСвязь(Знач Пакет, Знач ИмяЧасти, Знач URIТипаСвязи, Знач URI, Знач Внешний = Ложь, Знач ID = Неопределено) Экспорт
	
	Перем СвязиЧастиXDTO;
	
	Если Пакет.Завершен Тогда
		ВызватьИсключение ОшибкаПакетЗавершен(Пакет);
	КонецЕсли;
	
	Если ИмяЧасти = "" Тогда
		ОписаниеЧасти = Пакет;
	Иначе
		ОписаниеЧасти = Пакет.ДобавленныеЧасти[НРег(ИмяЧасти)];
		Если ОписаниеЧасти = Неопределено Тогда
			ВызватьИсключение ОшибкаЧастьНеСуществует(Пакет, ИмяЧасти);
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ОписаниеЧасти.Свойство("СвязиXDTO", СвязиЧастиXDTO) Или СвязиЧастиXDTO = Неопределено Тогда
		
		СвязиЧастиXDTO = ФабрикаXDTO.Создать(
			ФабрикаXDTO.Тип("http://schemas.openxmlformats.org/package/2006/relationships", "CT_Relationships"));
		ОписаниеЧасти.Вставить("СвязиXDTO", СвязиЧастиXDTO);
		
	КонецЕсли;
	
	СвязьXDTO = ФабрикаXDTO.Создать(
		ФабрикаXDTO.Тип("http://schemas.openxmlformats.org/package/2006/relationships", "CT_Relationship"));
	
	СвязьXDTO.Type   = URIТипаСвязи;
	СвязьXDTO.Target = URI;
	Если Внешний Тогда
		СвязьXDTO.TargetMode = "External";
	КонецЕсли;
	Если ID = Неопределено Тогда
		Счетчик = СвязиЧастиXDTO.Relationship.Количество();
		ИскатьДальше = Истина;
		Пока ИскатьДальше Цикл
			Счетчик = Счетчик + 1;
			ПредполагаемыйID = "Id" + Формат(Счетчик, "ЧДЦ=0; ЧГ=0");
			ИскатьДальше = Ложь;
			Для каждого Связь Из СвязиЧастиXDTO.Relationship Цикл
				Если Связь.ID = ПредполагаемыйID Тогда
					ИскатьДальше = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		СвязьXDTO.Id = ПредполагаемыйID;
	Иначе
		СвязьXDTO.Id = ID;
	КонецЕсли;
	
	СвязиЧастиXDTO.Relationship.Добавить(СвязьXDTO);
	
КонецПроцедуры // ЗаписьДобавитьСвязь()

Процедура ЗаписьУстановитьСвязиЧастиXDTO(Знач Пакет, Знач ИмяЧасти, Знач СвязиЧастиXDTO) Экспорт
	
	Если Пакет.Завершен Тогда
		ВызватьИсключение ОшибкаПакетЗавершен(Пакет);
	КонецЕсли;
	
	ОписаниеЧасти = Пакет.ДобавленныеЧасти[НРег(ИмяЧасти)];
	Если ОписаниеЧасти = Неопределено Тогда
		ВызватьИсключение ОшибкаЧастьНеСуществует(Пакет, ИмяЧасти);
	КонецЕсли;
	
	ОписаниеЧасти.Вставить("СвязиXDTO", СвязиЧастиXDTO);
	
КонецПроцедуры

Процедура ЗаписьЗакрыть(Знач Пакет) Экспорт
	
	Перем СвязиЧастиXDTO;
	
	Если Пакет.Завершен Тогда
		ВызватьИсключение ОшибкаПакетЗавершен(Пакет);
	КонецЕсли;
	
	ЗаписатьЯдерныеСвойства(Пакет);
	
	ТипыСодержимогоXDTO = ФабрикаXDTO.Создать(
		ФабрикаXDTO.Тип("http://schemas.openxmlformats.org/package/2006/content-types", "CT_Types"));
	
	ТипСодержимогоПоУмолчаниюXDTO = ФабрикаXDTO.Создать(
		ФабрикаXDTO.Тип("http://schemas.openxmlformats.org/package/2006/content-types", "CT_Default"));
	ТипСодержимогоПоУмолчаниюXDTO.Extension = "rels";
	ТипСодержимогоПоУмолчаниюXDTO.ContentType = "application/vnd.openxmlformats-package.relationships+xml";
	ТипыСодержимогоXDTO.Default.Добавить(ТипСодержимогоПоУмолчаниюXDTO);
	
	Для каждого КлючИЗначение Из Пакет.ДобавленныеЧасти Цикл
		
		ИмяЧасти      = КлючИЗначение.Ключ;
		ОписаниеЧасти = КлючИЗначение.Значение;
		
		Если ОписаниеЧасти.Свойство("СвязиXDTO", СвязиЧастиXDTO) Тогда
			ЗаписатьСвязиXDTO(Пакет, ИмяЧасти, СвязиЧастиXDTO);
		КонецЕсли;
		
		ПереопределениеТипаСодрежимогоXDTO = ФабрикаXDTO.Создать(
			ФабрикаXDTO.Тип("http://schemas.openxmlformats.org/package/2006/content-types", "CT_Override"));
		ПереопределениеТипаСодрежимогоXDTO.PartName = ИмяЧасти;
		ПереопределениеТипаСодрежимогоXDTO.ContentType = ОписаниеЧасти.ТипСодержимого;
		ТипыСодержимогоXDTO.Override.Добавить(ПереопределениеТипаСодрежимогоXDTO);
		
	КонецЦикла;
	
	Если Пакет.Свойство("СвязиXDTO", СвязиЧастиXDTO) Тогда
		ЗаписатьСвязиXDTO(Пакет, "", СвязиЧастиXDTO);
	КонецЕсли;
	
	ЗаписатьТипыСодержимогоXDTO(Пакет, ТипыСодержимогоXDTO);
	
	Пакет.ЗаписьZip.Добавить(Пакет.РабочийКаталог + "/*.*",
		РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
		РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
	
	Пакет.ЗаписьZip.Записать();
	
	Пакет.Завершен = Истина;
	Пакет.ДобавленныеЧасти = Неопределено;
	Пакет.ЗаписьZip = Неопределено;
	
	Если Пакет.УдалитьВременныеФайлы Тогда
		УдалитьФайлы(Пакет.РабочийКаталог);
	КонецЕсли;
	
КонецПроцедуры // ЗаписьЗакрыть()

Функция ЧтениеПолучитьСтруктуруЯдерныхСвойств(Знач Пакет) Экспорт
	
	Перем Результат;
	
	Если НЕ Пакет.Свойство("ЯдерныеСвойства", Результат) Тогда
		
		Relationships = ЧтениеПолучитьСвязиЧастиXDTO(Пакет, "");
		СвязьЯдерныеСвойства = Relationships.Получить("Relationship[Type='http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties']");
		Если СвязьЯдерныеСвойства <> Неопределено Тогда
			
			ПостроительDOM = Новый ПостроительDOM;
			ДокументDOM = ПостроительDOM.Прочитать(ЧтениеПолучитьXMLЧасть(Пакет, СвязьЯдерныеСвойства.Target));
			
			Свойства = Новый Соответствие;
			
			Для каждого ЭлементСвойстваDOM Из ДокументDOM.ЭлементДокумента.ДочерниеУзлы Цикл
				
				Если ЭлементСвойстваDOM.ТипУзла <> ТипУзлаDOM.Элемент Тогда
					Продолжить;
				КонецЕсли;
				
				Свойства.Вставить(ЭлементСвойстваDOM.ИмяЭлемента, ЭлементСвойстваDOM.ТекстовоеСодержимое);
				
			КонецЦикла;
			
			Результат = Новый ФиксированноеСоответствие(Свойства);
			Пакет.Вставить("ЯдерныеСвойства", Результат);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаписьПолучитьСтруктуруЯдерныхСвойств(Знач Пакет) Экспорт
	
	Перем Результат;
	
	Если Пакет.Завершен Тогда
		ВызватьИсключение ОшибкаПакетЗавершен(Пакет);
	КонецЕсли;
	
	Если НЕ Пакет.Свойство("ЯдерныеСвойства", Результат) Тогда
		
		Результат = Новый Соответствие;
		
		Результат.Вставить("cp:category",       "");
		Результат.Вставить("cp:contentStatus",  "");
		Результат.Вставить("cp:contentType",    "");
		Результат.Вставить("dcterms:created",   '00010101');
		Результат.Вставить("dc:creator",        "");
		Результат.Вставить("dc:description",    "");
		Результат.Вставить("dc:identifier",     "");
		Результат.Вставить("cp:keywords",       "");
		Результат.Вставить("dc:language",       "");
		Результат.Вставить("cp:lastModifiedBy", "");
		Результат.Вставить("cp:lastPrinted",    '00010101');
		Результат.Вставить("dcterms:modified",  '00010101');
		Результат.Вставить("cp:revision",       "");
		Результат.Вставить("dc:subject",        "");
		Результат.Вставить("dc:title",          "");
		Результат.Вставить("cp:version",        "");
		
		Пакет.Вставить("ЯдерныеСвойства", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

