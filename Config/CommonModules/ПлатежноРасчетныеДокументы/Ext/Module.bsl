	|	ФИОПерваяПодпись.Имя КАК ПерваяПодписьИмя,
	|	ФИОПерваяПодпись.Отчество КАК ПерваяПодписьОтчество,
	|	ФИОВтораяПодпись.Фамилия КАК ВтораяПодписьФамилия,
	|	ФИОВтораяПодпись.Имя КАК ВтораяПодписьИмя,
	|	ФИОВтораяПодпись.Отчество КАК ВтораяПодписьОтчество
	|ИЗ
	|	Документ.ЗаявкаНаКассовыйРасходСокращенная КАК ЗаявкаНаКассовыйРасход
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПерваяПодписьФИО КАК ФИОПерваяПодпись
	|		ПО ЗаявкаНаКассовыйРасход.ПерваяПодпись = ФИОПерваяПодпись.ПерваяПодпись
	|			И ЗаявкаНаКассовыйРасход.Дата = ФИОПерваяПодпись.Дата
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтораяПодписьФИО КАК ФИОВтораяПодпись
	|		ПО ЗаявкаНаКассовыйРасход.ВтораяПодпись = ФИОВтораяПодпись.ВтораяПодпись
	|			И ЗаявкаНаКассовыйРасход.Дата = ФИОВтораяПодпись.Дата
	|ГДЕ
	|	ЗаявкаНаКассовыйРасход.Ссылка В(&МассивОбъектов)";		   
	
	Результат = Запрос.Выполнить();
	Выборка	  = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураДанных = Новый Структура();
		
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);	
		КонецЦикла;
		
		// для печати даты в виде "__" ________ 20__ г.
		СтруктураДаты = РазложитьДатуДляПечати(Выборка.ДатаДок);
		СтруктураДанных.Вставить("ЧислоДаты", 			СтруктураДаты.Число);	
		СтруктураДанных.Вставить("МесяцДаты", 			СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", 			СтруктураДаты.Год);
		
		СтруктураДанных.Вставить("КодБКПлательщика", 	СтруктураДанных.КодГлавыПлательщика + СтруктураДанных.КодКПС + СтруктураДанных.КодАналитикиКПС); 
		
		// реквизиты, требующие преобразования
		СтруктураДанных.Вставить("ПерваяПодписьФИО", 	КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", СтруктураДанных.ПерваяПодписьФамилия, СтруктураДанных.ПерваяПодписьИмя, СтруктураДанных.ПерваяПодписьОтчество), Истина));					
		СтруктураДанных.Вставить("ВтораяПодписьФИО", 	КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", СтруктураДанных.ВтораяПодписьФамилия, СтруктураДанных.ВтораяПодписьИмя, СтруктураДанных.ВтораяПодписьОтчество), Истина));
		СтруктураДанных.Вставить("НомерДок",          	ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Выборка.Ссылка, СтруктураДанных.НомерДок));
		СтруктураДанных.Вставить("НомерЛС", 			СокрЛП(СтруктураДанных.НомерЛС));
		СтруктураДанных.Вставить("Глава", 				СокрЛП(СтруктураДанных.Глава));			
		СтруктураДанных.Вставить("КОФК", 				СокрЛП(СтруктураДанных.КОФК));
		Если СтруктураДанных.КФО = ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение") Тогда
			СтруктураДанных.Вставить("КодЦелиПлательщика", СокрЛП(СтруктураДанных.КодЦелиПлательщика) + Лев(СтруктураДанных.НаправлениеРасходованияВР, 2));
		КонецЕсли;
		
		СтруктураДанных.Вставить("ВыводитьРаздел_3", 	Ложь);
		
		Для Каждого ИмяРеквизита Из ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСписокНалоговыхРеквизитов() Цикл
			Если ЗначениеЗаполнено(СтруктураДанных[ИмяРеквизита]) Тогда
				СтруктураДанных.Вставить("ВыводитьРаздел_3", Истина);
				Прервать;
			КонецЕсли;
		КонецЦикла;	
		
		МассивСтруктурДанных.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Возврат МассивСтруктурДанных;
	
КонецФункции

// Возвращает массив структур, содержащих значения реквизитов Расходного расписания для печати или выгрузки
//
Функция ЗначенияРеквизитовРасходноеРасписание(МассивОбъектов, ИспользоватьДопКл = Ложь, ИспользоватьКодМероприятия = Ложь, ИспользоватьКЭК = Ложь, ИспользоватьАналитическийКод = Ложь, ИспользоватьКФО = Ложь, ИспользоватьКОСГУПолучателя = Ложь) Экспорт
	
	МассивСтруктурДанных = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасходноеРасписание.Руководитель,
	|	РасходноеРасписание.ОтветственныйИсполнитель,
	|	РасходноеРасписание.Дата
	|ПОМЕСТИТЬ ПодписиИДаты
	|ИЗ
	|	Документ.РасходноеРасписание КАК РасходноеРасписание
	|ГДЕ
	|	РасходноеРасписание.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РуководительФИО.Руководитель,
	|	РуководительФИО.Дата,
	|	ФИОФизическихЛиц.Фамилия,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество
	|ПОМЕСТИТЬ РуководительФИО
	|ИЗ
	|	(ВЫБРАТЬ
