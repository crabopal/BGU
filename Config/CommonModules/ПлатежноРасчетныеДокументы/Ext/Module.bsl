		СтруктураДанных.Расшифровка = Расшифровка.Скопировать(Новый Структура("Ссылка", Выборка.Ссылка));
		СтруктураДанных.Расшифровка.Колонки.Вставить(0, "НомерСтроки", Новый ОписаниеТипов("Число"));
		Для Каждого Стр ИЗ СтруктураДанных.Расшифровка Цикл
			Стр.НомерСтроки = СтруктураДанных.Расшифровка.Индекс(Стр) + 1;
		КонецЦикла;	  
		
		Если (НЕ СтруктураДанных.Расшифровка.Итог("Сумма") = СтруктураДанных.СуммаДокумента) Тогда
			СтруктураДанных.Вставить("пОшибка", "Сумма документа не равна итогу по таблице");
		КонецЕсли;
				
		МассивСтруктурДанных.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Возврат МассивСтруктурДанных;
	
КонецФункции	

