#Область СлужебныеПроцедурыИФункции

// Получает значения реквизитов справочника. В параметре "СтруктураРеквизитов" передаются
// реквизиты необходимые к получению. Ключ структуры содержит синоним, под которым выходные данные
// можно будет получить. Значение структуры содержит путь к получаемым данным. После выполнения
// процедуры значения структуры будут содержать значения реквизитов.
//
// Параметры:
//	ОбъектСсылка (СправочникСсылка). Ссылка на объект справочника, для которого получаем значения реквизитов
//	СтруктураРеквизитов (Структура). Структура получаемых реквизитов.
//				Ключ - синоним, под которым будет возвращено значение
//				Значение - значение соответствующего реквизита
//
Процедура ПолучитьЗначенияРеквизитовСправочника(ОбъектСсылка, СтруктураРеквизитов) 
	
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Для каждого КлючЗначение из СтруктураРеквизитов Цикл
			ТекРеквизит = КлючЗначение.Ключ;
			СтруктураРеквизитов.Вставить(ТекРеквизит, "");
		КонецЦикла;	
		Возврат;
	КонецЕсли;	
	
	ИмяСправочника = ОбъектСсылка.Метаданные().Имя;
	
	ПоляВыборки = "";
	Для каждого КлючЗначение из СтруктураРеквизитов Цикл
		ТекЗначение = КлючЗначение.Значение;
		ПутьКДанным = ?(ЗначениеЗаполнено(ТекЗначение), ТекЗначение,КлючЗначение.Ключ);
		ПоляВыборки = ПоляВыборки + "
					|	Справочник." + ПутьКДанным + " КАК " + КлючЗначение.Ключ + ", "
	КонецЦикла;	
	ПоляВыборки = Лев(ПоляВыборки, СтрДлина(ПоляВыборки) - 2);
	
	ТекстЗапроса = "ВЫБРАТЬ " + ПоляВыборки + "
					|ИЗ Справочник." + ИмяСправочника + " КАК Справочник
					|ГДЕ Справочник.Ссылка = &Ссылка";
					
	Запрос = Новый Запрос(ТекстЗапроса);				
	Запрос.УстановитьПараметр("Ссылка", ОбъектСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Для каждого КлючЗначение из СтруктураРеквизитов Цикл
		ТекРеквизит = КлючЗначение.Ключ;
		СтруктураРеквизитов.Вставить(ТекРеквизит, Выборка[ТекРеквизит]);
	КонецЦикла;
	
	Если СтруктураРеквизитов.Свойство("КассовыйОрган")
		И СтруктураРеквизитов.Свойство("СчетКассовыйОрганНаименование")
		И ТипЗнч(СтруктураРеквизитов.КассовыйОрган) = Тип("СправочникСсылка.Банки") 
		И ЗначениеЗаполнено(СтруктураРеквизитов.КассовыйОрган.БИКРКЦ) Тогда
		
		ИмяРКЦ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРеквизитов.КассовыйОрган.БИКРКЦ, "Наименование");
		
		Если ЗначениеЗаполнено(ИмяРКЦ) Тогда
			СтруктураРеквизитов.СчетКассовыйОрганНаименование = СокрЛП(ИмяРКЦ) + "//" + СтруктураРеквизитов.СчетКассовыйОрганНаименование;
		КонецЕсли;
	КонецЕсли;	 	
	
КонецПроцедуры	

// Процедура возвращает значения ИНН, КПП и Наименование Контрагента
Процедура ПолучитьЗначенияРеквизитовКонтрагента(ОбъектСсылка, СтруктураРеквизитов)
	 
	Если ТипЗнч(ОбъектСсылка)<>Тип("СправочникСсылка.Контрагенты") и НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Для каждого КлючЗначение из СтруктураРеквизитов Цикл
			ТекРеквизит = КлючЗначение.Ключ;
			СтруктураРеквизитов.Вставить(ТекРеквизит, "");
		КонецЦикла;	
		Возврат;
	КонецЕсли;	                                             
	
	РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектСсылка, "Наименование, НаименованиеСокращенное");	
	
	СтруктураРеквизитов.Наименование		= РеквизитыКонтрагента.Наименование;
	СтруктураРеквизитов.НаименованиеПолное  = РеквизитыКонтрагента.НаименованиеСокращенное;
	
	РеквизитыКонтрагента = Новый Структура("СсылкаНаОбъект, ИНН, КПП, НаименованиеПолное", ОбъектСсылка);
	Справочники.Контрагенты.ПолучитьДанныеКонтрагента(РеквизитыКонтрагента);
		
	СтруктураРеквизитов.ИНН					= РеквизитыКонтрагента.ИНН;
	СтруктураРеквизитов.КПП					= РеквизитыКонтрагента.КПП;
	СтруктураРеквизитов.НаименованиеПолное	= ?(ЗначениеЗаполнено(СтруктураРеквизитов.НаименованиеПолное), 
												СтруктураРеквизитов.НаименованиеПолное, РеквизитыКонтрагента.НаименованиеПолное);
		
	
КонецПРоцедуры

Функция ПолучитьТекстЗапросаСостояния() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	ПоляВыборки = "";
	//  Струкутра реквизитов динамическая, т.к. со временем может понадобится новый ресурс в регистр
	//  что-бы его не забыть будем каждый раз перебирать ресурсы регистра
	Для каждого Ресурс из Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Ресурсы цикл
		СтруктураРеквизитов.Вставить(Ресурс.Имя);
		ПоляВыборки = ПоляВыборки + "
		|	Состояние." + Ресурс.Имя + " КАК " + Ресурс.Имя + ", "
	КонецЦикла;	
	//  Добавка ввиде реквизита "ПервичныйОбразИРеквизиты"
	СтруктураРеквизитов.Вставить("ПервичныйОбразИРеквизиты");
	СтруктураРеквизитов.Вставить("Кратность");
	ПоляВыборки = ПоляВыборки + "
	|	Состояние.ПервичныйОбразИРеквизиты КАК ПервичныйОбразИРеквизиты";
	ПоляВыборки = ПоляВыборки + ",
	|	1 КАК Кратность ";
		
	ТекстЗапроса = "ВЫБРАТЬ " + ПоляВыборки + "
					|ИЗ	
					|	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК Состояние
					|ГДЕ 
					|	Состояние.ПлатежноРасчетныйДокумент = &Ссылка";
	
	Возврат Новый Структура("СтруктураРеквизитов, ТекстЗапроса", СтруктураРеквизитов, ТекстЗапроса);
	
КонецФункции

// Возвращает адреса в формате код страны//наименование города//уличный адрес
//
// Параметры:
//	КонтактнаяИнформация - ТаблицаЗначений, Структура - Таблица с контактной информацией объекта , возвращаемая функцией
//							УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта
//							либо Структура с ключами КодСтраны, Город, УличныйАдрес и строковыми значениями
Функция АдресВФорматеСбербанка(КонтактнаяИнформация)
	
	Если ТипЗнч(КонтактнаяИнформация) = Тип("ТаблицаЗначений") И КонтактнаяИнформация.Количество() > 0 Тогда
		
		АдресJSON = КонтактнаяИнформация[0].Значение;
		
		КодСтраны = УправлениеКонтактнойИнформацией.СтранаАдресаКонтактнойИнформации(АдресJSON).КодАльфа2;
		Город = РаботаСАдресами.ГородАдресаКонтактнойИнформации(АдресJSON);
		
		ПоляАдреса = УправлениеКонтактнойИнформациейСлужебный.JSONВКонтактнуюИнформациюПоПолям(АдресJSON, Перечисления.ТипыКонтактнойИнформации.Адрес);
		УличныйАдрес = СокрЛП(ПоляАдреса.street + " " + ПоляАдреса.streetType);
		
	ИначеЕсли ТипЗнч(КонтактнаяИнформация) = Тип("Структура") Тогда
		
		КодСтраны = КонтактнаяИнформация.КодСтраны;
		Город = КонтактнаяИнформация.Город;
		УличныйАдрес = КонтактнаяИнформация.УличныйАдрес;
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
	Если ПустаяСтрока(КодСтраны + Город + УличныйАдрес) Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат КодСтраны + "//" + Город + "//" + УличныйАдрес;
	
КонецФункции

Функция ПолучитьРасчетныйСчетКонтрагента(Контрагент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БанковскиеИКазначейскиеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеИКазначейскиеСчета
	|ГДЕ
	|	БанковскиеИКазначейскиеСчета.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();

КонецФункции

Функция ПроверкаНаТаблицу(ЭлементИсточник,ИмяТаблицы)
	Если ЭлементИсточник.Родитель = неопределено тогда
		Если ЭлементИсточник.Таблица тогда
			ИмяТаблицы = ЭлементИсточник.Поле;
		КонецЕсли;	
		Возврат ЭлементИсточник.Таблица;
	Иначе	
		Возврат ПроверкаНаТаблицу(ЭлементИсточник.Родитель,ИмяТаблицы)
	КонецЕсли;	
КонецФункции	

Процедура ДобавитьПодчиненныеУзел(ПриемникЗначения, ИсточникЗначения,Уровень,МаксУровеньДобавляемыхРеквизитов)
	
	Для Каждого ЭлементИсточник Из ИсточникЗначения Цикл
		ФильтрЗаголовок = ВРЕГ(ЭлементИсточник.Заголовок);
		Если Найти(ЭлементИсточник.Заголовок, "Ссылка") > 0 ИЛИ 
			Найти(ЭлементИсточник.Заголовок, "Версия данных") > 0 ИЛИ 
			Найти(ЭлементИсточник.Заголовок, "Порядок") > 0 ИЛИ 
			Найти(ЭлементИсточник.Заголовок, "Предопределенный") > 0 ИЛИ
			Найти(ЭлементИсточник.Заголовок, "Пометка удаления") > 0 ИЛИ
			Найти(ЭлементИсточник.Заголовок, "Проведен") > 0 ИЛИ
			Найти(Строка(ЭлементИсточник.Поле), "Родитель.Родитель") > 0 ИЛИ
			Найти(Строка(ЭлементИсточник.Поле), "ГоловнаяОрганизация.ГоловнаяОрганизация") > 0 ИЛИ
			Найти(ЭлементИсточник.Заголовок, "Группа.Группа") > 0 ИЛИ
			Найти(ФильтрЗаголовок, "ЭТО ГРУППА") > 0 ИЛИ
			(Найти(ФильтрЗаголовок, "ГРУППА") > 0 И Найти(ФильтрЗаголовок, "ГРУППА ") = 0) ИЛИ
			Найти(ФильтрЗаголовок, "РОДИТЕЛЬ") > 0 ИЛИ
			Найти(ФильтрЗаголовок, "ВЛАДЕЛЕЦ") > 0 ИЛИ
			ЭлементИсточник.Заголовок = "Системные поля" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Найти(ЭлементИсточник.Заголовок, "Владелец") > 0 И ЭлементИсточник.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Организации")) Тогда
			Продолжить;
		КонецЕсли;	
		Если ЭлементИсточник.Таблица И НЕ ЭлементИсточник.Родитель = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		Если ЭлементИсточник.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Валюты")) И НЕ ЭлементИсточник.Родитель = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		ЭлементПриемник = ПриемникЗначения.ПолучитьЭлементы().Добавить();
		ЭлементПриемник.Имя 		= ЭлементИсточник.Заголовок;
		ЭлементПриемник.ПутьКДанным = ЭлементИсточник.Поле;
		ЭлементПриемник.Таблица		= ПроверкаНаТаблицу(ЭлементИсточник,ЭлементПриемник.ИмяТаблицы);
		ЭлементПриемник.Тип			= ЭлементИсточник.Тип;
		
		
		Если ЭлементИсточник.Родитель = Неопределено тогда
			ЭлементПриемник.Представление	= ЭлементИсточник.Заголовок;
		Иначе	
			ЭлементПриемник.Представление	= Прав(ЭлементИсточник.Заголовок,СтрДлина(ЭлементИсточник.Заголовок)-СтрДлина(ЭлементИсточник.Родитель.Заголовок)-1);
		Конецесли;	
		
		Если Уровень >= МаксУровеньДобавляемыхРеквизитов тогда
			Продолжить;
		КонецЕсли;	
		
		Если ЭлементИсточник.Элементы.Количество() > 0 Тогда
			ДобавитьПодчиненныеУзел(ЭлементПриемник, ЭлементИсточник.Элементы,Уровень+1,МаксУровеньДобавляемыхРеквизитов);
		КонецЕсли;
		
	КонецЦикла;	 
	
КонецПроцедуры

// Определяет необходимость проверки расшифровки ведомости компенсации родительской платы.
// При подготовке источника данных ТаблицаРасчетовСПолучателямиКомпенсацииРодительскойПлаты
// сопоставление выпоняется без учета КФО и КПС, если КФО и КПС не заполнены, поэтому проверка не нужна. 
//
// Параметры:
//	Ведомость - ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате
//	          - ДокументОбъект.ВедомостьКомпенсацииРодительскойПлатыКВыплате
//
// Возвращаемое значение:
//   Булево - Истина, если проверку расшифровки не нужно выполнять (КПС во всех строках ведомости не заполнен)
//
Функция НеПроверятьРасшифровкуКомпенсацииРодительскойПлаты(Ведомость)
	
	НеПроверятьРасшифровку = Истина;
	
	Если ТипЗнч(Ведомость) = Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ИСТИНА КАК Поле1
			|ИЗ
			|	Документ.ВедомостьКомпенсацииРодительскойПлатыКВыплате.ВедомостьКомпенсации КАК ВедомостьКомпенсации
			|ГДЕ
			|	ВедомостьКомпенсации.Ссылка = &ДокументСсылка
			|	И ВедомостьКомпенсации.КПС <> ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
			|	И ВедомостьКомпенсации.КФО <> ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)";

		Запрос.УстановитьПараметр("ДокументСсылка", Ведомость);
		РезультатЗапроса = Запрос.Выполнить();
		НеПроверятьРасшифровку = РезультатЗапроса.Пустой();
	ИначеЕсли ТипЗнч(Ведомость) = Тип("ДокументОбъект.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
		Для Каждого Строка Из Ведомость.ВедомостьКомпенсации Цикл
			Если ЗначениеЗаполнено(Строка.КПС) И ЗначениеЗаполнено(Строка.КФО) Тогда
				НеПроверятьРасшифровку = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		НеПроверятьРасшифровку = Ложь;
	КонецЕсли;
	
	Возврат НеПроверятьРасшифровку;
	
КонецФункции

// Параметры:
//	Ведомость - ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате
//	          - ДокументОбъект.ВедомостьКомпенсацииРодительскойПлатыКВыплате
//	ПлатежныйДокумент - ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная
//	                  - ДокументОбъект.ЗаявкаНаКассовыйРасходСокращенная
//	                  - ДокументСсылка.ЗаявкаНаКассовыйРасход
//	                  - ДокументОбъект.ЗаявкаНаКассовыйРасход
//	                  - ДокументСсылка.ПлатежноеПоручение
//	                  - ДокументОбъект.ПлатежноеПоручение
//	                  - ДокументСсылка.КассовоеВыбытие
//	                  - ДокументОбъект.КассовоеВыбытие
//	                  - ДокументСсылка.РСКППеречисление
//	                  - ДокументОбъект.РСКППеречисление
//	Отказ - Булево - признак несоответствия
//
Процедура ПроверитьПлатежныйДокументНаСоответствиеВедомостиОбщейСуммой(Ведомость, ПлатежныйДокумент, Отказ)
	
	СуммаВедомости = 0;
	СуммаПлатежногоДокумента = 0;
	
	Если ТипЗнч(Ведомость) = Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(ВедомостьКомпенсации.СуммаКомпенсации) КАК Сумма
		|ИЗ
		|	Документ.ВедомостьКомпенсацииРодительскойПлатыКВыплате.ВедомостьКомпенсации КАК ВедомостьКомпенсации
		|ГДЕ
		|	ВедомостьКомпенсации.Ссылка = &ДокументСсылка
		|	И НЕ ВедомостьКомпенсации.Аннулировано";
		
		Запрос.УстановитьПараметр("ДокументСсылка", Ведомость);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СуммаВедомости = Выборка.Сумма;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Ведомость) = Тип("ДокументОбъект.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда 
		Для Каждого Строка Из Ведомость.ВедомостьКомпенсации Цикл
			Если Строка.Аннулировано Тогда
				Продолжить;
			КонецЕсли;
			СуммаВедомости = СуммаВедомости + Строка.СуммаКомпенсации;
		КонецЦикла;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход")
		Или ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.КассовоеВыбытие")
		Или ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.РСКППеречисление") Тогда
			
		СуммаПлатежногоДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежныйДокумент, "СуммаДокументаВВалюте");

	ИначеЕсли ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.ЗаявкаНаКассовыйРасход")
		Или ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.КассовоеВыбытие")
		Или ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.РСКППеречисление") Тогда
			
		СуммаПлатежногоДокумента = ПлатежныйДокумент.СуммаДокументаВВалюте;
		
	ИначеЕсли ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная")
	 	Или ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.ПлатежноеПоручение") Тогда
	 		
		СуммаПлатежногоДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежныйДокумент, "СуммаДокумента");
		
	ИначеЕсли ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.ЗаявкаНаКассовыйРасходСокращенная")
		Или ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.ПлатежноеПоручение") Тогда
			
		СуммаПлатежногоДокумента = ПлатежныйДокумент.СуммаДокумента;
		
	КонецЕсли;
	
	Если СуммаВедомости <> СуммаПлатежногоДокумента Тогда
		ТекстСообщения = СтрШаблон(НСтр(
			"ru='Обнаружено расхождение данных ведомости ""%1"" и расчетно-платежного документа ""%2"":
			|сумма ведомости ""%3"" не равна сумме расчетно-платежного документа ""%4""'"),
			Ведомость, ПлатежныйДокумент,
			Формат(СуммаВедомости, "ЧДЦ=2; ЧН="),
			Формат(СуммаПлатежногоДокумента, "ЧДЦ=2; ЧН="));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстАналитикиПроверкаВедомости(Выборка, ЭтоВедомостьВБанк)

	Если ЭтоВедомостьВБанк Тогда
		ТекстАналитики = СтрШаблон(НСтр(
			"ru='КФО %1, КПС %2, КЭК %3, коду цели ""%4"", коду мероприятия ""%5"", доп. классификации ""%6""'"),
			Выборка.КФО, Выборка.КПС, Выборка.КЭК, Выборка.КодЦели, Выборка.КодМероприятия, Выборка.ДопКлассификация);
	Иначе
		ТекстАналитики = СтрШаблон(НСтр("ru='КФО %1, КПС %2, КЭК %3'"), Выборка.КФО, Выборка.КПС, Выборка.КЭК);
	КонецЕсли;

	Возврат ТекстАналитики;

КонецФункции

#КонецОбласти

