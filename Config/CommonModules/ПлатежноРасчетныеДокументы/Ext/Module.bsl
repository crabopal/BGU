	МассивРезультатов = Запрос.ВыполнитьПакет();
	// 0 ПодписиИДаты
	// 1 РуководительФИО
	// 2 РуководительДолжность
	// 3 СведенияОбОперацияхСоСредствамиВР
	// 4 СведенияОбОперацияхСоСредствамиВРСведения
	
	Выборка = МассивРезультатов[3].Выбрать();	
	Список 	= МассивРезультатов[4].Выгрузить();

	Пока Выборка.Следующий() Цикл
		
		СтруктураДанных = Новый Структура; // ("Список", Новый ТаблицаЗначений);
		
		Для Каждого Колонка ИЗ МассивРезультатов[3].Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);	
		КонецЦикла;
		
		// для печати даты в виде "__" ________ 20__ г.
		СтруктураДаты = РазложитьДатуДляПечати(Выборка.ДатаДок);
        СтруктураДанных.Вставить("ЧислоДаты", 			СтруктураДаты.Число);	
		СтруктураДанных.Вставить("МесяцДаты", 			СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", 			СтруктураДаты.Год);
		
		СтруктураДаты = РазложитьДатуДляПечати(Выборка.ДатаУтверждения);
        СтруктураДанных.Вставить("ЧислоДатыУтв", 		СтруктураДаты.Число);	
		СтруктураДанных.Вставить("МесяцДатыУтв", 		СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДатыУтв", 			СтруктураДаты.Год);

		СтруктураДаты = РазложитьДатуДляПечати(Выборка.ДатаПодписи);
        СтруктураДанных.Вставить("ЧислоДатыРук", 		СтруктураДаты.Число);	
		СтруктураДанных.Вставить("МесяцДатыРук", 		СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДатыРук", 			СтруктураДаты.Год);

		
		// реквизиты, требующие преобразования
		СтруктураДанных.Вставить("НомерДокумента", 	ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Выборка.Ссылка, СтруктураДанных.НомерДок));
		
		СтруктураДанных.Вставить("РуководительФИО", 
		СокрЛП(СтруктураДанных.РуководительФамилия) + " " +
		СокрЛП(СтруктураДанных.РуководительИмя) + " " +
		СокрЛП(СтруктураДанных.РуководительОтчество));
		
		СтруктураДанных.Вставить("РуководительФамилияИнициалы",
		КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", 
		СтруктураДанных.РуководительФамилия, 
		СтруктураДанных.РуководительИмя, 
		СтруктураДанных.РуководительОтчество)));
		
		СтруктураДанных.Вставить("НаименованиеГРБС_РП", СклонениеПредставленийОбъектов.ПросклонятьПредставление(СтруктураДанных.НаименованиеГРБС, 2, СтруктураДанных.ГлаваСсылка));

		ГрифУтверждения = "";
		ФИОУтвердившего = "";
				
		Если СтруктураДанных.УтверждаетсяГРБС Тогда
			ГрифУтверждения = СтруктураДанных.ДолжностьУтвердившегоГРБС	+ " " + СтруктураДанных.НаименованиеГРБС_РП;
			ФИОУтвердившего = СтруктураДанных.ФИОУтвердившегоГРБС;
		Иначе
			ГрифУтверждения = СтруктураДанных.РуководительДолжность;
			ФИОУтвердившего = СтруктураДанных.РуководительФамилияИнициалы;
		КонецЕсли;	
		
		СтруктураДанных.Вставить("ГрифУтверждения", ГрифУтверждения);
		СтруктураДанных.Вставить("ФИОУтвердившего", ФИОУтвердившего);
		
		ВыборкаСписок = Список.Скопировать(Новый Структура("Ссылка", Выборка.Ссылка));
		
		Для Каждого Стр Из ВыборкаСписок Цикл
			
			Стр.КодСредств = "" + СтруктураДанных.Глава + СтруктураДанных.КодРПБС + Стр.КодНПА;
			
		КонецЦикла;	

		ВыборкаСписок.Сортировать("НомерСтроки");
		
		СтруктураДанных.Вставить("Список", ВыборкаСписок);
		
		МассивСтруктурДанных.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Возврат МассивСтруктурДанных;
	
КонецФункции	

