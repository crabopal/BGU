	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КВД.ВременноеРаспоряжение)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)
	|	КОНЕЦ " + ?(ЗначениеЗаполнено(Псевдоним), "КАК " + Псевдоним, "");
		
	
КонецПроцедуры	

Функция РСКПВКонечномСтатусе(РСКПСсылка) Экспорт
	
	ТекущееСостояние = ПолучитьСостояниеЗаявки(РСКПСсылка);
	
	МассивКонСтатусов = МассивКонечныхСтатусов();
	Если МассивКонСтатусов.Найти(ТекущееСостояние.Статус) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция МассивКонечныхСтатусов() Экспорт
	МассивКонСтатусов = Новый Массив;
	МассивКонСтатусов.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Аннулирован"));
	МассивКонСтатусов.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен"));
	МассивКонСтатусов.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.ИсполненЧастично"));
	Возврат МассивКонСтатусов;
КонецФункции


