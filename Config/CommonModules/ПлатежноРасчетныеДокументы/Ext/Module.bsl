	|			ТОГДА ВЫБОР
	|					КОГДА ПОДСТРОКА(ЗаявкаНаКассовыйРасход.КБКНазначениеПлатежа.Код, 1, 2) = ""02""
	|						ТОГДА ""32""
	|					ИНАЧЕ ""31""
	|				КОНЕЦ
	|		КОГДА ЗаявкаНаКассовыйРасход.КБКНазначениеПлатежа.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.Произвольный)
	|			ТОГДА ВЫБОР
	|					КОГДА ПОДСТРОКА(ЗаявкаНаКассовыйРасход.КОСГУНазначениеПлатежа.Код, 1, 1) = ""2""
