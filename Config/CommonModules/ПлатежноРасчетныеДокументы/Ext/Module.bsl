		ИЛИ ТипЗнч(РеквизитыСчета) = Тип("СправочникОбъект.РеквизитыЛицевыхСчетов")
		ИЛИ ТипЗнч(РеквизитыСчета) = Тип("ДанныеФормыСтруктура") Тогда
		Счет = РеквизитыСчета.Ссылка;
	Иначе
		Счет = РеквизитыСчета;
	КонецЕсли;	
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("СчетКассовыйОрганНаименование", 	"КассовыйОрган.Наименование");
	СтруктураРеквизитов.Вставить("КассовыйОрган");
	СтруктураРеквизитов.Вставить("СчетКазначейства");
	СтруктураРеквизитов.Вставить("КорреспондентТекст");
	СтруктураРеквизитов.Вставить("КорреспондентИНН");
	СтруктураРеквизитов.Вставить("КорреспондентКПП");
	СтруктураРеквизитов.Вставить("ФилиалБанка");
    СтруктураРеквизитов.Вставить("МестонахождениеФилиалаБанка");
	СтруктураРеквизитов.Вставить("БанкДляРасчетов");
	СтруктураРеквизитов.Вставить("СчетБанкДляРасчетовНаименование", "БанкДляРасчетов.Наименование");
    СтруктураРеквизитов.Вставить("СчетБанкДляРасчетовГород", 		"БанкДляРасчетов.Город");
    СтруктураРеквизитов.Вставить("СчетБанкДляРасчетовКод", 			"БанкДляРасчетов.Код");
	СтруктураРеквизитов.Вставить("СчетБанкДляРасчетовКоррСчет", 	"БанкДляРасчетов.КоррСчет");
						
	Если ТипЗнч(Счет) = Тип("СправочникСсылка.БанковскиеИКазначейскиеСчета") Тогда 
		СтруктураРеквизитов.Вставить("ТипЛицевогоСчета");
		СтруктураРеквизитов.Вставить("Код");
	Иначе
		СтруктураРеквизитов.Вставить("ТипЛицевогоСчета", "Владелец.ТипЛицевогоСчета");
		СтруктураРеквизитов.Вставить("Код", "Владелец.Код");
	КонецЕсли;	
	
	Если ТипЗнч(РеквизитыСчета) = Тип("СправочникОбъект.БанковскиеИКазначейскиеСчета") 
		ИЛИ ТипЗнч(РеквизитыСчета) = Тип("СправочникОбъект.РеквизитыЛицевыхСчетов")
		ИЛИ ТипЗнч(РеквизитыСчета) = Тип("ДанныеФормыСтруктура") Тогда
		
		Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
			Если НЕ ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
				СтруктураРеквизитов.Вставить(КлючИЗначение.Ключ,РеквизитыСчета[КлючИЗначение.Ключ]);
			Иначе
				ИскомыйМассив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КлючИЗначение.Значение,".");
				ЭтоРевизитСправочника = Истина;
				Для Каждого ЭлМас Из ИскомыйМассив Цикл
					Если ЭтоРевизитСправочника Тогда
						ТекЗначение = РеквизитыСчета[ЭлМас];
						ЭтоРевизитСправочника = Ложь;
						Продолжить;
					КонецЕсли;
					Если ТекЗначение<>Неопределено Тогда
						Попытка
							ТекЗначение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекЗначение,ЭлМас);
						Исключение
							ТекЗначение = Неопределено;
						КонецПопытки;
					Иначе
						ТекЗначение = Неопределено;
					КонецЕсли;
				КонецЦикла;
				СтруктураРеквизитов.Вставить(КлючИЗначение.Ключ,ТекЗначение);
			КонецЕсли;
		КонецЦикла;
		
	Иначе	
   		ПолучитьЗначенияРеквизитовСправочника(Счет, СтруктураРеквизитов);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураРеквизитов.КорреспондентТекст) Тогда
		ЗаполнитьКорреспондента = Ложь;
		ПлатежныеРеквизиты.Корреспондент = СтруктураРеквизитов.КорреспондентТекст;
	ИначеЕсли СтруктураРеквизитовЛС.ИспользоватьВПлатежныхДокументахСокращенноеНаименование Тогда
		ПлатежныеРеквизиты.Корреспондент = СтруктураРеквизитовЛС.НаименованиеСокращенное;
	Иначе	
		ПлатежныеРеквизиты.Корреспондент = ?(ЗначениеЗаполнено(СтруктураРеквизитовЛС.НаименованиеПолное), СтруктураРеквизитовЛС.НаименованиеПолное, СтруктураРеквизитовЛС.Наименование);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураРеквизитов.КорреспондентИНН) Тогда
		ПлатежныеРеквизиты.ИНН = СтруктураРеквизитов.КорреспондентИНН;
	Иначе
		ПлатежныеРеквизиты.ИНН	= СтруктураРеквизитовЛС.ИНН;
	КонецЕсли;
	
    Если ЗначениеЗаполнено(СтруктураРеквизитов.КорреспондентКПП) Тогда
		ПлатежныеРеквизиты.КПП = СтруктураРеквизитов.КорреспондентКПП;
	Иначе
		ПлатежныеРеквизиты.КПП	= СтруктураРеквизитовЛС.КПП;
	КонецЕсли;

	СчетКод							= СокрЛП(СтруктураРеквизитов.Код);
    КассовыйОрганСчета 				= СтруктураРеквизитов.КассовыйОрган;
	КассовыйОрганСчетаНаименование 	= СтруктураРеквизитов.СчетКассовыйОрганНаименование;
	
	Если ЭтоСчетКонтрагента Тогда
		ПолучательСтандарт = НЕ ПолучательСтандарт;
	КонецЕсли;	
	
	МассивОбойденныхСчетов = Новый Массив;
	
	Пока ЗначениеЗаполнено(КассовыйОрганСчета) Цикл
		
		Если  ТипЗнч(КассовыйОрганСчета) = Тип("СправочникСсылка.Банки") Тогда
			Если ЭтоСчетКонтрагента Тогда
				НомерСчета = СокрЛП(СчетКод);
			КонецЕсли;	
			Прервать;
		КонецЕсли;
		
		Если МассивОбойденныхСчетов.Найти(Счет)<>Неопределено Тогда
			КоличествоСчетов = МассивОбойденныхСчетов.Количество();
			Если КоличествоСчетов = 1 Тогда
				ПроблемныйСчет = МассивОбойденныхСчетов[0];
			Иначе
				ПроблемныйСчет = МассивОбойденныхСчетов[КоличествоСчетов-2];
			КонецЕсли;
			
			ПлатежныеРеквизиты.ИНН = "<Нет>";
			ПлатежныеРеквизиты.КПП = "<Нет>";
			ПлатежныеРеквизиты.Корреспондент = "<Ошибка в данных. Данные не получены>";
			
			Для Каждого КлючИЗначние Из СтруктураПлатежныхРеквизитов Цикл
				ЗначениеРеквизита = "";
				ПлатежныеРеквизиты.Свойство(КлючИЗначние.Значение, ЗначениеРеквизита);
				СтруктураПлатежныхРеквизитов.Вставить(КлючИЗначние.Ключ, ЗначениеРеквизита);
			КонецЦикла;

			//этот счет уже обходили, значит зациклилось...
			//ошибка в данных - в справочнике реквизите Л.С. или Банковские и казначейские счета
			ТекстОшибки = НСтр("ru='Внимание! Обнаружены некорректные данные!
			|Обнаружено зацикливание в справочнике ""Банковские и казначейские счета"".
			|Проверьте корректность данных в реквизите ""Счет казначейства"" в элементе """+ ПроблемныйСчет +""".'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			Возврат;
		Иначе
			МассивОбойденныхСчетов.Добавить(Счет);
		КонецЕсли;
		Счет = СтруктураРеквизитов.СчетКазначейства; 
		СтруктураРеквизитов = Новый Структура;
		СтруктураРеквизитов.Вставить("Код"); 
		СтруктураРеквизитов.Вставить("КассовыйОрган"); 
		СтруктураРеквизитов.Вставить("СчетКазначейства"); 
		СтруктураРеквизитов.Вставить("ТипЛицевогоСчета"); 
		СтруктураРеквизитов.Вставить("БанкДляРасчетов");
		СтруктураРеквизитов.Вставить("СчетБанкДляРасчетовНаименование", "БанкДляРасчетов.Наименование");
		СтруктураРеквизитов.Вставить("СчетБанкДляРасчетовГород", 		"БанкДляРасчетов.Город");
    	СтруктураРеквизитов.Вставить("СчетБанкДляРасчетовКод", 			"БанкДляРасчетов.Код");
    	СтруктураРеквизитов.Вставить("СчетБанкДляРасчетовКоррСчет", 	"БанкДляРасчетов.КоррСчет");
		СтруктураРеквизитов.Вставить("СчетКассовыйОрганНаименование", 	"КассовыйОрган.Наименование");
		СтруктураРеквизитов.Вставить("ФилиалБанка");
		СтруктураРеквизитов.Вставить("МестонахождениеФилиалаБанка");
			
		ПолучитьЗначенияРеквизитовСправочника(Счет, СтруктураРеквизитов);
		СчетКод					= СтруктураРеквизитов.Код;
		СчетТипЛицевогоСчета 	= СтруктураРеквизитов.ТипЛицевогоСчета;
		
		Если ЗаполнитьКорреспондента Тогда
			Если СчетТипЛицевогоСчета = ПризнакКазначейского Тогда
				ПлатежныеРеквизиты.Корреспондент = КассовыйОрганСчетаНаименование + ", л/с " + СокрЛП(СчетКод) + ", " + ПлатежныеРеквизиты.Корреспондент;
			Иначе
				Если ПолучательСтандарт Тогда
					ДопНомерСчета = ", л/с " + НомерСчета;
				Иначе
					ДопНомерСчета = "";
				КонецЕсли;	
				ПлатежныеРеквизиты.Корреспондент = КассовыйОрганСчетаНаименование + " (" + ПлатежныеРеквизиты.Корреспондент + ДопНомерСчета + ")";
			КонецЕсли;
			КассовыйОрганСчетаНаименование 	= СтруктураРеквизитов.СчетКассовыйОрганНаименование;
		КонецЕсли;
		КассовыйОрганСчета 				= СтруктураРеквизитов.КассовыйОрган;
		
	КонецЦикла;	
	
	Если НЕ ЗначениеЗаполнено(КассовыйОрганСчета) Тогда
		Для Каждого КлючИЗначние Из СтруктураПлатежныхРеквизитов Цикл
			СтруктураПлатежныхРеквизитов.Вставить(КлючИЗначние.Ключ, "");
		КонецЦикла;	
		Возврат;
	КонецЕсли;	
	
	СтруктураРеквизитовБСч = Новый Структура;
	СтруктураРеквизитовБСч.Вставить("СчетКассовыйОрганГород", 			"Город");
	СтруктураРеквизитовБСч.Вставить("СчетКассовыйОрганКоррСчет", 		"КоррСчет");
	СтруктураРеквизитовБСч.Вставить("СчетКассовыйОрганКод", 			"Код");
    ПолучитьЗначенияРеквизитовСправочника(КассовыйОрганСчета, СтруктураРеквизитовБСч);
		
	Если ЗаполнитьКорреспондента Тогда
		Если ЗначениеЗаполнено(СтруктураРеквизитов.ФилиалБанка) Тогда
			ПлатежныеРеквизиты.Корреспондент = ПлатежныеРеквизиты.Корреспондент + " в "+ СтруктураРеквизитов.ФилиалБанка;
			Если ЗначениеЗаполнено(СтруктураРеквизитов.МестонахождениеФилиалаБанка) Тогда
				ПлатежныеРеквизиты.Корреспондент = ПлатежныеРеквизиты.Корреспондент + " "+ СтруктураРеквизитов.МестонахождениеФилиалаБанка;	 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураРеквизитов.БанкДляРасчетов) Тогда
		Если ЗаполнитьКорреспондента Тогда	
			ПлатежныеРеквизиты.Корреспондент = ПлатежныеРеквизиты.Корреспондент + " сч. № " + СчетКод //НомерСчета в плательщика/получателя
			+ " в " + СтруктураРеквизитов.СчетКассовыйОрганНаименование
			+ " " + СтруктураРеквизитовБСч.СчетКассовыйОрганГород;
		КонецЕсли;	
		ПлатежныеРеквизиты.СчетНомер 	= СтруктураРеквизитовБСч.СчетКассовыйОрганКоррСчет;
		ПлатежныеРеквизиты.Банк 		= СтруктураРеквизитов.СчетБанкДляРасчетовНаименование;
		Если ГородВНаименованииБанка Тогда
			ПлатежныеРеквизиты.Банк = ПлатежныеРеквизиты.Банк + " " + СтруктураРеквизитов.СчетБанкДляРасчетовГород;
		КонецЕсли;	
		ПлатежныеРеквизиты.Город        = СтруктураРеквизитов.СчетБанкДляРасчетовГород;
		ПлатежныеРеквизиты.БИК 		  	= СтруктураРеквизитов.СчетБанкДляРасчетовКод;
		ПлатежныеРеквизиты.КоррСчет     = СтруктураРеквизитов.СчетБанкДляРасчетовКоррСчет;
	Иначе
		ПлатежныеРеквизиты.СчетНомер 	= СокрЛП(СчетКод);
		Если ЗначениеЗаполнено(КассовыйОрганСчета) Тогда
			ПлатежныеРеквизиты.Банк 	= СтруктураРеквизитов.СчетКассовыйОрганНаименование;
			Если ГородВНаименованииБанка Тогда
				ПлатежныеРеквизиты.Банк = ПлатежныеРеквизиты.Банк + " " + СтруктураРеквизитовБСч.СчетКассовыйОрганГород;
			КонецЕсли;
			ПлатежныеРеквизиты.Город    = СтруктураРеквизитовБСч.СчетКассовыйОрганГород;
			ПлатежныеРеквизиты.БИК 		= СтруктураРеквизитовБСч.СчетКассовыйОрганКод;
			ПлатежныеРеквизиты.КоррСчет = СтруктураРеквизитовБСч.СчетКассовыйОрганКоррСчет;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого КлючИЗначние Из СтруктураПлатежныхРеквизитов Цикл
		ЗначениеРеквизита = "";
		ПлатежныеРеквизиты.Свойство(КлючИЗначние.Значение, ЗначениеРеквизита);
		СтруктураПлатежныхРеквизитов.Вставить(КлючИЗначние.Ключ, ЗначениеРеквизита);
	КонецЦикла;	
	
КонецПроцедуры

Функция ДанныеЛицевогоСчетаПоКФО(Организация, МассивКФО) Экспорт
	
	ДанныеЛицевогоСчета = Новый Структура("ЛицевойСчет, РеквизитыЛицевогоСчета, ОрганФК, РазделыИКФО");
	
	ДанныеЛицевогоСчета.РазделыИКФО = Новый ТаблицаЗначений;
	ДанныеЛицевогоСчета.РазделыИКФО.Колонки.Добавить("РазделЛицевогоСчета");
	ДанныеЛицевогоСчета.РазделыИКФО.Колонки.Добавить("ИсточникСредств");
	ДанныеЛицевогоСчета.РазделыИКФО.Колонки.Добавить("КФО");
	
	МассивКФО = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивКФО);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	РазделыЛицевыхСчетов.Владелец КАК ЛицевойСчет,
	|	РазделыЛицевыхСчетов.Ссылка КАК РазделЛицевогоСчета,
	|	РазделыЛицевыхСчетов.ИсточникСредств КАК ИсточникСредств,
	|	РазделыЛицевыхСчетовДопустимыеКФО.КФО КАК КФО
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
	|		ПО РазделыЛицевыхСчетов.Ссылка = РазделыЛицевыхСчетовДопустимыеКФО.Ссылка
	|ГДЕ
	|	РазделыЛицевыхСчетов.Владелец.Владелец = &Организация
	|	И РазделыЛицевыхСчетов.ПометкаУдаления = ЛОЖЬ
	|	И РазделыЛицевыхСчетов.Владелец.ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Казначейский)
	|ИТОГИ ПО
	|	ЛицевойСчет");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для Каждого ЛС Из Выборка.Строки Цикл
		
		ФормироватьТаблицу = Истина;
		
		Для Каждого ЗначениеКФО Из МассивКФО Цикл
			Если ЛС.Строки.НайтиСтроки(Новый Структура("КФО", ЗначениеКФО)).Количество() = 0 Тогда
				ФормироватьТаблицу = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;	
		
		Если ФормироватьТаблицу = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ДанныеРазделаЛС Из ЛС.Строки Цикл
			СтрРаздела = ДанныеЛицевогоСчета.РазделыИКФО.Добавить();
			ЗаполнитьЗначенияСвойств(СтрРаздела, ДанныеРазделаЛС); 
		КонецЦикла;	
		
		ДанныеЛицевогоСчета.ЛицевойСчет = ЛС.ЛицевойСчет;
		
		Прервать;
	КонецЦикла;	

	Если ЗначениеЗаполнено(ДанныеЛицевогоСчета.ЛицевойСчет) Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	РеквизитыЛицевыхСчетов.Ссылка КАК Ссылка,
		|	РеквизитыЛицевыхСчетов.КассовыйОрган КАК КассовыйОрган
		|ИЗ
		|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
		|ГДЕ
		|	РеквизитыЛицевыхСчетов.Владелец = &ЛицевойСчет
		|	И РеквизитыЛицевыхСчетов.ПометкаУдаления = ЛОЖЬ");
		
		Запрос.УстановитьПараметр("ЛицевойСчет", ДанныеЛицевогоСчета.ЛицевойСчет);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДанныеЛицевогоСчета.РеквизитыЛицевогоСчета = Выборка.Ссылка;
			ДанныеЛицевогоСчета.ОрганФК = Выборка.КассовыйОрган;
		КонецЕсли;	
	КонецЕсли;	

	Возврат ДанныеЛицевогоСчета;
	
КонецФункции	

Процедура ДополнитьСвойстваЛицевогоСчета(ЛицевойСчет, СвойстваСчета) Экспорт 
	
	МассивКФО = Новый Массив;
	РазделыЛСпоКФО = Новый Соответствие; 
	МодульИнтеграции = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛицевойСчет, "МодульИнтеграции");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка КАК РазделЛС,
	|	РазделыЛицевыхСчетовДопустимыеКФО.КФО КАК КФО
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
	|ГДЕ
	|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.Владелец = &ЛицевойСчет
	|	И РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РазделыЛицевыхСчетов.Ссылка,";
	ПлатежноРасчетныеДокументы.ТекстЗапросаКФОПоКодуПоступленияЕБП(ТекстЗапроса, "РазделыЛицевыхСчетов.КодПоступленияЕБП", "");
	ТекстЗапроса = ТекстЗапроса + "
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
	|ГДЕ
	|	РазделыЛицевыхСчетов.Владелец = &ЛицевойСчет
	|	И РазделыЛицевыхСчетов.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	РазделЛС";     
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	МассивКФО = ОбщегоНазначенияБГУ.ПолучитьПересечениеМассивов(ТаблицаРезультата.ВыгрузитьКолонку("КФО"), ТаблицаРезультата.ВыгрузитьКолонку("КФО"));
	
	СтруктураОтбора = Новый Структура("КФО");
	Для Каждого ЗначениеКФО Из МассивКФО Цикл
		СтруктураОтбора.КФО = ЗначениеКФО;
		СтрокиКФО = ТаблицаРезультата.НайтиСтроки(СтруктураОтбора);
		Если СтрокиКФО.Количество() > 0 Тогда
			РазделыЛС = Новый Массив;
			Для каждого СтрокаКФО Из СтрокиКФО Цикл
				РазделыЛС.Добавить(СтрокаКФО.РазделЛС);
			КонецЦикла; 
			РазделыЛСпоКФО.Вставить(ЗначениеКФО, РазделыЛС);
		КонецЕсли; 
	КонецЦикла;  
	
	МассивОтбор = Новый Массив;
	МассивОтбор.Добавить(ПредопределенноеЗначение("Перечисление.КВД.Бюджет"));
	МассивКФОБюджет = ОбщегоНазначенияБГУ.ПолучитьПересечениеМассивов(МассивКФО, МассивОтбор);
	
	МассивОтбор = Новый Массив;
	МассивОтбор.Добавить(ПредопределенноеЗначение("Перечисление.КВД.Внебюджет"));
	МассивОтбор.Добавить(ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаГосзадание"));
	МассивОтбор.Добавить(ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаИныеЦели"));
	МассивОтбор.Добавить(ПредопределенноеЗначение("Перечисление.КВД.БюджетныеИнвестиции"));
	МассивОтбор.Добавить(ПредопределенноеЗначение("Перечисление.КВД.СредстваОМС"));
	МассивКФОВнебюджет = ОбщегоНазначенияБГУ.ПолучитьПересечениеМассивов(МассивКФО, МассивОтбор); 
	
	Если МодульИнтеграции = ПредопределенноеЗначение("Перечисление.МодулиИнтеграции.ЕБПАУБУ") Тогда 
		РазделЦС = РазделыЛСпоКФО.Получить(ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаИныеЦели")); 
		Если ЗначениеЗаполнено(РазделЦС) Тогда
			РазделыЛСпоКФО.Вставить(ПредопределенноеЗначение("Перечисление.КВД.БюджетныеИнвестиции"), РазделЦС); 
			МассивКФОВнебюджет.Добавить(ПредопределенноеЗначение("Перечисление.КВД.БюджетныеИнвестиции"));
		КонецЕсли;
	КонецЕсли;	
			
	// Дополним структуру
	СвойстваСчета.Вставить("РазделыЛСпоКФО", 	РазделыЛСпоКФО);
	СвойстваСчета.Вставить("КФОпоЛС", 			МассивКФО);
	СвойстваСчета.Вставить("КФОпоЛСБюджет", 	МассивКФОБюджет);
	СвойстваСчета.Вставить("КФОпоЛСВнебюджет", 	МассивКФОВнебюджет);
	
КонецПроцедуры	

// Процедуры обработки проведения и записи  платежно-расчетных документов

// Функция проведения платежно-расчетных документов по регистру накопления "БезналичныеДенежныеСредства"
//	Входящие параметры: Объект - платежно расчетный документ (тип объект)
//						СостояниеДокумента - тип струкутра
//	функция вызывается в двух вариантах:
//						1. Из модуля объекта в процедуре "ОбработкаПроведения", в функцию передается только параметр ЭтотОбъект (тип Объект),
//								состояние документа определяется в функции.			
//						2. Из функции "ЗарегестрироватьИсполнениеЗаявки" передается объект регистрации (документ) и структура с реквизитами
//								состояния документа	
//
Функция ВыполнитьДвиженияПлатежноРасчетногоДокумента(Объект, СостояниеДокумента = Неопределено) Экспорт
	
	НужноЗаписывать = Истина;  //флаг устанавливается для записи набора движений вне процедуры "ОбработкаПроведения"
	
	Если СостояниеДокумента = Неопределено тогда
		СостояниеДокумента = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Объект.Ссылка);
		НужноЗаписывать = Ложь; //флаг снимается, набор движений запишет процедура "ОбработкаПроведения" в модуле объекта (Документа)
	ИначеЕсли ТипЗнч(СостояниеДокумента) <> Тип("Структура") Тогда
		Возврат Истина;
	КонецЕсли;	
	
	Если НЕ СостояниеДокумента.Свойство("Статус") Тогда
		Возврат Истина;
	Конецесли;
	
	ПлатежноРасчетныеДокументы.ОчиститьДвиженияРегистратора(Объект);
	
	Объект.Движения.БезналичныеДенежныеСредства.Записывать = ЗначениеЗаполнено(СостояниеДокумента.Статус)
	И ((СостояниеДокумента.Статус = Перечисления.СтатусыИсполненияДокумента.Подготовлен) 
	ИЛИ (СостояниеДокумента.Статус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении)
	ИЛИ (СостояниеДокумента.Статус = Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку));
				
	Если Объект.Движения.БезналичныеДенежныеСредства.Записывать Тогда
		
		Если (ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаявкаНаКассовыйРасход"))	
			Или (ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаявкаНаНаличныеБанковскаяКарта"))	
			Или (ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаявкаНаНаличные"))
			Или (ТипЗнч(Объект) = Тип("ДокументОбъект.ПлатежноеПоручение"))
			Тогда	
			Для Каждого Расшифровка из Объект.РасшифровкаПлатежа Цикл
				Движение = Объект.Движения.БезналичныеДенежныеСредства.ДобавитьПриход();
				Движение.Период				= Объект.Дата;
				Движение.ИсточникСредств 	= Расшифровка.ИсточникСредств;
				Движение.ЛицевойСчет     	= Объект.ЛицевойСчет;
				Движение.КПС				= Расшифровка.КБКНазначениеПлатежа;
				Движение.КЭК				= Расшифровка.КОСГУНазначениеПлатежа;
				Движение.Зарезервировано	= Расшифровка.Сумма;
			КонецЦикла;
			
		ИначеЕсли 	ТипЗнч(Объект) = Тип("ДокументОбъект.РаспоряжениеОПеречисленииНаКартыМир") Тогда
			Для Каждого Расшифровка из Объект.РасшифровкаПлатежа Цикл
				Движение = Объект.Движения.БезналичныеДенежныеСредства.ДобавитьПриход();
				Движение.Период				= Объект.Дата;
				Движение.ИсточникСредств 	= Расшифровка.РазделЛицевогоСчета.ИсточникСредств;
				Движение.ЛицевойСчет     	= Объект.ЛицевойСчет;
				Движение.КПС				= Расшифровка.КПС;
				Движение.КЭК				= Расшифровка.КЭК;
				Движение.Зарезервировано	= Расшифровка.Сумма;
			КонецЦикла;
			
		ИначеЕсли 	ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаявкаНаКассовыйРасходСокращенная")
			Или ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаявкаНаВозврат")	
			Или ТипЗнч(Объект) = Тип("ДокументОбъект.СводнаяЗаявкаНаКассовыйРасход")
			Тогда
			Движение = Объект.Движения.БезналичныеДенежныеСредства.ДобавитьПриход();
			Движение.Период				= Объект.Дата;
			Движение.ИсточникСредств 	= Объект.ИсточникСредств;
			Движение.ЛицевойСчет     	= Объект.ЛицевойСчет;
			Движение.КПС				= Объект.КБКНазначениеПлатежа;
			Движение.КЭК				= Объект.КОСГУНазначениеПлатежа;
			Движение.Зарезервировано	= Объект.СуммаДокумента;  
			
		ИначеЕсли 	ТипЗнч(Объект) = Тип("ДокументОбъект.РСКППеречисление")
			Или ТипЗнч(Объект) = Тип("ДокументОбъект.РСКПВозврат")	
			Или ТипЗнч(Объект) = Тип("ДокументОбъект.РСКППеречислениеМир")
			Тогда
			Для Каждого Расшифровка из Объект.ДетализацияПлатежа Цикл
				Движение = Объект.Движения.БезналичныеДенежныеСредства.ДобавитьПриход();
				Движение.Период				= Объект.Дата;
				Движение.ИсточникСредств 	= Расшифровка.РазделЛС.КодПоступленияЕБП;
				Движение.ЛицевойСчет     	= Объект.ЛицевойСчет;
				Движение.КПС				= Расшифровка.КБКНазначениеПлатежа;
				Движение.КЭК				= Расшифровка.КОСГУНазначениеПлатежа;
				Движение.Зарезервировано	= Расшифровка.Сумма;
			КонецЦикла;
	
		КонецЕсли;	
		
		Если НужноЗаписывать Тогда
			Попытка
				Объект.Движения.БезналичныеДенежныеСредства.Записать();
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"),
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				Возврат Истина;
			КонецПопытки;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Ложь;
	
КонецФункции	

// 	Процедура записывает данные об исполнении заявки(документа) или изменении ее(его) статуса
//  вызывается из общей формы "Установка статуса платежно расчетного документа"
//		Входные параметры: Реквизиты - структура с полями для записи в регистр сведений "Состояние платежно расчетных документов"
//      Выходные параметры: ВыполнитьОповещение - булево, если документ проведен то истина иначе ложь
//
Функция ЗарегестрироватьИсполнениеЗаявки(Реквизиты) Экспорт
	
	ВыполнитьОповещение = Истина;
	
	Запись = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьМенеджерЗаписи();
	Запись.ПлатежноРасчетныйДокумент 	= Реквизиты.ПлатежноРасчетныйДокумент;
	
	Для Каждого Ресурс Из Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Ресурсы Цикл
				
		Реквизиты.Свойство(Ресурс.Имя, Запись[Ресурс.Имя]);
		
	КонецЦикла;
	
	Если Реквизиты.Свойство("ПервичныйОбразИРеквизиты") Тогда
		Запись.ПервичныйОбразИРеквизиты = Реквизиты.ПервичныйОбразИРеквизиты;
	КонецЕсли;
	
	Попытка
		Запись.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"),
	    УровеньЖурналаРегистрации.Ошибка,,,
	    ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	    ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;
		
	Возврат Истина;
	
КонецФункции

// Процедура возвращает данные об исполнении заявки ОФК
Функция ПолучитьСостояниеЗаявки(Ссылка) Экспорт
	
	СтруктураЗапроса = ПолучитьТекстЗапросаСостояния();
	
	Запрос = Новый Запрос(СтруктураЗапроса.ТекстЗапроса);				
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(СтруктураЗапроса.СтруктураРеквизитов, Выборка);
	
	Если (ТипЗнч(Ссылка) = Тип("ДокументСсылка.КассовоеВыбытие")) ИЛИ (ТипЗнч(Ссылка) = Тип("ДокументСсылка.КассовоеПоступление"))  
		И НЕ ЗначениеЗаполнено(СтруктураЗапроса.СтруктураРеквизитов.Статус) Тогда
		СтруктураЗапроса.СтруктураРеквизитов.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен");
	КонецЕсли;	
		
	Возврат СтруктураЗапроса.СтруктураРеквизитов;
	
КонецФункции	

Процедура ОчиститьДвиженияРегистратора(ДокументОбъект, Отказ = Ложь) Экспорт
	
	Попытка
		
		Набор = РегистрыНакопления.БезналичныеДенежныеСредства.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(ДокументОбъект.Ссылка);
		Набор.Записать();
		ДокументОбъект.Движения.БезналичныеДенежныеСредства.Очистить();
		
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"),
		УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки
	
КонецПроцедуры	

// Предназначена для получения пустого значения заданного типа:
//	примитивного, или ссылочного. Используется
//
// Параметры:
//	ЗаданныйТип   - тип, пустое значение которого нужно получить
//
Функция ПустоеЗначениеТипа(ЗаданныйТип) Экспорт

	Если ЗаданныйТип = Тип("Число") Тогда
		Возврат 0;

	ИначеЕсли ЗаданныйТип = Тип("Строка") Тогда
		Возврат "";

	ИначеЕсли ЗаданныйТип = Тип("Дата") Тогда
		Возврат '00010101000000';

	ИначеЕсли ЗаданныйТип = Тип("Булево") Тогда
		Возврат Ложь;

	Иначе
		Возврат Новый (ЗаданныйТип);

	КонецЕсли;

КонецФункции // ПустоеЗначениеТипа()

// Инициализирует процесс получения данных, переданного для объекта-ссылки
//
// Параметры:
//	ОбъектСсылка (СправочникСсылка). Ссылка на объект, по которому получаем данные
//	ДатаЗапроса (Дата). Дата получения данных
//	СтруктураДанных (Структура). Структура данных, которые нужно получить.
// 				Структура, как минимум должна иметь один элемент с названием блока информации,
//				которую нужно получить
Функция ПолучитьДанныеЗаполнитьСтруктуру(ОбъектСсылка, Знач ДатаЗапроса, СтруктураРезультат) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Ложь;
	ИначеЕсли ТипЗнч(СтруктураРезультат) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДатаЗапроса) Тогда
		ДатаЗапроса = ТекущаяДата();
	КонецЕсли;	
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.Контрагенты") Тогда
		СтруктураРезультат.Вставить("СсылкаНаОбъект",ОбъектСсылка);
		СтруктураРезультат.Вставить("Период",ДатаЗапроса);
		СтруктураРезультат.Вставить("ИНН");
		СтруктураРезультат.Вставить("КПП");
		СтруктураРезультат.Вставить("НаименованиеПолное");
		СтруктураРезультат.Вставить("УдостоверениеЛичности");
		
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(СтруктураРезультат);
	КонецЕсли;
	Возврат Истина;
КонецФункции

//   Функция проверки записи элемента справочника БанковскиеИКазначейскиеСчета
//   Входящие параметры тип: Струкутра
//		Обязателеьные поля  
//			Владелец
//			ТипЛицевогоСчета
//			Код (Номер счета)
//			Ссылка
//			КассовыйОрган
//
Функция ПроверкаЗаполненияРеквизитовБанковскиеИКазначейскиеСчета(ЗначенияРеквизитов, ТекстСообщения) Экспорт
	
	Если ТипЗнч(ЗначенияРеквизитов) <> Тип("Структура") тогда
		Возврат Ложь;
	КонецЕсли;
	
	Отмена = Ложь;
	
	Если ЗначенияРеквизитов.Свойство("Владелец") И НЕ ЗначениеЗаполнено(ЗначенияРеквизитов.Владелец) Тогда
		ТекстСообщения = НСтр("ru = 'Не указан владелец счета'");
		Отмена = Истина;
	КонецЕсли;
	
	Если ЗначенияРеквизитов.Свойство("ТипЛицевогоСчета") И НЕ ЗначениеЗаполнено(ЗначенияРеквизитов.ТипЛицевогоСчета) Тогда
		ТекстСообщения = НСтр("ru = 'Не указан тип счета'");
		Отмена = Истина;
	КонецЕсли;
	
	Если НЕ Отмена  И ЗначенияРеквизитов.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский Тогда
		
		Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитов.КассовыйОрган) Тогда
			
			ТекстСообщения = НСтр("ru = 'Не указан банк, в котором открыт счет'");
			Отмена = Истина;
			
		Иначе 	
			
			РеквизитыБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначенияРеквизитов.КассовыйОрган,
			Новый Структура("Страна, СВИФТБИК", "Страна", "СВИФТБИК"));   
			
			ЯвляетсяБанкомРФ = (РеквизитыБанка.Страна = ПредопределенноеЗначение("Справочник.СтраныМира.Россия")) ИЛИ НЕ ЗначениеЗаполнено(РеквизитыБанка.Страна);
			
			Если НЕ ЯвляетсяБанкомРФ Тогда
				КодСтраныВСчете = БанковскиеПравила.КодСтраныIBAN(ЗначенияРеквизитов.Код);
				КодСтраныВБанке = БанковскиеПравила.КодСтраныSWIFT(РеквизитыБанка.СВИФТБИК);
				
				Если БанковскиеПравила.СтранаПрименяетФорматIBAN(КодСтраныВСчете) Тогда
					Если Не БанковскиеПравила.ПроверитьРазрешенныеСимволыСчета(ЗначенияРеквизитов.Код) Тогда
						ТекстСообщения = НСтр("ru = 'Разрешены только буквы от A до Z и цифры'");
						Отмена = Истина;
					ИначеЕсли Не БанковскиеПравила.ПроверитьКонтрольныйКлючIBAN(ЗначенияРеквизитов.Код) Тогда
						ТекстСообщения = Нстр("ru = 'Номер счета введен некорректно'");
						Отмена = Истина;
					ИначеЕсли ЗначениеЗаполнено(КодСтраныВБанке) И КодСтраныВСчете <> КодСтраныВБанке Тогда
						ТекстСообщения = Нстр("ru = 'IBAN должен соответствовать банку'");
						Отмена = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Отмена Тогда
		// Проверяем уникальность кодов.
		Если ЗначенияРеквизитов.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский
			ИЛИ ТипЗнч(ЗначенияРеквизитов.Владелец) = Тип("СправочникСсылка.Казначейства") Тогда
			
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("Код", ЗначенияРеквизитов.Код);
				Запрос.УстановитьПараметр("КассовыйОрган", ЗначенияРеквизитов.КассовыйОрган);

				ТекстЗапроса = "
				|ВЫБРАТЬ ПЕРВЫЕ 1
				|	БанковскиеИКазначейскиеСчета.Владелец.Представление КАК ИмяВладельца,
				|	БанковскиеИКазначейскиеСчета.Код КАК СчетНомер,
				|	БанковскиеИКазначейскиеСчета.Владелец.Код КАК Код
				|ИЗ
				|	Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеИКазначейскиеСчета
				|ГДЕ
				|	БанковскиеИКазначейскиеСчета.Код = &Код
				|	И БанковскиеИКазначейскиеСчета.КассовыйОрган = &КассовыйОрган";
				Если ЗначениеЗаполнено(ЗначенияРеквизитов.Ссылка) Тогда
					ТекстЗапроса = ТекстЗапроса + "			
					|	И БанковскиеИКазначейскиеСчета.Ссылка <> &Ссылка";
					Запрос.УстановитьПараметр("Ссылка", ЗначенияРеквизитов.Ссылка);
				КонецЕсли;
				Запрос.Текст = ТекстЗапроса;
				Выборка = Запрос.Выполнить().Выбрать();

			
				Если Выборка.Количество() Тогда
					Выборка.Следующий();
					ТекстСообщения = НСтр("ru = 'Счет с номером " + СокрЛП(Выборка.СчетНомер) +" уже испольуется для " + СокрЛП(Выборка.ИмяВладельца) + ". Проверьте корректность номера счета!'");
				КонецЕсли;
				
		ИначеЕсли ЗначениеЗаполнено(ЗначенияРеквизитов.Код) Тогда
			// Для казначейского счета допустимо существование у одного контрагента
			// нескольких лицевых счетов с одинаковым номером только в одном и том же органе казначейства
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Код", ЗначенияРеквизитов.Код);
			Запрос.УстановитьПараметр("Владелец", ЗначенияРеквизитов.Владелец);
			Запрос.УстановитьПараметр("КассовыйОрган", ЗначенияРеквизитов.КассовыйОрган);
			Запрос.Текст = "
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	БанковскиеИКазначейскиеСчета.Владелец.Представление КАК ИмяВладельца,
			|	БанковскиеИКазначейскиеСчета.Код КАК СчетНомер
			|ИЗ
			|	Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеИКазначейскиеСчета
			|ГДЕ
			|	БанковскиеИКазначейскиеСчета.Код = &Код
			|	И БанковскиеИКазначейскиеСчета.Владелец <> &Владелец
			|	И БанковскиеИКазначейскиеСчета.КассовыйОрган = &КассовыйОрган";      
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Количество() Тогда
				Выборка.Следующий();
				ТекстСообщения = НСтр("ru = 'Счет с номером "+Выборка.СчетНомер+" уже испольуется для " +Выборка.ИмяВладельца + ". Проверьте корректность номера счета!'");
				Отмена = Истина;
			КонецЕсли;	
		КонецЕсли;		
	КонецЕсли;		
			
	Возврат Отмена;
    	
КонецФункции 

Функция КонтрольныйКлючСчетаСоответствуетТребованиям(ЗначенияРеквизитов) Экспорт 
	
	ТекстСообщения = ""; 
	
	Если ЗначенияРеквизитов.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский Тогда  
		
		// Изменено РСКП
		Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитов.КассовыйОрган) Тогда
			Возврат НСтр("ru = 'Не указан банк, в котором открыт счет'"); 
		КонецЕсли;	
		
		РеквизитыБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначенияРеквизитов.КассовыйОрган,
		Новый Структура("Страна, БИК, КоррСчет", "Страна", "Код", "КоррСчет"));   
		
		ЯвляетсяБанкомРФ = (РеквизитыБанка.Страна = ПредопределенноеЗначение("Справочник.СтраныМира.Россия")) ИЛИ НЕ ЗначениеЗаполнено(РеквизитыБанка.Страна);
		
		Если ЯвляетсяБанкомРФ Тогда
			
			НеПроверятьКонтрольныйКлюч = Неопределено;
			
			ЗначенияРеквизитов.Свойство("НомерСчетаНеУказывается", НеПроверятьКонтрольныйКлюч);
			
			Если НеПроверятьКонтрольныйКлюч = ЛОЖЬ Тогда 
				
				Если НЕ РегламентированныеДанныеКлиентСервер.КонтрольныйКлючЛицевогоСчетаСоответствуетТребованиям(ЗначенияРеквизитов.Код, 
					РеквизитыБанка.БИК, 
					ЗначениеЗаполнено(РеквизитыБанка.КоррСчет)) Тогда
					ТекстСообщения = НСтр("ru = 'Контрольное число счета не совпадает с рассчитанным с учетом БИК'");
				КонецЕсли;
				
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	
	Возврат ТекстСообщения;
	
КонецФункции			

// Формирует список ссылок на объекты из строки кодов, разделенных запятыми
//
// Параметры:
//	ВидОбъекта (Строка). Строка типа объекта для запроса. Например, "Справочник.КБК"
//	СтрокаОбъектов (Строка). Строка кодов объектов, разделенных запятыми
//
// Возвращает массив ссылок на объекты
//
Функция СформироватьСписокСсылокПоКодуОбъекта(ВидОбъекта, СтрокаОбъектов, ВключатьПодчиненные = Ложь) Экспорт
	
	СпСсылок   = Новый Массив;
	МассивОбъектов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаОбъектов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Источник.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Ссылки
	|ИЗ
	|	" + ВидОбъекта + " КАК Источник
	|ГДЕ
	|	Источник.Код В(&СпОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Источник.Ссылка КАК Ссылка
	|ИЗ
	|	" + ВидОбъекта + " КАК Источник
	|ГДЕ
	|	Источник.Ссылка " + ?(ВключатьПодчиненные, "В ИЕРАРХИИ ", "В ") + "
	|			(ВЫБРАТЬ
	|				Ссылки.Ссылка
	|			ИЗ
	|				Ссылки)
	|УПОРЯДОЧИТЬ ПО
	|	Источник.Код";
	
	Запрос.УстановитьПараметр("СпОбъектов", МассивОбъектов);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СпСсылок.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат(СпСсылок);
	
КонецФункции

// Получает ссылку на расчетно-платежный документ, введенный на основании переданного документа
//
// Параметры:
//	Основание - ДокументСсылка. Ссылка на документ-основание
//	СписокТиповДокументов - СписокЗначений. Список имен метаданных документов, среди которых осуществляется поиск
//
Функция ВведенныйНаОснованииРасчетноПлатежныйДокумент(Основание,СписокТиповДокументов) Экспорт
	
	Если Не ЗначениеЗаполнено(Основание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НайденныйДокумент = Неопределено;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДокументСсылка", Основание);
	
	ТекстЗапроса = "";
	
	Для Каждого ЭлементСписка Из СписокТиповДокументов Цикл
		
		ТипДокумента = ЭлементСписка.Значение;
		
		Если ТекстЗапроса <> "" Тогда
			
			ТекстЗапроса = ТекстЗапроса +
			"
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ";
			
		Иначе
			
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ";
			
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса +
		"
		|Док.Ссылка
		|ИЗ Документ."+ТипДокумента+" КАК Док
		|ГДЕ
		|	Док.ДокументОснование = &ДокументСсылка
		|";
		
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НайденныйДокумент = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат НайденныйДокумент;
	
КонецФункции

// Формирует список имен метаданных - документов, вводимых на основании переданного документа.
// К списку добавляются элементы дополнительного списка
//
// Параметры:
//	Основание - ДокументСсылка. Ссылка на документ-основание
//	ДополнительныйСписок - СписокЗначений. Список имен метаданных документов, которыми нужно дополнить возвращаемый список
//
Функция СписокДокументовВводимыхНаОсновании(Основание,ДополнительныйСписок = Неопределено) Экспорт
	
	СписокВыбора = Новый СписокЗначений;
	
	МДДокумента = Основание.Метаданные();
	Объекты = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьОбслуживаемыеОбъектыМетаданных();
	
	Для Каждого ДокОбъект Из Объекты Цикл
		Если ДокОбъект.ВводитсяНаОсновании.Содержит(МДДокумента) Тогда
			СписокВыбора.Добавить(ДокОбъект.Имя, ДокОбъект.Синоним, , БиблиотекаКартинок.Документ);
		КонецЕсли;
	КонецЦикла;
	
	Если ТипЗнч(ДополнительныйСписок) = Тип("СписокЗначений") Тогда
		Для Каждого ЭлементДопСписка Из ДополнительныйСписок Цикл
			СписокВыбора.Добавить(ЭлементДопСписка.Значение, ЭлементДопСписка.Представление, , БиблиотекаКартинок.Документ);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

// Возвращает список типов документов, которые могут быть созданы на основании документа ведомости в банк,
// для которых настроены команды прикрепления и перезаполнения.
//
// Возвращаемое значение:
//   СписокЗначений из Строка - содержит типы документов, которые могут быть созданы на основании ведомости компенсации.
//                    Каждое значение списка содержит:
//                    * Значение - Строка - имя типа документа (например, "ПлатежноеПоручение")
//                    * Представление - Строка - синоним документа
//                    * Картинка - Картинка - картинка документа
//
Функция СписокТиповДокументовНаОснованииВедомостиВБанк() Экспорт

	СписокТипов = Новый СписокЗначений;
	
	ОбъектыМетаданных = Новый Массив;
	ОбъектыМетаданных.Добавить(Метаданные.Документы.ПлатежноеПоручение);
	ОбъектыМетаданных.Добавить(Метаданные.Документы.ЗаявкаНаКассовыйРасход);
	ОбъектыМетаданных.Добавить(Метаданные.Документы.ЗаявкаНаКассовыйРасходСокращенная);
	ОбъектыМетаданных.Добавить(Метаданные.Документы.КассовоеВыбытие);
	ОбъектыМетаданных.Добавить(Метаданные.Документы.РСКППеречисление);

	Для Каждого ОбъектМетаданных Из ОбъектыМетаданных Цикл
		СписокТипов.Добавить(ОбъектМетаданных.Имя, ОбъектМетаданных.Синоним, , БиблиотекаКартинок.Документ);
	КонецЦикла;
	
	Возврат СписокТипов;
	
КонецФункции

// Возвращает список типов документов, которые могут быть созданы на основании документа ведомость компенсации,
// для которых настроены команды прикрепления и перезаполнения.
//
// Возвращаемое значение:
//   СписокЗначений из Строка - содержит типы документов, которые могут быть созданы на основании ведомости компенсации.
//                    Каждое значение списка содержит:
//                    * Значение - Строка - имя типа документа (например, "ПлатежноеПоручение")
//                    * Представление - Строка - синоним документа
//                    * Картинка - Картинка - картинка документа
//
Функция СписокТиповДокументовНаОснованииВедомостиКомпенсации() Экспорт

	СписокТипов = Новый СписокЗначений;
	
	ОбъектыМетаданных = Новый Массив;
	ОбъектыМетаданных.Добавить(Метаданные.Документы.ПлатежноеПоручение);
	ОбъектыМетаданных.Добавить(Метаданные.Документы.ЗаявкаНаКассовыйРасход);
	ОбъектыМетаданных.Добавить(Метаданные.Документы.ЗаявкаНаКассовыйРасходСокращенная);
	ОбъектыМетаданных.Добавить(Метаданные.Документы.КассовоеВыбытие);
	ОбъектыМетаданных.Добавить(Метаданные.Документы.РСКППеречисление);

	Для Каждого ОбъектМетаданных Из ОбъектыМетаданных Цикл
		СписокТипов.Добавить(ОбъектМетаданных.Имя, ОбъектМетаданных.Синоним, , БиблиотекаКартинок.Документ);
	КонецЦикла;
	
	Возврат СписокТипов;
	
КонецФункции

// Возвращает расчетно-платежный документ, введенный на основании документа ведомость в банк.
//
// Параметры:
//   Ведомость - ДокументСсылка.ВедомостьНаВыплатуВБанк
//
// Возвращаемое значение:
//   - ДокументСсылка
//   - Неопределено
//
Функция ВведенныйНаОснованииВедомостиВБанкРасчетноПлатежныйДокумент(Ведомость) Экспорт
	
	СписокТипов = СписокТиповДокументовНаОснованииВедомостиВБанк();
	Возврат ВведенныйНаОснованииРасчетноПлатежныйДокумент(Ведомость, СписокТипов);
	
КонецФункции

// Возвращает расчетно-платежный документ, введенный на основании ведомости компенсации.
//
// Параметры:
//   Ведомость - ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате
//
// Возвращаемое значение:
//   - ДокументСсылка
//   - Неопределено
//
Функция ВведенныйНаОснованииВедомостиКомпенсацииРасчетноПлатежныйДокумент(Ведомость) Экспорт
	
	СписокТипов = СписокТиповДокументовНаОснованииВедомостиКомпенсации();
	Возврат ВведенныйНаОснованииРасчетноПлатежныйДокумент(Ведомость, СписокТипов);
	
КонецФункции

// Проверяет соответствие расчетно-платежного документа ведомости на перечисление.
// При наличии расхождений в разрезе бюджетной классификации выводится сообщение.
//
// Параметры:
//	Ведомость - ДокументСсылка.ВедомостьНаВыплатуВБанк
//	          - ДокументОбъект.ВедомостьНаВыплатуВБанк
//	          - ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате
//	          - ДокументОбъект.ВедомостьКомпенсацииРодительскойПлатыКВыплате
//	ПлатежныйДокумент - ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная
//	                  - ДокументОбъект.ЗаявкаНаКассовыйРасходСокращенная
//	                  - ДокументСсылка.ЗаявкаНаКассовыйРасход
//	                  - ДокументОбъект.ЗаявкаНаКассовыйРасход
//	                  - ДокументСсылка.ПлатежноеПоручение
//	                  - ДокументОбъект.ПлатежноеПоручение
//	                  - ДокументСсылка.КассовоеВыбытие
//	                  - ДокументОбъект.КассовоеВыбытие
//	                  - ДокументСсылка.РСКППеречисление
//	                  - ДокументОбъект.РСКППеречисление
//	Отказ - Булево - признак несоответствия
//
Процедура ПроверитьПлатежныйДокументНаСоответствиеВедомости(Ведомость, ПлатежныйДокумент, Отказ) Экспорт
	
	Если НеПроверятьРасшифровкуКомпенсацииРодительскойПлаты(Ведомость) Тогда
		ПроверитьПлатежныйДокументНаСоответствиеВедомостиОбщейСуммой(Ведомость, ПлатежныйДокумент, Отказ);
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.РСКППеречисление")
		Или ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.РСКППеречисление") Тогда
		
		ПроверитьРСКППеречислениеНаСоответствиеВедомости(Ведомость, ПлатежныйДокумент, Ложь, Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеПлатежногоДокумента = Новый ТаблицаЗначений;
	ДанныеПлатежногоДокумента.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ДанныеПлатежногоДокумента.Колонки.Добавить("КБКНазначениеПлатежа", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ДанныеПлатежногоДокумента.Колонки.Добавить("КОСГУНазначениеПлатежа", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ДанныеПлатежногоДокумента.Колонки.Добавить("КодЦели",Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	ДанныеПлатежногоДокумента.Колонки.Добавить("КодМероприятия",Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ДанныеПлатежногоДокумента.Колонки.Добавить("ДопКлассификация",Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ДанныеПлатежногоДокумента.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	
	ДанныеВедомостиВБанк = Новый ТаблицаЗначений;
	ДанныеВедомостиВБанк.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ДанныеВедомостиВБанк.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ДанныеВедомостиВБанк.Колонки.Добавить("КЭК", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ДанныеВедомостиВБанк.Колонки.Добавить("КодЦели",Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	ДанныеВедомостиВБанк.Колонки.Добавить("КодМероприятия",Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ДанныеВедомостиВБанк.Колонки.Добавить("ДопКлассификация",Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ДанныеВедомостиВБанк.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	
	Если ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.ЗаявкаНаКассовыйРасходСокращенная") Тогда
		ЗаполнитьЗначенияСвойств(ДанныеПлатежногоДокумента.Добавить(), ПлатежныйДокумент);
		ДанныеПлатежногоДокумента[0].Сумма = ПлатежныйДокумент.СуммаДокумента;
	ИначеЕсли ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.ЗаявкаНаКассовыйРасход") 
		Или ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.КассовоеВыбытие") Тогда
		Для Каждого СтрокаРасшифровки Из ПлатежныйДокумент.РасшифровкаПлатежа Цикл
			НоваяСтрока = ДанныеПлатежногоДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасшифровки);
			НоваяСтрока.Сумма = СтрокаРасшифровки.СуммаВал;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.ПлатежноеПоручение") Тогда
		Для Каждого СтрокаРасшифровки Из ПлатежныйДокумент.РасшифровкаПлатежа Цикл
			ЗаполнитьЗначенияСвойств(ДанныеПлатежногоДокумента.Добавить(), СтрокаРасшифровки);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.РСКППеречисление") Тогда
		Для Каждого СтрокаДетализации Из ПлатежныйДокумент.ДетализацияПлатежа Цикл
			НоваяСтрока = ДанныеПлатежногоДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДетализации);
			Если ЗначениеЗаполнено(СтрокаДетализации.РазделЛС) И Не ЗначениеЗаполнено(НоваяСтрока.КФО) Тогда
				КодПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДетализации.РазделЛС, "КодПоступленияЕБП");
				НоваяСтрока.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(КодПоступления);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	КОСГУКомпенсации = Неопределено;
	Если ТипЗнч(Ведомость) = Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате")
		Или ТипЗнч(Ведомость) = Тип("ДокументОбъект.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
		
		Если ТипЗнч(Ведомость) = Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
			ДокументНачислениеКомпенсации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ведомость, "ДокументОснование");
		Иначе
			ДокументНачислениеКомпенсации = Ведомость.ДокументОснование;
		КонецЕсли;
		
		ДанныеКОСГУКомпенсации = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументНачислениеКомпенсации, "КЭК");
		Если ЗначениеЗаполнено(ДанныеКОСГУКомпенсации.КЭК) Тогда
			КОСГУКомпенсации = ДанныеКОСГУКомпенсации.КЭК;
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ТипЗнч(Ведомость) = Тип("ДокументОбъект.ВедомостьНаВыплатуВБанк") Тогда
		Для Каждого СтрокаРасшифровки Из Ведомость.РасшифровкаПлатежа Цикл
			ЗаполнитьЗначенияСвойств(ДанныеВедомостиВБанк.Добавить(), СтрокаРасшифровки);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Ведомость) = Тип("ДокументОбъект.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда	 
		Для Каждого СтрокаКомпенсации Из Ведомость.ВедомостьКомпенсации Цикл
			Если СтрокаКомпенсации.Аннулировано Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ДанныеВедомостиВБанк.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКомпенсации);
			НоваяСтрока.Сумма = СтрокаКомпенсации.СуммаКомпенсации;
			Если ЗначениеЗаполнено(КОСГУКомпенсации) Тогда
				НоваяСтрока.КЭК = КОСГУКомпенсации;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("ВТДанныеПлатежногоДокумента", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВТДанныеВедомостиВБанк", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПроверкаСоответствия", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПроверкаДублей", НомераТаблиц.Количество());
	
	Если ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная") Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Документ.КФО КАК КФО,
		|	Документ.КБКНазначениеПлатежа КАК КБКНазначениеПлатежа,
		|	Документ.КОСГУНазначениеПлатежа КАК КОСГУНазначениеПлатежа,
		|	Документ.КодЦели КАК КодЦели,
		|	Документ.КодМероприятия КАК КодМероприятия,
		|	Документ.ДопКлассификация КАК ДопКлассификация,
		|	Документ.СуммаДокумента КАК Сумма
		|ПОМЕСТИТЬ ВТДанныеПлатежногоДокумента
		|ИЗ
		|	Документ.ЗаявкаНаКассовыйРасходСокращенная КАК Документ
		|ГДЕ
		|	Документ.Ссылка = &ПлатежныйДокумент";
		 
	ИначеЕсли ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход") 
		Или ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.КассовоеВыбытие") Тогда

		ТекстЗапроса =
		"ВЫБРАТЬ
		|	РасшифровкаПлатежа.КФО КАК КФО,
		|	РасшифровкаПлатежа.КБКНазначениеПлатежа КАК КБКНазначениеПлатежа,
		|	РасшифровкаПлатежа.КОСГУНазначениеПлатежа КАК КОСГУНазначениеПлатежа,
		|	РасшифровкаПлатежа.КодЦели КАК КодЦели,
		|	РасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
		|	РасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
		|	РасшифровкаПлатежа.СуммаВал КАК Сумма
		|ПОМЕСТИТЬ ВТДанныеПлатежногоДокумента
		|ИЗ
		|	&РасшифровкаПлатежа КАК РасшифровкаПлатежа
		|ГДЕ
		|	РасшифровкаПлатежа.Ссылка = &ПлатежныйДокумент";
		
		РасшифровкаПлатежа = ПлатежныйДокумент.Метаданные().ПолноеИмя() + ".РасшифровкаПлатежа"; 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РасшифровкаПлатежа", РасшифровкаПлатежа);
		
	ИначеЕсли ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.ПлатежноеПоручение") Тогда

		ТекстЗапроса =
		"ВЫБРАТЬ
		|	РасшифровкаПлатежа.КФО КАК КФО,
		|	РасшифровкаПлатежа.КБКНазначениеПлатежа КАК КБКНазначениеПлатежа,
		|	РасшифровкаПлатежа.КОСГУНазначениеПлатежа КАК КОСГУНазначениеПлатежа,
		|	РасшифровкаПлатежа.КодЦели КАК КодЦели,
		|	РасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
		|	РасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
		|	РасшифровкаПлатежа.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТДанныеПлатежногоДокумента
		|ИЗ
		|	Документ.ПлатежноеПоручение.РасшифровкаПлатежа КАК РасшифровкаПлатежа
		|ГДЕ
		|	РасшифровкаПлатежа.Ссылка = &ПлатежныйДокумент";
		
	ИначеЕсли ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.РСКППеречисление") Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	&КФОПоКодуПоступления КАК КФО,
		|	ДетализацияПлатежа.КБКНазначениеПлатежа КАК КБКНазначениеПлатежа,
		|	ДетализацияПлатежа.КОСГУНазначениеПлатежа КАК КОСГУНазначениеПлатежа,
		|	ДетализацияПлатежа.КодЦели КАК КодЦели,
		|	ДетализацияПлатежа.КодМероприятия КАК КодМероприятия,
		|	ДетализацияПлатежа.ДопКлассификация КАК ДопКлассификация,
		|	ДетализацияПлатежа.СуммаВал КАК Сумма
		|ПОМЕСТИТЬ ВТДанныеПлатежногоДокумента
		|ИЗ
		|	Документ.РСКППеречисление.ДетализацияПлатежа КАК ДетализацияПлатежа
		|ГДЕ
		|	ДетализацияПлатежа.Ссылка = &ПлатежныйДокумент";
		
		КФОПоКодуПоступления = "";
		ТекстЗапросаКФОПоКодуПоступленияЕБП(КФОПоКодуПоступления, "ДетализацияПлатежа.РазделЛС.КодПоступленияЕБП", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КФОПоКодуПоступления", КФОПоКодуПоступления);
		
	Иначе
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ДанныеПлатежногоДокумента.КФО КАК КФО,
			|	ДанныеПлатежногоДокумента.КБКНазначениеПлатежа КАК КБКНазначениеПлатежа,
			|	ДанныеПлатежногоДокумента.КОСГУНазначениеПлатежа КАК КОСГУНазначениеПлатежа,
			|	ДанныеПлатежногоДокумента.КодЦели КАК КодЦели,
			|	ДанныеПлатежногоДокумента.КодМероприятия КАК КодМероприятия,
			|	ДанныеПлатежногоДокумента.ДопКлассификация КАК ДопКлассификация,
			|	ДанныеПлатежногоДокумента.Сумма КАК Сумма
			|ПОМЕСТИТЬ ВТДанныеПлатежногоДокумента
			|ИЗ
			|	&ДанныеПлатежногоДокумента КАК ДанныеПлатежногоДокумента";
			
		Запрос.УстановитьПараметр("ДанныеПлатежногоДокумента", ДанныеПлатежногоДокумента);
			
	КонецЕсли;
	
	Если ТипЗнч(Ведомость) = Тип("ДокументСсылка.ВедомостьНаВыплатуВБанк") Тогда
		
		ТекстЗапросаДанныеВедомостиВБанк = 
			"ВЫБРАТЬ
			|	РасшифровкаПлатежа.КФО КАК КФО,
			|	РасшифровкаПлатежа.КПС КАК КПС,
			|	РасшифровкаПлатежа.КЭК КАК КЭК,
			|	РасшифровкаПлатежа.КодЦели КАК КодЦели,
			|	РасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
			|	РасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
			|	РасшифровкаПлатежа.Сумма КАК Сумма
			|ПОМЕСТИТЬ ВТДанныеВедомостиВБанк
			|ИЗ
			|	Документ.ВедомостьНаВыплатуВБанк.РасшифровкаПлатежа КАК РасшифровкаПлатежа
			|ГДЕ
			|	РасшифровкаПлатежа.Ссылка = &ВедомостьВБанк";
		
	ИначеЕсли ТипЗнч(Ведомость) = Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
		
		ТекстЗапросаДанныеВедомостиВБанк = 
			"ВЫБРАТЬ
			|	ВедомостьКомпенсации.КФО КАК КФО,
			|	ВедомостьКомпенсации.КПС КАК КПС,
			|	ВЫБОР
			|		КОГДА &ЕстьКЭК
			|			ТОГДА &КОСГУКомпенсации
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
			|	КОНЕЦ КАК КЭК,
			|	ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка) КАК КодЦели,
			|	ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка) КАК КодМероприятия,
			|	ЗНАЧЕНИЕ(Справочник.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка) КАК ДопКлассификация,
			|	ВедомостьКомпенсации.СуммаКомпенсации КАК Сумма
			|ПОМЕСТИТЬ ВТДанныеВедомостиВБанк
			|ИЗ
			|	Документ.ВедомостьКомпенсацииРодительскойПлатыКВыплате.ВедомостьКомпенсации КАК ВедомостьКомпенсации
			|ГДЕ
			|	ВедомостьКомпенсации.Ссылка = &ВедомостьВБанк
			|	И НЕ ВедомостьКомпенсации.Аннулировано";
	
	Иначе	 
		ТекстЗапросаДанныеВедомостиВБанк = 
			"ВЫБРАТЬ
			|	ДанныеВедомостиВБанк.КФО КАК КФО,
			|	ДанныеВедомостиВБанк.КПС КАК КПС,
			|	ДанныеВедомостиВБанк.КЭК КАК КЭК,
			|	ДанныеВедомостиВБанк.КодЦели КАК КодЦели,
			|	ДанныеВедомостиВБанк.КодМероприятия КАК КодМероприятия,
			|	ДанныеВедомостиВБанк.ДопКлассификация КАК ДопКлассификация,
			|	ДанныеВедомостиВБанк.Сумма КАК Сумма
			|ПОМЕСТИТЬ ВТДанныеВедомостиВБанк
			|ИЗ
			|	&ДанныеВедомостиВБанк КАК ДанныеВедомостиВБанк";
		
		Запрос.УстановитьПараметр("ДанныеВедомостиВБанк", ДанныеВедомостиВБанк);
	
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов()
		+ ТекстЗапросаДанныеВедомостиВБанк + ОбщегоНазначения.РазделительПакетаЗапросов() +
		
		"ВЫБРАТЬ
		|	ВТСводнаяТаблица.КФО КАК КФО,
		|	ВТСводнаяТаблица.КПС КАК КПС,
		|	ВЫБОР
		|		КОГДА &ЕстьКЭК
		|			ТОГДА ВТСводнаяТаблица.КЭК
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
		|	КОНЕЦ КАК КЭК,
		|	ВЫБОР
		|		КОГДА &ЕстьДетализация
		|			ТОГДА ВТСводнаяТаблица.КодЦели
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка)
		|	КОНЕЦ КАК КодЦели,
		|	ВЫБОР
		|		КОГДА &ЕстьДетализация
		|			ТОГДА ВТСводнаяТаблица.КодМероприятия
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка)
		|	КОНЕЦ КАК КодМероприятия,
		|	ВЫБОР
		|		КОГДА &ЕстьДетализация
		|			ТОГДА ВТСводнаяТаблица.ДопКлассификация
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка)
		|	КОНЕЦ КАК ДопКлассификация,
		|	СУММА(ВТСводнаяТаблица.СуммаВедомости) КАК СуммаВедомости,
		|	СУММА(ВТСводнаяТаблица.СуммаПлатежногоДокумента) КАК СуммаПлатежногоДокумента
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТДанныеПлатежногоДокумента.КФО КАК КФО,
		|		ВТДанныеПлатежногоДокумента.КБКНазначениеПлатежа КАК КПС,
		|		ВТДанныеПлатежногоДокумента.КОСГУНазначениеПлатежа КАК КЭК,
		|		ВТДанныеПлатежногоДокумента.КодЦели КАК КодЦели,
		|		ВТДанныеПлатежногоДокумента.КодМероприятия КАК КодМероприятия,
		|		ВТДанныеПлатежногоДокумента.ДопКлассификация КАК ДопКлассификация,
		|		0 КАК СуммаВедомости,
		|		ВТДанныеПлатежногоДокумента.Сумма КАК СуммаПлатежногоДокумента
		|	ИЗ
		|		ВТДанныеПлатежногоДокумента КАК ВТДанныеПлатежногоДокумента
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		ВТДанныеВедомостиВБанк.КФО,
		|		ВТДанныеВедомостиВБанк.КПС,
		|		ВТДанныеВедомостиВБанк.КЭК,
		|		ВТДанныеВедомостиВБанк.КодЦели,
		|		ВТДанныеВедомостиВБанк.КодМероприятия,
		|		ВТДанныеВедомостиВБанк.ДопКлассификация,
		|		ВТДанныеВедомостиВБанк.Сумма,
		|		0
		|	ИЗ
		|		ВТДанныеВедомостиВБанк КАК ВТДанныеВедомостиВБанк) КАК ВТСводнаяТаблица
		|СГРУППИРОВАТЬ ПО
		|	ВТСводнаяТаблица.КФО,
		|	ВТСводнаяТаблица.КПС,
		|	ВЫБОР
		|		КОГДА &ЕстьКЭК
		|			ТОГДА ВТСводнаяТаблица.КЭК
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ЕстьДетализация
		|			ТОГДА ВТСводнаяТаблица.КодЦели
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ЕстьДетализация
		|			ТОГДА ВТСводнаяТаблица.КодМероприятия
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ЕстьДетализация
		|			ТОГДА ВТСводнаяТаблица.ДопКлассификация
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка)
		|	КОНЕЦ
		|ИМЕЮЩИЕ
		|	СУММА(ВТСводнаяТаблица.СуммаВедомости) <> СУММА(ВТСводнаяТаблица.СуммаПлатежногоДокумента)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТДанныеПлатежногоДокумента.КФО КАК КФО,
		|	ВТДанныеПлатежногоДокумента.КБКНазначениеПлатежа КАК КПС,
		|	ВЫБОР
		|		КОГДА &ЕстьКЭК
		|			ТОГДА ВТДанныеПлатежногоДокумента.КОСГУНазначениеПлатежа
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
		|	КОНЕЦ КАК КЭК,
		|	ВЫБОР
		|		КОГДА &ЕстьДетализация
		|			ТОГДА ВТДанныеПлатежногоДокумента.КодЦели
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка)
		|	КОНЕЦ КАК КодЦели,
		|	ВЫБОР
		|		КОГДА &ЕстьДетализация
		|			ТОГДА ВТДанныеПлатежногоДокумента.КодМероприятия
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка)
		|	КОНЕЦ КАК КодМероприятия,
		|	ВЫБОР
		|		КОГДА &ЕстьДетализация
		|			ТОГДА ВТДанныеПлатежногоДокумента.ДопКлассификация
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка)
		|	КОНЕЦ КАК ДопКлассификация
		|ИЗ
		|	ВТДанныеПлатежногоДокумента КАК ВТДанныеПлатежногоДокумента
		|СГРУППИРОВАТЬ ПО
		|	ВТДанныеПлатежногоДокумента.КФО,
		|	ВТДанныеПлатежногоДокумента.КБКНазначениеПлатежа,
		|	ВЫБОР
		|		КОГДА &ЕстьКЭК
		|			ТОГДА ВТДанныеПлатежногоДокумента.КОСГУНазначениеПлатежа
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ЕстьДетализация
		|			ТОГДА ВТДанныеПлатежногоДокумента.КодЦели
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ЕстьДетализация
		|			ТОГДА ВТДанныеПлатежногоДокумента.КодМероприятия
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ЕстьДетализация
		|			ТОГДА ВТДанныеПлатежногоДокумента.ДопКлассификация
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка)
		|	КОНЕЦ
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(*) > 1";
		
	ЭтоВедомостьВБанк = ТипЗнч(Ведомость) = Тип("ДокументСсылка.ВедомостьНаВыплатуВБанк")
		Или ТипЗнч(Ведомость) = Тип("ДокументОбъект.ВедомостьНаВыплатуВБанк");
		
	ЕстьКЭК = ЭтоВедомостьВБанк Или ЗначениеЗаполнено(ДанныеКОСГУКомпенсации.КЭК);
	ЕстьДетализация = ЭтоВедомостьВБанк;
	
	Запрос.УстановитьПараметр("ЕстьКЭК", ЕстьКЭК);
	Запрос.УстановитьПараметр("ЕстьДетализация", ЕстьДетализация);
	Запрос.УстановитьПараметр("КОСГУКомпенсации", КОСГУКомпенсации);
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ПлатежныйДокумент)) Тогда
		Запрос.УстановитьПараметр("ПлатежныйДокумент", ПлатежныйДокумент);
	КонецЕсли;
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ведомость)) Тогда
		Запрос.УстановитьПараметр("ВедомостьВБанк", Ведомость);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ТекстСообщения = "";
	
	Выборка = РезультатЗапроса[НомераТаблиц.ПроверкаСоответствия].Выбрать();	
	Пока Выборка.Следующий() Цикл
		
		ТекстСообщения = ТекстСообщения + СтрШаблон(НСтр("ru='
			|по %1 сумма ведомости ""%2"" не равна сумме расчетно-платежного документа ""%3""'"),
			ТекстАналитикиПроверкаВедомости(Выборка, ЭтоВедомостьВБанк),
			Формат(Выборка.СуммаВедомости, "ЧДЦ=2; ЧН="),
			Формат(Выборка.СуммаПлатежногоДокумента, "ЧДЦ=2; ЧН="));
			
	КонецЦикла;

	// В расчетно-платежном документе не должно быть двоения строк в рамках классификации, определяемой в ведомости,
	// иначе невозможно идентифицировать, какую из строк соотнести с конкретным сотрудником ведомости
	Выборка = РезультатЗапроса[НомераТаблиц.ПроверкаДублей].Выбрать();
	Пока Выборка.Следующий() Цикл

		ТекстСообщения = ТекстСообщения + СтрШаблон(НСтр("ru='
			|по %1 имеется дублирование строк в расчетно-платежном документе'"),
			ТекстАналитикиПроверкаВедомости(Выборка, ЭтоВедомостьВБанк));
			
	КонецЦикла;

	Если НЕ ПустаяСтрока(ТекстСообщения) Тогда
		ТекстСообщения = СтрШаблон(НСтр(
			"ru='Обнаружено расхождение данных ведомости ""%1"" и расчетно-платежного документа ""%2"":%3'"),
			Ведомость,
			ПлатежныйДокумент,
			ТекстСообщения);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Дополнительная проверка РСКП (перечисление) на соответствие ведомости.
// Проверяется отсутствие признака Несколько получателей
// Проверяет расшифровку если не заполнена детализация или передан флаг ПроверитьРасшифровку   
//
// Параметры:
//	Ведомость - ДокументСсылка.ВедомостьНаВыплатуВБанк
//	          - ДокументОбъект.ВедомостьНаВыплатуВБанк
//	ПлатежныйДокумент - ДокументСсылка.РСКППеречисление
//	                  - ДокументОбъект.РСКППеречисление
//	ПроверитьРасшифровку - Булево - признак необходимости проверить расшифровку
//	Отказ - Булево - признак несоответствия
//
Процедура ПроверитьРСКППеречислениеНаСоответствиеВедомости(Ведомость, ПлатежныйДокумент, ПроверитьРасшифровку,
			Отказ) Экспорт
	
	ПлатежныйДокументЭтоСсылка = ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.РСКППеречисление");
	
	Если ПлатежныйДокументЭтоСсылка Тогда
		НесколькоПолучателей = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежныйДокумент, "НесколькоПолучателей");
	Иначе
		НесколькоПолучателей = ПлатежныйДокумент.НесколькоПолучателей;
	КонецЕсли;
	Если НесколькоПолучателей = 1 Тогда
		ТекстСообщения = СтрШаблон(НСтр(
			"ru='В распоряжении о перечислении средств ""%1"" ""Количество получателей"" установлено в положение ""Несколько получателей"".
			|Для заполнения распоряжения на основании ведомости установите переключатель в положение ""Один получатель""'"),
			ПлатежныйДокумент);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ПлатежныйДокументЭтоСсылка Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 		
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ИСТИНА КАК Поле1
			|ИЗ
			|	Документ.РСКППеречисление.ДетализацияПлатежа КАК РСКППеречислениеДетализацияПлатежа
			|ГДЕ
			|	РСКППеречислениеДетализацияПлатежа.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ПлатежныйДокумент);
		РезультатЗапроса = Запрос.Выполнить();
		ЕстьДетализация = Не РезультатЗапроса.Пустой();
	Иначе
		ЕстьДетализация = ПлатежныйДокумент.ДетализацияПлатежа.Количество() > 0;
	КонецЕсли;
			
	Если ЕстьДетализация И Не ПроверитьРасшифровку Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаСверки = Новый ТаблицаЗначений;
	ТаблицаСверки.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаСверки.Колонки.Добавить("ВидПоказателя", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКБК"));
	ТаблицаСверки.Колонки.Добавить("УточнениеПоказателя", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКБК"));
	ТаблицаСверки.Колонки.Добавить("КодАналитическойГруппы", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(3)));
	ТаблицаСверки.Колонки.Добавить("СуммаВедомости", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаСверки.Колонки.Добавить("СуммаПлатежногоДокумента", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	
	Если ПлатежныйДокументЭтоСсылка Тогда
		
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	&КФОПоКодуПоступления КАК КФО,
			|	РасшифровкаПлатежа.КБКНазначениеПлатежа.ВидПоказателя КАК ВидПоказателя,
			|	РасшифровкаПлатежа.КБКНазначениеПлатежа.УточнениеПоказателя КАК УточнениеПоказателя,
			|	ПРАВ(ЕСТЬNULL(РасшифровкаПлатежа.КБКНазначениеПлатежа.Код, """"), 3) КАК КодАналитическойГруппы,
			|	РасшифровкаПлатежа.СуммаВал КАК СуммаПлатежногоДокумента
			|ИЗ
			|	Документ.РСКППеречисление.РасшифровкаПлатежа КАК РасшифровкаПлатежа
			|ГДЕ
			|	РасшифровкаПлатежа.Ссылка = &Ссылка";
		
		КФОПоКодуПоступления = "";
		ТекстЗапросаКФОПоКодуПоступленияЕБП(КФОПоКодуПоступления, "РасшифровкаПлатежа.РазделЛС.КодПоступленияЕБП", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КФОПоКодуПоступления", КФОПоКодуПоступления);
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;		
		Запрос.УстановитьПараметр("Ссылка", ПлатежныйДокумент);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаСверки.Добавить(), Выборка);
		КонецЦикла;

	Иначе
		Для Каждого Строка Из ПлатежныйДокумент.РасшифровкаПлатежа Цикл
			НоваяСтрока = ТаблицаСверки.Добавить();
			КодПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Строка.РазделЛС, "КодПоступленияЕБП");
			НоваяСтрока.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(КодПоступления);
			РеквизитыКБК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.КБКНазначениеПлатежа,
				"ВидПоказателя,УточнениеПоказателя,Код");
			НоваяСтрока.ВидПоказателя = РеквизитыКБК.ВидПоказателя;
			НоваяСтрока.УточнениеПоказателя = РеквизитыКБК.УточнениеПоказателя;
			НоваяСтрока.КодАналитическойГруппы = Прав(РеквизитыКБК.Код, 3);
			НоваяСтрока.СуммаПлатежногоДокумента = Строка.СуммаВал;
		КонецЦикла;
	КонецЕсли;
	
	Если ТипЗнч(Ведомость) = Тип("ДокументСсылка.ВедомостьНаВыплатуВБанк") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	РасшифровкаПлатежа.КФО КАК КФО,
			|	РасшифровкаПлатежа.КПС.ВидПоказателя КАК ВидПоказателя,
			|	РасшифровкаПлатежа.КПС.УточнениеПоказателя КАК УточнениеПоказателя,
			|	ПРАВ(ЕСТЬNULL(РасшифровкаПлатежа.КПС.Код, """"), 3) КАК КодАналитическойГруппы,
			|	РасшифровкаПлатежа.Сумма КАК СуммаВедомости
			|ИЗ
			|	Документ.ВедомостьНаВыплатуВБанк.РасшифровкаПлатежа КАК РасшифровкаПлатежа
			|ГДЕ
			|	РасшифровкаПлатежа.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Ведомость);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаСверки.Добавить(), Выборка);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Ведомость) = Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ВедомостьКомпенсации.КФО КАК КФО,
			|	ВедомостьКомпенсации.КПС.ВидПоказателя КАК ВидПоказателя,
			|	ВедомостьКомпенсации.КПС.УточнениеПоказателя КАК УточнениеПоказателя,
			|	ПРАВ(ЕСТЬNULL(ВедомостьКомпенсации.КПС.Код, """"), 3) КАК КодАналитическойГруппы,
			|	ВедомостьКомпенсации.СуммаКомпенсации КАК СуммаВедомости
			|ИЗ
			|	Документ.ВедомостьКомпенсацииРодительскойПлатыКВыплате.ВедомостьКомпенсации КАК ВедомостьКомпенсации
			|ГДЕ
			|	ВедомостьКомпенсации.Ссылка = &Ссылка
			|	И НЕ ВедомостьКомпенсации.Аннулировано";
			
		Запрос.УстановитьПараметр("Ссылка", Ведомость);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаСверки.Добавить(), Выборка);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Ведомость) = Тип("ДокументОбъект.ВедомостьНаВыплатуВБанк") Тогда
		
		Для Каждого Строка Из Ведомость.РасшифровкаПлатежа Цикл
			НоваяСтрока = ТаблицаСверки.Добавить();
			НоваяСтрока.КФО = Строка.КФО;
			РеквизитыКБК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.КПС,
				"ВидПоказателя,УточнениеПоказателя,Код");
			НоваяСтрока.ВидПоказателя = РеквизитыКБК.ВидПоказателя;
			НоваяСтрока.УточнениеПоказателя = РеквизитыКБК.УточнениеПоказателя;
			НоваяСтрока.КодАналитическойГруппы = Прав(РеквизитыКБК.Код, 3);
			НоваяСтрока.СуммаВедомости = Строка.Сумма;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Ведомость) = Тип("ДокументОбъект.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
		
		Для Каждого Строка Из Ведомость.ВедомостьКомпенсации Цикл
			Если Строка.Аннулировано Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ТаблицаСверки.Добавить();
			НоваяСтрока.КФО = Строка.КФО;
			РеквизитыКБК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Строка.КПС,
				"ВидПоказателя,УточнениеПоказателя,Код");
			НоваяСтрока.ВидПоказателя = РеквизитыКБК.ВидПоказателя;
			НоваяСтрока.УточнениеПоказателя = РеквизитыКБК.УточнениеПоказателя;
			НоваяСтрока.КодАналитическойГруппы = Прав(РеквизитыКБК.Код, 3);
			НоваяСтрока.СуммаВедомости = Строка.СуммаКомпенсации;
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаСверки.Свернуть("КФО,ВидПоказателя,УточнениеПоказателя,КодАналитическойГруппы",
		"СуммаПлатежногоДокумента,СуммаВедомости");
	
	ТекстСообщения = "";
	Для Каждого Строка Из ТаблицаСверки Цикл
		Если Строка.СуммаПлатежногоДокумента = Строка.СуммаВедомости Тогда
			Продолжить;
		КонецЕсли;

		ТекстСообщения = ТекстСообщения + СтрШаблон(НСтр("ru='
			|по КФО %1, Коду аналитической группы %2 сумма ведомости ""%3"" не равна сумме распоряжения о перечислении средств ""%4""'"),
			Строка.КФО, Строка.КодАналитическойГруппы,
			Формат(Строка.СуммаВедомости, "ЧДЦ=2; ЧН="),
			Формат(Строка.СуммаПлатежногоДокумента, "ЧДЦ=2; ЧН="));
		
	КонецЦикла;

	Если НЕ ПустаяСтрока(ТекстСообщения) Тогда
		ТекстСообщения = СтрШаблон(НСтр(
			"ru='Обнаружено расхождение данных ведомости ""%1"" и распоряжения о перечислении средств ""%2"":%3'"),
			Ведомость,
			ПлатежныйДокумент,
			ТекстСообщения);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает ведомость как документ-основание для платежно-расчетного документа.
// Выполняет проверку соответствия данных и блокировку документа.
// Вызывается из формы документа ВедомостьНаВыплатуВБанк и ВедомостьКомпенсацииРодительскойПлатыКВыплате
//
// Параметры:
//   Ведомость - ДокументСсылка - ведомость, которая устанавливается как основание платежного документа
//   ПлатежныйДокумент - ДокументСсылка - платежно-расчетный документ, для которого устанавливается основание
//   РежимЗаписи - РежимЗаписиДокумента - режим записи платежного документа
//
// Возвращаемое значение:
//   Структура:
//    * Ошибка - Булево - Истина - ведомость не может быть прикреплена или возникла ошибка
//    * ИнформацияОбОшибке - ИнформацияОбОшибке - если Ошибка = Истина
//                         - Неопределено - если Ошибка <> Истина
//
Функция ПрикрепитьВедомостьКПлатежноРасчетномуДокументу(Ведомость, ПлатежныйДокумент, РежимЗаписи) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ИнформацияОбОшибке", Неопределено);
	
	НачатьТранзакцию();
	Попытка
		
		Попытка
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить(ПлатежныйДокумент.Метаданные().ПолноеИмя());
			ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", ПлатежныйДокумент);
			БлокировкаДанных.Заблокировать();
			
			ПлатежныйДокументОбъект = ПлатежныйДокумент.ПолучитьОбъект();
			ПлатежныйДокументОбъект.Заблокировать();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
		    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
		       НСтр("ru = 'Расчетно-платежный документ занят. Необходимо завершить его редактирование:'"));
			ВызватьИсключение(Уточнение.Текст, Уточнение.Категория, , , ИнформацияОбОшибке);
		КонецПопытки;
	
		Если ЗначениеЗаполнено(ПлатежныйДокументОбъект.ДокументОснование) Тогда
			
			ТекстСообщения = СтрШаблон(НСтр(
				"ru='Расчетно-платежный документ ""%1"" уже связан с другим документом-основанием: ""%2""'"),
				ПлатежныйДокументОбъект, ПлатежныйДокументОбъект.ДокументОснование);
				
			ВызватьИсключение ТекстСообщения;
			
		КонецЕсли;
	
		Отказ = Ложь;
		ПроверитьПлатежныйДокументНаСоответствиеВедомости(Ведомость, ПлатежныйДокументОбъект, Отказ);
	
		Если Отказ Тогда
			ТекстСообщения = СтрШаблон(НСтр(
				"ru='Данные ведомости не соответствуют расчетно-платежному документу ""%1""'"),
				ПлатежныйДокументОбъект);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	
		ПлатежныйДокументОбъект.ДокументОснование = Ведомость;
		ПлатежныйДокументОбъект.ДополнительныеСвойства.Вставить("НеПроверятьСоответствиеВедомости", Истина);
		Попытка
			ПлатежныйДокументОбъект.Записать(РежимЗаписи);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаголовокОшибки = СтрШаблон(НСтр("ru = 'Не удалось %1 ""%2"":'"),
				?(РежимЗаписи = РежимЗаписиДокумента.Запись, НСтр("ru = 'записать'"),
				?(РежимЗаписи = РежимЗаписиДокумента.Проведение, НСтр("ru = 'провести'"),
				НСтр("ru = 'отменить проведение'"))),
				ПлатежныйДокументОбъект);
		    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
		       ЗаголовокОшибки);
			ВызватьИсключение(Уточнение.Текст, Уточнение.Категория, , , ИнформацияОбОшибке);
		КонецПопытки;
		
	    ЗаписьЖурналаРегистрации(НСтр("ru = 'Платежные ведомости. Ведомость приложена'"),
	       УровеньЖурналаРегистрации.Информация, , Ведомость,
	       СтрШаблон(НСтр("ru = 'Ведомость ""%1"" приложена к расчетно-платежному документу ""%2""'"),
	       Ведомость, ПлатежныйДокументОбъект), 
	       РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная);

		Если ПлатежныйДокументОбъект.Заблокирован() Тогда
			ПлатежныйДокументОбъект.Разблокировать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	    ЗаписьЖурналаРегистрации(НСтр("ru = 'Платежные ведомости. Не удалось приложить ведомость'"),
	       УровеньЖурналаРегистрации.Предупреждение, , Ведомость,
	       ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

		Результат.Ошибка = Истина;
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
	КонецПопытки;

	Возврат Результат;
	
КонецФункции

// Очищает документ-основание платежно-расчетного документа
// Если документ-основание не соответствут ведомости, действие не выполняется.
// Вызывается из формы документа ВедомостьНаВыплатуВБанк и ВедомостьКомпенсацииРодительскойПлатыКВыплате
// 
// Параметры:
//   Ведомость - ДокументСсылка - ведомость, которая устанавливается как основание платежного документа
//   ПлатежныйДокумент - ДокументСсылка - платежно-расчетный документ, для которого устанавливается основание
// 
// Возвращаемое значение:
//   Структура:
//    * Ошибка - Булево - Истина - ведомость не может быть откреплена или возникла ошибка
//    * ИнформацияОбОшибке - ИнформацияОбОшибке - если Ошибка = Истина
//                         - Неопределено - если Ошибка <> Истина
//
Функция ОткрепитьВедомостьОтПлатежноРасчетногоДокумента(Ведомость, ПлатежныйДокумент) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ИнформацияОбОшибке", Неопределено);

	НачатьТранзакцию();
	Попытка
		
		Попытка
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить(Метаданные.НайтиПоТипу(ТипЗнч(ПлатежныйДокумент)).ПолноеИмя());
			ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", ПлатежныйДокумент);
			БлокировкаДанных.Заблокировать();
			
			ПлатежныйДокументОбъект = ПлатежныйДокумент.ПолучитьОбъект();
			ПлатежныйДокументОбъект.Заблокировать();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
		    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
		       НСтр("ru = 'Расчетно-платежный документ занят. Необходимо завершить его редактирование:'"));
			ВызватьИсключение(Уточнение.Текст, Уточнение.Категория, , , ИнформацияОбОшибке);
		КонецПопытки;
	
		Если Не ЗначениеЗаполнено(ПлатежныйДокументОбъект.ДокументОснование) Тогда
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Расчетно-платежный документ ""%1"" не связан с документом-основанием'"),
				ПлатежныйДокументОбъект);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;

		Если ПлатежныйДокументОбъект.ДокументОснование <> Ведомость Тогда
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Расчетно-платежный документ связан с другим документом-основанием: ""%1""'"),
				ПлатежныйДокументОбъект.ДокументОснование);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	
		ПлатежныйДокументОбъект.ДокументОснование = Неопределено;
		
		РежимЗаписи = ?(ПлатежныйДокументОбъект.Проведен, РежимЗаписиДокумента.ОтменаПроведения,
			РежимЗаписиДокумента.Запись);
		
		Попытка
			ПлатежныйДокументОбъект.Записать(РежимЗаписи);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаголовокОшибки = СтрШаблон(НСтр("ru = 'Не удалось %1 ""%2"":'"),
				?(РежимЗаписи = РежимЗаписиДокумента.Запись, НСтр("ru = 'записать'"),
				?(РежимЗаписи = РежимЗаписиДокумента.Проведение, НСтр("ru = 'провести'"),
				НСтр("ru = 'отменить проведение'"))),
				ПлатежныйДокументОбъект);
		    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
		       ЗаголовокОшибки);
			ВызватьИсключение(Уточнение.Текст, Уточнение.Категория, , , ИнформацияОбОшибке);
		КонецПопытки;
		
	    ЗаписьЖурналаРегистрации(НСтр("ru = 'Платежные ведомости. Ведомость откреплена'"),
	       УровеньЖурналаРегистрации.Информация, , Ведомость,
	       СтрШаблон(НСтр("ru = 'Ведомость ""%1"" откреплена от расчетно-платежного документа ""%2""'"),
	       Ведомость, ПлатежныйДокументОбъект), 
	       РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная);

		Если ПлатежныйДокументОбъект.Заблокирован() Тогда
			ПлатежныйДокументОбъект.Разблокировать();
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	    ЗаписьЖурналаРегистрации(НСтр("ru = 'Платежные ведомости. Не удалось открепить ведомость'"),
	       УровеньЖурналаРегистрации.Предупреждение, , Ведомость,
	       ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

		Результат.Ошибка = Истина;
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
	КонецПопытки;

	Возврат	Результат;

КонецФункции

// Перезаполняет платежно-расчетный документ по данным ведомости
// В одной транзакции записывает ведомость и платежно-расчетный документ
// Вызывается из формы документа ВедомостьНаВыплатуВБанк и ВедомостьКомпенсацииРодительскойПлатыКВыплате
// 
// Параметры:
//	ВедомостьОбъект - ДокументОбъект.ВедомостьНаВыплатуВБанк
//	                - ДокументОбъект.ВедомостьКомпенсацииРодительскойПлатыКВыплате
//	ПлатежныйДокумент - ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная
//	                  - ДокументСсылка.ЗаявкаНаКассовыйРасход
//	                  - ДокументСсылка.ПлатежноеПоручение
//	                  - ДокументСсылка.КассовоеВыбытие
//	                  - ДокументСсылка.РСКППеречисление
//  ПараметрыЗаполнения - Структура:
//                         * ЗаписатьВедомость - Булево - ведомость была модифицирована, требуется записать ведомость
//                         * РежимЗаписи - РежимЗаписиДокумента - режим записи ПлатежныйДокумент после перезаполнения
//                         * ЗаполнитьДетализацию - Булево - заполнить только детализацию, для РСКП (перечисление)
// 
// Возвращаемое значение:
//   Структура:
//    * Ошибка - Булево - Истина - ведомость не может быть откреплена или возникла ошибка
//    * ИнформацияОбОшибке - ИнформацияОбОшибке - если Ошибка = Истина
//                         - Неопределено - если Ошибка <> Истина
//
Функция ПерезаполнитьПлатежныйДокументПоВедомости(ВедомостьОбъект, ПлатежныйДокумент, ПараметрыЗаполнения) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ИнформацияОбОшибке", Неопределено);

	НачатьТранзакцию();
	Попытка
		
		Если ПараметрыЗаполнения.ЗаписатьВедомость Тогда
			
			РежимЗаписи = ?(ВедомостьОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
			Попытка
				ВедомостьОбъект.Записать(РежимЗаписи);
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ЗаголовокОшибки = СтрШаблон(НСтр("ru = 'Не удалось %1 ""%2"":'"),
					?(РежимЗаписи = РежимЗаписиДокумента.Проведение, НСтр("ru = 'провести'"), НСтр("ru = 'записать'")),
					ВедомостьОбъект);
			    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
			       ЗаголовокОшибки);
				ВызватьИсключение(Уточнение.Текст, Уточнение.Категория, , , ИнформацияОбОшибке);
			КонецПопытки;
		
		Иначе
			Попытка
				БлокировкаДанных = Новый БлокировкаДанных;
				ЭлементБлокировкиДанных = БлокировкаДанных.Добавить(ВедомостьОбъект.Метаданные().ПолноеИмя());
				ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", ВедомостьОбъект.Ссылка);
				ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Разделяемый;
				БлокировкаДанных.Заблокировать();
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
			    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
			       СтрШаблон(НСтр(
			       	"ru = 'Ведомость ""%1"" редактируется в другом сеансе. Необходимо завершить её редактирование:'"),
			       	ВедомостьОбъект));
				ВызватьИсключение(Уточнение.Текст, Уточнение.Категория, , , ИнформацияОбОшибке);
			КонецПопытки;
		КонецЕсли;
		
		Попытка
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить(ПлатежныйДокумент.Метаданные().ПолноеИмя());
			ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", ПлатежныйДокумент);
			БлокировкаДанных.Заблокировать();
			
			ПлатежныйДокументОбъект = ПлатежныйДокумент.ПолучитьОбъект();
			ПлатежныйДокументОбъект.Заблокировать();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
		    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
		       НСтр("ru = 'Расчетно-платежный документ занят. Необходимо завершить его редактирование:'"));
			ВызватьИсключение(Уточнение.Текст, Уточнение.Категория, , , ИнформацияОбОшибке);
		КонецПопытки;
		
		Попытка
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.СостояниеПлатежноРасчетныхДокументов");
			ЭлементБлокировкиДанных.УстановитьЗначение("ПлатежноРасчетныйДокумент", ПлатежныйДокумент);
			ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Разделяемый;
			БлокировкаДанных.Заблокировать();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
		    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке);
			ВызватьИсключение(Уточнение.Текст, Уточнение.Категория, , , ИнформацияОбОшибке);
		КонецПопытки;
		
		ЗаполнитьДетализацию = ПараметрыЗаполнения.ЗаполнитьДетализацию;
		СтатусПлатежногоДокумента = БухгалтерскиеОперации.СтатусДокумента(ПлатежныйДокумент);
		Если ЗначениеЗаполнено(СтатусПлатежногоДокумента)
			И СтатусПлатежногоДокумента <> Перечисления.СтатусыИсполненияДокумента.ВРаботе Тогда
				
			Если ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.РСКППеречисление") Тогда
				ЗаполнитьДетализацию = Истина;
			КонецЕсли;
			
		КонецЕсли;

		Если ЗаполнитьДетализацию 
			И ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.РСКППеречисление") Тогда
			
			ТекстСообщения = ЗаполнитьДетализациюРСКППоВедомости(ВедомостьОбъект.Ссылка, ПлатежныйДокументОбъект);
			Если ЗначениеЗаполнено(ТекстСообщения) Тогда
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		
		Иначе
			
			ПлатежныйДокументОбъект.Заполнить(ВедомостьОбъект.Ссылка);
			
		КонецЕсли;

		ПлатежныйДокументОбъект.ДополнительныеСвойства.Вставить("НеПроверятьСоответствиеВедомости", Истина);
		РежимЗаписи = ПараметрыЗаполнения.РежимЗаписи;
		Попытка
			ПлатежныйДокументОбъект.Записать(РежимЗаписи);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаголовокОшибки = СтрШаблон(НСтр("ru = 'Не удалось %1 ""%2"":'"),
				?(РежимЗаписи = РежимЗаписиДокумента.Запись, НСтр("ru = 'записать'"),
				?(РежимЗаписи = РежимЗаписиДокумента.Проведение, НСтр("ru = 'провести'"),
				НСтр("ru = 'отменить проведение'"))),
				ПлатежныйДокументОбъект);
		    Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
		       ЗаголовокОшибки);
			ВызватьИсключение(Уточнение.Текст, Уточнение.Категория, , , ИнформацияОбОшибке);
		КонецПопытки;

	    ЗаписьЖурналаРегистрации(НСтр("ru = 'Платежные ведомости. Расчетно-платежный документ перезаполнен'"),
	       УровеньЖурналаРегистрации.Информация, , ВедомостьОбъект.Ссылка,
	       СтрШаблон(НСтр("ru = 'Расчетно-платежный документ ""%1"" перезаполнен по данным ведомости ""%2""'"),
	       ПлатежныйДокументОбъект, ВедомостьОбъект), 
	       РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная);

		Если ПлатежныйДокументОбъект.Заблокирован() Тогда
			ПлатежныйДокументОбъект.Разблокировать();
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	    ЗаписьЖурналаРегистрации(НСтр("ru = 'Платежные ведомости. Не удалось перезаполнить расчетно-платежный документ'"),
	       УровеньЖурналаРегистрации.Предупреждение, , ВедомостьОбъект.Ссылка,
	       ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

		Результат.Ошибка = Истина;
		Результат.ИнформацияОбОшибке = ИнформацияОбОшибке;
	КонецПопытки;

	Возврат	Результат;
	
КонецФункции

// Заполняет детализацию платежа документа РСКППеречисление на основании ведомости, сопоставляя строки ведомости
// с расшифровкой платежа
//
// Параметры:
//	Ведомость - ДокументСсылка.ВедомостьНаВыплатуВБанк
//	          - ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате
//	Объект - ДокументОбъект.РСКППеречисление
//	
// Возвращаемое значение:
//   Строка - Текстовое сообщение при наличии ошибок заполнения
//
Функция ЗаполнитьДетализациюРСКППоВедомости(Ведомость, Объект) Экспорт
	
	ТекстСообщения = "";

	Отказ = Ложь;

	Если НеПроверятьРасшифровкуКомпенсацииРодительскойПлаты(Ведомость) Тогда
		ПроверитьПлатежныйДокументНаСоответствиеВедомостиОбщейСуммой(Ведомость, Объект, Отказ);
	Иначе
		ПроверитьРСКППеречислениеНаСоответствиеВедомости(Ведомость, Объект, Истина, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат НСтр("ru='Обнаружено расхождение данных ведомости и распоряжения о перечислении средств.'");
	КонецЕсли;
	
	Объект.ДетализацияПлатежа.Очистить();
 	
	Если ТипЗнч(Ведомость) = Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда

		КОСГУКомпенсации = Неопределено;
		ДокументНачислениеКомпенсации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ведомость, "ДокументОснование");
		ДанныеКОСГУКомпенсации = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументНачислениеКомпенсации,
			"КЭК");
		Если ДанныеКОСГУКомпенсации.КЭК <> Неопределено Тогда
			КОСГУКомпенсации = ДанныеКОСГУКомпенсации.КЭК;
		Иначе
			КОСГУКомпенсации = БухгалтерскийУчетПовтИсп.КЭКПоКоду("262");
		КонецЕсли;
	
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВедомостьКомпенсации.КПС КАК КБКНазначениеПлатежа,
		|	ВедомостьКомпенсации.КФО КАК КФО,
		|	ВедомостьКомпенсации.КПС.ВидПоказателя КАК ВидПоказателя,
		|	ВедомостьКомпенсации.КПС.УточнениеПоказателя КАК УточнениеПоказателя,
		|	ВЫРАЗИТЬ(ПРАВ(ЕСТЬNULL(ВедомостьКомпенсации.КПС.Код, """"), 3) КАК СТРОКА(3)) КАК КодАналитическойГруппы,
		|	СУММА(ВедомостьКомпенсации.СуммаКомпенсации) КАК Сумма
		|ИЗ
		|	Документ.ВедомостьКомпенсацииРодительскойПлатыКВыплате.ВедомостьКомпенсации КАК ВедомостьКомпенсации
		|ГДЕ
		|	ВедомостьКомпенсации.Ссылка = &Ссылка
		|	И НЕ ВедомостьКомпенсации.Аннулировано
		|СГРУППИРОВАТЬ ПО
		|	ВедомостьКомпенсации.КПС,
		|	ВедомостьКомпенсации.КФО,
		|	ВедомостьКомпенсации.КПС.ВидПоказателя,
		|	ВедомостьКомпенсации.КПС.УточнениеПоказателя,
		|	ВЫРАЗИТЬ(ПРАВ(ЕСТЬNULL(ВедомостьКомпенсации.КПС.Код, """"), 3) КАК СТРОКА(3))";
		
		Запрос.УстановитьПараметр("Ссылка", Ведомость);
		СоставВедомости = Запрос.Выполнить().Выгрузить();
		СоставВедомости.Колонки.Добавить("КОСГУНазначениеПлатежа", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
		СоставВедомости.Колонки.Добавить("КодЦели", Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
		СоставВедомости.ЗаполнитьЗначения(КОСГУКомпенсации, "КОСГУНазначениеПлатежа");
		
	ИначеЕсли ТипЗнч(Ведомость) = Тип("ДокументСсылка.ВедомостьНаВыплатуВБанк") Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РасшифровкаПлатежа.КПС КАК КБКНазначениеПлатежа,
		|	РасшифровкаПлатежа.КФО КАК КФО,
		|	РасшифровкаПлатежа.КЭК КАК КОСГУНазначениеПлатежа,
		|	РасшифровкаПлатежа.КодЦели КАК КодЦели,
		|	РасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
		|	РасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
		|	РасшифровкаПлатежа.КПС.ВидПоказателя КАК ВидПоказателя,
		|	РасшифровкаПлатежа.КПС.УточнениеПоказателя КАК УточнениеПоказателя,
		|	ВЫРАЗИТЬ(ПРАВ(ЕСТЬNULL(РасшифровкаПлатежа.КПС.Код, """"), 3) КАК СТРОКА(3)) КАК КодАналитическойГруппы,
		|	СУММА(РасшифровкаПлатежа.Сумма) КАК Сумма
		|ИЗ
		|	Документ.ВедомостьНаВыплатуВБанк.РасшифровкаПлатежа КАК РасшифровкаПлатежа
		|ГДЕ
		|	РасшифровкаПлатежа.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	РасшифровкаПлатежа.КПС,
		|	РасшифровкаПлатежа.КФО,
		|	РасшифровкаПлатежа.КЭК,
		|	РасшифровкаПлатежа.КодЦели,
		|	РасшифровкаПлатежа.КодМероприятия,
		|	РасшифровкаПлатежа.ДопКлассификация,
		|	РасшифровкаПлатежа.КПС.ВидПоказателя,
		|	РасшифровкаПлатежа.КПС.УточнениеПоказателя,
		|	ВЫРАЗИТЬ(ПРАВ(ЕСТЬNULL(РасшифровкаПлатежа.КПС.Код, """"), 3) КАК СТРОКА(3))";
		
		Запрос.УстановитьПараметр("Ссылка", Ведомость);
		СоставВедомости = Запрос.Выполнить().Выгрузить();
		
	Иначе
		Возврат СтрШаблон(НСтр("ru='Заполнение на основании ""%1"" не предусмотрено'"),	ТипЗнч(Ведомость));
	КонецЕсли;
	
	Если Объект.Контрагенты.Количество() = 1 Тогда
		Контрагент = Объект.Контрагенты[0].Контрагент;
	Иначе
		Контрагент = Неопределено;
	КонецЕсли;
	
	РасшифровкаПлатежа = Объект.РасшифровкаПлатежа.Выгрузить();
	РасшифровкаПлатежа.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	РасшифровкаПлатежа.Колонки.Добавить("ВидПоказателя", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКБК"));
	РасшифровкаПлатежа.Колонки.Добавить("УточнениеПоказателя", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКБК"));
	РасшифровкаПлатежа.Колонки.Добавить("КодАналитическойГруппы", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(3)));
	Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежа Цикл
		КодПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаРасшифровки.РазделЛС, "КодПоступленияЕБП");
		СтрокаРасшифровки.КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(КодПоступления);
		РеквизитыКБК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаРасшифровки.КБКНазначениеПлатежа,
			"ВидПоказателя,УточнениеПоказателя,Код");
		СтрокаРасшифровки.ВидПоказателя = РеквизитыКБК.ВидПоказателя;
		СтрокаРасшифровки.УточнениеПоказателя = РеквизитыКБК.УточнениеПоказателя;
		СтрокаРасшифровки.КодАналитическойГруппы = Прав(РеквизитыКБК.Код, 3);
	КонецЦикла;

	ВариантыОтбора = Новый Массив;
	
	ПоляОтбора = "КФО,КБКНазначениеПлатежа,КодЦели";
	ВариантыОтбора.Добавить(Новый Структура(ПоляОтбора));
	
	ПоляОтбора = "КФО,КБКНазначениеПлатежа";
	ВариантыОтбора.Добавить(Новый Структура(ПоляОтбора));
	
	ПоляОтбора = "КФО,ВидПоказателя,УточнениеПоказателя,КодАналитическойГруппы,КодЦели";
	ВариантыОтбора.Добавить(Новый Структура(ПоляОтбора));
	
	ПоляОтбора = "КФО,ВидПоказателя,УточнениеПоказателя,КодАналитическойГруппы";
	ВариантыОтбора.Добавить(Новый Структура(ПоляОтбора));
	
	ИндексСтроки = СоставВедомости.Количество() - 1;
	Пока ИндексСтроки >= 0 Цикл
		СтрокаВедомости = СоставВедомости[ИндексСтроки];
		
		Для Каждого Отбор Из ВариантыОтбора Цикл
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаВедомости);
			НашлиСтроки = РасшифровкаПлатежа.НайтиСтроки(Отбор);
			Если НашлиСтроки.Количество() > 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НашлиСтроки.Количество() > 0 Тогда
			СтрокаРасшифровки = НашлиСтроки[0];
			НоваяСтрока = Объект.ДетализацияПлатежа.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасшифровки);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВедомости);
			Если ЗначениеЗаполнено(СтрокаРасшифровки.КодЦели) И Не ЗначениеЗаполнено(НоваяСтрока.КодЦели) Тогда
				НоваяСтрока.КодЦели = СтрокаРасшифровки.КодЦели;
			КонецЕсли;
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
				НоваяСтрока.КОСГУНазначениеПлатежа, Объект.КорСчет, , Объект.Дата, Объект.Организация, Объект.ИФО);
			НоваяСтрока.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг; 
			НоваяСтрока.Контрагент = Контрагент; 
			НоваяСтрока.СуммаВал = СтрокаВедомости.Сумма;			
			СоставВедомости.Удалить(ИндексСтроки);
		КонецЕсли;
		ИндексСтроки = ИндексСтроки - 1;
	КонецЦикла;
	
	Если СоставВедомости.Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не все строки ведомости удалось сопоставить с расшировкой платежа'");
	КонецЕсли;

	Возврат ТекстСообщения;
КонецФункции

// Заполняет список допустимых КФО и источников средств для переданного лицевого счета.
// Используется в расчетно-платежных документах для ограничения списка КФО и источников средств.
//
// Параметры:
//	ЛицевойСчет - СправочникСсылка.ЛицевыеСчета, ссылка на лицевой счет
//	СписокКФО - СписокЗначений. Список значение типа ПеречислениеСсылка.КВД
//	ТаблицаКФОиИсточниковСредств - ТаблицаЗначений. Таблица, колонки:
//				КФО - ПеречислениеСсылка.КВД
//				СписокИсточников - Список значение типа СправочникСсылка.ИсточникиСредств
//
Процедура ЗаполнитьДопустимыеКФОиИсточникиСредств(ЛицевойСчет,СписокКФО,ТаблицаКФОиИсточниковСредств) Экспорт
	
	ДопустимыеКФО = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеКФО(,ЛицевойСчет);
	СписокКФО.ЗагрузитьЗначения(ДопустимыеКФО);
	
	ТаблицаКФОиИсточниковСредств.Очистить();
	Для Каждого КФО Из ДопустимыеКФО Цикл
		
		СписокИсточников = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(ЛицевойСчет,КФО);
		
		НоваяСтрокаСпискаИС = ТаблицаКФОиИсточниковСредств.Добавить();
		НоваяСтрокаСпискаИС.КФО = КФО;
		НоваяСтрокаСпискаИС.СписокИсточников.ЗагрузитьЗначения(СписокИсточников);
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет расчетно-платежный документ на основании документа "Заявление на выдачу аванса".
// Вызывается из события ОбработкаЗаполнения расчетно-платежного документа
//
// Параметры:
//	ПлатежныйДокумент - ДокументОбъект, заполняемый расчетно-платежный документ
//	ДанныеЗаполнения - ДокументСсылка.ЗаявлениеНаВыдачуАванса, ссылка на заявление-основание
//	Отмена - Булево, признак отказа от стандартной обработки заполнения.
//			Соответствует параметру СтандартнаяОбработка в событии ОбработкаЗаполнения
//
Процедура ЗаполнитьПлатежныйДокументНаОснованииЗаявленияНаВыдачуАванса(ПлатежныйДокумент, ДанныеЗаполнения, Отмена) Экспорт
	
	Если ДанныеЗаполнения.СуммаДокумента > 0 И ДанныеЗаполнения.СуммаДокументаВВалюте > 0 Тогда
		ТекстИсключения = НСтр("ru='Ввод на основании заявления на выдачу аванса в нескольких валютах невозможен!'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Если ДанныеЗаполнения.СуммаДокументаВВалюте > 0 И ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.ПлатежноеПоручение") Тогда
		ТекстИсключения = НСтр("ru='Платежное поручение не может быть введено на основании заявления в иностранной валюте.'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Если ТипЗнч(ПлатежныйДокумент) = Тип("ДокументОбъект.ЗаявкаНаКассовыйРасходСокращенная") Тогда
		Если ДанныеЗаполнения.СуммаДокументаВВалюте > 0 Тогда
			ТекстИсключения = НСтр("ru='Заявка на кассовый расход (сокращенная) не может быть введена на основании заявления в иностранной валюте.'");
			ВызватьИсключение ТекстИсключения;
		Иначе
			СвернутаяТЧ = ДанныеЗаполнения.РасчетРазмераАванса.Выгрузить();
			СвернутаяТЧ.Свернуть("КФО, КПС, КЭК");
			Если СвернутаяТЧ.Количество() > 1 Тогда
				ТекстИсключения = НСтр("ru='Заявка на кассовый расход (сокращенная) не может быть введена на основании заявления с различными кодами бюджетной классификации.'");
				ВызватьИсключение ТекстИсключения;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПлатежныйДокумент.Организация = ДанныеЗаполнения.Организация;
	ПлатежныйДокумент.ИФО = ДанныеЗаполнения.ИФО;
	ПлатежныйДокумент.Подразделение = ДанныеЗаполнения.Подразделение;
	ПлатежныйДокумент.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.Сотрудник, "Контрагент");
	ПлатежныйДокумент.Договор = ДанныеЗаполнения.ОснованиеПринятияОбязательства;
	
	ИмяТаблицы = ОбщегоНазначения.ИмяТаблицыПоСсылке(ПлатежныйДокумент.Ссылка);
	ПлатежныйДокумент.СчетКонтрагента = Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(ПлатежныйДокумент.Контрагент, ИмяТаблицы);
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход"
		ИЛИ ИмяТаблицы = "Документ.ПлатежноеПоручение" Тогда
		Документы.ЗаявкаНаКассовыйРасход.ЗаполнитьРеквизитыПолучателя(ПлатежныйДокумент);
	ИначеЕсли ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
		Документы.ЗаявкаНаКассовыйРасходСокращенная.ЗаполнитьРеквизитыПолучателя(ПлатежныйДокумент);
	ИначеЕсли ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
		ПлатежныйДокумент.ПолучательПлатежа = ПлатежныйДокумент.Контрагент;
	КонецЕсли;
	
	ПлатежныйДокумент.КорСчет = БухгалтерскийУчет.СчетПоКоду("208.00", ТекущаяДатаСеанса(), ПлатежныйДокумент.Организация);
	
	СправочникЛицевойСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.РазделЛицевогоСчета, "Владелец");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыЛицевыхСчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	|ГДЕ
	|	РеквизитыЛицевыхСчетов.Владелец = &Владелец
	|	И НЕ РеквизитыЛицевыхСчетов.ПометкаУдаления
	|	И РеквизитыЛицевыхСчетов.Владелец.ДатаОткрытия <= &Дата
	|	И (РеквизитыЛицевыхСчетов.Владелец.ДатаЗакрытия > &Дата
	|			ИЛИ РеквизитыЛицевыхСчетов.Владелец.ДатаЗакрытия = &ПустаяДата)";
	Запрос.УстановитьПараметр("Владелец", СправочникЛицевойСчет);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		ПлатежныйДокумент.ЛицевойСчет = СправочникЛицевойСчет;
		
		Если ИмяТаблицы = "Документ.ПлатежноеПоручение" Тогда
			ПлатежныйДокумент.РеквизитыЛицевогоСчета = Выборка.Ссылка;
			РеквизитыПлательщика = Новый Структура("ИННПлательщика, КПППлательщика, ПлательщикНаименование, ПлательщикБанковскийСчет, ПлательщикНаименованиеБанка, ПлательщикБИКБанка, ПлательщикКорСчетБанка", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ПлатежныйДокумент.ЛицевойСчет, ПлатежныйДокумент.РеквизитыЛицевогоСчета, РеквизитыПлательщика);
			ЗаполнитьЗначенияСвойств(ПлатежныйДокумент, РеквизитыПлательщика);
		ИначеЕсли ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход"
			ИЛИ ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
			ПлатежныйДокумент.РеквизитыЛицевогоСчета = Выборка.Ссылка;
			ПлатежныйДокумент.ОрганКазначейства = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежныйДокумент.РеквизитыЛицевогоСчета, "КассовыйОрган");
			СвойстваЛицевогоСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(ПлатежныйДокумент.ЛицевойСчет, ПлатежныйДокумент.Дата);
			ЗаполнитьЗначенияСвойств(ПлатежныйДокумент, СвойстваЛицевогоСчета);
		КонецЕсли;
		
		СписокДопустимыхКФО = Новый СписокЗначений;
		
		ТипСписокЗначений = Новый ОписаниеТипов("СписокЗначений");
		СписокИсточниковСредствПоКФО = Новый ТаблицаЗначений;
		СписокИсточниковСредствПоКФО.Колонки.Добавить("КФО");
		СписокИсточниковСредствПоКФО.Колонки.Добавить("СписокИсточников", ТипСписокЗначений);
		
		ПлатежноРасчетныеДокументы.ЗаполнитьДопустимыеКФОиИсточникиСредств(ПлатежныйДокумент.ЛицевойСчет, СписокДопустимыхКФО, СписокИсточниковСредствПоКФО);
		
	Иначе
		ТекстСообщения = НСтр("ru='Не удалось автоматически определить реквизиты лицевого счета.
		|Будет выбрано значение лицевого счета по-умолчанию.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ПлатежныйДокумент.Ссылка, "ЛицевойСчет");
	КонецЕсли;
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
		Если ДанныеЗаполнения.СуммаДокументаВВалюте = 0 Тогда
			ПлатежныйДокумент.ВалютаДокумента = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
		Иначе
			ПлатежныйДокумент.ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
		КонецЕсли;
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ПлатежныйДокумент.ВалютаДокумента, ПлатежныйДокумент.Дата);
		ПлатежныйДокумент.Курс = КурсКратность.Курс;
		ПлатежныйДокумент.Кратность = КурсКратность.Кратность;
	КонецЕсли;
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
		СтрокаОснования = ДанныеЗаполнения.РасчетРазмераАванса[0];
		Если СписокИсточниковСредствПоКФО <> Неопределено Тогда
			ИсточникиСредствПоКФО = СписокИсточниковСредствПоКФО.НайтиСтроки(Новый Структура("КФО",СтрокаОснования.КФО));
			Если ИсточникиСредствПоКФО.Количество() = 1 И ИсточникиСредствПоКФО[0].СписокИсточников.Количество() = 1 Тогда
				ПлатежныйДокумент.КФО = СтрокаОснования.КФО;
				ПлатежныйДокумент.ИсточникСредств = ИсточникиСредствПоКФО[0].СписокИсточников[0].Значение;
			Иначе
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'КФО %1 из документа %2 не входит в допустимые КФО для лицевого счета %3'"),
								СтрокаОснования.КФО, ДанныеЗаполнения, СправочникЛицевойСчет) + НСтр("ru = '
								|В строку будет автоматически подставлен допустимый КФО'.");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ПлатежныйДокумент.Ссылка, "КФО");
			КонецЕсли;
		Иначе
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'КФО %1 из документа %2 не входит в допустимые КФО для лицевого счета %3'"),
							СтрокаОснования.КФО, ДанныеЗаполнения, СправочникЛицевойСчет) + НСтр("ru = '
							|В строку будет автоматически подставлен допустимый КФО'.");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ПлатежныйДокумент.Ссылка, "КФО");
		КонецЕсли;
		ПлатежныйДокумент.КБКНазначениеПлатежа = СтрокаОснования.КПС;
		ПлатежныйДокумент.КОСГУНазначениеПлатежа = СтрокаОснования.КЭК;
		ПлатежныйДокумент.СуммаДокумента = ДанныеЗаполнения.РасчетРазмераАванса.Итог("Сумма");
	Иначе
		Для Каждого СтрокаОснования Из ДанныеЗаполнения.РасчетРазмераАванса Цикл
			СтрРасшифровка = ПлатежныйДокумент.РасшифровкаПлатежа.Добавить();
			Если СписокИсточниковСредствПоКФО <> Неопределено Тогда
				ИсточникиСредствПоКФО = СписокИсточниковСредствПоКФО.НайтиСтроки(Новый Структура("КФО",СтрокаОснования.КФО));
				Если ИсточникиСредствПоКФО.Количество() = 1 И ИсточникиСредствПоКФО[0].СписокИсточников.Количество() = 1 Тогда
					СтрРасшифровка.КФО = СтрокаОснования.КФО;
					СтрРасшифровка.ИсточникСредств = ИсточникиСредствПоКФО[0].СписокИсточников[0].Значение;
				Иначе
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru = 'КФО %1 из документа %2 не входит в допустимые КФО для лицевого счета %3'"),
									СтрокаОснования.КФО, ДанныеЗаполнения, СправочникЛицевойСчет) + НСтр("ru = '
									|В строку будет автоматически подставлен допустимый КФО'.");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ПлатежныйДокумент.Ссылка, "РасшифровкаПлатежа["+(СтрРасшифровка.НомерСтроки-1)+"].КФО");
				КонецЕсли;
			Иначе
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'КФО %1 из документа %2 не входит в допустимые КФО для лицевого счета %3'"),
								СтрокаОснования.КФО, ДанныеЗаполнения, СправочникЛицевойСчет) + НСтр("ru = '
								|В строку будет автоматически подставлен допустимый КФО'.");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ПлатежныйДокумент.Ссылка, "РасшифровкаПлатежа["+(СтрРасшифровка.НомерСтроки-1)+"].КФО");
			КонецЕсли;
			СтрРасшифровка.КБКНазначениеПлатежа = СтрокаОснования.КПС;
			СтрРасшифровка.КОСГУНазначениеПлатежа = СтрокаОснования.КЭК;
			Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
				Если ДанныеЗаполнения.СуммаДокументаВВалюте = 0 Тогда
					СтрРасшифровка.Сумма = СтрокаОснования.Сумма;
					СтрРасшифровка.СуммаВал = СтрокаОснования.Сумма;
				Иначе
					СтрРасшифровка.Сумма = СтрокаОснования.СуммаВВалюте * ПлатежныйДокумент.Курс / ПлатежныйДокумент.Кратность;
					СтрРасшифровка.СуммаВал = СтрокаОснования.СуммаВВалюте;
				КонецЕсли;
			Иначе
				СтрРасшифровка.Сумма = СтрокаОснования.Сумма;
			КонецЕсли;
		КонецЦикла;
		
		ПлатежныйДокумент.СуммаДокумента = ПлатежныйДокумент.РасшифровкаПлатежа.Итог("Сумма");
		Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
			ПлатежныйДокумент.СуммаДокументаВВалюте = ПлатежныйДокумент.РасшифровкаПлатежа.Итог("СуммаВал");
		КонецЕсли;
		
	КонецЕсли;
	
	ПлатежныйДокумент.ДокументОснование = ДанныеЗаполнения;
	
КонецПроцедуры

// Заполняет платежно-расчетный документ при вводе на основании.
// 
// Параметры:
// 	Объект - ДокументОбъект.ЗаявкаНаКассовыйРасход - заполняемый объект,
//         - ДокументОбъект.ЗаявкаНаКассовыйРасходСокращенная - за, 
//         - ДокументОбъект.КассовоеВыбытие - 
//         - ДокументОбъект.ПлатежноеПоручение - 
// 	ДокументОснование - ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате - документ-основание.
// 	СтандартнаяОбработка - Булево - продолжать стандартное заполнение объекта.
Процедура ЗаполнитьНаОснованииВедомостиКомпенсацииРодительскойПлатыКВыплате(Объект, ДокументОснование, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
		ВызватьИсключение НСтр("ru='Не правильный тип параметра при вызове процедуры'");
	КонецЕсли;

	РасчетноПлатежныйДокумент = ВведенныйНаОснованииВедомостиКомпенсацииРасчетноПлатежныйДокумент(ДокументОснование);
	Если ЗначениеЗаполнено(РасчетноПлатежныйДокумент) И Объект.Ссылка <> РасчетноПлатежныйДокумент Тогда
		ТекстИсключения = СтрШаблон(НСтр(
			"ru='На основании ведомости компенсации уже введен расчетно-платежный документ (%1)'"),
			РасчетноПлатежныйДокумент);
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	МетаданныеОбъекта = Объект.Метаданные();
	
	ЧитаемыеДанные = Новый Структура("Организация, ИФО, СуммаДокумента, Дата");
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ИННПлательщика", МетаданныеОбъекта) Тогда
		ЧитаемыеДанные.Вставить("ИННПлательщика", "Организация.ИНН");
		ЧитаемыеДанные.Вставить("КПППлательщика", "Организация.КПП");
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("СуммаДокументаВВалюте", МетаданныеОбъекта) Тогда
		ЧитаемыеДанные.Вставить("СуммаДокументаВВалюте", "СуммаДокумента");
	КонецЕсли;
	ДанныеОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЧитаемыеДанные);
	ЗаполнитьЗначенияСвойств(Объект, ДанныеОснования);
	
	Объект.Контрагент        = Константы.КонтрагентДляНачисленияКомпенсацииРодительскойПлаты.Получить();
	Объект.ДокументОснование = ДокументОснование;
	Объект.КорСчет           = БухгалтерскийУчет.СчетПоКоду("302.00");
	
	УчитыватьВалюту = ОбщегоНазначения.ЕстьРеквизитОбъекта("ВалютаДокумента", МетаданныеОбъекта);
	Если УчитыватьВалюту Тогда
		Объект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Объект.СчетКонтрагента = ПолучитьРасчетныйСчетКонтрагента(Объект.Контрагент);
	КонецЕсли;

	КОСГУКомпенсации = Неопределено;
	ДокументНачислениеКомпенсации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ДокументОснование");
	ДанныеКОСГУКомпенсации = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументНачислениеКомпенсации, "КЭК");
	Если ДанныеКОСГУКомпенсации.КЭК <> Неопределено Тогда
		КОСГУКомпенсации = ДанныеКОСГУКомпенсации.КЭК;
	Иначе
		КОСГУКомпенсации = БухгалтерскийУчетПовтИсп.КЭКПоКоду("262");
	КонецЕсли;
	
	СоставВедомости = Документы.ВедомостьКомпенсацииРодительскойПлатыКВыплате.ВедомостьКомпенсацииПоКПС(ДокументОснование);
	
	Если ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("РасшифровкаПлатежа", МетаданныеОбъекта) Тогда
		
		Объект.РасшифровкаПлатежа.Очистить(); 		
		Для Каждого СтрокаСостава Из СоставВедомости Цикл
			СтрокаРасшифровки = Объект.РасшифровкаПлатежа.Добавить();
			СтрокаРасшифровки.КБКНазначениеПлатежа   = СтрокаСостава.КПС;
			СтрокаРасшифровки.КФО                    = СтрокаСостава.КФО;
			СтрокаРасшифровки.Сумма                  = СтрокаСостава.СуммаКомпенсации;
			СтрокаРасшифровки.КОСГУНазначениеПлатежа = КОСГУКомпенсации;
			СтрокаРасшифровки.СчетРасчетов           = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
				СтрокаРасшифровки.КОСГУНазначениеПлатежа, Объект.КорСчет,, Объект.Дата, Объект.Организация, Объект.ИФО);
			СтрокаРасшифровки.ВидРасчетов            = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
			Если УчитыватьВалюту Тогда
				СтрокаРасшифровки.СуммаВал = СтрокаСостава.СуммаКомпенсации;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("КБКНазначениеПлатежа", МетаданныеОбъекта) Тогда
	
		Если СоставВедомости.Количество() = 1 Тогда
			Объект.КБКНазначениеПлатежа = СоставВедомости[0].КПС;
			Объект.КФО                  = СоставВедомости[0].КФО;
		КонецЕсли;
		
		Объект.КОСГУНазначениеПлатежа = КОСГУКомпенсации; 
		Объект.СчетРасчетов           = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
			Объект.КОСГУНазначениеПлатежа, Объект.КорСчет,, Объект.Дата, Объект.Организация, Объект.ИФО);
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет расчетно-платежный документ на основании документа "Решение о командировании".
// Вызывается из события ОбработкаЗаполнения расчетно-платежного документа
//
// Параметры:
//	ПлатежныйДокумент - ДокументОбъект, заполняемый расчетно-платежный документ
//	ДанныеЗаполнения - ДокументСсылка.РешениеОКомандировании, ссылка на основание
//	Отмена - Булево, признак отказа от стандартной обработки заполнения.
//			Соответствует параметру СтандартнаяОбработка в событии ОбработкаЗаполнения
//
Процедура ЗаполнитьПлатежныйДокументНаОснованииРешенияОКомандировании(ПлатежныйДокумент, ДанныеЗаполнения, Отмена) Экспорт
	
	ЭтоИзменение = ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование);
	
	ПлатежныйДокумент.ДокументОснование = ДанныеЗаполнения;
	
	ПлатежныйДокумент.Организация = ДанныеЗаполнения.Организация;
	ПлатежныйДокумент.ИФО = ДанныеЗаполнения.ИФО;
	ПлатежныйДокумент.Подразделение = ДанныеЗаполнения.Подразделение;
	ПлатежныйДокумент.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.Сотрудник, "Контрагент");
	ПлатежныйДокумент.Договор = ДанныеЗаполнения.ОснованиеПринятияОбязательства;
	
	ИмяТаблицы = ОбщегоНазначения.ИмяТаблицыПоСсылке(ПлатежныйДокумент.Ссылка);
	ПлатежныйДокумент.СчетКонтрагента = Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(ПлатежныйДокумент.Контрагент, ИмяТаблицы);
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход"
		ИЛИ ИмяТаблицы = "Документ.ПлатежноеПоручение" Тогда
		Документы.ЗаявкаНаКассовыйРасход.ЗаполнитьРеквизитыПолучателя(ПлатежныйДокумент);
	ИначеЕсли ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
		Документы.ЗаявкаНаКассовыйРасходСокращенная.ЗаполнитьРеквизитыПолучателя(ПлатежныйДокумент);
	ИначеЕсли ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
		ПлатежныйДокумент.ПолучательПлатежа = ПлатежныйДокумент.Контрагент;
	КонецЕсли;
	
	ПлатежныйДокумент.КорСчет = БухгалтерскийУчет.СчетПоКоду("208.00", ТекущаяДатаСеанса(), ПлатежныйДокумент.Организация);
	
	СправочникЛицевойСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.РазделЛицевогоСчета, "Владелец");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыЛицевыхСчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	|ГДЕ
	|	РеквизитыЛицевыхСчетов.Владелец = &Владелец
	|	И НЕ РеквизитыЛицевыхСчетов.ПометкаУдаления
	|	И РеквизитыЛицевыхСчетов.Владелец.ДатаОткрытия <= &Дата
	|	И (РеквизитыЛицевыхСчетов.Владелец.ДатаЗакрытия > &Дата
	|			ИЛИ РеквизитыЛицевыхСчетов.Владелец.ДатаЗакрытия = &ПустаяДата)";
	Запрос.УстановитьПараметр("Владелец", СправочникЛицевойСчет);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		ПлатежныйДокумент.ЛицевойСчет = СправочникЛицевойСчет;
		
		Если ИмяТаблицы = "Документ.ПлатежноеПоручение" Тогда
			ПлатежныйДокумент.РеквизитыЛицевогоСчета = Выборка.Ссылка;
			РеквизитыПлательщика = Новый Структура("ИННПлательщика, КПППлательщика, ПлательщикНаименование, ПлательщикБанковскийСчет, ПлательщикНаименованиеБанка, ПлательщикБИКБанка, ПлательщикКорСчетБанка", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ПлатежныйДокумент.ЛицевойСчет, ПлатежныйДокумент.РеквизитыЛицевогоСчета, РеквизитыПлательщика);
			ЗаполнитьЗначенияСвойств(ПлатежныйДокумент, РеквизитыПлательщика);
		ИначеЕсли ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход"
			ИЛИ ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
			ПлатежныйДокумент.РеквизитыЛицевогоСчета = Выборка.Ссылка;
			ПлатежныйДокумент.ОрганКазначейства = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежныйДокумент.РеквизитыЛицевогоСчета, "КассовыйОрган");
			СвойстваЛицевогоСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(ПлатежныйДокумент.ЛицевойСчет, ПлатежныйДокумент.Дата);
			ЗаполнитьЗначенияСвойств(ПлатежныйДокумент, СвойстваЛицевогоСчета);
		КонецЕсли;
		
		СписокДопустимыхКФО = Новый СписокЗначений;
		
		ТипСписокЗначений = Новый ОписаниеТипов("СписокЗначений");
		СписокИсточниковСредствПоКФО = Новый ТаблицаЗначений;
		СписокИсточниковСредствПоКФО.Колонки.Добавить("КФО");
		СписокИсточниковСредствПоКФО.Колонки.Добавить("СписокИсточников", ТипСписокЗначений);
		
		ПлатежноРасчетныеДокументы.ЗаполнитьДопустимыеКФОиИсточникиСредств(ПлатежныйДокумент.ЛицевойСчет, СписокДопустимыхКФО, СписокИсточниковСредствПоКФО);
		
	Иначе
		ТекстСообщения = НСтр("ru='Не удалось автоматически определить реквизиты лицевого счета.
		|Будет выбрано значение лицевого счета по-умолчанию.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ПлатежныйДокумент, "ЛицевойСчет");
	КонецЕсли;
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
		ПлатежныйДокумент.ВалютаДокумента = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ПлатежныйДокумент.ВалютаДокумента, ПлатежныйДокумент.Дата);
		ПлатежныйДокумент.Курс = КурсКратность.Курс;
		ПлатежныйДокумент.Кратность = КурсКратность.Кратность;
	КонецЕсли;
	
	ТаблицаДляЗаполнения = ДанныеЗаполнения.ФинансовоеОбеспечение.Выгрузить();
	ТаблицаДляЗаполнения.Свернуть("КФО, КПС, КЭК, КодЦели, КодМероприятия, ДопКлассификация", "СуммаАванса, ИзменениеАванса");
	ТаблицаДляЗаполнения.Сортировать("КФО, КПС, КЭК");
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
		
		Если ТаблицаДляЗаполнения.Количество() > 1 Тогда
			ТекстИсключения = НСтр("ru='Заявка на кассовый расход (сокращенная) не может быть введена на основании решения с различными кодами бюджетной классификации.'");
			ВызватьИсключение ТекстИсключения;
		ИначеЕсли ТаблицаДляЗаполнения.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		СтрокаОснования = ТаблицаДляЗаполнения[0];
		
		Если ЭтоИзменение Тогда
			Сумма = СтрокаОснования.ИзменениеАванса;
		Иначе
			Сумма = СтрокаОснования.СуммаАванса;
		КонецЕсли;
		
		Если СписокИсточниковСредствПоКФО <> Неопределено Тогда
			ИсточникиСредствПоКФО = СписокИсточниковСредствПоКФО.НайтиСтроки(Новый Структура("КФО", СтрокаОснования.КФО));
			Если ИсточникиСредствПоКФО.Количество() > 0 Тогда
				ПлатежныйДокумент.КФО = СтрокаОснования.КФО;
				Если ИсточникиСредствПоКФО.Количество() = 1 И ИсточникиСредствПоКФО[0].СписокИсточников.Количество() = 1 Тогда
					ПлатежныйДокумент.ИсточникСредств = ИсточникиСредствПоКФО[0].СписокИсточников[0].Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ПлатежныйДокумент.КБКНазначениеПлатежа = СтрокаОснования.КПС;
		ПлатежныйДокумент.КОСГУНазначениеПлатежа = СтрокаОснования.КЭК;
		ПлатежныйДокумент.КодЦели = СтрокаОснования.КодЦели; 
		ПлатежныйДокумент.КодМероприятия = СтрокаОснования.КодМероприятия;
		ПлатежныйДокумент.ДопКлассификация = СтрокаОснования.ДопКлассификация;
		
		ПлатежныйДокумент.ВидРасчетов = ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг");
		ПлатежныйДокумент.СуммаДокумента = Сумма;
		
	Иначе
		Для Каждого СтрокаОснования Из ТаблицаДляЗаполнения Цикл
			
			Если ЭтоИзменение Тогда
				Если СтрокаОснования.ИзменениеАванса > 0 Тогда
					Сумма = СтрокаОснования.ИзменениеАванса;
				Иначе
					Продолжить;
				КонецЕсли;
			Иначе
				Сумма = СтрокаОснования.СуммаАванса;
			КонецЕсли;
			
			Если Сумма <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрРасшифровка = ПлатежныйДокумент.РасшифровкаПлатежа.Добавить();
			
			Если СписокИсточниковСредствПоКФО <> Неопределено Тогда
				ИсточникиСредствПоКФО = СписокИсточниковСредствПоКФО.НайтиСтроки(Новый Структура("КФО", СтрокаОснования.КФО));
				Если ИсточникиСредствПоКФО.Количество() > 0 Тогда
					СтрРасшифровка.КФО = СтрокаОснования.КФО;
					Если ИсточникиСредствПоКФО.Количество() = 1 И ИсточникиСредствПоКФО[0].СписокИсточников.Количество() = 1 Тогда
						СтрРасшифровка.ИсточникСредств = ИсточникиСредствПоКФО[0].СписокИсточников[0].Значение;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			СтрРасшифровка.КБКНазначениеПлатежа = СтрокаОснования.КПС;
			СтрРасшифровка.КОСГУНазначениеПлатежа = СтрокаОснования.КЭК; 
			СтрРасшифровка.КодЦели = СтрокаОснования.КодЦели; 
			СтрРасшифровка.КодМероприятия = СтрокаОснования.КодМероприятия;
			СтрРасшифровка.ДопКлассификация = СтрокаОснования.ДопКлассификация;
			
			СтрРасшифровка.ВидРасчетов = ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг");
			
			Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
				СтрРасшифровка.Сумма = Сумма;
				СтрРасшифровка.СуммаВал = Сумма;
			Иначе
				СтрРасшифровка.Сумма = Сумма;
			КонецЕсли;
		КонецЦикла;
		
		ПлатежныйДокумент.СуммаДокумента = ПлатежныйДокумент.РасшифровкаПлатежа.Итог("Сумма");
		Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
			ПлатежныйДокумент.СуммаДокументаВВалюте = ПлатежныйДокумент.РасшифровкаПлатежа.Итог("СуммаВал");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет расчетно-платежный документ на основании документа "Решение о компенсации расходов (Крайний Север)".
// Вызывается из события ОбработкаЗаполнения расчетно-платежного документа
//
// Параметры:
//	ПлатежныйДокумент - ДокументОбъект, заполняемый расчетно-платежный документ
//	ДанныеЗаполнения - ДокументСсылка.РешениеОКомпенсацииРасходовДляКрайнегоСевера, ссылка на основание
//	Отмена - Булево, признак отказа от стандартной обработки заполнения.
//			Соответствует параметру СтандартнаяОбработка в событии ОбработкаЗаполнения
//
Процедура ЗаполнитьПлатежныйДокументНаОснованииРешенияОКомпенсации(ПлатежныйДокумент, ДанныеЗаполнения, Отмена) Экспорт
	
	ПлатежныйДокумент.ДокументОснование = ДанныеЗаполнения;
	
	ПлатежныйДокумент.Организация = ДанныеЗаполнения.Организация;
	ПлатежныйДокумент.ИФО = ДанныеЗаполнения.ИФО;
	ПлатежныйДокумент.Подразделение = ДанныеЗаполнения.Подразделение;
	ПлатежныйДокумент.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.Сотрудник, "Контрагент");
	ПлатежныйДокумент.Договор = ДанныеЗаполнения.ОснованиеПринятияОбязательства;
	
	ИмяТаблицы = ОбщегоНазначения.ИмяТаблицыПоСсылке(ПлатежныйДокумент.Ссылка);
	ПлатежныйДокумент.СчетКонтрагента = Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(ПлатежныйДокумент.Контрагент, ИмяТаблицы);
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход"
		ИЛИ ИмяТаблицы = "Документ.ПлатежноеПоручение" Тогда
		Документы.ЗаявкаНаКассовыйРасход.ЗаполнитьРеквизитыПолучателя(ПлатежныйДокумент);
	ИначеЕсли ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
		Документы.ЗаявкаНаКассовыйРасходСокращенная.ЗаполнитьРеквизитыПолучателя(ПлатежныйДокумент);
	ИначеЕсли ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
		ПлатежныйДокумент.ПолучательПлатежа = ПлатежныйДокумент.Контрагент;
	КонецЕсли;
	
	ПлатежныйДокумент.КорСчет = БухгалтерскийУчет.СчетПоКоду("208.00", ТекущаяДатаСеанса(), ПлатежныйДокумент.Организация);
	
	СправочникЛицевойСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.РазделЛицевогоСчета, "Владелец");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыЛицевыхСчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	|ГДЕ
	|	РеквизитыЛицевыхСчетов.Владелец = &Владелец
	|	И НЕ РеквизитыЛицевыхСчетов.ПометкаУдаления
	|	И РеквизитыЛицевыхСчетов.Владелец.ДатаОткрытия <= &Дата
	|	И (РеквизитыЛицевыхСчетов.Владелец.ДатаЗакрытия > &Дата
	|			ИЛИ РеквизитыЛицевыхСчетов.Владелец.ДатаЗакрытия = &ПустаяДата)";
	Запрос.УстановитьПараметр("Владелец", СправочникЛицевойСчет);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		ПлатежныйДокумент.ЛицевойСчет = СправочникЛицевойСчет;
		
		Если ИмяТаблицы = "Документ.ПлатежноеПоручение" Тогда
			ПлатежныйДокумент.РеквизитыЛицевогоСчета = Выборка.Ссылка;
			РеквизитыПлательщика = Новый Структура("ИННПлательщика, КПППлательщика, ПлательщикНаименование, ПлательщикБанковскийСчет, ПлательщикНаименованиеБанка, ПлательщикБИКБанка, ПлательщикКорСчетБанка", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ПлатежныйДокумент.ЛицевойСчет, ПлатежныйДокумент.РеквизитыЛицевогоСчета, РеквизитыПлательщика);
			ЗаполнитьЗначенияСвойств(ПлатежныйДокумент, РеквизитыПлательщика);
		ИначеЕсли ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход"
			ИЛИ ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
			ПлатежныйДокумент.РеквизитыЛицевогоСчета = Выборка.Ссылка;
			ПлатежныйДокумент.ОрганКазначейства = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежныйДокумент.РеквизитыЛицевогоСчета, "КассовыйОрган");
			СвойстваЛицевогоСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(ПлатежныйДокумент.ЛицевойСчет, ПлатежныйДокумент.Дата);
			ЗаполнитьЗначенияСвойств(ПлатежныйДокумент, СвойстваЛицевогоСчета);
		КонецЕсли;
		
		СписокДопустимыхКФО = Новый СписокЗначений;
		
		ТипСписокЗначений = Новый ОписаниеТипов("СписокЗначений");
		СписокИсточниковСредствПоКФО = Новый ТаблицаЗначений;
		СписокИсточниковСредствПоКФО.Колонки.Добавить("КФО");
		СписокИсточниковСредствПоКФО.Колонки.Добавить("СписокИсточников", ТипСписокЗначений);
		
		ПлатежноРасчетныеДокументы.ЗаполнитьДопустимыеКФОиИсточникиСредств(ПлатежныйДокумент.ЛицевойСчет, СписокДопустимыхКФО, СписокИсточниковСредствПоКФО);
		
	Иначе
		ТекстСообщения = НСтр("ru='Не удалось автоматически определить реквизиты лицевого счета.
		|Будет выбрано значение лицевого счета по-умолчанию.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ПлатежныйДокумент, "ЛицевойСчет");
	КонецЕсли;
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
		ПлатежныйДокумент.ВалютаДокумента = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ПлатежныйДокумент.ВалютаДокумента, ПлатежныйДокумент.Дата);
		ПлатежныйДокумент.Курс = КурсКратность.Курс;
		ПлатежныйДокумент.Кратность = КурсКратность.Кратность;
	КонецЕсли;
	
	ТаблицаДляЗаполнения = ДанныеЗаполнения.ФинансовоеОбеспечение.Выгрузить();
	ТаблицаДляЗаполнения.Свернуть("КФО, КПС, КЭК", "Сумма");
	ТаблицаДляЗаполнения.Сортировать("КФО, КПС, КЭК");
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
		
		Если ТаблицаДляЗаполнения.Количество() > 1 Тогда
			ТекстИсключения = НСтр("ru='Заявка на кассовый расход (сокращенная) не может быть введена на основании решения с различными кодами бюджетной классификации.'");
			ВызватьИсключение ТекстИсключения;
		ИначеЕсли ТаблицаДляЗаполнения.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		СтрокаОснования = ТаблицаДляЗаполнения[0];
		
		Если СписокИсточниковСредствПоКФО <> Неопределено Тогда
			ИсточникиСредствПоКФО = СписокИсточниковСредствПоКФО.НайтиСтроки(Новый Структура("КФО", СтрокаОснования.КФО));
			Если ИсточникиСредствПоКФО.Количество() > 0 Тогда
				ПлатежныйДокумент.КФО = СтрокаОснования.КФО;
				Если ИсточникиСредствПоКФО.Количество() = 1 И ИсточникиСредствПоКФО[0].СписокИсточников.Количество() = 1 Тогда
					ПлатежныйДокумент.ИсточникСредств = ИсточникиСредствПоКФО[0].СписокИсточников[0].Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ПлатежныйДокумент.КБКНазначениеПлатежа = СтрокаОснования.КПС;
		ПлатежныйДокумент.КОСГУНазначениеПлатежа = СтрокаОснования.КЭК;
		ПлатежныйДокумент.ВидРасчетов = ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг");
		ПлатежныйДокумент.СуммаДокумента = СтрокаОснования.Сумма;
		
	Иначе
		Для Каждого СтрокаОснования Из ТаблицаДляЗаполнения Цикл
			
			СтрРасшифровка = ПлатежныйДокумент.РасшифровкаПлатежа.Добавить();
			
			Если СписокИсточниковСредствПоКФО <> Неопределено Тогда
				ИсточникиСредствПоКФО = СписокИсточниковСредствПоКФО.НайтиСтроки(Новый Структура("КФО", СтрокаОснования.КФО));
				Если ИсточникиСредствПоКФО.Количество() > 0 Тогда
					СтрРасшифровка.КФО = СтрокаОснования.КФО;
					Если ИсточникиСредствПоКФО.Количество() = 1 И ИсточникиСредствПоКФО[0].СписокИсточников.Количество() = 1 Тогда
						СтрРасшифровка.ИсточникСредств = ИсточникиСредствПоКФО[0].СписокИсточников[0].Значение;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			СтрРасшифровка.КБКНазначениеПлатежа = СтрокаОснования.КПС;
			СтрРасшифровка.КОСГУНазначениеПлатежа = СтрокаОснования.КЭК;
			СтрРасшифровка.ВидРасчетов = ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг");
			
			Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
				СтрРасшифровка.Сумма = СтрокаОснования.Сумма;
				СтрРасшифровка.СуммаВал = СтрокаОснования.Сумма;
			Иначе
				СтрРасшифровка.Сумма = СтрокаОснования.Сумма;
			КонецЕсли;
		КонецЦикла;
		
		ПлатежныйДокумент.СуммаДокумента = ПлатежныйДокумент.РасшифровкаПлатежа.Итог("Сумма");
		Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
			ПлатежныйДокумент.СуммаДокументаВВалюте = ПлатежныйДокумент.РасшифровкаПлатежа.Итог("СуммаВал");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет расчетно-платежный документ на основании документа "Заявка-обоснование закупки товаров, работ, услуг малого объема".
// Вызывается из события ОбработкаЗаполнения расчетно-платежного документа
//
// Параметры:
//	ПлатежныйДокумент - ДокументОбъект, заполняемый расчетно-платежный документ
//	ДанныеЗаполнения - ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъема, ссылка на основание
//	Отмена - Булево, признак отказа от стандартной обработки заполнения.
//			Соответствует параметру СтандартнаяОбработка в событии ОбработкаЗаполнения
//
Процедура ЗаполнитьПлатежныйДокументНаОснованииЗаявкиОбоснования(ПлатежныйДокумент, ДанныеЗаполнения, Отмена) Экспорт
	
	ПлатежныйДокумент.ДокументОснование = ДанныеЗаполнения;
	
	ПлатежныйДокумент.Организация = ДанныеЗаполнения.Организация;
	ПлатежныйДокумент.ИФО = ДанныеЗаполнения.ИФО;
	ПлатежныйДокумент.Подразделение = ДанныеЗаполнения.Подразделение;
	ПлатежныйДокумент.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.ПодотчетноеЛицо, "Контрагент");
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо") Тогда
		ПлатежныйДокумент.Договор = ДанныеЗаполнения.ОснованиеПринятияОбязательства;
	Иначе
		ПлатежныйДокумент.Договор = ДанныеЗаполнения.Договор;
	КонецЕсли;
	
	ИмяТаблицы = ОбщегоНазначения.ИмяТаблицыПоСсылке(ПлатежныйДокумент.Ссылка);
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо")
		И ЗначениеЗаполнено(ДанныеЗаполнения.СчетДляПеречисленияДенежныхСредств) Тогда
		ПлатежныйДокумент.СчетКонтрагента = ДанныеЗаполнения.СчетДляПеречисленияДенежныхСредств;
	Иначе
		ПлатежныйДокумент.СчетКонтрагента = Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(ПлатежныйДокумент.Контрагент, ИмяТаблицы);
	КонецЕсли;
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход"
		ИЛИ ИмяТаблицы = "Документ.ПлатежноеПоручение" Тогда
		Документы.ЗаявкаНаКассовыйРасход.ЗаполнитьРеквизитыПолучателя(ПлатежныйДокумент);
	ИначеЕсли ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
		Документы.ЗаявкаНаКассовыйРасходСокращенная.ЗаполнитьРеквизитыПолучателя(ПлатежныйДокумент);
	ИначеЕсли ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
		ПлатежныйДокумент.ПолучательПлатежа = ПлатежныйДокумент.Контрагент;
	КонецЕсли;
	
	ПлатежныйДокумент.КорСчет = БухгалтерскийУчет.СчетПоКоду("208.00", ТекущаяДатаСеанса(), ПлатежныйДокумент.Организация);
	
	СправочникЛицевойСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.РазделЛицевогоСчета, "Владелец");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыЛицевыхСчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	|ГДЕ
	|	РеквизитыЛицевыхСчетов.Владелец = &Владелец
	|	И НЕ РеквизитыЛицевыхСчетов.ПометкаУдаления
	|	И РеквизитыЛицевыхСчетов.Владелец.ДатаОткрытия <= &Дата
	|	И (РеквизитыЛицевыхСчетов.Владелец.ДатаЗакрытия > &Дата
	|			ИЛИ РеквизитыЛицевыхСчетов.Владелец.ДатаЗакрытия = &ПустаяДата)";
	Запрос.УстановитьПараметр("Владелец", СправочникЛицевойСчет);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		ПлатежныйДокумент.ЛицевойСчет = СправочникЛицевойСчет;
		
		Если ИмяТаблицы = "Документ.ПлатежноеПоручение" Тогда
			ПлатежныйДокумент.РеквизитыЛицевогоСчета = Выборка.Ссылка;
			РеквизитыПлательщика = Новый Структура("ИННПлательщика, КПППлательщика, ПлательщикНаименование, ПлательщикБанковскийСчет, ПлательщикНаименованиеБанка, ПлательщикБИКБанка, ПлательщикКорСчетБанка", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ПлатежныйДокумент.ЛицевойСчет, ПлатежныйДокумент.РеквизитыЛицевогоСчета, РеквизитыПлательщика);
			ЗаполнитьЗначенияСвойств(ПлатежныйДокумент, РеквизитыПлательщика);
		ИначеЕсли ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход"
			ИЛИ ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
			ПлатежныйДокумент.РеквизитыЛицевогоСчета = Выборка.Ссылка;
			ПлатежныйДокумент.ОрганКазначейства = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежныйДокумент.РеквизитыЛицевогоСчета, "КассовыйОрган");
			СвойстваЛицевогоСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(ПлатежныйДокумент.ЛицевойСчет, ПлатежныйДокумент.Дата);
			ЗаполнитьЗначенияСвойств(ПлатежныйДокумент, СвойстваЛицевогоСчета);
		КонецЕсли;
		
		СписокДопустимыхКФО = Новый СписокЗначений;
		
		ТипСписокЗначений = Новый ОписаниеТипов("СписокЗначений");
		СписокИсточниковСредствПоКФО = Новый ТаблицаЗначений;
		СписокИсточниковСредствПоКФО.Колонки.Добавить("КФО");
		СписокИсточниковСредствПоКФО.Колонки.Добавить("СписокИсточников", ТипСписокЗначений);
		
		ПлатежноРасчетныеДокументы.ЗаполнитьДопустимыеКФОиИсточникиСредств(ПлатежныйДокумент.ЛицевойСчет, СписокДопустимыхКФО, СписокИсточниковСредствПоКФО);
		
	Иначе
		ТекстСообщения = НСтр("ru='Не удалось автоматически определить реквизиты лицевого счета.
		|Будет выбрано значение лицевого счета по-умолчанию.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ПлатежныйДокумент, "ЛицевойСчет");
	КонецЕсли;
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
		ПлатежныйДокумент.ВалютаДокумента = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ПлатежныйДокумент.ВалютаДокумента, ПлатежныйДокумент.Дата);
		ПлатежныйДокумент.Курс = КурсКратность.Курс;
		ПлатежныйДокумент.Кратность = КурсКратность.Кратность;
	КонецЕсли;
	
	ТаблицаДляЗаполнения = ДанныеЗаполнения.ТоварыРаботыУслуги.Выгрузить();
	ТаблицаДляЗаполнения.Свернуть("КФО, КПС, КЭК", "Сумма");
	ТаблицаДляЗаполнения.Сортировать("КФО, КПС, КЭК");
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
		
		Если ТаблицаДляЗаполнения.Количество() > 1 Тогда
			ТекстИсключения = НСтр("ru='Заявка на кассовый расход (сокращенная) не может быть введена на основании заявки с различными кодами бюджетной классификации.'");
			ВызватьИсключение ТекстИсключения;
		ИначеЕсли ТаблицаДляЗаполнения.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		СтрокаОснования = ТаблицаДляЗаполнения[0];
		
		Если СписокИсточниковСредствПоКФО <> Неопределено Тогда
			ИсточникиСредствПоКФО = СписокИсточниковСредствПоКФО.НайтиСтроки(Новый Структура("КФО", СтрокаОснования.КФО));
			Если ИсточникиСредствПоКФО.Количество() > 0 Тогда
				ПлатежныйДокумент.КФО = СтрокаОснования.КФО;
				Если ИсточникиСредствПоКФО.Количество() = 1 И ИсточникиСредствПоКФО[0].СписокИсточников.Количество() = 1 Тогда
					ПлатежныйДокумент.ИсточникСредств = ИсточникиСредствПоКФО[0].СписокИсточников[0].Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ПлатежныйДокумент.КБКНазначениеПлатежа = СтрокаОснования.КПС;
		ПлатежныйДокумент.КОСГУНазначениеПлатежа = СтрокаОснования.КЭК;
		ПлатежныйДокумент.ВидРасчетов = ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг");
		ПлатежныйДокумент.СуммаДокумента = СтрокаОснования.Сумма;
		
	Иначе
		Для Каждого СтрокаОснования Из ТаблицаДляЗаполнения Цикл
			
			СтрРасшифровка = ПлатежныйДокумент.РасшифровкаПлатежа.Добавить();
			
			Если СписокИсточниковСредствПоКФО <> Неопределено Тогда
				ИсточникиСредствПоКФО = СписокИсточниковСредствПоКФО.НайтиСтроки(Новый Структура("КФО", СтрокаОснования.КФО));
				Если ИсточникиСредствПоКФО.Количество() > 0 Тогда
					СтрРасшифровка.КФО = СтрокаОснования.КФО;
					Если ИсточникиСредствПоКФО.Количество() = 1 И ИсточникиСредствПоКФО[0].СписокИсточников.Количество() = 1 Тогда
						СтрРасшифровка.ИсточникСредств = ИсточникиСредствПоКФО[0].СписокИсточников[0].Значение;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			СтрРасшифровка.КБКНазначениеПлатежа = СтрокаОснования.КПС;
			СтрРасшифровка.КОСГУНазначениеПлатежа = СтрокаОснования.КЭК;
			СтрРасшифровка.ВидРасчетов = ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг");
			
			Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
				СтрРасшифровка.Сумма = СтрокаОснования.Сумма;
				СтрРасшифровка.СуммаВал = СтрокаОснования.Сумма;
			Иначе
				СтрРасшифровка.Сумма = СтрокаОснования.Сумма;
			КонецЕсли;
		КонецЦикла;
		
		ПлатежныйДокумент.СуммаДокумента = ПлатежныйДокумент.РасшифровкаПлатежа.Итог("Сумма");
		Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
			ПлатежныйДокумент.СуммаДокументаВВалюте = ПлатежныйДокумент.РасшифровкаПлатежа.Итог("СуммаВал");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет расчетно-платежный документ на основании документа "Отчет о расходах подотчетного лица".
// Вызывается из события ОбработкаЗаполнения расчетно-платежного документа
//
// Параметры:
//	ПлатежныйДокумент - ДокументОбъект, заполняемый расчетно-платежный документ
//	ДокументОснование - ДокументСсылка.ОтчетОРасходахПодотчетногоЛица, ссылка на основание
//
Процедура ЗаполнитьНаОснованииОтчетаОРасходахПодотчетногоЛица(ПлатежныйДокумент, ДокументОснование) Экспорт
	
	ПлатежныйДокумент.ДокументОснование = ДокументОснование;
	ПлатежныйДокумент.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "Сотрудник.Контрагент");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Счет208", БухгалтерскийУчет.СписокСчетов("208.00"));
	Запрос.УстановитьПараметр("Организация", ДокументОснование.Организация);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("Субконто1", ПлатежныйДокумент.Контрагент);
	Запрос.УстановитьПараметр("ОтчетОРасходахПодотчетногоЛица", ДокументОснование);
	Запрос.УстановитьПараметр("ДокументыАвансов", ДокументОснование.Получено.ВыгрузитьКолонку("ДокументАванса"));
	Запрос.УстановитьПараметр("Счет105", БухгалтерскийУчет.СписокСчетов("105.00", ДокументОснование.Дата));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.ПриходныйДокумент КАК ДокументРасхода
	|ПОМЕСТИТЬ ДокументыРасходов
	|ИЗ
	|	Документ.ОтчетОРасходахПодотчетногоЛица.ТоварыРаботыУслуги КАК ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги
	|ГДЕ
	|	ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.Ссылка = &ОтчетОРасходахПодотчетногоЛица
	|	И ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.ПоДокументу
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОтчетОРасходахПодотчетногоЛица.Ссылка
	|ИЗ
	|	Документ.ОтчетОРасходахПодотчетногоЛица КАК ОтчетОРасходахПодотчетногоЛица
	|ГДЕ
	|	ОтчетОРасходахПодотчетногоЛица.Ссылка = &ОтчетОРасходахПодотчетногоЛица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОбороты.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОбороты.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,
	|	ЕСТЬNULL(Валюты.Ссылка, &ВалютаРегламентированногоУчета) КАК Валюта,
	|	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыАвансов)
	|			ТОГДА ВЫБОР
	|					КОГДА Валюты.Ссылка ЕСТЬ NULL
	|						ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотДт - ЖурналПроводокЕПСБУОбороты.СуммаОборотКт
	|					ИНАЧЕ ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотДт - ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотКт
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Получено,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В
	|				(ВЫБРАТЬ
	|					Т.ДокументРасхода
	|				ИЗ
	|					ДокументыРасходов КАК Т)
	|			ТОГДА ВЫБОР
	|					КОГДА Валюты.Ссылка ЕСТЬ NULL
	|						ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотКт - ЖурналПроводокЕПСБУОбороты.СуммаОборотДт
	|					ИНАЧЕ ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотКт - ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборотДт
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Израсходовано,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Регистратор В
	|					(ВЫБРАТЬ
	|						Т.ДокументРасхода
	|					ИЗ
	|						ДокументыРасходов КАК Т)
	|				И ЖурналПроводокЕПСБУОбороты.КорСчет В (&Счет105)
	|			ТОГДА ЖурналПроводокЕПСБУОбороты.КЭККор
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|	КОНЕЦ КАК КЭКРасходов
	|ПОМЕСТИТЬ ДетальныеДанные
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			Счет В (&Счет208),
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &Субконто1,
	|			,
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ЖурналПроводокЕПСБУОбороты.Валюта = Валюты.Ссылка
	|			И (Валюты.Ссылка <> &ВалютаРегламентированногоУчета)
	|ГДЕ
	|	(ЖурналПроводокЕПСБУОбороты.Регистратор В (&ДокументыАвансов)
	|			ИЛИ ЖурналПроводокЕПСБУОбороты.Регистратор В
	|				(ВЫБРАТЬ
	|					Т.ДокументРасхода
	|				ИЗ
	|					ДокументыРасходов КАК Т))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДетальныеДанные.Счет КАК Счет,
	|	МАКСИМУМ(СоответствияАналитическихСчетовКЭК.КЭК) КАК КЭК
	|ПОМЕСТИТЬ СчетКЭК
	|ИЗ
	|	ДетальныеДанные КАК ДетальныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияАналитическихСчетовКЭК
	|		ПО ДетальныеДанные.Счет = СоответствияАналитическихСчетовКЭК.Счет
	|
	|СГРУППИРОВАТЬ ПО
	|	ДетальныеДанные.Счет
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СоответствияАналитическихСчетовКЭК.КЭК) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДетальныеДанные.Счет КАК Счет,
	|	МАКСИМУМ(ДетальныеДанные.КЭКРасходов) КАК КЭК
	|ПОМЕСТИТЬ СчетКЭК2
	|ИЗ
	|	ДетальныеДанные КАК ДетальныеДанные
	|ГДЕ
	|	ДетальныеДанные.КЭКРасходов <> ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДетальныеДанные.Счет
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДетальныеДанные.КЭКРасходов) = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ОтчетОРасходахПодотчетногоЛица КАК ДокументОснование,
	|	ДетальныеДанные.Счет КАК КорСчет,
	|	ДетальныеДанные.КПС КАК КПС,
	|	ДетальныеДанные.КФО КАК КФО,
	|	ДетальныеДанные.Валюта КАК ВалютаДокумента,
	|	ДетальныеДанные.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА СУММА(ДетальныеДанные.Получено) - СУММА(ДетальныеДанные.Израсходовано) < 0
	|			ТОГДА -СУММА(ДетальныеДанные.Получено) + СУММА(ДетальныеДанные.Израсходовано)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Сумма,
	|	ОтчетОРасходахПодотчетногоЛица.Организация КАК Организация,
	|	ОтчетОРасходахПодотчетногоЛица.ИФО КАК ИФО,
	|	ОтчетОРасходахПодотчетногоЛица.Подразделение КАК Подразделение,
	|	ОтчетОРасходахПодотчетногоЛица.РазделЛицевогоСчета.Владелец КАК ЛицевойСчет,
	|	ОтчетОРасходахПодотчетногоЛица.РазделЛицевогоСчета КАК РазделЛицевогоСчета,
	|	ОтчетОРасходахПодотчетногоЛица.ОснованиеПринятияОбязательства КАК Договор,
	|	ВЫБОР
	|		КОГДА НЕ СчетКЭК2.КЭК ЕСТЬ NULL
	|			ТОГДА СчетКЭК2.КЭК
	|		КОГДА НЕ СчетКЭК.КЭК ЕСТЬ NULL
	|			ТОГДА СчетКЭК.КЭК
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|	КОНЕЦ КАК КЭК
	|ИЗ
	|	ДетальныеДанные КАК ДетальныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетКЭК КАК СчетКЭК
	|		ПО ДетальныеДанные.Счет = СчетКЭК.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетКЭК2 КАК СчетКЭК2
	|		ПО ДетальныеДанные.Счет = СчетКЭК2.Счет,
	|	Документ.ОтчетОРасходахПодотчетногоЛица КАК ОтчетОРасходахПодотчетногоЛица
	|ГДЕ
	|	ОтчетОРасходахПодотчетногоЛица.Ссылка = &ОтчетОРасходахПодотчетногоЛица
	|
	|СГРУППИРОВАТЬ ПО
	|	ДетальныеДанные.Счет,
	|	ДетальныеДанные.КПС,
	|	ДетальныеДанные.КФО,
	|	ДетальныеДанные.Валюта,
	|	ДетальныеДанные.Контрагент,
	|	ОтчетОРасходахПодотчетногоЛица.Организация,
	|	ОтчетОРасходахПодотчетногоЛица.ИФО,
	|	ОтчетОРасходахПодотчетногоЛица.Подразделение,
	|	ОтчетОРасходахПодотчетногоЛица.РазделЛицевогоСчета.Владелец,
	|	ОтчетОРасходахПодотчетногоЛица.РазделЛицевогоСчета,
	|	ОтчетОРасходахПодотчетногоЛица.ОснованиеПринятияОбязательства,
	|	СчетКЭК2.КЭК,
	|	СчетКЭК.КЭК
	|
	|ИМЕЮЩИЕ
	|	СУММА(ДетальныеДанные.Получено) - СУММА(ДетальныеДанные.Израсходовано) < 0
	|ИТОГИ
	|	МАКСИМУМ(Контрагент),
	|	СУММА(Сумма),
	|	МАКСИМУМ(Организация),
	|	МАКСИМУМ(ИФО),
	|	МАКСИМУМ(Подразделение),
	|	МАКСИМУМ(ЛицевойСчет),
	|	МАКСИМУМ(РазделЛицевогоСчета),
	|	МАКСИМУМ(Договор)
	|ПО
	|	ВалютаДокумента";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(ПлатежныйДокумент, Выборка); 

	ПлатежныйДокумент.КорСчет = БухгалтерскийУчет.СчетПоКоду("208.00", ТекущаяДатаСеанса());
	
	ИмяТаблицы = ОбщегоНазначения.ИмяТаблицыПоСсылке(ПлатежныйДокумент.Ссылка);
	ПлатежныйДокумент.СчетКонтрагента = Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(ПлатежныйДокумент.Контрагент, ИмяТаблицы);
	
	Если ЗначениеЗаполнено(ПлатежныйДокумент.ЛицевойСчет) Тогда
		ЗапросЛС = Новый Запрос("
		|ВЫБРАТЬ
		|	РеквизитыЛицевыхСчетов.Ссылка КАК Ссылка,
		|	РеквизитыЛицевыхСчетов.КассовыйОрган КАК КассовыйОрган
		|ИЗ
		|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
		|ГДЕ
		|	РеквизитыЛицевыхСчетов.Владелец = &Владелец
		|	И НЕ РеквизитыЛицевыхСчетов.ПометкаУдаления
		|	И РеквизитыЛицевыхСчетов.Владелец.ДатаОткрытия <= &Дата
		|	И (РеквизитыЛицевыхСчетов.Владелец.ДатаЗакрытия > &Дата
		|			ИЛИ РеквизитыЛицевыхСчетов.Владелец.ДатаЗакрытия = &ПустаяДата)");
		
		ЗапросЛС.УстановитьПараметр("Владелец", ПлатежныйДокумент.ЛицевойСчет);
		ЗапросЛС.УстановитьПараметр("Дата", ТекущаяДата());
		ЗапросЛС.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
		ВыборкаЛС = ЗапросЛС.Выполнить().Выбрать();
		
		Если ВыборкаЛС.Следующий() Тогда 
			Если ИмяТаблицы = "Документ.ПлатежноеПоручение" Тогда
				ПлатежныйДокумент.РеквизитыЛицевогоСчета = ВыборкаЛС.Ссылка;
				РеквизитыПлательщика = Новый Структура("ИННПлательщика, КПППлательщика, ПлательщикНаименование, ПлательщикБанковскийСчет, ПлательщикНаименованиеБанка, ПлательщикБИКБанка, ПлательщикКорСчетБанка", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
				ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ПлатежныйДокумент.ЛицевойСчет, ПлатежныйДокумент.РеквизитыЛицевогоСчета, РеквизитыПлательщика);
				ЗаполнитьЗначенияСвойств(ПлатежныйДокумент, РеквизитыПлательщика);
			ИначеЕсли ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход"
				ИЛИ ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
				ПлатежныйДокумент.РеквизитыЛицевогоСчета = ВыборкаЛС.Ссылка;
				ПлатежныйДокумент.ОрганКазначейства = ВыборкаЛС.КассовыйОрган;
				СвойстваЛицевогоСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(ПлатежныйДокумент.ЛицевойСчет, ПлатежныйДокумент.Дата);
				ЗаполнитьЗначенияСвойств(ПлатежныйДокумент, СвойстваЛицевогоСчета);
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
		
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход"
		ИЛИ ИмяТаблицы = "Документ.ПлатежноеПоручение" Тогда
		Документы.ЗаявкаНаКассовыйРасход.ЗаполнитьРеквизитыПолучателя(ПлатежныйДокумент);
	ИначеЕсли ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда
		Документы.ЗаявкаНаКассовыйРасходСокращенная.ЗаполнитьРеквизитыПолучателя(ПлатежныйДокумент);
	ИначеЕсли ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
		ПлатежныйДокумент.ПолучательПлатежа = ПлатежныйДокумент.Контрагент;
	КонецЕсли; 
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
		ПлатежныйДокумент.ВалютаДокумента = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ПлатежныйДокумент.ВалютаДокумента, ПлатежныйДокумент.Дата);
		ПлатежныйДокумент.Курс = КурсКратность.Курс;
		ПлатежныйДокумент.Кратность = КурсКратность.Кратность;
	КонецЕсли;
	
	ВыборкаРасшифровка = Выборка.Выбрать();
	
	Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасходСокращенная" Тогда  
		
		ТаблицаДляЗаполнения = Новый ТаблицаЗначений;
		ТаблицаДляЗаполнения.Колонки.Добавить("КФО");
		ТаблицаДляЗаполнения.Колонки.Добавить("КПС");
		ТаблицаДляЗаполнения.Колонки.Добавить("КЭК");
		ТаблицаДляЗаполнения.Колонки.Добавить("Сумма");
		
		Пока ВыборкаРасшифровка.Следующий() Цикл
			СтрРасшифровка = ТаблицаДляЗаполнения.Добавить(); 
			ЗаполнитьЗначенияСвойств(СтрРасшифровка, ВыборкаРасшифровка);
        КонецЦикла;
		ТаблицаДляЗаполнения.Свернуть("КФО, КПС, КЭК", "Сумма");

		Если ТаблицаДляЗаполнения.Количество() > 1 Тогда
			ТекстИсключения = НСтр("ru='Заявка на кассовый расход (сокращенная) не может быть введена на основании отчета с различными кодами бюджетной классификации.'");
			ВызватьИсключение ТекстИсключения;
		ИначеЕсли ТаблицаДляЗаполнения.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		СтрокаОснования = ТаблицаДляЗаполнения[0]; 
		
		ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(ПлатежныйДокумент.ЛицевойСчет, СтрокаОснования.КФО);
		Если ДопустимыеИсточникиСредств.Количество() = 1 Тогда
			ПлатежныйДокумент.ИсточникСредств = ДопустимыеИсточникиСредств[0];
		КонецЕсли;

		ПлатежныйДокумент.КБКНазначениеПлатежа = СтрокаОснования.КПС;
		ПлатежныйДокумент.КОСГУНазначениеПлатежа = СтрокаОснования.КЭК;
		ПлатежныйДокумент.ВидРасчетов = ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг");
		ПлатежныйДокумент.СуммаДокумента = СтрокаОснования.Сумма;
		
	Иначе
		
		РасшифровкаПлатежа = ПлатежныйДокумент.РасшифровкаПлатежа;
		РасшифровкаПлатежа.Очистить();
		
		Пока ВыборкаРасшифровка.Следующий() Цикл
			
			СтрРасшифровка = РасшифровкаПлатежа.Добавить();
			СтрРасшифровка.КФО = ВыборкаРасшифровка.КФО;
			СтрРасшифровка.КБКНазначениеПлатежа = ВыборкаРасшифровка.КПС;
			СтрРасшифровка.КОСГУНазначениеПлатежа = ВыборкаРасшифровка.КЭК;
			Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
				СтрРасшифровка.СуммаВал = ВыборкаРасшифровка.Сумма;
				СтрРасшифровка.Сумма = ВыборкаРасшифровка.Сумма * ПлатежныйДокумент.Курс / ?(ПлатежныйДокумент.Кратность = 0, 1, ПлатежныйДокумент.Кратность);
			Иначе
				СтрРасшифровка.Сумма = ВыборкаРасшифровка.Сумма;
			КонецЕсли;
			СтрРасшифровка.ВидРасчетов = ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг");
			
			ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(ПлатежныйДокумент.ЛицевойСчет, СтрРасшифровка.КФО);
			Если ДопустимыеИсточникиСредств.Количество() = 1 Тогда
				СтрРасшифровка.ИсточникСредств = ДопустимыеИсточникиСредств[0];
			КонецЕсли;
			
		КонецЦикла;
		
		Если ИмяТаблицы = "Документ.ЗаявкаНаКассовыйРасход" ИЛИ ИмяТаблицы = "Документ.КассовоеВыбытие" Тогда
			ПлатежныйДокумент.СуммаДокументаВВалюте = РасшифровкаПлатежа.Итог("СуммаВал");
		КонецЕсли; 
		ПлатежныйДокумент.СуммаДокумента = РасшифровкаПлатежа.Итог("Сумма"); 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПредельнуюДатуИсполненияЗаявки(ПредельнаяДатаИсполнения, ДатаДок, ЛицевойСчет, СвойстваЛицевогоСчета) Экспорт
	
	Если ЗначениеЗаполнено(ЛицевойСчет) 
		И ЗначениеЗаполнено(ДатаДок)
		И ТипЗнч(СвойстваЛицевогоСчета) = Тип("Структура")
		И СвойстваЛицевогоСчета.Свойство("НеЗаполнятьПредельнуюДатуИсполнения") тогда
		
		Если НЕ СвойстваЛицевогоСчета.НеЗаполнятьПредельнуюДатуИсполнения Тогда
			ПредельнаяДатаИсполнения = КонецДня(ДатаДок) + СвойстваЛицевогоСчета.ПредельныйСрокИсполненияЗаявок;
			
			ОсновнойКалендарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
			Если НЕ ОсновнойКалендарь = Неопределено Тогда
				НоваяДата = ПредельнаяДатаИсполнения; 
				НачальныеДаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПредельнаяДатаИсполнения);
				БлижайшиеДаты = КалендарныеГрафики.БлижайшиеРабочиеДаты(ОсновнойКалендарь, НачальныеДаты);
				БлижайшийРабочийДень = БлижайшиеДаты.Получить(НоваяДата);
				Если НЕ БлижайшийРабочийДень = Неопределено Тогда
					ПредельнаяДатаИсполнения = БлижайшийРабочийДень;
				КонецЕсли;	
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры	

////////////////////////////////////////////////////////////////////
//			Процедуры справочника "Шаблоны "Назначения платежа"
//  
Процедура ИнициализироватьДоступныеПоля(ОбъектМетаданных,ДоступныеПоля,ТипОбъектаМетаданных = Неопределено, Знач МаксУровеньДобавляемыхРеквизитов = Неопределено) экспорт
	
	Если ТипОбъектаМетаданных = Неопределено Тогда
		ТипОбъектаМетаданных = "Документ";
	КонецЕсли;
	
	Если МаксУровеньДобавляемыхРеквизитов = Неопределено Тогда 
		МаксУровеньДобавляемыхРеквизитов = 1;	
	КонецЕсли;
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.ТипИсточникаДанных = "Local";
	ИсточникДанных.Имя = "ЭтаИБ";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
	НаборДанных.ИсточникДанных  = ИсточникДанных.Имя;
	НаборДанных.Имя = "РеквизитыДокумента";
	НаборДанных.Запрос = " ВЫБРАТЬ
						   |	ВыбДокумент.*
						   |ИЗ
						   |	" + ТипОбъектаМетаданных + "." + ОбъектМетаданных + " КАК ВыбДокумент";
											   
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки,);
	
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(ИсточникНастроек);
	
	ИсточникЗначения = Компоновщик.Настройки.ДоступныеПоляВыбора.Элементы;
	
	ДобавитьПодчиненныеУзел(ДоступныеПоля,ИсточникЗначения,0,МаксУровеньДобавляемыхРеквизитов);
	
	
КонецПроцедуры 

#Область ВзаимодействиеСЕБП    

Процедура ЗаполнитьПризнакНазначенияПлатежаВСпискеОснований(РеквизитыДокументаОснования) Экспорт   
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВидыДокументовОснованийЕБП.Ссылка КАК Ссылка,
	|	ВидыДокументовОснованийЕБП.НазначениеПлатежа КАК НазначениеПлатежа
	|ИЗ
	|	Справочник.ВидыДокументовОснованийЕБП КАК ВидыДокументовОснованийЕБП
	|ГДЕ
	|	ВидыДокументовОснованийЕБП.Ссылка В(&Ссылка)");   
	
	Если ТипЗнч(РеквизитыДокументаОснования) = Тип("ТаблицаЗначений") Тогда
		СписокВидов = РеквизитыДокументаОснования.ВыгрузитьКолонку("ДокументОснованиеВид");
	Иначе 
		СписокВидов = РеквизитыДокументаОснования.Выгрузить(, "ДокументОснованиеВид").ВыгрузитьКолонку("ДокументОснованиеВид");
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("Ссылка", СписокВидов); 
	ТабПризнаков = Запрос.Выполнить().Выбрать(); 
	Пока ТабПризнаков.Следующий() Цикл
		ВыбранныеСтроки =РеквизитыДокументаОснования.НайтиСтроки(Новый Структура("ДокументОснованиеВид", ТабПризнаков.Ссылка));	
		Для Каждого Строка Из ВыбранныеСтроки Цикл
			Строка.НазначениеПлатежа = ТабПризнаков.НазначениеПлатежа;
		КонецЦикла;
	КонецЦикла; 
	
КонецПроцедуры	

Функция РазделЛСПоКодуПоступленияИлиКФО(ЛицевойСчет, Знач ДатаПоиска = Неопределено, Знач КодПоступления = Неопределено, КФО = Неопределено) Экспорт  
	
	РазделЛС = ПредопределенноеЗначение("Справочник.РазделыЛицевыхСчетов.ПустаяСсылка");
	Если ДатаПоиска = Неопределено Тогда
		ДатаПоиска = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ЛицевойСчет) Тогда 
		Если КодПоступления = Неопределено Тогда  
			КодПоступления = ПлатежноРасчетныеДокументыКлиентСервер.КодПоступленияЕБППоКФО(КФО, ДатаПоиска);
		КонецЕсли;
		Если ЗначениеЗаполнено(КодПоступления) Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	РазделыЛицевыхСчетов.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
			|ГДЕ
			|	РазделыЛицевыхСчетов.Владелец = &Владелец
			|	И РазделыЛицевыхСчетов.КодПоступленияЕБП = &КодПоступленияЕБП");
			Запрос.УстановитьПараметр("Владелец", ЛицевойСчет);
			Запрос.УстановитьПараметр("КодПоступленияЕБП", КодПоступления);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				РазделЛС = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат РазделЛС;
	
КонецФункции

Процедура УстановитьСтатусРСКП(СсылкаДокумента, Статус) Экспорт   
	
	НаборЗаписей = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПлатежноРасчетныйДокумент.Установить(СсылкаДокумента);
	НаборЗаписей.Прочитать(); 
	Если НаборЗаписей.Количество() =0 Тогда
		Запись = НаборЗаписей.Добавить();
	Иначе
		Запись = НаборЗаписей[0];
	КонецЕсли;
	Запись.ПлатежноРасчетныйДокумент = СсылкаДокумента;
	Запись.Статус = Статус;
	НаборЗаписей.Записать();
	
КонецПроцедуры	

Функция ЗначенияЕБПСтатусаАннулирован() Экспорт
	
	МассивЗначений = Новый Массив;
	МассивЗначений.Добавить("Отказан ТОФК");
	МассивЗначений.Добавить("Отказан в исполнении");
	МассивЗначений.Добавить("Отозван");
	МассивЗначений.Добавить("Удален");
	МассивЗначений.Добавить("Отменен");
	МассивЗначений.Добавить("FK_REJECTED");
	
	Возврат МассивЗначений;
	
КонецФункции

Функция СтатусДокументаЕБП(ТекстСтатуса) Экспорт 
	
	МассивСтатусовАннулирован = ЗначенияЕБПСтатусаАннулирован();
	
	Если МассивСтатусовАннулирован.Найти(ТекстСтатуса) <> Неопределено Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Аннулирован");
	ИначеЕсли ТекстСтатуса = "Исполнен" ИЛИ ТекстСтатуса = "EXECUTED" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен");
	ИначеЕсли ТекстСтатуса = "Исполнен частично" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.ИсполненЧастично");
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура ТекстЗапросаКФОПоКодуПоступленияЕБП(ТекстЗапроса, ПолеКодПоступления, Псевдоним = "КФО") Экспорт  
	
    ТекстЗапроса = ТекстЗапроса + "
	|	ВЫБОР " + ПолеКодПоступления + "
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.КодыПоступленийЕБП.ГЗ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.КВД.СубсидииНаГосзадание)
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.КодыПоступленийЕБП.ЦС)
