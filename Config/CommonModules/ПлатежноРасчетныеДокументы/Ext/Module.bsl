	|	ВЫБОР
	|		КОГДА ЗаявкаНаВозврат.КБКНазначениеПлатежа.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.АУИБУ)
	|			ТОГДА ПОДСТРОКА(ЗаявкаНаВозврат.КБКНазначениеПлатежа.Код, 5, 10)
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК АналитическийКод,
	|	ЗаявкаНаВозврат.КодЦели.Код КАК КодЦелиПлательщика,   
	|	ЗаявкаНаВозврат.КодЦелиПолучателя.Код КАК КодЦелиПолучателя,
	|	ПРЕДСТАВЛЕНИЕ(ЗаявкаНаВозврат.НаправлениеРасходованияВР) КАК НаправлениеРасходованияВР,
	|	ЗаявкаНаВозврат.КодМероприятия КАК КодМероприятия,
	|	ЗаявкаНаВозврат.ДопКлассификация КАК ДопКлассификация,
	|	ЗаявкаНаВозврат.ИсточникСредств.Наименование КАК ВидСредствДляИсполнения,
	|	ЗаявкаНаВозврат.ИсточникСредств.Код КАК КодВидаСредствДляИсполнения,
	|	ЗаявкаНаВозврат.КодОКАТО КАК ПНКодОКАТО,
	|	ЗаявкаНаВозврат.КодОКАТО КАК КодОКТМО,
	|	ЗаявкаНаВозврат.СуммаДокументаВВалюте КАК СуммаДокументаВВалюте,
	|	ВЫБОР
	|		КОГДА ЗаявкаНаВозврат.ВалютаДокумента ЕСТЬ NULL
	|			ТОГДА ""643""
	|		ИНАЧЕ ЗаявкаНаВозврат.ВалютаДокумента.Код
	|	КОНЕЦ КАК КодОКВ,
	|	ЗаявкаНаВозврат.СуммаДокумента КАК СуммаДокумента,
	|	ЗаявкаНаВозврат.ОчередностьПлатежа КАК ППОчередностьПлатежа,
	|	ЗаявкаНаВозврат.ВидПлатежа КАК ППВидПлатежа,
	|	ЗаявкаНаВозврат.НазначениеПлатежа КАК ППНазначениеПлатежа,
	|	ЗаявкаНаВозврат.ДокументОснованиеВид КАК ДокументОснованиеВид,
	|	ЗаявкаНаВозврат.ДокументОснованиеНомер КАК ДокументОснованиеНомер,
	|	ЗаявкаНаВозврат.ДокументОснованиеДата КАК ДокументОснованиеДата,
	|	ЗаявкаНаВозврат.GUIDРасчетногоДокумента КАК GUIDРасчетногоДокумента,
	|	ЗаявкаНаВозврат.КонтрагентНаименование КАК КонтрагентНаименование,
	|	ЗаявкаНаВозврат.КонтрагентИНН КАК КонтрагентИНН,
	|	ЗаявкаНаВозврат.КонтрагентКПП КАК КонтрагентКПП,
	|	ЗаявкаНаВозврат.КодБКПолучателя КАК КодБКПолучателя,
	|	ЗаявкаНаВозврат.ВидБКПолучателя КАК ВидБКПолучателя,
	|	ЗаявкаНаВозврат.КодОКТМОПолучателя КАК КодОКТМОПолучателя,
	|	ЗаявкаНаВозврат.КонтрагентЛицевойСчет КАК КонтрагентЛицевойСчет,
	|	ЗаявкаНаВозврат.КонтрагентБанковскийСчет КАК КонтрагентБанковскийСчет,
	|	ЗаявкаНаВозврат.КонтрагентНаименованиеБанка КАК КонтрагентНаименованиеБанка,
	|	ЗаявкаНаВозврат.КонтрагентБИКБанка КАК КонтрагентБИКБанка,
	|	ЗаявкаНаВозврат.КонтрагентКорСчетБанка КАК КонтрагентКорСчетБанка,
	|	ФИОПерваяПодпись.Фамилия КАК ПерваяПодписьФамилия,
	|	ФИОПерваяПодпись.Имя КАК ПерваяПодписьИмя,
	|	ФИОПерваяПодпись.Отчество КАК ПерваяПодписьОтчество,
	|	ФИОВтораяПодпись.Фамилия КАК ВтораяПодписьФамилия,
	|	ФИОВтораяПодпись.Имя КАК ВтораяПодписьИмя,
	|	ФИОВтораяПодпись.Отчество КАК ВтораяПодписьОтчество,
	|	ВЫБОР
	|		КОГДА ЗаявкаНаВозврат.ПерваяПодписьПечататьДолжность
	|			ТОГДА ЗаявкаНаВозврат.ПерваяПодписьДолжность
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПерваяПодписьДолжность,
	|	ВЫБОР
	|		КОГДА ЗаявкаНаВозврат.ВтораяПодписьПечататьДолжность
	|			ТОГДА ЗаявкаНаВозврат.ВтораяПодписьДолжность
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ВтораяПодписьДолжность
	|ИЗ
	|	Документ.ЗаявкаНаВозврат КАК ЗаявкаНаВозврат
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПерваяПодписьФИО КАК ФИОПерваяПодпись
	|		ПО ЗаявкаНаВозврат.ПерваяПодпись = ФИОПерваяПодпись.ПерваяПодпись
	|			И ЗаявкаНаВозврат.Дата = ФИОПерваяПодпись.Дата
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтораяПодписьФИО КАК ФИОВтораяПодпись
	|		ПО ЗаявкаНаВозврат.ВтораяПодпись = ФИОВтораяПодпись.ВтораяПодпись
	|			И ЗаявкаНаВозврат.Дата = ФИОВтораяПодпись.Дата
	|ГДЕ
	|	ЗаявкаНаВозврат.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаявкаНаВозвратДокументыОснования.Ссылка КАК Ссылка,
	|	ЗаявкаНаВозвратДокументыОснования.ДокументОснованиеВид КАК ДокументОснованиеВид,
	|	ЗаявкаНаВозвратДокументыОснования.ДокументОснованиеДата КАК ДокументОснованиеДата,
	|	ЗаявкаНаВозвратДокументыОснования.ДокументОснованиеНомер КАК ДокументОснованиеНомер,
	|	ЗаявкаНаВозвратДокументыОснования.ДокументОснованиеСумма КАК ДокументОснованиеСумма,
	|	ЗаявкаНаВозвратДокументыОснования.GUIDРасчетногоДокумента КАК GUIDРасчетногоДокумента
	|ИЗ
	|	Документ.ЗаявкаНаВозврат.ДокументыОснования КАК ЗаявкаНаВозвратДокументыОснования
	|ГДЕ
	|	ЗаявкаНаВозвратДокументыОснования.Ссылка В(&МассивОбъектов)";	
	
	Результат = Запрос.ВыполнитьПакет();
	
	Выборка	  		= Результат[3].Выбрать();
	ДокОснования 	= Результат[4].Выгрузить();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураДанных = Новый Структура();
		Для Каждого Колонка ИЗ Результат[3].Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);	
		КонецЦикла;
		
		// для печати даты в виде "__" ________ 20__ г.
		СтруктураДаты = РазложитьДатуДляПечати(Выборка.ДатаДок);
		СтруктураДанных.Вставить("ЧислоДаты", 			СтруктураДаты.Число);	
		СтруктураДанных.Вставить("МесяцДаты", 			СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", 			СтруктураДаты.Год);
		
		СтруктураДанных.Вставить("КодБК", 				СтруктураДанных.КодГлавыПлательщика + СтруктураДанных.КодКПС + СтруктураДанных.КодАналитикиКПС); 
		
		// реквизиты, требующие преобразования
		СтруктураДанных.Вставить("ПерваяПодписьФИО", 	КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", СтруктураДанных.ПерваяПодписьФамилия, СтруктураДанных.ПерваяПодписьИмя, СтруктураДанных.ПерваяПодписьОтчество), Истина));					
		СтруктураДанных.Вставить("ВтораяПодписьФИО", 	КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", СтруктураДанных.ВтораяПодписьФамилия, СтруктураДанных.ВтораяПодписьИмя, СтруктураДанных.ВтораяПодписьОтчество), Истина));
		СтруктураДанных.Вставить("НомерДок",          	ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Выборка.Ссылка, СтруктураДанных.НомерДок));
		СтруктураДанных.Вставить("НомерЛС", 			СокрЛП(СтруктураДанных.НомерЛС));
		СтруктураДанных.Вставить("Глава", 				СокрЛП(СтруктураДанных.Глава));			
		СтруктураДанных.Вставить("КОФК", 				СокрЛП(СтруктураДанных.КОФК));
		Если СтруктураДанных.КФО = ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение") Тогда
			СтруктураДанных.Вставить("КодЦелиПлательщика", СокрЛП(СтруктураДанных.КодЦелиПлательщика) + Лев(СтруктураДанных.НаправлениеРасходованияВР, 2));
		КонецЕсли;
		
		СтруктураДанных.Вставить("ВыводитьРаздел_2", 		Ложь);
		СтруктураДанных.Вставить("ВыводитьРаздел_2_Таб", 	Ложь);
		
		Если ЗначениеЗаполнено(СтруктураДанных.ДокументОснованиеВид)
			ИЛИ ЗначениеЗаполнено(СтруктураДанных.ДокументОснованиеНомер)
			ИЛИ ЗначениеЗаполнено(СтруктураДанных.ДокументОснованиеДата) Тогда
			СтруктураДанных.Вставить("ВыводитьРаздел_2", 	Истина);
		Иначе
			ДокОсн = ДокОснования.Скопировать(Новый Структура("Ссылка", Выборка.Ссылка));
			Если ДокОсн.Количество() > 0 Тогда
				СтруктураДанных.Вставить("ВыводитьРаздел_2_Таб", 	Истина);
	            СтруктураДанных.Вставить("ДокументыОснования", 	ДокОсн);
			КонецЕсли;	
		КонецЕсли;
		
		МассивСтруктурДанных.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Возврат МассивСтруктурДанных;
	
КонецФункции	

// Возвращает массив структур, содержащих значения реквизитов Запроса на аннулирование заявки для печати или выгрузки
//
Функция ЗначенияРеквизитовЗапросНаАннулированиеЗаявки(МассивОбъектов, ИспользоватьДопКл = Ложь, ИспользоватьКодМероприятия = Ложь, ИспользоватьКЭК = Ложь, ИспользоватьАналитическийКод = Ложь, ИспользоватьКФО = Ложь, ИспользоватьКОСГУПолучателя = Ложь) Экспорт
	
	МассивСтруктурДанных = Новый Массив;
	
	// Значения реквизитов Запроса на аннулирование заявки
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст ="
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗапросНаАннулированиеЗаявки.ПерваяПодпись,
	|	ЗапросНаАннулированиеЗаявки.ВтораяПодпись,
	|	ЗапросНаАннулированиеЗаявки.Дата
	|ПОМЕСТИТЬ ПодписиИДаты
	|ИЗ
	|	Документ.ЗапросНаАннулированиеЗаявки КАК ЗапросНаАннулированиеЗаявки
	|ГДЕ
	|	ЗапросНаАннулированиеЗаявки.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПерваяПодписьФИО.ПерваяПодпись,
	|	ПерваяПодписьФИО.Дата,
	|	ФИОФизическихЛиц.Фамилия,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество
	|ПОМЕСТИТЬ ПерваяПодписьФИО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПодписиИДаты.ПерваяПодпись КАК ПерваяПодпись,
	|		ПодписиИДаты.Дата КАК Дата,
	|		ПодписиИДаты.ПерваяПодпись.Контрагент.ЮридическоеФизическоеЛицо КАК ФизЛицо,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК Период
	|	ИЗ
	|		ПодписиИДаты КАК ПодписиИДаты
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО ПодписиИДаты.ПерваяПодпись.Контрагент.ЮридическоеФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|				И (ФИОФизическихЛиц.Период <= ПодписиИДаты.Дата)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ПодписиИДаты.ПерваяПодпись,
	|		ПодписиИДаты.ПерваяПодпись.Контрагент.ЮридическоеФизическоеЛицо,
	|		ПодписиИДаты.Дата) КАК ПерваяПодписьФИО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО ПерваяПодписьФИО.Период = ФИОФизическихЛиц.Период
	|			И ПерваяПодписьФИО.ФизЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	ПерваяПодписьФИО.ПерваяПодпись,
	|	ПерваяПодписьФИО.Дата,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество,
	|	ФИОФизическихЛиц.Фамилия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтораяПодписьФИО.ВтораяПодпись,
	|	ВтораяПодписьФИО.Дата,
	|	ФИОФизическихЛиц.Фамилия,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество
	|ПОМЕСТИТЬ ВтораяПодписьФИО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПодписиИДаты.ВтораяПодпись КАК ВтораяПодпись,
	|		ПодписиИДаты.Дата КАК Дата,
	|		ПодписиИДаты.ВтораяПодпись.Контрагент.ЮридическоеФизическоеЛицо КАК ФизЛицо,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК Период
	|	ИЗ
	|		ПодписиИДаты КАК ПодписиИДаты
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО ПодписиИДаты.ВтораяПодпись.Контрагент.ЮридическоеФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|				И (ФИОФизическихЛиц.Период <= ПодписиИДаты.Дата)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ПодписиИДаты.ВтораяПодпись,
	|		ПодписиИДаты.ВтораяПодпись.Контрагент.ЮридическоеФизическоеЛицо,
	|		ПодписиИДаты.Дата) КАК ВтораяПодписьФИО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО ВтораяПодписьФИО.Период = ФИОФизическихЛиц.Период
	|			И ВтораяПодписьФИО.ФизЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтораяПодписьФИО.ВтораяПодпись,
	|	ВтораяПодписьФИО.Дата,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество,
	|	ФИОФизическихЛиц.Фамилия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗапросНаАннулированиеЗаявки.Ссылка,
	|	ЗапросНаАннулированиеЗаявки.Номер КАК НомерДок,
	|	ЗапросНаАннулированиеЗаявки.Дата КАК ДатаДок,
	|	ВЫБОР
