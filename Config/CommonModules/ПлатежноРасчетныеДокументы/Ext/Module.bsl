    |УПОРЯДОЧИТЬ ПО
	|	ЗаявкаНаСдачуПолучениеНаличныхРасшифровкаПлатежа.Ссылка
	|";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();

    Выборка           = МассивРезультатов[4].Выбрать();	
	Банкноты          = МассивРезультатов[5].Выгрузить();	
	Монеты            = МассивРезультатов[6].Выгрузить(); 
	
	Источники         = МассивРезультатов[8].Выгрузить();  
	КассовыеСимволы   = МассивРезультатов[9].Выгрузить();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураДанных = Новый Структура("Банкноты, Монеты, Источники, КассовыеСимволы, Подписи", 
		                  Новый ТаблицаЗначений, Новый ТаблицаЗначений, Новый ТаблицаЗначений, Новый ТаблицаЗначений, Новый ТаблицаЗначений);
		
		Для Каждого Колонка ИЗ МассивРезультатов[4].Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
		// для печати даты в виде "__" ________ 20__ г.
		СтруктураДаты = РазложитьДатуДляПечати(Выборка.ДатаДок);
		СтруктураДанных.Вставить("ЧислоДаты", 			СтруктураДаты.Число);
		СтруктураДанных.Вставить("МесяцДаты", 			СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", 			СтруктураДаты.Год);
		
		// реквизиты, требующие преобразования
		СтруктураДанных.Вставить("ПерваяПодписьФИО", 	КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", СтруктураДанных.ПерваяПодписьФамилия, СтруктураДанных.ПерваяПодписьИмя, СтруктураДанных.ПерваяПодписьОтчество), Истина));					
		СтруктураДанных.Вставить("ВтораяПодписьФИО", 	КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", СтруктураДанных.ВтораяПодписьФамилия, СтруктураДанных.ВтораяПодписьИмя, СтруктураДанных.ВтораяПодписьОтчество), Истина));	
		СтруктураДанных.Вставить("ФИОРаботника",        Строка(СтруктураДанных.ПерваяПодписьФамилия) + " " +  Строка(СтруктураДанных.ПерваяПодписьИмя) + " " +  Строка(СтруктураДанных.ПерваяПодписьОтчество)); 
		
		СтруктураДанных.Вставить("НомерДок",          	ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Выборка.Ссылка, СтруктураДанных.НомерДок));	
		СтруктураДанных.Вставить("СуммаЧисломПрописью", ФорматироватьСуммуПлатежногоДокумента(СтруктураДанных.СуммаДокумента)  + " " + ФорматироватьСуммуПрописьюПлатежногоДокумента(СтруктураДанных.СуммаДокумента));

				
		СтруктураДанных.Банкноты        = Банкноты.Скопировать(Новый Структура("Ссылка", Выборка.Ссылка));
		СтруктураДанных.Монеты          = Монеты.Скопировать(Новый Структура("Ссылка", Выборка.Ссылка)); 
        СтруктураДанных.Источники       = Источники.Скопировать(Новый Структура("Ссылка", Выборка.Ссылка));
        СтруктураДанных.КассовыеСимволы = КассовыеСимволы.Скопировать(Новый Структура("Ссылка", Выборка.Ссылка)); 
		
		СтруктураДанных.КассовыеСимволы.Колонки.Вставить(0, "НомерСтроки", Новый ОписаниеТипов("Число"));
		Для Каждого Стр ИЗ СтруктураДанных.КассовыеСимволы Цикл
			Стр.НомерСтроки        = СтруктураДанных.КассовыеСимволы.Индекс(Стр) + 1;
		КонецЦикла;	
		
		СтруктураДанных.Подписи.Колонки.Вставить(0, "НомерСтроки", Новый ОписаниеТипов("Число"));  
		СтруктураДанных.Подписи.Колонки.Вставить(0, "Должность", Новый ОписаниеТипов("Строка")); 
		СтруктураДанных.Подписи.Колонки.Вставить(0, "ФИО", Новый ОписаниеТипов("Строка"));  
		СтруктураДанных.Подписи.Колонки.Вставить(0, "Ссылка");
		
		Стр                    = СтруктураДанных.Подписи.Добавить();
		Стр.НомерСтроки        = 1;    
		Стр.Ссылка             = Выборка.Ссылка;
		Стр.Должность          = СтруктураДанных["ПерваяПодписьДолжность"];	
		Стр.ФИО                = СтруктураДанных["ПерваяПодписьФИО"];   
		
		Стр                    = СтруктураДанных.Подписи.Добавить();
		Стр.НомерСтроки        = 2;    
		Стр.Ссылка             = Выборка.Ссылка;
		Стр.Должность          = СтруктураДанных["ВтораяПодписьДолжность"];	
		Стр.ФИО                = СтруктураДанных["ВтораяПодписьФИО"];
				
		МассивСтруктурДанных.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Возврат МассивСтруктурДанных;
	
КонецФункции

// Возвращает массив структур, содержащих значения реквизитов ЗКР для печати или выгрузки
//
Функция ЗначенияРеквизитовЗаявкаНаКассовыйРасход(МассивОбъектов, ИспользоватьДопКл = Ложь, ИспользоватьКодМероприятия = Ложь, ИспользоватьКЭК = Ложь, ИспользоватьАналитическийКод = Ложь, ИспользоватьКФО = Ложь, ИспользоватьКОСГУПолучателя = Ложь) Экспорт 
	
	МассивСтруктурДанных = Новый Массив;
	
	// Значения реквизитов ЗКР
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТекВалюта.Значение КАК ВалютаРегламентированногоУчета
	|ПОМЕСТИТЬ ВАЛЮТЫ
	|ИЗ
	|	Константа.ВалютаРегламентированногоУчета КАК ТекВалюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаявкаНаКассовыйРасход.ПерваяПодпись КАК ПерваяПодпись,
	|	ЗаявкаНаКассовыйРасход.ВтораяПодпись КАК ВтораяПодпись,
	|	ЗаявкаНаКассовыйРасход.Дата КАК Дата
	|ПОМЕСТИТЬ ПодписиИДаты
	|ИЗ
	|	Документ.ЗаявкаНаКассовыйРасход КАК ЗаявкаНаКассовыйРасход
	|ГДЕ
	|	ЗаявкаНаКассовыйРасход.Ссылка В(&МассивОбъектов)
	|;
	|
