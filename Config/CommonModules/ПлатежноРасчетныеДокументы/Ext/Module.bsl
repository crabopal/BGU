	|			ТОГДА РЕГИСТРАТОРЫ.КодФАИП
	|		ИНАЧЕ СуммыОбязательств.КодФАИП
	|	КОНЕЦ КАК КодФАИП,
	|	ВЫБОР
	|		КОГДА СуммыОбязательств.ИсточникСредств ЕСТЬ NULL
	|				ИЛИ СуммыОбязательств.ИсточникСредств = ЗНАЧЕНИЕ(Справочник.ИсточникиСредств.ПустаяСсылка)
	|			ТОГДА РЕГИСТРАТОРЫ.Ссылка.ИсточникСредств.Код
	|		ИНАЧЕ СуммыОбязательств.ИсточникСредств.Код
	|	КОНЕЦ КАК КодВидаСредств,
	|	ВЫБОР
	|		КОГДА СуммыОбязательств.ИсточникСредств ЕСТЬ NULL
	|				ИЛИ СуммыОбязательств.ИсточникСредств = ЗНАЧЕНИЕ(Справочник.ИсточникиСредств.ПустаяСсылка)
	|			ТОГДА РЕГИСТРАТОРЫ.Ссылка.ИсточникСредств.Наименование
	|		ИНАЧЕ СуммыОбязательств.ИсточникСредств.Наименование
	|	КОНЕЦ КАК ВидСредств,
	|	РЕГИСТРАТОРЫ.ОрганизацияКодПоПППКод + СуммыОбязательств.КПС.Код КАК КодБК,
	|	ВЫБОР
	|		КОГДА СуммыОбязательств.КПС.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КРБ)
	|			ТОГДА ""10""
	|		КОГДА СуммыОбязательств.КПС.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КИФ)
	|				И ПОДСТРОКА(СуммыОбязательств.КПС.Код, 1, 2) = ""02""
	|			ТОГДА ""32""
	|		КОГДА СуммыОбязательств.КПС.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КИФ)
	|				И ПОДСТРОКА(СуммыОбязательств.КПС.Код, 1, 2) = ""01""
	|			ТОГДА ""31""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ВидБК,
	|	ВЫБОР
	|		КОГДА СуммыОбязательств.Валюта ЕСТЬ NULL
	|				ИЛИ СуммыОбязательств.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА ""643""
	|		ИНАЧЕ СуммыОбязательств.Валюта.Код
	|	КОНЕЦ КАК КодВал,
	|	"""" КАК АналитическийКод,
	|	СУММА(СуммыОбязательств.СуммаВал) КАК СуммаВал,
	|	СУММА(СуммыОбязательств.СуммаРуб) КАК СуммаРуб,
	|	СУММА(СуммыОбязательств.СуммаРуб - СуммыОбязательств.УчтеноОбязательств) КАК СуммаАванс
	|ИЗ
	|	РЕГИСТРАТОРЫ КАК РЕГИСТРАТОРЫ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммыОбязательств КАК СуммыОбязательств
	|		ПО РЕГИСТРАТОРЫ.ПодтверждающийДокумент = СуммыОбязательств.ПодтверждающийДокумент
	|
	|СГРУППИРОВАТЬ ПО
	|	РЕГИСТРАТОРЫ.Ссылка,
	|	РЕГИСТРАТОРЫ.СрокИсполнения, 
	|	РЕГИСТРАТОРЫ.УчНомерДОПодтверждение,
	|	РЕГИСТРАТОРЫ.СуммаВозврата,
	|	РЕГИСТРАТОРЫ.ДатаДокументаПодтверждения,
	|	ВЫБОР
	|		КОГДА СуммыОбязательств.КодФАИП ЕСТЬ NULL
	|				ИЛИ СуммыОбязательств.КодФАИП = """"
	|			ТОГДА РЕГИСТРАТОРЫ.КодФАИП
	|		ИНАЧЕ СуммыОбязательств.КодФАИП
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА СуммыОбязательств.ИсточникСредств ЕСТЬ NULL
	|				ИЛИ СуммыОбязательств.ИсточникСредств = ЗНАЧЕНИЕ(Справочник.ИсточникиСредств.ПустаяСсылка)
	|			ТОГДА РЕГИСТРАТОРЫ.Ссылка.ИсточникСредств.Код
	|		ИНАЧЕ СуммыОбязательств.ИсточникСредств.Код
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА СуммыОбязательств.ИсточникСредств ЕСТЬ NULL
	|				ИЛИ СуммыОбязательств.ИсточникСредств = ЗНАЧЕНИЕ(Справочник.ИсточникиСредств.ПустаяСсылка)
	|			ТОГДА РЕГИСТРАТОРЫ.Ссылка.ИсточникСредств.Наименование
	|		ИНАЧЕ СуммыОбязательств.ИсточникСредств.Наименование
	|	КОНЕЦ,
	|	РЕГИСТРАТОРЫ.ОрганизацияКодПоПППКод + СуммыОбязательств.КПС.Код,
	|	ВЫБОР
	|		КОГДА СуммыОбязательств.КПС.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КРБ)
	|			ТОГДА ""10""
	|		КОГДА СуммыОбязательств.КПС.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КИФ)
	|				И ПОДСТРОКА(СуммыОбязательств.КПС.Код, 1, 2) = ""02""
	|			ТОГДА ""32""
	|		КОГДА СуммыОбязательств.КПС.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КИФ)
	|				И ПОДСТРОКА(СуммыОбязательств.КПС.Код, 1, 2) = ""01""
	|			ТОГДА ""31""
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА СуммыОбязательств.Валюта ЕСТЬ NULL
	|				ИЛИ СуммыОбязательств.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА ""643""
	|		ИНАЧЕ СуммыОбязательств.Валюта.Код
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	КодФАИП,
	|	КодВидаСредств,
	|	КодБК";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	// 0 РЕГИСТРАТОРЫ
	// 1 ВалютыИДаты
	// 2 КурсыВалют
	// 3 СуммыОбязательств
	// 4 ПодписиИДаты
	// 5 ПерваяПодписьФИО
	// 6 ВтораяПодписьФИО
	// 7 ПерваяПодписьДолжность
	// 8 ВтораяПодписьДолжность
	// 9 Запрос пакета 10
	//10 Запрос пакета 11
	
	Выборка = МассивРезультатов[9].Выбрать();	
	
	РасшифровкаДокумента = МассивРезультатов[10].Выгрузить();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураДанных = Новый Структура("РасшифровкаДокумента", Новый ТаблицаЗначений);
		
		Для Каждого Колонка ИЗ МассивРезультатов[9].Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);	
		КонецЦикла;
		
		// для печати даты в виде "__" ________ 20__ г.
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(Выборка.ДатаДок);
		СтруктураДанных.Вставить("ЧислоДаты", 			СтруктураДаты.Число);	
		СтруктураДанных.Вставить("МесяцДаты", 			СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", 			СтруктураДаты.Год);
		
		// реквизиты, требующие преобразования
		СтруктураДанных.Вставить("ПерваяПодписьФИО", 	КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", СтруктураДанных.ПерваяПодписьФамилия, СтруктураДанных.ПерваяПодписьИмя, СтруктураДанных.ПерваяПодписьОтчество), Истина));					
		СтруктураДанных.Вставить("ВтораяПодписьФИО", 	КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", СтруктураДанных.ВтораяПодписьФамилия, СтруктураДанных.ВтораяПодписьИмя, СтруктураДанных.ВтораяПодписьОтчество), Истина));
		СтруктураДанных.Вставить("НомерДок",          	ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Выборка.Ссылка, СтруктураДанных.НомерДок));
		СтруктураДанных.Вставить("НомерЛС", 			СокрЛП(СтруктураДанных.НомерЛС));
		СтруктураДанных.Вставить("КодГлавы", 			СокрЛП(СтруктураДанных.КодГлавы));			
		СтруктураДанных.Вставить("КОФК", 				СокрЛП(СтруктураДанных.КОФК));			
		
		СтруктураДанных.РасшифровкаДокумента = РасшифровкаДокумента.Скопировать(Новый Структура("Ссылка", Выборка.Ссылка));
		СтруктураДанных.РасшифровкаДокумента.Колонки.Вставить(0, "НомерСтроки", Новый ОписаниеТипов("Число"));
		Для Каждого Стр ИЗ СтруктураДанных.РасшифровкаДокумента Цикл
			Стр.НомерСтроки = СтруктураДанных.РасшифровкаДокумента.Индекс(Стр) + 1;
		КонецЦикла;	
		
		СтруктураДанных.Вставить("ИтогоСуммаРуб", СтруктураДанных.РасшифровкаДокумента.Итог("СуммаРуб")); 
		СтруктураДанных.Вставить("ИтогоСуммаАванс", СтруктураДанных.РасшифровкаДокумента.Итог("СуммаАванс")); 
		СтруктураДанных.Вставить("СуммаДокумента", СтруктураДанных.РасшифровкаДокумента.Итог("СуммаВал")); 
		
		МассивСтруктурДанных.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Возврат МассивСтруктурДанных;
	
КонецФункции	

Функция ЗначенияРеквизитовЗаявлениеНаПроведениеОперацийСИностраннойВалютой(МассивОбъектов) Экспорт
	
	МассивСтруктурДанных = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаявлениеРасшифровкаПлатежа.Ссылка КАК Ссылка,
	|	ЗаявлениеРасшифровкаПлатежа.НомерСтроки КАК НомерСтроки,
	|	ЗаявлениеРасшифровкаПлатежа.КБКНазначениеПлатежа КАК КБКНазначениеПлатежа,
	|	ЗаявлениеРасшифровкаПлатежа.Сумма КАК СуммаВРублях
	|ИЗ
	|	Документ.ЗаявлениеНаПроведениеОперацийСИностраннойВалютой.РасшифровкаПлатежа КАК ЗаявлениеРасшифровкаПлатежа
	|ГДЕ
	|	ЗаявлениеРасшифровкаПлатежа.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаявлениеНаПроведениеОперацийСИностраннойВалютой.ПерваяПодпись,
	|	ЗаявлениеНаПроведениеОперацийСИностраннойВалютой.ВтораяПодпись,
	|	ЗаявлениеНаПроведениеОперацийСИностраннойВалютой.Дата
	|ПОМЕСТИТЬ ПодписиИДаты
	|ИЗ
	|	Документ.ЗаявлениеНаПроведениеОперацийСИностраннойВалютой КАК ЗаявлениеНаПроведениеОперацийСИностраннойВалютой
	|ГДЕ
	|	ЗаявлениеНаПроведениеОперацийСИностраннойВалютой.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПерваяПодписьФИО.ПерваяПодпись,
	|	ПерваяПодписьФИО.Дата,
	|	ФИОФизическихЛиц.Фамилия,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество
	|ПОМЕСТИТЬ ПерваяПодписьФИО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПодписиИДаты.ПерваяПодпись КАК ПерваяПодпись,
	|		ПодписиИДаты.Дата КАК Дата,
	|		ПодписиИДаты.ПерваяПодпись.Контрагент.ЮридическоеФизическоеЛицо КАК ФизЛицо,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК Период
	|	ИЗ
	|		ПодписиИДаты КАК ПодписиИДаты
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО ПодписиИДаты.ПерваяПодпись.Контрагент.ЮридическоеФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|				И (ФИОФизическихЛиц.Период <= ПодписиИДаты.Дата)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ПодписиИДаты.ПерваяПодпись,
	|		ПодписиИДаты.ПерваяПодпись.Контрагент.ЮридическоеФизическоеЛицо,
	|		ПодписиИДаты.Дата) КАК ПерваяПодписьФИО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО ПерваяПодписьФИО.Период = ФИОФизическихЛиц.Период
	|			И ПерваяПодписьФИО.ФизЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	ПерваяПодписьФИО.ПерваяПодпись,
	|	ПерваяПодписьФИО.Дата,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество,
	|	ФИОФизическихЛиц.Фамилия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтораяПодписьФИО.ВтораяПодпись,
	|	ВтораяПодписьФИО.Дата,
	|	ФИОФизическихЛиц.Фамилия,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество
	|ПОМЕСТИТЬ ВтораяПодписьФИО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПодписиИДаты.ВтораяПодпись КАК ВтораяПодпись,
	|		ПодписиИДаты.Дата КАК Дата,
	|		ПодписиИДаты.ВтораяПодпись.Контрагент.ЮридическоеФизическоеЛицо КАК ФизЛицо,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК Период
	|	ИЗ
	|		ПодписиИДаты КАК ПодписиИДаты
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО ПодписиИДаты.ВтораяПодпись.Контрагент.ЮридическоеФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|				И (ФИОФизическихЛиц.Период <= ПодписиИДаты.Дата)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ПодписиИДаты.ВтораяПодпись,
	|		ПодписиИДаты.ВтораяПодпись.Контрагент.ЮридическоеФизическоеЛицо,
	|		ПодписиИДаты.Дата) КАК ВтораяПодписьФИО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО ВтораяПодписьФИО.Период = ФИОФизическихЛиц.Период
	|			И ВтораяПодписьФИО.ФизЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтораяПодписьФИО.ВтораяПодпись,
	|	ВтораяПодписьФИО.Дата,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество,
	|	ФИОФизическихЛиц.Фамилия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Заявление.Ссылка КАК Ссылка,
	|	Заявление.Номер КАК Номер,
	|	Заявление.Дата КАК Дата,
	|	Заявление.Организация КАК Организация,
	|	Заявление.ОрганКазначейства КАК ОрганКазначейства,
	|	""INN "" + Заявление.ОрганКазначейства.ИНН + "", "" + Заявление.ОрганКазначейства.НаименованиеЛатиницей КАК НаименованиеКлиента,
	|	ВЫБОР
	|		КОГДА Заявление.ЛицевойСчет.ИспользоватьДляСчетаУчетныйНомер
	|			ТОГДА Заявление.ЛицевойСчет.КодПоРПБС
	|		ИНАЧЕ Заявление.ЛицевойСчет.Владелец.КодПоРПБС
	|	КОНЕЦ КАК КодРПБС,
	|	Заявление.ЛицевойСчет.Код КАК ЛицевойСчетПлательщика,
	|	Заявление.ТипОперации КАК ТипОперации,
	|	Заявление.УровеньКонфиденциальности КАК УровеньКонфиденциальности,
	|	Заявление.ДатаВалютирования КАК ДатаВалютирования,
	|	Заявление.ВалютаДокумента КАК ВалютаДокумента,
