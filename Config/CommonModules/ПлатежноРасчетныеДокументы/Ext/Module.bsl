#Область ПрограммныйИнтерфейс

Процедура ПриСозданииНаСервереФормыДокумента(Форма, РеквизитСостояния = "УстановленныйСтатусДокумента", РеквизитСтатуса = "УстановленныеРеквизитыИсполнения") Экспорт
	
	УстановленныеРеквизитыИсполнения = ПолучитьСостояниеЗаявки(Форма.Объект.Ссылка);
	
	Если НЕ ЗначениеЗаполнено(УстановленныеРеквизитыИсполнения.Статус) Тогда
		
		УстановленныеРеквизитыИсполнения.Статус = Перечисления.СтатусыИсполненияДокумента.ВРаботе;
		
	КонецЕсли;	
		
	УстановленныйСтатусДокумента  = Строка(УстановленныеРеквизитыИсполнения.Статус);
	
	Если ЗначениеЗаполнено(УстановленныеРеквизитыИсполнения.ДатаПроведения) Тогда
		УстановленныйСтатусДокумента  =	УстановленныйСтатусДокумента + " " + УстановленныеРеквизитыИсполнения.ДатаПроведения;
	ИначеЕсли ЗначениеЗаполнено(УстановленныеРеквизитыИсполнения.ДатаРегистрации) Тогда
		УстановленныйСтатусДокумента  =	УстановленныйСтатусДокумента + " " + УстановленныеРеквизитыИсполнения.ДатаРегистрации;
	КонецЕсли;	
	
	Форма[РеквизитСостояния] 	= УстановленныйСтатусДокумента;
	
	Форма[РеквизитСтатуса] 		= УстановленныеРеквизитыИсполнения;
	
КонецПроцедуры	

Процедура ПередЗаписьюНаСервереДокумента(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи, РеквизитСтатуса = "УстановленныеРеквизитыИсполнения", РеквизитФлагЗаписи = "УстановленныйСтатусЗаписать") Экспорт
	
	Если Форма[РеквизитФлагЗаписи] Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("УстановленныйСтатусЗаписать", Форма[РеквизитФлагЗаписи]);
		ТекущийОбъект.ДополнительныеСвойства.Вставить("УстановленСтатус", Форма[РеквизитСтатуса].Статус);
		ТекущийОбъект.ДополнительныеСвойства.Вставить("УстановленныеРеквизитыИсполнения", Форма[РеквизитСтатуса]); 
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ПриЗаписиНаСервереДокумента(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи, РеквизитСтатуса = "УстановленныеРеквизитыИсполнения", РеквизитФлагЗаписи = "УстановленныйСтатусЗаписать") Экспорт
	
	Если Форма[РеквизитФлагЗаписи] Тогда
		РеквизитыРегистрации = Форма[РеквизитСтатуса];
		РеквизитыРегистрации.Вставить("ПлатежноРасчетныйДокумент", ТекущийОбъект.Ссылка);
		ЗарегестрироватьИсполнениеЗаявки(РеквизитыРегистрации);
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ПриЗаписиНаСервереУстановкаСтатуса(Отказ, ТекущийОбъект, РеквизитСтатуса = "УстановленныеРеквизитыИсполнения", РеквизитФлагЗаписи = "УстановленныйСтатусЗаписать") Экспорт
	
	Источник = ТекущийОбъект.ДополнительныеСвойства;
	
	Если Источник.Свойство(РеквизитФлагЗаписи) И Источник[РеквизитФлагЗаписи] Тогда
		РеквизитыРегистрации = Источник[РеквизитСтатуса];
		РеквизитыРегистрации.Вставить("ПлатежноРасчетныйДокумент", ТекущийОбъект.Ссылка);
		ЗарегестрироватьИсполнениеЗаявки(РеквизитыРегистрации);
	КонецЕсли;	
	
КонецПроцедуры	

Процедура КорСчетЗаполнитьСписокВыбора(Форма) Экспорт
	
	СписокВыбора = Форма.Элементы.КорСчет.СписокВыбора;
	СписокВыбора.Очистить();  
	
	ДатаДок = Форма.Объект.Дата;   
	Если НЕ ЗначениеЗаполнено(ДатаДок) Тогда
		ДатаДок = ТекущаяДатаСеанса();
	КонецЕсли;
	Организация = Форма.Объект.Организация;
	
	// Это документ с кор.счетом 209.00, до объединения 205.00 и 209.00.
	КорСчет209 = БухгалтерскийУчет.СчетВИерархии(Форма.Объект.КорСчет, "209.00");
	СчетДоходов = ?(КорСчет209, "209.00", "205.00");
	
	Если ТипЗнч(Форма.Объект.Ссылка) = Тип("ДокументСсылка.ЗаявкаНаВозврат") 
		ИЛИ ТипЗнч(Форма.Объект.Ссылка) = Тип("ДокументСсылка.РСКПВозврат") Тогда
		
		СписокВыбора.Добавить(БухгалтерскийУчет.СчетПоКоду(СчетДоходов, ДатаДок, Организация),
			НСтр("ru = '205.00, 209.00 Расчеты по доходам (полученным авансам)'"));
		СписокВыбора.Добавить(БухгалтерскийУчет.СчетПоКоду("303.00", Неопределено, Неопределено),
			НСтр("ru = '303.00 Расчеты по платежам в бюджеты'"));
		СписокВыбора.Добавить(ПланыСчетов.ЕПСБУ.ПустаяСсылка(),
			НСтр("ru = 'Прочие счета'"));
		
	Иначе
		
		СписокВыбора.Добавить(БухгалтерскийУчет.СчетПоКоду(СчетДоходов, ДатаДок, Организация),
			НСтр("ru = '205.00, 209.00 Расчеты по доходам (полученным авансам)'"));
		СписокВыбора.Добавить(БухгалтерскийУчет.СчетПоКоду("206.00", ДатаДок, Организация),
			НСтр("ru = '206.00 Расчеты по выданным авансам'"));
		СписокВыбора.Добавить(БухгалтерскийУчет.СчетПоКоду("207.00", ДатаДок, Организация),
			НСтр("ru = '207.00 Расчеты по кредитам, займам (ссудам)'"));
		СписокВыбора.Добавить(БухгалтерскийУчет.СчетПоКоду("208.00", ДатаДок, Организация),
			НСтр("ru = '208.00 Расчеты с подотчетными лицами'"));
		СписокВыбора.Добавить(БухгалтерскийУчет.СчетПоКоду("301.00", ДатаДок, Организация),
			НСтр("ru = '301.00 Расчеты с кредиторами по долговым обязательствам'"));
		СписокВыбора.Добавить(БухгалтерскийУчет.СчетПоКоду("302.00", ДатаДок, Организация),
			НСтр("ru = '302.00 Расчеты по принятым обязательствам'"));
		СписокВыбора.Добавить(БухгалтерскийУчет.СчетПоКоду("303.00", ДатаДок, Организация),
			НСтр("ru = '303.00 Расчеты по платежам в бюджеты'"));
		СписокВыбора.Добавить(ПланыСчетов.ЕПСБУ.ПустаяСсылка(),
			НСтр("ru = 'Прочие счета'"));
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРасшифровкуПлатежаПоОстаткамЗадолженности(РасшифровкаПлатежа, ДокументОбъект, Контрагент = Неопределено) Экспорт
	
	НомераТаблиц = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Если ДокументОбъект.ЭтоНовый() Тогда
		Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая));
	Иначе
		Запрос.УстановитьПараметр("КонецПериода", Новый Граница(ДокументОбъект.МоментВремени(), ВидГраницы.Исключая));
	КонецЕсли;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	ЕстьКонтрагент   = ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Контрагент", МетаданныеДокумента);
	
	Если ЕстьКонтрагент И Контрагент = Неопределено Тогда
		Запрос.УстановитьПараметр("Контрагент", ДокументОбъект["Контрагент"]); 
	Иначе
		Запрос.УстановитьПараметр("Контрагент", Контрагент); 
    КонецЕсли;
	
	Если ДокументОбъект.КорСчет = БухгалтерскийУчет.СчетПоКоду("205.00", Неопределено, Неопределено)
	 ИЛИ ДокументОбъект.КорСчет = БухгалтерскийУчет.СчетПоКоду("209.00", Неопределено, Неопределено) Тогда
		// В расчетно-платежных документах кор.счета 205.00 и 209.00 в шапке объединены.
		Запрос.УстановитьПараметр("СчетаРасчетов", БухгалтерскийУчет.СписокСчетов("205.00,209.00"));
	Иначе
		Запрос.УстановитьПараметр("СчетаРасчетов", БухгалтерскийУчет.СписокСчетов(ДокументОбъект.КорСчет));
	КонецЕсли;
	
	ЭтоПоступлениеДенежныхСредств =
		(МетаданныеДокумента.Имя = "ПриходныйКассовыйОрдер"
		ИЛИ МетаданныеДокумента.Имя = "КассовоеПоступление"
		ИЛИ МетаданныеДокумента.Имя = "ЭквайринговаяОперация");
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ЕСТЬNULL(ЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ЕПСБУОстатки.Субконто1 КАК Контрагент,
	|	ЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЕПСБУОстатки.Субконто3 КАК Субконто3,
	|	ЕПСБУОстатки.Валюта КАК Валюта,
	|	ЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
	|	ЕПСБУОстатки.СуммаОстатокКт КАК СуммаОстатокКт,
	|	ЕПСБУОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт,
	|	ЕПСБУОстатки.ВалютнаяСуммаОстатокКт КАК ВалютнаяСуммаОстатокКт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&СчетаРасчетов),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И Субконто1 = &Контрагент) КАК ЕПСБУОстатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	КФО,
	|	КПС,
	|	Субконто3";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	ЕстьОтборПоДоговору = Ложь;
	Если МетаданныеДокумента.Имя = "ПриходныйКассовыйОрдер"
	 ИЛИ МетаданныеДокумента.Имя = "РасходныйКассовыйОрдер"
	 ИЛИ МетаданныеДокумента.Имя = "КассовоеВыбытие"
	 ИЛИ МетаданныеДокумента.Имя = "ЗаявкаНаКассовыйРасход"
	 ИЛИ МетаданныеДокумента.Имя = "ПлатежноеПоручение" 
	 ИЛИ МетаданныеДокумента.Имя = "РСКППеречисление" Тогда
		ЕстьОтборПоДоговору = Истина;
	КонецЕсли;
	
	ОстаткиЗадолженности = Запрос.Выполнить().Выгрузить();
	
	ЕстьВалютаДокумента = ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ВалютаДокумента", МетаданныеДокумента);
	ЕстьКолонкаСуммаВал = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("СуммаВал", МетаданныеДокумента, "РасшифровкаПлатежа");
	ЕстьКолонкаКонтрагент = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("Контрагент", МетаданныеДокумента, "РасшифровкаПлатежа");
	
	ВалютаРубли = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	ВалютаДокумента = ?(ЕстьВалютаДокумента, ДокументОбъект.ВалютаДокумента, ВалютаРубли);
	
	Если ВалютаДокумента <> ВалютаРубли И ЕстьКолонкаСуммаВал Тогда
		КоэффициентРуб = ДокументОбъект.Курс / ?(ДокументОбъект.Кратность=0, 1, ДокументОбъект.Кратность);
	Иначе
		КоэффициентРуб = 1;
	КонецЕсли;
	
	Для Каждого ОстаткиБУ Из ОстаткиЗадолженности Цикл
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ОстаткиБУ.Счет);
		
		Если БухгалтерскийУчет.СчетВИерархии(ОстаткиБУ.Счет, "206.00") Тогда
			ДтКт = "Дт";
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(ОстаткиБУ.Счет, "302.00") Тогда
			ДтКт = "Кт";
		Иначе // 205.00, 209.00
			ДтКт = ?(ЭтоПоступлениеДенежныхСредств, "Дт", "Кт");
		КонецЕсли;
		
		Если ОстаткиБУ["СуммаОстаток"+ДтКт] <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОстаткиБУДоговор = Справочники.Договоры.ПустаяСсылка();
		Если ЕстьОтборПоДоговору И БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(ОстаткиБУ.Счет) Тогда
			ОстаткиБУДоговор = ?(СвойстваСчетаРасчетов.ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.Договоры,
				ОстаткиБУ.Субконто2, ОстаткиБУ.Субконто3);
			Если ДокументОбъект.Договор <> ОстаткиБУДоговор Тогда
				Продолжить; // Пропускаем остатки по другому договору.
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОстаткиБУ.Валюта) И (ОстаткиБУ.Валюта <> ВалютаДокумента) Тогда
			Продолжить; // Пропускаем остатки в другой валюте.
		КонецЕсли;  
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
			И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			
			ПодразделениеРасчетов = Неопределено;
			
			Если МетаданныеДокумента.Имя = "ПриходныйКассовыйОрдер"
			 ИЛИ МетаданныеДокумента.Имя = "РасходныйКассовыйОрдер" Тогда
				ПодразделениеРасчетов = ДокументОбъект.ПодразделениеКор; 
			ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Подразделение", МетаданныеДокумента) Тогда
	            ПодразделениеРасчетов = ДокументОбъект.Подразделение;
			КонецЕсли;
			
			Если НЕ ПодразделениеРасчетов = Неопределено И ЗначениеЗаполнено(ОстаткиБУ.Подразделение)
				И ОстаткиБУ.Подразделение <> ПодразделениеРасчетов Тогда
				Продолжить; // Пропускаем остатки по другому подразделению расчетов.
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока = РасшифровкаПлатежа.Добавить();
		
		// Добавляем строки погашения задолженности.
		НоваяСтрока.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.ПоДокументу;
		
		Если МетаданныеДокумента.Имя = "КассовоеПоступление"
		 ИЛИ МетаданныеДокумента.Имя = "КассовоеВыбытие"
		 ИЛИ МетаданныеДокумента.Имя = "ЗаявкаНаКассовыйРасход"
		 ИЛИ МетаданныеДокумента.Имя = "ПлатежноеПоручение" 
		 ИЛИ МетаданныеДокумента.Имя = "РСКППеречисление" Тогда
			
			НоваяСтрока.СчетРасчетов = ОстаткиБУ.Счет;
			
			НоваяСтрока.КФО = ОстаткиБУ.КФО;
			НоваяСтрока.КБКНазначениеПлатежа = ОстаткиБУ.КПС;
			НоваяСтрока.КОСГУНазначениеПлатежа = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(ОстаткиБУ.Счет);
			
			Если НЕ ЕстьОтборПоДоговору Тогда
				ОстаткиБУДоговор = ?(СвойстваСчетаРасчетов.ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.Договоры,
					ОстаткиБУ.Субконто2, ОстаткиБУ.Субконто3);
				НоваяСтрока.Договор = ОстаткиБУДоговор;
			КонецЕсли;
			
			Если НЕ МетаданныеДокумента.Имя = "РСКППеречисление" Тогда 
				ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(
				ДокументОбъект.ЛицевойСчет, НоваяСтрока.КФО);
				Если ДопустимыеИсточникиСредств.Количество() > 0 Тогда
					НоваяСтрока.ИсточникСредств = ДопустимыеИсточникиСредств[0];
				КонецЕсли; 
			КонецЕсли;
			
		ИначеЕсли МетаданныеДокумента.Имя = "ПриходныйКассовыйОрдер"
			ИЛИ МетаданныеДокумента.Имя = "РасходныйКассовыйОрдер" Тогда
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиБУ, "КФО,КПС");
			
			НоваяСтрока.СчетРасчетов = ОстаткиБУ.Счет;
			НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(ОстаткиБУ.Счет);
			
		КонецЕсли;
		
		Если ЕстьКолонкаКонтрагент Тогда
			НоваяСтрока.Контрагент = ДокументОбъект.Контрагент;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвойстваСчетаРасчетов.ВидСубконто3) Тогда
			НоваяСтрока.ДопСубконтоРасчетов = ОстаткиБУ.Субконто3;
			Если ТипЗнч(ОстаткиБУ.Субконто3) = Тип("СправочникСсылка.ВидыЦелевыхСредств") Тогда
				НоваяСтрока.КодЦели = ОстаткиБУ.Субконто3;
			ИначеЕсли ТипЗнч(ОстаткиБУ.Субконто3) = Тип("СправочникСсылка.Мероприятия") Тогда
				НоваяСтрока.КодМероприятия = ОстаткиБУ.Субконто3;
			ИначеЕсли ТипЗнч(ОстаткиБУ.Субконто3) = Тип("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация") Тогда
				НоваяСтрока.ДопКлассификация = ОстаткиБУ.Субконто3;
			КонецЕсли;
		КонецЕсли;
		
		Если БухгалтерскийУчет.СчетВИерархии(ОстаткиБУ.Счет, "207.00, 301.00")
			И СвойстваСчетаРасчетов.ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ВидыРасчетовПоЗаймам Тогда
			НоваяСтрока.ВидРасчетов = ОстаткиБУ.Субконто3;
		КонецЕсли;
		
		Если ВалютаДокумента <> ВалютаРубли Тогда
			
			Если ЕстьКолонкаСуммаВал Тогда
				НоваяСтрока.СуммаВал = ОстаткиБУ["ВалютнаяСуммаОстаток"+ДтКт];
				НоваяСтрока.Сумма    = НоваяСтрока.СуммаВал * КоэффициентРуб;
			Иначе
				НоваяСтрока.Сумма = ОстаткиБУ["ВалютнаяСуммаОстаток"+ДтКт];
			КонецЕсли;
			
		Иначе
			
			НоваяСтрока.Сумма = ОстаткиБУ["СуммаОстаток"+ДтКт];
			Если ЕстьКолонкаСуммаВал Тогда
				НоваяСтрока.СуммаВал = НоваяСтрока.Сумма;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НеРаспределено = ?(ВалютаДокумента <> ВалютаРубли И ЕстьКолонкаСуммаВал,
		ДокументОбъект.СуммаДокументаВВалюте - РасшифровкаПлатежа.Итог("СуммаВал"),
		ДокументОбъект.СуммаДокумента - РасшифровкаПлатежа.Итог("Сумма") );
	
	СуммаДокумента = ?(ЕстьКолонкаСуммаВал,
		ДокументОбъект.СуммаДокументаВВалюте,
		ДокументОбъект.СуммаДокумента);
	
	Если НеРаспределено > 0 Тогда
		
		НоваяСтрока = РасшифровкаПлатежа.Добавить();
		
		// Остаток оплаты, превышающий имеющуюся задолженность, добавляем отдельной строкой.
		НоваяСтрока.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.НеПогашать;
		
		Если ВалютаДокумента <> ВалютаРубли Тогда
			
			Если ЕстьКолонкаСуммаВал Тогда
				НоваяСтрока.СуммаВал = НеРаспределено;
				НоваяСтрока.Сумма    = НоваяСтрока.СуммаВал * КоэффициентРуб;
			Иначе
				НоваяСтрока.Сумма = НеРаспределено;
			КонецЕсли;
			
		Иначе
			
			НоваяСтрока.Сумма = НеРаспределено;
			Если ЕстьКолонкаСуммаВал Тогда
				НоваяСтрока.СуммаВал = НоваяСтрока.Сумма;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЕстьОтборПоДоговору Тогда
			ТекстСообщения = НСтр("ru='Сумма документа (%1) превышает имеющуюся задолженность контрагента ""%4"" по договору ""%5"" (%2). 
				|Сумма превышения (%3) добавлена отдельной строкой.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
				ОбщегоНазначенияБГУ.ФорматСумм(СуммаДокумента, ВалютаДокумента),
				ОбщегоНазначенияБГУ.ФорматСумм(СуммаДокумента - НеРаспределено, ВалютаДокумента),
				ОбщегоНазначенияБГУ.ФорматСумм(НеРаспределено, ВалютаДокумента),
				?(ЕстьКонтрагент, ДокументОбъект["Контрагент"], Контрагент),
				ДокументОбъект.Договор);
		Иначе
			ТекстСообщения = НСтр("ru='Сумма документа (%1) превышает имеющуюся задолженность контрагента ""%4"" (%2). 
				|Сумма превышения (%3) добавлена отдельной строкой.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
				ОбщегоНазначенияБГУ.ФорматСумм(СуммаДокумента, ВалютаДокумента),
				ОбщегоНазначенияБГУ.ФорматСумм(СуммаДокумента - НеРаспределено, ВалютаДокумента),
				ОбщегоНазначенияБГУ.ФорматСумм(НеРаспределено, ВалютаДокумента),
				?(ЕстьКонтрагент, ДокументОбъект["Контрагент"], Контрагент));
		КонецЕсли;
		ПолеСумма = "РасшифровкаПлатежа[" + Формат(НоваяСтрока.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Сумма";
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, ПолеСумма, "Объект");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСписокВыбораКодовДохода(ЭлементФормы) Экспорт
	
	ЭлементФормы.СписокВыбора.Очистить();
	ЭлементФормы.СписокВыбора.Добавить("", "разрешено, без ограничения или не является доходом"); 
	ЭлементФормы.СписокВыбора.Добавить("1", "1 - Перевод денежных средств, являющихся заработной платой и (или) иными доходами, в отношении которых статьей 99 Федерального закона от 2 октября 2007 года № 229-ФЗ установлены ограничения размеров удержания");  
	ЭлементФормы.СписокВыбора.Добавить("2", "2 - Перевод денежных средств, являющихся доходами, на которые в соответствии с частью 1 статьи 101 Федерального закона от 2 октября 2007 года № 229-ФЗ не может быть обращено взыскание и которые имеют характер периодических выплат");  
	ЭлементФормы.СписокВыбора.Добавить("3", "3 - Перевод денежных средств, являющихся доходами, к которым в соответствии с частью 2 статьи 101 Федерального закона от 2 октября 2007 года № 229-ФЗ ограничения по обращению взыскания не применяются и которые имеют характер периодических выплат");  
	ЭлементФормы.СписокВыбора.Добавить("4", "4 - Перевод денежных средств, являющихся доходами, на которые в соответствии с частью 1 статьи 101 Федерального закона от 2 октября 2007 года № 229-ФЗ не может быть обращено взыскание и которые имеют характер единовременных выплат");  
	ЭлементФормы.СписокВыбора.Добавить("5", "5 - Перевод денежных средств, являющихся доходами, к которым в соответствии с частью 2 статьи 101 Федерального закона от 2 октября 2007 года № 229-ФЗ ограничения по обращению взыскания не применяются и которые имеют характер единовременных выплат"); 
	
КонецПроцедуры	

// Возвращает название подтверждающего документа по номеру вида операции (из данных казначейства).
Функция ОпределитьВидПодтверждающегоДокумента(ВидОперации) Экспорт
	
	Если ВидОперации = "01" Тогда
		Возврат "Платежное поручение";
	ИначеЕсли ВидОперации = "16" Тогда
		Возврат "Платежный ордер";
	ИначеЕсли ВидОперации = "0" Тогда
		Возврат "Поручение о перечислении на счет";
	ИначеЕсли ВидОперации = "1" Тогда
		Возврат "Требование получателя платежа";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции	

// Формирует представление даты в виде отдельных частей
// 
// Параметры:
// ДатаДляПечати - дата
//
// Возвращаемое значение:
// Структура, содержащая:
// Число даты - строка (2 знака) (ключ "Число"), 
// Месяц даты - строка, месяц прописью (ключ "Месяц"),
// Год даты - строка (2 знака) (ключ "Год")
//
Функция РазложитьДатуДляПечати(ДатаДляПечати)  экспорт
	рДатаСтр 	= Формат(ДатаДляПечати, "ДФ=ддММММгг");
	СтурктураДаты = Новый Структура;
	СтурктураДаты.Вставить("Число", Лев(рДатаСтр, 2));
    СтурктураДаты.Вставить("Месяц", Сред(рДатаСтр, 3, СтрДлина(рДатаСтр) - 4));
	СтурктураДаты.Вставить("Год",   Прав(рДатаСтр, 2));
	Возврат СтурктураДаты;
КонецФункции	

Функция ФорматироватьСуммуПлатежногоДокумента(Сумма, ВыводитьСуммуБезКопеек = Ложь) экспорт
	
	Результат  = Сумма;
	ЦелаяЧасть = Цел(Сумма);
	
	Если Результат = ЦелаяЧасть Тогда
		Если ВыводитьСуммуБезКопеек Тогда
			Результат = Формат(Результат, "ЧДЦ=2; ЧРД='='; ЧГ=0");
			Результат = Лев(Результат, Найти(Результат, "="));
		Иначе
			Результат = Формат(Результат, "ЧДЦ=2; ЧРД='-'; ЧГ=0");
		КонецЕсли;
	Иначе
		Результат = Формат(Результат, "ЧДЦ=2; ЧРД='-'; ЧГ=0");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ФорматироватьСуммуПлатежногоДокумента()

//* Форматирует сумму прописью банковского платежного документа
//
// Параметры:
//  Сумма - число - реквизит, который надо представить прописью 
//  Валюта - СправочникСсылка.Валюты - валюта, в которой нужно представить сумму
//  ВыводитьСуммуБезКопеек - булево - флаг представления суммы без копеек
//
// Возвращаемое значение
//  Отформатированная строка
//
Функция ФорматироватьСуммуПрописьюПлатежногоДокумента(Сумма, Валюта = Неопределено, ВыводитьСуммуБезКопеек = Ложь) экспорт
	
	Результат     = Сумма;
	ЦелаяЧасть    = Цел(Сумма);
	ФорматСтрока  = "Л=ru_RU; ДП=Ложь";
	Если ТипЗнч(Валюта) = Тип("СправочникСсылка.Валюты") Тогда
		ПарамПредмета = Валюта.ПараметрыПрописи;
	Иначе
		ПарамПредмета = "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";
	КонецЕсли;	
	
	Если Результат = ЦелаяЧасть Тогда
		Если ВыводитьСуммуБезКопеек Тогда
			Результат = ЧислоПрописью(Результат, ФорматСтрока, ПарамПредмета);
			Результат = Лев(Результат, Найти(Результат, "0") - 1);
		Иначе
			Результат = ЧислоПрописью(Результат, ФорматСтрока, ПарамПредмета);
		КонецЕсли;
	Иначе
		Результат = ЧислоПрописью(Результат, ФорматСтрока, ПарамПредмета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ФорматироватьСуммуПрописьюПлатежногоДокумента()

#Область ФормированиеДанныхДляПечатиИВыгрузки

// Возвращает массив структур, содержащих значения реквизитов Заявки на получение/сдачи НД для печати или выгрузки
//
Функция ЗначенияРеквизитовЗаявкаНаСдачуПолучениеНаличных(МассивОбъектов, ИспользоватьДопКл = Ложь, ИспользоватьКодМероприятия = Ложь, ИспользоватьКЭК = Ложь, ИспользоватьАналитическийКод = Ложь, ИспользоватьКФО = Ложь, ИспользоватьКОСГУПолучателя = Ложь) Экспорт 
	
	МассивСтруктурДанных = Новый Массив;
	
	// Значения реквизитов ЗКР
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст =  "   
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаявкаНаСдачуПолучениеНаличных.ПерваяПодпись КАК ПерваяПодпись,
	|	ЗаявкаНаСдачуПолучениеНаличных.ВтораяПодпись КАК ВтораяПодпись,
	|	ЗаявкаНаСдачуПолучениеНаличных.Работник КАК Работник,
	|	ЗаявкаНаСдачуПолучениеНаличных.Дата КАК Дата
	|ПОМЕСТИТЬ ПодписиИДаты
	|ИЗ
	|	Документ.ЗаявкаНаСдачуПолучениеНаличных КАК ЗаявкаНаСдачуПолучениеНаличных
	|ГДЕ
	|	ЗаявкаНаСдачуПолучениеНаличных.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////   
	|ВЫБРАТЬ
	|	ПерваяПодписьФИО.ПерваяПодпись,
	|	ПерваяПодписьФИО.Дата,
	|	ФИОФизическихЛиц.Фамилия,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество
	|ПОМЕСТИТЬ ПерваяПодписьФИО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПодписиИДаты.ПерваяПодпись КАК ПерваяПодпись,
	|		ПодписиИДаты.Дата КАК Дата,
	|		ПодписиИДаты.ПерваяПодпись.Контрагент.ЮридическоеФизическоеЛицо КАК ФизЛицо,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК Период
	|	ИЗ
	|		ПодписиИДаты КАК ПодписиИДаты
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО ПодписиИДаты.ПерваяПодпись.Контрагент.ЮридическоеФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|				И (ФИОФизическихЛиц.Период <= ПодписиИДаты.Дата)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ПодписиИДаты.ПерваяПодпись,
	|		ПодписиИДаты.ПерваяПодпись.Контрагент.ЮридическоеФизическоеЛицо,
	|		ПодписиИДаты.Дата) КАК ПерваяПодписьФИО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО ПерваяПодписьФИО.Период = ФИОФизическихЛиц.Период
	|			И ПерваяПодписьФИО.ФизЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	ПерваяПодписьФИО.ПерваяПодпись,
	|	ПерваяПодписьФИО.Дата,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество,
	|	ФИОФизическихЛиц.Фамилия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтораяПодписьФИО.ВтораяПодпись,
	|	ВтораяПодписьФИО.Дата,
	|	ФИОФизическихЛиц.Фамилия,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество
	|ПОМЕСТИТЬ ВтораяПодписьФИО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПодписиИДаты.ВтораяПодпись КАК ВтораяПодпись,
	|		ПодписиИДаты.Дата КАК Дата,
	|		ПодписиИДаты.ВтораяПодпись.Контрагент.ЮридическоеФизическоеЛицо КАК ФизЛицо,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК Период
	|	ИЗ
	|		ПодписиИДаты КАК ПодписиИДаты
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО ПодписиИДаты.ВтораяПодпись.Контрагент.ЮридическоеФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|				И (ФИОФизическихЛиц.Период <= ПодписиИДаты.Дата)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ПодписиИДаты.ВтораяПодпись,
	|		ПодписиИДаты.ВтораяПодпись.Контрагент.ЮридическоеФизическоеЛицо,
	|		ПодписиИДаты.Дата) КАК ВтораяПодписьФИО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО ВтораяПодписьФИО.Период = ФИОФизическихЛиц.Период
	|			И ВтораяПодписьФИО.ФизЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
