	|		ИНАЧЕ ЕСТЬNULL(ВЫРАЗИТЬ(Заявление.СчетПолучателя.КассовыйОрган КАК Справочник.Банки).ГородМеждународный, """")
	|	КОНЕЦ КАК БанкПолучателяГород,
	|	ВЫБОР
	|		КОГДА Заявление.ПереводСебеКакПБС
	|			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(Заявление.РеквизитыЛицевогоСчетаПБС.КассовыйОрган КАК Справочник.Банки).АдресМеждународный, """")
	|		ИНАЧЕ ЕСТЬNULL(ВЫРАЗИТЬ(Заявление.СчетПолучателя.КассовыйОрган КАК Справочник.Банки).АдресМеждународный, """")
	|	КОНЕЦ КАК БанкПолучателяУличныйАдрес,
	|	ЕСТЬNULL(Заявление.БанкКорреспондент.КоррСчет, """") КАК БанкКорреспондентНомерСчета,
	|	ЕСТЬNULL(Заявление.БанкКорреспондент.СВИФТБИК, """") КАК БанкКорреспондентСВИФТ,
	|	ЕСТЬNULL(Заявление.БанкКорреспондент.МеждународноеНаименование, """") КАК БанкКорреспондентНаименование,
	|	ЕСТЬNULL(Заявление.БанкКорреспондент.Код, """") КАК БанкКорреспондентКод,
	|	ЕСТЬNULL(Заявление.БанкКорреспондент.Страна.КодАльфа2, """") КАК БанкКорреспондентКодСтраны,
	|	ЕСТЬNULL(Заявление.БанкКорреспондент.ГородМеждународный, """") КАК БанкКорреспондентГород,
	|	ЕСТЬNULL(Заявление.БанкКорреспондент.АдресМеждународный, """") КАК БанкКорреспондентУличныйАдрес,
	|	ЕСТЬNULL(Заявление.БанкПосредник1.КоррСчет, """") КАК БанкПосредник1НомерСчета,
	|	ЕСТЬNULL(Заявление.БанкПосредник1.СВИФТБИК, """") КАК БанкПосредник1СВИФТ,
