		СтруктураДанных.Вставить("ПерваяПодписьФИО", 	Корреспонденты.ФИОПоОбъекту(СтруктураДанных.ПерваяПодпись, Истина, СтруктураДанных.ДатаДок));					
		СтруктураДанных.Вставить("ВтораяПодписьФИО", 	Корреспонденты.ФИОПоОбъекту(СтруктураДанных.ВтораяПодпись, Истина, СтруктураДанных.ДатаДок));
