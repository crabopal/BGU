	|					КОГДА ПОДСТРОКА(ЗаявкаНаВозврат.КОСГУНазначениеПлатежа.Код, 1, 1) = ""1""
	|							ИЛИ ПОДСТРОКА(ЗаявкаНаВозврат.КОСГУНазначениеПлатежа.Код, 1, 1) = ""4""
	|						ТОГДА ""20""
	|					КОГДА ПОДСТРОКА(ЗаявкаНаВозврат.КОСГУНазначениеПлатежа.Код, 1, 1) = ""5""
	|							ИЛИ ПОДСТРОКА(ЗаявкаНаВозврат.КОСГУНазначениеПлатежа.Код, 1, 1) = ""6""
	|						ТОГДА ""31""
