	|	ЕСТЬNULL(Заявление.БанкПосредник1.Страна.КодАльфа2, """") КАК БанкПосредник1КодСтраны,
	|	ЕСТЬNULL(Заявление.БанкПосредник1.ГородМеждународный, """") КАК БанкПосредник1Город,
	|	ЕСТЬNULL(Заявление.БанкПосредник1.АдресМеждународный, """") КАК БанкПосредник1УличныйАдрес,
	|	ЕСТЬNULL(Заявление.БанкПосредник2.КоррСчет, """") КАК БанкПосредник2НомерСчета,
	|	ЕСТЬNULL(Заявление.БанкПосредник2.СВИФТБИК, """") КАК БанкПосредник2СВИФТ,
	|	ЕСТЬNULL(Заявление.БанкПосредник2.МеждународноеНаименование, """") КАК БанкПосредник2Наименование,
	|	ЕСТЬNULL(Заявление.БанкПосредник2.Код, """") КАК БанкПосредник2Код,
	|	ЕСТЬNULL(Заявление.БанкПосредник2.Страна.КодАльфа2, """") КАК БанкПосредник2КодСтраны,
	|	ЕСТЬNULL(Заявление.БанкПосредник2.ГородМеждународный, """") КАК БанкПосредник2Город,
	|	ЕСТЬNULL(Заявление.БанкПосредник2.АдресМеждународный, """") КАК БанкПосредник2УличныйАдрес,
	|	ЕСТЬNULL(Заявление.БанкПосредник3.КоррСчет, """") КАК БанкПосредник3НомерСчета,
	|	ЕСТЬNULL(Заявление.БанкПосредник3.СВИФТБИК, """") КАК БанкПосредник3СВИФТ,
	|	ЕСТЬNULL(Заявление.БанкПосредник3.МеждународноеНаименование, """") КАК БанкПосредник3Наименование,
	|	ЕСТЬNULL(Заявление.БанкПосредник3.Код, """") КАК БанкПосредник3Код,
	|	ЕСТЬNULL(Заявление.БанкПосредник3.Страна.КодАльфа2, """") КАК БанкПосредник3КодСтраны,
	|	ЕСТЬNULL(Заявление.БанкПосредник3.ГородМеждународный, """") КАК БанкПосредник3Город,
	|	ЕСТЬNULL(Заявление.БанкПосредник3.АдресМеждународный, """") КАК БанкПосредник3УличныйАдрес,
	|	ФИОПерваяПодпись.Фамилия КАК ПерваяПодписьФамилия,
	|	ФИОПерваяПодпись.Имя КАК ПерваяПодписьИмя,
	|	ФИОПерваяПодпись.Отчество КАК ПерваяПодписьОтчество,
	|	ФИОВтораяПодпись.Фамилия КАК ВтораяПодписьФамилия,
	|	ФИОВтораяПодпись.Имя КАК ВтораяПодписьИмя,
	|	ФИОВтораяПодпись.Отчество КАК ВтораяПодписьОтчество
	|ИЗ
	|	Документ.ЗаявлениеНаПроведениеОперацийСИностраннойВалютой КАК Заявление
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПерваяПодписьФИО КАК ФИОПерваяПодпись
	|		ПО Заявление.ПерваяПодпись = ФИОПерваяПодпись.ПерваяПодпись
	|			И Заявление.Дата = ФИОПерваяПодпись.Дата
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтораяПодписьФИО КАК ФИОВтораяПодпись
	|		ПО Заявление.ВтораяПодпись = ФИОВтораяПодпись.ВтораяПодпись
	|			И Заявление.Дата = ФИОВтораяПодпись.Дата
	|ГДЕ
	|	Заявление.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	Выборка = МассивРезультатов[4].Выбрать();
	РасшифровкаПлатежа = МассивРезультатов[0].Выгрузить();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураДанных = Новый Структура("РасшифровкаПлатежа", Новый ТаблицаЗначений);
		
		Для Каждого Колонка ИЗ МассивРезультатов[4].Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		
		// согласно требованиям к формату передачи заявления, если банковский счет перевододателя открыт в Сбербанке,
		// то адреса указываются в формате код страны//наименование города//уличный адрес
		Если Выборка.БИКБанкаПлательщика = "044525225" Тогда
			СчетПеревододателяОткрытВСбербанке = Истина;
		Иначе
			СчетПеревододателяОткрытВСбербанке = Ложь;
		КонецЕсли;
		
		// требует преобразования
		СтруктураДанных.Вставить("Номер", ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Выборка.Номер, Истина, Истина));
		
		СтруктураДанных.Вставить("ПерваяПодписьФИО", КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
			СтруктураДанных.ПерваяПодписьФамилия, СтруктураДанных.ПерваяПодписьИмя, СтруктураДанных.ПерваяПодписьОтчество), Истина));
		СтруктураДанных.Вставить("ВтораяПодписьФИО", КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
			СтруктураДанных.ВтораяПодписьФамилия, СтруктураДанных.ВтораяПодписьИмя, СтруктураДанных.ВтораяПодписьОтчество), Истина));
		
		Если СчетПеревододателяОткрытВСбербанке Тогда
			
			КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Выборка.ОрганКазначейства, Справочники.ВидыКонтактнойИнформации.МеждународныйАдресКазначейства, , Ложь);
			СтруктураДанных.Вставить("АдресКлиента", АдресВФорматеСбербанка(КонтактнаяИнформация));
			
			КонтактнаяИнформация = Новый Структура("КодСтраны, Город, УличныйАдрес",
									Выборка.БанкПолучателяКодСтраны, Выборка.БанкПолучателяГород, Выборка.БанкПолучателяУличныйАдрес);
			СтруктураДанных.Вставить("БанкПолучателяАдрес", АдресВФорматеСбербанка(КонтактнаяИнформация));
			
			КонтактнаяИнформация = Новый Структура("КодСтраны, Город, УличныйАдрес",
									Выборка.БанкКорреспондентКодСтраны, Выборка.БанкКорреспондентГород, Выборка.БанкКорреспондентУличныйАдрес);
			СтруктураДанных.Вставить("БанкКорреспондентАдрес", АдресВФорматеСбербанка(КонтактнаяИнформация));
			
			КонтактнаяИнформация = Новый Структура("КодСтраны, Город, УличныйАдрес",
									Выборка.БанкПосредник1КодСтраны, Выборка.БанкПосредник1Город, Выборка.БанкПосредник1УличныйАдрес);
			СтруктураДанных.Вставить("БанкПосредник1Адрес", АдресВФорматеСбербанка(КонтактнаяИнформация));
			
			КонтактнаяИнформация = Новый Структура("КодСтраны, Город, УличныйАдрес",
									Выборка.БанкПосредник2КодСтраны, Выборка.БанкПосредник2Город, Выборка.БанкПосредник2УличныйАдрес);
			СтруктураДанных.Вставить("БанкПосредник2Адрес", АдресВФорматеСбербанка(КонтактнаяИнформация));
			
			КонтактнаяИнформация = Новый Структура("КодСтраны, Город, УличныйАдрес",
									Выборка.БанкПосредник3КодСтраны, Выборка.БанкПосредник3Город, Выборка.БанкПосредник3УличныйАдрес);
			СтруктураДанных.Вставить("БанкПосредник3Адрес", АдресВФорматеСбербанка(КонтактнаяИнформация));
			
		Иначе
			СтруктураДанных.Вставить("АдресКлиента", УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
				Выборка.ОрганКазначейства, Справочники.ВидыКонтактнойИнформации.МеждународныйАдресКазначейства));
				
			СтруктураДанных.Вставить("БанкПолучателяАдрес",
				Выборка.БанкПолучателяГород + ?(ЗначениеЗаполнено(Выборка.БанкПолучателяУличныйАдрес), ", " + Выборка.БанкПолучателяУличныйАдрес, ""));
			СтруктураДанных.Вставить("БанкКорреспондентАдрес",
				Выборка.БанкКорреспондентГород + ?(ЗначениеЗаполнено(Выборка.БанкКорреспондентУличныйАдрес), ", " + Выборка.БанкКорреспондентУличныйАдрес, ""));
			СтруктураДанных.Вставить("БанкПосредник1Адрес",
				Выборка.БанкПосредник1Город + ?(ЗначениеЗаполнено(Выборка.БанкПосредник1УличныйАдрес), ", " + Выборка.БанкПосредник1УличныйАдрес, ""));
			СтруктураДанных.Вставить("БанкПосредник2Адрес",
				Выборка.БанкПосредник2Город + ?(ЗначениеЗаполнено(Выборка.БанкПосредник2УличныйАдрес), ", " + Выборка.БанкПосредник2УличныйАдрес, ""));
			СтруктураДанных.Вставить("БанкПосредник3Адрес",
				Выборка.БанкПосредник3Город + ?(ЗначениеЗаполнено(Выборка.БанкПосредник3УличныйАдрес), ", " + Выборка.БанкПосредник3УличныйАдрес, ""));
			
		КонецЕсли;
			
		Если Выборка.ТипОперации = 0 Тогда
			
			СтруктураДанных.Вставить("КодПокупаемойВалюты", Выборка.ВалютаДокументаКод);
			СтруктураДанных.Вставить("СуммаПокупаемойВалютыЦифрами", Выборка.СуммаДокументаВВалюте);
			СтруктураДанных.Вставить("СуммаПокупаемойВалютыПрописью", РаботаСКурсамиВалют.СформироватьСуммуПрописью(
				Выборка.СуммаДокументаВВалюте, Выборка.ВалютаДокумента));
			СтруктураДанных.Вставить("НомерСчетаПокупаемойВалюты", Выборка.ЛицевойСчетПБСНомер);
			
			СтруктураДанных.Вставить("КодПродаваемойВалюты", Выборка.ПродаваемаяВалютаКод);
			СтруктураДанных.Вставить("СуммаПродаваемойВалютыЦифрами", Выборка.СуммаПродаваемойВалюты);
			СтруктураДанных.Вставить("СуммаПродаваемойВалютыПрописью", РаботаСКурсамиВалют.СформироватьСуммуПрописью(
				Выборка.СуммаПродаваемойВалюты, Выборка.ПродаваемаяВалюта));
			СтруктураДанных.Вставить("НомерСчетаПродаваемойВалюты", Выборка.ЛицевойСчетНомер);
			
			//незаполненные реквизиты
			СтруктураДанных.Вставить("КодВалюты");
			СтруктураДанных.Вставить("СуммаЦифрами");
			СтруктураДанных.Вставить("СуммаПрописью");
			СтруктураДанных.Вставить("НомерСчетаПеревододателя");
			СтруктураДанных.Вставить("АдресПолучателя");
			СтруктураДанных.Вставить("БанкПолучателяНаименованиеБИК");
			СтруктураДанных.Вставить("БанкКорреспондентНаименованиеБИК");
			СтруктураДанных.Вставить("БанкПосредник1НаименованиеБИК");
			СтруктураДанных.Вставить("БанкПосредник2НаименованиеБИК");
			СтруктураДанных.Вставить("БанкПосредник3НаименованиеБИК");
			
		Иначе
			
			СтруктураДанных.Вставить("КодВалюты", Выборка.ВалютаДокументаКод);
			СтруктураДанных.Вставить("СуммаЦифрами", Выборка.СуммаДокументаВВалюте);
			СтруктураДанных.Вставить("СуммаПрописью", РаботаСКурсамиВалют.СформироватьСуммуПрописью(
				Выборка.СуммаДокументаВВалюте, Выборка.ВалютаДокумента));
			
			СтруктураДанных.Вставить("НомерСчетаПеревододателя", Выборка.ЛицевойСчетНомер);
			
			Если Выборка.ПереводСебеКакПБС Тогда
				
				Если СчетПеревододателяОткрытВСбербанке Тогда
					КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
						Выборка.Организация, Справочники.ВидыКонтактнойИнформации.МеждународныйАдресОрганизации, , Ложь);
					СтруктураДанных.Вставить("АдресПолучателя", АдресВФорматеСбербанка(КонтактнаяИнформация));
				Иначе
					СтруктураДанных.Вставить("АдресПолучателя", УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
						Выборка.Организация, Справочники.ВидыКонтактнойИнформации.МеждународныйАдресОрганизации));
				КонецЕсли;
				
			Иначе
				
				Если СчетПеревододателяОткрытВСбербанке Тогда
					КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
						Выборка.ПолучательЮридическоеФизическоеЛицо, Справочники.ВидыКонтактнойИнформации.МеждународныйАдресКонтрагенты, , Ложь);
					СтруктураДанных.Вставить("АдресПолучателя", АдресВФорматеСбербанка(КонтактнаяИнформация));
				Иначе
					СтруктураДанных.Вставить("АдресПолучателя", УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
						Выборка.ПолучательЮридическоеФизическоеЛицо, Справочники.ВидыКонтактнойИнформации.МеждународныйАдресКонтрагенты));
				КонецЕсли;
				
			КонецЕсли;
			
			СтруктураДанных.Вставить("БанкПолучателяНаименованиеБИК",
				Выборка.БанкПолучателяНаименование + ?(ЗначениеЗаполнено(Выборка.БанкПолучателяКод), ", " + Выборка.БанкПолучателяКод, ""));
			СтруктураДанных.Вставить("БанкКорреспондентНаименованиеБИК",
				Выборка.БанкКорреспондентНаименование + ?(ЗначениеЗаполнено(Выборка.БанкКорреспондентКод), ", " + Выборка.БанкКорреспондентКод, ""));
			СтруктураДанных.Вставить("БанкПосредник1НаименованиеБИК",
				Выборка.БанкПосредник1Наименование + ?(ЗначениеЗаполнено(Выборка.БанкПосредник1Код), ", " + Выборка.БанкПосредник1Код, ""));
			СтруктураДанных.Вставить("БанкПосредник2НаименованиеБИК",
				Выборка.БанкПосредник2Наименование + ?(ЗначениеЗаполнено(Выборка.БанкПосредник2Код), ", " + Выборка.БанкПосредник2Код, ""));
			СтруктураДанных.Вставить("БанкПосредник3НаименованиеБИК",
				Выборка.БанкПосредник3Наименование + ?(ЗначениеЗаполнено(Выборка.БанкПосредник3Код), ", " + Выборка.БанкПосредник3Код, ""));
			
			//незаполненные реквизиты
			СтруктураДанных.Вставить("КодПокупаемойВалюты");
			СтруктураДанных.Вставить("СуммаПокупаемойВалютыЦифрами");
			СтруктураДанных.Вставить("СуммаПокупаемойВалютыПрописью");
			СтруктураДанных.Вставить("НомерСчетаПокупаемойВалюты");
			СтруктураДанных.Вставить("КодПродаваемойВалюты");
			СтруктураДанных.Вставить("СуммаПродаваемойВалютыЦифрами");
			СтруктураДанных.Вставить("СуммаПродаваемойВалютыПрописью");
			СтруктураДанных.Вставить("НомерСчетаПродаваемойВалюты");
			
		КонецЕсли;
		
		СтруктураДанных.РасшифровкаПлатежа = РасшифровкаПлатежа.Скопировать(Новый Структура("Ссылка", Выборка.Ссылка));
		
		МассивСтруктурДанных.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Возврат МассивСтруктурДанных;
	
КонецФункции

Функция ЗначенияРеквизитовПереченьНПАОснованийВР(МассивОбъектов) Экспорт
		
	МассивСтруктурДанных = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);

	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПереченьНПАОснованийВР.Руководитель,
	|	ПереченьНПАОснованийВР.Дата
	|ПОМЕСТИТЬ ПодписиИДаты
	|ИЗ
	|	Документ.ПереченьНПАОснованийВР КАК ПереченьНПАОснованийВР
	|ГДЕ
	|	ПереченьНПАОснованийВР.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РуководительФИО.Руководитель,
	|	РуководительФИО.Дата,
	|	ФИОФизическихЛиц.Фамилия,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество
	|ПОМЕСТИТЬ РуководительФИО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПодписиИДаты.Руководитель КАК Руководитель,
	|		ПодписиИДаты.Дата КАК Дата,
	|		ПодписиИДаты.Руководитель.Контрагент.ЮридическоеФизическоеЛицо КАК ФизЛицо,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК Период
	|	ИЗ
	|		ПодписиИДаты КАК ПодписиИДаты
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО ПодписиИДаты.Руководитель.Контрагент.ЮридическоеФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|				И (ФИОФизическихЛиц.Период <= ПодписиИДаты.Дата)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ПодписиИДаты.Руководитель,
	|		ПодписиИДаты.Руководитель.Контрагент.ЮридическоеФизическоеЛицо,
	|		ПодписиИДаты.Дата) КАК РуководительФИО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО РуководительФИО.Период = ФИОФизическихЛиц.Период
	|			И РуководительФИО.ФизЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	РуководительФИО.Руководитель,
	|	РуководительФИО.Дата,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество,
	|	ФИОФизическихЛиц.Фамилия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПереченьНПАОснованийВР.Ссылка КАК Ссылка,
	|	ПереченьНПАОснованийВР.Номер КАК НомерДок,
	|	ПереченьНПАОснованийВР.Дата КАК ДатаДок,
	|	ПереченьНПАОснованийВР.Организация КАК Организация,
	|	ПереченьНПАОснованийВР.Руководитель КАК Руководитель,
	|	ПереченьНПАОснованийВР.Организация.НаименованиеПолное КАК НаименованиеОрганизации,
	|	ПереченьНПАОснованийВР.Организация.НаименованиеСокращенное КАК НаименованиеОрганизацииСокращенное,
	|	ФИОРуководитель.Фамилия КАК РуководительФамилия,
	|	ФИОРуководитель.Имя КАК РуководительИмя,
	|	ФИОРуководитель.Отчество КАК РуководительОтчество
	|ИЗ
	|	Документ.ПереченьНПАОснованийВР КАК ПереченьНПАОснованийВР
	|		ЛЕВОЕ СОЕДИНЕНИЕ РуководительФИО КАК ФИОРуководитель
	|		ПО ПереченьНПАОснованийВР.Руководитель = ФИОРуководитель.Руководитель
	|			И ПереченьНПАОснованийВР.Дата = ФИОРуководитель.Дата
	|ГДЕ
	|	ПереченьНПАОснованийВР.Ссылка В(&МассивОбъектов);
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПереченьНПАОснованийВРПереченьНПА.Ссылка КАК Ссылка,
	|	ПереченьНПАОснованийВРПереченьНПА.НомерСтроки КАК НомерСтроки,
	|	ПереченьНПАОснованийВРПереченьНПА.НПА.НаменованиеФЗ КАК НПАНаменованиеФЗ,
	|	ПереченьНПАОснованийВРПереченьНПА.НПА.НомерФЗ КАК НПАНомерФЗ,
	|	ПереченьНПАОснованийВРПереченьНПА.НПА.ДатаФЗ КАК НПАДатаФЗ,
	|	ПереченьНПАОснованийВРПереченьНПА.НПА.НаменованиеНПА КАК НПАНаменованиеНПА,
	|	ПереченьНПАОснованийВРПереченьНПА.НПА.НомерНПА КАК НПАНомерНПА,
	|	ПереченьНПАОснованийВРПереченьНПА.НПА.ДатаНПА КАК НПАДатаНПА,
	|	ПереченьНПАОснованийВРПереченьНПА.ВидОбязательства.Наименование КАК ВидДенежныхСредств,
	|	ПереченьНПАОснованийВРПереченьНПА.НаправлениеРасходования КАК НаправлениеРасходования,
	|   Неопределено КАК ФедеральныйЗакон,
	|   Неопределено КАК НормативныйАкт,
	|   Неопределено КАК НаправлениеРасхдованияСредств,
	|   Неопределено КАК АналитическийКод
	|ИЗ
	|	Документ.ПереченьНПАОснованийВР.ПереченьНПА КАК ПереченьНПАОснованийВРПереченьНПА
	|ГДЕ
	|	ПереченьНПАОснованийВРПереченьНПА.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	// 0 ПодписиИДаты
	// 1 РуководительФИО
	// 2 ПереченьНПАОснованийВР
	// 3 ПереченьНПАОснованийВРПереченьНПА
	
	Выборка 		= МассивРезультатов[2].Выбрать();	
	ПереченьНПА 	= МассивРезультатов[3].Выгрузить();

	Пока Выборка.Следующий() Цикл
		
		СтруктураДанных = Новый Структура; // ("ПереченьНПА", Новый ТаблицаЗначений);
		
		Для Каждого Колонка ИЗ МассивРезультатов[2].Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);	
		КонецЦикла;
		
		// для печати даты в виде "__" ________ 20__ г.
		СтруктураДаты = РазложитьДатуДляПечати(Выборка.ДатаДок);
        СтруктураДанных.Вставить("ЧислоДаты", 			СтруктураДаты.Число);	
		СтруктураДанных.Вставить("МесяцДаты", 			СтруктураДаты.Месяц);
		СтруктураДанных.Вставить("ГодДаты", 			СтруктураДаты.Год);
		
		// реквизиты, требующие преобразования
		СтруктураДанных.Вставить("НомерДокумента", 	ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Выборка.Ссылка, СтруктураДанных.НомерДок));
		СтруктураДанных.Вставить("НаименованиеОрганизацииРП", СклонениеПредставленийОбъектов.ПросклонятьПредставление(СтруктураДанных.НаименованиеОрганизации, 2, СтруктураДанных.Ссылка));
		СтруктураДанных.Вставить("НаименованиеОрганизацииСокращенноеРП", СклонениеПредставленийОбъектов.ПросклонятьПредставление(СтруктураДанных.НаименованиеОрганизацииСокращенное, 2, СтруктураДанных.Ссылка));

		СтруктураДанных.Вставить("РуководительФИО", 
		СокрЛП(СтруктураДанных.РуководительФамилия) + " " +
		СокрЛП(СтруктураДанных.РуководительИмя) + " " +
		СокрЛП(СтруктураДанных.РуководительОтчество));
		
		СтруктураДанных.Вставить("РуководительФамилияИнициалы",
		КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", 
		СтруктураДанных.РуководительФамилия, 
		СтруктураДанных.РуководительИмя, 
		СтруктураДанных.РуководительОтчество)));
		
		ВыборкаПереченьНПА = ПереченьНПА.Скопировать(Новый Структура("Ссылка", Выборка.Ссылка));
		
		Для Каждого Стр Из ВыборкаПереченьНПА Цикл
			
			Стр.ФедеральныйЗакон = Стр.НПАНаменованиеФЗ +
			?(ЗначениеЗаполнено(Стр.НПАНомерФЗ), ", " + Стр.НПАНомерФЗ, "") +
			?(ЗначениеЗаполнено(Стр.НПАДатаФЗ), ", " + Формат(Стр.НПАДатаФЗ, "ДФ=dd.MM.yyyy"), "");
			
			Стр.НормативныйАкт = Стр.НПАНаменованиеНПА +
			?(ЗначениеЗаполнено(Стр.НПАНомерНПА), ", " + Стр.НПАНомерНПА, "") +
			?(ЗначениеЗаполнено(Стр.НПАДатаНПА), ", " + Формат(Стр.НПАДатаНПА, "ДФ=dd.MM.yyyy"), "");
			
			Стр.НаправлениеРасхдованияСредств = Сред(Стр.НаправлениеРасходования, 6);
			
			Стр.АналитическийКод = Лев(Стр.НаправлениеРасходования, 2);
			
		КонецЦикла;	

		ВыборкаПереченьНПА.Сортировать("НомерСтроки");
		
		СтруктураДанных.Вставить("ПереченьНПА", ВыборкаПереченьНПА);
		
		МассивСтруктурДанных.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Возврат МассивСтруктурДанных;
	
КонецФункции	

Функция ЗначенияРеквизитовСведенияОбОперацияхСоСредствамиВР(МассивОбъектов) Экспорт
	
	МассивСтруктурДанных = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);

	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СведенияОбОперацияхСоСредствамиВР.Руководитель,
	|	СведенияОбОперацияхСоСредствамиВР.Дата
	|ПОМЕСТИТЬ ПодписиИДаты
	|ИЗ
	|	Документ.СведенияОбОперацияхСоСредствамиВР КАК СведенияОбОперацияхСоСредствамиВР
	|ГДЕ
	|	СведенияОбОперацияхСоСредствамиВР.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РуководительФИО.Руководитель,
	|	РуководительФИО.Дата,
	|	ФИОФизическихЛиц.Фамилия,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество
	|ПОМЕСТИТЬ РуководительФИО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПодписиИДаты.Руководитель КАК Руководитель,
	|		ПодписиИДаты.Дата КАК Дата,
	|		ПодписиИДаты.Руководитель.Контрагент.ЮридическоеФизическоеЛицо КАК ФизЛицо,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК Период
	|	ИЗ
	|		ПодписиИДаты КАК ПодписиИДаты
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО ПодписиИДаты.Руководитель.Контрагент.ЮридическоеФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|				И (ФИОФизическихЛиц.Период <= ПодписиИДаты.Дата)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ПодписиИДаты.Руководитель,
	|		ПодписиИДаты.Руководитель.Контрагент.ЮридическоеФизическоеЛицо,
	|		ПодписиИДаты.Дата) КАК РуководительФИО
