// Расчеты с подотчетниками - таблица корректировки денежных обязательств
//
Функция АвансовыйОтчет_ТаблицаКорректировкиДенежныхОбязательств(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		Возврат Новый Массив;
		
	КонецЕсли;
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПоляФункции = Новый Массив;
	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Обязательство", 	Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "РазделЛицСчета", 	Новый ОписаниеТипов("СправочникСсылка.РазделыЛицевыхСчетов"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КФО", 				Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КПС", 				Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов")); 
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КЭК", 				Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ДопКлассификация",	Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КодМероприятия",	Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КодЦели",			Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Валюта",			Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Сумма", 			ОписаниеТипаСуммы);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СуммаВВалюте", 		ОписаниеТипаСуммы);
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);
	
	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	
	ЗаявлениеНаВыдачуАванса = РеквизитыДокумента.ЗаявлениеНаВыдачуАванса;
	
	Если ЗначениеЗаполнено(ЗаявлениеНаВыдачуАванса) Тогда
		РеквизитыЗаявления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ЗаявлениеНаВыдачуАванса, "ОснованиеПринятияОбязательства, РазделЛицевогоСчета");
		Обязательство = РеквизитыЗаявления.ОснованиеПринятияОбязательства;
		РазделЛицСчета = РеквизитыЗаявления.РазделЛицевогоСчета;
	Иначе
		Обязательство = РеквизитыДокумента.ОснованиеПринятияОбязательства;
		РазделЛицСчета = РеквизитыДокумента.РазделЛицевогоСчета;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Обязательство) Тогда
		Возврат ТаблицаРезультат;
	КонецЕсли;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка", РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("ЗаявлениеНаВыдачуАванса", ЗаявлениеНаВыдачуАванса);
	Реквизиты.Вставить("Обязательство", Обязательство);
	Реквизиты.Вставить("РазделЛицСчета", РазделЛицСчета);
	Реквизиты.Вставить("Дата", РеквизитыДокумента.Дата);
	Реквизиты.Вставить("Организация", РеквизитыДокумента.Организация);
	
	ТаблицаРезультат = РасчетыСПодотчетнымиЛицами.ТаблицаДенежныхОбязательствПоТЧАвансовогоОтчета(Реквизиты);
	
	Если ТаблицаРезультат.Количество() = 0 Тогда
		
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
		
		РасходыПоАвансовомуОтчету = ?(ДополнительныеСвойства.Свойство("РасходыПоАвансовомуОтчету"),
			ДополнительныеСвойства.РасходыПоАвансовомуОтчету,
			РасчетыСПодотчетнымиЛицами.ПустаяТаблицаРасходовПоАвансовомуОтчету());
			
		ТаблицаРезультат = РасчетыСПодотчетнымиЛицами.ТаблицаКорректировкиДенежныхОбязательствПоАвансовомуОтчету(
			Реквизиты, РасходыПоАвансовомуОтчету);
		
	КонецЕсли;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаКорректировкиДенежныхОбязательств", ТаблицаРезультат.Скопировать());
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаРезультат;
	
КонецФункции

// Фондовая касса - поступление денежных документов с постоплатой
//
Функция ФондоваяКассаПринятыеДенежныеОбязательства(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ПриниматьДенежныеОбязательства", Новый ОписаниеТипов("Булево"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;

	ПоляФункции = Новый Массив;
	
	ТаблицаДенежныеОбязательства = УчетРасчетов.ПустаяТаблицаПринятыеДенежныеОбязательства();
	
	Для Каждого Колонка Из ТаблицаДенежныеОбязательства.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;                                                                                             
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Отказ = Ложь;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	Если НЕ Параметры.Свойство("ПриниматьДенежныеОбязательства")
	 ИЛИ НЕ Параметры.ПриниматьДенежныеОбязательства Тогда
		Возврат ТаблицаДенежныеОбязательства;
	КонецЕсли;
	
	Если ИсточникиДанных.Свойство("ДенежныеОбязательства")
		И ТипЗнч(ИсточникиДанных.ДенежныеОбязательства) = Тип("ТаблицаЗначений")
		И ИсточникиДанных.ДенежныеОбязательства.Количество() > 0 Тогда
		Возврат ТаблицаДенежныеОбязательства;
	КонецЕсли;
		
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	
	ТаблицаРасчетовСЗачетомАвансов = ?(ДополнительныеСвойства.Свойство("ТаблицаРасчетовСЗачетомАвансов"),
		ДополнительныеСвойства.ТаблицаРасчетовСЗачетомАвансов,
		УчетРасчетов.ПустаяТаблицаРасчетовСЗачетомАвансов());
		
	ТаблицыПоступления = Новый Структура;
	

	ТаблицаДенежныеОбязательства = УчетРасчетов.ТаблицаПринятыеДенежныеОбязательства(
		ТаблицаРасчетовСЗачетомАвансов,
		ТаблицыПоступления,
		Реквизиты,
		Отказ);
	
	Возврат ТаблицаДенежныеОбязательства;

КонецФункции	

// Отложенные обязательства для корректировки.
// 
// Параметры: См. ТестоваяФункцияСПараметром
//  ВариантВызова - см. ТестоваяФункцияСПараметром.ВариантВызова
//  ИсточникиДанных - см. ТестоваяФункцияСПараметром.ИсточникиДанных
//  ТиповаяОперация - см. ТестоваяФункцияСПараметром.ТиповаяОперация
//  Параметры - см. ТестоваяФункцияСПараметром.Параметры
// 
// Возвращаемое значение:
//  см. Документы.АктПриемкиТоваровРаботУслуг.ПустаяТаблицаКорректировкиОтложенныхОбязательств
Функция ОтложенныеОбязательстваДляКорректировки(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СкорректироватьОтложенныеОбязательства", Новый ОписаниеТипов("Булево"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ЧастичнаяПриемка", Новый ОписаниеТипов("Булево"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "РазделЛицевогоСчета", Новый ОписаниеТипов("СправочникСсылка.РазделыЛицевыхСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Резерв", Новый ОписаниеТипов("СправочникСсылка.Резервы"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетРезерва", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		ПоляФункции = Новый Массив;
		ТаблицаКорректировки = Документы.АктПриемкиТоваровРаботУслуг.ПустаяТаблицаКорректировкиОтложенныхОбязательств();
		Для Каждого Колонка Из ТаблицаКорректировки.Колонки Цикл
			ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
		КонецЦикла;
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;

	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	Отказ = Ложь;
	ТаблицаКорректировки = Документы.АктПриемкиТоваровРаботУслуг.ТаблицаКорректировкиОтложенныхОбязательств(
		Реквизиты,
		Отказ);
	Если Отказ Тогда
		// Сохраним полученный Отказ.
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		КонтекстПроведения.Отказ = Отказ;
		БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	КонецЕсли;

	Возврат ТаблицаКорректировки;
	
КонецФункции

// Остатки резервов для корректировки.
// 
// Параметры: См. ТестоваяФункцияСПараметром
//  ВариантВызова - см. ТестоваяФункцияСПараметром.ВариантВызова
//  ИсточникиДанных - см. ТестоваяФункцияСПараметром.ИсточникиДанных
//  ТиповаяОперация - см. ТестоваяФункцияСПараметром.ТиповаяОперация
//  Параметры - см. ТестоваяФункцияСПараметром.Параметры
// 
// Возвращаемое значение:
//  см. Документы.АктПриемкиТоваровРаботУслуг.ПустаяТаблицаКорректировкиРезервов
Функция ОстаткиРезервовДляКорректировки(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ЧастичнаяПриемка", Новый ОписаниеТипов("Булево"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Резерв", Новый ОписаниеТипов("СправочникСсылка.Резервы"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетРезерва", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПСРезерва", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		ПоляФункции = Новый Массив;
		ТаблицаКорректировки = Документы.АктПриемкиТоваровРаботУслуг.ПустаяТаблицаКорректировкиРезервов();
		Для Каждого Колонка Из ТаблицаКорректировки.Колонки Цикл
			ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
		КонецЦикла;
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;

	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	Отказ = Ложь;
	ТаблицаКорректировки = Документы.АктПриемкиТоваровРаботУслуг.ТаблицаКорректировкиРезервов(
		Реквизиты,
		Отказ);
	Если Отказ Тогда
		// Сохраним полученный Отказ.
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		КонтекстПроведения.Отказ = Отказ;
		БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	КонецЕсли;

	Возврат ТаблицаКорректировки;
	
КонецФункции

#КонецОбласти

#Область НДС

Функция ТаблицаАннулированияСчетаФактуры(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		
		ТипСчетФактура = Новый ОписаниеТипов("ДокументСсылка.СчетФактураВыданный,
			|ДокументСсылка.СчетФактураПолученный,
			|ДокументСсылка.ИсправительныйСчетФактураВыданный,
			|ДокументСсылка.ИсправительныйСчетФактураПолученный,
			|ДокументСсылка.КорректировочныйСчетФактураВыданный,
			|ДокументСсылка.КорректировочныйСчетФактураПолученный,
			|ДокументСсылка.ГТДИмпорт");
		
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетФактура", ТипСчетФактура);
		
		Возврат ПараметрыФункции;
	КонецЕсли;
	
	// Поля - все колонки из проводок:
	ПоляФункции = Новый Массив;
	ТипСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ПустаяТаблица = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	Для Каждого Колонка Из ПустаяТаблица.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		Если ВРег(Лев(ИмяКолонки, 8)) = ВРег("Субконто") Тогда
			ТипЗначенияКолонки = ТипСубконто;
		Иначе
			ТипЗначенияКолонки = Колонка.ТипЗначения
		КонецЕсли;
		ДобавитьПолеРезультатаФункции(ПоляФункции, ИмяКолонки, ТипЗначенияКолонки);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;	
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);
	
	// Заполняем возвращаемую таблицу значений:
	КонтекстПроведения			= БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ПроводимыйДокументСсылка	= КонтекстПроведения.Ссылка;
	ШапкаДокумента				= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПроводимыйДокументСсылка, "Ссылка,Дата,ДопЛист,КорректируемыйПериод");
	
	ЗапросПроводки = Новый Запрос();
	ЗапросПроводки.УстановитьПараметр("СчетФактураСсылка",			Параметры["СчетФактура"]);
	ЗапросПроводки.УстановитьПараметр("ПроводимыйДокументСсылка",	ПроводимыйДокументСсылка);
	ЗапросПроводки.Текст = "
	|ВЫБРАТЬ
	|	*,
	|	// Инвертируем значения ресурсов:
	|	-Сумма					КАК Сумма,
	|	-ВалютнаяСуммаДт		КАК ВалютнаяСуммаДт,
	|	-ВалютнаяСуммаКт		КАК ВалютнаяСуммаКт,
	|	-КоличествоДт			КАК КоличествоДт,
	|	-КоличествоКт			КАК КоличествоКт,
	|	-СуммаНеУчитываетсяНУ	КАК СуммаНеУчитываетсяНУ,
	|	-СуммаЕНВД				КАК СуммаЕНВД,
	|	-СуммаНДС				КАК СуммаНДС
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		Регистратор = &СчетФактураСсылка
	|		И	Активность = Истина
	|	)";
	
	ВыборкаПроводки = ЗапросПроводки.Выполнить().Выбрать();
	
	Пока ВыборкаПроводки.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПроводки);
		НоваяСтрока["Период"] = ШапкаДокумента["Дата"];
	КонецЦикла;
	
	Возврат ТаблицаРезультат;		
	
КонецФункции

Функция ТаблицаАннулированияСчетаФактуры_РегистрацияСтрокиКнигиПродаж(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		
		ТипСчетФактура = Новый ОписаниеТипов("ДокументСсылка.СчетФактураВыданный,
			|ДокументСсылка.СчетФактураПолученный,
			|ДокументСсылка.ИсправительныйСчетФактураВыданный,
			|ДокументСсылка.ИсправительныйСчетФактураПолученный,
			|ДокументСсылка.КорректировочныйСчетФактураВыданный,
			|ДокументСсылка.КорректировочныйСчетФактураПолученный,
			|ДокументСсылка.РегистрацияСтрокиКнигиПродаж");
		
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетФактура", ТипСчетФактура);
		
		Возврат ПараметрыФункции;
	КонецЕсли;
	
	// Поля - все колонки из проводок:
	ПоляФункции = Новый Массив;
	ТипСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ПустаяТаблица = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	Для Каждого Колонка Из ПустаяТаблица.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		Если ВРег(Лев(ИмяКолонки, 8)) = ВРег("Субконто") Тогда
			ТипЗначенияКолонки = ТипСубконто;
		Иначе
			ТипЗначенияКолонки = Колонка.ТипЗначения
		КонецЕсли;
		ДобавитьПолеРезультатаФункции(ПоляФункции, ИмяКолонки, ТипЗначенияКолонки);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;	
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);
	
	// Заполняем возвращаемую таблицу значений:
	КонтекстПроведения			= БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ПроводимыйДокументСсылка	= КонтекстПроведения.Ссылка;
	ШапкаДокумента				= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПроводимыйДокументСсылка, "Ссылка,Дата,ДопЛист,КорректируемыйПериод");
	
	ЗапросПроводки = Новый Запрос();
	ЗапросПроводки.УстановитьПараметр("СчетФактураСсылка",			Параметры["СчетФактура"]);
	ЗапросПроводки.УстановитьПараметр("ПроводимыйДокументСсылка",	ПроводимыйДокументСсылка);
	ЗапросПроводки.Текст = "
	|ВЫБРАТЬ
	|	*,
	|	// Инвертируем значения ресурсов:
	|	-Сумма					КАК Сумма,
	|	-ВалютнаяСуммаДт		КАК ВалютнаяСуммаДт,
	|	-ВалютнаяСуммаКт		КАК ВалютнаяСуммаКт,
	|	-КоличествоДт			КАК КоличествоДт,
	|	-КоличествоКт			КАК КоличествоКт,
	|	-СуммаНеУчитываетсяНУ	КАК СуммаНеУчитываетсяНУ,
	|	-СуммаЕНВД				КАК СуммаЕНВД,
	|	-СуммаНДС				КАК СуммаНДС
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		Регистратор = &СчетФактураСсылка
	|		И	Активность = Истина
	|	)";
	
	ВыборкаПроводки = ЗапросПроводки.Выполнить().Выбрать();
	
	Пока ВыборкаПроводки.Следующий() Цикл
		НоваяСтрока = ТаблицаРезультат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПроводки);
		НоваяСтрока["Период"] = ШапкаДокумента["Дата"];
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти

#Область ВводОстатков

Функция ВводОстатковМатериалы106хП(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		
		Возврат ПараметрыФункции;
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Номенклатура",	Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ВидЗатрат",		Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ЦМО",			Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СчетДт",		Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СчетНУ",		Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КПСДт",			Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КЭКДт",			Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КоличествоДт",	ОбщегоНазначения.ОписаниеТипаЧисло(15,3,ДопустимыйЗнак.Неотрицательный));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Сумма",			ОбщегоНазначения.ОписаниеТипаЧисло(15,2,ДопустимыйЗнак.Любой));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СуммаНУ",		ОбщегоНазначения.ОписаниеТипаЧисло(15,2,ДопустимыйЗнак.Любой));
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ШапкаДокумента = РеквизитыДокумента(ИсточникиДанных);
	
	ЗапросИсточник = Новый Запрос();
	ЗапросИсточник.УстановитьПараметр("ДокСсылка",			ШапкаДокумента.Ссылка);
	ЗапросИсточник.УстановитьПараметр("ОтражатьВБухУчете",	ШапкаДокумента.ОтражатьВБухгалтерскомУчете);
	ЗапросИсточник.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Табличная часть Материалы106хП
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки		КАК НомерСтроки,
	|	КЭК				КАК КЭК,
	|	Количество		КАК Количество,
	|	СчетНУ			КАК СчетНУ,
	|	
	|	// Поля связи
	|	Номенклатура	КАК Номенклатура,
	|	Счет			КАК Счет,
	|	КПС				КАК КПС
	|ПОМЕСТИТЬ
	|	ТаблЧастьМатериалы106хП
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Материалы106хП
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|ИНДЕКСИРОВАТЬ ПО
	|	// Поля связи
	|	Номенклатура,
	|	Счет,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Табличная часть Затраты106хП
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки		КАК НомерСтроки,
	|	ВидЗатрат		КАК ВидЗатрат,
	|	ЦМО				КАК ЦМО,
	|	Сумма			КАК Сумма,
	|	СуммаНУ			КАК СуммаНУ,
	|	
	|	// Поля связи
	|	Номенклатура	КАК Номенклатура,
	|	Счет			КАК Счет,
	|	КПС				КАК КПС
	|ПОМЕСТИТЬ
	|	ТаблЧастьЗатраты106хП
	|ИЗ
	|	Документ.ВводНачальныхОстатков.Затраты106хП
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|ИНДЕКСИРОВАТЬ ПО
	|	// Поля связи
	|	Номенклатура,
	|	Счет,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Номера первых строк табличной части Затраты106хП
	|//		для каждого ключа связи обеих таблиц.
	|//		Используется для использования поля Количество основной таблицы
	|//		в проводках только 1 раз, а не по количеству строк зависимой таблицы.
	|//
	|ВЫБРАТЬ
	|	МИНИМУМ(НомерСтроки)	КАК НомерСтроки
	|ПОМЕСТИТЬ
	|	ТаблЧастьЗатраты106хП_НомераПервыхСтрок
	|ИЗ
	|	ТаблЧастьЗатраты106хП	КАК Затраты
	|СГРУППИРОВАТЬ ПО
	|	// Поля связи
	|	Номенклатура,
	|	Счет,
	|	// Поле КПС используется только при бух.учете
	|	ВЫБОР
	|		КОГДА &ОтражатьВБухУчете = ИСТИНА ТОГДА
	|			КПС
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Искомая таблица для дальнейшего формирования проводок
	|//
	|ВЫБРАТЬ
	|	Материалы.Номенклатура						КАК Номенклатура,
	|	Затраты.ВидЗатрат							КАК ВидЗатрат,
	|	Затраты.ЦМО									КАК ЦМО,
	|	
	|	// Дебет
	|	Материалы.Счет								КАК СчетДт,
	|	Материалы.КПС								КАК КПСДт,
	|	Материалы.КЭК								КАК КЭКДт,
	|	// Устанавливаем поле Количество только для первых строк зависимой таблицы Затраты
	|	ВЫБОР
	|		КОГДА НомераПервыхСтрок.НомерСтроки ЕСТЬ NULL ТОГДА
	|			0
	|		ИНАЧЕ
	|			Материалы.Количество			
	|	КОНЕЦ										КАК КоличествоДт,
	|	
	|	Затраты.Сумма								КАК Сумма,
	|	Затраты.СуммаНУ								КАК СуммаНУ,
	|	Материалы.СчетНУ							КАК СчетНУ
	|ИЗ
	|	ТаблЧастьМатериалы106хП КАК Материалы
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблЧастьЗатраты106хП КАК Затраты
	|		// Поля связи
	|		ПО	Материалы.Номенклатура = Затраты.Номенклатура
	|		И	Материалы.Счет = Затраты.Счет
	|		И	Материалы.КПС = Затраты.КПС
	|		// Требование заполненных значений
	|		И	(Затраты.Сумма <> 0 ИЛИ Затраты.СуммаНУ <> 0)
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ТаблЧастьЗатраты106хП_НомераПервыхСтрок	КАК НомераПервыхСтрок
	|		ПО	Затраты.НомерСтроки = НомераПервыхСтрок.НомерСтроки
	|УПОРЯДОЧИТЬ ПО
	|	Материалы.НомерСтроки
	|;";
	
	Возврат ЗапросИсточник.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Область УпрощеннаяСистемаНалогообложения

// Поступление расходов (УСН)

// Базовая функция поступления расходов УСН.
//
Функция ПоступлениеРасходовУСН(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "АвтоОтражениеВУСН", Новый ОписаниеТипов("ПеречислениеСсылка.ОтражениеВУСН"));
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаРасходовУСН = УчетУСН.ПустаяТаблицаПоступлениеРасходовУСН();
	Для Каждого Колонка Из ТаблицаРасходовУСН.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	
	// Поступление расходов будем отражать для всех таблиц поступления (материалов, тары, услуг и пр.),
	// которые сформированы к текущему моменту.
	ТаблицыПоступления = Новый Структура;
	
	Если ДополнительныеСвойства.Свойство("ТаблицаПоступлениеМатериальныхЗапасов") Тогда
		ТаблицыПоступления.Вставить("ПоступлениеМатериальныхЗапасов", ДополнительныеСвойства.ТаблицаПоступлениеМатериальныхЗапасов);
	Иначе
		ТаблицыПоступления.Вставить("ПоступлениеМатериальныхЗапасов", УправлениеМатериальнымиЗапасами.ПустаяТаблицаПоступлениеМатериальныхЗапасов());
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ТаблицаПоступлениеВозвратнойТары") Тогда
		ТаблицыПоступления.Вставить("ПоступлениеВозвратнойТары", ДополнительныеСвойства.ТаблицаПоступлениеВозвратнойТары);
	Иначе
		ТаблицыПоступления.Вставить("ПоступлениеВозвратнойТары", УправлениеМатериальнымиЗапасами.ПустаяТаблицаПоступлениеВозвратнойТары());
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ТаблицаПоступлениеУслугРабот") Тогда
		ТаблицыПоступления.Вставить("ПоступлениеУслугРабот", ДополнительныеСвойства.ТаблицаПоступлениеУслугРабот);
	Иначе
		ТаблицыПоступления.Вставить("ПоступлениеУслугРабот", УчетРасчетов.ПустаяТаблицаПоступлениеУслугРабот());
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ТаблицаПоступлениеДопРасходов") Тогда
