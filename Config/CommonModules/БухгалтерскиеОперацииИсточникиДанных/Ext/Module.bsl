// Накладная на отпуск М-15

Функция НакладнаяНаОтпускМ15_Материалы_ВозвратПоставщику(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		Возврат Новый Массив;
		
	КонецЕсли;
	
	МассивМетаданных = Новый Массив;
	МассивМетаданных.Добавить(Метаданные.Документы.НакладнаяНаОтпускМ15.ТабличныеЧасти.Материалы);
	
	ПересчитываемыеПоля = Новый Массив;
	ПересчитываемыеПоля.Добавить("Всего");
	ПересчитываемыеПоля.Добавить("СуммаНДС");
	
	ПоляФункции = ЗаполнитьПоляФункцииИзОписанияМетаданных(МассивМетаданных, ПересчитываемыеПоля);
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СчетУчетаНУ",              Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	// Поля учетной стоимости материальных запасов.
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Стоимость",                ОписаниеТипаСуммы);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СтоимостьНУ",              ОписаниеТипаСуммы);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СтоимостьНеУчитываетсяНУ", ОписаниеТипаСуммы);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СтоимостьЕНВД",            ОписаниеТипаСуммы);
	// Поля разниц стоимости возврата и учетной стоимости материальных запасов.
	ДобавитьПолеРезультатаФункции(ПоляФункции, "РазницаСтоимости",         ОписаниеТипаСуммы);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "РазницаСтоимостиНУ",       ОписаниеТипаСуммы);
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("ПересчитываемыеПоля", ПересчитываемыеПоля);
	ПараметрыРасчета.Вставить("ИсточникиДанных", ИсточникиДанных);
	ПараметрыРасчета.Вставить("ПоляФункции", ПоляФункции);
	ПараметрыРасчета.Вставить("ИмяТабличнойЧасти", "Материалы");
	
	Возврат ПодготовитьТаблицуНакладнойМ15ДляВозвратаПоставщику(ПараметрыРасчета);
	
КонецФункции

Функция НакладнаяНаОтпускМ15_ВозвратнаяТара_ВозвратПоставщику(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		Возврат Новый Массив;
		
	КонецЕсли;
	
	МассивМетаданных = Новый Массив;
	МассивМетаданных.Добавить(Метаданные.Документы.НакладнаяНаОтпускМ15.ТабличныеЧасти.ВозвратнаяТара);
	
	ПересчитываемыеПоля = Новый Массив;
	ПересчитываемыеПоля.Добавить("Сумма");
	
	ПоляФункции = ЗаполнитьПоляФункцииИзОписанияМетаданных(МассивМетаданных, ПересчитываемыеПоля);
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СчетУчетаНУ",              Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	// Поля учетной стоимости материальных запасов.
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Стоимость",                ОписаниеТипаСуммы);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СтоимостьНУ",              ОписаниеТипаСуммы);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СтоимостьНеУчитываетсяНУ", ОписаниеТипаСуммы);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СтоимостьЕНВД",            ОписаниеТипаСуммы);
	// Поля разниц стоимости возврата и учетной стоимости материальных запасов.
	ДобавитьПолеРезультатаФункции(ПоляФункции, "РазницаСтоимости",         ОписаниеТипаСуммы);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "РазницаСтоимостиНУ",       ОписаниеТипаСуммы);
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("ПересчитываемыеПоля", ПересчитываемыеПоля);
	ПараметрыРасчета.Вставить("ИсточникиДанных", ИсточникиДанных);
	ПараметрыРасчета.Вставить("ПоляФункции", ПоляФункции);
	ПараметрыРасчета.Вставить("ИмяТабличнойЧасти", "ВозвратнаяТара");
	
	Возврат ПодготовитьТаблицуНакладнойМ15ДляВозвратаПоставщику(ПараметрыРасчета);

КонецФункции

Функция ПодготовитьТаблицуНакладнойМ15ДляВозвратаПоставщику(ПараметрыРасчета)
	
	ПересчитываемыеПоля = ПараметрыРасчета.ПересчитываемыеПоля;
	ИсточникиДанных = ПараметрыРасчета.ИсточникиДанных;
	ПоляФункции = ПараметрыРасчета.ПоляФункции;
	ИмяТабличнойЧасти = ПараметрыРасчета.ИмяТабличнойЧасти;
	
	ВычисляемыеПоля = Новый Массив;
	Для каждого ИмяКолонки Из ПересчитываемыеПоля Цикл
		ВычисляемыеПоля.Добавить(ИмяКолонки + "_ВРублях");
	КонецЦикла;
	ВычисляемыеПоля.Добавить("СчетУчетаНУ");
	ВычисляемыеПоля.Добавить("Стоимость");
	ВычисляемыеПоля.Добавить("СтоимостьНУ");
	ВычисляемыеПоля.Добавить("СтоимостьНеУчитываетсяНУ");
	ВычисляемыеПоля.Добавить("СтоимостьЕНВД");
	ВычисляемыеПоля.Добавить("РазницаСтоимости");
	ВычисляемыеПоля.Добавить("РазницаСтоимостиНУ");

	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	СтрДокумента = ИсточникиДанных["Документ"][0];
	ДокументСсылка = СтрДокумента[ПрефиксДокумента + "Ссылка"];
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);

	ПрефиксКолонки = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных(ИмяТабличнойЧасти);
	ПрефиксДопРеквизита = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("ДополнительныйРеквизит");
	
	ПараметрыТекущегоКурса = Новый Структура("Валюта,Курс,Кратность",
		Константы.ВалютаРегламентированногоУчета.Получить(), 1, 1);
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ПараметрыНовогоКурса = Новый Структура("Валюта,Курс,Кратность",
		СтрДокумента[ПрефиксДокумента + "ВалютаДокумента"],
		КонтекстПроведения.Курс,
		КонтекстПроведения.Кратность);
		
	КФОвШапке = ИсточникиДанных["Документ"].Колонки.Найти(ПрефиксДокумента + "КФО") <> Неопределено;
	КФОвТЧ = ИсточникиДанных[ИмяТабличнойЧасти].Колонки.Найти(ПрефиксКолонки + "КФО") <> Неопределено;
	                                                                 
	Для каждого СтрокаТаблицы Из ИсточникиДанных[ИмяТабличнойЧасти] Цикл
		
		НоваяСтрока = ТаблицаРезультат.Добавить();
		
		// Заполняем поля (кроме вычисляемых) из реквизитов источника данных.
		Для каждого ТекПолеФункции Из ПоляФункции Цикл
			Если ВычисляемыеПоля.Найти(ТекПолеФункции.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока[ТекПолеФункции.Имя] = СтрокаТаблицы[ПрефиксКолонки + ТекПолеФункции.Имя];
		КонецЦикла;
		
		// Суммы в рублях.
		Для каждого ПересчитываемоеПоле Из ПересчитываемыеПоля Цикл
		
			НоваяСтрока[ПересчитываемоеПоле + "_ВРублях"] = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СтрокаТаблицы[ПрефиксКолонки + ПересчитываемоеПоле],
					ПараметрыТекущегоКурса, ПараметрыНовогоКурса);
		
		КонецЦикла;
		
		Если КФОвШапке Тогда
			ОтражатьВНалоговомУчете = БухгалтерскиеОперации.ОтражатьВНалоговомУчете(
				СтрДокумента[ПрефиксДокумента + "Организация"], СтрДокумента[ПрефиксДокумента + "Дата"], СтрДокумента[ПрефиксДокумента + "КФО"]);
		ИначеЕсли КФОВТЧ Тогда
			ОтражатьВНалоговомУчете = БухгалтерскиеОперации.ОтражатьВНалоговомУчете(
				СтрДокумента[ПрефиксДокумента + "Организация"], СтрДокумента[ПрефиксДокумента + "Дата"], СтрокаТаблицы[ПрефиксКолонки + "КФО"]);
		Иначе
			ОтражатьВНалоговомУчете = Ложь;
		КонецЕсли;
		// Учетная стоимость материальных запасов
		НоваяСтрока.Стоимость                = БухгалтерскиеОперации.ПолучитьРеквизитСписанияНоменклатуры(
			"Стоимость",                ДокументСсылка, СтрокаТаблицы.НомерСтроки, ИмяТабличнойЧасти, "БУ");
		Если ОтражатьВНалоговомУчете Тогда
		
			НоваяСтрока.СчетУчетаНУ              = БухгалтерскиеОперации.ПолучитьРеквизитСписанияНоменклатуры(
				"СчетУчета",                ДокументСсылка, СтрокаТаблицы.НомерСтроки, ИмяТабличнойЧасти, "НУ");
				
			// Учетная стоимость материальных запасов в НУ
			НоваяСтрока.СтоимостьНУ              = БухгалтерскиеОперации.ПолучитьРеквизитСписанияНоменклатуры(
				"Стоимость",                ДокументСсылка, СтрокаТаблицы.НомерСтроки, ИмяТабличнойЧасти, "НУ");
			НоваяСтрока.СтоимостьНеУчитываетсяНУ = БухгалтерскиеОперации.ПолучитьРеквизитСписанияНоменклатуры(
				"СтоимостьНеУчитываетсяНУ", ДокументСсылка, СтрокаТаблицы.НомерСтроки, ИмяТабличнойЧасти, "НУ");
			НоваяСтрока.СтоимостьЕНВД            = БухгалтерскиеОперации.ПолучитьРеквизитСписанияНоменклатуры(
				"СтоимостьЕНВД",            ДокументСсылка, СтрокаТаблицы.НомерСтроки, ИмяТабличнойЧасти, "НУ");
			
		КонецЕсли;
		
		// Разницы стоимости возврата и учетной стоимости материальных запасов.
		Если ИмяТабличнойЧасти = "Материалы" Тогда
			СтоимостьВозврата = ?(СтрокаТаблицы[ПрефиксДопРеквизита+"ВосстанавливатьНДС"],
					НоваяСтрока.Всего_ВРублях - НоваяСтрока.СуммаНДС_ВРублях,
					НоваяСтрока.Всего_ВРублях);
		Иначе
			СтоимостьВозврата = НоваяСтрока.Сумма_ВРублях;
		КонецЕсли;
		НоваяСтрока.РазницаСтоимости   = НоваяСтрока.Стоимость - СтоимостьВозврата;
		НоваяСтрока.РазницаСтоимостиНУ = (НоваяСтрока.СтоимостьНУ + НоваяСтрока.СтоимостьНеУчитываетсяНУ + НоваяСтрока.СтоимостьЕНВД) - СтоимостьВозврата;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультат;

КонецФункции


// --- Поступление услуг, работ

Функция ТаблицаЗачетаАванса_ПоступлениеУслуг(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры) Экспорт

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		Возврат ОписаниеПараметровДляФункцийПоступленияНФА("ПоступлениеУслуг");
		
	КонецЕсли;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ТаблицаЗачетаАванса_Основная(ВариантВызова, ИсточникиДанных, Неопределено, Неопределено);
	КонецЕсли;		
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДокументСсылка = КонтекстПроведения.Ссылка;
	ТипЗначенияСсылки = ТипЗнч(ДокументСсылка);
	
	ПараметрыРасчетаАванса = СтруктураПараметровДляЗачетаАвансов(Параметры);
	
	ТаблицаРасчетов = ТаблицаРасчетовДляЗачетаАвансов(КонтекстПроведения, ИсточникиДанных, ПараметрыРасчетаАванса);

	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	СтрокаДокумента = ИсточникиДанных["Документ"][0];
	ТекущийКонтекст = Новый Структура;
	ТекущийКонтекст.Вставить("Период", ?(ДокументСсылка.Пустая(), СтрокаДокумента[ПрефиксДокумента + "Дата"], ДокументСсылка));
	ТекущийКонтекст.Вставить("ТаблицаРасчетов", ТаблицаРасчетов);
	
	КонтекстПроведения.ДополнительныеСвойства.Вставить("КонтекстРасчетаАвансов", ТекущийКонтекст);
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	ПараметрыРасчетаОстатковАванса = СтруктураПараметровРасчетаОстатковАванса(ТипЗначенияСсылки, СтрокаДокумента, ТаблицаРасчетов, ПараметрыРасчетаАванса);
	ТаблицаЗачетаАванса = ТаблицаЗачетаАванса_Основная(ВариантВызова, ИсточникиДанных, ПараметрыРасчетаАванса, ПараметрыРасчетаОстатковАванса);
	
	Возврат ТаблицаЗачетаАванса;
	
КонецФункции

Функция ПоступлениеУслуг_УслугиИРаботы_СЗачетомАванса(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры) Экспорт
	Перем Параметр_КФО;

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		Возврат ОписаниеПараметровДляФункцийПоступленияНФА("ПоступлениеУслуг");

	КонецЕсли;
	
	ПересчитываемыеПоля = Новый Массив;
	ПересчитываемыеПоля.Добавить("Сумма");
	ПересчитываемыеПоля.Добавить("СуммаНДС");
	ПересчитываемыеПоля.Добавить("Всего");
	
	МассивМетаданных = Новый Массив;
	МассивМетаданных.Добавить(Метаданные.Документы.ПоступлениеУслугРабот.ТабличныеЧасти.УслугиИРаботы);
	
	ПоляФункции = ЗаполнитьПоляФункцииИзОписанияМетаданных(МассивМетаданных, ПересчитываемыеПоля);
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	ПараметрыРасчетаАванса = СтруктураПараметровДляЗачетаАвансов(Параметры);
	ПараметрыПодготовкиТЧ = ОбщиеПараметрыПодготовкиТабличнойЧастиСЗачетомАвансов(ВариантВызова, ИсточникиДанных, Параметры, "УслугиИРаботы", ПоляФункции, ПересчитываемыеПоля, ПараметрыРасчетаАванса);
	ПараметрыПодготовкиТЧ.ИмяКолонкиДенежногоОбязательства = "Всего";	
	Возврат ПодготовитьТабличнуюЧастьСЗачетомАванса(ПараметрыПодготовкиТЧ);
	
КонецФункции // ПоступлениеМЗ_Материалы_СЗачетомАванса()

Функция ТаблицаПринятияДенежногоОбязательства_ПоступлениеУслуг(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры) Экспорт

	ГруппируемыеПоля = "КПС,КЭК";
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		Возврат ОписаниеПараметровДляФункцийПоступленияНФА("ПоступлениеУслуг");

	КонецЕсли;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		
		Возврат ОписаниеПолейТаблицыПринятияДенежногоОбязательства(ГруппируемыеПоля);
		
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицыДляРасчетаТаблицыПринятияДО = Новый Массив;
	ТаблицыДляРасчетаТаблицыПринятияДО.Добавить(ПоступлениеУслуг_УслугиИРаботы_СЗачетомАванса(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры));
	
	Возврат ЗаполнитьТаблицуПринятияДенежногоОбязательства(ТаблицыДляРасчетаТаблицыПринятияДО, ГруппируемыеПоля);

КонецФункции // ТаблицаПринятияДенежногоОбязательства_МЗ()


