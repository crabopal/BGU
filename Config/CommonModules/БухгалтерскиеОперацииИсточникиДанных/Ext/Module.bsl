	КонецЕсли;
	
	ПараметрыРасчетаАванса = СтруктураПараметровДляЗачетаАвансов(Параметры);
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2,ДопустимыйЗнак.Любой));
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДокументСсылка = КонтекстПроведения.Ссылка;
	ТипЗначенияСсылки = ТипЗнч(ДокументСсылка);
	
	ТаблицаРасчетов = ТаблицаРасчетовДляЗачетаАвансов(КонтекстПроведения, ИсточникиДанных, ПараметрыРасчетаАванса);
	ТаблицаРасчетов.Свернуть("Валюта, КПС, КФО, СчетРасчетов", "Сумма");
	
	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	СтрокаДокумента = ИсточникиДанных["Документ"][0];
	ТекущийКонтекст = Новый Структура;
	ТекущийКонтекст.Вставить("Период", ?(ДокументСсылка.Пустая(), СтрокаДокумента[ПрефиксДокумента + "Дата"], ДокументСсылка));
	ТекущийКонтекст.Вставить("ТаблицаРасчетов", ТаблицаРасчетов);
	
	КонтекстПроведения.ДополнительныеСвойства.Вставить("КонтекстРасчетаАвансов", ТекущийКонтекст);
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	ПараметрыРасчетаОстатковАванса = СтруктураПараметровРасчетаОстатковАванса(ТипЗначенияСсылки, СтрокаДокумента, ТаблицаРасчетов, ПараметрыРасчетаАванса);
	ТаблицаЗачетаАванса = ТаблицаЗачетаАванса_Основная(ВариантВызова, ИсточникиДанных, ПараметрыРасчетаАванса, ПараметрыРасчетаОстатковАванса);
	
	ТаблицаЗачетаАванса.Свернуть("Валюта, КПС, КФО, СчетРасчетов", "Сумма, ВалютнаяСумма");
	ТаблицаЗачетаАванса.Колонки.Добавить("Курс", Новый ОписаниеТипов("Число"));
	ТаблицаЗачетаАванса.Колонки.Добавить("ВалютнаяСуммаВсего", ОписаниеТипаСуммы);
	ТаблицаЗачетаАванса.Колонки.Добавить("ДоляЗачетаАванса", Новый ОписаниеТипов("Число"));
	
	СтруктураПоискаРасчетов = Новый Структура("Валюта, КПС, КФО, СчетРасчетов");
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	Для каждого СтрокаЗачетаАванса Из ТаблицаЗачетаАванса Цикл
	
		СтрокаЗачетаАванса.Курс = ?(СтрокаЗачетаАванса.ВалютнаяСумма = 0, 1, СтрокаЗачетаАванса.Сумма / СтрокаЗачетаАванса.ВалютнаяСумма);
		ЗаполнитьЗначенияСвойств(СтруктураПоискаРасчетов, СтрокаЗачетаАванса);
		СтрокиРасчетов = ТаблицаРасчетов.НайтиСтроки(СтруктураПоискаРасчетов);
		Для каждого ТекСтрокаРасчетов Из СтрокиРасчетов Цикл
			СтрокаЗачетаАванса.ВалютнаяСуммаВсего = СтрокаЗачетаАванса.ВалютнаяСуммаВсего + ТекСтрокаРасчетов.Сумма;
		КонецЦикла;
		СтрокаЗачетаАванса.ДоляЗачетаАванса = СтрокаЗачетаАванса.ВалютнаяСумма / СтрокаЗачетаАванса.ВалютнаяСуммаВсего;
	
	КонецЦикла;
	
	Курс		= КонтекстПроведения.Курс;
	Кратность	= КонтекстПроведения.Кратность;
	
	ИменаКолонок_ВРублях = Новый Массив;
	Для каждого ИмяКолонки Из ПересчитываемыеПоля Цикл
	
		ИменаКолонок_ВРублях.Добавить(ИмяКолонки + "_ВРублях");
	
	КонецЦикла; 
	
	ТаблицаРезультат = Новый ТаблицаЗначений;	
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);
	ТаблицаРезультат.Колонки.Добавить("СуммаДенежногоОбязательства", ОписаниеТипаСуммы);
	ТаблицаРезультат.Колонки.Добавить("СуммаДенежногоОбязательства_ВРублях", ОписаниеТипаСуммы);
	
	СтруктураПоискаАвансов = Новый Структура("Валюта, КПС, КФО, СчетРасчетов");
	СтруктураПоискаАвансов.Вставить("КПС",		ПараметрыРасчетаАванса.Параметр_КПС);
	СтруктураПоискаАвансов.Вставить("КФО",		СтрокаДокумента[ПрефиксДокумента + "КФО"]);
	СтруктураПоискаАвансов.Вставить("СчетРасчетов",	ПараметрыРасчетаАванса.Параметр_СчетРасчетовПоШтрафам);
	
	Если СтрокаДокумента[ПрефиксДокумента + "ТаможенныйШтрафВал"] <> 0 Тогда
		СтруктураПоискаАвансов.Вставить("Валюта",		СтрокаДокумента[ПрефиксДокумента + "ВалютаДокумента"]);
		
		НоваяСтрока = ТаблицаРезультат.Добавить();
		Для каждого ТекПолеФункции Из ПоляФункции Цикл
			
			Если ИменаКолонок_ВРублях.Найти(ТекПолеФункции.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекПолеФункции.Имя = "ТаможенныйШтраф" Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока[ТекПолеФункции.Имя] = СтрокаДокумента[ПрефиксДокумента + ТекПолеФункции.Имя];
		
		КонецЦикла; 
		
		СтрокиАвансов = ТаблицаЗачетаАванса.НайтиСтроки(СтруктураПоискаАвансов);
		Если СтрокиАвансов.Количество() = 1 Тогда
			
			Для каждого ПересчитываемоеПоле Из ПересчитываемыеПоля Цикл
			
				НоваяСтрока[ПересчитываемоеПоле + "_ВРублях"] = НоваяСтрока[ПересчитываемоеПоле] *  СтрокиАвансов[0].Курс * СтрокиАвансов[0].ДоляЗачетаАванса
					+ НоваяСтрока[ПересчитываемоеПоле] *  Курс / Кратность * (1 - СтрокиАвансов[0].ДоляЗачетаАванса);
					
			КонецЦикла; 
			
			НоваяСтрока.СуммаДенежногоОбязательства = НоваяСтрока["ТаможенныйШтрафВал"] * (1 - СтрокиАвансов[0].ДоляЗачетаАванса);
			НоваяСтрока.СуммаДенежногоОбязательства_ВРублях = НоваяСтрока["ТаможенныйШтрафВал"] *  Курс / Кратность * (1 - СтрокиАвансов[0].ДоляЗачетаАванса);
			
		Иначе
			
			Для каждого ПересчитываемоеПоле Из ПересчитываемыеПоля Цикл
			
				НоваяСтрока[ПересчитываемоеПоле + "_ВРублях"] = НоваяСтрока[ПересчитываемоеПоле] *  Курс / Кратность;
			
			КонецЦикла; 
			
			НоваяСтрока.СуммаДенежногоОбязательства = НоваяСтрока["ТаможенныйШтрафВал"];
			НоваяСтрока.СуммаДенежногоОбязательства_ВРублях = НоваяСтрока["ТаможенныйШтрафВал_ВРублях"];
			
		КонецЕсли;
	КонецЕсли;	
	
	Если СтрокаДокумента[ПрефиксДокумента + "ТаможенныйШтраф"] <> 0 Тогда
		СтруктураПоискаАвансов.Вставить("Валюта", Константы.ВалютаРегламентированногоУчета.Получить());
		
		НоваяСтрока = ТаблицаРезультат.Добавить();
		Для каждого ТекПолеФункции Из ПоляФункции Цикл
			
			Если ИменаКолонок_ВРублях.Найти(ТекПолеФункции.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекПолеФункции.Имя = "ТаможенныйШтрафВал" Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекПолеФункции.Имя = "ВалютаДокумента" Тогда
				НоваяСтрока[ТекПолеФункции.Имя] = Константы.ВалютаРегламентированногоУчета.Получить();
			Иначе
				НоваяСтрока[ТекПолеФункции.Имя] = СтрокаДокумента[ПрефиксДокумента + ТекПолеФункции.Имя];
			КонецЕсли;
		
		КонецЦикла; 
		
		СтрокиАвансов = ТаблицаЗачетаАванса.НайтиСтроки(СтруктураПоискаАвансов);
		Если СтрокиАвансов.Количество() = 1 Тогда
			
			НоваяСтрока.СуммаДенежногоОбязательства = НоваяСтрока["ТаможенныйШтраф"] * (1 - СтрокиАвансов[0].ДоляЗачетаАванса);
			
		Иначе
			
			НоваяСтрока.СуммаДенежногоОбязательства = НоваяСтрока["ТаможенныйШтраф"];
			
		КонецЕсли;
		НоваяСтрока.СуммаДенежногоОбязательства_ВРублях = НоваяСтрока.СуммаДенежногоОбязательства;
		
	КонецЕсли;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаРезультат;
	
КонецФункции // ПоступлениеМЗ_Материалы_СЗачетомАванса()

Функция ТаблицаПринятияДенежногоОбязательства_ГТДИмпорт(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	ГруппируемыеПоля = "КПС,КЭК";
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		Возврат ОписаниеПараметровДляФункцийПоступленияНФА("ГТДИмпорт");
		
	КонецЕсли;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		
		Возврат ОписаниеПолейТаблицыПринятияДенежногоОбязательства(ГруппируемыеПоля);

	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;	
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ОписаниеПолейТаблицыПринятияДенежногоОбязательства(ГруппируемыеПоля));
	
	ПараметрыРасчетаАванса = СтруктураПараметровДляЗачетаАвансов(Параметры);
	
	ТаблицаРасчетаДО = ГТДИмпорт_Материалы_СЗачетомАванса(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры);
	Для каждого ТекСтрока Из ТаблицаРасчетаДО Цикл
		
		КЭК340 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("340");
		
		Если ТекСтрока.СуммаДенежногоОбязательства <> 0 Тогда
			НоваяСтрока = ТаблицаРезультат.Добавить();
			НоваяСтрока.КПС				= ПараметрыРасчетаАванса.Параметр_КПС;
			НоваяСтрока.КЭК				= КЭК340;
			НоваяСтрока.Сумма			= ТекСтрока.СуммаДенежногоОбязательства;
			НоваяСтрока.Сумма_ВРублях	= ТекСтрока.СуммаДенежногоОбязательства_ВРублях;
		КонецЕсли;
	
	КонецЦикла;
	
	ТаблицаРасчетаДО = ГТДИмпорт_ОсновныеСредства_СЗачетомАванса(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры);
	Для каждого ТекСтрока Из ТаблицаРасчетаДО Цикл
		
		КЭК310 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("310");
		
		Если ТекСтрока.СуммаДенежногоОбязательства <> 0 Тогда
			НоваяСтрока = ТаблицаРезультат.Добавить();
			НоваяСтрока.КПС				= ПараметрыРасчетаАванса.Параметр_КПС;
			НоваяСтрока.КЭК				= КЭК310;
			НоваяСтрока.Сумма			= ТекСтрока.СуммаДенежногоОбязательства;
			НоваяСтрока.Сумма_ВРублях	= ТекСтрока.СуммаДенежногоОбязательства_ВРублях;
		КонецЕсли;
	
	КонецЦикла;
	
	ТаблицаРасчетаДО = ГТДИмпорт_Штрафы_СЗачетомАванса(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры);
	Для каждого ТекСтрока Из ТаблицаРасчетаДО Цикл
		
		СчетРасчетов = ПараметрыРасчетаАванса.Параметр_СчетРасчетовПоШтрафам;
		КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(СчетРасчетов);
		
		Если ТекСтрока.СуммаДенежногоОбязательства <> 0 Тогда
			НоваяСтрока = ТаблицаРезультат.Добавить();
			НоваяСтрока.КПС				= ПараметрыРасчетаАванса.Параметр_КПС;
			НоваяСтрока.КЭК				= КЭК;
			НоваяСтрока.Сумма			= ТекСтрока.СуммаДенежногоОбязательства;
			НоваяСтрока.Сумма_ВРублях	= ТекСтрока.СуммаДенежногоОбязательства_ВРублях;
		КонецЕсли;
	
	КонецЦикла;
	
	ТаблицаРезультат.Свернуть(ГруппируемыеПоля, "Сумма, Сумма_ВРублях");
	
	Возврат ТаблицаРезультат;
		
КонецФункции // ТаблицаПринятияДенежногоОбязательства_МЗ()


// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ЗАЧЕТА АВАНСОВ

Функция ЗаполнитьПоляФункцииИзОписанияМетаданных(МассивМетаданных, ПересчитываемыеПоля)

	ПоляФункции = Новый Массив;
	ДобавитьПоляИзПересеченияТабличныхЧастей(ПоляФункции, МассивМетаданных);
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2,ДопустимыйЗнак.Любой));
    Для каждого ИмяПересчитываемогоПоля Из ПересчитываемыеПоля Цикл
	
		ДобавитьПолеРезультатаФункции(ПоляФункции, ИмяПересчитываемогоПоля + "_ВРублях", ОписаниеТипаСуммы);
	
	КонецЦикла; 
	
	Возврат ПоляФункции;
	
КонецФункции

Функция ПолучитьОстаткиАванса_ПустаяТаблица() Экспорт

	ТаблицаАвансов = Новый ТаблицаЗначений;
	ТаблицаАвансов.Колонки.Добавить("Счет",					Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаАвансов.Колонки.Добавить("Организация",			Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаАвансов.Колонки.Добавить("КПС",					Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаАвансов.Колонки.Добавить("ИФО",					Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаАвансов.Колонки.Добавить("КФО",					Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаАвансов.Колонки.Добавить("Подразделение",		Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаАвансов.Колонки.Добавить("Валюта",				Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаАвансов.Колонки.Добавить("Контрагент",			Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаАвансов.Колонки.Добавить("Договор",				Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаАвансов.Колонки.Добавить("ДокументАванса");
	ТаблицаАвансов.Колонки.Добавить("ДатаАванса",			Новый ОписаниеТипов("Дата"));
	ТаблицаАвансов.Колонки.Добавить("ДопСубконто");
	ТаблицаАвансов.Колонки.Добавить("СуммаОстаток",			Новый ОписаниеТипов("Число"));
	ТаблицаАвансов.Колонки.Добавить("ВалютнаяСуммаОстаток",	Новый ОписаниеТипов("Число"));
	ТаблицаАвансов.Колонки.Добавить("Валютный_206",			Новый ОписаниеТипов("Булево"));
	ТаблицаАвансов.Колонки.Добавить("СчетРасчетов",			Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Возврат ТаблицаАвансов;

КонецФункции // ПолучитьОстаткиАвансоа_ПустаяТаблица()

Функция ОписаниеПолейТаблицыПринятияДенежногоОбязательства(ГруппируемыеПоля = "КПС")

	ПоляФункции = Новый Массив;
	Если Найти(ГруппируемыеПоля, "КПС") > 0 Тогда
		ДобавитьПолеРезультатаФункции(ПоляФункции, "КПС",		Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));	
	КонецЕсли;
	Если Найти(ГруппируемыеПоля, "КЭК") > 0 Тогда
		ДобавитьПолеРезультатаФункции(ПоляФункции, "КЭК",		Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));	
	КонецЕсли;
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Сумма",			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Сумма_ВРублях",	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));	
	Возврат ПоляФункции;	

КонецФункции // ОписаниеПолейТаблицыПринятияДенежногоОбязательства()

Процедура ДобавитьПоляИзПересеченияТабличныхЧастей(Поля, ТаблицаМетаданных)

	Для каждого РеквизитМетаданного Из ТаблицаМетаданных[0].Реквизиты Цикл
		
		ЕстьВоВсехМетаданных = Истина;
		Для ИндексМетаданных = 1 По ТаблицаМетаданных.ВГраница() Цикл
		
			Если ТаблицаМетаданных[ИндексМетаданных].Реквизиты.Найти(РеквизитМетаданного.Имя) = Неопределено Тогда
				ЕстьВоВсехМетаданных = Ложь;
				Прервать;
			КонецЕсли;
		
		КонецЦикла; 
		
		Если Не ЕстьВоВсехМетаданных Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьПолеРезультатаФункции(Поля, РеквизитМетаданного.Имя, РеквизитМетаданного.Тип);
	
	КонецЦикла; 
	
КонецПроцедуры

Функция ОписаниеПараметровДляФункцийПоступленияНФА(ВидПоступления)

	ПараметрыФункции = Новый Массив;
	Если ВидПоступления = "ПоступлениеМЗ" Тогда
		
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",			Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетРасчетов",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		
	ИначеЕсли ВидПоступления = "ПоступлениеУслуг" Тогда
		
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",			Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		
	ИначеЕсли ВидПоступления = "ПоступлениеОС" Тогда
		
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",			Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",			Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетВложения",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		
	ИначеЕсли ВидПоступления = "ГТДИмпорт" Тогда
		
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",					Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",					Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетРасчетовПоШтрафам",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		
	КонецЕсли;
	Возврат ПараметрыФункции;

КонецФункции // ОписаниеПараметровДляФункцийПоступленияНФА()

Функция СтруктураПараметровДляЗачетаАвансов(Параметры) Экспорт
	Перем Параметр_СчетРасчетов;
	Перем Параметр_КФО;
	Перем Параметр_КПС;
	Перем Параметр_СчетВложения;
	Перем Параметр_СчетРасчетовПоШтрафам;

	Если НЕ Параметры.Свойство("КФО", Параметр_КФО) Тогда
		Параметр_КФО = Перечисления.КВД.ПустаяСсылка();
	КонецЕсли;
	Если НЕ Параметры.Свойство("КПС", Параметр_КПС) Тогда
		Параметр_КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	КонецЕсли;
	Если НЕ Параметры.Свойство("СчетВложения", Параметр_СчетВложения) Тогда
		Параметр_СчетВложения = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	Если НЕ Параметры.Свойство("СчетРасчетов", Параметр_СчетРасчетов) Тогда
		Параметр_СчетРасчетов = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	Если НЕ Параметры.Свойство("СчетРасчетовПоШтрафам", Параметр_СчетРасчетовПоШтрафам) Тогда
		Параметр_СчетРасчетовПоШтрафам = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Параметр_СчетРасчетов",				Параметр_СчетРасчетов);
	Результат.Вставить("Параметр_СчетВложения",				Параметр_СчетВложения);
	Результат.Вставить("Параметр_КФО",						Параметр_КФО);
	Результат.Вставить("Параметр_КПС",						Параметр_КПС);
	Результат.Вставить("Параметр_СчетРасчетовПоШтрафам",	Параметр_СчетРасчетовПоШтрафам);
	
	Возврат Результат;

КонецФункции // СтруктураПараметровДляЗачетаАвансов()

Функция СтруктураПараметровРасчетаОстатковАванса(ТипЗначенияСсылки, Объект, ТаблицаРасчетов, ПараметрыРасчетаАванса) Экспорт

	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	ПараметрыРасчетаОстатковАвансов = ПараметрыРасчетаТаблицыАвансов();
	
	Ссылка = Объект[ПрефиксДокумента + "Ссылка"];
	Если Ссылка.Пустая() Тогда
		Период = Новый Граница(КонецДня(Объект[ПрефиксДокумента + "Дата"]), ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	ПараметрыРасчетаОстатковАвансов.Период 		= Период;
	ПараметрыРасчетаОстатковАвансов.ИФО			= Объект[ПрефиксДокумента + "ИФО"];
	ПараметрыРасчетаОстатковАвансов.Организация = Объект[ПрефиксДокумента + "Организация"];
	ПараметрыРасчетаОстатковАвансов.Контрагент	= Объект[ПрефиксДокумента + "Контрагент"];
	ПараметрыРасчетаОстатковАвансов.Договор		= Объект[ПрефиксДокумента + "Договор"];
	
	Если ЗначениеЗаполнено(ПараметрыРасчетаАванса.Параметр_КФО) Тогда
		ПараметрыРасчетаОстатковАвансов.КФО.Добавить(ПараметрыРасчетаАванса.Параметр_КФО);
	КонецЕсли;
	
	Для каждого СтрокаТаблицыРасчетов Из ТаблицаРасчетов Цикл
	
		Если ПараметрыРасчетаОстатковАвансов.КПС.Найти(СтрокаТаблицыРасчетов.КПС) = Неопределено Тогда
			ПараметрыРасчетаОстатковАвансов.КПС.Добавить(СтрокаТаблицыРасчетов.КПС);
		КонецЕсли;
		Если ПараметрыРасчетаОстатковАвансов.Счета302.Найти(СтрокаТаблицыРасчетов.СчетРасчетов) = Неопределено Тогда
			ПараметрыРасчетаОстатковАвансов.Счета302.Добавить(СтрокаТаблицыРасчетов.СчетРасчетов);
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ПараметрыРасчетаОстатковАвансов;

КонецФункции // СтруктураПараметровРасчетаОстатковАванса()

Функция ОбщиеПараметрыПодготовкиТабличнойЧастиСЗачетомАвансов(ВариантВызова, ИсточникиДанных, Параметры, ИмяТабличнойЧасти, ПоляФункции, ПересчитываемыеПоля, ПараметрыРасчетаАванса)

	ПараметрыПодготовкиТЧ = Новый Структура;
	// обязательные параметры
	ПараметрыПодготовкиТЧ.Вставить("ВариантВызова",				ВариантВызова);
	ПараметрыПодготовкиТЧ.Вставить("ИсточникиДанных",			ИсточникиДанных);
	ПараметрыПодготовкиТЧ.Вставить("Параметры",					Параметры);
	ПараметрыПодготовкиТЧ.Вставить("ИмяТабличнойЧасти",			ИмяТабличнойЧасти);
	ПараметрыПодготовкиТЧ.Вставить("ПоляФункции",				ПоляФункции);
	ПараметрыПодготовкиТЧ.Вставить("ПересчитываемыеПоля",		ПересчитываемыеПоля);
	ПараметрыПодготовкиТЧ.Вставить("ПараметрыРасчетаАванса",	ПараметрыРасчетаАванса);
	// необязательные параметры
	ПараметрыПодготовкиТЧ.Вставить("ИмяКолонкиДенежногоОбязательства",		"");
	ПараметрыПодготовкиТЧ.Вставить("МассивКолонокДенежногоОбязательства",	Неопределено);
	ПараметрыПодготовкиТЧ.Вставить("ТаблицаРасчетов",						Неопределено);
	
	Возврат ПараметрыПодготовкиТЧ;
	
КонецФункции // ОбщиеПараметрыПодготовкиТабличнойЧастиСЗачетомАвансов()

Функция ПоляФункцииТаблицыОстатковАвансов()

	ПоляФункции = Новый Массив;
	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КФО",				Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КПС",				Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СчетРасчетов",		Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СчетАванса",		Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Валюта",			Новый ОписаниеТипов("СправочникСсылка.Валюты"));	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Сумма",				Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ВалютнаяСумма",		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ДокументАванса",	ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов.ТипЗначения);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ДопСубконто",		Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	
	Возврат ПоляФункции;

КонецФункции // ПоляФункцииТаблицыОстатковАвансов()


// ОБЩИЕ ФУНКЦИИ ЗАЧЕТА ВЫДАННЫХ АВАНСОВ

Функция ПодготовитьТабличнуюЧастьСЗачетомАванса(ПараметрыФункции)
	
	ВариантВызова = ПараметрыФункции.ВариантВызова;
	ИсточникиДанных						= ПараметрыФункции.ИсточникиДанных;
	Параметры							= ПараметрыФункции.Параметры;
	ИмяТабличнойЧасти					= ПараметрыФункции.ИмяТабличнойЧасти;
	ПоляФункции							= ПараметрыФункции.ПоляФункции;
	ПересчитываемыеПоля					= ПараметрыФункции.ПересчитываемыеПоля;
	ПараметрыРасчетаАванса				= ПараметрыФункции.ПараметрыРасчетаАванса;
	ИмяКолонкиДенежногоОбязательства	= ПараметрыФункции.ИмяКолонкиДенежногоОбязательства;
	МассивКолонокДенежногоОбязательства	= ПараметрыФункции.МассивКолонокДенежногоОбязательства;
	ТаблицаРасчетов						= ПараметрыФункции.ТаблицаРасчетов;
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2,ДопустимыйЗнак.Любой));
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДокументСсылка = КонтекстПроведения.Ссылка;
	ТипЗначенияСсылки = ТипЗнч(ДокументСсылка);
	
	МетаданныеСсылки = Метаданные.НайтиПоТипу(ТипЗначенияСсылки);
	ПараметрыЗаполнения_КПСвТЧ = МетаданныеСсылки.ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты.Найти("КПС") <> Неопределено;
	ПараметрыЗаполнения_КФОвТЧ = МетаданныеСсылки.ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты.Найти("КФО") <> Неопределено;
	ПараметрыЗаполнения_ЭтоПоступлениеУслуг = ТипЗначенияСсылки = Тип("ДокументСсылка.ПоступлениеУслугРабот");
	ПараметрыЗаполнения_ЭтоПоступлениеОС = (ТипЗначенияСсылки = Тип("ДокументСсылка.ПоступлениеОС"))
										ИЛИ (ТипЗначенияСсылки = Тип("ДокументСсылка.ПоступлениеОСВПути"));
	ПараметрыЗаполнения_ЭтоПоступлениеМЗ = (ТипЗначенияСсылки = Тип("ДокументСсылка.ПоступлениеМЗ"))
										ИЛИ (ТипЗначенияСсылки = Тип("ДокументСсылка.ПоступлениеМЗВПути"));
	ПараметрыЗаполнения_ЭтоГТДИмпорт = (ТипЗначенияСсылки = Тип("ДокументСсылка.ГТДИмпорт"));
	
	ТаблицаРасчетов = ТаблицаРасчетовДляЗачетаАвансов(КонтекстПроведения, ИсточникиДанных, ПараметрыРасчетаАванса);
	ТаблицаРасчетов.Свернуть("Валюта, КПС, КФО, СчетРасчетов", "Сумма");
	
	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	СтрокаДокумента = ИсточникиДанных["Документ"][0];
	ТекущийКонтекст = Новый Структура;
	ТекущийКонтекст.Вставить("Период", ?(ДокументСсылка.Пустая(), СтрокаДокумента[ПрефиксДокумента + "Дата"], ДокументСсылка));
	ТекущийКонтекст.Вставить("ТаблицаРасчетов", ТаблицаРасчетов);
	
	КонтекстПроведения.ДополнительныеСвойства.Вставить("КонтекстРасчетаАвансов", ТекущийКонтекст);
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	ПараметрыРасчетаОстатковАванса = СтруктураПараметровРасчетаОстатковАванса(ТипЗначенияСсылки, СтрокаДокумента, ТаблицаРасчетов, ПараметрыРасчетаАванса);
	ТаблицаЗачетаАванса = ТаблицаЗачетаАванса_Основная(ВариантВызова, ИсточникиДанных, ПараметрыРасчетаАванса, ПараметрыРасчетаОстатковАванса);
	
	ТаблицаЗачетаАванса.Свернуть("Валюта, КПС, КФО, СчетРасчетов", "Сумма, ВалютнаяСумма");
	ТаблицаЗачетаАванса.Колонки.Добавить("Курс", Новый ОписаниеТипов("Число"));
	ТаблицаЗачетаАванса.Колонки.Добавить("ВалютнаяСуммаВсего", ОписаниеТипаСуммы);
	ТаблицаЗачетаАванса.Колонки.Добавить("ДоляЗачетаАванса", Новый ОписаниеТипов("Число"));
	
	СтруктураПоискаРасчетов = Новый Структура("Валюта, КПС, КФО, СчетРасчетов");
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	Для каждого СтрокаЗачетаАванса Из ТаблицаЗачетаАванса Цикл
	
		СтрокаЗачетаАванса.Курс = ?(СтрокаЗачетаАванса.ВалютнаяСумма = 0, 1, СтрокаЗачетаАванса.Сумма / СтрокаЗачетаАванса.ВалютнаяСумма);
		ЗаполнитьЗначенияСвойств(СтруктураПоискаРасчетов, СтрокаЗачетаАванса);
		СтрокиРасчетов = ТаблицаРасчетов.НайтиСтроки(СтруктураПоискаРасчетов);
		Для каждого ТекСтрокаРасчетов Из СтрокиРасчетов Цикл
			СтрокаЗачетаАванса.ВалютнаяСуммаВсего = СтрокаЗачетаАванса.ВалютнаяСуммаВсего + ТекСтрокаРасчетов.Сумма;
		КонецЦикла;
		СтрокаЗачетаАванса.ДоляЗачетаАванса = СтрокаЗачетаАванса.ВалютнаяСумма / СтрокаЗачетаАванса.ВалютнаяСуммаВсего;
	
	КонецЦикла;
	
	Курс		= КонтекстПроведения.Курс;
	Кратность	= КонтекстПроведения.Кратность;
	
	ИменаКолонок_ВРублях = Новый Массив;
	Для каждого ИмяКолонки Из ПересчитываемыеПоля Цикл
	
		ИменаКолонок_ВРублях.Добавить(ИмяКолонки + "_ВРублях");
	
	КонецЦикла; 
	
	ТаблицаРезультат = Новый ТаблицаЗначений;	
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);
	ТаблицаРезультат.Колонки.Добавить("СуммаДенежногоОбязательства", ОписаниеТипаСуммы);
	ТаблицаРезультат.Колонки.Добавить("СуммаДенежногоОбязательства_ВРублях", ОписаниеТипаСуммы);
	
	СтруктураПоискаАвансов = Новый Структура("Валюта, КПС, КФО, СчетРасчетов");
	ПрефиксКолонки = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных(ИмяТабличнойЧасти);
	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	ПрефиксДопРеквизита = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("ДополнительныйРеквизит");
	Для каждого СтрокаДокумента Из ИсточникиДанных[ИмяТабличнойЧасти] Цикл
		
		НоваяСтрока = ТаблицаРезультат.Добавить();
		Для каждого ТекПолеФункции Из ПоляФункции Цикл
			
			Если ИменаКолонок_ВРублях.Найти(ТекПолеФункции.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока[ТекПолеФункции.Имя] = СтрокаДокумента[ПрефиксКолонки + ТекПолеФункции.Имя];
		
		КонецЦикла; 
		
		СтруктураПоискаАвансов = Новый Структура("Валюта, КПС, КФО, СчетРасчетов");
		СтруктураПоискаАвансов.Вставить("Валюта",		СтрокаДокумента[ПрефиксДокумента + "ВалютаДокумента"]);
		Если ПараметрыЗаполнения_КПСвТЧ Тогда
			СтруктураПоискаАвансов.Вставить("КПС",		СтрокаДокумента[ПрефиксКолонки + "КПС"]);
		Иначе
			СтруктураПоискаАвансов.Вставить("КПС",		ПараметрыРасчетаАванса.Параметр_КПС);
		КонецЕсли;			
		Если ПараметрыЗаполнения_КФОвТЧ Тогда
			СтруктураПоискаАвансов.Вставить("КФО",		СтрокаДокумента[ПрефиксКолонки + "КФО"]);
		Иначе
			СтруктураПоискаАвансов.Вставить("КФО",		ПараметрыРасчетаАванса.Параметр_КФО);
		КонецЕсли;			
		СчетРасчетов = ПараметрыРасчетаАванса.Параметр_СчетРасчетов;
		Если ПараметрыЗаполнения_ЭтоПоступлениеУслуг Тогда
			СчетРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьАналитическийСчетПоКЭК(СтрокаДокумента[ПрефиксКолонки + "КЭК"], "302.00",, КонтекстПроведения.ДокументОбъект.Дата);
		ИначеЕсли ПараметрыЗаполнения_ЭтоПоступлениеОС Тогда
			СчетРасчетов = БухгалтерскиеОперации.СчетПоставщикаТМЦ(СтрокаДокумента[ПрефиксКолонки + "ВнеоборотныйАктив"], ?(ЗначениеЗаполнено(ПараметрыРасчетаАванса.Параметр_СчетВложения),ПараметрыРасчетаАванса.Параметр_СчетВложения,СтрокаДокумента.КапВложения_СчетУчета));
		ИначеЕсли ПараметрыЗаполнения_ЭтоПоступлениеМЗ И Не ЗначениеЗаполнено(СчетРасчетов) Тогда
			СчетРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("302.34");
		ИначеЕсли ПараметрыЗаполнения_ЭтоГТДИмпорт Тогда
			Если ИмяТабличнойЧасти = "Материалы" Тогда
				СчетРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("302.34");
			ИначеЕсли ИмяТабличнойЧасти = "ОсновныеСредства" Тогда
				СчетРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("302.31");
			КонецЕсли;
		КонецЕсли;
		СтруктураПоискаАвансов.Вставить("СчетРасчетов",	СчетРасчетов);
		СтрокиАвансов = ТаблицаЗачетаАванса.НайтиСтроки(СтруктураПоискаАвансов);
		Если СтрокиАвансов.Количество() = 1 Тогда
			
			Для каждого ПересчитываемоеПоле Из ПересчитываемыеПоля Цикл
			
				НоваяСтрока[ПересчитываемоеПоле + "_ВРублях"] = НоваяСтрока[ПересчитываемоеПоле] *  СтрокиАвансов[0].Курс * СтрокиАвансов[0].ДоляЗачетаАванса
					+ НоваяСтрока[ПересчитываемоеПоле] *  Курс / Кратность * (1 - СтрокиАвансов[0].ДоляЗачетаАванса);
					
			КонецЦикла; 
			
			Если ЗначениеЗаполнено(ИмяКолонкиДенежногоОбязательства) Тогда
				НоваяСтрока.СуммаДенежногоОбязательства = НоваяСтрока[ИмяКолонкиДенежногоОбязательства] * (1 - СтрокиАвансов[0].ДоляЗачетаАванса);
				НоваяСтрока.СуммаДенежногоОбязательства_ВРублях = НоваяСтрока[ИмяКолонкиДенежногоОбязательства] *  Курс / Кратность * (1 - СтрокиАвансов[0].ДоляЗачетаАванса);
			ИначеЕсли ЗначениеЗаполнено(МассивКолонокДенежногоОбязательства) Тогда
				
				Для каждого КолонкаДО Из МассивКолонокДенежногоОбязательства Цикл
				
					НоваяСтрока.СуммаДенежногоОбязательства 		= НоваяСтрока.СуммаДенежногоОбязательства			
																	+ НоваяСтрока[КолонкаДО] * (1 - СтрокиАвансов[0].ДоляЗачетаАванса);
					НоваяСтрока.СуммаДенежногоОбязательства_ВРублях = НоваяСтрока.СуммаДенежногоОбязательства_ВРублях	
																	+ НоваяСтрока[КолонкаДО] *  Курс / Кратность * (1 - СтрокиАвансов[0].ДоляЗачетаАванса);

				КонецЦикла; 
				
			КонецЕсли;
			
		Иначе
			
			Для каждого ПересчитываемоеПоле Из ПересчитываемыеПоля Цикл
			
				НоваяСтрока[ПересчитываемоеПоле + "_ВРублях"] = НоваяСтрока[ПересчитываемоеПоле] *  Курс / Кратность;
			
			КонецЦикла; 
			
			Если ЗначениеЗаполнено(ИмяКолонкиДенежногоОбязательства) Тогда
				НоваяСтрока.СуммаДенежногоОбязательства = НоваяСтрока[ИмяКолонкиДенежногоОбязательства];
				НоваяСтрока.СуммаДенежногоОбязательства_ВРублях = НоваяСтрока[ИмяКолонкиДенежногоОбязательства + "_ВРублях"];
			ИначеЕсли ЗначениеЗаполнено(МассивКолонокДенежногоОбязательства) Тогда
				
				Для каждого КолонкаДО Из МассивКолонокДенежногоОбязательства Цикл
				
					НоваяСтрока.СуммаДенежногоОбязательства			= НоваяСтрока.СуммаДенежногоОбязательства			+ НоваяСтрока[КолонкаДО];
					НоваяСтрока.СуммаДенежногоОбязательства_ВРублях	= НоваяСтрока.СуммаДенежногоОбязательства_ВРублях	+ НоваяСтрока[КолонкаДО + "_ВРублях"];
				
				КонецЦикла; 
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаРезультат;

КонецФункции

Функция ПолучитьОстаткиАванса(КонтекстПроведения, ИсточникиДанных, ПараметрыРасчетаАванса, ПараметрыРасчетаОстатковАванса) Экспорт

	Если КонтекстПроведения.ДополнительныеСвойства.Свойство("ТаблицаАвансов") = Истина Тогда
		Возврат КонтекстПроведения.ДополнительныеСвойства.ТаблицаАвансов.Скопировать();
	КонецЕсли;
	
	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	СтрокаДокумента = ИсточникиДанных.Документ[0];
	
	Если СтрокаДокумента[ПрефиксДокумента + "СпособЗачетаАванса"] = Перечисления.СпособыЗачетаАвансов.Автоматически Тогда
		
		ТаблицаАвансов = ПолучитьОстаткиАванса_Автоматически(ПараметрыРасчетаОстатковАванса);
		
	ИначеЕсли СтрокаДокумента[ПрефиксДокумента + "СпособЗачетаАванса"] = Перечисления.СпособыЗачетаАвансов.ПоДокументу Тогда
		
		ТаблицаАвансов = ПолучитьОстаткиАванса_ПоДокументу(КонтекстПроведения, ИсточникиДанных, ПараметрыРасчетаАванса, ПараметрыРасчетаОстатковАванса);
		
	Иначе
		
		ТаблицаАвансов = ПолучитьОстаткиАванса_ПустаяТаблица();
		
	КонецЕсли;
	
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаАвансов", ТаблицаАвансов);
	
	Возврат ТаблицаАвансов.Скопировать();

КонецФункции // ПолучитьОстаткиАванса()

Функция ПолучитьОстаткиАванса_Автоматически(ПараметрыРасчетаОстатковАванса) Экспорт 
	
	ВызватьИсключение НСтр("ru = 'Функция устарела'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

Функция ПолучитьОстаткиАванса_ПоДокументу(КонтекстПроведения, ИсточникиДанных, ПараметрыРасчетаАванса, ПараметрыРасчетаОстатковАванса) 

	ВызватьИсключение НСтр("ru = 'Функция устарела'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

Функция ЗаполнитьТаблицуПринятияДенежногоОбязательства(ТаблицыДляРасчетаТаблицыПринятияДО, ГруппируемыеПоля = "КПС")

	ТаблицаРезультат = Новый ТаблицаЗначений;	
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ОписаниеПолейТаблицыПринятияДенежногоОбязательства(ГруппируемыеПоля));
	
	Для каждого ТаблицаРасчетаДО Из ТаблицыДляРасчетаТаблицыПринятияДО Цикл
	
		Для каждого ТекСтрока Из ТаблицаРасчетаДО Цикл
			
			Если ТекСтрока.СуммаДенежногоОбязательства <> 0 Тогда
				НоваяСтрока = ТаблицаРезультат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока, ГруппируемыеПоля);
				НоваяСтрока.Сумма			= ТекСтрока.СуммаДенежногоОбязательства;
				НоваяСтрока.Сумма_ВРублях	= ТекСтрока.СуммаДенежногоОбязательства_ВРублях;
			КонецЕсли;
		
		КонецЦикла;  
	
	КонецЦикла; 
	
	ТаблицаРезультат.Свернуть(ГруппируемыеПоля, "Сумма, Сумма_ВРублях");
	
	Возврат ТаблицаРезультат;

КонецФункции

Функция ТаблицаРасчетовДляЗачетаАвансов(КонтекстПроведения, ИсточникиДанных, Параметры)
	Перем Параметр_СчетРасчетов;
	Перем Параметр_КФО;
	Перем Параметр_КПС;
	Перем Параметр_СчетВложения;
	Перем Параметр_СчетРасчетовПоШтрафам;
	
	ДокументСсылка = КонтекстПроведения.Ссылка;
	ТипЗначенияСсылки = ТипЗнч(ДокументСсылка);
	
	ТаблицаРасчетов = Новый ТаблицаЗначений;
	ТаблицаРасчетов.Колонки.Добавить("СчетРасчетов",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаРасчетов.Колонки.Добавить("КФО",				Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаРасчетов.Колонки.Добавить("КПС",				Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаРасчетов.Колонки.Добавить("Сумма",			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));
	ТаблицаРасчетов.Колонки.Добавить("Валюта",			Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	Параметры.Свойство("Параметр_СчетРасчетов",				Параметр_СчетРасчетов);
	Параметры.Свойство("Параметр_КФО",						Параметр_КФО);
	Параметры.Свойство("Параметр_КПС",						Параметр_КПС);
	Параметры.Свойство("Параметр_СчетВложения", 			Параметр_СчетВложения);
	Параметры.Свойство("Параметр_СчетРасчетовПоШтрафам",	Параметр_СчетРасчетовПоШтрафам);
	
	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	
	Если ТипЗначенияСсылки = Тип("ДокументСсылка.ПоступлениеМЗ")
		ИЛИ ТипЗначенияСсылки = Тип("ДокументСсылка.ПоступлениеМЗВПути") Тогда
			
		Если Не ЗначениеЗаполнено(Параметр_СчетРасчетов) Тогда
			Параметр_СчетРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("302.34");
		КонецЕсли;
			
		ПрефиксКолонки = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Материалы");
		
		Для каждого СтрокаДокумента Из ИсточникиДанных.Материалы Цикл
		
			НоваяСтрока = ТаблицаРасчетов.Добавить();
			НоваяСтрока.СчетРасчетов	= Параметр_СчетРасчетов;
			НоваяСтрока.Сумма			= СтрокаДокумента[ПрефиксКолонки + "Всего"];
			НоваяСтрока.КФО				= Параметр_КФО;
			НоваяСтрока.КПС				= СтрокаДокумента[ПрефиксКолонки + "КПС"];
			НоваяСтрока.Валюта			= СтрокаДокумента[ПрефиксДокумента + "ВалютаДокумента"];
			
		КонецЦикла;
			
		ПрефиксКолонки = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("ВозвратнаяТара");
		
		Для каждого СтрокаДокумента Из ИсточникиДанных.ВозвратнаяТара Цикл
		
			НоваяСтрока = ТаблицаРасчетов.Добавить();
			НоваяСтрока.СчетРасчетов	= Параметр_СчетРасчетов;
			НоваяСтрока.Сумма			= СтрокаДокумента[ПрефиксКолонки + "Сумма"];
			НоваяСтрока.КФО				= Параметр_КФО;
			НоваяСтрока.КПС				= СтрокаДокумента[ПрефиксКолонки + "КПС"];
			НоваяСтрока.Валюта			= СтрокаДокумента[ПрефиксДокумента + "ВалютаДокумента"];
			
		КонецЦикла;
			
	ИначеЕсли ТипЗначенияСсылки = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
			
		ПрефиксКолонки = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("УслугиИРаботы");
		
		Для каждого СтрокаДокумента Из ИсточникиДанных.УслугиИРаботы Цикл
			
			Если ЗначениеЗаполнено(СтрокаДокумента[ПрефиксКолонки + "КЭК"]) Тогда
				
				СчетПоКЭК = БухгалтерскийУчетПовтИсп.ПолучитьАналитическийСчетПоКЭК(СтрокаДокумента[ПрефиксКолонки + "КЭК"], "302.00",, КонтекстПроведения.ДокументОбъект.Дата);
					
				НоваяСтрока = ТаблицаРасчетов.Добавить();
				НоваяСтрока.СчетРасчетов	= СчетПоКЭК;
				НоваяСтрока.Сумма			= СтрокаДокумента[ПрефиксКолонки + "Всего"];
				НоваяСтрока.КФО				= Параметр_КФО;
				НоваяСтрока.КПС				= СтрокаДокумента[ПрефиксКолонки + "КПС"];
				НоваяСтрока.Валюта			= СтрокаДокумента[ПрефиксДокумента + "ВалютаДокумента"];
					
			КонецЕсли;
		
		КонецЦикла;
		
	ИначеЕсли ТипЗначенияСсылки = Тип("ДокументСсылка.ПоступлениеОС") 
		ИЛИ ТипЗначенияСсылки = Тип("ДокументСсылка.ПоступлениеОСВПути") Тогда
		
		ПрефиксКолонки = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("КапВложения");
		
		Для каждого СтрокаДокумента Из ИсточникиДанных.КапВложения Цикл
		
			НоваяСтрока = ТаблицаРасчетов.Добавить();
			Если ТипЗначенияСсылки = Тип("ДокументСсылка.ПоступлениеОСВПути") Тогда
				НоваяСтрока.СчетРасчетов	= БухгалтерскиеОперации.СчетПоКоду("302.31");
			Иначе
				НоваяСтрока.СчетРасчетов	= БухгалтерскиеОперации.СчетПоставщикаТМЦ(СтрокаДокумента[ПрефиксКолонки + "ВнеоборотныйАктив"], ?(ЗначениеЗаполнено(Параметр_СчетВложения),Параметр_СчетВложения,СтрокаДокумента.КапВложения_СчетУчета));
			КонецЕсли;
			НоваяСтрока.Сумма			= СтрокаДокумента[ПрефиксКолонки + "Всего"];
			НоваяСтрока.КФО				= Параметр_КФО;
			НоваяСтрока.КПС				= Параметр_КПС;
			НоваяСтрока.Валюта			= СтрокаДокумента[ПрефиксДокумента + "ВалютаДокумента"];
			
		КонецЦикла;
		
	ИначеЕсли ТипЗначенияСсылки = Тип("ДокументСсылка.ГТДИмпорт") Тогда
		
		ПрефиксКолонки	= БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Материалы");
		ВалютаРеглУчета = Константы.ВалютаРегламентированногоУчета.Получить();
		
		Для каждого СтрокаДокумента Из ИсточникиДанных.Материалы Цикл
		
			НоваяСтрока = ТаблицаРасчетов.Добавить();
			НоваяСтрока.СчетРасчетов	= БухгалтерскиеОперации.СчетПоКоду("302.34");
			НоваяСтрока.Сумма			= СтрокаДокумента[ПрефиксКолонки + "СуммаПошлины"] 
										+ СтрокаДокумента[ПрефиксКолонки + "ФактурнаяСтоимость"]
										+ ?(СтрокаДокумента[ПрефиксДокумента + "УчитыватьНДС"] = Истина, СтрокаДокумента[ПрефиксКолонки + "СуммаНДС"], 0);
			НоваяСтрока.КФО				= Параметр_КФО;
			НоваяСтрока.КПС				= Параметр_КПС;
			НоваяСтрока.Валюта			= СтрокаДокумента[ПрефиксДокумента + "ВалютаДокумента"];
			
		КонецЦикла;
		
		ПрефиксКолонки = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("ОсновныеСредства");
		
		Для каждого СтрокаДокумента Из ИсточникиДанных.ОсновныеСредства Цикл
		
			НоваяСтрока = ТаблицаРасчетов.Добавить();
			НоваяСтрока.СчетРасчетов	= БухгалтерскиеОперации.СчетПоКоду("302.31");
			НоваяСтрока.Сумма			= СтрокаДокумента[ПрефиксКолонки + "СуммаПошлины"] 
										+ СтрокаДокумента[ПрефиксКолонки + "ФактурнаяСтоимость"]
										+ ?(СтрокаДокумента[ПрефиксДокумента + "УчитыватьНДС"] = Истина, СтрокаДокумента[ПрефиксКолонки + "СуммаНДС"], 0);
			НоваяСтрока.КФО				= Параметр_КФО;
			НоваяСтрока.КПС				= Параметр_КПС;
			НоваяСтрока.Валюта			= СтрокаДокумента[ПрефиксДокумента + "ВалютаДокумента"];
			
		КонецЦикла;
		
		СтрокаДокумента = ИсточникиДанных.Документ[0];
		Если СтрокаДокумента[ПрефиксДокумента + "ТаможенныйШтраф"] <> 0 Тогда
			НоваяСтрока = ТаблицаРасчетов.Добавить();
			НоваяСтрока.СчетРасчетов	= Параметр_СчетРасчетовПоШтрафам;
			НоваяСтрока.Сумма			= СтрокаДокумента[ПрефиксДокумента + "ТаможенныйШтраф"];
			НоваяСтрока.КФО				= Параметр_КФО;
			НоваяСтрока.КПС				= Параметр_КПС;
			НоваяСтрока.Валюта			= ВалютаРеглУчета;
		КонецЕсли;
		
		Если СтрокаДокумента[ПрефиксДокумента + "ТаможенныйШтрафВал"] <> 0 Тогда
			НоваяСтрока = ТаблицаРасчетов.Добавить();
			НоваяСтрока.СчетРасчетов	= Параметр_СчетРасчетовПоШтрафам;
			НоваяСтрока.Сумма			= СтрокаДокумента[ПрефиксДокумента + "ТаможенныйШтрафВал"];
			НоваяСтрока.КФО				= Параметр_КФО;
			НоваяСтрока.КПС				= Параметр_КПС;
			НоваяСтрока.Валюта			= СтрокаДокумента[ПрефиксДокумента + "ВалютаДокумента"];
		КонецЕсли;
		
	ИначеЕсли ТипЗначенияСсылки = Тип("ДокументСсылка.ПриходныйОрдерФондовый") Тогда
		
		ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
		ПрефиксКолонки = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Расшифровка");
		Для каждого СтрокаДокумента Из ИсточникиДанных.Расшифровка Цикл
		
			НоваяСтрока = ТаблицаРасчетов.Добавить();
			НоваяСтрока.СчетРасчетов	= СтрокаДокумента[ПрефиксДокумента + "КорСчет"];
			НоваяСтрока.Сумма			= СтрокаДокумента[ПрефиксКолонки + "Сумма"];
			НоваяСтрока.КФО				= СтрокаДокумента[ПрефиксКолонки + "КФО"];;
			НоваяСтрока.КПС				= СтрокаДокумента[ПрефиксКолонки + "КПС"];;
			НоваяСтрока.Валюта			= ВалютаРубли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаРасчетов;

КонецФункции // ТаблицаРасчетовДляЗачетаАвансов()

Функция ТаблицаЗачетаАванса_Основная(ВариантВызова, ИсточникиДанных, ПараметрыРасчетаАванса, ПараметрыРасчетаОстатковАванса)
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункцииТаблицыОстатковАвансов();
	КонецЕсли;

	Если ВариантВызова <> "Выполнить" Тогда
		ВызватьИсключение "Неправильный вариант вызова функции ТаблицаЗачетаАванса_Основная: " + ВариантВызова;
	КонецЕсли;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	
	ТаблицаРасчетов = КонтекстПроведения.ДополнительныеСвойства.КонтекстРасчетаАвансов.ТаблицаРасчетов;
	ТаблицаРасчетов.Свернуть("СчетРасчетов, КФО, КПС, Валюта", "Сумма");
	
	ОстаткиАвансов = ПолучитьОстаткиАванса(КонтекстПроведения, ИсточникиДанных, ПараметрыРасчетаАванса, ПараметрыРасчетаОстатковАванса);
	
	Результат = ПолучитьТаблицуЗачетаАвансовИзТаблицыРасчетовИТаблицыОстатковАвансов(ТаблицаРасчетов, ОстаткиАвансов);
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	Возврат Результат;
	
Конецфункции

Функция ПолучитьТаблицуЗачетаАвансовИзТаблицыРасчетовИТаблицыОстатковАвансов(ТаблицаРасчетов, ОстаткиАвансов) Экспорт

	ПоляФункции	= ПоляФункцииТаблицыОстатковАвансов();
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	ТаблицаРезультат = Новый ТаблицаЗначений;	
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);
	
	СтруктураПоиска = Новый Структура("СчетРасчетов, КФО, КПС, Валюта");
	
	Для каждого СтрокаРасчетов Из ТаблицаРасчетов Цикл
		
		Если СтрокаРасчетов.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаКЗачету = СтрокаРасчетов.Сумма;
	
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаРасчетов);
		СтрокиАванса = ОстаткиАвансов.НайтиСтроки(СтруктураПоиска);
		
		Для каждого ТекСтрокаАванса Из СтрокиАванса Цикл
		
			Если ТекСтрокаАванса.Валюта = ВалютаРегламентированногоУчета Тогда
				РублеваяСумма = Мин(ТекСтрокаАванса.СуммаОстаток, СуммаКЗачету);
				Если РублеваяСумма <= 0 Тогда
					Продолжить;
				КонецЕсли;
				ВалютнаяСумма = РублеваяСумма;
				Валюта = ВалютаРегламентированногоУчета;
				
				СуммаКЗачету = СуммаКЗачету - РублеваяСумма; 
			Иначе
				Валюта = ТекСтрокаАванса.Валюта;
				Если СуммаКЗачету >= ТекСтрокаАванса.ВалютнаяСуммаОстаток Тогда
					
					РублеваяСумма = ТекСтрокаАванса.СуммаОстаток;
					ВалютнаяСумма = ТекСтрокаАванса.ВалютнаяСуммаОстаток;
					
				ИначеЕсли СуммаКЗачету < ТекСтрокаАванса.ВалютнаяСуммаОстаток Тогда
					
					КурсОстатка = Окр(ТекСтрокаАванса.СуммаОстаток / ТекСтрокаАванса.ВалютнаяСуммаОстаток, 4);
					РублеваяСумма = СуммаКЗачету * КурсОстатка;
					ВалютнаяСумма = СуммаКЗачету;
					
				КонецЕсли;
				Если РублеваяСумма <= 0 Тогда
					Продолжить;
				КонецЕсли;
				СуммаКЗачету = СуммаКЗачету - ВалютнаяСумма; 
			КонецЕсли;
			
			НоваяСтрока = ТаблицаРезультат.Добавить();
			НоваяСтрока.КФО				= СтрокаРасчетов.КФО;
			НоваяСтрока.КПС				= СтрокаРасчетов.КПС;
			НоваяСтрока.СчетРасчетов	= СтрокаРасчетов.СчетРасчетов;
			НоваяСтрока.СчетАванса		= ТекСтрокаАванса.Счет;
			НоваяСтрока.ДокументАванса	= ТекСтрокаАванса.ДокументАванса;
			НоваяСтрока.ДопСубконто		= ТекСтрокаАванса.ДопСубконто;
			НоваяСтрока.Валюта			= Валюта;
			НоваяСтрока.Сумма			= РублеваяСумма;
			НоваяСтрока.ВалютнаяСумма	= ВалютнаяСумма;
			
			Если СуммаКЗачету = 0 Тогда
				Прервать;
			КонецЕсли;
		
		КонецЦикла; 
	
	КонецЦикла; 
	
	Возврат ТаблицаРезультат;		

КонецФункции // ПолучитьТаблицуЗачетаАвансовИзТаблицыРасчетовИТаблицыОстатковАвансов()

Функция ПараметрыРасчетаТаблицыАвансов()
	
	Результат = Новый Структура;
	Результат.Вставить("Период");
	Результат.Вставить("Организация");
	Результат.Вставить("Контрагент");
	Результат.Вставить("Договор",	Справочники.Договоры.ПустаяСсылка());
	Результат.Вставить("КПС",		Новый Массив);
	Результат.Вставить("КФО",		Новый Массив);
	Результат.Вставить("ИФО",		Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	Результат.Вставить("КЭК",		Новый Массив);
	Результат.Вставить("Счета302",	Новый Массив);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область РазукомплектацияКапвложений

Функция ТаблицаДляРазукомплектацииВложений(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	ТипИФО           = Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения");
	ТипКФО           = Новый ОписаниеТипов("ПеречислениеСсылка.КВД");
	ТипКПС           = Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов");
	ТипПодразделение = Новый ОписаниеТипов("СправочникСсылка.Подразделения");
	ТипЦМО           = Новый ОписаниеТипов("СправочникСсылка.ЦМО");
	ТипСумма         = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	ТипКоличество    = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0));
	ТипОС            = Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства");
	ТипСчет          = Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	ТипКЭК           = Новый ОписаниеТипов("СправочникСсылка.КОСГУ");
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
	КонецЕсли;
	
	ТаблицаПроводок = Новый ТаблицаЗначений;
	ТаблицаПроводок.Колонки.Добавить("ОбъектВложений", ТипОС);
	ТаблицаПроводок.Колонки.Добавить("ИФО", ТипИФО);
	ТаблицаПроводок.Колонки.Добавить("КФО", ТипКФО);
	ТаблицаПроводок.Колонки.Добавить("КПС", ТипКПС);
	ТаблицаПроводок.Колонки.Добавить("ЦМООтправитель", ТипЦМО);
	ТаблицаПроводок.Колонки.Добавить("ПодразделениеОтправитель", ТипПодразделение);
	ТаблицаПроводок.Колонки.Добавить("ЦМОПриемник", ТипЦМО);
	ТаблицаПроводок.Колонки.Добавить("ПодразделениеПриемник", ТипПодразделение);

	ТаблицаПроводок.Колонки.Добавить("КоличествоДт", ТипКоличество);
	ТаблицаПроводок.Колонки.Добавить("КоличествоКт", ТипКоличество);
	
	ТаблицаПроводок.Колонки.Добавить("СчетДт", ТипСчет);
	ТаблицаПроводок.Колонки.Добавить("КЭКДт", ТипКЭК);
	
	ТаблицаПроводок.Колонки.Добавить("Сумма", ТипСумма);

	ПоляФункции = Новый Массив;
	
	Для Каждого Колонка Из ТаблицаПроводок.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ТаблицаПроводок.Очистить();
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	Для каждого СтрокаТЧ из ДокументОбъект.КапвложенияЦелевые Цикл
		НоваяСтрока = ТаблицаПроводок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		
		НоваяСтрока.КоличествоДт = СтрокаТЧ.КоличествоОбъектов;
		НоваяСтрока.КоличествоКт = СтрокаТЧ.КоличествоВложений;
		
		СтрокаКапвложенияИсходные = ДокументОбъект.КапвложенияИсходные.Найти(СтрокаТЧ.ИдентификаторСтрокиКапвложений);
		СтрокаОбъектыЦелевые      = ДокументОбъект.ОбъектыЦелевые.Найти(СтрокаТЧ.ИдентификаторСтрокиОбъектов);
		
		Если СтрокаКапвложенияИсходные <> Неопределено Тогда
			НоваяСтрока.ЦМООтправитель = СтрокаКапвложенияИсходные.ЦМО;
			НоваяСтрока.ПодразделениеОтправитель = СтрокаКапвложенияИсходные.Подразделение;
		КонецЕсли;	

		Если СтрокаОбъектыЦелевые <> Неопределено Тогда
			НоваяСтрока.СчетДт = СтрокаОбъектыЦелевые.СчетУчета;
			НоваяСтрока.КЭКДт  = БухгалтерскиеОперации.КЭКПроводки(
				ДокументОбъект.Организация, 
				НоваяСтрока.ИФО, 
				НоваяСтрока.КФО,
				ДокументОбъект.Дата,
				СтрокаОбъектыЦелевые.СчетУчета,
				НоваяСтрока.ОбъектВложений, 
				Неопределено, 
				Неопределено, 
				"Дт");
			НоваяСтрока.ЦМОПриемник = СтрокаОбъектыЦелевые.ЦМО;
			НоваяСтрока.ПодразделениеПриемник = СтрокаОбъектыЦелевые.Подразделение;
		КонецЕсли;	
	КонецЦикла;	
	
	// Сохраним Отказ и таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ТаблицаПроводок", ТаблицаПроводок.Скопировать());
	Если Отказ Тогда
		КонтекстПроведения.Отказ = Истина;
	КонецЕсли;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаПроводок;
КонецФункции	

#КонецОбласти


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбъявленияВсехФункцийМодуля()

	ВсеФункцииМодуля = Новый Массив;
	
	// НДС
	ФункцияМодуля = ДобавитьЗаголовокОписанияФункции(ВсеФункцииМодуля, "ТаблицаАннулированияСчетаФактуры");
	ФункцияМодуля.Заголовок	= "Таблица аннулирования счета-фактуры";
	ФункцияМодуля.Описание	= НСтр("ru='Таблица для аннулирования проводок счета-фактуры'");
