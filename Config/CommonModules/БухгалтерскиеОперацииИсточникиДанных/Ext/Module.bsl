	|			И (ЕПСБУВидыСубконтоДт3.НомерСтроки = 3)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоКт1
	|		ПО Проводки.СчетКт = ЕПСБУВидыСубконтоКт1.Ссылка
	|			И (ЕПСБУВидыСубконтоКт1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоКт2
	|		ПО (ЕПСБУВидыСубконтоКт2.НомерСтроки = 2)
	|			И Проводки.СчетКт = ЕПСБУВидыСубконтоКт2.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоКт3
	|		ПО Проводки.СчетКт = ЕПСБУВидыСубконтоКт3.Ссылка
	|			И (ЕПСБУВидыСубконтоКт3.НомерСтроки = 3)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУДт
	|		ПО Проводки.СчетДт = ЕПСБУДт.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУКт
	|		ПО Проводки.СчетКт = ЕПСБУКт.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификационныеПризнакиСчетов КАК СпрКПСДт
	|		ПО Проводки.КПСДт = СпрКПСДт.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификационныеПризнакиСчетов КАК СпрКПСКт
	|		ПО Проводки.КПСКт = СпрКПСКт.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК СпрКЭКДт
	|		ПО Проводки.КЭКДт = СпрКЭКДт.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК СпрКЭККт
	|		ПО Проводки.КЭККт = СпрКЭККт.Ссылка";
				   
	ТаблицаПроводок = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекПроводка Из ТаблицаПроводок Цикл
		
		СтрокаРезультата = ТаблицаРезультат.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаРезультата, ТекПроводка );
	
		СтрокаРезультата.Содержание = "Закрытие счета " 
								+ ТекПроводка.ПредставлениеКПС + "."
								+ ТекПроводка.ПредставлениеКФО + "."
								+ ТекПроводка.ПредставлениеСчета + "."
								+ ТекПроводка.ПредставлениеКЭК;
								
	КонецЦикла; 
	
	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти

#Область УчетИностраннойВалюты

Функция ТаблицаКурсовыхРазницПоКФО(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		Возврат Новый Массив;
		
	КонецЕсли;
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));

	ПоляФункции = Новый Массив;
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КурсоваяРазница", ОписаниеТипаСуммы);

	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
		
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		Возврат ТаблицаРезультат;
	КонецЕсли;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка", РеквизитыДокумента.Ссылка);
	
	КурсоваяРазницаПоДокументу = 0;
	
	МетаданныеДокумента = Реквизиты.Ссылка.Метаданные();
	
	Если МетаданныеДокумента.Имя = "ПоручениеНаПокупкуВалюты" Тогда
		
		Если РеквизитыДокумента.ВидПоручения = 0 Тогда
			КурсоваяРазницаПоДокументу = РеквизитыДокумента.СуммаДокумента - РеквизитыДокумента.СуммаРублейДляПокупкиВалюты;
		ИначеЕсли РеквизитыДокумента.ВидПоручения = 1 Тогда
			КурсоваяРазницаПоДокументу = РеквизитыДокумента.СуммаДокумента - РеквизитыДокумента.КурсПокупки * РеквизитыДокумента.СуммаДокументаВВалюте;
		КонецЕсли;
		
		ПолеКоэффициент = "СуммаВал";
		ПолеРаспределяемаяСумма = "СуммаДокументаВВалюте";
		
	ИначеЕсли МетаданныеДокумента.Имя = "ПоручениеНаПродажуВалюты" Тогда
		
		КурсоваяРазницаПоДокументу = РеквизитыДокумента.СуммаРублейКЗачислению - РеквизитыДокумента.СуммаДокумента;
		
		ПолеКоэффициент = "СуммаВал";
		ПолеРаспределяемаяСумма = "СуммаДокументаВВалюте";
		
	ИначеЕсли МетаданныеДокумента.Имя = "КассовоеВыбытие" Тогда
		
		ВалютаИТипЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.ЛицевойСчет, "ВалютаСчета, ТипЛицевогоСчета");
		ВалютаЛицевогоСчета = ВалютаИТипЛицевогоСчета.ВалютаСчета;
		ТипЛицевогоСчета = ВалютаИТипЛицевогоСчета.ТипЛицевогоСчета;
		Если ЗначениеЗаполнено(ВалютаЛицевогоСчета)
			И РеквизитыДокумента.ВалютаДокумента <> ВалютаЛицевогоСчета
			И ТипЛицевогоСчета = ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Банковский")
			И БухгалтерскийУчет.СчетВИерархии(РеквизитыДокумента.КорСчет, "206.00, 208.00, 302.00") Тогда
			
			КурсоваяРазницаПоДокументу = РеквизитыДокумента.СуммаДокумента
				- РеквизитыДокумента.СуммаПроданнойВалюты * РеквизитыДокумента.КурсПроданнойВалюты / ?(РеквизитыДокумента.КратностьПроданнойВалюты = 0, 1, РеквизитыДокумента.КратностьПроданнойВалюты);
			
		Иначе
			Возврат ТаблицаРезультат;
		КонецЕсли;
		
		ПолеКоэффициент = "СуммаВал";
		ПолеРаспределяемаяСумма = "СуммаДокументаВВалюте";
		
	ИначеЕсли МетаданныеДокумента.Имя = "КассовоеПоступление" Тогда
		
		ВалютаИТипЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.ЛицевойСчет, "ВалютаСчета, ТипЛицевогоСчета");
		ВалютаЛицевогоСчета = ВалютаИТипЛицевогоСчета.ВалютаСчета;
		ТипЛицевогоСчета = ВалютаИТипЛицевогоСчета.ТипЛицевогоСчета;
		Если ЗначениеЗаполнено(ВалютаЛицевогоСчета)
			И РеквизитыДокумента.ВалютаДокумента <> ВалютаЛицевогоСчета
			И ТипЛицевогоСчета = ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Банковский")
			И РеквизитыДокумента.КорСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка() Тогда
			
			КурсоваяРазницаПоДокументу = РеквизитыДокумента.СуммаКупленнойВалюты * РеквизитыДокумента.КурсКупленнойВалюты / ?(РеквизитыДокумента.КратностьКупленнойВалюты = 0, 1, РеквизитыДокумента.КратностьКупленнойВалюты)
				- РеквизитыДокумента.СуммаДокумента;
			
		Иначе
			Возврат ТаблицаРезультат;
		КонецЕсли;
		
		ПолеКоэффициент = "СуммаВал";
		ПолеРаспределяемаяСумма = "СуммаДокументаВВалюте";  
		
	ИначеЕсли МетаданныеДокумента.Имя = "ПоступлениеНаСчет" Тогда
		
		ВалютаИТипЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.ЛицевойСчет, "ВалютаСчета, ТипЛицевогоСчета");
		ВалютаЛицевогоСчета = ВалютаИТипЛицевогоСчета.ВалютаСчета;
		ТипЛицевогоСчета = ВалютаИТипЛицевогоСчета.ТипЛицевогоСчета;
		Если ЗначениеЗаполнено(ВалютаЛицевогоСчета)
			И РеквизитыДокумента.ВалютаДокумента <> ВалютаЛицевогоСчета
			И ТипЛицевогоСчета = ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Банковский")
			И РеквизитыДокумента.КорСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка() Тогда
			
			КурсоваяРазницаПоДокументу = РеквизитыДокумента.СуммаКупленнойВалюты * РеквизитыДокумента.КурсКупленнойВалюты / ?(РеквизитыДокумента.КратностьКупленнойВалюты = 0, 1, РеквизитыДокумента.КратностьКупленнойВалюты)
				- РеквизитыДокумента.СуммаДокумента;
			
		Иначе
			Возврат ТаблицаРезультат;
		КонецЕсли;
		
		ПолеКоэффициент = "СуммаВал";
		ПолеРаспределяемаяСумма = "СуммаДокументаВВалюте";
		
	ИначеЕсли МетаданныеДокумента.Имя = "ПриходныйКассовыйОрдер" Тогда
		
		Если ЗначениеЗаполнено(РеквизитыДокумента.ВалютаДокумента)
			И ЗначениеЗаполнено(РеквизитыДокумента.ПроданнаяВалюта)
			И НЕ РеквизитыДокумента.ВалютаДокумента = РеквизитыДокумента.ПроданнаяВалюта
			И БухгалтерскийУчет.СчетВИерархии(РеквизитыДокумента.КорСчет, "201.20") Тогда
			
			КурсоваяРазницаПоДокументу = РеквизитыДокумента.СуммаДокумента * РеквизитыДокумента.Курс / ?(РеквизитыДокумента.Кратность = 0, 1, РеквизитыДокумента.Кратность)
				- РеквизитыДокумента.СуммаПроданнойВалюты * РеквизитыДокумента.КурсПроданнойВалюты / ?(РеквизитыДокумента.КратностьПроданнойВалюты = 0, 1, РеквизитыДокумента.КратностьПроданнойВалюты);
			
		Иначе
			Возврат ТаблицаРезультат;
		КонецЕсли;
		
		ПолеКоэффициент = "Сумма";
		ПолеРаспределяемаяСумма = "СуммаДокумента";
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(
		Запрос,
		"РасшифровкаПлатежа",
		"КФО,Подразделение,"+ПолеКоэффициент,
		Реквизиты.Ссылка,
		Реквизиты);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	РасшифровкаПлатежа.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА РасшифровкаПлатежа.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|			ТОГДА &Подразделение
	|		ИНАЧЕ РасшифровкаПлатежа.Подразделение
	|	КОНЕЦ КАК Подразделение,
	|	СУММА(РасшифровкаПлатежа."+ПолеКоэффициент+") КАК СуммаВал
	|ИЗ
	|	ТаблицаРасшифровкаПлатежа КАК РасшифровкаПлатежа
	|
	|СГРУППИРОВАТЬ ПО
	|	РасшифровкаПлатежа.КФО,
	|	ВЫБОР
	|		КОГДА РасшифровкаПлатежа.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|			ТОГДА &Подразделение
	|		ИНАЧЕ РасшифровкаПлатежа.Подразделение
	|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("Подразделение", РеквизитыДокумента.Подразделение);
	
	ТаблицаПоДокументу = Запрос.Выполнить().Выгрузить();
	
	СуммаДокументаВВалюте = РеквизитыДокумента[ПолеРаспределяемаяСумма];
	
	Если ТаблицаПоДокументу.Количество() = 1 Тогда
		СтрокаРезультата = ТаблицаРезультат.Добавить();
		СтрокаРезультата.КФО = ТаблицаПоДокументу[0].КФО;
		СтрокаРезультата.Подразделение = ТаблицаПоДокументу[0].Подразделение;
		СтрокаРезультата.КурсоваяРазница = КурсоваяРазницаПоДокументу;
	ИначеЕсли ТаблицаПоДокументу.Количество() > 1 Тогда
		КурсоваяРазницаПоСтрокам = 0;
		Для Каждого СтрокаКФО Из ТаблицаПоДокументу Цикл
			СтрокаРезультата = ТаблицаРезультат.Добавить();
			СтрокаРезультата.КФО = СтрокаКФО.КФО;
			СтрокаРезультата.Подразделение = СтрокаКФО.Подразделение;
			СтрокаРезультата.КурсоваяРазница = КурсоваяРазницаПоДокументу*СтрокаКФО.СуммаВал/СуммаДокументаВВалюте;
			КурсоваяРазницаПоСтрокам = КурсоваяРазницаПоСтрокам + СтрокаРезультата.КурсоваяРазница;
		КонецЦикла;
		Если КурсоваяРазницаПоДокументу <> КурсоваяРазницаПоСтрокам Тогда
			// корректируем курсовую разницу в последней строке
			СтрокаРезультата.КурсоваяРазница = СтрокаРезультата.КурсоваяРазница + КурсоваяРазницаПоДокументу - КурсоваяРазницаПоСтрокам;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция ПоступлениеНаличныхСБанковскогоСчета_ПКО(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		Возврат Новый Массив;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ИмяСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ПроданнаяВалюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СуммаПроданнойВалюты", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18, 2));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СуммаРуб", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18, 2));
	
	Для Каждого Колонка Из Метаданные.Документы.ПриходныйКассовыйОрдер.ТабличныеЧасти.РасшифровкаПлатежа.Реквизиты Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.Тип);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
		
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РасшифровкаПлатежа = ПолучитьТаблицуДанныхИзИсточниковДанных(ИсточникиДанных, "РасшифровкаПлатежа", Истина);
	
	КоэффициентыРаспределения = РасшифровкаПлатежа.ВыгрузитьКолонку("Сумма");
	СуммыПроданнойВалюты = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(
		РеквизитыДокумента.СуммаПроданнойВалюты, КоэффициентыРаспределения);
	КурсПересчета = РеквизитыДокумента.Курс / ?(РеквизитыДокумента.Кратность = 0, 1, РеквизитыДокумента.Кратность);
	РублевыеЭквиваленты = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(
		РеквизитыДокумента.СуммаДокумента * КурсПересчета, КоэффициентыРаспределения);
	
	Если ЗначениеЗаполнено(РеквизитыДокумента.ВалютаДокумента)
		И ЗначениеЗаполнено(РеквизитыДокумента.ПроданнаяВалюта)
