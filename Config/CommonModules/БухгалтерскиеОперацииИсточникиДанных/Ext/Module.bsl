#Область КорректировкаПоступленияИРеализацииМЗ

Функция ПроводкиКорректируемогоДокумента(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ТипСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	МетаданныеРБ = Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ;

	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("ВалютаДт", МетаданныеРБ.Измерения.Валюта.Тип);
	ТаблицаРезультат.Колонки.Добавить("ВалютаКт", МетаданныеРБ.Измерения.Валюта.Тип);
	ТаблицаРезультат.Колонки.Добавить("ВалютнаяСуммаДт", МетаданныеРБ.Ресурсы.ВалютнаяСумма.Тип);
	ТаблицаРезультат.Колонки.Добавить("ВалютнаяСуммаКт", МетаданныеРБ.Ресурсы.ВалютнаяСумма.Тип);
	ТаблицаРезультат.Колонки.Добавить("ВидПервичногоДокумента", МетаданныеРБ.Реквизиты.ВидПервичногоДокумента.Тип);
	ТаблицаРезультат.Колонки.Добавить("ДатаПервичногоДокумента", МетаданныеРБ.Реквизиты.ДатаПервичногоДокумента.Тип);
	ТаблицаРезультат.Колонки.Добавить("ЖурналОпераций", МетаданныеРБ.Измерения.ЖурналОпераций.Тип);
	ТаблицаРезультат.Колонки.Добавить("ИФО", МетаданныеРБ.Измерения.ИФО.Тип);
	ТаблицаРезультат.Колонки.Добавить("КоличествоДт", МетаданныеРБ.Ресурсы.Количество.Тип);
	ТаблицаРезультат.Колонки.Добавить("КоличествоКт", МетаданныеРБ.Ресурсы.Количество.Тип);
	ТаблицаРезультат.Колонки.Добавить("КПСДт", МетаданныеРБ.Измерения.КПС.Тип);
	ТаблицаРезультат.Колонки.Добавить("КПСКт", МетаданныеРБ.Измерения.КПС.Тип);
	ТаблицаРезультат.Колонки.Добавить("КФО", МетаданныеРБ.Измерения.КФО.Тип);
	ТаблицаРезультат.Колонки.Добавить("КЭКДт", МетаданныеРБ.Измерения.КЭК.Тип);
	ТаблицаРезультат.Колонки.Добавить("КЭККт", МетаданныеРБ.Измерения.КЭК.Тип);
	ТаблицаРезультат.Колонки.Добавить("НомерПервичногоДокумента", МетаданныеРБ.Реквизиты.НомерПервичногоДокумента.Тип);
	ТаблицаРезультат.Колонки.Добавить("Организация", МетаданныеРБ.Измерения.Организация.Тип);
	ТаблицаРезультат.Колонки.Добавить("ПодразделениеДт", МетаданныеРБ.Измерения.Подразделение.Тип);
	ТаблицаРезультат.Колонки.Добавить("ПодразделениеКт", МетаданныеРБ.Измерения.Подразделение.Тип);
	ТаблицаРезультат.Колонки.Добавить("Содержание", МетаданныеРБ.Реквизиты.Содержание.Тип);
	ТаблицаРезультат.Колонки.Добавить("СубконтоДт1", ТипСубконто);
	ТаблицаРезультат.Колонки.Добавить("СубконтоДт2", ТипСубконто);
	ТаблицаРезультат.Колонки.Добавить("СубконтоДт3", ТипСубконто);
	ТаблицаРезультат.Колонки.Добавить("СубконтоКт1", ТипСубконто);
	ТаблицаРезультат.Колонки.Добавить("СубконтоКт2", ТипСубконто);
	ТаблицаРезультат.Колонки.Добавить("СубконтоКт3", ТипСубконто);
	ТаблицаРезультат.Колонки.Добавить("Сумма", МетаданныеРБ.Ресурсы.Сумма.Тип);
	ТаблицаРезультат.Колонки.Добавить("СуммаЕНВД", МетаданныеРБ.Ресурсы.СуммаЕНВД.Тип);
	ТаблицаРезультат.Колонки.Добавить("СуммаНДС", МетаданныеРБ.Ресурсы.СуммаНДС.Тип);
	ТаблицаРезультат.Колонки.Добавить("СуммаНеУчитываетсяНУ", МетаданныеРБ.Ресурсы.СуммаНеУчитываетсяНУ.Тип);
	ТаблицаРезультат.Колонки.Добавить("СчетДт", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаРезультат.Колонки.Добавить("СчетКт", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаРезультат.Колонки.Добавить("ХарактеристикаДвиженияДт", МетаданныеРБ.Реквизиты.ХарактеристикаДвиженияДт.Тип);
	ТаблицаРезультат.Колонки.Добавить("ХарактеристикаДвиженияКт", МетаданныеРБ.Реквизиты.ХарактеристикаДвиженияКт.Тип);
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		
		ПоляФункции = Новый Массив;
		Для Каждого Колонка Из ТаблицаРезультат.Колонки Цикл
			ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
		КонецЦикла;
		Возврат ПоляФункции;
		
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ЭтоКорректировка")
		И ДокументОбъект.ЭтоКорректировка
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ДокументОснование") Тогда
		Документ = ДокументОбъект.ДокументОснование;
	Иначе
		Документ = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Документ) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт КАК ВалютаДт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт КАК ВалютаКт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаДт КАК ВалютнаяСуммаДт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаКт КАК ВалютнаяСуммаКт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ВидМежотчетногоПериода КАК ВидМежотчетногоПериода,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ЖурналОпераций КАК ЖурналОпераций,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ИФО КАК ИФО,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт КАК КоличествоДт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт КАК КоличествоКт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПСДт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПСКт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт КАК КЭКДт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт КАК КЭККт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.НомерСтроки КАК НомерСтроки,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Организация КАК Организация,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Период КАК Период,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК ПодразделениеДт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт КАК ПодразделениеКт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание КАК Содержание,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК СубконтоДт2,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК СубконтоДт3,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК СубконтоКт2,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК СубконтоКт3,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СуммаЕНВД КАК СуммаЕНВД,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СуммаНДС КАК СуммаНДС,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СуммаНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетДт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетКт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.УточнениеПериода КАК УточнениеПериода,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияДт КАК ХарактеристикаДвиженияДт,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт КАК ХарактеристикаДвиженияКт
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(, , Регистратор = &Регистратор И Сумма > 0, , ) КАК ЖурналПроводокЕПСБУДвиженияССубконто
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		Запрос.УстановитьПараметр("Регистратор", Документ);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаРезультат.Добавить(), Выборка);
		КонецЦикла;
		
	КонецЕсли;
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ПроводкиКорректируемогоДокумента", ТаблицаРезультат.Скопировать());
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаРезультат;

КонецФункции

#КонецОбласти 

#Область Извещения

Функция ПодтверждениеПолученияНФА(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ТипыНФА = Новый Массив;
	ТипыНФА.Добавить(Тип("СправочникСсылка.ОсновныеСредства"));
	ТипыНФА.Добавить(Тип("СправочникСсылка.Номенклатура"));
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаРезультат.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаРезультат.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	ТаблицаРезультат.Колонки.Добавить("НФА",        Новый ОписаниеТипов(ТипыНФА));
	ТаблицаРезультат.Колонки.Добавить("Количество", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10, 3));
	ТаблицаРезультат.Колонки.Добавить("Сумма",      ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18, 2));
	ТаблицаРезультат.Колонки.Добавить("КФО",        Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаРезультат.Колонки.Добавить("СчетУчета",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		ПоляФункции = Новый Массив;
		Для Каждого Колонка Из ТаблицаРезультат.Колонки Цикл
			ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
		КонецЦикла;
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИзвещениеВходящееОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ИзвещениеВходящееОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ИзвещениеВходящееОсновныеСредства.Количество КАК Количество,
	|	ИзвещениеВходящееОсновныеСредства.Сумма КАК Сумма,
	|	ИзвещениеВходящееОсновныеСредства.КФО КАК КФО,
	|	ИзвещениеВходящееОсновныеСредства.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ ТЧОсновныеСредства
	|ИЗ
	|	&ТЧОсновныеСредства КАК ИзвещениеВходящееОсновныеСредства
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИзвещениеВходящееМатериалы.НомерСтроки КАК НомерСтроки,
	|	ИзвещениеВходящееМатериалы.Номенклатура КАК Номенклатура,
	|	ИзвещениеВходящееМатериалы.Количество КАК Количество,
	|	ИзвещениеВходящееМатериалы.Сумма КАК Сумма,
	|	ИзвещениеВходящееМатериалы.КФО КАК КФО,
	|	ИзвещениеВходящееМатериалы.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ ТЧМатериалы
	|ИЗ
	|	&ТЧМатериалы КАК ИзвещениеВходящееМатериалы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИзвещениеВходящееВозвратнаяТара.НомерСтроки КАК НомерСтроки,
	|	ИзвещениеВходящееВозвратнаяТара.Номенклатура КАК Номенклатура,
	|	ИзвещениеВходящееВозвратнаяТара.Количество КАК Количество,
	|	ИзвещениеВходящееВозвратнаяТара.Сумма КАК Сумма,
	|	ИзвещениеВходящееВозвратнаяТара.КФО КАК КФО,
	|	ИзвещениеВходящееВозвратнаяТара.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ ТЧВозвратнаяТара
	|ИЗ
	|	&ТЧВозвратнаяТара КАК ИзвещениеВходящееВозвратнаяТара
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК НФА,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счета),
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &Поставщик
	|				И Субконто2 = &ИсходящееИзвещение) КАК ЖурналПроводокЕПСБУОстатки
	|ГДЕ
	|	(ЖурналПроводокЕПСБУОстатки.Счет, ЖурналПроводокЕПСБУОстатки.КФО, ЖурналПроводокЕПСБУОстатки.Субконто3) В
	|			(ВЫБРАТЬ
	|				ТЧОсновныеСредства.СчетУчета,
	|				ТЧОсновныеСредства.КФО,
	|				ТЧОсновныеСредства.ОсновноеСредство
	|			ИЗ
	|				ТЧОсновныеСредства КАК ТЧОсновныеСредства
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				ТЧМатериалы.СчетУчета,
	|				ТЧМатериалы.КФО,
	|				ТЧМатериалы.Номенклатура
	|			ИЗ
	|				ТЧМатериалы КАК ТЧМатериалы
	|		
	|			ОБЪЕДИНИТЬ ВСЕ
	|		
	|			ВЫБРАТЬ
	|				ТЧВозвратнаяТара.СчетУчета,
	|				ТЧВозвратнаяТара.КФО,
	|				ТЧВозвратнаяТара.Номенклатура
	|			ИЗ
	|				ТЧВозвратнаяТара КАК ТЧВозвратнаяТара)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ТЧОсновныеСредства.ОсновноеСредство КАК НФА,
	|	ТЧОсновныеСредства.Количество КАК Количество,
	|	ТЧОсновныеСредства.Сумма КАК Сумма,
	|	ТЧОсновныеСредства.КФО КАК КФО,
	|	ТЧОсновныеСредства.СчетУчета КАК СчетУчета,
	|	Остатки.СуммаОстатокДт КАК СуммаОстаток,
	|	ВЫБОР
	|		КОГДА ТЧОсновныеСредства.Сумма > Остатки.СуммаОстатокДт
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьОшибка,
	|	&ИмяТЧОсновныеСредства КАК ИмяСписка,
	|	&СинонимТЧОсновныеСредства КАК СинонимСписка,
	|	1 КАК ПорядокТЧ
	|ИЗ
	|	ТЧОсновныеСредства КАК ТЧОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО ТЧОсновныеСредства.ОсновноеСредство = Остатки.НФА
	|			И ТЧОсновныеСредства.КФО = Остатки.КФО
	|			И (Остатки.Счет = ТЧОсновныеСредства.СчетУчета)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧМатериалы.НомерСтроки,
	|	ТЧМатериалы.Номенклатура,
	|	ТЧМатериалы.Количество,
	|	ТЧМатериалы.Сумма,
	|	ТЧМатериалы.КФО,
	|	ТЧМатериалы.СчетУчета,
	|	Остатки.СуммаОстатокДт,
	|	ВЫБОР
	|		КОГДА ТЧМатериалы.Сумма > Остатки.СуммаОстатокДт
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	&ИмяТЧНоменклатура,
	|	&СинонимТЧНоменклатура,
	|	2
	|ИЗ
	|	ТЧМатериалы КАК ТЧМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО ТЧМатериалы.Номенклатура = Остатки.НФА
	|			И ТЧМатериалы.КФО = Остатки.КФО
	|			И (Остатки.Счет = ТЧМатериалы.СчетУчета)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧВозвратнаяТара.НомерСтроки,
	|	ТЧВозвратнаяТара.Номенклатура,
	|	ТЧВозвратнаяТара.Количество,
	|	ТЧВозвратнаяТара.Сумма,
	|	ТЧВозвратнаяТара.КФО,
	|	ТЧВозвратнаяТара.СчетУчета,
	|	Остатки.СуммаОстатокДт,
	|	ВЫБОР
	|		КОГДА ТЧВозвратнаяТара.Сумма > Остатки.СуммаОстатокДт
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	&ИмяТЧВозвратнаяТара,
	|	&СинонимТЧВозвратнаяТара,
	|	3
	|ИЗ
	|	ТЧВозвратнаяТара КАК ТЧВозвратнаяТара
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО ТЧВозвратнаяТара.Номенклатура = Остатки.НФА
	|			И ТЧВозвратнаяТара.КФО = Остатки.КФО
	|			И ТЧВозвратнаяТара.СчетУчета = Остатки.Счет
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕстьОшибка УБЫВ,
	|	ПорядокТЧ,
	|	НомерСтроки";
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	Запрос.УстановитьПараметр("Период", Новый Граница(Новый МоментВремени(ДокументОбъект.Дата, ДокументОбъект.Ссылка),
		ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Счета", БухгалтерскийУчет.СписокСчетов("05", ДокументОбъект.Дата, Ложь,
		ДокументОбъект.Организация));
	Запрос.УстановитьПараметр("Поставщик", ДокументОбъект.Поставщик);
	Запрос.УстановитьПараметр("ИсходящееИзвещение", ДокументОбъект.ДокументОснование);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);

	Запрос.УстановитьПараметр("ТЧОсновныеСредства", ДокументОбъект.ОсновныеСредства.Выгрузить());
	Запрос.УстановитьПараметр("ТЧМатериалы", ДокументОбъект.Материалы.Выгрузить());
	Запрос.УстановитьПараметр("ТЧВозвратнаяТара", ДокументОбъект.ВозвратнаяТара.Выгрузить());
	Запрос.УстановитьПараметр("ИмяТЧОсновныеСредства", "ОсновныеСредства");
	Запрос.УстановитьПараметр("СинонимТЧОсновныеСредства", МетаданныеДокумента.ТабличныеЧасти.ОсновныеСредства.Синоним);
	Запрос.УстановитьПараметр("ИмяТЧНоменклатура", "Материалы");
	Запрос.УстановитьПараметр("СинонимТЧНоменклатура", МетаданныеДокумента.ТабличныеЧасти.Материалы.Синоним);
	Запрос.УстановитьПараметр("ИмяТЧВозвратнаяТара", "ВозвратнаяТара");
	Запрос.УстановитьПараметр("СинонимТЧВозвратнаяТара", МетаданныеДокумента.ТабличныеЧасти.ВозвратнаяТара.Синоним);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Отказ = Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		Если Не Отказ И Выборка.ЕстьОшибка Тогда
			Отказ = Истина;
		КонецЕсли;
		
		Если Отказ Тогда
			Если Выборка.СуммаОстаток < Выборка.Сумма Тогда
				ТекстСообщения = СтрШаблон(НСтр("ru = 'Остаток %1 меньше суммы в документе %2'"), Формат(
					Выборка.СуммаОстаток, "ЧДЦ=2;"), Формат(Выборка.Сумма, "ЧДЦ=2;")); 
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
					"Колонка",
					"Корректность",
					НСтр("ru = 'Сумма'"),
					Выборка.НомерСтроки,
					Выборка.СинонимСписка,
					ТекстСообщения);
				ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(Выборка.ИмяСписка, Выборка.НомерСтроки,
					"Сумма");
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект.Ссылка, ПутьКПолю, "Объект");
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ТаблицаРезультат.Добавить(), Выборка);
		
	КонецЦикла;

	Если Отказ Тогда
		// Сохраним контекст.
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		КонтекстПроведения.Отказ = Истина;
		БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	КонецЕсли;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти

#Область УчетФинансовыхВложений

Функция ТаблицаВложенийВФинансовыеАктивы(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаВложений = УчетФинансовыхВложений.ПустаяТаблицаВложенийВФинансовыеАктивы();
	
	Для Каждого Колонка Из ТаблицаВложений.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
		
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка", ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация", ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата", ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	Реквизиты.Вставить("Курс", КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	ТаблицаДокумента = УчетФинансовыхВложений.ТаблицаВложенийВФинансовыеАктивыПоДокументу(
		ДокументОбъект, Параметры);
	
	ТаблицаРасчетовСЗачетомАвансов = ?(ДополнительныеСвойства.Свойство("ТаблицаРасчетовСЗачетомАвансов"),
		ДополнительныеСвойства.ТаблицаРасчетовСЗачетомАвансов, Неопределено);
	
	// Подготовим таблицу для отражения поступления вложений в финансовые активы
	ТаблицаПоступления = УчетФинансовыхВложений.ТаблицаВложенийВФинансовыеАктивы(
		ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты, Отказ);
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ТаблицаПоступлениеВложенийВФинансовыеАктивы", ТаблицаПоступления.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаПоступления;
	
КонецФункции

Функция РеализацияФинансовыхАктивов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		Возврат ПараметрыФункции;
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаРеализации = УчетФинансовыхВложений.ПустаяТаблицаРеализацияФинансовыхАктивов();
	Для Каждого Колонка Из ТаблицаРеализации.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	ТаблицаДокумента = УчетФинансовыхВложений.ПодготовитьТаблицуРеализацияФинансовыхАктивовПоДокументу(
		Реквизиты.Ссылка, Параметры);
	
	ТаблицаРасчетовСЗачетомАвансов = ?(ДополнительныеСвойства.Свойство("ТаблицаРасчетовСЗачетомАвансов"),
		ДополнительныеСвойства.ТаблицаРасчетовСЗачетомАвансов,
		Неопределено);
	
	// Подготовим таблицу для отражения реализации финансовых активов,
	ТаблицаРеализации = УчетФинансовыхВложений.ТаблицаРеализацияФинансовыхАктивов(
		ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты, Отказ);
	// и сохраним ее для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаРеализацияФинансовыхАктивов",
		ТаблицаРеализации.Скопировать());
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаРеализации;
	
КонецФункции

#КонецОбласти

