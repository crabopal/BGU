// Модуль предназначен для описания функций, возращающих дополнительные источники данных.
// Каждая функция может возвращать: требуемые параметры, колонки источника данных, сам источник данных (таблица значений).
// Варианты вызова функции взаимоисключающие. Вызываются автоматически.
// Параметры функций:
//	ВариантВызова - Строка	- "ПолучитьПоля" - функция вызвана для получения массива полей. Для добавления полей в массив используется функция "ДобавитьПолеРезультатаФункции".
//							- "ПолучитьПараметры" - функция вызвана для получения массива параметров. Для добавления параметров в массив используется функция "ДобавитьОписаниеПараметраФункции".
//							- "Выполнить" - функция вызвана для выполнения основного алгоритма.
//						Если вариант вызова "ПолучитьПоля" или "ПолучитьПараметры", то остальные параметры функции не заполняются и все содержат Неопределено
//	ИсточникиДанных - Структура - содержит данные объекта в виде структуры, содержащей в каждом ключе таблицу значений.
//								Данные шапки документа содержатся в ключе "Документ", данные табличных частей содержатся в ключах,
//								совпадающих с именем табличной части
//	ТиповаяОперация - СправочникСсылка.ТиповыеОперации - типовая операция, по которой формируются проводки
//	Параметры - Структура - содержит параметры функции: ключ - имя параметра, значение - значение параметра.
//						Состав параметров определяется из массива, который возвращается при вызове, где ВариантВызова = "ПолучитьПараметры"
//
// Возвращаемое значение:
//	ТаблицаЗначений - состав колонок должен совпадать с возращаемыми при вызове, где ВариантВызова = "ПолучитьПоля", т.к. эти поля могут использоваться в настройках
//
// Для использования функции ее нужно добавить в массив ВсеФункцииМодуля в функции ОписаниеФункцийМодуля.
// Для добавления используется функция ДобавитьЗаголовокОписанияФункции, которая возращает структуру описания текущей функции. В структуре уже заполнены имя функции, поля и параметры.
// Остается заполнить Заголовок и Описание и ТипыДокументов, если нужно.
//

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ОписаниеФункцийМодуля(ТипДокумента = Неопределено, ДобавлятьПоляПараметры = Истина) Экспорт

	ВсеФункцииМодуля = ОбъявленияВсехФункцийМодуля();
	Если ДобавлятьПоляПараметры Тогда
		Для Каждого ФункцияМодуля Из ВсеФункцииМодуля Цикл
			ЗаполнитьПоляИПараметрыФункции(ФункцияМодуля);
		КонецЦикла;
	КонецЕсли;
	
	ИндексПоследнейФункции = ВсеФункцииМодуля.ВГраница();
	
	// Функции модуля БухгалтерскиеОперацииИсточникиДанныхПереопределяемый
	
	ШаблонИмяФункции = ПрефиксФункцийПереопределяемогоМодуля() + ".%1";
	ШаблонЗаголовок  = НСтр("ru = '%1 (переопределяемый модуль)'");
	ШаблонОписание   = НСтр("ru = '%1
		|(Функция описана в переопределяемом модуле)'");
	БухгалтерскиеОперацииИсточникиДанныхПереопределяемый.ОбъявленияВсехФункцийМодуля(ВсеФункцииМодуля);
	Для Индекс = ИндексПоследнейФункции + 1 По ВсеФункцииМодуля.ВГраница() Цикл
	
		ВсеФункцииМодуля[Индекс].Имя          = СтрШаблон(ШаблонИмяФункции, ВсеФункцииМодуля[Индекс].Имя);
		ВсеФункцииМодуля[Индекс].Заголовок    = СтрШаблон(ШаблонЗаголовок, ВсеФункцииМодуля[Индекс].Заголовок);
		Если ЗначениеЗаполнено(ВсеФункцииМодуля[Индекс].Описание) Тогда
			ВсеФункцииМодуля[Индекс].Описание = СтрШаблон(ШаблонОписание, ВсеФункцииМодуля[Индекс].Описание);
		КонецЕсли;
	
	КонецЦикла;
	
	// Функции модулей расширений
	
	ИменаМодулейДопИсточников = БухгалтерскиеОперацииСервер.ОписанияМодулейРасширений("ИсточникиДанных");
	Если ИменаМодулейДопИсточников.Количество() > 0 Тогда
		
		ИндексПоследнейФункции = ВсеФункцииМодуля.ВГраница();
		ШаблонЗаголовок  = НСтр("ru = '%1 (из расширения)'");
		ШаблонОписание   = НСтр("ru = '%1
			|(Функция описана в расширении ""%2"")'");
		ОшибкиДопМодулей = Новый Массив;
	
		Для каждого ТекущийМодуль Из ИменаМодулейДопИсточников Цикл
			
			ИмяТекущегоМодуля = ТекущийМодуль.Ключ;
			
			ФункцииТекущегоМодуля = Новый Массив;
			ОбщийМодуль = ОбщегоНазначения.ОбщийМодуль(ИмяТекущегоМодуля);
			ОбщийМодуль.ОбъявленияВсехФункцийМодуля(ФункцииТекущегоМодуля);
			
			ФункцииДляПроверки = Новый Массив;
			Для каждого ФункцияМодуля Из ФункцииТекущегоМодуля Цикл
				ФункцииДляПроверки.Добавить(ФункцияМодуля.Имя);
			КонецЦикла; 
			ТекстОшибки = "";
			Если НЕ БухгалтерскиеОперацииСервер.ПроверитьИменаПроцедурРасширения(
				ФункцииДляПроверки, ИмяТекущегоМодуля, ТекстОшибки) Тогда
				
				ОшибкиДопМодулей.Добавить(ТекстОшибки);
				Продолжить;
			КонецЕсли;
			
			ШаблонИмяФункции  = "%ИмяМодуля%.%1";
			ШаблонИмяФункции = СтрЗаменить(ШаблонИмяФункции, "%ИмяМодуля%", ИмяТекущегоМодуля);
			Для Каждого ОписаниеФункции Из ФункцииТекущегоМодуля Цикл
				ВсеФункцииМодуля.Добавить(ОбщегоНазначения.СкопироватьРекурсивно(ОписаниеФункции));
				ТекущаяФункция = ВсеФункцииМодуля[ВсеФункцииМодуля.ВГраница()]; 
				
				ТекущаяФункция.Имя = СтрШаблон(ШаблонИмяФункции, ТекущаяФункция.Имя);
				ТекущаяФункция.Заголовок = СтрШаблон(ШаблонЗаголовок, ТекущаяФункция.Заголовок);
				ТекущаяФункция.Описание = СтрШаблон(ШаблонОписание, ТекущаяФункция.Описание, ТекущийМодуль.Значение);
				ЗаполнитьПоляИПараметрыФункции(ТекущаяФункция);
					
			КонецЦикла;
			
		КонецЦикла;
		
		Если ОшибкиДопМодулей.Количество() > 0 Тогда
			
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Обнаружены ошибки в объявлениях функций дополнительных источников.
				|%1'"), СтрСоединить(ОшибкиДопМодулей, Символы.ПС + Символы.ПС));
			ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииВычислениеИсточникаДанных(),
				УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки);
			ВызватьИсключение "Обнаружены ошибки в объявлениях функций дополнительных источников.
				|Подробную информацию см. в журнале регистрации";
			
		КонецЕсли;
		
	КонецЕсли;

	Если ТипДокумента = Неопределено Тогда
		Возврат ВсеФункцииМодуля;
	КонецЕсли;
	
	ДопустимыеФункцииМодуля = Новый Массив;
	
	Для каждого ТекФункцияМодуля Из ВсеФункцииМодуля Цикл
	
		Если ТекФункцияМодуля.ТипыДокументов.Количество() = 0
			ИЛИ ТекФункцияМодуля.ТипыДокументов.Найти(ТипДокумента) <> Неопределено Тогда
			ДопустимыеФункцииМодуля.Добавить(ТекФункцияМодуля);
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ДопустимыеФункцииМодуля;

КонецФункции

Функция ДобавитьЗаголовокОписанияФункцииРасширения(ВсеФункцииМодуля, ИмяФункции) Экспорт
	
	Возврат ДобавитьЗаголовокОписанияФункции(ВсеФункцииМодуля, ИмяФункции);
	
КонецФункции

Функция ДобавитьЗаголовокОписанияФункции(ВсеФункцииМодуля, ИмяФункции)

	НоваяФункция = Новый Структура;
	НоваяФункция.Вставить("Имя",			  ИмяФункции);
	НоваяФункция.Вставить("Заголовок",		  "");
	НоваяФункция.Вставить("Описание",		  "");
	НоваяФункция.Вставить("ТипыДокументов",   Новый Массив);
	НоваяФункция.Вставить("Поля",             Новый Массив);
	НоваяФункция.Вставить("Параметры",        Новый Массив);
	НоваяФункция.Вставить("ЗависитОтФункций", "");
	
	ВсеФункцииМодуля.Добавить(НоваяФункция);
	Возврат ВсеФункцииМодуля[ВсеФункцииМодуля.ВГраница()];

КонецФункции

Процедура ЗаполнитьПоляИПараметрыФункции(ОписаниеФункции) Экспорт
	Перем Поля; // Массив
	Перем Параметры; // Массив
	
	ЧастиИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ОписаниеФункции.Имя);
	Если ЧастиИмени.Количество() = 1 Тогда
		ПроверитьИмяФункции(ОписаниеФункции.Имя);
		ШаблонИмени = "%ИмяФункции%(%1, Неопределено, Неопределено, Неопределено)";
		ВызываемаяФункция = СтрЗаменить(ШаблонИмени, "%ИмяФункции%", ЧастиИмени[0]);
		Поля = Вычислить(СтрШаблон(ВызываемаяФункция, """ПолучитьПоля"""));
		Параметры = Вычислить(СтрШаблон(ВызываемаяФункция, """ПолучитьПараметры"""));
	ИначеЕсли ЧастиИмени.Количество() = 2 Тогда
		ОбщийМодуль = ОбщегоНазначения.ОбщийМодуль(ЧастиИмени[0]);
		Поля = ОбщийМодуль.ВыполнитьФункциюПолученияИсточникаДанных(ЧастиИмени[1], "ПолучитьПоля", Неопределено, Неопределено, Неопределено);
		Параметры = ОбщийМодуль.ВыполнитьФункциюПолученияИсточникаДанных(ЧастиИмени[1], "ПолучитьПараметры", Неопределено, Неопределено, Неопределено);
	Иначе
		ВызватьИсключение "Не правильный формат имени функции доп. источника: " + ОписаниеФункции.Имя;
	КонецЕсли;

	Если ТипЗнч(Поля) = Тип("Массив") Тогда
		ОписаниеФункции.Поля = Поля;
	КонецЕсли;
	Если ТипЗнч(Параметры) = Тип("Массив") Тогда
		ОписаниеФункции.Параметры = Параметры;
	КонецЕсли;

КонецПроцедуры

Функция ВыполнитьФункциюПолученияИсточникаДанных(ИмяФункции, ИсточникиДанных, ТиповаяОперация, Параметры) Экспорт

	СоставИмениФункции = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ИмяФункции);
	Если СоставИмениФункции.Количество() = 1 Тогда
		ПроверитьИмяФункции(ИмяФункции);
		ТаблицаИсточника = Вычислить(ИмяФункции + "(""Выполнить"", ИсточникиДанных, ТиповаяОперация, Параметры)");
	ИначеЕсли СоставИмениФункции.Количество() = 2 Тогда
		
		Если СоставИмениФункции[0] = ПрефиксФункцийПереопределяемогоМодуля() Тогда
			
			ТаблицаИсточника = БухгалтерскиеОперацииИсточникиДанныхПереопределяемый.ВыполнитьФункциюПолученияИсточникаДанных(
				СоставИмениФункции[1], ИсточникиДанных, ТиповаяОперация, Параметры);
				
		ИначеЕсли БухгалтерскиеОперацииСервер.ОписанияМодулейРасширений("ИсточникиДанных")
			.Свойство(СоставИмениФункции[0]) Тогда
			
			ОбщийМодуль = ОбщегоНазначения.ОбщийМодуль(СоставИмениФункции[0]);
			Попытка
				ТаблицаИсточника = ОбщийМодуль.ВыполнитьФункциюПолученияИсточникаДанных(
					СоставИмениФункции[1],
					"Выполнить",
					ИсточникиДанных,
					ТиповаяОперация,
					Параметры);
			Исключение
				ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииВычислениеИсточникаДанных(),
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.Справочники.ТиповыеОперации,
					ТиповаяОперация,
					СтрШаблон(НСтр("ru = 'Ошибка при вычислении источника данных в функции ""%1""'"), ИмяФункции));
				ВызватьИсключение;
			КонецПопытки;
			
		Иначе
			
			ТекстИсключения = СтрШаблон(НСтр("ru = 'Для использования типовой операции должно быть подключено расширение,
				|содержащее модуль ""%1"".
				|Расширение должно быть подключено не в безопасном режиме.
				|
				|Проверьте подключение расширения или выберите другую типовую операцию.'"), СоставИмениФункции[0]);
			ВызватьИсключение ТекстИсключения;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТаблицаИсточника;

КонецФункции

Функция ОписаниеПолейИсточникаДанных(ИмяФункции) Экспорт

	Возврат ВычислитьФункциюИсточникаДанных(ИмяФункции, "ПолучитьПоля", Неопределено, Неопределено, Неопределено);

КонецФункции

Функция ОписаниеПараметровИсточникаДанных(ИмяФункции) Экспорт

	Возврат ВычислитьФункциюИсточникаДанных(ИмяФункции, "ПолучитьПараметры", Неопределено, Неопределено, Неопределено);

КонецФункции

Функция ВычислитьФункциюИсточникаДанных(ИмяФункции, ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	СоставИмениФункции = СтрРазделить(ИмяФункции, ".");
	Если СоставИмениФункции.Количество() = 1 Тогда
		ВызываемаяФункция = СтрШаблон("%1(""%2"", ИсточникиДанных, ТиповаяОперация, Параметры)",
			ИмяФункции, ВариантВызова);
	ИначеЕсли СоставИмениФункции.Количество() = 2 Тогда
		Если СоставИмениФункции[0] <> ПрефиксФункцийПереопределяемогоМодуля()
			И НЕ БухгалтерскиеОперацииСервер.ОписанияМодулейРасширений("ИсточникиДанных")
			.Свойство(СоставИмениФункции[0]) Тогда
			
			ТекстИсключения = СтрШаблон(
				НСтр("ru = 'Для использования типовой операции должно быть подключено расширение,
				|содержащее модуль ""%1"".
				|Расширение должно быть подключено не в безопасном режиме.
				|
				|Проверьте подключение расширения или выберите другую типовую операцию.'"), СоставИмениФункции[0]);
			ВызватьИсключение ТекстИсключения;
			
		КонецЕсли;
		
		ВызываемаяФункция = СтрШаблон(
			"%1.ВыполнитьФункциюПолученияИсточникаДанных(""%2"", ""%3"", ИсточникиДанных, ТиповаяОперация, Параметры)",
			СоставИмениФункции[0], СоставИмениФункции[1], ВариантВызова);
	Иначе
			
		ТекстИсключения = СтрШаблон(НСтр("ru = 'Для использования типовой операции должно быть подключено расширение,
			|содержащее модуль ""%1"".
			|Расширение должно быть подключено не в безопасном режиме.
			|
			|Проверьте подключение расширения или выберите другую типовую операцию.'"), СоставИмениФункции[0]);
		ВызватьИсключение ТекстИсключения;
			
	КонецЕсли;
	
	Попытка
		//@skip-check server-execution-safe-mode
		Результат = Вычислить(ВызываемаяФункция);
	Исключение
		ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииВычислениеИсточникаДанных(),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.ТиповыеОперации,
			ТиповаяОперация,
			СтрШаблон(НСтр("ru = 'Ошибка при вычислении источника данных в функции ""%1""'"), ИмяФункции));
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Добавляет в массив ВсеФункцииМодуля описания функций из модуля ИмяМодуля.
// В расширении необходимо расширить метод
// БухгалтерскиеОперацииИсточникиДанныхПереопределяемый.ДополнитьОбъявленияФункцийРасширений
// с аннотацией &После.
// Тело функции копируется из БухгалтерскиеОперацииИсточникиДанныхПереопределяемый.ДополнитьОбъявленияФункцийРасширений.
//
// Параметры:
//  ИмяМодуля		 - Строка - Имя собственного модуля расширения, содержащего описания функции источников данных.
//  ВсеФункцииМодуля - Массив - В модуле расширения в этот массив добавляются описания функций.
//
Процедура ДополнитьОбъявленияФункцийРасширений(ИмяМодуля, ВсеФункцииМодуля) Экспорт
	
	ОбщийМодуль = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
	ОбщийМодуль.ОбъявленияВсехФункцийМодуля(ВсеФункцииМодуля);
	
КонецПроцедуры

// Возвращает префикс "Переопределяемый". Функции с этим префиксом должны находится в модуле
// БухгалтерскиеОперацииИсточникиДанныхПереопределяемый.
Функция ПрефиксФункцийПереопределяемогоМодуля() Экспорт

	Возврат "Переопределяемый";

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ЗачетАвансов

Функция ТаблицаРасчетовСЗачетомАвансов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ИФО",                Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",                Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",                Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Подразделение",      Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетРасчетов",       Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КЭКРасчетов",        Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СпособЗачетаАванса", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыЗачетаАвансов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ВидДеятельностиУСН", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДеятельностиДляНалоговогоУчетаЗатрат"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ОтражатьДоходПоВнебюджету", Новый ОписаниеТипов("Булево")); 
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПСРасчетовВТЧ", Новый ОписаниеТипов("Булево"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаРасчетов = УчетРасчетов.ПустаяТаблицаРасчетовСЗачетомАвансов();
	Для Каждого Колонка Из ТаблицаРасчетов.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "НомерКорректировки")
		И ДокументОбъект.НомерКорректировки > 0 Тогда
		
		Реквизиты.Вставить("НомерКорректировки", ДокументОбъект.НомерКорректировки);
		Реквизиты.Вставить("КорректируемыйДокумент", ДокументОбъект.ДокументОснование);
	КонецЕсли;
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	ТаблицаДокумента = УчетРасчетов.ПодготовитьТаблицуРасчетовПоДокументу(
		ДокументОбъект, Параметры, Отказ);
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ОтражатьДоходПоВнебюджету", Ложь) Тогда
		Для Каждого СтрокаТаблицы Из ТаблицаДокумента Цикл
			Если СтрокаТаблицы.КФО = Перечисления.КВД.СубсидииНаГосзадание
				ИЛИ СтрокаТаблицы.КФО = Перечисления.КВД.СубсидииНаИныеЦели
				ИЛИ СтрокаТаблицы.КФО = Перечисления.КВД.СредстваОМС Тогда
				СтрокаТаблицы.КФО = Перечисления.КВД.Внебюджет;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
		
	ТаблицаЗачетАвансовПоДокументу = УчетРасчетов.ПодготовитьТаблицуЗачетАвансовПоДокументу(
		ДокументОбъект, Реквизиты);
	
	Если НЕ Отказ Тогда
	
		// Подготовим таблицу для отражения зачета авансов и увеличения (уменьшения) задолженности
		// документами поступления и реализации материальных запасов, услуг, ОС и пр.
		ТаблицаРасчетов = УчетРасчетов.ТаблицаРасчетовСЗачетомАвансов(
			ТаблицаДокумента,
			ТаблицаЗачетАвансовПоДокументу,
			Реквизиты, Отказ);
		
	КонецЕсли;
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ТаблицаРасчетовСЗачетомАвансов", ТаблицаРасчетов.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

Функция ТаблицаРасчетовСЗачетомАвансовПоКомиссии(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ИФО",                Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",                Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",                Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Подразделение",      Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КЭКРасчетов",        Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СпособЗачетаАванса", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыЗачетаАвансов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ВидДеятельностиУСН", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДеятельностиДляНалоговогоУчетаЗатрат"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ОтражатьДоходПоВнебюджету", Новый ОписаниеТипов("Булево")); 
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПСРасчетовВТЧ", Новый ОписаниеТипов("Булево"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаРасчетов = УчетРасчетов.ПустаяТаблицаРасчетовСЗачетомАвансов();
	Для Каждого Колонка Из ТаблицаРасчетов.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Параметры.Вставить("СчетРасчетов", БухгалтерскийУчет.СчетПоКоду("210.05", ДокументОбъект.Дата, ДокументОбъект.Организация));
	
	ИспользоватьПустуюТаблицуРасчетов = Ложь;
	СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Параметры.СчетРасчетов);
	Если СвойстваСчетаРасчетов.ЗапретитьИспользоватьВПроводках Тогда
		ИспользоватьПустуюТаблицуРасчетов = Истина;
	КонецЕсли;
	
	Если НЕ ИспользоватьПустуюТаблицуРасчетов Тогда
		Реквизиты = Новый Структура;
		Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
		Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
		Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
		Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "НомерКорректировки")
			И ДокументОбъект.НомерКорректировки > 0 Тогда
			
			Реквизиты.Вставить("НомерКорректировки", ДокументОбъект.НомерКорректировки);
			Реквизиты.Вставить("КорректируемыйДокумент", ДокументОбъект.ДокументОснование);
		КонецЕсли;
		
		Для Каждого Параметр Из Параметры Цикл
			Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
		
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
		Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
		
		ТаблицаДокумента = УчетРасчетов.ПодготовитьТаблицуРасчетовПоДокументу(
			ДокументОбъект, Параметры, Отказ);
		
		Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ОтражатьДоходПоВнебюджету", Ложь) Тогда
			Для Каждого СтрокаТаблицы Из ТаблицаДокумента Цикл
				Если СтрокаТаблицы.КФО = Перечисления.КВД.СубсидииНаГосзадание
					ИЛИ СтрокаТаблицы.КФО = Перечисления.КВД.СубсидииНаИныеЦели
					ИЛИ СтрокаТаблицы.КФО = Перечисления.КВД.СредстваОМС Тогда
					СтрокаТаблицы.КФО = Перечисления.КВД.Внебюджет;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
			
		ТаблицаЗачетАвансовПоДокументу = УчетРасчетов.ПодготовитьТаблицуЗачетАвансовПоДокументу(
			ДокументОбъект, Реквизиты);
		
		Если НЕ Отказ Тогда
		
			// Подготовим таблицу для отражения зачета авансов и увеличения (уменьшения) задолженности
			// документами поступления и реализации материальных запасов, услуг, ОС и пр.
			ТаблицаРасчетов = УчетРасчетов.ТаблицаРасчетовСЗачетомАвансов(
				ТаблицаДокумента,
				ТаблицаЗачетАвансовПоДокументу,
				Реквизиты, Отказ);
			
		КонецЕсли;
	КонецЕсли;
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ТаблицаРасчетовСЗачетомАвансовПоКомиссии", ТаблицаРасчетов.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

Функция ТаблицаРасчетовПриПоступленииДопРасходов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = ТаблицаРасчетовСЗачетомАвансов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ПартияВложений", ПланыВидовХарактеристик.ВидыСубконто.Партии.ТипЗначения);
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ТаблицаРасчетовСЗачетомАвансов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры);
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	Если Параметры.Свойство("ПартияВложений") И ЗначениеЗаполнено(Параметры.ПартияВложений) Тогда
		
		Если ТипЗнч(Параметры.ПартияВложений) <> Тип("ДокументСсылка.ПоступлениеОС") Тогда
			// КФО определим из проводок документа партии.
			КФОВложений = БухгалтерскиеОперации.РеквизитПроводкиДокумента("КФО",
				Параметры.ПартияВложений, "105.00,106.2П,106.3П,106.4П,106.27,106.37", "Дт");
			Параметры.Вставить("КФО", КФОВложений);
			
			Если НЕ ЗначениеЗаполнено(КФОВложений) Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Документ партии %1 не формирует проводок по счетам вложений в МЗ и БА (105.00, 106.2П, 106.3П, 106.27, 106.37).'"),
					Параметры.ПартияВложений);
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстОшибки, "ПартияМПЗ", Отказ);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(НСтр("ru='Документ партии не указан.'"), "ПартияМПЗ", Отказ);
		
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		
		// Подготовим таблицу для отражения зачета авансов и увеличения (уменьшения) задолженности
		// подготовим типовой процедурой.
		ТаблицаРасчетов = ТаблицаРасчетовСЗачетомАвансов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры);
		
	Иначе
		
		ТаблицаРасчетов = УчетРасчетов.ПустаяТаблицаРасчетовСЗачетомАвансов();
		
		// Сохраним флаг отказа в контексте проведения.
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		КонтекстПроведения.ДополнительныеСвойства.Вставить(
			"ТаблицаРасчетовСЗачетомАвансов", ТаблицаРасчетов.Скопировать());
		КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
		БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
		
	КонецЕсли;
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

Функция ТаблицаРасчетовПоОплатеТруда(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
