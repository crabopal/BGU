	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	// Подготовим таблицу для отражения выкупа ценных бумаг,
	ТаблицаВыкупа = УчетФинансовыхВложений.ТаблицаДляВыкупаЦенныхБумаг(Реквизиты, Параметры, Отказ);
	
