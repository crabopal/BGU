Функция ПоступлениеСредствСоСчета20123_ПоступлениеНаСчет(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ИмяСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КупленнаяВалюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СуммаКупленнойВалюты", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18, 2));
	
	Для Каждого Колонка Из Метаданные.Документы.ПоступлениеНаСчет.ТабличныеЧасти.ДетализацияПлатежа.Реквизиты Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.Тип);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
		
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РасшифровкаПлатежа = ПолучитьТаблицуДанныхИзИсточниковДанных(ИсточникиДанных, "ДетализацияПлатежа", Истина);
	
	КоэффициентыРаспределения = РасшифровкаПлатежа.ВыгрузитьКолонку("СуммаВал");
	СуммаКупленнойВалюты = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(РеквизитыДокумента.СуммаКупленнойВалюты, КоэффициентыРаспределения);
	
	ВалютаИТипЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.ЛицевойСчет, "ВалютаСчета, ТипЛицевогоСчета");
	ВалютаЛицевогоСчета = ВалютаИТипЛицевогоСчета.ВалютаСчета;
	ТипЛицевогоСчета = ВалютаИТипЛицевогоСчета.ТипЛицевогоСчета;
	
	Если ЗначениеЗаполнено(РеквизитыДокумента.ВалютаДокумента)
		И ЗначениеЗаполнено(ВалютаЛицевогоСчета)
		И НЕ РеквизитыДокумента.ВалютаДокумента = ВалютаЛицевогоСчета
		И ТипЛицевогоСчета = ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Банковский")
		И РеквизитыДокумента.КорСчет = ПланыСчетов.ЕПСБУ.ПустаяСсылка() Тогда
		ЕстьКонвертацияВалюты = Истина;
	Иначе
		ЕстьКонвертацияВалюты = Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаРасшифровкаПлатежа Из РасшифровкаПлатежа Цикл
		НоваяСтрока = ТаблицаРезультат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасшифровкаПлатежа);
		НоваяСтрока.ИмяСписка = "РасшифровкаПлатежа";
		НоваяСтрока.СинонимСписка = "Расшифровка платежа";
		Если ЕстьКонвертацияВалюты И СуммаКупленнойВалюты <> Неопределено Тогда
			НоваяСтрока.КупленнаяВалюта = ВалютаЛицевогоСчета;
			НоваяСтрока.СуммаКупленнойВалюты = СуммаКупленнойВалюты.Получить(СтрокаРасшифровкаПлатежа.НомерСтроки - 1);
		Иначе
			НоваяСтрока.КупленнаяВалюта = РеквизитыДокумента.ВалютаДокумента;
			НоваяСтрока.СуммаКупленнойВалюты = СтрокаРасшифровкаПлатежа.СуммаВал;
		КонецЕсли; 
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти

#Область КурсовыеРазницыНУ

// Отражение курсовых разниц в НУ при регламентной переоценке валютных остатков
// - во внереализационных доходах (расходах) налогового учета (Н91);
// - на счетах налогового учета отложенных (до момента погашения задолженности) курсовых разниц (Н92).
//
Функция ПереоценкаВалютныхОстатковНУ(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаПереоценкаВалютныхОстатковНУ = НалоговыйУчет.ПустаяТаблицаПереоценкаВалютныхОстатковНУ();
	Для Каждого Колонка Из ТаблицаПереоценкаВалютныхОстатковНУ.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаПереоценкаВалютныхОстатковНУ = НалоговыйУчет.ТаблицаПереоценкаВалютныхОстатковНУ(
		ИсточникиДанных.ДокументОбъект);
	
	Возврат ТаблицаПереоценкаВалютныхОстатковНУ;
	
КонецФункции

// Отражение отложенных курсовых разниц НУ во внереализационных доходах (расходах) при погашении задолженности
// документами движения денежных средств.
//
Функция ОтражениеОтложенныхКурсовыхРазницНУ(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаОтложенныхКурсовыхРазницНУ = НалоговыйУчет.ПустаяТаблицаОтложенныхКурсовыхРазницНУ();
	Для Каждого Колонка Из ТаблицаОтложенныхКурсовыхРазницНУ.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	Реквизиты.Вставить("КорСчет",         ДокументОбъект.КорСчет);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	
	Если ДополнительныеСвойства.Свойство("ТаблицаРасчетовСПогашениемЗадолженности") Тогда
		ТаблицаОтложенныхКурсовыхРазницНУ = НалоговыйУчет.ТаблицаОтложенныхКурсовыхРазницНУПриПогашенииЗадолженности(
			ДополнительныеСвойства.ТаблицаРасчетовСПогашениемЗадолженности,
			Реквизиты,
			Отказ);
	ИначеЕсли ДополнительныеСвойства.Свойство("РасшифровкаПлатежаУнифицированная") Тогда
		ТаблицаОтложенныхКурсовыхРазницНУ = НалоговыйУчет.ТаблицаОтложенныхКурсовыхРазницНУПоРасшифровкеПлатежа(
			ДополнительныеСвойства.РасшифровкаПлатежаУнифицированная,
			Реквизиты,
			Отказ);
	Иначе // Нет подходящих рассчитанных таблиц.
		
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
		Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
		РасшифровкаПлатежаУнифицированная = УчетРасчетов.ПодготовитьТаблицуРасшифровкаПлатежаПоДокументу(
			ДокументОбъект, Реквизиты, Отказ);
		
		ТаблицаОтложенныхКурсовыхРазницНУ = НалоговыйУчет.ТаблицаОтложенныхКурсовыхРазницНУПоРасшифровкеПлатежа(
			РасшифровкаПлатежаУнифицированная,
			Реквизиты,
			Отказ);
		
	КонецЕсли;
	
	Возврат ТаблицаОтложенныхКурсовыхРазницНУ;
	
КонецФункции

#КонецОбласти

#Область КонтрольИсполненияДоговоров

Функция ОплатаПоставщикамКредиторам(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции,
			"СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаОплатаПоставщикамКредиторам = КонтрольИсполненияДоговоров.ПустаяТаблицаОплатаПоставщикамКредиторам();
	Для Каждого Колонка Из ТаблицаОплатаПоставщикамКредиторам.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	
	Если НЕ ДополнительныеСвойства.Свойство("РасшифровкаПлатежаУнифицированная") Тогда
		
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
		Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
		
		РасшифровкаПлатежа = УчетРасчетов.ПодготовитьТаблицуРасшифровкаПлатежаПоДокументу(
			ДокументОбъект, Реквизиты, Отказ);
		ДополнительныеСвойства.Вставить("РасшифровкаПлатежаУнифицированная", РасшифровкаПлатежа);
		
	КонецЕсли;
	
	ТаблицаОплатаПоставщикамКредиторам = КонтрольИсполненияДоговоров.ТаблицаОплатаПоставщикамКредиторам(
		ДополнительныеСвойства.РасшифровкаПлатежаУнифицированная,
		ДокументОбъект,
		Реквизиты,
		Отказ);
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ТаблицаОплатаПоставщикамКредиторам", ТаблицаОплатаПоставщикамКредиторам.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаОплатаПоставщикамКредиторам;
	
КонецФункции

Функция ОплатаОтПокупателейДебиторов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции,
			"СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаОплатаОтПокупателейДебиторов = КонтрольИсполненияДоговоров.ПустаяТаблицаОплатаОтПокупателейДебиторов();
	Для Каждого Колонка Из ТаблицаОплатаОтПокупателейДебиторов.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	
	Если НЕ ДополнительныеСвойства.Свойство("РасшифровкаПлатежаУнифицированная") Тогда
		
		Если МетаданныеДокумента.Имя = "ПереносОплатыОбразование" Тогда
			
			РасшифровкаПлатежа = Документы.ПереносОплатыОбразование.ПодготовитьТаблицуРасшифровкаПлатежаПоДокументу(
				ДокументОбъект, Реквизиты, Отказ);
			ДополнительныеСвойства.Вставить("РасшифровкаПлатежаУнифицированная", РасшифровкаПлатежа);
			
		ИначеЕсли МетаданныеДокумента.Имя = "ПереносОплатыОтПокупателей" Тогда
			
			РасшифровкаПлатежа = Документы.ПереносОплатыОтПокупателей.ПодготовитьТаблицуРасшифровкаПлатежаПоДокументу(
				ДокументОбъект, Реквизиты, Отказ);
			ДополнительныеСвойства.Вставить("РасшифровкаПлатежаУнифицированная", РасшифровкаПлатежа);
			
		Иначе
			
			КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
			Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
			Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
			
			РасшифровкаПлатежа = УчетРасчетов.ПодготовитьТаблицуРасшифровкаПлатежаПоДокументу(
				ДокументОбъект, Реквизиты, Отказ);
			ДополнительныеСвойства.Вставить("РасшифровкаПлатежаУнифицированная", РасшифровкаПлатежа);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицаОплатаОтПокупателейДебиторов = КонтрольИсполненияДоговоров.ТаблицаОплатаОтПокупателейДебиторов(
		ДополнительныеСвойства.РасшифровкаПлатежаУнифицированная,
		ДокументОбъект,
		Реквизиты,
