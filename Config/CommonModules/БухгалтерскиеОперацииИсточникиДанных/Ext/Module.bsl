	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	
	Если НЕ ДополнительныеСвойства.Свойство("ТаблицаРасчетовСЗачетомАвансов") Тогда
		ВызватьИсключение "Не обнаружены данные расчетов с контрагентами.
			|Для формирования таблицы планируемых оплат используется таблица расчетов с контрагентами,
			|подготовленная функцией УчетРасчетов.ТаблицаРасчетовСЗачетомАвансов.";
	КонецЕсли;
	
	ТаблицыРеализации = Новый Структура;
	Если ДополнительныеСвойства.Свойство("ТаблицаРеализацияМатериальныхЗапасов") Тогда
		ТаблицыРеализации.Вставить("РеализацияМатериальныхЗапасов", ДополнительныеСвойства.ТаблицаРеализацияМатериальныхЗапасов);
	КонецЕсли;
	Если ДополнительныеСвойства.Свойство("ТаблицаРеализацияОсновныхСредств") Тогда
		ТаблицыРеализации.Вставить("РеализацияОсновныхСредств", ДополнительныеСвойства.ТаблицаРеализацияОсновныхСредств);
	КонецЕсли;
	Если ДополнительныеСвойства.Свойство("ТаблицаРеализацияУслугРабот") Тогда
		ТаблицыРеализации.Вставить("РеализацияУслугРабот", ДополнительныеСвойства.ТаблицаРеализацияУслугРабот);
	КонецЕсли;
	
	ТаблицаЗачетАвансовПолученныхУСН = УчетУСН.ТаблицаЗачетАвансовПолученныхУСН(
		ДополнительныеСвойства.ТаблицаРасчетовСЗачетомАвансов,
		ТаблицыРеализации,
		Реквизиты,
		Отказ);
	
	Возврат ТаблицаЗачетАвансовПолученныхУСН;
	
КонецФункции

// Отражение в УСН погашения задолженности документами поступления денежных средств от покупателей.
//
Функция ПогашениеЗадолженностиПокупателейУСН(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "УказатьВручнуюДоходыУСН", Новый ОписаниеТипов("Булево"));
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаПогашениеЗадолженностиПокупателейУСН = УчетУСН.ПустаяТаблицаПогашениеЗадолженностиПокупателейУСН();
	Для Каждого Колонка Из ТаблицаПогашениеЗадолженностиПокупателейУСН.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	Если МетаданныеДокумента.Имя = "ЭквайринговаяОперация" Тогда
		Если НЕ (ДокументОбъект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой
			 ИЛИ ДокументОбъект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЭлектроннымиСредствамиПлатежаПоРеестру
			 ИЛИ ДокументОбъект.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЧерезСервисПриемаПлатежей) Тогда
			Возврат ТаблицаПогашениеЗадолженностиПокупателейУСН; // Не отражается.
		КонецЕсли;
		Если ДокументОбъект.ОтменаОплатыВыполнена Тогда
			Возврат ТаблицаПогашениеЗадолженностиПокупателейУСН; // Не отражается.
		КонецЕсли;
	КонецЕсли;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	
	Если НЕ ДополнительныеСвойства.Свойство("ТаблицаРасчетовСПогашениемЗадолженности") Тогда
		ВызватьИсключение "Не обнаружены данные о погашении задолженности.
			|Для формирования таблицы сумм НДС для исключения из доходов УСН используется таблица погашения задолженности,
			|подготовленная функцией УчетРасчетов.ТаблицаРасчетовСПогашениемЗадолженности.";
	КонецЕсли;
	
	ТаблицаПогашениеЗадолженностиПокупателейУСН = УчетУСН.ТаблицаПогашениеЗадолженностиПокупателейУСН(
		ДополнительныеСвойства.ТаблицаРасчетовСПогашениемЗадолженности,
		Реквизиты,
		Отказ);
	
	Возврат ТаблицаПогашениеЗадолженностиПокупателейУСН;
	
КонецФункции

// Оплата поставщику (УСН)

// Начисление обязательств за счет резерва (неотфактурованные поставки)
//
Функция НачислениеОбязательствЗаСчетРезерваУСН(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаНачислениеОбязательствЗаСчетРезерваУСН = УчетУСН.ПустаяТаблицаНачислениеОбязательствЗаСчетРезерваУСН();
	Для Каждого Колонка Из ТаблицаНачислениеОбязательствЗаСчетРезерваУСН.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	// Поступление расходов будем отражать для всех таблиц поступления (материалов, тары, услуг и пр.),
	// которые сформированы к текущему моменту.
	ТаблицыПоступления = Новый Структура;
	
	Если ДополнительныеСвойства.Свойство("ТаблицаПоступлениеМатериальныхЗапасов") Тогда
		ТаблицыПоступления.Вставить("ПоступлениеМатериальныхЗапасов", ДополнительныеСвойства.ТаблицаПоступлениеМатериальныхЗапасов);
	Иначе
		ТаблицыПоступления.Вставить("ПоступлениеМатериальныхЗапасов", УправлениеМатериальнымиЗапасами.ПустаяТаблицаПоступлениеМатериальныхЗапасов());
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ТаблицаПоступлениеУслугРабот") Тогда
		ТаблицыПоступления.Вставить("ПоступлениеУслугРабот", ДополнительныеСвойства.ТаблицаПоступлениеУслугРабот);
	Иначе
		ТаблицыПоступления.Вставить("ПоступлениеУслугРабот", УчетРасчетов.ПустаяТаблицаПоступлениеУслугРабот());
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ТаблицаПоступлениеОсновныхСредств") Тогда
		ТаблицыПоступления.Вставить("ПоступлениеОсновныхСредств", ДополнительныеСвойства.ТаблицаПоступлениеОсновныхСредств);
	Иначе
		ТаблицыПоступления.Вставить("ПоступлениеОсновныхСредств", УправлениеОсновнымиСредствами.ПустаяТаблицаПоступлениеОсновныхСредств());
	КонецЕсли;
	
	ТаблицыПриемкаТоваровРаботУслуг = УчетУСН.ПодготовитьТаблицыПриемкаТоваровРаботУслугУСН(
		ТаблицыПоступления, ДокументОбъект, Реквизиты, Отказ);
	
	Если НЕ Отказ Тогда
		
		// Подготовим таблицу поступления расходов УСН по данным эквайринговой операции.
		ТаблицаНачислениеОбязательствЗаСчетРезерваУСН = УчетУСН.ТаблицаНачислениеОбязательствЗаСчетРезерваУСН(
			ТаблицыПриемкаТоваровРаботУслуг,
			Реквизиты,
			Отказ);
		
	КонецЕсли;
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаНачислениеОбязательствЗаСчетРезерваУСН", ТаблицаНачислениеОбязательствЗаСчетРезерваУСН.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаНачислениеОбязательствЗаСчетРезерваУСН;
	
КонецФункции

// Зачет авансов выданных поставщику при начислении обязательств за счет резерва (неотфактурованные поставки)
//
Функция ЗачетАвансовНачислениеОбязательствЗаСчетРезерваУСН(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаОплаченныхРасходовУСН = УчетУСН.ПустаяТаблицаОплаченныхРасходовУСН();
	Для Каждого Колонка Из ТаблицаОплаченныхРасходовУСН.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	
	Если НЕ ДополнительныеСвойства.Свойство("ТаблицаРасчетовСЗачетомАвансов") Тогда
		ВызватьИсключение "Не обнаружены данные зачета авансов.
			|Для формирования таблицы оплаченных расходов УСН  используется таблица зачета авансов,
			|подготовленная функцией УчетРасчетов.ТаблицаРасчетовСЗачетомАвансов.";
	КонецЕсли;
	
	Если НЕ ДополнительныеСвойства.Свойство("ТаблицаНачислениеОбязательствЗаСчетРезерваУСН") Тогда
		ВызватьИсключение "Не обнаружена таблица начисления обязательств за счет резерва для отражения расходов УСН.
			|Для формирования таблицы оплаченных расходов УСН  используется таблица начисления обязательств за счет резерва для отражения расходов УСН,
			|подготовленная функцией УчетУСН.НачислениеОбязательствЗаСчетРезерваУСН.";
	КонецЕсли;
	
	// Подготовим таблицу оплаченных расходов УСН за счет авансов поставщику,
	ТаблицаОплаченныхРасходовУСН = УчетУСН.ТаблицаЗачетАвансовПоставщикуУСН(
		ДополнительныеСвойства.ТаблицаНачислениеОбязательствЗаСчетРезерваУСН,
		ДополнительныеСвойства.ТаблицаРасчетовСЗачетомАвансов,
		Реквизиты,
		Отказ);
	// и сохраним ее для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ТаблицаЗачетАвансовНачислениеОбязательствЗаСчетРезерваУСН", ТаблицаОплаченныхРасходовУСН.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаОплаченныхРасходовУСН;
	
КонецФункции

#КонецОбласти

#Область ЗакрытиеГода

Функция ЗакрытиеГодаУпрощенно(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		Возврат Новый Массив;
		
	КонецЕсли;
	
	ОписаниеТипаСуммы		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества	= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТипаСтрока		= Новый ОписаниеТипов("Строка");
	ОписаниеТипаДата		= Новый ОписаниеТипов("Дата");
	ОписаниеТипаСубконто	= Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;

	ПоляФункции = Новый Массив;
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ВалютаДт",					Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ВалютаКт",					Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ВалютнаяСуммаДт",			ОписаниеТипаСуммы);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ВалютнаяСуммаКт",			ОписаниеТипаСуммы);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ВидПервичногоДокумента",   	ОписаниеТипаСтрока);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ДатаПервичногоДокумента",  	ОписаниеТипаДата);
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ИФО",						Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КПСДт",						Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КПСКт",						Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КФО",						Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КЭКДт",						Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
