		ТипСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
		
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
