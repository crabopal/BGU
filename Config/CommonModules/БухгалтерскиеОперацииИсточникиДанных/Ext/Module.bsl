	ТаблицаДокумента = УправлениеМатериальнымиЗапасами.ПодготовитьТаблицуРеализацияМатериальныхЗапасовПоДокументу(
		ДокументОбъект, Параметры);
	
	ТаблицаРасчетовСЗачетомАвансов = ?(ДополнительныеСвойства.Свойство("ТаблицаРасчетовСЗачетомАвансов"),
		ДополнительныеСвойства.ТаблицаРасчетовСЗачетомАвансов,
		Неопределено);
	
	// Подготовим таблицу для отражения реализации материальных запасов,
	ТаблицаРеализации = УправлениеМатериальнымиЗапасами.ТаблицаРеализацияМатериальныхЗапасов(
		ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты, Отказ);
	// и сохраним ее для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаРеализацияМатериальныхЗапасов",
		ТаблицаРеализации.Скопировать());
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаРеализации;
	
КонецФункции

Функция ВозвратМатериальныхЗапасовПоставщику(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ВосстанавливатьНДС", Новый ОписаниеТипов("Булево"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаВозврат = УправлениеМатериальнымиЗапасами.ПустаяТаблицаВозвратМатериальныхЗапасовПоставщику();
	Для Каждого Колонка Из ТаблицаВозврат.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	Если НЕ ДополнительныеСвойства.Свойство("ТаблицаСписаниеМатериальныхЗапасов") Тогда
		ВызватьИсключение "Не обнаружена таблица списания материальных запасов.
			|Для формирования таблицы возврата материальных запасов поставщику используется таблица списания материальных запасов,
			|подготовленная функцией УправлениеМатериальнымиЗапасами.ТаблицаСписаниеМатериальныхЗапасов.";
	КонецЕсли;
	
	// Подготовим таблицу для отражения возврата материальных запасов поставщику,
	ТаблицаВозврат = УправлениеМатериальнымиЗапасами.ТаблицаВозвратМатериальныхЗапасовПоставщику(
		ДокументОбъект,
		ДополнительныеСвойства.ТаблицаСписаниеМатериальныхЗапасов,
		Реквизиты, Отказ);
	
	// и сохраним ее для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаВозвратМатериальныхЗапасовПоставщику",
		ТаблицаВозврат.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаВозврат;
	
КонецФункции

Функция ДвижениеМЗНаХранениеПереработку(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		Возврат Новый Массив;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаСписания = УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасов();
	Для Каждого Колонка Из ТаблицаСписания.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	ТаблицаДокумента = УправлениеМатериальнымиЗапасами.ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(
		ДокументОбъект, Параметры, Отказ);
	
	Если НЕ Отказ Тогда
		
		Если ДокументОбъект.ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ПередачаНаХранениеВПереработку
				И ДокументОбъект.ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ПередачаНаРеализацию
				И ДокументОбъект.ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ВозвратТоваровПереданныхНаРеализацию
				И ДокументОбъект.ВидПередачиМЗ <> Перечисления.ВидыПередачиМЗ.ВозвратСХраненияИзПереработки Тогда
			ВызватьИсключение НСтр("ru = 'Функция источника данных ""Движение МЗ на хранение (в переработку)"" используется только для передачи
				|материалов на хранение (в переработку) и возврата с хранения (из переработки)'");
		КонецЕсли;
		
		УправлениеМатериальнымиЗапасами.ДоработатьТаблицуДокументаДляДвиженийРемонт(ДокументОбъект, ТаблицаДокумента);
		
		// Подготовим таблицу для отражения списания материальных запасов.
		ТаблицаСписания = УправлениеМатериальнымиЗапасами.ТаблицаСписаниеМатериальныхЗапасов(
			ТаблицаДокумента, Реквизиты, Отказ);
		
	КонецЕсли;
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ТаблицаСписаниеМатериальныхЗапасов", ТаблицаСписания.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаСписания;
	
КонецФункции

Функция ВыдачаМЗвЛичноеПользование(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	// Идентификация строки.
	ТаблицаРезультат.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаРезультат.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаРезультат.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Колонки исходной табличной части
	ТаблицаРезультат.Колонки.Добавить("Номенклатура",            Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаРезультат.Колонки.Добавить("ЦМОПолучатель",           Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаРезультат.Колонки.Добавить("ПодразделениеПолучатель", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаРезультат.Колонки.Добавить("КФО",                     Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаРезультат.Колонки.Добавить("СчетУчета",               Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаРезультат.Колонки.Добавить("КПС",                     Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаРезультат.Колонки.Добавить("Количество",              ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10,3));
	// Уникальные колонки
	ТаблицаРезультат.Колонки.Добавить("Сумма", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15,2));
	
	ПоляФункции = Новый Массив;
	Для Каждого Колонка Из ТаблицаРезультат.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	
	ТаблицаСписание = Неопределено;
	
	Если НЕ ДополнительныеСвойства.Свойство("ТаблицаСписаниеМатериальныхЗапасов", ТаблицаСписание) Тогда
		ВызватьИсключение "Не обнаружена таблица списания материальных запасов.
			|Для формирования таблицы выдачи имущества в личное пользование требуется источник данных,
			|подготовленный функцией СписаниеМатериальныхЗапасов.";
	КонецЕсли;
	
	ТаблицаМЗ = ПолучитьТаблицуДанныхИзИсточниковДанных(ИсточникиДанных, "МатериальныеЗапасы", Истина);
	
	СписокЦМОПолучателей = ТаблицаМЗ.ВыгрузитьКолонку("ЦМОПолучатель");
	ПолучателиСотрудники = СписокЦМОПолучателей.Количество() > 0 И ТипЗнч(СписокЦМОПолучателей[0]) = Тип("СправочникСсылка.Сотрудники");
	Если ПолучателиСотрудники Тогда
	
		РеквизитыСотрудников = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(СписокЦМОПолучателей, "Контрагент")
	
	КонецЕсли;
	
	СинонимСписка = Метаданные.Документы.ВедомостьНаВыдачуМЗНаНуждыУчреждения.ТабличныеЧасти.МатериальныеЗапасы.Синоним;
	КопияТаблицаСписания = ТаблицаСписание.Скопировать();
	КопияТаблицаСписания.Индексы.Добавить("НомерСтроки, СчетУчета");
	
	КФОШапки = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ИсточникиДанных.ДокументОбъект, "КФО");
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ИсточникиДанных.ДокументОбъект, "КФОВТабличнойЧасти") Тогда
		КФОШапки = НЕ ИсточникиДанных.ДокументОбъект.КФОВТабличнойЧасти;
	КонецЕсли;

	Для Каждого ТекСтрока Из ТаблицаМЗ Цикл
	
		НоваяСтрока = ТаблицаРезультат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		Если КФОШапки Тогда
			НоваяСтрока.КФО = ИсточникиДанных.ДокументОбъект.КФО;
		КонецЕсли;
		
		НоваяСтрока.ИмяСписка = "МатериальныеЗапасы";
		НоваяСтрока.СинонимСписка = СинонимСписка;
		
		Если ПолучателиСотрудники Тогда
			НоваяСтрока.ЦМОПолучатель = РеквизитыСотрудников.Получить(ТекСтрока.ЦМОПолучатель);
		КонецЕсли;
		
		НоваяСтрока.Сумма = КопияТаблицаСписания.Скопировать(
			Новый Структура("НомерСтроки, СчетУчета", ТекСтрока.НомерСтроки, ТекСтрока.СчетУчета), "Стоимость")
			.Итог("Стоимость");
	
	КонецЦикла;
	
	// сохраним результат для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаВыдачаМЗвЛичноеПользование",
		ТаблицаРезультат.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаРезультат;

КонецФункции

