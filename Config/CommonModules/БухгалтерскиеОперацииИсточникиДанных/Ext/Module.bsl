	КонецЕсли;
	
	ПересчитываемыеПоля = Новый Массив;
	ПересчитываемыеПоля.Добавить("Сумма");
	ПересчитываемыеПоля.Добавить("СуммаНДС");
	ПересчитываемыеПоля.Добавить("Всего");
	
