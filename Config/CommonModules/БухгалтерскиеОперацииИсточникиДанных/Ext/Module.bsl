	КонецЕсли;
	
	ПараметрыРасчетаАванса = СтруктураПараметровДляЗачетаАвансов(Параметры);
	ПараметрыПодготовкиТЧ = ОбщиеПараметрыПодготовкиТабличнойЧастиСЗачетомАвансов(ВариантВызова, ИсточникиДанных, Параметры, "КапВложения", ПоляФункции, ПересчитываемыеПоля, ПараметрыРасчетаАванса);
	ПараметрыПодготовкиТЧ.ИмяКолонкиДенежногоОбязательства = "Всего";	
	Возврат ПодготовитьТабличнуюЧастьСЗачетомАванса(ПараметрыПодготовкиТЧ);
	
КонецФункции // ПоступлениеМЗ_Материалы_СЗачетомАванса()

Функция ТаблицаПринятияДенежногоОбязательства_ПоступлениеОС(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	ГруппируемыеПоля = "КПС,КЭК";
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		Возврат ОписаниеПараметровДляФункцийПоступленияНФА("ПоступлениеОС");
		
	КонецЕсли;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		
		Возврат ОписаниеПолейТаблицыПринятияДенежногоОбязательства(ГруппируемыеПоля);

	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;	
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ОписаниеПолейТаблицыПринятияДенежногоОбязательства(ГруппируемыеПоля));
	
	ТаблицыДляРасчетаТаблицыПринятияДО = Новый Массив;
	ТаблицаРасчетаДО = ПоступлениеОС_КапВложения_СЗачетомАванса(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры);
	
	ПараметрыРасчетаАванса = СтруктураПараметровДляЗачетаАвансов(Параметры);
	Если ЗначениеЗаполнено(ПараметрыРасчетаАванса.Параметр_СчетВложения) Тогда
		ЗаданКЭК = Истина;
		КЭК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыРасчетаАванса.Параметр_СчетВложения, "КОСГУДт");
	Иначе
		ЗаданКЭК = Ложь;
	КонецЕсли;
	
	Для каждого ТекСтрока Из ТаблицаРасчетаДО Цикл
		
		Если ТекСтрока.СуммаДенежногоОбязательства <> 0 Тогда
			НоваяСтрока = ТаблицаРезультат.Добавить();
			НоваяСтрока.КПС				= ПараметрыРасчетаАванса.Параметр_КПС;
			Если ЗаданКЭК Тогда
				НоваяСтрока.КЭК	= КЭК;
			Иначе
				СчетУчета	= ТекСтрока.СчетУчета;
				НоваяСтрока.КЭК	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетУчета, "КОСГУДт");
			КонецЕсли;
			НоваяСтрока.Сумма			= ТекСтрока.СуммаДенежногоОбязательства;
			НоваяСтрока.Сумма_ВРублях	= ТекСтрока.СуммаДенежногоОбязательства_ВРублях;
		КонецЕсли;
	
	КонецЦикла;
	
	ТаблицаРезультат.Свернуть(ГруппируемыеПоля, "Сумма, Сумма_ВРублях");
	
	Возврат ТаблицаРезультат;
		
КонецФункции // ТаблицаПринятияДенежногоОбязательства_МЗ()


// --- ПКО фондовый ---

Функция ТаблицаЗачетаАванса_ПКО(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ТаблицаЗачетаАванса_Основная(ВариантВызова, ИсточникиДанных, Неопределено, Неопределено);
	КонецЕсли;		
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДокументСсылка = КонтекстПроведения.Ссылка;
	ТипЗначенияСсылки = ТипЗнч(ДокументСсылка);
	
	ПараметрыРасчетаАванса = СтруктураПараметровДляЗачетаАвансов(Параметры);
	
	ТаблицаРасчетов = ТаблицаРасчетовДляЗачетаАвансов(КонтекстПроведения, ИсточникиДанных, ПараметрыРасчетаАванса);

	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	СтрокаДокумента = ИсточникиДанных["Документ"][0];
	ТекущийКонтекст = Новый Структура;
	ТекущийКонтекст.Вставить("Период", ?(ДокументСсылка.Пустая(), СтрокаДокумента[ПрефиксДокумента + "Дата"], ДокументСсылка));
	ТекущийКонтекст.Вставить("ТаблицаРасчетов", ТаблицаРасчетов);
	
	КонтекстПроведения.ДополнительныеСвойства.Вставить("КонтекстРасчетаАвансов", ТекущийКонтекст);
	
	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	ПараметрыРасчетаОстатковАвансов = ПараметрыРасчетаТаблицыАвансов();
	
	Объект = ИсточникиДанных.Документ[0];
	Ссылка = Объект[ПрефиксДокумента + "Ссылка"];
	Если Ссылка.Пустая() Тогда
		Период = Новый Граница(КонецДня(Объект[ПрефиксДокумента + "Дата"]), ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	ПараметрыРасчетаОстатковАвансов.Период 		= Период;
	ПараметрыРасчетаОстатковАвансов.ИФО			= Объект[ПрефиксДокумента + "ИФО"];
	ПараметрыРасчетаОстатковАвансов.Организация = Объект[ПрефиксДокумента + "Организация"];
	ПараметрыРасчетаОстатковАвансов.Контрагент	= Объект[ПрефиксДокумента + "Контрагент"];
	ПараметрыРасчетаОстатковАвансов.Договор		= Объект[ПрефиксДокумента + "Договор"];
	
	Если ЗначениеЗаполнено(ПараметрыРасчетаАванса.Параметр_КФО) Тогда
		ПараметрыРасчетаОстатковАвансов.КФО.Добавить(ПараметрыРасчетаАванса.Параметр_КФО);
	КонецЕсли;
	
	Для каждого СтрокаТаблицыРасчетов Из ТаблицаРасчетов Цикл

		Если ПараметрыРасчетаОстатковАвансов.КФО.Найти(СтрокаТаблицыРасчетов.КФО) = Неопределено Тогда
			ПараметрыРасчетаОстатковАвансов.КФО.Добавить(СтрокаТаблицыРасчетов.КФО);
		КонецЕсли;
		Если ПараметрыРасчетаОстатковАвансов.КПС.Найти(СтрокаТаблицыРасчетов.КПС) = Неопределено Тогда
			ПараметрыРасчетаОстатковАвансов.КПС.Добавить(СтрокаТаблицыРасчетов.КПС);
		КонецЕсли;
		Если ПараметрыРасчетаОстатковАвансов.Счета302.Найти(СтрокаТаблицыРасчетов.СчетРасчетов) = Неопределено Тогда
			ПараметрыРасчетаОстатковАвансов.Счета302.Добавить(СтрокаТаблицыРасчетов.СчетРасчетов);
		КонецЕсли;
		Если ПараметрыРасчетаОстатковАвансов.КЭК.Найти(БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(СтрокаТаблицыРасчетов.СчетРасчетов)) = Неопределено Тогда
			ПараметрыРасчетаОстатковАвансов.КЭК.Добавить(БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(СтрокаТаблицыРасчетов.СчетРасчетов));
		КонецЕсли;

	КонецЦикла;

	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	ТаблицаЗачетаАванса = ТаблицаЗачетаАванса_Основная(ВариантВызова, ИсточникиДанных, ПараметрыРасчетаАванса, ПараметрыРасчетаОстатковАвансов);
	
	Возврат ТаблицаЗачетаАванса;
	
КонецФункции


