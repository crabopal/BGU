Функция ОплаченныеРасходыУСНПоАвансовомуОтчету(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаОплаченныхРасходовУСН = УчетУСН.ПустаяТаблицаОплаченныхРасходовУСН();
	Для Каждого Колонка Из ТаблицаОплаченныхРасходовУСН.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	Если НЕ ДополнительныеСвойства.Свойство("ТаблицаПоступлениеРасходовУСН") Тогда
		ВызватьИсключение "Не обнаружена таблица поступления расходов УСН.
			|Для формирования таблицы оплаченных расходов УСН  используется таблица поступления расходов УСН,
			|подготовленная функцией УчетУСН.ТаблицаПоступлениеРасходовУСН.";
	КонецЕсли;
	
	// 1. Расходы на приобретение материальных запасов, услуг и пр. считаем оплаченными,
	// т.к. при регистрации авансового отчета расчеты с подотчетным лицом должны быть завершены.
	ТаблицаОплаченныхРасходовУСН = УчетУСН.ТаблицаОплаченныеАвансомРасходыПодотчетнихЛиц(
		ДополнительныеСвойства.ТаблицаПоступлениеРасходовУСН,
		Реквизиты,
		Отказ);
	
	// 2. Добавим расходы УСН, оплаченные подотчетным лицом поставщикам.
	ТаблицаОплатПоставщикам = УчетУСН.ПодготовитьТаблицуОплатПоставщикамПодотчетнымЛицом(
		Реквизиты.Ссылка, Реквизиты);
	РасходыУСНОплаченныеПоставщикуПодотчетнымЛицом = УчетУСН.ТаблицаОплатаПоставщикуУСН(
		ТаблицаОплатПоставщикам,
		Реквизиты,
		Отказ);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(
		РасходыУСНОплаченныеПоставщикуПодотчетнымЛицом,
		ТаблицаОплаченныхРасходовУСН);
	
	// 3. Добавим расходы УСН по зарегистрированным ранее приходным документам, указанным в строках авансового отчета.
	ТаблицаОплатПоПриходнымДокументам = УчетУСН.ПодготовитьТаблицуОплатПоПриходнымДокументам(
		Реквизиты.Ссылка, Реквизиты);
	ОплаченныеРасходыУСНПоПриходнымДокументам = УчетУСН.ТаблицаОплатаПоставщикуУСН(
		ТаблицаОплатПоПриходнымДокументам,
		Реквизиты,
		Отказ);
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(
		ОплаченныеРасходыУСНПоПриходнымДокументам,
		ТаблицаОплаченныхРасходовУСН);
	
	Возврат ТаблицаОплаченныхРасходовУСН;
	
КонецФункции

