	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаПоступления;
	
КонецФункции

Функция ВосстановлениеМатериальныхЗапасов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	ТипИФО           = Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения");
	ТипКФО           = Новый ОписаниеТипов("ПеречислениеСсылка.КВД");
	ТипКПС           = Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов");
	ТипПодразделение = Новый ОписаниеТипов("СправочникСсылка.Подразделения");
	ТипЦМО           = Новый ОписаниеТипов("СправочникСсылка.ЦМО");
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ИФО",                     ТипИФО);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",                     ТипКФО);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",                     ТипКПС);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Подразделение",           ТипПодразделение);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ПодразделениеПолучатель", ТипПодразделение);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ЦМОПолучатель",           ТипЦМО);
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаВосстановления = УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасов();
	Для Каждого Колонка Из ТаблицаВосстановления.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ВидПоступленияМЗ") Тогда
		ОприходованиеСЗабалансовогоСчета = ДокументОбъект.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ОприходованиеСЗабалансовогоСчета;
	Иначе
		ОприходованиеСЗабалансовогоСчета = Истина;
	КонецЕсли;
	
	Если ОприходованиеСЗабалансовогоСчета Тогда
	
		ТаблицаДокумента = УправлениеМатериальнымиЗапасами.ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(
			ДокументОбъект, Параметры, Отказ);
		
		Если НЕ Отказ Тогда
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ЗабалансовыйСчет") Тогда
				ЗабалансовыйСчет = ДокументОбъект.ЗабалансовыйСчет;
			Иначе
				ЗабалансовыйСчет = БухгалтерскийУчет.СчетПоКоду("02.4", ДокументОбъект.Дата, ДокументОбъект.Организация);
			КонецЕсли;
			
			Если БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(ЗабалансовыйСчет, ПланыВидовХарактеристик.ВидыСубконто.Номенклатура) Тогда			
				// Подготовим таблицу для отражения списания материальных запасов.
				ВременнаяТаблица = УправлениеМатериальнымиЗапасами.ТаблицаСписаниеМатериальныхЗапасов(
					ТаблицаДокумента, Реквизиты, Отказ);
			Иначе
				ВременнаяТаблица = ТаблицаДокумента;
			КонецЕсли;
		
			Для Каждого Строка Из ВременнаяТаблица Цикл
				ЗаполнитьЗначенияСвойств(ТаблицаВосстановления.Добавить(), Строка);
			КонецЦикла;
			
		КонецЕсли;
			
	КонецЕсли;
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ТаблицаВосстановлениеМатериальныхЗапасов", ТаблицаВосстановления.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаВосстановления;
	
КонецФункции

Функция СписаниеОСПриВосстановленииМатериальныхЗапасов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ОписаниеТиповСубконто  = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ТаблицаСписания = Новый ТаблицаЗначений;
	ТаблицаСписания.Колонки.Добавить("ИмяСписка", Новый ОписаниеТипов("Строка")); 
	ТаблицаСписания.Колонки.Добавить("СинонимСписка", Новый ОписаниеТипов("Строка")); 
	ТаблицаСписания.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0))); 
	ТаблицаСписания.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД")); 
	ТаблицаСписания.Колонки.Добавить("СубконтоЗабалансовыйСчет1", ОписаниеТиповСубконто); 
	ТаблицаСписания.Колонки.Добавить("СубконтоЗабалансовыйСчет2", ОписаниеТиповСубконто); 
	ТаблицаСписания.Колонки.Добавить("СубконтоЗабалансовыйСчет3", ОписаниеТиповСубконто); 
	ТаблицаСписания.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3))); 
	ТаблицаСписания.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2))); 

	Для Каждого Колонка Из ТаблицаСписания.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ВидПоступленияМЗ") Тогда
		ОприходованиеСЗабалансовогоСчета = ДокументОбъект.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ОприходованиеСЗабалансовогоСчета;
	Иначе
		ОприходованиеСЗабалансовогоСчета = Истина;
	КонецЕсли;
	
	Если ОприходованиеСЗабалансовогоСчета Тогда
	
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ЗабалансовыйСчет") Тогда
			ЗабалансовыйСчет = ДокументОбъект.ЗабалансовыйСчет;
		Иначе
			ЗабалансовыйСчет = БухгалтерскийУчет.СчетПоКоду("02.4", ДокументОбъект.Дата, ДокументОбъект.Организация);
		КонецЕсли;
		
		Если БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(ЗабалансовыйСчет, ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства) Тогда			
		
			ТаблицаСписания = ТаблицаСписаниеОсновныхСредствСЗабаланса(ДокументОбъект, Отказ);
			
		КонецЕсли;	
			
	КонецЕсли;
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ТаблицаСписанияОСПриВосстановленииМатериальныхЗапасов", ТаблицаСписания.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаСписания;
	
КонецФункции

Функция ТаблицаСписанияМЗ (ИсточникиДанных, ТиповаяОперация, Параметры, ВариантВызова)

	ПоляФункции = Новый Массив;
	
	ТаблицаСписания = УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасов();
	Для Каждого Колонка Из ТаблицаСписания.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	РассчитанныеДанные = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДокументОбъект.ДополнительныеСвойства, "РассчитанныеДанные");
	
	ИспользуетсяСохраненнаяТаблицаСписания = Ложь;
	Если РассчитанныеДанные <> Неопределено И ТипЗнч(РассчитанныеДанные) = Тип("Структура") Тогда
		ТаблицаСписания = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РассчитанныеДанные, "ТаблицаСписания");
		ИспользуетсяСохраненнаяТаблицаСписания = Истина;
	КонецЕсли;
	
	Если НЕ ИспользуетсяСохраненнаяТаблицаСписания Тогда
		ТаблицаДокумента = УправлениеМатериальнымиЗапасами.ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(
			ДокументОбъект, Параметры, Отказ);
		
		Если НЕ Отказ Тогда
			
			// Подготовим таблицу для отражения списания материальных запасов.
			ТаблицаСписания = УправлениеМатериальнымиЗапасами.ТаблицаСписаниеМатериальныхЗапасов(
				ТаблицаДокумента, Реквизиты, Отказ);
			
		КонецЕсли;
	КонецЕсли;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	
	// Используем резервы на 114 при их наличии
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Реквизиты, "УчитыватьРезерв", Ложь) Тогда
		ТаблицаСписаниеРезервовМатериальныхЗапасов = УправлениеМатериальнымиЗапасами.ТаблицаСписаниеРезервовМатериальныхЗапасов(
			ТаблицаСписания, ИсточникиДанных.ДокументОбъект, Реквизиты);
		КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ТаблицаСписаниеРезервовМатериальныхЗапасов", ТаблицаСписаниеРезервовМатериальныхЗапасов);
	КонецЕсли;

	// Сохраним Отказ и таблицу для формирования других источников данных.
	КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ТаблицаСписаниеМатериальныхЗапасов", ТаблицаСписания.Скопировать());
	Если Отказ Тогда
		КонтекстПроведения.Отказ = Истина;
	КонецЕсли;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаСписания;
	
КонецФункции

Функция СписаниеМатериальныхЗапасов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	ТипИФО           = Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения");
	ТипКФО           = Новый ОписаниеТипов("ПеречислениеСсылка.КВД");
	ТипКПС           = Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов");
	ТипПодразделение = Новый ОписаниеТипов("СправочникСсылка.Подразделения");
	ТипЦМО           = Новый ОписаниеТипов("СправочникСсылка.ЦМО");
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ИФО",                                   ТипИФО);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",                                   ТипКФО);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",                                   ТипКПС);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Подразделение",                         ТипПодразделение);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ПодразделениеПолучатель",               ТипПодразделение);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ЦМОПолучатель",                         ТипЦМО);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "УчитыватьРезерв",                       Новый ОписаниеТипов("Булево"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "УменьшатьСтоимостьНаСуммуРезерва",      Новый ОписаниеТипов("Булево"));

		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	Возврат ТаблицаСписанияМЗ (ИсточникиДанных, ТиповаяОперация, Параметры, ВариантВызова);
	
КонецФункции

