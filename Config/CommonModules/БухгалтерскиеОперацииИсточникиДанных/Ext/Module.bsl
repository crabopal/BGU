Функция МатериальныеЦенностиСДрагМатериалами(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
		
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаМЦСДрагМатериалами = УчетДрагМатериалов.ПустаяТаблицаМЦСДрагМатериалами();
	Для Каждого Колонка Из ТаблицаМЦСДрагМатериалами.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;                
	// Подготовим таблицу для отражения реализации материальных ценностей,
	ТаблицаМЦСДрагМатериалами = УчетДрагМатериалов.ПодготовитьТаблицуМЦСДрагМатериаламиПоДокументу(
		Реквизиты.Ссылка, Параметры);
	// и сохраним ее для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаМЦСДрагМатериалами", ТаблицаМЦСДрагМатериалами.Скопировать());
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаМЦСДрагМатериалами;
	
КонецФункции

Функция СписаниеКапВложенийНУ(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаСписаниеКапВложенийНУ = НалоговыйУчет.ПустаяТаблицаСписаниеКапВложенийНУ();
	Для Каждого Колонка Из ТаблицаСписаниеКапВложенийНУ.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;                
	
	Реквизиты.Вставить("ПериодОстатков", НалоговыйУчет.ПериодПолученияОстатков(ДокументОбъект));
	
	ТаблицаДокумента = НалоговыйУчет.ПодготовитьТаблицуСписаниеКапВложенийНУПоДокументу(
		Реквизиты.Ссылка, Параметры);
	
	// Подготовим таблицу для отражения реализации основных средств,
	ТаблицаСписаниеКапВложенийНУ = НалоговыйУчет.ТаблицаСписаниеКапВложенийНУ(ТаблицаДокумента, Реквизиты);
	// и сохраним ее для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаСписаниеКапВложенийНУ", ТаблицаСписаниеКапВложенийНУ.Скопировать());
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаСписаниеКапВложенийНУ;
	
КонецФункции

Функция ПолучитьСтрокуИдентификаторов(СсылкаЦМО, СсылкаКПС)
	Результат = ""; 
	
	МассивСсылок = Новый Массив;
	МассивСсылок.Добавить(СсылкаЦМО);
	МассивСсылок.Добавить(СсылкаКПС);
	
	Для каждого ТекСсылка из МассивСсылок Цикл
		Если НЕ ЗначениеЗаполнено(ТекСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + ТекСсылка.УникальныйИдентификатор();
	КонецЦикла;		
	
	Возврат Результат;	
КонецФункции	

Функция ОстаткиСтоимостиГрупповогоОбъекта(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		ПоляФункции = Новый Массив;
		ТипСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
		
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ОсновноеСредствоНовое", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ИнвентарныйНомерНовый", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Субконто2", ТипСубконто);
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Субконто3", ТипСубконто);
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Количество", Новый ОписаниеТипов("Число"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Сумма", Новый ОписаниеТипов("Число"));

		Возврат ПоляФункции;
	КонецЕсли;	
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		
		Возврат ПараметрыФункции;
	КонецЕсли;	

	ДокументОбъект = ИсточникиДанных["ДокументОбъект"];
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Счета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ПОДСТРОКА(ЕПСБУ.Код, 1, 3) В (""101"", ""102"", ""103"", ""108"")
	|	И НЕ ЕПСБУ.Забалансовый
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧИнвентарныеНомера.ИнвентарныйНомерВГруппе КАК ИнвентарныйНомерВГруппе,
	|	ТЧИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредствоНовое,
	|	ТЧИнвентарныеНомера.ИнвентарныйНомер КАК ИнвентарныйНомерНовый
	|ПОМЕСТИТЬ ТЧ_ИнвентарныеНомера
	|ИЗ
	|	&ТЧИнвентарныеНомера КАК ТЧИнвентарныеНомера
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ЦМО)
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ЦМО)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|	КОНЕЦ КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Субконто3
	|ПОМЕСТИТЬ ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаПроведения,
	|			Счет В
	|				(ВЫБРАТЬ
	|					Таб.Ссылка
	|				ИЗ
	|					Счета КАК Таб),
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &ОС) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомерВГруппе,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ОсновноеСредствоНовое, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК ОсновноеСредствоНовое,
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ИнвентарныйНомерНовый, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК ИнвентарныйНомерНовый,
	|	СУММА(СтоимостьОбъектовОСОстатки.КоличествоОстаток) КАК Количество,
	|	СУММА(СтоимостьОбъектовОСОстатки.СтоимостьОстаток) КАК Сумма
	|ПОМЕСТИТЬ ОстаткиРН
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&ДатаПроведения,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОС
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТЧ_ИнвентарныеНомера КАК ТЧ_ИнвентарныеНомера
	|		ПО СтоимостьОбъектовОСОстатки.ИнвентарныйНомер = ТЧ_ИнвентарныеНомера.ИнвентарныйНомерВГруппе
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО,
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ОсновноеСредствоНовое, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)),
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ИнвентарныйНомерНовый, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиБУ.Счет КАК Счет,
	|	ОстаткиБУ.КПС КАК КПС,
	|	ОстаткиБУ.ИФО КАК ИФО,
	|	ОстаткиБУ.Подразделение КАК Подразделение,
	|	ОстаткиБУ.КФО КАК КФО,
	|	ОстаткиБУ.ОсновноеСредство КАК ОсновноеСредство,
	|	ЕСТЬNULL(ОстаткиРН.ИнвентарныйНомерВГруппе, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК ИнвентарныйНомер,
	|	ЕСТЬNULL(ОстаткиРН.ОсновноеСредствоНовое, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК ОсновноеСредствоНовое,
	|	ЕСТЬNULL(ОстаткиРН.ИнвентарныйНомерНовый, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК ИнвентарныйНомерНовый,
	|	ОстаткиБУ.Субконто2 КАК Субконто2,
	|	ОстаткиБУ.Субконто3 КАК Субконто3,
	|	ОстаткиРН.Количество КАК Количество,
	|	ОстаткиРН.Сумма КАК Сумма
	|ИЗ
	|	ОстаткиБУ КАК ОстаткиБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиРН КАК ОстаткиРН
	|		ПО ОстаткиБУ.ОсновноеСредство = ОстаткиРН.ОсновноеСредство
	|			И ОстаткиБУ.ЦМО = ОстаткиРН.ЦМО";	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаПроведения", ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ОС", ДокументОбъект.ОсновноеСредствоГрупповое);
	Запрос.УстановитьПараметр("ТЧИнвентарныеНомера", ДокументОбъект["ИнвентарныеНомера"].Выгрузить());
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

Функция ОстаткиАмортизацииГрупповогоОбъекта(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		ПоляФункции = Новый Массив;
		ТипСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
		
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ЭтоАмортизация", Новый ОписаниеТипов("Булево"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ОсновноеСредствоНовое", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ИнвентарныйНомерНовый", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Субконто2", ТипСубконто);
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Субконто3", ТипСубконто);
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"СуммаАмортизации", Новый ОписаниеТипов("Число"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"СуммаОбесценения", Новый ОписаниеТипов("Число"));

		Возврат ПоляФункции;
	КонецЕсли;	
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		
		Возврат ПараметрыФункции;
	КонецЕсли;	

	ДокументОбъект = ИсточникиДанных["ДокументОбъект"];
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Счета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ПОДСТРОКА(ЕПСБУ.Код, 1, 3) В (""104"", ""114"")
	|	И НЕ ЕПСБУ.Забалансовый
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧИнвентарныеНомера.ИнвентарныйНомерВГруппе КАК ИнвентарныйНомерВГруппе,
	|	ТЧИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредствоНовое,
	|	ТЧИнвентарныеНомера.ИнвентарныйНомер КАК ИнвентарныйНомерНовый
	|ПОМЕСТИТЬ ТЧ_ИнвентарныеНомера
	|ИЗ
	|	&ТЧИнвентарныеНомера КАК ТЧИнвентарныеНомера
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ЖурналПроводокЕПСБУОстатки.Счет.Код, 1, 3) = ""104""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоАмортизация,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Субконто3
	|ПОМЕСТИТЬ ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаПроведения, Счет В
	|		(ВЫБРАТЬ
	|			Таб.Ссылка
	|		ИЗ
	|			Счета КАК Таб),, Организация = &Организация
	|	И Субконто1 = &ОС) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АмортизацияОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомерВГруппе,
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ОсновноеСредствоНовое, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК
	|		ОсновноеСредствоНовое,
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ИнвентарныйНомерНовый, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК
	|		ИнвентарныйНомерНовый,
	|	СУММА(АмортизацияОбъектовОС.СуммаАмортизацииОстаток) КАК СуммаАмортизации,
	|	СУММА(АмортизацияОбъектовОС.СуммаОбесцененияОстаток) КАК СуммаОбесценения
	|ПОМЕСТИТЬ ОстаткиРН
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС.Остатки(&ДатаПроведения, Организация = &Организация
	|	И ОсновноеСредство = &ОС) КАК АмортизацияОбъектовОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТЧ_ИнвентарныеНомера КАК ТЧ_ИнвентарныеНомера
	|		ПО АмортизацияОбъектовОС.ИнвентарныйНомер = ТЧ_ИнвентарныеНомера.ИнвентарныйНомерВГруппе
	|СГРУППИРОВАТЬ ПО
	|	АмортизацияОбъектовОС.ОсновноеСредство,
	|	АмортизацияОбъектовОС.ИнвентарныйНомер,
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ОсновноеСредствоНовое, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)),
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ИнвентарныйНомерНовый, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиБУ.Счет КАК Счет,
	|	ОстаткиБУ.ЭтоАмортизация КАК ЭтоАмортизация,
	|	ОстаткиБУ.КПС КАК КПС,
	|	ОстаткиБУ.ИФО КАК ИФО,
	|	ОстаткиБУ.Подразделение КАК Подразделение,
	|	ОстаткиБУ.КФО КАК КФО,
	|	ОстаткиБУ.ОсновноеСредство КАК ОсновноеСредство,
	|	ЕСТЬNULL(ОстаткиРН.ИнвентарныйНомерВГруппе, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК
	|		ИнвентарныйНомер,
	|	ЕСТЬNULL(ОстаткиРН.ОсновноеСредствоНовое, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК
	|		ОсновноеСредствоНовое,
	|	ЕСТЬNULL(ОстаткиРН.ИнвентарныйНомерНовый, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК
	|		ИнвентарныйНомерНовый,
	|	ОстаткиБУ.Субконто2 КАК Субконто2,
	|	ОстаткиБУ.Субконто3 КАК Субконто3,
	|	ОстаткиРН.СуммаАмортизации КАК СуммаАмортизации,
	|	ОстаткиРН.СуммаОбесценения КАК СуммаОбесценения
	|ИЗ
	|	ОстаткиБУ КАК ОстаткиБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиРН КАК ОстаткиРН
	|		ПО ОстаткиБУ.ОсновноеСредство = ОстаткиРН.ОсновноеСредство";	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаПроведения", ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ОС", ДокументОбъект.ОсновноеСредствоГрупповое);
	Запрос.УстановитьПараметр("ТЧИнвентарныеНомера", ДокументОбъект["ИнвентарныеНомера"].Выгрузить());
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

Функция ОстаткиСтоимостиГрупповогоОбъектаНУ(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		ПоляФункции = Новый Массив;
		ТипСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
		
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ОсновноеСредствоНовое", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ИнвентарныйНомерНовый", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Сумма", Новый ОписаниеТипов("Число"));

		Возврат ПоляФункции;
	КонецЕсли;	
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		
		Возврат ПараметрыФункции;
	КонецЕсли;	

	ДокументОбъект = ИсточникиДанных["ДокументОбъект"];
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Счета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ПОДСТРОКА(ЕПСБУ.Код, 1, 3) В (""Н01"", ""Н04"")
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧИнвентарныеНомера.ИнвентарныйНомерВГруппе КАК ИнвентарныйНомерВГруппе,
	|	ТЧИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредствоНовое,
	|	ТЧИнвентарныеНомера.ИнвентарныйНомер КАК ИнвентарныйНомерНовый
	|ПОМЕСТИТЬ ТЧ_ИнвентарныеНомера
	|ИЗ
	|	&ТЧИнвентарныеНомера КАК ТЧИнвентарныеНомера
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстаток) КАК Сумма
	|ПОМЕСТИТЬ ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаПроведения, Счет В
	|		(ВЫБРАТЬ
	|			Таб.Ссылка
	|		ИЗ
	|			Счета КАК Таб),, Организация = &Организация
	|	И Субконто1 = &ОС) КАК ЖурналПроводокЕПСБУОстатки
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.ИФО,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(СтоимостьОбъектовОСОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ КоличествоОбъектовПоРН
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&ДатаПроведения, Организация = &Организация
	|	И ОсновноеСредство = &ОС
	|	И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиБУ.Счет КАК Счет,
	|	ОстаткиБУ.ИФО КАК ИФО,
	|	ОстаткиБУ.Подразделение КАК Подразделение,
	|	ОстаткиБУ.КФО КАК КФО,
	|	ОстаткиБУ.ОсновноеСредство КАК ОсновноеСредство,
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ИнвентарныйНомерВГруппе, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК
	|		ИнвентарныйНомер,
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ОсновноеСредствоНовое, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК
	|		ОсновноеСредствоНовое,
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ИнвентарныйНомерНовый, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК
	|		ИнвентарныйНомерНовый,
	|	ВЫБОР
	|		КОГДА КоличествоОбъектовПоРН.Количество = 0
	|			ТОГДА ОстаткиБУ.Сумма
	|		ИНАЧЕ ОстаткиБУ.Сумма / КоличествоОбъектовПоРН.Количество
	|	КОНЕЦ КАК Сумма
	|ИЗ
	|	ОстаткиБУ КАК ОстаткиБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоОбъектовПоРН КАК КоличествоОбъектовПоРН
	|		ПО ОстаткиБУ.ОсновноеСредство = КоличествоОбъектовПоРН.ОсновноеСредство,
	|	ТЧ_ИнвентарныеНомера КАК ТЧ_ИнвентарныеНомера";	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаПроведения", ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ОС", ДокументОбъект.ОсновноеСредствоГрупповое);
	Запрос.УстановитьПараметр("ТЧИнвентарныеНомера", ДокументОбъект["ИнвентарныеНомера"].Выгрузить());
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

Функция ОстаткиАмортизацииГрупповогоОбъектаНУ(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
