Функция ПринятиеКУчетуОсновныхСредствПоКПС(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ИмяСписка"						, Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(80)));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "НомерСтроки"					, Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5,0, ДопустимыйЗнак.Неотрицательный)));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ОбъектВложений"					, Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КПСВложений"					, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СчетВложений"					, Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ЦМОВложений"					, Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ДоговорВложений"				, Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КоличествоВложений"				, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,0)));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СуммаВложений"					, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СуммаВложенийНУ"				, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СуммаВложенийНеУчитываетсяНУ"	, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СуммаВложенийЕНВД"				, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
	// Добавляем все колонки таб.части "ОсновныеСредства".
	Для Каждого КолонкаДокумента Из Метаданные.Документы.ПринятиеКУчетуОбъектовОС.ТабличныеЧасти.ОсновныеСредства.Реквизиты Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, КолонкаДокумента.Имя, КолонкаДокумента.Тип);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	ТаблицаКапВложений = ПолучитьТаблицуДанныхИзИсточниковДанных(ИсточникиДанных, "КапитальныеВложения", Истина);
	КоэффициентыРаспределенияСуммы = ТаблицаКапВложений.ВыгрузитьКолонку("Сумма");
	КоэффициентыРаспределенияКоличества = ТаблицаКапВложений.ВыгрузитьКолонку("Количество");
	КоличествоСтрокВложений = ТаблицаКапВложений.Количество();
	
	ВедетсяУчетКапВложенийНУПоКПСиЦМО = НалоговыйУчет.ОтражатьВНалоговомУчете(ДокументОбъект.Организация, ДокументОбъект.Дата, ДокументОбъект.КФО)
		И (НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоКПС(ДокументОбъект.Дата)
		ИЛИ НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоЦМО(ДокументОбъект.Дата));
	Если ВедетсяУчетКапВложенийНУПоКПСиЦМО Тогда
		КоэффициентыРаспределенияСуммаНУ = ТаблицаКапВложений.ВыгрузитьКолонку("СуммаНУ");
		КоэффициентыРаспределенияСуммаНеУчитываетсяНУ = ТаблицаКапВложений.ВыгрузитьКолонку("СуммаНеУчитываетсяНУ");
		КоэффициентыРаспределенияСуммаЕНВД = ТаблицаКапВложений.ВыгрузитьКолонку("СуммаЕНВД");
	КонецЕсли;
	
	Если ТаблицаКапВложений.Колонки.Найти("Договор") = Неопределено Тогда
		ТаблицаКапВложений.Колонки.Добавить("Договор");
	КонецЕсли;
	
	ТаблицаОС = ПолучитьТаблицуДанныхИзИсточниковДанных(ИсточникиДанных, "ОсновныеСредства", Истина);
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	Для Каждого ПолеРезультата Из ПоляФункции Цикл
		ТаблицаРезультат.Колонки.Добавить(ПолеРезультата.Имя, ПолеРезультата.Тип);
	КонецЦикла;
	
	// Распределим суммы кавложений (может быть несколько, например, по нескольким КПС)
	// на принимаемые к учету объекты (может быть несколько)
	КоличествоКапвложенийВсего = ТаблицаКапВложений.Итог("Количество");
	// Количества в таблице вложений может и не быть, если это изготовление.
	// Но количество должно быть заполнено в самом документе в реквизите "Количество"
	Если КоличествоКапвложенийВсего = 0 Тогда
		Если ИсточникиДанных.Свойство("Документ") И ТипЗнч(ИсточникиДанных.Документ) = Тип("ТаблицаЗначений") И ИсточникиДанных.Документ.Количество() <> 0 Тогда
			Если ИсточникиДанных.Документ.Колонки.Найти("Документ_Количество") <> Неопределено Тогда
				КоличествоКапвложенийВсего = ИсточникиДанных.Документ[0].Документ_Количество;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Если КоличествоКапвложенийВсего <> 0 Тогда
		КапвложенийВсего = КоличествоКапвложенийВсего;
	Иначе	
		КапвложенийВсего = ТаблицаКапВложений.Итог("Сумма");
	КонецЕсли;	
	КапвложенийУжеСписано = 0;                
	
	ОтборВложений = Новый Структура("КПСВложений, ЦМОВложений, ДоговорВложений");
	Для Каждого СтрокаТаблицыОС Из ТаблицаОС Цикл   
		Если КоличествоКапвложенийВсего <> 0 Тогда
			КапвложенийУжеСписано = КапвложенийУжеСписано + СтрокаТаблицыОС.Количество;
		Иначе	
			КапвложенийУжеСписано = КапвложенийУжеСписано + СтрокаТаблицыОС.Сумма;
		КонецЕсли;	
		
		Если КапвложенийУжеСписано = КапвложенийВсего Тогда     
			// Если списываются последние капвложения, то суммы нужно рассчитывать не по коэффициентам,
			// а получать остаток от соответствующей общей суммы, чтобы избежать остатков по КПС
			РаспределенныеСуммы      = Новый Массив;
			РаспределенноеКоличество = Новый Массив;
			РаспределеннаяСуммаВсего = 0;
			
			Если ВедетсяУчетКапВложенийНУПоКПСиЦМО Тогда
				РаспределенныеСуммаНУ              = Новый Массив;
				РаспределенныеСуммаНеУчитываетсяНУ = Новый Массив;
				РаспределенныеСуммаЕНВД            = Новый Массив;
				
				РаспределеннаяСуммаНУВсего = 0;
				РаспределеннаяСуммаНеУчитываетсяНУВсего = 0;
				РаспределеннаяСуммаЕНВДВсего = 0;
			КонецЕсли;	
			
			МаксИндексКапвложений = КоличествоСтрокВложений - 1;
			Для к = 0 по МаксИндексКапвложений Цикл   
				ОтборВложений.КПСВложений     = ТаблицаКапВложений[к].КПС;
				ОтборВложений.ЦМОВложений     = ТаблицаКапВложений[к].ЦМО;
				ОтборВложений.ДоговорВложений = ТаблицаКапВложений[к].Договор;
				ТаблицаРезультатДоп = ТаблицаРезультат.Скопировать(ОтборВложений);
				
				Если к = МаксИндексКапвложений Тогда
					ОстатокСуммыПоКПС     = КоэффициентыРаспределенияСуммы[к] - ТаблицаРезультатДоп.Итог("СуммаВложений");
					ОстатокСуммыПоОбъекту = СтрокаТаблицыОС.Сумма - РаспределеннаяСуммаВсего; 
					ДобавляемаяСумма      = Мин(ОстатокСуммыПоКПС, ОстатокСуммыПоОбъекту);
					
					Если ВедетсяУчетКапВложенийНУПоКПСиЦМО Тогда
						ОстатокСуммаНУПоКПС     = КоэффициентыРаспределенияСуммаНУ[к] - ТаблицаРезультатДоп.Итог("СуммаВложенийНУ");
						ОстатокСуммаНУПоОбъекту = СтрокаТаблицыОС.СуммаНУ - РаспределеннаяСуммаНУВсего; 
						ДобавляемаяСуммаНУ      = Мин(ОстатокСуммаНУПоКПС, ОстатокСуммаНУПоОбъекту);

						ОстатокСуммаНеУчитываетсяНУПоКПС     = КоэффициентыРаспределенияСуммаНеУчитываетсяНУ[к] - ТаблицаРезультатДоп.Итог("СуммаВложенийНеУчитываетсяНУ");
						ОстатокСуммаНеУчитываетсяНУПоОбъекту = СтрокаТаблицыОС.СуммаНеУчитываетсяНУ - РаспределеннаяСуммаНеУчитываетсяНУВсего; 
						ДобавляемаяСуммаНеУчитываетсяНУ      = Мин(ОстатокСуммаНеУчитываетсяНУПоКПС, ОстатокСуммаНеУчитываетсяНУПоОбъекту);

						ОстатокСуммаЕНВДПоКПС     = КоэффициентыРаспределенияСуммаЕНВД[к] - ТаблицаРезультатДоп.Итог("СуммаВложенийЕНВД");
						ОстатокСуммаЕНВДПоОбъекту = СтрокаТаблицыОС.СуммаЕНВД - РаспределеннаяСуммаЕНВДВсего; 
						ДобавляемаяСуммаЕНВД      = Мин(ОстатокСуммаЕНВДПоКПС, ОстатокСуммаЕНВДПоОбъекту);
					КонецЕсли;	
				Иначе	
					ДобавляемаяСумма = КоэффициентыРаспределенияСуммы[к] - ТаблицаРезультатДоп.Итог("СуммаВложений");
					Если ВедетсяУчетКапВложенийНУПоКПСиЦМО Тогда
						ДобавляемаяСуммаНУ = КоэффициентыРаспределенияСуммаНУ[к] - ТаблицаРезультатДоп.Итог("СуммаВложенийНУ");
						ДобавляемаяСуммаНеУчитываетсяНУ = КоэффициентыРаспределенияСуммаНеУчитываетсяНУ[к] - ТаблицаРезультатДоп.Итог("СуммаВложенийНеУчитываетсяНУ");
						ДобавляемаяСуммаЕНВД = КоэффициентыРаспределенияСуммаЕНВД[к] - ТаблицаРезультатДоп.Итог("СуммаВложенийЕНВД");
					КонецЕсли;	
				КонецЕсли;	
				
				РаспределенныеСуммы.Добавить(ДобавляемаяСумма);
				РаспределеннаяСуммаВсего = РаспределеннаяСуммаВсего + ДобавляемаяСумма;
				РаспределенноеКоличество.Добавить(КоэффициентыРаспределенияКоличества[к] - ТаблицаРезультатДоп.Итог("КоличествоВложений"));

				Если ВедетсяУчетКапВложенийНУПоКПСиЦМО Тогда
					РаспределенныеСуммаНУ.Добавить(ДобавляемаяСуммаНУ);
					РаспределенныеСуммаНеУчитываетсяНУ.Добавить(ДобавляемаяСуммаНеУчитываетсяНУ);
					РаспределенныеСуммаЕНВД.Добавить(ДобавляемаяСуммаЕНВД);

					РаспределеннаяСуммаНУВсего = РаспределеннаяСуммаНУВсего + ДобавляемаяСуммаНУ;
					РаспределеннаяСуммаНеУчитываетсяНУВсего = РаспределеннаяСуммаНеУчитываетсяНУВсего + ДобавляемаяСуммаНеУчитываетсяНУ;
					РаспределеннаяСуммаЕНВДВсего = РаспределеннаяСуммаЕНВДВсего + ДобавляемаяСуммаЕНВД;
				КонецЕсли;	
			КонецЦикла;	
		Иначе	
			РаспределенныеСуммы = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаТаблицыОС["Сумма"], КоэффициентыРаспределенияСуммы, 2);
			РаспределенноеКоличество = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаТаблицыОС["Количество"], КоэффициентыРаспределенияКоличества, 0);
			Если ВедетсяУчетКапВложенийНУПоКПСиЦМО Тогда
				РаспределенныеСуммаНУ = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					СтрокаТаблицыОС["СуммаНУ"], КоэффициентыРаспределенияСуммаНУ, 2);
				РаспределенныеСуммаНеУчитываетсяНУ = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					СтрокаТаблицыОС["СуммаНеУчитываетсяНУ"], КоэффициентыРаспределенияСуммаНеУчитываетсяНУ, 2);
				РаспределенныеСуммаЕНВД = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					СтрокаТаблицыОС["СуммаЕНВД"], КоэффициентыРаспределенияСуммаЕНВД, 2);
			КонецЕсли;
		КонецЕсли;
		
		Для ИндексСтрокиВложений = 0 По КоличествоСтрокВложений - 1 Цикл
			
			НоваяСтрока = ТаблицаРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОС);
			НоваяСтрока.КПСВложений		= ТаблицаКапВложений[ИндексСтрокиВложений].КПС;
			НоваяСтрока.ЦМОВложений		= ТаблицаКапВложений[ИндексСтрокиВложений].ЦМО;
			НоваяСтрока.ДоговорВложений	= ТаблицаКапВложений[ИндексСтрокиВложений].Договор;
			
			Если ИндексСтрокиВложений > 0 Тогда
				НоваяСтрока.Количество = 0;
			КонецЕсли;
			
			НоваяСтрока["СуммаВложений"] = ?(РаспределенныеСуммы = Неопределено, 0, РаспределенныеСуммы[ИндексСтрокиВложений]);
			НоваяСтрока["КоличествоВложений"] = ?(РаспределенноеКоличество = Неопределено, 0, РаспределенноеКоличество[ИндексСтрокиВложений]);
			
			Если ВедетсяУчетКапВложенийНУПоКПСиЦМО Тогда
				НоваяСтрока["СуммаВложенийНУ"] =
					?(РаспределенныеСуммаНУ = Неопределено, 0, РаспределенныеСуммаНУ[ИндексСтрокиВложений]);
				НоваяСтрока["СуммаВложенийНеУчитываетсяНУ"] =
					?(РаспределенныеСуммаНеУчитываетсяНУ = Неопределено, 0, РаспределенныеСуммаНеУчитываетсяНУ[ИндексСтрокиВложений]);
				НоваяСтрока["СуммаВложенийЕНВД"] =
					?(РаспределенныеСуммаЕНВД = Неопределено, 0, РаспределенныеСуммаЕНВД[ИндексСтрокиВложений]);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция МодернизацияОсновныхСредств(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ВидЗатрат", Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаМодернизации = УправлениеОсновнымиСредствами.ПустаяТаблицаМодернизацияОсновныхСредств();
	Для Каждого Колонка Из ТаблицаМодернизации.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	// Подготовим таблицу для отражения модернизации основных средств,
	ТаблицаМодернизации = УправлениеОсновнымиСредствами.ТаблицаМодернизацияОсновныхСредств(
		Реквизиты, Параметры, Отказ);
	// и сохраним ее для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаМодернизацияОсновныхСредств",
		ТаблицаМодернизации.Скопировать());
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаМодернизации;
	
КонецФункции

Функция МодернизацияОсновныхСредствПоКПС(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаМодернизацииПоКПС = УправлениеОсновнымиСредствами.ПустаяТаблицаМодернизацияОсновныхСредств();
	
	Для Каждого Колонка Из ТаблицаМодернизацииПоКПС.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаКапВложений = ПолучитьТаблицуДанныхИзИсточниковДанных(ИсточникиДанных, "КапитальныеВложения", Истина);
	КоэффициентыРаспределения = ТаблицаКапВложений.ВыгрузитьКолонку("Сумма");
	КоличествоСтрокВложений = ТаблицаКапВложений.Количество();
	
	Если ТаблицаКапВложений.Колонки.Найти("Договор") = Неопределено Тогда
		ТаблицаКапВложений.Колонки.Добавить("Договор");
	КонецЕсли;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Если НЕ ДополнительныеСвойства.Свойство("ТаблицаМодернизацияОсновныхСредств") Тогда
		ВызватьИсключение "Не обнаружена таблица модернизации основных средств.
			|Для формирования таблицы модернизации основных средств по КПС,
			|используется таблица модернизации основных средств,
			|подготовленная функцией УправлениеОсновнымиСредствами.ТаблицаМодернизацияОсновныхСредств.";
	КонецЕсли;
	
	РаспределяемыеКолонки = Новый Массив;
	РаспределяемыеКолонки.Добавить("СуммаДемонтажа");
	РаспределяемыеКолонки.Добавить("СуммаМодернизации");
	РаспределяемыеКолонки.Добавить("СуммаТранспортировки");
	
	ВедетсяУчетКапВложенийНУПоКПСиЦМО = НалоговыйУчет.ОтражатьВНалоговомУчете(ДокументОбъект.Организация, ДокументОбъект.Дата, ДокументОбъект.КФО)
		И (НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоКПС(ДокументОбъект.Дата)
		ИЛИ НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоЦМО(ДокументОбъект.Дата));
	Если ВедетсяУчетКапВложенийНУПоКПСиЦМО Тогда
		РаспределяемыеКолонки.Добавить("СуммаМодернизацииНУ");
		РаспределяемыеКолонки.Добавить("СуммаМодернизацииНеУчитываетсяНУ");
		РаспределяемыеКолонки.Добавить("СуммаМодернизацииЕНВД");
		КоэффициентыРаспределенияСуммаНУ = ТаблицаКапВложений.ВыгрузитьКолонку("СуммаНУ");
		КоэффициентыРаспределенияСуммаНеУчитываетсяНУ = ТаблицаКапВложений.ВыгрузитьКолонку("СуммаНеУчитываетсяНУ");
		КоэффициентыРаспределенияСуммаЕНВД = ТаблицаКапВложений.ВыгрузитьКолонку("СуммаЕНВД");
	КонецЕсли;
	
	РаспределенныеСуммы = Новый Массив(РаспределяемыеКолонки.Количество());
	
	Для каждого СтрокаМодернизации Из ДополнительныеСвойства.ТаблицаМодернизацияОсновныхСредств Цикл
		
		Для ИндексКолонки = 0 По РаспределяемыеКолонки.ВГраница() Цикл
			
			Если РаспределяемыеКолонки[ИндексКолонки] = "СуммаМодернизацииНУ" Тогда
				РаспределенныеСуммы[ИндексКолонки] = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					СтрокаМодернизации["СуммаМодернизацииНУ"], КоэффициентыРаспределенияСуммаНУ);
			ИначеЕсли РаспределяемыеКолонки[ИндексКолонки] = "СуммаМодернизацииНеУчитываетсяНУ" Тогда
				РаспределенныеСуммы[ИндексКолонки] = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					СтрокаМодернизации["СуммаМодернизацииНеУчитываетсяНУ"], КоэффициентыРаспределенияСуммаНеУчитываетсяНУ);
			ИначеЕсли РаспределяемыеКолонки[ИндексКолонки] = "СуммаМодернизацииЕНВД" Тогда
				РаспределенныеСуммы[ИндексКолонки] = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					СтрокаМодернизации["СуммаМодернизацииЕНВД"], КоэффициентыРаспределенияСуммаЕНВД);
			Иначе
				РаспределенныеСуммы[ИндексКолонки] = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					СтрокаМодернизации[РаспределяемыеКолонки[ИндексКолонки]], КоэффициентыРаспределения);
			КонецЕсли;
		
		КонецЦикла;
		
		Для ИндексСтрокиВложений = 0 По КоличествоСтрокВложений - 1 Цикл
		
			НоваяСтрока = ТаблицаМодернизацииПоКПС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМодернизации);
			НоваяСтрока.КПСВложений		= ТаблицаКапВложений[ИндексСтрокиВложений].КПС;
			НоваяСтрока.ЦМОВложений		= ТаблицаКапВложений[ИндексСтрокиВложений].ЦМО;
			НоваяСтрока.ДоговорВложений	= ТаблицаКапВложений[ИндексСтрокиВложений].Договор;
			
			Для ИндексКолонки = 0 По РаспределяемыеКолонки.ВГраница() Цикл
			
				Если РаспределенныеСуммы[ИндексКолонки] = Неопределено Тогда
					НоваяСтрока[РаспределяемыеКолонки[ИндексКолонки]] = 0;
				Иначе
					НоваяСтрока[РаспределяемыеКолонки[ИндексКолонки]] = РаспределенныеСуммы[ИндексКолонки][ИндексСтрокиВложений];
				КонецЕсли;
			
			КонецЦикла;
		
		КонецЦикла;
		
	КонецЦикла;

//	Если ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС")
//		ИЛИ ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК") Тогда
//		Возврат ТаблицаМодернизацииПоКПС;
//	КонецЕсли;	
		
	// Корректировка копеек.
	
	// Добавим колонки для распределения сумм.
	ТаблицаКапВложений.Колонки.Добавить("СуммаМодернизации", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТаблицаКапВложений.Колонки.Добавить("СуммаДемонтажа", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТаблицаКапВложений.Колонки.Добавить("СуммаТранспортировки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
//	КоэффициентыРаспределения = Новый Массив;
//	КоэффициентыРаспределения.Добавить(РеквизитыДокумента["СуммаДокумента"] - РеквизитыДокумента["СуммаДемонтажа"] - РеквизитыДокумента["СуммаТранспортировки"]);
//	КоэффициентыРаспределения.Добавить(РеквизитыДокумента["СуммаДемонтажа"]);
//	КоэффициентыРаспределения.Добавить(РеквизитыДокумента["СуммаТранспортировки"]);

	КоэффициентыРаспределения = Новый Массив;
	КоэффициентыРаспределения.Добавить(ДополнительныеСвойства.ТаблицаМодернизацияОсновныхСредств.Итог("СуммаМодернизации"));
	КоэффициентыРаспределения.Добавить(ДополнительныеСвойства.ТаблицаМодернизацияОсновныхСредств.Итог("СуммаДемонтажа"));
	КоэффициентыРаспределения.Добавить(ДополнительныеСвойства.ТаблицаМодернизацияОсновныхСредств.Итог("СуммаТранспортировки"));
	
	Для Каждого СтрокаКапВложений Из ТаблицаКапВложений Цикл
		
		РезультатРаспределения = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаКапВложений.Сумма, КоэффициентыРаспределения);
		
		Если РезультатРаспределения <> Неопределено Тогда
			СтрокаКапВложений.СуммаМодернизации = РезультатРаспределения[0];
			СтрокаКапВложений.СуммаДемонтажа = РезультатРаспределения[1];
			СтрокаКапВложений.СуммаТранспортировки = РезультатРаспределения[2];
		КонецЕсли;
		
	КонецЦикла;
	
	КопияТаблицы = ТаблицаМодернизацииПоКПС.Скопировать(,
		"ЦМОВложений, КПСВложений, СуммаМодернизации, СуммаДемонтажа, СуммаТранспортировки");
	КопияТаблицы.Свернуть("ЦМОВложений, КПСВложений", "СуммаМодернизации, СуммаДемонтажа, СуммаТранспортировки");
	
	ИтогиПоКПС = Новый Соответствие;
	Для каждого СтрокаИтогов Из КопияТаблицы Цикл
		СтруктураИтогов = Новый Структура("СуммаМодернизации, СуммаДемонтажа, СуммаТранспортировки");
		ЗаполнитьЗначенияСвойств(СтруктураИтогов, СтрокаИтогов);
		ИтогиПоКПС.Вставить(ПолучитьСтрокуИдентификаторов(СтрокаИтогов.ЦМОВложений, СтрокаИтогов.КПСВложений), СтруктураИтогов);
	КонецЦикла;
	
	КорректировкиПоКПС = Новый Соответствие;
	Для каждого СтрокаКапВложений Из ТаблицаКапВложений Цикл
		
		ТекущийИтогПоКПС = ИтогиПоКПС.Получить(ПолучитьСтрокуИдентификаторов(СтрокаКапВложений.ЦМО, СтрокаКапВложений.КПС));
		Если ТекущийИтогПоКПС = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтруктураКорректировок = Новый Структура;
		СтруктураКорректировок.Вставить("СуммаМодернизации", 
			СтрокаКапВложений.СуммаМодернизации - ТекущийИтогПоКПС.СуммаМодернизации);
		СтруктураКорректировок.Вставить("СуммаДемонтажа", 
			СтрокаКапВложений.СуммаДемонтажа - ТекущийИтогПоКПС.СуммаДемонтажа);
		СтруктураКорректировок.Вставить("СуммаТранспортировки", 
			СтрокаКапВложений.СуммаТранспортировки - ТекущийИтогПоКПС.СуммаТранспортировки);
		
		КорректировкиПоКПС.Вставить(ПолучитьСтрокуИдентификаторов(
			СтрокаКапВложений.ЦМО, СтрокаКапВложений.КПС), СтруктураКорректировок);
		
	КонецЦикла;
	
	КоличествоСтрокРезультата = ТаблицаМодернизацииПоКПС.Количество();
	Если КоличествоСтрокРезультата = ТаблицаКапВложений.Количество() И КоличествоСтрокРезультата > 0 Тогда
		Для Индекс = 1 По ТаблицаКапВложений.Количество() Цикл
			
			КорректируемаяСтрока = ТаблицаМодернизацииПоКПС[КоличествоСтрокРезультата - Индекс];
			ЗначенияКорректировок = КорректировкиПоКПС.Получить(ПолучитьСтрокуИдентификаторов(
				КорректируемаяСтрока.ЦМОВложений, КорректируемаяСтрока.КПСВложений));
			Если ЗначенияКорректировок = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			КорректируемаяСтрока.СуммаМодернизации = КорректируемаяСтрока.СуммаМодернизации + ЗначенияКорректировок.СуммаМодернизации;
			КорректируемаяСтрока.СуммаДемонтажа = КорректируемаяСтрока.СуммаДемонтажа + ЗначенияКорректировок.СуммаДемонтажа;
			КорректируемаяСтрока.СуммаТранспортировки = КорректируемаяСтрока.СуммаТранспортировки + ЗначенияКорректировок.СуммаТранспортировки;
		
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТаблицаМодернизацииПоКПС;
	
КонецФункции

Функция ВводОстатковОсновныхСредств(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаВводОстатков = УправлениеОсновнымиСредствами.ПустаяТаблицаВводОстатковОсновныхСредств();
	Для Каждого Колонка Из ТаблицаВводОстатков.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	// Подготовим таблицу для отражения ввода остатков основных средств,
	ТаблицаВводОстатков = УправлениеОсновнымиСредствами.ТаблицаВводОстатковОсновныхСредств(
		Реквизиты.Ссылка, Реквизиты, Отказ);
	// и сохраним ее для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаВводОстатковОсновныхСредств",
		ТаблицаВводОстатков.Скопировать());
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаВводОстатков;
	
КонецФункции

Функция ПереносВложенийВНФА(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Таблица = Документы.ПереносВложенийВНФА.ТаблицаОстатки();
		ПоляФункции = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Новый ОписаниеТипов(Колонка.ТипЗначения,, "Null"));
		КонецЦикла;
		Возврат ПоляФункции;
	КонецЕсли;
		
	Если ВариантВызова = "Выполнить" Тогда
		РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
		Возврат Документы.ПереносВложенийВНФА.ТаблицаОстатки(РеквизитыДокумента);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

