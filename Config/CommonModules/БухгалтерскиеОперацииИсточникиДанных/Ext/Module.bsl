#Область РозничнаяТорговля

Функция РозничнаяНаценкаПриПеремещенииВНТТ(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаНаценка = УправлениеМатериальнымиЗапасами.ПустаяТаблицаРозничнаяНаценкаПриПеремещенииВНТТ();
	Для Каждого Колонка Из ТаблицаНаценка.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	
	Если НЕ ДополнительныеСвойства.Свойство("ТаблицаСписаниеМатериальныхЗапасов") Тогда
		ВызватьИсключение "Не обнаружена таблица списания материальных запасов.
			|Для формирования таблицы начисления розничной наценки используется таблица списания материальных запасов,
			|подготовленная функцией УправлениеМатериальнымиЗапасами.ТаблицаСписаниеМатериальныхЗапасов.";
	КонецЕсли;
	
	// Подготовим таблицу розничной наценки при перемещении материальных запасов в НТТ.
	ТаблицаНаценка = УправлениеМатериальнымиЗапасами.ТаблицаРозничнаяНаценкаПриПеремещенииВНТТ(
		ДополнительныеСвойства.ТаблицаСписаниеМатериальныхЗапасов,
		Реквизиты, Отказ);
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаНаценка;
	
КонецФункции

Функция СписаниеМатериальныхЗапасовИзНТТ(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КЭКРозницы", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	МассивМетаданных = Новый Массив;
	МассивМетаданных.Добавить(Метаданные.Документы.ТребованиеНакладная0315006.ТабличныеЧасти.Материалы);
	
	ПоляФункции = Новый Массив;
	// Идентификация строки.
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПоляФункции,
		ЗаполнитьПоляФункцииИзОписанияМетаданных(МассивМетаданных, Новый Массив));
	
	ВычисляемыеПоля = Новый Структура;
	
	// Счета учета товаров в рознице и торговой наценки.
	ОписаниеТипаСчет  = Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	ВычисляемыеПоля.Вставить("СчетРозницы",   ОписаниеТипаСчет);
	ВычисляемыеПоля.Вставить("СчетНаценки",   ОписаниеТипаСчет);
	ВычисляемыеПоля.Вставить("СчетРозницыНУ", ОписаниеТипаСчет);
	ВычисляемыеПоля.Вставить("СчетНаценкиНУ", ОписаниеТипаСчет);
	
	ВычисляемыеПоля.Вставить("КЭКРозницы",    Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	
	// Сумма наценки, относящаяся к списываемым из НТТ товарам.
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ВычисляемыеПоля.Вставить("СуммаНаценки",                ОписаниеТипаСуммы);
	ВычисляемыеПоля.Вставить("СуммаНаценкиНУ",              ОписаниеТипаСуммы);
	ВычисляемыеПоля.Вставить("СуммаНаценкиНеУчитываетсяНУ", ОписаниеТипаСуммы);

	Для Каждого ВычисляемоеПоле Из ВычисляемыеПоля Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, ВычисляемоеПоле.Ключ, ВычисляемоеПоле.Значение);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);
	
	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	ПрефиксКолонки   = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Материалы");
	
	СтрДокумента = ИсточникиДанных["Документ"][0];
	ДокументСсылка = СтрДокумента[ПрефиксДокумента + "Ссылка"];
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	// Счет учета товаров в рознице определяется по значению реквизита КорСчет в шапке.
	КЭКРозницы   = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "КЭКРозницы", Справочники.КОСГУ.ПустаяСсылка());
	Счета105ОЦДИ = БухгалтерскийУчет.СписокСчетов("105.20");
	СчетРозницы  = ?(Счета105ОЦДИ.Найти(ДокументСсылка.КорСчет) <> Неопределено,
					БухгалтерскийУчет.СчетПоКоду("105.Б8"),
					БухгалтерскийУчет.СчетПоКоду("105.Г8"));
	СвойстваСчетаРозницы = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетРозницы);
	ВедетсяУчетПоПодразделениям = ИспользоватьУчетПоПодразделениям И СвойстваСчетаРозницы.УчетПоПодразделениям;
	
	// Выполним расчет торговой наценки по проданным товарам (в рамках заданных ЦМО, КФО, КПС и пр.),
	// как если бы этот расчет выполнялся регламентной операцией в конце месяца.
	// В полях СуммаНаценки(*) получим сумму наценки, относящуюся к реализованным товарам (с начала месяца по текущий момент).
	// В полях ТорговаяНаценкаОстаток(*) - общая сумма торговой наценки на начало месяца, которая состоит из:
	// 1) суммы наценки по реализованным товарам с начала месяца - поля СуммаНаценки(*);
	// 2) суммы наценки по товарам, списываемым из НТТ данной хозяйственной операцией;
	// 3) суммы наценки для остатка товаров, которые останутся в рознице после списания из НТТ.
	ТаблицыТорговойНаценки = УправлениеМатериальнымиЗапасами.РассчитатьТорговуюНаценку(ДокументСсылка, КЭКРозницы, Отказ);
	
	ТаблицаНаценкиБУ = ТаблицыТорговойНаценки["ТаблицаТорговойНаценкиБУ"];
	ТаблицаНаценкиБУ.Свернуть("ИФО,КФО,ЦМО,ПодразделениеРозницы,СчетНаценки,СчетРозницы,КПСРозницы,КЭКРозницы",
		"ПродажнаяСтоимостьРеализация,
		|ПродажнаяСтоимостьОстаток,
		|ТорговаяНаценкаОстаток,
		|СуммаНаценки");
	ТаблицаНаценкиБУ.Колонки.Добавить("СписаноПродажнаяСтоимость", ОписаниеТипаСуммы);
	ТаблицаНаценкиБУ.Колонки.Добавить("СписаноСуммаНаценки", ОписаниеТипаСуммы);
	
	ТаблицаНаценкиНУ = ТаблицыТорговойНаценки["ТаблицаТорговойНаценкиНУ"];
	ТаблицаНаценкиНУ.Свернуть("ИФО,КФО,ЦМО,СчетНаценки,СчетРозницы",
		"ПродажнаяСтоимостьРеализация,ПродажнаяСтоимостьЕНВДРеализация,
		|ПродажнаяСтоимостьОстаток,ПродажнаяСтоимостьЕНВДОстаток,
		|ТорговаяНаценкаОстаток,ТорговаяНаценкаЕНВДОстаток,ТорговаяНаценкаНеУчитываетсяНУОстаток,
		|СуммаНаценки,СуммаНаценкиНеУчитываетсяНУ");
	ТаблицаНаценкиНУ.Колонки.Добавить("СписаноПродажнаяСтоимость", ОписаниеТипаСуммы);
	ТаблицаНаценкиНУ.Колонки.Добавить("СписаноСуммаНаценки", ОписаниеТипаСуммы);
	ТаблицаНаценкиНУ.Колонки.Добавить("СписаноСуммаНаценкиНеУчитываетсяНУ", ОписаниеТипаСуммы);
	
	// Бухгалтерский учет - проверим достаточность остатка на счете розницы.
	ТаблицаСписания = ИсточникиДанных["Материалы"].Скопировать();
	ТаблицаСписания.Свернуть(ПрефиксКолонки+"КФО,"+ПрефиксКолонки+"КПС", ПрефиксКолонки+"СуммаПередачи");
	Для Каждого СтрокаСписания Из ТаблицаСписания Цикл
		
		КФОСписания   = СтрокаСписания[ПрефиксКолонки+"КФО"];
		КПССписания   = СтрокаСписания[ПрефиксКолонки+"КПС"];
		СуммаПередачи = СтрокаСписания[ПрефиксКолонки+"СуммаПередачи"];
		
		СтруктураПоиска = Новый Структура("ЦМО,КФО,СчетРозницы,КПСРозницы",
			ДокументСсылка.ЦМООтправитель,
			КФОСписания,
			СчетРозницы,
			КПССписания);
		Если ИспользоватьУчетПоИФО Тогда
			СтруктураПоиска.Вставить("ИФО", ДокументСсылка.ИФО);
		КонецЕсли;
		Если ВедетсяУчетПоПодразделениям Тогда
			СтруктураПоиска.Вставить("ПодразделениеРозницы", ДокументСсылка.ПодразделениеОтправитель);
		КонецЕсли;
		МассивСтрок = ТаблицаНаценкиБУ.НайтиСтроки(СтруктураПоиска);
		
		ОстатокВРознице = ?(МассивСтрок.Количество()=0, 0, МассивСтрок[0].ПродажнаяСтоимостьОстаток);
		
		Если СуммаПередачи > ОстатокВРознице Тогда
			
			ТекстОшибки = НСтр("ru='Сумма списания по КФО %1 и КПС %2 превышает остаток в рознице по счету %3.
				|
				|ЦМО: %4'")+?(ВедетсяУчетПоПодразделениям, НСтр("ru=', Подразделение: %5'"), "")+НСтр("ru='.
				|Остаток: %6; Не хватает: %7'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				КФОСписания,
				КПССписания,
				СчетРозницы,
				ДокументСсылка.ЦМООтправитель,
				ДокументСсылка.ПодразделениеОтправитель,
				ОстатокВРознице,
				СуммаПередачи - ОстатокВРознице);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументСсылка,,, Отказ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Налоговый учет - проверим достаточность остатка на счете розницы.
	МассивКФОдляНУ = НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета();
	ОтражаетсяВНалоговомУчете = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(ДокументСсылка.Организация, ДокументСсылка.Дата);
	Если ОтражаетсяВНалоговомУчете Тогда
	
		УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(ДокументСсылка.Организация, ДокументСсылка.Дата);
		РозничнаяТорговляОблагаетсяЕНВД = УчетнаяПолитика.РозничнаяТорговляОблагаетсяЕНВД;
		
		ТаблицаСписания.Свернуть(ПрефиксКолонки+"КФО", ПрефиксКолонки+"СуммаПередачи");
		Для Каждого СтрокаСписания Из ТаблицаСписания Цикл
			
			КФОСписания   = СтрокаСписания[ПрефиксКолонки+"КФО"];
			СуммаПередачи = СтрокаСписания[ПрефиксКолонки+"СуммаПередачи"];
			
			Если МассивКФОдляНУ.Найти(КФОСписания) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураПоиска = Новый Структура("ЦМО,КФО",
				ДокументСсылка.ЦМООтправитель,
				КФОСписания);
			Если ИспользоватьУчетПоИФО Тогда
				СтруктураПоиска.Вставить("ИФО", ДокументСсылка.ИФО);
			КонецЕсли;
			МассивСтрок = ТаблицаНаценкиНУ.НайтиСтроки(СтруктураПоиска);
			
			Если НЕ РозничнаяТорговляОблагаетсяЕНВД Тогда
				ОстатокВРознице = ?(МассивСтрок.Количество()=0, 0, МассивСтрок[0].ПродажнаяСтоимостьОстаток);
			Иначе
				ОстатокВРознице = ?(МассивСтрок.Количество()=0, 0, МассивСтрок[0].ПродажнаяСтоимостьЕНВДОстаток);
			КонецЕсли;
			
			Если СуммаПередачи > ОстатокВРознице Тогда
				
				ТекстОшибки = НСтр("ru='Сумма списания по КФО %1 превышает остаток в рознице по счету налогового учета %2.
					|
					|ЦМО: %3.
					|Остаток: %4; Не хватает: %5'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					КФОСписания,
					БухгалтерскийУчет.СчетПоКоду("Н41.02"),
					ДокументСсылка.ЦМООтправитель,
					ОстатокВРознице,
					СуммаПередачи - ОстатокВРознице);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументСсылка,,, Отказ);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		
		СинонимТаблицыМатериалы = СтрДокумента.Документ_Ссылка. Метаданные().ТабличныеЧасти.Материалы.Синоним;
		
		Для каждого СтрокаТаблицы Из ИсточникиДанных["Материалы"] Цикл
			
			НоваяСтрока = ТаблицаРезультат.Добавить();
			
			НоваяСтрока.ИмяСписка     = "Материалы";
			НоваяСтрока.СинонимСписка = СинонимТаблицыМатериалы;
			НоваяСтрока.НомерСтроки   = СтрокаТаблицы.НомерСтроки;
			
			// Заполняем поля (кроме вычисляемых) из реквизитов источника данных.
			Для каждого ТекПолеФункции Из ПоляФункции Цикл
				Если ТекПолеФункции.Имя = "ИмяСписка"
					ИЛИ ТекПолеФункции.Имя = "СинонимСписка"
					ИЛИ ТекПолеФункции.Имя = "НомерСтроки" 
					ИЛИ ВычисляемыеПоля.Свойство(ТекПолеФункции.Имя) Тогда
					Продолжить;
				КонецЕсли;
				НоваяСтрока[ТекПолеФункции.Имя] = СтрокаТаблицы[ПрефиксКолонки + ТекПолеФункции.Имя];
			КонецЦикла;
			
			КФОПередачи   = СтрокаТаблицы[ПрефиксКолонки+"КФО"];
			КПСПередачи   = СтрокаТаблицы[ПрефиксКолонки+"КПС"];
			СуммаПередачи = СтрокаТаблицы[ПрефиксКолонки+"СуммаПередачи"];
			
			// Бухгалтерский учет.
			СтруктураПоиска = Новый Структура("ЦМО,КФО,СчетРозницы,КПСРозницы",
				ДокументСсылка.ЦМООтправитель,
				КФОПередачи,
				СчетРозницы,
				КПСПередачи);
			Если ИспользоватьУчетПоИФО Тогда
				СтруктураПоиска.Вставить("ИФО", ДокументСсылка.ИФО);
			КонецЕсли;
			Если ВедетсяУчетПоПодразделениям Тогда
				СтруктураПоиска.Вставить("ПодразделениеРозницы", ДокументСсылка.ПодразделениеОтправитель);
			КонецЕсли;
			МассивСтрок = ТаблицаНаценкиБУ.НайтиСтроки(СтруктураПоиска);
			
			Если МассивСтрок.Количество() > 0 Тогда
				СтрокаНаценкиБУ = МассивСтрок[0];
				
				НоваяСтрока.СчетРозницы = СтрокаНаценкиБУ.СчетРозницы;
				НоваяСтрока.КЭКРозницы  = СтрокаНаценкиБУ.КЭКРозницы;
				НоваяСтрока.СчетНаценки = СтрокаНаценкиБУ.СчетНаценки;
				
				Если СуммаПередачи + СтрокаНаценкиБУ.ПродажнаяСтоимостьРеализация + СтрокаНаценкиБУ.СписаноПродажнаяСтоимость = СтрокаНаценкиБУ.ПродажнаяСтоимостьОстаток Тогда
					// Списываем из НТТ весь остаток товаров, а значит и всю наценку.
					НоваяСтрока.СуммаНаценки = СтрокаНаценкиБУ.ТорговаяНаценкаОстаток - СтрокаНаценкиБУ.СписаноСуммаНаценки;
				Иначе
					НоваяСтрока.СуммаНаценки = Окр(СтрокаНаценкиБУ.ТорговаяНаценкаОстаток * СуммаПередачи
												/ (СтрокаНаценкиБУ.ПродажнаяСтоимостьОстаток + СтрокаНаценкиБУ.ПродажнаяСтоимостьРеализация), 2);
				КонецЕсли;
				
				СтрокаНаценкиБУ.СписаноПродажнаяСтоимость = СтрокаНаценкиБУ.СписаноПродажнаяСтоимость + СуммаПередачи;
				СтрокаНаценкиБУ.СписаноСуммаНаценки       = СтрокаНаценкиБУ.СписаноСуммаНаценки       + НоваяСтрока.СуммаНаценки;
				
			КонецЕсли;
			
			// Налоговый учет.
			Если ОтражаетсяВНалоговомУчете Тогда
				
				Если МассивКФОдляНУ.Найти(КФОПередачи) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СтруктураПоиска = Новый Структура("ЦМО,КФО",
					ДокументСсылка.ЦМООтправитель,
					КФОПередачи);
				Если ИспользоватьУчетПоИФО Тогда
					СтруктураПоиска.Вставить("ИФО", ДокументСсылка.ИФО);
				КонецЕсли;
				МассивСтрок = ТаблицаНаценкиНУ.НайтиСтроки(СтруктураПоиска);
				
				Если МассивСтрок.Количество() > 0 Тогда
					СтрокаНаценкиНУ = МассивСтрок[0];
					
					НоваяСтрока.СчетРозницыНУ = СтрокаНаценкиНУ.СчетРозницы;
					НоваяСтрока.СчетНаценкиНУ = СтрокаНаценкиНУ.СчетНаценки;
					
					Если НЕ РозничнаяТорговляОблагаетсяЕНВД Тогда
						
						Если СуммаПередачи + СтрокаНаценкиНУ.ПродажнаяСтоимостьРеализация + СтрокаНаценкиНУ.СписаноПродажнаяСтоимость = СтрокаНаценкиНУ.ПродажнаяСтоимостьОстаток Тогда
							// Списываем из НТТ весь остаток товаров, а значит и всю наценку.
							НоваяСтрока.СуммаНаценкиНУ              = СтрокаНаценкиНУ.ТорговаяНаценкаОстаток                - СтрокаНаценкиНУ.СписаноСуммаНаценки;
							НоваяСтрока.СуммаНаценкиНеУчитываетсяНУ = СтрокаНаценкиНУ.ТорговаяНаценкаНеУчитываетсяНУОстаток - СтрокаНаценкиНУ.СписаноСуммаНаценкиНеУчитываетсяНУ;
						Иначе
							НоваяСтрока.СуммаНаценкиНУ = Окр(СтрокаНаценкиНУ.ТорговаяНаценкаОстаток * СуммаПередачи
														/ (СтрокаНаценкиНУ.ПродажнаяСтоимостьОстаток + СтрокаНаценкиНУ.ПродажнаяСтоимостьРеализация), 2);
							НоваяСтрока.СуммаНаценкиНеУчитываетсяНУ = Окр(СтрокаНаценкиНУ.ТорговаяНаценкаНеУчитываетсяНУОстаток * СуммаПередачи
														/ (СтрокаНаценкиНУ.ПродажнаяСтоимостьОстаток + СтрокаНаценкиНУ.ПродажнаяСтоимостьРеализация), 2);
						КонецЕсли;
						
					Иначе
						
						Если СуммаПередачи + СтрокаНаценкиНУ.ПродажнаяСтоимостьЕНВДРеализация + СтрокаНаценкиНУ.СписаноПродажнаяСтоимость = СтрокаНаценкиНУ.ПродажнаяСтоимостьЕНВДОстаток Тогда
							// Списываем из НТТ весь остаток товаров, а значит и всю наценку.
							НоваяСтрока.СуммаНаценкиНУ = СтрокаНаценкиНУ.ТорговаяНаценкаЕНВДОстаток - СтрокаНаценкиНУ.СписаноСуммаНаценки;
						Иначе
							НоваяСтрока.СуммаНаценкиНУ = Окр(СтрокаНаценкиНУ.ТорговаяНаценкаЕНВДОстаток * СуммаПередачи
														/ (СтрокаНаценкиНУ.ПродажнаяСтоимостьЕНВДОстаток + СтрокаНаценкиНУ.ПродажнаяСтоимостьЕНВДРеализация), 2);
						КонецЕсли;
						
						НоваяСтрока.СуммаНаценкиНеУчитываетсяНУ = 0; // Не относится к деятельности с особым порядком налогообложения (ЕНВД и пр.).
						
					КонецЕсли;
					
					СтрокаНаценкиНУ.СписаноПродажнаяСтоимость          = СтрокаНаценкиНУ.СписаноПродажнаяСтоимость          + СуммаПередачи;
					СтрокаНаценкиНУ.СписаноСуммаНаценки                = СтрокаНаценкиНУ.СписаноСуммаНаценки                + НоваяСтрока.СуммаНаценкиНУ;
					СтрокаНаценкиНУ.СписаноСуммаНаценкиНеУчитываетсяНУ = СтрокаНаценкиНУ.СписаноСуммаНаценкиНеУчитываетсяНУ + НоваяСтрока.СуммаНаценкиНеУчитываетсяНУ;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		КонтекстЗаполненияОперации = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		КонтекстЗаполненияОперации.Отказ = Истина;
		БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстЗаполненияОперации);
	КонецЕсли;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти

#Область УчетПродуктовПитания

Функция СписаниеПродуктовПитания(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаСписанияПродуктовПитания = УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеПродуктовПитания();
	Для Каждого Колонка Из ТаблицаСписанияПродуктовПитания.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
