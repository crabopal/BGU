#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

Функция ТаблицаРасчетовПриПоступленииОсновныхСредств(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = ТаблицаРасчетовСЗачетомАвансов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетВложений", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ТаблицаРасчетовСЗачетомАвансов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры);
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТаблицаРасчетовСЗачетомАвансов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры);
	
КонецФункции

Функция ТаблицаРасчетовССотрудникамиПоВедомости(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ВедомостьНаВыплатуВБанк",
										Новый ОписаниеТипов("ДокументСсылка.ВедомостьНаВыплатуВБанк"));
		Возврат ПараметрыФункции;
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаРасчетов = УчетРасчетов.ПустаяТаблицаРасчетовСПогашениемЗадолженности();
	Для Каждого Колонка Из ТаблицаРасчетов.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Реквизиты.Вставить("СчетРасчетов",    БухгалтерскийУчет.СчетПоКоду("302.00"));
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	ТаблицаРасчетов = Новый ТаблицаЗначений;
	
	Отказ = Ложь;
	
	РасшифровкаПлатежа = УчетРасчетов.ПодготовитьТаблицуРасшифровкаПлатежаПоДокументу(
		Реквизиты.Ссылка, Реквизиты, Отказ);
	
	Если НЕ Отказ Тогда
		
		// При перечислении сотрудникам по ведомости перечислений расчеты ведутся по сотрудникам,
		// указанным в ведомости на перечисление сотрудникам. Модифицируем таблицу РасшифровкаПлатежа.
		РасшифровкаПлатежаПоПолучателям = УчетРасчетов.ДетализироватьРасшифровкуПлатежаПоВедомостиПеречислений(
			РасшифровкаПлатежа, Реквизиты.Ссылка, Параметры, Отказ);
			
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		
		// Подготовим таблицу для отражения погашения задолженности перед получателями компенсации родительской платы,
		ТаблицаРасчетов = УчетРасчетов.ТаблицаРасчетовСПогашениемЗадолженности(
			РасшифровкаПлатежаПоПолучателям, Реквизиты, Отказ);
		
	КонецЕсли;
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить(
		"ТаблицаРасчетовСПогашениемЗадолженности", ТаблицаРасчетов.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

////////////////////////////////////////////////////////////

Функция ТаблицаЗачетаАванса_ОсновныеСредства(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",			Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",			Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетВложения",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		
		Возврат ПараметрыФункции;
	КонецЕсли;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ТаблицаЗачетаАванса_Основная(ВариантВызова, ИсточникиДанных, Неопределено, Неопределено);
	КонецЕсли;		
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДокументСсылка = КонтекстПроведения.Ссылка;
	ТипЗначенияСсылки = ТипЗнч(ДокументСсылка);
	
	ПараметрыРасчетаАванса = СтруктураПараметровДляЗачетаАвансов(Параметры);
	
	ТаблицаРасчетов = ТаблицаРасчетовДляЗачетаАвансов(КонтекстПроведения, ИсточникиДанных, ПараметрыРасчетаАванса);

	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	СтрокаДокумента = ИсточникиДанных["Документ"][0];
	ТекущийКонтекст = Новый Структура;
	ТекущийКонтекст.Вставить("Период", ?(ДокументСсылка.Пустая(), СтрокаДокумента[ПрефиксДокумента + "Дата"], ДокументСсылка));
	ТекущийКонтекст.Вставить("ТаблицаРасчетов", ТаблицаРасчетов);
	
	КонтекстПроведения.ДополнительныеСвойства.Вставить("КонтекстРасчетаАвансов", ТекущийКонтекст);
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	ПараметрыРасчетаОстатковАванса = СтруктураПараметровРасчетаОстатковАванса(ТипЗначенияСсылки, СтрокаДокумента, ТаблицаРасчетов, ПараметрыРасчетаАванса);
	ТаблицаЗачетаАванса = ТаблицаЗачетаАванса_Основная(ВариантВызова, ИсточникиДанных, ПараметрыРасчетаАванса, ПараметрыРасчетаОстатковАванса);
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаЗачетаАванса", ТаблицаЗачетаАванса);
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаЗачетаАванса;
	
КонецФункции

