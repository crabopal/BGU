Функция СводноеНачислениеКомпенсации(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",             Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",             Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетДебета",      Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КЭКДебета",       Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СубконтоДебета1", ОписаниеТиповСубконто);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СубконтоДебета2", ОписаниеТиповСубконто);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СубконтоДебета3", ОписаниеТиповСубконто);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Обязательство",   Новый ОписаниеТипов("СправочникСсылка.Договоры"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	СвернутаяТаблица = Новый ТаблицаЗначений;
	СвернутаяТаблица.Колонки.Добавить("КФО",                   Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	СвернутаяТаблица.Колонки.Добавить("Сумма",                 ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18,2));
	СвернутаяТаблица.Колонки.Добавить("ИФО",                   Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	СвернутаяТаблица.Колонки.Добавить("СчетДебета",            Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	СвернутаяТаблица.Колонки.Добавить("КПСДебета",             Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	СвернутаяТаблица.Колонки.Добавить("КЭКДебета",             Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	СвернутаяТаблица.Колонки.Добавить("СубконтоДебета1",       ОписаниеТиповСубконто);
	СвернутаяТаблица.Колонки.Добавить("СубконтоДебета2",       ОписаниеТиповСубконто);
	СвернутаяТаблица.Колонки.Добавить("СубконтоДебета3",       ОписаниеТиповСубконто);
	СвернутаяТаблица.Колонки.Добавить("ПодразделениеДебета",   Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	СвернутаяТаблица.Колонки.Добавить("СчетРасчетов",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	СвернутаяТаблица.Колонки.Добавить("КПСРасчетов",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	СвернутаяТаблица.Колонки.Добавить("КЭКРасчетов",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	СвернутаяТаблица.Колонки.Добавить("СубконтоРасчетов1",     ОписаниеТиповСубконто);
	СвернутаяТаблица.Колонки.Добавить("СубконтоРасчетов2",     ОписаниеТиповСубконто);
	СвернутаяТаблица.Колонки.Добавить("СубконтоРасчетов3",     ОписаниеТиповСубконто);
	СвернутаяТаблица.Колонки.Добавить("ПодразделениеРасчетов", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	СвертываемыеКолонки = Новый Массив;
	ПоляФункции = Новый Массив;
	Для Каждого Колонка Из СвернутаяТаблица.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
		Если Колонка.Имя <> "Сумма" Тогда
			СвертываемыеКолонки.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыОбъекта = ИсточникиДанных.Документ[0];
	СчетРасчетов     = БухгалтерскиеОперации.СчетПоКЭК(Параметры.КЭКДебета, "302.00");
	Контрагент       = БухгалтерскиеОперации.ПолучитьКонтрагентаДляУчетаКомпенсацииРодительскойПлаты();
	Договор          = Параметры.Обязательство;
	
	ДанныеПроводки = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
	ДанныеПроводки.Организация = РеквизитыОбъекта.Документ_Организация;
	ДанныеПроводки.ИФО         = РеквизитыОбъекта.Документ_ИФО;
	ДанныеПроводки.Дата        = РеквизитыОбъекта.Документ_Дата;
	ДанныеПроводки.Счет        = СчетРасчетов;
	ДанныеПроводки.Субконто1   = Контрагент;
	ДанныеПроводки.Субконто2   = Договор;
	ДанныеПроводки.Субконто3   = Неопределено;
	ДанныеПроводки.ДтКт        = "Кт";
	
	Для Каждого СтрокаТаблицы Из ИсточникиДанных.Начисления Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Начисления_КПС) Тогда
			КПС = СтрокаТаблицы.Начисления_КПС;
		Иначе
			КПС = Параметры.КПС;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТаблицы.Начисления_КФО) Тогда
			КФО = СтрокаТаблицы.Начисления_КФО;
		Иначе
			КФО = Параметры.КФО;
		КонецЕсли;
		ДанныеПроводки.КФО = КФО;
		КЭКРасчетов = БухгалтерскийУчет.КЭКПроводки(ДанныеПроводки);
		
		НоваяСтрока = СвернутаяТаблица.Добавить();
		НоваяСтрока.КФО                     = КФО;
		НоваяСтрока.Сумма                   = СтрокаТаблицы.Начисления_СуммаКомпенсации;
		НоваяСтрока.ИФО                     = РеквизитыОбъекта.Документ_ИФО;
		НоваяСтрока.СчетДебета              = Параметры.СчетДебета;
		НоваяСтрока.КПСДебета               = КПС;
		НоваяСтрока.КЭКДебета               = Параметры.КЭКДебета;
		НоваяСтрока.СубконтоДебета1         = Параметры.СубконтоДебета1;
		НоваяСтрока.СубконтоДебета2         = Параметры.СубконтоДебета2;
		НоваяСтрока.СубконтоДебета3         = Параметры.СубконтоДебета3;
		НоваяСтрока.ПодразделениеДебета     = РеквизитыОбъекта.Документ_Подразделение;
		НоваяСтрока.СчетРасчетов            = СчетРасчетов;
		НоваяСтрока.КПСРасчетов             = КПС;
		НоваяСтрока.КЭКРасчетов             = КЭКРасчетов;
		НоваяСтрока.СубконтоРасчетов1       = Контрагент;
		НоваяСтрока.СубконтоРасчетов2       = Договор;
