	ТаблицаРасчетовСЗачетомАвансов = ?(ДополнительныеСвойства.Свойство("ТаблицаРасчетовСЗачетомАвансов"),
		ДополнительныеСвойства.ТаблицаРасчетовСЗачетомАвансов,
		Неопределено);
	
	// Подготовим таблицу для отражения поступления материальных запасов,
	ТаблицаПоступления = УчетРасчетов.ТаблицаПоступлениеУслугРаботРезерв(
		ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты, Отказ);
	// и сохраним ее для формирования других источников данных.
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	// Таблица "ПоступлениеУслугРаботРезерв" содержит все колонки таблицы "ТаблицаПоступлениеУслугРабот",
	// поэтому для дальнейшей обработки ее можно сохранить под тем же именем.
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаПоступлениеУслугРабот", ТаблицаПоступления.Скопировать());
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаПоступления;
	
КонецФункции

Функция ПоступлениеДопРасходов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ИФО",               Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",               Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",               Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ЦМО",               Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Подразделение",     Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетВложений",      Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ПартияВложений",
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПланыВидовХарактеристик.ВидыСубконто.Партии, "ТипЗначения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "БазаРаспределения", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетРасчетов",      Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаПоступления = УчетРасчетов.ПустаяТаблицаПоступлениеДопРасходов();
	Для Каждого Колонка Из ТаблицаПоступления.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Реквизиты.Вставить("Организация",     ДокументОбъект.Организация);
	Реквизиты.Вставить("Дата",            ДокументОбъект.Дата);
	Реквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	Если Параметры.Свойство("ПартияВложений") И ЗначениеЗаполнено(Параметры.ПартияВложений) Тогда
		
		Если ТипЗнч(Параметры.ПартияВложений) <> Тип("ДокументСсылка.ПоступлениеОС") Тогда
			
			// КФО определим из проводок документа партии.
			СчетаВложений = "105.00,106.2П,106.3П,106.4П,106.27,106.37";
			КФОВложений = БухгалтерскиеОперации.РеквизитПроводкиДокумента("КФО",
				Параметры.ПартияВложений, СчетаВложений, "Дт");
			Параметры.Вставить("КФО", КФОВложений);
			
			Если НЕ ЗначениеЗаполнено(КФОВложений) Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					СтрШаблон(НСтр("ru='Документ партии %1 не формирует проводок по счетам вложений в МЗ и БА (%1).'"),
						СчетаВложений),
					Параметры.ПартияВложений);
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстОшибки, "ПартияМПЗ", Отказ);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(НСтр("ru='Документ партии не указан.'"), "ПартияМПЗ", Отказ);
		
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		
		ТаблицаДокумента = УчетРасчетов.ПодготовитьТаблицуПоступлениеУслугРаботПоДокументу(
			Реквизиты.Ссылка, Параметры);
		
		ТаблицаРасчетовСЗачетомАвансов = ?(ДополнительныеСвойства.Свойство("ТаблицаРасчетовСЗачетомАвансов"),
			ДополнительныеСвойства.ТаблицаРасчетовСЗачетомАвансов,
			Неопределено);
		
		// Подготовим таблицу для отражения поступления доп. расходов.
		ТаблицаПоступления = УчетРасчетов.ТаблицаПоступлениеДопРасходов(
			ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты, Отказ);
		
	КонецЕсли;
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаПоступлениеДопРасходов", ТаблицаПоступления.Скопировать());
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаПоступления;
	
КонецФункции

// Услуги оказанные

Функция РеализацияУслугРабот(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КЭКРасчетов",   Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
		// Аналитика доходов БУ и НУ.
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетДБП",               Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетДоходов",           Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СубконтоДоходов1" ,     Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СубконтоДоходов2",      Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СубконтоДоходов3",      Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ВидДеятельностиНУ",     Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДеятельностиДляНалоговогоУчетаЗатрат"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетДоходовНУ",         Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СтатьяПрочихДоходовНУ", Новый ОписаниеТипов("СправочникСсылка.ПрочиеДоходыИРасходы"));
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаРеализации = УчетРасчетов.ПустаяТаблицаРеализацияУслугРабот();
	Для Каждого Колонка Из ТаблицаРеализации.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	// Для корректной работы ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу.
	Если Параметры.Свойство("СубконтоДоходов1") И Параметры.СубконтоДоходов1 = Неопределено Тогда
		Параметры.СубконтоДоходов1 = "";
	КонецЕсли;
	Если Параметры.Свойство("СубконтоДоходов2") И Параметры.СубконтоДоходов2 = Неопределено Тогда
		Параметры.СубконтоДоходов2 = "";
	КонецЕсли;
	Если Параметры.Свойство("СубконтоДоходов3") И Параметры.СубконтоДоходов3 = Неопределено Тогда
		Параметры.СубконтоДоходов3 = "";
	КонецЕсли;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	ТаблицаДокумента = УчетРасчетов.ПодготовитьТаблицуРеализацияУслугРаботПоДокументу(
		Реквизиты.Ссылка, Параметры);
	
	ТаблицаРасчетовСЗачетомАвансов = ?(ДополнительныеСвойства.Свойство("ТаблицаРасчетовСЗачетомАвансов"),
		ДополнительныеСвойства.ТаблицаРасчетовСЗачетомАвансов,
		Неопределено);
	
	// Подготовим таблицу для отражения реализации услуг, работ,
	ТаблицаРеализации = УчетРасчетов.ТаблицаРеализацияУслугРабот(
		ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты, Отказ);
	// и сохраним ее для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаРеализацияУслугРабот", ТаблицаРеализации.Скопировать());
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаРеализации;
	
КонецФункции

// Завершение работ

Функция ЗавершениеРабот_НачислениеДоходов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ВычисляемыеПоля = Новый Структура;
	
	// Счет и аналитика накопленных доходов будущих периодов.
	ВычисляемыеПоля.Вставить("Счет",              Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ВычисляемыеПоля.Вставить("КПС",               Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ВычисляемыеПоля.Вставить("КЭК",               Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ВычисляемыеПоля.Вставить("Подразделение",     Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ВычисляемыеПоля.Вставить("Субконто1",         ОписаниеТиповСубконто);
	ВычисляемыеПоля.Вставить("Субконто2",         ОписаниеТиповСубконто);
	ВычисляемыеПоля.Вставить("Субконто3",         ОписаниеТиповСубконто);
	
	// Вспомогательные поля для идентификации доходов будущих периодов.
	ВычисляемыеПоля.Вставить("Номенклатура",              Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ВычисляемыеПоля.Вставить("НоменклатураПредставление", Новый ОписаниеТипов("Строка"));
	
	// Суммы накопленных доходов будущих периодов.
	ВычисляемыеПоля.Вставить("СуммаДоходов", ОписаниеТипаСуммы);
	ВычисляемыеПоля.Вставить("СуммаДоходовВал", ОписаниеТипаСуммы);
	ВычисляемыеПоля.Вставить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	ПоляФункции = Новый Массив;
	Для Каждого ВычисляемоеПоле Из ВычисляемыеПоля Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, ВычисляемоеПоле.Ключ, ВычисляемоеПоле.Значение);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	// Номенклатура выполненных работ по всем этапам договора.
	НоменклатураРабот = Документы.ЗавершениеРабот.НоменклатураВыполненныхРабот(РеквизитыДокумента.Ссылка);
	
	// Накопленные доходы будущих периодов по всем этапам договора.
	ОстаткиДБП = Документы.ЗавершениеРабот.НакопленныеДоходыБудущихПериодов(
		Новый Граница(РеквизитыДокумента.Дата, ВидГраницы.Включая),
		РеквизитыДокумента.Организация, РеквизитыДокумента.ИФО, РеквизитыДокумента.КФО,
		НоменклатураРабот);
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// Заполняем таблицу источника данных.
	Для Каждого ДБПпоВыполненнымРаботам Из ОстаткиДБП Цикл
		
		Если ДБПпоВыполненнымРаботам.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаРезультат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДБПпоВыполненнымРаботам);
		
		Если ИспользоватьВалютныйУчет
			И ЗначениеЗаполнено(ДБПпоВыполненнымРаботам.Валюта)
			И ДБПпоВыполненнымРаботам.Валюта <> ВалютаРегламентированногоУчета Тогда
			НоваяСтрока.Валюта = ДБПпоВыполненнымРаботам.Валюта;
			НоваяСтрока.СуммаДоходовВал = ДБПпоВыполненнымРаботам.ВалютнаяСумма;
			НоваяСтрока.СуммаДоходов = ДБПпоВыполненнымРаботам.Сумма;
		Иначе
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
			НоваяСтрока.СуммаДоходов = ДБПпоВыполненнымРаботам.Сумма;
			НоваяСтрока.СуммаДоходовВал = НоваяСтрока.СуммаДоходов;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция ЗавершениеРабот_СписаниеРасходов(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ВычисляемыеПоля = Новый Структура;
	
	// Счет и аналитика накопленных расходов на выполнение работ.
	ВычисляемыеПоля.Вставить("СчетРасходов",              Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ВычисляемыеПоля.Вставить("КПСРасходов",               Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ВычисляемыеПоля.Вставить("КЭКРасходов",               Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ВычисляемыеПоля.Вставить("ПодразделениеРасходов",     Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ВычисляемыеПоля.Вставить("СубконтоРасходов1",         ОписаниеТиповСубконто);
	ВычисляемыеПоля.Вставить("СубконтоРасходов2",         ОписаниеТиповСубконто);
	ВычисляемыеПоля.Вставить("СубконтоРасходов3",         ОписаниеТиповСубконто);
	
	// Вспомогательные поля для идентификации расходов.
	ВычисляемыеПоля.Вставить("Номенклатура",              Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ВычисляемыеПоля.Вставить("ВидЗатрат",                 Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ВычисляемыеПоля.Вставить("НоменклатураПредставление", Новый ОписаниеТипов("Строка"));
	ВычисляемыеПоля.Вставить("ВидЗатратПредставление",    Новый ОписаниеТипов("Строка"));
	
	// Счет и аналитика доходов будущих периодов (ДБП).
	ВычисляемыеПоля.Вставить("СчетДБП",                   Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ВычисляемыеПоля.Вставить("КПС_ДБП",                   Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ВычисляемыеПоля.Вставить("КЭК_ДБП",                   Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ВычисляемыеПоля.Вставить("ПодразделениеДБП",          Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ВычисляемыеПоля.Вставить("СубконтоДБП1",              ОписаниеТиповСубконто);
	ВычисляемыеПоля.Вставить("СубконтоДБП2",              ОписаниеТиповСубконто);
	ВычисляемыеПоля.Вставить("СубконтоДБП3",              ОписаниеТиповСубконто);
	
	// Суммы накопленных расходов на выполнение работ.
	ВычисляемыеПоля.Вставить("СуммаРасходов",                ОписаниеТипаСуммы);
	ВычисляемыеПоля.Вставить("СуммаРасходовНУ",              ОписаниеТипаСуммы);
	ВычисляемыеПоля.Вставить("СуммаРасходовЕНВД",            ОписаниеТипаСуммы);
	ВычисляемыеПоля.Вставить("СуммаРасходовНеУчитываетсяНУ", ОписаниеТипаСуммы);

	ПоляФункции = Новый Массив;
	Для Каждого ВычисляемоеПоле Из ВычисляемыеПоля Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, ВычисляемоеПоле.Ключ, ВычисляемоеПоле.Значение);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции);
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	// Номенклатура выполненных работ по всем этапам договора.
	НоменклатураРабот = Документы.ЗавершениеРабот.НоменклатураВыполненныхРабот(РеквизитыДокумента.Ссылка);
	
	// Оставшиеся (не списанные) затраты на момент завершения работ.
	ОстаткиЗатрат = Документы.СписаниеЗатратПоУслугам.ОстаткиЗатратНаОказаниеУслуг(
		Новый Граница(РеквизитыДокумента.Дата, ВидГраницы.Включая),
		РеквизитыДокумента.Организация, РеквизитыДокумента.ИФО, РеквизитыДокумента.КФО,
		НоменклатураРабот);
		
	// Накопленные доходы будущих периодов по всем этапам договора.
	ОстаткиДБП = Документы.ЗавершениеРабот.НакопленныеДоходыБудущихПериодов(
		Новый Граница(РеквизитыДокумента.Дата, ВидГраницы.Включая),
		РеквизитыДокумента.Организация, РеквизитыДокумента.ИФО, РеквизитыДокумента.КФО,
		НоменклатураРабот);
	
	// Заполняем таблицу источника данных.
	Для Каждого ОстаткиЗатратБУ Из ОстаткиЗатрат.ТаблицаЗатратБУ Цикл
		
		Если ОстаткиЗатратБУ.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДБПпоВыполненнымРаботам = ОстаткиДБП.НайтиСтроки(Новый Структура("Номенклатура", ОстаткиЗатратБУ.Номенклатура));
		Если ДБПпоВыполненнымРаботам.Количество() = 0 Тогда
			
			ТекстСообщения = НСтр("ru='По работам ""%1"" не отражены доходы будущих периодов на счете 401.40.
				|
				|Остаток расходов на счете %2 в сумме %3 не списан.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
				ОстаткиЗатратБУ.НоменклатураПредставление,
				ОстаткиЗатратБУ.Счет,
				ОбщегоНазначенияБГУ.ФорматСумм(ОстаткиЗатратБУ.Сумма));
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, РеквизитыДокумента.Ссылка);
			Продолжить;
			
		КонецЕсли;
		
		// Остаток расходов распределим по КБК, КЭК и аналитике учета доходов на счете 401.40.
		БазаРаспределенияРасходов = Новый Массив;
		Для Каждого ДоходПоРаботам Из ДБПпоВыполненнымРаботам Цикл
			БазаРаспределенияРасходов.Добавить(ДоходПоРаботам.Сумма);
		КонецЦикла;
		
		РаспределениеРасходов = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			ОстаткиЗатратБУ.Сумма, БазаРаспределенияРасходов);
		Если РаспределениеРасходов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Индекс = 0 По РаспределениеРасходов.Количество() - 1 Цикл
			
			НоваяСтрока = ТаблицаРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиЗатратБУ);
			
			НоваяСтрока.СуммаРасходов = РаспределениеРасходов[Индекс];
			
			НоваяСтрока.СчетРасходов          = ОстаткиЗатратБУ.Счет;
			НоваяСтрока.КПСРасходов           = ОстаткиЗатратБУ.КПС;
			НоваяСтрока.КЭКРасходов           = ОстаткиЗатратБУ.КЭК;
			НоваяСтрока.ПодразделениеРасходов = ОстаткиЗатратБУ.Подразделение;
			НоваяСтрока.СубконтоРасходов1     = ОстаткиЗатратБУ.Субконто1;
			НоваяСтрока.СубконтоРасходов2     = ОстаткиЗатратБУ.Субконто2;
			НоваяСтрока.СубконтоРасходов3     = ОстаткиЗатратБУ.Субконто3;
			
			ДБПпоРаботам = ДБПпоВыполненнымРаботам[Индекс];
			НоваяСтрока.СчетДБП          = ДБПпоРаботам.Счет;
			НоваяСтрока.КПС_ДБП          = ДБПпоРаботам.КПС;
			НоваяСтрока.КЭК_ДБП          = ДБПпоРаботам.КЭК;
			НоваяСтрока.ПодразделениеДБП = ДБПпоРаботам.Подразделение;
			НоваяСтрока.СубконтоДБП1     = ДБПпоРаботам.Субконто1;
			НоваяСтрока.СубконтоДБП2     = ДБПпоРаботам.Субконто2;
			НоваяСтрока.СубконтоДБП3     = ДБПпоРаботам.Субконто3;
			
		КонецЦикла;
		
	КонецЦикла;

	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
		РеквизитыДокумента.Организация, РеквизитыДокумента.Дата, РеквизитыДокумента.КФО);
	Если ОтражатьВНалоговомУчете Тогда
		
		Для Каждого ОстаткиЗатратНУ Из ОстаткиЗатрат.ТаблицаЗатратНУ Цикл
			
			Если ОстаткиЗатратНУ.Сумма <= 0
			   И ОстаткиЗатратНУ.СуммаЕНВД <= 0
			   И ОстаткиЗатратНУ.СуммаНеУчитываетсяНУ <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиЗатратНУ);
			
			НоваяСтрока.СуммаРасходовНУ              = ОстаткиЗатратНУ.Сумма;
			НоваяСтрока.СуммаРасходовЕНВД            = ОстаткиЗатратНУ.СуммаЕНВД;
			НоваяСтрока.СуммаРасходовНеУчитываетсяНУ = ОстаткиЗатратНУ.СуммаНеУчитываетсяНУ;
			
			НоваяСтрока.СчетРасходов      = ОстаткиЗатратНУ.Счет;
			НоваяСтрока.СубконтоРасходов1 = ОстаткиЗатратНУ.Субконто1;
			НоваяСтрока.СубконтоРасходов2 = ОстаткиЗатратНУ.Субконто2;
			НоваяСтрока.СубконтоРасходов3 = ОстаткиЗатратНУ.Субконто3;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти

#Область УчетПроизводства

Функция ФактическаяСтоимостьВыпущеннойПродукции(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ПустаяТаблица = Документы.ЗакрытиеСчетовПроизводственныхЗатрат.ПустаяТаблицаФактическаяСтоимостьПродукции();
	Для Каждого Колонка Из ПустаяТаблица.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	ТаблицаФактическаяСтоимостьПродукции =
		Документы.ЗакрытиеСчетовПроизводственныхЗатрат.ТаблицаФактическаяСтоимостьПродукции(
			ДокументОбъект.Ссылка);
	
	Возврат ТаблицаФактическаяСтоимостьПродукции;
	
КонецФункции

