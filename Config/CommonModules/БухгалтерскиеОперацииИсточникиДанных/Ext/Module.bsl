Процедура ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции) Экспорт

	Для каждого ПолеРезультата Из ПоляФункции Цикл
	
		ТаблицаРезультат.Колонки.Добавить(ПолеРезультата.Имя, ПолеРезультата.Тип);
	
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьТипыДокументовВОбъявлениеФункции(ФункцияМодуля, ИменаДокументовСтрокой) Экспорт

	ИменаДокументов = СтрРазделить(ИменаДокументовСтрокой, ",;" + Символы.ПС, Ложь);
	Для каждого ИмяДокумента Из ИменаДокументов Цикл
	
		ФункцияМодуля.ТипыДокументов.Добавить(Тип("ДокументСсылка." + ИмяДокумента));
	
	КонецЦикла;

КонецПроцедуры

Функция РеквизитыДокумента(ИсточникиДанных) Экспорт
	
	Реквизиты = Новый Структура;
	
	ПрефиксДокумента = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("Документ");
	ДлинаПрефикса    = СтрДлина(ПрефиксДокумента);
	
	ДанныеДокумента = ИсточникиДанных["Документ"][0];
	Для Каждого Колонка Из ИсточникиДанных["Документ"].Колонки Цикл
		Если Лев(Колонка.Имя, ДлинаПрефикса) = ПрефиксДокумента Тогда
			Реквизиты.Вставить(Сред(Колонка.Имя, ДлинаПрефикса+1), ДанныеДокумента[Колонка.Имя]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Реквизиты;
	
КонецФункции

Функция РеквизитыТиповойОперации(ИсточникиДанных) Экспорт
	
	Реквизиты = Новый Структура;
	
	ПрефиксДопРеквизита = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных("ДополнительныйРеквизит");
	ДлинаПрефикса       = СтрДлина(ПрефиксДопРеквизита);
	
	ДанныеДокумента = ИсточникиДанных["Документ"][0];
	Для Каждого Колонка Из ИсточникиДанных["Документ"].Колонки Цикл
		Если Лев(Колонка.Имя, ДлинаПрефикса) = ПрефиксДопРеквизита Тогда
			Реквизиты.Вставить(Сред(Колонка.Имя, ДлинаПрефикса+1), ДанныеДокумента[Колонка.Имя]);
		КонецЕсли;
	КонецЦикла;
	
	Реквизиты.Вставить("ТиповаяОперация", ДанныеДокумента.ТиповаяОперация);
	
	Возврат Реквизиты;
	
КонецФункции

Функция ПолучитьТаблицуДанныхИзИсточниковДанных(ИсточникиДанных, ИмяТаблицыДанных, УдалятьПрефикс) Экспорт

	ПрефиксКолонки = БухгалтерскиеОперацииСервер.ПрефиксКолонкиИсточникаДанных(ИмяТаблицыДанных);
	ИменаКолонок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("НомерСтроки");
	Для каждого КолонкаИсточника Из ИсточникиДанных[ИмяТаблицыДанных].Колонки Цикл
	
		Если СтрНачинаетсяС(КолонкаИсточника.Имя, ПрефиксКолонки) Тогда
			ИменаКолонок.Добавить(КолонкаИсточника.Имя);
		КонецЕсли;
	
	КонецЦикла;
	
	Таблица = ИсточникиДанных[ИмяТаблицыДанных].Скопировать(,СтрСоединить(ИменаКолонок, ","));
	
	Если УдалятьПрефикс Тогда
		
		ДлинаПрефикса = СтрДлина(ПрефиксКолонки);
		Для каждого Колонка Из Таблица.Колонки Цикл
			
			Если СтрНачинаетсяС(Колонка.Имя, ПрефиксКолонки) Тогда
				Колонка.Имя = Сред(Колонка.Имя, ДлинаПрефикса + 1);
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Таблица;

КонецФункции

// Тестовая функция с параметром.
// 
// Параметры:
//  ВариантВызова - Строка
//  ИсточникиДанных - Структура
//  ТиповаяОперация - СправочникСсылка.ТиповыеОперации
//  Параметры - Структура
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Тестовая функция с параметром
Функция ТестоваяФункцияСПараметром(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
		
		Возврат ПараметрыФункции;
	КонецЕсли;
	
		ПоляФункции = Новый Массив;
		
		Для каждого ТекПоле Из Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.Измерения Цикл
			
			Если ТекПоле.Балансовый Тогда
				ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя, ТекПоле.Тип);	
			Иначе
				ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя + "Дт", ТекПоле.Тип);	
				ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя + "Кт", ТекПоле.Тип);
			КонецЕсли;
		
		КонецЦикла; 
		
		Для каждого ТекПоле Из Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.Ресурсы Цикл
			
			Если ТекПоле.Балансовый Тогда
				ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя, ТекПоле.Тип);	
			Иначе
				ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя + "Дт", ТекПоле.Тип);	
				ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя + "Кт", ТекПоле.Тип);
			КонецЕсли;
		
		КонецЦикла; 
		
		Для каждого ТекПоле Из Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.Реквизиты Цикл
			
			ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя, ТекПоле.Тип);	
		
		КонецЦикла;
		
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СчетДт", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СубконтоДт1", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СубконтоДт2", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СубконтоДт3", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СчетКт", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СубконтоКт1", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СубконтоКт2", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СубконтоКт3", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Регистратор", Документы.ТипВсеСсылки());	
		
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	Для каждого ПолеРезультата Из ПоляФункции Цикл
	
		ТаблицаРезультат.Колонки.Добавить(ПолеРезультата.Имя, ПолеРезультата.Тип);
	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(, , Организация = &Организация, , 5) КАК ЖурналПроводокЕПСБУДвиженияССубконто";
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(ТаблицаРезультат.Добавить(), Выборка);
		
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции // ТестоваяФункцияСПараметром()

Функция ТаблицаСписаниеОсновныхСредствСЗабаланса(ПоступлениеМЗ, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставДокумента.СубконтоЗабалансовыйСчет1,
	|	СоставДокумента.СубконтоЗабалансовыйСчет2,
	|	СоставДокумента.СубконтоЗабалансовыйСчет3,
	|	СоставДокумента.Количество,
	|	СоставДокумента.НомерСтроки,
	|	СоставДокумента.КФО
	|ПОМЕСТИТЬ СоставДокумента
	|ИЗ
	|	&СоставДокумента КАК СоставДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2,
	|	ЕстьNULL(ЖурналПроводокЕПСБУОстатки.Субконто3, НЕОПРЕДЕЛЕНО) КАК Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.КФО
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет = &Счет,, Организация = &Организация
	|	И &УсловиеПодразделение
	|	И &УсловиеИФО) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставДокумента.КФО,
	|	СоставДокумента.СубконтоЗабалансовыйСчет1,
	|	СоставДокумента.СубконтоЗабалансовыйСчет2,
	|	СоставДокумента.СубконтоЗабалансовыйСчет3,
	|	СоставДокумента.Количество,
	|	СоставДокумента.НомерСтроки,
	|	ВЫБОР
	|		КОГДА ЕстьNULL(Остатки.КоличествоОстатокДт, 0) = 0
	|			ТОГДА 0
	|		КОГДА Остатки.КоличествоОстатокДт = СоставДокумента.Количество
	|			ТОГДА Остатки.СуммаОстатокДт
	|		ИНАЧЕ ВЫРАЗИТЬ(СоставДокумента.Количество * Остатки.СуммаОстатокДт / Остатки.КоличествоОстатокДт КАК Число(15, 2))
	|	КОНЕЦ КАК Стоимость,
	|	ВЫБОР
	|		КОГДА ЕстьNULL(Остатки.КоличествоОстатокДт, 0) < СоставДокумента.Количество
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Нехватка,
	|	ЕстьNULL(Остатки.КоличествоОстатокДт, 0) КАК КоличествоОстаток
	|ИЗ
	|	СоставДокумента КАК СоставДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО СоставДокумента.СубконтоЗабалансовыйСчет1 = Остатки.Субконто1
	|		И СоставДокумента.СубконтоЗабалансовыйСчет2 = Остатки.Субконто2
	|		И СоставДокумента.СубконтоЗабалансовыйСчет3 = Остатки.Субконто3
	|		И СоставДокумента.КФО = Остатки.КФО";
	
	Запрос.УстановитьПараметр("СоставДокумента", ПоступлениеМЗ.Материалы.Выгрузить());
	Запрос.УстановитьПараметр("Счет", ПоступлениеМЗ.ЗабалансовыйСчет);
	Запрос.УстановитьПараметр("Организация", ПоступлениеМЗ.Организация);
	Запрос.УстановитьПараметр("Подразделение", ПоступлениеМЗ.Подразделение);
	Запрос.УстановитьПараметр("ИФО", ПоступлениеМЗ.ИФО);
	Запрос.УстановитьПараметр("Период", Новый Граница(ПоступлениеМЗ.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПоступлениеМЗ.ЗабалансовыйСчет);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И СвойстваСчета.УчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "Подразделение = &Подразделение");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ИСТИНА");
	КонецЕсли; 
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли; 
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	СтрокиНехватки = Результат.НайтиСтроки(Новый Структура("Нехватка", Истина));
	Если СтрокиНехватки.Количество() > 0 Тогда
		ИмяПоляСубконтоОС = "";
		Для Индекс = 1 По СвойстваСчета.КоличествоСубконто Цикл
			Если СвойстваСчета["ВидСубконто" + Индекс] = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
				ИмяПоляСубконтоОС = "СубконтоЗабалансовыйСчет" + Индекс;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	СинонимСписка = НСтр("ru = 'Материалы'");
	Для Каждого Нехватка Из СтрокиНехватки Цикл
		
		ТекстОшибки = НСтр("ru='Указанное количество ""%5"" превышает остаток по счету %4.
			|Остаток: %1; Не хватает: %2'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
			Нехватка.КоличествоОстаток,
			Нехватка.Количество - Нехватка.КоличествоОстаток,
			,
			СвойстваСчета.Код,
			Нехватка[ИмяПоляСубконтоОС]);
			
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
			НСтр("ru = 'Количество'"),
			Нехватка.НомерСтроки,
			СинонимСписка,
			ТекстОшибки);
			
		ПолеКоличество = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Материалы", Нехватка.НомерСтроки, "Количество");
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ПоступлениеМЗ.Ссылка, ПолеКоличество, "Объект", Отказ);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьИмяФункции(ИмяФункции)
	ИмяФункцииВРег = ВРег(ИмяФункции);
	ВсеИсточники = ОбъявленияВсехФункцийМодуля();
	Для Каждого ФункцияИсточника Из ВсеИсточники Цикл
		Если ИмяФункцииВРег = ВРег(ФункцияИсточника.Имя) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон(НСтр("ru = 'В источник данных в модуле БухгалтерскиеОперацииИсточникиДанных передано имя несуществующей функции
		|%1'"), ИмяФункции);
КонецПроцедуры

#КонецОбласти


#КонецЕсли
