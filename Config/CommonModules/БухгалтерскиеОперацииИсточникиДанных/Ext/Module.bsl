		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ПлатежнаяВедомость0504403",
										Новый ОписаниеТипов("ДокументСсылка.ПлатежнаяВедомость0504403"));
		Возврат ПараметрыФункции;
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаРасчетов = РасчетыСПодотчетнымиЛицами.ПустаяТаблицаВыплатПодотчетнымЛицамИзКассы();
	
	Для Каждого Колонка Из ТаблицаРасчетов.Колонки Цикл
