		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ОсновноеСредствоНовое", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"ИнвентарныйНомерНовый", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		ДобавитьПолеРезультатаФункции(ПоляФункции, 
			"Сумма", Новый ОписаниеТипов("Число"));

		Возврат ПоляФункции;
	КонецЕсли;	
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		
		Возврат ПараметрыФункции;
	КонецЕсли;	

	ДокументОбъект = ИсточникиДанных["ДокументОбъект"];
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Счета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ПОДСТРОКА(ЕПСБУ.Код, 1, 3) В (""Н02"", ""Н05"")
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧИнвентарныеНомера.ИнвентарныйНомерВГруппе КАК ИнвентарныйНомерВГруппе,
	|	ТЧИнвентарныеНомера.ОсновноеСредство КАК ОсновноеСредствоНовое,
	|	ТЧИнвентарныеНомера.ИнвентарныйНомер КАК ИнвентарныйНомерНовый
	|ПОМЕСТИТЬ ТЧ_ИнвентарныеНомера
	|ИЗ
	|	&ТЧИнвентарныеНомера КАК ТЧИнвентарныеНомера
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	- ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма
	|ПОМЕСТИТЬ ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаПроведения, Счет В
	|		(ВЫБРАТЬ
	|			Таб.Ссылка
	|		ИЗ
	|			Счета КАК Таб),, Организация = &Организация
	|	И Субконто1 = &ОС) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(СтоимостьОбъектовОСОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ КоличествоОбъектовПоРН
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&ДатаПроведения, Организация = &Организация
	|	И ОсновноеСредство = &ОС
	|	И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиБУ.Счет КАК Счет,
	|	ОстаткиБУ.ИФО КАК ИФО,
	|	ОстаткиБУ.Подразделение КАК Подразделение,
	|	ОстаткиБУ.КФО КАК КФО,
	|	ОстаткиБУ.ОсновноеСредство КАК ОсновноеСредство,
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ИнвентарныйНомерВГруппе, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК
	|		ИнвентарныйНомер,
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ОсновноеСредствоНовое, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК
	|		ОсновноеСредствоНовое,
	|	ЕСТЬNULL(ТЧ_ИнвентарныеНомера.ИнвентарныйНомерНовый, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК
	|		ИнвентарныйНомерНовый,
	|	ВЫБОР
	|		КОГДА КоличествоОбъектовПоРН.Количество = 0
	|			ТОГДА ОстаткиБУ.Сумма
	|		ИНАЧЕ ОстаткиБУ.Сумма / КоличествоОбъектовПоРН.Количество
	|	КОНЕЦ КАК Сумма
	|ИЗ
	|	ОстаткиБУ КАК ОстаткиБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоОбъектовПоРН КАК КоличествоОбъектовПоРН
	|		ПО ОстаткиБУ.ОсновноеСредство = КоличествоОбъектовПоРН.ОсновноеСредство,
	|	ТЧ_ИнвентарныеНомера КАК ТЧ_ИнвентарныеНомера";	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаПроведения", ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ОС", ДокументОбъект.ОсновноеСредствоГрупповое);
	Запрос.УстановитьПараметр("ТЧИнвентарныеНомера", ДокументОбъект["ИнвентарныеНомера"].Выгрузить());
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

#КонецОбласти

#Область УчетОсновныхСредств_ИмуществаКазны

Функция РеализацияОсновныхСредствИмуществаКазны(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КЭКДоходов",    Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаРеализации = УправлениеОсновнымиСредствами.ПустаяТаблицаРеализацияОсновныхСредств();
	Для Каждого Колонка Из ТаблицаРеализации.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	ТаблицаДокумента = УправлениеОсновнымиСредствами.ПодготовитьТаблицуРеализацияОсновныхСредствПоДокументу(
		Реквизиты.Ссылка, Параметры);
	
	ТаблицаРасчетовСЗачетомАвансов = ?(ДополнительныеСвойства.Свойство("ТаблицаРасчетовСЗачетомАвансов"),
		ДополнительныеСвойства.ТаблицаРасчетовСЗачетомАвансов,
		Неопределено);
	
	// Подготовим таблицу для отражения реализации основных средств,
	ТаблицаРеализации = УправлениеОсновнымиСредствами.ТаблицаРеализацияОсновныхСредств(
		ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты, Отказ);
	// и сохраним ее для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаблицаРеализацияОсновныхСредств",
		ТаблицаРеализации.Скопировать());
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаРеализации;
	
КонецФункции

Функция РешениеОбОценкеИмуществаКазны(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Таблица = Документы.РешениеОбОценкеИмуществаКазны.ТаблицаОС();
		ПоляФункции = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Новый ОписаниеТипов(Колонка.ТипЗначения,, "Null"));
		КонецЦикла;
		Возврат ПоляФункции;
	КонецЕсли;
		
	Если ВариантВызова = "Выполнить" Тогда
		РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
		Возврат Документы.РешениеОбОценкеИмуществаКазны.ТаблицаОС(РеквизитыДокумента);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция РешениеОПризнанииОбъектовОСИКПоКПС(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ИмяСписка"						, Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(80)));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "НомерСтроки"					, Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5,0, ДопустимыйЗнак.Неотрицательный)));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ОбъектВложений"					, Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КПСВложений"					, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СчетВложений"					, Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ЦМОВложений"					, Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "ДоговорВложений"				, Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "КоличествоВложений"				, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,0)));
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СуммаВложений"					, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
	// Добавляем все колонки таб.части "ОсновныеСредства".
	Для Каждого КолонкаДокумента Из Метаданные.Документы.РешениеОПризнанииОбъектовОСИК.ТабличныеЧасти.ОсновныеСредства.Реквизиты Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, КолонкаДокумента.Имя, КолонкаДокумента.Тип);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументОбъект = ИсточникиДанных.ДокументОбъект;
	
	ТаблицаКапВложений = ПолучитьТаблицуДанныхИзИсточниковДанных(ИсточникиДанных, "КапитальныеВложения", Истина);
	КоэффициентыРаспределенияСуммы = ТаблицаКапВложений.ВыгрузитьКолонку("Сумма");
	КоэффициентыРаспределенияКоличества = ТаблицаКапВложений.ВыгрузитьКолонку("Количество");
	КоличествоСтрокВложений = ТаблицаКапВложений.Количество();
	
	Если ТаблицаКапВложений.Колонки.Найти("Договор") = Неопределено Тогда
		ТаблицаКапВложений.Колонки.Добавить("Договор");
	КонецЕсли;
	
	ТаблицаОС = ПолучитьТаблицуДанныхИзИсточниковДанных(ИсточникиДанных, "ОсновныеСредства", Истина);
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	Для Каждого ПолеРезультата Из ПоляФункции Цикл
		ТаблицаРезультат.Колонки.Добавить(ПолеРезультата.Имя, ПолеРезультата.Тип);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
		
		РаспределенныеСуммы = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаТаблицыОС["Сумма"], КоэффициентыРаспределенияСуммы, 2);
		РаспределенноеКоличество = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаТаблицыОС["Количество"], КоэффициентыРаспределенияКоличества, 0);
		
		Для ИндексСтрокиВложений = 0 По КоличествоСтрокВложений - 1 Цикл
			
			НоваяСтрока = ТаблицаРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОС);
			НоваяСтрока.КПСВложений		= ТаблицаКапВложений[ИндексСтрокиВложений].КПС;
			НоваяСтрока.ЦМОВложений		= ТаблицаКапВложений[ИндексСтрокиВложений].ЦМО;
			НоваяСтрока.ДоговорВложений	= ТаблицаКапВложений[ИндексСтрокиВложений].Договор;
			
			Если ИндексСтрокиВложений > 0 Тогда
				НоваяСтрока.Количество = 0;
			КонецЕсли;
			
			НоваяСтрока["СуммаВложений"] = ?(РаспределенныеСуммы = Неопределено, 0, РаспределенныеСуммы[ИндексСтрокиВложений]);
			НоваяСтрока["КоличествоВложений"] = ?(РаспределенноеКоличество = Неопределено, 0, РаспределенноеКоличество[ИндексСтрокиВложений]);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти

#Область ГТДИмпорт

Функция ТаможенныеПлатежиПоМатериальнымЗапасам(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетВложений",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ВидЗатрат",     Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаТаможенныеПлатежи = УчетРасчетов.ПустаяТаблицаТаможенныеПлатежиПоМатериальнымЗапасам();
	Для Каждого Колонка Из ТаблицаТаможенныеПлатежи.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	ТаблицаТаможенныеПлатежи = УчетРасчетов.ПодготовитьТаблицуТаможенныеПлатежиПоМатериальнымЗапасамПоДокументу(
		Реквизиты.Ссылка, Параметры, Отказ);
	
	ТаблицаРасчетовСЗачетомАвансов = ?(ДополнительныеСвойства.Свойство("ТаблицаРасчетовСЗачетомАвансов"),
		ДополнительныеСвойства.ТаблицаРасчетовСЗачетомАвансов,
		Неопределено);
	
	Если НЕ Отказ Тогда
		
		// Подготовим таблицу таможенных платежей, связанных с приобретением материальных запасов.
		ТаблицаТаможенныеПлатежи = УчетРасчетов.ПодготовитьТаблицуТаможенныхПлатежей(
			ТаблицаТаможенныеПлатежи, ТаблицаРасчетовСЗачетомАвансов, Реквизиты, Отказ);
		
	КонецЕсли;
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаможенныеПлатежиПоМатериальнымЗапасам",
		ТаблицаТаможенныеПлатежи.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаТаможенныеПлатежи;
	
КонецФункции

Функция ТаможенныеПлатежиПоВнеоборотнымАктивам(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)
	
	Если ВариантВызова = "ПолучитьПараметры" Тогда
		
		ПараметрыФункции = Новый Массив;
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "СчетВложений",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "ВидЗатрат",     Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
		
		Возврат ПараметрыФункции;
		
	КонецЕсли;
	
	ПоляФункции = Новый Массив;
	
	ТаблицаТаможенныеПлатежи = УчетРасчетов.ПустаяТаблицаТаможенныеПлатежиПоВнеоборотнымАктивам();
	Для Каждого Колонка Из ТаблицаТаможенныеПлатежи.Колонки Цикл
		ДобавитьПолеРезультатаФункции(ПоляФункции, Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Отказ = Ложь;
	
	РеквизитыДокумента = РеквизитыДокумента(ИсточникиДанных);
	РеквизитыТиповойОперации = РеквизитыТиповойОперации(ИсточникиДанных);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Ссылка",          РеквизитыДокумента.Ссылка);
	Реквизиты.Вставить("Организация",     РеквизитыДокумента.Организация);
	Реквизиты.Вставить("Дата",            РеквизитыДокумента.Дата);
	Реквизиты.Вставить("ТиповаяОперация", РеквизитыТиповойОперации.ТиповаяОперация);
	
	Для Каждого Параметр Из Параметры Цикл
		Реквизиты.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	Реквизиты.Вставить("Курс",      КонтекстПроведения.Курс);
	Реквизиты.Вставить("Кратность", КонтекстПроведения.Кратность);
	
	ТаблицаТаможенныеПлатежи = УчетРасчетов.ПодготовитьТаблицуТаможенныеПлатежиПоВнеоборотнымАктивамПоДокументу(
		Реквизиты.Ссылка, Параметры, Отказ);
	
	ТаблицаРасчетовСЗачетомАвансов = ?(ДополнительныеСвойства.Свойство("ТаблицаРасчетовСЗачетомАвансов"),
		ДополнительныеСвойства.ТаблицаРасчетовСЗачетомАвансов,
		Неопределено);
	
	Если НЕ Отказ Тогда
		
		// Подготовим таблицу таможенных платежей, связанных с приобретением внеоборотных активов.
		ТаблицаТаможенныеПлатежи = УчетРасчетов.ПодготовитьТаблицуТаможенныхПлатежей(
			ТаблицаТаможенныеПлатежи, ТаблицаРасчетовСЗачетомАвансов, Реквизиты, Отказ);
		
	КонецЕсли;
	
	// Сохраним таблицу для формирования других источников данных.
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ТаможенныеПлатежиПоВнеоборотнымАктивам",
		ТаблицаТаможенныеПлатежи.Скопировать());
	КонтекстПроведения.Отказ = КонтекстПроведения.Отказ ИЛИ Отказ;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат ТаблицаТаможенныеПлатежи;
	
КонецФункции

