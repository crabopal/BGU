#Область ПрограммныйИнтерфейс

Процедура УстановитьТекстЗаголовкаБаннераУведомленияОПеремещении(Форма) Экспорт

	Объект = Форма.Объект;
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		СрокУведомления = ПрослеживаемостьБГУ.СрокПодачиУведомления(Объект.Дата);
	Иначе
		// Дата пустая - это новый документ
		СрокУведомления = '00010101';
	КонецЕсли;
		
	ШаблонТекста = НСтр("ru = 'В документе присутствуют прослеживаемые товары. До %1 необходимо создать уведомление о перемещении в ЕАЭС и отправить в ФНС.'");
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонТекста, Формат(СрокУведомления, "ДФ='дд ММММ'"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДекорацияУведомление",
		"Заголовок", Заголовок);

КонецПроцедуры

Процедура УстановитьПредставлениеНадписиУведомлениеОПеремещении(Форма) Экспорт
	
	НайденноеУведомление = НайтиУведомлениеОПеремещении(Форма);
	
	Если НайденноеУведомление = Ложь Тогда
		НадписьУведомлениеОПеремещении = "";
		НайденноеУведомление = Неопределено;
	ИначеЕсли ЗначениеЗаполнено(НайденноеУведомление) Тогда
		
		ПредставлениеДокумента = ПрослеживаемостьПереопределяемый.ПредставлениеДокумента(НайденноеУведомление);
		
		НадписьУведомлениеОПеремещении = Новый ФорматированнаяСтрока(ПредставлениеДокумента, , , , "ссылка");
		
	Иначе
		
		НадписьУведомлениеОПеремещении = Новый ФорматированнаяСтрока(
			НСтр("ru = 'Создать уведомление о перемещении прослеживаемых товаров'"),,ЦветаСтиля.ЦветОсобогоТекста,,"ссылка");
	
	КонецЕсли;
	
	Форма.УведомлениеОПеремещении  = НайденноеУведомление;
	Форма.НадписьУведомлениеОПеремещении = НадписьУведомлениеОПеремещении;

КонецПроцедуры

Процедура УстановитьПредставлениеНадписиУведомлениеОВвозе(Форма) Экспорт
	
	СписокУведомлений = СписокУведомлений(Форма);
	
	Форма.СписокУведомлений        = СписокУведомлений;
	Форма.НадписьУведомлениеОВвозе = ПредставлениеУведомлений(СписокУведомлений);

КонецПроцедуры

Процедура ЗаполнитьПредставлениеРНПТВПолеФормы(ПолеРНПТ, ПрослеживаемыйТовар, ИдентификаторСтроки, СведенияПрослеживаемости) Экспорт
	Если ПрослеживаемыйТовар Тогда
		ПолеРНПТ = ТекстПоляРНПТПрослеживаемыйТовар(ИдентификаторСтроки, СведенияПрослеживаемости);
	Иначе
		ПолеРНПТ = "";
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьПредставлениеРНПТ(Форма, СтрокаТабличнойЧасти, ПроверятьПрослеживаемыйТовар = Истина) Экспорт
	
	Объект = Форма.Объект;
	Если ПроверятьПрослеживаемыйТовар Тогда
		ЗаполнитьПредставлениеРНПТВПолеФормы(СтрокаТабличнойЧасти.РНПТ,
			СтрокаТабличнойЧасти.ПрослеживаемыйТовар,
			СтрокаТабличнойЧасти.ИдентификаторСтроки,
			Объект.СведенияПрослеживаемости);
	Иначе
		СтрокаТабличнойЧасти.РНПТ = ТекстПоляРНПТПрослеживаемыйТовар(СтрокаТабличнойЧасти.ИдентификаторСтроки,
			Объект.СведенияПрослеживаемости);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПредставлениеРНПТВоВсехСтроках(Форма, ИмяТаблицы = "Материалы", ПроверятьПрослеживаемыйТовар = Истина) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
		Возврат;
	КонецЕсли;
	
	Объект = Форма.Объект;
	
	Для Каждого Строка Из Объект[ИмяТаблицы] Цикл
		ЗаполнитьПредставлениеРНПТ(Форма, Строка, ПроверятьПрослеживаемыйТовар);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаВыбораРНПТСИменемТаблицы(Форма, ИдентификаторСтроки, ВыбранноеЗначение, СведенияПрослеживаемости) Экспорт
	Объект = Форма.Объект;
	
	СтрокиСРНПТ = Объект[СведенияПрослеживаемости].НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	
	Для Каждого СтрокаСРНПТ Из СтрокиСРНПТ Цикл
		Объект[СведенияПрослеживаемости].Удалить(СтрокаСРНПТ);
	КонецЦикла;
		
	ПодобранныеРНПТ = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТаблицыРНПТВХранилище);
	Для Каждого НовыйРНПТ Из ПодобранныеРНПТ Цикл
		НоваяСтрока = Объект[СведенияПрослеживаемости].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, НовыйРНПТ);
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаВыбораРНПТН(Форма, ИдентификаторСтроки, ВыбранноеЗначение) Экспорт
	
	ОбработкаВыбораРНПТСИменемТаблицы(Форма, ИдентификаторСтроки, ВыбранноеЗначение, "СведенияПрослеживаемости");
	
КонецПроцедуры

Процедура УстановитьУсловноеОформление(Форма) Экспорт

	Ссылка = Форма.Объект.Ссылка;
	УсловноеОформление = Форма.УсловноеОформление;
	ИмяТаблицы = ИмяТаблицыМатериалы(Ссылка);
	ТипДокумента = ТипЗнч(Ссылка);
	
	Если ИспользуетсяОформлениеПоляСтранаПроисхождения(ТипДокумента) Тогда
		ДобавитьУсловноеОформлениеПоляСтранаПроисхождения(УсловноеОформление, ИмяТаблицы);
	КонецЕсли;
	Если ИспользуетсяОформлениеПоляРНПТНеТребуется(ТипДокумента) Тогда
		ДобавитьУсловноеОформлениеПоляРНПТНеТребуется(УсловноеОформление, ИмяТаблицы);
	КонецЕсли;
	Если ИспользуетсяОформлениеПоляРНПТАвто(ТипДокумента) Тогда
		ДобавитьУсловноеОформлениеПоляРНПТАвто(УсловноеОформление, ИмяТаблицы);
	КонецЕсли;

КонецПроцедуры

Процедура НастроитьФормуИКолонкуПрослеживаемыйТовар(Форма, НаДату, ИмяТаблицы = "СоставНФА", ИмяКолонкиНоменклатура = "НФА", ИмяЭлементаТаблицы = "", ИмяКолонкиПрослеживаемыйТовар = "ПрослеживаемыйТовар") Экспорт
	
	Перем ЕстьПрослеживаемыеТовары;
	
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(НаДату);
	
	ПрослеживаемостьБГУ.ОбновитьПризнакПрослеживаемости(
		Форма.Объект,
		Форма.Объект[ИмяТаблицы],
		ВедетсяУчетПрослеживаемыхТоваров,
		ИмяКолонкиНоменклатура,
		ЕстьПрослеживаемыеТовары);
	
	ВидимостьРеквизитовПрослеживаемости = ВедетсяУчетПрослеживаемыхТоваров И ЕстьПрослеживаемыеТовары;
	
	// Колонка "Прослеживаемый товар"
	Если ЗначениеЗаполнено(ИмяЭлементаТаблицы) Тогда
		ИмяЭлементаКолонкаПрослеживаемыйТовар = ИмяЭлементаТаблицы + ИмяКолонкиПрослеживаемыйТовар;
	Иначе
		ИмяЭлементаКолонкаПрослеживаемыйТовар = ИмяТаблицы + ИмяКолонкиПрослеживаемыйТовар;
	КонецЕсли;
	
	Форма.Элементы[ИмяЭлементаКолонкаПрослеживаемыйТовар].Видимость = ВидимостьРеквизитовПрослеживаемости;
	
	// Страница "Прослеживаемые товары" в документах инвентаризации
	Элемент = Форма.Элементы.Найти("СтраницаПрослеживаемыеТовары");
	
	Если Элемент <> Неопределено Тогда
		Элемент.Видимость = ВедетсяУчетПрослеживаемыхТоваров;
	КонецЕсли;
	
	ОбновлениеФормы = Новый Структура();
	ОбновлениеФормы.Вставить("ВедетсяУчетПрослеживаемыхТоваров", ВедетсяУчетПрослеживаемыхТоваров);
	ОбновлениеФормы.Вставить("ЕстьПрослеживаемыеТовары", ЕстьПрослеживаемыеТовары);
	
	ЗаполнитьЗначенияСвойств(Форма, ОбновлениеФормы);
	
КонецПроцедуры

// Заполнить список выбора кода операции прослеживаемости.
// 
// Параметры:
//  Элемент - ПолеФормы:
//   * СписокВыбора - СписокЗначений из СправочникСсылка.КодыОперацийПрослеживаемости
//  КодыОперацийПрослеживаемости - Массив из СправочникСсылка.КодыОперацийПрослеживаемости
Процедура ЗаполнитьСписокВыбораКодаОперацииПрослеживаемости(Элемент, КодыОперацийПрослеживаемости) Экспорт
	Элемент.СписокВыбора.Очистить();
	ПредставленияОпераций = ПрослеживаемостьБГУПовтИсп.КодыОперацийПрослеживаемости();
	Шаблон = НСтр("ru = '%1 (%2)'");
	Для Каждого КодОперации Из КодыОперацийПрослеживаемости Цикл
		Представление = ПредставленияОпераций.Получить(КодОперации);
		Если Представление = Неопределено Тогда
			Элемент.СписокВыбора.Добавить(КодОперации);
		Иначе
			ЗначениеВыбора = Новый Структура;
			ЗначениеВыбора.Вставить("Значение", КодОперации);
			ЗначениеВыбора.Вставить("ПометкаУдаления", Представление.ПометкаУдаления);
			Элемент.СписокВыбора.Добавить(ЗначениеВыбора,
				СтрШаблон(Шаблон, Представление.Код, Представление.Наименование));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстПоляРНПТПрослеживаемыйТовар(ИдентификаторСтроки, СведенияПрослеживаемости)
	СтрокиСРНПТ = СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	Возврат ПрослеживаемостьФормыБГУКлиентСервер.ТекстПредставлениярРНПТ(СтрокиСРНПТ);
КонецФункции

Функция СписокУведомлений(Форма)
	
	СписокУведомлений = Новый СписокЗначений;
	
	Если Не ПравоДоступа("Чтение", Метаданные.Документы.УведомлениеОВвозеПрослеживаемыхТоваров) Тогда
		Возврат СписокУведомлений;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Форма.Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УведомлениеОВвозеПрослеживаемыхТоваров.Ссылка КАК УведомлениеОВвозе,
	|	УведомлениеОВвозеПрослеживаемыхТоваров.Номер КАК Номер,
	|	УведомлениеОВвозеПрослеживаемыхТоваров.Дата КАК Дата
	|ИЗ
	|	Документ.УведомлениеОВвозеПрослеживаемыхТоваров КАК УведомлениеОВвозеПрослеживаемыхТоваров
	|ГДЕ
	|	УведомлениеОВвозеПрослеживаемыхТоваров.Проведен
	|	И УведомлениеОВвозеПрослеживаемыхТоваров.ПервичныйДокумент = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	УведомлениеОВвозеПрослеживаемыхТоваров.Ссылка";
	
	Уведомления = Запрос.Выполнить().Выгрузить();
	ШаблонПредставления = НСтр("ru = '%1 №%2 от %3'");
	Для Каждого Уведомление Из Уведомления Цикл
		
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонПредставления,
			Уведомление.УведомлениеОВвозе.Метаданные().Представление(),
			ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Уведомление.Номер, Истина, Ложь),
			Формат(Уведомление.Дата, "ДЛФ=Д"));
		
		СписокУведомлений.Добавить(Уведомление.УведомлениеОВвозе, Представление);
		
	КонецЦикла;	
	
	Возврат СписокУведомлений;
	
КонецФункции

// Проверяет наличие  Уведомление о перемещении прослеживаемых товаров введенных на основании указанного документа
//
// Параметры:
//  Документ - ДокументСсылка, Документ основание, по которому проверяется  существование Уведомлений о перемещении
//
// Возвращаемые параметры:
// - Булево - Истина, если на основании документа введены уведомления о перемещении
//
Функция НайтиУведомлениеОПеремещении(Форма)
	
	Если Не ПравоДоступа("Чтение", Метаданные.Документы.УведомлениеОПеремещенииПрослеживаемыхТоваров) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Документ", Форма.Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УведомлениеОПеремещенииПрослеживаемыхТоваровТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УведомлениеОПеремещенииПрослеживаемыхТоваров.Товары КАК УведомлениеОПеремещенииПрослеживаемыхТоваровТовары
	|ГДЕ
	|	УведомлениеОПеремещенииПрослеживаемыхТоваровТовары.СопроводительныйДокумент = &Документ
	|	И УведомлениеОПеремещенииПрослеживаемыхТоваровТовары.Ссылка.Проведен";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПредставлениеУведомлений(СписокУведомлений)
	
	Если СписокУведомлений.Количество() = 0 Тогда
		
		ПредставлениеУведомлений = Новый ФорматированнаяСтрока(
			НСтр("ru = 'Создать уведомление о ввозе прослеживаемых товаров'"),,ЦветаСтиля.ЦветОсобогоТекста,,"ссылка");
		
	ИначеЕсли СписокУведомлений.Количество() = 1 Тогда
		
		ПредставлениеДокумента = СписокУведомлений[0].Представление;
		ПредставлениеДокумента = СтрЗаменить(ПредставлениеДокумента, " № ", " ");
		
		ПредставлениеУведомлений = Новый ФорматированнаяСтрока(ПредставлениеДокумента, , , , "ссылка");
		
	Иначе
		
		ПредставлениеДокумента = Лев(СписокУведомлений[0].Представление, СтрНайти(СписокУведомлений[0].Представление, "№")-2);
		
		ПредставлениеКоличества = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '(%1 %2)'"),
				СписокУведомлений.Количество(),
				СтрокаСЧислом("; документ; ; документа; документов; документа",
					СписокУведомлений.Количество(),
					ВидЧисловогоЗначения.Количественное,
					"L=ru_RU"));
					
		ПредставлениеДокументов  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1 %2'"),
			ПредставлениеДокумента,
			ПредставлениеКоличества);
			
		ПредставлениеУведомлений = Новый ФорматированнаяСтрока(ПредставлениеДокументов,, , , "ссылка");
		
	КонецЕсли;
	
	Возврат ПредставлениеУведомлений;
	
КонецФункции

Функция ИмяТаблицыМатериалы(Ссылка)
	
	МетаданныеДокумента = Ссылка.Метаданные();
	Если МетаданныеДокумента.ТабличныеЧасти.Найти("Материалы") <> Неопределено Тогда
		Возврат "Материалы";
	ИначеЕсли МетаданныеДокумента.ТабличныеЧасти.Найти("Номенклатура") <> Неопределено Тогда
		Возврат "Номенклатура";
	ИначеЕсли МетаданныеДокумента.ТабличныеЧасти.Найти("СоставНФА") <> Неопределено Тогда
		Возврат "СоставНФА";
	ИначеЕсли МетаданныеДокумента.ТабличныеЧасти.Найти("ОсновныеСредства") <> Неопределено Тогда
		Возврат "ОсновныеСредства";
	ИначеЕсли МетаданныеДокумента.ТабличныеЧасти.Найти("УслугиОказанные") <> Неопределено Тогда
		Возврат "УслугиОказанные";
	ИначеЕсли МетаданныеДокумента.ТабличныеЧасти.Найти("СоставЭтапаРабот") <> Неопределено Тогда
		Возврат "СоставЭтапаРабот";
	Иначе
		ВызватьИсключение "Для этого документа не предусмотрен условное оформление элементов прослеживаемости";
	КонецЕсли;

КонецФункции

