
#Область ПрограммныйИнтерфейс

// ПРОЦЕДУРЫ И ФУНКЦИИ, ИСПОЛЬЗУЕМЫЕ В РАСЧЕТАХ ПО РОДИТЕЛЬСКОЙ ПЛАТЕ
// (Имена функций соответствуют именам параметров в расчетных алгоритмах)

// Календарные дни

Функция КолРабДней(Дата1, Дата2, ГрафикРаботы = Неопределено) Экспорт
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат РасчетыПоРодительскойПлатеПовтИсп.КолРабДней(Дата1, Дата2, ГрафикРаботы);
КонецФункции

Функция КолПосещений(Знач Дата1, Знач Дата2, ГрафикРаботы = Неопределено, Ребенок, Группа, РодительскаяПлатаДопУслуги = 0) Экспорт
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если РасчетыПоРодительскойПлатеПовтИсп.РебенокВыбыл(Ребенок, Дата1) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Группа) Тогда
		ИзмененияВГруппе = РасчетыПоРодительскойПлатеПовтИсп.ИзмененияВГруппе(Дата1, Дата2, Группа, РодительскаяПлатаДопУслуги);
		
		ИзмененияПоРебенку = ИзмененияВГруппе.Скопировать(Новый Структура("Ребенок", Ребенок));
		Если ИзмененияПоРебенку.Количество() = 0 Тогда
			// посещений не было, т.к. ребенка не было в группе
			Возврат 0;
		КонецЕсли;
		
		ИзмененияПоРебенку.Сортировать("Период");
		
		Если ИзмененияПоРебенку[0].Период <> Дата1
			ИЛИ НЕ ИзмененияПоРебенку[0].Актуальность Тогда
			
			// На начало месяца неактивное состояние или записи нет.
			// Получаем новое значение Дата1.
			
			Для каждого СтрокаИзменения Из ИзмененияПоРебенку Цикл
			
				Если СтрокаИзменения.Актуальность Тогда
					Дата1 = НачалоДня(СтрокаИзменения.Период);
					Прервать;
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЕсли;
		
		КоличествоСтрок = ИзмененияПоРебенку.Количество();
		Если ИзмененияПоРебенку[КоличествоСтрок - 1].Период <> КонецДня(Дата2)
			ИЛИ (НЕ ИзмененияПоРебенку[КоличествоСтрок - 1].Актуальность
			И НЕ ИзмененияПоРебенку[КоличествоСтрок - 1].ЭтоИзменениеПараметров) Тогда
			
			// На конец месяца неактивное состояние или записи нет.
			// Получаем новое значение Дата2.
			Для каждого СтрокаИзменения Из ИзмененияПоРебенку Цикл
				
				Если СтрокаИзменения.Период <= Дата1 Тогда
					Продолжить;
				КонецЕсли;
			
				Если НЕ СтрокаИзменения.Актуальность
					И НЕ СтрокаИзменения.ЭтоИзменениеПараметров Тогда
					Дата2 = СтрокаИзменения.Период - 86400;
					Прервать;
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КолРабДней(Дата1, Дата2, ГрафикРаботы) - КолНеоплНепосещений(Дата1, Дата2, Ребенок, Группа, РодительскаяПлатаДопУслуги);
КонецФункции

Функция КолНеоплНепосещений(Дата1, Дата2, Ребенок, Группа, РодительскаяПлатаДопУслуги = 0) Экспорт
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	ТабНевыходы = РасчетыПоРодительскойПлатеПовтИсп.КолНеоплНепосещений(Дата1, Дата2, РодительскаяПлатаДопУслуги);
	Невыходы = ТабНевыходы.НайтиСтроки(Новый Структура("Группа, Ребенок", Группа, Ребенок));
	
	Если Невыходы.Количество() > 0 Тогда
		Возврат Невыходы[0].Невыходы;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция КолОплНепосещений(Дата1, Дата2, Ребенок, Группа, РодительскаяПлатаДопУслуги = 0) Экспорт
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	ТабНевыходы = РасчетыПоРодительскойПлатеПовтИсп.КолОплНепосещений(Дата1, Дата2, РодительскаяПлатаДопУслуги);
	Невыходы = ТабНевыходы.НайтиСтроки(Новый Структура("Группа, Ребенок", Группа, Ребенок));
	
	Если Невыходы.Количество() > 0 Тогда
		Возврат Невыходы[0].Невыходы;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

// Ставка оплаты

Функция СтавкаОплаты(Дата1, Дата2, Ставка, РабочихДней, ДнейПосещения, Льгота) Экспорт
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат РасчетыПоРодительскойПлатеПовтИсп.СтавкаОплаты(Дата1, Дата2, Ставка, РабочихДней, ДнейПосещения, Льгота);	
Конецфункции

Функция СтавкаЗаДень(Ставка) Экспорт
	Если Ставка.ЭтоФиксированнаяСтавкаЗаПериод Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Ставка.СуммаСтавкаЗаДень;
КонецФункции

Функция ПеремСтавкаЗаМесяц(Ставка) Экспорт
	Если Ставка.ЭтоФиксированнаяСтавкаЗаПериод Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Ставка.СуммаПеременнаяСтавкаЗаМесяц;
КонецФункции

Функция ФиксСтавкаЗаМесяц(Ставка) Экспорт
	Если Ставка.ЭтоФиксированнаяСтавкаЗаПериод Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Ставка.СуммаФиксированнаяСтавкаЗаМесяц;
КонецФункции

Функция ФиксСтавкаЗаПериод(Дата1, Дата2, Ставка) Экспорт
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат РасчетыПоРодительскойПлатеПовтИсп.ФиксСтавкаЗаПериод(Дата1, Дата2, Ставка);	
КонецФункции

// Компенсация

Функция СуммаКомпенсации(Дата1, Дата2, Организация, Ребенок) Экспорт
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Не (ЗначениеЗаполнено(Организация) Или ЗначениеЗаполнено(Ребенок)) Тогда
		Возврат 0;
	КонецЕсли;
	
	ТабКомпенсации = РасчетыПоРодительскойПлатеПовтИсп.СуммаКомпенсации(Дата1, Дата2, Организация);
	СуммыКомпенсации = ТабКомпенсации.НайтиСтроки(Новый Структура("Ребенок", Ребенок));
	
	Если СуммыКомпенсации.Количество() > 0 Тогда
		Возврат СуммыКомпенсации[0].СуммаКомпенсации;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция ПроцентКомпенсации(Дата2, Ребенок) Экспорт
	Если НЕ ЗначениеЗаполнено(Ребенок) ИЛИ НЕ ЗначениеЗаполнено(Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	ПараметрыКомпенсации = РасчетыПоРодительскойПлатеПовтИсп.ПроцентКомпенсации(Дата2);
	Проценты = ПараметрыКомпенсации.НайтиСтроки(Новый Структура("Ребенок", Ребенок));
	
	ПроцентКомпенсации = 0;
	Для Каждого ТекущийПроцент Из Проценты Цикл
		
		Если Не ТекущийПроцент.ОсновнойРасчет Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекущийПроцент.Процент <> 0 Тогда
			Если ПроцентКомпенсации <> 0 Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'По ребенку %1 задано несколько ставок компенсации'"), Ребенок);
			КонецЕсли;
			ПроцентКомпенсации = ТекущийПроцент.Процент;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПроцентКомпенсации;
	
КонецФункции

Функция СтавкаКомпенсации(Дата2) Экспорт
	Возврат РасчетыПоРодительскойПлатеПовтИсп.СтавкаКомпенсации(Дата2);	
КонецФункции

// Льгота

Функция ПроцентЛьготы(Льгота) Экспорт
	Возврат Льгота.ПроцентЛьготы;
КонецФункции

// БухУчет

Функция СуммаФактическойОплаты(Дата1, Дата2, Ребенок, Договор) Экспорт
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;

	Если Не (ЗначениеЗаполнено(Ребенок) Или ЗначениеЗаполнено(Договор)) Тогда
		Возврат 0;
	КонецЕсли;
	
	РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ребенок, "Организация, Контрагент");
	
	ТабОплат = РасчетыПоРодительскойПлатеПовтИсп.ПоступлениеОплатыЗаПериод(Дата1, Дата2, РеквизитыОбъекта.Организация);
	Оплаты = ТабОплат.НайтиСтроки(Новый Структура("Контрагент, Договор", РеквизитыОбъекта.Контрагент, Договор));
	
	Если Оплаты.Количество() > 0 Тогда
		Возврат Оплаты[0].Оплачено;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция СуммаФактическогоНачисления(Дата1, Дата2, Ребенок, Договор) Экспорт
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;

	Если Не (ЗначениеЗаполнено(Ребенок) Или ЗначениеЗаполнено(Договор)) Тогда
		Возврат 0;
	КонецЕсли;
	
	РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ребенок, "Организация, Контрагент");
	
	ТабНачислений = РасчетыПоРодительскойПлатеПовтИсп.НачислениеПлатыЗаПериод(Дата1, Дата2, РеквизитыОбъекта.Организация);
	Начисления = ТабНачислений.НайтиСтроки(Новый Структура("Контрагент, Договор", РеквизитыОбъекта.Контрагент, Договор));
	
	Если Начисления.Количество() > 0 Тогда
		Возврат Начисления[0].Начислено;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция СостояниеРасчетов(Дата1, Ребенок, Договор, ЭтоДатаОстатков = Ложь) Экспорт
	Если Не ЭтоДатаОстатков Тогда
		Возврат 0;
	КонецЕсли;
	
	Если НЕ (ЗначениеЗаполнено(Дата1) Или ЗначениеЗаполнено(Ребенок) Или ЗначениеЗаполнено(Договор)) Тогда
		Возврат 0;
	КонецЕсли;
	
	РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ребенок, "Организация, Контрагент");
	
	ТабОстатков = РасчетыПоРодительскойПлатеПовтИсп.ТаблицаОстатков(Дата1, РеквизитыОбъекта.Организация);

	Остатки = ТабОстатков.НайтиСтроки(Новый Структура("Контрагент, Договор", РеквизитыОбъекта.Контрагент, Договор));
	
	Если Остатки.Количество() > 0 Тогда
		Возврат Остатки[0].Задолженность;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции


#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ПолучитьНастройкуРасчета() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	НастройкиРасчетовПоРодительскойПлате.Ссылка,
	              |	НастройкиРасчетовПоРодительскойПлате.ПоУмолчанию
	              |ИЗ
	              |	Справочник.НастройкиРасчетовПоРодительскойПлате КАК НастройкиРасчетовПоРодительскойПлате
				  |ГДЕ
				  |	НастройкиРасчетовПоРодительскойПлате.ПоУмолчанию
				  |	И НЕ НастройкиРасчетовПоРодительскойПлате.ПометкаУдаления";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	Иначе
		Возврат Справочники.НастройкиРасчетовПоРодительскойПлате.ПустаяСсылка();
	КонецЕсли;
КонецФункции

Функция ФункцияКакПараметр(ИмяФункции) Экспорт
	Если Прав(ИмяФункции, 2) = "()" Тогда
		ИмяФункции = Лев(ИмяФункции, СтрДлина(ИмяФункции) - 2);
	КонецЕсли;
	
	Структура = Новый Структура;
	Структура.Вставить("ИмяФункции", ИмяФункции);
	
	Макет = Справочники.НастройкиРасчетовПоРодительскойПлате.ПолучитьМакет("ПредопределенныеОперанды");
	Строка = Макет.НайтиТекст(ИмяФункции, , Макет.Область("C2"), Ложь, Истина).Верх;
	
	Для К = 1 По 6 Цикл
		Структура.Вставить("Параметр"+К, Макет.Область("R"+Строка+"C"+(К+5)).Текст);
	КонецЦикла;
	
	Возврат Структура;
КонецФункции

Функция ЗаполнитьИРассчитатьТабличнуюЧасть(Объект, НомерСтроки, АдресаСхемыЗаполнения = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Объект.НастройкаРасчета) Тогда
		НастройкаРасчета = РасчетыПоРодительскойПлате.ПолучитьНастройкуРасчета();
		
		Если Не ЗначениеЗаполнено(НастройкаРасчета) Тогда
			ТекстСообщения = НСтр("ru='Не выбрана настройка расчета!
										|Выберите настройку в форме документа или определите настройку по умолчанию!'");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
			Возврат (Новый ТаблицаЗначений);
		КонецЕсли;
	Иначе
		НастройкаРасчета = Объект.НастройкаРасчета;
	КонецЕсли;
	
	Если НастройкаРасчета.Настройки.Количество() > 0 Тогда
		Схема = НастройкаРасчета.Настройки[НомерСтроки].Схема.Получить();
	Иначе
		Схема = Неопределено;
	КонецЕсли;
	
	Если Схема = Неопределено Тогда
		ТекстСообщения = НСтр("ru='Не определен алгоритм расчета! Проверьте настройки расчета!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;

	Если НомерСтроки = 2 Тогда
		Возврат ВычислитьКомпенсацию(Схема, НастройкаРасчета, Объект, НомерСтроки, АдресаСхемыЗаполнения);
	Иначе
		Возврат ВычислитьПоСхемеКомпоновки(Схема, Объект, НомерСтроки, АдресаСхемыЗаполнения);
	КонецЕсли;
	
КонецФункции

Функция СоздатьТиповыеНастройкиРасчетов(Ссылка) Экспорт
	Результат = Ложь;
	
	ПроверитьЕстьНастройкаРасчетаКомпенсации();
	
	Справочники.НастройкиРасчетовПоРодительскойПлате.СоздатьНастройкуПоУмолчанию(Ссылка);
	
	Если Ссылка <> Неопределено Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ПлатаПоСтавке(Дата1, Дата2, ГруппаДетскогоУчреждения, Ставка, ПроцентЛьготы = 0) Экспорт
	Если Не ЗначениеЗаполнено(Дата1) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ставка) Тогда
		Возврат 0;
	КонецЕсли;
	
	КалендарныйГрафикГруппы = Неопределено;
	Если ЗначениеЗаполнено(ГруппаДетскогоУчреждения) Тогда
		КалендарныйГрафикГруппы = РасчетыПоРодительскойПлате.ПолучитьКалендарныйГрафикГруппы(ГруппаДетскогоУчреждения, Дата1);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КалендарныйГрафикГруппы) Тогда
		ГрафикРаботы = КалендарныйГрафикГруппы;
	Иначе
		ГрафикРаботы = Справочники.ПроизводственныеКалендари.НайтиПоКоду("РФ");
	КонецЕсли;
	
	ПлатаПоСтавке = РасчетыПоРодительскойПлатеПовтИсп.ПлатаПоСтавке(НачалоМесяца(Дата1), КонецМесяца(Дата2), ГрафикРаботы, Ставка);
	
	Возврат ПлатаПоСтавке * (100 - ПроцентЛьготы) / 100;
КонецФункции

Функция ДетоДни(ТабЗначений) Экспорт
	Возврат ТабЗначений.Итог("ДнейПосещения");
КонецФункции

Функция ПолучитьКалендарныйГрафикГруппы(ГруппаДетскогоУчреждения, НаДату = Неопределено) Экспорт
	
	КалендарныйГрафик = РасчетыПоРодительскойПлатеПовтИсп.ПолучитьКалендарныйГрафикГруппы(ГруппаДетскогоУчреждения, НаДату);
	
	Возврат КалендарныйГрафик;
	
КонецФункции

// ФУНКЦИИ, ИСПОЛЬЗУЕМЫЕ В ОТЧЕТАХ ПО РОДИТЕЛЬСКОЙ ПЛАТЕ
Функция ВоспитательГруппы(ГруппаДетскогоУчреждения = Неопределено) Экспорт
	Если ГруппаДетскогоУчреждения = Неопределено Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ГруппаДетскогоУчреждения.Воспитатель;
КонецФункции

Функция ГрафикРаботыГруппы(ГруппаДетскогоУчреждения = Неопределено) Экспорт
	
	НаименованиеГрафика = "";
	
	Если ГруппаДетскогоУчреждения <> Неопределено Тогда
		КалендарныйГрафикГруппы = ПолучитьКалендарныйГрафикГруппы(ГруппаДетскогоУчреждения);
		Если ЗначениеЗаполнено(КалендарныйГрафикГруппы) Тогда
			НаименованиеГрафика = КалендарныйГрафикГруппы.Наименование;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат НаименованиеГрафика;
	
КонецФункции

Функция СимволДня(Организация = Неопределено, НомерДня, Период, ГрафикРаботы) Экспорт
	Если НомерДня > День(КонецМесяца(Период)) Тогда
		Возврат "X";
	ИначеЕсли РасчетыПоРодительскойПлатеПовтИсп.МассивРабочихДней(Период, ГрафикРаботы).Найти(НомерДня, "РабочиеДни") = Неопределено Тогда
		Возврат "В";
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

Функция ПредставлениеЛьготы(Льгота) Экспорт
	Возврат РасчетыПоРодительскойПлатеПовтИсп.ПредставлениеЛьготы(Льгота);
КонецФункции

Функция КоличествоДнейПосещенийВПериоде(Ребенок, ГруппаДетскогоУчреждения, НачалоПериода, КонецПериода, РодительскаяПлатаДопУслуги) Экспорт
	
	ГрафикРаботы = ПолучитьКалендарныйГрафикГруппы(ГруппаДетскогоУчреждения, НачалоПериода);
	
	Возврат КолРабДней(НачалоПериода, КонецПериода, ГрафикРаботы) - КолНеоплНепосещений(НачалоПериода, КонецПериода, Ребенок, ГруппаДетскогоУчреждения, РодительскаяПлатаДопУслуги);
	
КонецФункции

Функция ДатыОплатСтрокой(ДатыОплатТаблица) Экспорт
	Результат = "";
	
	Если ТипЗнч(ДатыОплатТаблица) = Тип("ТаблицаЗначений") И ДатыОплатТаблица.Количество() > 0 Тогда
		ДатыОплатТаблица.Сортировать("Колонка1 ВОЗР");
		
		МассивДат = Новый Массив;
		
		Для Каждого Стр Из ДатыОплатТаблица Цикл
			Если МассивДат.Найти(Стр.Колонка1) = Неопределено Тогда
				МассивДат.Добавить(Стр.Колонка1);
				
				Если МассивДат.Количество() = 2 Тогда
					МассивДат.Добавить("...");
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Результат = СтрСоединить(МассивДат, "; ");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции


#Область УстаревшиеПроцедурыИФункции

// Устарела. Для получения предопределенных элементов формул см. Справочники.НастройкиРасчетовПоРодительскойПлате.ПредопределенныеОперандыФормулРасчета
Функция ПолучитьСписокЭлементовРасчетов() Экспорт
	Дерево = Новый ДеревоЗначений;
	
	Макет = Справочники.НастройкиРасчетовПородительскойПлате.ПолучитьМакет("ПредопределенныеОперанды");
	
	Для К = 1 По Макет.ШиринаТаблицы - 1 Цикл
		Дерево.Колонки.Добавить(Макет.Область("R1C"+К).Текст, , Макет.Область("R1C"+К).Текст);
	КонецЦикла;
	
	МассивОперанда = Новый Массив;
	
	Для К = 2 По Макет.ВысотаТаблицы Цикл
		МассивОперанда.Очистить();
		
		Родитель = Макет.Область("R"+К+"C"+12).Текст;
		
		Если СокрЛП(Родитель) <> "" Тогда
			Стр = Дерево.Строки.Найти(Родитель, "ИмяДляФормулы");
				
			Если Стр <> Неопределено Тогда
				Стр1 = Стр.Строки.Добавить();
			КонецЕсли;
		Иначе
			Стр1 = Дерево.Строки.Добавить();
		КонецЕсли;
		
		Для Н = 1 По Макет.ШиринаТаблицы - 1 Цикл
			МассивОперанда.Добавить(Макет.Область("R"+К+"C"+Н).Текст);
		КонецЦикла;
		
		ЗаполнитьСтрокуДерева(Стр1, МассивОперанда);
	КонецЦикла;
	
	Возврат Дерево;
КонецФункции

#КонецОбласти


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДатыЗаполненыКорректно(Дата1, Дата2)

	Возврат ЗначениеЗаполнено(Дата1)
		И ЗначениеЗаполнено(Дата2)
		И Дата2 >= Дата1;
	
КонецФункции

Функция ВычислитьКомпенсацию(СхемаКомпоновки, НастройкаРасчета, Объект, НомерСтроки, АдресаСхемыЗаполнения = Неопределено)
	
	ФормулыБазы = Новый Массив;
	ФормулыКомпенсации = Новый Массив;
	ИспользуемыеПараметры = Новый Структура;
	НомерПараметра = 0;
	
	Для Каждого НастройкаКомпенсации Из Справочники.НастройкиРасчетовПоРодительскойПлате.ФормулыНастроекКомпенсации() Цикл
		
		НомерПараметра = НомерПараметра + 1;
		ИмяПараметра = "НастройкаКомпенсации" + НомерПараметра;
		ИспользуемыеПараметры.Вставить(ИмяПараметра, НастройкаКомпенсации.Ссылка);
		
		СхемаДоп = НастройкаКомпенсации.Схема.Получить();
		ДобавитьВыражение(СхемаДоп.ВычисляемыеПоля.Найти("Сумма"), ИмяПараметра, ФормулыБазы);
		ДобавитьВыражение(СхемаДоп.ВычисляемыеПоля.Найти("СуммаКомпенсации"), ИмяПараметра, ФормулыКомпенсации);
		
		НовыйПараметр = СхемаКомпоновки.Параметры.Добавить();
		НовыйПараметр.Имя = ИмяПараметра;
		НовыйПараметр.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.НастройкиРасчетовПоРодительскойПлате");
		
	КонецЦикла;
		
	ВставитьОбработанноеВыражениеСКДКомпенсации(СхемаКомпоновки.ВычисляемыеПоля.Найти("Сумма"),            ФормулыБазы);
	ВставитьОбработанноеВыражениеСКДКомпенсации(СхемаКомпоновки.ВычисляемыеПоля.Найти("СуммаКомпенсации"), ФормулыКомпенсации);

	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки);
	
	НастройкиСхемы = Новый КомпоновщикНастроекКомпоновкиДанных;	
	НастройкиСхемы.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
	НастройкиСхемы.Инициализировать(ИсточникНастроек);

	Настройки = НастройкиСхемы.Настройки;
	
	ЗаполнитьПараметрыПоДокументу(Настройки, Объект, НомерСтроки);
	УстановитьПараметрРасчет(Настройки, НомерСтроки);
	ЗаполнитьОтбор(Настройки, НомерСтроки, Объект);
	УстановитьДополнительныеНастройки(Настройки, АдресаСхемыЗаполнения);

	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НастройкаПоУмолчанию", НастройкаРасчета);
	Для Каждого Параметр Из ИспользуемыеПараметры Цикл
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
		
	
	Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = Компоновщик.Выполнить(СхемаКомпоновки, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет,,,Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьВыражение(Поле, ИмяПараметра, Формулы)
	ШаблонУсловия = "КОГДА НастройкаКомпенсации = &%1 ТОГДА (%2)";
	Выражение = ?(Поле = Неопределено, "0", Поле.Выражение);
	Формулы.Добавить(СтрШаблон(ШаблонУсловия, ИмяПараметра, Выражение));
КонецПроцедуры

Процедура ВставитьОбработанноеВыражениеСКДКомпенсации(Поле, Формулы)
	Поле.Выражение = СтрШаблон("ВЫРАЗИТЬ(%1, ""ЧИСЛО(18,2)"")",
		"ВЫБОР" + Символы.ПС + СтрСоединить(Формулы, Символы.ПС) + Символы.ПС + "КОНЕЦ");
КонецПроцедуры


Функция ВычислитьПоСхемеКомпоновки(Схема, Объект, НомерСтроки, АдресаСхемыЗаполнения = Неопределено)
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема);
	
	НастройкиСхемы = Новый КомпоновщикНастроекКомпоновкиДанных;	
	НастройкиСхемы.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	НастройкиСхемы.Инициализировать(ИсточникНастроек);

	Настройки = НастройкиСхемы.Настройки;
	
	ЗаполнитьПараметрыПоДокументу(Настройки, Объект, НомерСтроки);
	УстановитьПараметрРасчет(Настройки, НомерСтроки);
	ЗаполнитьОтбор(Настройки, НомерСтроки, Объект);
	УстановитьДополнительныеНастройки(Настройки, АдресаСхемыЗаполнения);
	
	Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = Компоновщик.Выполнить(Схема, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет,,,Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьПараметрыПоДокументу(Настройки, Объект, НомерСтроки)
	
	МДДокумента = Объект.Ссылка.Метаданные();
	
	Для Каждого Параметр Из Настройки.ПараметрыДанных.Элементы Цикл
		НаименованиеПараметра = Строка(Параметр.Параметр);
		
		Если НаименованиеПараметра = "Период" Тогда
			Параметр.Значение = Новый СтандартныйПериод(НачалоДня(Объект.НачалоПериода), КонецДня(Объект.КонецПериода));
			Параметр.Использование = Истина;
		ИначеЕсли НаименованиеПараметра = "РодительскаяПлатаДопУслуги" И НомерСтроки = 2 Тогда
			Параметр.Использование = Истина;
		Иначе
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта(НаименованиеПараметра, МДДокумента) Тогда
				Параметр.Значение = Объект[НаименованиеПараметра];
				Параметр.Использование = ?(НаименованиеПараметра = "РодительскаяПлатаДопУслуги", Истина, ЗначениеЗаполнено(Объект[НаименованиеПараметра]));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОтбор(Настройки, НомерСтроки, Объект)
	
	МДДокумента = Объект.Ссылка.Метаданные();
	
	Для Каждого Отбор Из Настройки.Отбор.Элементы Цикл
		НаименованиеОтбора = Строка(Отбор.ЛевоеЗначение);
		
		Если НаименованиеОтбора = "ПроцентКомпенсации" И НомерСтроки = 2 Тогда
			НовыйОтбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			НовыйОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СуммаКомпенсации");
			НовыйОтбор.ПравоеЗначение = 0;
			НовыйОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
			НовыйОтбор.Использование = Истина;
		ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта(НаименованиеОтбора, МДДокумента) Тогда
			Отбор.ПравоеЗначение = Объект[НаименованиеОтбора];
			Отбор.Использование = ЗначениеЗаполнено(Объект[НаименованиеОтбора]);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьДополнительныеНастройки(Настройки, АдресаСхемыЗаполнения)
	Если АдресаСхемыЗаполнения <> Неопределено Тогда
		ДополнительныеНастройки = ПолучитьИзВременногоХранилища(АдресаСхемыЗаполнения.НастройкиКомпоновкиДанных);
		ОбщийМодульСКД.СкопироватьОтборНастроекКомпоновкиДанных(Настройки.Отбор, ДополнительныеНастройки.Отбор);
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьПараметрРасчет(Настройки, НомерСтроки)
	
	Расчет = Настройки.ПараметрыДанных.Элементы.Найти("Расчет");
	Если Расчет <> Неопределено Тогда
		Расчет.Значение = НомерСтроки;
		Расчет.Использование = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуДерева(Стр, МассивОперанда)
	Н = 0;
	
	Для Каждого Элем Из МассивОперанда Цикл
		Стр[Н] = Элем;
		Н = Н + 1;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьЕстьНастройкаРасчетаКомпенсации()
	Если ВидСтавкиУстановлен()
		И ЗначениеЗаполнено(Константы.СпособРасчетаКомпенсацииРодительскойПлаты.Получить()) Тогда
		
		Возврат;
	КонецЕсли;
	
	Константы.СпособРасчетаКомпенсацииРодительскойПлаты.Установить(Перечисления.СпособыРасчетаКомпенсацииРП.ПоСреднемесячной);
КонецПроцедуры

Функция ВидСтавкиУстановлен()
	Результат = Ложь;
	
	ИсторияСтавки = РегистрыСведений.СтавкаКомпенсацииРодительскойПлаты.Выбрать( , ТекущаяДатаСеанса(), , "Убыв");
	
	Если ИсторияСтавки.Следующий() Тогда
		Ставка = ИсторияСтавки.ПолучитьМенеджерЗаписи();
		
		Если Не ЗначениеЗаполнено(Ставка.ВидСтавки) Тогда
			Ставка.ВидСтавки = Перечисления.ВидыСтавкиКомпенсацииРодительскойПлаты.Месячная;
			Ставка.Записать();
		КонецЕсли;
	Иначе
		НЗ = РегистрыСведений.СтавкаКомпенсацииРодительскойПлаты.СоздатьНаборЗаписей();
		
		Ставка = НЗ.Добавить();
		Ставка.Период = НачалоМесяца(ТекущаяДатаСеанса());
		Ставка.ВидСтавки = Перечисления.ВидыСтавкиКомпенсацииРодительскойПлаты.Месячная;
		
		НЗ.Записать();
	КонецЕсли;
	
	Результат = Истина;
	
	Возврат Результат;
КонецФункции

#КонецОбласти
