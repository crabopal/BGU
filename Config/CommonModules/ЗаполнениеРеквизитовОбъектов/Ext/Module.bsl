#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьРеквизитыДокументовПоУмолчаниюОбработкаЗаполнения(Источник, ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	ЗаполнитьРеквизитыОбъектовПоУмолчанию(Источник, ДанныеЗаполнения, СтандартнаяОбработка);
КонецПроцедуры

Процедура ЗаполнитьРеквизитыОбъектовПоУмолчаниюОбработкаЗаполнения(Источник, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	ЗаполнитьРеквизитыОбъектовПоУмолчанию(Источник, ДанныеЗаполнения, СтандартнаяОбработка);
КонецПроцедуры

// Процедура заполняет структуру настроек пользователя
//
// Параметры
// Пользователь - СправочникСсылка.Пользователи или СправочникСсылка.ВнешниеПользователи
// ЗначенияНастроек - Структура. Если ЗначениеНастроек = Неопределено ,то создается.
//						Если структура пустая, то получаются все настройки, если ключи заданы,
//						то получаются только значения нужных настроек.
//						Названия ключей задаются такие же как имена элементов ПВХ Персональные настройки
//
Процедура ПолучитьЗначенияНастроекПользователя(Пользователь, ЗначенияНастроек) Экспорт
	Если ЗначенияНастроек = Неопределено Тогда
		ЗначенияНастроек=Новый Структура;
	КонецЕсли;
	
	ПолучитьВсеНастройки = ЗначенияНастроек.Количество()=0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПерсональныеНастройки.Ссылка КАК Настройка,
	               |	ЗначенияНастроек.ЗначениеНастройки
	               |ИЗ
	               |	ПланВидовХарактеристик.ПерсональныеНастройки КАК ПерсональныеНастройки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПерсональныеНастройки КАК ЗначенияНастроек
	               |		ПО ЗначенияНастроек.Настройка = ПерсональныеНастройки.Ссылка
	               |			И (ЗначенияНастроек.Пользователь = &Пользователь)
	               |ГДЕ
	               |	(НЕ ПерсональныеНастройки.ЭтоГруппа)";
	Если ПолучитьВсеНастройки Тогда
		ЗначенияНастроек.Вставить("ОсновнаяОрганизация");	
		ЗначенияНастроек.Вставить("ОсновноеПодразделение");	
		ЗначенияНастроек.Вставить("ОсновнойИФО");
		ЗначенияНастроек.Вставить("РабочаяДата");
	Иначе
		Запрос.Текст = Запрос.Текст +"
					|	И ПерсональныеНастройки.Ссылка В(&СписокНастроек)";
		СписокНастроек = Новый СписокЗначений;
		Если ЗначенияНастроек.Свойство("ОсновнаяОрганизация") Тогда
			СписокНастроек.Добавить(ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновнаяОрганизация);
		КонецЕсли;
		Если ЗначенияНастроек.Свойство("ОсновноеПодразделение") Тогда
			СписокНастроек.Добавить(ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновноеПодразделение);
		КонецЕсли;
		Если ЗначенияНастроек.Свойство("ОсновнойИФО") Тогда
			СписокНастроек.Добавить(ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновнойИФО);
		КонецЕсли;
	    Если ЗначенияНастроек.Свойство("РабочаяДата") Тогда
			СписокНастроек.Добавить(ПланыВидовХарактеристик.ПерсональныеНастройки.РабочаяДата);
		КонецЕсли;

		Запрос.УстановитьПараметр("СписокНастроек", СписокНастроек);
	КонецЕсли;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);		
	
	Выборка = Запрос.Выполнить().Выгрузить();
	Если ЗначенияНастроек.Свойство("ОсновнаяОрганизация") Тогда
		ТекСтрока = Выборка.Найти(ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновнаяОрганизация,"Настройка");
		Если ТекСтрока <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(ТекСтрока.ЗначениеНастройки) или ТекСтрока.ЗначениеНастройки = NULL Тогда
				ЗначенияНастроек.ОсновнаяОрганизация = Справочники.Организации.ПустаяСсылка();	
			Иначе
				ЗначенияНастроек.ОсновнаяОрганизация = ТекСтрока.ЗначениеНастройки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ЗначенияНастроек.Свойство("ОсновноеПодразделение") Тогда
		ТекСтрока = Выборка.Найти(ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновноеПодразделение,"Настройка");
		Если ТекСтрока <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(ТекСтрока.ЗначениеНастройки) или ТекСтрока.ЗначениеНастройки = NULL Тогда
				ЗначенияНастроек.ОсновноеПодразделение = Справочники.Подразделения.ПустаяСсылка();
			Иначе
				ЗначенияНастроек.ОсновноеПодразделение = ТекСтрока.ЗначениеНастройки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ЗначенияНастроек.Свойство("ОсновнойИФО") Тогда
		ТекСтрока = Выборка.Найти(ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновнойИФО,"Настройка");
		Если ТекСтрока <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(ТекСтрока.ЗначениеНастройки) или ТекСтрока.ЗначениеНастройки = NULL Тогда
				ЗначенияНастроек.ОсновнойИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
			Иначе
				ЗначенияНастроек.ОсновнойИФО = ТекСтрока.ЗначениеНастройки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ЗначенияНастроек.Свойство("РабочаяДата") Тогда
		ТекСтрока = Выборка.Найти(ПланыВидовХарактеристик.ПерсональныеНастройки.РабочаяДата,"Настройка");
		Если ТекСтрока <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(ТекСтрока.ЗначениеНастройки) или ТекСтрока.ЗначениеНастройки = NULL Тогда
				ЗначенияНастроек.РабочаяДата = '0001-01-01';
			Иначе
				ЗначенияНастроек.РабочаяДата = ТекСтрока.ЗначениеНастройки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Функция получает организацию по умолчанию для текущего пользователя.
// Информация берется из параметра сеанса - ТекущаяОрганизация. При иницализации параметра сеанса
// параметр ИнициализацияПараметраСеанса должен быть ИСТИНА, чтобы не возникало исключения.
//
// Если параметр ИнициализацияПараметраСеанса = ЛОЖЬ тогда информация берется из настроек пользователя. 
// Если там не задана, то возвращается первая из разрешенных пользователю
//
// Параметры
// ТекущийПользователь - СправочникСсылка.Пользователи, СправочникСсылка.ВнешниеПользователи. Если не задан, то
//						берется текущий пользователь.
// ОсновнаяОрганизацияПользователя - СправочникСсылка.Организации - Если задана, то проверяется на заполненность.
//						Если не пустая, то возвращается эта ссылка.
// ИнициализацияПараметраСеанса - Булево - вызывается при иницаилизации параметра сеанса.
//
// Возвращаемое значение
// СправочникСсылка.Организации
//
Функция ОрганизацияПоУмолчанию(ТекущийПользователь = Неопределено, ОсновнаяОрганизацияПользователя = Неопределено, ИнициализацияПараметраСеанса = Ложь) Экспорт
	
	Если НЕ ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		Возврат Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	Если ТекущийПользователь = Неопределено Тогда
		ТекущийПользователь = Пользователи.АвторизованныйПользователь();
	КонецЕсли;
	
	ОсновнаяОрганизация = Справочники.Организации.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Если НЕ УправлениеДоступом.ОграничиватьДоступНаУровнеЗаписей() 
		ИЛИ Пользователи.ЭтоПолноправныйПользователь(ТекущийПользователь,, Ложь) Тогда

		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка
		|ПОМЕСТИТЬ РазрешенныеОрганизации
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ПометкаУдаления = ЛОЖЬ";
		
	Иначе 
		
		ДоступныеОрганизации = УправлениеДоступом.РазрешенныеЗначенияДляДинамическогоСписка("Справочник.Организации", Тип("СправочникСсылка.Организации"));
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка
		|ПОМЕСТИТЬ РазрешенныеОрганизации
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ПометкаУдаления = ЛОЖЬ
		|	И Организации.Ссылка В (&ДоступныеОрганизации)";
				
		Запрос.УстановитьПараметр("ДоступныеОрганизации", ?(ДоступныеОрганизации = Неопределено, Новый Массив, ДоступныеОрганизации));

	КонецЕсли;
	
	Запрос.Выполнить();
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РазрешенныеОрганизации.Ссылка
		|ИЗ
		|	РазрешенныеОрганизации КАК РазрешенныеОрганизации";

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 И Выборка.Следующий() Тогда
		
		ОсновнаяОрганизация = Выборка.Ссылка;
		
	ИначеЕсли НЕ СтандартныеПодсистемыСервер.ЭтоБазоваяВерсияКонфигурации() Тогда
		
		ОрганизацияИзХранилищаОбщихНастроек = ХранилищеОбщихНастроек.Загрузить("ТЕКУЩАЯОРГАНИЗАЦИЯ");
		
		Если Не ИнициализацияПараметраСеанса И ЗначениеЗаполнено(ОрганизацияИзХранилищаОбщихНастроек) Тогда
			
			Запрос.Текст =
			"ВЫБРАТЬ
			|	МАКСИМУМ(РазрешенныеОрганизации.Ссылка) КАК Организация
			|ИЗ
			|	РазрешенныеОрганизации КАК РазрешенныеОрганизации
			|ГДЕ
			|	РазрешенныеОрганизации.Ссылка = &ОрганизацияИзХранилищаОбщихНастроек";
			
			Запрос.УстановитьПараметр("ОрганизацияИзХранилищаОбщихНастроек", ОрганизацияИзХранилищаОбщихНастроек);
			
			Результат = Запрос.Выполнить();
			
			Если НЕ Результат.Пустой() Тогда
				
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				
				Если ЗначениеЗаполнено(Выборка.Организация) Тогда
					ОсновнаяОрганизация = Выборка.Организация;
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	РазрешенныеОрганизации.Ссылка КАК ОрганизацияКонстанты,
			|	NULL КАК ОрганизацияНастройки,
			|	NULL КАК Организация
			|ПОМЕСТИТЬ вт
			|ИЗ
			|	РазрешенныеОрганизации КАК РазрешенныеОрганизации,
			|	Константа.ОсновнаяОрганизация КАК ОсновнаяОрганизация
			|ГДЕ
			|	РазрешенныеОрганизации.Ссылка = ОсновнаяОрганизация.Значение
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	NULL,
			|	РазрешенныеОрганизации.Ссылка,
			|	NULL
			|ИЗ
			|	РазрешенныеОрганизации КАК РазрешенныеОрганизации,
			|	РегистрСведений.ПерсональныеНастройки КАК ПерсональныеНастройки
			|ГДЕ
			|	ПерсональныеНастройки.Пользователь = &Пользователь
			|	И ПерсональныеНастройки.Настройка = &Настройка
			|	И РазрешенныеОрганизации.Ссылка = ПерсональныеНастройки.ЗначениеНастройки
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	NULL,
			|	NULL,
			|	РазрешенныеОрганизации.Ссылка
			|ИЗ
			|	РазрешенныеОрганизации КАК РазрешенныеОрганизации
			|ГДЕ
			|	РазрешенныеОрганизации.Ссылка = &ОрганизацияИзХранилищаОбщихНастроек
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МАКСИМУМ(вт.ОрганизацияКонстанты) КАК ОрганизацияКонстанты,
			|	МАКСИМУМ(вт.ОрганизацияНастройки) КАК ОрганизацияНастройки,
			|	МАКСИМУМ(вт.Организация) КАК Организация
			|ИЗ
			|	вт КАК вт";
			
			Запрос.УстановитьПараметр("Пользователь", ТекущийПользователь);
			Запрос.УстановитьПараметр("Настройка", ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновнаяОрганизация);
			Запрос.УстановитьПараметр("ОрганизацияИзХранилищаОбщихНастроек", ОрганизацияИзХранилищаОбщихНастроек);
			
			Результат = Запрос.Выполнить();
			
			Если НЕ Результат.Пустой() Тогда
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				Если ЗначениеЗаполнено(Выборка.ОрганизацияНастройки) Тогда
					ОсновнаяОрганизация = Выборка.ОрганизацияНастройки;
				ИначеЕсли ЗначениеЗаполнено(Выборка.ОрганизацияКонстанты) Тогда
					ОсновнаяОрганизация = Выборка.ОрганизацияКонстанты;
				ИначеЕсли ЗначениеЗаполнено(Выборка.Организация) Тогда
					ОсновнаяОрганизация = Выборка.Организация;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОсновнаяОрганизация;
	
КонецФункции

// Устарела. Следует использовать ОбщегоНазначенияБГУ.УстановитьОтборСпискаПоОрганизации().
// Устанавливает отбор по основной организации. Определяется основная организация для текущего пользоваля
// Найденная основная организация устанавливается в реквизит "ОтборОрганизация". Далее устанавливается отбор
// списка формы "Список" по имени поля "ИмяПоля".
// Если в параметрах формы был передан отбор по этому же полю, то отбор списка не меняется.
//
// Вызов процедуры следует вставлять в процедуру ПриСозданииНаСервере формы списка, имеющей поле быстрого отбора по организации.
// Если в форме списка при установке отбора необходимо выполнять какие либо действия, то они должны быть отработаны
// после установки отбора, либо получать организацию функцией "ОрганизацияПоУмолчанию" и устанавливать отбор
// в самой форме.
//
// Параметры
// Список - ДинамическийСписок
// ОтборОрганизация - Реквизит формы с типом значения СправочникСсылка.Организации
// ИмяПоля - Строка - Имя поля динамического списка, по которому устанавливается отбор.
// Форма - УправляемаяФорма - форма, для реквизита которой устанавливается отбор.
// 
Процедура УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация, ИмяПоля = "Организация", Форма = Неопределено) Экспорт
	
	ОтборОсновнойОрганизации = Неопределено;
	
	Если Форма<>Неопределено Тогда
		Если ТипЗнч(Форма)=Тип("ФормаКлиентскогоПриложения") Тогда
			
			Если Форма.Параметры.Отбор.Свойство(ИмяПоля) Тогда
				// отбор, который передался в форму, не меняем
				ОтборОсновнойОрганизации = Форма.Параметры.Отбор[ИмяПоля];
			ИначеЕсли Форма.Параметры.Свойство(ИмяПоля) Тогда	
				ОтборОсновнойОрганизации = Форма.Параметры[ИмяПоля];
			КонецЕсли;
			
			//Форма может быть открыта по команде "Найти в списке"
			Если Форма.Параметры.Свойство("ТекущаяСтрока") И ЗначениеЗаполнено(Форма.Параметры.ТекущаяСтрока) Тогда
				ОтборОсновнойОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.Параметры.ТекущаяСтрока, ИмяПоля); 	
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ОтборОсновнойОрганизации = Неопределено Тогда
		ОтборОрганизация = ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	Иначе
		ОтборОрганизация = ОтборОсновнойОрганизации;
	КонецЕсли;	
	
	Представление = НСтр("ru = 'Отбор по основной организации (%1)'");
	Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Представление, Строка(ОтборОрганизация));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, ИмяПоля, ОтборОрганизация, ,Представление, ЗначениеЗаполнено(ОтборОрганизация));

КонецПроцедуры

Процедура ЗаполнитьДатуПриКопировании(Объект, ОбъектКопирования) Экспорт
	
	ТекущийПользователь = ПользователиКлиентСервер.АвторизованныйПользователь();
	
	ЗначенияНастроек = Новый Структура("РабочаяДата");
	ПолучитьЗначенияНастроекПользователя(ТекущийПользователь, ЗначенияНастроек);
	
	Если ЗначениеЗаполнено(ЗначенияНастроек.РабочаяДата) Тогда
		Объект.Дата = ЗначенияНастроек.РабочаяДата;
	Конецесли;	
	
КонецПроцедуры

Процедура ЗаполнитьОтветственногоПриКопировании(Объект, ОбъектКопирования) Экспорт
	
	ПолноеИмя = Объект.Ссылка.Метаданные().ПолноеИмя();
	ЧастиИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПолноеИмя, ".");
	Если ЧастиИмени[0] = "Документ" Тогда
		Тип = "Документы";
	ИначеЕсли ЧастиИмени[0] = "Справочник" Тогда
		Тип = "Справочники";
	Иначе
		Тип = ЧастиИмени[0];
	КонецЕсли;
	Вид = ЧастиИмени[1];
	
	// Заполнение ответственного
	Если СуществуетРеквизитШапки(Тип, Вид, "Ответственный")  И
		РеквизитШапкиИспользуется(Тип, Вид, "Ответственный", Объект) И
		ТипЗнч(Объект.Ответственный) = Тип("СправочникСсылка.Пользователи") Тогда
				
		Объект.Ответственный = ПользователиКлиентСервер.АвторизованныйПользователь();
		
	КонецЕсли;
	
	//Для документов установим Ответственного исполнителя (сотрудника)
	Если Тип = "Документы" И 
		СуществуетРеквизитШапки(Тип, Вид, "Ответственный") И
		СуществуетРеквизитШапки(Тип, Вид, "Организация") И 
		СуществуетРеквизитШапки(Тип, Вид, "ОтветственныйИсполнитель") Тогда
				
		Объект.ОтветственныйИсполнитель = ПолучитьОтветственногоИсполнителя(Объект.Ответственный, Объект.Организация, ПолноеИмя);
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОчиститьИФОПодразделениеПриОтключеннойОпцииПриКопировании(Объект, ОбъектКопирования = Неопределено) Экспорт
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	Если Не ИспользоватьУчетПоИФО И ЗначениеЗаполнено(Объект.ИФО) Тогда
		Объект.ИФО = ПредопределенноеЗначение("Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка");
	КонецЕсли;
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Если Не ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Объект.Подразделение = ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

// Функция - Получить классификатор
//
// Параметры:
//  ИмяМакета	 - строка, имя общего макета, содержащего классификатор	 - 
// Возвращаемое значение:
//   - фиксированное соответствие, код и наименование по классификатору
//
Функция ПолучитьКлассификатор(ИмяМакета) Экспорт

	Классификатор = Новый Соответствие();
	
	Макет = ПолучитьОбщийМакет(ИмяМакета);
	
	ТекущаяОбласть = Макет.Область("Классификатор");

	Если ТекущаяОбласть <> Неопределено Тогда	
	
		Для НомерСтр = ТекущаяОбласть.Верх По ТекущаяОбласть.Низ Цикл
			
			// Перебор строк макета.
			КодПоказателя = СокрП(Макет.Область(НомерСтр, 1).Текст);
			Название      = СокрП(Макет.Область(НомерСтр, 2).Текст);
			
			Если КодПоказателя = "###" Тогда
				Прервать;
			ИначеЕсли ПустаяСтрока(КодПоказателя) Тогда
				Продолжить;
			Иначе
				Классификатор.Вставить(КодПоказателя, Название);
			КонецЕсли;

		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Новый ФиксированноеСоответствие(Классификатор);

КонецФункции

Функция ПолучитьОтветственногоИсполнителя(Пользователь, Организация, ПолноеИмяОбъектаМетаданных = Неопределено) Экспорт
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Пользователи.ФизическоеЛицо
	|ПОМЕСТИТЬ ФизЛицо
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Ссылка = &Пользователь
	|	И НЕ Пользователи.ФизическоеЛицо.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Контрагент.ЮридическоеФизическоеЛицо В
	|			(ВЫБРАТЬ
	|				ФизЛицо.ФизическоеЛицо
	|			ИЗ
	|				ФизЛицо КАК ФизЛицо)
	|	И НЕ Сотрудники.Контрагент.ПометкаУдаления
	|	И НЕ Сотрудники.ПометкаУдаления
	|	И Сотрудники.ДатаУвольнения = ДАТАВРЕМЯ(1,1,1)");
	
	ОтборОрганизация = Справочники.Организации.ПереопределитьОтборПоОрганизации(Организация);

	Если ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьЦентрализованнуюБухгалтерию") 
		И ЗначениеЗаполнено(ПолноеИмяОбъектаМетаданных) Тогда
		
		ИдентификаторОбъектаМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ПолноеИмяОбъектаМетаданных);
		НастройкиЦБ = РегистрыСведений.НастройкиВыбораОтветственныхСотрудниковЦБ.НастройкиПоОбъекту(
			ИдентификаторОбъектаМетаданных, "ОтветственныйИсполнитель");
		Если НастройкиЦБ.Количество() > 0 Тогда
			Если НастройкиЦБ[0].СпособВыбора = ПредопределенноеЗначение("Перечисление.СпособВыбораОтветственногоЦБ.ИзСотрудниковУчреждения") Тогда
				Запрос.Текст = Запрос.Текст + "
				|	И Сотрудники.Владелец = &Организация";
			ИначеЕсли НастройкиЦБ[0].СпособВыбора = ПредопределенноеЗначение("Перечисление.СпособВыбораОтветственногоЦБ.ИзСотрудниковЦБ") Тогда  
				Запрос.Текст = Запрос.Текст + "
				|	И Сотрудники.Владелец = &Организация";
				ОтборОрганизация = Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить();  
			Иначе 
				Запрос.Текст = Запрос.Текст + "
				|	И Сотрудники.Владелец В (&Организация)"; 
				СписокОрганизаций = Новый СписокЗначений;
				СписокОрганизаций.Добавить(ОтборОрганизация);
				СписокОрганизаций.Добавить(Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить()); 
				ОтборОрганизация = СписокОрганизаций;
			КонецЕсли;	
		Иначе
			Запрос.Текст = Запрос.Текст + "
			|	И Сотрудники.Владелец = &Организация";	
		КонецЕсли;
	Иначе
		Запрос.Текст = Запрос.Текст + "
		|	И Сотрудники.Владелец = &Организация";
	КонецЕсли;  

	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Организация", ОтборОрганизация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	
КонецФункции	

// Получает значения реквизитов для безусловного заполнения при создании документа
//
// Параметры
//  ПолноеИмя  - Строка - Полное имя типа объекта
//
Функция ПолучитьЗначенияРеквизитовЗаполнения(ПолноеИмя, Знач ДатаДокумента = Неопределено) Экспорт

	Если ДатаДокумента = Неопределено Тогда
		// Дата документа не установлена. Датой будет текущая дата или дата из настройки пользователя.
		ЗначенияНастроек = Новый Структура("РабочаяДата");
		ПолучитьЗначенияНастроекПользователя(ПользователиКлиентСервер.АвторизованныйПользователь(), ЗначенияНастроек);
		Если ЗначениеЗаполнено(ЗначенияНастроек.РабочаяДата) Тогда
			ДатаДокумента = ЗначенияНастроек.РабочаяДата;
		Иначе
			ДатаДокумента = ТекущаяДатаСеанса();
		КонецЕсли;
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура; 
	СтруктураРеквизитов.Вставить("ДатаЗначенийУмолчаний", ДатаДокумента);
	
	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ИдентификаторыОбъектовМетаданных.Ссылка
	             |ПОМЕСТИТЬ ОбъектМетаданных
	             |ИЗ
	             |	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	             |ГДЕ
	             |	ИдентификаторыОбъектовМетаданных.ПолноеИмя = &ПолноеИмя
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ЗначениеРеквизитовПоУмолчаниюСрезПоследних.ИмяРеквизита,
	             |	ЗначениеРеквизитовПоУмолчаниюСрезПоследних.ЗначениеРеквизита
	             |ИЗ
	             |	РегистрСведений.ЗначениеРеквизитовПоУмолчанию.СрезПоследних(
	             |			&ДатаДокумента,
	             |			ВидОбъекта В
	             |				(ВЫБРАТЬ
	             |					ОбъектМетаданных.Ссылка
	             |				ИЗ
	             |					ОбъектМетаданных)) КАК ЗначениеРеквизитовПоУмолчаниюСрезПоследних";
	Запрос.УстановитьПараметр("ПолноеИмя",ПолноеИмя);
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
	
	РезультатВыборки = Запрос.Выполнить().Выбрать();
	Пока РезультатВыборки.Следующий() Цикл
		
		СтруктураРеквизитов.Вставить(РезультатВыборки.ИмяРеквизита, РезультатВыборки.ЗначениеРеквизита);
		
	КонецЦикла; 
	Возврат СтруктураРеквизитов;
	
КонецФункции // ПолучитьЗначенияРеквизитовЗаполнения()

// Определить параметры выбора сотрудников.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Организация - Неопределено, СправочникСсылка.Организации - параметр не используется
Процедура ОпределитьПараметрыВыбораСотрудников(Форма, Организация = Неопределено) Экспорт
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьЦентрализованнуюБухгалтерию") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормыМассив = СтрРазделить(Форма.ИмяФормы, ".", Ложь);
	ПолноеИмяМетаданных = ИмяФормыМассив[0] + "." + ИмяФормыМассив[1];
	
	ИдентификаторОбъектаМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ПолноеИмяМетаданных);
	Настройки = РегистрыСведений.НастройкиВыбораОтветственныхСотрудниковЦБ.НастройкиПоОбъекту(ИдентификаторОбъектаМетаданных);
	Если Настройки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЦентрализованнаяБухгалтерия = Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить();
	Для Каждого РеквизитНастройки Из Настройки Цикл
		
		НайденныйЭлемент = ЭлементФормыПоИмениРеквизитаНастройки(Форма, РеквизитНастройки.ИмяРеквизита);
		Если НайденныйЭлемент <> Неопределено Тогда
			УстановитьПараметрыВыбораСотрудников(НайденныйЭлемент, РеквизитНастройки.СпособВыбора,
				ЦентрализованнаяБухгалтерия);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// В "Параметры выбора" элемента формы добавляет параметры для выбора сотрудников ЦБ.
// Если параметр ЦентрализованнаяБухгалтерия не заполнен, то значение будет получено
// из константы ОрганизацияЦентрализованнаяБухгалтерия.
// 
// Параметры:
//  Элемент - Неопределено, ПолеФормы - Элемент
//  СпособВыбора - ПеречислениеСсылка.СпособВыбораОтветственногоЦБ - Способ выбора
//  ЦентрализованнаяБухгалтерия - Неопределено, СправочникСсылка.Организации - Централизованная бухгалтерия
Процедура УстановитьПараметрыВыбораСотрудников(Элемент, СпособВыбора, Знач ЦентрализованнаяБухгалтерия = Неопределено) Экспорт

	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьЦентрализованнуюБухгалтерию") Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ЦентрализованнаяБухгалтерия) Тогда
		ЦентрализованнаяБухгалтерия = Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить();
	КонецЕсли;
		
	ПараметрСпособВыбора = Новый ПараметрВыбора("СпособВыбора", СпособВыбора);
	ПараметрЦентрализованнаяБухгалтерия = Новый ПараметрВыбора("ЦентрализованнаяБухгалтерия", ЦентрализованнаяБухгалтерия);
	
	НовыйМассив = Новый Массив;
	// Сохранить существующие параметры выбора, кроме СпособВыбора и ЦентрализованнаяБухгалтерия
	Если Элемент.ПараметрыВыбора <> Неопределено Тогда
		Для Каждого СуществующийПараметр Из Элемент.ПараметрыВыбора Цикл
			Если СуществующийПараметр.Имя <> "СпособВыбора"
					И СуществующийПараметр.Имя <> "ЦентрализованнаяБухгалтерия" Тогда
				НовыйМассив.Добавить(СуществующийПараметр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	НовыйМассив.Добавить(ПараметрСпособВыбора);
	НовыйМассив.Добавить(ПараметрЦентрализованнаяБухгалтерия);
	
	Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
КонецПроцедуры

// Формирует структуру подписанта и возвращает ее
//
// Параметры:
//  ИмяРеквизита - Строка - имя реквизита объекта, который будет заполнен подписантом
//  Подразделение - СправочникСсылка.Подразделения - подразделение для определения ответственного сотрудинка
//
// Возвращаемое значение
//  Структура с ключами "ИмяРеквизита" и "Подразделение"
Функция СтруктураПодписанта(ИмяРеквизита, Подразделение = Неопределено) Экспорт
	Подписант = Новый Структура;
	Подписант.Вставить("ИмяРеквизита", ИмяРеквизита);
	Подписант.Вставить("Подразделение", Подразделение);
	
	Возврат Подписант;
КонецФункции	

// Заполняет в документе подписанта из числа ответственных лиц организации
//
// Параметры:
//  Объект - ДокументОбъект - документ, в котором устанавливаем подписанта
//  ИмяРеквизита - Строка - имя реквизита объекта, который будет заполнен подписантом
//  ВидОтветственного - Строка - вид ответственного. Строковое имя значения перечисления "ОтветственныеЛицаОрганизации"
//  Подразделение - СправочникСсылка.Подразделения - подразделение для определения ответственного сотрудинка
Процедура ЗаполнитьПодписанта(Объект, ИмяРеквизита, ВидОтветственного, Подразделение = Неопределено) Экспорт
	Объект[ИмяРеквизита] = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций." + ВидОтветственного), 
		Объект.Организация,
		Объект.Дата,
		?(ЗначениеЗаполнено(Подразделение), Подразделение, Неопределено)).ОтветственноеЛицоСсылка;
КонецПроцедуры              

// Заполняет в документе подписантов из числа ответственных лиц организации
//
// Параметры:
//  Объект - ДокументОбъект - документ, в котором устанавливаем подписанта
//  СтруктураПодписантов - Структура - Структура многих подписантов
//   * Ключ - <Имя ответственного строкой> - имя ответственного из перечисления ОтветственныеЛицаОрганизаций строкой
//   * Значение - Структура - Структура одного подписанта имеет ключи см. функцию СтруктураПодписанта(), она заполняет эту структуру   
//
Процедура ЗаполнитьПодписантов(Объект, СтруктураПодписантов) Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОтветственныеЛицаОрганизацийСрезПоследних.ВидОтветственногоЛица КАК ВидОтветственногоЛица,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.Подразделение КАК Подразделение,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо КАК ОтветственноеЛицо
	|ИЗ
	|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(
	|			&Дата1,
	|			Организация = &Организация
	|				И ВидОтветственногоЛица В (&ВидыОтветственныхЛиц)
	|				И (&НетПодразделения
	|					ИЛИ Подразделение В (&Подразделения))) КАК ОтветственныеЛицаОрганизацийСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.Подразделение,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.ВидОтветственногоЛица";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Дата1", ?(Объект.Дата = '00010101', ТекущаяДатаСеанса(), Объект.Дата));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);   
	
	ВидыОтветственных = Новый Массив;
	Подразделения     = Новый Массив;
	Для каждого Подписант из СтруктураПодписантов Цикл
		ВидыОтветственных.Добавить(ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций." + Подписант.Ключ));

		Подразделение = Подписант.Значение.Подразделение;
		Если ЗначениеЗаполнено(Подразделение) Тогда
			Подразделения.Добавить(Подразделение);
		КонецЕсли;	
	КонецЦикла;	                                  
	
	Запрос.УстановитьПараметр("НетПодразделения", (Подразделения.Количество() = 0));   
	Запрос.УстановитьПараметр("Подразделения", Подразделения);   
	Запрос.УстановитьПараметр("ВидыОтветственныхЛиц", ВидыОтветственных);    
	
	Ответственные = Запрос.Выполнить().Выгрузить();
	Для каждого Подписант из СтруктураПодписантов Цикл
		Поиск = Новый Структура;
		Поиск.Вставить("ВидОтветственногоЛица", ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций." + Подписант.Ключ));
		Если ЗначениеЗаполнено(Подписант.Значение.Подразделение) Тогда
			Поиск.Вставить("Подразделение", Подписант.Значение.Подразделение);  
		КонецЕсли;	
		НайденныеЛица = Ответственные.НайтиСтроки(Поиск);
		Если ТипЗнч(НайденныеЛица) = Тип("Массив") И НайденныеЛица.Количество() > 0  Тогда
			Объект[Подписант.Значение.ИмяРеквизита] = НайденныеЛица[0].ОтветственноеЛицо;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры              

#Область ИнтеграцияСтандартныеПодсистемы

Процедура ПриОпределенииОбъектовСКомандамиЗаполнения(Объекты) Экспорт
	
	Объекты.Добавить(Метаданные.Документы.РегистрацияОбязательствИСведенийПоДоговорам);
