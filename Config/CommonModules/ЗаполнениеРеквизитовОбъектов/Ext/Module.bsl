#Область СлужебныеПроцедурыИФункции

Функция ЭлементФормыПоИмениРеквизитаНастройки(Форма, ИмяРеквизитаНастройки)
	
	// Поле "Бухгалтер" в типовой операции можно найти через подсистему "Типовые операции"
	Если ИмяРеквизитаНастройки = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаОтветственныйИсполнитель() Тогда
		ИмяЭлемента = БухгалтерскиеОперацииКлиентСервер.ИмяЭлементаФормыДополнительногоРеквизита(Форма,
			ИмяРеквизитаНастройки);
		Возврат Форма.Элементы.Найти(ИмяЭлемента);
	КонецЕсли;
	
	// Если имя реквизита состоит из нескольких частей, то поиск делаем по имени без точек
	Элемент = Форма.Элементы.Найти(СтрЗаменить(ИмяРеквизитаНастройки, ".", ""));
	Если ТипЗнч(Элемент) = Тип("ПолеФормы")
		И Элемент.Вид = ВидПоляФормы.ПолеВвода Тогда
		
		// Проверяется часть имени без "Объект."
		МассивИмен = СтрРазделить(Элемент.ПутьКДанным, ".");
		Если МассивИмен.Количество() > 2 Тогда // Табличная часть 
			ИмяРеквизита = МассивИмен[МассивИмен.Количество()-2] + "." + МассивИмен[МассивИмен.Количество()-1];
		Иначе	
			ИмяРеквизита = МассивИмен[МассивИмен.Количество()-1];
		КонецЕсли;
		
		Если ИмяРеквизитаНастройки = ИмяРеквизита Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЕсли;
	
	// Если элемент не найден, то делаем перебор всех элементов формы
	Для Каждого Элемент Из Форма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ПолеФормы")
			И Элемент.Вид = ВидПоляФормы.ПолеВвода Тогда
			
			// Проверяется часть имени без "Объект."
			МассивИмен = СтрРазделить(Элемент.ПутьКДанным, ".");
			Если МассивИмен.Количество() > 2 Тогда // Табличная часть 
				ИмяРеквизита = МассивИмен[МассивИмен.Количество()-2] + "." + МассивИмен[МассивИмен.Количество()-1];
			Иначе	
				ИмяРеквизита = МассивИмен[МассивИмен.Количество()-1];
			КонецЕсли;
			
			Если ИмяРеквизитаНастройки = ИмяРеквизита Тогда
				Возврат Элемент;
			КонецЕсли;  
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Заполняет значения по умолчанию из настроек пользователя
//
Процедура ЗаполнитьРеквизитыПользователяПоУмолчанию(Объект, Тип = "Документы", Знач ДанныеЗаполнения, ЭтоВводНаОсновании = Ложь, Вид)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Тогда
		ДанныеЗаполнения = Новый Структура;
	КонецЕсли;
		
	ТекущийПользователь = Пользователи.АвторизованныйПользователь();
	ИдентификаторОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект));
	
	ЗначенияНастроек = Неопределено;
	ПолучитьЗначенияНастроекПользователя(ТекущийПользователь, ЗначенияНастроек);
	
	Если Тип = "Документы" И ЗначениеЗаполнено(ЗначенияНастроек.РабочаяДата) И Не ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ЗначенияНастроек.РабочаяДата;
	КонецЕсли;
	
	Если ЭтоВводНаОсновании Тогда
		Возврат;
	КонецЕсли;	
	
	ЗаполняемыеИменаРеквизитов = ИменаЗаполняемыхРеквизитовОбъекта(ИдентификаторОбъекта);
	
	ИмяРеквизитаПодразделение = "";
	
	Для Каждого ТекЗаполняемоеИмя Из ЗаполняемыеИменаРеквизитов Цикл
		
		Если Тип = "Справочники" И НЕ РеквизитШапкиИспользуется(Тип, Вид, ТекЗаполняемоеИмя.Значение, Объект) Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ДанныеЗаполнения.Свойство(ТекЗаполняемоеИмя.Значение) Тогда
			Объект[ТекЗаполняемоеИмя.Значение] = ДанныеЗаполнения[ТекЗаполняемоеИмя.Значение];
		ИначеЕсли ЗначенияНастроек.Свойство(ТекЗаполняемоеИмя.Ключ) Тогда
			Объект[ТекЗаполняемоеИмя.Значение] = ЗначенияНастроек[ТекЗаполняемоеИмя.Ключ];
		КонецЕсли;
		
		Если ТипЗнч(Объект[ТекЗаполняемоеИмя.Значение]) = Тип("СправочникСсылка.Подразделения") Тогда
			ИмяРеквизитаПодразделение = ТекЗаполняемоеИмя.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Тип = "Документы" И ЗначениеЗаполнено(ИмяРеквизитаПодразделение) И ЗначениеЗаполнено(Объект[ИмяРеквизитаПодразделение]) Тогда
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект[ИмяРеквизитаПодразделение], "Владелец") <> Объект.Организация Тогда
			Объект[ИмяРеквизитаПодразделение] = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если Тип = "Документы" 
		И ЗначениеЗаполнено(ИмяРеквизитаПодразделение) 
		И НЕ ЗначениеЗаполнено(Объект[ИмяРеквизитаПодразделение]) 
		И ЗначениеЗаполнено(Объект.Организация) Тогда
		//Добавим подразделение, если оно у организации единственное
		
		ЕдинственноеПодразделениеОрганизации = ОрганизационнаяСтруктура.ЕдинственноеПодразделениеОрганизации(Объект.Организация);
		
		Если ЗначениеЗаполнено(ЕдинственноеПодразделениеОрганизации) Тогда
			
			Объект[ИмяРеквизитаПодразделение] = ЕдинственноеПодразделениеОрганизации;
			
			Для Каждого РеквизитОбъекта Из  Объект.Метаданные().Реквизиты Цикл
				
				Если НЕ РеквизитОбъекта.Имя = ИмяРеквизитаПодразделение 
					И РеквизитОбъекта.Тип.СодержитТип(Тип("СправочникСсылка.Подразделения")) Тогда
					
					Для Каждого Связь Из РеквизитОбъекта.СвязиПараметровВыбора Цикл
				
						Если Объект[Связь.ПутьКДанным] = Объект.Организация Тогда
							
							Объект[РеквизитОбъекта.Имя] = ЕдинственноеПодразделениеОрганизации;
							
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;	
									
КонецПроцедуры

// Получает имена реквизитов объекта, заполняемых из настроек пользователя.
// Могут заполняться реквизиты "Организация", "ИФО", "Подразделение" (или "ПодразделениеОтправитель").
// Реквизит "ИФО" заполняется только если включена ФО "ИспользоватьУчетПоИФО".
// Реквизит "Подразделение" заполняется только если включена ФО "ИспользоватьУчетПоПодразделениям".
//
// Параметры:
//	ИдентификаторОбъектаМетаданных - СправочникСсылка.ИдентификаторыОбъектовМетаданных
//
// Возвращаемое значение:
//	ФиксированнаяСтруктура - в которой "ключ" = имя сохраняемой настройки, "значение" = имя реквизита объекта
//
Функция ИменаЗаполняемыхРеквизитовОбъекта(ИдентификаторОбъектаМетаданных)
	
	СтруктураРеквизитов = Новый Структура;
	
	МетаданныеОбъекта = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторОбъектаМетаданных);
	
	РеквизитОрганизация = МетаданныеОбъекта.Реквизиты.Найти("Организация");
	Если РеквизитОрганизация <> Неопределено Тогда
		СтруктураРеквизитов.Вставить("ОсновнаяОрганизация", "Организация");
	КонецЕсли;
		
	РеквизитИФО = МетаданныеОбъекта.Реквизиты.Найти("ИФО");
	Если РеквизитИФО <> Неопределено Тогда
		ВключенВФО = Метаданные.ФункциональныеОпции.ИспользоватьУчетПоИФО.Состав.Найти(РеквизитИФО) <> Неопределено;
		Если ВключенВФО И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			СтруктураРеквизитов.Вставить("ОсновнойИФО", "ИФО");
		ИначеЕсли НЕ ВключенВФО Тогда
			СтруктураРеквизитов.Вставить("ОсновнойИФО", "ИФО");
		КонецЕсли;
	КонецЕсли;
		
	РеквизитПодразделение = МетаданныеОбъекта.Реквизиты.Найти("Подразделение");
	Если РеквизитПодразделение = Неопределено Тогда
		РеквизитПодразделение = МетаданныеОбъекта.Реквизиты.Найти("ПодразделениеОтправитель");
	КонецЕсли;
	Если РеквизитПодразделение <> Неопределено Тогда
		ВключенВФО = Метаданные.ФункциональныеОпции.ИспользоватьУчетПоПодразделениям.Состав.Найти(РеквизитПодразделение) <> Неопределено;
		Если ВключенВФО И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
			СтруктураРеквизитов.Вставить("ОсновноеПодразделение", РеквизитПодразделение.Имя);
		ИначеЕсли НЕ ВключенВФО Тогда
			СтруктураРеквизитов.Вставить("ОсновноеПодразделение", РеквизитПодразделение.Имя);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура(СтруктураРеквизитов);

КонецФункции // ИменаЗаполняемыхРеквизитовОбъекта()


// Проверяет существование реквизита шапки объекта
//
// Параметры
//  Тип  - Строка - Описание типа объекта "Документы", "Справочники"
//  Вид  - Строка - Наименование объекта, как оно задано в конфигураторе
//  ИмяРеквизита  - Строка - Наименование реквизита объекта, как оно задано в конфигураторе
//
// Возвращаемое значение:
//   Булево   - Истина - реквизит существует, ложь - не существует.
//
Функция СуществуетРеквизитШапки(Тип, Вид, ИмяРеквизита)

	Если Тип="Документы" Тогда
		Возврат (Метаданные.Документы[Вид].Реквизиты.Найти(ИмяРеквизита)<>Неопределено);
	ИначеЕсли Тип="Справочники" Тогда
		Возврат (Метаданные.Справочники[Вид].Реквизиты.Найти(ИмяРеквизита)<>Неопределено);
	КонецЕсли;

КонецФункции // СуществуетРеквизитШапки()

// Проверяет возможность использования реквизита для данного объекта (в зависимости от того - группа или элемент).
//
// Параметры
//  Тип  - Строка - Описание типа объекта "Документы", "Справочники"
//  Вид  - Строка - Наименование объекта, как оно задано в конфигураторе
//  ИмяРеквизита  - Строка - Наименование реквизита объекта, как оно задано в конфигураторе
//  Объект  - СправочникОбъект - Объект, для которого проверяется использование реквизита.
//
// Возвращаемое значение:
//   Булево   - Истина - реквизит существует, ложь - не существует.
//
Функция РеквизитШапкиИспользуется(Тип, Вид, ИмяРеквизита, Объект)
	
	Если Тип<>"Справочники" Тогда
		Возврат Истина;
	КонецЕсли;
	
	МетаданныеРеквизита = Метаданные.Справочники[Вид].Реквизиты[ИмяРеквизита];
	Если МетаданныеРеквизита.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппыИЭлемента ИЛИ
		(Объект.ЭтоГруппа И МетаданныеРеквизита.Использование =
												Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы) ИЛИ
		(НЕ Объект.ЭтоГруппа И МетаданныеРеквизита.Использование =
												Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции // РеквизитШапкиИспользуется()

// Заполняет безусловные значения по умолчанию в справочники и документы. 
//
// Параметры:
//  Объект				 - СправочникОбъект, ДокументОбъект - Объект, который заполняется
//  ДанныеЗаполнения	 - Структура, Неопределено, ДокументСсылка, СправочникСсылка - Данные для заполнения реквизитов
//  СтандартнаяОбработка - Булево - Признак стандартной обработки заполнения объекта после
//                 выполнения данной процедуры
Процедура ЗаполнитьРеквизитыОбъектовПоУмолчанию(Объект, ДанныеЗаполнения, СтандартнаяОбработка)
	
	Перем Тип, Вид;
	
	Если Объект.ЭтоНовый() Тогда
		
		ЭтоВводНаОсновании = Ложь;
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ДанныеЗаполнения)) И ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
			ЭтоВводНаОсновании = Истина;
		ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
			Если ДанныеЗаполнения.Свойство("ВводНаОсновании")
					Или ДанныеЗаполнения.Свойство("КорректируемыйДокумент")
					Или (ДанныеЗаполнения.Свойство("Основание") И ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.ИнвентаризацияМЗ"))
					Или (ДанныеЗаполнения.Свойство("Основание") И ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.АктОРезультатахИнвентаризацииНаличныхДС")) Тогда
				ЭтоВводНаОсновании = Истина;
			КонецЕсли;
		КонецЕсли;
			
				
		ПолноеИмя = Объект.Ссылка.Метаданные().ПолноеИмя();
		ЧастиИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПолноеИмя, ".");
		Если ЧастиИмени[0] = "Документ" Тогда
			Тип = "Документы";
		ИначеЕсли ЧастиИмени[0] = "Справочник" Тогда
			Тип = "Справочники";
		Иначе
			Тип = ЧастиИмени[0];
		КонецЕсли;
		Вид = ЧастиИмени[1];
		
		ЕстьРеквизитОрганизация 	= СуществуетРеквизитШапки(Тип, Вид, "Организация");
		ЕстьРеквизитОтветственный 	= СуществуетРеквизитШапки(Тип, Вид, "Ответственный");
		
		// Заполнение ответственного
		Если ЕстьРеквизитОтветственный  И
			РеквизитШапкиИспользуется(Тип, Вид, "Ответственный", Объект) И
			ТипЗнч(Объект.Ответственный) = Тип("СправочникСсылка.Пользователи") И
			НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
			
			Объект.Ответственный = Пользователи.АвторизованныйПользователь();
			
		КонецЕсли;
		
		Если ЭтоВводНаОсновании Тогда
			// при вводе на основании реквизиты заполняются в обработчике документа (за исключением рабочей даты)
			ЗаполнитьРеквизитыПользователяПоУмолчанию(Объект, Тип, ДанныеЗаполнения, Истина, Вид);
		Иначе
			СтруктураРеквизитов = ПолучитьЗначенияРеквизитовЗаполнения(ПолноеИмя);
			
			Для Каждого ТекКлюч Из СтруктураРеквизитов Цикл
				
				Если СуществуетРеквизитШапки(Тип, Вид, ТекКлюч.Ключ) И
					РеквизитШапкиИспользуется(Тип, Вид, ТекКлюч.Ключ, Объект)
					И (НЕ ЗначениеЗаполнено(Объект[ТекКлюч.Ключ]) ИЛИ ТипЗнч(Объект[ТекКлюч.Ключ]) = Тип("Булево")) Тогда
					
					Если ТипЗнч(ТекКлюч.Значение) = Тип("ПланСчетовСсылка.ЕПСБУ") 
						И ЗначениеЗаполнено(ТекКлюч.Значение) Тогда 
						// Для счетов надо получить счет, актуальный на датудокумента
						КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекКлюч.Значение, "Код");
						СтруктураРеквизитов[ТекКлюч.Ключ] = БухгалтерскийУчет.СчетПоКоду(КодСчета, СтруктураРеквизитов.ДатаЗначенийУмолчаний); 
					КонецЕсли;	
						
					Объект[ТекКлюч.Ключ]=ТекКлюч.Значение;	
					
				КонецЕсли; 
			КонецЦикла; 
			
			ЗаполнитьРеквизитыПользователяПоУмолчанию(Объект, Тип, ДанныеЗаполнения,, Вид);
			
			// Заполнение валюты нового документа - всегда устанавливается РУБ
			Если СуществуетРеквизитШапки(Тип, Вид, "ВалютаДокумента")  И
				РеквизитШапкиИспользуется(Тип, Вид, "ВалютаДокумента", Объект) И 
				НЕ ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
				
				Объект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
				
				Если СуществуетРеквизитШапки(Тип, Вид, "Кратность") Тогда
					Объект.Кратность = 1;
				КонецЕсли;
				
				Если СуществуетРеквизитШапки(Тип, Вид, "Курс") Тогда
					Объект.Курс = 1;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//Реквизит организация или владелец организация
		
		Если ЕстьРеквизитОрганизация И
			РеквизитШапкиИспользуется(Тип, Вид, "Организация", Объект) И 
			НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
			
			Объект.Организация = ПараметрыСеанса.ТекущаяОрганизация;
 
		КонецЕсли;
				
		Если Тип = "Справочники" И 
			ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Владелец") И
			ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.Организации") И
			НЕ ЗначениеЗаполнено(Объект.Владелец) Тогда
			
			Если НЕ (ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
				И ДанныеЗаполнения.Свойство("Владелец")
				И ЗначениеЗаполнено(ДанныеЗаполнения.Владелец)) Тогда
			
				Объект.Владелец = ПараметрыСеанса.ТекущаяОрганизация;
				
				Если Вид = "Подразделения" ИЛИ Вид = "Сотрудники" Тогда
					Объект.Владелец = Справочники.Организации.ПереопределитьОтборПоОрганизации(Объект.Владелец);
				КонецЕсли;	
				
			КонецЕсли;	
 
		КонецЕсли;
			
		//Для документов установим Ответственного исполнителя (сотрудника)
		Если Тип = "Документы" И 
			ЕстьРеквизитОтветственный И
			ЕстьРеквизитОрганизация Тогда
			
			Если СуществуетРеквизитШапки(Тип, Вид, "ОтветственныйИсполнитель") И
				НЕ ЗначениеЗаполнено(Объект.ОтветственныйИсполнитель) Тогда
			
				Объект.ОтветственныйИсполнитель = ПолучитьОтветственногоИсполнителя(Объект.Ответственный, Объект.Организация, ПолноеИмя);
			КонецЕсли;
			
			Если СуществуетРеквизитШапки(Тип, Вид, "ОтветственныйИсполнительБухгалтерскойСлужбы") И
				НЕ ЗначениеЗаполнено(Объект.ОтветственныйИсполнительБухгалтерскойСлужбы) Тогда
			
				Объект.ОтветственныйИсполнительБухгалтерскойСлужбы = ПолучитьОтветственногоИсполнителя(Объект.Ответственный, Объект.Организация, ПолноеИмя);
			КонецЕсли;
		КонецЕсли;	
				
	КонецЕсли;
	
КонецПроцедуры // ОбработкаЗаполнения()

#КонецОбласти

