//
Функция ТаблицаРасчетаТранспортногоНалога(ПараметрыРасчета) Экспорт
	
	ТаблицаРасчетаТранспортногоНалога = НоваяТаблицаРасчетаТранспортногоНалога();
	ЗаполнитьТаблицуРасчетаТранспортногоНалога(ТаблицаРасчетаТранспортногоНалога, ПараметрыРасчета);
	
	Возврат ТаблицаРасчетаТранспортногоНалога;
	
КонецФункции

