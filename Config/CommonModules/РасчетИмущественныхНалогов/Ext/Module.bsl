// Формирует таблицу с расчетом налога на имущество за период расчета
//
// Параметры:
//  ПараметрыРасчета  - Структура - см. РасчетИмущественныхНалогов.ПараметрыРасчетаНалогаНаИмущество() 
//
// Возвращаемое значение:
//   ТаблицаЗначений - см. НоваяТаблицаПоСреднегодовой()
//
Функция ТаблицаРасчетаПоСреднегодовой(ПараметрыРасчета) Экспорт
	
	ТаблицаПоСреднегодовой = НоваяТаблицаПоСреднегодовой();
	ЗаполнитьТаблицуПоСреднегодовой(ТаблицаПоСреднегодовой, ПараметрыРасчета);

	Годовой = КонецДня(ПараметрыРасчета.ОтчетныйПериод) = КонецГода(ПараметрыРасчета.ОтчетныйПериод);
	Если Годовой Тогда
		ЗаполнитьАвансыРасчетПоСреднегодовой(ТаблицаПоСреднегодовой, ПараметрыРасчета);	
	КонецЕсли;
	
	ВыполнитьРасчетНалогаПоСреднегодовойСтоимости(ТаблицаПоСреднегодовой, ПараметрыРасчета);
	
	Возврат ТаблицаПоСреднегодовой;
КонецФункции

// Выполняет расчет налога на имущество согласно порядку заполнения декларации по налогу на имущество.
// Распределяет полученую сумму налога по объектам ОС.
//
// Параметры:
//  ТаблицаПоСреднегодовой  - ТаблицаЗначений - см. РасчетИмущественныхНалогов.НоваяТаблицаПоСреднегодовой()
//  ПараметрыРасчета  - Структура - см. РасчетИмущественныхНалогов.ПараметрыРасчетаНалогаНаИмущество()
//
Процедура ВыполнитьРасчетНалогаПоСреднегодовойСтоимости(ТаблицаПоСреднегодовой, ПараметрыРасчета) Экспорт

	Если ТаблицаПоСреднегодовой.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;

	КолонкиГруппировокПоСтавке = ""
		+ "НалоговыйОрган,"
		+ "КодПоОКТМО,"
		+ "КодВидаИмущества,"
		+ "ДоляСтоимостиЧислитель,"
		+ "ДоляСтоимостиЗнаменатель,"
		+ "НалоговаяСтавка";

	КолонкиГруппировокПоЛьготе = КолонкиГруппировокПоСтавке + ","
		+ "ПорядокНалогообложения,"
		+ "КодНалоговойЛьготыОсвобождениеОтНалогообложения,"
		+ "КодОснованияЛьготы,"
		+ "ПроцентУменьшенияСуммыНалога";
	
	ОтборПоСтавке = Новый Структура(КолонкиГруппировокПоСтавке);
	ОтборСтрок = Новый Структура(КолонкиГруппировокПоЛьготе);

	ТаблицаПоСреднегодовой.Индексы.Добавить(КолонкиГруппировокПоСтавке);
	ТаблицаПоСреднегодовой.Индексы.Добавить(КолонкиГруппировокПоЛьготе);
	
	ИменаКолонокОстаточнаяСтоимость = ИменаКолонокОстаточнаяСтоимость();
	КолонкиСуммирования = СтрСоединить(ИменаКолонокОстаточнаяСтоимость, ",");
	
	ЧислоПериодов = Месяц(ПараметрыРасчета.ОтчетныйПериод) + 1;
	Делитель = ?(КонецДня(ПараметрыРасчета.ОтчетныйПериод) = КонецГода(ПараметрыРасчета.ОтчетныйПериод), 1, 4);
	
	НалогНаИмуществоОбъединятьЛисты = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
		ПараметрыРасчета.Организация, ПараметрыРасчета.ОтчетныйПериод).НалогНаИмуществоОбъединятьЛисты;
	
	РасчетНалогаПоСтавкам = ТаблицаПоСреднегодовой.Скопировать();
	РасчетНалогаПоСтавкам.Свернуть(КолонкиГруппировокПоСтавке, КолонкиСуммирования);
	
	Для Каждого РасчетПоСтавке Из РасчетНалогаПоСтавкам Цикл
	
		ЗаполнитьЗначенияСвойств(ОтборПоСтавке, РасчетПоСтавке);
	
		РасчетНалогаПоЛистам = ТаблицаПоСреднегодовой.Скопировать(ОтборПоСтавке);
		РасчетНалогаПоЛистам.Свернуть(КолонкиГруппировокПоЛьготе, КолонкиСуммирования);
		
		// При объединении листов в декларации результат расчета может отличаться вследствии округления налоговой базы.
		// При установленной опции НалогНаИмуществоОбъединятьЛисты налоговую базу рассчитываем с учетом льготированного имущества.
		// Что бы избежать расхождений вследствии округления налоговой базы.
		// Объединение при наличии не более одной льготы одного типа.

		ЛистыСложения = СложитьРасчетНалогаПоЛистам(РасчетНалогаПоЛистам, НалогНаИмуществоОбъединятьЛисты);
		
		Для каждого СтрокаТаблицы Из РасчетНалогаПоЛистам Цикл
			
			СредняяСтоимость = СредняяСтоимостьЗаПериод(СтрокаТаблицы, 
				ИменаКолонокОстаточнаяСтоимость, ЧислоПериодов, 0);
				
			Если СтрокаТаблицы = ЛистыСложения.Сложение Тогда
				
				СредняяСтоимость = СредняяСтоимость - СредняяСтоимостьЗаПериод(ЛистыСложения.Льготируемое, 
					ИменаКолонокОстаточнаяСтоимость, ЧислоПериодов, 0);
				
			КонецЕсли;
			
			Если СтрокаТаблицы.КодВидаИмущества = "02" Тогда
				ДоляСтоимости = ?(СтрокаТаблицы.ДоляСтоимостиЗнаменатель = 0, 0,
					СтрокаТаблицы.ДоляСтоимостиЧислитель / СтрокаТаблицы.ДоляСтоимостиЗнаменатель);
				НалоговаяБаза = Окр(СредняяСтоимость * ДоляСтоимости);
			Иначе
				НалоговаяБаза = СредняяСтоимость;
			КонецЕсли;
			
			Если СтрокаТаблицы.ПорядокНалогообложения = 
				Перечисления.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения Тогда
					
				СуммаНалога = 0;
				
			Иначе
				СуммаНалога = Окр(НалоговаяБаза * СтрокаТаблицы.НалоговаяСтавка / 100 / Делитель);
			КонецЕсли;

			СнижениеСуммыНаПроцент = СтрокаТаблицы.ПорядокНалогообложения =
				Перечисления.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент;
				
			Если СнижениеСуммыНаПроцент Тогда
				СуммаУменьшенияСуммыНалога = Окр(СуммаНалога * СтрокаТаблицы.ПроцентУменьшенияСуммыНалога / 100);
			Иначе
				СуммаУменьшенияСуммыНалога = 0;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаТаблицы);
			
			СтрокиРасчета = ТаблицаПоСреднегодовой.НайтиСтроки(ОтборСтрок);
			
			КоэффициентыРаспределения = ОбщегоНазначения.ВыгрузитьКолонку(СтрокиРасчета, "СредняяСтоимость");
		   	РаспределениеСуммыНалога  = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(
				СуммаНалога, КоэффициентыРаспределения, 0);
		   	РаспределениеСуммыУменьшенияСуммыНалога  = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(
				СуммаУменьшенияСуммыНалога, КоэффициентыРаспределения, 0);
				
			Для Индекс = 0 По СтрокиРасчета.ВГраница() Цикл

				СтрокиРасчета[Индекс].СуммаИсчислено = ?(РаспределениеСуммыНалога = Неопределено, 0,
					РаспределениеСуммыНалога[Индекс]);
					
				Если СнижениеСуммыНаПроцент Тогда
					СтрокиРасчета[Индекс].СуммаУменьшенияСуммыНалога = ?(
						РаспределениеСуммыУменьшенияСуммыНалога = Неопределено,
						0,
						РаспределениеСуммыУменьшенияСуммыНалога[Индекс]);
				КонецЕсли;
				
				СуммаНалогаКУплате = СтрокиРасчета[Индекс].СуммаИсчислено 
					- СтрокиРасчета[Индекс].СуммаУменьшенияСуммыНалога;
					
				СуммаНалогаКУплате = Макс(СуммаНалогаКУплате, 0);		
					
				СтрокиРасчета[Индекс].Сумма = СуммаНалогаКУплате 
					- (СтрокиРасчета[Индекс].СуммаАвансовыхПлатежей1Кв
						+ СтрокиРасчета[Индекс].СуммаАвансовыхПлатежей2Кв
						+ СтрокиРасчета[Индекс].СуммаАвансовыхПлатежей3Кв);				
					
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Вычисляет среднюю остаточную стоимость за указанное количество периодов.
//
// Параметры:
//   СтрокаТаблицы - СтрокаТаблицыЗначений: см. НоваяТаблицаПоСреднегодовой() - строка таблицы с данными о стоимости
//   ИменаКолонокОстаточнаяСтоимость - см. ИменаКолонокОстаточнаяСтоимость()
//   ЧислоПериодов - Число - количество периодов для расчета средней стоимости, от 1 до 13
//   ТочностьРасчета - Число - точность округления (количество знаков после запятой)
//
// Возвращаемое значение:
//   Число - средняя остаточная стоимость за период
//
Функция СредняяСтоимостьЗаПериод(СтрокаТаблицы, ИменаКолонокОстаточнаяСтоимость, ЧислоПериодов, ТочностьРасчета) Экспорт

	СредняяСтоимостьЗаПериод = 0;
	Для НомерПериода = 1 По ЧислоПериодов Цикл
		СредняяСтоимостьЗаПериод = СредняяСтоимостьЗаПериод 
			+ Окр(СтрокаТаблицы[ИменаКолонокОстаточнаяСтоимость[НомерПериода - 1]], ТочностьРасчета);
	КонецЦикла;
		
	СредняяСтоимостьЗаПериод = Окр(СредняяСтоимостьЗаПериод / ЧислоПериодов, ТочностьРасчета);
	
	Возврат СредняяСтоимостьЗаПериод;
	
КонецФункции

// Возвращает массив имен колонок для использования в алгоритмах расчета налога на имущество
//
// Возвращаемое значение:
//   Массив из Строка - имена колонок остаточной стоимости
//
Функция ИменаКолонокОстаточнаяСтоимость() Экспорт
	ИменаКолонокОстаточнаяСтоимость = Новый Массив;
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа0101");
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа0102");
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа0103");
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа0104");
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа0105");
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа0106");
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа0107");
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа0108");
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа0109");
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа0110");
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа0111");
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа0112");
	ИменаКолонокОстаточнаяСтоимость.Добавить("ОстаточнаяСтоимостьНа3112");
    Возврат ИменаКолонокОстаточнаяСтоимость;
КонецФункции

// Инициализация таблицы расчета налога
//
// Возвращаемое значение:
//   ТаблицаЗначений
//
Функция НоваяТаблицаПоСреднегодовой() Экспорт

	ТаблицаПоСреднегодовой = Новый ТаблицаЗначений;
	Колонки = ТаблицаПоСреднегодовой.Колонки;
	
	Знак = ДопустимыйЗнак.Неотрицательный;
	
	Колонки.Добавить("ОсновноеСредство", 			Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	Колонки.Добавить("ИнвентарныйНомер", 			Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	Колонки.Добавить("НалоговыйОрган", 				Новый ОписаниеТипов("СправочникСсылка.РегистрацииВНалоговомОргане"));
	Колонки.Добавить("КодПоОКТМО", 					Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(11)));
	Колонки.Добавить("КодВидаИмущества", 			Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(2)));
	
	Колонки.Добавить("ОстаточнаяСтоимостьНа0101", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, Знак)));
	Колонки.Добавить("ОстаточнаяСтоимостьНа0102", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, Знак)));
	Колонки.Добавить("ОстаточнаяСтоимостьНа0103", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, Знак)));
	Колонки.Добавить("ОстаточнаяСтоимостьНа0104", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, Знак)));
	Колонки.Добавить("ОстаточнаяСтоимостьНа0105", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, Знак)));
	Колонки.Добавить("ОстаточнаяСтоимостьНа0106", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, Знак)));
	Колонки.Добавить("ОстаточнаяСтоимостьНа0107", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, Знак)));
