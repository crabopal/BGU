// Создает структуру параметров для расчета транспортного налога.
//
// Возвращаемое значение:
//   Структура:
//     * Организация - СправочникСсылка.Организации
//     * ОтчетныйПериод - Дата
//
Функция ПараметрыРасчетаТранспортногоНалога() Экспорт
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ПараметрыРасчета.Вставить("ОтчетныйПериод", Дата(1, 1, 1));
	Возврат ПараметрыРасчета;
КонецФункции 

