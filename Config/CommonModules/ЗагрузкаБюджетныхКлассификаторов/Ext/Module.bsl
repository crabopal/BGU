#Область ПрограммныйИнтерфейс

Функция СобытиеЖурналаРегистрации() Экспорт
	Возврат НСтр("ru = 'Бюджетная классификация.Загрузка бюджетных классификаторов'");
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПОДГОТОВКА ДАННЫХ ДЛЯ ЗАГРУЗКИ
//

// Создает временную таблицу данных бюджетного классификатора. Для простых
// классификаторов - собственно выборку из таблицы справочника,
// для сложных (КД, КИФ, ЦС) - выборку из нескольких таблиц.
// Поля выборки
//			Ссылка
//			Код
//			Наименование
//			НомерСтроки
//			Бюджет
//			ДатаНачалаДействия
//			ДатаОкончанияДействия
//			ЕстьПериод
//
// Параметры:
//
//  МенеджерВременныхТаблиц - МенеджерВременныхТаблиц - в который будет помещена
//                  таблица ДанныеИБ.
//
//  URIТипаСвязи - Строка - URI типа связи, используемый при загрузке или выгрузке
//                  файлов в формате 1С. Идентифицирует нужный классификатор.
//
Процедура СформироватьВременнуюТаблицуДанныхИБ(Знач МенеджерВременныхТаблиц, Знач URIТипаСвязи, ЭтоТест = Ложь) Экспорт
	
	СвойстваКлассификатора = ЗагрузкаБюджетныхКлассификаторовПовтИсп.ПолучитьСвойстваКлассификатора(URIТипаСвязи);
	
	Если СвойстваКлассификатора.ОбработчикПолученияДанных = Неопределено Тогда
		ПолучитьВременнуюТаблицуДанныхИБСтандартно(МенеджерВременныхТаблиц, СвойстваКлассификатора);
	Иначе
		СвойстваКлассификатора.ОбработчикПолученияДанных.ПолучитьВременнуюТаблицуДанныхИБ(МенеджерВременныхТаблиц);
	КонецЕсли;
	
КонецПроцедуры

// Создает временные таблицы: ДанныеДляОбновления, ДанныеКонфликтные,
// ДанныеДляСоздания и ДанныеДляДеактулизации, используя содержащиеся
// в передаваемом менеджере временных таблиц таблицы ДанныеФайла и ДанныеИБ
// (уничтожаются).
// Таблицу ДанныеИБ можно создать функцией
// СформироватьВременнуюТаблицуДанныхИБ().
// Таблица ДанныеФайла должна содержать поля: Код, КодРодителя,
// ДатаНачалаДействия, ДатаОкончанияДействия, Наименование, Бюджет (ссылка),
// Уровень. Если какие-то поля в классификаторе не используются, эти поля
// должны содержать пустые значения.
//
// Параметры:
//
//  МенеджерВременныхТаблиц - МенеджерВременныхТаблиц. Менеджер, в котором уже
//  созданы таблицы ДанныеФайла и ДанныеИБ.
//
Процедура СформироватьВременныеТаблицыОбработкиЭлементов(Знач МенеджерВременныхТаблиц, ЭтоТест = Ложь) Экспорт
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ДанныеИБ.Ссылка,
		|	ДанныеИБ1.Ссылка КАК РодительСсылка,
		|	ДанныеИБ.НомерСтроки,
		|	ДанныеФайла.Код КАК Код,
		|	ДанныеФайла.КодРодителя КАК КодРодителя,
		|	ПОДСТРОКА(ДанныеФайла.Наименование, 1, 1000) КАК Наименование1,
		|	ПОДСТРОКА(ДанныеФайла.Наименование, 1001, 1000) КАК Наименование2,
		|	ПОДСТРОКА(ДанныеФайла.Наименование, 2001, 1000) КАК Наименование3,
		|	ДанныеФайла.ДатаНачалаДействия,
		|	ДанныеФайла.ДатаОкончанияДействия,
		|	ДанныеФайла.Бюджет,
		|	ДанныеФайла.Уровень,
		|	1
		|ПОМЕСТИТЬ ДанныеДляОбновленияПредв
		|ИЗ
		|	ДанныеИБ КАК ДанныеИБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеФайла КАК ДанныеФайла
		|			ЛЕВОЕ СОЕДИНЕНИЕ ДанныеИБ КАК ДанныеИБ1
		|			ПО ДанныеФайла.КодРодителя = ДанныеИБ1.Код
		|				И (ДанныеИБ1.ДатаНачалаДействия = ДанныеФайла.ДатаНачалаДействия)
		|				И (ДанныеИБ1.ДатаОкончанияДействия = ДанныеФайла.ДатаОкончанияДействия
		|					ИЛИ ДанныеИБ1.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ ДанныеФайла.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))
		|				И (ДанныеИБ1.Бюджет = ДанныеФайла.Бюджет)
		|		ПО ДанныеИБ.Код = ДанныеФайла.Код
		|			И ДанныеИБ.ДатаНачалаДействия = ДанныеФайла.ДатаНачалаДействия
		|			И (ДанныеИБ.ДатаОкончанияДействия = ДанныеФайла.ДатаОкончанияДействия
		|				ИЛИ ДанныеИБ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ДанныеФайла.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))
		|			И ДанныеИБ.Бюджет = ДанныеФайла.Бюджет
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеИБ.Ссылка,
		|	ДанныеИБ1.Ссылка,
		|	ДанныеИБ.НомерСтроки,
		|	ДанныеФайла.Код,
		|	ДанныеФайла.КодРодителя,
		|	ПОДСТРОКА(ДанныеФайла.Наименование, 1, 1000) КАК Наименование1,
		|	ПОДСТРОКА(ДанныеФайла.Наименование, 1001, 1000) КАК Наименование2,
		|	ПОДСТРОКА(ДанныеФайла.Наименование, 2001, 1000) КАК Наименование3,
		|	ДанныеФайла.ДатаНачалаДействия,
		|	ДанныеФайла.ДатаОкончанияДействия,
		|	ДанныеФайла.Бюджет,
		|	ДанныеФайла.Уровень,
		|	КОЛИЧЕСТВО(ДанныеФайла.Код)
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДанныеИБ.Ссылка КАК Ссылка,
		|		ДанныеИБ.НомерСтроки КАК НомерСтроки,
		|		ДанныеИБ.Код КАК Код,
		|		ДанныеИБ.Бюджет КАК Бюджет,
		|		ДанныеИБ.ДатаНачалаДействия КАК ДатаНачалаДействия
		|	ИЗ
		|		ДанныеИБ КАК ДанныеИБ
		|			ЛЕВОЕ СОЕДИНЕНИЕ ДанныеИБ КАК ДанныеИБ1
		|			ПО ДанныеИБ.Код = ДанныеИБ1.Код
		|				И ДанныеИБ.Бюджет = ДанныеИБ1.Бюджет
		|				И (ДанныеИБ.Ссылка <> ДанныеИБ.Ссылка)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ДанныеИБ.Бюджет,
		|		ДанныеИБ.Ссылка,
		|		ДанныеИБ.Код,
		|		ДанныеИБ.НомерСтроки,
		|		ДанныеИБ.ДатаНачалаДействия
		|	
		|	ИМЕЮЩИЕ
		|		КОЛИЧЕСТВО(ДанныеИБ1.Ссылка) = 1) КАК ДанныеИБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеФайла КАК ДанныеФайла
		|			ЛЕВОЕ СОЕДИНЕНИЕ ДанныеИБ КАК ДанныеИБ1
		|			ПО ДанныеФайла.КодРодителя = ДанныеИБ1.Код
		|				И (ДанныеИБ1.ДатаНачалаДействия = ДанныеФайла.ДатаНачалаДействия)
		|				И (ДанныеИБ1.ДатаОкончанияДействия = ДанныеФайла.ДатаОкончанияДействия
		|					ИЛИ ДанныеИБ1.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ ДанныеФайла.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))
		|				И (ДанныеИБ1.Бюджет = ДанныеФайла.Бюджет)
		|		ПО ДанныеИБ.Код = ДанныеФайла.Код
		|			И ДанныеИБ.Бюджет = ДанныеФайла.Бюджет
		|			И ДанныеИБ.ДатаНачалаДействия <> ДанныеФайла.ДатаНачалаДействия
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеИБ.Ссылка,
		|	ДанныеИБ1.Ссылка,
		|	ДанныеИБ.НомерСтроки,
		|	ДанныеФайла.Код,
		|	ДанныеФайла.КодРодителя,
		|	ПОДСТРОКА(ДанныеФайла.Наименование, 1, 1000),
		|	ПОДСТРОКА(ДанныеФайла.Наименование, 1001, 1000),
		|	ПОДСТРОКА(ДанныеФайла.Наименование, 2001, 1000),
		|	ДанныеФайла.ДатаНачалаДействия,
		|	ДанныеФайла.ДатаОкончанияДействия,
		|	ДанныеФайла.Бюджет,
		|	ДанныеФайла.Уровень
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(ДанныеФайла.Код) = 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеДляОбновленияПредв.Ссылка,	
		|	ДанныеДляОбновленияПредв.РодительСсылка,	
		|	ДанныеДляОбновленияПредв.НомерСтроки,	
		|	ДанныеДляОбновленияПредв.Код,	
		|	ДанныеДляОбновленияПредв.КодРодителя,	
		|	ДанныеДляОбновленияПредв.Наименование1, 
		|	ДанныеДляОбновленияПредв.Наименование2,
		|	ДанныеДляОбновленияПредв.Наименование3,	
		|	ДанныеДляОбновленияПредв.ДатаНачалаДействия,	
		|	ДанныеДляОбновленияПредв.ДатаОкончанияДействия,	
		|	ДанныеДляОбновленияПредв.Бюджет,	
		|	ДанныеДляОбновленияПредв.Уровень
		|ПОМЕСТИТЬ ДанныеДляОбновления
		|ИЗ
		|   ДанныеДляОбновленияПредв КАК ДанныеДляОбновленияПредв
		|ГДЕ
		|   (ДанныеДляОбновленияПредв.Ссылка <> ДанныеДляОбновленияПредв.РодительСсылка ИЛИ НЕ ДанныеДляОбновленияПредв.НомерСтроки Есть NULL)  
		|   ИЛИ ДанныеДляОбновленияПредв.РодительСсылка ЕСТЬ NULL
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка,
		|	Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ДанныеДляОбновленияПредв
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеФайла.Код КАК Код,
		|	ДанныеФайла.КодРодителя КАК КодРодителя,
		|	ДанныеФайла.ДатаНачалаДействия,
		|	ДанныеФайла.ДатаОкончанияДействия,
		|	ДанныеФайла.Наименование,
		|	ДанныеФайла.Бюджет,
		|	ДанныеФайла.Уровень
		|ПОМЕСТИТЬ ДанныеФайлаНесоединенные
		|ИЗ
		|	ДанныеФайла КАК ДанныеФайла
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеДляОбновления КАК ДанныеДляОбновления
		|		ПО ДанныеФайла.Код = ДанныеДляОбновления.Код
		|           И ДанныеФайла.КодРодителя = ДанныеДляОбновления.КодРодителя
		|			И ДанныеФайла.ДатаНачалаДействия = ДанныеДляОбновления.ДатаНачалаДействия
		|			И ДанныеФайла.ДатаОкончанияДействия = ДанныеДляОбновления.ДатаОкончанияДействия
		|			И ДанныеФайла.Бюджет = ДанныеДляОбновления.Бюджет
		|ГДЕ
		|	ДанныеДляОбновления.Код ЕСТЬ NULL 
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеФайла.Бюджет
		|ПОМЕСТИТЬ ДанныеФайлаБюджеты
		|ИЗ
		|	ДанныеФайла КАК ДанныеФайла
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ДанныеФайла
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеИБ.Ссылка,
		|	ДанныеИБ.Код КАК Код,
		|	ДанныеИБ.Наименование,
		|	ДанныеИБ.НомерСтроки,
		|	ДанныеИБ.Бюджет,
		|	ДанныеИБ.ДатаНачалаДействия,
		|	ДанныеИБ.ДатаОкончанияДействия,
		|	ДанныеФайлаНесоединенные.ДатаНачалаДействия КАК ДатаНачалаДействияФайл,
		|	ДанныеФайлаНесоединенные.ДатаОкончанияДействия КАК ДатаОкончанияДействияФайл,
		|	ДанныеФайлаНесоединенные.Уровень КАК Уровень
		|ПОМЕСТИТЬ ДанныеКонфликтные
		|ИЗ
		|	ДанныеИБ КАК ДанныеИБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеФайлаНесоединенные КАК ДанныеФайлаНесоединенные
		|		ПО ДанныеИБ.Код = ДанныеФайлаНесоединенные.Код
		|			И ДанныеИБ.Бюджет = ДанныеФайлаНесоединенные.Бюджет
		|			И (ДанныеИБ.ДатаНачалаДействия < ВЫБОР
		|				КОГДА ДанныеФайлаНесоединенные.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
		|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
		|				ИНАЧЕ ДанныеФайлаНесоединенные.ДатаОкончанияДействия
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА ДанныеИБ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
		|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
		|				ИНАЧЕ ДанныеИБ.ДатаОкончанияДействия
		|			КОНЕЦ > ДанныеФайлаНесоединенные.ДатаНачалаДействия)
		|			И НЕ(ДанныеИБ.ДатаНачалаДействия = ДанныеФайлаНесоединенные.ДатаНачалаДействия
		|				И ДанныеИБ.ДатаОкончанияДействия = ДанныеФайлаНесоединенные.ДатаОкончанияДействия)
		|ГДЕ
		|	(НЕ ДанныеИБ.Ссылка В
		|				(ВЫБРАТЬ
		|					ДанныеДляОбновления.Ссылка
		|				ИЗ
		|					ДанныеДляОбновления))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеФайлаНесоединенные.Код,
		|	ДанныеФайлаНесоединенные.КодРодителя,
		|	ДанныеФайлаНесоединенные.ДатаНачалаДействия,
		|	ДанныеФайлаНесоединенные.ДатаОкончанияДействия,
		|	ДанныеФайлаНесоединенные.Наименование,
		|	ДанныеФайлаНесоединенные.Бюджет,
		|	ДанныеФайлаНесоединенные.Уровень
		|ПОМЕСТИТЬ ДанныеДляСоздания
		|ИЗ
		|	ДанныеФайлаНесоединенные КАК ДанныеФайлаНесоединенные
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеКонфликтные КАК ДанныеКонфликтные
		|		ПО ДанныеФайлаНесоединенные.Код = ДанныеКонфликтные.Код
		|			И ДанныеФайлаНесоединенные.Бюджет = ДанныеКонфликтные.Бюджет
		|			И ДанныеФайлаНесоединенные.ДатаНачалаДействия = ДанныеКонфликтные.ДатаНачалаДействияФайл
		|			И ДанныеФайлаНесоединенные.ДатаОкончанияДействия = ДанныеКонфликтные.ДатаОкончанияДействияФайл
		|			
		|ГДЕ
		|	ДанныеКонфликтные.Код ЕСТЬ NULL   
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеДляСоздания.Код КАК Код,
		|	ДанныеДляСоздания.Бюджет КАК Бюджет,
		|	МИНИМУМ(ДанныеДляСоздания.ДатаНачалаДействия) КАК ДатаНачалаДействия
		|ПОМЕСТИТЬ ДанныеДляСозданияБюджеты
		|ИЗ
		|	ДанныеДляСоздания КАК ДанныеДляСоздания
		|		
		|СГРУППИРОВАТЬ ПО
		|	ДанныеДляСоздания.Код,
		|	ДанныеДляСоздания.Бюджет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеИБ.Ссылка,
		|	ДанныеИБ.Код,
		|	ДанныеИБ.Бюджет,
		|	ДанныеИБ.ДатаНачалаДействия,
		|	ДанныеИБ.ДатаОкончанияДействия
		|ПОМЕСТИТЬ ДанныеДляДеактуализацииПредвИндекс
		|ИЗ
		|	ДанныеИБ КАК ДанныеИБ
		|ГДЕ
		|	ДанныеИБ.ДатаНачалаДействия <> ДАТАВРЕМЯ(1, 1, 1)
		|	И ДанныеИБ.Бюджет В
		|			(ВЫБРАТЬ
		|				ДанныеФайлаБюджеты.Бюджет
		|			ИЗ
		|				ДанныеФайлаБюджеты)
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеДляДеактуализацииПредв.Ссылка,
		|	ДанныеДляДеактуализацииПредв.Код,
		|	ДанныеДляДеактуализацииПредв.Бюджет,
		|	ДанныеДляДеактуализацииПредв.ДатаНачалаДействия,
		|	ДанныеДляДеактуализацииПредв.ДатаОкончанияДействия
		|ПОМЕСТИТЬ ДанныеДляДеактуализацииПредвКонечная
		|ИЗ
		|	ДанныеДляДеактуализацииПредвИндекс КАК ДанныеДляДеактуализацииПредв
		|ГДЕ
		|	НЕ ДанныеДляДеактуализацииПредв.Ссылка В
		|				(ВЫБРАТЬ
		|					ДанныеДляОбновления.Ссылка
		|				ИЗ
		|					ДанныеДляОбновления)
		|	И НЕ ДанныеДляДеактуализацииПредв.Ссылка В
		|				(ВЫБРАТЬ
		|					ДанныеКонфликтные.Ссылка
		|				ИЗ
		|					ДанныеКонфликтные)
		|ИНДЕКСИРОВАТЬ ПО
		|	Код,
		|	Бюджет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеДляДеактуализацииПредвКонечная.Ссылка,
		|	ВЫБОР
		|		КОГДА НЕ ДанныеДляСозданияБюджеты.ДатаНачалаДействия ЕСТЬ NULL 
		|				И ДанныеДляДеактуализацииПредвКонечная.ДатаНачалаДействия < ДанныеДляСозданияБюджеты.ДатаНачалаДействия
		|			ТОГДА ДОБАВИТЬКДАТЕ(ДанныеДляСозданияБюджеты.ДатаНачалаДействия, ДЕНЬ, -1)
		|		ИНАЧЕ ДанныеДляДеактуализацииПредвКонечная.ДатаОкончанияДействия
		|	КОНЕЦ КАК НоваяДатаОкончания,
		|	ВЫБОР
		|		КОГДА ДанныеДляСозданияБюджеты.ДатаНачалаДействия ЕСТЬ NULL 
		|				ИЛИ ДанныеДляДеактуализацииПредвКонечная.ДатаНачалаДействия >= ДанныеДляСозданияБюджеты.ДатаНачалаДействия
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК НоваяПометкаУдаления
		|ПОМЕСТИТЬ ДанныеДляДеактуализации
		|ИЗ
		|	ДанныеДляДеактуализацииПредвКонечная КАК ДанныеДляДеактуализацииПредвКонечная 
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеДляСозданияБюджеты КАК ДанныеДляСозданияБюджеты
		|		ПО ДанныеДляДеактуализацииПредвКонечная.Код = ДанныеДляСозданияБюджеты.Код
		|			И ДанныеДляДеактуализацииПредвКонечная.Бюджет = ДанныеДляСозданияБюджеты.Бюджет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ДанныеФайлаБюджеты
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ДанныеДляДеактуализацииПредвИндекс
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ДанныеДляДеактуализацииПредвКонечная
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ДанныеФайлаНесоединенные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ДанныеДляСозданияБюджеты
        |";
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
