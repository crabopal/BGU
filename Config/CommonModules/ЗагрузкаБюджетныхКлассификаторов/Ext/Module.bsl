//

Функция ДеактуализироватьЭлементы(Знач МенеджерВременныхТаблиц, Знач URIТипаСвязи) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Деактуализировано", 0);
	Результат.Вставить("ПомеченоНаУдаление", 0);
	Результат.Вставить("Статус", Истина);
	Результат.Вставить("Ошибки", Новый Соответствие);
	
	РезультатЗапроса = ПолучитьВременнуюТаблицу(МенеджерВременныхТаблиц, "ДанныеДляДеактуализации");
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Попытка
			ЭлементОбъект = НачатьИзменениеЭлемента(Выборка.Ссылка);
			Если Выборка.НоваяПометкаУдаления Тогда
				ЭлементОбъект.ПометкаУдаления   = Выборка.НоваяПометкаУдаления;
				Результат.ПомеченоНаУдаление = Результат.ПомеченоНаУдаление + 1;
			Иначе
				ЭлементОбъект.ОкончаниеДействия = Выборка.НоваяДатаОкончания;
				Результат.Деактуализировано = Результат.Деактуализировано + 1;
			КонецЕсли;
			ЗакончитьИзменениеЭлемента(ЭлементОбъект);
		Исключение
			ВызватьИсключение;
		КонецПопытки
		
	КонецЦикла;
	
КонецФункции

Функция ОбновитьЭлементы(Знач МенеджерВременныхТаблиц, Знач URIТипаСвязи) Экспорт
	
	СвойстваКлассификатора = ЗагрузкаБюджетныхКлассификаторовПовтИсп.ПолучитьСвойстваКлассификатора(URIТипаСвязи);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДанныеДляОбновления.Ссылка КАК Ссылка,
		|	ДанныеДляОбновления.РодительСсылка КАК РодительСсылка,
		|	ДанныеДляОбновления.НомерСтроки КАК НомерСтроки,
		|	ДанныеДляОбновления.Код КАК Код,
		|	ДанныеДляОбновления.КодРодителя КАК КодРодителя,
		|	ДанныеДляОбновления.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	ДанныеДляОбновления.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
		|	ДанныеДляОбновления.Наименование1 + ДанныеДляОбновления.Наименование2 + ДанныеДляОбновления.Наименование3 КАК Наименование,
		|	ДанныеДляОбновления.Бюджет КАК Бюджет
		|ИЗ
		|	ДанныеДляОбновления КАК ДанныеДляОбновления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код
		|ИТОГИ ПО
		|	Ссылка";
	
	СчетчикЭлементов = 0;
	
	ВыборкаПоСсылке = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоСсылке.Следующий() Цикл
		
		ЭлементОбъект = НачатьИзменениеЭлемента(ВыборкаПоСсылке.Ссылка);
		
		Выборка = ВыборкаПоСсылке.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			УстановитьРеквизитыЭлемента(ЭлементОбъект, Выборка, СвойстваКлассификатора.Состав.Найти(ТипЗнч(Выборка.Ссылка), "ТипСсылки").Характеристики);
			
		КонецЦикла;
		
		ЗакончитьИзменениеЭлемента(ЭлементОбъект);
		
		СчетчикЭлементов = СчетчикЭлементов + 1;
		
	КонецЦикла;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПолучитьВременнуюТаблицуДанныхИБСтандартно(МенеджерВременныхТаблиц, СвойстваКлассификатора);
	
	ЧленыОбъединения = Новый Массив;
	
	Для каждого СтрокаСоставаКлассификатора Из СвойстваКлассификатора.Состав Цикл
		
		ОбъектМетаданных = СтрокаСоставаКлассификатора.ОбъектМетаданных;
		
		ИменаТаблиц = Новый Структура;
		ИменаТаблиц.Вставить("Таблица", ОбъектМетаданных.Имя);
		
		Характеристики = СтрокаСоставаКлассификатора.Характеристики;
		Если СвойстваКлассификатора.Состав.Индекс(СтрокаСоставаКлассификатора) > 0 Тогда
			СтрокаСоставаКлассификатораВладелец = СвойстваКлассификатора.Состав[СвойстваКлассификатора.Состав.Индекс(СтрокаСоставаКлассификатора) - 1];
			ХарактеристикиВладельца = СтрокаСоставаКлассификатораВладелец.Характеристики;
			ИменаТаблиц.Вставить("Владелец", СтрокаСоставаКлассификатораВладелец.ОбъектМетаданных.Имя);
		КонецЕсли;
		
		Если Характеристики.ЕстьДопустимыеКОСГУ Тогда
			
			НуженВладелец = Ложь;
			
			СтруктураЗапроса = СоздатьОписаниеЗапросаПоДаннымИБ();
			ВыбранныеПоля = СтруктураЗапроса.ВыбранныеПоля;
			
			ВыбранныеПоля.Ссылка       = "%Таблица%ДопустимыеКОСГУ.Ссылка";
			ВыбранныеПоля.Код          = "%Таблица%ДопустимыеКОСГУ.Ссылка.Наименование + %Таблица%ДопустимыеКОСГУ.КОСГУ.Код";
			ВыбранныеПоля.Наименование = "%Таблица%ДопустимыеКОСГУ.Наименование";
			ВыбранныеПоля.НомерСтроки  = "%Таблица%ДопустимыеКОСГУ.НомерСтроки";
			
			Если Характеристики.ЕстьБюджет Тогда
				ВыбранныеПоля.Бюджет = "%Таблица%ДопустимыеКОСГУ.Ссылка.Бюджет";
			ИначеЕсли ХарактеристикиВладельца <> Неопределено И ХарактеристикиВладельца.ЕстьБюджет Тогда
				ВыбранныеПоля.Бюджет = "%Владелец%.Бюджет";
			Иначе
				ВыбранныеПоля.Бюджет = "НЕОПРЕДЕЛЕНО";
			КонецЕсли;
			
			Если Характеристики.ЕстьПериодДействия Тогда
				ВыбранныеПоля.ДатаНачалаДействия    = "%Таблица%ДопустимыеКОСГУ.Ссылка.ДатаНачалаДействия";
				ВыбранныеПоля.ДатаОкончанияДействия = "%Таблица%ДопустимыеКОСГУ.Ссылка.ОкончаниеДействия";
				ВыбранныеПоля.ЕстьПериод			= "Истина";
			ИначеЕсли ХарактеристикиВладельца <> Неопределено И ХарактеристикиВладельца.ЕстьПериодДействия Тогда
				ВыбранныеПоля.ДатаНачалаДействия    = "%Владелец%.ДатаНачалаДействия";
				ВыбранныеПоля.ДатаОкончанияДействия = "%Владелец%.ОкончаниеДействия";
			Иначе
				ВыбранныеПоля.ДатаНачалаДействия    = "ДАТАВРЕМЯ(1, 1, 1)";
				ВыбранныеПоля.ДатаОкончанияДействия = "ДАТАВРЕМЯ(1, 1, 1)";
			КонецЕсли;
			
			Если НуженВладелец Тогда
				СтруктураЗапроса.ИЗ =
					"	Справочник.%Таблица%.ДопустимыеКОСГУ КАК %Таблица%ДопустимыеКОСГУ
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.%Владелец% КАК %Владелец%
					|		ПО %Таблица%ДопустимыеКОСГУ.Ссылка.Владелец = %Владелец%.Ссылка";
			Иначе
				СтруктураЗапроса.ИЗ = "Справочник.%Таблица%.ДопустимыеКОСГУ КАК %Таблица%ДопустимыеКОСГУ";
			КонецЕсли;
			
			Если НЕ Характеристики.КонтрольУникальности Тогда
				СтруктураЗапроса.ГДЕ =
					"	НЕ %Таблица%ДопустимыеКОСГУ.Ссылка.ПометкаУдаления";
			КонецЕсли;
			
			ЧленыОбъединения.Добавить(Новый Структура("ИменаТаблиц, СтруктураЗапроса", ИменаТаблиц, СтруктураЗапроса));
			
			СтруктураЗапроса = СоздатьОписаниеЗапросаПоДаннымИБ();
			СтруктураЗапроса.ГДЕ =
				?(НЕ Характеристики.КонтрольУникальности, "	НЕ %Таблица%.ПометкаУдаления И", "") + "
				|	НЕ %Таблица%.Ссылка В
				|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
				|					%Таблица%ДопустимыеКОСГУ.Ссылка КАК Ссылка
				|				ИЗ
				|					Справочник.%Таблица%.ДопустимыеКОСГУ КАК %Таблица%ДопустимыеКОСГУ)";
			ВыбранныеПоля = СтруктураЗапроса.ВыбранныеПоля;
			ВыбранныеПоля.Ссылка       = "%Таблица%.Ссылка";
			ВыбранныеПоля.Код          = "%Таблица%.Наименование + ""000""";
			ВыбранныеПоля.Наименование = "%Таблица%.НаименованиеПолное";
			
			Если Характеристики.ЕстьБюджет Тогда
				ВыбранныеПоля.Бюджет = "%Таблица%.Бюджет";
			ИначеЕсли ХарактеристикиВладельца <> Неопределено И ХарактеристикиВладельца.ЕстьБюджет Тогда
				ВыбранныеПоля.Бюджет = "%Владелец%.Бюджет";
			Иначе
				ВыбранныеПоля.Бюджет = "НЕОПРЕДЕЛЕНО";
			КонецЕсли;
			
			Если Характеристики.ЕстьПериодДействия Тогда
				ВыбранныеПоля.ДатаНачалаДействия    = "%Таблица%.ДатаНачалаДействия";
				ВыбранныеПоля.ДатаОкончанияДействия = "%Таблица%.ОкончаниеДействия";
				ВыбранныеПоля.ЕстьПериод			= "Истина";
			ИначеЕсли ХарактеристикиВладельца <> Неопределено И ХарактеристикиВладельца.ЕстьПериодДействия Тогда
				ВыбранныеПоля.ДатаНачалаДействия    = "%Владелец%.ДатаНачалаДействия";
				ВыбранныеПоля.ДатаОкончанияДействия = "%Владелец%.ОкончаниеДействия";
			Иначе
				ВыбранныеПоля.ДатаНачалаДействия    = "ДАТАВРЕМЯ(1, 1, 1)";
				ВыбранныеПоля.ДатаОкончанияДействия = "ДАТАВРЕМЯ(1, 1, 1)";
			КонецЕсли;
			
			Если НуженВладелец Тогда
				СтруктураЗапроса.ИЗ =
					"	Справочник.%Таблица% КАК %Таблица%
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.%Владелец% КАК %Владелец%
					|		ПО %Таблица%.Владелец = %Владелец%.Ссылка";
			Иначе
				СтруктураЗапроса.ИЗ = "Справочник.%Таблица% КАК %Таблица%";
			КонецЕсли;
			
			ЧленыОбъединения.Добавить(Новый Структура("ИменаТаблиц, СтруктураЗапроса", ИменаТаблиц, СтруктураЗапроса));
			
		Иначе
			
			НуженВладелец = Ложь;
			
			СтруктураЗапроса = СоздатьОписаниеЗапросаПоДаннымИБ();
			ВыбранныеПоля = СтруктураЗапроса.ВыбранныеПоля;
			ВыбранныеПоля.Ссылка       = "%Таблица%.Ссылка";
			
			Если ХарактеристикиВладельца <> Неопределено И ХарактеристикиВладельца.ЕстьДопустимыеКОСГУ Тогда
				ВыбранныеПоля.Код = "%Таблица%.Наименование + %Владелец%ДопустимыеКОСГУ.КОСГУ.Код";
				НуженВладелец = Истина;
			Иначе
				ВыбранныеПоля.Код = ?(СвойстваКлассификатора.ЕстьПолныйКод, "%Таблица%.Наименование", "%Таблица%.Код");
				Если СвойстваКлассификатора.ЕстьКОСГУ Тогда
					ВыбранныеПоля.Код = ВыбранныеПоля.Код + " + ""000""";
				КонецЕсли;
			КонецЕсли;
			
			ВыбранныеПоля.Наименование = "%Таблица%.НаименованиеПолное";
			
			Если Характеристики.ЕстьБюджет Тогда
				ВыбранныеПоля.Бюджет = "%Таблица%.Бюджет";
			ИначеЕсли ХарактеристикиВладельца <> Неопределено И ХарактеристикиВладельца.ЕстьБюджет Тогда
				ВыбранныеПоля.Бюджет = ?(ХарактеристикиВладельца.ЕстьДопустимыеКОСГУ, "%Владелец%ДопустимыеКОСГУ.Ссылка.Бюджет", "%Владелец%.Бюджет");
				НуженВладелец = Истина;
			Иначе
				ВыбранныеПоля.Бюджет = "НЕОПРЕДЕЛЕНО";
			КонецЕсли;
			
			Если Характеристики.ЕстьПериодДействия Тогда
				ВыбранныеПоля.ДатаНачалаДействия    = "%Таблица%.ДатаНачалаДействия";
				ВыбранныеПоля.ДатаОкончанияДействия = "%Таблица%.ОкончаниеДействия";
				ВыбранныеПоля.ЕстьПериод			= "Истина";
			ИначеЕсли ХарактеристикиВладельца <> Неопределено И ХарактеристикиВладельца.ЕстьПериодДействия Тогда
				Если ХарактеристикиВладельца.ЕстьДопустимыеКОСГУ Тогда
					ВыбранныеПоля.ДатаНачалаДействия    = "%Владелец%ДопустимыеКОСГУ.Ссылка.ДатаНачалаДействия";
					ВыбранныеПоля.ДатаОкончанияДействия = "%Владелец%ДопустимыеКОСГУ.Ссылка.ОкончаниеДействия";
				Иначе
					ВыбранныеПоля.ДатаНачалаДействия    = "%Владелец%.ДатаНачалаДействия";
					ВыбранныеПоля.ДатаОкончанияДействия = "%Владелец%.ОкончаниеДействия";
				КонецЕсли;
				НуженВладелец = Истина;
			Иначе
				ВыбранныеПоля.ДатаНачалаДействия    = "ДАТАВРЕМЯ(1, 1, 1)";
				ВыбранныеПоля.ДатаОкончанияДействия = "ДАТАВРЕМЯ(1, 1, 1)";
			КонецЕсли;
			
			Если НЕ НуженВладелец Тогда
				СтруктураЗапроса.ИЗ = "Справочник.%Таблица% КАК %Таблица%";
				Если НЕ Характеристики.КонтрольУникальности Тогда
					СтруктураЗапроса.ГДЕ =
						"	%Таблица%.ПометкаУдаления = ЛОЖЬ";
				КонецЕсли;
			ИначеЕсли ХарактеристикиВладельца <> Неопределено И ХарактеристикиВладельца.ЕстьДопустимыеКОСГУ Тогда
				СтруктураЗапроса.ИЗ =
					"	Справочник.%Таблица% КАК %Таблица%
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.%Владелец%.ДопустимыеКОСГУ КАК %Владелец%ДопустимыеКОСГУ
					|		ПО %Таблица%.Владелец = %Владелец%ДопустимыеКОСГУ.Ссылка";
				СтруктураЗапроса.ГДЕ =
					?(НЕ Характеристики.КонтрольУникальности, "	%Таблица%.ПометкаУдаления = ЛОЖЬ И ", "") + "%Владелец%ДопустимыеКОСГУ.Ссылка.ПометкаУдаления = ЛОЖЬ";
			Иначе
				СтруктураЗапроса.ИЗ =
					"	Справочник.%Таблица% КАК %Таблица%
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.%Владелец% КАК %Владелец%
					|		ПО %Таблица%.Владелец = %Владелец%.Ссылка";
				СтруктураЗапроса.ГДЕ =
					?(НЕ Характеристики.КонтрольУникальности, "	%Таблица%.ПометкаУдаления = ЛОЖЬ И ", "") + "%Владелец%.ПометкаУдаления = ЛОЖЬ";
			КонецЕсли;
			
			ЧленыОбъединения.Добавить(Новый Структура("ИменаТаблиц, СтруктураЗапроса", ИменаТаблиц, СтруктураЗапроса));
			
		КонецЕсли;
		
	КонецЦикла;
	
	РазделительПолейВыборки = "," + Символы.ПС;
	ПолныйТекстЗапроса = "";
	
	Для каждого ЧленОбъединения Из ЧленыОбъединения Цикл
		
		ТекстЗапроса = "ВЫБРАТЬ" + Символы.ПС;
		СписокВыборки = "";
		Для каждого КлючИЗначение Из ЧленОбъединения.СтруктураЗапроса.ВыбранныеПоля Цикл
			СписокВыборки = СписокВыборки + РазделительПолейВыборки + Символы.Таб + ПодставитьЗначенияВСтроку(КлючИЗначение.Значение, ЧленОбъединения.ИменаТаблиц) + " КАК " + КлючИЗначение.Ключ;
		КонецЦикла;
		СписокВыборки = Сред(СписокВыборки, СтрДлина(РазделительПолейВыборки) + 1);
		ТекстЗапроса = ТекстЗапроса + СписокВыборки;
		
		Если ПустаяСтрока(ПолныйТекстЗапроса) Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + "ПОМЕСТИТЬ ДанныеИБ";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "ИЗ" + Символы.ПС;
		ТекстЗапроса = ТекстЗапроса + ПодставитьЗначенияВСтроку(ЧленОбъединения.СтруктураЗапроса.ИЗ, ЧленОбъединения.ИменаТаблиц);
		
		Если ЗначениеЗаполнено(ЧленОбъединения.СтруктураЗапроса.ГДЕ) Тогда
			
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + "ГДЕ" + Символы.ПС;
			ТекстЗапроса = ТекстЗапроса + ПодставитьЗначенияВСтроку(ЧленОбъединения.СтруктураЗапроса.ГДЕ, ЧленОбъединения.ИменаТаблиц);
			
		КонецЕсли;
		
		Если ПустаяСтрока(ПолныйТекстЗапроса) Тогда
			ПолныйТекстЗапроса = ТекстЗапроса;
		Иначе
			ПолныйТекстЗапроса = ПолныйТекстЗапроса +
				"
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|" + ТекстЗапроса;
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Код";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолныйТекстЗапроса;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Выполнить();
		
КонецПроцедуры

// Формирует сообщение из строки с параметрами. Как строка, так и значения
// параметров могут быть заданы на нескольких языках.
//
// Параметры:
//  Сообщение - Строка - текст сообщения с включенными в него параметрами
//  в форме %ИмяПараметра%.
//  Параметры - Структура - структура, в которой перечислены значения
//  параметров.
//
Функция ПодставитьЗначенияВСтроку(СтрокаПодстановки, Значения = Неопределено)
	
	Текст = СтрокаПодстановки;
	
	Если Значения = Неопределено Тогда
		Результат = Текст;
	Иначе
		ОстатокТекста   = Текст;
		ПозНачалаЗначения = Найти(ОстатокТекста, "%");
		
		Результат = "";
		Если ПозНачалаЗначения > 0 Тогда
			
			Пока ПозНачалаЗначения > 0 Цикл
				
				Результат = Результат + Лев(ОстатокТекста, ПозНачалаЗначения - 1);
				
				ОстатокТекста  = Сред(ОстатокТекста, ПозНачалаЗначения + 1);
				ПозКонцаЗначения = Найти(ОстатокТекста, "%");
				
				Если ПозКонцаЗначения = 1 Тогда // двойной «%» - не параметр
					Результат = Результат + "%";
				ИначеЕсли ПозКонцаЗначения = 0 Тогда // ошибка
					Результат = Результат + "%";
					Прервать;
				Иначе
					
					ПутьКДанным = Лев(ОстатокТекста, ПозКонцаЗначения - 1);
					Попытка
						Значение = Значения;
						Для Каждого Имя Из СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПутьКДанным, ".") Цикл
							Значение = Значение[Имя];
						КонецЦикла;
					Исключение
						Значение = "";
					КонецПопытки;
					Результат = Результат + ПодставитьЗначенияВСтроку(СокрЛП(Значение), Неопределено);
					
				КонецЕсли;
				
				ОстатокТекста   = Сред(ОстатокТекста, ПозКонцаЗначения + 1);
				ПозНачалаЗначения = Найти(ОстатокТекста, "%");
				
			КонецЦикла;
		КонецЕсли;   
		
		Результат = Результат + ОстатокТекста;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция СоздатьСтруктуруПолейВыборкиЗапросаПоДаннымИБ()
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка", "NULL");
	Результат.Вставить("Код", "NULL");
	Результат.Вставить("Наименование", "NULL");
	Результат.Вставить("НомерСтроки", "NULL");
	Результат.Вставить("Бюджет", "NULL");
	Результат.Вставить("ДатаНачалаДействия", "NULL");
	Результат.Вставить("ДатаОкончанияДействия", "NULL");
	Результат.Вставить("ЕстьПериод", "Ложь");

	Возврат Результат;
	
КонецФункции

Функция СоздатьОписаниеЗапросаПоДаннымИБ()
	
	Результат = Новый Структура("ИЗ,ГДЕ,ВыбранныеПоля");
	Результат.ВыбранныеПоля = СоздатьСтруктуруПолейВыборкиЗапросаПоДаннымИБ();
	Возврат Результат;
	
КонецФункции

Процедура УстановитьРеквизитыЭлемента(Знач Объект, Знач ИсточникЗначений, Знач Характеристики)
	
	Если Характеристики.ЕстьРодитель И ТипЗнч(ИсточникЗначений.РодительСсылка) = ТипЗнч(Объект.Ссылка) Тогда
		Объект.Родитель = ИсточникЗначений.РодительСсылка;
	КонецЕсли;
	
	Если Характеристики.ЕстьВладелец Тогда
		Если ЗначениеЗаполнено(Объект.Родитель) Тогда
			Объект[Характеристики.ИмяРеквизитаВладелец] = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Родитель, Характеристики.ИмяРеквизитаВладелец);
		ИначеЕсли ИсточникЗначений.РодительСсылка <> Null И ТипЗнч(ИсточникЗначений.РодительСсылка) <> ТипЗнч(Объект.Ссылка) Тогда
			Объект[Характеристики.ИмяРеквизитаВладелец] = ИсточникЗначений.РодительСсылка;
		КонецЕсли;
	КонецЕсли;
	
	Если Характеристики.ЕстьДопустимыеКОСГУ Тогда
		Если ЗначениеЗаполнено(ИсточникЗначений.НомерСтроки) Тогда
			Объект.ДопустимыеКОСГУ.Найти(ИсточникЗначений.НомерСтроки, "НомерСтроки").Наименование = ИсточникЗначений.Наименование;
		Иначе
			Объект.НаименованиеПолное = ИсточникЗначений.Наименование;
		КонецЕсли;
	Иначе
		Объект.НаименованиеПолное = ИсточникЗначений.Наименование;
	КонецЕсли;
	
	Если Характеристики.ЕстьБюджет Тогда
		Объект.Бюджет = ИсточникЗначений.Бюджет;
	КонецЕсли;
	
	Если Характеристики.ЕстьПериодДействия Тогда
		Объект.ДатаНачалаДействия = ИсточникЗначений.ДатаНачалаДействия;
		Объект.ОкончаниеДействия  = ИсточникЗначений.ДатаОкончанияДействия;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьВременнуюТаблицу(Знач МенеджерВременныхТаблиц, Знач Имя)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ВЫБРАТЬ ВременнаяТаблица.* ИЗ %1 КАК ВременнаяТаблица", Имя);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

Функция НачатьИзменениеЭлемента(Знач СсылкаИлиМенеджер)
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(СсылкаИлиМенеджер) Тогда
		Объект = СсылкаИлиМенеджер.ПолучитьОбъект();
	Иначе
		Объект = СсылкаИлиМенеджер.СоздатьЭлемент();
	КонецЕсли;
	
	// Не блокируем объект: считаем, что у нас преимущество перед интерактивными действиями.
	
	Возврат Объект;
	
КонецФункции

Функция ЗакончитьИзменениеЭлемента(Знач Объект)
	
	Если Объект.ЭтоНовый() ИЛИ Объект.Модифицированность() Тогда
		Объект.Записать();
	КонецЕсли;
	
	Возврат Объект.Ссылка;
	
КонецФункции

#КонецОбласти
