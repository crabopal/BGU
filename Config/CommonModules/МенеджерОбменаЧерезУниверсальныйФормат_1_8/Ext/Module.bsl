			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаТЧ, ПравилаЗаполнения);
			
			Если СтруктураДанныхСтроки.Свойство("СтавкаНДСXDTO") Тогда
				СтруктураДанныхСтроки.Вставить("СтавкаНДС", СтавкаНДСПоЗначениюXDTO(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДСXDTO));
