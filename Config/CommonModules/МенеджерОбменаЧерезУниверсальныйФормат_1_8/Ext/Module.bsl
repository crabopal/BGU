		Для Каждого ТекСтрокаОплатыККМ Из ДанныеXDTO.ОплатыККМ Цикл
			Если ТекСтрокаОплатыККМ.ТипОплаты.Значение = "Электронно" Тогда 
				ПолученныеДанные.ФормаОплаты = 1;
				ОплатаПлатежнойКартой = ТекСтрокаОплатыККМ.Сумма;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
			
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ТоварыРаботыУслуги", МассивСтрокТовары);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ОплатаПлатежнойКартой", ОплатаПлатежнойКартой);
КонецПроцедуры
Процедура ПКО_Документ_ЧекККМНаВозврат_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	КассыККМ = КомпонентыОбмена.УзелКорреспондента.КассыККМ; 
	ПроцентКомиссии = 0;
	ВидПлатежнойКарты = Справочники.ВидыПлатежныхКарт.ПустаяСсылка();
	
	ИскомаяСтрока = КассыККМ.Найти(ПолученныеДанные.КассаККМ, "КассаККМ"); 
	ПараметрыДоговораЭквайринга = ?(ИскомаяСтрока <> Неопределено,ИскомаяСтрока.ПараметрыДоговораЭквайринга,Справочники.ПараметрыДоговораЭквайринга.ПустаяСсылка()); 
	
	Если ЗначениеЗаполнено(ПолученныеДанные.КассаККМ) Тогда
		ПолученныеДанные.Организация						= ПолученныеДанные.КассаККМ.Организация;
		ПолученныеДанные.Контрагент							= ПолученныеДанные.КассаККМ.КонтрагентДляРозничныхПродаж;
		ПолученныеДанные.ПараметрыДоговораПлатежногоАгента	= ПараметрыДоговораЭквайринга;
		ПолученныеДанные.СистемаНалогообложенияЧекаККМ		= ПолученныеДанные.КассаККМ.СистемаНалогообложенияЧекаККМ;
		ПолученныеДанные.СуммаВключаетНДС					= ПолученныеДанные.КассаККМ.СуммаВключаетНДС;
		ПолученныеДанные.ТипЦены							= ПолученныеДанные.КассаККМ.ТипЦены;
	КонецЕсли;
	
	ПолученныеДанные.Проведен                           = Истина;
	ПолученныеДанные.Комментарий						= "Загружен из " + КомпонентыОбмена.УзелКорреспондента.Наименование + "\";
	ПолученныеДанные.ПризнакСпособаРасчетаЧекаККМ       = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	ПолученныеДанные.СтатусЧекаККМ						= Перечисления.СтатусыЧековККМ.Пробитый;
	ПолученныеДанные.ТипРасчета							= Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
	ПолученныеДанные.ЭтоРозничныйПокупатель				= Истина;
	
	Для Каждого СтрокаТЧ ИЗ ПолученныеДанные.ТоварыРаботыУслуги Цикл
		СтрокаТЧ.КлючСвязи = 1;
		СтрокаТЧ.ЦенаБезСкидок = СтрокаТЧ.Цена;
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("СуммаВключаетНДС", ПолученныеДанные.КассаККМ.СуммаВключаетНДС);
		ПараметрыРасчета.Вставить("РассчитыватьЦену", Ложь);
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, "СУММАНДС", ПараметрыРасчета);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ОплатаПлатежнойКартой) Тогда
		Отбор = Новый Структура("ОсновнойВид", Истина);
		СтрокиТарифы = ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание.НайтиСтроки(Отбор);
		Если СтрокиТарифы.Количество() > 0 Тогда 
			ВидПлатежнойКарты = СтрокиТарифы[0].ВидПлатежнойКарты;
			ПроцентКомиссии = СтрокиТарифы[0].ПроцентТорговойУступки; 
		КонецЕсли;	
	
		Если ПараметрыДоговораЭквайринга.Терминалы.Количество() > 0 Тогда
			ЭквайринговыйТерминал = ПараметрыДоговораЭквайринга.Терминалы[0].ЭквайринговыйТерминал;
		КонецЕсли;
		
		Оплата = ПолученныеДанные.Оплата.Добавить();	
		Оплата.ТипОплаты					= Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта;
		Оплата.ЭквайринговыйТерминал		= ЭквайринговыйТерминал;
		Оплата.Сумма						= ПолученныеДанные.СуммаДокумента;
		Оплата.ПроцентКомиссии				= ПроцентКомиссии;
		Оплата.СуммаКомиссии				= -(ПолученныеДанные.СуммаДокумента * ПроцентКомиссии / 100);
		Оплата.ДанныеПереданыВБанк			= Истина;
		Оплата.ПараметрыДоговораЭквайринга	= ПараметрыДоговораЭквайринга;
		Оплата.ВидПлатежнойКарты			= ВидПлатежнойКарты;
		Оплата.КлючСвязиОплаты				= 1;
	Иначе
		Оплата = ПолученныеДанные.Оплата.Добавить();	
		Оплата.ТипОплаты					= Перечисления.ТипыОплатЧекаККМ.Наличные;
		Оплата.Сумма						= ПолученныеДанные.СуммаДокумента;
		Оплата.ДанныеПереданыВБанк			= Ложь;
		Оплата.КлючСвязиОплаты				= 1;
	КонецЕсли;
	
	
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заменяем свойства, которые получили из XDTO
	ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	//ТоварыРаботыУслуги
	ДанныеИБ.ТоварыРаботыУслуги.Загрузить(ПолученныеДанные.ТоварыРаботыУслуги.Выгрузить());
	
	//Оплата
	ДанныеИБ.Оплата.Загрузить(ПолученныеДанные.Оплата.Выгрузить());
КонецПроцедуры
Процедура ПКО_Справочник_Валюты_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.СпособУстановкиКурса = Перечисления.СпособыУстановкиКурсаВалюты.РучнойВвод;
КонецПроцедуры
Процедура ПКО_Справочник_Валюты_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ДанныеИБ <> Неопределено
		И ЗначениеЗаполнено(ДанныеИБ.СпособУстановкиКурса) Тогда
		ПолученныеДанные.СпособУстановкиКурса = ДанныеИБ.СпособУстановкиКурса;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ЕдиницыИзмерения_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если НЕ ЗначениеЗаполнено(ДанныеИБ.Код) Тогда
	
		Код = ДанныеИБ.МеждународноеСокращение;
		Если Не ЗначениеЗаполнено(Код) Тогда
			Код = ДанныеИБ.Наименование;
		КонецЕсли;
		
		Код = Лев(Код, 4);
		
		Если СтекВыгрузки.Количество() = 1 Тогда
			ДанныеXDTO.КлючевыеСвойства.Вставить("Код", Код);
		Иначе
			ДанныеXDTO.Вставить("Код", Код);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ЕдиницыИзмерения_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ДанныеДляЗаписиВИБ = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);
КонецПроцедуры
Процедура ПКО_Справочник_Организации_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.Вставить("ЮридическоеФизическоеЛицо", "ЮридическоеЛицо");
КонецПроцедуры
Процедура ПКО_Справочник_ПрейскурантНоменклатура_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ОтправлятьГруппыПрейскурант = КомпонентыОбмена.ПараметрыКонвертации.ОтправлятьГруппыПрейскурант;
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДанныеИБ.ЭтоГруппа Тогда
		Если ЗначениеЗаполнено(ДанныеИБ.Номенклатура.НаименованиеДляЧекаККМ) Тогда
			ДанныеXDTO.КлючевыеСвойства.Наименование = ДанныеИБ.Номенклатура.НаименованиеДляЧекаККМ;
		КонецЕсли;
		Если РозничныеПродажиБГУ.ТипНоменклатуры(ДанныеИБ.Номенклатура) = 3 Тогда
			ДанныеXDTO.Вставить("ТипНоменклатуры",	"Товар");
		Иначе
			ДанныеXDTO.Вставить("ТипНоменклатуры",	"Услуга");
		КонецЕсли;
		ДанныеXDTO.Вставить("ЕдиницаИзмерения",			ДанныеИБ.Номенклатура.ЕдиницаИзмерения);
	    
	    СтавкаНДСНоменклатуры = ДанныеИБ.Номенклатура.СтавкаНДС;
		ДанныеXDTO.Вставить("СтавкаНДС", СтавкаНДСВXDTO(СтавкаНДСНоменклатуры, КомпонентыОбмена));
	
		Если ОтправлятьГруппыПрейскурант Тогда 
			ДанныеXDTO.КлючевыеСвойства.Вставить("Группа", ДанныеИБ.Родитель);
		КонецЕсли; 
	Иначе	
		ДанныеXDTO.Вставить("ТипНоменклатуры", "");
		ДанныеXDTO.Вставить("НаименованиеПолное", "");
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ШтрихкодыНоменклатуры_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Штрихкоды = Новый ТаблицаЗначений;
	Штрихкоды.Колонки.Добавить("Номенклатура");
	Штрихкоды.Колонки.Добавить("Штрихкод");
	
	СтрокаШК = Штрихкоды.Добавить();
	СтрокаШК.Штрихкод		= ДанныеXDTO.Штрихкод;
	СтрокаШК.Номенклатура	= ДанныеXDTO.НоменклатураОтбор;
			
	ДанныеXDTO.Вставить("Записи", Штрихкоды);
КонецПроцедуры
Процедура ПКО_Справочник_ИнформативныеОстатки_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.КлючевыеСвойства.Склад = ДанныеИБ.Склад;
	
	ДанныеXDTO.Вставить("Организация",			ДанныеИБ.Организация);
	ДанныеXDTO.Вставить("Дата",					ДанныеИБ.Дата);
	ДанныеXDTO.Вставить("Товары",				ДанныеИБ.Товары);
	ДанныеXDTO.Вставить("Комментарий",			ДанныеИБ.Комментарий);
КонецПроцедуры
Процедура ПКО_Справочник_СтавкиНДС_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.КлючевыеСвойства.Вставить("ВидСтавки", ВидыСтавокНДСXDTO(ДанныеИБ));
	ДанныеXDTO.КлючевыеСвойства.Вставить("Страна",  Справочники.СтраныМира.Россия);
	ДанныеXDTO.КлючевыеСвойства.Вставить("НеОблагается",  ДанныеИБ = Перечисления.СтавкиНДС.БезНДС);
	ДанныеXDTO.КлючевыеСвойства.Вставить("РасчетнаяСтавка",  ЭтоРасчетнаяСтавкаНДС(ДанныеИБ));
	ДанныеXDTO.КлючевыеСвойства.Вставить("Ставка",  УчетНДСКлиентСервер.ЗначениеСтавкиНДС(ДанныеИБ));
КонецПроцедуры
Процедура ПКО_Справочник_СтраныМира_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ДанныеИБ = Неопределено
		И ЗначениеЗаполнено(ПолученныеДанные.Код) Тогда
		
		ДанныеСтраны = УправлениеКонтактнойИнформацией.ДанныеКлассификатораСтранМираПоКоду(ПолученныеДанные.Код);
		Если ДанныеСтраны <> Неопределено Тогда
			ПолученныеДанные.УчастникЕАЭС = ДанныеСтраны.УчастникЕАЭС;
			ЗаполнитьРеквизитыИзДанныхИБ(ПолученныеДанные, ДанныеСтраны, "Наименование,НаименованиеПолное,КодАльфа2,КодАльфа3,МеждународноеНаименование");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заменяем свойства, которые получили из XDTO.
	ЗаполнитьНеПустыеСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	ПолученныеДанные = Неопределено;
КонецПроцедуры

#КонецОбласти
#Область Алгоритмы

Функция ВерсияФорматаЧислом(СтрокаВерсии)
	Если Не ЗначениеЗаполнено(СтрокаВерсии) Или СтрокаВерсии = "1.0.beta" Тогда
		Возврат 0;
	КонецЕсли;
	
	ВерсияФорматаЧислом = 0;
	
	РазрядыВерсии = СтрРазделить(СтрокаВерсии, ".");
	Если РазрядыВерсии.Количество() <> 2 Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Неправильный формат параметра СтрокаВерсии1: %1'"), СтрокаВерсии);
	КонецЕсли;
	
	МножительРазряда = 10000;
	Для ИндексРазрядаОбратный = 0 По 1 Цикл
		ВерсияФорматаЧислом = ВерсияФорматаЧислом + Число(РазрядыВерсии[ИндексРазрядаОбратный])*МножительРазряда;
		МножительРазряда = МножительРазряда / 100;
	КонецЦикла;
	Возврат ВерсияФорматаЧислом;
КонецФункции
Функция ВидСтавкиНДСXDTO(СтавкаНДС)
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда
		Возврат Перечисления.ВидыСтавокНДС.Общая;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		Возврат Перечисления.ВидыСтавокНДС.Общая;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда
		Возврат Перечисления.ВидыСтавокНДС.Общая;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		Возврат Перечисления.ВидыСтавокНДС.Общая;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда
		Возврат Перечисления.ВидыСтавокНДС.БезНДС;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
		Возврат Перечисления.ВидыСтавокНДС.БезНДС;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		Возврат Перечисления.ВидыСтавокНДС.Общая;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		Возврат Перечисления.ВидыСтавокНДС.Общая;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
		Возврат Перечисления.ВидыСтавокНДС.Общая;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22_122 Тогда
		Возврат Перечисления.ВидыСтавокНДС.Общая;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7 Тогда
		Возврат Перечисления.ВидыСтавокНДС.ОбщаяУСН;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
		Возврат Перечисления.ВидыСтавокНДС.ПониженнаяУСН;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7_107 Тогда
		Возврат Перечисления.ВидыСтавокНДС.ОбщаяУСН;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5_105 Тогда
		Возврат Перечисления.ВидыСтавокНДС.ПониженнаяУСН;
	Иначе
		Возврат Перечисления.ВидыСтавокНДС.ПустаяСсылка();
	КонецЕсли;
КонецФункции
Функция ВидыСтавокНДСXDTO(СтавкаНДС)
	ВидСтавкиНДС = ВидСтавкиНДСXDTO(СтавкаНДС);
	
	Если ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Общая
		Или ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.ОбщаяУСН
		Или ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.ПониженнаяУСН Тогда
		Возврат "Общая";
	ИначеЕсли  ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.БезНДС Тогда
		Возврат "БезНДС";
	КонецЕсли;
	
	Возврат "Общая";
КонецФункции
Процедура ВыгрузитьИнформативныеОстатки(КомпонентыОбмена) Экспорт
	ПравилоОбработки = КомпонентыОбмена.ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя = "Справочник_ИнформативныеОстатки_Отправка";
	ПравилоОбработки.ОчисткаДанных = Ложь;
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Справочник_ИнформативныеОстатки_Отправка");
	
	ТЗ_Товары = Новый ТаблицаЗначений;
	ТЗ_Товары.Колонки.Добавить("Номенклатура");
	ТЗ_Товары.Колонки.Добавить("КоличествоНаСкладе");
	
	МассивЦМО = КомпонентыОбмена.ПараметрыКонвертации.МассивЦМО;
	
	МассивВыборки = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаВводаОстатков",	Новый Граница(ТекущаяДатаСеанса(), ВидГраницы.Включая));
	Запрос.Текст = "ВЫБРАТЬ
	               |	Прейскурант.Ссылка КАК Номенклатура,
	               |	СУММА(ТоварыВТорговыхТочкахОстатки.КоличествоОстаток) КАК КоличествоНаСкладе,
	               |	ТоварыВТорговыхТочкахОстатки.Организация КАК Организация,
	               |	ТоварыВТорговыхТочкахОстатки.ЦМО.МестоХранения КАК МестоХранения
	               |ИЗ
	               |	РегистрНакопления.ТоварыВТорговыхТочках.Остатки(%ПараметрыВТ%) КАК ТоварыВТорговыхТочкахОстатки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Прейскурант КАК Прейскурант
	               |		ПО ТоварыВТорговыхТочкахОстатки.Номенклатура = Прейскурант.Номенклатура
	               |			И ТоварыВТорговыхТочкахОстатки.Организация = Прейскурант.Организация
	               |ГДЕ
	               |	НЕ Прейскурант.СнятаСПродажи
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТоварыВТорговыхТочкахОстатки.Организация,
	               |	ТоварыВТорговыхТочкахОстатки.ЦМО.МестоХранения,
	               |	Прейскурант.Ссылка
	               |ИТОГИ ПО
	               |	Организация,
	               |	МестоХранения";
	
	Если ЗначениеЗаполнено(МассивЦМО) Тогда
		Запрос.УстановитьПараметр("МассивЦМО", МассивЦМО);
		ПараметрыВТ = "&ДатаВводаОстатков, ЦМО В (&МассивЦМО)";
	Иначе
		ПараметрыВТ = "&ДатаВводаОстатков";
	КонецЕсли;
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ПараметрыВТ%", ПараметрыВТ);
		
	ВыборкаПоОрг = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	Пока ВыборкаПоОрг.Следующий() Цикл
		
		ВыборкаПоМестХранения = ВыборкаПоОрг.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПоМестХранения.Следующий() Цикл
			
			Склад = ВыборкаПоМестХранения.МестоХранения;
			
			Если Не ЗначениеЗаполнено(Склад) Тогда
				Продолжить;
			КонецЕсли;
				
			ВыборкаДетальная = ВыборкаПоМестХранения.Выбрать();
			
			Пока ВыборкаДетальная.Следующий() Цикл
				
				НоваяСтрока = ТЗ_Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальная);
				
			КонецЦикла;
			
			ДанныеИБ = Новый Структура();
			ДанныеИБ.Вставить("Дата",			ТекущаяДатаСеанса());
			ДанныеИБ.Вставить("Организация",	ВыборкаПоМестХранения.Организация);
			ДанныеИБ.Вставить("Склад",			Склад);
			ДанныеИБ.Вставить("Товары",			ТЗ_Товары);
			
			Если ТЗ_Товары.Количество() Тогда
				ДанныеИБ.Вставить("Комментарий",	Неопределено);
			Иначе
				ДанныеИБ.Вставить("Комментарий",	"ОчиститьТабличнуюЧастьТовары");
			КонецЕсли;
			
			ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, ДанныеИБ, ПравилоОбработки);
	
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры
Процедура ВыгрузитьОстатки(КомпонентыОбмена) Экспорт
	ДатаВводаОстатков	= НачалоДня(КомпонентыОбмена.ПараметрыКонвертации.ДатаНачалаВыгрузкиДокументов)-1;
	МассивЦМО			= КомпонентыОбмена.ПараметрыКонвертации.МассивЦМО;
	ТипЦены				= КомпонентыОбмена.ПараметрыКонвертации.ТипЦены;
	
	МассивВыборки = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаВводаОстатков",	Новый Граница(ДатаВводаОстатков, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ТипЦены",			ТипЦены);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Прейскурант.Ссылка КАК Номенклатура,
	               |	ТоварыВТорговыхТочкахОстатки.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ТоварыВТорговыхТочкахОстатки.КоличествоОстаток КАК Количество,
	               |	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
	               |	ТоварыВТорговыхТочкахОстатки.КоличествоОстаток * ЦеныНоменклатурыСрезПоследних.Цена КАК Сумма,
	               |	ТоварыВТорговыхТочкахОстатки.Организация КАК Организация
	               |ИЗ
	               |	РегистрНакопления.ТоварыВТорговыхТочках.Остатки(%ПараметрыВТ%) КАК ТоварыВТорговыхТочкахОстатки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Прейскурант КАК Прейскурант
	               |		ПО ТоварыВТорговыхТочкахОстатки.Номенклатура = Прейскурант.Номенклатура
	               |			И ТоварыВТорговыхТочкахОстатки.Организация = Прейскурант.Организация
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаВводаОстатков, ТипЦен = &ТипЦены) КАК ЦеныНоменклатурыСрезПоследних
	               |		ПО ТоварыВТорговыхТочкахОстатки.Организация = ЦеныНоменклатурыСрезПоследних.Организация
	               |			И ТоварыВТорговыхТочкахОстатки.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	               |ГДЕ
	               |	НЕ Прейскурант.СнятаСПродажи";
	
	Если ЗначениеЗаполнено(МассивЦМО) Тогда
		Запрос.УстановитьПараметр("МассивЦМО", МассивЦМО);
		ПараметрыВТ = "&ДатаВводаОстатков, ЦМО В (&МассивЦМО)";
	Иначе
		ПараметрыВТ = "&ДатаВводаОстатков";
	КонецЕсли;
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ПараметрыВТ%", ПараметрыВТ);
		
	ТЗ_Товары = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ_Товары.Количество() > 0 Тогда
		
		Организация = ТЗ_Товары[0].Организация;	
		Контрагент = Новый Структура("Наименование, ИНН, КПП, ЮридическоеФизическоеЛицо", Организация.Наименование, Организация.ИНН, Организация.КПП, "ЮридическоеЛицо");
		
		ДанныеИБ = Новый Структура("Дата, Номер, Организация, Контрагент, Сумма, Товары");
		ДанныеИБ.Дата			= ДатаВводаОстатков;
		ДанныеИБ.Номер			= Формат(1, "ЧГ=");
		ДанныеИБ.Организация	= Организация;
		ДанныеИБ.Контрагент		= Контрагент;
		ДанныеИБ.Сумма			= ТЗ_Товары.Итог("Сумма");
		ДанныеИБ.Товары			= ТЗ_Товары;
		
		
		ДанныеИБ.Вставить("ДополнительныеСвойства", Новый Структура);
		
		ПравилоОбработки = КомпонентыОбмена.ПравилаОбработкиДанных.Добавить();
		ПравилоОбработки.Имя = "Документ_ОстаткиТоварыВТорговыхТочках_Отправка";
		ПравилоОбработки.ОчисткаДанных = Ложь;
		ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ОстаткиТоварыВТорговыхТочках_Отправка");
			
		ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, ДанныеИБ, ПравилоОбработки);
	КонецЕсли;
КонецПроцедуры
Функция ДанныеКоллекцииВВидеСтруктуры(Источник, ПравилаЗаполнения)
	Результат = Новый Структура;
	
	Для Каждого ПравилоЗаполнения Из ПравилаЗаполнения Цикл
	
		СтруктураДляПереносаЗначения = Новый Структура(ПравилоЗаполнения.Ключ, Неопределено);
		ЗаполнитьЗначенияСвойств(СтруктураДляПереносаЗначения, Источник);
		
		Значение = СтруктураДляПереносаЗначения[ПравилоЗаполнения.Ключ];
		Если Значение <> Неопределено Тогда
			Результат.Вставить(ПравилоЗаполнения.Значение, Значение);
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Результат
КонецФункции
Процедура ЗаполнитьЗначенияСтавокНДС(КомпонентыОбмена)
	ЗначенияСтавокНДС = Новый ТаблицаЗначений;
	ЗначенияСтавокНДС.Колонки.Добавить("СтавкаНДС", Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ЗначенияСтавокНДС.Колонки.Добавить("Ставка", Новый ОписаниеТипов("Число"));
	ЗначенияСтавокНДС.Колонки.Добавить("РасчетнаяСтавка", Новый ОписаниеТипов("Булево"));
	
	Для Каждого МетаданныеПеречисления Из Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления Цикл
		                      
		СтрокаСтавки = ЗначенияСтавокНДС.Добавить();
		СтрокаСтавки.СтавкаНДС = Перечисления.СтавкиНДС[МетаданныеПеречисления.Имя];
		СтрокаСтавки.Ставка = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтрокаСтавки.СтавкаНДС);
		СтрокаСтавки.РасчетнаяСтавка = ЭтоРасчетнаяСтавкаНДС(СтрокаСтавки.СтавкаНДС);
	
	КонецЦикла;
	
	КомпонентыОбмена.ПараметрыКонвертации.ЗначенияСтавокНДС = ЗначенияСтавокНДС;
КонецПроцедуры
Процедура ЗаполнитьНеПустыеСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ, МассивИсключений = Неопределено)
	Для Каждого СвойствоОбъекта Из КонвертацияСвойств Цикл
		СвойствоИБ = СвойствоОбъекта.СвойствоКонфигурации;
		Если СокрЛП(СвойствоИБ) = "" Тогда
			Продолжить;
		КонецЕсли;
		Если МассивИсключений <> Неопределено И МассивИсключений.Найти(СвойствоИБ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПолученныеДанные[СвойствоИБ]) Тогда
			ДанныеИБ[СвойствоИБ] = ПолученныеДанные[СвойствоИБ];
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьРеквизитыИзДанныхИБ(ПолученныеДанные, ДанныеИБ, СтрокаРеквизиты)
	Реквизиты = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаРеквизиты, ",", Истина, Истина);
	Для Каждого Реквизит Из Реквизиты Цикл
		ЗначенияПриемник = Новый Структура(Реквизит);
		ЗаполнитьЗначенияСвойств(ЗначенияПриемник, ПолученныеДанные);
		
		ЗначенияИсточник = Новый Структура(Реквизит);
		ЗаполнитьЗначенияСвойств(ЗначенияИсточник, ДанныеИБ);
		
		Если Не ЗначениеЗаполнено(ЗначенияПриемник[Реквизит])
			И ЗначениеЗаполнено(ЗначенияИсточник[Реквизит]) Тогда
			ЗаполнитьЗначенияСвойств(ПолученныеДанные, ЗначенияИсточник);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ, МассивИсключений = Неопределено)
	Для Каждого СвойствоОбъекта Из КонвертацияСвойств Цикл
		СвойствоИБ = СвойствоОбъекта.СвойствоКонфигурации;
		Если СокрЛП(СвойствоИБ) = "" Тогда
			Продолжить;
		КонецЕсли;
		Если МассивИсключений <> Неопределено И МассивИсключений.Найти(СвойствоИБ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДанныеИБ[СвойствоИБ] = ПолученныеДанные[СвойствоИБ];
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(ТабличнаяЧастьОбъектаПослеОбработки, ТабличнаяЧастьОбъектаДоОбработки, КлючевыеПоля = "", КолонкиДляВключения = "", КолонкиДляИсключения = "")
	ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
		ТабличнаяЧастьОбъектаПослеОбработки, 
		ТабличнаяЧастьОбъектаДоОбработки,
		КлючевыеПоля, 
		КолонкиДляВключения, 
		КолонкиДляИсключения);
КонецПроцедуры
Функция ЗначениеИзСвойствXDTO(ДанныеXDTO, ИмяСвойства, ЗначениеПоУмолчанию)
	Если Не ДанныеXDTO.Свойство(ИмяСвойства)
		Или Не ЗначениеЗаполнено(ДанныеXDTO[ИмяСвойства]) Тогда
		Возврат ЗначениеПоУмолчанию; 
	КонецЕсли;
	
	Возврат ДанныеXDTO[ИмяСвойства];
КонецФункции
Функция ЗначениеСтавкиНДСПоXDTO(КомпонентыОбмена, СтавкаНДСXDTO)
	Если Не ЗначениеЗаполнено(СтавкаНДСXDTO) Тогда
		Возврат Перечисления.СтавкиНДС.ПустаяСсылка();
	КонецЕсли; 
	
	Ставка = ЗначениеИзСвойствXDTO(СтавкаНДСXDTO, "Ставка", 0);
	РасчетнаяСтавка = ЗначениеИзСвойствXDTO(СтавкаНДСXDTO, "РасчетнаяСтавка", Ложь);
	НеОблагается = ЗначениеИзСвойствXDTO(СтавкаНДСXDTO, "НеОблагается", Ложь);
	
	Если Не ЗначениеЗаполнено(Ставка) Тогда
		Возврат ?(НеОблагается, Перечисления.СтавкиНДС.БезНДС, Перечисления.СтавкиНДС.НДС0);
	КонецЕсли;  
	
	ЗначенияСтавокНДС = КомпонентыОбмена.ПараметрыКонвертации.ЗначенияСтавокНДС;
	
	ОтборСтавок = Новый Структура();
	ОтборСтавок.Вставить("Ставка", Ставка);
	ОтборСтавок.Вставить("РасчетнаяСтавка", РасчетнаяСтавка);
	
	ПодходящиеСтавки = ЗначенияСтавокНДС.НайтиСтроки(ОтборСтавок);
	
	Если Не ЗначениеЗаполнено(ПодходящиеСтавки) Тогда
		Возврат Перечисления.СтавкиНДС.ПустаяСсылка();
	Иначе
		Возврат ПодходящиеСтавки[0].СтавкаНДС;
	КонецЕсли;
КонецФункции
Процедура ОтложеннаяОбработка_ЧекККМ(Объект, ПараметрыКонвертации, ОбъектМодифицирован)
	ВсегоОплачено = Объект.Оплата[0].Сумма;
	ВсегоКомиссияБанка = Объект.Оплата[0].СуммаКомиссии;
	ПроцентБанка = Объект.Оплата[0].ПроцентКомиссии; 
	Для каждого ТекТоварУслуга Из Объект.ТоварыРаботыУслуги Цикл
		Если ВсегоОплачено = 0 Тогда 
			Прервать;
		КонецЕсли;
		
		НоваяСтрока = Объект.РасшифровкаОплаты.Добавить();
		НоваяСтрока.КлючСвязиОплаты = 1;
		НоваяСтрока.СтатьяАналитикиОплаты = ТекТоварУслуга.Номенклатура.ОсновнаяСтатьяАналитикиОплаты;
		
		ПолноеПогашение = Истина;
		Если ВсегоОплачено < ТекТоварУслуга.Всего Тогда
			ПолноеПогашение = Ложь;
		КонецЕсли;	
		
		НоваяСтрока.Сумма = ?(ПолноеПогашение, ТекТоварУслуга.Всего, ВсегоОплачено);
		Если ВсегоКомиссияБанка > 0 Тогда
			НоваяСтрока.СуммаКомиссии = Окр(НоваяСтрока.Сумма * ПроцентБанка / 100, 2);	
			
			Если НЕ ПолноеПогашение Тогда
				НоваяСтрока.СуммаКомиссии = ВсегоКомиссияБанка;
			КонецЕсли;	
			
			ВсегоКомиссияБанка = ВсегоКомиссияБанка - НоваяСтрока.СуммаКомиссии;
		Конецесли;	
		
		ВсегоОплачено = ВсегоОплачено - НоваяСтрока.Сумма;
	КонецЦикла;
КонецПроцедуры
Функция СтавкаНДСВXDTO(СтавкаНДС, КомпонентыОбмена)
	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураПКО = Новый Структура;
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17") Тогда
		ИмяПКО = "Перечисление_СтавкиНДС";
	Иначе
		ИмяПКО = "Справочник_СтавкиНДС_Отправка";
	КонецЕсли;
	    
	СтруктураПКО.Вставить("ИмяПКО", ИмяПКО);
	СтруктураПКО.Вставить("Значение", СтавкаНДС);
	
	Возврат СтруктураПКО;
КонецФункции
Функция СтавкаНДСПоЗначениюXDTO(КомпонентыОбмена, СтавкаНДСXDTO)
	Если Не ЗначениеЗаполнено(СтавкаНДСXDTO) Тогда
		Возврат Перечисления.СтавкиНДС.ПустаяСсылка();
	КонецЕсли;   
	
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) < ВерсияФорматаЧислом("1.17") Тогда
		
		ПКПД_СтавкиНДС = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти("Перечисление_СтавкиНДС", "ИмяПКПД");
		Возврат ПКПД_СтавкиНДС.КонвертацииЗначенийПриПолучении.Получить(СтавкаНДСXDTO.Значение);
	
	Иначе
	
		Возврат ЗначениеСтавкиНДСПоXDTO(КомпонентыОбмена, СтавкаНДСXDTO);
			
	КонецЕсли;
КонецФункции
Функция ЭтоРасчетнаяСтавкаНДС(СтавкаНДС)
	Если ТипЗнч(СтавкаНДС) <> Тип("ПеречислениеСсылка.СтавкиНДС")
		Или Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118
		Или СтавкаНДС = Перечисления.СтавкиНДС.НДС5_105
		Или СтавкаНДС = Перечисления.СтавкиНДС.НДС7_107
		Или СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110
		Или СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120
		Или СтавкаНДС = Перечисления.СтавкиНДС.НДС22_122;
КонецФункции

#КонецОбласти
#КонецОбласти
