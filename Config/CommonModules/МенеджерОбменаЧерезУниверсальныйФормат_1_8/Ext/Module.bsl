Функция ДобавитьПКТЧ(ПравилоКонвертации, ИмяТЧКонфигурации, ИмяТЧФормата, ПространствоИмен = "")
	
	Если ПравилоКонвертации.СвойстваТабличныхЧастей.Колонки.Количество() = 0 Тогда
		ОбменДаннымиXDTOСервер.ИнициализироватьСвойстваТабличныхЧастей(ПравилоКонвертации);
	КонецЕсли;
	
	КонвертацияТабличнойЧасти                = ПравилоКонвертации.СвойстваТабличныхЧастей.Добавить();
	КонвертацияТабличнойЧасти.ТЧКонфигурации = ИмяТЧКонфигурации;
	КонвертацияТабличнойЧасти.ТЧФормата      = ИмяТЧФормата;
	КонвертацияТабличнойЧасти.Свойства       = ОбменДаннымиXDTOСервер.ИнициализироватьТаблицуСвойствДляПравилаКонвертации();
	КонвертацияТабличнойЧасти.ПространствоИмен = ПространствоИмен;
	Возврат КонвертацияТабличнойЧасти.Свойства;
КонецФункции

Процедура ДобавитьПКС(РодительПКС, СвойствоКонфигурации, СвойствоФормата, ИспользуетсяАлгоритмКонвертации = 0, 
		ПравилоКонвертацииСвойства = "", ПространствоИмен = "")
	НоваяСтрока                                 = РодительПКС.Добавить();
	НоваяСтрока.СвойствоКонфигурации            = СвойствоКонфигурации;
	НоваяСтрока.СвойствоФормата                 = СвойствоФормата;
	НоваяСтрока.ИспользуетсяАлгоритмКонвертации = ?(ИспользуетсяАлгоритмКонвертации = 0, Ложь, Истина);
	НоваяСтрока.ПравилоКонвертацииСвойства      = ПравилоКонвертацииСвойства;
	НоваяСтрока.ПространствоИмен                = ПространствоИмен;
КонецПроцедуры

#Область ОбработчикиКонвертации
Процедура ПОД_Документ_ОтчетОРозничныхПродажах_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	ИспользованиеПКО.Документ_ОтчетОРозничныхПродажах_Получение = КомпонентыОбмена.УзелКорреспондента.ВыгружатьЧекиКакОтчетОРозничныхПродажах;
КонецПроцедуры
Процедура ПОД_Документ_ЧекККМ_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	ЗагрузитьОбъект = Истина;
	ИспользованиеПКО.Документ_ЧекККМ_Получение = Ложь;
	ИспользованиеПКО.Документ_ЧекККМНаВозврат_Получение = Ложь;
	
	Если ДанныеXDTO.Свойство("Отменен") Тогда
		Если ДанныеXDTO.Отменен Или КомпонентыОбмена.УзелКорреспондента.ВыгружатьЧекиКакОтчетОРозничныхПродажах Тогда
			ЗагрузитьОбъект = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ТоварыПродажа") Или ДанныеXDTO.Свойство("Услуги") Тогда
		ИспользованиеПКО.Документ_ЧекККМ_Получение = ЗагрузитьОбъект;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ТоварыВозвратПродажи") Тогда
		ИспользованиеПКО.Документ_ЧекККМНаВозврат_Получение = ЗагрузитьОбъект;
	КонецЕсли;
КонецПроцедуры
Процедура ПОД_Справочник_Номенклатура_Отправка_ПриОбработке(ДанныеИБ, ИспользованиеПКО, КомпонентыОбмена)
	ИспользованиеПКО.Справочник_ПрейскурантНоменклатура_Отправка = Ложь;
	ИспользованиеПКО.Справочник_НоменклатураГруппа = Ложь;
	ИспользованиеПКО.Справочник_ШтрихкодыНоменклатуры_Отправка = Ложь;
	
	Если Не ДанныеИБ.ЭтоГруппа Тогда
		ИспользованиеПКО.Справочник_ПрейскурантНоменклатура_Отправка = Истина;
		Если ЗначениеЗаполнено(ДанныеИБ.Штрихкод) Тогда
			ИспользованиеПКО.Справочник_ШтрихкодыНоменклатуры_Отправка = Истина;
		КонецЕсли;
	Иначе
		ИспользованиеПКО.Справочник_НоменклатураГруппа = Истина;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Документ_АктПриемкиМ7_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
					|	Прейскурант.Ссылка КАК Номенклатура,
					|	ВЫБОР КОГДА АктПриемкиМ7Материалы.Количество = 0 ТОГДА
					|		1
					|	ИНАЧЕ
					|		АктПриемкиМ7Материалы.Количество
					|	КОНЕЦ КАК Количество,
					|	АктПриемкиМ7Материалы.Цена КАК Цена,
					|	АктПриемкиМ7Материалы.Сумма КАК Сумма,
					|	АктПриемкиМ7Материалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения
					|ИЗ
					|	Справочник.Прейскурант КАК Прейскурант
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктПриемкиМ7.Материалы КАК АктПриемкиМ7Материалы
					|		ПО (АктПриемкиМ7Материалы.Номенклатура = Прейскурант.Номенклатура)
					|			И (АктПриемкиМ7Материалы.Ссылка.Организация = Прейскурант.Организация)
					|ГДЕ
					|	АктПриемкиМ7Материалы.Ссылка = &Ссылка
					|	И НЕ Прейскурант.СнятаСПродажи";
	
	Запрос.УстановитьПараметр("Ссылка", ДанныеИБ.Ссылка);
	
	Товары = Запрос.Выполнить().Выгрузить(); 
	
	ДанныеXDTO.Вставить("ВидОперации",			"ПокупкаУПоставщика");
	ДанныеXDTO.Вставить("Валюта",				Валюта);
	ДанныеXDTO.Вставить("ВалютаВзаиморасчетов", Валюта);
	ДанныеXDTO.Вставить("Товары",				Товары);
	
	ДанныеИБ.ДополнительныеСвойства.Вставить("ИННОрганизации", ДанныеИБ.Организация.ИНН);
КонецПроцедуры
Процедура ПКО_Документ_ОстаткиТоварыВТорговыхТочках_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ДанныеXDTO.Вставить("ВидОперации",			"ПокупкаУПоставщика");
	ДанныеXDTO.Вставить("Валюта",				Валюта);
	ДанныеXDTO.Вставить("ВалютаВзаиморасчетов", Валюта);
