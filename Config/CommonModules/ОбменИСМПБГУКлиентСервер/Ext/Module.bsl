
#Область ПрограммныйИнтерфейс

Функция НовыеПараметрыВыводаИзОборотаКодовМаркировки() Экспорт
	
	ПараметрыВыводаИзОборота = Новый Структура;
	
	ПараметрыВыводаИзОборота.Вставить("Организация", Неопределено);
	ПараметрыВыводаИзОборота.Вставить("АдресОрганизации", "");
	ПараметрыВыводаИзОборота.Вставить("ИННОрганизации", "");
	ПараметрыВыводаИзОборота.Вставить("ИННПокупателя", "");
	ПараметрыВыводаИзОборота.Вставить("КППТорговойТочки", "");
	ПараметрыВыводаИзОборота.Вставить("ИдентификаторФИАС", "");
	ПараметрыВыводаИзОборота.Вставить("ЭтоТабачнаяПродукция", Ложь);
	ПараметрыВыводаИзОборота.Вставить("ЭтоОСУ", Ложь);
	ПараметрыВыводаИзОборота.Вставить("ЭтоФасовка", Ложь);
	ПараметрыВыводаИзОборота.Вставить("ТоварнаяГруппа", Неопределено);
	ПараметрыВыводаИзОборота.Вставить("Причина", "");
	ПараметрыВыводаИзОборота.Вставить("ДатаДокумента", '00010101');
	ПараметрыВыводаИзОборота.Вставить("НомерДокумента", "");
	ПараметрыВыводаИзОборота.Вставить("КодыМаркировки", Новый Массив);
	ПараметрыВыводаИзОборота.Вставить("Товары", Новый Массив);
	
	ПараметрыВыводаИзОборота.Вставить("ТелоДокумента", "");
	ПараметрыВыводаИзОборота.Вставить("ПодписьДокумента", "");
	
	Возврат ПараметрыВыводаИзОборота;
	
КонецФункции

Функция НовыеПараметрыТовара() Экспорт
	
	ПараметрыТовара = Новый Структура;
	
	ПараметрыТовара.Вставить("Штрихкод"		, "");
	ПараметрыТовара.Вставить("Количество"	, 0); 
	ПараметрыТовара.Вставить("Вес"			, 0);
	
	Возврат ПараметрыТовара;
	
КонецФункции

Функция НовыеПараметрыКодаМаркировки() Экспорт
	
	ПараметрыКодаМаркировки = Новый Структура;
	
	ПараметрыКодаМаркировки.Вставить("Штрихкод", "");
	ПараметрыКодаМаркировки.Вставить("Цена", 0);
	
	Возврат ПараметрыКодаМаркировки;
	
КонецФункции

Функция НовыйРезультатОперацииСервиса() Экспорт
	
	РезультатОперации = Новый Структура;
	
	РезультатОперации.Вставить("ОперацияВыполнялась",                Ложь);
	РезультатОперации.Вставить("ОперацияВыполненаУспешно",           Ложь);
	РезультатОперации.Вставить("ОперацияВыполненаСВременнойОшибкой", Ложь);
	РезультатОперации.Вставить("ТребуетсяОбновлениеКлючаСессии",     Ложь);
	РезультатОперации.Вставить("ПараметрыОбновленияКлючаСессии",     Неопределено);
	РезультатОперации.Вставить("ТребуетсяПодписание",                Ложь);
	РезультатОперации.Вставить("ПараметрыПодписания",                Неопределено);
	РезультатОперации.Вставить("РазобранныйОтвет",                   Неопределено);
	РезультатОперации.Вставить("ТекстСообщения",                     "");
	
	Возврат РезультатОперации;
	
КонецФункции

Функция НовыеПараметрыОперацииСервиса() Экспорт
	
	ПараметрыОперации = Новый Структура;
	
	ПараметрыОперации.Вставить("НаименованиеОперации", "");
	ПараметрыОперации.Вставить("ИсходныеДанные",       Неопределено);
	ПараметрыОперации.Вставить("Организация",          Неопределено);
	
	Возврат ПараметрыОперации;
	
КонецФункции

Функция НовыйРезультатОбработкиОшибкиОперацииСервиса() Экспорт
	
	РезультатОбработкиОшибки = Новый Структура;
	
	РезультатОбработкиОшибки.Вставить("КлючСессииУстановлен", Ложь);
	РезультатОбработкиОшибки.Вставить("ПодписаниеУспешно",    Ложь);
	РезультатОбработкиОшибки.Вставить("ПодписанныйДокумент",  "");
	РезультатОбработкиОшибки.Вставить("ТекстОшибки",          "");
	
	Возврат РезультатОбработкиОшибки;
	
КонецФункции

Функция НовыеПараметрыЗапросаСодержимогоДокумента() Экспорт
	
	ПараметрыЗапросаДанных = Новый Структура;
	
	ПараметрыЗапросаДанных.Вставить("Организация", Неопределено);
	ПараметрыЗапросаДанных.Вставить("Идентификатор", Неопределено);
	
	Возврат ПараметрыЗапросаДанных;
	
КонецФункции

Функция НаименованиеОперацииСодержимоеДокумента() Экспорт
	
	Возврат "СодержимоеДокумента";
	
КонецФункции

Функция НаименованиеОперацииВыводИзОборотаКодовМаркировки() Экспорт
	
	Возврат "ВыводИзОборотаКодовМаркировки";
	
КонецФункции

Функция ДвоичныеДанныеBase64(ИсходныеДанные) Экспорт
	
	Base64 = Base64Строка(ИсходныеДанные);
	Base64 = СтрЗаменить(Base64, Символы.ПС, "");
	Base64 = СтрЗаменить(Base64, Символы.ВК, "");
	
	Возврат Base64;
	
КонецФункции

Функция ЗапросВыполненУспешно(ДанныеЗапроса) Экспорт
	
	Возврат ДанныеЗапроса.ОтветПолучен И ДанныеЗапроса.КодСостояния = 200;
	
КонецФункции

Функция ДокументСозданУспешно(ДанныеЗапроса) Экспорт
	
	Возврат ДанныеЗапроса.ОтветПолучен И (ДанныеЗапроса.КодСостояния = 200 Или ДанныеЗапроса.КодСостояния = 201);
	
КонецФункции

Функция ПараметрыСтрокиИзКодаИСМП(КодИСМП) Экспорт 
	
	Если СтрДлина(КодИСМП) >= 19 И СтрДлина(КодИСМП) <= 23 Тогда                     
		Количество 	= Число(Сред(КодИСМП, 19, СтрДлина(КодИСМП) - 18));
		КодИСМП 	= Сред(КодИСМП, 3, 14);  
	Иначе
		Количество = 1;
	КонецЕсли;

	ПараметрыСтроки = Новый Структура;
	ПараметрыСтроки.Вставить("Количество"	, Количество);
	ПараметрыСтроки.Вставить("КодИСМП"		, КодИСМП);
	Возврат ПараметрыСтроки;
	
КонецФункции

#КонецОбласти
