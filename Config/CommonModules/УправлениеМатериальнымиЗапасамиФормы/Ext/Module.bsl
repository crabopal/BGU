	ПроверитьЗаполнениеДатыВНовомОбъекте(Форма.Объект);
	РезервированиеНФА.ПриСозданииНаСервере(Форма);
КонецПроцедуры

// Устанавливает свойства (автоотметка незаполненного) реквизитов ЦМО и Подразделение.
// Если на форме есть реквизиты "УчетИмуществаКазныПоЦМО" и "УчетИмуществаКазныПоПодразделениям", то они будут
// установлены.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктура:
//    ** Организация - СправочникСсылка.Организации
//    ** Дата - Дата
//    ** СчетУчета - ПланСчетовСсылка.ЕПСБУ
//   РеквизитыЦМО - Строка
//                  - Массив из Строка
//   РеквизитыПодразделение - Строка
//                  - Массив из Строка
//
Процедура УстановитьПараметрыУчетаИКПоЦМОиПодразделениям(Форма, Знач РеквизитыЦМО, Знач РеквизитыПодразделение) Экспорт
	Если ТипЗнч(РеквизитыЦМО) <> Тип("Массив") Тогда
		РеквизитыЦМО = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(РеквизитыЦМО);
	КонецЕсли;
	Если ТипЗнч(РеквизитыПодразделение) <> Тип("Массив") Тогда
		РеквизитыПодразделение = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(РеквизитыПодразделение);
	КонецЕсли;
	
	ПараметрыУчетаИК = УправлениеМатериальнымиЗапасами.ПараметрыУчетаИКпоЦМОиПодразделениям(Форма.Объект.СчетУчета,
		Форма.Объект.Организация, Форма.Объект.Дата);

	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, РеквизитыЦМО,
		"АвтоотметкаНезаполненного", ПараметрыУчетаИК.УчетПоЦМО);
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, РеквизитыПодразделение,
		"АвтоотметкаНезаполненного", ПараметрыУчетаИК.УчетПоПодразделениям);
		
	ПараметрыФормы = Новый Структура("УчетИмуществаКазныПоЦМО, УчетИмуществаКазныПоПодразделениям",
		ПараметрыУчетаИК.УчетПоЦМО, ПараметрыУчетаИК.УчетПоПодразделениям);
	ЗаполнитьЗначенияСвойств(Форма, ПараметрыФормы);
	
КонецПроцедуры

// Устанавливает значение реквизита КФО.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * КэшПараметров - Структура:
//   ** УчетнаяПолитика - Структура:
//    *** ДатаПоследнегоИзменения - Дата
//  Объект - ДанныеФормыСтруктура:
//  * Организация - СправочникСсылка.Организации
//  * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//  * КФО - ПеречислениеСсылка.КВД
Процедура УстановитьКФОИмуществоКазны(Форма, Объект) Экспорт
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		ДопустимыеКФО = БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(
			Объект.Организация, Объект.ИФО, Форма.КэшПараметров.УчетнаяПолитика.ДатаПоследнегоИзменения);
		Если ДопустимыеКФО.Найти(ПредопределенноеЗначение("Перечисление.КВД.Бюджет")) <> Неопределено Тогда
			Объект.КФО = ПредопределенноеЗначение("Перечисление.КВД.Бюджет");
		Иначе
			Объект.КФО = ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка");
		КонецЕсли;
	Иначе
		Объект.КФО = ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры

