Процедура ПроверитьЗаполнениеДатыВНовомОбъекте(Объект)
	Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
		ЗаполнениеРеквизитовОбъектов.ЗаполнитьДатуПриКопировании(Объект, Неопределено);
		Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ДополнитьНаименованиеСчета(НаименованияСчетов, КодыСчетов, СчетУчета, ДатаСчета, Организация)
	
	СчетУчетаПланаСчетов = БухгалтерскийУчет.СчетПоКоду(СчетУчета, ДатаСчета, Организация);
	
	Если НЕ ЗначениеЗаполнено(СчетУчетаПланаСчетов) Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваСчетаУчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчетаПланаСчетов);
	КодыСчетов.Добавить(СвойстваСчетаУчета.Код);
	Если НЕ СвойстваСчетаУчета.Код = "02.34" Тогда
		НаименованияСчетов.Добавить(СвойстваСчетаУчета.Наименование);
	КонецЕсли;
	
КонецПроцедуры

