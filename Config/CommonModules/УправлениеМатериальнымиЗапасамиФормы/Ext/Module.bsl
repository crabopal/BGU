Функция КЭКДляСчета_01_33(Дата, Организация)
	
	КЭК340 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("340");
	
	Если БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(Дата, Организация) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОСГУ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КОСГУ КАК КОСГУ
		|ГДЕ
		|	НЕ КОСГУ.ПометкаУдаления
		|	И КОСГУ.Родитель = &КЭК340";
		Запрос.УстановитьПараметр("КЭК340", КЭК340);
		СписокКЭК = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	Иначе
		СписокКЭК = Новый Массив;
		СписокКЭК.Добавить(БухгалтерскийУчетПовтИсп.КЭКПоКоду("340"));
	КонецЕсли;
	Возврат СписокКЭК;
	
КонецФункции

