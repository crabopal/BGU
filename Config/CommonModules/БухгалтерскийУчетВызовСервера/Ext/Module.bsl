
#Область ПрограммныйИнтерфейс

Функция СчетПоКоду(КодСчета, Знач НаДату = Неопределено, Знач Организация = Неопределено) Экспорт
	
	Возврат БухгалтерскийУчет.СчетПоКоду(КодСчета, НаДату, Организация);
	
КонецФункции

Функция СписокСчетов(Счета, Знач НаДату = Неопределено, БезУчетаИерархии = Ложь, Знач Организация = Неопределено) Экспорт
	
	Возврат БухгалтерскийУчет.СписокСчетов(Счета, НаДату, БезУчетаИерархии, Организация);
	
КонецФункции

Функция СчетВИерархии(Счет, Эталон) Экспорт
	
	Возврат БухгалтерскийУчет.СчетВИерархии(Счет, Эталон);
	
КонецФункции

Функция ВидыДокументовРегистраторовРБ() Экспорт
	
	Возврат БухгалтерскийУчетПовтИсп.ВидыДокументовРегистраторовРБ();
	
КонецФункции

// Определяет КЭК дебета или кредита в зависимости от учетной политики и используемой аналитики счета.
// См. БухгалтерскийУчет.КЭКПроводки
//
Функция КЭКПроводки(ДанныеПроводки) Экспорт
	Возврат БухгалтерскийУчет.КЭКПроводки(ДанныеПроводки);
КонецФункции

Функция ДопустимыеКЭКПоКПС(КПС) Экспорт
	Возврат БухгалтерскийУчетПовтИсп.ДопустимыеКЭКПоКПС(КПС);
КонецФункции

// см. Справочники.Организации.ПолучитьУчетнуюПолитику
Функция УчетнаяПолитикаОрганизации(Организация, НаДату = Неопределено) Экспорт
	
	Возврат Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, НаДату);
	
КонецФункции

#КонецОбласти