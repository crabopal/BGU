// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Получает текст хранимой процедуры
//
Функция ПолучитьТекстПроцедуры(Модуль, ИмяПроцедуры) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТекстыПользовательскихПроцедур.ТекстПроцедуры
	|ИЗ
	|	РегистрСведений.ТекстыПользовательскихПроцедур КАК ТекстыПользовательскихПроцедур
	|ГДЕ
	|	ТекстыПользовательскихПроцедур.Модуль = &Модуль
	|	И ТекстыПользовательскихПроцедур.ИмяПроцедуры = &ИмяПроцедуры";
	
	Запрос.УстановитьПараметр("Модуль"      ,Модуль);
	Запрос.УстановитьПараметр("ИмяПроцедуры",ИмяПроцедуры);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.ТекстПроцедуры;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // ПолучитьТекстПроцедуры()

// Возвращает список имен процедур, сохраненных в регистре ТекстыПользовательскихПроцедур
//
Функция ПолучитьСписокПроцедурМодуля(Модуль) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТекстыПользовательскихПроцедур.ИмяПроцедуры КАК ИмяПроцедуры
	|ИЗ
	|	РегистрСведений.ТекстыПользовательскихПроцедур КАК ТекстыПользовательскихПроцедур
	|ГДЕ
	|	ТекстыПользовательскихПроцедур.Модуль = &Модуль
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИмяПроцедуры";
	
	Запрос.УстановитьПараметр("Модуль",Модуль);
	
	СписокРезультат = Новый СписокЗначений;
	Выборка         = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокРезультат.Добавить(Выборка.ИмяПроцедуры);
	КонецЦикла;
	
	Возврат СписокРезультат;

КонецФункции // ПолучитьСписокПроцедурМодуля()

Функция ПолучитьТаблицуСобытий(Знач ИмяОбъектаМетаданных) Экспорт
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяОбъектаМетаданных);
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Идентификатор",              Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(32)));
	Результат.Колонки.Добавить("ИмяПроцедуры",               Метаданные.РегистрыСведений.ТекстыПользовательскихПроцедур.Измерения.ИмяПроцедуры.Тип);
	Результат.Колонки.Добавить("ПубличныйИдентификатор",     Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(256)));
	
	Результат.Индексы.Добавить("Идентификатор");
	Результат.Индексы.Добавить("ИмяПроцедуры");
	Результат.Индексы.Добавить("ПубличныйИдентификатор");
	
	Если ОбъектМетаданных = Метаданные.Справочники.ПравилаОбработки Тогда
		
		СтрокаТаблицыСобытий = Результат.Добавить();
		СтрокаТаблицыСобытий.Идентификатор              = "Заполнение";
		СтрокаТаблицыСобытий.ИмяПроцедуры               = "ПриЗаполненииОтчета";
		СтрокаТаблицыСобытий.ПубличныйИдентификатор     = "{urn:schemas-1c-ru:reports/meta}autofill";
		
		СтрокаТаблицыСобытий = Результат.Добавить();
		СтрокаТаблицыСобытий.Идентификатор              = "Вычисление";
		СтрокаТаблицыСобытий.ИмяПроцедуры               = "ПриРасчетеПоказателей";
		СтрокаТаблицыСобытий.ПубличныйИдентификатор     = "{urn:schemas-1c-ru:reports/meta}calculation";
		
	ИначеЕсли ОбъектМетаданных = Метаданные.Справочники.ПравилаПроверки Тогда
		
		СтрокаТаблицыСобытий = Результат.Добавить();
		СтрокаТаблицыСобытий.Идентификатор              = "Проверка";
		СтрокаТаблицыСобытий.ИмяПроцедуры               = "ПриПроверкеОтчета";
		СтрокаТаблицыСобытий.ПубличныйИдентификатор     = "";
		
	ИначеЕсли ОбъектМетаданных = Метаданные.Справочники.ПроизвольныеБланкиФорм Тогда
		
		СтрокаТаблицыСобытий = Результат.Добавить();
		СтрокаТаблицыСобытий.Идентификатор              = "Печать";
		СтрокаТаблицыСобытий.ИмяПроцедуры               = "ОбработкаФормированияПечатнойФормы";
		СтрокаТаблицыСобытий.ПубличныйИдентификатор     = "";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

