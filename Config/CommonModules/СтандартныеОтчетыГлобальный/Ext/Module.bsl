#Область СлужебныйПрограммныйИнтерфейс

Функция ЖурналОперацийЕстьПолноеПредставление(Элемент) Экспорт
	
	Если ТипЗнч(Элемент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат Истина;
	КонецЕсли;
		
	Возврат Ложь;
	
КонецФункции

Функция ЖурналОперацийПолноеПредставление(Элемент) Экспорт
	
	ПредставлениеЭлемента = "";
	
	Если ТипЗнч(Элемент) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА Контрагенты.НаименованиеСокращенное = """"
		|			ТОГДА ВЫБОР
		|					КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
		|							И НЕ Контрагенты.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
		|						ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.НаименованиеПолное
		|					ИНАЧЕ ПРЕДСТАВЛЕНИЕ(Контрагенты.Ссылка)
		|				КОНЕЦ
		|		ИНАЧЕ Контрагенты.НаименованиеСокращенное
		|	КОНЕЦ КАК ПредставлениеЭлемента
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Ссылка");
		
		Запрос.УстановитьПараметр("Ссылка", Элемент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ПредставлениеЭлемента = Выборка.ПредставлениеЭлемента;
		КонецЕсли;
	Иначе
		ПредставлениеЭлемента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент, "Представление");
	КонецЕсли;
	
	Возврат ПредставлениеЭлемента;
	
КонецФункции

Функция ПредставлениеПервичногоДокументаБГУ(Вид, Номер, Дата) Экспорт
	Представление = "<...>";
	Если СтрДлина(Вид) Тогда
		Представление = СокрЛП(Вид);
		Представление = Представление + " ";
		Представление = Представление + СокрЛП(Строка(Номер));
		Представление = Представление + " от ";
		Представление = Представление + Формат(Дата, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Возврат Представление;
КонецФункции

#КонецОбласти