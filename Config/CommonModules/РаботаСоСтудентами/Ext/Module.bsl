Функция ПолучитьСмещение(Состояние) Экспорт 

	Результат = 0;
	
	Если ТипЗнч(Состояние) = Тип("СправочникСсылка.СостоянияСтудентов") Тогда
		
		ДанныеСостояние = РаботаСоСтудентамиПовтИсп.ПолучитьДанныеСостояния(Состояние);

		Если НЕ ДанныеСостояние.НачислятьВДеньПриказа Тогда
					
			Результат = -1;
			
		КонецЕсли; 
	
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции 

Функция РассчитатьРаспределяемуюСуммуПоСтудентам(Данные) Экспорт 
	
	Результат = NULL;
	
	Если Данные = NULL Тогда
		Возврат NULL;
	КонецЕсли;
	
	Если ТипЗнч(Данные) <> Тип("ДанныеГрупповойОбработкиКомпоновкиДанных") Тогда
		Сообщить(ТипЗнч(Данные));
		ВызватьИсключение "В функцию РассчитатьРаспределяемуюСуммуПоСтудентам() можно передавать только объект типа ДанныеГрупповойОбработкиКомпоновкиДанных";
	КонецЕсли;
	
	КоличествоСтрок = Данные.Данные.Количество();
	
	Если Данные.ТекущийЭлемент <> Неопределено Тогда

		Сумма = Окр(Данные.ТекущийЭлемент.Сумма / КоличествоСтрок, 2); 
		
		Если Данные.Данные.Индекс(Данные.ТекущийЭлемент) = КоличествоСтрок - 1 Тогда
			
			ОбщаяСумма = Окр(Сумма * КоличествоСтрок, 2);
			Если Данные.ТекущийЭлемент.Сумма <> ОбщаяСумма Тогда
				
				Сумма = Сумма + (Данные.ТекущийЭлемент.Сумма - ОбщаяСумма);
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	   Результат = Сумма;
	   
   КонецЕсли;
   
   Возврат Результат;
	  
КонецФункции



