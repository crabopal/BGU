// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ МОДУЛЯ

Функция ПолучитьСчетФактуруПлательщика(Контрагент, ДоговорКонтрагента, ТаблицаСФ)
	
	СтруктураОтбора = Новый Структура("Контрагент, ДоговорКонтрагента", Контрагент, ДоговорКонтрагента);
	МассивНайденныхСФ = ТаблицаСФ.НайтиСтроки(СтруктураОтбора);
	КоличествоНайденныхСФ = МассивНайденныхСФ.Количество();
	
	Если КоличествоНайденныхСФ = 0 Тогда
		
		ОбъектСчетФактура = Документы.СчетФактураВыданный.СоздатьДокумент();
		
	ИначеЕсли КоличествоНайденныхСФ = 1 Тогда
		
		ОбъектСчетФактура = МассивНайденныхСФ[0].Ссылка.ПолучитьОбъект();
		
	Иначе
		
		Для каждого СтрокаСФ Из МассивНайденныхСФ Цикл
			ОбъектСФ = СтрокаСФ.Ссылка.ПолучитьОбъект();
			ОбъектСФ.УстановитьПометкуУдаления(Истина);	
		КонецЦикла; 
		
		ОбъектСчетФактура = Документы.СчетФактураВыданный.СоздатьДокумент();		
		
	КонецЕсли; 
	
	Возврат ОбъектСчетФактура;
	
КонецФункции

Процедура ОбработатьСФНаПлательщика(ШапкаОснования, ТаблицаНайденныхСФ, ВыборкаТребуемыхНачислений, ФормаУправленияСчетамиФактурами)
	
	ОперацияНачисления	= ФормаУправленияСчетамиФактурами.ТиповаяОперацияДокументОснование;
	ОперацияСФ			= ФормаУправленияСчетамиФактурами.ТиповаяОперацияСФ;
	КПС40120			= ФормаУправленияСчетамиФактурами.КПС40120;
	
	ТребуетсяУказыватьПодразделение = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ДопРеквизитыОснования = БухгалтерскиеОперацииСервер.ЗаполнитьДополнительныеРеквизиты(ШапкаОснования.Ссылка, ОперацияНачисления);
	ДопРеквизитыОснования.Вставить("Курс", ШапкаОснования.Курс);
	ДопРеквизитыОснования.Вставить("Кратность", ШапкаОснования.Кратность);
	
	КПСОперации = Неопределено;
	Если ДопРеквизитыОснования.Свойство("КПС",КПСОперации) Тогда
		ДопРеквизитыОснования.Вставить("КПС40100",КПСОперации);
	КонецЕсли;
	
	КЭКОперации = Неопределено;
	Если ДопРеквизитыОснования.Свойство("КОСГУ",КЭКОперации) Тогда
		ДопРеквизитыОснования.Вставить("КЭК40100",КЭКОперации);
	КонецЕсли;
	
	КФО = ?(ДопРеквизитыОснования.Свойство("КФО"),
		ДопРеквизитыОснования.КФО,
		Перечисления.КВД.Внебюджет);
	
	ОтветственныеЛица = ПолучитьОтветственныхЛицДляУстановкиВСчетеФактуре(ШапкаОснования, ТребуетсяУказыватьПодразделение);
	
	НачатьТранзакцию();
	
	Попытка
		НеобходимоЗаполнитьСчетаФактурыНаАванс = (ШапкаОснования.Дата >= '20260101');
		Если НеобходимоЗаполнитьСчетаФактурыНаАванс Тогда
			// Все сч.-ф. создаются с одинаковой причиной налогообложения Реализация.
			ТаблицаДокументовСчетовФактурНаАванс = ПолучитьТаблицуДокументовСчетовФактурНаАванс(ВыборкаТребуемыхНачислений, ШапкаОснования, КФО);
		КонецЕсли;
		
		// Обходим по контрагентам
		Пока ВыборкаТребуемыхНачислений.Следующий() Цикл
			
			// Обходим по договорам
			ВыборкаПоДоговорам = ВыборкаТребуемыхНачислений.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПоДоговорам.Следующий() Цикл
				
				СчетФактура = ПолучитьСчетФактуруПлательщика(ВыборкаПоДоговорам.Контрагент, ВыборкаПоДоговорам.ДоговорКонтрагента, ТаблицаНайденныхСФ);
				
				Если НЕ ШапкаОснования.Проведен И СчетФактура.ЭтоНовый() Тогда
					
					// Счет фактуру перезаполнять не требуется, как и дальгейшая обработка. 
					// Документ-основание не проведен и не требует действий
					
				ИначеЕсли НЕ ШапкаОснования.Проведен И НЕ СчетФактура.ЭтоНовый() Тогда
					
					СчетФактура.УстановитьПометкуУдаления(Истина);

				Иначе
					СчетФактура.СоставНФА.Очистить();
					СчетФактура.ПометкаУдаления = Ложь;
					СчетФактура.Дата = ШапкаОснования.Дата;
					СчетФактура.Организация = ШапкаОснования.Организация;
					СчетФактура.Подразделение = ?(ТребуетсяУказыватьПодразделение, ШапкаОснования.Факультет, ШапкаОснования.ПустоеПодразделение); 
					СчетФактура.ИФО = ШапкаОснования.ИФО;
					СчетФактура.СуммаВключаетНДС = ШапкаОснования.СуммаВключаетНДС;
					СчетФактура.Контрагент = ВыборкаПоДоговорам.Контрагент;
					СчетФактура.Договор = ВыборкаПоДоговорам.ДоговорКонтрагента;
					СчетФактура.ДокументОснование = ШапкаОснования.Ссылка;
					
					ДокументОснованиеЭДО = ЭлектронныеДокументыБГУ.НайтиПередаточныйДокументЭДПоИдентификаторуЭД(ВыборкаПоДоговорам.ИдентификаторЭД, ВыборкаПоДоговорам.Контрагент, ВыборкаПоДоговорам.ДоговорКонтрагента, ШапкаОснования.Ссылка);
					СчетФактура.ДокументОснованиеЭДО = ДокументОснованиеЭДО;
					Если ЗначениеЗаполнено(ДокументОснованиеЭДО) Тогда
						СчетФактура.КодСпособаВыставления = 2;
					Иначе
						СчетФактура.КодСпособаВыставления = 1;
					КонецЕсли;	
					
					СчетФактура.ВидЦенности = Перечисления.ВидыЦенностейНДС.Услуги;
					СчетФактура.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Реализация;
					СчетФактура.Руководитель = ШапкаОснования.Руководитель;
					СчетФактура.ГлавныйБухгалтер = ШапкаОснования.ГлавныйБухгалтер;
					СчетФактура.ВалютаДокумента = ШапкаОснования.ВалютаДокумента;
					СчетФактура.КФО = КФО;
					СчетФактура.КодВидаОперации = "01";
					
					ЗаполнитьЗначенияСвойств(СчетФактура, ОтветственныеЛица);
					
					// Обходим строки начисления
					ВыборкаПоНачислениям = ВыборкаПоДоговорам.Выбрать();
					Пока ВыборкаПоНачислениям.Следующий() Цикл
						
						ТекКоличество = ?(ЗначениеЗаполнено(ВыборкаПоНачислениям.Количество),ВыборкаПоНачислениям.Количество,1);
						
						ДокОснование = СчетФактура.ДокументОснование;
						
						Если ЗначениеЗаполнено(ДокОснование) Тогда
							СуммаВключаетНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОснование, "СуммаВключаетНДС");
						Иначе
							СуммаВключаетНДС = Ложь;
						КонецЕсли;
						
						Сумма = ВыборкаПоНачислениям.Сумма;
						
						НоваяСтрока = СчетФактура.СоставНФА.Добавить();
						Если ТипЗнч(ШапкаОснования.Ссылка) = Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги") И Не ЗначениеЗаполнено(ШапкаОснования.Номенклатура) Тогда
							НоваяСтрока.НФА = ВыборкаПоНачислениям.Номенклатура;
							НоваяСтрока.ЕдиницаИзмерения = ВыборкаПоНачислениям.НоменклатураЕдиницаИзмерения;
						Иначе
							НоваяСтрока.НФА = ШапкаОснования.Номенклатура;
							НоваяСтрока.ЕдиницаИзмерения = ШапкаОснования.НоменклатураЕдиницаИзмерения;
						КонецЕсли;
						НоваяСтрока.Количество = ТекКоличество;
						НоваяСтрока.Цена = ?(СуммаВключаетНДС, Сумма - ВыборкаПоНачислениям.СуммаНДС, Сумма);
						НоваяСтрока.Сумма = ?(СуммаВключаетНДС, Сумма - ВыборкаПоНачислениям.СуммаНДС, Сумма);
						НоваяСтрока.СтавкаНДС = ВыборкаПоНачислениям.СтавкаНДС;
						НоваяСтрока.СуммаНДС = ВыборкаПоНачислениям.СуммаНДС;
						НоваяСтрока.Всего = Сумма + ?(СчетФактура.СуммаВключаетНДС, 0, ВыборкаПоНачислениям.СуммаНДС);
						
						ЗаполнитьЗначенияСвойств(НоваяСтрока,ШапкаОснования,"Счет30304,КПС30304");
					КонецЦикла;
					
					БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(СчетФактура, ОперацияСФ, ДопРеквизитыОснования);
					
					ШапкаДокумента = Новый Структура("
						|ДокументОснование,
						|Дата,
						|Организация,
						|ИФО,
						|Подразделение,
						|Контрагент,
						|Договор,
						|ВалютаДокумента,
						|ВидЦенности,
						|КодВидаОперации,
						|КФО,
						|РеализацияПоСтавке0,
						|ПричинаНалогообложения");
					ЗаполнитьЗначенияСвойств(ШапкаДокумента, СчетФактура);
					ТЗСоставНФА = СчетФактура.СоставНФА.Выгрузить();
					Документы.СчетФактураВыданный.ЗаполнитьКолонкиСчетов(ШапкаДокумента, ТЗСоставНФА, Неопределено);
					
					Если СчетФактура.КФО = Перечисления.КВД.Бюджет И ЗначениеЗаполнено(КПС40120) Тогда
						ТЗСоставНФА.ЗаполнитьЗначения(КПС40120, "КПСНачислениеДт");
					КонецЕсли;
					
					// Код вида операции
					ДополнительныеПараметры = Новый Структура();
					ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента", "СчетФактураВыданный");
					КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(ШапкаДокумента, ДополнительныеПараметры);
					СчетФактура["КодВидаОперации"] = КодВидаОперации;
					
					// Числовые колонки	
					КолонкиСуммирования	= "
						|Количество,
						|Сумма,
						|СуммаНДС,
						|Всего";
					// Все остальные колонки, кроме Цена
					КолонкиГруппировок	= "
						|НФА,
						|ЕдиницаИзмерения,
						|СтавкаНДС,
						|СодержаниеУслуги,
						|Счет30304,
						|КПС30304,
						|СчетНачислениеДт,
						|Субконто1НачислениеДт,
						|Субконто2НачислениеДт,
						|Субконто3НачислениеДт,
						|КПСНачислениеДт,
						|КЭКНачислениеДт,
						|НДСКВычету,
						|НДСКРаспределению,
						|СчетВычетКт,
						|КПСВычетКт,
						|СчетРасчетов,
						|КПССчетРасчетов";
					ТЗСоставНФА.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
					СчетФактура.СоставНФА.Загрузить(ТЗСоставНФА);
					Для Каждого СтрокаТЧ Из СчетФактура.СоставНФА Цикл
						СтрокаТЧ["Цена"] = ?(СтрокаТЧ["Количество"] = 0,
							0,
							СтрокаТЧ["Сумма"] / СтрокаТЧ["Количество"]);
					КонецЦикла;
					
					Если НеобходимоЗаполнитьСчетаФактурыНаАванс Тогда
						// Все сч.-ф. создаются с одинаковой причиной налогообложения Реализация.
						ЗаполнитьСчетаФактурыНаАванс(СчетФактура, ТаблицаДокументовСчетовФактурНаАванс);
					КонецЕсли;
					
					СчетФактура.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);	
				КонецЕсли; 
			КонецЦикла; 
		КонецЦикла; 
		
		ЗафиксироватьТранзакцию();	
		
	Исключение
		ОтменитьТранзакцию();
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = НСтр("ru = 'Не удалось создать/обновить счет-фактуру по причине: '");
		ТекстОшибкиКраткий = ТекстОшибки + КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ТекстОшибкиПолный = ТекстОшибки + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибкиКраткий);
		
		ЗаписьЖурналаРегистрации("Данные.Изменение",
								 УровеньЖурналаРегистрации.Ошибка,
								 СчетФактура.Метаданные(),
								 Неопределено,
								 ТекстОшибкиПолный);
	КонецПопытки; 
	
КонецПроцедуры

Функция ПолучитьОтветственныхЛицДляУстановкиВСчетеФактуре(ШапкаОснования, ТребуетсяУказыватьПодразделение)
	
	Подразделение = ?(ТребуетсяУказыватьПодразделение, ШапкаОснования.Факультет, ШапкаОснования.ПустоеПодразделение);
	
	ШапкаСФ = Новый Структура();
	ШапкаСФ.Вставить("Дата",			ШапкаОснования.Дата);
	ШапкаСФ.Вставить("Организация",		ШапкаОснования.Организация);
	ШапкаСФ.Вставить("Подразделение",	Подразделение);
	ШапкаСФ.Вставить("Руководитель");
	ШапкаСФ.Вставить("ГлавныйБухгалтер");
	
	Документы.СчетФактураВыданный.УстановитьОтветственныхЛиц(ШапкаСФ);
	
	ОтветственныеЛица = Новый Структура("Руководитель,ГлавныйБухгалтер");
	
	ЗаполнитьЗначенияСвойств(ОтветственныеЛица, ШапкаСФ);
	
	Возврат ОтветственныеЛица;
	
КонецФункции

// Функция формирует таблицу, представляющию список необходимых к пересчету студентов по факультетам
//
// Параметры
//  нет
//
// Возвращаемое значение:
//   ТаблицаЗначений - Содержит колонки:
//								Факультет - СправочникСсылка.Подразделение - по какому факультету
//								Студент - СправочникСсылка.Студенты - для какого студента
//								Период - Дата - с какого периода (месяца)
//								ПериодОкончания - Дата - по какой период требуется пересчет
// 				Если пересчет не требуется - записи в таблицы нет
//
Функция СформироватьТаблицуНачисленияПериоды()
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	НачисленияОбразование.Факультет КАК Факультет,
	               |	НачисленияОбразование.Студент КАК Студент,
	               |	НАЧАЛОПЕРИОДА(МИНИМУМ(НачисленияОбразование.Период), МЕСЯЦ) КАК Период
	               |ПОМЕСТИТЬ НачальныеДвижения
	               |ИЗ
	               |	Последовательность.НачисленияОбразование КАК НачисленияОбразование
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НачисленияОбразование.Факультет,
	               |	НачисленияОбразование.Студент
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Факультет,
	               |	Студент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КонечныеДвижения.Студент КАК Студент,
	               |	КонечныеДвижения.Факультет КАК Факультет,
	               |	КонечныеДвижения.Договор КАК Договор,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(КонечныеДвижения.Значение КАК Справочник.СостоянияСтудентов).ДействуетНачисление
	               |			ТОГДА НАЧАЛОПЕРИОДА(&ТекущаяДата, МЕСЯЦ)
	               |		ИНАЧЕ НАЧАЛОПЕРИОДА(КонечныеДвижения.Период, МЕСЯЦ)
	               |	КОНЕЦ КАК Период
	               |ПОМЕСТИТЬ КонечныеДвижения
	               |ИЗ
	               |	РегистрСведений.СведенияОСтудентах.СрезПоследних(КОНЕЦПЕРИОДА(&ТекущаяДата, МЕСЯЦ), Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента)) КАК КонечныеДвижения
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Студент,
	               |	Факультет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Границы.Факультет КАК Факультет,
	               |	Границы.Студент КАК Студент,
	               |	КонечныеДвижения.Договор КАК Договор,
	               |	НАЧАЛОПЕРИОДА(Границы.Период, МЕСЯЦ) КАК Период,
	               |	НАЧАЛОПЕРИОДА(ЕСТЬNULL(КонечныеДвижения.Период, &ТекущаяДата), МЕСЯЦ) КАК ПериодОкончания,
	               |	ЛОЖЬ КАК УдалитьПериод
	               |ПОМЕСТИТЬ ТаблицаПерерасчета
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		НачальныеДвижения.Факультет КАК Факультет,
	               |		НачальныеДвижения.Студент КАК Студент,
	               |		ЕСТЬNULL(НачисленияОбразованиеГраницы.Период, НачальныеДвижения.Период) КАК Период
	               |	ИЗ
	               |		НачальныеДвижения КАК НачальныеДвижения
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Последовательность.НачисленияОбразование.Границы КАК НачисленияОбразованиеГраницы
	               |			ПО НачальныеДвижения.Факультет = НачисленияОбразованиеГраницы.Факультет
	               |				И НачальныеДвижения.Студент = НачисленияОбразованиеГраницы.Студент
	               |	ГДЕ
	               |		ЕСТЬNULL(НачисленияОбразованиеГраницы.Период, НачальныеДвижения.Период) <= НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ТекущаяДата, МЕСЯЦ, 1), МЕСЯЦ)) КАК Границы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КонечныеДвижения КАК КонечныеДвижения
	               |		ПО Границы.Факультет = КонечныеДвижения.Факультет
	               |			И Границы.Студент = КонечныеДвижения.Студент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НачисленияПлановыеОбразование.ПериодНачисления КАК Период,
	               |	НачисленияПлановыеОбразование.Факультет КАК Факультет,
	               |	НачисленияПлановыеОбразование.Студент КАК Студент,
	               |	НачисленияПлановыеОбразование.ДоговорКонтрагента КАК Договор,
	               |	ИСТИНА КАК УдалитьПериод
	               |ПОМЕСТИТЬ ТаблицаУдаления
	               |ИЗ
	               |	РегистрСведений.НачисленияПлановыеОбразование КАК НачисленияПлановыеОбразование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ НачальныеДвижения КАК НачальныеДвижения
	               |		ПО НачисленияПлановыеОбразование.Факультет = НачальныеДвижения.Факультет
	               |			И НачисленияПлановыеОбразование.Студент = НачальныеДвижения.Студент
	               |			И НачисленияПлановыеОбразование.ПериодНачисления < НачальныеДвижения.Период
	               |ГДЕ
	               |	НЕ НачальныеДвижения.Период ЕСТЬ NULL
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НачисленияПлановыеОбразование.ПериодНачисления,
	               |	НачисленияПлановыеОбразование.Факультет,
	               |	НачисленияПлановыеОбразование.Студент,
	               |	НачисленияПлановыеОбразование.ДоговорКонтрагента,
	               |	ИСТИНА
	               |ИЗ
	               |	РегистрСведений.НачисленияПлановыеОбразование КАК НачисленияПлановыеОбразование
	               |ГДЕ
	               |	НачисленияПлановыеОбразование.ПериодНачисления > КОНЕЦПЕРИОДА(&ТекущаяДата, МЕСЯЦ)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НачисленияПлановыеОбразование.ПериодНачисления,
	               |	НачисленияПлановыеОбразование.Факультет,
	               |	НачисленияПлановыеОбразование.Студент,
	               |	НачисленияПлановыеОбразование.ДоговорКонтрагента,
	               |	ИСТИНА
	               |ИЗ
	               |	РегистрСведений.НачисленияПлановыеОбразование КАК НачисленияПлановыеОбразование
	               |ГДЕ
	               |	НЕ (НачисленияПлановыеОбразование.Студент, НачисленияПлановыеОбразование.Факультет) В
	               |				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |					НачальныеДвижения.Студент,
	               |					НачальныеДвижения.Факультет
	               |				ИЗ
	               |					НачальныеДвижения КАК НачальныеДвижения)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТаблицаПерерасчета.Факультет КАК Факультет,
	               |	ТаблицаПерерасчета.Студент КАК Студент,
	               |	ТаблицаПерерасчета.Договор КАК Договор,
	               |	ТаблицаПерерасчета.Период КАК Период,
	               |	ТаблицаПерерасчета.УдалитьПериод КАК УдалитьПериод,
	               |	ТаблицаПерерасчета.ПериодОкончания КАК ПериодОкончания
	               |ИЗ
	               |	ТаблицаПерерасчета КАК ТаблицаПерерасчета
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТаблицаУдаления.Факультет,
	               |	ТаблицаУдаления.Студент,
	               |	ТаблицаУдаления.Договор,
	               |	ТаблицаУдаления.Период,
	               |	ТаблицаУдаления.УдалитьПериод,
	               |	NULL
	               |ИЗ
	               |	ТаблицаУдаления КАК ТаблицаУдаления";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	// МассивРезультатов[0] - ВТ НачальныеДвижения
	// МассивРезультатов[1] - ВТ КонечныеДвижения
	// МассивРезультатов[2] - ВТ ТаблицаПерерасчета
	// МассивРезультатов[3] - ВТ ТаблицаУдаления
	Возврат МассивРезультатов[4].Выгрузить();
	
КонецФункции 
         
Процедура РазвернутьПериод(ТаблицаПриемник, СтрокаПериода)
	
	ВременныйПериод = СтрокаПериода.Период;
	
	Пока ВременныйПериод <= СтрокаПериода.ПериодОкончания Цикл
		
		НоваяСтрока = ТаблицаПриемник.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПериода);
		НоваяСтрока.Период = ВременныйПериод;
		ВременныйПериод = ДобавитьМесяц(ВременныйПериод, 1);
		
	КонецЦикла; 
	
КонецПроцедуры

Функция ПолучитьПорядокВыпискиСФОбразовательныеУслугиСтуденту(Студент, Плательщик = Неопределено, Договор = Неопределено, НаДату = Неопределено)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Учащийся",		Студент);
	ЗапросПоиск.УстановитьПараметр("Период",		НаДату);
	ЗапросПоиск.УстановитьПараметр("Плательщик",	Плательщик);
	ЗапросПоиск.УстановитьПараметр("Договор",		Договор);
	ЗапросПоиск.Текст =	"
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПорядокВыпискиСФ КАК ПорядокВыпискиСФ
	|ИЗ
	|	РегистрСведений.ПлательщикиПоДоговоруОбразование.СрезПоследних(&Период, Студент = &Учащийся И &ДопУсловие)
	|ГДЕ
	|	ПорядокВыпискиСФ <> ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.ПустаяСсылка)";
	
	ДопУсловие = "";
	
	Если ЗначениеЗаполнено(Плательщик) Тогда
		ДопУсловие = ДопУсловие + ?(ДопУсловие = "", "", "И ") + "Контрагент = &Плательщик";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Договор) Тогда
		ДопУсловие = ДопУсловие + ?(ДопУсловие = "", "", "И ") + "Договор = &Договор";
	КонецЕсли;
	
	Если ДопУсловие = "" Тогда
		ДопУсловие = "Истина";
	КонецЕсли;
	
	ЗапросПоиск.Текст = СтрЗаменить(ЗапросПоиск.Текст, "&ДопУсловие", ДопУсловие);
	
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	
	Если Таблица.Количество() = 1 Тогда
		Возврат Таблица[0].ПорядокВыпискиСФ;
	Иначе
		Возврат Перечисления.ПорядокВыпискиСФЗаУслуги.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции	
	
Функция ПолучитьПорядокВыпискиСФПрочиеУслугиСтуденту(СведенияОПрочихУслугах)
	
	Таблица = СведенияОПрочихУслугах.Скопировать(, "ПорядокВыпискиСФ");
	Таблица.Свернуть("ПорядокВыпискиСФ");
	
	КоличествоСтрок = Таблица.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		ИндексСтроки = КоличествоСтрок - Счетчик;
		
		СтрокаТаблицы = Таблица[ИндексСтроки];
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ПорядокВыпискиСФ) Тогда
			Таблица.Удалить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	Если Таблица.Количество() = 1 Тогда
		Возврат Таблица[0].ПорядокВыпискиСФ;
	Иначе
		Возврат Перечисления.ПорядокВыпискиСФЗаУслуги.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции	

Функция ПолучитьТаблицуДокументовСчетовФактурНаАванс(ВыборкаТребуемыхНачислений, ШапкаОснования, КФО)
	
	Отбор = УчетНДС.НовыйОтборОстаткиВходящийНДСАвансыПолученные();
	Отбор.НаДату = ШапкаОснования.Дата;
	
	Отбор.Организация = ШапкаОснования.Организация;
	Отбор.СписокДокументовЗачетаАванса.Добавить(ШапкаОснования.Ссылка);
	Отбор.СписокКФО.Добавить(КФО);
	
	ВыборкаТребуемыхНачислений.Сбросить();
	
	// Обходим по контрагентам
	Пока ВыборкаТребуемыхНачислений.Следующий() Цикл
		Отбор.СписокКонтрагентов.Добавить(ВыборкаТребуемыхНачислений.Контрагент);
		
		// Обходим по договорам
		ВыборкаПоДоговорам = ВыборкаТребуемыхНачислений.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоДоговорам.Следующий() Цикл
			Отбор.СписокДоговоров.Добавить(ВыборкаПоДоговорам.ДоговорКонтрагента);
		КонецЦикла;
	КонецЦикла;
	
	ВыборкаТребуемыхНачислений.Сбросить();
	
	ТаблицаДокументов = УчетНДС.ПолучитьТаблицуДокументовСчетовФактурНаАванс(Отбор, Истина);
	
	Возврат ТаблицаДокументов;
	
КонецФункции

Процедура ЗаполнитьСчетаФактурыНаАванс(СчетФактураНаОтгрузку, ТаблицаДокументовСчетовФактурНаАванс)
	
	СчетФактураНаОтгрузку.СчетаФактурыНаАванс.Очистить();
	
	ИменаПолейАналитикиСтрокой = "КФО,Контрагент,Договор";
	
	ПоискАналитики = Новый Структура(ИменаПолейАналитикиСтрокой);
	
	ЗаполнитьЗначенияСвойств(ПоискАналитики, СчетФактураНаОтгрузку);
	
	МассивСтрок = ТаблицаДокументовСчетовФактурНаАванс.НайтиСтроки(ПоискАналитики);
	
	УжеДобавленныеСФ = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СчетФактура = СтрокаТаблицы.СчетФактура;
		
		Если УжеДобавленныеСФ.Найти(СчетФактура) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УжеДобавленныеСФ.Добавить(СчетФактура);
		
		НоваяСтрока = СчетФактураНаОтгрузку.СчетаФактурыНаАванс.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

