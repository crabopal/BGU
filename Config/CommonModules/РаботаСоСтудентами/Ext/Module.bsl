Функция СоздатьПолучитьСостояние(Наименование, ДействуетНачисление, НачислятьВДеньПриказа) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СостоянияСтудентов.Ссылка,
	                      |	СостоянияСтудентов.Наименование
	                      |ИЗ
	                      |	Справочник.СостоянияСтудентов КАК СостоянияСтудентов");
	
	Состояния = Запрос.Выполнить().Выгрузить();
	
	МассивСтрок = Состояния.НайтиСтроки(Новый Структура("Наименование", Наименование));
	Если МассивСтрок.Количество() > 0 Тогда
		ЭлементСостояние = МассивСтрок[0].Ссылка.ПолучитьОбъект();
	Иначе	
		ЭлементСостояние = Справочники.СостоянияСтудентов.СоздатьЭлемент();
	КонецЕсли;	
	
	ЭлементСостояние.Наименование 			= Наименование;
	ЭлементСостояние.ДействуетНачисление 	= ДействуетНачисление;
	ЭлементСостояние.НачислятьВДеньПриказа  = НачислятьВДеньПриказа;
	
	ЭлементСостояние.Записать();
	
	Возврат ЭлементСостояние.Ссылка;

КонецФункции 

Функция ДобавитьСтрокуПоля(Поля, ВидПоля, Заполнять, ЗаполнятьОбязательно, ПоказыватьПредЗначение) Экспорт
	
	Строки = Поля.НайтиСтроки(Новый Структура("Поле", ВидПоля));
	Если Строки.Количество() = 0 Тогда
		СтрокаПоля = Поля.Добавить();
	Иначе
		СтрокаПоля = Строки[0] 
	КонецЕсли;
	
	СтрокаПоля.Поле = ВидПоля;
	СтрокаПоля.Заполнять = Заполнять;
	СтрокаПоля.ЗаполнениеОбязательно = ЗаполнятьОбязательно;
	СтрокаПоля.ПоказыватьПредыдущееЗначение = ПоказыватьПредЗначение;
	
КонецФункции

Процедура УдалитьПустыеСтроки(ВидПриказаПоля)
	
	ПустыеСтроки = ВидПриказаПоля.НайтиСтроки(Новый Структура("Поле", ПредопределенноеЗначение("ПланВидовХарактеристик.ПоляПриказовОбразование.ПустаяСсылка")));
	Для Каждого ПустаяСтр Из ПустыеСтроки Цикл
		ВидПриказаПоля.Удалить(ПустаяСтр);
	КонецЦикла;	

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
//    РОДИТЕЛЬСКАЯ ПЛАТА

Функция ПолучитьТаблицуСчетовФактурПоНачислениюРодительскойПлатыСКомментариями(ДокументНачисления) Экспорт 
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СчетФактураВыданный.Организация,
	               |	СчетФактураВыданный.Подразделение,
	               |	СчетФактураВыданный.Контрагент,
	               |	СчетФактураВыданный.Договор,
	               |	СчетФактураВыданный.Ссылка КАК СчетФактура,
	               |	СчетФактураВыданный.СуммаДокумента,
	               |	СчетФактураВыданный.СуммаНДС,
	               |	СчетФактураВыданный.СуммаВключаетНДС,
	               |	СчетФактураВыданный.ВалютаДокумента,
	               |	СчетФактураВыданный.ПометкаУдаления,
	               |	СчетФактураВыданный.Проведен,
	               |	ОперацииДокументов.Курс КАК Курс,
	               |	ОперацииДокументов.Кратность КАК Кратность,
	               |	СчетФактураВыданный.ИФО
	               |ПОМЕСТИТЬ ВсеСФ
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	               |		ПО СчетФактураВыданный.Ссылка = ОперацииДокументов.Документ
	               |ГДЕ
	               |	СчетФактураВыданный.ДокументОснование = &ДокументОснование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВсеСФ.Контрагент КАК Контрагент,
	               |	ВсеСФ.Договор КАК Договор,
	               |	КОЛИЧЕСТВО(ВсеСФ.СчетФактура) КАК КоличествоСФ
	               |ПОМЕСТИТЬ КолСФ
	               |ИЗ
	               |	ВсеСФ КАК ВсеСФ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВсеСФ.Контрагент,
	               |	ВсеСФ.Договор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА Начисления.КонтрагентЭДО <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   |			ТОГДА Начисления.КонтрагентЭДО
	               |		КОГДА Начисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА &КонтрагентСводнаяСФ
	               |		ИНАЧЕ Начисления.Контрагент
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА Начисления.ДоговорКонтрагентаЭДО <> ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
				   |			ТОГДА Начисления.ДоговорКонтрагентаЭДО
	               |		КОГДА Начисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |		ИНАЧЕ Начисления.ДоговорКонтрагента
	               |	КОНЕЦ КАК ДоговорКонтрагента,
	               |	СУММА(Начисления.СуммаНДС) КАК СуммаНДС,
	               |	Начисления.Ссылка.УчитыватьНДС КАК УчитыватьНДС,
	               |	Начисления.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	               |	СУММА(Начисления.Сумма + ВЫБОР
	               |			КОГДА НЕ Начисления.Ссылка.СуммаВключаетНДС
	               |				ТОГДА Начисления.СуммаНДС
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СуммаНачисления,
	               |	&ВалютаДокумента КАК ВалютаДокумента,
	               |	1 КАК Курс,
	               |	1 КАК Кратность,
	               |	Начисления.Ссылка.Организация,
	               |	Начисления.Ссылка.Подразделение КАК Факультет,
	               |	Начисления.Ссылка.ИФО,
	               |	Начисления.Ссылка.Проведен
	               |ПОМЕСТИТЬ ТаблицаНачисления
	               |ИЗ
	               |	Документ.НачислениеРодительскойПлаты.Начисления КАК Начисления
	               |ГДЕ
	               |	Начисления.Ссылка = &ДокументОснование
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВЫБОР
	               |		КОГДА Начисления.ДоговорКонтрагентаЭДО <> ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
				   |			ТОГДА Начисления.ДоговорКонтрагентаЭДО
	               |		КОГДА Начисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |		ИНАЧЕ Начисления.ДоговорКонтрагента
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА Начисления.КонтрагентЭДО <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   |			ТОГДА Начисления.КонтрагентЭДО
	               |		КОГДА Начисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА &КонтрагентСводнаяСФ
	               |		ИНАЧЕ Начисления.Контрагент
	               |	КОНЕЦ,
	               |	Начисления.Ссылка.УчитыватьНДС,
	               |	Начисления.Ссылка.СуммаВключаетНДС,
	               |	Начисления.Ссылка.Организация,
	               |	Начисления.Ссылка.Подразделение,
	               |	Начисления.Ссылка.ИФО,
	               |	Начисления.Ссылка.Проведен
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ВсеСФ.Контрагент ЕСТЬ NULL 
	               |			ТОГДА ТаблицаНачисления.Контрагент
	               |		ИНАЧЕ ВсеСФ.Контрагент
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА ВсеСФ.Договор ЕСТЬ NULL 
	               |			ТОГДА ТаблицаНачисления.ДоговорКонтрагента
	               |		ИНАЧЕ ВсеСФ.Договор
	               |	КОНЕЦ КАК ДоговорКонтрагента,
	               |	ЕСТЬNULL(ВсеСФ.СчетФактура, ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)) КАК СчетФактура,
	               |	ВЫБОР
	               |		КОГДА НЕ ТаблицаНачисления.УчитыватьНДС
	               |				И (ВсеСФ.СчетФактура.ПометкаУдаления
	               |					ИЛИ НЕ ВсеСФ.Проведен)
	               |			ТОГДА ЛОЖЬ
	               |		КОГДА НЕ ТаблицаНачисления.Проведен
	               |				И НЕ ВсеСФ.Проведен
	               |			ТОГДА ЛОЖЬ
	               |		КОГДА НЕ ТаблицаНачисления.Проведен
	               |				И ВсеСФ.Проведен
	               |			ТОГДА ""Документ начисления не проведен, счет-фактура проведена!""
	               |		КОГДА ТаблицаНачисления.Организация <> ВсеСФ.Организация
	               |			ТОГДА ""Различаются организации в документе начисления и счет-фактуре!""
	               |		КОГДА &ЕстьУчетПоПодразделениям
	               |				И ТаблицаНачисления.Факультет <> ВсеСФ.Подразделение
	               |			ТОГДА ""Различаются подразделения в документе начисления и счет-фактуре!""
	               |		КОГДА ТаблицаНачисления.ИФО <> ВсеСФ.ИФО
	               |			ТОГДА ""Различаются ИФО в документе начисления и счет-фактуре!""
	               |		КОГДА ТаблицаНачисления.УчитыватьНДС
	               |				И ВсеСФ.СчетФактура.ПометкаУдаления
	               |			ТОГДА ""Счет-фактура помечена на удаление!""
	               |		КОГДА ТаблицаНачисления.УчитыватьНДС
	               |				И НЕ ВсеСФ.СчетФактура.Проведен
	               |			ТОГДА ""Счет-фактура не проведена!""
	               |		КОГДА ЕСТЬNULL(КолСФ.КоличествоСФ, 0) > 1
	               |			ТОГДА ""Количество счет-фактур больше одной!""
	               |		КОГДА ВсеСФ.СчетФактура ЕСТЬ NULL 
	               |				И ТаблицаНачисления.УчитыватьНДС
	               |			ТОГДА ""Счет-фактура не оформлен!""
	               |		КОГДА ВсеСФ.СчетФактура ЕСТЬ НЕ NULL 
	               |				И НЕ ТаблицаНачисления.УчитыватьНДС
	               |			ТОГДА ""Счет-фактура не должен быть оформлен (документ не учитывает НДС)!""
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ТаблицаНачисления.Контрагент ЕСТЬ NULL 
	               |					ТОГДА ""Оформлена неверная счет-фактура (контрагента нет в начислениях)!""
	               |				КОГДА ТаблицаНачисления.ДоговорКонтрагента ЕСТЬ NULL 
	               |					ТОГДА ""Оформлена неверная счет-фактура (договора нет в начислениях)!""
	               |				КОГДА ВсеСФ.ВалютаДокумента <> ТаблицаНачисления.ВалютаДокумента
	               |					ТОГДА ""Валюта документа и счет-фактуры различаются!""
	               |				КОГДА ВсеСФ.Курс <> ТаблицаНачисления.Курс
	               |					ТОГДА ""Курс документа и счет-фактуры различаются!""
	               |				КОГДА ВсеСФ.Кратность <> ТаблицаНачисления.Кратность
	               |					ТОГДА ""Кратность документа и счет-фактуры различаются!""
	               |				КОГДА ВсеСФ.СуммаДокумента <> ТаблицаНачисления.СуммаНачисления
	               |					ТОГДА ""Сумма начисления и сумма счет-фактуры различаются!""
	               |				КОГДА ВсеСФ.СуммаНДС <> ТаблицаНачисления.СуммаНДС
	               |					ТОГДА ""Сумма НДС начисления и сумма НДС счет-фактуры различаются!""
	               |				ИНАЧЕ ЛОЖЬ
	               |			КОНЕЦ
	               |	КОНЕЦ КАК Ошибка
	               |ИЗ
	               |	ВсеСФ КАК ВсеСФ
	               |		ПОЛНОЕ СОЕДИНЕНИЕ ТаблицаНачисления КАК ТаблицаНачисления
	               |		ПО ВсеСФ.Контрагент = ТаблицаНачисления.Контрагент
	               |			И ВсеСФ.Договор = ТаблицаНачисления.ДоговорКонтрагента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КолСФ КАК КолСФ
	               |		ПО ВсеСФ.Контрагент = КолСФ.Контрагент
	               |			И ВсеСФ.Договор = КолСФ.Договор";
				   
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("КонтрагентСводнаяСФ", РаботаСоСтудентамиПовтИсп.ПолучитьКонтрагентаДляСводнойСчетФактуры());
	Запрос.УстановитьПараметр("ДокументОснование", ДокументНачисления);
	Запрос.УстановитьПараметр("ЕстьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.УстановитьПараметр("ВалютаДокумента", Справочники.Валюты.НайтиПоКоду("643"));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура СформироватьСчетаФактурыНачисленияРодительскойПлаты(ДокументНачисления, ФормаУправленияСчетамиФактурами) Экспорт 
	
	Счет30304	= ФормаУправленияСчетамиФактурами.Счет30304;
	КПС30304	= ФормаУправленияСчетамиФактурами.КПС30304;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	НачислениеРодительскойПлаты.Ссылка КАК Ссылка,
	               |	НачислениеРодительскойПлаты.Дата КАК Дата,
	               |	НачислениеРодительскойПлаты.Организация КАК Организация,
	               |	НачислениеРодительскойПлаты.СуммаВключаетНДС КАК СуммаВключаетНДС,
	               |	НачислениеРодительскойПлаты.УчитыватьНДС КАК УчитыватьНДС,
	               |	ОтветственныеЛицаРуководитель.ОтветственноеЛицо КАК Руководитель,
	               |	ОтветственныеЛицаГлавныйБухгалтер.ОтветственноеЛицо КАК ГлавныйБухгалтер,
	               |	НачислениеРодительскойПлаты.Подразделение КАК Факультет,
	               |	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КАК ПустоеПодразделение,
	               |	НачислениеРодительскойПлаты.ИФО КАК ИФО,
	               |	НачислениеРодительскойПлаты.Проведен КАК Проведен,
	               |	&Счет30304 КАК Счет30304,
	               |	&КПС30304 КАК КПС30304,
	               |	НачислениеРодительскойПлаты.ГруппаДетскогоУчреждения.Номенклатура КАК Номенклатура,
	               |	НачислениеРодительскойПлаты.ГруппаДетскогоУчреждения.Номенклатура.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	               |	1 КАК Курс,
	               |	1 КАК Кратность,
	               |	&ВалютаДокумента КАК ВалютаДокумента
	               |ИЗ
	               |	Документ.НачислениеРодительскойПлаты КАК НачислениеРодительскойПлаты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&Период, ВидОтветственногоЛица = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)) КАК ОтветственныеЛицаРуководитель
	               |		ПО НачислениеРодительскойПлаты.Организация = ОтветственныеЛицаРуководитель.Организация
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&Период, ВидОтветственногоЛица = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер)) КАК ОтветственныеЛицаГлавныйБухгалтер
	               |		ПО НачислениеРодительскойПлаты.Организация = ОтветственныеЛицаГлавныйБухгалтер.Организация
	               |ГДЕ
	               |	НачислениеРодительскойПлаты.Ссылка = &ДокументНачисления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВЫБОР
	               |		КОГДА НачислениеРодительскойПлатыНачисления.КонтрагентЭДО <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   |			ТОГДА НачислениеРодительскойПлатыНачисления.КонтрагентЭДО
	               |		КОГДА НачислениеРодительскойПлатыНачисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА &КонтрагентСводнаяСФ
	               |		ИНАЧЕ НачислениеРодительскойПлатыНачисления.Контрагент
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА НачислениеРодительскойПлатыНачисления.ДоговорКонтрагентаЭДО <> ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
				   |			ТОГДА НачислениеРодительскойПлатыНачисления.ДоговорКонтрагентаЭДО
	               |		КОГДА НачислениеРодительскойПлатыНачисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |		ИНАЧЕ НачислениеРодительскойПлатыНачисления.ДоговорКонтрагента
	               |	КОНЕЦ КАК ДоговорКонтрагента
	               |ПОМЕСТИТЬ Плательщики
	               |ИЗ
	               |	Документ.НачислениеРодительскойПлаты.Начисления КАК НачислениеРодительскойПлатыНачисления
	               |ГДЕ
	               |	НачислениеРодительскойПлатыНачисления.Ссылка = &ДокументНачисления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СчетФактураВыданный.Ссылка КАК Ссылка,
	               |	СчетФактураВыданный.Контрагент КАК Контрагент,
	               |	СчетФактураВыданный.Договор КАК ДоговорКонтрагента
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |ГДЕ
	               |	(СчетФактураВыданный.Контрагент, СчетФактураВыданный.Договор) В
	               |			(ВЫБРАТЬ
	               |				Плательщики.Контрагент,
	               |				Плательщики.ДоговорКонтрагента
	               |			ИЗ
	               |				Плательщики КАК Плательщики)
	               |	И СчетФактураВыданный.ДокументОснование = &ДокументНачисления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА НачислениеРодительскойПлатыНачисления.КонтрагентЭДО <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
				   |			ТОГДА НачислениеРодительскойПлатыНачисления.КонтрагентЭДО
	               |		КОГДА НачислениеРодительскойПлатыНачисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА &КонтрагентСводнаяСФ
	               |		ИНАЧЕ НачислениеРодительскойПлатыНачисления.Контрагент
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА НачислениеРодительскойПлатыНачисления.ДоговорКонтрагентаЭДО <> ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
				   |			ТОГДА НачислениеРодительскойПлатыНачисления.ДоговорКонтрагентаЭДО
	               |		КОГДА НачислениеРодительскойПлатыНачисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |		ИНАЧЕ НачислениеРодительскойПлатыНачисления.ДоговорКонтрагента
	               |	КОНЕЦ КАК ДоговорКонтрагента,
	               |	НачислениеРодительскойПлатыНачисления.Сумма КАК Сумма,
	               |	1 КАК Количество,
	               |	НачислениеРодительскойПлатыНачисления.СуммаНДС КАК СуммаНДС,
	               |	НачислениеРодительскойПлатыНачисления.СтавкаНДС КАК СтавкаНДС,
	               |	НачислениеРодительскойПлатыНачисления.ИдентификаторЭД КАК ИдентификаторЭД
	               |ИЗ
	               |	Документ.НачислениеРодительскойПлаты.Начисления КАК НачислениеРодительскойПлатыНачисления
	               |ГДЕ
	               |	НачислениеРодительскойПлатыНачисления.Ссылка = &ДокументНачисления
	               |ИТОГИ ПО
	               |	Контрагент,
	               |	ДоговорКонтрагента";
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("Период",  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументНачисления, "Дата"));
	Запрос.УстановитьПараметр("ВалютаДокумента",  Справочники.Валюты.НайтиПоКоду("643"));
	Запрос.УстановитьПараметр("ДокументНачисления", ДокументНачисления);           
	Запрос.УстановитьПараметр("КонтрагентСводнаяСФ", РаботаСоСтудентамиПовтИсп.ПолучитьКонтрагентаДляСводнойСчетФактуры());
	Запрос.УстановитьПараметр("Счет30304",Счет30304);
	Запрос.УстановитьПараметр("КПС30304",КПС30304);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ШапкаОснования = МассивРезультатов[0].Выбрать(); 
	ТаблицаНайденныхСФ = МассивРезультатов[2].Выгрузить();
	ВыборкаТребуемыхНачислений = МассивРезультатов[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ШапкаОснования.Следующий();	
	ОбработатьСФНаПлательщика(ШапкаОснования, ТаблицаНайденныхСФ, ВыборкаТребуемыхНачислений, ФормаУправленияСчетамиФактурами);
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// НАЧИСЛЕНИЕ ДОХОДОВ

Функция ПолучитьТаблицуСчетовФактурПоНачислениюДоходовСКомментариями(ДокументНачисления) Экспорт 
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СчетФактураВыданный.Организация,
	               |	СчетФактураВыданный.Подразделение,
	               |	СчетФактураВыданный.Контрагент,
	               |	СчетФактураВыданный.Договор,
	               |	СчетФактураВыданный.Ссылка КАК СчетФактура,
	               |	СчетФактураВыданный.СуммаДокумента,
	               |	СчетФактураВыданный.СуммаНДС,
	               |	СчетФактураВыданный.СуммаВключаетНДС,
	               |	СчетФактураВыданный.ВалютаДокумента,
	               |	СчетФактураВыданный.ПометкаУдаления,
	               |	СчетФактураВыданный.Проведен,
	               |	ОперацииДокументов.Курс КАК Курс,
	               |	ОперацииДокументов.Кратность КАК Кратность,
	               |	СчетФактураВыданный.ИФО
	               |ПОМЕСТИТЬ ВсеСФ
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	               |		ПО СчетФактураВыданный.Ссылка = ОперацииДокументов.Документ
	               |ГДЕ
	               |	СчетФактураВыданный.ДокументОснование = &ДокументОснование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВсеСФ.Контрагент КАК Контрагент,
	               |	ВсеСФ.Договор КАК Договор,
	               |	КОЛИЧЕСТВО(ВсеСФ.СчетФактура) КАК КоличествоСФ
	               |ПОМЕСТИТЬ КолСФ
	               |ИЗ
	               |	ВсеСФ КАК ВсеСФ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВсеСФ.Контрагент,
	               |	ВсеСФ.Договор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА Начисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА &КонтрагентСводнаяСФ
	               |		ИНАЧЕ Начисления.Контрагент
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА Начисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |		ИНАЧЕ Начисления.ДоговорКонтрагента
	               |	КОНЕЦ КАК ДоговорКонтрагента,
	               |	СУММА(Начисления.СуммаНДС) КАК СуммаНДС,
	               |	Начисления.Ссылка.УчитыватьНДС КАК УчитыватьНДС,
	               |	Начисления.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	               |	СУММА(Начисления.Всего) КАК СуммаНачисления,
	               |	Начисления.Ссылка.ВалютаДокумента,
	               |	ОперацииДокументов.Курс КАК Курс,
	               |	ОперацииДокументов.Кратность КАК Кратность,
	               |	Начисления.Ссылка.Организация,
	               |	Начисления.Ссылка.Подразделение,
	               |	Начисления.Ссылка.ИФО,
	               |	Начисления.Ссылка.Проведен
	               |ПОМЕСТИТЬ ТаблицаНачисления
	               |ИЗ
	               |	Документ.НачислениеДоходов.Начисления КАК Начисления
				   |	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	               |		ПО Начисления.Ссылка = ОперацииДокументов.Документ
	               |ГДЕ
	               |	Начисления.Ссылка = &ДокументОснование
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВЫБОР
	               |		КОГДА Начисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА &КонтрагентСводнаяСФ
	               |		ИНАЧЕ Начисления.Контрагент
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА Начисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |		ИНАЧЕ Начисления.ДоговорКонтрагента
	               |	КОНЕЦ,
	               |	Начисления.Ссылка.УчитыватьНДС,
	               |	Начисления.Ссылка.СуммаВключаетНДС,
	               |	Начисления.Ссылка.ВалютаДокумента,
	               |	ОперацииДокументов.Курс,
	               |	ОперацииДокументов.Кратность,
	               |	Начисления.Ссылка.Организация,
	               |	Начисления.Ссылка.Подразделение,
	               |	Начисления.Ссылка.ИФО,
	               |	Начисления.Ссылка.Проведен
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ВсеСФ.Контрагент ЕСТЬ NULL 
	               |			ТОГДА ТаблицаНачисления.Контрагент
	               |		ИНАЧЕ ВсеСФ.Контрагент
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА ВсеСФ.Договор ЕСТЬ NULL 
	               |			ТОГДА ТаблицаНачисления.ДоговорКонтрагента
	               |		ИНАЧЕ ВсеСФ.Договор
	               |	КОНЕЦ КАК ДоговорКонтрагента,
	               |	ЕСТЬNULL(ВсеСФ.СчетФактура, ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)) КАК СчетФактура,
	               |	ВЫБОР
	               |		КОГДА НЕ ТаблицаНачисления.УчитыватьНДС
	               |				И (ВсеСФ.СчетФактура.ПометкаУдаления
	               |					ИЛИ НЕ ВсеСФ.Проведен)
	               |			ТОГДА ЛОЖЬ
	               |		КОГДА НЕ ТаблицаНачисления.Проведен
	               |				И НЕ ВсеСФ.Проведен
	               |			ТОГДА ЛОЖЬ
	               |		КОГДА НЕ ТаблицаНачисления.Проведен
	               |				И ВсеСФ.Проведен
	               |			ТОГДА ""Документ начисления не проведен, счет-фактура проведена!""
	               |		КОГДА ТаблицаНачисления.Организация <> ВсеСФ.Организация
	               |			ТОГДА ""Различаются организации в документе начисления и счет-фактуре!""
	               |		КОГДА &ЕстьУчетПоПодразделениям
	               |				И ТаблицаНачисления.Подразделение <> ВсеСФ.Подразделение
	               |			ТОГДА ""Различаются подразделения в документе начисления и счет-фактуре!""
	               |		КОГДА &ЕстьУчетПоИФО И ТаблицаНачисления.ИФО <> ВсеСФ.ИФО
	               |			ТОГДА ""Различаются ИФО в документе начисления и счет-фактуре!""
	               |		КОГДА ТаблицаНачисления.УчитыватьНДС
	               |				И ВсеСФ.СчетФактура.ПометкаУдаления
	               |			ТОГДА ""Счет-фактура помечена на удаление!""
	               |		КОГДА ТаблицаНачисления.УчитыватьНДС
	               |				И НЕ ВсеСФ.СчетФактура.Проведен
	               |			ТОГДА ""Счет-фактура не проведена!""
	               |		КОГДА ЕСТЬNULL(КолСФ.КоличествоСФ, 0) > 1
	               |			ТОГДА ""Количество счет-фактур больше одной!""
	               |		КОГДА ВсеСФ.СчетФактура ЕСТЬ NULL 
	               |				И ТаблицаНачисления.УчитыватьНДС
	               |			ТОГДА ""Счет-фактура не оформлен!""
	               |		КОГДА ВсеСФ.СчетФактура ЕСТЬ НЕ NULL 
	               |				И НЕ ТаблицаНачисления.УчитыватьНДС
	               |			ТОГДА ""Счет-фактура не должен быть оформлен (документ не учитывает НДС)!""
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ТаблицаНачисления.Контрагент ЕСТЬ NULL 
	               |					ТОГДА ""Оформлена неверная счет-фактура (контрагента нет в начислениях)!""
	               |				КОГДА ТаблицаНачисления.ДоговорКонтрагента ЕСТЬ NULL 
	               |					ТОГДА ""Оформлена неверная счет-фактура (договора нет в начислениях)!""
	               |				КОГДА ВсеСФ.ВалютаДокумента <> ТаблицаНачисления.ВалютаДокумента
	               |					ТОГДА ""Валюта документа и счет-фактуры различаются!""
	               |				КОГДА ВсеСФ.Курс <> ТаблицаНачисления.Курс
	               |					ТОГДА ""Курс документа и счет-фактуры различаются!""
	               |				КОГДА ВсеСФ.Кратность <> ТаблицаНачисления.Кратность
	               |					ТОГДА ""Кратность документа и счет-фактуры различаются!""
	               |				КОГДА ВсеСФ.СуммаДокумента <> ТаблицаНачисления.СуммаНачисления
	               |					ТОГДА ""Сумма начисления и сумма счет-фактуры различаются!""
	               |				КОГДА ВсеСФ.СуммаНДС <> ТаблицаНачисления.СуммаНДС
	               |					ТОГДА ""Сумма НДС начисления и сумма НДС счет-фактуры различаются!""
	               |				ИНАЧЕ ЛОЖЬ
	               |			КОНЕЦ
	               |	КОНЕЦ КАК Ошибка
	               |ИЗ
	               |	ВсеСФ КАК ВсеСФ
	               |		ПОЛНОЕ СОЕДИНЕНИЕ ТаблицаНачисления КАК ТаблицаНачисления
	               |		ПО ВсеСФ.Контрагент = ТаблицаНачисления.Контрагент
	               |			И ВсеСФ.Договор = ТаблицаНачисления.ДоговорКонтрагента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КолСФ КАК КолСФ
	               |		ПО ВсеСФ.Контрагент = КолСФ.Контрагент
	               |			И ВсеСФ.Договор = КолСФ.Договор";
				   
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("ДокументОснование", ДокументНачисления);
	Запрос.УстановитьПараметр("ЕстьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.УстановитьПараметр("ЕстьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("КонтрагентСводнаяСФ", РаботаСоСтудентамиПовтИсп.ПолучитьКонтрагентаДляСводнойСчетФактуры());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура СформироватьСчетаФактурыНачисленияДоходов(ДокументНачисления, ФормаУправленияСчетамиФактурами) Экспорт 
	
	Счет30304	= ФормаУправленияСчетамиФактурами.Счет30304;
	КПС30304	= ФормаУправленияСчетамиФактурами.КПС30304;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НачислениеДоходов.Ссылка КАК Ссылка,
	               |	НачислениеДоходов.Дата КАК Дата,
	               |	НачислениеДоходов.Организация КАК Организация,
	               |	НачислениеДоходов.СуммаВключаетНДС КАК СуммаВключаетНДС,
	               |	НачислениеДоходов.УчитыватьНДС КАК УчитыватьНДС,
	               |	ОтветственныеЛицаРуководитель.ОтветственноеЛицо КАК Руководитель,
	               |	ОтветственныеЛицаГлавныйБухгалтер.ОтветственноеЛицо КАК ГлавныйБухгалтер,
	               |	НачислениеДоходов.Подразделение КАК Факультет,
	               |	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КАК ПустоеПодразделение,
	               |	НачислениеДоходов.ИФО КАК ИФО,
	               |	НачислениеДоходов.Проведен КАК Проведен,
	               |	&Счет30304 КАК Счет30304,
	               |	&КПС30304 КАК КПС30304,
	               |	НачислениеДоходов.Номенклатура КАК Номенклатура,
	               |	НачислениеДоходов.Номенклатура.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	               |	ОперацииДокументов.Курс КАК Курс,
	               |	ОперацииДокументов.Кратность КАК Кратность,
	               |	НачислениеДоходов.ВалютаДокумента КАК ВалютаДокумента
	               |ИЗ
	               |	Документ.НачислениеДоходов КАК НачислениеДоходов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&Период, ВидОтветственногоЛица = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)) КАК ОтветственныеЛицаРуководитель
	               |		ПО НачислениеДоходов.Организация = ОтветственныеЛицаРуководитель.Организация
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&Период, ВидОтветственногоЛица = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер)) КАК ОтветственныеЛицаГлавныйБухгалтер
	               |		ПО НачислениеДоходов.Организация = ОтветственныеЛицаГлавныйБухгалтер.Организация
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	               |		ПО НачислениеДоходов.Ссылка = ОперацииДокументов.Документ
	               |ГДЕ
	               |	НачислениеДоходов.Ссылка = &ДокументНачисления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВЫБОР
	               |		КОГДА НачислениеДоходов.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА &КонтрагентСводнаяСФ
	               |		ИНАЧЕ НачислениеДоходов.Контрагент
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА НачислениеДоходов.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |		ИНАЧЕ НачислениеДоходов.ДоговорКонтрагента
	               |	КОНЕЦ КАК ДоговорКонтрагента
	               |ПОМЕСТИТЬ Плательщики
	               |ИЗ
	               |	Документ.НачислениеДоходов.Начисления КАК НачислениеДоходов
	               |ГДЕ
	               |	НачислениеДоходов.Ссылка = &ДокументНачисления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СчетФактураВыданный.Ссылка КАК Ссылка,
	               |	СчетФактураВыданный.Контрагент КАК Контрагент,
	               |	СчетФактураВыданный.Договор КАК ДоговорКонтрагента
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |ГДЕ
	               |	(СчетФактураВыданный.Контрагент, СчетФактураВыданный.Договор) В
	               |			(ВЫБРАТЬ
	               |				Плательщики.Контрагент,
	               |				Плательщики.ДоговорКонтрагента
	               |			ИЗ
	               |				Плательщики КАК Плательщики)
	               |	И СчетФактураВыданный.ДокументОснование = &ДокументНачисления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА НачислениеДоходов.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА &КонтрагентСводнаяСФ
	               |		ИНАЧЕ НачислениеДоходов.Контрагент
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА НачислениеДоходов.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |		ИНАЧЕ НачислениеДоходов.ДоговорКонтрагента
	               |	КОНЕЦ КАК ДоговорКонтрагента,
	               |	НачислениеДоходов.Сумма КАК Сумма,
	               |	НачислениеДоходов.СуммаНДС КАК СуммаНДС,
	               |	НачислениеДоходов.Ссылка.СтавкаНДС КАК СтавкаНДС,
	               |	НачислениеДоходов.Количество КАК Количество,
	               |	НачислениеДоходов.ИдентификаторЭД КАК ИдентификаторЭД
	               |ИЗ
	               |	Документ.НачислениеДоходов.Начисления КАК НачислениеДоходов
	               |ГДЕ
	               |	НачислениеДоходов.Ссылка = &ДокументНачисления
	               |ИТОГИ ПО
	               |	Контрагент,
	               |	ДоговорКонтрагента";
	 
	Запрос.УстановитьПараметр("Период",  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументНачисления, "Дата"));
	Запрос.УстановитьПараметр("ДокументНачисления", ДокументНачисления);           
	Запрос.УстановитьПараметр("Счет30304",Счет30304);
	Запрос.УстановитьПараметр("КПС30304",КПС30304);
	Запрос.УстановитьПараметр("КонтрагентСводнаяСФ", РаботаСоСтудентамиПовтИсп.ПолучитьКонтрагентаДляСводнойСчетФактуры());
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ШапкаОснования = МассивРезультатов[0].Выбрать(); 
	ТаблицаНайденныхСФ = МассивРезультатов[2].Выгрузить();
	ВыборкаТребуемыхНачислений = МассивРезультатов[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ШапкаОснования.Следующий();	
	
	ОбработатьСФНаПлательщика(ШапкаОснования, ТаблицаНайденныхСФ, ВыборкаТребуемыхНачислений, ФормаУправленияСчетамиФактурами);
	
КонецПроцедуры


Функция ПолучитьВладельцаДляЗначенийПолейПриказов(ИмяХарактеристики = "") Экспорт
	Если ИмяХарактеристики = "" Тогда
		Возврат ПланыВидовХарактеристик.ПоляПриказовОбразование.ПустаяСсылка();
	КонецЕсли;
	
	Характеристика = ПланыВидовХарактеристик.ПоляПриказовОбразование.НайтиПоНаименованию(ИмяХарактеристики);
	
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Возврат Характеристика;
	Иначе
		Возврат ПланыВидовХарактеристик.ПоляПриказовОбразование.ПустаяСсылка();
	КонецЕсли;
КонецФункции



