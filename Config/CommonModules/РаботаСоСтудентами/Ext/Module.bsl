// ПРОЦЕДУРЫ ПРОВЕДЕНИЯ ДОКУМЕНТОВ

// Процедура формирования движений по регистру "Начисления образование (последовательность)".
//
// Параметры:
//	ДокументОбъект - Текущий документ
// ПринадлежностьПоследовательностям - 
//	Отказ - Булево - Признак отказа от проведения документа
//
Процедура ОтразитьНачисленияОбразованиеПоследовательность(ДополнительныеСвойства, ПринадлежностьПоследовательностям, Отказ) Экспорт
	
	ТаблицаНачисления = ДополнительныеСвойства.ТаблицыДляДвижений.НачисленияОбразованиеПоследовательность;
	ПоследовательностьНачисления = ПринадлежностьПоследовательностям.НачисленияОбразование;
	ПоследовательностьНачисления.Очистить();
	
	Если Отказ ИЛИ ТаблицаНачисления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоследовательностьНачисления.Отбор.Регистратор.Установить(ДополнительныеСвойства.ДляПроведения.Ссылка);
	
	Для Каждого СтрокаТаблицы ИЗ ТаблицаНачисления Цикл
		
		НоваяЗапись = ПоследовательностьНачисления.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры



