// ВЫЧИСЛЯЕМЫЕ ПОЛЯ ОТЧЕТОВ

Функция ФакультетСтудентаНаДату(НачалоПериода, КонецПериода, Организация, Студент, ПериодДень) Экспорт
	ТаблицаПоиска = РаботаСоСтудентамиПовтИсп.ТаблицаСтудентовФакультетов(НачалоПериода, КонецПериода, Организация);
	
	Если ТаблицаПоиска.Количество() = 0 Тогда
		Возврат Справочники.Подразделения.ПустаяСсылка();
	КонецЕсли;
	
	Строки = ТаблицаПоиска.НайтиСтроки(Новый Структура("Студент", Студент));
	
	Если Строки.Количество() = 0 Тогда
		Возврат Справочники.Подразделения.ПустаяСсылка();
	ИначеЕсли Строки.Количество() = 1 Тогда
		Возврат Строки[0].Факультет;
	Иначе
		МинИнтервал = (ПериодДень - Строки[0].Период);
		Индекс = 0;
		
		Для К = 1 По Строки.Количество() - 1 Цикл
			Стр = Строки[К];
			
			Если (ПериодДень - Стр.Период > 0) И (ПериодДень - Стр.Период < МинИнтервал) Тогда
				Индекс = К;
				МинИнтервал = (ПериодДень - Стр.Период);
			КонецЕсли;
		КонецЦикла;
		
		Возврат Строки[Индекс].Факультет;
	КонецЕсли;
	
	Возврат Справочники.Подразделения.ПустаяСсылка();
КонецФункции
