	                      |	ВидыПриказовОбразование.Ссылка,
	                      |	ВидыПриказовОбразование.Наименование
	                      |ИЗ
	                      |	Справочник.ВидыПриказовОбразование КАК ВидыПриказовОбразование
	                      |ГДЕ
	                      |	НЕ ВидыПриказовОбразование.ЭтоГруппа");
	ВидыПриказов = Запрос.Выполнить().Выгрузить();
	
	// Зачисление (краткосрочный договор)
	МассивСтрок = ВидыПриказов.НайтиСтроки(Новый Структура("Наименование", "Зачисление"));
	МассивСтрок2 = ВидыПриказов.НайтиСтроки(Новый Структура("Наименование", "Зачисление (краткосрочный договор)"));
	Если МассивСтрок.Количество() > 0 Тогда
		ВидПриказа = МассивСтрок[0].Ссылка.ПолучитьОбъект();
	ИначеЕсли МассивСтрок2.Количество() > 0 Тогда
		ВидПриказа = МассивСтрок2[0].Ссылка.ПолучитьОбъект();
	Иначе	
