//////////////////////////////////////////////////////////////////////////////// 
// ЭКСПОРТНЫЕ ПРОЦЕДУРЫ МОДУЛЯ

// Возвращает основной факультет обучения студента.
//
Функция ФакультетСтудента(Студент, НаДату, Договор = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СведенияОСтудентахСрезПоследних.Факультет КАК Факультет
	|ИЗ
	|	РегистрСведений.СведенияОСтудентах.СрезПоследних(&НаДату, Студент = &Студент И &УсловиеДоговор) КАК СведенияОСтудентахСрезПоследних";
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("Студент", Студент);
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор",
		?(ЗначениеЗаполнено(Договор), "Договор = &Договор", "ИСТИНА") );
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Факультет;
	Иначе
		Возврат Справочники.Подразделения.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Функция СписокДоговоровПоПлательщику(Контрагент, Организация = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПлательщикиПоДоговоруОбразование.Контрагент КАК Плательщик,
	|	ПлательщикиПоДоговоруОбразование.Организация КАК Организация,
	|	ПлательщикиПоДоговоруОбразование.Студент КАК Студент,
	|	ПлательщикиПоДоговоруОбразование.Договор КАК Договор
	|ИЗ
	|	РегистрСведений.ПлательщикиПоДоговоруОбразование КАК ПлательщикиПоДоговоруОбразование
	|ГДЕ
	|	&УсловиеОрганизация
	|	И ПлательщикиПоДоговоруОбразование.Контрагент = &Контрагент
	|	И ПлательщикиПоДоговоруОбразование.Активность = ИСТИНА";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизация",
		?(ЗначениеЗаполнено(Организация), "Организация = &Организация", "ИСТИНА") );
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СписокПлательщиковПоДоговору(Договор, Студент = Неопределено, НаДату = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПлательщикиПоДоговоруОбразованиеСрезПоследних.Организация КАК Организация,
	|	ПлательщикиПоДоговоруОбразованиеСрезПоследних.Студент КАК Студент,
	|	ПлательщикиПоДоговоруОбразованиеСрезПоследних.Договор КАК Договор,
	|	ПлательщикиПоДоговоруОбразованиеСрезПоследних.Контрагент КАК Контрагент,
	|	ПлательщикиПоДоговоруОбразованиеСрезПоследних.ДоляОплаты КАК ДоляОплаты,
	|	ПлательщикиПоДоговоруОбразованиеСрезПоследних.ПорядокВыпискиСФ КАК ПорядокВыпискиСФ
	|ИЗ
	|	РегистрСведений.ПлательщикиПоДоговоруОбразование.СрезПоследних(
	|			&НаДату,
	|			Договор = &Договор
	|				И &УсловиеСтудент) КАК ПлательщикиПоДоговоруОбразованиеСрезПоследних";
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Студент", Студент);
	Запрос.УстановитьПараметр("НаДату", НаДату);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСтудент",
		?(ЗначениеЗаполнено(Студент), "Студент = &Студент", "ИСТИНА") );
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СписокПлательщиковФизлицПоСтуденту(Студент, НаДату = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПлательщикиПоДоговоруОбразованиеСрезПоследних.Организация КАК Организация,
	|	ПлательщикиПоДоговоруОбразованиеСрезПоследних.Студент КАК Студент,
	|	ПлательщикиПоДоговоруОбразованиеСрезПоследних.Договор КАК Договор,
	|	ПлательщикиПоДоговоруОбразованиеСрезПоследних.Контрагент КАК Контрагент,
	|	ПлательщикиПоДоговоруОбразованиеСрезПоследних.ДоляОплаты КАК ДоляОплаты,
	|	ПлательщикиПоДоговоруОбразованиеСрезПоследних.ПорядокВыпискиСФ КАК ПорядокВыпискиСФ
	|ИЗ
	|	РегистрСведений.ПлательщикиПоДоговоруОбразование.СрезПоследних(
	|			&НаДату,
	|			Студент = &Студент
	|				И Контрагент.ВидКонтрагента = &ВидКонтрагента) КАК ПлательщикиПоДоговоруОбразованиеСрезПоследних";
	
	Запрос.УстановитьПараметр("Студент", Студент);
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("ВидКонтрагента", Перечисления.ЮрФизЛицо.ФизЛицо);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ГрафикНачисленийПоДолгосрочнымДоговорам(Договоры, Организация, НаДату, НачалоПериода = Неопределено, КонецПериода = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПериодДвижений.Период КАК Период,
	|	ПериодДвижений.Организация КАК Организация,
	|	ПериодДвижений.Договор КАК Договор
	|ПОМЕСТИТЬ СрезПоследних
	|ИЗ
	|	РегистрСведений.ПорядокОплатыОбразование.СрезПоследних(
	|			&ДатаСреза,
	|			Активность = ИСТИНА
	|				И Организация = &Организация
	|				И Договор В (&Договоры)) КАК ПериодДвижений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПериодДвижений.Период КАК Период,
	|	ПериодДвижений.Организация КАК Организация,
	|	ПериодДвижений.Договор КАК Договор
	|ПОМЕСТИТЬ ПериодДвижений
	|ИЗ
	|	СрезПоследних КАК ПериодДвижений
	|ГДЕ
	|	ПериодДвижений.Период В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				Т.Период
	|			ИЗ
	|				СрезПоследних КАК Т
	|			ГДЕ
	|				Т.Договор = ПериодДвижений.Договор
	|			УПОРЯДОЧИТЬ ПО
	|				Т.Период УБЫВ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПорядокОплатыОбразование.Период КАК Период,
	|	МЕСЯЦ(ПорядокОплатыОбразование.КонецПериода) КАК ПериодНачисления,
	|	ПорядокОплатыОбразование.Организация КАК Организация,
	|	ПорядокОплатыОбразование.Договор КАК Договор,
	|	ПорядокОплатыОбразование.Учащийся КАК Учащийся,
	|	ПорядокОплатыОбразование.Контрагент КАК Контрагент,
	|	ПорядокОплатыОбразование.Факультет КАК Факультет,
	|	ПорядокОплатыОбразование.Валюта КАК Валюта,
	|	СУММА(ПорядокОплатыОбразование.СуммаВВалюте) КАК СуммаВВалюте
	|ИЗ
	|	ПериодДвижений КАК ПериодДвижений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОплатыОбразование КАК ПорядокОплатыОбразование
	|		ПО ПериодДвижений.Период = ПорядокОплатыОбразование.Период
	|			И ПериодДвижений.Организация = ПорядокОплатыОбразование.Организация
	|			И ПериодДвижений.Договор = ПорядокОплатыОбразование.Договор
	|ГДЕ
	|	ПорядокОплатыОбразование.Активность = ИСТИНА
	|	И &УсловиеНачалоПериода
	|	И &УсловиеКонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	ПорядокОплатыОбразование.Период,
	|	ПорядокОплатыОбразование.Организация,
	|	ПорядокОплатыОбразование.Договор,
	|	ПорядокОплатыОбразование.Учащийся,
	|	ПорядокОплатыОбразование.Контрагент,
	|	ПорядокОплатыОбразование.Факультет,
	|	ПорядокОплатыОбразование.Валюта,
	|	МЕСЯЦ(ПорядокОплатыОбразование.КонецПериода)";
	
	Запрос.УстановитьПараметр("ДатаСреза",   КонецДня(НаДату));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Договоры",    Договоры);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНачалоПериода",
		?(ЗначениеЗаполнено(Организация), "ПорядокОплатыОбразование.КонецПериода >= &НачалоПериода", "ИСТИНА") );
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонецПериода",
		?(ЗначениеЗаполнено(Организация), "ПорядокОплатыОбразование.КонецПериода <= &КонецПериода", "ИСТИНА") );
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПараметрыНачисленийЗаПрочиеУслуги(НачислениеЗаУслугу, НаДату = Неопределено) Экспорт
	
	ПараметрыНачисленияЗаУслугу = Новый Структура(
		"Ссылка,ВидНачисления,РазовоеНачисление,Номенклатура,УчитыватьНДС,СтавкаНДС,СтавкаОплаты,ГрафикОплаты");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.Ссылка КАК Ссылка,
	|	Начисления.Код КАК Код,
	|	Начисления.Наименование КАК Наименование,
	|	Начисления.ВидНачисления КАК ВидНачисления,
	|	Начисления.РазовоеНачисление КАК РазовоеНачисление,
	|	Начисления.Номенклатура КАК Номенклатура,
	|	Начисления.УчитыватьНДС КАК УчитыватьНДС,
	|	Начисления.СтавкаНДС КАК СтавкаНДС,
	|	ПараметрыНачислений.СтавкаОплаты КАК СтавкаОплаты,
	|	ПараметрыНачислений.ГрафикОплаты КАК ГрафикОплаты
	|ИЗ
	|	Справочник.НачисленияСтудентамЗаПрочиеУслуги КАК Начисления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыНачисленийЗаПрочиеУслугиСтудентам.СрезПоследних(&НаДату, НачислениеСтудентамЗаПрочиеУслуги = &НачислениеЗаУслугу) КАК ПараметрыНачислений
	|		ПО Начисления.Ссылка = ПараметрыНачислений.НачислениеСтудентамЗаПрочиеУслуги
	|ГДЕ
	|	Начисления.Ссылка = &НачислениеЗаУслугу";
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("НачислениеЗаУслугу", НачислениеЗаУслугу);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(ПараметрыНачисленияЗаУслугу, Результат,
			"Ссылка,ВидНачисления,РазовоеНачисление,Номенклатура,УчитыватьНДС,СтавкаНДС");
		Если ПараметрыНачисленияЗаУслугу.ВидНачисления = Перечисления.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам Тогда
			ПараметрыНачисленияЗаУслугу.ГрафикОплаты = Результат.ГрафикОплаты;
		Иначе
			ПараметрыНачисленияЗаУслугу.СтавкаОплаты = Результат.СтавкаОплаты;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПараметрыНачисленияЗаУслугу;
	
КонецФункции

Функция СведенияОДоговорахСтудентов(Договоры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договоры", Договоры);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасчетыСоСтудентами.ДоговорКонтрагента КАК Договор,
	|	РасчетыСоСтудентами.Студент КАК Студент,
	|	РасчетыСоСтудентами.Факультет КАК Факультет,
	|	ЛОЖЬ КАК ЭтоДоговорСтудентаЗаПрочиеУслуги,
	|	НЕОПРЕДЕЛЕНО КАК НачислениеЗаУслугу
	|ИЗ
	|	РегистрНакопления.РасчетыСоСтудентами КАК РасчетыСоСтудентами
	|ГДЕ
	|	РасчетыСоСтудентами.ДоговорКонтрагента В(&Договоры)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасчетыСоСтудентамиДопУслуги.ДоговорКонтрагента,
	|	РасчетыСоСтудентамиДопУслуги.Студент,
	|	РасчетыСоСтудентамиДопУслуги.Факультет,
	|	ИСТИНА,
	|	РасчетыСоСтудентамиДопУслуги.НачислениеЗаУслугу
	|ИЗ
	|	РегистрНакопления.РасчетыСоСтудентамиДопУслуги КАК РасчетыСоСтудентамиДопУслуги
	|ГДЕ
	|	РасчетыСоСтудентамиДопУслуги.ДоговорКонтрагента В(&Договоры)";
	
	ДоговорыСтудентов = Запрос.Выполнить().Выгрузить();
	ДоговорыСтудентов.Индексы.Добавить("Договор");
	
	Возврат ДоговорыСтудентов;
	
КонецФункции

Функция СведенияОПрочихУслугахСтуденту(Студент, Плательщик = Неопределено, Договор = Неопределено, НаДату = Неопределено, Факультет = Неопределено, НачислениеЗаУслугу = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СведенияОПрочихУслугахСтудентам.Студент КАК Студент,
	|	СведенияОПрочихУслугахСтудентам.Факультет КАК Факультет,
	|	СведенияОПрочихУслугахСтудентам.Договор КАК Договор,
	|	СведенияОПрочихУслугахСтудентам.Плательщик КАК Плательщик,
	|	СведенияОПрочихУслугахСтудентам.НачислениеСтудентамЗаПрочиеУслуги КАК НачислениеСтудентамЗаПрочиеУслуги,
	|	СведенияОПрочихУслугахСтудентам.Льгота КАК Льгота,
	|	СведенияОПрочихУслугахСтудентам.ПорядокВыпискиСФ КАК ПорядокВыпискиСФ
	|ИЗ
	|	РегистрСведений.СведенияОПрочихУслугахСтудентам КАК СведенияОПрочихУслугахСтудентам
	|ГДЕ
	|	СведенияОПрочихУслугахСтудентам.Студент = &Студент";
	Запрос.УстановитьПараметр("Студент", Студент);
	
	Если ЗначениеЗаполнено(Плательщик) Тогда
		Запрос.УстановитьПараметр("Плательщик", Плательщик);
		Запрос.Текст = Запрос.Текст + "
			|	И СведенияОПрочихУслугахСтудентам.Плательщик = &Плательщик";
	КонецЕсли;
	Если ЗначениеЗаполнено(Договор) Тогда
		Запрос.УстановитьПараметр("Договор", Договор);
		Запрос.Текст = Запрос.Текст + "
			|	И СведенияОПрочихУслугахСтудентам.Договор = &Договор";
	КонецЕсли;
	Если ЗначениеЗаполнено(НачислениеЗаУслугу) Тогда
		Запрос.УстановитьПараметр("НачислениеЗаУслугу", НачислениеЗаУслугу);
		Запрос.Текст = Запрос.Текст + "
			|	И СведенияОПрочихУслугахСтудентам.НачислениеСтудентамЗаПрочиеУслуги = &НачислениеЗаУслугу";
	КонецЕсли;
	Если ЗначениеЗаполнено(НаДату) Тогда
		Запрос.УстановитьПараметр("НаДату", НаДату);
		Запрос.Текст = Запрос.Текст + "
			|	И СведенияОПрочихУслугахСтудентам.НачалоНачисления <= &НаДату
			|	И СведенияОПрочихУслугахСтудентам.ОкончаниеНачисления >= &НаДату";
	КонецЕсли;
	
	СведенияОПрочихУслугах = Запрос.Выполнить().Выгрузить();
	
	ОсновнойФакультет = РаботаСоСтудентами.ФакультетСтудента(Студент, НаДату, Договор);
	Для Каждого СтрокаТаблицы Из СведенияОПрочихУслугах Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Факультет) Тогда
			СтрокаТаблицы.Факультет = ОсновнойФакультет;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Факультет) Тогда
		Отбор = Новый Структура("Факультет", Факультет);
		СведенияОПрочихУслугах = СведенияОПрочихУслугах.Скопировать(Отбор);
	КонецЕсли;
	
	Возврат СведенияОПрочихУслугах;
	
КонецФункции

Функция СведенияОбОбразовательныхУслугахСтуденту(Студент, Плательщик = Неопределено, Договор = Неопределено, НаДату = Неопределено, Факультет = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПлательщикиПоДоговоруОбразование.Студент КАК Студент,
	|	ПлательщикиПоДоговоруОбразование.Договор КАК Договор,
	|	ПлательщикиПоДоговоруОбразование.Контрагент КАК Плательщик
	|ПОМЕСТИТЬ ПлательщикиПоДоговоруОбразование
	|ИЗ
	|	РегистрСведений.ПлательщикиПоДоговоруОбразование.СрезПоследних(&Период, Студент = &Учащийся) КАК ПлательщикиПоДоговоруОбразование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СведенияОСтудентах.Студент КАК Студент,
	|	СведенияОСтудентах.Договор КАК Договор,
	|	СведенияОСтудентах.Факультет КАК Факультет
	|ПОМЕСТИТЬ СведенияОСтудентах
	|ИЗ
	|	РегистрСведений.СведенияОСтудентах.СрезПоследних(&Период, Студент = &Учащийся) КАК СведенияОСтудентах
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПлательщикиПоДоговоруОбразование.Студент КАК Студент,
	|	ПлательщикиПоДоговоруОбразование.Договор КАК Договор,
	|	ПлательщикиПоДоговоруОбразование.Плательщик КАК Плательщик,
	|	СведенияОСтудентах.Факультет КАК Факультет
	|ИЗ
	|	ПлательщикиПоДоговоруОбразование КАК ПлательщикиПоДоговоруОбразование
	|		ЛЕВОЕ СОЕДИНЕНИЕ СведенияОСтудентах КАК СведенияОСтудентах
	|		ПО ПлательщикиПоДоговоруОбразование.Студент = СведенияОСтудентах.Студент
	|			И ПлательщикиПоДоговоруОбразование.Договор = СведенияОСтудентах.Договор
	|
	|СГРУППИРОВАТЬ ПО
	|	ПлательщикиПоДоговоруОбразование.Договор,
	|	ПлательщикиПоДоговоруОбразование.Студент,
	|	ПлательщикиПоДоговоруОбразование.Плательщик,
	|	СведенияОСтудентах.Факультет";
	Запрос.УстановитьПараметр("Учащийся", Студент);
	Запрос.УстановитьПараметр("Период", НаДату);
	
	Если ЗначениеЗаполнено(Плательщик) Тогда
		Запрос.УстановитьПараметр("Плательщик", Плательщик);
		Запрос.Текст = Запрос.Текст + "
			|	И СведенияОбОбразовательныхУслугах.Контрагент = &Плательщик";
	КонецЕсли;
	Если ЗначениеЗаполнено(Договор) Тогда
		Запрос.УстановитьПараметр("Договор", Договор);
		Запрос.Текст = Запрос.Текст + "
			|	И СведенияОбОбразовательныхУслугах.Договор = &Договор";
	КонецЕсли;
	Если ЗначениеЗаполнено(Факультет) Тогда
		Запрос.УстановитьПараметр("Факультет", Факультет);
		Запрос.Текст = Запрос.Текст + "
			|
			|ИМЕЮЩИЕ
			|	СведенияОСтудентах.Факультет = &Факультет";
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПараметрыАвтоподстановкиДанныхПоСтуденту(Студент, ВидУслуг = "", Отбор = Неопределено) Экспорт
	
	ПараметрыАвтоподстановки = Новый Структура;
	ПараметрыАвтоподстановки.Вставить("Договоры", Новый Массив);
	ПараметрыАвтоподстановки.Вставить("Плательщики", Новый Массив);
	ПараметрыАвтоподстановки.Вставить("Факультеты", Новый Массив);
	ПараметрыАвтоподстановки.Вставить("ПрочиеУслуги", Новый Массив);
	ПараметрыАвтоподстановки.Вставить("ПорядокВыпискиСФ");
	
	Если Отбор = Неопределено Тогда
		Отбор = Новый Структура;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидУслуг) Или ВидУслуг = "ОбразовательныеУслуги" Тогда
		
		СведенияОбОбразовательныхУслугах = РаботаСоСтудентами.СведенияОбОбразовательныхУслугахСтуденту(Студент, Неопределено, Неопределено,
			?(Отбор.Свойство("НаДату"), Отбор.НаДату, Неопределено),
			?(Отбор.Свойство("Факультет"), Отбор.Факультет, Неопределено));
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПараметрыАвтоподстановки.Договоры,
			СведенияОбОбразовательныхУслугах.ВыгрузитьКолонку("Договор"), Истина);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПараметрыАвтоподстановки.Плательщики,
			СведенияОбОбразовательныхУслугах.ВыгрузитьКолонку("Плательщик"), Истина);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПараметрыАвтоподстановки.Факультеты,
			СведенияОбОбразовательныхУслугах.ВыгрузитьКолонку("Факультет"), Истина);
		
		ПорядокВыпискиСФ = ПолучитьПорядокВыпискиСФОбразовательныеУслугиСтуденту(Студент, Неопределено, Неопределено,
			?(Отбор.Свойство("НаДату"), Отбор.НаДату, Неопределено));
			
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидУслуг) Или ВидУслуг = "ПрочиеУслуги" Тогда
		
		СведенияОПрочихУслугах = РаботаСоСтудентами.СведенияОПрочихУслугахСтуденту(Студент, Неопределено, Неопределено,
			?(Отбор.Свойство("НаДату"), Отбор.НаДату, Неопределено),
			?(Отбор.Свойство("Факультет"), Отбор.Факультет, Неопределено),
			?(Отбор.Свойство("НачислениеЗаУслугу"), Отбор.НачислениеЗаУслугу, Неопределено));
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПараметрыАвтоподстановки.Договоры,
			СведенияОПрочихУслугах.ВыгрузитьКолонку("Договор"), Истина);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПараметрыАвтоподстановки.Плательщики,
			СведенияОПрочихУслугах.ВыгрузитьКолонку("Плательщик"), Истина);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПараметрыАвтоподстановки.Факультеты,
			СведенияОПрочихУслугах.ВыгрузитьКолонку("Факультет"), Истина);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПараметрыАвтоподстановки.ПрочиеУслуги,
			СведенияОПрочихУслугах.ВыгрузитьКолонку("НачислениеСтудентамЗаПрочиеУслуги"), Истина);
		
		ПорядокВыпискиСФ = ПолучитьПорядокВыпискиСФПрочиеУслугиСтуденту(СведенияОПрочихУслугах);
		
	КонецЕсли;
	
	ПараметрыАвтоподстановки.ПорядокВыпискиСФ = ПорядокВыпискиСФ;
	
	Возврат ПараметрыАвтоподстановки;
	
КонецФункции

Функция ПолучитьТаблицуСчетовФактурПоНачислениюСКомментариями(ДокументНачисления) Экспорт 
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СчетФактураВыданный.Организация,
	               |	СчетФактураВыданный.Подразделение,
	               |	СчетФактураВыданный.Контрагент,
	               |	СчетФактураВыданный.Договор,
	               |	СчетФактураВыданный.Ссылка КАК СчетФактура,
	               |	СчетФактураВыданный.СуммаДокумента,
	               |	СчетФактураВыданный.СуммаНДС,
	               |	СчетФактураВыданный.СуммаВключаетНДС,
	               |	СчетФактураВыданный.ВалютаДокумента,
	               |	СчетФактураВыданный.ПометкаУдаления,
	               |	СчетФактураВыданный.Проведен,
	               |	ОперацииДокументов.Курс КАК Курс,
	               |	ОперацииДокументов.Кратность КАК Кратность,
	               |	СчетФактураВыданный.ИФО
	               |ПОМЕСТИТЬ ВсеСФ
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	               |		ПО СчетФактураВыданный.Ссылка = ОперацииДокументов.Документ
	               |ГДЕ
	               |	СчетФактураВыданный.ДокументОснование = &ДокументОснование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВсеСФ.Контрагент КАК Контрагент,
	               |	ВсеСФ.Договор КАК Договор,
	               |	КОЛИЧЕСТВО(ВсеСФ.СчетФактура) КАК КоличествоСФ
	               |ПОМЕСТИТЬ КолСФ
	               |ИЗ
	               |	ВсеСФ КАК ВсеСФ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВсеСФ.Контрагент,
	               |	ВсеСФ.Договор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА Начисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА &КонтрагентСводнаяСФ
	               |		ИНАЧЕ Начисления.Контрагент
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА Начисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |		ИНАЧЕ Начисления.ДоговорКонтрагента
	               |	КОНЕЦ КАК ДоговорКонтрагента,
	               |	СУММА(Начисления.СуммаНДС) КАК СуммаНДС,
	               |	Начисления.Ссылка.УчитыватьНДС КАК УчитыватьНДС,
	               |	Начисления.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	               |	СУММА(Начисления.Сумма + ВЫБОР
	               |			КОГДА НЕ Начисления.Ссылка.СуммаВключаетНДС
	               |				ТОГДА Начисления.СуммаНДС
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК СуммаНачисления,
	               |	Начисления.Ссылка.ВалютаДокумента,
	               |	Начисления.Ссылка.Курс,
	               |	Начисления.Ссылка.Кратность,
	               |	Начисления.Ссылка.Организация,
	               |	Начисления.Ссылка.Факультет,
	               |	Начисления.Ссылка.ИФО,
	               |	Начисления.Ссылка.Проведен
	               |ПОМЕСТИТЬ ТаблицаНачисления
	               |ИЗ
	               |	&ДокументТабличнаяЧастьПоТипу КАК Начисления
	               |ГДЕ
	               |	Начисления.Ссылка = &ДокументОснование
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВЫБОР
	               |		КОГДА Начисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |		ИНАЧЕ Начисления.ДоговорКонтрагента
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА Начисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА &КонтрагентСводнаяСФ
	               |		ИНАЧЕ Начисления.Контрагент
	               |	КОНЕЦ,
	               |	Начисления.Ссылка.УчитыватьНДС,
	               |	Начисления.Ссылка.СуммаВключаетНДС,
	               |	Начисления.Ссылка.ВалютаДокумента,
	               |	Начисления.Ссылка.Курс,
	               |	Начисления.Ссылка.Кратность,
	               |	Начисления.Ссылка.Организация,
	               |	Начисления.Ссылка.Факультет,
	               |	Начисления.Ссылка.ИФО,
	               |	Начисления.Ссылка.Проведен
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ВсеСФ.Контрагент ЕСТЬ NULL 
	               |			ТОГДА ТаблицаНачисления.Контрагент
	               |		ИНАЧЕ ВсеСФ.Контрагент
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА ВсеСФ.Договор ЕСТЬ NULL 
	               |			ТОГДА ТаблицаНачисления.ДоговорКонтрагента
	               |		ИНАЧЕ ВсеСФ.Договор
	               |	КОНЕЦ КАК ДоговорКонтрагента,
	               |	ЕСТЬNULL(ВсеСФ.СчетФактура, ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)) КАК СчетФактура,
	               |	ВЫБОР
	               |		КОГДА НЕ ТаблицаНачисления.УчитыватьНДС
	               |				И (ВсеСФ.СчетФактура.ПометкаУдаления
	               |					ИЛИ НЕ ВсеСФ.Проведен)
	               |			ТОГДА ЛОЖЬ
	               |		КОГДА НЕ ТаблицаНачисления.Проведен
	               |				И НЕ ВсеСФ.Проведен
	               |			ТОГДА ЛОЖЬ
	               |		КОГДА НЕ ТаблицаНачисления.Проведен
	               |				И ВсеСФ.Проведен
	               |			ТОГДА ""Документ начисления не проведен, счет-фактура проведена!""
	               |		КОГДА ТаблицаНачисления.Организация <> ВсеСФ.Организация
	               |			ТОГДА ""Различаются организации в документе начисления и счет-фактуре!""
	               |		КОГДА &ЕстьУчетПоПодразделениям
	               |				И ТаблицаНачисления.Факультет <> ВсеСФ.Подразделение
	               |			ТОГДА ""Различаются подразделения в документе начисления и счет-фактуре!""
	               |		КОГДА ТаблицаНачисления.ИФО <> ВсеСФ.ИФО
	               |			ТОГДА ""Различаются ИФО в документе начисления и счет-фактуре!""
	               |		КОГДА ТаблицаНачисления.УчитыватьНДС
	               |				И ВсеСФ.СчетФактура.ПометкаУдаления
	               |			ТОГДА ""Счет-фактура помечена на удаление!""
	               |		КОГДА ТаблицаНачисления.УчитыватьНДС
	               |				И НЕ ВсеСФ.СчетФактура.Проведен
	               |			ТОГДА ""Счет-фактура не проведена!""
	               |		КОГДА ЕСТЬNULL(КолСФ.КоличествоСФ, 0) > 1
	               |			ТОГДА ""Количество счет-фактур больше одной!""
	               |		КОГДА ВсеСФ.СчетФактура ЕСТЬ NULL 
	               |				И ТаблицаНачисления.УчитыватьНДС
	               |			ТОГДА ""Счет-фактура не оформлен!""
	               |		КОГДА ВсеСФ.СчетФактура ЕСТЬ НЕ NULL 
	               |				И НЕ ТаблицаНачисления.УчитыватьНДС
	               |			ТОГДА ""Счет-фактура не должен быть оформлен (документ не учитывает НДС)!""
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ТаблицаНачисления.Контрагент ЕСТЬ NULL 
	               |					ТОГДА ""Оформлена неверная счет-фактура (контрагента нет в начислениях)!""
	               |				КОГДА ТаблицаНачисления.ДоговорКонтрагента ЕСТЬ NULL 
	               |					ТОГДА ""Оформлена неверная счет-фактура (договора нет в начислениях)!""
	               |				КОГДА ВсеСФ.ВалютаДокумента <> ТаблицаНачисления.ВалютаДокумента
	               |					ТОГДА ""Валюта документа и счет-фактуры различаются!""
	               |				КОГДА ВсеСФ.Курс <> ТаблицаНачисления.Курс
	               |					ТОГДА ""Курс документа и счет-фактуры различаются!""
	               |				КОГДА ВсеСФ.Кратность <> ТаблицаНачисления.Кратность
	               |					ТОГДА ""Кратность документа и счет-фактуры различаются!""
	               |				КОГДА ВсеСФ.СуммаДокумента <> ТаблицаНачисления.СуммаНачисления
	               |					ТОГДА ""Сумма начисления и сумма счет-фактуры различаются!""
	               |				КОГДА ВсеСФ.СуммаНДС <> ТаблицаНачисления.СуммаНДС
	               |					ТОГДА ""Сумма НДС начисления и сумма НДС счет-фактуры различаются!""
	               |				ИНАЧЕ ЛОЖЬ
	               |			КОНЕЦ
	               |	КОНЕЦ КАК Ошибка
	               |ИЗ
	               |	ВсеСФ КАК ВсеСФ
	               |		ПОЛНОЕ СОЕДИНЕНИЕ ТаблицаНачисления КАК ТаблицаНачисления
	               |		ПО ВсеСФ.Контрагент = ТаблицаНачисления.Контрагент
	               |			И ВсеСФ.Договор = ТаблицаНачисления.ДоговорКонтрагента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КолСФ КАК КолСФ
	               |		ПО ВсеСФ.Контрагент = КолСФ.Контрагент
	               |			И ВсеСФ.Договор = КолСФ.Договор";
				   
	Если ТипЗнч(ДокументНачисления) = Тип("ДокументСсылка.НачислениеЗаУслугиОбразования") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументТабличнаяЧастьПоТипу", "Документ.НачислениеЗаУслугиОбразования.Начисления");
	ИначеЕсли ТипЗнч(ДокументНачисления) = Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументТабличнаяЧастьПоТипу", "Документ.НачислениеСтудентамЗаПрочиеУслуги.Начисления");
	КонецЕсли;				   
				   
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("КонтрагентСводнаяСФ", РаботаСоСтудентамиПовтИсп.ПолучитьКонтрагентаДляСводнойСчетФактуры());
	Запрос.УстановитьПараметр("ДокументОснование", ДокументНачисления);
	Запрос.УстановитьПараметр("ЕстьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура СформироватьСчетаФактурыНачисления(ДокументНачисления, ФормаУправленияСчетамиФактурами) Экспорт 
	
	Счет30304	= ФормаУправленияСчетамиФактурами.Счет30304;
	КПС30304	= ФормаУправленияСчетамиФактурами.КПС30304;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	НачислениеЗаУслугиОбразования.Ссылка,
	               |	НачислениеЗаУслугиОбразования.Дата,
	               |	НачислениеЗаУслугиОбразования.Организация,
	               |	НачислениеЗаУслугиОбразования.Факультет,
	               |	НачислениеЗаУслугиОбразования.СуммаВключаетНДС,
	               |	НачислениеЗаУслугиОбразования.УчитыватьНДС,
	               |	НачислениеЗаУслугиОбразования.ВалютаДокумента,
	               |	ОтветственныеЛицаРуководитель.ОтветственноеЛицо КАК Руководитель,
	               |	ОтветственныеЛицаГлавныйБухгалтер.ОтветственноеЛицо КАК ГлавныйБухгалтер,
	               |	НачислениеЗаУслугиОбразования.Курс,
	               |	НачислениеЗаУслугиОбразования.Кратность,
	               |	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КАК ПустоеПодразделение,
	               |	НачислениеЗаУслугиОбразования.ИФО,
	               |	НачислениеЗаУслугиОбразования.Проведен,
				   |	&Счет30304 КАК Счет30304,
				   |	&КПС30304 КАК КПС30304,
				   |	&ВыражениеДляНоменклатуры КАК Номенклатура,
				   |	&ВыражениеДляЕдиницыИзмерения КАК НоменклатураЕдиницаИзмерения
	               |ИЗ
	               |	&ДокументНачисленияПоТипу КАК НачислениеЗаУслугиОбразования
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&Период, ВидОтветственногоЛица = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)) КАК ОтветственныеЛицаРуководитель
	               |		ПО НачислениеЗаУслугиОбразования.Организация = ОтветственныеЛицаРуководитель.Организация
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&Период, ВидОтветственногоЛица = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер)) КАК ОтветственныеЛицаГлавныйБухгалтер
	               |		ПО НачислениеЗаУслугиОбразования.Организация = ОтветственныеЛицаГлавныйБухгалтер.Организация
	               |ГДЕ
	               |	НачислениеЗаУслугиОбразования.Ссылка = &ДокументНачисления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВЫБОР
	               |		КОГДА НачислениеЗаУслугиОбразованияНачисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА &КонтрагентСводнаяСФ
	               |		ИНАЧЕ НачислениеЗаУслугиОбразованияНачисления.Контрагент
	               |	КОНЕЦ КАК Контрагент,
	               |	ВЫБОР
	               |		КОГДА НачислениеЗаУслугиОбразованияНачисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |		ИНАЧЕ НачислениеЗаУслугиОбразованияНачисления.ДоговорКонтрагента
	               |	КОНЕЦ КАК ДоговорКонтрагента
	               |ПОМЕСТИТЬ Плательщики
	               |ИЗ
	               |	&ДокументТабличнаяЧастьПоТипу КАК НачислениеЗаУслугиОбразованияНачисления
	               |ГДЕ
	               |	НачислениеЗаУслугиОбразованияНачисления.Ссылка = &ДокументНачисления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СчетФактураВыданный.Ссылка,
	               |	СчетФактураВыданный.Контрагент,
	               |	СчетФактураВыданный.Договор КАК ДоговорКонтрагента
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |ГДЕ
	               |	(СчетФактураВыданный.Контрагент, СчетФактураВыданный.Договор) В
	               |			(ВЫБРАТЬ
	               |				Плательщики.Контрагент,
	               |				Плательщики.ДоговорКонтрагента
	               |			ИЗ
	               |				Плательщики КАК Плательщики)
	               |	И СчетФактураВыданный.ДокументОснование = &ДокументНачисления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА НачислениеЗаУслугиОбразованияНачисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА &КонтрагентСводнаяСФ
	               |		ИНАЧЕ НачислениеЗаУслугиОбразованияНачисления.Контрагент
	               |	КОНЕЦ КАК Контрагент,
				   |	&НоменклатураИзСтрокиТЧ,
				   |    &ЕдиницаИзмеренияИзСтрокиТЧ,
	               |	ВЫБОР
	               |		КОГДА НачислениеЗаУслугиОбразованияНачисления.ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |		ИНАЧЕ НачислениеЗаУслугиОбразованияНачисления.ДоговорКонтрагента
	               |	КОНЕЦ КАК ДоговорКонтрагента,
	               |	НачислениеЗаУслугиОбразованияНачисления.Сумма КАК Сумма,
				   |	1 КАК Количество,
	               |	НачислениеЗаУслугиОбразованияНачисления.СуммаНДС КАК СуммаНДС,
	               |	НачислениеЗаУслугиОбразованияНачисления.СтавкаНДС,
	               |	НачислениеЗаУслугиОбразованияНачисления.ИдентификаторЭД КАК ИдентификаторЭД
	               |ИЗ
	               |	&ДокументТабличнаяЧастьПоТипу КАК НачислениеЗаУслугиОбразованияНачисления
	               |ГДЕ
	               |	НачислениеЗаУслугиОбразованияНачисления.Ссылка = &ДокументНачисления
	               |ИТОГИ ПО
	               |	Контрагент,
	               |	ДоговорКонтрагента";
				   
	Если ТипЗнч(ДокументНачисления) = Тип("ДокументСсылка.НачислениеЗаУслугиОбразования") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументНачисленияПоТипу", "Документ.НачислениеЗаУслугиОбразования");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументТабличнаяЧастьПоТипу", "Документ.НачислениеЗаУслугиОбразования.Начисления");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВыражениеДляНоменклатуры", "НачислениеЗаУслугиОбразования.Номенклатура");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВыражениеДляЕдиницыИзмерения", "НачислениеЗаУслугиОбразования.Номенклатура.ЕдиницаИзмерения");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НоменклатураИзСтрокиТЧ,", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЕдиницаИзмеренияИзСтрокиТЧ,", "");
	ИначеЕсли ТипЗнч(ДокументНачисления) = Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументНачисленияПоТипу", "Документ.НачислениеСтудентамЗаПрочиеУслуги");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДокументТабличнаяЧастьПоТипу", "Документ.НачислениеСтудентамЗаПрочиеУслуги.Начисления");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВыражениеДляНоменклатуры", "ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВыражениеДляЕдиницыИзмерения", "ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НоменклатураИзСтрокиТЧ",
			"ВЫБОР
			|	КОГДА Ссылка.НачислениеЗаУслугу <> ЗНАЧЕНИЕ(Справочник.НачисленияСтудентамЗаПрочиеУслуги.ПустаяСсылка) ТОГДА
			|		Ссылка.НачислениеЗаУслугу.Номенклатура
			|	ИНАЧЕ
			|		НачислениеЗаУслугу.Номенклатура
			|КОНЕЦ КАК Номенклатура");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЕдиницаИзмеренияИзСтрокиТЧ", 
			"ВЫБОР
			|	КОГДА Ссылка.НачислениеЗаУслугу <> ЗНАЧЕНИЕ(Справочник.НачисленияСтудентамЗаПрочиеУслуги.ПустаяСсылка) ТОГДА
			|		Ссылка.НачислениеЗаУслугу.Номенклатура.ЕдиницаИзмерения
			|	ИНАЧЕ
			|		НачислениеЗаУслугу.Номенклатура
			|КОНЕЦ НоменклатураЕдиницаИзмерения");
	КонецЕсли;
		
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("Период",  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументНачисления, "Дата"));
	Запрос.УстановитьПараметр("ДокументНачисления", ДокументНачисления );           
	Запрос.УстановитьПараметр("КонтрагентСводнаяСФ", РаботаСоСтудентамиПовтИсп.ПолучитьКонтрагентаДляСводнойСчетФактуры());
	Запрос.УстановитьПараметр("Счет30304",Счет30304);
	Запрос.УстановитьПараметр("КПС30304",КПС30304);
								        
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ШапкаОснования = МассивРезультатов[0].Выбрать(); 
	ТаблицаНайденныхСФ = МассивРезультатов[2].Выгрузить();
	ВыборкаТребуемыхНачислений = МассивРезультатов[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ШапкаОснования.Следующий();	
	ОбработатьСФНаПлательщика(ШапкаОснования, ТаблицаНайденныхСФ, ВыборкаТребуемыхНачислений, ФормаУправленияСчетамиФактурами);
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеРеквизитыТаблицы(КоллекцияДанных, СтруктураЗаполнения) Экспорт 
	
	Запрос = Новый Запрос;
	
	// Сформируем выборку
	ТекстЗапроса = "ВЫБРАТЬ * 
						|ПОМЕСТИТЬ ТаблицаДанных
						|ИЗ &Данные КАК Данные
						|;
						|/////////////////////////////////
						|ВЫБРАТЬ" + Символы.ПС;
	
	ПервоеПоле = Истина;
	
	// Получим нужные значения
	Для каждого ЭлементПоля Из СтруктураЗаполнения Цикл
		
		Если НЕ ПервоеПоле Тогда
			ТекстЗапроса = ТекстЗапроса + ","
		КонецЕсли; 
		
		Если Найти(ЭлементПоля.Значение, "ТаблицаДанных") > 0 Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.Таб + ЭлементПоля.Значение + " КАК " + ЭлементПоля.Ключ + Символы.ПС;
		Иначе
			ТекстЗапроса = ТекстЗапроса + Символы.Таб + "ТаблицаДанных." + ЭлементПоля.Значение + " КАК " + ЭлементПоля.Ключ + Символы.ПС;
		КонецЕсли;

		ПервоеПоле = Ложь
		
	КонецЦикла; 
	
	ТекстЗапроса = ТекстЗапроса + "ИЗ ТаблицаДанных КАК ТаблицаДанных";
					   			   
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("Данные", КоллекцияДанных.Выгрузить());
	ВыборкаДанных = Запрос.Выполнить().Выбрать();
	
	// Сформируем список запрошенных свойств
	СписокСвойств = "";
	Для каждого ЭлементПоля Из СтруктураЗаполнения Цикл
		СписокСвойств = СписокСвойств + ?(ПустаяСтрока(СписокСвойств), "", ", ") + ЭлементПоля.Ключ;
	КонецЦикла;
	
	// Заполним только запрошенные данные
	Для н = 0 По КоллекцияДанных.Количество() - 1 Цикл
		
		ВыборкаДанных.Следующий();
		ЗаполнитьЗначенияСвойств(КоллекцияДанных[н], ВыборкаДанных, СписокСвойств);
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура ЗаполнитьДокументРаспределения(Объект) Экспорт 
	
	ЭтоДокументОбъект = (ТипЗнч(Объект) = Тип("ДокументОбъект.РаспределениеОплатыОбразование"));
	
	Объект.Распределение.Очистить();
	Объект.РаспределениеОбщихДоговоров.Очистить();
	
	СхемаКомпоновкиДанных = Документы.РаспределениеОплатыОбразование.ПолучитьМакет("ЗаполнениеДокумента");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода", НачалоДня(Объект.Дата));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода",  КонецДня(Объект.Дата));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Организация",   Объект.Организация);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Счет000",       БухгалтерскийУчет.СчетПоКоду("000"));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРегламентированногоУчета", ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета());
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ТекущаяДата",   ТекущаяДата());
		
	СпискиСчетов = Новый Структура;
	СпискиСчетов.Вставить("СчетКазначейство",   "201.11");
	СпискиСчетов.Вставить("СчетБанкРубли",      "201.21");
	СпискиСчетов.Вставить("СчетЭквайрингРубли", "201.23");
	СпискиСчетов.Вставить("СчетБанкВалюта",     "201.27");
	СпискиСчетов.Вставить("СчетКасса",          "201.34");
	СпискиСчетов.Вставить("СчетЗачетаОплаты",   "205.30,205.29,209.34");
	СпискиСчетов.Вставить("СчетВзаиморасчетов",	"302.26");
	СпискиСчетов.Вставить("СчетПереноса",		"304.04,304.06,304.66,304.76,304.86,304.96");
	СпискиСчетов.Вставить("СчетКомиссии",		"210.05");	
	
	Для каждого СчетИзСписка Из СпискиСчетов Цикл
	
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов(СчетИзСписка.Значение, Объект.Дата,, Объект.Организация));
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, СчетИзСписка.Ключ, Список);
	
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Объект.Факультет) Тогда
		
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "Факультет", Объект.Факультет);
		
	КонецЕсли; 
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;    
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"), Ложь);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,, Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ДанныеОтчета = Новый ДеревоЗначений;
	ПроцессорВывода.УстановитьОбъект(ДанныеОтчета);
	
	ДанныеОтчетаДерево = ПроцессорВывода.Вывести(ПроцессорКомпоновки);

	КодСтроки = 1;
	Для каждого СтрокаПлательщика Из ДанныеОтчетаДерево.Строки Цикл
		
		ЭтоРаспределениеДопУслуг = СтрокаПлательщика.Строки.Найти(Истина, "РасчетыДопУслуги") <> Неопределено;
		// По одному контрагенту и договору может оказываться либо услуга по основной образовательной деятельности, 
		// либо по дополнительным услугам. Дополнительных услуг по одному договору может быть несколько.
		
		Если ЭтоРаспределениеДопУслуг Тогда
			
			Для Каждого СтрокаСтудента Из СтрокаПлательщика.Строки Цикл
				
				Если СтрокаСтудента.РасчетыДопУслуги Тогда
				
					НоваяСтрокаОплаты = Объект.Распределение.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаОплаты, СтрокаПлательщика);
					НоваяСтрокаОплаты.КодСтроки = КодСтроки;
					НоваяСтрокаОплаты.Студент = СтрокаСтудента.Студент;
					НоваяСтрокаОплаты.Факультет = СтрокаСтудента.Факультет;
					НоваяСтрокаОплаты.РасчетыДопУслуги = СтрокаСтудента.РасчетыДопУслуги;
					НоваяСтрокаОплаты.НачислениеЗаУслугу = СтрокаСтудента.НачислениеЗаУслугу;
					НоваяСтрокаОплаты.Сумма = СтрокаСтудента.СуммаСтудента;
					НоваяСтрокаОплаты.СуммаВалюта = СтрокаСтудента.СуммаСтудентаВалюта;
					
					КодСтроки = КодСтроки + 1;
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
		
			НоваяСтрокаОплаты = Объект.Распределение.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОплаты, СтрокаПлательщика);
			НоваяСтрокаОплаты.КодСтроки = КодСтроки;
			
			Если СтрокаПлательщика.Строки.Количество() = 1 Тогда
				
				НоваяСтрокаОплаты.Студент = СтрокаПлательщика.Строки[0].Студент;
				НоваяСтрокаОплаты.Факультет = СтрокаПлательщика.Строки[0].Факультет;
				НоваяСтрокаОплаты.РасчетыДопУслуги = СтрокаПлательщика.Строки[0].РасчетыДопУслуги;
				НоваяСтрокаОплаты.НачислениеЗаУслугу = СтрокаПлательщика.Строки[0].НачислениеЗаУслугу;
				
			Иначе
				
				Если НЕ ЭтоДокументОбъект Тогда
						
					НоваяСтрокаОплаты.СтатусРаспределения = 1; 
					НоваяСтрокаОплаты.СтудентТекст = "Распределено";
				
				КонецЕсли; 
				
				Для каждого СтрокаСтудента Из СтрокаПлательщика.Строки Цикл
					
					НоваяСтрокаРаспределенияОплаты = Объект.РаспределениеОбщихДоговоров.Добавить();
					НоваяСтрокаРаспределенияОплаты.Студент = СтрокаСтудента.Студент;
					НоваяСтрокаРаспределенияОплаты.Факультет = СтрокаСтудента.Факультет;
					НоваяСтрокаРаспределенияОплаты.Сумма = СтрокаСтудента.СуммаСтудента;
					НоваяСтрокаРаспределенияОплаты.СуммаВалюта = СтрокаСтудента.СуммаСтудентаВалюта;
					НоваяСтрокаРаспределенияОплаты.КодСтроки = КодСтроки;
					
				КонецЦикла;
				
			КонецЕсли;
			
			КодСтроки = КодСтроки + 1;
		КонецЕсли;
		
	КонецЦикла; 

КонецПроцедуры

Функция ПолучитьТекстЗапросаСтатусовРаспределенияОплаты() Экспорт 

	ТекстЗапроса = "ВЫБРАТЬ
	               |	Распределение.НомерСтроки,
	               |	Распределение.Студент,
	               |	Распределение.Сумма,
	               |	Распределение.СуммаВалюта,
	               |	Распределение.КодСтроки
	               |ПОМЕСТИТЬ Распределение
	               |ИЗ
	               |	&Распределение КАК Распределение
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РаспределениеОбщих.Сумма,
	               |	РаспределениеОбщих.СуммаВалюта,
	               |	РаспределениеОбщих.КодСтроки
	               |ПОМЕСТИТЬ РаспределениеОбщих
	               |ИЗ
	               |	&РаспределениеОбщих КАК РаспределениеОбщих
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА Данные.СуммаРаспределения = Данные.СуммаРаспределено
	               |				И Данные.СуммаРаспределенияВалюта = Данные.СуммаРаспределеноВалюта
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК СтатусРаспределения,
	               |	Данные.НомерСтроки,
	               |	ВЫБОР
	               |		КОГДА Данные.СуммаРаспределения = Данные.СуммаРаспределено
	               |				И Данные.СуммаРаспределенияВалюта = Данные.СуммаРаспределеноВалюта
	               |			ТОГДА ""Распределено""
	               |		ИНАЧЕ ""Не распределено""
	               |	КОНЕЦ КАК СтудентТекст
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		Распределение.НомерСтроки КАК НомерСтроки,
	               |		МАКСИМУМ(Распределение.Сумма) КАК СуммаРаспределения,
	               |		СУММА(ЕСТЬNULL(РаспределениеОбщих.Сумма, 0)) КАК СуммаРаспределено,
	               |		МАКСИМУМ(Распределение.СуммаВалюта) КАК СуммаРаспределенияВалюта,
	               |		СУММА(ЕСТЬNULL(РаспределениеОбщих.СуммаВалюта, 0)) КАК СуммаРаспределеноВалюта
	               |	ИЗ
	               |		Распределение КАК Распределение
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РаспределениеОбщих КАК РаспределениеОбщих
	               |			ПО Распределение.КодСтроки = РаспределениеОбщих.КодСтроки
	               |	ГДЕ
	               |		Распределение.Студент = ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		Распределение.НомерСтроки) КАК Данные";	

	Возврат ТекстЗапроса;
	
КонецФункции 

// Функция возвращает результат работы СКД, работающей на основе макетов для подрбора студентов
// Пример использования см. в документе ПриказОбразования для заполнения ТЧ из формы
//
Функция ПолучитьДанныеПодбораУчащихся(Адреса, Организация = Неопределено, Факультет = Неопределено, Период = Неопределено, НачислениеЗаПрочиеУслуги = Неопределено) Экспорт 

	Схема = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(Адреса.СхемаКомпоновкиДанных));
	СхемаКомпоновкиДанных = Схема.Получить();
	НастройкиКомпоновкиДанных = ПолучитьИзВременногоХранилища(Адреса.НастройкиКомпоновкиДанных); 
			
	// Подготовка компоновщика макета компоновки данных, загрузка настроек
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	
	Если НастройкиКомпоновкиДанных <> Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновкиДанных);
		КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	Иначе
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	КонецЕсли;
	
	// Компоновка макета и исполнение запроса.
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"), Ложь);

	Параметр = МакетКомпоновки.ЗначенияПараметров.Найти("Период");
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = Период;
	КонецЕсли;
	
	Параметр = МакетКомпоновки.ЗначенияПараметров.Найти("Организация");
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = Организация;
	КонецЕсли;	
	
	Параметр = МакетКомпоновки.ЗначенияПараметров.Найти("Факультет");
	Если Параметр <> Неопределено Тогда 
		Параметр.Значение = Факультет;
	КонецЕсли;	
	
	Параметр = МакетКомпоновки.ЗначенияПараметров.Найти("НачислениеЗаПрочиеУслуги");
	Если Параметр <> Неопределено Тогда 
		Параметр.Значение = НачислениеЗаПрочиеУслуги;
	КонецЕсли;	
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;

	ДанныеОтчета = Новый ТаблицаЗначений();
	ПроцессорВывода.УстановитьОбъект(ДанныеОтчета);
	ДанныеОтчета = ПроцессорВывода.Вывести(ПроцессорКомпоновки);

	Возврат ДанныеОтчета;	

КонецФункции 

Функция ДополнитьДанныеДляРасчета(ДанныеДляРасчета, ТаблицаКоличествоРабочихДней, Организация, Факультет, ПериодНачисления) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабНачислений.Студент КАК Студент,
	|	ТабНачислений.Контрагент КАК Контрагент,
	|	ТабНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ТабНачислений.ГруппаСтудентов КАК ГруппаСтудентов,
	|	&ПоляТаблицыНачислений КАК ПоляТаблицыНачислений
	|ПОМЕСТИТЬ ТабНачислений
	|ИЗ
	|	&ТабНачислений КАК ТабНачислений
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Студент,
	|	ДоговорКонтрагента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабКоличествоРабочихДней.ГруппаСтудентов КАК ГруппаСтудентов,
	|	ТабКоличествоРабочихДней.ГрафикРаботы КАК ГрафикРаботы,
	|	ТабКоличествоРабочихДней.КоличествоРабочихДней КАК КоличествоРабочихДней
	|ПОМЕСТИТЬ ТабКоличествоРабочихДней
	|ИЗ
	|	&ТабКоличествоРабочихДней КАК ТабКоличествоРабочихДней
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ГруппаСтудентов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Табель.Студент КАК Студент,
	|	Табель.ГруппаСтудентов КАК ГруппаСтудентов,
	|	Табель.НеоплачиваемыеНевыходыОборот КАК НеоплачиваемыеНевыходыОборот
	|ПОМЕСТИТЬ Табель
	|ИЗ
	|	РегистрНакопления.ТабельУчетаПосещаемостиСтудентов.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Факультет = &Факультет
	|				И Студент В
	|					(ВЫБРАТЬ
	|						ТабНачислений.Студент
	|					ИЗ
	|						ТабНачислений)) КАК Табель
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Студент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыСписанияДоходовБудущихПериодов.Договор КАК Договор,
	|	ИСТИНА КАК ЭтоДолгосрочныйДоговор
	|ПОМЕСТИТЬ ДолгосрочныеДоговорыОбразование
	|ИЗ
	|	РегистрСведений.ПараметрыСписанияДоходовБудущихПериодов.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И Договор В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ТабНачислений.ДоговорКонтрагента
	|					ИЗ
	|						ТабНачислений)) КАК ПараметрыСписанияДоходовБудущихПериодов
	|ГДЕ
	|	ПараметрыСписанияДоходовБудущихПериодов.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНачисленияДБП.ДолгосрочныйДоговорОбразование)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабНачислений.Студент КАК Студент,
	|	ТабНачислений.Контрагент КАК Контрагент,
	|	ТабНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ТабНачислений.ГруппаСтудентов КАК ГруппаСтудентов,
	|	&ПоляТаблицыНачислений КАК ПоляТаблицыНачислений,
	|	ЕСТЬNULL(ТабКоличествоРабочихДней.КоличествоРабочихДней, 0) КАК КоличествоРабочихДней,
	|	ЕСТЬNULL(ТабКоличествоРабочихДней.КоличествоРабочихДней, 0) - ЕСТЬNULL(Табель.НеоплачиваемыеНевыходыОборот, 0) КАК ДнейПосещения,
	|	ЕСТЬNULL(ДолгосрочныеДоговорыОбразование.ЭтоДолгосрочныйДоговор, ЛОЖЬ) КАК ЭтоДолгосрочныйДоговор
	|ИЗ
	|	ТабНачислений КАК ТабНачислений
	|		ЛЕВОЕ СОЕДИНЕНИЕ Табель КАК Табель
	|		ПО ТабНачислений.Студент = Табель.Студент
	|			И ТабНачислений.ГруппаСтудентов = Табель.ГруппаСтудентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДолгосрочныеДоговорыОбразование КАК ДолгосрочныеДоговорыОбразование
	|		ПО ТабНачислений.ДоговорКонтрагента = ДолгосрочныеДоговорыОбразование.Договор
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабКоличествоРабочихДней КАК ТабКоличествоРабочихДней
	|		ПО ТабНачислений.ГруппаСтудентов = ТабКоличествоРабочихДней.ГруппаСтудентов
	|ГДЕ
	|	НЕ ЕСТЬNULL(ДолгосрочныеДоговорыОбразование.ЭтоДолгосрочныйДоговор, ЛОЖЬ)";
	
	ПоляТаблицыНачислений = "";
	Для Каждого КолонкаТаблицыНачислений Из ДанныеДляРасчета.Колонки Цикл
		Если СтрНайти("Студент,Контрагент,ДоговорКонтрагента,ГруппаСтудентов", КолонкаТаблицыНачислений.Имя) > 0 Тогда
			Продолжить;
		КонецЕсли;
		ПоляТаблицыНачислений = ПоляТаблицыНачислений +
			?(ПустаяСтрока(ПоляТаблицыНачислений), "", "," + Символы.ПС + Символы.Таб) +
			"ТабНачислений." + КолонкаТаблицыНачислений.Имя + " КАК " + КолонкаТаблицыНачислений.Имя;
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляТаблицыНачислений КАК ПоляТаблицыНачислений", ПоляТаблицыНачислений);
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Факультет", Факультет);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("ТабКоличествоРабочихДней", ТаблицаКоличествоРабочихДней);
	Запрос.УстановитьПараметр("ТабНачислений", ДанныеДляРасчета);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ДополнитьДанныеДляРасчетаПрочиеУслуги(ДанныеДляРасчета, КоличествоРабочихДней, Организация, Факультет, ПериодНачисления) Экспорт
	
	//Для прочих услуг при текущей структуре регистра ТабельУчетаПосещаемостиСтудентов использование табеля некорректно, т.к. по прочим услугам нет групп.
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабНачислений.Студент КАК Студент,
	|	ТабНачислений.Контрагент КАК Контрагент,
	|	ТабНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ТабНачислений.ПериодНачисленияНачало КАК ПериодНачисленияНачало,
	|	ТабНачислений.ПериодНачисленияКонец КАК ПериодНачисленияКонец,
	|	&ПоляТаблицыНачислений КАК ПоляТаблицыНачислений
	|ПОМЕСТИТЬ ТабНачислений
	|ИЗ
	|	&ТабНачислений КАК ТабНачислений
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Студент,
	|	ДоговорКонтрагента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыСписанияДоходовБудущихПериодов.Договор КАК Договор,
	|	ИСТИНА КАК ЭтоДолгосрочныйДоговор
	|ПОМЕСТИТЬ ДолгосрочныеДоговорыОбразование
	|ИЗ
	|	РегистрСведений.ПараметрыСписанияДоходовБудущихПериодов.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И Договор В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ТабНачислений.ДоговорКонтрагента
	|					ИЗ
	|						ТабНачислений)) КАК ПараметрыСписанияДоходовБудущихПериодов
	|ГДЕ
	|	ПараметрыСписанияДоходовБудущихПериодов.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНачисленияДБП.ДолгосрочныйДоговорОбразование)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабНачислений.Студент КАК Студент,
	|	ТабНачислений.Контрагент КАК Контрагент,
	|	ТабНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ТабНачислений.ПериодНачисленияНачало КАК ПериодНачисленияНачало,
	|	ТабНачислений.ПериодНачисленияКонец КАК ПериодНачисленияКонец,
	|	&ПоляТаблицыНачислений КАК ПоляТаблицыНачислений,
	|	&КоличествоРабочихДней КАК КоличествоРабочихДней,
	|	РАЗНОСТЬДАТ(ТабНачислений.ПериодНачисленияНачало, ТабНачислений.ПериодНачисленияКонец, ДЕНЬ)+1 КАК ДнейПосещения,
	|	ЕСТЬNULL(ДолгосрочныеДоговорыОбразование.ЭтоДолгосрочныйДоговор, ЛОЖЬ) КАК ЭтоДолгосрочныйДоговор
	|ИЗ
	|	ТабНачислений КАК ТабНачислений
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДолгосрочныеДоговорыОбразование КАК ДолгосрочныеДоговорыОбразование
	|		ПО ТабНачислений.ДоговорКонтрагента = ДолгосрочныеДоговорыОбразование.Договор
	|ГДЕ
	|	НЕ ЕСТЬNULL(ДолгосрочныеДоговорыОбразование.ЭтоДолгосрочныйДоговор, ЛОЖЬ)";
	
	ПоляТаблицыНачислений = "";
	Для Каждого КолонкаТаблицыНачислений Из ДанныеДляРасчета.Колонки Цикл
		Если СтрНайти("Студент,Контрагент,ДоговорКонтрагента,ПериодНачисленияНачало, ПериодНачисленияКонец", КолонкаТаблицыНачислений.Имя) > 0 Тогда
			Продолжить;
		КонецЕсли;
		ПоляТаблицыНачислений = ПоляТаблицыНачислений +
			?(ПустаяСтрока(ПоляТаблицыНачислений), "", "," + Символы.ПС + Символы.Таб) +
			"ТабНачислений." + КолонкаТаблицыНачислений.Имя + " КАК " + КолонкаТаблицыНачислений.Имя;
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляТаблицыНачислений КАК ПоляТаблицыНачислений", ПоляТаблицыНачислений);
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Факультет", Факультет);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("КоличествоРабочихДней", КоличествоРабочихДней);
	Запрос.УстановитьПараметр("ТабНачислений", ДанныеДляРасчета);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ОтобратьКраткосрочныеДоговоры(ДанныеДляРасчета, Организация, Факультет, ПериодНачисления) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабНачислений.Студент КАК Студент,
	|	ТабНачислений.Контрагент КАК Контрагент,
	|	ТабНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ПОМЕСТИТЬ ТабНачислений
	|ИЗ
	|	&ТабНачислений КАК ТабНачислений
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Студент,
	|	ДоговорКонтрагента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПорядокОплатыОбразованиеСрезПоследних.Учащийся КАК Учащийся,
	|	ПорядокОплатыОбразованиеСрезПоследних.Контрагент КАК Контрагент,
	|	ПорядокОплатыОбразованиеСрезПоследних.Договор КАК Договор,
	|	ИСТИНА КАК ЭтоДолгосрочныйДоговор
	|ПОМЕСТИТЬ ДолгосрочныеДоговорыОбразование
	|ИЗ
	|	РегистрСведений.ПорядокОплатыОбразование.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И Договор В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ТабНачислений.ДоговорКонтрагента
	|					ИЗ
	|						ТабНачислений)) КАК ПорядокОплатыОбразованиеСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабНачислений.Студент КАК Студент,
	|	ТабНачислений.Контрагент КАК Контрагент,
	|	ТабНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(ДолгосрочныеДоговорыОбразование.ЭтоДолгосрочныйДоговор, ЛОЖЬ) КАК ЭтоДолгосрочныйДоговор
	|ПОМЕСТИТЬ ДоговорыДляОтбораПоВиду
	|ИЗ
	|	ТабНачислений КАК ТабНачислений
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДолгосрочныеДоговорыОбразование КАК ДолгосрочныеДоговорыОбразование
	|		ПО ТабНачислений.ДоговорКонтрагента = ДолгосрочныеДоговорыОбразование.Договор
	|			И ТабНачислений.Студент = ДолгосрочныеДоговорыОбразование.Учащийся
	|			И ТабНачислений.Контрагент = ДолгосрочныеДоговорыОбразование.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоговорыДляОтбораПоВиду.Студент КАК Студент,
	|	ДоговорыДляОтбораПоВиду.Контрагент КАК Контрагент,
	|	ДоговорыДляОтбораПоВиду.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ИЗ
	|	ДоговорыДляОтбораПоВиду КАК ДоговорыДляОтбораПоВиду
	|ГДЕ
	|	ДоговорыДляОтбораПоВиду.ЭтоДолгосрочныйДоговор = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Факультет", Факультет);
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("ТабНачислений", ДанныеДляРасчета);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ОтобратьИДополнитьДолгосрочныеДоговоры(ДанныеДляРасчета, ПараметрыДолгосрочныхДоговоров) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабНачислений.Студент КАК Студент,
	|	ТабНачислений.Контрагент КАК Контрагент,
	|	ТабНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ПОМЕСТИТЬ ТабНачислений
	|ИЗ
	|	&ТабНачислений КАК ТабНачислений
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Студент,
	|	ДоговорКонтрагента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПорядокОплатыОбразованиеСрезПоследних.Учащийся КАК Учащийся,
	|	ПорядокОплатыОбразованиеСрезПоследних.Контрагент КАК Контрагент,
	|	ПорядокОплатыОбразованиеСрезПоследних.Договор КАК Договор,
	|	ИСТИНА КАК ЭтоДолгосрочныйДоговор,
	|	ПорядокОплатыОбразованиеСрезПоследних.НачалоПериода КАК НачалоПериода,
	|	ПорядокОплатыОбразованиеСрезПоследних.КонецПериода КАК КонецПериода,
	|	ПорядокОплатыОбразованиеСрезПоследних.Валюта КАК Валюта,
	|	ПорядокОплатыОбразованиеСрезПоследних.СуммаВВалюте КАК СуммаВВалюте,
	|	ПорядокОплатыОбразованиеСрезПоследних.ОплатитьДо КАК ОплатитьДо
	|ПОМЕСТИТЬ ДолгосрочныеДоговорыОбразование
	|ИЗ
	|	РегистрСведений.ПорядокОплатыОбразование.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И Факультет = &Факультет
	|				И Валюта = &Валюта
	|				И Договор В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ТабНачислений.ДоговорКонтрагента
	|					ИЗ
	|						ТабНачислений)
	|				И Активность = ИСТИНА) КАК ПорядокОплатыОбразованиеСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабНачислений.Студент КАК Студент,
	|	ТабНачислений.Контрагент КАК Контрагент,
	|	ТабНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(ДолгосрочныеДоговорыОбразование.ЭтоДолгосрочныйДоговор, ЛОЖЬ) КАК ЭтоДолгосрочныйДоговор,
	|	ЕСТЬNULL(ДолгосрочныеДоговорыОбразование.НачалоПериода, ДАТАВРЕМЯ(1, 1, 1)) КАК НачалоПериода,
	|	ЕСТЬNULL(ДолгосрочныеДоговорыОбразование.КонецПериода, ДАТАВРЕМЯ(1, 1, 1)) КАК КонецПериода,
	|	ЕСТЬNULL(ДолгосрочныеДоговорыОбразование.ОплатитьДо, ДАТАВРЕМЯ(1, 1, 1)) КАК ОплатитьДо,
	|	ДолгосрочныеДоговорыОбразование.Валюта КАК Валюта,
	|	ДолгосрочныеДоговорыОбразование.СуммаВВалюте КАК СуммаВВалюте
	|ПОМЕСТИТЬ ДоговорыДляОтбораПоВиду
	|ИЗ
	|	ТабНачислений КАК ТабНачислений
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДолгосрочныеДоговорыОбразование КАК ДолгосрочныеДоговорыОбразование
	|		ПО ТабНачислений.ДоговорКонтрагента = ДолгосрочныеДоговорыОбразование.Договор
	|			И ТабНачислений.Студент = ДолгосрочныеДоговорыОбразование.Учащийся
	|			И ТабНачислений.Контрагент = ДолгосрочныеДоговорыОбразование.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДоговорыДляОтбораПоВиду.Студент КАК Студент,
	|	ДоговорыДляОтбораПоВиду.Контрагент КАК Контрагент,
	|	ДоговорыДляОтбораПоВиду.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ДоговорыДляОтбораПоВиду.НачалоПериода КАК НачалоПериода,
	|	ДоговорыДляОтбораПоВиду.КонецПериода КАК КонецПериода,
	|	ДоговорыДляОтбораПоВиду.ОплатитьДо КАК ОплатитьДо,
	|	ДоговорыДляОтбораПоВиду.Валюта КАК Валюта,
	|	ДоговорыДляОтбораПоВиду.СуммаВВалюте КАК СуммаВВалюте,
	|	ВЫБОР
	|		КОГДА &СпособЗаполненияПоПериоду = 0
	|				И ДоговорыДляОтбораПоВиду.НачалоПериода >= &НачалоПериода
	|				И ДоговорыДляОтбораПоВиду.КонецПериода <= &КонецПериода
	|			ТОГДА ИСТИНА
	|		КОГДА &СпособЗаполненияПоПериоду = 1
	|				И ДоговорыДляОтбораПоВиду.ОплатитьДо >= &НачалоПериода
	|				И ДоговорыДляОтбораПоВиду.ОплатитьДо <= &КонецПериода
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК КорректныйПериод
	|ПОМЕСТИТЬ ДоговорыДляОтбораПоПериоду
	|ИЗ
	|	ДоговорыДляОтбораПоВиду КАК ДоговорыДляОтбораПоВиду
	|ГДЕ
	|	ДоговорыДляОтбораПоВиду.ЭтоДолгосрочныйДоговор = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоговорыДляОтбораПоПериоду.Студент КАК Учащийся,
	|	ДоговорыДляОтбораПоПериоду.Контрагент КАК Контрагент,
	|	ДоговорыДляОтбораПоПериоду.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ДоговорыДляОтбораПоПериоду.НачалоПериода КАК НачалоПериода,
	|	ДоговорыДляОтбораПоПериоду.КонецПериода КАК КонецПериода,
	|	ДоговорыДляОтбораПоПериоду.ОплатитьДо КАК ДатаОплаты,
	|	ДоговорыДляОтбораПоПериоду.Валюта КАК Валюта,
	|	ДоговорыДляОтбораПоПериоду.СуммаВВалюте КАК Сумма
	|ИЗ
	|	ДоговорыДляОтбораПоПериоду КАК ДоговорыДляОтбораПоПериоду
	|ГДЕ
	|	ДоговорыДляОтбораПоПериоду.КорректныйПериод = ИСТИНА";
	
	Запрос.УстановитьПараметр("Организация", ПараметрыДолгосрочныхДоговоров.Организация);
	Запрос.УстановитьПараметр("Факультет", ПараметрыДолгосрочныхДоговоров.Факультет);
	Запрос.УстановитьПараметр("Валюта", ПараметрыДолгосрочныхДоговоров.Валюта);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ПараметрыДолгосрочныхДоговоров.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ПараметрыДолгосрочныхДоговоров.КонецПериода));
	// СпособЗаполненияПоПериоду - числовое значение, "0" - отбор по данным периода, "1" - отбор по дате оплаты.
	Запрос.УстановитьПараметр("СпособЗаполненияПоПериоду", ПараметрыДолгосрочныхДоговоров.СпособЗаполненияПоПериоду);
	Запрос.УстановитьПараметр("ТабНачислений", ДанныеДляРасчета);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ДополнитьДолгосрочныеДоговорыДаннымиОплаты(ДанныеДляРасчета, ПараметрыДолгосрочныхДоговоров) Экспорт
	
	// Дополним данные для расчета оплаты суммами уже отраженных поступлений - они должны быть распределены с помощью документа Распределение оплат (образование).
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабНачислений.Учащийся КАК Учащийся,
	|	ТабНачислений.Контрагент КАК Контрагент,
	|	ТабНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ТабНачислений.НачалоПериода КАК НачалоПериода,
	|	ТабНачислений.КонецПериода КАК КонецПериода,
	|	ТабНачислений.ДатаОплаты КАК ДатаОплаты,
	|	ТабНачислений.Валюта КАК Валюта,
	|	ТабНачислений.Сумма КАК Сумма
	|ПОМЕСТИТЬ ТабНачислений
	|ИЗ
	|	&ТабНачислений КАК ТабНачислений
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Учащийся,
	|	ДоговорКонтрагента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетыСоСтудентамиОбороты.Студент КАК Студент,
	|	РасчетыСоСтудентамиОбороты.Контрагент КАК Контрагент,
	|	РасчетыСоСтудентамиОбороты.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	РасчетыСоСтудентамиОбороты.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	|	РасчетыСоСтудентамиОбороты.СуммаВзаиморасчетовРасход КАК СуммаВзаиморасчетовРасход
	|ПОМЕСТИТЬ ТаблицаОплат
	|ИЗ
	|	РегистрНакопления.РасчетыСоСтудентами.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Организация = &Организация
	|				И Факультет = &Факультет) КАК РасчетыСоСтудентамиОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабНачислений.Учащийся КАК Учащийся,
	|	ТабНачислений.Контрагент КАК Контрагент,
	|	ТабНачислений.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ТабНачислений.НачалоПериода КАК НачалоПериода,
	|	ТабНачислений.КонецПериода КАК КонецПериода,
	|	ТабНачислений.ДатаОплаты КАК ДатаОплаты,
	|	ТабНачислений.Валюта КАК Валюта,
	|	ТабНачислений.Сумма КАК СуммаПоДоговору,
	|	ЕСТЬNULL(ТаблицаОплат.СуммаВзаиморасчетовРасход, 0) КАК Оплачено,
	|	ТабНачислений.Сумма - ЕСТЬNULL(ТаблицаОплат.СуммаВзаиморасчетовРасход, 0) КАК Сумма
	|ИЗ
	|	ТабНачислений КАК ТабНачислений
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаОплат КАК ТаблицаОплат
	|		ПО ТабНачислений.Учащийся = ТаблицаОплат.Студент
	|			И ТабНачислений.Контрагент = ТаблицаОплат.Контрагент
	|			И ТабНачислений.ДоговорКонтрагента = ТаблицаОплат.ДоговорКонтрагента
	|			И ТабНачислений.Валюта = ТаблицаОплат.ВалютаВзаиморасчетов";
	
	Запрос.УстановитьПараметр("ТабНачислений", ДанныеДляРасчета);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ПараметрыДолгосрочныхДоговоров.НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ПараметрыДолгосрочныхДоговоров.КонецПериода));
	Запрос.УстановитьПараметр("Организация", ПараметрыДолгосрочныхДоговоров.Организация);
	Запрос.УстановитьПараметр("Факультет", ПараметрыДолгосрочныхДоговоров.Факультет);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьКоличествоРабочихДнейПоГруппам(ДанныеДляРасчета, КоличествоРабочихДней, ПериодНачисления) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабСтудентов.ГруппаСтудентов КАК ГруппаСтудентов
	               |ПОМЕСТИТЬ ТабСтудентов
	               |ИЗ
	               |	&ТабСтудентов КАК ТабСтудентов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТабСтудентов.ГруппаСтудентов КАК ГруппаСтудентов,
	               |	ЕСТЬNULL(ГрафикиРаботыГруппСтудентовСрезПоследних.ГрафикРаботы, НЕОПРЕДЕЛЕНО) КАК ГрафикРаботы,
	               |	&КоличествоРабочихДней КАК КоличествоРабочихДней
	               |ИЗ
	               |	ТабСтудентов КАК ТабСтудентов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикиРаботыГруппСтудентов.СрезПоследних(
	               |				&НачалоПериода,
	               |				ГруппаСтудентов В
	               |					(ВЫБРАТЬ
	               |						ТабСтудентов.ГруппаСтудентов КАК ГруппаСтудентов
	               |					ИЗ
	               |						ТабСтудентов КАК ТабСтудентов)) КАК ГрафикиРаботыГруппСтудентовСрезПоследних
	               |		ПО ГрафикиРаботыГруппСтудентовСрезПоследних.ГруппаСтудентов = ТабСтудентов.ГруппаСтудентов";
				   
	Запрос.УстановитьПараметр("КоличествоРабочихДней", КоличествоРабочихДней);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("ТабСтудентов", ДанныеДляРасчета);
	
	ТаблицаРабочихДнейПоГруппам = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицыРабочихДней Из ТаблицаРабочихДнейПоГруппам Цикл
		
		Если СтрокаТаблицыРабочихДней.ГрафикРаботы <> Неопределено Тогда
			СтрокаТаблицыРабочихДней.КоличествоРабочихДней = РасчетыПоРодительскойПлате.КолРабДней(НачалоМесяца(ПериодНачисления), КонецМесяца(ПериодНачисления), СтрокаТаблицыРабочихДней.ГрафикРаботы);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРабочихДнейПоГруппам;
	
КонецФункции

Функция ПолучитьКалендарныйГрафикГруппы(ГруппаСтудентов, НаДату = Неопределено) Экспорт
	
	КалендарныйГрафик = РаботаСоСтудентамиПовтИсп.ПолучитьКалендарныйГрафикГруппы(ГруппаСтудентов, НаДату);
	
	Возврат КалендарныйГрафик;
	
КонецФункции

//////////////////////////////////////////////////////////////////////////////// 
// ФУНКЦИИ ДЛЯ РАСЧЕТА НАЧИСЛЕНИЙ

Функция ПолучитьСтруктуруПараметровРасчета() Экспорт 

	Возврат Новый Структура("Период, Факультет, Учащиеся, Валюта, НастройкиКомпоновкиДанных, ВидНачисления");		
	
КонецФункции

// Процедура выполняет расчет плановых начислений по услугам образования для формирования план-фактного анализа начислений
//
Процедура ВыполнитьРасчетПлановыхНачислений() Экспорт 
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыРасчета = ПолучитьСтруктуруПараметровРасчета();
	
	ТаблицаПериодов = СформироватьТаблицуНачисленияПериоды();
	Если ТаблицаПериодов.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли; 	
	
	НачатьТранзакцию();
	Попытка
	
		Блокировка = Новый БлокировкаДанных;
		Для каждого СтрокаДанных Из ТаблицаПериодов Цикл
			
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СведенияОСтудентах");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("Студент", СтрокаДанных.Студент);
			ЭлементБлокировки.УстановитьЗначение("Факультет", СтрокаДанных.Факультет);
			
		КонецЦикла; 
		Блокировка.Заблокировать();
		
		// Формируем дерево перерасчета
		ДеревоПериодов = СформироватьДеревоПериодов(ТаблицаПериодов);
		
		// Выполняем перерасчет плановых показателей
		Для каждого СтрокаПериода Из ДеревоПериодов.Строки Цикл
			
			Период = СтрокаПериода.Период;
			
			Для каждого СтрокаФакультета Из СтрокаПериода.Строки Цикл

				Факультет = СтрокаФакультета.Факультет;
				МассивУчащихся = Новый Массив;
				
				Для каждого СтрокаСтудента Из СтрокаФакультета.Строки Цикл
					
					НаборЗаписей = РегистрыСведений.НачисленияПлановыеОбразование.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.ПериодНачисления.Установить(Период);
					НаборЗаписей.Отбор.Факультет.Установить(Факультет);
					НаборЗаписей.Отбор.Студент.Установить(СтрокаСтудента.Студент);
					НаборЗаписей.Записать();
				
					МассивУчащихся.Добавить(СтрокаСтудента.Студент);	
					
				КонецЦикла; 
				
				ПараметрыРасчета.Период = Период;
				ПараметрыРасчета.Факультет = Факультет;
				ПараметрыРасчета.Учащиеся = МассивУчащихся;
				ДанныеРасчета = РассчитатьНачисления(ПараметрыРасчета);
				
				Для каждого СтрокаДанных Из ДанныеРасчета Цикл
			
					НоваяЗапись = РегистрыСведений.НачисленияПлановыеОбразование.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаДанных);
					НоваяЗапись.ПериодНачисления = НачалоМесяца(Период);
					НоваяЗапись.Факультет = Факультет;
					НоваяЗапись.Записать(Ложь);
					
				КонецЦикла; 
				
				Для каждого ЗначениеУчащегося Из МассивУчащихся Цикл
					
					ПериодГраницы = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), 1));
					СтруктураИзмерений = Новый Структура("Факультет, Студент", Факультет, ЗначениеУчащегося); 
					Последовательности.НачисленияОбразование.УстановитьГраницу(ПериодГраницы, СтруктураИзмерений);
					
				КонецЦикла; 
				
			КонецЦикла; 
		КонецЦикла; 
		
		// Выполняем удаление данных в периодах
		СтруктураОтбора = Новый Структура("УдалитьПериод");
		СтруктураОтбора.УдалитьПериод = Истина;
		ТаблицаУдаляемыхПеридов = ТаблицаПериодов.НайтиСтроки(СтруктураОтбора);
		Для каждого СтрокаУдаляемогоПериода Из ТаблицаУдаляемыхПеридов Цикл
			
			НаборЗаписей = РегистрыСведений.НачисленияПлановыеОбразование.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ПериодНачисления.Установить(СтрокаУдаляемогоПериода.Период);
			НаборЗаписей.Отбор.Факультет.Установить(СтрокаУдаляемогоПериода.Факультет);	
			НаборЗаписей.Отбор.Студент.Установить(СтрокаУдаляемогоПериода.Студент);
			НаборЗаписей.Записать();
			
		КонецЦикла; 
	
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось выполнить расчет плановых начислений по причине:
			|%1'"), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Расчет плановых начислений за образование'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ТекстОшибки);
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Функция СформироватьДеревоПериодов(ТаблицаПериодов) Экспорт 
	
	Перем ОбрабатываемыеСтроки;
	
	Если ТаблицаПериодов.Колонки.Найти("УдалитьПериод") = Неопределено Тогда
		
		ОбрабатываемыеСтроки = ТаблицаПериодов;
		
	Иначе
		
		СтруктураОтбора = Новый Структура("УдалитьПериод");
		СтруктураОтбора.УдалитьПериод = Ложь;
		ОбрабатываемыеСтроки = ТаблицаПериодов.НайтиСтроки(СтруктураОтбора);
	
	КонецЕсли;	
	
	РазвернутаяТаблица = ТаблицаПериодов.СкопироватьКолонки("Факультет, Студент, Период");
	ДеревоПериодов = Новый ДеревоЗначений;
	
	Для каждого СтрокаПериода Из ОбрабатываемыеСтроки Цикл
		РазвернутьПериод(РазвернутаяТаблица, СтрокаПериода);
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаПериодов.Факультет,
	               |	ТаблицаПериодов.Студент,
	               |	ТаблицаПериодов.Период
	               |ПОМЕСТИТЬ Периоды
	               |ИЗ
	               |	&Периоды КАК ТаблицаПериодов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Периоды.Факультет КАК Факультет,
	               |	Периоды.Студент,
	               |	Периоды.Период КАК Период
	               |ИЗ
	               |	Периоды КАК Периоды
	               |ИТОГИ ПО
	               |	Период,
	               |	Факультет";
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("Периоды", РазвернутаяТаблица);
	
	Возврат Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции

// Выполняет расчет согласно переданным параметрам
//
// Параметры
//  Параметры  - Структура - содержит следующие элементы:
//						- Период - Дата - за какой период идет расчет (определяется, как НачалоМесяца(Период) <-> КонецМесяца(Период)
//						- Факультет - СправочникСсылка.Подразделения - факультет, в разрезе которого идет расчет
// 						- Учащиеся - Массив, Неопределено - Если Неопределено, то выполняется расчет по всем студентам на факультете (значение может быть не передано)
//                		- Валюта - СправочникСсылка.Валюты, Неопределено - Если Неопределено, то выполняется расчет по всем валютам (значение может быть не передано) 
//                		- ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - если значение не заполнено, то отбор по ИФО не выполняется
//						- НастройкиКомпоновкиДанных - Строка, Неопределено - Адрес во временном хранилище, содержащий настройки СКД. Если Неопределено, то применяются стандартные настройки (значение может быть не передано)
//
// Возвращаемое значение:
//   ТаблицаЗначений - результат выполнения СКД для расчета
//
Функция РассчитатьНачисления(Параметры) Экспорт 
	
	ВидНачисления = Неопределено;
	ИмяМакета = Неопределено;
	
	Параметры.Свойство("ВидНачисления", ВидНачисления);
	Параметры.Свойство("ИмяМакета", ИмяМакета);
	
	Если ВидНачисления = Неопределено Тогда
		ВидНачисления = "НачислениеЗаУслугиОбразования";
	КонецЕсли;
	
	Если ИмяМакета = Неопределено Тогда
		ИмяМакета = "СборДанныхНачислений";
	КонецЕсли;
	
	СхемаСбораДанных = Документы[ВидНачисления].ПолучитьМакет(ИмяМакета);
	СхемаРасчетаДанных = Документы[ВидНачисления].ПолучитьМакет("РасчетНачислений");
	
	Период = Параметры.Период;
	Факультет = Параметры.Факультет;
	Организация = ?(Параметры.Свойство("Организация"), Параметры.Организация, Факультет.Владелец);
	ИФО = ?(Параметры.Свойство("ИФО"), Параметры.ИФО, Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	МассивУчащихся = ?(Параметры.Свойство("Учащиеся"), Параметры.Учащиеся, Неопределено);
	Валюта = ?(Параметры.Свойство("Валюта"), Параметры.Валюта, Неопределено);
	
	Если Параметры.Свойство("НастройкиКомпоновкиДанных") Тогда
		НастройкиКомпоновкиДанных = ?(ЭтоАдресВременногоХранилища(Параметры.НастройкиКомпоновкиДанных), ПолучитьИзВременногоХранилища(Параметры.НастройкиКомпоновкиДанных), Неопределено);	
	Иначе
		НастройкиКомпоновкиДанных = Неопределено;		
	КонецЕсли; 
		
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаСбораДанных));
	
	Если НастройкиКомпоновкиДанных <> Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновкиДанных);
		КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	Иначе
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаСбораДанных.НастройкиПоУмолчанию);
	КонецЕсли;
		
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода", НачалоМесяца(Период));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода", КонецМесяца(Период));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Организация",  ?(ЗначениеЗаполнено(Организация), Организация, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Факультет, "Владелец")));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Факультет", Факультет);
	
	Если МассивУчащихся <> Неопределено Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "СтудентОтбор", МассивУчащихся, ВидСравненияКомпоновкиДанных.ВСписке);
	КонецЕсли; 
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаСбораДанных, КомпоновщикНастроек.Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"), Ложь);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,, Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	СырыеДанные = Новый ТаблицаЗначений();
	СырыеДанные = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ПоДолгосрочнымДоговорам = Параметры.Свойство("ВидОперации")
		И Параметры.ВидОперации = Перечисления.ВидыОперацийНачисленияУчащимся.ПоДолгосрочнымДоговорам;
	
	УдаляемыеСтроки = Новый Массив;
	Для каждого СтрокаДанных Из СырыеДанные Цикл
		
		Если СтрокаДанных.ПериодНачисленияНачало > СтрокаДанных.ПериодНачисленияКонец Тогда						
			УдаляемыеСтроки.Добавить(СтрокаДанных);	
		ИначеЕсли ВидНачисления = "НачислениеЗаУслугиОбразования" И РаботаСоСтудентамиПовтИсп.ПолучитьДанныеСостояния(СтрокаДанных.СостояниеСтудента).ДействуетНачисление = Ложь Тогда 
			УдаляемыеСтроки.Добавить(СтрокаДанных);	
		ИначеЕсли Валюта <> Неопределено
			И НЕ ПоДолгосрочнымДоговорам // Для долгосрочных договоров ставка оплаты может быть не установлена.
			И ЗначениеЗаполнено(СтрокаДанных.СтавкаОплаты)// В некоторых случаях ставка не устанавливается и для краткосрочных договоров, в этом случае расчет выполнится вручную.
			И РаботаСоСтудентамиПовтИсп.ПолучитьДанныеСтавки(СтрокаДанных.СтавкаОплаты).Валюта <> Валюта Тогда
			УдаляемыеСтроки.Добавить(СтрокаДанных);
		КонецЕсли; 
		
	КонецЦикла; 
	
	Для каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		СырыеДанные.Удалить(УдаляемаяСтрока);
	КонецЦикла; 
	
	Если ПоДолгосрочнымДоговорам Тогда
		
		Номенклатура = ?(Параметры.Свойство("Номенклатура"), Параметры.Номенклатура, Неопределено);
		Возврат РассчитатьНачисленияПоДолгосрочнымДоговорам(СырыеДанные, Период, Организация, Факультет, Номенклатура, ИФО, Валюта);
		
	Иначе // ПоКраткосрочнымДоговорам
		
		Если ВидНачисления = "НачислениеЗаУслугиОбразования" Тогда
			КоличествоРабочихДней = РодительскаяПлата.ПолучитьКоличествоРабочихДнейПоКалендарю(НачалоМесяца(Период), КонецМесяца(Период));
			ТаблицаКоличествоРабочихДней = ПолучитьКоличествоРабочихДнейПоГруппам(СырыеДанные, КоличествоРабочихДней, Период);
			ДополненныеДанные = ДополнитьДанныеДляРасчета(СырыеДанные, ТаблицаКоличествоРабочихДней, Организация, Факультет, Период);
		ИначеЕсли ВидНачисления = "НачислениеСтудентамЗаПрочиеУслуги" Тогда
			КоличествоРабочихДней = День(КонецМесяца(Период));
			ДополненныеДанные = ДополнитьДанныеДляРасчетаПрочиеУслуги(СырыеДанные, КоличествоРабочихДней, Организация, Факультет, Период);
		Иначе
			ДополненныеДанные = СырыеДанные;
		КонецЕсли;
		
		ВнешниеНаборыДанных = Новый Структура;
		ВнешниеНаборыДанных.Вставить("ДанныеОтчета", ДополненныеДанные);
		
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаРасчетаДанных, СхемаРасчетаДанных.НастройкиПоУмолчанию, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"), Ложь);
		
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных,, Истина);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		
		Возврат ПроцессорВывода.Вывести(ПроцессорКомпоновки); 
		
	КонецЕсли;
	
КонецФункции

//////////////////////////////////////////////////////////////////////////////// 
// ДОЛГОСРОЧНЫЕ ДОГОВОРЫ

Функция РассчитатьНачисленияПоДолгосрочнымДоговорам(ДоговорыСтудентов, ПериодНачисления, Организация, Факультет, Номенклатура, ИФО, Валюта) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДоговорыСтудентов.Студент КАК Студент,
	|	ДоговорыСтудентов.Контрагент КАК Контрагент,
	|	ДоговорыСтудентов.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ДоговорыСтудентов.Факультет КАК Факультет,
	|	ДоговорыСтудентов.ДоляОплаты КАК ДоляОплаты,
	|	ДоговорыСтудентов.ПорядокВыпискиСФ КАК ПорядокВыпискиСФ,
	|	ДоговорыСтудентов.НачислениеЗаУслугу КАК НачислениеЗаУслугу
	|ПОМЕСТИТЬ ДоговорыСтудентов
	|ИЗ
	|	&ДоговорыСтудентов КАК ДоговорыСтудентов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	СУММА(1) КАК КоличествоСтудентовПоДоговору
	|ПОМЕСТИТЬ КоличествоСтрокПоДоговорам
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДоговорыСтудентов.Студент КАК Студент,
	|		ДоговорыСтудентов.Контрагент КАК Контрагент,
	|		ДоговорыСтудентов.ДоговорКонтрагента КАК ДоговорКонтрагента
	|	ИЗ
	|		ДоговорыСтудентов КАК ДоговорыСтудентов
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ДоговорыСтудентов.Студент,
	|		ДоговорыСтудентов.Контрагент,
	|		ДоговорыСтудентов.ДоговорКонтрагента) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ДоговорКонтрагента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыСписанияДоходовБудущихПериодов.Договор КАК Договор,
	|	ПараметрыСписанияДоходовБудущихПериодов.СпособПризнанияДоходов КАК СпособПризнанияДоходов,
	|	ПараметрыСписанияДоходовБудущихПериодов.ДатаНачалаСписания КАК ДатаНачалаСписания,
	|	ПараметрыСписанияДоходовБудущихПериодов.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
	|	ПараметрыСписанияДоходовБудущихПериодов.СчетДоходов КАК СчетДоходов,
	|	ПараметрыСписанияДоходовБудущихПериодов.СубконтоДоходов1 КАК СубконтоДоходов1,
	|	ПараметрыСписанияДоходовБудущихПериодов.СубконтоДоходов2 КАК СубконтоДоходов2,
	|	ПараметрыСписанияДоходовБудущихПериодов.СубконтоДоходов3 КАК СубконтоДоходов3,
	|	ПараметрыСписанияДоходовБудущихПериодов.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
	|	ПараметрыСписанияДоходовБудущихПериодов.СчетДоходовНУ КАК СчетДоходовНУ,
	|	ПараметрыСписанияДоходовБудущихПериодов.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ
	|ПОМЕСТИТЬ ПараметрыСписанияДоходовБудущихПериодов
	|ИЗ
	|	РегистрСведений.ПараметрыСписанияДоходовБудущихПериодов.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И Договор В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ДоговорыСтудентов.ДоговорКонтрагента
	|					ИЗ
	|						ДоговорыСтудентов)) КАК ПараметрыСписанияДоходовБудущихПериодов
	|ГДЕ
	|	ПараметрыСписанияДоходовБудущихПериодов.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийНачисленияДБП.ДолгосрочныйДоговорОбразование)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиДБП.Организация КАК Организация,
	|	ЕСТЬNULL(ОстаткиДБП.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ОстаткиДБП.КФО КАК КФО,
	|	ОстаткиДБП.КПС КАК КПС,
	|	ОстаткиДБП.КЭК КАК КЭК,
	|	ОстаткиДБП.Счет КАК СчетДБП,
	|	ОстаткиДБП.Подразделение КАК Подразделение,
	|	ВЫРАЗИТЬ(ОстаткиДБП.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ОстаткиДБП.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ЕСТЬNULL(ОстаткиДБП.Валюта, &ВалютаРеглУчета) КАК Валюта,
	|	ОстаткиДБП.СуммаОстатокКт КАК Сумма,
	|	ОстаткиДБП.ВалютнаяСуммаОстатокКт КАК ВалютнаяСумма
	|ПОМЕСТИТЬ ОстаткиДБП
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&СчетаДБП),
	|			&ВидыСубконтоДБП,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И Субконто1 = &Номенклатура
	|				И Субконто2 В
	|					(ВЫБРАТЬ
	|						ДоговорыСтудентов.ДоговорКонтрагента
	|					ИЗ
	|						ДоговорыСтудентов)) КАК ОстаткиДБП
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОборотыДБП.Организация КАК Организация,
	|	ЕСТЬNULL(ОборотыДБП.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ОборотыДБП.КФО КАК КФО,
	|	ОборотыДБП.КПС КАК КПС,
	|	ОборотыДБП.КЭК КАК КЭК,
	|	ОборотыДБП.Счет КАК СчетДБП,
	|	ОборотыДБП.Подразделение КАК Подразделение,
	|	ВЫРАЗИТЬ(ОборотыДБП.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ОборотыДБП.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ОборотыДБП.СуммаОборотДт КАК СписаноВТекущемМесяце
	|ПОМЕСТИТЬ ОборотыДБП
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоМесяца,
	|			&КонецПериода,
	|			,
	|			Счет В (&СчетаДБП),
	|			&ВидыСубконтоДБП,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И Субконто1 = &Номенклатура
	|				И Субконто2 В
	|					(ВЫБРАТЬ
	|						ДоговорыСтудентов.ДоговорКонтрагента
	|					ИЗ
	|						ДоговорыСтудентов),
	|			КорСчет В (&Счета40110),
	|			) КАК ОборотыДБП
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоговорыСтудентов.Студент КАК Студент,
	|	ДоговорыСтудентов.Контрагент КАК Контрагент,
	|	ДоговорыСтудентов.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ДоговорыСтудентов.Факультет КАК Факультет,
	|	ДоговорыСтудентов.ДоляОплаты КАК ДоляОплаты,
	|	ДоговорыСтудентов.ПорядокВыпискиСФ КАК ПорядокВыпискиСФ,
	|	ДоговорыСтудентов.НачислениеЗаУслугу КАК НачислениеЗаУслугу,
	|	ПараметрыСписанияДоходовБудущихПериодов.СпособПризнанияДоходов КАК СпособПризнанияДоходов,
	|	ПараметрыСписанияДоходовБудущихПериодов.ДатаНачалаСписания КАК ДатаНачалаСписания,
	|	ПараметрыСписанияДоходовБудущихПериодов.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
	|	ПараметрыСписанияДоходовБудущихПериодов.СчетДоходов КАК СчетДоходов,
	|	ПараметрыСписанияДоходовБудущихПериодов.СубконтоДоходов1 КАК СубконтоДоходов1,
	|	ПараметрыСписанияДоходовБудущихПериодов.СубконтоДоходов2 КАК СубконтоДоходов2,
	|	ПараметрыСписанияДоходовБудущихПериодов.СубконтоДоходов3 КАК СубконтоДоходов3,
	|	ПараметрыСписанияДоходовБудущихПериодов.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
	|	ПараметрыСписанияДоходовБудущихПериодов.СчетДоходовНУ КАК СчетДоходовНУ,
	|	ПараметрыСписанияДоходовБудущихПериодов.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ,
	|	ОстаткиДБП.ИФО КАК ИФО,
	|	ОстаткиДБП.КФО КАК КФО,
	|	ОстаткиДБП.КПС КАК КПС,
	|	ОстаткиДБП.КЭК КАК КЭК,
	|	ОстаткиДБП.СчетДБП КАК СчетДБП,
	|	ОстаткиДБП.Договор.Наименование КАК ДоговорПредставление,
	|	ОстаткиДБП.Договор.Контрагент.Наименование КАК КонтрагентПредставление,
	|	ОстаткиДБП.Номенклатура КАК Номенклатура,
	|	ОстаткиДБП.Номенклатура.Наименование КАК НоменклатураПредставление,
	|	ОстаткиДБП.Номенклатура.СтавкаНДС КАК СтавкаНДС,
	|	ОстаткиДБП.Валюта КАК Валюта,
	|	ЕСТЬNULL(ОборотыДБП.СписаноВТекущемМесяце, 0) КАК СписаноВТекущемМесяце,
	|	ЕСТЬNULL(ОстаткиДБП.Сумма, 0) КАК ОстатокДБП,
	|	ЕСТЬNULL(ОстаткиДБП.ВалютнаяСумма, 0) КАК ОстатокДБПВВалюте,
	|	КоличествоСтрокПоДоговорам.КоличествоСтудентовПоДоговору КАК КоличествоСтудентовПоДоговору
	|ИЗ
	|	ДоговорыСтудентов КАК ДоговорыСтудентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыСписанияДоходовБудущихПериодов КАК ПараметрыСписанияДоходовБудущихПериодов
	|		ПО ДоговорыСтудентов.ДоговорКонтрагента = ПараметрыСписанияДоходовБудущихПериодов.Договор
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиДБП КАК ОстаткиДБП
	|		ПО ДоговорыСтудентов.ДоговорКонтрагента = ОстаткиДБП.Договор
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОборотыДБП КАК ОборотыДБП
	|		ПО ДоговорыСтудентов.ДоговорКонтрагента = ОборотыДБП.Договор
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоСтрокПоДоговорам КАК КоличествоСтрокПоДоговорам
	|		ПО ДоговорыСтудентов.ДоговорКонтрагента = КоличествоСтрокПоДоговорам.ДоговорКонтрагента
	|ГДЕ
	|	ЕСТЬNULL(ОборотыДБП.СписаноВТекущемМесяце, 0) = 0
	|	И (ЕСТЬNULL(ОстаткиДБП.Сумма, 0) <> 0
	|			ИЛИ ЕСТЬNULL(ОстаткиДБП.ВалютнаяСумма, 0) <> 0)
	|	И &УсловиеПоВалютеРасчетов
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетДБП,
	|	КонтрагентПредставление,
	|	ДоговорПредставление,
	|	НоменклатураПредставление,
	|	Студент";
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоВалютеРасчетов", ?(ИспользоватьВалютныйУчет, "ОстаткиДБП.Валюта = &Валюта", "ИСТИНА"));
	Запрос.УстановитьПараметр("Валюта", Валюта); // Валюта документа.
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
	
	Если ДоговорыСтудентов.Колонки.Найти("ДоляОплаты") = Неопределено Тогда // Прочие услуги.
		ДоговорыСтудентов.Колонки.Добавить("ДоляОплаты", Новый ОписаниеТипов("Число"));
		ДоговорыСтудентов.ЗаполнитьЗначения(100, "ДоляОплаты");
	КонецЕсли;
	
	Если ДоговорыСтудентов.Колонки.Найти("НачислениеЗаУслугу") = Неопределено Тогда // В образовательных услугах колонку требуется создать.
		ДоговорыСтудентов.Колонки.Добавить("НачислениеЗаУслугу", Новый ОписаниеТипов("СправочникСсылка.НачисленияСтудентамЗаПрочиеУслуги"));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДоговорыСтудентов", ДоговорыСтудентов); // Таблица подбора студентов.
	
	Запрос.УстановитьПараметр("Организация",  Организация);
	Запрос.УстановитьПараметр("ИФО",		  ИФО);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ПериодНачисления));
	Запрос.УстановитьПараметр("СчетаДБП",     БухгалтерскийУчет.СписокСчетов("401.40"));
	Запрос.УстановитьПараметр("Счета40110",   БухгалтерскийУчет.СписокСчетов("401.10"));
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("ВидыСубконтоДБП", ВидыСубконто);
	
	ТаблицаОстатковДБП = Запрос.Выполнить().Выгрузить();
	
	// Получим данные графиков оплат для договоров с признанием доходов текущего периода по графику.
	ПризнаниеДоходовПоГрафику = Новый Структура("СпособПризнанияДоходов", Перечисления.СпособыПризнанияРасходов.ПоГрафику);
	СтрокиСПризнаниемПоГрафику = ТаблицаОстатковДБП.НайтиСтроки(ПризнаниеДоходовПоГрафику);
	Если СтрокиСПризнаниемПоГрафику.Количество() > 0 Тогда
		
		ИспользоватьДетализациюПоКОСГУ = ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями");
		
		ТаблицаОстатковДБП.Колонки.Добавить("СуммаПоГрафику",
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
		
		ДоговорыПоОдномуСтуденту = Новый Массив;
		СтрокиПоОдномуСтуденту = Новый Массив;
		ДоговорыПоНесколькимСтудентам = Новый Массив;
		СтрокиПоНесколькимСтудентам = Новый Массив;
		Для Каждого Строка Из СтрокиСПризнаниемПоГрафику Цикл
			Если Строка.КоличествоСтудентовПоДоговору > 1 Тогда
				ДоговорыПоНесколькимСтудентам.Добавить(Строка.ДоговорКонтрагента);
				СтрокиПоНесколькимСтудентам.Добавить(Строка);
			Иначе
				ДоговорыПоОдномуСтуденту.Добавить(Строка.ДоговорКонтрагента);
				СтрокиПоОдномуСтуденту.Добавить(Строка);
			КонецЕсли;
		КонецЦикла;
		
		Если ДоговорыПоОдномуСтуденту.Количество() > 0 Тогда // Расчет в модели "1 Договор = 1 Студент".
			
			ГрафикНачисления = КонтрольИсполненияДоговоров.ГрафикИсполненияПоДоговору(
				Организация,
				ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ДоговорыПоОдномуСтуденту),
				"Месяц",
				НачалоМесяца(ПериодНачисления));
			
			// Распределим остаток предстоящих доходов по всем периодам графика по договору.
			ГрафикНачисления.Колонки.Добавить("ДоходыОтРеализации",
				Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
			Для Каждого СтрокаТаблицы Из СтрокиПоОдномуСтуденту Цикл
				
				//ОтборСтрок = Новый Структура("ИФО,КФО,Контрагент");
				ОтборСтрок = Новый Структура("ИФО,КФО");
				ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаТаблицы);
				ОтборСтрок.Вставить("Договор", СтрокаТаблицы.ДоговорКонтрагента);
				ОтборСтрок.Вставить("КПС", СтрокаТаблицы.КПС);
				Если ИспользоватьДетализациюПоКОСГУ Тогда
					ОтборСтрок.Вставить("КЭК", СтрокаТаблицы.КЭК);
				КонецЕсли;
				НайденныеСтрокиГрафика = ГрафикНачисления.НайтиСтроки(ОтборСтрок);
				
				Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(СтрокаТаблицы.Валюта) И СтрокаТаблицы.Валюта <> ВалютаРегламентированногоУчета Тогда
					ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаТаблицы.ОстатокДБПВВалюте,
						НайденныеСтрокиГрафика, "ДоходыОтРеализации", "Сумма", Ложь);
				Иначе
					ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаТаблицы.ОстатокДБП,
						НайденныеСтрокиГрафика, "ДоходыОтРеализации", "Сумма", Ложь);
				КонецЕсли;
				
			КонецЦикла;
			
			// Распределим сумму по графику по строкам ДБП пропорционально остатку оплаты.
			Для Каждого СтрокаПоГрафику Из ГрафикНачисления Цикл
				
				Если СтрокаПоГрафику.Период < НачалоМесяца(ПериодНачисления)
				 ИЛИ СтрокаПоГрафику.Период > КонецМесяца(ПериодНачисления) Тогда
					Продолжить; // Пропускаем строки графика из других периодов.
				КонецЕсли;
				
				//ОтборСтрок = Новый Структура("ИФО,КФО,Контрагент");
				ОтборСтрок = Новый Структура("ИФО,КФО");
				ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаПоГрафику);
				ОтборСтрок.Вставить("ДоговорКонтрагента", СтрокаПоГрафику.Договор);
				ОтборСтрок.Вставить("КПС", СтрокаПоГрафику.КПС);
				Если ИспользоватьДетализациюПоКОСГУ Тогда
					ОтборСтрок.Вставить("КЭК", СтрокаПоГрафику.КЭК);
				КонецЕсли;
				НайденныеСтрокиДБП = ТаблицаОстатковДБП.НайтиСтроки(ОтборСтрок);
				
				ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаПоГрафику.ДоходыОтРеализации,
					НайденныеСтрокиДБП, "СуммаПоГрафику", "ОстатокДБП", Ложь);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ДоговорыПоНесколькимСтудентам.Количество() > 0 Тогда // Расчет в модели "1 Договор = N Студентов".
			
			ГрафикНачисления = РаботаСоСтудентами.ГрафикНачисленийПоДолгосрочнымДоговорам(
				ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ДоговорыПоНесколькимСтудентам),
				Организация,
				КонецДня(ПериодНачисления),
				НачалоМесяца(ПериодНачисления),
				КонецМесяца(ПериодНачисления));
			
			Для Каждого СтрокаТаблицы Из СтрокиПоНесколькимСтудентам Цикл
				
				ОтборСтрок = Новый Структура();
				ОтборСтрок.Вставить("Договор", СтрокаТаблицы.ДоговорКонтрагента);
				ОтборСтрок.Вставить("Учащийся", СтрокаТаблицы.Студент);
				ОтборСтрок.Вставить("Контрагент", СтрокаТаблицы.Контрагент);
				НайденныеСтрокиГрафика = ГрафикНачисления.НайтиСтроки(ОтборСтрок);
				
				Для Каждого СтрокаГрафика Из НайденныеСтрокиГрафика Цикл
					СтрокаТаблицы.СуммаПоГрафику = СтрокаТаблицы.СуммаПоГрафику + СтрокаГрафика.СуммаВВалюте;
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицаНачислений = ТаблицаОстатковДБП.СкопироватьКолонки();
	ТаблицаНачислений.Колонки.Добавить("Сумма",
		ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));
	ТаблицаНачислений.Колонки.Добавить("СуммаНДС",
		ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));
	ТаблицаНачислений.Колонки.Добавить("Коэффициент",
		ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10, 8));
	ТаблицаНачислений.Колонки.Добавить("КоэффициентЧислитель",
		ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(14, 8));
	ТаблицаНачислений.Колонки.Добавить("КоэффициентЗнаменатель",
		ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(14, 8));
	ТаблицаНачислений.Колонки.Добавить("ОтразитьВГрафикеИсполненияДоговора",
		Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыДокументовКонтрольИсполненияДоговоров"));
	
	// Расчет сумм списания доходов будущих периодов.
	Для Каждого ОстаткиДБП Из ТаблицаОстатковДБП Цикл
		
		Доля = 0;
		ПротоколРасчета = Новый Структура("Числитель, Знаменатель", 0, 0);
		Если ОстаткиДБП.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням
		 ИЛИ ОстаткиДБП.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам Тогда
			
			Доля = БухгалтерскийУчет.ДоляОчередногоМесяцаПриРавномерномПризнанииДоходовРасходов(
				ОстаткиДБП.СпособПризнанияДоходов,
				ПериодНачисления,
				ОстаткиДБП.ДатаНачалаСписания,
				ОстаткиДБП.ДатаОкончанияСписания,
				ПротоколРасчета);
				
			Если Доля = 0
				И ЗначениеЗаполнено(ОстаткиДБП.ДатаНачалаСписания)
				И КонецМесяца(ПериодНачисления) < КонецМесяца(ОстаткиДБП.ДатаОкончанияСписания) Тогда
				Продолжить; // Срок списания еще не начался.
			КонецЕсли;
			
		ИначеЕсли ОстаткиДБП.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику Тогда
			
			Если ОстаткиДБП.СуммаПоГрафику = 0 Тогда
				Продолжить; // Не начисляется в данном месяце.
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока = ТаблицаНачислений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиДБП);
		
		Если ОстаткиДБП.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням
		 ИЛИ ОстаткиДБП.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам Тогда
		
			НоваяСтрока.Коэффициент            = Доля;
			НоваяСтрока.КоэффициентЧислитель   = ПротоколРасчета.Числитель;
			НоваяСтрока.КоэффициентЗнаменатель = ПротоколРасчета.Знаменатель;
			
			// Ставка НДС по умолчанию установлена в карточке номенклатуры.
			СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(НоваяСтрока.СтавкаНДС);
			
			ДоляОплаты = ОстаткиДБП.ДоляОплаты / 100;
			
			// Заполним сумму и НДС по договору.
			Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ОстаткиДБП.Валюта) И ОстаткиДБП.Валюта <> ВалютаРегламентированногоУчета Тогда
				НоваяСтрока.Сумма = Доля * ДоляОплаты * НоваяСтрока.ОстатокДБПВВалюте;
			Иначе // В рублях.
				НоваяСтрока.Сумма = Доля * ДоляОплаты * НоваяСтрока.ОстатокДБП;
			КонецЕсли;
			НоваяСтрока.СуммаНДС = НоваяСтрока.Сумма * СтавкаНДС / (100 + СтавкаНДС);
			
		ИначеЕсли ОстаткиДБП.СпособПризнанияДоходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику Тогда
			
			// Ставка НДС по умолчанию установлена в карточке номенклатуры.
			СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(НоваяСтрока.СтавкаНДС);
			
			// Заполним сумму и НДС по договору.
			Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ОстаткиДБП.Валюта) И ОстаткиДБП.Валюта <> ВалютаРегламентированногоУчета Тогда
				НоваяСтрока.Сумма = МИН(ОстаткиДБП.СуммаПоГрафику, ОстаткиДБП.ОстатокДБПВВалюте);
			Иначе // В рублях.
				НоваяСтрока.Сумма = МИН(ОстаткиДБП.СуммаПоГрафику, ОстаткиДБП.ОстатокДБП);
			КонецЕсли;
			НоваяСтрока.СуммаНДС = НоваяСтрока.Сумма * СтавкаНДС / (100 + СтавкаНДС);
			
			// Коэффициент списания рассчитываем по фактической стоимости списания, как если бы указали ее вручную.
			НоваяСтрока.Коэффициент = ?(НоваяСтрока.ОстатокДБП = 0, 0,
				НоваяСтрока.Сумма / НоваяСтрока.ОстатокДБП);
			НоваяСтрока.КоэффициентЧислитель	= 0;
			НоваяСтрока.КоэффициентЗнаменатель	= 0;
			
		КонецЕсли;
		
		НоваяСтрока.ОтразитьВГрафикеИсполненияДоговора = Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас;
		
		// Налоговый учет.
		Если НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, ПериодНачисления, НоваяСтрока.КФО) Тогда
			
			Если НЕ ЗначениеЗаполнено(ОстаткиДБП.ВидДеятельностиНУ) Тогда
				// По умолчанию - основная система налогообложения.
				НоваяСтрока.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ОстаткиДБП.СчетДоходовНУ) Тогда
				// По умолчанию - доходы от обычных видов деятельности.
				НоваяСтрока.СчетДоходовНУ = БухгалтерскийУчет.СчетПоКоду("Н90.01", ПериодНачисления);
			КонецЕсли;
			
			Если НЕ БухгалтерскийУчет.СчетВИерархии(ОстаткиДБП.СчетДоходовНУ, "Н91.01") Тогда
				НоваяСтрока.СтатьяПрочихДоходовНУ = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаНачислений;
	
КонецФункции

Функция ПараметрыПересчетаПериодаОбучения(СтрокаГрафика, ДокументОбъект) Экспорт
	
	ПараметрыПересчетаПериода = Новый Структура;
	ПараметрыПересчетаПериода.Вставить("ПересчитатьСтрокуГрафика", Ложь);
	ПараметрыПересчетаПериода.Вставить("ДоляПериода", 0);
	ПараметрыПересчетаПериода.Вставить("ЭтоНеполныйПериодПоДатеНачала",    Ложь);
	ПараметрыПересчетаПериода.Вставить("ЭтоНеполныйПериодПоДатеОкончания", Ложь);
	ПараметрыПересчетаПериода.Вставить("КоличествоДнейВПериодеОбучения", Ложь);
	ПараметрыПересчетаПериода.Вставить("КоличествоДнейИсключеноОтбором", Ложь);
	
	// Пересчет строк в зависимости от периода обучения.
	Если Не ЗначениеЗаполнено(ДокументОбъект.НачалоПериодаОбучения)
	   И Не ЗначениеЗаполнено(ДокументОбъект.КонецПериодаОбучения) Тогда
		
		// По умолчанию индексируем только незавершенные периоды.
		ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика = КонецДня(СтрокаГрафика.КонецПериода) > КонецДня(ДокументОбъект.Дата);
		ПараметрыПересчетаПериода.ДоляПериода = 1; // Пропорционально не рассчитываем.
		
	Иначе // Отбор по периоду обучения.
		
		Если ЗначениеЗаполнено(ДокументОбъект.НачалоПериодаОбучения)
		   И ЗначениеЗаполнено(ДокументОбъект.КонецПериодаОбучения) Тогда // Оба ограничения заданы.
			ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика = // Период обучения полностью попадает в отбор.
				( НачалоДня(СтрокаГрафика.НачалоПериода) >= НачалоДня(ДокументОбъект.НачалоПериодаОбучения)
				И КонецДня(СтрокаГрафика.КонецПериода) <= КонецДня(ДокументОбъект.КонецПериодаОбучения) );
			Если Не ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика Тогда
				Если НачалоДня(СтрокаГрафика.НачалоПериода)< НачалоДня(ДокументОбъект.НачалоПериодаОбучения)
					И КонецДня(СтрокаГрафика.КонецПериода) > НачалоДня(ДокументОбъект.НачалоПериодаОбучения) Тогда
					// Период обучения частично попадает в отбор.
					ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика = Истина;
					ПараметрыПересчетаПериода.ЭтоНеполныйПериодПоДатеНачала = Истина;
				КонецЕсли;
				Если КонецДня(СтрокаГрафика.КонецПериода) > КонецДня(ДокументОбъект.КонецПериодаОбучения)
					И НачалоДня(СтрокаГрафика.НачалоПериода) < КонецДня(ДокументОбъект.КонецПериодаОбучения) Тогда
					// Период обучения частично попадает в отбор.
					ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика = Истина;
					ПараметрыПересчетаПериода.ЭтоНеполныйПериодПоДатеОкончания = Истина;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ДокументОбъект.НачалоПериодаОбучения) Тогда // Только ограничение на начало периода.
			ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика = // Период обучения полностью попадает в отбор.
				НачалоДня(СтрокаГрафика.НачалоПериода) >= НачалоДня(ДокументОбъект.НачалоПериодаОбучения);
			Если Не ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика
				И НачалоДня(СтрокаГрафика.НачалоПериода)< НачалоДня(ДокументОбъект.НачалоПериодаОбучения)
				И КонецДня(СтрокаГрафика.КонецПериода) > НачалоДня(ДокументОбъект.НачалоПериодаОбучения) Тогда
				// Период обучения частично попадает в отбор.
				ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика = Истина;
				ПараметрыПересчетаПериода.ЭтоНеполныйПериодПоДатеНачала = Истина;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ДокументОбъект.КонецПериодаОбучения) Тогда // Только ограничение на конец периода.
			ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика = // Период обучения полностью попадает в отбор.
				КонецДня(СтрокаГрафика.КонецПериода) <= КонецДня(ДокументОбъект.КонецПериодаОбучения);
			Если Не ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика
				И КонецДня(СтрокаГрафика.КонецПериода) > КонецДня(ДокументОбъект.КонецПериодаОбучения)
				И НачалоДня(СтрокаГрафика.НачалоПериода) < КонецДня(ДокументОбъект.КонецПериодаОбучения) Тогда
				// Период обучения частично попадает в отбор.
				ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика = Истина;
				ПараметрыПересчетаПериода.ЭтоНеполныйПериодПоДатеОкончания = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика Тогда
			
			ПараметрыПересчетаПериода.КоличествоДнейВПериодеОбучения =
				( КонецДня(СтрокаГрафика.КонецПериода) - КонецДня(СтрокаГрафика.НачалоПериода) ) / (24*60*60) + 1;
			ПараметрыПересчетаПериода.КоличествоДнейИсключеноОтбором = 0;
			Если ПараметрыПересчетаПериода.ЭтоНеполныйПериодПоДатеНачала Тогда // Часть месяца (периода обучения), рассчитываем пропорционально.
				ПараметрыПересчетаПериода.КоличествоДнейИсключеноОтбором = ПараметрыПересчетаПериода.КоличествоДнейИсключеноОтбором +
					( КонецДня(ДокументОбъект.НачалоПериодаОбучения) - КонецДня(СтрокаГрафика.НачалоПериода) ) / (24*60*60);
			КонецЕсли;
			Если ПараметрыПересчетаПериода.ЭтоНеполныйПериодПоДатеОкончания Тогда // Часть месяца (периода обучения), рассчитываем пропорционально.
				ПараметрыПересчетаПериода.КоличествоДнейИсключеноОтбором = ПараметрыПересчетаПериода.КоличествоДнейИсключеноОтбором +
					( КонецДня(СтрокаГрафика.КонецПериода) - КонецДня(ДокументОбъект.КонецПериодаОбучения) ) / (24*60*60);
			КонецЕсли;
			
			ПараметрыПересчетаПериода.ДоляПериода =
				(ПараметрыПересчетаПериода.КоличествоДнейВПериодеОбучения - ПараметрыПересчетаПериода.КоличествоДнейИсключеноОтбором) / ПараметрыПересчетаПериода.КоличествоДнейВПериодеОбучения;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ПараметрыПересчетаПериода.ПересчитатьСтрокуГрафика Тогда
		ПараметрыПересчетаПериода.ДоляПериода = 0;
	КонецЕсли;
	
	ВОзврат ПараметрыПересчетаПериода;
	
КонецФункции


