	Возврат Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.ПолучитьШаблонЗаполнения(Номенклатура);	
КонецФункции

Функция ВернутьПлательщикаПоУчащемусяНаДату(Учащийся,Дата) Экспорт
	
	Если ТипЗнч(Учащийся) = Тип("СправочникСсылка.Дети") Тогда

		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПлательщикиПоУслугамДДУ.Плательщик КАК Плательщик
			|ИЗ
			|	РегистрСведений.ПлательщикиПоУслугамДДУ.СрезПоследних(&Дата, Ребенок = &Ребенок) КАК ПлательщикиПоУслугамДДУ";

		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("Ребенок", Учащийся);

		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Возврат ВыборкаДетальныеЗаписи.Плательщик;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

