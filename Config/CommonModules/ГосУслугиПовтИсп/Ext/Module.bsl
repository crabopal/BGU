Функция ВернутьТаблицуНалоговыхРеквизитовПоДокументу(Ссылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НачислениеДоходовНачисления.ПоказательДаты,
		|	НачислениеДоходовНачисления.ПоказательНомера,
		|	НачислениеДоходовНачисления.Ссылка.ПоказательОснования КАК ПоказательОснования,
		|	НачислениеДоходовНачисления.Ссылка.ПоказательПериода КАК ПоказательПериода,
		|	НачислениеДоходовНачисления.Ссылка.ПоказательТипа КАК ПоказательТипа,
		|	НачислениеДоходовНачисления.Ссылка.СтатусСоставителя КАК СтатусСоставителя,
		|	НачислениеДоходовНачисления.ИДСтроки,
		|	НачислениеДоходовНачисления.Ссылка.КодБКНалога КАК КодБКПлатежа,
		|	НачислениеДоходовНачисления.Ссылка.КодОКАТО КАК КодОКАТО
		|ИЗ
		|	Документ.НачислениеДоходов.Начисления КАК НачислениеДоходовНачисления
		|ГДЕ
		|	НачислениеДоходовНачисления.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ВернутьТаблицуКПСКЭКПоДокументу(Ссылка) Экспорт

	Запрос = Новый Запрос;
	
	ТипДокумента = ТипЗнч(Ссылка);
	Если ТипДокумента = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТЧДок.КПС КАК КПС,
			|	ТЧДок.КЭК КАК КЭК,
			|	ТЧДок.ИДСтроки КАК ИДСтроки,
			|	ТЧДок.КПС.ДатаНачалаДействия КАК НачалоДействияКПС
			|ИЗ
			|	Документ.СписаниеДоходовБудущихПериодов.ДоходыБудущихПериодов КАК ТЧДок
			|ГДЕ
			|	ТЧДок.Ссылка = &Ссылка";
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НачислениеПроцентовПенейШтрафовКПолучению") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТЧДок.КПС КАК КПС,
			|	ТЧДок.КЭКДоходов КАК КЭК,
			|	ТЧДок.ИДСтроки КАК ИДСтроки,
			|	ТЧДок.КПС.ДатаНачалаДействия КАК НачалоДействияКПС
			|ИЗ
			|	Документ.НачислениеПроцентовПенейШтрафовКПолучению.Начисления КАК ТЧДок
			|ГДЕ
			|	ТЧДок.Ссылка = &Ссылка";	
	КонецЕсли;

	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции