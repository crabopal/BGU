#Область ЗагрузкаМестонахождения

Функция ТипыПодразделений()
	
	// По классификатору "ФРМО. Типы структурных подразделений"
	// https://nsi.rosminzdrav.ru/dictionaries/1.2.643.5.1.13.13.99.2.299
	
	Типы = Новый Массив;
	Типы.Добавить(1); // Амбулаторный
	Типы.Добавить(2); // Стационарный
	Типы.Добавить(3); // Лабораторно-диагностический
	Типы.Добавить(4); // Инструментально-диагностический
	Типы.Добавить(5); // Скорая медицинская помощь
	Типы.Добавить(6); // Административно-хозяйственный (вспомогательный)
	Типы.Добавить(7); // Фармацевтический
	
	Возврат Типы;
	
КонецФункции

