
#Область ПрограммныйИнтерфейс

Функция ТокенЗапроса(ДанныеТокена, МенеджерКриптографии) Экспорт
	
	Возврат ТокенЗапросаJWTПоГОСТ(ДанныеТокена, МенеджерКриптографии);
	
КонецФункции

Функция ЭтоПустойНомер(Номер) Экспорт
	
	ПустыеНомера = Новый Массив;
	ПустыеНомера.Добавить("нет");
	ПустыеНомера.Добавить("отсутствует");
	ПустыеНомера.Добавить("без номера");
	
	Возврат (ПустыеНомера.Найти(НРег(СокрЛП(Номер))) <> Неопределено);
	
КонецФункции

Функция ПустойНомерПоУмолчанию() Экспорт
	
	Возврат "Нет";
	
КонецФункции

#Если Не ВебКлиент Тогда

Функция ПроверитьПодключение(НастройкаПодключения) Экспорт
	
	Настройка = ДанныеНастройкиПодключения(НастройкаПодключения);
	АдресРесурса = СтрШаблон("/org/%1", Настройка.ИдентификаторОрганизации);
	Ответ = ВыполнитьЗапрос(Настройка, АдресРесурса);
	
	Если ЗначениеЗаполнено(Ответ.СообщениеОбОшибке) Тогда
		Возврат Ответ.СообщениеОбОшибке;
	КонецЕсли;
	
	Возврат ?(Ответ.Содержимое.content.oid = Настройка.ИдентификаторОрганизации,
		НСтр("ru = 'Подключение выполнено успешно.'"), НСтр("ru = 'Подключение не выполнено.'"));
	
КонецФункции

Функция ЗагрузитьМестонахождение(НастройкаПодключения) Экспорт
	
	Результат = Новый Структура("СодержимоеОтветов,СообщениеОбОшибке", Неопределено, "");
	
	Настройка = ДанныеНастройкиПодключения(НастройкаПодключения);
	
	// Загрузка подразделений
	
	Подразделения = Новый Массив;
	
	РазмерСтраницы = 100;
	
	Для Каждого ТипПодразделения Из ТипыПодразделений() Цикл
		
		ПолученоДанных = 0;
		ВсегоДанных    = 1;
		
		Пока ПолученоДанных < ВсегоДанных Цикл
			
			АдресРесурса = СтрШаблон("/org/depart?departTypeId=%1&oid=%2&limit=%3&offset=%4",
				ТипПодразделения, Настройка.ИдентификаторОрганизации, РазмерСтраницы, ПолученоДанных);
			Ответ = ВыполнитьЗапрос(Настройка, АдресРесурса);
			
			Если ЗначениеЗаполнено(Ответ.СообщениеОбОшибке) Тогда
				Результат.СообщениеОбОшибке = Ответ.СообщениеОбОшибке;
				Возврат Результат;
			КонецЕсли;
			
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Подразделения, Ответ.Содержимое.content);
			
			ПолученоДанных = ПолученоДанных + Ответ.Содержимое.content.Количество();
			ВсегоДанных = Ответ.Содержимое.total;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Загрузка зданий
	
	АдресРесурса = СтрШаблон("/org/building?oid=%1", Настройка.ИдентификаторОрганизации);
	Ответ = ВыполнитьЗапрос(Настройка, АдресРесурса);
	
	Если ЗначениеЗаполнено(Ответ.СообщениеОбОшибке) Тогда
		Результат.СообщениеОбОшибке = Ответ.СообщениеОбОшибке;
		Возврат Результат;
	КонецЕсли;
	
	Здания = Ответ.Содержимое.content;
	
	// Результат
	
	Результат.СодержимоеОтветов = Новый Структура("Здания,Подразделения", Здания, Подразделения);
	Возврат Результат;
	
КонецФункции

Функция ЗагрузитьОборудование(НастройкаПодключения, ИдентификаторОборудования = Неопределено) Экспорт
	
	Результат = Новый Структура("СписокОборудования,СообщениеОбОшибке", Неопределено, "");
	
	Настройка = ДанныеНастройкиПодключения(НастройкаПодключения);
	
	Если ИдентификаторОборудования = Неопределено Тогда
		АдресРесурса = СтрШаблон("/org/equipment?oid=%1", Настройка.ИдентификаторОрганизации);
	Иначе
		АдресРесурса = СтрШаблон("/org/equipment/get?oid=%1&entityId=%2", Настройка.ИдентификаторОрганизации, ИдентификаторОборудования);
	КонецЕсли;
	
	Ответ = ВыполнитьЗапрос(Настройка, АдресРесурса);
	
	Если ЗначениеЗаполнено(Ответ.СообщениеОбОшибке) Тогда
		Результат.СообщениеОбОшибке = Ответ.СообщениеОбОшибке;
		Возврат Результат;
	КонецЕсли;
	
	Если ИдентификаторОборудования = Неопределено Тогда
		СписокДанных = Ответ.Содержимое.content;
	Иначе
		СписокДанных = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ответ.Содержимое.content);
	КонецЕсли;
	
	СписокОборудования = Новый Массив;
	
	Для Каждого СтрокаДанных Из СписокДанных Цикл
		
		Данные								= ОписаниеМедицинскогоОборудования();
		Данные.Идентификатор				= СтрокаДанных.equipmentId;
		Данные.Наименование					= СтрокаДанных.equipmentName;
		Данные.ТипОборудования				= СтрокаДанных.type;
		Данные.РазделИзделия				= ПрочитатьОбъект(СтрокаДанных.equipmentSection, "code", "name", Истина);
		Данные.ТипИзделия					= ПрочитатьОбъект(СтрокаДанных.equipmentType, "code", "name", Истина);
		Данные.ТребуетсяЗамена				= СтрокаДанных.needReplace;
		Данные.Общее						= СтрокаДанных.isShared;
		Данные.НомерУдостоверения			= СтрокаДанных.registrationCertificate;
		Данные.ДатаРегистрации				= ПрочитатьДату(СтрокаДанных.registrationDate);
		Данные.Модель						= СтрокаДанных.model;
		Данные.Производитель				= СтрокаДанных.vendor;
		Данные.СтранаПроизводства			= СтрокаДанных.oksmId;
		Данные.Адрес						= ПрочитатьАдрес(СтрокаДанных.anotherAddress);
		Данные.ПричинаИногоАдреса			= СтрокаДанных.anotherAddressReason;
		Данные.Здание						= ПрочитатьЗдание(СтрокаДанных.building);
		Данные.Подразделение				= ПрочитатьПодразделение(СтрокаДанных.depart);
		Данные.ИнвентарныйНомер				= СтрокаДанных.inventoryNumber;
		Данные.СерийныйНомер				= СтрокаДанных.serialNumber;
		Данные.ДатаВыпуска					= ПрочитатьДату(СтрокаДанных.productDate);
		Данные.ДатаВводаВЭксплуатацию		= ПрочитатьДату(СтрокаДанных.beginDate);
		Данные.ДатаВыводаИзЭксплуатации		= ПрочитатьДату(СтрокаДанных.endDate);
		Данные.ПричинаВыводаИзЭксплуатации	= СтрокаДанных.endReason;
		Данные.СрокСлужбы					= СтрокаДанных.lifeTime;
		Данные.Количество					= СтрокаДанных.count;
		
		СписокОборудования.Добавить(Данные);
		
	КонецЦикла;
	
	Результат.СписокОборудования = СписокОборудования;
	
	Возврат Результат;
	
КонецФункции

// Формирует и выполняет запросы синхронизации - создания, изменения, удаления
//
Процедура СинхронизироватьОборудование(НастройкаПодключения, ОперацииОборудования) Экспорт
	
	Настройка = ДанныеНастройкиПодключения(НастройкаПодключения);
	
	Для Каждого ОперацияОборудования Из ОперацииОборудования Цикл
		
		ОтветСервиса = Неопределено;
		
		Если ОперацияОборудования.Операция = 1 Тогда
			ОтветСервиса = ВыгрузитьЕдиницуОборудования(ОперацияОборудования, Настройка);
		ИначеЕсли ОперацияОборудования.Операция = 2 Тогда
			// Запрос не требуется
		ИначеЕсли ОперацияОборудования.Операция = 3 Тогда
			ОтветСервиса = УдалитьЕдиницуОборудования(ОперацияОборудования, Настройка);
		КонецЕсли;
		
		ОперацияОборудования.Вставить("ОтветСервиса", ОтветСервиса);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВыгрузитьЕдиницуОборудования(Операция, Настройка)
	
	СозданиеНового = Не ЗначениеЗаполнено(Операция.ДанныеБГУ.Идентификатор);
	Если СозданиеНового Тогда
		Метод = "POST";
		ИдОборудования = "";
	Иначе
		Метод = "PUT";
		ИдОборудования = "&entityId=" + Операция.ДанныеБГУ.Идентификатор;
	КонецЕсли;
	
	АдресРесурса = "/org/equipment?oid=" + Настройка.ИдентификаторОрганизации + ИдОборудования;
	ТекстЗапроса = СформироватьТекстЗапросаПередачиОборудования(Операция.ДанныеБГУ);
	
	Ответ = ВыполнитьЗапрос(Настройка, АдресРесурса, Метод, ТекстЗапроса);
	Ответ.Вставить("СозданиеНового", СозданиеНового);
	
	Возврат Ответ;
	
КонецФункции

Функция СформироватьТекстЗапросаПередачиОборудования(Данные)
	
	ДанныеЗаписи = Новый Структура;
	
	Если Данные.Здание <> Неопределено Тогда
		Здание = Новый Структура("buildingId", Данные.Здание.Код);
		Если Данные.Здание.Этажи.Количество() > 0 Тогда
			Этажи = Новый Массив;
			Для Каждого СтрокаЭтаж Из Данные.Здание.Этажи Цикл
				Этаж = Новый Структура("floorId", СтрокаЭтаж.Код);
				Если СтрокаЭтаж.Помещения.Количество() > 0 Тогда
					Помещения = Новый Массив;
					Для Каждого СтрокаПомещения Из СтрокаЭтаж.Помещения Цикл
						Помещение = Новый Структура("roomId", СтрокаПомещения.Код);
						Помещения.Добавить(Помещение);
					КонецЦикла;
				КонецЕсли;
				Этаж.Вставить("buildingRoom", Помещения);
				Этажи.Добавить(Этаж);
			КонецЦикла;
			Здание.Вставить("floor", Этажи);
		КонецЕсли;
		ДанныеЗаписи.Вставить("building", Здание);
	КонецЕсли;
	
	Если Данные.Подразделение <> Неопределено Тогда
		Подразделение = Новый Структура("departId", Данные.Подразделение.Код);
		
		Если Данные.Подразделение.Отделения.Количество() > 0 Тогда
			Отделения = Новый Массив;
			Для Каждого СтрокаОтделение Из Данные.Подразделение.Отделения Цикл
				Отделение = Новый Структура("subdivisionId", СтрокаОтделение.Код);
				Отделения.Добавить(Отделение);
			КонецЦикла;
			Подразделение.Вставить("subdivision", Отделения);
		КонецЕсли;
		
		Если Данные.Подразделение.Кабинеты.Количество() > 0 Тогда
			Кабинеты = Новый Массив;
			Для Каждого СтрокаКабинет Из Данные.Подразделение.Кабинеты Цикл
				Кабинет = Новый Структура("roomId", СтрокаКабинет.Код);
				Кабинеты.Добавить(Кабинет);
			КонецЦикла;
			Подразделение.Вставить("room", Кабинеты);
		КонецЕсли;
		
		ДанныеЗаписи.Вставить("depart", Подразделение);
		
	КонецЕсли;
	
	ДанныеЗаписи.Вставить("type", Данные.ТипОборудования);
	
	Если Данные.РазделИзделия <> Неопределено Тогда
		ДанныеЗаписи.Вставить("equipmentSection", Новый Структура("code", Данные.РазделИзделия.Код));
	КонецЕсли;
	Если Данные.ТипИзделия <> Неопределено Тогда
		ДанныеЗаписи.Вставить("equipmentType", Новый Структура("code", Данные.ТипИзделия.Код));
	КонецЕсли;
	
	Если Данные.Адрес <> Неопределено Тогда
		
		ДанныеРегиона = Новый Структура;
		ДанныеРегиона.Вставить("id"					, Данные.Адрес.Регион.Код);
		ДанныеРегиона.Вставить("territoryCode"		, Данные.Адрес.Регион.КодРегиона);
		ДанныеРегиона.Вставить("isFederalCity"		, Данные.Адрес.Регион.Федеральный);
		
		ДанныеАдреса = Новый Структура;
		ДанныеАдреса.Вставить("GARguid"				, Данные.Адрес.КодОбъекта);
		ДанныеАдреса.Вставить("region"				, ДанныеРегиона);
		
		ДанныеЗаписи.Вставить("anotherAddress"		, ДанныеАдреса);
		ДанныеЗаписи.Вставить("anotherAddressReason", Данные.ПричинаИногоАдреса);
		
	КонецЕсли;
	
	ДанныеЗаписи.Вставить("equipmentName"			, Данные.Наименование);
	ДанныеЗаписи.Вставить("vendor"					, Данные.Производитель);
	ДанныеЗаписи.Вставить("oksmId"					, Данные.СтранаПроизводства);
	ДанныеЗаписи.Вставить("model"					, Данные.Модель);
	ДанныеЗаписи.Вставить("registrationCertificate"	, Данные.НомерУдостоверения);
	ДанныеЗаписи.Вставить("registrationDate"		, ВывестиДату(Данные.ДатаРегистрации));
	ДанныеЗаписи.Вставить("serialNumber"			, Данные.СерийныйНомер);
	ДанныеЗаписи.Вставить("inventoryNumber"			, Данные.ИнвентарныйНомер);
	ДанныеЗаписи.Вставить("productDate"				, ВывестиДату(Данные.ДатаВыпуска));
	ДанныеЗаписи.Вставить("beginDate"				, ВывестиДату(Данные.ДатаВводаВЭксплуатацию));
	ДанныеЗаписи.Вставить("lifeTime"				, Данные.СрокСлужбы);
	ДанныеЗаписи.Вставить("needReplace"				, Данные.ТребуетсяЗамена);
	ДанныеЗаписи.Вставить("isShared"				, Данные.Общее);
	ДанныеЗаписи.Вставить("count"					, Данные.Количество);
	ДанныеЗаписи.Вставить("endDate"					, ВывестиДату(Данные.ДатаВыводаИзЭксплуатации));
	ДанныеЗаписи.Вставить("endReason"				, Данные.ПричинаВыводаИзЭксплуатации);
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(Запись, ДанныеЗаписи);
	Результат = Запись.Закрыть();
	
	Возврат Результат;
	
КонецФункции

Функция ВывестиДату(Значение)
	Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДФ=yyyy-MM-ddT00:00:00.0000000Z"), Неопределено);
КонецФункции

Функция УдалитьЕдиницуОборудования(Операция, Настройка)
	
	Идентификатор = Неопределено;
	Если Операция.ДанныеФРМО <> Неопределено Тогда
		Идентификатор = Операция.ДанныеФРМО.Идентификатор;
	ИначеЕсли Операция.ДанныеБГУ <> Неопределено И Операция.ДанныеБГУ.Идентификатор <> Неопределено Тогда
		Идентификатор = Операция.ДанныеБГУ.Идентификатор;
	КонецЕсли;
	
	Если Идентификатор = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	АдресРесурса = СтрШаблон("/org/equipment?oid=%1&entityId=%2", Настройка.ИдентификаторОрганизации, Идентификатор);
	
	Ответ = ВыполнитьЗапрос(Настройка, АдресРесурса, "DELETE");
	
	Возврат Ответ;
	
КонецФункции

#КонецЕсли

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Токен

Функция ТокенЗапросаJWTПоГОСТ(ДанныеТокена, МенеджерКриптографии)
	
	ЗаголовокТокена				= ЗаголовокТокена(ДанныеТокена.Сертификат);
	ПолезнаяНагрузкаТокена		= ПолезнаяНагрузкаТокена(ДанныеТокена.ИдентификаторКлиентаИПС, ДанныеТокена.АдресСервиса);
	ПодписываемаяЧастьТокена	= ЗаголовокТокена + "." + ПолезнаяНагрузкаТокена;
	
	МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = ДанныеТокена.Пароль;
	МенеджерКриптографии.ВключениеСертификатовВПодпись = РежимВключенияСертификатовКриптографии.НеВключать;
	СертификатКриптографии = Новый СертификатКриптографии(ДанныеТокена.Сертификат);
	ДанныеНаПодпись = ПолучитьДвоичныеДанныеИзСтроки(ПодписываемаяЧастьТокена, КодировкаТекста.UTF8, Ложь);
	ДвоичныеДанныеПодписи = МенеджерКриптографии.Подписать(ДанныеНаПодпись, СертификатКриптографии);
	ПодписьТокена = Base64Url(ДвоичныеДанныеПодписи);
	
	Возврат ПодписываемаяЧастьТокена + "." + ПодписьТокена;
	
КонецФункции

Функция ЗаголовокТокена(ДанныеСертификата)
	
	ШаблонЗаголовка = "{""x5c"": [""%1""], ""alg"": ""ECGOST3410-2012""}";
	ЗаголовокСтрока = СтрШаблон(ШаблонЗаголовка, Base64Строка(ДанныеСертификата));
	ЗаголовокСтрока = СтрЗаменить(СтрЗаменить(ЗаголовокСтрока, Символы.ПС, ""), Символы.ВК, ""); 
	ЗаголовокДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ЗаголовокСтрока, КодировкаТекста.UTF8, Ложь);
	ЗаголовокUrl = Base64Url(ЗаголовокДвоичныеДанные);
	
	Возврат ЗаголовокUrl;
	
КонецФункции

Функция ПолезнаяНагрузкаТокена(ИдентификаторКлиентаИПС, АдресСервиса)
	
	#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
		ДатаТекущая = ТекущаяУниверсальнаяДата();
	#Иначе
		ДатаТекущая = ОбщегоНазначенияКлиент.ДатаУниверсальная();
	#КонецЕсли
	
	// Поправка на рассинхронизацию времени, во избежании ошибки сервиса
	// "GW-062: Неверный период действия токена"
	ДатаТекущая = ДатаТекущая - 10;
	
	ШаблонТела = "{""sub"": ""%1"", ""aud"": ""%2"", ""exp"": %3, ""iat"": %4}";
	ПолезнаяНагрузкаСтрока = СтрШаблон(ШаблонТела,
		ИдентификаторКлиентаИПС,
		АдресСервиса,
		ДатуВTimestamp(ДатаТекущая + 300),
		ДатуВTimestamp(ДатаТекущая));
	
	ПолезнаяНагрузкаДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ПолезнаяНагрузкаСтрока, КодировкаТекста.UTF8, Ложь);
	ПолезнаяНагрузкаUrl = Base64Url(ПолезнаяНагрузкаДвоичныеДанные);
	
	Возврат ПолезнаяНагрузкаUrl;
	
КонецФункции

Функция ДатуВTimestamp(пДата)
	
	Возврат Формат(Число(пДата - Дата("19700101")),"ЧН=0; ЧГ=0");
	
КонецФункции

Функция Base64Url(Знач ДвоичныеДанные)
	
	СтрокаBase64 = Base64Строка(ДвоичныеДанные);
	
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ПС, "");  
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ВК, "");
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, "=", "");
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, "+", "-");
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, "/", "_");
	
	Возврат СтрокаBase64;
	
КонецФункции

#КонецОбласти

#Если Не ВебКлиент Тогда

#Область Запрос

Функция ВыполнитьЗапрос(Настройка, АдресРесурса, Метод = "GET", ТекстЗапроса = Неопределено)
	
	Таймаут = 60;
	
	Токен = Неопределено;
	Если Настройка.Токен <> Неопределено Тогда
		Токен = Настройка.Токен;
	ИначеЕсли Настройка.ДанныеТокена <> Неопределено Тогда
		Токен = ТокенЗапроса(Настройка.ДанныеТокена, Настройка.ДанныеТокена.МенеджерКриптографии);
	КонецЕсли;
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("accept", "application/json");
	Заголовки.Вставить("Content-Type", "application/json;charset=UTF-8");
	
	Если Токен <> Неопределено Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;
	
	Если Настройка.КлючДоступа <> Неопределено Тогда
		Заголовки.Вставить("X-API-Key", Настройка.КлючДоступа);
	КонецЕсли;
	
	ЗащищенноеСоединение = Неопределено;
	Если Настройка.ЗащищенноеСоединение Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение(
			Неопределено, Новый СертификатыУдостоверяющихЦентровОС);
	КонецЕсли;
	
	#Если Клиент Тогда
		Прокси = Новый ИнтернетПрокси(Истина);
	#Иначе
		Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси(Настройка.Схема);
	#КонецЕсли
	
	HTTPЗапрос = Новый HTTPЗапрос(Настройка.ПутьНаСервере + АдресРесурса, Заголовки);
	Соединение = Новый HTTPСоединение(Настройка.Хост,,
		Настройка.Логин, Настройка.Пароль, Прокси, Таймаут, ЗащищенноеСоединение);
	
	РезультатОтправки = Новый Структура("СообщениеОбОшибке,Содержимое", "", Неопределено);
	ТекстОтвета = "";
	КодСостояния = 0;
	
	Если ТекстЗапроса <> Неопределено Тогда
		HTTPЗапрос.УстановитьТелоИзСтроки(ТекстЗапроса);
	КонецЕсли;
	
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
		КодСостояния = Ответ.КодСостояния;
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
	Исключение
		РезультатОтправки.СообщениеОбОшибке = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат РезультатОтправки;
	КонецПопытки;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
		РезультатОтправки.Содержимое = ДанныеОтвета;
		СообщениеОбОшибке = Неопределено;
		Если КодСостояния < 400 Тогда
			ДанныеОтвета.Свойство("errorUserMessage", СообщениеОбОшибке);
		Иначе
			ДанныеОтвета.Свойство("message", СообщениеОбОшибке);
		КонецЕсли;
		РезультатОтправки.СообщениеОбОшибке = Строка(СообщениеОбОшибке);
	Исключение
		РезультатОтправки.СообщениеОбОшибке = ТекстОтвета;
	КонецПопытки;
	
	Если КодСостояния >= 400 И Не ЗначениеЗаполнено(РезультатОтправки.СообщениеОбОшибке) Тогда
		РезультатОтправки.СообщениеОбОшибке = СтрШаблон(НСтр("ru = 'Ошибка (%1) при выполнении запроса к ресурсу.'"), КодСостояния);
	КонецЕсли;
	
	Возврат РезультатОтправки;
	
КонецФункции

Функция ДанныеНастройкиПодключения(НастройкаПодключения)
	
	Токен = Неопределено;
	НастройкаПодключения.Свойство("Токен", Токен);
	
	Возврат ИнтеграцияФРМОВызовСервера.ДанныеНастройкиПодключения(НастройкаПодключения.Организация, Токен);
	
КонецФункции

