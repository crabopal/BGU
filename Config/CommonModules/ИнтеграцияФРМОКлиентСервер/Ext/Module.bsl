// Чтение данных из ФРМО

Функция ПрочитатьОбъект(Данные, ПолеКод, ПолеНаименование, КодЧислом = Ложь)
	
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура("Код,Наименование", ?(КодЧислом, 0, ""), "");
	
	Результат.Код = Данные[ПолеКод];
	Результат.Наименование = Данные[ПолеНаименование];
	
	Если Не ЗначениеЗаполнено(Результат.Код) Тогда
		Результат.Код = ?(КодЧислом, 0, "");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьДату(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Дата(СтрЗаменить(Сред(Значение,1, 10), "-", ""));
	
КонецФункции

Функция ПрочитатьАдрес(Поля)
	
	Если Поля = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Регион = Новый Структура;
	Регион.Вставить("Код"			, Поля.region.id);
	Регион.Вставить("КодРегиона"	, Поля.region.territoryCode);
	Регион.Вставить("Федеральный"	, Поля.region.isFederalCity);
	
	ЧастиАдреса = Новый Массив;
	ДобавитьСоставнуюЧастьАдреса(ЧастиАдреса, Поля.region.region);
	ДобавитьСоставнуюЧастьАдреса(ЧастиАдреса, Поля.prefixArea, Поля.areaName);
	ДобавитьСоставнуюЧастьАдреса(ЧастиАдреса, Поля.prefixStreet, Поля.streetName);
	ДобавитьСоставнуюЧастьАдреса(ЧастиАдреса, Поля.house);
	
	ПредставлениеАдреса = СтрСоединить(ЧастиАдреса, ", ");
	
	Результат = Новый Структура;
	Результат.Вставить("КодОбъекта"		, Поля.GARguid);
	Результат.Вставить("Регион"			, Регион);
	Результат.Вставить("Представление"	, ПредставлениеАдреса);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСоставнуюЧастьАдреса(Поля, Значение1 = "", Значение2 = "") Экспорт
	
	Части = Новый Массив;
	Если ЗначениеЗаполнено(Значение1) Тогда
		Части.Добавить(Значение1);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Значение2) Тогда
		Части.Добавить(Значение2);
	КонецЕсли;
	
	Значение = СтрСоединить(Части, " ");
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Поля.Добавить(Значение);
	КонецЕсли;
	
КонецПроцедуры

Функция ПрочитатьЗдание(Поля)
	
	Если Поля = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеЗдание = ПрочитатьОбъект(Поля, "buildingId", "buildingName");
	ДанныеЗдание.Вставить("Этажи", Новый Массив);
	
	Для Каждого ДанныеЭтажи Из Поля.floor Цикл
		СтрокаЭтаж = ПрочитатьОбъект(ДанныеЭтажи, "floorId", "floorName");
		СтрокаЭтаж.Вставить("Помещения", Новый Массив);
		Для Каждого ДанныеПомещение Из ДанныеЭтажи.buildingRoom Цикл
			СтрокаПомещение = ПрочитатьОбъект(ДанныеПомещение, "roomId", "roomName");
			СтрокаЭтаж.Помещения.Добавить(СтрокаПомещение);
		КонецЦикла;
		ДанныеЗдание.Этажи.Добавить(СтрокаЭтаж);
	КонецЦикла;
	
	Возврат ДанныеЗдание;
	
КонецФункции

Функция ПрочитатьПодразделение(Поля)
	
	Если Поля = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеПодразделение = ПрочитатьОбъект(Поля, "departId", "departName");
	ДанныеПодразделение.Вставить("Отделения", Новый Массив);
	ДанныеПодразделение.Вставить("Кабинеты", Новый Массив);
	
	Для Каждого ДанныеОтделение Из Поля.subdivision Цикл
		СтрокаОтделение = ПрочитатьОбъект(ДанныеОтделение, "subdivisionId", "subdivisionName");
		ДанныеПодразделение.Отделения.Добавить(СтрокаОтделение);
	КонецЦикла;
	
	Для Каждого ДанныеКабинет Из Поля.room Цикл
		СтрокаКабинет = ПрочитатьОбъект(ДанныеКабинет, "roomId", "roomName");
		ДанныеПодразделение.Кабинеты.Добавить(СтрокаКабинет);
	КонецЦикла;
	
	Возврат ДанныеПодразделение;
	
КонецФункции

