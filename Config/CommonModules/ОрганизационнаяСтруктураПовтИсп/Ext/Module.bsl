// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Возвращает таблицу значений, содержащую сведения об
// ответственных лицах организации
//
Функция ОтветственныеЛицаОрганизации(Организация, НаДату = Неопределено) Экспорт
	
	Возврат Справочники.Организации.ПолучитьОтветственныхЛицОрганизации(Организация, НаДату);	
	
КонецФункции

// Возвращает структуру, содержащую сведения об
// ответственном лице организации
// Входящие параметры: Организация - спраовнчик "Организации"
// ВидОтветственногоЛица - перечисление "ОтветственныеЛицаОрганизаций"
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ВидОтветственногоЛица - ПеречислениеСсылка.ОтветственныеЛицаОрганизаций
//  НаДату - Дата - На дату
// 
// Возвращаемое значение:
//  Структура
Функция ОтветственноеЛицоОрганизации(Организация, ВидОтветственногоЛица, НаДату = Неопределено) Экспорт
	
	ОтветственныеЛица = Справочники.Организации.ПолучитьОтветственныхЛицОрганизации(Организация, НаДату);
	ЛицоНайдено = ОтветственныеЛица.Найти(ВидОтветственногоЛица, "ИсполняемаяФункцияСсылка");
	Если ЛицоНайдено <> Неопределено И ЗначениеЗаполнено(ЛицоНайдено.ОтветственноеЛицоСсылка) Тогда
		// Если нашли сотрудника с нужной функцией
		Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ЛицоНайдено);
	Иначе
		// Не нашли сотрудника с нужной функцией, вернем пустую структуру, что-бы не проверять на клиенте.
		Структура = Новый Структура;
		Для каждого Колонка Из ОтветственныеЛица.Колонки Цикл
			Структура.Вставить(Колонка.Имя);
		КонецЦикла;
		Возврат Структура;
	КонецЕсли;
КонецФункции

// Ответственные лица организации соответствием.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  НаДату - Дата
//  Подразделение - СправочникСсылка.Подразделения - Подразделение
// 
// Возвращаемое значение:
//  Соответствие - Ответственные лица организации соответствием
Функция ОтветственныеЛицаОрганизацииСоответствием(Организация, НаДату, Подразделение = Неопределено) Экспорт

	ОтветственныеЛицаОрганизации = Справочники.Организации.ПолучитьОтветственныхЛицОрганизации(Организация, НаДату, Подразделение);
	
	Результат = Новый Соответствие;
	
	Для Каждого ОтветственноеЛицо Из ОтветственныеЛицаОрганизации Цикл
		
		ТекСтруктура = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ОтветственноеЛицо);
		Результат.Вставить(ОтветственноеЛицо.ИсполняемаяФункцияСсылка,			ТекСтруктура);
		Результат.Вставить(ОтветственноеЛицо.ИсполняемаяФункцияПредставление,	ТекСтруктура);
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции // ОтветственныеЛицаОрганизацииСоответствием()

// Ответственное лицо пустая структура.
// 
// Возвращаемое значение:
//  Структура - Ответственное лицо пустая структура
Функция ОтветственноеЛицоПустаяСтруктура() Экспорт
	ПустаяТаблица = Справочники.Организации.ПолучитьОтветственныхЛицОрганизации(Справочники.Организации.ПустаяСсылка(), ТекущаяДата());			
	Структура = Новый Структура;
	Для каждого Колонка Из ПустаяТаблица.Колонки Цикл
		Структура.Вставить(Колонка.Имя);
	КонецЦикла;
	Возврат Структура;
КонецФункции
 

