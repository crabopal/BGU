// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПолучитьСокращенноеПредставлениеИмениОтчества(ПолноеПредставление)
	
	ТекИмя = "";
		
	ПозицияДефиса = Найти(ПолноеПредставление,"-");
	Если ПозицияДефиса >0 Тогда
		ПерваяЧасть = СокрЛП(Сред(ПолноеПредставление,1,ПозицияДефиса-1));
		ВтораяЧасть = СокрЛП(Сред(ПолноеПредставление,ПозицияДефиса+1));
		ТекИмя = ?(ЗначениеЗаполнено(ПерваяЧасть),Лев(ПерваяЧасть,1)+".","");
		Если ЗначениеЗаполнено(ВтораяЧасть) И Лев(ВтораяЧасть,1) = ВРег(Лев(ВтораяЧасть,1)) Тогда
			ТекИмя = ?(ЗначениеЗаполнено(ТекИмя),ТекИмя + "-","") + ?(ЗначениеЗаполнено(ВтораяЧасть),Лев(ВтораяЧасть,1)+".","");	
		КонецЕсли;
	Иначе
		ТекИмя = ?(ЗначениеЗаполнено(ПолноеПредставление),Лев(ПолноеПредставление,1)+".","");
	КонецЕсли;
	
	Возврат ТекИмя;
	
КонецФункции

