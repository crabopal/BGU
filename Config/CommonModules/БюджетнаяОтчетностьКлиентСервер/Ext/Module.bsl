// Функция - Синоним
//
// Параметры:
//  ИсходнаяСтрока	 - Строка - "ОсновныеСредства" 
// Возвращаемое значение:
//  Строка - "Основные средства"
Функция Синоним(ИсходнаяСтрока) Экспорт
	
	Результат = "";
	Стр = ИсходнаяСтрока;
	
	Слово = НайтиСлово(Стр);
	
	Пока Слово <> "" Цикл
		Если Результат = "" Тогда
			// первое слово - как есть
			Результат = Слово;
		ИначеЕсли ВРЕГ(Слово) = Слово И СтрДлина(Слово)>1 Тогда
			// если 2 и более заглавных - считаем аббревиатурой
			Результат = Результат + " " + Слово;
		Иначе
			// иначе - обычное слово с маленькой буквы
			Результат = Результат + " " + НРЕГ(Слово); 
		КонецЕсли;
		
		Слово = НайтиСлово(Стр);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция НайтиСлово(Парам) 
	
	Возвр = "";
	ПредСимвол = "";    
	ПредВерхнийРегистр = Ложь;
	Смещение = 0;
	
	СтрДлина = СтрДлина(Парам);
	Сч = 1;
	
	Пока Сч<=СтрДлина Цикл
		
		Символ = Сред(Парам,сч,1);
		ВерхнийРегистр = (Символ = ВРег(Символ));
		
		Если Возвр = "" Тогда
			// Первый символ
			Возвр =  Символ;
		ИначеЕсли Символ = "_" Тогда
			// если разделитель то остаток должен быть без разделителя
			Смещение = 1;
			Прервать;
		ИначеЕсли КодСимвола(Символ)<58 Тогда
			// если цифра
			Если КодСимвола(ПредСимвол)<58 Тогда
				// если предыдущий символ тоже цифра - продолжаем слово
				Возвр = Возвр + Символ;
			Иначе
				Прервать;
			КонецЕсли;
		ИначеЕсли ВерхнийРегистр и НЕ ПредВерхнийРегистр или (КодСимвола(Символ)>57 и КодСимвола(ПредСимвол)<58) Тогда
			// если заглавная буква и предыдущая маленькая 
			// или буква после цифры
			Прервать;
		ИначеЕсли НЕ ВерхнийРегистр И ПредВерхнийРегистр И Сч>2 Тогда
			// если встретили маленькую после большой и это не второй символ
			Возвр = Лев(Возвр,Сч-2);
			Прервать;
		Иначе
			Возвр = Возвр + Символ;
		КонецЕсли;
		
		Сч = Сч + 1;
		
		ПредСимвол = Символ;
		ПредВерхнийРегистр = ВерхнийРегистр;
	КонецЦикла;
	
	Парам = Прав(Парам,СтрДлина - СтрДлина(Возвр)-Смещение); 
	Возврат Возвр;
	
КонецФункции

// Функция разбирает строку ФИО на составляющие 
//
// Параметры
//  ФИО		 - Фамилия, имя, отчество одной строкой.
//
// Возвращаемое значение 
//  Структура, Фамилия,Имя,Отчество.
//
Функция РазобратьСтрокуФИОНаСоставляющие(ФИО) Экспорт
	
	Результат = Новый Структура("Фамилия,Имя,Отчество","","","");
	
	Счетчик = 0;
	Для Каждого ЧастьФИО из СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ФИО) Цикл
		Счетчик = Счетчик + 1;
		
		Если Счетчик = 1 Тогда 
			Результат.Фамилия = ЧастьФИО;
			
		ИначеЕсли Счетчик = 2 Тогда
			Результат.Имя = 	ЧастьФИО;
			
		ИначеЕсли Счетчик = 3 Тогда
			Результат.Отчество =ЧастьФИО;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	

КонецФункции // ПолучитьФамилиюИмяОтчество()

// Функция - Собирает из составляющих строку фИО
//
// Параметры:
//  СтруктураФИО - Структура - результат РазобратьСтрокуФИОНаСоставляющие  
//  Способ		 - Строка - Одно из "ПолныйФИО", "СначалаИнициалы", "ИнициалыПотом"
// Возвращаемое значение:
//  Строка - Результат сборки 
функция СобратьСтрокуФИОИзСоставляющих(СтруктураФИО, Способ) Экспорт 
	
	Результат = "";		
	
	Если  Способ = "ПолныйФИО" Тогда 
		Шаблон = "%1 %2 %3";
		
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
		СтруктураФИО.Фамилия,
		СтруктураФИО.Имя,
		СтруктураФИО.Отчество);
		Результат = СокрЛП(Результат);
		
	ИначеЕсли Способ = "СначалаИнициалы" Тогда
		Шаблон = "%1%2 %3";
		
		ТекИмя = ПолучитьСокращенноеПредставлениеИмениОтчества(СтруктураФИО.Имя);				
		ТекОтчество = ПолучитьСокращенноеПредставлениеИмениОтчества(СтруктураФИО.Отчество);		
		
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,ТекИмя,ТекОтчество,СтруктураФИО.Фамилия);		
		Результат = СокрЛП(Результат);
		
	ИначеЕсли Способ = "ИнициалыПотом" Тогда
		Шаблон = "%1 %2%3";
		
		ТекИмя = ПолучитьСокращенноеПредставлениеИмениОтчества(СтруктураФИО.Имя);
		ТекОтчество = ПолучитьСокращенноеПредставлениеИмениОтчества(СтруктураФИО.Отчество);
		
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, СтруктураФИО.Фамилия, ТекИмя, ТекОтчество);
		Результат = СокрЛП(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

// Функция формирует фамилию и инициалы имени и отчества.
//
// Параметры:
// 	ФИО 			- Фамилия Имя Отчество одной строкой.
//	СначалаИнициалы - Признак размещения инициалов перед фамилией.
//
// Возвращаемое значение 
//  Строка. <Фамилия, Инициалы>, либо <Инициалы, Фамилия>.
//
Функция ПолучитьФамилиюИмяОтчество(ФИО, СначалаИнициалы = Истина) Экспорт
	
	СтруктураФИО = РазобратьСтрокуФИОНаСоставляющие(ФИО);
	
	Если СначалаИнициалы Тогда
		
		Возврат СобратьСтрокуФИОИзСоставляющих(СтруктураФИО, "СначалаИнициалы");
		
	Иначе
		
		Возврат СобратьСтрокуФИОИзСоставляющих(СтруктураФИО, "ИнициалыПотом");	
		
	КонецЕсли;

КонецФункции // ПолучитьФамилиюИмяОтчество()

// Функция - Строка соответствует требованиям к именам переменных
//
// Параметры:
//  СтрокаДляПроверки	 - Строка - Строка которую нужно проверить
// Возвращаемое значение:
//  Структура - 
//		Структура.Результат - Булево - строка соответствует требованиям
//		Структура.Причина - Строка - причина не соответствия
Функция СтрокаСоответствуетТребованиямКИменамПеременных(СтрокаДляПроверки) Экспорт 
	
	Результат = Новый Структура;
	Результат.Вставить("Результат",Ложь);
	Результат.Вставить("Причина","");
	
	
	Если ПустаяСтрока(СтрокаДляПроверки) Тогда 
		Результат.Причина = НСтр("ru = 'Проверяемая строка пуста.'");
		Возврат Результат;
	КонецЕсли;
	
	ДоступныеСимволы = "_АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890";
	
	Ошибка = Ложь;
	НедопустимыеСимволы = Новый Массив;
	
	Для Н = 1 По СтрДлина(СтрокаДляПроверки) Цикл 
		
		Символ =Сред(СтрокаДляПроверки, Н, 1);
		Если Найти(ДоступныеСимволы, ВРег(Символ)) <> 0 Тогда 
			Продолжить;
		КонецЕсли;
		Ошибка = Истина;
		
		НедопустимыеСимволы.Добавить(""""+Символ+"""");
		
	КонецЦикла;
	
	Если Ошибка Тогда 
		
		Шаблон = НСтр("ru = 'Проверяемая строка содержит недопустимые символы:%1.'");
		Результат.Причина = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
		СтрСоединить(НедопустимыеСимволы, ","));
		Возврат Результат;
		
	КонецЕсли;
	
	
	ДоступныеПервыеСимволы = "_АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
	Символ =Сред(СтрокаДляПроверки, 1, 1);
	Если Найти(ДоступныеПервыеСимволы, ВРег(Символ)) = 0 Тогда 
		
		Шаблон = НСтр("ru = 'Проверяемая строка начинается с недопустимого символа:""%1"".'");
		Результат.Причина = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
		Символ);
		
		Возврат Результат;
		
	КонецЕсли;	
	
	ЗарезервированныеКлючевыеСлова = "ЕСЛИ,IF,ТОГДА,THEN,ИНАЧЕЕСЛИ,ELSIF,ИНАЧЕ,ELSE,КОНЕЦЕСЛИ,ENDIF,ДЛЯ,FOR,КАЖДОГО,EACH,ИЗ,IN,ПО,TO,ПОКА,WHILE,ЦИКЛ,DO,КОНЕЦЦИКЛА,ENDDO,ПРОЦЕДУРА,PROCEDURE,ФУНКЦИЯ,FUNCTION,КОНЕЦПРОЦЕДУРЫ,ENDPROCEDURE,КОНЕЦФУНКЦИИ,ENDFUNCTION,ПЕРЕМ,VAR,ПЕРЕЙТИ,GOTO,ВОЗВРАТ,RETURN,ПРОДОЛЖИТЬ,CONTINUE,ПРЕРВАТЬ,BREAK,И,AND,ИЛИ,OR,НЕ,NOT,ПОПЫТКА,TRY,ИСКЛЮЧЕНИЕ,EXCEPT,ВЫЗВАТЬИСКЛЮЧЕНИЕ,RAISE,КОНЕЦПОПЫТКИ,ENDTRY,НОВЫЙ,NEW,ВЫПОЛНИТЬ,EXECUTE";
	МассивКлючевыхСлов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ЗарезервированныеКлючевыеСлова);
	Если МассивКлючевыхСлов.Найти(ВРег(СтрокаДляПроверки)) <> Неопределено Тогда 
		
		Результат.Причина = НСтр("ru = 'Проверяемая строка содержит зарезервированное слово.'");
		Возврат Результат;
		
	КонецЕсли;	
	
	
	Результат.Результат = Истина;
	Возврат Результат;
	
КонецФункции	

// Функция - Текущая конфигурация
// Возвращаемое значение:
// Строка - название конфигурации в которую встроена ОГУ
Функция ТекущаяКонфигурация() Экспорт
	
	Возврат БюджетнаяОтчетностьКлиентСерверПереопределяемый.ТекущаяКонфигурация();
	
КонецФункции

// Функция - Это бухгалтерия бюджетного учреждения
// Возвращаемое значение:
// Булево - 
Функция ЭтоБухгалтерияБюджетногоУчреждения() Экспорт
	
	ТекущаяКонфигурация = ТекущаяКонфигурация();
	
	Возврат ТекущаяКонфигурация = "БГУ1" или ТекущаяКонфигурация = "БГУ2";
	
КонецФункции // ЭтоБухгалтерияБюджетногоУчреждения()

// Функция - Редакция БГУ
// Возвращаемое значение:
// строка - "1" или "2" или вызовет исключение если вызов произойдет в конфигурации отличной от БГУ
Функция РедакцияБГУ() Экспорт 
	Если не ЭтоБухгалтерияБюджетногоУчреждения() Тогда 
		
		ВызватьИсключение НСтр("ru = 'Это не БГУ.'");
		
	Иначе
		
		ТекущаяКонфигурация = ТекущаяКонфигурация();
		Если ТекущаяКонфигурация = "БГУ1" Тогда 
			Возврат "1";
		ИначеЕсли ТекущаяКонфигурация = "БГУ2" Тогда
			Возврат "2";
		Иначе 
			ВызватьИсключение НСтр("ru = 'Неизвестная редакция БГУ.'");
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецФункции	

// Функция - Конфигурация является подчиненной
// Возвращаемое значение:
// Булево - флаг того что данная конфигурация является подчиненной и не может использоваться для создания комплектов отчетности
Функция КонфигурацияЯвляетсяПодчиненной()Экспорт 
	
	Возврат БюджетнаяОтчетностьКлиентСерверПереопределяемый.КонфигурацияЯвляетсяПодчиненной();
	
КонецФункции	

// Процедура - Переключить страницу и скрыть остальные
//
// Параметры:
//  Элементы	- Коллекция элементов формы  - 
//  Группа		- Строка - 
//  Страница	- Строка - 
Процедура ПереключитьСтраницуИСкрытьОстальные(Элементы, Группа, Страница)Экспорт 
	
	ЭлементГруппы = Элементы.Найти(Группа);
	Если ЭлементГруппы = Неопределено Тогда 
		Шаблон = НСтр(
		"ru = 'Группа ""%1"" не найдена.'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Группа);
		ВызватьИсключение Сообщение;
	КонецЕсли;
	
	Если ТипЗнч(ЭлементГруппы) <> Тип("ГруппаФормы") Тогда 
		Шаблон = НСтр(
		"ru = 'Элемент ""%1"" не группа.'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Группа);
		ВызватьИсключение Сообщение;
	КонецЕсли;
	
	Если ЭлементГруппы.Вид <> ВидГруппыФормы.Страницы Тогда 
		Шаблон = НСтр(
		"ru = 'Элемент ""%1"" не группа страниц.'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Группа);
		ВызватьИсключение Сообщение;
	КонецЕсли;
	
	СоставГруппы = ЭлементГруппы.ПодчиненныеЭлементы;
	
	НужнаяСтраница = СоставГруппы.Найти(Страница);
	Если НужнаяСтраница = Неопределено Тогда 
		Шаблон = НСтр(
		"ru = 'ru = 'В группе ""%1"" не найдена страница ""%2"".''");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Группа, Страница);
		ВызватьИсключение Сообщение;
	КонецЕсли;
	
	Для Каждого СтраницаГруппы из СоставГруппы Цикл 
		
		Если СтраницаГруппы = НужнаяСтраница Тогда 
			
			СтраницаГруппы.Видимость = Истина;
			ЭлементГруппы.ТекущаяСтраница = СтраницаГруппы;
			
		Иначе 
			СтраницаГруппы.Видимость = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры	

// Функция - ПолучитьИмяФормыВыбораБК
//
// Параметры
//  ТипЗначенияАналитики - Перечисление или Строка - Значение перечисления "ВидыКлассификаторовОтчетов" или Имя значения перечисления
//
// Возвращаемое значение:
// Строка - имя формы выбора бюджетной классификации
Функция ПолучитьИмяФормыВыбораБК(ТипЗначенияАналитики)Экспорт
	
	Если ТипЗнч(ТипЗначенияАналитики) = Тип("Строка") Тогда
		Если ТипЗначенияАналитики = "КОСГУ_ВидыРасходовКРБ" Тогда
			Результат = "Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаВыбораРеквизитовКОСГУ_КРБ";
		Иначе
			Результат = "Справочник." + ТипЗначенияАналитики + ".ФормаВыбора";
		КонецЕсли;
	Иначе
		Если ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.АналитическиеКодыКПС") Тогда
			Результат = "Справочник.АналитическиеКодыКПС.ФормаВыбора";
		ИначеЕсли ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ВидыДоходовКДБ") Тогда
			Результат = "Справочник.ВидыДоходовКДБ.ФормаВыбора";
		ИначеЕсли ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ВидыКИФ") Тогда
			Результат = "Справочник.ВидыКИФ.ФормаВыбора";
		ИначеЕсли ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ВидыРасходовКРБ") Тогда
			Результат = "Справочник.ВидыРасходовКРБ.ФормаВыбора";
		ИначеЕсли ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ГлавыПоБюджетнойКлассификации") Тогда
			Результат = "Справочник.ГлавыПоБюджетнойКлассификации.ФормаВыбора";
		ИначеЕсли ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ГруппыПодвидовКДБ") Тогда
			Результат = "Справочник.ГруппыПодвидовКДБ.ФормаВыбора";
		ИначеЕсли ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ГруппыПодгруппыКИФ") Тогда
			Результат = "Справочник.ГруппыПодгруппыКИФ.ФормаВыбора";
		ИначеЕсли ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.КОСГУ") Тогда
			Результат = "Справочник.КОСГУ.ФормаВыбора";
		ИначеЕсли ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.КОСГУ_ВидыРасходовКРБ") Тогда
			Результат = "Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаВыбораРеквизитовКОСГУ_КРБ";
		ИначеЕсли ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ПрограммыЦелевыхСтатейКРБ") Тогда
			Результат = "Справочник.ПрограммыЦелевыхСтатейКРБ.ФормаВыбора";
		ИначеЕсли ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.РазделыПодразделыКРБ") Тогда
			Результат = "Справочник.РазделыПодразделыКРБ.ФормаВыбора";
		ИначеЕсли ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.СтатьиКИФ") Тогда
			Результат = "Справочник.СтатьиКИФ.ФормаВыбора";
		ИначеЕсли ТипЗначенияАналитики = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ЦелевыеСтатьиКРБ") Тогда
			Результат = "Справочник.ЦелевыеСтатьиКРБ.ФормаВыбора";
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

