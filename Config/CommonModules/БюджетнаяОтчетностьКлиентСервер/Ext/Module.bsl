// Функция - Прочитать значение из XML
//
// Параметры:
//  СтрокаXML	 - Строка	 - 
//  ТипДанныхXML - ТипДанныхXML - 
// Возвращаемое значение:
//  Произвольное - 
функция ПрочитатьЗначениеИзXML(СтрокаXML,ТипДанных = Неопределено) Экспорт 
	
	Если ПустаяСтрока(СтрокаXML) Тогда 
		Возврат Неопределено;
	КонецЕсли;	
	
	#Если ВебКлиент Тогда 
						
		Возврат БюджетнаяОтчетность.ПрочитатьЗначениеИзXML(СтрокаXML,ТипДанных);
		
	#Иначе
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
		Возврат СериализаторXDTO.ПрочитатьXML(ЧтениеXML, ТипДанных);
	#КонецЕсли
	
КонецФункции

// Функция - Записать значение в XML
//
// Параметры:
//  Значение - Произвольное - 
// Возвращаемое значение:
//  Строка - 
функция ЗаписатьЗначениеВXML(Значение) Экспорт
	
	Если Значение = Неопределено Тогда 
		Возврат "";
	КонецЕсли;	
	
	#Если ВебКлиент Тогда 
				
		Возврат БюджетнаяОтчетность.ЗаписатьЗначениеВXML(Значение);
		
	#Иначе
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		ОбъектXDTO = СериализаторXDTO.ЗаписатьXDTO(Значение);
		СериализаторXDTO.Фабрика.ЗаписатьXML(ЗаписьXML, ОбъектXDTO,,,,НазначениеТипаXML.Явное);
		Возврат ЗаписьXML.Закрыть();
		
	#КонецЕсли
	
КонецФункции

