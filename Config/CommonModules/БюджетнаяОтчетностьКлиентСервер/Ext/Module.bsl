// Разбор имени ячейки на исходное имя и идентификатор.
//
// Параметры:
//  ИмяОбласти	 - 	 - 
// Возвращаемое значение:
//  Структура - 
Функция РазобратьИмяОбласти(ИмяОбласти) Экспорт

	ПозицияРазделителя = СтрНайти(ИмяОбласти,"_",НаправлениеПоиска.СКонца);
	
	Если ПозицияРазделителя <> 0 
		И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Сред(ИмяОбласти,ПозицияРазделителя+1)) Тогда
		ИмяИсходнойОбласти = Лев(ИмяОбласти,ПозицияРазделителя-1);
		Идентификатор	   = Число(Сред(ИмяОбласти,ПозицияРазделителя+1));
	Иначе
		ИмяИсходнойОбласти = ИмяОбласти;
		Идентификатор	   = Неопределено;
	КонецЕсли;
 
	Возврат Новый Структура("ИмяИсходнойОбласти,Идентификатор",ИмяИсходнойОбласти,Идентификатор);
	
КонецФункции // РазобратьИмяОбласти()
  
// Функция заменяет все не алфавитно-цифровые символы на знак подчеркивания.
//
// Параметры:
//  Код							 - Строка - Значение кода, которое необходимо преобразовать.
//  РазрешитьЦифрыВНачале		 - Булево - - 
//  РазрешитьСлужебныеСимволы	 - Булево - -
// Возвращаемое значение:
//  Строка - Преобразованное значение кода.
//    
Функция ВернутьАлфавитноЦифровоеПредставление(Код, РазрешитьЦифрыВНачале = Ложь, РазрешитьСлужебныеСимволы = Ложь) Экспорт
	
	Если ТипЗнч(Код) <> Тип("Строка") Тогда
		Возврат Код;
	КонецЕсли;
	
	РусАлфавит       = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";
	ЛатАлфавит       = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	Цифры            = "1234567890";
	СлужебныеСимволы = "\+.";
	
	ТекСтрока  = "";
	
	
	Инд = 1;
	ОбработкаНачала = Истина;
	Пока  Инд <= СтрДлина(Код) Цикл
		
		ТекСимвол = (Сред(Код, Инд, 1));
		
		Если  ОбработкаНачала Тогда
			Если СтрЧислоВхождений(РусАлфавит + ЛатАлфавит + ?(РазрешитьЦифрыВНачале, Цифры, "") + ?(РазрешитьСлужебныеСимволы, СлужебныеСимволы, ""), ВРЕГ(ТекСимвол)) <> 0 Тогда
				ОбработкаНачала = Ложь;
				ТекСтрока = ТекСтрока + ТекСимвол;
			КонецЕсли;
			
		Иначе
			
			Если СтрЧислоВхождений(РусАлфавит + ЛатАлфавит + Цифры + ?(РазрешитьСлужебныеСимволы, СлужебныеСимволы, "") + "_", ВРЕГ(ТекСимвол)) = 0 Тогда
				ТекСтрока = ТекСтрока + "_";
			ИначеЕсли ТекСимвол = "/" И РазрешитьСлужебныеСимволы Тогда
				ТекСтрока = ТекСтрока + "\";
			Иначе
				ТекСтрока = ТекСтрока + ТекСимвол;
			КонецЕсли;
			
		КонецЕсли;
		
		Инд = Инд + 1;
		
	КонецЦикла;
	
	Возврат ТекСтрока;
	
КонецФункции

// Устанавливает новое значение переменной, только если оно отличается от текущего
//
// Параметры:
//  Параметр - Произвольное - Куда ставить
//  Значение - Произвольное - Что ставить
Процедура УстановитьНовоеЗначение(Параметр, Значение, УстановленоЗначение=Ложь) Экспорт

	Если Параметр <> Значение Тогда
		Параметр = Значение;
		УстановленоЗначение = Истина
	КонецЕсли;

КонецПроцедуры

