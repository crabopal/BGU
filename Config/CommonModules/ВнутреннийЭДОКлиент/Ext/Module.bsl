Процедура НастроитьПредставлениеДанных(КлиентскиеПараметры, СерверныеПараметры)
	
	ОписаниеДанных = КлиентскиеПараметры.ОписаниеДанных;
	
	Если ОписаниеДанных.Свойство("СписокПредставлений") Тогда
		СписокПредставлений = ОписаниеДанных.СписокПредставлений;
	Иначе
		СписокПредставлений = Новый Массив;
		
		Если ОписаниеДанных.Свойство("Данные")
		 Или ОписаниеДанных.Свойство("Объект") Тогда
			
			ЗаполнитьСписокПредставлений(СписокПредставлений, ОписаниеДанных);
		Иначе
			Для каждого ЭлементДанных Из ОписаниеДанных.НаборДанных Цикл
				ЗаполнитьСписокПредставлений(СписокПредставлений, ЭлементДанных);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ТекущийСписокПредставлений = Новый СписокЗначений;
	
	Для каждого ЭлементСписка Из СписокПредставлений Цикл
		Если ТипЗнч(ЭлементСписка) = Тип("Строка") Тогда
			Представление = ЭлементСписка.Представление;
			Значение = Неопределено;
		ИначеЕсли ТипЗнч(ЭлементСписка) = Тип("Структура") Тогда
			Представление = ЭлементСписка.Представление;
			Значение = ЭлементСписка.Значение;
		Иначе // Ссылка
			Представление = "";
			Значение = ЭлементСписка.Значение;
		КонецЕсли;
		Если ЗначениеЗаполнено(ЭлементСписка.Представление) Тогда
			Представление = ЭлементСписка.Представление;
		Иначе
			Представление = Строка(ЭлементСписка.Значение);
		КонецЕсли;
		ТекущийСписокПредставлений.Добавить(Значение, Представление);
	КонецЦикла;
	
	Если ТекущийСписокПредставлений.Количество() > 1 Тогда
		СерверныеПараметры.Вставить("ПредставлениеДанныхОткрывается", Истина);
		СерверныеПараметры.Вставить("ПредставлениеДанных", СтрЗаменить(
			ОписаниеДанных.ПредставлениеНабора, "%1", ОписаниеДанных.НаборДанных.Количество()));
	Иначе
		СерверныеПараметры.Вставить("ПредставлениеДанныхОткрывается",
			ТипЗнч(ТекущийСписокПредставлений[0].Значение) = Тип("ОписаниеОповещения")
			Или ЗначениеЗаполнено(ТекущийСписокПредставлений[0].Значение));
		
		СерверныеПараметры.Вставить("ПредставлениеДанных",
			ТекущийСписокПредставлений[0].Представление);
	КонецЕсли;
	
	КлиентскиеПараметры.Вставить("ТекущийСписокПредставлений", ТекущийСписокПредставлений);
	
КонецПроцедуры

Процедура ПроверитьСведенияОДолжностиПодписантаПЭП(Знач ОписаниеДанных, Отказ, ОписаниеОшибки) 

	Если НЕ ВнутреннийЭДОВызовСервера.ПолучитьКонстантуПроверятьСведенияОДолжностиПодписантаПЭП() Тогда
		Возврат;
	КонецЕсли;	
	
	НаборДанных = ОписаниеДанных.НаборДанных;
	СведенияПодписи = ОписаниеДанных.СведенияДляПростойПодписи;
	
	МассивДолжностей = СведенияПодписи.ОрганизацииИДолжности[НаборДанных[0].ЭлектронныйДокумент]; 			
	Если НЕ ЗначениеЗаполнено(СведенияПодписи.ПолноеИмя) Тогда
		
		ОписаниеОшибки = СтрШаблон(НСтр("ru='Электронный документ не может быть подписан: для пользователя подписанта ""%1"" не определено физическое лицо.
		|Необходимо указать физическое лицо в справочнике ""Пользователи"" и повторить операцию.'"), ПользователиКлиентСервер.ТекущийПользователь());
		
		Отказ = Истина;
		
	ИначеЕсли МассивДолжностей.Количество() = 0 Тогда
		
		ОписаниеОшибки = СтрШаблон(НСтр("ru='Электронный документ не может быть подписан: для сотрудника подписанта ""%1"" не определена должность.
		|Необходимо указать должность в справочнике ""Сотрудники"" и повторить операцию.'"), СведенияПодписи.ПолноеИмя);
		
		Отказ = Истина;   
		
	КонецЕсли; 
			
КонецПроцедуры

// Для процедуры НастроитьПредставлениеДанных.
Процедура ЗаполнитьСписокПредставлений(СписокПредставлений, ЭлементДанных)
	
	ЭлементСписка = Новый Структура("Значение, Представление", Неопределено, "");
	СписокПредставлений.Добавить(ЭлементСписка);
	
	Если ЭлементДанных.Свойство("Представление")
	   И ТипЗнч(ЭлементДанных.Представление) = Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(ЭлементСписка, ЭлементДанных.Представление);
		Возврат;
	КонецЕсли;
	
	Если ЭлементДанных.Свойство("Представление")
	   И ТипЗнч(ЭлементДанных.Представление) <> Тип("Строка") Тогда
	
		ЭлементСписка.Значение = ЭлементДанных.Представление;
		
	ИначеЕсли ЭлементДанных.Свойство("Объект")
	        И ТипЗнч(ЭлементДанных.Объект) <> Тип("ОписаниеОповещения") Тогда
		
		ЭлементСписка.Значение = ЭлементДанных.Объект;
	КонецЕсли;
	
	Если ЭлементДанных.Свойство("Представление") Тогда
		ЭлементСписка.Представление = ЭлементДанных.Представление;
	КонецЕсли;
	
КонецПроцедуры

Процедура СостояниеЭДОНажатие(Форма)
	
	СсылкаНаУчетныйДокумент = Форма.Объект.Ссылка;
	
	ПросмотретьЭлектронныйДокумент(Форма, СсылкаНаУчетныйДокумент);
	
КонецПроцедуры

Процедура ВыполнитьКомандуПросмотретьЭлектронныйДокумент(Форма, Источник)
	
	Если ТипЗнч(Источник) = Тип("ДанныеФормыСтруктура") Тогда
		Ссылка = Источник.Ссылка;
	ИначеЕсли ТипЗнч(Источник) = Тип("ТаблицаФормы") Тогда
		ТипыДокументовВнутреннегоЭДО = ВнутреннийЭДОКлиентПовтИсп.ТипыУчетныхДокументовВнутреннегоЭДО();
		Если ТипыДокументовВнутреннегоЭДО.СодержитТип(ТипЗнч(Источник.ТекущаяСтрока)) Тогда
			Ссылка = Источник.ТекущаяСтрока;
		ИначеЕсли Источник.ТекущиеДанные <> Неопределено Тогда
			Ссылка = Источник.ТекущиеДанные.Ссылка;
		КонецЕсли;
	Иначе
		Ссылка = Источник;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДанныеФормыСтруктура")
		И (Ссылка.Пустая() Или Форма.Модифицированность) Тогда
		
		ТекстВопроса = 
			НСтр("ru = 'Данные еще не записаны.
				|Выполнение действия возможно только после записи данных.
				|Данные будут записаны.'");
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма", Форма);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьКомандуПросмотретьЭлектронныйДокументПослеЗаписи",
			ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	ПросмотретьЭлектронныйДокумент(Форма, Ссылка);
	
КонецПроцедуры

Процедура ВыполнитьКомандуСоздатьЭлектронныеДокументы(Форма, Источник)
	
	УчетныеДокументы = Новый Массив;
	
	Если ТипЗнч(Источник) = Тип("ДанныеФормыСтруктура") Тогда
		УчетныеДокументы.Добавить(Источник.Ссылка);
	ИначеЕсли ТипЗнч(Источник) = Тип("ТаблицаФормы") Тогда
		Если Источник.ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Для Каждого Ссылка Из Источник.ВыделенныеСтроки Цикл
			Если ТипЗнч(Ссылка) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
				Продолжить;
			КонецЕсли;
			УчетныеДокументы.Добавить(Ссылка);
		КонецЦикла;
	Иначе
		УчетныеДокументы.Добавить(Источник.Ссылка);
	КонецЕсли;
	
	СоздатьЭлектронныеДокументы(Форма, УчетныеДокументы);
	
КонецПроцедуры

Процедура ВыполнитьКомандуАннулироватьЭлектронныеДокументы(Форма, Источник)
	
	УчетныеДокументы = Новый Массив;
	
	Если ТипЗнч(Источник) = Тип("ДанныеФормыСтруктура") Тогда
		УчетныеДокументы.Добавить(Источник.Ссылка);
	ИначеЕсли ТипЗнч(Источник) = Тип("ТаблицаФормы") Тогда
		Если Источник.ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Для Каждого Ссылка Из Источник.ВыделенныеСтроки Цикл
			Если ТипЗнч(Ссылка) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
				Продолжить;
			КонецЕсли;
			УчетныеДокументы.Добавить(Ссылка);
		КонецЦикла;
	Иначе
		УчетныеДокументы.Добавить(Источник.Ссылка);
	КонецЕсли;
	
	АннулироватьЭлектронныеДокументы(Форма, УчетныеДокументы);
	
КонецПроцедуры

Процедура ПросмотретьЭлектронныйДокумент(Форма, Ссылка)
	
	ПараметрыПросмотра = ВнутреннийЭДОВызовСервера.ПараметрыПросмотраЭлектронногоДокумента(Ссылка);
	
	Если ПараметрыПросмотра.ДокументОбрабатываетсяВнутреннимЭДОБЭД Тогда
		ВнутреннийЭДОКлиентПереопределяемый.ОткрытьЭлектронныйДокументОбъектаУчетаБЭД(Ссылка);
	ИначеЕсли НЕ ПараметрыПросмотра.ЕстьПравоЧтенияВнутреннихЭлектронныхДокументов Тогда
		ТекстСообщения = НСтр("ru = 'Недостаточно прав для просмотра внутренних электронных документов'");
		ПоказатьПредупреждение(, ТекстСообщения, 60);
	ИначеЕсли НЕ ПараметрыПросмотра.ДокументПодходитДляВнутреннегоЭДОБГУ Тогда
		ТекстСообщения = НСтр("ru = 'Тип документа не обрабатывается внутренним ЭДО'");
		ПоказатьПредупреждение(, ТекстСообщения, 60);
	ИначеЕсли ЗначениеЗаполнено(ПараметрыПросмотра.ПараметрыЕдинственногоДокумента) Тогда
		Если ЗначениеЗаполнено(ПараметрыПросмотра.ПараметрыЕдинственногоДокумента.ОписаниеОшибки) Тогда
			ПоказатьПредупреждение(, ПараметрыПросмотра.ПараметрыЕдинственногоДокумента.ОписаниеОшибки, 60);
		Иначе
			ОткрытьФормуЭлектронногоДокумента(ПараметрыПросмотра.ПараметрыЕдинственногоДокумента);
		КонецЕсли;
	Иначе
		ОткрытьФормуСостоянияЭлектронныхДокументов(Ссылка, Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьЭлектронныеДокументы(Форма, УчетныеДокументы)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УчетныеДокументы", УчетныеДокументы);
	
	ОткрытьФорму("ОбщаяФорма.СозданиеЭлектронныхДокументов", ПараметрыФормы, Форма);
	
КонецПроцедуры

Процедура АннулироватьЭлектронныеДокументы(Форма, УчетныеДокументы)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УчетныеДокументы", УчетныеДокументы);
	
	ОткрытьФорму("ОбщаяФорма.АннулированиеЭлектронныхДокументов", ПараметрыФормы, Форма);
	
КонецПроцедуры

Процедура ОткрытьЭлектронныйДокументПоОписанию(Описание)
	
	ОткрытьФорму("Документ.ВнутреннийЭлектронныйДокумент.Форма.ФормаДокумента", Описание);
	
КонецПроцедуры

Процедура ПриОбновленииСостоянияВнутреннегоЭД(Форма)
	
	Параметры = ПараметрыРасчетаСостоянияЭДОФормы(Форма);
	
	ДанныеВнутреннегоЭДО = ВнутреннийЭДОВызовСервера.ДанныеВнутреннегоЭДО(Параметры);
	
	Гиперссылка = Форма.Элементы.Найти(ВнутреннийЭДОКлиентСервер.ИмяДекорацииСостояниеЭДО());
	Если Гиперссылка <> Неопределено Тогда
		Гиперссылка.Заголовок = ДанныеВнутреннегоЭДО.Состояние;
	КонецЕсли;
	
	Если ДанныеВнутреннегоЭДО.ТолькоПросмотр Тогда
		Форма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыРасчетаСостоянияЭДОФормы(Форма)
	
	СтандартнаяОбработка = Истина;
	Организация = Неопределено;
	ВнутреннийЭДОКлиентПереопределяемый.ПриПолученииОрганизацииПоОбъекту(Форма, Форма.Объект, Организация, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		Организация = Форма.Объект.Организация;
	КонецЕсли;
	
	Параметры = Новый Структура;
	Параметры.Вставить("Организация", Организация);
	Параметры.Вставить("Ссылка", Форма.Объект.Ссылка);
	
	Возврат Параметры;
	
КонецФункции

Процедура ВыполнитьКомандуОткрытьНастройкиВнутреннегоЭДО(Форма, Источник)
	
	Если ТипЗнч(Источник) = Тип("ДанныеФормыСтруктура") Тогда
		Ссылка = Источник.Ссылка;
	ИначеЕсли ТипЗнч(Источник) = Тип("ТаблицаФормы") Тогда
		Ссылка = Источник.ТекущиеДанные.Ссылка;
	Иначе
		Ссылка = Источник;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Ссылка);
	
	ОткрытьФорму("РегистрСведений.НастройкиВнутреннегоЭДОБГУ.Форма.НастройкаВнутреннегоЭДО",
		ПараметрыФормы, Форма, Ссылка);
	
КонецПроцедуры

#КонецОбласти