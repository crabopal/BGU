#Область СлужебныйПрограммныйИнтерфейс

Процедура ДекорацияНажатие(Форма, Элемент, СтандартнаяОбработка) Экспорт
	
	Если Элемент.Имя = ВнутреннийЭДОКлиентСервер.ИмяДекорацииСостояниеЭДО() Тогда
		СтандартнаяОбработка = Ложь;
		СостояниеЭДОНажатие(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьПодключаемуюКоманду(Команда, Форма, Источник) Экспорт
	
	Если Лев(Команда.Имя, 44) = "ВнутреннийЭДО_ПросмотретьЭлектронныйДокумент" Тогда
		ВыполнитьКомандуПросмотретьЭлектронныйДокумент(Форма, Источник);
	ИначеЕсли Лев(Команда.Имя, 41) = "ВнутреннийЭДО_СоздатьЭлектронныеДокументы" Тогда
		ВыполнитьКомандуСоздатьЭлектронныеДокументы(Форма, Источник);
	ИначеЕсли Лев(Команда.Имя, 46) = "ВнутреннийЭДО_АннулироватьЭлектронныеДокументы" Тогда
		ВыполнитьКомандуАннулироватьЭлектронныеДокументы(Форма, Источник);
	ИначеЕсли Лев(Команда.Имя, 50) = "ВнутреннийЭДО_ОткрытьЭлектронныеДокументыНаПодпись" Тогда
		ВыполнитьКомандуОткрытьЭлектронныеДокументыНаПодпись();
	ИначеЕсли Лев(Команда.Имя, 44) = "ВнутреннийЭДО_ОткрытьНастройкиВнутреннегоЭДО" Тогда
		ВыполнитьКомандуОткрытьНастройкиВнутреннегоЭДО(Форма, Источник);
	КонецЕсли;
	
КонецПроцедуры

Процедура СписокВыбор(Форма, Поле, ВыбраннаяСтрока, СтандартнаяОбработка) Экспорт
	
	Если Прав(Поле.Имя, 15) = "СостояниеЭДОБГУ" Тогда
		СтандартнаяОбработка = Ложь;
		ВыполнитьКомандуПросмотретьЭлектронныйДокумент(Форма, ВыбраннаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаОповещения(Форма, ИмяСобытия, Параметр, Источник) Экспорт
	
	Если ИмяСобытия = ИмяСобытияОбновленияСостоянияВнутреннегоЭД() Тогда
		
		ПриОбновленииСостоянияВнутреннегоЭД(Форма)
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьФормуЭлектронногоДокумента(Параметры) Экспорт
	
	Если ЗначениеЗаполнено(Параметры.ЭлектронныйДокумент) Тогда 
		ОткрытьЭлектронныйДокумент(Параметры.ЭлектронныйДокумент);
	ИначеЕсли ЗначениеЗаполнено(Параметры.УчетныйДокумент) Тогда
		ОткрытьЭлектронныйДокументПоОписанию(Параметры);
	КонецЕсли;
	
КонецПроцедуры

Функция ИмяСобытияОбновленияСостоянияВнутреннегоЭД() Экспорт
	Возврат "ОбновитьСостояниеВнутреннегоЭД";
КонецФункции

Процедура ОткрытьЭлектронныйДокумент(ЭлектронныйДокумент) Экспорт
	
	Описание = Новый Структура;
	Описание.Вставить("Ключ", ЭлектронныйДокумент);
	
	ОткрытьФорму("Документ.ВнутреннийЭлектронныйДокумент.Форма.ФормаДокумента", Описание);
	
КонецПроцедуры

Процедура ОткрытьФормуСостоянияЭлектронныхДокументов(Ссылка, Параметры) Экспорт
	
	Если ТипЗнч(Параметры) = Тип("ФормаКлиентскогоПриложения") Тогда
		Владелец = Параметры;
	Иначе
		Владелец = Параметры.Форма;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УчетныйДокумент", Ссылка);
	
	ОткрытьФорму("РегистрСведений.СостоянияЭлектронныхДокументов.Форма.ЭлектронныеДокументы", ПараметрыФормы, Владелец);
	
КонецПроцедуры

Процедура ВыполнитьКомандуПросмотретьЭлектронныйДокументПослеЗаписи(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ДополнительныеПараметры.Форма;
	
	Форма.Записать();
	
	Ссылка = Форма.Объект.Ссылка;
	
	Если Ссылка.Пустая() Или Форма.Модифицированность Тогда
		Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
	КонецЕсли;
	
	ПросмотретьЭлектронныйДокумент(Форма, Ссылка);
	
КонецПроцедуры

Процедура ВыполнитьКомандуОткрытьЭлектронныеДокументыНаПодпись() Экспорт
	
	ОткрытьФорму("Обработка.ВнутренниеЭлектронныеДокументыБЭДБГУ.Форма.ДокументыНаПодпись");
	
КонецПроцедуры

Процедура ПечатьДокументовОбработкаНавигационнойСсылки(Форма, Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка) Экспорт
	
	Если НавигационнаяСсылкаФорматированнойСтроки <> "ВнутреннийЭДОБГУПрогрессПодписания" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ОбъектыУчета = Форма.Параметры.ПараметрКоманды;
	
	Если Не ЗначениеЗаполнено(ОбъектыУчета) Тогда 
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектыУчета) <> Тип("Массив") Тогда
		ОбъектыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОбъектыУчета);
	КонецЕсли;
	
	ОбъектУчета = ОбъектыУчета[0];
	
	Если ЗначениеЗаполнено(Форма.Параметры.ПараметрыИсточника) Тогда
		ИдентификаторКомандыПечати = Форма.Параметры.ПараметрыИсточника.ИдентификаторКоманды;
	Иначе
		ИдентификаторКомандыПечати = Форма.Параметры.ПараметрыПечати.Идентификатор;
	КонецЕсли;
	
	ПараметрыДокумента = ВнутреннийЭДОВызовСервера.ПараметрыЭлектронногоДокумента(ОбъектУчета, ИдентификаторКомандыПечати);
	
	Если ЗначениеЗаполнено(ПараметрыДокумента.АктуальныйЭлектронныйДокумент) Тогда
		ОткрытьЭлектронныйДокумент(ПараметрыДокумента.АктуальныйЭлектронныйДокумент);
	Иначе
		ОткрытьФормуЭлектронногоДокумента(ПараметрыДокумента.ПараметрыНовогоЭлектронногоДокумента);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПечатьДокументовОбработкаОповещения(Форма, ИмяСобытия, Параметр, Источник) Экспорт
	
	Если ИмяСобытия = ИмяСобытияОбновленияСостоянияВнутреннегоЭД() Тогда
		
		ОбъектыУчета = Форма.Параметры.ПараметрКоманды;
		
		Если Не ЗначениеЗаполнено(ОбъектыУчета) Тогда
			Возврат;
		КонецЕсли;
		
		Если ТипЗнч(ОбъектыУчета) <> Тип("Массив") Тогда
			ОбъектыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОбъектыУчета);
		КонецЕсли;
		
		ОбъектУчета = ОбъектыУчета[0];
		
		Если Не ЗначениеЗаполнено(ОбъектУчета) Тогда
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Форма.Параметры.ПараметрыИсточника) Тогда
			ИдентификаторКомандыПечати = Форма.Параметры.ПараметрыИсточника.ИдентификаторКоманды;
		ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Параметры.ПараметрыПечати, "Идентификатор") Тогда
			ИдентификаторКомандыПечати = Форма.Параметры.ПараметрыПечати.Идентификатор;
		Иначе
			Возврат;
		КонецЕсли;
		
		Состояние = ВнутреннийЭДОВызовСервера.СостояниеАктуальногоЭлектронногоДокумента(
			ОбъектУчета, ИдентификаторКомандыПечати);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Форма.Элементы, "ПредставлениеПрогрессаПодписанияДекорацияБГУ", "Заголовок",
				Новый ФорматированнаяСтрока(Состояние.ПредставлениеСостояния,,,, "ВнутреннийЭДОБГУПрогрессПодписания"));
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьПростуюПодпись(ТекущиеДанные) Экспорт
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваПодписи = Новый Структура(
		"ВладелецПодписи, Организация, Должность, ДатаПодписи, УстановившийПодпись");
	
	ЗаполнитьЗначенияСвойств(СвойстваПодписи, ТекущиеДанные);
	
	ПараметрыФормы = Новый Структура("СвойстваПодписи", СвойстваПодписи);
	ОткрытьФорму("РегистрСведений.ПростыеЭлектронныеПодписиБГУ.Форма.ПростаяЭлектроннаяПодпись", ПараметрыФормы);
	
КонецПроцедуры

Процедура ПоказатьТабличныйДокумент(Результат, Параметры) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресДокумента", Параметры.АдресТабличногоДокумента);
	ПараметрыФормы.Вставить("Заголовок", Параметры.Заголовок);
	
	ОткрытьФорму("ОбщаяФорма.ФормаПросмотраТабличногоДокумента", ПараметрыФормы);
	
КонецПроцедуры

Процедура ПоказатьPDFДокумент(Результат, Параметры) Экспорт
	Если ЗначениеЗаполнено(Параметры.СсылкаНаФайл) Тогда
		УникальныйИдентификатор = Новый УникальныйИдентификатор;
		ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ДанныеФайлаДляОткрытия(
			Параметры.СсылкаНаФайл, Неопределено, УникальныйИдентификатор);
		
		РаботаСФайламиКлиент.ОткрытьФайл(ДанныеФайла);
	КонецЕсли;
КонецПроцедуры

Процедура ПодписатьЭлектроннойПодписью(ЭлектронныеДокументы, УникальныйИдентификатор, ВидПодписи, Сертификат) Экспорт
	
	ДанныеДокументов = ВнутреннийЭДОВызовСервера.ДанныеДокументовДляПодписиБГУ(
		ЭлектронныеДокументы, УникальныйИдентификатор, ВидПодписи, Сертификат);
	
	НаборДанных = ДанныеДокументов.НаборДанных;
		
	Для Каждого Данные Из НаборДанных Цикл
		
		ПараметрыОбработчика = Новый Структура;
		ПараметрыОбработчика.Вставить("Заголовок", Данные.Заголовок);
		ПараметрыОбработчика.Вставить("АдресТабличногоДокумента", Данные.АдресТабличногоДокумента);
		
		Если Данные.ЭтоДанныеPDF Тогда
			ПараметрыОбработчика.Вставить("Данные", Данные.Данные);
			ПараметрыОбработчика.Вставить("СсылкаНаФайл", Данные.ФайлДляПодписи);
			ОбработчикОткрытияТабличногоДокумента = Новый ОписаниеОповещения(
				"ПоказатьPDFДокумент", ВнутреннийЭДОКлиент, ПараметрыОбработчика);
		Иначе	
			ОбработчикОткрытияТабличногоДокумента = Новый ОписаниеОповещения(
				"ПоказатьТабличныйДокумент", ВнутреннийЭДОКлиент, ПараметрыОбработчика);
		КонецЕсли;
		
		Данные.Вставить("Представление", Новый Структура("Значение, Представление",
			ОбработчикОткрытияТабличногоДокумента, Данные.Заголовок));
		
	КонецЦикла;
	
	Если НаборДанных.Количество() > 2 Тогда
		Операция = НСтр("ru = 'Подпись документов'");
		ЗаголовокДанных = НСтр("ru = 'Документы'");
		ПредставлениеНабора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Документы (%1)'"), НаборДанных.Количество());
	Иначе
		Операция = НСтр("ru = 'Подпись документа'");
		ЗаголовокДанных = НСтр("ru = 'Документ'");
		ПредставлениеНабора = НаборДанных[0].Заголовок;
	КонецЕсли;
	
	ОписаниеДанных = Новый Структура;
	ОписаниеДанных.Вставить("Операция", Операция);
	ОписаниеДанных.Вставить("ЗаголовокДанных", ЗаголовокДанных);
	ОписаниеДанных.Вставить("СообщитьОЗавершении", Ложь);
	ОписаниеДанных.Вставить("ПоказатьКомментарий", Ложь);
	
	ОписаниеДанных.Вставить("НаборДанных", НаборДанных);
	ОписаниеДанных.Вставить("ПредставлениеНабора", ПредставлениеНабора);
	
	Обработчик = Новый ОписаниеОповещения("ПродолжитьПослеЭлектроннойПодписи", ЭтотОбъект);
	
	Если ВидПодписи = ПредопределенноеЗначение("Перечисление.ВидыЭлектронныхПодписейБГУ.Усиленная") Тогда
		ОписаниеДанных.Вставить("ОтборСертификатов", ДанныеДокументов.ДоступныеСертификаты);
		ПараметрыПодписания = ЭлектроннаяПодписьКлиент.НовыйТипПодписи();
		ПараметрыПодписания.ВыборДоверенности = Истина;
		ЭлектроннаяПодписьКлиент.Подписать(ОписаниеДанных, , Обработчик, ПараметрыПодписания)
	ИначеЕсли ВидПодписи = ПредопределенноеЗначение("Перечисление.ВидыЭлектронныхПодписейБГУ.Простая") Тогда
		
		ОписаниеДанных.Вставить("СведенияДляПростойПодписи", ДанныеДокументов.СведенияДляПростойПодписи);
		
		Отказ = Ложь;
		ОписаниеОшибки = "";
		ПроверитьСведенияОДолжностиПодписантаПЭП(ОписаниеДанных, Отказ, ОписаниеОшибки);
					
		Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
			Возврат;
		КонецЕсли;

		ПодписатьПростойПодписью(ОписаниеДанных, Обработчик);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодписатьПростойПодписью(ОписаниеДанных, ОбработкаРезультата = Неопределено) Экспорт
	
	КлиентскиеПараметры = Новый Структура;
	КлиентскиеПараметры.Вставить("ОписаниеДанных", ОписаниеДанных);
	КлиентскиеПараметры.Вставить("ОбработкаРезультата", ОбработкаРезультата);
	
	ОбработкаЗавершения = Новый ОписаниеОповещения("СтандартноеЗавершение", ЭтотОбъект, КлиентскиеПараметры);
	
	СерверныеПараметры = Новый Структура;
	СерверныеПараметры.Вставить("Операция", НСтр("ru = 'Подписание данных'"));
	СерверныеПараметры.Вставить("ЗаголовокДанных", НСтр("ru = 'Данные'"));
	ЗаполнитьЗначенияСвойств(СерверныеПараметры, ОписаниеДанных);
	
	НастроитьПредставлениеДанных(КлиентскиеПараметры, СерверныеПараметры);
	
	Контекст = Новый Структура;
	
	Форма = ОткрытьФорму("ОбщаяФорма.ПодписаниеДанныхПростойПодписьюБГУ", СерверныеПараметры, , , , ,
		Новый ОписаниеОповещения("ОткрытьНовуюФормуОповещениеОЗакрытии", ЭтотОбъект, Контекст));
	
	Контекст.Вставить("Форма", Форма);
	Контекст.Вставить("ОбработкаЗавершения", ОбработкаЗавершения);
	Контекст.Вставить("КлиентскиеПараметры", КлиентскиеПараметры);
	
	Оповещение = Новый ОписаниеОповещения("ОткрытьНовуюФормуПродолжение", ЭтотОбъект, Контекст);
	
	Если КлиентскиеПараметры = Неопределено Тогда
		Форма.ПродолжитьОткрытие(Оповещение);
	Иначе
		Форма.ПродолжитьОткрытие(Оповещение, КлиентскиеПараметры);
	КонецЕсли;
	
КонецПроцедуры

// Продолжение процедуры ОткрытьНовуюФорму.

Процедура ОткрытьНовуюФормуПродолжение(Результат, Контекст) Экспорт
	
	Если Контекст.Форма.Открыта() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Контекст.ОбработкаЗавершения) = Тип("ОписаниеОповещения") Тогда
		ВыполнитьОбработкуОповещения(Контекст.ОбработкаЗавершения, Результат);
	КонецЕсли;
	
КонецПроцедуры

// Продолжение процедуры ОткрытьНовуюФорму.

Процедура ОткрытьНовуюФормуОповещениеОЗакрытии(Результат, Контекст) Экспорт
	
	Если ТипЗнч(Контекст.ОбработкаЗавершения) = Тип("ОписаниеОповещения") Тогда
		ВыполнитьОбработкуОповещения(Контекст.ОбработкаЗавершения, Результат);
	КонецЕсли;
	
КонецПроцедуры

// Только для внутреннего использования.

Процедура СтандартноеЗавершение(Успех, КлиентскиеПараметры) Экспорт
	
	КлиентскиеПараметры.ОписаниеДанных.Вставить("Успех", Успех = Истина);
	КлиентскиеПараметры.ОписаниеДанных.Вставить("Отказ", Успех = Неопределено);
	
	Если КлиентскиеПараметры.ОбработкаРезультата <> Неопределено Тогда
		
		ОбработкаРезультата = КлиентскиеПараметры.ОбработкаРезультата;
		КлиентскиеПараметры.ОбработкаРезультата = Неопределено;
		ВыполнитьОбработкуОповещения(ОбработкаРезультата, КлиентскиеПараметры.ОписаниеДанных);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПродолжитьПослеЭлектроннойПодписи(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Успех Тогда
		
		Для Каждого ТекДанные Из Результат.НаборДанных Цикл
			ТекДанные.Удалить("АдресТабличногоДокумента");
			ТекДанные.Удалить("Данные");
			ТекДанные.Удалить("Заголовок");
			ТекДанные.Удалить("Представление");

			Если Результат.Свойство("РезультатПроверкиМЧДДляПодписания") Тогда
				Если Результат.РезультатПроверкиМЧДДляПодписания <> Неопределено Тогда
					РезультатПроверкиПодписиПоМЧД = Новый Структура;
					РезультатПроверкиПодписиПоМЧД.Вставить("ТребуетсяПроверка", Истина);
					
					ТекДанные.СвойстваПодписи.Вставить("РезультатПроверкиПодписиПоМЧД", РезультатПроверкиПодписиПоМЧД);
					Если Результат.Свойство("ВыбраннаяДоверенность") Тогда
						ТекДанные.СвойстваПодписи.РезультатПроверкиПодписиПоМЧД.Вставить("МашиночитаемаяДоверенность", Результат.ВыбраннаяДоверенность);
					КонецЕсли;
					ПротоколПроверки = Новый Соответствие;
					ПроверкаДоверенности = Новый Структура;
					ПроверкаПодписанта = Новый Структура;
					ПроверкаПолномочий = Новый Структура;
					ПроверкаДокумента = Новый Структура;
					
					Проверка = Новый Структура;
					Проверка.Вставить("Верна", Неопределено);
					Проверка.Вставить("ЗаголовокПроверки", "");
					Проверка.Вставить("ТекстПроверки", "");
					Проверка.Вставить("ДатаПроверки", Неопределено);
					Проверка.Вставить("РучнаяПроверка", Ложь);
					Проверка.Вставить("ДополнительныеДанные", Неопределено);
					
					Если Результат.РезультатПроверкиМЧДДляПодписания.Свойство("ПроверкаДоверенности") Тогда
						ПроверкаДоверенности = Результат.РезультатПроверкиМЧДДляПодписания.ПроверкаДоверенности;
					КонецЕсли;	
					Если Результат.РезультатПроверкиМЧДДляПодписания.Свойство("ПроверкаПодписанта") Тогда
						ПроверкаПодписанта = Результат.РезультатПроверкиМЧДДляПодписания.ПроверкаПодписанта;
					КонецЕсли;
						
					ПроверкаПолномочий = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(Проверка);
					ПроверкаПолномочий.ЗаголовокПроверки = "Проверка полномочий";
					ПроверкаДокумента = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(Проверка);
					ПроверкаДокумента.ЗаголовокПроверки = "Проверка документа";
					
					ПротоколПроверки.Вставить("ПроверкаДоверенности", ПроверкаДоверенности);
					ПротоколПроверки.Вставить("ПроверкаПодписанта", ПроверкаПодписанта);
					ПротоколПроверки.Вставить("ПроверкаПолномочий", ПроверкаПолномочий);
					ПротоколПроверки.Вставить("ПроверкаДокумента", ПроверкаДокумента);
					
					ТекДанные.СвойстваПодписи.РезультатПроверкиПодписиПоМЧД.Вставить("ПротоколПроверки", ПротоколПроверки);
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла;
		
		ВнутреннийЭДОВызовСервера.ПодписатьЭлектроннойПодписью(Результат.НаборДанных);
		
		Оповестить(ИмяСобытияОбновленияСостоянияВнутреннегоЭД());
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередОткрытиемЭлектронногоДокументаБЭД(УчетныйДокумент, Форма, СтандартнаяОбработка) Экспорт
	
	Если ВнутреннийЭДОВызовСервера.ТребуетсяОткрытьЭлектронныйДокументБГУпоКомандеЭДО(УчетныйДокумент) Тогда
		СтандартнаяОбработка = Ложь;
		ПросмотретьЭлектронныйДокумент(Форма, УчетныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

