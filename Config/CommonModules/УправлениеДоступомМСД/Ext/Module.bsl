#Область СлужебныйПрограммныйИнтерфейс

// См. одноименную процедуру общего модуля "УправлениеДоступомПереопределяемый"
//
Процедура ПриЗаполненииСписковСОграничениемДоступа(Списки) Экспорт
	
	Списки.Вставить(Метаданные.Документы.ПакетыДанныхДляМСД, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.ЗаданияОбменаКлиентМСД, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.ЗапросыДанныхМСД, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.ЗапросыНаСверкуДанныхМСД, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.ИсторияОбменаЕСМВСМЭВ, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.КодИСОрганизацийМСД, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.КонтрольныеСоотношенияТаксономииМСД, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.НастройкиВыгрузкиАналитикМСД, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.НастройкиРеквизитовАналитикМСД, Истина); 
	Списки.Вставить(Метаданные.РегистрыСведений.ПакетыДанныхМСД, Истина);
    Списки.Вставить(Метаданные.РегистрыСведений.СведенияОСрокахПредоставленияДанныхМСД, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.СтатусыВерсийЕФ, Истина);
	
КонецПроцедуры	

// См. одноименную процедуру общего модуля "УправлениеДоступомПереопределяемый"
//
Процедура ПриЗаполненииВидовОграниченийПравОбъектовМетаданных(Описание) Экспорт
	
	Описание =  Описание + "
	|Документ.ПакетыДанныхДляМСД.Чтение.Организации
	|Документ.ПакетыДанныхДляМСД.Изменение.Организации
	|РегистрСведений.ЗаданияОбменаКлиентМСД.Чтение.Организации
	|РегистрСведений.ЗаданияОбменаКлиентМСД.Изменение.Организации
	|РегистрСведений.ЗапросыДанныхМСД.Чтение.Организации
	|РегистрСведений.ЗапросыДанныхМСД.Изменение.Организации
	|РегистрСведений.ЗапросыНаСверкуДанныхМСД.Чтение.Организации
	|РегистрСведений.ЗапросыНаСверкуДанныхМСД.Изменение.Организации
	|РегистрСведений.ИсторияОбменаЕСМВСМЭВ.Чтение.Организации
	|РегистрСведений.ИсторияОбменаЕСМВСМЭВ.Изменение.Организации
	|РегистрСведений.КодИСОрганизацийМСД.Чтение.Организации
	|РегистрСведений.КодИСОрганизацийМСД.Изменение.Организации
	|РегистрСведений.КонтрольныеСоотношенияТаксономииМСД.Чтение.Организации
	|РегистрСведений.КонтрольныеСоотношенияТаксономииМСД.Изменение.Организации
	|РегистрСведений.НастройкиВыгрузкиАналитикМСД.Чтение.Организации
	|РегистрСведений.НастройкиВыгрузкиАналитикМСД.Изменение.Организации
	|РегистрСведений.НастройкиРеквизитовАналитикМСД.Чтение.Организации
	|РегистрСведений.НастройкиРеквизитовАналитикМСД.Изменение.Организации
	|РегистрСведений.ПакетыДанныхМСД.Чтение.Организации
	|РегистрСведений.ПакетыДанныхМСД.Изменение.Организации
	|РегистрСведений.СведенияОСрокахПредоставленияДанныхМСД.Чтение.Организации
	|РегистрСведений.СведенияОСрокахПредоставленияДанныхМСД.Изменение.Организации
	|РегистрСведений.СтатусыВерсийЕФ.Чтение.Организации
	|РегистрСведений.СтатусыВерсийЕФ.Изменение.Организации";	

КонецПроцедуры

Процедура ПриЗаполненииПоставляемыхПрофилейГруппДоступа(ОписанияПрофилей, ПараметрыОбновления) Экспорт
	
	МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
	
