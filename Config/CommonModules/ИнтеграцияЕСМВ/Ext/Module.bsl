			"ВЫБРАТЬ
			|	ТТ.ИдентификаторПакета КАК ИдентификаторПакета,
			|	ТТ.ДатаОбмена КАК ДатаОбмена,
			|	РАЗМЕРХРАНИМЫХДАННЫХ(ТТ.ПередачаПакетаЗапрос) + РАЗМЕРХРАНИМЫХДАННЫХ(ТТ.ПередачаПакетаОтвет) КАК РазмерФайлов
			|ИЗ
			|	РегистрСведений.ПакетыДокументовОбменаЕБП КАК ТТ
			|ГДЕ
			|	ТТ.ДатаОбмена < &ПредельнаяДата
			|	И РАЗМЕРХРАНИМЫХДАННЫХ(ТТ.ПередачаПакетаЗапрос) + РАЗМЕРХРАНИМЫХДАННЫХ(ТТ.ПередачаПакетаОтвет) > &Размер";
		
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		ИмяРегистра = "ПакетыДокументовОбменаЕБП";
		НаименованиеРегистра = "Пакеты документов обмена ЕБП";
		ИмяПоляВЗапросе = "ИдентификаторПакета";
		НаименованиеПоля = "идентификатором пакета";

		СтруктураПолейХЗ = Новый Структура("ПередачаПакетаЗапрос,ПередачаПакетаОтвет",
			ПустоеХЗ,ПустоеХЗ);
			
		ОчиститьХранилищаЗначенийЗаписиРегистраЕБП(Выборка, ИмяСобытия, ИмяРегистра, НаименованиеРегистра, ИмяПоляВЗапросе, НаименованиеПоля, СтруктураПолейХЗ);
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,,
		НСтр("ru = 'Завершено регламентное задание ""Очистка истории обмена с ЕБП""'"),
		);

КонецПроцедуры

Процедура УдалитьОчиститьЗаписиРегистраЕБП(Знач ВыборкаДокументов, Знач ИмяСобытия, Знач ИмяРегистра, Знач НаименованиеРегистра, Знач ИмяПоляВЗапросе, Знач НаименованиеПоля,Знач СтруктураПолейХЗ)
	
	Перем ЗаписьРС, Кол, ТекстОшибки, ТекстСообщения;
	
	Кол = 0;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		
		Выборка = ВыборкаДокументов.Выбрать();
		Первая = Истина;
		Пока Выборка.Следующий() Цикл
			
			Если Первая Тогда
				//последнюю по дате запись оставляем и очищаем у нее логи
				Если Выборка.РазмерФайлов > 200 Тогда //50 байт * 4 поля
					Попытка
						ЗаписьРС = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
						ЗаполнитьЗначенияСвойств(ЗаписьРС,Выборка);
						ЗаписьРС.Прочитать();
						Если ЗаписьРС.Выбран() Тогда
							ЗаполнитьЗначенияСвойств(ЗаписьРС,СтруктураПолейХЗ);
							Кол = Кол + 1;
							ЗаписьРС.Записать();
						КонецЕсли;
						
					Исключение
						ТекстСообщения = НСтр("ru='Не удалось очистить логи обмена в записи регистра сведений ""%1"" с %2 %3 по причине: %4'");
						ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НаименованиеРегистра, НаименованиеПоля, Выборка[ИмяПоляВЗапросе], ТекстОшибки);
						
						ЗаписьЖурналаРегистрации(
							ИмяСобытия,
							УровеньЖурналаРегистрации.Ошибка,
							Метаданные.РегистрыСведений[ИмяРегистра],
							,
							ТекстСообщения);
					КонецПопытки;
				КонецЕсли;
				
				Первая = Ложь;
				Продолжить;
			КонецЕсли;
			
			ЗаписьНЗ = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаписьНЗ,Выборка);
			Кол = Кол + 1;
		КонецЦикла;
		
		Если НаборЗаписей.Количество() Тогда
			Попытка
				НаборЗаписей.Записать(РежимЗамещения.Удаление);
			Исключение
				ТекстСообщения = НСтр("ru='Не удалось удалить записи регистра сведений ""%1"" по причине: %2'");
				ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НаименованиеРегистра, ТекстОшибки);
				
				ЗаписьЖурналаРегистрации(
					ИмяСобытия,
					УровеньЖурналаРегистрации.Ошибка,
					Метаданные.РегистрыСведений[ИмяРегистра],
					,
					ТекстСообщения);
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстСообщения = НСтр("ru='Удалено записей регистра сведений ""%1"": %2'");
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НаименованиеРегистра, Кол);
	ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		ТекстСообщения);
	
КонецПроцедуры

