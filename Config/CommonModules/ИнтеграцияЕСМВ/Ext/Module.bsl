
// Возвращает настройки подключения к ЕСМВ Казначейства России 
//
// Параметры:
//  Организация - СправочникСсылка.Организация - организация, для которой требуется
// получить настройки
//
// Возвращаемое значение:
//  Фиксированная структура - адреса подключения к ЕСМВ Казначейства России 
//      * АдресАвторизации - Строка.
//      * АдресЗагрузкиФайлов - Строка.
//      * АдресПередачиПакетов - Строка.
//      * АдресЗапросаРезультатов - Строка.
//      * АдресЗапросаДокументов - Строка.
//      * АдресЗапросаФайлов - Строка.
//      * Сертификат - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования. 
//      * МодульИнтеграции - ПеречислениеСсылка.МодулиИнтеграции 
//
Функция НастройкиУчастникаЕСМВ(Организация, МодульИнтеграции) Экспорт
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	МассивПользователей = Новый Массив;
	МассивПользователей.Добавить(ТекущийПользователь);
	МассивПользователей.Добавить(Справочники.Пользователи.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиОрганизацийДляОбменаЕСМВ.Организация КАК Организация,
		|	СОКРЛП(НастройкиОрганизацийДляОбменаЕСМВ.АдресАвторизации) КАК АдресАвторизации,
		|	СОКРЛП(НастройкиОрганизацийДляОбменаЕСМВ.АдресЗагрузкиФайлов) КАК АдресЗагрузкиФайлов,
		|	СОКРЛП(НастройкиОрганизацийДляОбменаЕСМВ.АдресПередачиПакетов) КАК АдресПередачиПакетов,
		|	СОКРЛП(НастройкиОрганизацийДляОбменаЕСМВ.АдресЗапросаРезультатов) КАК АдресЗапросаРезультатов,
		|	СОКРЛП(НастройкиОрганизацийДляОбменаЕСМВ.АдресЗапросаДокументов) КАК АдресЗапросаДокументов,
		|	СОКРЛП(НастройкиОрганизацийДляОбменаЕСМВ.АдресЗапросаФайлов) КАК АдресЗапросаФайлов
		|ИЗ
		|	РегистрСведений.НастройкиОрганизацийДляОбменаЕСМВ КАК НастройкиОрганизацийДляОбменаЕСМВ
		|ГДЕ
		|	НастройкиОрганизацийДляОбменаЕСМВ.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СертификатыПользователейДляОбменаЕСМВ.Сертификат КАК Сертификат,
		|	ВЫБОР
		|		КОГДА СертификатыПользователейДляОбменаЕСМВ.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|			ТОГДА 2
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПорядокИспользования
		|ИЗ
		|	РегистрСведений.СертификатыПользователейДляОбменаЕСМВ КАК СертификатыПользователейДляОбменаЕСМВ
		|ГДЕ
		|	СертификатыПользователейДляОбменаЕСМВ.Организация = &Организация
		|	И СертификатыПользователейДляОбменаЕСМВ.Пользователь В(&Пользователи)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокИспользования";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Пользователи", МассивПользователей);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();
	
	НастройкаУчастника = Новый Структура("АдресАвторизации,АдресЗагрузкиФайлов,АдресПередачиПакетов,АдресЗапросаРезультатов,АдресЗапросаДокументов,АдресЗапросаФайлов,Сертификат");
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(НастройкаУчастника, ВыборкаДетальныеЗаписи);
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
		
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(НастройкаУчастника, ВыборкаДетальныеЗаписи, "Сертификат");
	КонецЕсли; 
	
	НастройкаУчастника.Вставить("МодульИнтеграции", МодульИнтеграции); 
	
	Возврат Новый ФиксированнаяСтруктура(НастройкаУчастника);
	
КонецФункции

Функция ПройтиАвторизациюЕСМВ(Организация, НастройкиУчастника, ГУИДАвторизации, ВремяЖизниТокена = 86400, ТребуетсяРасшифровка=Ложь) Экспорт
	
	//если время жизни токена = 0, то выполняем авторизацию всегда
	Если ВремяЖизниТокена > 0 Тогда
		
		Запрос = Новый Запрос;
		// Т.к. сертификат может быть одинаковый у разных организаций, 
		// получаем самый актуальный токен по сертификату, без учета организаций 
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	СообщенияАвторизацииЕСМВ.ТокенАвторизации КАК ТокенАвторизации,
			|	СообщенияАвторизацииЕСМВ.ГУИДАвторизации КАК ГУИДАвторизации,
			|	СообщенияАвторизацииЕСМВ.ДатаОбмена КАК ДатаОбмена
			|ИЗ
			|	РегистрСведений.СообщенияАвторизацииЕСМВ КАК СообщенияАвторизацииЕСМВ
			|ГДЕ
			|	СообщенияАвторизацииЕСМВ.ДатаОбмена >= &ДатаОбмена
			|	И СообщенияАвторизацииЕСМВ.Сертификат = &Сертификат
			|	И СообщенияАвторизацииЕСМВ.АвторизацияУспешно
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДатаОбмена УБЫВ";	
		
		//В ЕБП токен действует 24 часа = 86400 секунд, но на всякий случай даем возможность задать время параметром.
		Запрос.УстановитьПараметр("ДатаОбмена", ТекущаяДатаСеанса()-ВремяЖизниТокена);  
		Запрос.УстановитьПараметр("Сертификат", НастройкиУчастника.Сертификат);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ТокенАвторизации) Тогда
				ГУИДАвторизации = ВыборкаДетальныеЗаписи.ГУИДАвторизации;
				ТокенАвторизации = ВыборкаДетальныеЗаписи.ТокенАвторизации;
				Возврат ТокенАвторизации;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	ДДСертификата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкиУчастника.Сертификат,"ДанныеСертификата").Получить();
	СертификатКриптографии = Новый СертификатКриптографии(ДДСертификата);
	
	// Адрес = "https://<сервер>/api/auth/api/v1/auth/ext-system"; 
	// Сервер тестовый = "auth.ebp01.roskazna.ru";
	// Сервер промышленный = "auth.finance.gov.ru";
	// АдресРесурса = "api/auth/api/v1/auth/ext-system";
	
	ДатаОбмена = ТекущаяДатаСеанса();
	ЗаписьСообщенияАвторизации = РегистрыСведений.СообщенияАвторизацииЕСМВ.СоздатьМенеджерЗаписи();
	ЗаписьСообщенияАвторизации.Организация = Организация;
	ЗаписьСообщенияАвторизации.ДатаОбмена = ДатаОбмена;
	ЗаписьСообщенияАвторизации.ГУИДАвторизации = ГУИДАвторизации;
	ЗаписьСообщенияАвторизации.Сертификат = НастройкиУчастника.Сертификат;
	
	Попытка
		СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(НастройкиУчастника.АдресАвторизации);
	Исключение
		СтруктураАдреса = Новый Структура("Схема,Хост,Порт,ПутьНаСервере,Логин,Пароль","","","","","","");
	КонецПопытки;
	
	
	Запрос = ПолучитьЗапросАвторизации(ДДСертификата, СтруктураАдреса);
	
	Прокси = ЭкспортФайлов.ПолучитьПрокси("https");
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(СертификатКриптографии);
	
	HTTPСоединение = Новый HTTPСоединение(СтруктураАдреса.Хост,,,, Прокси, 100, ЗащищенноеСоединение);
	
	Попытка
		Результат = ОтправитьPOSTЗапрос(HTTPСоединение,Запрос);
    	//Результат = HTTPСоединение.ОтправитьДляОбработки(Запрос);
	Исключение
		ТекстСообщения = НСтр("ru='Не удалось отправить сообщение для прохождения авторизации по причине:
		|%1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ЕБП.Авторизация",УровеньЖурналаРегистрации.Ошибка,Метаданные.ЖурналыДокументов.ВзаимодействияСЕБП,,ТекстСообщения);
		
		Возврат Неопределено;
	КонецПопытки;
	
	ТекстАвторизацииЗапрос = ПолучитьТекстЗапроса(Запрос, СтруктураАдреса.ПутьНаСервере);
	
	ЗаписьСообщенияАвторизации.АвторизацияЗапрос = Новый ХранилищеЗначения(ТекстАвторизацииЗапрос, Новый СжатиеДанных(9));
	
	ТокенАвторизацииИзОтвета = ПолучитьТокенАвторизацииИзОтвета(Результат);
		
	ТекстАвторизацииОтвет = ПолучитьТекстОтвета(Результат);

	ЗаписьСообщенияАвторизации.АвторизацияОтвет = Новый ХранилищеЗначения(ТекстАвторизацииОтвет,Новый СжатиеДанных(9));
		
	Если Результат <> Неопределено
		И Результат.КодСостояния >= 200
		И Результат.КодСостояния < 300	
		И ТокенАвторизацииИзОтвета <> Неопределено Тогда
		
		ЗаписьСообщенияАвторизации.АвторизацияУспешно = Истина;
		ЗаписьСообщенияАвторизации.ТокенИзОтвета = ТокенАвторизацииИзОтвета;
		Если Base64Значение(ТокенАвторизацииИзОтвета) = Неопределено Тогда
			//Если токен шифруется, он будет закодирован в base64.
			//Если это не base64, значит шифрование еще не используется.
			
			ТипТокена = ИнтеграцияЕСМВКлиентСервер.ТипАвторизацииТокена();
			//При обмене с ЕБП используется тип авторизации Bearer, он должен быть указан в токене.
			//Укажем сами, если он не указан:
			Если СтрНайти(ТокенАвторизацииИзОтвета, ТипТокена)=0 Тогда
				ТокенАвторизацииИзОтвета = ТипТокена + ТокенАвторизацииИзОтвета;
			КонецЕсли;
			ЗаписьСообщенияАвторизации.ТокенАвторизации = ТокенАвторизацииИзОтвета;
		Иначе
			ТребуетсяРасшифровка = Истина;
		КонецЕсли;

	Иначе
		ТелоОтвета = "";
		ТекстОшибки = "";
		Если Результат<>Неопределено Тогда
			ТелоОтвета = Результат.ПолучитьТелоКакСтроку();
			ТекстОшибки = НСтр("ru='Не удалось выполнить авторизацию. Ответ из сервиса: %1
				|Подробнее в файле ответа сервера прохождения авторизации.'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТелоОтвета); 			
		Иначе
			ТекстОшибки = НСтр("ru='Не удалось выполнить авторизацию. Подробнее в файле ответа сервера прохождения авторизации.'");
		КонецЕсли;
		СтруктураКлюча = Новый Структура("Организация,ГУИДАвторизации");
		ЗаполнитьЗначенияСвойств(СтруктураКлюча,ЗаписьСообщенияАвторизации);
		КлючЗаписи = РегистрыСведений.СообщенияАвторизацииЕСМВ.СоздатьКлючЗаписи(СтруктураКлюча);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,КлючЗаписи);
		
		ЗаписьСообщенияАвторизации.ТекстОшибки = ТекстОшибки;
		ЗаписьСообщенияАвторизации.ЕстьОшибка = Истина;
		
	КонецЕсли;
	
	ЗаписьСообщенияАвторизации.Записать();
	
	Возврат ТокенАвторизацииИзОтвета;
	
КонецФункции  

// Параметры:
//  ПараметрыОтправки - Структура  
//      * Организация - СправочникСсылка.
//      * ЛицевойСчет - СправочникСсылка.
//      * НастройкиУчастника - Фиксированная структура - адреса подключения к ЕСМВ Казначейства России 
//      	* АдресАвторизации - Строка.
//      	* АдресЗагрузкиФайлов - Строка.
//      	* АдресПередачиПакетов - Строка.
//      	* АдресЗапросаРезультатов - Строка.
//      	* АдресЗапросаДокументов - Строка.
//      	* АдресЗапросаФайлов - Строка.
//      	* Сертификат - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования. 
//      	* МодульИнтеграции - ПеречислениеСсылка.МодулиИнтеграции 
//      * НастройкиОбмена - Структура.
//      * ИмяПроцедурыОбмена - Строка.
//      * СписокДокументов - Массив.  
//      * ОтправленныеДокументы - Массив. 
//      * ФормаИсточник - УправляемаяФорма. 
//      * ГУИДАвторизации - 
//      * ТребуетсяРасшифровка -  Булево
//      * ТокенАвторизации -  Строка
//
Процедура ОтправитьОтмеченныеДокументы(ПараметрыОтправки) Экспорт  
	
	НастройкиУчастника = ПараметрыОтправки.НастройкиУчастника; 
	НастройкиОбмена = ПараметрыОтправки.НастройкиОбмена; 
	СписокДокументов = ПараметрыОтправки.СписокДокументов;
	
	МассивДокументовДляПакета = Новый Массив;
	МассивТекстовДляПакета = Новый Массив;
	КоличествоДокументовВПакете = 10; //максимум 100  
	
	ОтправленныеДокументы = Новый Массив;
	
	ДДСертификата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкиУчастника.Сертификат, "ДанныеСертификата").Получить();
	СертификатКриптографии = Новый СертификатКриптографии(ДДСертификата);
	
	ИдентификаторПакета = Новый УникальныйИдентификатор;
	
	ЕстьЗаписьСообщения = Ложь;
	Для Каждого ДокументСсылка Из СписокДокументов Цикл
		//проверяем можно ли отправлять непосредственно перед отправкой,
		//для сценария, когда в разных сеансах пользователи выделили документы к отправке и нажали Отправить +- одновременно,
		//чтобы один и тот же документ не был отправлен по ошибке несколько раз
		Если НЕ МожноОтправлятьДокументВЕБП(ДокументСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьЗаписьСообщения = Истина;
		ИдентификаторДокументаВПакете = Новый УникальныйИдентификатор;
		ДатаОбмена = ТекущаяДатаСеанса();
		
		ЗаписьСообщения = РегистрыСведений.СообщенияОбменаДаннымиЕБП.СоздатьМенеджерЗаписи();
		ЗаписьСообщения.Организация = ПараметрыОтправки.Организация;
		ЗаписьСообщения.ЛицевойСчет = ПараметрыОтправки.ЛицевойСчет;
		ЗаписьСообщения.ГУИДАвторизации = ПараметрыОтправки.ГУИДАвторизации;
		ЗаписьСообщения.Документ = ДокументСсылка;
		ЗаписьСообщения.ДатаОбмена = ДатаОбмена;
		ЗаписьСообщения.ИдентификаторПакета = ИдентификаторПакета;
		ЗаписьСообщения.ИдентификаторДокументаВПакете = ИдентификаторДокументаВПакете;
		
		Если ЗаписьСообщения.ЕстьОшибка Тогда
			ОбщегоНазначения.СообщитьПользователю(ЗаписьСообщения.ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		Отмена = Ложь;
		
		// Сначала необходимо отправить приложенные файлы, если они есть, и записать идентификатор 
		// файла в ТЧ ФайлыПриложения, в ИдентификаторФайла.
		// Пока приложения могут быть только у документов РСКП (перечисление) и РСКП (перечисление на карты МИР). 
		// При появлении вложений к другим документам потребуются доработки.
		//
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФайлыПриложения.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РСКППеречисление.ФайлыПриложения КАК ФайлыПриложения
		|ГДЕ
		|	ФайлыПриложения.Ссылка = &Ссылка
		|	И ФайлыПриложения.НомерСтроки = 1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ФайлыПриложения.Ссылка
		|ИЗ
		|	Документ.РСКППеречислениеМир.ФайлыПриложения КАК ФайлыПриложения
		|ГДЕ
		|	ФайлыПриложения.Ссылка = &Ссылка
		|	И ФайлыПриложения.НомерСтроки = 1";
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ДокОбъект = ДокументСсылка.ПолучитьОбъект();
			Попытка
				ДокОбъект.Заблокировать();
			Исключение
				ТекстСообщения = НСтр("ru='Не удалось заблокировать документ %1 для передачи присоединенных файлов в ЕБП по причине:
				|%2
				|Документ не отправлен.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ДокументСсылка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ЕСМВ.Передача присоединенных файлов", УровеньЖурналаРегистрации.Ошибка, Метаданные.ЖурналыДокументов.ВзаимодействияСЕБП, ДокументСсылка, ТекстСообщения);
				Отмена = Истина;
			КонецПопытки;
			
			Если Отмена = Истина Тогда
				Продолжить;	
			КонецЕсли;
			
			ОтправитьПриложенныеФайлыПоДокументу(ПараметрыОтправки, ЗаписьСообщения, ДокОбъект, СертификатКриптографии, Отмена);
			
			Если Отмена = Истина Тогда
				Продолжить;	
			КонецЕсли;
			
			Попытка
				ДокОбъект.Записать();
			Исключение
				ТекстСообщения = НСтр("ru='Не удалось записать документ %1 с результатами передачи присоединенных файлов в ЕБП по причине:
				|%2
				|Документ не отправлен.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ДокументСсылка,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ЕБП.Передача присоединенных файлов", УровеньЖурналаРегистрации.Ошибка, Метаданные.ЖурналыДокументов.ВзаимодействияСЕБП, ДокументСсылка, ТекстСообщения);
				Отказ = Истина;
			КонецПопытки;
		КонецЕсли;
			
		ИдентификаторСообщенияФайла = ОтправитьФайлПоДокументу(ПараметрыОтправки, ЗаписьСообщения, СертификатКриптографии, Отмена);
       	
		Если Отмена = Истина Тогда
			Продолжить;	
		КонецЕсли;
	
		Если ЗаписьСообщения.ЕстьОшибка Тогда
			ОбщегоНазначения.СообщитьПользователю(ЗаписьСообщения.ТекстОшибки);
			Продолжить;
		КонецЕсли;
		
		ИмяФормата = ПолучитьИмяФорматаПоДокументу(ЗаписьСообщения.Документ, НастройкиУчастника.МодульИнтеграции, НастройкиОбмена, Истина);
	
		Отмена = Ложь;
			
		ДополнительныеПараметрыФорматов = Новый Структура;
		ДополнительныеПараметрыФорматов.Вставить("documentId", ИдентификаторДокументаВПакете); // идентификатор документа, он же используется в processId
		
		ТекстДляПакета = ПолучитьТекстПоФормату(НастройкиОбмена, ИмяФормата, ИдентификаторСообщенияФайла, ДокументСсылка, ЗаписьСообщения.Организация, Отмена, ДополнительныеПараметрыФорматов);
			
		Если Отмена = Истина Тогда
			ТекстСообщения = НСтр("ru='Не удалось сформировать файл для пакета по документу %1.
				|Документ не отправлен.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ДокументСсылка);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ЕСМВ.Формирование файла для пакета", УровеньЖурналаРегистрации.Ошибка, Метаданные.ЖурналыДокументов.ВзаимодействияСЕБП, ДокументСсылка, ТекстСообщения);
				Отмена = Истина;
			Продолжить;
		КонецЕсли;
		
		Если Найти(ТекстДляПакета, "<?xml version=""1.0"" encoding=""UTF-8""?>") > 0 Тогда
			ТекстДляПакета = СтрЗаменить(ТекстДляПакета,"<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС, "");		
		КонецЕсли;
		
		МассивДокументовДляПакета.Добавить(ДокументСсылка);
		МассивТекстовДляПакета.Добавить(ТекстДляПакета);
		
		Если МассивТекстовДляПакета.Количество() >= КоличествоДокументовВПакете Тогда
			ТекстДокументов = СтрСоединить(МассивТекстовДляПакета, Символы.ПС); 
			
			ОтправитьПакетЕСМВ(ПараметрыОтправки, ИдентификаторПакета, ТекстДокументов, МассивДокументовДляПакета, СертификатКриптографии);
			
			МассивТекстовДляПакета = Новый Массив;
			ИдентификаторПакета = Новый УникальныйИдентификатор;
			Для Каждого ТекДок Из МассивДокументовДляПакета Цикл
				ПараметрыОтправки.ОтправленныеДокументы.Добавить(ТекДок);
			КонецЦикла;
			МассивДокументовДляПакета.Очистить();
		КонецЕсли;
	КонецЦикла;
	
	Если МассивТекстовДляПакета.Количество() > 0 Тогда
		ТекстДокументов = СтрСоединить(МассивТекстовДляПакета, Символы.ПС);
		
		ОтправитьПакетЕСМВ(ПараметрыОтправки, ИдентификаторПакета, ТекстДокументов, МассивДокументовДляПакета, СертификатКриптографии);
		
		Для Каждого ТекДок Из МассивДокументовДляПакета Цикл
			ПараметрыОтправки.ОтправленныеДокументы.Добавить(ТекДок);
		КонецЦикла;
	КонецЕсли;
	
	Если ЕстьЗаписьСообщения
		И ЗаписьСообщения.ЕстьОшибка Тогда
		ОбщегоНазначения.СообщитьПользователю(ЗаписьСообщения.ТекстОшибки);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры  

Функция МожноОтправлятьДокументВЕБП(ДокументСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостояниеПлатежноРасчетныхДокументов.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
		|ГДЕ
		|	СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент = &ПлатежноРасчетныйДокумент
		|	И СостояниеПлатежноРасчетныхДокументов.Статус = &Статус";
	
	Запрос.УстановитьПараметр("ПлатежноРасчетныйДокумент", ДокументСсылка);
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыИсполненияДокумента.Подготовлен);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МожноОтправлять = Ложь;
	Если НЕ РезультатЗапроса.Пустой() Тогда
		МожноОтправлять = Истина;
	КонецЕсли;
	
	Возврат МожноОтправлять;
		
КонецФункции

// Параметры:
//  ПараметрыОтправки - Структура  
//      * Организация - СправочникСсылка.
//      * ЛицевойСчет - СправочникСсылка.
//      * НастройкиУчастника - Фиксированная структура - адреса подключения к ЕСМВ Казначейства России 
//      	* АдресАвторизации - Строка.
//      	* АдресЗагрузкиФайлов - Строка.
//      	* АдресПередачиПакетов - Строка.
//      	* АдресЗапросаРезультатов - Строка.
//      	* АдресЗапросаДокументов - Строка.
//      	* АдресЗапросаФайлов - Строка.
//      	* Сертификат - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования. 
//      	* МодульИнтеграции - ПеречислениеСсылка.МодулиИнтеграции 
//      * НастройкиОбмена - Структура.
//      * ИмяПроцедурыОбмена - Строка.
//      * СписокДокументов - Массив.  
//      * ОтправленныеДокументы - Массив. 
//      * ФормаИсточник - УправляемаяФорма. 
//      * ГУИДАвторизации - 
//      * ТребуетсяРасшифровка -  Булево
//      * ТокенАвторизации -  Строка
//
Процедура ЗапроситьРезультатыОбработки(ПараметрыОтправки) Экспорт    
	
	НастройкиУчастника = ПараметрыОтправки.НастройкиУчастника;
			
	ДДСертификата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкиУчастника.Сертификат, "ДанныеСертификата").Получить();
	СертификатКриптографии = Новый СертификатКриптографии(ДДСертификата);
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ПараметрыОтправки.Организация); 
	Запрос.УстановитьПараметр("Лицевойсчет", ПараметрыОтправки.ЛицевойСчет); 
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СообщенияОбменаДаннымиЕБП.Организация КАК Организация,
	|	СообщенияОбменаДаннымиЕБП.ЛицевойСчет КАК ЛицевойСчет,
	|	СообщенияОбменаДаннымиЕБП.Документ КАК Документ,
	|	СообщенияОбменаДаннымиЕБП.ИдентификаторДокументаВПакете КАК ИдентификаторДокументаВПакете,
	|	СообщенияОбменаДаннымиЕБП.ДатаОбмена КАК ДатаОбмена
	|ИЗ
	|	РегистрСведений.СообщенияОбменаДаннымиЕБП КАК СообщенияОбменаДаннымиЕБП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДокументовОбменаЕБП КАК ПакетыДокументовОбменаЕБП
	|		ПО СообщенияОбменаДаннымиЕБП.ИдентификаторПакета = ПакетыДокументовОбменаЕБП.ИдентификаторПакета
	|ГДЕ
	|	СообщенияОбменаДаннымиЕБП.Организация = &Организация 
	|	И СообщенияОбменаДаннымиЕБП.ЛицевойСчет = &ЛицевойСчет 
	|	И СообщенияОбменаДаннымиЕБП.ЕстьОшибка = ЛОЖЬ
	|	И СообщенияОбменаДаннымиЕБП.Обработано = ЛОЖЬ
	|	И ПакетыДокументовОбменаЕБП.ПередачаПакетаУспешно = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОбмена";
	
	РезультатЗапроса = Запрос.Выполнить();
					
	//Адрес = "https://<сервер>/api/rest-adapter/xml/integration/search"; 
	//Сервер тестовый = "ebp01.roskazna.ru";
	//Сервер промышленный = "finance.gov.ru";
	//АдресРесурса = "/api/rest-adapter/xml/integration/search";
		
	Попытка
		СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(НастройкиУчастника.АдресЗапросаРезультатов);
	Исключение
		СтруктураАдреса = Новый Структура("Схема,Хост,Порт,ПутьНаСервере,Логин,Пароль","","","","","","");
	КонецПопытки;
		
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(СертификатКриптографии);
	Прокси = ЭкспортФайлов.ПолучитьПрокси("https");
	HTTPСоединение = Новый HTTPСоединение(СтруктураАдреса.Хост,,,,Прокси,100,ЗащищенноеСоединение);
		
		
	ДокСсылка = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка();
	ИмяФорматаЗапросаРезультатов = "receiptsRequest";
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					
		ЗаписьСообщенияЗапроса = РегистрыСведений.СообщенияЗапросаРезультатаОбработкиЕБП.СоздатьМенеджерЗаписи();
		ЗаписьСообщенияЗапроса.Организация = ВыборкаДетальныеЗаписи.Организация; 
		ЗаписьСообщенияЗапроса.ЛицевойСчет = ВыборкаДетальныеЗаписи.ЛицевойСчет; 
		ЗаписьСообщенияЗапроса.Документ = ВыборкаДетальныеЗаписи.Документ;
		ЗаписьСообщенияЗапроса.ИдентификаторДокументаВПакете = ВыборкаДетальныеЗаписи.ИдентификаторДокументаВПакете;
		ЗаписьСообщенияЗапроса.ДатаОбмена = ТекущаяДатаСеанса();
		ЗаписьСообщенияЗапроса.ГУИДАвторизации = ПараметрыОтправки.ГУИДАвторизации;			 
							
		Отмена = Ложь;
		Запрос = ПолучитьЗапросПоФормату(ПараметрыОтправки, ДокСсылка, ИмяФорматаЗапросаРезультатов, ЗаписьСообщенияЗапроса.ИдентификаторДокументаВПакете, СтруктураАдреса, Отмена);

		Если Отмена = Истина Тогда
			Возврат;
		КонецЕсли;
		
		Попытка
			Результат = ОтправитьPOSTЗапрос(HTTPСоединение,Запрос);
	    	//Результат = HTTPСоединение.ОтправитьДляОбработки(Запрос);
		Исключение
			ТекстСообщения = НСтр("ru='Не удалось отправить в ЕБП запрос результата обработки по причине:
			|%1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ЕСМВ.Запрос результата обработки", УровеньЖурналаРегистрации.Ошибка, Метаданные.ЖурналыДокументов.ВзаимодействияСЕБП, ЗаписьСообщенияЗапроса.Документ, ТекстСообщения);
			Отказ = Истина;
			Возврат;
		КонецПопытки;
				
		ТекстЗапрос = ПолучитьТекстЗапроса(Запрос, СтруктураАдреса.ПутьНаСервере);

		ЗаписьСообщенияЗапроса.СообщениеЗапрос = Новый ХранилищеЗначения(ТекстЗапрос, Новый СжатиеДанных(9));
		
		ТекстОтвет = ПолучитьТекстОтвета(Результат);
		
		ЗаписьСообщенияЗапроса.СообщениеОтвет = Новый ХранилищеЗначения(ТекстОтвет, Новый СжатиеДанных(9));
		
		СтруктураОтвета = Новый Структура("Статус,ТекстОшибки");
		Если Результат.КодСостояния >= 200
			И Результат.КодСостояния < 300 Тогда
			// все ок
			РазобратьРезультатОбработкиПакетаДляОдногоДокмента(СтруктураОтвета, ТекстОтвет);
		Иначе
			ЗаписьСообщенияЗапроса.ЕстьОшибка = Истина;
			ЗаписьСообщенияЗапроса.ТекстОшибки = НСтр("ru='При запросе результата обработки возникла ошибка. Подробнее в файлах запроса результата обработки.'");
		КонецЕсли;
        ЗаписьСообщенияЗапроса.Записать();
		
		Если ЗаписьСообщенияЗапроса.ЕстьОшибка = Ложь Тогда
			ЗаписьСообщенияОбмена = РегистрыСведений.СообщенияОбменаДаннымиЕБП.СоздатьМенеджерЗаписи();
			ЗаписьСообщенияОбмена.Организация = ВыборкаДетальныеЗаписи.Организация; 
			ЗаписьСообщенияОбмена.ЛицевойСчет = ВыборкаДетальныеЗаписи.ЛицевойСчет;
			ЗаписьСообщенияОбмена.Документ = ВыборкаДетальныеЗаписи.Документ;
			ЗаписьСообщенияОбмена.ИдентификаторДокументаВПакете = ВыборкаДетальныеЗаписи.ИдентификаторДокументаВПакете;
			
			ЗаписьСообщенияОбмена.Прочитать();
			
			Если СтруктураОтвета.Статус = "SUCCESS" Тогда
				ЗаписьСообщенияОбмена.Обработано = Истина;
				ЗаписьСообщенияОбмена.РезультатОбработкиДокумента = "Загружен"; 
				// Записываем статус документа  
				Если НЕ ПлатежноРасчетныеДокументы.РСКПВКонечномСтатусе(ЗаписьСообщенияОбмена.Документ) Тогда
					ПлатежноРасчетныеДокументы.УстановитьСтатусРСКП(ЗаписьСообщенияОбмена.Документ, ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.НаИсполнении"));  
				КонецЕсли;
			ИначеЕсли СтруктураОтвета.Статус = "FAILURE" Тогда
				ЗаписьСообщенияОбмена.Обработано = Истина;
				ЗаписьСообщенияОбмена.ЕстьОшибка = Истина;
				ЗаписьСообщенияОбмена.РезультатОбработкиДокумента = "Отклонен";
				ЗаписьСообщенияОбмена.ТекстОшибки = ?(ЗначениеЗаполнено(СтруктураОтвета.ТекстОшибки), СтруктураОтвета.ТекстОшибки,"Описание ошибки отсутствует."); 
				// Записываем статус документа
				
				ТекущееСостояние = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ЗаписьСообщенияОбмена.Документ);
				МассивКонечныхСтатусов = ПлатежноРасчетныеДокументы.МассивКонечныхСтатусов();
				
				Если МассивКонечныхСтатусов.Найти(ТекущееСостояние.Статус) = Неопределено
					И ТекущееСостояние.Статус <> Перечисления.СтатусыИсполненияДокумента.НаИсполнении Тогда
					//если документ уже в конечном статусе - исполнен, аннулирован,
					//или в статусе на исполнении - то есть документ уже успешно загружен в ЕБП,
					//то сбрасывать статус смысла не имеет,
					//скорее всего пользователь как-то отправил документ еще раз, или это старый результат обработки, который уже не актуален
					ПлатежноРасчетныеДокументы.УстановитьСтатусРСКП(ЗаписьСообщенияОбмена.Документ, ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Подготовлен"));
				КонецЕсли;
			ИначеЕсли СтруктураОтвета.Статус = "PROCESSING" Тогда	
			    ЗаписьСообщенияОбмена.РезультатОбработкиДокумента = "В обработке, запросите результат позднее";
			КонецЕсли;
			
			ЗаписьСообщенияОбмена.Записать();
		КонецЕсли;
		
	КонецЦикла;
			
КонецПроцедуры

// Параметры:
//  ПараметрыОтправки - Структура  
//      * Организация - СправочникСсылка.
//      * ЛицевойСчет - СправочникСсылка.
//      * НастройкиУчастника - Фиксированная структура - адреса подключения к ЕСМВ Казначейства России 
//      	* АдресАвторизации - Строка.
//      	* АдресЗагрузкиФайлов - Строка.
//      	* АдресПередачиПакетов - Строка.
//      	* АдресЗапросаРезультатов - Строка.
//      	* АдресЗапросаДокументов - Строка.
//      	* АдресЗапросаФайлов - Строка.
//      	* Сертификат - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования. 
//      	* МодульИнтеграции - ПеречислениеСсылка.МодулиИнтеграции 
//      * НастройкиОбмена - Структура.
//      * ИмяПроцедурыОбмена - Строка.
//      * СписокДокументов - Массив. 
//      * ДатаНачалаЗапроса - Дата	
//      * ДатаОкончанияЗапроса - Дата
//      * ГУИДАвторизации - 
//      * ТребуетсяРасшифровка -  Булево
//      * ТокенАвторизации - Строка 
//
Процедура ЗапроситьДокументыИзЕСМВ(ПараметрыОтправки) Экспорт
	
	НастройкиУчастника = ПараметрыОтправки.НастройкиУчастника;    
	НастройкиОбмена = ПараметрыОтправки.НастройкиОбмена;  
	
	Если НастройкиУчастника.МодульИнтеграции = ПредопределенноеЗначение("Перечисление.МодулиИнтеграции.ЕБПАУБУ") Тогда
		МенеджерОбработки = ЖурналыДокументов.ВзаимодействияСЕБП;
	КонецЕсли;	
	
	ДДСертификата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкиУчастника.Сертификат, "ДанныеСертификата").Получить();
	СертификатКриптографии = Новый СертификатКриптографии(ДДСертификата);
	
	Попытка
		СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(НастройкиУчастника.АдресЗапросаДокументов);
	Исключение
		СтруктураАдреса = Новый Структура("Схема,Хост,Порт,ПутьНаСервере,Логин,Пароль","","","","","","");
	КонецПопытки;
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(СертификатКриптографии);
	Прокси = ЭкспортФайлов.ПолучитьПрокси("https");
	HTTPСоединение = Новый HTTPСоединение(СтруктураАдреса.Хост,,,,Прокси,100,ЗащищенноеСоединение);
	
	ЗаписьСообщенияЗапроса = РегистрыСведений.СообщенияЗапросаДокументовИзЕБП.СоздатьМенеджерЗаписи();
	ЗаписьСообщенияЗапроса.Организация = ПараметрыОтправки.Организация; 
	ЗаписьСообщенияЗапроса.ЛицевойСчет = ПараметрыОтправки.ЛицевойСчет;
	ЗаписьСообщенияЗапроса.ГУИД = Новый УникальныйИдентификатор;
	ЗаписьСообщенияЗапроса.ДатаОбмена = ТекущаяДатаСеанса();
	ЗаписьСообщенияЗапроса.ГУИДАвторизации = ПараметрыОтправки.ГУИДАвторизации;			 
	ЗаписьСообщенияЗапроса.ПериодЗапроса = Формат(ПараметрыОтправки.ДатаНачалаЗапроса, "ДФ=dd.MM.yyyy") + " - " + Формат(ПараметрыОтправки.ДатаОкончанияЗапроса, "ДФ=dd.MM.yyyy"); 				
	ИмяФорматаЗапросаДокументов = "docsRequest";
	
	ДополнительныеПараметрыЭкспорта = Новый Структура;
	ДополнительныеПараметрыЭкспорта.Вставить("ДатаНачалаЗапроса", ПараметрыОтправки.ДатаНачалаЗапроса);	
	ДополнительныеПараметрыЭкспорта.Вставить("ДатаОкончанияЗапроса", ПараметрыОтправки.ДатаОкончанияЗапроса);
	ДополнительныеПараметрыЭкспорта.Вставить("ЛицевойСчет", ПараметрыОтправки.ЛицевойСчет);
	
	ЕстьОшибка = Ложь;
	ДокСсылка = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка();
	Запрос = ПолучитьЗапросПоФормату(ПараметрыОтправки, ДокСсылка, ИмяФорматаЗапросаДокументов, Неопределено, СтруктураАдреса, ЕстьОшибка, ДополнительныеПараметрыЭкспорта);
	
	Если ЕстьОшибка = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Результат = ОтправитьPOSTЗапрос(HTTPСоединение,Запрос);
		//Результат = HTTPСоединение.ОтправитьДляОбработки(Запрос);
	Исключение
		ТекстСообщения = НСтр("ru='Не удалось отправить в ЕСМВ запрос документов по причине:
		|%1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ЕСМВ.Запрос документов", УровеньЖурналаРегистрации.Ошибка, Метаданные.ЖурналыДокументов.ВзаимодействияСЕБП, , ТекстСообщения);
		Возврат;
	КонецПопытки;
	
	ТекстЗапрос = ПолучитьТекстЗапроса(Запрос, СтруктураАдреса.ПутьНаСервере);
	
	ЗаписьСообщенияЗапроса.СообщениеЗапрос = Новый ХранилищеЗначения(ТекстЗапрос, Новый СжатиеДанных(9));
	
	ТекстОтвет = ПолучитьТекстОтвета(Результат);
	
	ЗаписьСообщенияЗапроса.СообщениеОтвет = Новый ХранилищеЗначения(ТекстОтвет, Новый СжатиеДанных(9));
	
	СтруктураОтвета = Новый Структура("Статус,ТекстОшибки");
	Если Результат.КодСостояния >= 200
		И Результат.КодСостояния < 300 Тогда
		// Успешно, разбор ответа
		
		ФорматИмпорта = БиблиотекаФункцийОбмена.ВернутьФорматПоМаркеру("PackageType",  НастройкиОбмена.ВидОбмена, Перечисления.НаправлениеОбменаБанкиКС.Импорт);
		
		ТекстТелаОтвета = Результат.ПолучитьТелоКакСтроку();
		
		ОбработкаОбменов = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
		ТаблицаДанных = ОбработкаОбменов.ЗагрузитьИзФайлаXML3(ТекстТелаОтвета, ФорматИмпорта, Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
		ТаблицаДанных.Сортировать("СлужебноеПоле_ИдентификаторСтроки");//чтобы шли по порядку
		
		НужнаОбработка = Истина;
		Если ТаблицаДанных.Колонки.Найти("ИдентификаторФХДокумента") = Неопределено Тогда
			НужнаОбработка = Ложь;
		КонецЕсли;	
		
		НуженОтборПоРПБС = Ложь;
		
		Если НужнаОбработка Тогда
			
			//Определяем код СВР (КодРПБС) по которому будем загружать файлы из ответа ЕБП
			РеквизитыЛС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОтправки.ЛицевойСчет,"КодПоРПБС,ИспользоватьДляСчетаУчетныйНомер");
			Если РеквизитыЛС.ИспользоватьДляСчетаУчетныйНомер Тогда
				КодРПБСОрганизации = СокрЛП(РеквизитыЛС.КодПоРПБС);
			Иначе			
				КодРПБСОрганизации = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтправки.Организация,"КодПоРПБС"));
			КонецЕсли;
			
			Если ТаблицаДанных.Колонки.Найти("ИдентификаторСообщения") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИдентификаторСообщения");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ИдентификаторДокумента") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИдентификаторДокумента");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ИдентификаторПроцесса") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИдентификаторПроцесса");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ТипДокумента") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ТипДокумента");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ИдентификаторФХВложения") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИдентификаторФХВложения");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ИмяФайла") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИмяФайла");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("Расширение") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("Расширение");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ТипВложения") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ТипВложения");
			КонецЕсли;
			
			НуженОтборПоРПБС = Истина;
			Если ТаблицаДанных.Колонки.Найти("КодПоРПБС") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("КодПоРПБС");
				НуженОтборПоРПБС = Ложь; //если не обновили форматы, в таблице может не быть такой колонки
			КонецЕсли;
			
			НуженОтборПоРПБС = НуженОтборПоРПБС И ЗначениеЗаполнено(КодРПБСОрганизации);
			
			МассивИдентификаторов = Новый Массив;
			
			КодРПБССтрТЧ = "";
			МассивЛишнихСтрок = Новый Массив;
			
			//Если в ЕБП один сертификат используется для нескольких организаций, при запросе документов из ЕБП,
			//не учитывается отбор по коду СВР (РПБС) организации, и возвращаются документы по всем организациям с этим сертификатом.
			//В тех.поддержке ЕБП обещали исправить.
			//Удалим строки с идентификаторами файлов по другим организациям.
			Для Каждого СтрТЧ Из ТаблицаДанных Цикл
				
				ЭтоРСКП = ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХДокумента);
				Если ЭтоРСКП Тогда
					КодРПБССтрТЧ = СтрТЧ.КодПоРПБС;
				КонецЕсли;	
				
				Если НуженОтборПоРПБС 
					И ЗначениеЗаполнено(КодРПБССтрТЧ)
					И КодРПБССтрТЧ <> КодРПБСОрганизации Тогда
					МассивЛишнихСтрок.Добавить(СтрТЧ);
					Продолжить;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХДокумента) Тогда
					МассивИдентификаторов.Добавить(СтрТЧ.ИдентификаторФХДокумента);	
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХВложения) Тогда
					МассивИдентификаторов.Добавить(СтрТЧ.ИдентификаторФХВложения);	
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого ЭлМас Из МассивЛишнихСтрок Цикл
				ТаблицаДанных.Удалить(ЭлМас);	
			КонецЦикла;
		
			ЗаписьСообщенияЗапроса.ИдентификаторыФХ = Новый ХранилищеЗначения(МассивИдентификаторов, Новый СжатиеДанных(9));
			ЗаписьСообщенияЗапроса.ЕстьДанные = МассивИдентификаторов.Количество();
		КонецЕсли;
		ЗаписьСообщенияЗапроса.Записать();    
		
		// Таблица требующих обработки файлов
		ФайлыКОбработке = Новый ТаблицаЗначений;
		ФайлыКобработке.Колонки.Добавить("ИдентификаторВФайловомХранилище", Новый ОписаниеТипов("Строка"));
		ФайлыКобработке.Колонки.Добавить("ИдентификаторВФХДокумента", Новый ОписаниеТипов("Строка"));
		ФайлыКобработке.Колонки.Добавить("РСКП"); //ссылка на загружаемый документ, соответствующий файлу 
		ФайлыКобработке.Колонки.Добавить("ЭтоВложение", Новый ОписаниеТипов("Булево")); 
		ФайлыКобработке.Колонки.Добавить("Расширение", Новый ОписаниеТипов("Строка"));
		
		// Запрос файлов
		Если НужнаОбработка Тогда
			Попытка
				СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(НастройкиУчастника.АдресЗапросаФайлов);
			Исключение
				СтруктураАдреса = Новый Структура("Схема,Хост,Порт,ПутьНаСервере,Логин,Пароль","","","","","","");
			КонецПопытки;
			
			ДокументРСКПККоторомуОтноситсяФайл = Неопределено; 
			ИдентификаторВФХДокумента = "";
			
			Для Каждого СтрТЧ Из ТаблицаДанных Цикл
				Если НЕ ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХДокумента)
					И НЕ ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХВложения) Тогда
					Продолжить;
				КонецЕсли;
				
				ЭтоРСКП = ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХДокумента);
				
				ТекущийИдентификаторФХ = ?(ЭтоРСКП, СтрТЧ.ИдентификаторФХДокумента, СтрТЧ.ИдентификаторФХВложения);
							
				Если ЭтоРСКП Тогда//определяем РСКП к которому относится файл, т.к. могут быть файлы вложений
					ДокументРСКПККоторомуОтноситсяФайл = Неопределено;
					ДокументРСКПККоторомуОтноситсяФайл = ПолучитьДокументПоИдентификаторуДокумента(СтрТЧ.ИдентификаторДокумента);
					ИдентификаторВФХДокумента = СтрТЧ.ИдентификаторФХДокумента; 
				КонецЕсли;
				
				Если ФайлЗагруженВБазу(ТекущийИдентификаторФХ) Тогда
					Продолжить;
				КонецЕсли;
				
				ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(СертификатКриптографии);
				Прокси = ЭкспортФайлов.ПолучитьПрокси("https");
				HTTPСоединение = Новый HTTPСоединение(СтруктураАдреса.Хост,,,, Прокси, 100, ЗащищенноеСоединение);
				
				АдресРесурса = СтрЗаменить(СтруктураАдреса.ПутьНаСервере, "{fileId}", ТекущийИдентификаторФХ);
				
				Заголовки = Новый Соответствие;
				Заголовки.Вставить("Host", СтруктураАдреса.Хост);
				Заголовки.Вставить("Authorization", ПараметрыОтправки.ТокенАвторизации);
				
				HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса, Заголовки);
				
				Попытка
					РезультатСФайлом = ОтправитьGETЗапрос(HTTPСоединение,HTTPЗапрос);
					//РезультатСФайлом = HTTPСоединение.Получить(HTTPЗапрос);
				Исключение
					ТекстСообщения = НСтр("ru='Не удалось получить из файлового хранилища ЕСМВ документ с идентификатором %1:
					|%2'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекущийИдентификаторФХ, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ЕСМВ.Загрузка файлов из ФХ ЕСМВ", УровеньЖурналаРегистрации.Ошибка, Метаданные.ЖурналыДокументов.ВзаимодействияСЕБП, , ТекстСообщения);
					Отказ = Истина;
					Возврат;
				КонецПопытки;
				
				Если РезультатСФайлом.КодСостояния >= 200
					И РезультатСФайлом.КодСостояния < 300 Тогда
					ЗаписьЗагруженногоФайла = РегистрыСведений.ЗагруженныеФайлыИзЕБП.СоздатьМенеджерЗаписи();
					ЗаписьЗагруженногоФайла.ДатаОбмена = ТекущаяДатаСеанса();
					ЗаписьЗагруженногоФайла.ИдентификаторВФайловомХранилище = ТекущийИдентификаторФХ; 
					ЗаписьЗагруженногоФайла.ИдентификаторВФХДокумента = ИдентификаторВФХДокумента;
					ЗаписьЗагруженногоФайла.ЭтоВложение = (ЭтоРСКП = Ложь);
					ЗаписьЗагруженногоФайла.ДвоичныеДанныеФайла = Новый ХранилищеЗначения(РезультатСФайлом.ПолучитьТелоКакДвоичныеДанные(), Новый СжатиеДанных(9));
					ЗаписьЗагруженногоФайла.РСКП = ДокументРСКПККоторомуОтноситсяФайл;
					Если ЭтоРСКП Тогда
						
						РасширениеПоУмолчанию = "xml";
						Если ВРег(СтрТЧ.ТипДокумента) = "REP_EBP_VLS" Тогда
							// Выписка передается как архив
							РасширениеПоУмолчанию = "zip";
						Иначе
							ТипИзЗаголовка = ПолучитьЗаголовокИзОтвета(РезультатСФайлом, "Content-Type");
							Если ТипИзЗаголовка<> Неопределено Тогда
								Если НРег(ТипИзЗаголовка) = "application/zip" Тогда
									РасширениеПоУмолчанию = "zip";
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
						
						ЗаписьЗагруженногоФайла.ИмяФайла = СтрТЧ.ТипДокумента;
						ЗаписьЗагруженногоФайла.Расширение = РасширениеПоУмолчанию;
					Иначе
						ЗаписьЗагруженногоФайла.ИмяФайла = СтрТЧ.ИмяФайла;
						ЗаписьЗагруженногоФайла.Расширение = СтрТЧ.Расширение;
					КонецЕсли;
					ЗаписьЗагруженногоФайла.Записать(); 
					
					КОбработке = ФайлыКОбработке.Добавить();
					ЗаполнитьЗначенияСвойств(КОбработке, ЗаписьЗагруженногоФайла); 
				Иначе
					// Не удалось скачать файл, надо сохранить лог обмена
					
					ТекстСообщения = НСтр("ru='При скачивании файлов из ЕСМВ возникла ошибка. Подробнее в файле ответа на запрос файла.'");
					ЗаписьСообщенияЗапроса.ЕстьОшибка = Истина;
					ЗаписьСообщенияЗапроса.ТекстОшибки = ТекстСообщения;
					
					ЗаписьСообщенияЗапроса.СообщениеЗапросаФайлаЗапрос = Новый ХранилищеЗначения(ПолучитьТекстЗапроса(HTTPЗапрос,АдресРесурса), Новый СжатиеДанных(9));
					ЗаписьСообщенияЗапроса.СообщениеЗапросаФайлаОтвет = Новый ХранилищеЗначения(ПолучитьТекстОтвета(РезультатСФайлом), Новый СжатиеДанных(9));
					ЗаписьСообщенияЗапроса.Записать();
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				КонецЕсли;
				
			КонецЦикла; 
			
			МенеджерОбработки.ОбработатьЗагруженныеФайлыЕСМВ(ФайлыКОбработке, НастройкиОбмена.ВидОбмена,  ПараметрыОтправки.Организация, ПараметрыОтправки.ЛицевойСчет);
			
		КонецЕсли; // нужна обработка
		
	Иначе
		ЗаписьСообщенияЗапроса.ЕстьОшибка = Истина;
		ТекстСообщения = НСтр("ru='При запросе документов из ЕСМВ возникла ошибка. Подробнее в файле ответа запроса документов.'");
		ЗаписьСообщенияЗапроса.ТекстОшибки = ТекстСообщения;
		ЗаписьСообщенияЗапроса.Записать();
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьКлючЗаписиНастройкиОрганизаций(Организация) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НастройкиОрганизацийДляОбменаЕСМВ.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.НастройкиОрганизацийДляОбменаЕСМВ КАК НастройкиОрганизацийДляОбменаЕСМВ
	|ГДЕ
	|	НастройкиОрганизацийДляОбменаЕСМВ.Организация = &Организация");
	Запрос.УстановитьПараметр("Организация", Организация); 
	
	Если Запрос.Выполнить().Пустой() Тогда 
		Возврат Неопределено;
	КонецЕсли;	
	
	КлючЗаписи = Новый Структура("Организация", Организация);	
	Возврат РегистрыСведений.НастройкиОрганизацийДляОбменаЕСМВ.СоздатьКлючЗаписи(КлючЗаписи);
	
КонецФункции


// Параметры:
//  ПараметрыОтправки - Структура  
//      * Организация - СправочникСсылка.
//      * ЛицевойСчет - СправочникСсылка.
//      * НастройкиУчастника - Структура.
//      * НастройкиОбмена - Структура.
//      * ИмяПроцедурыОбмена - Строка.
//      * СписокДокументов - Массив.
//      * ФормаИсточник - УправляемаяФорма. 
//      * ГУИДАвторизации - 
//      * ТребуетсяРасшифровка -  Булево
//      * ТокенАвторизации - Строка 
//
Процедура ОтправитьПакетЕСМВ(ПараметрыОтправки, ИдентификаторПакета, ТекстДокументов, МассивДокументовДляПакета, СертификатКриптографии)
	
	НастройкиУчастника = ПараметрыОтправки.НастройкиУчастника;
	НастройкиОбмена = ПараметрыОтправки.НастройкиОбмена;
	ТокенАвторизации = ПараметрыОтправки.ТокенАвторизации;  
	Организация = ПараметрыОтправки.Организация;
	ЛицевойСчет = ПараметрыОтправки.ЛицевойСчет;
	
	Попытка
		СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(НастройкиУчастника.АдресПередачиПакетов);
	Исключение
		СтруктураАдреса = Новый Структура("Схема,Хост,Порт,ПутьНаСервере,Логин,Пароль","","","","","","");
	КонецПопытки;
	
	// АдресРесурса = "/api/rest-adapter/xml/integration/import"; 
	
	Прокси = ЭкспортФайлов.ПолучитьПрокси("https");
	
	Если НастройкиУчастника.МодульИнтеграции = ПредопределенноеЗначение("Перечисление.МодулиИнтеграции.ЕБПАУБУ") Тогда
    	ИмяФормата = "package_for_all";
	КонецЕсли;
	
	Отмена = Ложь;
	
	ДополнительныеПараметрыФорматов = Новый Структура;
	ДополнительныеПараметрыФорматов.Вставить("packageId", ИдентификаторПакета);
		
	Запрос = ПолучитьЗапросДляПакетаПоФормату(ПараметрыОтправки, Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка(), ИмяФормата, ТекстДокументов, СтруктураАдреса, Отмена, ДополнительныеПараметрыФорматов);
	
	Если Отмена = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьСообщенияПакета = РегистрыСведений.ПакетыДокументовОбменаЕБП.СоздатьМенеджерЗаписи();
	ЗаписьСообщенияПакета.ИдентификаторПакета = ИдентификаторПакета;
	ЗаписьСообщенияПакета.ДатаОбмена = ТекущаяДатаСеанса();
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(СертификатКриптографии);
	HTTPСоединение = Новый HTTPСоединение(СтруктураАдреса.Хост,,,,Прокси,100,ЗащищенноеСоединение);
	
	ТекстЗапрос = ПолучитьТекстЗапроса(Запрос, СтруктураАдреса.ПутьНаСервере);
	
	ЗаписьСообщенияПакета.ПередачаПакетаЗапрос = Новый ХранилищеЗначения(ТекстЗапрос, Новый СжатиеДанных(9));
	
	Попытка
		Результат = ОтправитьPOSTЗапрос(HTTPСоединение,Запрос);
    	//Результат = HTTPСоединение.ОтправитьДляОбработки(Запрос);
	Исключение
		ТекстСообщения = НСтр("ru='Не удалось отправить в ЕСМВ пакет по причине:
		|%1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ЕСМВ.Передача файла", УровеньЖурналаРегистрации.Ошибка, Метаданные.ЖурналыДокументов.ВзаимодействияСЕБП, Неопределено, ТекстСообщения);
		Отмена = Истина;
		
		ЗаписьСообщенияПакета.ЕстьОшибка = Истина;
		ЗаписьСообщенияПакета.РезультатОтправкиПакета = "Ошибка";
		ЗаписьСообщенияПакета.ТекстОшибки = НСтр("ru='При передаче пакета возникла ошибка. Подробнее в журнале регистрации.'");
		ЗаписьСообщенияПакета.Записать();
		
		Возврат;
	КонецПопытки;
			
	ТекстОтвет = ПолучитьТекстОтвета(Результат);
	
	ЗаписьСообщенияПакета.ПередачаПакетаОтвет = Новый ХранилищеЗначения(ТекстОтвет, Новый СжатиеДанных(9));
		
	СтруктураОтвета = Новый Структура("Статус,ТекстОшибки"); 
	
	Если Результат.КодСостояния >= 200
		И Результат.КодСостояния < 300 Тогда
		
		ФорматИмпорта = БиблиотекаФункцийОбмена.ВернутьФорматПоМаркеру("PackageLoadReceiptType",  НастройкиОбмена.ВидОбмена, Перечисления.НаправлениеОбменаБанкиКС.Импорт);
		
		ТекстТелаОтвета = Результат.ПолучитьТелоКакСтроку();
		
		ОбработкаОбменов = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
		ТаблицаДанных = ОбработкаОбменов.ЗагрузитьИзФайлаXML3(ТекстТелаОтвета, ФорматИмпорта, Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
		
		НужнаОбработка = Истина;
		Если ТаблицаДанных.Колонки.Найти("ИдентификаторСообщения") = Неопределено Тогда
			НужнаОбработка = Ложь;
		КонецЕсли;
		
		Если НужнаОбработка Тогда
			Если ТаблицаДанных.Колонки.Найти("ИдентификаторСообщения") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИдентификаторСообщения");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ИдентификаторДокумента") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИдентификаторДокумента");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ИдентификаторПакета") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИдентификаторПакета");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("Статус") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("Статус");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("УровеньОшибки") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("УровеньОшибки");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("НаименованиеОшибки") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("НаименованиеОшибки");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ОписаниеОшибки") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ОписаниеОшибки");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ПолныйТекстОшибки") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ПолныйТекстОшибки");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("КодОшибки") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("КодОшибки");
			КонецЕсли;
			
			МассивСтрокОшибок = ТаблицаДанных.НайтиСтроки(Новый Структура("СлужебноеПоле_ТабличнаяЧасть", "ТАБЛИЦАОШИБОК"));
			
			Для Каждого СтрТЧ Из ТаблицаДанных Цикл
				
				Если ЗначениеЗаполнено(СтрТЧ.ИдентификаторДокумента) Тогда
					ЗаписьСообщенияОбмена = РегистрыСведений.СообщенияОбменаДаннымиЕБП.СоздатьМенеджерЗаписи();
					ЗаписьСообщенияОбмена.Организация = Организация;  
					ЗаписьСообщенияОбмена.ЛицевойСчет = ЛицевойСчет;
					ЗаписьСообщенияОбмена.Документ = ПолучитьДокументПоИдентификаторуДокумента(СтрТЧ.ИдентификаторДокумента);
					ЗаписьСообщенияОбмена.ИдентификаторДокументаВПакете = Новый УникальныйИдентификатор(СтрТЧ.ИдентификаторДокумента);
				
					ЗаписьСообщенияОбмена.Прочитать();
				
					Если СтрТЧ.Статус = "SUCCESS" Тогда
						ЗаписьСообщенияОбмена.Обработано = Истина;
						ЗаписьСообщенияОбмена.РезультатОбработкиДокумента = "Загружен"; 
						// Записываем статус документа 
						ПлатежноРасчетныеДокументы.УстановитьСтатусРСКП(ЗаписьСообщенияОбмена.Документ, ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.НаИсполнении"));
						
					ИначеЕсли СтрТЧ.Статус = "FAILURE" Тогда
						ЗаписьСообщенияОбмена.Обработано = Истина;
						ЗаписьСообщенияОбмена.ЕстьОшибка = Истина;
						ЗаписьСообщенияОбмена.РезультатОбработкиДокумента = "Отклонен";
						
						ТекстОшибки = ПолучитьТекстОшибкиИзТаблицы(МассивСтрокОшибок, СтрТЧ.СлужебноеПоле_ИдентификаторСтроки);
											
						ЗаписьСообщенияОбмена.ТекстОшибки = ТекстОшибки;
						
						ТекстСообщения = НСтр("ru='При загрузке в ЕБП документа %1 возникла ошибка:
							|%2'");
						
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ЗаписьСообщенияОбмена.Документ,ТекстОшибки);
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
						
						// Записываем статус документа 
						ПлатежноРасчетныеДокументы.УстановитьСтатусРСКП(ЗаписьСообщенияОбмена.Документ, ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Подготовлен")); 
						
					ИначеЕсли СтрТЧ.Статус = "PROCESSING" Тогда
						ПлатежноРасчетныеДокументы.УстановитьСтатусРСКП(ЗаписьСообщенияОбмена.Документ, ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.ПереданВОбработку"));
					    ЗаписьСообщенияОбмена.РезультатОбработкиДокумента = "В обработке";
					
					КонецЕсли;
				
					ЗаписьСообщенияОбмена.Записать();
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		ЗаписьСообщенияПакета.ПередачаПакетаУспешно = Истина;
		ЗаписьСообщенияПакета.РезультатОтправкиПакета = "Отправлен";

	Иначе
		ТекстОшибки = НСтр("ru='При передаче пакета возникла ошибка. Подробнее в файлах передачи пакета.'");
		ЗаписьСообщенияПакета.ЕстьОшибка = Истина;
		ЗаписьСообщенияПакета.РезультатОтправкиПакета = "Ошибка";
		ЗаписьСообщенияПакета.ТекстОшибки = ТекстОшибки;
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
		
	ЗаписьСообщенияПакета.Записать();

КонецПроцедуры

Функция ПолучитьЗапросПоФормату(ПараметрыОтправки, ДокСсылка, ИмяФормата, ИдентификаторСообщенияФайла, СтруктураАдреса, Отмена, ДополнительныеПараметрыФорматов = Неопределено)
	
	НастройкиОбмена = ПараметрыОтправки.НастройкиОбмена;
	ТокенАвторизации = ПараметрыОтправки.ТокенАвторизации;
	Организация = ПараметрыОтправки.Организация;

	ТелоЗапроса = ПолучитьТекстПоФормату(НастройкиОбмена, ИмяФормата, ИдентификаторСообщенияФайла, ДокСсылка, Организация, Отмена, ДополнительныеПараметрыФорматов);

	Если Отмена = Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Host", СтруктураАдреса.Хост);
	Заголовки.Вставить("Authorization", ТокенАвторизации);
	Заголовки.Вставить("Content-Type", "application/xml");
	
	Запрос = Новый HTTPЗапрос(СтруктураАдреса.ПутьНаСервере,Заголовки);
	
	Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
	
	Возврат Запрос;
	
КонецФункции

// Параметры:
//  ПараметрыОтправки - Структура  
//      * Организация - СправочникСсылка.
//      * ЛицевойСчет - СправочникСсылка.
//      * НастройкиУчастника - Структура.
//      * НастройкиОбмена - Структура.
//      * ИмяПроцедурыОбмена - Строка.
//      * СписокДокументов - Массив.
//      * ФормаИсточник - УправляемаяФорма. 
//      * ГУИДАвторизации - 
//      * ТребуетсяРасшифровка -  Булево
//      * ТокенАвторизации -  Строка
//
Функция ПолучитьЗапросДляПакетаПоФормату(ПараметрыОтправки, ДокСсылка, ИмяФормата, ТекстДокументовПакета, СтруктураАдреса, Отмена, ДополнительныеПараметрыФорматов = Неопределено)
	
	НастройкиОбмена = ПараметрыОтправки.НастройкиОбмена;
	ТокенАвторизации = ПараметрыОтправки.ТокенАвторизации;
	Организация = ПараметрыОтправки.Организация;
	
	ТелоЗапроса = ПолучитьТекстПоФормату(НастройкиОбмена, ИмяФормата, "", ДокСсылка, Организация, Отмена, ДополнительныеПараметрыФорматов);
	
	Если Отмена = Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТелоЗапроса = СтрЗаменить(ТелоЗапроса,"%ДокументыПакета%", ТекстДокументовПакета);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Host", СтруктураАдреса.Хост);
	Заголовки.Вставить("Authorization", ТокенАвторизации);
	Заголовки.Вставить("Content-Type", "application/xml");
	
	Запрос = Новый HTTPЗапрос(СтруктураАдреса.ПутьНаСервере,Заголовки);
	
	Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
	
	Возврат Запрос;  
	
КонецФункции

// Параметры:
//  ПараметрыОтправки - Структура  
//      * Организация - СправочникСсылка.
//      * ЛицевойСчет - СправочникСсылка.
//      * НастройкиУчастника - Структура.
//      * НастройкиОбмена - Структура.
//      * ИмяПроцедурыОбмена - Строка.
//      * СписокДокументов - Массив.
//      * ФормаИсточник - УправляемаяФорма. 
//      * ГУИДАвторизации - 
//      * ТребуетсяРасшифровка -  Булево
//      * ТокенАвторизации -  Строка
//
Функция ОтправитьФайлПоДокументу(ПараметрыОтправки, ЗаписьСообщения, СертификатКриптографии, Отмена)   
	
	НастройкиУчастника = ПараметрыОтправки.НастройкиУчастника;
	
	//Адрес = "https://<сервер>/api/rest-adapter/xml/integration-files/upload"; 
	//Сервер тестовый = "ebp01.roskazna.ru";
	//Сервер промышленный = "finance.gov.ru";
	//АдресРесурса = "/api/rest-adapter/xml/integration-files/upload";
	
	Попытка
		СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(НастройкиУчастника.АдресЗагрузкиФайлов);
	Исключение
		СтруктураАдреса = Новый Структура("Схема,Хост,Порт,ПутьНаСервере,Логин,Пароль","","","","","","");
	КонецПопытки;
	
	Запрос = ПолучитьЗапросОтправкиФайла(ПараметрыОтправки, СтруктураАдреса, ЗаписьСообщения.Документ, Отмена);  
	
	Если Отмена = Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Прокси = ЭкспортФайлов.ПолучитьПрокси("https");

	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(СертификатКриптографии);
	HTTPСоединение = Новый HTTPСоединение(СтруктураАдреса.Хост,,,, Прокси, 100, ЗащищенноеСоединение);
	
	Попытка
		Результат = ОтправитьPOSTЗапрос(HTTPСоединение,Запрос);
    	//Результат = HTTPСоединение.ОтправитьДляОбработки(Запрос);
	Исключение
		ТекстСообщения = НСтр("ru='Не удалось отправить в ЕСМВ файл по документу по причине:
		|%1'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ЕСМВ.Передача файла", УровеньЖурналаРегистрации.Ошибка, Метаданные.ЖурналыДокументов.ВзаимодействияСЕБП, ЗаписьСообщения.Документ, ТекстСообщения);
		Отмена = Истина;
		Возврат Неопределено;
	КонецПопытки;
		
	ТекстЗапрос = ПолучитьТекстЗапроса(Запрос, СтруктураАдреса.ПутьНаСервере);
	
	ЗаписьСообщения.ПередачаФайлаЗапрос = Новый ХранилищеЗначения(ТекстЗапрос, Новый СжатиеДанных(9));
	
	ТекстОтвет = ПолучитьТекстОтвета(Результат);
	
	ЗаписьСообщения.ПередачаФайлаОтвет = Новый ХранилищеЗначения(ТекстОтвет, Новый СжатиеДанных(9));
	
	Текст = Результат.ПолучитьТелоКакСтроку();
	ИдентификаторСообщенияФайла = ПолучитьИдентификаторСообщенияФайла(Текст);
	
	Если Результат.КодСостояния >= 200
		И Результат.КодСостояния < 300
		И ЗначениеЗаполнено(ИдентификаторСообщенияФайла) Тогда
		ЗаписьСообщения.ПередачаФайлаУспешно = Истина;	
	Иначе
		ЗаписьСообщения.ЕстьОшибка = Истина;
		ЗаписьСообщения.ТекстОшибки = НСтр("ru='Не удалось отправить файл. Подробнее в файле ответа сервера передачи файла.'");
	КонецЕсли;
	
	ЗаписьСообщения.Записать();
	
	Возврат ИдентификаторСообщенияФайла;
	
КонецФункции

// Параметры:
//  ПараметрыОтправки - Структура  
//      * Организация - СправочникСсылка.
//      * ЛицевойСчет - СправочникСсылка.
//      * НастройкиУчастника - Структура.
//      * НастройкиОбмена - Структура.
//      * ИмяПроцедурыОбмена - Строка.
//      * СписокДокументов - Массив.
//      * ФормаИсточник - УправляемаяФорма. 
//      * ГУИДАвторизации - 
//      * ТребуетсяРасшифровка -  Булево
//      * ТокенАвторизации -  Строка
//
Функция ПолучитьЗапросОтправкиФайла(ПараметрыОтправки, СтруктураАдреса, Знач ДокументСсылка, Отмена)  
	
	НастройкиУчастника = ПараметрыОтправки.НастройкиУчастника;
	НастройкиОбмена = ПараметрыОтправки.НастройкиОбмена;
	ТокенАвторизации = ПараметрыОтправки.ТокенАвторизации;
	Организация = ПараметрыОтправки.Организация;
	
	ИмяФормата = ПолучитьИмяФорматаПоДокументу(ДокументСсылка, НастройкиУчастника.МодульИнтеграции, НастройкиОбмена);
	
	ТекстПеречисления = ПолучитьТекстПоФормату(НастройкиОбмена, ИмяФормата, "", ДокументСсылка, Организация, Отмена);
	
	Если Отмена = Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Поток = Новый ПотокВПамяти;
	ЗаписьТекста = Новый ЗаписьТекста(Поток);
	ЗаписьТекста.Записать(ТекстПеречисления);
	ЗаписьТекста.Закрыть();
	
	ДвоичныеДанные = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	
	Разделитель = "----" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Host", СтруктураАдреса.Хост);
	Заголовки.Вставить("Authorization", ТокенАвторизации);
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Разделитель);
	
	Запрос = Новый HTTPЗапрос(СтруктураАдреса.ПутьНаСервере, Заголовки);
	
	Тело = Новый ПотокВПамяти();

	ЗаписьДанных = Новый ЗаписьДанных(Тело,,, Символы.ВК + Символы.ПС, "");   

	ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель);   	 

	ЗаписьДанных.ЗаписатьСтроку("Content-Disposition: form-data; name=""file""; filename=""file.xml""");
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.Записать(ДвоичныеДанные);
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель+"--");
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.Закрыть();
	
	ДанныеТела = Тело.ЗакрытьИПолучитьДвоичныеДанные();
	Запрос.УстановитьТелоИзДвоичныхДанных(ДанныеТела);
	
	Возврат Запрос; 
	
КонецФункции

// Параметры:
//  ПараметрыОтправки - Структура  
//      * Организация - СправочникСсылка.
//      * ЛицевойСчет - СправочникСсылка.
//      * НастройкиУчастника - Структура.
//      * НастройкиОбмена - Структура.
//      * ИмяПроцедурыОбмена - Строка.
//      * СписокДокументов - Массив.
//      * ФормаИсточник - УправляемаяФорма. 
//      * ГУИДАвторизации - 
//      * ТребуетсяРасшифровка -  Булево
//      * ТокенАвторизации -  Строка
//
Функция ПолучитьТекстПоФормату(НастройкиОбмена, Знач ИмяФормата, Знач ТекИдентификаторСообщения, Знач ДокументСсылка, Знач Организация, Отмена, ДополнительныеПараметрыФорматов = Неопределено)
	
	Перем ОбработкаФормирования; 
	Перем ОбщОбъектыОбмена; 
	Перем СтрокаОбмена; 
	Перем СтруктураДляФормирования; 
	Перем ФорматЭкспорта;   
	
	ИмяДокумента = ДокументСсылка.Метаданные().Имя;
	
	ФорматЭкспорта = ПолучитьФормат(ИмяФормата, ИмяДокумента, НастройкиОбмена.НастройкаФорматов);
	
	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		ТекстСообщения = НСтр("ru='Для организации ""%1"" в настройке форматов участника обмена отсутствует формат ""%2"".
		|Не удалось сформировать сообщение обмена. 
		|Невозможно выполнить обмен.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Организация, ИмяФормата);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отмена);
		Возврат "";		
	КонецЕсли;
	
	СтруктураДляФормирования = Новый Структура; 
	СтруктураДляФормирования.Вставить("КассовыйОрган"); // Не используется
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиОбмена.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", Справочники.НастройкиОбменаБанкиКС.ПустаяСсылка());
	СтруктураДляФормирования.Вставить("Организация", Организация);
	СтруктураДляФормирования.Вставить("Ссылка", Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	
	ОбщОбъектыОбмена = Новый ТаблицаЗначений;
	ОбщОбъектыОбмена.Колонки.Добавить("ОписаниеОшибки");
	ОбщОбъектыОбмена.Колонки.Добавить("ИмяФайлаВыгрузки");
	ОбщОбъектыОбмена.Колонки.Добавить("Формат");
	ОбщОбъектыОбмена.Колонки.Добавить("Объект");
	ОбщОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	СтрокаОбмена = ОбщОбъектыОбмена.Добавить();
	СтрокаОбмена.Объект = ДокументСсылка;
	СтрокаОбмена.Формат = ФорматЭкспорта;			
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена", ОбщОбъектыОбмена);	
	
	ОбработкаФормирования = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();  
	ОбработкаФормирования.ИдентификаторСообщения = ТекИдентификаторСообщения;
	ОбработкаФормирования.мОрганизация = Организация;
	ОбработкаФормирования.СоответствиеОбработанныхФорматов = Неопределено;
	ОбработкаФормирования.ДополнительныеПараметрыЭкспорта = ДополнительныеПараметрыФорматов;
	ОбработкаФормирования.СформироватьФайлы(СтруктураДляФормирования);
	
	РезультатФормирования = "";
	ТаблицаОписанияОшибокСтрокой = "";
	Для Каждого СтрокаОбмена Из СтруктураДляФормирования.ОбъектыОбмена Цикл 
		РезультатФормирования = СтрокаОбмена.РезультатФормирования;
		ТаблицаОписанияОшибокСтрокой = СтрокаОбмена.ОписаниеОшибки;
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(РезультатФормирования) Тогда
		ПричинаОшибок = "";
		Если ЗначениеЗаполнено(ТаблицаОписанияОшибокСтрокой) Тогда
			ТаблицаОписанияОшибок = ЗначениеИзСтрокиВнутр(ТаблицаОписанияОшибокСтрокой);
			МассивСтрокОшибок = Новый Массив;
			Для Каждого СтрТЧ Из ТаблицаОписанияОшибок Цикл
				СтрокаОшибки = "";
				Если ЗначениеЗаполнено(СтрТЧ.ПолеФайла) Тогда
					СтрокаОшибки = "Поле файла: "+СтрТЧ.ПолеФайла+". ";
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрТЧ.Ошибка) Тогда
					СтрокаОшибки = СтрокаОшибки +"Описание ошибки: "+СтрТЧ.Ошибка;
				КонецЕсли;
				МассивСтрокОшибок.Добавить(СтрокаОшибки);
			КонецЦикла;
			ПричинаОшибок = СтрСоединить(МассивСтрокОшибок,Символы.ПС);
		КонецЕсли;
		ТекстСообщения = НСтр("ru='Не удалось сформивовать xml файл по документу ""%1"" по причине:
		|%2
		|Невозможно выполнить обмен.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ДокументСсылка,ПричинаОшибок);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,,, Отмена); 
	КонецЕсли;
	
	Возврат РезультатФормирования; 
	
КонецФункции

Функция ПолучитьФормат(ИмяФормата, ИмяДокумента, НастройкаФорматов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НастройкаФормата", НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ." + ИмяДокумента);
	Запрос.УстановитьПараметр("ИмяФормата", ИмяФормата);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
	|ИЗ
	|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
	|ГДЕ
	|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
	|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя
	|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.Наименование = &ИмяФормата";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ФорматЭкспорта;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьИмяФорматаПоДокументу(ДокументСсылка, МодульИнтеграции, НастройкиОбмена, ФорматПакет = Ложь)
	ИмяФормата = "";
	ТипДокумента = ТипЗнч(ДокументСсылка); 
	
	Если МодульИнтеграции = ПредопределенноеЗначение("Перечисление.МодулиИнтеграции.ЕБПАУБУ") Тогда
		Если ФорматПакет Тогда
			Если ТипДокумента = Тип("ДокументСсылка.РСКППеречисление") Тогда
				ИмяФормата = "package_RSKP_perech"; 
			ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РСКППеречислениеМир") Тогда
				ИмяФормата = "package_RSKP_MIR";
			КонецЕсли;	
		Иначе 
			ИдентификаторОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипДокумента);
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	СписокФорматовНастройкиОбменаБанкиКС.Формат.Наименование КАК ФорматНаименование
			|ИЗ
			|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
			|ГДЕ
			|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
			|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта = &ИдентификаторОбъекта
			|	И (ВЫРАЗИТЬ(СписокФорматовНастройкиОбменаБанкиКС.Формат.УсловиеИспользованияФормата КАК СТРОКА(1))) = "" """);
			Запрос.УстановитьПараметр("НастройкаФормата", НастройкиОбмена.НастройкаФорматов);
			Запрос.УстановитьПараметр("ИдентификаторОбъекта", ИдентификаторОбъекта); 
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ИмяФормата = Выборка.ФорматНаименование;
			КонецЕсли;	
		КонецЕсли;		
		Если НЕ ЗначениеЗаполнено(ИмяФормата) Тогда		
			ТекстСообщения = НСтр("ru='Для документа %1 не в настройке форматов участника обмена с ЕБП отсутствует формат экспорта'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ТипДокумента);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли; 
	КонецЕсли;
	
	Возврат ИмяФормата;
КонецФункции

// Параметры:
//  ПараметрыОтправки - Структура  
//      * Организация - СправочникСсылка.
//      * ЛицевойСчет - СправочникСсылка.
//      * НастройкиУчастника - Структура.
//      * НастройкиОбмена - Структура.
//      * ИмяПроцедурыОбмена - Строка.
//      * СписокДокументов - Массив.
//      * ФормаИсточник - УправляемаяФорма. 
//      * ГУИДАвторизации - 
//      * ТребуетсяРасшифровка -  Булево
//      * ТокенАвторизации -  Строка
//
Процедура ОтправитьПриложенныеФайлыПоДокументу(ПараметрыОтправки, ЗаписьСообщения, ДокОбъект, СертификатКриптографии, Отмена)
	
	НастройкиУчастника = ПараметрыОтправки.НастройкиУчастника;
	ТокенАвторизации = ПараметрыОтправки.ТокенАвторизации;
	
	// Адрес = "https://<сервер>/api/rest-adapter/xml/integration-files/upload"; 
	// Сервер тестовый = "ebp01.roskazna.ru";
	// Сервер промышленный = "finance.gov.ru";
	// АдресРесурса = "/api/rest-adapter/xml/integration-files/upload";
	
	Попытка
		СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(НастройкиУчастника.АдресЗагрузкиФайлов);
	Исключение
		СтруктураАдреса = Новый Структура("Схема,Хост,Порт,ПутьНаСервере,Логин,Пароль","","","","","","");
	КонецПопытки;
	
	Прокси = ЭкспортФайлов.ПолучитьПрокси("https");
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(СертификатКриптографии);
	HTTPСоединение = Новый HTTPСоединение(СтруктураАдреса.Хост,,,, Прокси, 100, ЗащищенноеСоединение);
		
	МассивСообщенийЗапросов = Новый Массив;
	МассивСообщенийОтветов = Новый Массив;
	
	// Работает только для документа РСКП (перечисление).
	// При появлении вложений к другим документам потребуются доработки
	МассивФайлов = Новый Массив;
	Для Каждого СтрТЧ Из ДокОбъект.ФайлыПриложения Цикл
		Если ЗначениеЗаполнено(СтрТЧ.ПрисоединенныйФайл) Тогда
			МассивФайлов.Добавить(СтрТЧ.ПрисоединенныйФайл);
		КонецЕсли;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РСКППеречислениеПрисоединенныеФайлы.Ссылка КАК Ссылка,
		|	РСКППеречислениеПрисоединенныеФайлы.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.РСКППеречислениеПрисоединенныеФайлы КАК РСКППеречислениеПрисоединенныеФайлы
		|ГДЕ
		|	РСКППеречислениеПрисоединенныеФайлы.Ссылка В(&МассивФайлов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Файлы.Ссылка,
		|	Файлы.ПометкаУдаления
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|ГДЕ
		|	Файлы.Ссылка В(&МассивФайлов)";
	
	Запрос.УстановитьПараметр("МассивФайлов", МассивФайлов);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	СоответствиеПометкиУдаленияФайлов = Новый Соответствие;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СоответствиеПометкиУдаленияФайлов.Вставить(ВыборкаДетальныеЗаписи.Ссылка, ВыборкаДетальныеЗаписи.ПометкаУдаления);
	КонецЦикла;	
	
	Для Каждого СтрТЧ Из ДокОбъект.ФайлыПриложения Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.ПрисоединенныйФайл) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СоответствиеПометкиУдаленияФайлов[СтрТЧ.ПрисоединенныйФайл] = Истина Тогда
			Продолжить; // файл помечен на удаление, двоичные данные по нему получить мы не можем
		КонецЕсли;
		
		Запрос = ПолучитьЗапросОтправкиПриложенногоФайла(ТокенАвторизации, СтруктураАдреса, СтрТЧ.ПрисоединенныйФайл, ДокОбъект.Ссылка, Отмена);
		
		Если Отмена = Истина Тогда
			Возврат;
		КонецЕсли;
				
		Попытка
			Результат = ОтправитьPOSTЗапрос(HTTPСоединение,Запрос);
	    	//Результат = HTTPСоединение.ОтправитьДляОбработки(Запрос);
		Исключение
			ТекстСообщения = НСтр("ru='Не удалось отправить в ЕСМВ приложенный файл по документу по причине:
			|%1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ЕСМВ. Передача приложенного файла", УровеньЖурналаРегистрации.Ошибка, Метаданные.ЖурналыДокументов.ВзаимодействияСЕБП, ЗаписьСообщения.Документ,ТекстСообщения);
			Отказ = Истина;
			Возврат;
		КонецПопытки;
		
		ТекстЗапрос = ПолучитьТекстPOSTЗапроса(Запрос, СтруктураАдреса.ПутьНаСервере);
		МассивСообщенийЗапросов.Добавить(ТекстЗапрос);
		
		ТекстОтвет = ПолучитьТекстОтвета(Результат);
		МассивСообщенийОтветов.Добавить(ТекстОтвет);
		
		Текст = Результат.ПолучитьТелоКакСтроку();
		ИдентификаторПриложенногоФайла = ПолучитьИдентификаторСообщенияФайла(Текст);
		СтрТЧ.ИдентификаторФайла = ИдентификаторПриложенногоФайла; 
		
		Если Результат.КодСостояния >= 200
			И Результат.КодСостояния < 300
			И ЗначениеЗаполнено(ИдентификаторПриложенногоФайла) Тогда
			// все нормально	
		Иначе
			ЗаписьСообщения.ЕстьОшибка = Истина;
			ЗаписьСообщения.ТекстОшибки = НСтр("ru='Не удалось отправить приложенный файл. Подробнее в файле ответа сервера передачи приложенных файла.'");
		КонецЕсли;
	
	КонецЦикла;	
		
	ЗаписьСообщения.ПередачаПриложенныхФайловЗапрос = Новый ХранилищеЗначения(МассивСообщенийЗапросов,Новый СжатиеДанных(9));
	ЗаписьСообщения.ПередачаПриложенныхФайловОтвет = Новый ХранилищеЗначения(МассивСообщенийОтветов,Новый СжатиеДанных(9));
	ЗаписьСообщения.ЕстьПриложенныеФайлы = Истина;
		
	ЗаписьСообщения.Записать();
	
КонецПроцедуры

Функция ОтправитьPOSTЗапрос(HTTPСоединение,Запрос,КоличествоПопыток=3)
	
	Метод = "POST";
	Возврат ОтправитьHTTPЗапрос(HTTPСоединение,Запрос,Метод,КоличествоПопыток);	
	
КонецФункции

Функция ОтправитьGETЗапрос(HTTPСоединение,Запрос,КоличествоПопыток=3)
	
	Метод = "GET";
	Возврат ОтправитьHTTPЗапрос(HTTPСоединение,Запрос,Метод,КоличествоПопыток);	
	
КонецФункции

//Только POST ИЛИ GET
Функция ОтправитьHTTPЗапрос(HTTPСоединение,Запрос,Метод,КоличествоПопыток=3)
	
	Результат = Неопределено;
	Для Инд = 1 По КоличествоПопыток Цикл 
		ОбменУспешен = Ложь;
		ТекстОшибки = "";
		Попытка
			Если Метод = "POST" Тогда
				Результат = HTTPСоединение.ОтправитьДляОбработки(Запрос);
			Иначе//GET
				Результат = HTTPСоединение.Получить(Запрос);					
			КонецЕсли;
			
			Если Результат.КодСостояния >= 200 
				И Результат.КодСостояния < 300 Тогда
				ОбменУспешен = Истина;
			КонецЕсли;
			
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		Если ОбменУспешен Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


Функция ПолучитьЗапросОтправкиПриложенногоФайла(ТокенАвторизации, СтруктураАдреса, ПрисоединенныйФайл, ДокументФайла, Отмена)
	
	Попытка
		Данныефайла = РаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл);
		// Может вернуть исключение, если файл помечен на удаление.
	Исключение
		ТекстСообщения = НСтр("ru='Не удалось получить данные приложенного файла %1 к документу %2 для передачи в ЕСМВ по причине:
		|%3
		|Обмен прерван.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПрисоединенныйФайл, ДокументФайла, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ЕБП.Передача приложенного файла", УровеньЖурналаРегистрации.Ошибка, Метаданные.ЖурналыДокументов.ВзаимодействияСЕБП, ДокументФайла, ТекстСообщения);
		Отмена = Истина;
		Возврат Неопределено;
	КонецПопытки;
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Данныефайла.СсылкаНаДвоичныеДанныеФайла);
	
	Разделитель = "----" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Host", СтруктураАдреса.Хост);
	Заголовки.Вставить("Authorization", ТокенАвторизации);
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Разделитель);
	
	Запрос = Новый HTTPЗапрос(СтруктураАдреса.ПутьНаСервере, Заголовки);
	
	Тело = Новый ПотокВПамяти();

	ЗаписьДанных = Новый ЗаписьДанных(Тело,,, Символы.ВК + Символы.ПС, "");   

	ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель);   	 

	ЗаписьДанных.ЗаписатьСтроку("Content-Disposition: form-data; name=""file""; filename=""" + СокрЛП(Данныефайла.ИмяФайла) + """");
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.Записать(ДвоичныеДанные);
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель+"--");
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.Закрыть();
	
	ДанныеТела = Тело.ЗакрытьИПолучитьДвоичныеДанные();
	Запрос.УстановитьТелоИзДвоичныхДанных(ДанныеТела);
	
	Возврат Запрос; 
	
КонецФункции

Функция ПолучитьТекстPOSTЗапроса(Запрос, ПутьНаСервере)
	
	МассивТекстов = Новый Массив;
	МассивТекстов.Добавить("POST "+ ПутьНаСервере);
	Для Каждого КлючИЗначение Из Запрос.Заголовки Цикл
		МассивТекстов.Добавить(КлючИЗначение.Ключ + ": " + КлючИЗначение.Значение);		
	КонецЦикла;
	МассивТекстов.Добавить("");
	МассивТекстов.Добавить(Запрос.ПолучитьТелоКакСтроку());
	
	Возврат СтрСоединить(МассивТекстов, Символы.ПС);
	
КонецФункции

Функция ПолучитьИдентификаторСообщенияФайла(Текст)
	
	//Пример ответа:
	//<FileLoadReceiptType>
	//	<id>c287e41c-c77c-48ce-ad64-0f5d01717a79</id>
	//	<creationDateTime>2024-05-29T08:07:55.002+00:00</creationDateTime>
	//	<status>SUCCESS</status>
	//</FileLoadReceiptType> 
	//
	ИдентификаторСообщения = "";
	Если СтрНайти(ВРег(Текст),"SUCCESS")>0 Тогда
		НачальныйБлок = СтрНайти(Текст,"id>");
		Если НачальныйБлок>0 Тогда
			НачальныйБлок = НачальныйБлок + 3;
			КонечныйБлок = СтрНайти(Текст,"</",, НачальныйБлок);
			ИдентификаторСообщения = Сред(Текст, НачальныйБлок, КонечныйБлок - НачальныйБлок);
		КонецЕсли;
	КонецЕсли; 
	
	Возврат ИдентификаторСообщения;
	
КонецФункции

Функция ПолучитьЗапросАвторизации(ДДСертификата, СтруктураАдреса)
	
	Разделитель = "----"+СтрЗаменить(Строка(Новый УникальныйИдентификатор),"-","");
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Host",СтруктураАдреса.Хост);
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Разделитель);
	
	Запрос = Новый HTTPЗапрос(СтруктураАдреса.ПутьНаСервере,Заголовки);
	
	Тело = Новый ПотокВПамяти();

	ЗаписьДанных = Новый ЗаписьДанных(Тело, , , Символы.ВК + Символы.ПС, "");   

	ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель);   	 

	ЗаписьДанных.ЗаписатьСтроку("Content-Disposition: form-data; name=""cert""; filename=""cert.cer""");
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.Записать(ДДСертификата);
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель+"--");
	ЗаписьДанных.ЗаписатьСтроку("");
	ЗаписьДанных.Закрыть();
	
	ДанныеТела = Тело.ЗакрытьИПолучитьДвоичныеДанные();
	Запрос.УстановитьТелоИзДвоичныхДанных(ДанныеТела);
	
	Возврат Запрос; 
	
КонецФункции 

Функция ПолучитьТекстЗапроса(Запрос, ПутьНаСервере)
	
	МассивТекстов = Новый Массив;
	МассивТекстов.Добавить("POST "+ ПутьНаСервере);
	Для Каждого КлючИЗначение Из Запрос.Заголовки Цикл
		МассивТекстов.Добавить(КлючИЗначение.Ключ+": "+КлючИЗначение.Значение);		
	КонецЦикла;
	МассивТекстов.Добавить("");
	МассивТекстов.Добавить(Запрос.ПолучитьТелоКакСтроку());
	
	Возврат СтрСоединить(МассивТекстов,Символы.ПС);
	
КонецФункции

Функция ПолучитьТокенАвторизацииИзОтвета(Ответ)
	Токен = ПолучитьЗаголовокИзОтвета(Ответ, "authorization");
	
	//убираем из токена тип авторизации, чтобы по токену далее понять, зашифрован он или нет
	Если Токен<>Неопределено Тогда
		Токен = СтрЗаменить(Токен, ИнтеграцияЕСМВКлиентСервер.ТипАвторизацииТокена(),"");
	КонецЕсли;
		
	Возврат Токен; 
КонецФункции

Функция ПолучитьЗаголовокИзОтвета(Ответ, ИмяЗаголовка)
	//в ответе заголовок с может быть как с заглавной буквы, так и с прописной, например, Location или location
	Токен = Неопределено;
	
	ИмяЗаголовкаВНижнемРегистре = НРег(ИмяЗаголовка);
	МассивЧастей = СтрРазделить(ИмяЗаголовкаВНижнемРегистре,"-");
	МассивЧастейПЗ = Новый Массив;
	Для Каждого ТекЧасть Из МассивЧастей Цикл
		МассивЧастейПЗ.Добавить(ВРег(Лев(ТекЧасть,1))+Сред(ТекЧасть,2));
	КонецЦикла;
	ИмяЗаголовкаПерваяЗаглавная = СтрСоединить(МассивЧастейПЗ,"-");
	Токен = Ответ.Заголовки.Получить(ИмяЗаголовкаПерваяЗаглавная);
				
	Если Токен = Неопределено Тогда
		Токен = Ответ.Заголовки.Получить(ИмяЗаголовкаВНижнемРегистре);	
	КонецЕсли;
	
	Возврат Токен;
	
КонецФункции

Функция ПолучитьТекстОтвета(Ответ)
	МассивТекстов = Новый Массив;
	МассивТекстов.Добавить("Код состояния (ответа): "+ Ответ.КодСостояния);
	Для Каждого КлючИЗначение Из Ответ.Заголовки Цикл
		МассивТекстов.Добавить(КлючИЗначение.Ключ+": "+КлючИЗначение.Значение);		
	КонецЦикла;
	МассивТекстов.Добавить("");
	МассивТекстов.Добавить(Ответ.ПолучитьТелоКакСтроку());
	
	Возврат СтрСоединить(МассивТекстов,Символы.ПС);	
КонецФункции

Функция ПолучитьДокументПоИдентификаторуДокумента(ИдентификаторДокументаВПакете)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СообщенияОбменаДаннымиЕБП.Документ КАК Документ
		|ИЗ
		|	РегистрСведений.СообщенияОбменаДаннымиЕБП КАК СообщенияОбменаДаннымиЕБП
		|ГДЕ
		|	СообщенияОбменаДаннымиЕБП.ИдентификаторДокументаВПакете = &ИдентификаторДокументаВПакете";
	
	Запрос.УстановитьПараметр("ИдентификаторДокументаВПакете", Новый УникальныйИдентификатор(ИдентификаторДокументаВПакете));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Документ;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьТекстОшибкиИзТаблицы(МассивСтрокОшибок,ИдСтроки)

	ОбщийТекст = "";
	МассивСообщенийОбОшибках = Новый Массив;
	СтрокаПоиска = ИдСтроки+"/";
	Для Каждого СтрТЧ Из МассивСтрокОшибок Цикл
		Если НЕ СтрНачинаетсяС(СтрТЧ.СлужебноеПоле_ИдентификаторСтроки,СтрокаПоиска) Тогда
			Продолжить;
		КонецЕсли;
		КодОшибки = СтрТЧ.КодОшибки; 
		НаименованиеОшибки = СтрТЧ.НаименованиеОшибки;
		ОписаниеОшибки = СтрТЧ.ОписаниеОшибки;
		ПолныйТекстОшибки = СтрТЧ.ПолныйТекстОшибки;
	
		// ERROR - Ошибка, WARNING - Предупреждение
		ТекУровень = СтрТЧ.УровеньОшибки;
		Если СтрТЧ.УровеньОшибки = "ERROR" Тогда
			ТекУровень = "Ошибка";
		ИначеЕсли СтрТЧ.УровеньОшибки = "WARNING" Тогда
			ТекУровень = "Предупреждение";
		КонецЕсли;
				
		ТекстТекущейОшибки = "%1, код = %2, наименование = %3";
		ТекстТекущейОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстТекущейОшибки,ТекУровень,КодОшибки,НаименованиеОшибки);
		МассивСообщенийОбОшибках.Добавить(ТекстТекущейОшибки);
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			ТекстТекущейОшибки = "Описание: %1";
			ТекстТекущейОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстТекущейОшибки,ОписаниеОшибки);
			МассивСообщенийОбОшибках.Добавить(ТекстТекущейОшибки);
		КонецЕсли;
		Если ЗначениеЗаполнено(ПолныйТекстОшибки) Тогда
			ТекстТекущейОшибки = "Полный текст ошибки: %1";
			ТекстТекущейОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстТекущейОшибки,ПолныйТекстОшибки);
			МассивСообщенийОбОшибках.Добавить(ТекстТекущейОшибки);
		КонецЕсли;
	КонецЦикла;
			
	ОбщийТекст = СтрСоединить(МассивСообщенийОбОшибках,Символы.ПС);
	Возврат ОбщийТекст; 
	
КонецФункции  

Процедура РазобратьРезультатОбработкиПакетаДляОдногоДокмента(СтруктураОтвета, Знач ТекстОтвет)
	
	//Перем ДокументDOM;
	//Перем ДочернийУзел;
	//Перем ИмяУзлаКодОшибки;
	//Перем ИмяУзлаНаименованиеОшибки;
	//Перем ИмяУзлаОписаниеОшибки;
	//Перем ИмяУзлаПолныйТекстОшибки;
	//Перем ИмяУзлаУровеньОшибки;
	//Перем Инд;
	//Перем ИскомыйУзел;
	//Перем КодОшибки;
	//Перем МассивСообщенийОбОшибках;
	//Перем НаименованиеОшибки;
	//Перем ОбъектСхемы;
	//Перем ОписаниеОшибки;
	//Перем ПозицияНачала;
	//Перем ПозицияОкончания;
	//Перем ПолныйТекстОшибки;
	//Перем ПостроительDOM;
	//Перем СтроковоеОписаниеОшибки;
	//Перем ТекстТекущейОшибки;
	//Перем ТекУзелОписания;
	//Перем ТекУровень;
	//Перем УзлыОписанияОшибки;
	//Перем УровеньОшибки;
	//Перем ЧитаемыйБлок;
	//Перем ЧитаемыйОтвет
	//Перем ЧтениеXML;
	
	ИскомыйУзел = "PackageLoadReceiptType";
	
	Инд = 1;
	ЧитаемыйОтвет = ТекстОтвет;
	ПозицияНачала = СтрНайти(ТекстОтвет, "<");
	ПозицияОкончания = СтрНайти(ТекстОтвет, ">");
	
	Пока ПозицияНачала <> 0 И ПозицияОкончания <> 0 Цикл
		ЧитаемыйБлок = Сред(ТекстОтвет,ПозицияНачала, ПозицияОкончания - ПозицияНачала + 1);
		Если СтрНайти(ЧитаемыйБлок, ИскомыйУзел)>0 Тогда
			ЧитаемыйОтвет = Сред(ТекстОтвет, ПозицияНачала, СтрНайти(ТекстОтвет, ИскомыйУзел + ">",,, 2) - ПозицияНачала + СтрДлина(ИскомыйУзел + ">"));
			Прервать;
		Иначе
			Инд = Инд + 1;
		КонецЕсли;
		ПозицияНачала = СтрНайти(ТекстОтвет, "<",,, Инд);
		ПозицияОкончания = СтрНайти(ТекстОтвет, ">",,, Инд);
	КонецЦикла;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ЧитаемыйОтвет);
	
	ПостроительDOM = Новый ПостроительDOM;
	Попытка
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	Исключение
		СтруктураОтвета.ТекстОшибки = "Не удалось разобрать ответ";
		Возврат;
	КонецПопытки;
	
	ОбъектСхемы = ДокументDOM.ПолучитьЭлементыПоИмени("status");
	СтроковоеОписаниеОшибки = "";		
	Если ОбъектСхемы.Количество()>0 Тогда
			
		СтруктураОтвета.Статус = ОбъектСхемы[0].ТекстовоеСодержимое;
		
		УзлыОписанияОшибки = ДокументDOM.ПолучитьЭлементыПоИмени("violation");
		Если УзлыОписанияОшибки.Количество()>0 Тогда
			ИмяУзлаКодОшибки = "code";
			ИмяУзлаУровеньОшибки = "level";
			ИмяУзлаНаименованиеОшибки = "name";
			ИмяУзлаОписаниеОшибки = "description";
			ИмяУзлаПолныйТекстОшибки = "fullErrorLog";
			МассивСообщенийОбОшибках = Новый Массив;
			Для Каждого ТекУзелОписания Из УзлыОписанияОшибки Цикл
				КодОшибки = ""; 
				УровеньОшибки = "";
				НаименованиеОшибки = "";
				ОписаниеОшибки = "";
				ПолныйТекстОшибки = "";
				Для Каждого ДочернийУзел Из ТекУзелОписания.ДочерниеУзлы Цикл
					Если ДочернийУзел.ИмяУзла = ИмяУзлаКодОшибки Тогда
						КодОшибки = ДочернийУзел.ТекстовоеСодержимое;
					ИначеЕсли ДочернийУзел.ИмяУзла = ИмяУзлаУровеньОшибки Тогда
						УровеньОшибки = ДочернийУзел.ТекстовоеСодержимое;
					ИначеЕсли ДочернийУзел.ИмяУзла = ИмяУзлаНаименованиеОшибки Тогда
						НаименованиеОшибки = ДочернийУзел.ТекстовоеСодержимое;
					ИначеЕсли ДочернийУзел.ИмяУзла = ИмяУзлаОписаниеОшибки Тогда
						ОписаниеОшибки = ДочернийУзел.ТекстовоеСодержимое;
					ИначеЕсли ДочернийУзел.ИмяУзла = ИмяУзлаПолныйТекстОшибки Тогда
						ПолныйТекстОшибки = ДочернийУзел.ТекстовоеСодержимое;
					КонецЕсли;
				КонецЦикла;
				// ERROR - Ошибка WARNING - Предупреждение
				ТекУровень = УровеньОшибки;
				Если УровеньОшибки = "ERROR" Тогда
					ТекУровень = "Ошибка";
				ИначеЕсли УровеньОшибки = "WARNING" Тогда
					ТекУровень = "Предупреждение";
				КонецЕсли;
				
				ТекстТекущейОшибки = "%1, код = %2, наименование = %3";
				ТекстТекущейОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстТекущейОшибки, ТекУровень, КодОшибки, НаименованиеОшибки);
				МассивСообщенийОбОшибках.Добавить(ТекстТекущейОшибки);
				Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
					ТекстТекущейОшибки = "Описание: %1";
					ТекстТекущейОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстТекущейОшибки, ОписаниеОшибки);
					МассивСообщенийОбОшибках.Добавить(ТекстТекущейОшибки);
				КонецЕсли;
				Если ЗначениеЗаполнено(ПолныйТекстОшибки) Тогда
					ТекстТекущейОшибки = "Полный текст ошибки: %1";
					ТекстТекущейОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстТекущейОшибки, ПолныйТекстОшибки);
					МассивСообщенийОбОшибках.Добавить(ТекстТекущейОшибки);
				КонецЕсли;
				
			КонецЦикла;
			
			СтруктураОтвета.ТекстОшибки = СтрСоединить(МассивСообщенийОбОшибках, Символы.ПС);
		КонецЕсли;
				
	КонецЕсли;

КонецПроцедуры

Функция ФайлЗагруженВБазу(ИдентификаторВФайловомХранилище)
	
	ФайлЗагруженИОбработан = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗагруженныеФайлыИзЕБП.ДатаОбмена КАК ДатаОбмена,
		|	ЗагруженныеФайлыИзЕБП.РСКП КАК РСКП,
		|	ЗагруженныеФайлыИзЕБП.ЕстьОшибкиОбработки КАК ЕстьОшибкиОбработки,
		|	ЗагруженныеФайлыИзЕБП.ТекстОшибкиОбработки КАК ТекстОшибкиОбработки
		|ИЗ
		|	РегистрСведений.ЗагруженныеФайлыИзЕБП КАК ЗагруженныеФайлыИзЕБП
		|ГДЕ
		|	ЗагруженныеФайлыИзЕБП.ИдентификаторВФайловомХранилище = &ИдентификаторВФайловомХранилище";
	
	Запрос.УстановитьПараметр("ИдентификаторВФайловомХранилище", ИдентификаторВФайловомХранилище);
	//в регистре только одно измерение и он не периодический, поэтому проверяем первую запись выборки 
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.РСКП) Тогда
			Если НЕ ОбщегоНазначения.СсылкаСуществует(Выборка.РСКП)
				И Выборка.ЕстьОшибкиОбработки Тогда
								
				Если ТребуетсяПовторнаяЗагрузка(Выборка.ТекстОшибкиОбработки) Тогда
					ФайлЗагруженИОбработан = Ложь;
				Иначе
					ФайлЗагруженИОбработан = Истина;
				КонецЕсли;
			Иначе
				ФайлЗагруженИОбработан = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;		
	
	Возврат ФайлЗагруженИОбработан;
		
КонецФункции

Функция ТребуетсяПовторнаяЗагрузка(Знач ТекстОшибки) Экспорт
	ЗагрузкаТребуется = Истина;
	
	//проверим текст ошибки:
	//например, если документ пришел в статусе, соответствующему Аннулирован (Отказан ТОФК, Отказан в исполнении, Отозван, Удален, Отменен, FK_REJECTED)
	//значит это нормальная ситуация, ничего делать больше не надо
	//иначе попробуем загрузить и обработать файл повторно, 
	//чтобы для повторной обработки пользователям не приходилось удалять записи из регистра ЗагруженныеФайлыИзЕБП
				
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Выражение = "^.+"""+СтрСоединить(ПлатежноРасчетныеДокументы.ЗначенияЕБПСтатусаАннулирован(),""".+$|^.+")+"$";
		ТекстОшибки = СтрЗаменить(ТекстОшибки,Символы.ПС,"");
		
		Если СтрПодобнаПоРегулярномуВыражению(ТекстОшибки,Выражение,Истина,Ложь) Тогда
			ЗагрузкаТребуется = Ложь;	
		Иначе
			ЗагрузкаТребуется = Истина;	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗагрузкаТребуется;	
КонецФункции


// Удаление ссылок на документы из РС ЗагруженныеФайлыИзЕБП перед их удалением.
Процедура ПередУдалениемДокументовОбменаЕБП(УдаляемыйДокументОбъект, Отказ) Экспорт
	Если УдаляемыйДокументОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаНаДокумент = УдаляемыйДокументОбъект.Ссылка;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗагруженныеФайлыИзЕБП.ИдентификаторВФайловомХранилище КАК ИдентификаторВФайловомХранилище
	|ИЗ
	|	РегистрСведений.ЗагруженныеФайлыИзЕБП КАК ЗагруженныеФайлыИзЕБП
	|ГДЕ
	|	ЗагруженныеФайлыИзЕБП.РСКП = &СсылкаНаДокумент";
	
	Запрос.УстановитьПараметр("СсылкаНаДокумент", СсылкаНаДокумент);
	
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(Метаданные.РегистрыСведений.ЗагруженныеФайлыИзЕБП.ПолноеИмя());
		ЭлементБлокировки.ИсточникДанных = ТаблицаЗаписей;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ИдентификаторВФайловомХранилище", "ИдентификаторВФайловомХранилище");
		Блокировка.Заблокировать();
		
		Для Каждого СтрТЧ Из ТаблицаЗаписей Цикл
			
			НаборЗаписей = РегистрыСведений.ЗагруженныеФайлыИзЕБП.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ИдентификаторВФайловомХранилище.Установить(СтрТЧ.ИдентификаторВФайловомХранилище);
			НаборЗаписей.Записать();
			
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОчиститьИсториюОбменаЕБППоНастройке() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ОчисткаИсторииОбменаЕБППоНастройке);
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюЕБП") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСобытия = НСтр("ru = 'Очистка истории обмена ЕБП'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		НСтр("ru = 'Начато регламентное очистки истории обмена ЕБП.'"));
		
	УстановитьПривилегированныйРежим(Истина);

	Если МонопольныйРежим() Тогда
		// Если база работает в монопольном режиме (например, запущено фоновое задание, которое включило монопольный режим
		//  и выгружает данные из области данных для последующей загрузки в модели сервиса),
		//  то будут ошибки при всех попытках записи данных в базу.
		ЗаписьЖурналаРегистрации(
