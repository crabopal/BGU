#Область ПрограммныйИнтерфейс

// Возникает после окончания формирования отчета: после завершения фонового задания.
// Позволяет переопределить обработку результата формирования отчета.
//
// Параметры:
//  ФормаОтчета - ФормаКлиентскогоПриложения - форма отчета.
//  ОтчетСформирован - Булево - Истина если отчет был успешно сформирован.
//
Процедура ПослеФормирования(ФормаОтчета, ОтчетСформирован) Экспорт
	
	Если СтрНайти("#Отчет.ЖурналОпераций#", "#" + ФормаОтчета.НастройкиОтчета.ПолноеИмя + "#") > 0 Тогда
		Если ФормаОтчета.ОтчетТабличныйДокумент.ВысотаТаблицы < 2 Тогда
			ОтчетыБГУВызовСервера.ПослеФормирования(ФормаОтчета.НастройкиОтчета, ФормаОтчета.ОтчетТабличныйДокумент, ОтчетСформирован); 
		КонецЕсли;
	ИначеЕсли СтрНайти("#Отчет.КарточкаУчетаСредствИРасчетов#", "#" + ФормаОтчета.НастройкиОтчета.ПолноеИмя + "#") > 0 Тогда
		Если ФормаОтчета.ОтчетТабличныйДокумент.ВысотаТаблицы > 1 Тогда
			ОтчетыБГУВызовСервера.ПослеФормирования(ФормаОтчета.НастройкиОтчета, ФормаОтчета.ОтчетТабличныйДокумент, ОтчетСформирован); 
		КонецЕсли;
	ИначеЕсли СтрНайти("#Отчет.УниверсальныйОтчет#", "#" + ФормаОтчета.НастройкиОтчета.ПолноеИмя + "#") > 0 Тогда
		ОтчетыБГУВызовСервера.ВывестиПодписьИсполнителя(ФормаОтчета.НастройкиОтчета, ФормаОтчета.ОтчетТабличныйДокумент, ОтчетСформирован, ФормаОтчета.НеВыводитьПодвал);
	КонецЕсли;	
	
	// Если в дополнительных свойствах пользовательских настроек есть реквизит "ОбъектыПечати", то перенесем их в 
	// одноименный реквизит формы отчета. 
	// Если количество этих объектов больше 1, то 	сделаем видимой кнопку группового сохранения регистров учета
	ДопСвойства = ФормаОтчета.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства;
	Если ДопСвойства.Свойство("ОбъектыПечати") Тогда 
		ФормаОтчета.ОбъектыПечати.Очистить();
		Для каждого Элемент из ДопСвойства.ОбъектыПечати Цикл
			ФормаОтчета.ОбъектыПечати.Добавить(Элемент.Значение, Элемент.Представление);
		КонецЦикла;	

		Если ФормаОтчета.ОбъектыПечати.Количество() > 1 Тогда
			ЭлементКоманда = ФормаОтчета.Элементы.Найти("СохранитьРегистрУчетаРаздельно");
			Если ЭлементКоманда <> Неопределено И НЕ ЭлементКоманда.Видимость Тогда
				ЭлементКоманда.Видимость = Истина;				
			КонецЕсли;	
			ЭлементКоманда = ФормаОтчета.Элементы.Найти("СохранитьРегистрУчетаИСоздатьВнутрЭДРаздельно");
			Если ЭлементКоманда <> Неопределено И НЕ ЭлементКоманда.Видимость Тогда
				ЭлементКоманда.Видимость = Истина;				
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

// Обработчик расшифровки табличного документа формы отчета.
//
// Параметры:
//   ФормаОтчета - УправляемаяФорма - Форма отчета.
//   Элемент     - ПолеФормы        - Табличный документ.
//   Расшифровка          - Передается из параметров обработчика "как есть".
//   СтандартнаяОбработка - Передается из параметров обработчика "как есть".
//
// См. также:
//   "Расширение поля формы для поля табличного документа.ОбработкаРасшифровки" в синтакс-помощнике.
//
Процедура ОбработкаРасшифровки(ФормаОтчета, Элемент, Расшифровка, СтандартнаяОбработка) Экспорт
	
	Если ФормаОтчета.ИмяФормы = "Отчет.РегистрыНалоговогоУчета.Форма"
	 	ИЛИ ФормаОтчета.ИмяФормы = "Отчет.РегистрИнформацииОбОбъектеОС.Форма"
	 	ИЛИ ФормаОтчета.ИмяФормы = "Отчет.РегистрНалоговогоУчетаФинРезультатовОтРеализацииАмортизируемогоИмущества.Форма" Тогда
		
		ПараметрыРасшифровки = НалоговыйУчетВызовСервера.ПолучитьПараметрыРасшифровкиОтчета(ФормаОтчета.ОтчетДанныеРасшифровки, ФормаОтчета.ИмяФормы, Расшифровка);
		Если ПараметрыРасшифровки.Количество()>0 Тогда
			Если ПараметрыРасшифровки.Свойство("ОткрытьОбъект") И ПараметрыРасшифровки.ОткрытьОбъект Тогда
				СтандартнаяОбработка = Ложь;
				ЗначениеРасшифровки = ПараметрыРасшифровки.Значение;
				Если Не (ЗначениеРасшифровки = Null) И (Не ТипЗнч(ЗначениеРасшифровки) = Тип("Строка")) И (Не ТипЗнч(ЗначениеРасшифровки) = Тип("Число")) Тогда
					ПоказатьЗначение(Неопределено, ЗначениеРасшифровки);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ФормаОтчета.ИмяФормы = "Отчет.ОтчетПоВерсиямКомплектов.Форма"
		ИЛИ ФормаОтчета.ИмяФормы = "Отчет.ОтчетПоВерсиямОтчетов.Форма" Тогда
			
		ПараметрыРасшифровки = ОтчетыБГУВызовСервера.ВозможноОткрытьОписаниеКомплекта(ФормаОтчета.ОтчетДанныеРасшифровки,Расшифровка);
		Если ПараметрыРасшифровки.ОткрытьОписание Тогда 
			
			СтандартнаяОбработка = Ложь;
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("КлючДанных",Новый Структура);
			ПараметрыФормы.КлючДанных.Вставить("ИдентификаторКомплекта",ПараметрыРасшифровки.ИдКомплекта);
			ОткрытьФорму("РегистрСведений.УстановленныеКомплектыОтчетности.Форма.ИнформацияОКомплекте",ПараметрыФормы, ФормаОтчета);
			
		КонецЕсли;
		
	ИначеЕсли ФормаОтчета.ИмяФормы = "Отчет.РеестрДокументовКПроводимойИнвентаризации.Форма" Тогда
		ИнвентаризацияКлиент.ОбработкаРасшифровки_Отчет_РеестрДокументовКПроводимойИнвентаризации(
			ФормаОтчета, Элемент, Расшифровка, СтандартнаяОбработка);
			
	КонецЕсли;
	
	//Расшифровка стандартными отчетами
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаОтчета,"ДанныеРасшифровки") Тогда
		ОтчетыКлиентБГУ.ОбработкаРасшифровкиСтандартногоОтчета(ФормаОтчета, Элемент, Расшифровка, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаРасшифровкиСтандартногоОтчета(ФормаОтчета, Элемент, Расшифровка, СтандартнаяОбработка, ТребуетсяДополнитьРасшифровку = Ложь) Экспорт
	
	Перем ОсновноеМеню,МассивОсновныхДействий;
	Перем ВыбранноеДействие;
	Перем ПараметрыВыбранногоДействия;
	
	ИдентификаторОбъекта = СтандартныеОтчетыКлиентСервер.ПолучитьИдентификаторОбъекта(ФормаОтчета);
	
	ПараметрыПроцедуры = Новый Структура("
		|ПолноеИмяОтчета,
		|ОтчетОбъект,
		|ОтчетДанныеРасшифровки,
		|АдресХранилища,
		|ДобавленныеВарианты",
		ФормаОтчета.НастройкиОтчета.ПолноеИмя,
		ФормаОтчета.Отчет,
		ФормаОтчета.ОтчетДанныеРасшифровки,
		ФормаОтчета.УникальныйИдентификатор,
		ФормаОтчета.ДобавленныеВарианты);
	
	ПараметрыРасшифровки = ОтчетыБГУВызовСервера.ПараметрыРасшифровкиОтчета(
		ФормаОтчета.ДанныеРасшифровки, ИдентификаторОбъекта, Расшифровка, ПараметрыПроцедуры);
	
	Если ПараметрыРасшифровки = Ложь Тогда
		Возврат;
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
	ЗаполняемыеНастройки = Новый Структура("Показатели, Группировка, Отбор", Ложь, Истина, Ложь);
	Если ПараметрыРасшифровки.ОткрытьЗначение Тогда
		ПоказатьЗначение( , ПараметрыРасшифровки.Значение);
	ИначеЕсли ПараметрыРасшифровки.Свойство("ОсновноеМеню",ОсновноеМеню) Тогда
		
		ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(ФормаОтчета.ОтчетДанныеРасшифровки,Новый ИсточникДоступныхНастроекКомпоновкиДанных(ФормаОтчета.НастройкиОтчета.АдресСхемы));
		
		ПараметрыОповещения = Новый Структура("
		|ПараметрыРасшифровкиДляСтандартныхОтчетов,
		|ЗаполняемыеНастройки,
		|ФормаОтчета,
		|ИмяФормы,
		|Расшифровка,
		|ОтчетДанныеРасшифровки,
		|ОтборДляВариантаОтчета",
		ФормаОтчета.ДанныеРасшифровки,
		ЗаполняемыеНастройки,
		ФормаОтчета,
		ФормаОтчета.ИмяФормы,
		Расшифровка,
		ФормаОтчета.ОтчетДанныеРасшифровки,
		ПараметрыРасшифровки.ОтборДляВариантаОтчета);
		
		ОписаниеОповещенияПослеВыбораДействия = Новый ОписаниеОповещения(
		"ВыполнитьДействиеПослеВыбораРасшифровки",
		ЭтотОбъект,
		ПараметрыОповещения);
		
		МассивОсновныхДействий = ПараметрыРасшифровки.МассивОсновныхДействий;
		
		ОбработкаРасшифровки.ПоказатьВыборДействия(ОписаниеОповещенияПослеВыбораДействия,Расшифровка,МассивОсновныхДействий,ОсновноеМеню);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьДействиеПослеВыбораРасшифровки(ВыбранноеДействие,ПараметрыВыбранногоДействия, ДополнительныеПараметры) Экспорт
	
	Если ПараметрыВыбранногоДействия <> Неопределено И ПараметрыВыбранногоДействия <> Null тогда
		Если ВыбранноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение тогда
			ПоказатьЗначение(,ПараметрыВыбранногоДействия);
		Иначе
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
			ПараметрыФормы.Вставить("Расшифровка", Новый ОписаниеОбработкиРасшифровкиКомпоновкиДанных(ДополнительныеПараметры.ОтчетДанныеРасшифровки, ДополнительныеПараметры.Расшифровка, ПараметрыВыбранногоДействия));
			ОткрытьФорму(ДополнительныеПараметры.ИмяФормы, ПараметрыФормы,,Истина);
		КонецЕсли;
	ИначеЕсли ВыбранноеДействие <> ДействиеОбработкиРасшифровкиКомпоновкиДанных.Нет Тогда
		Если Лев(ВыбранноеДействие, 12) = "КлючВарианта" Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
			ПараметрыФормы.Вставить("КлючВарианта", Сред(ВыбранноеДействие, 13));
			ПараметрыФормы.Вставить("ОтборСоответствие", ДополнительныеПараметры.ОтборДляВариантаОтчета);
			ПараметрыФормы.Вставить("ПользовательскиеНастройки", ДополнительныеПараметры.ФормаОтчета.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки);
			ОткрытьФорму(ДополнительныеПараметры.ИмяФормы, ПараметрыФормы, ДополнительныеПараметры.ФормаОтчета, Истина);
		Иначе
			ИмяВыбраннойФормы = СтандартныеОтчетыКлиент.ПолучитьИмяФормыПоИДРасшифровки(ВыбранноеДействие);
			Если ЗначениеЗаполнено(ИмяВыбраннойФормы) тогда
				ПараметрыФормы = Новый Структура("ВидРасшифровки, АдресНастроек, СформироватьПриОткрытии, ИДРасшифровки, ЗаполняемыеНастройки",
												 	1, ДополнительныеПараметры.ПараметрыРасшифровкиДляСтандартныхОтчетов, Истина, ВыбранноеДействие, ДополнительныеПараметры.ЗаполняемыеНастройки);
				ОткрытьФорму(ИмяВыбраннойФормы, ПараметрыФормы,, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик дополнительной расшифровки (меню табличного документа формы отчета).
//
// Параметры:
//   ФормаОтчета - УправляемаяФорма - Форма отчета.
//   Элемент     - ПолеФормы        - Табличный документ.
//   Расшифровка          - Передается из параметров обработчика "как есть".
//   СтандартнаяОбработка - Передается из параметров обработчика "как есть".
//
// См. также:
//   "Расширение поля формы для поля табличного документа.ОбработкаДополнительнойРасшифровки" в синтакс-помощнике.
//
Процедура ОбработкаДополнительнойРасшифровки(ФормаОтчета, Элемент, Расшифровка, СтандартнаяОбработка) Экспорт
	
КонецПроцедуры

// Обработчик команд, добавленных динамически и подключенных к обработчику "Подключаемый_Команда".
//
// Параметры:
//   ФормаОтчета - УправляемаяФорма - Форма отчета.
//   Команда     - КомандаФормы     - Команда, которая была вызвана.
//   Результат   - Булево           - Истина, если вызов команды обработан.
//
// Вспомогательные методы:
//   ОбщаяФорма.ФормаОтчета.ВыполнитьКонтекстныйВызовСервера() -> ОтчетыПереопределяемый.КонтекстныйВызовСервера().
//
Процедура ОбработчикКоманды(ФормаОтчета, Команда, Результат, НастройкиВРегистр = Ложь) Экспорт
	
	
	РегистрыУчетаКлиент.ОбработчикКомандыРаботыСРегистромУчета(ФормаОтчета, Команда, "ОтчетТабличныйДокумент", НастройкиВРегистр);
	
	
КонецПроцедуры

// Обработчик результата выбора подчиненной формы.
//
// Параметры:
//   ФормаОтчета       - УправляемаяФорма - Форма отчета.
//   ВыбранноеЗначение - Произвольное значение - Результат выбора в подчиненной форме.
//   ИсточникВыбора    - УправляемаяФорма - Форма, где осуществлен выбор.
//   Результат         - Булево           - Истина, если результат выбора обработан.
//
// См. также:
//   "УправляемаяФорма.ОбработкаВыбора" в синтакс-помощнике.
//
Процедура ОбработкаВыбора(ФормаОтчета, ВыбранноеЗначение, ИсточникВыбора, Результат) Экспорт
	
	// СтандартныеПодсистемы.РассылкаОтчетов
	РассылкаОтчетовКлиент.ФормаОтчетаОбработкаВыбора(ФормаОтчета, ВыбранноеЗначение, ИсточникВыбора, Результат);
	// Конец СтандартныеПодсистемы.РассылкаОтчетов
	
КонецПроцедуры

// Обработчик широковещательного оповещения формы отчета.
//
// Параметры:
//   ФормаОтчета - УправляемаяФорма - Форма отчета.
//   ИмяСобытия  - Передается из параметров обработчика "как есть".
//   Параметр    - Передается из параметров обработчика "как есть".
//   Источник    - Передается из параметров обработчика "как есть".
//
// См. также:
//   "УправляемаяФорма.ОбработкаОповещения" в синтакс-помощнике.
//
Процедура ОбработкаОповещения(ФормаОтчета, ИмяСобытия, Параметр, Источник, ОповещениеОбработано) Экспорт
	
КонецПроцедуры

#КонецОбласти
