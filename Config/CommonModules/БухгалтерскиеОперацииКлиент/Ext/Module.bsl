Функция ЗапроситьРазрешениеРедактированияРеквизитовТиповыхОпераций(МассивРазрешенныхРеквизитов = Неопределено) Экспорт

	МассивРазрешенныхРеквизитов = Новый Массив;
	МассивРазрешенныхРеквизитов.Добавить("ИмяДляФормулы");		
	МассивРазрешенныхРеквизитов.Добавить("РеквизитПроводки");
	
	Возврат Истина;

КонецФункции // ЗапроситьРазрешениеРедактированияРеквизитовТиповыхОпераций()

Процедура КомандаУправлениеТиповымиОперациями(Форма, Команда) Экспорт

	Если Команда.Имя = "ТиповыеОперации_УправлениеТиповымиОперациями_УстановитьОперациюПоУмолчаниюВсем"
		ИЛИ Команда.Имя = "ТиповыеОперации_УправлениеТиповымиОперациями_УстановитьОперациюПоУмолчанию" Тогда
		
		УстанавливатьВсем = Команда.Имя = "ТиповыеОперации_УправлениеТиповымиОперациями_УстановитьОперациюПоУмолчаниюВсем";
		УстановитьТиповуюОперациюПоУмолчаниюИзФормы(Форма, УстанавливатьВсем);
		
	ИначеЕсли Команда.Имя = "ТиповыеОперации_УправлениеТиповымиОперациями_УстановитьРеквизитыПоУмолчанию" Тогда
		
		УстановитьРеквизитыОперацииПоУмолчаниюИзФормы(Форма);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыВыбораЗначенийЗаданногоТипа(ТипЗначения) Экспорт

	Если ЭтоПримитивныйТип(ТипЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Если ТипЗначения = Тип("СправочникСсылка.БанковскиеКарты") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.БанковскиеКарты.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.БСО") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.БСО.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ВидыДенежныхДокументов") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.ВидыДенежныхДокументов.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ВидыЗатрат") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.ВидыЗатрат.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ВидыНалоговИПлатежей") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.ВидыНалоговИПлатежей.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ВидыПервичныхДокументов") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.ВидыПервичныхДокументов.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ВидыЦелевыхСредств") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.ВидыЦелевыхСредств.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ДенежныеДокументы") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.ДенежныеДокументы.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.Договоры") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.Договоры.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.ДополнительнаяБюджетнаяКлассификация.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ДрагМеталлы") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.ДрагМеталлы.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ИсточникиСредств") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.ИсточникиСредств.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.ИсточникиФинансовогоОбеспечения.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.КлассификационныеПризнакиСчетов") Тогда
		Результат.Вставить("ФормаВыбора", "Справочник.КлассификационныеПризнакиСчетов.ФормаВыбора");
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.Контрагенты") Тогда
