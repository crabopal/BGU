		Возврат Новый Структура("Организация", Тип("СправочникСсылка.Организации"));
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		Возврат Новый Структура("Организация", Тип("СправочникСсылка.Организации"));
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.ПоступлениеМЗВПути") Тогда
		Возврат Новый Структура("Организация", Тип("СправочникСсылка.Организации"));
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.ПоступлениеОС") Тогда
		Возврат Новый Структура("Организация", Тип("СправочникСсылка.Организации"));
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.ПоступлениеОСВПути") Тогда
		Возврат Новый Структура("Организация", Тип("СправочникСсылка.Организации"));
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
		Возврат Новый Структура("Организация", Тип("СправочникСсылка.Организации"));
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		Возврат Новый Структура("Организация", Тип("СправочникСсылка.Организации"));
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.ПриходныйОрдерФондовый") Тогда
		Возврат Новый Структура("Организация", Тип("СправочникСсылка.Организации"));
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		Возврат Новый Структура("Организация", Тип("СправочникСсылка.Организации"));
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Возврат Новый Структура("Организация", Тип("СправочникСсылка.Организации"));
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
		Возврат Новый Структура("Организация", Тип("СправочникСсылка.Организации"));
		
		
		
	КонецЕсли;
	

КонецФункции // ТребуемыеПараметрыПриВыбореЗначенийЗаданногоТипа()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьТиповуюОперациюПоУмолчаниюИзФормы(Форма, УстанавливатьВсем)
	
	РеквизитТиповаяОперация = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитыФормыТиповаяОперацияФактическое(Форма);
	ТиповаяОперация = Форма[РеквизитТиповаяОперация];
	
	Если Не ЗначениеЗаполнено(ТиповаяОперация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрана типовая операция'"),, РеквизитТиповаяОперация);
		Возврат;
	КонецЕсли;
	
	БухгалтерскиеОперацииВызовСервера.УстановитьОперациюПоУмолчанию(ТиповаяОперация, УстанавливатьВсем);
	
	Если УстанавливатьВсем Тогда
		ПредставлениеПользователей = НСтр("ru = 'все пользователи'");
	Иначе
		ПредставлениеПользователей = НСтр("ru = 'текущий пользователь'");
	КонецЕсли;
	ТекстОповещения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Установлена типовая операция по умолчанию (%1)'"),
		ПредставлениеПользователей);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Типовые операции'"),
		ПолучитьНавигационнуюСсылку(ТиповаяОперация),
		ТекстОповещения,
		БиблиотекаКартинок.Информация32);
	ОповеститьОбИзменении(ТиповаяОперация);
	
КонецПроцедуры

Процедура УстановитьРеквизитыОперацииПоУмолчаниюИзФормы(Форма)

	РеквизитТиповаяОперация = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитыФормыТиповаяОперацияФактическое(Форма);
	ТиповаяОперация = Форма[РеквизитТиповаяОперация];
	
	Если Не ЗначениеЗаполнено(ТиповаяОперация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрана типовая операция'"),, РеквизитТиповаяОперация);
		Возврат;
	КонецЕсли;
	
	ЗначенияДополнительныхРеквизитов = ДополнительныеРеквизитыИзФормы(Форма);
	Организация 	= Форма.Объект.Организация;
	
	Параметры = Новый Структура("ТиповаяОперация, ЗначенияДополнительныхРеквизитов, Пользователь,"
		+ "Организация, ДляТекущегоПользователя");
	Параметры.ТиповаяОперация                  = ТиповаяОперация;
	Параметры.ЗначенияДополнительныхРеквизитов = ЗначенияДополнительныхРеквизитов;
	Параметры.Организация                      = Организация;
	Параметры.ДляТекущегоПользователя          = Истина;
	Параметры.Пользователь                     = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
	
	БухгалтерскиеОперацииВызовСервера.УстановитьРеквизитыОперацииПоУмолчаниюИзФормы(Параметры);
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Типовые операции'"),
		ПолучитьНавигационнуюСсылку(ТиповаяОперация),
		НСтр("ru = 'Установлены реквизиты по умолчанию для типовой операции (текущий пользователь)'"),
		БиблиотекаКартинок.Информация32);
	ОповеститьОбИзменении(ТиповаяОперация);

КонецПроцедуры

Функция ДополнительныеРеквизитыИзФормы(Форма)

	ЗначенияДопРеквизитов = Новый Структура;
	Для Каждого ТекДопРеквизит Из Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"] Цикл
		Если НЕ ТекДопРеквизит.ЭтоГруппа И НЕ ЗначениеЗаполнено(ТекДопРеквизит.ИмяТаблицы)
			И ЗначениеЗаполнено(ТекДопРеквизит.ИмяДляФормулы)
			И ЗначениеЗаполнено(ТекДопРеквизит.ИмяРеквизита) Тогда
			
			ЗначенияДопРеквизитов.Вставить(ТекДопРеквизит.ИмяДляФормулы, Форма[ТекДопРеквизит.ИмяРеквизита]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗначенияДопРеквизитов;

КонецФункции

Функция ЭтоПримитивныйТип(ТипЗначения)

	Возврат	ТипЗначения = Тип("Строка")
			ИЛИ ТипЗначения = Тип("Дата")
			ИЛИ ТипЗначения = Тип("Булево")
			ИЛИ ТипЗначения = Тип("Число");

КонецФункции // ЭтоПримитивныйТип()

#КонецОбласти
