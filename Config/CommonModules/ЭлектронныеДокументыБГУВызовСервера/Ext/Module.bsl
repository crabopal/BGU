#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ДанныеФайлаPDF", Истина);
КонецПроцедуры

#КонецОбласти

Процедура ОбработатьИсключениеПоЭДНаСервере(ВидОперации, ПодробныйТекстОшибки, ТекстСообщения = "", КодСобытия = 2) Экспорт
	
	Если НЕ ПустаяСтрока(ТекстСообщения) Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	ТекстОшибки = НСтр("ru = 'Выполнение операции:'")+ " " + ВидОперации + Символы.ПС + ПодробныйТекстОшибки;
	ЭлектронныеДокументыБГУ.ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстОшибки, КодСобытия);
	
КонецПроцедуры

Функция СписокДоступнойНоменклатурыЭДПоставщика(ТипДокументаУчета, ДокументОснование) Экспорт
	
	УжеЕстьМинимумОдинДокументУчета = Ложь;
	ДокументыОтраженияДляЭДП = ДокументыОтраженияДляЭДП(ДокументОснование);
	Если ДокументыОтраженияДляЭДП.Количество() > 0 Тогда
		УжеЕстьМинимумОдинДокументУчета = Истина;
	КонецЕсли;	
	
	ВидыНоменклатурыМЗ = 1;
	ВидыНоменклатурыОС = 2;
	ВидыНоменклатурыРУ = 3;
	ВидыНоменклатурыИК = 4;
	ВидыНоменклатурыВТ = 5;
	ВидыНоменклатурыДД = 6;
	
	ВидыНоменклатуры = Новый Массив;
	Если ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеМЗ 
		ИЛИ ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеМЗВПути Тогда
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыМЗ);	
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыВТ);	
	ИначеЕсли ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеИК Тогда
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыМЗ);	
	ИначеЕсли ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеОС 
		ИЛИ ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеОСВПути 
		ИЛИ ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПринятиеКУчетуОбъектовОС Тогда
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыОС);	
	ИначеЕсли ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеОСИК Тогда 
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыИК);	
	ИначеЕсли ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПринятиеКУчетуОбъектовИК Тогда 
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыИК);	
	ИначеЕсли ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеУслугРабот Тогда
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыРУ);
	ИначеЕсли ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПриходныйОрдерФондовый Тогда
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыДД);	
		Запрос = Новый Запрос;
		
		Если УжеЕстьМинимумОдинДокументУчета Тогда
			ТекстЗапроса = "ВЫБРАТЬ
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК Номенклатура,
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество КАК Количество,
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Сумма КАК СуммаБезНДС,
			               |	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС) КАК СтавкаНДС,
			               |	0 КАК СуммаНДС,
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Всего КАК Сумма,
			               |	&ВидыНоменклатурыДД КАК КодВидаНоменклатуры,
			               |	""Денежные документы"" КАК ВидНоменклатуры,
			               |	ВЫБОР
			               |		КОГДА ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество <> 0
			               |			ТОГДА ЭлектронныйДокументПоставщикаСписокНоменклатуры.Всего / ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество
			               |	КОНЕЦ КАК Цена,
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Всего КАК Всего,
			               |	&ПустойСчетУчета КАК СчетУчетаРасчетов
			               |ПОМЕСТИТЬ ОстаткиСУчетомДокументовУчета
			               |ИЗ
			               |	Документ.ЭлектронныйДокументПоставщика.СписокНоменклатуры КАК ЭлектронныйДокументПоставщикаСписокНоменклатуры
			               |ГДЕ
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка = &ДокументОснование
			               |	И ТИПЗНАЧЕНИЯ(ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура) = ТИП(Справочник.ДенежныеДокументы)
			               |
			               |ОБЪЕДИНИТЬ ВСЕ
			               |
			               |ВЫБРАТЬ
			               |	ПриходныйОрдерФондовыйРасшифровка.ДенежныйДокумент,
			               |	-1 * ПриходныйОрдерФондовыйРасшифровка.Количество,
			               |	-1 * ПриходныйОрдерФондовыйРасшифровка.Сумма,
			               |	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС),
			               |	0,
			               |	-1 * ПриходныйОрдерФондовыйРасшифровка.Сумма,
			               |	&ВидыНоменклатурыДД,
			               |	""Денежные документы"",
			               |	ВЫБОР
			               |		КОГДА ПриходныйОрдерФондовыйРасшифровка.Количество <> 0
			               |			ТОГДА ПриходныйОрдерФондовыйРасшифровка.Сумма / ПриходныйОрдерФондовыйРасшифровка.Количество
			               |	КОНЕЦ,
			               |	-1 * ПриходныйОрдерФондовыйРасшифровка.Сумма,
			               |	&ПустойСчетУчета
			               |ИЗ
			               |	Документ.ПриходныйОрдерФондовый.Расшифровка КАК ПриходныйОрдерФондовыйРасшифровка
			               |ГДЕ
			               |	ПриходныйОрдерФондовыйРасшифровка.Ссылка.ДокументОснование = &ДокументОснование
			               |	И ПриходныйОрдерФондовыйРасшифровка.Ссылка.ПометкаУдаления = ЛОЖЬ
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ОстаткиСУчетомДокументовУчета.Номенклатура КАК Номенклатура,
			               |	СУММА(ОстаткиСУчетомДокументовУчета.Количество) КАК Количество,
			               |	СУММА(ОстаткиСУчетомДокументовУчета.СуммаБезНДС) КАК СуммаБезНДС,
			               |	ОстаткиСУчетомДокументовУчета.СтавкаНДС КАК СтавкаНДС,
			               |	СУММА(ОстаткиСУчетомДокументовУчета.СуммаНДС) КАК СуммаНДС,
			               |	СУММА(ОстаткиСУчетомДокументовУчета.Сумма) КАК Сумма,
			               |	ОстаткиСУчетомДокументовУчета.КодВидаНоменклатуры КАК КодВидаНоменклатуры,
			               |	ОстаткиСУчетомДокументовУчета.ВидНоменклатуры КАК ВидНоменклатуры,
			               |	ОстаткиСУчетомДокументовУчета.Цена КАК Цена,
			               |	СУММА(ОстаткиСУчетомДокументовУчета.Всего) КАК Всего,
			               |	ОстаткиСУчетомДокументовУчета.СчетУчетаРасчетов КАК СчетУчетаРасчетов
			               |ПОМЕСТИТЬ ИтоговыеДанные
			               |ИЗ
			               |	ОстаткиСУчетомДокументовУчета КАК ОстаткиСУчетомДокументовУчета
			               |
			               |СГРУППИРОВАТЬ ПО
			               |	ОстаткиСУчетомДокументовУчета.Номенклатура,
			               |	ОстаткиСУчетомДокументовУчета.СтавкаНДС,
			               |	ОстаткиСУчетомДокументовУчета.КодВидаНоменклатуры,
			               |	ОстаткиСУчетомДокументовУчета.ВидНоменклатуры,
			               |	ОстаткиСУчетомДокументовУчета.Цена,
			               |	ОстаткиСУчетомДокументовУчета.СчетУчетаРасчетов
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ИтоговыеДанные.Номенклатура КАК Номенклатура,
			               |	ИтоговыеДанные.Количество КАК Количество,
			               |	ИтоговыеДанные.СуммаБезНДС КАК СуммаБезНДС,
			               |	ИтоговыеДанные.СтавкаНДС КАК СтавкаНДС,
			               |	ИтоговыеДанные.СуммаНДС КАК СуммаНДС,
			               |	ИтоговыеДанные.Сумма КАК Сумма,
			               |	ИтоговыеДанные.КодВидаНоменклатуры КАК КодВидаНоменклатуры,
			               |	ИтоговыеДанные.ВидНоменклатуры КАК ВидНоменклатуры,
			               |	ИтоговыеДанные.Цена КАК Цена,
			               |	ИтоговыеДанные.Всего КАК Всего,
			               |	ИтоговыеДанные.СчетУчетаРасчетов КАК СчетУчетаРасчетов
			               |ИЗ
			               |	ИтоговыеДанные КАК ИтоговыеДанные
			               |ГДЕ
			               |	ИтоговыеДанные.Количество > 0";
		Иначе	
			ТекстЗапроса = "ВЫБРАТЬ
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК Номенклатура,
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество КАК Количество,
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Сумма КАК СуммаБезНДС,
			               |	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС) КАК СтавкаНДС,
			               |	0 КАК СуммаНДС,
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Всего КАК Сумма,
			               |	&ВидыНоменклатурыДД КАК КодВидаНоменклатуры,
			               |	""Денежные документы"" КАК ВидНоменклатуры,
			               |	ВЫБОР
			               |		КОГДА ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество <> 0
			               |			ТОГДА ЭлектронныйДокументПоставщикаСписокНоменклатуры.Всего / ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество
			               |	КОНЕЦ КАК Цена,
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Всего КАК Всего,
			               |	&ПустойСчетУчета КАК СчетУчетаРасчетов,
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.НомерСтроки КАК НомерСтроки
			               |ПОМЕСТИТЬ ОстаткиСУчетомДокументовУчета
			               |ИЗ
			               |	Документ.ЭлектронныйДокументПоставщика.СписокНоменклатуры КАК ЭлектронныйДокументПоставщикаСписокНоменклатуры
			               |ГДЕ
			               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка = &ДокументОснование
			               |	И ТИПЗНАЧЕНИЯ(ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура) = ТИП(Справочник.ДенежныеДокументы)
			               |
			               |ОБЪЕДИНИТЬ ВСЕ
			               |
			               |ВЫБРАТЬ
			               |	ПриходныйОрдерФондовыйРасшифровка.ДенежныйДокумент,
			               |	-1 * ПриходныйОрдерФондовыйРасшифровка.Количество,
			               |	-1 * ПриходныйОрдерФондовыйРасшифровка.Сумма,
			               |	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС),
			               |	0,
			               |	-1 * ПриходныйОрдерФондовыйРасшифровка.Сумма,
			               |	&ВидыНоменклатурыДД,
			               |	""Денежные документы"",
			               |	ВЫБОР
			               |		КОГДА ПриходныйОрдерФондовыйРасшифровка.Количество <> 0
			               |			ТОГДА ПриходныйОрдерФондовыйРасшифровка.Сумма / ПриходныйОрдерФондовыйРасшифровка.Количество
			               |	КОНЕЦ,
			               |	-1 * ПриходныйОрдерФондовыйРасшифровка.Сумма,
			               |	&ПустойСчетУчета,
			               |	0
			               |ИЗ
			               |	Документ.ПриходныйОрдерФондовый.Расшифровка КАК ПриходныйОрдерФондовыйРасшифровка
			               |ГДЕ
			               |	ПриходныйОрдерФондовыйРасшифровка.Ссылка.ДокументОснование = &ДокументОснование
			               |	И ПриходныйОрдерФондовыйРасшифровка.Ссылка.ПометкаУдаления = ЛОЖЬ
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ОстаткиСУчетомДокументовУчета.Номенклатура КАК Номенклатура,
			               |	СУММА(ОстаткиСУчетомДокументовУчета.Количество) КАК Количество,
			               |	СУММА(ОстаткиСУчетомДокументовУчета.СуммаБезНДС) КАК СуммаБезНДС,
			               |	ОстаткиСУчетомДокументовУчета.СтавкаНДС КАК СтавкаНДС,
			               |	СУММА(ОстаткиСУчетомДокументовУчета.СуммаНДС) КАК СуммаНДС,
			               |	СУММА(ОстаткиСУчетомДокументовУчета.Сумма) КАК Сумма,
			               |	ОстаткиСУчетомДокументовУчета.КодВидаНоменклатуры КАК КодВидаНоменклатуры,
			               |	ОстаткиСУчетомДокументовУчета.ВидНоменклатуры КАК ВидНоменклатуры,
			               |	ОстаткиСУчетомДокументовУчета.Цена КАК Цена,
			               |	СУММА(ОстаткиСУчетомДокументовУчета.Всего) КАК Всего,
			               |	ОстаткиСУчетомДокументовУчета.СчетУчетаРасчетов КАК СчетУчетаРасчетов,
			               |	ОстаткиСУчетомДокументовУчета.НомерСтроки КАК НомерСтроки
			               |ПОМЕСТИТЬ ИтоговыеДанные
			               |ИЗ
			               |	ОстаткиСУчетомДокументовУчета КАК ОстаткиСУчетомДокументовУчета
			               |
			               |СГРУППИРОВАТЬ ПО
			               |	ОстаткиСУчетомДокументовУчета.Номенклатура,
			               |	ОстаткиСУчетомДокументовУчета.СтавкаНДС,
			               |	ОстаткиСУчетомДокументовУчета.КодВидаНоменклатуры,
			               |	ОстаткиСУчетомДокументовУчета.ВидНоменклатуры,
			               |	ОстаткиСУчетомДокументовУчета.Цена,
			               |	ОстаткиСУчетомДокументовУчета.СчетУчетаРасчетов,
			               |	ОстаткиСУчетомДокументовУчета.НомерСтроки
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ИтоговыеДанные.Номенклатура КАК Номенклатура,
			               |	ИтоговыеДанные.Количество КАК Количество,
			               |	ИтоговыеДанные.СуммаБезНДС КАК СуммаБезНДС,
			               |	ИтоговыеДанные.СтавкаНДС КАК СтавкаНДС,
			               |	ИтоговыеДанные.СуммаНДС КАК СуммаНДС,
			               |	ИтоговыеДанные.Сумма КАК Сумма,
			               |	ИтоговыеДанные.КодВидаНоменклатуры КАК КодВидаНоменклатуры,
			               |	ИтоговыеДанные.ВидНоменклатуры КАК ВидНоменклатуры,
			               |	ИтоговыеДанные.Цена КАК Цена,
			               |	ИтоговыеДанные.Всего КАК Всего,
			               |	ИтоговыеДанные.СчетУчетаРасчетов КАК СчетУчетаРасчетов,
			               |	ИтоговыеДанные.НомерСтроки КАК НомерСтроки
			               |ИЗ
			               |	ИтоговыеДанные КАК ИтоговыеДанные
			               |ГДЕ
			               |	ИтоговыеДанные.Количество > 0
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	НомерСтроки";
		КонецЕсли;
		Запрос.Текст = ТекстЗапроса;
		
		Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
		Запрос.УстановитьПараметр("ВидыНоменклатурыДД", ВидыНоменклатурыДД);  
		Запрос.УстановитьПараметр("ПустойСчетУчета", ПланыСчетов.ЕПСБУ.ПустаяСсылка());  
		Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));  
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		Возврат Результат;
		
	КонецЕсли;
	
	ТипыНоменклатурыУслуг = Новый Массив;
