Функция ЭтоОснованиеЭТрН(СсылкаНаОбъектИсточник) Экспорт
	
	Результат = Ложь;
	
	ТипИсточника = ТипЗнч(СсылкаНаОбъектИсточник);

 	Если ТипИсточника = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		ИЛИ ТипИсточника = Тип("ДокументСсылка.НакладнаяНаОтпускИК")
		ИЛИ ТипИсточника = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
		ИЛИ ТипИсточника = Тип("ДокументСсылка.ПередачаОбъектовИК")
        ИЛИ ТипИсточника = Тип("ДокументСсылка.ПередачаОбъектовОС")
        ИЛИ ТипИсточника = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СписокСчетовНаОплатуПокупателю(Ссылка) Экспорт
	СчетаНаОплатуПокупателю = Новый Массив;

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		ИЛИ ТипЗнч(Ссылка) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		Реквизиты = "ДокументОснование";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты);
		Если ЗначениеЗаполнено(ЗначенияРеквизитов.ДокументОснование) Тогда
			Если ТипЗнч(ЗначенияРеквизитов.ДокументОснование) = Тип("ДокументСсылка.СчетНаОплату") Тогда
				СчетаНаОплатуПокупателю.Добавить(ЗначенияРеквизитов.ДокументОснование);
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат СчетаНаОплатуПокупателю;
КонецФункции

Функция СписокРеализацийПоСчетуПокупателю(СчетНаОплату) Экспорт
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НакладнаяНаОтпускМ15.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.НакладнаяНаОтпускМ15 КАК НакладнаяНаОтпускМ15
	               |ГДЕ
	               |	НакладнаяНаОтпускМ15.ДокументОснование = &ДокументОснование
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НакладнаяНаРеализациюТорг12.Ссылка
	               |ИЗ
	               |	Документ.НакладнаяНаРеализациюТорг12 КАК НакладнаяНаРеализациюТорг12
	               |ГДЕ
	               |	НакладнаяНаРеализациюТорг12.ДокументОснование = &ДокументОснование";

	Запрос.УстановитьПараметр("ДокументОснование", СчетНаОплату);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;	

	Возврат Результат;
КонецФункции

Функция ЭлектронныеДокументыПоОснованию(ДокументыОснования, ТипСсылки = Неопределено) Экспорт 

	Запрос = Новый Запрос;
	Запрос.Текст = Обработки.ЭлектронныеПеревозочныеДокументы.ЗапросПоДокументуОснования();
	
	Обработки.ЭлектронныеПеревозочныеДокументы.ЗаполнитьОбязательныеПараметрыЗапроса(Запрос.Параметры);
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументыОснования);
	Запрос.УстановитьПараметр("НачалоПериода",     Дата(1,1,1));
	Запрос.УстановитьПараметр("КонецПериода",      Дата(1,1,1));
	
	УстановитьПривилегированныйРежим(Истина); 
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь); 
	
	Если ТипСсылки <> Неопределено Тогда
		ТаблицаРезультат = ТаблицаРезультат.Скопировать(Новый Структура("ТипСсылки", ТипСсылки));
	КонецЕсли;
	
	СписокДокументов = Новый СписокЗначений;
	Для каждого СтрокаДокумент Из ТаблицаРезультат Цикл
		ПредставлениеДокумента = СтрШаблон("%1 № %2 от %3 (%4)", 
			СтрокаДокумент.ТипСсылки, 
			ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(СтрокаДокумент.НомерЭПД), 
			Формат(СтрокаДокумент.ДатаЭПД,"ДФ=dd.MM.yyyy"),
			СтрокаДокумент.ПредставлениеСостояния);
		
		СписокДокументов.Добавить(СтрокаДокумент.Ссылка, ПредставлениеДокумента, СтрокаДокумент.СостояниеЭДО = Перечисления.СостоянияДокументовЭДО.ОбменЗавершен);
	КонецЦикла;
	
	Возврат СписокДокументов;
КонецФункции

Функция ДанныеДляЗаполненияЭТрН(Основание) Экспорт
	Возврат ДанныеЗаполненияЭТрН(Основание);
КонецФункции	

Функция ДанныеДляЗаполненияЭЗЗ(Основание) Экспорт
	Если ЭтоОснованиеЭПДСПеревозчиком(Основание) Тогда
		Возврат ДанныеЗаполненияЭЗЗПоДаннымПередачиСПеревозчиком(Основание);
	Иначе
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетНаОплату") Тогда
			Возврат ДанныеЗаполненияЭЗЗПоДаннымСчета(Основание);
		КонецЕсли;
	КонецЕсли;
КонецФункции 

#Область ЗаполнениеЭЗЗ

Функция ДанныеЗаполненияЭЗЗПоДаннымПередачиСПеревозчиком(Основание) 

	Возврат ДанныеЗаполненияЭЗЗПоДаннымСчета(Основание, Истина);	
	
КонецФункции 

Функция ДанныеЗаполненияЭЗЗПоДаннымСчета(Основание, ЕстьПеревозчик = Ложь) 
	ДанныеЗаполнения = Новый Структура;
	
	Если ЕстьПеревозчик Тогда
		СписокРеквизитов = "Организация, Контрагент, 
			|Дата, Номер, Перевозчик";
	Иначе
		СписокРеквизитов = "Организация, Контрагент, 
			|Дата, Номер";
	КонецЕсли;
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Основание, СписокРеквизитов);
	РеквизитыОснования.Дата = ТекущаяДатаСеанса();	

	КонтактныеДанныеXML = ЭлектронныеДокументыБГУ.КонтактныеДанныеXML(РеквизитыОснования.Организация);	
		
	АдресПогрузки = "";
	Если ЗначениеЗаполнено(КонтактныеДанныеXML.ФактическийАдресXML) Тогда
		АдресПогрузки = КонтактныеДанныеXML.ФактическийАдресXML;
	Иначе
		АдресПогрузки = КонтактныеДанныеXML.ЮридическийАдресXML;
	КонецЕсли;	
	
	ДанныеЗаполнения.Вставить("ДокументыОснования", Новый Массив);
	ДанныеЗаполнения.ДокументыОснования.Добавить(Новый Структура("ДокументОснование", Основание));
		
	ДанныеЗаполнения.Вставить("Организация", РеквизитыОснования.Организация);
	
	ДанныеЗаполнения.Вставить("ТитулГрузоотправителяЗаказДата", РеквизитыОснования.Дата);
	
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяГрузоотправитель", РеквизитыОснования.Организация);
	
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		РеквизитыОснования.Организация, 
		"ТитулГрузоотправителяГрузоотправитель", ДанныеЗаполнения, Неопределено);
	
	ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяГрузополучатель", РеквизитыОснования.Контрагент);
	
	ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
		ДанныеЗаполнения.СсылкаТитулГрузоотправителяГрузополучатель, 
		"ТитулГрузоотправителяГрузополучатель", ДанныеЗаполнения, Неопределено);
		
	Если ЕстьПеревозчик Тогда
		Если ЗначениеЗаполнено(РеквизитыОснования.Перевозчик) Тогда	
			ДанныеЗаполнения.Вставить("СсылкаТитулГрузоотправителяПеревозчик", РеквизитыОснования.Перевозчик);
			ОбменСГИСЭПДКлиентСервер.ЗаполнитьРеквизитыУчастника(
				ДанныеЗаполнения.СсылкаТитулГрузоотправителяПеревозчик, 
				"ТитулГрузоотправителяПеревозчик", ДанныеЗаполнения, Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьАдрес(ДанныеЗаполнения, "ТитулГрузоотправителяАдресПогрузки", АдресПогрузки);

	Возврат ДанныеЗаполнения
КонецФункции

Процедура ЗаполнитьАдрес(ДанныеЗаполнения, Префикс, Знач АдресЗначение)

	Если НЕ ЗначениеЗаполнено(АдресЗначение) Тогда
		СтруктураАдреса = РаботаСАдресами.СведенияОбАдресе(АдресЗначение);
		Возврат;
	КонецЕсли; 

	СтруктураАдреса = РаботаСАдресами.СведенияОбАдресе(АдресЗначение);
	
	Если СтруктураАдреса.ТипАдреса = "ВСвободнойФорме" Тогда
		ДанныеЗаполнения.Вставить(Префикс + "Представление",   СтруктураАдреса.Представление);
		ДанныеЗаполнения.Вставить(Префикс + "КодСтраны",       СтруктураАдреса.КодСтраны);
	Иначе	
		ДанныеЗаполнения.Вставить(Префикс + "Индекс",          СтруктураАдреса.Индекс);
		ДанныеЗаполнения.Вставить(Префикс + "КодРегиона",      СтруктураАдреса.КодРегиона);
		ДанныеЗаполнения.Вставить(Префикс + "Город",           СтруктураАдреса.Город 
			+ ?(СтруктураАдреса.ГородТипКраткий = "", "", " ") + СтруктураАдреса.ГородТипКраткий); 
		ДанныеЗаполнения.Вставить(Префикс + "Район",           СтруктураАдреса.Район 
			+ ?(СтруктураАдреса.РайонТипКраткий = "", "", " ") + СтруктураАдреса.РайонТипКраткий);
		ДанныеЗаполнения.Вставить(Префикс + "НаселенныйПункт", СтруктураАдреса.НаселенныйПункт 
			+ ?(СтруктураАдреса.НаселенныйПунктТипКраткий = "", "", " ") + СтруктураАдреса.НаселенныйПунктТипКраткий);
		ДанныеЗаполнения.Вставить(Префикс + "Улица",           СтруктураАдреса.Улица 
			+ ?(СтруктураАдреса.УлицаТипКраткий = "", "", " ") + СтруктураАдреса.УлицаТипКраткий);
		ДанныеЗаполнения.Вставить(Префикс + "Дом",             СтруктураАдреса.Здание.Номер);
		Если СтруктураАдреса.Корпуса.Количество() > 0 Тогда
			ДанныеЗаполнения.Вставить(Префикс + "Корпус",      СтруктураАдреса.Корпуса[0].Номер);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

