Функция СписокОСЭДПоставщикаДляПринятияКУчету(ТипДокументаУчета, ДокументОснование) Экспорт
	
	ВидыНоменклатурыМЗ = 1;
	ВидыНоменклатурыОС = 2;
	ВидыНоменклатурыРУ = 3;
	ВидыНоменклатурыИК = 4;
	ВидыНоменклатурыВТ = 5;
	
	ВидыНоменклатуры = Новый Массив;
	Если ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеМЗ 
		ИЛИ ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеМЗВПути Тогда
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыМЗ);	
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыВТ);	
	ИначеЕсли ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеИК Тогда
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыМЗ);	
	ИначеЕсли ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеОС 
		ИЛИ ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеОСВПути 
		ИЛИ ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПринятиеКУчетуОбъектовОС Тогда
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыОС);	
	ИначеЕсли ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПринятиеКУчетуОбъектовИК
		ИЛИ ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеОСИК Тогда 
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыИК);	
	ИначеЕсли ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеУслугРабот Тогда
		ВидыНоменклатуры.Добавить(ВидыНоменклатурыРУ);	
	КонецЕсли;
	
	ТипыНоменклатурыУслуг = Новый Массив;
	ТипыНоменклатурыУслуг.Добавить(Перечисления.ТипыНоменклатуры.Госуслуга);
	ТипыНоменклатурыУслуг.Добавить(Перечисления.ТипыНоменклатуры.Работа);
	ТипыНоменклатурыУслуг.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
	ТипыНоменклатурыУслуг.Добавить(Перечисления.ТипыНоменклатуры.УслугиАренды);
	ТипыНоменклатурыУслуг.Добавить(Перечисления.ТипыНоменклатуры.ГруппаУслуг);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК Номенклатура,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество КАК Количество,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Сумма КАК Сумма,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.СтавкаНДС КАК СтавкаНДС,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.СуммаНДС КАК СуммаНДС,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Всего КАК Всего,
	               |	ВЫБОР
	               |		КОГДА ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество = 0
	               |			ТОГДА 0
	               |		ИНАЧЕ ЭлектронныйДокументПоставщикаСписокНоменклатуры.Сумма / ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество
	               |	КОНЕЦ КАК Цена,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ВЫБОР
	               |					КОГДА ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Тара)
	               |						ТОГДА 5
	               |					ИНАЧЕ ВЫБОР
	               |							КОГДА ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуг)
	               |								ТОГДА 3
	               |							ИНАЧЕ 1
	               |						КОНЕЦ
	               |				КОНЕЦ
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ТИПЗНАЧЕНИЯ(ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура) = ТИП(Справочник.ОсновныеСредства)
	               |					ТОГДА ВЫБОР
	               |							КОГДА ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура.ИмуществоКазны = ИСТИНА
	               |								ТОГДА 4
	               |							ИНАЧЕ 2
	               |						КОНЕЦ
	               |			КОНЕЦ
	               |	КОНЕЦ КАК КодВидаНоменклатуры,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ВЫБОР
	               |					КОГДА ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Тара)
	               |						ТОГДА ""Возвратная тара""
	               |					ИНАЧЕ ВЫБОР
	               |							КОГДА ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуг)
	               |								ТОГДА ""Услуги, работы""
	               |							ИНАЧЕ ""Материальные запасы""
	               |						КОНЕЦ
	               |				КОНЕЦ
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ТИПЗНАЧЕНИЯ(ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура) = ТИП(Справочник.ОсновныеСредства)
	               |					ТОГДА ВЫБОР
	               |							КОГДА ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.Казна)
	               |								ТОГДА ""ОС (имущество казны)""
	               |							ИНАЧЕ ""ОС, НМА, НПА""
	               |						КОНЕЦ
	               |			КОНЕЦ
	               |	КОНЕЦ КАК ВидНоменклатуры,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.СуммаАмортизации КАК СуммаАмортизации,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.СуммаОбесценения КАК СуммаОбесценения,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.СчетУчета КАК СчетУчета,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.СтранаПроисхождения КАК СтранаПроисхождения,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.НомерСтроки КАК НомерСтроки
	               |ПОМЕСТИТЬ ИтоговыеДанные
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика.СписокНоменклатуры КАК ЭлектронныйДокументПоставщикаСписокНоменклатуры
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка = &ДокументОснование
	               |	И ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество > 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИтоговыеДанные.Номенклатура КАК Номенклатура,
	               |	ИтоговыеДанные.Количество КАК Количество,
	               |	ИтоговыеДанные.Сумма КАК Сумма,
	               |	ИтоговыеДанные.СтавкаНДС КАК СтавкаНДС,
	               |	ИтоговыеДанные.СуммаНДС КАК СуммаНДС,
	               |	ИтоговыеДанные.Всего КАК Всего,
	               |	ИтоговыеДанные.Цена КАК Цена,
	               |	ИтоговыеДанные.КодВидаНоменклатуры КАК КодВидаНоменклатуры,
	               |	ИтоговыеДанные.ВидНоменклатуры КАК ВидНоменклатуры,
	               |	ИтоговыеДанные.СуммаАмортизации КАК СуммаАмортизации,
	               |	ИтоговыеДанные.СуммаОбесценения КАК СуммаОбесценения,
	               |	ИтоговыеДанные.СчетУчета КАК СчетУчета,
	               |	ИтоговыеДанные.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	               |	ИтоговыеДанные.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ИтоговыеДанные.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	               |	ИтоговыеДанные.СтранаПроисхождения КАК СтранаПроисхождения,
	               |	ИтоговыеДанные.НомерСтроки КАК НомерСтроки
	               |ИЗ
	               |	ИтоговыеДанные КАК ИтоговыеДанные
	               |ГДЕ
	               |	ИтоговыеДанные.КодВидаНоменклатуры В(&ВидыНоменклатуры)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ВидыНоменклатуры", ВидыНоменклатуры);  
	Запрос.УстановитьПараметр("ТипыНоменклатурыУслуг", ТипыНоменклатурыУслуг);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция ВидНоменклатурыОрганизации(Номенклатура) Экспорт
	Результат = "";
	
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		ТипНоменклатуры = Номенклатура.ТипНоменклатуры;
		Результат = НСтр("ru='Материальные запасы'");
		Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Тара Тогда
			Результат = НСтр("ru='Возвратная тара'");
		ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа
			ИЛИ ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга
			ИЛИ ТипНоменклатуры = Перечисления.ТипыНоменклатуры.УслугиАренды
			ИЛИ ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Госуслуга Тогда
			Результат = НСтр("ru='Услуги, работы'");
		КонецЕсли;	
	ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		ВидНФА = Номенклатура.ВидНФА;
		Результат = НСтр("ru='ОС, НМА, НПА'");
		Если ВидНФА = Перечисления.ВидыНФА.Казна Тогда
			Результат = НСтр("ru='ОС (имущество казны)'");
		КонецЕсли;	
	ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ДенежныеДокументы") Тогда
		Результат = НСтр("ru='Денежные документы'");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЧислоЗнаковПослеЗапятой(Знач ЗначениеЧисла) Экспорт
	Результат = 0;
	Если ЗначениеЧисла = 0 Тогда
		Возврат Результат;
	КонецЕсли;	
	
	ЗначениеЧислаСтрокой = СтрЗаменить(Строка(Число(ЗначениеЧисла))," ", "");
	РезультатПоиска = Найти(ЗначениеЧислаСтрокой, ",");
	Если РезультатПоиска > 0 Тогда
		Результат = СтрДлина(Сред(ЗначениеЧислаСтрокой, РезультатПоиска + 1));
	Иначе
		РезультатПоиска = Найти(ЗначениеЧислаСтрокой, ".");
		Если РезультатПоиска > 0 Тогда
			Результат = СтрДлина(Сред(ЗначениеЧислаСтрокой, РезультатПоиска + 1));
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция КоэффициентНастройкиПересчетаКоличества(ЕдиницаИзмеренияПоставщика, ЕдиницаИзмеренияОрганизации) Экспорт
	
	Результат = 1;
	
	Если НЕ ЗначениеЗаполнено(ЕдиницаИзмеренияПоставщика) Тогда
		Результат = 1;
		
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЕдиницаИзмеренияОрганизации) Тогда
		Результат = 1;
		
		Возврат Результат;
	КонецЕсли;
	
	Если ЕдиницаИзмеренияПоставщика = ЕдиницаИзмеренияОрганизации Тогда
		Результат = 1;
	Иначе	
		ЗначенияРеквизитовЕдИзмПоставщика = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдиницаИзмеренияПоставщика, "ТипИзмеряемойВеличины, Числитель, Знаменатель");
		ЗначенияРеквизитовЕдИзмОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдиницаИзмеренияОрганизации, "ТипИзмеряемойВеличины, Числитель, Знаменатель");
		
		Если (ЗначенияРеквизитовЕдИзмПоставщика.Знаменатель = 0) ИЛИ (ЗначенияРеквизитовЕдИзмОрганизации.Числитель = 0) Тогда
			Результат = 1;
		Иначе	
			Если ЗначенияРеквизитовЕдИзмПоставщика.ТипИзмеряемойВеличины = ЗначенияРеквизитовЕдИзмОрганизации.ТипИзмеряемойВеличины Тогда
				Результат = (ЗначенияРеквизитовЕдИзмПоставщика.Числитель * ЗначенияРеквизитовЕдИзмОрганизации.Знаменатель)/
					(ЗначенияРеквизитовЕдИзмПоставщика.Знаменатель * ЗначенияРеквизитовЕдИзмОрганизации.Числитель);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция КодВидаНоменклатурыОрганизации(Номенклатура) Экспорт
	Результат = "";
	
	ВидыНоменклатурыМЗ = 1;
	ВидыНоменклатурыОС = 2;
	ВидыНоменклатурыРУ = 3;
	ВидыНоменклатурыИК = 4;
	ВидыНоменклатурыВТ = 5;
	
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		ТипНоменклатуры = Номенклатура.ТипНоменклатуры;
		Результат = ВидыНоменклатурыМЗ;
		Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Тара Тогда
			Результат = ВидыНоменклатурыВТ;
		ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа
			ИЛИ ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга
			ИЛИ ТипНоменклатуры = Перечисления.ТипыНоменклатуры.УслугиАренды
			ИЛИ ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Госуслуга Тогда
			Результат = ВидыНоменклатурыРУ;
		КонецЕсли;	
	ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		ВидНФА = Номенклатура.ВидНФА;
		Результат = ВидыНоменклатурыОС;
		Если ВидНФА = Перечисления.ВидыНФА.Казна Тогда
			Результат = ВидыНоменклатурыИК;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЕдиницаИзмеренияПоКоду(КодЕдиницыИзмерения) Экспорт
	Возврат Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(КодЕдиницыИзмерения);		
КонецФункции

Процедура СоздатьНоменклатуруЭДО(ПараметрыНоменклатуры, НоменклатураПоставщика) Экспорт
	Организация = ПараметрыНоменклатуры.Организация;
	ТипНоменклатурыЭДО = ПараметрыНоменклатуры.ТипНоменклатурыЭДО;
	ТипНоменклатуры = ПараметрыНоменклатуры.ТипНоменклатуры;
	ВидНФА = ПараметрыНоменклатуры.ВидНФА;
	ТипНФА = ПараметрыНоменклатуры.ТипНФА;
	РодительОСНМАНПА = ПараметрыНоменклатуры.РодительОСНМАНПА;
	РодительНоменклатуры = ПараметрыНоменклатуры.РодительНоменклатуры;
	ВидДенежногоДокумента = ПараметрыНоменклатуры.ВидДенежногоДокумента;
	СерияДенежногоДокумента = ПараметрыНоменклатуры.СерияДенежногоДокумента;
	НомерДенежногоДокумента = ПараметрыНоменклатуры.НомерДенежногоДокумента;
	ЕдиницаИзмерения = ПараметрыНоменклатуры.ЕдиницаИзмерения;
	НомСтоимость = ПараметрыНоменклатуры.НомСтоимость;
	ВидКонтроляПродукции = ПараметрыНоменклатуры.ВидКонтроляПродукции;
	КодТНВЭД = ПараметрыНоменклатуры.КодТНВЭД;
	ОКП = ПараметрыНоменклатуры.ОКП;
	СтранаПроисхождения = ПараметрыНоменклатуры.СтранаПроисхождения; 
	КодНоменклатуры = ПараметрыНоменклатуры.КодНоменклатуры; 
	КодПоКТРУ = ПараметрыНоменклатуры.КодПоКТРУ;
	ПодконтрольнаяПродукцияВЕТИС = ПараметрыНоменклатуры.ПодконтрольнаяПродукцияВЕТИС;
	
	УстановитьПривилегированныйРежим(Истина);

