Функция СписокДоступнойНоменклатурыУслугРаботБезКоличестваЭДПоставщика(ДокументОснование) Экспорт
	ТипыНоменклатурыУслуг = Новый Массив;
	ТипыНоменклатурыУслуг.Добавить(Перечисления.ТипыНоменклатуры.Госуслуга);
	ТипыНоменклатурыУслуг.Добавить(Перечисления.ТипыНоменклатуры.Работа);
	ТипыНоменклатурыУслуг.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
	ТипыНоменклатурыУслуг.Добавить(Перечисления.ТипыНоменклатуры.УслугиАренды);
	ТипыНоменклатурыУслуг.Добавить(Перечисления.ТипыНоменклатуры.ГруппаУслуг);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК Номенклатура,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество КАК Количество,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Сумма КАК Сумма,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.СтавкаНДС КАК СтавкаНДС,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.СуммаНДС КАК СуммаНДС,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Всего КАК Всего,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ВЫБОР
	               |					КОГДА ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуг)
	               |						ТОГДА 3
	               |				КОНЕЦ
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК КодВидаНоменклатуры,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.НомерСтроки КАК НомерСтроки
	               |ПОМЕСТИТЬ ИтоговыйСписокНоменклатуры
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика.СписокНоменклатуры КАК ЭлектронныйДокументПоставщикаСписокНоменклатуры
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка = &ДокументОснование
	               |	И ЭлектронныйДокументПоставщикаСписокНоменклатуры.Количество = 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИтоговыйСписокНоменклатуры.Номенклатура КАК Номенклатура,
	               |	ИтоговыйСписокНоменклатуры.Количество КАК Количество,
	               |	ИтоговыйСписокНоменклатуры.Сумма КАК Сумма,
	               |	ИтоговыйСписокНоменклатуры.СтавкаНДС КАК СтавкаНДС,
	               |	ИтоговыйСписокНоменклатуры.СуммаНДС КАК СуммаНДС,
	               |	ИтоговыйСписокНоменклатуры.Всего КАК Всего,
	               |	ИтоговыйСписокНоменклатуры.КодВидаНоменклатуры КАК КодВидаНоменклатуры,
	               |	ИтоговыйСписокНоменклатуры.НомерСтроки КАК НомерСтроки
	               |ИЗ
	               |	ИтоговыйСписокНоменклатуры КАК ИтоговыйСписокНоменклатуры
	               |ГДЕ
	               |	ИтоговыйСписокНоменклатуры.КодВидаНоменклатуры = 3
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ТипыНоменклатурыУслуг", ТипыНоменклатурыУслуг);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
