Функция ЭтоМаркируемыйТовар(НоменклатураСсылка) Экспорт
	ЭтоРазрешенныеСправочники = Ложь;
	
	Если ТипЗнч(НоменклатураСсылка) = Тип("СправочникСсылка.Номенклатура")
		ИЛИ ТипЗнч(НоменклатураСсылка) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		ЭтоРазрешенныеСправочники = Истина;
	КонецЕсли;
	Если НЕ ЭтоРазрешенныеСправочники Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	МассивНоменклатуры = Новый Массив;
	МассивНоменклатуры.Добавить(НоменклатураСсылка);
	
	СписокМаркируемыхТоваров = ЭлектронныеДокументыБГУ.ПолучитьМаркируемыеТовары(МассивНоменклатуры);
	
	Если СписокМаркируемыхТоваров.Количество() = 0 Тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
	
КонецФункции

Функция ЭтоМаркируемыйТоварОбъемноСортовогоУчета(НоменклатураСсылка) Экспорт
	ДанныеНоменклатуры = Новый Массив;
	ДанныеНоменклатуры.Добавить(НоменклатураСсылка);
	СписокМаркируемыхТоваров = ЭлектронныеДокументыБГУ.ПолучитьМаркируемыеТоварыОбъемноСортовогоУчета(ДанныеНоменклатуры);
	Если СписокМаркируемыхТоваров.Количество() = 0 Тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
КонецФункции

Функция ДокументЭДПоставщикаВведенНаОснованииВходящегоИзвещения(ДокументЭДП) Экспорт
	Результат = Документы.ИзвещениеВходящее.ПустаяСсылка();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйДокументПоставщика.Извещение КАК Извещение
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика КАК ЭлектронныйДокументПоставщика
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщика.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументЭДП);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Извещение) Тогда
			Результат = Выборка.Извещение;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

