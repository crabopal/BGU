// Функция - Получить массив сериализаторов
// Возвращаемое значение:
//  массив - массив содержащий название используемых в системе сериализаторов
Функция ПолучитьМассивСериализаторов() Экспорт 
	
	Результат = Новый Массив;
	
	Результат.Добавить("СериализацияБюджетнаяОтчетностьБаза");
	Результат.Добавить("СериализацияУниверсальнаяОтчетностьМета");
	
	Если ОбщегоНазначения.ПодсистемаСуществует("УчетГосУчрежденийПодсистемы.РегламентированнаяБухОтчетность.ЗаполнениеРегламентированнойБухгалтерскойОтчетности") Тогда 
		Результат.Добавить("СериализацияПравилаЗаполненияОтчетности");
	КонецЕсли;	
	
	Если ОбщегоНазначения.ПодсистемаСуществует("УчетГосУчрежденийПодсистемы.РегламентированнаяБухОтчетность.МакетыОтображения") Тогда 
		Результат.Добавить("СериализацияМакетовОтображения");
	КонецЕсли;	
	
	СериализацияПереопределяемый.ПриЗаполненииМассиваСериализаторов(Результат);
		
	Возврат Результат;
		
КонецФункции	
