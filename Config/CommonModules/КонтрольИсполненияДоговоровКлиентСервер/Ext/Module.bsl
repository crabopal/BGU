#Область СлужебныйПрограммныйИнтерфейс

// Механизм "Запланировать оплату со сроком исполнения".

Процедура ЗапланироватьОплатуУстановитьВидимостьЭлементов(Форма, ИспользоватьКонтрольИсполненияДоговоров, ВестиГрафикПлатежей, ВидОперации = Неопределено) Экспорт
	
	ДоступностьЭлементовЗапланироватьОплату = Не ЗначениеЗаполнено(ВидОперации) ИЛИ
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика") ИЛИ // ИзвещениеИсходящее
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыПоступленийМЗ.ПоступлениеОтПоставщика") ИЛИ // ПоступлениеМЗ
		ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыПередачиМЗ.Реализация"); // НакладнаяНаОтпускМ15
	
	ЭлементыЗапланироватьОплату = Новый Массив;
	ЭлементыЗапланироватьОплату.Добавить("ЗапланироватьОплату");
	ЭлементыЗапланироватьОплату.Добавить("ОплатитьДо");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыЗапланироватьОплату, "Видимость", ИспользоватьКонтрольИсполненияДоговоров И ВестиГрафикПлатежей И ДоступностьЭлементовЗапланироватьОплату);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ОплатитьДоРасширеннаяПодсказка", "Заголовок",
		НСтр("ru='Запланировать оплату (погашение задолженности) на указанную дату (предельную дату исполнения), с которой задолженность будет считаться просроченной.
		|В график платежей будет автоматически добавлена информация об ожидаемом платеже (погашении задолженности) в размере итоговой суммы расчетов по документу за вычетом суммы зачтенного аванса.
		|Крайний срок оплаты (предельная дата исполнения) рассчитываются на основе параметров, указанных в договоре с контрагентом (закладка ""Расчеты"").'"));
	
КонецПроцедуры

Процедура ЗапланироватьОплатуУстановитьДоступностьОплатитьДо(Форма, ЗапланироватьОплату) Экспорт
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ОплатитьДо", "Доступность", ЗапланироватьОплату);
	
КонецПроцедуры

// Конструктор графиков по договорам с контрагентами.

Функция ПериодКратенКалендарномуМесяцу(НачалоПериода, КонецПериода) Экспорт
	
	Возврат ( НачалоДня(НачалоПериода) = НачалоМесяца(НачалоПериода) )
			И ( КонецДня(КонецПериода) = КонецМесяца(КонецПериода) );
	
КонецФункции

Функция ПериодКратенКалендарномуКварталу(НачалоПериода, КонецПериода) Экспорт
	
	Возврат ( НачалоДня(НачалоПериода) = НачалоКвартала(НачалоПериода) )
			И ( КонецДня(КонецПериода) = КонецКвартала(КонецПериода) );
	
КонецФункции

Функция ПериодКратенКалендарномуПолугодию(НачалоПериода, КонецПериода) Экспорт
	
	Возврат ПериодКратенКалендарномуКварталу(НачалоПериода, КонецПериода)
			И ( Месяц(НачалоПериода) = 1 ИЛИ Месяц(НачалоПериода) = 7 )
			И ( Месяц(КонецПериода) = 6 ИЛИ Месяц(КонецПериода) = 12 );
	
КонецФункции

Функция ПериодКратенКалендарномуГоду(НачалоПериода, КонецПериода) Экспорт
	
	Возврат ( НачалоДня(НачалоПериода) = НачалоГода(НачалоПериода) )
			И ( КонецДня(КонецПериода) = КонецГода(КонецПериода) );
	
КонецФункции


#КонецОбласти
