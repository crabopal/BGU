// Требование накладная использует КЭК440.
// 
// Параметры:
//  Объект - ДокументОбъект.ТребованиеНакладная0315006 -
//         - см. Документ.ТребованиеНакладная0315006.Форма.ФормаДокумента.Объект
//  Счета105 - Массив из ПланСчетовСсылка.ЕПСБУ -
//           - Неопределено - Счета105
// 
// Возвращаемое значение:
//  Булево - Требование накладная использует КЭК440
Функция ТребованиеНакладнаяИспользуетКЭК440(Объект, Знач Счета105 = Неопределено) Экспорт
	Если Объект.ВидПеремещения <> Перечисления.ВидыПеремещенияМЗ.ДвижениеМатериалов Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Счета105 = Неопределено Тогда
		Счета105 = БухгалтерскийУчет.СписокСчетов("105.00", Объект.Дата, , Объект.Организация);
	КонецЕсли;
	Возврат Счета105.Найти(Объект.КорСчет) = Неопределено;
КонецФункции

#КонецОбласти

