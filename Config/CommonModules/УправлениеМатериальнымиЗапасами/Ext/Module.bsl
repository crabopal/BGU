			НастройкаСубконтоСчета = Новый Структура("ЦМО, ДопАналитика, ДопИзмерение, ДопИзмерениеВидСубконто");
			СвойстваЗабалансовогоСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Документ.ЗабалансовыйСчет);
			Для НомерСубконто = 1 По СвойстваЗабалансовогоСчета.КоличествоСубконто Цикл
				ТекущийВидСубконто = СвойстваЗабалансовогоСчета["ВидСубконто" + НомерСубконто]; 
