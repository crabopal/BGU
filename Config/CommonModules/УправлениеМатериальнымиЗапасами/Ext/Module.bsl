	ИначеЕсли ЕстьТабЧастьОсновныеСредства Тогда
		
		ИмяТабЧасти = "ОсновныеСредства";
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ОсновныеСредства",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,ПодразделениеПолучатель,ЦМОПолучатель,
			|СчетУчета,Номенклатура,ЦМО,ДополнительнаяАналитикаСчета,Количество",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""ОсновныеСредства"" КАК ИмяСписка,
		|	""Основные средства"" КАК СинонимСписка,
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ИФО КАК ИФО,
		|	ОсновныеСредства.КФО КАК КФО,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.Подразделение КАК Подразделение,
		|	ОсновныеСредства.Подразделение КАК ПодразделениеПолучатель,
		|	ЕСТЬNULL(ОсновныеСредства.СчетУчета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
		|	ЕСТЬNULL(ОсновныеСредства.СчетУчета.РазрешитьНеУказыватьПодразделение, ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
		|	ОсновныеСредства.СчетУчета КАК СчетУчета,
		|	ОсновныеСредства.Номенклатура КАК Номенклатура,
		|	ОсновныеСредства.ДополнительнаяАналитикаСчета КАК ДопАналитика,
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК ДопИзмерениеВидСубконто,
		|	ОсновныеСредства.ЦМО КАК ДопИзмерение,
		|	ОсновныеСредства.ЦМО КАК ДопИзмерениеПолучатель,
		|	ОсновныеСредства.Количество КАК Количество
		|ИЗ
		|	ТаблицаОсновныеСредства КАК ОсновныеСредства
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	Иначе
		Возврат ТаблицаДокумента;
	КонецЕсли;
	
	ЕстьРеквизитКФОТабЧасти = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента(
		"КФО", МетаданныеДокумента, ИмяТабЧасти);
	ЕстьРеквизитДопАналитикаТабЧасти = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента(
		"ДополнительнаяАналитикаСчета", МетаданныеДокумента, ИмяТабЧасти);

	Если Не ИспользоватьМенеджерДокумента Тогда
		// Если есть ПодразделениеПолучатель или ЦМОПолучатель, берем данные из них.
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ПодразделениеПолучатель", МетаданныеДокумента)
		 ИЛИ ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("ПодразделениеПолучатель", МетаданныеДокумента, ИмяТабЧасти)
		 ИЛИ (Параметры.Свойство("ПодразделениеПолучатель") И ЗначениеЗаполнено(Параметры.ПодразделениеПолучатель)) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст,
				"Подразделение КАК ПодразделениеПолучатель",
				"ПодразделениеПолучатель КАК ПодразделениеПолучатель");
		КонецЕсли;
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ЦМОПолучатель", МетаданныеДокумента)
		 ИЛИ ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("ЦМОПолучатель", МетаданныеДокумента, ИмяТабЧасти)
		 ИЛИ (Параметры.Свойство("ЦМОПолучатель") И ЗначениеЗаполнено(Параметры.ЦМОПолучатель)) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст,
				"ЦМО КАК ДопИзмерениеПолучатель",
				"ЦМОПолучатель КАК ДопИзмерениеПолучатель");
		КонецЕсли;
		
		Если Параметры.ПоВсемКФО Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Материалы.КФО",        "ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТабНоменклатура.КФО",  "ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОсновныеСредства.КФО", "ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
		КонецЕсли;
		
		Если Не ЕстьРеквизитДопАналитикаТабЧасти Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Материалы.ДополнительнаяАналитикаСчета", "НЕОПРЕДЕЛЕНО");
		КонецЕсли;
		
		СписаниеМатериальныхЗапасов = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	ВидыДопАналитики = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительнойАналитикиУчетаМЗ();
	ОбязательноУказыватьПодразделение = Ложь;
	ВедетсяУчетПоЦМО = Ложь;
	ПроверятьЗаполнение = Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "НеПроверятьЗаполнение", Ложь);
	
	Для Каждого Строка Из СписаниеМатериальныхЗапасов Цикл
		
		Если ПроверятьЗаполнение И НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'Номенклатура'"), Строка.НомерСтроки, Строка.СинонимСписка);
			ПолеКолонки = Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].Номенклатура";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка, ПолеКолонки, "Объект", Отказ);
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если ТипЗнч(Документ.Ссылка) <> Тип("ДокументСсылка.ОприходованиеМЗПоФактическойСтоимости")
			И ТипЗнч(Документ.Ссылка) <> Тип("ДокументСсылка.ОприходованиеМЗПоФактическойСтоимостиИК")
			И БухгалтерскийУчет.СчетВИерархии(НоваяСтрока.СчетУчета, "106.00") Тогда
			НоваяСтрока.ДопАналитика = Неопределено;
		КонецЕсли;
		НоваяСтрока.ДопАналитикаВидСубконто = ВидыДопАналитики.Получить(Строка.СчетУчета);
		
		Если ПроверятьЗаполнение Тогда
			ОбязательноУказыватьПодразделение = ОбязательноУказыватьПодразделение
				ИЛИ (Строка.УчетПоПодразделениям И НЕ Строка.РазрешитьНеУказыватьПодразделение);
			ВедетсяУчетПоЦМО = ВедетсяУчетПоЦМО ИЛИ БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоЦМО(Строка.СчетУчета);
		КонецЕсли;
		
		Если ПроверятьЗаполнение И НЕ ЗначениеЗаполнено(Строка.СчетУчета) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru='Счет учета'"), Строка.НомерСтроки, Строка.СинонимСписка);
			ПолеСчетУчета = Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].СчетУчета";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка, ПолеСчетУчета, "Объект", Отказ);
		КонецЕсли;
		
		Если ПроверятьЗаполнение
		   И ЕстьРеквизитКФОТабЧасти И НЕ Параметры.ПоВсемКФО И НЕ ЗначениеЗаполнено(Строка.КФО) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru='КФО'"), Строка.НомерСтроки, Строка.СинонимСписка);
			ПолеКФО = Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].КФО";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка, ПолеКФО, "Объект", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.КЭК) Тогда
			НоваяСтрока.КЭК = БухгалтерскийУчет.КЭКНоменклатуры(Документ.Организация, НоваяСтрока.ИФО, НоваяСтрока.КФО,
																Документ.Дата, НоваяСтрока.СчетУчета,
																ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.Номенклатура, "ТипНоменклатуры"), "Кт");

		КонецЕсли;
		
	КонецЦикла;
	
	// КФО.
	Если ПроверятьЗаполнение И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("КФО", МетаданныеДокумента)
	   И НЕ Параметры.ПоВсемКФО И НЕ ЗначениеЗаполнено(Документ.КФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", МетаданныеДокумента.Реквизиты.КФО.Синоним);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			Документ.Ссылка, "КФО", "Объект", Отказ);
	КонецЕсли;

	Если ПроверятьЗаполнение
	   И ВедетсяУчетПоЦМО И ЗначениеЗаполнено(ИмяРеквизитаЦМО) И НЕ ЗначениеЗаполнено(Документ[ИмяРеквизитаЦМО]) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", МетаданныеДокумента.Реквизиты[ИмяРеквизитаЦМО].Синоним);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			Документ.Ссылка, ИмяРеквизитаЦМО, "Объект", Отказ);
	КонецЕсли;
	
	Если ПроверятьЗаполнение
	   И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ОбязательноУказыватьПодразделение
	   И ЗначениеЗаполнено(ИмяРеквизитаПодразделение) И НЕ ЗначениеЗаполнено(Документ[ИмяРеквизитаПодразделение])
	   И НЕ ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ТаксировкаПутевогоЛиста") // В документах ТаксировкаПутевогоЛиста реквизит шапки Подразделение используется иначе.
	   И НЕ ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ТаксировкаРабочегоЛистаАгрегата") Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", МетаданныеДокумента.Реквизиты[ИмяРеквизитаПодразделение].Синоним);
		ТекстСообщения = ТекстСообщения + НСтр("ru='. Учет материальных запасов ведется по подразделениям.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			Документ.Ссылка, ИмяРеквизитаПодразделение, "Объект", Отказ);
	КонецЕсли;
	
	// Если на счете вместо субконто ЦМО используется Контрагенты,
	// то это субконто используется в колонке ДопИзмерение, чтобы ДопАналитика была свободна.
	ПеренестиКонтрагентаВДопИзмерение(ТаблицаДокумента);
	
	Возврат ТаблицаДокумента;
	
КонецФункции

Процедура ПеренестиКонтрагентаВДопИзмерение(ТаблицаДокумента)
	
	КэшСчетов = Новый Соответствие;
	ВидыДопСубконто3 = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительногоСубконтоУчетаМЗ();
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		ТребуетсяПеренос = КэшСчетов.Получить(СтрокаДокумента.СчетУчета);
		Если ТребуетсяПеренос = Неопределено Тогда
			СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаДокумента.СчетУчета);
			ЕстьСубконтоКонтрагенты = Ложь;
			ЕстьСубконтоЦМО = Ложь;
			Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
				ВидСубконто = СвойстваСчета["ВидСубконто" + НомерСубконто]; // ПланВидовХарактеристикСсылка.ВидыСубконто
				ВидДопСубконто3 = ВидыДопСубконто3.Получить(СтрокаДокумента.СчетУчета);
				Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО И ВидДопСубконто3 <> ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
					ЕстьСубконтоЦМО = Истина;
					Прервать;
				КонецЕсли;
				Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
					ЕстьСубконтоКонтрагенты = Истина;
				КонецЕсли;
			КонецЦикла;
			ТребуетсяПеренос = Не ЕстьСубконтоЦМО И ЕстьСубконтоКонтрагенты;
			КэшСчетов.Вставить(СтрокаДокумента.СчетУчета);
		КонецЕсли;
		
		Если Не ТребуетсяПеренос Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДокумента.ДопАналитикаВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
			
			Если ЗначениеЗаполнено(СтрокаДокумента.ДопИзмерение) Тогда
				ЗначениеЗамены    = СтрокаДокумента.ДопИзмерение;
				ЗначениеЗаменыВид = СтрокаДокумента.ДопИзмерениеВидСубконто;
			Иначе
				ЗначениеЗамены    = ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
				ЗначениеЗаменыВид = Неопределено;
			КонецЕсли;
			
			СтрокаДокумента.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
			СтрокаДокумента.ДопИзмерение = СтрокаДокумента.ДопАналитика;
			
			СтрокаДокумента.ДопАналитикаВидСубконто = ЗначениеЗаменыВид;
			СтрокаДокумента.ДопАналитика = ЗначениеЗамены;
			
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Структура таблицы источника данных "Списание материальных запасов"
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица списание материальных запасов:
// * ВидУчета - Строка -
// * ИмяСписка - Строка -
// * СинонимСписка - Строка -
// * НомерСтроки - Число -
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения -
// * КФО - ПеречислениеСсылка.КВД -
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * КЭК - СправочникСсылка.КОСГУ -
// * Подразделение - СправочникСсылка.Подразделения -
// * СчетУчета - ПланСчетовСсылка.ЕПСБУ -
// * Номенклатура - СправочникСсылка.Номенклатура -
// * ДопИзмерение - Характеристика.ВидыСубконто - ЦМО, Контрагент, ВидЗатрат и пр.
// * ДопИзмерениеВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто -
// * ДопАналитика - Характеристика.ВидыСубконто - Реквизит ДополнительнаяАналитикаСчета табчасти
// * ДопАналитикаВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто -
// * Партия - Характеристика.ВидыСубконто -
// * ПартияВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто -
// * ПодразделениеПолучатель - СправочникСсылка.Подразделения -
// * ДопИзмерениеПолучатель - Характеристика.ВидыСубконто -
// * Количество - Число -
// * Стоимость - Число -
// * СтоимостьНеУчитываетсяН - Число - 
// * СтоимостьЕНВД - Число -
// * ОстатокПревышен - Булево -
// * Валюта - СправочникСсылка.Валюты -
// * КатегорияДовольствующихся - СправочникСсылка.КатегорииДовольствующихся -
// * СуммаВал - Число -
// * КоличествоДовольствующихс - Число - 
// * СуммаНДСВал - Число -
// * СчетЗатрат - ПланСчетовСсылка.ЕПСБУ -
// * СуммаРуб - Число -
// * КПСЗатрат - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * СуммаНДСРуб - Число -
// * КЭКЗатрат - СправочникСсылка.КОСГУ -
// * РазницаСтоимостиРуб - Число -
// * ПодразделениеЗатрат - СправочникСсылка.Подразделения -
// * РазницаСтоимостиВал - Число -
// * СубконтоЗатрат1 - Характеристика.ВидыСубконто -
// * СубконтоЗатрат2 - Характеристика.ВидыСубконто -
// * СубконтоЗатрат3 - Характеристика.ВидыСубконто -
Функция ПустаяТаблицаСписаниеМатериальныхЗапасов() Экспорт

	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто  = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Вид учета: БУ - бух.учет, НУ - налоговый учет по налогу на прибыль.
	ПустаяТаблица.Колонки.Добавить("ВидУчета",      ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(3));
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета материальных запасов.
	ПустаяТаблица.Колонки.Добавить("СчетУчета",               Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",            Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("ДопИзмерение",            ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.
	ПустаяТаблица.Колонки.Добавить("ДопИзмерениеВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ПустаяТаблица.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ПустаяТаблица.Колонки.Добавить("ДопАналитикаВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ПустаяТаблица.Колонки.Добавить("Партия",                  ПланыВидовХарактеристик.ВидыСубконто.Партии.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("ПартияВидСубконто",       Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	
	// Получатель материальных запасов.
	ПустаяТаблица.Колонки.Добавить("ПодразделениеПолучатель", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("ДопИзмерениеПолучатель",  ОписаниеТиповСубконто);
	
	// Порядок отражения в налоговом учете при УСН.
	//ПустаяТаблица.Колонки.Добавить("ОтражениеВУСН", Новый ОписаниеТипов("ПеречислениеСсылка.ОтражениеВУСН"));
	
	// Количество и стоимость списанных материальных запасов.
	ПустаяТаблица.Колонки.Добавить("Количество",               ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("Стоимость",                ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СтоимостьНеУчитываетсяНУ", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СтоимостьЕНВД",            ОписаниеТипаСуммы);
	
	// Признак превышения остатка материальных запасов.
	ПустаяТаблица.Колонки.Добавить("ОстатокПревышен", Новый ОписаниеТипов("Булево"));
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Списание материальных запасов".
//
// Параметры:
//  ТаблицаДокумента - см. ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу
//  Реквизиты - Структура -
//  Отказ - Булево -
//  
// Возвращаемое значение:
//  ТаблицаЗначений - см. ПустаяТаблицаСписаниеМатериальныхЗапасов
//
Функция ТаблицаСписаниеМатериальныхЗапасов(ТаблицаДокумента, Реквизиты, Отказ) Экспорт
	
	ТаблицаСписанных = ПустаяТаблицаСписаниеМатериальныхЗапасов();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаСписанных;
	КонецЕсли;
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ПлательщикНалогаНаПрибыль",        УчетнаяПолитика.ПлательщикНалогаНаПрибыль);
	
	Если ТаблицаДокумента.Колонки.Найти("ВидУчета") = Неопределено Тогда
		ТаблицаДокумента.Колонки.Вставить(0, "ВидУчета", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(3));
		ТаблицаДокумента.ЗаполнитьЗначения("БУ", "ВидУчета");
	КонецЕсли;
	
	Если Реквизиты.ПлательщикНалогаНаПрибыль
	   И НЕ (Реквизиты.Свойство("НеСписыватьПоНУ") И Реквизиты.НеСписыватьПоНУ) Тогда
		ТаблицаДокумента = ДобавитьСтрокиСписанияПоНалоговомуУчету(ТаблицаДокумента, Реквизиты);
	КонецЕсли;
	
	Счета106 = Новый Соответствие;
	Для Каждого Счет Из БухгалтерскийУчет.СписокСчетов("106.00") Цикл
		Счета106.Вставить(Счет, Истина);
	КонецЦикла;
	ЕстьСчета106 = Ложь;
	ЕстьБезКоличества = Ложь;
	
	Для каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		Если СтрокаДокумента.ВидУчета <> "БУ" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Счета106.Получить(СтрокаДокумента.СчетУчета) <> Неопределено Тогда
			ЕстьСчета106 = Истина;
		КонецЕсли;
	
		Если СтрокаДокумента.Количество = 0 Тогда
			ЕстьБезКоличества = Истина;
		КонецЕсли;
	
	КонецЦикла;
	НеСписыватьСуммуБезКоличества = Истина;
	Если ЕстьСчета106 И Не ЕстьБезКоличества Тогда
		НеСписыватьСуммуБезКоличества = Ложь;
	КонецЕсли;
	Реквизиты.Вставить("НеСписыватьСуммуБезКоличества", НеСписыватьСуммуБезКоличества);
	
	// Подготовим таблицу остатков номенклатуры
	ПериодОстатков = ?(Реквизиты.Ссылка.Пустая(),
		Новый Граница(КонецДня(Реквизиты.Дата),         ВидГраницы.Включая),
		Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	ТаблицаОстатки = ОстаткиМатериальныхЗапасов(ПериодОстатков, ТаблицаДокумента, Реквизиты);
	ТаблицаОстатки.Индексы.Добавить("СчетУчета,Номенклатура,КФО,ИФО,КПС,Подразделение,ДопИзмерение,ДопАналитика");
	Для каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СписатьСтрокуМатериаловИзОстатков(Реквизиты, СтрокаДокумента, ТаблицаСписанных, ТаблицаОстатки);
		
	КонецЦикла;
	
	Возврат ТаблицаСписанных;
	
КонецФункции

Функция ТаблицаСписаниеМатериальныхЗапасовДляОприходования(ТаблицаДокумента, Реквизиты, Отказ) Экспорт
	
	ТаблицаСписанных = ПустаяТаблицаСписаниеМатериальныхЗапасов();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаСписанных;
	КонецЕсли;
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ПлательщикНалогаНаПрибыль",        УчетнаяПолитика.ПлательщикНалогаНаПрибыль);
	Реквизиты.Вставить("НеСписыватьСуммуБезКоличества",    Истина);
	
	Если ТаблицаДокумента.Колонки.Найти("ВидУчета") = Неопределено Тогда
		ТаблицаДокумента.Колонки.Вставить(0, "ВидУчета", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(3));
		ТаблицаДокумента.ЗаполнитьЗначения("БУ", "ВидУчета");
	КонецЕсли;
	
	Если Реквизиты.ПлательщикНалогаНаПрибыль
	   И НЕ (Реквизиты.Свойство("НеСписыватьПоНУ") И Реквизиты.НеСписыватьПоНУ) Тогда
		ТаблицаДокумента = ДобавитьСтрокиСписанияПоНалоговомуУчету(ТаблицаДокумента, Реквизиты);
	КонецЕсли;
	
	// Подготовим таблицу остатков номенклатуры
	ПериодОстатков = ?(Реквизиты.Ссылка.Пустая(),
		Новый Граница(КонецДня(Реквизиты.Дата),         ВидГраницы.Включая),
		Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	ТаблицаОстатки = ОстаткиМатериальныхЗапасов(ПериодОстатков, ТаблицаДокумента, Реквизиты);
	ТаблицаОстатки.Индексы.Добавить("СчетУчета,Номенклатура,КФО,ИФО,КПС,Подразделение,ДопИзмерение,ДопАналитика");
	
	Если ТаблицаДокумента.Найти(0, "Количество") <> Неопределено Тогда
		ТаблицаКоэффициентовСписания = ТаблицаКоэффициентовСписываемогоКоличество(ТаблицаДокумента, ТаблицаОстатки);
		ПараметрыСписанияСумм = Новый Структура("ТаблицаОстатки, ТаблицаСписанных, ТаблицаКоэффициентовСписания",
			ТаблицаОстатки, ТаблицаСписанных, ТаблицаКоэффициентовСписания);
	Иначе
		ПараметрыСписанияСумм = Неопределено;
	КонецЕсли;
	
	Для каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		Если СтрокаДокумента.Количество = 0 Тогда
			СписатьСуммуОстаткаПоКоэффициенту(СтрокаДокумента, ПараметрыСписанияСумм);
		Иначе
			СписатьСтрокуМатериаловИзОстатков(Реквизиты, СтрокаДокумента, ТаблицаСписанных, ТаблицаОстатки)
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаСписанных;
	
КонецФункции

// Списать строку материалов из остатков.
// 
// Параметры:
//  Реквизиты - Структура - Реквизиты:
// * ИспользоватьУчетПоИФО - Булево -
// * ИспользоватьУчетПоПодразделениям - Булево -
// * ИспользоватьВалютныйУчет - Булево -
// * ПлательщикНалогаНаПрибыль - Булево -
//  СтрокаДокумента - СтрокаТаблицыЗначений: см. ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу
//  ТаблицаСписанных - см. ПустаяТаблицаСписаниеМатериальныхЗапасов
//  ТаблицаОстатки - см. ПустаяТаблицаОстаткиМатериальныхЗапасов
Процедура СписатьСтрокуМатериаловИзОстатков(Реквизиты, СтрокаДокумента, ТаблицаСписанных, ТаблицаОстатки)
	
	КоличествоОсталосьПогасить = СтрокаДокумента.Количество;
	Если КоличествоОсталосьПогасить <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоОбязательноЗаполнять = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Реквизиты, "НеСписыватьСуммуБезКоличества", Истина);
	
	Если СтрокаДокумента.НеПересчитыватьСумму Тогда
		Если СтрокаДокумента.ВидУчета = "БУ" Тогда
			СуммаОсталосьПогасить = СтрокаДокумента.СуммаСписания;
		Иначе
			СуммаОсталосьПогасить = СтрокаДокумента.СуммаСписанияНУ;
		КонецЕсли;
	Иначе
		СуммаОсталосьПогасить = 0;
	КонецЕсли;
	
	КорректировкаСписания = Новый Структура;
	КорректировкаСписания.Вставить("СтоимостьСписано", 0);
	КорректировкаСписания.Вставить("СтоимостьНеУчитываетсяНУСписано", 0);
	КорректировкаСписания.Вставить("СтоимостьЕНВДСписано", 0);
	КорректировкаСписания.Вставить("МаксимальноеКоличествоВСтроке", 0);
	КорректировкаСписания.Вставить("СтрокаСМаксимальнымКоличеством");
	РезервироватьСуммуСписания = ПолучитьФункциональнуюОпцию("РезервироватьСуммуМЗПриВыбытии");
	КоличествоЗарезервировано = 0;
	СтрокиОстатков = СтрокиТаблицыОстатковПоСтрокеДокумента(СтрокаДокумента, ТаблицаОстатки);
	
	ЕстьОбщееКоличествоСумма = Ложь;
	Если СтрокиОстатков.Количество() Тогда
		ПерваяСтрока = СтрокиОстатков[0];
		ЕстьОбщееКоличествоСумма = ПерваяСтрока.КоличествоВсего > ПерваяСтрока.Количество;
	КонецЕсли;
	
	КоличествоОстаток = 0;
	СуммаОстаток = 0;
	ЕстьСтрокиБезКоличества = Ложь;
	Для Каждого СтрокаОстатков Из СтрокиОстатков Цикл
		КоличествоОстаток = КоличествоОстаток + СтрокаОстатков.Количество;
		СуммаОстаток = СуммаОстаток + СтрокаОстатков.СтоимостьВсего;
		Если РезервироватьСуммуСписания Тогда
			КоличествоОстаток = КоличествоОстаток - СтрокаОстатков.КоличествоЗарезервировано;
			СуммаОстаток = СуммаОстаток - СтрокаОстатков.СуммаЗарезервировано;
		КонецЕсли;
		Если СтрокаОстатков.Количество = 0 И Не КоличествоОбязательноЗаполнять Тогда
			ЕстьСтрокиБезКоличества = Истина;
		КонецЕсли;
	КонецЦикла;
	Если КоличествоОстаток <> 0 Тогда
		КоэффициентСписанияБезКоличества = КоличествоОсталосьПогасить / КоличествоОстаток;
	Иначе
		КоэффициентСписанияБезКоличества = 0;
	КонецЕсли;
	
	// При списании по партиям требуется корректировка возможного округления.
	// Если есть строки без количества, то это списание вложений со счета 106 и здесь не может быть партий
	ТребуетсяКорректировкаСуммыСписания = Не СтрокаДокумента.НеПересчитыватьСумму
		И Не ЕстьСтрокиБезКоличества
		И СтрокиОстатков.Количество() > 0
		И СтрокиОстатков[0].КоличествоВсего = КоличествоОсталосьПогасить;
	// Суммы определяем по первой строке остатков, т.к. они одинаковы во всех строках
	Если ТребуетсяКорректировкаСуммыСписания Тогда
		СтоимостьВсегоДоСписания = СтрокиОстатков[0].СтоимостьВсего;
		СтоимостьНеУчитываетсяНУВсегоДоСписания = СтрокиОстатков[0].СтоимостьНеУчитываетсяНУВсего;
		СтоимостьЕНВДВсегоДоСписания = СтрокиОстатков[0].СтоимостьЕНВДВсего;
	КонецЕсли;
	Для каждого СтрокаОстатков Из СтрокиОстатков Цикл
		
		Если ЕстьСтрокиБезКоличества Тогда
			Если КоличествоОсталосьПогасить <= 0 И СтрокаОстатков.Количество <> 0 Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			Если КоличествоОсталосьПогасить <= 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
		КоличествоЗарезервировано = КоличествоЗарезервировано + СтрокаОстатков.КоличествоЗарезервировано;
		ДоступноеКоличество = Макс(СтрокаОстатков.Количество - СтрокаОстатков.КоличествоЗарезервировано, 0);
		
		Если КоличествоОбязательноЗаполнять
			И (ДоступноеКоличество <= 0
				ИЛИ СтрокаОстатков.КоличествоВсего <= 0) Тогда
			Продолжить;
		КонецЕсли;
		
		Количество  = Мин(ДоступноеКоличество, КоличествоОсталосьПогасить);
		
		Если СтрокаОстатков.ЕстьРезервДокумента И РезервироватьСуммуСписания Тогда
			// Здесь можно проверить, что списываемый остаток не изменился
			СтоимостьНеУчитываетсяНУВсего = 0;
			СтоимостьЕНВДВсего = 0;
			СтоимостьНеУчитываетсяНУ = СтоимостьНеУчитываетсяНУВсего;
			СтоимостьЕНВД            = СтоимостьЕНВДВсего;
			Если СтрокаОстатков.КоличествоЗарезервированоДокумент <> СтрокаДокумента.Количество
				И СтрокаОстатков.КоличествоЗарезервированоДокумент <> 0 Тогда
				СтоимостьВсего = СтрокаДокумента.Количество
					* СтрокаОстатков.СуммаЗарезервированоДокумент
					/ СтрокаОстатков.КоличествоЗарезервированоДокумент;
			Иначе
				СтоимостьВсего = СтрокаОстатков.СуммаЗарезервированоДокумент;
			КонецЕсли;
			Стоимость                = СтоимостьВсего;
			СтрокаОстатков.КоличествоЗарезервированоДокумент = СтрокаОстатков.КоличествоЗарезервированоДокумент
				- СтрокаДокумента.Количество;
			СтрокаОстатков.СуммаЗарезервированоДокумент = СтрокаОстатков.СуммаЗарезервированоДокумент - СтоимостьВсего;
		ИначеЕсли Количество = 0 Тогда
			СтоимостьВсего = СтрокаОстатков.СтоимостьВсего;
			СтоимостьНеУчитываетсяНУВсего = СтрокаОстатков.СтоимостьНеУчитываетсяНУВсего;
			СтоимостьЕНВДВсего = СтрокаОстатков.СтоимостьЕНВДВсего;
			Стоимость                = Окр(СтоимостьВсего                * КоэффициентСписанияБезКоличества, 2, 1);
			СтоимостьНеУчитываетсяНУ = Окр(СтоимостьНеУчитываетсяНУВсего * КоэффициентСписанияБезКоличества, 2, 1);
			СтоимостьЕНВД            = Окр(СтоимостьЕНВДВсего            * КоэффициентСписанияБезКоличества, 2, 1);
		Иначе
			СтоимостьВсего = СтрокаОстатков.СтоимостьВсего;
			СтоимостьНеУчитываетсяНУВсего = СтрокаОстатков.СтоимостьНеУчитываетсяНУВсего;
			СтоимостьЕНВДВсего = СтрокаОстатков.СтоимостьЕНВДВсего;
			Стоимость                = Окр(СтоимостьВсего                * Количество / СтрокаОстатков.КоличествоВсего, 2, 1);
			СтоимостьНеУчитываетсяНУ = Окр(СтоимостьНеУчитываетсяНУВсего * Количество / СтрокаОстатков.КоличествоВсего, 2, 1);
			СтоимостьЕНВД            = Окр(СтоимостьЕНВДВсего            * Количество / СтрокаОстатков.КоличествоВсего, 2, 1);
		КонецЕсли;
		
		Если СтрокаДокумента.НеПересчитыватьСумму
			И КоличествоОсталосьПогасить <= ДоступноеКоличество Тогда
			
			Стоимость                = СуммаОсталосьПогасить;
			СтоимостьНеУчитываетсяНУ = 0;
			СтоимостьЕНВД            = 0;
			
		КонецЕсли;
		
		КорректировкаСписания.СтоимостьСписано = КорректировкаСписания.СтоимостьСписано + Стоимость;
		КорректировкаСписания.СтоимостьНеУчитываетсяНУСписано = КорректировкаСписания.СтоимостьНеУчитываетсяНУСписано + СтоимостьНеУчитываетсяНУ;
		КорректировкаСписания.СтоимостьЕНВДСписано = КорректировкаСписания.СтоимостьЕНВДСписано + СтоимостьЕНВД;
		
		СуммаОсталосьПогасить = СуммаОсталосьПогасить - Стоимость;
		КоличествоОсталосьПогасить = КоличествоОсталосьПогасить - Количество;
		
		СтрокаОстатков.Количество = СтрокаОстатков.Количество - Количество;
		
		Если ЕстьОбщееКоличествоСумма Тогда
			УменьшитьКоличествоВсегоИСтоимостьВсегоВСтрокахОстатков(СтрокиОстатков, Количество, Стоимость, СтоимостьНеУчитываетсяНУ, СтоимостьЕНВД);
		Иначе
			УменьшитьКоличествоВсегоИСтоимостьВсегоВСтрокахОстатков(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаОстатков),
				Количество, Стоимость, СтоимостьНеУчитываетсяНУ, СтоимостьЕНВД);
		КонецЕсли;
		
		СтрокаСписанных = ТаблицаСписанных.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписанных, СтрокаДокумента);
		СтрокаСписанных.ДопАналитика = СтрокаОстатков.ДопАналитика;
		СтрокаСписанных.Партия                   = СтрокаОстатков.Партия;
		СтрокаСписанных.Количество               = Количество;
		СтрокаСписанных.Стоимость                = Стоимость;
		СтрокаСписанных.СтоимостьНеУчитываетсяНУ = СтоимостьНеУчитываетсяНУ;
		СтрокаСписанных.СтоимостьЕНВД            = СтоимостьЕНВД;
		
		Если КорректировкаСписания.МаксимальноеКоличествоВСтроке < СтрокаСписанных.Количество Тогда
			КорректировкаСписания.МаксимальноеКоличествоВСтроке = СтрокаСписанных.Количество;
			КорректировкаСписания.СтрокаСМаксимальнымКоличеством = СтрокаСписанных;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТребуетсяКорректировкаСуммыСписания И КорректировкаСписания.СтрокаСМаксимальнымКоличеством <> Неопределено Тогда
		КорректируемаяСтрока = КорректировкаСписания.СтрокаСМаксимальнымКоличеством;
		
		Если СтоимостьВсегоДоСписания <> КорректировкаСписания.СтоимостьСписано Тогда
			КорректируемаяСтрока.Стоимость = КорректируемаяСтрока.Стоимость
				+ СтоимостьВсегоДоСписания
				- КорректировкаСписания.СтоимостьСписано;
		КонецЕсли;
		Если СтоимостьНеУчитываетсяНУВсегоДоСписания <> КорректировкаСписания.СтоимостьНеУчитываетсяНУСписано Тогда
			КорректируемаяСтрока.СтоимостьНеУчитываетсяНУ = КорректируемаяСтрока.СтоимостьНеУчитываетсяНУ
				+ СтоимостьНеУчитываетсяНУВсегоДоСписания
				- КорректировкаСписания.СтоимостьНеУчитываетсяНУСписано;
		КонецЕсли;
		Если СтоимостьЕНВДВсегоДоСписания <> КорректировкаСписания.СтоимостьЕНВДСписано Тогда
			КорректируемаяСтрока.СтоимостьЕНВД = КорректируемаяСтрока.Стоимость
				+ СтоимостьЕНВДВсегоДоСписания
				- КорректировкаСписания.СтоимостьЕНВДСписано;
		КонецЕсли;
	КонецЕсли;
	
	// Несписанное количество добавим отдельной строкой
	Если КоличествоОсталосьПогасить > 0  Тогда
		
		СтрокаСписанных = ТаблицаСписанных.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписанных, СтрокаДокумента);
		СтрокаСписанных.Количество      = КоличествоОсталосьПогасить;
		СтрокаСписанных.ОстатокПревышен = Истина;
		
		// При списании из бухгалтерского учета, при использовании резервирования, используется другое сообщение.
		Если ПолучитьФункциональнуюОпцию("РезервироватьМЗПриВыбытии") И СтрокаДокумента.ВидУчета = "БУ" Тогда
			ТекстОшибки = НСтр("ru='Указанное количество ""%5"" превышает остаток%3 по счету %4.
				|Свободный остаток: %1; Зарезервировано: %6; Не хватает: %2'");
		Иначе
			ТекстОшибки = НСтр("ru='Указанное количество ""%5"" превышает остаток%3 по счету %4.
				|Остаток: %1; Не хватает: %2'");
		КонецЕсли;
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
			СтрокаДокумента.Количество - КоличествоОсталосьПогасить,
			КоличествоОсталосьПогасить,
			?(СтрокаДокумента.ВидУчета="НУ", НСтр("ru=' в налоговом учете'"), ""),
			СтрокаДокумента.СчетУчета,
			СтрокаДокумента.Номенклатура,
			КоличествоЗарезервировано);
			
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
			НСтр("ru = 'Количество'"),
			СтрокаДокумента.НомерСтроки,
			СтрокаДокумента.СинонимСписка,
			ТекстОшибки);
			
		ПолеКоличество = СтрокаДокумента.ИмяСписка + "[" + Формат(СтрокаДокумента.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Количество";
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Реквизиты.Ссылка, ПолеКоличество, "Объект");
		
	КонецЕсли;
КонецПроцедуры

Процедура СписатьСуммуОстаткаПоКоэффициенту(СтрокаДокумента, Параметры)
	
	ТаблицаОстатки               = Параметры.ТаблицаОстатки;
	ТаблицаСписанных             = Параметры.ТаблицаСписанных;
	ТаблицаКоэффициентовСписания = Параметры.ТаблицаКоэффициентовСписания;
	
	СтрокиКоэффициента = СтрокиТаблицыОстатковПоСтрокеДокумента(СтрокаДокумента, ТаблицаКоэффициентовСписания);
	Если СтрокиКоэффициента.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Коэффициент = СтрокиКоэффициента[0].КоэффициентСписания;
	
	СтрокиОстатков = СтрокиТаблицыОстатковПоСтрокеДокумента(СтрокаДокумента, ТаблицаОстатки, Ложь, Истина);
	Для каждого СтрокаОстатков Из СтрокиОстатков Цикл
		
		Если СтрокаОстатков.Количество > 0 Или СтрокаОстатков.СтоимостьВсего <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Количество  = 0;
		Стоимость                = Окр(СтрокаОстатков.СтоимостьВсего                * Коэффициент, 2, 1);
		СтоимостьНеУчитываетсяНУ = Окр(СтрокаОстатков.СтоимостьНеУчитываетсяНУВсего * Коэффициент, 2, 1);
		СтоимостьЕНВД            = Окр(СтрокаОстатков.СтоимостьЕНВДВсего            * Коэффициент, 2, 1);
		
		СтрокаСписанных = ТаблицаСписанных.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписанных, СтрокаДокумента);
		СтрокаСписанных.Партия                   = СтрокаОстатков.Партия;
		СтрокаСписанных.Количество               = Количество;
		СтрокаСписанных.Стоимость                = Стоимость;
		СтрокаСписанных.СтоимостьНеУчитываетсяНУ = СтоимостьНеУчитываетсяНУ;
		СтрокаСписанных.СтоимостьЕНВД            = СтоимостьЕНВД;
		
	КонецЦикла;
	
КонецПроцедуры

// Подсчитывает коэффициенты для списания сумм вложений, не имеющих суммы, на материалы текущего документа
// 
// Параметры:
// 	ТаблицаДокумента - ТаблицаЗначений - Описание:
// 	ТаблицаОстатки - ТаблицаЗначений - Описание:
Функция ТаблицаКоэффициентовСписываемогоКоличество(ТаблицаДокумента, ТаблицаОстатки)
	КолонкиТаблицыДокумента = "СчетУчета, Номенклатура, КФО, ДопИзмерение,"
		+ "УчетПоИФО, УчетПоКПС, УчетПоПодразделениям, ДопИзмерениеЕстьСубконто, ДопАналитикаЕстьСубконто,"
		+ "ИФО, Подразделение";
	СвернутаяТаблицаДокумента = ТаблицаДокумента.Скопировать(,КолонкиТаблицыДокумента + ",Количество");
	СвернутаяТаблицаДокумента.ЗаполнитьЗначения(Ложь, "ДопАналитикаЕстьСубконто, УчетПоКПС");
	СвернутаяТаблицаДокумента.Свернуть(КолонкиТаблицыДокумента, "Количество");
	СвернутаяТаблицаДокумента.Индексы.Добавить("СчетУчета, Номенклатура, КФО, ДопИзмерение");
	
	СвернутаяТаблицаОстатки = ТаблицаОстатки.Скопировать(,"СчетУчета, Номенклатура, КФО, КПС, ДопИзмерение, ДопАналитика, Количество");
	СвернутаяТаблицаОстатки.Свернуть("СчетУчета, Номенклатура, КФО, КПС, ДопИзмерение, ДопАналитика", "Количество");
	СвернутаяТаблицаОстатки.Индексы.Добавить("СчетУчета, Номенклатура, КФО, КПС, ДопИзмерение, ДопАналитика");
	
	СвернутаяТаблицаДокумента.Колонки.Добавить("КоэффициентСписания");
	УдаляемыеСтроки = Новый Массив;
	Для Каждого СвернутаяСтрока Из СвернутаяТаблицаДокумента Цикл
		
		Если СвернутаяСтрока.Количество = 0 Тогда
			УдаляемыеСтроки.Добавить(СвернутаяСтрока);
			Продолжить;
		КонецЕсли;
		
		СтрокиОстатков = СтрокиТаблицыОстатковПоСтрокеДокумента(СвернутаяСтрока, СвернутаяТаблицаОстатки);
		КоличествоОстаток = 0;
		Для Каждого СвернутыйОстаток Из СтрокиОстатков Цикл
			КоличествоОстаток = КоличествоОстаток + СвернутыйОстаток.Количество;	
		КонецЦикла;
		Если КоличествоОстаток <> 0 Тогда		
			СвернутаяСтрока.КоэффициентСписания = СвернутаяСтрока.Количество / КоличествоОстаток;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаКУдалению Из УдаляемыеСтроки Цикл
		СвернутаяТаблицаДокумента.Удалить(СтрокаКУдалению); 
	КонецЦикла;
		
	Возврат СвернутаяТаблицаДокумента;
	
КонецФункции

// Строки таблицы остатков по переданной строке документа
//
// Параметры:
//  СтрокаДокумента - СтрокаТаблицыЗначений: см. ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу
//  ТаблицаОстатки - см. ПустаяТаблицаОстаткиМатериальныхЗапасов
//  ТаблицаРезервы - см. ОстаткиРезервовМатериальныхЗапасов
//
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений: см. ПустаяТаблицаОстаткиМатериальныхЗапасов
Функция СтрокиТаблицыОстатковПоСтрокеДокумента(СтрокаДокумента, ТаблицаОстатки, ПроверятьИспользованиеДопАналитики = Истина, Знач УчитыватьДопАналитику = Ложь)
	
	Если ТаблицаОстатки.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Отбор = Новый Структура("СчетУчета,Номенклатура,КФО");
	ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
	ОтборРезервы = Новый Структура;
	ОтборРезервы.Вставить("СчетУчета", СтрокаДокумента.СчетУчета);
	ОтборРезервы.Вставить("Номенклатура", СтрокаДокумента.Номенклатура);
	ОтборРезервы.Вставить("КФО", СтрокаДокумента.КФО);
	
	ПерваяСтрокаОстатков = ТаблицаОстатки[0];
	
	Если СтрокаДокумента.УчетПоИФО
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрокаОстатков, "ИФО") Тогда
		Отбор.Вставить("ИФО", СтрокаДокумента.ИФО);
		ОтборРезервы.Вставить("ИФО", СтрокаДокумента.ИФО);
	КонецЕсли;
	Если СтрокаДокумента.УчетПоКПС
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрокаОстатков, "КПС") Тогда
		Отбор.Вставить("КПС", СтрокаДокумента.КПС);
		ОтборРезервы.Вставить("КПС", СтрокаДокумента.КПС);
	КонецЕсли;
	Если СтрокаДокумента.УчетПоПодразделениям
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрокаОстатков, "Подразделение") Тогда
		Отбор.Вставить("Подразделение", СтрокаДокумента.Подразделение);
		ОтборРезервы.Вставить("Подразделение", СтрокаДокумента.Подразделение);
	КонецЕсли;
	Если СтрокаДокумента.ДопИзмерениеЕстьСубконто
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрокаОстатков, "ДопИзмерение") Тогда
		Отбор.Вставить("ДопИзмерение", СтрокаДокумента.ДопИзмерение);
	КонецЕсли;
	Если ПроверятьИспользованиеДопАналитики Тогда
		УчитыватьДопАналитику = СтрокаДокумента.ДопАналитикаЕстьСубконто
			И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрокаОстатков, "ДопАналитика");
		Если УчитыватьДопАналитику Тогда
			Если БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетУчета, "106.00, Н15")
				И СтрокаДокумента.ДопАналитикаВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
				// Виды затрат не указываются в документе.
				УчитыватьДопАналитику = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если УчитыватьДопАналитику Тогда
		Отбор.Вставить("ДопАналитика", СтрокаДокумента.ДопАналитика);
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаДокумента, "ПартияЕстьСубконто")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПерваяСтрокаОстатков, "Партия")
		И СтрокаДокумента.ПартияЕстьСубконто
		И ЗначениеЗаполнено(ПланыВидовХарактеристик.ВидыСубконто.Партии.ТипЗначения.ПривестиЗначение(СтрокаДокумента.ДопАналитика)) Тогда
		Отбор.Вставить("Партия", СтрокаДокумента.ДопАналитика);
	КонецЕсли;
	
	СтрокиОстатков = ТаблицаОстатки.НайтиСтроки(Отбор);
	
	Возврат СтрокиОстатков;
	
КонецФункции

Функция ДобавитьСтрокиСписанияПоНалоговомуУчету(ТаблицаДокумента, Реквизиты)
	
	ЕстьКолонкаУчетПоКПС = ТаблицаДокумента.Колонки.Найти("УчетПоКПС") <> Неопределено;
	Если ЕстьКолонкаУчетПоКПС Тогда
		СвойстваУчетПоКПС = Новый Соответствие;
	КонецЕсли;
	
	КоличествоСтрок = ТаблицаДокумента.Количество();
	Для ИндексСтроки = 0 По КоличествоСтрок - 1 Цикл
		
		СтрокаДокумента = ТаблицаДокумента[ИндексСтроки];
		
		Если НЕ НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаДокумента.КФО) Тогда
			Продолжить;
		КонецЕсли;
		
		СчетУчетаНУ = НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ(СтрокаДокумента.СчетУчета, Реквизиты.Дата);
		Если НЕ ЗначениеЗаполнено(СчетУчетаНУ) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаСписанияПоНУ = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписанияПоНУ, СтрокаДокумента);
		
		СтрокаСписанияПоНУ.ВидУчета  = "НУ";
		СтрокаСписанияПоНУ.СчетУчета = СчетУчетаНУ;
		Если ЕстьКолонкаУчетПоКПС Тогда
			УчетПоКПСНаСчете = СвойстваУчетПоКПС.Получить(СчетУчетаНУ);
			Если УчетПоКПСНаСчете = Неопределено Тогда
				УчетПоКПСНаСчете = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчетаНУ).УчетПоКПС;
				СвойстваУчетПоКПС.Вставить(СчетУчетаНУ, УчетПоКПСНаСчете);
			КонецЕсли;
			СтрокаСписанияПоНУ.УчетПоКПС = УчетПоКПСНаСчете;
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Реализация материальных запасов.

// Структура таблицы для функции ПодготовитьТаблицуРеализацияМатериальныхЗапасовПоДокументу.
// 
Функция ПустаяТаблицаРеализацияМатериальныхЗапасовПоДокументу()
	
	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ТаблицаДокумента = Новый ТаблицаЗначений;
	// Идентификация строки.
	ТаблицаДокумента.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ТаблицаДокумента.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДокумента.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДокумента.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДокумента.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета материальных запасов.
	ТаблицаДокумента.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	// Покупатель.
	ТаблицаДокумента.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("КЭКДоходов",    Новый ОписаниеТипов("СправочникСсылка.КОСГУ")); // 172.
	ТаблицаДокумента.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДокумента.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаДокумента.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Количественные и суммовые характеристики.
	ТаблицаДокумента.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ТаблицаДокумента.Колонки.Добавить("Сумма",         ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ТаблицаДокумента.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ТаблицаДокумента.Колонки.Добавить("СуммаНДС",      ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Подготавливает таблицу документа (в унифицированном формате) для учета реализации материальных запасов.
//
Функция ПодготовитьТаблицуРеализацияМатериальныхЗапасовПоДокументу(Документ, Параметры = Неопределено) Экспорт
	
	ТаблицаДокумента = ПустаяТаблицаРеализацияМатериальныхЗапасовПоДокументу();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	Если НЕ Параметры.Свойство("КЭКДоходов") Тогда
		Параметры.Вставить("КЭКДоходов", Справочники.КОСГУ.ПустаяСсылка());
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	ЕстьТабЧастьМатериалы    = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("Материалы", МетаданныеДокумента);
	ЕстьТабЧастьНоменклатура = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("Номенклатура", МетаданныеДокумента);
	
	Если ЕстьТабЧастьМатериалы Тогда
		
		Если МетаданныеДокумента.Имя = "НакладнаяНаОтпускИК" Тогда
			Параметры.Вставить("ВалютаДокумента", Константы.ВалютаРегламентированногоУчета.Получить());
			Параметры.Вставить("СчетУчета", БухгалтерскийУчет.СчетПоКоду("108.56", Документ.Дата, Документ.Организация));
		КонецЕсли;
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,КЭКДоходов,Контрагент,Договор,ВалютаДокумента,
			|СчетУчета,Номенклатура,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""Материалы"" КАК ИмяСписка,
		|	""Материалы"" КАК СинонимСписка,
		|	Материалы.НомерСтроки КАК НомерСтроки,
		|	Материалы.ИФО КАК ИФО,
		|	Материалы.КФО КАК КФО,
		|	Материалы.КПС КАК КПС,
		|	Материалы.Подразделение КАК Подразделение,
		|	Материалы.СчетУчета КАК СчетУчета,
		|	Материалы.Номенклатура КАК Номенклатура,
		|	Материалы.КЭКДоходов КАК КЭКДоходов,
		|	Материалы.Контрагент КАК Контрагент,
		|	Материалы.Договор КАК Договор,
		|	Материалы.ВалютаДокумента КАК Валюта,
		|	Материалы.Количество КАК Количество,
		|	Материалы.Всего КАК Сумма,
		|	Материалы.СтавкаНДС КАК СтавкаНДС,
		|	Материалы.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	ТаблицаМатериалы КАК Материалы
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	ИначеЕсли ЕстьТабЧастьНоменклатура Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Номенклатура",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,КЭКДоходов,Контрагент,Договор,ВалютаДокумента,
			|СчетУчета,Номенклатура,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС",
			Документ, Параметры);
		// Переименуем таблицу, т.к. таб.часть называется так же, как реквизит - "Номенклатура".
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура.", "ТабНоменклатура.");
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ТаблицаНоменклатура КАК Номенклатура", "ТаблицаНоменклатура КАК ТабНоменклатура");
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""Номенклатура"" КАК ИмяСписка,
		|	""Номенклатура"" КАК СинонимСписка,
		|	ТабНоменклатура.НомерСтроки КАК НомерСтроки,
		|	ТабНоменклатура.ИФО КАК ИФО,
		|	ТабНоменклатура.КФО КАК КФО,
		|	ТабНоменклатура.КПС КАК КПС,
		|	ТабНоменклатура.Подразделение КАК Подразделение,
		|	ТабНоменклатура.СчетУчета КАК СчетУчета,
		|	ТабНоменклатура.Номенклатура КАК Номенклатура,
		|	ТабНоменклатура.КЭКДоходов КАК КЭКДоходов,
		|	ТабНоменклатура.Контрагент КАК Контрагент,
		|	ТабНоменклатура.Договор КАК Договор,
		|	ТабНоменклатура.ВалютаДокумента КАК Валюта,
		|	ТабНоменклатура.Количество КАК Количество,
		|	ТабНоменклатура.Всего КАК Сумма,
		|	ТабНоменклатура.СтавкаНДС КАК СтавкаНДС,
		|	ТабНоменклатура.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	ТаблицаНоменклатура КАК ТабНоменклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	КонецЕсли;
	
	РеализацияМатериальныхЗапасов = Запрос.Выполнить().Выгрузить();
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// Счет расчетов.
	СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Реализация",
		Документ.Дата, Документ.Организация, Документ.ИФО);
	
	// В документах реализации в таб.части указан КПС расходов.
	// Для расчетов должен использоваться КПС доходов (если указан).
	ИспользоватьКПСРасчетов = Параметры.Свойство("КПС") И ЗначениеЗаполнено(Параметры.КПС);
	
	Для Каждого Строка Из РеализацияМатериальныхЗапасов Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Не ИспользоватьВалютныйУчет И Не ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СчетРасчетов) Тогда
			НоваяСтрока.СчетРасчетов = СчетРасчетов;
		ИначеЕсли ЗначениеЗаполнено(НоваяСтрока.КЭКДоходов) Тогда
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(НоваяСтрока.КЭКДоходов,
				?(Параметры.Свойство("СчетРасчетов") И ЗначениеЗаполнено(Параметры.СчетРасчетов), Параметры.СчетРасчетов, "205.00"), ,
				Документ.Дата, Документ.Организация, Строка.ИФО);
		Иначе
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.74", Документ.Дата, Документ.Организация);
		КонецЕсли;
		
		Если ИспользоватьКПСРасчетов Тогда
			НоваяСтрока.КПС = Параметры.КПС;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.КЭКДоходов) Тогда
			НоваяСтрока.КЭКДоходов = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(НоваяСтрока.СчетРасчетов);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Структура таблицы источника данных "Реализация материальных запасов".
//
Функция ПустаяТаблицаРеализацияМатериальныхЗапасов() Экспорт

	ОписаниеТиповСубконто  = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета материальных запасов.
	ПустаяТаблица.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	// Покупатель.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КЭКДоходов",    Новый ОписаниеТипов("СправочникСсылка.КОСГУ")); // 130, 172.
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Количественные и суммовые характеристики.
	ПустаяТаблица.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ПустаяТаблица.Колонки.Добавить("СуммаВал",      ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСВал",   ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",      ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",   ОписаниеТипаСуммы); // Сумма НДС в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Реализация материальных запасов".
//
Функция ТаблицаРеализацияМатериальныхЗапасов(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов=Неопределено, Реквизиты, Отказ) Экспорт
	
	ТаблицаРеализация = ПустаяТаблицаРеализацияМатериальныхЗапасов();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаРеализация;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	УчетРасчетов.РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СтрокаСписание = ТаблицаРеализация.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписание, СтрокаДокумента);
		
		СтрокаСписание.СуммаВал    = СтрокаДокумента.Сумма;
		СтрокаСписание.СуммаНДСВал = СтрокаДокумента.СуммаНДС;
		
	КонецЦикла;
	
	Возврат ТаблицаРеализация;
	
КонецФункции

// Возврат материальных запасов поставщику.

// Структура таблицы источника данных "Возврат материальных запасов поставщику".
//
Функция ПустаяТаблицаВозвратМатериальныхЗапасовПоставщику() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	// Таблица будет содержать все стандартные колонки таблицы списанных материальных запасов,
	// плюс некоторые другие - специфичные для операции возврата поставщику.
	ПустаяТаблица = ПустаяТаблицаСписаниеМатериальныхЗапасов();
	
	ПустаяТаблица.Колонки.Добавить("Валюта",      Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Стоимость возврата материальных запасов.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",    ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСВал", ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",    ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб", ОписаниеТипаСуммы); // Сумма НДС в рублях.
	// Разница между учетной стоимостью (стоимостью списания) материальных запасов и стоимостью возврата.
	ПустаяТаблица.Колонки.Добавить("РазницаСтоимостиРуб", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("РазницаСтоимостиВал", ОписаниеТипаСуммы);
	// Стоимость списания в валюте. Для правильного заполнения валютной суммы в проводке "Списание стоимости МЗ".
	ПустаяТаблица.Колонки.Добавить("СтоимостьВал", ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Возврат материальных запасов поставщику".
//
Функция ТаблицаВозвратМатериальныхЗапасовПоставщику(Документ, ТаблицаСписаниеМатериальныхЗапасов, Реквизиты, Отказ) Экспорт
	
	ТаблицаВозврат = ПустаяТаблицаВозвратМатериальныхЗапасовПоставщику();
	Если ТаблицаСписаниеМатериальныхЗапасов.Количество() = 0 Тогда
		Возврат ТаблицаВозврат;
	КонецЕсли;
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ПлательщикНалогаНаПрибыль", УчетнаяПолитика.ПлательщикНалогаНаПрибыль);
	
	// Стоимость возврата материальных запасов получим из документа.
	Запрос = Новый Запрос;
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
		"НомерСтроки,ИФО,КФО,КПС,Подразделение,Номенклатура,Количество,ВалютаДокумента,Сумма,Всего,СтавкаНДС,СуммаНДС",
		Документ, Реквизиты);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Материалы"" КАК ИмяСписка,
	|	""Материалы"" КАК СинонимСписка,
	|	Материалы.НомерСтроки КАК НомерСтроки,
	|	Материалы.ИФО КАК ИФО,
	|	Материалы.КФО КАК КФО,
	|	Материалы.КПС КАК КПС,
	|	Материалы.Подразделение КАК Подразделение,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.ВалютаДокумента КАК Валюта,
	|	Материалы.Количество КАК Количество,
	|	Материалы.Всего КАК Сумма,
	|	Материалы.СтавкаНДС КАК СтавкаНДС,
	|	Материалы.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	ТаблицаМатериалы КАК Материалы
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	ТаблицаДокумента = Запрос.Выполнить().Выгрузить();
	
	УчетРасчетов.РассчитатьСуммыРуб(ТаблицаДокумента, , Реквизиты);
	
	// Добавим в таблицу возврата строки списанных партий материальных запасов.
	Для Каждого СтрокаСписания Из ТаблицаСписаниеМатериальныхЗапасов Цикл
		НоваяСтрока = ТаблицаВозврат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСписания);
		Если НоваяСтрока.СуммаРуб <> НоваяСтрока.СуммаВал И НоваяСтрока.СуммаРуб <> 0 Тогда
			НоваяСтрока.СтоимостьВал = НоваяСтрока.Стоимость * НоваяСтрока.СуммаВал / НоваяСтрока.СуммаРуб;
		Иначе
			НоваяСтрока.СтоимостьВал = НоваяСтрока.Стоимость;
		КонецЕсли;
	КонецЦикла;
	
	// Заполним в таблице возврата 1) стоимость возврата и 2) разницу стоимости.
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		НайденныеСтроки = ТаблицаВозврат.НайтиСтроки(
			Новый Структура("ИмяСписка, НомерСтроки, ВидУчета",
				СтрокаДокумента.ИмяСписка, СтрокаДокумента.НомерСтроки, "БУ"));
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			// Стоимость возврата распределим по всем строкам списанных партий материальных запасов.
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаДокумента.Сумма,
				НайденныеСтроки, "СуммаВал", "Количество");
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаДокумента.СуммаНДС,
				НайденныеСтроки, "СуммаНДСВал", "Количество");
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаДокумента.СуммаРуб,
				НайденныеСтроки, "СуммаРуб", "Количество");
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаДокумента.СуммаНДСРуб,
				НайденныеСтроки, "СуммаНДСРуб", "Количество");
			
			// Рассчитаем разницы стоимости возврата и учетной стоимости материальных запасов.
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				
				НайденнаяСтрока.Валюта = СтрокаДокумента.Валюта;
				
				СтоимостьВозврата = ?(Реквизиты.Свойство("ВосстанавливатьНДС") И Реквизиты.ВосстанавливатьНДС,
					НайденнаяСтрока.СуммаРуб - НайденнаяСтрока.СуммаНДСРуб, НайденнаяСтрока.СуммаРуб);
				НайденнаяСтрока.РазницаСтоимостиРуб = СтоимостьВозврата - НайденнаяСтрока.Стоимость;
				
				Курс = ?(НайденнаяСтрока.СуммаРуб = 0, 1, НайденнаяСтрока.СуммаВал / НайденнаяСтрока.СуммаРуб);
				НайденнаяСтрока.РазницаСтоимостиВал = НайденнаяСтрока.РазницаСтоимостиРуб * Курс;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если Реквизиты.ПлательщикНалогаНаПрибыль Тогда
			
			Если НЕ НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаДокумента.КФО) Тогда
				Продолжить;
			КонецЕсли;
			
			НайденныеСтроки = ТаблицаВозврат.НайтиСтроки(
				Новый Структура("ИмяСписка, НомерСтроки, ВидУчета",
					СтрокаДокумента.ИмяСписка, СтрокаДокумента.НомерСтроки, "НУ"));
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				// Стоимость возврата распределим по всем строкам списанных партий материальных запасов.
				ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаДокумента.Сумма,
					НайденныеСтроки, "СуммаВал", "Количество");
				ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаДокумента.СуммаНДС,
					НайденныеСтроки, "СуммаНДСВал", "Количество");
				ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаДокумента.СуммаРуб,
					НайденныеСтроки, "СуммаРуб", "Количество");
				ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаДокумента.СуммаНДСРуб,
					НайденныеСтроки, "СуммаНДСРуб", "Количество");
				
				// Рассчитаем разницы стоимости возврата и учетной стоимости материальных запасов.
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					
					НайденнаяСтрока.Валюта = СтрокаДокумента.Валюта;
					
					СтоимостьВозврата = ?(Реквизиты.Свойство("ВосстанавливатьНДС") И Реквизиты.ВосстанавливатьНДС,
						НайденнаяСтрока.СуммаРуб - НайденнаяСтрока.СуммаНДСРуб,
						НайденнаяСтрока.СуммаРуб);
					НайденнаяСтрока.РазницаСтоимостиРуб = СтоимостьВозврата
						- НайденнаяСтрока.Стоимость
						- НайденнаяСтрока.СтоимостьНеУчитываетсяНУ
						- НайденнаяСтрока.СтоимостьЕНВД;
					
					Курс = ?(НайденнаяСтрока.СуммаРуб = 0, 1, НайденнаяСтрока.СуммаВал / НайденнаяСтрока.СуммаРуб);
					НайденнаяСтрока.РазницаСтоимостиВал = НайденнаяСтрока.РазницаСтоимостиРуб * Курс;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ТаблицаВозврат;
	
КонецФункции

// Меню-требование - списание, возврат продуктов питания.

// Структура таблицы источника данных "Списание продуктов питания".
//
Функция ПустаяТаблицаСписаниеПродуктовПитания() Экспорт

	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто  = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	// Таблица будет содержать все стандартные колонки таблицы списанных материальных запасов,
	// плюс некоторые другие - специфичные для списания продуктов питания.
	ПустаяТаблица = ПустаяТаблицаСписаниеМатериальныхЗапасов();
	
	// Категории и количество довольствующихся будут использоваться для движения регистра накопления РасходПродуктов.
	ПустаяТаблица.Колонки.Добавить("КатегорияДовольствующихся",  Новый ОписаниеТипов("СправочникСсылка.КатегорииДовольствующихся"));
	ПустаяТаблица.Колонки.Добавить("КоличествоДовольствующихся", ОписаниеТипаКоличества);
	
	// Счет и аналитика учета затрат.
	ПустаяТаблица.Колонки.Добавить("СчетЗатрат",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПСЗатрат",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭКЗатрат",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("ПодразделениеЗатрат", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатрат1",     ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатрат2",     ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатрат3",     ОписаниеТиповСубконто);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Списание продуктов питания".
//
Функция ТаблицаСписаниеПродуктовПитания(ТаблицаСписания, Документ, Параметры, Отказ) Экспорт
	
	ТаблицаСписанныхПродуктов = ПустаяТаблицаСписаниеПродуктовПитания();
	Если ТаблицаСписания.Количество() = 0 Тогда
		Возврат ТаблицаСписанныхПродуктов;
	КонецЕсли;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	// Получим из документа "Меню-требование" данные о категориях и количестве довольствующихся,
	// а также о счете и аналитике затрат.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ИспользоватьУчетПоИФО);
	
	ТаблицаСписанных = ТаблицаСписания.Скопировать(,"НомерСтроки,Номенклатура,ИФО,КФО,КПС");
	ТаблицаСписанных.Свернуть("НомерСтроки,Номенклатура,ИФО,КФО,КПС");
	Запрос.УстановитьПараметр("ТаблицаСписанных", ТаблицаСписанных);
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
		"НомерСтроки,КатегорияДовольствующихся",
		Документ, Параметры);
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "КатегорииДовольствующихся",
		"КатегорияДовольствующихся,Количество",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	ТаблицаСписанных.НомерСтроки КАК НомерСтроки,
	|	ТаблицаСписанных.Номенклатура КАК Номенклатура,
	|	ТаблицаСписанных.ИФО КАК ИФО,
	|	ТаблицаСписанных.КФО КАК КФО,
	|	ТаблицаСписанных.КПС КАК КПС
	|ПОМЕСТИТЬ СписанныеПродукты
	|ИЗ
	|	&ТаблицаСписанных КАК ТаблицаСписанных
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТаблицаСписанных.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписанныеПродукты.НомерСтроки КАК НомерСтроки,
	|	СписанныеПродукты.Номенклатура КАК Номенклатура,
	|	СписанныеПродукты.ИФО КАК ИФО,
	|	СписанныеПродукты.КФО КАК КФО,
	|	СписанныеПродукты.КПС КАК КПС,
	|	ВЫРАЗИТЬ(МенюТребованиеМатериалы.КатегорияДовольствующихся КАК Справочник.КатегорииДовольствующихся) КАК КатегорияДовольствующихся
	|ПОМЕСТИТЬ СписанныеПоКатегориям
	|ИЗ
	|	СписанныеПродукты КАК СписанныеПродукты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаМатериалы КАК МенюТребованиеМатериалы
	|		ПО СписанныеПродукты.НомерСтроки = МенюТребованиеМатериалы.НомерСтроки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИФО,
	|	КФО,
	|	ВЫРАЗИТЬ(МенюТребованиеМатериалы.КатегорияДовольствующихся КАК Справочник.КатегорииДовольствующихся)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаКатегорииДовольствующихся.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
	|	СУММА(ТаблицаКатегорииДовольствующихся.Количество) КАК Количество
	|ПОМЕСТИТЬ КоличествоПоКатегориям
	|ИЗ
	|	ТаблицаКатегорииДовольствующихся КАК ТаблицаКатегорииДовольствующихся
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаКатегорииДовольствующихся.КатегорияДовольствующихся
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписанныеПоКатегориям.НомерСтроки КАК НомерСтроки,
	|	СписанныеПоКатегориям.Номенклатура КАК Номенклатура,
	|	СписанныеПоКатегориям.ИФО КАК ИФО,
	|	СписанныеПоКатегориям.КФО КАК КФО,
	|	СписанныеПоКатегориям.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
	|	КоличествоДовольствующихся.Количество КАК КоличествоДовольствующихся,
	|	ИсточникиСредств.СчетЗатрат КАК СчетЗатрат,
	|	ВЫБОР
	|		КОГДА ИсточникиСредств.КПСЗатрат = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ТОГДА СписанныеПоКатегориям.КПС
	|		ИНАЧЕ ИсточникиСредств.КПСЗатрат
	|	КОНЕЦ КАК КПСЗатрат,
	|	ИсточникиСредств.КЭКЗатрат КАК КЭКЗатрат,
	|	СписанныеПоКатегориям.КатегорияДовольствующихся.Подразделение КАК ПодразделениеЗатрат,
	|	ИсточникиСредств.СубконтоЗатрат1 КАК СубконтоЗатрат1,
	|	ИсточникиСредств.СубконтоЗатрат2 КАК СубконтоЗатрат2,
	|	ИсточникиСредств.СубконтоЗатрат3 КАК СубконтоЗатрат3
	|ИЗ
	|	СписанныеПоКатегориям КАК СписанныеПоКатегориям
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КатегорииДовольствующихся.ИсточникиСредств КАК ИсточникиСредств
	|		ПО СписанныеПоКатегориям.ИФО = ИсточникиСредств.ИФО
	|			И СписанныеПоКатегориям.КФО = ИсточникиСредств.КФО
	|			И СписанныеПоКатегориям.КатегорияДовольствующихся = ИсточникиСредств.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоПоКатегориям КАК КоличествоДовольствующихся
	|		ПО СписанныеПоКатегориям.КатегорияДовольствующихся = КоличествоДовольствующихся.КатегорияДовольствующихся
	|ГДЕ
	|	&ИспользоватьУчетПоИФО = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СписанныеПоКатегориям.НомерСтроки,
	|	СписанныеПоКатегориям.Номенклатура,
	|	СписанныеПоКатегориям.ИФО,
	|	СписанныеПоКатегориям.КФО,
	|	СписанныеПоКатегориям.КатегорияДовольствующихся,
	|	КоличествоДовольствующихся.Количество,
	|	ИсточникиСредств.СчетЗатрат,
	|	ВЫБОР
	|		КОГДА ИсточникиСредств.КПСЗатрат = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ТОГДА СписанныеПоКатегориям.КПС
	|		ИНАЧЕ ИсточникиСредств.КПСЗатрат
	|	КОНЕЦ,
	|	ИсточникиСредств.КЭКЗатрат,
	|	СписанныеПоКатегориям.КатегорияДовольствующихся.Подразделение,
	|	ИсточникиСредств.СубконтоЗатрат1,
	|	ИсточникиСредств.СубконтоЗатрат2,
	|	ИсточникиСредств.СубконтоЗатрат3
	|ИЗ
	|	СписанныеПоКатегориям КАК СписанныеПоКатегориям
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КатегорииДовольствующихся.ИсточникиСредств КАК ИсточникиСредств
	|		ПО СписанныеПоКатегориям.КФО = ИсточникиСредств.КФО
	|			И СписанныеПоКатегориям.КатегорияДовольствующихся = ИсточникиСредств.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоПоКатегориям КАК КоличествоДовольствующихся
	|		ПО СписанныеПоКатегориям.КатегорияДовольствующихся = КоличествоДовольствующихся.КатегорияДовольствующихся
	|ГДЕ
	|	&ИспользоватьУчетПоИФО = ЛОЖЬ";
	
	ТаблицаСписанных = Запрос.Выполнить().Выгрузить();
	ТаблицаСписанных.Индексы.Добавить("НомерСтроки");
	
	// Заполним таблицу списания продуктов питания с учетом всех имеющихся данных.
	Для Каждого СтрокаСписания Из ТаблицаСписания Цикл
		
		НоваяСтрока = ТаблицаСписанныхПродуктов.Добавить();
		
		// Заполним свойства из стандартной таблицы списания материалов.
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСписания);
		
		// Заполним специфичные для списания продуктов питания свойства:
		// категорию и количество довольствующихся, счет и аналитику затрат.
		Отбор = Новый Структура("НомерСтроки", СтрокаСписания.НомерСтроки);
		НайденныеСтроки = ТаблицаСписанных.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0],
				"КатегорияДовольствующихся,КоличествоДовольствующихся,СчетЗатрат,КПСЗатрат,
				|КЭКЗатрат,ПодразделениеЗатрат,СубконтоЗатрат1,СубконтоЗатрат2,СубконтоЗатрат3");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НоваяСтрока.КПСЗатрат) Тогда
			НоваяСтрока.КПСЗатрат = НоваяСтрока.КПС;
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверка корректности заполнения источников средств в категориях довольствующихся.
	Документы.МенюТребование.ПроверитьЗаполнениеСчетаЗатрат(
		ТаблицаСписанныхПродуктов.Скопировать(,"КатегорияДовольствующихся,ИФО,КФО"), Отказ);
	
	Возврат ТаблицаСписанныхПродуктов;
	
КонецФункции

// Структура таблицы источника данных "Возврат продуктов питания".
//
Функция ПустаяТаблицаВозвратПродуктовПитания() Экспорт

	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета материальных запасов.
	ПустаяТаблица.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("ДопАналитикаВидСубконто", ОписаниеТиповВидСубконто);
	ПустаяТаблица.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ПустаяТаблица.Колонки.Добавить("ДопИзмерениеВидСубконто", ОписаниеТиповВидСубконто);
	ПустаяТаблица.Колонки.Добавить("ДопИзмерение",            ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.
	// Количество и сумма поступивших единиц.
	ПустаяТаблица.Колонки.Добавить("Количество", ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",   ОписаниеТипаСуммы); // Сумма в рублях.
	
	// Категории довольствующихся будут использоваться для движения регистра накопления РасходПродуктов.
	ПустаяТаблица.Колонки.Добавить("КатегорияДовольствующихся",  Новый ОписаниеТипов("СправочникСсылка.КатегорииДовольствующихся"));
	
	// Счет и аналитика учета затрат.
	ПустаяТаблица.Колонки.Добавить("СчетЗатрат",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПСЗатрат",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭКЗатрат",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("ПодразделениеЗатрат", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатрат1",     ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатрат2",     ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатрат3",     ОписаниеТиповСубконто);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Возврат продуктов питания".
//
Функция ТаблицаВозвратПродуктовПитания(Документ, Реквизиты, Отказ) Экспорт
	
	ТаблицаВозвратПродуктов = ПустаяТаблицаВозвратПродуктовПитания();
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ИспользоватьУчетПоИФО);
	
	ДобавитьПараметрКЭКМенюТребования(Реквизиты, Документ);
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
		"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,КатегорияДовольствующихся,
		|Номенклатура,ЦМО,ДополнительнаяАналитикаСчета,СчетУчета,Количество,Сумма",
		Документ, Реквизиты);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Материалы"" КАК ИмяСписка,
	|	""Материалы"" КАК СинонимСписка,
	|	Материалы.НомерСтроки КАК НомерСтроки,
	|	Материалы.ИФО КАК ИФО,
	|	Материалы.КФО КАК КФО,
	|	Материалы.КПС КАК КПС,
	|	Материалы.КЭК КАК КЭК,
	|	Материалы.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(Материалы.СчетУчета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
	|	ЕСТЬNULL(Материалы.СчетУчета.РазрешитьНеУказыватьПодразделение, ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
	|	Материалы.СчетУчета КАК СчетУчета,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.ДополнительнаяАналитикаСчета КАК ДопАналитика,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК ДопИзмерениеВидСубконто,
	|	Материалы.ЦМО КАК ДопИзмерение,
	|	Материалы.Количество КАК Количество,
	|	Материалы.Сумма КАК СуммаРуб,
	|	Материалы.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
	|	КатегорииДовольствующихсяИсточникиСредств.СчетЗатрат КАК СчетЗатрат,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КатегорииДовольствующихсяИсточникиСредств.КПСЗатрат, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ТОГДА Материалы.КПС
	|		ИНАЧЕ КатегорииДовольствующихсяИсточникиСредств.КПСЗатрат
	|	КОНЕЦ КАК КПСЗатрат,
	|	КатегорииДовольствующихсяИсточникиСредств.КЭКЗатрат КАК КЭКЗатрат,
	|	КатегорииДовольствующихсяИсточникиСредств.Ссылка.Подразделение КАК ПодразделениеЗатрат,
	|	КатегорииДовольствующихсяИсточникиСредств.СубконтоЗатрат1 КАК СубконтоЗатрат1,
	|	КатегорииДовольствующихсяИсточникиСредств.СубконтоЗатрат2 КАК СубконтоЗатрат2,
	|	КатегорииДовольствующихсяИсточникиСредств.СубконтоЗатрат3 КАК СубконтоЗатрат3
	|ИЗ
	|	ТаблицаМатериалы КАК Материалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КатегорииДовольствующихся.ИсточникиСредств КАК КатегорииДовольствующихсяИсточникиСредств
	|		ПО Материалы.КатегорияДовольствующихся = КатегорииДовольствующихсяИсточникиСредств.Ссылка
	|			И Материалы.КФО = КатегорииДовольствующихсяИсточникиСредств.КФО
	|			И (Материалы.ИФО = КатегорииДовольствующихсяИсточникиСредств.ИФО
	|				ИЛИ НЕ &ИспользоватьУчетПоИФО)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	СчетЗатрат";
	
	ВидыДопАналитики = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительнойАналитикиУчетаМЗ();
	ОбязательноУказыватьПодразделение = Ложь;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаВозвратПродуктов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.ДопАналитикаВидСубконто = ВидыДопАналитики.Получить(Выборка.СчетУчета);
		
		ОбязательноУказыватьПодразделение = ОбязательноУказыватьПодразделение
			ИЛИ (Выборка.УчетПоПодразделениям И НЕ Выборка.РазрешитьНеУказыватьПодразделение);
		
	КонецЦикла;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ОбязательноУказыватьПодразделение
	   И НЕ ЗначениеЗаполнено(Документ.Подразделение) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Подразделение'"));
		ТекстСообщения = ТекстСообщения + НСтр("ru='. Учет материальных запасов ведется по подразделениям.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			Документ.Ссылка, "Подразделение", "Объект", Отказ);
	КонецЕсли;
	
	// Проверка корректности заполнения источников средств в категориях довольствующихся.
	Документы.МенюТребование.ПроверитьЗаполнениеСчетаЗатрат(
		ТаблицаВозвратПродуктов.Скопировать(,"КатегорияДовольствующихся,ИФО,КФО"), Отказ);
	
	Возврат ТаблицаВозвратПродуктов;
	
КонецФункции

// Формирует движения по регистру "РасходПродуктов" по таблице источника данных "Списание продуктов питания".
//
Процедура ОтразитьСписаниеПродуктовПитанияВРегистреРасходПродуктов(ДокументОбъект, ТаблицаСписаниеПродуктовПитания) Экспорт
	
	Если ДокументОбъект.ЭтоНовый() Тогда
		Возврат; // Просмотр проводок в новом документе.
	КонецЕсли;
	
	РасходПродуктов = ДокументОбъект.Движения.РасходПродуктов;
	РасходПродуктов.Очистить();
	РасходПродуктов.Записывать = Истина;
	
	Отбор = Новый Структура("ВидУчета", "БУ");
	СтрокиСписанияПродуктовБУ = ТаблицаСписаниеПродуктовПитания.НайтиСтроки(Отбор);
	
	Для Каждого СтрокаСписания Из СтрокиСписанияПродуктовБУ Цикл
		
		Движение = РасходПродуктов.Добавить();
		Движение.Период      = ДокументОбъект.Дата;
		Движение.Организация = ДокументОбъект.Организация;
		ЗаполнитьЗначенияСвойств(Движение, СтрокаСписания,
			"ИФО,КФО,КатегорияДовольствующихся,Номенклатура");
		
		Движение.Количество                    = СтрокаСписания.Количество;
		Движение.Сумма                         = СтрокаСписания.Стоимость;
		Движение.КоличествоДовольствующихся    = СтрокаСписания.КоличествоДовольствующихся;
		Движение.ДобавитьКОсновномуКонтингенту = ДокументОбъект.ЭтоДополнительноеМенюТребование И ДокументОбъект.ДобавитьКОсновномуКонтингенту;
		
	КонецЦикла;
	
КонецПроцедуры

// Формирует движения по регистру "РасходПродуктов" по таблице источника данных "Возврат продуктов питания".
//
Процедура ОтразитьВозвратПродуктовПитанияВРегистреРасходПродуктов(ДокументОбъект, ТаблицаВозвратПродуктовПитания) Экспорт
	
	Если ДокументОбъект.ЭтоНовый() Тогда
		Возврат; // Просмотр проводок в новом документе.
	КонецЕсли;
	
	РасходПродуктов = ДокументОбъект.Движения.РасходПродуктов;
	РасходПродуктов.Очистить();
	РасходПродуктов.Записывать = Истина;
	
	Для Каждого СтрокаСписания Из ТаблицаВозвратПродуктовПитания Цикл
		
		Движение = РасходПродуктов.Добавить();
		Движение.Период      = ДокументОбъект.Дата;
		Движение.Организация = ДокументОбъект.Организация;
		ЗаполнитьЗначенияСвойств(Движение, СтрокаСписания);
		Движение.Количество  = СтрокаСписания.Количество;
		Движение.Сумма       = СтрокаСписания.СуммаРуб;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПараметрКЭКМенюТребования(Параметры, Документ)

	Если БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(Документ.Дата, Документ.Организация) Тогда
		КЭК = БухгалтерскийУчетПовтИсп.КЭКПоКоду("442");
	Иначе
		КЭК = БухгалтерскийУчетПовтИсп.КЭКПоКоду("440");
	КонецЕсли;
	Параметры.Вставить("КЭК", КЭК);

КонецПроцедуры

// Параметры расчета фактической стоимости МПЗПо партии.
// 
// Возвращаемое значение:
//  Структура - Параметры расчета фактической стоимости МПЗПо партии:
// * Дата - Дата -
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения -
// * Организация - СправочникСсылка.Организации -
// * ПартияМПЗ - ДокументСсылка
//             - Неопределено -
// * Подразделение - СправочникСсылка.Подразделения -
// * Ссылка - ДокументСсылка
//          - Неопределено -
// * Счет106 - ПланСчетовСсылка.ЕПСБУ -
// * УчитыватьПодразделение - Булево - можно отключить отбор по подразделению (для совместимости со старыми операциями)
// * ЦМО - СправочникСсылка.ЦМО -
Функция ПараметрыРасчетаФактическойСтоимостиМПЗПоПартии() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("Дата", '00010101');
	Параметры.Вставить("ИФО", Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	Параметры.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Параметры.Вставить("ПартияМПЗ", Неопределено);
	Параметры.Вставить("Подразделение", Справочники.Подразделения.ПустаяСсылка());
	Параметры.Вставить("Ссылка", Неопределено);
	Параметры.Вставить("Счет106", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	Параметры.Вставить("УчитыватьПодразделение", Истина);
	Параметры.Вставить("ЦМО", Справочники.ЦМО.ПустаяСсылка());
	Параметры.Вставить("БезУчетаОстатков", Ложь);
	Возврат Параметры;
КонецФункции

// Получает остатки МПЗ на счетах 106 по заданной партии
// 
// Параметры:
// 	ПараметрыОстатков - Структура - ключи см. ПараметрыРасчетаФактическойСтоимостиМПЗПоПартии()
// Возвращаемое значение:
// 	ТаблицаЗначений - таблица остатков:
//		*Счет - ПланСчетовСсылка.ЕПСБУ
//		*Номенклатура - СправочникСсылка.Номенклатура
//		*ВидЗатрат - СправочникСсылка.ВидыЗатрат
//		*КПС - СправочникСсылка.КлассификационныеПризнакиСчетов
//		*КЭК - СправочникСсылка.КОСГУ
//		*Валюта - СправочникСсылка.Валюты
//		*Подразделение - СправочникСсылка.Подразделения
//		*КФО - ПеречислениеСсылка.КВД
//		*СуммаОстаток - Число
//		*ВалютнаяСуммаОстаток - Число
//		*КоличествоОстаток - Число
Функция ФактическаяСтоимостьМПЗПоПартии(ПараметрыОстатков) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", ПараметрыОстатков.Организация);
	Запрос.УстановитьПараметр("Счет106",     ПараметрыОстатков.Счет106);
	Если ЗначениеЗаполнено(ПараметрыОстатков.Счет106) Тогда
		Счет106 = ПараметрыОстатков.Счет106;
		УчетПоПодразделениям = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет106).УчетПоПодразделениям;
	Иначе
		Счет106 = БухгалтерскийУчет.СписокСчетов("106.2П,106.3П,106.27,106.37,106.56", ПараметрыОстатков.Дата, , ПараметрыОстатков.Организация);
		УчетПоПодразделениям = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("106.2П,106.3П,106.27,106.37,106.56").УчетПоПодразделениям;
	КонецЕсли;
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		УчетПоПодразделениям = Ложь;
	КонецЕсли;
	Запрос.УстановитьПараметр("Счет106", Счет106);
	ВидыСубконто = СубконтоСчетаДляПолученияФактическойСтоимостиМПЗ(Счет106);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("КЭК340", БухгалтерскийУчетПовтИсп.КЭКПоКоду("340"));
	Запрос.УстановитьПараметр("КЭК440", БухгалтерскийУчетПовтИсп.КЭКПоКоду("440"));
	ТекстыЗапроса = Новый Массив;
	Если ВидыСубконто[ВидыСубконто.ВГраница()] = ПланыВидовХарактеристик.ВидыСубконто.Партии Тогда
		Запрос.УстановитьПараметр("Субконто3",   ПараметрыОстатков.ПартияМПЗ);
		ТекстыЗапроса.Добавить(ТекстЗапросаОстатковВложенияВМПЗСПартией());
	Иначе
		ТекстыЗапроса.Добавить(ТекстЗапросаВТГрупповыеКЭК());
		Запрос.УстановитьПараметр("Ссылка", ПараметрыОстатков.ПартияМПЗ);
		Запрос.УстановитьПараметр("НачалоПериода", Новый Граница(ПараметрыОстатков.ПартияМПЗ.МоментВремени(), ВидГраницы.Включая));
		ПрименяетсяДетальныйКЭК = БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(ПараметрыОстатков.Дата,
			ПараметрыОстатков.Организация);
		ТекстыЗапроса.Добавить(ТекстЗапросаДвиженияВложенияВМПЗ(ПрименяетсяДетальныйКЭК,
			Не ПараметрыОстатков.БезУчетаОстатков));
		Если Не ПараметрыОстатков.БезУчетаОстатков Тогда
			Запрос.УстановитьПараметр("Субконто3",   ПараметрыОстатков.ЦМО);
			ТекстыЗапроса.Добавить(ТекстЗапросаОстатковВложенияВМПЗБезПартии());
		КонецЕсли;
	КонецЕсли;
	Запрос.Текст = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Если ЗначениеЗаполнено(ПараметрыОстатков.Ссылка) Тогда
		Запрос.УстановитьПараметр("Период", Новый Граница(ПараметрыОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	ИначеЕсли ЗначениеЗаполнено(ПараметрыОстатков.Дата) Тогда
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ПараметрыОстатков.Дата), ВидГраницы.Включая));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Период", "");
	КонецЕсли;
	
	Если УчетПоПодразделениям И ПараметрыОстатков.УчитыватьПодразделение Тогда
		Запрос.УстановитьПараметр("УчетПоПодразделениям", Истина);
		Запрос.УстановитьПараметр("Подразделение", ПараметрыОстатков.Подразделение);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "Подразделение = &Подразделение");
	Иначе
		Запрос.УстановитьПараметр("УчетПоПодразделениям", Ложь);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ИСТИНА");
	КонецЕсли;
	
	// Отбор по ИФО
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО, "ИФО = &ИФО", "ИСТИНА"));
	Запрос.УстановитьПараметр("ИФО", ПараметрыОстатков.ИФО);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ТекстЗапросаОстатковВложенияВМПЗБезПартии()
	
	Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОбороты.Регистратор КАК Регистратор,
	|	ЖурналПроводокЕПСБУОбороты.Счет КАК Счет,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто2 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
	|	ЖурналПроводокЕПСБУОбороты.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ЕСТЬNULL(ЖурналПроводокЕПСБУОбороты.Счет.УчетПоПодразделениям, ЛОЖЬ)
	|			ТОГДА ЖурналПроводокЕПСБУОбороты.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ЖурналПроводокЕПСБУОбороты.КоличествоОборотКт КАК КоличествоОборотКт,
	|	ЖурналПроводокЕПСБУОбороты.КоличествоОборотДт КАК КоличествоОборотДт,
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборотДт КАК СуммаОборотДт,
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборотКт КАК СуммаОборотКт
	|ПОМЕСТИТЬ ВсеОбороты
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&Период,
	|			Регистратор,
	|			Счет В (&Счет106),
	|			&ВидыСубконто,
	|			Субконто1 В
	|					(ВЫБРАТЬ
	|						СоставДокумента.Номенклатура
	|					ИЗ
	|						СоставДокумента КАК СоставДокумента)
	|				И Субконто3 = &Субконто3
	|				И &УсловиеПодразделение
	|				И &УсловиеИФО,
	|			,
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеОборотыДт.Счет КАК Счет,
	|	ВсеОборотыДт.Номенклатура КАК Номенклатура,
	|	ВсеОборотыДт.ВидЗатрат КАК ВидЗатрат,
	|	ВсеОборотыДт.КПС КАК КПС,
	|	ВсеОборотыДт.КФО КАК КФО,
	|	ВсеОборотыДт.Подразделение КАК Подразделение,
	|	ВсеОборотыКт.КФО КАК КФОСписания,
	|	ВсеОборотыДт.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ПереносПоКФО
	|ИЗ
	|	ВсеОбороты КАК ВсеОборотыДт
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВсеОбороты КАК ВсеОборотыКт
	|		ПО ВсеОборотыДт.Регистратор = ВсеОборотыКт.Регистратор
	|			И ВсеОборотыДт.Счет = ВсеОборотыКт.Счет
	|			И ВсеОборотыДт.Номенклатура = ВсеОборотыКт.Номенклатура
	|			И ВсеОборотыДт.ВидЗатрат = ВсеОборотыКт.ВидЗатрат
	|			И ВсеОборотыДт.КФО <> ВсеОборотыКт.КФО
	|ГДЕ
	|	ВсеОборотыДт.КоличествоОборотДт <> 0
	|	И ВсеОборотыКт.КоличествоОборотКт <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставДокумента.Счет КАК Счет,
	|	СоставДокумента.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ПереносПоКФО.КФО, СоставДокумента.КФО) КАК КФО,
	|	ЕСТЬNULL(ПереносПоКФО.КПС, СоставДокумента.КПС) КАК КПС,
	|	СоставДокумента.КЭК КАК КЭК,
	|	СоставДокумента.СуммаОстаток КАК Сумма,
	|	СоставДокумента.КоличествоОстаток КАК Количество,
	|	СоставДокумента.Подразделение КАК Подразделение,
	|	СоставДокумента.ВидЗатрат КАК ВидЗатрат
	|ПОМЕСТИТЬ ТаблицаПоступленияСКорректировкойКФО
	|ИЗ
	|	СоставДокумента КАК СоставДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПереносПоКФО КАК ПереносПоКФО
	|		ПО СоставДокумента.Номенклатура = ПереносПоКФО.Номенклатура
	|			И СоставДокумента.ВидЗатрат = ПереносПоКФО.ВидЗатрат
	|			И СоставДокумента.Счет = ПереносПоКФО.Счет
	|			И СоставДокумента.КФО = ПереносПоКФО.КФОСписания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстаток,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстаток,
	|	ТаблицаПоступленияСКорректировкойКФО.Сумма КАК СуммаПоступления,
	|	ТаблицаПоступленияСКорректировкойКФО.Количество КАК КоличествоПоступления,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Счет.УчетПоПодразделениям, ЛОЖЬ)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение
	|ПОМЕСТИТЬ АктуальныеОстатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет106),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ТаблицаПоступленияСКорректировкойКФО.Номенклатура
	|					ИЗ
	|						ТаблицаПоступленияСКорректировкойКФО КАК ТаблицаПоступленияСКорректировкойКФО)
	|				И Субконто3 = &Субконто3
	|				И &УсловиеПодразделение
	|				И &УсловиеИФО
	|				И КФО В
	|					(ВЫБРАТЬ
	|						ТаблицаПоступленияСКорректировкойКФО.КФО
	|					ИЗ
	|						ТаблицаПоступленияСКорректировкойКФО КАК ТаблицаПоступленияСКорректировкойКФО)) КАК ЖурналПроводокЕПСБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПоступленияСКорректировкойКФО КАК ТаблицаПоступленияСКорректировкойКФО
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ТаблицаПоступленияСКорректировкойКФО.Счет
	|			И ЖурналПроводокЕПСБУОстатки.Субконто1 = ТаблицаПоступленияСКорректировкойКФО.Номенклатура
	|			И ЖурналПроводокЕПСБУОстатки.КФО = ТаблицаПоступленияСКорректировкойКФО.КФО
	|			И ЖурналПроводокЕПСБУОстатки.КПС = ТаблицаПоступленияСКорректировкойКФО.КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставДокумента.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(СоставДокумента.КЭК) КАК КЭК
	|ПОМЕСТИТЬ КЭКНоменклатуры
	|ИЗ
	|	СоставДокумента КАК СоставДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	СоставДокумента.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктуальныеОстатки.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА АктуальныеОстатки.КоличествоОстаток >= АктуальныеОстатки.КоличествоПоступления
	|			ТОГДА АктуальныеОстатки.КоличествоПоступления
	|		ИНАЧЕ АктуальныеОстатки.КоличествоОстаток
	|	КОНЕЦ КАК КоличествоОстаток,
	|	АктуальныеОстатки.КФО КАК КФО,
	|	АктуальныеОстатки.КПС КАК КПС,
	|	АктуальныеОстатки.Подразделение КАК Подразделение,
	|	АктуальныеОстатки.ВидЗатрат КАК ВидЗатрат,
	|	ВЫБОР
	|		КОГДА АктуальныеОстатки.КоличествоОстаток > АктуальныеОстатки.КоличествоПоступления
	|			ТОГДА АктуальныеОстатки.КоличествоПоступления * АктуальныеОстатки.СуммаОстаток / АктуальныеОстатки.КоличествоОстаток
	|		ИНАЧЕ АктуальныеОстатки.СуммаОстаток
	|	КОНЕЦ КАК СуммаОстаток,
	|	КЭКНоменклатуры.КЭК КАК КЭК,
	|	АктуальныеОстатки.Счет КАК Счет
	|ИЗ
	|	АктуальныеОстатки КАК АктуальныеОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ КЭКНоменклатуры КАК КЭКНоменклатуры
	|		ПО АктуальныеОстатки.Номенклатура = КЭКНоменклатуры.Номенклатура
	|УПОРЯДОЧИТЬ ПО
	|	АктуальныеОстатки.Номенклатура.Наименование";
	Возврат Текст;
КонецФункции

Функция ТекстЗапросаОстатковВложенияВМПЗСПартией()
	Текст = 
	"ВЫБРАТЬ
	|	КОСГУ440.Ссылка КАК КЭКРасхода,
	|	КОСГУ340.Ссылка КАК КЭКПрихода
	|ПОМЕСТИТЬ СоответствияКЭК
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ440
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ340
	|		ПО (ПОДСТРОКА(КОСГУ440.Код, 2, 2) = ПОДСТРОКА(КОСГУ340.Код, 2, 2))
	|ГДЕ
	|	КОСГУ340.Родитель = &КЭК340
	|	И КОСГУ440.Родитель = &КЭК440
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&КЭК440,
	|	&КЭК340
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.ВидЗатрат КАК ВидЗатрат,
	|	Остатки.КПС КАК КПС,
	|	ЕСТЬNULL(СоответствияКЭК.КЭКПрихода, Остатки.КЭК) КАК КЭК,
	|	Остатки.Валюта КАК Валюта,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.КФО КАК КФО,
	|	СУММА(Остатки.СуммаОстаток) КАК СуммаОстаток,
	|	СУММА(Остатки.ВалютнаяСуммаОстаток) КАК ВалютнаяСуммаОстаток,
	|	СУММА(Остатки.КоличествоОстаток) КАК КоличествоОстаток
	|ИЗ 
	|	(ВЫБРАТЬ
	|		ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|		ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|		ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
	|		ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|		ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
	|		ЖурналПроводокЕПСБУОстатки.Валюта КАК Валюта,
	|		ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|		ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|		ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК СуммаОстаток,
	|		ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
	|		ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК КоличествоОстаток
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|				&Период,
	|				Счет В (&Счет106),
	|				&ВидыСубконто,
	|				Организация = &Организация
	|					И &УсловиеИФО
	|					И &УсловиеПодразделение
	|					И Субконто3 = &Субконто3) КАК ЖурналПроводокЕПСБУОстатки) КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ СоответствияКЭК КАК СоответствияКЭК
	|		ПО (Остатки.КЭК = СоответствияКЭК.КЭКРасхода)
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Счет,
	|	Остатки.Номенклатура,
	|	Остатки.ВидЗатрат,
	|	Остатки.КПС,
	|	ЕСТЬNULL(СоответствияКЭК.КЭКПрихода, Остатки.КЭК),
	|	Остатки.Валюта,
	|	Остатки.Подразделение,
	|	Остатки.КФО";
	Возврат Текст;
КонецФункции

Функция СубконтоСчетаДляПолученияФактическойСтоимостиМПЗ(Счет106)
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат);
	
	ЕстьВидСубконтоЦМО = Ложь;
	ЕстьВидСубконтоПартии = Ложь;
	СубконтоЦМО = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
	СубконтоПартия = ПланыВидовХарактеристик.ВидыСубконто.Партии;
	
	Если ТипЗнч(Счет106) = Тип("Массив") Тогда
		Для Каждого ТекСчет106 Из Счет106 Цикл
			ЕстьВидСубконтоПартииТекСчет = БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(ТекСчет106, СубконтоПартия);
			ЕстьВидСубконтоПартии = ЕстьВидСубконтоПартии Или ЕстьВидСубконтоПартииТекСчет; 
			ЕстьВидСубконтоЦМОТекСчет = БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(ТекСчет106, СубконтоЦМО);
			ЕстьВидСубконтоЦМО = ЕстьВидСубконтоЦМО Или ЕстьВидСубконтоЦМОТекСчет;
			
			Если ЕстьВидСубконтоЦМО Тогда
				Прервать;
			КонецЕсли;  
		КонецЦикла;
	Иначе
		ЕстьВидСубконтоПартии = БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(ТекСчет106, СубконтоПартия);
		ЕстьВидСубконтоЦМО = БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(ТекСчет106, СубконтоЦМО);
	КонецЕсли;
	
	Если ЕстьВидСубконтоЦМО Тогда
		ВидыСубконто.Добавить(СубконтоЦМО);
	ИначеЕсли ЕстьВидСубконтоПартии Тогда
		ВидыСубконто.Добавить(СубконтоПартия);
	Иначе
		ВызватьИсключение "Не счете 106.xП должно быть субконто ЦМО или Партии";
	КонецЕсли;
	
	Возврат ВидыСубконто;
	
КонецФункции

Функция ТаблицаДанныхЗаполненияОприходованияМЗ()
	
	ТипКоличества = ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3);
	ТипСуммы = ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18, 2);
	
	Результат = Новый ТаблицаЗначений();
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Количество", ТипКоличества);
	Результат.Колонки.Добавить("Сумма", ТипСуммы);
	Результат.Колонки.Добавить("ВидЗатрат", Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	Результат.Колонки.Добавить("КПСКредита", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Результат.Колонки.Добавить("КЭККредита", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Результат.Колонки.Добавить("КЭКУчета", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Результат.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Результат.Колонки.Добавить("СчетКредита", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Результат.Колонки.Добавить("СчетУчета", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Результат.Колонки.Добавить("ВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	
	Возврат Результат;
	
КонецФункции

// Структура параметров для функции РассчитатьОприходованиеМПЗПоПартии. Может быть передан документ-объект 
// или реквизит Объект из формы документа для заполнения основных ключей структуры.
// 
// Параметры:
// 	Документ - ДокументОбъект.ОприходованиеМЗПоФактическойСтоимости
// 			- ДокументОбъект.ОприходованиеМЗПоФактическойСтоимостиИК
// 			- ДанныеФормыСтруктура
// Возвращаемое значение:
// 	см. ПустыеДополнительныеПараметрыРасчетаОприходованияМПЗПоПартии
Функция ДополнительныеПараметрыРасчетаОприходованияМПЗПоПартии(Документ = Неопределено) Экспорт
	
	Параметры = ПустыеДополнительныеПараметрыРасчетаОприходованияМПЗПоПартии();
	Если Документ <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Параметры, Документ);
		Параметры.ЦМО = Документ.ЦМООтправитель;
	КонецЕсли;
	Возврат Параметры;
	
КонецФункции

// Пустые дополнительные параметры расчета оприходования МПЗПо партии.
// 
// Возвращаемое значение:
//  Структура - Пустые дополнительные параметры расчета оприходования МПЗПо партии:
// * Дата - Дата -
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения -
// * Организация - СправочникСсылка.Организации -
// * ПартияМПЗ - ДокументСсылка
//             - Неопределено
// * Подразделение - СправочникСсылка.Подразделения -
// * ПолучатьСчетИзНоменклатуры - Булево -
// * Ссылка - ДокументСсылка
//          - Неопределено
// * СчетНоменклатуры - ПланСчетовСсылка.ЕПСБУ -
// * ЦМО - СправочникСсылка.ЦМО -
Функция ПустыеДополнительныеПараметрыРасчетаОприходованияМПЗПоПартии()
	Параметры = Новый Структура;
	Параметры.Вставить("Дата", '00010101');
	Параметры.Вставить("ИФО", Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	Параметры.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Параметры.Вставить("ПартияМПЗ", Неопределено);
	Параметры.Вставить("Подразделение", Справочники.Подразделения.ПустаяСсылка());
	Параметры.Вставить("ПолучатьСчетИзНоменклатуры", Истина);
	Параметры.Вставить("Ссылка", Неопределено);
	Параметры.Вставить("СчетНоменклатуры", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	Параметры.Вставить("ЦМО", Справочники.ЦМО.ПустаяСсылка());
	Параметры.Вставить("БезУчетаОстатков", Ложь);
	Возврат Параметры;
КонецФункции

Функция РассчитатьОприходованиеМПЗПоПартии(Параметры) Экспорт
	
	ПараметрыРасчета = ПараметрыРасчетаФактическойСтоимостиМПЗПоПартии();
	ЗаполнитьЗначенияСвойств(ПараметрыРасчета, Параметры);
	
	ОстаткиПоПартии = ФактическаяСтоимостьМПЗПоПартии(ПараметрыРасчета);
	
	ТаблицаДокумента = ТаблицаДанныхЗаполненияОприходованияМЗ();
	
	НоменклатураДокумента = Новый Массив;
	
	Для Каждого СтрокаОстатка Из ОстаткиПоПартии Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		НоваяСтрока.Номенклатура = СтрокаОстатка.Номенклатура;
		НоваяСтрока.Количество = СтрокаОстатка.КоличествоОстаток;
		НоваяСтрока.Сумма = СтрокаОстатка.СуммаОстаток;
		НоваяСтрока.ВидЗатрат = СтрокаОстатка.ВидЗатрат;
		НоваяСтрока.КПСКредита = СтрокаОстатка.КПС;
		НоваяСтрока.КЭККредита = СтрокаОстатка.КЭК;
		НоваяСтрока.КФО = СтрокаОстатка.КФО;
		НоваяСтрока.СчетКредита = СтрокаОстатка.Счет;
		Если ЗначениеЗаполнено(Параметры.СчетНоменклатуры) Тогда
			НоваяСтрока.СчетУчета = Параметры.СчетНоменклатуры;
		КонецЕсли;
		
		НоменклатураДокумента.Добавить(СтрокаОстатка.Номенклатура);
		
	КонецЦикла;
	
	Если Параметры.ПолучатьСчетИзНоменклатуры Тогда
	
		СчетаНоменклатуры = СвойстваСчетовНоменклатуры(НоменклатураДокумента);
		
		Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
			
			ДанныеСчета = СчетаНоменклатуры.Получить(СтрокаДокумента.Номенклатура);
			Если ДанныеСчета = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаДокумента.СчетУчета = ДанныеСчета.СчетУчета;
			Если ДанныеСчета.ВидСубконто <> ПланыВидовХарактеристик.ВидыСубконто.Партии Тогда
				СтрокаДокумента.ВидСубконто = ДанныеСчета.ВидСубконто;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

	ДанныеДляРасчетаКЭК = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
	ЗаполнитьЗначенияСвойств(ДанныеДляРасчетаКЭК, Параметры, "Дата, Организация, ИФО");
	ДанныеДляРасчетаКЭК.ДтКт = "Дт";
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		Если ЗначениеЗаполнено(СтрокаДокумента.СчетУчета) Тогда
			ДанныеДляРасчетаКЭК.КФО       = СтрокаДокумента.КФО;
			ДанныеДляРасчетаКЭК.Счет      = СтрокаДокумента.СчетУчета;
			ДанныеДляРасчетаКЭК.Субконто1 = СтрокаДокумента.Номенклатура;
			СтрокаДокумента.КЭКУчета = БухгалтерскийУчет.КЭКПроводки(ДанныеДляРасчетаКЭК);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

Функция СвойстваСчетовНоменклатуры(Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура.Ссылка,
	|	ЕПСБУ.Ссылка КАК СчетУчета,
	|	ЕСТЬNULL(ЕПСБУВидыСубконто.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) КАК ВидСубконто
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|			ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|			И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО)
	|			И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			И НЕ ЕПСБУВидыСубконто.ТолькоОбороты
	|		ПО Номенклатура.СчетУчета = ЕПСБУ.Код
	|ГДЕ
	|	Номенклатура.Ссылка В (&МассивСсылок)";
	Запрос.УстановитьПараметр("МассивСсылок", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	
	СчетаНоменклатуры = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		СчетаНоменклатуры.Вставить(Выборка.Ссылка, Новый Структура("СчетУчета, ВидСубконто", Выборка.СчетУчета, Выборка.ВидСубконто));
	КонецЦикла;
	
	Возврат СчетаНоменклатуры;
	
КонецФункции

// Используется для счетов 106.хП с 2021 года (без субконто Партии)
// 
// Параметры:
// 	ТаблицаДокумента - ТаблицаЗначений - см. ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу()
// 	Реквизиты - Структура -
// 	Отказ - Булево -
// Возвращаемое значение:
// 	ТаблицаЗначений - 
Функция ТаблицаСписанияВложенийВМЗ_Покупка(ТаблицаДокумента, Реквизиты, Отказ) Экспорт
	
	ТаблицаСписанных = ПустаяТаблицаСписаниеМатериальныхЗапасов();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаСписанных;
	КонецЕсли;

	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ПлательщикНалогаНаПрибыль",        УчетнаяПолитика.ПлательщикНалогаНаПрибыль);
	
	ТаблицаДокумента = ДобавитьПараметрыУчетаМатериальныхЗапасов(ТаблицаДокумента, Реквизиты);

	Если ТаблицаДокумента.Колонки.Найти("ВидУчета") = Неопределено Тогда
		ТаблицаДокумента.Колонки.Вставить(0, "ВидУчета", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(3));
		ТаблицаДокумента.ЗаполнитьЗначения("БУ", "ВидУчета");
	КонецЕсли;
	
	Если Реквизиты.ПлательщикНалогаНаПрибыль
	   И НЕ (Реквизиты.Свойство("НеСписыватьПоНУ") И Реквизиты.НеСписыватьПоНУ) Тогда
		ТаблицаДокумента = ДобавитьСтрокиСписанияПоНалоговомуУчету(ТаблицаДокумента, Реквизиты);
	КонецЕсли;
	
	СчетаУчета = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаУчета, ТаблицаДокумента.ВыгрузитьКолонку("СчетУчета"), Истина);
	
	НоменклатураДокумента = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НоменклатураДокумента, ТаблицаДокумента.ВыгрузитьКолонку("Номенклатура"), Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаДокумента.Номенклатура,
	|	ТаблицаДокумента.СчетУчета,
	|	ТаблицаДокумента.КФО,
	|	ТаблицаДокумента.КПС,
	|	ТаблицаДокумента.НомерСтроки,
	|	ТаблицаДокумента.Количество
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	&ТаблицаДокумента КАК ТаблицаДокумента
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	СчетУчета,
	|	КФО,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ЖурналПроводокЕПСБУОстатки.ИФО,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СтоимостьВсего,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СтоимостьНеУчитываетсяНУВсего,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СтоимостьЕНВДВсего,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоВсего,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&СЧетаУчета), &ВидыСубконто,
	|		Организация = &Организация
	|	И &УсловиеИФО
	|	И &УсловиеПодразделение
	|	И Субконто1 В (&Номенклатура)
	|	И Субконто2 = &ЦМО) КАК ЖурналПроводокЕПСБУОстатки
	|ГДЕ
	|	(ЖурналПроводокЕПСБУОстатки.Субконто1, ЖурналПроводокЕПСБУОстатки.Счет,
	|		ЖурналПроводокЕПСБУОстатки.КФО) В
	|		(ВЫБРАТЬ
	|			ТаблицаДокумента.Номенклатура,
	|			ТаблицаДокумента.СчетУчета,
	|			ТаблицаДокумента.КФО
	|		ИЗ
	|			ТаблицаДокумента КАК ТаблицаДокумента)";
	Запрос.УстановитьПараметр("СчетаУчета", СчетаУчета);
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураДокумента);
	Запрос.УстановитьПараметр("ТаблицаДокумента", ТаблицаДокумента);
	Запрос.УстановитьПараметр("ЦМО", Реквизиты.ЦМО);
	Запрос.УстановитьПараметр("ИмяСписка", "Материалы");
	Запрос.УстановитьПараметр("СинонимСписка", "Материалы");
	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
	ПериодОстатков = ?(Реквизиты.Ссылка.Пустая(),
		Новый Граница(КонецДня(Реквизиты.Дата),         ВидГраницы.Включая),
		Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Период", ПериодОстатков);
	ИспользуемыеСубконто = Новый Массив;
	ИспользуемыеСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ИспользуемыеСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	ИспользуемыеСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат);
	Запрос.УстановитьПараметр("ВидыСубконто", ИспользуемыеСубконто);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ИСТИНА");
	
	ТаблицаОстатки = Запрос.Выполнить().Выгрузить();

	Для каждого СтрокаДокумента Из ТаблицаДокумента Цикл
	
		КоличествоОсталосьПогасить = СтрокаДокумента.Количество;
		Если КоличествоОсталосьПогасить <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("СчетУчета,Номенклатура,КФО");
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
		
		Если СтрокаДокумента.УчетПоИФО Тогда
			Отбор.Вставить("ИФО", СтрокаДокумента.ИФО);
		КонецЕсли;
		Если СтрокаДокумента.УчетПоКПС Тогда
			Отбор.Вставить("КПС", СтрокаДокумента.КПС);
		КонецЕсли;
		Если СтрокаДокумента.УчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", СтрокаДокумента.Подразделение);
		КонецЕсли;
		СтрокиОстатков = ТаблицаОстатки.НайтиСтроки(Отбор);
		
		ТаблицаИтога = ТаблицаОстатки.Скопировать(СтрокиОстатков, "Количество");
		КоличествоОстатков = ТаблицаИтога.Итог("Количество");
		
		Если КоличествоОстатков = 0 Тогда
			КоэффициентСписанияСуммы = 0;
		Иначе
			КоэффициентСписанияСуммы = КоличествоОсталосьПогасить / КоличествоОстатков;
		КонецЕсли;
		
		Если СтрокаДокумента.ВидУчета = "БУ" Тогда
			СуммаОсталосьПогасить = СтрокаДокумента.СуммаСписания;
		Иначе
			СуммаОсталосьПогасить = СтрокаДокумента.СуммаСписанияНУ;
		КонецЕсли;
		
		Для каждого СтрокаОстатков Из СтрокиОстатков Цикл
			
			//Если СтрокаОстатков.Количество <= 0
			//	ИЛИ СтрокаОстатков.КоличествоВсего <= 0 Тогда
			//	Продолжить;
			//КонецЕсли;
			
			Если СтрокаОстатков.Количество > 0 Тогда
			
				Если КоличествоОсталосьПогасить = 0 Тогда
					// Количество уже списано. Теперь можно списывать только дополнительные вложения.
					Продолжить; 
				КонецЕсли;
			
				Количество  = Мин(СтрокаОстатков.Количество, КоличествоОсталосьПогасить);
				Коэффициент = Количество / СтрокаОстатков.КоличествоВсего;
				
				Если СтрокаДокумента.НеПересчитыватьСумму
					И КоличествоОсталосьПогасить <= СтрокаОстатков.Количество Тогда
					
					Стоимость                = СуммаОсталосьПогасить;
					СтоимостьНеУчитываетсяНУ = 0;
					СтоимостьЕНВД            = 0;
					
				Иначе
					
					Стоимость                = Окр(СтрокаОстатков.СтоимостьВсего                * Коэффициент, 2, 1);
					СтоимостьНеУчитываетсяНУ = Окр(СтрокаОстатков.СтоимостьНеУчитываетсяНУВсего * Коэффициент, 2, 1);
					СтоимостьЕНВД            = Окр(СтрокаОстатков.СтоимостьЕНВДВсего            * Коэффициент, 2, 1);
					
				КонецЕсли;
				
				СуммаОсталосьПогасить = СуммаОсталосьПогасить - Стоимость;
				КоличествоОсталосьПогасить = КоличествоОсталосьПогасить - Количество;
				
			Иначе
				
				Количество = 0;
				
				Стоимость                = Окр(СтрокаОстатков.СтоимостьВсего                * КоэффициентСписанияСуммы, 2, 1);
				СтоимостьНеУчитываетсяНУ = Окр(СтрокаОстатков.СтоимостьНеУчитываетсяНУВсего * КоэффициентСписанияСуммы, 2, 1);
				СтоимостьЕНВД            = Окр(СтрокаОстатков.СтоимостьЕНВДВсего            * КоэффициентСписанияСуммы, 2, 1);
				
			КонецЕсли;
			
			СтрокаОстатков.Количество      = СтрокаОстатков.Количество - Количество;
			СтрокаОстатков.КоличествоВсего = СтрокаОстатков.КоличествоВсего - Количество;
			
			СтрокаОстатков.СтоимостьВсего                 = СтрокаОстатков.СтоимостьВсего - Стоимость;
			СтрокаОстатков.СтоимостьНеУчитываетсяНУВсего  = СтрокаОстатков.СтоимостьНеУчитываетсяНУВсего - СтоимостьНеУчитываетсяНУ;
			СтрокаОстатков.СтоимостьЕНВДВсего             = СтрокаОстатков.СтоимостьЕНВДВсего - СтоимостьЕНВД;
			
			СтрокаСписанных = ТаблицаСписанных.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСписанных, СтрокаДокумента);
			СтрокаСписанных.ДопАналитика = СтрокаОстатков.ВидЗатрат;
			СтрокаСписанных.Количество               = Количество;
			СтрокаСписанных.Стоимость                = Стоимость;
			СтрокаСписанных.СтоимостьНеУчитываетсяНУ = СтоимостьНеУчитываетсяНУ;
			СтрокаСписанных.СтоимостьЕНВД            = СтоимостьЕНВД;
			
		КонецЦикла;
		
		// Несписанное количество добавим отдельной строкой
		Если КоличествоОсталосьПогасить > 0  Тогда
			
			СтрокаСписанных = ТаблицаСписанных.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСписанных, СтрокаДокумента);
			СтрокаСписанных.Количество      = КоличествоОсталосьПогасить;
			СтрокаСписанных.ОстатокПревышен = Истина;
			
			ТекстОшибки = НСтр("ru='Указанное количество ""%5"" превышает остаток%3 по счету %4.
				|Остаток: %1; Не хватает: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				СтрокаДокумента.Количество - КоличествоОсталосьПогасить,
				КоличествоОсталосьПогасить,
				?(СтрокаДокумента.ВидУчета="НУ", НСтр("ru=' в налоговом учете'"), ""),
				СтрокаДокумента.СчетУчета,
				СтрокаДокумента.Номенклатура);
				
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru = 'Количество'"),
				СтрокаДокумента.НомерСтроки,
				СтрокаДокумента.СинонимСписка,
				ТекстОшибки);
				
			ПолеКоличество = СтрокаДокумента.ИмяСписка + "[" + Формат(СтрокаДокумента.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Количество";
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Реквизиты.Ссылка, ПолеКоличество, "Объект");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаСписанных;
	
КонецФункции

// Структура таблицы источника данных "Списание резервов под снижение стоимости материальных запасов"
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица списание материальных запасов:
// * ИмяСписка - Строка -
// * СинонимСписка - Строка -
// * НомерСтроки - Число -
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения -
// * КФО - ПеречислениеСсылка.КВД -
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * КЭК - СправочникСсылка.КОСГУ -
// * Подразделение - СправочникСсылка.Подразделения -
// * СчетУчетаРезервов - ПланСчетовСсылка.ЕПСБУ -
// * СчетУчета - ПланСчетовСсылка.ЕПСБУ -
// * Номенклатура - СправочникСсылка.Номенклатура -
// * ДопИзмерение - Характеристика.ВидыСубконто - ЦМО, Контрагент, ВидЗатрат и пр.
// * ДопИзмерениеВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто -
// * ДопАналитика - Характеристика.ВидыСубконто - Реквизит ДополнительнаяАналитикаСчета табчасти
// * ДопАналитикаВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто -
// * Партия - Характеристика.ВидыСубконто -
// * ПартияВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто -
// * Количество - Число -
// * Сумма - Число -
Функция ПустаяТаблицаСписаниеРезервовМатериальныхЗапасов() Экспорт
	
	ПустаяТаблица = Новый ТаблицаЗначений; 
	
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип; 
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));

	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет учета резервов
	ПустаяТаблица.Колонки.Добавить("СчетУчетаРезервов",       Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	
	// Счет и аналитика учета материальных запасов.
	ПустаяТаблица.Колонки.Добавить("СчетУчета",               Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",            Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("ДопИзмерение",            ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.
	ПустаяТаблица.Колонки.Добавить("ДопИзмерениеВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ПустаяТаблица.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ПустаяТаблица.Колонки.Добавить("ДопАналитикаВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ПустаяТаблица.Колонки.Добавить("Партия",                  ПланыВидовХарактеристик.ВидыСубконто.Партии.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("ПартияВидСубконто",       Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));


	// Количество, сумма списанных резервов под снижение стоимости материальных запасов.
	ПустаяТаблица.Колонки.Добавить("Количество",               Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
	ПустаяТаблица.Колонки.Добавить("Сумма",                    Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	
	Возврат ПустаяТаблица;

КонецФункции

Процедура ДобавитьСтрокуСписанияРезерва(ТаблицаСписанных, ТекущаяСтрокаСписания, ТекущаяСтрокаРезерва, СуммаРезерва, КоличествоРезерва)

	НоваяСтрокаСписанияРезервов = ТаблицаСписанных.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрокаСписанияРезервов, ТекущаяСтрокаРезерва);
	ЗаполнитьЗначенияСвойств(НоваяСтрокаСписанияРезервов, ТекущаяСтрокаСписания,"НомерСтроки,
	|СинонимСписка,
	|ИмяСписка,
	|СчетУчета,
	|ДопИзмерениеВидСубконто,
	|ДопИзмерение,
	|ДопАналитикаВидСубконто,
	|ДопАналитика,
	|ПартияВидСубконто,
	|Партия");
	НоваяСтрокаСписанияРезервов.Сумма = СуммаРезерва;
	НоваяСтрокаСписанияРезервов.Количество = КоличествоРезерва;
	
КонецПроцедуры

// Формирует таблицу источника данных "Списание резервов под снижение стоимости материальных запасов"
// и корректирует таблицу списания МЗ при реализации на суммы резервов
//
// Параметры:
//  ТаблицаСписания - Подготовленная таблица списанных МЗ
//  ДокументОбъект - Объект источника
//  Реквизиты - Структура -
//  
// Возвращаемое значение:
//  ТаблицаЗначений - см. ПустаяТаблицаСписаниеРезервовМатериальныхЗапасов
//
Функция ТаблицаСписаниеРезервовМатериальныхЗапасов(ТаблицаСписания, ДокументОбъект, Реквизиты) Экспорт
	
	ТаблицаСписанныхРезервов = ПустаяТаблицаСписаниеРезервовМатериальныхЗапасов();
	Если ТаблицаСписания.Количество() = 0 Тогда
		Возврат ТаблицаСписанныхРезервов;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));

	ТаблицаОстаткиРезервов = Неопределено;
	
	ПериодОстатков = ?(Реквизиты.Ссылка.Пустая(),
		Новый Граница(КонецДня(Реквизиты.Дата),         ВидГраницы.Включая),
		Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));

	ТаблицаОстаткиРезервов = ОстаткиРезервовДляСписанияМатериальныхЗапасов(ПериодОстатков, ТаблицаСписания, Реквизиты);
	ТаблицаОстаткиРезервов.Индексы.Добавить("СчетУчетаРезервов,Номенклатура,КФО,ИФО,КПС,Подразделение");
	РазрешенныеСчетаУчетаМЗ = РазрешенныеСчетаУчетаМЗДляСписанияРезерва(ПериодОстатков, Реквизиты.Организация);
	ОперацияРеализации = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Реквизиты, "УменьшатьСтоимостьНаСуммуРезерва", Ложь);
	
	Если ТаблицаОстаткиРезервов <> Неопределено Тогда
		ТипыНоменклатурыСписания = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ТаблицаСписания.ВыгрузитьКолонку("Номенклатура"), "ТипНоменклатуры");
		СчетРезервированияТовары = БухгалтерскийУчет.СчетПоКоду("114.88", Реквизиты.Дата, Реквизиты.Организация);
		СчетРезервированияГотоваяПродукция = БухгалтерскийУчет.СчетПоКоду("114.87", Реквизиты.Дата, Реквизиты.Организация);
		Для Каждого СтрокаСписания Из ТаблицаСписания Цикл
			Если СтрокаСписания.ВидУчета <> "БУ" ИЛИ РазрешенныеСчетаУчетаМЗ.Найти(СтрокаСписания.СчетУчета) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ОперацияРеализации Тогда
				СтрокаИсточника = ДокументОбъект[СтрокаСписания.ИмяСписка][СтрокаСписания.НомерСтроки -1];
				Попытка
					ЦенаРеализации = ?(ДокументОбъект.СуммаВключаетНДС, СтрокаИсточника.Цена, (СтрокаИсточника.Всего - СтрокаИсточника.СуммаНДС)/ СтрокаИсточника.Количество);
				Исключение
					ПолеНоменклатура = СтрокаИсточника.ИмяСписка + "[" + Формат(СтрокаСписания.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Цена";
					ОбщегоНазначения.СообщитьПользователю("Ошибка расчета суммы реализации - резерв не списан!", Реквизиты.Ссылка, ПолеНоменклатура, "Объект");
					Продолжить;
				КонецПопытки;
				Если ЦенаРеализации * СтрокаСписания.Количество >= СтрокаСписания.Стоимость Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			ОтборРезервов = Новый Структура("Номенклатура,КФО,ИФО,Подразделение,КПС,СчетУчетаРезервов");
			ЗаполнитьЗначенияСвойств(ОтборРезервов, СтрокаСписания);
			ОтборРезервов.СчетУчетаРезервов = ?(ТипыНоменклатурыСписания[СтрокаСписания.Номенклатура] = Перечисления.ТипыНоменклатуры.Продукция,
										СчетРезервированияГотоваяПродукция,
										СчетРезервированияТовары);
			СтрокиРезервов = ТаблицаОстаткиРезервов.НайтиСтроки(ОтборРезервов);
			Если СтрокиРезервов.Количество() Тогда
				КоличествоСписания = СтрокаСписания.Количество;
				СуммаРезерваСтрокиСписания = 0;
				Для Каждого СтрокаРезерва Из СтрокиРезервов Цикл
					Дельта = КоличествоСписания - СтрокаРезерва.КоличествоОстаток;
					Если Дельта < 0 Тогда
						СуммаРезерва = КоличествоСписания * СтрокаРезерва.СуммаОстаток / СтрокаРезерва.КоличествоОстаток;
						ДобавитьСтрокуСписанияРезерва(ТаблицаСписанныхРезервов, СтрокаСписания, СтрокаРезерва, СуммаРезерва, КоличествоСписания);
						СтрокаРезерва.КоличествоОстаток = -Дельта;
						СуммаРезерваСтрокиСписания = СуммаРезерваСтрокиСписания + СуммаРезерва;
						Прервать;
					Иначе
						СуммаРезерва = СтрокаРезерва.СуммаОстаток;
						ДобавитьСтрокуСписанияРезерва(ТаблицаСписанныхРезервов, СтрокаСписания, СтрокаРезерва, СуммаРезерва, СтрокаРезерва.КоличествоОстаток);
						ТаблицаОстаткиРезервов.Удалить(СтрокаРезерва);
						КоличествоСписания = Дельта;
						СуммаРезерваСтрокиСписания = СуммаРезерваСтрокиСписания + СуммаРезерва;
					КонецЕсли;
				КонецЦикла;
				Если ОперацияРеализации Тогда
					СтрокаСписания.Стоимость = СтрокаСписания.Стоимость - СуммаРезерваСтрокиСписания;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат ТаблицаСписанныхРезервов;
	
КонецФункции

Функция ТекстЗапросаДвиженияВложенияВМПЗ(ПрименяетсяДетальныйКЭК ,ВременнаяТаблица = Ложь)
	
	Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК Счет,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.Номенклатура)
	|	КОНЕЦ КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.Номенклатура).Наименование
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.Номенклатура).Наименование
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.Номенклатура).Наименование
	|	КОНЕЦ КАК НоменклатураНаименование,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПС,
	|	&ПолеКЭК КАК КЭК,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма) КАК СуммаОстаток,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт) КАК КоличествоОстаток,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.УчетПоПодразделениям, ЛОЖЬ)
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.ВидыЗатрат)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.ВидыЗатрат)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.ВидыЗатрат)
	|	КОНЕЦ КАК ВидЗатрат
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор = &Ссылка
	|				И СчетДт В (&Счет106),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|	ЛЕВОЕ СОЕДИНЕНИЕ ГруппировочныеКЭК КАК ГруппировочныеКЭК
	|	ПО ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт = ГруппировочныеКЭК.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	|	&ПолеКЭК,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.Номенклатура)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.Номенклатура).Наименование
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.Номенклатура).Наименование
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.Номенклатура).Наименование
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.УчетПоПодразделениям, ЛОЖЬ)
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.ВидыЗатрат)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.ВидыЗатрат)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.ВидыЗатрат)
	|	КОНЕЦ
	|	
	|УПОРЯДОЧИТЬ ПО
	|	НоменклатураНаименование"
	;
	
	Если ПрименяетсяДетальныйКЭК Тогда
		Текст = СтрЗаменить(Текст, "&ПолеКЭК",
			"ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт");
	Иначе
		Текст = СтрЗаменить(Текст, "&ПолеКЭК",
			"ЕСТЬNULL(ГруппировочныеКЭК.Родитель, ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт)");
	КонецЕсли;
		
	Если ВременнаяТаблица Тогда	
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(Текст);
		Запрос1 = СхемаЗапроса.ПакетЗапросов[0]; 
		Запрос1.Порядок.Очистить();
		Запрос1.ТаблицаДляПомещения = "СоставДокумента";
		Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

// Стоимость списания неактивов на забалансе параметры.
// 
// Параметры:
//  Объект - ДанныеФормыСтруктура:
//   * Дата - Дата
//   * Ссылка - ДокументСсылка
//   * Организация - СправочникСсылка.Организации
//  ЕстьСубконтоЦМО - Булево - Есть субконто ЦМО
// 
// Возвращаемое значение:
//  Структура - Стоимость списания неактивов на забалансе параметры:
// * Дата - Дата - 
// * Ссылка - Неопределено, ДокументСсылка - 
// * ТаблицаНоменклатуры - ТаблицаЗначений:
//  ** Номенклатура - СправочникСсылка.Номенклатура 
//  ** КФО - ПеречислениеСсылка.КВД 
//  ** ЦМО - СправочникСсылка.ЦМО 
// * Организация - СправочникСсылка.Организации - 
// * СчетУчетаЗабаланс - ПланСчетовСсылка.ЕПСБУ - 
// * СчетаУчетаБаланс - Массив из ПланСчетовСсылка.ЕПСБУ - 
// * ВидыСубконто - Массив из ПланВидовХарактеристикСсылка.ВидыСубконто - 
Функция СтоимостьСписанияНеактивовНаЗабалансе_Параметры(Объект, ЕстьСубконтоЦМО = Истина) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("Дата", Объект.Дата);
	Параметры.Вставить("Ссылка", Объект.Ссылка);
	Параметры.Вставить("ТаблицаНоменклатуры", Новый ТаблицаЗначений);
	Параметры.Вставить("Организация", Объект.Организация);
	Параметры.Вставить("СчетУчетаЗабаланс", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	Параметры.Вставить("СчетаУчетаБаланс", Новый Массив);
	Параметры.Вставить("ВидыСубконто", Новый Массив);
	Параметры.ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	Если ЕстьСубконтоЦМО Тогда
		Параметры.ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	КонецЕсли;
	Параметры.ТаблицаНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Параметры.ТаблицаНоменклатуры.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Параметры.ТаблицаНоменклатуры.Колонки.Добавить("ЦМО", Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	Возврат Параметры;
КонецФункции

// Возвращает стоимость, по которой МЗ были списаны на забаланс.
// 
// Параметры:
//  Параметры - см. СтоимостьСписанияНеактивовНаЗабалансе_Параметры
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Стоимость списания неактивов на забалансе:
// * Номенклатура - СправочникСсылка.Номенклатура - 
// * ЦМО - СправочникСсылка.ЦМО - 
// * СчетУчета - ПланСчетовСсылка.ЕПСБУ - 
// * КФО - ПеречислениеСсылка.КВД - 
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов - 
// * КЭК - СправочникСсылка.КОСГУ - 
// * Количество - Число - 
// * Сумма - Число - 
Функция СтоимостьСписанияНеактивовНаЗабалансе(Параметры) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("ЦМО", Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	Результат.Колонки.Добавить("СчетУчета", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Результат.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Результат.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Результат.Колонки.Добавить("КЭК", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	
	Выборка = ВыборкаИзЗапросаСтоимостиСписанияНеактивовНаЗабалансе(Параметры);
	
	КэшКОСГУ = Новый Соответствие; 
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НовыйКОСГУ = КэшКОСГУ.Получить(Выборка.КЭККод);
		Если НовыйКОСГУ = Неопределено Тогда
			НовыйКОСГУ = БухгалтерскийУчетПовтИсп.КЭКПоКоду("3" + Сред(Выборка.КЭККод, 2));
			КэшКОСГУ.Вставить(Выборка.КЭККод, НовыйКОСГУ);
		КонецЕсли;
		НоваяСтрока.КЭК = НовыйКОСГУ;
		
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Возвращает "Истина", если есть хотя бы одна строка, по которой превышен остаток.
// При поиске учитывается переданный ВидУчета - "БУ" или "НУ".
// 
// Параметры:
//  ТаблицаСписания - см. ПустаяТаблицаСписаниеМатериальныхЗапасов, см. ПустаяТаблицаСписаниеМатериальныхЗапасов
//  ВидУчета - Строка - "БУ" или "НУ.
// 
// Возвращаемое значение:
//  Булево
Функция ОстатокПревышенПоТаблицеСписания(ТаблицаСписания, ВидУчета) Экспорт
	Возврат ТаблицаСписания.НайтиСтроки(
		Новый Структура("ВидУчета, ОстатокПревышен", ВидУчета, Истина))
		.Количество() <> 0;
КонецФункции

Процедура УменьшитьКоличествоВсегоИСтоимостьВсегоВСтрокахОстатков(СтрокиОстатков, Количество, Стоимость, СтоимостьНеУчитываетсяНУ, СтоимостьЕНВД)
	Для каждого СтрокаОстатков Из СтрокиОстатков Цикл
		Если СтрокаОстатков.КоличествоВсего > 0 Тогда
			СтрокаОстатков.КоличествоВсего                = СтрокаОстатков.КоличествоВсего               - Количество;
			СтрокаОстатков.СтоимостьВсего                 = СтрокаОстатков.СтоимостьВсего                - Стоимость;
			СтрокаОстатков.СтоимостьНеУчитываетсяНУВсего  = СтрокаОстатков.СтоимостьНеУчитываетсяНУВсего - СтоимостьНеУчитываетсяНУ;
			СтрокаОстатков.СтоимостьЕНВДВсего             = СтрокаОстатков.СтоимостьЕНВДВсего            - СтоимостьЕНВД;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область УчетВозвратнойТары

// Поступление возвратной тары.

// Подготовить таблицу поступления возвратной тары ранее учтенной в пути.
// 
// Параметры:
//  ТаблицаДокумента - см. ПустаяТаблицаПоступлениеМатериальныхЗапасовПоДокументу
//  Реквизиты - Структура:
//   * ПоступлениеМЗВПути - Характеристика.ВидыСубконто
//   * ДокументОснование - см. Документ.ПоступлениеМЗ.ДокументОснование
//   * Организация - СправочникСсылка.Организации
//   * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//   * Подразделение - СправочникСсылка.Подразделения
//   * Ссылка - ДокументСсылка
//   * Дата - Дата
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. ПустаяТаблицаПоступлениеМатериальныхЗапасовРанееУчтенныхВПути
Функция ПодготовитьТаблицуПоступленияВозвратнойТарыРанееУчтеннойВПути(ТаблицаДокумента, Реквизиты, Отказ) Экспорт

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяТаблицы", "ВозвратнаяТара");
	ДополнительныеПараметры.Вставить("СинонимТаблицы", НСтр("ru = 'Возвратная тара'"));
	
	Возврат ПодготовитьТаблицуПоступленияМатериальныхЗапасовРанееУчтенныхВПутиИсполняющая(
		ТаблицаДокумента,
		Реквизиты,
		ДополнительныеПараметры,
		Отказ);

КонецФункции

// Подготавливает таблицу документа (в унифицированном формате) для учета поступления возвратной тары.
// 
// Параметры:
//  Документ - ДокументОбъект
//  Параметры - Структура - Параметры
//  Отказ - Булево
// 
// Возвращаемое значение:
//  
Функция ПодготовитьТаблицуПоступлениеВозвратнойТарыПоДокументу(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ТаблицаДокумента = Новый ТаблицаЗначений;
	// Идентификация строки.
	ТаблицаДокумента.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ТаблицаДокумента.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДокумента.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДокумента.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета возвратной тары.
	ТаблицаДокумента.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДокумента.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаДокумента.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДокумента.Колонки.Добавить("ДопАналитикаВидСубконто", ОписаниеТиповВидСубконто);
	ТаблицаДокумента.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ТаблицаДокумента.Колонки.Добавить("ДопИзмерениеВидСубконто", ОписаниеТиповВидСубконто);
	ТаблицаДокумента.Колонки.Добавить("ДопИзмерение",            ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.
	// Поставщик.
	ТаблицаДокумента.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("КПСРасчетов",   Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДокумента.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДокумента.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаДокумента.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Количество и сумма поступивших единиц.
	ТаблицаДокумента.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ТаблицаДокумента.Колонки.Добавить("Сумма",         ОписаниеТипаСуммы); // Сумма в валюте документа.
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	Если МетаданныеДокумента.ТабличныеЧасти.Найти("ВозвратнаяТара") = Неопределено Тогда
		Возврат ТаблицаДокумента;
	КонецЕсли;
	
	Если МетаданныеДокумента.Имя = "ПоступлениеМЗВПути" Тогда
	
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ВозвратнаяТара",
			"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,Контрагент,Договор,ВалютаДокумента,
			|СчетУчета,Номенклатура,Количество,Сумма",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""ВозвратнаяТара"" КАК ИмяСписка,
		|	""Возвратная тара"" КАК СинонимСписка,
		|	ВозвратнаяТара.НомерСтроки КАК НомерСтроки,
		|	ВозвратнаяТара.ИФО КАК ИФО,
		|	ВозвратнаяТара.КФО КАК КФО,
		|	ВозвратнаяТара.КПС КАК КПС,
		|	ВозвратнаяТара.КЭК КАК КЭК,
		|	ВозвратнаяТара.Подразделение КАК Подразделение,
		|	ВозвратнаяТара.СчетУчета КАК СчетУчета,
		|	ЕСТЬNULL(ВозвратнаяТара.СчетУчета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
		|	ЕСТЬNULL(ВозвратнаяТара.СчетУчета.РазрешитьНеУказыватьПодразделение, ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
		|	ВозвратнаяТара.Номенклатура КАК Номенклатура,
		|	НЕОПРЕДЕЛЕНО КАК ДопАналитика,
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты) КАК ДопИзмерениеВидСубконто,
		|	ВозвратнаяТара.Контрагент КАК ДопИзмерение,
		|	ВозвратнаяТара.Контрагент КАК Контрагент,
		|	ВозвратнаяТара.Договор КАК Договор,
		|	ВозвратнаяТара.ВалютаДокумента КАК Валюта,
		|	ВозвратнаяТара.Количество КАК Количество,
		|	ВозвратнаяТара.Сумма КАК Сумма
		|ИЗ
		|	ТаблицаВозвратнаяТара КАК ВозвратнаяТара
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		ВидыДопАналитики = Новый Соответствие; // не предусмотрено
		
	Иначе
		
		Если НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта("КПСРасчетов", Документ.Метаданные().ТабличныеЧасти.ВозвратнаяТара) Тогда
			Параметры.Вставить("КПСРасчетов", Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
		КонецЕсли;
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ВозвратнаяТара",
			"НомерСтроки,ИФО,КФО,КПС,КПСРасчетов,КЭК,Подразделение,Контрагент,Договор,ВалютаДокумента,
			|СчетУчета,Номенклатура,ЦМО,ДополнительнаяАналитикаСчета,Количество,Сумма",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""ВозвратнаяТара"" КАК ИмяСписка,
		|	""Возвратная тара"" КАК СинонимСписка,
		|	ВозвратнаяТара.НомерСтроки КАК НомерСтроки,
		|	ВозвратнаяТара.ИФО КАК ИФО,
		|	ВозвратнаяТара.КФО КАК КФО,
		|	ВозвратнаяТара.КПС КАК КПС,
		|	ВозвратнаяТара.КПСРасчетов КАК КПСРасчетов,
		|	ВозвратнаяТара.КЭК КАК КЭК,
		|	ВозвратнаяТара.Подразделение КАК Подразделение,
		|	ВозвратнаяТара.СчетУчета КАК СчетУчета,
		|	ЕСТЬNULL(ВозвратнаяТара.СчетУчета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
		|	ЕСТЬNULL(ВозвратнаяТара.СчетУчета.РазрешитьНеУказыватьПодразделение, ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
		|	ВозвратнаяТара.Номенклатура КАК Номенклатура,
		|	ВозвратнаяТара.ДополнительнаяАналитикаСчета КАК ДопАналитика,
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК ДопИзмерениеВидСубконто,
		|	ВозвратнаяТара.ЦМО КАК ДопИзмерение,
		|	ВозвратнаяТара.Контрагент КАК Контрагент,
		|	ВозвратнаяТара.Договор КАК Договор,
		|	ВозвратнаяТара.ВалютаДокумента КАК Валюта,
		|	ВозвратнаяТара.Количество КАК Количество,
		|	ВозвратнаяТара.Сумма КАК Сумма
		|ИЗ
		|	ТаблицаВозвратнаяТара КАК ВозвратнаяТара
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		ВидыДопАналитики = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительнойАналитикиУчетаМЗ();
		
	КонецЕсли;
	
	ПоступлениеВозвратнойТары = Запрос.Выполнить().Выгрузить();
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ОбязательноУказыватьПодразделение = Ложь;
	СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Поступление",
		Документ.Дата, Документ.Организация, Документ.ИФО);
	Если Не ЗначениеЗаполнено(СчетРасчетов) Тогда
		СчетРасчетовИзПараметров = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры,
			"СчетРасчетов",
			ПланыСчетов.ЕПСБУ.ПустаяСсылка());
		Если ЗначениеЗаполнено(СчетРасчетовИзПараметров) И БухгалтерскийУчет.СчетВИерархии(СчетРасчетовИзПараметров, "208.00") Тогда
			СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("208.34", Документ.Дата, Документ.Организация);
		Иначе
			СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.34", Документ.Дата, Документ.Организация);
		КонецЕсли;
	КонецЕсли;
	
	КПСРасчетовШапка = Неопределено;
	Параметры.Свойство("КПС",КПСРасчетовШапка);
	КПСРасчетовВТЧ = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "КПСРасчетовВТЧ", Ложь);

	ИспользоватьКПСРасчетов = КПСРасчетовВТЧ ИЛИ ЗначениеЗаполнено(КПСРасчетовШапка);
	
	Для Каждого Строка Из ПоступлениеВозвратнойТары Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'Номенклатура'"), Строка.НомерСтроки, Строка.СинонимСписка);
			ПолеКолонки = Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].Номенклатура";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка, ПолеКолонки, "Объект", Отказ);
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Не ИспользоватьВалютныйУчет И Не ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		
		НоваяСтрока.ДопАналитикаВидСубконто = ВидыДопАналитики.Получить(Строка.СчетУчета);
		
		НоваяСтрока.СчетРасчетов = СчетРасчетов;
		
		Если ИспользоватьКПСРасчетов Тогда
			Если НЕ КПСРасчетовВТЧ Тогда
				НоваяСтрока.КПСРасчетов = КПСРасчетовШапка; 
			КонецЕсли;
		Иначе
			НоваяСтрока.КПСРасчетов = НоваяСтрока.КПС;
		КонецЕсли; 
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.КЭК) Тогда
			НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.КЭКПоКоду("340");
		КонецЕсли;
		
		ОбязательноУказыватьПодразделение = ОбязательноУказыватьПодразделение
			ИЛИ (Строка.УчетПоПодразделениям И НЕ Строка.РазрешитьНеУказыватьПодразделение);
		
	КонецЦикла;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ОбязательноУказыватьПодразделение
	   И НЕ ЗначениеЗаполнено(Документ.Подразделение) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", МетаданныеДокумента.Реквизиты.Подразделение.Синоним);
		ТекстСообщения = ТекстСообщения + НСтр("ru='. Учет возвратной тары ведется по подразделениям.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			Документ.Ссылка, "Подразделение", "Объект", Отказ);
	КонецЕсли;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Структура таблицы источника данных "Поступление возвратной тары".
//
Функция ПустаяТаблицаПоступлениеВозвратнойТары() Экспорт

	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета материальных запасов.
	ПустаяТаблица.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("ДопАналитикаВидСубконто", ОписаниеТиповВидСубконто);
	ПустаяТаблица.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ПустаяТаблица.Колонки.Добавить("ДопИзмерениеВидСубконто", ОписаниеТиповВидСубконто);
	ПустаяТаблица.Колонки.Добавить("ДопИзмерение",            ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.
	// Поставщик.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПСРасчетов",   Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Количество и сумма поступивших единиц.
	ПустаяТаблица.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СуммаВал",      ОписаниеТипаСуммы); // Сумма в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",      ОписаниеТипаСуммы); // Сумма в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Поступление возвратной тары".
//
Функция ТаблицаПоступлениеВозвратнойТары(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов=Неопределено, Реквизиты, Отказ) Экспорт
	
	ТаблицаПоступление = ПустаяТаблицаПоступлениеВозвратнойТары();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаПоступление;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	УчетРасчетов.РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СтрокаПоступление = ТаблицаПоступление.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоступление, СтрокаДокумента);
		
		СтрокаПоступление.СуммаВал = СтрокаДокумента.Сумма;
		
	КонецЦикла;
	
	Возврат ТаблицаПоступление;
	
КонецФункции

// Списание возвратной тары.

// Подготавливает таблицу документа (в унифицированном формате) для учета списания возвратной тары.
//
Функция ПодготовитьТаблицуСписаниеВозвратнойТарыПоДокументу(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ТаблицаДокумента = Новый ТаблицаЗначений;
	// Идентификация строки.
	ТаблицаДокумента.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ТаблицаДокумента.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДокумента.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДокумента.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДокумента.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаДокумента.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета возвратной тары.
	ТаблицаДокумента.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДокумента.Колонки.Добавить("ДопАналитикаВидСубконто", ОписаниеТиповВидСубконто);
	ТаблицаДокумента.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ТаблицаДокумента.Колонки.Добавить("ДопИзмерениеВидСубконто", ОписаниеТиповВидСубконто);
	ТаблицаДокумента.Колонки.Добавить("ДопИзмерение",            ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.
	// Контрагент (поставщик, покупатель).
	ТаблицаДокумента.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДокумента.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаДокумента.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Количество списываемых единиц.
	ТаблицаДокумента.Колонки.Добавить("Количество", ОписаниеТипаКоличества);
	ТаблицаДокумента.Колонки.Добавить("Сумма",      ОписаниеТипаСуммы); // Сумма в валюте документа.
	// Суммы для списания без расчета себестоимости
	ТаблицаДокумента.Колонки.Добавить("НеПересчитыватьСумму", Новый ОписаниеТипов("Булево"));
	ТаблицаДокумента.Колонки.Добавить("СуммаСписания", ОписаниеТипаСуммы);
	ТаблицаДокумента.Колонки.Добавить("СуммаСписанияНУ", ОписаниеТипаСуммы);
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	Если НЕ Параметры.Свойство("ПоВсемКФО") Тогда
		Параметры.Вставить("ПоВсемКФО", Ложь);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	// Проверим заполнение обязательных реквизитов.
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("КФО", МетаданныеДокумента)
	   И НЕ Параметры.ПоВсемКФО И НЕ ЗначениеЗаполнено(Документ.КФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", МетаданныеДокумента.Реквизиты.КФО.Синоним);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			Документ.Ссылка, "КФО", "Объект", Отказ);
	КонецЕсли;
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ЦМО", МетаданныеДокумента)
	   И НЕ ЗначениеЗаполнено(Документ.ЦМО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", МетаданныеДокумента.Реквизиты.ЦМО.Синоним);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			Документ.Ссылка, "ЦМО", "Объект", Отказ);
	КонецЕсли;
	
	ЕстьТабЧастьВозвратнаяТара = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("ВозвратнаяТара", МетаданныеДокумента);
	Если НЕ ЕстьТабЧастьВозвратнаяТара Тогда
		Возврат ТаблицаДокумента;
	КонецЕсли;
	
	Если НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта("НеПересчитыватьСумму", МетаданныеДокумента) Тогда
		Параметры.Вставить("НеПересчитыватьСумму", Ложь);
		Параметры.Вставить("СуммаСписания",        0);
		Параметры.Вставить("СуммаСписанияНУ",      0);
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ВозвратнаяТара",
		"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,Контрагент,Договор,ВалютаДокумента,НеПересчитыватьСумму,
		|СчетУчета,Номенклатура,ЦМО,ДополнительнаяАналитикаСчета,Количество,Сумма,СуммаСписания,СуммаСписанияНУ",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""ВозвратнаяТара"" КАК ИмяСписка,
	|	""Возвратная тара"" КАК СинонимСписка,
	|	ВозвратнаяТара.НомерСтроки КАК НомерСтроки,
	|	ВозвратнаяТара.ИФО КАК ИФО,
	|	ВозвратнаяТара.КФО КАК КФО,
	|	ВозвратнаяТара.КПС КАК КПС,
	|	ВозвратнаяТара.КЭК КАК КЭК,
	|	ВозвратнаяТара.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(ВозвратнаяТара.СчетУчета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
	|	ЕСТЬNULL(ВозвратнаяТара.СчетУчета.РазрешитьНеУказыватьПодразделение, ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
	|	ВозвратнаяТара.Контрагент КАК Контрагент,
	|	ВозвратнаяТара.Договор КАК Договор,
	|	ВозвратнаяТара.ВалютаДокумента КАК Валюта,
	|	ВозвратнаяТара.СчетУчета КАК СчетУчета,
	|	ВозвратнаяТара.Номенклатура КАК Номенклатура,
	|	ВозвратнаяТара.ДополнительнаяАналитикаСчета КАК ДопАналитика,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК ДопИзмерениеВидСубконто,
	|	ВозвратнаяТара.ЦМО КАК ДопИзмерение,
	|	ВозвратнаяТара.Количество КАК Количество,
	|	ВозвратнаяТара.Сумма КАК Сумма,
	|	ВозвратнаяТара.НеПересчитыватьСумму КАК НеПересчитыватьСумму,
	|	ВозвратнаяТара.СуммаСписания КАК СуммаСписания,
	|	ВозвратнаяТара.СуммаСписанияНУ КАК СуммаСписанияНУ
	|ИЗ
	|	ТаблицаВозвратнаяТара КАК ВозвратнаяТара
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Если Параметры.ПоВсемКФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВозвратнаяТара.КФО", "ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
	КонецЕсли;
	
	СписаниеВозвратнойТары = Запрос.Выполнить().Выгрузить();
	
	ВидыДопАналитики = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительнойАналитикиУчетаМЗ();
	ОбязательноУказыватьПодразделение = Ложь;
	СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Реализация",
		Документ.Дата, Документ.Организация, Документ.ИФО);
	
	Для Каждого Строка Из СписаниеВозвратнойТары Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		НоваяСтрока.ДопАналитикаВидСубконто = ВидыДопАналитики.Получить(Строка.СчетУчета);
		
		Если ЗначениеЗаполнено(СчетРасчетов) Тогда
			НоваяСтрока.СчетРасчетов = СчетРасчетов;
		Иначе
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.74", Документ.Дата, Документ.Организация);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.КЭК) Тогда
			НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.КЭКПоКоду("440");
		КонецЕсли;
		
		ОбязательноУказыватьПодразделение = ОбязательноУказыватьПодразделение
			ИЛИ (Строка.УчетПоПодразделениям И НЕ Строка.РазрешитьНеУказыватьПодразделение);
		
	КонецЦикла;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ОбязательноУказыватьПодразделение
	   И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Подразделение", МетаданныеДокумента)
	   И НЕ ЗначениеЗаполнено(Документ.Подразделение) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", МетаданныеДокумента.Реквизиты.Подразделение.Синоним);
		ТекстСообщения = ТекстСообщения + НСтр("ru='. Учет возвратной тары ведется по подразделениям.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			Документ.Ссылка, "Подразделение", "Объект", Отказ);
	КонецЕсли;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Структура таблицы источника данных "Списание возвратной тары".
//
Функция ПустаяТаблицаСписаниеВозвратнойТары() Экспорт

	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто  = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Вид учета: БУ - бух.учет, НУ - налоговый учет по налогу на прибыль.
	ПустаяТаблица.Колонки.Добавить("ВидУчета",      ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(3));
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета материальных запасов.
	ПустаяТаблица.Колонки.Добавить("СчетУчета",               Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",            Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("ДопИзмерение",            ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.
	ПустаяТаблица.Колонки.Добавить("ДопИзмерениеВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ПустаяТаблица.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ПустаяТаблица.Колонки.Добавить("ДопАналитикаВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ПустаяТаблица.Колонки.Добавить("Партия",                  ПланыВидовХарактеристик.ВидыСубконто.Партии.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("ПартияВидСубконто",       Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	
	// Количество и стоимость списанных материальных запасов.
	ПустаяТаблица.Колонки.Добавить("Количество",               ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("Стоимость",                ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СтоимостьНеУчитываетсяНУ", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СтоимостьЕНВД",            ОписаниеТипаСуммы);
	
	// Признак превышения остатка материальных запасов.
	ПустаяТаблица.Колонки.Добавить("ОстатокПревышен", Новый ОписаниеТипов("Булево"));
	
	// Реквизиты передачи тары.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",   Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",      Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",       Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ПустаяТаблица.Колонки.Добавить("СуммаВал",     ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",     ОписаниеТипаСуммы);
	
	// Разница стоимости передачи и учетной стоимости тары.
	ПустаяТаблица.Колонки.Добавить("РазницаСтоимостиВал", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("РазницаСтоимостиРуб", ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Списание возвратной тары".
//
Функция ТаблицаСписаниеВозвратнойТары(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов=Неопределено, Реквизиты, Отказ) Экспорт
	
	ТаблицаСписаниеТары = ПустаяТаблицаСписаниеВозвратнойТары();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаСписаниеТары;
	КонецЕсли;
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ПлательщикНалогаНаПрибыль",        УчетнаяПолитика.ПлательщикНалогаНаПрибыль);
	
	УчетРасчетов.РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
	// Списание возвратной тары производится аналогично другим материальным запасам.
	ТаблицаСписанных = УправлениеМатериальнымиЗапасами.ТаблицаСписаниеМатериальныхЗапасов(
		ТаблицаДокумента, Реквизиты, Отказ);
	
	// Заполним таблицу списания тары.
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		Отбор = Новый Структура("ИмяСписка, НомерСтроки, ВидУчета",
			СтрокаДокумента.ИмяСписка, СтрокаДокумента.НомерСтроки, СтрокаДокумента.ВидУчета);
		ПартииСписаннойТары = ТаблицаСписанных.Скопировать(Отбор);
		Если ПартииСписаннойТары.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Распределим стоимость передачи по строкам таблицы списанной тары.
		ПартииСписаннойТары.Колонки.Добавить("СуммаВал", ОписаниеТипаСуммы);
		ПартииСписаннойТары.Колонки.Добавить("СуммаРуб", ОписаниеТипаСуммы);
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СтрокаДокумента.Сумма,
			ПартииСписаннойТары, "СуммаВал", "Количество");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СтрокаДокумента.СуммаРуб,
			ПартииСписаннойТары, "СуммаРуб", "Количество");
		
		Для Каждого СтрокаТары Из ПартииСписаннойТары Цикл
			
			НоваяСтрока = ТаблицаСписаниеТары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТары);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента,
				"СчетРасчетов,Контрагент,Договор,Валюта");
			
			// Рассчитаем разницу стоимости передачи и учетной стоимости тары.
			Если НоваяСтрока.ВидУчета = "НУ" Тогда
				ЦенаСписания = (СтрокаТары.Стоимость + СтрокаТары.СтоимостьНеУчитываетсяНУ + СтрокаТары.СтоимостьЕНВД)
								/ СтрокаТары.Количество;
			Иначе
				ЦенаСписания = СтрокаТары.Стоимость
								/ СтрокаТары.Количество;
			КонецЕсли;
			
			Курс = ?(СтрокаТары.СуммаРуб = 0, 1, СтрокаТары.СуммаВал / СтрокаТары.СуммаРуб);
			НоваяСтрока.РазницаСтоимостиРуб = НоваяСтрока.СуммаРуб - СтрокаТары.Количество * ЦенаСписания;
			НоваяСтрока.РазницаСтоимостиВал = НоваяСтрока.СуммаВал - СтрокаТары.Количество * ЦенаСписания * Курс;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаСписаниеТары;
	
КонецФункции

#КонецОбласти

#Область ОстаткиМатериальныхЗапасов

// Структура таблицы остатков номенклатуры.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица остатки материальных запасов:
// * СчетУчета - ПланСчетовСсылка.ЕПСБУ -
// * КодСчета - Строка -
// * УчетПоПодразделениям - Булево -
// * УчетПоКПС - Булево -
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения -
// * КФО - ПеречислениеСсылка.КВД -
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * Подразделение - СправочникСсылка.Подразделения -
// * Номенклатура - СправочникСсылка.Номенклатура -
// * ДопИзмерение - Характеристика.ВидыСубконто
// * ДопАналитика - Характеристика.ВидыСубконто
// * Партия - Характеристика.ВидыСубконто
// * Количество - Число
// * КоличествоВсего - Число
// * СтоимостьВсего - Число
// * СтоимостьНеУчитываетсяНУВсего - Число
// * СтоимостьЕНВДВсего - Число
// * ЕстьРезервДокумента - Булево
// * КоличествоЗарезервировано - Число
// * СуммаЗарезервировано - Число
// * КоличествоЗарезервированоДокумент - Число
// * СуммаЗарезервированоДокумент - Число
Функция ПустаяТаблицаОстаткиМатериальныхЗапасов() Экспорт

	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто  = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Счет и настройки учета материальных запасов.
	ПустаяТаблица.Колонки.Добавить("СчетУчета",            Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КодСчета",             Новый ОписаниеТипов("Строка"));
	ПустаяТаблица.Колонки.Добавить("УчетПоПодразделениям", Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("УчетПоКПС",            Новый ОписаниеТипов("Булево"));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Аналитика учета материальных запасов.
	ПустаяТаблица.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("ДопИзмерение",  ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.
	ПустаяТаблица.Колонки.Добавить("ДопАналитика",  ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ПустаяТаблица.Колонки.Добавить("Партия",        ПланыВидовХарактеристик.ВидыСубконто.Партии.ТипЗначения);
	
	// Количество и стоимость списанных материальных запасов.
	ПустаяТаблица.Колонки.Добавить("Количество",                    ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("КоличествоВсего",               ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СтоимостьВсего",                ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СтоимостьНеУчитываетсяНУВсего", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СтоимостьЕНВДВсего",            ОписаниеТипаСуммы);
	
	// Резерв
	ПустаяТаблица.Колонки.Добавить("ЕстьРезервДокумента",           Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("КоличествоЗарезервировано",     ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СуммаЗарезервировано",          ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("КоличествоЗарезервированоДокумент",     ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СуммаЗарезервированоДокумент",          ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Распределить счета учета по параметрам.
// 
// Параметры:
//  Таблица - ТаблицаЗначений:
//  * СчетУчета - ПланСчетовСсылка.ЕПСБУ
//  * УчетПоИФО - Булево
//  * УчетПоКПС - Булево
//  * УчетПоПодразделениям - Булево
//  * ДопИзмерениеЕстьСубконто - Булево
//  * ДопИзмерениеСуммовой - Булево
//  * ДопИзмерениеВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто
//  * ДопАналитикаЕстьСубконто - Булево
//  * ДопАналитикаСуммовой - Булево
//  * ДопАналитикаВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто
//  * ПартияЕстьСубконто - Булево
//  * ПартияСуммовой - Булево
//  * ПартияВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто
// 
// Возвращаемое значение:
//  ТаблицаЗначений - 
Функция РаспределитьСчетаУчетаПоПараметрам(Таблица) Экспорт
	КолонкиПараметровУчета = 
		"УчетПоИФО, УчетПоКПС, УчетПоПодразделениям,
		|ДопИзмерениеЕстьСубконто,ДопИзмерениеСуммовой,ДопИзмерениеВидСубконто,ДопИзмерениеКоличественный,ДопИзмерениеОбязательный,
		|ДопАналитикаЕстьСубконто,ДопАналитикаСуммовой,ДопАналитикаВидСубконто,ДопАналитикаКоличественный,ДопАналитикаОбязательный,
		|ПартияЕстьСубконто,ПартияСуммовой,ПартияВидСубконто,ПартияКоличественный,ПартияОбязательный";
	Если Таблица.Колонки.Найти("ДопСубконто3") <> Неопределено Тогда
		КолонкиПараметровУчета = КолонкиПараметровУчета +",ДопСубконто3";
	КонецЕсли;
	ТаблицаПараметровУчета = Таблица.Скопировать(,КолонкиПараметровУчета);
	ТаблицаПараметровУчета.Свернуть(КолонкиПараметровУчета);
	ТаблицаПараметровУчета.Колонки.Добавить("НомераСубконто",         Новый ОписаниеТипов("Соответствие"));
	ТаблицаПараметровУчета.Колонки.Добавить("НомераСуммовыхСубконто", Новый ОписаниеТипов("Соответствие"));
	ТаблицаПараметровУчета.Колонки.Добавить("МассивСубконто",         Новый ОписаниеТипов("Массив"));
	ТаблицаПараметровУчета.Колонки.Добавить("МассивСуммовыхСубконто", Новый ОписаниеТипов("Массив"));
	
	ДобавленныеКолонки = Новый Соответствие;
	ДобавленныеКолонки.Вставить("СчетУчета", Ложь);
	ДобавленныеКолонки.Вставить("ИФО", Ложь);
	ДобавленныеКолонки.Вставить("КФО", Ложь);
	ДобавленныеКолонки.Вставить("КПС", Ложь);
	ДобавленныеКолонки.Вставить("Подразделение", Ложь);
	ДобавленныеКолонки.Вставить("Номенклатура", Ложь);
	ДобавленныеКолонки.Вставить("ДопИзмерение", Ложь);
	ДобавленныеКолонки.Вставить("ДопАналитика", Ложь);
	Для Каждого ДобавленнаяКолонка Из ДобавленныеКолонки Цикл
		ЕстьИсходнаяКолонка = Таблица.Колонки.Найти(ДобавленнаяКолонка.Ключ) <> Неопределено;
		Если ЕстьИсходнаяКолонка Тогда
			ТаблицаПараметровУчета.Колонки.Добавить(ДобавленнаяКолонка.Ключ, Новый ОписаниеТипов("Массив"));
			ДобавленныеКолонки.Вставить(ДобавленнаяКолонка.Ключ, ЕстьИсходнаяКолонка);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого НаборПараметровУчета Из ТаблицаПараметровУчета Цикл

		// Номенклатура.
		НаборПараметровУчета.МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
		НаборПараметровУчета.НомераСубконто.Вставить("Номенклатура", 1);
		НаборПараметровУчета.МассивСуммовыхСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
		НаборПараметровУчета.НомераСуммовыхСубконто.Вставить("Номенклатура", 1);
		
		// ДопИзмерение.
		Если НаборПараметровУчета.ДопИзмерениеЕстьСубконто Тогда
			
			НаборПараметровУчета.МассивСубконто.Добавить(НаборПараметровУчета.ДопИзмерениеВидСубконто);
			НаборПараметровУчета.НомераСубконто.Вставить("ДопИзмерение",
				НаборПараметровУчета.НомераСубконто.Количество() + 1);
			
			Если НаборПараметровУчета.ДопИзмерениеСуммовой Тогда
				НаборПараметровУчета.МассивСуммовыхСубконто.Добавить(НаборПараметровУчета.ДопИзмерениеВидСубконто);
				НаборПараметровУчета.НомераСуммовыхСубконто.Вставить("ДопИзмерение",
					НаборПараметровУчета.НомераСуммовыхСубконто.Количество() + 1);
			КонецЕсли;
			
		КонецЕсли;
		
		// ДопАналитика.
		Если НаборПараметровУчета.ДопАналитикаЕстьСубконто Тогда
			
			НаборПараметровУчета.МассивСубконто.Добавить(НаборПараметровУчета.ДопАналитикаВидСубконто);
			НаборПараметровУчета.НомераСубконто.Вставить("ДопАналитика",
				НаборПараметровУчета.НомераСубконто.Количество() + 1);
			
			Если НаборПараметровУчета.ДопАналитикаСуммовой Тогда
				НаборПараметровУчета.МассивСуммовыхСубконто.Добавить(НаборПараметровУчета.ДопАналитикаВидСубконто);
				НаборПараметровУчета.НомераСуммовыхСубконто.Вставить("ДопАналитика",
					НаборПараметровУчета.НомераСуммовыхСубконто.Количество() + 1);
			КонецЕсли;
			
		КонецЕсли;
		
		// Партия.
		Если НаборПараметровУчета.ПартияЕстьСубконто Тогда
			
			НаборПараметровУчета.МассивСубконто.Добавить(НаборПараметровУчета.ПартияВидСубконто);
			НаборПараметровУчета.НомераСубконто.Вставить("Партия",
				НаборПараметровУчета.НомераСубконто.Количество() + 1);
			
			Если НаборПараметровУчета.ПартияСуммовой Тогда
				НаборПараметровУчета.МассивСуммовыхСубконто.Добавить(НаборПараметровУчета.ПартияВидСубконто);
				НаборПараметровУчета.НомераСуммовыхСубконто.Вставить("Партия",
					НаборПараметровУчета.НомераСуммовыхСубконто.Количество() + 1);
			КонецЕсли;
			
		КонецЕсли;
		
		// Сохраняем значения колонок для последующей установки в параметры запроса
		Отбор = Новый Структура(КолонкиПараметровУчета);
		ЗаполнитьЗначенияСвойств(Отбор, НаборПараметровУчета);
		СтрокиСписания = Таблица.Скопировать(Отбор);
		
		Для Каждого ДобавленнаяКолонка Из ДобавленныеКолонки Цикл
			Если Не ДобавленнаяКолонка.Значение Тогда
				Продолжить;
			КонецЕсли;
			НаборПараметровУчета[ДобавленнаяКолонка.Ключ] =
				ОбщегоНазначенияКлиентСервер.СвернутьМассив(СтрокиСписания.ВыгрузитьКолонку(ДобавленнаяКолонка.Ключ));
		КонецЦикла;
		
		НеЗаполнятьДопАналитику = СтрокиСписания.Количество() > 0
			И БухгалтерскийУчет.СчетВИерархии(СтрокиСписания[0].СчетУчета, "106.00, Н15")
			И НаборПараметровУчета.ДопАналитикаВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат;
			
		Если НеЗаполнятьДопАналитику И ДобавленныеКолонки.Получить("ДопАналитика") = Истина Тогда
			НаборПараметровУчета.ДопАналитика = Новый Массив;
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат ТаблицаПараметровУчета;
	
КонецФункции

// Функция возвращает таблицу остатков номенклатуры для переданной таблицы списания
// 
// Параметры:
//  Период - Граница - Период
//  ТаблицаСписания - ТаблицаЗначений - Таблица списания:
//  Реквизиты - Структура - Реквизиты:
// * Ссылка - ДокументСсылка -
// * Организация - СправочникСсылка.Организации -
// * Дата - Дата -
// * ИспользоватьУчетПоИФО - Булево -
// * ИспользоватьУчетПоПодразделениям - Булево -
// * ИспользоватьВалютныйУчет - Булево -
// * ПлательщикНалогаНаПрибыль - Булево -
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Остатки материальных запасов. см. ПустаяТаблицаОстаткиМатериальныхЗапасов
Функция ОстаткиМатериальныхЗапасов(Период, ТаблицаСписания, Реквизиты) Экспорт
	
	Если ТаблицаСписания.Количество() = 0 Тогда
		Возврат ПустаяТаблицаОстаткиМатериальныхЗапасов();
	КонецЕсли;
	
	ТаблицаСписания = ДобавитьПараметрыУчетаМатериальныхЗапасов(ТаблицаСписания, Реквизиты);
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МоментВремени", Период);
	Запрос.УстановитьПараметр("Организация",   Реквизиты.Организация);
	Регистратор = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Реквизиты, "Ссылка"); // ДокументСсылка.АктСписанияМЗ
	УчитыватьКорректировки = Ложь;
	Если ЗначениеЗаполнено(Регистратор) Тогда
		МетаданныеДокумента = Регистратор.Метаданные();
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ЭтоКорректировка", МетаданныеДокумента) Тогда
			ВсеКорректировки = ВсеКорректировкиДокумента(Регистратор);
			Запрос.УстановитьПараметр("ВсеКорректировки", ВсеКорректировки);
			УчитыватьКорректировки = ВсеКорректировки.Количество() > 0;
		КонецЕсли;
		Если Не ОбщегоНазначения.ЕстьРеквизитОбъекта("Резервировать", МетаданныеДокумента)
			Или ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Регистратор, "Резервировать") Тогда
			Регистратор = Документы.АктСписанияМЗ.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", Регистратор);

	// Текст запроса по остаткам формируется для каждого набора параметров учета МЗ.
	ТекстОбщегоЗапроса = "";
	НомерЗапроса = 0;
	Для Каждого НаборПараметровУчета Из РаспределитьСчетаУчетаПоПараметрам(ТаблицаСписания) Цикл
		
		НомерЗапроса = НомерЗапроса + 1;
		
		// Добавляем виртуальную таблицу.
		Запрос.Текст = Запрос.Текст + ТекстЗапросаОстаткиМатериальныхЗапасов(НаборПараметровУчета, НомерЗапроса, УчитыватьКорректировки);
		
		Запрос.УстановитьПараметр("Счета" + НомерЗапроса, НаборПараметровУчета.СчетУчета);
		Запрос.УстановитьПараметр("ИФО" + НомерЗапроса, НаборПараметровУчета.ИФО);
		Запрос.УстановитьПараметр("КФО" + НомерЗапроса, НаборПараметровУчета.КФО);
		Запрос.УстановитьПараметр("КПС" + НомерЗапроса, НаборПараметровУчета.КПС);
		Запрос.УстановитьПараметр("Подразделение" + НомерЗапроса, НаборПараметровУчета.Подразделение);
		Запрос.УстановитьПараметр("Номенклатура" + НомерЗапроса, НаборПараметровУчета.Номенклатура);
		Запрос.УстановитьПараметр("ДопИзмерение" + НомерЗапроса, НаборПараметровУчета.ДопИзмерение);
		Запрос.УстановитьПараметр("ДопАналитика" + НомерЗапроса, НаборПараметровУчета.ДопАналитика);
		Запрос.УстановитьПараметр("УчетПоПодразделениям" + НомерЗапроса, НаборПараметровУчета.УчетПоПодразделениям);
		Запрос.УстановитьПараметр("УчетПоКПС" + НомерЗапроса, НаборПараметровУчета.УчетПоКПС);
		Запрос.УстановитьПараметр("Субконто" + НомерЗапроса, НаборПараметровУчета.МассивСубконто);
		Запрос.УстановитьПараметр("СубконтоДляРасчетаСтоимости" + НомерЗапроса, НаборПараметровУчета.МассивСуммовыхСубконто);
		
		// Соединение виртуальных таблиц.
		Если НЕ ПустаяСтрока(ТекстОбщегоЗапроса) Тогда
			ТекстОбщегоЗапроса = ТекстОбщегоЗапроса + "
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|";
		КонецЕсли;
		
		ТекстОбщегоЗапроса = ТекстОбщегоЗапроса +
		"ВЫБРАТЬ
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.СчетУчета КАК СчетУчета,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КодСчета КАК КодСчета,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.УчетПоПодразделениям КАК УчетПоПодразделениям,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.УчетПоКПС КАК УчетПоКПС,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.ИФО КАК ИФО,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КФО КАК КФО,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КПС КАК КПС,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Подразделение КАК Подразделение,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Номенклатура КАК Номенклатура,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.ДопИзмерение КАК ДопИзмерение,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.ДопАналитика КАК ДопАналитика,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Партия КАК Партия,
		|	МАКСИМУМ(ТаблицаОстаткиМатериалов_НомерЗапроса.ДопИзмерениеСуммовой) КАК ДопИзмерениеСуммовой,
		|	МАКСИМУМ(ТаблицаОстаткиМатериалов_НомерЗапроса.ДопАналитикаСуммовой) КАК ДопАналитикаСуммовой,
		|	МАКСИМУМ(ТаблицаОстаткиМатериалов_НомерЗапроса.ПартияСуммовой) КАК ПартияСуммовой,
		|	СУММА(ТаблицаОстаткиМатериалов_НомерЗапроса.Количество) КАК Количество,
		|	СУММА(ТаблицаОстаткиМатериалов_НомерЗапроса.КоличествоВсего) КАК КоличествоВсего,
		|	СУММА(ТаблицаОстаткиМатериалов_НомерЗапроса.СтоимостьВсего) КАК СтоимостьВсего,
		|	СУММА(ТаблицаОстаткиМатериалов_НомерЗапроса.СтоимостьНеУчитываетсяНУВсего) КАК СтоимостьНеУчитываетсяНУВсего,
		|	СУММА(ТаблицаОстаткиМатериалов_НомерЗапроса.СтоимостьЕНВДВсего) КАК СтоимостьЕНВДВсего,
		|	СУММА(ТаблицаОстаткиМатериалов_НомерЗапроса.КоличествоЗарезервировано) КАК КоличествоЗарезервировано,
		|	СУММА(ТаблицаОстаткиМатериалов_НомерЗапроса.СуммаЗарезервировано) КАК СуммаЗарезервировано,
		|	СУММА(ТаблицаОстаткиМатериалов_НомерЗапроса.КоличествоЗарезервированоДокумент) КАК КоличествоЗарезервированоДокумент,
		|	СУММА(ТаблицаОстаткиМатериалов_НомерЗапроса.СуммаЗарезервированоДокумент) КАК СуммаЗарезервированоДокумент,
		|	МАКСИМУМ(ТаблицаОстаткиМатериалов_НомерЗапроса.ЕстьРезервДокумента) КАК ЕстьРезервДокумента
		|ИЗ
		|	ОстаткиМатериалов_НомерЗапроса КАК ТаблицаОстаткиМатериалов_НомерЗапроса
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.СчетУчета,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КодСчета,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.УчетПоПодразделениям,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.УчетПоКПС,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.ИФО,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КФО,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КПС,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Подразделение,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Номенклатура,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.ДопИзмерение,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.ДопАналитика,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Партия";
		
		ТекстОбщегоЗапроса = СтрЗаменить(ТекстОбщегоЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + ТекстОбщегоЗапроса;
	
	ОстаткиМатериалов = Запрос.Выполнить().Выгрузить();
	СкорректироватьОстаткиРезервовНаОстаткиМатериалов(ОстаткиМатериалов);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиМатериалов, "Партия", "ДатаПартии");
	
	Возврат ОстаткиМатериалов;
	
КонецФункции

Функция ВсеКорректировкиДокумента(Ссылка, ВсеКорректировки = Неопределено, ПройденныеДокументы = Неопределено)
	Если ВсеКорректировки = Неопределено Тогда
		ВсеКорректировки = Новый Массив;
	КонецЕсли;
	Если ПройденныеДокументы = Неопределено Тогда
		ПройденныеДокументы = Новый Соответствие;
	КонецЕсли;
	ПройденныеДокументы.Вставить(Ссылка, Истина);
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "ЭтоКорректировка, ДокументОснование");
	Если РеквизитыДокумента.ЭтоКорректировка Тогда
		Если ПройденныеДокументы.Получить(РеквизитыДокумента.ДокументОснование) <> Неопределено Тогда
			// Образовался цикл из документов корректировки.
			ЗаголовокОшибки = НСтр("ru = 'Не правильно выбран корректируемый документ. Корректируемые документы ссылаются друг на друга.'");
			ТекстОшибки = ЗаголовокОшибки + Символы.ПС
				+ СтрШаблон(НСтр("ru = 'Обрабатываемый документ: %1'"), Строка(Ссылка)) + Символы.ПС
				+ СтрШаблон(НСтр("ru = 'Документ основание (ранее присутствует в цепочке корректировок): %1'"), Строка(РеквизитыДокумента.ДокументОснование));
			ВызватьИсключение(ЗаголовокОшибки, , , ТекстОшибки);
		КонецЕсли;
		ВсеКорректировки.Добавить(РеквизитыДокумента.ДокументОснование);
		Возврат ВсеКорректировкиДокумента(РеквизитыДокумента.ДокументОснование, ВсеКорректировки);
	Иначе
		Возврат ВсеКорректировки;
	КонецЕсли;
КонецФункции

// Скорректировать остатки резервов на остатки материалов.
// 
// Параметры:
//  ОстаткиМатериалов - см. ПустаяТаблицаОстаткиМатериальныхЗапасов
Процедура СкорректироватьОстаткиРезервовНаОстаткиМатериалов(ОстаткиМатериалов)
	СтрокиРезервов = Новый Массив; // Массив из СтрокаТаблицыЗначений: см. ПустаяТаблицаОстаткиМатериальныхЗапасов
	Для Каждого СтрокаМатериала Из ОстаткиМатериалов Цикл
		Если (СтрокаМатериала.КоличествоЗарезервировано <> 0
				Или СтрокаМатериала.КоличествоЗарезервированоДокумент)
			И СтрокаМатериала.КоличествоВсего = 0 Тогда
			СтрокиРезервов.Добавить(СтрокаМатериала);
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокиРезервов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаРезерва Из СтрокиРезервов Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура", СтрокаРезерва.Номенклатура);
		Отбор.Вставить("СчетУчета", СтрокаРезерва.СчетУчета);
		Отбор.Вставить("КоличествоЗарезервировано", 0);
		Отбор.Вставить("КоличествоЗарезервированоДокумент", 0);
		Если ЗначениеЗаполнено(СтрокаРезерва.ДопИзмерение) Тогда
			Отбор.Вставить("ДопИзмерение", СтрокаРезерва.ДопИзмерение);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаРезерва.ДопАналитика) Тогда
			Отбор.Вставить("ДопАналитика", СтрокаРезерва.ДопАналитика);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаРезерва.КПС) Тогда
			Отбор.Вставить("КПС", СтрокаРезерва.КПС);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаРезерва.КФО) Тогда
			Отбор.Вставить("КФО", СтрокаРезерва.КФО);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаРезерва.ИФО) Тогда
			Отбор.Вставить("ИФО", СтрокаРезерва.ИФО);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаРезерва.Подразделение) Тогда
			Отбор.Вставить("Подразделение", СтрокаРезерва.Подразделение);
		КонецЕсли;
		
		СтрокиОстатков = ОстаткиМатериалов.НайтиСтроки(Отбор);
		
		ОстатокВсего = 0;
		Для Каждого СтрокаОстатка Из СтрокиОстатков Цикл
			ОстатокВсего = ОстатокВсего + СтрокаОстатка.КоличествоВсего;
		КонецЦикла;
		
		ОсталосьРаспределить = СтрокаРезерва.КоличествоЗарезервировано;
		ОсталосьРаспределитьДокумент = СтрокаРезерва.КоличествоЗарезервированоДокумент;
		
		Для Каждого СтрокаОстатка Из СтрокиОстатков Цикл
			СтрокаОстатка.КоличествоЗарезервировано = Мин(СтрокаОстатка.КоличествоВсего, ОсталосьРаспределить);
			СтрокаОстатка.КоличествоЗарезервированоДокумент = Мин(СтрокаОстатка.КоличествоВсего, ОсталосьРаспределитьДокумент);
			
			ОсталосьРаспределить = ОсталосьРаспределить - СтрокаОстатка.КоличествоЗарезервировано;
			ОсталосьРаспределитьДокумент = ОсталосьРаспределитьДокумент - СтрокаОстатка.КоличествоЗарезервированоДокумент;
		КонецЦикла;
		
		
	КонецЦикла;
	
	Для Каждого СтрокаРезерва Из СтрокиРезервов Цикл
		ОстаткиМатериалов.Удалить(СтрокаРезерва);
	КонецЦикла;
	
КонецПроцедуры

// Функция возвращает текст запроса для одного набора параметров учета МЗ
//
Функция ТекстЗапросаОстаткиМатериальныхЗапасов(ПараметрыУчета, НомерЗапроса, УчитыватьКорректировки)
	
	ТекстыЗапросов = ТекстыЗапросовОстатковМатериальныхЗапасов();
	
	ЕстьСубконтоБезСуммовогоУчета =
			(ПараметрыУчета.ДопИзмерениеЕстьСубконто И НЕ ПараметрыУчета.ДопИзмерениеСуммовой)
		ИЛИ (ПараметрыУчета.ДопАналитикаЕстьСубконто И НЕ ПараметрыУчета.ДопАналитикаСуммовой);
	
	Если ЕстьСубконтоБезСуммовогоУчета ИЛИ ПараметрыУчета.ПартияЕстьСубконто Тогда
		
		// Остатки для расчета стоимости, по субконто с суммовым учетом.
		ТекстЗапроса = ТекстыЗапросов.ВТ_ОстаткиСтоимостьМатериалов_НомерЗапроса;
			
		Если ПараметрыУчета.ДопИзмерениеЕстьСубконто И ПараметрыУчета.ДопИзмерениеСуммовой Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопИзмерению",
				"Субконто"+ПараметрыУчета.НомераСуммовыхСубконто["ДопИзмерение"]+" В (&ДопИзмерение_НомерЗапроса)");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДвиженияПоДопИзмерению",
				"СубконтоКт" + ПараметрыУчета.НомераСуммовыхСубконто["ДопИзмерение"]+" В (&ДопИзмерение_НомерЗапроса)");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.ДопИзмерение",
				"ЖурналПроводокЕПСБУОстатки.Субконто"+ПараметрыУчета.НомераСуммовыхСубконто["ДопИзмерение"]);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопИзмерению", "ИСТИНА");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДвиженияПоДопИзмерению", "ИСТИНА");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.ДопИзмерение", "НЕОПРЕДЕЛЕНО");
		КонецЕсли;
		Если ПараметрыУчета.ДопАналитикаЕстьСубконто И ПараметрыУчета.ДопАналитикаСуммовой Тогда
			Если ПараметрыУчета.ДопАналитика.Количество() > 0 Тогда
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопАналитике",
					"Субконто"+ПараметрыУчета.НомераСуммовыхСубконто["ДопАналитика"]+" В (&ДопАналитика_НомерЗапроса)");
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДвиженияПоДопАналитике",
					"СубконтоКт"+ПараметрыУчета.НомераСуммовыхСубконто["ДопАналитика"]+" В (&ДопАналитика_НомерЗапроса)");
			Иначе
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопАналитике", "ИСТИНА");
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДвиженияПоДопАналитике", "ИСТИНА");
			КонецЕсли;
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.ДопАналитика",
				"ЖурналПроводокЕПСБУОстатки.Субконто"+ПараметрыУчета.НомераСуммовыхСубконто["ДопАналитика"]);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопАналитике", "ИСТИНА");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДвиженияПоДопАналитике", "ИСТИНА");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.ДопАналитика", "НЕОПРЕДЕЛЕНО");
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов();
		
		// Остатки по субконто с количественным учетом
		ТекстЗапроса = ТекстЗапроса + ТекстыЗапросов.ВТ_ОстаткиМатериалов_НомерЗапроса;
			
		ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов();
		
		// Соединяем виртуальные таблицы остатков
		Если УчитыватьКорректировки Тогда
			ТекстЗапроса = ТекстЗапроса + ТекстыЗапросов.ДвиженияДокументов_НомерЗапроса;
			
			ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов();
			ИтоговыйТекстЗапроса =
			"ВЫБРАТЬ
			|	ОстаткиМатериалов.СчетУчета КАК СчетУчета,
			|	ОстаткиМатериалов.КодСчета КАК КодСчета,
			|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
			|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
			|	ОстаткиМатериалов.ИФО КАК ИФО,
			|	ОстаткиМатериалов.КФО КАК КФО,
			|	ОстаткиМатериалов.КПС КАК КПС,
			|	ОстаткиМатериалов.Подразделение КАК Подразделение,
			|	ОстаткиМатериалов.Номенклатура КАК Номенклатура,
			|	ОстаткиМатериалов.ДопИзмерение КАК ДопИзмерение,
			|	ОстаткиМатериалов.ДопАналитика КАК ДопАналитика,
			|	ОстаткиМатериалов.Партия КАК Партия,
			|	МАКСИМУМ(&ДопИзмерениеСуммовой_НомерЗапроса) КАК ДопИзмерениеСуммовой,
			|	МАКСИМУМ(&ДопАналитикаСуммовой_НомерЗапроса) КАК ДопАналитикаСуммовой,
			|	МАКСИМУМ(&ПартияСуммовой_НомерЗапроса) КАК ПартияСуммовой,
			|	СУММА(ОстаткиМатериалов.Количество) КАК Количество,
			|	СУММА(ОстаткиМатериалов.КоличествоВсего) КАК КоличествоВсего,
			|	СУММА(ОстаткиМатериалов.СтоимостьВсего) КАК СтоимостьВсего,
			|	СУММА(ОстаткиМатериалов.СтоимостьНеУчитываетсяНУВсего) КАК СтоимостьНеУчитываетсяНУВсего,
			|	СУММА(ОстаткиМатериалов.СтоимостьЕНВДВсего) КАК СтоимостьЕНВДВсего,
			|	СУММА(0) КАК КоличествоЗарезервировано,
			|	СУММА(0) КАК СуммаЗарезервировано,
			|	СУММА(0) КАК КоличествоЗарезервированоДокумент,
			|	СУММА(0) КАК СуммаЗарезервированоДокумент,
			|	МАКСИМУМ(ЛОЖЬ) КАК ЕстьРезервДокумента
			|ПОМЕСТИТЬ ОстаткиМатериалов_НомерЗапроса
			|ИЗ
			|	(ВЫБРАТЬ
			|		ОстаткиМатериалов.СчетУчета КАК СчетУчета,
			|		ОстаткиМатериалов.СчетУчета.Код КАК КодСчета,
			|		&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
			|		&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
			|		ОстаткиМатериалов.ИФО КАК ИФО,
			|		ОстаткиМатериалов.КФО КАК КФО,
			|		ОстаткиМатериалов.КПС КАК КПС,
			|		ОстаткиМатериалов.Подразделение КАК Подразделение,
			|		ОстаткиМатериалов.Номенклатура КАК Номенклатура,
			|		ОстаткиМатериалов.ДопИзмерение КАК ДопИзмерение,
			|		ОстаткиМатериалов.ДопАналитика КАК ДопАналитика,
			|		ОстаткиМатериалов.Партия КАК Партия,
			|		&ДопИзмерениеСуммовой_НомерЗапроса КАК ДопИзмерениеСуммовой,
			|		&ДопАналитикаСуммовой_НомерЗапроса КАК ДопАналитикаСуммовой,
			|		&ПартияСуммовой_НомерЗапроса КАК ПартияСуммовой,
			|		ОстаткиМатериалов.Количество КАК Количество,
			|		ОстаткиСтоимостьМатериалов.КоличествоВсего КАК КоличествоВсего,
			|		ОстаткиСтоимостьМатериалов.СтоимостьВсего КАК СтоимостьВсего,
			|		ОстаткиСтоимостьМатериалов.СтоимостьНеУчитываетсяНУВсего КАК СтоимостьНеУчитываетсяНУВсего,
			|		ОстаткиСтоимостьМатериалов.СтоимостьЕНВДВсего КАК СтоимостьЕНВДВсего
			|	ИЗ
			|		ВТ_ОстаткиМатериалов_НомерЗапроса КАК ОстаткиМатериалов
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОстаткиСтоимостьМатериалов_НомерЗапроса КАК ОстаткиСтоимостьМатериалов
			|			ПО ОстаткиМатериалов.СчетУчета = ОстаткиСтоимостьМатериалов.СчетУчета
			|				И ОстаткиМатериалов.ИФО = ОстаткиСтоимостьМатериалов.ИФО
			|				И ОстаткиМатериалов.КФО = ОстаткиСтоимостьМатериалов.КФО
			|				И ОстаткиМатериалов.КПС = ОстаткиСтоимостьМатериалов.КПС
			|				И ОстаткиМатериалов.Подразделение = ОстаткиСтоимостьМатериалов.Подразделение
			|				И ОстаткиМатериалов.Номенклатура = ОстаткиСтоимостьМатериалов.Номенклатура
			|				И ОстаткиМатериалов.ДопИзмерение = ОстаткиСтоимостьМатериалов.ДопИзмерение
			|				И ОстаткиМатериалов.ДопАналитика = ОстаткиСтоимостьМатериалов.ДопАналитика
			|				И ОстаткиМатериалов.Партия = ОстаткиСтоимостьМатериалов.Партия
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		Движения.СчетУчета,
			|		Движения.СчетУчета.Код,
			|		&УчетПоПодразделениям_НомерЗапроса,
			|		&УчетПоКПС_НомерЗапроса,
			|		Движения.ИФО,
			|		Движения.КФО,
			|		Движения.КПС,
			|		Движения.Подразделение,
			|		Движения.Номенклатура,
			|		Движения.ДопИзмерение,
			|		Движения.ДопАналитика,
			|		Движения.Партия,
			|		&ДопИзмерениеСуммовой_НомерЗапроса,
			|		&ДопАналитикаСуммовой_НомерЗапроса,
			|		&ПартияСуммовой_НомерЗапроса,
			|		Движения.Количество,
			|		Движения.КоличествоВсего,
			|		Движения.СтоимостьВсего,
			|		Движения.СтоимостьНеУчитываетсяНУВсего,
			|		Движения.СтоимостьЕНВДВсего
			|	ИЗ
			|		ДвиженияДокументов_НомерЗапроса КАК Движения) КАК ОстаткиМатериалов
			|
			|СГРУППИРОВАТЬ ПО
			|	ОстаткиМатериалов.СчетУчета,
			|	ОстаткиМатериалов.КодСчета,
			|	ОстаткиМатериалов.ИФО,
			|	ОстаткиМатериалов.КФО,
			|	ОстаткиМатериалов.КПС,
			|	ОстаткиМатериалов.Подразделение,
			|	ОстаткиМатериалов.Номенклатура,
			|	ОстаткиМатериалов.ДопИзмерение,
			|	ОстаткиМатериалов.ДопАналитика,
			|	ОстаткиМатериалов.Партия";
		Иначе
			ИтоговыйТекстЗапроса =
			"ВЫБРАТЬ
			|	ОстаткиМатериалов.СчетУчета КАК СчетУчета,
			|	ОстаткиМатериалов.СчетУчета.Код КАК КодСчета,
			|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
			|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
			|	ОстаткиМатериалов.ИФО КАК ИФО,
			|	ОстаткиМатериалов.КФО КАК КФО,
			|	ОстаткиМатериалов.КПС КАК КПС,
			|	ОстаткиМатериалов.Подразделение КАК Подразделение,
			|	ОстаткиМатериалов.Номенклатура КАК Номенклатура,
			|	ОстаткиМатериалов.ДопИзмерение КАК ДопИзмерение,
			|	ОстаткиМатериалов.ДопАналитика КАК ДопАналитика,
			|	ОстаткиМатериалов.Партия КАК Партия,
			|	МАКСИМУМ(&ДопИзмерениеСуммовой_НомерЗапроса) КАК ДопИзмерениеСуммовой,
			|	МАКСИМУМ(&ДопАналитикаСуммовой_НомерЗапроса) КАК ДопАналитикаСуммовой,
			|	МАКСИМУМ(&ПартияСуммовой_НомерЗапроса) КАК ПартияСуммовой,
			|	СУММА(ОстаткиМатериалов.Количество) КАК Количество,
			|	СУММА(ОстаткиСтоимостьМатериалов.КоличествоВсего) КАК КоличествоВсего,
			|	СУММА(ОстаткиСтоимостьМатериалов.СтоимостьВсего) КАК СтоимостьВсего,
			|	СУММА(ОстаткиСтоимостьМатериалов.СтоимостьНеУчитываетсяНУВсего) КАК СтоимостьНеУчитываетсяНУВсего,
			|	СУММА(ОстаткиСтоимостьМатериалов.СтоимостьЕНВДВсего) КАК СтоимостьЕНВДВсего,
			|	СУММА(0) КАК КоличествоЗарезервировано,
			|	СУММА(0) КАК СуммаЗарезервировано,
			|	СУММА(0) КАК КоличествоЗарезервированоДокумент,
			|	СУММА(0) КАК СуммаЗарезервированоДокумент,
			|	МАКСИМУМ(ЛОЖЬ) КАК ЕстьРезервДокумента
			|ПОМЕСТИТЬ ОстаткиМатериалов_НомерЗапроса
			|ИЗ
			|	ВТ_ОстаткиМатериалов_НомерЗапроса КАК ОстаткиМатериалов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОстаткиСтоимостьМатериалов_НомерЗапроса КАК ОстаткиСтоимостьМатериалов
			|		ПО ОстаткиМатериалов.СчетУчета = ОстаткиСтоимостьМатериалов.СчетУчета
			|		И ОстаткиМатериалов.ИФО = ОстаткиСтоимостьМатериалов.ИФО
			|		И ОстаткиМатериалов.КФО = ОстаткиСтоимостьМатериалов.КФО
			|		И ОстаткиМатериалов.КПС = ОстаткиСтоимостьМатериалов.КПС
			|		И ОстаткиМатериалов.Подразделение = ОстаткиСтоимостьМатериалов.Подразделение
			|		И ОстаткиМатериалов.Номенклатура = ОстаткиСтоимостьМатериалов.Номенклатура
			|		И ОстаткиМатериалов.ДопИзмерение = ОстаткиСтоимостьМатериалов.ДопИзмерение
			|		И ОстаткиМатериалов.ДопАналитика = ОстаткиСтоимостьМатериалов.ДопАналитика
			|СГРУППИРОВАТЬ ПО
			|	ОстаткиМатериалов.СчетУчета,
			|	ОстаткиМатериалов.СчетУчета.Код,
			|	ОстаткиМатериалов.ИФО,
			|	ОстаткиМатериалов.КФО,
			|	ОстаткиМатериалов.КПС,
			|	ОстаткиМатериалов.Подразделение,
			|	ОстаткиМатериалов.Номенклатура,
			|	ОстаткиМатериалов.ДопИзмерение,
			|	ОстаткиМатериалов.ДопАналитика,
			|	ОстаткиМатериалов.Партия";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + ИтоговыйТекстЗапроса;
		// Сократить неиспользуемые поля соединения виртуальных таблиц
		Если НЕ (ПараметрыУчета.ДопИзмерениеЕстьСубконто И ПараметрыУчета.ДопИзмерениеСуммовой) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ОстаткиМатериалов.ДопИзмерение = ОстаткиСтоимостьМатериалов.ДопИзмерение", "");
		КонецЕсли;
		Если НЕ (ПараметрыУчета.ДопАналитикаЕстьСубконто И ПараметрыУчета.ДопАналитикаСуммовой) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ОстаткиМатериалов.ДопАналитика = ОстаткиСтоимостьМатериалов.ДопАналитика", "");
		КонецЕсли;
		Если НЕ ПараметрыУчета.УчетПоКПС Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ОстаткиМатериалов.КПС = ОстаткиСтоимостьМатериалов.КПС", "");
		КонецЕсли;
		Если НЕ ПараметрыУчета.УчетПоИФО Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ОстаткиМатериалов.ИФО = ОстаткиСтоимостьМатериалов.ИФО", "");
		КонецЕсли;
		Если НЕ ПараметрыУчета.УчетПоПодразделениям Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ОстаткиМатериалов.Подразделение = ОстаткиСтоимостьМатериалов.Подразделение", "");
		КонецЕсли;
		
	Иначе // по всем субконто ведется и количественный, и суммовой учет
		
		Если УчитыватьКорректировки Тогда
			ТекстЗапроса = ТекстыЗапросов.ДвиженияДокументов_НомерЗапроса;
			
			ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов();
			
			ТекстЗапроса = ТекстЗапроса +
			"ВЫБРАТЬ
			|	Остатки.СчетУчета КАК СчетУчета,
			|	Остатки.КодСчета КАК КодСчета,
			|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
			|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
			|	Остатки.ИФО КАК ИФО,
			|	Остатки.КФО КАК КФО,
			|	Остатки.КПС КАК КПС,
			|	Остатки.Подразделение КАК Подразделение,
			|	Остатки.Номенклатура КАК Номенклатура,
			|	Остатки.ДопИзмерение КАК ДопИзмерение,
			|	Остатки.ДопАналитика КАК ДопАналитика,
			|	Остатки.Партия КАК Партия,
			|	МАКСИМУМ(&ДопИзмерениеСуммовой_НомерЗапроса) КАК ДопИзмерениеСуммовой,
			|	МАКСИМУМ(&ДопАналитикаСуммовой_НомерЗапроса) КАК ДопАналитикаСуммовой,
			|	МАКСИМУМ(&ПартияСуммовой_НомерЗапроса) КАК ПартияСуммовой,
			|	СУММА(Остатки.Количество) КАК Количество,
			|	СУММА(Остатки.КоличествоВсего) КАК КоличествоВсего,
			|	СУММА(Остатки.СтоимостьВсего) КАК СтоимостьВсего,
			|	СУММА(Остатки.СтоимостьНеУчитываетсяНУВсего) КАК СтоимостьНеУчитываетсяНУВсего,
			|	СУММА(Остатки.СтоимостьЕНВДВсего) КАК СтоимостьЕНВДВсего,
			|	СУММА(0) КАК КоличествоЗарезервировано,
			|	СУММА(0) КАК СуммаЗарезервировано,
			|	СУММА(0) КАК КоличествоЗарезервированоДокумент,
			|	СУММА(0) КАК СуммаЗарезервированоДокумент,
			|	МАКСИМУМ(ЛОЖЬ) КАК ЕстьРезервДокумента
			|ПОМЕСТИТЬ ОстаткиМатериалов_НомерЗапроса
			|ИЗ (
			|	ВЫБРАТЬ
			|		ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
			|		ЖурналПроводокЕПСБУОстатки.Счет.Код КАК КодСчета,
			|		&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
			|		&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
			|		ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
			|		ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
			|		ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
			|		ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
			|		ЖурналПроводокЕПСБУОстатки.Номенклатура КАК Номенклатура,
			|		ЖурналПроводокЕПСБУОстатки.ДопИзмерение КАК ДопИзмерение,
			|		ЖурналПроводокЕПСБУОстатки.ДопАналитика КАК ДопАналитика,
			|		ЖурналПроводокЕПСБУОстатки.Партия КАК Партия,
			|		&ДопИзмерениеСуммовой_НомерЗапроса КАК ДопИзмерениеСуммовой,
			|		&ДопАналитикаСуммовой_НомерЗапроса КАК ДопАналитикаСуммовой,
			|		&ПартияСуммовой_НомерЗапроса КАК ПартияСуммовой,
			|		ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество,
			|		ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоВсего,
			|		ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СтоимостьВсего,
			|		ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СтоимостьНеУчитываетсяНУВсего,
			|		ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СтоимостьЕНВДВсего
			|		ИЗ
			|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|				&МоментВремени,
			|				Счет В (&Счета_НомерЗапроса),
			|				&Субконто_НомерЗапроса,
			|				Организация = &Организация
			|					И КФО В (&КФО_НомерЗапроса)
			|					И &УсловиеПоНоменклатуре
			|					И &УсловиеПоДопИзмерению
			|					И &УсловиеПоДопАналитике
			|					И &УсловиеПоИФО
			|					И &УсловиеПоКПС
			|					И &УсловиеПоПодразделению) КАК ЖурналПроводокЕПСБУОстатки
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		Движения.СчетУчета,
			|		Движения.СчетУчета.Код,
			|		&УчетПоПодразделениям_НомерЗапроса,
			|		&УчетПоКПС_НомерЗапроса,
			|		Движения.ИФО,
			|		Движения.КФО,
			|		Движения.КПС,
			|		Движения.Подразделение,
			|		Движения.Номенклатура,
			|		Движения.ДопИзмерение,
			|		Движения.ДопАналитика,
			|		Движения.Партия,
			|		&ДопИзмерениеСуммовой_НомерЗапроса,
			|		&ДопАналитикаСуммовой_НомерЗапроса,
			|		&ПартияСуммовой_НомерЗапроса,
			|		Движения.Количество,
			|		Движения.КоличествоВсего,
			|		Движения.СтоимостьВсего,
			|		Движения.СтоимостьНеУчитываетсяНУВсего,
			|		Движения.СтоимостьЕНВДВсего
			|	ИЗ
			|		ДвиженияДокументов_НомерЗапроса КАК Движения) КАК Остатки
			|
			|СГРУППИРОВАТЬ ПО
			|	Остатки.СчетУчета,
			|	Остатки.КодСчета,
			|	Остатки.ИФО,
			|	Остатки.КФО,
			|	Остатки.КПС,
			|	Остатки.Подразделение,
			|	Остатки.Номенклатура,
			|	Остатки.ДопИзмерение,
			|	Остатки.ДопАналитика,
			|	Остатки.Партия";
			
		Иначе
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
			|	ЖурналПроводокЕПСБУОстатки.Счет.Код КАК КодСчета,
			|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
			|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
			|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
			|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
			|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
			|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
			|	ЖурналПроводокЕПСБУОстатки.Номенклатура КАК Номенклатура,
			|	ЖурналПроводокЕПСБУОстатки.ДопИзмерение КАК ДопИзмерение,
			|	ЖурналПроводокЕПСБУОстатки.ДопАналитика КАК ДопАналитика,
			|	ЖурналПроводокЕПСБУОстатки.Партия КАК Партия,
			|	МАКСИМУМ(&ДопИзмерениеСуммовой_НомерЗапроса) КАК ДопИзмерениеСуммовой,
			|	МАКСИМУМ(&ДопАналитикаСуммовой_НомерЗапроса) КАК ДопАналитикаСуммовой,
			|	МАКСИМУМ(&ПартияСуммовой_НомерЗапроса) КАК ПартияСуммовой,
			|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК Количество,
			|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК КоличествоВсего,
			|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт) КАК СтоимостьВсего,
			|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт) КАК СтоимостьНеУчитываетсяНУВсего,
			|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстатокДт) КАК СтоимостьЕНВДВсего,
			|	СУММА(0) КАК КоличествоЗарезервировано,
			|	СУММА(0) КАК СуммаЗарезервировано,
			|	СУММА(0) КАК КоличествоЗарезервированоДокумент,
			|	СУММА(0) КАК СуммаЗарезервированоДокумент,
			|	МАКСИМУМ(ЛОЖЬ) КАК ЕстьРезервДокумента
			|ПОМЕСТИТЬ ОстаткиМатериалов_НомерЗапроса
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&МоментВремени,
			|			Счет В (&Счета_НомерЗапроса),
			|			&Субконто_НомерЗапроса,
			|			Организация = &Организация
			|				И КФО В (&КФО_НомерЗапроса)
			|				И &УсловиеПоНоменклатуре
			|				И &УсловиеПоДопИзмерению
			|				И &УсловиеПоДопАналитике
			|				И &УсловиеПоИФО
			|				И &УсловиеПоКПС
			|				И &УсловиеПоПодразделению) КАК ЖурналПроводокЕПСБУОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	ЖурналПроводокЕПСБУОстатки.Счет,
			|	ЖурналПроводокЕПСБУОстатки.Счет.Код,
			|	ЖурналПроводокЕПСБУОстатки.ИФО,
			|	ЖурналПроводокЕПСБУОстатки.КФО,
			|	ЖурналПроводокЕПСБУОстатки.КПС,
			|	ЖурналПроводокЕПСБУОстатки.Подразделение,
			|	ЖурналПроводокЕПСБУОстатки.Номенклатура,
			|	ЖурналПроводокЕПСБУОстатки.ДопИзмерение,
			|	ЖурналПроводокЕПСБУОстатки.ДопАналитика,
			|	ЖурналПроводокЕПСБУОстатки.Партия";
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ") + 
	"ВЫБРАТЬ
	|	РезервМЗОстатки.СчетУчета КАК СчетУчета,
	|	РезервМЗОстатки.СчетУчета.Код КАК КодСчета,
	|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
	|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
	|	РезервМЗОстатки.ИФО КАК ИФО,
	|	РезервМЗОстатки.КФО КАК КФО,
	|	РезервМЗОстатки.КПС КАК КПС,
	|	РезервМЗОстатки.Подразделение КАК Подразделение,
	|	РезервМЗОстатки.Номенклатура КАК Номенклатура,
	|	РезервМЗОстатки.ЦМО КАК ДопИзмерение,
	|	&РезервМЗОстаткиДопАналитика КАК ДопАналитика,
	|	&РезервМЗОстаткиПартия КАК Партия,
	|	МАКСИМУМ(&ДопИзмерениеСуммовой_НомерЗапроса) КАК ДопИзмерениеСуммовой,
	|	МАКСИМУМ(&ДопАналитикаСуммовой_НомерЗапроса) КАК ДопАналитикаСуммовой,
	|	МАКСИМУМ(&ПартияСуммовой_НомерЗапроса) КАК ПартияСуммовой,
	|	СУММА(0) КАК Количество,
	|	СУММА(0) КАК КоличествоВсего,
	|	СУММА(0) КАК СтоимостьВсего,
	|	СУММА(0) КАК СтоимостьНеУчитываетсяНУВсего,
	|	СУММА(0) КАК СтоимостьЕНВДВсего,
	|	СУММА(РезервМЗОстатки.КоличествоОстаток) КАК КоличествоЗарезервировано,
	|	СУММА(РезервМЗОстатки.СуммаОстаток) КАК СуммаЗарезервировано,
	|	СУММА(0) КАК КоличествоЗарезервированоДокумент,
	|	СУММА(0) КАК СуммаЗарезервированоДокумент,
	|	МАКСИМУМ(ЛОЖЬ) КАК ЕстьРезервДокумента
	|ИЗ
	|	РегистрНакопления.РезервМЗ.Остатки(&МоментВремени, СчетУчета В (&Счета_НомерЗапроса)
	|	И Организация = &Организация
	|	И КФО В (&КФО_НомерЗапроса)
	|	И Номенклатура В (&Номенклатура_НомерЗапроса)
	|	И &УсловиеПоДопИзмРезерв
	|	И &УсловиеПоДопАнРезерв
	|	И &УсловиеПоИФО
	|	И &УсловиеПоКПС
	|	И &УсловиеПоПодразделению) КАК РезервМЗОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО РезервМЗОстатки.СчетУчета = ЕПСБУВидыСубконто.Ссылка
	|		И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии)
	|СГРУППИРОВАТЬ ПО
	|	РезервМЗОстатки.СчетУчета,
	|	РезервМЗОстатки.СчетУчета.Код,
	|	&УчетПоПодразделениям_НомерЗапроса,
	|	&УчетПоКПС_НомерЗапроса,
	|	РезервМЗОстатки.ИФО,
	|	РезервМЗОстатки.КФО,
	|	РезервМЗОстатки.КПС,
	|	РезервМЗОстатки.Подразделение,
	|	РезервМЗОстатки.Номенклатура,
	|	РезервМЗОстатки.ЦМО,
	|	&РезервМЗОстаткиДопАналитика,
	|	&РезервМЗОстаткиПартия";
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ") + 
	"ВЫБРАТЬ
	|	РезервМЗ.СчетУчета КАК СчетУчета,
	|	РезервМЗ.СчетУчета.Код КАК КодСчета,
	|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
	|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
	|	РезервМЗ.ИФО КАК ИФО,
	|	РезервМЗ.КФО КАК КФО,
	|	РезервМЗ.КПС КАК КПС,
	|	РезервМЗ.Подразделение КАК Подразделение,
	|	РезервМЗ.Номенклатура КАК Номенклатура,
	|	РезервМЗ.ЦМО КАК ДопИзмерение,
	|	&РезервМЗДопАналитика КАК ДопАналитика,
	|	&РезервМЗПартия КАК Партия,
	|	МАКСИМУМ(&ДопИзмерениеСуммовой_НомерЗапроса) КАК ДопИзмерениеСуммовой,
	|	МАКСИМУМ(&ДопАналитикаСуммовой_НомерЗапроса) КАК ДопАналитикаСуммовой,
	|	МАКСИМУМ(&ПартияСуммовой_НомерЗапроса) КАК ПартияСуммовой,
	|	СУММА(0) КАК Количество,
	|	СУММА(0) КАК КоличествоВсего,
	|	СУММА(0) КАК СтоимостьВсего,
	|	СУММА(0) КАК СтоимостьНеУчитываетсяНУВсего,
	|	СУММА(0) КАК СтоимостьЕНВДВсего,
	|	СУММА(0) КАК КоличествоЗарезервировано,
	|	СУММА(0) КАК СуммаЗарезервировано,
	|	СУММА(РезервМЗ.Количество) КАК КоличествоЗарезервированоДокумент,
	|	СУММА(РезервМЗ.Сумма) КАК СуммаЗарезервированоДокумент,
	|	МАКСИМУМ(ИСТИНА) КАК ЕстьРезервДокумента
	|ИЗ
	|	РегистрНакопления.РезервМЗ КАК РезервМЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО РезервМЗ.СчетУчета = ЕПСБУВидыСубконто.Ссылка
	|		И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии)
	|ГДЕ
	|	РезервМЗ.Регистратор = &Ссылка
	|	И РезервМЗ.Активность
	|	И РезервМЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|СГРУППИРОВАТЬ ПО
	|	РезервМЗ.СчетУчета,
	|	РезервМЗ.СчетУчета.Код,
	|	&УчетПоПодразделениям_НомерЗапроса,
	|	&УчетПоКПС_НомерЗапроса,
	|	РезервМЗ.ИФО,
	|	РезервМЗ.КФО,
	|	РезервМЗ.КПС,
	|	РезервМЗ.Подразделение,
	|	РезервМЗ.Номенклатура,
	|	РезервМЗ.ЦМО,
	|	&РезервМЗДопАналитика,
	|	&РезервМЗПартия";
	
	Если ПараметрыУчета.ДопИзмерениеЕстьСубконто И ПараметрыУчета.ДопИзмерениеСуммовой Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДопИзмерениеСуммовой_НомерЗапроса", "ИСТИНА");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДопИзмерениеСуммовой_НомерЗапроса", "ЛОЖЬ");
	КонецЕсли;
	Если ПараметрыУчета.ДопАналитикаЕстьСубконто И ПараметрыУчета.ДопАналитикаСуммовой Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДопАналитикаСуммовой_НомерЗапроса", "ИСТИНА");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДопАналитикаСуммовой_НомерЗапроса", "ЛОЖЬ");
	КонецЕсли;
	Если ПараметрыУчета.ПартияЕстьСубконто И ПараметрыУчета.ПартияСуммовой Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПартияСуммовой_НомерЗапроса", "ИСТИНА");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПартияСуммовой_НомерЗапроса", "ЛОЖЬ");
	КонецЕсли;
	
	Если ПараметрыУчета.ДопИзмерениеЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопИзмерению",
			"Субконто"+ПараметрыУчета.НомераСубконто["ДопИзмерение"]+" В (&ДопИзмерение_НомерЗапроса)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДвиженияПоДопИзмерению",
			"СубконтоКт"+ПараметрыУчета.НомераСубконто["ДопИзмерение"]+" В (&ДопИзмерение_НомерЗапроса)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопИзмРезерв",
			"ЦМО В (&ДопИзмерение_НомерЗапроса)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопИзмерению",
			"ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДвиженияПоДопИзмерению",
			"ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопИзмРезерв",
			"ИСТИНА");
	КонецЕсли;
	Если ПараметрыУчета.ДопАналитикаЕстьСубконто Тогда
		Если ПараметрыУчета.ДопАналитика.Количество() > 0 Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопАналитике",
				"Субконто"+ПараметрыУчета.НомераСубконто["ДопАналитика"]+" В (&ДопАналитика_НомерЗапроса)");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДвиженияПоДопАналитике",
				"СубконтоКт"+ПараметрыУчета.НомераСубконто["ДопАналитика"]+" В (&ДопАналитика_НомерЗапроса)");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопАнРезерв",
				"ДопАналитика В (&ДопАналитика_НомерЗапроса)");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопАналитике",
				"ИСТИНА");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДвиженияПоДопАналитике",
				"ИСТИНА");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопАнРезерв",
				"ИСТИНА");
		КонецЕсли;
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопАналитике",
			"ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДвиженияПоДопАналитике",
			"ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДопАнРезерв",
			"ИСТИНА");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоИФО",
		?(ПараметрыУчета.УчетПоИФО, "ИФО В (&ИФО_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКПС",
		?(ПараметрыУчета.УчетПоКПС, "КПС В (&КПС_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению",
		?(ПараметрыУчета.УчетПоПодразделениям, "Подразделение В (&Подразделение_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоНоменклатуре",
		"Субконто"+ПараметрыУчета.НомераСубконто["Номенклатура"]+" В (&Номенклатура_НомерЗапроса)");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДвиженияПоНоменклатуре",
		"СубконтоКт"+ПараметрыУчета.НомераСубконто["Номенклатура"]+" В (&Номенклатура_НомерЗапроса)");
	
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.Номенклатура",
		"ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто" + ПараметрыУчета.НомераСубконто["Номенклатура"] + " КАК Справочник.Номенклатура)");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокументов.Номенклатура",
		"ВЫРАЗИТЬ(ДвиженияДокументов.СубконтоКт"+ПараметрыУчета.НомераСубконто["Номенклатура"] + " КАК Справочник.Номенклатура)");
	Если ПараметрыУчета.ДопИзмерениеЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.ДопИзмерение",
			"ЖурналПроводокЕПСБУОстатки.Субконто"+ПараметрыУчета.НомераСубконто["ДопИзмерение"]);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокументов.ДопИзмерение",
			"ДвиженияДокументов.СубконтоКт"+ПараметрыУчета.НомераСубконто["ДопИзмерение"]);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.ДопИзмерение",
			"НЕОПРЕДЕЛЕНО");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокументов.ДопИзмерение",
			"НЕОПРЕДЕЛЕНО");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РезервМЗОстатки.ЦМО",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	УчетРезервовПоДопАналитике = ИспользуетсяДопАналитикаВРезервировании(ПараметрыУчета);
	УчетРезервовПоПартиям = Ложь;
	Если УчетРезервовПоДопАналитике Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РезервМЗДопАналитика",
			"РезервМЗ.ДопАналитика");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РезервМЗОстаткиДопАналитика",
			"РезервМЗОстатки.ДопАналитика");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РезервМЗДопАналитика",
			"НЕОПРЕДЕЛЕНО");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РезервМЗОстаткиДопАналитика",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	Если УчетРезервовПоПартиям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РезервМЗПартия",
			"РезервМЗ.ДопАналитика");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РезервМЗОстаткиПартия",
			"РезервМЗОстатки.ДопАналитика");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РезервМЗПартия",
			"НЕОПРЕДЕЛЕНО");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РезервМЗОстаткиПартия",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	Если ПараметрыУчета.ДопАналитикаЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.ДопАналитика",
			"ЖурналПроводокЕПСБУОстатки.Субконто"+ПараметрыУчета.НомераСубконто["ДопАналитика"]);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокументов.ДопАналитика",
			"ДвиженияДокументов.СубконтоКт"+ПараметрыУчета.НомераСубконто["ДопАналитика"]);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.ДопАналитика",
			"НЕОПРЕДЕЛЕНО");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокументов.ДопАналитика",
			"НЕОПРЕДЕЛЕНО");
//		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РезервМЗОстатки.ДопАналитика",
//			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Если ПараметрыУчета.ПартияЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.Партия",
			"ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто"+ПараметрыУчета.НомераСубконто["Партия"] + ", НЕОПРЕДЕЛЕНО)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокументов.Партия",
			"ЕСТЬNULL(ДвиженияДокументов.СубконтоКт"+ПараметрыУчета.НомераСубконто["Партия"] + ", НЕОПРЕДЕЛЕНО)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.Партия",
			"НЕОПРЕДЕЛЕНО");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокументов.Партия",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Если НЕ ПараметрыУчета.УчетПоКПС Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.КПС", "ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокументов.КПСКт", "ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РезервМЗОстатки.КПС", "ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоИФО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокументов.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РезервМЗОстатки.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоПодразделениям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДвиженияДокументов.ПодразделениеКт", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РезервМЗОстатки.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
	
	Возврат ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов();
	
КонецФункции

Функция ТекстыЗапросовОстатковМатериальныхЗапасов()
	
	Результат = Новый Структура;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЖурналПроводокЕПСБУОстатки.Счет.Код КАК КодСчета,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.Номенклатура КАК Номенклатура,
	|	ЖурналПроводокЕПСБУОстатки.ДопИзмерение КАК ДопИзмерение,
	|	ЖурналПроводокЕПСБУОстатки.ДопАналитика КАК ДопАналитика,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоВсего,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СтоимостьВсего,
	|	ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СтоимостьНеУчитываетсяНУВсего,
	|	ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СтоимостьЕНВДВсего
	|ПОМЕСТИТЬ ВТ_ОстаткиСтоимостьМатериалов_НомерЗапроса
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&МоментВремени,
	|			Счет В (&Счета_НомерЗапроса),
	|			&СубконтоДляРасчетаСтоимости_НомерЗапроса,
	|			Организация = &Организация
	|				И КФО В (&КФО_НомерЗапроса)
	|				И &УсловиеПоНоменклатуре
	|				И &УсловиеПоДопИзмерению
	|				И &УсловиеПоДопАналитике
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКПС
	|				И &УсловиеПоПодразделению) КАК ЖурналПроводокЕПСБУОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИФО,
	|	КФО,
	|	КПС,
	|	Подразделение,
	|	СчетУчета,
	|	Номенклатура,
	|	ДопИзмерение,
	|	ДопАналитика";
	Результат.Вставить("ВТ_ОстаткиСтоимостьМатериалов_НомерЗапроса", ТекстЗапроса);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЖурналПроводокЕПСБУОстатки.Счет.Код КАК КодСчета,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.Номенклатура КАК Номенклатура,
	|	ЖурналПроводокЕПСБУОстатки.ДопИзмерение КАК ДопИзмерение,
	|	ЖурналПроводокЕПСБУОстатки.ДопАналитика КАК ДопАналитика,
	|	ЖурналПроводокЕПСБУОстатки.Партия КАК Партия,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
	|ПОМЕСТИТЬ ВТ_ОстаткиМатериалов_НомерЗапроса
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&МоментВремени,
	|			Счет В (&Счета_НомерЗапроса),
	|			&Субконто_НомерЗапроса,
	|			Организация = &Организация
	|				И КФО В (&КФО_НомерЗапроса)
	|				И &УсловиеПоНоменклатуре
	|				И &УсловиеПоДопИзмерению
	|				И &УсловиеПоДопАналитике
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКПС
	|				И &УсловиеПоПодразделению) КАК ЖурналПроводокЕПСБУОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИФО,
	|	КФО,
	|	КПС,
	|	Подразделение,
	|	СчетУчета,
	|	Номенклатура,
	|	ДопИзмерение,
	|	ДопАналитика,
	|	Партия";
	Результат.Вставить("ВТ_ОстаткиМатериалов_НомерЗапроса", ТекстЗапроса);

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОстаткиМатериалов.СчетУчета КАК СчетУчета,
	|	ОстаткиМатериалов.СчетУчета.Код КАК КодСчета,
	|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
	|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
	|	ОстаткиМатериалов.ИФО КАК ИФО,
	|	ОстаткиМатериалов.КФО КАК КФО,
	|	ОстаткиМатериалов.КПС КАК КПС,
	|	ОстаткиМатериалов.Подразделение КАК Подразделение,
	|	ОстаткиМатериалов.Номенклатура КАК Номенклатура,
	|	ОстаткиМатериалов.ДопИзмерение КАК ДопИзмерение,
	|	ОстаткиМатериалов.ДопАналитика КАК ДопАналитика,
	|	ОстаткиМатериалов.Партия КАК Партия,
	|	СУММА(ОстаткиМатериалов.Количество) КАК Количество,
	|	СУММА(ОстаткиСтоимостьМатериалов.КоличествоВсего) КАК КоличествоВсего,
	|	СУММА(ОстаткиСтоимостьМатериалов.СтоимостьВсего) КАК СтоимостьВсего,
	|	СУММА(ОстаткиСтоимостьМатериалов.СтоимостьНеУчитываетсяНУВсего) КАК СтоимостьНеУчитываетсяНУВсего,
	|	СУММА(ОстаткиСтоимостьМатериалов.СтоимостьЕНВДВсего) КАК СтоимостьЕНВДВсего
	|ПОМЕСТИТЬ ОстаткиМатериалов_НомерЗапроса
	|ИЗ
	|	ВТ_ОстаткиМатериалов_НомерЗапроса КАК ОстаткиМатериалов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОстаткиСтоимостьМатериалов_НомерЗапроса КАК ОстаткиСтоимостьМатериалов
	|		ПО ОстаткиМатериалов.СчетУчета = ОстаткиСтоимостьМатериалов.СчетУчета
	|		И ОстаткиМатериалов.ИФО = ОстаткиСтоимостьМатериалов.ИФО
	|		И ОстаткиМатериалов.КФО = ОстаткиСтоимостьМатериалов.КФО
	|		И ОстаткиМатериалов.КПС = ОстаткиСтоимостьМатериалов.КПС
	|		И ОстаткиМатериалов.Подразделение = ОстаткиСтоимостьМатериалов.Подразделение
	|		И ОстаткиМатериалов.Номенклатура = ОстаткиСтоимостьМатериалов.Номенклатура
	|		И ОстаткиМатериалов.ДопИзмерение = ОстаткиСтоимостьМатериалов.ДопИзмерение
	|		И ОстаткиМатериалов.ДопАналитика = ОстаткиСтоимостьМатериалов.ДопАналитика
	|		И ОстаткиМатериалов.Партия = ОстаткиСтоимостьМатериалов.Партия
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиМатериалов.СчетУчета,
	|	ОстаткиМатериалов.СчетУчета.Код,
	|	ОстаткиМатериалов.ИФО,
	|	ОстаткиМатериалов.КФО,
	|	ОстаткиМатериалов.КПС,
	|	ОстаткиМатериалов.Подразделение,
	|	ОстаткиМатериалов.Номенклатура,
	|	ОстаткиМатериалов.ДопИзмерение,
	|	ОстаткиМатериалов.ДопАналитика,
	|	ОстаткиМатериалов.Партия";
	Результат.Вставить("ОстаткиМатериалов_НомерЗапроса", ТекстЗапроса);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДвиженияДокументов.СчетКт КАК СчетУчета,
	|	ДвиженияДокументов.СчетКт.Код КАК КодСчета,
	|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
	|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
	|	ДвиженияДокументов.ИФО КАК ИФО,
	|	ДвиженияДокументов.КФО КАК КФО,
	|	ДвиженияДокументов.КПСКт КАК КПС,
	|	ДвиженияДокументов.ПодразделениеКт КАК Подразделение,
	|	ДвиженияДокументов.Номенклатура КАК Номенклатура,
	|	ДвиженияДокументов.ДопИзмерение КАК ДопИзмерение,
	|	ДвиженияДокументов.ДопАналитика КАК ДопАналитика,
	|	ДвиженияДокументов.Партия КАК Партия,
	|	СУММА(ДвиженияДокументов.КоличествоКт) КАК Количество,
	|	СУММА(ДвиженияДокументов.КоличествоКт) КАК КоличествоВсего,
	|	СУММА(ДвиженияДокументов.Сумма) КАК СтоимостьВсего,
	|	СУММА(ЕСТЬNULL(ДвиженияДокументов.СуммаНеУчитываетсяНУ, 0)) КАК СтоимостьНеУчитываетсяНУВсего,
	|	СУММА(ЕСТЬNULL(ДвиженияДокументов.СуммаЕНВД, 0)) КАК СтоимостьЕНВДВсего
	|ПОМЕСТИТЬ ДвиженияДокументов_НомерЗапроса
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(,,
	|				СчетКт В (&Счета_НомерЗапроса)
	|				И Регистратор В (&ВсеКорректировки)
	|				И &УсловиеДвиженияПоНоменклатуре
	|				И &УсловиеДвиженияПоДопИзмерению
	|				И &УсловиеДвиженияПоДопАналитике
	|				,,) КАК ДвиженияДокументов
	|СГРУППИРОВАТЬ ПО
	|	ДвиженияДокументов.СчетКт,
	|	ДвиженияДокументов.СчетКт.Код,
	|	&УчетПоПодразделениям_НомерЗапроса,
	|	&УчетПоКПС_НомерЗапроса,
	|	ДвиженияДокументов.ИФО,
	|	ДвиженияДокументов.КФО,
	|	ДвиженияДокументов.КПСКт,
	|	ДвиженияДокументов.ПодразделениеКт,
	|	ДвиженияДокументов.Номенклатура,
	|	ДвиженияДокументов.ДопИзмерение,
	|	ДвиженияДокументов.ДопАналитика,
	|	ДвиженияДокументов.Партия";
	Результат.Вставить("ДвиженияДокументов_НомерЗапроса", ТекстЗапроса);
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяДопАналитикаВРезервировании(ПараметрыУчета)
	
	Если Не ПараметрыУчета.ДопАналитикаЕстьСубконто Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("РезервироватьСуммуМЗПриВыбытии") Тогда
		Возврат ПараметрыУчета.ДопАналитикаСуммовой;
	Иначе
		Если Не ПараметрыУчета.ДопАналитикаКоличественный Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ПараметрыУчета.ДопАналитикаВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Партии
			И ПараметрыУчета.ДопАналитикаОбязательный Тогда
			Возврат Истина;
		КонецЕсли;
		Если ПараметрыУчета.ДопАналитикаВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
			ЭтоСчет106 = БухгалтерскийУчет.СчетВИерархии(ПараметрыУчета.СчетУчета, "106.00");
			Возврат Не ЭтоСчет106;
		ИначеЕсли ПараметрыУчета.ДопАналитикаВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Партии Тогда
			ЭтоСчет105 = БухгалтерскийУчет.СчетВИерархии(ПараметрыУчета.СчетУчета, "105.00");
			Возврат Не ЭтоСчет105;
		Иначе
			Возврат ПараметрыУчета.ДопАналитикаКоличественный и ПараметрыУчета.ДопАналитикаОбязательный;
		КонецЕсли;
			
	КонецЕсли;
	
КонецФункции

// Заполняет свойства счетов и значения ФО в строки таблицы.
//
// Параметры:
//  ТаблицаДокумента - ТаблицаЗначений - Обязательно должны быть колонки:
//   * СчетУчета - ПланСчетовСсылка.ЕПСБУ
//   * ПартияВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто
//   * УчетПоИФО - Булево
//   * УчетПоКПС - Булево
//   * УчетПоПодразделениям - Булево
//   * ДопАналитикаЕстьСубконто - Булево
//   * ДопАналитикаСуммовой - Булево
//   * ДопИзмерениеЕстьСубконто - Булево
//   * ДопИзмерениеСуммовой - Булево
//   * ПартияЕстьСубконто - Булево
//   * ПартияСуммовой - Булево
//  Реквизиты - Структура - должна содержать ключи:
//   * ИспользоватьУчетПоИФО - Булево
//   * ИспользоватьУчетПоПодразделениям - Булево
Процедура ЗаполнитьПараметрыУчетаМатериальныхЗапросов(ТаблицаДокумента, Реквизиты) Экспорт
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СвойстваСчета = УправлениеМатериальнымиЗапасамиПовтИсп.СвойстваСчетаДляУчетаМЗ(СтрокаДокумента.СчетУчета,
			СтрокаДокумента.ДопАналитикаВидСубконто,
			СтрокаДокумента.ДопИзмерениеВидСубконто,
			СтрокаДокумента.ПартияВидСубконто);
		
		СтрокаДокумента.ПартияВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Партии;
		СтрокаДокумента.УчетПоИФО = Реквизиты.ИспользоватьУчетПоИФО;
		СтрокаДокумента.УчетПоКПС = СвойстваСчета.УчетПоКПС;
		СтрокаДокумента.УчетПоПодразделениям =
			Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям;
		СтрокаДокумента.ДопАналитикаЕстьСубконто = СвойстваСчета.ДопАналитикаЕстьСубконто;
		СтрокаДокумента.ДопАналитикаСуммовой     = СвойстваСчета.ДопАналитикаСуммовой;
		СтрокаДокумента.ДопИзмерениеЕстьСубконто = СвойстваСчета.ДопИзмерениеЕстьСубконто;
		СтрокаДокумента.ДопИзмерениеСуммовой     = СвойстваСчета.ДопИзмерениеСуммовой;
		СтрокаДокумента.ПартияЕстьСубконто       = СвойстваСчета.ПартияЕстьСубконто;
		СтрокаДокумента.ПартияСуммовой           = СвойстваСчета.ПартияСуммовой;
		
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьКолонкиПараметровУчетаМатериальныхЗапасов(Таблица) Экспорт
	Колонки = Таблица.Колонки;
	Если Колонки.Найти("ПартияВидСубконто") = Неопределено Тогда
		Колонки.Добавить("ПартияВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	КонецЕсли;
	
	Колонки.Добавить("УчетПоИФО",            Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("УчетПоКПС",            Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("УчетПоПодразделениям", Новый ОписаниеТипов("Булево"));
	
	Колонки.Добавить("ДопАналитикаЕстьСубконто", Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("ДопАналитикаСуммовой",     Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("ДопАналитикаКоличественный",     Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("ДопАналитикаОбязательный",     Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("ДопИзмерениеЕстьСубконто", Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("ДопИзмерениеСуммовой",     Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("ДопИзмерениеКоличественный",     Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("ДопИзмерениеОбязательный",     Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("ПартияЕстьСубконто",       Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("ПартияСуммовой",           Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("ПартияКоличественный",           Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("ПартияОбязательный",           Новый ОписаниеТипов("Булево"));
	
КонецПроцедуры

Функция ДобавитьПараметрыУчетаМатериальныхЗапасов(ТаблицаДокумента, Реквизиты)
	
	ДобавитьКолонкиПараметровУчетаМатериальныхЗапасов(ТаблицаДокумента);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
