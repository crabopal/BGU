// Данные регистраторов для заполнения в строках акта об утилизации МЗ и МЗ (ИК)
//
// Параметры:
//  ДокументыПоТипам - Соответствие из КлючИЗначение - 
//   * Ключ - Тип
//   * Значение - Массив из ДокументСсылка
// 
// Возвращаемое значение:
// Соответствие из КлючИЗначение:
//  * Ключ - ДокументСсылка
//  * Значение - Структура:
//   ** ОснованиеДата - Дата
//   ** ОснованиеНомер - Строка - номер документа, выведенный в соответствии с настройкой вывода номеров для данного типа документов
//   ** ОснованиеНаименование - Строка
//
Функция ДанныеРегистраторовДляЗаполненияАктаОбУтилизации(ДокументыПоТипам) Экспорт
	Запрос = Новый Запрос;
	ТекстыЗапроса = Новый Массив;
	ИндексПараметра = 0;
	Для Каждого ТипРегистратора Из ДокументыПоТипам Цикл
		МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипРегистратора.Ключ);
		ЕстьРеквизитПервичныйДокумент = ТипРегистратора.Ключ <> Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗ")
				И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ПервичныйДокумент", МетаданныеДокумента);
		Если Не ЕстьРеквизитПервичныйДокумент Тогда
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	Т.Дата КАК ОснованиеДата,
			|	Т.Номер КАК ОснованиеНомер,
			|	Т.Ссылка КАК Ссылка,
			|	""&НаименованиеДокументаПоУмолчанию"" КАК ОснованиеНаименование
			|ИЗ
			|	#Документ КАК Т
			|ГДЕ
			|	Т.Ссылка В(&Ссылка)";
		Иначе
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	Т.Дата КАК ОснованиеДата,
			|	Т.Номер КАК ОснованиеНомер,
			|	Т.Ссылка КАК Ссылка,
			|	ЕСТЬNULL(Т.ПервичныйДокумент.ВидПервичногоДокумента, ""&НаименованиеДокументаПоУмолчанию"") КАК ОснованиеНаименование
			|ИЗ
			|	#Документ КАК Т
			|ГДЕ
			|	Т.Ссылка В(&Ссылка)";
		КонецЕсли;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#Документ", "Документ." + МетаданныеДокумента.Имя);
		Если ТипРегистратора.Ключ = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗ")
				Или ТипРегистратора.Ключ = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗИК") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеДокументаПоУмолчанию", НСтр("ru = 'Решение о прекращении признания активами объектов нефинансовых активов'"));
		ИначеЕсли ТипРегистратора.Ключ = Тип("ДокументСсылка.АктСписанияМЗ")
				Или ТипРегистратора.Ключ = Тип("ДокументСсылка.АктСписанияИК") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеДокументаПоУмолчанию", НСтр("ru = 'Акт о списании материальных запасов'"));
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеДокументаПоУмолчанию", МетаданныеДокумента.Синоним);
		КонецЕсли;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Ссылка", "&Ссылка" + ИндексПараметра);
		ТекстыЗапроса.Добавить(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка" + ИндексПараметра, ТипРегистратора.Значение);
		ИндексПараметра = ИндексПараметра + 1;
	КонецЦикла;
	
	Результат = Новый Соответствие;
	Если ТекстыЗапроса.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос.Текст = СтрСоединить(ТекстыЗапроса, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка,
			Новый Структура("ОснованиеДата, ОснованиеНомер, ОснованиеНаименование",
				Выборка.ОснованиеДата,
				ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Выборка.Ссылка, Выборка.ОснованиеНомер),
				Выборка.ОснованиеНаименование));
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Пустая структура параметров учета имущества казны по ЦМО и подразделениям.
// 
// Возвращаемое значение:
//  Структура:
// * УчетПоПодразделениям - Булево - 
// * УчетПоЦМО - Булево - 
Функция НовыйПараметрыУчетаИКпоЦМОиПодразделениям() Экспорт
	Возврат Новый Структура("УчетПоПодразделениям, УчетПоЦМО", Ложь, Ложь);
КонецФункции

// Сохраненные параметры учета и кпо ЦМОи подразделениям.
// 
// Параметры:
//  Счет - ПланСчетовСсылка.ЕПСБУ
//  Организация - СправочникСсылка.Организации
//  Дата - Дата
// 
// Возвращаемое значение:
//  см. НовыйПараметрыУчетаИКпоЦМОиПодразделениям 
Функция СохраненныеПараметрыУчетаИКпоЦМОиПодразделениям(Счет, Организация, Дата) Экспорт
	Счета = БухгалтерскийУчет.СписокСчетов(Счет, Дата, Ложь, Организация);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЕПСБУ.УчетПоПодразделениям) КАК УчетПоПодразделениям,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СубконтоЦМО.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ) КАК УчетПоЦМО
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК СубконтоНоменклатура
	|		ПО ЕПСБУ.Ссылка = СубконтоНоменклатура.Ссылка
	|		И СубконтоНоменклатура.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК СубконтоЦМО
	|		ПО ЕПСБУ.Ссылка = СубконтоЦМО.Ссылка
	|		И СубконтоЦМО.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО)
	|ГДЕ
	|	ЕПСБУ.Ссылка В (&Счета)
	|	И НЕ ЕПСБУ.ЭлементГруппа";
	Запрос.УстановитьПараметр("Счета", Счета);
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = НовыйПараметрыУчетаИКпоЦМОиПодразделениям();
	Если Выборка.Следующий() Тогда
		Результат.УчетПоПодразделениям = Выборка.УчетПоПодразделениям = Истина;
		Результат.УчетПоЦМО = Выборка.УчетПоЦМО = Истина;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Проверить очистить сумму имущества казны.
// 
// Параметры:
//  Объект - ДокументОбъект
Процедура ПроверитьОчиститьСуммуИмуществаКазны(Объект) Экспорт

	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Объект.Организация, Объект.Дата);
	Если УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
		Для каждого Строка Из Объект.Материалы Цикл
			Если Строка.Сумма <> 0 Тогда
				Строка.Сумма = 0;
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры

// Таблица движений документов.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица движений документов:
// * Ссылка - ДокументСсылка
// * ИмяТабличнойЧасти - Строка -
// * НомерСтроки - Число -
// * Номенклатура - СправочникСсылка.Номенклатура -
// * ДополнительнаяАналитика - Характеристика.ВидыСубконто
// * СчетДт - ПланСчетовСсылка.ЕПСБУ -
// * СчетКт - ПланСчетовСсылка.ЕПСБУ -
// * КФО - ПеречислениеСсылка.КВД -
// * КПСДт - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * КПСКт - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * КЭКДт - СправочникСсылка.КОСГУ -
// * КЭККт - СправочникСсылка.КОСГУ -
// * Количество - Число -
// * Сумма - Число -
Функция ТаблицаДвиженийДокументов() Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка", Документы.ТипВсеСсылки());
	Результат.Колонки.Добавить("ИмяТабличнойЧасти", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура, СправочникСсылка.ВидыДенежныхДокументов"));
	Результат.Колонки.Добавить("ДополнительнаяАналитика", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	Результат.Колонки.Добавить("СчетДт", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Результат.Колонки.Добавить("СчетКт", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Результат.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Результат.Колонки.Добавить("КПСДт", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Результат.Колонки.Добавить("КПСКт", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Результат.Колонки.Добавить("КЭКДт", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Результат.Колонки.Добавить("КЭККт", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число"));
	Возврат Результат;
	
КонецФункции

// Движения документов.
// 
// Параметры:
//  МассивОбъектов - ДокументСсылка
//  СоответствиеДокументов - Неопределено
//                         - ТаблицаЗначений:
//   * Регистратор - ДокументСсылка
//   * Документ - ДокументСсылка
// 
// Возвращаемое значение:
//  см. ТаблицаДвиженийДокументов
Функция ДвиженияДокументов(МассивОбъектов, Знач СоответствиеДокументов = Неопределено) Экспорт

	Если СоответствиеДокументов = Неопределено Тогда
		СоответствиеДокументов = Новый ТаблицаЗначений;
		СоответствиеДокументов.Колонки.Добавить("Регистратор", Документы.ТипВсеСсылки());
		СоответствиеДокументов.Колонки.Добавить("Документ", Документы.ТипВсеСсылки());
	КонецЕсли;

	ПараметрыРаспределенияДвижений = УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти_Параметры();
	ПараметрыРаспределенияДвижений.КФОВТаблице             = Истина;
	ПараметрыРаспределенияДвижений.ТипНоменклатурыВТаблице = Истина;
	ПараметрыРаспределенияДвижений.ИмяКолонкиКЭК           = "КЭКСсылка";
	ПараметрыРаспределенияДвижений.ИмяКолонкиНоменклатура  = "Номенклатура";
	ПараметрыРаспределенияДвижений.ИменаСуммируемыхКолонок = "Количество,Сумма,КоличествоОстаток,СуммаОстаток";
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("Номенклатура", "Номенклатура");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("КФО",                "КФО");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("СчетКт",          "СчетУчета");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("КПСКт",                "КПС");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("Количество",         "Количество");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("КЭККт",                "КЭК");
	ПараметрыРаспределенияДвижений.СоответствиеКолонок.Вставить("ДопСубконто",        "ДополнительнаяАналитикаСчета");

	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("Номенклатура", "Номенклатура");
	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("СчетКт",          "СчетУчета");
	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("КПСКт",                "КПС");
	ПараметрыРаспределенияДвижений.СоответствиеКолонокУпрощенное.Вставить("КФО",                "КФО");
	
	Запрос = Новый Запрос;
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаСоответствиеДокументов());
	ЧастиЗапроса.Добавить(ТекстЗапросаДвиженийДокументов());
	КоличествоСлужебныхЗапросов = 3;
	НомерЗапроса = КоличествоСлужебныхЗапросов;
	Для Каждого Документ Из ОбщегоНазначенияБГУ.ДокументыПоТипам(МассивОбъектов) Цикл
		Если Не ЕстьФункцияТекстЗапросаТаблицыДляРасчетаДвижений(Документ.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Документ.Значение[0]);
		ЧастиЗапроса.Добавить(
			СтрЗаменить(МенеджерДокумента.ТекстЗапросаТаблицыДляРасчетаДвижений(),
				"&МассивОбъектов",
				"&МассивОбъектов" + НомерЗапроса));
		Запрос.УстановитьПараметр("МассивОбъектов" + НомерЗапроса, Документ.Значение);
		НомерЗапроса = НомерЗапроса + 1;
	КонецЦикла;

	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов()));
	// Установить "Разрешенные" во все запросы
	ТекущийНомер = 1;
	Для Каждого ЗапросПакета Из СхемаЗапроса.ПакетЗапросов Цикл
		ЗапросПакета.ВыбиратьРазрешенные = Истина;
		Если ТекущийНомер > КоличествоСлужебныхЗапросов Тогда
			ЗапросПакета.КонтрольныеТочкиИтогов.Добавить("Ссылка");
		КонецЕсли;
		ТекущийНомер = ТекущийНомер + 1;
	КонецЦикла;
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("Счета106хП", БухгалтерскийУчет.СписокСчетов("106.2П,106.3П", '20210101'));
	Запрос.УстановитьПараметр("Счет10856", БухгалтерскийУчет.СчетПоКоду("108.56"));
	Запрос.УстановитьПараметр("КЭК346", БухгалтерскийУчет.СчетПоКоду("108.56"));
	Запрос.УстановитьПараметр("СоответствиеДокументов", СоответствиеДокументов);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ОтборРегистратор = Новый Структура("Регистратор");
	
	ДвиженияДокументов = РезультатЗапроса[КоличествоСлужебныхЗапросов - 1].Выгрузить();
	ДвиженияДокументов.Индексы.Добавить("Регистратор");
	Результат = ТаблицаДвиженийДокументов();
	
	Для Индекс = КоличествоСлужебныхЗапросов По РезультатЗапроса.ВГраница() Цикл
		
		ДанныеДокументов = РезультатЗапроса[Индекс].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ДанныеДокументов.Следующий() Цикл
			
			ДанныеТекущегоДокумента = ДанныеДокументов.Выбрать();
			
			ОтборРегистратор.Регистратор = ДанныеДокументов.Ссылка;
			
			ДвиженияТекущегоДокумента = ДвиженияДокументов.Скопировать(ОтборРегистратор);
			ДанныеТекущегоДокумента.Следующий();
			ДанныеТекущегоДокумента.Сбросить();
			ПараметрыРаспределенияДвижений.Организация = ДанныеТекущегоДокумента.Организация;
			ПараметрыРаспределенияДвижений.ИФО = ДанныеТекущегоДокумента.ИФО;
			ПараметрыРаспределенияДвижений.Дата = ДанныеТекущегоДокумента.Дата;
			ПараметрыРаспределенияДвижений.ВыборкаМатериалы = ДанныеТекущегоДокумента;
			ПараметрыРаспределенияДвижений.ТаблицаДвижений = ДвиженияТекущегоДокумента;
			УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти(ПараметрыРаспределенияДвижений);
			ДанныеТекущегоДокумента.Сбросить();
			
			Пока ДанныеТекущегоДокумента.Следующий() Цикл
				НоваяСтрокаРезультата = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРезультата, ДанныеТекущегоДокумента);
				ОтборСтрокиДокумента = Новый Структура("НомерСтрокиДокумента", ДанныеТекущегоДокумента.НомерСтроки);
				СтрокиДвижений = ДвиженияТекущегоДокумента.НайтиСтроки(ОтборСтрокиДокумента);
				Если СтрокиДвижений.Количество() > 0 Тогда
					СтрокаСебестоимости = СтрокиДвижений[0];
					ЗаполнитьЗначенияСвойств(НоваяСтрокаРезультата, СтрокаСебестоимости,
						"КФО, СчетДт, КПСДт, КЭКДт, СчетКт, КПСКт, КЭККт");
					НоваяСтрокаРезультата.Сумма = СтрокаСебестоимости.Сумма;
					Если СтрокаСебестоимости.Количество <> 0 Тогда
						НоваяСтрокаРезультата.Цена = СтрокаСебестоимости.Сумма / СтрокаСебестоимости.Количество;
					КонецЕсли;
				Иначе
					Если НоваяСтрокаРезультата.Цена = 0 И НоваяСтрокаРезультата.Количество <> 0 Тогда
						НоваяСтрокаРезультата.Цена = НоваяСтрокаРезультата.Сумма / НоваяСтрокаРезультата.Количество;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Установить тип номенклатуры в строках.
// 
// Параметры:
//  Таблица - ДанныеФормыКоллекция:
//   * Номенклатура - СправочникСсылка.Номенклатура
//   * ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры
Процедура УстановитьТипНоменклатурыВСтрокахДляБиологическихАктивов(Таблица) Экспорт
	НоменклатураДокумента = Таблица.Выгрузить( , "Номенклатура").ВыгрузитьКолонку("Номенклатура"); // Массив из СправочникСсылка.Номенклатура
	ДанныеНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(НоменклатураДокумента, "ТипНоменклатуры");
	
	Для Каждого Строка Из Таблица Цикл
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьТипНоменклатурыВСтрокеДляБиологическихАктивов(Строка,
			ДанныеНоменклатуры.Получить(Строка.Номенклатура));
	КонецЦикла;
КонецПроцедуры

// Возвращает счет из группы 106 по переданному счету МЗ - 105.хх или 113.хх
// 
// Параметры:
//  СчетМатериала - ПланСчетовСсылка.ЕПСБУ
//  Организация - СправочникСсылка.Организации
//  НаДату - Дата
//  
// Возвращаемое значение:
//  ПланСчетовСсылка.ЕПСБУ
//
Функция СчетВложенийПоСчетуМатериала(СчетМатериала, Организация = Неопределено, НаДату = Неопределено) Экспорт
	Если БухгалтерскийУчет.СписокСчетов("105.20", НаДату, , Организация).Найти(СчетМатериала) <> Неопределено Тогда
		Возврат БухгалтерскийУчет.СчетПоКоду("106.2П", НаДату, Организация);
	ИначеЕсли БухгалтерскийУчет.СписокСчетов("105.30", НаДату, , Организация).Найти(СчетМатериала) <> Неопределено Тогда
		Возврат БухгалтерскийУчет.СчетПоКоду("106.3П", НаДату, Организация);
	ИначеЕсли БухгалтерскийУчет.СписокСчетов("113.20", НаДату, , Организация).Найти(СчетМатериала) <> Неопределено Тогда
		Возврат БухгалтерскийУчет.СчетПоКоду("106.27", НаДату, Организация);
	ИначеЕсли БухгалтерскийУчет.СписокСчетов("113.30", НаДату, , Организация).Найти(СчетМатериала) <> Неопределено Тогда
		Возврат БухгалтерскийУчет.СчетПоКоду("106.37", НаДату, Организация);
	Иначе
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
КонецФункции

// Заполнить данные счетов учета МЗВФорме.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ПараметрыЗаполнения - см. ПараметрыЗаполненияДанныхСчетовУчетаМЗВФорме
Процедура ЗаполнитьДанныеСчетовУчетаМЗВФорме(Форма, ПараметрыЗаполнения) Экспорт
	ДанныеСчетов = СчетаУчетаМатериальныхЗапасов(ПараметрыЗаполнения);
	ШаблонСчета = НСтр("ru = '%1.%2'");
	Счет105 = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	Счет113 = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	НаименованиеСчета105 = "";
	Если ПараметрыЗаполнения.Включать113 Тогда
		Если ЗначениеЗаполнено(ПараметрыЗаполнения.ДатаСчета) Тогда
			ДатаСчета = ПараметрыЗаполнения.ДатаСчета;
		Иначе
			ДатаСчета = ОбщегоНазначения.ТекущаяДатаПользователя();
		КонецЕсли;
		Счет105 = БухгалтерскийУчет.СчетПоКоду("105.00", ДатаСчета, ПараметрыЗаполнения.Организация);
		Свойства105 = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет105);
		КодыСчетов = Новый Массив;
		НаименованияСчетов = Новый Массив;
		КодыСчетов.Добавить(Свойства105.Код);
		НаименованияСчетов.Добавить(Свойства105.Наименование);
		
		Счет113 = БухгалтерскийУчет.СчетПоКоду("113.00", ДатаСчета, ПараметрыЗаполнения.Организация);
		Если ЗначениеЗаполнено(Счет113) Тогда
			Свойства113 = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет113);
			КодыСчетов.Добавить(Свойства113.Код);
			НаименованияСчетов.Добавить(Свойства113.Наименование);
		КонецЕсли;
			
		НаименованиеСчета105 = СтрШаблон(НСтр("ru = '%1. %2'"),
										 СтрСоединить(КодыСчетов, ", "),
										 СтрСоединить(НаименованияСчетов, ", "));
	КонецЕсли;
	
	Для каждого ТекДанныеСчета Из ДанныеСчетов Цикл
		Если ПараметрыЗаполнения.СписокВыбора.НайтиПоЗначению(ТекДанныеСчета.Счет) = Неопределено Тогда
			Если ПараметрыЗаполнения.Включать113 И ТекДанныеСчета.Счет = Счет105 Тогда
				НаименованиеСчета = НаименованиеСчета105;
			Иначе
				НаименованиеСчета = СтрШаблон(ШаблонСчета, ТекДанныеСчета.Код, ТекДанныеСчета.Наименование);
			КонецЕсли;
			ПараметрыЗаполнения.СписокВыбора.Добавить(ТекДанныеСчета.Счет, НаименованиеСчета);
		КонецЕсли;
		Если ТекДанныеСчета.ДополнительноеСубконто <> Неопределено Тогда
			ПараметрыЗаполнения.ВидыСубконтоСчетов.Вставить(ТекДанныеСчета.ТекущийСчет, ТекДанныеСчета.ДополнительноеСубконто);
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры

// Счета учета материальных запасов.
// 
// Параметры:
//  Параметры - см. УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ 
// 
// Возвращаемое значение:
//  ФиксированныйМассив из см. ДанныеСчетаУчетаМЗ -  Счета учета материальных запасов
Функция СчетаУчетаМатериальныхЗапасов(Параметры) Экспорт

	Организация = Параметры.Организация;
	ТолькоБалансовые = Параметры.ТолькоБалансовые;
	ДатаСчета = Параметры.ДатаСчета;

	Если ЗначениеЗаполнено(ДатаСчета) Тогда
		ИспользуемаяДатаСчета = НачалоДня(ДатаСчета);
	Иначе
		ИспользуемаяДатаСчета = НачалоДня(ОбщегоНазначения.ТекущаяДатаПользователя());
	КонецЕсли;
	
	ЧастиЗапроса = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаСчета", ИспользуемаяДатаСчета);
	Запрос.УстановитьПараметр("Счет105", БухгалтерскийУчет.СчетПоКоду("105.00", ИспользуемаяДатаСчета, Организация));
	Если Параметры.Включать105 Тогда
		ЧастиЗапроса.Добавить(ТекстЗапроса_СчетаУчетаМатериальныхЗапасов_105());
	КонецЕсли;
	Если Параметры.Включать108 Тогда
		Запрос.УстановитьПараметр("Счет108", БухгалтерскийУчет.СчетПоКоду("108.00", ИспользуемаяДатаСчета, Организация));
		ЧастиЗапроса.Добавить(ТекстЗапроса_СчетаУчетаМатериальныхЗапасовИК_108());
		Если Не Параметры.ТолькоБалансовыеИК Тогда
			Запрос.УстановитьПараметр("КодСчетаВыдачиВличноеПользованиеМЗ", "27.02");
			Запрос.УстановитьПараметр("КодыЗабалансовыхИК", СтрРазделить("01.53,02.53,02.6", ","));
			ТекстУсловиеСчета = "ЕПСБУ.Код В (&КодыЗабалансовыхИК)";
			ЧастиЗапроса.Добавить(СтрЗаменить(ТекстЗапроса_СчетаУчетаМатериальныхЗапасов_ЗабалансовыеСтандартные(),
				"&УсловиеСчета", ТекстУсловиеСчета));
		КонецЕсли;
	КонецЕсли;
	Если Параметры.Включать113 Тогда
		Запрос.УстановитьПараметр("Счет113", БухгалтерскийУчет.СчетПоКоду("113.00", ИспользуемаяДатаСчета, Организация));
		ЧастиЗапроса.Добавить(ТекстЗапроса_СчетаУчетаМатериальныхЗапасов_113());
	КонецЕсли;
	Если Параметры.Включать106 Тогда
		ДатаПереходаНа198н = '20210101';
		Запрос.УстановитьПараметр("Счет106", БухгалтерскийУчет.СчетПоКоду("106.00", ИспользуемаяДатаСчета, Организация));
		Если ИспользуемаяДатаСчета < ДатаПереходаНа198н Тогда
			ЧастиЗапроса.Добавить(ТекстЗапроса_СчетаУчетаМатериальныхЗапасов_106_До198н());
		Иначе
			ЧастиЗапроса.Добавить(ТекстЗапроса_СчетаУчетаМатериальныхЗапасов_106());
		КонецЕсли;
	ИначеЕсли Параметры.Включать106ИК Тогда
		Запрос.УстановитьПараметр("Счет106ИК", БухгалтерскийУчет.СчетПоКоду("106.50", ИспользуемаяДатаСчета, Организация));
		ЧастиЗапроса.Добавить(СтрЗаменить(ТекстЗапроса_СчетаУчетаМатериальныхЗапасов_106(), "&Счет106", "&Счет106ИК"));
	КонецЕсли;
	
	Если НЕ ТолькоБалансовые ИЛИ Параметры.Включать0233 ИЛИ Параметры.Включать0234 Тогда
		
		Запрос.УстановитьПараметр("КодСчетаВыдачиВличноеПользованиеМЗ", "27.02");
		
		Если Параметры.Включать0234 И Параметры.Включать0233 Тогда
			Запрос.УстановитьПараметр("КодыСчетовКомиссия", СтрРазделить("02.33,02.34", ","));
			ТекстУсловиеСчета = "ЕПСБУ.Код В (&КодыСчетовКомиссия)";
		ИначеЕсли Параметры.Включать0233 Тогда
			Запрос.УстановитьПараметр("КодСчета0233", "02.33");
			ТекстУсловиеСчета = "ЕПСБУ.Код = (&КодСчета0233)";
		ИначеЕсли Параметры.Включать0234 Тогда
			Запрос.УстановитьПараметр("КодСчета0234", "02.34");
			ТекстУсловиеСчета = "ЕПСБУ.Код = (&КодСчета0234)";
		КонецЕсли;
			
		Если НЕ ТолькоБалансовые Тогда
			Запрос.УстановитьПараметр("КодыЗабалансовых", СтрРазделить("02,07,09,12,13,22,23,27", ","));
			Запрос.УстановитьПараметр("КодСчета0133", "01.33");
			ТекстУсловиеСчета = "(ПОДСТРОКА(ЕПСБУ.Код, 1, 2) В (&КодыЗабалансовых) ИЛИ ЕПСБУ.Код = &КодСчета0133)";
		КонецЕсли;
		
		Если Параметры.Свойство("ВключатьСчетТПР") Тогда
			Если Параметры.ВключатьСчетТПР Тогда
				Запрос.УстановитьПараметр("КодСчетаТПР", "ТПР");
				ТекстУсловиеСчета = "ЕПСБУ.Код = (&КодСчетаТПР)";
			КонецЕсли;
		КонецЕсли;
		
		ЧастиЗапроса.Добавить(СтрЗаменить(ТекстЗапроса_СчетаУчетаМатериальныхЗапасов_ЗабалансовыеСтандартные(),
			"&УсловиеСчета", ТекстУсловиеСчета));
		ЧастиЗапроса.Добавить(ТекстЗапроса_СчетаУчетаМатериальныхЗапасов_ЗабалансовыеПользовательские());
		
	КонецЕсли;
	
	Если ЧастиЗапроса.Количество() = 0 Тогда
		Возврат Новый ФиксированныйМассив(Новый Массив);
	КонецЕсли;
	
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ")) + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	НПП";
	
	ДанныеСчетов = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеСчета = ДанныеСчетаУчетаМЗ();
		ЗаполнитьЗначенияСвойств(ДанныеСчета, Выборка);
		ДанныеСчетов.Добавить(Новый ФиксированнаяСтруктура(ДанныеСчета));
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(ДанныеСчетов);

КонецФункции

#Область Печать

// Добавить данные для печати0510448.
// 
// Параметры:
//  ДанныеДокументов - см. УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448
//  МассивОбъектов - Массив из ДокументСсылка
//  ТекстыЗапросов - Структура
//  ПоСебестоимости - Булево
Процедура ДобавитьДанныеДляПечати0510448(ДанныеДокументов, МассивОбъектов, ТекстыЗапросов, ПоСебестоимости) Экспорт

	ГруппыОбъектовНФА = УправлениеПечатьюБГУ.ГруппыОбъектовНФА();
	Счет10520 = БухгалтерскийУчет.СчетПоКоду("105.20");
	Счет10530 = БухгалтерскийУчет.СчетПоКоду("105.30");
	Счет10856 = БухгалтерскийУчет.СчетПоКоду("108.56");
	Счет10857 = БухгалтерскийУчет.СчетПоКоду("108.57");
	ДанныеДляПечати = ДанныеДляПечати0510448_МЗ(МассивОбъектов, ТекстыЗапросов);
	
	ВыборкаДокументов  = ДанныеДляПечати.ВыборкаДокументов;
	ВыборкаОС          = ДанныеДляПечати.ВыборкаНФА;
	ВыборкаФайлы       = ДанныеДляПечати.ВыборкаФайлы;
	ВыборкаФайлыАктаЭДО = ДанныеДляПечати.ВыборкаФайлыАктаЭДО;
	СоставКомиссий     = ДанныеДляПечати.СоставКомиссий;
	ВыборкаДрагМеталлы = ДанныеДляПечати.Драгметаллы;
	ВыборкаДрагМеталлы.Индексы.Добавить("Ссылка, Номенклатура");
	ВыборкаХарактеристики = ДанныеДляПечати.ДополнительныеРеквизиты;
	ВыборкаХарактеристики.Индексы.Добавить("Ссылка");
	
	ТаблицаДвиженийЗаб = ДанныеДляПечати.ТаблицаДвиженийЗаб;
	ПроверятьСуммыРезервов = ПолучитьФункциональнуюОпцию("РезервироватьМЗПриВыбытии")
		И ПолучитьФункциональнуюОпцию("РезервироватьСуммуМЗПриВыбытии");
	ПараметрыРаспределенияДвиженийЗаб = УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти_Параметры();
	ПараметрыРаспределенияДвиженийЗаб.ИмяКолонкиКЭК           = "";
	ПараметрыРаспределенияДвиженийЗаб.ИмяКолонкиНоменклатура  = "НФА";
	ПараметрыРаспределенияДвиженийЗаб.ИменаСуммируемыхКолонок = "Количество,Сумма,КоличествоОстаток,СуммаОстаток";
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("НоменклатураСсылка", "НФА");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("СчетУчета", "ЗабалансовыйСчетУчета");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("КПССсылка",          "ЗабалансовыйКПС");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("Количество",         "Количество");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонок.Вставить("ДопСубконто",        "ЗабалансовыйДополнительнаяАналитикаСчета");

	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("НоменклатураСсылка", "НФА");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("СчетУчета",          "ЗабалансовыйСчетУчета");
	ПараметрыРаспределенияДвиженийЗаб.СоответствиеКолонокУпрощенное.Вставить("КПССсылка",          "ЗабалансовыйКПС");
	
	ДвиженияДокументов = ДвиженияДокументов(МассивОбъектов);
	ДвиженияДокументов.Индексы.Добавить("Ссылка, НомерСтроки");
	ОтборДрагметаллы = Новый Структура("Ссылка, Номенклатура");
	ОтборХарактеристики = Новый Структура("Ссылка");
	
	ДанныеДокументов = УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
	// Согласно Письма Минфина России от 01.04.2024 N 02-06-06/29423:
	// «При передаче материальных запасов данные в разделах 1 - 3 формируются передающей стороной на основании данных бухгалтерского учета 
	// с учетом следующих особенностей:
	// в разделе 1 - графы 3 и 4, 6 - 13, 16 - 21 - не заполняются;
	// разделы 2 и 3 не заполняются.
	КолонкиНеИспользуемыеДляМЗ = Новый Структура(
		"КодГруппы,
		|КодОбъекта,
		|ИнвентарныйНомер,
		|РеестровыйНомер,
		|ЗаводскойНомер,
		|ИнойНомер,
		|Сведения,
		|ДатаВыпуска,
		|ДатаВводаВЭксплуатацию,
		|СуммаВложений,
		|СрокЭксплуатации,
		|АмортизационнаяГруппа,
		|МетодАмортизации,
		|ДатаОкончанияАмортизации,
		|СрокПолезногоИспользования,
		|СуммаАмортизации");
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		АналитическиеГруппыДокумента = Новый Массив;
		
		СтрокаДокумента = ДанныеДокументов.Добавить();
		СтрокаДокумента.ИндивидуальныеХарактеристики = УправлениеПечатьюБГУ.ТаблицаИндивидуальныеХарактеристикиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.ПередаваемыеОбъекты = УправлениеПечатьюБГУ.ТаблицаСведенияОПередаваемыхОбъектахНФААктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.ПринятыеОбъектыНФА = УправлениеПечатьюБГУ.ТаблицаСведенияОПринятыхОбъектахНФААктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.СведенияОбОграничениях = УправлениеПечатьюБГУ.ТаблицаСведенияОбОграниченияхАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.СоставКомиссии = УправлениеПечатьюБГУ.ТаблицаКомиссияДляПечатиПриказ61н();
		СтрокаДокумента.Файлы = УправлениеПечатьюБГУ.ТаблицаФайлыДляПечатиПриказ61н();
		СтрокаДокумента.ФайлыАктаЭДО = ЭлектронныеДокументыБГУ.ТаблицаФайлыДляПечатиПриказ61н();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);
		
		// Данные руководителя
		РуководительЕстьВЗапросе = Ложь;
		Если ВыборкаДокументов.Владелец().Колонки.Найти("Руководитель") <> Неопределено
			И ЗначениеЗаполнено(ВыборкаДокументов.Руководитель) Тогда
			РуководительЕстьВЗапросе = Истина;
		КонецЕсли;
		
		Если Не РуководительЕстьВЗапросе Тогда
			СтрокаДокумента.Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
				Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ВыборкаДокументов.Организация,
				ВыборкаДокументов.Дата).ОтветственноеЛицоСсылка;
		КонецЕсли;	
		
		// Шапка
		
		СтрокаДокумента.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер);
		СтрокаДокумента.ДатаАкта = ВыборкаДокументов.Дата;
		
		// Раздел 1
		
		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		
		ПоСебестоимостиЕслиПустаяСумма = ВыборкаДокументов.ВидПередачиМЗ = Перечисления.ВидыПоступленийМЗ.ОприходованиеСЗабалансовогоСчета;
		ВычислятьСуммуИзДвиженийЗабаланс =
			(ВыборкаДокументов.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаПоДоговоруБезвмозмездногоПользования
				Или ВыборкаДокументов.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаПоДоговоруАренды
				Или ВыборкаДокументов.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаВДоверительноеУправление
				Или ВыборкаДокументов.ВидПередачиМЗ = Перечисления.ВидыПередачиИК.ПередачаПоДоговоруАренды
				Или ВыборкаДокументов.ВидПередачиМЗ = Перечисления.ВидыПередачиИК.ПередачаПоДоговоруБезвмозмездногоПользования)
			И ((ПроверятьСуммыРезервов И НЕ ВыборкаДокументов.Резервировать)
				Или Не ПроверятьСуммыРезервов);
		Если ВычислятьСуммуИзДвиженийЗабаланс Тогда
			ВыборкаОС.Сбросить();
			ТаблицаДвиженийДокументаЗаб = ТаблицаДвиженийЗаб.Скопировать(Новый Структура("Ссылка", ВыборкаДокументов.Ссылка));
			ПараметрыРаспределенияДвиженийЗаб.Организация = ВыборкаДокументов.Организация;
			ПараметрыРаспределенияДвиженийЗаб.ИФО = ВыборкаДокументов.ИФО;
			ПараметрыРаспределенияДвиженийЗаб.Дата = ВыборкаДокументов.Дата;
			ПараметрыРаспределенияДвиженийЗаб.ВыборкаМатериалы = ВыборкаОС;
			ПараметрыРаспределенияДвиженийЗаб.ТаблицаДвижений = ТаблицаДвиженийДокументаЗаб;
			ПараметрыРаспределенияДвиженийЗаб.Вставить("Ссылка", ВыборкаДокументов.Ссылка);
			УправлениеПечатьюБГУ.СопоставитьДвиженияСоСтрокамиТабличнойЧасти(ПараметрыРаспределенияДвиженийЗаб);
		КонецЕсли;
		
		ВыборкаОС.Сбросить();
		
		Пока ВыборкаОС.НайтиСледующий(СтруктураПоиска) Цикл
			
			Если ВыборкаДокументов.Передача Тогда
				
				СтрокаПередача = СтрокаДокумента.ПередаваемыеОбъекты.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПередача, ВыборкаОС);
				ЗаполнитьЗначенияСвойств(СтрокаПередача, КолонкиНеИспользуемыеДляМЗ);
				
				СчетУчетаИзЗапроса = Новый Структура("СчетУчета");
				ЗаполнитьЗначенияСвойств(СчетУчетаИзЗапроса, ВыборкаОС);
				Если ЗначениеЗаполнено(СчетУчетаИзЗапроса.СчетУчета) Тогда
					ГруппаСчетовНФА = ГруппыОбъектовНФА.Получить(СчетУчетаИзЗапроса.СчетУчета);
					Если ГруппаСчетовНФА <> Неопределено Тогда
						АналитическаяГруппа = "";
						Если ГруппаСчетовНФА.Группа = Счет10520 Тогда
							АналитическаяГруппа = "20";
						ИначеЕсли ГруппаСчетовНФА.Группа = Счет10530 Тогда
							АналитическаяГруппа = "30";
						ИначеЕсли ГруппаСчетовНФА.Группа = Счет10856
								Или ГруппаСчетовНФА.Группа = Счет10857 Тогда
							АналитическаяГруппа = "50";
						КонецЕсли;
						Если ЗначениеЗаполнено(АналитическаяГруппа)
						 И АналитическиеГруппыДокумента.Найти(АналитическаяГруппа) = Неопределено Тогда
						 	АналитическиеГруппыДокумента.Добавить(АналитическаяГруппа);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				Если ПоСебестоимости Тогда
					Если ВычислятьСуммуИзДвиженийЗабаланс Тогда
						ОтборСтрокиДокумента = Новый Структура("НомерСтрокиДокумента", СтрокаПередача.НомерСтроки);
	 
						СтрокиДвижений = ТаблицаДвиженийДокументаЗаб.НайтиСтроки(ОтборСтрокиДокумента);
						Если СтрокиДвижений.Количество() > 0 Тогда
							СтрокаСебестоимости = СтрокиДвижений[0];
							СтрокаПередача.Сумма = СтрокаСебестоимости.СуммаОстаток;
							Если СтрокаСебестоимости.КоличествоОстаток <> 0 Тогда
								СтрокаПередача.Цена = СтрокаСебестоимости.СуммаОстаток / СтрокаСебестоимости.КоличествоОстаток;
							КонецЕсли;
							СтрокаСебестоимости.КоличествоОстаток = СтрокаСебестоимости.КоличествоОстаток - СтрокаПередача.Количество;
							СтрокаСебестоимости.СуммаОстаток = СтрокаСебестоимости.СуммаОстаток - СтрокаПередача.Сумма;
						Иначе
							Если СтрокаПередача.Цена = 0 И СтрокаПередача.Количество <> 0 Тогда
								СтрокаПередача.Цена = СтрокаПередача.Сумма / СтрокаПередача.Количество;
							КонецЕсли;
						КонецЕсли;
					Иначе
						ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтроки");
						ОтборСтрокиДокумента.Ссылка = ВыборкаДокументов.Ссылка;
						ОтборСтрокиДокумента.НомерСтроки = ВыборкаОС.НомерСтроки;
						
						СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(ОтборСтрокиДокумента);
						Если СтрокиДвижений.Количество() > 0 Тогда
							СтрокаСебестоимости = СтрокиДвижений[0];
							СтрокаПередача.Сумма = СтрокаСебестоимости.Сумма;
							СтрокаПередача.Цена = СтрокаСебестоимости.Цена;
						Иначе
							Если СтрокаПередача.Цена = 0 И СтрокаПередача.Количество <> 0 Тогда
								СтрокаПередача.Цена = СтрокаПередача.Сумма / СтрокаПередача.Количество;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				
				ОтборДрагметаллы.Ссылка = СтрокаДокумента.Ссылка;
				ОтборДрагметаллы.Номенклатура = СтрокаПередача.НФА;
				
				ОтборХарактеристики.Ссылка = СтрокаПередача.НФА;
				
				Драгметаллы = ВыборкаДрагМеталлы.НайтиСтроки(ОтборДрагметаллы);
				Характеристики = ВыборкаХарактеристики.НайтиСтроки(ОтборХарактеристики);
				
				МаксКоличество = Макс(ДрагМеталлы.Количество(), Характеристики.Количество());
				Для Индекс = 0 По МаксКоличество - 1 Цикл
					
					СтрокаХарактеристики = СтрокаДокумента.ИндивидуальныеХарактеристики.Добавить();
					СтрокаХарактеристики.НомерСтроки = СтрокаПередача.НомерСтроки;
					СтрокаХарактеристики.НаименованиеНФА = СтрокаПередача.НаименованиеНФА;
					Если Индекс < Характеристики.Количество() Тогда
						СтрокаХарактеристики.Характеристика = Характеристики[Индекс].Свойство;
						СтрокаХарактеристики.ЗначениеХарактеристики = Характеристики[Индекс].Значение;
					КонецЕсли;
					Если Индекс < Драгметаллы.Количество() Тогда
						СтрокаХарактеристики.Драгметалл = Драгметаллы[Индекс].Драгметалл;
						СтрокаХарактеристики.КодЕИ = Драгметаллы[Индекс].КодЕИ;
						СтрокаХарактеристики.НаименованиеЕИ = Драгметаллы[Индекс].НаименованиеЕИ;
						СтрокаХарактеристики.Количество = Драгметаллы[Индекс].Количество;
					КонецЕсли;
					// Для корректного вывода в печатную форму, необходимо заполнять колонку НФА
					// только в первой строке по каждому НФА
					Если Индекс = 0 Тогда
						СтрокаХарактеристики.НФА = СтрокаПередача.НФА;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Раздел 2
		
		
		// Раздел 3
		// Для МЗ не заполняется
		
		// Раздел 4
		
		Если ВыборкаДокументов.Принятие Тогда
			ВыборкаОС.Сбросить();
			
			Пока ВыборкаОС.НайтиСледующий(СтруктураПоиска) Цикл
			
				СтрокаПринятогоОбъекта = СтрокаДокумента.ПринятыеОбъектыНФА.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПринятогоОбъекта, ВыборкаДокументов);
				ЗаполнитьЗначенияСвойств(СтрокаПринятогоОбъекта, ВыборкаОС);
				
				СчетУчетаИзЗапроса = Новый Структура("СчетУчета");
				ЗаполнитьЗначенияСвойств(СчетУчетаИзЗапроса, ВыборкаОС);
				Если ЗначениеЗаполнено(СчетУчетаИзЗапроса.СчетУчета) Тогда
					ГруппаСчетовНФА = ГруппыОбъектовНФА.Получить(СчетУчетаИзЗапроса.СчетУчета);
					Если ГруппаСчетовНФА <> Неопределено Тогда
						Если ГруппаСчетовНФА.Группа = Счет10520 Тогда
							СтрокаПринятогоОбъекта.АналитическаяГруппа = "20";
							СтрокаПринятогоОбъекта.ВидИмущества = НаименованиеВидаИмуществаПоКодуАналитическойГруппы(
								СтрокаПринятогоОбъекта.АналитическаяГруппа);
						ИначеЕсли ГруппаСчетовНФА.Группа = Счет10530 Тогда
							СтрокаПринятогоОбъекта.АналитическаяГруппа = "30";
							СтрокаПринятогоОбъекта.ВидИмущества = НаименованиеВидаИмуществаПоКодуАналитическойГруппы(
								СтрокаПринятогоОбъекта.АналитическаяГруппа);
						ИначеЕсли ГруппаСчетовНФА.Группа = Счет10856
								Или ГруппаСчетовНФА.Группа = Счет10857 Тогда
							СтрокаПринятогоОбъекта.АналитическаяГруппа = "50";
							СтрокаПринятогоОбъекта.ВидИмущества = НаименованиеВидаИмуществаПоКодуАналитическойГруппы(
								СтрокаПринятогоОбъекта.АналитическаяГруппа);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаПринятогоОбъекта.АналитическаяГруппа)
				 И АналитическиеГруппыДокумента.Найти(СтрокаПринятогоОбъекта.АналитическаяГруппа) = Неопределено Тогда
				 	АналитическиеГруппыДокумента.Добавить(СтрокаПринятогоОбъекта.АналитическаяГруппа);
				КонецЕсли;

				Если ПоСебестоимостиЕслиПустаяСумма И ВыборкаОС.Сумма = 0 Тогда
					ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтроки");
					ОтборСтрокиДокумента.Ссылка = ВыборкаДокументов.Ссылка;
					ОтборСтрокиДокумента.НомерСтроки = ВыборкаОС.НомерСтроки;
					
					СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(ОтборСтрокиДокумента);
					Если СтрокиДвижений.Количество() > 0 Тогда
						СтрокаСебестоимости = СтрокиДвижений[0];
						СтрокаПринятогоОбъекта.Сумма = СтрокаСебестоимости.Сумма;
					КонецЕсли;
					
				КонецЕсли;
			
			КонецЦикла;
		КонецЕсли;
		
		// Обновить вид имущества и коды аналитического учета в шапке документа
		Если АналитическиеГруппыДокумента.Количество() > 0 Тогда
			ВидыИмуществаДокумента = Новый Массив(АналитическиеГруппыДокумента.Количество());
			Для ИндексАналитическойГруппы = 0 По АналитическиеГруппыДокумента.ВГраница() Цикл
				ВидыИмуществаДокумента[ИндексАналитическойГруппы] = НаименованиеВидаИмуществаПоКодуАналитическойГруппы(
					АналитическиеГруппыДокумента[ИндексАналитическойГруппы]);
			КонецЦикла;
			СтрокаДокумента.АналитическаяГруппа = СтрСоединить(АналитическиеГруппыДокумента, ", ");
			СтрокаДокумента.ВидИмущества = СтрСоединить(ВидыИмуществаДокумента, ", "); 
		КонецЕсли;
		
		// Приложения

		Пока ВыборкаФайлыАктаЭДО.НайтиСледующий(СтруктураПоиска) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаДокумента.ФайлыАктаЭДО.Добавить(), ВыборкаФайлыАктаЭДО);
		КонецЦикла;
		
		Пока ВыборкаФайлы.НайтиСледующий(СтруктураПоиска) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаДокумента.Файлы.Добавить(), ВыборкаФайлы);
		КонецЦикла;
		
		// Комиссия
		
		Отбор = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		СтрокиКомиссииДокумента = СоставКомиссий.НайтиСтроки(Отбор);
		Для Каждого СтрокаКомиссии Из СтрокиКомиссииДокумента Цикл
			СтрокаКомиссииДокумента = СтрокаДокумента.СоставКомиссии.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКомиссииДокумента, СтрокаКомиссии);
			ФИО = Новый Структура("Фамилия, Имя, Отчество",
					СтрокаКомиссии.Фамилия,
					СтрокаКомиссии.Имя,
					СтрокаКомиссии.Отчество);
			
			СтрокаКомиссииДокумента.ФИО = КорреспондентыКлиентСервер.ФИО(
				ФИО, Истина);
			СтрокаКомиссииДокумента.ОсобыеОтметки = ЭлектронныеДокументыБГУ.ФИОПоСтруктуре(ФИО);		
		КонецЦикла;		
		
	КонецЦикла;
	
КонецПроцедуры

// Добавить данные для печати0504230.
// 
// Параметры:
//  ДанныеДокументов - см. УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктаСписанияМЗ0504230
//  МассивОбъектов - Массив из ДокументСсылка
Процедура ДобавитьДанныеДляПечати0504230(ДанныеДокументов, МассивОбъектов) Экспорт
	
	Если МассивОбъектов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(МассивОбъектов[0]);
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(МенеджерДокумента.ТекстЗапросаШапкиДляПечатиАктаСписанияМЗ0504230());
	ЧастиЗапроса.Добавить(МенеджерДокумента.ТекстЗапросаМатериалыДляПечатиАктаСписанияМЗ0504230());
	ЧастиЗапроса.Добавить(МенеджерДокумента.ТекстЗапросаКомиссияДляПечатиАктаСписанияМЗ0504230());
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	ДвиженияДокументов = ДвиженияДокументов(МассивОбъектов);
	ДвиженияДокументов.Индексы.Добавить("Ссылка, НомерСтроки");
	
	КомиссииДокументов = ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов);
	КомиссииДокументов.Индексы.Добавить("Ссылка");
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаДокументы = РезультатЗапроса[0].Выбрать();
	ВыборкаМатериалы = РезультатЗапроса[1].Выбрать();
	ВыборкаКомиссия = РезультатЗапроса[2].Выбрать();
	
	Отбор = Новый Структура("Ссылка");
	ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтроки");
	
	Пока ВыборкаДокументы.Следующий() Цикл
		
		СтрокаДокумент = ДанныеДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокумент, ВыборкаДокументы);
		СтрокаДокумент.Материалы = УправлениеПечатьюБГУ.ТаблицаМатериалыДляПечатиАктаСписанияМЗ0504230();
		СтрокаДокумент.СоставКомиссии = УправлениеПечатьюБГУ.ТаблицаКомиссияДляПечатиАктаСписанияМЗ0504230();
		
		СтрокаДокумент.Номер = РегистрыСведений.НастройкиПечатиПрефиксаНомера
														.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
														"АктСписанияМЗ", ВыборкаДокументы.Номер); 
		
		ДанныеДиректора = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
			ВыборкаДокументы.ДиректорСсылка, ВыборкаДокументы.Дата);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеДиректора, Истина);
		СтрокаДокумент.Директор = КорреспондентыКлиентСервер.ФИО(ДанныеДиректора, Истина);

		ДанныеЦМО = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
			ВыборкаДокументы.ЦМО, ВыборкаДокументы.Дата);
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеЦМО, Истина);
		СтрокаДокумент.МОЛ = СтрШаблон("%1 %2 %3", ДанныеЦМО.Фамилия, ДанныеЦМО.Имя, ДанныеЦМО.Отчество);
		
		ГлавныйБухгалтер = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, ВыборкаДокументы.Организация,
			ВыборкаДокументы.Дата, ВыборкаДокументы.ПодразделениеОтправитель);
		ДанныеГлБухгалтера = Справочники.Сотрудники.ДанныеСотрудника(ГлавныйБухгалтер.ОтветственноеЛицоСсылка,
			"Фамилия, Имя, Отчество", ВыборкаДокументы.Дата);
		СтрокаДокумент.ФИОГлавныйБухгалтер = КорреспондентыКлиентСервер.ФИО(ДанныеГлБухгалтера, Истина);		

		Отбор.Ссылка = ВыборкаДокументы.Ссылка;
		ОтборСтрокиДокумента.Ссылка = ВыборкаДокументы.Ссылка;
		ВыборкаМатериалы.Сбросить();
		Пока ВыборкаМатериалы.НайтиСледующий(Отбор) Цикл
			
			СтрокаМатериалы = СтрокаДокумент.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаМатериалы, ВыборкаМатериалы);
			
			ОтборСтрокиДокумента.НомерСтроки = ВыборкаМатериалы.НомерСтроки;
			СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(ОтборСтрокиДокумента);
			Если СтрокиДвижений.Количество() > 0 Тогда
				СтрокаСебестоимости = СтрокиДвижений[0];
				СтрокаМатериалы.Сумма = СтрокаСебестоимости.Сумма;
				СтрокаМатериалы.Цена = СтрокаСебестоимости.Цена;
				Если ЗначениеЗаполнено(СтрокиДвижений[0].СчетДт) Тогда
					СтрокаМатериалы.СчетДебета = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(
						СтрокиДвижений[0].КПСДт, СтрокиДвижений[0].КФО, СтрокиДвижений[0].СчетДт, СтрокиДвижений[0].КЭКДт);
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокиДвижений[0].СчетКт) Тогда
					СтрокаМатериалы.СчетКредита = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета(
						СтрокиДвижений[0].КПСКт, СтрокиДвижений[0].КФО, СтрокиДвижений[0].СчетКт, СтрокиДвижений[0].КЭККт);
				КонецЕсли;
			Иначе
				Если СтрокаМатериалы.Цена = 0 И СтрокаМатериалы.Количество <> 0 Тогда
					СтрокаМатериалы.Цена = СтрокаМатериалы.Сумма / СтрокаМатериалы.Количество;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаДокументы, "ДолжностьПредседателяКомиссии") Тогда
		
			ВыборкаКомиссия.Сбросить();
		
		Иначе
			КомиссияДокумента = КомиссииДокументов.Скопировать(Отбор);
			Если КомиссияДокумента.Количество() > 0 Тогда
				КомиссияДокумента.Сортировать("Председатель убыв, НомерСтроки");
				ПерваяСтрока = 0;
				Председатель = КомиссияДокумента[ПерваяСтрока];
				Если Председатель.Председатель Тогда
					СтрокаДокумент.ДолжностьПредседателяКомиссии = Председатель.Должность;
					СтрокаДокумент.ИмяПредседателяКомиссии = Председатель.Имя;
					СтрокаДокумент.ОтчествоПредседателяКомиссии = Председатель.Отчество;
					СтрокаДокумент.ФамилияПредседателяКомиссии = Председатель.Фамилия;
					ПерваяСтрока = ПерваяСтрока + 1;
				КонецЕсли;
				
				Для ИндексСтроки = ПерваяСтрока	По КомиссияДокумента.Количество() - 1 Цикл
					СтрокаКомиссия = СтрокаДокумент.СоставКомиссии.Добавить();
					СтрокаКомиссия.ДолжностьЧленаКомиссии = КомиссияДокумента[ИндексСтроки].Должность;
					СтрокаКомиссия.ИмяЧленаКомиссии = КомиссияДокумента[ИндексСтроки].Имя;
					СтрокаКомиссия.ОтчествоЧленаКомиссии = КомиссияДокумента[ИндексСтроки].Отчество;
					СтрокаКомиссия.ФамилияЧленаКомиссии = КомиссияДокумента[ИндексСтроки].Фамилия;
				КонецЦикла;
			
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НаименованиеВидаИмуществаПоКодуАналитическойГруппы(АналитическаяГруппа)
	Если АналитическаяГруппа = "20" Тогда
		Возврат "особо ценное";
	ИначеЕсли АналитическаяГруппа = "30" Тогда
		Возврат "иное движимое";
	ИначеЕсли АналитическаяГруппа = "50" Тогда
		Возврат "казна";
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область Корректировки

Процедура ПроверитьДокументОснованиеНеКорректировался(ПроверяемыйДокумент, ТекущийДокумент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	Документ.ПоступлениеМЗ КАК ТаблицаДокумента
	|ГДЕ
	|	ТаблицаДокумента.ДокументОснование = &ПроверяемыйДокумент
	|	И ТаблицаДокумента.ЭтоКорректировка
	|	И ТаблицаДокумента.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("ПроверяемыйДокумент", ПроверяемыйДокумент);
	Запрос.УстановитьПараметр("Ссылка", ТекущийДокумент);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ПоступлениеМЗ", ТекущийДокумент.Метаданные().ПолноеИмя());
	
	УстановитьПривилегированныйРежим(Истина);
	ЕстьКорректировка = НЕ Запрос.Выполнить().Пустой();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ЕстьКорректировка Тогда
		ТекстИсключения = НСтр("ru = 'По документу уже введена корректировка'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкиДоКорректировки(ТабличнаяЧасть, ИменаКолонокСтрокой) Экспорт
	ИменаКолонок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ИменаКолонокСтрокой);
	ИменаКолонокДоКорректировки = Новый Массив;
	Для каждого ИмяКолонки Из ИменаКолонок Цикл
		ИменаКолонокДоКорректировки.Добавить(ИмяКолонки + "ДоКорректировки");
	КонецЦикла; 
	МаксимальныйИндекс = ИменаКолонок.ВГраница();
	Для каждого Строка Из ТабличнаяЧасть Цикл
	    Для Индекс = 0 По МаксимальныйИндекс Цикл
			Строка[ИменаКолонокДоКорректировки[Индекс]] = Строка[ИменаКолонок[Индекс]];
		КонецЦикла;
	КонецЦикла; 
КонецПроцедуры

Процедура УстановитьКорректирующийДокумент(Форма) Экспорт
	
	Форма.КорректирующийДокумент = КорректирующийДокумент(Форма.Объект.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбщиеПроцедурыИФункции

Процедура ДокументПередЗаписью(Объект, РежимЗаписи, Отказ) Экспорт
	Если ПолучитьФункциональнуюОпцию("РезервироватьМЗПриВыбытии") Тогда
		РезервированиеНФА.ПередЗаписью(Объект, РежимЗаписи, Отказ);
	КонецЕсли;
КонецПроцедуры

Процедура СкопироватьТабличнуюЧастьОбъекта(Приемник, Источник, ИмяТабличнойЧасти, КопируемыеКолонки = Неопределено, КолонкиИсключения = Неопределено) Экспорт

	Приемник[ИмяТабличнойЧасти].Очистить();
	Для каждого Строка Из Источник[ИмяТабличнойЧасти] Цикл
		НоваяСтрока = Приемник[ИмяТабличнойЧасти].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, КопируемыеКолонки, КолонкиИсключения);
	КонецЦикла; 

КонецПроцедуры

Процедура ПривестиЗначенияДопСубконтоВТабличнойЧасти(ТабличнаяЧасть, Знач КэшТиповДопСубконто = Неопределено) Экспорт
	Если КэшТиповДопСубконто = Неопределено Тогда
		КэшТиповДопСубконто = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого Строка Из ТабличнаяЧасть Цикл
		ПривестиЗначениеДопСубконтоВСтроке(Строка, КэшТиповДопСубконто);
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьВидСубконтоДопАналитикиСчета(СчетУчетаМЗ) Экспорт
	
	ВидСубконтоДопАналитика = Неопределено;
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчетаМЗ);
	Для Счетчик = 1 По БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто() Цикл
		Если ЗначениеЗаполнено(СвойстваСчета["ВидСубконто" + Счетчик]) Тогда
			Если СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.Номенклатура
				И СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.ЦМО
				И СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.Партии Тогда
				
				ВидСубконтоДопАналитика = СвойстваСчета["ВидСубконто" + Счетчик];
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВидСубконтоДопАналитика;

КонецФункции

Процедура ПривестиЗначениеДопСубконтоВСтроке(Строка, КэшТиповДопСубконто) Экспорт
	
	ТипДопСубконто = КэшТиповДопСубконто.Получить(Строка.СчетУчета);
	Если ТипДопСубконто = Неопределено Тогда
		
		ВидДопСубконто = ПолучитьВидСубконтоДопАналитикиСчета(Строка.СчетУчета);
		Если ЗначениеЗаполнено(ВидДопСубконто) Тогда
			ТипДопСубконто = ВидДопСубконто.ТипЗначения;
		КонецЕсли;
		
		Если ТипДопСубконто = Неопределено Тогда
			ТипДопСубконто = Ложь;
		КонецЕсли;
		КэшТиповДопСубконто.Вставить(Строка.СчетУчета, ТипДопСубконто);
	КонецЕсли;
	
	Если ТипДопСубконто = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Строка.ДополнительнаяАналитикаСчета = ТипДопСубконто.ПривестиЗначение(Строка.ДополнительнаяАналитикаСчета);

КонецПроцедуры

Функция ПолучитьДанныеСчетаУчетаНоменклатуры(Параметры) Экспорт

	Результат = Новый Структура("ДанныеСчетов, Счет, КЭК");
	
	ПараметрыДанныхСчетов = ПараметрыДанныхСчетовУчетаМЗ(Параметры.Организация, Параметры.ТолькоБалансовые);
	ЗаполнитьЗначенияСвойств(ПараметрыДанныхСчетов, Параметры);
	ПараметрыДанныхСчетов.ДатаСчета = Параметры.Дата;
	Результат.ДанныеСчетов = ДанныеСчетовУчетаМЗ(ПараметрыДанныхСчетов);
	
	СчетУчета = Неопределено;
	Если Параметры.ЗаполнятьСчет Тогда
		СчетУчета = СчетУчетаНоменклатуры(Параметры.Номенклатура, Параметры.Организация, Параметры.ИФО,
			Параметры.КФО, Параметры.Дата, Параметры.ДтКт);
	Иначе
		СчетУчета = Параметры.Счет;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Номенклатура) Тогда
		ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Номенклатура, "ТипНоменклатуры");
	Иначе
		ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	
	Результат.Счет = СчетУчета;
	Результат.КЭК  = БухгалтерскийУчет.КЭКНоменклатуры(Параметры.Организация, Параметры.ИФО, Параметры.КФО,
		Параметры.Дата, СчетУчета, ТипНоменклатуры, Параметры.ДтКт);
	
	Возврат Результат;

КонецФункции

Функция ЭтоТипНоменклатурыСОсобымКЭК(ТипНоменклатуры) Экспорт
	Возврат ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БСО");
КонецФункции

Функция КЭКПоТипуНоменклатуры(ТипНоменклатуры, ДтКт) Экспорт
	Если ДтКт = "Дт" Тогда
		КодКОСГУ = "340";
	Иначе
		КодКОСГУ = "440";
	КонецЕсли;
	КодСтатьи = УправлениеМатериальнымиЗапасамиКлиентСервер.КодСтатьиКОСГУПоТипуНоменклатуры(ТипНоменклатуры);
	Если КодСтатьи = "0" Тогда
		Возврат ПредопределенноеЗначение(Справочники.КОСГУ.ПустаяСсылка());
	КонецЕсли;
	Возврат БухгалтерскийУчетПовтИсп.КЭКПоКоду(Лев(КодКОСГУ, 2) + КодСтатьи);
КонецФункции


// Возвращает счет учета номенклатуры по коду, указанному в справочнике Номенклатура.
// Если указан код группы, то возвращается первый подчиненный элемент (не группа), у которого есть субконто Номенклатура.
// Если счет по коду не найден, возвращается пустая ссылка.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - 
//  Организация	 - Неопределено - не используется
//  ИФО			 - Неопределено - не используется
//  КФО			 - Неопределено - не используется
//  Дата		 - Дата - Дата получения счета
//  ДтКт		 - Неопределено - не используется
// 
// Возвращаемое значение:
// ПланСчетовСсылка.ЕПСБУ - 
//
Функция СчетУчетаНоменклатуры(Знач Номенклатура, Знач Организация = Неопределено, Знач ИФО = Неопределено, Знач КФО = Неопределено, Знач Дата, Знач ДтКт = Неопределено)
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	Номенклатура.ТипНоменклатуры,
	|	ЕПСБУ.Ссылка КАК СчетУчета,
	|	ЕстьNULL(ЕПСБУ.ЭлементГруппа, Ложь) КАК ЭлементГруппа
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО Номенклатура.СчетУчета = ЕПСБУ.Код
	|		И ЕПСБУ.ПометкаУдаления = ЛОЖЬ
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка
	|	И (&ДатаСчета = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ (ЕПСБУ.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ЕПСБУ.ДатаНачалаДействия <= &ДатаСчета)
	|			И (ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ ЕПСБУ.ДатаОкончанияДействия >= &ДатаСчета))";
	Запрос.УстановитьПараметр("Ссылка", Номенклатура);
	Запрос.УстановитьПараметр("ДатаСчета", Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Если НЕ Выборка.ЭлементГруппа Тогда
		Возврат Выборка.СчетУчета;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&Ссылка)
	|	И ЕПСБУ.ПометкаУдаления = ЛОЖЬ
	|	И ЕПСБУ.ЗапретитьИспользоватьВПроводках = ЛОЖЬ
	|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	|	И (&ДатаСчета = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ (ЕПСБУ.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ ЕПСБУ.ДатаНачалаДействия <= &ДатаСчета)
	|				И (ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ЕПСБУ.ДатаОкончанияДействия >= &ДатаСчета))
	|	И ЕПСБУВидыСубконто.ВидСубконто = &ВидСубконто
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕПСБУ.Порядок";
	Запрос.УстановитьПараметр("Ссылка", Выборка.СчетУчета);
	Запрос.УстановитьПараметр("ДатаСчета", Дата);
	Запрос.УстановитьПараметр("ВидСубконто", ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	
	ВыборкаСчет = Запрос.Выполнить().Выбрать();
	Если ВыборкаСчет.Следующий() Тогда
		Возврат ВыборкаСчет.Ссылка;
	Иначе
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

// Функция возвращает ссылку на счет учета, установленный в карточке номенклатуры.
// Если дата не задана, используется текущая дата пользователя.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - 
//  ДатаСчета	 - Неопределено, Дата - если не задана, используется текущая дата пользователя
// 
// Возвращаемое значение:
// ПланСчетовСсылка.ЕПСБУ - 
//
Функция СчетУчетаСсылкаИзНоменклатуры(Номенклатура, Знач ДатаСчета = Неопределено) Экспорт
	Если ДатаСчета = Неопределено Тогда
		ДатаСчета = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	Возврат СчетУчетаНоменклатуры(Номенклатура, , , , ДатаСчета);
КонецФункции	

Процедура ПроверитьОчиститьКолонкуКПС(ТаблицаОбъекта) Экспорт

	Для каждого ТекСтрока Из ТаблицаОбъекта Цикл
	
		Если (НЕ ЗначениеЗаполнено(ТекСтрока.СчетУчета) ИЛИ БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекСтрока.СчетУчета).УчетПоКПС <> ИСТИНА)
			И ЗначениеЗаполнено(ТекСтрока.КПС) Тогда
			
			ТекСтрока.КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры

Процедура ПроверитьЗаполнениеКолонкиКПСВТаблицеМатериалов(Объект, ИмяТаблицы, ПредставлениеТаблицы, Отказ) Экспорт

	Для каждого ТекСтрока Из Объект[ИмяТаблицы] Цикл
	
		Если ЗначениеЗаполнено(ТекСтрока.СчетУчета)
			И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекСтрока.СчетУчета).УчетПоКПС = ИСТИНА
			И НЕ ЗначениеЗаполнено(ТекСтрока.КПС) Тогда
				
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'КПС'"), ТекСтрока.НомерСтроки, ПредставлениеТаблицы);
			ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТаблицы, ТекСтрока.НомерСтроки, "КПС");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПутьКПолю, ,Отказ);
			
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры

// Устанавливает условное оформление колонок "ДополнительнаяАналитикаСчета", "КПС", "КЭК".
// Колонка КЭК может отсутствовать, в этом случае на нее не устанавливается УО.
// Если параметр "ИспользуетсяКЭКАвто" = Истина, то дополнительно устанавливается УО "<Авто>", для пустого КЭК.
//
// Параметры:
//  Форма				 - ФормаКлиентскогоПриложения - вызывающая форма
//  ИмяТаблицы			 - Строка - имя элемента формы
//  ИспользуетсяКЭКАвто	 - Булево - добавлять условное оформление КЭК "<Авто>"
//
Процедура УстановитьУсловноеОформлениеСпискаМатериалов(Форма, ИмяТаблицы = "Материалы", ИспользуетсяКЭКАвто = Ложь, ИспользуетсяДопСубконто3 = Ложь) Экспорт
	ПараметрыУстановки = ПараметрыУстановкиУсловногоОформленияСпискаМатериалов();
	ПараметрыУстановки.ИмяТаблицы = ИмяТаблицы;
	ПараметрыУстановки.ИспользуетсяКЭКАвто = ИспользуетсяКЭКАвто;
	ПараметрыУстановки.ИспользуетсяДопСубконто3 = ИспользуетсяДопСубконто3;
	УстановитьУсловноеОформлениеСпискаМатериаловПоПараметрам(Форма, ПараметрыУстановки);
КонецПроцедуры

// Конструктор параметров для процедуры УстановитьУсловноеОформлениеСпискаМатериаловПоПараметрам
// 
// Возвращаемое значение:
// Структура:
//  * ИмяТаблицы - Строка
//  * ИспользуетсяКЭКАвто - Булево
//  * ИспользуетсяДопСубконто3 - Булево
//  * ИмяКолонкиУчетПоКЭК - Строка
//
Функция ПараметрыУстановкиУсловногоОформленияСпискаМатериалов() Экспорт
	ПараметрыУстановки = Новый Структура;
	ПараметрыУстановки.Вставить("ИмяТаблицы", "Материалы");
	ПараметрыУстановки.Вставить("ИспользуетсяКЭКАвто", Ложь);
	ПараметрыУстановки.Вставить("ИспользуетсяДопСубконто3", Ложь);
	ПараметрыУстановки.Вставить("ИмяКолонкиУчетПоКЭК", "");
	Возврат ПараметрыУстановки;
КонецФункции

// Устанавливает условное оформление колонок "ДополнительнаяАналитикаСчета", "КПС", "КЭК".
// Колонка КЭК может отсутствовать, в этом случае на нее не устанавливается УО.
// Если ПараметрыУстановки.ИспользуетсяКЭКАвто = Истина, то дополнительно устанавливается УО "<Авто>", для пустого КЭК.
//
// Параметры:
//  Форма				 - ФормаКлиентскогоПриложения - вызывающая форма
//  ПараметрыУстановки	 - см. ПараметрыУстановкиУсловногоОформленияСпискаМатериалов
//
Процедура УстановитьУсловноеОформлениеСпискаМатериаловПоПараметрам(Форма, ПараметрыУстановки) Экспорт
	
	ИмяТаблицы = ПараметрыУстановки.ИмяТаблицы;
	
	ЕстьПолеКЭК = Форма.Элементы.Найти(ИмяТаблицы + "КЭК") <> Неопределено;
	ДобавлятьОформлениеКЭКАвто = ЕстьПолеКЭК И ПараметрыУстановки.ИспользуетсяКЭКАвто;
	ЕстьКолонкаУчетПоКЭК = ЕстьПолеКЭК И ЗначениеЗаполнено(ПараметрыУстановки.ИмяКолонкиУчетПоКЭК);
	
	УсловноеОформление = Форма.УсловноеОформление.Элементы;
	ЦветТекста = Метаданные.ЭлементыСтиля.НедоступныеДанныеЦвет.Значение;
	
	Элемент = УсловноеОформление.Добавить();
	Элемент.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект." + ИмяТаблицы + ".ЕстьДополнительноеСубконто", Ложь, ВидСравненияКомпоновкиДанных.Равно);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		ЦветТекста);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",				"<не используется>");
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "ДополнительнаяАналитикаСчета");
	Поле.Использование = Истина;
	
	Если ПараметрыУстановки.ИспользуетсяДопСубконто3 Тогда
		Элемент = УсловноеОформление.Добавить();
		Элемент.Использование = Истина;
		ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Элемент.Отбор.Элементы,
			"ГруппаОтбораЭлементыДопСубконто3", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора,
			"Объект." + ИмяТаблицы + ".ЕстьДополнительноеСубконто3", Ложь, ВидСравненияКомпоновкиДанных.Равно);
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,
				"ДополнительноеСубконто27ВидСубконто") Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора,
				"ДополнительноеСубконто27ВидСубконто",
				,
				ВидСравненияКомпоновкиДанных.НеЗаполнено);
		КонецЕсли;
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		ЦветТекста);
		Элемент.Оформление.УстановитьЗначениеПараметра("Текст",				"<не используется>");
		Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
		Поле = Элемент.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "ДополнительноеСубконтоСчета");
		Поле.Использование = Истина;
	КонецЕсли;
	
	Элемент = УсловноеОформление.Добавить();
	Элемент.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект." + ИмяТаблицы + ".УчетПоКПС", Ложь, ВидСравненияКомпоновкиДанных.Равно);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		ЦветТекста);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",				"<не используется>");
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "КПС");
	Поле.Использование = Истина;
	
	Если ЕстьПолеКЭК <> Неопределено И Не ЕстьКолонкаУчетПоКЭК Тогда
		Поле = Элемент.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "КЭК");
		Поле.Использование = Истина;
	КонецЕсли;
	
	Если ЕстьКолонкаУчетПоКЭК Тогда
		Элемент = УсловноеОформление.Добавить();
		Элемент.Использование = Истина;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
			"Объект." + ИмяТаблицы + "." + ПараметрыУстановки.ИмяКолонкиУчетПоКЭК,
			Ложь,
			ВидСравненияКомпоновкиДанных.Равно);
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		ЦветТекста);
		Элемент.Оформление.УстановитьЗначениеПараметра("Текст",				"<не используется>");
		Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
		Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
		Поле = Элемент.Поля.Элементы.Добавить();
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "КЭК");
		Поле.Использование = Истина;
	КонецЕсли;
	
	Если ДобавлятьОформлениеКЭКАвто Тогда
		
		Если ЕстьКолонкаУчетПоКЭК Тогда
			ПроверяемаяКолонка = ПараметрыУстановки.ИмяКолонкиУчетПоКЭК;
		Иначе
			ПроверяемаяКолонка = "УчетПоКПС";
		КонецЕсли;
		Элемент = СоздатьЭлементУсловногоОформленияПоляКЭК(УсловноеОформление, ИмяТаблицы + "КЭК");
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
			СтрШаблон("Объект.%1.%2", ИмяТаблицы, ПроверяемаяКолонка),
			Истина,
			ВидСравненияКомпоновкиДанных.Равно);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
			"Объект." + ИмяТаблицы + ".КЭК",, ВидСравненияКомпоновкиДанных.НеЗаполнено);
		
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает условное оформление колонки "КЭК" при не заполненном значении
//
// Параметры:
//  УсловноеОформление	 -  УсловноеОформлениеКомпоновкиДанных - условное оформление формы
//  ИмяЭлемента			 - Строка - имя оформляемого элемента формы (колонки таблицы)
//  ИмяТабличнойЧасти	 - Строка - имя элемента формы
//  ИмяРеквизитаКЭК		 - Строка - имя реквизита таблицы объекта
//  ИмяРеквизитаСчет	 - Строка - имя реквизита таблицы объекта
//  Текст				 - Строка - текст для пустого КЭК
//
Процедура УстановитьУсловноеОформлениеПоляКЭК(УсловноеОформление, ИмяЭлемента, ИмяТабличнойЧасти, ИмяРеквизитаКЭК, ИмяРеквизитаСчет, Текст = "") Экспорт
	
	Элемент = СоздатьЭлементУсловногоОформленияПоляКЭК(УсловноеОформление.Элементы, ИмяЭлемента, Текст);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор, "Объект." + ИмяТабличнойЧасти + "." + ИмяРеквизитаКЭК,,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор, "Объект." + ИмяТабличнойЧасти + "." + ИмяРеквизитаСчет,,
		ВидСравненияКомпоновкиДанных.Заполнено);
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеПоляСтавкаНДС(Форма, ИмяТаблицы) Экспорт

	УсловноеОформление = Форма.УсловноеОформление.Элементы;
	ЦветТекста = Метаданные.ЭлементыСтиля.НедоступныеДанныеЦвет.Значение;
	
	Элемент = УсловноеОформление.Добавить();
	Элемент.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор, "Объект.РеализацияПоСтавке0", Истина, ВидСравненияКомпоновкиДанных.Равно);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		ЦветТекста);
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "СтавкаНДС");
	Поле.Использование = Истина;
	
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "СуммаНДС");
	Поле.Использование = Истина;

КонецПроцедуры

Процедура УстановитьОграниченияСчетовДляВыбораТары(Элемент) Экспорт

	МассивСчетов = Новый Массив;
	Если ЗначениеЗаполнено(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.26")) Тогда
		МассивСчетов.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.26"));
	КонецЕсли;
	Если ЗначениеЗаполнено(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.36")) Тогда
		МассивСчетов.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.36"));
	КонецЕсли;
	Если ЗначениеЗаполнено(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.46")) Тогда
		МассивСчетов.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.46"));
	КонецЕсли;
	Если МассивСчетов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Новый ПараметрВыбора("ОграниченияСписокСчетов", Новый ФиксированныйМассив(МассивСчетов)));
	Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);

КонецПроцедуры

Процедура ОтключитьВидимостьКолонкиДопСубконто(Элемент, СчетаДокумента) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоНоменклатура
	|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУВидыСубконтоНоменклатура.Ссылка
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&Ссылка)
	|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	|	И ЕПСБУВидыСубконтоНоменклатура.ВидСубконто = ЗНАЧЕНИЕ(ПланВИдовХарактеристик.ВидыСубконто.Номенклатура)
	|	И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВИдовХарактеристик.ВидыСубконто.Номенклатура)
	|	И ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВИдовХарактеристик.ВидыСубконто.ЦМО)
	|	И (ЕПСБУВидыСубконто.ВидСубконто <> ЗНАЧЕНИЕ(ПланВИдовХарактеристик.ВидыСубконто.Партии)
	|			ИЛИ ЕПСБУВидыСубконто.Обязательный
	|				И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВИдовХарактеристик.ВидыСубконто.Партии))";
	Запрос.УстановитьПараметр("Ссылка", СчетаДокумента);
	Элемент.Видимость = НЕ Запрос.Выполнить().Пустой();

КонецПроцедуры

Процедура ЗаполнитьКПСвТабличнойЧастиДокументаМЗ(ТабличнаяЧасть, Объект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(МатериалыДокумента.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	               |	ВЫРАЗИТЬ(МатериалыДокумента.СчетУчета КАК ПланСчетов.ЕПСБУ) КАК СчетУчета
	               |ПОМЕСТИТЬ МатериалыДокумента
	               |ИЗ
	               |	&МатериалыДокумента КАК МатериалыДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.Счет,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК Количество
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			Счет В
	               |				(ВЫБРАТЬ
	               |					МатериалыДокумента.СчетУчета
	               |				ИЗ
	               |					МатериалыДокумента КАК МатериалыДокумента),
	               |			,
	               |			Организация = &Организация
	               |				И (НЕ &ИспользоватьУчетПоИФО
	               |					ИЛИ ИФО = &ИФО)
	               |				И КФО = &КФО
	               |				И Субконто1 В
	               |					(ВЫБРАТЬ
	               |						МатериалыДокумента.Номенклатура
	               |					ИЗ
	               |						МатериалыДокумента КАК МатериалыДокумента)
	               |				И (НЕ &ИспользоватьУчетПоПодразделениям
	               |					ИЛИ Подразделение = &Подразделение)
	               |				И Субконто2 = &ЦМО) КАК ЖурналПроводокЕПСБУОстатки";
	Запрос.УстановитьПараметр("МатериалыДокумента", ТабличнаяЧасть.Выгрузить(,"Номенклатура, СчетУчета"));			   
	Если Объект.Ссылка.Пустая() Тогда
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Иначе
		Запрос.УстановитьПараметр("Период", Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	КонецЕсли;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
	Запрос.УстановитьПараметр("КФО", Объект.КФО);
	МетаданныеДокумента = Объект.Ссылка.Метаданные();
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ЦМО", МетаданныеДокумента) Тогда
		Запрос.УстановитьПараметр("ЦМО", Объект.ЦМО);
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ЦМООтправитель", МетаданныеДокумента) Тогда
		Запрос.УстановитьПараметр("ЦМО", Объект.ЦМООтправитель);
	Иначе
		Возврат;
	КонецЕсли;
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Подразделение", МетаданныеДокумента) Тогда
		Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ПодразделениеОтправитель", МетаданныеДокумента) Тогда
		Запрос.УстановитьПараметр("Подразделение", Объект.ПодразделениеОтправитель);
	Иначе
		Возврат;
	КонецЕсли;
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
																И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("105.00").УчетПоПодразделениям);
				   
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();				   
	Для каждого ТекСтрока Из ТабличнаяЧасть Цикл
	
		СтруктураПоиска = Новый Структура("Счет, Номенклатура, КПС", ТекСтрока.СчетУчета, ТекСтрока.Номенклатура, ТекСтрока.КПС);	
		СтрокиОстатков = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
		НеМенятьКПС = Ложь;
		Для каждого ТекСтрокаОстатков Из СтрокиОстатков Цикл
			Если ТекСтрокаОстатков.Количество >= ТекСтрока.Количество Тогда
				НеМенятьКПС = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НеМенятьКПС Тогда
			Продолжить;
		КонецЕсли;
		
		ТекСтрока.КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
		СтруктураПоиска.Удалить("КПС");	
		СтрокиОстатков = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
		Для каждого ТекСтрокаОстатков Из СтрокиОстатков Цикл
		
			Если ТекСтрокаОстатков.Количество >= ТекСтрока.Количество Тогда
				ТекСтрока.КПС = ТекСтрокаОстатков.КПС;
				Прервать;
			КонецЕсли;
		
		КонецЦикла; 
	
	КонецЦикла; 
	

КонецПроцедуры

Процедура ЗаполнитьКФОКПСвТабличнойЧастиДокументаМЗ(ТабличнаяЧасть, Объект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(МатериалыДокумента.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	               |	ВЫРАЗИТЬ(МатериалыДокумента.СчетУчета КАК ПланСчетов.ЕПСБУ) КАК СчетУчета
	               |ПОМЕСТИТЬ МатериалыДокумента
	               |ИЗ
	               |	&МатериалыДокумента КАК МатериалыДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.Счет,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
				   |	ЖурналПроводокЕПСБУОстатки.КФО,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК Количество
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			Счет В
	               |				(ВЫБРАТЬ
	               |					МатериалыДокумента.СчетУчета
	               |				ИЗ
	               |					МатериалыДокумента КАК МатериалыДокумента),
	               |			,
	               |			Организация = &Организация
	               |				И (НЕ &ИспользоватьУчетПоИФО
	               |					ИЛИ ИФО = &ИФО)
	               |				И Субконто1 В
	               |					(ВЫБРАТЬ
	               |						МатериалыДокумента.Номенклатура
	               |					ИЗ
	               |						МатериалыДокумента КАК МатериалыДокумента)
	               |				И (НЕ &ИспользоватьУчетПоПодразделениям
	               |					ИЛИ Подразделение = &Подразделение)
	               |				И Субконто2 = &ЦМО) КАК ЖурналПроводокЕПСБУОстатки";
	Запрос.УстановитьПараметр("МатериалыДокумента", ТабличнаяЧасть.Выгрузить(,"Номенклатура, СчетУчета"));			   
	Если Объект.Ссылка.Пустая() Тогда
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Иначе
		Запрос.УстановитьПараметр("Период", Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	КонецЕсли;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ИФО", Объект.ИФО);

	МетаданныеДокумента = Объект.Ссылка.Метаданные();
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ЦМО", МетаданныеДокумента) Тогда
		Запрос.УстановитьПараметр("ЦМО", Объект.ЦМО);
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ЦМООтправитель", МетаданныеДокумента) Тогда
		Запрос.УстановитьПараметр("ЦМО", Объект.ЦМООтправитель);
	Иначе
		Возврат;
	КонецЕсли;
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Подразделение", МетаданныеДокумента) Тогда
		Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ПодразделениеОтправитель", МетаданныеДокумента) Тогда
		Запрос.УстановитьПараметр("Подразделение", Объект.ПодразделениеОтправитель);
	Иначе
		Возврат;
	КонецЕсли;
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
																И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("105.00").УчетПоПодразделениям);
				   
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();				   
	Для каждого ТекСтрока Из ТабличнаяЧасть Цикл
	
		СтруктураПоиска = Новый Структура("Счет, Номенклатура, КПС, КФО", ТекСтрока.СчетУчета, ТекСтрока.Номенклатура, ТекСтрока.КПС, ТекСтрока.КФО);	
		СтрокиОстатков = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
		НеМенять = Ложь;
		Для каждого ТекСтрокаОстатков Из СтрокиОстатков Цикл
			Если ТекСтрокаОстатков.Количество >= ТекСтрока.Количество Тогда
				НеМенять = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НеМенять Тогда
			Продолжить;
		КонецЕсли;
		
		ТекСтрока.КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
		СтруктураПоиска.Удалить("КПС");
		СтруктураПоиска.Удалить("КФО");
		СтрокиОстатков = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
		Для каждого ТекСтрокаОстатков Из СтрокиОстатков Цикл
		
			Если ТекСтрокаОстатков.Количество >= ТекСтрока.Количество Тогда
				ТекСтрока.КПС = ТекСтрокаОстатков.КПС;
				ТекСтрока.КФО = ТекСтрокаОстатков.КФО;
				Прервать;
			КонецЕсли;
		
		КонецЦикла; 
	
	КонецЦикла; 
	

КонецПроцедуры

// Заполняет список счетов группы 105 в реквизит формы "ВсеСчета105".
// Заполняются только счета имеющие субконто "Номенклатура", кроме счетов 105.28,105.38 (в иерархии).
// 
// Параметры:
//  Форма - КлиентскоеПриложение:
//  * ВсеСчета105 - СписокЗначений из ПланСчетовСсылка.ЕПСБУ
Процедура ЗаполнитьСчетаУчетаМЗ105(Форма) Экспорт

	Включать113 = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ВсеСчета113"); 
	Включать106 = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ВсеСчета106"); 
	
	Включать0233 = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Счет0233");
	ВестиУчетПоКомиссионнойРеализации = ПолучитьФункциональнуюОпцию("ВестиУчетПоРеализацииТоваровУслугКомитентов");
	
	
	Запрос = Новый Запрос;
	// в запрос добавляются родители 1 и 2 уровней, чтобы при типовой настройке плана счетов при выборе были видны группы счетов 105
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.Родитель КАК Родитель,
	|	""105"" КАК КодСчета
	|ПОМЕСТИТЬ КонечныеСчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
	|		И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
	|ГДЕ
	|	ЕПСБУ.Ссылка В (&Счет105)
	|	И НЕ ЕПСБУ.Ссылка В (&СчетаТовары)
	|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	ЕПСБУ.Родитель.Родитель,
	|	""105"" КАК КодСчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
	|		И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
	|ГДЕ
	|	ЕПСБУ.Ссылка В (&СчетаТовары)
	|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ";
	Если Включать113 Тогда
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ") +
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка,
		|	ЕПСБУ.Родитель КАК Родитель,
		|	""113""
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
		|		И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
		|ГДЕ
		|	ЕПСБУ.Ссылка В (&Счет113)
		|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ";
	КонецЕсли;
	Если Включать106 Тогда
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ") +
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка,
		|	ЕПСБУ.Родитель КАК Родитель,
		|	""106""
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
		|		И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
		|ГДЕ
		|	ЕПСБУ.Ссылка В (&Счет106)
		|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ";
	КонецЕсли;
	
	Если Включать0233 И ВестиУчетПоКомиссионнойРеализации Тогда
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ") +
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка,
		|	ЕПСБУ.Родитель КАК Родитель,
		|	""0233""
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
		|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
		|ГДЕ
		|	ЕПСБУ.Ссылка = &Счет0233
		|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ"
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	КонечныеСчета.Ссылка КАК Ссылка,
	|	КонечныеСчета.КодСчета
	|ИЗ
	|	КонечныеСчета КАК КонечныеСчета
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	КонечныеСчета.Родитель,
	|	КонечныеСчета.КодСчета
	|ИЗ
	|	КонечныеСчета КАК КонечныеСчета
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Родитель,
	|	КонечныеСчета.КодСчета
	|ИЗ
	|	КонечныеСчета КАК КонечныеСчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО КонечныеСчета.Родитель = ЕПСБУ.Ссылка
	|ГДЕ
	|	ЕПСБУ.Родитель <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)";
	
	Если ЗначениеЗаполнено(Форма.Объект.Дата) Тогда
		ДатаСчетов = Форма.Объект.Дата;
	Иначе
		ДатаСчетов = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	Организация = Форма.Объект.Организация;
	
	Если Включать113 Тогда
		Запрос.УстановитьПараметр("Счет113"		, БухгалтерскийУчет.СписокСчетов("113.00", ДатаСчетов, , Организация));
	КонецЕсли;
	Если Включать106 Тогда
		Запрос.УстановитьПараметр("Счет106"		, БухгалтерскийУчет.СписокСчетов("106.00", ДатаСчетов, , Организация));
	КонецЕсли;
	
	Если Включать0233 И ВестиУчетПоКомиссионнойРеализации Тогда
		Запрос.УстановитьПараметр("Счет0233", БухгалтерскийУчет.СчетПоКоду("02.33", ДатаСчетов, Организация));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Счет105"		, БухгалтерскийУчет.СписокСчетов("105.00", ДатаСчетов, , Организация));
	Запрос.УстановитьПараметр("СчетаТовары"	, БухгалтерскийУчет.СписокСчетов("105.28,105.38", ДатаСчетов, , Организация));
	
	Счета105 = Новый Массив;
	Счета106 = Новый Массив;
	Счета113 = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.КодСчета = "105"  ИЛИ Выборка.КодСчета = "0233" Тогда
			Счета105.Добавить(Выборка.Ссылка);
		ИначеЕсли Выборка.КодСчета = "106" Тогда
			Счета106.Добавить(Выборка.Ссылка);
		ИначеЕсли Выборка.КодСчета = "113" Тогда
			Счета113.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Форма.ВсеСчета105.ЗагрузитьЗначения(Счета105);
	Если Включать113 Тогда
		Форма.ВсеСчета113.ЗагрузитьЗначения(Счета113);
	КонецЕсли;
	Если Включать106 Тогда
		Форма.ВсеСчета106.ЗагрузитьЗначения(Счета106);
	КонецЕсли;

КонецПроцедуры

// Параметры данных счетов учета МЗ.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ТолькоБалансовые - Булево
// 
// Возвращаемое значение:
//  Структура -  Параметры данных счетов учета МЗ:
// * Включать105 - Булево - 
// * Включать106 - Булево - 
// * Включать106ИК - Булево - 
// * Включать108 - Булево - 
// * Включать113 - Булево - 
// * ДатаСчета - Дата - 
// * Организация - СправочникСсылка.Организации
// * ТолькоБалансовые - Булево
// * ТолькоБалансовыеИК - Булево
Функция ПараметрыДанныхСчетовУчетаМЗ(Организация, ТолькоБалансовые) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Включать105", Истина);
	Результат.Вставить("Включать106", Ложь);
	Результат.Вставить("Включать106ИК", Ложь);
	Результат.Вставить("Включать108", Ложь);
	Результат.Вставить("Включать113", Ложь);
	Результат.Вставить("Включать0233", Ложь);
	Результат.Вставить("Включать0234", Ложь);
	Результат.Вставить("ВключатьСчетТПР", Ложь);
	Результат.Вставить("ДатаСчета", '00010101');
	Результат.Вставить("Организация", Организация);
	Результат.Вставить("ТолькоБалансовые", ТолькоБалансовые);
	Результат.Вставить("ТолькоБалансовыеИК", Истина);
	Возврат Результат;
КонецФункции

// Данные счета учета МЗ.
// 
// Возвращаемое значение:
//  Структура - Данные счета учета МЗ:
// * Код - Строка
// * Наименование - Строка
// * ДополнительноеСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто
// * Счет - ПланСчетовСсылка.ЕПСБУ
// * ТекущийСчет - ПланСчетовСсылка.ЕПСБУ
// * УчетПоКПС - Булево
// * УчетПоКЭК - Булево
// * НомерСубконтоЦМО - Число
Функция ДанныеСчетаУчетаМЗ()
		ДанныеСчета = Новый Структура;
		ДанныеСчета.Вставить("Код", "");
		ДанныеСчета.Вставить("Наименование", "");
		ДанныеСчета.Вставить("ДополнительноеСубконто", ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка()); 
		ДанныеСчета.Вставить("ДополнительноеСубконто3", ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
		ДанныеСчета.Вставить("Счет", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
		ДанныеСчета.Вставить("ТекущийСчет", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
		ДанныеСчета.Вставить("УчетПоКПС", Ложь);
		ДанныеСчета.Вставить("УчетПоКЭК", Ложь);
		ДанныеСчета.Вставить("НомерСубконтоЦМО", 0);
		ДанныеСчета.Вставить("НомерСубконтоКонтрагенты", 0);
		Возврат ДанныеСчета;
КонецФункции

// Получить данные счетов учета МЗ.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  СписокВыбора - СписокЗначений 
//  ТолькоБалансовые - Булево
//  Включать106 - Булево
//  ДатаСчета - Дата
// 
// Возвращаемое значение:
//  Соответствие из см. ДанныеСчетовУчетаМЗ:
//  * Ключ - ПланСчетовСсылка.ЕПСБУ
//  * Значение - Структура: см. ДанныеСчетовУчетаМЗ
Функция ПолучитьДанныеСчетовУчетаМЗ(Организация, Знач СписокВыбора = Неопределено, ТолькоБалансовые = Ложь, Включать106 = Ложь, ДатаСчета = '00010101') Экспорт

	Если СписокВыбора = Неопределено Тогда
		СписокВыбора = Новый СписокЗначений;
	Иначе
		СписокВыбора.Очистить();
	КонецЕсли;
	
	ВидыСубконтоСчетов = Новый Соответствие;
	ПараметрыДанныхСчетов = ПараметрыДанныхСчетовУчетаМЗ(Организация, ТолькоБалансовые);
	ПараметрыДанныхСчетов.Включать106 = Включать106;
	ПараметрыДанныхСчетов.ДатаСчета = ДатаСчета;
	ДанныеСчетов = СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов);
	Для каждого ТекДанныеСчета Из ДанныеСчетов Цикл
		Если СписокВыбора.НайтиПоЗначению(ТекДанныеСчета.Счет) = Неопределено Тогда
			СписокВыбора.Добавить(ТекДанныеСчета.Счет, "" + ТекДанныеСчета.Код + ". " + ТекДанныеСчета.Наименование);
		КонецЕсли;
		Если ТекДанныеСчета.ДополнительноеСубконто <> Неопределено Тогда
			ВидыСубконтоСчетов.Вставить(ТекДанныеСчета.ТекущийСчет, ТекДанныеСчета.ДополнительноеСубконто);
		КонецЕсли;
	КонецЦикла; 
	
	Возврат ВидыСубконтоСчетов;

КонецФункции // ПолучитьДанныеСчетовУчетаМЗ()

// Параметры заполнения данных счетов учета МЗВФорме.
// 
// Возвращаемое значение:
//  Структура - Параметры заполнения данных счетов учета МЗ в форме:
// * Организация - СправочникСсылка.Организации -
// * ТолькоБалансовые - Булево - По-умолчанию "Ложь"
// * ТолькоБалансовыеИК - Булево - По-умолчанию "Истина"
// * Включать105 - Булево - По-умолчанию "Истина"
// * Включать106 - Булево - По-умолчанию "Ложь"
// * Включать106ИК - Булево - По-умолчанию "Ложь"
// * Включать108 - Булево - По-умолчанию "Ложь"
// * Включать113 - Булево - По-умолчанию "Ложь"
// * ДатаСчета - Дата -
// * СписокВыбора - СписокЗначений -
// * ВидыСубконтоСчетов - Соответствие -
Функция ПараметрыЗаполненияДанныхСчетовУчетаМЗВФорме() Экспорт
	Результат = Новый Структура;
	
	Результат.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Результат.Вставить("ТолькоБалансовые", Ложь);
	Результат.Вставить("ТолькоБалансовыеИК", Истина);
	Результат.Вставить("Включать105", Истина);
	Результат.Вставить("Включать106", Ложь);
	Результат.Вставить("Включать106ИК", Ложь);
	Результат.Вставить("Включать108", Ложь);
	Результат.Вставить("Включать113", Ложь);
	Результат.Вставить("Включать0233", Ложь);
	Результат.Вставить("Включать0234", Ложь);
	Результат.Вставить("ДатаСчета", '00010101');
	Результат.Вставить("СписокВыбора", Новый СписокЗначений);
	Результат.Вставить("ВидыСубконтоСчетов", Новый Соответствие);
	
	Возврат Результат;
КонецФункции

// Поступление доп.расходов, включаемых в стоимость материальных запасов
// 
// Параметры:
//  ДатаФормирования - Дата
//  Партия - ДокументСсылка
//  БазаРаспределения - ПеречислениеСсылка.БазыРаспределенияДополнительныхРасходов
//  СчетУчета - ПланСчетовСсылка.ЕПСБУ
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Сформировать базу распределения расходов на партию
Функция СформироватьБазуРаспределенияРасходовНаПартию(ДатаФормирования, Партия, БазаРаспределения, СчетУчета) Экспорт 
	
	Если Не ЗначениеЗаполнено(БазаРаспределения) Тогда
		ВызватьИсключение "Не выбрана база распределения";
	КонецЕсли;
	 
	Если БазаРаспределения = Перечисления.БазыРаспределенияДополнительныхРасходов.КоличествоМест
		И ТипЗнч(Партия) <> Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		ВызватьИсключение "База распределения ""Количество мест"" может использоваться только если партия оформлена документом ""Поступление МЗ""";
	КонецЕсли;
	
	Если БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(СчетУчета, ПланыВидовХарактеристик.ВидыСубконто.Партии) Тогда
		Возврат БазаРаспределенияРасходовНаОстаткиПартии(ДатаФормирования, Партия, БазаРаспределения, СчетУчета);
	ИначеЕсли ТипЗнч(Партия) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		Возврат БазаРаспределенияРасходовНаСоставПартии(Партия, БазаРаспределения);
	Иначе
		Возврат БазаРаспределенияРасходовНаДвиженияПартии(Партия, БазаРаспределения, СчетУчета);
	КонецЕсли;
	
КонецФункции

// База распределения расходов на состав партии - вычисляется по составу документа "Поступление МЗ".
// 
// Параметры:
//  Партия - ДокументСсылка.ПоступлениеМЗ - Партия
//  БазаРаспределения - ПеречислениеСсылка, ПеречислениеСсылка.БазыРаспределенияДополнительныхРасходов - База распределения
// 
// Возвращаемое значение:
//  ТаблицаЗначений - База распределения расходов на состав партии
Функция БазаРаспределенияРасходовНаСоставПартии(Партия, БазаРаспределения)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеМЗМатериалы.Номенклатура,
	|	ПоступлениеМЗМатериалы.КПС,
	|	ПоступлениеМЗМатериалы.КФО,
	|	ПоступлениеМЗ.Подразделение,
	|	СУММА(&БазаРаспределения) КАК БазаРаспределения,
	|	ПоступлениеМЗ.ЦМО,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗМатериалы.СчетУчета В (&Счета106)
	|			ТОГДА ПоступлениеМЗМатериалы.СчетУчета
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ КАК СчетВложений
	|ИЗ
	|	Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	|		ПО ПоступлениеМЗМатериалы.Ссылка = ПоступлениеМЗ.Ссылка
	|ГДЕ
	|	ПоступлениеМЗ.Проведен
	|	И ПоступлениеМЗ.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеМЗМатериалы.Номенклатура,
	|	ПоступлениеМЗМатериалы.КПС,
	|	ПоступлениеМЗМатериалы.КФО,
	|	ПоступлениеМЗ.Подразделение,
	|	ПоступлениеМЗ.ЦМО,
	|	ВЫБОР
	|		КОГДА ПоступлениеМЗМатериалы.СчетУчета В (&Счета106)
	|			ТОГДА ПоступлениеМЗМатериалы.СчетУчета
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ";
	Запрос.УстановитьПараметр("Ссылка", Партия);
	Запрос.УстановитьПараметр("Счета106", БухгалтерскийУчет.СписокСчетов("106.00"));
	
	Если БазаРаспределения = Перечисления.БазыРаспределенияДополнительныхРасходов.Стоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&БазаРаспределения", "ПоступлениеМЗМатериалы.Всего");
	ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияДополнительныхРасходов.Количество Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&БазаРаспределения", "ПоступлениеМЗМатериалы.Количество");
	ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияДополнительныхРасходов.КоличествоМест Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&БазаРаспределения",
		"ВЫБОР
		|		КОГДА ПоступлениеМЗМатериалы.Коэффициент <> 0
		|			ТОГДА ПоступлениеМЗМатериалы.Количество / ПоступлениеМЗМатериалы.Коэффициент
		|		ИНАЧЕ ВЫБОР
		|			КОГДА ПоступлениеМЗМатериалы.КоличествоМест <> 0
		|				ТОГДА ПоступлениеМЗМатериалы.Количество / (ПоступлениеМЗМатериалы.Количество /
		|					ПоступлениеМЗМатериалы.КоличествоМест)
		|			ИНАЧЕ 0
		|		КОНЕЦ
		|	КОНЕЦ");
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не известная база распределения ""%1""'"), БазаРаспределения);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить(); 
	
КонецФункции

// База распределения расходов на движения партии - вычисляется по проводкам документа.
// 
// Параметры:
//  Партия - ДокументСсылка - Партия
//  БазаРаспределения - ПеречислениеСсылка.БазыРаспределенияДополнительныхРасходов - База распределения
//  СчетУчета - ПланСчетовСсылка.ЕПСБУ - Счет учета
// 
// Возвращаемое значение:
//  ТаблицаЗначений - База распределения расходов на движения партии
Функция БазаРаспределенияРасходовНаДвиженияПартии(Партия, БазаРаспределения, СчетУчета)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = &СубконтоНоменклатура
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = &СубконтоНоменклатура
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = &СубконтоНоменклатура
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.Номенклатура)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	КОНЕЦ КАК Номенклатура,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = &СубконтоЦМО
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.ЦМО)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = &СубконтоЦМО
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.ЦМО)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = &СубконтоЦМО
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.ЦМО)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|	КОНЕЦ) КАК ЦМО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПС,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК Подразделение,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	СУММА(&БазаРаспределения) КАК БазаРаспределения
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(,, Регистратор = &Регистратор
	|	И СчетДт = &СчетУчета,,) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = &СубконтоНоменклатура
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = &СубконтоНоменклатура
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = &СубконтоНоменклатура
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.Номенклатура)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	КОНЕЦ";
	Запрос.УстановитьПараметр("Регистратор", Партия);
	Запрос.УстановитьПараметр("СчетУчета",   СчетУчета);
	Запрос.УстановитьПараметр("СубконтоНоменклатура", ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	Запрос.УстановитьПараметр("СубконтоЦМО", ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	Если БазаРаспределения = Перечисления.БазыРаспределенияДополнительныхРасходов.Стоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&БазаРаспределения", "ЖурналПроводокЕПСБУДвиженияССубконто.Сумма");
	ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияДополнительныхРасходов.Количество Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&БазаРаспределения", "ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт");
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не известная база распределения ""%""'"), БазаРаспределения);
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Колонки.Добавить("СчетВложений", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	
	Возврат Результат;
	
КонецФункции

Функция БазаРаспределенияРасходовНаОстаткиПартии(ДатаФормирования, Партия, БазаРаспределения, СчетУчета)
	
	Запрос = Новый Запрос;
	ДопТекстЗапроса = "";
	
	Запрос.Текст =  "ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО,";
	
	Если БазаРаспределения = Перечисления.БазыРаспределенияДополнительныхРасходов.Стоимость Тогда
		Запрос.Текст = Запрос.Текст + "
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК БазаРаспределения";
	ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияДополнительныхРасходов.Количество Тогда
		Запрос.Текст = Запрос.Текст + "
		|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК БазаРаспределения";
	Иначе
		Запрос.Текст = Запрос.Текст + " 
		|	ВЫБОР
		|		КОГДА (НЕ ПоступлениеМЗМатериалы.Коэффициент = 0)
		|			ТОГДА ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт / ПоступлениеМЗМатериалы.Коэффициент
		|		ИНАЧЕ ВЫБОР
		|				КОГДА (НЕ ПоступлениеМЗМатериалы.КоличествоМест = 0)
		|					ТОГДА ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт / (ПоступлениеМЗМатериалы.Количество / ПоступлениеМЗМатериалы.КоличествоМест)
		|				ИНАЧЕ 1
		|			КОНЕЦ
		|	КОНЕЦ КАК БазаРаспределения";
		ДопТекстЗапроса = "
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
		|		ПО ЖурналПроводокЕПСБУОстатки.Субконто2 = ПоступлениеМЗМатериалы.Номенклатура
		|ГДЕ
		|	ПоступлениеМЗМатериалы.Ссылка = &Партия";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет = &Счет, , Субконто1 = &Партия) КАК ЖурналПроводокЕПСБУОстатки
	|" + ДопТекстЗапроса;
	
	Запрос.УстановитьПараметр("Период", ДатаФормирования);
	Запрос.УстановитьПараметр("Счет", СчетУчета);
	Запрос.УстановитьПараметр("Партия", Партия);
	
	База = Запрос.Выполнить().Выгрузить();
	База.Свернуть("Номенклатура, КПС, Подразделение, КФО", "БазаРаспределения");
	База.Колонки.Добавить("ЦМО", Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	База.Колонки.Добавить("СчетВложений", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	
	Если ТипЗнч(Партия) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		ЦМО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партия, "ЦМО");
		База.ЗаполнитьЗначения(ЦМО, "ЦМО");
	КонецЕсли;

	Возврат База;
КонецФункции

// Устанавливает отбор списка документов по остатакам по партиям на счете 106.04
//
Процедура УстановкаОтбораСпискаПоОстаткамПартий(ОтборСписка, ПараметрыОтбора, ВидДокумента) Экспорт
	
	Перем ПериодОстатков, ИФО, Номенклатура;
	
	Если НЕ (ТипЗнч(ПараметрыОтбора) = Тип("Структура") ИЛИ ТипЗнч(ПараметрыОтбора) = Тип("ДанныеФормыСтруктура")) ИЛИ НЕ ПараметрыОтбора.Свойство("СчетДт") ИЛИ НЕ ПараметрыОтбора.Свойство("Организация") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Документ." + ВидДокумента + ") КАК Ссылка
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(";
	
	Если ПараметрыОтбора.Свойство("Дата", ПериодОстатков) Тогда
		Запрос.Текст = Запрос.Текст +"
		|			&Период";
		Запрос.УстановитьПараметр("Период", ПериодОстатков);
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ",
	|			Счет = &Счет,
	|			,";
	Запрос.УстановитьПараметр("Счет", ПараметрыОтбора.СчетДт);
	
	Запрос.Текст = Запрос.Текст + "
	|			Организация = &Организация";
	Запрос.УстановитьПараметр("Организация", ПараметрыОтбора.Организация);
	
	Если ПараметрыОтбора.Свойство("ИФО", ИФО) Тогда
		Запрос.Текст = Запрос.Текст + "   
		|		И ИФО = &ИФО";
		Запрос.УстановитьПараметр("ИФО", ИФО);
	КонецЕсли;
	
	Если ПараметрыОтбора.Свойство("Номенклатура", Номенклатура) Тогда
		Запрос.Текст = Запрос.Текст +"
		|			И Субконто2 = &Номенклатура";
		Запрос.УстановитьПараметр("Номенклатура", ПараметрыОтбора.Номенклатура);
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ") КАК ЖурналПроводокЕПСБУОстатки
	|ГДЕ
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт > 0";
				   
	МассивСсылок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ОтборСписка, "Ссылка", МассивСсылок, ВидСравненияКомпоновкиДанных.ВСписке, ,Истина);
	
	
КонецПроцедуры	

// Определяет подходящий счет из результата выполнения ДанныеСчетовУчетаМЗ
Функция ОпределитьСчетУчетаДляШапкиДокументаМЗ(Организация, СчетУчета) Экспорт
	
	ДанныеСчетов = СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетовУчетаМЗ(Организация, Ложь));
	
	РазличныеСчета = Новый Соответствие(); // Соответствие - для исключения дублей и упрощения поиска
	
	Для Каждого ДанныеСчета Из ДанныеСчетов Цикл
		РазличныеСчета.Вставить(ДанныеСчета["Счет"], 1);
	КонецЦикла;
	
	ПроверяемыйСчет = СчетУчета;
	
	Пока ЗначениеЗаполнено(ПроверяемыйСчет) Цикл
		ОбнаруженоСовпадение = НЕ (РазличныеСчета.Получить(ПроверяемыйСчет) = Неопределено);
		
		Если ОбнаруженоСовпадение Тогда
			Прервать;
		КонецЕсли;
		
		ПроверяемыйСчет = ПроверяемыйСчет.Родитель;
	КонецЦикла;
	
	Если ОбнаруженоСовпадение Тогда
		Возврат ПроверяемыйСчет;
	Иначе
		Возврат СчетУчета;
	КонецЕсли;
	
КонецФункции

Процедура УстановитьУсловноеОформлениеКолонкиСуммаСписанияНУ(Форма, ИмяТаблицы = "Материалы") Экспорт

	УсловноеОформление = Форма.УсловноеОформление.Элементы;
	ЦветТекста = Метаданные.ЭлементыСтиля.НедоступныеДанныеЦвет.Значение;
	Если Форма.Объект.Ссылка.Метаданные().Реквизиты.Найти("КФО") = Неопределено Тогда
		// Реквизит КФО в таблице
		ПолеОбъекта = "Объект." + ИмяТаблицы + ".КФО";
	Иначе
		// Реквизит КФО в шапке
		ПолеОбъекта = "Объект.КФО";
	КонецЕсли;
	
	Элемент = УсловноеОформление.Добавить();
	Элемент.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор, ПолеОбъекта,
		Перечисления.КВД.Внебюджет, ВидСравненияКомпоновкиДанных.НеРавно);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",     ЦветТекста);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",          НСтр("ru = '<не используется>'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "СуммаСписанияНУ");
	Поле.Использование = Истина;

КонецПроцедуры

Функция ТипыНоменклатурыМатериальныеЗапасы() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ТипыНоменклатуры.ГСМ);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.Медикаменты); 
	Результат.Добавить(Перечисления.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.МягкийИнвентарь);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.Посуда);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.ПродуктыПитания);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.ПрочиеМЗ);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.Стройматериалы);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.Оборудование);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.Тара);
	Результат.Добавить(Перечисления.ТипыНоменклатуры.БиологическиеАктивы);
	
	Возврат Результат;
	
КонецФункции

#Область Корректировки

Функция КорректирующийДокумент(Ссылка) Экспорт
	
	Результат = ОбщегоНазначенияБГУ.ПустоеЗначениеТипа(ТипЗнч(Ссылка));
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТаблицаДокумента.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеМЗ КАК ТаблицаДокумента
		|ГДЕ
		|	ТаблицаДокумента.ДокументОснование = &Ссылка
		|	И ТаблицаДокумента.ЭтоКорректировка";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ПоступлениеМЗ", Ссылка.Метаданные().ПолноеИмя());
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		УстановитьПривилегированныйРежим(Истина);
		Выборка = Запрос.Выполнить().Выбрать();
		УстановитьПривилегированныйРежим(Ложь);
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

#КонецОбласти

// Заполняет временную таблицу - копию табличной части документа данными из подбора
// 
// Параметры:
//  ВтМатериалы - ТаблицаЗначений(Объект.Материалы.Выгрузить())
//  ТаблицаПодбора - ТаблицаЗначений(Данные из подбора номенклатуры)
//  СвойстваИсключения - Строка(колонки таблицы подбора, неиспользуемые для заполнения строки документа)
Процедура ЗаполнитьТаблицуИзПодбораМатериалов (ВтМатериалы, ТаблицаПодбора, СвойстваИсключения = "") Экспорт
	
	ТаблицаПодбора.Колонки.НомерСтроки.Имя = "НомерСтрокиПодбора";
	
	ВтМатериалы.Колонки.Добавить("ПометкаУдаления");
	ВтМатериалы.Колонки.Добавить("НомерСтрокиПодбора");
	ВтМатериалы.Колонки.Добавить("НомерСтрокиДокумента");
	ВтМатериалы.Колонки.Добавить("НоваяСтрока");
	ВтМатериалы.ЗаполнитьЗначения(Истина, "ПометкаУдаления");
	ВтМатериалы.ЗаполнитьЗначения(Ложь, "НоваяСтрока");
	ВтМатериалы.Индексы.Добавить("ПометкаУдаления");
	
	Для Каждого СтрокаПодбора Из ТаблицаПодбора Цикл
		Если СтрокаПодбора.НомерСтрокиДокумента = 0 Тогда
			СтрокаМатериала = ВтМатериалы.Добавить();
			СтрокаМатериала.НоваяСтрока = Истина;
		Иначе
			СтрокаМатериала = ВтМатериалы[СтрокаПодбора.НомерСтрокиДокумента -1];
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаМатериала, СтрокаПодбора, , СвойстваИсключения);
		СтрокаМатериала.ПометкаУдаления = Ложь;
	КонецЦикла;
	
	СтрокиУдалению = ВтМатериалы.НайтиСтроки(Новый Структура("ПометкаУдаления", Истина));
	Если СтрокиУдалению.Количество() Тогда
		Для Каждого СтрокаУдаления Из СтрокиУдалению Цикл
			ВтМатериалы.Удалить(СтрокаУдаления);
		КонецЦикла;
	КонецЕсли;
	
	ВтМатериалы.Сортировать("НомерСтрокиПодбора Возр");
	
КонецПроцедуры

// Заполняет КПС в табличной части документа "Поступление МЗ"
// 
// Параметры:
//  ОбъектКоллекция - ДокументОбъект
//  ИмяТЧ - Строка (Материалы, ВозвратнаяТара)
//  ПоступлениеСчет106 - Булево
Процедура ЗаполнитьКПСМЗвТЧПоступления(ОбъектКоллекция, ИмяТЧ, ПоступлениеСчет106 = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Материалы.СчетУчета КАК СчетУчета,
	|	Материалы.КПС КАК КПС,
	|	ВЫБОР
	|		КОГДА &НесколькоКПСР
	|			ТОГДА Материалы.КПСРасчетов
	|		ИНАЧЕ &ОбщийКПСРасчетов
	|	КОНЕЦ КАК КПСРасчетов,
	|	Материалы.КФО КАК КФО,
	|	Материалы.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Материалы
	|ИЗ
	|	&Материалы КАК Материалы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Материалы.СчетУчета КАК СчетУчета,
	|	ВТ_Материалы.КФО КАК КФО,
	|	ВТ_Материалы.НомерСтроки КАК НомерСтроки,
	|	ВТ_Материалы.КПС КАК КПС,
	|	ВТ_Материалы.КПСРасчетов КАК КПСРасчетов,
	|	ЕСТЬNULL(КлассификационныеПризнакиСчетов.РазделПодразделКРБ, ЗНАЧЕНИЕ(Справочник.РазделыПодразделыКРБ.ПустаяСсылка)) КАК РазделПодразделКРБ,
	|	ЕСТЬNULL(КлассификационныеПризнакиСчетов.УточнениеПоказателя, ЗНАЧЕНИЕ(Перечисление.ВидыКБК.ПустаяСсылка)) КАК УточнениеПоказателя,
	|	ЕСТЬNULL(КлассификационныеПризнакиСчетов.ВидПоказателя, ЗНАЧЕНИЕ(Перечисление.ВидыКБК.ПустаяСсылка)) КАК ВидПоказателя,
	|	ВЫБОР
	|		КОГДА &Поступление106
	|			ТОГДА ЕСТЬNULL(КлассификационныеПризнакиСчетовР.ВидРасходаКРБ, ЗНАЧЕНИЕ(Справочник.ВидыРасходовКРБ.ПустаяСсылка))
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыРасходовКРБ.ПустаяСсылка)
	|	КОНЕЦ КАК ВидРасходаКРБ,
	|	ВЫБОР
	|		КОГДА &Поступление106
	|			ТОГДА ЕСТЬNULL(КлассификационныеПризнакиСчетовР.АналитическийКодКПС, ЗНАЧЕНИЕ(Справочник.АналитическиеКодыКПС.ПустаяСсылка))
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.АналитическиеКодыКПС.ПустаяСсылка)
	|	КОНЕЦ КАК АналитическийКодКПС,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КлассификационныеПризнакиСчетовР.ДатаНачалаДействия, ДАТАВРЕМЯ(1, 1, 1)) > ДАТАВРЕМЯ(2018, 12, 31)
	|			ТОГДА СТРНАЙТИ(&СтрокаСимволовНацПроект, ПОДСТРОКА(КлассификационныеПризнакиСчетовР.Код, 8, 1)) > 0
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НацПроект
	|ПОМЕСТИТЬ ВТ_МатериалыГруппы
	|ИЗ
	|	ВТ_Материалы КАК ВТ_Материалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов
	|		ПО (ВЫБОР
	|				КОГДА ВТ_Материалы.КПС <> ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|					ТОГДА ВТ_Материалы.КПС = КлассификационныеПризнакиСчетов.Ссылка
	|				ИНАЧЕ ВТ_Материалы.КПСРасчетов = КлассификационныеПризнакиСчетов.Ссылка
	|			КОНЕЦ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетовР
	|		ПО ВТ_Материалы.КПСРасчетов = КлассификационныеПризнакиСчетовР.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КПСОтбор.Ссылка КАК КПС
	|ПОМЕСТИТЬ ВТ_КПС
	|ИЗ
	|	Справочник.КлассификационныеПризнакиСчетов КАК КПСОтбор
	|ГДЕ
	|	КПСОтбор.ДатаНачалаДействия <= &Период
	|	И (КПСОтбор.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ КПСОтбор.ДатаОкончанияДействия >= &Период)
	|	И НЕ КПСОтбор.ПометкаУдаления
	|	И (КПСОтбор.РазделПодразделКРБ, КПСОтбор.ВидПоказателя, КПСОтбор.УточнениеПоказателя, КПСОтбор.ВидРасходаКРБ, КПСОтбор.АналитическийКодКПС) В
	|			(ВЫБРАТЬ
	|				ВТ_МатериалыГруппы.РазделПодразделКРБ,
	|				ВТ_МатериалыГруппы.ВидПоказателя,
	|				ВТ_МатериалыГруппы.УточнениеПоказателя,
	|				ВТ_МатериалыГруппы.ВидРасходаКРБ,
	|				ВТ_МатериалыГруппы.АналитическийКодКПС
	|			ИЗ
	|				ВТ_МатериалыГруппы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РабочиеСчетаСрезПоследних.Счет КАК СчетУчета,
	|	РабочиеСчетаСрезПоследних.КПС КАК КПС,
	|	РабочиеСчетаСрезПоследних.КФО КАК КФО,
	|	РабочиеСчетаСрезПоследних.КПС.РазделПодразделКРБ КАК РазделПодразделКРБ
	|ПОМЕСТИТЬ ВТ_КПСМЗ
	|ИЗ
	|	РегистрСведений.РабочиеСчета.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И (Счет, КФО) В
	|					(ВЫБРАТЬ
	|						Вт_Материалы.СчетУчета,
	|						Вт_Материалы.КФО
	|					ИЗ
	|						Вт_Материалы)
	|				И КПС В
	|					(ВЫБРАТЬ
	|						ВТ_КПС.КПС
	|					ИЗ
	|						ВТ_КПС)) КАК РабочиеСчетаСрезПоследних
	|ГДЕ
	|	РабочиеСчетаСрезПоследних.Актуален
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_МатериалыГруппы.НомерСтроки КАК НомерСтроки,
	|	ВТ_МатериалыГруппы.КПСРасчетов КАК КПСРасчетов,
	|	ВТ_МатериалыГруппы.НацПроект КАК НацПроект,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА &Поступление106
	|				ТОГДА ЕСТЬNULL(ВТ_КПСМЗ.КПС, ВТ_МатериалыГруппы.КПСРасчетов)
	|			ИНАЧЕ ЕСТЬNULL(ВТ_КПСМЗ.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))
	|		КОНЕЦ) КАК КПС
	|ИЗ
	|	ВТ_МатериалыГруппы КАК ВТ_МатериалыГруппы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КПСМЗ КАК ВТ_КПСМЗ
	|		ПО ВТ_МатериалыГруппы.СчетУчета = ВТ_КПСМЗ.СчетУчета
	|			И ВТ_МатериалыГруппы.КФО = ВТ_КПСМЗ.КФО
	|			И ВТ_МатериалыГруппы.РазделПодразделКРБ = ВТ_КПСМЗ.РазделПодразделКРБ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_МатериалыГруппы.НомерСтроки,
	|	ВТ_МатериалыГруппы.КПСРасчетов,
	|	ВТ_МатериалыГруппы.НацПроект";
	
	Запрос.УстановитьПараметр("Материалы", ОбъектКоллекция[ИмяТч].Выгрузить(,"СчетУчета,КПС,КПСРасчетов,КФО,НомерСтроки"));
	Запрос.УстановитьПараметр("Период", ОбъектКоллекция.Дата);
	Запрос.УстановитьПараметр("Организация", ОбъектКоллекция.Организация);
	Запрос.УстановитьПараметр("СтрокаСимволовНацПроект", БюджетнаяКлассификацияКлиентСервер.СтрокаКодовНацПроектов(ОбъектКоллекция.Дата));

	ОбщийКПСРасчетов = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	Если ЗначениеЗаполнено(ОбъектКоллекция.КПСРасчетов) И НЕ ОбъектКоллекция.НесколькоКПСРасчетов Тогда
		ОбщийКПСРасчетов = ОбъектКоллекция.КПСРасчетов;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ОбщийКПСРасчетов", ОбщийКПСРасчетов);
	Запрос.УстановитьПараметр("НесколькоКПСР", ОбъектКоллекция.НесколькоКПСРасчетов);
	Запрос.УстановитьПараметр("Поступление106", ПоступлениеСчет106);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаСтрок = РезультатЗапроса.Выбрать();
		Пока ВыборкаСтрок.Следующий() Цикл
			Если ВыборкаСтрок.НацПроект Тогда
				ОбъектКоллекция[ИмяТЧ][ВыборкаСтрок.НомерСтроки-1].КПС = ВыборкаСтрок.КПСРасчетов;
			Иначе
				ОбъектКоллекция[ИмяТЧ][ВыборкаСтрок.НомерСтроки-1].КПС = ВыборкаСтрок.КПС;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

// Колонки для выгрузки табличной части документа в подбор номенклатуры
// 
// Параметры:
//  РеквизитыФормы - Массив (реквизиты формы табличной части)
//  СоответствиеИменРеквизитов - Соответствие (ключ имя реквизита подбора, значние имя реквизитв табличной части)
// 
// Возвращаемое значение:
//  Строка - Колонки для выгрузки
Функция КолонкиПодбораДляВыгрузкиТабличнойЧасти(РеквизитыФормы, СоответствиеИменРеквизитов = Неопределено) Экспорт
	
	РеквизитыПодбора = Обработки.ПодборНоменклатуры.РеквизитыКорзиныПодбора();
	
	РеквизитыТЧ = Новый Соответствие;
	Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
		РеквизитыТЧ.Вставить(РеквизитФормы.Имя, РеквизитФормы.Имя);
	КонецЦикла;
	
	МассивИменКолонок = Новый Массив;
	Для Каждого РеквизитПодбора Из РеквизитыПодбора Цикл
		ИмяКолонки = РеквизитыТЧ.Получить(РеквизитПодбора);
		Если ИмяКолонки <> Неопределено Тогда
			МассивИменКолонок.Добавить(ИмяКолонки);
		Иначе
			Если СоответствиеИменРеквизитов <> Неопределено Тогда
				ИмяРеквизитаТЧ = СоответствиеИменРеквизитов.Получить(РеквизитПодбора);
				Если ИмяРеквизитаТЧ <> Неопределено Тогда
					МассивИменКолонок.Добавить(ИмяРеквизитаТЧ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(МассивИменКолонок, ",");
	
КонецФункции

#КонецОбласти

#Область УчетМатериальныхЗапасов

// Поступление материальных запасов.

// Пустая таблица поступление материальных запасов ранее учтенных в пути.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица поступление материальных запасов ранее учтенных в пути:
// * ИмяСписка - Строка 
// * СинонимСписка - СТрока 
// * НомерСтроки - Число
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения -
// * КФО - ПеречислениеСсылка.КВД -
// * Подразделение - СправочникСсылка.Подразделения -
// * СчетУчета - ПланСчетовСсылка.ЕПСБУ -
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * КЭК - СправочникСсылка.КОСГУ -
// * Номенклатура - СправочникСсылка.Номенклатура -
// * ДопАналитикаВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто 
// * ДопАналитика - Характеристика.ВидыСубконто
// * ДопИзмерениеВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто
// * ДопИзмерение - Характеристика.ВидыСубконто
// * СчетУчетаВПути - ПланСчетовСсылка.ЕПСБУ -
// * КПСВПути - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * КЭКВПути - СправочникСсылка.КОСГУ -
// * Контрагент - СправочникСсылка.Контрагенты -
// * Партия - Характеристика.ВидыСубконто
// * Количество - Число
// * Сумма - Число
// * ОстатокПревышен - Булево
Функция ПустаяТаблицаПоступлениеМатериальныхЗапасовРанееУчтенныхВПути() Экспорт

	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));

	// Счет и аналитика учета материальных запасов.
	ПустаяТаблица.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("ДопАналитикаВидСубконто", ОписаниеТиповВидСубконто);
	ПустаяТаблица.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ПустаяТаблица.Колонки.Добавить("ДопИзмерениеВидСубконто", ОписаниеТиповВидСубконто);
	ПустаяТаблица.Колонки.Добавить("ДопИзмерение",            ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.

	// Счет и аналитика учета материальных запасов в пути
	ПустаяТаблица.Колонки.Добавить("СчетУчетаВПути", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПСВПути",       Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭКВПути",       Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("КонтрагентВПути",     Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("ПартияВПути",           ОписаниеТиповСубконто);
	
	// Количество и сумма поступивших единиц.
	ПустаяТаблица.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("Сумма",         ОписаниеТипаСуммы);
	
	ПустаяТаблица.Колонки.Добавить("ОстатокПревышен", Новый ОписаниеТипов("Булево"));
	
	Возврат ПустаяТаблица;
	
КонецФункции

// Подготовить таблицу поступления материальных запасов ранее учтенных в пути.
// 
// Параметры:
//  ТаблицаДокумента - см. ПустаяТаблицаПоступлениеМатериальныхЗапасовПоДокументу
//  Реквизиты - Структура:
//   * ПоступлениеМЗВПути - Характеристика.ВидыСубконто
//   * ДокументОснование - см. Документ.ПоступлениеМЗ.ДокументОснование
//   * Организация - СправочникСсылка.Организации
//   * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//   * Подразделение - СправочникСсылка.Подразделения
//   * Ссылка - ДокументСсылка
//   * Дата - Дата
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. ПустаяТаблицаПоступлениеМатериальныхЗапасовРанееУчтенныхВПути
Функция ПодготовитьТаблицуПоступленияМатериальныхЗапасовРанееУчтенныхВПути(ТаблицаДокумента, Реквизиты, Отказ) Экспорт

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяТаблицы", "Материалы");
	ДополнительныеПараметры.Вставить("СинонимТаблицы", НСтр("ru = 'Материалы'"));
	
	Возврат ПодготовитьТаблицуПоступленияМатериальныхЗапасовРанееУчтенныхВПутиИсполняющая(
		ТаблицаДокумента,
		Реквизиты,
		ДополнительныеПараметры,
		Отказ);

КонецФункции

// Подготовить таблицу поступления материальных запасов ранее учтенных в пути.
// 
// Параметры:
//  ТаблицаДокумента - см. ПустаяТаблицаПоступлениеМатериальныхЗапасовПоДокументу
//  Реквизиты - Структура:
//   * ПоступлениеМЗВПути - Характеристика.ВидыСубконто
//   * ДокументОснование - см. Документ.ПоступлениеМЗ.ДокументОснование
//   * Организация - СправочникСсылка.Организации
//   * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//   * Подразделение - СправочникСсылка.Подразделения
//   * Ссылка - ДокументСсылка
//   * Дата - Дата
//  ДополнительныеПараметры - Структура:
//   * ИмяТаблицы - Строка
//   * СинонимТаблицы - Строка
//  Отказ - Булево
// 
// Возвращаемое значение:
//  см. ПустаяТаблицаПоступлениеМатериальныхЗапасовРанееУчтенныхВПути
Функция ПодготовитьТаблицуПоступленияМатериальныхЗапасовРанееУчтенныхВПутиИсполняющая(ТаблицаДокумента, Реквизиты, ДополнительныеПараметры, Отказ) Экспорт

	ТаблицаПоступление = ПустаяТаблицаПоступлениеМатериальныхЗапасовРанееУчтенныхВПути();
	Если ТаблицаДокумента.Количество() = 0 Или Реквизиты = Неопределено Тогда
		Возврат ТаблицаПоступление;
	КонецЕсли;
	
	ДокументПартии = Реквизиты.ПоступлениеМЗВПути;
	Если Не ЗначениеЗаполнено(ДокументПартии) Тогда
		ДокументПартии = Реквизиты.ДокументОснование;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДокументПартии) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не заполнен документ партии в пути.'"));
		Отказ = Истина;
		ВызватьИсключение НСтр("ru = 'Не заполнен документ партии в пути.'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Реквизиты.Ссылка) Тогда
		Период = Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	Иначе
		Период = Новый Граница(КонецДня(Реквизиты.Дата), ВидГраницы.Включая);
	КонецЕсли;
	
	Отбор = Новый Структура("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
	Остатки = ОстаткиМатериаловВПути(Реквизиты.Организация, Реквизиты.ИФО, Реквизиты.Подразделение, ДокументПартии, Период);
	Остатки.Индексы.Добавить("Номенклатура");
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		Отбор.Номенклатура = СтрокаДокумента.Номенклатура;
		ОстаткиНоменклатуры = Остатки.НайтиСтроки(Отбор);
		ОсталосьСписатьКоличество = СтрокаДокумента.Количество;
		ОсталосьСписатьСумма = СтрокаДокумента.Сумма;
		
		Для Каждого СтрокаОстатка Из ОстаткиНоменклатуры Цикл
			Если СтрокаОстатка.КоличествоОстаток = 0 Тогда
				Продолжить;
			КонецЕсли;
			СписываемоеКоличество = Мин(ОсталосьСписатьКоличество, СтрокаОстатка.КоличествоОстаток);
			СписываемаяСумма = Мин(ОсталосьСписатьСумма, СтрокаОстатка.СуммаОстаток);
			
			СтрокаПоступления = ТаблицаПоступление.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаПоступления, СтрокаДокумента);
			СтрокаПоступления.ИмяСписка = ДополнительныеПараметры.ИмяТаблицы;
			СтрокаПоступления.СинонимСписка = ДополнительныеПараметры.СинонимТаблицы;
			СтрокаПоступления.НомерСтроки = СтрокаДокумента.НомерСтроки;
			
			СтрокаПоступления.СчетУчетаВПути = СтрокаОстатка.Счет;
			СтрокаПоступления.КПСВПути = СтрокаОстатка.КПС;
			СтрокаПоступления.КЭКВПути = СтрокаПоступления.КЭК;
			СтрокаПоступления.КонтрагентВПути = СтрокаОстатка.Контрагент;
			СтрокаПоступления.ПартияВПути = ДокументПартии;
			
			СтрокаПоступления.Количество = СписываемоеКоличество;
			СтрокаПоступления.Сумма = СписываемаяСумма;
			
			ОсталосьСписатьКоличество = ОсталосьСписатьКоличество - СписываемоеКоличество;
			ОсталосьСписатьСумма = ОсталосьСписатьСумма - СписываемаяСумма;
			
			СтрокаОстатка.КоличествоОстаток = СтрокаОстатка.КоличествоОстаток - СписываемоеКоличество; 
			СтрокаОстатка.СуммаОстаток = СтрокаОстатка.СуммаОстаток - СписываемаяСумма;
			
			Если ОсталосьСписатьКоличество = 0 Тогда
				Прервать;
			КонецЕсли; 
			
		КонецЦикла;
		
		// Несписанное количество добавим отдельной строкой
		Если ОсталосьСписатьКоличество > 0  Тогда
			
			СтрокаСписанных = ТаблицаПоступление.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСписанных, СтрокаДокумента);
			СтрокаСписанных.Количество      = ОсталосьСписатьКоличество;
			СтрокаСписанных.Сумма      = ОсталосьСписатьСумма;
			СтрокаСписанных.ОстатокПревышен = Истина;
			
			ТекстОшибки = НСтр("ru='Указанное количество ""%3"" превышает остаток в пути.
				|Остаток: %1; Не хватает: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				СтрокаДокумента.Количество - ОсталосьСписатьКоличество,
				ОсталосьСписатьКоличество,
				СтрокаДокумента.Номенклатура);
				
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru = 'Количество'"),
				СтрокаДокумента.НомерСтроки,
				СтрокаДокумента.СинонимСписка,
				ТекстОшибки);
				
			ПолеКоличество = СтрокаДокумента.ИмяСписка + "[" + Формат(СтрокаДокумента.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Количество";
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Реквизиты.Ссылка, ПолеКоличество, "Объект", Отказ);
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат ТаблицаПоступление;

КонецФункции

// Остаток материалов в пути.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//  Подразделение - СправочникСсылка.Подразделения
//  ДокументПартии - ДокументСсылка.ПоступлениеМЗВПути
//  Период - Граница
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Остаток материалов в пути:
//   * Контрагент - СправочникСсылка.Контрагенты
//   * Номенклатура - СправочникСсылка.Номенклатура
//   * ПоступлениеВПути - ДокументСсылка.ПоступлениеМЗВПути
//   * Счет - ПланСчетовСсылка.ЕПСБУ
//   * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов
//   * КФО - ПеречислениеСсылка.КВД
//   * СуммаОстаток - Число
//   * КоличествоОстаток - Число
//
Функция ОстаткиМатериаловВПути(Организация, ИФО, Подразделение, ДокументПартии, Период)
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИФО", ИФО);
	Запрос.УстановитьПараметр("ПоступлениеВПути", ДокументПартии);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеМЗВПутиМатериалы.СчетУчета КАК СчетУчета,
	|	ПоступлениеМЗВПутиМатериалы.СчетУчета.УчетПоПодразделениям КАК УчетПоПодразделениям
	|ПОМЕСТИТЬ ПоступлениеВПути
	|ИЗ
	|	Документ.ПоступлениеМЗВПути.Материалы КАК ПоступлениеМЗВПутиМатериалы
	|ГДЕ
	|	ПоступлениеМЗВПутиМатериалы.Ссылка = &ПоступлениеВПути
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоступлениеМЗВПутиВозвратнаяТара.СчетУчета КАК СчетУчета,
	|	ПоступлениеМЗВПутиВозвратнаяТара.СчетУчета.УчетПоПодразделениям КАК УчетПоПодразделениям
	|ИЗ
	|	Документ.ПоступлениеМЗВПути.ВозвратнаяТара КАК ПоступлениеМЗВПутиВозвратнаяТара
	|ГДЕ
	|	ПоступлениеМЗВПутиВозвратнаяТара.Ссылка = &ПоступлениеВПути
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетУчета";
	Запрос.Выполнить();
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА
		|ИЗ
		|	ПоступлениеВПути КАК ПоступлениеВПути
		|ГДЕ
		|	ПоступлениеВПути.УчетПоПодразделениям";
		УчетПоПодразделениям = НЕ Запрос.Выполнить().Пустой();
	Иначе
		УчетПоПодразделениям = Ложь;
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 Ссылка Документ.ПоступлениеМЗВПути
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Документ.ПоступлениеМЗВПути)
	|	КОНЕЦ КАК ПоступлениеВПути,
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В
	|		(ВЫБРАТЬ
	|			ПоступлениеВПути.СчетУчета
	|		ИЗ
	|			ПоступлениеВПути КАК ПоступлениеВПути),, Организация = &Организация
	|	И &УсловиеИФО
	|	И &УсловиеПодразделение
	|	И Субконто3 = &ПоступлениеВПути) КАК ЖурналПроводокЕПСБУОстатки";
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		УсловиеИФО = "ИФО = &ИФО";
	Иначе
		УсловиеИФО = "ИСТИНА";
	КонецЕсли;
	Если УчетПоПодразделениям Тогда
		УсловиеПодразделение = "Подразделение = &Подразделение";
	Иначе
		УсловиеПодразделение = "ИСТИНА";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", УсловиеИФО);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", УсловиеПодразделение);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Пустая таблица поступление материальных запасов по документу.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица поступление материальных запасов по документу:
// * ИмяСписка - Строка
// * СинонимСписка - Строка
// * НомерСтроки - Число 
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения -
// * КФО - ПеречислениеСсылка.КВД -
// * Подразделение - СправочникСсылка.Подразделения -
// * СчетУчета - ПланСчетовСсылка.ЕПСБУ -
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * КЭК - СправочникСсылка.КОСГУ -
// * Номенклатура - СправочникСсылка.Номенклатура -
// * ДопАналитикаВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто 
// * ДопАналитика - Характеристика.ВидыСубконто 
// * ДопИзмерениеВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто
// * ДопИзмерение - Характеристика.ВидыСубконто
// * СчетРасчетов - ПланСчетовСсылка.ЕПСБУ -
// * КПСРасчетов - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * Контрагент - СправочникСсылка.Контрагенты -
// * Договор - СправочникСсылка.Договоры -
// * Валюта - СправочникСсылка.Валюты -
// * Количество - Число 
// * Сумма - Число
// * СтавкаНДС - ПеречислениеСсылка.СтавкиНДС -
// * СуммаНДС - Число
// * ОтражениеВУСН - ПеречислениеСсылка.ОтражениеВУСН -
// * НДСКРаспределению - Булево -
// * ПринятьНДСКВычету - Булево -
Функция ПустаяТаблицаПоступлениеМатериальныхЗапасовПоДокументу() Экспорт
	
	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ТаблицаДокумента = Новый ТаблицаЗначений;
	// Идентификация строки.
	ТаблицаДокумента.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ТаблицаДокумента.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДокумента.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДокумента.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета материальных запасов.
	ТаблицаДокумента.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДокумента.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаДокумента.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДокумента.Колонки.Добавить("ДопАналитикаВидСубконто", ОписаниеТиповВидСубконто);
	ТаблицаДокумента.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ТаблицаДокумента.Колонки.Добавить("ДопИзмерениеВидСубконто", ОписаниеТиповВидСубконто);
	ТаблицаДокумента.Колонки.Добавить("ДопИзмерение",            ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.
	// Поставщик.
	ТаблицаДокумента.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("КПСРасчетов",   Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДокумента.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДокумента.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаДокумента.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	//Комитент по закупке
	ТаблицаДокумента.Колонки.Добавить("Комитент",         Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДокумента.Колонки.Добавить("ДоговорКомитента", Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	// Количество и сумма поступивших единиц.
	ТаблицаДокумента.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ТаблицаДокумента.Колонки.Добавить("Сумма",         ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ТаблицаДокумента.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ТаблицаДокумента.Колонки.Добавить("СуммаНДС",      ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	// Дополнительные колонки.
	ТаблицаДокумента.Колонки.Добавить("ОтражениеВУСН",     Новый ОписаниеТипов("ПеречислениеСсылка.ОтражениеВУСН"));
	ТаблицаДокумента.Колонки.Добавить("НДСКРаспределению", Новый ОписаниеТипов("Булево"));
	ТаблицаДокумента.Колонки.Добавить("ПринятьНДСКВычету", Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Подготавливает таблицу документа (в унифицированном формате) для учета поступления материальных запасов.
//
Функция ПодготовитьТаблицуПоступлениеМатериальныхЗапасовПоДокументу(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ТаблицаДокумента = ПустаяТаблицаПоступлениеМатериальныхЗапасовПоДокументу();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Если ТипЗнч(Документ) = Тип("ДокументОбъект.ПоступлениеИК") Тогда
		ПоступлениеМатериальныхЗапасов =
			Документы.ПоступлениеИК.ПодготовитьТаблицуПоступлениеМатериальныхЗапасовПоДокументу(
				Документ, Параметры, Отказ);
		ВидыДопАналитики = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительнойАналитикиУчетаМЗ();
	Иначе

		Запрос = Новый Запрос;
		
		МетаданныеДокумента = Документ.Метаданные();
		
		Если МетаданныеДокумента.Имя = "ПоступлениеМЗВПути" Тогда
			
			ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
				"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,Контрагент,Договор,ВалютаДокумента,НДСКРаспределению,
				|СчетУчета,Номенклатура,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС,ПринятьНДСКВычету",
				Документ, Параметры);
			
			Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ
			|	""Материалы"" КАК ИмяСписка,
			|	""Материалы"" КАК СинонимСписка,
			|	Материалы.НомерСтроки КАК НомерСтроки,
			|	Материалы.ИФО КАК ИФО,
			|	Материалы.КФО КАК КФО,
			|	Материалы.КПС КАК КПС,
			|	Материалы.КЭК КАК КЭК,
			|	Материалы.Подразделение КАК Подразделение,
			|	ЕСТЬNULL(Материалы.СчетУчета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
			|	ЕСТЬNULL(Материалы.СчетУчета.РазрешитьНеУказыватьПодразделение, ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
			|	Материалы.СчетУчета КАК СчетУчета,
			|	Материалы.Номенклатура КАК Номенклатура,
			|	Материалы.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
			|	НЕОПРЕДЕЛЕНО КАК ДопАналитика,
			|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты) КАК ДопИзмерениеВидСубконто,
			|	Материалы.Контрагент КАК ДопИзмерение,
			|	Материалы.Контрагент КАК Контрагент,
			|	Материалы.Договор КАК Договор,
			|	Материалы.ВалютаДокумента КАК Валюта,
			|	Материалы.Количество КАК Количество,
			|	Материалы.Всего КАК Сумма,
			|	Материалы.СтавкаНДС КАК СтавкаНДС,
			|	Материалы.СуммаНДС КАК СуммаНДС,
			|	Материалы.НДСКРаспределению КАК НДСКРаспределению,
			|	Материалы.ПринятьНДСКВычету КАК ПринятьНДСКВычету
			|ИЗ
			|	ТаблицаМатериалы КАК Материалы
			|
			|УПОРЯДОЧИТЬ ПО
			|	НомерСтроки";
			
			ВидыДопАналитики = Новый Соответствие; // не предусмотрено
		
		ИначеЕсли МетаданныеДокумента.Имя = "АктПриемкиТоваровРаботУслуг" Тогда
			
			Параметры.Вставить("СинонимСписка", МетаданныеДокумента.ТабличныеЧасти.ТоварыРаботыУслуги.Синоним);
			ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ТоварыРаботыУслуги",
				"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,Контрагент,Договор,ВалютаДокумента,
				|Номенклатура,КоличествоПринято,СуммаПринято,СинонимСписка",
				Документ, Параметры);
			
			Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ
			|	""ТоварыРаботыУслуги"" КАК ИмяСписка,
			|	Материалы.СинонимСписка КАК СинонимСписка,
			|	Материалы.НомерСтроки КАК НомерСтроки,
			|	Материалы.ИФО КАК ИФО,
			|	Материалы.КФО КАК КФО,
			|	Материалы.КПС КАК КПС,
			|	Материалы.КЭК КАК КЭК,
			|	Материалы.Подразделение КАК Подразделение,
			|	ЛОЖЬ КАК УчетПоПодразделениям,
			|	ЛОЖЬ КАК РазрешитьНеУказыватьПодразделение,
			|	НЕОПРЕДЕЛЕНО КАК СчетУчета,
			|	ВЫРАЗИТЬ(Материалы.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
			|	ВЫРАЗИТЬ(Материалы.Номенклатура КАК Справочник.Номенклатура).ТипНоменклатуры КАК ТипНоменклатуры,
			|	НЕОПРЕДЕЛЕНО КАК ДопАналитика,
			|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка) КАК ДопИзмерениеВидСубконто,
			|	НЕОПРЕДЕЛЕНО КАК ДопИзмерение,
			|	Материалы.Контрагент КАК Контрагент,
			|	Материалы.Договор КАК Договор,
			|	Материалы.ВалютаДокумента КАК Валюта,
			|	Материалы.КоличествоПринято КАК Количество,
			|	Материалы.СуммаПринято КАК Сумма,
			|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
			|	0 КАК СуммаНДС,
			|	ЛОЖЬ КАК НДСКРаспределению,
			|	ЛОЖЬ КАК ПринятьНДСКВычету
			|ИЗ
			|	ТаблицаТоварыРаботыУслуги КАК Материалы
			|ГДЕ
			|	НЕ ВЫРАЗИТЬ(Материалы.Номенклатура КАК Справочник.Номенклатура).ТипНоменклатуры В (&ТипыУслугРабот)
			|
			|УПОРЯДОЧИТЬ ПО
			|	НомерСтроки";
			Запрос.УстановитьПараметр("ТипыУслугРабот", Перечисления.ТипыНоменклатуры.ПолучитьТипыУслугРабот());
			
			ВидыДопАналитики = Новый Соответствие; // не предусмотрено
			
		Иначе
			
			Если НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта("КПСРасчетов", Документ.Метаданные().ТабличныеЧасти.Материалы) Тогда
				Параметры.Вставить("КПСРасчетов", Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
			КонецЕсли;
			
			ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
				"НомерСтроки,ИФО,КФО,КПС,КПСРасчетов,КЭК,Подразделение,Контрагент,Договор,Комитент,ДоговорКомитента,ВалютаДокумента,НДСКРаспределению,ОтражениеВУСН,
				|СчетУчета,Номенклатура,ЦМО,ДополнительнаяАналитикаСчета,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС,ПринятьНДСКВычету",
				Документ, Параметры);
			
			Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ
			|	""Материалы"" КАК ИмяСписка,
			|	""Материалы"" КАК СинонимСписка,
			|	Материалы.НомерСтроки КАК НомерСтроки,
			|	Материалы.ИФО КАК ИФО,
			|	Материалы.КФО КАК КФО,
			|	Материалы.КПС КАК КПС,
			|	Материалы.КПСРасчетов КАК КПСРасчетов,
			|	Материалы.КЭК КАК КЭК,
			|	Материалы.Подразделение КАК Подразделение,
			|	ЕСТЬNULL(Материалы.СчетУчета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
			|	ЕСТЬNULL(Материалы.СчетУчета.РазрешитьНеУказыватьПодразделение, ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
			|	Материалы.СчетУчета КАК СчетУчета,
			|	Материалы.Номенклатура КАК Номенклатура,
			|	Материалы.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
			|	Материалы.ДополнительнаяАналитикаСчета КАК ДопАналитика,
			|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК ДопИзмерениеВидСубконто,
			|	Материалы.ЦМО КАК ДопИзмерение,
			|	Материалы.Контрагент КАК Контрагент,
			|	Материалы.Комитент КАК Комитент,
			|	Материалы.ДоговорКомитента КАК ДоговорКомитента,
			|	Материалы.Договор КАК Договор,
			|	Материалы.ВалютаДокумента КАК Валюта,
			|	Материалы.Количество КАК Количество,
			|	Материалы.Всего КАК Сумма,
			|	Материалы.СтавкаНДС КАК СтавкаНДС,
			|	Материалы.СуммаНДС КАК СуммаНДС,
			|	Материалы.НДСКРаспределению КАК НДСКРаспределению,
			|	Материалы.ОтражениеВУСН КАК ОтражениеВУСН,
			|	Материалы.ПринятьНДСКВычету КАК ПринятьНДСКВычету
			|ИЗ
			|	ТаблицаМатериалы КАК Материалы
			|
			|УПОРЯДОЧИТЬ ПО
			|	НомерСтроки";
			
			ВидыДопАналитики = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительнойАналитикиУчетаМЗ();
			
		КонецЕсли;
		
		ПоступлениеМатериальныхЗапасов = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	ОбязательноУказыватьПодразделение = Ложь;
	СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Поступление",
		Документ.Дата, Документ.Организация, Документ.ИФО);
	// При поступлении нужно анализировать переданный групповой счет, чтобы понимать
	// это от поставщика или подотчетника
	СчетРасчетовИзПараметров = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры,
		"СчетРасчетов",
		ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	Если ЗначениеЗаполнено(СчетРасчетовИзПараметров) И БухгалтерскийУчет.СчетВИерархии(СчетРасчетовИзПараметров, "208.00") Тогда
		СчетРасчетовМЗ = БухгалтерскийУчет.СчетПоКоду("208.34", Документ.Дата, Документ.Организация);
		СчетРасчетовБА = БухгалтерскийУчет.СчетПоКоду("208.36", Документ.Дата, Документ.Организация);
	Иначе
		СчетРасчетовМЗ = БухгалтерскийУчет.СчетПоКоду("302.34", Документ.Дата, Документ.Организация);
		СчетРасчетовБА = БухгалтерскийУчет.СчетПоКоду("302.36", Документ.Дата, Документ.Организация);
	КонецЕсли;
	
	КПСРасчетовШапка = Неопределено;
	Параметры.Свойство("КПС",КПСРасчетовШапка);
	КПСРасчетовВТЧ = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "КПСРасчетовВТЧ", Ложь);
	ИспользоватьКПСРасчетов = КПСРасчетовВТЧ ИЛИ ЗначениеЗаполнено(КПСРасчетовШапка);
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Для Каждого Строка Из ПоступлениеМатериальныхЗапасов Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'Номенклатура'"), Строка.НомерСтроки, Строка.СинонимСписка);
			ПолеКолонки = Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].Номенклатура";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка, ПолеКолонки, "Объект", Отказ);
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Не ИспользоватьВалютныйУчет И Не ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		
		НоваяСтрока.ДопАналитикаВидСубконто = ВидыДопАналитики.Получить(Строка.СчетУчета);
		
		Если ЗначениеЗаполнено(СчетРасчетов) Тогда
			НоваяСтрока.СчетРасчетов = СчетРасчетов;
		ИначеЕсли Строка.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.БиологическиеАктивы Тогда
			НоваяСтрока.СчетРасчетов = СчетРасчетовБА;
		Иначе
			НоваяСтрока.СчетРасчетов = СчетРасчетовМЗ;
		КонецЕсли;
		
		Если ИспользоватьКПСРасчетов Тогда
			Если НЕ КПСРасчетовВТЧ Тогда
				НоваяСтрока.КПСРасчетов = КПСРасчетовШапка; 
			КонецЕсли;
		Иначе
			НоваяСтрока.КПСРасчетов = НоваяСтрока.КПС;
		КонецЕсли; 
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.КЭК) Тогда
			НоваяСтрока.КЭК = БухгалтерскийУчет.КЭКНоменклатуры(
				Документ.Организация, НоваяСтрока.ИФО, НоваяСтрока.КФО, Документ.Дата,
				НоваяСтрока.СчетУчета, Строка.ТипНоменклатуры, "Дт");
		КонецЕсли;
		
		ОбязательноУказыватьПодразделение = ОбязательноУказыватьПодразделение
			ИЛИ (Строка.УчетПоПодразделениям И НЕ Строка.РазрешитьНеУказыватьПодразделение);
		
	КонецЦикла;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ОбязательноУказыватьПодразделение
	   И НЕ ЗначениеЗаполнено(Документ.Подразделение) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", МетаданныеДокумента.Реквизиты.Подразделение.Синоним);
		ТекстСообщения = ТекстСообщения + НСтр("ru='. Учет материальных запасов ведется по подразделениям.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			Документ.Ссылка, "Подразделение", "Объект", Отказ);
	КонецЕсли;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Структура таблицы источника данных "Поступление материальных запасов".
//
Функция ПустаяТаблицаПоступлениеМатериальныхЗапасов() Экспорт

	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета материальных запасов.
	ПустаяТаблица.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов")); 
	ПустаяТаблица.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("Комитент",         Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("ДоговорКомитента", Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("ДопАналитикаВидСубконто", ОписаниеТиповВидСубконто);
	ПустаяТаблица.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ПустаяТаблица.Колонки.Добавить("ДопИзмерениеВидСубконто", ОписаниеТиповВидСубконто);
	ПустаяТаблица.Колонки.Добавить("ДопИзмерение",            ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.
	// Поставщик.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КПСРасчетов",   Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Количество и сумма поступивших единиц.
	ПустаяТаблица.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ПустаяТаблица.Колонки.Добавить("СуммаНДСВал",   ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",   ОписаниеТипаСуммы); // Сумма НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",      ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",      ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ОтражениеВУСН",     Новый ОписаниеТипов("ПеречислениеСсылка.ОтражениеВУСН"));
	ПустаяТаблица.Колонки.Добавить("НДСКРаспределению", Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("ПринятьНДСКВычету", Новый ОписаниеТипов("Булево"));
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Поступление материальных запасов".
//
Функция ТаблицаПоступлениеМатериальныхЗапасов(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов=Неопределено, Знач Реквизиты = Неопределено, Отказ = Ложь) Экспорт
	
	ТаблицаПоступление = ПустаяТаблицаПоступлениеМатериальныхЗапасов();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаПоступление;
	КонецЕсли;
	
	Если Реквизиты = Неопределено Тогда
		Реквизиты = Новый Структура;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	УчетРасчетов.РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СтрокаПоступление = ТаблицаПоступление.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоступление, СтрокаДокумента);
		
		СтрокаПоступление.СуммаВал    = СтрокаДокумента.Сумма;
		СтрокаПоступление.СуммаНДСВал = СтрокаДокумента.СуммаНДС;
		
	КонецЦикла;
	
	Возврат ТаблицаПоступление;
	
КонецФункции

// Списание материальных запасов.

// Структура таблицы для функций ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу
// и ПодготовитьТаблицуСписаниеИмуществаКазныПоДокументу
// 
// Параметры:
//  ДобавитьКолонкуСумма - Булево - Добавить колонку сумма
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица списание материальных запасов по документу:
// * ИмяСписка - Строка -
// * СинонимСписка - Строка -
// * НомерСтроки - Число -
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения -
// * КФО - ПеречислениеСсылка.КВД -
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * КЭК - СправочникСсылка.КОСГУ -
// * Подразделение - СправочникСсылка.Подразделения -
// * СчетУчета - ПланСчетовСсылка.ЕПСБУ -
// * Номенклатура - СправочникСсылка.Номенклатура -
// * ДопАналитикаВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто -
// * ДопАналитика - Характеристика.ВидыСубконто -
// * ДопИзмерениеВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто -
// * ДопИзмерение - Характеристика.ВидыСубконто -
// * ПодразделениеПолучатель - СправочникСсылка.Подразделения -
// * ДопИзмерениеПолучатель - Характеристика.ВидыСубконто -
// * Количество - Число -
// * НеПересчитыватьСумму - Булево -
// * СуммаСписания - Число
// * СуммаСписанияНУ - Число
// * ОтражениеВУСН - ПеречислениеСсылка.ОтражениеВУСН -
// * Сумма - Число -
Функция ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу(ДобавитьКолонкуСумма = Ложь) Экспорт
	
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ТаблицаДокумента = Новый ТаблицаЗначений;
	// Идентификация строки.
	ТаблицаДокумента.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ТаблицаДокумента.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДокумента.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДокумента.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДокумента.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаДокумента.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета материальных запасов.
	ТаблицаДокумента.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДокумента.Колонки.Добавить("ДопАналитикаВидСубконто", ОписаниеТиповВидСубконто);
	ТаблицаДокумента.Колонки.Добавить("ДопАналитика",            ОписаниеТиповСубконто); // Реквизит ДополнительнаяАналитикаСчета табчасти.
	ТаблицаДокумента.Колонки.Добавить("ДопИзмерениеВидСубконто", ОписаниеТиповВидСубконто);
	ТаблицаДокумента.Колонки.Добавить("ДопИзмерение",            ОписаниеТиповСубконто); // ЦМО, Контрагент, ВидЗатрат и пр.
	// Получатель материальных запасов.
	ТаблицаДокумента.Колонки.Добавить("ПодразделениеПолучатель", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаДокумента.Колонки.Добавить("ДопИзмерениеПолучатель",  ОписаниеТиповСубконто);
	// Количество списываемых единиц.
	ТаблицаДокумента.Колонки.Добавить("Количество", ОписаниеТипаКоличества);
	// Суммы для списания без расчета себестоимости
	ТаблицаДокумента.Колонки.Добавить("НеПересчитыватьСумму", Новый ОписаниеТипов("Булево"));
	ТаблицаДокумента.Колонки.Добавить("СуммаСписания", ОписаниеТипаСуммы);
	ТаблицаДокумента.Колонки.Добавить("СуммаСписанияНУ", ОписаниеТипаСуммы);
	// Для целей налогового учета при УСН.
	ТаблицаДокумента.Колонки.Добавить("ОтражениеВУСН", Новый ОписаниеТипов("ПеречислениеСсылка.ОтражениеВУСН"));
	// Данные резервирования
	
	Если ДобавитьКолонкуСумма Тогда
		// Для списания МЗ ИК
		ТаблицаДокумента.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой)));
	КонецЕсли;
	
	Возврат ТаблицаДокумента;
	
КонецФункции


// Пустая таблица состав документа для списания материальных запасов по документу.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица состав документа для списания материальных запасов по документу:
// * ИмяСписка - Строка -
// * СинонимСписка - Строка -
// * НомерСтроки - Число -
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения -
// * КФО - ПеречислениеСсылка.КВД -
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * Подразделение - СправочникСсылка.Подразделения -
// * ПодразделениеПолучатель - СправочникСсылка.Подразделения -
// * УчетПоПодразделениям - Булево -
// * РазрешитьНеУказыватьПодразделение - Булево -
// * СчетУчета - ПланСчетовСсылка.ЕПСБУ -
// * Номенклатура - СправочникСсылка.Номенклатура -
// * ДопАналитика - Характеристика.ВидыСубконто 
// * ДопИзмерениеВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто -
// * ДопИзмерение - Характеристика.ВидыСубконто 
// * ДопИзмерениеПолучатель - Характеристика.ВидыСубконто 
// * Количество - Число -
Функция ПустаяТаблицаСоставДокументаДляСписанияМатериальныхЗапасовПоДокументу() Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ИмяСписка", Новый ОписаниеТипов("Строка")); 
	Результат.Колонки.Добавить("СинонимСписка", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	Результат.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Результат.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Результат.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Результат.Колонки.Добавить("ПодразделениеПолучатель", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Результат.Колонки.Добавить("УчетПоПодразделениям", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("РазрешитьНеУказыватьПодразделение", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("СчетУчета", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("ДопАналитика", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	Результат.Колонки.Добавить("ДопИзмерениеВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	Результат.Колонки.Добавить("ДопИзмерение", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	Результат.Колонки.Добавить("ДопИзмерениеПолучатель", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Возврат Результат;

КонецФункции

// Подготавливает таблицу документа (в унифицированном формате) для учета списания материальных запасов.
// 
// Параметры:
//  Документ - ДокументОбъект
//  Параметры - Структура
//  Отказ - Булево
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу
Функция ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ТаблицаДокумента = ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	Если НЕ Параметры.Свойство("ПоВсемКФО") Тогда
		Параметры.Вставить("ПоВсемКФО", Ложь);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	// Подразделение.
	ИмяРеквизитаПодразделение = "";
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ПодразделениеОтправитель", МетаданныеДокумента) Тогда
		Параметры.Вставить("Подразделение", Документ.ПодразделениеОтправитель);
		ИмяРеквизитаПодразделение = "ПодразделениеОтправитель";
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Подразделение", МетаданныеДокумента) Тогда
		ИмяРеквизитаПодразделение = "Подразделение";
	КонецЕсли;
	
	// ЦМО.
	ИмяРеквизитаЦМО = "";
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ЦМООтправитель", МетаданныеДокумента) Тогда
		Параметры.Вставить("ЦМО", Документ.ЦМООтправитель);
		ИмяРеквизитаЦМО = "ЦМООтправитель";
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ЦМО", МетаданныеДокумента) Тогда
		ИмяРеквизитаЦМО = "ЦМО";
	КонецЕсли;
	
	ЕстьТабЧастьМатериалы            = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("Материалы", МетаданныеДокумента);
	ЕстьТабЧастьНоменклатура         = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("Номенклатура", МетаданныеДокумента);
	ЕстьТабЧастьМатериальныеЗапасы   = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("МатериальныеЗапасы", МетаданныеДокумента);
	ЕстьТабЧастьОсновныеСредства     = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("ОсновныеСредства", МетаданныеДокумента);
	
	// В документе может не быть реквизита НеПересчитыватьСумму.
	// В этом случае колонки, содержащие суммы заполняем нулями.
	Параметры.Вставить("НеПересчитыватьСумму", Ложь);
	Параметры.Вставить("СуммаСписания", 0);
	Параметры.Вставить("СуммаСписанияНУ", 0);
	
	Если ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.МенюТребование") Тогда
		ДобавитьПараметрКЭКМенюТребования(Параметры, Документ);
	КонецЕсли;
	
	ИспользоватьМенеджерДокумента = ЕстьФункцияПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументуВМенеджере(Документ);
	
	Если ИспользоватьМенеджерДокумента Тогда
		СписаниеМатериальныхЗапасов = ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументуВМенеджере(Документ, Параметры);
	ИначеЕсли ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ОприходованиеМЗПоФактическойСтоимости")
		ИЛИ ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ОприходованиеМЗПоФактическойСтоимостиИК") Тогда
		
		ИмяТабЧасти = "Материалы";
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
			"НомерСтроки,ИФО,КФО,КПСКредита,КЭККредита,Подразделение,ПодразделениеОтправитель,ЦМООтправитель,
			|СчетКредита,Номенклатура,ЦМО,ВидЗатрат,Количество,
			|Сумма",
			Документ, Параметры);

		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""Материалы"" КАК ИмяСписка,
		|	""Материалы"" КАК СинонимСписка,
		|	Материалы.НомерСтроки КАК НомерСтроки,
		|	Материалы.ИФО КАК ИФО,
		|	Материалы.КФО КАК КФО,
		|	Материалы.КПСКредита КАК КПС,
		|	Материалы.КЭККредита КЭК,
		|	Материалы.ПодразделениеОтправитель КАК Подразделение,
		|	Материалы.Подразделение КАК ПодразделениеПолучатель,
		|	ЕСТЬNULL(Материалы.СчетКредита.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
		|	ЕСТЬNULL(Материалы.СчетКредита.РазрешитьНеУказыватьПодразделение, ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
		|	Материалы.СчетКредита КАК СчетУчета,
		|	Материалы.Номенклатура КАК Номенклатура,
		|	Материалы.ВидЗатрат КАК ДопАналитика,
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК ДопИзмерениеВидСубконто,
		|	Материалы.ЦМООтправитель КАК ДопИзмерение,
		|	Материалы.ЦМО КАК ДопИзмерениеПолучатель,
		|	Материалы.Количество КАК Количество,
		|	ЛОЖЬ КАК НеПересчитыватьСумму,
		|	Сумма КАК СуммаСписания,
		|	Сумма КАК СуммаСписанияНУ
		|ИЗ
		|	ТаблицаМатериалы КАК Материалы
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	ИначеЕсли ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ТаксировкаПутевогоЛиста")
		ИЛИ ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ТаксировкаРабочегоЛистаАгрегата") Тогда
		
		ИмяТабЧасти = "Материалы";
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
			"НомерСтроки,ИФО,КФО,КПС,КПСДт,Подразделение,ПодразделениеДт,
			|СчетУчета,Номенклатура,ЦМО,ДополнительнаяАналитикаСчета,Количество",
			Документ, Параметры);

		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""Материалы"" КАК ИмяСписка,
		|	""Материалы"" КАК СинонимСписка,
		|	Материалы.НомерСтроки КАК НомерСтроки,
		|	Материалы.ИФО КАК ИФО,
		|	Материалы.КФО КАК КФО,
		|	Материалы.КПС КАК КПС,
		|	Материалы.Подразделение КАК Подразделение,
		|	ВЫБОР
		|		КОГДА Материалы.ПодразделениеДт <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|			ТОГДА Материалы.ПодразделениеДт
		|		ИНАЧЕ Материалы.Подразделение
		|	КОНЕЦ КАК ПодразделениеПолучатель,
		|	ЕСТЬNULL(Материалы.СчетУчета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
		|	ЕСТЬNULL(Материалы.СчетУчета.РазрешитьНеУказыватьПодразделение, ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
		|	Материалы.СчетУчета КАК СчетУчета,
		|	Материалы.Номенклатура КАК Номенклатура,
		|	Материалы.ДополнительнаяАналитикаСчета КАК ДопАналитика,
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК ДопИзмерениеВидСубконто,
		|	Материалы.ЦМО КАК ДопИзмерение,
		|	Материалы.ЦМО КАК ДопИзмерениеПолучатель,
		|	Материалы.Количество КАК Количество
		|ИЗ
		|	ТаблицаМатериалы КАК Материалы
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	ИначеЕсли ЕстьТабЧастьМатериалы Тогда
		
		ИмяТабЧасти = "Материалы";
		
		СписаниеСЗабалансовогоСчета = ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ПоступлениеМЗ")
			И Документ.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ОприходованиеСЗабалансовогоСчета
			И ЗначениеЗаполнено(Документ.ЗабалансовыйСчет);
		
		Если  СписаниеСЗабалансовогоСчета Тогда
			
			ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
				"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,ПодразделениеПолучатель,ЦМОПолучатель,
				|ЗабалансовыйСчет,Номенклатура,ЦМО,ДополнительнаяАналитикаСчета,Количество,
				|НеПересчитыватьСумму,СуммаСписания,СуммаСписанияНУ,
				|СубконтоЗабалансовыйСчет1,СубконтоЗабалансовыйСчет2,СубконтоЗабалансовыйСчет3",
				Документ, Параметры);
			
			ШаблонТекстаЗапроса =
			"ВЫБРАТЬ
			|	""Материалы"" КАК ИмяСписка,
			|	""Материалы"" КАК СинонимСписка,
			|	Материалы.НомерСтроки КАК НомерСтроки,
			|	Материалы.ИФО КАК ИФО,
			|	Материалы.КФО КАК КФО,
			|	Материалы.КПС КАК КПС,
			|	Материалы.КЭК КАК КЭК,
			|	Материалы.Подразделение КАК Подразделение,
			|	Материалы.Подразделение КАК ПодразделениеПолучатель,
			|	ЕСТЬNULL(Материалы.ЗабалансовыйСчет.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
			|	ЕСТЬNULL(Материалы.ЗабалансовыйСчет.РазрешитьНеУказыватьПодразделение, ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
			|	Материалы.ЗабалансовыйСчет КАК СчетУчета,
			|	Материалы.Номенклатура КАК Номенклатура,
			|	&ДопАналитика КАК ДопАналитика,
			|	&ВидСубконтоДопИзмерение КАК ДопИзмерениеВидСубконто,
			|	&ДопИзмерение КАК ДопИзмерение,
			|	&ДопИзмерение КАК ДопИзмерениеПолучатель,
			|	Материалы.Количество КАК Количество,
			|	Материалы.НеПересчитыватьСумму КАК НеПересчитыватьСумму,
