	               |		ПО ТабНоменклатура_ИС.Номенклатура = ТабОстатков.Номенклатура
	               |			И ТабНоменклатура_ИС.КВД = ТабОстатков.КВД
	               |			И ТабНоменклатура_ИС.Баланс = ТабОстатков.Баланс
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номенклатура,
	               |	КВД УБЫВ
	               |ИТОГИ ПО
	               |	Номенклатура";
	Запрос.Текст = ТекстЗапроса;
	МассивРезультатов = Запрос.ВыполнитьПакет();
	ДеревоКД         = МассивРезультатов[0].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоИС         = МассивРезультатов[1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоОстатков   = МассивРезультатов[4].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоКД_ИС      = МассивРезультатов[5].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
