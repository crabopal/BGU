// Устарела.
// Заполняет идентификатор и представление печатной формы.
// 
// Параметры:
//  Объект - ДокументОбъект:
//   * ИдентификаторПечатнойФормы - Строка
//   * ПредставлениеПечатнойФормы - Строка
//  ИдентификаторПечатнойФормы - Строка
Процедура ЗаполнитьПечатнуюФорму(Объект, ИдентификаторПечатнойФормы) Экспорт
	КомандыПечати = УправлениеПечатью.СоздатьКоллекциюКомандПечати();
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(Объект.Метаданные().ПолноеИмя());
	МенеджерОбъекта.ДобавитьКомандыПечати(КомандыПечати);
	СтрокаКоманды = КомандыПечати.Найти(ИдентификаторПечатнойФормы, "Идентификатор");
	Если СтрокаКоманды <> Неопределено Тогда
		Объект.ИдентификаторПечатнойФормы = ИдентификаторПечатнойФормы;
		Объект.ПредставлениеПечатнойФормы = СтрокаКоманды.Представление;
	КонецЕсли;	
КонецПроцедуры

Функция ПустаяСтруктураПараметровДляСписанияМЗ() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Ссылка",						Неопределено);
	Результат.Вставить("Дата",							'00010101');
	Результат.Вставить("Счет",							ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	Результат.Вставить("Организация",					Справочники.Организации.ПустаяСсылка());
	Результат.Вставить("КФО",							Перечисления.КВД.ПустаяСсылка());
	Результат.Вставить("КПС",							Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
	Результат.Вставить("ИФО",							Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	Результат.Вставить("Подразделение",					Справочники.Подразделения.ПустаяСсылка());
	Результат.Вставить("ДополнительноеСубконтоОтбора",	Неопределено);
	Результат.Вставить("ЦМО",							Справочники.ЦМО.ПустаяСсылка());
	Возврат Результат;
КонецФункции

Функция ТаблицаМЗДляСписанияЗабаланс(Параметры) Экспорт

	Счет = Параметры.Счет;
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаМатериалы.НомерСтроки,
	               |	ВЫРАЗИТЬ(ТаблицаМатериалы.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	               |	ТаблицаМатериалы.Количество,
	               |	ТаблицаМатериалы.ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета
	               |ПОМЕСТИТЬ ТаблицаМатериалы
	               |ИЗ
	               |	&ТаблицаМатериалы КАК ТаблицаМатериалы
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура,
	               |	ДополнительнаяАналитикаСчета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаМатериалы.Номенклатура КАК Номенклатура,
	               |	ТаблицаМатериалы.ДополнительнаяАналитикаСчета КАК ДополнительнаяАналитикаСчета,
	               |	МИНИМУМ(ТаблицаМатериалы.НомерСтроки) КАК МинимумНомерСтроки,
	               |	СУММА(ТаблицаМатериалы.Количество) КАК СуммаКоличество,
	               |	МАКСИМУМ(ТаблицаМатериалы.Количество) КАК МаксимумКоличество
	               |ПОМЕСТИТЬ ТаблицаМатериалыВсего
	               |ИЗ
	               |	ТаблицаМатериалы КАК ТаблицаМатериалы
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаМатериалы.Номенклатура,
	               |	ТаблицаМатериалы.ДополнительнаяАналитикаСчета
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура,
	               |	ДополнительнаяАналитикаСчета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ЦМО) КАК ЦМО,";
	Если СвойстваСчета.КоличествоСубконто = 3 Тогда
		ТекстЗапроса = ТекстЗапроса + "
	               |	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Субконто3,";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
	               |ПОМЕСТИТЬ Остатки
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			Счет = &Счет,
	               |			&ВидыСубконто,
	               |			Организация = &Организация
	               |				И КФО = &КФО
	               |				И &УсловиеКПС
	               |				И &УсловиеИФО
	               |				И &УсловиеПодразделение
	               |				И Субконто1 В
	               |					(ВЫБРАТЬ
	               |						ТаблицаМатериалы.Номенклатура
	               |					ИЗ
	               |						ТаблицаМатериалы КАК ТаблицаМатериалы)
	               |				И Субконто2 = &ЦМО
	               |				И &УсловиеСубконто3) КАК ЖурналПроводокЕПСБУОстатки
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура";
	Если СвойстваСчета.КоличествоСубконто = 3 Тогда				   
		ТекстЗапроса = ТекстЗапроса + ",
	               |	Субконто3";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаМатериалы.НомерСтроки КАК НомерСтроки,
	               |	ТаблицаМатериалы.Номенклатура,
	               |	ТаблицаМатериалы.ДополнительнаяАналитикаСчета,
	               |	ТаблицаМатериалы.Количество,
	               |	ТаблицаМатериалы.Номенклатура.Представление КАК ПредставлениеНоменклатуры,
	               |	ТаблицаМатериалы.Номенклатура.ЕдиницаИзмерения.Представление КАК ПредставлениеЕдиницыИзмерения,
	               |	ЕСТЬNULL(Остатки.КоличествоОстатокДт, 0) КАК КоличествоОстаток,
	               |	ЕСТЬNULL(Остатки.СуммаОстатокДт, 0) КАК СуммаОстаток,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(Остатки.КоличествоОстатокДт, 0) = 0
	               |			ТОГДА ВЫРАЗИТЬ(0 КАК ЧИСЛО(18, 2))
	               |		ИНАЧЕ (ВЫРАЗИТЬ(Остатки.СуммаОстатокДт / Остатки.КоличествоОстатокДт КАК ЧИСЛО(18, 2))) * ТаблицаМатериалы.Количество
	               |	КОНЕЦ КАК Сумма,
	               |	ВЫБОР
	               |		КОГДА ТаблицаМатериалыВсего.СуммаКоличество > ЕСТЬNULL(Остатки.КоличествоОстатокДт, 0)
	               |				И ТаблицаМатериалы.НомерСтроки = ТаблицаМатериалыВсего.МинимумНомерСтроки
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Нехватка,
	               |	ТаблицаМатериалыВсего.СуммаКоличество КАК КоличествоПоДокументуВсего,
	               |	ВЫБОР
	               |		КОГДА ТаблицаМатериалы.Количество = ТаблицаМатериалыВсего.МаксимумКоличество
	               |				И ТаблицаМатериалы.НомерСтроки В
	               |					(ВЫБРАТЬ ПЕРВЫЕ 1
	               |						ТаблицаМатериалы.НомерСтроки КАК НомерСтроки
	               |					ИЗ
	               |						ТаблицаМатериалы КАК ТаблицаМатериалы
	               |					ГДЕ
	               |						ТаблицаМатериалы.Номенклатура = ТаблицаМатериалы.Номенклатура
	               |						И ТаблицаМатериалы.Количество = ТаблицаМатериалыВсего.МаксимумКоличество
	               |						И ТаблицаМатериалы.ДополнительнаяАналитикаСчета = ТаблицаМатериалы.ДополнительнаяАналитикаСчета
	               |					УПОРЯДОЧИТЬ ПО
	               |						НомерСтроки)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК СтрокаКорректировки
	               |ИЗ
	               |	ТаблицаМатериалы КАК ТаблицаМатериалы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	               |		ПО ТаблицаМатериалы.Номенклатура = Остатки.Номенклатура";
	Если СвойстваСчета.КоличествоСубконто = 3 Тогда				   
		ТекстЗапроса = ТекстЗапроса + "
	               |			И ТаблицаМатериалы.ДополнительнаяАналитикаСчета = Остатки.Субконто3";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаМатериалыВсего КАК ТаблицаМатериалыВсего
	               |		ПО ТаблицаМатериалы.Номенклатура = ТаблицаМатериалыВсего.Номенклатура
	               |			И ТаблицаМатериалы.ДополнительнаяАналитикаСчета = ТаблицаМатериалыВсего.ДополнительнаяАналитикаСчета
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	
	ТаблицаМатериалы = БухгалтерскиеОперацииПовтИсп.ТаблицаДокументаДляСписанияМЗЗабаланс(Параметры.Ссылка);
	Запрос = Новый Запрос(ТекстЗапроса);
	Если Параметры.Ссылка = Неопределено Тогда
		Период = Новый Граница(Параметры.Дата, ВидГраницы.Исключая);
	Иначе
		Период = Новый Граница(Параметры.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	Запрос.УстановитьПараметр("ТаблицаМатериалы",	ТаблицаМатериалы);
	Запрос.УстановитьПараметр("Ссылка", 			Параметры.Ссылка);
	Запрос.УстановитьПараметр("Период", 			Период);
	Запрос.УстановитьПараметр("Организация",		Параметры.Организация);
	Запрос.УстановитьПараметр("КФО", 				Параметры.КФО);
	Запрос.УстановитьПараметр("ЦМО", 				Параметры.ЦМО);
	Запрос.УстановитьПараметр("Счет", 				Параметры.Счет);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", Параметры.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");	
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И СвойстваСчета.УчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "Подразделение = &Подразделение");
		Запрос.УстановитьПараметр("Подразделение", Параметры.Подразделение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ИСТИНА");
	КонецЕсли;
	Если СвойстваСчета.УчетПоКПС Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС", "КПС = &КПС");
		Запрос.УстановитьПараметр("КПС", Параметры.КПС);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС", "ИСТИНА");
	КонецЕсли;
	
	МассивСубконто = Новый Массив;
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	Для Счетчик = 1 По 3 Цикл
		Если ЗначениеЗаполнено(СвойстваСчета["ВидСубконто" + Счетчик]) Тогда
			Если СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.Номенклатура
				И СвойстваСчета["ВидСубконто" + Счетчик] <> ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
				МассивСубконто.Добавить(СвойстваСчета["ВидСубконто" + Счетчик]);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	Запрос.УстановитьПараметр("ВидыСубконто", МассивСубконто);
	Если МассивСубконто.Количество() = 3 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСубконто3", "Субконто3 В (&Субконто3)");
		Запрос.УстановитьПараметр("Субконто3", ТаблицаМатериалы.ВыгрузитьКолонку("ДополнительнаяАналитикаСчета"));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСубконто3", "ИСТИНА");
	КонецЕсли;
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	ТаблицаОстатков.Индексы.Добавить("Нехватка");
	
	Для каждого ТекСтрокаОстатков Из ТаблицаОстатков Цикл
	
		Если ТекСтрокаОстатков.СтрокаКорректировки Тогда
			Если ТекСтрокаОстатков.КоличествоОстаток = ТекСтрокаОстатков.Количество Тогда
				ТекСтрокаОстатков.Сумма = ТекСтрокаОстатков.СуммаОстаток;
			ИначеЕсли ТекСтрокаОстатков.КоличествоПоДокументуВсего <> ТекСтрокаОстатков.Количество Тогда
				СтрокиТекНоменклатуры = ТаблицаОстатков.НайтиСтроки(Новый Структура("Номенклатура, ДополнительнаяАналитикаСчета",
																					ТекСтрокаОстатков.Номенклатура,
																					ТекСтрокаОстатков.ДополнительнаяАналитикаСчета));
				СуммаПоУчетнойЦене = ТаблицаОстатков.Скопировать(СтрокиТекНоменклатуры).Итог("Сумма");
				СуммаКорректировки = ТекСтрокаОстатков.СуммаОстаток - СуммаПоУчетнойЦене;
				ТекСтрокаОстатков.Сумма = ТекСтрокаОстатков.Сумма + СуммаКорректировки;
				
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла; 
	
	Возврат ТаблицаОстатков;

КонецФункции // ТаблицаМЗДляСписанияЗабаланс()

// Выполняет запрос по остаткам регистра бухгалтерии. Формирует таблицу остатков МЗ.
// Индексирует таблицу остатков.
//
//	Запрос (Запрос). Объект запрос с установленными параметрами
//	ТаблицаОстатков. Параметр, в котором вернется таблица остатков
//	ТекстСообщения. Параметр, в котором текст сообщения, в случае неудачного выполнения запроса.
//
//	Возвращает Истина, если запрос удался, Ложь - в противном случае.
Функция СформироватьТаблицуОстатковМЗ(Запрос, ТаблицаОстатков, ТекстСообщения="") Экспорт
	Если ТипЗнч(Запрос) <> Тип("Запрос") Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	ТекИФО = "";
	Если Запрос.Параметры.Свойство("ИФО", ТекИФО) Тогда
		ЗнакВыраженияДляИФО = ?(ТипЗнч(ТекИФО) = Тип("Массив"), " В ", " = ");
	КонецЕсли;	
	
	ТекКФО = "";
	Если Запрос.Параметры.Свойство("КФО", ТекКФО) Тогда
		ЗнакВыраженияДляКФО = ?(ТипЗнч(ТекКФО) = Тип("Массив"), " В ", " = ");
	КонецЕсли;	
	
	ТекКПС = "";
	Если Запрос.Параметры.Свойство("КПС", ТекКПС) Тогда
		ЗнакВыраженияДляКПС = ?(ТипЗнч(ТекКПС) = Тип("Массив"), " В ", " = ");
	КонецЕсли;	
	
	ТекЦМО = "";
	Если Запрос.Параметры.Свойство("ЦМО", ТекЦМО) Тогда
		ЗнакВыраженияДляЦМО = ?(ТипЗнч(ТекЦМО) = Тип("Массив"), " В ", " = ");
	КонецЕсли;	
	
	ТекПодразделение = "";
	Если Запрос.Параметры.Свойство("Подразделение", ТекПодразделение) Тогда
		ЗнакВыраженияДляПодразделения = ?(ТипЗнч(ТекПодразделение) = Тип("Массив"), " В ", " = ");
	КонецЕсли;	
	
	ЕстьУчетПоИФО            = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ЕстьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЕПСБУОстатки.Организация,
					|	" + ?(ЕстьУчетПоИФО, "ЕПСБУОстатки.ИФО", "НЕОПРЕДЕЛЕНО") + " КАК ИФО,
					|	ЕПСБУОстатки.КФО,
					|	" + ?(ЕстьУчетПоПодразделениям, "ЕПСБУОстатки.Подразделение", "НЕОПРЕДЕЛЕНО") + " КАК Подразделение,
	
					|	ЕПСБУОстатки.КПС,
					|	ЕПСБУОстатки.Счет,
					|	ЕПСБУОстатки.Субконто1,
					|	ЕПСБУОстатки.Субконто2,
					|	ЕСТЬNULL(ЕПСБУОстатки.КоличествоОстаток, 0) КАК Количество,
					|	ЕСТЬNULL(ЕПСБУОстатки.СуммаОстаток, 0) КАК Сумма
					|ПОМЕСТИТЬ ОстаткиПоЦМО
					|ИЗ
					|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
					|				&ДатаЗапроса,
					|				Счет.Ссылка В ИЕРАРХИИ (&Счета),
					|				,
					|				" + ?(ЕстьУчетПоИФО, "ИФО " + ЗнакВыраженияДляИФО + " (&ИФО) И", "") + "
					|					Организация = &Организация
					|					И КФО " + ЗнакВыраженияДляКФО + " (&КФО)
					|					И  КПС " + ЗнакВыраженияДляКПС + " (&КПС)
					
					|					" + ?(ЕстьУчетПоПодразделениям, "И Подразделение " + ЗнакВыраженияДляПодразделения + " (&Подразделение)", "") + "
					|					И Субконто1 В (&Номенклатура)
					|					И Субконто2 " + ЗнакВыраженияДляЦМО + " (&ЦМО)) КАК ЕПСБУОстатки
					|ГДЕ
					|	ЕПСБУОстатки.КоличествоОстаток <> 0
					|;
					|////////////////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЕПСБУВидыСубконто.Ссылка КАК Счет,
					|	МАКСИМУМ(ВЫБОР
					|			КОГДА ЕПСБУВидыСубконто.ВидСубконто = &ВидСубконтоНоменклатура
					|				ТОГДА ЕПСБУВидыСубконто.Суммовой
					|			ИНАЧЕ ЛОЖЬ
					|		КОНЕЦ) КАК СуммовойНоменклатура,
					|	МАКСИМУМ(ВЫБОР
					|			КОГДА ЕПСБУВидыСубконто.ВидСубконто = &ВидСубконтоЦМО
					|				ТОГДА ЕПСБУВидыСубконто.Суммовой
					|			ИНАЧЕ ЛОЖЬ
					|		КОНЕЦ) КАК СуммовойЦМО
					|ПОМЕСТИТЬ ТаблицаПризнаковУчетаСубконто
					|ИЗ
					|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
					|ГДЕ
					|	ЕПСБУВидыСубконто.Ссылка В ИЕРАРХИИ(&Счета)
					|	И ЕПСБУВидыСубконто.Ссылка.ЭлементГруппа = ЛОЖЬ

					|СГРУППИРОВАТЬ ПО
					|	ЕПСБУВидыСубконто.Ссылка					
					|
					|
					|;
					|////////////////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЕПСБУОстатки.Организация,
					|	" + ?(ЕстьУчетПоИФО, "ЕПСБУОстатки.ИФО", "НЕОПРЕДЕЛЕНО") + " КАК ИФО,
					|	ЕПСБУОстатки.КФО,
					|	" + ?(ЕстьУчетПоПодразделениям, "ЕПСБУОстатки.Подразделение", "НЕОПРЕДЕЛЕНО") + " КАК Подразделение,
					|	ЕПСБУОстатки.КПС КАК КПСКт,
					|	ЕПСБУОстатки.Счет КАК СчетКт,
					|	ЕПСБУОстатки.Субконто1 КАК СубконтоКт1,
					|	ОстаткиПоЦМО.Субконто2 КАК СубконтоКт2,
					|	ЕПСБУОстатки.КоличествоОстаток КАК Количество,
					|	ВЫБОР
					|		КОГДА ЕПСБУОстатки.КоличествоОстаток = 0
					|				ИЛИ ЕПСБУОстатки.КоличествоОстаток ЕСТЬ NULL 
					|			ТОГДА 0
					|		ИНАЧЕ ЕПСБУОстатки.СуммаОстаток / ЕПСБУОстатки.КоличествоОстаток
					|	КОНЕЦ КАК Цена,
					|	ВЫБОР
					|		КОГДА ЕПСБУОстатки.КоличествоОстаток = 0
					|				ИЛИ ЕПСБУОстатки.КоличествоОстаток ЕСТЬ NULL 
					|			ТОГДА 0
					|		ИНАЧЕ ОстаткиПоЦМО.Количество * ЕПСБУОстатки.СуммаОстаток / ЕПСБУОстатки.КоличествоОстаток
					|	КОНЕЦ КАК Сумма
					|ИЗ
					|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
					|			&ДатаЗапроса,
					|			Счет.Ссылка В (ВЫБРАТЬ Таб.Счет ИЗ ТаблицаПризнаковУчетаСубконто КАК Таб ГДЕ Таб.СуммовойНоменклатура И НЕ Таб.СуммовойЦМО),
					|			,
					|			" + ?(ЕстьУчетПоИФО, "ИФО " + ЗнакВыраженияДляИФО + " (&ИФО) И", "") + "
					|				Организация = &Организация
					|				И КФО " + ЗнакВыраженияДляКФО + " (&КФО)
					|				И КПС " + ЗнакВыраженияДляКПС + " (&КПС)
					|				" + ?(ЕстьУчетПоПодразделениям, "И Подразделение " + ЗнакВыраженияДляПодразделения + " (&Подразделение)", "") + "
					|				И Субконто1 В (&Номенклатура)) КАК ЕПСБУОстатки
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиПоЦМО КАК ОстаткиПоЦМО
					|		ПО ЕПСБУОстатки.Счет = ОстаткиПоЦМО.Счет
					|			И ЕПСБУОстатки.КФО = ОстаткиПоЦМО.КФО
					|			" + ?(ЕстьУчетПоПодразделениям, "И ЕПСБУОстатки.Подразделение = ОстаткиПоЦМО.Подразделение", "") + "
					|			И ЕПСБУОстатки.КПС = ОстаткиПоЦМО.КПС
					|			И ЕПСБУОстатки.Субконто1 = ОстаткиПоЦМО.Субконто1
					|			" + ?(ЕстьУчетПоИФО, "И ЕПСБУОстатки.ИФО = ОстаткиПоЦМО.ИФО", "") + "
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	ОстаткиПоЦМО.Организация,
					|	" + ?(ЕстьУчетПоИФО, "ОстаткиПоЦМО.ИФО", "НЕОПРЕДЕЛЕНО") + ",
					|	ОстаткиПоЦМО.КФО,
					|	" + ?(ЕстьУчетПоПодразделениям, "ОстаткиПоЦМО.Подразделение", "НЕОПРЕДЕЛЕНО") + ",
					|	ОстаткиПоЦМО.КПС,
					|	ОстаткиПоЦМО.Счет,
					|	ОстаткиПоЦМО.Субконто1,
					|	ОстаткиПоЦМО.Субконто2,
					|	ОстаткиПоЦМО.Количество,
					|	ВЫБОР
					|		КОГДА ОстаткиПоЦМО.Количество = 0
					|				ИЛИ ОстаткиПоЦМО.Количество ЕСТЬ NULL 
					|			ТОГДА 0
					|		ИНАЧЕ ОстаткиПоЦМО.Сумма / ОстаткиПоЦМО.Количество
					|	КОНЕЦ,
					|	ОстаткиПоЦМО.Сумма
					|ИЗ
					|	ОстаткиПоЦМО КАК ОстаткиПоЦМО
					|ГДЕ
					|	ОстаткиПоЦМО.Счет В (ВЫБРАТЬ Таб.Счет ИЗ ТаблицаПризнаковУчетаСубконто КАК Таб ГДЕ Таб.СуммовойНоменклатура И Таб.СуммовойЦМО)
					|
					|";
					
	Запрос.УстановитьПараметр("ВидСубконтоНоменклатура", ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);				
	Запрос.УстановитьПараметр("ВидСубконтоЦМО", ПланыВидовХарактеристик.ВидыСубконто.ЦМО);				
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	ТаблицаОстатков.Индексы.Добавить("СчетКт, КПСКт, СубконтоКт1, СубконтоКт2");
	
	Возврат Истина;
КонецФункции	

// Выполняет запрос по остаткам регистра бухгалтерии по забалансовым счетам. Формирует 
// таблицу остатков МЗ. Индексирует таблицу остатков.
//
//	Запрос (Запрос). Объект запрос с установленными параметрами
//	КолСубконтоНаСчете (Число). Количество субконто на счете, по которому делаем запрос.
//	ТаблицаОстатков. Параметр, в котором вернется таблица остатков
//	ТекстСообщения. Параметр, в котором текст сообщения, в случае неудачного выполнения запроса.
//
//	Возвращает Истина, если запрос удался, Ложь - в противном случае.
Функция СформироватьТаблицуОстатковМЗЗабаланс(Запрос, КолСубконтоНаСчете, ТаблицаОстатков, ТекстСообщения="") Экспорт
	ПоляВыборкиСубконто = "";			   
	ПоляУсловийСубконто = "";			   
	Для к = 1 по КолСубконтоНаСчете Цикл
		ПоляВыборкиСубконто = ПоляВыборкиСубконто + "			   
		               |	ЕПСБУОстатки.Субконто" + к + ",";
					   
		ПоляУсловийСубконто = ПоляУсловийСубконто + "			   
								|			И Субконто" + к + " В (&МассивСубконто" + к + ")";
	КонецЦикла;				   
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЕПСБУОстатки.КФО,
					|	ЕПСБУОстатки.Счет," + ПоляВыборкиСубконто + "
					|	ЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстаток,
					|	ЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстаток,
					|	ЕПСБУОстатки.СуммаОстатокДт / ЕПСБУОстатки.КоличествоОстатокДт КАК Цена
					|ИЗ
					|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
					|			&ДатаЗапроса,
					|			Счет.Ссылка В (&МассивСчетов),
					|			,
					|			Организация = &ТекОрганизация
					|				И ИФО = &ТекИФО
					|				И КФО В (&МассивКФО)" + ПоляУсловийСубконто + "
					|				) КАК ЕПСБУОстатки
					|ГДЕ
					|	ЕПСБУОстатки.КоличествоОстатокДт > 0";
	
					
	Запрос.Текст = ТекстЗапроса;
	
	Попытка			   
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		ТекстСообщения = "Не удалось выполнить запрос по остаткам";
		Возврат Ложь;
	КонецПопытки;	
	
	ТаблицаОстатков = РезультатЗапроса.Выгрузить();
	СтрокаИндекса = "КФО,Счет";
	Для к = 1 по КолСубконтоНаСчете Цикл
		СтрокаИндекса = СтрокаИндекса + ",Субконто" + к;
	КонецЦикла;	
	ТаблицаОстатков.Индексы.Добавить(СтрокаИндекса);
	
	Возврат Истина;
КонецФункции	

// Формирует таблицу забалансовых счетов, с необходимыми параметрами счетов
// Используется в документах по учету МЗ на забалансовых счетах
//
// МассивКодов (Массив). Элементы массива содержат коды счетов, таблицу по которым
//						нужно получить
//
// возвращает таблицу значений
Функция ПолучитьТаблицуЗабалансовыхСчетов(МассивКодов) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивКодовСчетов", МассивКодов);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕПСБУ.Ссылка,
	               |	ЕПСБУ.Код,
	               |	ЕПСБУ.Наименование,
	               |	ЕПСБУ.НомерЖурнала,
	               |	ЕПСБУ.ВидыСубконто.(
	               |		Ссылка,
	               |		НомерСтроки,
	               |		ТолькоОбороты,
	               |		ВидСубконто,
	               |		ВидСубконто.Наименование КАК НаименованиеСубконто
	               |	),
	               |	ВЫБОР
	               |		КОГДА ВложенныйЗапрос.Ссылка ЕСТЬ NULL 
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЭтоГруппа
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |			ЕПСБУ.Ссылка.Родитель КАК Ссылка
	               |		ИЗ
	               |			ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ГДЕ
	               |			ЕПСБУ.Родитель.Код В(&МассивКодовСчетов)) КАК ВложенныйЗапрос
	               |		ПО ЕПСБУ.Ссылка = ВложенныйЗапрос.Ссылка
	               |ГДЕ
	               |	ЕПСБУ.Код В(&МассивКодовСчетов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЕПСБУ.Порядок";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

// В ТаблицаСчетов, в которой находятся все необходимые свойства счетов, находит строку, 
// соответствующую переданному счету ТекСчет и возвращает ее.
//
//	ТаблицаСчетов (ТаблицаЗначений). Таблица со свойствами забалансовых счетов
//	ТекСчет (СчетСсылка.ЕПСБУ). Счет, строку которого ищем
// 	ТекстСообщения (Строка). Если строку не удасться найти, то в этот параметр передастся
//							сообщение
//
// Возвращает строку таблицы значений или Неопределено, если строку найти не удалось.
Функция ПолучитьТекущуюСтрокуТаблицыСчетов(ТаблицаСчетов, ТекСчет, ТекстСообщения="") Экспорт
	СтрокаСчета = ТаблицаСчетов.Найти(ТекСчет, "Ссылка");
	Если СтрокаСчета = Неопределено Тогда
		ТекстСообщения = "Выбран некорректный счет учета";
	КонецЕсли;	
	
	Возврат СтрокаСчета;
КонецФункции	

// Возвращает ссылку на счет учета номенклатуры. Код счета учета номенклатуры
// хранится в карточке номенклатуры
//
//	НоменклатураСсылка - ссылка на номенклатуру
//
Функция ПолучитьСчетНоменклатурыПоУмолчанию(НоменклатураСсылка, КОСГУДт = "", КОСГУКт = "", ГруппаКодаСчета = "") Экспорт
	Результат = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	Если НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", НоменклатураСсылка);
	УсловиеСоединения = " 
						|		ПО (Номенклатура.СчетУчета = ЕПСБУ.Код)";
	Если ГруппаКодаСчета <> "" Тогда
		Запрос.УстановитьПараметр("КодГруппы", ГруппаКодаСчета);
		УсловиеСоединения = " 
							|		ПО (ПОДСТРОКА(Номенклатура.СчетУчета, 1, 4) + &КодГруппы + ПОДСТРОКА(Номенклатура.СчетУчета, 6, 1) = ЕПСБУ.Код)";
	КонецЕсли;	
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕПСБУ.Ссылка КАК Счет,
	               |	ЕПСБУ.КОСГУДт КАК КОСГУДт,
	               |	ЕПСБУ.КОСГУКт КАК КОСГУКт
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ" + УсловиеСоединения + "
	               |ГДЕ
	               |	ЕПСБУ.ЭлементГруппа = Ложь
	               |	И Номенклатура.Ссылка = &Ссылка";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = ?(Выборка.Счет = NULL, Результат, Выборка.Счет);
		КОСГУДт   = Выборка.КОСГУДт;
		КОСГУКт   = Выборка.КОСГУКт;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

// Проверяет наличие остатка по переданной партии
//
Функция ЕстьОстаток10604ПоПартии(Партия) Экспорт
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕПСБУОстатки.КоличествоОстатокДт
	               |ИЗ
	               |	РегистрБухгалтерии.ЕПСБУ.Остатки(, , , Субконто2 = &Партия) КАК ЕПСБУОстатки
	               |ГДЕ
	               |	ЕПСБУОстатки.КоличествоОстатокДт > 0";
				   
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Партия", Партия);
	
	Выборка = Запрос.Выполнить().Выгрузить();
	Возврат(Выборка.Количество() <> 0);
КонецФункции	

// Производственный учет

Функция ПолучитьДанныеДляЗаполненияПоНормам(НоменклатураЗатрат) Экспорт
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Номенклатура.ОсновнаяСпецификацияНоменклатуры КАК Спецификация,
	               |	Номенклатура.Ссылка КАК Номенклатура,
	               |	Номенклатура.ТипПроизводственнойОперации,
	               |	Номенклатура.ИсходноеСырье,
	               |	Номенклатура.Представление,
	               |	Номенклатура.ТипНоменклатуры
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СоставНоменклатурныхГрупп.Номенклатура,
	               |	СоставНоменклатурныхГрупп.Номенклатура.ОсновнаяСпецификацияНоменклатуры КАК Спецификация
	               |ИЗ
	               |	РегистрСведений.СоставНоменклатурныхГрупп КАК СоставНоменклатурныхГрупп
	               |ГДЕ
	               |	СоставНоменклатурныхГрупп.НоменклатурнаяГруппа = &Ссылка";
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("Ссылка", НоменклатураЗатрат);
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	Возврат МассивРезультатов;	
КонецФункции	

// Документы инвентаризации

Функция СформироватьМассивИФОПоСправочнику()
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ИФО.Ссылка
	               |ИЗ
	               |	Справочник.ИсточникиФинансовогоОбеспечения КАК ИФО
	               |ГДЕ
	               |	ИФО.ЭтоГруппа = ЛОЖЬ
	               |	И ИФО.ПометкаУдаления = ЛОЖЬ";
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	
	Возврат(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
КонецФункции	

Функция СформироватьСписокБалансовДляВыбора() Экспорт
	МассивБалансов = СформироватьМассивИФОПоСправочнику();
	
	Результат = Новый СписокЗначений;  
	Результат.ЗагрузитьЗначения(МассивБалансов);
	Результат.Вставить(0, Неопределено, "<без учета ИФО>");
	Результат.Вставить(1, Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка(), "<по пустому ИФО>");
	
	Возврат(Результат);
КонецФункции	

// Учет питания

Функция ПолучитьДанныеДляФормыЗаполнения(ДокументОбъект, ТаблицаКД) Экспорт
	ТаблицаСоставКатегорий = ДокументОбъект.СоставКатегорий.Выгрузить();
	ТаблицаМатериалов      = ДокументОбъект.Материалы.Выгрузить();
	ТаблицаМатериалов.Свернуть("КатегорияДовольствующихся, Баланс, КВД, КБКСчетКредита, СчетКредита, Номенклатура, ЕдиницаИзмерения", "Количество");
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	ПП_СписаниеПродуктовСоставКатегорий.КатегорияДовольствующихся
				   |ПОМЕСТИТЬ ТаблицаКД
				   |ИЗ
				   |	&ТаблицаСоставКатегорий КАК ПП_СписаниеПродуктовСоставКатегорий
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	ТаблицаКД.КатегорияДовольствующихся,
				   |	ТаблицаКД.КатегорияДовольствующихся.Код + ТаблицаКД.КатегорияДовольствующихся.Владелец.Код КАК КодКД,
				   |	ПРЕДСТАВЛЕНИЕ(ТаблицаКД.КатегорияДовольствующихся) КАК КДПредставление
				   |ИЗ
				   |	ТаблицаКД КАК ТаблицаКД";
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("ТаблицаСоставКатегорий", ТаблицаСоставКатегорий);
	ТаблицаКД = Запрос.Выполнить().Выгрузить();
	
	ПоляВыборкиПоКД = "";
	ПоляИтогов = "";
	МаксИндексКД = ТаблицаКД.Количество() - 1;
	Для к = 0 по МаксИндексКД Цикл
		ТекСтрока = ТаблицаКД.Получить(к);
		ТекКД     = ТекСтрока.КатегорияДовольствующихся;
		Знак = ?(к = МаксИндексКД, "", ",");
		
		ПоляВыборкиПоКД = ПоляВыборкиПоКД + "
					   |	СУММА(ВЫБОР
					   |		КОГДА ТабМатериалов.КатегорияДовольствующихся = &КД" + к + "
					   |			ТОГДА ТабМатериалов.Количество
					   |		ИНАЧЕ 0
					   |	КОНЕЦ) КАК К" + к + ",";
					   
		ПоляИтогов = ПоляИтогов + "
					   |	СУММА(К" + к + ")" + Знак;
		
		Запрос.УстановитьПараметр("КД" + к, ТекКД);			   
	КонецЦикла;				   
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				   |	ПП_СписаниеПродуктовМатериалы.КатегорияДовольствующихся,
				   |	ПП_СписаниеПродуктовМатериалы.Баланс,
				   |	ПП_СписаниеПродуктовМатериалы.КВД,
				   |	ПП_СписаниеПродуктовМатериалы.КБКСчетКредита,
				   |	ПП_СписаниеПродуктовМатериалы.СчетКредита,
				   |	ПП_СписаниеПродуктовМатериалы.Номенклатура,
				   |	ПП_СписаниеПродуктовМатериалы.ЕдиницаИзмерения,
				   |	ПП_СписаниеПродуктовМатериалы.Количество КАК Количество
				   |ПОМЕСТИТЬ ТабМатериалов
				   |ИЗ
				   |	&ТаблицаМатериалов КАК ПП_СписаниеПродуктовМатериалы
				   |;
				   |//////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ
				   |	ТабМатериалов.Номенклатура,
				   |	ТабМатериалов.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
				   |	" + ПоляВыборкиПоКД + "
				   |	ТабМатериалов.КБКСчетКредита,
				   |	ТабМатериалов.КВД,
				   |	ТабМатериалов.СчетКредита,
				   |	ТабМатериалов.СчетКредита.КОСГУКт КАК КОСГУСчетКредита,
				   |	ТабМатериалов.Баланс
				   |ИЗ ТабМатериалов КАК ТабМатериалов
				   |СГРУППИРОВАТЬ ПО 
				   |	ТабМатериалов.Баланс,
				   |	ТабМатериалов.КВД,
				   |	ТабМатериалов.КБКСчетКредита,
				   |	ТабМатериалов.СчетКредита,
				   |	ТабМатериалов.СчетКредита.КОСГУКт,
				   |	ТабМатериалов.Номенклатура,
				   |	ТабМатериалов.Номенклатура.ЕдиницаИзмерения
				   |ИТОГИ " + ПоляИтогов + "	
				   |ПО	
				   |	ТабМатериалов.Номенклатура
				   |";
	
	Запрос.УстановитьПараметр("ТаблицаМатериалов", ТаблицаМатериалов);
	Запрос.Текст = ТекстЗапроса;
	ДеревоМат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат(ДеревоМат);
КонецФункции	

// Прочие

// Возвращает специфмкацию номенклатуры по умолчанию
//
Функция ПолучитьСпецификациюПоУмолчанию(ТекНоменклатура, ВыходПоСпецификации="", ЕдиницаИзмерения="") Экспорт
	СпецификацияПоУмолчанию = Справочники.СпецификацииНоменклатуры.ПустаяСсылка();
	ВыходПоСпецификации = 0;
	ЕдиницаИзмерения    = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СпецификацииНоменклатуры.Ссылка КАК Спецификация,
	               |	ВЫБОР
	               |		КОГДА СпецификацииНоменклатуры.Ссылка = Номенклатура.ОсновнаяСпецификацияНоменклатуры
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ПоУмолчанию,
	               |	СпецификацииНоменклатуры.Количество,
	               |	СпецификацииНоменклатуры.Владелец.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	               |ИЗ
	               |	Справочник.СпецификацииНоменклатуры КАК СпецификацииНоменклатуры
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	               |		ПО СпецификацииНоменклатуры.Владелец = Номенклатура.Ссылка
	               |ГДЕ
	               |	Номенклатура.Ссылка = &Ссылка
	               |	И СпецификацииНоменклатуры.Владелец = &Ссылка";
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("Ссылка", ТекНоменклатура);
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗапроса.Количество() > 0 Тогда
		НайденнаяСтрока = ТаблицаЗапроса.Найти(Истина, "ПоУмолчанию");
		Если НайденнаяСтрока <> Неопределено Тогда
			СпецификацияПоУмолчанию = НайденнаяСтрока.Спецификация;
			ВыходПоСпецификации     = НайденнаяСтрока.Количество;
			ЕдиницаИзмерения        = НайденнаяСтрока.ЕдиницаИзмерения;
		Иначе	
			СпецификацияПоУмолчанию = ТаблицаЗапроса[0].Спецификация;
			ВыходПоСпецификации     = ТаблицаЗапроса[0].Количество;
			ЕдиницаИзмерения        = ТаблицаЗапроса[0].ЕдиницаИзмерения;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат(СпецификацияПоУмолчанию);
КонецФункции	

Функция СтруктураРаспределенияОбщихЗатрат(Организация, Дата) Экспорт

	Возврат УчетПроизводства.ПараметрыРаспределенияОбщихЗатрат(Организация, Дата);

КонецФункции

// Устарела. Подготавливает таблицу документа (в унифицированном формате) для учета списания материальных запасов.
//
Функция ПодготовитьТаблицуСписаниеИмуществаКазныПоДокументу(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ТаблицаДокумента = ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу(Истина);
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	Если НЕ Параметры.Свойство("ПоВсемКФО") Тогда
		Параметры.Вставить("ПоВсемКФО", Ложь);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	// Подразделение.
	ИмяРеквизитаПодразделение = "";
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ПодразделениеОтправитель", МетаданныеДокумента) Тогда
		Параметры.Вставить("Подразделение", Документ.ПодразделениеОтправитель);
		ИмяРеквизитаПодразделение = "ПодразделениеОтправитель";
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Подразделение", МетаданныеДокумента) Тогда
		ИмяРеквизитаПодразделение = "Подразделение";
	КонецЕсли;
	
	// КФО.
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("КФО", МетаданныеДокумента)
	   И НЕ Параметры.ПоВсемКФО И НЕ ЗначениеЗаполнено(Документ.КФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", МетаданныеДокумента.Реквизиты.КФО.Синоним);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			Документ.Ссылка, "КФО", "Объект", Отказ);
	КонецЕсли;
	
	Если ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.НакладнаяНаОтпускИК") Тогда
		// в документе нет реквизита для выбора счета
		Параметры.Вставить("СчетУчета", БухгалтерскийУчет.СчетПоКоду("108.56", Документ.Дата, Документ.Организация));
		Параметры.Вставить("ДополнительнаяАналитикаСчета", Справочники.Номенклатура.ПустаяСсылка());
		Параметры.Вставить("ЦМО", Справочники.ЦМО.ПустаяСсылка());
		Параметры.Вставить("ЦМОПолучатель", Справочники.ЦМО.ПустаяСсылка());
	
		ИмяТабЧасти = "Материалы";
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,ПодразделениеПолучатель,ЦМОПолучатель,
			|СчетУчета,Номенклатура,ЦМО,ДополнительнаяАналитикаСчета,Количество, Сумма",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""Материалы"" КАК ИмяСписка,
		|	""Материалы"" КАК СинонимСписка,
		|	Материалы.НомерСтроки КАК НомерСтроки,
		|	Материалы.ИФО КАК ИФО,
		|	Материалы.КФО КАК КФО,
		|	Материалы.КПС КАК КПС,
		|	Материалы.Подразделение КАК Подразделение,
		|	Материалы.Подразделение КАК ПодразделениеПолучатель,
		|	ЕСТЬNULL(Материалы.СчетУчета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
		|	ЕСТЬNULL(Материалы.СчетУчета.РазрешитьНеУказыватьПодразделение, ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
		|	Материалы.СчетУчета КАК СчетУчета,
		|	Материалы.Номенклатура КАК Номенклатура,
		|	Материалы.ДополнительнаяАналитикаСчета КАК ДопАналитика,
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК ДопИзмерениеВидСубконто,
		|	Материалы.ЦМО КАК ДопИзмерение,
		|	Материалы.ЦМО КАК ДопИзмерениеПолучатель,
		|	Материалы.Количество КАК Количество,
		|	Материалы.Сумма КАК Сумма
		|ИЗ
		|	ТаблицаМатериалы КАК Материалы
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	Иначе
		Возврат ТаблицаДокумента;
	КонецЕсли;
	
	// Если есть ПодразделениеПолучатель или ЦМОПолучатель, берем данные из них.
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ПодразделениеПолучатель", МетаданныеДокумента)
	 ИЛИ ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("ПодразделениеПолучатель", МетаданныеДокумента, ИмяТабЧасти)
	 ИЛИ (Параметры.Свойство("ПодразделениеПолучатель") И ЗначениеЗаполнено(Параметры.ПодразделениеПолучатель)) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"Подразделение КАК ПодразделениеПолучатель",
			"ПодразделениеПолучатель КАК ПодразделениеПолучатель");
	КонецЕсли;
	
	Если Параметры.ПоВсемКФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Материалы.КФО",        "ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТабНоменклатура.КФО",  "ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОсновныеСредства.КФО", "ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
	КонецЕсли;
	
	ЕстьРеквизитКФОТабЧасти = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента(
		"КФО", МетаданныеДокумента, ИмяТабЧасти);
	
	СписаниеМатериальныхЗапасов = Запрос.Выполнить().Выгрузить();
	
	ВидыДопАналитики = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительнойАналитикиУчетаМЗ();
	ОбязательноУказыватьПодразделение = Ложь;
	ВедетсяУчетПоЦМО = Ложь;
	
	Для Каждого Строка Из СписаниеМатериальныхЗапасов Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'Номенклатура'"), Строка.НомерСтроки, Строка.СинонимСписка);
			ПолеКолонки = Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].Номенклатура";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка, ПолеКолонки, "Объект", Отказ);
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		НоваяСтрока.ДопАналитикаВидСубконто = ВидыДопАналитики.Получить(Строка.СчетУчета);
		
		ОбязательноУказыватьПодразделение = ОбязательноУказыватьПодразделение
			ИЛИ (Строка.УчетПоПодразделениям И НЕ Строка.РазрешитьНеУказыватьПодразделение);
		ВедетсяУчетПоЦМО = ВедетсяУчетПоЦМО ИЛИ БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоЦМО(Строка.СчетУчета);
		
		Если НЕ ЗначениеЗаполнено(Строка.СчетУчета) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru='Счет учета'"), Строка.НомерСтроки, Строка.СинонимСписка);
			ПолеСчетУчета = Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].СчетУчета";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка, ПолеСчетУчета, "Объект", Отказ);
		КонецЕсли;
		
		Если ЕстьРеквизитКФОТабЧасти И НЕ Параметры.ПоВсемКФО И НЕ ЗначениеЗаполнено(Строка.КФО) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru='КФО'"), Строка.НомерСтроки, Строка.СинонимСписка);
			ПолеКФО = Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].КФО";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка, ПолеКФО, "Объект", Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ОбязательноУказыватьПодразделение
	   И ЗначениеЗаполнено(ИмяРеквизитаПодразделение) И НЕ ЗначениеЗаполнено(Документ[ИмяРеквизитаПодразделение]) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", МетаданныеДокумента.Реквизиты[ИмяРеквизитаПодразделение].Синоним);
		ТекстСообщения = ТекстСообщения + НСтр("ru='. Учет материальных запасов ведется по подразделениям.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			Документ.Ссылка, ИмяРеквизитаПодразделение, "Объект", Отказ);
	КонецЕсли;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Устарела. Следует использовать УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов 
// 
// Параметры:
//  ПараметрыДанныхСчетов - см. ПараметрыДанныхСчетовУчетаМЗ 
// 
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура:
//   * Код - Строка
//   * Наименование - Строка
//   * ДополнительноеСубконто -ПланВидовХарактеристикСсылка.ВидыСубконто
//   * Счет - ПланСчетовСсылка.ЕПСБУ
//   * ТекущийСчет - ПланСчетовСсылка.ЕПСБУ
//   * УчетПоКПС - Булево
//   * УчетПоКЭК - Булево
//   * НомерСубконтоЦМО - Число
Функция ДанныеСчетовУчетаМЗ(ПараметрыДанныхСчетов) Экспорт
	Возврат СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов);
КонецФункции

#КонецОбласти

Функция СчетаУчетаПрослеживаемыхМЗ(Дата, Организация) Экспорт
	
	ДатаАктуальностиСчетов = БухгалтерскийУчет.ДатаАктуальностиСчетов(Дата, Организация);
	Возврат УправлениеМатериальнымиЗапасамиПовтИсп.СчетаУчетаПрослеживаемыхМЗ(ДатаАктуальностиСчетов, Организация);
	
КонецФункции

Функция ЕстьУчетПоПодразделениямСчетаУчета27(ВедетсяУчетПоПодразделениям, Счета27) Экспорт
	
	Результат = ВедетсяУчетПоПодразделениям;
	
	Если ВедетсяУчетПоПодразделениям И Счета27.Количество() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(ЕПСБУ.УчетПоПодразделениям) КАК УчетПоПодразделениям
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
		|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
		|ГДЕ
		|	НЕ ЕПСБУ.ЭлементГруппа
		|	И ЕПСБУ.Ссылка В(&Cчета27)
		|
		|ИМЕЮЩИЕ
		|	НЕ МАКСИМУМ(ЕПСБУ.УчетПоПодразделениям) ЕСТЬ NULL";
		Запрос.УстановитьПараметр("Cчета27", Счета27);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.УчетПоПодразделениям;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПроцедурыИФункцииМенеджераДокумента
// Таблица см. УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу
//  для документов "Акт списания материалов" и "Акт списания мягкого и хоз. инвентаря"
// Параметры:
//  Документ - ДокументОбъект
//  Параметры - Структура
// 
// Возвращаемое значение:
//  ТаблицаЗначений
Функция ТаблицаСписанияМатериальныхЗапасовПоДокументуАктыСписанияМЗ(Документ, Параметры) Экспорт
	
	Параметры.Вставить("НеПроверятьЗаполнение", Истина);
	ТаблицаДокумента = УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу();
	
	ИмяСписка = "Материалы";
	СинонимСписка = Документ.Метаданные().ТабличныеЧасти.Материалы.Синоним;
	
	ЕстьПодразделениеПолучатель = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Документ, "ПодразделениеПолучатель")
		И Документ.ВыдатьВЛичноеПользование;
		
	ВидыДопСубконто = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительногоСубконтоУчетаМЗ();
	
	Для Каждого СтрокаДокумента Из Документ.Материалы Цикл
		НоваяСтрока = ТаблицаДокумента.Добавить();
		НоваяСтрока.ИмяСписка = ИмяСписка;
		НоваяСтрока.СинонимСписка = СинонимСписка;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента,
			"НомерСтроки, КПС, КЭК, СчетУчета, Номенклатура, Количество, СуммаСписания, СуммаСписанияНУ");
		НоваяСтрока.ДопАналитика = СтрокаДокумента.ДополнительнаяАналитикаСчета;
		Если ЗначениеЗаполнено(СтрокаДокумента.ДополнительноеСубконтоСчета) И НЕ Документ.ВыдатьВЛичноеПользование Тогда
			НоваяСтрока.ДопИзмерение = СтрокаДокумента.ДополнительноеСубконтоСчета;
			НоваяСтрока.ДопИзмерениеВидСубконто = ВидыДопСубконто.Получить(СтрокаДокумента.СчетУчета);
		Иначе
			НоваяСтрока.ДопИзмерение = Документ.ЦМООтправитель;
			НоваяСтрока.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Документ,
			"ИФО, НеПересчитыватьСумму");
		НоваяСтрока.Подразделение = Документ.ПодразделениеОтправитель;
		
		Если ЕстьПодразделениеПолучатель Тогда
			НоваяСтрока.ПодразделениеПолучатель = ?(ЗначениеЗаполнено(Документ.ПодразделениеПолучатель),
			Документ.ПодразделениеПолучатель,
			Документ.ПодразделениеОтправитель);
		Иначе
			НоваяСтрока.ПодразделениеПолучатель = Документ.ПодразделениеОтправитель;
		КонецЕсли;
		
		Если Документ.КФОВТабличнойЧасти Тогда
			НоваяСтрока.КФО = СтрокаДокумента.КФО;
		Иначе
			НоваяСтрока.КФО = Документ.КФО;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
КонецФункции

// Текст запроса к табличной части для получения движений при подготовке печатных форм
//  для документов "Акт списания материалов" и "Акт списания мягкого и хоз. инвентаря"
// Параметры:
//  ПутьКТаблЧасти - Строка
// 
// Возвращаемое значение:
//  Строка
Функция ТекстЗапросаТаблицыДляРасчетаДвиженийАктыСписанияМЗ(ПутьКТаблЧасти) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	АктСписанияМЗМатериалы.Ссылка КАК Ссылка,
	|	АктСписанияМЗМатериалы.НомерСтроки,
	|	АктСписанияМЗМатериалы.Номенклатура,
	|	АктСписанияМЗМатериалы.Количество,
	|	АктСписанияМЗМатериалы.КПС,
	|	ВЫБОР
	|		КОГДА АктСписанияМЗМатериалы.Ссылка.КФОВТабличнойЧасти
	|			ТОГДА АктСписанияМЗМатериалы.КФО
	|		ИНАЧЕ АктСписанияМЗМатериалы.Ссылка.КФО
	|	КОНЕЦ КАК КФО,
	|	АктСписанияМЗМатериалы.СчетУчета,
	|	АктСписанияМЗМатериалы.КЭК,
	|	АктСписанияМЗМатериалы.ДополнительнаяАналитикаСчета,
	|	АктСписанияМЗМатериалы.Ссылка.Дата КАК Дата,
	|	АктСписанияМЗМатериалы.Ссылка.Организация КАК Организация,
	|	АктСписанияМЗМатериалы.Ссылка.ИФО КАК ИФО
	|ИЗ
	|	#ИмяТЧ КАК АктСписанияМЗМатериалы
	|ГДЕ
	|	АктСписанияМЗМатериалы.Ссылка В (&МассивОбъектов)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ИмяТЧ", ПутьКТаблЧасти);
	Возврат ТекстЗапроса;
	
КонецФункции

// Подготавливает тексты запроса временых таблиц движений при списании забалансовых ОС
// в документах "Поступление МЗ", "Решение об оценке имущества (материальные запасы)"
// 
// Параметры:
//  Запрос - Запрос
//  НомераТаблиц - Структура
//  ПутьКТЧ - Строка (путь к табличной части исходных данных)
//  НомераТаблиц - Структура
//  УсловиеПрименения - Строка
//  ПервыйЗапрос - Булево
Процедура ИнициализироватьЗапросыСписанияЗабалансовыхОС(Запрос, НомераТаблиц, ПутьКТЧ, УсловиеПрименения, ПервыйЗапрос = Ложь) Экспорт
	
	НомераТаблиц.Вставить("ТЧДокумента",       НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ?(ПервыйЗапрос, "", ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета())+
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении) КАК ВидРаспоряжения,
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	ОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ОсновныеСредства.Ссылка.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.СубконтоЗабалансовыйСчет1 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(ОсновныеСредства.СубконтоЗабалансовыйСчет1 КАК Справочник.ОсновныеСредства)
	|		КОГДА ОсновныеСредства.СубконтоЗабалансовыйСчет2 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(ОсновныеСредства.СубконтоЗабалансовыйСчет2 КАК Справочник.ОсновныеСредства)
	|		КОГДА ОсновныеСредства.СубконтоЗабалансовыйСчет3 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(ОсновныеСредства.СубконтоЗабалансовыйСчет3 КАК Справочник.ОсновныеСредства)
	|	КОНЕЦ КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.СубконтоЗабалансовыйСчет1 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(ОсновныеСредства.СубконтоЗабалансовыйСчет1 КАК Справочник.ЦМО)
	|		КОГДА ОсновныеСредства.СубконтоЗабалансовыйСчет2 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(ОсновныеСредства.СубконтоЗабалансовыйСчет2 КАК Справочник.ЦМО)
	|		КОГДА ОсновныеСредства.СубконтоЗабалансовыйСчет3 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(ОсновныеСредства.СубконтоЗабалансовыйСчет3 КАК Справочник.ЦМО)
	|	КОНЕЦ КАК ЦМО,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.Количество КАК Количество,
	|	ОсновныеСредства.Сумма КАК Стоимость,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	&НомерДокумента КАК НомерДокумента,
	|	ОсновныеСредства.Ссылка.Дата КАК ДатаДокумента,
	|	""Списание с целью последующей реализации в составе материальных запасов"" КАК ПричинаСписания
	|ПОМЕСТИТЬ ТЧДокумента
	|ИЗ
	|	#ТЧОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ОсновныеСредства.Ссылка)
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И &ТекстДопУсловие";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ТЧОсновныеСредства", ПутьКТЧ);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстДопУсловие", УсловиеПрименения);
		
	НомераТаблиц.Вставить("ОстаткиСтоимостьОбъектовОСПоКонтрагентам",       НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.СтоимостьОстаток КАК СтоимостьОстаток,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.Организация КАК Организация,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ ОстаткиСтоимостьОбъектовОСПоКонтрагентам
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|			&ГраницаДокумента,
	|			(Организация, ОсновноеСредство, ИнвентарныйНомер, ЦМО) В
	|				(ВЫБРАТЬ
	|					ТЧдокумента.Организация,
	|					ТЧдокумента.ОсновноеСредство,
	|					ТЧдокумента.ИнвентарныйНомер,
	|					ТЧдокумента.ЦМО
	|				ИЗ
	|					ТЧдокумента)) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки";

	НомераТаблиц.Вставить("СтоимостьОбъектовОСПоКонтрагентам",       НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТЧДокумента.ВидДвижения КАК ВидДвижения,
	|	ТЧДокумента.ВидРаспоряжения КАК ВидРаспоряжения,
	|	ТЧДокумента.Период КАК Период,
	|	ТЧДокумента.Организация КАК Организация,
	|	ТЧДокумента.Подразделение КАК Подразделение,
	|	ТЧДокумента.ЦМО КАК ЦМО,
	|	ТЧДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧДокумента.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СтоимостьОбъектовОСПоКонтрагентамОстатки.КоличествоОстаток, 0) > 0
	|			ТОГДА ВЫБОР
	|					КОГДА ТЧДокумента.Количество = СтоимостьОбъектовОСПоКонтрагентамОстатки.КоличествоОстаток
	|						ТОГДА ВЫБОР
	|								КОГДА СтоимостьОбъектовОСПоКонтрагентамОстатки.СтоимостьОстаток > 0
	|									ТОГДА СтоимостьОбъектовОСПоКонтрагентамОстатки.СтоимостьОстаток
	|								ИНАЧЕ 0
	|							КОНЕЦ
	|					ИНАЧЕ ВЫРАЗИТЬ(ТЧДокумента.Количество * ВЫБОР
	|								КОГДА СтоимостьОбъектовОСПоКонтрагентамОстатки.СтоимостьОстаток > 0
	|									ТОГДА СтоимостьОбъектовОСПоКонтрагентамОстатки.СтоимостьОстаток
	|								ИНАЧЕ 0
	|							КОНЕЦ / СтоимостьОбъектовОСПоКонтрагентамОстатки.КоличествоОстаток КАК ЧИСЛО(15, 2))
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Стоимость,
	|	ТЧДокумента.НазваниеДокумента КАК НазваниеДокумента,
	|	ТЧДокумента.НомерДокумента КАК НомерДокумента,
	|	ТЧДокумента.ДатаДокумента КАК ДатаДокумента,
	|	ТЧДокумента.ПричинаСписания КАК Причина
	|ИЗ
	|	ТЧДокумента КАК ТЧДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиСтоимостьОбъектовОСПоКонтрагентам КАК СтоимостьОбъектовОСПоКонтрагентамОстатки
	|		ПО ТЧДокумента.ЦМО = СтоимостьОбъектовОСПоКонтрагентамОстатки.ЦМО
	|			И ТЧДокумента.ИнвентарныйНомер = СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер
	|			И ТЧДокумента.Организация = СтоимостьОбъектовОСПоКонтрагентамОстатки.Организация
	|			И ТЧДокумента.ОсновноеСредство = СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство";
	
	НомераТаблиц.Вставить("СобытияОС",       НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТЧДокумента.Период КАК Период,
	|	ТЧДокумента.Организация КАК Организация,
	|	ТЧДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ТЧДокумента.ИнвентарныйНомер КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание) КАК Событие,
	|	ТЧДокумента.Период КАК ДатаСобытия,
	|	ТЧДокумента.ПричинаСписания КАК ПричинаСписания,
	|	ТЧДокумента.НазваниеДокумента КАК НазваниеДокумента,
	|	ТЧДокумента.НомерДокумента КАК НомерДокумента,
	|	ТЧДокумента.ДатаДокумента КАК ДатаДокумента
	|ИЗ
	|	ТЧДокумента КАК ТЧДокумента";
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбщиеПроцедурыИФункции

Функция СоздатьЭлементУсловногоОформленияПоляКЭК(ЭлементыУсловногоОформления, ИмяЭлемента, Знач Текст = "")
	
	Если Текст = "" Тогда
		Текст = НСтр("ru = '<авто>'");
	КонецЕсли;
	
	Элемент = ЭлементыУсловногоОформления.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",      Текст);
	
	Возврат Элемент;
	
КонецФункции

//Признак наличия фукции заполнения таблицы см. УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу в модуле менеджера документа
// 
// Параметры:
// Возвращаемое значение:
//  Булево
 Функция ЕстьФункцияПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументуВМенеджере(Документ)
	ТипДокумента = ТипЗнч(Документ);
	Возврат ТипДокумента = Тип("ДокументОбъект.АктОбУтилизацииМЗ")
		Или ТипДокумента = Тип("ДокументОбъект.АктОбУтилизацииМЗИК")
		Или (ТипДокумента = Тип("ДокументОбъект.ПоступлениеМЗ")
			И Документ.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ВозвратИзЛичногоПользования)
		Или ТипДокумента = Тип("ДокументОбъект.РешениеОбОценкеИмуществаМЗ")
		Или ТипДокумента = Тип("ДокументОбъект.РешениеОбОценкеИмуществаМЗИК")
		Или ТипДокумента = Тип("ДокументОбъект.РешениеОПрекращенииПризнанияАктивомМЗИК")
		Или ТипДокумента = Тип("ДокументОбъект.РешениеОПрекращенииПризнанияАктивомМЗ")
		Или ТипДокумента = Тип("ДокументОбъект.АктСписанияИК")
		Или ТипДокумента = Тип("ДокументОбъект.АктСписанияМЗ")
		Или (ТипДокумента = Тип("ДокументОбъект.НакладнаяНаОтпускМ15") 
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.СчетУчета, "Код") = "27.02")
		Или ТипДокумента = Тип("ДокументОбъект.АктСписанияМягкогоИХозИнвентаря")
		Или ТипДокумента = Тип("ДокументОбъект.ВедомостьНаВыдачуМЗНаНуждыУчреждения")
		Или ТипДокумента = Тип("ДокументОбъект.ТребованиеНакладнаяИК")
		Или ТипДокумента = Тип("ДокументОбъект.НакладнаяНаОтпускИК");
КонецФункции

// Подготовить таблицу списание материальных запасов по документу в менеджере.
// 
// Параметры:
//  Документ - ДокументОбъект -  Документ
//  Параметры - Структура, Неопределено -  Параметры:
// * ПоВсемКФО - Булево - 
// * НеПересчитыватьСумму - Булево - 
// * СуммаСписания - Число - 
// * СуммаСписанияНУ - Число - 
// 
// Возвращаемое значение:
//  см. ПустаяТаблицаСписаниеМатериальныхЗапасовПоДокументу 
Функция ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументуВМенеджере(Документ, Параметры)
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Документ.Ссылка);
	Возврат МенеджерОбъекта.ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(Документ, Параметры);
КонецФункции

// Выборка из запроса стоимости списания неактивов на забалансе.
// 
// Параметры:
//  Параметры - см. СтоимостьСписанияНеактивовНаЗабалансе_Параметры
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса
Функция ВыборкаИзЗапросаСтоимостиСписанияНеактивовНаЗабалансе(Параметры)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТаблицаНоменклатуры.КФО КАК КФО,
	|	ТаблицаНоменклатуры.ЦМО КАК ЦМО
	|ПОМЕСТИТЬ ТаблицаНоменклатуры
	|ИЗ
	|	&ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОбороты.Период КАК Период,
	|	ЖурналПроводокЕПСБУОбороты.Регистратор КАК Регистратор,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	&ПолеЦМО КАК ЦМО,
	|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО
	|ПОМЕСТИТЬ ДокументыОприходованияНа02
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(, &ДатаОкончания, Регистратор, Счет = &СчетУчетаЗабаланс, &Субконто,
	|		Организация = &Организация
	|	И Субконто1 В
	|		(ВЫБРАТЬ
	|			ТаблицаНоменклатуры.Номенклатура
	|		ИЗ
	|			ТаблицаНоменклатуры),,) КАК ЖурналПроводокЕПСБУОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|		ПО ЖурналПроводокЕПСБУОбороты.Субконто1 = ТаблицаНоменклатуры.Номенклатура
	|			И &ПолеСоединенияЦМО
	|ГДЕ
	|	ЖурналПроводокЕПСБУОбороты.КоличествоОборотДт <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыОприходованияНа02.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ДокументыОприходованияНа02.Регистратор) КАК Регистратор,
	|	ДокументыОприходованияНа02.КФО КАК КФО,
	|	ДокументыОприходованияНа02.ЦМО
	|ПОМЕСТИТЬ ПоследнийДокументОприходования
	|ИЗ
	|	ДокументыОприходованияНа02 КАК ДокументыОприходованияНа02
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ДокументыОприходованияНа02.Номенклатура КАК Номенклатура,
	|			МАКСИМУМ(ДокументыОприходованияНа02.Период) КАК Период,
	|			ДокументыОприходованияНа02.КФО КАК КФО,
	|			ДокументыОприходованияНа02.ЦМО КАК ЦМО
	|		ИЗ
	|			ДокументыОприходованияНа02 КАК ДокументыОприходованияНа02
	|		СГРУППИРОВАТЬ ПО
	|			ДокументыОприходованияНа02.Номенклатура,
	|			ДокументыОприходованияНа02.КФО,
	|			ДокументыОприходованияНа02.ЦМО) КАК МаксимальныеДатыПоступления
	|		ПО ДокументыОприходованияНа02.Номенклатура = МаксимальныеДатыПоступления.Номенклатура
	|		И ДокументыОприходованияНа02.Период = МаксимальныеДатыПоступления.Период
	|		И ДокументыОприходованияНа02.КФО = МаксимальныеДатыПоступления.КФО
	|		И ДокументыОприходованияНа02.ЦМО = МаксимальныеДатыПоступления.ЦМО
	|СГРУППИРОВАТЬ ПО
	|	ДокументыОприходованияНа02.Номенклатура,
	|	ДокументыОприходованияНа02.КФО,
	|	ДокументыОприходованияНа02.ЦМО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	|	ВЫБОР
	|		КОГДА
	|			ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.Номенклатура)
	|		КОГДА
	|			ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.Номенклатура)
	|		КОГДА
	|			ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.Номенклатура)
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК Номенклатура,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт КАК Количество,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма,
	|	ПоследнийДокументОприходования.ЦМО КАК ЦМО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт
	|ПОМЕСТИТЬ СписанияМЗ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(,, Регистратор В
	|		(ВЫБРАТЬ
	|			ПоследнийДокументОприходования.Регистратор
	|		ИЗ
	|			ПоследнийДокументОприходования)
	|	И СчетКт В (&СчетаУчетаБаланс),,) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоследнийДокументОприходования КАК ПоследнийДокументОприходования
	|		ПО ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор = ПоследнийДокументОприходования.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписанияМЗ.Номенклатура КАК Номенклатура,
	|	СписанияМЗ.КФО КАК КФО,
	|	МАКСИМУМ(СписанияМЗ.Регистратор) КАК Регистратор,
	|	СУММА(СписанияМЗ.Количество) КАК Количество,
	|	СУММА(СписанияМЗ.Сумма) КАК Сумма,
	|	СписанияМЗ.ЦМО,
	|	МАКСИМУМ(СписанияМЗ.СчетКт) КАК СчетУчета,
	|	МАКСИМУМ(СписанияМЗ.КПСКт) КАК КПС,
	|	МАКСИМУМ(СписанияМЗ.КЭККт) КАК КЭК,
	|	МАКСИМУМ(ЕСТЬNULL(СписанияМЗ.КЭККт.Код, """")) КАК КЭККод
	|ИЗ
	|	ПоследнийДокументОприходования КАК ПоследнийДокументОприходования
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписанияМЗ КАК СписанияМЗ
	|		ПО ПоследнийДокументОприходования.Регистратор = СписанияМЗ.Регистратор
	|		И ПоследнийДокументОприходования.Номенклатура = СписанияМЗ.Номенклатура
	|		И ПоследнийДокументОприходования.КФО = СписанияМЗ.КФО
	|		И ПоследнийДокументОприходования.ЦМО = СписанияМЗ.ЦМО
	|СГРУППИРОВАТЬ ПО
	|	СписанияМЗ.Номенклатура,
	|	СписанияМЗ.КФО,
	|	СписанияМЗ.ЦМО";
	
	ЕстьЦМО = Параметры.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ЦМО) <> Неопределено;
	Если ЕстьЦМО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеЦМО", "ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто2 КАК Справочник.ЦМО)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеСоединенияЦМО", "ЖурналПроводокЕПСБУОбороты.Субконто2 = ТаблицаНоменклатуры.ЦМО");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеЦМО", "ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеСоединенияЦМО", "ИСТИНА");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.Ссылка) Тогда
		ПериодЗапроса = Новый Граница(КонецДня(Параметры.Дата), ВидГраницы.Включая);
	Иначе
		ПериодЗапроса = Новый Граница(Параметры.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаОкончания", ПериодЗапроса);
	Запрос.УстановитьПараметр("ТаблицаНоменклатуры", Параметры.ТаблицаНоменклатуры);
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Запрос.УстановитьПараметр("СчетУчетаЗабаланс", Параметры.СчетУчетаЗабаланс);
	Запрос.УстановитьПараметр("Субконто", Параметры.ВидыСубконто);
	Запрос.УстановитьПараметр("СчетаУчетаБаланс", Параметры.СчетаУчетаБаланс);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Массив разных КФО в табличной части документа
// 
// Параметры:
//  ТабличнаяЧасть - ДанныеФормыКоллекция,ДокументТабличнаяЧасть
//  ИмяРеквизитаКФО - Строка
// 
// Возвращаемое значение:
//  Массив
Функция МассивРазличныхЗначенийКФОВТабличнойЧасти(ТабличнаяЧасть, ИмяРеквизитаКФО) Экспорт
	
	ТЧКолонка = ТабличнаяЧасть.Выгрузить(, ИмяРеквизитаКФО);
	ТЧКолонка.Свернуть(ИмяРеквизитаКФО);
	МассивЗначений = ТЧКолонка.ВыгрузитьКолонку(ИмяРеквизитаКФО);
	ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(МассивЗначений, Перечисления.КВД.ПустаяСсылка());
	
	Возврат МассивЗначений;

КонецФункции

// Заполняет колонку в табличной части документа по значению заполнения
// 
// Параметры:
//  ТабличнаяЧасть - ДанныеФормыКоллекция,ДокументТабличнаяЧасть
//  ИмяРеквизита - Строка
//  ЗначениеЗаполнения - Определяется типом реквизита колонки
//..ПропускатьНезаполненные - Булево
// 
// Возвращаемое значение:
//  Массив
Процедура ЗаполнитьЗначениеРеквизитаВТабличнойЧасти(ТабличнаяЧасть, ИмяРеквизита, ЗначениеЗаполнения, ПропускатьНезаполненные = Ложь) Экспорт
	
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		ЗаполнитьЗначениеРеквизитаВСтрокеТЧ(СтрокаТЧ, ИмяРеквизита, ЗначениеЗаполнения, ПропускатьНезаполненные);
	КонецЦикла;
	
КонецПроцедуры

// Возможные действия для обработки табличной части документа
// 
// Параметры:
// Возвращаемое значение:
//  Структура
Функция ДопустимыеДействияОбработкиТабличнойЧасти() Экспорт
	
	Действия = Новый Структура;
	Действия.Вставить("ОчиститьКФО", Ложь);
	Действия.Вставить("ОчиститьКПСРасчетов", Ложь);
	Действия.Вставить("ПроверитьОчиститьКПС", Ложь);
	Действия.Вставить("ОчиститьДопСубконто", Неопределено);

	Возврат Действия;
	
КонецФункции

// Выполняет действия с табличной частью документа
//  см. ДопустимыеДействияОбработкиТабличнойЧасти
// 
// Параметры:
//  ТабличнаяЧасть - ДанныеФормыКоллекция,ДокументТабличнаяЧасть
//  СтруктураДействий - Структура
Процедура ОбработатьТабличнуюЧасть(ТЧ, СтруктураДействий) Экспорт
	
	ПараметрыПроверкиДопСубконто = Неопределено;
	СтруктураДействий.Свойство("ОчиститьДопСубконто", ПараметрыПроверкиДопСубконто);
	
	ПроверитьОчиститьКПС = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДействий, "ПроверитьОчиститьКПС", Ложь);
	ОчиститьКПСРасчетов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДействий, "ОчиститьКПСРасчетов", Ложь);
	ОчиститьКФО = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураДействий, "ОчиститьКФО", Ложь);
	
	Для Каждого СтрокаТЧ Из ТЧ Цикл
		
		Если ОчиститьКФО Тогда
			ЗаполнитьЗначениеРеквизитаВСтрокеТЧ(СтрокаТЧ, "КФО", Перечисления.КВД.ПустаяСсылка(), Истина);
		КонецЕсли;
		
		Если ОчиститьКПСРасчетов Тогда
			ЗаполнитьЗначениеРеквизитаВСтрокеТЧ(СтрокаТЧ, "КПСРасчетов", Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка(), Истина);
		КонецЕсли;
		
		Если ПараметрыПроверкиДопСубконто <> Неопределено Тогда
			Если (Не ПараметрыПроверкиДопСубконто.ЕстьДопСубконтоВыдачаМЗ
					И ПараметрыПроверкиДопСубконто.ВыдачаВЛичноеПользование)
				ИЛИ (ПараметрыПроверкиДопСубконто.ВидыДопСубконто.Получить(СтрокаТЧ.СчетУчета) = Неопределено
					И НЕ ПараметрыПроверкиДопСубконто.ВыдачаВЛичноеПользование) Тогда
			ЗаполнитьЗначениеРеквизитаВСтрокеТЧ(СтрокаТЧ, "ДополнительноеСубконтоСчета", Неопределено, Истина);
			КонецЕсли;
		КонецЕсли;
		
		Если ПроверитьОчиститьКПС Тогда
			Если (НЕ ЗначениеЗаполнено(СтрокаТЧ.СчетУчета) ИЛИ БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТЧ.СчетУчета).УчетПоКПС <> ИСТИНА)
				И ЗначениеЗаполнено(СтрокаТЧ.КПС) Тогда
				СтрокаТЧ.КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Параметры для выполнения действия "ОчиститьДопСубконто" с табличной частью документа (3 пользовательское субконто счетов кроме "Номенклатура" и "Контрагенты")
//  ВыдачаВЛичноеПользование - Булевоь
//  Дата - Дата
//  Организация - СправочникСсылка.Организации:
// Возвращаемое значение:
//  Структура
Функция ПараметрыПроверкиЗаполненияДопСубконто(ВыдачаВЛичноеПользование, Дата, Организация) Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("ВидыДопСубконто", УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительногоСубконтоУчетаМЗ());
	Параметры.Вставить("ЕстьДопСубконтоВыдачаМЗ", Ложь);
	Параметры.Вставить("ВыдачаВЛичноеПользование", ВыдачаВЛичноеПользование);

	Если ВыдачаВЛичноеПользование Тогда
		СчетВыдачаВЛичноеПользованиеМЗ = БухгалтерскийУчет.СчетПоКоду("27.02", Дата, Организация);
		Параметры.ЕстьДопСубконтоВыдачаМЗ = Параметры.ВидыДопСубконто.Получить(СчетВыдачаВЛичноеПользованиеМЗ) <> Неопределено;
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Заполняет реквизит в строке табличной части документа по значению заполнения
// Параметры:
//  СтрокаТЧ	 - ДокументТабличнаяЧастьСтрока, ДанныеФормыЭлементКоллекции
//  ИмяРеквизита - Строка
//  ЗначениеЗаполнения - Определяется типом реквизита колонки
//..ПропускатьНезаполненные - Булево
Процедура ЗаполнитьЗначениеРеквизитаВСтрокеТЧ(СтрокаТЧ, ИмяРеквизита, ЗначениеЗаполнения, ПропускатьНезаполненные = Ложь)
	
		Если ПропускатьНезаполненные Тогда
			Если Не ЗначениеЗаполнено(СтрокаТЧ[ИмяРеквизита]) Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		СтрокаТЧ[ИмяРеквизита] = ЗначениеЗаполнения;
		
КонецПроцедуры

// Заполняет вид дополнительного 3 субконто счета выдачи в личное пользование(27.02) в форме
// Параметры:
//  Форма - УправляемаяФорма
//  ВыдатьВЛичноеПользование - Булево
//  Счет27МЗ - ЕПСБУСсылка
//..ИмяЭлементаСубконто - Строка (имя элемента колонки)
//..ИмяТЧ - Строка (имя табличной части)
Процедура УстановитьВидДопСубконтоЛичногоПользования(Форма, ВыдатьВЛичноеПользование, Счет27МЗ, ИмяЭлементаСубконто, ИмяТЧ) Экспорт
	Если ВыдатьВЛичноеПользование Тогда
		
		Если Не ЗначениеЗаполнено(Форма.ДополнительноеСубконто27ВидСубконто) Тогда
			ВидыДопСубконто = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительногоСубконтоУчетаМЗ();
			Форма.ДополнительноеСубконто27ВидСубконто = ВидыДопСубконто.Получить(Счет27МЗ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Форма.ДополнительноеСубконто27ВидСубконто) Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Форма.Элементы,
			ИмяЭлементаСубконто,
			"Заголовок",
			Строка(Форма.ДополнительноеСубконто27ВидСубконто));
			
			Если Форма.Объект[ИмяТч].Количество() Тогда
				Для Каждого СтрокаТч Из Форма.Объект[ИмяТч] Цикл
					СтрокаТч.ДополнительноеСубконтоВидСубконто = Форма.ДополнительноеСубконто27ВидСубконто;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		УправлениеМатериальнымиЗапасамиКлиентСервер.ОчиститьВидДопСубконтоЛичногоПользования(Форма, ИмяЭлементаСубконто);
	КонецЕсли;
КонецПроцедуры

// Возвращает признаки прослеживаемости на дату и набор доп. реквизитов для массива номенклатуры
//
// Параметры:
// МассивНоменклатуры - Массив - СправочникСсылка.Номенклатура
// ДатаПроверки - Дата
// ДопРеквизиты - Строка - список реквизитов номенклатуры через запятую
// Возвращаемое значение:
//  Соответствие
Функция ПризнакиПрослеживаемостиНоменклатуры(МассивНоменклатуры, ДатаПроверки, ДопРеквизиты = Неопределено) Экспорт
	
	ДатаПроверки = ?(ЗначениеЗаполнено(ДатаПроверки), ДатаПроверки, ОбщегоНазначения.ТекущаяДатаПользователя());
	Реквизиты = "ПрослеживаемыйТовар,КомплектСПрослеживаемымиТоварами";
	МассивОшибочныхРеквизитов = Новый Массив;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	&ДопРеквизиты,
	|	&ВедетсяУчетПрослеживаемыхТоваров
	|		И ЕСТЬNULL(ДанныеИзИстории.КомплектСПрослеживаемымиТоварами, Номенклатура.КомплектСПрослеживаемымиТоварами) КАК КомплектСПрослеживаемымиТоварами,
	|	&ВедетсяУчетПрослеживаемыхТоваров
	|		И (ЕСТЬNULL(ДанныеИзИстории.ПрослеживаемыйТовар, Номенклатура.ПрослеживаемыйТовар)
	|			ИЛИ ЕСТЬNULL(ДанныеИзИстории.КомплектСПрослеживаемымиТоварами, Номенклатура.КомплектСПрослеживаемымиТоварами)) КАК ПрослеживаемыйТовар
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Т2.Ссылка КАК Ссылка,
	|			Т2.КомплектСПрослеживаемымиТоварами КАК КомплектСПрослеживаемымиТоварами,
	|			Т2.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар
	|		ИЗ
	|			Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т2
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					МИНИМУМ(Т1.ДатаИзменения) КАК ДатаИзменения,
	|					Т1.Ссылка КАК Ссылка
	|				ИЗ
	|					Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т1
	|				ГДЕ
	|					Т1.ДатаИзменения > &ДатаПроверки
	|				
	|				СГРУППИРОВАТЬ ПО
	|					Т1.Ссылка) КАК Т1
	|				ПО Т2.Ссылка = Т1.Ссылка
	|					И Т2.ДатаИзменения = Т1.ДатаИзменения) КАК ДанныеИзИстории
	|		ПО (&ВедетсяУчетПрослеживаемыхТоваров)
	|			И Номенклатура.Ссылка = ДанныеИзИстории.Ссылка
	|ГДЕ
	|	Номенклатура.Ссылка В(&СсылкиНоменклатура)");
	
	Запрос.УстановитьПараметр("ДатаПроверки", ДатаПроверки);
	Запрос.УстановитьПараметр("СсылкиНоменклатура", МассивНоменклатуры);
	Запрос.УстановитьПараметр("ВедетсяУчетПрослеживаемыхТоваров", ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(ДатаПроверки));
	
	Если ДопРеквизиты = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопРеквизиты,", "");
	Иначе
		РеквизитыНоменклатура = Метаданные.Справочники.Номенклатура.Реквизиты;
		РеквизитыНоменклатураОбщие = Метаданные.Справочники.Номенклатура.СтандартныеРеквизиты;
		
		НаборРеквизитов = СтрРазделить(ДопРеквизиты, ",");
		Для Позиция = 0 По НаборРеквизитов.ВГраница() Цикл
			ИмяРеквизита = СокрЛП(НаборРеквизитов[Позиция]);
			Если РеквизитыНоменклатура.Найти(ИмяРеквизита) = Неопределено Тогда
				Если Не ОбщегоНазначения.ЭтоСтандартныйРеквизит(РеквизитыНоменклатураОбщие, ИмяРеквизита) Тогда
					МассивОшибочныхРеквизитов.Добавить(ИмяРеквизита);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			НаборРеквизитов[Позиция] = "Номенклатура." + ИмяРеквизита + " КАК " + ИмяРеквизита;
			Реквизиты = Реквизиты + ","+ ИмяРеквизита;
		КонецЦикла;
		
		ДопРеквизитыТекстЗапроса = СтрСоединить(НаборРеквизитов, ",");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопРеквизиты", ДопРеквизитыТекстЗапроса);
	КонецЕсли;
	
	Если МассивОшибочныхРеквизитов.Количество() Тогда
		ВызватьИсключение(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Неверный третий параметр %1 в функции %2: %3'"),
				"ДопРеквизиты", "УправлениеМатериальнымиЗапасами.ПризнакиПрослеживаемостиНоменклатуры",
				СтрСоединить(МассивОшибочныхРеквизитов, Символы.ПС)),
				КатегорияОшибки.ОшибкаКонфигурации);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЗначенияРеквизитов = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		
		Результат = Новый Структура(Реквизиты);
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		ЗначенияРеквизитов.Вставить(Выборка.Ссылка, Результат);
		
	КонецЦикла;

	Возврат ЗначенияРеквизитов;
	
КонецФункции

// Дополняет Таблицу данными на сосновании реквизитов номенклатуры из таблицы
// Параметры:
//  Таблица - Таблица значений
//  ЭтоПодбор - Булево (признак вызова из обработки подбора номенклатуры)
//  ДатаПроверки - Дата (Дата получения признаков прослеживаемости)
Процедура ДополнитьТаблицуДаннымиНоменклатуры(Таблица, ДатаПроверки, ЭтоПодбор = Ложь, ПодборПереданныхНаРеализациюТоваров = Ложь) Экспорт

	Таблица.Колонки.Добавить("ТипНоменклатуры", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНоменклатуры"));
	Таблица.Колонки.Добавить("СтранаПроисхождения", Новый ОписаниеТипов("СправочникСсылка.СтраныМира"));
	Таблица.Колонки.Добавить("ПрослеживаемыйТовар", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("КомплектСПрослеживаемымиТоварами", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ЭтоБСО", Новый ОписаниеТипов("Булево"));
	
	СвойстваНоменклатуры = ПризнакиПрослеживаемостиНоменклатуры(
		Таблица.ВыгрузитьКолонку("Номенклатура"), ДатаПроверки, "ТипНоменклатуры,СтранаПроисхождения");
	ТипНоменклатурыБСО = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БСО");
	
	Для Каждого Строка Из Таблица Цикл
		ЗаполнитьЗначенияСвойств(Строка, СвойстваНоменклатуры.Получить(Строка.Номенклатура));
		Строка.ЭтоБСО = Строка.ТипНоменклатуры = ТипНоменклатурыБСО;
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьТипНоменклатурыВСтрокеДляБиологическихАктивов(Строка,
			Строка.ТипНоменклатуры);
		
		Если ЭтоПодбор И ЗначениеЗаполнено(Строка.КонтрагентВПользовании) И НЕ ПодборПереданныхНаРеализациюТоваров Тогда
			Строка.ДополнительнаяАналитикаСчета = Строка.КонтрагентВПользовании;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

// Проверяет переход через дату изменения порядка учета НДС счета 105.хх (групповой - детальный).
// Если был переход при изменении даты, то в табличных частях документа изменяется КЭК.
// Одновременно изменяются допустимые КЭК для выбора в полях документа.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ДатаДоИзменения - Дата
//  ОрганизацияДоИзменения - СправочникСсылка.Организации
Процедура ОбработатьИзменениеПримененияДетальногоКЭК340и440(Форма, ДатаДоИзменения, ОрганизацияДоИзменения) Экспорт

	Объект = Форма.Объект;
	ИзменилсяПорядокУчетаКЭК = УправлениеМатериальнымиЗапасамиКлиентСервер.ИзменилосьПрименениеДетальногоКЭК340и440(
		ДатаДоИзменения,
		ОрганизацияДоИзменения,
		Объект.Дата,
		Объект.Организация);
	Если ИзменилсяПорядокУчетаКЭК Тогда
		УстановитьНовоеЗначениеКЭКВТабличныхЧастях(Объект, Объект.Дата, Истина);
	КонецЕсли;
	
КонецПроцедуры

// Установить новое значение КЭК в табличных частях документа.
// Если параметр ОбязательноЗаполнитьКЭК = Ложь, то заполняются только пустые КЭК.
// В параметре ПараметрыЗаполненияКЭК можно передать структуру с обязательным ключем "ИменаТабличныхЧастей",
// остальные ключи могут переопределяеть ключи структуры
// УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке. 
// 
// Параметры:
//  Объект - ДокументОбъект
//         - ДанныеФормыСтруктура:
//          * Ссылка - ДокументСсылка
//  Дата - Дата
//  ОбязательноЗаполнитьКЭК - Булево
//  ПараметрыЗаполненияКЭК - Неопределено -
//                         - Структура:
//   * ИменаТабличныхЧастей - Массив из Строка
Процедура УстановитьНовоеЗначениеКЭКВТабличныхЧастях(Объект, Дата, ОбязательноЗаполнитьКЭК, Знач ПараметрыЗаполненияКЭК = Неопределено) Экспорт
	
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
	Если ПараметрыЗаполненияКЭК = Неопределено Тогда
		ПараметрыЗаполненияКЭК = МенеджерДокумента.ПараметрыЗаполненияКЭК(); // Структура
	КонецЕсли;
	ИменаТабличныхЧастей = ПараметрыЗаполненияКЭК.ИменаТабличныхЧастей; // Массив из Строка
	
	ПараметрыОбработки = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке(Объект);
	ПараметрыОбработки.ЗаполнятьСчет = Ложь;
	ПараметрыОбработки.Дата = Дата;
	ЗаполнитьЗначенияСвойств(ПараметрыОбработки, ПараметрыЗаполненияКЭК);
	ИмяКолонкиКЭК = ПараметрыОбработки.ИмяРеквизитаКЭК;
	
	Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл
		
		ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
		Для каждого Строка Из ТабличнаяЧасть Цикл
			
			Если ОбязательноЗаполнитьКЭК Или Не ЗначениеЗаполнено(Строка[ИмяКолонкиКЭК]) Тогда
				ПараметрыОбработки.Номенклатура = Строка.Номенклатура;
				ПараметрыОбработки.Счет         = Строка.СчетУчета;
				
				УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке(
					Строка, ПараметрыОбработки);
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Печать

Функция ДанныеДляПечати0510448_МЗ(МассивОбъектов, ТекстыЗапросов)
	
	Запрос = Новый Запрос;
