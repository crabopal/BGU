			КонецЕсли;
			
			Если ЗначениеЗаполнено(НастройкаСубконтоСчета.ДопАналитика) Тогда
				ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса,
					"&ДопАналитика",
					"Материалы.СубконтоЗабалансовыйСчет" + НастройкаСубконтоСчета.ДопАналитика);
			Иначе
				ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса,
					"&ДопАналитика",
					"НЕОПРЕДЕЛЕНО");
			КонецЕсли;

			Запрос.Текст = Запрос.Текст + ШаблонТекстаЗапроса;
			
		Иначе
		
			ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
				"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,ПодразделениеПолучатель,ЦМОПолучатель,
				|СчетУчета,Номенклатура,ЦМО,ДополнительнаяАналитикаСчета,Количество,
				|НеПересчитыватьСумму,СуммаСписания,СуммаСписанияНУ",
				Документ, Параметры);
			
			Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ
			|	""Материалы"" КАК ИмяСписка,
			|	""Материалы"" КАК СинонимСписка,
			|	Материалы.НомерСтроки КАК НомерСтроки,
			|	Материалы.ИФО КАК ИФО,
			|	Материалы.КФО КАК КФО,
			|	Материалы.КПС КАК КПС,
			|	Материалы.КЭК КАК КЭК,
			|	Материалы.Подразделение КАК Подразделение,
			|	Материалы.Подразделение КАК ПодразделениеПолучатель,
			|	ЕСТЬNULL(Материалы.СчетУчета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениям,
			|	ЕСТЬNULL(Материалы.СчетУчета.РазрешитьНеУказыватьПодразделение, ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
			|	Материалы.СчетУчета КАК СчетУчета,
			|	Материалы.Номенклатура КАК Номенклатура,
			|	Материалы.ДополнительнаяАналитикаСчета КАК ДопАналитика,
			|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК ДопИзмерениеВидСубконто,
			|	Материалы.ЦМО КАК ДопИзмерение,
			|	Материалы.ЦМО КАК ДопИзмерениеПолучатель,
			|	Материалы.Количество КАК Количество,
			|	Материалы.НеПересчитыватьСумму КАК НеПересчитыватьСумму,
			|	Материалы.СуммаСписания КАК СуммаСписания,
			|	Материалы.СуммаСписанияНУ КАК СуммаСписанияНУ
			|ИЗ
			|	ТаблицаМатериалы КАК Материалы
			|
