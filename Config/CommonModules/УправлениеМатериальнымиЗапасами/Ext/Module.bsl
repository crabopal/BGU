					"Материалы.СубконтоЗабалансовыйСчет" + НастройкаСубконтоСчета.ЦМО);
				Запрос.УстановитьПараметр("ВидСубконтоДопИзмерение", ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
			ИначеЕсли ЗначениеЗаполнено(НастройкаСубконтоСчета.ДопИзмерение) Тогда
				ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса,
					"&ДопИзмерение",
					"Материалы.СубконтоЗабалансовыйСчет" + НастройкаСубконтоСчета.ДопИзмерение);
				Запрос.УстановитьПараметр("ВидСубконтоДопИзмерение", НастройкаСубконтоСчета.ДопИзмерениеВидСубконто);
			Иначе
				ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса,
					"&ДопИзмерение",
					"НЕОПРЕДЕЛЕНО");
