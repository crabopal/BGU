#Область ПрограммныйИнтерфейс

// Параметры учета ИК по ЦМО и подразделениям.
// Использует кэш повторного использования на дату последнего изменения учетной политики до даты документа.
// Если дата не заполнена, используется текущая дата пользователя.
// 
// Параметры:
//  Счет - ПланСчетовСсылка.ЕПСБУ
//  Организация - СправочникСсылка.Организации
//  Дата - Дата
// 
// Возвращаемое значение:
//  см. НовыйПараметрыУчетаИКпоЦМОиПодразделениям 
Функция ПараметрыУчетаИКпоЦМОиПодразделениям(Счет, Организация, Знач Дата) Экспорт
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат НовыйПараметрыУчетаИКпоЦМОиПодразделениям();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	Возврат Новый Структура(УправлениеМатериальнымиЗапасамиПовтИсп.ПараметрыУчетаИКпоЦМОиПодразделениям(Счет,
		Организация, БухгалтерскийУчет.ДатаУстановкиУчетнойПолитики(Организация, Дата)));
КонецФункции

Функция ТаблицаСписанияМЗВПользовании(Ссылка, КФО, Знач ЦМООтправитель = Неопределено,
	Знач ПодразделениеОтправитель = Неопределено) Экспорт

	ТаблицаСписанных = ПустаяТаблицаСписаниеМатериальныхЗапасов();

	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ПоступлениеМЗ")
		И ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ПоступлениеИК") Тогда
		Возврат ТаблицаСписанных;
	КонецЕсли;

	ДокументОбъект = Ссылка.ПолучитьОбъект(); // ДокументОбъект.ПоступлениеМЗ, ДокументОбъект.ПоступлениеИК
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПоступлениеМЗ") Тогда
		Если ДокументОбъект.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ВозвратИзДоверительногоУправления Тогда
			КодГруппы = "24";
		ИначеЕсли ДокументОбъект.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ВозвратИзАренды Тогда
			КодГруппы = "25";
		ИначеЕсли ДокументОбъект.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ВозвратИзБезвПользования Тогда
			КодГруппы = "26";
		Иначе
			// не правильный вид поступления
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Для вида поступления ""%1"" не предусмотрено использование
			|функции УправлениеМатериальнымиЗапасами.ТаблицаСписанияМЗВПользовании'"), ДокументОбъект.ВидПоступленияМЗ);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПоступлениеИК") Тогда
		Если ДокументОбъект.ВидПоступления = Перечисления.ВидыПоступленийМЗИК.ВозвратИзАренды Тогда
			КодГруппы = "25";
		ИначеЕсли ДокументОбъект.ВидПоступления = Перечисления.ВидыПоступленийМЗИК.ВозвратИзБезвПользования Тогда
			КодГруппы = "26";
		Иначе
			// не правильный вид поступления
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Для вида поступления ""%1"" не предусмотрено использование
			|функции УправлениеМатериальнымиЗапасами.ТаблицаСписанияМЗВПользовании'"), ДокументОбъект.ВидПоступления);
		КонецЕсли;
	Иначе
		ВызватьИсключение НСтр("ru = 'Для этого типа документа не предусмотрен возврат из пользования
		|с помощью функции УправлениеМатериальнымиЗапасами.ТаблицаСписанияМЗВПользовании'");
	КонецЕсли;
	
	ТаблицаСтрокДокумента = ПодготовитьТаблицуСписанияПоДокументу(
		ДокументОбъект, Истина);
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") 
		И ТаблицаСтрокДокумента.Найти(Истина, "УчетПоПодразделениям") <> Неопределено;
		
	Если ТаблицаСтрокДокумента.Количество() > 0 И Не ЗначениеЗаполнено(ТаблицаСтрокДокумента[0].КФО) Тогда
		ТаблицаСтрокДокумента.ЗаполнитьЗначения(КФО, "КФО");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЦМООтправитель) Тогда
		ЦМООтправитель = ДокументОбъект.ЦМОПриВозврате;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПодразделениеОтправитель) Тогда
		ПодразделениеОтправитель = ДокументОбъект.ПодразделениеПриВозврате;
	КонецЕсли;
	
	ВыполнятьПроверкуБалансовыхСумм = ЗначениеЗаполнено(ЦМООтправитель)
			И ДокументОбъект.ЦМО <> ЦМООтправитель
		Или УчетПоПодразделениям 
			И ЗначениеЗаполнено(ПодразделениеОтправитель) 
			И ДокументОбъект.Подразделение <> ПодразделениеОтправитель;

	ДополнительныеПараметрыЗаполнения = Новый Структура;
	Если ЗначениеЗаполнено(КФО) Тогда
		ДополнительныеПараметрыЗаполнения.Вставить("КФО",       КФО);
	КонецЕсли;
	ДополнительныеПараметрыЗаполнения.Вставить("ЦМО",			ЦМООтправитель);
	ДополнительныеПараметрыЗаполнения.Вставить("Подразделение",	ПодразделениеОтправитель);
	ДополнительныеПараметрыЗаполнения.Вставить("Контрагент",	ДокументОбъект.Контрагент);
	ДополнительныеПараметрыЗаполнения.Вставить("Договор",		ДокументОбъект.Договор);
	ДополнительныеПараметрыЗаполнения.Вставить("Дата",          ДокументОбъект.Дата);
	ДополнительныеПараметрыЗаполнения.Вставить("Организация",   ДокументОбъект.Организация);

	ДоработатьТаблицуСписанияИзПользования(ТаблицаСтрокДокумента,
		КодГруппы, ДополнительныеПараметрыЗаполнения);
	МоментВремени  = Новый Граница(Ссылка.МоментВремени(), ВидГраницы.Исключая);

	Если ВыполнятьПроверкуБалансовыхСумм Тогда
		
		// Подготовим таблицу остатков номенклатуры
		ТаблицаОстатки = ПолучитьОстаткиМатериалов(МоментВремени,
			ДокументОбъект.Организация, ТаблицаСтрокДокумента);
		ТаблицаОстатки.Индексы.Добавить("СчетУчета,Номенклатура,ЦМО,СубконтоДоп,КФО,ИФО,КПС,Подразделение");
	
		// Проверка списания номенклатуры с учетом остатков
		Отказ = Ложь;
		УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
		Для каждого СтрокаДокумента Из ТаблицаСтрокДокумента Цикл
		
			КоличествоОсталосьПогасить = СтрокаДокумента.Количество;
			Если КоличествоОсталосьПогасить <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыОтбора = Новый Структура("СчетУчета,Номенклатура,ЦМО,СубконтоДоп,КФО,ИФО,КПС");
			Если УчетПоПодразделениям И СтрокаДокумента.УчетПоПодразделениям Тогда
				ПараметрыОтбора.Вставить("Подразделение");
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаДокумента);
			
			СтрокиОстатков = ТаблицаОстатки.НайтиСтроки(ПараметрыОтбора);
			
			Для каждого СтрокаОстатков Из СтрокиОстатков Цикл

				Если СтрокаОстатков.Количество <= 0
					ИЛИ СтрокаОстатков.КоличествоВсего <= 0 Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаСписания = ТаблицаСписанных.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаСписания, СтрокаДокумента);
				СтрокаСписания.Количество = Мин(СтрокаОстатков.Количество, КоличествоОсталосьПогасить); 
				
				КоличествоОсталосьПогасить = КоличествоОсталосьПогасить - СтрокаСписания.Количество;
				
			КонецЦикла;
			
			// Несписанное количество добавим отдельной строкой
			Если КоличествоОсталосьПогасить > 0  Тогда
				Отказ = Истина;

				СтрокаСписания = ТаблицаСписанных.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаСписания, СтрокаДокумента);
				СтрокаСписания.Количество = КоличествоОсталосьПогасить;
				СтрокаСписания.ОстатокПревышен = Истина; 
				
				КоличествоОсталосьПогасить = КоличествоОсталосьПогасить
					- СтрокаСписания.Количество;
				
				ТекстОшибки = НСтр("ru='Указанное количество превышает остаток%3 по счету %4.
					|Остаток: %1; Не хватает: %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					СтрокаДокумента.Количество - КоличествоОсталосьПогасить,
					КоличествоОсталосьПогасить,
					?(СтрокаДокумента.ВидУчета="НУ", " в налоговом учете", ""),
					СтрокаДокумента.СчетУчета);
					
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'Количество'"),
					СтрокаДокумента.НомерСтроки,
					СтрокаДокумента.СинонимСписка,
					ТекстОшибки);
					
				ПолеКоличество = СтрокаДокумента.ИмяСписка
					+ "[" + Формат(СтрокаДокумента.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Количество";
				
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка,
					ПолеКоличество, "Объект");
				
			КонецЕсли;
			
		КонецЦикла;
			
		Если Отказ Тогда
			Возврат ТаблицаСписанных;
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицаСписанных.Очистить();
	
	ТаблицаОстатки = ПолучитьОстаткиМатериаловВПользовании(
		МоментВремени, Ссылка.Организация, ТаблицаСтрокДокумента);
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Отказ = Ложь;
	
	Для каждого СтрокаДокумента Из ТаблицаСтрокДокумента Цикл
	
		КоличествоОсталосьПогасить = СтрокаДокумента.Количество;
		Если КоличествоОсталосьПогасить <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыОтбора = Новый Структура("СчетУчета,Номенклатура,КФО,ИФО,КПС");
		Если УчетПоПодразделениям И СтрокаДокумента.СчетВПользованииУчетПоПодразделениям Тогда
			ПараметрыОтбора.Вставить("Подразделение");
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаДокумента);
		Если Не СтрокаДокумента.СчетВПользованииУчетПоКПС Тогда
			ПараметрыОтбора.Вставить("КПС", Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
		КонецЕсли;
		ПараметрыОтбора.Вставить("СчетУчета", СтрокаДокумента.СчетВПользовании);
		
		СтрокиОстатков = ТаблицаОстатки.НайтиСтроки(ПараметрыОтбора);
		
		Для каждого СтрокаОстатков Из СтрокиОстатков Цикл

			Если СтрокаОстатков.Количество <= 0
				ИЛИ СтрокаОстатков.КоличествоВсего <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаСписания = ТаблицаСписанных.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСписания, СтрокаДокумента);
			СтрокаСписания.Количество = Мин(СтрокаОстатков.Количество, КоличествоОсталосьПогасить); 

			КоличествоОсталосьПогасить = КоличествоОсталосьПогасить - СтрокаСписания.Количество;
			
		КонецЦикла;
		
		// Несписанное количество добавим отдельной строкой
		Если КоличествоОсталосьПогасить > 0  Тогда
			Отказ = Истина;
			
			СтрокаСписания = ТаблицаСписанных.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСписания, СтрокаДокумента);
			СтрокаСписания.Количество = КоличествоОсталосьПогасить;
			СтрокаСписания.ОстатокПревышен = Истина; 
			
			ТекстОшибки = НСтр("ru='Указанное количество превышает остаток%3 по счету %4.
				|Остаток: %1; Не хватает: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				СтрокаДокумента.Количество - КоличествоОсталосьПогасить,
				КоличествоОсталосьПогасить,
				"",
				СтрокаДокумента.СчетВПользовании);
				
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru = 'Количество'"),
				СтрокаДокумента.НомерСтроки,
				СтрокаДокумента.СинонимСписка,
				ТекстОшибки);
				
			ПолеКоличество = СтрокаДокумента.ИмяСписка
				+ "[" + Формат(СтрокаДокумента.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Количество";
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеКоличество, "Объект");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаСписанных;
	
КонецФункции

// Счет обесценения БА.
// 
// Параметры:
//  СчетУчетаБА - ПланСчетовСсылка.ЕПСБУ
//  Организация - СправочникСсылка.Организации
//  Дата - Дата
// 
// Возвращаемое значение:
//  ПланСчетовСсылка.ЕПСБУ -  Счет обесценения БА
Функция СчетОбесцененияБА(СчетУчетаБА, Организация, Дата) Экспорт
	КодСчетаБА = Строка(СчетУчетаБА);
	Если СтрДлина(КодСчетаБА) <> 6 Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	КодСчетаОбесценения = "114.9" + Прав(КодСчетаБА, 1);
	Возврат БухгалтерскийУчет.СчетПоКоду(КодСчетаОбесценения, Дата, Организация);
КонецФункции

// Заменяет ЦМО и Подразделение отправитель и получатель в случаях, когда выполняется передача и возврат из ремонта.
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъект - 
//  ТаблицаДокумента - см. ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу
//
Процедура ДоработатьТаблицуДокументаДляДвиженийРемонт(ДокументОбъект, ТаблицаДокумента) Экспорт
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.НакладнаяНаОтпускМ15") Тогда
		Если ДокументОбъект.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаНаХранениеВПереработку
			Или ДокументОбъект.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаНаРеализацию Тогда
			ЦМО                     = ДокументОбъект.ЦМО;
			Подразделение           = ДокументОбъект.Подразделение;
			ЦМОПолучатель           = ДокументОбъект.ЦМОПриПередаче;
			ПодразделениеПолучатель = ДокументОбъект.ПодразделениеПриПередаче;
		ИначеЕсли ДокументОбъект.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратСХраненияИзПереработки
			ИЛИ ДокументОбъект.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратТоваровПереданныхНаРеализацию Тогда
			ЦМО                     = ДокументОбъект.ЦМОПриПередаче;
			Подразделение           = ДокументОбъект.ПодразделениеПриПередаче;
			ЦМОПолучатель           = ДокументОбъект.ЦМО;
			ПодразделениеПолучатель = ДокументОбъект.Подразделение;
		Иначе
			Возврат;
		КонецЕсли;
		
		Для каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
			СтрокаДокумента.ДопИзмерение            = ЦМО;
			СтрокаДокумента.Подразделение           = Подразделение;
			СтрокаДокумента.ДопИзмерениеПолучатель  = ЦМОПолучатель;
			СтрокаДокумента.ПодразделениеПолучатель = ПодразделениеПолучатель;
		
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет, что реквизит "СчетУчета" равен счету 105.00.
// 
// Параметры:
//  Объект - ДокументОбъект
// 
// Возвращаемое значение:
//  Булево - Поступление на счет105
Функция СчетУчетаРавен105(Объект) Экспорт
	Возврат СчетУчетаРавенЗначению(Объект, "105.00"); 
КонецФункции
	
// Проверяет, что реквизит "СчетУчета" равен счету 106.00.
// 
// Параметры:
//  Объект - ДокументОбъект
// 
// Возвращаемое значение:
//  Булево - Поступление на счет106
