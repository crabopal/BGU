//		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

Функция ПроверитьОстаткиНаСчете09(НаДату, Организация, ИФО, КФО = Неопределено, СписокОС) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период"			, Новый Граница(НаДату, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("ИФО"				, ИФО);
	Запрос.УстановитьПараметр("КФО"				, КФО);	
	Запрос.УстановитьПараметр("СписокОС"		, СписокОС);
	Запрос.УстановитьПараметр("СписокСчетов"	, БухгалтерскийУчет.СписокСчетов("09"));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстатокДт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетов),
	|			,
	|			Организация = &Организация
	|				И &УсловиеКФО
	|				И &УсловиеИФО
	|				И Субконто1 В (&СписокОС)) КАК ЖурналПроводокЕПСБУОстатки";

	ТекстЗамены = "ИСТИНА";	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ИФО) Тогда
		ТекстЗамены = "ИФО В (&ИФО)";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", ТекстЗамены);
	
	ТекстЗамены = "ИСТИНА";	
	Если ЗначениеЗаполнено(КФО) Тогда
		ТекстЗамены = "КФО В (&КФО)";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", ТекстЗамены);
	
	Результат = Не Запрос.Выполнить().Пустой();
	
	Возврат Результат;
	
КонецФункции

// Функция возвращает массив разрешенных счетов учета материальных запасов для использования резерва под снижение стоимости
Функция РазрешенныеСчетаУчетаМЗДляСписанияРезерва(ДатаУчета, Организация)
	Возврат БухгалтерскийУчет.СписокСчетов("105.37,105.27,105.А8,105.В8", ДатаУчета, Истина, Организация);
КонецФункции

// Функция возвращает таблицу остатков внесенных резервов под снижение стоимости номенклатуры для переданной таблицы списания
// 
// Параметры:
//  Период - Граница - Период
//  ТаблицаСписания - ТаблицаЗначений - Таблица списания:
//  Реквизиты - Структура - Реквизиты:
// * Ссылка - ДокументСсылка -
// * Организация - СправочникСсылка.Организации -
// * Дата - Дата -
// * ИспользоватьУчетПоИФО - Булево -
// * ИспользоватьУчетПоПодразделениям - Булево -
//
// Возвращаемое значение:
//  ТаблицаЗначений 
Функция ОстаткиРезервовДляСписанияМатериальныхЗапасов(Период, ТаблицаСписания, Реквизиты) Экспорт
	
	ТаблицаИсточник = ТаблицаСписания.Скопировать(,"Номенклатура,ИФО,КПС,КФО,Подразделение,СчетУчета");
	ТаблицаИсточник.Свернуть("Номенклатура,ИФО,КПС,КФО,Подразделение,СчетУчета");
	УчетПоИФО = Реквизиты.ИспользоватьУчетПоИФО;
		
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
	Запрос.УстановитьПараметр("ТаблицаИсточник", ТаблицаИсточник);
	Запрос.УстановитьПараметр("СчетаРезервов", БухгалтерскийУчет.СписокСчетов("114.87,114.88", Период, Истина, Реквизиты.Организация));
	Запрос.УстановитьПараметр("РазрешенныеСчетаУчета", РазрешенныеСчетаУчетаМЗДляСписанияРезерва(Период, Реквизиты.Организация));
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", Реквизиты.ИспользоватьУчетПоПодразделениям);

	Запрос.Текст = "ВЫБРАТЬ
	|	ТаблицаИсточник.Номенклатура КАК Номенклатура,
	|	ТаблицаИсточник.Подразделение КАК Подразделение,
	|	ТаблицаИсточник.КФО КАК КФО,
	|	ТаблицаИсточник.КПС КАК КПС,
	|	ТаблицаИсточник.ИФО КАК ИФО,
	|	ТаблицаИсточник.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ ВТ_ИсточникДанных
	|ИЗ
	|	&ТаблицаИсточник КАК ТаблицаИсточник
	|ГДЕ
	|	ТаблицаИсточник.СчетУчета В(&РазрешенныеСчетаУчета)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЕПСБУОстаткиРезервов.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ЕПСБУОстаткиРезервов.КоличествоОстатокКт КАК КоличествоОстаток,
	|	ЕПСБУОстаткиРезервов.СуммаОстатокКт КАК СуммаОстаток,
	|	ЕСТЬNULL(ЕПСБУОстаткиРезервов.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(ЕПСБУОстаткиРезервов.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕПСБУОстаткиРезервов.КФО КАК КФО,
	|	ЕСТЬNULL(ЕПСБУОстаткиРезервов.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ЕПСБУОстаткиРезервов.Счет КАК СчетУчетаРезервов,
	|	ЕПСБУОстаткиРезервов.КЭК КАК КЭК
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетаРезервов),
	|			,
	|			Организация = &Организация
	|				И &УсловиеОтбора) КАК ЕПСБУОстаткиРезервов
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ЕПСБУОстаткиРезервов.Счет.УчетПоПодразделениям
	|					И &ИспользоватьУчетПоПодразделениям
	|				ТОГДА ЕСТЬNULL(ЕПСБУОстаткиРезервов.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) В
	|						(ВЫБРАТЬ
	|							ВТ_ИсточникДанных.Подразделение
	|						ИЗ
	|							ВТ_ИсточникДанных)
	|			ИНАЧЕ ИСТИНА
	|	КОНЕЦ";
	
	УсловиеОтбора = "(Субконто1, КФО, КПС &ПолеОтбораИФО) В
	|(ВЫБРАТЬ
	|		ВТ_ИсточникДанных.Номенклатура,
	|		ВТ_ИсточникДанных.КФО,
	|		ВТ_ИсточникДанных.КПС
	|		&ПолеВыборкиИФО
	|ИЗ
	|		ВТ_ИсточникДанных)";
	
	Если УчетПоИФО Тогда
		УсловиеОтбора = СтрЗаменить(УсловиеОтбора, "&ПолеОтбораИФО", ",ИФО");
		УсловиеОтбора = СтрЗаменить(УсловиеОтбора, "&ПолеВыборкиИФО", ",ВТ_ИсточникДанных.ИФО");
	Иначе
		УсловиеОтбора = СтрЗаменить(УсловиеОтбора, "&ПолеОтбораИФО", "");
		УсловиеОтбора = СтрЗаменить(УсловиеОтбора, "&ПолеВыборкиИФО", "");
	КонецЕсли;
		
	Запрос.Текст =СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", УсловиеОтбора);
	
		
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область УстаревшиеФункцииУчетМатериальныхЗапасов

// Функция возвращает таблицу списанной номенклатуры документа по всем видам учета
//
Функция ТаблицаСписанияНоменклатуры(Документ) Экспорт
	
	ЭтоНовыйДокумент = (ТипЗнч(Документ) = Тип("Структура")); // Передана структура параметров, документ еще не записан.
	
	// Подготовим таблицу строк документа для списания по всем видам учета
	ТаблицаСтрокДокумента = УправлениеМатериальнымиЗапасами.ПодготовитьТаблицуСписанияПоДокументу(Документ);
	
	// Списание номенклатуры с учетом остатков
	ТаблицаСписанных = ТаблицаСтрокДокумента.СкопироватьКолонки();
	ТаблицаСписанных.Колонки.Добавить("Стоимость",                Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТаблицаСписанных.Колонки.Добавить("СтоимостьНеУчитываетсяНУ", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТаблицаСписанных.Колонки.Добавить("СтоимостьЕНВД",            Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТаблицаСписанных.Колонки.Добавить("ОстатокПревышен",          Новый ОписаниеТипов("Булево"));
	
	Если ТаблицаСтрокДокумента.Количество() = 0 Тогда
		// если в документе не выбраны МЗ, то дальнейшая обработка не имеет смысла, т.к. ничего не нужно списывать
		Возврат ТаблицаСписанных;
	КонецЕсли;
	
	// Подготовим таблицу остатков номенклатуры
	МоментВремени  = ?(ЭтоНовыйДокумент И Документ.Ссылка.Пустая(),
		Новый Граница(КонецДня(Документ.Дата),         ВидГраницы.Включая),
		Новый Граница(Документ.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	ТаблицаОстатки = УправлениеМатериальнымиЗапасами.ПолучитьОстаткиМатериалов(МоментВремени, Документ.Организация, ТаблицаСтрокДокумента);
	ТаблицаОстатки.Индексы.Добавить("СчетУчета,Номенклатура,ЦМО,СубконтоДоп,КФО,ИФО,КПС,Подразделение");
	
	Для каждого СтрокаДокумента Из ТаблицаСтрокДокумента Цикл
	
		КоличествоОсталосьПогасить = СтрокаДокумента.Количество;
		Если КоличествоОсталосьПогасить <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыОтбора = Новый Структура("СчетУчета,Номенклатура,ЦМО,СубконтоДоп,КФО,ИФО,КПС,Подразделение");
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаДокумента);
		
		СтрокиОстатков = ТаблицаОстатки.НайтиСтроки(ПараметрыОтбора);
		
		Для каждого СтрокаОстатков Из СтрокиОстатков Цикл

			Если СтрокаОстатков.Количество <= 0
				ИЛИ СтрокаОстатков.КоличествоВсего <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Количество = Мин(СтрокаОстатков.Количество, КоличествоОсталосьПогасить);

			Стоимость                = Окр(СтрокаОстатков.СтоимостьВсего * Количество / СтрокаОстатков.КоличествоВсего, 2, 1);
			СтоимостьНеУчитываетсяНУ = Окр(СтрокаОстатков.СтоимостьНеУчитываетсяНУВсего * Количество / СтрокаОстатков.КоличествоВсего, 2, 1);
			СтоимостьЕНВД            = Окр(СтрокаОстатков.СтоимостьЕНВДВсего * Количество / СтрокаОстатков.КоличествоВсего, 2, 1);

			КоличествоОсталосьПогасить = КоличествоОсталосьПогасить - Количество;

			СтрокаОстатков.Количество      = СтрокаОстатков.Количество - Количество;
			СтрокаОстатков.КоличествоВсего = СтрокаОстатков.КоличествоВсего - Количество;
			
			СтрокаОстатков.СтоимостьВсего                 = СтрокаОстатков.СтоимостьВсего - Стоимость;
			СтрокаОстатков.СтоимостьНеУчитываетсяНУВсего  = СтрокаОстатков.СтоимостьНеУчитываетсяНУВсего - СтоимостьНеУчитываетсяНУ;
			СтрокаОстатков.СтоимостьЕНВДВсего             = СтрокаОстатков.СтоимостьЕНВДВсего - СтоимостьЕНВД;

			СтрокаСписанных = ТаблицаСписанных.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСписанных, СтрокаДокумента);
			СтрокаСписанных.ДополнительныйВидЗатрат  = СтрокаОстатков.ДополнительныйВидЗатрат;
			СтрокаСписанных.Количество               = Количество;
			СтрокаСписанных.Стоимость                = Стоимость;
			СтрокаСписанных.СтоимостьНеУчитываетсяНУ = СтоимостьНеУчитываетсяНУ;
			СтрокаСписанных.СтоимостьЕНВД            = СтоимостьЕНВД;
			
		КонецЦикла;
		
		// Несписанное количество добавим отдельной строкой
		Если КоличествоОсталосьПогасить > 0  Тогда
			
			СтрокаСписанных = ТаблицаСписанных.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСписанных, СтрокаДокумента);
			СтрокаСписанных.Количество      = КоличествоОсталосьПогасить;
			СтрокаСписанных.ОстатокПревышен = Истина;
			
			ТекстОшибки = НСтр("ru='Указанное количество превышает остаток%3 по счету %4.
				|Остаток: %1; Не хватает: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				СтрокаДокумента.Количество - КоличествоОсталосьПогасить,
				КоличествоОсталосьПогасить,
				?(СтрокаДокумента.ВидУчета="НУ", " в налоговом учете", ""),
				СтрокаДокумента.СчетУчета);
				
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru = 'Количество'"),
				СтрокаДокумента.НомерСтроки,
				СтрокаДокумента.СинонимСписка,
				ТекстОшибки);
				
			ПолеКоличество = СтрокаДокумента.ИмяСписка + "[" + Формат(СтрокаДокумента.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Количество";
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Документ.Ссылка, ПолеКоличество, "Объект");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаСписанных;
	
КонецФункции

// Функция возвращает таблицу строк документа для списания по всем видам учета
//
Функция ПодготовитьТаблицуСписанияПоДокументу(Документ, НеЗаполятьНУ = Ложь) Экспорт
	
	ЭтоНовыйДокумент = (ТипЗнч(Документ) = Тип("Структура")); // Передана структура параметров, документ еще не записан.
	
	МетаданныеДокумента = Документ.Ссылка.Метаданные();
	
	ИмяСпискаМатериалы     = "Материалы";
	СинонимСпискаМатериалы = "Материалы";
	Если ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("МатериальныеЗапасы", МетаданныеДокумента) Тогда
		ИмяСпискаМатериалы     = "МатериальныеЗапасы";
		СинонимСпискаМатериалы = "Материальные запасы";
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("Номенклатура", МетаданныеДокумента) Тогда
		ИмяСпискаМатериалы     = "Номенклатура";
		СинонимСпискаМатериалы = "Номенклатура";
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("ОсновныеСредства", МетаданныеДокумента) Тогда
		ИмяСпискаМатериалы     = "ОсновныеСредства";
		СинонимСпискаМатериалы = "Основные средства";
	КонецЕсли;
	
	ЕстьТЧВозвратнаяТара = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("ВозвратнаяТара", МетаданныеДокумента);
	
	Запрос = Новый Запрос;
	
	Если ЭтоНовыйДокумент Тогда // Сформируем виртуальные таблицы материалов и возвратной тары.
		
		ТекстКолонок = "";
		Для Каждого КолонкаТаблицы Из Документ.ТаблицаМатериалы.Колонки Цикл
			ТекстКолонок = ТекстКолонок + ?(ПустаяСтрока(ТекстКолонок), "", ",");
			ТекстКолонок = ТекстКолонок + "
		|	ТаблицаМатериалы."+КолонкаТаблицы.Имя;
		КонецЦикла;
		
		Запрос.Текст = 
		"ВЫБРАТЬ" + ТекстКолонок + "
		|ПОМЕСТИТЬ ВременнаяТаблицаМатериалы
		|ИЗ
		|	&ТаблицаМатериалы КАК ТаблицаМатериалы";
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
		Запрос.УстановитьПараметр("ТаблицаМатериалы", Документ.ТаблицаМатериалы);
		
		Если ЕстьТЧВозвратнаяТара Тогда
			
			ТекстКолонок = "";
			Для Каждого КолонкаТаблицы Из Документ.ТаблицаВозвратнаяТара.Колонки Цикл
				ТекстКолонок = ТекстКолонок + ?(ПустаяСтрока(ТекстКолонок), "", ",");
				ТекстКолонок = ТекстКолонок + "
			|	ТаблицаВозвратнаяТара."+КолонкаТаблицы.Имя;
			КонецЦикла;
			
			Запрос.Текст = 
			"ВЫБРАТЬ" + ТекстКолонок + "
			|ПОМЕСТИТЬ ВременнаяТаблицаВозвратнаяТара
			|ИЗ
			|	&ТаблицаВозвратнаяТара КАК ТаблицаВозвратнаяТара";
			Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
			Запрос.УстановитьПараметр("ТаблицаВозвратнаяТара", Документ.ТаблицаВозвратнаяТара);
			
		КонецЕсли;
		
		ИмяИсточникаДанныхМатериалы      = "ВременнаяТаблицаМатериалы КАК ТаблицаМатериалы
			|ГДЕ
			|	ИСТИНА";
		ИмяИсточникаДанныхВозвратнаяТара = "ВременнаяТаблицаВозвратнаяТара КАК ТаблицаВозвратнаяТара
			|ГДЕ
			|	ИСТИНА";
		
	Иначе // Таблицы материалов и возвратной тары получим запросом по ссылке на документ.
		
		Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
		
		ИмяИсточникаДанныхМатериалы = "Документ."+МетаданныеДокумента.Имя+"."+ИмяСпискаМатериалы+" КАК ТаблицаМатериалы
			|ГДЕ
			|	ТаблицаМатериалы.Ссылка = &Ссылка";
		ИмяИсточникаДанныхВозвратнаяТара = "Документ."+МетаданныеДокумента.Имя+".ВозвратнаяТара КАК ТаблицаВозвратнаяТара
			|ГДЕ
			|	ТаблицаВозвратнаяТара.Ссылка = &Ссылка";
		
	КонецЕсли;
	
	// Добавляем в таблицу списания материалы
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""БУ"" КАК ВидУчета,
	|	"""+ИмяСпискаМатериалы+""" КАК ИмяСписка,
	|	"""+СинонимСпискаМатериалы+""" КАК СинонимСписка,
	|	ТаблицаМатериалы.НомерСтроки КАК НомерСтроки,
	|	ТаблицаМатериалы.Номенклатура КАК Номенклатура,
	|	ТаблицаМатериалы.СчетУчета КАК СчетСписания,
	|	ТаблицаМатериалы.ДополнительнаяАналитикаСчета КАК СубконтоДоп,
	|	ТаблицаМатериалы.Ссылка.ИФО КАК ИФО,
	|	ТаблицаМатериалы.Ссылка.КФО КАК КФО,
	|	ТаблицаМатериалы.Ссылка.КПС КАК КПС,
	|	ТаблицаМатериалы.Ссылка.Подразделение КАК Подразделение,
	|	ТаблицаМатериалы.Ссылка.ЦМО КАК ЦМО,
	|	ТаблицаМатериалы.Количество КАК Количество
	|ИЗ
	|	"+ИмяИсточникаДанныхМатериалы;
	
	// Добавляем в таблицу списания возвратную тару
	Если ЕстьТЧВозвратнаяТара Тогда
		Запрос.Текст = Запрос.Текст + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""БУ"",
		|	""ВозвратнаяТара"",
		|	""Возвратная тара"",
		|	ТаблицаВозвратнаяТара.НомерСтроки,
		|	ТаблицаВозвратнаяТара.Номенклатура,
		|	ТаблицаВозвратнаяТара.Номенклатура.СчетУчета,
		|	НЕОПРЕДЕЛЕНО,
		|	ТаблицаВозвратнаяТара.Ссылка.ИФО,
		|	ТаблицаВозвратнаяТара.Ссылка.КФО,
		|	ТаблицаВозвратнаяТара.Ссылка.КПС,
		|	ТаблицаВозвратнаяТара.Ссылка.Подразделение,
		|	ТаблицаВозвратнаяТара.Ссылка.ЦМО,
		|	ТаблицаВозвратнаяТара.Количество
		|ИЗ
		|	"+ИмяИсточникаДанныхВозвратнаяТара;
	КонецЕсли;
	
	// Добавляем в таблицу списания данные НУ
	ЕстьКФОвШапкеДокумента = ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("КФО", МетаданныеДокумента);
	Если НЕ НеЗаполятьНУ
		И (ЕстьКФОвШапкеДокумента И НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Документ.Организация, Документ.Дата, Документ.КФО)
	 		ИЛИ НЕ ЕстьКФОвШапкеДокумента И НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Документ.Организация, Документ.Дата)) Тогда
	
		Запрос.Текст = Запрос.Текст + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""НУ"",
		|	"""+ИмяСпискаМатериалы+""",
		|	"""+СинонимСпискаМатериалы+""",
		|	ТаблицаМатериалы.НомерСтроки,
		|	ТаблицаМатериалы.Номенклатура,
		|	ТаблицаМатериалы.СчетУчета,
		|	ТаблицаМатериалы.ДополнительнаяАналитикаСчета,
		|	ТаблицаМатериалы.Ссылка.ИФО,
		|	ТаблицаМатериалы.Ссылка.КФО,
		|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка),
		|	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка),
		|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка),
		|	ТаблицаМатериалы.Количество
		|ИЗ
		|	"+ИмяИсточникаДанныхМатериалы;
		
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("КФО", МетаданныеДокумента, ИмяСпискаМатериалы) Тогда
			Запрос.Текст = Запрос.Текст +"
			|	И ТаблицаМатериалы.КФО В (&МассивКФОдляНУ)";
			Запрос.УстановитьПараметр("МассивКФОдляНУ", НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета());
		КонецЕсли;
		
		Если ЕстьТЧВозвратнаяТара Тогда
			Запрос.Текст = Запрос.Текст + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	""НУ"",
			|	""ВозвратнаяТара"",
			|	""Возвратная тара"",
			|	ТаблицаВозвратнаяТара.НомерСтроки,
			|	ТаблицаВозвратнаяТара.Номенклатура,
			|	ТаблицаВозвратнаяТара.Номенклатура.СчетУчета,
			|	НЕОПРЕДЕЛЕНО,
			|	ТаблицаВозвратнаяТара.Ссылка.ИФО,
			|	ТаблицаВозвратнаяТара.Ссылка.КФО,
			|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка),
			|	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка),
			|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка),
			|	ТаблицаВозвратнаяТара.Количество
			|ИЗ
			|	"+ИмяИсточникаДанныхВозвратнаяТара;
		КонецЕсли;
		
	КонецЕсли;
	
	// Шапка.
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ПодразделениеОтправитель", МетаданныеДокумента) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Ссылка.Подразделение", "Ссылка.ПодразделениеОтправитель");
	КонецЕсли;
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ЦМООтправитель", МетаданныеДокумента) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Ссылка.ЦМО", "Ссылка.ЦМООтправитель");
	КонецЕсли;
	
	// Таблица материалов.
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("Подразделение", МетаданныеДокумента, ИмяСпискаМатериалы) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Ссылка.Подразделение", "Подразделение");
	КонецЕсли;	
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("ЦМО", МетаданныеДокумента, ИмяСпискаМатериалы) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Ссылка.ЦМО", "ЦМО");
	КонецЕсли;	
	
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("ИФО", МетаданныеДокумента, ИмяСпискаМатериалы) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаМатериалы.Ссылка.ИФО", "ТаблицаМатериалы.ИФО");
	КонецЕсли;
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("КФО", МетаданныеДокумента, ИмяСпискаМатериалы) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаМатериалы.Ссылка.КФО", "ТаблицаМатериалы.КФО");
	ИначеЕсли НЕ ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("КФО", МетаданныеДокумента) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаМатериалы.Ссылка.КФО", "ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
	КонецЕсли;
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("КПС", МетаданныеДокумента, ИмяСпискаМатериалы) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаМатериалы.Ссылка.КПС", "ТаблицаМатериалы.КПС");
	КонецЕсли;
	Если НЕ ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("СчетУчета", МетаданныеДокумента, ИмяСпискаМатериалы) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаМатериалы.СчетУчета", "ТаблицаМатериалы.Номенклатура.СчетУчета");
	КонецЕсли;
	Если НЕ ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("ДополнительнаяАналитикаСчета", МетаданныеДокумента, ИмяСпискаМатериалы) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаМатериалы.ДополнительнаяАналитикаСчета", "НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	Если ЭтоНовыйДокумент Тогда // Для новых документов все реквизиты списания должны быть переданы в таблице материалов.
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаМатериалы.Ссылка.", "ТаблицаМатериалы.");
	КонецЕсли;
	
	// Таблица возвратной тары.
	Если ЕстьТЧВозвратнаяТара Тогда
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("ИФО", МетаданныеДокумента, "ВозвратнаяТара") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаВозвратнаяТара.Ссылка.ИФО", "ТаблицаВозвратнаяТара.ИФО");
		КонецЕсли;
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("КФО", МетаданныеДокумента, "ВозвратнаяТара") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаВозвратнаяТара.Ссылка.КФО", "ТаблицаВозвратнаяТара.КФО");
		ИначеЕсли НЕ ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("КФО", МетаданныеДокумента) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаВозвратнаяТара.Ссылка.КФО", "ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)");
		КонецЕсли;
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("КПС", МетаданныеДокумента, "ВозвратнаяТара") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаВозвратнаяТара.Ссылка.КПС", "ТаблицаВозвратнаяТара.КПС");
		КонецЕсли;
		Если НЕ ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("СчетУчета", МетаданныеДокумента, "ВозвратнаяТара") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаВозвратнаяТара.СчетУчета", "ТаблицаВозвратнаяТара.Номенклатура.СчетУчета");
		КонецЕсли;
		Если НЕ ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("ДополнительнаяАналитикаСчета", МетаданныеДокумента, "ВозвратнаяТара") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаВозвратнаяТара.ДополнительнаяАналитикаСчета", "НЕОПРЕДЕЛЕНО");
		КонецЕсли;
		Если ЭтоНовыйДокумент Тогда // Для новых документов все реквизиты списания должны быть переданы в таблице возвратной тары.
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаВозвратнаяТара.Ссылка.", "ТаблицаВозвратнаяТара.");
		КонецЕсли;
	КонецЕсли;
	
	СтрокиДокумента = Запрос.Выполнить().Выгрузить();
	
	ТаблицаСписания = СтрокиДокумента.СкопироватьКолонки();
	ТаблицаСписания.Колонки.Добавить("СчетУчета",			Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаСписания.Колонки.Добавить("УчетПоИФО",			Новый ОписаниеТипов("Булево"));
	ТаблицаСписания.Колонки.Добавить("УчетПоКПС",			Новый ОписаниеТипов("Булево"));
	ТаблицаСписания.Колонки.Добавить("УчетПоПодразделениям",Новый ОписаниеТипов("Булево"));
	ТаблицаСписания.Колонки.Добавить("ЕстьСубконтоЦМО",		Новый ОписаниеТипов("Булево"));
	ТаблицаСписания.Колонки.Добавить("СубконтоЦМОСуммовой",	Новый ОписаниеТипов("Булево"));
	ТаблицаСписания.Колонки.Добавить("ЕстьСубконтоДоп",		Новый ОписаниеТипов("Булево"));
	ТаблицаСписания.Колонки.Добавить("СубконтоДопСуммовой",	Новый ОписаниеТипов("Булево"));
	ТаблицаСписания.Колонки.Добавить("ВидСубконтоДоп",		Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	
	ТаблицаСписания.Колонки.Добавить("УчитыватьДополнительныйВидЗатрат", Новый ОписаниеТипов("Булево"));
	ТаблицаСписания.Колонки.Добавить("ДополнительныйВидЗатрат", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ОсобыеСчета = Новый Массив;
	ОсобыеСчета.Добавить(БухгалтерскийУчет.СчетПоКоду("106.2П", Документ.Дата, Документ.Организация));
	ОсобыеСчета.Добавить(БухгалтерскийУчет.СчетПоКоду("106.3П", Документ.Дата, Документ.Организация));
	ОсобыеСчета.Добавить(БухгалтерскийУчет.СчетПоКоду("106.4П", Документ.Дата, Документ.Организация));
	ОсобыеСчета.Добавить(БухгалтерскийУчет.СчетПоКоду("Н15", Документ.Дата, Документ.Организация));
	
	Для Каждого СтрокаДокумента Из СтрокиДокумента Цикл
		
		Если ЗначениеЗаполнено(СтрокаДокумента.СчетСписания) И ТипЗнч(СтрокаДокумента.СчетСписания) = Тип("Строка") Тогда
			СчетСписанияСсылка = БухгалтерскийУчет.СчетПоКоду(СтрокаДокумента.СчетСписания, Документ.Дата, Документ.Организация);
		Иначе
			СчетСписанияСсылка = СтрокаДокумента.СчетСписания;
		КонецЕсли;
		
		Если СтрокаДокумента.ВидУчета = "НУ" Тогда
			СчетСписанияСсылка = БухгалтерскиеОперации.ПолучитьСчетНУпоСчетуБУ(СчетСписанияСсылка);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СчетСписанияСсылка) Тогда
			Продолжить; // не определен счет списания
		КонецЕсли;
		
		УчитыватьДополнительныйВидЗатрат = ОсобыеСчета.Найти(СчетСписанияСсылка) <> Неопределено;
		
		СтрокаТаблицы = ТаблицаСписания.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаДокумента);
		
		СтрокаТаблицы.СчетУчета = СчетСписанияСсылка;
		
		ПараметрыСчета = БухгалтерскиеОперацииПовтИсп.ПолучитьПараметрыСчетаУчетаМЗ(СтрокаТаблицы.СчетУчета, УчитыватьДополнительныйВидЗатрат);
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ПараметрыСчета,
			"УчетПоКПС,УчетПоПодразделениям,ЕстьСубконтоЦМО,СубконтоЦМОСуммовой,ЕстьСубконтоДоп,СубконтоДопСуммовой,ВидСубконтоДоп");
		
		СтрокаТаблицы.УчетПоИФО     = УчетПоИФО;
		СтрокаТаблицы.ИФО           = ?(СтрокаТаблицы.УчетПоИФО,            СтрокаТаблицы.ИФО,           Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
		СтрокаТаблицы.КПС           = ?(СтрокаТаблицы.УчетПоКПС,            СтрокаТаблицы.КПС,           Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
		СтрокаТаблицы.Подразделение = ?(СтрокаТаблицы.УчетПоПодразделениям, СтрокаТаблицы.Подразделение, Справочники.Подразделения.ПустаяСсылка());
		СтрокаТаблицы.ЦМО           = ?(СтрокаТаблицы.ЕстьСубконтоЦМО,      СтрокаТаблицы.ЦМО,           Справочники.ЦМО.ПустаяСсылка());
		СтрокаТаблицы.СубконтоДоп   = ?(СтрокаТаблицы.ЕстьСубконтоДоп,      СтрокаТаблицы.СубконтоДоп,   Неопределено);
		
		СтрокаТаблицы.УчитыватьДополнительныйВидЗатрат = УчитыватьДополнительныйВидЗатрат;
	
	КонецЦикла;
	
	Возврат ТаблицаСписания;
	
КонецФункции

// Функция возвращает таблицу остатков номенклатуры для переданной таблицы списания
//
Функция ПолучитьОстаткиМатериалов(МоментВремени, Организация, ТаблицаСписания) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени);
	Запрос.УстановитьПараметр("Организация",   Организация);
	
	КолонкиПараметровУчета = 
		"УчетПоИФО, УчетПоКПС, УчетПоПодразделениям,
		|ЕстьСубконтоЦМО, СубконтоЦМОСуммовой,
		|ЕстьСубконтоДоп, ВидСубконтоДоп, СубконтоДопСуммовой, УчитыватьДополнительныйВидЗатрат";
	ТаблицаПараметровСчетовУчета = ТаблицаСписания.Скопировать(,КолонкиПараметровУчета);
	ТаблицаПараметровСчетовУчета.Свернуть(КолонкиПараметровУчета);
	
	// Текст запроса по остаткам формируется для каждого набора параметров учета МЗ
	ТекстОбщегоЗапроса = "";
	Для НомерЗапроса=1 По ТаблицаПараметровСчетовУчета.Количество() Цикл
		
		НаборПараметровУчета = ТаблицаПараметровСчетовУчета[НомерЗапроса-1];
		
		// Добавляем виртуальную таблицу
		Запрос.Текст = Запрос.Текст + ТекстЗапросаОстаткиМатериалов(НаборПараметровУчета, НомерЗапроса);
		
		// Устанавливаем параметры виртуальной таблицы
		Отбор = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НаборПараметровУчета);
		СтрокиТаблицыСписания = ТаблицаСписания.Скопировать(ТаблицаСписания.НайтиСтроки(Отбор));
		
		Запрос.УстановитьПараметр("Счета" + НомерЗапроса,                СтрокиТаблицыСписания.ВыгрузитьКолонку("СчетУчета"));
		Запрос.УстановитьПараметр("ИФО" + НомерЗапроса,                  СтрокиТаблицыСписания.ВыгрузитьКолонку("ИФО"));
		Запрос.УстановитьПараметр("КФО" + НомерЗапроса,                  СтрокиТаблицыСписания.ВыгрузитьКолонку("КФО"));
		Запрос.УстановитьПараметр("КПС" + НомерЗапроса,                  СтрокиТаблицыСписания.ВыгрузитьКолонку("КПС"));
		Запрос.УстановитьПараметр("Подразделение" + НомерЗапроса,        СтрокиТаблицыСписания.ВыгрузитьКолонку("Подразделение"));
		Запрос.УстановитьПараметр("Номенклатура" + НомерЗапроса,         СтрокиТаблицыСписания.ВыгрузитьКолонку("Номенклатура"));
		Запрос.УстановитьПараметр("ЦМО" + НомерЗапроса,                  СтрокиТаблицыСписания.ВыгрузитьКолонку("ЦМО"));
		Запрос.УстановитьПараметр("СубконтоДоп" + НомерЗапроса,          СтрокиТаблицыСписания.ВыгрузитьКолонку("СубконтоДоп"));
		Запрос.УстановитьПараметр("УчетПоПодразделениям" + НомерЗапроса, НаборПараметровУчета.УчетПоПодразделениям);
		Запрос.УстановитьПараметр("УчетПоКПС" + НомерЗапроса,            НаборПараметровУчета.УчетПоКПС);
		
		МассивСубконто = Новый Массив;
		МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
		Если НаборПараметровУчета.ЕстьСубконтоЦМО Тогда
			МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
		КонецЕсли;
		Если НаборПараметровУчета.ЕстьСубконтоДоп Тогда
			МассивСубконто.Добавить(НаборПараметровУчета.ВидСубконтоДоп);
		КонецЕсли;
		Если НаборПараметровУчета.УчитыватьДополнительныйВидЗатрат Тогда
			МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат);	
		КонецЕсли;
		Запрос.УстановитьПараметр("Субконто" + НомерЗапроса, МассивСубконто);
		
		МассивСубконтоДляРасчетаСтоимости = Новый Массив;
		МассивСубконтоДляРасчетаСтоимости.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
		Если НаборПараметровУчета.ЕстьСубконтоЦМО И НаборПараметровУчета.СубконтоЦМОСуммовой Тогда
			МассивСубконтоДляРасчетаСтоимости.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
		КонецЕсли;
		Если НаборПараметровУчета.ЕстьСубконтоДоп И НаборПараметровУчета.СубконтоДопСуммовой Тогда
			МассивСубконтоДляРасчетаСтоимости.Добавить(НаборПараметровУчета.ВидСубконтоДоп);
		КонецЕсли;
		Если НаборПараметровУчета.УчитыватьДополнительныйВидЗатрат Тогда
			МассивСубконтоДляРасчетаСтоимости.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат);	
		КонецЕсли;
		Запрос.УстановитьПараметр("СубконтоДляРасчетаСтоимости" + НомерЗапроса, МассивСубконтоДляРасчетаСтоимости);
		
		// Соединение виртуальных таблиц
		Если НЕ ПустаяСтрока(ТекстОбщегоЗапроса) Тогда
			ТекстОбщегоЗапроса = ТекстОбщегоЗапроса + "
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|";
		КонецЕсли;
		
		ТекстОбщегоЗапроса = ТекстОбщегоЗапроса +
		"ВЫБРАТЬ
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.СчетУчета,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КодСчета,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.УчетПоПодразделениям,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.УчетПоКПС,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.ИФО,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КФО,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КПС,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Подразделение,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Номенклатура,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.ЦМО,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.СубконтоДоп,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Количество,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КоличествоВсего,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.СтоимостьВсего,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.СтоимостьНеУчитываетсяНУВсего,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.СтоимостьЕНВДВсего,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.ДополнительныйВидЗатрат
		|ИЗ
		|	ОстаткиМатериалов_НомерЗапроса КАК ТаблицаОстаткиМатериалов_НомерЗапроса";
		
		ТекстОбщегоЗапроса = СтрЗаменить(ТекстОбщегоЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + ТекстОбщегоЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Функция возвращает текст запроса для одного набора параметров учета МЗ
//
Функция ТекстЗапросаОстаткиМатериалов(ПараметрыУчета, НомерЗапроса)
	
	ТолькоКоличественныйУчетПоСубконто =
			(ПараметрыУчета.ЕстьСубконтоЦМО И НЕ ПараметрыУчета.СубконтоЦМОСуммовой)
		ИЛИ (ПараметрыУчета.ЕстьСубконтоДоп И НЕ ПараметрыУчета.СубконтоДопСуммовой);
	
	Если ТолькоКоличественныйУчетПоСубконто Тогда
		
		// Остатки для расчета стоимости, по субконто с суммовым учетом
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
			|	ЖурналПроводокЕПСБУОстатки.Счет.Код КАК КодСчета,
			|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
			|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
			|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
			|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Номенклатура,
			|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
			|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК СубконтоДоп,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоВсего,
			|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СтоимостьВсего,
			|	ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СтоимостьНеУчитываетсяНУВсего,
			|	ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СтоимостьЕНВДВсего,
			|	&ПолеВидЗатрат КАК ДополнительныйВидЗатрат
			|ПОМЕСТИТЬ ВТ_ОстаткиСтоимостьМатериалов_НомерЗапроса
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&МоментВремени,
			|			Счет В (&Счета_НомерЗапроса),
			|			&СубконтоДляРасчетаСтоимости_НомерЗапроса,
			|			Организация = &Организация
			|				И КФО В (&КФО_НомерЗапроса)
			|				И Субконто1 В (&Номенклатура_НомерЗапроса)
			|				И &УсловиеПоЦМО
			|				И &УсловиеПоСубконтоДоп
			|				И &УсловиеПоИФО
			|				И &УсловиеПоКПС
			|				И &УсловиеПоПодразделению) КАК ЖурналПроводокЕПСБУОстатки
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	СчетУчета,
			|	КФО,
			|	Номенклатура,
			|	ЦМО,
			|	СубконтоДоп,
			|	КПС,
			|	ИФО,
			|	Подразделение";
			
		Если ПараметрыУчета.ЕстьСубконтоЦМО И ПараметрыУчета.СубконтоЦМОСуммовой Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоЦМО", "Субконто2 В (&ЦМО_НомерЗапроса)");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоЦМО", "ИСТИНА");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.Субконто2", "ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)");
		КонецЕсли;
		Если ПараметрыУчета.ЕстьСубконтоДоп И ПараметрыУчета.СубконтоДопСуммовой Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоСубконтоДоп", "Субконто3 В (&СубконтоДоп_НомерЗапроса)");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоСубконтоДоп", "ИСТИНА");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.Субконто3", "НЕОПРЕДЕЛЕНО");
		КонецЕсли;
		Если НЕ (ПараметрыУчета.ЕстьСубконтоЦМО И ПараметрыУчета.СубконтоЦМОСуммовой) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Субконто3", "Субконто2");
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
		
		// Остатки по субконто с количественным учетом
		ТекстЗапроса = ТекстЗапроса + 
			"ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
			|	ЖурналПроводокЕПСБУОстатки.Счет.Код КАК КодСчета,
			|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
			|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
			|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
			|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Номенклатура,
			|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
			|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК СубконтоДоп,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество,
			|	&ПолеВидЗатрат КАК ДополнительныйВидЗатрат
			|ПОМЕСТИТЬ ВТ_ОстаткиМатериалов_НомерЗапроса
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&МоментВремени,
			|			Счет В (&Счета_НомерЗапроса),
			|			&Субконто_НомерЗапроса,
			|			Организация = &Организация
			|				И КФО В (&КФО_НомерЗапроса)
			|				И Субконто1 В (&Номенклатура_НомерЗапроса)
			|				И &УсловиеПоЦМО
			|				И &УсловиеПоСубконтоДоп
			|				И &УсловиеПоИФО
			|				И &УсловиеПоКПС
			|				И &УсловиеПоПодразделению) КАК ЖурналПроводокЕПСБУОстатки
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	СчетУчета,
			|	КФО,
			|	Номенклатура,
			|	ЦМО,
			|	СубконтоДоп,
			|	КПС,
			|	ИФО,
			|	Подразделение";
			
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоЦМО",
			?(ПараметрыУчета.ЕстьСубконтоЦМО, "Субконто2 В (&ЦМО_НомерЗапроса)", "ИСТИНА") );
			
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоСубконтоДоп",
			?(ПараметрыУчета.ЕстьСубконтоДоп, "Субконто3 В (&СубконтоДоп_НомерЗапроса)", "ИСТИНА") );
			
		ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
		
		// Соединяем виртуальные таблицы остатков
		ТекстЗапроса = ТекстЗапроса + 
			"ВЫБРАТЬ
			|	ОстаткиМатериалов.СчетУчета КАК СчетУчета,
			|	ОстаткиМатериалов.СчетУчета.Код КАК КодСчета,
			|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
			|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
			|	ОстаткиМатериалов.ИФО КАК ИФО,
			|	ОстаткиМатериалов.КФО КАК КФО,
			|	ОстаткиМатериалов.КПС КАК КПС,
			|	ОстаткиМатериалов.Подразделение КАК Подразделение,
			|	ОстаткиМатериалов.Номенклатура КАК Номенклатура,
			|	ОстаткиМатериалов.ЦМО КАК ЦМО,
			|	ОстаткиМатериалов.СубконтоДоп КАК СубконтоДоп,
			|	СУММА(ОстаткиМатериалов.Количество) КАК Количество,
			|	СУММА(ОстаткиСтоимостьМатериалов.КоличествоВсего) КАК КоличествоВсего,
			|	СУММА(ОстаткиСтоимостьМатериалов.СтоимостьВсего) КАК СтоимостьВсего,
			|	СУММА(ОстаткиСтоимостьМатериалов.СтоимостьНеУчитываетсяНУВсего) КАК СтоимостьНеУчитываетсяНУВсего,
			|	СУММА(ОстаткиСтоимостьМатериалов.СтоимостьЕНВДВсего) КАК СтоимостьЕНВДВсего,
			|	МАКСИМУМ(ОстаткиМатериалов.ДополнительныйВидЗатрат) КАК ДополнительныйВидЗатрат
			|ПОМЕСТИТЬ ОстаткиМатериалов_НомерЗапроса
			|ИЗ
			|	ВТ_ОстаткиМатериалов_НомерЗапроса КАК ОстаткиМатериалов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОстаткиСтоимостьМатериалов_НомерЗапроса КАК ОстаткиСтоимостьМатериалов
			|		ПО ОстаткиМатериалов.СчетУчета = ОстаткиСтоимостьМатериалов.СчетУчета
			|			И ОстаткиМатериалов.КФО = ОстаткиСтоимостьМатериалов.КФО
			|			И ОстаткиМатериалов.Номенклатура = ОстаткиСтоимостьМатериалов.Номенклатура
			|			И ОстаткиМатериалов.ДополнительныйВидЗатрат = ОстаткиСтоимостьМатериалов.ДополнительныйВидЗатрат
			|			И ОстаткиМатериалов.ЦМО = ОстаткиСтоимостьМатериалов.ЦМО
			|			И ОстаткиМатериалов.СубконтоДоп = ОстаткиСтоимостьМатериалов.СубконтоДоп
			|			И ОстаткиМатериалов.КПС = ОстаткиСтоимостьМатериалов.КПС
			|			И ОстаткиМатериалов.ИФО = ОстаткиСтоимостьМатериалов.ИФО
			|			И ОстаткиМатериалов.Подразделение = ОстаткиСтоимостьМатериалов.Подразделение
			|
			|СГРУППИРОВАТЬ ПО
			|	ОстаткиМатериалов.СчетУчета,
			|	ОстаткиМатериалов.СчетУчета.Код,
			|	ОстаткиМатериалов.ИФО,
			|	ОстаткиМатериалов.КФО,
			|	ОстаткиМатериалов.КПС,
			|	ОстаткиМатериалов.Подразделение,
			|	ОстаткиМатериалов.Номенклатура,
			|	ОстаткиМатериалов.ЦМО,
			|	ОстаткиМатериалов.СубконтоДоп";
		Если НЕ (ПараметрыУчета.ЕстьСубконтоЦМО И ПараметрыУчета.СубконтоЦМОСуммовой) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ОстаткиМатериалов.ЦМО = ОстаткиСтоимостьМатериалов.ЦМО", "");
		КонецЕсли;
		Если НЕ (ПараметрыУчета.ЕстьСубконтоДоп И ПараметрыУчета.СубконтоДопСуммовой) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ОстаткиМатериалов.СубконтоДоп = ОстаткиСтоимостьМатериалов.СубконтоДоп", "");
		КонецЕсли;
		Если НЕ ПараметрыУчета.УчетПоКПС Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ОстаткиМатериалов.КПС = ОстаткиСтоимостьМатериалов.КПС", "");
		КонецЕсли;
		Если НЕ ПараметрыУчета.УчетПоИФО Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ОстаткиМатериалов.ИФО = ОстаткиСтоимостьМатериалов.ИФО", "");
		КонецЕсли;
		Если НЕ ПараметрыУчета.УчетПоПодразделениям Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ОстаткиМатериалов.Подразделение = ОстаткиСтоимостьМатериалов.Подразделение", "");
		КонецЕсли;
		
	Иначе // по всем субконто ведется и количественный, и суммовой учет
		
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
			|	ЖурналПроводокЕПСБУОстатки.Счет.Код КАК КодСчета,
			|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
			|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
			|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
			|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
			|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
			|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Номенклатура,
			|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
			|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК СубконтоДоп,
			|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК Количество,
			|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК КоличествоВсего,
			|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт) КАК СтоимостьВсего,
			|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт) КАК СтоимостьНеУчитываетсяНУВсего,
			|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстатокДт) КАК СтоимостьЕНВДВсего,
			|	МАКСИМУМ(&ПолеВидЗатрат) КАК ДополнительныйВидЗатрат
			|ПОМЕСТИТЬ ОстаткиМатериалов_НомерЗапроса
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&МоментВремени,
			|			Счет В (&Счета_НомерЗапроса),
			|			&Субконто_НомерЗапроса,
			|			Организация = &Организация
			|				И КФО В (&КФО_НомерЗапроса)
			|				И Субконто1 В (&Номенклатура_НомерЗапроса)
			|				И &УсловиеПоЦМО
			|				И &УсловиеПоСубконтоДоп
			|				И &УсловиеПоИФО
			|				И &УсловиеПоКПС
			|				И &УсловиеПоПодразделению) КАК ЖурналПроводокЕПСБУОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	ЖурналПроводокЕПСБУОстатки.Счет,
			|	ЖурналПроводокЕПСБУОстатки.Счет.Код,
			|	ЖурналПроводокЕПСБУОстатки.ИФО,
			|	ЖурналПроводокЕПСБУОстатки.КФО,
			|	ЖурналПроводокЕПСБУОстатки.КПС,
			|	ЖурналПроводокЕПСБУОстатки.Подразделение,
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	ЖурналПроводокЕПСБУОстатки.Субконто2,
			|	ЖурналПроводокЕПСБУОстатки.Субконто3";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоЦМО",
			?(ПараметрыУчета.ЕстьСубконтоЦМО, "Субконто2 В (&ЦМО_НомерЗапроса)", "ИСТИНА") );
			
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоСубконтоДоп",
			?(ПараметрыУчета.ЕстьСубконтоДоп, "Субконто3 В (&СубконтоДоп_НомерЗапроса)", "ИСТИНА") );
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоИФО",
		?(ПараметрыУчета.УчетПоИФО, "ИФО В (&ИФО_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКПС",
		?(ПараметрыУчета.УчетПоКПС, "КПС В (&КПС_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению",
		?(ПараметрыУчета.УчетПоПодразделениям, "Подразделение В (&Подразделение_НомерЗапроса)", "ИСТИНА") );
	
	Если НЕ ПараметрыУчета.ЕстьСубконтоЦМО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.Субконто2", "ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.ЕстьСубконтоДоп Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.Субконто3", "НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоКПС Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.КПС", "ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоИФО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоПодразделениям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	// Если субконто ЦМО нет, меняем номер дополнительного субконто
	Если ПараметрыУчета.ЕстьСубконтоДоп И НЕ ПараметрыУчета.ЕстьСубконтоЦМО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Субконто3", "Субконто2");
	КонецЕсли;
	Если ПараметрыУчета.ЕстьСубконтоДоп И НЕ ПараметрыУчета.ЕстьСубконтоЦМО И ПараметрыУчета.УчитыватьДополнительныйВидЗатрат Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеВидЗатрат", "ЖурналПроводокЕПСБУОстатки.Субконто3");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеВидЗатрат", "Истина");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
	
	Возврат ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
	
КонецФункции

// Устарела. Подготавливает таблицу документа (в унифицированном формате) для учета реализации материальных запасов.
//
Функция ПодготовитьТаблицуРеализацияИмуществаКазныПоДокументу(Документ, Параметры = Неопределено) Экспорт
	
	ТаблицаДокумента = ПустаяТаблицаРеализацияМатериальныхЗапасовПоДокументу();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.НакладнаяНаОтпускИК") Тогда
		
		Параметры.Вставить("ВалютаДокумента", Константы.ВалютаРегламентированногоУчета.Получить());
		Параметры.Вставить("СчетУчета", БухгалтерскийУчет.СчетПоКоду("108.56", Документ.Дата, Документ.Организация));
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,Контрагент,Договор,ВалютаДокумента,СчетУчета,
			|Номенклатура,Количество,Всего,СтавкаНДС,СуммаНДС",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""Материалы"" КАК ИмяСписка,
		|	""Материалы"" КАК СинонимСписка,
		|	Материалы.НомерСтроки КАК НомерСтроки,
		|	Материалы.ИФО КАК ИФО,
		|	Материалы.КФО КАК КФО,
		|	Материалы.КПС КАК КПС,
		|	Материалы.Подразделение КАК Подразделение,
		|	Материалы.СчетУчета КАК СчетУчета,
		|	Материалы.Номенклатура КАК Номенклатура,
		|	Материалы.Контрагент КАК Контрагент,
		|	Материалы.Договор КАК Договор,
		|	Материалы.ВалютаДокумента КАК Валюта,
		|	Материалы.Количество КАК Количество,
		|	Материалы.Всего КАК Сумма,
		|	Материалы.СтавкаНДС КАК СтавкаНДС,
		|	Материалы.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	ТаблицаМатериалы КАК Материалы
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	КонецЕсли;
	
	РеализацияМатериальныхЗапасов = Запрос.Выполнить().Выгрузить();
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// Счет расчетов.
	СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Реализация",
		Документ.Дата, Документ.Организация, Документ.ИФО);
	
	// В документах реализации в таб.части указан КПС расходов.
	// Для расчетов должен использоваться КПС доходов (если указан).
	ИспользоватьКПСРасчетов = Параметры.Свойство("КПС") И ЗначениеЗаполнено(Параметры.КПС);
	
	Для Каждого Строка Из РеализацияМатериальныхЗапасов Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Не ИспользоватьВалютныйУчет И Не ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СчетРасчетов) Тогда
			НоваяСтрока.СчетРасчетов = СчетРасчетов;
		Иначе
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.74", Документ.Дата, Документ.Организация);
		КонецЕсли;
		
		Если ИспользоватьКПСРасчетов Тогда
			НоваяСтрока.КПС = Параметры.КПС;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

#КонецОбласти

#Область УчетМатериаловВПользовании

// Функция возвращает таблицу остатков номенклатуры для переданной таблицы списания
//
Функция ПолучитьОстаткиМатериаловВПользовании(МоментВремени, Организация, ТаблицаСписания) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени);
	Запрос.УстановитьПараметр("Организация",   Организация);
	
	КолонкиПараметровУчета = 
		"УчетПоИФО, СчетВПользованииУчетПоКПС, СчетВПользованииУчетПоПодразделениям,
		|ЕстьСубконтоДоговоры";
	ТаблицаПараметровСчетовУчета = ТаблицаСписания.Скопировать(,КолонкиПараметровУчета);
	ТаблицаПараметровСчетовУчета.Свернуть(КолонкиПараметровУчета);
	
	// Текст запроса по остаткам формируется для каждого набора параметров учета МЗ
	ТекстОбщегоЗапроса = "";
	Для НомерЗапроса=1 По ТаблицаПараметровСчетовУчета.Количество() Цикл
		
		НаборПараметровУчета = ТаблицаПараметровСчетовУчета[НомерЗапроса-1];
		
		// Добавляем виртуальную таблицу
		Запрос.Текст = Запрос.Текст + ТекстЗапросаОстаткиМатериаловВПользовании(НаборПараметровУчета, НомерЗапроса);
		
		// Устанавливаем параметры виртуальной таблицы
		Отбор = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НаборПараметровУчета);
		СтрокиТаблицыСписания = ТаблицаСписания.Скопировать(ТаблицаСписания.НайтиСтроки(Отбор));
		
		Запрос.УстановитьПараметр("Счета" + НомерЗапроса,                СтрокиТаблицыСписания.ВыгрузитьКолонку("СчетВПользовании"));
		Запрос.УстановитьПараметр("ИФО" + НомерЗапроса,                  СтрокиТаблицыСписания.ВыгрузитьКолонку("ИФО"));
		Запрос.УстановитьПараметр("КФО" + НомерЗапроса,                  СтрокиТаблицыСписания.ВыгрузитьКолонку("КФО"));
		Запрос.УстановитьПараметр("КПС" + НомерЗапроса,                  СтрокиТаблицыСписания.ВыгрузитьКолонку("КПС"));
		Запрос.УстановитьПараметр("Подразделение" + НомерЗапроса,        СтрокиТаблицыСписания.ВыгрузитьКолонку("Подразделение"));
		Запрос.УстановитьПараметр("Номенклатура" + НомерЗапроса,         СтрокиТаблицыСписания.ВыгрузитьКолонку("Номенклатура"));
		Запрос.УстановитьПараметр("УчетПоПодразделениям" + НомерЗапроса, НаборПараметровУчета.СчетВПользованииУчетПоПодразделениям);
		Запрос.УстановитьПараметр("УчетПоКПС" + НомерЗапроса,            НаборПараметровУчета.СчетВПользованииУчетПоКПС);
		Запрос.УстановитьПараметр("Контрагенты" + НомерЗапроса,           СтрокиТаблицыСписания.ВыгрузитьКолонку("Контрагент"));
		Запрос.УстановитьПараметр("Договоры" + НомерЗапроса,           	 СтрокиТаблицыСписания.ВыгрузитьКолонку("Договор"));
		Запрос.УстановитьПараметр("ЕстьСубконтоДоговоры" + НомерЗапроса, НаборПараметровУчета.ЕстьСубконтоДоговоры);
		
		МассивСубконто = Новый Массив;
		МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
		МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
		Если НаборПараметровУчета.ЕстьСубконтоДоговоры Тогда
			МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
		КонецЕсли;
		Запрос.УстановитьПараметр("Субконто" + НомерЗапроса, МассивСубконто);
		
		// Соединение виртуальных таблиц
		Если НЕ ПустаяСтрока(ТекстОбщегоЗапроса) Тогда
			ТекстОбщегоЗапроса = ТекстОбщегоЗапроса + "
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|";
		КонецЕсли;
		
		ТекстОбщегоЗапроса = ТекстОбщегоЗапроса +
		"ВЫБРАТЬ
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.СчетУчета,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КодСчета,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.УчетПоПодразделениям,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.УчетПоКПС,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.ИФО,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КФО,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КПС,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Подразделение,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Номенклатура,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Контрагент,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Договор,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.Количество,
		|	ТаблицаОстаткиМатериалов_НомерЗапроса.КоличествоВсего
		|ИЗ
		|	ОстаткиМатериалов_НомерЗапроса КАК ТаблицаОстаткиМатериалов_НомерЗапроса";
		
		ТекстОбщегоЗапроса = СтрЗаменить(ТекстОбщегоЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + ТекстОбщегоЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Функция возвращает текст запроса для одного набора параметров учета МЗ
//
Функция ТекстЗапросаОстаткиМатериаловВПользовании(ПараметрыУчета, НомерЗапроса)
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
		|	ЖурналПроводокЕПСБУОстатки.Счет.Код КАК КодСчета,
		|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
		|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
		|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
		|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Контрагенты) КАК Контрагент,
		|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Договор,
		|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК Количество,
		|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК КоличествоВсего
		|ПОМЕСТИТЬ ОстаткиМатериалов_НомерЗапроса
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&МоментВремени,
		|			Счет В (&Счета_НомерЗапроса),
		|			&Субконто_НомерЗапроса,
		|			Организация = &Организация
		|				И КФО В (&КФО_НомерЗапроса)
		|				И Субконто1 В (&Номенклатура_НомерЗапроса)
		|				И Субконто2 В (&Контрагенты_НомерЗапроса)
		|				И &УсловиеПоДоговору
		|				И &УсловиеПоИФО
		|				И &УсловиеПоКПС
		|				И &УсловиеПоПодразделению) КАК ЖурналПроводокЕПСБУОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЖурналПроводокЕПСБУОстатки.Счет,
		|	ЖурналПроводокЕПСБУОстатки.Счет.Код,
		|	ЖурналПроводокЕПСБУОстатки.ИФО,
		|	ЖурналПроводокЕПСБУОстатки.КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС,
		|	ЖурналПроводокЕПСБУОстатки.Подразделение,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура),
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Контрагенты),
		|	ЖурналПроводокЕПСБУОстатки.Субконто3";
	
	Если ПараметрыУчета.ЕстьСубконтоДоговоры Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДоговору", "Субконто3 В (&Договоры_НомерЗапроса)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоДоговору", "ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.Субконто3", "ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)");
	КонецЕсли;
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоИФО",
		?(ПараметрыУчета.УчетПоИФО, "ИФО В (&ИФО_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКПС",
		?(ПараметрыУчета.СчетВПользованииУчетПоКПС, "КПС В (&КПС_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению",
		?(ПараметрыУчета.СчетВПользованииУчетПоПодразделениям, "Подразделение В (&Подразделение_НомерЗапроса)", "ИСТИНА") );
	
	Если НЕ ПараметрыУчета.СчетВПользованииУчетПоКПС Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.КПС", "ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоИФО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.СчетВПользованииУчетПоПодразделениям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУОстатки.Субконто3", "Выразить(ЖурналПроводокЕПСБУОстатки.Субконто3 Как Справочник.Договоры)");
	
	Возврат ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов();
	
КонецФункции

Процедура ДоработатьТаблицуСписанияИзПользования(ТаблицаСписания, КодГруппы, Знач ПараметрыЗаполнения) Экспорт
	
	Если ПараметрыЗаполнения = Неопределено Тогда
		ПараметрыЗаполнения = Новый Структура;
	КонецЕсли;

	ТаблицаСписания.Колонки.Добавить("Контрагент",								Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаСписания.Колонки.Добавить("Договор",									Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	
	ТаблицаСписания.Колонки.Добавить("СчетВПользовании",						Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаСписания.Колонки.Добавить("СчетВПользованииУчетПоКПС",				Новый ОписаниеТипов("Булево"));
	ТаблицаСписания.Колонки.Добавить("СчетВПользованииУчетПоПодразделениям",	Новый ОписаниеТипов("Булево"));
	ТаблицаСписания.Колонки.Добавить("ЕстьСубконтоДоговоры",					Новый ОписаниеТипов("Булево"));

	СоответствиеСчетов = Новый Соответствие;
	Дата        = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыЗаполнения, "Дата");
	Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыЗаполнения, "Организация");
	
	Для каждого СтрокаТаблицыСписания Из ТаблицаСписания Цикл
	
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыСписания, ПараметрыЗаполнения);
		
		СчетВПользовании = СоответствиеСчетов.Получить(СтрокаТаблицыСписания.СчетУчета);
		
		Если СчетВПользовании = Неопределено Тогда
			
			Если БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицыСписания.СчетУчета, "105.20") Тогда   
				СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчет.СчетПоКоду(КодГруппы + ".24", Дата, Организация));
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицыСписания.СчетУчета, "105.30") Тогда
				СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчет.СчетПоКоду(КодГруппы + ".34", Дата, Организация));
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицыСписания.СчетУчета, "108.00") Тогда
				СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчет.СчетПоКоду(КодГруппы + ".56", Дата, Организация));
			Иначе
				СвойстваСчета = Неопределено;
			КонецЕсли;
			
			Если СвойстваСчета = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СчетВПользовании = Новый Структура;
			СчетВПользовании.Вставить("СчетВПользовании",						СвойстваСчета.Ссылка);
			СчетВПользовании.Вставить("СчетВПользованииУчетПоКПС",				СвойстваСчета.УчетПоКПС);
			СчетВПользовании.Вставить("СчетВПользованииУчетПоПодразделениям",	СвойстваСчета.УчетПоПодразделениям);
			
			ЕстьСубконтоДоговоры = СвойстваСчета.ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.Договоры
								ИЛИ СвойстваСчета.ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.Договоры
								ИЛИ СвойстваСчета.ВидСубконто1 = ПланыВидовХарактеристик.ВидыСубконто.Договоры;
								
			СчетВПользовании.Вставить("ЕстьСубконтоДоговоры", ЕстьСубконтоДоговоры);
			
			СоответствиеСчетов.Вставить(СтрокаТаблицыСписания.СчетУчета, СчетВПользовании);
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыСписания, СчетВПользовании);
	
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область РозничнаяТорговля

// Расчет торговой наценки при перемещении в НТТ.

// Структура таблицы источника данных "Розничная наценка при перемещении в НТТ".
//
Функция ПустаяТаблицаРозничнаяНаценкаПриПеремещенииВНТТ() Экспорт

	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Вид учета: БУ - бух.учет, НУ - налоговый учет по налогу на прибыль.
	ПустаяТаблица.Колонки.Добавить("ВидУчета",      ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(3));
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет учета и номенклатура материальных запасов, перемещаемых в НТТ.
	ПустаяТаблица.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	// Счет и аналитика учета розничной наценки.
	ПустаяТаблица.Колонки.Добавить("СчетРозницы",   Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СчетНаценки",   Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("ЦМО",           Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	
	// Стоимость списанных материальных запасов.
	ПустаяТаблица.Колонки.Добавить("Стоимость",                ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СтоимостьНеУчитываетсяНУ", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СтоимостьЕНВД",            ОписаниеТипаСуммы);
	// Стоимость материальных запасов в рознице.
	ПустаяТаблица.Колонки.Добавить("СуммаПередачи", ОписаниеТипаСуммы);
	// Розничная наценка.
	ПустаяТаблица.Колонки.Добавить("РозничнаяНаценка",                ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("РозничнаяНаценкаНеУчитываетсяНУ", ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Розничная наценка при перемещении в НТТ".
//
Функция ТаблицаРозничнаяНаценкаПриПеремещенииВНТТ(ТаблицаСписаниеМатериальныхЗапасов, Реквизиты, Отказ) Экспорт
	
	ТаблицаНаценки = ПустаяТаблицаРозничнаяНаценкаПриПеремещенииВНТТ();
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
		"НомерСтроки,ИФО,КФО,КПС,ПодразделениеПолучатель,ЦМОПолучатель,КорСчет,
		|СчетУчета,Номенклатура,СуммаПередачи",
		Реквизиты.Ссылка);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Материалы"" КАК ИмяСписка,
	|	""Материалы"" КАК СинонимСписка,
	|	Материалы.НомерСтроки КАК НомерСтроки,
	|	Материалы.ИФО КАК ИФО,
	|	Материалы.КФО КАК КФО,
	|	Материалы.КПС КАК КПС,
	|	Материалы.ПодразделениеПолучатель КАК Подразделение,
	|	Материалы.ЦМОПолучатель КАК ЦМО,
	|	Материалы.КорСчет КАК КорСчет,
	|	Материалы.СчетУчета КАК СчетУчета,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.СуммаПередачи КАК СуммаПередачи
	|ИЗ
	|	ТаблицаМатериалы КАК Материалы
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ТаблицаДокумента = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		// Бухгалтерский учет.
		НоваяСтрока = ТаблицаНаценки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		НоваяСтрока.ВидУчета = "БУ";
		
		Если БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.КорСчет, "105.28") Тогда
			НоваяСтрока.СчетРозницы = БухгалтерскийУчет.СчетПоКоду("105.Б8");
			НоваяСтрока.СчетНаценки = БухгалтерскийУчет.СчетПоКоду("105.29");
		Иначе
			НоваяСтрока.СчетРозницы = БухгалтерскийУчет.СчетПоКоду("105.Г8");
			НоваяСтрока.СчетНаценки = БухгалтерскийУчет.СчетПоКоду("105.39");
		КонецЕсли;
		
		СписанныеПартии = ТаблицаСписаниеМатериальныхЗапасов.НайтиСтроки(
			Новый Структура("ИмяСписка,НомерСтроки,ВидУчета",
				СтрокаДокумента.ИмяСписка, СтрокаДокумента.НомерСтроки, НоваяСтрока.ВидУчета));
		Для Каждого СписаннаяПартия Из СписанныеПартии Цикл
			НоваяСтрока.Стоимость = НоваяСтрока.Стоимость + СписаннаяПартия.Стоимость;
		КонецЦикла;
		
		НоваяСтрока.РозничнаяНаценка = НоваяСтрока.СуммаПередачи - НоваяСтрока.Стоимость;
		
		// Налоговый учет.
		ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
			Реквизиты.Организация, Реквизиты.Дата, СтрокаДокумента.КФО);
		Если ОтражатьВНалоговомУчете Тогда
			
			НоваяСтрока = ТаблицаНаценки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
			НоваяСтрока.ВидУчета = "НУ";
			
			НоваяСтрока.СчетРозницы = БухгалтерскийУчет.СчетПоКоду("Н41.02");
			НоваяСтрока.СчетНаценки = БухгалтерскийУчет.СчетПоКоду("Н42");
			
			СписанныеПартии = ТаблицаСписаниеМатериальныхЗапасов.НайтиСтроки(
				Новый Структура("ИмяСписка,НомерСтроки,ВидУчета",
					СтрокаДокумента.ИмяСписка, СтрокаДокумента.НомерСтроки, НоваяСтрока.ВидУчета));
			Для Каждого СписаннаяПартия Из СписанныеПартии Цикл
				НоваяСтрока.Стоимость                = НоваяСтрока.Стоимость
													+ СписаннаяПартия.Стоимость;
				НоваяСтрока.СтоимостьНеУчитываетсяНУ = НоваяСтрока.СтоимостьНеУчитываетсяНУ
													+ СписаннаяПартия.СтоимостьНеУчитываетсяНУ;
				НоваяСтрока.СтоимостьЕНВД            = НоваяСтрока.СтоимостьЕНВД
													+ СписаннаяПартия.СтоимостьЕНВД;
			КонецЦикла;
			
			НоваяСтрока.РозничнаяНаценка = НоваяСтрока.СуммаПередачи
										- НоваяСтрока.Стоимость
										- НоваяСтрока.СтоимостьЕНВД;
			НоваяСтрока.РозничнаяНаценкаНеУчитываетсяНУ = - НоваяСтрока.Стоимость;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаНаценки;
	
КонецФункции

// Расчет торговой наценки по проданным товарам, при перемещении между НТТ и списании из НТТ.

// Функция рассчитывает торговую наценку по проданным товарам,
// а также при перемещении между НТТ и списании из НТТ.
//
Функция РассчитатьТорговуюНаценку(ДокументОбъект, Знач КЭКРозницы, Отказ) Экспорт
	
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ТаблицаТорговойНаценкиБУ = Новый ТаблицаЗначений;
	КолонкиБУ = ТаблицаТорговойНаценкиБУ.Колонки;
	КолонкиБУ.Добавить("ИФО",                                   Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	КолонкиБУ.Добавить("КФО",                                   Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	КолонкиБУ.Добавить("СчетДоходов",                           Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	КолонкиБУ.Добавить("КПСДоходов",                            Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	КолонкиБУ.Добавить("КЭКДоходов",                            Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	КолонкиБУ.Добавить("ПодразделениеДоходов",                  Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	КолонкиБУ.Добавить("СубконтоДоходов1",                      ОписаниеТиповСубконто);
	КолонкиБУ.Добавить("СубконтоДоходов2",                      ОписаниеТиповСубконто);
	КолонкиБУ.Добавить("СубконтоДоходов3",                      ОписаниеТиповСубконто);
