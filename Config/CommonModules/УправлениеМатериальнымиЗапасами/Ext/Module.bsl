			|ДопИзмерениеЕстьСубконто, ДопИзмерениеСуммовой, ДопИзмерениеКоличественный, ДопИзмерениеОбязательный,
			|ПартияЕстьСубконто, ПартияСуммовой, ПартияКоличественный, ПартияОбязательный");
//		Для Индекс = 1 По СвойстваСчета.КоличествоСубконто Цикл
//		
//			ВидСубконто         = СвойстваСчета["ВидСубконто" + Индекс];
//			ВидСубконтоСуммовой = СвойстваСчета["ВидСубконто" + Индекс + "Суммовой"];
//			
//			Если ВидСубконто = СтрокаДокумента.ДопАналитикаВидСубконто Тогда
//				СтрокаДокумента.ДопАналитикаЕстьСубконто = СвойстваСчета.ДопАналитикаЕстьСубконто;
//				СтрокаДокумента.ДопАналитикаСуммовой     = СвойстваСчета.ДопАналитикаСуммовой;
				
//			ИначеЕсли ВидСубконто = СтрокаДокумента.ДопИзмерениеВидСубконто Тогда
//				СтрокаДокумента.ДопИзмерениеЕстьСубконто = СвойстваСчета.ДопИзмерениеЕстьСубконто;
//				СтрокаДокумента.ДопИзмерениеСуммовой     = СвойстваСчета.ДопИзмерениеСуммовой;
				
//			ИначеЕсли ВидСубконто = СтрокаДокумента.ПартияВидСубконто Тогда
				// Если в доп.аналитике или доп.измерении не указана конкретная партия списания,
				// будет применяться партионный учет при списании по субконто "Партия".
//				СтрокаДокумента.ПартияЕстьСубконто = СвойстваСчета.ПартияЕстьСубконто;
//				СтрокаДокумента.ПартияСуммовой     = СвойстваСчета.ПартияСуммовой;
