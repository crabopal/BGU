	КолонкиБУ.Добавить("ЦМО",                                   Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	КолонкиБУ.Добавить("ПродажнаяСтоимостьРеализация",          Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КолонкиБУ.Добавить("ПродажнаяСтоимостьОстаток",             Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КолонкиБУ.Добавить("ТорговаяНаценкаОстаток",                Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КолонкиБУ.Добавить("СуммаНаценки",                          Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
	ТаблицаТорговойНаценкиНУ = Новый ТаблицаЗначений;
	КолонкиНУ = ТаблицаТорговойНаценкиНУ.Колонки;
	КолонкиНУ.Добавить("ИФО",                                   Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	КолонкиНУ.Добавить("КФО",                                   Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	КолонкиНУ.Добавить("СчетДоходов",                           Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	КолонкиНУ.Добавить("СубконтоДоходов1",                      ОписаниеТиповСубконто);
	КолонкиНУ.Добавить("СубконтоДоходов2",                      ОписаниеТиповСубконто);
	КолонкиНУ.Добавить("СубконтоДоходов3",                      ОписаниеТиповСубконто);
	КолонкиНУ.Добавить("СчетРозницы",                           Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	КолонкиНУ.Добавить("СчетНаценки",                           Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	КолонкиНУ.Добавить("ЦМО",                                   Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	КолонкиНУ.Добавить("ПродажнаяСтоимостьРеализация",          Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КолонкиНУ.Добавить("ПродажнаяСтоимостьЕНВДРеализация",      Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КолонкиНУ.Добавить("ПродажнаяСтоимостьОстаток",             Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КолонкиНУ.Добавить("ПродажнаяСтоимостьЕНВДОстаток",         Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КолонкиНУ.Добавить("ТорговаяНаценкаОстаток",                Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КолонкиНУ.Добавить("ТорговаяНаценкаЕНВДОстаток",            Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КолонкиНУ.Добавить("ТорговаяНаценкаНеУчитываетсяНУОстаток", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КолонкиНУ.Добавить("СуммаНаценки",                          Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	КолонкиНУ.Добавить("СуммаНаценкиНеУчитываетсяНУ",           Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
	ЭтоРегламентнаяОперация = ( ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасчетНаценки")
							ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументСсылка.РасчетНаценки") );
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",	ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Счет105Б8",		БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.Б8"));
	Запрос.УстановитьПараметр("Счет105Г8",		БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.Г8"));
	Запрос.УстановитьПараметр("Счет10529",		БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.29"));
	Запрос.УстановитьПараметр("Счет10539",		БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.39"));
	Запрос.УстановитьПараметр("СчетаДохода",	БухгалтерскийУчет.СписокСчетов("401.10"));
	
	Счета105ОЦДИ = БухгалтерскийУчет.СписокСчетов("105.20");
	Запрос.УстановитьПараметр("Счета105ОЦДИ",	Счета105ОЦДИ);
	
	Если ЭтоРегламентнаяОперация Тогда
		
		Запрос.УстановитьПараметр("НачалоПериода",	НачалоМесяца(ДокументОбъект.Дата));
		Запрос.УстановитьПараметр("КонецПериода",	КонецМесяца(ДокументОбъект.Дата));
		Запрос.УстановитьПараметр("КонГраница",		Новый Граница(КонецМесяца(ДокументОбъект.Дата), ВидГраницы.Включая));
		
		Запрос.УстановитьПараметр("СчетаРозницы",	БухгалтерскийУчет.СписокСчетов("105.Б8,105.Г8"));
		Запрос.УстановитьПараметр("СчетаНаценки",	БухгалтерскийУчет.СписокСчетов("105.29,105.39"));
		
	Иначе
		
		Запрос.УстановитьПараметр("НачалоПериода",	НачалоМесяца(ДокументОбъект.Дата));
		Запрос.УстановитьПараметр("КонецПериода", 	Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("КонГраница",		Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
		
		Если Счета105ОЦДИ.Найти(ДокументОбъект.КорСчет) <> Неопределено Тогда
			Запрос.УстановитьПараметр("СчетаРозницы",	БухгалтерскийУчет.СписокСчетов("105.Б8"));
			Запрос.УстановитьПараметр("СчетаНаценки",	БухгалтерскийУчет.СписокСчетов("105.29"));
		Иначе
			Запрос.УстановитьПараметр("СчетаРозницы",	БухгалтерскийУчет.СписокСчетов("105.Г8"));
			Запрос.УстановитьПараметр("СчетаНаценки",	БухгалтерскийУчет.СписокСчетов("105.39"));
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ИФО",           ДокументОбъект.ИФО);
		Запрос.УстановитьПараметр("МассивКФО",     ДокументОбъект.Материалы.ВыгрузитьКолонку("КФО"));
		Запрос.УстановитьПараметр("МассивКПС",     ДокументОбъект.Материалы.ВыгрузитьКолонку("КПС"));
		Запрос.УстановитьПараметр("ЦМО",           ДокументОбъект.ЦМООтправитель);
		Запрос.УстановитьПараметр("Подразделение", ДокументОбъект.ПодразделениеОтправитель);
		
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	
	// Бухгалтерский учет
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУОборотыДтКт.ИФО КАК ИФО,
	|	ЕПСБУОборотыДтКт.КФО КАК КФО,
	|	ЕПСБУОборотыДтКт.СчетДт,
	|	ЕПСБУОборотыДтКт.КПСДт,
	|	ЕПСБУОборотыДтКт.КЭКДт,
	|	ЕПСБУОборотыДтКт.СубконтоДт1,
	|	ЕПСБУОборотыДтКт.СубконтоДт2,
	|	ЕПСБУОборотыДтКт.СубконтоДт3,
	|	ЕПСБУОборотыДтКт.СчетКт КАК СчетКт,
	|	ЕПСБУОборотыДтКт.КПСКт КАК КПСКт,
	|	ЕПСБУОборотыДтКт.КЭККт,
	|	ВЫРАЗИТЬ(ЕПСБУОборотыДтКт.СубконтоКт1 КАК Справочник.ЦМО) КАК СубконтоКт1,
	|	ВЫБОР
	|		КОГДА ЕПСБУОборотыДтКт.СчетКт В (&Счета105ОЦДИ)
	|			ТОГДА &Счет10529
	|		ИНАЧЕ &Счет10539
	|	КОНЕЦ КАК СчетНаценки,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ЕПСБУОборотыДтКт.СчетКт.УчетПоПодразделениям
	|			ТОГДА ЕПСБУОборотыДтКт.ПодразделениеКт
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК ПодразделениеКт,
	|	ЕПСБУОборотыДтКт.ПодразделениеДт,
	|	ЕПСБУОборотыДтКт.СуммаОборот КАК СуммаОборот
	|ПОМЕСТИТЬ ОборотыПС
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			СчетДт В (&СчетаДохода),
	|			,
	|			СчетКт В (&СчетаРозницы),
	|			,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КФО В (&МассивКФО)
	|				И КПСКт В (&МассивКПС)
	|				И СубконтоКт1 = &ЦМО) КАК ЕПСБУОборотыДтКт
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИФО,
	|	КФО,
	|	КПСКт,
	|	СчетКт,
	|	СубконтоКт1,
	|	ПодразделениеКт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.ИФО КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ЦМО) КАК Субконто1,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ЕПСБУОстатки.Счет.УчетПоПодразделениям
	|			ТОГДА ЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт
	|ПОМЕСТИТЬ КонечныеОстаткиПС
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонГраница,
	|			Счет В (&СчетаРозницы),
	|			,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И КФО В (&МассивКФО)
	|				И КПС В (&МассивКПС)
	|				И Субконто1 = &ЦМО) КАК ЕПСБУОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИФО,
	|	КФО,
	|	Счет,
	|	КПС,
	|	Подразделение,
	|	Субконто1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонечныеОстаткиТН.ИФО КАК ИФО,
	|	КонечныеОстаткиТН.КФО КАК КФО,
	|	КонечныеОстаткиТН.Счет КАК Счет,
	|	КонечныеОстаткиТН.КПС КАК КПС,
	|	КонечныеОстаткиТН.Субконто1 КАК Субконто1,
	|	КонечныеОстаткиТН.СчетПС КАК СчетПС,
	|	КонечныеОстаткиТН.Подразделение КАК Подразделение,
	|	КонечныеОстаткиТН.СчетУчетПоПодразделениям КАК СчетУчетПоПодразделениям,
	|	СУММА(КонечныеОстаткиТН.СуммаОстатокКт) КАК СуммаОстатокКт
	|ПОМЕСТИТЬ КонечныеОстаткиТН
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУОстатки.ИФО КАК ИФО,
	|		ЕПСБУОстатки.КФО КАК КФО,
	|		ЕПСБУОстатки.Счет КАК Счет,
	|		ЕПСБУОстатки.КПС КАК КПС,
	|		ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ЦМО) КАК Субконто1,
	|		ВЫБОР
	|			КОГДА ЕПСБУОстатки.Счет В (&Счета105ОЦДИ)
	|				ТОГДА &Счет105Б8
	|			ИНАЧЕ &Счет105Г8
	|		КОНЕЦ КАК СчетПС,
	|		ВЫБОР
	|			КОГДА &УчетПоПодразделениям
	|					И ЕПСБУОстатки.Счет.УчетПоПодразделениям
	|				ТОГДА ЕПСБУОстатки.Подразделение
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ КАК Подразделение,
	|		ЕСТЬNULL(ЕПСБУОстатки.Счет.УчетПоПодразделениям, ЛОЖЬ) КАК СчетУчетПоПодразделениям,
	|		ЕПСБУОстатки.СуммаОстатокКт КАК СуммаОстатокКт
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|				&КонГраница,
	|				Счет В (&СчетаНаценки),
	|				,
	|				Организация = &Организация
	|					И ИФО = &ИФО
	|					И КФО В (&МассивКФО)
	|					И КПС В (&МассивКПС)
	|					И Субконто1 = &ЦМО) КАК ЕПСБУОстатки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ОборотыПС.ИФО,
	|		ОборотыПС.КФО,
	|		ВЫБОР
	|			КОГДА ОборотыПС.СчетКт = &Счет105Б8
	|				ТОГДА &Счет10529
	|			ИНАЧЕ &Счет10539
	|		КОНЕЦ,
	|		ОборотыПС.КПСКт,
	|		ОборотыПС.СубконтоКт1,
	|		ОборотыПС.СчетКт,
	|		ОборотыПС.ПодразделениеКт,
	|		ЕСТЬNULL(ОборотыПС.СчетКт.УчетПоПодразделениям, ЛОЖЬ),
	|		0
	|	ИЗ
	|		ОборотыПС КАК ОборотыПС
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		КонечныеОстаткиПС.ИФО,
	|		КонечныеОстаткиПС.КФО,
	|		ВЫБОР
	|			КОГДА КонечныеОстаткиПС.Счет = &Счет105Б8
	|				ТОГДА &Счет10529
	|			ИНАЧЕ &Счет10539
	|		КОНЕЦ,
	|		КонечныеОстаткиПС.КПС,
	|		КонечныеОстаткиПС.Субконто1,
	|		КонечныеОстаткиПС.Счет,
	|		КонечныеОстаткиПС.Подразделение,
	|		ЕСТЬNULL(КонечныеОстаткиПС.Счет.УчетПоПодразделениям, ЛОЖЬ),
	|		0
	|	ИЗ
	|		КонечныеОстаткиПС КАК КонечныеОстаткиПС) КАК КонечныеОстаткиТН
	|
	|СГРУППИРОВАТЬ ПО
	|	КонечныеОстаткиТН.СчетПС,
	|	КонечныеОстаткиТН.Субконто1,
	|	КонечныеОстаткиТН.Счет,
	|	КонечныеОстаткиТН.Подразделение,
	|	КонечныеОстаткиТН.КПС,
	|	КонечныеОстаткиТН.ИФО,
	|	КонечныеОстаткиТН.КФО,
	|	КонечныеОстаткиТН.СчетУчетПоПодразделениям
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КонечныеОстаткиТН.ИФО,
	|	КонечныеОстаткиТН.КФО,
	|	КонечныеОстаткиТН.Счет,
	|	КонечныеОстаткиТН.КПС,
	|	КонечныеОстаткиТН.Подразделение,
	|	КонечныеОстаткиТН.Субконто1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонечныеОстаткиТН.ИФО КАК ИФО,
	|	КонечныеОстаткиТН.КФО КАК КФО,
	|	ОборотыПС.СчетДт КАК СчетДоходов,
	|	ОборотыПС.КПСДт КАК КПСДоходов,
	|	ОборотыПС.КЭКДт КАК КЭКДоходов,
	|	ОборотыПС.ПодразделениеДт КАК ПодразделениеДоходов,
	|	ОборотыПС.СубконтоДт1 КАК СубконтоДоходов1,
	|	ОборотыПС.СубконтоДт2 КАК СубконтоДоходов2,
	|	ОборотыПС.СубконтоДт3 КАК СубконтоДоходов3,
	|	КонечныеОстаткиТН.Счет КАК СчетНаценки,
	|	КонечныеОстаткиТН.СчетПС КАК СчетРозницы,
	|	КонечныеОстаткиТН.КПС КАК КПСРозницы,
	|	ОборотыПС.КЭККт КАК КЭКРозницы,
	|	КонечныеОстаткиТН.Субконто1 КАК ЦМО,
	|	КонечныеОстаткиТН.Подразделение КАК ПодразделениеРозницы,
	|	КонечныеОстаткиТН.СуммаОстатокКт КАК ТорговаяНаценкаОстаток,
	|	ЕСТЬNULL(ОборотыПС.СуммаОборот, 0) КАК ПродажнаяСтоимостьРеализация,
	|	ЕСТЬNULL(КонечныеОстаткиПС.СуммаОстатокДт, 0) КАК ПродажнаяСтоимостьОстаток
	|ИЗ
	|	КонечныеОстаткиТН КАК КонечныеОстаткиТН
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОборотыПС КАК ОборотыПС
	|		ПО КонечныеОстаткиТН.ИФО = ОборотыПС.ИФО
	|			И КонечныеОстаткиТН.КФО = ОборотыПС.КФО
	|			И КонечныеОстаткиТН.КПС = ОборотыПС.КПСКт
	|			И КонечныеОстаткиТН.СчетПС = ОборотыПС.СчетКт
	|			И КонечныеОстаткиТН.Субконто1 = ОборотыПС.СубконтоКт1
	|			И КонечныеОстаткиТН.Подразделение = ОборотыПС.ПодразделениеКт
	|		ЛЕВОЕ СОЕДИНЕНИЕ КонечныеОстаткиПС КАК КонечныеОстаткиПС
	|		ПО КонечныеОстаткиТН.ИФО = КонечныеОстаткиПС.ИФО
	|			И КонечныеОстаткиТН.КФО = КонечныеОстаткиПС.КФО
	|			И КонечныеОстаткиТН.КПС = КонечныеОстаткиПС.КПС
	|			И КонечныеОстаткиТН.СчетПС = КонечныеОстаткиПС.Счет
	|			И КонечныеОстаткиТН.Субконто1 = КонечныеОстаткиПС.Субконто1
	|			И КонечныеОстаткиТН.Подразделение = КонечныеОстаткиПС.Подразделение
	|ГДЕ
	|	&ОсновноеУсловиеПодразделение
	|ИТОГИ
	|	СУММА(ПродажнаяСтоимостьРеализация),
	|	МАКСИМУМ(ПродажнаяСтоимостьОстаток),
	|	МАКСИМУМ(ТорговаяНаценкаОстаток)
	|ПО
	|	ИФО,
	|	КФО,
	|	СчетНаценки,
	|	КПСРозницы,
	|	ПодразделениеРозницы,
	|	ЦМО";
	
	НомераТаблиц.Вставить("ОборотыПС",         НомераТаблиц.Количество());
	НомераТаблиц.Вставить("КонечныеОстаткиПС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("КонечныеОстаткиТН", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("РасчетНаценкиБУ",   НомераТаблиц.Количество());
	
	// Налоговый учет
	ОтражатьВНалоговомУчете = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(ДокументОбъект.Организация, ДокументОбъект.Дата);
	Если ОтражатьВНалоговомУчете Тогда
		
		Запрос.УстановитьПараметр("СчетТоварыВРозницеНУ",  БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н41.02"));
		Запрос.УстановитьПараметр("СчетНаценкаНаТоварыНУ", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н42"));
		Запрос.УстановитьПараметр("СчетаСебестоимостиНУ",  БухгалтерскийУчет.СписокСчетов("Н90.03,Н90.04"));
		
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ЕПСБУОборотыДтКт.ИФО КАК ИФО,
		|	ЕПСБУОборотыДтКт.КФО КАК КФО,
		|	ЕПСБУОборотыДтКт.СчетДт КАК СчетСебестоимости,
		|	ЕПСБУОборотыДтКт.СубконтоДт1,
		|	ЕПСБУОборотыДтКт.СубконтоДт2,
		|	ЕПСБУОборотыДтКт.СубконтоДт3,
		|	ВЫРАЗИТЬ(ЕПСБУОборотыДтКт.СубконтоКт1 КАК Справочник.ЦМО) КАК СубконтоКт1,
		|	ЕПСБУОборотыДтКт.СуммаОборот КАК СуммаОборот,
		|	ЕПСБУОборотыДтКт.СуммаЕНВДОборот КАК СуммаЕНВДОборот
		|ПОМЕСТИТЬ ОборотыПС_НУ
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			,
		|			СчетДт В (&СчетаСебестоимостиНУ),
		|			,
		|			СчетКт = &СчетТоварыВРозницеНУ,
		|			,
		|			Организация = &Организация
		|				И ИФО = &ИФО
		|				И КФО В (&МассивКФО)
		|				И СубконтоКт1 = &ЦМО) КАК ЕПСБУОборотыДтКт
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ИФО,
		|	КФО,
		|	СубконтоКт1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУОстатки.ИФО КАК ИФО,
		|	ЕПСБУОстатки.КФО КАК КФО,
		|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ЦМО) КАК Субконто1,
		|	ЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
		|	ЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СуммаЕНВДОстатокДт
		|ПОМЕСТИТЬ КонечныеОстаткиПС_НУ
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&КонГраница,
		|			Счет = &СчетТоварыВРозницеНУ,
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО),
		|			Организация = &Организация
		|				И ИФО = &ИФО
		|				И КФО В (&МассивКФО)
		|				И Субконто1 = &ЦМО) КАК ЕПСБУОстатки
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ИФО,
		|	КФО,
		|	Субконто1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КонечныеОстаткиТН_НУ.ИФО КАК ИФО,
		|	КонечныеОстаткиТН_НУ.КФО КАК КФО,
		|	КонечныеОстаткиТН_НУ.Субконто1 КАК Субконто1,
		|	СУММА(КонечныеОстаткиТН_НУ.СуммаОстатокКт) КАК СуммаОстатокКт,
		|	СУММА(КонечныеОстаткиТН_НУ.СуммаЕНВДОстатокКт) КАК СуммаЕНВДОстатокКт,
		|	СУММА(КонечныеОстаткиТН_НУ.СуммаНеУчитываетсяНУОстатокКт) КАК СуммаНеУчитываетсяНУОстатокКт
		|ПОМЕСТИТЬ КонечныеОстаткиТН_НУ
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЕПСБУОстатки.ИФО КАК ИФО,
		|		ЕПСБУОстатки.КФО КАК КФО,
		|		ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ЦМО) КАК Субконто1,
		|		ЕПСБУОстатки.СуммаОстатокКт КАК СуммаОстатокКт,
		|		ЕПСБУОстатки.СуммаЕНВДОстатокКт КАК СуммаЕНВДОстатокКт,
		|		ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокКт КАК СуммаНеУчитываетсяНУОстатокКт
		|	ИЗ
		|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|				&КонГраница,
		|				Счет = &СчетНаценкаНаТоварыНУ,
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО),
		|				Организация = &Организация
		|					И ИФО = &ИФО
		|					И КФО В (&МассивКФО)
		|					И Субконто1 = &ЦМО) КАК ЕПСБУОстатки
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ОборотыПС_НУ.ИФО,
		|		ОборотыПС_НУ.КФО,
		|		ОборотыПС_НУ.СубконтоКт1,
		|		0,
		|		0,
		|		0
		|	ИЗ
		|		ОборотыПС_НУ КАК ОборотыПС_НУ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		КонечныеОстаткиПС_НУ.ИФО,
		|		КонечныеОстаткиПС_НУ.КФО,
		|		КонечныеОстаткиПС_НУ.Субконто1,
		|		0,
		|		0,
		|		0
		|	ИЗ
		|		КонечныеОстаткиПС_НУ КАК КонечныеОстаткиПС_НУ) КАК КонечныеОстаткиТН_НУ
		|
		|СГРУППИРОВАТЬ ПО
		|	КонечныеОстаткиТН_НУ.Субконто1,
		|	КонечныеОстаткиТН_НУ.КФО,
		|	КонечныеОстаткиТН_НУ.ИФО
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КонечныеОстаткиТН_НУ.ИФО,
		|	КонечныеОстаткиТН_НУ.КФО,
		|	КонечныеОстаткиТН_НУ.Субконто1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КонечныеОстаткиТН_НУ.ИФО КАК ИФО,
		|	КонечныеОстаткиТН_НУ.КФО КАК КФО,
		|	ОборотыПС_НУ.СчетСебестоимости КАК СчетДоходов,
		|	ОборотыПС_НУ.СубконтоДт1 КАК СубконтоДоходов1,
		|	ОборотыПС_НУ.СубконтоДт2 КАК СубконтоДоходов2,
		|	ОборотыПС_НУ.СубконтоДт3 КАК СубконтоДоходов3,
		|	&СчетНаценкаНаТоварыНУ КАК СчетНаценки,
		|	&СчетТоварыВРозницеНУ КАК СчетРозницы,
		|	КонечныеОстаткиТН_НУ.Субконто1 КАК ЦМО,
		|	КонечныеОстаткиТН_НУ.СуммаОстатокКт КАК ТорговаяНаценкаОстаток,
		|	КонечныеОстаткиТН_НУ.СуммаЕНВДОстатокКт КАК ТорговаяНаценкаЕНВДОстаток,
		|	КонечныеОстаткиТН_НУ.СуммаНеУчитываетсяНУОстатокКт КАК ТорговаяНаценкаНеУчитываетсяНУОстаток,
		|	ЕСТЬNULL(ОборотыПС_НУ.СуммаОборот, 0) КАК ПродажнаяСтоимостьРеализация,
		|	ЕСТЬNULL(ОборотыПС_НУ.СуммаЕНВДОборот, 0) КАК ПродажнаяСтоимостьЕНВДРеализация,
		|	ЕСТЬNULL(КонечныеОстаткиПС_НУ.СуммаОстатокДт, 0) КАК ПродажнаяСтоимостьОстаток,
		|	ЕСТЬNULL(КонечныеОстаткиПС_НУ.СуммаЕНВДОстатокДт, 0) КАК ПродажнаяСтоимостьЕНВДОстаток
		|ИЗ
		|	КонечныеОстаткиТН_НУ КАК КонечныеОстаткиТН_НУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОборотыПС_НУ КАК ОборотыПС_НУ
		|		ПО КонечныеОстаткиТН_НУ.ИФО = ОборотыПС_НУ.ИФО
		|			И КонечныеОстаткиТН_НУ.КФО = ОборотыПС_НУ.КФО
		|			И КонечныеОстаткиТН_НУ.Субконто1 = ОборотыПС_НУ.СубконтоКт1
		|		ЛЕВОЕ СОЕДИНЕНИЕ КонечныеОстаткиПС_НУ КАК КонечныеОстаткиПС_НУ
		|		ПО КонечныеОстаткиТН_НУ.ИФО = КонечныеОстаткиПС_НУ.ИФО
		|			И КонечныеОстаткиТН_НУ.КФО = КонечныеОстаткиПС_НУ.КФО
		|			И КонечныеОстаткиТН_НУ.Субконто1 = КонечныеОстаткиПС_НУ.Субконто1
		|ИТОГИ
		|	МАКСИМУМ(ТорговаяНаценкаОстаток),
		|	МАКСИМУМ(ТорговаяНаценкаЕНВДОстаток),
		|	МАКСИМУМ(ТорговаяНаценкаНеУчитываетсяНУОстаток),
		|	СУММА(ПродажнаяСтоимостьРеализация),
		|	СУММА(ПродажнаяСтоимостьЕНВДРеализация),
		|	МАКСИМУМ(ПродажнаяСтоимостьОстаток),
		|	МАКСИМУМ(ПродажнаяСтоимостьЕНВДОстаток)
		|ПО
		|	ИФО,
		|	КФО,
		|	ЦМО";
		
		НомераТаблиц.Вставить("ОборотыПС_НУ",         НомераТаблиц.Количество());
		НомераТаблиц.Вставить("КонечныеОстаткиПС_НУ", НомераТаблиц.Количество());
		НомераТаблиц.Вставить("КонечныеОстаткиТН_НУ", НомераТаблиц.Количество());
		НомераТаблиц.Вставить("РасчетНаценкиНУ",      НомераТаблиц.Количество());
		
	КонецЕсли;
	
	// Отборы по ИФО и Подразделению
	ИспользоватьУчетПоИФО            = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Запрос.УстановитьПараметр("УчетПоИФО",            ИспользоватьУчетПоИФО);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ИспользоватьУчетПоПодразделениям);
	
	Если НЕ ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОборотыДтКт.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.ИФО",     "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	
	Если ЭтоРегламентнаяОперация ИЛИ НЕ ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
	КонецЕсли;
	
	Если ЭтоРегламентнаяОперация ИЛИ НЕ ИспользоватьУчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОсновноеУсловиеПодразделение", "ИСТИНА");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОсновноеУсловиеПодразделение",
			"(КонечныеОстаткиТН.СчетУчетПоПодразделениям = ИСТИНА И КонечныеОстаткиТН.Подразделение = &Подразделение)
			|	ИЛИ КонечныеОстаткиТН.СчетУчетПоПодразделениям = ЛОЖЬ");
	КонецЕсли;
	
	// Отборы по КФО, КПС, ЦМО
	Если ЭтоРегламентнаяОперация Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И КФО В (&МассивКФО)",   "");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И КПС В (&МассивКПС)",   "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И КПСКт В (&МассивКПС)", "");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Субконто1 = &ЦМО",     "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СубконтоКт1 = &ЦМО",   "");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КЭКРозницы) Тогда
		Если БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(ДокументОбъект.Дата,
			ДокументОбъект.Организация) Тогда
			
			КЭКРозницы = БухгалтерскийУчетПовтИсп.КЭКПоКоду("346");
		Иначе
			КЭКРозницы = БухгалтерскийУчетПовтИсп.КЭКПоКоду("340");
		КонецЕсли;
	КонецЕсли;
	Результат = Запрос.ВыполнитьПакет();
	
	// Бухгалтерский учет
	ДеревоЗапроса = Результат[НомераТаблиц.РасчетНаценкиБУ].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	Для каждого СтрокаИФО из ДеревоЗапроса.Строки Цикл
		Для каждого СтрокаКФО из СтрокаИФО.Строки Цикл
			Для каждого СтрокаСчет из СтрокаКФО.Строки Цикл
				Для каждого СтрокаКПС из СтрокаСчет.Строки Цикл
					Для каждого СтрокаПодразделение из СтрокаКПС.Строки Цикл
						Для каждого СтрокаЦМО из СтрокаПодразделение.Строки Цикл
							
							ПродажнаяСтоимостьОстатокВсего    = СтрокаЦМО.ПродажнаяСтоимостьОстаток;
							ПродажнаяСтоимостьРеализацияВсего = СтрокаЦМО.ПродажнаяСтоимостьРеализация;
							ТорговаяНаценкаОстатокВсего       = СтрокаЦМО.ТорговаяНаценкаОстаток;
							
							Если ПродажнаяСтоимостьОстатокВсего + ПродажнаяСтоимостьРеализацияВсего = 0 Тогда
								ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru='Некорректные остатки или обороты по розничным продажам в НТТ ""%1""'")
										+ ?(ЗначениеЗаполнено(СтрокаЦМО.ИФО), НСтр("ru=', ИФО ""%2""'"), "")
										+ ?(ЗначениеЗаполнено(СтрокаЦМО.ПодразделениеРозницы), НСтр("ru=', подразделение ""%3""'"), "")
										+ НСтр("ru = '
										|
										|Проверьте остатки и обороты по счетам 105.Б8, 105.Г8 за %4.'"),
									СтрокаЦМО.ЦМО,
									СтрокаЦМО.ИФО,
									СтрокаЦМО.ПодразделениеРозницы,
									Формат(ДокументОбъект.Дата, "ДФ=""ММММ гггг 'г'"""));
								ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект, , , Отказ);
							КонецЕсли;
							
							Если ТорговаяНаценкаОстатокВсего < 0 Тогда
								ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru='Некорректные (отрицательные) остатки по торговой наценке в НТТ ""%1""'")
										+ ?(ЗначениеЗаполнено(СтрокаЦМО.ИФО), НСтр("ru=', ИФО ""%2""'"), "")
										+ ?(ЗначениеЗаполнено(СтрокаЦМО.ПодразделениеРозницы), НСтр("ru=', подразделение ""%3""'"), "")
										+ НСтр("ru = '
										|
										|Проверьте остатки по счетам 105.29, 105.39 на %4.'"),
									СтрокаЦМО.ЦМО,
									СтрокаЦМО.ИФО,
									СтрокаЦМО.ПодразделениеРозницы,
									Формат(ДокументОбъект.Дата, "ДФ=""дд ММММ гггг 'г'"""));
								ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект, , , Отказ);
							КонецЕсли;
							
							Если Отказ Тогда
								Продолжить;
							КонецЕсли;
							
							СписаноНаценки = 0;
							МаксИндекс = СтрокаЦМО.Строки.Количество() - 1;
							
							Для каждого СтрокаПроводок из СтрокаЦМО.Строки Цикл
								
								ПродажнаяСтоимостьРеализация = СтрокаПроводок.ПродажнаяСтоимостьРеализация;
								
								Если ПродажнаяСтоимостьОстатокВсего = 0
								   И СтрокаЦМО.Строки.Индекс(СтрокаПроводок) = МаксИндекс Тогда
									// Если с текущего счета списана вся продажная стоимость, последней строкой спишем весь остаток наценки.
									СуммаНаценки = ТорговаяНаценкаОстатокВсего - СписаноНаценки;
								Иначе 
									СуммаНаценки = Окр(ТорговаяНаценкаОстатокВсего * ПродажнаяСтоимостьРеализация 
													/ (ПродажнаяСтоимостьОстатокВсего + ПродажнаяСтоимостьРеализацияВсего), 2);
								КонецЕсли;
								
								НоваяСтрока = ТаблицаТорговойНаценкиБУ.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПроводок);
								НоваяСтрока.СуммаНаценки = СуммаНаценки;
								НоваяСтрока.КЭКРозницы   = КЭКРозницы;
								
								СписаноНаценки = СписаноНаценки + СуммаНаценки;
								
							КонецЦикла;
							
						КонецЦикла;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	// Налоговый учет
	Если ОтражатьВНалоговомУчете Тогда
		
		УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(ДокументОбъект.Организация, ДокументОбъект.Дата);
		
		ДеревоЗапроса = Результат[НомераТаблиц.РасчетНаценкиНУ].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		Для каждого СтрокаИФО из ДеревоЗапроса.Строки Цикл
			Для каждого СтрокаКФО из СтрокаИФО.Строки Цикл
				Для каждого СтрокаЦМО из СтрокаКФО.Строки Цикл
				
					Если НЕ УчетнаяПолитика.РозничнаяТорговляОблагаетсяЕНВД Тогда
						ПродажнаяСтоимостьОстатокВсего             = СтрокаЦМО.ПродажнаяСтоимостьОстаток;
						ПродажнаяСтоимостьРеализацияВсего          = СтрокаЦМО.ПродажнаяСтоимостьРеализация;
						ТорговаяНаценкаОстатокВсего                = СтрокаЦМО.ТорговаяНаценкаОстаток;
						ТорговаяНаценкаНеУчитываетсяНУОстатокВсего = СтрокаЦМО.ТорговаяНаценкаНеУчитываетсяНУОстаток;
					Иначе
						ПродажнаяСтоимостьОстатокВсего             = СтрокаЦМО.ПродажнаяСтоимостьЕНВДОстаток;
						ПродажнаяСтоимостьРеализацияВсего          = СтрокаЦМО.ПродажнаяСтоимостьЕНВДРеализация;
						ТорговаяНаценкаОстатокВсего                = СтрокаЦМО.ТорговаяНаценкаЕНВДОстаток;
						ТорговаяНаценкаНеУчитываетсяНУОстатокВсего = СтрокаЦМО.ТорговаяНаценкаНеУчитываетсяНУОстаток;
					КонецЕсли;
					
					Если ПродажнаяСтоимостьОстатокВсего + ПродажнаяСтоимостьРеализацияВсего = 0 Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru='Некорректные остатки или обороты по розничным продажам (НУ) в НТТ ""%1""'")
								+ ?(ЗначениеЗаполнено(СтрокаЦМО.ИФО), НСтр("ru=', ИФО ""%2""'"), "")
								+ НСтр("ru = '
								|
								|Проверьте остатки и обороты по счету Н41.02 за %3.'"),
							СтрокаЦМО.ЦМО,
							СтрокаЦМО.ИФО,
							Формат(ДокументОбъект.Дата, "ДФ=""ММММ гггг 'г'"""));
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект);
						Продолжить;
					КонецЕсли;
					
					Если ТорговаяНаценкаОстатокВсего < 0 Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru='Некорректные (отрицательные) остатки по торговой наценке (НУ) в НТТ ""%1""'")
								+ ?(ЗначениеЗаполнено(СтрокаЦМО.ИФО), НСтр("ru=', ИФО ""%2""'"), "")
								+ НСтр("ru = '
								|
								|Проверьте остатки по счету Н42 на %3.'"),
							СтрокаЦМО.ЦМО,
							СтрокаЦМО.ИФО,
							Формат(ДокументОбъект.Дата, "ДФ=""дд ММММ гггг 'г'"""));
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект);
						Продолжить;
					КонецЕсли;
					
					СписаноНаценки = 0;
					СписаноНаценкиНеУчитываетсяНУ = 0;
					МаксИндекс = СтрокаЦМО.Строки.Количество() - 1;
					
					Для каждого СтрокаПроводок из СтрокаЦМО.Строки Цикл
						
						Если НЕ УчетнаяПолитика.РозничнаяТорговляОблагаетсяЕНВД Тогда
							ПродажнаяСтоимостьРеализация = СтрокаПроводок.ПродажнаяСтоимостьРеализация;
						Иначе
							ПродажнаяСтоимостьРеализация = СтрокаПроводок.ПродажнаяСтоимостьЕНВДРеализация;
						КонецЕсли;
						
						Если ПродажнаяСтоимостьОстатокВсего = 0
						   И СтрокаЦМО.Строки.Индекс(СтрокаПроводок) = МаксИндекс Тогда
							// Если с текущего счета списана вся продажная стоимость, последней строкой спишем весь остаток наценки.
							СуммаНаценкиНУ              = ТорговаяНаценкаОстатокВсего - СписаноНаценки;
							СуммаНаценкиНеУчитываетсяНУ = ТорговаяНаценкаНеУчитываетсяНУОстатокВсего - СписаноНаценкиНеУчитываетсяНУ;
						Иначе 
							СуммаНаценкиНУ              = Окр(ТорговаяНаценкаОстатокВсего * ПродажнаяСтоимостьРеализация 
											/ (ПродажнаяСтоимостьОстатокВсего + ПродажнаяСтоимостьРеализацияВсего), 2);
							СуммаНаценкиНеУчитываетсяНУ = Окр(ТорговаяНаценкаНеУчитываетсяНУОстатокВсего * ПродажнаяСтоимостьРеализация 
											/ (ПродажнаяСтоимостьОстатокВсего + ПродажнаяСтоимостьРеализацияВсего), 2);
						КонецЕсли;
						
						НоваяСтрока = ТаблицаТорговойНаценкиНУ.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПроводок);
						НоваяСтрока.СуммаНаценки                = СуммаНаценкиНУ;
						НоваяСтрока.СуммаНаценкиНеУчитываетсяНУ = СуммаНаценкиНеУчитываетсяНУ;
						
						СписаноНаценки                = СписаноНаценки + СуммаНаценкиНУ;
						СписаноНаценкиНеУчитываетсяНУ = СписаноНаценкиНеУчитываетсяНУ + СуммаНаценкиНеУчитываетсяНУ;
						
					КонецЦикла;
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Новый Структура("ТаблицаТорговойНаценкиБУ, ТаблицаТорговойНаценкиНУ",
							ТаблицаТорговойНаценкиБУ, ТаблицаТорговойНаценкиНУ);
	
КонецФункции

#КонецОбласти

#Область УчетБланковСтрогойОтчетности

Функция ПредставлениеДиапазонаНомеров(Знач НачальныйНомер, Знач КонечныйНомер, Знач ДлинаНомера) Экспорт
	Если ТипЗнч(НачальныйНомер)<>Тип("Строка") Тогда
		Если ЗначениеЗаполнено(НачальныйНомер) Тогда
			НачальныйНомер = Строка(НачальныйНомер);
		Иначе
			НачальныйНомер = "";
		КонецЕсли;
	КонецЕсли;
	НачальныйНомер = СтрЗаменить(НачальныйНомер, Символы.НПП, "");
	Если ТипЗнч(КонечныйНомер)<>Тип("Строка") Тогда
		Если ЗначениеЗаполнено(КонечныйНомер) Тогда
			КонечныйНомер = Строка(КонечныйНомер);
		Иначе
			КонечныйНомер = "";
		КонецЕсли;
	КонецЕсли;
	КонечныйНомер = СтрЗаменить(КонечныйНомер, Символы.НПП, "");
	Если НЕ ЗначениеЗаполнено(ДлинаНомера) Тогда
		ДлинаНомера = ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО();
	КонецЕсли;
	
	Если ПустаяСтрока(НачальныйНомер) И ПустаяСтрока(КонечныйНомер) Тогда
		Возврат "";
	ИначеЕсли ПустаяСтрока(НачальныйНомер) Тогда
		Возврат СтроковыеФункцииКлиентСервер.ДополнитьСтроку(КонечныйНомер, ДлинаНомера);
	ИначеЕсли ПустаяСтрока(КонечныйНомер) ИЛИ НачальныйНомер = КонечныйНомер Тогда
		Возврат СтроковыеФункцииКлиентСервер.ДополнитьСтроку(НачальныйНомер, ДлинаНомера);
	Иначе
		Возврат СтроковыеФункцииКлиентСервер.ДополнитьСтроку(НачальныйНомер, ДлинаНомера) + "-" + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(КонечныйНомер, ДлинаНомера);	
	КонецЕсли;
КонецФункции

Процедура ПроверитьПравильностьЗаполненияТаблицыБСО(СоставБСО, Отказ) Экспорт
	
	ТаблицаБСО = Новый ТаблицаЗначений;
	ТаблицаБСО.Колонки.Добавить("БСО", Новый ОписаниеТипов("СправочникСсылка.БСО"));
	ТаблицаБСО.Колонки.Добавить("СерияБСО", Новый ОписаниеТипов("СправочникСсылка.СерииБСО"));
	ТаблицаБСО.Колонки.Добавить("НомерНачальный", Новый ОписаниеТипов("Число"));
	ТаблицаБСО.Колонки.Добавить("НомерКонечный", Новый ОписаниеТипов("Число"));
	ТаблицаБСО.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Для каждого ТекСтр Из СоставБСО Цикл
	
		НовСтр = ТаблицаБСО.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, ТекСтр, "БСО, СерияБСО, НомерСтроки");
		НовСтр.НомерНачальный = ?(ЗначениеЗаполнено(ТекСтр.НомерНачальный), Число(ТекСтр.НомерНачальный), 0);
		Если ЗначениеЗаполнено(ТекСтр.НомерКонечный) Тогда
			НовСтр.НомерКонечный = Число(ТекСтр.НомерКонечный);
		Иначе
			Если ТекСтр.Количество = 1 Тогда
				НовСтр.НомерКонечный = НовСтр.НомерНачальный;
			Иначе
				НовСтр.НомерКонечный = 0;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоставБСО.БСО,
	               |	СоставБСО.СерияБСО,
	               |	СоставБСО.НомерСтроки,
	               |	СоставБСО.НомерНачальный,
	               |	СоставБСО.НомерКонечный
	               |ПОМЕСТИТЬ СоставБСО
	               |ИЗ
	               |	&СоставБСО КАК СоставБСО
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СоставБСО.НомерСтроки,
	               |	1 КАК Приоритет
	               |ПОМЕСТИТЬ Ошибки
	               |ИЗ
	               |	СоставБСО КАК СоставБСО
	               |ГДЕ
	               |	СоставБСО.НомерНачальный = 0
	               |	И СоставБСО.НомерКонечный = 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СоставБСО.НомерСтроки,
	               |	2
	               |ИЗ
	               |	СоставБСО КАК СоставБСО
	               |ГДЕ
	               |	СоставБСО.НомерНачальный = 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СоставБСО.НомерСтроки,
	               |	3
	               |ИЗ
	               |	СоставБСО КАК СоставБСО
	               |ГДЕ
	               |	СоставБСО.НомерКонечный = 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СоставБСО.НомерСтроки,
	               |	4
	               |ИЗ
	               |	СоставБСО КАК СоставБСО
	               |ГДЕ
	               |	СоставБСО.НомерКонечный < СоставБСО.НомерНачальный
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СоставБСО.НомерСтроки,
	               |	5
	               |ИЗ
	               |	СоставБСО КАК СоставБСО
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоставБСО КАК СоставБСО1
	               |		ПО СоставБСО.БСО = СоставБСО1.БСО
	               |			И СоставБСО.СерияБСО = СоставБСО1.СерияБСО
	               |			И СоставБСО.НомерНачальный >= СоставБСО1.НомерНачальный
	               |			И СоставБСО.НомерНачальный <= СоставБСО1.НомерКонечный
	               |			И СоставБСО.НомерСтроки > СоставБСО1.НомерСтроки
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СоставБСО.НомерСтроки,
	               |	6
	               |ИЗ
	               |	СоставБСО КАК СоставБСО
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоставБСО КАК СоставБСО1
	               |		ПО СоставБСО.БСО = СоставБСО1.БСО
	               |			И СоставБСО.СерияБСО = СоставБСО1.СерияБСО
	               |			И СоставБСО.НомерКонечный >= СоставБСО1.НомерНачальный
	               |			И СоставБСО.НомерКонечный <= СоставБСО1.НомерКонечный
	               |			И СоставБСО.НомерСтроки > СоставБСО1.НомерСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Ошибки.НомерСтроки КАК НомерСтроки,
	               |	МИНИМУМ(Ошибки.Приоритет) КАК Приоритет
	               |ИЗ
	               |	Ошибки КАК Ошибки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Ошибки.НомерСтроки
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	Запрос.УстановитьПараметр("СоставБСО", ТаблицаБСО);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Приоритет = 1 Тогда
			ТекстОшибки = НСтр("ru='В строке %1 не заполнены начальный и конечный номера'");
			ИмяПоля = "НомерНачальный";
		ИначеЕсли Выборка.Приоритет = 2 Тогда
			ТекстОшибки = НСтр("ru='В строке %1 не заполнен начальный номер'");
			ИмяПоля = "НомерНачальный";
		ИначеЕсли Выборка.Приоритет = 3 Тогда
			ТекстОшибки = НСтр("ru='В строке %1 не заполнен конечный номер'");
			ИмяПоля = "НомерКонечный";
		ИначеЕсли Выборка.Приоритет = 4 Тогда
			ТекстОшибки = НСтр("ru='В строке %1 конечный номер меньше начального'");
			ИмяПоля = "НомерКонечный";
		ИначеЕсли Выборка.Приоритет = 5 Тогда
			ТекстОшибки = НСтр("ru='В строке %1 начальный номер входит в интервал из предыдущих строк'");
			ИмяПоля = "НомерНачальный";
		Иначе
			ТекстОшибки = НСтр("ru='В строке %1 конечный номер входит в интервал из предыдущих строк'");
			ИмяПоля = "НомерКонечный";
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(	СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Выборка.НомерСтроки),
															,"Объект.СоставБСО["+(Выборка.НомерСтроки-1)+"]."+ИмяПоля,,Отказ);
		
	КонецЦикла;

КонецПроцедуры
 
// Формирует строку маски ввода для ввода номеров БСО
Функция ПолучитьМаскуВводаНомеровБСО(ТекДлина) Экспорт
	МаксДлинаНомера = Метаданные.РегистрыНакопления.ДвиженияБСО.Реквизиты.НомерНачальный.Тип.КвалификаторыЧисла.Разрядность;
	
	ТекущаяДлинаНомера = ?(ТекДлина = 0, МаксДлинаНомера, ТекДлина);
	
	Маска = "";
	Для к = 1 по ТекущаяДлинаНомера Цикл
		Маска = Маска + "9";
	КонецЦикла;	
	
	Возврат Маска;
КонецФункции	

// Получает ссылку на счет учета БСО "03" и признак группы. Полученную информацию
// возвращает в виде структуры с ключами "Счет", "ЭлементГруппа"
//
Функция ПолучитьСтруктуруСчетаУчетаБСО() Экспорт
	СтруктураСчета = Новый Структура("Счет, ЭлементГруппа", ПланыСчетов.ЕПСБУ.ПустаяСсылка(),Ложь);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Код", "03");
	Запрос.Текст = "ВЫБРАТЬ
				   |	ЕПСБУ.Ссылка,
				   |	ЕПСБУ.ЭлементГруппа
				   |ИЗ
				   |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
				   |ГДЕ
				   |	ЕПСБУ.Код = &Код";
				   
	Выборка = Запрос.Выполнить().Выбрать();			   
	
	Если Выборка.Следующий() Тогда
		СтруктураСчета.Вставить("Счет", Выборка.Ссылка);
		СтруктураСчета.Вставить("ЭлементГруппа", Выборка.ЭлементГруппа);
	КонецЕсли;	
	
	Возврат СтруктураСчета;
КонецФункции	

// Обрезает таблицы "ТаблицаПрихода" и "ТаблицаРасхода", содержащие данные о
// движениях диапазонов номеров БСО по датам, по дате "ДатаОстатков", т.е.
// все движения познее даты "ДатаОстатков" будут удалены
Процедура ОбрезатьТаблицыПоДате(ТаблицаПрихода, ТаблицаРасхода, ДатаОстатков)
	Запрос = Новый Запрос;
	МенВТ  = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенВТ;
	
	Запрос.УстановитьПараметр("ТаблицаПрихода", ТаблицаПрихода);
	Запрос.УстановитьПараметр("ТаблицаРасхода", ТаблицаРасхода);
	Запрос.УстановитьПараметр("Дата", ДатаОстатков);
	
	Запрос.Текст = "ВЫБРАТЬ
	         |	ТаблицаПрихода.*
	         |ПОМЕСТИТЬ ТаблицаПрихода
	         |ИЗ
	         |	&ТаблицаПрихода КАК ТаблицаПрихода
	         |
	         |ИНДЕКСИРОВАТЬ ПО
	         |	Дата
	         |;
	         |
	         |////////////////////////////////////////////////////////////////////////////////
	         |ВЫБРАТЬ
	         |	ТаблицаРасхода.*
	         |ПОМЕСТИТЬ ТаблицаРасхода
	         |ИЗ
	         |	&ТаблицаРасхода КАК ТаблицаРасхода
	         |
	         |ИНДЕКСИРОВАТЬ ПО
	         |	Дата
	         |;
	         |
	         |////////////////////////////////////////////////////////////////////////////////
	         |ВЫБРАТЬ
	         |	ТаблицаПрихода.*
	         |ИЗ
	         |	ТаблицаПрихода КАК ТаблицаПрихода
	         |ГДЕ
	         |	ТаблицаПрихода.Дата <= &Дата
	         |;
	         |
	         |////////////////////////////////////////////////////////////////////////////////
	         |ВЫБРАТЬ
	         |	ТаблицаРасхода.*
	         |ИЗ
	         |	ТаблицаРасхода КАК ТаблицаРасхода
	         |ГДЕ
	         |	ТаблицаРасхода.Дата <= &Дата";
			 
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаПрихода = МассивРезультатов[2].Выгрузить();
	ТаблицаРасхода = МассивРезультатов[3].Выгрузить();
КонецПроцедуры	

// Расчитывает и устанавливает количество в строке с учетом знака.
// Количество рассчитывается по диапазону номеров. Знак определяет расход или приход
// "-" - это расход, "+" - это приход.
Процедура УстановитьКоличество(ТекСтрока, ТекКоличество)
	Знак = ?(ТекКоличество < 0, -1, 1);
	ТекСтрока.Количество = Знак * (ТекСтрока.НомерКонечный - ТекСтрока.НомерНачальный + 1);
КонецПроцедуры	

// Вычитает массив данных таблицы "ТаблицаРасхода" (с номерами БСО) из массива данных таблицы "ТаблицаПрихода".
// По сути, формирует разницу двух массивов данных. Каждый массив - это диапозон номеров.
//
// ТаблицаПрихода - уменьшаемый массив
// ТаблицаРасхода - вычитаемый массив
// Если таблицы содержат информацию о датах движения диапазонов номеров и указан параметр "ДатаОстатков",
//				то вичитание будет произведено с начала таблицы по дату "ДатаОстатков".
//
// Возвращает разность таблиц в виде таблицы значений
Функция РассчитатьОстаткиНомеровСерии(Знач ТаблицаПрихода, Знач ТаблицаРасхода, ДатаОстатков = Неопределено) Экспорт
	УчитыватьСерию = НЕ (ТаблицаПрихода.Колонки.Найти("Серия") = Неопределено);
	Если ТаблицаПрихода.Колонки.Найти("Дата") <> Неопределено И ДатаОстатков <> Неопределено Тогда
		ОбрезатьТаблицыПоДате(ТаблицаПрихода, ТаблицаРасхода, ДатаОстатков);
	КонецЕсли;	
	
	Для каждого СтрокаРасхода из ТаблицаРасхода Цикл
		Если УчитыватьСерию Тогда
			СерияРасход = СтрокаРасхода.Серия;
		КонецЕсли;	
		
		Для каждого СтрокаПрихода из ТаблицаПрихода Цикл
			Если УчитыватьСерию Тогда
				СерияПриход = СтрокаПрихода.Серия;
				Если СерияРасход <> СерияПриход ТОгда
					Продолжить;
				КонецЕсли;	
			КонецЕсли;	
			
			НомНачР = СтрокаРасхода.НомерНачальный;
			НомКонР = СтрокаРасхода.НомерКонечный;
			НомНачП = СтрокаПрихода.НомерНачальный;
			НомКонП = СтрокаПрихода.НомерКонечный;
			
			// Если ТаблицаПрихода - таблица движений, то отрицательного остатка не может быть
			// Если ТаблицаПрихода - данные бухучета инвентаризации, то отрицательное значение
			// - это перерасход номеров и их надо приходовать в любом случае без дальнейшего анализа.
			Если СтрокаПрихода.Количество < 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			Если НомКонР < НомНачП ИЛИ НомНачР > НомКонП Тогда
				Продолжить;
			ИначеЕсли НомНачР < НомНачП И НомКонР < НомКонП Тогда
				СтрокаРасхода.НомерКонечный  = НомНачП - 1;
				УстановитьКоличество(СтрокаРасхода, СтрокаРасхода.Количество);
				
				СтрокаПрихода.НомерНачальный = НомКонР + 1;
				УстановитьКоличество(СтрокаПрихода, СтрокаПрихода.Количество);
			ИначеЕсли НомНачР < НомНачП И НомКонР = НомКонП Тогда
				СтрокаРасхода.НомерКонечный  = НомНачП - 1;
				УстановитьКоличество(СтрокаРасхода, СтрокаРасхода.Количество);
				
				СтрокаПрихода.НомерНачальный = 0;
				СтрокаПрихода.НомерКонечный  = 0;
				СтрокаПрихода.Количество     = 0;
			ИначеЕсли НомНачР = НомНачП И НомКонР < НомКонП Тогда
				СтрокаРасхода.НомерНачальный = 0;
				СтрокаРасхода.НомерКонечный  = 0;
				СтрокаРасхода.Количество     = 0;
				
				СтрокаПрихода.НомерНачальный = НомКонР + 1;
				УстановитьКоличество(СтрокаПрихода, СтрокаПрихода.Количество);
				
				Прервать;
			ИначеЕсли НомНачР = НомНачП И НомКонР = НомКонП Тогда
				СтрокаРасхода.НомерНачальный = 0;
				СтрокаРасхода.НомерКонечный  = 0;
				СтрокаРасхода.Количество     = 0;
				
				СтрокаПрихода.НомерНачальный = 0;
				СтрокаПрихода.НомерКонечный  = 0;
				СтрокаПрихода.Количество     = 0;
				
				Прервать;
			ИначеЕсли НомНачР > НомНачП И НомКонР < НомКонП Тогда
				СтрокаРасхода.НомерНачальный = 0;
				СтрокаРасхода.НомерКонечный  = 0;
				СтрокаРасхода.Количество     = 0;
				
				СтрокаПрихода.НомерКонечный	 = НомНачР - 1;
				УстановитьКоличество(СтрокаПрихода, СтрокаПрихода.Количество);
				
				НоваяСтрока = ТаблицаПрихода.Добавить();
				Если УчитыватьСерию Тогда
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПрихода, "Серия, СерияПредставление");
				КонецЕсли;	
				НоваяСтрока.НомерНачальный = НомКонР + 1;
				НоваяСтрока.НомерКонечный  = НомКонП;
				УстановитьКоличество(НоваяСтрока, СтрокаПрихода.Количество);
				
				Прервать;
			ИначеЕсли НомНачР > НомНачП И НомКонР = НомКонП Тогда
				СтрокаРасхода.НомерНачальный = 0;
				СтрокаРасхода.НомерКонечный  = 0;
				СтрокаРасхода.Количество     = 0;
				
				СтрокаПрихода.НомерКонечный	 = НомНачР - 1;
				УстановитьКоличество(СтрокаПрихода, СтрокаПрихода.Количество);
				
				Прервать;
			ИначеЕсли НомНачР > НомНачП И НомКонР > НомКонП Тогда
				СтрокаРасхода.НомерНачальный = НомКонП + 1;
				УстановитьКоличество(СтрокаРасхода, СтрокаРасхода.Количество);
				
				СтрокаПрихода.НомерКонечный	 = НомНачР - 1;
				УстановитьКоличество(СтрокаПрихода, СтрокаПрихода.Количество);
			ИначеЕсли НомНачР < НомНачП И НомКонР > НомКонП Тогда
				СтрокаРасхода.НомерКонечный  = НомНачП - 1;
				УстановитьКоличество(СтрокаРасхода, СтрокаРасхода.Количество);
				
				НоваяСтрока = ТаблицаРасхода.Добавить();
				Если УчитыватьСерию Тогда
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасхода, "Серия, СерияПредставление");
				КонецЕсли;	
				НоваяСтрока.НомерНачальный = НомКонП + 1;
				НоваяСтрока.НомерКонечный  = НомКонР;
				УстановитьКоличество(НоваяСтрока, СтрокаРасхода.Количество);
				
				СтрокаПрихода.НомерНачальный = 0;
				СтрокаПрихода.НомерКонечный  = 0;
				УстановитьКоличество(СтрокаПрихода, СтрокаПрихода.Количество);
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;	
	
	Для каждого СтрокаРасхода из ТаблицаРасхода Цикл
		Если СтрокаРасхода.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;	
		НоваяСтрокаПрихода = ТаблицаПрихода.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПрихода, СтрокаРасхода);
	КонецЦикла;	
	
	Возврат ТаблицаПрихода;
КонецФункции	

// Формирует таблицу остатков номеров для текущей серии
// Возвращвет таблицу остатков серии БСО по номерам
Функция ВырнутьТаблицуОстатковНомеровСерии(СтрокаСерии)
	ТаблицаПрихода = Новый ТаблицаЗначений;
	ТаблицаРасхода = Новый ТаблицаЗначений;
	
	ТипЧисло  = Новый ОписаниеТипов("Число");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ТаблицаПрихода.Колонки.Добавить("НомерНачальный", ТипЧисло);
	ТаблицаПрихода.Колонки.Добавить("НомерКонечный", ТипЧисло);
	ТаблицаПрихода.Колонки.Добавить("Количество", ТипЧисло);
	
	ТаблицаРасхода.Колонки.Добавить("НомерНачальный", ТипЧисло);
	ТаблицаРасхода.Колонки.Добавить("НомерКонечный", ТипЧисло);
	ТаблицаРасхода.Колонки.Добавить("Количество", ТипЧисло);
	ТаблицаРасхода.Колонки.Добавить("Отработан", ТипБулево);
	
	СтруктураОтбораПрихода = Новый Структура("ВидДвижения", ВидДвиженияНакопления.Приход);
	СтруктураОтбораРасхода = Новый Структура("ВидДвижения", ВидДвиженияНакопления.Расход);
	
	МассивПриходов = СтрокаСерии.Строки.НайтиСтроки(СтруктураОтбораПрихода);
	МассивРасходов = СтрокаСерии.Строки.НайтиСтроки(СтруктураОтбораРасхода);
	
	Для каждого ЭлементПрихода из МассивПриходов Цикл
		НоваяСтрока = ТаблицаПрихода.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементПрихода);
	КонецЦикла;	
	
	Для каждого ЭлементРасхода из МассивРасходов Цикл
		НоваяСтрока = ТаблицаРасхода.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементРасхода);
	КонецЦикла;	
	
	ТаблицаПрихода = РассчитатьОстаткиНомеровСерии(ТаблицаПрихода, ТаблицаРасхода);
	
	Возврат ТаблицаПрихода;
КонецФункции	

// Вспомогательная процедура для формирования условий для функции "СформироватьДеревоОстатковБСО"
Процедура СформироватьУсловияДляЗапросаПоОстаткамБСО(Запрос, СтруктураПараметров, УсловиеДвижений, УсловиеОстатков, МассивБСО = Неопределено, МассивСерий = Неопределено)
	Организация = Неопределено;
	СтруктураПараметров.Свойство("Организация", Организация);
	
	Подразделение = Неопределено;
	Если НЕ СтруктураПараметров.Свойство("Подразделение", Подразделение) Тогда
		Подразделение = Справочники.Подразделения.ПустаяСсылка();
	КонецЕсли;	
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	
	ИФО = Неопределено;
	Если НЕ СтруктураПараметров.Свойство("ИФО", ИФО) Тогда
		ИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	КонецЕсли;	
	Запрос.УстановитьПараметр("ИФО", ИФО);					
	
	КФО = Неопределено;
	СтруктураПараметров.Свойство("КФО", КФО);
	
	ЦМО = Неопределено;
	СтруктураПараметров.Свойство("ЦМО", ЦМО);
	
	СчетУчета = Неопределено;
	СтруктураПараметров.Свойство("СчетУчета", СчетУчета);
	
	Если СчетУчета <> Неопределено Тогда			   
		УсловиеОстатков = УсловиеОстатков + "
							|			И СчетУчета = &СчетУчета";
		УсловиеДвижений = УсловиеДвижений + "
							|	И ДвиженияБСО.СчетУчета = &СчетУчета";
		Запрос.УстановитьПараметр("СчетУчета", СчетУчета);					
	КонецЕсли;
		
	Если Организация <> Неопределено Тогда			   
		УсловиеОстатков = УсловиеОстатков + "
							|			И Организация = &Организация";
		УсловиеДвижений = УсловиеДвижений + "
							|	И ДвиженияБСО.Организация = &Организация";
		Запрос.УстановитьПараметр("Организация", Организация);					
	КонецЕсли;
	
	Если КФО <> Неопределено Тогда
		УсловиеОстатков = УсловиеОстатков + "
							|			И КФО = &КФО";
		УсловиеДвижений = УсловиеДвижений + "
							|	И ДвиженияБСО.КФО = &КФО";
		Запрос.УстановитьПараметр("КФО", КФО);					
	КонецЕсли;
	
	Если МассивБСО <> Неопределено Тогда
		УсловиеОстатков = УсловиеОстатков + "
							|			И БСО В (&МассивБСО)";
		УсловиеДвижений = УсловиеДвижений + "
							|	И БСО В (&МассивБСО)";
		Запрос.УстановитьПараметр("МассивБСО", МассивБСО);					
	КонецЕсли;	
	
	Если МассивСерий <> Неопределено Тогда
		УсловиеОстатков = УсловиеОстатков + "
							|			И СерияБСО В (&МассивСерий)";
		УсловиеДвижений = УсловиеДвижений + "
							|	И СерияБСО В (&МассивСерий)";
		Запрос.УстановитьПараметр("МассивСерий", МассивСерий);					
	КонецЕсли;	
	
	Если ЦМО <> Неопределено Тогда
		УсловиеОстатков = УсловиеОстатков + "
							|			И ЦМО = &ЦМО) КАК ДвиженияБСООстатки";
		УсловиеДвижений = УсловиеДвижений + "
							|	И ДвиженияБСО.ЦМО = &ЦМО";
		Запрос.УстановитьПараметр("ЦМО", ЦМО);					
	Иначе						
		УсловиеОстатков = УсловиеОстатков + "
							|			) КАК ДвиженияБСООстатки";
		УсловиеДвижений = УсловиеДвижений + "
							|	И ВЫРАЗИТЬ(ДвиженияБСО.Регистратор КАК Документ.ВнутреннееПеремещениеБСО) ЕСТЬ NULL";
	КонецЕсли;
КонецПроцедуры	

// Формирует дерево остатков БСО по регистру накопления "ДвиженияБСО".
// 1-й уровень дерева - уровень БСО
// 2-й уровень дерева - уровень серии БСО. На этом уровне в колонке "ОстаткиНомеров" будет таблица
//						значений, содержащая остатки по номерам для текущей серии
// 3-й уровень дерева - уровень движений БСО
Функция СформироватьДеревоОстатковБСО(ДатаЗапроса, СтруктураПараметров, МассивБСО = Неопределено, МассивСерий = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаЗапроса);					
	Запрос.УстановитьПараметр("Приход", ВидДвиженияНакопления.Приход);					
	
	УсловиеДвижений = "";
	УсловиеОстатков = "";
	СформироватьУсловияДляЗапросаПоОстаткамБСО(Запрос, СтруктураПараметров, УсловиеДвижений, УсловиеОстатков, МассивБСО, МассивСерий);
	
	СчетДляБСО = Неопределено;
	
	СтруктураПараметров.Свойство("СчетУчета", СчетДляБСО);
	Если НЕ ЗначениеЗаполнено(СчетДляБСО) Тогда 
		СчетДляБСО = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("03.1");
	КонецЕсли;
	
	УчитыватьПодразделение = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
										И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетДляБСО).УчетПоПодразделениям;
																					
	// По умолчанию баланс надо учитывать, т.к. до появления возможности формировать инвентаризацию БСО
	// без учета баланса, инвентаризация всегда формировалась с отбором по балансу.
	// Если баланс не пустой, то учитывать баланс надо, если - пустой, то надо смотреть состояние флажка "УчитыватьБаланс"
	УчитыватьИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	//Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ИФО) Тогда
	//	Если СтруктураПараметров.Свойство("УчитыватьБаланс") Тогда
	//		УчитыватьБаланс = СтруктураПараметров.УчитыватьБаланс;			   
	//	КонецЕсли;
	//КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДвиженияБСООстатки.БСО КАК БСО,
	               |	ДвиженияБСООстатки.БСО.ДлинаНомера КАК ДлинаНомера,
	               |	ДвиженияБСООстатки.СерияБСО КАК СерияБСО,
	               |	ДвиженияБСООстатки.КоличествоОстаток КАК КоличествоОстаток,
	               |	0 КАК Количество,
	               |	0 КАК НомерНачальный,
	               |	0 КАК НомерКонечный,
	               |	"""" КАК ВидДвижения
	               |ИЗ
	               |	РегистрНакопления.ДвиженияБСО.Остатки(
	               |			&Дата,";
				   
	ТекстЗапроса = ТекстЗапроса + ?(УчитыватьИФО, "
	               |			ИФО = &ИФО", "
				   |			ИСТИНА");
				   
	ТекстЗапроса = ТекстЗапроса + ?(УчитыватьПодразделение, "
	               |			И Подразделение = &Подразделение", "
				   |			И ИСТИНА");
				   
	ТекстЗапроса = ТекстЗапроса + УсловиеОстатков;
	
	ТекстЗапроса = ТекстЗапроса + "
							|
							|ОБЪЕДИНИТЬ ВСЕ
							|
							|ВЫБРАТЬ
							|	ДвиженияБСО.БСО,
							|	ДвиженияБСО.БСО.ДлинаНомера,
							|	ДвиженияБСО.СерияБСО,
							|	0,
							|	ВЫБОР
							|		КОГДА ДвиженияБСО.ВидДвижения = &Приход
							|			ТОГДА ДвиженияБСО.Количество
							|		ИНАЧЕ -ДвиженияБСО.Количество
							|	КОНЕЦ,
							|	ДвиженияБСО.НомерНачальный,
							|	ДвиженияБСО.НомерКонечный,
							|	ДвиженияБСО.ВидДвижения
							|ИЗ
							|	РегистрНакопления.ДвиженияБСО КАК ДвиженияБСО
							|ГДЕ";
							
	Если ТипЗнч(ДатаЗапроса) = Тип("Дата") Тогда
		ТекстЗапроса = ТекстЗапроса + "
							|	ДвиженияБСО.Период < &Дата";
	Иначе						
		ТекстЗапроса = ТекстЗапроса + "
							|	ДвиженияБСО.Регистратор.МоментВремени < &Дата";
	КонецЕсли;						
	
	
	ТекстЗапроса = ТекстЗапроса + ?(УчитыватьИФО, "
							|	И ДвиженияБСО.ИФО = &ИФО", "
							|	И ИСТИНА");
	ТекстЗапроса = ТекстЗапроса + ?(УчитыватьПодразделение, "
			                |	И ДвиженияБСО.Подразделение = &Подразделение", "
						    |	И ИСТИНА");
				   
	ТекстЗапроса = ТекстЗапроса + УсловиеДвижений;
						
	ТекстЗапроса = ТекстЗапроса + "
							|
							|УПОРЯДОЧИТЬ ПО
							|	БСО,
							|	СерияБСО,
							|	КоличествоОстаток УБЫВ
							|ИТОГИ
							|	СУММА(КоличествоОстаток),
							|	СУММА(Количество)
							|ПО
							|	БСО,
							|	СерияБСО";
							
							
	Запрос.Текст = ТекстЗапроса;						
	ДеревоОстатков = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДеревоОстатков.Колонки.Добавить("ОстаткиНомеров");
	
	Для каждого СтрокаВида из ДеревоОстатков.Строки Цикл
		Для каждого СтрокаСерии из СтрокаВида.Строки Цикл
			ТаблицаОстатковНомеров = ВырнутьТаблицуОстатковНомеровСерии(СтрокаСерии);
			СтрокаСерии.ОстаткиНомеров = ТаблицаОстатковНомеров;
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат ДеревоОстатков;
КонецФункции

// Формирует дерево БСО по документу "БСО_Инвентаризация"
// Дерево БСО - это разница между двумя массивами: Остатки по бухучету минус остатки по факт. учету
// Используется для заполнения документов списания и поступления БСО, на основании инвентаризации
Функция ПолучитьДанныеИнвентаризации(ДокИнветаризации) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокИнветаризации);
	Запрос.УстановитьПараметр("Приход", ВидДвиженияНакопления.Приход);					
	Запрос.УстановитьПараметр("Расход", ВидДвиженияНакопления.Расход);					
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	БСО_ИнвентаризацияБУ.БСО КАК БСО,
	               |	БСО_ИнвентаризацияБУ.СерияБСО КАК СерияБСО,
	               |	БСО_ИнвентаризацияБУ.НомерНачальный,
	               |	ВЫБОР
	               |		КОГДА БСО_ИнвентаризацияБУ.НомерКонечный = """"
	               |			ТОГДА БСО_ИнвентаризацияБУ.НомерНачальный
	               |		ИНАЧЕ БСО_ИнвентаризацияБУ.НомерКонечный
	               |	КОНЕЦ КАК НомерКонечный,
	               |	БСО_ИнвентаризацияБУ.Количество КАК Количество,
	               |	ВЫБОР
	               |		КОГДА БСО_ИнвентаризацияБУ.Количество < 0
	               |			ТОГДА &Расход
	               |		ИНАЧЕ &Приход
	               |	КОНЕЦ КАК ВидДвижения,
	               |	БСО_ИнвентаризацияБУ.БСО.ДлинаНомера КАК ДлинаНомера
	               |ИЗ
	               |	Документ.БСО_Инвентаризация.БУ КАК БСО_ИнвентаризацияБУ
	               |ГДЕ
	               |	БСО_ИнвентаризацияБУ.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	БСО_ИнвентаризацияФУ.БСО,
	               |	БСО_ИнвентаризацияФУ.СерияБСО,
	               |	БСО_ИнвентаризацияФУ.НомерНачальный,
	               |	ВЫБОР
	               |		КОГДА БСО_ИнвентаризацияФУ.НомерКонечный = """"
	               |			ТОГДА БСО_ИнвентаризацияФУ.НомерНачальный
	               |		ИНАЧЕ БСО_ИнвентаризацияФУ.НомерКонечный
	               |	КОНЕЦ,
	               |	-БСО_ИнвентаризацияФУ.Количество,
	               |	&Расход,
	               |	БСО_ИнвентаризацияФУ.БСО.ДлинаНомера
	               |ИЗ
	               |	Документ.БСО_Инвентаризация.ФУ КАК БСО_ИнвентаризацияФУ
	               |ГДЕ
	               |	БСО_ИнвентаризацияФУ.Ссылка = &Ссылка
	               |ИТОГИ
	               |	СУММА(Количество)
	               |ПО
	               |	БСО,
	               |	СерияБСО";
				   
	ДеревоБСО = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДеревоБСО.Колонки.Добавить("ОстаткиНомеров");
	
	Для каждого СтрокаВида из ДеревоБСО.Строки Цикл
		Для каждого СтрокаСерии из СтрокаВида.Строки Цикл
			ТаблицаОстатковНомеров     = ВырнутьТаблицуОстатковНомеровСерии(СтрокаСерии);
			СтрокаСерии.ОстаткиНомеров = ТаблицаОстатковНомеров;
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат ДеревоБСО;
КонецФункции	

Функция ПолучитьТаблицуОстатковБСО(ДокументСсылка, КПС) Экспорт
	Перем ЦМО, Подразделение;	
	
	ИмяРеквизитаЦМО = "";
	ИмяРеквизитаПодразделение = "";
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВнутреннееПеремещениеБСО") Тогда
    	ИмяРеквизитаЦМО 			= "ЦМООтправитель";
		ИмяРеквизитаПодразделение 	= "ПодразделениеОтправитель";
		ИмяДокумента				= "ВнутреннееПеремещениеБСО";
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаБСО") Тогда
    	ИмяРеквизитаЦМО 			= "ЦМО";
		ИмяРеквизитаПодразделение 	= "Подразделение";
		ИмяДокумента				= "ПередачаБСО";
	Иначе //Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеБСО") Тогда
    	ИмяРеквизитаЦМО 			= "ЦМО";
		ИмяРеквизитаПодразделение 	= "Подразделение";
		ИмяДокумента				= "СписаниеБСО";
	КонецЕсли;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	РеквизитыДокумента = "СчетУчета,Организация,КФО,ИФО,Дата,";
	//Если Не ПустаяСтрока(ИмяРеквизитаЦМО) Тогда
		РеквизитыДокумента = РеквизитыДокумента+ИмяРеквизитаЦМО+",";
	//КонецЕсли;
	//Если Не ПустаяСтрока(ИмяРеквизитаПодразделение) И ИспользоватьУчетПоПодразделениям Тогда
		РеквизитыДокумента = РеквизитыДокумента+ИмяРеквизитаПодразделение+",";
	//КонецЕсли;
	ЗначенияРеквизитовДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, Лев(РеквизитыДокумента, СтрДлина(РеквизитыДокумента)-1));
	
	СчетБСО = ЗначенияРеквизитовДокумента.СчетУчета;
	СвойстваСчетаБСО = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетБСО);
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И СвойстваСчетаБСО.УчетПоПодразделениям;
	
	ЗначенияРеквизитовДокумента.Свойство(ИмяРеквизитаЦМО, ЦМО);
	ЗначенияРеквизитовДокумента.Свойство(ИмяРеквизитаПодразделение, Подразделение);
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", 							ДокументСсылка);
	Запрос.УстановитьПараметр("Период", 							ЗначенияРеквизитовДокумента.Дата);
	Запрос.УстановитьПараметр("СчетБСО", 							СчетБСО);
	Запрос.УстановитьПараметр("Организация", 						ЗначенияРеквизитовДокумента.Организация);
	Запрос.УстановитьПараметр("КФО", 								ЗначенияРеквизитовДокумента.КФО);
	Запрос.УстановитьПараметр("ЦМО", 								ЦМО);
	Запрос.УстановитьПараметр("НеЗаданКПС", 						НЕ ЗначениеЗаполнено(КПС));
	Запрос.УстановитьПараметр("КПС", 								КПС);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", 				ИспользоватьУчетПоИФО);
	Запрос.УстановитьПараметр("ИФО", 								ЗначенияРеквизитовДокумента.ИФО);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	Запрос.УстановитьПараметр("Подразделение", 						Подразделение);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВсеБСОДокумента.БСО,
	               |	ВсеБСОДокумента.Количество,
	               |	ЕстьNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстаток, 0) Как КоличествоОстаток,
	               |	ВЫБОР
	               |		КОГДА ВсеБСОДокумента.Количество > ЕстьNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстаток, 0)
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Нехватка
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		БСОДокумента.БСО КАК БСО,
	               |		СУММА(БСОДокумента.Количество) КАК Количество
	               |	ИЗ
	               |		Документ.<ИмяДокумента>.СоставБСО КАК БСОДокумента
	               |	ГДЕ
	               |		БСОДокумента.Ссылка = &Ссылка
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		БСОДокумента.БСО) КАК ВсеБСОДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |				&Период,
	               |				Счет = &СчетБСО,
	               |				,
	               |				Организация = &Организация
	               |					И КФО = &КФО
	               |					И Субконто2 = &ЦМО
	               |					И (&НеЗаданКПС
	               |						ИЛИ &КПС = КПС)
	               |					И (НЕ &ИспользоватьУчетПоИФО
	               |						ИЛИ ИФО = &ИФО)
	               |					И (НЕ &ИспользоватьУчетПоПодразделениям
	               |						ИЛИ Подразделение = &Подразделение)
	               |					И Субконто1 В
	               |						(ВЫБРАТЬ
	               |							СоставБСО.БСО
	               |						ИЗ
	               |							Документ.<ИмяДокумента>.СоставБСО КАК СоставБСО
	               |						ГДЕ
	               |							СоставБСО.Ссылка = &Ссылка)) КАК ЖурналПроводокЕПСБУОстатки
	               |		ПО ВсеБСОДокумента.БСО = ЖурналПроводокЕПСБУОстатки.Субконто1";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "<ИмяДокумента>", ИмяДокумента);				   
				   
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Вычитает из таблицы БСО строки, которые были учтены ранее и находятся в таблице РанееУчтенныеБСО.
// Возвращает копию ТаблицыБСО, в которой изменены диапазоны.
// 
// Параметры:
//  ТаблицаБСО - ТаблицаЗначений:
//   * НомерСтроки - Число
//   * БСО - СправочникСсылка.БСО
//   * СерияБСО - СправочникСсылка.СерииБСО
//   * Количество - Число
//   * НомерНачальный - Строка
//   * НомерКонечный - Строка
//  РанееУчтенныеБСО - ТаблицаЗначений:
//   * НомерСтроки - Число
//   * БСО - СправочникСсылка.БСО
//   * СерияБСО - СправочникСсылка.СерииБСО
//   * Количество - Число
//   * НомерНачальный - Строка
//   * НомерКонечный - Строка
// 
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * НомерСтроки - Число
//   * БСО - СправочникСсылка.БСО
//   * СерияБСО - СправочникСсылка.СерииБСО
//   * Количество - Число
//   * НомерНачальный - Строка
//   * НомерКонечный - Строка
Функция ВычестьРанееУчтенныеБСОИзТаблицы(Знач ТаблицаБСО, Знач РанееУчтенныеБСО) Экспорт
	ТаблицаБСО = ТаблицаБСО.Скопировать();
	РанееУчтенныеБСО = РанееУчтенныеБСО.Скопировать();
	ТипЧисло = Новый ОписаниеТипов("Число");
	Индекс = 0;
	Пока Индекс < РанееУчтенныеБСО.Количество() Цикл
		УчтеннаяСтрока = РанееУчтенныеБСО[Индекс];
		УчтеннаяСтрокаНомерНачальный = ТипЧисло.ПривестиЗначение(УчтеннаяСтрока.НомерНачальный); 
		УчтеннаяСтрокаНомерКонечный = ТипЧисло.ПривестиЗначение(УчтеннаяСтрока.НомерКонечный); 
		
		Для Каждого СтрокаБСО Из ТаблицаБСО Цикл
			СтрокаБСОНомерНачальный = ТипЧисло.ПривестиЗначение(СтрокаБСО.НомерНачальный); 
			СтрокаБСОНомерКонечный = ТипЧисло.ПривестиЗначение(СтрокаБСО.НомерКонечный); 
			Если СтрокаБСО.БСО <> УчтеннаяСтрока.БСО
					Или СтрокаБСО.СерияБСО <> УчтеннаяСтрока.СерияБСО
					Или СтрокаБСОНомерНачальный > УчтеннаяСтрокаНомерКонечный
					Или СтрокаБСОНомерКонечный < УчтеннаяСтрокаНомерНачальный Тогда
				Продолжить;
			КонецЕсли;
			// Начальный номер учтенной строки меньше начального номера строки БСО,
			// а конечный номер больше начального номера строки БСО.
			// Требуется разделить учтенную строку: выделить дипазон до начального номера строки БСО
			Если УчтеннаяСтрокаНомерНачальный < СтрокаБСОНомерНачальный Тогда
				НоваяУчтеннаяСтрока = РанееУчтенныеБСО.Вставить(РанееУчтенныеБСО.Индекс(УчтеннаяСтрока) + 1);
				ЗаполнитьЗначенияСвойств(НоваяУчтеннаяСтрока, УчтеннаяСтрока);
				НоваяУчтеннаяСтрока.НомерНачальный = СтрокаБСОНомерНачальный;
				УчтеннаяСтрока.НомерКонечный = СтрокаБСОНомерНачальный - 1;
				УчтеннаяСтрокаНомерКонечный = ТипЧисло.ПривестиЗначение(УчтеннаяСтрока.НомерКонечный);
				УчтеннаяСтрока.Количество = УчтеннаяСтрокаНомерКонечный - УчтеннаяСтрокаНомерНачальный + 1;
				НоваяУчтеннаяСтрока.Количество = НоваяУчтеннаяСтрока.Количество - УчтеннаяСтрока.Количество;
				// Модифицированную строку учтенных БСО нужно попробовать проверить еще раз
				Индекс = Индекс - 1;
				Прервать;  
			КонецЕсли;
			// Конечный номер учтенной строки больше конечного номера строки БСО,
			// а начальный номер больше конечного номера строки БСО.
			// Требуется разделить учтенную строку: выделить дипазон после конечного номера строки БСО
			Если УчтеннаяСтрокаНомерКонечный > СтрокаБСОНомерКонечный Тогда
				НоваяУчтеннаяСтрока = РанееУчтенныеБСО.Вставить(РанееУчтенныеБСО.Индекс(УчтеннаяСтрока) + 1);
				ЗаполнитьЗначенияСвойств(НоваяУчтеннаяСтрока, УчтеннаяСтрока);
				НоваяУчтеннаяСтрока.НомерНачальный = СтрокаБСОНомерКонечный + 1;
				УчтеннаяСтрока.НомерКонечный = СтрокаБСОНомерКонечный;
				УчтеннаяСтрокаНомерКонечный = ТипЧисло.ПривестиЗначение(УчтеннаяСтрока.НомерКонечный);
				УчтеннаяСтрока.Количество = УчтеннаяСтрокаНомерКонечный - УчтеннаяСтрокаНомерНачальный + 1;
				НоваяУчтеннаяСтрока.Количество = НоваяУчтеннаяСтрока.Количество - УчтеннаяСтрока.Количество;
			КонецЕсли;
			// Учтенная строка начинается в середине диапазона строки БСО.
			// Требуется разделить строку БСО: выдалить диапазон до начального номера учтенной строки.
			Если СтрокаБСОНомерНачальный < УчтеннаяСтрокаНомерНачальный Тогда
				НоваяСтрокаБСО = ТаблицаБСО.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаБСО, СтрокаБСО);
				НоваяСтрокаБСО.НомерКонечный = УчтеннаяСтрокаНомерНачальный - 1;
				НоваяСтрокаБСОНомерКонечный = ТипЧисло.ПривестиЗначение(НоваяСтрокаБСО.НомерКонечный);
				НоваяСтрокаБСОНомерНачальный = ТипЧисло.ПривестиЗначение(НоваяСтрокаБСО.НомерНачальный);
				НоваяСтрокаБСО.Количество = НоваяСтрокаБСОНомерКонечный - НоваяСтрокаБСОНомерНачальный + 1;
				СтрокаБСО.НомерНачальный = УчтеннаяСтрока.НомерНачальный;
				СтрокаБСО.Количество = СтрокаБСО.Количество - НоваяСтрокаБСО.Количество;
				СтрокаБСОНомерНачальный = ТипЧисло.ПривестиЗначение(СтрокаБСО.НомерНачальный);
			КонецЕсли;
			// Учтенная строка заканчивается в середине диапазона строки БСО.
			// Требуется разделить строку БСО: выдалить диапазон после конечного номера учтенной строки.
			Если СтрокаБСОНомерКонечный > УчтеннаяСтрокаНомерКонечный Тогда
				НоваяСтрокаБСО = ТаблицаБСО.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаБСО, СтрокаБСО);
				НоваяСтрокаБСО.НомерНачальный = УчтеннаяСтрокаНомерКонечный + 1;
				НоваяСтрокаБСОНомерКонечный = ТипЧисло.ПривестиЗначение(НоваяСтрокаБСО.НомерКонечный);
				НоваяСтрокаБСОНомерНачальный = ТипЧисло.ПривестиЗначение(НоваяСтрокаБСО.НомерНачальный);
				НоваяСтрокаБСО.Количество = НоваяСтрокаБСОНомерКонечный - НоваяСтрокаБСОНомерНачальный + 1;
				СтрокаБСО.НомерКонечный = УчтеннаяСтрока.НомерКонечный;
				СтрокаБСО.Количество = СтрокаБСО.Количество - НоваяСтрокаБСО.Количество;
				СтрокаБСОНомерКонечный = ТипЧисло.ПривестиЗначение(СтрокаБСО.НомерКонечный);
			КонецЕсли;
			// Учтенная строка в точности соответствует диапазону строки БСО.
			// Требуется удалить строку БСО.
			Если СтрокаБСОНомерНачальный = УчтеннаяСтрокаНомерНачальный
					И СтрокаБСОНомерКонечный = УчтеннаяСтрокаНомерКонечный Тогда
				ТаблицаБСО.Удалить(СтрокаБСО);
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		Индекс = Индекс + 1;
		
	КонецЦикла; 

	ТаблицаБСО.Сортировать("НомерСтроки");
	Возврат ТаблицаБСО;
КонецФункции

// В строках переданной коллекции дополняет номера БСО лидирующими нулями.
// 
// Параметры:
//  ТабличнаяЧасть - ТабличнаяЧасть:
//   * БСО - СправочникСсылка.БСО
//   * НомерНачальный - Строка
//   * НомерКонечный - Строка
Процедура УстановитьФорматированныйНомерБСО(ТабличнаяЧасть) Экспорт
	
	ИспользуемыеБСО = Новый Соответствие;
	Для Каждого СтрокаБСО Из ТабличнаяЧасть Цикл
		ИспользуемыеБСО.Вставить(СтрокаБСО.БСО);
	КонецЦикла;
	МассивБСО = Новый Массив; // Массив из СправочникСсылка.БСО
	Для Каждого КлючИЗначение Из ИспользуемыеБСО Цикл
		МассивБСО.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	НастройкаНумерации = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивБСО, "ДлинаНомера");
	Для Каждого СтрокаБСО Из ТабличнаяЧасть Цикл
		ДлинаНомера = НастройкаНумерации.Получить(СтрокаБСО.БСО);
		СтрокаБСО.НомерНачальный = УправлениеМатериальнымиЗапасамиКлиентСервер.НомерБСОСтрокой(
			СтрокаБСО.НомерНачальный, ДлинаНомера);
		СтрокаБСО.НомерКонечный = УправлениеМатериальнымиЗапасамиКлиентСервер.НомерБСОСтрокой(
			СтрокаБСО.НомерКонечный, ДлинаНомера);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область УчетПродуктовПитания

//******************************************************************************
// Процедуры и функции нахождения матрицы макимального потока.
//

// Производит заполнение шапок строк и колонок исходной матрицы
//
Процедура ЗаполнитьДанныеШапокСтрокИКолонок(РабочаяТаблица, МаксИндекс)
	// Очистим существующие данные
	Для к = 0 по МаксИндекс Цикл
		РабочаяТаблица[к]["ВершинаСтроки"]  = Неопределено;
		РабочаяТаблица[к]["ПотокСтроки"]    = Неопределено;
		РабочаяТаблица[к]["ВершинаКолонки"] = Неопределено;
		РабочаяТаблица[к]["ПотокКолонки"]   = Неопределено;
	КонецЦикла;	
	
	// Цикл по строкам
	Для к = 0 по МаксИндекс - 1 Цикл
		Если к <> 0 Тогда
			Если РабочаяТаблица[к]["ПотокСтроки"] = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	
		
		// Цикл по колонкам
		Для п = к + 1 по МаксИндекс Цикл
			Если к = 0 Тогда
				ТекПоток = РабочаяТаблица[к][п];
				Если ТекПоток = 0 Тогда
					Продолжить;
				КонецЕсли;	
				
				РабочаяТаблица[п]["ВершинаКолонки"] = к;
				РабочаяТаблица[п]["ПотокКолонки"]   = ТекПоток;
				РабочаяТаблица[п]["ВершинаСтроки"]  = к;
				РабочаяТаблица[п]["ПотокСтроки"]    = ТекПоток;
			Иначе
				Если РабочаяТаблица[п]["ПотокКолонки"] <> Неопределено Тогда
					Продолжить;
				КонецЕсли;	
				ТекПоток = РабочаяТаблица[к][п];
				Если ТекПоток = 0 Тогда
					Продолжить;
				КонецЕсли;	
				
				РабочаяТаблица[п]["ВершинаКолонки"] = к;
				РабочаяТаблица[п]["ПотокКолонки"]   = Мин(ТекПоток, РабочаяТаблица[к]["ПотокСтроки"]);
				РабочаяТаблица[п]["ВершинаСтроки"]  = к;
				РабочаяТаблица[п]["ПотокСтроки"]    = Мин(ТекПоток, РабочаяТаблица[к]["ПотокСтроки"]);
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;	
КонецПроцедуры	

// Выполняет процедуру уменьшения потоков в сети (исходной матрице) методом 
// обратного хода
//
Процедура ПровестиУменьшениеПотокаОбратнымХодом(РабочаяТаблица, Знач п, УменьшениеПотока)
	ПредыдущаяВершина = РабочаяТаблица[п]["ВершинаКолонки"];
	Если ПредыдущаяВершина = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если УменьшениеПотока = 0 Тогда
		УменьшениеПотока = РабочаяТаблица[п]["ПотокКолонки"];
	КонецЕсли;
	
	РабочаяТаблица[ПредыдущаяВершина][п] = РабочаяТаблица[ПредыдущаяВершина][п] - УменьшениеПотока;
	РабочаяТаблица[п][ПредыдущаяВершина] = РабочаяТаблица[п][ПредыдущаяВершина] + УменьшениеПотока;
	
	Если ПредыдущаяВершина = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ПровестиУменьшениеПотокаОбратнымХодом(РабочаяТаблица, ПредыдущаяВершина, УменьшениеПотока);
КонецПроцедуры	

// Функция проверяет возможность продолжения рекурсивного поиска максимального
// потока. По сути, является условием выхода процедуры "НайтиМаксимальныйПоток()"
// из рекурсии
Функция ЕстьВозможностьПродолжитьАлгоритм(РабочаяТаблица, МаксИндекс)
	ЕстьВозможность = Ложь;
	Для к = 0 по МаксИндекс Цикл
		Если РабочаяТаблица[к][МаксИндекс] <> 0 И РабочаяТаблица[МаксИндекс]["ПотокКолонки"] <> Неопределено Тогда
			ЕстьВозможность = Истина;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат ЕстьВозможность;
КонецФункции	

// Рекурсивная процедура, организующая процесс нахождения максимального
// потока в сети.
Процедура НайтиМаксимальныйПоток(РабочаяТаблица, МаксИндекс)
	ЗаполнитьДанныеШапокСтрокИКолонок(РабочаяТаблица, МаксИндекс);
	Если ЕстьВозможностьПродолжитьАлгоритм(РабочаяТаблица, МаксИндекс) Тогда
		ПровестиУменьшениеПотокаОбратнымХодом(РабочаяТаблица, МаксИндекс, 0);
		НайтиМаксимальныйПоток(РабочаяТаблица, МаксИндекс);
	КонецЕсли;	
КонецПроцедуры	

//******************************************************************************
// Процедуры и функции заполнение исходной матрицы пропускных способностей.
//

// Формирует из переданной строки ключ для заполнения специальной колонки ("Ключ")
// исходной матрицы пропускных способностей. Этот ключ в дальнейшем используется
// для бустрого поиска строк матрицы при ее заполнении данными.
Функция ВернутьКлюч(ТекСтрока, Режим)
	Ключ = "";
	Если Режим = "КД" Тогда
		Ключ = "КД@" + ТекСтрока.КатегорияДовольствующихсяПредставление;
	ИначеЕсли Режим = "ИС" Тогда
		Ключ = "ИС@" + ТекСтрока.КВДПредставление + "@" + ТекСтрока.БалансПредставление;
	ИначеЕсли Режим = "Счет" Тогда
		Ключ = "Счет@" + ТекСтрока.КВДПредставление + "@" + ТекСтрока.БалансПредставление + "@" + ТекСтрока.СчетПредставление + "@" + ТекСтрока.КБКПредставление;
	КонецЕсли;	
	
	Возврат Ключ;
КонецФункции	

// Объекты, соответствующие колонкам и строкам исходной матрицы
// пропускных способностей упаковывает в структуру
Функция УпаковатьОбъект(ТекСтрока, Режим)
	Структура = Новый Структура("ВидСтруктуры", Режим);
	Если Режим = "ИС" Тогда
		Структура.Вставить("КВД", ТекСтрока.КВД);
		Структура.Вставить("Баланс", ТекСтрока.Баланс);
	ИначеЕсли Режим = "Счет" Тогда
		Структура.Вставить("КВД", ТекСтрока.КВД);
		Структура.Вставить("Баланс", ТекСтрока.Баланс);
		Структура.Вставить("Счет", ТекСтрока.Счет);
		Структура.Вставить("КБК", ТекСтрока.КБК);
		Структура.Вставить("КОСГУКт", ТекСтрока.КОСГУКт);
	КонецЕсли;	
	
	Возврат(Структура);
КонецФункции	

// Заполняет исходную матрицу пропускных способностей данными
//
Процедура ЗаполнитьРабочуюТаблицуДанными(РабочаяТаблица, СтрокаНоменклатурыКД_ИС, СтрокаНоменклатурыИС_Остатки)
	МаксИндекс = РабочаяТаблица.Количество() - 1;
	
	Для каждого ТекСтрока из СтрокаНоменклатурыКД_ИС.Строки Цикл
		КлючКД = ВернутьКлюч(ТекСтрока, "КД");
		КлючИС = ВернутьКлюч(ТекСтрока, "ИС");
		
		НайденнаяСтрока = РабочаяТаблица.Найти(КлючКД, "Ключ");
		Если НайденнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		ИндексКД = РабочаяТаблица.Индекс(НайденнаяСтрока);
		
		НайденнаяСтрока = РабочаяТаблица.Найти(КлючИС, "Ключ");
		Если НайденнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		ИндексИС = РабочаяТаблица.Индекс(НайденнаяСтрока);
		
		РабочаяТаблица[0][ИндексКД]        = ТекСтрока.Количество;
		РабочаяТаблица[ИндексКД][ИндексИС] = ТекСтрока.Количество;
	КонецЦикла;	
	
	Для каждого ТекСтрока из СтрокаНоменклатурыИС_Остатки.Строки Цикл
		КлючИС     = ВернутьКлюч(ТекСтрока, "ИС");
		КлючСчет   = ВернутьКлюч(ТекСтрока, "Счет");
		
		НайденнаяСтрока = РабочаяТаблица.Найти(КлючИС, "Ключ");
		Если НайденнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		ИндексИС   = РабочаяТаблица.Индекс(НайденнаяСтрока);
		
		НайденнаяСтрока = РабочаяТаблица.Найти(КлючСчет, "Ключ");
		Если НайденнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		ИндексСчет = РабочаяТаблица.Индекс(НайденнаяСтрока);
		
		РабочаяТаблица[ИндексИС][ИндексСчет]   = ТекСтрока.Остаток;
		РабочаяТаблица[ИндексСчет][МаксИндекс] = ТекСтрока.Остаток;
	КонецЦикла;	
КонецПроцедуры	

// Создает колонки исходной матрицы пропускных способностей
//
Функция ИнициализироватьРабочуюТаблицу(КоличествоОбъектов)
	Таблица = Новый ТаблицаЗначений;
	
	Для к = 0 по (КоличествоОбъектов + 1) Цикл
		Таблица.Колонки.Добавить("к" + к, Новый ОписаниеТипов("Число"));
	КонецЦикла;	
	
	Таблица.Колонки.Добавить("ВершинаКолонки");
	Таблица.Колонки.Добавить("ПотокКолонки");
	Таблица.Колонки.Добавить("ВершинаСтроки");
	Таблица.Колонки.Добавить("ПотокСтроки");
	Таблица.Колонки.Добавить("ВидОбъекта", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(5)));
	Таблица.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(60)));
	Таблица.Колонки.Добавить("Объект");
	
	Возврат(Таблица);
КонецФункции	

// Организует процесс заполнения исходной матрицы пропускных способностей
// 
Функция ПодготовитьРабочуюТаблицу(СтрокаНоменклатурыКД, СтрокаНоменклатурыИС, СтрокаНоменклатурыОстатков, СтрокаНоменклатурыКД_ИС, СтрокаНоменклатурыИС_Остатки)
	КоличествоОбъектов = СтрокаНоменклатурыКД.Строки.Количество() + СтрокаНоменклатурыИС.Строки.Количество() + СтрокаНоменклатурыОстатков.Строки.Количество();
	РабочаяТаблица = ИнициализироватьРабочуюТаблицу(КоличествоОбъектов);
	
	НоваяСтрока = РабочаяТаблица.Добавить();
	НоваяСтрока.Объект = Неопределено;
	НоваяСтрока.Ключ   = "Исток";
	НоваяСтрока.ВидОбъекта = "Исток";
	
	Для каждого ТекСтрока из СтрокаНоменклатурыКД.Строки Цикл
		НоваяСтрока            = РабочаяТаблица.Добавить();
		НоваяСтрока.Объект     = ТекСтрока.КатегорияДовольствующихся;
		НоваяСтрока.Ключ       = ВернутьКлюч(ТекСтрока, "КД");
		НоваяСтрока.ВидОбъекта = "КД";
	КонецЦикла;	
	
	Для каждого ТекСтрока из СтрокаНоменклатурыИС.Строки Цикл
		НоваяСтрока            = РабочаяТаблица.Добавить();
		НоваяСтрока.Объект     = УпаковатьОбъект(ТекСтрока, "ИС");
		НоваяСтрока.Ключ       = ВернутьКлюч(ТекСтрока, "ИС");
		НоваяСтрока.ВидОбъекта = "ИС";
	КонецЦикла;	
	
	Для каждого ТекСтрока из СтрокаНоменклатурыОстатков.Строки Цикл
		НоваяСтрока            = РабочаяТаблица.Добавить();
		НоваяСтрока.Объект     = УпаковатьОбъект(ТекСтрока, "Счет");
		НоваяСтрока.Ключ       = ВернутьКлюч(ТекСтрока, "Счет");
		НоваяСтрока.ВидОбъекта = "Счет";
	КонецЦикла;	
	
	НоваяСтрока = РабочаяТаблица.Добавить();
	НоваяСтрока.Объект = Неопределено;
	НоваяСтрока.Ключ   = "Сток";
	НоваяСтрока.ВидОбъекта = "Сток";
	
	ЗаполнитьРабочуюТаблицуДанными(РабочаяТаблица, СтрокаНоменклатурыКД_ИС, СтрокаНоменклатурыИС_Остатки);
	
	Возврат(РабочаяТаблица);
КонецФункции	

// Преобразует откорректируемую матрицу макимального потока к виду исходной матрицы
//
// РабочаяТаблица (ТаблицаЗначений). 
Процедура ТрансформироватьМатрицу(РабочаяТаблица)
	МаксИндекс = РабочаяТаблица.Количество() - 1;
	Для п = 0 по МаксИндекс Цикл
		Для к = (п + 1) по МаксИндекс Цикл
			РабочаяТаблица[п][к] = РабочаяТаблица[к][п];
			РабочаяТаблица[к][п] = 0;
		КонецЦикла;	
	КонецЦикла;	
КонецПроцедуры	

//******************************************************************************
// Процедуры и функции интерпритации результатов решения задачи о максимальном потоке.
//

// Добавляет строку в таблицу недостающих продуктов.
//
Процедура ДобавитьСтрокуВТаблицу(ТаблицаРезультат, ТекСтрока, к, Нехватает)
	НоваяСтрока = ТаблицаРезультат.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	МаксИндекс = ТекСтрока.ТаблицаИсходная.Количество() - 1;
	ТекКлюч  = "";
	МассивИС = Новый Массив;
	Для п = (к + 1) по МаксИндекс Цикл
		ТекПоток = ТекСтрока.ТаблицаИсходная[к][п];
		Если ТекПоток = 0 Тогда
			Продолжить;
		КонецЕсли;	
		ТекКлюч = ТекКлюч + ТекСтрока.ТаблицаИсходная[п]["Ключ"] + "@";
		МассивИС.Добавить(ТекСтрока.ТаблицаИсходная[п]["Объект"]);
	КонецЦикла;;	
	
	СтруктураПоиска = Новый Структура("Номенклатура, Ключ", ТекСтрока.Номенклатура, ТекКлюч);
	МассивНайденныхСтрок = ТаблицаРезультат.НайтиСтроки(СтруктураПоиска);
	
	Если МассивНайденныхСтрок.Количество() > 0 Тогда
		МассивНайденныхСтрок[0].Нехватает = МассивНайденныхСтрок[0].Нехватает + Нехватает;
	Иначе	
		НоваяСтрока.Ключ      = ТекКлюч;
		НоваяСтрока.МассивИС  = МассивИС;
		НоваяСтрока.Нехватает = Нехватает;
	КонецЕсли;	
КонецПроцедуры	

// Формирует таблицу недостающих продуктов. Определяет недостающее количество, источники
// средств (КВД + Баланс), по которым можно приобрести недостающие продукты, чтобы
// устанить нехватку.
//
// ТаблицаНоменклатуры (ТаблицаЗначений). Содержит номенклатуру (продукты), таблицу потребностей и таблицу
//									возможностей. Таблица потребностей -  исходная таблица потребностей номенклатуры
//									до распределения по счетам. Таблица возможностей - таблица потребностей после 
//									распределения по счетам.
//
// Возвращает таблицу значений с данными о недостающем количестве номенклатуры и источниками средств,
// по которым недостающее количество нужно приобретать.
Функция ВернутьТаблицуНедостающихПродуктовПоИС(ТаблицаНоменклатуры) Экспорт
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаРезультат.Колонки.Добавить("ЕдиницаИзмеренияПредставление", Новый ОписаниеТипов("Строка"));
	ТаблицаРезультат.Колонки.Добавить("НоменклатураКод", Новый ОписаниеТипов("Строка"));
	ТаблицаРезультат.Колонки.Добавить("Нехватает", Новый ОписаниеТипов("Число"));
	ТаблицаРезультат.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка"));
	ТаблицаРезультат.Колонки.Добавить("МассивИС", Новый ОписаниеТипов("Массив"));
	
	Для каждого ТекСтрока из ТаблицаНоменклатуры Цикл
		МатрицаИсходная = ТекСтрока.ТаблицаИсходная;
		МатрицаКонечная = ТекСтрока.ТаблицаРезультат;
		
		МаксИндекс = МатрицаИсходная.Количество() - 1;
		Для к = 1 по  МаксИндекс Цикл
			П1 = МатрицаИсходная[0][к];
			П2 = МатрицаКонечная[0][к];
			
			Нехватает = П1 - П2;
			
			Если Нехватает = 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			ДобавитьСтрокуВТаблицу(ТаблицаРезультат, ТекСтрока, к, Нехватает);
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат(ТаблицаРезультат);
КонецФункции	

//******************************************************************************
// Процедуры и функции заполнения меню-требования на списание продуктов.
//

// Заполняет табличную часть документа "Списание продуктов".
//
Процедура ЗаполнитьДокСписанияПоРасчетнойТаблице(ДокументОбъект, ТаблицаНоменклатуры) Экспорт
	
	Для каждого ТекСтрока из ТаблицаНоменклатуры Цикл
		МатрицаИсходная = ТекСтрока.ТаблицаИсходная;
		МатрицаКонечная = ТекСтрока.ТаблицаРезультат;
		
		МаксИндекс = МатрицаИсходная.Количество() - 1;
		КоличествоПотребность  = 0;
		КоличествоМожноСписать = 0;
		Для к = 1 по  МаксИндекс Цикл
			КоличествоПотребность  = КоличествоПотребность  + МатрицаИсходная[0][к];
			КоличествоМожноСписать = КоличествоМожноСписать + МатрицаКонечная[0][к];
		КонецЦикла;	
		
		Если КоличествоПотребность <> КоличествоМожноСписать Тогда
			Для к = 1 по  МаксИндекс Цикл
				Если МатрицаИсходная[0][к] = 0 Тогда
					Продолжить;
				КонецЕсли;	
				
				НоваяСтрока = ДокументОбъект.Материалы.Добавить();
				НоваяСтрока.Номенклатура     = ТекСтрока.Номенклатура;
				НоваяСтрока.Количество       = МатрицаИсходная[0][к];
				НоваяСтрока.КатегорияДовольствующихся = МатрицаИсходная[к]["Объект"];
			КонецЦикла;	
		Иначе
			Для к = 1 по  МаксИндекс Цикл
				Если МатрицаКонечная[0][к] = 0 Тогда
					Продолжить;
				КонецЕсли;	
				
				ТекКД = МатрицаКонечная[к]["Объект"];
				
				Для п = (к + 1) по МаксИндекс Цикл
					Если МатрицаКонечная[к][п] = 0 Тогда
						Продолжить;
					КонецЕсли;	
					
					ТекКоличество = МатрицаКонечная[к][п];
					
					Для м = (п + 1) по МаксИндекс Цикл
						Если МатрицаКонечная[п][м] = 0 ИЛИ ТекКоличество = 0 Тогда
							Продолжить;
						КонецЕсли;	
						
						КолКСписанию  = Мин(ТекКоличество, МатрицаКонечная[п][м]);
						ТекКоличество = ТекКоличество - КолКСписанию;
						
						НоваяСтрока = ДокументОбъект.Материалы.Добавить();
						НоваяСтрока.Номенклатура     = ТекСтрока.Номенклатура;
						НоваяСтрока.Количество       = КолКСписанию;
						НоваяСтрока.КатегорияДовольствующихся = ТекКД;
						ЗаполнитьЗначенияСвойств(НоваяСтрока, МатрицаКонечная[м]["Объект"]);
						НоваяСтрока.СчетУчета = МатрицаКонечная[м]["Объект"].Счет;
						НоваяСтрока.КПС   = МатрицаКонечная[м]["Объект"].КБК;
						НоваяСтрока.КФО   = МатрицаКонечная[м]["Объект"].КВД;
						НоваяСтрока.ИФО   = МатрицаКонечная[м]["Объект"].Баланс;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Производит распределение продуктов, предназначенных к списанию со склада
// по полным счетам учета в разрезе категорий довольствующихся и с учетом
// источников средств, с которых можно тратить продукты для каждой категории. 
// Распределение производится методом нахождения макимального
// потока в сети. Сеть представляет из себя граф, узлами которого явялются объекты
// - Категории довольствующихся (вершины 1 уровня)
// - Источники средств (КВД + Баланс)  (вершины 2 уровня)
// - Полные счета, на которых есть остатки продукта (КБК + КВД + Баланс + Счет)  (вершины 3 уровня)
// Задача решается для каждой номенклатурной позиции (продукта).
// ЦМО задан.
//
// ДокументСсылка (ДокументСсылка.МенюТребование). Документ, по которому производится расчет.
//
// Возвращает таблицу значений, которая имеет три колонки
// 1. Номенклатура (СправочникСсылка.Номенклатура)
// 2. Исходная таблица пропускных способностей (ТаблицаЗначений)
// 3. Результирующая таблица максимального потока (ТаблицаЗначений)
Функция РаспределитьПоСчетам(ДокументСсылка, МоментВремениДляЗапроса = Неопределено, МенеджерВременныхТаблиц = Неопределено) Экспорт
	Перем ДеревоКД, ДеревоИС, ДеревоОстатков, ДеревоКД_ИС, ДеревоИС_Остатки;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаРезультат.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаРезультат.Колонки.Добавить("ЕдиницаИзмеренияПредставление", Новый ОписаниеТипов("Строка"));
	ТаблицаРезультат.Колонки.Добавить("НоменклатураКод", Новый ОписаниеТипов("Строка"));
	ТаблицаРезультат.Колонки.Добавить("ТаблицаИсходная");
	ТаблицаРезультат.Колонки.Добавить("ТаблицаРезультат");
	
	СобратьДанныеПоПродуктамПитания(ДокументСсылка, ДеревоКД, ДеревоИС, ДеревоОстатков, ДеревоКД_ИС, ДеревоИС_Остатки, МоментВремениДляЗапроса, МенеджерВременныхТаблиц);
	
	Для каждого СтрокаНоменклатурыКД из ДеревоКД.Строки Цикл
		ТекНоменклатура = СтрокаНоменклатурыКД.Номенклатура;
		
		СтрокаНоменклатурыИС         = ДеревоИС.Строки.Найти(ТекНоменклатура, "Номенклатура");
		СтрокаНоменклатурыОстатков   = ДеревоОстатков.Строки.Найти(ТекНоменклатура, "Номенклатура");
		СтрокаНоменклатурыКД_ИС      = ДеревоКД_ИС.Строки.Найти(ТекНоменклатура, "Номенклатура");
		СтрокаНоменклатурыИС_Остатки = ДеревоИС_Остатки.Строки.Найти(ТекНоменклатура, "Номенклатура");
		
		РабочаяТаблица = ПодготовитьРабочуюТаблицу(СтрокаНоменклатурыКД, СтрокаНоменклатурыИС, СтрокаНоменклатурыОстатков, СтрокаНоменклатурыКД_ИС, СтрокаНоменклатурыИС_Остатки);
		МаксИндекс = РабочаяТаблица.Количество() - 1;
		ИсходнаяРабочаяТаблица = РабочаяТаблица.Скопировать();
		НайтиМаксимальныйПоток(РабочаяТаблица, МаксИндекс);
		ТрансформироватьМатрицу(РабочаяТаблица);
		
		НоваяСтрока = ТаблицаРезультат.Добавить();
		НоваяСтрока.Номенклатура     = ТекНоменклатура;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНоменклатурыКД);
		НоваяСтрока.ТаблицаИсходная  = ИсходнаяРабочаяТаблица.Скопировать();
		НоваяСтрока.ТаблицаРезультат = РабочаяТаблица.Скопировать();
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

// Формирует и выполняет запросы по документу "Меню-требование".
// Собирает данные для заполнения ими исходной матрицы пропускных способностей.
//
Процедура СобратьДанныеПоПродуктамПитания(Документ, ДеревоКД, ДеревоИС, ДеревоОстатков, ДеревоКД_ИС, ДеревоИС_Остатки, МоментВремениДляЗапроса = Неопределено, МенеджерВременныхТаблиц = Неопределено)
	
	МоментВремениЗапроса = ?(МоментВремениДляЗапроса = Неопределено, Документ.МоментВремени(), МоментВремениДляЗапроса);
	СчетаУчетаПП = БухгалтерскийУчет.СписокСчетов("105.32,105.22");
	ВедетсяУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") 
									И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("105.32,105.22").УчетПоПодразделениям;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаЗапроса",				МоментВремениЗапроса);
	Запрос.УстановитьПараметр("Организация",				Документ.Организация);
	Запрос.УстановитьПараметр("СчетаУчетаПП",				СчетаУчетаПП);
	Запрос.УстановитьПараметр("ЦМО",						Документ.ЦМО);
	Запрос.УстановитьПараметр("Подразделение",				Документ.Подразделение);
	Запрос.УстановитьПараметр("ВедетсяУчетПоПодразделениям",ВедетсяУчетПоПодразделениям);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО",		ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	
	Если ТипЗнч(МенеджерВременныхТаблиц) = Тип("МенеджерВременныхТаблиц") Тогда
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Иначе
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "СоставБлюда",
			"НомерСтроки,Номенклатура,КатегорияДовольствующихся,Количество,ПриемПищи,Блюдо,Спецификация,ВариантМеню",
			Документ);
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "МенюРаскладка",
			"НомерСтроки,КатегорияДовольствующихся,Количество,ПриемПищи,Блюдо,Спецификация,ВариантМеню",
			Документ);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	МенюТребованиеСоставБлюда.Номенклатура,
		|	МенюТребованиеСоставБлюда.КатегорияДовольствующихся,
		|	СУММА(МенюТребованиеМенюРаскладка.Количество * МенюТребованиеСоставБлюда.Количество) КАК Количество,
		|	МенюТребованиеСоставБлюда.КатегорияДовольствующихся.Код КАК КатегорияДовольствующихсяПредставление
		|ПОМЕСТИТЬ ТаблицаОсновная
		|ИЗ
		|	ТаблицаСоставБлюда КАК МенюТребованиеСоставБлюда
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаМенюРаскладка КАК МенюТребованиеМенюРаскладка
		|		ПО МенюТребованиеСоставБлюда.КатегорияДовольствующихся = МенюТребованиеМенюРаскладка.КатегорияДовольствующихся
		|			И МенюТребованиеСоставБлюда.ПриемПищи = МенюТребованиеМенюРаскладка.ПриемПищи
		|			И МенюТребованиеСоставБлюда.Блюдо = МенюТребованиеМенюРаскладка.Блюдо
		|			И МенюТребованиеСоставБлюда.Спецификация = МенюТребованиеМенюРаскладка.Спецификация
		|			И МенюТребованиеСоставБлюда.ВариантМеню = МенюТребованиеМенюРаскладка.ВариантМеню
		|
		|СГРУППИРОВАТЬ ПО
		|	МенюТребованиеСоставБлюда.КатегорияДовольствующихся,
		|	МенюТребованиеСоставБлюда.Номенклатура,
		|	МенюТребованиеСоставБлюда.КатегорияДовольствующихся.Код";
		Запрос.Выполнить();
		
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаОсновная.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
