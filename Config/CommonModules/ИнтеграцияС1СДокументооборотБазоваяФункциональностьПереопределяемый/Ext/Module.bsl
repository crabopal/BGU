Процедура ЗаполнитьРеквизитыИзПотребителя(Прокси, ОбъектXDTO, СсылкаНаПотребитель) Экспорт

    Если СсылкаНаПотребитель.Пустая() Тогда
        Возврат;
    КонецЕсли;

    УстановитьПривилегированныйРежим(Истина);

    Настройки = ИнтеграцияС1СДокументооборотБазоваяФункциональностьВызовСервера.ИспользоватьИнтеграцию();

    Если ТипЗнч(СсылкаНаПотребитель) = Тип("ПеречислениеСсылка.ЮрФизЛицо") Тогда

        Если Настройки.ИспользоватьИнтеграциюДО2 Тогда
            ОбъектXDTO = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                Прокси,
                "DMLegalPrivatePerson",
                СсылкаНаПотребитель,
                Ложь);
            ОбъектXDTO.objectID.type = "DMLegalPrivatePerson";
            Если СсылкаНаПотребитель = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
                ОбъектXDTO.objectID.ID = "ЮрЛицо";
            ИначеЕсли СсылкаНаПотребитель = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
                ОбъектXDTO.objectID.ID = "ФизЛицо";
            КонецЕсли;
        ИначеЕсли Настройки.ИспользоватьИнтеграциюДО3 Тогда
            Если СсылкаНаПотребитель = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
                ОбъектXDTO = "LglPerson";
            ИначеЕсли СсылкаНаПотребитель = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
                ОбъектXDTO = "Individ";
            КонецЕсли;
        КонецЕсли;

    ИначеЕсли ТипЗнч(СсылкаНаПотребитель) = Тип("ПеречислениеСсылка.СтавкиНДС") Тогда

        Если Настройки.ИспользоватьИнтеграциюДО2 Тогда
            ОбъектXDTO = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                Прокси,
                "DMVATRate",
                СсылкаНаПотребитель,
                Ложь);
            ОбъектXDTO.objectID.type = "DMVATRate";
            Если СсылкаНаПотребитель = Перечисления.СтавкиНДС.БезНДС Тогда
                ОбъектXDTO.objectID.ID = "БезНДС";
            ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС0 Тогда
                ОбъектXDTO.objectID.ID = "НДС0";
            ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС5
                    Или СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС5_105 Тогда
                ОбъектXDTO.objectID.ID = "НДС5";
            ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС7
                    Или СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС7_107 Тогда
                ОбъектXDTO.objectID.ID = "НДС7";
            ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС10
                    Или СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС10_110 Тогда
                ОбъектXDTO.objectID.ID = "НДС10";
            ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС18
                    Или СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС18_118 Тогда
                ОбъектXDTO.objectID.ID = "НДС18";
            ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС20
                    Или СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС20_120 Тогда
                ОбъектXDTO.objectID.ID = "НДС20";
            ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС22
                    Или СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС22_122 Тогда
                ОбъектXDTO.objectID.ID = "НДС22";
            КонецЕсли;
        ИначеЕсли Настройки.ИспользоватьИнтеграциюДО3 Тогда
            Если ИнтеграцияС1СДокументооборотБазоваяФункциональностьПовтИсп.ДоступенФункционалВерсииСервиса("3.0.16.33") Тогда
                ОбъектXDTO = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                    Прокси,
                    "DMVATRateUniversal",
                    СсылкаНаПотребитель,
                    Ложь);
                Если СсылкаНаПотребитель = Перечисления.СтавкиНДС.БезНДС Тогда
                    ОбъектXDTO.predefinedName = "WithoutVAT";
                    ОбъектXDTO.rate = 0;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС0 Тогда
                    ОбъектXDTO.predefinedName = "VAT0";
                    ОбъектXDTO.rate = 0;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС5 Тогда
                    ОбъектXDTO.rate = 5;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС5_105 Тогда
                    ОбъектXDTO.rate = 5;
                    ОбъектXDTO.calculatedRate = Истина;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС7 Тогда
                    ОбъектXDTO.rate = 7;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС7_107 Тогда
                    ОбъектXDTO.rate = 7;
                    ОбъектXDTO.calculatedRate = Истина;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС10 Тогда
                    ОбъектXDTO.predefinedName = "VAT10";
                    ОбъектXDTO.rate = 10;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС10_110 Тогда
                    ОбъектXDTO.predefinedName = "VAT10";
                    ОбъектXDTO.rate = 10;
                    ОбъектXDTO.calculatedRate = Истина;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС18 Тогда
                    ОбъектXDTO.predefinedName = "VAT18";
                    ОбъектXDTO.rate = 18;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС18_118 Тогда
                    ОбъектXDTO.predefinedName = "VAT18";
                    ОбъектXDTO.rate = 18;
                    ОбъектXDTO.calculatedRate = Истина;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС20 Тогда
                    ОбъектXDTO.predefinedName = "VAT20";
                    ОбъектXDTO.rate = 20;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС20_120 Тогда
                    ОбъектXDTO.predefinedName = "VAT20";
                    ОбъектXDTO.rate = 20;
                    ОбъектXDTO.calculatedRate = Истина;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС22 Тогда
                    ОбъектXDTO.rate = 22;
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС22_122 Тогда
                    ОбъектXDTO.rate = 22;
                    ОбъектXDTO.calculatedRate = Истина;
                КонецЕсли;
            Иначе
                Если СсылкаНаПотребитель = Перечисления.СтавкиНДС.БезНДС Тогда
                    ОбъектXDTO = "WithoutVAT";
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС0 Тогда
                    ОбъектXDTO = "VAT0";
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС10
                        Или СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС10_110 Тогда
                    ОбъектXDTO = "VAT10";
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС18
                        Или СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС18_118 Тогда
                    ОбъектXDTO = "VAT18";
                ИначеЕсли СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС20
                        Или СсылкаНаПотребитель = Перечисления.СтавкиНДС.НДС20_120 Тогда
                    ОбъектXDTO = "VAT20";
                КонецЕсли
            КонецЕсли;
        КонецЕсли;

    ИначеЕсли ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПроверитьТип(Прокси, ОбъектXDTO, "DMCorrespondent")
            И ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.Контрагенты")
            И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаПотребитель, "ЭтоГруппа") Тогда

        Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаПотребитель,
            "ИНН, КПП, ВидКонтрагента");

        Если ЗначениеЗаполнено(Реквизиты.ИНН) Тогда
            ОбъектXDTO.inn = Реквизиты.ИНН;
        КонецЕсли;
        Если ЗначениеЗаполнено(Реквизиты.КПП) Тогда
            ОбъектXDTO.kpp = Реквизиты.КПП;
        КонецЕсли;

        ИнтеграцияС1СДокументооборотБазоваяФункциональность.ЗаполнитьРеквизитыИзПотребителя(
            Прокси,
            ОбъектXDTO.legalPrivatePerson,
            Реквизиты.ВидКонтрагента);

    ИначеЕсли ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПроверитьТип(Прокси, ОбъектXDTO, "DMOrganization")
            И ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.Организации") Тогда

        Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаПотребитель,
            "ИНН, КПП, КодОКПО, НаименованиеПолное, Префикс");

        Если ЗначениеЗаполнено(Реквизиты.ИНН) Тогда
            ОбъектXDTO.inn = Реквизиты.ИНН;
        КонецЕсли;
        Если ЗначениеЗаполнено(Реквизиты.КПП) Тогда
            ОбъектXDTO.kpp = Реквизиты.КПП;
        КонецЕсли;
        Если ЗначениеЗаполнено(Реквизиты.КодОКПО) Тогда
            ОбъектXDTO.okpo = Реквизиты.КодОКПО;
        КонецЕсли;
        Если ЗначениеЗаполнено(Реквизиты.НаименованиеПолное) Тогда
            ОбъектXDTO.fullName = Реквизиты.НаименованиеПолное;
        КонецЕсли;
        Если ЗначениеЗаполнено(Реквизиты.Префикс) Тогда
            ОбъектXDTO.prefix = Реквизиты.Префикс;
        КонецЕсли;

        Если Настройки.ИспользоватьИнтеграциюДО2 Тогда
            ОбъектXDTO.legalPrivatePerson = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                Прокси,
                "DMLegalPrivatePerson");
            ОбъектXDTO.legalPrivatePerson.name = "Юр. лицо";
            ОбъектXDTO.legalPrivatePerson.objectID = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьObjectID(
                Прокси,
                "ЮрЛицо",
                "DMLegalPrivatePerson");
        ИначеЕсли Настройки.ИспользоватьИнтеграциюДО3 Тогда
            ОбъектXDTO.legalPrivatePerson = "LglPerson";
        КонецЕсли;

    ИначеЕсли ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПроверитьТип(Прокси, ОбъектXDTO, "DMPrivatePerson")
            И ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.ФизическиеЛица")
            И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаПотребитель, "ЭтоГруппа") Тогда

        Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаПотребитель,
            "Наименование, ДатаРождения, ИНН, СтраховойНомерПФР");

        ОбъектXDTO.name = Реквизиты.Наименование;
        Если ЗначениеЗаполнено(Реквизиты.ДатаРождения) Тогда
            ОбъектXDTO.birthDay = Реквизиты.ДатаРождения;
        КонецЕсли;
        Если ЗначениеЗаполнено(Реквизиты.ИНН)
                И ИнтеграцияС1СДокументооборотБазоваяФункциональность.СвойствоСуществует(ОбъектXDTO, "inn") Тогда
            ОбъектXDTO.inn = Реквизиты.ИНН;
        КонецЕсли;
        Если ЗначениеЗаполнено(Реквизиты.СтраховойНомерПФР)
                И ИнтеграцияС1СДокументооборотБазоваяФункциональность.СвойствоСуществует(ОбъектXDTO, "retirementInsuranceNumber") Тогда
            ОбъектXDTO.retirementInsuranceNumber = Реквизиты.СтраховойНомерПФР;
        КонецЕсли;

    ИначеЕсли ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПроверитьТип(Прокси, ОбъектXDTO, "DMBankAccount")
            И ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.БанковскиеИКазначейскиеСчета") Тогда

        Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаПотребитель,
            "Владелец, ТипЛицевогоСчета, Код, КассовыйОрган");

        Если Реквизиты.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский
                И ТипЗнч(Реквизиты.Владелец) = Тип("СправочникСсылка.Контрагенты") Тогда
            ОбъектXDTO.number = Реквизиты.Код;
            Если ЗначениеЗаполнено(Реквизиты.Владелец) Тогда
                ОбъектXDTO.owner = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                    Прокси,
                    "DMCorrespondent",
                    Реквизиты.Владелец);
            КонецЕсли;
            Если ЗначениеЗаполнено(Реквизиты.КассовыйОрган) Тогда
                ОбъектXDTO.bank = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                    Прокси,
                    "DMBank",
                    Реквизиты.КассовыйОрган);
            КонецЕсли;
        КонецЕсли;

    ИначеЕсли ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПроверитьТип(Прокси, ОбъектXDTO, "DMSubdivision")
            И ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.Подразделения") Тогда

        Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаПотребитель, "Владелец");
        Запрос = Новый Запрос(
            "ВЫБРАТЬ ПЕРВЫЕ 1
            |    ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо КАК ОтветственноеЛицо
            |ИЗ
            |    РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(
            |            ,
            |            ВидОтветственногоЛица = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)
            |                И Подразделение = &Подразделение
            |                И Организация = &Организация) КАК ОтветственныеЛицаОрганизацийСрезПоследних");
        Запрос.УстановитьПараметр("Подразделение", СсылкаНаПотребитель);
        Запрос.УстановитьПараметр("Организация", Организация);
        Выборка = Запрос.Выполнить().Выбрать();

        Если Выборка.Следующий() Тогда

            Руководитель = Выборка.ОтветственноеЛицо;

            Если Настройки.ИспользоватьИнтеграциюДО2 Тогда
                ИмяТипаXDTO = "DMUser";
            ИначеЕсли Настройки.ИспользоватьИнтеграциюДО3 Тогда
                ИмяТипаXDTO = "DMEmployee";
            КонецЕсли;

            ОбъектXDTO.head = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                Прокси,
                ИмяТипаXDTO,
                Руководитель,
                Ложь);
            ОбъектXDTO.head.subdivision = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                Прокси,
                "DMSubdivision",
                СсылкаНаПотребитель,
                Ложь);

        КонецЕсли;

    ИначеЕсли ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПроверитьТип(Прокси, ОбъектXDTO, "DMUser") Тогда

        Если ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.Сотрудники") Тогда
            Запрос = Новый Запрос(
                "ВЫБРАТЬ ПЕРВЫЕ 1
                |    ДанныеСотрудниковСрезПоследних.Подразделение КАК Подразделение,
                |    ЕСТЬNULL(Контрагенты.ЮридическоеФизическоеЛицо, НЕОПРЕДЕЛЕНО) КАК ФизическоеЛицо
                |ИЗ
                |    РегистрСведений.ДанныеСотрудников.СрезПоследних(, Сотрудник = &Сотрудник) КАК ДанныеСотрудниковСрезПоследних
                |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
                |        ПО ДанныеСотрудниковСрезПоследних.Сотрудник.Контрагент = Контрагенты.Ссылка");
            Запрос.УстановитьПараметр("Сотрудник", СсылкаНаПотребитель);
            Выборка = Запрос.Выполнить().Выбрать();

            Если Выборка.Следующий() Тогда
                Если ЗначениеЗаполнено(Выборка.Подразделение) Тогда
                    ОбъектXDTO.subdivision = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                        Прокси,
                        "DMSubdivision",
                        Выборка.Подразделение);
                КонецЕсли;
                Если ЗначениеЗаполнено(Выборка.ФизическоеЛицо) Тогда
                    ОбъектXDTO.privatePerson = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                        Прокси,
                        "DMPrivatePerson",
                        Выборка.ФизическоеЛицо);
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;

        Если ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
            Запрос = Новый Запрос(
                "ВЫБРАТЬ РАЗЛИЧНЫЕ
                |    Пользователи.Ссылка КАК Ссылка
                |ИЗ
                |    Справочник.Пользователи КАК Пользователи
                |ГДЕ
                |    Пользователи.ФизическоеЛицо = &ФизическоеЛицо
                |    И НЕ Пользователи.ПометкаУдаления");
            Запрос.УстановитьПараметр("ФизическоеЛицо", СсылкаНаПотребитель);
            ВыборкаПользователи = Запрос.Выполнить().Выбрать();

            Если ВыборкаПользователи.Количество() = 1 Тогда
                ВыборкаПользователи.Следующий();
                ИнтеграцияС1СДокументооборотБазоваяФункциональность.ЗаполнитьРеквизитыИзПотребителя(
                    Прокси,
                    ОбъектXDTO,
                    ВыборкаПользователи.Ссылка);
            Иначе
                ОбъектXDTO.privatePerson = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                    Прокси,
                    "DMPrivatePerson",
                    СсылкаНаПотребитель);
            КонецЕсли;
        КонецЕсли;

    ИначеЕсли ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПроверитьТип(Прокси, ОбъектXDTO, "DMEmployee") Тогда

        Если ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.Сотрудники") Тогда
            Запрос = Новый Запрос(
                "ВЫБРАТЬ ПЕРВЫЕ 1
                |    ДанныеСотрудниковСрезПоследних.Подразделение КАК Подразделение,
                |    ДанныеСотрудниковСрезПоследних.Должность КАК Должность,
                |    ЕСТЬNULL(Контрагенты.ЮридическоеФизическоеЛицо, НЕОПРЕДЕЛЕНО) КАК ФизическоеЛицо
                |ИЗ
                |    РегистрСведений.ДанныеСотрудников.СрезПоследних(, Сотрудник = &Сотрудник) КАК ДанныеСотрудниковСрезПоследних
                |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
                |        ПО ДанныеСотрудниковСрезПоследних.Сотрудник.Контрагент = Контрагенты.Ссылка");
            Запрос.УстановитьПараметр("Сотрудник", СсылкаНаПотребитель);
            Выборка = Запрос.Выполнить().Выбрать();

            Если Выборка.Следующий() Тогда
                Если ЗначениеЗаполнено(Выборка.Подразделение) Тогда
                    ОбъектXDTO.subdivision = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                        Прокси,
                        "DMSubdivision",
                        Выборка.Подразделение);
                КонецЕсли;
                Если ЗначениеЗаполнено(Выборка.Должность) Тогда
                    ОбъектXDTO.position = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                        Прокси,
                        "DMPosition",
                        Выборка.Должность);
                КонецЕсли;
                Если ЗначениеЗаполнено(Выборка.ФизическоеЛицо) Тогда
                    ОбъектXDTO.privatePerson = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                        Прокси,
                        "DMPrivatePerson",
                        Выборка.ФизическоеЛицо);
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;

        Если ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.Пользователи") Тогда
            ФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаПотребитель, "ФизическоеЛицо");
            Если ЗначениеЗаполнено(ФизическоеЛицо) Тогда

                Запрос = Новый Запрос(
                    "ВЫБРАТЬ
                    |    Сотрудники.Ссылка КАК Сотрудник
                    |ИЗ
                    |    Справочник.Сотрудники КАК Сотрудники
                    |ГДЕ
                    |    Сотрудники.Контрагент.ЮридическоеФизическоеЛицо = &ФизическоеЛицо
                    |    И НЕ Сотрудники.ПометкаУдаления");
                Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
                ВыборкаСотрудники = Запрос.Выполнить().Выбрать();

                Если ВыборкаСотрудники.Количество() = 1 Тогда
                    ВыборкаСотрудники.Следующий();
                    ИнтеграцияС1СДокументооборотБазоваяФункциональность.ЗаполнитьРеквизитыИзПотребителя(
                        Прокси,
                        ОбъектXDTO,
                        ВыборкаСотрудники.Сотрудник);
                Иначе
                    ОбъектXDTO.privatePerson = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                        Прокси,
                        "DMPrivatePerson",
                        ФизическоеЛицо);
                КонецЕсли;

            КонецЕсли;
        КонецЕсли;

        Если ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
            Запрос = Новый Запрос(
                "ВЫБРАТЬ
                |    Сотрудники.Ссылка КАК Сотрудник
                |ИЗ
                |    Справочник.Сотрудники КАК Сотрудники
                |ГДЕ
                |    Сотрудники.Контрагент.ЮридическоеФизическоеЛицо = &ФизическоеЛицо
                |    И НЕ Сотрудники.ПометкаУдаления");
            Запрос.УстановитьПараметр("ФизическоеЛицо", СсылкаНаПотребитель);
            ВыборкаСотрудники = Запрос.Выполнить().Выбрать();

            Если ВыборкаСотрудники.Количество() = 1 Тогда
                ВыборкаСотрудники.Следующий();
                ИнтеграцияС1СДокументооборотБазоваяФункциональность.ЗаполнитьРеквизитыИзПотребителя(
                    Прокси,
                    ОбъектXDTO,
                    ВыборкаСотрудники.Сотрудник);
            Иначе
                ОбъектXDTO.privatePerson = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                    Прокси,
                    "DMPrivatePerson",
                    СсылкаНаПотребитель);
            КонецЕсли;
        КонецЕсли;

    ИначеЕсли ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПроверитьТип(Прокси, ОбъектXDTO, "DMParty") Тогда

        Если ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.Контрагенты") Тогда
            ОбъектXDTO.correspondent = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                Прокси,
                "DMCorrespondent",
                СсылкаНаПотребитель);

        ИначеЕсли ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.Организации") Тогда
            ОбъектXDTO.organization = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                Прокси,
                "DMOrganization",
                СсылкаНаПотребитель);

        ИначеЕсли ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.Пользователи")
                Или ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.ФизическиеЛица")
                Или ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.Сотрудники") Тогда
            Если Настройки.ИспользоватьИнтеграциюДО2 Тогда
                ОбъектXDTO.user = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                    Прокси,
                    "DMUser",
                    СсылкаНаПотребитель);
            ИначеЕсли Настройки.ИспользоватьИнтеграциюДО3 Тогда
                ОбъектXDTO.employee = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                    Прокси,
                    "DMEmployee",
                    СсылкаНаПотребитель);
            КонецЕсли;

        КонецЕсли;

    ИначеЕсли ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПроверитьТип(Прокси, ОбъектXDTO, "DMPartyRowContact")
            И (ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.Пользователи")
                Или ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.ФизическиеЛица")
                Или ТипЗнч(СсылкаНаПотребитель) = Тип("СправочникСсылка.Сотрудники")) Тогда
        Если Настройки.ИспользоватьИнтеграциюДО2 Тогда
            ОбъектXDTO.user = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                Прокси,
                "DMUser",
                СсылкаНаПотребитель);
        ИначеЕсли Настройки.ИспользоватьИнтеграциюДО3 Тогда
            ОбъектXDTO.employee = ИнтеграцияС1СДокументооборотБазоваяФункциональность.СоздатьОбъект(
                Прокси,
                "DMEmployee",
                СсылкаНаПотребитель);
        КонецЕсли;

    КонецЕсли;

    УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Заполняет реквизиты формы по данным объекта интегрированной системы.
//
// Параметры:
//   ВнешнийОбъект - ЛюбаяСсылка - ссылка на объект-основание.
//   Форма - ФормаКлиентскогоПриложения - форма обработки ИнтеграцияС1СДокументооборот, соответствующая заполняемому
//    объекту Документооборота.
//
Процедура ЗаполнитьФормуИзПотребителя(ВнешнийОбъект, Форма) Экспорт
	
	
	
КонецПроцедуры

// Вызывается перед записью входящих, исходящих, внутренних документов Документооборота.
// Позволяет выполнить дополнительные проверки перед записью, и отказаться от записи.
//
// Параметры:
//   Прокси - WSПрокси - объект для подключения к web-сервисам Документооборота.
//   ОбъектXDTO - ОбъектXDTO - заполняемый объект. Тип DMInternalDocument, DMIncomingDocument, DMOutgoingDocument.
//   Форма - ФормаКлиентскогоПриложения - форма документа Документооборота.
//   Отказ - Булево - признак отказа от записи документа.
//
Процедура ПередЗаписьюДокумента(Прокси, ОбъектXDTO, Форма, Отказ) Экспорт
	
	
	
КонецПроцедуры

// Вызывается перед записью объектов интегрированной системы через механизм обмена с 1С:Документооборот.
// Позволяет выполнить дополнительные проверки перед записью, изменить ДополнительныеСвойства и отказаться от записи.
//
// Параметры:
//   ОбъектИС - ДокументОбъект
//            - СправочникОбъект - изменяемый объект ИС.
//   Отказ - Булево - признак отказа от записи.
//   РежимЗаписиДокумента - РежимЗаписиДокумента - позволяет изменить режим записи.
//   РежимПроведенияДокумента - РежимПроведенияДокумента - позволяет изменить режим проведения документа.
//
Процедура ПередЗаписьюОбъектаИС(ОбъектИС, Отказ,
		РежимЗаписиДокумента = Неопределено, РежимПроведенияДокумента = Неопределено) Экспорт
	
	
	
КонецПроцедуры

// Вызывается при добавлении подсистемы в дерево интегрируемых объектов, с помощью которого настраивается
// интеграция. По умолчанию выводятся подсистемы первого уровня, включаемые в командный интерфейс, и
// подчиненные им.
//
// Параметры:
//  Подсистема - ОбъектМетаданных - добавляемая подсистема, содержащая интегрируемые объекты.
//  Отказ - Булево - при установке в Ложь подсистема будет пропущена вместе со всеми подчиненными.
//
Процедура ПриДобавленииПодсистемыВДеревоИнтегрируемыхОбъектов(Подсистема, Отказ) Экспорт

    Если ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиКлиентскогоПриложения").ВариантИнтерфейсаКлиентскогоПриложения
                = ВариантИнтерфейсаКлиентскогоПриложения.Версия8_2
            И Не Подсистема.Комментарий = "Интерфейс Версия 8.2" Тогда
        Отказ = Истина;
    ИначеЕсли ХранилищеСистемныхНастроек.Загрузить("Общее/НастройкиКлиентскогоПриложения").ВариантИнтерфейсаКлиентскогоПриложения
                = ВариантИнтерфейсаКлиентскогоПриложения.Такси
            И Не Подсистема.Комментарий = "Интерфейс Такси" Тогда
        Отказ = Истина;
    КонецЕсли;

    Если ПолучитьФункциональнуюОпцию("ВестиУчетИмуществаКазны") = Ложь
            И СтрНайти("ИмуществоКазны", Подсистема.Имя) > 0 Тогда
        Отказ = Истина;
    КонецЕсли;

    Если ПолучитьФункциональнуюОпцию("ВестиУчетПродуктовПитания") = Ложь
            И СтрНайти("УчетПродуктовПитания", Подсистема.Имя) > 0 Тогда
        Отказ = Истина;
    КонецЕсли;

    Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетРодительскойПлаты") = Ложь
            И ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтудентов") = Ложь
            И СтрНайти("ПлатноеОбразование", Подсистема.Имя) > 0 Тогда
        Отказ = Истина;
    КонецЕсли;

    Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетРодительскойПлаты") = Ложь
            И СтрНайти("РодительскаяПлата", Подсистема.Имя) > 0 Тогда
        Отказ = Истина;
    КонецЕсли;

    Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтудентов") = Ложь
            И СтрНайти("ОбразовательныеУслуги", Подсистема.Имя) > 0 Тогда
        Отказ = Истина;
    КонецЕсли;

    Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетГСМ") = Ложь
            И СтрНайти("УчетГСМ", Подсистема.Имя) > 0 Тогда
        Отказ = Истина;
    КонецЕсли;

    Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетФинансовыхВложений") = Ложь
            И СтрНайти("ФинансовыеВложения", Подсистема.Имя) > 0 Тогда
        Отказ = Истина;
    КонецЕсли;

КонецПроцедуры

