// ПРОЦЕДУРЫ И ФУНКЦИИ РАБОТЫ С ДАННЫМИ ФИЗЛИЦА

// Инициализация данных формы для редактирования документа, удостоверяющего личность
//
// Параметры:
//	Форма - управляемая форма
//	ВедущийОбъект - ссылка на объект, документ которого редактируется в форме
//
// Ограничения:
//	Форма должна содержать реквизиты
//		ДокументыФизическихЛиц
//		ДокументыФизическихЛицПрежняя
//		ДокументыФизическихЛицНоваяЗапись
// см. также ПрочитатьДокументУдостоверяющийЛичностьДляРедактированияВФорме
Процедура ИнициализироватьДокументУдостоверяющийЛичностьДляРедактированияВФорме(Форма, ВедущийОбъект) Экспорт
	
	МетаданныеРегистра = Метаданные.РегистрыСведений.ДокументыФизическихЛиц;
	МенеджерЗаписи = РегистрыСведений.ДокументыФизическихЛиц.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Физлицо = ВедущийОбъект;
	Форма.ЗначениеВРеквизитФормы(МенеджерЗаписи, "ДокументыФизическихЛиц");
	
	ЗаписьКакСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(МенеджерЗаписи, МетаданныеРегистра);
	Форма.ДокументыФизическихЛицПрежняя = Новый ФиксированнаяСтруктура(ЗаписьКакСтруктура);
	
	Форма.ДокументыФизическихЛицНоваяЗапись = Ложь;
	
КонецПроцедуры

// Чтение и запись записи документа, удостоверяющего личность, подчиненного ведущему объекту 
// для редактирования документа в форме
//
// Параметры:
//	Форма - управляемая форма
//	ВедущийОбъект - ссылка на ведущий объект
//
// Ограничения:
//	Форма должна содержать реквизиты
//		ДокументыФизическихЛиц
//		ДокументыФизическихЛицПрежняя
//		ДокументыФизическихЛицНоваяЗапись
Процедура ПрочитатьДокументУдостоверяющийЛичностьДляРедактированияВФорме(Форма, ВедущийОбъект) Экспорт
	
	Если НЕ ПравоДоступа("Чтение", Метаданные.Справочники.ФизическиеЛица) Тогда
		Возврат;
	КонецЕсли;	

	Если НЕ Форма.Параметры.Ключ.Пустая() Тогда
		ИнициализироватьДокументУдостоверяющийЛичностьДляРедактированияВФорме(Форма, ВедущийОбъект)
	КонецЕсли;
	МетаданныеРегистра = Метаданные.РегистрыСведений.ДокументыФизическихЛиц;
	// Ищем последнюю запись
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РегистрСведений.Период,
	|	РегистрСведений.ВидДокумента
	|ИЗ
	|	РегистрСведений.ДокументыФизическихЛиц КАК РегистрСведений
	|ГДЕ
	|	РегистрСведений.Физлицо = &ВедущийОбъект
	|	И РегистрСведений.ЯвляетсяДокументомУдостоверяющимЛичность
	|
	|УПОРЯДОЧИТЬ ПО
	|	РегистрСведений.Период УБЫВ");
	Запрос.УстановитьПараметр("ВедущийОбъект", ВедущийОбъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерЗаписи = РегистрыСведений.ДокументыФизическихЛиц.СоздатьМенеджерЗаписи();
	Если Выборка.Следующий() Тогда
		МенеджерЗаписи.Период = Выборка.Период;
		МенеджерЗаписи.ВидДокумента = Выборка.ВидДокумента;
		МенеджерЗаписи.Физлицо = ВедущийОбъект;
		МенеджерЗаписи.Прочитать();
	КонецЕсли;
	// имя реквизита формы совпадает с именем регистра
	Форма.ЗначениеВРеквизитФормы(МенеджерЗаписи, "ДокументыФизическихЛиц");
	
	ЗаписьКакСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(МенеджерЗаписи, МетаданныеРегистра);
	Форма.ДокументыФизическихЛицПрежняя = Новый ФиксированнаяСтруктура(ЗаписьКакСтруктура);
	
	Форма.ДокументыФизическихЛицНоваяЗапись = Ложь;
	
КонецПроцедуры

// запись записи документа удостоверяющего личность, подчиненных ведущему объекту 
// см. ПрочитатьДокументУдостоверяющийЛичностьДляРедактированияВФорме
Процедура ЗаписатьДокументУдостоверяющийЛичностьПослеРедактированияВФорме(Форма, ВедущийОбъект) Экспорт
	ИмяРегистра = "ДокументыФизическихЛиц";
	МетаданныеРегистра = Метаданные.РегистрыСведений.ДокументыФизическихЛиц;
	ИмяИзмерения = "ФизЛицо";

	ИзменилисьДанные = Форма[ИмяРегистра].Период <> Форма[ИмяРегистра + "Прежняя"].Период;
	Если НЕ ИзменилисьДанные Тогда
		ИзменилисьДанные = ИзменилисьДанные ИЛИ 
		(ВедущийОбъект <> Форма[ИмяРегистра + "Прежняя"][ИмяИзмерения] И 
		ЗначениеЗаполнено(Форма[ИмяРегистра + "Прежняя"][ИмяИзмерения]));
	КонецЕсли;
	Если НЕ ИзменилисьДанные Тогда
		ИзменилисьДанные = ИзменилисьДанные ИЛИ 
		(Форма[ИмяРегистра].ВидДокумента <> Форма[ИмяРегистра + "Прежняя"].ВидДокумента);
	КонецЕсли;
	Если НЕ ИзменилисьДанные Тогда
		Для Каждого Поле Из МетаданныеРегистра.Ресурсы Цикл
			ИзменилисьДанные = ИзменилисьДанные ИЛИ (Форма[ИмяРегистра][Поле.Имя] <> Форма[ИмяРегистра + "Прежняя"][Поле.Имя]);
		КонецЦикла;
	КонецЕсли;
	Если НЕ ИзменилисьДанные Тогда
		Для Каждого Поле Из МетаданныеРегистра.Реквизиты Цикл
			ИзменилисьДанные = ИзменилисьДанные ИЛИ (Форма[ИмяРегистра][Поле.Имя] <> Форма[ИмяРегистра + "Прежняя"][Поле.Имя]);
		КонецЦикла;
	КонецЕсли;
	
	Если ИзменилисьДанные Тогда
		// пишем новое состояние записи
		МенеджерЗаписи = Форма.РеквизитФормыВЗначение(ИмяРегистра);
		МенеджерЗаписи[ИмяИзмерения] = ВедущийОбъект;
		МенеджерЗаписи["ЯвляетсяДокументомУдостоверяющимЛичность"] = Истина;
		// если нужно сохранить старую запись, то установим режим замещения - Ложь
		Если Форма[ИмяРегистра + "НоваяЗапись"] Тогда
			НоваяЗапись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(НоваяЗапись,  МенеджерЗаписи);
			НоваяЗапись.Записать();
		Иначе
			МенеджерЗаписи.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//ВОДИТЕЛЬСКОЕ УДОСТОВЕРЕНИЕ

// Инициализация данных формы для редактирования водительского удостоверения
//
// Параметры:
//	Форма - управляемая форма
//	ВедущийОбъект - ссылка на объект, документ которого редактируется в форме
//
// Ограничения:
//	Форма должна содержать реквизиты
//		ВодительскоеУдостоверениеФизическогоЛица
//		ВодительскоеУдостоверениеФизическогоЛицаПрежняя
//		ВодительскоеУдостоверениеФизическогоЛицаНоваяЗапись
// см. также ПрочитатьВодительскоеУдостоверениеДляРедактированияВФорме
Процедура ИнициализироватьВодительскоеУдостоверениеДляРедактированияВФорме(Форма, ВедущийОбъект) Экспорт
	
	МетаданныеРегистра = Метаданные.РегистрыСведений.ДокументыФизическихЛиц;
	МенеджерЗаписи = РегистрыСведений.ДокументыФизическихЛиц.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Физлицо = ВедущийОбъект;
	Форма.ЗначениеВРеквизитФормы(МенеджерЗаписи, "ВодительскоеУдостоверениеФизическогоЛица");
	
	ЗаписьКакСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(МенеджерЗаписи, МетаданныеРегистра);
	Форма.ВодительскоеУдостоверениеФизическогоЛицаПрежняя = Новый ФиксированнаяСтруктура(ЗаписьКакСтруктура);
	
	Форма.ВодительскоеУдостоверениеФизическогоЛицаНоваяЗапись = Ложь;
	
КонецПроцедуры

// Чтение и запись записи водительского удостоверения, подчиненного ведущему объекту 
// для редактирования документа в форме
//
// Параметры:
//	Форма - управляемая форма
//	ВедущийОбъект - ссылка на ведущий объект
//
// Ограничения:
//	Форма должна содержать реквизиты
//		ВодительскоеУдостоверениеФизическогоЛица
//		ВодительскоеУдостоверениеФизическогоЛицаПрежняя
//		ВодительскоеУдостоверениеФизическогоЛицаНоваяЗапись
Процедура ПрочитатьВодительскоеУдостоверениеДляРедактированияВФорме(Форма, ВедущийОбъект) Экспорт
	Если НЕ Форма.Параметры.Ключ.Пустая() Тогда
		ИнициализироватьВодительскоеУдостоверениеДляРедактированияВФорме(Форма, ВедущийОбъект)
	КонецЕсли;
	МетаданныеРегистра = Метаданные.РегистрыСведений.ДокументыФизическихЛиц;
	// Ищем последнюю запись
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РегистрСведений.Период,
	|	РегистрСведений.ВидДокумента
	|ИЗ
	|	РегистрСведений.ДокументыФизическихЛиц КАК РегистрСведений
	|ГДЕ
	|	РегистрСведений.Физлицо = &ВедущийОбъект
	|	И РегистрСведений.ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение)
	|
	|УПОРЯДОЧИТЬ ПО
	|	РегистрСведений.Период УБЫВ");
	Запрос.УстановитьПараметр("ВедущийОбъект", ВедущийОбъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	МенеджерЗаписи = РегистрыСведений.ДокументыФизическихЛиц.СоздатьМенеджерЗаписи();
	Если Выборка.Следующий() Тогда
		МенеджерЗаписи.Период = Выборка.Период;
		МенеджерЗаписи.ВидДокумента = Выборка.ВидДокумента;
		МенеджерЗаписи.Физлицо = ВедущийОбъект;
		МенеджерЗаписи.Прочитать();
	КонецЕсли;
	// имя реквизита формы не совпадает с именем регистра
	Форма.ЗначениеВРеквизитФормы(МенеджерЗаписи, "ВодительскоеУдостоверениеФизическогоЛица");
	
	ЗаписьКакСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(МенеджерЗаписи, МетаданныеРегистра);
	Форма.ВодительскоеУдостоверениеФизическогоЛицаПрежняя = Новый ФиксированнаяСтруктура(ЗаписьКакСтруктура);
	
	Форма.ВодительскоеУдостоверениеФизическогоЛицаНоваяЗапись = Ложь;
	
КонецПроцедуры

// запись записи водительского удостоверения, подчиненных ведущему объекту 
// см. ПрочитатьВодительскоеУдостоверениеДляРедактированияВФорме
Процедура ЗаписатьВодительскоеУдостоверениеПослеРедактированияВФорме(Форма, ВедущийОбъект) Экспорт
	ИмяРеквизита = "ВодительскоеУдостоверениеФизическогоЛица";
	
	ИмяРегистра = "ДокументыФизическихЛиц";
	МетаданныеРегистра = Метаданные.РегистрыСведений.ДокументыФизическихЛиц;
	ИмяИзмерения = "ФизЛицо";

	ИзменилисьДанные = Форма[ИмяРеквизита].Период <> Форма[ИмяРеквизита + "Прежняя"].Период;
	Если НЕ ИзменилисьДанные Тогда
		ИзменилисьДанные = ИзменилисьДанные ИЛИ 
		(ВедущийОбъект <> Форма[ИмяРеквизита + "Прежняя"][ИмяИзмерения] И 
		ЗначениеЗаполнено(Форма[ИмяРеквизита + "Прежняя"][ИмяИзмерения]));
	КонецЕсли;
	Если НЕ ИзменилисьДанные Тогда
		ИзменилисьДанные = ИзменилисьДанные ИЛИ 
		(Форма[ИмяРеквизита].ВидДокумента <> Форма[ИмяРеквизита + "Прежняя"].ВидДокумента);
	КонецЕсли;
	Если НЕ ИзменилисьДанные Тогда
		Для Каждого Поле Из МетаданныеРегистра.Ресурсы Цикл
			ИзменилисьДанные = ИзменилисьДанные ИЛИ (Форма[ИмяРеквизита][Поле.Имя] <> Форма[ИмяРеквизита + "Прежняя"][Поле.Имя]);
		КонецЦикла;
	КонецЕсли;
	Если НЕ ИзменилисьДанные Тогда
		Для Каждого Поле Из МетаданныеРегистра.Реквизиты Цикл
			ИзменилисьДанные = ИзменилисьДанные ИЛИ (Форма[ИмяРеквизита][Поле.Имя] <> Форма[ИмяРеквизита + "Прежняя"][Поле.Имя]);
		КонецЦикла;
	КонецЕсли;
	
	Если ИзменилисьДанные Тогда
		// пишем новое состояние записи
		МенеджерЗаписи = Форма.РеквизитФормыВЗначение(ИмяРеквизита);
		МенеджерЗаписи[ИмяИзмерения] = ВедущийОбъект;
		// если нужно сохранить старую запись, то установим режим замещения - Ложь
		Если Форма[ИмяРеквизита + "НоваяЗапись"] Тогда
			НоваяЗапись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(НоваяЗапись,  МенеджерЗаписи);
			НоваяЗапись.Записать();
		Иначе
			МенеджерЗаписи.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

