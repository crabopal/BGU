Функция ПроверитьДублиКонтрагентаФизЛица(ФИО, ДатаРождения, КонтрагентСсылка) Экспорт
	
	Если НЕ ПравоДоступа("Чтение", Метаданные.Справочники.ФизическиеЛица) Тогда
		Возврат 0;
	КонецЕсли;	
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование = &ФИО
	|	И Контрагенты.ЮридическоеФизическоеЛицо.ДатаРождения = &ДатаРождения
	|	И НЕ Контрагенты.Ссылка = &Ссылка
	|	И Контрагенты.ЭтоГруппа = ЛОЖЬ
	|	И Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)");
	
	Запрос.УстановитьПараметр("ФИО", ФИО);
	Запрос.УстановитьПараметр("ДатаРождения", ДатаРождения);
	Запрос.УстановитьПараметр("Ссылка", КонтрагентСсылка);
	
	Возврат Запрос.Выполнить().Выбрать().Количество();
	
КонецФункции	

