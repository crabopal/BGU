#Область ПрограммныйИнтерфейс

// Отправляет пакеты из очереди в базу МСД ПУиО.
//
Процедура ОтправкаИПолучениеСтатусовПакета() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ОтправкаПакетаВМСД);		
	УстановитьПривилегированныйРежим(Истина); 	
	ИмяСобытия = НСтр("ru='ВыгрузкаДанныхВМСД'", ОбщегоНазначения.КодОсновногоЯзыка());
	МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
	
	Если МодульРаботаВМоделиСервиса.РазделениеВключено() Тогда		
		СписокОбластей = СписокОбластейРазделенныхДанных(); 		
		Для Каждого НомерОбласти Из СписокОбластей Цикл
			
			Попытка	
				Если МодульРаботаВМоделиСервиса.ИспользованиеРазделителяСеанса() Тогда
					МодульРаботаВМоделиСервиса.ВыйтиИзОбластиДанных();
				КонецЕсли;

				МодульРаботаВМоделиСервиса.ВойтиВОбластьДанных(НомерОбласти); 				
				ВыполнитьОтправкуПоОрганизациям(ИмяСобытия);

			Исключение
				Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, СтрШаблон(НСтр("ru='Ошибка при входе в область %1'"), НомерОбласти) + Символы.ПС + Текст);
				Продолжить;
			КонецПопытки;  
						
		КонецЦикла;
	Иначе
		ВыполнитьОтправкуПоОрганизациям(ИмяСобытия);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь); 
	
КонецПроцедуры

Процедура ВыполнитьОтправкуПоОрганизациям(ИмяСобытия) 
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользуетсяИнтеграцияСМСД") Тогда
		Возврат;
	КонецЕсли;

	ФайловоеВзаимодействие = (Константы.ОсновнойСпособПередачиДанныхВМСД.Получить() = Перечисления.СпособыПередачиДанныхВМСД.Файл);
	
	Если ФайловоеВзаимодействие Тогда						
		Возврат;	
	КонецЕсли;
	
	Если НЕ Константы.АвтоматическаяОтправкаПакетовДанныхМСД.Получить() Тогда
		Возврат;	
	КонецЕсли;
	
	ИспользуютсяИнтеграцииЭБ = МодульСбораДанных.ИспользуютсяИнтеграцииЭБ();
		
	ВыборкаДетальныеЗаписи = МодульСбораДанных.ПолучитьВыборкуОрганизаций();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Попытка
			Если ИспользуютсяИнтеграцииЭБ Тогда
				МодульИнтеграции = ОбщегоНазначения.ОбщийМодуль("ИнтеграцииЭБ");
			Иначе
				МодульИнтеграции = ОбщегоНазначения.ОбщийМодуль("ИнтеграцииЕСМВСМЭВ");
			КонецЕсли;
			МодульИнтеграции.ВыполнитьОтправкуВМСД(ВыборкаДетальныеЗаписи.Ссылка);
		Исключение
			Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, СтрШаблон(НСтр("ru='Ошибка при выгрузке данных организации %1'"), ВыборкаДетальныеЗаписи.Представление) + Символы.ПС + Текст);
		КонецПопытки;	
	КонецЦикла;
	
КонецПроцедуры	

// Получает квитанции по отправленным пакетам из базы МСД ПУиО.
//
Процедура ПолучениеСтатусовПакетов() Экспорт
	
	ИмяСобытия = НСтр("ru='ВыгрузкаДанныхВМСД'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	Каталог = "/mnt/msd_files/";
	Файл = Новый Файл(Каталог + "file_src.tx_");
	Если Не Файл.Существует() Тогда
		СоздатьКаталог(Каталог);
		Текст = Новый ЗаписьТекста(Каталог + "file_src.tx_");
		Текст.Закрыть();	
	КонецЕсли; 
	
	УстановитьПривилегированныйРежим(Истина);   		
	
	МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
	
	Если МодульРаботаВМоделиСервиса.РазделениеВключено() Тогда
		
		НомерОбласти = 483;
		МодульРаботаВМоделиСервиса.ВыйтиИзОбластиДанных();
		Попытка	
			МодульРаботаВМоделиСервиса.ВойтиВОбластьДанных(НомерОбласти);
		Исключение 
			Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, СтрШаблон(НСтр("ru='Ошибка при входе в область %1'"), НомерОбласти) + Символы.ПС + Текст);
		КонецПопытки;
		
		Попытка
			ВыполнитьСканированиеКвитанций(Каталог);
		Исключение 
			Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, СтрШаблон(НСтр("ru='Ошибка при получении квитанций в области %1'"), НомерОбласти) + Символы.ПС + Текст);
		КонецПопытки;    
		
	Иначе
		
		Попытка
			ВыполнитьСканированиеКвитанций(Каталог);
		Исключение 
			Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, СтрШаблон(НСтр("ru='Ошибка при получении квитанций в области %1'"), НомерОбласти) + Символы.ПС + Текст);
		КонецПопытки;                                                                                                           
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);   		
	
КонецПроцедуры

// Формирует пакеты для отправки в базу МСД ПУиО.
//
Процедура ФормированиеДанных() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ФормированиеДанныхДляМСД);		
	ИмяСобытия = НСтр("ru='АвтоматическоеФормированиеПакетовДанных'", ОбщегоНазначения.КодОсновногоЯзыка());   		
	МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
	
	Если МодульРаботаВМоделиСервиса.РазделениеВключено() Тогда
		
		СписокОбластей = СписокОбластейРазделенныхДанных(); 		
		Для Каждого НомерОбласти Из СписокОбластей Цикл
			
			Попытка				
				Если МодульРаботаВМоделиСервиса.ИспользованиеРазделителяСеанса() Тогда
					МодульРаботаВМоделиСервиса.ВыйтиИзОбластиДанных();
				КонецЕсли;
				МодульРаботаВМоделиСервиса.ВойтиВОбластьДанных(НомерОбласти);
				
				ВыполнитьФормированиеПоОрганизациям(ИмяСобытия);				
			Исключение
				Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,,Текст);
				Продолжить;				
			КонецПопытки;  
		
		КонецЦикла;		
	Иначе
		ВыполнитьФормированиеПоОрганизациям(ИмяСобытия);
	КонецЕсли;	
	
КонецПроцедуры

// Сверяет сроки предоставления данных и таксономию с базой МСД ПУиО.
//
Процедура СверкаДанных() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.СверкаДанныхСМСД);
	
	ИмяСобытия = НСтр("ru = 'АвтоматическаяСверкаДанныхСМСД'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
	
	Если МодульРаботаВМоделиСервиса.РазделениеВключено() Тогда
		
		СписокОбластей = СписокОбластейРазделенныхДанных(); 
		
		Для Каждого НомерОбласти Из СписокОбластей Цикл
			
			Попытка
				Если МодульРаботаВМоделиСервиса.ИспользованиеРазделителяСеанса() Тогда
					МодульРаботаВМоделиСервиса.ВыйтиИзОбластиДанных();
				КонецЕсли;
				МодульРаботаВМоделиСервиса.ВойтиВОбластьДанных(НомерОбласти);
				
				ВыполнитьСверкуПоОрганизациям(ИмяСобытия);
				
			Исключение
				Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,,Текст);
				Продолжить;
				
			КонецПопытки;		
						
		КонецЦикла;		
	Иначе
		ВыполнитьСверкуПоОрганизациям(ИмяСобытия);
	КонецЕсли;
	
КонецПроцедуры   

Процедура ВыполнитьСверкуПоОрганизациям(ИмяСобытия) 
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользуетсяИнтеграцияСМСД") Тогда
		Возврат;
	КонецЕсли;	
	
	ИспользуютсяИнтеграцииЭБ = МодульСбораДанных.ИспользуютсяИнтеграцииЭБ();
	
	ФайловоеВзаимодействие = (Константы.ОсновнойСпособПередачиДанныхВМСД.Получить() = Перечисления.СпособыПередачиДанныхВМСД.Файл); 
	
	Если ФайловоеВзаимодействие Тогда						
		Возврат;	
	КонецЕсли;
	
	Если НЕ Константы.АвтоматическийЗапросСроковТаксономииМСД.Получить() Тогда
		Возврат;	
	КонецЕсли;
		
	Если ИспользуютсяИнтеграцииЭБ Тогда		
		МодульИнтеграцииЭБ = ОбщегоНазначения.ОбщийМодуль("ИнтеграцииЭБ");	 		
	КонецЕсли; 
	
	ВыборкаОрганизация = МодульСбораДанных.ПолучитьВыборкуОрганизаций();
	
	Пока ВыборкаОрганизация.Следующий() Цикл
		
		ТекущаяДатаСеанса = УниверсальноеВремя(ТекущаяДатаСеанса());
		ТекущаяДата = ТекущаяДатаСеанса();
		ПолучательКодПоРПБС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаОрганизация.Ссылка, "КодПоРПБС"); 
		ДополнительныеПараметры = Новый Структура("ТекущаяДатаСеанса, ТекущаяДата, ПолучательКодПоРПБС", ТекущаяДатаСеанса, ТекущаяДата, ПолучательКодПоРПБС);
		ДополнительныеПараметры.Вставить("Организация", ВыборкаОрганизация.Ссылка);   
		
		СверитьСроки = Истина;
		СверитьТаксономию = Истина;
		
		ПроверитьНеобходимостьСверки(ВыборкаОрганизация.Ссылка, СверитьСроки, СверитьТаксономию);
		
		#Область СверкаСроков
		
		Если СверитьСроки Тогда
			Если ИспользуютсяИнтеграцииЭБ Тогда 
				ПродолжитьВыполнение = МодульИнтеграцииЭБ.СверитьСрокиПредоставления(ИмяСобытия, ДополнительныеПараметры, Истина);
			Иначе
				Если ИнтеграцииЕСМВСМЭВ.ОтправлятьЗапросыНаКлиенте() Тогда
					ИнтеграцииЕСМВСМЭВ.ЗафиксироватьЗаданиеКлиент(ВыборкаОрганизация.Ссылка, "Сроки");
					ПродолжитьВыполнение = Истина;
				Иначе
					ИнтеграцииЕСМВСМЭВ.ОтправитьЗапросНаСверку(ВыборкаОрганизация.Ссылка, "Сроки");
					ПродолжитьВыполнение = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ПродолжитьВыполнение Тогда
				Продолжить;
			КонецЕсли;  	
		КонецЕсли;
		
		#КонецОбласти
		
		#Область СверкаТаксономии 
		
		Если СверитьТаксономию Тогда 

			ДополнительныеПараметры.Вставить("СверитьТаксономию", СверитьТаксономию);
			Результат = МодульСбораДанных.ПодготовитьДанныеДляФормирования(ИмяСобытия, ДополнительныеПараметры, Истина);
			
			Если НЕ Результат.ПродолжитьВыполнение Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЦикла; 
	
	Если ИспользуютсяИнтеграцииЭБ Тогда
		Соединение = Неопределено;
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПолучениеСообщенийМСДИзОчередиЕСМВ() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ОтправкаПакетаВМСД);		
	УстановитьПривилегированныйРежим(Истина); 	
	ИмяСобытия = НСтр("ru='ВыгрузкаДанныхВМСД'", ОбщегоНазначения.КодОсновногоЯзыка());	
	МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
	
	Если МодульРаботаВМоделиСервиса.РазделениеВключено() Тогда		
		СписокОбластей = СписокОбластейРазделенныхДанных(); 		
		Для Каждого НомерОбласти Из СписокОбластей Цикл
			
			Попытка	
				Если МодульРаботаВМоделиСервиса.ИспользованиеРазделителяСеанса() Тогда
					МодульРаботаВМоделиСервиса.ВыйтиИзОбластиДанных();
				КонецЕсли;
			
				МодульРаботаВМоделиСервиса.ВойтиВОбластьДанных(НомерОбласти); 				
				ВыполнитьПолучениеОтветовИзОчередиЕСМВ(ИмяСобытия);
			Исключение
				Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, СтрШаблон(НСтр("ru='Ошибка при входе в область %1'"), НомерОбласти) + Символы.ПС + Текст);
				Продолжить;
			КонецПопытки;			
		КонецЦикла;
	Иначе
		ВыполнитьПолучениеОтветовИзОчередиЕСМВ(ИмяСобытия);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);   
	
КонецПроцедуры

Процедура ВыполнитьПолучениеОтветовИзОчередиЕСМВ(ИмяСобытия) 
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользуетсяИнтеграцияСМСД") Тогда
		Возврат;
	КонецЕсли;

	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() 
		ИЛИ НЕ Константы.ОсновнойСпособПередачиДанныхВМСД.Получить() = Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ Тогда					
		Возврат;	
	КонецЕсли;
	
	Если Константы.СторонаЗапросовОтправкиПакетовЕСМВСМЭВ.Получить() = Перечисления.СтороныВыполненияЗапросовЕСМВСМЭВ.Клиент
		И Константы.СторонаЗапросовСроковТаксономииЕСМВСМЭВ.Получить() = Перечисления.СтороныВыполненияЗапросовЕСМВСМЭВ.Клиент Тогда					
		Возврат;	
	КонецЕсли;
		
	ВыборкаОрганизация = МодульСбораДанных.ПолучитьВыборкуОрганизаций();
	
	Пока ВыборкаОрганизация.Следующий() Цикл
		
		Попытка			
			МодульИнтеграции = ОбщегоНазначения.ОбщийМодуль("ИнтеграцииЕСМВСМЭВ");
			МодульИнтеграции.ПолучитьОтветыИзОчередиЕСМВ(ВыборкаОрганизация.Ссылка, ""); 			
		Исключение
			Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, НСтр("ru='Ошибка при получении ответов из очереди ЕСМВ'") + Символы.ПС + Текст);
		КонецПопытки;	
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьФормированиеПоОрганизациям(ИмяСобытия)
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользуетсяИнтеграцияСМСД") Тогда
		Возврат;
	КонецЕсли;
	
	МассивАктивныхЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("ИмяМетода, Состояние", "ОбработчикиРегламентныхЗаданийМСД.ФормированиеДанных", СостояниеФоновогоЗадания.Активно));
	
	Если МассивАктивныхЗаданий.Количество() Тогда
		Возврат;	
	КонецЕсли;

	ФайловоеВзаимодействие = (Константы.ОсновнойСпособПередачиДанныхВМСД.Получить() = Перечисления.СпособыПередачиДанныхВМСД.Файл);
	
	Если ФайловоеВзаимодействие Тогда						
		Возврат;	
	КонецЕсли;
	
	Если НЕ Константы.АвтоматическоеФормированиеПакетовДанныхМСД.Получить() Тогда
		Возврат;	
	КонецЕсли;
	
	ИспользуютсяИнтеграцииЭБ = МодульСбораДанных.ИспользуютсяИнтеграцииЭБ();
	
	Если ИспользуютсяИнтеграцииЭБ Тогда		
		МодульИнтеграцииЭБ = ОбщегоНазначения.ОбщийМодуль("ИнтеграцииЭБ");		
	КонецЕсли;
	
	ВыборкаОрганизация = МодульСбораДанных.ПолучитьВыборкуОрганизаций();
	
	Пока ВыборкаОрганизация.Следующий() Цикл
		
		ТекущаяДатаСеанса = УниверсальноеВремя(ТекущаяДатаСеанса());
		ТекущаяДата = ТекущаяДатаСеанса();
		ПолучательКодПоРПБС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаОрганизация.Ссылка, "КодПоРПБС"); 
		
		ДополнительныеПараметры = Новый Структура("ТекущаяДатаСеанса, ТекущаяДата, ПолучательКодПоРПБС", ТекущаяДатаСеанса, ТекущаяДата, ПолучательКодПоРПБС); 
		ДополнительныеПараметры.Вставить("Организация", ВыборкаОрганизация.Ссылка); 
		
		СверитьСроки = Истина;
		СверитьТаксономию = Истина;	
		
		ПроверитьНеобходимостьСверки(ВыборкаОрганизация.Ссылка, СверитьСроки, СверитьТаксономию);
		
		#Область СверкаСроков
		
		Если СверитьСроки Тогда
			Если ИспользуютсяИнтеграцииЭБ Тогда 
				ПродолжитьВыполнение = МодульИнтеграцииЭБ.СверитьСрокиПредоставления(ИмяСобытия, ДополнительныеПараметры);
			Иначе
				Если ИнтеграцииЕСМВСМЭВ.ОтправлятьЗапросыНаКлиенте() Тогда
					ИнтеграцииЕСМВСМЭВ.ЗафиксироватьЗаданиеКлиент(ВыборкаОрганизация.Ссылка, "Сроки");
					ПродолжитьВыполнение = Истина;
				Иначе	
					ИнтеграцииЕСМВСМЭВ.ОтправитьЗапросНаСверку(ВыборкаОрганизация.Ссылка, "Сроки");
					ПродолжитьВыполнение = Ложь; 
				КонецЕсли;
			КонецЕсли;
			Если НЕ ПродолжитьВыполнение Тогда  
				Продолжить;	
			КонецЕсли;  
		КонецЕсли;
		
		#КонецОбласти
		
		#Область СверкаТаксономии 
		
		ДополнительныеПараметры.Вставить("СверитьТаксономию", СверитьТаксономию);
		Результат = МодульСбораДанных.ПодготовитьДанныеДляФормирования(ИмяСобытия, ДополнительныеПараметры);
		
		Если НЕ Результат.ПродолжитьВыполнение Тогда
			Продолжить;
		КонецЕсли;
		
		#КонецОбласти 
		
		#Область ФормированиеПакета 
		
		МодульПользователи = ОбщегоНазначения.ОбщийМодуль("Пользователи");
		АвторизованныйПользователь = МодульПользователи.АвторизованныйПользователь();
				
		Для каждого ВыборкаДетальныеЗаписи Из Результат.ТаблицаДляПреобразования Цикл
			
			ОтчетныеДанные = (ВыборкаДетальныеЗаписи.ПериодичностьСсылка = Перечисления.ПериодичностьМСД.Месяц);
			
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,,
			СтрШаблон(НСтр("ru='Обработка отчетного периода: %1 - начало'"), ВыборкаДетальныеЗаписи.ПредставлениеПериода));
			
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, ,,НСтр("ru='Формирования выгрузки - начало'"));
			
			Если ВыборкаДетальныеЗаписи.ПериодДанных = Неопределено Тогда
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, ,,НСтр("ru='Не указан период выгрузки'"));
				Продолжить;
			КонецЕсли;
						
			НовыйДокументОбъект = Документы.ПакетыДанныхДляМСД.СоздатьДокумент();
			НовыйДокументОбъект.Дата = ТекущаяДатаСеанса();
			НовыйДокументОбъект.Организация = ВыборкаОрганизация.Ссылка;
			ДанныеОТаксономии = ОбщегоНазначенияМСД.ТекущаяВерсияТаксономии(ВыборкаДетальныеЗаписи.ДатаОкончания, ДополнительныеПараметры.Организация);
			Если НЕ ДанныеОТаксономии = Неопределено Тогда 
				НовыйДокументОбъект.ВерсияТаксономии = ДанныеОТаксономии.Версия;
				НовыйДокументОбъект.ДатаУтвержденияТаксономии = ДанныеОТаксономии.ДатаУтверждения;
			КонецЕсли;	
			НовыйДокументОбъект.ВидПередаваемыхДанных = ОтчетныеДанные;
			НовыйДокументОбъект.НачалоПериода = ВыборкаДетальныеЗаписи.ДатаНачала;
			НовыйДокументОбъект.ОкончаниеПериода = ВыборкаДетальныеЗаписи.ДатаОкончания;
			НовыйДокументОбъект.Год = НачалоГода(ВыборкаДетальныеЗаписи.ДатаНачала);
			НовыйДокументОбъект.СозданАвтоматически = Истина;
			НовыйДокументОбъект.СпособПередачи = Истина;
			НовыйДокументОбъект.Записать();
			
			ИдентификаторПакета = Новый УникальныйИдентификатор;
			
			Коды = МодульСбораДанныхПовтИсп.КодыПоРПБС(НовыйДокументОбъект.Организация);
			ИмяПакета =  СтрШаблон("%1_%2_%3_%4_%5_%6", Коды.КодГлавы,
			Коды.КодПоРПБС,
			Число(ОтчетныеДанные),
			?(ОтчетныеДанные, Формат(НовыйДокументОбъект.ОкончаниеПериода, НСтр("ru='ДФ=''yyyyMM'''")), СтрШаблон(НСтр("ru='%1-%2'"), Формат(НовыйДокументОбъект.НачалоПериода, НСтр("ru='ДФ=''yyyyMMdd'''")), Формат(НовыйДокументОбъект.ОкончаниеПериода, НСтр("ru='ДФ=''yyyyMMdd'''")))),
			"0",
			"01-01");
			
			ТекущаяДатаСеанса = УниверсальноеВремя(ТекущаяДатаСеанса());
			ЗаписьНачало = РегистрыСведений.ПакетыДанныхМСД.СоздатьМенеджерЗаписи();
			ЗаписьНачало.Период = ТекущаяДатаСеанса;
			ЗаписьНачало.ИдентификаторПакета = ИдентификаторПакета;
			ЗаписьНачало.Пакет = НовыйДокументОбъект.Ссылка;
			ЗаписьНачало.Организация = НовыйДокументОбъект.Организация;		
			
			ЗаписьНачало.ИмяПакета = ИмяПакета;
			ЗаписьНачало.ВидПередаваемыхДанных = ОтчетныеДанные;
			ЗаписьНачало.ПериодСтрокой = ?(ОтчетныеДанные, Формат(НовыйДокументОбъект.ОкончаниеПериода, НСтр("ru='ДФ=''MMMM yyyy'''")), СтрШаблон(НСтр("ru='с %1 по %2'"), Формат(НовыйДокументОбъект.НачалоПериода, "ДЛФ=ДД"), Формат(НовыйДокументОбъект.ОкончаниеПериода, "ДЛФ=ДД")));
			
			ТребуетсяПодпись = ?(ОтчетныеДанные, Константы.ПодписыватьОтчетныеДанныеДляМСД.Получить(), Константы.ПодписыватьОперативныеДанныеДляМСД.Получить());
			ЗаписьНачало.СпособПередачи = НЕ ТребуетсяПодпись;
			ЗаписьНачало.Статус = Перечисления.СтатусыПакетовМСД.Формирование;
			ЗаписьНачало.ДатаСтатуса = ТекущаяДатаСеанса;
			
			ЗаписьНачало.ПолноеИмяФайла = ИмяПакета + ".zip";
			ЗаписьНачало.Записать(Истина);
			
			АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено);
			ПараметрыПроцедуры = Новый Структура;
			ПараметрыПроцедуры.Вставить("ВидПередаваемыхДанных", НовыйДокументОбъект.ВидПередаваемыхДанных);
			ПараметрыПроцедуры.Вставить("НачалоПериода", НовыйДокументОбъект.НачалоПериода);
			ПараметрыПроцедуры.Вставить("ОкончаниеПериода", НовыйДокументОбъект.ОкончаниеПериода);
			ПараметрыПроцедуры.Вставить("АдресРезультата", АдресРезультата);
			ПараметрыПроцедуры.Вставить("ДокументСсылка", НовыйДокументОбъект.Ссылка);
			ПараметрыПроцедуры.Вставить("ВерсияТаксономии", НовыйДокументОбъект.ВерсияТаксономии); 
			ПараметрыПроцедуры.Вставить("Организация", НовыйДокументОбъект.Организация);
			
			Попытка
				Документы.ПакетыДанныхДляМСД.ВыполнитьВыгрузку(ПараметрыПроцедуры, АдресРезультата);
			Исключение 
				ТекстОшибки = ОписаниеОшибки();
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);			
				
				ТекущаяДатаСеанса = УниверсальноеВремя(ТекущаяДатаСеанса());
				ЗаписьОшибка = РегистрыСведений.ПакетыДанныхМСД.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(ЗаписьОшибка, ЗаписьНачало);
				ЗаписьОшибка.Период = ТекущаяДатаСеанса;			
				ЗаписьОшибка.Статус = Перечисления.СтатусыПакетовМСД.ОшибкаОбработки;
				ЗаписьОшибка.ОписаниеОшибки = ТекстОшибки;
				ЗаписьОшибка.ДатаСтатуса = ТекущаяДатаСеанса;
				ЗаписьОшибка.Записать(Истина); 
			КонецПопытки;	
			
			РазделительПути = ПолучитьРазделительПути();
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
			Файл = Новый Файл(ИмяВременногоФайла);
			Каталог = СтрЗаменить(ИмяВременногоФайла, Файл.Имя, "") + XMLСтрока(Новый УникальныйИдентификатор) + РазделительПути;
			СоздатьКаталог(Каталог); 
			
			МассивФайлов = ПолучитьИзВременногоХранилища(АдресРезультата).Получить();
			Если Не ТипЗнч(МассивФайлов) = Тип("Массив") Тогда
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, ,,НСтр("ru='В результате нет файлов'"));
				Продолжить;
			КонецЕсли;
						
			Для Каждого ДанныеФайла Из МассивФайлов Цикл
				Для Каждого ЭлементСтруктуры Из ДанныеФайла Цикл
					ДД = ДанныеФайла[ЭлементСтруктуры.Ключ];
					ДД.Записать(Каталог + ЭлементСтруктуры.Ключ + ".xml");
				КонецЦикла;
			КонецЦикла;
			
			ЗИПФайл = Новый ЗаписьZipФайла();
			ЗИПФайл.Добавить(Каталог + "*.xml");
			ДДАрхива = ЗИПФайл.ПолучитьДвоичныеДанные();
			
			МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
			ПараметрыФайла = МодульРаботаСФайлами.ПараметрыДобавленияФайла();
			ПараметрыФайла.Автор = АвторизованныйПользователь;
			ПараметрыФайла.ВладелецФайлов = НовыйДокументОбъект.Ссылка;
			ПараметрыФайла.ИмяБезРасширения = ИмяПакета;
			
			ПоместитьВоВременноеХранилище(ДДАрхива, АдресРезультата);
			ПараметрыФайла.РасширениеБезТочки = "zip";
			
			МодульРаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресРезультата);
			УдалитьИзВременногоХранилища(АдресРезультата);
			УдалитьФайлы(Каталог);
			
			ТекущаяДатаСеанса = УниверсальноеВремя(ТекущаяДатаСеанса());
			ЗаписьКонец = РегистрыСведений.ПакетыДанныхМСД.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ЗаписьКонец, ЗаписьНачало);
			ЗаписьКонец.Период = ТекущаяДатаСеанса;
			ЗаписьКонец.ДатаФормирования = ТекущаяДатаСеанса;			
			
			Хеш = Новый ХешированиеДанных(ХешФункция.SHA1);
			Хеш.Добавить(ДДАрхива);			
			ЗаписьКонец.КонтрольнаяСумма = НРег(СтрЗаменить(Хеш.ХешСумма, " ", ""));
			ЗаписьКонец.Статус = Перечисления.СтатусыПакетовМСД.Сформирован;
			ЗаписьКонец.ДатаСтатуса = ТекущаяДатаСеанса;
			ЗаписьКонец.Записать(Истина); 
			
			Если ТребуетсяПодпись Тогда 
				ЗаписьНаПодписании = РегистрыСведений.ПакетыДанныхМСД.СоздатьМенеджерЗаписи();	
				ЗаполнитьЗначенияСвойств(ЗаписьНаПодписании, ЗаписьКонец); 
				ЗаписьНаПодписании.Период = ЗаписьНаПодписании.Период + 1; 
				ЗаписьНаПодписании.Статус = Перечисления.СтатусыПакетовМСД.НаПодписании1Подписью; 
				ЗаписьНаПодписании.ДатаСтатуса = ЗаписьНаПодписании.Период;
                ЗаписьНаПодписании.Записать(Истина);
			КонецЕсли;
			
			ЗапуститьФормированиеТабличныхДокументов(НовыйДокументОбъект.Ссылка, ИмяПакета);
		
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,, НСтр("ru='Формирования выгрузки - конец'"));			
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,, СтрШаблон(НСтр("ru='Обработка отчетного периода: %1 - конец'"), ВыборкаДетальныеЗаписи.ПредставлениеПериода));
			
		КонецЦикла;			
		#КонецОбласти				
	КонецЦикла;
	
	Если ИспользуютсяИнтеграцииЭБ Тогда
		Соединение = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьСканированиеКвитанций(Каталог)
	// сканер
	ФайлыСтатусов = НайтиФайлы(Каталог, "*.xml");
	
	Для Каждого текФайл Из ФайлыСтатусов Цикл    
		
		НачатьТранзакцию();
		
		Попытка
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ПакетыДанныхМСД");
			ЭлементБлокировкиДанных.УстановитьЗначение("ИмяПакета", текФайл.ИмяБезРасширения);
			ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
			БлокировкаДанных.Заблокировать();
			
			Набор = РегистрыСведений.ПакетыДанныхМСД.СоздатьНаборЗаписей();
			Набор.Отбор.ИмяПакета.Установить(текФайл.ИмяБезРасширения);
			Набор.Прочитать();
			Если Не Набор.Количество() = 0 Тогда
				Запись = Набор[0];
				
				ЧтениеXML = Новый ЧтениеXML;
				ЧтениеXML.ОткрытьФайл(текФайл.ПолноеИмя);
				ОбъектTicket = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML); 
				Запись.Статус = Перечисления.СтатусыПакетовМСД[ОбъектTicket.Status];  
				Запись.ДатаСтатуса = XMLЗначение(Тип("Дата"), ОбъектTicket.Date);
				Запись.ОписаниеОшибки = ОбъектTicket.ErrorText;
				Набор.Записать(Истина);   
				ЧтениеXML = Неопределено;
			КонецЕсли;  
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'СканированиеКвитанцийМСД'", ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ВызватьИсключение;	
		КонецПопытки;				
	КонецЦикла;
	
	УдалитьФайлы(Каталог, "*.xml");
	
КонецПроцедуры

Функция СписокОбластейРазделенныхДанных()
	
	Если Метаданные.РегистрыСведений.Найти("ОбластиДанных") = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ОбластиДанных.ОбластьДанныхВспомогательныеДанные КАК НомерОбласти
	|ИЗ
	|	РегистрСведений.ОбластиДанных КАК ОбластиДанных
	|ГДЕ
	|	ОбластиДанных.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОбластейДанных.Используется)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерОбласти"); 
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НомерОбласти");
	
КонецФункции 

// Получает данные о сверке на текущий день.
//
// Параметры:
//  СверитьСроки - Булево
//  СверитьТаксономию - Булево
//
Процедура ПроверитьНеобходимостьСверки(Организация, СверитьСроки = Ложь, СверитьТаксономию = Ложь) Экспорт
	
	ТипСроки = Перечисления.ТипыСообщенийМСД.СрокиПредоставления;
	ТипТаксономия = Перечисления.ТипыСообщенийМСД.Таксономия;
	
	ТипыСообщений = Новый Массив;
	ТипыСообщений.Добавить(ТипСроки);
	ТипыСообщений.Добавить(ТипТаксономия);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗапросыНаСверкуДанныхМСДСрезПоследних.ТипСообщения КАК ТипСообщения,
	|	ЗапросыНаСверкуДанныхМСДСрезПоследних.Статус КАК Статус,
	|	ЗапросыНаСверкуДанныхМСДСрезПоследних.Период КАК Период
	|ИЗ
	|	РегистрСведений.ЗапросыНаСверкуДанныхМСД.СрезПоследних(
	|			,
	|			Организация = &Организация
	|				И ТипСообщения В (&ТипыСообщений)) КАК ЗапросыНаСверкуДанныхМСДСрезПоследних";
	
	Запрос.УстановитьПараметр("ТипыСообщений", ТипыСообщений);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Сегодня = НачалоДня(УниверсальноеВремя(ТекущаяДатаСеанса()));	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		Если ВыборкаДетальныеЗаписи.Статус = Перечисления.СтатусыСверкиМСД.Совпадает И НачалоДня(ВыборкаДетальныеЗаписи.Период) = Сегодня Тогда
			Если ВыборкаДетальныеЗаписи.ТипСообщения = ТипСроки Тогда
				СверитьСроки = Ложь;
			Иначе
				СверитьТаксономию = Ложь;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗапуститьФормированиеТабличныхДокументов(ДокументСсылка, ИмяПакета)
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ДокументСсылка", ДокументСсылка);
	ПараметрыПроцедуры.Вставить("ИмяПакета", ИмяПакета);
	
	УникальныйИдентификатор = Новый УникальныйИдентификатор;
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
		
	МодульДлительныеОперации = ОбщегоНазначения.ОбщийМодуль("ДлительныеОперации");
	ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "СформироватьТабличныеДокументыМСД";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ДополнительныйРезультат = Ложь;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.АдресРезультата = АдресРезультата;
	
	РезультатФоновогоЗадания = МодульДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "Документы.ПакетыДанныхДляМСД.СформироватьТабличныеДокументы", ПараметрыПроцедуры, АдресРезультата);

КонецПроцедуры

