Процедура ДополнитьПараметрыВыбораСогласованныхАналитик(ДеревоТипов) Экспорт 
	
	////////////////////////////////////////////////////////////////////////////////
	// контрагент + глава по бк
	
	НоваяСтрока = ДеревоТипов.Строки.Добавить();
	НоваяСтрока.ТипДанных 	 = Тип("СправочникСсылка.Контрагенты");
	НоваяСтрока.ФормаВыбора = "";
	БюджетнаяОтчетность.ДобавитьСвязьВыбора(НоваяСтрока, "ЮридическоеФизическоеЛицо.КодПоППП", 1, Тип("СправочникСсылка.ГлавыПоБюджетнойКлассификации"));
	
	НоваяСтрока2 = НоваяСтрока.Строки.Добавить();
	НоваяСтрока2.ТипДанных 	 = Тип("СправочникСсылка.ГлавыПоБюджетнойКлассификации");
	НоваяСтрока2.ФормаВыбора = "";
		
	// контрагент + глава + бюджет + ЭБ
	
	НоваяСтрока = ДеревоТипов.Строки.Добавить();
	НоваяСтрока.ТипДанных 	 = Тип("СправочникСсылка.Контрагенты");
	НоваяСтрока.ФормаВыбора = "";
	БюджетнаяОтчетность.ДобавитьСвязьВыбора(НоваяСтрока, "ЮридическоеФизическоеЛицо.КодПоППП", 1, Тип("СправочникСсылка.ГлавыПоБюджетнойКлассификации"));
	БюджетнаяОтчетность.ДобавитьСвязьВыбора(НоваяСтрока, "ЮридическоеФизическоеЛицо.КодПоППП.Бюджет", 2, Тип("СправочникСсылка.Бюджеты"));
	БюджетнаяОтчетность.ДобавитьСвязьВыбора(НоваяСтрока, "ЮридическоеФизическоеЛицо.КодПоППП.Бюджет.Элемент", 3, Тип("СправочникСсылка.ЭлементыБюджета"));
	
	СтрГлава = НоваяСтрока.Строки.Добавить();
	СтрГлава.ТипДанных 	 = Тип("СправочникСсылка.ГлавыПоБюджетнойКлассификации");
	СтрГлава.ФормаВыбора = "";		
	БюджетнаяОтчетность.ДобавитьСвязьВыбора(СтрГлава, "Бюджет", 1, Тип("СправочникСсылка.Бюджеты"));
	БюджетнаяОтчетность.ДобавитьСвязьВыбора(СтрГлава, "Бюджет.Элемент", 2, Тип("СправочникСсылка.ЭлементыБюджета"));
	
	// Бюджет
	СтрБюджет 			  = СтрГлава.Строки.Добавить();
	СтрБюджет.ТипДанных   = Тип("СправочникСсылка.Бюджеты");
	СтрБюджет.ФормаВыбора = "";
	БюджетнаяОтчетность.ДобавитьСвязьВыбора(СтрБюджет, "Элемент", 1, Тип("СправочникСсылка.ЭлементыБюджета"));
	
КонецПроцедуры	

