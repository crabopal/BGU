

Функция ПройтиАвторизацию(Организация, ГУИДАвторизации, НастройкиУчастника, ТребуетсяРасшифровка=Ложь) Экспорт
	//В ЕБП токен действует 24 часа, 86400 секунд.
	//На всякий случай ограничим время, после которого будем авторизоваться повторно как 23 часа (23*60*60 = 82800).
	
	//Сейчас в ЕБП есть проблема с обменом, если авторизация была давно, поэтому пока авторизоваться будем всегда.
	//Прошлое значение времени жизни токена - 82800
	
	ВремяЖизниТокена = 0;//82800;
	Возврат ИнтеграцияЕСМВ.ПройтиАвторизациюЕСМВ(Организация, НастройкиУчастника, ГУИДАвторизации, ВремяЖизниТокена, ТребуетсяРасшифровка);
КонецФункции 

Процедура ЗаписатьРасшифрованныйТокен(РасшифрованныеДанные, Организация, ГУИДАвторизации, ТокенАвторизации) Экспорт 
	
	Если ТипЗнч(РасшифрованныеДанные) = Тип("Строка") Тогда
		//адрес временного хранилища
		ДД = ПолучитьИзВременногоХранилища(РасшифрованныеДанные);
	Иначе
		ДД = РасшифрованныеДанные;
	КонецЕсли;
	
	Поток = ДД.ОткрытьПотокДляЧтения();
	ЧтениеТекста = Новый ЧтениеТекста(Поток);
	ТокенАвторизации = ЧтениеТекста.Прочитать();
	
	ТипТокена = ИнтеграцияЕСМВКлиентСервер.ТипАвторизацииТокена();
	// При обмене с ЕСМВ используется тип авторизации Bearer, он должен быть указан в токене.
	// Укажем сами, если он не указан:
	Если СтрНайти(ТокенАвторизации, ТипТокена) = 0 Тогда
		ТокенАвторизации = ТипТокена + ТокенАвторизации;
	КонецЕсли;  
   
	ЗаписьСообщенияАвторизации = РегистрыСведений.СообщенияАвторизацииЕСМВ.СоздатьМенеджерЗаписи();
	ЗаписьСообщенияАвторизации.Организация = Организация;
	ЗаписьСообщенияАвторизации.ГУИДАвторизации = ГУИДАвторизации;
	ЗаписьСообщенияАвторизации.Прочитать();
	Если ЗаписьСообщенияАвторизации.Выбран() Тогда
		ЗаписьСообщенияАвторизации.ТокенАвторизации = ТокенАвторизации;
		ЗаписьСообщенияАвторизации.Записать();
	КонецЕсли;  
	
КонецПроцедуры 

Процедура ЗаписатьОшибкуРасшифровки(Организация, ГУИДАвторизации, ТекстОшибки) Экспорт
	ЗаписьСообщенияАвторизации = РегистрыСведений.СообщенияАвторизацииЕСМВ.СоздатьМенеджерЗаписи();
	ЗаписьСообщенияАвторизации.Организация = Организация;
	ЗаписьСообщенияАвторизации.ГУИДАвторизации = ГУИДАвторизации;
	ЗаписьСообщенияАвторизации.Прочитать();
	Если ЗаписьСообщенияАвторизации.Выбран() Тогда
		ЗаписьСообщенияАвторизации.ЕстьОшибка = Истина;
		ЗаписьСообщенияАвторизации.ТекстОшибки = ТекстОшибки;
		ЗаписьСообщенияАвторизации.Записать();
	КонецЕсли;
КонецПроцедуры   

