// ПРОГРАММНЫЙ ИНТЕРФЕЙС

//ПомощникЗагрузкиФорматовОбменаБанкиКС

Процедура ЗагрузкаДанныхВФорматеXMLВОбщемМодуле(Параметры,АдресВХранилище) Экспорт
	
	СтруктураРезультата = Новый Структура;
	Попытка
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Параметры.РасширениеФайла);
		ДвоичныеДанныеФайла = Параметры.ДвоичныеДанныеФайлаОбмена;
		ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
		ДвоичныеДанныеФайла = Неопределено;
				
		УниверсальнаяЗагрузкаДанных = Обработки.УниверсальныйОбменДаннымиXML.Создать();
		УниверсальнаяЗагрузкаДанных.РежимОбмена	= "Загрузка";
		ЗаполнитьЗначенияСвойств(УниверсальнаяЗагрузкаДанных,Параметры.СписокСвойствПереноса);
		
		ИмяВременногоФайлаПротоколаОбмена = ПолучитьИмяВременногоФайла("txt");
		УниверсальнаяЗагрузкаДанных.ВыводВПротоколСообщенийОбОшибках = Истина;
		УниверсальнаяЗагрузкаДанных.ИмяФайлаПротоколаОбмена = ИмяВременногоФайлаПротоколаОбмена;
		УниверсальнаяЗагрузкаДанных.ИмяФайлаОбмена = ИмяВременногоФайла;
		
		УниверсальнаяЗагрузкаДанных.РежимОтладкиАлгоритмов = 2;
		УниверсальнаяЗагрузкаДанных.ФлагРежимОтладкиОбработчиков = Истина;
		УниверсальнаяЗагрузкаДанных.ФлагРежимОтладки = Истина;
		УниверсальнаяЗагрузкаДанных.ИмяФайлаВнешнейОбработкиОбработчиковСобытий = "ПереносДанныхИзБГУ1";
		
		УниверсальнаяЗагрузкаДанных.ВыполнитьЗагрузку();

		Если УниверсальнаяЗагрузкаДанных.ФлагОшибки Тогда
			
			ТекстПредупреждения = НСтр("ru = 'При загрузке данных произошли ошибки.'");
			ФайлЗагружен = Ложь;
			
		Иначе
		
			ТекстПредупреждения =  НСтр("ru = 'Загрузка данных выполнена успешно.'");
			ФайлЗагружен = Истина;
			
		КонецЕсли;

	Исключение
		
		ТекстПредупреждения = НСтр("ru = 'При загрузке данных произошли ошибки. "+ОписаниеОшибки()+"'");
		ФайлЗагружен = Ложь;

	КонецПопытки;
	
	ЧтениеТекста = Новый ЧтениеТекста(ИмяВременногоФайлаПротоколаОбмена);
	ПротоколОбмена = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	ТекстПредупреждения = Параметры.ИмяИсходногоФайла + Символы.ПС + ТекстПредупреждения;  
	ПротоколОбмена = Параметры.ИмяИсходногоФайла + Символы.ПС + ПротоколОбмена;
	
	СтруктураРезультата.Вставить("Результат", ТекстПредупреждения);
	СтруктураРезультата.Вставить("ПротоколОбмена", ПротоколОбмена);
	СтруктураРезультата.Вставить("ИмяИсходногоФайла", Параметры.ИмяИсходногоФайла);
	СтруктураРезультата.Вставить("ФайлЗагружен", ФайлЗагружен);
	ПоместитьВоВременноеХранилище(СтруктураРезультата,АдресВХранилище);
	
КонецПроцедуры
