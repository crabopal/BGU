#Область СлужебныеПроцедурыИФункции  

Процедура УдалитьBOMСимволы(Данные, Кодировка)
	
	// Символы BOM могут быть только в кодировке Unicode
	Если Кодировка = "UTF8" И Сред(Данные, 1, 8) = "EF BB BF" Тогда
		Строка64 = Base64Строка(Данные);
		Строка64 = Прав(Строка64,СтрДлина(Строка64)-4); // Удаляем 3 символа BOM
		Данные = Base64Значение(Строка64);
	ИначеЕсли Кодировка = "UTF16" Тогда
		ПервыеСимволы = Сред(Данные, 1, 5);
		Если ПервыеСимволы = "FE FF" Или ПервыеСимволы = "FF FE" Тогда
			Строка64 = Base64Строка(Данные);
			Строка64 = Прав(Строка64,СтрДлина(Строка64)-3); // Удаляем 2 символа BOM
			Данные = Base64Значение(Строка64);			
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьЗаголовкиФайловПоЗаданию(ЗаданиеСсылка, Файлы, ДопПараметры)
	
	ЗаголовкиФайлов = Новый Соответствие;
	
	СпособОбмена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаданиеСсылка.НастройкаОбмена, "СпособОбмена");
	Если СпособОбмена <> Перечисления.СпособыВыгрузкиФайловПередачи.WebСервис Тогда
		Возврат ЗаголовкиФайлов;
	КонецЕсли;
	
	ОбщиеЗаголовки = Новый Соответствие;
	ОбщиеЗаголовки.Вставить("Connection", "Keep-Alive");
	ОбщиеЗаголовки.Вставить("Content-Type", "text/xml; charset=utf-8");	
	
	ЗаголовкиНастройки = Новый Соответствие;
	Для Каждого КлючИЗначение Из ДопПараметры Цикл
		Если ВРег(Лев(КлючИЗначение.Ключ,10)) = "ЗАГОЛОВОК." Тогда
			ЗаголовкиНастройки.Вставить(Сред(КлючИЗначение.Ключ,11),КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.ИмяФайлаВыгрузки,
	               |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Формат
	               |ИЗ
	               |	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена
	               |ГДЕ
	               |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка = &Задание";
				   
	Запрос.УстановитьПараметр("Задание", ЗаданиеСсылка);
	Объекты = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Файл Из Файлы Цикл
		
		ЗаголовкиФайла = Новый Соответствие;
		
		// Общие заголовки
		Для Каждого ОбщийЗаголовок Из ОбщиеЗаголовки Цикл
			ЗаголовкиФайла.Вставить(ОбщийЗаголовок.Ключ, ОбщийЗаголовок.Значение);
		КонецЦикла;
		
		// Заголовки форматов
		Для Каждого Объект Из Объекты Цикл
			ЧастиИмени = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(Объект.ИмяФайлаВыгрузки);
			Если Найти(Файл.Наименование, ЧастиИмени.ИмяБезРасширения) > 0 Тогда
				Заголовки = Объект.Формат.Заголовки;
				Для Каждого СтрокаЗаголовка Из Заголовки Цикл
					ЗаголовкиФайла.Вставить(СтрокаЗаголовка.Заголовок, СтрокаЗаголовка.Значение);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		// Заголовки настройки
		Для Каждого ЗаголовокНастройки Из ЗаголовкиНастройки Цикл
			ЗаголовкиФайла.Вставить(ЗаголовокНастройки.Ключ, ЗаголовокНастройки.Значение);
		КонецЦикла;
		
		ЗаголовкиФайлов.Вставить(Файл, ЗаголовкиФайла);
		
	КонецЦикла;
	
	Возврат ЗаголовкиФайлов; 
	
КонецФункции

#КонецОбласти
