
#Область ПрограммныйИнтерфейс

Функция ПолучитьПрокси(Протокол) Экспорт
	
	Прокси                               = Неопределено;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПолучениеФайловИзИнтернета") Тогда
		МодульПолучениеФайловИзИнтернета = ОбщегоНазначения.ОбщийМодуль("ПолучениеФайловИзИнтернета");
		Прокси                           = МодульПолучениеФайловИзИнтернета.ПолучитьПрокси(Протокол);
	КонецЕсли;
	
	Возврат Прокси;
	
КонецФункции

Функция ПолучитьНастройкиПроксиНаКлиенте() Экспорт
	Возврат ПолучениеФайловИзИнтернета.НастройкиПроксиНаКлиенте();		
КонецФункции

Функция ПолучитьПрикрепленныеФайлыЗаданияНаЭкспорт(Знач ЗаданиеСсылка) Экспорт
	Перем МассивФайлов;
	МассивФайлов = Новый Массив;
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ЗаданиеСсылка, МассивФайлов);
	Возврат МассивФайлов;
КонецФункции

Функция ПолучитьИмяВременногоФайлаНаКлиенте() Экспорт
	Возврат ПолучитьИмяВременногоФайла("clax");	
КонецФункции

Процедура ИзменитьСтатусПРДВыгруженныхДокументов(ЗаданиеСсылка,СписокТиповДляОповещений) Экспорт
	ТипДокументов = Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Измерения.ПлатежноРасчетныйДокумент.Тип;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Объект,
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Описание,
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.ИмяФайлаВыгрузки,
		|	ВЫРАЗИТЬ(ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Объект КАК Документ.КвитанцияНаОплатуГосуслуг).ВидКвитанции КАК ВидКвитанции
		|ИЗ
		|	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена
		|ГДЕ
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", ЗаданиеСсылка);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если СтрНайти(ВыборкаДетальныеЗаписи.ИмяФайлаВыгрузки, "!Объект не выгружен!") > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТипДокумента = ТипЗнч(ВыборкаДетальныеЗаписи.Объект);
		
		Если ТипДокументов.СодержитТип(ТипДокумента) Тогда
			
			Если СписокТиповДляОповещений.НайтиПоЗначению(ТипДокумента)=Неопределено Тогда
				СписокТиповДляОповещений.Добавить(ТипДокумента);
			КонецЕсли;
			
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении;
			
			Если (ТипЗнч(ВыборкаДетальныеЗаписи.Объект) = Тип("ДокументСсылка.УведомлениеОбУточненииВидаИПринадлежностиПлатежа")) ИЛИ
				 (ТипЗнч(ВыборкаДетальныеЗаписи.Объект) = Тип("ДокументСсылка.УведомлениеОбУточненииОперацийКлиента")) Тогда
				УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.Исполнен;  
				
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Объект.ЗапросНаВыяснениеПринадлежностиПлатежа) 
					 И ТипЗнч(ВыборкаДетальныеЗаписи.Объект.ЗапросНаВыяснениеПринадлежностиПлатежа) = Тип("ДокументСсылка.ЗапросНаВыяснениеПринадлежностиПлатежа") Тогда
					 
					 СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ВыборкаДетальныеЗаписи.Объект.ЗапросНаВыяснениеПринадлежностиПлатежа);
				     СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент", ВыборкаДетальныеЗаписи.Объект.ЗапросНаВыяснениеПринадлежностиПлатежа);
			         СтруктураРекв.Вставить("Статус", УстанавливаемыйСтатус);
			         ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
					 
				КонецЕсли;
				 
			КонецЕсли; 

			Если ТипЗнч(ВыборкаДетальныеЗаписи.Объект) = Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг")
				И ВыборкаДетальныеЗаписи.ВидКвитанции = 3 Тогда
				УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.Аннулирован;	
			КонецЕсли;
						
			СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ВыборкаДетальныеЗаписи.Объект);
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ВыборкаДетальныеЗаписи.Объект);
			СтруктураРекв.Вставить("Статус",УстанавливаемыйСтатус);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьНаFTPресурс(НастройкаОбмена, КаталогВыгрузки, ФайлыДляПереноса, ДанныеФайлов) Экспорт
	
	СоединениеFTP = ЭкспортФайловКлиентСервер.ПолучитьСоединениеСИнтернет(НастройкаОбмена);
	ПотокВПамяти  = Новый ПотокВПамяти; 
	
	Для каждого ФайлДляПереноса Из ФайлыДляПереноса Цикл
				
		ДанныеФайла             = ДанныеФайлов.Получить(ФайлДляПереноса);	
	  	ПолноеИмяФайла          = КаталогВыгрузки + ДанныеФайла.ИмяФайла;
		
		ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла).Записать(ПотокВПамяти);
		ПотокВПамяти.Перейти((-1)*ДанныеФайла.Размер, ПозицияВПотоке.Конец);
					
	    СоединениеFTP.Записать(ПолноеИмяФайла, ПотокВПамяти);
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура отправки файлов по HTTP 
//
Процедура ОтправитьФайлыПоHTTP(ЗаданиеСсылка, СтруктураДанных = Неопределено, ТекстОшибки = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	МассивФайлов = Неопределено;
	
	ТекОбъект = ЗаданиеСсылка.ПолучитьОбъект();
	Если СтруктураДанных = Неопределено Тогда		
		Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
			ДополнительныеПараметры.Свойство("МассивФайлов",МассивФайлов);
		КонецЕсли;
		СтруктураДанных = ПолучитьСтруктуруДанныхДляЭкспорта(ТекОбъект.НастройкаОбмена, ЗаданиеСсылка,Неопределено,МассивФайлов);
	КонецЕсли;
	НастройкаОбмена = СтруктураДанных.НастройкаОбмена;

	ДопПарметрыНастройки = СтруктураДанных.ДопПарметрыНастройки;
	ФайлыДляПереноса = СтруктураДанных.ПрикрепленныеФайлы;
	ДанныеФайлов = СтруктураДанных.ДанныеФайлов;
	ЗаголовкиФайлов = СтруктураДанных.ЗаголовкиФайлов;
	ИдентификаторВидаОбмена = НастройкаОбмена.ПредставлениеВНомереВерсии;
	ИспользоватьBOM = НастройкаОбмена.ИспользоватьBOM;

	ИмяОбщегоМодуляОбработки = СтруктураДанных.ИмяОбщегоМодуляОбработки;
						
	КоличествоНеОтправленных = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Формат КАК ФорматОбмена,
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Формат.КлючевыеПоляОтвета КАК КлючевыеПоля
		|ИЗ
		|	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена
		|ГДЕ
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", ЗаданиеСсылка);

	Результат = Запрос.Выполнить();

	ТЧ = Результат.Выгрузить();
	
	ТаблицаОшибок = ПолучитьТаблицуОшибок();	
	
	СоответствиеПолейФорматов = Новый Соответствие;
	Для Каждого СтрТЧ Из ТЧ Цикл
		Если СоответствиеПолейФорматов.Получить(СтрТЧ.ФорматОбмена) = Неопределено Тогда
			СоответствиеПолейФорматов.Вставить(СтрТЧ.ФорматОбмена,СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрТЧ.КлючевыеПоля,";"));
		КонецЕсли;
	КонецЦикла;

	СтрокаРазделения = РазделительОтветов();
	МассивОбработанныхСтрок = Новый Массив;
	
	АдресРесурса   = "";
	СоединениеHTTP = ЭкспортФайловКлиентСервер.ПолучитьСоединениеСИнтернет(ЗаданиеСсылка.НастройкаОбмена, АдресРесурса);
	
	Для Каждого ФайлДляПереноса Из ФайлыДляПереноса Цикл	
		ТаблицаОшибок.Очистить();
		Попытка
			
			Заголовки = ЗаголовкиФайлов[ФайлДляПереноса];			
			ЗапросHTTP = Новый HTTPЗапрос(АдресРесурса, Заголовки);
			ДанныеФайла = ДанныеФайлов.Получить(ФайлДляПереноса);
			ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
			
			Если Не ИспользоватьBOM Тогда
				УдалитьBOMСимволы(ДвоичныеДанныеФайла, НастройкаОбмена.КодировкаТекстаФайла);							
			КонецЕсли;
			
			ЗапросHTTP.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанныеФайла);
			
			ОтветHTTP = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
			Ответ = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);	
						
			СтрОбъектовОбмена = ТекОбъект.ОбъектыОбмена.Найти(ДанныеФайла.ИмяФайла,"ИмяФайлаВыгрузки");
			Если СтрОбъектовОбмена = Неопределено Тогда
				
				//Поищем по имени файла без постфикса
				
				ТекИмяФайла = ДанныеФайла.ИмяФайла;

				ПозицияТочки = СтрНайти(ТекИмяФайла, ".", НаправлениеПоиска.СКонца);
				Если ПозицияТочки>0 Тогда
					ПозицияНачалаПрефикса = СтрНайти(Сред(ТекИмяФайла, 1, ПозицияТочки), "_", НаправлениеПоиска.СКонца);
					Если ПозицияНачалаПрефикса>0 Тогда
						ТекИмяФайла = Сред(ТекИмяФайла,1,ПозицияНачалаПрефикса-1)+Сред(ТекИмяФайла,ПозицияТочки);
					КонецЕсли;
				Иначе
					ПозицияНачалаПрефикса = СтрНайти(ТекИмяФайла, "_", НаправлениеПоиска.СКонца);
					Если ПозицияНачалаПрефикса>0 Тогда
						ТекИмяФайла = Сред(ТекИмяФайла,1,ПозицияНачалаПрефикса-1);
					КонецЕсли;
				КонецЕсли;
				СтрОбъектовОбмена = ТекОбъект.ОбъектыОбмена.Найти(ТекИмяФайла,"ИмяФайлаВыгрузки");
				
				Если СтрОбъектовОбмена<>Неопределено Тогда
					Если МассивОбработанныхСтрок.Найти(СтрОбъектовОбмена)<>Неопределено 
						ИЛИ МассивФайлов <> Неопределено Тогда
						ПрошлыйОтвет = СтрОбъектовОбмена.ОтветWebСервиса.Получить();
						Если ПрошлыйОтвет<>Неопределено Тогда
							ОтветВХранилище = ПрошлыйОтвет + Символы.ПС+ СтрокаРазделения + ДанныеФайла.ИмяФайла + Символы.ПС + Ответ;
						Иначе
							ОтветВХранилище = СтрокаРазделения + ДанныеФайла.ИмяФайла + Символы.ПС + Ответ;
						КонецЕсли;
					Иначе
						СтрОбъектовОбмена.Описание = "";
						СтрОбъектовОбмена.ОписаниеОшибки = "";
						МассивОбработанныхСтрок.Добавить(СтрОбъектовОбмена);
						ОтветВХранилище = СтрокаРазделения + ДанныеФайла.ИмяФайла + Символы.ПС + Ответ;
					КонецЕсли;
					СтрОбъектовОбмена.ОтветWebСервиса = Новый ХранилищеЗначения(ОтветВХранилище,Новый СжатиеДанных(9));
					
					МассивПолей = СоответствиеПолейФорматов.Получить(СтрОбъектовОбмена.Формат);
					ОтветИзСервисаВрег = ВРег(Ответ);
					ТекстПолеФайла = "";
					Для Каждого ЭлМас Из МассивПолей Цикл
						ТекПоле = СокрЛП(ВРег(ЭлМас));
						Если Найти(ОтветИзСервисаВрег,ТекПоле)=0 Тогда
							
							ТекстПолеФайла = ТекстПолеФайла + ?(ЗначениеЗаполнено(ТекстПолеФайла),", ","") + """"+СокрЛП(ЭлМас)+"""";
							
						КонецЕсли;
					КонецЦикла;
					 
					Если ЗначениеЗаполнено(ТекстПолеФайла) Тогда
						НовСтрОшибки = ТаблицаОшибок.Добавить();
						НовСтрОшибки.ПолеФайла = НСтр("ru='Ответ из сервиса на отправку файла "+ДанныеФайла.ИмяФайла+" не содежит обязательные поля: "+ТекстПолеФайла+"'");
						НовСтрОшибки.Ошибка = НСтр("ru='Вероятно файл не был получен web-сервисом, проверьте правильность настроек обмена (адрес ресурса, порт), настроек доступа к Интернет.'");
						
						СтрОбъектовОбмена.Описание = "Подробно...";
						СтрОбъектовОбмена.ОписаниеОшибки = ЗначениеВСтрокуВнутр(ТаблицаОшибок);
					КонецЕсли;

				КонецЕсли;
							
			Иначе
				СтрОбъектовОбмена.ОтветWebСервиса = Новый ХранилищеЗначения(Ответ,Новый СжатиеДанных(9));
				МассивПолей = СоответствиеПолейФорматов.Получить(СтрОбъектовОбмена.Формат);
				ОтветИзСервисаВрег = ВРег(Ответ);
				ТекстПолеФайла = "";
				Для Каждого ЭлМас Из МассивПолей Цикл
					ТекПоле = СокрЛП(ВРег(ЭлМас));
					Если Найти(ОтветИзСервисаВрег,ТекПоле)=0 Тогда
						
						ТекстПолеФайла = ТекстПолеФайла + ?(ЗначениеЗаполнено(ТекстПолеФайла),", ","") + """"+СокрЛП(ЭлМас)+"""";
						
					КонецЕсли;
				КонецЦикла;
				 
				Если ЗначениеЗаполнено(ТекстПолеФайла) Тогда
					НовСтрОшибки = ТаблицаОшибок.Добавить();
					НовСтрОшибки.ПолеФайла = НСтр("ru='Ответ из сервиса не содежит обязательные поля: "+ТекстПолеФайла+"'");
					НовСтрОшибки.Ошибка = НСтр("ru='Вероятно файл не был получен web-сервисом, проверьте правильность настроек обмена (адрес ресурса, порт), настроек доступа к Интернет.'");
					
					СтрОбъектовОбмена.Описание = "Подробно...";
					СтрОбъектовОбмена.ОписаниеОшибки = ЗначениеВСтрокуВнутр(ТаблицаОшибок);
				Иначе
					СтрОбъектовОбмена.Описание = "";
					СтрОбъектовОбмена.ОписаниеОшибки = "";
				КонецЕсли;
			КонецЕсли;
			//ВыходныеДанные.Вставить(ФайлыДляПереноса.Ссылка,Ответ);

		Исключение
			//добавить описание ошибки в документ
			ТекОбъект.Записать(РежимЗаписиДокумента.Запись);
			КоличествоНеОтправленных = КоличествоНеОтправленных + 1;
			ТекстОшибки = ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке());
			Возврат;
		КонецПопытки;
									
	КонецЦикла;
	
	Если ИдентификаторВидаОбмена = "GY" Тогда
		Если ДополнительныеПараметры = Неопределено Тогда
			ДополнительныеПараметры = Новый Структура;
		КонецЕсли;
		
		ТребуетсяСледующаяИтерация = Ложь;
		
		ГосУслуги.ОбработатьОтветИзСервиса_1_16(ТекОбъект,ТребуетсяСледующаяИтерация);
		
		ДополнительныеПараметры.Вставить("ТребуетсяСледующаяИтерация",ТребуетсяСледующаяИтерация);
		
	ИначеЕсли ИдентификаторВидаОбмена = "RFI" Тогда
		РеестрИмуществаСервер.ОбработатьОтветИзСервиса(ТекОбъект);
	// Для совместимости
	ИначеЕсли ЗначениеЗаполнено(ИмяОбщегоМодуляОбработки) Тогда
		Если ВРег(ИмяОбщегоМодуляОбработки) = ВРег("Госуслуги") Тогда
			ГосУслуги.ОбработатьОтветИзСервиса(ТекОбъект);
		ИначеЕсли ВРег(ИмяОбщегоМодуляОбработки) = ВРег("РеестрИмущества") Тогда 
			РеестрИмуществаСервер.ОбработатьОтветИзСервиса(ТекОбъект);
		КонецЕсли;
	//
	КонецЕсли;

    ТекОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

Функция ПолучитьСтруктуруДанныхДляЭкспорта(Знач НастройкаОбменаСсылка, Знач ЗаданиеСсылка, Знач ИдентификаторФормы = Неопределено,МассивФайлов = Неопределено) Экспорт
	
	ВозвращаемаяСтруктура = Новый Структура();
	ВозвращаемаяСтруктура.Вставить("НастройкаОбмена", ПолучитьДанныеНастройкиОбмена(НастройкаОбменаСсылка));
	
	Если МассивФайлов = Неопределено Тогда
		ВозвращаемаяСтруктура.Вставить("ПрикрепленныеФайлы",ПолучитьПрикрепленныеФайлыЗаданияНаЭкспорт(ЗаданиеСсылка));
	Иначе
		ВозвращаемаяСтруктура.Вставить("ПрикрепленныеФайлы",МассивФайлов);
	КонецЕсли;
	СоответствиеДанныхФайлов = Новый Соответствие;
	
	ДанныеПараметров = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(Новый Массив, НастройкаОбменаСсылка);
	ВозвращаемаяСтруктура.Вставить("ДопПарметрыНастройки",ДанныеПараметров);
		
	ИмяОбщегоМодуляОбработки = ДанныеПараметров.Получить("ИмяОбщегоМодуляОбработки");
	ВозвращаемаяСтруктура.Вставить("ИмяОбщегоМодуляОбработки",ИмяОбщегоМодуляОбработки);
	
	ЗаголовкиФайлов = ПолучитьЗаголовкиФайловПоЗаданию(ЗаданиеСсылка, ВозвращаемаяСтруктура.ПрикрепленныеФайлы, ДанныеПараметров);
	ВозвращаемаяСтруктура.Вставить("ЗаголовкиФайлов", ЗаголовкиФайлов);
	
	Для Каждого ЭлМас Из ВозвращаемаяСтруктура.ПрикрепленныеФайлы Цикл
		СоответствиеДанныхФайлов.Вставить(ЭлМас, РаботаСФайлами.ДанныеФайла(ЭлМас, ИдентификаторФормы));
	КонецЦикла;
	
	ВозвращаемаяСтруктура.Вставить("ДанныеФайлов",			СоответствиеДанныхФайлов);
	
	ВозвращаемаяСтруктура.Вставить("КонтролироватьБезопасностьОбменаЧерезКаталог", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаОбменаСсылка, "КонтролироватьБезопасностьОбменаЧерезКаталог"));

		
	Возврат ВозвращаемаяСтруктура;
	
КонецФункции

Процедура ОтправитьФайлыПоHTTPСписком(СписокЗаданий) Экспорт
	
	Для Каждого СтрСписка ИЗ СписокЗаданий Цикл
		ТекстОшибки = "";
		ОтправитьФайлыПоHTTP(СтрСписка.Значение, Неопределено,ТекстОшибки);	
	КонецЦикла;
	
КонецПроцедуры

// Процедура отправляет сообщения из таблицы в сервис.
// Используется для обмена со СМЭВ3 на сервере. 
//
Процедура ОтправитьФайлыВСервисНаСервере(ТаблицаСообщений,ЗаголовкиФорматов,ПараметрыНастройки,ЕстьОшибки,ТекстОшибки,ОграничениеОчереди=0,ФорматПодтверждения) Экспорт
	
	ОбменСКлиента = Ложь;
	
	НастройкаОбменаСтруктурой = ПараметрыНастройки;

	//ДопПарметрыНастройки = СтруктураДанных.ДопПарметрыНастройки;
	//ФайлыДляПереноса = СтруктураДанных.ПрикрепленныеФайлы;
	//ДанныеФайлов = СтруктураДанных.ДанныеФайлов;
	
	ИспользоватьBOM = ?(НастройкаОбменаСтруктурой.ИспользоватьBOM,ИспользованиеByteOrderMark.Использовать,ИспользованиеByteOrderMark.НеИспользовать);
								
	АдресРесурса = "";
	СоединениеHTTP = ЭкспортФайловКлиентСервер.ПолучитьСоединениеСИнтернет(НастройкаОбменаСтруктурой, АдресРесурса);
	СоответствиеОтветов = Новый Соответствие;
	
	МассивСтрокКОбработке = Новый Массив;
	
	ТекУчастник = Неопределено;
	Для Каждого СтрТЧ Из ТаблицаСообщений Цикл	
		
		ПозицияНачалаФайла = 1;
		Если СтрНачинаетсяС(СтрТЧ.СодержимоеФайла,"<?")  Тогда
			ПозицияНачалаФайла = СтрНайти(СтрТЧ.СодержимоеФайла,"?>")+2;
			СтрТЧ.СодержимоеФайла = СокрЛП(Сред(СтрТЧ.СодержимоеФайла,ПозицияНачалаФайла));
		КонецЕсли;
		
		//СтрТЧ.СодержимоеФайла = СокрЛП(СтрЗаменить(СтрТЧ.СодержимоеФайла,"<?xml version=""1.0"" encoding=""UTF-8""?>",""));
		Если СтрТЧ.Подписано = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрокКОбработке.Добавить(СтрТЧ.ПолучитьИдентификатор());
		ТекУчастник = СтрТЧ.ТекущийУчастник;
	КонецЦикла;
	
	ПараметрыОчередиСообщений = ГосУслуги.ПолучитьПараметрыОчередиСообщений(НастройкаОбменаСтруктурой.Ссылка);
	ПараметрыОчередиСообщений.Вставить("ДатаНачалаОбмена",ТекущаяДата());
	Если ОграничениеОчереди <> 0 Тогда
		//ОграничениеОчереди - заполняется при обмене с ГИС ГМП, если это автоматическое получение данных из очереди
		Если ПараметрыОчередиСообщений.МасимальноеКоличествоСообщений>0 Тогда			
			ПараметрыОчередиСообщений.МасимальноеКоличествоСообщений = Мин(ОграничениеОчереди,ПараметрыОчередиСообщений.МасимальноеКоличествоСообщений);
		Иначе
			ПараметрыОчередиСообщений.МасимальноеКоличествоСообщений = ОграничениеОчереди;
		КонецЕсли;
	КонецЕсли;
	
	ПодписьНаКлиенте = ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте();
	
	ШаблонСообщенияПодтверждения = "";
	Если ЗначениеЗаполнено(ФорматПодтверждения)
		И ЗначениеЗаполнено(ТекУчастник)
		И ПодписьНаКлиенте = Ложь Тогда
		
		ШаблонСообщенияПодтверждения = ГосУслуги.СформироватьШаблонСообщенияПодтверждения(ТекУчастник,ФорматПодтверждения);
		
		ПозицияНачалаФайла = 1;
		Если СтрНачинаетсяС(ШаблонСообщенияПодтверждения,"<?")  Тогда
			ПозицияНачалаФайла = СтрНайти(ШаблонСообщенияПодтверждения,"?>")+2;
			ШаблонСообщенияПодтверждения = СокрЛП(Сред(ШаблонСообщенияПодтверждения,ПозицияНачалаФайла));
		КонецЕсли;
	КонецЕсли;
	
	//Выполняем обмен с сервисом.
	//Если это запрос данных из очереди, то при получении в ответе данных,
	//копируем строку запроса и выполняем запрос следующего сообщения из очереди.
	
	КомпонентаДляПодписиНаСервере = Неопределено;
	НастройкиПодисиУчастниковДляПодписиНаСервере = Неопределено;
	
	Пока МассивСтрокКОбработке.Количество()>0 Цикл
		МассивСтрокКОбработке = ОтправитьВыбранныеФайлыВСервис(ТаблицаСообщений,
			МассивСтрокКОбработке,
			ЗаголовкиФорматов,
			СоединениеHTTP,
			АдресРесурса,
			ИспользоватьBOM,
			ПараметрыОчередиСообщений,
			ФорматПодтверждения,
			ШаблонСообщенияПодтверждения,
			ПодписьНаКлиенте,
			КомпонентаДляПодписиНаСервере,
			НастройкиПодисиУчастниковДляПодписиНаСервере);
	КонецЦикла;
		
КонецПроцедуры

Функция ОтправитьВыбранныеФайлыВСервис(ТаблицаСообщений,
	МассивСтрокКОбработке,
	ЗаголовкиФорматов,
	СоединениеHTTP,
	АдресРесурса,
	ИспользоватьBOM,
	ПараметрыОчередиСообщений,
	ФорматПодтверждения,
	ШаблонСообщенияПодтверждения,
	ПодписьНаКлиенте,
	КомпонентаДляПодписиНаСервере,
	НастройкиПодисиУчастниковДляПодписиНаСервере)
	
	МассивНовыхСтрокКОбработке = Новый Массив;
	
	ЕстьОтборПоКоличеству = ПараметрыОчередиСообщений.МасимальноеКоличествоСообщений>0;
	
	ФразаИдентификатор = "%ТутБудетИдентификаторСообщения%";
	
	Для Каждого СтрИд Из МассивСтрокКОбработке Цикл	
		
		СтрТЧ = ТаблицаСообщений.НайтиПоИдентификатору(СтрИд);
		
		Если СтрТЧ.Подписано = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		ПозицияНачалаФайла = 1;
		Если СтрНачинаетсяС(СтрТЧ.СодержимоеФайла,"<?")  Тогда
			ПозицияНачалаФайла = СтрНайти(СтрТЧ.СодержимоеФайла,"?>")+2;
			СтрТЧ.СодержимоеФайла = СокрЛП(Сред(СтрТЧ.СодержимоеФайла,ПозицияНачалаФайла));
		КонецЕсли;
				
		Попытка
			
			Заголовки = ЗаголовкиФорматов[СтрТЧ.ФорматОбмена];			
			ЗапросHTTP = Новый HTTPЗапрос(АдресРесурса, Заголовки);
			
			ЗапросHTTP.УстановитьТелоИзСтроки(СтрТЧ.СодержимоеФайла,КодировкаТекста.UTF8,ИспользоватьBOM);//ИзДвоичныхДанных(ДвоичныеДанныеФайла);
			
			ОтветHTTP = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
			
			СтрТЧ.КодСостояния = ОтветHTTP.КодСостояния;
			
			Ответ = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			СтрТЧ.СообщениеОтвет = Ответ;
			
			СтрТЧ.ДатаОбмена = ТекущаяДата();
			
			Если ОтветHTTP.КодСостояния <> 200 Тогда
				СтрТЧ.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.Ошибка");
				ЕстьОшибки = Истина;
			Иначе	
							
				Если СтрТЧ.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСМЭВ")
					ИЛИ СтрТЧ.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСтатусов") Тогда
					
					СтрТЧ.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.Отправлен");
					
					ИдентификаторСообщенияДляПодтверждения = "";
					Если ЭкспортФайловКлиентСервер.ВОтветеЕстьДанные(Ответ, ИдентификаторСообщенияДляПодтверждения) Тогда
						СтрТЧ.ЕстьДанные = Истина;
						//если очередь не поддерживается, то ответ без подтверждения можно получить только 1 по каждому виду сведений, потом надо запрашивать снова 
						
						Если ЗначениеЗаполнено(ШаблонСообщенияПодтверждения)
							И ЗначениеЗаполнено(ИдентификаторСообщенияДляПодтверждения) Тогда
							СообщениеДляПодтверждения = СтрЗаменить(ШаблонСообщенияПодтверждения,ФразаИдентификатор,ИдентификаторСообщенияДляПодтверждения);
							
							ТекстОшибки = "";
							ПодтверждаемСразу = Ложь;
							ПодтверждениеПодписано = Ложь;
							
							Если ПодписьНаКлиенте = Ложь Тогда
								//мы на сервере и подпись выполняется на сервере, можем сразу подписать сообщение и подтвердить получение
								
								ПодтверждаемСразу = Истина;
								ПодтверждениеПодписано = ГосУслуги.ПодписатьПодтверждениеПолученияСообщенияНаСервере(СтрТЧ.ТекущийУчастник,
									СообщениеДляПодтверждения,НастройкиПодисиУчастниковДляПодписиНаСервере,КомпонентаДляПодписиНаСервере,ТекстОшибки);
								
							КонецЕсли;
							
							Если ЗначениеЗаполнено(ТекстОшибки) Тогда
								ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
							КонецЕсли;
							
							Если ПодтверждаемСразу = Истина
								И ПодтверждениеПодписано Тогда
								
								НоваяСтрокаПодтверждения = ТаблицаСообщений.Добавить();
								НоваяСтрокаПодтверждения.СодержимоеФайла = СообщениеДляПодтверждения;
								НоваяСтрокаПодтверждения.ИдентификаторСообщения = ИдентификаторСообщенияДляПодтверждения;
								НоваяСтрокаПодтверждения.ФорматОбмена = ФорматПодтверждения;
								НоваяСтрокаПодтверждения.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ПодтверждениеПолученияСообщенияСМЭВ");
								НоваяСтрокаПодтверждения.ТекущийУчастник = СтрТЧ.ТекущийУчастник;
								НоваяСтрокаПодтверждения.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен");
								НоваяСтрокаПодтверждения.Подписано = Истина;
								НоваяСтрокаПодтверждения.НомерПакета = ТаблицаСообщений.Количество();
								
								Попытка
									
									Заголовки = ЗаголовкиФорматов[ФорматПодтверждения];			
									ЗапросHTTP = Новый HTTPЗапрос(АдресРесурса, Заголовки);
									
									ЗапросHTTP.УстановитьТелоИзСтроки(НоваяСтрокаПодтверждения.СодержимоеФайла,КодировкаТекста.UTF8,ИспользоватьBOM);//ИзДвоичныхДанных(ДвоичныеДанныеФайла);
									
									ОтветHTTP = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
									
									НоваяСтрокаПодтверждения.КодСостояния = ОтветHTTP.КодСостояния;
									
									Ответ = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
									НоваяСтрокаПодтверждения.СообщениеОтвет = Ответ;
									
									Если ОтветHTTP.КодСостояния <> 200 Тогда
										НоваяСтрокаПодтверждения.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.Ошибка");
										ЕстьОшибки = Истина;
									Иначе
										НоваяСтрокаПодтверждения.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.Отправлен");										
									КонецЕсли;
									
									НоваяСтрокаПодтверждения.ДатаОбмена = ТекущаяДата();
									
									СтрТЧ.Подтверждено = Истина;
								
								Исключение
		
									НоваяСтрокаПодтверждения.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен");
												
									ЕстьОшибки = Истина;
									ТекстОшибки = Нстр("ru='Не удалось отправить сообщение в сервис по причине: %1'");
									ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОписаниеОшибки());
									
									ЭкспортФайловКлиентСервер.ДобавитьОшибку(НоваяСтрокаПодтверждения.ТаблицаОшибок, ТекстОшибки, "");
									
								КонецПопытки;
								
							КонецЕсли;
							
						КонецЕсли;	
							
						//если в ответе есть данные, и поддерживается очередь,
						//или мы уже подтвердили полученное сообщение, и по этому сообщению-запросу можно еще раз запросить ответ,
						//то добавим новую строку запроса данных из очереди, чтобы сразу получить еще
						
						Если ПараметрыОчередиСообщений.ОчередьПоддерживается
							ИЛИ (СтрТЧ.Подтверждено  
								И СтрТЧ.ПоддерживаетПовторныйЗапрос) Тогда
							
							ДатаОкончанияОбмена = ТекущаяДата();
							//При обмене с ГИС ГМП необходимо за 15 минут подтвердить все полученные сообщения, 
							//иначе они снова будут приходить при запросе.
							//Поэтому на получение сообщений из очереди выделяем 6 минут - 360 секунд.
							//Если за это время не были получены все сообщения, то после подтверждения полученных сообщений,
							//в обработке обмена будет предложено запросить данные из очереди еще раз.
							
							ВремяЕсть = ДатаОкончанияОбмена - ПараметрыОчередиСообщений.ДатаНачалаОбмена < ПараметрыОчередиСообщений.МаксимальнаяДлительность;
							КоличествоЕсть = Истина;
							Если ЕстьОтборПоКоличеству Тогда
								КоличествоЕсть = ТаблицаСообщений.Количество() < ПараметрыОчередиСообщений.МасимальноеКоличествоСообщений;
							КонецЕсли;
							
							Если ВремяЕсть 
								И КоличествоЕсть Тогда
							
								НоваяСтрока = ТаблицаСообщений.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрТЧ,,"ТаблицаОшибок,СообщениеОтвет,СтатусОтправки,КодСостояния,ЕстьДанные,Подтверждено");
								НоваяСтрока.НомерПакета = ТаблицаСообщений.Количество();
								
								МассивНовыхСтрокКОбработке.Добавить(НоваяСтрока.ПолучитьИдентификатор());
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли СтрТЧ.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ПодтверждениеПолученияСообщенияСМЭВ") Тогда
					СтрТЧ.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.Отправлен");
				Иначе
					//передача запроса данных в обработку
					СтрТЧ.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.ВОчереди");
				КонецЕсли;
			КонецЕсли;
			
		Исключение
			
			СтрТЧ.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен");
						
			ЕстьОшибки = Истина;
			ТекстОшибки = Нстр("ru='Не удалось отправить сообщение в сервис по причине: %1'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОписаниеОшибки());
			
			ЭкспортФайловКлиентСервер.ДобавитьОшибку(СтрТЧ.ТаблицаОшибок, ТекстОшибки, "");
			
		КонецПопытки;
		
	КонецЦикла;
		
	Возврат МассивНовыхСтрокКОбработке;
	
КонецФункции



Функция ЗаписатьТаблицуСообщенийВДвоичныеДанные(Знач ТаблицаСообщений,Знач РезультатФормирования) Экспорт
	
	СоответствиеФайлов = Новый Соответствие;
	ТекДата = ТекущаяДатаСеанса();
	Для Каждого СтрТЧ Из ТаблицаСообщений Цикл
		
		СохраняемоеИмяФайла = "";
		
		МассивОбъектов = РезультатФормирования.НайтиСтроки(Новый Структура("НомерПакета",СтрТЧ.НомерПакета));
		Для Каждого ТекСтрОбъекта Из МассивОбъектов Цикл
			
			Если ЗначениеЗаполнено(ТекСтрОбъекта.Объект) Тогда
				ПредставлениеОбъекта = Строка(ТекСтрОбъекта.Объект);
				ПредставлениеОбъекта = Сред(ПредставлениеОбъекта,1,СтрДлина(ПредставлениеОбъекта)-9);
				СохраняемоеИмяФайла = ПредставлениеОбъекта+".xml";
			КонецЕсли;
			
			Прервать;
			
		КонецЦикла;
			
		ТекИмя = ПолучитьИмяВременногоФайла("txt");
		ЗаписьТекста = Новый ЗаписьТекста(ТекИмя,КодировкаТекста.UTF8);
		ЗаписьТекста.Записать(СтрТЧ.СодержимоеФайла);
		ЗаписьТекста.Закрыть();
		
		ДДанные = Новый ДвоичныеДанные(ТекИмя);				
		Если Сред(ДДанные, 1, 8) = "EF BB BF" Тогда
			Строка64 = Base64Строка(ДДанные);
			Строка64 = Прав(Строка64,СтрДлина(Строка64)-4); // Удаляем 3 символа BOM
			ДДанные = Base64Значение(Строка64);
			ДДанные.Записать(ТекИмя);
			
			Строка64 = Неопределено
		КонецЕсли;
		СсылкаНаДвоичныеДанные = ПоместитьВоВременноеХранилище(ДДанные,Новый УникальныйИдентификатор);
		
		СтруктураФайла = Новый Структура("ИмяФайла,Данные",СохраняемоеИмяФайла,СсылкаНаДвоичныеДанные);
		
		СоответствиеФайлов.Вставить(СтрТЧ.ИдентификаторСообщения,СтруктураФайла);
	КонецЦикла;
	
	Возврат СоответствиеФайлов;
	
КонецФункции

Функция ПолучитьТаблицуОшибок(СтрокаРезультата = Неопределено) Экспорт
	
	Если СтрокаРезультата = Неопределено Или ПустаяСтрока(СтрокаРезультата.ОписаниеОшибки) Тогда
		ТаблицаОшибок = Новый ТаблицаЗначений;
		ТаблицаОшибок.Колонки.Добавить("ПолеФайла");
		ТаблицаОшибок.Колонки.Добавить("Ошибка");
	Иначе	
		ТаблицаОшибок = ЗначениеИзСтрокиВнутр(СтрокаРезультата.ОписаниеОшибки);
	КонецЕсли;
	
	Возврат ТаблицаОшибок;
	
КонецФункции

Функция РазобратьОтветИзСервиса(ОтветWebСервиса, ТаблицаОшибок = Неопределено) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ИмяФайла");
	Результат.Колонки.Добавить("Ответ");
	
	ОтветИзСервиса = ОтветWebСервиса.Получить();
	
	Если ОтветИзСервиса = Неопределено Тогда
		Если ТаблицаОшибок <> Неопределено Тогда
			ТаблицаОшибок.Добавить().Ошибка = "Не удалось получить ответ из сервиса (Проверьте настройки)";
		КонецЕсли;
	ИначеЕсли ОтветИзСервиса = "" Тогда
		// Сервис дал пустой ответ
	Иначе
		РазделительОтветов = РазделительОтветов();
		Если Найти(ОтветИзСервиса, РазделительОтветов) > 0 Тогда 
			Ответы = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ОтветИзСервиса, РазделительОтветов, Истина);		
			Для Каждого Ответ Из Ответы Цикл
				НоваяСтрока = Результат.Добавить();
				НоваяСтрока.ИмяФайла = СокрЛП(Сред(Ответ, 1, Найти(Ответ, Символы.ПС)));
				НоваяСтрока.Ответ = СокрЛП(Сред(Ответ, Найти(Ответ, Символы.ПС) + 1));
			КонецЦикла;
		Иначе
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.ИмяФайла = "";
			НоваяСтрока.Ответ = ОтветИзСервиса;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РазделительОтветов() Экспорт
	
	Возврат "////////// ////////// //////////
	|////////// ////////// //////////" + Символы.ПС;	
	
КонецФункции

Функция ПолучитьДанныеНастройкиОбмена(НастройкаОбменаСсылка) Экспорт
	
	Реквизиты = Новый Структура("ПредставлениеВНомереВерсии,КодировкаТекстаФайла,ПутьВыгрузкиПоУмолчанию,СпособОбмена,ЗащищенноеСоединение,ПассивноеСоединение,Сервер,ПутьНаСервере,
									|Порт,Логин,Таймаут,ЗагружатьОтветСервисаВнешнейОбработкой,ИспользоватьBOM,ОбменНаКлиенте", "Владелец.ПредставлениеВНомереВерсии","Владелец.КодировкаТекстаФайла");
	СтруктураНастройкаОбмена = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаОбменаСсылка, Реквизиты);
	
	Протокол = ?(СтруктураНастройкаОбмена.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.FTP"), "ftp",
		?(СтруктураНастройкаОбмена.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.WebСервис"), "http", "")) +
		?(СтруктураНастройкаОбмена.ЗащищенноеСоединение = Истина, "s", "");	
	СтруктураНастройкаОбмена.Вставить("Протокол", Протокол);
	
	СтруктураНастройкаОбмена.Вставить("Ссылка", НастройкаОбменаСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(НастройкаОбменаСсылка);
	УстановитьПривилегированныйРежим(Ложь);		
	СтруктураНастройкаОбмена.Вставить("Пароль", ?(ЗначениеЗаполнено(Пароль), Пароль, ""));
	
	Возврат СтруктураНастройкаОбмена;
	
КонецФункции

Функция ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматыОбмена) Экспорт
	
	//Предполагается, что Форматы обмена это массив или ссылка на справочник ФорматыОбменаБанкиКС
	Если ТипЗнч(ФорматыОбмена) = Тип("Массив") Тогда
		МассивФорматов = ФорматыОбмена;
	Иначе
		МассивФорматов = Новый Массив;
		МассивФорматов.Добавить(ФорматыОбмена);
	КонецЕсли;
	
	ЗаголовкиФорматов = Новый Соответствие;
	
	СпособОбмена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаОбмена, "СпособОбмена");
	Если СпособОбмена <> Перечисления.СпособыВыгрузкиФайловПередачи.WebСервис Тогда
		Возврат ЗаголовкиФорматов;
	КонецЕсли;
	
	ОбщиеЗаголовки = Новый Соответствие;
	ОбщиеЗаголовки.Вставить("Connection", "Keep-Alive");
	ОбщиеЗаголовки.Вставить("Content-Type", "text/xml; charset=utf-8");	
	
	ДопПараметры = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(Новый Массив, НастройкаОбмена);
	
	ЗаголовкиНастройки = Новый Соответствие;
	Для Каждого КлючИЗначение Из ДопПараметры Цикл
		Если ВРег(Лев(КлючИЗначение.Ключ,10)) = "ЗАГОЛОВОК." Тогда
			ЗаголовкиНастройки.Вставить(Сред(КлючИЗначение.Ключ,11),КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФорматыОбменаБанкиКСЗаголовки.НомерСтроки КАК НомерСтроки,
		|	ФорматыОбменаБанкиКСЗаголовки.Заголовок КАК Заголовок,
		|	ФорматыОбменаБанкиКСЗаголовки.Значение КАК Значение,
		|	ФорматыОбменаБанкиКСЗаголовки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ФорматыОбменаБанкиКС.Заголовки КАК ФорматыОбменаБанкиКСЗаголовки
		|ГДЕ
		|	ФорматыОбменаБанкиКСЗаголовки.Ссылка В (&МассивФорматов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки
		|ИТОГИ ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("МассивФорматов", МассивФорматов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаФорматы = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаФорматы.Следующий() Цикл
		ЗаголовкиТекФорм = Новый Соответствие;
		
		// Общие заголовки
		Для Каждого ОбщийЗаголовок Из ОбщиеЗаголовки Цикл
			ЗаголовкиТекФорм.Вставить(ОбщийЗаголовок.Ключ, ОбщийЗаголовок.Значение);
		КонецЦикла;
		
		// Заголовки формата
		ВыборкаДетальныеЗаписи = ВыборкаФорматы.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ЗаголовкиТекФорм.Вставить(СокрЛП(ВыборкаДетальныеЗаписи.Заголовок), СокрЛП(ВыборкаДетальныеЗаписи.Значение));
		КонецЦикла;
		
		// Заголовки настройки
		Для Каждого ЗаголовокНастройки Из ЗаголовкиНастройки Цикл
			ЗаголовкиТекФорм.Вставить(СокрЛП(ЗаголовокНастройки.Ключ), СокрЛП(ЗаголовокНастройки.Значение));
		КонецЦикла;
		
		ЗаголовкиФорматов.Вставить(ВыборкаФорматы.Ссылка,ЗаголовкиТекФорм);
	КонецЦикла;
		
	Возврат ЗаголовкиФорматов; 
	
КонецФункции

Функция ХешСуммаДанных_МД5(Данные) Экспорт
	ТекХешФункция = Новый ХешированиеДанных(ХешФункция.MD5);
	ТекХешФункция.Добавить(ПолучитьИзВременногоХранилища(Данные));
	Возврат ТекХешФункция.ХешСумма;
КонецФункции

Функция ПараметрыНастройкиОбменаБанкиКС(Настройка) Экспорт
	
	Реквизиты = Новый Структура("Адрес,СпособОбмена,Сервер,ПутьНаСервере,
		|ЗащищенноеСоединение,ПассивноеСоединение,Порт,Логин,Таймаут", "ПутьВыгрузкиПоУмолчанию");
	Значения = ОбщегоНазначенияБГУ.ПолучитьЗначенияРеквизитов(Настройка, Реквизиты);
	
	Протокол = ?(Значения.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.FTP"), "ftp",
		?(Значения.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.WebСервис"), "http", "")) +
		?(Значения.ЗащищенноеСоединение, "s", "");	
	Значения.Вставить("Протокол", Протокол);
	
	УстановитьПривилегированныйРежим(Истина);
	Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Настройка);
	УстановитьПривилегированныйРежим(Ложь);		
	Значения.Вставить("Пароль", ?(ЗначениеЗаполнено(Пароль), Пароль, ""));
		
	Возврат Значения;	
	
КонецФункции

Функция ПолучитьКаталогЗаданияНаЭкспорт(ЗаданиеСсылка) Экспорт
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаданиеСсылка,"КаталогВыгрузки",Истина);	
КонецФункции

Процедура ОбработатьРезультатОтправкиФайлов(ЗаданиеСсылка,СтруктураДанных,СоответствиеОтветов,ТекстОшибки,ДополнительныеПараметры = Неопределено) Экспорт
	
	ТекОбъект = ЗаданиеСсылка.ПолучитьОбъект();
	
	МассивФайлов = Неопределено;
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ДополнительныеПараметры.Свойство("МассивФайлов",МассивФайлов);
	КонецЕсли;
	
	НастройкаОбмена = СтруктураДанных.НастройкаОбмена;

	ДопПарметрыНастройки = СтруктураДанных.ДопПарметрыНастройки;
	ФайлыДляПереноса = СтруктураДанных.ПрикрепленныеФайлы;
	ДанныеФайлов = СтруктураДанных.ДанныеФайлов;
	ЗаголовкиФайлов = СтруктураДанных.ЗаголовкиФайлов;
	ИдентификаторВидаОбмена = НастройкаОбмена.ПредставлениеВНомереВерсии;
	ИспользоватьBOM = НастройкаОбмена.ИспользоватьBOM;

	ИмяОбщегоМодуляОбработки = СтруктураДанных.ИмяОбщегоМодуляОбработки;
						
	КоличествоНеОтправленных = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Формат КАК ФорматОбмена,
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Формат.КлючевыеПоляОтвета КАК КлючевыеПоля
		|ИЗ
		|	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена
		|ГДЕ
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", ЗаданиеСсылка);

	Результат = Запрос.Выполнить();

	ТЧ = Результат.Выгрузить();
	
	ТаблицаОшибок = ПолучитьТаблицуОшибок();	
	
	СоответствиеПолейФорматов = Новый Соответствие;
	Для Каждого СтрТЧ Из ТЧ Цикл
		Если СоответствиеПолейФорматов.Получить(СтрТЧ.ФорматОбмена) = Неопределено Тогда
			СоответствиеПолейФорматов.Вставить(СтрТЧ.ФорматОбмена,СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрТЧ.КлючевыеПоля,";"));
		КонецЕсли;
	КонецЦикла;
	
	СтрокаРазделения = РазделительОтветов();
	МассивОбработанныхСтрок = Новый Массив;
	
	Для Каждого КлючИЗначение Из СоответствиеОтветов Цикл	
		ТаблицаОшибок.Очистить();
		Попытка
			
			ФайлДляПереноса = КлючИЗначение.Ключ;
			
			ДанныеФайла = ДанныеФайлов.Получить(ФайлДляПереноса);
			
			Ответ = КлючИЗначение.Значение;	
						
			СтрОбъектовОбмена = ТекОбъект.ОбъектыОбмена.Найти(ДанныеФайла.ИмяФайла,"ИмяФайлаВыгрузки");
			Если СтрОбъектовОбмена = Неопределено Тогда
				
				//Поищем по имени файла без постфикса
				
				ТекИмяФайла = ДанныеФайла.ИмяФайла;

				ПозицияТочки = СтрНайти(ТекИмяФайла, ".", НаправлениеПоиска.СКонца);
				Если ПозицияТочки>0 Тогда
					ПозицияНачалаПрефикса = СтрНайти(Сред(ТекИмяФайла, 1, ПозицияТочки), "_", НаправлениеПоиска.СКонца);
					Если ПозицияНачалаПрефикса>0 Тогда
						ТекИмяФайла = Сред(ТекИмяФайла,1,ПозицияНачалаПрефикса-1)+Сред(ТекИмяФайла,ПозицияТочки);
					КонецЕсли;
				Иначе
					ПозицияНачалаПрефикса = СтрНайти(ТекИмяФайла, "_", НаправлениеПоиска.СКонца);
					Если ПозицияНачалаПрефикса>0 Тогда
						ТекИмяФайла = Сред(ТекИмяФайла,1,ПозицияНачалаПрефикса-1);
					КонецЕсли;
				КонецЕсли;
				СтрОбъектовОбмена = ТекОбъект.ОбъектыОбмена.Найти(ТекИмяФайла,"ИмяФайлаВыгрузки");
				
				Если СтрОбъектовОбмена<>Неопределено Тогда
					Если МассивОбработанныхСтрок.Найти(СтрОбъектовОбмена)<>Неопределено 
						ИЛИ МассивФайлов <> Неопределено Тогда
						ПрошлыйОтвет = СтрОбъектовОбмена.ОтветWebСервиса.Получить();
						Если ПрошлыйОтвет<>Неопределено Тогда
							ОтветВХранилище = ПрошлыйОтвет + Символы.ПС+ СтрокаРазделения + ДанныеФайла.ИмяФайла + Символы.ПС + Ответ;
						Иначе
							ОтветВХранилище = СтрокаРазделения + ДанныеФайла.ИмяФайла + Символы.ПС + Ответ;
						КонецЕсли;
					Иначе
						СтрОбъектовОбмена.Описание = "";
						СтрОбъектовОбмена.ОписаниеОшибки = "";
						МассивОбработанныхСтрок.Добавить(СтрОбъектовОбмена);
						ОтветВХранилище = СтрокаРазделения + ДанныеФайла.ИмяФайла + Символы.ПС + Ответ;
					КонецЕсли;
					СтрОбъектовОбмена.ОтветWebСервиса = Новый ХранилищеЗначения(ОтветВХранилище,Новый СжатиеДанных(9));
					
					МассивПолей = СоответствиеПолейФорматов.Получить(СтрОбъектовОбмена.Формат);
					ОтветИзСервисаВрег = ВРег(Ответ);
					ТекстПолеФайла = "";
					Для Каждого ЭлМас Из МассивПолей Цикл
						ТекПоле = СокрЛП(ВРег(ЭлМас));
						Если Найти(ОтветИзСервисаВрег,ТекПоле)=0 Тогда
							
							ТекстПолеФайла = ТекстПолеФайла + ?(ЗначениеЗаполнено(ТекстПолеФайла),", ","") + """"+СокрЛП(ЭлМас)+"""";
							
						КонецЕсли;
					КонецЦикла;
					 
					Если ЗначениеЗаполнено(ТекстПолеФайла) Тогда
						НовСтрОшибки = ТаблицаОшибок.Добавить();
						НовСтрОшибки.ПолеФайла = НСтр("ru='Ответ из сервиса на отправку файла "+ДанныеФайла.ИмяФайла+" не содежит обязательные поля: "+ТекстПолеФайла+"'");
						НовСтрОшибки.Ошибка = НСтр("ru='Вероятно файл не был получен web-сервисом, проверьте правильность настроек обмена (адрес ресурса, порт), настроек доступа к Интернет.'");
						
						СтрОбъектовОбмена.Описание = "Подробно...";
						СтрОбъектовОбмена.ОписаниеОшибки = ЗначениеВСтрокуВнутр(ТаблицаОшибок);
					КонецЕсли;

				КонецЕсли;
							
			Иначе
				СтрОбъектовОбмена.ОтветWebСервиса = Новый ХранилищеЗначения(Ответ,Новый СжатиеДанных(9));
				МассивПолей = СоответствиеПолейФорматов.Получить(СтрОбъектовОбмена.Формат);
				ОтветИзСервисаВрег = ВРег(Ответ);
				ТекстПолеФайла = "";
				Для Каждого ЭлМас Из МассивПолей Цикл
					ТекПоле = СокрЛП(ВРег(ЭлМас));
					Если Найти(ОтветИзСервисаВрег,ТекПоле)=0 Тогда
						
						ТекстПолеФайла = ТекстПолеФайла + ?(ЗначениеЗаполнено(ТекстПолеФайла),", ","") + """"+СокрЛП(ЭлМас)+"""";
						
					КонецЕсли;
				КонецЦикла;
				 
				Если ЗначениеЗаполнено(ТекстПолеФайла) Тогда
					НовСтрОшибки = ТаблицаОшибок.Добавить();
					НовСтрОшибки.ПолеФайла = НСтр("ru='Ответ из сервиса не содежит обязательные поля: "+ТекстПолеФайла+"'");
					НовСтрОшибки.Ошибка = НСтр("ru='Вероятно файл не был получен web-сервисом, проверьте правильность настроек обмена (адрес ресурса, порт), настроек доступа к Интернет.'");
					
					СтрОбъектовОбмена.Описание = "Подробно...";
					СтрОбъектовОбмена.ОписаниеОшибки = ЗначениеВСтрокуВнутр(ТаблицаОшибок);
				Иначе
					СтрОбъектовОбмена.Описание = "";
					СтрОбъектовОбмена.ОписаниеОшибки = "";
				КонецЕсли;
			КонецЕсли;

		Исключение
			//добавить описание ошибки в документ
			ТекОбъект.Записать(РежимЗаписиДокумента.Запись);
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='"+ОписаниеОшибки()+"'"));
			КоличествоНеОтправленных = КоличествоНеОтправленных + 1;
			ТекстОшибки = ТекстОшибки + Символы.ПС + ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке());
			Возврат;
		КонецПопытки;
									
	КонецЦикла;
	
	Если ИдентификаторВидаОбмена = "GY" Тогда
		Если ДополнительныеПараметры = Неопределено Тогда
			ДополнительныеПараметры = Новый Структура;
		КонецЕсли;
		
		ТребуетсяСледующаяИтерация = Ложь;
		
		ГосУслуги.ОбработатьОтветИзСервиса_1_16(ТекОбъект,ТребуетсяСледующаяИтерация);
		
		ДополнительныеПараметры.Вставить("ТребуетсяСледующаяИтерация",ТребуетсяСледующаяИтерация);
		
	ИначеЕсли ИдентификаторВидаОбмена = "RFI" Тогда
		РеестрИмуществаСервер.ОбработатьОтветИзСервиса(ТекОбъект);
	// Для совместимости
	ИначеЕсли ЗначениеЗаполнено(ИмяОбщегоМодуляОбработки) Тогда
		Если ВРег(ИмяОбщегоМодуляОбработки) = ВРег("Госуслуги") Тогда
			ГосУслуги.ОбработатьОтветИзСервиса(ТекОбъект);
		ИначеЕсли ВРег(ИмяОбщегоМодуляОбработки) = ВРег("РеестрИмущества") Тогда 
			РеестрИмуществаСервер.ОбработатьОтветИзСервиса(ТекОбъект);
		КонецЕсли;
	//
	КонецЕсли;

    ТекОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры      

