
#Область ПрограммныйИнтерфейс

Функция ПолучитьАмортизационныеГруппы(КодПоОКОФ) Экспорт

	Возврат УправлениеОсновнымиСредствамиПовтИсп.ПолучитьАмортизационныеГруппы(КодПоОКОФ);
	
КонецФункции	

Функция ПолучитьНомерИнвентарнойКарточи(Документ, Организация, ОсновноеСредство, 
	ДопПараметры = Неопределено, Период, НовыеНомера = Неопределено, Отказ = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("Ссылка"			, Документ);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки
	|ИЗ
	|	РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(
	|			,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И Регистратор <> &Ссылка) КАК НомераИнвентарныхКарточекСрезПоследних
	|ГДЕ
	|	НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки <> """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Если номер карточки уже присвоен (например, это библиотечный фонд) то возвращаем его
	Если Выборка.Следующий() Тогда
		Возврат Выборка.НомерИнвентарнойКарточки;
	КонецЕсли;
	
	// Учтем номера карточек, которые уже определены в непроведенных документах, но еще не отражены в регистре
	// сведений "Номера инвентарных карточек"
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК Документ,
	|	ОсновныеСредства.НомерИнвентарнойКарточки
	|ПОМЕСТИТЬ НомераКарточек
	|ИЗ
	|	Документ.ПереводГотовойПродукцииВСоставОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка.Организация = &Организация
	|	И НЕ ОсновныеСредства.Ссылка.ПометкаУдаления
	|	И НЕ ОсновныеСредства.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка,
	|	ОсновныеСредства.НомерИнвентарнойКарточки
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовИК.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка.Организация = &Организация
	|	И НЕ ОсновныеСредства.Ссылка.ПометкаУдаления
	|	И НЕ ОсновныеСредства.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка,
	|	ОсновныеСредства.НомерИнвентарнойКарточки
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка.Организация = &Организация
	|	И НЕ ОсновныеСредства.Ссылка.ПометкаУдаления
	|	И НЕ ОсновныеСредства.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка,
	|	ОсновныеСредства.НомерИнвентарнойКарточки
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОСИК.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка.Организация = &Организация
	|	И НЕ ОсновныеСредства.Ссылка.ПометкаУдаления
	|	И НЕ ОсновныеСредства.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка,
	|	ОсновныеСредства.НомерИнвентарнойКарточки
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка.Организация = &Организация
	|	И НЕ ОсновныеСредства.Ссылка.ПометкаУдаления
	|	И НЕ ОсновныеСредства.Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НомераКарточек.НомерИнвентарнойКарточки
	|ИЗ
	|	НомераКарточек КАК НомераКарточек
	|ГДЕ
	|	НомераКарточек.Документ <> &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	НомераКарточек.НомерИнвентарнойКарточки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 0 Тогда
		Если НовыеНомера = Неопределено Тогда
			НовыеНомера = Новый Массив;
		КонецЕсли;	
		
		Пока Выборка.Следующий() Цикл
			НовыеНомера.Добавить(Выборка.НомерИнвентарнойКарточки);
		КонецЦикла;	
	КонецЕсли;	
		
	// Проверяем порядок и способ нумерации
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Организация, Период);
	
	Если УчетнаяПолитика.ПорядокНумерацииИнвентарныхКарточек = 1 Тогда // Сквозная
		
		ПоследнийНомер = РегистрыСведений.НомераИнвентарныхКарточек.ПоследнийНомер(Организация,, НовыеНомера);
		
		Если ЗначениеЗаполнено(ПоследнийНомер) Тогда
			ПараметрыНомера = ПолучитьПараметрыНомера(ПоследнийНомер);
		Иначе
			ПараметрыНомера = Новый Структура("Префикс,Номер,ДлинаНомера", "", 0, 5);
		КонецЕсли;
		
		ПараметрыНомера.Номер = ПараметрыНомера.Номер + 1;
		
		Номер = ПолучитьНомерИзПараметров(ПараметрыНомера);
		
	ИначеЕсли УчетнаяПолитика.ПорядокНумерацииИнвентарныхКарточек = 2 Тогда // Номер карточки = инвентарный номер
		
		Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("ИнвентарныйНомер") Тогда
			Номер = СокрП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДопПараметры.ИнвентарныйНомер, "Код"));
		Иначе
			Номер = "";
		КонецЕсли;
		
	ИначеЕсли УчетнаяПолитика.ПорядокНумерацииИнвентарныхКарточек = 3 Тогда // По шаблону
		
		Шаблон = УчетнаяПолитика.ШаблонНомеровИнвентарныхКарточек;
		Формула = Справочники.ШаблоныНомеровНФА.ФормулаПрефикса(Шаблон.ВидШаблона, Шаблон.СоставШаблона.Выгрузить());
		Формула = Справочники.ШаблоныНомеровНФА.ПолнаяФормулаПрефикса(Формула);
		
		ПараметрыПрефикса = Новый Структура("ОсновноеСредство,Дата,ИФО,КФО,КПС,СчетУчета", ОсновноеСредство, Период);
		Если ДопПараметры <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ПараметрыПрефикса, ДопПараметры);
		КонецЕсли;
		
		Префикс = Справочники.ШаблоныНомеровНФА.ПрефиксНомера(Формула, ПараметрыПрефикса);
		
		ДанныеШаблона = Новый Структура("Префикс,БезУчетаПрефикса,ДлинаНомера", Префикс, Шаблон.БезУчетаПрефикса, Шаблон.ДлинаНомера);
		
		ПоследнийНомер = РегистрыСведений.НомераИнвентарныхКарточек.ПоследнийНомер(Организация, ДанныеШаблона, НовыеНомера);
		ПоследнийНомерЧислом = ?(ЗначениеЗаполнено(ПоследнийНомер), Число(ПоследнийНомер), 0);	
		ПараметрыНомера = Новый Структура("Префикс,Номер,ДлинаНомера", Префикс, ПоследнийНомерЧислом + 1, Шаблон.ДлинаНомера);
		
		Номер = ПолучитьНомерИзПараметров(ПараметрыНомера);
		
	Иначе // Авоматическая нумерация не включена
		
		Номер = "";
		
	КонецЕсли;
	
	Возврат Номер;
	
КонецФункции

Функция ПолучитьПараметрыНомера(Номер = "")
	
	Результат = Новый Структура("Префикс,Номер,ДлинаНомера", "", 0, 0); 
	
	Если ПустаяСтрока(Номер) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДлинаКода = СтрДлина(Номер);
		
	Для Сч = 1 По ДлинаКода Цикл
		Символ = Сред(Номер, ДлинаКода - Сч + 1, 1);
		Если Найти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Результат.ДлинаНомера	= Сч-1;
	Результат.Префикс		= Лев(Номер, ДлинаКода - Результат.ДлинаНомера);
	НомерСтрокой			= Прав(Номер, Результат.ДлинаНомера);
	Результат.Номер			= ?(ПустаяСтрока(НомерСтрокой), 0, Число(НомерСтрокой));
	
	Возврат Результат; 
	
КонецФункции

Функция ПолучитьНомерИзПараметров(ПараметрыНомера, МинимальнаяДлинна = 0, Отказ = Ложь)
	
	НомерСтрокой = Формат(ПараметрыНомера.Номер, "ЧГ=");
	ДлинаНовогоНомера = СтрДлина(НомерСтрокой);
	
	Если ДлинаНовогоНомера > ПараметрыНомера.ДлинаНомера Тогда
		МинимальнаяДлинна = Макс(МинимальнаяДлинна, ДлинаНовогоНомера + СтрДлина(ПараметрыНомера.Префикс));
		Отказ = Истина;
	КонецЕсли;
	
	НовыйНомер = ПараметрыНомера.Префикс + Формат(ПараметрыНомера.Номер, "ЧВН=; ЧГ=; ЧЦ=" + ПараметрыНомера.ДлинаНомера);

	Возврат НовыйНомер;
		
КонецФункции

Функция СинонимыДокументов173н(СтарыйДокумент, ИмяНовогоДокумента) Экспорт
	
	СинонимСтарогоДокумента = СтарыйДокумент.Метаданные().Синоним;
	СинонимНовогоДокумента = Метаданные.Документы[ИмяНовогоДокумента].Синоним;
	
	Результат = Новый Структура("СинонимСтарогоДокумента,СинонимНовогоДокумента", СинонимСтарогоДокумента, СинонимНовогоДокумента);
	
	Возврат Результат;
	
КонецФункции

// Если на основании одного документа можно ввести несколько целевых документов. 
// Функция по данным документа-основания формирует массив разделителей. Каждый разделитель - один целевой документ.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - ссылка на документ-основание
//  ИмяЦелевогоДокумента - Строка - имя типа документа, который вводится на основании, 
//  								как оно задано в конфигураторе
//  СсылкаЦелевогоДокумента - ДокументСсылка - ссылка на документ, из которого вызывается ввод на основании.
//  	Используется для исключения объектов документа при анализе объектов, данные по которым уже были введены ранее								
//
//	Возвращаемое значение:
//	 - Структура с ключами:
//		* Разделители, значение - Массив из Структура - содержит данные таблицы разделителей. 
//			Ключи соответствуют именам колонок
//		* ЗаголовкиКолонок, значение - Структура - содержит ключи по именам колонок таблицы значений, 
//			значения - заголовки колонок
Функция ТаблицаРазделителейДокументов(ДокументОснование, ИмяЦелевогоДокумента, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	ДанныеРазделителей = 
		Документы[ИмяЦелевогоДокумента].ТаблицаРазделителейДокументов(ДокументОснование, СсылкаЦелевогоДокумента);
		
	Если ТипЗнч(ДанныеРазделителей) = Тип("Структура") Тогда
		ТабРазделителей = ДанныеРазделителей.Разделители;
	Иначе	
		ТабРазделителей = ДанныеРазделителей;
	КонецЕсли;
			
	МассивРазделителей = Новый Массив;
	
	Для каждого СтрокаРазделителя из ТабРазделителей Цикл
		СтрокаМассива = Новый Структура;
		Для каждого Колонка из ТабРазделителей.Колонки Цикл
			СтрокаМассива.Вставить(Колонка.Имя, СтрокаРазделителя[Колонка.Имя]);
		КонецЦикла;	                                                            
		МассивРазделителей.Добавить(СтрокаМассива);
	КонецЦикла;	
	
	СтруктураРазделителей = ДанныеРазделителей;
	Если ТипЗнч(СтруктураРазделителей) = Тип("Структура") Тогда
		СтруктураРазделителей.Вставить("Разделители", МассивРазделителей);
	Иначе	
		СтруктураРазделителей = Новый Структура("Разделители, ЗаголовкиКолонок");
		СтруктураРазделителей.Вставить("Разделители", МассивРазделителей);
		СтруктураРазделителей.Вставить("ЗаголовкиКолонок", Новый Структура);
		
		Для каждого Колонка из МассивРазделителей Цикл
			Для каждого Заголовок из Колонка Цикл
				СтруктураРазделителей.ЗаголовкиКолонок.Вставить(Заголовок.Ключ, Заголовок.Ключ);
			КонецЦикла;	
			Прервать;
		КонецЦикла;	
	КонецЕсли;	
	
	Возврат(СтруктураРазделителей);
КонецФункции	

// Получает данные "Должность, Фамилия,Имя Отчество" сотрудника-члена комиссии 
//
// Параметры:
//  Сотрудник - СправочникСсылка.Сотрудники - член комиссии или председатель
//  Дата - Дата
//
// Возвращаемое значение:
//  - Структура - структура с полями:
//   * Фамилия, 
//   * Имя, 
//   * Отчество, 
//   * Должность 
Функция ДанныеЧленаКомиссии(Сотрудник, Дата) Экспорт
	Возврат(Справочники.Сотрудники.ДанныеСотрудника(Сотрудник, "Фамилия, Имя, Отчество, Должность", Дата)); 
КонецФункции	

#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

Функция ПолучитьДанныеОС(Знач Параметры, НаДату) Экспорт
	Перем СчетУчета;
	Перем ЗначениеСвойства;
	
	Результат = Новый Структура;
	
	Если ЗначениеЗаполнено(Параметры.ДанныеОбъекта) Тогда
		ТребуемыеДанные = "";
		Для каждого КлючИЗначение Из Параметры.ДанныеОбъекта Цикл
			Если КлючИЗначение.Ключ = "СчетУчета" Тогда
				СчетУчета = УправлениеОсновнымиСредствами.СчетУчетаОС(Параметры.ОсновноеСредство, НаДату);
				Результат.Вставить(КлючИЗначение.Ключ, СчетУчета);
			Иначе
				ТребуемыеДанные = ТребуемыеДанные + "," + КлючИЗначение.Ключ;
			КонецЕсли;	
		КонецЦикла; 
		Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.ОсновноеСредство, Сред(ТребуемыеДанные, 2));
		Для каждого КлючИЗначение Из Параметры.ДанныеОбъекта Цикл
			Данные.Свойство(КлючИЗначение.Ключ, ЗначениеСвойства);
			Результат.Вставить(КлючИЗначение.Значение, ЗначениеСвойства);
		КонецЦикла; 
	КонецЕсли;
	
	Если Параметры.Свойство("УчетПоКПС") Тогда
		Если (Результат.Свойство("СчетУчета", СчетУчета) ИЛИ Параметры.Свойство("СчетУчета", СчетУчета)) И ЗначениеЗаполнено(СчетУчета) Тогда
			Результат.Вставить(Параметры.УчетПоКПС, БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчета).УчетПоКПС);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

#КонецОбласти
