
#Область ПрограммныйИнтерфейс

Процедура ПолучитьОтветыИзОчередиЕСМВ(Организация, ТипЗапроса = "", Форма = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура;	
	КонецЕсли;
	
	Попытка
		Действие = ПредопределенноеЗначение("Перечисление.ДействияПередачиЕСМВСМЭВ.Получение");
		ПараметрыЗапроса = ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьПараметрыЗапроса(Организация, Действие, ТипЗапроса);
		ПараметрыЗапроса.Вставить("СообщатьПользователю", НЕ ДополнительныеПараметры.Свойство("СообщатьПользователю") ИЛИ ДополнительныеПараметры.СообщатьПользователю);
		Если ДополнительныеПараметры.Свойство("ВидыСведений") Тогда
			ПараметрыЗапроса.Вставить("ВидыСведений", ДополнительныеПараметры.ВидыСведений);	
		КонецЕсли;	
		Если ПараметрыЗапроса.Отказ Тогда
			Если ПараметрыЗапроса.СообщатьПользователю Тогда
				ОчиститьСообщения();
				ОбщегоНазначенияКлиент.СообщитьПользователю(ПараметрыЗапроса.ТекстОшибки);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		ПараметрыЗапроса.Вставить("Форма", Форма);
		ПараметрыЗапроса.Вставить("Пакет", Неопределено);
		
		Если ПараметрыЗапроса.ВидыСведений.Количество() Тогда 
			СтрокаВидСведений = ПараметрыЗапроса.ВидыСведений[0];
			
			ТекстЗапроса = "		
			|        <typ:getMessagesRequest>
			|            <typ:targetSystemId>" + СтрокаВидСведений.ИДПолучателя + "</typ:targetSystemId>
			|            <typ:count>5</typ:count>
			|        </typ:getMessagesRequest>";
			
			ПараметрыЗапроса.Вставить("КодВидаСведений", СтрокаВидСведений.КодВидаСведений); 
			ПараметрыЗапроса.Вставить("ВидСведений", СтрокаВидСведений.ВидСведений);
			ПараметрыЗапроса.Вставить("ТипДокумента", СтрокаВидСведений.ТипДокумента);
			
			ПодписатьТело(ТекстЗапроса, ПараметрыЗапроса); 	
		КонецЕсли;
		
	Исключение 
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());   
		МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
		МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ПолучениеОтветовИзОчередиЕСМВКлиент'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
		"Ошибка","Тип опроса очереди: " + ?(ЗначениеЗаполнено(ТипЗапроса), ТипЗапроса, "Все")  + ". 
		|" + ТекстОшибки);
		Если НЕ ДополнительныеПараметры.Свойство("СообщатьПользователю") ИЛИ ДополнительныеПараметры.СообщатьПользователю Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Ответы не получены. Подробности см. в журнале регистрации.'"));
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

// Выполняет отправку присоединенных файлов указанного пакета в МСД ПУиО.
//
// Параметры:
//  Пакет	- 	ДокументСсылка.ПакетыДанныхДляМСД
//
Процедура ОтправитьФайлыПакета(Организация, МассивФайлов, Форма = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт  
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура;	
	КонецЕсли;
	
	Попытка
		Если ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьОсновнойСпособПередачиДанных()= ПредопределенноеЗначение("Перечисление.СпособыПередачиДанныхВМСД.ВнешнийПОИБ") Тогда
			ОтправитьФайлыПакетаЕСМВ(Организация, МассивФайлов, Форма, ДополнительныеПараметры);	
		Иначе
			//СМЭВ
		КонецЕсли;
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
		МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = ОтправкаФайловЕСМВКлиент'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
		"Ошибка",ТекстОшибки);  
		Если НЕ ДополнительныеПараметры.Свойство("СообщатьПользователю") ИЛИ ДополнительныеПараметры.СообщатьПользователю Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Пакет не отправлен. Подробности см. в журнале регистрации.'"));
		КонецЕсли;
	КонецПопытки;	
	
КонецПроцедуры  

Процедура ОтправитьЗапросНаСверку(Организация, ТипЗапроса, Форма = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Попытка
		Если ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьОсновнойСпособПередачиДанных() = ПредопределенноеЗначение("Перечисление.СпособыПередачиДанныхВМСД.ВнешнийПОИБ") Тогда
			ОтправитьЗапросНаСверкуЕСМВ(Организация, ТипЗапроса, Форма, ДополнительныеПараметры);	
		Иначе
			//СМЭВ
		КонецЕсли;
	Исключение 
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
		МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ОтправкаФайловЕСМВКлиент'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
		"Ошибка", ТекстОшибки);
		Если НЕ ДополнительныеПараметры.Свойство("СообщатьПользователю") ИЛИ ДополнительныеПараметры.СообщатьПользователю Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Запрос на сверку не отправлен. Подробности см. в журнале регистрации.'"));
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбработатьОчередьЗаданий(Организация, ДополнительныеПараметры) Экспорт
	
	ТаблицаЗаданий = ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьЗаданияОбмена(Организация);
	
	ВидСведенийТекущий = Неопределено;
	Для каждого Задание Из ТаблицаЗаданий Цикл
		
		Если Задание.ВидСведений = ВидСведенийТекущий Тогда			
			ОтразитьДанныеЗадания(Организация, Задание, ПредопределенноеЗначение("Перечисление.СтатусыЗаданийМСД.Отменено"));			
		Иначе
			Попытка
				ВидСведенийТекущий = Задание.ВидСведений;
				Если Задание.ВидСведений = ПредопределенноеЗначение("Перечисление.ВидыСведенийЕСМВСМЭВ.СрокиПредоставления") Тогда
					ДополнительныеПараметры.Вставить("ГодЗапроса", Год(ОбщегоНазначенияКлиент.ДатаСеанса()));
					ОтправитьЗапросНаСверку(Организация, "Сроки",,ДополнительныеПараметры);	
				ИначеЕсли Задание.ВидСведений = ПредопределенноеЗначение("Перечисление.ВидыСведенийЕСМВСМЭВ.Таксономия") Тогда
	                ОтправитьЗапросНаСверку(Организация, "Таксономия",,ДополнительныеПараметры);
				ИначеЕсли Задание.ВидСведений = ПредопределенноеЗначение("Перечисление.ВидыСведенийЕСМВСМЭВ.ПакетПередаваемыхДанных") Тогда
					МассивФайлов = ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьМассивфайловПакета(Организация);
					ОтправитьФайлыПакета(Организация, МассивФайлов,,ДополнительныеПараметры);
				КонецЕсли;
				ОтразитьДанныеЗадания(Организация, Задание, ПредопределенноеЗначение("Перечисление.СтатусыЗаданийМСД.Обработано")); 
			Исключение
				ОтразитьДанныеЗадания(Организация, Задание, ПредопределенноеЗначение("Перечисление.СтатусыЗаданийМСД.Ошибка")); 	
			КонецПопытки;	
		КонецЕсли; 
		
	КонецЦикла;	
		
КонецПроцедуры

Процедура ОтразитьДанныеЗадания(Организация, Задание, Статус)
	
	СтруктураЗадания = Новый Структура;
	СтруктураЗадания.Вставить("Период", ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьУниверсальноеВремя());
	СтруктураЗадания.Вставить("Организация", Организация); 
	СтруктураЗадания.Вставить("ИдентификаторЗадания", Задание.ИдентификаторЗадания);	
	СтруктураЗадания.Вставить("ВидСведений", Задание.ВидСведений);
	СтруктураЗадания.Вставить("Статус", Статус); 
	
	ИнтеграцииЕСМВСМЭВВызовСервера.ОтразитьДанныеЗадания(СтруктураЗадания); 
			
КонецПроцедуры	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтправитьПодтверждениеЕСМВ(ДополнительныеПараметры)
	
	ПараметрыЗапроса = ДополнительныеПараметры.ПараметрыЗапроса;
	ПараметрыПередачи = ПолучитьПараметрыПередачи(ПараметрыЗапроса);
	ИнтеграцииЕСМВСМЭВВызовСервера.ДополнитьПараметрыПодтверждение(ПараметрыПередачи);
	Если ПараметрыЗапроса.Свойство("Форма") Тогда
		ПараметрыПередачи.Вставить("Форма", ПараметрыЗапроса.Форма);
	КонецЕсли;
	
	Если ПараметрыПередачи.Сообщения.Количество() ТОгда
		Попытка 			 			
			ТекстЗапроса = "<typ:ackMessagesRequest>";
			
			Для каждого СтрокаСообщение Из ПараметрыПередачи.Сообщения Цикл
				
				ТекстЗапроса = ТекстЗапроса + "
				|    <typ:ackMessage>
				|        <typ:senderSystemId>" + СтрокаСообщение.Отправитель + "</typ:senderSystemId>
				|        <typ:targetSystemId>" + СтрокаСообщение.Получатель + "</typ:targetSystemId>
				|        <typ:documentType>" + СтрокаСообщение.ТипДокумента + "</typ:documentType>
				|        <typ:packageId>" + СтрокаСообщение.ИдентификаторСообщения + "</typ:packageId>
				|                <typ:statusCode>0</typ:statusCode>
				|                <typ:statusMessage>Успешное выполнение</typ:statusMessage>
				|    </typ:ackMessage>"
				
			КонецЦикла;	
			
			ТекстЗапроса = ТекстЗапроса + "
			|</typ:ackMessagesRequest>";
			
			ПараметрыПередачи.Вставить("КодВидаСведений", ПараметрыПередачи.КодВидаСведений);				
			ПодписатьТело(ТекстЗапроса, ПараметрыПередачи); 
		Исключение 
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
			МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = ПолучениеОтветовИзОчередиЕСМВСервер'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
			"Ошибка","Тип опроса очереди: " + ?(ЗначениеЗаполнено(ПараметрыПередачи.ТипЗапроса), ПараметрыПередачи.ТипЗапроса, "Все")  + ". 
			|" + ТекстОшибки);
			Если НЕ ДополнительныеПараметры.ПараметрыЗапроса.Свойство("СообщатьПользователю") ИЛИ ДополнительныеПараметры.ПараметрыЗапроса.СообщатьПользователю Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Получение сообщений не подтверждено. Подробности см. в журнале регистрации.'")); 
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтправкаЗапросаКлиент(ДополнительныеПараметры)
	
	ТекстОтвета = "";
	
	Хост = ДополнительныеПараметры.ПараметрыЗапроса.АдресСервера;
	
	Заголовки = ДополнительныеПараметры.ЗаголовкиЗапроса;
	ИмяСервиса = ДополнительныеПараметры.ПараметрыЗапроса.ТочкаСервиса;
	Кодировка = "UTF-8";
	
	Попытка
		
		#Если ВебКлиент Тогда
			Соединение = Неопределено;
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Операция недоступна при работе в веб-клиенте'"));
			Возврат;
		#Иначе
			Прокси = Неопределено;
			
			ДДСертификата = ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьДДСертификата(ДополнительныеПараметры.ПараметрыЗапроса.ТранспортныйСертификат);
	        СертификатКриптографии = Новый СертификатКриптографии(ДДСертификата);
	        ЗащищенноеСоединениеOpenSSL = Новый ЗащищенноеСоединениеOpenSSL(СертификатКриптографии);
	        
	        Соединение = Новый HTTPСоединение(Хост,,,,Прокси,,ЗащищенноеСоединениеOpenSSL);
		
			ДополнительныеПараметры.ПараметрыЗапроса.Вставить("Период", ОбщегоНазначенияКлиент.ДатаУниверсальная());
			
			HTTPЗапрос = Новый HTTPЗапрос(ИмяСервиса, Заголовки);
			HTTPЗапрос.УстановитьТелоИзСтроки(СокрЛП(ДополнительныеПараметры.ТекстЗапроса), Кодировка);
			HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
			
			ЗаголовкиОтвета = HTTPОтвет.Заголовки;
			ТекстОтветаHTTP = HTTPОтвет.ПолучитьТелоКакСтроку(Кодировка);
			
			Если ДополнительныеПараметры.ПараметрыЗапроса.Свойство("ВключитьРежимОтладки") Тогда
				Если ДополнительныеПараметры.ПараметрыЗапроса.ВключитьРежимОтладки Тогда
					
					ЗаголовкиЗапроса = "";
					Для каждого СтрЗаголовкиЗапроса Из Заголовки Цикл
						ЗаголовкиЗапроса = ЗаголовкиЗапроса + "
						|" + СтрЗаголовкиЗапроса.Ключ + ": " + СтрЗаголовкиЗапроса.Значение;	
					КонецЦикла; 
					
					ЗаголовкиОтветаТекст = "";
					Для каждого СтрЗаголовкиОтвета Из ЗаголовкиОтвета Цикл
						ЗаголовкиОтветаТекст = ЗаголовкиОтветаТекст + "
						|" + СтрЗаголовкиОтвета.Ключ + ": " + СтрЗаголовкиОтвета.Значение;	
					КонецЦикла;

					
					ТекстРежимОтладки = СтрШаблон(НСтр("ru='Имя сервиса:
					|
					|%1
					|
					|Заголовки запроса: 
					|%2 
					|
					|Текст запроса:
					|
					|%3 
					|
					|Заголовки ответа: 
					|%4
					|
					|Текст ответа:
					|
					|%5
					|'"), ИмяСервиса, ЗаголовкиЗапроса, СокрЛП(ДополнительныеПараметры.ТекстЗапроса), ЗаголовкиОтветаТекст, ТекстОтветаHTTP);
					ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстРежимОтладки);
					
				КонецЕсли;	
			КонецЕсли;
			
			Если HTTPОтвет.КодСостояния >= 300 Тогда
				Попытка
					ЧтениеJSON = Новый ЧтениеJSON;
					ЧтениеJSON.УстановитьСтроку(ТекстОтветаHTTP);
					Результат = ПрочитатьJSON(ЧтениеJSON);
					ЧтениеJSON.Закрыть();
					СообщениеТекст = "";
					Если Результат.type = "INCORRECT_CLIENT_INFO_SYSTEM" Тогда
						СообщениеТекст = НСтр("ru = 'не найден клиент по указанному в настройках техническому наименованию внешней ИС'");
					ИначеЕсли Результат.type = "INVALID_REQUEST_HEADER" Тогда
						СообщениеТекст = НСтр("ru = 'в запросе отсутствует или некорректно указан обязательный заголовок'"); 
					ИначеЕсли Результат.type = "JINN_SERVICE" Тогда
						СообщениеТекст = НСтр("ru = 'в запросе указана некорректная подпись'");
					ИначеЕсли Результат.type = "INCORRECT_CHECKSUM" Тогда
						СообщениеТекст = НСтр("ru = 'в запросе указана некорректная контрольная сумма'");
					ИначеЕсли Результат.type = "DELAY_ERROR" Тогда
						СообщениеТекст = НСтр("ru = 'в запросе время превышает допустимое расхождение времени между значением в заголовке и временем получения запроса'");
					ИначеЕсли Результат.type = "OAUTH2_NOT_ALLOWED" Тогда
						СообщениеТекст = НСтр("ru = 'протокол OAuth 2.0 не разрешен для информационной системы'");
					ИначеЕсли Результат.type = "INCORRECT_CERTIFICATE" Тогда
						СообщениеТекст = НСтр("ru = 'в запросе указан некорректный сертификат'");
					ИначеЕсли Результат.type = "EMPTY_TARGET_INFO_SYSTEM_ROLES" Тогда
						СообщениеТекст = НСтр("ru = 'нет активных ролей'");
					ИначеЕсли Результат.type = "ACTION_NOT_ALLOWED" Тогда
						СообщениеТекст = НСтр("ru = 'в запросе указан некорректный метод'");
					ИначеЕсли Результат.type = "INTERNAL_SERVER_ERROR" Тогда
						СообщениеТекст = НСтр("ru = 'в запросе указан некорректный хост'");
					КонецЕсли;
					Если ЗначениеЗаполнено(СообщениеТекст) Тогда
						ТекстОшибки = СтрШаблон(НСтр("ru = 'Ошибка обработки команды по причине: %1. Подробности см. в журнале регистрации.'"), СообщениеТекст);
						Если ДополнительныеПараметры.ПараметрыЗапроса.Свойство("ВключитьРежимОтладки") Тогда
							Если НЕ ДополнительныеПараметры.ПараметрыЗапроса.ВключитьРежимОтладки Тогда
								ОчиститьСообщения(); 
							КонецЕсли;
						Иначе
							ОчиститьСообщения();
						КонецЕсли;	
						МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
						МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ОтправкаЗапросовЕСМВКлиент'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()), "Ошибка", ТекстОтветаHTTP);
						Если НЕ ДополнительныеПараметры.ПараметрыЗапроса.Свойство("СообщатьПользователю") ИЛИ ДополнительныеПараметры.ПараметрыЗапроса.СообщатьПользователю Тогда
							ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
						КонецЕсли;
						Возврат;
						
					Иначе
						ВызватьИсключение "Код состояния: " + HTTPОтвет.КодСостояния + "
						|" + ТекстОтветаHTTP;
						
					КонецЕсли;
					
				Исключение
					ВызватьИсключение "Код состояния: " + HTTPОтвет.КодСостояния + "
					|" + ТекстОтветаHTTP;
					
				КонецПопытки;
				
			КонецЕсли;
			
			МассивФайлов = Новый Массив;
			
			ContentType = ЗаголовкиОтвета.Получить("Content-Type");
			ПотокДанных = HTTPОтвет.ПолучитьТелоКакПоток();
			
			Если СтрНайти(ContentType, "multipart") > 0 Тогда
				Разделитель = ПолучитьРазделительСоставногоЗапроса(ЗаголовкиОтвета);
				ЗначениеStart = ПолучитьИмяStartЗапроса(ЗаголовкиОтвета);
				
				СтрРезультата = ПрочитатьСоставнойЗапрос(ЗначениеStart, Разделитель, ПотокДанных);
				Если СтрРезультата.Ошибка Тогда
					ВызватьИсключение СтрРезультата.ТекстОшибки; 
				КонецЕсли;
				
				МассивФайлов = СтрРезультата.МассивФайлов; 
				ЗакрытьПоток = Ложь;
			Иначе
				ПотокДанных.Перейти(0, ПозицияВПотоке.Начало);
				ЗакрытьПоток = Истина;
			КонецЕсли;
			
			Если МассивФайлов.Количество() Тогда
				Для каждого СтрокаФайл Из МассивФайлов Цикл
					ДД = СтрокаФайл.content;
					ДД = ПолучитьСтрокуИзДвоичныхДанных(base64Значение(ПолучитьСтрокуИзДвоичныхДанных(ДД)));
					СтрокаФайл.Вставить("ДД", ДД);
				КонецЦикла;
				
				ТекстОтвета = ПолучитьСтрокуИзДвоичныхДанных(base64значение(ПолучитьСтрокуИзДвоичныхДанных(СтрРезультата.ОсновнойЗапрос)));
				ЧтениеXML = Новый ЧтениеXML;
				ЧтениеXML.УстановитьСтроку(ТекстОтвета);
			Иначе
				ЧтениеXML = Новый ЧтениеXML;
				ЧтениеXML.ОткрытьПоток(ПотокДанных);
			КонецЕсли;
			
			Данные = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
			
			ОбъектBody = Данные.Body;
			
			ЧтениеXML.Закрыть();
			Если ЗакрытьПоток Тогда
				ПотокДанных.Закрыть();
			КонецЕсли;
			
			Отказ = Ложь;
			ПроверитьИОбработатьОшибку(ОбъектBody, ДополнительныеПараметры, Отказ);
			
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
			
			ДополнительныеПараметры.Вставить("ТекстОтвета", ТекстОтветаHTTP);
			ДополнительныеПараметры.Вставить("МассивФайлов", МассивФайлов);
			ОбработатьСообщение(ОбъектBody, ДополнительныеПараметры);
			
			Если ДополнительныеПараметры.ПараметрыЗапроса.Свойство("Форма") И НЕ ДополнительныеПараметры.ПараметрыЗапроса.Форма = Неопределено Тогда
				ОбновитьДинамическиеСписки(ДополнительныеПараметры.ПараметрыЗапроса.Форма);
			КонецЕсли; 
			
			ВидыСведений = ДополнительныеПараметры.ПараметрыЗапроса.ВидыСведений;
			Если ВидыСведений.Количество() Тогда
				ВидыСведений.Удалить(0);
			КонецЕсли;
			
			Если ВидыСведений.Количество() Тогда
				ТипЗапроса = ПолучитьТипЗапросаПоВидуСведений(ВидыСведений[0]);
				ПолучитьОтветыИзОчередиЕСМВ(ДополнительныеПараметры.ПараметрыЗапроса.Организация,ТипЗапроса,,Новый Структура("СообщатьПользователю, ВидыСведений", Ложь, ВидыСведений));
			КонецЕсли;	
			
		#КонецЕсли
		
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если ДополнительныеПараметры.ПараметрыЗапроса.Свойство("ВключитьРежимОтладки") Тогда
			Если НЕ ДополнительныеПараметры.ПараметрыЗапроса.ВключитьРежимОтладки Тогда
				ОчиститьСообщения(); 
			КонецЕсли;
		Иначе
			ОчиститьСообщения();
		КонецЕсли;
		МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
		МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ОтправкаЗапросовЕСМВКлиент'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
		"Ошибка", ТекстОшибки);
		Если НЕ ДополнительныеПараметры.ПараметрыЗапроса.Свойство("СообщатьПользователю") ИЛИ ДополнительныеПараметры.ПараметрыЗапроса.СообщатьПользователю Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Ошибка обработки команды. Подробности см. в журнале регистрации.'"));
		КонецЕсли; 
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтправитьЗапросНаСверкуЕСМВ(Организация, ТипЗапроса, Форма, ДополнительныеПараметры = Неопределено)
	
	Действие = ПредопределенноеЗначение("Перечисление.ДействияПередачиЕСМВСМЭВ.Отправка");
	ОтчетныйПериод = Неопределено;
	Если НЕ ДополнительныеПараметры = Неопределено Тогда
		Если ДополнительныеПараметры.Свойство("ОтчетныйПериод") Тогда
			ОтчетныйПериод = ДополнительныеПараметры.ОтчетныйПериод;
		КонецЕсли; 
	КонецЕсли;
	ПараметрыЗапроса = ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьПараметрыЗапроса(Организация, Действие, ТипЗапроса, ОтчетныйПериод);
	ПараметрыЗапроса.Вставить("СообщатьПользователю", ДополнительныеПараметры = Неопределено ИЛИ НЕ ДополнительныеПараметры.Свойство("СообщатьПользователю") ИЛИ ДополнительныеПараметры.СообщатьПользователю);
	Если ПараметрыЗапроса.Отказ Тогда
		Если ПараметрыЗапроса.СообщатьПользователю Тогда
			ОчиститьСообщения();
			ОбщегоНазначенияКлиент.СообщитьПользователю(ПараметрыЗапроса.ТекстОшибки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ПараметрыЗапроса.Вставить("Форма", Форма);
	ПараметрыЗапроса.Вставить("Пакет", Неопределено); 
	МассивФайлов = Новый Массив; 
	НужнаСверка = Истина;
	Если НЕ ДополнительныеПараметры = Неопределено Тогда 
		Если ДополнительныеПараметры.Свойство("ГодЗапроса") Тогда
			ПараметрыЗапроса.Вставить("ГодЗапроса", ДополнительныеПараметры.ГодЗапроса);
			ДатаЗапроса = Дата(ДополнительныеПараметры.ГодЗапроса,1,1);
		Иначе
			ДатаЗапроса = ПараметрыЗапроса.ДатаЗапроса;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("МассивФайлов") Тогда 
			Если НЕ ДополнительныеПараметры.МассивФайлов.Количество() Тогда
				Возврат;
			КонецЕсли;	
			МассивФайлов = ДополнительныеПараметры.МассивФайлов;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("НужнаСверка") Тогда 
			НужнаСверка = ДополнительныеПараметры.НужнаСверка;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("ВключитьРежимОтладки") Тогда 
			ПараметрыЗапроса.Вставить("ВключитьРежимОтладки", ДополнительныеПараметры.ВключитьРежимОтладки);
		КонецЕсли;
	Иначе
		ДатаЗапроса = ПараметрыЗапроса.ДатаЗапроса;
	КонецЕсли; 
	
	Если ТипЗапроса = "СтатусПакета" Тогда
		Если МассивФайлов.Количество() Тогда 
			Для каждого СтрокаФайл Из МассивФайлов Цикл
				ПараметрыЗапроса.Вставить("ИдентификаторДокумента", СтрокаФайл.ИдентификаторДокумента);
				Прервать;
			КонецЦикла;
		Иначе
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗапроса = "Таксономия" И НужнаСверка И ПараметрыЗапроса.ТаблицаРезультат = Неопределено Тогда
		ОчиститьСообщения();
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Настройка программы для получения таксономии через ЕСМВ не выполнена. 
		|Для получения таксономии заранее должны быть загружены сведения о сроках предоставления данных МСД.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
		Возврат;	
	КонецЕсли;
	
	Для каждого СтрокаВидСведений Из ПараметрыЗапроса.ВидыСведений Цикл
		
		Если ТипЗапроса = "СтатусПакета" Тогда
			ИдентификаторДокумента = ПараметрыЗапроса.ИдентификаторДокумента;
		Иначе
			ИдентификаторДокумента = Новый УникальныйИдентификатор();
			ПараметрыЗапроса.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
		КонецЕсли;
		ИдентификаторСообщения = Новый УникальныйИдентификатор();
		ПараметрыЗапроса.Вставить("ИдентификаторСообщения", ИдентификаторСообщения);
		
		ТекстЗапроса = "<typ:transferDocumentRequest xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xmlns=""http://www.roskazna.ru/eb/services/transferDocumentService/types"" versionId=""1.0"">
		|    <typ:header>
		|        <typ:packageId>" + ИдентификаторСообщения + "</typ:packageId>" + ?(ЗначениеЗаполнено(СтрокаВидСведений.ИДОтправителя), "
		|        <typ:senderSystemId>" + СтрокаВидСведений.ИДОтправителя + "</typ:senderSystemId>", "") + "
		|        <typ:targetSystemId>" + СтрокаВидСведений.ИДПолучателя + "</typ:targetSystemId>
		|        <typ:documentType>" + СтрокаВидСведений.ТипДокумента + "</typ:documentType>
		|        <typ:documentGuid>" + ИдентификаторДокумента + "</typ:documentGuid>
		|        <typ:creationDateTime>" + ПолучитьТекущуюУниверсальнуюДатуВISOUTC() + "</typ:creationDateTime>
		|        <typ:params>
		|            <typ:param name=""MSD-SRCode"" value=""" + ПараметрыЗапроса.КодПоРПБС + """/>
		|            <typ:param name=""MSD-ReportDate"" value=""" + ДатаЗапроса + """/>" + ?(ТипЗапроса = "СтатусПакета", "", " 
		|            <typ:param name=""MSD-NeedCheck"" value=""" + ?(НужнаСверка, "true", "false") + """/>" + ?(ТипЗапроса = "Сроки", "
		|            <typ:param name=""MSD-Hash"" value=""" + ПараметрыЗапроса.ХешСрокиПредоставления + """/>", ?(НужнаСверка," 
		|            <typ:param name=""MSD-TableResult"" value=""" + ПараметрыЗапроса.ТаблицаРезультат + """/>" , ""))) + "
		|        </typ:params>
		|    </typ:header>";
		
		ТекстЗапроса = ТекстЗапроса + "
		|</typ:transferDocumentRequest>";
		
		ПараметрыЗапроса.Вставить("КодВидаСведений", СтрокаВидСведений.КодВидаСведений);
		ПараметрыЗапроса.Вставить("ВидСведений", СтрокаВидСведений.ВидСведений);
		ПараметрыЗапроса.Вставить("ТипДокумента", СтрокаВидСведений.ТипДокумента);
		
		ПодписатьТело(ТекстЗапроса, ПараметрыЗапроса);
		
	КонецЦикла;
	
КонецПроцедуры 

Функция ПолучитьТекущуюУниверсальнуюДатуВISOUTC()
	Возврат ОбщегоНазначенияСлужебныйКлиентСервер.ПредставлениеЛокальнойДатыСоСмещением(ОбщегоНазначенияКлиент.ДатаУниверсальная(),0);	
КонецФункции	

Процедура ОтправитьФайлыПакетаЕСМВ(Организация, МассивФайлов, Форма = Неопределено, ДополнительныеПараметры = Неопределено)
	
		
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура;	
	КонецЕсли;

	Если МассивФайлов.Количество() Тогда
		Действие = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ДействияПередачиЕСМВСМЭВ.Отправка");
		ПараметрыЗапроса = ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьПараметрыЗапроса(Организация, Действие, "Пакет");
		ПараметрыЗапроса.Вставить("СообщатьПользователю", НЕ ДополнительныеПараметры.Свойство("СообщатьПользователю") ИЛИ ДополнительныеПараметры.СообщатьПользователю);
		Если ПараметрыЗапроса.Отказ Тогда 
			Если ПараметрыЗапроса.СообщатьПользователю Тогда
				ОчиститьСообщения();
				ОбщегоНазначенияКлиент.СообщитьПользователю(ПараметрыЗапроса.ТекстОшибки); 
			КонецЕсли;
			Возврат;
		КонецЕсли;
		ПараметрыЗапроса.Вставить("Форма", Форма);
	Иначе
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаВидСведений Из ПараметрыЗапроса.ВидыСведений Цикл
		
		ПараметрыЗапроса.Вставить("КодВидаСведений", СтрокаВидСведений.КодВидаСведений); 
		ПараметрыЗапроса.Вставить("ВидСведений", СтрокаВидСведений.ВидСведений);
		ПараметрыЗапроса.Вставить("ТипДокумента", СтрокаВидСведений.ТипДокумента);
		
		Для каждого СтрокаФайл Из МассивФайлов Цикл
			
			ИмяФайлаВложенияМТОМ = СтрокаФайл.ПолноеИмяФайла;
			ИдентификаторВложенияМТОМ = Новый УникальныйИдентификатор();
			ДанныеФайлаВложения = СтрокаФайл.ДанныеФайлаBase64;
			
			ХешФайлаВложения = ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьХешВложения(ДанныеФайлаВложения);
			
			ИдентификаторДокумента = Новый УникальныйИдентификатор(СтрокаФайл.ИдентификаторДокумента);
			ИдентификаторСообщения = Новый УникальныйИдентификатор(); 
			
			ПараметрыЗапроса.Вставить("Пакет", СтрокаФайл.ДанныеВыборки.Пакет);
			ПараметрыЗапроса.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
			ПараметрыЗапроса.Вставить("ИдентификаторСообщения", ИдентификаторСообщения);
			ПараметрыЗапроса.Вставить("ИмяФайлаВложенияМТОМ", ИмяФайлаВложенияМТОМ);
			ПараметрыЗапроса.Вставить("ИдентификаторВложенияМТОМ", ИдентификаторВложенияМТОМ);
			ПараметрыЗапроса.Вставить("ДанныеФайлаВложения", ДанныеФайлаВложения);
			ПараметрыЗапроса.Вставить("ДанныеВыборки", СтрокаФайл.ДанныеВыборки); 
			
			ПараметрыПакета = МодульСбораДанныхВызовСервера.ПолучитьПараметрыПакета(СтрокаФайл.ДанныеВыборки.Пакет);			
			ТекстПараметрыПакета =
					"            <typ:param name=""MSD-DateTimeStartFormationISSI"" value=""" + ПараметрыПакета.ДатаВремяНачалаФормированияИССИ + """/>" + "
					|            <typ:param name=""MSD-DateTimeEndFormationISSI"" value=""" + ПараметрыПакета.ДатаВремяЗавершенияФормированияИССИ + """/>" + "
					|            <typ:param name=""MSD-DateTimeSignedISSI"" value=""" + ПараметрыПакета.ДатаВремяПодписанияИССИ + """/>" + "
					|            <typ:param name=""MSD-DateTimeSendingISSI"" value=""" + ПараметрыПакета.ДатаВремяОтправкиИССИ + """/>";
	
			
			ТекстЗапроса = "<typ:transferDocumentRequest xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xmlns=""http://www.roskazna.ru/eb/services/transferDocumentService/types"" versionId=""1.0"">
			|    <typ:header>
			|        <typ:packageId>" + ИдентификаторСообщения + "</typ:packageId>" + ?(ЗначениеЗаполнено(СтрокаВидСведений.ИДОтправителя), "
			|        <typ:senderSystemId>" + СтрокаВидСведений.ИДОтправителя + "</typ:senderSystemId>", "") + "
			|        <typ:targetSystemId>" + СтрокаВидСведений.ИДПолучателя + "</typ:targetSystemId>
			|        <typ:documentType>" + СтрокаВидСведений.ТипДокумента + "</typ:documentType>
			|        <typ:documentGuid>" + ИдентификаторДокумента + "</typ:documentGuid>
			|        <typ:creationDateTime>" + ПолучитьТекущуюУниверсальнуюДатуВISOUTC() + "</typ:creationDateTime>
			|        <typ:params>
			|            <typ:param name=""MSD-SRCode"" value=""" + ПараметрыЗапроса.КодПоРПБС + """/>" 
			+ ТекстПараметрыПакета + "		
			|        </typ:params>
			|    </typ:header>";
			
			//Вложение МТОМ
			ТекстЗапроса = ТекстЗапроса + "
			|    <typ:attachments>
			|        <typ:attachment>
			|            <typ:fileName>" + ИмяФайлаВложенияМТОМ + "</typ:fileName>
			|            <typ:contentType>application/zip</typ:contentType>
			|            <typ:content><inc:Include href=""cid:" + ИдентификаторВложенияМТОМ + """ xmlns:inc=""http://www.w3.org/2004/08/xop/include""/></typ:content>
			|            <typ:params>
			|                <typ:param name=""hash_oid"" value=""2.16.840.1.101.3.4.2.1""/>
			|                <typ:param name=""hash_hexdigest"" value=""" + ХешФайлаВложения + """/>
			|            </typ:params>
			|        </typ:attachment>
			|</typ:attachments>";
			
			ТекстЗапроса = ТекстЗапроса + "
			|</typ:transferDocumentRequest>";  
			
			ПодписатьТело(ТекстЗапроса, ПараметрыЗапроса); 
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЕСМВДобавитьТелоЗапросВложениеМТОМ(ТекстЗапроса, ПараметрыЗапроса)
	
	ТекстЗапроса = "
	|--uuid:" + ПараметрыЗапроса.ИдентификаторДокумента + "
	|Content-Type: application/xop+xml; charset=UTF-8; type=""text/xml""
	|Content-Transfer-Encoding: 8bit
	|Content-ID: <rootpart@soapui.org>
	|
	|" + ТекстЗапроса + "
	|
	|--uuid:" + ПараметрыЗапроса.ИдентификаторДокумента + "
	|Content-Type: application/zip; charset=UTF-8
	|Content-Transfer-Encoding: base64
	|Content-ID: <" + ПараметрыЗапроса.ИдентификаторВложенияМТОМ + ">
	|Content-Disposition: attachment; name=""" + ПараметрыЗапроса.ИмяФайлаВложенияМТОМ + """; filename=""" + ПараметрыЗапроса.ИмяФайлаВложенияМТОМ + """
	|
	|" + ПараметрыЗапроса.ДанныеФайлаВложения + "
	|--uuid:" + ПараметрыЗапроса.ИдентификаторДокумента + "--";
	
КонецПроцедуры 

Процедура ОбновитьДинамическиеСписки(Форма)  
	
	Если Форма.ИмяФормы = "Обработка.ЗагрузкаТаксономии.Форма.Форма" Тогда
		Форма.Элементы.ИсторияЗапросовСроки.Обновить();
		Форма.Элементы.ИсторияЗапросовТаксономия.Обновить();
		Форма.Элементы.ИсторияОбменаСроки.Обновить(); 
		Форма.Элементы.ИсторияОбменаТаксономия.Обновить();
	Иначе
		Форма.ТекущийСтатус = МодульСбораДанныхВызовСервера.ПолучитьТекущийСтатусПакета(Форма.Объект.Ссылка); 
		Форма.Элементы.ФормаСформироватьВыгрузку.Доступность = Ложь; 
		Форма.Элементы.СтатусыПереданныхПакетов.Обновить(); 
		Форма.Элементы.СведенияОПротоколах.Обновить();
		Форма.Элементы.ИсторияОбмена.Обновить();
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьПараметрыПередачи(ПараметрыЗапроса)
	
	МодульОбщегоНазначенияСлужебныйКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ОбщегоНазначенияСлужебныйКлиент");
	ПараметрыПередачи = МодульОбщегоНазначенияСлужебныйКлиент.СкопироватьСтруктуру(ПараметрыЗапроса, Ложь);
	ПараметрыПередачи.Форма = Неопределено;
	Возврат ПараметрыПередачи; 
	
КонецФункции

#Область ОбработкаСообщений

Процедура ПроверитьИОбработатьОшибку(ОбъектBody, ДополнительныеПараметры, Отказ)
	
	Если НЕ ОбъектBody.Свойства().Получить("Fault") = Неопределено Тогда 
		ТекстОшибки = ОбъектBody.Fault.faultcode + ": " + ОбъектBody.Fault.faultstring;
		МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
		МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru='ПолучениеОтветовИзОчередиЕСМВКлиент'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
		"Ошибка","Тип опроса очереди: " + ?(ЗначениеЗаполнено(ДополнительныеПараметры.ПараметрыЗапроса.ТипЗапроса), ДополнительныеПараметры.ПараметрыЗапроса.ТипЗапроса, "Все")  + ". 
		|" + ТекстОшибки);
		Если НЕ ДополнительныеПараметры.ПараметрыЗапроса.Свойство("СообщатьПользователю") ИЛИ ДополнительныеПараметры.ПараметрыЗапроса.СообщатьПользователю Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Ошибка обработки команды. Подробности см. в журнале регистрации.'")); 
		КонецЕсли;
		Отказ = Истина;		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьСообщение(ОбъектBody, ДополнительныеПараметры)
	
	Если ДополнительныеПараметры.ПараметрыЗапроса.ДействиеПередачи = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ДействияПередачиЕСМВСМЭВ.Отправка") Тогда			 
		ОбработатьОтправкуЗапроса(ОбъектBody, ДополнительныеПараметры);		 
	ИначеЕсли ДополнительныеПараметры.ПараметрыЗапроса.ДействиеПередачи = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ДействияПередачиЕСМВСМЭВ.Получение") Тогда
		ОбработатьПолучениеОтвета(ОбъектBody, ДополнительныеПараметры);
	Иначе
		ОбработатьПодтверждениеПолучения(ОбъектBody, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры	

Процедура ОбработатьОтправкуЗапроса(ОбъектBody, ДополнительныеПараметры)
	
	ДополнительныеПараметры.ПараметрыЗапроса.Вставить("ИДИнициализирующегоСообщения", ДополнительныеПараметры.ПараметрыЗапроса.ИдентификаторСообщения); 
	ДополнительныеПараметры.ПараметрыЗапроса.Вставить("СодержаниеСообщения", ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.СодержанияСообщенийЕСМВСМЭВ.Данные")); 
	ПараметрыПередачи = ПолучитьПараметрыПередачи(ДополнительныеПараметры.ПараметрыЗапроса);
	
	ТекстОшибки = НСтр("ru='Подробности см. в истории обмена ЕСМВ.'");
	СообщениеОбОшибке = Истина;
	
	Если НЕ ОбъектBody.Свойства().Получить("transferDocumentResponse") = Неопределено Тогда
		Если НЕ ОбъектBody.transferDocumentResponse.Свойства().Получить("status") = Неопределено Тогда
			Если НЕ ОбъектBody.transferDocumentResponse.status.Свойства().Получить("statusCode") = Неопределено Тогда
				Если ОбъектBody.transferDocumentResponse.status.statusCode = "0" Тогда
					СообщениеОбОшибке = Ложь;
				Иначе
					Если ТипЗнч(ОбъектBody.transferDocumentResponse.status.statusMessage) = Тип("Строка") Тогда
						ТекстОшибки = ОбъектBody.transferDocumentResponse.status.statusMessage;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;  
	
	Если НЕ ДополнительныеПараметры.ПараметрыЗапроса.Свойство("СообщатьПользователю") ИЛИ ДополнительныеПараметры.ПараметрыЗапроса.СообщатьПользователю Тогда 
		Если ДополнительныеПараметры.ПараметрыЗапроса.Свойство("ВключитьРежимОтладки") Тогда
			Если НЕ ДополнительныеПараметры.ПараметрыЗапроса.ВключитьРежимОтладки Тогда
				ОчиститьСообщения(); 
			КонецЕсли;
		Иначе
			ОчиститьСообщения();
		КонецЕсли;
		Если СообщениеОбОшибке Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Сообщение не было отправлено. '") + ТекстОшибки); 
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='В сервис отправлен запрос на получение данных.'"));
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыПередачи.ВидСведений = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ВидыСведенийЕСМВСМЭВ.ПакетПередаваемыхДанных") Тогда
		ИнтеграцииЕСМВСМЭВВызовСервера.ЗаписатьСтатусПакетаДанных(ПараметрыПередачи, ?(СообщениеОбОшибке, ТекстОшибки, "")); 
	Иначе
		Если НЕ СообщениеОбОшибке Тогда
			ИнтеграцииЕСМВСМЭВВызовСервера.ОтразитьДанныеЗапроса(ПараметрыПередачи);
		КонецЕсли;
	КонецЕсли;
	ПараметрыПередачи = ПолучитьПараметрыПередачи(ДополнительныеПараметры.ПараметрыЗапроса);
	ИнтеграцииЕСМВСМЭВВызовСервера.ЗаписатьВИсториюОбмена(ДополнительныеПараметры.ТекстЗапроса, ДополнительныеПараметры.ТекстОтвета, ПараметрыПередачи);
	
КонецПроцедуры

Процедура ОбработатьПолучениеОтвета(ОбъектBody, ДополнительныеПараметры)
	
	#Если ВебКлиент Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Операция недоступна при работе в веб-клиенте'"));
		Возврат;
	#Иначе   		
		ЗаписьXML = Новый ЗаписьXML;
	    ЗаписьXML.УстановитьСтроку();
	    ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектBody);
	    ОбъектBodyСтрока = ЗаписьXML.Закрыть();  
		
		ФормаВладелец = ДополнительныеПараметры.ПараметрыЗапроса.Форма;
		ДополнительныеПараметры.ПараметрыЗапроса.Вставить("Форма", Неопределено);
		РезультатЗадания = ИнтеграцииЕСМВСМЭВВызовСервера.ОбработатьПолучениеОтветаВФоне(ОбъектBodyСтрока, ДополнительныеПараметры);
		ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ОбработатьПолучениеОтветаВФонеЗавершение", ЭтотОбъект, Новый Структура("Форма, ПараметрыЗапроса", ФормаВладелец, ДополнительныеПараметры.ПараметрыЗапроса));
		
		МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
		
		ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ФормаВладелец);
		Если ФормаВладелец = Неопределено Тогда
			ПараметрыОжидания.ВыводитьСообщения = Ложь;
			ПараметрыОжидания.ВыводитьОкноОжидания = Ложь; 
		КонецЕсли;
		
		МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);		
	#КонецЕсли
	
КонецПроцедуры	

Процедура ОбработатьПолучениеОтветаВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда 
		Если НЕ ДополнительныеПараметры = Неопределено Тогда 
			Если НЕ ДополнительныеПараметры.Форма = Неопределено Тогда
				ОбновитьДинамическиеСписки(ДополнительныеПараметры.Форма);
			КонецЕсли;
			Сообщения = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
			Если НЕ Сообщения = Неопределено Тогда 
				ДополнительныеПараметры.ПараметрыЗапроса.Вставить("Сообщения", Сообщения);
				ОтправитьПодтверждениеЕСМВ(ДополнительныеПараметры);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

Процедура ОбработатьПодтверждениеПолучения(ОбъектBody, ДополнительныеПараметры)
	
	Если НЕ ОбъектBody.Свойства().Получить("ackMessagesResponse") = Неопределено Тогда
		Если НЕ ОбъектBody.ackMessagesResponse.Свойства().Получить("ackResult") = Неопределено Тогда
			
			МассивДокументов = Новый Массив;
			Если ТипЗнч(ОбъектBody.ackMessagesResponse.ackResult) = Тип("СписокXDTO") Тогда
				МассивДокументов = ОбъектBody.ackMessagesResponse.ackResult;
			Иначе
				МассивДокументов.Добавить(ОбъектBody.ackMessagesResponse.ackResult);
			КонецЕсли;
			
			Для каждого СтрокаДокумент Из МассивДокументов Цикл 
				Попытка
					Если СтрокаДокумент.succeeded = "true" Тогда
						ПараметрыПередачи = ПолучитьПараметрыПередачи(ДополнительныеПараметры.ПараметрыЗапроса);
						Если ПараметрыПередачи.Свойство("Сообщения") Тогда
							Для каждого СтрокаСообщения Из ПараметрыПередачи.Сообщения Цикл
								Если СтрокаСообщения.ИдентификаторСообщения = Новый УникальныйИдентификатор(СтрокаДокумент.packageId) Тогда
									ПараметрыПередачи.Вставить("ИдентификаторСообщения", СтрокаСообщения.ИдентификаторСообщения); 
									ПараметрыПередачи.Вставить("ИдентификаторДокумента", СтрокаСообщения.ИдентификаторДокумента);
									ПараметрыПередачи.Вставить("ТипДокумента", СтрокаСообщения.ТипДокумента); 
									ПараметрыПередачи.Вставить("СодержаниеСообщения", СтрокаСообщения.СодержаниеСообщения);
									ПараметрыПередачи.Вставить("ИДИнициализирующегоСообщения", СтрокаСообщения.ИДИнициализирующегоСообщения);
									Прервать;
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
						ИнтеграцииЕСМВСМЭВВызовСервера.ЗаписатьВИсториюОбмена(ДополнительныеПараметры.ТекстЗапроса, ДополнительныеПараметры.ТекстОтвета, ПараметрыПередачи);
					Иначе 
						ТекстОшибки = "нет описания";
						Если НЕ СтрокаДокумент.Свойства().Получить("succeededInfo") = Неопределено Тогда
							ТекстОшибки = СтрокаДокумент.succeededInfo;	
						КонецЕсли;
						ВызватьИсключение ТекстОшибки;
					КонецЕсли;
				Исключение
					ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				 	ТекстОшибки = НСтр("ru = 'Получение сообщений не подтверждено по причине:'");
					ТекстОшибки = ТекстОшибки + Символы.ПС + ОписаниеОшибки;
					МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
					МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru='ПодтверждениеПолученияЕСМВКлиент'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
					"Ошибка", ТекстОшибки); 
					Если НЕ ДополнительныеПараметры.ПараметрыЗапроса.Свойство("СообщатьПользователю") ИЛИ ДополнительныеПараметры.ПараметрыЗапроса.СообщатьПользователю Тогда
						ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Получение сообщений не подтверждено. Подробности см. в журнале регистрации.'")); 
					КонецЕсли;
				КонецПопытки;
			КонецЦикла; 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти

#КонецОбласти

#Область Подписание

Процедура ПодписатьТело(ТекстЗапроса, ПараметрыЗапроса)
	
	МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
	МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ПодписаниеЗапросаЕСМВКлиент'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
	"Информация", НСтр("ru='Подписание тела запроса - начало'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));  
	
	ОписаниеДанных = Новый Структура;
	ОписаниеДанных.Вставить("ПоказатьКомментарий", Истина);
	ОписаниеДанных.Вставить("Операция",            НСтр("ru = 'Подписание данных'"));
	ОписаниеДанных.Вставить("ЗаголовокДанных",     НСтр("ru = 'Данные'"));
	
	МодульЭлектроннаяПодписьКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЭлектроннаяПодписьКлиент");					
	ПараметрыКонверта = МодульЭлектроннаяПодписьКлиент.ПараметрыКонвертаXML();
	ПараметрыКонверта.Вариант = "www.roskazna.ru";
	ПараметрыКонверта.СообщениеXML = ТекстЗапроса;
	
	КонвертXML = КонвертXML(ПараметрыКонверта);
	ПараметрыXMLDSig = МодульЭлектроннаяПодписьКлиент.ПараметрыXMLDSig();
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	ОписаниеДанных.Вставить("ОтборСертификатов", МодульОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыЗапроса.ТранспортныйСертификат));
	ОписаниеДанных.Вставить("БезПодтверждения", Истина);
	ОписаниеДанных.Вставить("Данные", Новый Структура("КонвертXML,ПараметрыXMLDSig", КонвертXML, ПараметрыXMLDSig)); 
	ОписаниеДанных.Вставить("ВыполнятьНаСервере", Ложь);
	
	ПараметрыПодписания = МодульЭлектроннаяПодписьКлиент.НовыйТипПодписи();
	ПараметрыПодписания.ВыборДоверенности = Истина;
	МодульЭлектроннаяПодписьКлиент.Подписать(ОписаниеДанных,, Новый ОписаниеОповещения("ПодписатьТелоSOAPКриптоКлиентЗавершение", ЭтотОбъект, Новый Структура("ПараметрыЗапроса", ПараметрыЗапроса)), ПараметрыПодписания);
	
КонецПроцедуры

Процедура ПодписатьТелоSOAPКриптоКлиентЗавершение(ОписаниеДанных, ДополнительныеПараметры) Экспорт
	
	Если ОписаниеДанных.Отказ Или Не ОписаниеДанных.Успех Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Подписание отменено или выполнено с ошибкой. Операция прервана.");
		Возврат;
	КонецЕсли;
	
	МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
	МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ПодписаниеЗапросаЕСМВКлиент'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
	"Информация", НСтр("ru='Подписание тела запроса - конец'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));  
	
	ТекстЗапроса = ОписаниеДанных.СвойстваПодписи.Подпись;
	
	Если НЕ ДополнительныеПараметры.ПараметрыЗапроса.Пакет = Неопределено Тогда
		ЕСМВДобавитьТелоЗапросВложениеМТОМ(ТекстЗапроса, ДополнительныеПараметры.ПараметрыЗапроса);
	КонецЕсли;
	
	ПолучитьЗаголовки(ТекстЗапроса, ДополнительныеПараметры.ПараметрыЗапроса);
	
КонецПроцедуры   

Процедура ПолучитьЗаголовки(ТекстЗапроса, ПараметрыЗапроса) 
	
	ЗаголовкиЗапроса = Новый Соответствие;
	
	ЗаголовкиЗапроса.Вставить("POIB-Request-SenderSystem-ID", ПараметрыЗапроса.КодИС);
	ЗаголовкиЗапроса.Вставить("POIB-Request-TargetSystem-ID", "MSD");
	ЗаголовкиЗапроса.Вставить("POIB-Request-ResourceType-ID", "MSD_Exchange");
	ЗаголовкиЗапроса.Вставить("POIB-Request-Resource-ID", ПараметрыЗапроса.КодВидаСведений);
	ЗаголовкиЗапроса.Вставить("POIB-Request-Action-ID", ПараметрыЗапроса.ИДДействия);
	
	СтруктураAdditionalAttributes = Новый Структура("CURRENT_IS_UUID", ПараметрыЗапроса.КодИС);
	Значение = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(ИнтеграцииЕСМВСМЭВВызовСервера.ВернутьСтруктураВJSON(СтруктураAdditionalAttributes)));
	Значение = СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение, Символы.ВК, ""), Символы.ПС, ""), Символы.ПФ, "");
	
	ЗаголовкиЗапроса.Вставить("POIB-Request-AdditionalAttributes", Значение);
	ЗаголовкиЗапроса.Вставить("POIB-Request-TimeStamp", ПолучитьТекущуюУниверсальнуюДатуВISOUTC());
	
	СоответствиеДопЗаголовков = Новый Соответствие;
	СоответствиеДопЗаголовков.Вставить("Accept-Encoding", "gzip,deflate");
	СоответствиеДопЗаголовков.Вставить("Content-Type", ?(ПараметрыЗапроса.Пакет = Неопределено, "text/xml", "multipart/related; type=""application/xop+xml""; start=""<rootpart@soapui.org>""; start-info=""text/xml""; boundary=""uuid:" + ПараметрыЗапроса.ИдентификаторДокумента + """"));
	СоответствиеДопЗаголовков.Вставить("SOAPAction", ?(ПараметрыЗапроса.ИДДействия = "sendMessage", "transferDocument", ПараметрыЗапроса.ИДДействия));
	СоответствиеДопЗаголовков.Вставить("User-Agent", "1C:Enterprise");
	
	СтрокаДопЗаголовков = "";
	Для Каждого ДопЗаголовок Из СоответствиеДопЗаголовков Цикл
		Если ЗначениеЗаполнено(СтрокаДопЗаголовков) Тогда
			СтрокаДопЗаголовков = СтрокаДопЗаголовков + ",";
		КонецЕсли;		
		СтрокаДопЗаголовков = СтрокаДопЗаголовков + ДопЗаголовок.Ключ;		
	КонецЦикла;
	
	ЗаголовкиЗапроса.Вставить("POIB-HeadersToTarget", СтрокаДопЗаголовков);
	
	МассивДопЗаголовков = СтрРазделить(СтрокаДопЗаголовков, ",", Ложь);
	Для Каждого ДопЗаголовок Из МассивДопЗаголовков Цикл 
		ЗаголовкиЗапроса.Вставить(ДопЗаголовок, СоответствиеДопЗаголовков.Получить(ДопЗаголовок));
	КонецЦикла;
	
	Результат = ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьКонтрольнуюСуммуЗаголовковОтправкаДанных(ЗаголовкиЗапроса, ТекстЗапроса, ПараметрыЗапроса.ТочкаСервиса);
	Если Результат.Отказ Тогда
		ВызватьИсключение(НСтр("ru='Не удалось получить контрольную сумму заголовков.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	КонецЕсли;
	
	ЗаголовкиЗапроса.Вставить("POIB-Request-Checksum", Результат.Значение);
	
	ПодписатьЗаголовки(ТекстЗапроса, ЗаголовкиЗапроса, ПараметрыЗапроса);
	
КонецПроцедуры

Процедура ПодписатьЗаголовки(ТекстЗапроса, ЗаголовкиЗапроса, ПараметрыЗапроса)
	
	Результат = ИнтеграцииЕСМВСМЭВВызовСервера.ПолучитьКонтрольнуюСуммуЗаголовковОтправкаДанных(ЗаголовкиЗапроса, ТекстЗапроса, ПараметрыЗапроса.ТочкаСервиса, Истина);
	Если Результат.Отказ Тогда
		ВызватьИсключение (НСтр("ru='Не удалось получить контрольную сумму заголовков с учетом подписания.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));
	КонецЕсли;
	
	МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
	МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ПодписаниеЗапросаЕСМВКлиент'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
	"Информация", НСтр("ru='Подписание заголовков запроса - начало'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()));  
	
	HexПредставлениеКонтрольнойСуммыЗаголовков = Результат.Значение;
	
	ОписаниеДанных = Новый Структура;
	ОписаниеДанных.Вставить("ПоказатьКомментарий", Истина);
	ОписаниеДанных.Вставить("Операция",            НСтр("ru = 'Подписание данных'"));
	ОписаниеДанных.Вставить("ЗаголовокДанных",     НСтр("ru = 'Данные'"));
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	ОписаниеДанных.Вставить("ОтборСертификатов", МодульОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыЗапроса.ТранспортныйСертификат));
	ОписаниеДанных.Вставить("БезПодтверждения", Истина);
	ОписаниеДанных.Вставить("Данные", ПолучитьДвоичныеДанныеИзСтроки(HexПредставлениеКонтрольнойСуммыЗаголовков));
	ОписаниеДанных.Вставить("ВыполнятьНаСервере", Ложь);
	
	ДопПараметрыОповещения = Новый Структура;
	ДопПараметрыОповещения.Вставить("ТекстЗапроса", ТекстЗапроса); 
	ДопПараметрыОповещения.Вставить("ЗаголовкиЗапроса", ЗаголовкиЗапроса); 
	ДопПараметрыОповещения.Вставить("ПараметрыЗапроса", ПараметрыЗапроса); 
	
	МодульЭлектроннаяПодписьКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЭлектроннаяПодписьКлиент");
	ПараметрыПодписания = МодульЭлектроннаяПодписьКлиент.НовыйТипПодписи();
	ПараметрыПодписания.ВыборДоверенности = Истина;
	МодульЭлектроннаяПодписьКлиент.Подписать(ОписаниеДанных,, Новый ОписаниеОповещения("ПодписатьЗаголовкиПОИБКлиентЗавершение", ЭтотОбъект, ДопПараметрыОповещения), ПараметрыПодписания);
	
КонецПроцедуры  

Процедура ПодписатьЗаголовкиПОИБКлиентЗавершение(ОписаниеДанных, ДополнительныеПараметры) Экспорт
	
	Если ОписаниеДанных.Отказ Или Не ОписаниеДанных.Успех Тогда
		Сообщить("Подписание отменено или выполнено с ошибкой. Операция прервана.");
		Возврат;
	КонецЕсли; 
	
	МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
	МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ПодписаниеЗапросаЕСМВКлиент'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()),
	"Информация", НСтр("ru='Подписание заголовков запроса - конец'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка())); 
	
	ДополнительныеПараметры.ЗаголовкиЗапроса.Вставить("POIB-Request-Signature", ИнтеграцииЕСМВСМЭВВызовСервера.ПреобразоватьПодписьПередаваемыхДанныхВBase64(ОписаниеДанных.СвойстваПодписи.Подпись));	
	ОтправкаЗапросаКлиент(ДополнительныеПараметры);	
	
КонецПроцедуры

