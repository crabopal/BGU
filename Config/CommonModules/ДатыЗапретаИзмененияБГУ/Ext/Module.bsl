
#Область ПрограммныйИнтерфейс

// Позволяет изменить работу интерфейса при встраивании.
//
// Параметры:
//  НастройкиРаботыИнтерфейса - Структура - содержит свойство:
//   * ИспользоватьВнешнихПользователей - Булево - (начальное значение Ложь),
//     если установить Истина, тогда даты запрета можно будет настраивать для внешних пользователей.
//
Процедура НастройкаИнтерфейса(НастройкиРаботыИнтерфейса) Экспорт
	
	НастройкиРаботыИнтерфейса.ИспользоватьВнешнихПользователей = Истина;	
	
КонецПроцедуры

// Заполняет разделы дат запрета изменения, используемые при настройке дат запрета.
// Если не указать ни одного раздела, тогда будет доступна только настройка общей даты запрета.
//
// Параметры:
//  Разделы - ТаблицаЗначений - с колонками:
//   * Имя - Строка - имя используемое в описании источников данных в
//       процедуре ЗаполнитьИсточникиДанныхДляПроверкиЗапретаИзменения.
//
//   * Идентификатор - УникальныйИдентификатор - идентификатор ссылки элемента плана видов характеристик.
//       Чтобы получить идентификатор нужно в режиме 1С:Предприятия выполнить метод платформы:
//       "ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПолучитьСсылку().УникальныйИдентификатор()".
//       Не следует указывать идентификаторы, полученные любым другим способом,
//       так как это может нарушить их уникальность.
//
//   * Представление - Строка - представляет раздел в форме настройки дат запрета.
//
//   * ТипыОбъектов  - Массив - типы ссылок объектов в разрезе которых можно настроить даты запрета,
//       например, Тип("СправочникСсылка.Организации"), если не указано ни одного типа,
//       то даты запрета будут настраиваться только с точностью до раздела.
//
Процедура ПриЗаполненииРазделовДатЗапретаИзменения(Разделы) Экспорт
	
	Раздел = Разделы.Добавить();
	Раздел.Имя  = "БухгалтерскийУчет";
	Раздел.Идентификатор = Новый УникальныйИдентификатор("e7589b9a-ac46-4ef5-9943-27267c53d228");
	Раздел.Представление = НСтр("ru = 'Бухгалтерский учет'");
	Раздел.ТипыОбъектов.Добавить(Тип("СправочникСсылка.Организации"));
	
	Раздел = Разделы.Добавить();
	Раздел.Имя  = "Инвентаризация";
	Раздел.Идентификатор = Новый УникальныйИдентификатор("15b2ae28-9a2a-4132-9f37-175c588b9895");
	Раздел.Представление = НСтр("ru = 'Инвентаризация'");
	Раздел.ТипыОбъектов.Добавить(Тип("СправочникСсылка.Организации"));
	
	Раздел = Разделы.Добавить();
	Раздел.Имя  = "Отчетность";
	Раздел.Идентификатор = Новый УникальныйИдентификатор("1f7e207e-0248-45d0-9cd0-5f2a43aba72f");
	Раздел.Представление = НСтр("ru = 'Отчетность'");
	Раздел.ТипыОбъектов.Добавить(Тип("СправочникСсылка.Организации"));
	
	Раздел = Разделы.Добавить();
	Раздел.Имя  = "ВзаимодействиеГИСГМП";
	Раздел.Идентификатор = Новый УникальныйИдентификатор("8a206d5d-ba59-4ad5-b72e-05ed700e7a0b");
	Раздел.Представление = НСтр("ru = 'Взаимодействие с ГИС ГМП'");
	Раздел.ТипыОбъектов.Добавить(Тип("СправочникСсылка.Организации")); 
	
	Раздел = Разделы.Добавить();
	Раздел.Имя  = "ПлатноеОбучение";
	Раздел.Идентификатор = Новый УникальныйИдентификатор("07b4c403-39c1-4499-8140-92007beac9f2");
	Раздел.Представление = НСтр("ru = 'Платное обучение'");
	Раздел.ТипыОбъектов.Добавить(Тип("СправочникСсылка.Организации"));
	
	Раздел = Разделы.Добавить();
	Раздел.Имя  = "ВнутреннийЭДО";
	Раздел.Идентификатор = Новый УникальныйИдентификатор("89778b1a-24b1-11ee-a3fb-708bcd54f41e");
	Раздел.Представление = НСтр("ru = 'Внутренний ЭДО'");
	Раздел.ТипыОбъектов.Добавить(Тип("СправочникСсылка.Организации"));
	
КонецПроцедуры

// Позволяет задать таблицы и поля объектов для проверки запрета изменения данных.
// Для добавления нового источника в ИсточникиДанных см. ДатыЗапретаИзменения.ДобавитьСтроку.
//
// Вызывается из процедуры ИзменениеЗапрещено общего модуля ДатыЗапретаИзменения,
// используемой в подписке на событие ПередЗаписью объекта для проверки наличия
// запретов и отказа от изменений запрещенного объекта.
//
// Параметры:
//  ИсточникиДанных - ТаблицаЗначений - с колонками:
//   * Таблица     - Строка - полное имя объекта метаданных,
//                   например, Метаданные.Документы.ПриходнаяНакладная.ПолноеИмя().
//   * ПолеДаты    - Строка - имя реквизита объекта или табличной части,
//                   например "Дата", "Товары.ДатаОтгрузки".
//   * Раздел      - Строка - имя раздела дат запрета, указанного в
//                   процедуре ПриЗаполненииРазделовДатЗапретаИзменения (см. выше).
//   * ПолеОбъекта - Строка - имя реквизита объекта или реквизита табличной части,
//                   например "Организация", "Товары.Склад".
//
Процедура ЗаполнитьИсточникиДанныхДляПроверкиЗапретаИзменения(ИсточникиДанных) Экспорт
	
	// Регистр бухгалтерии
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрБухгалтерии.ЖурналПроводокЕПСБУ", 						"Период", 		  "БухгалтерскийУчет", "Организация"); 
	
	// Непериодические регистры сведений 
	// БухгалтерскийУчет
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрСведений.ОперацииДокументов", 							
	"Дата", 				"БухгалтерскийУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций", 	
	"Объект.Дата", 	  		"БухгалтерскийУчет", "Объект.Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрСведений.ЗначенияКолонокДополнительныхТабличныхЧастей",
	"Объект.Дата", 	  		"БухгалтерскийУчет", "Объект.Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрСведений.ДатыПроведенияДокументов", 					
	"ДатаПроведения", 		"БухгалтерскийУчет", "Документ.Организация"); 
	// Инвентаризация
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрСведений.СоответствияДокументовИнвентаризационныхОписейИРасписок", 	
	"ДокументОписи.Дата", 	"Инвентаризация", 	 "ДокументОписи.Организация"); 
	// ВнутреннийЭДО
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрСведений.СостоянияЭлектронныхДокументов",
	"ЭлектронныйДокумент.ДатаДокумента", "ВнутреннийЭДО", "ЭлектронныйДокумент.Организация");

    
	// Документы
	//
	ТипыДокументаИсточникаБухгалтерскийУчет 	= Метаданные.ПодпискиНаСобытия.ПроверитьДатуЗапретаИзмененияПередЗаписьюДокументаБухгалтерскийУчет.Источник;
	ТипыДокументаИсточникаИнвентаризация 		= Метаданные.ПодпискиНаСобытия.ПроверитьДатуЗапретаИзмененияПередЗаписьюДокументаИнвентаризация.Источник;
	ТипыДокументаИсточникаОтчетность 			= Метаданные.ПодпискиНаСобытия.ПроверитьДатуЗапретаИзмененияПередЗаписьюДокументаОтчетность.Источник;
	ТипыДокументаИсточникаВзаимодействиеГИСГМП	= Метаданные.ПодпискиНаСобытия.ПроверитьДатуЗапретаИзмененияПередЗаписьюДокументаВзаимодействиеГИСГМП.Источник;
	ТипыДокументаИсточникаПлатноеОбучение 		= Метаданные.ПодпискиНаСобытия.ПроверитьДатуЗапретаИзмененияПередЗаписьюДокументаПлатноеОбучение.Источник;
	ТипыДокументаИсточникаВнутреннийЭДО 		= Метаданные.ПодпискиНаСобытия.ПроверитьДатуЗапретаИзмененияПередЗаписьюДокументаВнутреннийЭДО.Источник;  
	
	Для Каждого ТекДокумент Из Метаданные.Документы Цикл 
		Если ТекДокумент.Реквизиты.Найти("Организация") = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		ТекРаздел = "";
		Если ТипыДокументаИсточникаБухгалтерскийУчет.СодержитТип(Тип("ДокументОбъект." + ТекДокумент.Имя)) Тогда
			ТекРаздел = "БухгалтерскийУчет"; 
		ИначеЕсли ТипыДокументаИсточникаИнвентаризация.СодержитТип(Тип("ДокументОбъект." + ТекДокумент.Имя)) Тогда
			ТекРаздел = "Инвентаризация"; 
		ИначеЕсли ТипыДокументаИсточникаОтчетность.СодержитТип(Тип("ДокументОбъект." + ТекДокумент.Имя)) Тогда
			ТекРаздел = "Отчетность"; 
		ИначеЕсли ТипыДокументаИсточникаВзаимодействиеГИСГМП.СодержитТип(Тип("ДокументОбъект." + ТекДокумент.Имя)) Тогда
			ТекРаздел = "ВзаимодействиеГИСГМП"; 
		ИначеЕсли ТипыДокументаИсточникаПлатноеОбучение.СодержитТип(Тип("ДокументОбъект." + ТекДокумент.Имя)) Тогда
			ТекРаздел = "ПлатноеОбучение"; 
		ИначеЕсли ТипыДокументаИсточникаВнутреннийЭДО.СодержитТип(Тип("ДокументОбъект." + ТекДокумент.Имя)) Тогда
			ТекРаздел = "ВнутреннийЭДО";
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекРаздел) Тогда
			ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "Документ."+ТекДокумент.Имя, "Дата", ТекРаздел, "Организация");
		КонецЕсли;
	КонецЦикла;   
	
	// Регистры накопления и периодические регистры сведений   
	
	РегистрыБухгалтерскийУчет 	= Метаданные.ПодпискиНаСобытия.ПроверитьДатуЗапретаПередЗаписьюНабораЗаписейБухгалтерскийУчет.Источник;
    РегистрыИнвентаризация 		= Метаданные.ПодпискиНаСобытия.ПроверитьДатуЗапретаПередЗаписьюНабораЗаписейИнвентаризация.Источник;
    РегистрыВнутреннийЭДО 		= Метаданные.ПодпискиНаСобытия.ПроверитьДатуЗапретаПередЗаписьюНабораЗаписейВнутреннийЭДО.Источник;
		
	// Регистры накопления
	
	// Регистры накопления с особым порядком определения даты запрета изменений (не по периоду регистра)
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрНакопления.ИсполнениеДоговоровСПокупателями", 		"Регистратор.Дата", "БухгалтерскийУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрНакопления.ИсполнениеОбязательствПоставщиками", 	"Регистратор.Дата", "БухгалтерскийУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрНакопления.ОплатаОтПокупателейДебиторов", 			"Регистратор.Дата", "БухгалтерскийУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрНакопления.ОплатаПоставщикамКредиторам", 			"Регистратор.Дата", "БухгалтерскийУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрНакопления.РезервМЗ", 								"Регистратор.Дата", "БухгалтерскийУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрНакопления.РасчетыСоСтудентамиДопУслуги", 			"Регистратор.Дата", "БухгалтерскийУчет", "Организация");
	ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрНакопления.НачисленияФактическиеОбразование", 		"Регистратор.Дата", "БухгалтерскийУчет", "Студент.Организация");
	
	// Регистры накопления со стандартным порядком определения даты запрета изменений - по периоду
	Для Каждого ТекРегистр Из Метаданные.РегистрыНакопления Цикл
		Если НЕ ИсточникиДанных.Найти("РегистрНакопления."+ТекРегистр.Имя, "Таблица") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТекРаздел = "";  
		
		Если РегистрыБухгалтерскийУчет.СодержитТип(Тип("РегистрНакопленияНаборЗаписей." + ТекРегистр.Имя)) Тогда
			ТекРаздел = "БухгалтерскийУчет"; 
		ИначеЕсли РегистрыИнвентаризация.СодержитТип(Тип("РегистрНакопленияНаборЗаписей." + ТекРегистр.Имя)) Тогда
			ТекРаздел = "Инвентаризация"; 
		ИначеЕсли РегистрыВнутреннийЭДО.СодержитТип(Тип("РегистрНакопленияНаборЗаписей." + ТекРегистр.Имя)) Тогда
			ТекРаздел = "ВнутреннийЭДО";  
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекРаздел) Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеОбъекта = "";
		
		Если НЕ ТекРегистр.Измерения.Найти("Организация") = Неопределено Тогда 
			ПолеОбъекта = "Организация";
		ИначеЕсли НЕ  ТекРегистр.Измерения.Найти("ЛицевойСчет") = Неопределено Тогда
			ПолеОбъекта = "ЛицевойСчет.Владелец"; 
		ИначеЕсли НЕ  ТекРегистр.Измерения.Найти("Студент") = Неопределено Тогда
			ПолеОбъекта = "Студент.Организация";
		ИначеЕсли НЕ  ТекРегистр.Измерения.Найти("Учащийся") = Неопределено Тогда
			ПолеОбъекта = "Учащийся.Организация";  
		ИначеЕсли НЕ  ТекРегистр.Измерения.Найти("Ребенок") = Неопределено Тогда
			ПолеОбъекта = "Ребенок.Организация"; 
		ИначеЕсли НЕ  ТекРегистр.Измерения.Найти("Сотрудник") = Неопределено Тогда
			ПолеОбъекта = "Сотрудник.Владелец";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекРаздел) И ЗначениеЗаполнено(ПолеОбъекта) Тогда
			ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрНакопления."+ТекРегистр.Имя, "Период", ТекРаздел, ПолеОбъекта);
		КонецЕсли;
		
	КонецЦикла;
	
	// Периодические регистры сведений
	Для Каждого ТекРегистр Из Метаданные.РегистрыСведений Цикл
		Если НЕ ИсточникиДанных.Найти("РегистрСведений."+ТекРегистр.Имя, "Таблица") = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		Если ТекРегистр.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			Продолжить;
		КонецЕсли; 
		
		ТекРаздел = "";  
		
		Если РегистрыБухгалтерскийУчет.СодержитТип(Тип("РегистрСведенийНаборЗаписей." + ТекРегистр.Имя)) Тогда
			ТекРаздел = "БухгалтерскийУчет"; 
		ИначеЕсли РегистрыИнвентаризация.СодержитТип(Тип("РегистрСведенийНаборЗаписей." + ТекРегистр.Имя)) Тогда
			ТекРаздел = "Инвентаризация"; 
		ИначеЕсли РегистрыВнутреннийЭДО.СодержитТип(Тип("РегистрСведенийНаборЗаписей." + ТекРегистр.Имя)) Тогда
			ТекРаздел = "ВнутреннийЭДО";  
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекРаздел) Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеОбъекта = "";
		
		Если НЕ ТекРегистр.Измерения.Найти("Организация") = Неопределено Тогда 
			ПолеОбъекта = "Организация";
		ИначеЕсли НЕ  ТекРегистр.Измерения.Найти("ЛицевойСчет") = Неопределено Тогда
			ПолеОбъекта = "ЛицевойСчет.Владелец"; 
		ИначеЕсли НЕ  ТекРегистр.Измерения.Найти("Студент") = Неопределено Тогда
			ПолеОбъекта = "Студент.Организация";
		ИначеЕсли НЕ  ТекРегистр.Измерения.Найти("Учащийся") = Неопределено Тогда
			ПолеОбъекта = "Учащийся.Организация";  
		ИначеЕсли НЕ  ТекРегистр.Измерения.Найти("Ребенок") = Неопределено Тогда
			ПолеОбъекта = "Ребенок.Организация"; 
		ИначеЕсли НЕ  ТекРегистр.Измерения.Найти("Сотрудник") = Неопределено Тогда
			ПолеОбъекта = "Сотрудник.Владелец";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекРаздел) И ЗначениеЗаполнено(ПолеОбъекта) Тогда
			ДатыЗапретаИзменения.ДобавитьСтроку(ИсточникиДанных, "РегистрСведений."+ТекРегистр.Имя, "Период", ТекРаздел, ПолеОбъекта);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

// Позволяет переопределить выполнение проверки запрета изменения произвольным образом.
//
// Если проверка выполняется в процессе записи документа, то в свойстве ДополнительныеСвойства документа Объект
// имеется свойство РежимЗаписи.
//  
// Параметры:
//  Объект       - СправочникОбъект,
//                 ДокументОбъект,
//                 ПланВидовХарактеристикОбъект,
//                 ПланСчетовОбъект,
//                 ПланВидовРасчетаОбъект,
//                 БизнесПроцессОбъект,
//                 ЗадачаОбъект,
//                 ПланОбменаОбъект, 
//                 РегистрСведенийНаборЗаписей,
//                 РегистрНакопленияНаборЗаписей,
//                 РегистрБухгалтерииНаборЗаписей,
//                 РегистрРасчетаНаборЗаписей - проверяемый элемент данных или набор записей 
//                 (который передается из обработчиков ПередЗаписью и ПриЧтенииНаСервере).
//
//  ПроверкаЗапретаИзменения    - Булево - установить в Ложь, чтобы пропустить проверку запрета изменения данных.
//  УзелПроверкиЗапретаЗагрузки - ПланыОбменаСсылка, Неопределено - установить в Неопределено, чтобы 
//                                пропустить проверку запрета загрузки данных.
//  ВерсияОбъекта               - Строка - установить "СтараяВерсия" или "НоваяВерсия", чтобы
//                                выполнить проверку только старой (в базе данных) 
//                                или только новой версии объекта (в параметре Объект).
//                                По умолчанию содержит значение "" - проверяются обе версии объекта сразу.
//
Процедура ПередПроверкойЗапретаИзменения(Объект,
	ПроверкаЗапретаИзменения,
	УзелПроверкиЗапретаЗагрузки,
	ВерсияОбъекта) Экспорт
	
	Если  ТипЗнч(Объект) = Тип("ДокументОбъект.ТранспортноеСообщение") Тогда
		
		ПроверкаЗапретаИзменения = Ложь;
		УзелПроверкиЗапретаЗагрузки = Неопределено;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.СчетНаОплату") Тогда
		
		Если НЕ Объект.ЭтоНовый() И НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "СчетОплачен") Тогда
			ПроверкаЗапретаИзменения = Ложь;
			УзелПроверкиЗапретаЗагрузки = Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ПрекращениеДоговорМОЛ") ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.ПрекращениеДоговорКоллективнойМО") Тогда
		
		Если НЕ Объект.ЭтоНовый() И НЕ Объект.Проведен И ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ДоговорОснование")) Тогда
			ПроверкаЗапретаИзменения = Ложь;
			УзелПроверкиЗапретаЗагрузки = Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ДоговорМОЛ") ИЛИ ТипЗнч(Объект) = Тип("ДокументОбъект.ДоговорКоллективнойМО") Тогда
		
		Если НЕ Объект.ЭтоНовый() И НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "НеАктуален") Тогда
			ПроверкаЗапретаИзменения = Ложь;
			УзелПроверкиЗапретаЗагрузки = Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("РегистрСведенийНаборЗаписей.ОперацииДокументов") Тогда
		
		ВерсияОбъекта = "НоваяВерсия";	
		
		Если Объект.Количество() > 0 И НЕ ЗначениеЗаполнено(Объект[0].Дата) Тогда
			ПроверкаЗапретаИзменения = Ложь;
			УзелПроверкиЗапретаЗагрузки = Неопределено;
		Иначе
			Набор = РегистрыСведений.ОперацииДокументов.СоздатьНаборЗаписей();
			Набор.Отбор.Документ.Установить(Объект.Отбор.Документ.Значение);
			Набор.Прочитать();
			
			Если ОбщегоНазначения.КоллекцииИдентичны(Набор, 
				Объект, 
				"Активность, Дата, Документ, ЕстьПроводки, ИсправлениеОшибки, Кратность, Курс, Операция, Организация, РучнаяКорректировка, СуммаОперации") Тогда
				
				//Изменился только признак сторнирования
				ПроверкаЗапретаИзменения = Ложь;
				УзелПроверкиЗапретаЗагрузки = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("РегистрСведенийНаборЗаписей.ЗначенияДополнительныхРеквизитовОпераций") 
		ИЛИ ТипЗнч(Объект) = Тип("РегистрСведенийНаборЗаписей.ЗначенияКолонокДополнительныхТабличныхЧастей") Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Отбор.Объект.Значение)
			ИЛИ НЕ ОбщегоНазначения.СсылкаСуществует(Объект.Отбор.Объект.Значение) 
			ИЛИ НЕ ДатыЗапретаИзменения.ИзменениеЗапрещено(Объект.Отбор.Объект.Значение.Метаданные().ПолноеИмя(), Объект.Отбор.Объект.Значение) Тогда
			ПроверкаЗапретаИзменения = Ложь;
			УзелПроверкиЗапретаЗагрузки = Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("РегистрСведенийНаборЗаписей.СостоянияЭлектронныхДокументов") Тогда
		
		ВнутреннийЭлектронныйДокумент = Объект.Отбор.ЭлектронныйДокумент.Значение; 
		// У объектов-справочников дата документа не заполнена, для них не нужно контролировать дату запрета изменения
		ДатаВнутреннегоЭД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВнутреннийЭлектронныйДокумент, "ДатаДокумента");
		
		// У электронных документов с указаными состояниями нужно контролировать дату запрета изменения
		МассивСостоянийЭД = Новый Массив;
		МассивСостоянийЭД.Добавить(Перечисления.СостоянияДокументовВнутреннегоЭДО.Завершен);
		МассивСостоянийЭД.Добавить(Перечисления.СостоянияДокументовВнутреннегоЭДО.ЗакрытПринудительно);
				
		СостояниеЭД = ВнутреннийЭДО.СостояниеЭлектронногоДокумента(ВнутреннийЭлектронныйДокумент); 
		
		Если НЕ ЗначениеЗаполнено(ДатаВнутреннегоЭД) ИЛИ МассивСостоянийЭД.Найти(СостояниеЭД.Состояние) = Неопределено
				ИЛИ Пользователи.ЭтоПолноправныйПользователь() Тогда
			ПроверкаЗапретаИзменения = Ложь;
			УзелПроверкиЗапретаЗагрузки = Неопределено;
		КонецЕсли;
		
	ИначеЕсли ПолучитьФункциональнуюОпцию("ИспользоватьОтдельнуюДатуПроведенияДокументов") Тогда 
		
		Если Метаданные.Документы.Содержит(Объект.Метаданные()) 
			И Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(Объект.Ссылка)) Тогда	
			
			// Для новых документов - стандартная проверка по дате документа.
			// Новый документ в закрытом периоде записать нельзя.
			// Записанный не проведенный документ:
			//  дату запрета не проверяем, даем редактировать и записывать изменения
			//  при записи документа:
			//   - в режиме "Запись" дату запрета не проверяем
			//   - в режиме "Проведение"  дату запрета проверяем по реквизиту ДатаПроведения, если не заполнен - по реквизиту Дата
			// Записанный проведенный документ:
			//  дату запрета проверяем по реквизиту ДатаПроведения, если не заполнен - по реквизиту Дата
			//
			Если НЕ Объект.ЭтоНовый() 
				И НЕ Объект.Движения.Найти("ЖурналПроводокЕПСБУ") = Неопределено Тогда  
				Если НЕ БухгалтерскиеОперацииСервер.ЕстьПроводкиДокумента(Объект.Ссылка) Тогда
					ПроверкаЗапретаИзменения = Ложь;
					УзелПроверкиЗапретаЗагрузки = Неопределено; 
				КонецЕсли;	
			КонецЕсли;  
			
		ИначеЕсли Метаданные.РегистрыНакопления.Содержит(Объект.Метаданные())
			И Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(Объект.Отбор.Регистратор.Значение))
			Тогда   
			Если Объект.Отбор.Регистратор.Значение.Метаданные().Движения.Содержит(Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ) 
				Тогда 
				Если НЕ БухгалтерскиеОперацииСервер.ЕстьПроводкиДокумента(Объект.Отбор.Регистратор.Значение) Тогда
					ПроверкаЗапретаИзменения = Ложь;
					УзелПроверкиЗапретаЗагрузки = Неопределено; 
				КонецЕсли;	
			КонецЕсли; 
			
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(Объект.Метаданные()) 
			И Объект.Метаданные().РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору
			И Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(Объект.Отбор.Регистратор.Значение))
			Тогда
			Если Объект.Отбор.Регистратор.Значение.Метаданные().Движения.Содержит(Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ)  
				Тогда  
				Если НЕ БухгалтерскиеОперацииСервер.ЕстьПроводкиДокумента(Объект.Отбор.Регистратор.Значение) Тогда
					ПроверкаЗапретаИзменения = Ложь;
					УзелПроверкиЗапретаЗагрузки = Неопределено; 
				КонецЕсли;	
			КонецЕсли; 	
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

// Позволяет переопределить получение данных для проверки даты запрета старой (существующей) версии данных.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных получаемых данных.
//  ИдентификаторДанных - СправочникСсылка,
//                        ДокументСсылка,
//                        ПланВидовХарактеристикСсылка,
//                        ПланСчетовСсылка,
//                        ПланВидовРасчетаСсылка,
//                        БизнесПроцессСсылка,
//                        ЗадачаСсылка,
//                        ПланОбменаСсылка,
//                        Отбор        - ссылка на элемент данных или отбор набора записей, который нужно проверить.
//                                       При этом значение для проверки будет получено из базы данных.
//
//  УзелПроверкиЗапретаЗагрузки - Неопределено, ПланыОбменаСсылка - если Неопределено, то проверить запрет 
//                                изменения данных; иначе - загрузку данных из указанного узла плана обмена.
//
//  ДанныеДляПроверки - ТаблицаЗначений - таблица для заполнения правил проверок и последующей передачи в
//                                         функцию НайденЗапретИзмененияДанных общего модуля ДатыЗапретаИзменения.
//                                        см. ДатыЗапретаИзменения.ШаблонДанныхДляПроверки.
//
//  Пример:
//  Если ТипЗнч(ИдентификаторДанных) = Тип("ДокументСсылка.Заказ") Тогда
//  	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдентификаторДанных, "Организация, ДатаОкончанияРабот, ЗаказНаряд");
//  	Если Данные.ЗаказНаряд Тогда
//  		Проверка = ДанныеДляПроверки.Добавить();
//  		Проверка.Раздел = "ЗаказНаряды";
//  		Проверка.Объект =  Данные.Организация;
//  		Проверка.Дата   = Данные.ДатаОкончанияРабот;
//  	КонецЕсли;
//  КонецЕсли;
//
Процедура ПередПроверкойСтаройВерсииДанных(ОбъектМетаданных, ИдентификаторДанных, УзелПроверкиЗапретаЗагрузки, ДанныеДляПроверки) Экспорт
	
	ПолноеИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
	
	Если ПолноеИмяОбъекта = "РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций"
		ИЛИ ПолноеИмяОбъекта = "РегистрСведений.ЗначенияКолонокДополнительныхТабличныхЧастей" Тогда 
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьОтдельнуюДатуПроведенияДокументов")
			И Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(ИдентификаторДанных.Объект.Значение)) 
			Тогда
			ПроверяемыеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдентификаторДанных.Объект.Значение, "Дата, Организация, Проведен");
			Если ПроверяемыеРеквизиты.Проведен Тогда  
				ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ИдентификаторДанных.Объект.Значение, Ложь);
				ПроверяемыеРеквизиты.Дата = ?(ЗначениеЗаполнено(ДатаПроведения), ДатаПроведения, ПроверяемыеРеквизиты.Дата);
			Иначе
				ПроверяемыеРеквизиты = Неопределено;
			КонецЕсли;	
		Иначе	
			ПроверяемыеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдентификаторДанных.Объект.Значение, "Дата, Организация"); 
		КонецЕсли;
		
		Если НЕ ПроверяемыеРеквизиты = Неопределено Тогда
			Проверка = ДанныеДляПроверки.Добавить();
			Проверка.Раздел = "БухгалтерскийУчет";
			Проверка.Объект = ПроверяемыеРеквизиты.Организация;
			Проверка.Дата   = ПроверяемыеРеквизиты.Дата;
		КонецЕсли;
		
	ИначеЕсли ПолноеИмяОбъекта = "РегистрНакопления.ИсполнениеДоговоровСПокупателями"
		ИЛИ ПолноеИмяОбъекта = "РегистрНакопления.ИсполнениеОбязательствПоставщиками"
		ИЛИ ПолноеИмяОбъекта = "РегистрНакопления.ОплатаОтПокупателейДебиторов"
		ИЛИ ПолноеИмяОбъекта = "РегистрНакопления.ОплатаПоставщикамКредиторам" 
		ИЛИ ПолноеИмяОбъекта = "РегистрНакопления.РезервМЗ"
		ИЛИ ПолноеИмяОбъекта = "РегистрНакопления.РасчетыСоСтудентамиДопУслуги"
		Тогда  
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьОтдельнуюДатуПроведенияДокументов")
			И Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(ИдентификаторДанных.Регистратор.Значение)) 
			Тогда
			ПроверяемыеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдентификаторДанных.Регистратор.Значение, "Дата, Организация, Проведен");
			Если ПроверяемыеРеквизиты.Проведен Тогда
				ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ИдентификаторДанных.Регистратор.Значение, Ложь);
				ПроверяемыеРеквизиты.Дата = ?(ЗначениеЗаполнено(ДатаПроведения), ДатаПроведения, ПроверяемыеРеквизиты.Дата);
			Иначе
				ПроверяемыеРеквизиты = Неопределено;
			КонецЕсли;	
		Иначе	
			ПроверяемыеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдентификаторДанных.Регистратор.Значение, "Дата, Организация"); 
		КонецЕсли;
		
		Если НЕ ПроверяемыеРеквизиты = Неопределено Тогда
			Проверка = ДанныеДляПроверки.Добавить();
			Проверка.Раздел = "БухгалтерскийУчет";
			Проверка.Объект = ПроверяемыеРеквизиты.Организация;
			Проверка.Дата   = ПроверяемыеРеквизиты.Дата;
		КонецЕсли;
	
	ИначеЕсли ПолноеИмяОбъекта = "РегистрСведений.ДатыПроведенияДокументов" Тогда
		
//		ПроверяемаяСсылка = ИдентификаторДанных.Документ.Значение;
		ТипИдентификатораДанных = ТипЗнч(ИдентификаторДанных);
		Если ТипИдентификатораДанных = Тип("Отбор") Тогда
			ЭлементОтбораДокумент = ИдентификаторДанных.Документ;
		ИначеЕсли ТипИдентификатораДанных = Тип("РегистрСведенийНаборЗаписей.ДатыПроведенияДокументов") Тогда
			ЭлементОтбораДокумент = ИдентификаторДанных.Отбор.Найти("Документ");                      
		КонецЕсли;
		
		ПроверяемаяСсылка = Неопределено;
		Если ЭлементОтбораДокумент <> Неопределено Тогда
			ПроверяемаяСсылка = ЭлементОтбораДокумент.Значение;
		КонецЕсли;	
		Если ПроверяемаяСсылка = Неопределено Тогда
			Возврат;
		КонецЕсли;	
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПроверяемаяСсылка, "Проведен, Дата");
		// При удалении помеченных объектов реквизиты не будут прочитаны из базы.
		ДокументУдален = (РеквизитыДокумента.Проведен = Неопределено);
		ДокументПроведен = (РеквизитыДокумента.Проведен = Истина);
		Если ДокументУдален Или Не ДокументПроведен Тогда
			СохраненнаяДатаПроведения = '00010101';
		Иначе
			СохраненнаяДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ПроверяемаяСсылка, Ложь);
		КонецЕсли;
		Если ДокументУдален Или Не ЗначениеЗаполнено(СохраненнаяДатаПроведения) Тогда
			// Если в регистре сохранена пустая дата, то она будет всегда попадать в закрытый период.
			// Если документ проведен, то датой проведения является дата документа.
			// Если не проведен, чтобы пройти проверку проверяется максимальная дата,
			// которая всегда будет позже закрытого периода.
			// Если документ удален, то запись из регистра можно удалить независимо от даты запрета редактирования.
			Проверка = ДанныеДляПроверки.Добавить();
			Проверка.Раздел = "БухгалтерскийУчет";
			Проверка.Объект = Неопределено;
			МаксимальнаяДата = '39991231235959';
			Если ДокументУдален Тогда
				Проверка.Дата = МаксимальнаяДата;
			Иначе
				Если ДокументПроведен Тогда
					Проверка.Дата = РеквизитыДокумента.Дата;
				Иначе
					Проверка.Дата = МаксимальнаяДата;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли ПолучитьФункциональнуюОпцию("ИспользоватьОтдельнуюДатуПроведенияДокументов") 
		И Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(ИдентификаторДанных)) 
		Тогда	
		ПроверяемыеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИдентификаторДанных, "Дата, Организация, Проведен");
		Если ПроверяемыеРеквизиты.Проведен Тогда
			ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ИдентификаторДанных, Ложь);
			Проверка = ДанныеДляПроверки.Добавить();
			Проверка.Раздел = "БухгалтерскийУчет";
			Проверка.Объект = ПроверяемыеРеквизиты.Организация;
			Проверка.Дата   = ?(ЗначениеЗаполнено(ДатаПроведения), ДатаПроведения, ПроверяемыеРеквизиты.Дата); 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Позволяет переопределить получение данных для проверки даты запрета новой (будущей) версии данных.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных получаемых данных.
//  Данные  - СправочникОбъект,
//                        ДокументОбъект,
//                        ПланВидовХарактеристикОбъект,
//                        ПланСчетовОбъект,
//                        ПланВидовРасчетаОбъект,
//                        БизнесПроцессОбъект,
//                        ЗадачаОбъект,
//                        ПланОбменаОбъект,
//                        РегистрСведенийНаборЗаписей,
//                        РегистрНакопленияНаборЗаписей,
//                        РегистрБухгалтерииНаборЗаписей,
//                        РегистрРасчетаНаборЗаписей      - проверяемый элемент данных или набор записей.
//
//  УзелПроверкиЗапретаЗагрузки - Неопределено, ПланыОбменаСсылка - если Неопределено, то проверить запрет 
//                                изменения данных; иначе - загрузку данных из указанного узла плана обмена.
//
//  ДанныеДляПроверки - ТаблицаЗначений - таблица для заполнения правил проверок и последующей передачи в
//                                         функцию НайденЗапретИзмененияДанных общего модуля ДатыЗапретаИзменения.
//                                        см. ДатыЗапретаИзменения.ШаблонДанныхДляПроверки.
//
//  Пример:
//  Если ТипЗнч(Данные) = Тип("ДокументОбъект.Заказ") И Данные.ЗаказНаряд Тогда
//  	
//  	Проверка = ДанныеДляПроверки.Добавить();
//  	Проверка.Раздел = "ЗаказНаряды";
//  	Проверка.Объект =  Данные.Организация;
//  	Проверка.Дата   = Данные.ДатаОкончанияРабот;
//  	
//  КонецЕсли;
//
Процедура ПередПроверкойНовойВерсииДанных(ОбъектМетаданных, Данные, УзелПроверкиЗапретаЗагрузки, ДанныеДляПроверки) Экспорт
	
	Если ТипЗнч(Данные) = Тип("РегистрСведенийНаборЗаписей.ЗначенияДополнительныхРеквизитовОпераций") 
		ИЛИ ТипЗнч(Данные) = Тип("РегистрСведенийНаборЗаписей.ЗначенияКолонокДополнительныхТабличныхЧастей") Тогда
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьОтдельнуюДатуПроведенияДокументов")
			И Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(Данные.Отбор.Объект.Значение)) 
			Тогда
			ПроверяемыеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Данные.Отбор.Объект.Значение, "Дата, Организация, Проведен");
			Если ПроверяемыеРеквизиты.Проведен Тогда 
				ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(Данные.Отбор.Объект.Значение);
				ПроверяемыеРеквизиты.Дата = ?(ЗначениеЗаполнено(ДатаПроведения), ДатаПроведения, ПроверяемыеРеквизиты.Дата);
			Иначе
				ПроверяемыеРеквизиты = Неопределено;
			КонецЕсли;	
		Иначе	
			ПроверяемыеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Данные.Отбор.Объект.Значение, "Дата, Организация"); 
		КонецЕсли;
		
		Если НЕ ПроверяемыеРеквизиты = Неопределено Тогда
			Проверка = ДанныеДляПроверки.Добавить();
			Проверка.Раздел = "БухгалтерскийУчет";
			Проверка.Объект = ПроверяемыеРеквизиты.Организация;
			Проверка.Дата   = ПроверяемыеРеквизиты.Дата;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Данные) = Тип("РегистрНакопленияНаборЗаписей.ИсполнениеДоговоровСПокупателями")
		ИЛИ ТипЗнч(Данные) = Тип("РегистрНакопленияНаборЗаписей.ИсполнениеОбязательствПоставщиками")
		ИЛИ ТипЗнч(Данные) = Тип("РегистрНакопленияНаборЗаписей.ОплатаОтПокупателейДебиторов")
		ИЛИ ТипЗнч(Данные) = Тип("РегистрНакопленияНаборЗаписей.ОплатаПоставщикамКредиторам") 
		ИЛИ ТипЗнч(Данные) = Тип("РегистрНакопленияНаборЗаписей.РезервМЗ")
		ИЛИ ТипЗнч(Данные) = Тип("РегистрНакопленияНаборЗаписей.РасчетыСоСтудентамиДопУслуги")
		Тогда   
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьОтдельнуюДатуПроведенияДокументов")
			И Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(Данные.Отбор.Регистратор.Значение)) 
			Тогда
			ПроверяемыеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Данные.Отбор.Регистратор.Значение, "Дата, Организация, Проведен");
			Если ПроверяемыеРеквизиты.Проведен Тогда  
				ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(Данные.Отбор.Регистратор.Значение);
				ПроверяемыеРеквизиты.Дата = ?(ЗначениеЗаполнено(ДатаПроведения), ДатаПроведения, ПроверяемыеРеквизиты.Дата);
			Иначе
				ПроверяемыеРеквизиты = Неопределено;
			КонецЕсли;	
		Иначе	
			ПроверяемыеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Данные.Отбор.Регистратор.Значение, "Дата, Организация"); 
		КонецЕсли;
		
		Если НЕ ПроверяемыеРеквизиты = Неопределено Тогда
			Проверка = ДанныеДляПроверки.Добавить();
			Проверка.Раздел = "БухгалтерскийУчет";
			Проверка.Объект = ПроверяемыеРеквизиты.Организация;
			Проверка.Дата   = ПроверяемыеРеквизиты.Дата; 
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Данные) = Тип("РегистрСведенийНаборЗаписей.ДатыПроведенияДокументов") Тогда
		
		Если Данные.Количество() > 0
		   И Не ЗначениеЗаполнено(Данные[0].ДатаПроведения)
		   И ЗначениеЗаполнено(Данные[0].Документ) Тогда
			// Если в регистр записывается пустая дата, то она будет всегда попадать в закрытый период.
			// Чтобы пройти проверку правильно, используется дата документа.
			Проверка = ДанныеДляПроверки.Добавить();
			Проверка.Раздел = "БухгалтерскийУчет";
			Проверка.Объект = Неопределено;
			Проверка.Дата   = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные[0].Документ, "Дата"); 
		КонецЕсли;
		
	ИначеЕсли ПолучитьФункциональнуюОпцию("ИспользоватьОтдельнуюДатуПроведенияДокументов")
		И Метаданные.Документы.Содержит(Данные.Метаданные())
		И Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(Данные.Ссылка)) 
		Тогда
		Если НЕ Данные.ЭтоНовый() Тогда
			// Для нового документа дату запрета проверяем стандартно, по дате документа 
			ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(Данные.Ссылка);
			Проверка = ДанныеДляПроверки.Добавить();
			Проверка.Раздел = "БухгалтерскийУчет";
			Проверка.Объект = Данные.Организация;
			Проверка.Дата   = ?(ЗначениеЗаполнено(ДатаПроведения), ДатаПроведения, Данные.Дата); 
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 
