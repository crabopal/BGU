#Область ПрограммныйИнтерфейс

Функция ПолучитьДанныеСкидкиНаценки(СкидкаНаценка) Экспорт
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СкидкаНаценка, "ЗначениеСкидкиНаценки, СпособПредоставления, СтатусДействия, Комментарий, ДатаНачалаДействия, ДатаОкончанияДействия,
	|ОкруглятьСуммуСкидки, РежимОкругленияРезультата, КоличествоЗнаковДробнойЧасти");
	
	Возврат СтруктураДанных;
КонецФункции

Функция ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры) Экспорт
	Результат = 0;
	ПараметрыОкругления = Новый Структура;
	
	СтруктураДанных = ПолучитьДанныеСкидкиНаценки(СкидкаНаценка);
	ПараметрыОкругления.Вставить("ОкруглятьСуммуСкидки", СтруктураДанных.ОкруглятьСуммуСкидки); 
	ПараметрыОкругления.Вставить("КоличествоЗнаковДробнойЧасти", СтруктураДанных.КоличествоЗнаковДробнойЧасти);
	ПараметрыОкругления.Вставить("РежимОкругления", ?(СтруктураДанных.РежимОкругленияРезультата = 1, РежимОкругления.Окр15как10, РежимОкругления.Окр15как20));
	
	Если СтруктураДанных.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Процент Тогда
		Результат = СтруктураДанных.ЗначениеСкидкиНаценки * ЦенаНоменклатуры / 100;
		Если ПараметрыОкругления.ОкруглятьСуммуСкидки = 1 Тогда
			ДробнаяЧасть = Результат - Цел(Результат);
			Если ДробнаяЧасть > 0 Тогда
				Результат = Цел(Результат) + 1;
			КонецЕсли;
		ИначеЕсли ПараметрыОкругления.ОкруглятьСуммуСкидки = 2 Тогда
			Результат = Окр(Результат, ПараметрыОкругления.КоличествоЗнаковДробнойЧасти, ПараметрыОкругления.РежимОкругления);  
		КонецЕсли;	
	ИначеЕсли СтруктураДанных.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Сумма Тогда
		Результат = СтруктураДанных.ЗначениеСкидкиНаценки;
	КонецЕсли;	
		
	Возврат Результат;
КонецФункции

Функция ТипыУслугРабот() Экспорт 
	ТипыУслугРабот = Новый Массив;
	ТипыУслугРабот.Добавить(Перечисления.ТипыНоменклатуры.Госуслуга);
	ТипыУслугРабот.Добавить(Перечисления.ТипыНоменклатуры.ГруппаУслуг);
	ТипыУслугРабот.Добавить(Перечисления.ТипыНоменклатуры.Работа);
	ТипыУслугРабот.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
	ТипыУслугРабот.Добавить(Перечисления.ТипыНоменклатуры.УслугиАренды);
	
	Возврат ТипыУслугРабот; 
КонецФункции

Функция ТипыТовары() Экспорт
	ТипыУслугРабот = ТипыУслугРабот();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТипыНоменклатуры.Ссылка
	               |ИЗ
	               |	Перечисление.ТипыНоменклатуры КАК ТипыНоменклатуры
	               |ГДЕ
	               |	НЕ ТипыНоменклатуры.Ссылка В (&ТипыУслугРабот)";
	Запрос.УстановитьПараметр("ТипыУслугРабот", ТипыУслугРабот);
	ТипыТовары = Запрос.Выполнить().Выгрузить();
				   
	Возврат ТипыТовары.ВыгрузитьКолонку("Ссылка"); 
КонецФункции

Функция ТипыУслугРаботПрейскуранта() Экспорт 
	ТипыУслугРабот = Новый Массив;
	ТипыУслугРабот.Добавить(Перечисления.ТипыНоменклатуры.Госуслуга);
	ТипыУслугРабот.Добавить(Перечисления.ТипыНоменклатуры.ГруппаУслуг);
	ТипыУслугРабот.Добавить(Перечисления.ТипыНоменклатуры.Работа);
	ТипыУслугРабот.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
	ТипыУслугРабот.Добавить(Перечисления.ТипыНоменклатуры.УслугиАренды);
	
	Возврат ТипыУслугРабот; 
КонецФункции

Функция ТипНоменклатуры(Номенклатура) Экспорт 
	Результат = 3;
	
	ТипНоменклатуры = Номенклатура.ТипНоменклатуры;
	ТипыУслугРабот = ТипыУслугРабот();
	
	Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
		Результат = 2;
	ИначеЕсли НЕ ТипыУслугРабот.Найти(ТипНоменклатуры) = Неопределено Тогда
		Результат = 1;
	КонецЕсли;	
	
	Возврат Результат; 
КонецФункции

Функция ПризнакиПредметаРасчетаТовары() Экспорт 
	Результат = Новый Массив;
	
	Результат = ТипыТовары();
	
	Возврат Результат; 
КонецФункции

Функция ТекущаяОткрытаяКассоваяСмена(Организация, КассаККМ) Экспорт
	Результат = Документы.КассоваяСмена.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	КассоваяСмена.Ссылка
	               |ИЗ
	               |	Документ.КассоваяСмена КАК КассоваяСмена
	               |ГДЕ
	               |	КассоваяСмена.Организация = &Организация
	               |	И КассоваяСмена.КассаККМ = &КассаККМ
	               |	И КассоваяСмена.Статус = &Статус
	               |	И КассоваяСмена.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КассоваяСмена.НачалоКассовойСмены УБЫВ";
				   
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыКассовойСмены.Открыта);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.Ссылка;
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции

