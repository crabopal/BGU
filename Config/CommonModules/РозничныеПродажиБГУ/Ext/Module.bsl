	|			И ЧекиККМДляРеестраПлатежейЧекиККМ.КлючЧека = ФискальныеОперации.ИдентификаторЗаписи
	|ГДЕ
	|	ЧекиККМДляРеестраПлатежейЧекиККМ.Ссылка В(&МассивОбъектов)";

	Возврат Запрос.Выполнить();
	
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Служебная функция, предназначенная для получения описания типов числа, заданной разрядности.
// 
// Параметры:
//  Разрядность - Число - разряд числа;
//  РазрядностьДробнойЧасти - Число - разряд дробной части;
//  Неотрицательный - Булево - если Истина, то числа только положительные, если Ложь, то любые.
//
// Возвращаемое значение:
//  Объект "ОписаниеТипов" для числа указанной разрядности.
//
Функция ПолучитьОписаниеТиповЧисла(Разрядность, РазрядностьДробнойЧасти, Неотрицательный = Ложь) Экспорт
	
	Если Неотрицательный Тогда
		Знак = ДопустимыйЗнак.Неотрицательный;
	Иначе
		Знак = ДопустимыйЗнак.Любой;
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(Разрядность, РазрядностьДробнойЧасти, Знак));
КонецФункции

Процедура ЗаполнитьСписокТоваровРаботУслугПоДокументамОснованиям(ДокументЧек) Экспорт
	ДокументЧек.ТоварыРаботыУслуги.Очистить();
	
	ТаблицаДокументовОснований = ДокументЧек.ДокументыОснования.Выгрузить(, "ДокументОснованиеЧекаККМ");
	ТаблицаДокументовОснований.Колонки.Добавить("ПризнакСпособаРасчета", Новый ОписаниеТипов("ПеречислениеСсылка.ПризнакиСпособаРасчета"), "ПризнакСпособаРасчета",); 
	Для каждого ТекСтрока Из ТаблицаДокументовОснований Цикл
		ТекСтрока.ПризнакСпособаРасчета = ДокументЧек.ПризнакСпособаРасчетаЧекаККМ;
	КонецЦикла;
	
	ПереченьНоменклатурыДляЧекаККМ = ПодключаемоеОборудованиеБГУ.ТаблицаНоменклатурыЧекаККМДляДокументовОснований(ТаблицаДокументовОснований);
	ТаблицаНоменклатурыПрейскуранта = ЗаполнитьНоменклатуруПрейскурантаПоНоменклатуре(ПереченьНоменклатурыДляЧекаККМ);
	
	Для каждого ТекСтрока Из ПереченьНоменклатурыДляЧекаККМ Цикл
		НоваяСтрока = ДокументЧек.ТоварыРаботыУслуги.Добавить();
		РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязи(ДокументЧек.ТоварыРаботыУслуги, НоваяСтрока, "КлючСвязи");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.ЦенаБезСкидок = ТекСтрока.Цена;
		НоваяСтрока.Содержание = ТекСтрока.СодержаниеУслуги;
		
		НайденнаяСтрока = ТаблицаНоменклатурыПрейскуранта.Найти(ТекСтрока.Номенклатура, "Номенклатура");

		Если НЕ НайденнаяСтрока = Неопределено Тогда
			НоваяСтрока.Номенклатура = НайденнаяСтрока.НоменклатураПрейскуранта;
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Не заполнена номенклатура прейскуранта. В справочнике ""Прейскурант"" отсутствует соответствующий элемент или 
			|существует более одного элемента с нужной номенклатурой. Следует создать нужный элемент справочника ""Прейскурант"" или выбрать нужный.'");
			Сообщение.Сообщить();
		КонецЕсли;	
		
	КонецЦикла;	
КонецПроцедуры

Функция ЗаполнитьНоменклатуруПрейскурантаПоНоменклатуре(ТаблицаНоменклатуры)
	
	МассивНоменклатуры = ТаблицаНоменклатуры.ВыгрузитьКолонку("Номенклатура");
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Прейскурант.Ссылка КАК Ссылка,
	               |	Прейскурант.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ ВесьПрейскурант
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |ГДЕ
	               |	Прейскурант.ПометкаУдаления = ЛОЖЬ
	               |	И Прейскурант.Номенклатура В(&МассивНоменклатуры)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Прейскурант.Номенклатура КАК Номенклатура,
	               |	1 КАК Количество
	               |ПОМЕСТИТЬ НоменклатураКоличество
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |ГДЕ
	               |	Прейскурант.ПометкаУдаления = ЛОЖЬ
	               |	И Прейскурант.Номенклатура В(&МассивНоменклатуры)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураКоличество.Номенклатура КАК Номенклатура,
	               |	СУММА(НоменклатураКоличество.Количество) КАК Количество
	               |ПОМЕСТИТЬ КоличествоНоменклатуры
	               |ИЗ
	               |	НоменклатураКоличество КАК НоменклатураКоличество
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НоменклатураКоличество.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВесьПрейскурант.Ссылка КАК НоменклатураПрейскуранта,
	               |	ВесьПрейскурант.Номенклатура КАК Номенклатура
	               |ИЗ
	               |	ВесьПрейскурант КАК ВесьПрейскурант
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоНоменклатуры КАК КоличествоНоменклатуры
	               |		ПО ВесьПрейскурант.Номенклатура = КоличествоНоменклатуры.Номенклатура
	               |ГДЕ
	               |	КоличествоНоменклатуры.Количество = 1";

	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции	

Процедура ВыполнитьЗаписьСобытияПоВЖурналРегистрации(ОписаниеСобытия, КодСобытия, УровеньВажности = Неопределено,
	ОбъектМетаданных = Неопределено, ДанныеСсылка = Неопределено, РежимТранзакции = Неопределено) Экспорт
	
	
	Если КодСобытия = "УстановкаЦенНоменклатуры" Тогда Подсистема = НСтр("ru = 'Установка цен номенклатуры'",
		ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	ИначеЕсли КодСобытия = "Прейскурант" Тогда Подсистема = НСтр("ru = 'Справочник ""Прейскурант""'",
		ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	ИначеЕсли КодСобытия = "Номенклатура" Тогда Подсистема = НСтр("ru = 'Справочник ""Прейскурант""'",
		ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	Иначе
		Подсистема = НСтр("ru = 'Подсистема ""Розничные продажи""'",
		ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	КонецЕсли;
	
	УровеньВажностиСобытия = ?(ТипЗнч(УровеньВажности) = Тип("УровеньЖурналаРегистрации"),
		УровеньВажности, УровеньЖурналаРегистрации.Ошибка);
		
	ИмяСобытия = СтрЗаменить(НСтр("ru = 'Розничные продажи. %1'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
		"%1", Подсистема);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньВажностиСобытия, ОбъектМетаданных, ДанныеСсылка, ОписаниеСобытия,
		РежимТранзакции);
	
КонецПроцедуры

Функция ЕдинственнаяСтатьяАналитикиОплаты(Организация) Экспорт
	
	Результат = Справочники.СтатьиАналитикиОплатыЧекаККМ.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СтатьиАналитикиОплатыЧекаККМ.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.СтатьиАналитикиОплатыЧекаККМ КАК СтатьиАналитикиОплатыЧекаККМ
	               |ГДЕ
	               |	СтатьиАналитикиОплатыЧекаККМ.Организация = &Организация
	               |	И СтатьиАналитикиОплатыЧекаККМ.ПометкаУдаления = ЛОЖЬ
	               |	И СтатьиАналитикиОплатыЧекаККМ.ЭтоГруппа = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	ТаблицаСтатейАналитики = Запрос.Выполнить().Выгрузить();
	Если ТаблицаСтатейАналитики.Количество() = 1 Тогда
		Результат = ТаблицаСтатейАналитики[0].Ссылка;
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции	

Функция ТаблицаДанныхДляВводаПКО(ОтчетПоКассовойСмене) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтчетПоКассовойСмене, "Дата, Организация");

	СчетУчетаПоУмолчанию = БухгалтерскийУчет.СчетПоКоду("205.31", ЗначенияРеквизитов.Дата, ЗначенияРеквизитов.Организация);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты.ИФО КАК ИФО,
	               |	ВЫБОР
	               |		КОГДА ВЫРАЗИТЬ(ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты КАК Справочник.СтатьиАналитикиОплатыЧекаККМ).СчетУчета = &ПустойСчетУчета
	               |			ТОГДА &СчетУчетаПоУмолчанию
	               |		ИНАЧЕ ВЫРАЗИТЬ(ОтчетПоКассовойСменеОплатаНаличными.СтатьяАналитикиОплаты КАК Справочник.СтатьиАналитикиОплатыЧекаККМ).СчетУчета
	               |	КОНЕЦ КАК СчетУчета,
	               |	ОтчетПоКассовойСменеОплатаНаличными.Сумма КАК Сумма,
	               |	ОтчетПоКассовойСменеОплатаНаличными.Подразделение КАК Подразделение
	               |ПОМЕСТИТЬ Нераспределено
	               |ИЗ
	               |	Документ.ОтчетПоКассовойСмене.ОплатаНаличными КАК ОтчетПоКассовойСменеОплатаНаличными
	               |ГДЕ
	               |	ОтчетПоКассовойСменеОплатаНаличными.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПриходныйКассовыйОрдер.ИФО,
	               |	ПриходныйКассовыйОрдер.КорСчет,
	               |	-1 * ПриходныйКассовыйОрдер.СуммаДокумента,
	               |	ПриходныйКассовыйОрдер.Подразделение
	               |ИЗ
	               |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	               |ГДЕ
	               |	ПриходныйКассовыйОрдер.ДокументОснование = &Ссылка
	               |	И ПриходныйКассовыйОрдер.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Нераспределено.ИФО КАК ИФО,
	               |	Нераспределено.СчетУчета КАК СчетУчета,
	               |	СУММА(Нераспределено.Сумма) КАК Сумма,
	               |	Нераспределено.Подразделение КАК Подразделение
	               |ПОМЕСТИТЬ ОбщиеДанныеРаспределения
	               |ИЗ
	               |	Нераспределено КАК Нераспределено
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Нераспределено.СчетУчета,
	               |	Нераспределено.ИФО,
	               |	Нераспределено.Подразделение
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОбщиеДанныеРаспределения.ИФО КАК ИФО,
	               |	ОбщиеДанныеРаспределения.СчетУчета КАК СчетУчета,
	               |	ОбщиеДанныеРаспределения.Сумма КАК Сумма,
	               |	ОбщиеДанныеРаспределения.Подразделение КАК Подразделение
	               |ИЗ
	               |	ОбщиеДанныеРаспределения КАК ОбщиеДанныеРаспределения
	               |ГДЕ
	               |	ОбщиеДанныеРаспределения.Сумма <> 0";
	Запрос.УстановитьПараметр("Ссылка", ОтчетПоКассовойСмене);
	Запрос.УстановитьПараметр("СчетУчетаПоУмолчанию", СчетУчетаПоУмолчанию);
	Запрос.УстановитьПараметр("ПустойСчетУчета", Планысчетов.ЕПСБУ.ПустаяСсылка());
	Результат = Запрос.Выполнить().Выгрузить();
	Для каждого ТекСтрока Из Результат Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрока.СчетУчета) Тогда
			ТекСтрока.СчетУчета = СчетУчетаПоУмолчанию;
		КонецЕсли;	
	КонецЦикла;
	Результат.Свернуть("ИФО, СчетУчета, Подразделение", "Сумма");
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции	

Функция ЕдинственныйСчетУчетаПродажЗаНаличные(Объект) Экспорт
	Результат = Новый Структура("ИФО, КоличествоСчетовУчета, СчетУчета, Сумма", 
		ПредопределенноеЗначение("Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка"), 0, Неопределено, 0);
	
	ТаблицаОстатков = ТаблицаДанныхДляВводаПКО(Объект.Ссылка);
	
	Результат.КоличествоСчетовУчета = ТаблицаОстатков.Количество();	
	Если ТаблицаОстатков.Количество() = 1 Тогда
		Результат.КоличествоСчетовУчета = 1;	
		ЗаполнитьЗначенияСвойств(Результат, ТаблицаОстатков[0]);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЕстьПравоНастройкиРозничныхПродаж() Экспорт
	
	Результат = Истина;
	
	Результат = Пользователи.РолиДоступны("ДобавлениеИзменениеНастроекРозничныхПродаж") ИЛИ
		Пользователи.РолиДоступны("ПолныеПрава");
	
	Возврат Результат;
	
КонецФункции

Функция ВестиКонтрольОстатковТоваров(КассаККМ) Экспорт
	Результат = Ложь;
	Если ЗначениеЗаполнено(КассаККМ) Тогда
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КассаККМ,
			"ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЭтоСкладТорговойТочки(ЦМО) Экспорт
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ФискальныеРегистраторы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ФискальныеРегистраторы КАК ФискальныеРегистраторы
	               |ГДЕ
	               |	ФискальныеРегистраторы.ЦМО = &ЦМО
	               |	И ФискальныеРегистраторы.ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки = ИСТИНА";
	Запрос.УстановитьПараметр("ЦМО", ЦМО);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Истина;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ЦМОКассыККМ(КассаККМ) Экспорт
	
	Результат = Справочники.ЦМО.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(КассаККМ) Тогда
		Возврат Результат;
	Конецесли;	
	
	Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КассаККМ, "ЦМО");
	
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьОстаткиНоменклатурыИзПрейскуранта(Организация, Номенклатура, ЦМО, ДатаРасчетов) Экспорт 

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Прейскурант.Ссылка КАК Номенклатура,
	|	Прейскурант.Номенклатура КАК СвязаннаяНоменклатура
	|ПОМЕСТИТЬ ВТПрейскурант
	|ИЗ
	|	Справочник.Прейскурант КАК Прейскурант
	|ГДЕ
	|	Прейскурант.Ссылка В(&СписокНоменклатуры)
	|	И НЕ Прейскурант.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслугРабот)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СвязаннаяНоменклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПрейскурант.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ТоварыВТорговыхТочкахОстатки.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	ВТПрейскурант КАК ВТПрейскурант
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВТорговыхТочках.Остатки(
	|				&ДатаРасчетов,
	|				Организация = &Организация
	|					И ЦМО = &ЦМО) КАК ТоварыВТорговыхТочкахОстатки
	|		ПО ВТПрейскурант.СвязаннаяНоменклатура = ТоварыВТорговыхТочкахОстатки.Номенклатура";
	
	Запрос.УстановитьПараметр("Организация"					, Организация);
	Запрос.УстановитьПараметр("СписокНоменклатуры"			, Номенклатура);
	Запрос.УстановитьПараметр("ЦМО"							, ЦМО);
	Запрос.УстановитьПараметр("ДатаРасчетов"				, ДатаРасчетов);
	Запрос.УстановитьПараметр("ТипыНоменклатурыУслугРабот"	, РозничныеПродажиБГУ.ТипыУслугРабот());
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		Результат.Вставить(Выборка.Номенклатура, Выборка.Остаток);
	
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ПолучитьМаркируемыеТовары(СписокНоменклатуры) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Прейскурант.Ссылка КАК Номенклатура
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |ГДЕ
	               |	Прейскурант.Ссылка В(&Номенклатура)
	               |	И НЕ Прейскурант.Номенклатура.ВидМаркируемойПродукции = ЗНАЧЕНИЕ(Перечисление.ВидыМаркируемойПродукции.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Номенклатура", СписокНоменклатуры);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат РезультатЗапроса;
	
КонецФункции

Функция НайтиДокументыВведенныеНаОсновании(ДокументОснование, ТипДокумента) Экспорт 
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ИскомыйДокумент.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ИскомыйДокумент КАК ИскомыйДокумент
	               |ГДЕ
	               |	ИскомыйДокумент.ДокументОснование = &ДокументОснование
				   |    И ИскомыйДокумент.ПометкаУдаления = ЛОЖЬ";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИскомыйДокумент", ТипДокумента);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат РезультатЗапроса;
	
КонецФункции	
	
#КонецОбласти
