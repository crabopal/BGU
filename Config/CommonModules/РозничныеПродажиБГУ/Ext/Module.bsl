// Заполняет колонку таблицы значений последовательными номерами.
//
// Параметры:
//  Таблица - таблица значений, строки которой нужно пронумеровать;
//  ИмяКолонкиНомераСтроки - колонка таблицы значений, в которой будут указаны номера строк.
//
Процедура ПронумероватьТаблицуЗначений(Таблица, ИмяКолонкиНомераСтроки) Экспорт

	Таблица.Колонки.Добавить(ИмяКолонкиНомераСтроки, ПолучитьОписаниеТиповЧисла(15, 0));

	КоличествоСтрок = Таблица.Количество() - 1;
	Для НомерСтроки = 0 По КоличествоСтрок Цикл
		Таблица[НомерСтроки][ИмяКолонкиНомераСтроки] = НомерСтроки;
	КонецЦикла;
КонецПроцедуры

Функция ПечатьРасчетногоДокументаБезККТ(МассивОбъектов, ОбъектыПечати) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "РасчетныйДокументБезККТ";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_РасчетныйДокументБезККТ");
	
	ОбластьЗаголовок		= Макет.ПолучитьОбласть("Заголовок | РасчетныйДокумент");
	ОбластьШапка			= Макет.ПолучитьОбласть("Шапка | РасчетныйДокумент");
	ОбластьСтрокаЧека		= Макет.ПолучитьОбласть("СтрокаНоменклатуры | РасчетныйДокумент");
	ОбластьИтог				= Макет.ПолучитьОбласть("Итоги | РасчетныйДокумент");
	ОбластьИтогНДС			= Макет.ПолучитьОбласть("ИтогиНДСПоСтавкам | РасчетныйДокумент");
	
	ОбластьОплата			= Макет.ПолучитьОбласть("Оплата | РасчетныйДокумент");
	ОбластьПодвал			= Макет.ПолучитьОбласть("Подвал | РасчетныйДокумент");
	
	ОбластьРазделительнаяЛиния1Высота = Макет.ПолучитьОбласть("Заголовок | РазделительнаяЛиния");
	ОбластьРазделительнаяЛиния3Высота = Макет.ПолучитьОбласть("СтрокаНоменклатуры | РазделительнаяЛиния");
	ОбластьРазделительнаяЛиния5Высота = Макет.ПолучитьОбласть("Шапка | РазделительнаяЛиния");
	
	КЧ = Новый КвалификаторыЧисла(17, 2);
	МассивКЧ = Новый Массив;
	МассивКЧ.Добавить(Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(МассивКЧ, , ,КЧ);
	
	ТаблицаНДС = Новый ТаблицаЗначений;
	ТаблицаНДС.Колонки.Добавить("Ставка");
	ТаблицаНДС.Колонки.Добавить("Сумма", ОписаниеТиповЧ);
	
	ПервыйДокумент = Истина;
	
	УстановитьПривилегированныйРежим(Истина);	
	РезультатЗапроса = ДанныеДляРасчетныхДокументовБезККТ(МассивОбъектов);
	УстановитьПривилегированныйРежим(Ложь);
		
	ВыборкаДокументов = РезультатЗапроса.Выбрать();
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если ВыборкаДокументов.ПакетнаяПечатьЧеков Тогда
			Если (ВыборкаДокументов.НомерЧекаККМ = 0) И (ВыборкаДокументов.НомерЧекаФискальнойОперации = 0) Тогда
				ТекстСообщения = НСтр("ru = 'Для документа %1 не сформирован номер расчетного документа для строки %2. Печать невозможна. Следует нажать на кнопку ""Напечатать чеки"" на форме документа.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ВыборкаДокументов.Ссылка,
									ВыборкаДокументов.НомерЧекаВСписке);
				
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
				Продолжить;
			КонецЕсли;
		Иначе	
			Если (ВыборкаДокументов.НомерЧекаККМ = 0) И (ВыборкаДокументов.НомерЧекаФискальнойОперации = 0) Тогда
				ТекстСообщения = НСтр("ru = 'Для документа %1 от %2 № %3 не сформирован номер расчетного документа. Печать невозможна. Следует нажать на кнопку ""Напечатать чек"" на форме документа.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ВыборкаДокументов.ВидДокументаОснования,
									ВыборкаДокументов.ДатаДокументаОснования, ВыборкаДокументов.НомерДокументаОснования);
				
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СведенияРасчетногоДокумента = Новый Структура;
		СведенияРасчетногоДокумента.Вставить("Организация");
		СведенияРасчетногоДокумента.Вставить("НомерЧекаККМ");
		СведенияРасчетногоДокумента.Вставить("ДатаЧекаККМ");
		СведенияРасчетногоДокумента.Вставить("ВремяЧекаККМ");
		СведенияРасчетногоДокумента.Вставить("ТипРасчета");
		СведенияРасчетногоДокумента.Вставить("СистемаНалогообложения");
		СведенияРасчетногоДокумента.Вставить("СуммаНаличными", "0,00");
		СведенияРасчетногоДокумента.Вставить("СуммаЭлектронно", "0,00");
		СведенияРасчетногоДокумента.Вставить("СуммаПредоплаты", "0,00");
		СведенияРасчетногоДокумента.Вставить("СуммаПостоплаты", "0,00");
		СведенияРасчетногоДокумента.Вставить("Должность", "Кассир");
		
		ПакетнаяПечатьЧеков = ВыборкаДокументов.ПакетнаяПечатьЧеков;
		
		Если ПакетнаяПечатьЧеков Тогда
			ОбщиеПараметрыЧека = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(ВыборкаДокументов.Ссылка, ВыборкаДокументов.Ссылка, ВыборкаДокументов.НомерЧекаВСписке);
		Иначе	
			ОбщиеПараметрыЧека = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(ВыборкаДокументов.Ссылка, ВыборкаДокументов.Ссылка);
		КонецЕсли;	
		
		СведенияРасчетногоДокумента.Организация = Строка(ВыборкаДокументов.Организация.НаименованиеСокращенное);
		СведенияРасчетногоДокумента.НомерЧекаККМ = ?(ВыборкаДокументов.НомерЧекаФискальнойОперации<>0, 
			ВыборкаДокументов.НомерЧекаФискальнойОперации, 
			ВыборкаДокументов.НомерЧекаККМ);
		СведенияРасчетногоДокумента.ДатаЧекаККМ = ?(ВыборкаДокументов.НомерЧекаФискальнойОперации<>0,
			Формат(ВыборкаДокументов.ДатаФискальнойОперации, "ДФ=dd.MM.yyyy"), Формат(ВыборкаДокументов.ДатаЧекаККМ, "ДФ=dd.MM.yyyy"));
		СведенияРасчетногоДокумента.ВремяЧекаККМ = ?(ВыборкаДокументов.НомерЧекаФискальнойОперации<>0,
			Формат(ВыборкаДокументов.ДатаФискальнойОперации, "ДФ=HH:mm"), 
			Формат(ВыборкаДокументов.ДатаЧекаККМ, "ДФ=HH:mm"));
		СведенияРасчетногоДокумента.ТипРасчета = Строка(ОбщиеПараметрыЧека.ТипРасчета);
		
		Если ОбщиеПараметрыЧека.СистемаНалогообложения = Перечисления.ТипыСистемНалогообложенияККТ.УСНДоход Тогда
			СведенияРасчетногоДокумента.СистемаНалогообложения = НСтр("ru = 'УСН (ДОХОД)'");		
		ИначеЕсли ОбщиеПараметрыЧека.СистемаНалогообложения = Перечисления.ТипыСистемНалогообложенияККТ.УСНДоходРасход Тогда
			СведенияРасчетногоДокумента.СистемаНалогообложения = НСтр("ru = 'УСН (ДОХОД МИНУС РАСХОД)'");		
		ИначеЕсли ОбщиеПараметрыЧека.СистемаНалогообложения = Перечисления.ТипыСистемНалогообложенияККТ.ЕНВД Тогда
			СведенияРасчетногоДокумента.СистемаНалогообложения = НСтр("ru = 'ЕНВД'");		
		Иначе
			СведенияРасчетногоДокумента.СистемаНалогообложения = НСтр("ru = 'ОСН'");		
		КонецЕсли;
		
		ТаблицаНоменклатуры = ОбщиеПараметрыЧека.ПозицииЧека;
		
		ВыводНаОбычныйПринтер = ?(ВыборкаДокументов.КассаККМ.РежимПечатиРасчетныхДокументов = 0, Истина, Ложь);
		КоличествоЭкземпляров = 2;
		
		Если ВыводНаОбычныйПринтер Тогда
			ОбластьЗаголовок.Параметры.Заполнить(СведенияРасчетногоДокумента);
			Для н = 1 По КоличествоЭкземпляров Цикл
				Если н = 1 Тогда 
					ТабличныйДокумент.Вывести(ОбластьЗаголовок);
				Иначе
					ТабличныйДокумент.Присоединить(ОбластьЗаголовок);
				КонецЕсли;	
				
				Если н <> КоличествоЭкземпляров Тогда 
					ТабличныйДокумент.Присоединить(ОбластьРазделительнаяЛиния1Высота);
				КонецЕсли;	
			КонецЦикла;
		
			ОбластьШапка.Параметры.Заполнить(ОбщиеПараметрыЧека);
			ОбластьШапка.Параметры.Заполнить(СведенияРасчетногоДокумента);
			Для н = 1 По КоличествоЭкземпляров Цикл
				Если н = 1 Тогда 
					ТабличныйДокумент.Вывести(ОбластьШапка);
				Иначе
					ТабличныйДокумент.Присоединить(ОбластьШапка);
				КонецЕсли;	
				
				Если н <> КоличествоЭкземпляров Тогда 
					ТабличныйДокумент.Присоединить(ОбластьРазделительнаяЛиния5Высота);
				КонецЕсли;	
			КонецЦикла;
			
			ТаблицаНДС.Очистить();
			Всего = 0;
			ВсегоНДС = 0;
			НомерСтроки = 1;
			Для каждого ТекСтрокаНоменклатуры Из ТаблицаНоменклатуры Цикл
				ТекСтрокаНоменклатуры.НомерСтрокиТовара = НомерСтроки;
				
				ОбластьСтрокаЧека.Параметры.Заполнить(ТекСтрокаНоменклатуры);
				Если ТекСтрокаНоменклатуры.СтавкаНДС = Неопределено Тогда
					ОбластьСтрокаЧека.Параметры.СтавкаНДССтрокой = НСтр("ru = 'Без НДС'");
				Иначе
					ОбластьСтрокаЧека.Параметры.СтавкаНДССтрокой = Строка(ТекСтрокаНоменклатуры.СтавкаНДС)+НСтр("ru = '%'");
					НоваяСтрока = ТаблицаНДС.Добавить();
					НоваяСтрока.Ставка = ТекСтрокаНоменклатуры.СтавкаНДС;
					НоваяСтрока.Сумма = ТекСтрокаНоменклатуры.СуммаНДС;
				КонецЕсли;
				Для н = 1 По КоличествоЭкземпляров Цикл
					Если н = 1 Тогда 
						ТабличныйДокумент.Вывести(ОбластьСтрокаЧека);
					Иначе
						ТабличныйДокумент.Присоединить(ОбластьСтрокаЧека);
					КонецЕсли;	
					
					Если н <> КоличествоЭкземпляров Тогда 
						ТабличныйДокумент.Присоединить(ОбластьРазделительнаяЛиния3Высота);
					КонецЕсли;	
				КонецЦикла;
				
				Всего = Всего + ТекСтрокаНоменклатуры.Сумма;
				ВсегоНДС = ВсегоНДС + ТекСтрокаНоменклатуры.СуммаНДС;
				
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;	
			
			СтруктураИтогов = Новый Структура;
			СтруктураИтогов.Вставить("Всего", Всего);
			СтруктураИтогов.Вставить("ВсегоНДС", ВсегоНДС);
			
			ОбластьИтог.Параметры.Заполнить(СтруктураИтогов);
			Для н = 1 По КоличествоЭкземпляров Цикл
				Если н = 1 Тогда 
					ТабличныйДокумент.Вывести(ОбластьИтог);
				Иначе
					ТабличныйДокумент.Присоединить(ОбластьИтог);
				КонецЕсли;	
				Если н <> КоличествоЭкземпляров Тогда 
					ТабличныйДокумент.Присоединить(ОбластьРазделительнаяЛиния1Высота);
				КонецЕсли;	
			КонецЦикла;
			
			ТаблицаОплат = ОбщиеПараметрыЧека.ТаблицаОплат;
			Для каждого ТекСтрокаОплаты Из ТаблицаОплат Цикл
				Если ТекСтрокаОплаты.ТипОплаты = Перечисления.ТипыОплатыККТ.Наличные Тогда
					СведенияРасчетногоДокумента.СуммаНаличными = Формат(ТекСтрокаОплаты.Сумма, "ЧЦ=17; ЧДЦ=2");
				ИначеЕсли ТекСтрокаОплаты.ТипОплаты = Перечисления.ТипыОплатыККТ.Электронно Тогда
					СведенияРасчетногоДокумента.СуммаЭлектронно = Формат(ТекСтрокаОплаты.Сумма, "ЧЦ=17; ЧДЦ=2");
				ИначеЕсли ТекСтрокаОплаты.ТипОплаты = Перечисления.ТипыОплатыККТ.Предоплата Тогда
					СведенияРасчетногоДокумента.СуммаПредоплаты = Формат(ТекСтрокаОплаты.Сумма, "ЧЦ=17; ЧДЦ=2");
				ИначеЕсли ТекСтрокаОплаты.ТипОплаты = Перечисления.ТипыОплатыККТ.Постоплата Тогда
					СведенияРасчетногоДокумента.СуммаПостоплаты = Формат(ТекСтрокаОплаты.Сумма, "ЧЦ=17; ЧДЦ=2");
				КонецЕсли;	
			КонецЦикла;
			
			ТаблицаНДС.Свернуть("Ставка","Сумма");
			ПерваяСтрока = Истина;
			Для каждого ТекСтрокаСтавки Из ТаблицаНДС Цикл
				СтруктураИтоговНДС = Новый Структура;
				СтруктураИтоговНДС.Вставить("Втч", ?(ПерваяСтрока, НСтр("ru = 'в т.ч.'"), ""));
				СтруктураИтоговНДС.Вставить("СтавкаНДС", Строка(ТекСтрокаСтавки.Ставка)+НСтр("ru = '%'"));
				СтруктураИтоговНДС.Вставить("СуммаНДС", ТекСтрокаСтавки.Сумма);
				ПерваяСтрока = Ложь;
				
				ОбластьИтогНДС.Параметры.Заполнить(СтруктураИтоговНДС);
				Для н = 1 По КоличествоЭкземпляров Цикл
					Если н = 1 Тогда 
						ТабличныйДокумент.Вывести(ОбластьИтогНДС);
					Иначе
						ТабличныйДокумент.Присоединить(ОбластьИтогНДС);
					КонецЕсли;	
					
					Если н <> КоличествоЭкземпляров Тогда 
						ТабличныйДокумент.Присоединить(ОбластьРазделительнаяЛиния1Высота);
					КонецЕсли;
				КонецЦикла;	
			КонецЦикла;	
			
			ОбластьОплата.Параметры.Заполнить(СведенияРасчетногоДокумента);
			Для н = 1 По КоличествоЭкземпляров Цикл
				Если н = 1 Тогда 
					ТабличныйДокумент.Вывести(ОбластьОплата);
				Иначе
					ТабличныйДокумент.Присоединить(ОбластьОплата);
				КонецЕсли;	
				Если н <> КоличествоЭкземпляров Тогда 
					ТабличныйДокумент.Присоединить(ОбластьРазделительнаяЛиния5Высота);
				КонецЕсли;	
			КонецЦикла;
			
			ОбластьПодвал.Параметры.Заполнить(ОбщиеПараметрыЧека);
			ОбластьПодвал.Параметры.Заполнить(СведенияРасчетногоДокумента);
			Для н = 1 По КоличествоЭкземпляров Цикл
				Если н = 1 Тогда 
					ТабличныйДокумент.Вывести(ОбластьПодвал);
				Иначе
					ТабличныйДокумент.Присоединить(ОбластьПодвал);
				КонецЕсли;	
				Если н <> КоличествоЭкземпляров Тогда 
					ТабличныйДокумент.Присоединить(ОбластьРазделительнаяЛиния5Высота);
				КонецЕсли;	
			КонецЦикла;	
		Иначе
			Для н = 1 По КоличествоЭкземпляров Цикл
				ОбластьЗаголовок.Параметры.Заполнить(СведенияРасчетногоДокумента);
				ТабличныйДокумент.Вывести(ОбластьЗаголовок);
				
				ОбластьШапка.Параметры.Заполнить(ОбщиеПараметрыЧека);
				ОбластьШапка.Параметры.Заполнить(СведенияРасчетногоДокумента);
				ТабличныйДокумент.Вывести(ОбластьШапка);
				
				ТаблицаНДС.Очистить();
				Всего = 0;
				ВсегоНДС = 0;
				НомерСтроки = 1;
				Для каждого ТекСтрокаНоменклатуры Из ТаблицаНоменклатуры Цикл
					ТекСтрокаНоменклатуры.НомерСтрокиТовара = НомерСтроки;
					
					ОбластьСтрокаЧека.Параметры.Заполнить(ТекСтрокаНоменклатуры);
					Если ТекСтрокаНоменклатуры.СтавкаНДС = Неопределено Тогда
						ОбластьСтрокаЧека.Параметры.СтавкаНДССтрокой = НСтр("ru = 'Без НДС'");
					Иначе
						ОбластьСтрокаЧека.Параметры.СтавкаНДССтрокой = Строка(ТекСтрокаНоменклатуры.СтавкаНДС)+НСтр("ru = '%'");
						НоваяСтрока = ТаблицаНДС.Добавить();
						НоваяСтрока.Ставка = ТекСтрокаНоменклатуры.СтавкаНДС;
						НоваяСтрока.Сумма = ТекСтрокаНоменклатуры.СуммаНДС;
					КонецЕсли;
					ТабличныйДокумент.Вывести(ОбластьСтрокаЧека);
					
					Всего = Всего + ТекСтрокаНоменклатуры.Сумма;
					ВсегоНДС = ВсегоНДС + ТекСтрокаНоменклатуры.СуммаНДС;
					
					НомерСтроки = НомерСтроки + 1;
				КонецЦикла;	
				
				СтруктураИтогов = Новый Структура;
				СтруктураИтогов.Вставить("Всего", Всего);
				СтруктураИтогов.Вставить("ВсегоНДС", ВсегоНДС);
				
				ОбластьИтог.Параметры.Заполнить(СтруктураИтогов);
				ТабличныйДокумент.Вывести(ОбластьИтог);
			
				ТаблицаОплат = ОбщиеПараметрыЧека.ТаблицаОплат;
				Для каждого ТекСтрокаОплаты Из ТаблицаОплат Цикл
					Если ТекСтрокаОплаты.ТипОплаты = Перечисления.ТипыОплатыККТ.Наличные Тогда
						СведенияРасчетногоДокумента.СуммаНаличными = Формат(ТекСтрокаОплаты.Сумма, "ЧЦ=17; ЧДЦ=2");
					ИначеЕсли ТекСтрокаОплаты.ТипОплаты = Перечисления.ТипыОплатыККТ.Электронно Тогда
						СведенияРасчетногоДокумента.СуммаЭлектронно = Формат(ТекСтрокаОплаты.Сумма, "ЧЦ=17; ЧДЦ=2");
					ИначеЕсли ТекСтрокаОплаты.ТипОплаты = Перечисления.ТипыОплатыККТ.Предоплата Тогда
						СведенияРасчетногоДокумента.СуммаПредоплаты = Формат(ТекСтрокаОплаты.Сумма, "ЧЦ=17; ЧДЦ=2");
					ИначеЕсли ТекСтрокаОплаты.ТипОплаты = Перечисления.ТипыОплатыККТ.Постоплата Тогда
						СведенияРасчетногоДокумента.СуммаПостоплаты = Формат(ТекСтрокаОплаты.Сумма, "ЧЦ=17; ЧДЦ=2");
					КонецЕсли;	
				КонецЦикла;
				
				ТаблицаНДС.Свернуть("Ставка","Сумма");
				ПерваяСтрока = Истина;
				Для каждого ТекСтрокаСтавки Из ТаблицаНДС Цикл
					СтруктураИтоговНДС = Новый Структура;
					СтруктураИтоговНДС.Вставить("Втч", ?(ПерваяСтрока, НСтр("ru = 'в т.ч.'"), ""));
					СтруктураИтоговНДС.Вставить("СтавкаНДС", Строка(ТекСтрокаСтавки.Ставка)+НСтр("ru = '%'"));
					СтруктураИтоговНДС.Вставить("СуммаНДС", ТекСтрокаСтавки.Сумма);
					ПерваяСтрока = Ложь;
					
					ОбластьИтогНДС.Параметры.Заполнить(СтруктураИтоговНДС);
					ТабличныйДокумент.Вывести(ОбластьИтогНДС);
				КонецЦикла;	
				
				ОбластьОплата.Параметры.Заполнить(СведенияРасчетногоДокумента);
				ТабличныйДокумент.Вывести(ОбластьОплата);
				
				ОбластьПодвал.Параметры.Заполнить(ОбщиеПараметрыЧека);
				ОбластьПодвал.Параметры.Заполнить(СведенияРасчетногоДокумента);
				ТабличныйДокумент.Вывести(ОбластьПодвал);
				
				Если н <> КоличествоЭкземпляров Тогда 
					ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ДанныеДляРасчетныхДокументовБезККТ(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов"	, МассивОбъектов);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПриходныйКассовыйОрдер.Ссылка КАК Ссылка,
	|	ПриходныйКассовыйОрдер.НомерЧекаККМ КАК НомерЧекаККМ,
	|	ПриходныйКассовыйОрдер.ДатаЧекаККМ КАК ДатаЧекаККМ,
	|	ПриходныйКассовыйОрдер.Организация КАК Организация,
	|	""Приходный кассовый ордер"" КАК ВидДокументаОснования,
	|	ПриходныйКассовыйОрдер.Дата КАК ДатаДокументаОснования,
	|	ПриходныйКассовыйОрдер.Номер КАК НомерДокументаОснования,
	|	ПриходныйКассовыйОрдер.СистемаНалогообложенияЧекаККМ КАК СНО,
	|	ПриходныйКассовыйОрдер.КассаККМ КАК КассаККМ,
	|	ВЫРАЗИТЬ(ПриходныйКассовыйОрдер.КассаККМ КАК Справочник.ФискальныеРегистраторы).НаименованиеМестаРасчета КАК КассаККМНаименованиеМестаРасчета,
	|	ВЫРАЗИТЬ(ПриходныйКассовыйОрдер.КассаККМ КАК Справочник.ФискальныеРегистраторы).АдресМестаРасчета КАК КассаККМАдресМестаРасчета,
	|	ПриходныйКассовыйОрдер.ТипРасчета КАК ТипРасчета,
	|	ЛОЖЬ КАК ПакетнаяПечатьЧеков,
	|	0 КАК НомерЧекаВСписке,
	|	ЕСТЬNULL(ФискальныеОперации.НомерЧекаККМ, 0) КАК НомерЧекаФискальнойОперации,
	|	ФискальныеОперации.Дата КАК ДатаФискальнойОперации
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	|		ПО ПриходныйКассовыйОрдер.Ссылка = ФискальныеОперации.ДокументОснование
	|ГДЕ
	|	ПриходныйКассовыйОрдер.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РасходныйКассовыйОрдер.Ссылка,
	|	РасходныйКассовыйОрдер.НомерЧекаККМ,
	|	РасходныйКассовыйОрдер.ДатаЧекаККМ,
	|	РасходныйКассовыйОрдер.Организация,
	|	""Расходный кассовый ордер"",
	|	РасходныйКассовыйОрдер.Дата,
	|	РасходныйКассовыйОрдер.Номер,
	|	РасходныйКассовыйОрдер.СистемаНалогообложенияЧекаККМ,
	|	РасходныйКассовыйОрдер.КассаККМ,
	|	ВЫРАЗИТЬ(РасходныйКассовыйОрдер.КассаККМ КАК Справочник.ФискальныеРегистраторы).НаименованиеМестаРасчета,
	|	ВЫРАЗИТЬ(РасходныйКассовыйОрдер.КассаККМ КАК Справочник.ФискальныеРегистраторы).АдресМестаРасчета,
	|	РасходныйКассовыйОрдер.ТипРасчета,
	|	ЛОЖЬ,
	|	0,
	|	ЕСТЬNULL(ФискальныеОперации.НомерЧекаККМ, 0),
	|	ФискальныеОперации.Дата
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	|		ПО РасходныйКассовыйОрдер.Ссылка = ФискальныеОперации.ДокументОснование
	|ГДЕ
	|	РасходныйКассовыйОрдер.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЭквайринговаяОперация.Ссылка,
	|	ВЫБОР
	|		КОГДА ЭквайринговаяОперация.НомерЧекаККМОтмены <> 0
	|			ТОГДА ЭквайринговаяОперация.НомерЧекаККМОтмены
	|		ИНАЧЕ ЭквайринговаяОперация.НомерЧекаККМ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЭквайринговаяОперация.НомерЧекаККМОтмены <> 0
	|			ТОГДА ЭквайринговаяОперация.ДатаЧекаККМОтмены
	|		ИНАЧЕ ЭквайринговаяОперация.ДатаЧекаККМ
	|	КОНЕЦ,
	|	ЭквайринговаяОперация.Организация,
	|	""Эквайринговая операция"",
	|	ЭквайринговаяОперация.Дата,
	|	ЭквайринговаяОперация.Номер,
