Процедура СоздатьЭлементФормыПараметровЭлектронногоАктированияДокумента(Форма, ДекорацияГосударственныйКонтракт) Экспорт
	
	ЭлементыФормы = Форма.Элементы;
	
	ГруппаЛево = ЭлементыФормы.ГруппаШапка.ПодчиненныеЭлементы[0];
	ИмяДекорации = ЭлектронноеАктированиеЕИС.ИмяДекорацииФормыПараметровЭлектронногоАктированияДокумента();
	ТипДекорации = Тип("ДекорацияФормы");
	ДекорацияГосударственныйКонтракт = ЭлементыФормы.Вставить(
			ИмяДекорации,
			ТипДекорации,
			ГруппаЛево);
	ДекорацияГосударственныйКонтракт.Вид = ВидДекорацииФормы.Надпись;
	ДекорацияГосударственныйКонтракт.Гиперссылка = Истина;
	ДекорацияГосударственныйКонтракт.АвтоМаксимальнаяШирина = Ложь;
	ДекорацияГосударственныйКонтракт.Заголовок = "<нет данных о контракте>";
	
КонецПроцедуры

Процедура ПриИзмененииКлючевыхРеквизитовЭлектронногоАктирования(Форма) Экспорт
	
	Объект = Форма.Объект;
	ЭлектронноеАктированиеЕИС.УстановитьПредставлениеГосконтрактаПоДоговору(
		Объект.Организация,
		Объект.Договор,
		Форма);
		
	ИспользуетсяЭлектронноеАктирование = Форма.ИспользуетсяЭлектронноеАктирование;
	УстановитьВидимостьКолонокЭлектронногоАктирования(Форма, ИспользуетсяЭлектронноеАктирование);
	
	Если ТипЗнч(Объект) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ЗаполнитьСлужебныеДанныеЕИС(Форма, "УслугиОказанные", "УслугиОказанные");
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ЗаполнитьСлужебныеДанныеЕИС(Форма, "Номенклатура", "Номенклатура");
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		ЗаполнитьСлужебныеДанныеЕИС(Форма, "Материалы", "Материалы");
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументСсылка.ПередачаОбъектовОС")
		ИЛИ ТипЗнч(Объект) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
		ЗаполнитьСлужебныеДанныеЕИС(Форма, "ОсновныеСредства", "ОсновныеСредства");
	КонецЕсли;
	
КонецПроцедуры

Процедура КомандыЭДО_ФормаДокумента(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ПараметрыПриСоздании = ЭлектронноеАктированиеЕИС.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыПриСоздании.Форма = Форма;
	ПараметрыПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыПриСоздании.ДоговорКонтрагента = Объект.Договор;
	ЭлектронноеАктированиеЕИС.ПриСозданииНаСервере_ФормаДокумента(ПараметрыПриСоздании);

	ЭлектронноеАктированиеЕИС.УстановитьПредставлениеГосконтрактаПоДоговору(
		Объект.Организация, Объект.Договор, Форма);
		
	
КонецПроцедуры

Процедура ЗаполнитьМестаПоставкиДокумента(Документ, МестаПоставки) Экспорт
	
	КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Документ.Контрагент, Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты, , Ложь);
	Если КонтактнаяИнформация.Количество() > 0 Тогда
		ФактАдрес = КонтактнаяИнформация[0];
		МестоПоставки = ФактАдрес.Значение;
		Если Найти(МестоПоставки, "ВСвободнойФорме") = 0 Тогда
			МестаПоставки.Добавить(МестоПоставки);
		КонецЕсли;	
	Иначе
		КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Документ.Контрагент, Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты, , Ложь);
		Если КонтактнаяИнформация.Количество() > 0 Тогда
			ЮрАдрес = КонтактнаяИнформация[0];
			МестоПоставки = ЮрАдрес.Значение;
			Если Найти(МестоПоставки, "ВСвободнойФорме") = 0 Тогда
				МестаПоставки.Добавить(МестоПоставки);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиСоздатьКонтрагентаПоСведениямОЗаказчике(ДанныеКонтрагента) Экспорт
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ДанныеКонтрагента.СокращенноеНаименование) Тогда
		НаименованиеКонтрагента = ДанныеКонтрагента.СокращенноеНаименование;
	Иначе
		НаименованиеКонтрагента = ДанныеКонтрагента.ПолноеНаименование;
	КонецЕсли;
	
	ДополнительныеРеквизиты = Новый Структура("ИНН, КПП, Наименование, СоздатьКонтрагентаПриОтсутствии", ДанныеКонтрагента.ИНН, ДанныеКонтрагента.КПП, НаименованиеКонтрагента, Истина); 
	ЭлектронныеДокументыБГУ.НайтиСсылкуНаОбъект("Контрагенты", Контрагент, , ДополнительныеРеквизиты);

	Возврат Контрагент;
	
КонецФункции

Функция ГосударственныйКонтрактДокумента(Знач Документ) Экспорт
	
	Возврат ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(Документ.Договор);

КонецФункции

// Преобразование прикладного значения ставки в текстовое для приложения УПД/УКД.
Функция СтавкаНДСДляПриложенияЕИС(Знач СтавкаНДС) Экспорт
	
	СтавкиНДС = Новый Соответствие;
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС0, "0%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС5, "5%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС7, "7%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС10, "10%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС18, "18%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС20, "20%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.НДС22, "22%");
	СтавкиНДС.Вставить(Перечисления.СтавкиНДС.БезНДС, "без НДС");
	СтавкаНДСПриложения = СтавкиНДС[СтавкаНДС];
	
	Если СтавкаНДСПриложения = Неопределено Тогда
		ТекстОшибки= НСтр("ru='Неизвестная ставка НДС.'");
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	Возврат СтавкаНДСПриложения;
	
КонецФункции

// Преобразование текстового значения ставки из данных контракта в прикладное.
// см. ЭлектронноеАктированиеЕИС.СтавкаНДСОбъектаЗакупки()
Функция СтавкаНДСОбъектаЗакупки(Знач СтавкаНДСОбъектаЗакупки) Экспорт
	Если СтавкаНДСОбъектаЗакупки = Неопределено Тогда
		Возврат Перечисления.СтавкиНДС.БезНДС;
	КонецЕсли;	
	
	СтавкиНДС = Новый Соответствие;
	СтавкиНДС.Вставить("0", Перечисления.СтавкиНДС.НДС0);
	СтавкиНДС.Вставить("5", Перечисления.СтавкиНДС.НДС5);
	СтавкиНДС.Вставить("7", Перечисления.СтавкиНДС.НДС7);
	СтавкиНДС.Вставить("10", Перечисления.СтавкиНДС.НДС10);
	СтавкиНДС.Вставить("18", Перечисления.СтавкиНДС.НДС18);
	СтавкиНДС.Вставить("20", Перечисления.СтавкиНДС.НДС20);
	СтавкиНДС.Вставить("22", Перечисления.СтавкиНДС.НДС22);
	СтавкиНДС.Вставить("n", Перечисления.СтавкиНДС.БезНДС);
	СтавкиНДС.Вставить("N", Перечисления.СтавкиНДС.БезНДС);
	СтавкаНДС = СтавкиНДС[СтавкаНДСОбъектаЗакупки];
	
	Если СтавкаНДС = Неопределено Тогда
		Шаблон = НСтр("ru='Неизвестная ставка НДС объекта закупки ""%1"".'");
		ТекстОшибки = СтрШаблон(Шаблон, СтавкаНДСОбъектаЗакупки);
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	Возврат СтавкаНДС;
	
КонецФункции

Функция Версия() Экспорт
	Результат = Метаданные.Имя + " " + Метаданные.Версия;
	
	Возврат СтрЗаменить(Результат, "БухгалтерияГосударственногоУчреждения", "БГУ");
	
КонецФункции

// Разрешается использовать электронное актирование ЕИС для заказчиков.
// 
// Параметры:
//  ИспользованиеРазрешено - Булево - Истина, если использование разрешено.
Процедура РазрешаетсяИспользоватьЭлектронноеАктированиеДляЗаказчиков(ИспользованиеРазрешено) Экспорт
	
	ИспользованиеРазрешено = Истина;
	
КонецПроцедуры

// Разрешается использовать электронное актирование ЕИС для заказчиков.
// 
// Параметры:
//  ИспользованиеРазрешено - Булево - Истина, если использование разрешено.
Процедура РазрешаетсяИспользоватьЭлектронноеАктированиеДляПоставщиков(ИспользованиеРазрешено) Экспорт
	
	ИспользованиеРазрешено = Истина;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьПараметрыЭДПоИсточнику.
Процедура ЗаполнитьПараметрыЭДПоИсточнику(Источник, ПараметрыЭлектронногоДокумента) Экспорт

	ТипИсточника = ТипЗнч(Источник);
	ЭтоСсылка = ОбщегоНазначения.ЭтоСсылка(ТипИсточника);
	ТипыДокументов = ЭлектронныеДокументыЭДО.СтандартныеТипыДокументов();
	НаправленияДокументов = ЭлектронныеДокументыЭДО.ДоступныеНаправленияДокументов();
	
	Если ТипИсточника = Тип("ДокументСсылка.РезультатыРассмотренияДокументаПриемкиЕИС") Тогда
	
		Реквизиты = "Организация, Контрагент, ЭтоКорректировка";
			
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		СтрокаПараметров.Направление        = НаправленияДокументов.Входящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		Если ЗначенияРеквизитов.ЭтоКорректировка <> Неопределено
			И ЗначенияРеквизитов.ЭтоКорректировка Тогда
			СтрокаПараметров.Тип = ТипыДокументов.РезультатРассмотренияАктаПриемкиЕИСУКД;
		Иначе
			СтрокаПараметров.Тип = ТипыДокументов.РезультатРассмотренияАктаПриемкиЕИСУПД;
		КонецЕсли;
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.АктОбОказанииУслуг")
		ИЛИ ТипИсточника = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") 	
		ИЛИ ТипИсточника = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") 	
		ИЛИ ТипИсточника = Тип("ДокументСсылка.ПередачаОбъектовОС") 	
		ИЛИ ТипИсточника = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда	
		Если ЭлектронноеАктированиеБГУ.ДляДокументаФормироватьДляЕИСУПДПоставщикаСоСтатусом2ПриНулевомНалоге(Источник) Тогда
			Если ПараметрыЭлектронногоДокумента.Количество() > 0 Тогда
				СтрокаПараметров = ПараметрыЭлектронногоДокумента[0];
				СтрокаПараметров.ФормированиеУниверсальногоДокумента = Ложь;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// См. ПодключаемыеКомандыЭДОСобытия.ПриОпределенииСоставаКомандЭДО.
Процедура ПриОпределенииСоставаКомандЭДО(СоставКомандЭДО) Экспорт
	
	СоставКомандЭДО.Входящие.Добавить("Документ.РезультатыРассмотренияДокументаПриемкиЕИС");
	
КонецПроцедуры

Функция ДанныеПриложенияУПДЗаказчика(РезультатыРассмотренияАктаПриемкиЕИС)
	
	СтруктураУПДЗаказчика = ЭлектронноеАктированиеЕИС.НовыеДанныеПриложенияКТитулуЗаказчикаУПД();
	
	Если НЕ ТипЗнч(РезультатыРассмотренияАктаПриемкиЕИС) = Тип("ДокументСсылка.РезультатыРассмотренияДокументаПриемкиЕИС") Тогда
		ОписаниеОшибки = НСтр("ru = 'Требуется создать документ рассмотрения документа приемки.'");
		ЭлектронноеАктированиеЕИС.ДобавитьОшибкуЗаполненияПриложения(СтруктураУПДЗаказчика, ОписаниеОшибки);
		Возврат СтруктураУПДЗаказчика;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	РезультатыРассмотренияАктаПриемкиЕИС.СуммаДокумента КАК ИтогоФактическиПринято,
	|	РезультатыРассмотренияАктаПриемкиЕИС.ИнформацияОПричинахИОснованияхОтказа КАК ИнформацияОРасхожденияхПричинахОтказа,
	|	РезультатыРассмотренияАктаПриемкиЕИС.КодРешенияПриемочнойКомиссии КАК КодРешенияПриемочнойКомиссии,
	|	РезультатыРассмотренияАктаПриемкиЕИС.ТекстРешенияПриемочнойКомиссии КАК РешениеПриемочнойКомиссии,
	|	ВЫРАЗИТЬ(РезультатыРассмотренияАктаПриемкиЕИС.Комиссия КАК Справочник.ПриемочныеКомиссииЕИСБГУ).ОснованиеСоздания КАК ОснованиеСозданияПриемочнойКомиссии
	|ИЗ
	|	Документ.РезультатыРассмотренияДокументаПриемкиЕИС КАК РезультатыРассмотренияАктаПриемкиЕИС
	|ГДЕ
	|	РезультатыРассмотренияАктаПриемкиЕИС.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасхожденияДляОбъектовЗакупки.ВнутреннийИдентификаторЕИС КАК ИдентификаторПринятогоТРУ,
	|	РасхожденияДляОбъектовЗакупки.ВнешнийИдентификатор КАК ВнешнийТехническийИдентификаторПозицииТРУ,
	|	РасхожденияДляОбъектовЗакупки.ПризнакПринятияТРУ КАК ПризнакПринятияТРУ,
	|	РасхожденияДляОбъектовЗакупки.ПринятыйОбъемРаботыУслуги КАК ПринятыйОбъемРаботыУслуги,
	|	РасхожденияДляОбъектовЗакупки.Всего КАК СтоимостьСНалогом,
	|	РасхожденияДляОбъектовЗакупки.ПричинаОтказаОтПриемки КАК ПричинаОтказаОтПриемки
	|ИЗ
	|	Документ.РезультатыРассмотренияДокументаПриемкиЕИС.РасхожденияДляОбъектовЗакупки КАК РасхожденияДляОбъектовЗакупки
	|ГДЕ
	|	РасхожденияДляОбъектовЗакупки.Ссылка = &Ссылка
	|	И РасхожденияДляОбъектовЗакупки.Количество <> РасхожденияДляОбъектовЗакупки.КоличествоПринято
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТь
	|	РешениеЧленовПриемочнойКомиссии.НомерСтроки КАК НомерПодписанта,
	|	РешениеЧленовПриемочнойКомиссии.РольВПриемочнойКомиссии КАК РольВПриемочнойКомиссии,
	|	ПРЕДСТАВЛЕНИЕ(РешениеЧленовПриемочнойКомиссии.Подписант.ОснованиеПолномочий) КАК
	|		ОснованиеПолномочийЧленаПриемочнойКомиссии,
	|	РешениеЧленовПриемочнойКомиссии.КодРешения КАК КодРешенияЧленаПриемочнойКомиссии
	|ИЗ
	|	Документ.РезультатыРассмотренияДокументаПриемкиЕИС.РешениеЧленовПриемочнойКомиссии как РешениеЧленовПриемочнойКомиссии
	|ГДЕ
	|	РешениеЧленовПриемочнойКомиссии.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УполномоченныеЛицаЗаказчика.НомерСтроки КАК НомерПодписанта,
	|	ПРЕДСТАВЛЕНИЕ(УполномоченныеЛицаЗаказчика.Подписант.ТипПодписанта) КАК ВидУполномоченногоЛица
	|ИЗ
	|	Документ.РезультатыРассмотренияДокументаПриемкиЕИС.УполномоченныеЛицаЗаказчика КАК УполномоченныеЛицаЗаказчика
	|ГДЕ
	|	УполномоченныеЛицаЗаказчика.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрочиеНачисления.ТребованиеОбУплатеНеустойки КАК НаименованиеТребования,
	|	ПрочиеНачисления.НомерТребования КАК НомерТребования,
	|	ПрочиеНачисления.ДатаТребования КАК ДатаТребования,
	|	ПрочиеНачисления.ТипНеустойки КАК ТипНеустойки,
	|	ПрочиеНачисления.СуммаНеустойки КАК РазмерНеустойки,
	|	ПрочиеНачисления.КодПричины КАК КодПричины,
	|	ПрочиеНачисления.НаименованиеПричины КАК НаименованиеПричины
	|ИЗ
	|	Документ.РезультатыРассмотренияДокументаПриемкиЕИС.ПрочиеНачисления КАК ПрочиеНачисления
	|ГДЕ
	|	ПрочиеНачисления.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ПрисоединенныйФайл КАК ПрисоединенныйФайл,
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ВидВложения.Код КАК КодВида,
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ВидВложения.Наименование КАК НаименованиеВида
	|ИЗ
	|	РегистрСведений.ПриложенныеФайлыДляЭлектронногоАктированияЕИС КАК ПриложенныеФайлыДляЭлектронногоАктированияЕИС
	|ГДЕ
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.Документ = &Ссылка" );
	
	Запрос.УстановитьПараметр("Ссылка", РезультатыРассмотренияАктаПриемкиЕИС);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаШапки = МассивРезультатов[0].Выбрать();
	ВыборкаШапки.Следующий();
	ЗаполнитьЗначенияСвойств(СтруктураУПДЗаказчика, ВыборкаШапки);
	
	СтруктураУПДЗаказчика.Вставить("КодИтога", РезультатыРассмотренияАктаПриемкиЕИС.ИтогПриемки);
	
	// Сведения о принятии 
	// Если код итога приемки равен 1 (в УПД (титул покупателя) значение атрибута «Код,
	// обозначающий итог приемки товара (работ, услуг, прав)» (Файл/ИнфПок/СодФХЖ4/СвПрин/КодСодОпер/@КодИтога) равно 1),
	// то игнорируется при приеме
	ВыборкаРасхождений = МассивРезультатов[1].Выбрать();
	Если ВыборкаРасхождений.Количество() > 0 Тогда
		
		Пока ВыборкаРасхождений.Следующий() Цикл
			
			ДетализированныеСведения = Ложь;
			СведенияОТРУ = ЭлектронноеАктированиеЕИС.НовыеСведенияТРУУПДЗаказчика(ДетализированныеСведения);
		
			СведенияОНедетализированныхПозицияхТРУ = СведенияОТРУ.СведенияОНедетализированныхПозицияхТРУ;
			ЗаполнитьЗначенияСвойств(СведенияОНедетализированныхПозицияхТРУ, ВыборкаРасхождений);
			
			СведенияОНедетализированныхПозицияхТРУ.ОтраслеваяСпециализация = Неопределено;
			
			СтруктураУПДЗаказчика.СведенияОТРУ.Добавить(СведенияОТРУ);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Информация о решении приемочной комиссии
	// Наличие блока означает, что установлен признак "Для определения результатов приемки товаров, работ,
	// услуг создана приемочная комиссия"
	ВыборкаРешениеЧленовПриемочнойКомиссии = МассивРезультатов[2].Выбрать();
	Если ВыборкаРешениеЧленовПриемочнойКомиссии.Количество() > 0 Тогда
		
		ИнформацияОРешенииПриемочнойКомиссии = ЭлектронноеАктированиеЕИС.НовыеСведенияИнформацииОРешенииПриемочнойКомиссииЗаказчика();
		ЗаполнитьЗначенияСвойств(ИнформацияОРешенииПриемочнойКомиссии, ВыборкаШапки);
		
		СведенияОЧленеПриемочнойКомиссии = ИнформацияОРешенииПриемочнойКомиссии.СведенияОЧленеПриемочнойКомиссии;
		
		Пока ВыборкаРешениеЧленовПриемочнойКомиссии.Следующий() Цикл
			СведенияОЧленеПриемочнойКомиссииЗаказчика = ЭлектронноеАктированиеЕИС.НовыеСведенияОЧленеПриемочнойКомиссииЗаказчика();
			ЗаполнитьЗначенияСвойств(СведенияОЧленеПриемочнойКомиссииЗаказчика, ВыборкаРешениеЧленовПриемочнойКомиссии);
			
			ЗначениеРолиВПриемочнойКоммисии = ЗначениеРолиВПриемочнойКоммисии(
				ВыборкаРешениеЧленовПриемочнойКомиссии.РольВПриемочнойКомиссии);
			СведенияОЧленеПриемочнойКомиссииЗаказчика.РольВПриемочнойКомиссии = ЗначениеРолиВПриемочнойКоммисии;
			
			ИнформацияОРешении = СведенияОЧленеПриемочнойКомиссииЗаказчика.ИнформацияОРешенииЧленаПриемочнойКомиссии;
			КодРешения = ВыборкаРешениеЧленовПриемочнойКомиссии.КодРешенияЧленаПриемочнойКомиссии;	
				
			ИнформацияОРешении.КодРешенияЧленаПриемочнойКомиссии = КодРешения;
			ИнформацияОРешении.РешениеЧленаПриемочнойКомиссии = 
				ЭлектронноеАктированиеЕИС.РешениеЧленаПриемочнойКомиссииЗаказчикаПоКоду(КодРешения);
			
			СведенияОЧленеПриемочнойКомиссии.Добавить(СведенияОЧленеПриемочнойКомиссииЗаказчика);	
		КонецЦикла;
		
		СтруктураУПДЗаказчика.ИнформацияОРешенииПриемочнойКомиссии = ИнформацияОРешенииПриемочнойКомиссии;
			
	КонецЕсли;
	
	// Иные уполномоченные лица
	// Наличие блока означает, что установлен признак "Документ подписывают иные уполномоченные лица".
	// В блоке указывается номер подписанта, который соответствует иному уполномоченному лицу,
	// информация о котором указывается в основном документе УПД (титул покупателя)
	ВыборкаИныхУполномоченныхЛиц = МассивРезультатов[3].Выбрать();
	Если ВыборкаИныхУполномоченныхЛиц.Количество() > 0 Тогда
		Пока ВыборкаИныхУполномоченныхЛиц.Следующий() Цикл
		
			СведенияОИныхУполномоченныхЛицахЗаказчика = ЭлектронноеАктированиеЕИС.НовыеСведенияОИныхУполномоченныхЛицахЗаказчика();
			ЗаполнитьЗначенияСвойств(СведенияОИныхУполномоченныхЛицахЗаказчика, ВыборкаИныхУполномоченныхЛиц);
			СтруктураУПДЗаказчика.ИныеУполномоченныеЛица.Добавить(СведенияОИныхУполномоченныхЛицахЗаказчика);
					
		КонецЦикла;
				
	КонецЕсли;
	
	// Информация о прочих начислениях (пени, налоги и взносы)
	ВыборкаНеустоек = МассивРезультатов[4].Выбрать();
	Если ВыборкаНеустоек.Количество() > 0 Тогда
	
		СведенияОПрочихНачисленияхЗаказчика = ЭлектронноеАктированиеЕИС.НовыеСведенияОПрочихНачисленияхЗаказчика();
		СведенияОПрочихНачисленияхЗаказчика.ИнформацияОНачисленнойНеустойке =
			ЭлектронноеАктированиеЕИС.НовыеСведенияОНачисленныхНеустойкахЗаказчика();
		ТребованиеЗаказчикаОбУплатеНеустойки = СведенияОПрочихНачисленияхЗаказчика.ИнформацияОНачисленнойНеустойке.ТребованиеЗаказчикаОбУплатеНеустойки;
		
		Пока ВыборкаНеустоек.Следующий() Цикл
			
			СведенияОНачисленнойНеустойкеЗаказчика = ЭлектронноеАктированиеЕИС.НовыеСведенияОНачисленныхНеустойкахЗаказчика();
			
			ЗаполнитьЗначенияСвойств(СведенияОНачисленнойНеустойкеЗаказчика, ВыборкаНеустоек);
			ЗаполнитьЗначенияСвойств(СведенияОНачисленнойНеустойкеЗаказчика.ПричинаНачисленияНеустойки, ВыборкаНеустоек);
			
			ТребованиеЗаказчикаОбУплатеНеустойки.Добавить(СведенияОНачисленнойНеустойкеЗаказчика);
				
		КонецЦикла;
		
		СведенияОПрочихНачисленияхЗаказчика.ИнформацияОНалогахИВзносах = Неопределено;
		
		СтруктураУПДЗаказчика.ПрочиеНачисления = СведенияОПрочихНачисленияхЗаказчика;
		
	КонецЕсли;
	
	// Прикрепленные документы
	ВыборкаПрисоединенныхФайлов = МассивРезультатов[5].Выбрать();
	Если ВыборкаПрисоединенныхФайлов.Количество() > 0 Тогда
		
		ДопустимыеРасширения = ЭлектронноеАктированиеЕИС.ДопустимыеРасширенияПриложенныхФайлов();
		Пока ВыборкаПрисоединенныхФайлов.Следующий() Цикл
			Файл = ВыборкаПрисоединенныхФайлов.ПрисоединенныйФайл;
			ДанныеФайла = ЭлектронноеАктированиеЕИС.ПолучитьДанныеФайлаБСП(Файл);
			Расширение = ДанныеФайла.Расширение;
			Если ДопустимыеРасширения.Найти(Расширение) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СведенияОПрикрепленныхДокументах = ЭлектронноеАктированиеЕИС.НовыеСведенияОПрикрепленныхДокументахЗаказчика();
			СведенияОПрикрепленныхДокументах.ВнешнийУникальныйИдентификаторКонтента = Файл.УникальныйИдентификатор();
			СведенияОПрикрепленныхДокументах.ИмяФайла = ДанныеФайла.ИмяФайла;
			СведенияОПрикрепленныхДокументах.РасширениеФайла = ДанныеФайла.Расширение;
			СведенияОПрикрепленныхДокументах.ДатаВремяПрикрепленияДокумента = МестноеВремя(ДанныеФайла.ДатаМодификацииУниверсальная);
			СсылкаНаСправочникВидовДокументов = СведенияОПрикрепленныхДокументах.СсылкаНаСправочникВидовДокументов;
			СсылкаНаСправочникВидовДокументов.Код = ВыборкаПрисоединенныхФайлов.КодВида;
			СсылкаНаСправочникВидовДокументов.Наименование = ВыборкаПрисоединенныхФайлов.НаименованиеВида;
		
			СтруктураУПДЗаказчика.Вложения.Добавить(СведенияОПрикрепленныхДокументах);	
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СтруктураУПДЗаказчика;
	
КонецФункции

Функция ЗначениеРолиВПриемочнойКоммисии(РольВПриемочнойКомиссии)
	
	Если РольВПриемочнойКомиссии = Перечисления.РолиВПриемочнойКомиссииЕИС.ПредседательПриемочнойКомиссии Тогда
		Возврат "1";
	ИначеЕсли РольВПриемочнойКомиссии = Перечисления.РолиВПриемочнойКомиссииЕИС.ЧленПриемочнойКомиссии Тогда 
		Возврат "2";
	КонецЕсли;
	
КонецФункции

Функция ДанныеПриложенияУКДЗаказчика(РезультатыРассмотренияАктаПриемкиЕИС)
	
	СтруктураУКДЗаказчика = ЭлектронноеАктированиеЕИС.НовыеДанныеПриложенияКТитулуЗаказчикаУКД();
	
	Если НЕ ТипЗнч(РезультатыРассмотренияАктаПриемкиЕИС) = Тип("ДокументСсылка.РезультатыРассмотренияДокументаПриемкиЕИС") Тогда
		ОписаниеОшибки = НСтр("ru = 'Требуется создать документ рассмотрения документа приемки.'");
		ЭлектронноеАктированиеЕИС.ДобавитьОшибкуЗаполненияПриложения(СтруктураУКДЗаказчика, ОписаниеОшибки);
		Возврат СтруктураУКДЗаказчика;
	КонецЕсли;
	
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(РезультатыРассмотренияАктаПриемкиЕИС.Комиссия КАК Справочник.ПриемочныеКомиссииЕИСБГУ).ОснованиеСоздания КАК ОснованиеСозданияПриемочнойКоммисии
	|ИЗ
	|	Документ.РезультатыРассмотренияДокументаПриемкиЕИС КАК РезультатыРассмотренияАктаПриемкиЕИС
	|ГДЕ
	|	РезультатыРассмотренияАктаПриемкиЕИС.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТь
	|	РешениеЧленовПриемочнойКомиссии.НомерСтроки КАК НомерПодписанта,
	|	РешениеЧленовПриемочнойКомиссии.РольВПриемочнойКомиссии КАК РольВПриемочнойКомиссии,
	|	ПРЕДСТАВЛЕНИЕ(РешениеЧленовПриемочнойКомиссии.Подписант.ОснованиеПолномочий) КАК
	|		ОснованиеПолномочийЧленаПриемочнойКомиссии,
	|	РешениеЧленовПриемочнойКомиссии.КодРешения КАК КодРешенияЧленаПриемочнойКомиссии
	|ИЗ
	|	Документ.РезультатыРассмотренияДокументаПриемкиЕИС.РешениеЧленовПриемочнойКомиссии как РешениеЧленовПриемочнойКомиссии
	|ГДЕ
	|	РешениеЧленовПриемочнойКомиссии.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрочиеНачисления.ТребованиеОбУплатеНеустойки КАК НаименованиеТребования,
	|	ПрочиеНачисления.НомерТребования КАК НомерТребования,
	|	ПрочиеНачисления.ДатаТребования КАК ДатаТребования,
	|	ПрочиеНачисления.ТипНеустойки КАК ТипНеустойки,
	|	ПрочиеНачисления.СуммаНеустойки КАК РазмерНеустойки,
	|	ПрочиеНачисления.КодПричины КАК КодПричины,
	|	ПрочиеНачисления.НаименованиеПричины КАК НаименованиеПричины
	|ИЗ
	|	Документ.РезультатыРассмотренияДокументаПриемкиЕИС.ПрочиеНачисления КАК ПрочиеНачисления
	|ГДЕ
	|	ПрочиеНачисления.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ПрисоединенныйФайл КАК ПрисоединенныйФайл,
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ВидВложения.Код КАК КодВида,
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.ВидВложения.Наименование КАК НаименованиеВида
	|ИЗ
	|	РегистрСведений.ПриложенныеФайлыДляЭлектронногоАктированияЕИС КАК ПриложенныеФайлыДляЭлектронногоАктированияЕИС
	|ГДЕ
	|	ПриложенныеФайлыДляЭлектронногоАктированияЕИС.Документ = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", РезультатыРассмотренияАктаПриемкиЕИС);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	// Шапка документа
	ВыборкаШапки = МассивРезультатов[0].Выбрать();
	ВыборкаШапки.Следующий();
	ЗаполнитьЗначенияСвойств(СтруктураУКДЗаказчика, ВыборкаШапки);
	
	// Информация о решении приемочной комиссии
	// Наличие блока означает, что установлен признак "Для определения результатов приемки товаров, работ,
	// услуг создана приемочная комиссия"
	ВыборкаРешениеЧленовПриемочнойКомиссии = МассивРезультатов[1].Выбрать();
	Если ВыборкаРешениеЧленовПриемочнойКомиссии.Количество() > 0 Тогда
		
		ИнформацияОРешенииПриемочнойКомиссии = 
			ЭлектронноеАктированиеЕИС.НовыеСведенияИнформацииОРешенииПриемочнойКомиссииЗаказчика();
		ЗаполнитьЗначенияСвойств(ИнформацияОРешенииПриемочнойКомиссии, ВыборкаШапки);
		
		СведенияОЧленеПриемочнойКомиссии = ИнформацияОРешенииПриемочнойКомиссии.СведенияОЧленеПриемочнойКомиссии;
		
		Пока ВыборкаРешениеЧленовПриемочнойКомиссии.Следующий() Цикл
			СведенияОЧленеПриемочнойКомиссииЗаказчика = 
				ЭлектронноеАктированиеЕИС.НовыеСведенияОЧленеПриемочнойКомиссииЗаказчика();
			ЗаполнитьЗначенияСвойств(СведенияОЧленеПриемочнойКомиссииЗаказчика, ВыборкаРешениеЧленовПриемочнойКомиссии);
			
			ИнформацияОРешении = СведенияОЧленеПриемочнойКомиссииЗаказчика.ИнформацияОРешенииЧленаПриемочнойКомиссии;
			КодРешения = ВыборкаРешениеЧленовПриемочнойКомиссии.КодРешенияЧленаПриемочнойКомиссии;	
				
			ИнформацияОРешении.КодРешенияЧленаПриемочнойКомиссии = КодРешения;
			ИнформацияОРешении.РешениеЧленаПриемочнойКомиссии = 
				ЭлектронноеАктированиеЕИС.РешениеЧленаПриемочнойКомиссииЗаказчикаПоКоду(КодРешения);
			
			СведенияОЧленеПриемочнойКомиссии.Добавить(СведенияОЧленеПриемочнойКомиссииЗаказчика);	
		КонецЦикла;
		
		СтруктураУКДЗаказчика.ИнформацияОРешенииПриемочнойКомиссии = ИнформацияОРешенииПриемочнойКомиссии;
			
	КонецЕсли;
	
	// Прочие начисления
	// Блок может быть заполнен только в том случае, если функция УКД КСЧФДИС или ДИС.
	ВыборкаНеустоек = МассивРезультатов[2].Выбрать();
	Если ВыборкаНеустоек.Количество() > 0 Тогда
			
		СведенияОПрочихНачисленияхЗаказчика = ЭлектронноеАктированиеЕИС.НовыеСведенияОПрочихНачисленияхЗаказчика();
		СведенияОПрочихНачисленияхЗаказчика.ИнформацияОНачисленнойНеустойке =
			ЭлектронноеАктированиеЕИС.НовыеСведенияОНачисленныхНеустойкахЗаказчика();
		ТребованиеЗаказчикаОбУплатеНеустойки = СведенияОПрочихНачисленияхЗаказчика.ИнформацияОНачисленнойНеустойке.ТребованиеЗаказчикаОбУплатеНеустойки;
		
		Пока ВыборкаНеустоек.Следующий() Цикл
			
			СведенияОНачисленнойНеустойкеЗаказчика = ЭлектронноеАктированиеЕИС.НовыеСведенияОНачисленныхНеустойкахЗаказчика();
			
			ЗаполнитьЗначенияСвойств(СведенияОНачисленнойНеустойкеЗаказчика, ВыборкаНеустоек);
			ЗаполнитьЗначенияСвойств(СведенияОНачисленнойНеустойкеЗаказчика.ПричинаНачисленияНеустойки, ВыборкаНеустоек);
			
			ТребованиеЗаказчикаОбУплатеНеустойки.Добавить(СведенияОНачисленнойНеустойкеЗаказчика);
				
		КонецЦикла;
		
		СведенияОПрочихНачисленияхЗаказчика.ИнформацияОНалогахИВзносах = Неопределено;
		
		СтруктураУКДЗаказчика.ПрочиеНачисления = СведенияОПрочихНачисленияхЗаказчика;
		
	КонецЕсли;
	
	// Прикрепленные документы
	ВыборкаПрисоединенныхФайлов = МассивРезультатов[3].Выбрать();
	Если ВыборкаПрисоединенныхФайлов.Количество() > 0 Тогда
		
		ДопустимыеРасширения = ЭлектронноеАктированиеЕИС.ДопустимыеРасширенияПриложенныхФайлов();
		Пока ВыборкаПрисоединенныхФайлов.Следующий() Цикл
			Файл = ВыборкаПрисоединенныхФайлов.ПрисоединенныйФайл;
			ДанныеФайла = ЭлектронноеАктированиеЕИС.ПолучитьДанныеФайлаБСП(Файл);
			Расширение = ДанныеФайла.Расширение;
			Если ДопустимыеРасширения.Найти(Расширение) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СведенияОПрикрепленныхДокументах = ЭлектронноеАктированиеЕИС.НовыеСведенияОПрикрепленныхДокументахЗаказчика();
			СведенияОПрикрепленныхДокументах.ВнешнийУникальныйИдентификаторКонтента = Файл.УникальныйИдентификатор();
			СведенияОПрикрепленныхДокументах.ИмяФайла = ДанныеФайла.ИмяФайла;
			СведенияОПрикрепленныхДокументах.РасширениеФайла = ДанныеФайла.Расширение;
			СведенияОПрикрепленныхДокументах.ДатаВремяПрикрепленияДокумента = МестноеВремя(ДанныеФайла.ДатаМодификацииУниверсальная);
			СсылкаНаСправочникВидовДокументов = СведенияОПрикрепленныхДокументах.СсылкаНаСправочникВидовДокументов;
			СсылкаНаСправочникВидовДокументов.Код = ВыборкаПрисоединенныхФайлов.КодВида;
			СсылкаНаСправочникВидовДокументов.Наименование = ВыборкаПрисоединенныхФайлов.НаименованиеВида;
		
			СтруктураУКДЗаказчика.Вложения.Добавить(СведенияОПрикрепленныхДокументах);	
		КонецЦикла;
		
	КонецЕсли;
		
	Возврат СтруктураУКДЗаказчика;
		
КонецФункции

// Заполнить подписантов результата расмотрения.
// 
// Параметры:
//  РезультатРассмотрения Результат рассмотрения
//  Данные - ДеревоЗначений - Данные
Процедура ЗаполнитьПодписантовРезультатаРасмотрения(РезультатРассмотрения, Данные)

	ЭтоУКД = РезультатРассмотрения.ЭтоКорректировка;
	ТипДокумента = ?(ЭтоУКД, "УКД", "УПД");
	
	ТаблицаПодписанты = ЭлектронноеАктированиеЕИС.НоваяТаблицаПодписантов();
	
	Подписант = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РезультатРассмотрения, "ПринялТРУ");
	Строка = ТаблицаПодписанты.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Подписант);
	Строка.Статус = "5";
	ДанныеПолномочий = ЭлектронноеАктированиеЕИС.ДанныеОПолномочияхПодписантаЗаказчика(
		Подписант, ТипДокумента);
	Строка.ОбластьПолномочий = ДанныеПолномочий.КодОбластиПолномочий;
	Строка.ОснованиеПолномочий = ДанныеПолномочий.ОснованиеПолномочий;
	Строка.НомерСтроки = 1;
	
	ПодписантыЕИС = РезультатРассмотрения.УполномоченныеЛицаЗаказчика;
	
	Если НЕ ЭтоУКД Тогда
		// Номер строки указывается в атрибуте ИныеСвед.
		// в дальнейшем используется для заполнения приложений для ЕИС.
		НомерСтроки = 2;
		Для Каждого УполномоченноеЛицо Из ПодписантыЕИС Цикл
			Подписант = УполномоченноеЛицо.Подписант;
			Строка = ТаблицаПодписанты.Добавить();
			ЗаполнитьЗначенияСвойств(Строка, Подписант);
			Строка.Статус = "5";
			ДанныеПолномочий = ЭлектронноеАктированиеЕИС.ДанныеОПолномочияхПодписантаЗаказчика(
				Подписант, ТипДокумента);
			Строка.ОбластьПолномочий = ДанныеПолномочий.КодОбластиПолномочий;
			Строка.ОснованиеПолномочий = ДанныеПолномочий.ОснованиеПолномочий;
			Строка.НомерСтроки = НомерСтроки;
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные,
		"ДанныеЭлектронногоАктированияЕИС.Подписанты", ТаблицаПодписанты);
	
КонецПроцедуры

Процедура ПриЗаполненииДанныхУПД2019_ИнформацияПокупателя(РезультатРассмотрения, ДеревоДанных, Отказ) Экспорт
	
	ДатаПолученияТоваров = РезультатРассмотрения.Дата;
	СодержаниеОперации   = "-";
	КодИтога = "1";
	
	ДанныеПриложения = ДанныеПриложенияУПДЗаказчика(РезультатРассмотрения);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения", ДанныеПриложения);
		
	ДанныеТитулаПокупателя = ДанныеТитулаПокупателяЭД(РезультатРассмотрения);
	
	Если ДанныеТитулаПокупателя = Неопределено Тогда
		Отказ = Истина;
		
		ТекстСообщения  = НСтр("ru='Для заполнения титула покупателя УПД требуется на основании документа ""Документ о приемке из ЕИС"" 
		|ввести, заполнить, записать и провести документ ""Результаты рассмотрения документа о приемке из ЕИС"".'");
		Сообщение       = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	ОрганизацияСоставитель = ДанныеТитулаПокупателя.Организация;
	СведенияОПокупателе = Новый Структура;
	Если ЗначениеЗаполнено(ОрганизацияСоставитель) Тогда
		ЭлектронныеДокументыБГУ.ПолучитьДанныеЮрФизЛица(ОрганизацияСоставитель, СведенияОПокупателе);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СведенияОПокупателе.ПолноеНаименование);
	КонецЕсли;
	
	ДатаПолученияТоваров = ДанныеТитулаПокупателя.ДатаПолученияТРУ;
	СодержаниеОперации = СокрЛП(ДанныеТитулаПокупателя.СодержаниеОперации);
	КодИтога = СокрЛП(ДанныеТитулаПокупателя.ИтогПриемки);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОПринятииТоваров.ДатаПолученияТоваров", ДатаПолученияТоваров);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОПринятииТоваров.СодержаниеОперации", СодержаниеОперации);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОПринятииТоваров.КодИтога", КодИтога);
	
	Если ДанныеТитулаПокупателя.ДокументОРасхожденияхВид > 1 Тогда
		Путь = "СведенияОПринятииТоваров.ДокументОРасхождениях.";
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "Наименование", ДанныеТитулаПокупателя.ДокументОРасхожденияхНаименование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "Вид", Строка(ДанныеТитулаПокупателя.ДокументОРасхожденияхВид));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "Номер", ДанныеТитулаПокупателя.ДокументОРасхожденияхНомер);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "Дата", ДанныеТитулаПокупателя.ДокументОРасхожденияхДата);
	КонецЕсли;
	
	ВидЛица = "РаботникОрганизацииПокупателя";
	ПринялТРУ = ДанныеТитулаПокупателя.ПринялТРУ;
	Если ЗначениеЗаполнено(ПринялТРУ) Тогда
		ДанныеСотрудника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПринялТРУ, "Фамилия,Имя,Отчество,Должность,ОснованиеПолномочий");
		ДанныеПодписанта = ЭлектронноеАктированиеЕИС.ДанныеОПолномочияхПодписантаЗаказчика(ПринялТРУ, "УПД");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПринявшемТовары." + ВидЛица + ".Должность", Строка(ДанныеСотрудника.Должность));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПринявшемТовары." + ВидЛица + ".ИныеСведения", ДанныеТитулаПокупателя.ПринялТРУИныеСведения);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПринявшемТовары." + ВидЛица + ".ОснованиеПолномочий", ДанныеПодписанта.ОснованиеПолномочий);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПринявшемТовары." + ВидЛица + ".Фамилия", ДанныеСотрудника.Фамилия);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПринявшемТовары." + ВидЛица + ".Имя", ДанныеСотрудника.Имя);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПринявшемТовары." + ВидЛица + ".Отчество", ДанныеСотрудника.Отчество);
	Иначе
		Отказ = Истина;
		
		ТекстСообщения  = НСтр("ru='Для заполнения титула покупателя УПД требуется в документе ""Результаты рассмотрения документа о приемке из ЕИС"" 
		|указать сотрудника, который осуществлял приемку товаров, работ, услуг.'");
		Сообщение       = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПодписантовРезультатаРасмотрения(РезультатРассмотрения, ДеревоДанных);
	
КонецПроцедуры

Функция ДанныеТитулаПокупателяЭД(РезультатРассмотрения)
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.Ссылка КАК Ссылка,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.Организация КАК Организация,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.Контрагент КАК Контрагент,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.Договор КАК Договор,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.ИтогПриемки КАК ИтогПриемки,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.ИдентификационныйКодЗакупки КАК ИдентификационныйКодЗакупки,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.ПринялТРУ КАК ПринялТРУ,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.ПринялТРУОснованиеДоверия КАК ПринялТРУОснованиеДоверия,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.ПринялТРУИныеСведения КАК ПринялТРУИныеСведения,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.СодержаниеОперации КАК СодержаниеОперации,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.ДатаПолученияТРУ КАК ДатаПолученияТРУ,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.ДокументОРасхожденияхНаименование КАК ДокументОРасхожденияхНаименование,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.ДокументОРасхожденияхНомер КАК ДокументОРасхожденияхНомер,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.ДокументОРасхожденияхДата КАК ДокументОРасхожденияхДата,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.ДокументОРасхожденияхВид КАК ДокументОРасхожденияхВид,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.Дата КАК Дата,
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.ДатаСогласования КАК ДатаСогласования
	               |ИЗ
	               |	Документ.РезультатыРассмотренияДокументаПриемкиЕИС КАК РезультатыРассмотренияДокументаПриемкиЕИС
	               |ГДЕ
	               |	РезультатыРассмотренияДокументаПриемкиЕИС.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", РезультатРассмотрения);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

// См. ОбменСКонтрагентами.ЗаполнитьДанныеУКД2020_ИнформацияПокупателя
Процедура ПриЗаполненииДанныхУКД2020_ИнформацияПокупателя(РезультатРассмотрения, ДеревоДанных, Отказ) Экспорт
	
	ДанныеПриложения = ДанныеПриложенияУКДЗаказчика(РезультатРассмотрения);
		
	ДанныеТитулаПокупателя = ДанныеТитулаПокупателяЭД(РезультатРассмотрения);
	ОрганизацияСоставитель = ДанныеТитулаПокупателя.Организация;
	СведенияОПокупателе = Новый Структура;
	Если ЗначениеЗаполнено(ОрганизацияСоставитель) Тогда
		ЭлектронныеДокументыБГУ.ПолучитьДанныеЮрФизЛица(ОрганизацияСоставитель, СведенияОПокупателе);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СведенияОПокупателе.ПолноеНаименование);
	КонецЕсли;
	
	ДанныеРезультатРассмотрения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РезультатРассмотрения,
		"КодРешенияПриемочнойКомиссии, ТекстРешенияПриемочнойКомиссии, Комиссия, ДатаСогласования");
	
	Комиссия = ДанныеРезультатРассмотрения.Комиссия;
	ДанныеКомиссия = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Комиссия,
		"ОснованиеСоздания");
	
	ДанныеПриложения.ИнформацияОРешенииПриемочнойКомиссии.КодРешенияПриемочнойКомиссии = СокрЛП(ДанныеРезультатРассмотрения.КодРешенияПриемочнойКомиссии);
	ДанныеПриложения.ИнформацияОРешенииПриемочнойКомиссии.РешениеПриемочнойКомиссии = СокрЛП(ДанныеРезультатРассмотрения.ТекстРешенияПриемочнойКомиссии);
	ДанныеПриложения.ИнформацияОРешенииПриемочнойКомиссии.ОснованиеСозданияПриемочнойКомисиии = СокрЛП(ДанныеКомиссия.ОснованиеСоздания);
	
	ДатаСогласования = ДанныеТитулаПокупателя.ДатаСогласования;
	СодержаниеОперации = СокрЛП(ДанныеТитулаПокупателя.СодержаниеОперации);
	Если НЕ ЗначениеЗаполнено(СодержаниеОперации) Тогда
		СодержаниеОперации = НСтр("ru = 'С изменением стоимости согласны'");
	КонецЕсли;	
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаСогласования", ДанныеРезультатРассмотрения.ДатаСогласования);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации",
		СодержаниеОперации);		
		
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения", ДанныеПриложения);
		
	ЗаполнитьПодписантовРезультатаРасмотрения(РезультатРассмотрения, ДеревоДанных);
		
КонецПроцедуры

Процедура ЗаполнитьДанныеДляУПДИнформацииПокупателяЕИС(Основания, Данные, Отказ) Экспорт
	РезультатРассмотрения = Документы.РезультатыРассмотренияДокументаПриемкиЕИС.ПустаяСсылка();
	
	Для каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.РезультатыРассмотренияДокументаПриемкиЕИС") Тогда
			РезультатРассмотрения = Основание;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(РезультатРассмотрения) Тогда
		ПриЗаполненииДанныхУПД2019_ИнформацияПокупателя(РезультатРассмотрения, Данные, Отказ);
	КонецЕсли;
	
КонецПроцедуры	

Процедура ЗаполнитьДанныеДляУКДИнформацииПокупателяЕИС(Основания, Данные, Отказ) Экспорт
	РезультатРассмотрения = Документы.РезультатыРассмотренияДокументаПриемкиЕИС.ПустаяСсылка();
	
	Для каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.РезультатыРассмотренияДокументаПриемкиЕИС") Тогда
			РезультатРассмотрения = Основание;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(РезультатРассмотрения) Тогда
		ПриЗаполненииДанныхУКД2020_ИнформацияПокупателя(РезультатРассмотрения, Данные, Отказ);
	КонецЕсли;
	
КонецПроцедуры	

Функция НайтиРезультатыРассмотренияПоДокументу(ДокументОснование) Экспорт
	Результат = Документы.РезультатыРассмотренияДокументаПриемкиЕИС.ПустаяСсылка();
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.АктПриемкиВходящийЕИС") Тогда
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	РезультатыРассмотренияДокументаПриемкиЕИС.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.РезультатыРассмотренияДокументаПриемкиЕИС КАК РезультатыРассмотренияДокументаПриемкиЕИС
			|ГДЕ
			|	РезультатыРассмотренияДокументаПриемкиЕИС.ДокументОснование = &ДокументОснование
			|	И РезультатыРассмотренияДокументаПриемкиЕИС.ПометкаУдаления = ЛОЖЬ";
			
			Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);

			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				Результат = Выборка.Ссылка;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

// Распаковывать проекты титулов поставщика при получении заказчиком.
// 
// Параметры:
//  РаспаковыватьПроекты - Булево - распаковывать проекты титулов.
Процедура РаспаковыватьПроектыТитуловПоставщикаПриПолученииЗаказчиком(РаспаковыватьПроекты) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	РаспаковыватьПроекты = Константы["ИспользованиеРассмотрениеИСогласованиеДокументовПриемкиЕИСУЗаказчика"].Получить();

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ДокументПриемкиДляРезультатовРассмотрен(ДокументСсылка) Экспорт
	Результат = Ложь;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостоянияДокументовБГУДляЕИС.Состояние КАК Состояние
	               |ИЗ
	               |	РегистрСведений.СостоянияДокументовБГУДляЕИС КАК СостоянияДокументовБГУДляЕИС
	               |ГДЕ
	               |	СостоянияДокументовБГУДляЕИС.СсылкаНаОбъект = &СсылкаНаОбъект";
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Состояние = Выборка.Состояние;
		Если Состояние = Перечисления.СостоянияДокументовБГУДляЕИС.Рассмотрен Тогда
			Результат = Истина;	
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьТекстПроРезультатыРассмотрения(Форма)  Экспорт
	РезультатыСсылка = НайтиРезультатыРассмотренияПоДокументу(Форма["Объект"].Ссылка);
	Форма["ДокументРезультатовРассмотрения"] = РезультатыСсылка;
	
	Если НЕ ЗначениеЗаполнено(Форма["ДокументРезультатовРассмотрения"]) Тогда
		Форма.НадписьРезультатыРассмотрения = "Ввести результаты рассмотрения";
	Иначе
		Форма.НадписьРезультатыРассмотрения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='№ %1 от %2 г.'"),	Форма.ДокументРезультатовРассмотрения.Номер, Формат(Форма.ДокументРезультатовРассмотрения.Дата, "ДЛФ=D"));
	КонецЕсли;	
	
КонецПроцедуры	

#КонецОбласти

