Функция ДляДокументаФормироватьДляЕИСУПДПоставщикаСоСтатусом2ПриНулевомНалоге(ДокументРеализации) Экспорт
    Результат = Ложь;
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРеализации, "Контрагент, Договор, Организация");
	Контракт = ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(РеквизитыДокумента.Договор);
	ЕстьЭлектронноеАктирование = ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС()
		И ЗначениеЗаполнено(Контракт)
		И ЭлектронноеАктированиеЕИС.ОбменПоОрганизацииВключен(РеквизитыДокумента.Организация);
	ФормироватьДляЕИСУПДПоставщикаСоСтатусом2ПриНулевомНалоге = 
		ФормироватьДляЕИСУПДПоставщикаСоСтатусом2ПриНулевомНалоге(РеквизитыДокумента.Организация);
	Если ЕстьЭлектронноеАктирование И ФормироватьДляЕИСУПДПоставщикаСоСтатусом2ПриНулевомНалоге Тогда
		Если ЭлектронноеАктированиеБГУ.НулевойНалогДокументаРеализацииУПД(ДокументРеализации) Тогда
		    Результат = Истина;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
КонецФункции	

Процедура ДополнитьОграничениеТипаНоменклатурыКонтракта(ТипыНоменклатуры, ТипОбъектаЗакупки) Экспорт

	Тип = Тип("СправочникСсылка.ОсновныеСредства");
	ТипыНоменклатуры.Добавить(Тип);
	
	Если ТипОбъектаЗакупки = Перечисления.ТипыОбъектовЗакупкиЕИС.Товар Тогда
		Тип = Тип("СправочникСсылка.ДенежныеДокументы");
		ТипыНоменклатуры.Добавить(Тип);
	КонецЕсли;
	
КонецПроцедуры

#Область УПД_5_03

Процедура ЗаполнитьДанныеПриложенияУПД_5_03(ИдентификаторУчастника, ОбщиеПараметры)
	
	ДанныеЭлектронногоАктированияЕИС	= ОбщиеПараметры.ДопДанныеДокумента.ДанныеЕИС.ДанныеЭлектронногоАктирования;
	ДанныеПриложенияЕИС					= ОбщиеПараметры.ДопДанныеДокумента.ДанныеЕИС.ДанныеПриложенияЕИС;
	
	СтоимостьТоваровСНалогом = 0;
	ВсегоКОплатеСуммаНалога = 0;
	
	ЭтоВалютныйКонтракт = Ложь;
	НоминалКурсаВалюты = 1;
	
	Если ЭтоВалютныйКонтракт Тогда
		// Заполняется, если валюта УПД не совпадает с валютой контракта.
		ДанныеПриложенияЕИС.СведенияОТоварах.СтоимостьТоваровСНалогом = СтоимостьТоваровСНалогом;
		ДанныеПриложенияЕИС.СведенияОТоварах.ВсегоКОплатеСуммаНалога = ВсегоКОплатеСуммаНалога;
		//В схемах 11.1 аннотации и описания атрибутов и тэгов будут скорректированы
		//В случае, если валюта документа - Российский Рубль, игнорирование атрибута НоминалКурсВал при загрузке правомерно.
		ДанныеПриложенияЕИС.СведенияОТоварах.НоминалКурсаВалюты = НоминалКурсаВалюты;
	КонецЕсли;

	Если ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта.Количество() = 0 Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнены данные государственного контракта для электронного актирования.'");
		ВызватьИсключение(ОписаниеОшибки);
	Иначе
		ДанныеПриложенияЕИС.ГосударственныйКонтракт =
			ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0].Ссылка;
	КонецЕсли;
	
	ЭлектронноеАктированиеЕИС.ДобавитьДвоичныеВложенияПриложенияДляЕИС(
		ДанныеПриложенияЕИС, ДанныеЭлектронногоАктированияЕИС);
	
	Для Каждого МестоПоставки Из ДанныеЭлектронногоАктированияЕИС.МестаПоставкиДокументовДляЕИС Цикл
		Место = ЭлектронноеАктированиеЕИС.НовыеСведенияОМестеПоставкиТовара();
		МестоJSON = МестоПоставки.ДанныеМеста;
		ЗаполнитьЗначенияСвойств(Место, МестоПоставки);
		КодыАдреса = АдресныйКлассификатор.КодыАдреса(МестоJSON);
		Если НЕ ЗначениеЗаполнено(КодыАдреса.КодКЛАДР) Тогда
			КодРегиона = АдресныйКлассификатор.КодРегионаПоНаименованию(МестоПоставки.НаселенныйПункт);
			КодРегиона = Строка(КодРегиона);
			КодыАдреса.КодКЛАДР = ЭлектронноеАктированиеЕИС.КодКЛАДРПроизвольногоАдреса(КодРегиона);
		КонецЕсли;
		Место.Классификатор = ЭлектронноеАктированиеЕИС.МестоПоставкиПоКЛАДР();
		Место.Код = ЭлектронноеАктированиеЕИС.ПреобразоватьКодКладрДляЕИС(
			КодыАдреса.КодКЛАДР);
			
		УИД = Строка(Новый УникальныйИдентификатор);
		Место.Идентификатор = СтрЗаменить(УИД, "-", "");
		Место.ИдентификаторУчастника = ИдентификаторУчастника;
		
		СведенияАдресаПоГАР = ПолучитьСведенияАдресаПоГАР(МестоJSON);
		
		Попытка
			Место.КодГАР	= СведенияАдресаПоГАР.КодГар;
			Место.КодСтраны	= СведенияАдресаПоГАР.КодСтраны;
		Исключение
		КонецПопытки;
		
		ДанныеПриложенияЕИС.МестаПоставки.Добавить(Место);
	КонецЦикла;
	
	Если ДанныеПриложенияЕИС.МестаПоставки.Количество() = 0 Тогда
		ДобавитьМестоПоставкиПоАдресуПолучателяУПД_5_03(ОбщиеПараметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьМестоПоставкиПоАдресуПолучателяУПД_5_03(ОбщиеПараметры)
	
	СтороныСделки = ОбщиеПараметры.ДопДанныеДокумента.СтороныСделки;
	
	Если СтороныСделки.Грузополучатель.СовпадаетСПокупателем Тогда
		ПутьЭлементаУчастника = "СведенияОСчетеФактуре.СведенияОПокупателях.НомерСтроки.Покупатель";
		
		ИдентификаторУчастника = ЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаПокупателя();
	Иначе
		ПутьЭлементаУчастника = "СведенияОСчетеФактуре.СведенияОГрузополучателях.НомерСтроки.Грузополучатель";
		
		ИдентификаторУчастника = ЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаГрузополучателя();
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаУчастника + ".ИнформацияДляУчастника", ИдентификаторУчастника);
	
	// Адрес указан как "АвтоматическиЗаполняемый".
	АвтоматическиЗаполняемыйАдрес = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаУчастника + ".Адрес.ТипАдреса.АвтоматическиЗаполняемый");
	
	ОписаниеАдреса = ВыделитьКомпонентыАдреса(АвтоматическиЗаполняемыйАдрес);
	
	ДанныеПриложенияЕИС = ОбщиеПараметры.ДопДанныеДокумента.ДанныеЕИС.ДанныеПриложенияЕИС;
	
	Если Не ЗначениеЗаполнено(ОписаниеАдреса.АдресТекст) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru='У контрагента ""%1"" не указан адрес'"), Строка(СтороныСделки.Грузополучатель.Ссылка));
		ЭлектронноеАктированиеЕИС.ДобавитьОшибкуЗаполненияПриложения(ДанныеПриложенияЕИС, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ТипАдреса = ОписаниеАдреса.ТипАдреса;
	КомпонентыАдреса = ОписаниеАдреса.Компоненты;
	КодСтраныРоссия = (ОписаниеАдреса.АдресПоПриказуМинфина.КодСтраны = "643");
	
	Если ТипАдреса = "АдресИнформация"
		И КодСтраныРоссия
		И Не ЗначениеЗаполнено(КомпонентыАдреса.КодРегиона) Тогда
		Шаблон = НСтр("ru='Не удалось определить код региона адреса: %1'");
		ТекстОшибки = СтрШаблон(Шаблон, КомпонентыАдреса.АдресТекст);
		ЭлектронноеАктированиеЕИС.ДобавитьОшибкуЗаполненияПриложения(ДанныеПриложенияЕИС, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	МестоПоставки = ЭлектронноеАктированиеЕИС.НовыеСведенияОМестеПоставкиТовара();
	
	МестоПоставки.Идентификатор = ОбщиеПараметры.ДопДанныеДокумента.ДанныеЕИС.ИдентификаторМестаПоставкиЕИС;
	МестоПоставки.ИдентификаторУчастника = ИдентификаторУчастника;
	
	Если ТипАдреса = "АдресРФ" Тогда
		Если ЗначениеЗаполнено(КомпонентыАдреса.Город) Тогда
			РайонИлиГород = КомпонентыАдреса.Город;
		ИначеЕсли ЗначениеЗаполнено(КомпонентыАдреса.Район) Тогда
			РайонИлиГород = КомпонентыАдреса.Район;
		Иначе
			РайонИлиГород = "-";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КомпонентыАдреса.НаселенныйПункт) Тогда
			НаселенныйПункт = КомпонентыАдреса.НаселенныйПункт;
		Иначе
			НаселенныйПункт = "-";
		КонецЕсли;
		
		МестоПоставки.Место = ОписаниеАдреса.АдресТекст;
		МестоПоставки.Наименование = ОписаниеАдреса.АдресТекст;
		МестоПоставки.Адрес = ОписаниеАдреса.АдресТекст;
		МестоПоставки.Классификатор = ЭлектронноеАктированиеЕИС.МестоПоставкиПоКЛАДР();
		МестоПоставки.РайонИлиГород = РайонИлиГород;
		МестоПоставки.НаселенныйПункт = НаселенныйПункт;
		МестоПоставки.Код = ЭлектронноеАктированиеЕИС.КодКЛАДРПроизвольногоАдреса(КомпонентыАдреса.КодРегиона);
	
	ИначеЕсли ТипАдреса = "АдресГАР" Тогда
		ВремМассив = Новый Массив();
		
		Если КомпонентыАдреса.Свойство("РайонОкругТерриторияТипПолный") Тогда
			Если ЗначениеЗаполнено(КомпонентыАдреса.РайонОкругТерриторияТипПолный) Тогда
				ВремМассив.Добавить(КомпонентыАдреса.РайонОкругТерриторияТипПолный);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КомпонентыАдреса.РайонОкругТерриторияНаименование) Тогда
				ВремМассив.Добавить(КомпонентыАдреса.РайонОкругТерриторияНаименование);
			КонецЕсли;
		КонецЕсли;
			
		Если КомпонентыАдреса.Свойство("ГородСелоПоселениеТипПолный") Тогда
			Если ЗначениеЗаполнено(КомпонентыАдреса.ГородСелоПоселениеТипПолный) Тогда
				ВремМассив.Добавить(КомпонентыАдреса.ГородСелоПоселениеТипПолный);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КомпонентыАдреса.ГородСелоПоселениеНаименование) Тогда
				ВремМассив.Добавить(КомпонентыАдреса.ГородСелоПоселениеНаименование);
			КонецЕсли;
		КонецЕсли;
		
		Если ВремМассив.Количество() > 0 Тогда
			РайонИлиГород = СтрСоединить(ВремМассив, " ");
		Иначе
			РайонИлиГород = "-";
		КонецЕсли;
		
		ВремМассив = Новый Массив();
		
		Если КомпонентыАдреса.Свойство("НаселенныйПунктТипКраткий") Тогда
			Если ЗначениеЗаполнено(КомпонентыАдреса.НаселенныйПунктТипКраткий) Тогда
				ВремМассив.Добавить(КомпонентыАдреса.НаселенныйПунктТипКраткий);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КомпонентыАдреса.НаселенныйПунктНаименование) Тогда
				ВремМассив.Добавить(КомпонентыАдреса.НаселенныйПунктНаименование);
			КонецЕсли;
		КонецЕсли;
		
		Если ВремМассив.Количество() > 0 Тогда
			НаселенныйПункт = СтрСоединить(ВремМассив, " ");
		Иначе
			НаселенныйПункт = "-";
		КонецЕсли;
		
		МестоПоставки.Место = ОписаниеАдреса.АдресТекст;
		МестоПоставки.Наименование = ОписаниеАдреса.АдресТекст;
		МестоПоставки.Адрес = ОписаниеАдреса.АдресТекст;
		МестоПоставки.Классификатор = ЭлектронноеАктированиеЕИС.МестоПоставкиПоОКТМО();
		МестоПоставки.РайонИлиГород = РайонИлиГород;
		МестоПоставки.НаселенныйПункт = НаселенныйПункт;
		МестоПоставки.Код = ЭлектронноеАктированиеЕИС.КодКЛАДРПроизвольногоАдреса(КомпонентыАдреса.КодРегиона);
		
	ИначеЕсли ТипАдреса = "АдресИнформация" Тогда
		Если КодСтраныРоссия И Не ЗначениеЗаполнено(КомпонентыАдреса.КодРегиона) Тогда
			Шаблон = НСтр("ru='Не удалось определить код региона адреса: %1'");
			ТекстОшибки = СтрШаблон(Шаблон, КомпонентыАдреса.АдресТекст);
			ЭлектронноеАктированиеЕИС.ДобавитьОшибкуЗаполненияПриложения(ДанныеПриложенияЕИС, ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		МестоПоставки.Место = КомпонентыАдреса.АдресТекст;
		МестоПоставки.Наименование = КомпонентыАдреса.АдресТекст;
		МестоПоставки.Адрес = КомпонентыАдреса.АдресТекст;
		МестоПоставки.Классификатор = ?(КодСтраныРоссия,
			ЭлектронноеАктированиеЕИС.МестоПоставкиПоКЛАДР(),
			ЭлектронноеАктированиеЕИС.МестоПоставкиПоОКСМ());
		МестоПоставки.РайонИлиГород = "-";
		МестоПоставки.НаселенныйПункт = "-";
		Если КодСтраныРоссия Тогда
			МестоПоставки.Код = ЭлектронноеАктированиеЕИС.КодКЛАДРПроизвольногоАдреса(КомпонентыАдреса.КодРегиона);
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		МестоПоставки.КодГАР	= ОписаниеАдреса.СведенияАдресаПоГАР.КодГар;
		МестоПоставки.КодСтраны	= ОписаниеАдреса.СведенияАдресаПоГАР.КодСтраны;
	Исключение
	КонецПопытки;
	
	ДанныеПриложенияЕИС.МестаПоставки.Добавить(МестоПоставки);
	
КонецПроцедуры

Функция ВыделитьКомпонентыАдреса(АвтоматическиЗаполняемыйАдрес, НаДату = Неопределено)
	
	// Основано на процедуре ИнтеграцияЭДО.ЗаполнитьАдресаУчастниковСделкиУПД_5_02()
	
	ОписаниеАдреса = Новый Структура();
	ОписаниеАдреса.Вставить("ТипАдреса", "");
	ОписаниеАдреса.Вставить("Компоненты", Новый Структура());
	ОписаниеАдреса.Вставить("АдресПоПриказуМинфина", Новый Структура());
	ОписаниеАдреса.Вставить("АдресТекст", "");
	ОписаниеАдреса.Вставить("СведенияАдресаПоГАР", Новый Структура());
	
	ОбъектКонтактнойИнформации	= АвтоматическиЗаполняемыйАдрес.ОбъектКонтактнойИнформации;
	ВидКонтактнойИнформации		= АвтоматическиЗаполняемыйАдрес.ВидКонтактнойИнформации;
	
	Если Не ЗначениеЗаполнено(ОбъектКонтактнойИнформации) Тогда
		Возврат ОписаниеАдреса;
	КонецЕсли;
	
	Если НаДату = Неопределено Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ТипЗнч(ВидКонтактнойИнформации) <> Тип("Массив") Тогда
		ВидыКонтактнойИнформации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВидКонтактнойИнформации);
	Иначе
		ВидыКонтактнойИнформации = ВидКонтактнойИнформации;
	КонецЕсли;
	
	Для Каждого ПроверяемыйВид Из ВидыКонтактнойИнформации Цикл 
		КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			ОбъектКонтактнойИнформации, ПроверяемыйВид, НаДату, Ложь);
			
		Если КонтактнаяИнформация.Количество() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(КонтактнаяИнформация) Тогда
		Возврат ОписаниеАдреса;
	КонецЕсли;
	
	АдресЗначение = КонтактнаяИнформация[0].Значение;
	ОтборДляПолученияАдресаПоПриказуМинфина = Новый Структура("КодыАдреса, БезПредставлений", Истина, Истина);
	ОтборДляПолученияАдресаСПредставлениями = Новый Структура("КодыАдреса", Ложь);
	АдресПоПриказуМинфина = РаботаСАдресами.СведенияОбАдресеПриказМинфинаРФ171н(АдресЗначение,
		ОтборДляПолученияАдресаПоПриказуМинфина);
		
	АдресСПредставлениями = РаботаСАдресами.СведенияОбАдресе(АдресЗначение,
		ОтборДляПолученияАдресаСПредставлениями);
	
	Если АдресСПредставлениями.ТипАдреса = "Муниципальный" Тогда
		АдресТекст = АдресСПредставлениями.МуниципальноеПредставление;
	Иначе
		АдресТекст = АдресСПредставлениями.Представление;
	КонецЕсли;
	
	ОписаниеАдреса.АдресПоПриказуМинфина = АдресПоПриказуМинфина;
	ОписаниеАдреса.АдресТекст = АдресТекст;
	ОписаниеАдреса.СведенияАдресаПоГАР = ПолучитьСведенияАдресаПоГАР(АдресЗначение);
	
	Если АдресПоПриказуМинфина.КодСтраны = "643" Тогда // Россия
		
		АдресСоответствуетСтруктурированномуФорматуФНС = ИнтеграцияЭДО.АдресСоответствуетСтруктурированномуФорматуФНС(
			АдресПоПриказуМинфина);
		
		Если АдресСоответствуетСтруктурированномуФорматуФНС Тогда
			// Заполняем структурированный адрес.
			
			ОписаниеАдреса.ТипАдреса = "АдресРФ";
			
			РайонПредставлениелемента = ИнтеграцияЭДО.ПредставлениеАдресногоЭлемента(
				АдресПоПриказуМинфина.Район, АдресПоПриказуМинфина.РайонСокращение);
				
			ГородПредставление = ИнтеграцияЭДО.ПредставлениеАдресногоЭлемента(
				АдресПоПриказуМинфина.Город, АдресПоПриказуМинфина.ГородСокращение);
				
			НаселенныйПунктПредставление = ИнтеграцияЭДО.ПредставлениеАдресногоЭлемента(
				АдресПоПриказуМинфина.НаселенныйПункт, АдресПоПриказуМинфина.НаселенныйПунктСокращение);
				
			УлицаПредставление = ИнтеграцияЭДО.ПредставлениеАдресногоЭлемента(
				АдресПоПриказуМинфина.Улица, АдресПоПриказуМинфина.УлицаСокращение);
			
			ДомПредставление = ИнтеграцияЭДО.ПредставлениеАдресногоЭлемента(
				НРег(АдресПоПриказуМинфина.Здание.ТипЗдания), "№", АдресПоПриказуМинфина.Здание.Номер);
				
			Если АдресПоПриказуМинфина.Корпуса.Количество() Тогда
				КорпусПредставление = ИнтеграцияЭДО.ПредставлениеАдресногоЭлемента(
					НРег(АдресПоПриказуМинфина.Корпуса[0].ТипКорпуса), АдресПоПриказуМинфина.Корпуса[0].Номер);
			Иначе
				КорпусПредставление = "";
			КонецЕсли;
			
			Если АдресПоПриказуМинфина.Помещения.Количество() Тогда
				КвартираПредставление = ИнтеграцияЭДО.ПредставлениеАдресногоЭлемента(
					НРег(АдресПоПриказуМинфина.Помещения[0].ТипПомещения),
					АдресПоПриказуМинфина.Помещения[0].Номер);
			Иначе
				КвартираПредставление = "";
			КонецЕсли;
			
			ОписаниеАдреса.Компоненты.Вставить("Индекс", АдресПоПриказуМинфина.Индекс);
			ОписаниеАдреса.Компоненты.Вставить("КодРегиона", АдресПоПриказуМинфина.КодРегиона);
			ОписаниеАдреса.Компоненты.Вставить("НаименованиеРегиона", АдресПоПриказуМинфина.КодРегиона);
			ОписаниеАдреса.Компоненты.Вставить("Район", РайонПредставлениелемента);
			ОписаниеАдреса.Компоненты.Вставить("Город", ГородПредставление);
			ОписаниеАдреса.Компоненты.Вставить("НаселенныйПункт", НаселенныйПунктПредставление);
			ОписаниеАдреса.Компоненты.Вставить("Улица", УлицаПредставление);
			ОписаниеАдреса.Компоненты.Вставить("Дом", ДомПредставление);
			ОписаниеАдреса.Компоненты.Вставить("Корпус", КорпусПредставление);
			ОписаниеАдреса.Компоненты.Вставить("Квартира", КвартираПредставление);
			
		ИначеЕсли ИнтеграцияЭДО.АдресСоответствуетФорматуГАР(АдресПоПриказуМинфина) Тогда
			// Заполняем адрес в формате государственного адресного реестра.
			
			ОписаниеАдреса.ТипАдреса = "АдресГАР";
			
			ОписаниеАдреса.Компоненты.Вставить("УникальныйНомерАдреса", Строка(АдресПоПриказуМинфина.ИдентификаторАдресногоОбъекта));
			ОписаниеАдреса.Компоненты.Вставить("ПочтовыйИндекс", АдресПоПриказуМинфина.Индекс);
			ОписаниеАдреса.Компоненты.Вставить("КодРегиона", АдресПоПриказуМинфина.КодРегиона);
			ОписаниеАдреса.Компоненты.Вставить("НаименованиеРегиона", АдресПоПриказуМинфина.Регион);
			
			// Район, округ, территория.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.МуниципальныйРайон) Тогда
				ОписаниеАдреса.Компоненты.Вставить("РайонОкругТерриторияТипПолный", АдресПоПриказуМинфина.МуниципальныйРайонТипПолный);
				ОписаниеАдреса.Компоненты.Вставить("РайонОкругТерриторияНаименование", АдресПоПриказуМинфина.МуниципальныйРайон);
			КонецЕсли;
			
			// Город, село, поселение.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.Поселение) Тогда
				ОписаниеАдреса.Компоненты.Вставить("ГородСелоПоселениеТипПолный", АдресПоПриказуМинфина.ПоселениеТипПолный);
				ОписаниеАдреса.Компоненты.Вставить("ГородСелоПоселениеНаименование", АдресПоПриказуМинфина.Поселение);
			КонецЕсли;
			
			// Населенный пункт.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.НаселенныйПункт) Тогда	
				ОписаниеАдреса.Компоненты.Вставить("НаселенныйПунктТипКраткий", НРег(АдресПоПриказуМинфина.НаселенныйПунктТипКраткий));
				ОписаниеАдреса.Компоненты.Вставить("НаселенныйПунктНаименование", АдресПоПриказуМинфина.НаселенныйПункт);
			КонецЕсли;
			
			// Элемент планировочной структуры.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.Территория) Тогда	
				ОписаниеАдреса.Компоненты.Вставить("ЭлементПланировочнойСтруктурыТип", НРег(АдресПоПриказуМинфина.ТерриторияТипКраткий));
				ОписаниеАдреса.Компоненты.Вставить("ЭлементПланировочнойСтруктурыНаименование", АдресПоПриказуМинфина.Территория);
			КонецЕсли;
			
			// Элемент улично-дорожной сети.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.Улица) Тогда
				ОписаниеАдреса.Компоненты.Вставить("ЭлементУличноДорожнойСетиТип", НРег(АдресПоПриказуМинфина.УлицаТипКраткий));
				ОписаниеАдреса.Компоненты.Вставить("ЭлементУличноДорожнойСетиНаименование", АдресПоПриказуМинфина.Улица);
			КонецЕсли;
			
			// Здание.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.Здание.Номер) Тогда
				ОписаниеАдреса.Компоненты.Вставить("ЗданиеТип", НРег(АдресПоПриказуМинфина.Здание.ТипЗдания));
				ОписаниеАдреса.Компоненты.Вставить("ЗданиеНомер", АдресПоПриказуМинфина.Здание.Номер);
			КонецЕсли;
			
			// Корпуса.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.Корпуса) Тогда
				ОписаниеАдреса.Компоненты.Вставить("ПомещениеЗданияТип", НРег(АдресПоПриказуМинфина.Корпуса[0].ТипКорпуса));
				ОписаниеАдреса.Компоненты.Вставить("ПомещениеЗданияНомер", АдресПоПриказуМинфина.Корпуса[0].Номер);
			КонецЕсли;
			
			// Помещения.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.Помещения) Тогда
				ОписаниеАдреса.Компоненты.Вставить("ПомещениеКвартирыТип", НРег(АдресПоПриказуМинфина.Помещения[0].ТипПомещения));
				ОписаниеАдреса.Компоненты.Вставить("ПомещениеКвартирыНомер", АдресПоПриказуМинфина.Помещения[0].Номер);
			КонецЕсли;
			
			// Земельный участок.
			Если ЗначениеЗаполнено(АдресПоПриказуМинфина.НомерЗемельногоУчастка) Тогда
				ОписаниеАдреса.Компоненты.Вставить("ЗемельныйУчасток", АдресПоПриказуМинфина.НомерЗемельногоУчастка);
			КонецЕсли;
			
		Иначе
			// Заполняем адрес в произвольной форме.
			
			ОписаниеАдреса.ТипАдреса = "АдресИнформация";
			
			Если АдресСПредставлениями.ТипАдреса = "Муниципальный" Тогда
				АдресТекст = АдресСПредставлениями.МуниципальноеПредставление;
			Иначе
				АдресТекст = АдресСПредставлениями.Представление;
			КонецЕсли;
			
			ОписаниеАдреса.Компоненты.Вставить("КодСтраны", АдресСПредставлениями.КодСтраны);
			ОписаниеАдреса.Компоненты.Вставить("НаименованиеСтраны", АдресСПредставлениями.Страна);
			ОписаниеАдреса.Компоненты.Вставить("АдресТекст", АдресТекст);
			
			ОписаниеАдреса.Компоненты.Вставить("КодРегиона", АдресСПредставлениями.КодРегиона);
		КонецЕсли;
		
	Иначе
		// Иностранный адрес.
		
		ОписаниеАдреса.ТипАдреса = "АдресИнформация";
		
		ОписаниеАдреса.Компоненты.Вставить("КодСтраны", АдресСПредставлениями.КодСтраны);
		ОписаниеАдреса.Компоненты.Вставить("НаименованиеСтраны", АдресСПредставлениями.Страна);
		ОписаниеАдреса.Компоненты.Вставить("АдресТекст", АдресСПредставлениями.Представление);
	КонецЕсли;
	
	Возврат ОписаниеАдреса;
	
КонецФункции

Функция ПолучитьСведенияАдресаПоГАР(АдресЗначение)
	
	КодГАРИКодСтраны = Новый Структура;
	КодГАРИКодСтраны.Вставить("КодГАР", "");
	КодГАРИКодСтраны.Вставить("КодСтраны", "");
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("КодыАдреса", Истина);
	
	Сведения = РаботаСАдресами.СведенияОбАдресе(АдресЗначение, ДополнительныеПараметры);
	
	КодГАРИКодСтраны.КодСтраны = Сведения.КодСтраны;
	
	Если ЗначениеЗаполнено(Сведения.ИдентификаторДома) Тогда
		КодГАРИКодСтраны.КодГАР = Строка(Сведения.ИдентификаторДома);
	Иначе
		КодГАРИКодСтраны.КодГАР = Строка(Сведения.ИдентификаторАдресногоОбъекта);
	КонецЕсли;
	
	Возврат КодГАРИКодСтраны;
	
КонецФункции

