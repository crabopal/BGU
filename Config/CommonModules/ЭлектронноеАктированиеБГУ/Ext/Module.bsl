// Параметры:
//  ВладелецКоллекции - ДанныеФормыСтруктура - объект документа-владельца формы, либо сама форма.
//     Форма указывается в том случае, если таблица-коллекция является реквизитом формы, а не объекта.
//  ИмяКоллекции      - Строка - имя табличной части, в которой заполняется реквизиты.
//     Таблица должна содержать колонки: "НомерСтроки, ИдентификаторСтроки, ИдентификаторДляАктированияЕИС, СтранаПроизводителя".
//
Процедура ЗаполнитьРеквизитыЭлектронногоАктирования(ВладелецКоллекции, ИмяКоллекции = "Товары") Экспорт
	
	Объект = ВладелецКоллекции.Объект;
	КоллекцияДанных = Объект[ИмяКоллекции];
	
	СписокВыбора = ВладелецКоллекции.Элементы[ИмяКоллекции + "ПредставлениеДляАктированияЕИС"].СписокВыбора;
	
	Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
		Если ИмяКоллекции = "УслугиОказанные" Тогда
			ИдентификаторСтроки = СтрокаКоллекции.ИДСтроки; 
		Иначе	
			ИдентификаторСтроки = СтрокаКоллекции.ИдентификаторСтроки;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
			ПараметрыОтбора = Новый Структура("ИдентификаторСтроки",
				ИдентификаторСтроки);
			
			Данные = Объект.ДанныеДляАктированияЕИС.Выгрузить(ПараметрыОтбора);
			Если Данные.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(СтрокаКоллекции, Данные[0]);
				СтрокаКоллекции.ПредставлениеДляАктированияЕИС = Данные[0].ИдентификаторДляАктированияЕИС;
				ЭлектронноеАктированиеЕИСВызовСервера.
					ПриИзмененииИдентификатораДляАктированияЕИС(
						СписокВыбора, ИмяКоллекции, СтрокаКоллекции);
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДобавленныеКолонкиСтрокиТаблицыТовары(Форма, СтрокаТаблицы) Экспорт
	
	Объект = Форма.Объект;
	Строка = Объект.ДанныеДляАктированияЕИС.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
	Если ЗначениеЗаполнено(Строка) Тогда
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Строка);
	КонецЕсли;
	
КонецПроцедуры

Функция КолонкиЭлектронногоАктирования() Экспорт
	
	Колонки = Новый Массив;
	Колонки.Добавить("ИдентификаторДляАктированияЕИС");
	Колонки.Добавить("СтранаПроизводителя");
	Колонки.Добавить("ЕдиницаИзмеренияДоКорректировки");
	Колонки.Добавить("ОбъемВТекстовомВыражении");
	Колонки.Добавить("ОбъемВТекстовомВыраженииДоКорректировки");
	Возврат Колонки;
	
КонецФункции

Процедура КэшироватьЗначенияКолонок(КоллекцияДанных, Колонки, Кэш) Экспорт
	
	Колонки.Добавить("НомерСтроки");
	ЗначенияКолонок = КоллекцияДанных.Выгрузить(, СтрСоединить(Колонки, ","));
	Кэш.Вставить("ЗначенияКолонок", ЗначенияКолонок);
	
КонецПроцедуры

Процедура ВосстановитьЗначенияКолонок(КоллекцияДанных, Кэш) Экспорт
	
	ЗначенияКолонок = Неопределено;
	Если Кэш.Свойство("ЗначенияКолонок", ЗначенияКолонок) Тогда
		Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
			ЗаполнитьЗначенияСвойств(СтрокаКоллекции, ЗначенияКолонок[СтрокаКоллекции.НомерСтроки-1],,"НомерСтроки");
		КонецЦикла;
		Кэш.Удалить("ЗначенияКолонок");
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьВидимостьКолонокЭлектронногоАктирования(Форма, ИспользуетсяЭлектронноеАктирование) Экспорт
	
	Если ОбщегоНазначенияКлиентСервер.
			ЕстьРеквизитИлиСвойствоОбъекта(Форма.Элементы, "Номенклатура") Тогда
		Форма.Элементы.НоменклатураСтранаПроизводителя.Видимость = ИспользуетсяЭлектронноеАктирование;
		Форма.Элементы.НоменклатураПредставлениеДляАктированияЕИС.Видимость = ИспользуетсяЭлектронноеАктирование;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.
			ЕстьРеквизитИлиСвойствоОбъекта(Форма.Элементы, "УслугиОказанные") Тогда
		Форма.Элементы.УслугиОказанныеСтранаПроизводителя.Видимость = ИспользуетсяЭлектронноеАктирование;
		Форма.Элементы.УслугиОказанныеПредставлениеДляАктированияЕИС.Видимость = ИспользуетсяЭлектронноеАктирование;
	КонецЕсли;
	
КонецПроцедуры

// Сохраняет данные по электронному актированию, извлекая их из данных формы.
//
// Параметры:
//  КоллекцияДанных		 - ДанныеФормыКоллекция, ТаблицаЗначений - таблица, из которой будут получены данные по маркировке.
//  ЗаписываемыйОбъект	 - ДокументОбъект - объект документа, в котором хранятся сведения по маркировке.
//
Процедура СохранитьИдентификаторыДляАктированияЕИС(КоллекцияДанных, ЗаписываемыйОбъект) Экспорт
	
	Госконтракт = ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(
		ЗаписываемыйОбъект.Договор);
	АктированиеВключено = ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС();
	ОбменВключен = ЭлектронноеАктированиеЕИС.ОбменПоОрганизацииВключен(
		ЗаписываемыйОбъект.Организация);
	Если НЕ ОбменВключен
		ИЛИ НЕ АктированиеВключено
		ИЛИ НЕ ЗначениеЗаполнено(Госконтракт) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоАктОбОказанииУслуг = Ложь;
	ЭтоПередачаОС = Ложь;
	Если ТипЗнч(ЗаписываемыйОбъект) = Тип("ДокументОбъект.АктОбОказанииУслуг") Тогда
		ЭтоАктОбОказанииУслуг = Истина;
	ИначеЕсли ТипЗнч(ЗаписываемыйОбъект) = Тип("ДокументОбъект.ПередачаОбъектовОС") Тогда
		ЭтоПередачаОС = Истина;
	КонецЕсли;	
	
	ЗаписываемыйОбъект.ДанныеДляАктированияЕИС.Очистить();
	Для Каждого СтрокаТовары Из КоллекцияДанных Цикл
		НоваяСтрока = ЗаписываемыйОбъект.ДанныеДляАктированияЕИС.Добавить();
		Если ЭтоАктОбОказанииУслуг Тогда
			ИдентификаторСтроки = СтрокаТовары.ИДСтроки;
		Иначе
			ИдентификаторСтроки = СтрокаТовары.ИдентификаторСтроки;
		КонецЕсли;	
		
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторСтроки;
		Если ПустаяСтрока(СтрокаТовары.ИдентификаторДляАктированияЕИС) Тогда
			ОписаниеОшибки = НСтр("ru = 'Не заполнен идентификатор строки государственного контракта в табличной части.'");
			ВызватьИсключение(ОписаниеОшибки);
		КонецЕсли;
		НоваяСтрока.ИдентификаторДляАктированияЕИС = СтрокаТовары.ИдентификаторДляАктированияЕИС;
		НоваяСтрока.СтранаПроизводителя = СтрокаТовары.СтранаПроизводителя;
		// Для услуг.
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТовары, "ОбъемВТекстовомВыражении") Тогда
			НоваяСтрока.ОбъемВТекстовомВыражении = СтрокаТовары.ОбъемВТекстовомВыражении;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеДанныеЕИС(Форма, ИмяТабЧастиТовары = "Товары", ИмяТабчастиУслуги = "Услуги") Экспорт
	
	СтрокиКонтракта = Новый Соответствие;
	
	ДанныеДляЗаполнения =
		ЭлектронноеАктированиеЕИС.ДанныеДляЗаполненияТабличнойЧастиДокумента(Форма.Объект.Договор);
	Если НЕ ЗначениеЗаполнено(ДанныеДляЗаполнения) Тогда
		Возврат;
	КонецЕсли;
		
	СуффиксЭлементаФормы = "ПредставлениеДляАктированияЕИС";
	
	Форма.Элементы[ИмяТабЧастиТовары + СуффиксЭлементаФормы].СписокВыбора.Очистить();
	
	Для каждого ОбъектЗакупки Из ДанныеДляЗаполнения Цикл
		Если ОбъектЗакупки.Тип = Перечисления.ТипыОбъектовЗакупкиЕИС.Работа
			ИЛИ ОбъектЗакупки.Тип = Перечисления.ТипыОбъектовЗакупкиЕИС.Услуга Тогда
			ТабличнаяЧасть = ИмяТабчастиУслуги;
		Иначе
			ТабличнаяЧасть = ИмяТабЧастиТовары;
		КонецЕсли;
		Форма.Элементы[ТабличнаяЧасть + СуффиксЭлементаФормы].СписокВыбора.Добавить(
			ОбъектЗакупки.Идентификатор,
			ОбъектЗакупки.Наименование);
		СтрокиКонтракта.Вставить(ОбъектЗакупки.Идентификатор, ОбъектЗакупки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПредставленияСтрокКонтракта(Форма, Табчасть) Экспорт
	
	Объект = Форма.Объект;
	
	СписокВыбора = Форма.Элементы[ТабЧасть + "ПредставлениеДляАктированияЕИС"].СписокВыбора;
	Для каждого Строка Из Объект[Табчасть] Цикл
		
		Если ЗначениеЗаполнено(Строка.ИдентификаторДляАктированияЕИС) Тогда
			Строка.ПредставлениеДляАктированияЕИС = Строка.ИдентификаторДляАктированияЕИС;
			ЭлектронноеАктированиеЕИСВызовСервера.
				ПриИзмененииИдентификатораДляАктированияЕИС(
					СписокВыбора, ТабЧасть, Строка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоКонтрактуНаСервере(Форма, ЗаполнятьУслуги = Ложь) Экспорт
	
	Объект = Форма.Объект;
	ДанныеДляЗаполнения =
		ЭлектронноеАктированиеЕИС.ДанныеДляЗаполненияТабличнойЧастиДокумента(Объект.Договор);
	
	Если ДанныеДляЗаполнения = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='В договоре не указан государственный контракт.'"));
		Возврат;
	КонецЕсли;
	
	Если ДанныеДляЗаполнения.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Номенклатура контракта не сопоставлена с данными БД.'"));
		Возврат;
	КонецЕсли;
	
	ЭтоАктОбОказанииУслуг = Ложь;
	ЭтоПередачаОС = Ложь;
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ЭтоАктОбОказанииУслуг = Истина;
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПередачаОбъектовОС")
		ИЛИ ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
		ЭтоПередачаОС = Истина;
	КонецЕсли;	
	
	Если ЭтоАктОбОказанииУслуг Тогда
		ЗаполнитьСлужебныеДанныеЕИС(Форма, "УслугиОказанные", "УслугиОказанные");
		СписокВыбора = Форма.Элементы["УслугиОказанныеПредставлениеДляАктированияЕИС"].СписокВыбора;
		ЗаполнятьУслуги = Истина;
		Объект.УслугиОказанные.Очистить();
	ИначеЕсли ЭтоПередачаОС Тогда
		ЗаполнитьСлужебныеДанныеЕИС(Форма, "ОсновныеСредства", "ОсновныеСредства");
		СписокВыбора = Форма.Элементы["ОсновныеСредстваПредставлениеДляАктированияЕИС"].СписокВыбора;
		Объект.ОсновныеСредства.Очистить();
	Иначе	
		ЗаполнитьСлужебныеДанныеЕИС(Форма, "Номенклатура", "Номенклатура");
		СписокВыбора = Форма.Элементы["НоменклатураПредставлениеДляАктированияЕИС"].СписокВыбора;
		Объект.Номенклатура.Очистить();
	КонецЕсли;
	
	Для Каждого ОбъектЗакупки Из ДанныеДляЗаполнения Цикл
		
		Если НЕ ЗначениеЗаполнено(ОбъектЗакупки.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоАктОбОказанииУслуг Тогда
			Если ЭлектронноеАктированиеЕИС.ОбъектЗакупкиУслугаИлиРабота(ОбъектЗакупки) Тогда
				Строка = Объект.УслугиОказанные.Добавить();
				
				// Дополнительные колонки для эл.актирования.
				Строка.ИдентификаторДляАктированияЕИС = ОбъектЗакупки.Идентификатор;
				
				Строка.ЕдиницаИзмеренияЕИСКод = ОбъектЗакупки.ЕдиницаИзмеренияКод;
				Строка.ЕдиницаИзмеренияЕИСНаименование = ОбъектЗакупки.ЕдиницаИзмеренияНаименование;
				
				Строка.СтранаПроизводителя = ОбъектЗакупки.СтранаПроизводителя;
				
				Строка.Номенклатура = ОбъектЗакупки.Номенклатура;
				Строка.Количество = ОбъектЗакупки.Количество;
				Строка.Цена = ОбъектЗакупки.Цена;
				Строка.СтавкаНДС = ?(ЗначениеЗаполнено(ОбъектЗакупки.СтавкаНДС), ОбъектЗакупки.СтавкаНДС, Перечисления.СтавкиНДС.БезНДС);
				
				ЗаполнитьИдентификаторСтрокиУслуг(Строка);
				
				Строка.ПредставлениеДляАктированияЕИС = ОбъектЗакупки.Идентификатор;
				ЭлектронноеАктированиеЕИСВызовСервера.
					ПриИзмененииИдентификатораДляАктированияЕИС(
						СписокВыбора, "УслугиОказанные", Строка);
				Строка.Всего = ОбъектЗакупки.Сумма;		
				РасчитатьСтроку(Строка, Объект.СуммаВключаетНДС, "Всего");		
			КонецЕсли;
		ИначеЕсли ЭтоПередачаОС Тогда
			Если НЕ ЭлектронноеАктированиеЕИС.ОбъектЗакупкиУслугаИлиРабота(ОбъектЗакупки) Тогда
				Строка = Объект.ОсновныеСредства.Добавить();
				
				// Дополнительные колонки для эл.актирования.
				Строка.ИдентификаторДляАктированияЕИС = ОбъектЗакупки.Идентификатор;
				
				Строка.ЕдиницаИзмеренияЕИСКод = ОбъектЗакупки.ЕдиницаИзмеренияКод;
				Строка.ЕдиницаИзмеренияЕИСНаименование = ОбъектЗакупки.ЕдиницаИзмеренияНаименование;
				
				Строка.СтранаПроизводителя = ОбъектЗакупки.СтранаПроизводителя;
				Строка.СтранаПроисхождения = ОбъектЗакупки.СтранаПроисхождения;
				
				Строка.ОсновноеСредство = ОбъектЗакупки.Номенклатура;
				Строка.Количество = ОбъектЗакупки.Количество;
				Строка.ЦенаПродажи = ОбъектЗакупки.Цена;
				Строка.СтавкаНДС = ?(ЗначениеЗаполнено(ОбъектЗакупки.СтавкаНДС), ОбъектЗакупки.СтавкаНДС, Перечисления.СтавкиНДС.БезНДС);
				
				ЗаполнитьИдентификаторСтроки(Строка);
				
				Строка.ПредставлениеДляАктированияЕИС = ОбъектЗакупки.Идентификатор;
				ЭлектронноеАктированиеЕИСВызовСервера.
					ПриИзмененииИдентификатораДляАктированияЕИС(
						СписокВыбора, "ОсновныеСредства", Строка);
				
				Строка.Всего = ОбъектЗакупки.Сумма;		
				РасчитатьСтроку(Строка, Объект.СуммаВключаетНДС, "Всего", "ЦенаПродажи");		
			КонецЕсли;
		Иначе
			Если НЕ ЭлектронноеАктированиеЕИС.ОбъектЗакупкиУслугаИлиРабота(ОбъектЗакупки) Тогда
				Строка = Объект.Номенклатура.Добавить();
				
				// Дополнительные колонки для эл.актирования.
				Строка.ИдентификаторДляАктированияЕИС = ОбъектЗакупки.Идентификатор;
				
				Строка.ЕдиницаИзмеренияЕИСКод = ОбъектЗакупки.ЕдиницаИзмеренияКод;
				Строка.ЕдиницаИзмеренияЕИСНаименование = ОбъектЗакупки.ЕдиницаИзмеренияНаименование;
				
				Строка.СтранаПроизводителя = ОбъектЗакупки.СтранаПроизводителя;
				Строка.СтранаПроисхождения = ОбъектЗакупки.СтранаПроисхождения;
				
				Строка.Номенклатура = ОбъектЗакупки.Номенклатура;
				Строка.Количество = ОбъектЗакупки.Количество;
				Строка.Цена = ОбъектЗакупки.Цена;
				Строка.СтавкаНДС = ?(ЗначениеЗаполнено(ОбъектЗакупки.СтавкаНДС), ОбъектЗакупки.СтавкаНДС, Перечисления.СтавкиНДС.БезНДС);
				
				ЗаполнитьИдентификаторСтроки(Строка);
				
				Строка.ПредставлениеДляАктированияЕИС = ОбъектЗакупки.Идентификатор;
				ЭлектронноеАктированиеЕИСВызовСервера.
					ПриИзмененииИдентификатораДляАктированияЕИС(
						СписокВыбора, "Номенклатура", Строка);
				
				Строка.Всего = ОбъектЗакупки.Сумма;		
				РасчитатьСтроку(Строка, Объект.СуммаВключаетНДС, "Всего");		
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РасчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита, ИмяРеквизитаЦены = "")
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", ИмяРеквизита <> "Цена");
	
	Если ЗначениеЗаполнено(ИмяРеквизитаЦены) Тогда
		ПараметрыРасчета.Вставить("ИмяРеквизитаЦена", ИмяРеквизитаЦены);
	КонецЕсли;	
	
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	
КонецПроцедуры

// Найти или создать единицу измерения.
// 
// Параметры:
//  КодЕдиницыИзмерения - Строка - Код единицы измерения
//  НаименованиеЕдиницыИзмерения - Строка - Наименование единицы измерения
// 
// Возвращаемое значение:
//  СправочникСсылка.ЕдиницыИзмерения, Неопределено - Найти создать единицу измерения
Функция НайтиСоздатьЕдиницуИзмерения(
		КодЕдиницыИзмерения, НаименованиеЕдиницыИзмерения) Экспорт
	
	ЕдиницаИзмерения = Неопределено;
	
	Если ЗначениеЗаполнено(КодЕдиницыИзмерения) Тогда
		ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ЕдиницаИзмеренияПоКоду(
			КодЕдиницыИзмерения, НаименованиеЕдиницыИзмерения);
	ИначеЕсли ЗначениеЗаполнено(НаименованиеЕдиницыИзмерения) Тогда
		ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(
			НаименованиеЕдиницыИзмерения, Истина);
	Иначе
		ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ЕдиницаИзмерения;
	
КонецФункции

// см. ЭлектронноеАктированиеЕИСПереопределяемый.КнопкиЗаполненияТабличныхЧастейДокументов()
Процедура КнопкиЗаполненияТабличныхЧастейДокументов(Форма, Кнопки) Экспорт
	
	Кнопки.Добавить("ТоварыУслугиЗаполнитьПоКонтракту");
	
КонецПроцедуры

Процедура ТипыДокументовРеализацииТоваровУслуг(ТипыОбъектов) Экспорт
	ТипыОбъектов.Добавить(Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12"));
	ТипыОбъектов.Добавить(Тип("ДокументСсылка.НакладнаяНаОтпускМ15"));
	ТипыОбъектов.Добавить(Тип("ДокументСсылка.ПередачаОбъектовОС"));
	ТипыОбъектов.Добавить(Тип("ДокументСсылка.ПередачаОбъектовИК"));
	ТипыОбъектов.Добавить(Тип("ДокументСсылка.АктОбОказанииУслуг"));
КонецПроцедуры

// см. ЭлектронноеАктированиеЕИСПереопределяемый.ЗаполнитьТабличнуюЧастьДокументаПоДаннымДереваТоваровУслуг()
Функция ЗаполнитьТабличнуюЧастьДокументаПоДаннымДереваТоваровУслуг(
			СсылкаНаДокумент, ДеревоТоваров, ДеревоРаботУслуг) Экспорт
		
	Результат = ЭлектронноеАктированиеЕИС.НовыйРезультатЗаполненияТабличныхЧастей();
	
	ДокументОбъект = СсылкаНаДокумент.ПолучитьОбъект();

	Ошибки = Новый Массив;
	
	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		КоличествоСтрокВДокументе = ДокументОбъект.Номенклатура.Количество();
		Для Каждого РодительскаяСтрока Из ДеревоТоваров.Строки Цикл
			Если РодительскаяСтрока.Строки.Количество() = 0 Тогда
				// Без детализации.
				Если РодительскаяСтрока.НомерСтроки < КоличествоСтрокВДокументе Тогда
					СтрокаДокумента = ДокументОбъект.Номенклатура.Получить(РодительскаяСтрока.НомерСтроки - 1);
					СтрокаДокумента.Количество = РодительскаяСтрока.Количество;
					СтрокаДокумента.Сумма = РодительскаяСтрока.Сумма;
					ЗаполнитьЗначенияСвойств(СтрокаДокумента, РодительскаяСтрока);
				КонецЕсли;
			Иначе
				Для Каждого СтрокаДетализации Из РодительскаяСтрока.Строки Цикл
					Если СтрокаДетализации.Номенклатура.Пустая() Тогда
						ОписаниеОшибки = НСтр("ru='Не заполнена номенклатура товаров.'");
						Ошибки.Добавить(ОписаниеОшибки);
					КонецЕсли;
					Если СтрокаДетализации.НомерСтроки > 0 Тогда
						// Строки с номером.
						Если РодительскаяСтрока.НомерСтроки <= КоличествоСтрокВДокументе Тогда
							СтрокаДокумента = ДокументОбъект.Номенклатура.Получить(СтрокаДетализации.НомерСтроки - 1);
							ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаДетализации);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Если Ошибки.Количество() > 0 Тогда
			Результат.ОписаниеОшибки = СтрСоединить(Ошибки);
			Возврат Результат;
		КонецЕсли;

		Для Каждого РодительскаяСтрока Из ДеревоТоваров.Строки Цикл
			Если РодительскаяСтрока.Строки.Количество() > 0 Тогда
				// Новые строки.
				Для Каждого СтрокаДетализации Из РодительскаяСтрока.Строки Цикл
					Если СтрокаДетализации.НомерСтроки = 0 Тогда
						// Строки без номера.
						СтрокаДокумента = ДокументОбъект.Номенклатура.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаДетализации);
					КонецЕсли;
