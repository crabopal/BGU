Функция ЗапросПоНомеклатуре(Документ)
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		|	*,
		|	"""" КАК Идентификатор
		|ИЗ
		|	Документ.АктОбОказанииУслуг.УслугиОказанные КАК АктОбОказанииУслугУслугиОказанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктОбОказанииУслуг.ДанныеДляАктированияЕИС КАК
		|			РеализацияУслугДанныеДляАктированияЕИС
		|		ПО АктОбОказанииУслугУслугиОказанные.ИДСтроки = РеализацияУслугДанныеДляАктированияЕИС.ИдентификаторСтроки
		|		И РеализацияУслугДанныеДляАктированияЕИС.Ссылка = АктОбОказанииУслугУслугиОказанные.Ссылка
		|ГДЕ
		|	АктОбОказанииУслугУслугиОказанные.Ссылка = &Ссылка";
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		|	*,
		|	"""" КАК Идентификатор
		|ИЗ
		|	Документ.НакладнаяНаРеализациюТорг12.Номенклатура КАК НакладнаяНаРеализациюТорг12Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НакладнаяНаРеализациюТорг12.ДанныеДляАктированияЕИС КАК
		|			НакладнаяНаРеализациюТорг12ДанныеДляАктированияЕИС
		|		ПО НакладнаяНаРеализациюТорг12Номенклатура.ИдентификаторСтроки = НакладнаяНаРеализациюТорг12ДанныеДляАктированияЕИС.ИдентификаторСтроки
		|		И НакладнаяНаРеализациюТорг12ДанныеДляАктированияЕИС.Ссылка = НакладнаяНаРеализациюТорг12Номенклатура.Ссылка
		|ГДЕ
		|	НакладнаяНаРеализациюТорг12Номенклатура.Ссылка = &Ссылка";
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		|	*,
		|	"""" КАК Идентификатор
		|ИЗ
		|	Документ.НакладнаяНаОтпускМ15.Материалы КАК НакладнаяНаОтпускМ15Материалы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НакладнаяНаОтпускМ15.ДанныеДляАктированияЕИС КАК
		|			НакладнаяНаОтпускМ15ДанныеДляАктированияЕИС
		|		ПО НакладнаяНаОтпускМ15Материалы.ИдентификаторСтроки = НакладнаяНаОтпускМ15ДанныеДляАктированияЕИС.ИдентификаторСтроки
		|		И НакладнаяНаОтпускМ15ДанныеДляАктированияЕИС.Ссылка = НакладнаяНаОтпускМ15Материалы.Ссылка
		|ГДЕ
		|	НакладнаяНаОтпускМ15Материалы.Ссылка = &Ссылка";
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		|	*,
		|	"""" КАК Идентификатор
		|ИЗ
		|	Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ПередачаОбъектовОСОсновныеСредства
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаОбъектовОС.ДанныеДляАктированияЕИС КАК
		|			ПередачаОбъектовОСДанныеДляАктированияЕИС
		|		ПО ПередачаОбъектовОСОсновныеСредства.ИдентификаторСтроки = ПередачаОбъектовОСДанныеДляАктированияЕИС.ИдентификаторСтроки
		|		И ПередачаОбъектовОСДанныеДляАктированияЕИС.Ссылка = ПередачаОбъектовОСОсновныеСредства.Ссылка
		|ГДЕ
		|	ПередачаОбъектовОСОсновныеСредства.Ссылка = &Ссылка";
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		|	*,
		|	"""" КАК Идентификатор
		|ИЗ
		|	Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ПередачаОбъектовИКОсновныеСредства
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаОбъектовИК.ДанныеДляАктированияЕИС КАК
		|			ПередачаОбъектовИКДанныеДляАктированияЕИС
		|		ПО ПередачаОбъектовИКОсновныеСредства.ИдентификаторСтроки = ПередачаОбъектовИКДанныеДляАктированияЕИС.ИдентификаторСтроки
		|		И ПередачаОбъектовИКДанныеДляАктированияЕИС.Ссылка = ПередачаОбъектовИКОсновныеСредства.Ссылка
		|ГДЕ
		|	ПередачаОбъектовИКОсновныеСредства.Ссылка = &Ссылка";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Возврат Запрос;

КонецФункции

//Устарела. Не используется. Функция возвращает курс ставку НДС
//
// Параметры:
//  Валюта - СправочникСсылка.Валюты, валюта, по которой необходимо получить курс
//  ДатаКурса - Дата, календарная дата, на которую необходимо получить курс валюты
//
// Возвращаемое значение:
//	Курс переданной валюты на переданную дату, 1 в случае отсутствия значения.
//
Функция ПолучитьСтавкуНДС(СтавкаНДС, ПрименяютсяСтавки4и2 = Ложь) Экспорт

	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		Возврат 20;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		Ставка = ?(ПрименяютсяСтавки4и2, 2, 10);
		Возврат Ставка;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		Ставка = ?(ПрименяютсяСтавки4и2, 4, 18);
		Возврат Ставка;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция ВидимостьЭлементовАктирования(Организация, Договор) Экспорт
	Результат = Ложь;
	Если ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(Договор) Тогда
		Если ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС()
			И ЭлектронноеАктированиеЕИС.ОбменПоОрганизацииВключен(Организация) Тогда
			ГосударственныйКонтрактЕИС = ЭлектронноеАктированиеЕИС.
				НайтиГосударственныйКонтрактПоВладельцу(Договор);
		
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Процедура ЗаполнитьДанныеЭлектронногоАктирования(ДанныеДляПечати, РеквизитыСФ) Экспорт
	НомераТаблиц = Новый Структура;
	
	Если ТипЗнч(РеквизитыСФ.Ссылка) = Тип("ДокументСсылка.СчетФактураВыданный") ТОгда
		ДокументОснование = РеквизитыСФ.ДокументОснование;
	ИначеЕсли ТипЗнч(РеквизитыСФ.Ссылка) = Тип("ДокументСсылка.АктОбОказанииУслуг")
		ИЛИ ТипЗнч(РеквизитыСФ.Ссылка) = Тип("ДокументСсылка.ПередачаОбъектовОС") 
		ИЛИ ТипЗнч(РеквизитыСФ.Ссылка) = Тип("ДокументСсылка.ПередачаОбъектовИК") 
		ИЛИ ТипЗнч(РеквизитыСФ.Ссылка) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") 
		ИЛИ ТипЗнч(РеквизитыСФ.Ссылка) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ДокументОснование = РеквизитыСФ.Ссылка;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст =  ТекстЗапросаДанныеДляПечатиСчетовФактур(
				НомераТаблиц, ДокументОснование.Метаданные().Имя);
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);			
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеЭлектронногоАктирования = Новый Структура;
	ДанныеСтрокАктированияЕИС = РезультатЗапроса[НомераТаблиц.ДанныеСтрокАктированияЕИС].Выгрузить();
	ДанныеЭлектронногоАктирования.Вставить("ДанныеСтрокАктированияЕИС",
		ДанныеСтрокАктированияЕИС);
	ДанныеЭлектронногоАктирования.Вставить("ДанныеГосконтракта",
		РезультатЗапроса[НомераТаблиц.ДанныеГосконтракта].Выгрузить());
	ДанныеЭлектронногоАктирования.Вставить("МестаПоставкиДокументовДляЕИС",
		РезультатЗапроса[НомераТаблиц.МестаПоставкиДокументовДляЕИС].Выгрузить());
	ДанныеЭлектронногоАктирования.Вставить("ПодписантыДокументовЕИС",
		РезультатЗапроса[НомераТаблиц.ПодписантыДокументовЕИС].Выгрузить());
	ДанныеЭлектронногоАктирования.Вставить("ПриложенныеФайлыДляЭлектронногоАктированияЕИС",
		РезультатЗапроса[НомераТаблиц.ПриложенныеФайлыДляЭлектронногоАктированияЕИС].Выгрузить());
	
	ТаблицаИдентификаторовЕИС = ДанныеСтрокАктированияЕИС.Скопировать();
	ТаблицаИдентификаторовЕИС.Свернуть(
		"ИдентификаторДляАктированияЕИС", "КоличествоСтрок");
	// Соответствие между идентификатором для ЕИС и структурой с количеством строк и данными родителя.
	ДанныеПоДетализации = Новый Соответствие();
	Для Каждого Строка Из ТаблицаИдентификаторовЕИС Цикл
		ДанныеСтрок = Новый Структура("КоличествоСтрок, ДанныеРодителя",
			Строка.КоличествоСтрок, Неопределено);
		ДанныеПоДетализации.Вставить(
			Строка.ИдентификаторДляАктированияЕИС, ДанныеСтрок);
	КонецЦикла;
	ДанныеЭлектронногоАктирования.Вставить("ДанныеПоДетализации", ДанныеПоДетализации);
	
	ДанныеДляПечати.Вставить("ДанныеЭлектронногоАктирования", ДанныеЭлектронногоАктирования);
КонецПроцедуры

Функция ЗапросПоНомеклатуреИзДокумента(Документ, Детализация, СИтогами) Экспорт

	Если ТипЗнч(Документ) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		|	*,
		|	"""" КАК Идентификатор
		|ИЗ
		|	Документ.АктОбОказанииУслуг.УслугиОказанные КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктОбОказанииУслуг.ДанныеДляАктированияЕИС КАК
		|			РеализацияТоваровУслугДанныеДляАктированияЕИС
		|		ПО РеализацияТоваровУслугТовары.ИДСтроки = РеализацияТоваровУслугДанныеДляАктированияЕИС.ИдентификаторСтроки
		|		И РеализацияТоваровУслугДанныеДляАктированияЕИС.Ссылка = РеализацияТоваровУслугТовары.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда	
		ТекстЗапроса = "ВЫБРАТЬ
		|	*,
		|	"""" КАК Идентификатор
		|ИЗ
		|	Документ.НакладнаяНаРеализациюТорг12.Номенклатура КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НакладнаяНаРеализациюТорг12.ДанныеДляАктированияЕИС КАК
		|			РеализацияТоваровУслугДанныеДляАктированияЕИС
		|		ПО РеализацияТоваровУслугТовары.ИдентификаторСтроки = РеализацияТоваровУслугДанныеДляАктированияЕИС.ИдентификаторСтроки
		|		И РеализацияТоваровУслугДанныеДляАктированияЕИС.Ссылка = РеализацияТоваровУслугТовары.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда	
		ТекстЗапроса = "ВЫБРАТЬ
		|	*,
		|	"""" КАК Идентификатор
		|ИЗ
		|	Документ.НакладнаяНаОтпускМ15.Материалы КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НакладнаяНаОтпускМ15.ДанныеДляАктированияЕИС КАК
		|			РеализацияТоваровУслугДанныеДляАктированияЕИС
		|		ПО РеализацияТоваровУслугТовары.ИдентификаторСтроки = РеализацияТоваровУслугДанныеДляАктированияЕИС.ИдентификаторСтроки
		|		И РеализацияТоваровУслугДанныеДляАктированияЕИС.Ссылка = РеализацияТоваровУслугТовары.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда	
		ТекстЗапроса = "ВЫБРАТЬ
		|	*,
		|	"""" КАК Идентификатор
		|ИЗ
		|	Документ.ПередачаОбъектовОС.ОсновныеСредства КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаОбъектовОС.ДанныеДляАктированияЕИС КАК
		|			РеализацияТоваровУслугДанныеДляАктированияЕИС
		|		ПО РеализацияТоваровУслугТовары.ИдентификаторСтроки = РеализацияТоваровУслугДанныеДляАктированияЕИС.ИдентификаторСтроки
		|		И РеализацияТоваровУслугДанныеДляАктированияЕИС.Ссылка = РеализацияТоваровУслугТовары.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда	
		ТекстЗапроса = "ВЫБРАТЬ
		|	*,
		|	"""" КАК Идентификатор
		|ИЗ
		|	Документ.ПередачаОбъектовИК.ОсновныеСредства КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаОбъектовИК.ДанныеДляАктированияЕИС КАК
		|			РеализацияТоваровУслугДанныеДляАктированияЕИС
		|		ПО РеализацияТоваровУслугТовары.ИдентификаторСтроки = РеализацияТоваровУслугДанныеДляАктированияЕИС.ИдентификаторСтроки
		|		И РеализацияТоваровУслугДанныеДляАктированияЕИС.Ссылка = РеализацияТоваровУслугТовары.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
	Иначе
		Запрос = Новый Запрос;
		Возврат Запрос;
	КонецЕсли;
	

	Итоги = "
			|	ИТОГИ
			|	СУММА(Количество),
			|	СУММА(Сумма),
			|	МАКСИМУМ(Цена)
			|ПО
			|	ИдентификаторДляАктированияЕИС";

	Если СИтогами Тогда
		ТекстЗапроса = ТекстЗапроса + Итоги;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Запрос.УстановитьПараметр("Детализация", Детализация);
	Возврат Запрос;

КонецФункции

// см. ЭлектронноеАктированиеЕИСПереопределяемый.ДляДокументаЗаполняютсяМестаПоставки()
Процедура ДляДокументаЗаполняютсяМестаПоставки(Документ, МестаПоставкиЗаполняются) Экспорт
	
	МестаПоставкиЗаполняются = Истина;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеЭлектронногоАктированияУКД(ДанныеДляПечати, РеквизитыКСФ) Экспорт
	НомераТаблиц = Новый Структура;
	
	ДокументОснование = РеквизитыКСФ.ДокументОснование;
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетФактураВыданный") ТОгда
		ДокументОснование = ДокументОснование.ДокументОснование;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =  ТекстЗапросаДанныеДляПечатиКорректировочныхСчетовФактур(
				НомераТаблиц, ДокументОснование.Метаданные().Имя);
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);			
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеЭлектронногоАктирования = Новый Структура;
	
	Если НомераТаблиц.Свойство("МестаПоставкиДокументовДляЕИС") Тогда
		// Места поставки есть только в УПД.
		ДанныеЭлектронногоАктирования.Вставить("МестаПоставкиДокументовДляЕИС",
			РезультатЗапроса[НомераТаблиц.МестаПоставкиДокументовДляЕИС].Выгрузить());
	КонецЕсли;
	
	ДанныеСтрокАктированияЕИС = РезультатЗапроса[НомераТаблиц.ДанныеСтрокАктированияЕИС].Выгрузить();
	ДанныеЭлектронногоАктирования.Вставить("ДанныеСтрокАктированияЕИС",
		ДанныеСтрокАктированияЕИС);
	ДанныеЭлектронногоАктирования.Вставить("ДанныеГосконтракта",
		РезультатЗапроса[НомераТаблиц.ДанныеГосконтракта].Выгрузить());
	ДанныеЭлектронногоАктирования.Вставить("ПодписантыДокументовЕИС",
		РезультатЗапроса[НомераТаблиц.ПодписантыДокументовЕИС].Выгрузить());
	ДанныеЭлектронногоАктирования.Вставить("ПриложенныеФайлыДляЭлектронногоАктированияЕИС",
		РезультатЗапроса[НомераТаблиц.ПриложенныеФайлыДляЭлектронногоАктированияЕИС].Выгрузить());
	
	ТаблицаИдентификаторовЕИС = ДанныеСтрокАктированияЕИС.Скопировать();
	ТаблицаИдентификаторовЕИС.Свернуть(
		"ИдентификаторДляАктированияЕИС", "КоличествоСтрок");
	// Соответствие между идентификатором для ЕИС и структурой с количеством строк и данными родителя.
	ДанныеПоДетализации = Новый Соответствие();
	Для Каждого Строка Из ТаблицаИдентификаторовЕИС Цикл
		ДанныеСтрок = Новый Структура("КоличествоСтрок, ДанныеРодителя",
			Строка.КоличествоСтрок, Неопределено);
		ДанныеПоДетализации.Вставить(
			Строка.ИдентификаторДляАктированияЕИС, ДанныеСтрок);
	КонецЦикла;
	ДанныеЭлектронногоАктирования.Вставить("ДанныеПоДетализации", ДанныеПоДетализации);
	ДанныеЭлектронногоАктирования.Вставить("ДокументОснованиеРеализацияДляЕИС", ДокументОснование);
	
	ДанныеДляПечати.Вставить("ДанныеЭлектронногоАктирования", ДанныеЭлектронногоАктирования);
	
КонецПроцедуры

Функция СчетКонтрагентаИзГосКонтракта(Контрагент, СсылкаНаКонтракт)
	Результат = Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ГосударственныеКонтрактыЕИСРеквизитыСчетаПоставщика.Ссылка КАК Ссылка,
	               |	ГосударственныеКонтрактыЕИСРеквизитыСчетаПоставщика.ТипЛицевогоСчета КАК ТипЛицевогоСчета,
	               |	ГосударственныеКонтрактыЕИСРеквизитыСчетаПоставщика.НомерЛицевогоСчета КАК НомерЛицевогоСчета,
	               |	ГосударственныеКонтрактыЕИСРеквизитыСчетаПоставщика.НаименованиеБанка КАК НаименованиеБанка,
	               |	ГосударственныеКонтрактыЕИСРеквизитыСчетаПоставщика.НомерБанковскогоСчета КАК НомерБанковскогоСчета,
	               |	ГосударственныеКонтрактыЕИСРеквизитыСчетаПоставщика.БИК КАК БИК,
	               |	ГосударственныеКонтрактыЕИСРеквизитыСчетаПоставщика.КорреспондентскийСчетБанка КАК КорреспондентскийСчетБанка,
	               |	ГосударственныеКонтрактыЕИСРеквизитыСчетаПоставщика.ИНН КАК ИНН,
	               |	ГосударственныеКонтрактыЕИСРеквизитыСчетаПоставщика.КПП КАК КПП
	               |ИЗ
	               |	Справочник.ГосударственныеКонтрактыЕИС.РеквизитыСчетаПоставщика КАК ГосударственныеКонтрактыЕИСРеквизитыСчетаПоставщика
	               |ГДЕ
	               |	ГосударственныеКонтрактыЕИСРеквизитыСчетаПоставщика.Ссылка = &ГосКонтракт";
	Запрос.УстановитьПараметр("ГосКонтракт", СсылкаНаКонтракт);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.НомерЛицевогоСчета) Тогда
			НомерСчета = Выборка.НомерЛицевогоСчета;
		Иначе
			НомерСчета = Выборка.НомерБанковскогоСчета;
		КонецЕсли;
		Результат = ЭлектронныеДокументыБГУ.СчетКонтрагента(Контрагент, НомерСчета);
		
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			//Создание нового счета
			УстановитьПривилегированныйРежим(Истина);

			СчетКонтрагента					 = Справочники.БанковскиеИКазначейскиеСчета.СоздатьЭлемент();
			СчетКонтрагента.Владелец		 = Контрагент;
			
			Если Выборка.ТипЛицевогоСчета = Перечисления.ТипыЛицевогоСчетаЕИС.РасчетныйСчетВБанке Тогда
				ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский;
				СчетКонтрагента.Код			 = Выборка.НомерБанковскогоСчета;
			Иначе
				ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Казначейский;
				СчетКонтрагента.Код			 = Выборка.НомерЛицевогоСчета;
			КонецЕсли;	
			
			СчетКонтрагента.ТипЛицевогоСчета = ТипЛицевогоСчета;
			СчетКонтрагента.Наименование	 = Строка(Выборка.ТипЛицевогоСчета);
			Банк = Справочники.Банки.НайтиПоКоду(Выборка.БИК);
			Если НЕ ЗначениеЗаполнено(Банк) Тогда
				ТЗБанки = Справочники.Банки.ПолучитьТаблицуБанковПоРеквизитам("Код", Выборка.БИК);
				Если ТЗБанки.Количество()>0 Тогда
					Банк = ТЗБанки[0].Ссылка;
				КонецЕсли;	
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(Банк) Тогда
				ТекстСообщения = НСтр("ru='Банк расчетного счета %1 контрагента %2 не найден в справочнике банков и его следует указать вручную.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Выборка.НомерЛицевогоСчета, КОнтрагент);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;	
			
			СчетКонтрагента.КассовыйОрган	 = Банк;
			
			Попытка
				СчетКонтрагента.Записать();
			
				Результат = СчетКонтрагента.Ссылка;
			Исключение
				Текст = НСтр("ru = 'Ошибка создания расчетного счета контрагента при загрузке сведений государственного контракта'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Создание расчетного счета контрагента %1'"), Текст);
				ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, Контрагент.Метаданные(), Контрагент,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ВызватьИсключение(Текст);
			КонецПопытки;
				
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ДоговорПоИКЗ(ИКЗ) Экспорт
	Результат = Справочники.Договоры.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ИКЗ) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ХарактеристикиОбязательствСрезПоследних.Период КАК Период,
		|	ХарактеристикиОбязательствСрезПоследних.Договор КАК Договор,
		|	ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики КАК ВидХарактеристики,
		|	ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики КАК ЗначениеХарактеристики,
		|	ХарактеристикиОбязательствСрезПоследних.АвторИзменения КАК АвторИзменения
		|ИЗ
		|	РегистрСведений.ХарактеристикиОбязательств.СрезПоследних КАК ХарактеристикиОбязательствСрезПоследних
		|ГДЕ
		|	ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики = &ВидХарактеристики
		|	И ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики = &ЗначениеХарактеристики";		
		Запрос.УстановитьПараметр("ВидХарактеристики", ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ИКЗ);
		Запрос.УстановитьПараметр("ЗначениеХарактеристики", ИКЗ);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Договор;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Процедура СоздатьДоговорНаОснованииКонтракта(СсылкаНаКонтракт, РезультатСоздания) Экспорт
	
	Реквизиты = "Организация, Контрагент, Номер, ДатаЗаключенияКонтракта, ТребуетсяБанковскоеСопровождение, ТребуетсяБанковскоеСопровождение, ПредметКонтракта, Код, ИдентификационныйКодЗакупки";
			
	ДанныеГК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаКонтракт, Реквизиты);
	
	НайденДоговор = Ложь;
	ИдентификационныйКодЗакупки = ДанныеГК.ИдентификационныйКодЗакупки;
	Если ЗначениеЗаполнено(ИдентификационныйКодЗакупки) Тогда
		ДоговорПоИКЗ = ЭлектронноеАктированиеБГУ.ДоговорПоИКЗ(ИдентификационныйКодЗакупки);
		Если ЗначениеЗаполнено(ДоговорПоИКЗ) Тогда
			Результат = ДоговорПоИКЗ.ПолучитьОбъект();
			НайденДоговор = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ НайденДоговор Тогда
		Результат = Справочники.Договоры.СоздатьЭлемент();
	КонецЕсли;

	Организация = ДанныеГК.Организация;
	Результат.Организация = Организация;
	Результат.ВидДоговора = ВидДоговора(Организация);
	Результат.НомерДоговора = ДанныеГК.Номер;
	Результат.ДатаДоговора = ДанныеГК.ДатаЗаключенияКонтракта;
	Результат.Контрагент = ДанныеГК.Контрагент;
	Результат.ВидОбязательства = НСтр("ru = 'Государственный контракт'");

	Результат.КраткоеСодержание = ДанныеГК.ПредметКонтракта;
	Результат.Долгосрочный = Истина;
	Результат.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = Истина;
	Результат.ПризнакЗавершенияКонкурсныхПроцедур = Истина;
	Результат.РезультатЗавершенияКонкурсныхПроцедур = 1;
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		Результат.ВестиГрафикПлатежей = Истина;
		Результат.ВестиПланГрафикИсполнения = Истина;
	КонецЕсли;	
	
	Результат.СчетКонтрагента = СчетКонтрагентаИзГосКонтракта(ДанныеГК.Контрагент, СсылкаНаКонтракт);
	
	ТекстНаименования = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 от %3 № %2'"),
		Результат.ВидОбязательства, ДанныеГК.Номер, Формат(ДанныеГК.ДатаЗаключенияКонтракта, "ДФ=dd.MM.yyyy"));
	
	Результат.Наименование = ТекстНаименования;

	Результат.УчетПредметаДоговора = ЭлектронныеДокументыБГУ.ИспользоватьУчетПредметаДоговораДляНовыхДоговоров(Организация);	
	
	Если ДанныеГК.ТребуетсяБанковскоеСопровождение ИЛИ ДанныеГК.ТребуетсяБанковскоеСопровождение Тогда
		Результат.КонтрактСУчастникомГОЗ = Истина;
	КонецЕсли;
	
	Попытка
		Результат.Записать();
		РезультатСоздания.Договор = Результат.Ссылка;
		РезультатСоздания.Выполнено = Истина;
		
		// Характеристики договора
		Если ЗначениеЗаполнено(ДанныеГК.Код) Тогда
			Запись = РегистрыСведений.ХарактеристикиОбязательств.СоздатьМенеджерЗаписи();
			Запись.Период = ТекущаяДатаСеанса();
			Запись.Договор = Результат.Ссылка;
	        Запись.ВидХарактеристики = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыХарактеристикОбязательства.НомерРеестровойЗаписи");
			Запись.ЗначениеХарактеристики = ДанныеГК.Код;
		    Запись.Записать(); 
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеГК.ИдентификационныйКодЗакупки) И НЕ НайденДоговор Тогда
			Запись = РегистрыСведений.ХарактеристикиОбязательств.СоздатьМенеджерЗаписи();
			Запись.Период = ТекущаяДатаСеанса();
			Запись.Договор = Результат.Ссылка;
	        Запись.ВидХарактеристики = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыХарактеристикОбязательства.ИКЗ");
			Запись.ЗначениеХарактеристики = ДанныеГК.ИдентификационныйКодЗакупки;
		    Запись.Записать(); 
		КонецЕсли;
	Исключение
		РезультатСоздания.Выполнено = Ложь;
		РезультатСоздания.ОписаниеОшибки = НСтр("ru = 'Ошибка при создании нового элемента справочника ""Договоры""
			|из элемента справочника ""Государственные контракты из ЕИС в сфере закупок""'");
	КонецПопытки;
	
КонецПроцедуры

Функция ВидДоговора(Организация)
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиОбменаЕИСПоставщика = ЭлектронноеАктированиеЕИС.НастройкиОбменаЕИС(Организация);
	Если ЗначениеЗаполнено(НастройкиОбменаЕИСПоставщика) Тогда
		Результат = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	Иначе	
		Результат = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Процедура ЗаполнитьСвязиПараметровВыбораИПараметрыВыбораДоговора(СвязиПараметровВыбора,
			 ПараметрыВыбора) Экспорт
			 
	Перем НовыйМассив;
	Перем НовыеПараметры;
	Перем НоваяСвязь;
	Перем НовыеЗначения;
	Перем НовыйПараметр;
	
	НовыйМассив = Новый Массив();
	НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Контрагент", "Объект.Контрагент");
	НовыйМассив.Добавить(НоваяСвязь);
	НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Организация", "Объект.Организация");
	НовыйМассив.Добавить(НоваяСвязь);

	СвязиПараметровВыбора = Новый ФиксированныйМассив(НовыйМассив);	
	
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	НовыйМассив.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	НовыйМассив.Добавить(Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство);
	НовыеЗначения = Новый ФиксированныйМассив(НовыйМассив);
		
	НовыйПараметр = Новый ПараметрВыбора("Отбор.ВидДоговора", НовыеЗначения);
	
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	
	ПараметрыВыбора = НовыеПараметры;
			 
КонецПроцедуры

// При определении объектов с командами создания на основании.
// 
// Параметры:
//  Объекты см. СозданиеНаОснованииПереопределяемый.ПриОпределенииОбъектовСКомандамиСозданияНаОсновании
Процедура ПриОпределенииОбъектовСКомандамиСозданияНаОсновании(Объекты) Экспорт

	Объекты.Добавить(Метаданные.Документы.АктПриемкиВходящийЕИС);
	
КонецПроцедуры

// См. ЭлектронноеАктированиеЕИСПереопределяемый.ИнициализацияКомандФормы.
Процедура ИнициализацияКомандФормы(ИмяСобытия, ИмяОбъекта, Контекст, Результат = Неопределено, Параметры = Неопределено) Экспорт
	
	Если ИмяСобытия = "ДобавитьКомандыСозданияНаОсновании"
		И ИмяОбъекта = "АктПриемкиВходящийЕИС" Тогда
		СозданиеНаОсновании.ДобавитьКомандуСозданияНаОсновании(Контекст, Метаданные.Документы.РезультатыРассмотренияДокументаПриемкиЕИС);
	КонецЕсли;
	
КонецПроцедуры

Функция НаименованиеКонтрагентаДляПлатежногоПоручения(КонтрагентПокупатель, РасчетныйСчетКонтрагента)
    Результат = "";
	ЗаполнитьПоДаннымКонтрагента = Ложь;
	
	Если ТипЗнч(КонтрагентПокупатель) = Тип("СправочникСсылка.Организации") Тогда
		Если ЗначениеЗаполнено(РасчетныйСчетКонтрагента) Тогда
			РеквизитыСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РасчетныйСчетКонтрагента, "КорреспондентТекст");	
			Если ЗначениеЗаполнено(РеквизитыСчета.КорреспондентТекст) Тогда
				Результат = РеквизитыСчета.КорреспондентТекст;
			Иначе
				ЗаполнитьПоДаннымКонтрагента = Истина;
			КонецЕсли;
		Иначе
			ЗаполнитьПоДаннымКонтрагента = Истина;
		КонецЕсли;
		
		Если ЗаполнитьПоДаннымКонтрагента Тогда
			Контрагент = КонтрагентПокупатель;	
			
			РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "НаименованиеПолное, НаименованиеСокращенное");	
			
			Наименование		= РеквизитыКонтрагента.НаименованиеСокращенное;
			НаименованиеПолное  = РеквизитыКонтрагента.НаименованиеПолное;
			
			НаименованиеПолное	= ?(ЗначениеЗаполнено(НаименованиеПолное), 
														НаименованиеПолное, Наименование);
			
			Результат = НаименованиеПолное;
		КонецЕсли;	
	Иначе
		Если ЗначениеЗаполнено(РасчетныйСчетКонтрагента) Тогда
			РеквизитыСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РасчетныйСчетКонтрагента, "КорреспондентТекст");	
			Если ЗначениеЗаполнено(РеквизитыСчета.КорреспондентТекст) Тогда
				Результат = РеквизитыСчета.КорреспондентТекст;
			Иначе
				ЗаполнитьПоДаннымКонтрагента = Истина;
			КонецЕсли;
		Иначе
			ЗаполнитьПоДаннымКонтрагента = Истина;
		КонецЕсли;
		
		Если ЗаполнитьПоДаннымКонтрагента Тогда
			Контрагент = КонтрагентПокупатель;	
			
			РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "Наименование, НаименованиеСокращенное");	
			
			Наименование		= РеквизитыКонтрагента.Наименование;
			НаименованиеПолное  = РеквизитыКонтрагента.НаименованиеСокращенное;
			
			РеквизитыКонтрагента = Новый Структура("СсылкаНаОбъект, НаименованиеПолное", Контрагент);
			Справочники.Контрагенты.ПолучитьДанныеКонтрагента(РеквизитыКонтрагента);
				
			НаименованиеПолное	= ?(ЗначениеЗаполнено(НаименованиеПолное), 
														НаименованиеПолное, РеквизитыКонтрагента.НаименованиеПолное);
			
			Результат = НаименованиеПолное;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЭтоОбъектЗакупкиСВозможностьюКорректировкиЦены(ДанныеОбъекта)
	
	СписокОКПД2 = Новый Массив;
	СписокОКПД2.Добавить("46.71.12");
	СписокОКПД2.Добавить("46.71.13");
	СписокОКПД2.Добавить("47.30.1");
	СписокОКПД2.Добавить("19.20");
	СписокОКПД2.Добавить("06.20.10.131");
	СписокОКПД2.Добавить("65.11.10.110");
	СписокОКПД2.Добавить("65.12.11.000");
	СписокОКПД2.Добавить("65.12.12.000");
	СписокОКПД2.Добавить("65.12.21.000");
	СписокОКПД2.Добавить("65.12.34.000");
	СписокОКПД2.Добавить("65.12.41.000");
	СписокОКПД2.Добавить("65.12.49.000");
	СписокОКПД2.Добавить("65.12.50.000");
	СписокОКПД2.Добавить("65.12.90.000");
	СписокОКПД2.Добавить("06.20.10.110");

	РазрядыКода = СтрРазделить(ДанныеОбъекта.КодТовараДляЕИС, ".", Ложь);
	КодДляПоиска = "";
	КодНайден = Ложь;
	Для каждого Код из РазрядыКода Цикл
		
		Если ПустаяСтрока(КодДляПоиска) Тогда
			КодДляПоиска = Код;
		Иначе
			КодДляПоиска = КодДляПоиска + "." + Код;
		КонецЕсли;
		
		Если НЕ СписокОКПД2.Найти(КодДляПоиска) = Неопределено Тогда
			КодНайден = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КодНайден;
	
КонецФункции

Функция БанковскиеРеквизитыДляЕИС(Организация, Договор, ДокументРеализации) Экспорт
	БанковскиеРеквизиты = ЭлектронноеАктированиеЕИС.НовыеБанковскиеРеквизитыДляПриложения();

	ГосударственныйКонтрактЕИС = ЭлектронноеАктированиеЕИС.НайтиГосударственныйКонтрактПоВладельцу(Договор);
	Если ЗначениеЗаполнено(ГосударственныйКонтрактЕИС) И ЗначениеЗаполнено(ДокументРеализации) Тогда
		
		КодОКТМО = "";
		Если ЗначениеЗаполнено(Организация) Тогда
			СтруктураДанныхОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "КодОКТМО");
			КодОКТМО = СокрЛП(СтруктураДанныхОрганизации.КодОКТМО);
		КонецЕсли;	
		
		СтруктураДанныхПоставщика = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРеализации, "РеквизитыЛицевогоСчета, РасчетныйСчетКонтрагента, Контрагент, Договор");
		Если ЗначениеЗаполнено(СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета) Тогда
			ДанныеДляЭДПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ДанныеДляЭДПродавцаДляГосНужд(ДокументРеализации);
			
			СтруктураДанныхРеквизитыЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета, "КассовыйОрган");
			
			ЛицевойСчет = СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета.Владелец;
			
			СтруктураДанныхЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛицевойСчет, "Код");
			НомерЛицевогоСчета = СокрЛП(СтруктураДанныхЛицевогоСчета.Код);
			
			РасчетныеРеквизиты = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета, РасчетныеРеквизиты);

			ТребуетсяКазначейскоеСопровождение = Ложь;
			Если ЗначениеЗаполнено(СтруктураДанныхПоставщика.Договор) Тогда
				СтруктураДанныхГосКонтракта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ГосударственныйКонтрактЕИС,
					"ТребуетсяКазначейскоеСопровождение");
				ТребуетсяКазначейскоеСопровождение = СтруктураДанныхГосКонтракта.ТребуетсяКазначейскоеСопровождение;
			КонецЕсли;
			
			Если ТипЗнч(СтруктураДанныхРеквизитыЛицевогоСчета.КассовыйОрган) = Тип("СправочникСсылка.Казначейства") Тогда
				СтруктураДанныхКазначейства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанныхРеквизитыЛицевогоСчета.КассовыйОрган, "КазначействоИлиФО");
				КазначействоИлиФО = СтруктураДанныхКазначейства.КазначействоИлиФО;
				Если КазначействоИлиФО = 1 Тогда
					БанковскиеРеквизиты.ТипСчета = ЭлектронноеАктированиеЕИС.ТипСчетаЛицевойСчетВФинансовомОргане();
				Иначе
					БанковскиеРеквизиты.ТипСчета = ЭлектронноеАктированиеЕИС.ТипСчетаЛицевойСчетВТерОрганеКазначейства();
				КонецЕсли;	
				
				БанковскиеРеквизиты.БИК = РасчетныеРеквизиты.БикБанкаПолучателя;
				БанковскиеРеквизиты.ЕдиныйКазначейскийСчет = РасчетныеРеквизиты.СчетБанкаПолучателя;
				БанковскиеРеквизиты.КазначейскийСчет = РасчетныеРеквизиты.НомерСчетаПолучателя;
				БанковскиеРеквизиты.КБК = СокрЛП(ДанныеДляЭДПродавцаДляГосНужд.КодБюджетнойКлассификацииПродавца);
				
				Если ЗначениеЗаполнено(СтруктураДанныхПоставщика.Договор) Тогда
					СтруктураДанныхДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанныхПоставщика.Договор, "УИН");
				    БанковскиеРеквизиты.УИПИлиУИН = СтруктураДанныхДоговора.УИН; 
				КонецЕсли;
				
				Если ЗначениеЗаполнено(КодОКТМО) Тогда
					ДанныеОКТМО = ЭлектронноеАктированиеЕИС.НовыйДанныеОКТМО();
					ДанныеОКТМО.Вставить("Код", КодОКТМО);
					БанковскиеРеквизиты.ОКТМО = ДанныеОКТМО;
				КонецЕсли;
				
				Если ТребуетсяКазначейскоеСопровождение Тогда
					БанковскиеРеквизиты.ЛицевойСчетДляКазначейскогоСопровождения = НомерЛицевогоСчета;
				Иначе	
					БанковскиеРеквизиты.НомерЛицевогоСчета = НомерЛицевогоСчета;
				КонецЕсли;
				БанковскиеРеквизиты.НаименованиеБанкаТОФК = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
				
				БанковскиеРеквизиты.НаименованиеКонтрагентаДляПлатежногоПоручения = 
					НаименованиеКонтрагентаДляПлатежногоПоручения(Организация, СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета);
			ИначеЕсли ТипЗнч(СтруктураДанныхРеквизитыЛицевогоСчета.КассовыйОрган) = Тип("СправочникСсылка.Банки") Тогда
				БанковскиеРеквизиты.ТипСчета = ЭлектронноеАктированиеЕИС.ТипСчетаРасчетныйСчет();
				БанковскиеРеквизиты.БИК = РасчетныеРеквизиты.БикБанкаПолучателя;
				БанковскиеРеквизиты.КорреспондентскийСчетБанка = РасчетныеРеквизиты.СчетБанкаПолучателя;
				БанковскиеРеквизиты.РасчетныйСчет = РасчетныеРеквизиты.НомерСчетаПолучателя;
				БанковскиеРеквизиты.НаименованиеБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;

				БанковскиеРеквизиты.НаименованиеКонтрагентаДляПлатежногоПоручения = 
					НаименованиеКонтрагентаДляПлатежногоПоручения(Организация, СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	
	Возврат БанковскиеРеквизиты;
КонецФункции	

Функция ТребуетсяЗаполнитьУИНДляОбменаСЕИС(Организация, Договор, ДокументРеализации) Экспорт
    Результат = Ложь;

	ГосударственныйКонтрактЕИС = ЭлектронноеАктированиеЕИС.НайтиГосударственныйКонтрактПоВладельцу(Договор);
	Если ЗначениеЗаполнено(ГосударственныйКонтрактЕИС) И ЗначениеЗаполнено(ДокументРеализации) Тогда
		БанковскиеРеквизиты = БанковскиеРеквизитыДляЕИС(Организация, Договор, ДокументРеализации);
		
		//Контроль
		Если БанковскиеРеквизиты.ТипСчета = ЭлектронноеАктированиеЕИС.ТипСчетаЛицевойСчетВТерОрганеКазначейства()
			ИЛИ БанковскиеРеквизиты.ТипСчета = ЭлектронноеАктированиеЕИС.ТипСчетаЛицевойСчетВФинансовомОргане() Тогда
			
			Если ЗначениеЗаполнено(БанковскиеРеквизиты.КазначейскийСчет) Тогда
				КодыКонтроля = СтрРазделить("03212,03222,03232,03242,03252,03262,03272,03214,03224,03234,03244", ",", Ложь);
				
				КодКонтроля = Сред(БанковскиеРеквизиты.КазначейскийСчет, 1, 5);
				Если НЕ КодыКонтроля.Найти(КодКонтроля) = Неопределено Тогда
					Результат = Истина;
				Иначе
					КодыКонтроля = СтрРазделить("000,001,002", ",", Ложь);
					КодКонтроля = Сред(БанковскиеРеквизиты.КазначейскийСчет, 7, 3);
					
					ПромежуточныйРезультат = Ложь;
					Если НЕ КодыКонтроля.Найти(КодКонтроля) = Неопределено Тогда
						ПромежуточныйРезультат = Истина;
					КонецЕсли;

					КодКонтроля = Сред(БанковскиеРеквизиты.БИК, 7, 3);
					Если НЕ КодыКонтроля.Найти(КодКонтроля) = Неопределено И ПромежуточныйРезультат Тогда
						Результат = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
			Если НЕ Результат И ЗначениеЗаполнено(БанковскиеРеквизиты.РасчетныйСчет) Тогда
				КодыКонтроля = СтрРазделить("40503,40603,40703", ",", Ложь);
				
				КодКонтроляРасчетногоСчета = Сред(БанковскиеРеквизиты.РасчетныйСчет, 14, 1);
				КодКонтроля = Сред(БанковскиеРеквизиты.РасчетныйСчет, 1, 5);
				Если (НЕ КодыКонтроля.Найти(КодКонтроля) = Неопределено) И КодКонтроляРасчетногоСчета = "4" Тогда
					Результат = Истина;
				Иначе	
					КодыКонтроля = СтрРазделить("40822,03100", ",", Ложь);
					Если НЕ КодыКонтроля.Найти(КодКонтроля) = Неопределено Тогда
						Результат = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

