		КонецЦикла;
		
	ИначеЕсли ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		КоличествоСтрокВДокументе = ДокументОбъект.Материалы.Количество();
		Для Каждого РодительскаяСтрока Из ДеревоТоваров.Строки Цикл
