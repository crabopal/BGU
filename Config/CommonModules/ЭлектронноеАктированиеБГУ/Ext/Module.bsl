#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьДеревьяДанныхПараметровАктированияДокумента(Документ,
	ДанныеКонтракта, ДеревоТоваров, ДеревоРаботУслуг) Экспорт
	
	// Заполняем корневые элементы.
	Для Каждого ОбъектЗакупки Из ДанныеКонтракта.ОбъектыЗакупки Цикл
		Если ЭлектронноеАктированиеЕИС.ОбъектЗакупкиУслугаИлиРабота(ОбъектЗакупки) Тогда
			Строка = ДеревоРаботУслуг.Строки.Добавить();
		Иначе
			Строка = ДеревоТоваров.Строки.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Строка, ОбъектЗакупки);
		Строка.Номенклатура = ОбъектЗакупки.Наименование;
		Строка.ИдентификаторДляАктированияЕИС = ОбъектЗакупки.Идентификатор;
		Строка.ГиперссылкаОткрыть = "Открыть";
	КонецЦикла;

	Запрос = ЗапросПоНомеклатуре(Документ);
	Номенклатура = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.Прямой);

	Для Каждого Строка Из Номенклатура Цикл
		
		ОбъектНайден = Ложь;
		Для Каждого Объект Из ДеревоТоваров.Строки Цикл
			Если Объект.ИдентификаторДляАктированияЕИС = Строка.ИдентификаторДляАктированияЕИС Тогда
				СтрокаДерева = Объект.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева, Строка);
				ОбъектНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ОбъектНайден Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Объект Из ДеревоРаботУслуг.Строки Цикл
			Если Объект.ИдентификаторДляАктированияЕИС = Строка.ИдентификаторДляАктированияЕИС Тогда
				СтрокаДерева = Объект.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева, Строка);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВладелецПрисоединенныхФайлов(ОбъектыУчетаЭД) Экспорт
	
	СсылкаНаОбъект = Неопределено;
	Для каждого Основание Из ОбъектыУчетаЭД Цикл
		Если ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.АктОбОказанииУслуг")
			ИЛИ (ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.СчетФактураВыданный")) Тогда
			СсылкаНаОбъект = Основание.ОбъектУчета;
			Прервать;
		ИначеЕсли ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
			ИЛИ (ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.СчетФактураВыданный")) Тогда
			СсылкаНаОбъект = Основание.ОбъектУчета;
			Прервать;
		ИначеЕсли ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
			ИЛИ (ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.СчетФактураВыданный")) Тогда
			СсылкаНаОбъект = Основание.ОбъектУчета;
			Прервать;
		ИначеЕсли ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.ПередачаОбъектовОС")
			ИЛИ (ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.СчетФактураВыданный")) Тогда
			СсылкаНаОбъект = Основание.ОбъектУчета;
			Прервать;
		ИначеЕсли ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.ПередачаОбъектовИК")
			ИЛИ (ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.СчетФактураВыданный")) Тогда
			СсылкаНаОбъект = Основание.ОбъектУчета;
			Прервать;
		ИначеЕсли ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			СсылкаНаОбъект = Основание.ОбъектУчета.ДокументОснование;
			Прервать;
		ИначеЕсли ТипЗнч(Основание.ОбъектУчета) = Тип("ДокументСсылка.РезультатыРассмотренияДокументаПриемкиЕИС") Тогда
			СсылкаНаОбъект = Основание.ОбъектУчета;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СсылкаНаОбъект;
		
КонецФункции

Функция СоставительДокумента(СведенияОПродавце) Экспорт
	
	СоставительДокументаНаименование =
		ЭлектронноеАктированиеЕИС.НаименованиеОрганизацииДляЭД(
			СведенияОПродавце);
	
	Возврат СоставительДокументаНаименование;
	
КонецФункции

Процедура ПоместитьРезультатВыполненияЗапросаВДанныеДляПечати(
				РезультатЗапроса, ДанныеДляПечати, НомераТаблиц) Экспорт
	
	ДанныеЭлектронногоАктирования = Новый Структура;
	ДанныеСтрокАктированияЕИС = РезультатЗапроса[НомераТаблиц.ДанныеСтрокАктированияЕИС].Выгрузить();
	ДанныеЭлектронногоАктирования.Вставить("ДанныеСтрокАктированияЕИС",
		ДанныеСтрокАктированияЕИС);
	ДанныеЭлектронногоАктирования.Вставить("ДанныеГосконтракта",
		РезультатЗапроса[НомераТаблиц.ДанныеГосконтракта].Выгрузить());
	ДанныеЭлектронногоАктирования.Вставить("МестаПоставкиДокументовДляЕИС",
		РезультатЗапроса[НомераТаблиц.МестаПоставкиДокументовДляЕИС].Выгрузить());
	ДанныеЭлектронногоАктирования.Вставить("ПодписантыДокументовЕИС",
		РезультатЗапроса[НомераТаблиц.ПодписантыДокументовЕИС].Выгрузить());
	ДанныеЭлектронногоАктирования.Вставить("ПриложенныеФайлыДляЭлектронногоАктированияЕИС",
		РезультатЗапроса[НомераТаблиц.ПриложенныеФайлыДляЭлектронногоАктированияЕИС].Выгрузить());
	
	ТаблицаИдентификаторовЕИС = ДанныеСтрокАктированияЕИС.Скопировать();
	ТаблицаИдентификаторовЕИС.Свернуть(
		"ИдентификаторДляАктированияЕИС", "КоличествоСтрок");
	// Соответствие между идентификатором для ЕИС и структурой с количеством строк и данными родителя.
	ДанныеПоДетализации = Новый Соответствие();
	Для Каждого Строка Из ТаблицаИдентификаторовЕИС Цикл
		ДанныеСтрок = Новый Структура("КоличествоСтрок, ДанныеРодителя",
			Строка.КоличествоСтрок, Неопределено);
		ДанныеПоДетализации.Вставить(
			Строка.ИдентификаторДляАктированияЕИС, ДанныеСтрок);
	КонецЦикла;
	ДанныеЭлектронногоАктирования.Вставить("ДанныеПоДетализации", ДанныеПоДетализации);
	
	ДанныеДляПечати.Вставить("ДанныеЭлектронногоАктирования", ДанныеЭлектронногоАктирования);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПоСтрокеТоваровУПД_2019(НоваяСтрокаЭД, СтрокаВыборки, СтруктураДанных, ДанныеПриложенияЕИС) Экспорт

	ДанныеЭлектронногоАктированияЕИС = СтруктураДанных.ДанныеЭлектронногоАктирования;
	
	ДанныеПоДетализации = ДанныеЭлектронногоАктированияЕИС.ДанныеПоДетализации;
	СтрокиДокумента = ДанныеЭлектронногоАктированияЕИС.ДанныеСтрокАктированияЕИС;

	Контракт = ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0].Ссылка;
	ДанныеКонтракта = ЭлектронноеАктированиеЕИС.ДанныеГосударственногоКонтракта(Контракт);
	СпособМаксимальнаяЦена = ЭлектронноеАктированиеЕИС.СпособУказанияЦеныМаксимальнаяЦена();

	ИдентификаторСтроки = НоваяСтрокаЭД.ИдентификаторСтроки;
	СтрокаДокумента = СтрокиДокумента.Найти(ИдентификаторСтроки, "ИдентификаторСтроки");
	Если НЕ ЗначениеЗаполнено(СтрокаДокумента) Тогда
		Шаблон = НСтр("ru='Не найдена строка госконтракта по идентификатору строки документа %1. 
		|Следует перезаполнить документ ""Счет-фактура выданный"" по ссылке ""Заполнить на основании документа"" на закладке ""Документы-основания"".'");
		ТекстОшибки = СтрШаблон(Шаблон, ИдентификаторСтроки);
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	// Замена кода товара в УПД на данные из контракта.
	НоваяСтрокаЭД.ТоварКод = СтрокаДокумента.КодТовараДляЕИС;
	
	РеквизитыКонтракта = "Организация";
	СтруктураДанныхКонтракта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контракт, РеквизитыКонтракта);
	Если ЗаполнятьДляЕИСВУПДПоставщикаНаименованиеТРУПоГосконтракту(СтруктураДанныхКонтракта.Организация) Тогда
		НоваяСтрокаЭД.ТоварНаименование = СтрокаДокумента.Наименование;
	КонецЕсли;	
	
	СтавкаНДС = ЭлектронныеДокументыБГУ.ПолучитьСтавкуНДСЧислом(НоваяСтрокаЭД.НалоговаяСтавка);
	Если НоваяСтрокаЭД.Количество = 0 Тогда
		Количество = 1;
	Иначе
		Количество = НоваяСтрокаЭД.Количество;
	КонецЕсли;

	// Цена за единицу указывается с точностью до 11 цифр.
	// Описание методики расчета приведено в комментариях к РДИК_0210.
	Если (ДанныеКонтракта.ИнформацияОЦенах.СпособУказанияЦены = СпособМаксимальнаяЦена
		И ЗначениеЗаполнено(ДанныеКонтракта.ИнформацияОЦенах.ФормулаЦены)
		И ЭтоОбъектЗакупкиСВозможностьюКорректировкиЦены(СтрокаДокумента))
		ИЛИ СтрокаДокумента.Количество = 0 Тогда
		НоваяСтрокаЭД.ЦенаЗаЕдиницуИзмерения = Окр(НоваяСтрокаЭД.СтоимостьТоваровСНалогом / Количество
			/ (1 + СтавкаНДС), 11);
		ЦенаИзКонтрактаСНДС = Окр(НоваяСтрокаЭД.СтоимостьТоваровСНалогом / Количество, 11);
	Иначе
		ЦенаИзКонтрактаСНДС = СтрокаДокумента.Цена;
		Если НЕ ЗначениеЗаполнено(ЦенаИзКонтрактаСНДС) Тогда
			ЦенаИзКонтрактаСНДС = 0;
		КонецЕсли;	
		ЦенаЗаЕдиницуИзмерения = Окр(ЦенаИзКонтрактаСНДС / (1 + СтавкаНДС), 11);
		НоваяСтрокаЭД.ЦенаЗаЕдиницуИзмерения = ЦенаЗаЕдиницуИзмерения;
		НоваяСтрокаЭД.СтоимостьТоваровБезНалога = Окр(ЦенаЗаЕдиницуИзмерения * Количество, 2);
		НоваяСтрокаЭД.СтоимостьТоваровСНалогом =
		   Окр(НоваяСтрокаЭД.СтоимостьТоваровБезНалога * (1 + СтавкаНДС), 2);
		НоваяСтрокаЭД.СуммаНалога =
		   НоваяСтрокаЭД.СтоимостьТоваровСНалогом - НоваяСтрокаЭД.СтоимостьТоваровБезНалога;
	КонецЕсли;
	
	ИдентификаторДляАктированияЕИС = СтрокаДокумента.ИдентификаторДляАктированияЕИС;
	СтрокаДетализации = ДанныеПоДетализации[ИдентификаторДляАктированияЕИС];
	ЕстьДетализация = СтрокаДетализации.КоличествоСтрок > 1;
	
	ВерсияФорматаВерсииСхем12 = "1.11";
	Если НЕ ЭлектронноеАктированиеЕИС.ВерсияФормата() = ВерсияФорматаВерсииСхем12 Тогда
		// С 13 версии схем детализация не используется.
		ЕстьДетализация = Ложь;
	КонецЕсли;
	
	// Определяем вид ТРУ.
	ВидТРУ = ЭлектронноеАктированиеЕИС.ОпределитьВидТРУДляУПД(СтрокаДокумента.Тип);
	ЭтоРаботаИлиУслуга = СтрокаДокумента.ЭтоРаботаИлиУслуга;
	// Устанавливаем признак в строке УПД.
	НоваяСтрокаЭД.Признак = Строка(ВидТРУ);
	
	Если ЕстьДетализация Тогда
		Если НЕ ЗначениеЗаполнено(СтрокаДетализации.ДанныеРодителя) Тогда
			// создаем родителя
		КонецЕсли;
	Иначе
		
		// Без детализации.
		СтрокаПриложения = ЭлектронноеАктированиеЕИС.НовыеНедетализированныеСведенияОТРУ();
		СтрокаПриложения.Идентификатор = ИдентификаторДляАктированияЕИС;
		СтрокаПриложения.НомерСтрокиТаблицы = НоваяСтрокаЭД.НомерСтроки;
		СтрокаПриложения.ИдентификаторПозиции = СтрЗаменить(НоваяСтрокаЭД.ИдентификаторСтроки, "-", "");
		Если ЭтоРаботаИлиУслуга Тогда
			Если ЗначениеЗаполнено(СтрокаДокумента.ОбъемРаботыУслуги) Тогда
				// Количество указывается в текстовом выражении.
				СтрокаПриложения.ОбъемВТекстовомВыражении = СтрокаДокумента.ОбъемВТекстовомВыражении;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаПриложения.ЦенаИзКонтрактаСНДС = ЦенаИзКонтрактаСНДС;
		СтрокаПриложения.ИсходноеНаименование = СтрокаДокумента.Наименование;
		
		СтрокаПриложения.ТехническийИдентификатор = СтрокаДокумента.ВнутреннийИдентификаторЕИС;
		СтрокаПриложения.ВнешнийТехническийИдентификатор = СтрокаДокумента.ВнешнийИдентификатор;
		
		Если НЕ ЭтоРаботаИлиУслуга Тогда
			СтранаПроисхождения = СтрокаДокумента.СтранаПроисхожденияКонтракт;
			Если ЗначениеЗаполнено(СтранаПроисхождения) Тогда
				ДанныеСтраныПроисхождения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтранаПроисхождения, "Код, Наименование");
				СтрокаПриложения.КодСтраныПроисхождения = ДанныеСтраныПроисхождения.Код;
				СтрокаПриложения.НаименованиеСтраныПроисхождения = ДанныеСтраныПроисхождения.Наименование;
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаДокумента.СтранаПроизводителя) Тогда
				СтранаПроизводителя = СтрокаДокумента.СтранаПроизводителя;
			Иначе	
				СтранаПроизводителя = СтрокаДокумента.СтранаПроизводителяКонтракт;
			КонецЕсли;
			Если ЗначениеЗаполнено(СтранаПроизводителя) Тогда
				ДанныеСтраныПроизводителя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтранаПроизводителя, "Код, Наименование");
				СтрокаПриложения.КодСтраныПроизводителя = ДанныеСтраныПроизводителя.Код;
				СтрокаПриложения.НаименованиеСтраныПроизводителя = ДанныеСтраныПроизводителя.Наименование;
			КонецЕсли;
			
			ИдентификаторМестаПоставкиЕИС = "";
			Если ДанныеПриложенияЕИС.МестаПоставки.Количество() > 0 Тогда
				ИдентификаторМестаПоставкиЕИС = ДанныеПриложенияЕИС.МестаПоставки[0].Идентификатор;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрокаЭД.ИдентификаторМестаПоставкиЕИС) Тогда
				НоваяСтрокаЭД.ИдентификаторМестаПоставкиЕИС = ИдентификаторМестаПоставкиЕИС;
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(НоваяСтрокаЭД.ИдентификаторМестаПоставкиЕИС) Тогда
				МестоПоставки = ЭлектронноеАктированиеЕИС.НовыеСведенияОМестеПоставкиТоварнойПозиции();
				МестоПоставки.Идентификатор = НоваяСтрокаЭД.ИдентификаторМестаПоставкиЕИС;
				МестоПоставки.ПоставляемоеКоличество = НоваяСтрокаЭД.Количество; 
				СтрокаПриложения.СведенияОМестахПоставкиТовара.Добавить(МестоПоставки);
			КонецЕсли;	
			
		КонецЕсли;
		
		// Признак поставки объекта закупки с улучшенными характеристиками:
		// - 1 - не установлен;
		// - 2 - установлен из информации о контракте;
		// - 3 - установлен пользователем.
		// Игнорируется для авансовых СЧФ.
		// Игнорируется при приеме исправления к документу, который был подписан до версии 11.2.
		// В других случаях контролируется обязательное заполнение.
		// Если для позиции ТРУ в сведениях о контракте установлен одноименный признак, то контролируется, что в составе данного атрибута указано значение "2 - установлен из информации о контракте".
		// Если для позиции ТРУ в сведениях о контракте НЕ установлен одноименный признак, то контролируется, что в составе данного атрибута указано значение, отличное от "2 - установлен из информации о контракте".
		// В исправлении редактирование данного признака допускается только в том случае, если:
		// - статус документа, к которому формируется исправление - «Отказано при рассмотрении»
		// - в сведениях о контракте для данной позиции не установлен признак поставки объекта закупки с улучшенными характеристиками.
		СтрокаПриложения.ПризнакПоставкиОбъектаЗакупкиСУлучшеннымиХарактеристиками = 1;
		ДанныеПриложенияЕИС.СведенияОТоварах.ТоварыРаботыУслуги.Добавить(СтрокаПриложения);
		
	КонецЕсли;
	
КонецПроцедуры

#Область УПД_5_03

Процедура ЗаполнитьДанныеЭлектронногоАктированияУПД_5_03(СтруктураПриемник, Шапка) Экспорт
	
	ДанныеЕИС = Новый Структура("
		|ЕстьЭлектронноеАктирование,
		|ДанныеЭлектронногоАктирования,
		|ДанныеПриложенияЕИС,
		|ИдентификаторМестаПоставкиЕИС");
	
	Контракт = ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(Шапка.Договор);
	
	ДанныеЕИС.ЕстьЭлектронноеАктирование = ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС()
		И ЗначениеЗаполнено(Контракт)
		И ЭлектронноеАктированиеЕИС.ОбменПоОрганизацииВключен(Шапка.Организация);
		
	Если ДанныеЕИС.ЕстьЭлектронноеАктирование Тогда
		ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеЭлектронногоАктирования(ДанныеЕИС, Шапка);
	КонецЕсли;
	
	ДанныеЕИС.ДанныеПриложенияЕИС = ЭлектронноеАктированиеЕИС.НовыеДанныеПриложенияКТитулуПродавцаУПД();
	ДанныеЕИС.ИдентификаторМестаПоставкиЕИС = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	
	СтруктураПриемник.Вставить("ДанныеЕИС", ДанныеЕИС);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПоСтрокеТоваровУПД_5_03(НоваяСтрокаЭД, СтрокаТаблицыНФА, ОбщиеПараметры) Экспорт

	// Обновляются следующие поля сведений ЕИС в строке таблицы ЭД:
	//   Наименование
	//   Цена
	//   СведенияОДекларации (таблица)
	//   СтранаПроисхождения
	//   Характеристика
	//   Код
	//   КодКаталога
	//   Признак
	//   
	//   ИдентификаторМестаПоставкиЕИС
	//   ИдентификаторСтрокиГосконтрактаЕИС
	
	ДанныеЕИС = ОбщиеПараметры.ДопДанныеДокумента.ДанныеЕИС;
	
	ДанныеЭлектронногоАктированияЕИС = ДанныеЕИС.ДанныеЭлектронногоАктирования;
	
	Если ДанныеЭлектронногоАктированияЕИС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСтрокиГосконтрактаЕИС = СтрокаТаблицыНФА.ИдентификаторСтроки;
	
	НоваяСтрокаЭД.ИдентификаторМестаПоставкиЕИС = ДанныеЕИС.ИдентификаторМестаПоставкиЕИС;
	НоваяСтрокаЭД.ИдентификаторСтрокиГосконтрактаЕИС = ИдентификаторСтрокиГосконтрактаЕИС;
	
	ДанныеПриложенияЕИС = ДанныеЕИС.ДанныеПриложенияЕИС;
	
	ДанныеПоДетализации = ДанныеЭлектронногоАктированияЕИС.ДанныеПоДетализации;
	СтрокиДокумента = ДанныеЭлектронногоАктированияЕИС.ДанныеСтрокАктированияЕИС;

	Контракт = ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0].Ссылка;
	ДанныеКонтракта = ЭлектронноеАктированиеЕИС.ДанныеГосударственногоКонтракта(Контракт);
	СпособМаксимальнаяЦена = ЭлектронноеАктированиеЕИС.СпособУказанияЦеныМаксимальнаяЦена();

	СтрокаДокумента = СтрокиДокумента.Найти(ИдентификаторСтрокиГосконтрактаЕИС, "ИдентификаторСтроки");
	Если НЕ ЗначениеЗаполнено(СтрокаДокумента) Тогда
		Шаблон = НСтр("ru='Не найдена строка госконтракта по идентификатору строки документа %1. 
		|Следует перезаполнить документ ""Счет-фактура выданный"" по ссылке ""Заполнить на основании документа"" на закладке ""Документы-основания"".'");
		ТекстОшибки = СтрШаблон(Шаблон, ИдентификаторСтрокиГосконтрактаЕИС);
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	// Замена кода товара в УПД на данные из контракта.
	НоваяСтрокаЭД.Код = СтрокаДокумента.КодТовараДляЕИС;
	
	РеквизитыКонтракта = "Организация";
	СтруктураДанныхКонтракта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контракт, РеквизитыКонтракта);
	Если ЗаполнятьДляЕИСВУПДПоставщикаНаименованиеТРУПоГосконтракту(СтруктураДанныхКонтракта.Организация) Тогда
		НоваяСтрокаЭД.Наименование = СтрокаДокумента.Наименование;
	КонецЕсли;	
	
	Если НоваяСтрокаЭД.Количество = 0 Тогда
		Количество = 1;
	Иначе
		Количество = НоваяСтрокаЭД.Количество;
	КонецЕсли;

	Если (ДанныеКонтракта.ИнформацияОЦенах.СпособУказанияЦены = СпособМаксимальнаяЦена
		И ЗначениеЗаполнено(ДанныеКонтракта.ИнформацияОЦенах.ФормулаЦены)
		И ЭтоОбъектЗакупкиСВозможностьюКорректировкиЦены(СтрокаДокумента))
		Или СтрокаДокумента.Количество = 0 Тогда
		
		ЦенаСНДС = Окр(НоваяСтрокаЭД.СтоимостьСНалогом / Количество, 11);
	Иначе
		// Твердая цена контракта.
		ЦенаСНДС = СтрокаДокумента.Цена;
		
		Если Не ЗначениеЗаполнено(ЦенаСНДС) Тогда
			ЦенаСНДС = 0;
		КонецЕсли;	
	КонецЕсли;
	
	СтавкаНДС = ЭлектронныеДокументыБГУ.ПолучитьСтавкуНДСЧислом(НоваяСтрокаЭД.НалоговаяСтавка);
	
	// Цена за единицу измерения (без НДС) указывается с точностью до 11 цифр.
	// Описание методики расчета приведено в комментариях к РДИК_0210.
	ЦенаБезНДС = Окр(ЦенаСНДС / (1 + СтавкаНДС), 11);
	
	НоваяСтрокаЭД.Цена = ЦенаБезНДС;
	
	ИдентификаторДляАктированияЕИС = СтрокаДокумента.ИдентификаторДляАктированияЕИС;
	СтрокаДетализации = ДанныеПоДетализации[ИдентификаторДляАктированияЕИС];
	ЕстьДетализация = СтрокаДетализации.КоличествоСтрок > 1;
	
	ВерсияФорматаВерсииСхем12 = "1.11";
	Если НЕ ЭлектронноеАктированиеЕИС.ВерсияФормата() = ВерсияФорматаВерсииСхем12 Тогда
		// С 13 версии схем детализация не используется.
		ЕстьДетализация = Ложь;
	КонецЕсли;
	
	// Определяем вид ТРУ.
	ВидТРУ = ЭлектронноеАктированиеЕИС.ОпределитьВидТРУДляУПД(СтрокаДокумента.Тип);
	ЭтоРаботаИлиУслуга = СтрокаДокумента.ЭтоРаботаИлиУслуга;
	// Устанавливаем признак в строке УПД.
	НоваяСтрокаЭД.Признак = Строка(ВидТРУ);
	
	Если ЕстьДетализация Тогда
		Если НЕ ЗначениеЗаполнено(СтрокаДетализации.ДанныеРодителя) Тогда
			// создаем родителя
		КонецЕсли;
	Иначе
		
		// Без детализации.
		СтрокаПриложения = ЭлектронноеАктированиеЕИС.НовыеНедетализированныеСведенияОТРУ();
		СтрокаПриложения.Идентификатор = ИдентификаторДляАктированияЕИС;
		СтрокаПриложения.НомерСтрокиТаблицы = ОбщиеПараметры.ДополнительныеПараметры.НомерСтроки;
		СтрокаПриложения.ИдентификаторПозиции = СтрЗаменить(ИдентификаторСтрокиГосконтрактаЕИС, "-", "");
		Если ЭтоРаботаИлиУслуга Тогда
			Если ЗначениеЗаполнено(СтрокаДокумента.ОбъемРаботыУслуги) Тогда
				// Количество указывается в текстовом выражении.
				СтрокаПриложения.ОбъемВТекстовомВыражении = СтрокаДокумента.ОбъемВТекстовомВыражении;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаПриложения.ЦенаИзКонтрактаСНДС = ЦенаСНДС;
		СтрокаПриложения.ИсходноеНаименование = СтрокаДокумента.Наименование;
		
		СтрокаПриложения.ТехническийИдентификатор = СтрокаДокумента.ВнутреннийИдентификаторЕИС;
		СтрокаПриложения.ВнешнийТехническийИдентификатор = СтрокаДокумента.ВнешнийИдентификатор;
		
		Если НЕ ЭтоРаботаИлиУслуга Тогда
			СтранаПроисхождения = СтрокаДокумента.СтранаПроисхожденияКонтракт;
			Если ЗначениеЗаполнено(СтранаПроисхождения) Тогда
				ДанныеСтраныПроисхождения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтранаПроисхождения, "Код, Наименование");
				СтрокаПриложения.КодСтраныПроисхождения = ДанныеСтраныПроисхождения.Код;
				СтрокаПриложения.НаименованиеСтраныПроисхождения = ДанныеСтраныПроисхождения.Наименование;
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаДокумента.СтранаПроизводителя) Тогда
				СтранаПроизводителя = СтрокаДокумента.СтранаПроизводителя;
			Иначе	
				СтранаПроизводителя = СтрокаДокумента.СтранаПроизводителяКонтракт;
			КонецЕсли;
			Если ЗначениеЗаполнено(СтранаПроизводителя) Тогда
				ДанныеСтраныПроизводителя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтранаПроизводителя, "Код, Наименование");
				СтрокаПриложения.КодСтраныПроизводителя = ДанныеСтраныПроизводителя.Код;
				СтрокаПриложения.НаименованиеСтраныПроизводителя = ДанныеСтраныПроизводителя.Наименование;
			КонецЕсли;
			
			ИдентификаторМестаПоставкиЕИС = "";
			Если ДанныеПриложенияЕИС.МестаПоставки.Количество() > 0 Тогда
				ИдентификаторМестаПоставкиЕИС = ДанныеПриложенияЕИС.МестаПоставки[0].Идентификатор;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрокаЭД.ИдентификаторМестаПоставкиЕИС) Тогда
				НоваяСтрокаЭД.ИдентификаторМестаПоставкиЕИС = ИдентификаторМестаПоставкиЕИС;
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(НоваяСтрокаЭД.ИдентификаторМестаПоставкиЕИС) Тогда
				МестоПоставки = ЭлектронноеАктированиеЕИС.НовыеСведенияОМестеПоставкиТоварнойПозиции();
				МестоПоставки.Идентификатор = НоваяСтрокаЭД.ИдентификаторМестаПоставкиЕИС;
				МестоПоставки.ПоставляемоеКоличество = НоваяСтрокаЭД.Количество; 
				СтрокаПриложения.СведенияОМестахПоставкиТовара.Добавить(МестоПоставки);
			КонецЕсли;	
			
		КонецЕсли;
		
		// Признак поставки объекта закупки с улучшенными характеристиками:
		// - 1 - не установлен;
		// - 2 - установлен из информации о контракте;
		// - 3 - установлен пользователем.
		// Игнорируется для авансовых СЧФ.
		// Игнорируется при приеме исправления к документу, который был подписан до версии 11.2.
		// В других случаях контролируется обязательное заполнение.
		// Если для позиции ТРУ в сведениях о контракте установлен одноименный признак, то контролируется, что в составе данного атрибута указано значение "2 - установлен из информации о контракте".
		// Если для позиции ТРУ в сведениях о контракте НЕ установлен одноименный признак, то контролируется, что в составе данного атрибута указано значение, отличное от "2 - установлен из информации о контракте".
		// В исправлении редактирование данного признака допускается только в том случае, если:
		// - статус документа, к которому формируется исправление - «Отказано при рассмотрении»
		// - в сведениях о контракте для данной позиции не установлен признак поставки объекта закупки с улучшенными характеристиками.
		СтрокаПриложения.ПризнакПоставкиОбъектаЗакупкиСУлучшеннымиХарактеристиками = 1;
		ДанныеПриложенияЕИС.СведенияОТоварах.ТоварыРаботыУслуги.Добавить(СтрокаПриложения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДереваДляЭлектронногоАктированияЕИСУПД_5_03(ОбщиеПараметры) Экспорт
	
	Перем ДанныеДляЭДПродавцаДляГосНужд;
	
	ДеревоДанных						= ОбщиеПараметры.ДеревоЭД;
	ДанныеЭлектронногоАктированияЕИС	= ОбщиеПараметры.ДопДанныеДокумента.ДанныеЕИС.ДанныеЭлектронногоАктирования;
	ВыборкаШапки						= ОбщиеПараметры.ДанныеДокумента.Шапка;
	ДанныеПриложенияЕИС					= ОбщиеПараметры.ДопДанныеДокумента.ДанныеЕИС.ДанныеПриложенияЕИС;
	ДокументРеализации					= ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи.ПервичныйДокументПередачи.Ссылка;	
	
	ТаблицаПродавцов = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, "СведенияОСчетеФактуре.СведенияОПродавцах");
	
	Если ТаблицаПродавцов.Количество() > 0 Тогда
		ДанныеПриложенияЕИС.НаименованиеОрганизацииПоставщика = ТаблицаПродавцов[0].Продавец.ТипУчастника.ЮЛ.НаименованиеОрганизации;
	КонецЕсли;
	
	// Заполнение банковских или казначейских реквизитов
	
	Если ЗначениеЗаполнено(ДокументРеализации) Тогда
		
		КодОКТМО = "";
		Если ЗначениеЗаполнено(ВыборкаШапки.Организация) Тогда
			СтруктураДанныхОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаШапки.Организация, "КодОКТМО");
			КодОКТМО = СокрЛП(СтруктураДанныхОрганизации.КодОКТМО);
		КонецЕсли;	
		
		СтруктураДанныхПоставщика = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРеализации, "РеквизитыЛицевогоСчета, РасчетныйСчетКонтрагента, Контрагент, Договор");
		Если ЗначениеЗаполнено(СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета) Тогда
			ДанныеДляЭДПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ДанныеДляЭДПродавцаДляГосНужд(ДокументРеализации);
			
			СтруктураДанныхРеквизитыЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета, "КассовыйОрган");
			
			ЛицевойСчет = СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета.Владелец;
			
			СтруктураДанныхЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛицевойСчет, "Код");
			НомерЛицевогоСчета = СокрЛП(СтруктураДанныхЛицевогоСчета.Код);
			
			РасчетныеРеквизиты = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета, РасчетныеРеквизиты);
			
			ТребуетсяКазначейскоеСопровождение = Ложь;
			Если ЗначениеЗаполнено(СтруктураДанныхПоставщика.Договор) Тогда
				ГосударственныйКонтрактЕИС = ЭлектронноеАктированиеЕИС.НайтиГосударственныйКонтрактПоВладельцу(СтруктураДанныхПоставщика.Договор);
				Если ЗначениеЗаполнено(ГосударственныйКонтрактЕИС) Тогда
					СтруктураДанныхГосКонтракта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ГосударственныйКонтрактЕИС,
						"ТребуетсяКазначейскоеСопровождение");
					ТребуетсяКазначейскоеСопровождение = СтруктураДанныхГосКонтракта.ТребуетсяКазначейскоеСопровождение;
				КонецЕсли;
			КонецЕсли;
			
			ДанныеПриложенияЕИС.БанковскиеРеквизиты = ЭлектронноеАктированиеЕИС.НовыеБанковскиеРеквизитыДляПриложения();
			Если ТипЗнч(СтруктураДанныхРеквизитыЛицевогоСчета.КассовыйОрган) = Тип("СправочникСсылка.Казначейства") Тогда
				СтруктураДанныхКазначейства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанныхРеквизитыЛицевогоСчета.КассовыйОрган, "КазначействоИлиФО");
				КазначействоИлиФО = СтруктураДанныхКазначейства.КазначействоИлиФО;
				Если КазначействоИлиФО = 1 Тогда
					ДанныеПриложенияЕИС.БанковскиеРеквизиты.ТипСчета = ЭлектронноеАктированиеЕИС.ТипСчетаЛицевойСчетВФинансовомОргане();
				Иначе
					ДанныеПриложенияЕИС.БанковскиеРеквизиты.ТипСчета = ЭлектронноеАктированиеЕИС.ТипСчетаЛицевойСчетВТерОрганеКазначейства();
				КонецЕсли;	
				
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.БИК = РасчетныеРеквизиты.БикБанкаПолучателя;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.ЕдиныйКазначейскийСчет = РасчетныеРеквизиты.СчетБанкаПолучателя;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.КазначейскийСчет = РасчетныеРеквизиты.НомерСчетаПолучателя;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.КБК = СокрЛП(ДанныеДляЭДПродавцаДляГосНужд.КодБюджетнойКлассификацииПродавца);
				
				Если ЗначениеЗаполнено(СтруктураДанныхПоставщика.Договор) Тогда
					СтруктураДанныхДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанныхПоставщика.Договор, "УИН");
				    ДанныеПриложенияЕИС.БанковскиеРеквизиты.УИПИлиУИН = СтруктураДанныхДоговора.УИН; 
				КонецЕсли;
				
 				Если НЕ ЗначениеЗаполнено(ДанныеПриложенияЕИС.БанковскиеРеквизиты.УИПИлиУИН) Тогда
					Если ТребуетсяЗаполнитьУИНДляОбменаСЕИС(ВыборкаШапки.Организация, ВыборкаШапки.Договор, ДокументРеализации) Тогда
						ДанныеПриложенияЕИС.БанковскиеРеквизиты.УИПИлиУИН = "0";
					КонецЕсли;
				КонецЕсли;	
				
				Если ЗначениеЗаполнено(КодОКТМО) Тогда
					ДанныеОКТМО = ЭлектронноеАктированиеЕИС.НовыйДанныеОКТМО();
					ДанныеОКТМО.Вставить("Код", КодОКТМО);
					ДанныеПриложенияЕИС.БанковскиеРеквизиты.ОКТМО = ДанныеОКТМО;
				КонецЕсли;
				
				Если ТребуетсяКазначейскоеСопровождение Тогда
					ДанныеПриложенияЕИС.БанковскиеРеквизиты.ЛицевойСчетДляКазначейскогоСопровождения = НомерЛицевогоСчета;
				Иначе	
					ДанныеПриложенияЕИС.БанковскиеРеквизиты.НомерЛицевогоСчета = НомерЛицевогоСчета;
				КонецЕсли;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.НаименованиеБанкаТОФК = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
				
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.НаименованиеКонтрагентаДляПлатежногоПоручения = 
					НаименованиеКонтрагентаДляПлатежногоПоручения(ВыборкаШапки.Организация, СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета);
			ИначеЕсли ТипЗнч(СтруктураДанныхРеквизитыЛицевогоСчета.КассовыйОрган) = Тип("СправочникСсылка.Банки") Тогда
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.ТипСчета = ЭлектронноеАктированиеЕИС.ТипСчетаРасчетныйСчет();
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.БИК = РасчетныеРеквизиты.БикБанкаПолучателя;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.КорреспондентскийСчетБанка = РасчетныеРеквизиты.СчетБанкаПолучателя;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.РасчетныйСчет = РасчетныеРеквизиты.НомерСчетаПолучателя;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.НаименованиеБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;

				ДанныеПриложенияЕИС.БанковскиеРеквизиты.НаименованиеКонтрагентаДляПлатежногоПоручения = 
					НаименованиеКонтрагентаДляПлатежногоПоручения(ВыборкаШапки.Организация, СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
		
	ТаблицаПодписанты = Новый ТаблицаЗначений;
	ТаблицаПодписанты.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ТаблицаПодписанты.Колонки.Добавить("ОбластьПолномочий", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("ОснованиеПолномочий", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("Должность", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("Фамилия", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("Отчество", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("ТипПодписанта", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыПодписантовЕИС"));
	
	ПодписантыЕИС = ДанныеЭлектронногоАктированияЕИС.ПодписантыДокументовЕИС;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.ДанныеБД",
		ДанныеЭлектронногоАктированияЕИС);
		
	Если ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта.Количество() = 0 Тогда
		ОписаниеОшибки = НСтр("ru = 'Не заполнены данные для электронного актирования в форме документа.'");
		ВызватьИсключение(ОписаниеОшибки);
	КонецЕсли;
	
	ПорядковыйНомерРуководителяОрганизации = 1;
	
	// Номер строки указывается в атрибуте ИныеСвед.
	// в дальнейшем используется для заполнения приложений для ЕИС.
	Если ПодписантыЕИС.Количество() > 0 Тогда
		Подписант = ПодписантыЕИС[0];
		
		Строка = ТаблицаПодписанты.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Подписант);
		
		Строка.Статус = "1";
		//Если ЭтоУКД Тогда
		//	Строка.ОбластьПолномочий = "6";
		//Иначе
			Строка.ОбластьПолномочий = "5";
		//КонецЕсли;
		Строка.ОснованиеПолномочий = "Должностные обязанности";
		Строка.НомерСтроки = 1;
		Если ВРЕГ(Подписант.Должность) = ВРЕГ("Руководитель")
			ИЛИ ВРЕГ(Подписант.Должность) = ВРЕГ("Генеральный директор")
			ИЛИ ПодписантыЕИС.Количество() = 1 Тогда
			ПорядковыйНомерРуководителяОрганизации = 1;
		КонецЕсли;
		
		ПодписантЕИС = Новый Структура;
		ПодписантЕИС.Вставить("ЛогинПрод", Подписант.Идентификатор);
		ПодписантЕИС.Вставить("ПорядНом", 1);
		ДанныеПриложенияЕИС.Подписант = ПодписантЕИС;
	КонецЕсли;
	
	ДанныеПриложенияЕИС.ПорядковыйНомерРуководителяОрганизации = ПорядковыйНомерРуководителяОрганизации;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.Подписанты", ТаблицаПодписанты);
	
	ДанныеПриложенияЕИС.ДокументОснование = ВыборкаШапки.ДокументОснование;
	//Если ЭтоУКД Тогда
	//	ДанныеПриложенияЕИС.ДокументОснование = ДанныеЭлектронногоАктированияЕИС.ДокументОснованиеРеализацияДляЕИС;
	//КонецЕсли;	
	
	ДанныеПриложенияЕИС.Контрагент = ВыборкаШапки.Контрагент;
	
	ДанныеКонтракта = ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0];
	ДанныеПриложенияЕИС.ДоговорКонтрагента = ДанныеКонтракта.ДоговорКонтрагента;
	
	ИдентификаторУчастника = "0";
	Если НЕ ТипЗнч(ВыборкаШапки.Ссылка) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		Если НЕ ЗначениеЗаполнено(ВыборкаШапки.Грузополучатель) ИЛИ ВыборкаШапки.Грузополучатель = ВыборкаШапки.Контрагент Тогда
			ИдентификаторУчастника = ЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаПокупателя();
		Иначе
			ИдентификаторУчастника = ЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаГрузополучателя();
		КонецЕсли;	
	КонецЕсли;
	
	ЗаполнитьДанныеПриложенияУПД_5_03(ИдентификаторУчастника, ОбщиеПараметры);
	//Если ЭтоУКД Тогда
	//	ЗаполнитьДанныеПриложенияУКД(
	//		ДанныеЭлектронногоАктированияЕИС,
	//		ДанныеПриложенияЕИС);
	//КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения",
		ДанныеПриложенияЕИС);
	
	// Информация продавца об обстоятельствах закупок для государственных и муниципальных нужд.
	ЗакупкаДляГосударственныхНужд = Новый Структура;
	ЗакупкаДляГосударственныхНужд.Вставить("ДатаКонтракта", ДанныеКонтракта.ДатаЗаключенияКонтракта);
	ЗакупкаДляГосударственныхНужд.Вставить("НомерКонтракта", ДанныеКонтракта.Номер);
	Для каждого КлючЗначение Из ЗакупкаДляГосударственныхНужд Цикл
		Если ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
			Путь = "СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.СведенияОГосКонтракте." + КлючЗначение.Ключ;
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	// Заполнение идентификатора государственного контракта.
	// Идентификатор заполняется только для гос.оборон заказа.
	СвойстваГОЗ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеКонтракта.Ссылка, "ЭтоКонтрактГОЗ,НомерГОЗ");
	НомерГОЗ = СвойстваГОЗ.НомерГОЗ;
	ЭтоГОЗ = СвойстваГОЗ.ЭтоКонтрактГОЗ;
	Если ЭтоГОЗ И ЗначениеЗаполнено(НомерГОЗ) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта",
			НомерГОЗ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеДляУПДИнформацииПокупателяЕИСУПД_5_03(Основания, ДеревоДанных, Отказ) Экспорт
	
	РезультатРассмотрения = Основания[0];
	
	ДатаПолученияТоваров = РезультатРассмотрения.Дата;
	СодержаниеОперации   = "-";
	КодИтога = "1";
	
	ДанныеПриложения = ДанныеПриложенияУПДЗаказчика(РезультатРассмотрения);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		ДеревоДанных, "ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения", ДанныеПриложения);
		
	ДанныеТитулаПокупателя = ДанныеТитулаПокупателяЭД(РезультатРассмотрения);
	
	Если ДанныеТитулаПокупателя = Неопределено Тогда
		Отказ = Истина;
		
		ТекстСообщения  = НСтр("ru='Для заполнения титула покупателя УПД требуется на основании документа ""Документ о приемке из ЕИС"" 
		|ввести, заполнить, записать и провести документ ""Результаты рассмотрения документа о приемке из ЕИС"".'");
		Сообщение       = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	ОрганизацияСоставитель = ДанныеТитулаПокупателя.Организация;
	СведенияОПокупателе = Новый Структура;
	Если ЗначениеЗаполнено(ОрганизацияСоставитель) Тогда
		ЭлектронныеДокументыБГУ.ПолучитьДанныеЮрФизЛица(ОрганизацияСоставитель, СведенияОПокупателе);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СведенияОПокупателе.ПолноеНаименование);
	КонецЕсли;
	
	ДатаПолученияТоваров = ДанныеТитулаПокупателя.ДатаПолученияТРУ;
	СодержаниеОперации = СокрЛП(ДанныеТитулаПокупателя.СодержаниеОперации);
	КодИтога = СокрЛП(ДанныеТитулаПокупателя.ИтогПриемки);
	
	НачалоПути = "СодержаниеФХЖ.СведенияОПринятииТоваров";
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПути + ".ДатаПолученияТоваров", ДатаПолученияТоваров);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПути + ".СодержаниеОперации", СодержаниеОперации);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПути + ".КодИтога", КодИтога);
	
	Если ДанныеТитулаПокупателя.ДокументОРасхожденияхВид > 1 Тогда
		Путь = НачалоПути + ".ДокументОРасхождениях";
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".НаименованиеДокумента", ДанныеТитулаПокупателя.ДокументОРасхожденияхНаименование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".НомерДокумента", ДанныеТитулаПокупателя.ДокументОРасхожденияхНомер);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ДатаДокумента", ДанныеТитулаПокупателя.ДокументОРасхожденияхДата);
	КонецЕсли;
	
	ПринялТРУ = ДанныеТитулаПокупателя.ПринялТРУ;
	Если ЗначениеЗаполнено(ПринялТРУ) Тогда
		Путь = НачалоПути + ".СведенияОЛицеПринявшемТовары.РаботникОрганизацииПокупателя";
		ДанныеСотрудника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПринялТРУ, "Фамилия,Имя,Отчество,Должность,ОснованиеПолномочий");
		ДанныеПодписанта = ЭлектронноеАктированиеЕИС.ДанныеОПолномочияхПодписантаЗаказчика(ПринялТРУ, "УПД");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".Должность", Строка(ДанныеСотрудника.Должность));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ИныеСведения", ДанныеТитулаПокупателя.ПринялТРУИныеСведения);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ФИО.Фамилия", ДанныеСотрудника.Фамилия);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ФИО.Имя", ДанныеСотрудника.Имя);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ФИО.Отчество", ДанныеСотрудника.Отчество);
	Иначе
		Отказ = Истина;
		
		ТекстСообщения  = НСтр("ru='Для заполнения титула покупателя УПД требуется в документе ""Результаты рассмотрения документа о приемке из ЕИС"" 
		|указать сотрудника, который осуществлял приемку товаров, работ, услуг.'");
		Сообщение       = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПодписантовРезультатаРасмотрения(РезультатРассмотрения, ДеревоДанных);
	
КонецПроцедуры	

Процедура ЗаполнитьДанныеУчастникаЕИСУПД_5_03(СтруктураУчастника, ОбозначениеУчастника, ДанныеЛица, ОбщиеПараметры) Экспорт
	
	Если ОбозначениеУчастника = "Покупатель" Тогда
		СтруктураУчастника.ИнформацияДляУчастника = ЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаПокупателя();
		
	ИначеЕсли ОбозначениеУчастника = "Грузополучатель" Тогда
		СтруктураУчастника.ИнформацияДляУчастника = ЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаГрузополучателя();
	КонецЕсли;
	
	Если ОбозначениеУчастника = "Продавец" Тогда
		ПутьЭлементаУчастника = "СведенияОСчетеФактуре.СведенияОПокупателях.НомерСтроки.Продавец";
		
		ИмяПоляСтороны = "ПолноеНаименованиеПоставщика";
		
	ИначеЕсли ОбозначениеУчастника = "Покупатель" Тогда
		ПутьЭлементаУчастника = "СведенияОСчетеФактуре.СведенияОПокупателях.НомерСтроки.Покупатель";
		
		ИмяПоляСтороны = "ПолноеНаименованиеЗаказчика";
	Иначе
		Возврат;
	КонецЕсли;
	
	ДанныеГосконтракта = ОбщиеПараметры.ДопДанныеДокумента.ДанныеЕИС.ДанныеЭлектронногоАктирования.ДанныеГосконтракта[0];
	
	ПолноеНаименованиеСтороны = ДанныеГосконтракта[ИмяПоляСтороны];
	
	Если ЗначениеЗаполнено(ПолноеНаименованиеСтороны) Тогда
		Если СтруктураУчастника.ТипУчастника.Свойство("ИП") Тогда
			СтруктураУчастника.ТипУчастника.ИП.ФИО = ПолноеНаименованиеСтороны;
			
		ИначеЕсли СтруктураУчастника.ТипУчастника.Свойство("ЮЛ") Тогда
			СтруктураУчастника.ТипУчастника.ЮЛ.НаименованиеОрганизации = ПолноеНаименованиеСтороны;
			
		ИначеЕсли СтруктураУчастника.ТипУчастника.Свойство("ИЛ") Тогда
			СтруктураУчастника.ТипУчастника.ИЛ.НаименованиеОрганизации = ПолноеНаименованиеСтороны;
			
		ИначеЕсли СтруктураУчастника.ТипУчастника.Свойство("ФЛ") Тогда
			СтруктураУчастника.ТипУчастника.ФЛ.ФИО = ПолноеНаименованиеСтороны;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура ЗаполнитьДанныеПоСтрокеТоваровУКД(НоваяСтрокаЭД, СтрокаВыборки, ДанныеЭлектронногоАктирования, ДанныеПриложенияЕИС) Экспорт
	
	ДанныеЭлектронногоАктированияЕИС = ДанныеЭлектронногоАктирования;
	
	ДанныеПоДетализации = ДанныеЭлектронногоАктированияЕИС.ДанныеПоДетализации;
	СтрокиДокумента = ДанныеЭлектронногоАктированияЕИС.ДанныеСтрокАктированияЕИС;
	
	ИдентификаторСтроки = НоваяСтрокаЭД.ИдентификаторСтроки;
	СтрокаДокумента = СтрокиДокумента.Найти(ИдентификаторСтроки, "ИдентификаторСтроки");
	Если НЕ ЗначениеЗаполнено(СтрокаДокумента) Тогда
		Шаблон = НСтр("ru='Не найдена строка госконтракта по идентификатору строки документа %1.'");
		ТекстОшибки = СтрШаблон(Шаблон, ИдентификаторСтроки);
		ВызватьИсключение(ТекстОшибки);
	КонецЕсли;
	
	// Замена цены на цену из контракта с точностью до 11 знаков.
	НоваяСтрокаЭД.ЦенаЗаЕдиницуИзмерения = СтрокаДокумента.ЦенаЗаЕдиницуИзмерения;
	НоваяСтрокаЭД.ЦенаЗаЕдиницуИзмеренияДоКорректировки = СтрокаДокумента.ЦенаЗаЕдиницуИзмерения;

	Контракт = ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0].Ссылка;
	РеквизитыКонтракта = "Организация";
	СтруктураДанныхКонтракта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контракт, РеквизитыКонтракта);
	Если ЗаполнятьДляЕИСВУПДПоставщикаНаименованиеТРУПоГосконтракту(СтруктураДанныхКонтракта.Организация) Тогда
		НоваяСтрокаЭД.ТоварНаименование = СтрокаДокумента.Наименование;
	КонецЕсли;	

	ИдентификаторДляАктированияЕИС = СтрокаДокумента.ИдентификаторДляАктированияЕИС;
	СтрокаДетализации = ДанныеПоДетализации[ИдентификаторДляАктированияЕИС];
	ЕстьДетализация = СтрокаДетализации.КоличествоСтрок > 1;
	
	// Определяем вид ТРУ.
	ВидТРУ = ЭлектронноеАктированиеЕИС.ОпределитьВидТРУДляУПД(СтрокаДокумента.Тип);
	ЭтоРаботаИлиУслуга = СтрокаДокумента.ЭтоРаботаИлиУслуга;
	
	СтрокаПриложения = ЭлектронноеАктированиеЕИС.НовыеСведенияОТРУДляУКД();
	СтрокаПриложения.НомерСтрокиТаблицы = НоваяСтрокаЭД.НомерСтроки;
	
	СтрокаПриложения.ЦенаСНДСДоИзменения =
		НоваяСтрокаЭД.СтоимостьТоваровСНалогом / НоваяСтрокаЭД.Количество;
	СтрокаПриложения.ЦенаСНДСПослеИзменения =
		НоваяСтрокаЭД.СтоимостьТоваровСНалогомДоКорректировки / НоваяСтрокаЭД.КоличествоДоКорректировки;
	СтрокаПриложения.ИсходноеНаименование = СтрокаДокумента.Наименование;
	
	СтрокаПриложения.ВнешнийТехническийИдентификатор = СтрокаДокумента.ВнешнийИдентификатор;
	СтрокаПриложения.Код = СтрокаДокумента.КодТовараДляЕИС;
	СтрокаПриложения.НаименованиеЕдиницыИзмеренияДоИзменения =
		СтрокаВыборки.ЕдиницаИзмеренияНаименованиеПолное;
	СтрокаПриложения.НаименованиеЕдиницыИзмеренияПослеИзменения =
		СтрокаВыборки.ЕдиницаИзмеренияНаименованиеПолное;
	// Для работ и услуг.
	Если ЭтоРаботаИлиУслуга
		И ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0].ЕстьУслугиСУказаниемОбъемаВТекстовомВыражении Тогда
		СтрокаПриложения.ОбъемВТекстовомВыраженииДоИзменения =
			СтрокаДокумента.ОбъемВТекстовомВыраженииДоИзменения;
		СтрокаПриложения.ОбъемВТекстовомВыраженииПослеИзменения =
			СтрокаДокумента.ОбъемВТекстовомВыражении;
	КонецЕсли;
	
	Если ЕстьДетализация Тогда
		Если НЕ ЗначениеЗаполнено(СтрокаДетализации.ДанныеРодителя) Тогда
			// создаем родителя
		КонецЕсли;
	Иначе
		
		СтрокаПриложения.Идентификатор = ИдентификаторДляАктированияЕИС;
		
	КонецЕсли;
	
	ДанныеПриложенияЕИС.СведенияОТоварах.ТоварыРаботыУслуги.Добавить(СтрокаПриложения);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПриложенияУКД(ДанныеЭлектронногоАктированияЕИС, ДанныеПриложенияЕИС) Экспорт
	
	Если ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта.Количество() = 0 Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнены данные государственного контракта для электронного актирования.'");
		ВызватьИсключение(ОписаниеОшибки);
	Иначе
		ДанныеПриложенияЕИС.ГосударственныйКонтракт =
			ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0].Ссылка;
	КонецЕсли;
	
	ЭлектронноеАктированиеЕИС.ДобавитьДвоичныеВложенияПриложенияДляЕИС(
		ДанныеПриложенияЕИС, ДанныеЭлектронногоАктированияЕИС);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПриложенияУПД(ДанныеЭлектронногоАктированияЕИС, ДанныеПриложенияЕИС, ИдентификаторУчастника = "0") Экспорт
	
	СтоимостьТоваровСНалогом = 0;
	ВсегоКОплатеСуммаНалога = 0;
	
	ЭтоВалютныйКонтракт = Ложь;
	НоминалКурсаВалюты = 1;
	
	Если ЭтоВалютныйКонтракт Тогда
		// Заполняется, если валюта УПД не совпадает с валютой контракта.
		ДанныеПриложенияЕИС.СведенияОТоварах.СтоимостьТоваровСНалогом = СтоимостьТоваровСНалогом;
		ДанныеПриложенияЕИС.СведенияОТоварах.ВсегоКОплатеСуммаНалога = ВсегоКОплатеСуммаНалога;
		//В схемах 11.1 аннотации и описания атрибутов и тэгов будут скорректированы
		//В случае, если валюта документа - Российский Рубль, игнорирование атрибута НоминалКурсВал при загрузке правомерно.
		ДанныеПриложенияЕИС.СведенияОТоварах.НоминалКурсаВалюты = НоминалКурсаВалюты;
	КонецЕсли;

	Если ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта.Количество() = 0 Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнены данные государственного контракта для электронного актирования.'");
		ВызватьИсключение(ОписаниеОшибки);
	Иначе
		ДанныеПриложенияЕИС.ГосударственныйКонтракт =
			ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0].Ссылка;
	КонецЕсли;
	
	ЭлектронноеАктированиеЕИС.ДобавитьДвоичныеВложенияПриложенияДляЕИС(
		ДанныеПриложенияЕИС, ДанныеЭлектронногоАктированияЕИС);
	
	Для Каждого МестоПоставки Из ДанныеЭлектронногоАктированияЕИС.МестаПоставкиДокументовДляЕИС Цикл
		Место = ЭлектронноеАктированиеЕИС.НовыеСведенияОМестеПоставкиТовара();
		МестоJSON = МестоПоставки.ДанныеМеста;
		ЗаполнитьЗначенияСвойств(Место, МестоПоставки);
		КодыАдреса = АдресныйКлассификатор.КодыАдреса(МестоJSON);
		Если НЕ ЗначениеЗаполнено(КодыАдреса.КодКЛАДР) Тогда
			КодРегиона = АдресныйКлассификатор.КодРегионаПоНаименованию(МестоПоставки.НаселенныйПункт);
			КодРегиона = Строка(КодРегиона);
			КодыАдреса.КодКЛАДР = ЭлектронноеАктированиеЕИС.КодКЛАДРПроизвольногоАдреса(КодРегиона);
		КонецЕсли;
		Место.Классификатор = ЭлектронноеАктированиеЕИС.МестоПоставкиПоКЛАДР();
		Место.Код = ЭлектронноеАктированиеЕИС.ПреобразоватьКодКладрДляЕИС(
			КодыАдреса.КодКЛАДР);
			
		УИД = Строка(Новый УникальныйИдентификатор);
		Место.Идентификатор = СтрЗаменить(УИД, "-", "");
		Место.ИдентификаторУчастника = ИдентификаторУчастника;
		
		ДанныеПриложенияЕИС.МестаПоставки.Добавить(Место);
	КонецЦикла;
		
КонецПроцедуры

Процедура ЗаполнитьДанныеДереваДляЭлектронногоАктированияЕИС(ДеревоДанных,
		ДанныеЭлектронногоАктированияЕИС,
		ВыборкаШапки,
		ДанныеПриложенияЕИС,
		ЭтоУКД) Экспорт
		
	//Заполнение банковских или казначейских реквизитов
	ДокументРеализации = Документы.АктОбОказанииУслуг.ПустаяСсылка();
	Если ТипЗнч(ВыборкаШапки.Ссылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда	
		ДокументРеализации = ВыборкаШапки.Ссылка.ДокументОснование;
	Иначе
		ДокументРеализации = ВыборкаШапки.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументРеализации) Тогда
		
		КодОКТМО = "";
		Если ЗначениеЗаполнено(ВыборкаШапки.Организация) Тогда
			СтруктураДанныхОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаШапки.Организация, "КодОКТМО");
			КодОКТМО = СокрЛП(СтруктураДанныхОрганизации.КодОКТМО);
		КонецЕсли;	
		
		СтруктураДанныхПоставщика = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРеализации, "РеквизитыЛицевогоСчета, РасчетныйСчетКонтрагента, Контрагент, Договор");
		Если ЗначениеЗаполнено(СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета) Тогда
			ДанныеДляЭДПродавцаДляГосНужд = ЭлектронныеДокументыБГУ.ДанныеДляЭДПродавцаДляГосНужд(ДокументРеализации);
			
			СтруктураДанныхРеквизитыЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета, "КассовыйОрган");
			
			ЛицевойСчет = СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета.Владелец;
			
			СтруктураДанныхЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛицевойСчет, "Код");
			НомерЛицевогоСчета = СокрЛП(СтруктураДанныхЛицевогоСчета.Код);
			
			РасчетныеРеквизиты = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета, РасчетныеРеквизиты);
			
			ТребуетсяКазначейскоеСопровождение = Ложь;
			Если ЗначениеЗаполнено(СтруктураДанныхПоставщика.Договор) Тогда
				ГосударственныйКонтрактЕИС = ЭлектронноеАктированиеЕИС.НайтиГосударственныйКонтрактПоВладельцу(СтруктураДанныхПоставщика.Договор);
				Если ЗначениеЗаполнено(ГосударственныйКонтрактЕИС) Тогда
					СтруктураДанныхГосКонтракта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ГосударственныйКонтрактЕИС,
						"ТребуетсяКазначейскоеСопровождение");
					ТребуетсяКазначейскоеСопровождение = СтруктураДанныхГосКонтракта.ТребуетсяКазначейскоеСопровождение;
				КонецЕсли;
			КонецЕсли;
			
			ДанныеПриложенияЕИС.БанковскиеРеквизиты = ЭлектронноеАктированиеЕИС.НовыеБанковскиеРеквизитыДляПриложения();
			Если ТипЗнч(СтруктураДанныхРеквизитыЛицевогоСчета.КассовыйОрган) = Тип("СправочникСсылка.Казначейства") Тогда
				СтруктураДанныхКазначейства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанныхРеквизитыЛицевогоСчета.КассовыйОрган, "КазначействоИлиФО");
				КазначействоИлиФО = СтруктураДанныхКазначейства.КазначействоИлиФО;
				Если КазначействоИлиФО = 1 Тогда
					ДанныеПриложенияЕИС.БанковскиеРеквизиты.ТипСчета = ЭлектронноеАктированиеЕИС.ТипСчетаЛицевойСчетВФинансовомОргане();
				Иначе
					ДанныеПриложенияЕИС.БанковскиеРеквизиты.ТипСчета = ЭлектронноеАктированиеЕИС.ТипСчетаЛицевойСчетВТерОрганеКазначейства();
				КонецЕсли;	
				
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.БИК = РасчетныеРеквизиты.БикБанкаПолучателя;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.ЕдиныйКазначейскийСчет = РасчетныеРеквизиты.СчетБанкаПолучателя;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.КазначейскийСчет = РасчетныеРеквизиты.НомерСчетаПолучателя;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.КБК = СокрЛП(ДанныеДляЭДПродавцаДляГосНужд.КодБюджетнойКлассификацииПродавца);
				
				Если ЗначениеЗаполнено(СтруктураДанныхПоставщика.Договор) Тогда
					СтруктураДанныхДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанныхПоставщика.Договор, "УИН");
				    ДанныеПриложенияЕИС.БанковскиеРеквизиты.УИПИлиУИН = СтруктураДанныхДоговора.УИН; 
				КонецЕсли;
				
 				Если НЕ ЗначениеЗаполнено(ДанныеПриложенияЕИС.БанковскиеРеквизиты.УИПИлиУИН) Тогда
					Если ТребуетсяЗаполнитьУИНДляОбменаСЕИС(ВыборкаШапки.Организация, ВыборкаШапки.Договор, ДокументРеализации) Тогда
						ДанныеПриложенияЕИС.БанковскиеРеквизиты.УИПИлиУИН = "0";
					КонецЕсли;
				КонецЕсли;	
				
				Если ЗначениеЗаполнено(КодОКТМО) Тогда
					ДанныеОКТМО = ЭлектронноеАктированиеЕИС.НовыйДанныеОКТМО();
					ДанныеОКТМО.Вставить("Код", КодОКТМО);
					ДанныеПриложенияЕИС.БанковскиеРеквизиты.ОКТМО = ДанныеОКТМО;
				КонецЕсли;
				
				Если ТребуетсяКазначейскоеСопровождение Тогда
					ДанныеПриложенияЕИС.БанковскиеРеквизиты.ЛицевойСчетДляКазначейскогоСопровождения = НомерЛицевогоСчета;
				Иначе	
					ДанныеПриложенияЕИС.БанковскиеРеквизиты.НомерЛицевогоСчета = НомерЛицевогоСчета;
				КонецЕсли;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.НаименованиеБанкаТОФК = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
				
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.НаименованиеКонтрагентаДляПлатежногоПоручения = 
					НаименованиеКонтрагентаДляПлатежногоПоручения(ВыборкаШапки.Организация, СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета);
			ИначеЕсли ТипЗнч(СтруктураДанныхРеквизитыЛицевогоСчета.КассовыйОрган) = Тип("СправочникСсылка.Банки") Тогда
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.ТипСчета = ЭлектронноеАктированиеЕИС.ТипСчетаРасчетныйСчет();
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.БИК = РасчетныеРеквизиты.БикБанкаПолучателя;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.КорреспондентскийСчетБанка = РасчетныеРеквизиты.СчетБанкаПолучателя;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.РасчетныйСчет = РасчетныеРеквизиты.НомерСчетаПолучателя;
				ДанныеПриложенияЕИС.БанковскиеРеквизиты.НаименованиеБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;

				ДанныеПриложенияЕИС.БанковскиеРеквизиты.НаименованиеКонтрагентаДляПлатежногоПоручения = 
					НаименованиеКонтрагентаДляПлатежногоПоручения(ВыборкаШапки.Организация, СтруктураДанныхПоставщика.РеквизитыЛицевогоСчета);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
		
	ТаблицаПодписанты = Новый ТаблицаЗначений;
	ТаблицаПодписанты.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ТаблицаПодписанты.Колонки.Добавить("ОбластьПолномочий", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("ОснованиеПолномочий", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("Должность", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("Фамилия", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("Отчество", Новый ОписаниеТипов("Строка"));
	ТаблицаПодписанты.Колонки.Добавить("ТипПодписанта", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыПодписантовЕИС"));
	
	ПодписантыЕИС = ДанныеЭлектронногоАктированияЕИС.ПодписантыДокументовЕИС;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.ДанныеБД",
		ДанныеЭлектронногоАктированияЕИС);
		
	Если ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта.Количество() = 0 Тогда
		ОписаниеОшибки = НСтр("ru = 'Не заполнены данные для электронного актирования в форме документа.'");
		ВызватьИсключение(ОписаниеОшибки);
	КонецЕсли;
	
	// Номер строки указывается в атрибуте ИныеСвед.
	// в дальнейшем используется для заполнения приложений для ЕИС.
	НомерСтроки = 1;
	Для Каждого Подписант Из ПодписантыЕИС Цикл
		Строка = ТаблицаПодписанты.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Подписант);
		Строка.Статус = "1";
		Если ЭтоУКД Тогда
			Строка.ОбластьПолномочий = "6";
		Иначе
			Строка.ОбластьПолномочий = "5";
		КонецЕсли;
		Строка.ОснованиеПолномочий = "Должностные обязанности";
		Строка.НомерСтроки = НомерСтроки;
		Если ВРЕГ(Подписант.Должность) = ВРЕГ("Руководитель")
			ИЛИ ВРЕГ(Подписант.Должность) = ВРЕГ("Генеральный директор")
			ИЛИ ПодписантыЕИС.Количество() = 1 Тогда
			ПорядковыйНомерРуководителяОрганизации = НомерСтроки;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	ДанныеПриложенияЕИС.ПорядковыйНомерРуководителяОрганизации = ПорядковыйНомерРуководителяОрганизации;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.Подписанты", ТаблицаПодписанты);

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.Подписанты",
		ТаблицаПодписанты);
		
	Если ЭтоУКД Тогда
		ДанныеПриложенияЕИС.ДокументОснование = ДанныеЭлектронногоАктированияЕИС.ДокументОснованиеРеализацияДляЕИС;
	Иначе		
		ДанныеПриложенияЕИС.ДокументОснование = ВыборкаШапки.ДокументОснование;
	КонецЕсли;	
	
	ДанныеПриложенияЕИС.Контрагент = ВыборкаШапки.Контрагент;
	
	ДанныеКонтракта = ДанныеЭлектронногоАктированияЕИС.ДанныеГосконтракта[0];
	ДанныеПриложенияЕИС.ДоговорКонтрагента = ДанныеКонтракта.ДоговорКонтрагента;
	
	ИдентификаторУчастника = "0";
	Если НЕ ТипЗнч(ВыборкаШапки.Ссылка) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		Если НЕ ЗначениеЗаполнено(ВыборкаШапки.Грузополучатель) ИЛИ ВыборкаШапки.Грузополучатель = ВыборкаШапки.Контрагент Тогда
			ИдентификаторУчастника = ЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаПокупателя();
		Иначе
			ИдентификаторУчастника = ЭлектронноеАктированиеЕИС.НачальныйИндексИнформацииУчастникаГрузополучателя();
		КонецЕсли;	
	КонецЕсли;
	
	Если ЭтоУКД Тогда
		ЗаполнитьДанныеПриложенияУКД(
			ДанныеЭлектронногоАктированияЕИС,
			ДанныеПриложенияЕИС);
	Иначе
		ЗаполнитьДанныеПриложенияУПД(
			ДанныеЭлектронногоАктированияЕИС,
			ДанныеПриложенияЕИС,
			ИдентификаторУчастника);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения",
		ДанныеПриложенияЕИС);
		
	Если НЕ ЭтоУКД Тогда
		// Информация продавца об обстоятельствах закупок для государственных и муниципальных нужд.
		ЗакупкаДляГосударственныхНужд = Новый Структура;
		ЗакупкаДляГосударственныхНужд.Вставить("ДатаГосКонтракта", ДанныеКонтракта.ДатаЗаключенияКонтракта);
		ЗакупкаДляГосударственныхНужд.Вставить("НомерГосКонтракта", ДанныеКонтракта.Номер);
		Для каждого КлючЗначение Из ЗакупкаДляГосударственныхНужд Цикл
			Если ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
				Путь = "ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд." + КлючЗначение.Ключ;
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь, КлючЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
	
Процедура ДополнитьДанныеШапкиСведениямиОбЭлектронномАктировании(ДанныеШапки, ПараметрыОснования) Экспорт
	
	Если ПараметрыОснования.Свойство("ДанныеЭлектронногоАктирования") Тогда
		ДанныеШапки.Вставить("ДанныеЭлектронногоАктирования",
			ПараметрыОснования.ДанныеЭлектронногоАктирования);
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстЗапросаДанныеДляПечатиСчетовФактур(НомераТаблиц, ИмяДокумента) Экспорт

	НомераТаблиц.Вставить("ДанныеСтрокАктированияЕИС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПодписантыДокументовЕИС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("МестаПоставкиДокументовДляЕИС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПриложенныеФайлыДляЭлектронногоАктированияЕИС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ДанныеГосконтракта", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ДанныеДетализации", НомераТаблиц.Количество());
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ДанныеДляАктированияЕИС.ИдентификаторДляАктированияЕИС,
	|	ДанныеДляАктированияЕИС.СтранаПроизводителя,
	|	ДанныеДляАктированияЕИС.ИдентификаторСтроки,
	|	ДанныеДляАктированияЕИС.ОбъемВТекстовомВыражении,
	|	1 КАК КоличествоСтрок,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Ссылка,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.НомерСтроки,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ВнешнийИдентификатор,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ВнутреннийИдентификаторЕИС,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ЕдиницаИзмерения,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Идентификатор,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.КодТовараДляЕИС,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Количество,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Наименование,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ОбъемРаботыУслуги,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.СтавкаНДС,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.СтранаПроизводителя КАК СтранаПроизводителяКонтракт,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.СтранаПроисхождения КАК СтранаПроисхожденияКонтракт,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Сумма,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Тип,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Цена,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ЭтоЛекарственныйПрепарат,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ЭтоМедицинскоеИзделие,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ЭтоРаботаИлиУслуга,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.СуммаНДС,
	|	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ЦенаЗаЕдиницуИзмерения
	|ИЗ
	|	Документ.#ИмяДокумента.ДанныеДляАктированияЕИС КАК ДанныеДляАктированияЕИС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГосударственныеКонтрактыЕИС.ОбъектыЗакупки КАК ГосударственныеКонтрактыЕИСОбъектыЗакупки
	|		ПО ДанныеДляАктированияЕИС.ИдентификаторДляАктированияЕИС = ГосударственныеКонтрактыЕИСОбъектыЗакупки.Идентификатор
	|		И
	|			ДанныеДляАктированияЕИС.Ссылка.Договор = ГосударственныеКонтрактыЕИСОбъектыЗакупки.Ссылка.ВладелецКонтракта
	|ГДЕ
	|	ДанныеДляАктированияЕИС.Ссылка = &ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодписантыОрганизацийЕИС.ОбластьПолномочий КАК ОбластьПолномочий,
	|	ПодписантыОрганизацийЕИС.ОснованиеПолномочий КАК ОснованиеПолномочий,
	|	ПодписантыОрганизацийЕИС.Фамилия КАК Фамилия,
	|	ПодписантыОрганизацийЕИС.Имя КАК Имя,
	|	ПодписантыОрганизацийЕИС.Отчество КАК Отчество,
	|	ПодписантыОрганизацийЕИС.ИНН КАК ИНН,
	|	ПодписантыОрганизацийЕИС.Должность КАК Должность,
	|	ПодписантыДокументовЕИС.Статус КАК Статус,
	|	ПодписантыОрганизацийЕИС.ТипПодписанта КАК ТипПодписанта,
	|	ПодписантыОрганизацийЕИС.ПолноеНаименованиеОрганизации КАК ПодписантПолноеНаименованиеОрганизации,
	|	ПодписантыДокументовЕИС.ОбластьПолномочий КАК ОбластьПолномочийДокумент,
	|	ПодписантыДокументовЕИС.ОснованиеПолномочий КАК ОснованиеПолномочийДокумент,
	|	ПодписантыДокументовЕИС.Организация КАК Организация,
	|	ПодписантыОрганизацийЕИС.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ПодписантыДокументовЕИС КАК ПодписантыДокументовЕИС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодписантыОрганизацийЕИС КАК ПодписантыОрганизацийЕИС
	|		ПО (ПодписантыДокументовЕИС.Подписант = ПодписантыОрганизацийЕИС.Ссылка)
	|ГДЕ
	|	ПодписантыДокументовЕИС.Подписант.Актуален = ИСТИНА
	|	И ПодписантыДокументовЕИС.Подписант.ПометкаУдаления = ЛОЖЬ
	|	И ПодписантыДокументовЕИС.Документ = &ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МестаПоставкиДокументовДляЕИС.Организация,
