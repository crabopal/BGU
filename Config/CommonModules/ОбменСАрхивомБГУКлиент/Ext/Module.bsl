#Область ОткрытиеФорм

Процедура ОткрытьФормуСпискаПакетыДокументовДля1САрхива() Экспорт

	ПараметрыФормы = Новый Структура;
	ОткрытьФорму("Справочник.ПакетыДокументовДля1САрхива.Форма.ФормаСписка", ПараметрыФормы, , , , , );

КонецПроцедуры	

// См. ОбменСАрхивомКлиентПереопределяемый.ПродолжитьВыполнениеКомандыПослеПодтверждения.
Процедура ПродолжитьВыполнениеКомандыПослеПодтверждения(
			ДополнительныеПараметры, СтандартнаяОбработка) Экспорт
			
	Если ДополнительныеПараметры.Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
		СтандартнаяОбработка = Ложь;
		ИмяКомандыСервер = Неопределено;
		Если Не ДополнительныеПараметры.Команда.ДополнительныеПараметры.Свойство("ИмяКомандыСервер", ИмяКомандыСервер) = Неопределено Тогда
			Результат = Новый Структура;
			СерверныйКонтекст = Новый Структура;
			СерверныйКонтекст.Вставить("ПараметрКоманды", ДополнительныеПараметры.Ссылка);
			СерверныйКонтекст.Вставить("ИмяКомандыВФорме", ИмяКомандыСервер);
			СерверныйКонтекст.Вставить("Результат", Результат);
			
			ИмяКомандыОтправитьВ1САрхив = "";
			Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтеграцияС1САрхивом") Тогда
				МодульОбменСАрхивомКлиентСервер = ОбщегоНазначенияКлиент.ОбщийМодуль("ОбменСАрхивомКлиентСервер");
				ИмяКомандыОтправитьВ1САрхив = МодульОбменСАрхивомКлиентСервер.ИмяКомандыОтправитьВ1САрхив();
			КонецЕсли;
			
			Если ДополнительныеПараметры.Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность"
				И ДополнительныеПараметры.Команда.ДополнительныеПараметры.ИмяКоманды = ИмяКомандыОтправитьВ1САрхив Тогда
				
				Элементы = ДополнительныеПараметры.Форма.Элементы;
				РегламентированныйОтчет = Элементы.Отчеты.ТекущиеДанные.РегламентированныйОтчет;
				
				Если ТипЗнч(РегламентированныйОтчет) = Тип("ДокументСсылка.РегламентированныйОтчет")
					И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДополнительныеПараметры.Форма, "АдресБланкаPDFВоВременномХранилище")
					И ТипЗнч(ДополнительныеПараметры.Форма.АдресБланкаPDFВоВременномХранилище) = Тип("СписокЗначений") Тогда
					
					ДополнительныеПараметры.Форма.АдресБланкаPDFВоВременномХранилище.Очистить();
					
					СписокОтчетов = Новый СписокЗначений;
					СписокОтчетов.Добавить(РегламентированныйОтчет);
					
					ДополнительныеПараметрыПечати = Новый Структура;
					ДополнительныеПараметрыПечати.Вставить("АдресБланкаPDFВоВременномХранилище");
					
					РегламентированнаяОтчетностьКлиент.НапечататьОтчеты(СписокОтчетов, "СформироватьБланкPDF", ДополнительныеПараметрыПечати);
					
					Если ТипЗнч(ДополнительныеПараметрыПечати.АдресБланкаPDFВоВременномХранилище) = Тип("Массив") Тогда
						ДополнительныеПараметры.Форма.АдресБланкаPDFВоВременномХранилище.ЗагрузитьЗначения(ДополнительныеПараметрыПечати.АдресБланкаPDFВоВременномХранилище);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ОписаниеОповещения = Новый ОписаниеОповещения("Подключаемый_ПродолжитьВыполнениеКомандыНаСервере", ДополнительныеПараметры.Форма);
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, СерверныйКонтекст);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьКомандуИнтеграцииС1САрхивом(Файлы, ДополнительныеПараметры) Экспорт
	
	Перем ИмяКоманды;
	
	Если Не ОбменСАрхивомБГУВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбменСАрхивомКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ОбменСАрхивомКлиент");
	
	Форма = ДополнительныеПараметры.Форма;
	
	Если ДополнительныеПараметры.ОписаниеКоманды.ДополнительныеПараметры.Свойство("ИмяКоманды", ИмяКоманды) Тогда

		Если ИмяКоманды = "Нажатие" Тогда
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,"ТаблицаДокументовБИА") Тогда
				
				КоличествоДокументов = Форма.ТаблицаДокументовБИА.Количество();
				Если Форма.ТаблицаДокументовБИА.Количество() = 0 Тогда
					Возврат;
				КонецЕсли;
				
				Индекс = КоличествоДокументов-1;
				ИндексСтрокой = Формат(Индекс, "ЧГ=;ЧН=");
				ЭлементДокументаБИА = Форма.Элементы.Найти("ИнформацияДокументаБИА"+ИндексСтрокой);
				Если ЭлементДокументаБИА <> Неопределено Тогда
					МодульОбменСАрхивомКлиент.Нажатие(ЭлементДокументаБИА, Форма);
				КонецЕсли;
				
			ИначеЕсли Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда

				ТекущиеДанные = ДополнительныеПараметры.Источник.ТекущиеДанные;

				ТаблицаДокументовБИА = ОбменСАрхивомБГУВызовСервера.ДокументыБИАРегламентированногоОтчета(ТекущиеДанные);
				Если Не ТаблицаДокументовБИА = Неопределено И Не ТаблицаДокументовБИА.Количество()= 0 Тогда
					ПоказатьЗначение(, ТаблицаДокументовБИА[0].Документ);
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли СтрНачинаетсяС(ИмяКоманды, "СкачатьКонтейнерДокументаИз1САрхива")
			И Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
			
			ДокументБИА = Неопределено;
			ИндексДокументаБИА = Число(СтрЗаменить(ИмяКоманды, "СкачатьКонтейнерДокументаИз1САрхива", ""));

			ТекущиеДанные = ДополнительныеПараметры.Источник.ТекущиеДанные;
			ДокументыБИА = ОбменСАрхивомБГУВызовСервера.ДокументыБИАРегламентированногоОтчета(ТекущиеДанные);

			Если Не ДокументыБИА = Неопределено Тогда
				Если ИндексДокументаБИА < ДокументыБИА.Количество() Тогда
					ДокументБИА = ДокументыБИА[ИндексДокументаБИА].Документ;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДокументБИА) Тогда
				МодульОбменСАрхивомКлиент.СкачатьКонтейнерДокумента(ДокументБИА);
			КонецЕсли;
			
		Иначе
			
			ДополнительныеПараметры.ОписаниеКоманды.Вставить("Имя", ДополнительныеПараметры.ОписаниеКоманды.ДополнительныеПараметры.ИмяКоманды);
			МодульОбменСАрхивомКлиент.ВыполнитьПодключаемуюКоманду(ДополнительныеПараметры.ОписаниеКоманды, ДополнительныеПараметры.Форма, ДополнительныеПараметры.Источник);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

