#Область ПрограммныйИнтерфейс

// Открывает форму полного классификатора, состоящего из нескольких
// справочников.
//
// Параметры:
//  Классификатор - Строка - "КДБ", "ЦСР" или "КИФ".
//
// Возвращаемое значение:
//  УправляемаяФорма. Открытая форма классификатора.
//
Функция ОткрытьФормуКлассификатора(Знач Классификатор, Знач ПараметрыФормы = Неопределено, Знач Владелец = Неопределено, Знач Уникальность = Неопределено, Знач Окно = Неопределено) Экспорт
	
	Если Классификатор = "ВДБ" Тогда
		Возврат ОткрытьФорму("Справочник.ВидыДоходовКДБ.Форма.ПолнаяКлассификация", ПараметрыФормы, Владелец, Уникальность, Окно);	
	ИначеЕсли Классификатор = "ЦСР" Тогда
		Возврат ОткрытьФорму("Справочник.ЦелевыеСтатьиКРБ.Форма.ПолнаяКлассификация", ПараметрыФормы, Владелец, Уникальность, Окно);
	ИначеЕсли Классификатор = "КИФ" Тогда
		Возврат ОткрытьФорму("Справочник.ГруппыПодгруппыКИФ.Форма.ПолнаяКлассификация", ПараметрыФормы, Владелец, Уникальность, Окно);
	Иначе
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неверное значение параметра Классификатор (%1).'"),
			Классификатор);
	КонецЕсли;
	
КонецФункции

#КонецОбласти

