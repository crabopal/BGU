Процедура ЗаполнитьПоляРесурсов(ЭлементНабора, НаборОбъединение, КоллекцияПолейИтогаШаблона, КоллекцияПолейИтогаОбъединение, НаименованиеНабора = "")
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	// Дополним поля шаблона полями ресурсов с префиксом имени запроса в пути
	Для каждого ПолеИтога Из КоллекцияПолейИтогаШаблона Цикл
		
		ПолеСхемы = НаборОбъединение.Поля.Найти(ПолеИтога.ПутьКДанным);
		ПолеСхемы.ОграничениеИспользованияРеквизитов.Группировка = Истина;
		ПолеСхемы.ОграничениеИспользованияРеквизитов.Поле = Истина;
		ПолеСхемы.ОграничениеИспользованияРеквизитов.Порядок = Истина;
		ПолеСхемы.ОграничениеИспользованияРеквизитов.Условие = Истина;
		
		ПолеЭлементаНабора = ЭлементНабора.Поля.Найти(ПолеИтога.ПутьКДанным);
		ПолеЭлементаНабора.ОграничениеИспользованияРеквизитов.Группировка = Истина;
		ПолеЭлементаНабора.ОграничениеИспользованияРеквизитов.Поле = Истина;
		ПолеЭлементаНабора.ОграничениеИспользованияРеквизитов.Порядок = Истина;
		ПолеЭлементаНабора.ОграничениеИспользованияРеквизитов.Условие = Истина;
		
		Если КоллекцияПолейИтогаОбъединение.Найти(ПолеИтога.ПутьКДанным) = Неопределено Тогда
			
			ПолеИтогаСхемы = КоллекцияПолейИтогаОбъединение.Добавить();
			ЗаполнитьЗначенияСвойств(ПолеИтогаСхемы, ПолеИтога);
			
		КонецЕсли;
		
		НовоеПолеЭлементаНабора = ЭлементНабора.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПолеЭлементаНабора.Поле = ПолеИтога.ПутьКДанным;
		НовоеПолеЭлементаНабора.ПутьКДанным = НаименованиеНабора+"_"+ПолеИтога.ПутьКДанным;
		НовоеПолеЭлементаНабора.ТипЗначения = ТипЧисло;
		
		НовоеПолеЭлементаНабора.ОграничениеИспользованияРеквизитов.Группировка = Истина;
		НовоеПолеЭлементаНабора.ОграничениеИспользованияРеквизитов.Поле = Истина;
		НовоеПолеЭлементаНабора.ОграничениеИспользованияРеквизитов.Порядок = Истина;
		НовоеПолеЭлементаНабора.ОграничениеИспользованияРеквизитов.Условие = Истина;
		
		НовоеПолеСхемы = НаборОбъединение.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПолеСхемы.Поле = НовоеПолеЭлементаНабора.ПутьКДанным;
		НовоеПолеСхемы.ПутьКДанным = НаименованиеНабора+"."+ПолеИтога.ПутьКДанным;
		НовоеПолеСхемы.ТипЗначения = ТипЧисло;
		
		НовоеПолеСхемы.ОграничениеИспользованияРеквизитов.Группировка = Истина;
		НовоеПолеСхемы.ОграничениеИспользованияРеквизитов.Поле = Истина;
		НовоеПолеСхемы.ОграничениеИспользованияРеквизитов.Порядок = Истина;
		НовоеПолеСхемы.ОграничениеИспользованияРеквизитов.Условие = Истина;
		
		ПолеИтогаСхемы = КоллекцияПолейИтогаОбъединение.Добавить();
		ПолеИтогаСхемы.Выражение = "Сумма(" + НовоеПолеСхемы.ПутьКДанным + ")";
		ПолеИтогаСхемы.ПутьКДанным = НовоеПолеСхемы.ПутьКДанным;
		
	КонецЦикла;
	
