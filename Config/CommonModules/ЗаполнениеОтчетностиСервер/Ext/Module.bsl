	МассивОрганизаций = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	//если отчет заполняется по нескольким организациям, то нужно для каждой организации индивидуально получать настройку - ДатыСУчетомИнвентаризации,
	//иначе остатки на начало года определяются не верно, потому сначала получаем организации по отбору, и по ним получаем настройку и данные регистра
	//и отбор в цикле задаем в этом случае всегда на равно	
	УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
	
