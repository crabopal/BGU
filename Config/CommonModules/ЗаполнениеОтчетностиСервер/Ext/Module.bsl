				|				И ЖурналПроводокЕПСБУ.СчетДт В (&Счета20120)
				|			ИЛИ ЖурналПроводокЕПСБУ.СчетКт В (&Счета30405)
				|				И ЖурналПроводокЕПСБУ.СчетДт НЕ В (&КоррСчетаИсключения))
				|	И ЖурналПроводокЕПСБУ.Активность = ИСТИНА
				|	И ЖурналПроводокЕПСБУ.УточнениеПериода = 0
				|	%Условие%";
				
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаДата);
	Запрос.УстановитьПараметр("СчетОбязательств", СчетОбязательств);
	
	КоррСчетаИсключения = БухгалтерскийУчет.СписокСчетов("000, 304.04, 401.30,
														|304.84, 304.94, 304.66, 304.76, 304.86, 304.96,
														|401.16, 401.17, 401.18, 401.19,
														|401.26, 401.27, 401.28, 401.29");
	Запрос.УстановитьПараметр("КоррСчетаИсключения", КоррСчетаИсключения);
	
	Счета30404 = БухгалтерскийУчет.СписокСчетов("304.04");
	Запрос.УстановитьПараметр("Счета30404", Счета30404);
	
	Счета30405 = БухгалтерскийУчет.СписокСчетов("304.05");
	Запрос.УстановитьПараметр("Счета30405", Счета30405);
	
	Счета20120 = БухгалтерскийУчет.СписокСчетов("201.21, 201.23, 201.27");
	Запрос.УстановитьПараметр("Счета20120", Счета20120);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%Условие%",?(ЗначениеЗаполнено(Условие),"И "+Условие,""));
	
	Для Каждого КлючИЗначение Из СтруктураПолейОтбора Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

// для форм 190/790

Функция ПолучитьВНД_ДанныеДля190_790(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	
	
	ИсключатьВнутрОборот = Ложь;
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ИсключатьВнутрОборот") Тогда
		Если ТипЗнч(ДополнительныеПараметры["ИсключатьВнутрОборот"]) = Тип("Булево") Тогда
			Если ДополнительныеПараметры["ИсключатьВнутрОборот"] = Истина Тогда
				ИсключатьВнутрОборот = Истина;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДополнительныеПараметры["ИсключатьВнутрОборот"]) = Тип("Структура") Тогда
			Если ДополнительныеПараметры["ИсключатьВнутрОборот"].Свойство("Использование") 
				И ДополнительныеПараметры["ИсключатьВнутрОборот"].Использование = Истина
				И ДополнительныеПараметры["ИсключатьВнутрОборот"].Свойство("ПравоеЗначение")
				И ДополнительныеПараметры["ИсключатьВнутрОборот"].ПравоеЗначение = Истина Тогда	
		        ИсключатьВнутрОборот = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрДляВыбораДокументов = ПараметрыСхемы.Найти("ПараметрДляВыбораДокументов_"+ИмяНабора);
	Если ПараметрДляВыбораДокументов <> Неопределено Тогда
		ИмяПараметраОтчетаПредПериода = ПараметрДляВыбораДокументов.Значение;
	Иначе	
		ИмяПараметраОтчетаПредПериода = "ОтчетПредПериод";
	КонецЕсли; 
	
	ПараметрОтчетПредПериод = Неопределено;
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство(ИмяПараметраОтчетаПредПериода)
		И ЗначениеЗаполнено(ДополнительныеПараметры[ИмяПараметраОтчетаПредПериода]) Тогда
		ПараметрОтчетПредПериод = ДополнительныеПараметры[ИмяПараметраОтчетаПредПериода];
	КонецЕсли;
	
	ОтчетПредПериод = Неопределено;
	Если ТипЗнч(ПараметрОтчетПредПериод) = Тип("Структура") Тогда
		Если ПараметрОтчетПредПериод.Свойство("Использование") 
			И ПараметрОтчетПредПериод.Использование = Истина Тогда	
	        ОтчетПредПериод = ПараметрОтчетПредПериод.ПравоеЗначение;
		КонецЕсли;
	КонецЕсли;	
	
	Если ТипЗнч(КонецПериода) = Тип("Дата") Тогда
		КонецПериода = Новый Граница(КонецПериода,ВидГраницы.Включая);
	КонецЕсли;	
	КонецПериодаДата = КонецДня(ЗаполнениеОтчетности.ПолучитьДатуИзПараметра(КонецПериода));
	
	ТипЧисло = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(18,2);
	ТипДата = БюджетнаяОтчетность.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата);
	ТипСтрока = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(0);
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	//часть колонок, заполняемая по РБ
	ТаблицаДанных.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("Счет",Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДанных.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДанных.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаДанных.Колонки.Добавить("НачальныйОстаток",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("Увеличение",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("Уменьшение",ТипЧисло);
	
	СтруктураПолейОтбора = Новый Структура;
	
	Условие = "";
	УсловиеБаланс = "";
	ЕстьИФО = Ложь;
	
	Если ТипЗнч(ИФО) = Тип("Структура") Тогда
		Если ИФО.Свойство("Использование") 
			И ИФО.Использование = Истина Тогда
			ЕстьИФО = Истина;
			
			Если ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеБаланс = " И ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеБаланс = " И ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеБаланс = " И ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеБаланс = " И НЕ ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеБаланс = " И ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеБаланс = " И ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ИФО <> Неопределено Тогда
		ЕстьИФО = Истина;
		Если ТипЗнч(ИФО) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
			УсловиеБаланс = " И ИФО = &ИФО";
			СтруктураПолейОтбора.Вставить("ИФО",ИФО);
		КонецЕсли;
	КонецЕсли;
	
	УсловиеОрганизация = "";
	
	Если ТипЗнч(Организация) = Тип("Структура") Тогда
		Если Организация.Свойство("Использование") 
			И Организация.Использование = Истина Тогда
			
			Если Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеОрганизация = " И Организация = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеОрганизация = " И Организация <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеОрганизация = " И Организация В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеОрганизация = " И НЕ Организация В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеОрганизация = " И Организация <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеОрганизация = " И Организация = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		УсловиеОрганизация = " И Организация = &Организация";
		СтруктураПолейОтбора.Вставить("Организация",Организация);
	КонецЕсли;	
		
	ПараметрКодВидаОтчета = ПараметрыСхемы.Найти("КодВидаОтчета_"+ИмяНабора);
	Если ПараметрКодВидаОтчета <> Неопределено Тогда
		КодВидаОтчета = ПараметрКодВидаОтчета.Значение;
	Иначе	
		КодВидаОтчета = "190";
	КонецЕсли;
	
	УсловиеКФО = "";
	
	Если СтрНайти(КодВидаОтчета,"190")>0 Тогда
		УсловиеКФО = " И КФО = &КФО";
		СтруктураПолейОтбора.Вставить("КФО",Перечисления.КВД.Бюджет);	
	Иначе
		УсловиеКФО = " И КФО В (&КФО)";//2, 4, 5, 6, 7
		МассивКФО = Новый Массив;
		МассивКФО.Добавить(Перечисления.КВД.Внебюджет);
		МассивКФО.Добавить(Перечисления.КВД.СубсидииНаГосзадание);
		МассивКФО.Добавить(Перечисления.КВД.СубсидииНаИныеЦели);
		МассивКФО.Добавить(Перечисления.КВД.БюджетныеИнвестиции);
		МассивКФО.Добавить(Перечисления.КВД.СредстваОМС);
		СтруктураПолейОтбора.Вставить("КФО",МассивКФО);	
	КонецЕсли;
	
	Условие = УсловиеБаланс + УсловиеОрганизация + УсловиеКФО;
	Условие = Сред(Условие,3);		
		
	ПараметрСчета106 = ПараметрыСхемы.Найти("Счета106_"+ИмяНабора);
	Если ПараметрСчета106 <> Неопределено Тогда
		Счета106 = БухгалтерскийУчет.СписокСчетов(ПараметрСчета106.Значение);
	Иначе	
		Счета106 = БухгалтерскийУчет.СписокСчетов("106.11,106.КС,106.51,106.91");
	КонецЕсли;
	
	
	
	ПараметрСчетаИО = ПараметрыСхемы.Найти("СчетаИсправленияОшибок_"+ИмяНабора);
	Если ПараметрСчетаИО <> Неопределено Тогда
		МассивСчетовИО = БухгалтерскийУчет.СписокСчетов(ПараметрСчетаИО.Значение);
	Иначе	
		МассивСчетовИО = БухгалтерскийУчет.СписокСчетов("304.84, 304.94, 304.66, 304.76, 304.86, 304.96, 
														|401.16, 401.17, 401.18, 401.19, 
														|401.26, 401.27, 401.28, 401.29");
	КонецЕсли;
	
	//Суть процедуры - получить данные по 106 счету, получить данные выбранных рег.отчетов, соединиться
	
	ДополнитьТаблицуПо106(ТаблицаДанных, Счета106, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода,  МассивСчетовИО, ИсключатьВнутрОборот);
	
	ТипСтрока3 = ОбщегоНазначения.ОписаниеТипаСтрока(3);
	ТипСтрока20 = ОбщегоНазначения.ОписаниеТипаСтрока(20);
	ТипСтрока4 = ОбщегоНазначения.ОписаниеТипаСтрока(4);
	
	ТаблицаДанных.Колонки.Добавить("Контрагент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	
	ТаблицаДанных.Колонки.Добавить("гр5а",ТипСтрока3);
	ТаблицаДанных.Колонки.Добавить("гр5б",ТипСтрока20);
	ТаблицаДанных.Колонки.Добавить("гр5в",ТипСтрока4);
	ТаблицаДанных.Колонки.Добавить("гр5г",Новый ОписаниеТипов("СправочникСсылка.Субконто"));
	
	ТаблицаДанных.Колонки.Добавить("гр6а",ТипСтрока3);
	ТаблицаДанных.Колонки.Добавить("гр6б",ТипСтрока20);
	ТаблицаДанных.Колонки.Добавить("гр6в",ТипСтрока4);
	ТаблицаДанных.Колонки.Добавить("гр6г",Новый ОписаниеТипов("СправочникСсылка.Субконто"));
	
	ТаблицаДанных.Колонки.Добавить("Наименование",Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("КодОбъекта",Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("КадастровыйНомер",Новый ОписаниеТипов("Строка"));
	
	//заполняется из данных отчета прошлого года
	ТаблицаДанных.Колонки.Добавить("СтатусНаНачалоГода",Новый ОписаниеТипов("СправочникСсылка.Субконто"));//гр7 - из графы 8 отчета прошлого года
	ТаблицаДанных.Колонки.Добавить("СтатусНаКонецГода",Новый ОписаниеТипов("СправочникСсылка.Субконто")); //гр8 - не заполняется
	ТаблицаДанных.Колонки.Добавить("ЦелеваяФункция",Новый ОписаниеТипов("СправочникСсылка.Субконто"));    //гр9
	ТаблицаДанных.Колонки.Добавить("ПриостановлениеГод",Новый ОписаниеТипов("Дата"));                     //гр10
	ТаблицаДанных.Колонки.Добавить("ПриостановлениеПричина",Новый ОписаниеТипов("СправочникСсылка.Субконто"));//гр11
