// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Получает контрагента, соответствующего организации по ИНН, КПП, Бюджету
//
// Параметры
//  Организация - СправочникСсылка.Организации
//  СоздаватьКонтрагента - булево - Истина - если контрагента нет, то будет создан, Ложь - контрагент создан не будет
//
// Возвращаемое значение:
//   СправочникСсылка.Контрагенты - найденный контрагент. Если не найден, возвращается пустая ссылка.
//
Функция ПолучитьКонтрагентаПоОрганизации(Знач Организация,Знач СоздаватьКонтрагента = Ложь) Экспорт
	Возврат БюджетнаяОтчетностьПолучениеНСИ.КонтрагентПоОрганизации(Организация, СоздаватьКонтрагента);		
КонецФункции

// Получает схему компоновки из шаблона и применяет к ней настройки текущей схемы
// Необходимо для обновления доступных полей схемы правила заполнения при изменении схемы швблона
//
// Параметры:
//  СхемаКомпоновки - Схема компоновки правила заполнения
//  ИмяШаблона - Строка, имя шаблона
//  ОбщиеПараметры - оющие параметры правила заполнения
//
// Возвращаемое значение:
//  Нет
//
Процедура ВосстановитьСхемуИзШаблона(СхемаКомпоновки, Знач ИмяШаблона, Знач ОбщиеПараметры, Знач ВычисляемыеПараметры) Экспорт
	
	Перем КомпоновщикНастроек;
	
	Если ТипЗнч(СхемаКомпоновки) = Тип("СхемаКомпоновкиДанных") Тогда
		
		// Сохранение текущих настроек
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		
		Источник = Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(СхемаКомпоновки));
		
		КомпоновщикНастроек.Инициализировать(Источник);
		
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновки.ВариантыНастроек.Основной.Настройки);
		
	КонецЕсли;
	
	// Восстановление схемы из шаблона
	
	ВидТаблицы = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьИнформациюОВидеТаблицы(ИмяШаблона);
	СхемаКомпоновки = ПолучитьОбщийМакет(ВидТаблицы.ПолноеИмяМакета);
	
	Если ВидТаблицы.Имя = "ПоказателиОтчетов" И КомпоновщикНастроек <> Неопределено Тогда
		НастройкиПриемник = СхемаКомпоновки.ВариантыНастроек.Основной.Настройки;
		НастройкиИсточник = КомпоновщикНастроек.ПолучитьНастройки();
		Если ТипЗнч(НастройкиПриемник) = Тип("НастройкиКомпоновкиДанных") Тогда
			Для каждого Параметр Из НастройкиИсточник.ПараметрыДанных.Элементы Цикл
				ЗначениеПараметра = НастройкиПриемник.ПараметрыДанных.НайтиЗначениеПараметра(Параметр.Параметр);
				Если ЗначениеПараметра <> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(ЗначениеПараметра, Параметр);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ДополнитьСхему(СхемаКомпоновки);
	КонецЕсли;
	
	Если ТипЗнч(КомпоновщикНастроек) = Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
		
		СкопироватьНастройкиКомпоновкиДанных(СхемаКомпоновки.ВариантыНастроек.Основной.Настройки, КомпоновщикНастроек.ПолучитьНастройки());
		
	КонецЕсли;
	
	// Добавление общих параметров в схему компоновки
	ДобавитьПараметрыВСхему(СхемаКомпоновки, ОбщиеПараметры);
	
	//Вычисляемые параметры и способы справнения заменяются на значения и аналогичные способы сравнения со списком значений
	//перед выполнением схемы компоновки данных.
	Для каждого СтрокаТаблицы Из ВычисляемыеПараметры Цикл
		
		ПараметрСхемы = СхемаКомпоновки.Параметры.Добавить();
		ПараметрСхемы.Имя = "ВПС_"+СтрокаТаблицы.ИмяПараметра;
		ПараметрСхемы.ДоступенСписокЗначений = Истина;
		ПараметрСхемы.ОграничениеИспользования = Истина;
		ПараметрСхемы.ВключатьВДоступныеПоля = Истина;
		
		ТипЗначения = Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
		
		ПараметрСхемы.ТипЗначения = ТипЗначения;
		
	КонецЦикла;
	
	ПрименитьНастройкиКСхемеКомпоновки(СхемаКомпоновки);
	
КонецПроцедуры

//Дополняет схему компоновки с видом ""
Процедура ДополнитьСхему(Схема) Экспорт
	
	КодВидаОтчета = "";
	
	ЗначениеПараметра = Схема.ВариантыНастроек.Основной.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("КодВидаОтчета"));
	Если ЗначениеПараметра <> Неопределено Тогда
		КодВидаОтчета = ЗначениеПараметра.Значение;
	КонецЕсли;
		
	
	Запрос =Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоказателиОтчетов.Колонка.Код КАК КодКолонки,
	|	ПоказателиОтчетов.Колонка.ПорядковыйНомер,
	|	ПоказателиОтчетов.Владелец КАК ВидОтчета
	|ИЗ
	|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыОтчетов КАК ВидыОтчетов
	|		ПО ПоказателиОтчетов.Владелец = ВидыОтчетов.Ссылка
	|			И (ВидыОтчетов.Код = &КодВидаОтчета)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоказателиОтчетов.Колонка.ПорядковыйНомер";
		
	
	Запрос.УстановитьПараметр("КодВидаОтчета", СокрЛП(КодВидаОтчета));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВидОтчета = Неопределено;
	
	ИсходнаяСхема = ПолучитьОбщийМакет("ЗаполнениеОтчетов_ПоказателиОтчетов");
	ИсходныйНабор = ИсходнаяСхема.НаборыДанных[0];
	
	МассивПолейКУдалению = Новый Массив;
	Для Каждого ТекПоле Из Схема.НаборыДанных[0].Поля Цикл
		Если ИсходныйНабор.Поля.Найти(ТекПоле.ПутьКДанным) = Неопределено Тогда
			МассивПолейКУдалению.Добавить(ТекПоле);
		КонецЕсли;		
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивПолейКУдалению Цикл
		Схема.НаборыДанных[0].Поля.Удалить(ЭлМас);
	КонецЦикла;
	
	Пока Выборка.Следующий() Цикл
		КодКолонки = СокрП(Выборка.КодКолонки);
		ПолеНабора = Схема.НаборыДанных[0].Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеНабора.ПутьКДанным 	= "Объект."+КодКолонки;
		ПолеНабора.Поле			= КодКолонки;
		ВидОтчета = Выборка.ВидОтчета;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ВидОтчета) Тогда
		Для Сч = 1 По БюджетнаяОтчетность.ЧислоДопАналитик(ВидОтчета) Цикл
			
			ПолеНабора = Схема.НаборыДанных[0].Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			ПолеНабора.ПутьКДанным 	= "Объект.Аналитика"+Сч;
			ПолеНабора.Поле			= "Аналитика"+Сч;
			
		КонецЦикла;
	КонецЕсли;
	
	Настройки = Схема.ВариантыНастроек.Основной.Настройки;
	
	Настройки.Выбор.Элементы.Очистить();
	
	Для Каждого Поле Из Схема.НаборыДанных[0].Поля Цикл
		ТекПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ТекПоле.Поле = Новый ПолеКомпоновкиДанных(Поле.ПутьКДанным);
		ТекПоле.Заголовок = Поле.Заголовок;
		ТекПоле.Использование = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Выгружает настройки компоновки данных во внешний файл
//
// Параметры:
//  НастройкиСхемы - настройки схемы компоновки данных для выгрузки в файл
//  ИмяФайла - Строка, имя файла
//
// Возвращаемое значение:
//  Нет
//
Процедура ВыгрузитьНастройки(Знач НастройкиСхемы, Знач ИмяФайла) Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла);
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, 
		НастройкиСхемы,
		"settings", 
		"http://v8.1c.ru/8.1/data-composition-system/settings");
	ЗаписьXML.Закрыть();
	
КонецПроцедуры

// Выгружает схему компоновки данных во внешний файл
//
// Параметры:
//  СхемаКомпоновки - схема компоновки данных для выгрузки в файл
//  ИмяФайла - Строка, имя файла
//
// Возвращаемое значение:
//  Нет
//
Функция ВыгрузитьСхемуКомпоновки(Знач СхемаКомпоновки, Знач ИмяФайла) Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла);
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML,
		СериализаторXDTO.ПрочитатьXDTO(СериализаторXDTO.ЗаписатьXDTO(СхемаКомпоновки)),
		"data-composition-system", 
		"http://v8.1c.ru/8.1/data-composition-system");
	
	ЗаписьXML.Закрыть();
	
КонецФункции

// Выгружает таблицу данных во внешний файл
//
// Параметры:
//  ТаблицаДанных - таблица данных для выгрузки в файл
//  ИмяФайла - Строка, имя файла
//
// Возвращаемое значение:
//  Нет
//
Процедура ВыгрузитьТаблицуДанных(Знач ТаблицаДанных, Знач ИмяФайла) Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла);
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, ТаблицаДанных);
	ЗаписьXML.Закрыть();
	
КонецПроцедуры

// Выгружает таблицу данных во внешний файл
//
// Параметры:
//  Построитель - построитель запроса для выгрузки в файл
//  ИмяФайла - Строка, имя файла
//
// Возвращаемое значение:
//  Нет
//
Процедура ВыгрузитьПостроительЗапроса(Построитель,ИмяФайла) Экспорт
	
	СтруктураВозврата = Новый Структура;
	
	Если ТипЗнч(Построитель) = Тип("Запрос") Тогда
		Запрос = Построитель;
	ИначеЕсли ТипЗнч(Построитель) = Тип("ПостроительЗапроса") Тогда
		Запрос = Построитель.ПолучитьЗапрос();
	КонецЕсли;
	
	СтруктураВозврата.Вставить("Текст",Запрос.Текст);
	
	ТаблицаПараметров = Новый ТаблицаЗначений;
	ТаблицаПараметров.Колонки.Добавить("Имя");
	ТаблицаПараметров.Колонки.Добавить("Значение");
	
	Для каждого Параметр Из Запрос.Параметры Цикл
		
		СтрокаТаблицаПараметров = ТаблицаПараметров.Добавить();
		СтрокаТаблицаПараметров.Имя = Параметр.Ключ;
		СтрокаТаблицаПараметров.Значение = Параметр.Значение;
		
	КонецЦикла;
	
	СтруктураВозврата.Вставить("Параметры",ТаблицаПараметров);
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла);
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, СтруктураВозврата);
	ЗаписьXML.Закрыть();
	
КонецПроцедуры

// Помещает карты данных во временное хранилище и добавляет их в параметры схемы компоновки
//
// Параметры:
//  КартыДанных - массив карт данных
//  Схема - Целевая схема компоновки
//
// Возвращаемое значение:
//  Массив адресов
//
Функция ДобавитьКартыДанныхВСхему(Знач КартыДанных, Схема) Экспорт
	
	СтруктураАдресов = Новый Структура;
	
	Для каждого КартаДанных Из КартыДанных Цикл
		
		АдресКарты = ПоместитьВоВременноеХранилище(КартаДанных.Значение);
		
		СтруктураАдресов.Вставить(КартаДанных.Ключ,АдресКарты);
		
		СтруктураПараметра = Новый Структура("ИмяПараметра, ЗначениеПараметра", КартаДанных.Ключ, АдресКарты);
		
		ДобавитьПараметр(Схема,, СтруктураПараметра, Истина);
		
	КонецЦикла;
	
	Возврат СтруктураАдресов;
	
КонецФункции

// Заполняет отборы в схеме компоновки из структуры параметров
//
// Параметры:
//  Схема - Целевая схема компоновки
//  СтруктураПараметров - Структура параметров для заполнения
//
// Возвращаемое значение:
//  Нет
//
Процедура ЗаполнитьПараметрыИзДокумента(Схема, Знач СтруктураПараметров) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем ДополнительныйПериод1;
	Перем ДополнительныйПериод2;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
	
	ПараметрыСхемы = Схема.Параметры;
	НастройкиОтбор = Схема.ВариантыНастроек.Основной.Настройки.Отбор.Элементы;
	
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	
	СтруктураПараметров.Свойство("ДополнительныйПериод1", ДополнительныйПериод1);
	СтруктураПараметров.Свойство("ДополнительныйПериод2", ДополнительныйПериод2);
	
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	
	// Период отчета
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		
		ДобавитьПараметр(Схема,, Новый Структура("ИмяПараметра, ЗначениеПараметра","НачалоПериода",НачалоПериода));
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		
		ДобавитьПараметр(Схема,, Новый Структура("ИмяПараметра, ЗначениеПараметра","КонецПериода",КонецПериода));
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныйПериод1) Тогда
		
		ДобавитьПараметр(Схема,, Новый Структура("ИмяПараметра, ЗначениеПараметра","ДополнительныйПериод1",ДополнительныйПериод1));
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныйПериод2) Тогда
		
		ДобавитьПараметр(Схема,, Новый Структура("ИмяПараметра, ЗначениеПараметра","ДополнительныйПериод2",ДополнительныйПериод2));
		
	КонецЕсли;
	
	НаборОбъединение = Схема.НаборыДанных.Найти("Объединение");
	ЕстьОрганизация = Истина;
	ЕстьИФО = Истина;
	Если НаборОбъединение<>Неопределено Тогда
		ЕстьОрганизация = НаборОбъединение.Поля.Найти("Организация") <> Неопределено;
		ЕстьИФО = НаборОбъединение.Поля.Найти("ИФО") <> Неопределено;
	КонецЕсли;
	
	// Организация
	Если Организация <> Неопределено И ЕстьОрганизация Тогда
		
		ПолеОтбора = НастройкиОтбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Если ТипЗнч(Организация) = Тип("Структура") Тогда
			
			ЗаполнитьЗначенияСвойств(ПолеОтбора, Организация);
			
		Иначе
			
			ПолеОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация");
			
			Если ТипЗнч(Организация) = Тип("СписокЗначений") Тогда
				ПолеОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			Иначе
				ПолеОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			КонецЕсли;
			
			ПолеОтбора.ПравоеЗначение = Организация;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// ИФО
	Если ИФО <> Неопределено И ЕстьИФО Тогда
		
		ПолеОтбора = НастройкиОтбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Если ТипЗнч(ИФО) = Тип("Структура") Тогда
			
			ЗаполнитьЗначенияСвойств(ПолеОтбора, ИФО);
			
		Иначе
			
			ПолеОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИФО");
			
			Если ТипЗнч(ИФО) = Тип("СписокЗначений") Тогда
				ПолеОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			Иначе
				ПолеОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			КонецЕсли;
			
			ПолеОтбора.ПравоеЗначение = ИФО;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Дополнительные параметры
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		
		Для каждого ДополнительныйПараметр Из ДополнительныеПараметры Цикл
			
			ДобавитьПараметр(Схема, , Новый Структура("ИмяПараметра, ЗначениеПараметра", ДополнительныйПараметр.Ключ, ДополнительныйПараметр.Значение));
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьВнешниеНаборыДанных(СоответствиеДанных,КартыДанных) Экспорт
	
	Для Каждого НастройкаНабора Из СоответствиеДанных Цикл
		КодВидаОтчета = Неопределено;
		ИмяПараметраДляДокументов = "";
		ЗначениеПараметраДляДокументов = Неопределено;
		НастройкаНабора.Значение.Свойство("ЗначениеПараметраДляДокументов",ЗначениеПараметраДляДокументов);
		НастройкаНабора.Значение.Свойство("КодВидаОтчета",КодВидаОтчета);
		НастройкаНабора.Значение.Свойство("ИмяПараметраДляДокументов",ИмяПараметраДляДокументов);
		
		Если НЕ ЗначениеЗаполнено(ЗначениеПараметраДляДокументов) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивОтчетов = Новый Массив;
		Если ТипЗнч(ЗначениеПараметраДляДокументов) = Тип("СписокЗначений") Тогда
			Для Каждого ЭлементСписка Из ЗначениеПараметраДляДокументов Цикл
				Если МассивОтчетов.Найти(ЭлементСписка.Значение) = Неопределено 
					И ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
					МассивОтчетов.Добавить(ЭлементСписка.Значение);
				КонецЕсли;			
			КонецЦикла;
		Иначе
			МассивОтчетов.Добавить(ЗначениеПараметраДляДокументов);
		КонецЕсли;
		
		ТаблицаДанныхОбщая = Неопределено;
		Для Каждого СсылкаНаОтчет Из МассивОтчетов Цикл
			
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОтчет,"ВидОтчета,ШаблонОтчета");
			Если Реквизиты.ВидОтчета.Код <> КодВидаОтчета Тогда
				Продолжить;
			КонецЕсли;
			
			РеквизитыОтчета = Новый Структура("Ссылка,ВидОтчета,ШаблонОтчета,мДокументОснование,мДополнительныеРеквизиты");
			РеквизитыОтчета.Ссылка = СсылкаНаОтчет;
			ЗаполнитьЗначенияСвойств(РеквизитыОтчета,Реквизиты);
	
			// Инициализация контекста на сервере.
			Контекст = БюджетнаяОтчетностьСервер.ИнициализироватьКонтекстОтчета(РеквизитыОтчета);
		    Контекст.Вставить("ДокОтчет",СсылкаНаОтчет);
			
			ТаблицаДанных = ПолучитьКроссТаблицуПоказателей(Контекст);
			
			Если ТаблицаДанныхОбщая <> Неопределено Тогда
				Для Каждого СтрТЧ Из ТаблицаДанных Цикл
					НовСтр = ТаблицаДанныхОбщая.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтр,СтрТЧ);
				КонецЦикла;
			Иначе
				ТаблицаДанныхОбщая = ТаблицаДанных.Скопировать();
			КонецЕсли;
		КонецЦикла;		
		
		Если ТаблицаДанныхОбщая <> Неопределено Тогда
			КартыДанных.Вставить("ДанныеВыборки_"+ИмяПараметраДляДокументов,ТаблицаДанныхОбщая);	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


// Получает кросс-таблицу значений показателей
//
Функция ПолучитьКроссТаблицуПоказателей(Контекст)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	мПоказатели.Ссылка,
	|	мПоказатели.КодСтрока КАК КодСтрокиОтчета,
	|	мПоказатели.КодКолонки,
	|	мПоказатели.ПорядковыйНомерКолонки,
	|	мПоказатели.ПорядковыйНомерСтроки,
	|	мПоказатели.Строка,
	|	мПоказатели.Колонка,
	|	мПоказатели.ГруппаРаскрытия,
	|	мПоказатели.Значение,
	|	мПоказатели.ТипЗначения
	|ПОМЕСТИТЬ Показатели
	|ИЗ
	|	&мПоказатели КАК мПоказатели";
		
	Запрос.УстановитьПараметр("мПоказатели"	,Контекст.мПоказатели);
	Запрос.Выполнить();
	
	// Создание списка колонок
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Показатели.КодКолонки,
	|	Показатели.ТипЗначения,
	|	Показатели.ПорядковыйНомерКолонки
	|ИЗ
	|	Показатели КАК Показатели
	|УПОРЯДОЧИТЬ ПО
	|	Показатели.ПорядковыйНомерКолонки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТаблицаРезультат.Колонки.Добавить("Строка",Новый ОписаниеТипов("СправочникСсылка.СтрокиОтчетов"));
	ТаблицаРезультат.Колонки.Добавить("КодСтрокиОтчета",БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(20));
	ТаблицаРезультат.Колонки.Добавить("ИтогПоСтроке",Новый ОписаниеТипов("Булево"));
	ТаблицаРезультат.Колонки.Добавить("ПорядковыйНомер",БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(5));
	
	ОписаниеТиповАналитики = Метаданные.ПланыВидовХарактеристик.АналитикаОтчетов.Тип;
	
	Если Контекст.мЧислоДопАналитик>0 Тогда
		
		РезультатЗапросаПоРаскрытию = ПолучитьДанныеРаскрытия(Контекст);
		
		Для Сч = 1 По Контекст.мЧислоДопАналитик Цикл
			ТаблицаРезультат.Колонки.Добавить("Аналитика"+Сч,ОписаниеТиповАналитики);
		КонецЦикла;
				
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		ТаблицаРезультат.Колонки.Добавить(СокрП(Выборка.КодКолонки),
										  БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Выборка.ТипЗначения));
		
	КонецЦикла;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Показатели.Значение,
	|	Показатели.КодКолонки,
	|	Показатели.ГруппаРаскрытия,
	|	Показатели.Строка КАК Строка,
	|	Показатели.КодСтрокиОтчета,
	|	Показатели.ПорядковыйНомерСтроки
	|ИЗ
	|	Показатели КАК Показатели
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строка.ПорядковыйНомер
	|ИТОГИ ПО
	|	Строка";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если Контекст.мЧислоДопАналитик>0 Тогда
		РаскрытиеСтрок = РезультатЗапросаПоРаскрытию.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаТаблицы = ТаблицаРезультат.Добавить();
		СтрокаТаблицы.Строка	 	  	= Выборка.Строка;
		СтрокаТаблицы.ИтогПоСтроке  	= Истина;
		
		ВыборкаПоказателей = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		ГруппаРаскрытия = Неопределено;
		КодСтрокиОтчета = "";
		ПорядковыйНомер = 0;
		
		Пока ВыборкаПоказателей.Следующий() Цикл
			
			СтрокаТаблицы[СокрП(ВыборкаПоказателей.КодКолонки)] = ВыборкаПоказателей.Значение;
			
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ГруппаРаскрытия,ВыборкаПоказателей.ГруппаРаскрытия);
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(СтрокаТаблицы.КодСтрокиОтчета,ВыборкаПоказателей.КодСтрокиОтчета);
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(СтрокаТаблицы.ПорядковыйНомер,ВыборкаПоказателей.ПорядковыйНомерСтроки);
			
		КонецЦикла;
		
		КодСтрокиОтчета = СтрокаТаблицы.КодСтрокиОтчета;
		ПорядковыйНомер = СтрокаТаблицы.ПорядковыйНомер;
		
		Если Контекст.мЧислоДопАналитик>0 и ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
			
			РаскрытиеСтрок.Сбросить();
			Если Не РаскрытиеСтрок.НайтиСледующий(ГруппаРаскрытия,"ГруппаРаскрытия") Тогда
				Продолжить;
			КонецЕсли;
			
			ВыборкаРаскрытие = РаскрытиеСтрок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			ТекИндекс = 0;
			
			Пока ВыборкаРаскрытие.Следующий() Цикл
				
				Если ТекИндекс <> ВыборкаРаскрытие.Индекс Тогда
					
					СтрокаТаблицы = ТаблицаРезультат.Добавить();
					СтрокаТаблицы.Строка = Выборка.Строка;
					СтрокаТаблицы.КодСтрокиОтчета = КодСтрокиОтчета;
					СтрокаТаблицы.ПорядковыйНомер = ПорядковыйНомер;
					
					Для Сч = 1 По Контекст.мЧислоДопАналитик Цикл
						СтрокаТаблицы["Аналитика"+Сч] = ВыборкаРаскрытие["Аналитика"+Сч];
					КонецЦикла;
					ТекИндекс = ВыборкаРаскрытие.Индекс;
				КонецЕсли;
				
				СтрокаТаблицы[СокрП(ВыборкаРаскрытие.КодКолонки)] = ВыборкаРаскрытие.Значение;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаРезультат.Колонки.Добавить("ДокОтчет",Новый ОписаниеТипов("ДокументСсылка.УниверсальныйРегламентированныйОтчет"));
	ТаблицаРезультат.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаРезультат.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контекст.ДокОтчет,"Организация,ИФО");
	
	Для Каждого СтрТЧ Из ТаблицаРезультат Цикл
		СтрТЧ.ДокОтчет = Контекст.ДокОтчет;
		ЗаполнитьЗначенияСвойств(СтрТЧ,РеквизитыДокумента);
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции // ПолучитьКроссТаблицуПоказателей()

Функция ПолучитьДанныеРаскрытия(Контекст, КодыСтрок = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(мПоказателиРаскрытия.Показатель КАК Справочник.ПоказателиОтчетов) КАК Показатель,
	|	мПоказателиРаскрытия.ГруппаРаскрытия КАК ГруппаРаскрытия,";
	
	Для Сч = 1 По Контекст.мЧислоДопАналитик Цикл
		
		Запрос.Текст = Запрос.Текст + "
		|	мПоказателиРаскрытия.Аналитика"+Сч+",";
		
	КонецЦикла;
	Запрос.Текст = Запрос.Текст + "
	|	мПоказателиРаскрытия.Значение,
	|	мПоказателиРаскрытия.Индекс
	|ПОМЕСТИТЬ ПоказателиРаскрытия
	|ИЗ
	|	&мПоказателиРаскрытия КАК мПоказателиРаскрытия";
	
	Если Не КодыСтрок = Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	мПоказателиРаскрытия.Показатель.Строка.Код В(&КодыСтрок)";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("мПоказателиРаскрытия",Контекст.мПоказателиРаскрытия);
	
	Запрос.Выполнить();

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	мПоказателиРаскрытия.Показатель,
	|	мПоказателиРаскрытия.Показатель.Строка КАК Строка,
	|	мПоказателиРаскрытия.Показатель.Колонка КАК Колонка,
	|	мПоказателиРаскрытия.ГруппаРаскрытия КАК ГруппаРаскрытия,
	|	мПоказателиРаскрытия.Показатель.Строка.Код КАК КодСтроки,
	|	мПоказателиРаскрытия.Показатель.Колонка.Код КАК КодКолонки,";
	
	Для Сч = 1 По Контекст.мЧислоДопАналитик Цикл
		
		Запрос.Текст = Запрос.Текст + "
		|	мПоказателиРаскрытия.Аналитика"+Сч+",";
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + "
	|	мПоказателиРаскрытия.Значение,
	|	мПоказателиРаскрытия.Индекс
	|ИЗ
	|	ПоказателиРаскрытия КАК мПоказателиРаскрытия
	|УПОРЯДОЧИТЬ ПО
	|	мПоказателиРаскрытия.Индекс
	|ИТОГИ ПО
	| 	мПоказателиРаскрытия.ГруппаРаскрытия";
	
	Возврат Запрос.Выполнить();
	
КонецФункции

//////////////////////////////////////////////////
// Генерация схемы источника - объединение наборов

// Получает схему компоновки источника данных на основании схем коспоновки наборов данных
//
// Параметры:
//  ШаблонСхемыОбъединение - Схема компоновки из макета "Объединение"
//  НаборыДанных - Массив наборов данных
//  ТаблицаСвязей - Таблица связей набора объединение с картами данных
//  СтруктураКартДанных - Структура с картами данных
//  ТекстСообщения - Строка для сообщений об ошибках
//
// Возвращаемое значение:
//  СхемаКомпоновкиОбъединение - Схема компоновки источника данных
//  Неопределено - есть ошибки
//
Функция ОбъединитьНаборы(Знач ШаблонСхемыОбъединение, Знач НаборыДанных, Знач ТаблицаСвязей, Знач СтруктураКартДанных, ТекстСообщения) Экспорт
	
	Если ТипЗнч(НаборыДанных) <> Тип("Массив") Тогда
		
		ТекстСообщения = НСтр("ru = 'Не определены наборы данных'");
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	СхемаКомпоновкиОбъединение = ШаблонСхемыОбъединение;
	
	НаборОбъединение = СхемаКомпоновкиОбъединение.НаборыДанных.Объединение;
	
	МассивВыбранныхПолей = Новый Массив;
	
	Для каждого Набор Из НаборыДанных Цикл
		
		ШаблонСхемы = СкопироватьСхемуКомпоновки(Набор.НаборДанных);
		
		НаборШаблона = ШаблонСхемы.НаборыДанных.НаборДанных1;
		
		ЭлементНабора = НаборОбъединение.Элементы.Добавить(ТипЗнч(НаборШаблона)); //Тип("НаборДанныхЗапросСхемыКомпоновкиДанных")
		
		ЭлементНабора.Имя = Набор.Наименование;
		
		Если ТипЗнч(НаборШаблона) = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда
			ОбработатьВидыСубконто(НаборШаблона.Запрос, Набор.Наименование);
			ЭлементНабора.АвтоЗаполнениеДоступныхПолей = Ложь;
			ЭлементНабора.Запрос = НаборШаблона.Запрос;
		ИначеЕсли ТипЗнч(НаборШаблона) = Тип("НаборДанныхОбъектСхемыКомпоновкиДанных") Тогда
			КодВидаОтчета = "";
			
			Если ЭлементНабора.Имя <> "ДанныеДля190_790" Тогда
				ЗначениеПараметра = Набор.НаборДанных.ВариантыНастроек.Основной.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПараметрДляВыбораДокументов"));
				Если ЗначениеПараметра <> Неопределено Тогда
					ПараметрДляВыбораДокументов = ЗначениеПараметра.Значение;
					ЭлементНабора.ИмяОбъекта = НаборШаблона.ИмяОбъекта+"_"+ПараметрДляВыбораДокументов;
				Иначе
					ЭлементНабора.ИмяОбъекта = НаборШаблона.ИмяОбъекта+"_"+Набор.Наименование;
				КонецЕсли;
			Иначе
				ЭлементНабора.ИмяОбъекта = НаборШаблона.ИмяОбъекта+"_"+Набор.Наименование;	
			КонецЕсли;
					
		КонецЕсли;
					
		ЭлементНабора.ИсточникДанных = СхемаКомпоновкиОбъединение.ИсточникиДанных.ИсточникДанных1.Имя;
		
		ЗаполнитьПоляСхемы(ЭлементНабора, НаборОбъединение, НаборШаблона.Поля, ШаблонСхемы.ВариантыНастроек.Основной.Настройки, Набор.Наименование);
		
		ЗаполнитьПоляРесурсов(ЭлементНабора, НаборОбъединение, ШаблонСхемы.ПоляИтога, СхемаКомпоновкиОбъединение.ПоляИтога, Набор.Наименование);
		
		ЗаполнитьПараметрыСхемы(ШаблонСхемы, СхемаКомпоновкиОбъединение, Набор.Наименование);
		
		КомпоновщикНастроекШаблона = Новый КомпоновщикНастроекКомпоновкиДанных;
		ИсточникНастроекШаблона = Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(ШаблонСхемы));
		КомпоновщикНастроекШаблона.Инициализировать(ИсточникНастроекШаблона);
		КомпоновщикНастроекШаблона.ЗагрузитьНастройки(ШаблонСхемы.ВариантыНастроек.Основной.Настройки);
		НастройкиШаблона = КомпоновщикНастроекШаблона.ПолучитьНастройки();
		
		НастройкиСхемыОбъединение = СхемаКомпоновкиОбъединение.ВариантыНастроек.Основной.Настройки;
		
		ЗаполнитьНастрокиСхемы(НастройкиСхемыОбъединение, НастройкиШаблона.Выбор.Элементы, СхемаКомпоновкиОбъединение.Параметры, МассивВыбранныхПолей);
		
		СкопироватьОтборСКД(ЭлементНабора.Поля, НаборШаблона.Поля, НастройкиСхемыОбъединение.Отбор.Элементы, НастройкиШаблона.Отбор.Элементы, Набор.Наименование);
		
	КонецЦикла;
	
	Если СоединитьСКартамиДанных(ТаблицаСвязей, СтруктураКартДанных, СхемаКомпоновкиОбъединение, ТекстСообщения) Тогда
		
		Возврат СхемаКомпоновкиОбъединение;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

// Получает структуру дополнительных параметров для выполнения правила заполнения
// Получаются общие параметры правила заполнения, соединяются с дополнительными параметрами отчетного документа
// Если в документе значение не задано, то берется значение по умолчанию общего параметра
// Если передается структура переопределенных параметров, то значения заполняются по соотв. ключам
//
// Параметры:
//  ДокументСсылка - ссылка на документ "Универсальный регламентированный отчет"
//  ВидОтчета - Ссылка на вид отчета
//  ПравилоЗаполнения - Ссылка на правило заполнения
//  СтруктураПереопределенныхПараметров - Структура параметров определенных в форме "НастройкаЗаполнения"
//  СтруктураПараметровДокумента - Структура дополнительных параметров документа
//
// Возвращаемое значение:
//  ДополнительныеПараметры - Структура дополнительных параметров
//
Функция ПодготовитьСтруктуруПараметров(Знач ДокументСсылка, Знач ВидОтчета, Знач ПравилоЗаполнения, Знач СтруктураПереопределенныхПараметров = Неопределено, Знач СтруктураПараметровДокумента = Неопределено, СоответствиеПолейИДопРеквизитов = Неопределено) Экспорт
	
	// Заполнение общих параметров правила
	ДополнительныеПараметры = Новый Структура;
	
	СоответствиеПолейИДопРеквизитов = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПравилаЗаполненияОбщиеПараметры.ИмяПараметра,
		|	ПравилаЗаполненияОбщиеПараметры.ВидАналитики,
		|	ПравилаЗаполненияОбщиеПараметры.ВидАналитики.Код,
		|	ПравилаЗаполненияОбщиеПараметры.ЗначениеПараметра,
		|	ПравилаЗаполненияОбщиеПараметры.ПользовательскаяДоступность
		|ПОМЕСТИТЬ ПравилаЗаполненияОбщиеПараметры
		|ИЗ
		|	Справочник.ПравилаЗаполнения.ОбщиеПараметры КАК ПравилаЗаполненияОбщиеПараметры
		|ГДЕ
		|	ПравилаЗаполненияОбщиеПараметры.Ссылка = &ПравилоЗаполнения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДополнительныеРеквизитыОтчетов.Код КАК ДополнительныйРеквизитКод,
		|	ДополнительныеРеквизитыОтчетов.ВидАналитики
		|ПОМЕСТИТЬ ДополнительныеРеквизитыОтчетов
		|ИЗ
		|	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
		|ГДЕ
		|	ДополнительныеРеквизитыОтчетов.Владелец = &ВидОтчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПравилаЗаполненияОбщиеПараметры.ИмяПараметра,
		|	ПравилаЗаполненияОбщиеПараметры.ВидАналитики,
		|	ПравилаЗаполненияОбщиеПараметры.ВидАналитикиКод,
		|	ПравилаЗаполненияОбщиеПараметры.ЗначениеПараметра,
		|	ПравилаЗаполненияОбщиеПараметры.ПользовательскаяДоступность,
		|	ЕСТЬNULL(ДополнительныеРеквизитыОтчетов.ДополнительныйРеквизитКод, """") КАК ДополнительныйРеквизитКод
		|ИЗ
		|	ПравилаЗаполненияОбщиеПараметры КАК ПравилаЗаполненияОбщиеПараметры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
		|		ПО ПравилаЗаполненияОбщиеПараметры.ВидАналитики = ДополнительныеРеквизитыОтчетов.ВидАналитики";
	
	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);
	Запрос.УстановитьПараметр("ПравилоЗаполнения", ПравилоЗаполнения);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.ДополнительныйРеквизитКод) Тогда
			СоответствиеПолейИДопРеквизитов.Вставить(Выборка.ИмяПараметра,Выборка.ДополнительныйРеквизитКод);
		КонецЕсли;
		
		Значение = Неопределено;
		Если НЕ ПустаяСтрока(Выборка.ДополнительныйРеквизитКод) 
			И ТипЗнч(СтруктураПараметровДокумента) = Тип("Структура")
			И СтруктураПараметровДокумента.Свойство(Выборка.ДополнительныйРеквизитКод, Значение)
			И ЗначениеЗаполнено(Значение) Тогда
			
			ЗначениеПараметра = Значение;
			
		Иначе
			
			ЗначениеПараметра = Выборка.ЗначениеПараметра;
			
		КонецЕсли;
		
		ДополнительныеПараметры.Вставить(Выборка.ИмяПараметра, ЗначениеПараметра);
		
	КонецЦикла;
	
	Если ТипЗнч(СтруктураПереопределенныхПараметров) = Тип("Структура") Тогда
		
		Для каждого КлючИЗначение Из СтруктураПереопределенныхПараметров Цикл
			
			ДополнительныеПараметры.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

// Получает значение вложенного реквизита по пути с разделителями "." путем рекурсии
//
// Параметры:
//  Элемент - Ссылка на объект
//  ПутьДоРеквизита - путь до реквизита с разделителями "."
//
// Возвращаемое значение:
//  Значение реквизита - если он найден
//  Неопределено - если реквизит не найден
//
Функция ПолучитьЗначениеВложенногоРеквизита(Знач Элемент, Знач ПутьДоРеквизита) Экспорт
	
	Поз = Найти(ПутьДоРеквизита, ".");
	Если НЕ ЗначениеЗаполнено(Элемент) ИЛИ ПустаяСтрока(ПутьДоРеквизита) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если Поз = 0 Тогда
		
		ИмяРеквизита = ПутьДоРеквизита;
		ПутьДоРеквизита = "";
		
	Иначе
		
		ИмяРеквизита = Сред(ПутьДоРеквизита, 1, Поз - 1);
		ПутьДоРеквизита = Сред(ПутьДоРеквизита, Поз + 1);
		
	КонецЕсли;
	
	Попытка
		
		Значение =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент, ИмяРеквизита);
		
	Исключение
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Если НЕ ПустаяСтрока(ПутьДоРеквизита) Тогда
		
		Значение = ПолучитьЗначениеВложенногоРеквизита(Значение, ПутьДоРеквизита);
		
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Получает массив обязательных колонок схемы заполнения
//
// Параметры:
//  ВидСхемыЗаполнения - Строка, вид схемы заполнения: горизонтальная, вертикальная
//  ВернутьСтрокой - Признак того, что возвращаеся строка с разделителями ","
//
// Возвращаемое значение:
//  фиксированный массив - имена предопределенных колонок, если ВернутьСтрокой = Ложь
//  строка с разделителями "," - имена предопределенных колонок, если ВернутьСтрокой = Истина
//
Функция ПолучитьКолонкиСхемыЗаполнения(Знач ВидСхемыЗаполнения, Знач ВернутьСтрокой = Ложь) Экспорт
	
	МассивКолонок = Новый Массив;
	
	Если ВидСхемыЗаполнения = "Вертикальная" Тогда
		
		МассивКолонок.Добавить("Строка");
		МассивКолонок.Добавить("ТипГруппировкиГрафа");
		МассивКолонок.Добавить("Графа");
		МассивКолонок.Добавить("ТипГруппировкиСтрока");
		МассивКолонок.Добавить("Значение");
		МассивКолонок.Добавить("АгрегатнаяФункцияЗначение");
		МассивКолонок.Добавить("Расшифровка");
		МассивКолонок.Добавить("НастройкиОткрытияТиповыхОтчетов");
		МассивКолонок.Добавить("Отключить");
		
	ИначеЕсли ВидСхемыЗаполнения = "Горизонтальная" Тогда
		
		МассивКолонок.Добавить("Строка");
		МассивКолонок.Добавить("ТипГруппировкиСтрока");
		МассивКолонок.Добавить("Отключить");
		
	КонецЕсли;
	
	Если ВернутьСтрокой Тогда
		
		СтрокаКолонок = "";
		
		Для каждого ИмяКолонки Из МассивКолонок Цикл
			
			СтрокаКолонок = СтрокаКолонок + ?(ПустаяСтрока(СтрокаКолонок), "", ",") + ИмяКолонки;
			
		КонецЦикла;
		
		Возврат СтрокаКолонок;
		
	Иначе
		
		Возврат Новый ФиксированныйМассив(МассивКолонок);
		
	КонецЕсли;
	
КонецФункции // ПолучитьСтруктуруКолонокСхемыЗаполнения()

// Получает компоновщик настроек десериализацией сохраненного в текст значения
//
// Параметры:
//  АдресКомпоновщикаНастроек - Строка, адрес во временном хранилище
//
// Возвращаемое значение:
//  КомпоновщикНастроек - компоновщик настроек компоновки данных
//
Функция ПолучитьКомпоновщикНастроек(АдресКомпоновщикаНастроек) Экспорт
	
	КомпоновщикНастроек = Неопределено;
	
	Если ЭтоАдресВременногоХранилища(АдресКомпоновщикаНастроек) Тогда
		
		СериализованноеЗначение = ПолучитьИзВременногоХранилища(АдресКомпоновщикаНастроек);
		
		Если ТипЗнч(СериализованноеЗначение) = Тип("Строка") И НЕ ПустаяСтрока(СериализованноеЗначение) Тогда
			
			ЧтениеXML = Новый ЧтениеXML;
			ЧтениеXML.УстановитьСтроку(СериализованноеЗначение);
			
			Значение = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
			Если ТипЗнч(Значение) = Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
				
				КомпоновщикНастроек = Значение;
				
			КонецЕсли;
			
			ЧтениеXML.Закрыть();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КомпоновщикНастроек;
	
КонецФункции

// Получает таблицу плана счетов в которой каждому счету соответствует родительский счет с учетом всей иерархии
// с опциональным отбором по списку счетов
//
// Параметры:
//  МассивСчетов - массив счетов для отбора
//
// Возвращаемое значение:
//  Таблица значений с колонками:
//     Ссылка - Ссылка на счет
//     Родитель - Ссылка на родительский счет, если счет первого уровня, то ссылка на счет
//
Функция ПолучитьИерархиюПланаСчетов(МассивСчетов = Неопределено) Экспорт
	
	Возврат ПолучитьИерархиюСчетов(МассивСчетов, "ПланСчетов.ЕПСБУ", Истина);
	
КонецФункции

// Получает таблицу плана счетов в которой каждому счету соответствует родительский счет
// В выборку попадают только подчиненные счета
//
// Параметры:
//  МассивСчетов - массив счетов для отбора
//
// Возвращаемое значение:
//  Таблица значений с колонками:
//     Ссылка - Ссылка на счет
//     Родитель - Ссылка на родительский счет, если счет первого уровня, то ссылка на счет
//
Функция ПолучитьИерархиюПодчиненныхСчетов(МассивСчетов, ИмяТаблицы = "ПланСчетов.ЕПСБУ") Экспорт
	
	Возврат ПолучитьИерархиюСчетов(МассивСчетов, ИмяТаблицы, Истина, Истина, Истина, Ложь, Истина);
	
КонецФункции

Функция ПолучитьПолнуюИерархиюПодчиненныхСчетов(МассивСчетов, ИмяТаблицы = "ПланСчетов.ЕПСБУ") Экспорт
	
	Возврат ПолучитьИерархиюСчетов(МассивСчетов,ИмяТаблицы, Истина, Истина, Ложь, Ложь, Истина);
	
КонецФункции

///////////////////////////////////////////////////////////
// Генерация вычисляемых полей на основании схемы запонения

// Получает схему компоновки области заполнения на основании схемы источника данных и схемы заполнения
//
// Параметры:
//  СхемаИсточника - схема компоновки источника
//  ТаблицаСхемаЗаполнения - таблица значений схемы заполнения, каждая строка группировка,
//                         - каждое поле - вычисляемое поле СКД
//  ТаблицаСхемыСвязей - таблица значений, описывает связи набора объединение источника даннх и карт данных
//  ВидСхемыЗаполнения - Строка, вид схемы заполения: горизонтальная или вертикальная
//
// Возвращаемое значение:
//  СхемаКомпоновки - схема компоновки области заполнения
//
Функция ПолучитьСхемуКомпоновки(Знач СхемаИсточника, Знач ТаблицаСхемаЗаполнения, Знач ТаблицаСхемыСвязей, Знач ВидСхемыЗаполнения) Экспорт
	
	Если ТипЗнч(СхемаИсточника) <> Тип("СхемаКомпоновкиДанных") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СхемаКомпоновки = СкопироватьСхемуКомпоновки(СхемаИсточника);
	
	СхемаКомпоновки.ПоляИтога.Очистить();
	
	НастройкиСхемы = СхемаКомпоновки.ВариантыНастроек.Основной.Настройки;
	НастройкиСхемы.Структура.Очистить();
	НастройкиСхемы.Выбор.Элементы.Очистить();
	
	Источник = Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(СхемаКомпоновки));
	
	КомпоновшикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновшикНастроек.Инициализировать(Источник);
	КомпоновшикНастроек.ЗагрузитьНастройки(НастройкиСхемы);
	
	Настройки = КомпоновшикНастроек.ПолучитьНастройки();
	
	ВычисляемыеПоля = СхемаКомпоновки.ВычисляемыеПоля;
	ДоступныеПоля = Настройки.ДоступныеПоляВыбора;
	
	ВычисляемыеПоля.Очистить();
	
	НомераПолей = Новый Соответствие;
	
	Если ТаблицаСхемаЗаполнения.Колонки.Найти("Отключить") = Неопределено Тогда
		ТаблицаСхемаЗаполнения.Колонки.Добавить("Отключить",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из ТаблицаСхемаЗаполнения Цикл
		
		Если СтрокаТаблицы.Отключить = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяГруппировка = Неопределено;
		ПутьКДанным = Неопределено;
		ГруппировкаИЛИ = Неопределено;
		
		Для каждого КолонкаТаблицы Из ТаблицаСхемаЗаполнения.Колонки Цикл
			
			// Значение агрегатной функции и группировки учитывается при обработке колонки "Значение"
			Если Лев(КолонкаТаблицы.Имя, 17) = "АгрегатнаяФункция" 
				ИЛИ Лев(КолонкаТаблицы.Имя, 14) = "ТипГруппировки"
				ИЛИ КолонкаТаблицы.Имя = "Отключить" Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Формула = СокрЛП(СтрокаТаблицы[КолонкаТаблицы.Имя]);
			
			Если НЕ ПустаяСтрока(Формула) Тогда
				
				Если ВидСхемыЗаполнения = "Вертикальная" И КолонкаТаблицы.Имя = "Значение" Тогда
					
					АгрегатнаяФункция = СтрокаТаблицы.АгрегатнаяФункцияЗначение;
					
				Иначе
					
					АгрегатнаяФункция = Неопределено;
					
				КонецЕсли;
				
				Если ВидСхемыЗаполнения = "Горизонтальная" Тогда
					
					ИмяКолонкиАгрегатнаяФункция = "АгрегатнаяФункция" + КолонкаТаблицы.Имя;
					КолонкаАгрегатнаяФункция = ТаблицаСхемаЗаполнения.Колонки.Найти(ИмяКолонкиАгрегатнаяФункция);
					Если КолонкаАгрегатнаяФункция <> Неопределено Тогда
						
						АгрегатнаяФункция = СтрокаТаблицы[ИмяКолонкиАгрегатнаяФункция];
						
					Иначе
						
						АгрегатнаяФункция = Неопределено;
						
					КонецЕсли;
					
				КонецЕсли;
				
				ИмяКолонкиТипГруппировки = "ТипГруппировки" + КолонкаТаблицы.Имя;
				КолонкаТип = ТаблицаСхемаЗаполнения.Колонки.Найти(ИмяКолонкиТипГруппировки);
				Если КолонкаТип <> Неопределено Тогда
					
					ТипГруппировки = СтрокаТаблицы[ИмяКолонкиТипГруппировки];
					
				Иначе
					
					ТипГруппировки = Неопределено;
					
				КонецЕсли;				
								
				ТребуетсяВП = Истина;
				Если ТипГруппировки = "Иерархия" ИЛИ ТипГруппировки = "Только иерархия" Тогда
					// Поля обязательно должно найтись, иначе будет ошибка, 
					// т.к. построение иерархии для вычисляемых полей в платформе не работает.
					Поле = ДоступныеПоля.НайтиПоле(Новый ПолеКомпоновкиДанных(Формула));
					Если Поле <> Неопределено Тогда
						ПутьКДанным = Строка(Поле.Поле);
						ТребуетсяВП = Ложь;
					КонецЕсли;
					
				КонецЕсли;
				
				Если ТребуетсяВП Тогда
					// Всегда используем вычисляемые поля для нормальной работы СКД на 8.3
					// Определение очередного номера имени поля, так как в разных строках по одной колонке могут быть разные поля
					Номер = НомераПолей[КолонкаТаблицы.Имя];
					
					Если Номер = Неопределено Тогда
						Номер = 0;
						ПутьКДанным = КолонкаТаблицы.Имя;
					Иначе
						Номер = Номер + 1;
						ПутьКДанным = КолонкаТаблицы.Имя + Номер;
					КонецЕсли;
					
					НомераПолей.Вставить(КолонкаТаблицы.Имя, Номер);
					
					// Создание вычисляемого поля
					ВычисляемоеПоле = ВычисляемыеПоля.Добавить();
					ВычисляемоеПоле.Выражение = Формула;
					ВычисляемоеПоле.Заголовок = КолонкаТаблицы.Имя;
					ВычисляемоеПоле.ПутьКДанным = ПутьКДанным;
				КонецЕсли;
									
				Если НоваяГруппировка = Неопределено Тогда
					
					// Создание группировки
					НоваяГруппировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
					НоваяГруппировка.Использование = Истина;
					
					НоваяГруппировка.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
					
				КонецЕсли;
				
				// Добавление поля в отбор группировки
				Если ВидСхемыЗаполнения = "Горизонтальная" И ГруппировкаИЛИ = Неопределено Тогда
					
					ГруппировкаИЛИ = НоваяГруппировка.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
					ГруппировкаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
					
				КонецЕсли;
				
				// Для колонки добавляем поле в ресурсы если заполнена соответствующая агрегатная функция
				// иначе создаем поле группировки и добавляем поля в выбранные
				Если АгрегатнаяФункция <> Неопределено И АгрегатнаяФункция <> "Нет" И НЕ ПустаяСтрока(АгрегатнаяФункция) Тогда
					
					Если СхемаКомпоновки.ПоляИтога.Найти(ПутьКДанным) = Неопределено Тогда
						
						ПолеИтога = СхемаКомпоновки.ПоляИтога.Добавить();
						ПолеИтога.Выражение = ПрименитьАгрегатнуюФункцию(ПутьКДанным, АгрегатнаяФункция);
						ПолеИтога.ПутьКДанным = ПутьКДанным;
						
					КонецЕсли;
					
					// Добавление поля в отбор группировки
					Если ВидСхемыЗаполнения = "Горизонтальная" Тогда
						
						КоллекцияОтбора =  ГруппировкаИЛИ.Элементы;
						
					Иначе
						
						КоллекцияОтбора = НоваяГруппировка.Отбор.Элементы;
						
					КонецЕсли;
					
					ДобавлятьОтбор = Истина;
					
					Для каждого ЭлементОтбора Из КоллекцияОтбора Цикл
						
						Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКДанным)
							И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
							
							ДобавлятьОтбор = Ложь;
							
							Прервать;
							
						КонецЕсли;
						
					КонецЦикла;
					
					Если ДобавлятьОтбор Тогда
						
						Если ГруппировкаИЛИ <> Неопределено Тогда
							
							ГруппировкаИЛИ.Использование = Истина;
							
						КонецЕсли;
						
						ПолеОтбораЗначения = КоллекцияОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
						ПолеОтбораЗначения.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКДанным);
						ПолеОтбораЗначения.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
						ПолеОтбораЗначения.Использование = Истина;
						
					КонецЕсли;
					
				Иначе
					
					НовоеПолеГруппировки = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
					НовоеПолеГруппировки.Использование = Истина;
					НовоеПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ПутьКДанным);
					
					Если ТипГруппировки = "Иерархия" Тогда
						НовоеПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
					ИначеЕсли ТипГруппировки = "Только иерархия" Тогда
						НовоеПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.ТолькоИерархия;
					Иначе
						НовоеПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
					КонецЕсли;
					
				КонецЕсли;
				
				// Добавление нового поля в выбранные
				ПолеВыбора = НоваяГруппировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
				ПолеВыбора.Поле = Новый ПолеКомпоновкиДанных(ПутьКДанным);
				ПолеВыбора.Заголовок = КолонкаТаблицы.Имя;
				ПолеВыбора.Использование = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗаполнениеОтчетностиСервер.СкопироватьНастройкиКомпоновкиДанных(НастройкиСхемы, Настройки);
	
	Возврат СхемаКомпоновки;
	
КонецФункции

// Получает таблицу открытия стандартных отчетов для расшифровки, заданную при настройке схемы заполнения
//
// Параметры:
//  Настройки - Строка сериализованных настроек
//  мДиспетчерXDTO - обработка "ДиспетчерСериализации"
//
// Возвращаемое значение:
//  ТаблицаНастроек - таблица значений с настройками
//
Функция ПолучитьТаблицуНастроекОткрытияТиповыхОтчетов(Знач Настройки, мДиспетчерXDTO = Неопределено, ДополнятьСчета = Ложь) Экспорт
	
	ТаблицаНастроек = Новый ТаблицаЗначений;
	
	Если ПустаяСтрока(Настройки) Тогда
		Возврат ТаблицаНастроек;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Настройки) И Лев(Настройки, 1) = """" Тогда
		Настройки = Сред(Настройки, 2);
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Настройки) И Прав(Настройки, 1) = """" Тогда
		Настройки = Сред(Настройки, 1, СтрДлина(Настройки) - 1);
	КонецЕсли;
	
	Настройки = СтрЗаменить(Настройки, """""", """");
	
	ДиспетчерСериализации = Обработки.СериализацияПравилаЗаполненияОтчетности.Создать();
	ДиспетчерСериализации.мДиспетчерXDTO = мДиспетчерXDTO;
	
	ТаблицаНастроек = ДиспетчерСериализации.ВосстановитьТаблицуНастроекДетализацииСтандартнымиОтчетами(Настройки, ДополнятьСчета);
	
	// Сохранение инициализированного диспетчера сериализации
	мДиспетчерXDTO = ДиспетчерСериализации.мДиспетчерXDTO;
	
	Возврат ТаблицаНастроек;
	
КонецФункции

// Получает схему компоновки набора источника данных с учетом заданных отборов по видам субконто
//
// Параметры:
//  СхемаКомпоновки - целевая схема компоновки (или адрес во временном хранилище)
//                  - настройки храняться в основном варианте
//
// Возвращаемое значение:
//  Схема компоновки - если передана схема компоновки
//  Адрес во временном хранилище - если передан адрес
//
Процедура ПрименитьНастройкиКСхемеКомпоновки(СхемаКомпоновки) Экспорт
	
	Если ТипЗнч(СхемаКомпоновки) = Тип("СхемаКомпоновкиДанных") Тогда
		
		Схема = СхемаКомпоновки;
		
	Иначе
		
		Схема = ПолучитьИзВременногоХранилища(СхемаКомпоновки);
		
	КонецЕсли;
	
	МаксимальноеКоличествоСубконто = ЗаполнениеОтчетностиСерверПереопределяемый.МаксимальноеКоличествоСубконто();
	ТипПустогоЗначенияСубконто = Новый ОписаниеТипов(Неопределено);
	
	НастройкиПараметрыДанных = Схема.ВариантыНастроек.Основной.Настройки.ПараметрыДанных;
	
	Для каждого ПараметрДанных Из НастройкиПараметрыДанных.Элементы Цикл
		
		ВидСубконто = Строка(ПараметрДанных.Параметр);
		
		Если ВидСубконто = "ВидыСубконто" Тогда
			ИмяПоля = "Субконто";
		ИначеЕсли ВидСубконто = "ВидыКорСубконто" Тогда
			ИмяПоля = "КорСубконто";
		ИначеЕсли ВидСубконто = "ВидыСубконтоДт" Тогда
			ИмяПоля = "СубконтоДт";
		ИначеЕсли ВидСубконто = "ВидыСубконтоКт" Тогда
			ИмяПоля = "СубконтоКт";
		Иначе
			Продолжить;
		КонецЕсли;
		
		ЗначениеПараметра = ПараметрДанных.Значение;
		Если ТипЗнч(ЗначениеПараметра) = Тип("СписокЗначений") Тогда
			
			ЭтоСписокЗначений = Истина;
			КоличествоЗаданныхВидовСубконто = ЗначениеПараметра.Количество();
			
		ИначеЕсли ТипЗнч(ЗначениеПараметра) = ЗаполнениеОтчетности.ПолучитьТипСсылкиВидыСубконто() Тогда
			
			ЭтоСписокЗначений = Ложь;
			КоличествоЗаданныхВидовСубконто = 1;
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
		Для НомСубконто = 1 По МаксимальноеКоличествоСубконто Цикл
			
			ИмяСубконто = ИмяПоля + НомСубконто;
			
			Если КоличествоЗаданныхВидовСубконто = 0 Тогда
				
				Использование = Истина;
				
			Иначе
				
				Использование = НомСубконто <= КоличествоЗаданныхВидовСубконто;
				
			КонецЕсли;
			
			ПолеНабора = Схема.НаборыДанных.НаборДанных1.Поля.Найти(ИмяСубконто);
			
			ПолеНабора.ОграничениеИспользования.Группировка = НЕ Использование;
			ПолеНабора.ОграничениеИспользования.Поле = НЕ Использование;
			ПолеНабора.ОграничениеИспользования.Порядок = НЕ Использование;
			ПолеНабора.ОграничениеИспользования.Условие = НЕ Использование;
			
			ПолеНабора.ОграничениеИспользованияРеквизитов.Группировка = НЕ Использование;
			ПолеНабора.ОграничениеИспользованияРеквизитов.Поле = НЕ Использование;
			ПолеНабора.ОграничениеИспользованияРеквизитов.Порядок = НЕ Использование;
			ПолеНабора.ОграничениеИспользованияРеквизитов.Условие = НЕ Использование;
			
			Если Использование И КоличествоЗаданныхВидовСубконто <> 0 Тогда
				
				Если ЭтоСписокЗначений Тогда
					
					Субконто = ЗначениеПараметра[НомСубконто - 1].Значение;
					
				Иначе
					
					Субконто = ЗначениеПараметра;
					
				КонецЕсли;
				
				СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Субконто,"ИмяПредопределенныхДанных,Представление, ТипЗначения");//ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Субконто,"Представление, ТипЗначения");
				
				Если ЗначениеЗаполнено(СтруктураРеквизитов.ИмяПредопределенныхДанных) Тогда
					ПолеНабора.Заголовок = СтруктураРеквизитов.ИмяПредопределенныхДанных;
				Иначе
					ПолеНабора.Заголовок = БюджетнаяОтчетность.СформироватьКодНаОснованииНаименования(СтруктураРеквизитов.Представление);
				КонецЕсли;
				
				ПолеНабора.ТипЗначения = СтруктураРеквизитов.ТипЗначения;
				
			Иначе
				
				ПолеНабора.Заголовок = "";
				ПолеНабора.ТипЗначения = ТипПустогоЗначенияСубконто;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если ТипЗнч(СхемаКомпоновки) = Тип("СхемаКомпоновкиДанных") Тогда
		
		СхемаКомпоновки = Схема;
		
	Иначе
		
		СхемаКомпоновки = ПоместитьВоВременноеХранилище(Схема, СхемаКомпоновки);
		
	КонецЕсли;
	
КонецПроцедуры

// Проверка формул вычисляемых полей
//
// Параметры:
//  ТекстФормулы - Строка, описывает текст формулы для проверки
//  МассивВызововОбщихМодулей - Массив, содержит вызовы общих модулей данной конфигурации
//  МассивРазрешенныеВызовыОбщихМодулей - Массив, содержит разрешенные вызовы
//                                      - массив определен в разделе "Функции общих модулей" макета "СправочнаяИнформацияПоМетодам"
//  МинимальнаяДлинаВызова - Число, определяющее минимальную длину строки из всех вызовов общих модулей
//  СтрокаСообщения - Строка, для сообщений об ошибках в родительский контекст
//
// Возвращаемое значение:
//  Истина - проверка прошла успешно, нет запрещенных вызовов
//  Ложь - выявлены запрещенные вызовы общих модулей
//
Функция ПроверитьФормулу(Знач ТекстФормулы, Знач МассивВызововОбщихМодулей = Неопределено, Знач МассивРазрешенныеВызовыОбщихМодулей = Неопределено, Знач МинимальнаяДлинаВызова = Неопределено, СтрокаСообщения = "") Экспорт
	
	ТекстФормулы = СокрЛП(НРег(ТекстФормулы));
	
	Если МассивВызововОбщихМодулей = Неопределено 
		И МассивРазрешенныеВызовыОбщихМодулей = Неопределено Тогда
		
		ЗапрещенныеВызовыОбщихМодулей = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьВызовыОбщихМодулей(,,,,,,,,Истина);
		
	Иначе
		
		Если ТипЗнч(МассивВызововОбщихМодулей) <> Тип("Массив") Тогда
			
			МассивВызововОбщихМодулей = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьВызовыОбщихМодулей();
			
		КонецЕсли;
		
		Если ТипЗнч(МассивРазрешенныеВызовыОбщихМодулей) <> Тип("Массив") Тогда
			
			МассивРазрешенныеВызовыОбщихМодулей =ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьРазрешенныеВызовыОбщихМодулей()
			
		КонецЕсли;
		
		
		ЗапрещенныеВызовыОбщихМодулей = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивВызововОбщихМодулей, МассивРазрешенныеВызовыОбщихМодулей);

	КонецЕсли;	
		
	Если ТипЗнч(МинимальнаяДлинаВызова) <> Тип("Число") Тогда
		
		МинимальнаяДлинаВызова = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьМинимальнуюДлинуВызова();
		
	КонецЕсли;
	
	
	Если СтрДлина(ТекстФормулы) <= МинимальнаяДлинаВызова Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	ТекстФормулы = СтрЗаменить(ТекстФормулы, Символы.ВК," ");
	ТекстФормулы = СтрЗаменить(ТекстФормулы, Символы.ВТаб," ");
	ТекстФормулы = СтрЗаменить(ТекстФормулы, Символы.НПП," ");
	ТекстФормулы = СтрЗаменить(ТекстФормулы, Символы.ПС," ");
	ТекстФормулы = СтрЗаменить(ТекстФормулы, Символы.ПФ," ");
	ТекстФормулы = СтрЗаменить(ТекстФормулы, Символы.Таб," ");
	Пока Найти(ТекстФормулы, "  ") <> 0 Цикл
		ТекстФормулы = СтрЗаменить(ТекстФормулы, "  "," ");
	КонецЦикла;
	ТекстФормулы = СтрЗаменить(ТекстФормулы, "( ","(");
	ТекстФормулы = СтрЗаменить(ТекстФормулы, " (","(");
	
	ТекстФормулы = НРег(ТекстФормулы);
	
	// Поиск метода Выполнить
	ВызовНайден = Ложь;
	НачПоз = 1;
	Пока Истина Цикл
		
		Поз = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстФормулы, "выполнить(", НачПоз);
		Если Поз = 0 Тогда
			Поз = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстФормулы, "execute(", НачПоз);
		КонецЕсли;
		
		Если Поз = 0 Тогда
			
			ВызовНайден = Ложь;
			Прервать;
			
		КонецЕсли;
		
		Если Поз = 1 Тогда
			
			ВызовНайден = Истина;
			Прервать;
			
		Иначе
			
			ПредыдущийСимвол = Сред(ТекстФормулы, Поз - 1, 1);
			
			Если Найти(" ([{,;", ПредыдущийСимвол) Тогда
				
				ВызовНайден = Истина;
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
		НачПоз = Поз + 1;
		
	КонецЦикла;
	
	Если ВызовНайден Тогда
		
		СтрокаСообщения = НСтр("ru = 'Использование функции ""Выполнить"" запрещено!'");
		
		Возврат Ложь;
		
	КонецЕсли;
	
	// Поиск прочих методов
	Поз = Найти(ТекстФормулы, ".");
	Если Поз = 0 Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	// Пременная не может иметь имя совпадающее с именем общего модуля
	Для каждого ТекстВызова Из ЗапрещенныеВызовыОбщихМодулей Цикл
		
		Если Найти(ТекстФормулы, ТекстВызова) = 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		СтрокаСообщения = НСтр("ru = 'В формуле обнаружены вызовы недоступных методов общих модулей.'");
		Возврат Ложь;
		
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Получает макет проверки области заполнения или источника области заполнения
//
// Параметры:
//  Схема - Проверяемая схема компоновки
//  СтруктураПараметров - Обшие параметры правила заполенения
//  КартыДанных - Коллекция карт данных
//
// Возвращаемое значение:
//  ТабличныйДокумент - готовый для отображения табличный документ
//
Функция СкомпоноватьТабличныйДокумент(Знач Схема, Знач СтруктураПараметров, Знач КартыДанных) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Если ТипЗнч(Схема) = Тип("СхемаКомпоновкиДанных") Тогда
		
		СтруктураАдресов = ДобавитьКартыДанныхВСхему(КартыДанных, Схема);
		
		ЗаполнитьПараметрыИзДокумента(Схема, СтруктураПараметров);
		
		// Здесь нужно инициализировать отчеты и получить по ним кросс таблицу, добавить в ПроцессорКомпоновкиДанных внешние наборы
		// если же не заданы параметры ссылок на отчеты, нужно передавать пустые таблицы по виду отчета
		СоответствиеДанных = Новый Соответствие;
		
		МассивИменПараметров = Новый Массив;
		Для Каждого ТекПараметр Из Схема.Параметры Цикл
			Если Лев(ТекПараметр.Имя,13)= "КодВидаОтчета" Тогда	
				ИмяНабора = Сред(ТекПараметр.Имя,15);
				КодВидаОтчета = ТекПараметр.Значение;
				
				ТекНастройка = СоответствиеДанных.Получить(ИмяНабора);
				Если ТекНастройка=Неопределено Тогда
					ТекНастройка = Новый Структура;
				КонецЕсли;
				ТекНастройка.Вставить("КодВидаОтчета",КодВидаОтчета);
				СоответствиеДанных.Вставить(ИмяНабора,ТекНастройка);
			ИначеЕсли Лев(ТекПараметр.Имя,27)= "ПараметрДляВыбораДокументов" Тогда	
				ИмяНабора = Сред(ТекПараметр.Имя,29);
				ИмяПараметраДляДокументов = ТекПараметр.Значение;
				
				ТекНастройка = СоответствиеДанных.Получить(ИмяНабора);
				Если ТекНастройка=Неопределено Тогда
					ТекНастройка = Новый Структура;
				КонецЕсли;
				
				ТекНастройка.Вставить("ИмяПараметраДляДокументов",ИмяПараметраДляДокументов);
						
				ТекПараметрДокументов = Схема.Параметры.Найти(ИмяПараметраДляДокументов);
				
				Если ТекПараметрДокументов <>Неопределено Тогда
					ТекНастройка.Вставить("ЗначениеПараметраДляДокументов",ТекПараметрДокументов.Значение);
				КонецЕсли;
				
				СоответствиеДанных.Вставить(ИмяНабора,ТекНастройка);
				
				МассивИменПараметров.Добавить(ИмяПараметраДляДокументов);
				
				//Заполнить первоначальные внешние источники пустыми таблицами
				КартыДанных.Вставить("ДанныеВыборки_"+ИмяПараметраДляДокументов,Новый ТаблицаЗначений);
			КонецЕсли;
		КонецЦикла;
		
		Если СоответствиеДанных.Количество()>0 Тогда
			ИнициализироватьВнешниеНаборыДанных(СоответствиеДанных,КартыДанных);
		КонецЕсли;
		
		//Инициализация внешних наборов данных для шаблонов:
		// "РазвернутыеОстатки", 
		// "РазвернутыеОстаткиИОборотыДенНеденСчетов", 
		// "РазвернутыеОстИОбКЭК",
		// "РазвернутыеОстИОбКЭКСегменты",
		// "Долгосрочная", 
		// "ДолгосрочнаяКЭК", 
		// "Просроченная",
		// "ПросроченнаяКЭК",      
		// "ИсполнениеОбязательств"
		// "РазвернутыеОстаткиКЭКНаДату"
		// "ТаблицаДляВыводаКартыДанных"
		// "ТаблицаЗадолженностьПоСрокамИсполнения"
		// "ТаблицаДанныеДля190_790"
		// "ДолгосрочныеАктивы";
		// "ТаблицаВозникновениеДтЗадолженности";
		ТаблицаРО = Неопределено;
		ТаблицаРОиОб = Неопределено;
		ТаблицаДолгосрочная = Неопределено;
		ТаблицаПросроченная = Неопределено;
		ТаблицаИсполнениеОбязательств = Неопределено;
		
		Для Каждого ТекЭлемент Из Схема.НаборыДанных.Объединение.Элементы Цикл
			Если ТипЗнч(ТекЭлемент) <> Тип("НаборДанныхОбъектСхемыКомпоновкиДанных") Тогда
				Продолжить;
			КонецЕсли;			
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаРазвернутыеОстатки_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаРазвернутыеОстатки_")+1);
				ТаблицаРО = ПолучитьВНД_РазвернутыеОстатки(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРО);			
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаРазвернутыеОстаткиКЭК_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаРазвернутыеОстаткиКЭК_")+1);
				ТаблицаРО = ПолучитьВНД_РазвернутыеОстаткиКЭК(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРО);			
			КонецЕсли;
			
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаРазвернутыеОстаткиКЭКНаДату_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаРазвернутыеОстаткиКЭКНаДату_")+1);
				ТаблицаРО = ПолучитьВНД_РазвернутыеОстаткиКЭКНаДату(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРО);			
			КонецЕсли;
			
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаРазвернутыеОстаткиКЭКПоВидамСчетовИО_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаРазвернутыеОстаткиКЭКПоВидамСчетовИО_")+1);
				ТаблицаРО = ПолучитьВНД_РазвернутыеОстаткиКЭКПоВидамСчетовИО(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРО);			
			КонецЕсли;
			
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаРазвернутыеОстаткиКЭКПоКодамПричинИО_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаРазвернутыеОстаткиКЭКПоКодамПричинИО_")+1);
				ТаблицаРО = ПолучитьВНД_РазвернутыеОстаткиКЭКПоКодамПричинИО(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРО);			
			КонецЕсли;
			
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"РазвОстИОбДенНеденСчетов_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("РазвОстИОбДенНеденСчетов_")+1);
				ТаблицаРОиОб = ПолучитьВНД_РазвернутыеОстаткиИОборотыДенежныхИНеденежных(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРОиОб);			
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"РазвОстИОбКЭК_") = 1  Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("РазвОстИОбКЭК_")+1);
				ТаблицаРОиОб = ПолучитьВНД_РазвернутыеОстаткиИОборотыКЭК(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРОиОб);			
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"РазвОстИОбКЭКСегм_") = 1  Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("РазвОстИОбКЭКСегм_")+1);
				ТаблицаРОиОб = ПолучитьВНД_РазвернутыеОстаткиИОборотыКЭКСегм(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРОиОб);			
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаДолгосрочная_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаДолгосрочная_")+1);
				ТаблицаДолгосрочная = ПолучитьВНД_Долгосрочная(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаДолгосрочная);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаДолгосрочнаяКЭК_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаДолгосрочнаяКЭК_")+1);
				ТаблицаДолгосрочная = ПолучитьВНД_ДолгосрочнаяКЭК(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаДолгосрочная);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаЗадолженностьПоСрокамИсполнения_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаЗадолженностьПоСрокамИсполнения_")+1);
				ТаблицаЗадолженностьПоСрокамИсполнения = ПолучитьВНД_ЗадолженностьПоСрокамИсполнения(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаЗадолженностьПоСрокамИсполнения);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаПросроченная_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаПросроченная_")+1);
				ТаблицаПросроченная = ПолучитьВНД_Просроченная(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаПросроченная);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаПросроченнаяКЭК_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаПросроченнаяКЭК_")+1);
				ТаблицаПросроченная = ПолучитьВНД_ПросроченнаяКЭК(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаПросроченная);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаИсполнениеОбязательств_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаИсполнениеОбязательств_")+1);
				ТаблицаИсполнениеОбязательств = ПолучитьВНД_ИсполнениеОбязательств(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаИсполнениеОбязательств);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаОбороты109_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаОбороты109_")+1);
				ТаблицаОбороты109 = ПолучитьВНД_Обороты109(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаОбороты109);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаДляВыводаКартыДанных_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаДляВыводаКартыДанных_")+1);
				ТабДляВыводаКартыДанных = ПолучитьВНД_ТаблицаДляВыводаКартыДанных();

				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТабДляВыводаКартыДанных);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаДанныеДля190_790_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаДанныеДля190_790_")+1);
				ТабДля190_790 = ПолучитьВНД_ДанныеДля190_790(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);

				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТабДля190_790);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаДолгосрочныеАктивы_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаДолгосрочныеАктивы_")+1);
				ТаблицаДолгосрочныеАктивы = ПолучитьВНД_ДолгосрочныеАктивы(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаДолгосрочныеАктивы);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаВозникновениеДтЗадолженности_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаВозникновениеДтЗадолженности_")+1);
				ТаблицаВозникновениеДтЗадолженности = ПолучитьВНД_ВозникновениеДтЗадолженности(СтруктураПараметров,СтруктураПараметров.ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаВозникновениеДтЗадолженности);
			КонецЕсли;
		КонецЦикла;
		
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		
		МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Схема.ВариантыНастроек.Основной.Настройки,,,
			Тип("ГенераторМакетаКомпоновкиДанных"),Истина);
		
		Если Схема.НаборыДанных.Объединение.Элементы.Количество() > 1 Тогда
			
			МакетКомпоновки.НаборыДанных.Объединение.Отбор = "";
			
		КонецЕсли;
		
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,КартыДанных,,Истина);
		
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.ОтображатьПроцентВывода = Истина;
		ПроцессорВывода.УстановитьДокумент(ТабличныйДокумент);
		ТабличныйДокумент = ПроцессорВывода.Вывести(ПроцессорКомпоновки,Истина);
		
		Для каждого КлючИЗначение Из СтруктураАдресов Цикл
			Если ЭтоАдресВременногоХранилища(КлючИЗначение.Значение) Тогда
				КартыДанных[КлючИЗначение.Ключ] = ПолучитьИзВременногоХранилища(КлючИЗначение.Значение);
				УдалитьИзВременногоХранилища(КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПолучитьВНД_ТаблицаДляВыводаКартыДанных() Экспорт
	
	Перем НовСтр, ТабДляВыводаКартыДанных;
	
	ТабДляВыводаКартыДанных = Новый ТаблицаЗначений;
	ТабДляВыводаКартыДанных.Колонки.Добавить("ПолеСвязиИстина",Новый ОписаниеТипов("Булево"));
	ТабДляВыводаКартыДанных.Колонки.Добавить("ПолеСвязиЛожь",Новый ОписаниеТипов("Булево"));
	НовСтр = ТабДляВыводаКартыДанных.Добавить();
	НовСтр.ПолеСвязиИстина = Истина;
	НовСтр.ПолеСвязиЛожь = Ложь;
	Возврат ТабДляВыводаКартыДанных;

КонецФункции

#Область ПолучениеВНД_РазвернутыеОстатки

//ДО 2021 (устарела) - 130/730
Функция ПолучитьВНД_РазвернутыеОстатки(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	
	
	Если ТипЗнч(КонецПериода) = Тип("Дата") Тогда
		КонецПериода = Новый Граница(КонецПериода,ВидГраницы.Включая);
	КонецЕсли;
		
	ТаблицаМетодовДополнительнойОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(ПравилоЗаполнения,,,Истина);
	КартыДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	ОбработкаЗаполнения = Обработки.ОбработкаДанныхОтчетности.Создать();
	
	Если НЕ ОбработкаЗаполнения.ПрименитьМетодыДополнительнойОбработки(КартыДанных, "КартыДанных", ТаблицаМетодовДополнительнойОбработки, ПравилоЗаполнения, Неопределено, "") Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;	
	
	ИмяКарты = "";
	ПараметрыМетода = Неопределено;
	Для каждого СтрокаТаблицы Из ТаблицаМетодовДополнительнойОбработки Цикл
		
		Если СтрокаТаблицы.МетодОбработки <> "РазвернутоеСальдо" Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыМетода = СтрокаТаблицы.Параметры.Получить();//Структура
		ИмяКарты = ПараметрыМетода.КартаДанных;
		Прервать;
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ИмяКарты) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	//В КартаРС необходимо переименовать колонки, которые используются как параметры в методе дополнения - Счет,Субконто1,Субконто2,Субконто3,
	//если их имя не совпадает с именем параметра
	
	//Если одноименные колонки уже есть, сначала удалим их, а потом переименуем нужные.
	КартаРС = КартыДанных[ИмяКарты];
	Если ПараметрыМетода.Счет <> "Счет" Тогда
		Если КартаРС.Колонки.Найти("Счет") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Счет");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Счет);
		ТекКолонка.Имя = "Счет";
	КонецЕсли;
	
	Если ПараметрыМетода.Субконто1 <> "Субконто1" Тогда
		Если КартаРС.Колонки.Найти("Субконто1") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Субконто1");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Субконто1);
		ТекКолонка.Имя = "Субконто1";
	КонецЕсли;
	
	Если ПараметрыМетода.Субконто2 <> "Субконто2" Тогда
		Если КартаРС.Колонки.Найти("Субконто2") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Субконто2");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Субконто2);
		ТекКолонка.Имя = "Субконто2";
	КонецЕсли;
	
	Если ПараметрыМетода.Субконто3 <> "Субконто3" Тогда
		Если КартаРС.Колонки.Найти("Субконто3") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Субконто3");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Субконто3);
		ТекКолонка.Имя = "Субконто3";
	КонецЕсли;
	
	ПараметрыИзДокумента = Ложь;
	Значение = Неопределено;
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") 
		И СтруктураПараметров.Свойство("ПараметрыИзДокумента",Значение)
			И ТипЗнч(Значение) = Тип("Булево") Тогда
		ПараметрыИзДокумента = Значение;
	КонецЕсли;
	
	ТипЧисло = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(18,2);
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Счет",Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДанных.Колонки.Добавить("Субконто1");
	ТаблицаДанных.Колонки.Добавить("Субконто2");
	ТаблицаДанных.Колонки.Добавить("Субконто3");
	ТаблицаДанных.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("КПС",Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДанных.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДанных.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДанных.Колонки.Добавить("КЭК",Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	
	//Для баланса нужны суммы только развернутого начального и конечного остатка
	
	ТаблицаДанных.Колонки.Добавить("НачальныйОстатокДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("НачальныйОстатокКт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("КонечныйОстатокДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("КонечныйОстатокКт",ТипЧисло);
	
	//Для заполнения суммы исправления ошибок используем СуммаОборот по счетам исправления ошибок
	
	ТаблицаДанных.Колонки.Добавить("СуммаИООборот",ТипЧисло);
	
	СтруктураПолейОтбора = Новый Структура;
	
	Условие = "";
	УсловиеБаланс = "";
	ЕстьИФО = Ложь;
	
	Если ТипЗнч(ИФО) = Тип("Структура") Тогда
		Если ИФО.Свойство("Использование") 
			И ИФО.Использование = Истина Тогда
			ЕстьИФО = Истина;
			
			Если ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеБаланс = " И ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеБаланс = " И ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеБаланс = " И ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеБаланс = " И НЕ ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеБаланс = " И ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеБаланс = " И ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ИФО <> Неопределено Тогда
		ЕстьИФО = Истина;
		Если ТипЗнч(ИФО) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
			УсловиеБаланс = " И ИФО = &ИФО";
			СтруктураПолейОтбора.Вставить("ИФО",ИФО);
		КонецЕсли;
	КонецЕсли;
	
	УсловиеОрганизация = "";
	
	Если ТипЗнч(Организация) = Тип("Структура") Тогда
		Если Организация.Свойство("Использование") 
			И Организация.Использование = Истина Тогда
			
			Если Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеОрганизация = " И Организация = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеОрганизация = " И Организация <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеОрганизация = " И Организация В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеОрганизация = " И НЕ Организация В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеОрганизация = " И Организация <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеОрганизация = " И Организация = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		УсловиеОрганизация = " И Организация = &Организация";
		СтруктураПолейОтбора.Вставить("Организация",Организация);
	КонецЕсли;	
	
	Условие = УсловиеБаланс + УсловиеОрганизация;
	Условие = Сред(Условие,3);		
		
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ИФО",ЕстьИФО);//Истина); - необходимо определять нужность ИФО в зависимости от параметров
	СтруктураПолей.Вставить("КПС",Истина);//нужен всегда
	СтруктураПолей.Вставить("ВидКПС",Ложь);//для баланса не нужен
	СтруктураПолей.Вставить("Субконто1",Истина);//-меняется динамически
	СтруктураПолей.Вставить("Субконто2",Истина);//-меняется динамически
	СтруктураПолей.Вставить("Субконто3",Истина);//-меняется динамически
	СтруктураПолей.Вставить("КЭК",Ложь);// - не используется до 2021 года
	
	//Счета исправления ошибок
	ПараметрСчетаИО = ПараметрыСхемы.Найти("СчетаИсправленияОшибок_"+ИмяНабора);
	Если ПараметрСчетаИО <> Неопределено Тогда
		МассивСчетовИО = БухгалтерскийУчет.СписокСчетов(ПараметрСчетаИО.Значение);
	Иначе	
		МассивСчетовИО = БухгалтерскийУчет.СписокСчетов("304.84, 304.94, 304.66, 304.76, 304.86, 304.96, 
														|401.16, 401.17, 401.18, 401.19, 
														|401.26, 401.27, 401.28, 401.29");
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Ложь,Ложь,Ложь);//0
	ДополнитьТаблицуПоРазворотуСубконто(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО);	

	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Истина,Ложь,Ложь);//1
	ДополнитьТаблицуПоРазворотуСубконто(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО);	
	
	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Ложь,Истина,Ложь);//2
	ДополнитьТаблицуПоРазворотуСубконто(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО);	

	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Ложь,Ложь,Истина);//3
	ДополнитьТаблицуПоРазворотуСубконто(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО);	
	
	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Истина,Истина,Ложь);//1,2
	ДополнитьТаблицуПоРазворотуСубконто(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО);	
	
	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Истина,Ложь,Истина);//1,3
	ДополнитьТаблицуПоРазворотуСубконто(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО);	
	
	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Ложь,Истина,Истина);//2,3
	ДополнитьТаблицуПоРазворотуСубконто(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО);	
	
	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Истина,Истина,Истина);//1,2,3
	ДополнитьТаблицуПоРазворотуСубконто(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО);	
	
	//КЭК убираем, т.к. остатки по счетам
	ТаблицаДанных.Свернуть("Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ИФО,КФО","НачальныйОстатокДт,НачальныйОстатокКт,КонечныйОстатокДт,КонечныйОстатокКт,СуммаИООборот");
	//ТаблицаДанных.Сортировать("Организация,Счет,КФО,КПС,Субконто1,Субконто2,Субконто3,ИФО");
	                                                                                                                                                 
	//Далее необходимо распределить СуммаИООборот отдельно на исправление дебиторской задолженности и отдельно на исправление кредиторской задолженности,
	//И только после этого свернуть таблицу по субконто, чтобы получить обобщенные остатки
	
	ТаблицаДанных.Колонки.Добавить("СуммаИОДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("СуммаИОКт",ТипЧисло);
	
	//Если вид счета Пассивный - то положительной суммой правим Кт сумму,
			
	Для Каждого СтрТЧ Из ТаблицаДанных Цикл
		Если СтрТЧ.СуммаИООборот=0 Тогда
			Продолжить;
		КонецЕсли;
		//Если сумма исправления >0 и есть КТ задолженность, нужно сначала уменьшить остаток по Кт,
		//а на оставшуюся сумму увеличить дт
		Если СтрТЧ.СуммаИООборот>0
			И СтрТЧ.НачальныйОстатокКт>0 Тогда
			
			СтрТЧ.СуммаИОКт = - Мин(СтрТЧ.СуммаИООборот,СтрТЧ.НачальныйОстатокКт); //уменьшаем остаток, знак минус
			СтрТЧ.СуммаИОДт = СтрТЧ.СуммаИООборот + СтрТЧ.СуммаИОКт;//складываем, т.к. СуммаИОКт - отрицательная
			
		//Если сумма исправления <0 и есть ДТ задолженность, нужно сначала уменьшить остаток по ДТ,
		//а на оставшуюся сумму увеличить КТ	
		ИначеЕсли СтрТЧ.СуммаИООборот<0
			И СтрТЧ.НачальныйОстатокДт>0 Тогда
			
			СуммаИООборотПоложительная = -1*СтрТЧ.СуммаИООборот;
			
			СтрТЧ.СуммаИОДт = - Мин(СуммаИООборотПоложительная,СтрТЧ.НачальныйОстатокДт); //уменьшаем остаток, знак минус
			СтрТЧ.СуммаИОКт = СуммаИООборотПоложительная + СтрТЧ.СуммаИОДт;//складываем, т.к. СуммаИОДт - отрицательная
			
		//НЕТ КТ задолженности и сумма исправления >0, тогда вся сумма исправления это увеличение ДТ	
		ИначеЕсли СтрТЧ.СуммаИООборот>0 Тогда
			
			СтрТЧ.СуммаИОДт = СтрТЧ.СуммаИООборот;
			СтрТЧ.СуммаИОКт = 0;
			
		//НЕТ ДТ задолженности и сумма исправления <0, тогда вся сумма исправления это увеличение КТ	
		ИначеЕсли СтрТЧ.СуммаИООборот<0 Тогда

		    СтрТЧ.СуммаИОДт = 0;
			СтрТЧ.СуммаИОКт = -СтрТЧ.СуммаИООборот;
			
		КонецЕсли;
	КонецЦикла;
	
	//После того как распределили задолженность, можно свернуть таблицу детальных данных
	//КПС в данном наборе не нужен, по нему свернем
	//По организации и ИФО сворачивать нельзя никогда, 
	//т.к. в правилах заполнения на набор дополнительно накладываются по ним отбор
	ТаблицаДанных.Свернуть("Счет,Организация,ИФО,КФО","НачальныйОстатокДт,НачальныйОстатокКт,КонечныйОстатокДт,КонечныйОстатокКт,СуммаИОДт,СуммаИОКт");
	
	КартаРС = Неопределено;
	
	Возврат ТаблицаДанных;
	
КонецФункции

//С 2021    - 130/730
Функция ПолучитьВНД_РазвернутыеОстаткиКЭК(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	
	
	Если ТипЗнч(КонецПериода) = Тип("Дата") Тогда
		КонецПериода = Новый Граница(КонецПериода,ВидГраницы.Включая);
	КонецЕсли;
		
	ТаблицаМетодовДополнительнойОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(ПравилоЗаполнения,,,Истина);
	КартыДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	ОбработкаЗаполнения = Обработки.ОбработкаДанныхОтчетности.Создать();
	
	Если НЕ ОбработкаЗаполнения.ПрименитьМетодыДополнительнойОбработки(КартыДанных, "КартыДанных", ТаблицаМетодовДополнительнойОбработки, ПравилоЗаполнения, Неопределено, "") Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;	
	
	ИмяКарты = "";
	ПараметрыМетода = Неопределено;
	Для каждого СтрокаТаблицы Из ТаблицаМетодовДополнительнойОбработки Цикл
		
		Если СтрокаТаблицы.МетодОбработки <> "РазвернутоеСальдо" Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыМетода = СтрокаТаблицы.Параметры.Получить();//Структура
		ИмяКарты = ПараметрыМетода.КартаДанных;
		Прервать;
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ИмяКарты) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	//В КартаРС необходимо переименовать колонки, которые используются как параметры в методе дополнения - Счет,Субконто1,Субконто2,Субконто3,
	//если их имя не совпадает с именем параметра
	
	//Если одноименные колонки уже есть, сначала удалим их, а потом переименуем нужные.
	КартаРС = КартыДанных[ИмяКарты];
	Если ПараметрыМетода.Счет <> "Счет" Тогда
		Если КартаРС.Колонки.Найти("Счет") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Счет");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Счет);
		ТекКолонка.Имя = "Счет";
	КонецЕсли;
	
	Если ПараметрыМетода.Субконто1 <> "Субконто1" Тогда
		Если КартаРС.Колонки.Найти("Субконто1") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Субконто1");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Субконто1);
		ТекКолонка.Имя = "Субконто1";
	КонецЕсли;
	
	Если ПараметрыМетода.Субконто2 <> "Субконто2" Тогда
		Если КартаРС.Колонки.Найти("Субконто2") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Субконто2");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Субконто2);
		ТекКолонка.Имя = "Субконто2";
	КонецЕсли;
	
	Если ПараметрыМетода.Субконто3 <> "Субконто3" Тогда
		Если КартаРС.Колонки.Найти("Субконто3") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Субконто3");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Субконто3);
		ТекКолонка.Имя = "Субконто3";
	КонецЕсли;
	
	ПараметрыИзДокумента = Ложь;
	Значение = Неопределено;
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") 
		И СтруктураПараметров.Свойство("ПараметрыИзДокумента",Значение)
			И ТипЗнч(Значение) = Тип("Булево") Тогда
		ПараметрыИзДокумента = Значение;
	КонецЕсли;
	
	СоответствиеСчетаБезКЭК = Новый Соответствие;
	
	УчитыватьКартуКЭК000 = Истина;//общая настройка правила заполнения на использование карты данных СчетаБезКЭК
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("УчитыватьКартуКЭК000") Тогда
		
		Если ТипЗнч(ДополнительныеПараметры.УчитыватьКартуКЭК000) = Тип("Структура") Тогда
			
			Если ДополнительныеПараметры.УчитыватьКартуКЭК000.Свойство("ПравоеЗначение")
				И ДополнительныеПараметры.УчитыватьКартуКЭК000.ПравоеЗначение = Ложь Тогда
				
				УчитыватьКартуКЭК000 = Ложь;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДополнительныеПараметры.УчитыватьКартуКЭК000) = Тип("Булево") Тогда
			
			УчитыватьКартуКЭК000 = ДополнительныеПараметры.УчитыватьКартуКЭК000;
			
		КонецЕсли;
		
	КонецЕсли;
	
	КартаСчетовБезКЭК = Неопределено;
	Если УчитыватьКартуКЭК000 = Истина
		И КартыДанных.Свойство("СчетаБезКЭК",КартаСчетовБезКЭК) Тогда
		Если КартаСчетовБезКЭК.Колонки.Найти("Счет") <> Неопределено
			И КартаСчетовБезКЭК.Колонки.Найти("Использовать")<> Неопределено Тогда
			
			Для Каждого СтрКарты Из КартаСчетовБезКЭК.НайтиСтроки(Новый Структура("Использовать",Истина)) Цикл
				СоответствиеСчетаБезКЭК.Вставить(СтрКарты.Счет,Истина);	
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	ТипЧисло = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(18,2);
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Счет",Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДанных.Колонки.Добавить("Субконто1");
	ТаблицаДанных.Колонки.Добавить("Субконто2");
	ТаблицаДанных.Колонки.Добавить("Субконто3");
	ТаблицаДанных.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("КПС",Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДанных.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДанных.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДанных.Колонки.Добавить("КЭК",Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	
	//Для баланса нужны суммы только развернутого начального и конечного остатка
	
	ТаблицаДанных.Колонки.Добавить("НачальныйОстатокДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("НачальныйОстатокКт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("КонечныйОстатокДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("КонечныйОстатокКт",ТипЧисло);
	
	//Для заполнения суммы исправления ошибок используем СуммаОборот по счетам исправления ошибок
	
	ТаблицаДанных.Колонки.Добавить("СуммаИООборот",ТипЧисло);
	
	СтруктураПолейОтбора = Новый Структура;
	
	Условие = "";
	УсловиеБаланс = "";
	ЕстьИФО = Ложь;
	
	Если ТипЗнч(ИФО) = Тип("Структура") Тогда
		Если ИФО.Свойство("Использование") 
			И ИФО.Использование = Истина Тогда
			ЕстьИФО = Истина;
			
			Если ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеБаланс = " И ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеБаланс = " И ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеБаланс = " И ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеБаланс = " И НЕ ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеБаланс = " И ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеБаланс = " И ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ИФО <> Неопределено Тогда
		ЕстьИФО = Истина;
		Если ТипЗнч(ИФО) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
			УсловиеБаланс = " И ИФО = &ИФО";
			СтруктураПолейОтбора.Вставить("ИФО",ИФО);
		КонецЕсли;
	КонецЕсли;
	
	УсловиеОрганизация = "";
	
	Если ТипЗнч(Организация) = Тип("Структура") Тогда
		Если Организация.Свойство("Использование") 
			И Организация.Использование = Истина Тогда
			
			Если Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеОрганизация = " И Организация = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеОрганизация = " И Организация <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеОрганизация = " И Организация В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеОрганизация = " И НЕ Организация В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеОрганизация = " И Организация <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеОрганизация = " И Организация = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		УсловиеОрганизация = " И Организация = &Организация";
		СтруктураПолейОтбора.Вставить("Организация",Организация);
	КонецЕсли;	
	
	Условие = УсловиеБаланс + УсловиеОрганизация;
	Условие = Сред(Условие,3);		
		
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ИФО",ЕстьИФО);//Истина); - необходимо определять нужность ИФО в зависимости от параметров
	СтруктураПолей.Вставить("КПС",Истина);//нужен всегда
	СтруктураПолей.Вставить("ВидКПС",Ложь);//для баланса не нужен
	СтруктураПолей.Вставить("Субконто1",Истина);//-меняется динамически
	СтруктураПолей.Вставить("Субконто2",Истина);//-меняется динамически
	СтруктураПолей.Вставить("Субконто3",Истина);//-меняется динамически
	СтруктураПолей.Вставить("КЭК",Истина);// - используется с 2021 года
	
	//Счета исправления ошибок
	ПараметрСчетаИО = ПараметрыСхемы.Найти("СчетаИсправленияОшибок_"+ИмяНабора);
	Если ПараметрСчетаИО <> Неопределено Тогда
		МассивСчетовИО = БухгалтерскийУчет.СписокСчетов(ПараметрСчетаИО.Значение);
	Иначе	
		МассивСчетовИО = БухгалтерскийУчет.СписокСчетов("304.66, 304.76, 304.86, 304.96, 
														|401.16, 401.17, 401.18, 401.19, 
														|401.26, 401.27, 401.28, 401.29");
	КонецЕсли;
	
	ДополнитьТаблицуПоДаннымОстатковИОборотовОбщая(ТаблицаДанных, КартаРС, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода);
	
	ТаблицаДанных.Свернуть("Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ИФО,КФО,КЭК","НачальныйОстатокДт,НачальныйОстатокКт,КонечныйОстатокДт,КонечныйОстатокКт,СуммаИООборот");
	
	ДополнитьТаблицуПоДаннымИсправленияОшибокОбщая(ТаблицаДанных, КартаРС, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО);
	
	//КЭК НЕ убираем, т.к. теперь в разрезе КЭК нужны данные
	ТаблицаДанных.Свернуть("Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ИФО,КФО,КЭК","НачальныйОстатокДт,НачальныйОстатокКт,КонечныйОстатокДт,КонечныйОстатокКт,СуммаИООборот");
	//ТаблицаДанных.Сортировать("Организация,Счет,КФО,КПС,Субконто1,Субконто2,Субконто3,ИФО");
		
	ЗаполнитьДетальныйКЭКВТаблицеДанных(ТаблицаДанных,СоответствиеСчетаБезКЭК);
		
	ТаблицаДанных.Свернуть("Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ИФО,КФО,КЭК","НачальныйОстатокДт,НачальныйОстатокКт,КонечныйОстатокДт,КонечныйОстатокКт,СуммаИООборот");
	
	//Т.к. в начале года остатки на 001-009, в середине года обороты по 56х/66х и 73х/83х, то после замены кэк нужно исправить конечные остатки,
	//иначе получится, что если до замены было: 
	//по 001 остаток на начало по дт 100,
	//по 561/661 оборот в кт 150
	//и на конец года будет по 001 остаток по дт 100, а по 561/661 остаток по кт 150.
	//А должно быть по 001 остаток на конец по кт 50, и все.
	
	Для Каждого СтрТЧ Из ТаблицаДанных Цикл
		//т.к. форма может заполняться не с начала года, то остатки на начало отчетного периода могут быть на разных КЭК - 561/661,
		//необходимо их объединить
		Если СтрТЧ.НачальныйОстатокДт <> 0
			ИЛИ СтрТЧ.НачальныйОстатокКт <> 0 Тогда
			
			Если СтрТЧ.НачальныйОстатокДт >= СтрТЧ.НачальныйОстатокКт Тогда
				СтрТЧ.НачальныйОстатокДт = СтрТЧ.НачальныйОстатокДт - СтрТЧ.НачальныйОстатокКт;
				СтрТЧ.НачальныйОстатокКт = 0;
			Иначе
				СтрТЧ.НачальныйОстатокКт = СтрТЧ.НачальныйОстатокКт - СтрТЧ.НачальныйОстатокДт;
				СтрТЧ.НачальныйОстатокДт = 0;
			КонецЕсли;
			
		КонецЕсли;
	
		
		Если СтрТЧ.КонечныйОстатокДт <> 0
			ИЛИ СтрТЧ.КонечныйОстатокКт <> 0 Тогда
				
			Если СтрТЧ.КонечныйОстатокДт >= СтрТЧ.КонечныйОстатокКт Тогда
				СтрТЧ.КонечныйОстатокДт = СтрТЧ.КонечныйОстатокДт - СтрТЧ.КонечныйОстатокКт;
				СтрТЧ.КонечныйОстатокКт = 0;
			Иначе
				СтрТЧ.КонечныйОстатокКт = СтрТЧ.КонечныйОстатокКт - СтрТЧ.КонечныйОстатокДт;
				СтрТЧ.КонечныйОстатокДт = 0;
			КонецЕсли;
		
		КонецЕсли;
	КонецЦикла;
	
	//Далее необходимо распределить СуммаИООборот отдельно на исправление дебиторской задолженности и отдельно на исправление кредиторской задолженности,
	//И только после этого свернуть таблицу по субконто, чтобы получить обобщенные остатки
	
	ТаблицаДанных.Колонки.Добавить("СуммаИОДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("СуммаИОКт",ТипЧисло);
	
	//Если вид счета Пассивный - то положительной суммой правим Кт сумму,
			
	Для Каждого СтрТЧ Из ТаблицаДанных Цикл
		Если СтрТЧ.СуммаИООборот=0 Тогда
			Продолжить;
		КонецЕсли;
		//Если сумма исправления >0 и есть КТ задолженность, нужно сначала уменьшить остаток по Кт,
		//а на оставшуюся сумму увеличить дт
		Если СтрТЧ.СуммаИООборот>0
			И СтрТЧ.НачальныйОстатокКт>0 Тогда
			
			СтрТЧ.СуммаИОКт = - Мин(СтрТЧ.СуммаИООборот,СтрТЧ.НачальныйОстатокКт); //уменьшаем остаток, знак минус
			СтрТЧ.СуммаИОДт = СтрТЧ.СуммаИООборот + СтрТЧ.СуммаИОКт;//складываем, т.к. СуммаИОКт - отрицательная
			
		//Если сумма исправления <0 и есть ДТ задолженность, нужно сначала уменьшить остаток по ДТ,
		//а на оставшуюся сумму увеличить КТ	
		ИначеЕсли СтрТЧ.СуммаИООборот<0
			И СтрТЧ.НачальныйОстатокДт>0 Тогда
			
			СуммаИООборотПоложительная = -1*СтрТЧ.СуммаИООборот;
			
			СтрТЧ.СуммаИОДт = - Мин(СуммаИООборотПоложительная,СтрТЧ.НачальныйОстатокДт); //уменьшаем остаток, знак минус
			СтрТЧ.СуммаИОКт = СуммаИООборотПоложительная + СтрТЧ.СуммаИОДт;//складываем, т.к. СуммаИОДт - отрицательная
			
		//НЕТ КТ задолженности и сумма исправления >0, тогда вся сумма исправления это увеличение ДТ	
		ИначеЕсли СтрТЧ.СуммаИООборот>0 Тогда
			
			СтрТЧ.СуммаИОДт = СтрТЧ.СуммаИООборот;
			СтрТЧ.СуммаИОКт = 0;
			
		//НЕТ ДТ задолженности и сумма исправления <0, тогда вся сумма исправления это увеличение КТ	
		ИначеЕсли СтрТЧ.СуммаИООборот<0 Тогда

		    СтрТЧ.СуммаИОДт = 0;
			СтрТЧ.СуммаИОКт = -СтрТЧ.СуммаИООборот;
			
		КонецЕсли;
	КонецЦикла;
	
	//После того как распределили задолженность, можно свернуть таблицу детальных данных
	//КПС в данном наборе не нужен, по нему свернем.
	//По организации и ИФО сворачивать нельзя никогда, 
	//т.к. в правилах заполнения на набор дополнительно накладываются по ним отбор.
	//КЭК теперь не нужно, его убираем.
	ТаблицаДанных.Свернуть("Счет,Организация,ИФО,КФО","НачальныйОстатокДт,НачальныйОстатокКт,КонечныйОстатокДт,КонечныйОстатокКт,СуммаИОДт,СуммаИОКт");
	
	КартаРС = Неопределено;
	
	Возврат ТаблицаДанных;
	
КонецФункции

//с 2021 для 173/773
Функция ПолучитьВНД_РазвернутыеОстаткиКЭКПоВидамСчетовИО(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Возврат ЗаполнитьТаблицыРазвернутыхОстатковКЭКПоВидамСчетовИКодамПричин(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы, Ложь);		
	
КонецФункции

//с 2021 для 173/773 для 4 раздела по кодам причин
Функция ПолучитьВНД_РазвернутыеОстаткиКЭКПоКодамПричинИО(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Возврат ЗаполнитьТаблицыРазвернутыхОстатковКЭКПоВидамСчетовИКодамПричин(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы, Истина);		
	
КонецФункции

Функция ЗаполнитьТаблицыРазвернутыхОстатковКЭКПоВидамСчетовИКодамПричин(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы, ВернутьТаблицуПоКодамПричин = Ложь)
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	
	
	Если ТипЗнч(КонецПериода) = Тип("Дата") Тогда
		КонецПериода = Новый Граница(КонецПериода,ВидГраницы.Включая);
	КонецЕсли;
		
	ТаблицаМетодовДополнительнойОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(ПравилоЗаполнения,,,Истина);
	КартыДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	ОбработкаЗаполнения = Обработки.ОбработкаДанныхОтчетности.Создать();
	
	Если НЕ ОбработкаЗаполнения.ПрименитьМетодыДополнительнойОбработки(КартыДанных, "КартыДанных", ТаблицаМетодовДополнительнойОбработки, ПравилоЗаполнения, Неопределено, "") Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;	
	
	ИмяКарты = "";
	ПараметрыМетода = Неопределено;
	Для каждого СтрокаТаблицы Из ТаблицаМетодовДополнительнойОбработки Цикл
		
		Если СтрокаТаблицы.МетодОбработки <> "РазвернутоеСальдо" Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыМетода = СтрокаТаблицы.Параметры.Получить();//Структура
		ИмяКарты = ПараметрыМетода.КартаДанных;
		Прервать;
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ИмяКарты) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	//В КартаРС необходимо переименовать колонки, которые используются как параметры в методе дополнения - Счет,Субконто1,Субконто2,Субконто3,
	//если их имя не совпадает с именем параметра
	
	//Если одноименные колонки уже есть, сначала удалим их, а потом переименуем нужные.
	КартаРС = КартыДанных[ИмяКарты];
	Если ПараметрыМетода.Счет <> "Счет" Тогда
		Если КартаРС.Колонки.Найти("Счет") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Счет");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Счет);
		ТекКолонка.Имя = "Счет";
	КонецЕсли;
	
	Если ПараметрыМетода.Субконто1 <> "Субконто1" Тогда
		Если КартаРС.Колонки.Найти("Субконто1") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Субконто1");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Субконто1);
		ТекКолонка.Имя = "Субконто1";
	КонецЕсли;
	
	Если ПараметрыМетода.Субконто2 <> "Субконто2" Тогда
		Если КартаРС.Колонки.Найти("Субконто2") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Субконто2");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Субконто2);
		ТекКолонка.Имя = "Субконто2";
	КонецЕсли;
	
	Если ПараметрыМетода.Субконто3 <> "Субконто3" Тогда
		Если КартаРС.Колонки.Найти("Субконто3") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Субконто3");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Субконто3);
		ТекКолонка.Имя = "Субконто3";
	КонецЕсли;
	
	ПараметрыИзДокумента = Ложь;
	Значение = Неопределено;
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") 
		И СтруктураПараметров.Свойство("ПараметрыИзДокумента",Значение)
			И ТипЗнч(Значение) = Тип("Булево") Тогда
		ПараметрыИзДокумента = Значение;
	КонецЕсли;
	
	СоответствиеСчетаБезКЭК = Новый Соответствие;
	
	УчитыватьКартуКЭК000 = Истина;//общая настройка правила заполнения на использование карты данных СчетаБезКЭК
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("УчитыватьКартуКЭК000") Тогда
		
		Если ТипЗнч(ДополнительныеПараметры.УчитыватьКартуКЭК000) = Тип("Структура") Тогда
			
			Если ДополнительныеПараметры.УчитыватьКартуКЭК000.Свойство("ПравоеЗначение")
