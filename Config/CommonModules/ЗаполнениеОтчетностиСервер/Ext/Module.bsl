Процедура ЗаполнитьПоляСхемы(ЭлементНабора, НаборОбъединение, КоллекцияПолейШаблона, НастройкиШаблона, НаименованиеНабора = "")
	
	Для каждого Поле Из КоллекцияПолейШаблона Цикл
		
		ЭтоСубконто = Найти(Поле.Поле, "Субконто") <> 0;
		
		ПутьКДанным = Поле.ПутьКДанным;
		
		ПолеЭлементаНабора = ЭлементНабора.Поля.Найти(ПутьКДанным);
		
		Если ПолеЭлементаНабора = Неопределено Тогда
			
			Если ЭтоСубконто Тогда
				
				Если Поле.ОграничениеИспользования.Поле Тогда
					
					ЭлементНабора.Запрос = ЗаполнениеОтчетностиКлиентСервер.УдалитьПолеЗапроса(ЭлементНабора.Запрос, Поле.Поле);
					МассивУдаляемыхПолей = Новый Массив;
					
					Для каждого ВыбранноеПоле Из НастройкиШаблона.Выбор.Элементы Цикл
						Если Строка(ВыбранноеПоле.Поле) = Поле.Поле И МассивУдаляемыхПолей.Найти(ВыбранноеПоле) = Неопределено Тогда
							МассивУдаляемыхПолей.Добавить(ВыбранноеПоле);
						КонецЕсли;
					КонецЦикла;
					Для каждого ВыбранноеПоле Из МассивУдаляемыхПолей Цикл
						НастройкиШаблона.Выбор.Элементы.Удалить(ВыбранноеПоле);
					КонецЦикла;
					
					Продолжить;
					
				Иначе
					
					Если ЗначениеЗаполнено(Поле.Заголовок) И ЗначениеЗаполнено(Поле.ТипЗначения) Тогда
						
						ЭлементНабора.Запрос = ВыразитьПолеЗапроса(ЭлементНабора.Запрос, Поле.Поле, Поле.ТипЗначения, Поле.Заголовок);
						
						ПолеЭлементаНабора = ЭлементНабора.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
						ЗаполнитьЗначенияСвойств(ПолеЭлементаНабора, Поле,, "Поле, ПутьКДанным, Заголовок, ТипЗначения");
						
						ПолеЭлементаНабора.Поле = Поле.Заголовок;
						ПолеЭлементаНабора.ПутьКДанным = Поле.Заголовок;
						ПолеЭлементаНабора.ТипЗначения = Поле.ТипЗначения;
						
						Для каждого ВыбранноеПоле Из НастройкиШаблона.Выбор.Элементы Цикл
							Если Строка(ВыбранноеПоле.Поле) = Поле.Поле Тогда
								ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(Поле.Заголовок);
							КонецЕсли;
						КонецЦикла;
						
					Иначе
						
						ПолеЭлементаНабора = ЭлементНабора.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
						ЗаполнитьЗначенияСвойств(ПолеЭлементаНабора, Поле,, "Заголовок, ТипЗначения");
						ПолеЭлементаНабора.ТипЗначения = Поле.ТипЗначения;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				
				ПолеЭлементаНабора = ЭлементНабора.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
				ЗаполнитьЗначенияСвойств(ПолеЭлементаНабора, Поле);
				
			КонецЕсли;
			
			ПолеЭлементаНабора.Роль.Обязательное = Поле.Роль.Обязательное;
			
		КонецЕсли;
		
		Если Найти(ПолеЭлементаНабора.ПутьКДанным, ".") <> 0 Тогда
			
			ПутьКДаннымОбъединение = ПолеЭлементаНабора.ПутьКДанным;
			
			ПолеЭлементаНабора.ПутьКДанным = НаименованиеНабора + "_" + СтрЗаменить(ПолеЭлементаНабора.ПутьКДанным, ".", "_");
			
			ПолеОбъединение = ПолеЭлементаНабора.ПутьКДанным;
			
		Иначе
			
			ПутьКДаннымОбъединение = ПолеЭлементаНабора.ПутьКДанным;
			ПолеОбъединение = ПолеЭлементаНабора.Поле;
			
		КонецЕсли;
		
		ПолеНабораОбъединения = НаборОбъединение.Поля.Найти(ПолеЭлементаНабора.ПутьКДанным);
		Если ПолеНабораОбъединения = Неопределено Тогда
			
			ПолеНабораОбъединения = НаборОбъединение.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(ПолеНабораОбъединения, ПолеЭлементаНабора);
			
			ПолеНабораОбъединения.Поле = ПолеОбъединение;
			ПолеНабораОбъединения.ПутьКДанным = ПутьКДаннымОбъединение;
			
		КонецЕсли;
		
		ПолеНабораОбъединения.Роль.Обязательное = Поле.Роль.Обязательное;
		
	КонецЦикла;
	
КонецПроцедуры 

// Получает модифицированный текст запроса в котором поля выражены переданным типом
//
// Параметры:
//  ТекстЗапроса - Текст запроса
//  ИмяПоля - Имя поля запроса, поиск осуществляется по шаблону: "//" + ИмяПоля + Постфикс
//          - Постфикс: _Поле, _ДоступноеПоле, _ПараметрВТ
//  ТипЗначения - Тип значения поля
//  Заголовок - Псевдоним поля
//
// Возвращаемое значение:
//  ТекстЗапроса - модифицированный текст запроса
//
Функция ВыразитьПолеЗапроса(Знач ТекстЗапроса, Знач ИмяПоля, Знач ТипЗначения, Знач Заголовок) Экспорт
	
	// Поле запроса
	ТекстЗапроса1 = НРег(ТекстЗапроса);
	ИмяПоля1 = НРег("//"+ИмяПоля + "_Поле");
	
	Поз = Найти(ТекстЗапроса1, ИмяПоля1);
	
	Если Поз <> 0 Тогда
		
		СтрокаТипа = ЗаполнениеОтчетности.ВернутьСтрокуТипаПоТипу(ТипЗначения.Типы()[0], "Запрос");
		ДлинаСтрокиТипа = СтрДлина(СтрокаТипа);
		
		Пока Поз <> 0 Цикл
			
			Начало = Поз;
			Конец = 0;
			
			Если ЗаполнениеОтчетностиКлиентСервер.ВыделитьПолеЗапроса(ТекстЗапроса1, Начало, Конец) Тогда
				
				ТекстЗапроса = ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, 1, Начало - 1) + "ВЫРАЗИТЬ(" + ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, Начало, Конец) + " КАК " + СтрокаТипа + ") " + ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, Конец + 1);
				
				ТекстЗапроса1 = НРег(ТекстЗапроса);
				
			Иначе
				
				Продолжить;
				
			КонецЕсли;
			
			Поз = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстЗапроса1, ИмяПоля1, Начало);
			Если Поз <> 0 Тогда
				
				Поз = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстЗапроса1, ИмяПоля1, Поз + 1);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Выбранное поле запроса
	ТекстЗапроса1 = НРег(ТекстЗапроса);
	ИмяПоля2 = НРег("//"+ИмяПоля + "_ДоступноеПоле");
	
	Поз = Найти(ТекстЗапроса1, ИмяПоля2);
	
	Пока Поз <> 0 Цикл
		
		Начало = Поз;
		Конец = 0;
		
		Если ЗаполнениеОтчетностиКлиентСервер.ВыделитьПолеЗапроса(ТекстЗапроса1, Начало, Конец) Тогда
			
			ПредставлениеПоля = " КАК " + Заголовок;
			
			ПозТочка = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстЗапроса, ".", Начало, Конец);
			ПозКАК = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстЗапроса, "КАК", Конец, Поз);
			
			Если ПозКАК = 0 Тогда
				
				ТекстЗапроса = ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, 1, Конец) + ПредставлениеПоля + ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, Конец + 1);
				
			Иначе
				
				ПозЗапятая = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстЗапроса, ",", Конец + 1, Поз);
				
				Если ПозЗапятая = 0 Тогда
					
					ТекстЗапроса = ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, 1, Конец) + ПредставлениеПоля + ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, Поз);
					
				Иначе
					
					ТекстЗапроса = ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, 1, Конец) + ПредставлениеПоля + ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, ПозЗапятая);
					
				КонецЕсли;
				
			КонецЕсли;
			
			ТекстЗапроса1 = НРег(ТекстЗапроса);
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
		Поз = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстЗапроса1, ИмяПоля2, Начало);
		Если Поз <> 0 Тогда
			
			Поз = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстЗапроса1, ИмяПоля2, Поз + 1);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Параметры ВТ
	ТекстЗапроса1 = НРег(ТекстЗапроса);
	ИмяПоля3 = НРег("//"+ИмяПоля + "_ПараметрВТ");
	
	Поз = Найти(ТекстЗапроса1, ИмяПоля3);
	
	Пока Поз <> 0 Цикл
		
		Начало = Поз;
		Конец = 0;
		
		Если ЗаполнениеОтчетностиКлиентСервер.ВыделитьПолеЗапроса(ТекстЗапроса1, Начало, Конец) Тогда
			
			ПредставлениеПоля = " КАК " + Заголовок;
			
			ПозТочка = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстЗапроса, ".", Начало, Конец);
			ПозКАК = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстЗапроса, "КАК", Конец, Поз);
			
			Если ПозКАК = 0 Тогда
				
				ТекстЗапроса = ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, 1, Конец) + ПредставлениеПоля + ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, Конец + 1);
				
			Иначе
				
				ПозЗапятая = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстЗапроса, ",", Конец + 1, Поз);
				
				Если ПозЗапятая = 0 Тогда
					
					ТекстЗапроса = ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, 1, Конец) + ПредставлениеПоля + ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, Поз);
					
				Иначе
					
					ТекстЗапроса = ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, 1, Конец) + ПредставлениеПоля + ЗаполнениеОтчетностиКлиентСервер.Подстрока(ТекстЗапроса, ПозЗапятая);
					
				КонецЕсли;
				
			КонецЕсли;
			
			ТекстЗапроса1 = НРег(ТекстЗапроса);
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
		Поз = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстЗапроса1, ИмяПоля3, Начало);
		Если Поз <> 0 Тогда
			
			Поз = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ТекстЗапроса1, ИмяПоля3, Поз + 1);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ИзменитьДоступностьПараметра(ПараметрСхемыКомпоновкиОбъединение, Знач ИмяИсходногоПараметра)
	
	Если Найти("ПериодОтчета,ВидыСубконто,ВидыКорСубконто,ВидыСубконтоДт,ВидыСубконтоКт", ИмяИсходногоПараметра) Тогда
		ПараметрСхемыКомпоновкиОбъединение.ВключатьВДоступныеПоля = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиПолеНабораСКД(Знач ПутьКДанным, Знач КоллекцияПолей)
	
	Для каждого ПолеНабора Из КоллекцияПолей Цикл
		
		Если ПолеНабора.ПутьКДанным = ПутьКДанным Тогда
			
			Возврат ПолеНабора;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ОбработатьВидыСубконто(ТекстЗапроса, ИмяНабора)
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "(&ПериодОтчета)", "(&ПериодОтчета_"+ИмяНабора+")");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "(&ВидыСубконто)", "(&ВидыСубконто_"+ИмяНабора+")");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "(&ВидыКорСубконто)", "(&ВидыКорСубконто_"+ИмяНабора+")");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "(&ВидыСубконтоДт)", "(&ВидыСубконтоДт_"+ИмяНабора+")");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "(&ВидыСубконтоКт)", "(&ВидыСубконтоКт_"+ИмяНабора+")");
	
КонецПроцедуры 

Функция ПодготовитьСписокИспользованныхКарт(ТаблицаСвязей)
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("КартаДанных");
	
	Для каждого СтрокаТаблицы Из ТаблицаСвязей Цикл
		
		НоваяСтрока = ТаблицаДанных.Добавить();
		НоваяСтрока.КартаДанных = СтрокаТаблицы.ИсточникСвязи;
		
		НоваяСтрока = ТаблицаДанных.Добавить();
		НоваяСтрока.КартаДанных = СтрокаТаблицы.ПриемникСвязи;
		
	КонецЦикла;
	
	ТаблицаДанных.Свернуть("КартаДанных","");
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПодготовитьСтруктуруТаблиц(СтруктураКартДанных)
	
	СтруктураТаблиц = Новый Соответствие;
	
	Если ТипЗнч(СтруктураКартДанных) = Тип("Структура") Тогда
		
		Для каждого КлючИЗначение Из СтруктураКартДанных Цикл
			
			СписокПолейКарты = Новый СписокЗначений;
			
			Для каждого КолонкаКарты Из КлючИЗначение.Значение.Колонки Цикл
				
				СписокПолейКарты.Добавить(КолонкаКарты);
				
			КонецЦикла;
			
			СтруктураТаблиц.Вставить(КлючИЗначение.Ключ, СписокПолейКарты);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СтруктураТаблиц;
	
КонецФункции

Процедура СвязатьНаборыДанных(ТаблицаДанных, ТаблицаСвязей, СхемаКомпоновкиОбъединение)
	
	ИмяИсточника = "Объединение";
	Если СхемаКомпоновкиОбъединение.НаборыДанных.Найти(ИмяИсточника) = Неопределено Тогда
		ИмяИсточника = "НаборДанных1";
	КонецЕсли;
	
	// Создаем таблицу связей всех использованных наборов
	Для каждого СтрокаТаблицы Из ТаблицаСвязей Цикл
		
		ИсточникСвязи = СтрокаТаблицы.ИсточникСвязи;
		Если ИсточникСвязи = "Данные запроса" Тогда
			ИсточникСвязи = ИмяИсточника;
			ПолеИсточника= СтрокаТаблицы.ПолеИсточника;
		Иначе
			ПолеИсточника= ИсточникСвязи + "." + СтрокаТаблицы.ПолеИсточника;
		КонецЕсли;
		
		ПриемникСвязи = СтрокаТаблицы.ПриемникСвязи;
		Если ПриемникСвязи = "Данные запроса" Тогда
			ПриемникСвязи = ИмяИсточника;
			ПолеПриемника = СтрокаТаблицы.ПолеПриемника;
		Иначе
			ПолеПриемника = ПриемникСвязи + "." + СтрокаТаблицы.ПолеПриемника;
		КонецЕсли;
		
		НоваяСвязьНаборов = СхемаКомпоновкиОбъединение.СвязиНаборовДанных.Добавить();
		
		НоваяСвязьНаборов.НаборДанныхИсточник = ИсточникСвязи;
		НоваяСвязьНаборов.ВыражениеИсточник = ПолеИсточника;
		НоваяСвязьНаборов.НаборДанныхПриемник = ПриемникСвязи;
		НоваяСвязьНаборов.ВыражениеПриемник = ПолеПриемника;
		
	КонецЦикла;
	
	// Для работы связей наборов необходимо все не связанные наборы связать по "Истина"
	ТаблицаСвязейВрем = Новый ТаблицаЗначений;
	ТаблицаСвязейВрем.Колонки.Добавить("НаборДанныхИсточник");
	ТаблицаСвязейВрем.Колонки.Добавить("НаборДанныхПриемник");
	
	Для Инд = 0 По ТаблицаДанных.Количество() - 1 Цикл
		
		Для Джи = 0 По ТаблицаДанных.Количество() - 1 Цикл
			
			Если Инд <> Джи Тогда
				
				ПараметрыПоиска = Новый Структура;
				ПараметрыПоиска.Вставить("НаборДанныхИсточник", ТаблицаДанных[Джи].КартаДанных);
				ПараметрыПоиска.Вставить("НаборДанныхПриемник", ТаблицаДанных[Инд].КартаДанных);
				
				НайденныеСтроки = ТаблицаСвязейВрем.НайтиСтроки(ПараметрыПоиска);
				Если НайденныеСтроки.Количество() = 0 Тогда
					
					НоваяСвязьНаборов = ТаблицаСвязейВрем.Добавить();
					
					НоваяСвязьНаборов.НаборДанныхИсточник = ТаблицаДанных[Инд].КартаДанных;
					НоваяСвязьНаборов.НаборДанныхПриемник = ТаблицаДанных[Джи].КартаДанных;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Необходимо удалить те связи которые уже есть в таблице связи (не важно слева или справа поле)
	Для каждого СтрокаТаблицы Из ТаблицаСвязей Цикл
		
		ПараметрыПоиска = Новый Структура("НаборДанныхИсточник, НаборДанныхПриемник", СтрокаТаблицы.ИсточникСвязи, СтрокаТаблицы.ПриемникСвязи);
		НайденныеСтроки = ТаблицаСвязейВрем.НайтиСтроки(ПараметрыПоиска);
		Для каждого СтрокаТаблицыВрем Из НайденныеСтроки Цикл
			ТаблицаСвязейВрем.Удалить(СтрокаТаблицыВрем);
		КонецЦикла;
		
		ПараметрыПоискаИнв = Новый Структура("НаборДанныхИсточник, НаборДанныхПриемник", СтрокаТаблицы.ПриемникСвязи, СтрокаТаблицы.ИсточникСвязи);
		НайденныеСтроки = ТаблицаСвязейВрем.НайтиСтроки(ПараметрыПоискаИнв);
		Для каждого СтрокаТаблицыВрем Из НайденныеСтроки Цикл
			ТаблицаСвязейВрем.Удалить(СтрокаТаблицыВрем);
		КонецЦикла;
		
	КонецЦикла;
	
	// Добавляем в таблицу связей оставшиеся строки
	Для каждого СтрокаТаблицы Из ТаблицаСвязейВрем Цикл
		
		НоваяСвязьНаборов = СхемаКомпоновкиОбъединение.СвязиНаборовДанных.Добавить();
		
		НоваяСвязьНаборов.НаборДанныхИсточник = СтрокаТаблицы.НаборДанныхИсточник;
		НоваяСвязьНаборов.ВыражениеИсточник = "Истина";
		НоваяСвязьНаборов.НаборДанныхПриемник = СтрокаТаблицы.НаборДанныхПриемник;
		НоваяСвязьНаборов.ВыражениеПриемник = "Истина";
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СкопироватьОтборСКД(КоллекцияПолейНабора, КоллекцияПолейШаблона, КоллекцияЭлементовОтбора, КоллекцияЭлементовОтбораШаблон, НаименованиеНабора)
	
	Для каждого ПолеОтбора Из КоллекцияЭлементовОтбораШаблон Цикл
		
		Если ТипЗнч(ПолеОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			ДобавитьГруппуОтбораСКД(ПолеОтбора, КоллекцияПолейШаблона, КоллекцияПолейНабора, КоллекцияЭлементовОтбора, НаименованиеНабора);
			
		Иначе
			
			ДобавитьОтборСКД(ПолеОтбора, КоллекцияПолейШаблона, КоллекцияПолейНабора, КоллекцияЭлементовОтбора, НаименованиеНабора);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СкопироватьСхемуКомпоновки(СхемаШаблона)
	
	Буфер = Новый ХранилищеЗначения(СхемаШаблона);
	
	Возврат Буфер.Получить();
	
КонецФункции

Функция СоединитьСКартамиДанных(ТаблицаСвязей, СтруктураКартДанных, СхемаКомпоновкиОбъединение, ТекстСообщения = "") Экспорт
	
	Если ТипЗнч(ТаблицаСвязей) <> Тип("ТаблицаЗначений") ИЛИ Не ЗначениеЗаполнено(ТаблицаСвязей) Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	ТаблицаДанных = ПодготовитьСписокИспользованныхКарт(ТаблицаСвязей);
	
	Если НЕ СоздатьНаборыДанныхОбъект(ТаблицаДанных, СтруктураКартДанных, СхемаКомпоновкиОбъединение, ТекстСообщения) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СвязатьНаборыДанных(ТаблицаДанных, ТаблицаСвязей, СхемаКомпоновкиОбъединение);
	
	Возврат Истина;
	
КонецФункции

Функция СоздатьНаборыДанныхОбъект(ТаблицаДанных, СтруктураКартДанных, СхемаКомпоновкиОбъединение, ТекстСообщения = "")
	
	СтруктураТаблиц = ПодготовитьСтруктуруТаблиц(СтруктураКартДанных);
	
	Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		
		Если СтрокаТаблицы.КартаДанных = "Данные запроса" Тогда
			
			Продолжить;
			
		ИначеЕсли СтрокаТаблицы.КартаДанных = "ИерархияСчетов" Тогда
			
			ТаблицаКарты = Новый ТаблицаЗначений;
			ТаблицаКарты.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
			ТаблицаКарты.Колонки.Добавить("Родитель", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
			
			ИмяНабора = "ИерархияСчетов";
			
		Иначе
			
			ТаблицаКарты = Новый ТаблицаЗначений;
			
			СписокПолей = СтруктураТаблиц[СтрокаТаблицы.КартаДанных];
			
			Если ТипЗнч(СписокПолей) <> Тип("СписокЗначений") Тогда
				
				ТекстОшибки = НСтр("ru = 'Карта данных ""%1"", используемая в таблице соединений не найдена.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, СтрокаТаблицы.КартаДанных);
				
				Возврат Ложь;
				
			КонецЕсли;
			
			Для каждого ЭлементСписка Из СписокПолей Цикл
				
				Колонка = ТаблицаКарты.Колонки.Добавить(ЭлементСписка.Значение.Имя, ЭлементСписка.Значение.ТипЗначения);
				
			КонецЦикла;
			
			ИмяНабора = СтрокаТаблицы.КартаДанных;
			
		КонецЕсли;
		
		БюджетнаяОтчетность.ДобавитьТаблицуЗначенийВНаборыДанныхСхемыКомпоновкиДанных(
				СхемаКомпоновкиОбъединение, ТаблицаКарты, ИмяНабора, Истина);
		
		Для каждого ПолеКарты Из СхемаКомпоновкиОбъединение.НаборыДанных[ИмяНабора].Поля Цикл
			
			ПолеКарты.ПутьКДанным = СтрокаТаблицы.КартаДанных + "." + ПолеКарты.ПутьКДанным;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Служебные процедуры метода ПолучитьИерархиюПланаСчетов

Функция ПолучитьИерархиюСчетов(ОтборСчетов = Неопределено,ИмяТаблицы = "ПланСчетов.ЕПСБУ", СчетВИерархииОтбора = Ложь, ИсключитьПереданные = Ложь,
				РодительИзСпискаОтбораСчетов = Ложь, ПолучитьТолькоПервогоРодителя = Ложь, ИсключатьСчетаОтбора = Ложь, МаксимальныйУровеньВложенности = 1000)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Если ПолучитьСчетаПервогоУровня(МенеджерВременныхТаблиц, ИмяТаблицы, ОтборСчетов, СчетВИерархииОтбора, ИсключитьПереданные,
			РодительИзСпискаОтбораСчетов, ПолучитьТолькоПервогоРодителя, ИсключатьСчетаОтбора) Тогда
		
		УровеньВложенности = 1;
		Пока УровеньВложенности <= МаксимальныйУровеньВложенности И ПолучитьПодчиненныеСчета(МенеджерВременныхТаблиц, ИмяТаблицы, ОтборСчетов,
				ИсключитьПереданные, РодительИзСпискаОтбораСчетов, ПолучитьТолькоПервогоРодителя, ИсключатьСчетаОтбора) Цикл
				
			УровеньВложенности = УровеньВложенности + 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПолучитьРезультат(МенеджерВременныхТаблиц,ИмяТаблицы);
	
КонецФункции

Функция ПолучитьСчетаПервогоУровня(МенеджерВременныхТаблиц, ИмяТаблицы, МассивСсылокОтбор, УсловиеВИерархии, ИсключитьПереданные,
			РодительИзСписка, ПервыйРодитель, ИсключатьСамиСчета)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.Ссылка,
		|	ВложенныйЗапрос.Родитель,
		|	ВложенныйЗапрос.ПродолжатьПоиск
		|ПОМЕСТИТЬ Счета
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТаблицаСчетов.Ссылка КАК Ссылка,
		|		ВЫБОР
		|			КОГДА ТаблицаСчетов.Родитель = ЗНАЧЕНИЕ("+ИмяТаблицы+".ПустаяСсылка) ТОГДА
		|				%4
		|			ИНАЧЕ ТаблицаСчетов.Родитель
		|		КОНЕЦ КАК Родитель,
		|		ВЫБОР
		|			КОГДА ТаблицаСчетов.Родитель = ЗНАЧЕНИЕ("+ИмяТаблицы+".ПустаяСсылка) %3
		|				ТОГДА ЛОЖЬ
		|			ИНАЧЕ %5
		|		КОНЕЦ КАК ПродолжатьПоиск
		|	ИЗ
		|		"+ИмяТаблицы+" КАК ТаблицаСчетов
		|	%1
		|	) КАК ВложенныйЗапрос
		|ГДЕ
		|	ВложенныйЗапрос.Родитель <> ЗНАЧЕНИЕ("+ИмяТаблицы+".ПустаяСсылка) %2
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ВложенныйЗапрос.ПродолжатьПоиск
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Счета.Ссылка,
		|	Счета.Родитель
		|ПОМЕСТИТЬ ТаблицаСчетов
		|ИЗ
		|	Счета КАК Счета
		|ГДЕ
		|	Счета.ПродолжатьПоиск
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаСчетов.Ссылка,
		|	ТаблицаСчетов.Родитель
		|ИЗ
		|	ТаблицаСчетов КАК ТаблицаСчетов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Счета.Ссылка,
		|	Счета.Родитель
		|ПОМЕСТИТЬ Результат
		|ИЗ
		|	Счета КАК Счета
		|%6
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ Счета";
	
	ТекстУсловияВключенияСчетов = "";
	ТекстУсловияИсключенияСчетов = "";
	ТекстУсловияРодительПервыйИзСписка = "";
	
	ТекстУсловие6 = "";
	
	Если МассивСсылокОтбор <> Неопределено Тогда
		
		Запрос.УстановитьПараметр("СписокСсылок", МассивСсылокОтбор);
		
		ТекстУсловияВключенияСчетов = "ГДЕ ТаблицаСчетов.Ссылка %1(&СписокСсылок)";
		ТекстСравнения = "В";
		Если УсловиеВИерархии Тогда
			ТекстСравнения = "В Иерархии";
		КонецЕсли;
		ТекстУсловияВключенияСчетов = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловияВключенияСчетов, ТекстСравнения);
		
		Если ИсключитьПереданные Тогда
			ТекстУсловияИсключенияСчетов = "И НЕ ВложенныйЗапрос.Ссылка В(&СписокСсылок)";
		КонецЕсли;
		
		Если РодительИзСписка Тогда
			ТекстУсловияВключенияСамихСчетов = "ИЛИ ТаблицаСчетов.Родитель В (&СписокСсылок)";
			ТекстУсловие6 = "ГДЕ НЕ Счета.ПродолжатьПоиск";
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстУсловияПервыйРодитель = "ИСТИНА";
	Если ПервыйРодитель Тогда
		ТекстУсловияПервыйРодитель = "ЛОЖЬ";
	КонецЕсли;
	
	ТекстУсловияИсключатьСамиСчета = "ТаблицаСчетов.Ссылка";
	Если ИсключатьСамиСчета Тогда
		ТекстУсловияИсключатьСамиСчета = "ЗНАЧЕНИЕ("+ИмяТаблицы+".ПустаяСсылка)";
	КонецЕсли;
	
	Запрос.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Запрос.Текст,
			ТекстУсловияВключенияСчетов, ТекстУсловияИсключенияСчетов, ТекстУсловияВключенияСамихСчетов,
			ТекстУсловияИсключатьСамиСчета, ТекстУсловияПервыйРодитель, ТекстУсловие6);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Возврат НЕ Результат[2].Пустой();
	
КонецФункции

Функция ПолучитьПодчиненныеСчета(МенеджерВременныхТаблиц, ИмяТаблицы, МассивСсылокОтбор, ИсключитьПереданные,
			РодительИзСписка, ПервыйРодитель, ИсключатьСамиСчета)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Результат.Ссылка,
		|	Результат.Родитель
		|ПОМЕСТИТЬ ПредыдущийРезультат
		|ИЗ
		|	Результат КАК Результат
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ Результат
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Ссылка,
		|	ВложенныйЗапрос.Родитель,
		|	ВложенныйЗапрос.ПродолжатьПоиск
		|ПОМЕСТИТЬ Счета
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТаблицаСчетов.Ссылка КАК Ссылка,
		|		ВЫБОР
		|			КОГДА ТаблицаСчетов.Родитель.Родитель = ЗНАЧЕНИЕ("+ИмяТаблицы+".ПустаяСсылка) ТОГДА
		|				%3
		|			ИНАЧЕ ТаблицаСчетов.Родитель.Родитель
		|		КОНЕЦ КАК Родитель,
		|		ВЫБОР
		|			КОГДА ТаблицаСчетов.Родитель.Родитель = ЗНАЧЕНИЕ("+ИмяТаблицы+".ПустаяСсылка) %2
		|				ТОГДА ЛОЖЬ
		|			ИНАЧЕ %4
		|		КОНЕЦ КАК ПродолжатьПоиск
		|	ИЗ
		|		ТаблицаСчетов КАК ТаблицаСчетов) КАК ВложенныйЗапрос
		|ГДЕ
		|	ВложенныйЗапрос.Родитель <> ЗНАЧЕНИЕ("+ИмяТаблицы+".ПустаяСсылка) %1
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ВложенныйЗапрос.ПродолжатьПоиск
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ТаблицаСчетов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Счета.Ссылка,
		|	Счета.Родитель
		|ПОМЕСТИТЬ ТаблицаСчетов
		|ИЗ
		|	Счета КАК Счета
		|ГДЕ
		|	Счета.ПродолжатьПоиск
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаСчетов.Ссылка,
		|	ТаблицаСчетов.Родитель
		|ИЗ
		|	ТаблицаСчетов КАК ТаблицаСчетов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Счета.Ссылка,
		|	Счета.Родитель
		|ПОМЕСТИТЬ Результат
		|ИЗ
		|	Счета КАК Счета
		|%5
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПредыдущийРезультат.Ссылка,
		|	ПредыдущийРезультат.Родитель
		|ИЗ
		|	ПредыдущийРезультат КАК ПредыдущийРезультат
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ Счета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ПредыдущийРезультат";
		
	ТекстУсловияИсключенияСчетов = "";
	ТекстУсловияРодительПервыйИзСписка = "";
	
	ТекстУсловие5 = "";
	
	Если МассивСсылокОтбор <> Неопределено Тогда
		
		Запрос.УстановитьПараметр("СписокСсылок", МассивСсылокОтбор);
		
		Если ИсключитьПереданные Тогда
			ТекстУсловияИсключенияСчетов = "И НЕ ВложенныйЗапрос.Ссылка В(&СписокСсылок)";
		КонецЕсли;
		
		Если РодительИзСписка Тогда
			ТекстУсловияВключенияСамихСчетов = "ИЛИ ТаблицаСчетов.Родитель.Родитель В (&СписокСсылок)";
			ТекстУсловие5 = "ГДЕ НЕ Счета.ПродолжатьПоиск";
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстУсловияПервыйРодитель = "ИСТИНА";
	Если ПервыйРодитель Тогда
		ТекстУсловияПервыйРодитель = "ЛОЖЬ";
	КонецЕсли;
	
	ТекстУсловияИсключатьСамиСчета = "ТаблицаСчетов.Ссылка";
