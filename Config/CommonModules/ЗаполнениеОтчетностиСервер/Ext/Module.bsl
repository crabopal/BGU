	//Т.к. в начале года остатки на 001-009, в середине года обороты по 56х/66х и 73х/83х, то после замены кэк нужно исправить конечные остатки,
	//иначе получится, что если до замены было: 
	//по 001 остаток на начало по дт 100,
	//по 561/661 оборот в кт 150
	//и на конец года будет по 001 остаток по дт 100, а по 561/661 остаток по кт 150.
	//А должно быть по 001 остаток на конец по кт 50, и все.
	
	Для Каждого СтрТЧ Из ТаблицаДанных Цикл
		//т.к. форма может заполняться не с начала года, то остатки на начало отчетного периода могут быть на разных КЭК - 561/661,
		//необходимо их объединить
		Если СтрТЧ.ОстатокДт <> 0
			ИЛИ СтрТЧ.ОстатокКт <> 0 Тогда
			
			Если СтрТЧ.ОстатокДт >= СтрТЧ.ОстатокКт Тогда
				СтрТЧ.ОстатокДт = СтрТЧ.ОстатокДт - СтрТЧ.ОстатокКт;
				СтрТЧ.ОстатокКт = 0;
			Иначе
				СтрТЧ.ОстатокКт = СтрТЧ.ОстатокКт - СтрТЧ.ОстатокДт;
				СтрТЧ.ОстатокДт = 0;
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла;
	
		
	//После того как распределили задолженность, можно свернуть таблицу детальных данных
	//КПС в данном наборе не нужен, по нему свернем.
	//По организации и ИФО сворачивать нельзя никогда, 
	//т.к. в правилах заполнения на набор дополнительно накладываются по ним отбор.
	//КЭК теперь не нужно, его убираем.
	ТаблицаДанных.Свернуть("Счет,Организация,ИФО,КФО","ОстатокДт,ОстатокКт");
	
	КартаРС = Неопределено;
	
	Возврат ТаблицаДанных;
	
КонецФункции

Процедура ДополнитьТаблицуПоРазворотуСубконтоНаДату(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, ДатаОстатков)
	
	МассивСтрок = КартаРС.НайтиСтроки(СтруктураОтбора);
			
	МассивСчетов = Новый Массив;
	Если МассивСтрок.Количество() >0 Тогда
		Для Каждого ТекСтр Из МассивСтрок Цикл
			МассивСчетов.Добавить(ТекСтр.Счет);
		КонецЦикла;
		
		Для Каждого КлючИЗначение Из СтруктураОтбора Цикл
			СтруктураПолей.Вставить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
		КонецЦикла;
	
		ДополнитьТаблицуПоДаннымОстатков(ТаблицаДанных, СтруктураПолей, МассивСчетов, СтруктураПолейОтбора, Условие, ДатаОстатков);
		
	КонецЕсли;
	
КонецПроцедуры

// Для заполнения 2 раздела формы 0503191 - только дебиторская задолженность по 206 счету по КФО 1, 
// другие варианты использования функции - при необходимости.
Функция ПолучитьВНД_ЗадолженностьПоСрокамИсполнения(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
	
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	
	КонецПериода = ЗаполнениеОтчетности.ПолучитьДатуИзПараметра(КонецПериода);
		
	ТаблицаМетодовДополнительнойОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(ПравилоЗаполнения,,,Истина);
	КартыДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	ОбработкаЗаполнения = Обработки.ОбработкаДанныхОтчетности.Создать();
	
	Если НЕ ОбработкаЗаполнения.ПрименитьМетодыДополнительнойОбработки(КартыДанных, "КартыДанных", ТаблицаМетодовДополнительнойОбработки, ПравилоЗаполнения, Неопределено, "") Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	ТипЧисло = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(18,2);
	ТипСтрока = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(0);
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("СчетРасчетов",Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДанных.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("КПС",Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДанных.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДанных.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
    ТаблицаДанных.Колонки.Добавить("Контрагент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДанных.Колонки.Добавить("Договор",Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаДанных.Колонки.Добавить("ВидЗадолженности",Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЗадолженности"));
	ТаблицаДанных.Колонки.Добавить("ТипЗадолженности",ТипСтрока);	
	
	// Набор колонок соответствует данным КонтрольИсполненияДоговоров.АнализЗадолженности.
	МассивИменКолонокСумм = Новый Массив;
	МассивИменКолонокСумм.Добавить("Краткосрочная");             // Менее 1 года от отчетной даты = краткосрочная (итого) + просроченная.
	МассивИменКолонокСумм.Добавить("ТекущаяКраткосрочная");      // Краткосрочная за исключением просроченной.
	МассивИменКолонокСумм.Добавить("КраткосрочнаяДоКонцаГода");  // Краткосрочная до конца текущего года.
	МассивИменКолонокСумм.Добавить("Долгосрочная");              // Более 1 года от отчетной даты = долгосрочная (итого).
	МассивИменКолонокСумм.Добавить("ДолгосрочнаяБолее2Лет");     // Более 2 лет от отчетной даты.
	МассивИменКолонокСумм.Добавить("ДолгосрочнаяБолее3Лет");     // Более 3 лет от отчетной даты.
	МассивИменКолонокСумм.Добавить("ДолгосрочнаяБолее5Лет");     // Более 5 лет от отчетной даты.
	МассивИменКолонокСумм.Добавить("Просроченная");              // Менее отчетной даты = просроченная итого.
	МассивИменКолонокСумм.Добавить("ПросроченнаяБолее30Дней");   // Более 30 дней от отчетной даты.
	МассивИменКолонокСумм.Добавить("ПросроченнаяБолее60Дней");   // Более 60 дней от отчетной даты.
	МассивИменКолонокСумм.Добавить("ПросроченнаяБолее90Дней");   // Более 90 дней от отчетной даты.
	МассивИменКолонокСумм.Добавить("ПросроченнаяБолее180Дней");  // Более 180 дней от отчетной даты.
	МассивИменКолонокСумм.Добавить("ПросроченнаяБолее1Года");    // Более 1 года от отчетной даты.
	МассивИменКолонокСумм.Добавить("ПросроченнаяБолее3Лет");     // БОлее 3 лет от отчетной даты.
	
	МассивРублевыхКолонок = Новый Массив;
	//В имя колонки добавляем "Руб", т.к. нам нужны рублевые суммы, без "Руб" - в валюте договора, и она может отличаться от валюты регл.учета
	Для Каждого ИмяКолонкиСуммы Из МассивИменКолонокСумм Цикл
		ИмяРублевойКолонки = ИмяКолонкиСуммы+"Руб";
		ТаблицаДанных.Колонки.Добавить(ИмяРублевойКолонки,ТипЧисло);
		МассивРублевыхКолонок.Добавить(ИмяРублевойКолонки);
	КонецЦикла;
	
	СтруктураПолейОтбора = Новый Структура("Организация");
	
	Условие = "";
	УсловиеБаланс = "";
	ЕстьИФО = Ложь;
	
	Если ТипЗнч(ИФО) = Тип("Структура") Тогда
		Если ИФО.Свойство("Использование") 
			И ИФО.Использование = Истина Тогда
			ЕстьИФО = Истина;
			
			Если ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеБаланс = " Ссылка = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеБаланс = " Ссылка <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеБаланс = " Ссылка В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеБаланс = " НЕ Ссылка В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеБаланс = " Ссылка <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеБаланс = " Ссылка = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ИФО <> Неопределено Тогда
		ЕстьИФО = Истина;
		Если ТипЗнч(ИФО) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
			УсловиеБаланс = " Ссылка = &ИФО";
			СтруктураПолейОтбора.Вставить("ИФО",ИФО);
		КонецЕсли;
	КонецЕсли;
	
	УсловиеОрганизация = "";
	
	Если ТипЗнч(Организация) = Тип("Структура") Тогда
		Если Организация.Свойство("Использование") 
			И Организация.Использование = Истина Тогда
			
			Если Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеОрганизация = " Ссылка = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеОрганизация = " Ссылка <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеОрганизация = " Ссылка В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеОрганизация = " НЕ Ссылка В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеОрганизация = " Ссылка <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеОрганизация = " Ссылка = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		УсловиеОрганизация = " Ссылка = &Организация";
		СтруктураПолейОтбора.Вставить("Организация",Организация);
	КонецЕсли;
	
	МассивИФО = Новый Массив;
	Если ЕстьИФО Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИФО",СтруктураПолейОтбора.ИФО);
		ТекстЗапроса = "ВЫБРАТЬ
		|	Спр.Ссылка КАК ИФО
		|ИЗ
		|	Справочник.ИсточникиФинансовогоОбеспечения КАК Спр
		|ГДЕ
		|	&Условие";
		
		Запрос.Текст = СтрЗаменить(ТекстЗапроса,"&Условие",УсловиеБаланс);
		МассивИФО = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	КонецЕсли;
	
	МассивОрганизаций = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",СтруктураПолейОтбора.Организация);
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Спр.Ссылка КАК Организация
	|ИЗ
	|	Справочник.Организации КАК Спр
	|ГДЕ
	|	&Условие";
	
	Если НЕ ЗначениеЗаполнено(УсловиеОрганизация) Тогда
		УсловиеОрганизация = "ИСТИНА";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса,"&Условие",УсловиеОрганизация);
	МассивОрганизаций = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
	ВидЗадолженности = Неопределено;
	ПараметрВидЗадолженности = ПараметрыСхемы.Найти("ВидЗадолженностиПоСрокамИсп_"+ИмяНабора);
	Если ПараметрВидЗадолженности <> Неопределено Тогда
		ВидЗадолженности = ПараметрВидЗадолженности.Значение;
	КонецЕсли;
	
	ТипЗадолженности = Неопределено;
	ПараметрТипЗадолженности = ПараметрыСхемы.Найти("ТипЗадолженностиПоСрокамИсп_"+ИмяНабора);	
	Если ПараметрТипЗадолженности <> Неопределено Тогда
		ТипЗадолженности = ПараметрТипЗадолженности.Значение;
	КонецЕсли;
	
	СчетРасчетов = Неопределено;
	ПараметрСчетРасчетов = ПараметрыСхемы.Найти("СчетРасчетовПоСрокамИсп_"+ИмяНабора);
	Если ПараметрСчетРасчетов <> Неопределено Тогда
		СчетРасчетов = ПараметрСчетРасчетов.Значение;
	КонецЕсли;
	
	Отбор = Новый Структура;
	
	// Отбор по КФО выполняется в отборе набора данных, поскольку при заполнении по КФО 1 других данных в таблице по казенному учреждению нет, 
	// а при заполнении по КФО 2,4,5,6,7 может потребоваться заполнение по нескольким КФО одновременно.
	
	Если ЕстьИФО Тогда
		Отбор.Вставить("ИФО",МассивИФО);		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетРасчетов) Тогда
		Отбор.Вставить("СчетРасчетов",СчетРасчетов);
	КонецЕсли;	
	
	ОбщаяТаблица = Неопределено;
	
	//ТаблицаДанных.Колонки.Добавить("Валюта",Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	Для Каждого ТекОрганизация Из МассивОрганизаций Цикл
		ТаблицаАнализЗадолженностиОрг = КонтрольИсполненияДоговоров.АнализЗадолженности(ТекОрганизация,КонецПериода,Отбор,ВидЗадолженности,ТипЗадолженности,Истина);
		Для Каждого СтрТЧ Из ТаблицаАнализЗадолженностиОрг Цикл
			
			Если ТипЗадолженности = "Дт206" Тогда
				// АнализЗадолженности использует замену счета 206 на счет 302,
				// для использования в алгоритмах контроля договоров. 
				// Необходимо их заменить обратно для использования в данных отчета.
				ТекСчетРасчетов = СтрТЧ.СчетРасчетов;
				СтрТЧ.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("206." + Прав(Строка(ТекСчетРасчетов), 2), КонецПериода, ТекОрганизация);
			КонецЕсли;	
				
			ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),СтрТЧ);
		КонецЦикла;
	КонецЦикла;
	
	СуммовыеПоказатели = СтрСоединить(МассивРублевыхКолонок,",");
	ТаблицаДанных.Свернуть("СчетРасчетов,Организация,КПС,ИФО,КФО,Контрагент,ИФО,Договор,ВидЗадолженности,ТипЗадолженности",СуммовыеПоказатели);
	
	//уберем из имени суммовых колонок "Руб", т.к. в СКД ожидаются поля набора данных без "Руб"
	Для Каждого ИмяКолонкиСуммы Из МассивИменКолонокСумм Цикл
		ИмяРублевойКолонки = ИмяКолонкиСуммы+"Руб";
		ТекКолонка = ТаблицаДанных.Колонки.Найти(ИмяРублевойКолонки);
		ТекКолонка.Имя = ИмяКолонкиСуммы;		
	КонецЦикла; 
	
	Возврат ТаблицаДанных
	
КонецФункции	
	
#КонецОбласти

#Область ПолучитьВНД_Долгосрочная

Функция ПолучитьВНД_Долгосрочная(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
	Перем ВидЗадолженности;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ДополнительныеПараметры.Свойство("ВидЗадолженности", ВидЗадолженности);
	КонецЕсли;

	НачалоПериода = НачалоДня(НачалоПериода - 1);
	КонецПериода = НачалоДня(ЗаполнениеОтчетности.ПолучитьДатуИзПараметра(КонецПериода));
		
	ТипЧисло = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(18,2);
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Счет",Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДанных.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДанных.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДанных.Колонки.Добавить("КПС",Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДанных.Колонки.Добавить("ВидПоказателя",Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКБК"));
	ТаблицаДанных.Колонки.Добавить("ВидЗадолженностиДтКт",Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЗадолженности"));
	ТаблицаДанных.Колонки.Добавить("ТипКонтрагентаКод",Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("Контрагент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДанных.Колонки.Добавить("Договор",Новый ОписаниеТипов("СправочникСсылка.Договоры"));	
	
	ТаблицаДанных.Колонки.Добавить("ДолгосрочнаяНачало",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("ДолгосрочнаяКонец",ТипЧисло);
	
	СтруктураПолейОтбора = Новый Структура;
	
	Условие = "";
	УсловиеБаланс = "";
	ЕстьИФО = Ложь;
	
	Если ТипЗнч(ИФО) = Тип("Структура") Тогда
		Если ИФО.Свойство("Использование") 
			И ИФО.Использование = Истина Тогда
			ЕстьИФО = Истина;
			
			Если ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеБаланс = " И НЕ ДолгосрочнаяПросроченнаяЗадолженность.ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ИФО <> Неопределено Тогда
		ЕстьИФО = Истина;
		Если ТипЗнч(ИФО) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
			УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО = &ИФО";
			СтруктураПолейОтбора.Вставить("ИФО",ИФО);
		КонецЕсли;
	КонецЕсли;
	
	УсловиеОрганизация = "";//переопредится далее на равно
	
	УсловиеСпрОрганизация = "";
	
	Если ТипЗнч(Организация) = Тип("Структура") Тогда
		Если Организация.Свойство("Использование") 
			И Организация.Использование = Истина Тогда
			
			Если Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
				УсловиеСпрОрганизация = "Ссылка = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация <> &Организация";
				УсловиеСпрОрганизация = "Ссылка <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация В (&Организация)";
				УсловиеСпрОрганизация = "Ссылка В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				//УсловиеОрганизация = " И НЕ ДолгосрочнаяПросроченнаяЗадолженность.Организация В (&Организация)";
				УсловиеСпрОрганизация = "НЕ Ссылка В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация <> &Организация";
				УсловиеСпрОрганизация = "Ссылка <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
				УсловиеСпрОрганизация = "Ссылка = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
		УсловиеСпрОрганизация = "Ссылка = &Организация";
		СтруктураПолейОтбора.Вставить("Организация",Организация);
	КонецЕсли;	
	
	УсловиеВидЗадолженностиДтКт = "";
	
	Если ТипЗнч(ВидЗадолженности) = Тип("Структура") Тогда
		Если ВидЗадолженности.Свойство("Использование") 
			И ВидЗадолженности.Использование = Истина Тогда
			
			Если ВидЗадолженности.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				И Строка(ВидЗадолженности.ПравоеЗначение) = "Кредиторская задолженность" Тогда
				УсловиеВидЗадолженностиДтКт = " И ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности = &ВидЗадолженностиДтКт";
				СтруктураПолейОтбора.Вставить("ВидЗадолженностиДтКт",Перечисления.ВидыЗадолженности.Кредиторская);
			ИначеЕсли ВидЗадолженности.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				И Строка(ВидЗадолженности.ПравоеЗначение) = "Дебиторская задолженность" Тогда
				УсловиеВидЗадолженностиДтКт = " И ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности = &ВидЗадолженностиДтКт";
				СтруктураПолейОтбора.Вставить("ВидЗадолженностиДтКт",Перечисления.ВидыЗадолженности.Дебиторская);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ВидЗадолженности) = Тип("СправочникСсылка.Субконто") Тогда
		Если Строка(ВидЗадолженности) = "Кредиторская задолженность" Тогда
			УсловиеВидЗадолженностиДтКт = " И ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности = &ВидЗадолженностиДтКт";
			СтруктураПолейОтбора.Вставить("ВидЗадолженностиДтКт",Перечисления.ВидыЗадолженности.Кредиторская);
		ИначеЕсли Строка(ВидЗадолженности) = "Дебиторская задолженность" Тогда
			УсловиеВидЗадолженностиДтКт = " И ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности = &ВидЗадолженностиДтКт";
			СтруктураПолейОтбора.Вставить("ВидЗадолженностиДтКт",Перечисления.ВидыЗадолженности.Дебиторская);
		КонецЕсли;
	КонецЕсли;
		
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ИФО",ЕстьИФО);//Истина); - необходимо определять нужность ИФО в зависимости от параметров
	СтруктураПолей.Вставить("КПС",Истина);//нужен всегда
	СтруктураПолей.Вставить("КЭК",Ложь);//для отчетов до 2021 года не нужен
	СтруктураПолей.Вставить("ВидПоказателя",Истина);//нужен в основном для 169 формы, для поддержки различий БГУ1 и БГУ2
	
	КодОКУД = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПравилоЗаполнения, "Владелец.КодФормыПоКлассификатору"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	&Условие";
	
	Если ЗначениеЗаполнено(УсловиеСпрОрганизация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие",УсловиеСпрОрганизация);
		Запрос.УстановитьПараметр("Организация",СтруктураПолейОтбора.Организация);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие","ИСТИНА");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивОрганизаций = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	//если отчет заполняется по нескольким организациям, то нужно для каждой организации индивидуально получать настройку - ДатыСУчетомИнвентаризации,
	//иначе остатки на начало года определяются не верно, потому сначала получаем организации по отбору, и по ним получаем настройку и данные регистра
	//и отбор в цикле задаем в этом случае всегда на равно	
	УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
	
	Условие = УсловиеБаланс + УсловиеОрганизация + УсловиеВидЗадолженностиДтКт;			
	УсловиеДляОпределенияДаты = УсловиеБаланс + УсловиеОрганизация;

	Для Каждого ТекОрг Из МассивОрганизаций Цикл
    	СтруктураПолейОтбора.Вставить("Организация",ТекОрг);
		
		ДатыСУчетомИнвентаризации = ОпределитьДатыСУчетомИнвентаризации(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, УсловиеДляОпределенияДаты, НачалоПериода, КонецПериода, КодОКУД);
		
		ДополнитьТаблицуПоДаннымДолгосрочной(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, ДатыСУчетомИнвентаризации.НачалоПериода, ДатыСУчетомИнвентаризации.КонецПериода, ДатыСУчетомИнвентаризации);
	КонецЦикла;
	
	ТаблицаДанных.Свернуть("Счет,Организация,ИФО,КФО,КПС,ВидПоказателя,ВидЗадолженностиДтКт,ТипКонтрагентаКод,Контрагент,Договор","ДолгосрочнаяНачало,ДолгосрочнаяКонец");
		
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПолучитьВНД_ДолгосрочнаяКЭК(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
	Перем ВидЗадолженности;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ДополнительныеПараметры.Свойство("ВидЗадолженности", ВидЗадолженности);
	КонецЕсли;

	НачалоПериода = НачалоДня(НачалоПериода - 1);
	КонецПериода = НачалоДня(ЗаполнениеОтчетности.ПолучитьДатуИзПараметра(КонецПериода));
	
	//заполнить карты данных по методам обработки
	ТаблицаМетодовДополнительнойОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(ПравилоЗаполнения,,,Истина);
	КартыДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
