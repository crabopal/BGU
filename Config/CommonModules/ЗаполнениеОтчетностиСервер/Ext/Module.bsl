			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Контрагенты.Ссылка КАК Ссылка,
			|	Контрагенты.ТипКонтрагента.Код КАК ТипКонтрагентаКод
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.Ссылка В(&МассивКонтрагентов)";
			
			Запрос.УстановитьПараметр("МассивКонтрагентов", МассивКонтрагентов);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Выборка = РезультатЗапроса.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				ТипыКонтрагентов.Вставить(Выборка.Ссылка, Выборка.ТипКонтрагентаКод);
			КонецЦикла;
			
		Иначе
			ТипыКонтрагентов = Новый Соответствие;
		КонецЕсли;
		
		КЭКОстатков = ПолучитьКЭКОстатков();
		КЭКДляЗаменыОстатков = ПолучитьКЭКДляЗамены();
		КЭКСчетов = Новый Соответствие;
		
		Для Каждого СтрДанных Из ТаблицаДанных Цикл
			Если Не ЗначениеЗаполнено(СтрДанных.КЭК) Тогда
				// Если инвентариазция за 2020 год была заполнена без КЭК, дозаполняем КЭК по данным счета/контрагента.
				//Проверим, есть ли для счета единственный допустимый КЭК. 
				УстановитьДетальныйКЭКПоСчету(СтрДанных, СтрДанных.Счет, КЭКСчетов, КЭКДляЗаменыОстатков, КЭК000);
				
				Если НЕ ЗначениеЗаполнено(СтрДанных.КЭК) Тогда
				
					ТекТипКонтрагента = ТипыКонтрагентов[СтрДанных.Контрагент];
					КонтрагентЗаполнен = ЗначениеЗаполнено(СтрДанных.Контрагент);
					
					Если КонтрагентЗаполнен Тогда
						Если ТекТипКонтрагента = Неопределено Тогда
							КодКЭКПоКонтрагенту = "001"
						ИначеЕсли ЗначениеЗаполнено(ТекТипКонтрагента) Тогда
							КодКЭКПоКонтрагенту = "00"+ТекТипКонтрагента;
						Иначе
							КодКЭКПоКонтрагенту = "000";
						КонецЕсли;
					Иначе
						КодКЭКПоКонтрагенту = "001";
					КонецЕсли;
					СтрДанных.КЭК = КЭКОстатков.Получить(КодКЭКПоКонтрагенту);
					
				КонецЕсли;		
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
		
	//Для счетов из карты данных заменяем на КЭК 000
	Для Каждого СтрДанных Из ТаблицаДанных Цикл
		Если СоответствиеСчетаБезКЭК[СтрДанных.Счет] = Истина Тогда
			СтрДанных.КЭК = КЭК000;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаДанных.Свернуть("Счет,Организация,ИФО,КФО,КПС,КЭК,ВидПоказателя,ВидЗадолженностиДтКт,Контрагент,Договор","ДолгосрочнаяНачало,ДолгосрочнаяКонец");
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ОпределитьДатыСУчетомИнвентаризации(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, КодОКУД)
	
	ЭтоОтчетИзменениеВалютыБаланса = Ложь;
	//используется код ОКУД, а не код вида отчета, потому что могут быть не типовые виды отчетов с другим кодом вида отчета
	Если КодОКУД = "0503173" ИЛИ КодОКУД = "0503773" Тогда
		ЭтоОтчетИзменениеВалютыБаланса = Истина;	
	КонецЕсли;	

	ДатыСУчетомИнвентаризации = Новый Структура;
	ДатыСУчетомИнвентаризации.Вставить("НачалоПериода", НачалоПериода);
	ДатыСУчетомИнвентаризации.Вставить("КонецПериода", КонецПериода);
	
	// Для того, чтобы учесть исправления межотчетного периода по долгосрочной задолженности, используется спецаильный порядок ввода документов инвентаризации.
	// Основной режим ввода инвентаризации - последним днем предыдущего преиода (например, 31.12).
	// В этом случае, для отражения измненений межотчетного периода, следует ввести документ следующей датой (01.01).
	// Если такой документ найден, то используется дата, следующая за началом периода (используеются документы 01.01).
	ДатаПроверкиМежотчетныйПериод = НачалоДня(КонецДня(НачалоПериода)+1);
	
	//если это отчетность за 26 год и далее, то на начало года данные смотрим только у одного документа, 
	//последнего, введенного до даты окончания
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	    |	ДолгосрочнаяПросроченнаяЗадолженность.СчетРасчетов КАК Счет,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Регистратор КАК Регистратор,
	    |	ДолгосрочнаяПросроченнаяЗадолженность.Организация КАК Организация,
		|	ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности КАК ВидЗадолженностиДтКт,
	    |	ДолгосрочнаяПросроченнаяЗадолженность.КФО КАК КФО, "+?(СтруктураПолей.ИФО,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.ИФО КАК ИФО,","")+"
		|	ДолгосрочнаяПросроченнаяЗадолженность.Долгосрочная КАК ДолгосрочнаяНачало,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Просроченная КАК ПросроченнаяНачало
		|ИЗ
	    |	РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность КАК ДолгосрочнаяПросроченнаяЗадолженность
	    |ГДЕ
	    |	ДолгосрочнаяПросроченнаяЗадолженность.ДатаИнвентаризации = &ДатаПроверкиМежотчетныйПериод
		|	%УсловиеГод2026% 
		|	%Условие%
		|
	    |УПОРЯДОЧИТЬ ПО
	    |	Период УБЫВ";
	
	УсловиеГод2026 = "";
	Если Год(КонецПериода)>= 2026 Тогда
		УсловиеГод2026 = "И ДолгосрочнаяПросроченнаяЗадолженность.Период <= &ДатаОкончания";
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(КонецПериода));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатаПроверкиМежотчетныйПериод", ДатаПроверкиМежотчетныйПериод);
			
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%УсловиеГод2026%",УсловиеГод2026);
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%Условие%",Условие);
	
	Для Каждого КлючИЗначение Из СтруктураПолейОтбора Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	НачалоПериодаСУчетомИсправлений = НачалоПериода;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ДатыСУчетомИнвентаризации.Вставить("НачалоПериода", ДатаПроверкиМежотчетныйПериод);
		
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ДатыСУчетомИнвентаризации.Вставить("Регистратор",Выборка.Регистратор);	
		КонецЕсли;
		
		Если ЭтоОтчетИзменениеВалютыБаланса Тогда
			// Для того чтобы в 173/773 форме учитывать изменения валюты баланса без спец.периода, 
			// если введена корректирующая инвентаризация, используем существующие даты:
			// НачалоПериода - как дату с изменениями (на 01.01)
			// КонецПериода - как дату до изменений (31.12) - конец периода отчета при этом не используется при заполнении
			
			ДатыСУчетомИнвентаризации.Вставить("НачалоПериода", ДатаПроверкиМежотчетныйПериод);
			ДатыСУчетомИнвентаризации.Вставить("КонецПериода", НачалоПериода);
		КонецЕсли;
	Иначе
		Если ЭтоОтчетИзменениеВалютыБаланса Тогда
			//если это 173/773, и нет корректирующей инвентаризации на 01.01, то дату начала и дату окончания заполняем одинаково,
			//чтобы не было различий
			ДатыСУчетомИнвентаризации.Вставить("НачалоПериода", НачалоПериода);
			ДатыСУчетомИнвентаризации.Вставить("КонецПериода", НачалоПериода);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДатыСУчетомИнвентаризации;
	
КонецФункции

Процедура ДополнитьТаблицуПоДаннымДолгосрочной(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, СтруктураДат)
		
	//запрос надо изменять в зависимости от того, какие поля в Массиве полей
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ДолгосрочнаяПросроченнаяЗадолженность.СчетРасчетов КАК Счет,
	    |	ДолгосрочнаяПросроченнаяЗадолженность.Организация КАК Организация,
		|	ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности КАК ВидЗадолженностиДтКт,
	    |	ДолгосрочнаяПросроченнаяЗадолженность.КФО КАК КФО, "+?(СтруктураПолей.КПС,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.КПС КАК КПС,","")+?(СтруктураПолей.КЭК,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.КЭК КАК КЭК,","")+?(СтруктураПолей.ВидПоказателя,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.КПС.ВидПоказателя КАК ВидПоказателя,","")+?(СтруктураПолей.ИФО,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.ИФО КАК ИФО,","")+"
		|	ДолгосрочнаяПросроченнаяЗадолженность.Контрагент КАК Контрагент,
		|	ВЫБОР 
		|		КОГДА ДолгосрочнаяПросроченнаяЗадолженность.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА
		|			""1""
		|		КОГДА ДолгосрочнаяПросроченнаяЗадолженность.Контрагент.ТипКонтрагента = ЗНАЧЕНИЕ(Справочник.ТипыКонтрагентов.ПустаяСсылка) ТОГДА
		|			""0""
		|		ИНАЧЕ ДолгосрочнаяПросроченнаяЗадолженность.Контрагент.ТипКонтрагента.Код
		|	КОНЕЦ КАК ТипКонтрагентаКод,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Договор КАК Договор,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Долгосрочная КАК ДолгосрочнаяНачало,
	    |	0 КАК ДолгосрочнаяКонец
	    |ИЗ
	    |	РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность КАК ДолгосрочнаяПросроченнаяЗадолженность
	    |ГДЕ
	    |	ДолгосрочнаяПросроченнаяЗадолженность.ДатаИнвентаризации = &НачалоПериода
		|   И ДолгосрочнаяПросроченнаяЗадолженность.Долгосрочная <> 0
		|	%Условие%
		|	%УсловиеГод2026%
	    |
	    |ОБЪЕДИНИТЬ ВСЕ
	    |
	    |ВЫБРАТЬ
	    |	ДолгосрочнаяПросроченнаяЗадолженность.СчетРасчетов,
	    |	ДолгосрочнаяПросроченнаяЗадолженность.Организация,
		|	ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности,
	    |	ДолгосрочнаяПросроченнаяЗадолженность.КФО, "+?(СтруктураПолей.КПС,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.КПС,","")+?(СтруктураПолей.КЭК,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.КЭК,","")+?(СтруктураПолей.ВидПоказателя,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.КПС.ВидПоказателя,","")+?(СтруктураПолей.ИФО,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.ИФО,","")+"
		|	ДолгосрочнаяПросроченнаяЗадолженность.Контрагент,
	    |	ВЫБОР 
		|		КОГДА ДолгосрочнаяПросроченнаяЗадолженность.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА
		|			""1""
		|		КОГДА ДолгосрочнаяПросроченнаяЗадолженность.Контрагент.ТипКонтрагента = ЗНАЧЕНИЕ(Справочник.ТипыКонтрагентов.ПустаяСсылка) ТОГДА
		|			""0""
		|		ИНАЧЕ ДолгосрочнаяПросроченнаяЗадолженность.Контрагент.ТипКонтрагента.Код
		|	КОНЕЦ КАК ТипКонтрагентаКод,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Договор,
	    |	0,
	    |	ДолгосрочнаяПросроченнаяЗадолженность.Долгосрочная
	    |ИЗ
	    |	РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность КАК ДолгосрочнаяПросроченнаяЗадолженность
	    |ГДЕ
	    |	ДолгосрочнаяПросроченнаяЗадолженность.ДатаИнвентаризации = &КонецПериода
		|   И ДолгосрочнаяПросроченнаяЗадолженность.Долгосрочная <> 0
		|	%Условие%";
	
	УсловиеГод2026 = "";
	Если НачалоДня(НачалоПериода) = НачалоГода(НачалоПериода)
		И Год(НачалоПериода) >= 2026
		И СтруктураДат.Свойство("Регистратор") Тогда
		УсловиеГод2026 = "И ДолгосрочнаяПросроченнаяЗадолженность.Регистратор = &Регистратор";
		Запрос.УстановитьПараметр("Регистратор", СтруктураДат.Регистратор);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%Условие%",Условие);
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%УсловиеГод2026%",УсловиеГод2026);
	
	Для Каждого КлючИЗначение Из СтруктураПолейОтбора Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьДетальныйКЭКПоСчету(СтрокаТаблицыДанных, СчетДляКЭК, КЭКСчетов, КЭКДляЗаменыОстатков, КЭК000)
	
	КЭКОстаткаПоСчету = КЭКСчетов.Получить(СчетДляКЭК);
	Если КЭКОстаткаПоСчету = Неопределено Тогда
		Если СчетДляКЭК.БезДетализацииКОСГУ Тогда
			КЭКОстаткаПоСчету = КЭК000;
		Иначе
			КЭКПоЕПСБУ = СчетДляКЭК.КОСГУДт;
			КЭКОстаткаПоСчету = КЭКДляЗаменыОстатков.Получить(КЭКПоЕПСБУ);
			
			Если КЭКОстаткаПоСчету = КЭК000 Тогда
				КЭКОстаткаПоСчету = Неопределено;
			КонецЕсли;
		КонецЕсли;	
		
		Если КЭКОстаткаПоСчету <> Неопределено Тогда
			КЭКСчетов.Вставить(СчетДляКЭК, КЭКОстаткаПоСчету);
			СтрокаТаблицыДанных.КЭК = КЭКОстаткаПоСчету;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(КЭКОстаткаПоСчету) Тогда		
		СтрокаТаблицыДанных.КЭК = КЭКОстаткаПоСчету;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьКЭКОстатков(НачальныйКИЕ = 0)
	
	Перем ВыборкаКЭКОстатков, Запрос, КодыКЭКОстатков, КЭКОстатков, РезультатЗапроса, Сч;
	
	КодыКЭКОстатков = Новый Массив;
	
	Для Сч = НачальныйКИЕ По 9 Цикл
		КодыКЭКОстатков.Добавить("00"+Сч);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОСГУ.Ссылка КАК Ссылка,
	|	КОСГУ.Код КАК КОСГУКод
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Код В(&КодыКЭКОстатков)";
	
	Запрос.УстановитьПараметр("КодыКЭКОстатков", КодыКЭКОстатков);

	КЭКОстатков = Новый Соответствие;
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаКЭКОстатков = РезультатЗапроса.Выбрать();
	Пока ВыборкаКЭКОстатков.Следующий() Цикл
		КЭКОстатков.Вставить(ВыборкаКЭКОстатков.КОСГУКод, ВыборкаКЭКОстатков.Ссылка);
	КонецЦикла;
	
	Возврат КЭКОстатков;
	
КонецФункции

#КонецОбласти

//строка 101 форм 130/730/173/773
#Область ПолучитьВНД_ДолгосрочныеАктивы

Функция ПолучитьВНД_ДолгосрочныеАктивы(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
	Перем ВидЗадолженности;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	
	НачалоПериода = НачалоДня(НачалоПериода - 1);
	КонецПериода = НачалоДня(ЗаполнениеОтчетности.ПолучитьДатуИзПараметра(КонецПериода));
	
	//заполнить карты данных по методам обработки
	ТаблицаМетодовДополнительнойОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(ПравилоЗаполнения,,,Истина);
	КартыДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	ОбработкаЗаполнения = Обработки.ОбработкаДанныхОтчетности.Создать();
	
	Если НЕ ОбработкаЗаполнения.ПрименитьМетодыДополнительнойОбработки(КартыДанных, "КартыДанных", ТаблицаМетодовДополнительнойОбработки, ПравилоЗаполнения, Неопределено, "") Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
		
	ТипЧисло = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(18,2);
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Счет",Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДанных.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДанных.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДанных.Колонки.Добавить("КПС",Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДанных.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	
	ТаблицаДанных.Колонки.Добавить("ДолгосрочныеНачало",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("ДолгосрочныеКонец",ТипЧисло);
	
	СтруктураПолейОтбора = Новый Структура;
	
	Условие = "";
	УсловиеБаланс = "";
	ЕстьИФО = Ложь;
	
	Если ТипЗнч(ИФО) = Тип("Структура") Тогда
		Если ИФО.Свойство("Использование") 
			И ИФО.Использование = Истина Тогда
			ЕстьИФО = Истина;
			
			Если ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеБаланс = " И ДолгосрочныеПраваПользованияАктивами.ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеБаланс = " И ДолгосрочныеПраваПользованияАктивами.ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеБаланс = " И ДолгосрочныеПраваПользованияАктивами.ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеБаланс = " И НЕ ДолгосрочныеПраваПользованияАктивами.ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеБаланс = " И ДолгосрочныеПраваПользованияАктивами.ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеБаланс = " И ДолгосрочныеПраваПользованияАктивами.ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ИФО <> Неопределено Тогда
		ЕстьИФО = Истина;
		Если ТипЗнч(ИФО) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
			УсловиеБаланс = " И ДолгосрочныеПраваПользованияАктивами.ИФО = &ИФО";
			СтруктураПолейОтбора.Вставить("ИФО",ИФО);
		КонецЕсли;
	КонецЕсли;
	
	УсловиеОрганизация = "";//переопредится далее на равно
	
	УсловиеСпрОрганизация = "";
	
	Если ТипЗнч(Организация) = Тип("Структура") Тогда
		Если Организация.Свойство("Использование") 
			И Организация.Использование = Истина Тогда
			
			Если Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
				УсловиеСпрОрганизация = "Ссылка = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация <> &Организация";
				УсловиеСпрОрганизация = "Ссылка <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация В (&Организация)";
				УсловиеСпрОрганизация = "Ссылка В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				//УсловиеОрганизация = " И НЕ ДолгосрочнаяПросроченнаяЗадолженность.Организация В (&Организация)";
				УсловиеСпрОрганизация = "НЕ Ссылка В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация <> &Организация";
				УсловиеСпрОрганизация = "Ссылка <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
				УсловиеСпрОрганизация = "Ссылка = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
		УсловиеСпрОрганизация = "Ссылка = &Организация";
		СтруктураПолейОтбора.Вставить("Организация",Организация);
	КонецЕсли;
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ИФО",ЕстьИФО);//Истина); - необходимо определять нужность ИФО в зависимости от параметров
	СтруктураПолей.Вставить("КПС",Истина);//нужен всегда

	КодОКУД = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПравилоЗаполнения, "Владелец.КодФормыПоКлассификатору"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	&Условие";
	
	Если ЗначениеЗаполнено(УсловиеСпрОрганизация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие",УсловиеСпрОрганизация);
		Запрос.УстановитьПараметр("Организация",СтруктураПолейОтбора.Организация);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие","ИСТИНА");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивОрганизаций = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	//если отчет заполняется по нескольким организациям, то нужно для каждой организации индивидуально получать настройку - ДатыСУчетомИнвентаризации,
	//иначе остатки на начало года определяются не верно, потому сначала получаем организации по отбору, и по ним получаем настройку и данные регистра
	//и отбор в цикле задаем в этом случае всегда на равно	
	УсловиеОрганизация = " И ДолгосрочныеПраваПользованияАктивами.Организация = &Организация";
	
	Условие = УсловиеБаланс + УсловиеОрганизация;			
	УсловиеДляОпределенияДаты = УсловиеБаланс + УсловиеОрганизация;

	Для Каждого ТекОрг Из МассивОрганизаций Цикл
		СтруктураПолейОтбора.Вставить("Организация",ТекОрг);
		
		ДатыСУчетомИнвентаризации = ОпределитьДатыСУчетомИнвентаризацииДляАктивов(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, УсловиеДляОпределенияДаты, НачалоПериода, КонецПериода, КодОКУД);
		
		ДополнитьТаблицуПоДаннымДолгосрочныхАктивов(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, ДатыСУчетомИнвентаризации.НачалоПериода, ДатыСУчетомИнвентаризации.КонецПериода);
	КонецЦикла;
		
	ТаблицаДанных.Свернуть("Счет,Организация,ИФО,КФО,КПС,ОсновноеСредство","ДолгосрочныеНачало,ДолгосрочныеКонец");
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ОпределитьДатыСУчетомИнвентаризацииДляАктивов(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, КодОКУД)
	
	ЭтоОтчетИзменениеВалютыБаланса = Ложь;

	//используется код ОКУД, а не код вида отчета, потому что могут быть не типовые виды отчетов с другим кодом вида отчета
	Если КодОКУД = "0503173" ИЛИ КодОКУД = "0503773" Тогда
		ЭтоОтчетИзменениеВалютыБаланса = Истина;	
	КонецЕсли;

	ДатыСУчетомИнвентаризации = Новый Структура;
	ДатыСУчетомИнвентаризации.Вставить("НачалоПериода", НачалоПериода);
	ДатыСУчетомИнвентаризации.Вставить("КонецПериода", КонецПериода);
	
	// Для того, чтобы учесть исправления межотчетного периода по долгосрочным активам, используется спецаильный порядок ввода документов инвентаризации.
	// Основной режим ввода инвентаризации - последним днем предыдущего преиода (например, 31.12).
	// В этом случае, для отражения измненений межотчетного периода, следует ввести документ следующей датой (01.01).
	// Если такой документ найден, то используется дата, следующая за началом периода (используеются документы 01.01).
	ДатаПроверкиМежотчетныйПериод = НачалоДня(КонецДня(НачалоПериода)+1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	    |	ДолгосрочныеПраваПользованияАктивами.СчетУчета КАК Счет,
	    |	ДолгосрочныеПраваПользованияАктивами.Организация КАК Организация,
		|	ДолгосрочныеПраваПользованияАктивами.ОсновноеСредство КАК ОсновноеСредство,
	    |	ДолгосрочныеПраваПользованияАктивами.КФО КАК КФО, "+?(СтруктураПолей.ИФО,"
		|	ДолгосрочныеПраваПользованияАктивами.ИФО КАК ИФО,","")+"
		|	ДолгосрочныеПраваПользованияАктивами.ОстаточнаяСтоимость КАК ОстаточнаяСтоимость,
		|	ДолгосрочныеПраваПользованияАктивами.Долгосрочные КАК Долгосрочные
	    |ИЗ
	    |	РегистрСведений.ДолгосрочныеПраваПользованияАктивами КАК ДолгосрочныеПраваПользованияАктивами
	    |ГДЕ
	    |	ДолгосрочныеПраваПользованияАктивами.ДатаИнвентаризации = &ДатаПроверкиМежотчетныйПериод 
		|	%Условие%";
	
	Запрос.УстановитьПараметр("ДатаПроверкиМежотчетныйПериод", ДатаПроверкиМежотчетныйПериод);
			
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%Условие%",Условие);
	
	Для Каждого КлючИЗначение Из СтруктураПолейОтбора Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	НачалоПериодаСУчетомИсправлений = НачалоПериода;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ДатыСУчетомИнвентаризации.Вставить("НачалоПериода", ДатаПроверкиМежотчетныйПериод);
		
		Если ЭтоОтчетИзменениеВалютыБаланса Тогда
			// Для того чтобы в 173/773 форме учитывать изменения валюты баланса без спец.периода, 
			// если введена корректирующая инвентаризация, используем существующие даты:
			// НачалоПериода - как дату с изменениями (на 01.01)
			// КонецПериода - как дату до изменений (31.12) - конец периода отчета при этом не используется при заполнении
			
			ДатыСУчетомИнвентаризации.Вставить("НачалоПериода", ДатаПроверкиМежотчетныйПериод);
			ДатыСУчетомИнвентаризации.Вставить("КонецПериода", НачалоПериода);
		КонецЕсли;
	Иначе
		Если ЭтоОтчетИзменениеВалютыБаланса Тогда
			//если это 173/773, и нет корректирующей инвентаризации на 01.01, то дату начала и дату окончания заполняем одинаково,
			//чтобы не было различий
			ДатыСУчетомИнвентаризации.Вставить("НачалоПериода", НачалоПериода);
			ДатыСУчетомИнвентаризации.Вставить("КонецПериода", НачалоПериода);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДатыСУчетомИнвентаризации;
	
КонецФункции

Процедура ДополнитьТаблицуПоДаннымДолгосрочныхАктивов(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода)
	
	//запрос надо изменять в зависимости от того, какие поля в Массиве полей
	Запрос = Новый Запрос;
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ДолгосрочныеПраваПользованияАктивами.СчетУчета КАК Счет,
	    |	ДолгосрочныеПраваПользованияАктивами.Организация КАК Организация,
	    |	ДолгосрочныеПраваПользованияАктивами.КФО КАК КФО, 
		|	ДолгосрочныеПраваПользованияАктивами.КПС КАК КПС,"+?(СтруктураПолей.ИФО,"
		|	ДолгосрочныеПраваПользованияАктивами.ИФО КАК ИФО,","")+"
		|	ДолгосрочныеПраваПользованияАктивами.ОсновноеСредство КАК ОсновноеСредство,
		|	ДолгосрочныеПраваПользованияАктивами.Долгосрочные КАК ДолгосрочныеНачало,
	    |	0 КАК ДолгосрочныеКонец
	    |ИЗ
	    |	РегистрСведений.ДолгосрочныеПраваПользованияАктивами КАК ДолгосрочныеПраваПользованияАктивами
	    |ГДЕ
	    |	ДолгосрочныеПраваПользованияАктивами.ДатаИнвентаризации = &НачалоПериода
		|   И ДолгосрочныеПраваПользованияАктивами.Долгосрочные <> 0
		|	%Условие%
	    |
	    |ОБЪЕДИНИТЬ ВСЕ
	    |
	    |ВЫБРАТЬ
	    |	ДолгосрочныеПраваПользованияАктивами.СчетУчета КАК Счет,
	    |	ДолгосрочныеПраваПользованияАктивами.Организация КАК Организация,
	    |	ДолгосрочныеПраваПользованияАктивами.КФО КАК КФО, 
		|	ДолгосрочныеПраваПользованияАктивами.КПС КАК КПС,"+?(СтруктураПолей.ИФО,"
		|	ДолгосрочныеПраваПользованияАктивами.ИФО КАК ИФО,","")+"
		|	ДолгосрочныеПраваПользованияАктивами.ОсновноеСредство КАК ОсновноеСредство,
		|	0 КАК ДолгосрочныеНачало,
	    |	ДолгосрочныеПраваПользованияАктивами.Долгосрочные КАК ДолгосрочныеКонец
	    |ИЗ
	    |	РегистрСведений.ДолгосрочныеПраваПользованияАктивами КАК ДолгосрочныеПраваПользованияАктивами
	    |ГДЕ
	    |	ДолгосрочныеПраваПользованияАктивами.ДатаИнвентаризации = &КонецПериода
		|   И ДолгосрочныеПраваПользованияАктивами.Долгосрочные <> 0
		|	%Условие%";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%Условие%",Условие);
	
	Для Каждого КлючИЗначение Из СтруктураПолейОтбора Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти

#Область ПолучитьВНД_Просроченная

Функция ПолучитьВНД_Просроченная(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
	Перем ВидЗадолженности;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ДополнительныеПараметры.Свойство("ВидЗадолженности", ВидЗадолженности);
	КонецЕсли;

	НачалоПериода = НачалоДня(НачалоПериода - 1);
	КонецПериода = НачалоДня(ЗаполнениеОтчетности.ПолучитьДатуИзПараметра(КонецПериода));	
	
	ТипЧисло = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(18,2);
	ТипДата = БюджетнаяОтчетность.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата);
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Счет",Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДанных.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДанных.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДанных.Колонки.Добавить("КПС",Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДанных.Колонки.Добавить("ВидПоказателя",Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКБК"));
	ТаблицаДанных.Колонки.Добавить("ВидЗадолженностиДтКт",Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЗадолженности"));
	ТаблицаДанных.Колонки.Добавить("ТипКонтрагентаКод",Новый ОписаниеТипов("Строка"));
	ТаблицаДанных.Колонки.Добавить("Контрагент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДанных.Колонки.Добавить("Договор",Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	
	ТаблицаДанных.Колонки.Добавить("ДатаВозникновения",ТипДата);
	ТаблицаДанных.Колонки.Добавить("ДатаИсполнения",ТипДата);
	ТаблицаДанных.Колонки.Добавить("ПричинаОбразованияКод",ТипСтрока);
	ТаблицаДанных.Колонки.Добавить("ПричинаОбразованияПояснение",ТипСтрока);
	ТаблицаДанных.Колонки.Добавить("ПричинаОбразованияДополнительно",ТипСтрока);
	
	ТаблицаДанных.Колонки.Добавить("ПросроченнаяНачало",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("ПросроченнаяКонец",ТипЧисло);
	
	СтруктураПолейОтбора = Новый Структура;
	
	Условие = "";
	УсловиеБаланс = "";
	ЕстьИФО = Ложь;
	
	Если ТипЗнч(ИФО) = Тип("Структура") Тогда
		Если ИФО.Свойство("Использование") 
			И ИФО.Использование = Истина Тогда
			ЕстьИФО = Истина;
			
			Если ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеБаланс = " И НЕ ДолгосрочнаяПросроченнаяЗадолженность.ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ИФО <> Неопределено Тогда
		ЕстьИФО = Истина;
		Если ТипЗнч(ИФО) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
			УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО = &ИФО";
			СтруктураПолейОтбора.Вставить("ИФО",ИФО);
		КонецЕсли;
	КонецЕсли;
	
	УсловиеОрганизация = "";//переопредится далее на равно
	
	УсловиеСпрОрганизация = "";
	
	Если ТипЗнч(Организация) = Тип("Структура") Тогда
		Если Организация.Свойство("Использование") 
			И Организация.Использование = Истина Тогда
			
			Если Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
				УсловиеСпрОрганизация = "Ссылка = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация <> &Организация";
				УсловиеСпрОрганизация = "Ссылка <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация В (&Организация)";
				УсловиеСпрОрганизация = "Ссылка В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				//УсловиеОрганизация = " И НЕ ДолгосрочнаяПросроченнаяЗадолженность.Организация В (&Организация)";
				УсловиеСпрОрганизация = "НЕ Ссылка В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация <> &Организация";
				УсловиеСпрОрганизация = "Ссылка <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
				УсловиеСпрОрганизация = "Ссылка = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
		УсловиеСпрОрганизация = "Ссылка = &Организация";
		СтруктураПолейОтбора.Вставить("Организация",Организация);
	КонецЕсли;	
	
	УсловиеВидЗадолженностиДтКт = "";
	
	Если ТипЗнч(ВидЗадолженности) = Тип("Структура") Тогда
		Если ВидЗадолженности.Свойство("Использование") 
			И ВидЗадолженности.Использование = Истина Тогда
			
			Если ВидЗадолженности.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				И Строка(ВидЗадолженности.ПравоеЗначение) = "Кредиторская задолженность" Тогда
				УсловиеВидЗадолженностиДтКт = " И ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности = &ВидЗадолженностиДтКт";
				СтруктураПолейОтбора.Вставить("ВидЗадолженностиДтКт",Перечисления.ВидыЗадолженности.Кредиторская);
			ИначеЕсли ВидЗадолженности.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				И Строка(ВидЗадолженности.ПравоеЗначение) = "Дебиторская задолженность" Тогда
				УсловиеВидЗадолженностиДтКт = " И ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности = &ВидЗадолженностиДтКт";
				СтруктураПолейОтбора.Вставить("ВидЗадолженностиДтКт",Перечисления.ВидыЗадолженности.Дебиторская);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ВидЗадолженности) = Тип("СправочникСсылка.Субконто") Тогда
		Если Строка(ВидЗадолженности) = "Кредиторская задолженность" Тогда
			УсловиеВидЗадолженностиДтКт = " И ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности = &ВидЗадолженностиДтКт";
			СтруктураПолейОтбора.Вставить("ВидЗадолженностиДтКт",Перечисления.ВидыЗадолженности.Кредиторская);
		ИначеЕсли Строка(ВидЗадолженности) = "Дебиторская задолженность" Тогда
			УсловиеВидЗадолженностиДтКт = " И ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности = &ВидЗадолженностиДтКт";
			СтруктураПолейОтбора.Вставить("ВидЗадолженностиДтКт",Перечисления.ВидыЗадолженности.Дебиторская);
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ИФО",ЕстьИФО);//Истина); - необходимо определять нужность ИФО в зависимости от параметров
	СтруктураПолей.Вставить("КПС",Истина);//нужен всегда
	СтруктураПолей.Вставить("КЭК",Ложь);//не нужен до 2021 года
	СтруктураПолей.Вставить("ВидПоказателя",Истина);//нужен в основном для 169 формы, для поддержки различий БГУ1 и БГУ2
	
	КодОКУД = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПравилоЗаполнения, "Владелец.КодФормыПоКлассификатору"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	&Условие";
	
	Если ЗначениеЗаполнено(УсловиеСпрОрганизация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие",УсловиеСпрОрганизация);
		Запрос.УстановитьПараметр("Организация",СтруктураПолейОтбора.Организация);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие","ИСТИНА");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивОрганизаций = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	//если отчет заполняется по нескольким организациям, то нужно для каждой организации индивидуально получать настройку - ДатыСУчетомИнвентаризации,
	//иначе остатки на начало года определяются не верно, потому сначала получаем организации по отбору, и по ним получаем настройку и данные регистра
	//и отбор в цикле задаем в этом случае всегда на равно	
	УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
	
	Условие = УсловиеБаланс + УсловиеОрганизация + УсловиеВидЗадолженностиДтКт;			
	УсловиеДляОпределенияДаты = УсловиеБаланс + УсловиеОрганизация;

	Для Каждого ТекОрг Из МассивОрганизаций Цикл
    	СтруктураПолейОтбора.Вставить("Организация",ТекОрг);
		
		ДатыСУчетомИнвентаризации = ОпределитьДатыСУчетомИнвентаризации(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, УсловиеДляОпределенияДаты, НачалоПериода, КонецПериода, КодОКУД);
		
		ДополнитьТаблицуПоДаннымПросроченной(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, ДатыСУчетомИнвентаризации.НачалоПериода, ДатыСУчетомИнвентаризации.КонецПериода, ДатыСУчетомИнвентаризации);
	КонецЦикла;
		
	ТаблицаДанных.Свернуть("Счет,Организация,ИФО,КФО,КПС,
		|ВидПоказателя,ВидЗадолженностиДтКт,ТипКонтрагентаКод,Контрагент,Договор,
		|ДатаВозникновения,ДатаИсполнения,ПричинаОбразованияКод,ПричинаОбразованияПояснение,ПричинаОбразованияДополнительно",
		"ПросроченнаяНачало,ПросроченнаяКонец");
		
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПолучитьВНД_ПросроченнаяКЭК(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
	Перем ВидЗадолженности;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ДополнительныеПараметры.Свойство("ВидЗадолженности", ВидЗадолженности);
	КонецЕсли;
	
	//заполнить карты данных по методам обработки
	ТаблицаМетодовДополнительнойОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(ПравилоЗаполнения,,,Истина);
	КартыДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	ОбработкаЗаполнения = Обработки.ОбработкаДанныхОтчетности.Создать();
	
	Если НЕ ОбработкаЗаполнения.ПрименитьМетодыДополнительнойОбработки(КартыДанных, "КартыДанных", ТаблицаМетодовДополнительнойОбработки, ПравилоЗаполнения, Неопределено, "") Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	СоответствиеСчетаБезКЭК = Новый Соответствие;
	
	УчитыватьКартуКЭК000 = Истина;//общая настройка правила заполнения на использование карты данных СчетаБезКЭК
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("УчитыватьКартуКЭК000") Тогда
		
		Если ТипЗнч(ДополнительныеПараметры.УчитыватьКартуКЭК000) = Тип("Структура") Тогда
			
			Если ДополнительныеПараметры.УчитыватьКартуКЭК000.Свойство("ПравоеЗначение")
				И ДополнительныеПараметры.УчитыватьКартуКЭК000.ПравоеЗначение = Ложь Тогда
				
				УчитыватьКартуКЭК000 = Ложь;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДополнительныеПараметры.УчитыватьКартуКЭК000) = Тип("Булево") Тогда
			
			УчитыватьКартуКЭК000 = ДополнительныеПараметры.УчитыватьКартуКЭК000;
			
		КонецЕсли;
		
	КонецЕсли;
	
	КартаСчетовБезКЭК = Неопределено;
	Если УчитыватьКартуКЭК000 = Истина
		И КартыДанных.Свойство("СчетаБезКЭК",КартаСчетовБезКЭК) Тогда
		Если КартаСчетовБезКЭК.Колонки.Найти("Счет") <> Неопределено
			И КартаСчетовБезКЭК.Колонки.Найти("Использовать")<> Неопределено Тогда
			
			Для Каждого СтрКарты Из КартаСчетовБезКЭК.НайтиСтроки(Новый Структура("Использовать",Истина)) Цикл
				СоответствиеСчетаБезКЭК.Вставить(СтрКарты.Счет,Истина);	
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	НачалоПериода = НачалоДня(НачалоПериода - 1);
	КонецПериода = НачалоДня(ЗаполнениеОтчетности.ПолучитьДатуИзПараметра(КонецПериода));	
	
	ТипЧисло = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(18,2);
	ТипДата = БюджетнаяОтчетность.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата);
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Счет",Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДанных.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДанных.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДанных.Колонки.Добавить("КПС",Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДанных.Колонки.Добавить("КЭК",Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаДанных.Колонки.Добавить("ВидПоказателя",Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКБК"));
	ТаблицаДанных.Колонки.Добавить("ВидЗадолженностиДтКт",Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЗадолженности"));
	ТаблицаДанных.Колонки.Добавить("Контрагент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДанных.Колонки.Добавить("Договор",Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	
	ТаблицаДанных.Колонки.Добавить("ДатаВозникновения",ТипДата);
	ТаблицаДанных.Колонки.Добавить("ДатаИсполнения",ТипДата);
	ТаблицаДанных.Колонки.Добавить("ПричинаОбразованияКод",ТипСтрока);
	ТаблицаДанных.Колонки.Добавить("ПричинаОбразованияПояснение",ТипСтрока);
	ТаблицаДанных.Колонки.Добавить("ПричинаОбразованияДополнительно",ТипСтрока);
	
	ТаблицаДанных.Колонки.Добавить("ПросроченнаяНачало",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("ПросроченнаяКонец",ТипЧисло);
	
	СтруктураПолейОтбора = Новый Структура;
	
	Условие = "";
	УсловиеБаланс = "";
	ЕстьИФО = Ложь;
	
	Если ТипЗнч(ИФО) = Тип("Структура") Тогда
		Если ИФО.Свойство("Использование") 
			И ИФО.Использование = Истина Тогда
			ЕстьИФО = Истина;
			
			Если ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеБаланс = " И НЕ ДолгосрочнаяПросроченнаяЗадолженность.ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ИФО <> Неопределено Тогда
		ЕстьИФО = Истина;
		Если ТипЗнч(ИФО) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
			УсловиеБаланс = " И ДолгосрочнаяПросроченнаяЗадолженность.ИФО = &ИФО";
			СтруктураПолейОтбора.Вставить("ИФО",ИФО);
		КонецЕсли;
	КонецЕсли;
	
	УсловиеОрганизация = "";//переопредится далее на равно
	
	УсловиеСпрОрганизация = "";
	
	Если ТипЗнч(Организация) = Тип("Структура") Тогда
		Если Организация.Свойство("Использование") 
			И Организация.Использование = Истина Тогда
			
			Если Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
				УсловиеСпрОрганизация = "Ссылка = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация <> &Организация";
				УсловиеСпрОрганизация = "Ссылка <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация В (&Организация)";
				УсловиеСпрОрганизация = "Ссылка В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				//УсловиеОрганизация = " И НЕ ДолгосрочнаяПросроченнаяЗадолженность.Организация В (&Организация)";
				УсловиеСпрОрганизация = "НЕ Ссылка В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация <> &Организация";
				УсловиеСпрОрганизация = "Ссылка <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
				УсловиеСпрОрганизация = "Ссылка = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		//УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
		УсловиеСпрОрганизация = "Ссылка = &Организация";
		СтруктураПолейОтбора.Вставить("Организация",Организация);
	КонецЕсли;	
	
	УсловиеВидЗадолженностиДтКт = "";
	
	Если ТипЗнч(ВидЗадолженности) = Тип("Структура") Тогда
		Если ВидЗадолженности.Свойство("Использование") 
			И ВидЗадолженности.Использование = Истина Тогда
			
			Если ВидЗадолженности.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				И Строка(ВидЗадолженности.ПравоеЗначение) = "Кредиторская задолженность" Тогда
				УсловиеВидЗадолженностиДтКт = " И ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности = &ВидЗадолженностиДтКт";
				СтруктураПолейОтбора.Вставить("ВидЗадолженностиДтКт",Перечисления.ВидыЗадолженности.Кредиторская);
			ИначеЕсли ВидЗадолженности.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				И Строка(ВидЗадолженности.ПравоеЗначение) = "Дебиторская задолженность" Тогда
				УсловиеВидЗадолженностиДтКт = " И ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности = &ВидЗадолженностиДтКт";
				СтруктураПолейОтбора.Вставить("ВидЗадолженностиДтКт",Перечисления.ВидыЗадолженности.Дебиторская);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ВидЗадолженности) = Тип("СправочникСсылка.Субконто") Тогда
		Если Строка(ВидЗадолженности) = "Кредиторская задолженность" Тогда
			УсловиеВидЗадолженностиДтКт = " И ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности = &ВидЗадолженностиДтКт";
			СтруктураПолейОтбора.Вставить("ВидЗадолженностиДтКт",Перечисления.ВидыЗадолженности.Кредиторская);
		ИначеЕсли Строка(ВидЗадолженности) = "Дебиторская задолженность" Тогда
			УсловиеВидЗадолженностиДтКт = " И ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности = &ВидЗадолженностиДтКт";
			СтруктураПолейОтбора.Вставить("ВидЗадолженностиДтКт",Перечисления.ВидыЗадолженности.Дебиторская);
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ИФО",ЕстьИФО);//Истина); - необходимо определять нужность ИФО в зависимости от параметров
	СтруктураПолей.Вставить("КПС",Истина);//нужен всегда
	СтруктураПолей.Вставить("КЭК",Истина);//нужен с 2021 года
	СтруктураПолей.Вставить("ВидПоказателя",Истина);//нужен в основном для 169 формы, для поддержки различий БГУ1 и БГУ2
	
	КодОКУД = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПравилоЗаполнения, "Владелец.КодФормыПоКлассификатору"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	&Условие";
	
	Если ЗначениеЗаполнено(УсловиеСпрОрганизация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие",УсловиеСпрОрганизация);
		Запрос.УстановитьПараметр("Организация",СтруктураПолейОтбора.Организация);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие","ИСТИНА");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивОрганизаций = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	//если отчет заполняется по нескольким организациям, то нужно для каждой организации индивидуально получать настройку - ДатыСУчетомИнвентаризации,
	//иначе остатки на начало года определяются не верно, потому сначала получаем организации по отбору, и по ним получаем настройку и данные регистра
	//и отбор в цикле задаем в этом случае всегда на равно	
	УсловиеОрганизация = " И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация";
	
	Условие = УсловиеБаланс + УсловиеОрганизация + УсловиеВидЗадолженностиДтКт;			
	УсловиеДляОпределенияДаты = УсловиеБаланс + УсловиеОрганизация;

	Для Каждого ТекОрг Из МассивОрганизаций Цикл
    	СтруктураПолейОтбора.Вставить("Организация",ТекОрг);
		
		ДатыСУчетомИнвентаризации = ОпределитьДатыСУчетомИнвентаризации(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, УсловиеДляОпределенияДаты, НачалоПериода, КонецПериода, КодОКУД);
		
		ДополнитьТаблицуПоДаннымПросроченной(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, ДатыСУчетомИнвентаризации.НачалоПериода, ДатыСУчетомИнвентаризации.КонецПериода, ДатыСУчетомИнвентаризации);
	КонецЦикла;
	
	ТаблицаДанных.Свернуть("Счет,Организация,ИФО,КФО,КПС,КЭК,
		|ВидПоказателя,ВидЗадолженностиДтКт,Контрагент,Договор,
		|ДатаВозникновения,ДатаИсполнения,ПричинаОбразованияКод,ПричинаОбразованияПояснение,ПричинаОбразованияДополнительно",
		"ПросроченнаяНачало,ПросроченнаяКонец");
	
	КЭК000 = Справочники.КОСГУ.НайтиПоКоду("000");
	
	Если НачалоПериода = Дата(2020,12,31) Тогда
		
		МассивКонтрагентов = ТаблицаДанных.ВыгрузитьКолонку("Контрагент");
				
		Если МассивКонтрагентов.Количество() Тогда
			
			ТипыКонтрагентов = Новый Соответствие;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Контрагенты.Ссылка КАК Ссылка,
			|	Контрагенты.ТипКонтрагента.Код КАК ТипКонтрагентаКод
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.Ссылка В(&МассивКонтрагентов)";
			
			Запрос.УстановитьПараметр("МассивКонтрагентов", МассивКонтрагентов);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Выборка = РезультатЗапроса.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				ТипыКонтрагентов.Вставить(Выборка.Ссылка, Выборка.ТипКонтрагентаКод);
			КонецЦикла;
			
		Иначе
			ТипыКонтрагентов = Новый Соответствие;
		КонецЕсли;
		
		КЭКОстатков = ПолучитьКЭКОстатков();
		КЭКДляЗаменыОстатков = ПолучитьКЭКДляЗамены();
		КЭКСчетов = Новый Соответствие;
		
		Для Каждого СтрДанных Из ТаблицаДанных Цикл
			Если Не ЗначениеЗаполнено(СтрДанных.КЭК) Тогда
				// Если инвентариазция за 2020 год была заполнена без КЭК, дозаполняем КЭК по данным счета/контрагента.
				//Проверим, есть ли для счета единственный допустимый КЭК. 
				УстановитьДетальныйКЭКПоСчету(СтрДанных, СтрДанных.Счет, КЭКСчетов, КЭКДляЗаменыОстатков, КЭК000);
				
				Если НЕ ЗначениеЗаполнено(СтрДанных.КЭК) Тогда
				
					ТекТипКонтрагента = ТипыКонтрагентов[СтрДанных.Контрагент];
					КонтрагентЗаполнен = ЗначениеЗаполнено(СтрДанных.Контрагент);
					
					Если КонтрагентЗаполнен Тогда
						Если ТекТипКонтрагента = Неопределено Тогда
							КодКЭКПоКонтрагенту = "001"
						ИначеЕсли ЗначениеЗаполнено(ТекТипКонтрагента) Тогда
							КодКЭКПоКонтрагенту = "00"+ТекТипКонтрагента;
						Иначе
							КодКЭКПоКонтрагенту = "000";
						КонецЕсли;
					Иначе
						КодКЭКПоКонтрагенту = "001";
					КонецЕсли;
					СтрДанных.КЭК = КЭКОстатков.Получить(КодКЭКПоКонтрагенту);
					
				КонецЕсли;		
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
	//Для счетов из карты данных заменяем на КЭК 000
	Для Каждого СтрДанных Из ТаблицаДанных Цикл
		Если СоответствиеСчетаБезКЭК[СтрДанных.Счет] = Истина Тогда
			СтрДанных.КЭК = КЭК000;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаДанных.Свернуть("Счет,Организация,ИФО,КФО,КПС,КЭК,
		|ВидПоказателя,ВидЗадолженностиДтКт,Контрагент,Договор,
		|ДатаВозникновения,ДатаИсполнения,ПричинаОбразованияКод,ПричинаОбразованияПояснение,ПричинаОбразованияДополнительно",
		"ПросроченнаяНачало,ПросроченнаяКонец");
	
	Возврат ТаблицаДанных;
	
КонецФункции

Процедура ДополнитьТаблицуПоДаннымПросроченной(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, СтруктураДат)
	
	//запрос надо изменять в зависимости от того, какие поля в Массиве полей
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ДолгосрочнаяПросроченнаяЗадолженность.СчетРасчетов КАК Счет,
	    |	ДолгосрочнаяПросроченнаяЗадолженность.Организация КАК Организация,
		|	ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности КАК ВидЗадолженностиДтКт,
	    |	ДолгосрочнаяПросроченнаяЗадолженность.КФО КАК КФО, "+?(СтруктураПолей.КПС,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.КПС КАК КПС,","")+?(СтруктураПолей.КЭК,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.КЭК КАК КЭК,","")+?(СтруктураПолей.ВидПоказателя,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.КПС.ВидПоказателя КАК ВидПоказателя,","")+?(СтруктураПолей.ИФО,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.ИФО КАК ИФО,","")+"
	    |	ВЫБОР 
		|		КОГДА ДолгосрочнаяПросроченнаяЗадолженность.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА
		|			""1""
		|		КОГДА ДолгосрочнаяПросроченнаяЗадолженность.Контрагент.ТипКонтрагента = ЗНАЧЕНИЕ(Справочник.ТипыКонтрагентов.ПустаяСсылка) ТОГДА
		|			""0""
		|		ИНАЧЕ ДолгосрочнаяПросроченнаяЗадолженность.Контрагент.ТипКонтрагента.Код
		|	КОНЕЦ КАК ТипКонтрагентаКод,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Контрагент КАК Контрагент,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Договор КАК Договор,
		|	НАЧАЛОПЕРИОДА(ДолгосрочнаяПросроченнаяЗадолженность.ДатаВозникновения, МЕСЯЦ) КАК ДатаВозникновения,
		|	НАЧАЛОПЕРИОДА(ДолгосрочнаяПросроченнаяЗадолженность.ДатаИсполнения, МЕСЯЦ) КАК ДатаИсполнения,
		|	ДолгосрочнаяПросроченнаяЗадолженность.ПричинаОбразованияКод КАК ПричинаОбразованияКод,
		|	ДолгосрочнаяПросроченнаяЗадолженность.ПричинаОбразованияПояснение КАК ПричинаОбразованияПояснение,
		|	ДолгосрочнаяПросроченнаяЗадолженность.ПричинаОбразованияДополнительно КАК ПричинаОбразованияДополнительно,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Просроченная КАК ПросроченнаяНачало,
	    |	0 КАК ПросроченнаяКонец
	    |ИЗ
	    |	РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность КАК ДолгосрочнаяПросроченнаяЗадолженность
	    |ГДЕ
	    |	ДолгосрочнаяПросроченнаяЗадолженность.ДатаИнвентаризации = &НачалоПериода
		|   И ДолгосрочнаяПросроченнаяЗадолженность.Просроченная <> 0
		|	%Условие%
		|	%УсловиеГод2026%
	    |
	    |ОБЪЕДИНИТЬ ВСЕ
	    |
	    |ВЫБРАТЬ
	    |	ДолгосрочнаяПросроченнаяЗадолженность.СчетРасчетов,
	    |	ДолгосрочнаяПросроченнаяЗадолженность.Организация,
		|	ДолгосрочнаяПросроченнаяЗадолженность.ВидЗадолженности,
	    |	ДолгосрочнаяПросроченнаяЗадолженность.КФО, "+?(СтруктураПолей.КПС,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.КПС,","")+?(СтруктураПолей.КЭК,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.КЭК,","")+?(СтруктураПолей.ВидПоказателя,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.КПС.ВидПоказателя,","")+?(СтруктураПолей.ИФО,"
		|	ДолгосрочнаяПросроченнаяЗадолженность.ИФО,","")+"
	    |	ВЫБОР 
		|		КОГДА ДолгосрочнаяПросроченнаяЗадолженность.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА
		|			""1""
		|		КОГДА ДолгосрочнаяПросроченнаяЗадолженность.Контрагент.ТипКонтрагента = ЗНАЧЕНИЕ(Справочник.ТипыКонтрагентов.ПустаяСсылка) ТОГДА
		|			""0""
		|		ИНАЧЕ ДолгосрочнаяПросроченнаяЗадолженность.Контрагент.ТипКонтрагента.Код
		|	КОНЕЦ КАК ТипКонтрагентаКод,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Контрагент,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Договор,
		|	НАЧАЛОПЕРИОДА(ДолгосрочнаяПросроченнаяЗадолженность.ДатаВозникновения, МЕСЯЦ),
		|	НАЧАЛОПЕРИОДА(ДолгосрочнаяПросроченнаяЗадолженность.ДатаИсполнения, МЕСЯЦ),
		|	ДолгосрочнаяПросроченнаяЗадолженность.ПричинаОбразованияКод,
		|	ДолгосрочнаяПросроченнаяЗадолженность.ПричинаОбразованияПояснение,
		|	ДолгосрочнаяПросроченнаяЗадолженность.ПричинаОбразованияДополнительно,
	    |	0,
	    |	ДолгосрочнаяПросроченнаяЗадолженность.Просроченная
	    |ИЗ
	    |	РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность КАК ДолгосрочнаяПросроченнаяЗадолженность
	    |ГДЕ
	    |	ДолгосрочнаяПросроченнаяЗадолженность.ДатаИнвентаризации = &КонецПериода
		|   И ДолгосрочнаяПросроченнаяЗадолженность.Просроченная <> 0
		|	%Условие%";
	
	УсловиеГод2026 = "";
	Если НачалоДня(НачалоПериода) = НачалоГода(НачалоПериода)
		И Год(НачалоПериода) >= 2026
		И СтруктураДат.Свойство("Регистратор") Тогда
		УсловиеГод2026 = "И ДолгосрочнаяПросроченнаяЗадолженность.Регистратор = &Регистратор";
		Запрос.УстановитьПараметр("Регистратор", СтруктураДат.Регистратор);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%Условие%",Условие);
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%УсловиеГод2026%",УсловиеГод2026);
	
	Для Каждого КлючИЗначение Из СтруктураПолейОтбора Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

//для форм 110/710
Функция ПолучитьВНД_Обороты109(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
	Перем ВидЗадолженности;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	
	Если ТипЗнч(КонецПериода) = Тип("Дата") Тогда
		КонецПериода = Новый Граница(КонецПериода,ВидГраницы.Включая);
	КонецЕсли;
	
	ТипЧисло = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(18,2);
	ТипДата = БюджетнаяОтчетность.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата);
	
	//Принцип работы:
	//1. Рассчитываем по отдельности обороты за год:
	//Д-т 109.60, К-т 109.70                - X
	//Д-т 109.60, К-т 109.80                - Y
	//Д-т 109.60, К-т <ПрочиеСчета>  		- Z
	//остаток 109.60 на начало года  		- A
	//остаток 109.60 на конец года  		- B

	//Нужно найти сколько оборотов X содержится в годовых оборотах Д-т 401.10, К-т 109.60 - обозначим O.
	// для счета 109.70 = O * X / (A + X + Y + Z - B) 
	// для счета 109.80 = O * Y / (A + X + Y + Z - B)
	//все расчеты выполняются в разрезе КФО, КПС, Организации, ИФО
	
		
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДанных.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДанных.Колонки.Добавить("КПС401",Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДанных.Колонки.Добавить("КЭК401",Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаДанных.Колонки.Добавить("КПС109",Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДанных.Колонки.Добавить("КЭК109",Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаДанных.Колонки.Добавить("Субконто1_109");
	ТаблицаДанных.Колонки.Добавить("Субконто2_109");
	ТаблицаДанных.Колонки.Добавить("Субконто3_109");
	
	ТаблицаДанных.Колонки.Добавить("Сумма109",ТипЧисло);   //-O
	ТаблицаДанных.Колонки.Добавить("Сумма10970_ДляРасчета",ТипЧисло); //-X
	ТаблицаДанных.Колонки.Добавить("Сумма10980_ДляРасчета",ТипЧисло); //-Y
	ТаблицаДанных.Колонки.Добавить("СуммаПрочие_ДляРасчета",ТипЧисло);//-Z
	ТаблицаДанных.Колонки.Добавить("СуммаНачОст_ДляРасчета",ТипЧисло);//-A
	ТаблицаДанных.Колонки.Добавить("СуммаКонОст_ДляРасчета",ТипЧисло);//-B
	
