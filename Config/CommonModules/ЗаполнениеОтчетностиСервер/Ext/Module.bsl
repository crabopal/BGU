	ТаблицаДанныхИО.Свернуть("Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ИФО,КФО,КЭК,Период,КодПричиныОшибки","СуммаИООбычныеОборот,СуммаИОКонтрольОборот");

	
	//Т.к. в начале года остатки на 001-009, в середине года обороты по 56х/66х и 73х/83х, то после замены кэк нужно исправить конечные остатки,
	//иначе получится, что если до замены было: 
	//по 001 остаток на начало по дт 100,
	//по 561/661 оборот в кт 150
	//и на конец года будет по 001 остаток по дт 100, а по 561/661 остаток по кт 150.
	//А должно быть по 001 остаток на конец по кт 50, и все.
	
	Для Каждого СтрТЧ Из ТаблицаДанных Цикл
		//т.к. форма может заполняться не с начала года, то остатки на начало отчетного периода могут быть на разных КЭК - 561/661,
		//необходимо их объединить
		Если СтрТЧ.НачальныйОстатокДт <> 0
			ИЛИ СтрТЧ.НачальныйОстатокКт <> 0 Тогда
			
			Если СтрТЧ.НачальныйОстатокДт >= СтрТЧ.НачальныйОстатокКт Тогда
				СтрТЧ.НачальныйОстатокДт = СтрТЧ.НачальныйОстатокДт - СтрТЧ.НачальныйОстатокКт;
				СтрТЧ.НачальныйОстатокКт = 0;
			Иначе
				СтрТЧ.НачальныйОстатокКт = СтрТЧ.НачальныйОстатокКт - СтрТЧ.НачальныйОстатокДт;
				СтрТЧ.НачальныйОстатокДт = 0;
			КонецЕсли;
			
		КонецЕсли;
			
		Если СтрТЧ.КонечныйОстатокДт <> 0
			ИЛИ СтрТЧ.КонечныйОстатокКт <> 0 Тогда
				
			Если СтрТЧ.КонечныйОстатокДт >= СтрТЧ.КонечныйОстатокКт Тогда
				СтрТЧ.КонечныйОстатокДт = СтрТЧ.КонечныйОстатокДт - СтрТЧ.КонечныйОстатокКт;
				СтрТЧ.КонечныйОстатокКт = 0;
			Иначе
				СтрТЧ.КонечныйОстатокКт = СтрТЧ.КонечныйОстатокКт - СтрТЧ.КонечныйОстатокДт;
				СтрТЧ.КонечныйОстатокДт = 0;
			КонецЕсли;
		
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаПоКодамПричин = Новый ТаблицаЗначений;
	
	ТаблицаПоКодамПричин.Колонки.Добавить("Счет",Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаПоКодамПричин.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаПоКодамПричин.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаПоКодамПричин.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаПоКодамПричин.Колонки.Добавить("КЭК",Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаПоКодамПричин.Колонки.Добавить("КодПричиныОшибки",Новый ОписаниеТипов("ПеречислениеСсылка.КодыПричинОшибокПрошлыхЛет"));
	ТаблицаПоКодамПричин.Колонки.Добавить("СуммаДт",ТипЧисло);
	ТаблицаПоКодамПричин.Колонки.Добавить("СуммаКт",ТипЧисло);
	
	//Дополним таблицу данных строками, которых нет по аналитике из ТаблицаДанныхИО
	ДобавленныйИндекс = ТаблицаДанных.Индексы.Добавить("Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ИФО,КФО,КЭК");
	
	ТаблицаДляДополнения = ТаблицаДанныхИО.Скопировать(,"Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ИФО,КФО,КЭК");
	ТаблицаДляДополнения.Свернуть("Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ИФО,КФО,КЭК");
	Для Каждого СтрТЧ Из ТаблицаДляДополнения Цикл
		СтруктураПоиска = Новый Структура("Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ИФО,КФО,КЭК");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрТЧ);
		Если ТаблицаДанных.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда
			НовСтр = ТаблицаДанных.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,СтруктураПоиска);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаДанных.Индексы.Удалить(ДобавленныйИндекс);
	
	//Далее необходимо распределить СуммаИООборот отдельно на исправление дебиторской задолженности и отдельно на исправление кредиторской задолженности,
	//И только после этого свернуть таблицу по субконто, чтобы получить обобщенные остатки
	//Возможна ситуация, когда на начало периода была кт задолженность на 100р, а в течение отчетного периода были проводки исправления ошибок:
	//1) со счетами ИО контроля в дт счета 80р
	//2) со счетами ИО обычными в дт счета 40р
	//На конец периода должна быть сумма 20р по дт задолженности.
	//Чтобы правильно распределить эти суммы - какие обороты сначала учитывать для погашения кт задолженности, а какие потом,
	//суммы анализируются по порядку отражения в учете, то есть сортируются по периоду.
	
	ТаблицаДанных.Колонки.Добавить("СуммаИООбычныеДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("СуммаИООбычныеКт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("СуммаИОКонтрольДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("СуммаИОКонтрольКт",ТипЧисло);
	
	ТаблицаДанныхИО.Индексы.Добавить("Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ИФО,КФО,КЭК");

	Для Каждого СтрТЧ Из ТаблицаДанных Цикл
		
		СтруктураПоиска = Новый Структура("Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ИФО,КФО,КЭК");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрТЧ);
		
		ТекТаблицаИО = ТаблицаДанныхИО.Скопировать(СтруктураПоиска);
		ТекТаблицаИО.Сортировать("Период");
		
		Для Каждого СтрИО Из ТекТаблицаИО Цикл
		
			//заодно заполним колонки СуммаИОДт и СуммаИОКт
			Если СтрИО.СуммаИООбычныеОборот=0 
				И СтрИО.СуммаИОКонтрольОборот=0 Тогда
				Продолжить;
			КонецЕсли;
						
			РаспределитьСуммуИО(СтрИО, СтрТЧ, "СуммаИООбычные",ТаблицаПоКодамПричин);
			РаспределитьСуммуИО(СтрИО, СтрТЧ, "СуммаИОКонтроль",Неопределено);

		КонецЦикла;		
	КонецЦикла;
	
	КартаРС = Неопределено;
	
	//После того как распределили задолженность, можно свернуть таблицу детальных данных
	//КПС в данном наборе не нужен, по нему свернем.
	//По организации и ИФО сворачивать нельзя никогда, 
	//т.к. в правилах заполнения на набор дополнительно накладываются по ним отбор.
	//КЭК теперь не нужно, его убираем.
	Если ВернутьТаблицуПоКодамПричин Тогда
		ТаблицаПоКодамПричин.Свернуть("Счет,Организация,ИФО,КФО,КЭК,КодПричиныОшибки","СуммаДт,СуммаКт");
		Возврат ТаблицаПоКодамПричин;
	Иначе
		ТаблицаДанных.Свернуть("Счет,Организация,ИФО,КФО","НачальныйОстатокДт,НачальныйОстатокКт,КонечныйОстатокДт,КонечныйОстатокКт,СуммаИООбычныеДт,СуммаИООбычныеКт,СуммаИОКонтрольДт,СуммаИОКонтрольКт");	
		Возврат ТаблицаДанных;
	КонецЕсли;
		
КонецФункции

Процедура РаспределитьСуммуИО(Знач СтрИО, Знач СтрТЧ, ИмяПоляСуммы, ТаблицаПоКодамПричин)
	
	Перем СуммаИООборотПоложительная, ТекНачальныйОстатокДт, ТекНачальныйОстатокКт;
	
	ТекНачальныйОстатокКт = СтрТЧ.НачальныйОстатокКт + СтрТЧ.СуммаИООбычныеКт + СтрТЧ.СуммаИОКонтрольКт;
	ТекНачальныйОстатокДт = СтрТЧ.НачальныйОстатокДт + СтрТЧ.СуммаИООбычныеДт + СтрТЧ.СуммаИОКонтрольДт;
	
	ЗаполнятьПоКодамПричин = ТаблицаПоКодамПричин <> Неопределено;
	
	АнализируемаяСумма = СтрИО[ИмяПоляСуммы+"Оборот"];
	//Если сумма исправления >0 и есть КТ задолженность, нужно сначала уменьшить остаток по Кт,
	//а на оставшуюся сумму увеличить дт
	
	СуммаДт = 0;
	СуммаКт = 0;
	Если АнализируемаяСумма>0
		И ТекНачальныйОстатокКт>0 Тогда
		
		РаспределеннаяСумма = - Мин(АнализируемаяСумма,ТекНачальныйОстатокКт); //уменьшаем остаток, знак минус
		
		СуммаДт = АнализируемаяСумма + РаспределеннаяСумма;
		СуммаКт = РаспределеннаяСумма;
		
		
		СтрТЧ[ИмяПоляСуммы+"Кт"] = СтрТЧ[ИмяПоляСуммы+"Кт"] + СуммаКт; //складываем, т.к. РаспределеннаяСумма отрицательная
		СтрТЧ[ИмяПоляСуммы+"Дт"] = СтрТЧ[ИмяПоляСуммы+"Дт"] + СуммаДт;//складываем, т.к. РаспределеннаяСумма - отрицательная
		
		//Если сумма исправления <0 и есть ДТ задолженность, нужно сначала уменьшить остаток по ДТ,
		//а на оставшуюся сумму увеличить КТ	
	ИначеЕсли АнализируемаяСумма<0
		И ТекНачальныйОстатокДт>0 Тогда
		
		СуммаИООборотПоложительная = -1*АнализируемаяСумма;
		РаспределеннаяСумма  = - Мин(СуммаИООборотПоложительная,ТекНачальныйОстатокДт);
		
		СуммаДт = РаспределеннаяСумма;
		СуммаКт = СуммаИООборотПоложительная + РаспределеннаяСумма;
		
		СтрТЧ[ИмяПоляСуммы+"Дт"] = СтрТЧ[ИмяПоляСуммы+"Дт"] + СуммаДт; //складываем, т.к. РаспределеннаяСумма - отрицательная
		СтрТЧ[ИмяПоляСуммы+"Кт"] = СтрТЧ[ИмяПоляСуммы+"Кт"] + СуммаКт;//складываем, т.к. РаспределеннаяСумма - отрицательная
		
		//НЕТ КТ задолженности и сумма исправления >0, тогда вся сумма исправления это увеличение ДТ	
	ИначеЕсли АнализируемаяСумма>0 Тогда
		
		СуммаДт = АнализируемаяСумма;
		СтрТЧ[ИмяПоляСуммы+"Дт"] = СтрТЧ[ИмяПоляСуммы+"Дт"] + СуммаДт;
		//СтрТЧ[ИмяПоляСуммы+"Кт"] = 0;
		
		//НЕТ ДТ задолженности и сумма исправления <0, тогда вся сумма исправления это увеличение КТ	
	ИначеЕсли АнализируемаяСумма<0 Тогда
		
		//СтрТЧ[ИмяПоляСуммы+"Дт"] = 0;
		СуммаКт = - АнализируемаяСумма;
		СтрТЧ[ИмяПоляСуммы+"Кт"] = СтрТЧ[ИмяПоляСуммы+"Кт"] + СуммаКт;
		
	КонецЕсли;
	
	Если ЗаполнятьПоКодамПричин Тогда
		НовСтр = ТаблицаПоКодамПричин.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрИО);
		НовСтр.СуммаДт = СуммаДт;
		НовСтр.СуммаКт = СуммаКт;
	КонецЕсли;
КонецПроцедуры

Процедура ДополнитьТаблицуПоРазворотуСубконтоПоВидамСчетовИО(ТаблицаДанных, ТаблицаДанныхИО, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, ВсеСчетаИО, МассивСчетовОшибокОбычные, МассивСчетовОшибокКонтроль)
	
	МассивСтрок = КартаРС.НайтиСтроки(СтруктураОтбора);
			
	МассивСчетов = Новый Массив;
	Если МассивСтрок.Количество() >0 Тогда
		Для Каждого ТекСтр Из МассивСтрок Цикл
			МассивСчетов.Добавить(ТекСтр.Счет);
		КонецЦикла;
		
		Для Каждого КлючИЗначение Из СтруктураОтбора Цикл
			СтруктураПолей.Вставить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
		КонецЦикла;
	    //данные по остаткам заполняются общим запросом
		//ДополнитьТаблицуПоДаннымОстатковИОборотов(ТаблицаДанных, СтруктураПолей, МассивСчетов, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода);
		ДополнитьТаблицуПоДаннымИсправленияОшибокПоВидамСчетовИО(ТаблицаДанныхИО, СтруктураПолей, МассивСчетов, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, ВсеСчетаИО, МассивСчетовОшибокОбычные, МассивСчетовОшибокКонтроль);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьТаблицуПоРазворотуСубконто(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовОшибок)
	
	МассивСтрок = КартаРС.НайтиСтроки(СтруктураОтбора);
			
	МассивСчетов = Новый Массив;
	Если МассивСтрок.Количество() >0 Тогда
		Для Каждого ТекСтр Из МассивСтрок Цикл
			МассивСчетов.Добавить(ТекСтр.Счет);
		КонецЦикла;
		
		Для Каждого КлючИЗначение Из СтруктураОтбора Цикл
			СтруктураПолей.Вставить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
		КонецЦикла;
	
		ДополнитьТаблицуПоДаннымОстатковИОборотов(ТаблицаДанных, СтруктураПолей, МассивСчетов, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода);
		ДополнитьТаблицуПоДаннымИсправленияОшибок(ТаблицаДанных, СтруктураПолей, МассивСчетов, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовОшибок);
	КонецЕсли;
	
КонецПроцедуры


//с 2022 для 173/773 - для остатков до изменения баланса
Функция ПолучитьВНД_РазвернутыеОстаткиКЭКНаДату(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем ДополнительныйПериод1;
	Перем ДополнительныйПериод2;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
	
	
	
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	
	СтруктураПараметров.Свойство("ДополнительныйПериод1", ДополнительныйПериод1);
	СтруктураПараметров.Свойство("ДополнительныйПериод2", ДополнительныйПериод2);
	
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	
	Если ТипЗнч(КонецПериода) = Тип("Дата") Тогда
		КонецПериода = Новый Граница(КонецПериода,ВидГраницы.Включая);
	КонецЕсли;
	
	ПараметрПериода = ПараметрыСхемы.Найти("ПериодОтчета_"+ИмяНабора);
	
	Если ПараметрПериода<>Неопределено Тогда
		Если ПараметрПериода.Выражение = "&ДополнительныйПериод1" Тогда
			ДатаОстатков = ДополнительныйПериод1;
		ИначеЕсли ПараметрПериода.Выражение = "&ДополнительныйПериод2" Тогда
			ДатаОстатков = ДополнительныйПериод2;
		ИначеЕсли ПараметрПериода.Выражение = "&НачалоПериода" Тогда
			ДатаОстатков = НачалоПериода;
		Иначе
			//считаем, что это конец периода, т.к. сейчас используется выражение ЗаполнениеОтчетности.ПреобразоватьКонецПериода(&КонецПериода)  
			ДатаОстатков = КонецПериода;	
		КонецЕсли;
	КонецЕсли;
		
	ТаблицаМетодовДополнительнойОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(ПравилоЗаполнения,,,Истина);
	КартыДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	ОбработкаЗаполнения = Обработки.ОбработкаДанныхОтчетности.Создать();
	
