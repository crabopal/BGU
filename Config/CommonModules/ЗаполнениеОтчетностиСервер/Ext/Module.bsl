	//	ТабКПС = ТаблицаДанных.Скопировать(,"КПС");
	//	ТабКПС.Свернуть("КПС");
	//	ЗначенияКПС = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ТабКПС.ВыгрузитьКолонку("КПС"),"ВидПоказателя");
	//	Для Каждого СтрТЧ Из ТаблицаДанных Цикл
	//		СтрТЧ.ВидПоказателя = ЗначенияКПС[СтрТЧ.КПС];
	//	КонецЦикла;
	//	
	//КонецЕсли;
		
	Возврат ТаблицаДанных;
	
КонецФункции

Процедура ЗаполнитьТаблицуПоДанным401_10960(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОбороты.Организация КАК Организация,
		|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,"+?(СтруктураПолей.ИФО,"
		|	ЖурналПроводокЕПСБУОбороты.ИФО КАК ИФО,","")+"
		|	ЖурналПроводокЕПСБУОбороты.КПС КАК КПС401,
		|	ЖурналПроводокЕПСБУОбороты.КЭК КАК КЭК401,
		|	ЖурналПроводокЕПСБУОбороты.КПСКор КАК КПС109,
		|	ЕстьNull(ЖурналПроводокЕПСБУОбороты.КорСубконто1,Неопределено) КАК Субконто1_109,
		|	ЕстьNull(ЖурналПроводокЕПСБУОбороты.КорСубконто2,Неопределено) КАК Субконто2_109,
		|	ЖурналПроводокЕПСБУОбороты.КЭККор КАК КЭК109,
		|	СУММА(ЖурналПроводокЕПСБУОбороты.СуммаОборот) КАК Сумма109
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, , Счет В (&Счет401), ,%Условие% , КорСчет В (&Счет10960), ) КАК ЖурналПроводокЕПСБУОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ЖурналПроводокЕПСБУОбороты.Организация,
		|	ЖурналПроводокЕПСБУОбороты.КФО,"+?(СтруктураПолей.ИФО,"
		|	ЖурналПроводокЕПСБУОбороты.ИФО,","")+"
		|	ЖурналПроводокЕПСБУОбороты.КПС,
		|	ЖурналПроводокЕПСБУОбороты.КЭК,
		|	ЖурналПроводокЕПСБУОбороты.КПСКор,
		|	ЕстьNull(ЖурналПроводокЕПСБУОбороты.КорСубконто1,Неопределено),
		|	ЕстьNull(ЖурналПроводокЕПСБУОбороты.КорСубконто2,Неопределено),
		|	ЖурналПроводокЕПСБУОбороты.КЭККор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОбороты.Организация КАК Организация,
		|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,"+?(СтруктураПолей.ИФО,"
		|	ЖурналПроводокЕПСБУОбороты.ИФО КАК ИФО,","")+"
		|	ЖурналПроводокЕПСБУОбороты.КПС КАК КПС109,
		|	ЕстьNull(ЖурналПроводокЕПСБУОбороты.Субконто1,Неопределено) КАК Субконто1_109,
		|	ЕстьNull(ЖурналПроводокЕПСБУОбороты.Субконто2,Неопределено) КАК Субконто2_109,
		|	ЖурналПроводокЕПСБУОбороты.КЭК КАК КЭК109,
		|	СУММА(ВЫБОР
		|			КОГДА ЖурналПроводокЕПСБУОбороты.КорСчет В (&Счет10970)
		|				ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Сумма10970_ДляРасчета,
		|	СУММА(ВЫБОР
		|			КОГДА ЖурналПроводокЕПСБУОбороты.КорСчет В (&Счет10980)
		|				ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Сумма10980_ДляРасчета,
		|	СУММА(ВЫБОР
		|			КОГДА НЕ ЖурналПроводокЕПСБУОбороты.КорСчет В (&СчетаКроме)
		|				ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаПрочие_ДляРасчета
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, , Счет В (&Счет10960), ,%Условие% , , ) КАК ЖурналПроводокЕПСБУОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ЖурналПроводокЕПСБУОбороты.Организация,
		|	ЖурналПроводокЕПСБУОбороты.КФО,"+?(СтруктураПолей.ИФО,"
		|	ЖурналПроводокЕПСБУОбороты.ИФО,","")+"
		|	ЖурналПроводокЕПСБУОбороты.КПС,
		|	ЕстьNull(ЖурналПроводокЕПСБУОбороты.Субконто1,Неопределено),
		|	ЕстьNull(ЖурналПроводокЕПСБУОбороты.Субконто2,Неопределено),
		|	ЖурналПроводокЕПСБУОбороты.КЭК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Организация КАК Организация,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.КФО КАК КФО,"+?(СтруктураПолей.ИФО,"
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.ИФО КАК ИФО,","")+"
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.КПС КАК КПС109,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто1, НЕОПРЕДЕЛЕНО) КАК Субконто1_109,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто2, НЕОПРЕДЕЛЕНО) КАК Субконто2_109,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.КЭК КАК КЭК109,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачОст_ДляРасчета,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонОст_ДляРасчета
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , Счет В (&Счет10960), ,%Условие% ) КАК ЖурналПроводокЕПСБУОстаткиИОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Организация,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.КФО,"+?(СтруктураПолей.ИФО,"
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.ИФО,","")+"
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.КПС,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто1, НЕОПРЕДЕЛЕНО),
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто2, НЕОПРЕДЕЛЕНО),
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.КЭК,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаНачальныйОстаток,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаКонечныйОстаток";
		
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Счет10960", БухгалтерскийУчет.СписокСчетов("109.60"));
	Запрос.УстановитьПараметр("Счет10970", БухгалтерскийУчет.СписокСчетов("109.70"));
	Запрос.УстановитьПараметр("Счет10980", БухгалтерскийУчет.СписокСчетов("109.80"));
	Запрос.УстановитьПараметр("СчетаКроме", БухгалтерскийУчет.СписокСчетов("109.70,109.80,401.10"));
	Запрос.УстановитьПараметр("Счет401", БухгалтерскийУчет.СписокСчетов("401.10"));
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%Условие%",Условие);
	
	Для Каждого КлючИЗначение Из СтруктураПолейОтбора Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
	ТаблицаДанных.Свернуть("Организация,КФО,ИФО,КПС401,КЭК401,КПС109,КЭК109,Субконто1_109,Субконто2_109",
		"Сумма109,Сумма10970,Сумма10980,Сумма10970_ДляРасчета,Сумма10980_ДляРасчета,СуммаПрочие_ДляРасчета,СуммаНачОст_ДляРасчета,СуммаКонОст_ДляРасчета");
	
	Если СтруктураПолей.ИФО Тогда
		ТаблицаДанных.Индексы.Добавить("Организация,КФО,КПС109,КЭК109,Субконто1_109,Субконто2_109,ИФО");
	Иначе
		ТаблицаДанных.Индексы.Добавить("Организация,КФО,КПС109,КЭК109,Субконто1_109,Субконто2_109");	
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураПоиска = Новый Структура("Организация,КФО,КПС109,КЭК109,Субконто1_109,Субконто2_109"+?(СтруктураПолей.ИФО,",ИФО",""));
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,ВыборкаДетальныеЗаписи);
		МассивСтрок = ТаблицаДанных.НайтиСтроки(СтруктураПоиска);
		Если МассивСтрок.Количество()>0 Тогда
			Для Каждого ЭлМас Из МассивСтрок Цикл
				ЭлМас.Сумма10970_ДляРасчета = ЭлМас.Сумма10970_ДляРасчета + ВыборкаДетальныеЗаписи.Сумма10970_ДляРасчета;
				ЭлМас.Сумма10980_ДляРасчета = ЭлМас.Сумма10980_ДляРасчета + ВыборкаДетальныеЗаписи.Сумма10980_ДляРасчета;
				ЭлМас.СуммаПрочие_ДляРасчета = ЭлМас.СуммаПрочие_ДляРасчета + ВыборкаДетальныеЗаписи.СуммаПрочие_ДляРасчета;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[2].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураПоиска = Новый Структура("Организация,КФО,КПС109,КЭК109,Субконто1_109,Субконто2_109"+?(СтруктураПолей.ИФО,",ИФО",""));
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,ВыборкаДетальныеЗаписи);
		МассивСтрок = ТаблицаДанных.НайтиСтроки(СтруктураПоиска);
		Если МассивСтрок.Количество()>0 Тогда
			Для Каждого ЭлМас Из МассивСтрок Цикл
				ЭлМас.СуммаНачОст_ДляРасчета = ЭлМас.СуммаНачОст_ДляРасчета + ВыборкаДетальныеЗаписи.СуммаНачОст_ДляРасчета;
				ЭлМас.СуммаКонОст_ДляРасчета = ЭлМас.СуммаКонОст_ДляРасчета + ВыборкаДетальныеЗаписи.СуммаКонОст_ДляРасчета;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#Область ПолучитьВНД_ИсполнениеОбязательств

//для форм 175/775
Функция ПолучитьВНД_ИсполнениеОбязательств(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
		
	Если ТипЗнч(КонецПериода) = Тип("Дата") Тогда
		КонецПериода = Новый Граница(КонецПериода,ВидГраницы.Включая);
	КонецЕсли;	
	КонецПериодаДата = КонецДня(ЗаполнениеОтчетности.ПолучитьДатуИзПараметра(КонецПериода));
	
	ТипЧисло = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(18,2);
	ТипДата = БюджетнаяОтчетность.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата);
	ТипСтрока = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(0);
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Счет",Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДанных.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДанных.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДанных.Колонки.Добавить("КПС",Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДанных.Колонки.Добавить("ВидПоказателя",Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКБК"));
	ТаблицаДанных.Колонки.Добавить("КОСГУ",Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаДанных.Колонки.Добавить("Контрагент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДанных.Колонки.Добавить("Договор",Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	
	ТаблицаДанных.Колонки.Добавить("СуммаНеИсполнено",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("ДатаВозникновения",ТипДата);
	ТаблицаДанных.Колонки.Добавить("ДатаИсполнения",ТипДата);
	ТаблицаДанных.Колонки.Добавить("ПричинаКод",ТипСтрока);
	ТаблицаДанных.Колонки.Добавить("ПричинаНаименование",ТипСтрока);
	
	СтруктураПолейОтбора = Новый Структура;
	
	Условие = "";
	УсловиеБаланс = "";
	ЕстьИФО = Ложь;
	
	Если ТипЗнч(ИФО) = Тип("Структура") Тогда
		Если ИФО.Свойство("Использование") 
			И ИФО.Использование = Истина Тогда
			ЕстьИФО = Истина;
			
			Если ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеБаланс = " И ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеБаланс = " И ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеБаланс = " И ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеБаланс = " И НЕ ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеБаланс = " И ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеБаланс = " И ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ИФО <> Неопределено Тогда
		ЕстьИФО = Истина;
		Если ТипЗнч(ИФО) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
			УсловиеБаланс = " И ИФО = &ИФО";
			СтруктураПолейОтбора.Вставить("ИФО",ИФО);
		КонецЕсли;
	КонецЕсли;
	
	УсловиеОрганизация = "";
	
	Если ТипЗнч(Организация) = Тип("Структура") Тогда
		Если Организация.Свойство("Использование") 
			И Организация.Использование = Истина Тогда
			
			Если Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеОрганизация = " И Организация = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеОрганизация = " И Организация <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеОрганизация = " И Организация В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеОрганизация = " И НЕ Организация В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеОрганизация = " И Организация <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеОрганизация = " И Организация = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		УсловиеОрганизация = " И Организация = &Организация";
		СтруктураПолейОтбора.Вставить("Организация",Организация);
	КонецЕсли;	
	
	Условие = УсловиеБаланс + УсловиеОрганизация;
	Условие = Сред(Условие,3);		
		
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ИФО",ЕстьИФО);//Истина); - необходимо определять нужность ИФО в зависимости от параметров
	СтруктураПолей.Вставить("КПС",Истина);//нужен всегда
	СтруктураПолей.Вставить("ВидПоказателя",Истина);
	
	ПараметрСчетОбязательств = ПараметрыСхемы.Найти("СчетОбязательств_"+ИмяНабора);
	Если ПараметрСчетОбязательств <> Неопределено Тогда
		СчетОбязательств = БухгалтерскийУчет.СчетПоКоду(ПараметрСчетОбязательств.Значение,ЗаполнениеОтчетности.ПолучитьДатуИзПараметра(КонецПериода));
	Иначе	
		СчетОбязательств = БухгалтерскийУчет.СписокСчетов("502.11");
	КонецЕсли;
	
	СчетНКО = БухгалтерскийУчет.СписокСчетов("НКО.01");
	
	ПараметрИсполнениеПоБалансовым = ПараметрыСхемы.Найти("ИсполнениеПоБалансовым_"+ИмяНабора);
	Если ПараметрИсполнениеПоБалансовым <> Неопределено Тогда
		ИсполнениеПоБалансовым = ПараметрИсполнениеПоБалансовым.Значение;
	Иначе
		ИсполнениеПоБалансовым = Ложь;
	КонецЕсли;	
	
	ПараметрСчетаЗабаланс = ПараметрыСхемы.Найти("СчетаЗабаланс_"+ИмяНабора);
	Если ПараметрСчетаЗабаланс <> Неопределено Тогда
		СчетаЗабаланс = БухгалтерскийУчет.СписокСчетов(ПараметрСчетаЗабаланс.Значение);
	Иначе	
		СчетаЗабаланс = БухгалтерскийУчет.СписокСчетов("17.01,17.03,17.07,18.01,18.03,18.07");
	КонецЕсли;
	
	ДополнитьТаблицуПоПринятымОбязательствам(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, СчетОбязательств);
	ДополнитьТаблицуЗабалансДт(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериодаДата, СчетОбязательств, СчетаЗабаланс);
	ДополнитьТаблицуЗабалансКт(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериодаДата, СчетОбязательств, СчетаЗабаланс);
	ДополнитьТаблицуПоНекассовымОперациям(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, СчетОбязательств, СчетНКО);
	Если ИсполнениеПоБалансовым = Истина Тогда
		ДополнитьТаблицуПоИсполнениюДт(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериодаДата,СчетОбязательств);
		ДополнитьТаблицуПоИсполнениюКт(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериодаДата,СчетОбязательств);
	КонецЕсли;	
	
	ТаблицаДанных.Свернуть("Счет,Организация,КФО,ИФО,КПС,ВидПоказателя,КОСГУ,Контрагент,Договор,ДатаВозникновения,ДатаИсполнения,ПричинаКод,ПричинаНаименование","СуммаНеИсполнено");
	
	Если ТаблицаДанных.Количество()>0 Тогда
		
		//Заполнение вида показателя
		ТабКПС = ТаблицаДанных.Скопировать(,"КПС");
		ТабКПС.Свернуть("КПС");
		ЗначенияКПС = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ТабКПС.ВыгрузитьКолонку("КПС"),"ВидПоказателя");
		Для Каждого СтрТЧ Из ТаблицаДанных Цикл
			СтрТЧ.ВидПоказателя = ЗначенияКПС[СтрТЧ.КПС];
		КонецЦикла;
		
		//Заполнение дат договоров
		ТабДоговоров = ТаблицаДанных.Скопировать(,"Договор");
		ТабДоговоров.Свернуть("Договор");
		ДатыДоговоров = Новый Соответствие;
		Для Каждого СтрТЧ Из ТабДоговоров Цикл
			ДанныеДоговора = Новый Структура;
			ДанныеДоговора.Вставить("Возникновение", НачалоМесяца(ЗаполнениеОтчетности.ПолучитьРеквизитДоговора(СтрТЧ.Договор, "Возникновение", КонецПериодаДата)));
			ДанныеДоговора.Вставить("Окончание", НачалоМесяца(ЗаполнениеОтчетности.ПолучитьРеквизитДоговора(СтрТЧ.Договор, "Окончание", КонецПериодаДата)));
			
			ДатыДоговоров.Вставить(СтрТЧ.Договор, ДанныеДоговора); 
