					КодКонтураСтрокой = "1";//не секретно
				КонецЕсли;
				
				ТекКодКонтура = СоответствиеКодКонтура[КодКонтураСтрокой];
				Если ТекКодКонтура = Неопределено Тогда
					ТекКодКонтура = СоответствиеКодовЗначенийКодКонтура[КодКонтураСтрокой];
				    СоответствиеКодКонтура.Вставить(КодКонтураСтрокой,ТекКодКонтура);
				КонецЕсли;
				СтрТЧ.гр5г = ТекКодКонтура;
				
			КонецЕсли;
			ДлинаНомераДоПоступления = СтрДлина(СтрокаОС.УчетныйНомерОбъектаКапвложенийДоПоступления);
			Если ЗначениеЗаполнено(СтрокаОС.УчетныйНомерОбъектаКапвложенийДоПоступления)
				И (ДлинаНомераДоПоступления = 28
					ИЛИ ДлинаНомераДоПоступления = 30) Тогда
				ТекУчетныйНомер = СтрокаОС.УчетныйНомерОбъектаКапвложенийДоПоступления;
				Если СтрДлина(ТекУчетныйНомер) = 30 Тогда
					//первые 2 не нужны, это год открытия карточки
					ТекУчетныйНомер = Сред(ТекУчетныйНомер,3);
				КонецЕсли;
				СтрТЧ.гр6а = Лев(ТекУчетныйНомер,3);
				СтрТЧ.гр6б = Сред(ТекУчетныйНомер,4,20);
				СтрТЧ.гр6в = Сред(ТекУчетныйНомер,24,4);
				КодКонтураСтрокой = Сред(ТекУчетныйНомер,28,1);
				
				ТекКодКонтура = СоответствиеКодКонтура[КодКонтураСтрокой];
				Если ТекКодКонтура = Неопределено Тогда
					ТекКодКонтура = СоответствиеКодовЗначенийКодКонтура[КодКонтураСтрокой];
				    СоответствиеКодКонтура.Вставить(КодКонтураСтрокой,ТекКодКонтура);
				КонецЕсли;
				СтрТЧ.гр6г = ТекКодКонтура;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаОС.НаименованиеПолное) Тогда
				Если СтрокаАдреса <> Неопределено
					И ЗначениеЗаполнено(СтрокаАдреса.Представление) Тогда
					СтрТЧ.Наименование = СтрокаОС.НаименованиеПолное + ", " + СтрокаАдреса.Представление;
				Иначе
					СтрТЧ.Наименование = СтрокаОС.НаименованиеПолное;
				КонецЕсли;
			Иначе
				Если СтрокаАдреса <> Неопределено
					И ЗначениеЗаполнено(СтрокаАдреса.Представление) Тогда
					СтрТЧ.Наименование = СтрокаОС.Наименование + ", " + СтрокаАдреса.Представление;
				Иначе
					СтрТЧ.Наименование = СтрокаОС.Наименование;
				КонецЕсли;
			КонецЕсли;
			
			СтрТЧ.КодОбъекта = СтрокаОС.КодФАИП;
			СтрТЧ.КадастровыйНомер = СтрокаОС.КадастровыйНомер;
		КонецЕсли;
		
		Если СтрокаИнвентаризации<>Неопределено Тогда
			ПервыеДва = "";
			Если ЗначениеЗаполнено(СтрокаИнвентаризации.СтатусОбъектаКодДляОтчетности) Тогда
				ПервыеДва = СтрокаИнвентаризации.СтатусОбъектаКодДляОтчетности;
			ИначеЕсли ЗначениеЗаполнено(СтрокаИнвентаризации.СтатусОбъектаТекст) Тогда
				ПервыеДва = СокрЛП(Лев(СокрЛП(СтрокаИнвентаризации.СтатусОбъектаТекст),2));
				НужныеСимволы = "0123456789";
				ЛишниеСимволы = СтрСоединить(СтрРазделить(ПервыеДва,НужныеСимволы),"");
				ПервыеДва = СтрСоединить(СтрРазделить(ПервыеДва,ЛишниеСимволы),"");				
			КонецЕсли;
			
			СтрТЧ.СтатусНаКонецГода = СоответствиеКодовЗначенийДляГр8[ПервыеДва];
			
			ПервыеДва = "";
			Если ЗначениеЗаполнено(СтрокаИнвентаризации.ЦелеваяФункцияАктиваКодДляОтчетности) Тогда
				//число, приводим к строке
				ПервыеДва = Строка(СтрокаИнвентаризации.ЦелеваяФункцияАктиваКодДляОтчетности);
			ИначеЕсли ЗначениеЗаполнено(СтрокаИнвентаризации.ЦелеваяФункцияАктиваТекст) Тогда
				ПервыеДва = СокрЛП(Лев(СокрЛП(СтрокаИнвентаризации.ЦелеваяФункцияАктиваТекст),2));
				НужныеСимволы = "0123456789";
				ЛишниеСимволы = СтрСоединить(СтрРазделить(ПервыеДва,НужныеСимволы),"");
				ПервыеДва = СтрСоединить(СтрРазделить(ПервыеДва,ЛишниеСимволы),"");				
			КонецЕсли;
			
			СтрТЧ.ЦелеваяФункция = СоответствиеКодовЗначенийДляЦФ[ПервыеДва];
			
		КонецЕсли;
	КонецЦикла;	
	//
	ТаблицаДанных.Индексы.Добавить("гр5а,гр5б,гр5в,гр5г");
	
	
	
	СоответствиеСтатусов = Новый Соответствие;
		
	ПустойСтатус = Справочники.Субконто.ПустаяСсылка();
	//тут получаем данные отчетов
	Если ЗначениеЗаполнено(ОтчетПредПериод) Тогда
		Если ТипЗнч(ОтчетПредПериод) <> Тип("Массив") Тогда
			МассивОтчетов = Новый Массив;
			МассивОтчетов.Добавить(ОтчетПредПериод);
		Иначе
			МассивОтчетов = ОтчетПредПериод;	
		КонецЕсли;
		
		Для Каждого ТекОтчет Из МассивОтчетов Цикл
			ЭкземплярИсточник = ТекОтчет.ПолучитьОбъект();
			ЭкземплярИсточник.ИнициализироватьКонтекст();
			
			ГруппыРаскрытияИсходные = ЭкземплярИсточник.ПодготовитьКэшДанныхПоГруппамРаскрытия();
			
			СтрГруппаИсточника = ГруппыРаскрытияИсходные.Найти("ГР100","КодГруппыРаскрытия");
			Если СтрГруппаИсточника = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТаблицаИсходныхДанных = ЭкземплярИсточник.ПолучитьТаблицуРаскрытия(СтрГруппаИсточника);
						
			СтруктураПоиска = Новый Структура("гр5а,гр5б,гр5в,гр5г");
			Для Каждого СтрИсх Из ТаблицаИсходныхДанных Цикл
				СтруктураПоиска.гр5а = СокрЛП(СтрИсх.Аналитика2);
				СтруктураПоиска.гр5б = СокрЛП(СтрИсх.стр100_гр052);
				СтруктураПоиска.гр5в = СокрЛП(СтрИсх.стр100_гр053);
				СтруктураПоиска.гр5г = СтрИсх.Аналитика3;
				
				НайденныеСтроки = ТаблицаДанных.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтроки.Количество() Тогда
					ТекСтрока = НайденныеСтроки[0];
				Иначе
					Продолжить;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрИсх.Аналитика7) Тогда
					ТекСтатус = Справочники.Субконто.ПустаяСсылка();
				Иначе
					ТекСтатус = СоответствиеСтатусов[СтрИсх.Аналитика7];
					Если ТекСтатус = Неопределено Тогда
						ТекКодСтатуса = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрИсх.Аналитика7,"Код"));
						ТекСтатус = СоответствиеКодовЗначенийДляГр7[ТекКодСтатуса];
						СоответствиеСтатусов.Вставить(СтрИсх.Аналитика7,ТекСтатус);
					КонецЕсли;
				КонецЕсли;
				
				ТекСтрока.СтатусНаНачалоГода = ТекСтатус;
				
				Если НЕ ЗначениеЗаполнено(ТекСтрока.ЦелеваяФункция) Тогда
					//если не заполнили ранее
					ТекСтрока.ЦелеваяФункция = СтрИсх.Аналитика8;
				КонецЕсли;
				ТекСтрока.ПриостановлениеГод = СтрИсх.стр100_гр10;
				ТекСтрока.ПриостановлениеПричина = СтрИсх.Аналитика9;
				ТекСтрока.ПриостановлениеПояснение = СтрИсх.стр100_гр12;
				ТекСтрока.НачалоРеализации = СтрИсх.стр100_гр13;
						
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;	
	
	ТаблицаДанных.Сортировать("Наименование");
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПолучитьСоответствиеЗначенийКлассификатора(КодВладельцаКлассификатора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Субконто.Ссылка КАК Ссылка,
		|	СокрЛП(Субконто.Код) КАК Код
		|ИЗ
		|	Справочник.Субконто КАК Субконто
		|ГДЕ
		|	Субконто.Владелец.Код = &Код";
	
	Запрос.УстановитьПараметр("Код", КодВладельцаКлассификатора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СоответствиеЗначенийКлассификатора = Новый Соответствие;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СоответствиеЗначенийКлассификатора.Вставить(ВыборкаДетальныеЗаписи.Код,ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
	Возврат СоответствиеЗначенийКлассификатора;
	
КонецФункции

Процедура ДополнитьТаблицуПо106(ТаблицаДанных, МассивСчетов106, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО, ИсключатьВнутрОборот)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
		|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
		|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстаток) КАК НачальныйОстаток
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&НачалоПериода, Счет В (&МассивСчетов106), , &Условие) КАК ЖурналПроводокЕПСБУОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЖурналПроводокЕПСБУОстатки.Организация,
		|	ЖурналПроводокЕПСБУОстатки.Счет,
		|	ЖурналПроводокЕПСБУОстатки.КФО,
		|	ЖурналПроводокЕПСБУОстатки.Субконто1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналПроводокЕПСБУОбороты.Счет КАК Счет,
		|	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК ОсновноеСредство,
		|	ЖурналПроводокЕПСБУОбороты.Организация КАК Организация,
		|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,
		|	СУММА(ВЫБОР
		|			КОГДА НЕ ЖурналПроводокЕПСБУОбороты.КорСчет В (&СчетаИО)
		|				ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотДт
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Увеличение,
		|	СУММА(ВЫБОР
		|			КОГДА НЕ ЖурналПроводокЕПСБУОбороты.КорСчет В (&СчетаИО)
		|				ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотКт
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Уменьшение,
		|	СУММА(ВЫБОР
		|			КОГДА ЖурналПроводокЕПСБУОбороты.КорСчет В (&СчетаИО)
		|				ТОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК НачальныйОстаток
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, Авто, Счет В (&МассивСчетов106), , &Условие, , ) КАК ЖурналПроводокЕПСБУОбороты
		|
		|ГДЕ
		|	&ГДЕУсловие
		|
		|СГРУППИРОВАТЬ ПО
		|	ЖурналПроводокЕПСБУОбороты.Счет,
		|	ЖурналПроводокЕПСБУОбороты.Субконто1,
		|	ЖурналПроводокЕПСБУОбороты.Организация,
		|	ЖурналПроводокЕПСБУОбороты.КФО";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("МассивСчетов106", МассивСчетов106);
	Запрос.УстановитьПараметр("СчетаИО", МассивСчетовИО);
	
	ГДЕУсловие = "ИСТИНА";
	Если ИсключатьВнутрОборот = Истина Тогда
		ГДЕУсловие = "НЕ (ЖурналПроводокЕПСБУОбороты.Счет = ЖурналПроводокЕПСБУОбороты.КорСчет
			|		И ЖурналПроводокЕПСБУОбороты.Субконто1 = ЖурналПроводокЕПСБУОбороты.КорСубконто1)";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ГДЕУсловие",ГДЕУсловие);
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие",Условие);
	
	Для Каждого КлючИЗначение Из СтруктураПолейОтбора Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
	ТаблицаДанных.Свернуть("Организация,ОсновноеСредство","НачальныйОстаток,Увеличение,Уменьшение");
	
КонецПроцедуры

// для формы 192 - дополнительный набор для графы 12
//в графе 12 - дата возникновения дебиторской задолженности, отраженной в графе 10 (дата списания средств с лицевого счета, со счета в кредитной организации);

Функция ПолучитьВНД_ВозникновениеДтЗадолженности(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
	Перем ДополнительныйПериод1, ДополнительныйПериод2;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("ДополнительныйПериод1", ДополнительныйПериод1);
	СтруктураПараметров.Свойство("ДополнительныйПериод2", ДополнительныйПериод2);
	
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
		
	Если ТипЗнч(КонецПериода) = Тип("Дата") Тогда
		КонецПериода = Новый Граница(КонецПериода,ВидГраницы.Включая);
	КонецЕсли;	
	КонецПериодаДата = КонецДня(ЗаполнениеОтчетности.ПолучитьДатуИзПараметра(КонецПериода));
	
	ТипЧисло = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(18,2);
	ТипДата = БюджетнаяОтчетность.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата);
	ТипСтрока = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(0);
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Счет",Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДанных.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	//ТаблицаДанных.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДанных.Колонки.Добавить("КПС",Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДанных.Колонки.Добавить("ВидПоказателя",Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКБК"));
	ТаблицаДанных.Колонки.Добавить("Контрагент",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДанных.Колонки.Добавить("Договор",Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	
	ТаблицаДанных.Колонки.Добавить("ДатаВозникновения",ТипДата);
	
	СтруктураПолейОтбора = Новый Структура;
	
	Условие = "";
	УсловиеБаланс = "";
	ЕстьИФО = Ложь;
	
	Если ТипЗнч(ИФО) = Тип("Структура") Тогда
		Если ИФО.Свойство("Использование") 
			И ИФО.Использование = Истина Тогда
			ЕстьИФО = Истина;
			
			Если ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеБаланс = " И ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеБаланс = " И ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеБаланс = " И ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеБаланс = " И НЕ ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеБаланс = " И ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеБаланс = " И ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ИФО <> Неопределено Тогда
		ЕстьИФО = Истина;
		Если ТипЗнч(ИФО) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
			УсловиеБаланс = " И ИФО = &ИФО";
			СтруктураПолейОтбора.Вставить("ИФО",ИФО);
		КонецЕсли;
	КонецЕсли;
	
	УсловиеОрганизация = "";
	
	Если ТипЗнч(Организация) = Тип("Структура") Тогда
		Если Организация.Свойство("Использование") 
			И Организация.Использование = Истина Тогда
			
			Если Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеОрганизация = " И Организация = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеОрганизация = " И Организация <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеОрганизация = " И Организация В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеОрганизация = " И НЕ Организация В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеОрганизация = " И Организация <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеОрганизация = " И Организация = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		УсловиеОрганизация = " И Организация = &Организация";
		СтруктураПолейОтбора.Вставить("Организация",Организация);
	КонецЕсли;	
	
	Условие = УсловиеБаланс + УсловиеОрганизация;
	Условие = Сред(Условие,3);		
		
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ИФО",ЕстьИФО);//Истина); - необходимо определять нужность ИФО в зависимости от параметров
	СтруктураПолей.Вставить("КПС",Истина);//нужен всегда
	СтруктураПолей.Вставить("ВидПоказателя",Истина);
		
	ПараметрСчетаДт = ПараметрыСхемы.Найти("СчетаДт_"+ИмяНабора);
	Если ПараметрСчетаДт <> Неопределено Тогда
		СчетаДТ = БухгалтерскийУчет.СписокСчетов(ПараметрСчетаДт.Значение);
	Иначе	
		СчетаДТ = БухгалтерскийУчет.СписокСчетов("206.20,206.30");
	КонецЕсли;
	
	ПараметрСчетаКт = ПараметрыСхемы.Найти("СчетаКт_"+ИмяНабора);
	Если ПараметрСчетаКт <> Неопределено Тогда
		СчетаКТ = БухгалтерскийУчет.СписокСчетов(ПараметрСчетаКт.Значение);
	Иначе	
		СчетаКТ = БухгалтерскийУчет.СписокСчетов("201.00,304.05");
	КонецЕсли;
	
	ПараметрДатаНачала = ПараметрыСхемы.Найти("ПериодОтчета_"+ИмяНабора);
	Если ПараметрДатаНачала <> Неопределено Тогда
			
		Если ПараметрДатаНачала.Выражение = "&ДополнительныйПериод1" Тогда
			НачалоПериода = ДополнительныйПериод1;
		ИначеЕсли ПараметрДатаНачала.Выражение = "&ДополнительныйПериод2" Тогда
			НачалоПериода = ДополнительныйПериод2;
		ИначеЕсли ПараметрДатаНачала.Выражение = "&НачалоПериода" Тогда
			НачалоПериода = НачалоПериода;
		ИначеЕсли ПараметрДатаНачала.Выражение = "&КонецПериода" Тогда 
			НачалоПериода = КонецПериода;	
		КонецЕсли;
		
	КонецЕсли;
	
	ДополнитьТаблицуПоОборотамРБ_ВозникновениеЗадолженности(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, СчетаДт, СчетаКт);
			
	Если ТаблицаДанных.Количество()>0 Тогда
		
		//Заполнение вида показателя
		ТабКПС = ТаблицаДанных.Скопировать(,"КПС");
		ТабКПС.Свернуть("КПС");
		ЗначенияКПС = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ТабКПС.ВыгрузитьКолонку("КПС"),"ВидПоказателя");
		Для Каждого СтрТЧ Из ТаблицаДанных Цикл
			СтрТЧ.ВидПоказателя = ЗначенияКПС[СтрТЧ.КПС];
		КонецЦикла;
				
	КонецЕсли;
	
	Возврат ТаблицаДанных;
	
КонецФункции

Процедура ДополнитьТаблицуПоОборотамРБ_ВозникновениеЗадолженности(ТаблицаДанных, СтруктураПолей, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, СчетаДт, СчетаКт)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналПроводокЕПСБУОборотыДтКт.СчетДт КАК Счет,
		|	ЖурналПроводокЕПСБУОборотыДтКт.Организация КАК Организация,
		|	ЖурналПроводокЕПСБУОборотыДтКт.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОборотыДтКт.КПСДт КАК КПС,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт1 ССЫЛКА Справочник.Контрагенты
		|			ТОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт1
		|		КОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт2 ССЫЛКА Справочник.Контрагенты
		|			ТОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт2
		|		КОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт3 ССЫЛКА Справочник.Контрагенты
		|			ТОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт3
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт1 ССЫЛКА Справочник.Договоры
		|			ТОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт1
		|		КОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт2 ССЫЛКА Справочник.Договоры
		|			ТОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт2
		|		КОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт3 ССЫЛКА Справочник.Договоры
		|			ТОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт3
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		|	КОНЕЦ КАК Договор,
		|	МАКСИМУМ(ЖурналПроводокЕПСБУОборотыДтКт.ПериодДень) КАК ДатаВозникновения
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(&НачалоПериода, &КонецПериода, Авто, СчетДт В (&СчетаДт), , СчетКт В (&СчетаКт), , &Условие) КАК ЖурналПроводокЕПСБУОборотыДтКт
		|
		|СГРУППИРОВАТЬ ПО
		|	ЖурналПроводокЕПСБУОборотыДтКт.КПСДт,
		|	ЖурналПроводокЕПСБУОборотыДтКт.СчетДт,
		|	ЖурналПроводокЕПСБУОборотыДтКт.Организация,
		|	ЖурналПроводокЕПСБУОборотыДтКт.КФО,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт1 ССЫЛКА Справочник.Договоры
		|			ТОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт1
		|		КОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт2 ССЫЛКА Справочник.Договоры
		|			ТОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт2
		|		КОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт3 ССЫЛКА Справочник.Договоры
		|			ТОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт3
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт1 ССЫЛКА Справочник.Контрагенты
		|			ТОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт1
		|		КОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт2 ССЫЛКА Справочник.Контрагенты
		|			ТОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт2
		|		КОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт3 ССЫЛКА Справочник.Контрагенты
		|			ТОГДА ЖурналПроводокЕПСБУОборотыДтКт.СубконтоДт3
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Запрос.УстановитьПараметр("СчетаДт", СчетаДт);
	
	Запрос.УстановитьПараметр("СчетаКт", СчетаКт);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие",Условие);
	
	Для Каждого КлючИЗначение Из СтруктураПолейОтбора Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;
		
КонецПроцедуры


#Область ЗаполнениеТаблицыРазвернутыхНаборов

Процедура ДополнитьТаблицуПоДаннымОстатковИОборотов(ТаблицаДанных, СтруктураПолей, МассивСчетов, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Счет КАК Счет,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Организация КАК Организация,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.КФО КАК КФО,	"+?(СтруктураПолей.Субконто1,"
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто1 КАК Субконто1,","")+?(СтруктураПолей.Субконто2,"
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто2 КАК Субконто2,","")+?(СтруктураПолей.Субконто3,"
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто3 КАК Субконто3,","")+?(СтруктураПолей.КПС,"
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.КПС КАК КПС,","")+?(СтруктураПолей.ВидКПС,"
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.КПС.ВидПоказателя КАК ВидПоказателя,","")+?(СтруктураПолей.ИФО,"
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.ИФО КАК ИФО,","")+?(СтруктураПолей.КЭК,"
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.КЭК КАК КЭК,","")+"
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокДт КАК НачальныйОстатокДт,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокКт КАК НачальныйОстатокКт,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокДт КАК КонечныйОстатокДт,
