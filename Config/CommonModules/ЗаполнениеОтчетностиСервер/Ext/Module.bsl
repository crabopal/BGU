		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ,
		|	Обороты.КПС,"+?(СтруктураПолей.ИФО,"
		|	Обороты.ИФО,","")+"
		|	Обороты.КЭК,
		|	Обороты.Организация";
	
	Запрос.УстановитьПараметр("ТаблицаРС",КартаРС);
	МассивВсехСчетов = КартаРС.ВыгрузитьКолонку("Счет");
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("МассивСчетов", МассивВсехСчетов);
	Запрос.УстановитьПараметр("МассивИсключаемыхКорСчетов", МассивИсключаемыхКорСчетов);
	Запрос.УстановитьПараметр("МассивДенежныхСчетов", МассивДенежныхСчетов);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%Условие%",Условие);
	
	Для Каждого КлючИЗначение Из СтруктураПолейОтбора Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДанных.Добавить(),ВыборкаДетальныеЗаписи);
	КонецЦикла;
		
КонецПроцедуры

Процедура ДополнитьТаблицуПоРазворотуСубконтоИОборотам(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовОшибок, МассивИсключаемыхКорСчетов, МассивДенежныхСчетов)
	
	МассивСтрок = КартаРС.НайтиСтроки(СтруктураОтбора);
			
	МассивСчетов = Новый Массив;
	Если МассивСтрок.Количество() >0 Тогда
		Для Каждого ТекСтр Из МассивСтрок Цикл
			МассивСчетов.Добавить(ТекСтр.Счет);
		КонецЦикла;
		
		Для Каждого КлючИЗначение Из СтруктураОтбора Цикл
			СтруктураПолей.Вставить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
		КонецЦикла;
	
		ДополнитьТаблицуПоДаннымОстатковИОборотов(ТаблицаДанных, СтруктураПолей, МассивСчетов, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода);
		ДополнитьТаблицуПоДаннымИсправленияОшибок(ТаблицаДанных, СтруктураПолей, МассивСчетов, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовОшибок);
		ДополнитьТаблицуПоДаннымОборотовДенежныхИНеденежных(ТаблицаДанных, СтруктураПолей, МассивСчетов, МассивИсключаемыхКорСчетов, МассивДенежныхСчетов, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода);
	КонецЕсли;
	
КонецПроцедуры

//для 169/769 с 2022 года - не используется, т.к. в инструкцию изменения НЕ внесли
Функция ПолучитьВНД_РазвернутыеОстаткиИОборотыКЭКСегм(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,ПараметрыСхемы) Экспорт
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
		
	СтруктураПараметров.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.Свойство("Организация", Организация);
	СтруктураПараметров.Свойство("ИФО", ИФО);
	СтруктураПараметров.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	
	Если ТипЗнч(КонецПериода) = Тип("Дата") Тогда
		КонецПериода = Новый Граница(КонецПериода,ВидГраницы.Включая);
	КонецЕсли;
		
	ТаблицаМетодовДополнительнойОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(ПравилоЗаполнения,,,Истина);
	КартыДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	ОбработкаЗаполнения = Обработки.ОбработкаДанныхОтчетности.Создать();
	
	Если НЕ ОбработкаЗаполнения.ПрименитьМетодыДополнительнойОбработки(КартыДанных, "КартыДанных", ТаблицаМетодовДополнительнойОбработки, ПравилоЗаполнения, Неопределено, "") Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;	
	
	ИмяКарты = "";
	ПараметрыМетода = Неопределено;
	Для каждого СтрокаТаблицы Из ТаблицаМетодовДополнительнойОбработки Цикл
		
		Если СтрокаТаблицы.МетодОбработки <> "РазвернутоеСальдо" Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыМетода = СтрокаТаблицы.Параметры.Получить();//Структура
		ИмяКарты = ПараметрыМетода.КартаДанных;
		Прервать;
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ИмяКарты) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	//В КартаРС необходимо переименовать колонки, которые используются как параметры в методе дополнения - Счет,Субконто1,Субконто2,Субконто3,
	//если их имя не совпадает с именем параметра
	
	//Если одноименные колонки уже есть, сначала удалим их, а потом переименуем нужные.
	КартаРС = КартыДанных[ИмяКарты];
	Если ПараметрыМетода.Счет <> "Счет" Тогда
		Если КартаРС.Колонки.Найти("Счет") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Счет");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Счет);
		ТекКолонка.Имя = "Счет";
	КонецЕсли;
	
	Если ПараметрыМетода.Субконто1 <> "Субконто1" Тогда
		Если КартаРС.Колонки.Найти("Субконто1") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Субконто1");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Субконто1);
		ТекКолонка.Имя = "Субконто1";
	КонецЕсли;
	
	Если ПараметрыМетода.Субконто2 <> "Субконто2" Тогда
		Если КартаРС.Колонки.Найти("Субконто2") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Субконто2");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Субконто2);
		ТекКолонка.Имя = "Субконто2";
	КонецЕсли;
	
	Если ПараметрыМетода.Субконто3 <> "Субконто3" Тогда
		Если КартаРС.Колонки.Найти("Субконто3") <> Неопределено Тогда
			КартаРС.Колонки.Удалить("Субконто3");
		КонецЕсли;
		ТекКолонка = КартаРС.Колонки.Найти(ПараметрыМетода.Субконто3);
		ТекКолонка.Имя = "Субконто3";
	КонецЕсли;
	
	ПараметрыИзДокумента = Ложь;
	Значение = Неопределено;
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") 
		И СтруктураПараметров.Свойство("ПараметрыИзДокумента",Значение)
			И ТипЗнч(Значение) = Тип("Булево") Тогда
		ПараметрыИзДокумента = Значение;
	КонецЕсли;
	
	СоответствиеСчетаБезКЭК = Новый Соответствие;
	
	УчитыватьКартуКЭК000 = Истина;//общая настройка правила заполнения на использование карты данных СчетаБезКЭК
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("УчитыватьКартуКЭК000") Тогда
		
		Если ТипЗнч(ДополнительныеПараметры.УчитыватьКартуКЭК000) = Тип("Структура") Тогда
			
			Если ДополнительныеПараметры.УчитыватьКартуКЭК000.Свойство("ПравоеЗначение")
				И ДополнительныеПараметры.УчитыватьКартуКЭК000.ПравоеЗначение = Ложь Тогда
				
				УчитыватьКартуКЭК000 = Ложь;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДополнительныеПараметры.УчитыватьКартуКЭК000) = Тип("Булево") Тогда
			
			УчитыватьКартуКЭК000 = ДополнительныеПараметры.УчитыватьКартуКЭК000;
			
		КонецЕсли;
		
	КонецЕсли;
	
	КартаСчетовБезКЭК = Неопределено;
	Если УчитыватьКартуКЭК000 = Истина
		И КартыДанных.Свойство("СчетаБезКЭК",КартаСчетовБезКЭК) Тогда
		Если КартаСчетовБезКЭК.Колонки.Найти("Счет") <> Неопределено
			И КартаСчетовБезКЭК.Колонки.Найти("Использовать")<> Неопределено Тогда
			
			Для Каждого СтрКарты Из КартаСчетовБезКЭК.НайтиСтроки(Новый Структура("Использовать",Истина)) Цикл
				СоответствиеСчетаБезКЭК.Вставить(СтрКарты.Счет,Истина);	
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	ТипЧисло = БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(18,2);
	ТипДата = БюджетнаяОтчетность.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата);
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Счет",Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДанных.Колонки.Добавить("Субконто1");
	ТаблицаДанных.Колонки.Добавить("Субконто2");
	ТаблицаДанных.Колонки.Добавить("Субконто3");
	ТаблицаДанных.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДанных.Колонки.Добавить("КПС",Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДанных.Колонки.Добавить("ВидПоказателя",Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКБК"));
	ТаблицаДанных.Колонки.Добавить("ИФО",Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДанных.Колонки.Добавить("КФО",Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДанных.Колонки.Добавить("КЭК",Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
		
	//Для 169/769 нужны:
	//- суммы развернутого начального и конечного остатка дт и кт:
	ТаблицаДанных.Колонки.Добавить("НачальныйОстатокДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("НачальныйОстатокКт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("КонечныйОстатокДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("КонечныйОстатокКт",ТипЧисло);
	//- суммы оборотов со счетами расчетов по сегментам по дт и кт:
	ТаблицаДанных.Колонки.Добавить("СегмДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("СегмКт",ТипЧисло);
	//- суммы оборотов с остальными счетамм по дт и кт:
	ТаблицаДанных.Колонки.Добавить("ПрочДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("ПрочКт",ТипЧисло);
	//- сумма оборотов исправления ошибок прошлых лет:
	ТаблицаДанных.Колонки.Добавить("СуммаИООборот",ТипЧисло);
			
	СтруктураПолейОтбора = Новый Структура;
	
	Условие = "";
	УсловиеБаланс = "";
	ЕстьИФО = Ложь;
	
	Если ТипЗнч(ИФО) = Тип("Структура") Тогда
		Если ИФО.Свойство("Использование") 
			И ИФО.Использование = Истина Тогда
			ЕстьИФО = Истина;
			
			Если ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеБаланс = " И ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеБаланс = " И ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеБаланс = " И ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеБаланс = " И НЕ ИФО В (&ИФО)";
				СтруктураПолейОтбора.Вставить("ИФО",ИФО.ПравоеЗначение);
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеБаланс = " И ИФО <> &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			ИначеЕсли ИФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеБаланс = " И ИФО = &ИФО";
				СтруктураПолейОтбора.Вставить("ИФО",Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ИФО <> Неопределено Тогда
		ЕстьИФО = Истина;
		Если ТипЗнч(ИФО) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
			УсловиеБаланс = " И ИФО = &ИФО";
			СтруктураПолейОтбора.Вставить("ИФО",ИФО);
		КонецЕсли;
	КонецЕсли;
	
	УсловиеОрганизация = "";
	
	Если ТипЗнч(Организация) = Тип("Структура") Тогда
		Если Организация.Свойство("Использование") 
			И Организация.Использование = Истина Тогда
			
			Если Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
				УсловиеОрганизация = " И Организация = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
				УсловиеОрганизация = " И Организация <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
				УсловиеОрганизация = " И Организация В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				УсловиеОрганизация = " И НЕ Организация В (&Организация)";
				СтруктураПолейОтбора.Вставить("Организация",Организация.ПравоеЗначение);
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
				УсловиеОрганизация = " И Организация <> &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			ИначеЕсли Организация.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				УсловиеОрганизация = " И Организация = &Организация";
				СтруктураПолейОтбора.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
			КонецЕсли;
						
		КонецЕсли;
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		УсловиеОрганизация = " И Организация = &Организация";
		СтруктураПолейОтбора.Вставить("Организация",Организация);
	КонецЕсли;
	
	УсловиеКФО = "";
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("КФО") Тогда
		
		Если ТипЗнч(ДополнительныеПараметры.КФО) = Тип("Структура") Тогда
		
			мКФО = ДополнительныеПараметры.КФО;
			Если мКФО.Свойство("Использование") 
				И мКФО.Использование = Истина Тогда
				
				Если мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
					ИЛИ мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
					УсловиеКФО = " И КФО = &КФО";
					СтруктураПолейОтбора.Вставить("КФО",мКФО.ПравоеЗначение);
				ИначеЕсли мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
					ИЛИ мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
					УсловиеКФО = " И КФО <> &КФО";
					СтруктураПолейОтбора.Вставить("КФО",мКФО.ПравоеЗначение);
				ИначеЕсли мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
					ИЛИ мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
					УсловиеКФО = " И КФО В (&КФО)";
					СтруктураПолейОтбора.Вставить("КФО",мКФО.ПравоеЗначение);
				ИначеЕсли мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
					ИЛИ мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
					УсловиеКФО = " И НЕ КФО В (&КФО)";
					СтруктураПолейОтбора.Вставить("КФО",мКФО.ПравоеЗначение);
				ИначеЕсли мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
					УсловиеКФО = " И КФО <> &КФО";
					СтруктураПолейОтбора.Вставить("КФО",Перечисления.КВД.ПустаяСсылка());
				ИначеЕсли мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
					УсловиеКФО = " И КФО = &КФО";
					СтруктураПолейОтбора.Вставить("КФО",Перечисления.КВД.ПустаяСсылка());
				КонецЕсли;
							
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДополнительныеПараметры.КФО) = Тип("ПеречислениеСсылка.КВД") Тогда
			УсловиеКФО = " И КФО = &КФО";
			СтруктураПолейОтбора.Вставить("КФО",ДополнительныеПараметры.КФО);
		КонецЕсли;
	КонецЕсли;
	
	
	Условие = УсловиеБаланс + УсловиеОрганизация + УсловиеКФО;
	Условие = Сред(Условие,3);		
		
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ИФО",ЕстьИФО);// - необходимо определять нужность ИФО в зависимости от параметров
	СтруктураПолей.Вставить("КПС",Истина);//нужен всегда
	СтруктураПолей.Вставить("ВидКПС",Ложь);//заполняется отдельно, так быстрее
	СтруктураПолей.Вставить("Субконто1",Истина);//-меняется динамически
	СтруктураПолей.Вставить("Субконто2",Истина);//-меняется динамически
	СтруктураПолей.Вставить("Субконто3",Истина);//-меняется динамически
	СтруктураПолей.Вставить("КЭК",Истина);// - нужен всегда с 2021 года
	
	//Счета исправления ошибок
			
	ПараметрСчетаРасчетовССегментами = ПараметрыСхемы.Найти("СчетаРасчетовССегментами_"+ИмяНабора);
	Если ПараметрСчетаРасчетовССегментами <> Неопределено Тогда
		МассивСчетовСегменты = БухгалтерскийУчет.СписокСчетов(ПараметрСчетаРасчетовССегментами.Значение);
	Иначе	
		МассивСчетовСегменты = БухгалтерскийУчет.СписокСчетов("109.00, 401.10, 401.20, 401.40, 401.41, 401.49");
	КонецЕсли;
	
	ПараметрСчетаИО = ПараметрыСхемы.Найти("СчетаИсправленияОшибок_"+ИмяНабора);
	Если ПараметрСчетаИО <> Неопределено Тогда
		МассивСчетовИО = БухгалтерскийУчет.СписокСчетов(ПараметрСчетаИО.Значение);
	Иначе	
		МассивСчетовИО = БухгалтерскийУчет.СписокСчетов("304.66, 304.76, 304.86, 304.96, 
														|401.16, 401.17, 401.18, 401.19, 
														|401.26, 401.27, 401.28, 401.29");
	КонецЕсли;
	
	ПараметрСчетаИсключаемые = ПараметрыСхемы.Найти("СчетаИсключаемые_"+ИмяНабора);
	Если ПараметрСчетаИсключаемые <> Неопределено Тогда
		МассивИсключаемыхКорСчетов = БухгалтерскийУчет.СписокСчетов(ПараметрСчетаИсключаемые.Значение);
	Иначе	
		МассивИсключаемыхКорСчетов = БухгалтерскийУчет.СписокСчетов("304.66, 304.76, 304.86, 304.96, 
																	|401.16, 401.17, 401.18, 401.19, 
																	|401.26, 401.27, 401.28, 401.29, 
																	|401.30, 000");
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Ложь,Ложь,Ложь);//0
	ДополнитьТаблицуПоРазворотуСубконтоИОборотамСегменты(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО, МассивИсключаемыхКорСчетов, МассивСчетовСегменты);	

	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Истина,Ложь,Ложь);//1
	ДополнитьТаблицуПоРазворотуСубконтоИОборотамСегменты(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО, МассивИсключаемыхКорСчетов, МассивСчетовСегменты);	
	
	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Ложь,Истина,Ложь);//2
	ДополнитьТаблицуПоРазворотуСубконтоИОборотамСегменты(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО, МассивИсключаемыхКорСчетов, МассивСчетовСегменты);	

	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Ложь,Ложь,Истина);//3
	ДополнитьТаблицуПоРазворотуСубконтоИОборотамСегменты(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО, МассивИсключаемыхКорСчетов, МассивСчетовСегменты);	
	
	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Истина,Истина,Ложь);//1,2
	ДополнитьТаблицуПоРазворотуСубконтоИОборотамСегменты(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО, МассивИсключаемыхКорСчетов, МассивСчетовСегменты);	
	
	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Истина,Ложь,Истина);//1,3
	ДополнитьТаблицуПоРазворотуСубконтоИОборотамСегменты(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО, МассивИсключаемыхКорСчетов, МассивСчетовСегменты);	
	
	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Ложь,Истина,Истина);//2,3
	ДополнитьТаблицуПоРазворотуСубконтоИОборотамСегменты(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО, МассивИсключаемыхКорСчетов, МассивСчетовСегменты);	
	
	СтруктураОтбора = Новый Структура("Субконто1,Субконто2,Субконто3",Истина,Истина,Истина);//1,2,3
	ДополнитьТаблицуПоРазворотуСубконтоИОборотамСегменты(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовИО, МассивИсключаемыхКорСчетов, МассивСчетовСегменты);	
	
	ТаблицаДанных.Свернуть("Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ВидПоказателя,ИФО,КФО,КЭК",
						"НачальныйОстатокДт,НачальныйОстатокКт,КонечныйОстатокДт,КонечныйОстатокКт,СуммаИООборот,СегмДт,СегмКт,ПрочДт,ПрочКт");
	
	//КЭК оборотов не используются, все КЭК должны быть преобразованы в 000-009
	
	ЗаполнитьДетальныйКЭКВТаблицеДанных(ТаблицаДанных,СоответствиеСчетаБезКЭК);
	
	ТаблицаДанных.Свернуть("Счет,Субконто1,Субконто2,Субконто3,Организация,КПС,ВидПоказателя,ИФО,КФО,КЭК",
						"НачальныйОстатокДт,НачальныйОстатокКт,КонечныйОстатокДт,КонечныйОстатокКт,СуммаИООборот,СегмДт,СегмКт,ПрочДт,ПрочКт");
	
	//Т.к. в начале года остатки на 000-009, в середине года обороты по 56х/66х и 73х/83х, то после замены кэк нужно исправить конечные остатки
	//иначе получится, что если до замены было: 
	//по 001 остаток на начало по дт 100,
	//по 561/661 оборот в кт 150
	//и на конец года будет по 001 остаток по дт 100, а по 561/661 остаток по кт 150.
	//А должно быть по 001 остаток на конец по кт 50, и все.
	
	Для Каждого СтрТЧ Из ТаблицаДанных Цикл
		//т.к. форма может заполняться не с начала года, то остатки на начало отчетного периода могут быть на разных КЭК - 561/661,
		//необходимо их объединить
		Если СтрТЧ.НачальныйОстатокДт <> 0
			ИЛИ СтрТЧ.НачальныйОстатокКт <> 0 Тогда
			
			Если СтрТЧ.НачальныйОстатокДт >= СтрТЧ.НачальныйОстатокКт Тогда
				СтрТЧ.НачальныйОстатокДт = СтрТЧ.НачальныйОстатокДт - СтрТЧ.НачальныйОстатокКт;
				СтрТЧ.НачальныйОстатокКт = 0;
			Иначе
				СтрТЧ.НачальныйОстатокКт = СтрТЧ.НачальныйОстатокКт - СтрТЧ.НачальныйОстатокДт;
				СтрТЧ.НачальныйОстатокДт = 0;
			КонецЕсли;
			
		КонецЕсли;
	
		
		Если СтрТЧ.КонечныйОстатокДт <> 0
			ИЛИ СтрТЧ.КонечныйОстатокКт <> 0 Тогда
				
			Если СтрТЧ.КонечныйОстатокДт >= СтрТЧ.КонечныйОстатокКт Тогда
				СтрТЧ.КонечныйОстатокДт = СтрТЧ.КонечныйОстатокДт - СтрТЧ.КонечныйОстатокКт;
				СтрТЧ.КонечныйОстатокКт = 0;
			Иначе
				СтрТЧ.КонечныйОстатокКт = СтрТЧ.КонечныйОстатокКт - СтрТЧ.КонечныйОстатокДт;
				СтрТЧ.КонечныйОстатокДт = 0;
			КонецЕсли;
		
		КонецЕсли;
	КонецЦикла;	
	
	//Далее необходимо распределить СуммаИООборот отдельно на исправление дебиторской задолженности и отдельно на исправление кредиторской задолженности,
	//И только после этого свернуть таблицу по субконто, чтобы получить обобщенные остатки
	
	ТаблицаДанных.Колонки.Добавить("СуммаИОДт",ТипЧисло);
	ТаблицаДанных.Колонки.Добавить("СуммаИОКт",ТипЧисло);
	
	//Если вид счета Пассивный - то положительной суммой правим Кт сумму,
			
	Для Каждого СтрТЧ Из ТаблицаДанных Цикл
		Если СтрТЧ.СуммаИООборот=0 Тогда
			Продолжить;
		КонецЕсли;
		//Если сумма исправления >0 и есть КТ задолженность, нужно сначала уменьшить остаток по Кт,
		//а на оставшуюся сумму увеличить дт
		Если СтрТЧ.СуммаИООборот>0
			И СтрТЧ.НачальныйОстатокКт>0 Тогда
			
			СтрТЧ.СуммаИОКт = - Мин(СтрТЧ.СуммаИООборот,СтрТЧ.НачальныйОстатокКт); //уменьшаем остаток, знак минус
			СтрТЧ.СуммаИОДт = СтрТЧ.СуммаИООборот + СтрТЧ.СуммаИОКт;//складываем, т.к. СуммаИОКт - отрицательная
			
		//Если сумма исправления <0 и есть ДТ задолженность, нужно сначала уменьшить остаток по ДТ,
		//а на оставшуюся сумму увеличить КТ	
		ИначеЕсли СтрТЧ.СуммаИООборот<0
			И СтрТЧ.НачальныйОстатокДт>0 Тогда
			
			СуммаИООборотПоложительная = -1*СтрТЧ.СуммаИООборот;
			
			СтрТЧ.СуммаИОДт = - Мин(СуммаИООборотПоложительная,СтрТЧ.НачальныйОстатокДт); //уменьшаем остаток, знак минус
			СтрТЧ.СуммаИОКт = СуммаИООборотПоложительная + СтрТЧ.СуммаИОДт;//складываем, т.к. СуммаИОДт - отрицательная
			
		//НЕТ КТ задолженности и сумма исправления >0, тогда вся сумма исправления это увеличение ДТ	
		ИначеЕсли СтрТЧ.СуммаИООборот>0 Тогда

		    СтрТЧ.СуммаИОДт = СтрТЧ.СуммаИООборот;
			СтрТЧ.СуммаИОКт = 0;
			
		//НЕТ ДТ задолженности и сумма исправления <0, тогда вся сумма исправления это увеличение КТ	
		ИначеЕсли СтрТЧ.СуммаИООборот<0 Тогда
			
			СтрТЧ.СуммаИОДт = 0;
			СтрТЧ.СуммаИОКт = -СтрТЧ.СуммаИООборот;
			
		КонецЕсли;
	КонецЦикла;
	
	//После того как распределили задолженность, можно свернуть таблицу детальных данных	
	//По организации и ИФО сворачивать нельзя никогда, 
	//т.к. в правилах заполнения на набор дополнительно накладываются по ним отбор

	ТаблицаДанных.Свернуть("Счет,Организация,ИФО,КФО,КПС,ВидПоказателя,КЭК",
					"НачальныйОстатокДт,НачальныйОстатокКт,КонечныйОстатокДт,КонечныйОстатокКт,СуммаИОДт,СуммаИОКт,СегмДт,СегмКт,ПрочДт,ПрочКт");
	
	КартаРС = Неопределено;
	
	Если ТаблицаДанных.Количество()>0 Тогда
		//Заполнение вида показателя
		ТабКПС = ТаблицаДанных.Скопировать(,"КПС");
		ТабКПС.Свернуть("КПС");
		
		ЗначенияКПС = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ТабКПС.ВыгрузитьКолонку("КПС"),"ВидПоказателя");
		
		Для Каждого СтрТЧ Из ТаблицаДанных Цикл
			СтрТЧ.ВидПоказателя = ЗначенияКПС[СтрТЧ.КПС];
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТаблицаДанных;
	
КонецФункции

Процедура ДополнитьТаблицуПоРазворотуСубконтоИОборотамСегменты(ТаблицаДанных, КартаРС, СтруктураПолей,СтруктураОтбора,СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовОшибок, МассивИсключаемыхКорСчетов, МассивСчетовСегменты)
	
	МассивСтрок = КартаРС.НайтиСтроки(СтруктураОтбора);
			
	МассивСчетов = Новый Массив;
	Если МассивСтрок.Количество() >0 Тогда
		Для Каждого ТекСтр Из МассивСтрок Цикл
			МассивСчетов.Добавить(ТекСтр.Счет);
		КонецЦикла;
		
		Для Каждого КлючИЗначение Из СтруктураОтбора Цикл
			СтруктураПолей.Вставить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
		КонецЦикла;
	
		ДополнитьТаблицуПоДаннымОстатковИОборотов(ТаблицаДанных, СтруктураПолей, МассивСчетов, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода);
		ДополнитьТаблицуПоДаннымИсправленияОшибок(ТаблицаДанных, СтруктураПолей, МассивСчетов, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода, МассивСчетовОшибок);
		ДополнитьТаблицуПоДаннымОборотовСегменты(ТаблицаДанных, СтруктураПолей, МассивСчетов, МассивИсключаемыхКорСчетов, МассивСчетовСегменты, СтруктураПолейОтбора, Условие, НачалоПериода, КонецПериода);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Копирует настройки компоновки данных из одного компоновщика настроек в другой
Процедура СкопироватьНастройкиКомпоновкиДанных(НастройкиПриемник, НастройкиИсточник) Экспорт
	
	Если НастройкиИсточник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(НастройкиПриемник) = Тип("НастройкиКомпоновкиДанных") Тогда
		Для каждого Параметр Из НастройкиИсточник.ПараметрыДанных.Элементы Цикл
			ЗначениеПараметра = НастройкиПриемник.ПараметрыДанных.НайтиЗначениеПараметра(Параметр.Параметр);
			Если ЗначениеПараметра <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ЗначениеПараметра, Параметр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ТипЗнч(НастройкиИсточник) = Тип("НастройкиВложенногоОбъектаКомпоновкиДанных") Тогда
		ЗаполнитьЗначенияСвойств(НастройкиПриемник, НастройкиИсточник);
		СкопироватьНастройкиКомпоновкиДанных(НастройкиПриемник.Настройки, НастройкиИсточник.Настройки);
		Возврат;
	КонецЕсли;
	
	// Копирование настроек
	Если ТипЗнч(НастройкиИсточник) = Тип("НастройкиКомпоновкиДанных") Тогда
		
		ЗаполнитьЭлементы(НастройкиПриемник.ПараметрыДанных, НастройкиИсточник.ПараметрыДанных);
		СкопироватьЭлементы(НастройкиПриемник.ПользовательскиеПоля, НастройкиИсточник.ПользовательскиеПоля);
		СкопироватьЭлементы(НастройкиПриемник.Отбор,         НастройкиИсточник.Отбор);
		СкопироватьЭлементы(НастройкиПриемник.Порядок,       НастройкиИсточник.Порядок);
		
	КонецЕсли;
	
	Если ТипЗнч(НастройкиИсточник) = Тип("ГруппировкаКомпоновкиДанных")
		ИЛИ ТипЗнч(НастройкиИсточник) = Тип("ГруппировкаТаблицыКомпоновкиДанных")
		ИЛИ ТипЗнч(НастройкиИсточник) = Тип("ГруппировкаДиаграммыКомпоновкиДанных") Тогда
		
		СкопироватьЭлементы(НастройкиПриемник.ПоляГруппировки, НастройкиИсточник.ПоляГруппировки);
		СкопироватьЭлементы(НастройкиПриемник.Отбор,           НастройкиИсточник.Отбор);
		СкопироватьЭлементы(НастройкиПриемник.Порядок,         НастройкиИсточник.Порядок);
		ЗаполнитьЗначенияСвойств(НастройкиПриемник, НастройкиИсточник);
		
	КонецЕсли;
	
	СкопироватьЭлементы(НастройкиПриемник.Выбор,              НастройкиИсточник.Выбор);
	СкопироватьЭлементы(НастройкиПриемник.УсловноеОформление, НастройкиИсточник.УсловноеОформление);
	ЗаполнитьЭлементы(НастройкиПриемник.ПараметрыВывода,      НастройкиИсточник.ПараметрыВывода);
	
	// Копирование структуры
	Если ТипЗнч(НастройкиИсточник) = Тип("НастройкиКомпоновкиДанных")
		ИЛИ ТипЗнч(НастройкиИсточник) = Тип("ГруппировкаКомпоновкиДанных") Тогда
		
		Для каждого ЭлементСтруктурыИсточник Из НастройкиИсточник.Структура Цикл
			ЭлементСтруктурыПриемник = НастройкиПриемник.Структура.Добавить(ТипЗнч(ЭлементСтруктурыИсточник));
			СкопироватьНастройкиКомпоновкиДанных(ЭлементСтруктурыПриемник, ЭлементСтруктурыИсточник);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТипЗнч(НастройкиИсточник) = Тип("ГруппировкаТаблицыКомпоновкиДанных")
		ИЛИ ТипЗнч(НастройкиИсточник) = Тип("ГруппировкаДиаграммыКомпоновкиДанных") Тогда
		
		Для каждого ЭлементСтруктурыИсточник Из НастройкиИсточник.Структура Цикл
			ЭлементСтруктурыПриемник = НастройкиПриемник.Структура.Добавить(ТипЗнч(ЭлементСтруктурыИсточник));
			СкопироватьНастройкиКомпоновкиДанных(ЭлементСтруктурыПриемник, ЭлементСтруктурыИсточник);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТипЗнч(НастройкиИсточник) = Тип("ТаблицаКомпоновкиДанных") Тогда
		
		Для каждого ЭлементСтруктурыИсточник Из НастройкиИсточник.Строки Цикл
			ЭлементСтруктурыПриемник = НастройкиПриемник.Строки.Добавить();
			СкопироватьНастройкиКомпоновкиДанных(ЭлементСтруктурыПриемник, ЭлементСтруктурыИсточник);
		КонецЦикла;
		
		Для каждого ЭлементСтруктурыИсточник Из НастройкиИсточник.Колонки Цикл
			ЭлементСтруктурыПриемник = НастройкиПриемник.Колонки.Добавить();
			СкопироватьНастройкиКомпоновкиДанных(ЭлементСтруктурыПриемник, ЭлементСтруктурыИсточник);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТипЗнч(НастройкиИсточник) = Тип("ДиаграммаКомпоновкиДанных") Тогда
		
		Для каждого ЭлементСтруктурыИсточник Из НастройкиИсточник.Серии Цикл
			ЭлементСтруктурыПриемник = НастройкиПриемник.Серии.Добавить();
			СкопироватьНастройкиКомпоновкиДанных(ЭлементСтруктурыПриемник, ЭлементСтруктурыИсточник);
		КонецЦикла;
		
		Для каждого ЭлементСтруктурыИсточник Из НастройкиИсточник.Точки Цикл
			ЭлементСтруктурыПриемник = НастройкиПриемник.Точки.Добавить();
			СкопироватьНастройкиКомпоновкиДанных(ЭлементСтруктурыПриемник, ЭлементСтруктурыИсточник);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Копирует элементы из одной коллекции в другую
//
Процедура СкопироватьЭлементы(ПриемникЗначения, ИсточникЗначения, ПроверятьДоступность = Ложь, ОчищатьПриемник = Истина) Экспорт
	
	Если ТипЗнч(ИсточникЗначения) = Тип("УсловноеОформлениеКомпоновкиДанных")
		ИЛИ ТипЗнч(ИсточникЗначения) = Тип("ВариантыПользовательскогоПоляВыборКомпоновкиДанных")
		ИЛИ ТипЗнч(ИсточникЗначения) = Тип("ОформляемыеПоляКомпоновкиДанных") Тогда
		СоздаватьПоТипу = Ложь;
	Иначе
		СоздаватьПоТипу = Истина;
	КонецЕсли;
	ПриемникЭлементов = ПриемникЗначения.Элементы;
	ИсточникЭлементов = ИсточникЗначения.Элементы;
	Если ОчищатьПриемник Тогда
		ПриемникЭлементов.Очистить();
	КонецЕсли;
	
	Для каждого ЭлементИсточник Из ИсточникЭлементов Цикл
		
		Если ТипЗнч(ЭлементИсточник) = Тип("ЭлементПорядкаКомпоновкиДанных") Тогда
			// Элементы порядка добавляем в начало
			Индекс = ИсточникЭлементов.Индекс(ЭлементИсточник);
			ЭлементПриемник = ПриемникЭлементов.Вставить(Индекс, ТипЗнч(ЭлементИсточник));
		Иначе
			Если СоздаватьПоТипу Тогда
				ЭлементПриемник = ПриемникЭлементов.Добавить(ТипЗнч(ЭлементИсточник));
			Иначе
				ЭлементПриемник = ПриемникЭлементов.Добавить();
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЭлементПриемник, ЭлементИсточник);
		// В некоторых коллекциях необходимо заполнить другие коллекции
		Если ТипЗнч(ИсточникЭлементов) = Тип("КоллекцияЭлементовУсловногоОформленияКомпоновкиДанных") Тогда
			СкопироватьЭлементы(ЭлементПриемник.Поля, ЭлементИсточник.Поля);
			СкопироватьЭлементы(ЭлементПриемник.Отбор, ЭлементИсточник.Отбор);
			ЗаполнитьЭлементы(ЭлементПриемник.Оформление, ЭлементИсточник.Оформление); 
		ИначеЕсли ТипЗнч(ИсточникЭлементов)	= Тип("КоллекцияВариантовПользовательскогоПоляВыборКомпоновкиДанных") Тогда
			СкопироватьЭлементы(ЭлементПриемник.Отбор, ЭлементИсточник.Отбор);
		КонецЕсли;
		
		// В некоторых элементах коллекции необходимо заполнить другие коллекции
		Если ТипЗнч(ЭлементИсточник) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			СкопироватьЭлементы(ЭлементПриемник, ЭлементИсточник);
		ИначеЕсли ТипЗнч(ЭлементИсточник) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			СкопироватьЭлементы(ЭлементПриемник, ЭлементИсточник);
		ИначеЕсли ТипЗнч(ЭлементИсточник) = Тип("ПользовательскоеПолеВыборКомпоновкиДанных") Тогда
			СкопироватьЭлементы(ЭлементПриемник.Варианты, ЭлементИсточник.Варианты);
		ИначеЕсли ТипЗнч(ЭлементИсточник) = Тип("ПользовательскоеПолеВыражениеКомпоновкиДанных") Тогда
			ЭлементПриемник.УстановитьВыражениеДетальныхЗаписей (ЭлементИсточник.ПолучитьВыражениеДетальныхЗаписей());
			ЭлементПриемник.УстановитьВыражениеИтоговыхЗаписей(ЭлементИсточник.ПолучитьВыражениеИтоговыхЗаписей());
			ЭлементПриемник.УстановитьПредставлениеВыраженияДетальныхЗаписей(ЭлементИсточник.ПолучитьПредставлениеВыраженияДетальныхЗаписей ());
			ЭлементПриемник.УстановитьПредставлениеВыраженияИтоговыхЗаписей(ЭлементИсточник.ПолучитьПредставлениеВыраженияИтоговыхЗаписей ());
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Выполняет сериализацию компоновщика настроек для сохранения в схеме заполнения
//
// Параметры:
//  КомпоновщикНастроек - Компоновщик настроек для сериализации
//  УникальныйИдентификаторВладельца - уникальный идентификатор формы
//
// Возвращаемое значение:
//  Адрес во временном хранилище - текст сериализованного компоновщика
//
Функция СохранитьКомпоновщикНастроек(КомпоновщикНастроек, УникальныйИдентификаторВладельца) Экспорт
	
	СериализованноеЗначение = "";
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, КомпоновщикНастроек);
	
	СериализованноеЗначение = ЗаписьXML.Закрыть();
	
	Возврат ПоместитьВоВременноеХранилище(СериализованноеЗначение, УникальныйИдентификаторВладельца);
	
КонецФункции

// Выполняет сериализацию таблицы настроек расшифровки для сохранения в схеме заполнения
//
// Параметры:
//  ТаблицаНастроекФорма - Таблица значений с настройками
//
// Возвращаемое значение:
//  Строка, текст сериализованных настроек
//
Функция СохранитьТаблицуНастроекОткрытияТиповыхОтчетов(ТаблицаНастроекФорма) Экспорт
	
	ТаблицаНастроек = ТаблицаНастроекФорма.СкопироватьКолонки();
	ТаблицаНастроек.Колонки.Добавить("Настройки");
	
	Для каждого СтрокаТаблицы Из ТаблицаНастроекФорма Цикл
		
		Если НЕ ПустаяСтрока(СтрокаТаблицы.Идентификатор) И ЭтоАдресВременногоХранилища(СтрокаТаблицы.АдресНастройки) Тогда
			
			НоваяСтрока = ТаблицаНастроек.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			НоваяСтрока.Настройки = ПолучитьИзВременногоХранилища(СтрокаТаблицы.АдресНастройки)
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаНастроек.Колонки.Удалить("АдресНастройки");
	
	ДиспетчерСериализации = Обработки.СериализацияПравилаЗаполненияОтчетности.Создать();
	ТекстНастроек = ДиспетчерСериализации.СохранитьТаблицуНастроекДетализацииСтандартнымиОтчетами(ТаблицаНастроек);
	
	Возврат """" + СтрЗаменить(ТекстНастроек, """", """""") + """";
	
КонецФункции

// Выполняет замену параметров отбора из таблицы Вычисляемые счета области заполнения,
// на ссылки счетов, полученных по функции ЗаполнениеОтчетности.ПолучитьМассивСчетов.
//
// Параметры:
//  Схема - схема компоновки данных, в элементах отбора которой будет выполняться замена
//  ВычисляемыеПараметры - таблица значений с колонками ИмяПараметра, СписокСчетов, ПоИерархии
//
Процедура ПреобразоватьПоляОтбораВычисляемыхСчетов_СКД(Схема,ВычисляемыеПараметры) Экспорт
	
	СоответствиеВП = Новый Соответствие;
	Для Каждого СтрТЧ Из ВычисляемыеПараметры Цикл
		МассивСчетов = ЗаполнениеОтчетности.ПолучитьМассивСчетов(СтрТЧ.СписокСчетов,Неопределено,СтрТЧ.ПоИерархии = Ложь);
		СоответствиеВП.Вставить("ПараметрыДанных.ВПС_"+СтрТЧ.ИмяПараметра,МассивСчетов);			
	КонецЦикла;
			
	СоответствиеОтборов = Новый Соответствие;
	СоответствиеОтборов.Вставить(ВидСравненияКомпоновкиДанных.Равно,ВидСравненияКомпоновкиДанных.ВСписке);
	СоответствиеОтборов.Вставить(ВидСравненияКомпоновкиДанных.НеРавно,ВидСравненияКомпоновкиДанных.НеВСписке);
	СоответствиеОтборов.Вставить(ВидСравненияКомпоновкиДанных.ВИерархии,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии);
	СоответствиеОтборов.Вставить(ВидСравненияКомпоновкиДанных.НеВИерархии,ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии);
			
	ПреобразоватьПолеОтбораВычисляемыхСчетов(Схема.ВариантыНастроек.Основной.Настройки.Отбор.Элементы,СоответствиеВП,СоответствиеОтборов);
	
КонецПроцедуры

Процедура ПреобразоватьПолеОтбораВычисляемыхСчетов(КоллекцияПолей, СоответствиеВП,СоответствиеОтборов)
	Для каждого ПолеОтбора Из КоллекцияПолей Цикл		
		Если ТипЗнч(ПолеОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда			
			ПреобразоватьПолеОтбораВычисляемыхСчетов(ПолеОтбора.Элементы, СоответствиеВП,СоответствиеОтборов);
		Иначе
			Если ТипЗнч(ПолеОтбора.ПравоеЗначение) = Тип("ПолеКомпоновкиДанных") Тогда
				МассивСчетов = СоответствиеВП[Строка(ПолеОтбора.ПравоеЗначение)];
				Если МассивСчетов <> Неопределено Тогда
					ПолеОтбора.ВидСравнения = СоответствиеОтборов[ПолеОтбора.ВидСравнения];
					ПолеОтбора.ПравоеЗначение = МассивСчетов;
				КонецЕсли;				
			КонецЕсли;			
		КонецЕсли;		
	КонецЦикла;	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Процедура ДобавитьПараметр(Схема, Настройки = Неопределено, Знач СтруктураПараметров, Знач ДобавлятьНовые = Ложь)
	
	Перем ИмяПараметра;
	Перем ЗначениеПараметра;
	
	ПараметрыСхемы = Схема.Параметры;
	
	Если Настройки = Неопределено Тогда
		
		Настройки = Схема.ВариантыНастроек.Основной.Настройки;
		
	КонецЕсли;
	
	СтруктураПараметров.Свойство("ИмяПараметра", ИмяПараметра);
	СтруктураПараметров.Свойство("ЗначениеПараметра", ЗначениеПараметра);
	
	Использование = Истина;
	
	Если ТипЗнч(ЗначениеПараметра) = Тип("Структура") Тогда
	
		Значение = Неопределено;
		Если ЗначениеПараметра.Свойство("Использование", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
			Использование = Значение;
		КонецЕсли;
		
		ЛевоеЗначение = Неопределено;
		ПравоеЗначение = Неопределено;
		СписокЗначений = Неопределено;
		
		ЗначениеПараметра.Свойство("ЛевоеЗначение", ЛевоеЗначение);
		ЗначениеПараметра.Свойство("ПравоеЗначение", ПравоеЗначение);
		ЗначениеПараметра.Свойство("СписокЗначений", СписокЗначений);
		
		Если ТипЗнч(Строка(ЛевоеЗначение)) = Тип("Строка") И Не ПустаяСтрока(Строка(ЛевоеЗначение)) Тогда
			ИмяПараметра = Строка(ЛевоеЗначение);
		КонецЕсли;
		
		Если ТипЗнч(СписокЗначений) = Тип("СписокЗначений") Тогда
			ЗначениеПараметра = СписокЗначений;
		Иначе
			ЗначениеПараметра = ПравоеЗначение;
		КонецЕсли;
		
	КонецЕсли;
	
	// Заполнение параметра схемы
	ПараметрСхемы = ПараметрыСхемы.Найти(ИмяПараметра);
	
	Если ПараметрСхемы = Неопределено Тогда
		
		Если ДобавлятьНовые Тогда
			
			ПараметрСхемы = ПараметрыСхемы.Добавить();
			ПараметрСхемы.Имя = ИмяПараметра;
			ПараметрСхемы.ОграничениеИспользования = Истина;
			ПараметрСхемы.ВключатьВДоступныеПоля = Истина;
			
		Иначе
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТипЗначенияПараметра = ТипЗнч(ЗначениеПараметра);
	
	Если ТипЗначенияПараметра = Тип("СписокЗначений") Тогда
		ПараметрСхемы.ДоступенСписокЗначений = Истина;
		ТипЗначения = ЗначениеПараметра.ТипЗначения;
	Иначе
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипЗначенияПараметра);
		ТипЗначения = Новый ОписаниеТипов(МассивТипов);
	КонецЕсли;
	
	ПараметрСхемы.Значение = ЗначениеПараметра;
	ПараметрСхемы.ТипЗначения = ТипЗначения;
	ПараметрСхемы.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
	
	// Заполнение параметра настроек
	ПараметрКомпоновкиДанных = Новый ПараметрКомпоновкиДанных(ПараметрСхемы.Имя);
	
	ЗначениеПараметраНастроек = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновкиДанных);
	Если ЗначениеПараметраНастроек = Неопределено Тогда
		
		ПараметрНастроек = Настройки.ПараметрыДанных.Элементы.Добавить();
		ПараметрНастроек.Параметр = ПараметрКомпоновкиДанных;
		ПараметрНастроек.Значение = ЗначениеПараметра;
		ПараметрНастроек.Использование = Истина;
		
	Иначе
		
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ПараметрКомпоновкиДанных, ЗначениеПараметра);
		
	КонецЕсли;
	
	// Проверка условий в отборах по правому значению
	ПроверкаУсловийОтбора(ПараметрСхемы, Использование, ТипЗначенияПараметра, Настройки.Отбор.Элементы);
	
КонецПроцедуры

Процедура ДобавитьПараметрыВСхему(СхемаКомпоновки, Знач ОбщиеПараметры)
	
	Для каждого СтрокаТаблицы Из ОбщиеПараметры Цикл
		
		ПараметрСхемы = СхемаКомпоновки.Параметры.Добавить();
		ПараметрСхемы.Имя = СтрокаТаблицы.ИмяПараметра;
		ПараметрСхемы.ОграничениеИспользования = Истина;
		ПараметрСхемы.ВключатьВДоступныеПоля = Истина;
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипЗнч(СтрокаТаблицы.ЗначениеПараметра));
		ТипЗначения = Новый ОписаниеТипов(МассивТипов);
		
		ПараметрСхемы.Значение = СтрокаТаблицы.ЗначениеПараметра;
		ПараметрСхемы.ТипЗначения = ТипЗначения;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет одну коллекцию элементов на основании другой
//
Процедура ЗаполнитьЭлементы(ПриемникЗначения, ИсточникЗначения, ПервыйУровень = Неопределено)
	
	Если ТипЗнч(ПриемникЗначения) = Тип("КоллекцияЗначенийПараметровКомпоновкиДанных") Тогда
		КоллекцияЗначений = ИсточникЗначения;
	Иначе
		КоллекцияЗначений = ИсточникЗначения.Элементы;
	КонецЕсли;
	
	Для каждого ЭлементИсточник Из КоллекцияЗначений Цикл
		Если ПервыйУровень = Неопределено Тогда
			ЭлементПриемник = ПриемникЗначения.НайтиЗначениеПараметра(ЭлементИсточник.Параметр);
		Иначе
			ЭлементПриемник = ПервыйУровень.НайтиЗначениеПараметра(ЭлементИсточник.Параметр);
		КонецЕсли;
		Если ЭлементПриемник = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ЭлементПриемник, ЭлементИсточник);
		Если ТипЗнч(ЭлементИсточник) = Тип("ЗначениеПараметраКомпоновкиДанных") Тогда
			Если ЭлементИсточник.ЗначенияВложенныхПараметров.Количество() <> 0 Тогда
				ЗаполнитьЭлементы(ЭлементПриемник.ЗначенияВложенныхПараметров, ЭлементИсточник.ЗначенияВложенныхПараметров, ПриемникЗначения);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПрименитьАгрегатнуюФункцию(Знач ТекстВыражения, Знач АгрегатнаяФункция)
	
	Перем Результат;
	
	Если АгрегатнаяФункция = "Нет" Тогда
		Результат = ТекстВыражения;
	ИначеЕсли АгрегатнаяФункция = "Сумма" Тогда
		Результат = "Сумма("+ТекстВыражения+")";
	ИначеЕсли АгрегатнаяФункция = "Количество" Тогда
		Результат = "Количество("+ТекстВыражения+")";
	ИначеЕсли АгрегатнаяФункция = "Количество различных" Тогда
		Результат = "Количество(Различные "+ТекстВыражения+")";
	ИначеЕсли АгрегатнаяФункция = "Минимум" Тогда
		Результат = "Минимум("+ТекстВыражения+")";
	ИначеЕсли АгрегатнаяФункция = "Максимум" Тогда
		Результат = "Максимум("+ТекстВыражения+")";
	ИначеЕсли АгрегатнаяФункция = "Среднее" Тогда
		Результат = "Среднее("+ТекстВыражения+")";
	ИначеЕсли АгрегатнаяФункция = "СоединитьСтроки" Тогда
		Результат = "СоединитьСтроки("+ТекстВыражения+")";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверкаУсловийОтбора(ПараметрСхемы, Использование, ТипЗначенияПараметра, КоллекцияЭлементовОтбора)
	
	Для каждого ЭлементОтбора Из КоллекцияЭлементовОтбора Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			ПроверкаУсловийОтбора(ПараметрСхемы, Использование, ТипЗначенияПараметра, ЭлементОтбора.Элементы);
			
		Иначе
			
			Если ЭлементОтбора.ПравоеЗначение = Новый ПолеКомпоновкиДанных("ПараметрыДанных."+ПараметрСхемы.Имя) Тогда
				
				ЭлементОтбора.Использование = Использование;
				
				Если ТипЗначенияПараметра = Тип("СписокЗначений") Тогда
					
					Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
						ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
						ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Служебные процедуры метода ОбъединитьНаборы

Процедура ДобавитьГруппуОтбораСКД(Знач ПолеОтбораШаблона, Знач КоллекцияПолейШаблона, КоллекцияПолейНабора, КоллекцияЭлементовОтбора, НаименованиеНабора)
	
	НоваяГруппаОтбора = КоллекцияЭлементовОтбора.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ЗаполнитьЗначенияСвойств(НоваяГруппаОтбора,ПолеОтбораШаблона);
	
	Для каждого ЭлементОтбора Из ПолеОтбораШаблона.Элементы Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			ДобавитьГруппуОтбораСКД(ЭлементОтбора, КоллекцияПолейШаблона, КоллекцияПолейНабора, НоваяГруппаОтбора.Элементы, НаименованиеНабора);
			
		Иначе
			
			ДобавитьОтборСКД(ЭлементОтбора, КоллекцияПолейШаблона, КоллекцияПолейНабора, НоваяГруппаОтбора.Элементы, НаименованиеНабора);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьОтборСКД(Знач ПолеОтбораШаблона, Знач КоллекцияПолейШаблона, КоллекцияПолейНабора, КоллекцияЭлементовОтбора, НаименованиеНабора)
	
	НовоеПолеОтбора = КоллекцияЭлементовОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЗаполнитьЗначенияСвойств(НовоеПолеОтбора,ПолеОтбораШаблона);
	НовоеПолеОтбора.ЛевоеЗначение = ДобавитьПолеОтбораСКД(Строка(ПолеОтбораШаблона.ЛевоеЗначение), КоллекцияПолейШаблона, КоллекцияПолейНабора, КоллекцияЭлементовОтбора, НаименованиеНабора);
	
	Если ТипЗнч(НовоеПолеОтбора.ПравоеЗначение) = Тип("ПолеКомпоновкиДанных") Тогда
		
		НовоеПолеОтбора.ПравоеЗначение = ДобавитьПолеОтбораСКД(Строка(ПолеОтбораШаблона.ПравоеЗначение), КоллекцияПолейШаблона, КоллекцияПолейНабора, КоллекцияЭлементовОтбора, НаименованиеНабора);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьПолеОтбораСКД(Знач ИмяПоля, Знач КоллекцияПолейШаблона, КоллекцияПолейНабора, КоллекцияЭлементовОтбора, НаименованиеНабора)
	
	// Если у поля шаблона есть заголовок, то это поле в объединении называется именем заголовка
	Поз = Найти(ИмяПоля, ".");
	Если Поз <> 0 Тогда
		ПолеШаблона = НайтиПолеНабораСКД(ИмяПоля, КоллекцияПолейШаблона);
		Если ПолеШаблона = Неопределено Тогда
			ИмяРодителя = Лев(ИмяПоля, Поз - 1);
			Если ИмяРодителя = "ПараметрыДанных" Тогда
				Возврат Новый ПолеКомпоновкиДанных(ИмяПоля);
			КонецЕсли;
			ПодчиненныеПоля = Сред(ИмяПоля, Поз);
			ПолеШаблона = КоллекцияПолейШаблона.Найти(ИмяРодителя);
			Если ПолеШаблона <> Неопределено И НЕ ПустаяСтрока(ПолеШаблона.Заголовок) Тогда
				ИмяРодителя = ПолеШаблона.Заголовок;
			КонецЕсли;
		Иначе
			ИмяРодителя = ПолеШаблона.Поле;
			ПодчиненныеПоля = "";
		КонецЕсли;
	Иначе
		ИмяРодителя = ИмяПоля;
		ПодчиненныеПоля = "";
		ПолеШаблона = КоллекцияПолейШаблона.Найти(ИмяРодителя);
		Если ПолеШаблона <> Неопределено И НЕ ПустаяСтрока(ПолеШаблона.Заголовок) Тогда
			ИмяРодителя = ПолеШаблона.Заголовок;
		КонецЕсли;
	КонецЕсли;
	
	Если ПолеШаблона <> Неопределено Тогда
		
		ТипЗначения = ПолеШаблона.ТипЗначения;
		
		Если НЕ ПустаяСтрока(ПолеШаблона.Заголовок) Тогда
			
			ИмяРодителя = ПолеШаблона.Заголовок;
			
		КонецЕсли;
		
		ПутьКДанным = СтрЗаменить("Условие" + НаименованиеНабора + ИмяРодителя, ".", "");
	Иначе
		ПутьКДанным = СтрЗаменить(ИмяРодителя, ".", "");
	КонецЕсли;
	
	НовоеПолеЭлементаНабора = КоллекцияПолейНабора.Найти(ПутьКДанным);
	Если НовоеПолеЭлементаНабора = Неопределено Тогда
		
		// Добавление поля вложенного набора
		НовоеПолеЭлементаНабора = КоллекцияПолейНабора.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПолеЭлементаНабора.Поле = ИмяРодителя;
		НовоеПолеЭлементаНабора.ПутьКДанным = ПутьКДанным;
		Если ТипЗначения <> Неопределено Тогда
			НовоеПолеЭлементаНабора.ТипЗначения = ТипЗначения;
		КонецЕсли;
		
		НовоеПолеЭлементаНабора.ОграничениеИспользования.Поле = Истина;
		НовоеПолеЭлементаНабора.ОграничениеИспользования.Группировка = Истина;
		НовоеПолеЭлементаНабора.ОграничениеИспользования.Порядок = Истина;
		
		НовоеПолеЭлементаНабора.ОграничениеИспользованияРеквизитов.Поле = Истина;
		НовоеПолеЭлементаНабора.ОграничениеИспользованияРеквизитов.Группировка = Истина;
		НовоеПолеЭлементаНабора.ОграничениеИспользованияРеквизитов.Порядок = Истина;
		
	КонецЕсли;
	
	Возврат Новый ПолеКомпоновкиДанных(ПутьКДанным + ПодчиненныеПоля);;
	
КонецФункции // ДобавитьПолеОтбораСКД()

Процедура ЗаполнитьНастрокиСхемы(Настройки, КоллекцияВыбранныхЭлементовШаблона, КоллекцияПараметровСхемыОбъединение, МассивВыбранныхПолей)
	
	// Заполнение в настройках выбранных полей
	Для каждого ПолеВыбора Из КоллекцияВыбранныхЭлементовШаблона Цикл
		
		Если МассивВыбранныхПолей.Найти(ПолеВыбора.Поле) = Неопределено Тогда
			
			НовоеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовоеПоле,ПолеВыбора);
			НовоеПоле.Использование = Истина;
			
			МассивВыбранныхПолей.Добавить(ПолеВыбора.Поле);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Создание параметров в настройках схемы
	Для каждого ПараметрСхемы Из КоллекцияПараметровСхемыОбъединение Цикл
		
		Если ЗначениеЗаполнено(ПараметрСхемы.Значение) ИЛИ Найти("НачалоПериода,КонецПериода", ПараметрСхемы.Имя) <> 0 Тогда
			
			ПараметрКомпоновкиДанных = Новый ПараметрКомпоновкиДанных(ПараметрСхемы.Имя);
			
			ЗначениеПараметраНастроек = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновкиДанных);
			Если ЗначениеПараметраНастроек = Неопределено Тогда
				
				ПараметрНастроек = Настройки.ПараметрыДанных.Элементы.Добавить();
				ПараметрНастроек.Параметр = ПараметрКомпоновкиДанных;
				ПараметрНастроек.Значение = ПараметрСхемы.Значение;
				ПараметрНастроек.Использование = Истина;
				
			Иначе
				
				Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ПараметрКомпоновкиДанных, ПараметрСхемы.Значение);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ЗаполнитьПараметрыСхемы(ШаблонСхемы, СхемаКомпоновкиОбъединение, НаименованиеНабора)
	
	ПараметрыДанных = ШаблонСхемы.ВариантыНастроек.Основной.Настройки.ПараметрыДанных;
	Для каждого Параметр Из ШаблонСхемы.Параметры Цикл
		
		ПараметрСхемыКомпоновкиОбъединение = СхемаКомпоновкиОбъединение.Параметры.Найти(Параметр.Имя);
		
		Если ПараметрСхемыКомпоновкиОбъединение = Неопределено Тогда
			
			ПараметрКомпоновкиДанных = Новый ПараметрКомпоновкиДанных(Параметр.Имя);
			ЗначениеПараметра = ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновкиДанных);
			
			ПараметрЭлементаНабора = СхемаКомпоновкиОбъединение.Параметры.Добавить();
			ЗаполнитьЗначенияСвойств(ПараметрЭлементаНабора, Параметр);
			
			Если ПараметрЭлементаНабора.Имя = "ПериодОтчета" Тогда
				
				ПараметрЭлементаНабора.Имя = "ПериодОтчета_"+НаименованиеНабора;
				ПараметрЭлементаНабора.Заголовок = ПараметрЭлементаНабора.Имя;
				
				Если ЗначениеПараметра.Значение = "КонецПериода" Тогда

					ПараметрЭлементаНабора.Выражение = "ЗаполнениеОтчетности.ПреобразоватьКонецПериода(&"+ЗначениеПараметра.Значение+")";

				Иначе
					ПараметрЭлементаНабора.Выражение = "&"+ЗначениеПараметра.Значение;
				КонецЕсли;
				
				ПараметрЭлементаНабора.Значение = "";
				
			ИначеЕсли ПараметрЭлементаНабора.Имя = "ВидыСубконто" Тогда
				
				ПараметрЭлементаНабора.Имя = "ВидыСубконто_"+НаименованиеНабора;
				ПараметрЭлементаНабора.Заголовок = ПараметрЭлементаНабора.Имя;
				ПараметрЭлементаНабора.ДоступенСписокЗначений = Истина;
				
				Если ТипЗнч(ЗначениеПараметра.Значение) = Тип("СписокЗначений") Тогда
					ПараметрЭлементаНабора.Значение = ЗначениеПараметра.Значение.Скопировать();
				ИначеЕсли ЗначениеЗаполнено(ЗначениеПараметра.Значение) Тогда
