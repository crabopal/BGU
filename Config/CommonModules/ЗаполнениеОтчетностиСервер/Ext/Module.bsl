		ТекстУсловияИсключатьСамиСчета = "ЗНАЧЕНИЕ("+ИмяТаблицы+".ПустаяСсылка)";
	КонецЕсли;
	
	Запрос.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Запрос.Текст,
			ТекстУсловияИсключенияСчетов, ТекстУсловияВключенияСамихСчетов,
			ТекстУсловияИсключатьСамиСчета, ТекстУсловияПервыйРодитель, ТекстУсловие5);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Возврат НЕ Результат[5].Пустой();
	
КонецФункции

Функция ПолучитьРезультат(МенеджерВременныхТаблиц,ИмяТаблицы)
	
	Запрос = Новый Запрос;
	
	Если ИмяТаблицы = "ПланСчетов.ЕПСБУ" Тогда
		ПолеУпорядочивания = "Порядок";
	Иначе
		ПолеУпорядочивания = "Код";
	КонецЕсли;

	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Результат.Ссылка,
		|	Результат.Родитель
		|ИЗ
		|	Результат КАК Результат
		|
		|УПОРЯДОЧИТЬ ПО
		|	Результат.Ссылка."+ПолеУпорядочивания+",
		|	Результат.Родитель."+ПолеУпорядочивания;
		
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Индексы.Добавить("Ссылка");
		
	Возврат Таблица;
	
КонецФункции

/////////////////////////////////////////////////////////////////////////
// Проверка правил заполнения

Функция ПодготовитьСтруктуруПараметровПроверки() Экспорт
	
	СтруктураПараметров = Новый Структура;
	
	//параметры запуска 
	СтруктураПараметров.Вставить("ПравилоЗаполнения");
	СтруктураПараметров.Вставить("ОбластьЗаполнения");
	СтруктураПараметров.Вставить("ПараметрыЗаполнения");
	
	// Вниутренние управляющие параметры
	СтруктураПараметров.Вставить("СформироватьТолькоТаблицуОбласти",Ложь);
	
	//данные Механизма кэширования
	СтруктураПараметров.Вставить("КэшЗаполнен",Ложь);
	СтруктураПараметров.Вставить("ИсточникЗаполненияКэша");
	СтруктураПараметров.Вставить("КэшируемыеДанные",Новый Структура);
	СтруктураПараметров.КэшируемыеДанные.Вставить("ПравилоЗаполнения");
	СтруктураПараметров.КэшируемыеДанные.Вставить("ПравилоНаименование");
	СтруктураПараметров.КэшируемыеДанные.Вставить("НаименованиеВидаОтчета");
	СтруктураПараметров.КэшируемыеДанные.Вставить("ТаблицаМетодовДополнительнойОбработки");
	СтруктураПараметров.КэшируемыеДанные.Вставить("КартыДанных");
	СтруктураПараметров.КэшируемыеДанные.Вставить("ОбработкаЗаполнения");
	СтруктураПараметров.КэшируемыеДанные.Вставить("МакетОтчета");
	
	
	
	Возврат СтруктураПараметров;
	
КонецФункции	

Функция СформироватьОтчетПроверкиПравилЗаполнения(СтруктураПараметров) Экспорт 
	
	Если не ЗначениеЗаполнено(СтруктураПараметров.ПравилоЗаполнения) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(СтруктураПараметров.ПараметрыЗаполнения) <> Тип("Структура") Тогда 
		Возврат Неопределено;
	КонецЕсли;	
	
	СтруктураПараметров.ИсточникЗаполненияКэша = "ПравилоЗаполнения";
	ЗаполнитьКэшируемыеДанные(СтруктураПараметров);
	
	ПравилоЗаполнения = СтруктураПараметров.КэшируемыеДанные.ПравилоЗаполнения;
	ПравилоНаименование = СтруктураПараметров.КэшируемыеДанные.ПравилоНаименование;
	НаименованиеВидаОтчета = СтруктураПараметров.КэшируемыеДанные.НаименованиеВидаОтчета;
	ТаблицаМетодовДополнительнойОбработки = СтруктураПараметров.КэшируемыеДанные.ТаблицаМетодовДополнительнойОбработки;
	КартыДанных = СтруктураПараметров.КэшируемыеДанные.КартыДанных;
	
	//Т.к. тип значения колонок в картах явно задан, то надо удалить колонку и заново добавить,
	//чтобы присваивать нужные значения без приведения типов.
	
	Для Каждого КлючИЗначение Из КартыДанных Цикл
		МассивИменКолонок = Новый Массив;
		Для Каждого ТекКолонка Из КлючИЗначение.Значение.Колонки Цикл
			Если Лев(ТекКолонка.Имя,5)= "Пред_" Тогда
				МассивИменКолонок.Добавить(ТекКолонка.Имя);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекИмя Из МассивИменКолонок Цикл
			КлючИЗначение.Значение.Колонки.Удалить(ТекИмя);
			КлючИЗначение.Значение.Колонки.Добавить(ТекИмя);
		КонецЦикла;
	КонецЦикла;
	
	ОбработкаЗаполнения = СтруктураПараметров.КэшируемыеДанные.ОбработкаЗаполнения;
	МакетОтчета = СтруктураПараметров.КэшируемыеДанные.МакетОтчета;
	
		
	СписокОбластей = Справочники.ПравилаЗаполнения.ПолучитьСписокОбластей(ПравилоЗаполнения,,Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
	
	МакетОбъектПроверки =	МакетОтчета.ПолучитьОбласть("ОбъектПроверки");
	
	// ОбъектПроверки
	
	Сообщение = НСтр("ru = 'Проверка правила заполнения "" %1 "" вида отчета "" %2 ""'");
	МакетОбъектПроверки.Параметры.Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Сообщение, ПравилоНаименование, НаименованиеВидаОтчета);
	
	ТабличныйДокумент.Вывести(МакетОбъектПроверки, 0, "Правило", Истина);
	
	
	// параметры заполнения
	ВывестиПараметрыЗаполнения(ТабличныйДокумент, СтруктураПараметров);
	
	СтруктураДопПараметров = Новый Структура;
	
	МассивКодов = Новый Массив;	
	
	Для каждого Элемент Из СписокОбластей Цикл
		Схема = Элемент.СхемаКомпоновки.Получить();
		
		Для Каждого ТекПараметр Из Схема.Параметры Цикл
			Если Лев(ТекПараметр.Имя,13)= "КодВидаОтчета" 
				И ЗначениеЗаполнено(ТекПараметр.Значение) Тогда	
				КодВидаОтчета = ТекПараметр.Значение;
				МассивКодов.Добавить(КодВидаОтчета);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивКодов Цикл
		СсылкаНаОтчет = Справочники.ВидыОтчетов.НайтиПоКоду(ЭлМас);	
		
		СтруктураДопПараметров.Вставить(ЭлМас,ЗначениеЗаполнено(СсылкаНаОтчет));
	КонецЦикла;
		
	// Области заполнения	
	Для каждого Элемент Из СписокОбластей Цикл
		
		Если ЗначениеЗаполнено(Элемент.Условие) Тогда
			//Нужно проверить выполнение данного условия
			УсловиеВыполненияОбласти = ПроверитьУсловиеОбласти(Элемент.Условие, СтруктураПараметров.ПараметрыЗаполнения,СтруктураДопПараметров);
			Если УсловиеВыполненияОбласти = Ложь Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СтруктураПараметров.ОбластьЗаполнения = Элемент.Значение;
		СтруктураПараметров.СформироватьТолькоТаблицуОбласти = Истина;
		
		ТабличныйДокументОбласти = СформироватьОтчетПроверкиОбластейЗаполнения(СтруктураПараметров);
		ТабличныйДокумент.Вывести(ТабличныйДокументОбласти, 1, "Область", Истина);
		
	КонецЦикла;
	
	//Подвал
	
	ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
	
	ПрименитьОформлениеКТаблице(ТабличныйДокумент);
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция СформироватьОтчетПроверкиОбластейЗаполнения(СтруктураПараметров) Экспорт 
	
	Если не ЗначениеЗаполнено(СтруктураПараметров.ОбластьЗаполнения) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(СтруктураПараметров.ПараметрыЗаполнения) <> Тип("Структура") Тогда 
		Возврат Неопределено;
	КонецЕсли;	
	
	СтруктураПараметров.ИсточникЗаполненияКэша = "ОбластьЗаполнения";
	ЗаполнитьКэшируемыеДанные(СтруктураПараметров);
	
	ПравилоЗаполнения = СтруктураПараметров.КэшируемыеДанные.ПравилоЗаполнения;
	ПравилоНаименование = СтруктураПараметров.КэшируемыеДанные.ПравилоНаименование;
	НаименованиеВидаОтчета = СтруктураПараметров.КэшируемыеДанные.НаименованиеВидаОтчета;
	ТаблицаМетодовДополнительнойОбработки = СтруктураПараметров.КэшируемыеДанные.ТаблицаМетодовДополнительнойОбработки;
	КартыДанных = СтруктураПараметров.КэшируемыеДанные.КартыДанных;
	
	//Т.к. тип значения колонок в картах явно задан, то надо удалить колонку и заново добавить,
	//чтобы присваивать нужные значения без приведения типов.
	
	Для Каждого КлючИЗначение Из КартыДанных Цикл
		МассивИменКолонок = Новый Массив;
		Для Каждого ТекКолонка Из КлючИЗначение.Значение.Колонки Цикл
			Если Лев(ТекКолонка.Имя,5)= "Пред_" Тогда
				МассивИменКолонок.Добавить(ТекКолонка.Имя);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекИмя Из МассивИменКолонок Цикл
			КлючИЗначение.Значение.Колонки.Удалить(ТекИмя);
			КлючИЗначение.Значение.Колонки.Добавить(ТекИмя);
		КонецЦикла;
	КонецЦикла;
	
	ОбработкаЗаполнения = СтруктураПараметров.КэшируемыеДанные.ОбработкаЗаполнения;
	МакетОтчета = СтруктураПараметров.КэшируемыеДанные.МакетОтчета;
	
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	МакетОбъектПроверки =	МакетОтчета.ПолучитьОбласть("ОбъектПроверки");
	МакетРазделОбласть = 	МакетОтчета.ПолучитьОбласть("РазделОбласть");
	МакетЗаголовокКолонка = МакетОтчета.ПолучитьОбласть("Заголовок|Колонка");
	МакетСтрокаКолонка = 	МакетОтчета.ПолучитьОбласть("Строка|Колонка");

	
	Если СтруктураПараметров.СформироватьТолькоТаблицуОбласти Тогда
		ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
		
	Иначе 
		НаименованиеОбласти = ЗаполнениеОтчетности.ЗначениеРеквизита(СтруктураПараметров.ОбластьЗаполнения, "Наименование");
		
		Сообщение = НСтр("ru = 'Проверка области заполнения "" %1 "" правила заполнения "" %2 "" вида отчета "" %3 ""'");
		МакетОбъектПроверки.Параметры.Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Сообщение, НаименованиеОбласти, ПравилоНаименование, НаименованиеВидаОтчета);
		ТабличныйДокумент.Вывести(МакетОбъектПроверки);
		
		ВывестиПараметрыЗаполнения(ТабличныйДокумент, СтруктураПараметров);
		
	КонецЕсли;
	
	
	МакетРазделОбласть.Параметры.ОбъектПроверки = СтруктураПараметров.ОбластьЗаполнения;
	ТабличныйДокумент.Вывести(МакетРазделОбласть, 1, "Область", Истина);
	
	ОбработкаЗаполнения.мКартыДанных = КартыДанных;
	
	ТаблицаДанных = ОбработкаЗаполнения.ПолучитьТаблицуДанныхОбластиЗаполнения(СтруктураПараметров.ОбластьЗаполнения, ПравилоЗаполнения, СтруктураПараметров.ПараметрыЗаполнения, КартыДанных);
	
	ТекстСообщения = "";
	Если НЕ ОбработкаЗаполнения.ПрименитьМетодыДополнительнойОбработки(ТаблицаДанных, "ОбластьЗаполнения", ТаблицаМетодовДополнительнойОбработки, 
		ПравилоЗаполнения, СтруктураПараметров.ОбластьЗаполнения, ТекстСообщения) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;
	
	ВывестиДанныеОбласти(ТабличныйДокумент, ТаблицаДанных, МакетЗаголовокКолонка, МакетСтрокаКолонка);
	
	Если СтруктураПараметров.СформироватьТолькоТаблицуОбласти Тогда
		ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
		
	Иначе 
		ПрименитьОформлениеКТаблице(ТабличныйДокумент);
	
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура ЗаполнитьКэшируемыеДанные(СтруктураПараметров)
	Если СтруктураПараметров.КэшЗаполнен Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПравилоЗаполнения",СтруктураПараметров.ПравилоЗаполнения);
	Запрос.УстановитьПараметр("ОбластьЗаполнения",СтруктураПараметров.ОбластьЗаполнения);
	Запрос.УстановитьПараметр("ИсточникЗаполненияКэша",СтруктураПараметров.ИсточникЗаполненияКэша);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПравилаЗаполнения.Ссылка КАК ПравилоЗаполнения,
	|	ПравилаЗаполнения.Наименование КАК ПравилоНаименование,
	|	ПравилаЗаполнения.Владелец.Наименование КАК НаименованиеВидаОтчета
	|ИЗ
	|	Справочник.ПравилаЗаполнения КАК ПравилаЗаполнения
	|ГДЕ
	|	&ИсточникЗаполненияКэша = ""ПравилоЗаполнения""
	|	И ПравилаЗаполнения.Ссылка = &ПравилоЗаполнения
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОбластиЗаполнения.Владелец,
	|	ОбластиЗаполнения.Владелец.Наименование,
	|	ОбластиЗаполнения.Владелец.Владелец.Наименование
	|ИЗ
	|	Справочник.ОбластиЗаполнения КАК ОбластиЗаполнения
	|ГДЕ
	|	&ИсточникЗаполненияКэша = ""ОбластьЗаполнения""
	|	И ОбластиЗаполнения.Ссылка = &ОбластьЗаполнения";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		ВызватьИсключение НСтр("ru = 'Не удалось прочитать кэшируемые данные.'");
	КонецЕсли;
	ДанныеЗапроса = РезультатЗапроса.Выгрузить()[0];
	
	ЗаполнитьЗначенияСвойств(СтруктураПараметров.КэшируемыеДанные,ДанныеЗапроса,"ПравилоЗаполнения,ПравилоНаименование,НаименованиеВидаОтчета");
	
	
	ОбработкаЗаполнения = Обработки.ОбработкаДанныхОтчетности.Создать();
	
	ТаблицаМетодовДополнительнойОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(ДанныеЗапроса.ПравилоЗаполнения,,,Истина);
	КартыДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ДанныеЗапроса.ПравилоЗаполнения);	
	ТекстСообщения = "";
	Если НЕ ОбработкаЗаполнения.ПрименитьМетодыДополнительнойОбработки(КартыДанных, "КартыДанных", ТаблицаМетодовДополнительнойОбработки, ДанныеЗапроса.ПравилоЗаполнения, Неопределено, ТекстСообщения) Тогда
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	СтруктураПараметров.КэшируемыеДанные.ТаблицаМетодовДополнительнойОбработки = ТаблицаМетодовДополнительнойОбработки;
	СтруктураПараметров.КэшируемыеДанные.КартыДанных = КартыДанных;	
	
	СтруктураПараметров.КэшируемыеДанные.ОбработкаЗаполнения = ОбработкаЗаполнения;
	СтруктураПараметров.КэшируемыеДанные.МакетОтчета = Справочники.ПравилаЗаполнения.ПолучитьМакет("МакетОтчетаПроверки");
	
	СтруктураПараметров.КэшЗаполнен = Истина;
КонецПроцедуры	

Процедура ВывестиПараметрыЗаполнения(ТабличныйДокумент, СтруктураПараметров)
	
	Перем НачалоПериода;
	Перем КонецПериода;
	Перем ДополнительныйПериод1;
	Перем ДополнительныйПериод2;
	Перем Организация;
	Перем ИФО;
	Перем ДополнительныеПараметры;
	
	
	
	МакетОтчетаПроверки = СтруктураПараметров.КэшируемыеДанные.МакетОтчета;;
	
	ОбластьПараметрыЗаголовок = МакетОтчетаПроверки.ПолучитьОбласть("ПараметрыЗаголовок");
	ОбластьПараметрыСтрока = МакетОтчетаПроверки.ПолучитьОбласть("ПараметрыСтрока");
	ОбластьПараметрыПодвал = МакетОтчетаПроверки.ПолучитьОбласть("ПараметрыПодвал");
	
	ТабличныйДокумент.Вывести(ОбластьПараметрыЗаголовок);
	
	СтруктураПараметров.ПараметрыЗаполнения.Свойство("НачалоПериода", НачалоПериода);
	СтруктураПараметров.ПараметрыЗаполнения.Свойство("КонецПериода", КонецПериода);
	СтруктураПараметров.ПараметрыЗаполнения.Свойство("ДополнительныйПериод1", ДополнительныйПериод1);
	СтруктураПараметров.ПараметрыЗаполнения.Свойство("ДополнительныйПериод2", ДополнительныйПериод2);
	СтруктураПараметров.ПараметрыЗаполнения.Свойство("Организация", Организация);
	СтруктураПараметров.ПараметрыЗаполнения.Свойство("ИФО", ИФО);
	СтруктураПараметров.ПараметрыЗаполнения.Свойство("ДополнительныеПараметры", ДополнительныеПараметры);
	
	// Период отчета
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		
		ОбластьПараметрыСтрока.Параметры.ИмяПараметра = "НачалоПериода";
		
		Если ТипЗнч(НачалоПериода) = Тип("Граница") Тогда
			ТекНачалоПериода = НачалоПериода.Значение;
		Иначе
			ТекНачалоПериода = НачалоПериода;
		КонецЕсли;
		
		ОбластьПараметрыСтрока.Параметры.ЗначениеПараметра = ТекНачалоПериода;
		
		ТабличныйДокумент.Вывести(ОбластьПараметрыСтрока);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		
		ОбластьПараметрыСтрока.Параметры.ИмяПараметра = "КонецПериода";
		
		Если ТипЗнч(КонецПериода) = Тип("Граница") Тогда
			ТекКонецПериода = КонецПериода.Значение;
		Иначе
			ТекКонецПериода = КонецПериода;
		КонецЕсли;
		
		ОбластьПараметрыСтрока.Параметры.ЗначениеПараметра = ТекКонецПериода;
		
		ТабличныйДокумент.Вывести(ОбластьПараметрыСтрока);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныйПериод1) Тогда
			
		ОбластьПараметрыСтрока.Параметры.ИмяПараметра = "Доп. период №1";
		
		Если ТипЗнч(ДополнительныйПериод1) = Тип("Граница") Тогда
			ТекЗначение = ДополнительныйПериод1.Значение;
		Иначе
			ТекЗначение = ДополнительныйПериод1;
		КонецЕсли;
		
		ОбластьПараметрыСтрока.Параметры.ЗначениеПараметра = ТекЗначение;
				
		ТабличныйДокумент.Вывести(ОбластьПараметрыСтрока);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныйПериод2) Тогда
		
		ОбластьПараметрыСтрока.Параметры.ИмяПараметра = "Доп. период №2";
		
		Если ТипЗнч(ДополнительныйПериод2) = Тип("Граница") Тогда
			ТекЗначение = ДополнительныйПериод2.Значение;
		Иначе
			ТекЗначение = ДополнительныйПериод2;
		КонецЕсли;
		
		ОбластьПараметрыСтрока.Параметры.ЗначениеПараметра = ТекЗначение;
		
		ТабличныйДокумент.Вывести(ОбластьПараметрыСтрока);
		
	КонецЕсли;
	
	// Организация
	Если Организация <> Неопределено Тогда
		
		Если ТипЗнч(Организация) = Тип("Структура") Тогда
			ИмяПараметра = Строка(Организация.ЛевоеЗначение);
			ЗначениеПараметра = Строка(Организация.ПравоеЗначение);
		Иначе
			ИмяПараметра = "Организация";
			ЗначениеПараметра = Организация;
		КонецЕсли;
		
		ОбластьПараметрыСтрока.Параметры.ИмяПараметра = ИмяПараметра;
		ОбластьПараметрыСтрока.Параметры.ЗначениеПараметра = ЗначениеПараметра;
		
		ТабличныйДокумент.Вывести(ОбластьПараметрыСтрока);
		
	КонецЕсли;
	
	// ИФО
	Если ИФО <> Неопределено Тогда
		
		Если ТипЗнч(ИФО) = Тип("Структура") Тогда
			ИмяПараметра = Строка(ИФО.ЛевоеЗначение);
			ЗначениеПараметра = Строка(ИФО.ПравоеЗначение);
		Иначе
			ИмяПараметра = "ИФО";
			ЗначениеПараметра = ИФО;
		КонецЕсли;
		
		ОбластьПараметрыСтрока.Параметры.ИмяПараметра = ИмяПараметра;
		ОбластьПараметрыСтрока.Параметры.ЗначениеПараметра = ЗначениеПараметра;
		
		ТабличныйДокумент.Вывести(ОбластьПараметрыСтрока);
		
	КонецЕсли;
	
	// Дополнительные параметры
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		
		Для каждого ДополнительныйПараметр Из ДополнительныеПараметры Цикл
			
			ЗначениеДопПараметра = ДополнительныйПараметр.Значение;
			Значение = Неопределено;
			Если ТипЗнч(ЗначениеДопПараметра) = Тип("Структура") И ЗначениеДопПараметра.Свойство("ПравоеЗначение", Значение) Тогда
				ЗначениеДопПараметра = ДополнительныйПараметр.Значение.ПравоеЗначение;
			КонецЕсли;
			
			ОбластьПараметрыСтрока.Параметры.ИмяПараметра = ДополнительныйПараметр.Ключ;
			ОбластьПараметрыСтрока.Параметры.ЗначениеПараметра = ЗначениеДопПараметра;
			
			ТабличныйДокумент.Вывести(ОбластьПараметрыСтрока);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(ОбластьПараметрыПодвал);
	
	
КонецПроцедуры

Процедура ВывестиДанныеОбласти(ТабличныйДокумент, ТаблицаДанных, МакетЗаголовокКолонка, МакетСтрокаКолонка)
	
	Если ТипЗнч(ТаблицаДанных) = Тип("ТаблицаЗначений") Тогда
		
		// Вывод колонок
		Вывести = Истина;
		Для каждого Колонка Из ТаблицаДанных.Колонки Цикл
			
			МакетЗаголовокКолонка.Параметры.Значение = Колонка.Имя;
			Если Вывести Тогда
				ТабличныйДокумент.Вывести(МакетЗаголовокКолонка, 2, "Результат проверки", Истина);
				Вывести = Ложь;
			Иначе
				ТабличныйДокумент.Присоединить(МакетЗаголовокКолонка, 2, "Результат проверки", Истина);
			КонецЕсли;
			
		КонецЦикла;
		
		// Вывод строк
		Вывести = Истина;
		Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
			
			Для каждого Колонка Из ТаблицаДанных.Колонки Цикл
				
				МакетСтрокаКолонка.Параметры.Значение = СтрокаТаблицы[Колонка.Имя];
				Если Вывести Тогда
					ТабличныйДокумент.Вывести(МакетСтрокаКолонка, 2, "Результат проверки", Истина);
					Вывести = Ложь;
				Иначе
					ТабличныйДокумент.Присоединить(МакетСтрокаКолонка, 2, "Результат проверки", Истина);
				КонецЕсли;
				
			КонецЦикла;
			Вывести = Истина;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрименитьОформлениеКТаблице(ТабличныйДокумент)
	
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	
	ОбластьПараметрыПодвал = ТабличныйДокумент.Область("ПараметрыПодвал");
	
	ОбластьДанных = ТабличныйДокумент.Область(ОбластьПараметрыПодвал.Низ+1, 1, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы);
	ОбластьДанных.СоздатьФорматСтрок();
	
КонецПроцедуры

Функция ПроверитьУсловиеОбласти(Условие, СтруктураПараметров,СтруктураДопПараметров) Экспорт
	
	//Основная цель условия для выполнения области - определить до выполнения области, 
	//нужно ли будет результат данной области отражать в отчете.
	//В некоторых случаях область выполнять не нужно.
	//Поэтому определения условия следующий:
	//	- если при проверке условия получился результат = ЛОЖЬ, то в этом случае область не выполняется
	//  - если при проверке условия получился результат = ИСТИНА, либо ПОЛУЧИЛИ ИСКЛЮЧЕНИЕ из-за ошибки в выражении
	//		, то в этом случае область все равно выполняется
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА &Условие
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК УсловиеВыполнено";
				   
	Попытка		
		
		ДополнитьПараметрыЗапроса(Запрос,СтруктураПараметров);
		
		Если Запрос.Параметры.Свойство("ИФО") И Запрос.Параметры.ИФО <> Неопределено Тогда
			Запрос.Параметры.Вставить("ЕстьИФО",Истина);
		Иначе
			Запрос.Параметры.Вставить("ЕстьИФО",Ложь);
		КонецЕсли;
		
		Запрос.Параметры.Вставить("ТекущаяКонфигурация",ЗаполнениеОтчетности.ТекущаяКонфигурация());
		
		Для Каждого КлючИЗначение Из СтруктураДопПараметров Цикл
			Запрос.Параметры.Вставить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
		КонецЦикла;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&Условие",Условие);
		
		Результат = Запрос.Выполнить().Выбрать();
		Результат.Следующий();
		
		Возврат Результат.УсловиеВыполнено;
		
	Исключение
		Возврат Истина;
	КонецПопытки;
			
КонецФункции

Процедура ДополнитьПараметрыЗапроса(Запрос,ТекСтруктура)
	Для Каждого КлючИЗначение Из ТекСтруктура Цикл
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Структура") Тогда
			Если КлючИЗначение.Значение.Свойство("ПравоеЗначение")
				И КлючИЗначение.Значение.Свойство("СписокЗначений") Тогда
				Если КлючИЗначение.Значение.Свойство("Использование") 
					И КлючИЗначение.Значение.Использование = Истина Тогда 
					Запрос.УстановитьПараметр(КлючИЗначение.Ключ,КлючИЗначение.Значение.СписокЗначений);
				Иначе
					МассивТипов = Новый Массив;
					МассивТипов.Добавить(ТипЗнч(КлючИЗначение.Значение.ПравоеЗначение));
					ОпТипов = Новый ОписаниеТипов(МассивТипов);
					ПустоеЗначениеТипа = ОпТипов.ПривестиЗначение(Неопределено);
					Запрос.УстановитьПараметр(КлючИЗначение.Ключ,ПустоеЗначениеТипа);
				КонецЕсли;
			ИначеЕсли КлючИЗначение.Значение.Свойство("ПравоеЗначение") Тогда
				Если КлючИЗначение.Значение.Свойство("Использование") 
					И КлючИЗначение.Значение.Использование = Истина Тогда
					Запрос.УстановитьПараметр(КлючИЗначение.Ключ,КлючИЗначение.Значение.ПравоеЗначение);
				Иначе
					МассивТипов = Новый Массив;
					МассивТипов.Добавить(ТипЗнч(КлючИЗначение.Значение.ПравоеЗначение));
					ОпТипов = Новый ОписаниеТипов(МассивТипов);
					ПустоеЗначениеТипа = ОпТипов.ПривестиЗначение(Неопределено);
					Запрос.УстановитьПараметр(КлючИЗначение.Ключ,ПустоеЗначениеТипа);
				КонецЕсли;
			Иначе
				ДополнитьПараметрыЗапроса(Запрос,КлючИЗначение.Значение);
			КонецЕсли;
		Иначе
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ,КлючИЗначение.Значение);
		КонецЕсли;			
	КонецЦикла;	
КонецПроцедуры

