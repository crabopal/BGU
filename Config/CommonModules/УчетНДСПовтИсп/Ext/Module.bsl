Функция ПолучитьТаблицуПричинНалогообложения() Экспорт
	
	// Обрабатываемые данные:
	МакетНастроек		= Перечисления.ПричиныНалогообложенияНДС.ПолучитьМакет("Настройки");
	ОбластьИменаКолонок	= МакетНастроек.ПолучитьОбласть("Колонки|ИменаКолонок");
	ОбластьДанные		= МакетНастроек.ПолучитьОбласть("Колонки|Строки");
	
	// Возвращаемая таблица (пока пустая):
	ТЗ = Новый ТаблицаЗначений();
	ТипБулево	= Новый ОписаниеТипов("Булево");
	ТипСтрока	= Новый ОписаниеТипов("Строка");
	ТЗ.Колонки.Добавить("ПричинаНалогообложения",		Новый ОписаниеТипов("ПеречислениеСсылка.ПричиныНалогообложенияНДС"));
	ТЗ.Колонки.Добавить("НачислениеСразу",				ТипБулево);
	ТЗ.Колонки.Добавить("НачислениеВБудущем",			ТипБулево);
	ТЗ.Колонки.Добавить("ВычетСразу",					ТипБулево);
	ТЗ.Колонки.Добавить("ВычетВБудущем",				ТипБулево);
	ТЗ.Колонки.Добавить("РаспределениеВозможно",		ТипБулево);
	ТЗ.Колонки.Добавить("НалоговыйАгент",				ТипБулево);
	ТЗ.Колонки.Добавить("Аванс",						ТипБулево);
	ТЗ.Колонки.Добавить("ДляСчетаФактурыВыданного",		ТипБулево);
	ТЗ.Колонки.Добавить("ДляСчетаФактурыПолученного",	ТипБулево);
	ТЗ.Колонки.Добавить("КодВидаТовара",				ТипБулево);
	ТЗ.Колонки.Добавить("СчетРасчетов",					ТипБулево);
	ТЗ.Колонки.Добавить("Продавец",						ТипСтрока);
	ТЗ.Колонки.Добавить("Покупатель",					ТипСтрока);
	
	// Запоминаем последовательность колонок возвращаемой таблицы:
	ИменаКолонокТЗ = Новый Массив();
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		ИменаКолонокТЗ.Добавить(Колонка.Имя);
	КонецЦикла;
	
	// Определим соответствие в последовательностей колонок табличного документа
	// и заполняемой таблицы:
	СоответствующиеКолонкиТЗ = Новый Соответствие();
	хМакс = ОбластьИменаКолонок.ШиринаТаблицы;
	Для х = 1 По хМакс Цикл
		ИмяКолонки = ОбластьИменаКолонок.Область(1, х, 1, х).Текст;
		Если ПустаяСтрока(ИмяКолонки) Тогда
			Продолжить;
		КонецЕсли;
		
		// Такая колонка есть в ТЗ?
		инд = ИменаКолонокТЗ.Найти(ИмяКолонки);
		Если НЕ инд = Неопределено Тогда
			СоответствующиеКолонкиТЗ.Вставить(х, ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	
	// Добавляем строки:
	уМакс = ОбластьДанные.ВысотаТаблицы;
	хМакс = ОбластьДанные.ШиринаСтраницы;
	Для у = 1 По уМакс Цикл // по строкам
		СтрокаТЗ = ТЗ.Добавить();
		
		Для х = 1 По хМакс Цикл // по столбцам
			
			ИмяКолонкиТЗ = СоответствующиеКолонкиТЗ.Получить(х);
			
			Если ИмяКолонкиТЗ = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТекстЯчейки = ОбластьДанные.Область(у, х, у, х).Текст;
			
			Если ИмяКолонкиТЗ = "ПричинаНалогообложения" Тогда
				Попытка
					Значение = Перечисления.ПричиныНалогообложенияНДС[ТекстЯчейки];
				Исключение
					ТекстСообщения = СтрШаблон(
						НСтр("ru='В макете настроек перечисления ПричиныНалогообложенияНДС указано несуществующее значение ""%1""'"),
						ТекстЯчейки);
						
					ВызватьИсключение ТекстСообщения;
				КонецПопытки;
				
			ИначеЕсли ИмяКолонкиТЗ = "Продавец" ИЛИ ИмяКолонкиТЗ = "Покупатель" Тогда
				Значение = ТекстЯчейки;
				
			Иначе
				ТекстЯчейки = ВРег(СокрЛП(ТекстЯчейки));
				Если ТекстЯчейки = "ИСТИНА"
					ИЛИ ТекстЯчейки = "ДА"
					ИЛИ ТекстЯчейки = "+" Тогда
					Значение = Истина;
				Иначе
					Значение = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаТЗ[ИмяКолонкиТЗ] = Значение;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции

