Функция ИнструкцииУчета_ПолучитьОбщуюТаблицуНастроек() Экспорт
	
	ТипСтрока			= Новый ОписаниеТипов("Строка");
	ТипДата				= Новый ОписаниеТипов("Дата");
	ТипФискСтруктура	= Новый ОписаниеТипов("ФиксированнаяСтруктура");
	
	// Возвращаемая таблица
	ТЗ = Новый ТаблицаЗначений();
	ТЗ.Колонки.Добавить("Идентификатор",		ТипСтрока);
	ТЗ.Колонки.Добавить("Представление",		ТипСтрока);
	ТЗ.Колонки.Добавить("ДатаНачалаПрименения",	ТипДата);
	ТЗ.Колонки.Добавить("Начисление",			ТипФискСтруктура);
	ТЗ.Колонки.Добавить("Вычет",				ТипФискСтруктура);
	ТЗ.Колонки.Добавить("РасчетыПоНалогу",		ТипФискСтруктура);
	
	// Инструкция 157н
	ИнструкцииУчета_Добавить157н(ТЗ);
	
	// Инструкция 157н (приказ 89н)
	ИнструкцииУчета_Добавить89н(ТЗ);
	
	// Инструкция 157н (приказ 209н)
	ИнструкцииУчета_Добавить209н(ТЗ);
	
	ТЗ.Сортировать("ДатаНачалаПрименения");
	
	Возврат ТЗ;
	
КонецФункции

Функция ИнструкцииУчета_ПолучитьПустуюСтруктуруСтроки() Экспорт
	
	Результат = Новый Структура();
	
	ОбщаяТаблицаНастроек = УчетНДСПовтИсп.ИнструкцииУчета_ПолучитьОбщуюТаблицуНастроек();
	
	Для Каждого КолонкаТаблицы Из ОбщаяТаблицаНастроек.Колонки Цикл
		Результат.Вставить(КолонкаТаблицы.Имя);
	КонецЦикла;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Процедура ИнструкцииУчета_Добавить157н(ТЗ)
	
