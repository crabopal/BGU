	МассивСтавок.Добавить(Перечисления.СтавкиНДС.НДС10_110);
	МассивСтавок.Добавить(Перечисления.СтавкиНДС.НДС18);
	МассивСтавок.Добавить(Перечисления.СтавкиНДС.НДС18_118);
	МассивСтавок.Добавить(Перечисления.СтавкиНДС.НДС20);
	МассивСтавок.Добавить(Перечисления.СтавкиНДС.НДС20_120);
	
	Возврат МассивСтавок;
КонецФункции	

// Устарела. Не используется.
// Возвращает множители для расчета суммы НДС (исходя из базы и ставки).
//
// Возврат:
//	Соответствие вида СтавкаНДС (ссылка) - Множители (соответствие),
//		где Множители - тоже соответствие вида СуммаВключаетНДС (булево) - Множитель (число)
//
//	Для получения конкретного множителя необходимо к результату этой функции применить код:
//		.Получить(СтавкаНДС).Получить(СуммаВключаетНДС);
//
// Пример использования
// --------------------
//	// Кэшируем все множители:
//	МножителиСтавокНДС = УчетНДСПовтИсп.ПолучитьМножителиВсехСтавокДляРасчетаСуммыНДС();
//	
//	// Вариант 1. Сумма включает НДС:
//	СуммаВключаетНДС = Истина;
//	// Вариант 2. Сумма не включает НДС:
//	СуммаВключаетНДС = Ложь;
//	
//	// Получаем множитель для текущих условий:
//	Множитель = МножителиСтавокНДС.Получить(СтавкаНДС).Получить(СуммаВключаетНДС);
//	
//	СуммаНДС = Сумма * Множитель;
Функция ПолучитьМножителиВсехСтавокДляРасчетаСуммыНДС() Экспорт
	
	Результат = Новый Соответствие();
	
	Множители = Новый Соответствие();
	Множители.Вставить(Ложь,	0);	// Сумма не включает НДС
	Множители.Вставить(Истина,	0);	// Сумма включает НДС
	Результат.Вставить(Перечисления.СтавкиНДС.БезНДС,			Множители);
	Результат.Вставить(Перечисления.СтавкиНДС.НДС0,				Множители);
	Результат.Вставить(Перечисления.СтавкиНДС.ПустаяСсылка(),	Множители);
	
	Множители = Новый Соответствие();
	Множители.Вставить(Ложь,	0.1);		// Сумма не включает НДС
	Множители.Вставить(Истина,	10/110);	// Сумма включает НДС
	Результат.Вставить(Перечисления.СтавкиНДС.НДС10,		Множители);
	Результат.Вставить(Перечисления.СтавкиНДС.НДС10_110,	Множители);
	
	Множители = Новый Соответствие();
	Множители.Вставить(Ложь,	0.18);		// Сумма не включает НДС
	Множители.Вставить(Истина,	18/118);	// Сумма включает НДС
	Результат.Вставить(Перечисления.СтавкиНДС.НДС18,		Множители);
	Результат.Вставить(Перечисления.СтавкиНДС.НДС18_118,	Множители);
	
	Множители = Новый Соответствие();
	Множители.Вставить(Ложь,	0.2);		// Сумма не включает НДС
	Множители.Вставить(Истина,	20/120);	// Сумма включает НДС
	Результат.Вставить(Перечисления.СтавкиНДС.НДС20,		Множители);
	Результат.Вставить(Перечисления.СтавкиНДС.НДС20_120,	Множители);
	
	Множители = Новый Соответствие();
	Множители.Вставить(Ложь,	0.05);		// Сумма не включает НДС
	Множители.Вставить(Истина,	5/105);		// Сумма включает НДС
	Результат.Вставить(Перечисления.СтавкиНДС.НДС5,		Множители);
	Результат.Вставить(Перечисления.СтавкиНДС.НДС5_105,	Множители);
	
	Множители = Новый Соответствие();
	Множители.Вставить(Ложь,	0.07);		// Сумма не включает НДС
	Множители.Вставить(Истина,	7/107);		// Сумма включает НДС
	Результат.Вставить(Перечисления.СтавкиНДС.НДС7,		Множители);
	Результат.Вставить(Перечисления.СтавкиНДС.НДС7_107,	Множители);
	
	Возврат Результат;
	
КонецФункции

