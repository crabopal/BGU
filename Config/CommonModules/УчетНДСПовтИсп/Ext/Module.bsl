Функция ПродавецПокупатель(ПричинаНалогообложения) Экспорт
	
	Поиск = Новый Структура("ПричинаНалогообложения", ПричинаНалогообложения);
	
	МассивСтрок = УчетНДСПовтИсп.ПолучитьТаблицуПричинНалогообложения().НайтиСтроки(Поиск);
	
	Результат = Новый Структура("Продавец, Покупатель");
	
	Если МассивСтрок.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(Результат, МассивСтрок[0]);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

