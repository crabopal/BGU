
#Область ПрограммныйИнтерфейс

Процедура СформироватьТокенНаКлиенте(Оповещение, Организация) Экспорт
	
	НастройкаПодключения = Новый Структура("Организация", Организация);
	
	Если Не ЭлектроннаяПодписьКлиент.СоздаватьЭлектронныеПодписиНаСервере() Тогда
		
		ДанныеТокена = ИнтеграцияФРМОВызовСервера.ДанныеТокенаДляКлиента(Организация);
		
		Если ДанныеТокена <> Неопределено Тогда
			
			ПараметрыОповещения = Новый Структура("Оповещение,НастройкаПодключения,ДанныеТокена", Оповещение, НастройкаПодключения, ДанныеТокена);
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияМенеджераКриптографии", ЭтотОбъект, ПараметрыОповещения);
			ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(ОписаниеОповещения, "Подписание", Истина, ДанныеТокена.Программа);
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(Оповещение, НастройкаПодключения);
	
КонецПроцедуры

Функция ВыполнятьОбменНаКлиенте(Организация) Экспорт
	
	#Если ВебКлиент Тогда
		Возврат Ложь;
	#КонецЕсли
	
	Возврат ИнтеграцияФРМОВызовСервера.ВыполнятьОбменНаКлиенте(Организация);
	
КонецФункции

Процедура ПодключитьИнтернетПоддержку(ТекстСообщения, ОписаниеОповещения) Экспорт
	
	Если Не ИнтернетПоддержкаПользователейКлиент.ДоступноПодключениеИнтернетПоддержки() Тогда
		ПоказатьПредупреждение(, ТекстСообщения + Символы.ПС + НСтр("ru = 'Обратитесь к администратору.'"));
		Возврат;
	КонецЕсли;
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, "Подключить");
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
	
	Параметры = Новый Структура("Оповещение", ОписаниеОповещения);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриПодключенииИнтернетПоддержки", ЭтотОбъект, Параметры);
	ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, Кнопки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПослеСозданияМенеджераКриптографии(МенеджерКриптографии, Параметры) Экспорт
	
	Если ТипЗнч(МенеджерКриптографии) <> Тип("МенеджерКриптографии") Тогда
		Возврат;
	КонецЕсли;
	
	Токен = ИнтеграцияФРМОКлиентСервер.ТокенЗапроса(Параметры.ДанныеТокена, МенеджерКриптографии);
	
	НастройкаПодключения = Параметры.НастройкаПодключения;
	НастройкаПодключения.Вставить("Токен", Токен);
	
	ВыполнитьОбработкуОповещения(Параметры.Оповещение, НастройкаПодключения);
	
КонецПроцедуры

Процедура ПриПодключенииИнтернетПоддержки(РезультатВопроса, Параметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПодключенияИнтернетПоддержки", ЭтотОбъект, Параметры);
	ИнтернетПоддержкаПользователейКлиент.ПодключитьИнтернетПоддержкуПользователей(ОписаниеОповещения, ЭтотОбъект);
	
КонецПроцедуры

Процедура ПослеПодключенияИнтернетПоддержки(Результат, Параметры) Экспорт
	
	Если Не (ТипЗнч(Результат) = Тип("Структура")
		И ЗначениеЗаполнено(Результат.Логин)) Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(Параметры.Оповещение);
	
КонецПроцедуры

Функция КлючЗаписиМедицинскоеОборудованиеФРМО(Организация, ОсновноеСредство, ИнвентарныйНомер) Экспорт
	
	Ключи = Новый Структура("Организация,ОсновноеСредство,ИнвентарныйНомер",
		Организация, ОсновноеСредство, ИнвентарныйНомер);
	мКлючи = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ключи);
	КлючЗаписи = Новый("РегистрСведенийКлючЗаписи.МедицинскоеОборудованиеФРМО", мКлючи);
	
	Возврат КлючЗаписи;
	
КонецФункции

#КонецОбласти
