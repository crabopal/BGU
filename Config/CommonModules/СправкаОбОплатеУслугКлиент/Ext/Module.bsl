#Область СлужебныйПрограммныйИнтерфейс

#Область Печать

Функция ВыполнитьКомандуПечати(ОписаниеКоманды) Экспорт
	
	Если ОписаниеКоманды.Идентификатор = "СправкаОбОплатеУслуг" Тогда 
		РезультатПечати = СправкаОбОплатеУслугВызовСервера.ПечатьСправкиБРО(ОписаниеКоманды.ОбъектыПечати[0]);
		Если ТипЗнч(РезультатПечати) = Тип("Структура") Тогда 
			
			Если ОписаниеКоманды.Форма.ИмяФормы	= "Документ.СправкаОбОплатеУслугДляНалоговогоВычета.Форма.ФормаДокумента" 
				ИЛИ ОписаниеКоманды.Форма.ИмяФормы	= "Документ.СправкаОбОплатеУслугДляНалоговогоВычета.Форма.ФормаСписка" Тогда
				
				ОписаниеКоманды.Форма.СтруктураРеквизитовФормы = Новый Структура;
				ОписаниеКоманды.Форма.СтруктураРеквизитовФормы.Вставить("мСохраненныйДок",
					РезультатПечати.ДанныеПечатиУведомления.УведомленияДляПечати);
			КонецЕсли;
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОписаниеКоманды.Форма, "СтруктураРеквизитовФормы")
				И ТипЗнч(ОписаниеКоманды.Форма["СтруктураРеквизитовФормы"]) = Тип("Структура") Тогда
			
				ОписаниеКоманды.Форма.СтруктураРеквизитовФормы.Вставить("ПоследнийЦиклОбмена",
					РезультатПечати.ДанныеПечатиУведомления.ПоследнийЦиклОбмена);
			КонецЕсли;
			
			РегламентированнаяОтчетностьКлиент.ОткрытьФормуПредварительногоПросмотра(
				ОписаниеКоманды.Форма, "Открыть", Ложь, РезультатПечати.СписокПечатаемыхЛистов, РезультатПечати.ДополнительныеПараметры);
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не найден проведенный журнал справок содержащий данную справку'"));
		КонецЕсли;
	ИначеЕсли ОписаниеКоманды.Идентификатор = "ЖурналСправокОбОплатеУслуг" Тогда 
		
		ДанныеПечатиУведомления = СправкаОбОплатеУслугВызовСервера.ДанныеПечатиУведомления(ОписаниеКоманды.ОбъектыПечати[0]);
		
		Если ОписаниеКоманды.Форма.ИмяФормы	= "Документ.ЖурналСправокОбОплатеУслуг.Форма.ФормаСписка"
			И ЗначениеЗаполнено(ДанныеПечатиУведомления.ПоследнийЦиклОбмена) Тогда
			ОписаниеКоманды.Форма.СтруктураРеквизитовФормы = Новый Структура;
			ОписаниеКоманды.Форма.СтруктураРеквизитовФормы.Вставить("мСохраненныйДок", ДанныеПечатиУведомления.УведомленияДляПечати);
		КонецЕсли;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОписаниеКоманды.Форма, "СтруктураРеквизитовФормы")
			И ТипЗнч(ОписаниеКоманды.Форма["СтруктураРеквизитовФормы"]) = Тип("Структура") Тогда
			
			ОписаниеКоманды.Форма.СтруктураРеквизитовФормы.Вставить("ПоследнийЦиклОбмена",
				ДанныеПечатиУведомления.ПоследнийЦиклОбмена);
			
		КонецЕсли;
		
		РегламентированнаяОтчетностьКлиент.ОткрытьФормуПредварительногоПросмотра(ОписаниеКоманды.Форма, , Ложь, 
			ДанныеПечатиУведомления.СписокПечатаемыхЛистов, ДанныеПечатиУведомления.ДополнительныеПараметры);
		
	КонецЕсли;
КонецФункции

Функция ВыполнитьКомандуПечатиPDF417(ОписаниеКоманды) Экспорт
	ОписаниеКоманды.Форма.ПоказатьСДвухмернымШтрихкодомPDF417();
КонецФункции

#КонецОбласти

Процедура ПередОткрытиемФормыУведомления(Организация, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

Процедура ПриВыбореВидаУведомления(Форма, ПараметрыУведомления) Экспорт
	
	ЗначенияЗаполнения = Новый Структура("Организация", ПараметрыУведомления.Организация);
	ПараметрыУведомления.Вставить("ЗначенияЗаполнения",
		ЗначенияЗаполнения);
	ПараметрыУведомления.Вставить("ВидУведомления",
		ПараметрыУведомления.ВидУведомления);
		
	ИмяОбъекта = "";
	Если ПараметрыУведомления.ВидУведомления = ПредопределенноеЗначение("Перечисление.ВидыУведомленийОСпецрежимахНалогообложения.ОплатаОбразовательныхУслуг") 
		ИЛИ ПараметрыУведомления.ВидУведомления = ПредопределенноеЗначение("Перечисление.ВидыУведомленийОСпецрежимахНалогообложения.ОплатаМедицинскихУслуг") 
		ИЛИ ПараметрыУведомления.ВидУведомления = ПредопределенноеЗначение("Перечисление.ВидыУведомленийОСпецрежимахНалогообложения.ОплатаФизкультурноОздоровительныхУслуг") Тогда
		ИмяОбъекта = "ЖурналСправокОбОплатеУслуг";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяОбъекта) Тогда
		ОткрытьФорму("Документ." + ИмяОбъекта + ".Форма.ФормаСозданияЖурнала",
			ПараметрыУведомления,
			Форма);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
