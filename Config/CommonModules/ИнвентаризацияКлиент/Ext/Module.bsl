Функция ЗначенияВОдномДиапазоне(Дата1, Дата2, Диапазоны)
	
	// Анализируемый диапазон дат предварительно должен быть упорядочен по возрастанию
	
	Результат = Истина;
	
	Для Каждого НачалоДиапазона Из Диапазоны Цикл
		
		Если Дата1 < НачалоДиапазона И Дата2 < НачалоДиапазона Тогда
			Результат = Истина;
			Прервать;
			
		ИначеЕсли Дата1 >= НачалоДиапазона И Дата2 >= НачалоДиапазона Тогда
			Продолжить;
			
		Иначе
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОрганизациюДату(Форма, Отказ)
	
	Отказ = Ложь;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Объект, "ДатаИнвентаризации") Тогда
		ИмяРеквизитаДата = "ДатаИнвентаризации";
	Иначе
		ИмяРеквизитаДата = "Дата";
	КонецЕсли;
	
	Организация	= Форма.Объект.Организация;
	Дата		= Форма.Объект[ИмяРеквизитаДата];
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Для продолжения необходимо указать организацию'"),
			Форма.Объект.Ссылка,
			"Объект.Организация");
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru='Для продолжения необходимо указать дату проведения инвентаризации'"),
			Форма.Объект.Ссылка,
			"Объект." + ИмяРеквизитаДата);
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("Организация",	Организация);
	Результат.Вставить("Дата",			Дата);
	
	Возврат Результат;
	
КонецФункции

#Область ИнвентаризационныеОписи61н

Процедура ПроверитьИСоздатьДокументРасписки(ФормаДокументаОписи, ДополнительноПроверяемыеПоляПередСозданиемРасписки)
	
	Если ФормаДокументаОписи.Объект.Ссылка.Пустая() Или ФормаДокументаОписи.Модифицированность Тогда
		ТекстВопроса = НСтр("ru = 'Перед созданием расписки данные будут записаны. Продолжить?'");
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Записать и продолжить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ФормаДокументаОписи", ФормаДокументаОписи);
		ДополнительныеПараметры.Вставить("ДополнительноПроверяемыеПоляПередСозданиемРасписки",
			ДополнительноПроверяемыеПоляПередСозданиемРасписки);
		
		Обработчик = Новый ОписаниеОповещения("ПриНажатииНадписиРаспискаВыбор", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(Обработчик, ТекстВопроса, Кнопки);
		
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ПроверитьЗаполнениеОписиПередСозданиемРасписки(ФормаДокументаОписи, ДополнительноПроверяемыеПоляПередСозданиемРасписки, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьДокументРасписки(ФормаДокументаОписи);
	
КонецПроцедуры

Процедура ПриНажатииНадписиРаспискаВыбор(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ФормаДокументаОписи = ДополнительныеПараметры.ФормаДокументаОписи;
	
	ДополнительноПроверяемыеПоляПередСозданиемРасписки = ДополнительныеПараметры.ДополнительноПроверяемыеПоляПередСозданиемРасписки;
	
	ФормаДокументаОписи.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
	
	Отказ = Ложь;
	
	ПроверитьЗаполнениеОписиПередСозданиемРасписки(ФормаДокументаОписи, ДополнительноПроверяемыеПоляПередСозданиемРасписки, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьДокументРасписки(ФормаДокументаОписи);
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеОписиПередСозданиемРасписки(ФормаДокументаОписи, ДополнительноПроверяемыеПоляПередСозданиемРасписки, Отказ)
	
	ОбъектОписи = ФормаДокументаОписи.Объект;
	
	СтрокаТаблицыНастроек = ФормаДокументаОписи.ДанныеПанелиРасписки.СтрокаТаблицыНастроек;
	
	ОписаниеОписи = ФормаДокументаОписи.ДанныеПанелиРасписки.ОписаниеОписиИзТаблицыНастроекЗаполненияОписейПоРешению;
	
	Если Не ЗначениеЗаполнено(ОбъектОписи.Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", , НСтр("ru='Организация'")),
			ОбъектОписи.Ссылка, "Организация", "Объект", Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектОписи[СтрокаТаблицыНастроек.ИмяРеквизитаСотрудникДляРасписки]) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", , СтрокаТаблицыНастроек.СинонимРеквизитаСотрудникДляРасписки),
			ОбъектОписи.Ссылка, СтрокаТаблицыНастроек.ИмяРеквизитаСотрудникДляРасписки, "Объект", Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектОписи.РешениеОПроведенииИнвентаризации) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", , НСтр("ru='Решение о проведении инвентаризации'")),
			ОбъектОписи.Ссылка, "РешениеОПроведенииИнвентаризации", "Объект", Отказ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектОписи.РешениеОПроведенииИнвентаризации) Тогда
		Если Не ЗначениеЗаполнено(ОбъектОписи.ДатаНачала) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", , НСтр("ru='Дата начала инвентаризации'")),
				ОбъектОписи.Ссылка, "ДатаНачала", "Объект", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОбъектОписи.ДатаОкончания) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", , НСтр("ru='Дата окончания инвентаризации'")),
				ОбъектОписи.Ссылка, "ДатаОкончания", "Объект", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОбъектОписи.ДатаИнвентаризации) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", , НСтр("ru='Дата инвентаризации'")),
				ОбъектОписи.Ссылка, "ДатаИнвентаризации", "Объект", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОбъектОписи.Комиссия) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", , НСтр("ru='Комиссия'")),
				ОбъектОписи.Ссылка, "Комиссия", "Объект", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОбъектОписи.ОтветственныйИсполнитель) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", , НСтр("ru='Ответственный исполнитель инв. комиссии'")),
				ОбъектОписи.Ссылка, "ОтветственныйИсполнитель", "Объект", Отказ);
		КонецЕсли;
		
		Если ОписаниеОписи.ОписаниеРеквизитаСчет.РасположенВШапке Тогда
			ИмяПоля = ОписаниеОписи.ОписаниеРеквизитаСчет.ИмяПоля;
			
			Если Не ЗначениеЗаполнено(ОбъектОписи[ИмяПоля]) Тогда
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаДокументаОписи.Элементы, "ПредставлениеСчета") Тогда
					Поле = "ПредставлениеСчета";
					ПутьКДанным = "";
				Иначе
					Поле = ИмяПоля;
					ПутьКДанным = "Объект";
				КонецЕсли;
				
				ОбщегоНазначенияКлиент.СообщитьПользователю(
					ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле",, НСтр("ru='Счет'")),
					ОбъектОписи.Ссылка, Поле, ПутьКДанным, Отказ);
			КонецЕсли;
			
		ИначеЕсли ОписаниеОписи.ОписаниеРеквизитаСчет.РасположенВТабличнойЧасти Тогда
			ИмяТабличнойЧасти = ОписаниеОписи.ОписаниеРеквизитаСчет.ИмяТабличнойЧасти;
			
			Если ОбъектОписи[ИмяТабличнойЧасти].Количество() = 0 Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(
					НСтр("ru='Не заполнен список счетов инвентаризации'"),
					ОбъектОписи.Ссылка, ИмяТабличнойЧасти, "Объект", Отказ);
			КонецЕсли;
		КонецЕсли;
		
		Если ОписаниеОписи.ОписаниеРеквизитаМестоИнвентаризации.РасположенВШапке Тогда
			ИмяПоля = ОписаниеОписи.ОписаниеРеквизитаМестоИнвентаризации.ИмяПоля;
			
			Если Не ЗначениеЗаполнено(ОбъектОписи[ИмяПоля]) Тогда
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаДокументаОписи.Элементы, "ПредставлениеМестаПроведения") Тогда
					Поле = "ПредставлениеМестаПроведения";
					ПутьКДанным = "";
				Иначе
					Поле = ИмяПоля;
					ПутьКДанным = "Объект";
				КонецЕсли;
				
				ОбщегоНазначенияКлиент.СообщитьПользователю(
					ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле",, НСтр("ru='Место проведения инвентаризации'")),
					ОбъектОписи.Ссылка, Поле, ПутьКДанным, Отказ);
			КонецЕсли;
			
		ИначеЕсли ОписаниеОписи.ОписаниеРеквизитаМестоИнвентаризации.РасположенВТабличнойЧасти Тогда
			ИмяТабличнойЧасти = ОписаниеОписи.ОписаниеРеквизитаМестоИнвентаризации.ИмяТабличнойЧасти;
			
			Если ОбъектОписи[ИмяТабличнойЧасти].Количество() = 0 Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(
					НСтр("ru='Не заполнен список мест проведения инвентаризации'"),
					ОбъектОписи.Ссылка, ИмяТабличнойЧасти, "Объект", Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ДополнительноПроверяемыеПоляПередСозданиемРасписки) = Тип("Структура") Тогда
		Для Каждого Элемент Из ДополнительноПроверяемыеПоляПередСозданиемРасписки Цикл
			ИмяПоля = Элемент.Ключ;
			СинонимПоля = Элемент.Значение;
			
			Если Не ЗначениеЗаполнено(ОбъектОписи[ИмяПоля]) Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(
					ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле",, СинонимПоля),
					ОбъектОписи.Ссылка, ИмяПоля, "Объект", Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// 0510465

Процедура ОбновитьПоказателиВСтроке0510465(ВидДокумента, ТекДанные, ПостфиксИмени, ОбозначениеИзмененногоПоля, ПараметрыРазбивкиСтроки = Неопределено, РассчитыватьЦену = Ложь)
	
	ЭтоРазбивкаСтроки = (ПараметрыРазбивкиСтроки <> Неопределено);
	
	ЭтоБСО				= (ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовСтрогойОтчетности.БСО"));
	ЭтоДенежныйДокумент	= (ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы"));
	
	ИмяПоляНомерНачальный	= "НачальныйНомер" + ПостфиксИмени;
	ИмяПоляНомерКонечный	= "КонечныйНомер" + ПостфиксИмени;
	ИмяПоляЦена				= "Цена";
	ИмяПоляКоличество		= "Количество" + ПостфиксИмени;
	ИмяПоляСумма			= "Сумма" + ПостфиксИмени;
	
	// Значения полей текущей строки до начала настройки
	НомерНач	= ТекДанные[ИмяПоляНомерНачальный];
	НомерКон	= ТекДанные[ИмяПоляНомерКонечный];
	Цена		= ТекДанные[ИмяПоляЦена];
	Количество	= ТекДанные[ИмяПоляКоличество];
	Сумма		= ТекДанные[ИмяПоляСумма];
	
	РассчитатьСумму = (ОбозначениеИзмененногоПоля <> "Сумма");
	РассчитатьЦену = РассчитыватьЦену И (ОбозначениеИзмененногоПоля = "Сумма") И ПостфиксИмени = "";
	
	// При разбивке строки ограничиваем вводимые значения.
	Если ЭтоРазбивкаСтроки Тогда
		Если ОбозначениеИзмененногоПоля = "Количество" Тогда
			РазбиваемоеЗначение = ПараметрыРазбивкиСтроки.Количество;
			
			Если Количество > РазбиваемоеЗначение Тогда
				Количество = РазбиваемоеЗначение;
			КонецЕсли;
			
		ИначеЕсли ОбозначениеИзмененногоПоля = "Сумма" Тогда
			РазбиваемоеЗначение = ПараметрыРазбивкиСтроки.Сумма;
			
			Если Сумма > РазбиваемоеЗначение Тогда
				Сумма = РазбиваемоеЗначение;
			КонецЕсли;
			
		ИначеЕсли ОбозначениеИзмененногоПоля = "НомерНач" Тогда
			МинимальныйНомерБСО		= ПараметрыРазбивкиСтроки.МинимальныйНомерБСО;
			МаксимальныйНомерБСО	= ПараметрыРазбивкиСтроки.МаксимальныйНомерБСО;
			
			Если ЗначениеЗаполнено(НомерНач) И НомерНач < МинимальныйНомерБСО	Тогда
				НомерНач = МинимальныйНомерБСО;
			ИначеЕсли ЗначениеЗаполнено(НомерНач) И НомерНач > МаксимальныйНомерБСО Тогда
				НомерНач = МаксимальныйНомерБСО;
			КонецЕсли;
			
		ИначеЕсли ОбозначениеИзмененногоПоля = "НомерКон" Тогда
			МинимальныйНомерБСО		= ПараметрыРазбивкиСтроки.МинимальныйНомерБСО;
			МаксимальныйНомерБСО	= ПараметрыРазбивкиСтроки.МаксимальныйНомерБСО;
			
			Если ЗначениеЗаполнено(НомерКон) И НомерКон < МинимальныйНомерБСО	Тогда
				НомерКон = МинимальныйНомерБСО;
			ИначеЕсли ЗначениеЗаполнено(НомерКон) И НомерКон > МаксимальныйНомерБСО Тогда
				НомерКон = МаксимальныйНомерБСО;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Новые значения полей, устанавливаемые в результате настройки
	НовНомерНач		= НомерНач;
	НовНомерКон		= НомерКон;
	НовКоличество	= Количество;
	НовСумма		= Сумма;
	
	Если ЭтоБСО Тогда
		Если ОбозначениеИзмененногоПоля = "Количество" Тогда
			Если Количество = 0 Тогда
				// Очищаем весь диапазон номеров.
				НовНомерНач = 0;
				НовНомерКон = 0;
			Иначе
				// Количество указано
				Если НомерНач > 0 Тогда
					НовНомерКон = НомерНач + Количество - 1;
					
				ИначеЕсли НомерКон > 0 И НомерНач = 0 Тогда
					НовНомерНач = НомерКон - Количество + 1;
					Если НовНомерНач < 0 Тогда
						НовНомерНач = 0;
					КонецЕсли;
					
					НовКоличество = НовНомерКон - НовНомерНач + 1;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ОбозначениеИзмененногоПоля = "НомерНач" Тогда
			Если НовНомерНач = 0 Тогда
				// Очищаем весь диапазон номеров.
				НовНомерКон = 0;
				НовКоличество = 0;
				
			Иначе
				Если НовНомерКон = 0 Тогда
					// Создаем новый диапазон номеров.
					НовНомерКон = ?(НовКоличество = 0, НовНомерНач, НовНомерНач + НовКоличество - 1);
					
				ИначеЕсли НовНомерНач > НовНомерКон И ЗначениеЗаполнено(НовНомерКон) Тогда
					НовНомерНач = НовНомерКон;
				КонецЕсли;
				
				НовКоличество = НовНомерКон - НовНомерНач + 1;
			КонецЕсли;
			
		ИначеЕсли ОбозначениеИзмененногоПоля = "НомерКон" Тогда
			Если НовНомерКон = 0 Тогда
				// Очищаем весь диапазон номеров.
				НовНомерНач = 0;
				НовКоличество = 0;
				
			Иначе
				Если НовНомерНач = 0 Тогда
					// Создаем новый диапазон номеров.
					НовНомерНач = ?(НовКоличество = 0, НовНомерКон, НовНомерКон - НовКоличество + 1);
					
				ИначеЕсли НовНомерКон < НовНомерНач Тогда
					НовНомерКон = НовНомерНач;
				КонецЕсли;
				
				НовКоличество = НовНомерКон - НовНомерНач + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоРазбивкаСтроки Тогда
		РазбиваемоеКоличество	= ПараметрыРазбивкиСтроки.Количество;
		РазбиваемаяСумма		= ПараметрыРазбивкиСтроки.Сумма;
		
		Если ПараметрыРазбивкиСтроки.РедактируетсяКоличество И НовКоличество = РазбиваемоеКоличество Тогда
			// Повторяем сумму из исходной строки.
			// Рассчитывать сумму по цене и количеству не нужно,
			// т.к. возможно получение значения, отличного от суммы в исходной строке.
			НовСумма = РазбиваемаяСумма;
			
			РассчитатьСумму = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если РассчитатьСумму Тогда
		НовСумма = НовКоличество * Цена;
	КонецЕсли;
	
	Если РассчитатьЦену И НовКоличество <> 0 Тогда
		НовЦена = НовСумма / НовКоличество;
		
		ТекДанные[ИмяПоляЦена] = НовЦена;
	КонецЕсли;
	
	ТекДанные[ИмяПоляНомерНачальный]	= НовНомерНач;
	ТекДанные[ИмяПоляНомерКонечный]		= НовНомерКон;
	ТекДанные[ИмяПоляКоличество]		= НовКоличество;
	ТекДанные[ИмяПоляСумма]				= НовСумма;
	
	Если ЭтоБСО И ИнвентаризацияКлиентСервер.ИспользоватьПредставленияНомеровБСО() Тогда
		ИнвентаризацияКлиентСервер.ОбновитьПредставленияНомеровБСО(ТекДанные, ИмяПоляНомерНачальный, ИмяПоляНомерКонечный);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекДанные, "ОшибкаУчета") Тогда
		ОбновитьПризнакОшибкиУчета(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОграничитьДиапазонНомеровНеСоответствующихУсловиюАктива(ВидДокумента, ТекДанные)
	
	// Диапазон номеров, не соответствующих условию актива, должен принадлежать диапазону фактического наличия.
	// При очистке фактического наличия принудительно очищается не актив.
	
	ЭтоБСО				= (ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовСтрогойОтчетности.БСО"));
	ЭтоДенежныйДокумент	= (ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы"));
	
	Если ТекДанные.Сумма = 0 Тогда
		ОчищающаяСтруктура = Новый Структура("
			|КоличествоНеСоответствует,
			|СуммаНеСоответствует,
			|Статус");
		
		Если ЭтоБСО Тогда
			ОчищающаяСтруктура.Вставить("НачальныйНомерНеСоответствует");
			ОчищающаяСтруктура.Вставить("КонечныйНомерНеСоответствует");
			ОчищающаяСтруктура.Вставить("НачальныйНомерНеСоответствуетПредставление");
			ОчищающаяСтруктура.Вставить("КонечныйНомерНеСоответствуетПредставление");
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
		
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.СуммаНеСоответствует = 0 Тогда
		ОчищающаяСтруктура = Новый Структура("Статус");
		
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	КонецЕсли;
	
	Если ЭтоБСО Тогда
		ЛеваяГраница = Макс(ТекДанные.НачальныйНомер, ТекДанные.НачальныйНомерНеСоответствует);
		ПраваяГраница = Мин(ТекДанные.КонечныйНомер, ТекДанные.КонечныйНомерНеСоответствует);
		
		ЕстьПересечениеДиапазонов = (ЛеваяГраница <= ПраваяГраница);
		
		ОбновитьПоказатели = Ложь;
		
		Если ЕстьПересечениеДиапазонов Тогда
			СкорректироватьЛевуюГраницу = (ТекДанные.НачальныйНомерНеСоответствует < ЛеваяГраница);
			СкорректироватьПравуюГраницу = (ТекДанные.КонечныйНомерНеСоответствует > ПраваяГраница);
			
			Если СкорректироватьЛевуюГраницу Тогда
				ТекДанные.НачальныйНомерНеСоответствует = ЛеваяГраница;
				ТекДанные.КоличествоНеСоответствует = ТекДанные.КонечныйНомерНеСоответствует - ТекДанные.НачальныйНомерНеСоответствует + 1;
				
				ОбновитьПоказатели = Истина;
			КонецЕсли;
			
			Если СкорректироватьПравуюГраницу Тогда
				ТекДанные.КонечныйНомерНеСоответствует = ПраваяГраница;
				ТекДанные.КоличествоНеСоответствует = ТекДанные.КонечныйНомерНеСоответствует - ТекДанные.НачальныйНомерНеСоответствует + 1;
				
				ОбновитьПоказатели = Истина;
			КонецЕсли;
		Иначе
			ТекДанные.НачальныйНомерНеСоответствует = 0;
			ТекДанные.КонечныйНомерНеСоответствует = 0;
			ТекДанные.КоличествоНеСоответствует = 0;
			
			ОбновитьПоказатели = Истина;
		КонецЕсли;
		
		Если ТекДанные.Количество > 0 И ТекДанные.КоличествоНеСоответствует = ТекДанные.Количество Тогда
			// При совпадении количества гарантируем совпадение суммы.
			ТекДанные.СуммаНеСоответствует = ТекДанные.Сумма;
			
		ИначеЕсли ОбновитьПоказатели Тогда
			ОбновитьПоказателиВСтроке0510465(ВидДокумента, ТекДанные, "НеСоответствует", "Количество");
			
		ИначеЕсли ТекДанные.СуммаНеСоответствует > ТекДанные.Сумма Тогда
			ТекДанные.СуммаНеСоответствует = ТекДанные.Сумма;
		КонецЕсли;
		
	ИначеЕсли ЭтоДенежныйДокумент Тогда
		Если ТекДанные.Количество > 0 И ТекДанные.КоличествоНеСоответствует = ТекДанные.Количество Тогда
			// При совпадении количества гарантируем совпадение суммы.
			ТекДанные.СуммаНеСоответствует = ТекДанные.Сумма;
			
		ИначеЕсли ТекДанные.КоличествоНеСоответствует > ТекДанные.Количество Тогда
			ТекДанные.КоличествоНеСоответствует = ТекДанные.Количество;
			ТекДанные.СуммаНеСоответствует = ТекДанные.Сумма;
		КонецЕсли;
		
		Если ТекДанные.СуммаНеСоответствует > ТекДанные.Сумма Тогда
			ТекДанные.СуммаНеСоответствует = ТекДанные.Сумма;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьПризнакОшибкиУчета(ТекДанные)
	
	ТекДанные.ОшибкаУчета = ЕстьОшибкаМножителяКоличества(ТекДанные) Или ЕстьОтрицательныеЗначения(ТекДанные);
	
