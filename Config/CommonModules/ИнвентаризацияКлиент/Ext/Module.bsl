	РассчитатьЗависимыеКомпонентыОбщейСуммы(СуммаВсего, СуммаДолгосрочная, СуммаТекущая, СуммаПросроченная);
	
КонецПроцедуры

Процедура РассчитатьЗависимыеКомпонентыОбщейСуммы(Знач СуммаВсего, Знач ИзмененнаяСумма, СуммаПриоритетИзменения1, СуммаПриоритетИзменения2 = Неопределено, СуммаПриоритетИзменения3 = Неопределено)
	
	ОжидаютсяПоложительныеЗначения = (СуммаВсего >= 0);
	
	Если ИзмененнаяСумма = Неопределено Тогда
		ИзмененнаяСумма = 0;
	КонецЕсли;
	
	МассивСумм = Новый Массив();
	МассивСумм.Добавить(СуммаПриоритетИзменения1);
	Если СуммаПриоритетИзменения2 <> Неопределено Тогда
		МассивСумм.Добавить(СуммаПриоритетИзменения2);
	КонецЕсли;
	Если СуммаПриоритетИзменения3 <> Неопределено Тогда
		МассивСумм.Добавить(СуммаПриоритетИзменения3);
	КонецЕсли;
	
	Для Индекс = 0 По МассивСумм.ВГраница() Цикл
		ИтогПоМассиву = 0;
		
		Для Каждого Сумма Из МассивСумм Цикл
			ИтогПоМассиву = ИтогПоМассиву + Сумма;
		КонецЦикла;
		
		Дельта = СуммаВсего - (ИзмененнаяСумма + ИтогПоМассиву);
		
		Если Дельта = 0 Тогда
			СуммаПриоритетИзменения1 = МассивСумм[0];
			Если СуммаПриоритетИзменения2 <> Неопределено Тогда
				СуммаПриоритетИзменения2 = МассивСумм[1];
			КонецЕсли;
			Если СуммаПриоритетИзменения3 <> Неопределено Тогда
				СуммаПриоритетИзменения3 = МассивСумм[2];
			КонецЕсли;
			
			Возврат;
		КонецЕсли;
		
		Сумма = МассивСумм[Индекс];
		
		Сумма = Сумма + Дельта;
		
		Если ОжидаютсяПоложительныеЗначения И Сумма < 0 Или Не ОжидаютсяПоложительныеЗначения И Сумма > 0 Тогда
			Сумма = 0;
		КонецЕсли;
		
		Если ОжидаютсяПоложительныеЗначения И Сумма > СуммаВсего Или Не ОжидаютсяПоложительныеЗначения И Сумма < СуммаВсего Тогда
			Сумма = СуммаВсего;
		КонецЕсли;
		
		МассивСумм[Индекс] = Сумма;
	КонецЦикла;
	
	СуммаПриоритетИзменения1 = МассивСумм[0];
	Если СуммаПриоритетИзменения2 <> Неопределено Тогда
		СуммаПриоритетИзменения2 = МассивСумм[1];
	КонецЕсли;
	Если СуммаПриоритетИзменения3 <> Неопределено Тогда
		СуммаПриоритетИзменения3 = МассивСумм[2];
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьСуммыНеподходящегоЗнака(Знач СуммаВсего, Сумма1, Сумма2, Сумма3 = Неопределено)
	
	ОжидаютсяПоложительныеЗначения = (СуммаВсего >= 0);
	
	Если ОжидаютсяПоложительныеЗначения И Сумма1 < 0 Или Не ОжидаютсяПоложительныеЗначения И Сумма1 > 0 Тогда
		Сумма1 = 0;
	КонецЕсли;
	
	Если ОжидаютсяПоложительныеЗначения И Сумма2 < 0 Или Не ОжидаютсяПоложительныеЗначения И Сумма2 > 0 Тогда
		Сумма2 = 0;
	КонецЕсли;
	
	Если Сумма3 <> Неопределено И (ОжидаютсяПоложительныеЗначения И Сумма3 < 0 Или Не ОжидаютсяПоложительныеЗначения И Сумма3 > 0) Тогда
		Сумма3 = 0;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СписокСчетовНаФормеСпискаДокументов

Процедура ОбновитьОтборПоСчетуНаФормеСпискаДокументов(ФормаСписка, ИмяПоляСчет)
	
	ЗначениеФлажка = ФормаСписка.ОтборПоСчетуФлажок;
	ЗначениеСчета = ФормаСписка.ОтборПоСчету;
	
	ДинамическийСписок = ФормаСписка.Список;
	
	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(ДинамическийСписок, ИмяПоляСчет);
	
	ИспользованиеОтбора = ЗначениеФлажка;
	РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
	
	ЗначениеВидСравнения = ?(ЗначениеЗаполнено(ЗначениеСчета),
		ВидСравненияКомпоновкиДанных.ВИерархии,
		ВидСравненияКомпоновкиДанных.Равно);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		ДинамическийСписок, ИмяПоляСчет, ЗначениеСчета, ЗначениеВидСравнения,,
		ИспользованиеОтбора, РежимОтображения, "ОтборПоСчету");
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
