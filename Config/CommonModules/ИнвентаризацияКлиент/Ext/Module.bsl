Процедура Редактирование0504087_РассчитатьФактическиеПоказатели(ФормаДокумента, ТекущиеДанные, ИмяИзмененногоПоля) Экспорт
	
	// Гр.7		=	Гр.5	х	Гр.6
	// Сумма		Цена		Количество
	
	ИменаКолонок = ФормаДокумента["КэшВариантФормированияОписи"]["ИменаКолонокЧисловыхПоказателей"];
	
	ИмяКоличествоФакт	= ИменаКолонок["КоличествоФакт"];
	ИмяСуммаФакт		= ИменаКолонок["СуммаФакт"];
	
	РассчитатьСумму = (ИмяИзмененногоПоля = ИмяКоличествоФакт ИЛИ ИмяИзмененногоПоля = "Цена");
	
	РассчитатьЦену = (ИмяИзмененногоПоля = ИмяСуммаФакт);
	
	Если РассчитатьСумму Тогда
		
		ТекущиеДанные[ИмяСуммаФакт] = ТекущиеДанные[ИмяКоличествоФакт] * ТекущиеДанные["Цена"];
		
	ИначеЕсли РассчитатьЦену Тогда
		
		Если ТекущиеДанные[ИмяКоличествоФакт] = 0 Тогда
			Цена = 0;
		Иначе
			Цена = ТекущиеДанные[ИмяСуммаФакт] / ТекущиеДанные[ИмяКоличествоФакт];
		КонецЕсли;
		
		ТекущиеДанные["Цена"] = Цена;
	КонецЕсли;
	
КонецПроцедуры

Процедура Редактирование0504087_РассчитатьРасхождениеВСтроке(ФормаДокумента, ТекущиеДанные) Экспорт
	
	// Предназначен для вызова в случае ВариантФормированияОписи = 1,2,3
	// 1. Опись с 2018 г. Счет в таблице (26 знаков)
	// 2. Опись с 2018 г. Счет в таблице (5 знаков)
	// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
	
	ИменаКолонок = ФормаДокумента["КэшВариантФормированияОписи"]["ИменаКолонокЧисловыхПоказателей"];
	
	ИмяКоличествоУчет		= ИменаКолонок["КоличествоУчет"];
	ИмяКоличествоФакт		= ИменаКолонок["КоличествоФакт"];
	ИмяКоличествоИзлишек	= ИменаКолонок["КоличествоИзлишек"];
	ИмяКоличествоНедостача	= ИменаКолонок["КоличествоНедостача"];
	
	ИмяСуммаУчет			= ИменаКолонок["СуммаУчет"];
	ИмяСуммаФакт			= ИменаКолонок["СуммаФакт"];
	ИмяСуммаИзлишек			= ИменаКолонок["СуммаИзлишек"];
	ИмяСуммаНедостача		= ИменаКолонок["СуммаНедостача"];
	
	ДельтаКолво = ТекущиеДанные[ИмяКоличествоУчет] - ТекущиеДанные[ИмяКоличествоФакт];
	
	//
	// Недостача
	//
	ТекущиеДанные[ИмяКоличествоНедостача] = ?(ДельтаКолво>0, ДельтаКолво, 0);
	
	// Гр.14 = Гр.13 х (Гр.12 / Гр.11)
	Если ТекущиеДанные[ИмяКоличествоУчет] <> 0 Тогда
		
		Если ТекущиеДанные[ИмяКоличествоНедостача] = ТекущиеДанные[ИмяКоличествоУчет] Тогда
			// Отсутствует в полном количестве
			
			Сумма = ТекущиеДанные[ИмяСуммаУчет];
			
		Иначе
			
			Сумма = ТекущиеДанные[ИмяСуммаУчет] * ТекущиеДанные[ИмяКоличествоНедостача] / ТекущиеДанные[ИмяКоличествоУчет];
			
		КонецЕсли;
		
	Иначе
		
		Сумма = 0;
		
	КонецЕсли;
	
	ТекущиеДанные[ИмяСуммаНедостача] = Сумма;
	
	//
	// Излишек
	//
	ТекущиеДанные[ИмяКоличествоИзлишек] = ?(ДельтаКолво<0, -ДельтаКолво, 0);
	
	// Гр.16 = Гр.15 х Гр.5
	ТекущиеДанные[ИмяСуммаИзлишек] = ТекущиеДанные[ИмяКоличествоИзлишек] * ТекущиеДанные["Цена"];
	
	//
	// Не соответствует условиям актива
	//
	// Гр.18 = Гр.17 х (Гр.12 / Гр.11)
	Если ТекущиеДанные[ИмяКоличествоУчет] <> 0 Тогда
		
		Если ТекущиеДанные["КоличествоНеСоответствует"] = ТекущиеДанные[ИмяКоличествоУчет] Тогда
			// Не соответствует в полном количестве
			
			Сумма = ТекущиеДанные[ИмяСуммаУчет];
			
		Иначе
			
			Сумма = ТекущиеДанные[ИмяСуммаУчет] * ТекущиеДанные["КоличествоНеСоответствует"] / ТекущиеДанные[ИмяКоличествоУчет];
			
		КонецЕсли;
		
	Иначе
		
		Сумма = 0;
		
	КонецЕсли;
	
	ТекущиеДанные["СуммаНеСоответствует"] = Сумма;
	
КонецПроцедуры

Функция Редактирование0504087_БудутОчищеныКолонкиПриИзмененииВариантаФормированияОписи(ТекущееЗначениеВарианта, НовоеЗначениеВарианта) Экспорт
	
	// 0. Опись до 2018 г. Счет в шапке
	// 1. Опись с 2018 г. Счет в таблице (26 знаков)
	// 2. Опись с 2018 г. Счет в таблице (5 знаков)
	// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
	
	БудутОчищеныКолонки = ((ТекущееЗначениеВарианта > 0 И НовоеЗначениеВарианта = 0)
		ИЛИ (ТекущееЗначениеВарианта = 1 И НовоеЗначениеВарианта > 1));
		
	Возврат БудутОчищеныКолонки;
	
КонецФункции


Процедура ОткрытьФормуГрупповогоЗаполненияСтрок(ФормаДокумента, ИмяТабличнойЧасти, ИмяЭлементаФормы = "") Экспорт
	
	Если ИмяЭлементаФормы = "" Тогда
		ИмяЭлементаФормы = ИмяТабличнойЧасти;
	КонецЕсли;
	
	КоличествоСтрок = ФормаДокумента.Элементы[ИмяЭлементаФормы].ВыделенныеСтроки.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		
		ТекстСообщения = НСтр("ru='Выделите несколько строк для выполнения группового заполнения'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяТабличнойЧасти",	ИмяТабличнойЧасти);
	ДополнительныеПараметры.Вставить("ИмяЭлементаФормы",	ИмяЭлементаФормы);
	
	ОповещениеВыбор = Новый ОписаниеОповещения("ЗакрытаФормаГрупповогоЗаполненияСтрок", ФормаДокумента, ДополнительныеПараметры);
	
	ПараметрыФормы = ФормаДокумента.ПолучитьПараметрыФормыГрупповогоЗаполненияСтрок(ИмяТабличнойЧасти, КоличествоСтрок);
	
	Если ИмяТабличнойЧасти = "Инвентаризация" ИЛИ ИмяТабличнойЧасти = "Материалы" Тогда
		
		ИмяФормы = "ОбщаяФорма.ИнвентаризацияГрупповоеЗаполнениеСтрокНФА";
		
	Иначе
		
		ИмяФормы = "ОбщаяФорма.ИнвентаризацияГрупповоеЗаполнениеСтрокРасхождения";
		
	КонецЕсли;
	
	ОткрытьФорму(ИмяФормы, ПараметрыФормы,,,,, ОповещениеВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


Процедура ОткрытьВыборКомиссии(Форма) Экспорт
	
	Перем Отказ, РеквизитыПриказаКомиссии;
	
	ЗначенияПараметров = ПолучитьОрганизациюДату(Форма, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРеквизитов = ОбщегоНазначенияБГУКлиент.СтруктураИменРеквизитовВыбораПредседателяКомиссии(
		"ДолжностьПредседателяКомиссии",
		"ФамилияПредседателяКомиссии",
		"ИмяПредседателяКомиссии",
		"ОтчествоПредседателяКомиссии");
	
	ТипДокумента = ТипЗнч(Форма.Объект.Ссылка);
	
	ЕстьРеквизитыПриказаКомиссии = (
		ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияДрагКамнейВИК")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияДрагКамнейВНФА")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияДрагМеталловВИК")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияДрагМеталловВНФА")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияИК")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияКассы")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияМЗ")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияОС")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияОстатковНаСчетах")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияРасчетовПоПоступлениям")
		
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ВедомостьИнвентаризации")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.УдалитьАктОРезультатахИнвентаризации")
	);
	
	Если ЕстьРеквизитыПриказаКомиссии Тогда
		РеквизитыПриказаКомиссии = Новый Структура();
		РеквизитыПриказаКомиссии.Вставить("НомерПриказа", "НомерПриказаКомиссии");
		РеквизитыПриказаКомиссии.Вставить("ДатаПриказа", "ДатаПриказаКомиссии");
	КонецЕсли;
		
	ОбщегоНазначенияБГУКлиент.НачатьВыборПостоянноДействующейКомиссии(
		Форма,
		ИменаРеквизитов,
		РеквизитыПриказаКомиссии);
	
КонецПроцедуры

Процедура ОткрытьПодборКомиссии(Форма) Экспорт
	
	Перем Отказ;
	
	ЗначенияПараметров = ПолучитьОрганизациюДату(Форма, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Свойство Период
	ОбщегоНазначенияБГУКлиент.ОткрытьПодборКомиссии(Форма.Элементы.СоставКомиссии, ЗначенияПараметров);
	
КонецПроцедуры

Процедура ОткрытьВыборПредседателяКомиссии(Форма) Экспорт
	
	Перем Отказ;
	
	ЗначенияПараметров = ПолучитьОрганизациюДату(Форма, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРеквизитов = ОбщегоНазначенияБГУКлиент.СтруктураИменРеквизитовВыбораПредседателяКомиссии(
		"ДолжностьПредседателяКомиссии",
		"ФамилияПредседателяКомиссии",
		"ИмяПредседателяКомиссии",
		"ОтчествоПредседателяКомиссии");
	
	ОбщегоНазначенияБГУКлиент.НачатьВыборПредседателяКомиссии(Форма, ИменаРеквизитов);
	
КонецПроцедуры

Процедура ДатаИнвентаризацииПриИзменении_ПроверитьНеобходимостьИзмененияСоставаГруппСчетов(Форма) Экспорт
	
	Если ЗначенияВОдномДиапазоне(
		Форма["КэшДатаИнвентаризации"],
		Форма.Объект["ДатаИнвентаризации"],
		Форма["ДатыИзмененияСоставаГруппСчетов"]) Тогда
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ДатаИнвентаризацииПриИзменении_ИзменениеСоставаГруппСчетовНеТребуется", Форма);
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗавершении);
		
		Возврат;
		
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru='Новое значение даты инвентаризации находится в периоде действия другого состава счетов учета НФА.
		|Список групп счетов инвентаризации будет составлен заново.
		|Табличные части документа буду очищены.
		|
		|Продолжить и сменить дату инвентаризации?'");
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ДатаИнвентаризацииПриИзменении_ПодтвержденоИзменениеСоставаГруппСчетов", Форма);
	
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

Функция СчетДействуетНаДату(СвойстваСчета, ПроверяемаяДата) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ПроверяемаяДата) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Дата1 = СвойстваСчета.ДатаНачалаДействия;
	Дата2 = СвойстваСчета.ДатаОкончанияДействия;
	
	Если НЕ ЗначениеЗаполнено(Дата1) И НЕ ЗначениеЗаполнено(Дата2) Тогда
		СчетДействует = Истина;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(Дата1) И ЗначениеЗаполнено(Дата2) Тогда
		СчетДействует = (ПроверяемаяДата <= Дата2);
		
	ИначеЕсли ЗначениеЗаполнено(Дата1) И НЕ ЗначениеЗаполнено(Дата2) Тогда
		СчетДействует = (Дата1 <= ПроверяемаяДата);
		
	Иначе
		// ЗначениеЗаполнено(Дата1) И ЗначениеЗаполнено(Дата2) Тогда
		
		СчетДействует = (Дата1 <= ПроверяемаяДата И ПроверяемаяДата <= Дата2);
		
	КонецЕсли;
	
	Возврат СчетДействует;
	
КонецФункции

Процедура ОткрытьФормуВыбораКЭККИЕ(Элемент, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Коды = Новый Массив();
	Коды.Добавить("000");
	Коды.Добавить("001");
	Коды.Добавить("002");
	Коды.Добавить("003");
	Коды.Добавить("004");
	Коды.Добавить("005");
	Коды.Добавить("006");
	Коды.Добавить("007");
	Коды.Добавить("008");
	Коды.Добавить("009");
	
	Отбор = Новый Структура();
	Отбор.Вставить("Код", Новый ФиксированныйМассив(Коды));
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ПоказатьСкрытыеКоды",	Истина);
	ПараметрыФормы.Вставить("Отбор",				Отбор);
	
	ОткрытьФорму("Справочник.КОСГУ.ФормаВыбора", ПараметрыФормы, Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура ВыбратьИУстановитьСтатусОбъектаДляИнвентаризации(ФормаДокумента, ТекДанные, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ФормаДокумента",	ФормаДокумента);
	ДополнительныеПараметры.Вставить("ТекДанные",		ТекДанные);
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ПослеВыбораСтатусаОбъектаДляИнвентаризации", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Справочник.СтатусыОбъектовДляИнвентаризации.ФормаВыбора",,,,,,ОписаниеОповещенияВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура ПослеВыбораСтатусаОбъектаДляИнвентаризации(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.ТекДанные.СтатусОбъекта = ИнвентаризацияВызовСервера.ПолучитьПредставлениеСтатусаОбъектаДляИнвентаризации(ВыбранноеЗначение);
	
	ДополнительныеПараметры.ФормаДокумента.Модифицированность = Истина;
	
КонецПроцедуры

#Область ЦепочкиИзмененийРешения

Процедура ПоказатьОшибкиЦепочки(Форма) Экспорт
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("АдресДокумента",	Форма.АдресХранилищаОшибкиЦепочки);
	ПараметрыФормы.Вставить("Заголовок",		НСтр("ru='Ошибки построения цепочки документов'"));
	
	ОткрытьФорму("ОбщаяФорма.ФормаПросмотраТабличногоДокумента", ПараметрыФормы, Форма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура ВыбраноРешениеОПроведенииИнвентаризации(ФормаОписи, ВызыватьИсключение = Истина) Экспорт
	
	ОбъектОписи = ФормаОписи.Объект;
	
	РешениеОПроведенииИнвентаризации = ОбъектОписи.РешениеОПроведенииИнвентаризации;
	
	Если Не ЗначениеЗаполнено(РешениеОПроведенииИнвентаризации) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = ИнвентаризацияВызовСервера.ПолучитьПараметрыФормыВыбораДанныхИзРешения(
		ОбъектОписи.Ссылка,
		РешениеОПроведенииИнвентаризации,
		ФормаОписи.УникальныйИдентификатор,
		ВызыватьИсключение);
		
	Если ПараметрыФормы.РешениеСодержитДанныеДляЗаполненияОписи Тогда
		ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ЗакрытаФормаВыбораДанныхИзРешенияОПроведенииИнвентаризации", ФормаОписи);
		
		ОткрытьФорму("ОбщаяФорма.ВыборДанныхИзРешенияОПроведенииИнвентаризации", ПараметрыФормы, ФормаОписи,,,, ОписаниеОповещенияВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

Процедура СообщитьОЗаполненииНаОснованииРешенияОПроведенииИнвентаризации() Экспорт
	
	ТекстСообщения = НСтр("ru='Документ успешно заполнен на основании Решения о проведении инвентаризации'");
	
	ПоказатьПредупреждение(, ТекстСообщения, 20);
	
КонецПроцедуры

Процедура НажатиеГиперссылкиОкружающегоДокумента(Элемент, Форма, СтандартнаяОбработка = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ОкружающиеДокументыЦепочки = Форма.ОкружающиеДокументыЦепочки;
	
	ИмяЭлемента = Элемент.Имя;
	
	ИмяЭлемента = СтрЗаменить(ИмяЭлемента, "НадписьДокументЦепочки", "");
	ИмяЭлемента = СтрЗаменить(ИмяЭлемента, "Представление", "");
	ИмяЭлемента = СтрЗаменить(ИмяЭлемента, "ДекорацияДокументЦепочки", "");
	ИмяЭлемента = СтрЗаменить(ИмяЭлемента, "НеЯвляетсяПоследним", "");
	ИмяЭлемента = СтрЗаменить(ИмяЭлемента, "ЯвляетсяПоследним", "");
	
	ДокументСсылка = ОкружающиеДокументыЦепочки[ИмяЭлемента].ДокументСсылка;
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		ПоказатьЗначение(, ДокументСсылка);
		
	ИначеЕсли ИмяЭлемента = "Первый" И Не Форма.Объект.ПометкаУдаления Тогда
		ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ПослеВыбораРешения", Форма);
		
		Отбор = Новый Структура();
		Отбор.Вставить("Организация", Форма.Объект.Организация);
		
		ПараметрыВыбора = Новый Структура();
		ПараметрыВыбора.Вставить("Отбор", Отбор);
		
		ОткрытьФорму("Документ.РешениеОПроведенииИнвентаризации.ФормаВыбора", ПараметрыВыбора, Форма,,,, ОписаниеОповещенияВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонкиТаблицыОбъектыВТекущейСтроке(ФормаДокумента) Экспорт
	
	ТекущиеДанные = ФормаДокумента.Элементы.Объекты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураТекущиеДанные = Новый Структура("Счет,ДатаИнвентаризации,ТипИзменения");
	
	ЗаполнитьЗначенияСвойств(СтруктураТекущиеДанные, ТекущиеДанные);
	
	СтруктураТекущиеДанные.Вставить("КодФормы");
	СтруктураТекущиеДанные.Вставить("ЕстьРеквизитМОЛ");
	СтруктураТекущиеДанные.Вставить("ОдинаковоеНаличиеРеквизитаМОЛ");
	
	Если ИнвентаризацияКлиентСервер.ЭтоДокументИзмененияРешения(ФормаДокумента.Объект.Ссылка) Тогда
		ДатаРешения = НачалоДня(ФормаДокумента.ОкружающиеДокументыЦепочки.Первый.Дата);
	Иначе
		ДатаРешения = НачалоДня(ФормаДокумента.Объект.Дата);
	КонецЕсли;
	
	ИнвентаризацияВызовСервера.ЗаполнитьСлужебныеКолонкиТаблицыОбъектыВТекущейСтроке(
		ФормаДокумента.ТаблицаНастроекЗаполненияОписейПоРешению,
		СтруктураТекущиеДанные,
		ДатаРешения);
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураТекущиеДанные, "КодФормы,ЕстьРеквизитМОЛ,ОдинаковоеНаличиеРеквизитаМОЛ");
	
КонецПроцедуры

#КонецОбласти

#Область РазбивкаСтрокиИнвентаризацииНФА

&НаКлиенте
Функция ПараметрыФормыРазбивкиСтрокиИнвентаризацииНфа() Экспорт
	
	СоответствиеИмен = Новый Структура("
		|КоличествоФакт,
		|СуммаФакт,
		|КоличествоУчет,
		|СуммаУчет");
	
	Параметрыформы = Новый Структура();
	Параметрыформы.Вставить("ИмяТабличнойЧасти",	"");
	Параметрыформы.Вставить("СоответствиеИмен",		СоответствиеИмен);
	Параметрыформы.Вставить("ТочностьКоличества",	0);
	Параметрыформы.Вставить("ТочностьЦены",			2);
	
	Возврат Параметрыформы;
	
КонецФункции

// ПараметрыФормы - Структура - см. ПараметрыФормыРазбивкиСтрокиИнвентаризацииНфа()
&НаКлиенте
Процедура ОткрытьФормуРазбивкиСтрокиИнвентаризацииНфа(ФормаДокумента, СтрокаТаблицы, Параметрыформы) Экспорт
	
	Если СтрокаТаблицы = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru='Выберите разбиваемую строку'"));
		
		Возврат;
	КонецЕсли;
	
	СоответствиеИмен	= Параметрыформы.СоответствиеИмен;
	ТочностьКоличества	= Параметрыформы.ТочностьКоличества;
	
	РазбиваемаяСтрока = Новый Структура("
		|НомерСтроки,
		|КоличествоНеСоответствует,
		|СуммаНеСоответствует,
		|КоличествоФакт,
		|СуммаФакт,
		|КоличествоУчет,
		|СуммаУчет,
		|СтатусОбъекта,
		|ЦелеваяФункцияАктива,
		|Примечание");
	
	ЗаполнитьЗначенияСвойств(РазбиваемаяСтрока, СтрокаТаблицы);
	
	Для Каждого Элемент Из СоответствиеИмен Цикл
		ПолеФормыРазбивки	= Элемент.Ключ;
		ПолеДокумента 		= Элемент.Значение;
		
		Если ЗначениеЗаполнено(ПолеДокумента) Тогда
			РазбиваемаяСтрока[ПолеФормыРазбивки] = СтрокаТаблицы[ПолеДокумента];
		КонецЕсли;
	КонецЦикла;
	
	НовыеПараметрыФормы = Новый Структура();
	НовыеПараметрыФормы.Вставить("РазбиваемаяСтрока", РазбиваемаяСтрока);
	НовыеПараметрыФормы.Вставить("ТочностьКоличества", Параметрыформы.ТочностьКоличества);
	НовыеПараметрыФормы.Вставить("ТочностьЦены", Параметрыформы.ТочностьЦены);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ФормаДокумента",		ФормаДокумента);
	ДополнительныеПараметры.Вставить("ИмяТабличнойЧасти",	Параметрыформы.ИмяТабличнойЧасти);
	ДополнительныеПараметры.Вставить("РазбиваемаяСтрока",	РазбиваемаяСтрока);
	ДополнительныеПараметры.Вставить("СоответствиеИмен",	СоответствиеИмен);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытаФормаРазбивкиСтрокиИнвентаризацииНфа", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("ОбщаяФорма.ИнвентаризацияРазбивкаСтрокиНфа", НовыеПараметрыФормы, ФормаДокумента,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытаФормаРазбивкиСтрокиИнвентаризацииНфа(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ФормаДокумента = ДополнительныеПараметры.ФормаДокумента;
	
	Объект = ФормаДокумента.Объект;
	
	ТабличнаяЧасть = Объект[ДополнительныеПараметры.ИмяТабличнойЧасти];
	
	СоответствиеИмен = ДополнительныеПараметры.СоответствиеИмен;
	
	ИндексРазбиваемойСтроки = ДополнительныеПараметры.РазбиваемаяСтрока.НомерСтроки - 1;
	
	РазбиваемаяСтрока = ТабличнаяЧасть[ИндексРазбиваемойСтроки];
	
	Для Счетчик = 1 По РезультатВыбора.Количество() - 1 Цикл
		НоваяСтрока = ТабличнаяЧасть.Вставить(ИндексРазбиваемойСтроки + 1);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, РазбиваемаяСтрока);
	КонецЦикла;
	
	ИндексыСтрок = Новый Массив();
	
	ИндексСтроки = ИндексРазбиваемойСтроки;
	
	Для Каждого СтруктураСтроки Из РезультатВыбора Цикл
		
		ИндексыСтрок.Добавить(ИндексСтроки);
		
		СтрокаТаблицы = ТабличнаяЧасть[ИндексСтроки];
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураСтроки);
	
		Для Каждого Элемент Из СоответствиеИмен Цикл
			ПолеФормыРазбивки	= Элемент.Ключ;
			ПолеДокумента 		= Элемент.Значение;
			
			Если ЗначениеЗаполнено(ПолеДокумента) Тогда
				СтрокаТаблицы[ПолеДокумента] = СтруктураСтроки[ПолеФормыРазбивки];
			КонецЕсли;
		КонецЦикла;
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	ФормаДокумента.Модифицированность = Истина;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеРазбивкиСтрокиИнвентаризацииНфа", ФормаДокумента);
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения, ИндексыСтрок);
	
КонецПроцедуры

#КонецОбласти

#Область ИнвентаризационныеОписи61н

Процедура СоздатьДокументРасписки(ФормаДокументаОписи) Экспорт
	
	ОбъектОписи = ФормаДокументаОписи.Объект;
	
	СтрокаТаблицыНастроек = ФормаДокументаОписи.ДанныеПанелиРасписки.СтрокаТаблицыНастроек;
	
	ДанныеЗаполнения = Новый Структура();
	ДанныеЗаполнения.Вставить("Организация",	ОбъектОписи.Организация);
	ДанныеЗаполнения.Вставить("ДокументОписи",	ОбъектОписи.Ссылка);
	ДанныеЗаполнения.Вставить("Сотрудник",		ОбъектОписи[СтрокаТаблицыНастроек.ИмяРеквизитаСотрудникДляРасписки]);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СозданиеИзФормыОписи",	Истина);
	ПараметрыФормы.Вставить("Основание",			ДанныеЗаполнения);
	
	ОткрытьФорму("Документ.РаспискаИнвентаризации.ФормаОбъекта", ПараметрыФормы, ФормаДокументаОписи);
	
КонецПроцедуры

Процедура ПриНажатииНадписиРасписка(ФормаДокументаОписи, ДополнительноПроверяемыеПоляПередСозданиемРасписки = Неопределено) Экспорт
	
	ДанныеПанелиРасписки = ФормаДокументаОписи.ДанныеПанелиРасписки;
	
	Если ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) Тогда
		ПоказатьЗначение(, ДанныеПанелиРасписки.Расписка);
		
		Возврат;
	КонецЕсли;
	
	ПроверитьИСоздатьДокументРасписки(ФормаДокументаОписи, ДополнительноПроверяемыеПоляПередСозданиемРасписки);
	
КонецПроцедуры

Процедура ПриНажатииГиперссылкиКомментарияПанелиРасписки(ФормаДокументаОписи) Экспорт
	
	ДанныеПанелиРасписки = ФормаДокументаОписи.ДанныеПанелиРасписки;
	
	СписокВыбораКомментарий = ДанныеПанелиРасписки.СписокВыбораКомментарий;
	
	Если СписокВыбораКомментарий.Количество() = 1 Тогда
		ПоказатьЗначение(, СписокВыбораКомментарий[0].Значение);
		
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ВыбранаРаспискаИзСпискаГиперссылкиКомментарияРасписки", ЭтотОбъект);
	
	ФормаДокументаОписи.ПоказатьВыборИзСписка(ОписаниеОповещенияВыбор, ДанныеПанелиРасписки.СписокВыбораКомментарий, ФормаДокументаОписи.Элементы.ДекорацияРаспискаКомментарийГиперссылкаНадпись);
	
КонецПроцедуры

Процедура ВыбранаРаспискаИзСпискаГиперссылкиКомментарияРасписки(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ЭлементСпискаЗначений") Тогда
		ПоказатьЗначение(, ВыбранноеЗначение.Значение);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриНажатииГиперссылкиКомментарияПанелиОписи(ФормаДокументаРасписки) Экспорт
	
	ДанныеПанелиОписи = ФормаДокументаРасписки.ДанныеПанелиОписи;
	
	СписокВыбораКомментарий = ДанныеПанелиОписи.СписокВыбораКомментарий;
	
	Если СписокВыбораКомментарий.Количество() = 1 Тогда
		ПоказатьЗначение(, СписокВыбораКомментарий[0].Значение);
		
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ВыбранаОписьИзСпискаГиперссылкиКомментарияОписи", ЭтотОбъект);
	
	ФормаДокументаРасписки.ПоказатьВыборИзСписка(ОписаниеОповещенияВыбор, ДанныеПанелиОписи.СписокВыбораКомментарий, ФормаДокументаРасписки.Элементы.ДекорацияОписьКомментарийГиперссылкаНадпись);
	
КонецПроцедуры

Процедура ВыбранаОписьИзСпискаГиперссылкиКомментарияОписи(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ЭлементСпискаЗначений") Тогда
		ПоказатьЗначение(, ВыбранноеЗначение.Значение);
	КонецЕсли;
	
КонецПроцедуры


Процедура НачатьВводТекстовойСтрокиЗаключенияКомиссии(ФормаДокумента, СтандартнаяОбработка, ИмяТабличнойЧасти, Знач ДопПараметрыВыбора = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = ФормаДокумента.Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ФормаДокумента",		ФормаДокумента);
	ДополнительныеПараметры.Вставить("ТекДанные",			ТекДанные);
	ДополнительныеПараметры.Вставить("ДопПараметрыВыбора",	ДопПараметрыВыбора);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаТекстовойСтрокиЗаключенияКомиссии", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВводСтроки(Оповещение, ТекДанные.ЗаключениеКомиссии, НСтр("ru='Заключение комиссии по результатам инвентаризации'"),, Истина);
	
КонецПроцедуры

Процедура ПослеВводаТекстовойСтрокиЗаключенияКомиссии(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.ТекДанные.ЗаключениеКомиссии = ВыбранноеЗначение;
	
	ДополнительныеПараметры.ФормаДокумента.Модифицированность = Истина;
	
	Если ДополнительныеПараметры.ДопПараметрыВыбора <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ДопПараметрыВыбора.ОписаниеОповещенияПослеИзмененияЗаключенияКомиссии);
	КонецЕсли;
	
КонецПроцедуры


Процедура ПроверитьЗаписьДокумента(ФормаДокумента, ИмяКомандыВСообщении, ИмяСледующейПроцедуры, ПараметрыСледующейПроцедуры = Неопределено) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	Если Объект.Ссылка.Пустая() Или ФормаДокумента.Модифицированность Тогда
		ШаблонВопроса = НСтр("ru = 'Для выполнения команды
			|""%1""
			|данные будут записаны. Продолжить?'");
		
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВопроса, ИмяКомандыВСообщении);
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Записать и продолжить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ФормаДокумента",				ФормаДокумента);
		ДополнительныеПараметры.Вставить("ИмяСледующейПроцедуры",		ИмяСледующейПроцедуры);
		ДополнительныеПараметры.Вставить("ПараметрыСледующейПроцедуры",	ПараметрыСледующейПроцедуры);
		
		Обработчик = Новый ОписаниеОповещения("ПодтвержденаЗаписьДокумента", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(Обработчик, ТекстВопроса, Кнопки);
	Иначе
		ОписаниеОповещения = Новый ОписаниеОповещения(ИмяСледующейПроцедуры, ФормаДокумента, ПараметрыСледующейПроцедуры);
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодтвержденаЗаписьДокумента(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.ОК Тогда
		ФормаДокумента				= ДополнительныеПараметры.ФормаДокумента;
		ИмяСледующейПроцедуры		= ДополнительныеПараметры.ИмяСледующейПроцедуры;
		ПараметрыСледующейПроцедуры	= ДополнительныеПараметры.ПараметрыСледующейПроцедуры;
		
		ФормаДокумента.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
		
		ОписаниеОповещения = Новый ОписаниеОповещения(ИмяСледующейПроцедуры, ФормаДокумента, ПараметрыСледующейПроцедуры);
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры


Процедура СоставКомиссииОтсутствуетПриИзменении(ФормаДокумента, Элемент, ИмяТаблицыСоставКомиссии = "СоставКомиссии") Экспорт
	
	ТекущиеДанные = ФормаДокумента.Элементы[ИмяТаблицыСоставКомиссии].ТекущиеДанные;
	
	Если Не ТекущиеДанные.Отсутствует Тогда
		ТекущиеДанные.ПричинаОтсутствия = "";
	КонецЕсли;
	
КонецПроцедуры

Процедура СоставКомиссииПричинаОтсутствияПриИзменении(ФормаДокумента, Элемент, ИмяТаблицыСоставКомиссии = "СоставКомиссии") Экспорт
	
	ТекущиеДанные = ФормаДокумента.Элементы[ИмяТаблицыСоставКомиссии].ТекущиеДанные;
	
	ТекущиеДанные.Отсутствует = Не ПустаяСтрока(ТекущиеДанные.ПричинаОтсутствия);
	
КонецПроцедуры

Процедура СоставКомиссииПричинаОтсутствияНачалоВыбора(ФормаДокумента, Элемент, ДанныеВыбора, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура();
	
	ОткрытьФорму("Справочник.ПричиныОтсутствияСотрудников.ФормаВыбора", ПараметрыФормы, Элемент);

КонецПроцедуры


Процедура НачатьВводТекстовойСтроки(ФормаДокумента, ТекДанные, ИмяПоля, ТекстПодсказки, СтандартнаяОбработка, СохранитьИзменения = Истина) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ФормаДокумента",		ФормаДокумента);
	ДополнительныеПараметры.Вставить("ТекДанные",			ТекДанные);
	ДополнительныеПараметры.Вставить("ИмяПоля",				ИмяПоля);
	ДополнительныеПараметры.Вставить("СохранитьИзменения",	СохранитьИзменения);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаТекстовойСтроки", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВводСтроки(Оповещение, ТекДанные[ИмяПоля], ТекстПодсказки,, Истина);
	
КонецПроцедуры

Процедура ПослеВводаТекстовойСтроки(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	Если Не ДополнительныеПараметры.СохранитьИзменения Тогда
		Возврат;
	КонецЕсли;
	
	ФормаДокумента	= ДополнительныеПараметры.ФормаДокумента;
	ТекДанные		= ДополнительныеПараметры.ТекДанные;
	ИмяПоля			= ДополнительныеПараметры.ИмяПоля;
	
	ТекДанные[ИмяПоля] = ВыбранноеЗначение;
	
	ФормаДокумента.Модифицированность = Истина;
	
КонецПроцедуры


Функция ПолучитьДополнительныеПараметрыДляВыбораЗаключенияКомиссииПоИнвОписи(Знач ФормаДокумента, Знач ИмяПроцедуры = "ПослеИзмененияЗаключенияКомиссии") Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ОписаниеОповещенияПослеИзмененияЗаключенияКомиссии", Новый ОписаниеОповещения(ИмяПроцедуры, ФормаДокумента));
	
	Возврат ДополнительныеПараметры;
	
КонецФункции


Процедура НачатьВыборЗаключенияКомиссииПоИнвОписи(ФормаДокумента, ТекДанные, СтандартнаяОбработка, Знач ДопПараметрыВыбора = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ДокументОписи", ФормаДокумента.Объект.Ссылка);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ФормаДокумента",		ФормаДокумента);
	ДополнительныеПараметры.Вставить("ТекДанные",			ТекДанные);
	ДополнительныеПараметры.Вставить("ДопПараметрыВыбора",	ДопПараметрыВыбора);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораЗаключенияКомиссииПоИнвОписи", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Справочник.ЗаключенияКомиссииПоИнвентаризационнымОписям.ФормаВыбора", ПараметрыФормы, ФормаДокумента,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура ПослеВыбораЗаключенияКомиссииПоИнвОписи(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	ФормаДокумента		= ДополнительныеПараметры.ФормаДокумента;
	ТекДанные			= ДополнительныеПараметры.ТекДанные;
	ДопПараметрыВыбора	= ДополнительныеПараметры.ДопПараметрыВыбора;
	
	ТекстЗаключения = ИнвентаризацияВызовСервера.ПолучитьТекстЗаключенияКомиссииПоОписи(ВыбранноеЗначение);
	
	ТекДанные.ЗаключениеКомиссии = ТекстЗаключения;
	
	ФормаДокумента.Модифицированность = Истина;
	
	Если ДопПараметрыВыбора <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДопПараметрыВыбора.ОписаниеОповещенияПослеИзмененияЗаключенияКомиссии);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоказатьМестоПроведенияИнвентаризации(ФормаДокумента, СтандартнаяОбработка, ПроцедураОбратногоВызова = "") Экспорт
	
	МестоИнвентаризации = ФормаДокумента.Объект.МестоИнвентаризации;
	
	Если ТипЗнч(МестоИнвентаризации) = Тип("Строка") Тогда
		СтандартнаяОбработка = Ложь;
		
		Если ЗначениеЗаполнено(ПроцедураОбратногоВызова) Тогда
			Оповещение = Новый ОписаниеОповещения(ПроцедураОбратногоВызова, ФормаДокумента);
		Иначе
			Оповещение = Новый ОписаниеОповещения("ВведеноСтроковоеЗначениеМестаИнвентаризацииОбработчикПоУмолчанию", ЭтотОбъект);
		КонецЕсли;
		
		ПоказатьВводСтроки(Оповещение, МестоИнвентаризации, НСтр("ru='Место проведения инвентаризации'"));
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВведеноСтроковоеЗначениеМестаИнвентаризацииОбработчикПоУмолчанию(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	// Заглушка.
	
	Возврат;
	
КонецПроцедуры

Процедура НачатьВыборМестаИнвентаризации(ФормаДокумента, Элемент, ТекДанные, СтандартнаяОбработка) Экспорт
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекДанные, "КодФормы") Тогда
		Возврат;
	КонецЕсли;
	
	ДопустимВыборМестаХранения = СтрНайти(ТекДанные.КодФормы, "0504087") > 0
		Или СтрНайти(ТекДанные.КодФормы, "0510465")
		Или СтрНайти(ТекДанные.КодФормы, "0510466");
	
	Если Не ДопустимВыборМестаХранения Тогда
		// Применим лишь строковый тип места инвентаризации.
		ИнвентаризацияКлиент.НачатьВводТекстовойСтроки(ФормаДокумента, ТекДанные, "МестоИнвентаризации", НСтр("ru='Место проведения инвентаризации'"), СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриОткрытииМестаИнвентаризации(ФормаДокумента, ТекДанные, СтандартнаяОбработка, ИмяПоляМестоИнвентаризации = "МестоИнвентаризации", СохранитьИзменения = Истина) Экспорт
	
	Если ТипЗнч(ТекДанные.МестоИнвентаризации) = Тип("СправочникСсылка.МестаХранения") И ЗначениеЗаполнено(ТекДанные.МестоИнвентаризации) Тогда
		Возврат;
	КонецЕсли;
	
	ИнвентаризацияКлиент.НачатьВводТекстовойСтроки(ФормаДокумента, ТекДанные, ИмяПоляМестоИнвентаризации, НСтр("ru='Место проведения инвентаризации'"), СтандартнаяОбработка, СохранитьИзменения);
	
КонецПроцедуры

// 0510465

Процедура ПриИзмененииПоказателяВИнвОписи0510465(ВидДокумента, ТекДанные, ИмяТЧ, ИмяЭлемента, ПараметрыРазбивкиСтроки = Неопределено, РассчитыватьЦену = Ложь) Экспорт
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяТЧ = "Раздел1" Тогда
		
		// Раздел 1
		
		Если ИмяЭлемента = "Раздел1НачальныйНомер" Тогда
			ОбозначениеИзмененногоПоля = "НомерНач";
			
		ИначеЕсли ИмяЭлемента = "Раздел1КонечныйНомер" Тогда
			ОбозначениеИзмененногоПоля = "НомерКон";
			
		ИначеЕсли ИмяЭлемента = "Раздел1Цена" Тогда
			ОбозначениеИзмененногоПоля = "Цена";
			
		ИначеЕсли ИмяЭлемента = "Раздел1Количество" Тогда
			ОбозначениеИзмененногоПоля = "Количество";
		Иначе
			Возврат;
		КонецЕсли;
		
		ОбновитьПоказателиВСтроке0510465(ВидДокумента, ТекДанные, "", ОбозначениеИзмененногоПоля);
		
	ИначеЕсли ИмяТЧ = "Раздел21" Или ИмяТЧ = "ТаблицаФрагментыСтроки" Тогда
		
		// Раздел 2.1 или форма разбивки строки этого раздела
		
		ИмяПоля = СтрЗаменить(ИмяЭлемента, ИмяТЧ, "");
		
		ИзмененоФактическоеНаличие = Ложь;
		ИзмененоСоответствиеАктиву = Ложь;
		
		// Фактическое наличие
		Если ИмяПоля = "НачальныйНомер" Тогда
			ИзмененоФактическоеНаличие = Истина;
			ОбозначениеИзмененногоПоля = "НомерНач";
			
		ИначеЕсли ИмяПоля = "КонечныйНомер" Тогда
			ИзмененоФактическоеНаличие = Истина;
			ОбозначениеИзмененногоПоля = "НомерКон";
			
		ИначеЕсли ИмяПоля = "Количество" Тогда
			ИзмененоФактическоеНаличие = Истина;
			ОбозначениеИзмененногоПоля = "Количество";
			
		ИначеЕсли ИмяПоля = "Сумма" Тогда
			ИзмененоФактическоеНаличие = Истина;
			ОбозначениеИзмененногоПоля = "Сумма";
			
		// Не соответствует условиям актива	
		ИначеЕсли ИмяПоля = "НачальныйНомерНеСоответствует" Тогда
			ИзмененоСоответствиеАктиву = Истина;
			ОбозначениеИзмененногоПоля = "НомерНач";
			
		ИначеЕсли ИмяПоля = "КонечныйНомерНеСоответствует" Тогда
			ИзмененоСоответствиеАктиву = Истина;
			ОбозначениеИзмененногоПоля = "НомерКон";
			
		ИначеЕсли ИмяПоля = "КоличествоНеСоответствует" Тогда
			ИзмененоСоответствиеАктиву = Истина;
			ОбозначениеИзмененногоПоля = "Количество";
			
		ИначеЕсли ИмяПоля = "СуммаНеСоответствует" Тогда
			ИзмененоСоответствиеАктиву = Истина;
			ОбозначениеИзмененногоПоля = "Сумма";
			
		// Цена
		ИначеЕсли ИмяПоля = "Цена" Тогда
			ИзмененоФактическоеНаличие = Истина;
			ОбозначениеИзмененногоПоля = "Цена";
			
		Иначе
			Возврат;
		КонецЕсли;
		
		Если ИзмененоФактическоеНаличие Тогда
			ОбновитьПоказателиВСтроке0510465(ВидДокумента, ТекДанные, "", ОбозначениеИзмененногоПоля, ПараметрыРазбивкиСтроки, РассчитыватьЦену);
			
			// Колонка Цена общая для двух наборов показателей и влияет на оба набора показателей.
			Если ОбозначениеИзмененногоПоля = "Цена" Тогда
				ОбновитьПоказателиВСтроке0510465(ВидДокумента, ТекДанные, "НеСоответствует", ОбозначениеИзмененногоПоля, ПараметрыРазбивкиСтроки);
				
			ИначеЕсли РассчитыватьЦену И ОбозначениеИзмененногоПоля = "Сумма" Тогда
				ОбновитьПоказателиВСтроке0510465(ВидДокумента, ТекДанные, "НеСоответствует", "Количество", ПараметрыРазбивкиСтроки);
			КонецЕсли;
			
		ИначеЕсли ИзмененоСоответствиеАктиву Тогда
			ОбновитьПоказателиВСтроке0510465(ВидДокумента, ТекДанные, "НеСоответствует", ОбозначениеИзмененногоПоля, ПараметрыРазбивкиСтроки);
		КонецЕсли;
		
		ОграничитьДиапазонНомеровНеСоответствующихУсловиюАктива(ВидДокумента, ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьОшибкаМножителяКоличества(ТекДанные) Экспорт
	
	Возврат (ТекДанные.МножительКоличества > 1 Или ТекДанные.МножительКоличества < 0);
	
КонецФункции

Функция ЕстьОтрицательныеЗначения(ТекДанные) Экспорт
	
	Возврат (ТекДанные.Количество < 0 Или ТекДанные.Сумма < 0);
	
КонецФункции

// 0510468

Процедура ОбновитьПоказателиВСтроке0510468(ТекДанные, ИмяИзмененногоПоля, ВалютаРУ, ПрименяемыйКурс = Неопределено, ДопустимостьСумм = Неопределено) Экспорт
	
	УказанаИностраннаяВалюта = УказанаИностраннаяВалюта(ТекДанные, ВалютаРУ);
	
	ОпределятьПрименяемыйКурсИзПоказателейСтроки = УказанаИностраннаяВалюта И ПрименяемыйКурс = Неопределено;
	
	Если ОпределятьПрименяемыйКурсИзПоказателейСтроки Тогда
		ПрименяемыйКурс = ОпределитьПрименяемыйКурсИзПоказателейСтроки(ТекДанные);
	КонецЕсли;
	
	// Новые значения полей, устанавливаемые в результате настройки
	СуммаВал							= ТекДанные.СуммаВал;
	СуммаРуб							= ТекДанные.СуммаРуб;
	СуммаПодтвержденаАктомСверкиВал		= ТекДанные.СуммаПодтвержденаАктомСверкиВал;
	СуммаПодтвержденаАктомСверкиРуб		= ТекДанные.СуммаПодтвержденаАктомСверкиРуб;
	СуммаНеПодтвержденаАктомСверкиВал	= ТекДанные.СуммаНеПодтвержденаАктомСверкиВал;
	СуммаНеПодтвержденаАктомСверкиРуб	= ТекДанные.СуммаНеПодтвержденаАктомСверкиРуб;
	
	Если ДопустимостьСумм = Неопределено Тогда
		ДопустимостьСумм = Новый Структура("Отрицательные,Положительные", Новый Структура(), Новый Структура());
		ДопустимостьСумм.Отрицательные.Вставить("Валютные",	(СуммаВал <= 0));
		ДопустимостьСумм.Отрицательные.Вставить("Рублевые",	(СуммаРуб <= 0));
		ДопустимостьСумм.Положительные.Вставить("Валютные",	(СуммаВал >= 0));
		ДопустимостьСумм.Положительные.Вставить("Рублевые",	(СуммаРуб >= 0));
