#Область СерииДокументов

Процедура СообщитьОСозданииСерииДокументов(КоличествоДокументовСерии, СписокПустыхРазделов) Экспорт
	
	ТекстСообщения = СтрШаблон(НСтр("ru='Обнаружен большой объем данных бух.учета.
		|Выполнена разбивка общего объема данных на несколько документов и их запись.
		|
		|Сформирована серия из %1 документов описей.
		|
		|Данный документ настроен как заголовочный документ серии и не содержит строк в разделах %2.
		|
		|Разделы документа заполнены в других документах серии, см. закладку ""Содержательные документы серии"".'"),
		КоличествоДокументовСерии,
		СписокПустыхРазделов);
	
	ПоказатьПредупреждение(, ТекстСообщения);
	
КонецПроцедуры

// Удаление без очистки
Процедура ПодтвердитьИУдалитьДокументыСерии(ФормаДокумента) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	Если Объект.СписокДокументовСерии.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Список документов пустой, отсутствуют документы для обработки'"));
		
		Возврат;
	КонецЕсли;
	
	СтатистикаПометкиУдаления = ПолучитьСтатистикуПометкиУдаления(Объект.СписокДокументовСерии);
	
	// Если выделенные документы имеют различное состояние пометки (и есть хотя бы один документ
	// с установленной пометкой), то задаем вопрос "Снять".
	Если СтатистикаПометкиУдаления.ЕстьУстановленнаяПометкаУдаления Тогда
		ЗначениеПометкиУдаления = Ложь;
		
		ТекстВопроса = НСтр("ru='Снять со всех содержательных документов пометку на удаление?'");
	Иначе
		ЗначениеПометкиУдаления = Истина;
		
		ТекстВопроса = НСтр("ru='Пометить все содержательные документы на удаление?'");
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ЗначениеПометкиУдаления", ЗначениеПометкиУдаления);
	
	Оповещение = Новый ОписаниеОповещения("ПодтвердитьИУдалитьДокументыСерииЗавершение", ФормаДокумента, ДополнительныеПараметры);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Функция ПолучитьСтатистикуПометкиУдаления(СписокДокументовСерии)

	Результат = Новый Структура();
	Результат.Вставить("ЕстьУстановленнаяПометкаУдаления",	Ложь);
	Результат.Вставить("ЕстьСброшеннаяПометкаУдаления",		Ложь);
	
	Для Каждого СтрокаТаблицы Из СписокДокументовСерии Цикл
		Если СтрокаТаблицы.ПометкаУдаления Тогда
			Результат.ЕстьУстановленнаяПометкаУдаления = Истина;
		Иначе
			Результат.ЕстьСброшеннаяПометкаУдаления = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Удаление с очисткой
Процедура ПодтвердитьОчиститьИУдалитьДокументыСерии(ФормаДокумента) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	Если Объект.СписокДокументовСерии.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Список документов пустой, отсутствуют документы для обработки'"));
		
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru='Все разделы во всех содержательных документах серии
		|будут очищены, а документы помечены на удаление.
		|
		|Внимание: очистка разделов необратима.
		|
		|Продолжить и очистить все содержательные документы?'");
	
	Оповещение = Новый ОписаниеОповещения("ПодтвердитьОчиститьИУдалитьДокументыСерииЗавершение", ФормаДокумента);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

