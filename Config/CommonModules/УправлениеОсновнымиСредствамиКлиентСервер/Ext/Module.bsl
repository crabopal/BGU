// Прочие процедуры и функции.

// Функция возвращает пределы стоимости ОС для определения
// способа начисления амортизации. Пределы стоимости периодические.
// Результат получается на начало года.
// Значение получается функцией УправлениеОсновнымиСредствамиПовтИсп.ПолучитьПараметрыУчетаОС().
//
// Параметры:
//  ДатаРасчета	 - Дата - Дата получения параметров, если не задана то используется текущая дата.
// Возвращаемое значение:
// ФиксированнаяСтруктура - содержит ключи:
//	*ПервыйПределОС - Число - предел стоимости для списания при принятии к учету;
//	*ВторойПределОС - Число - предел стоимости для начисления 100% амортизации при принятии к учету.
Функция ПолучитьПределыОС(Знач ДатаРасчета = Неопределено) Экспорт

	Если ДатаРасчета = Неопределено Тогда
		#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
		ДатаРасчета = НачалоГода(ТекущаяДата());
		#Иначе
		ДатаРасчета = НачалоГода(ОбщегоНазначенияКлиент.ДатаСеанса());
		#КонецЕсли
	КонецЕсли;
	
	Возврат УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ПолучитьПределыОС(ДатаРасчета);
	
КонецФункции

// Функция возвращает расшифровку срока полезного использования в годах и 
// месяцах.
//
// Параметры:
//  СрокПолезногоИспользования - срок полезного использования (в месяцах),
//                 подлежащий расшифровке
//
// Возвращаемое значение:
//  Строка       - расшифровка срока полезного использования в годах и 
//                 месяцах
//
Функция РасшифровкаСрокаПолезногоИспользования(СрокПолезногоИспользования) Экспорт
	
	РасшифровкаСрокаПолезногоИспользования = "";
	
	Если ЗначениеЗаполнено(СрокПолезногоИспользования) Тогда
	
		ЧислоЛет     = Цел(СрокПолезногоИспользования / 12);
		ЧислоМесяцев = (СрокПолезногоИспользования % 12);
		
		Если НЕ (ЧислоЛет = 0) Тогда
			
			// Построим строку с числом лет
			Если (СтрДлина(ЧислоЛет) > 1) И (Число(Сред(ЧислоЛет, СтрДлина(ЧислоЛет) - 1, 1)) = 1) Тогда
				СтрокаГод = " лет";
			ИначеЕсли Число(Прав(ЧислоЛет, 1)) = 1 Тогда
				СтрокаГод = " год";
			ИначеЕсли (Число(Прав(ЧислоЛет, 1)) > 1) И (Число(Прав(ЧислоЛет, 1)) < 5) Тогда
				СтрокаГод = " года";
			Иначе
				СтрокаГод = " лет";
			КонецЕсли;
			
			РасшифровкаСрокаПолезногоИспользования = РасшифровкаСрокаПолезногоИспользования + Строка(ЧислоЛет) + СтрокаГод;
			
		КонецЕсли;
		
		Если НЕ (ЧислоМесяцев = 0) Тогда
			
			// Построим строку с числом месяцев
			Если (СтрДлина(ЧислоМесяцев) > 1) И (Число(Сред(ЧислоМесяцев, СтрДлина(ЧислоМесяцев) - 1, 1)) = 1) Тогда
				СтрокаМесяц = " месяцев";
			ИначеЕсли Число(Прав(ЧислоМесяцев, 1)) = 1 Тогда
				СтрокаМесяц = " месяц";
			ИначеЕсли (Число(Прав(ЧислоМесяцев, 1)) > 1) И (Число(Прав(ЧислоМесяцев, 1)) < 5) Тогда
				СтрокаМесяц = " месяца";
			Иначе
				СтрокаМесяц = " месяцев";
			КонецЕсли;
			
			РасшифровкаСрокаПолезногоИспользования = РасшифровкаСрокаПолезногоИспользования 
													+ ?(НЕ ЗначениеЗаполнено(РасшифровкаСрокаПолезногоИспользования), "", " ") 
													+ Строка(ЧислоМесяцев) 
													+ СтрокаМесяц;
		
		КонецЕсли;
		
		РасшифровкаСрокаПолезногоИспользования = "(" + РасшифровкаСрокаПолезногоИспользования + ")";
		
	КонецЕсли;
	
	Возврат РасшифровкаСрокаПолезногоИспользования;
	
КонецФункции

Функция ОставшийсяСрокПолезногоИспользования(ДатаВводаВЭксплуатацию, СрокПолезногоИспользования, ДатаРасчета) Экспорт
	
	Если ЗначениеЗаполнено(ДатаВводаВЭксплуатацию) Тогда
		ДатаОкончанияЭксплуатации = КонецМесяца(ДобавитьМесяц(ДатаВводаВЭксплуатацию, СрокПолезногоИспользования));
		ВрДата = НачалоМесяца(ДобавитьМесяц(ДатаРасчета,1));
		
		УчитыватьМесяцДаты = (ДатаОкончанияЭксплуатации >= ВрДата);
		ОставшийсяСрокПолезногоИспользования = 
			ОбщегоНазначенияБГУКлиентСервер.КоличествоМесяцевМеждуДатами(
			ВрДата, ДатаОкончанияЭксплуатации, УчитыватьМесяцДаты, УчитыватьМесяцДаты);
		//ОставшийсяСрокПолезногоИспользования = 0;
		//Пока КонецМесяца(ВрДата) <= ДатаОкончанияЭксплуатации Цикл
		//	ОставшийсяСрокПолезногоИспользования = ОставшийсяСрокПолезногоИспользования + 1;
		//	ВрДата = ДобавитьМесяц(ВрДата, 1);
		//КонецЦикла;
	Иначе	
		ОставшийсяСрокПолезногоИспользования = 0;
	КонецЕсли;
	
	Возврат ОставшийсяСрокПолезногоИспользования;
	
КонецФункции

Процедура ПроверитьУстановитьКоличествоОСВСтроке(СтрокаТаблицы) Экспорт

	ЭтоОС          = (СтрокаТаблицы.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС"));
	ЭтоКапВложение = (СтрокаТаблицы.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения"));
	
	ВедетсяКоличественныйУчетПоОбъекту = ЭтоКапВложение
		Или (ЭтоОС И СтрокаТаблицы.ГрупповойУчет И Не ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер))
		Или (ЗначениеЗаполнено(СтрокаТаблицы.СчетУчета) И
			Не БухгалтерскийУчетКлиентСервер.СчетВИерархии(СтрокаТаблицы.СчетУчета, "101.00,102.00,103.00,108.00"));
	
	Если Не ВедетсяКоличественныйУчетПоОбъекту И СтрокаТаблицы.Количество <> 1 Тогда
		
		#Если Клиент Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='По объекту ""%1"" не ведется количественный учет.
			|Для таких объектов количество всегда равно 1 (единице).'"),
			СтрокаТаблицы.ОсновноеСредство);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,
			"ОсновныеСредства[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Количество", "Объект");
		#КонецЕсли
		
		СтрокаТаблицы.Количество = 1;
		
	КонецЕсли;

КонецПроцедуры

Функция СчетСоответствуетВидуИмущества(Счет, ВидИмущества, Ошибки = Неопределено, ПараметрыОшибки = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВидИмущества)
		ИЛИ НЕ ЗначениеЗаполнено(Счет) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВидИмуществаПоСчету = ВидИмуществаПоСчетуУчета(Счет);
	
	Соответствует = ЗначениеЗаполнено(ВидИмуществаПоСчету) И ВидИмущества = ВидИмуществаПоСчету;
	
	Если Не Соответствует И БухгалтерскийУчетВызовСервера.СчетВИерархии(Счет, "02,106.40,106.60,111.60") Тогда
		Соответствует = Истина;
	КонецЕсли;
	
	Если НЕ Соответствует И ПараметрыОшибки <> Неопределено Тогда
		
		ПолеОшибки		= Неопределено;
		ТекстОшибки		= Неопределено;
		ГруппаОшибок	= Неопределено;
		НомерСтроки		= Неопределено;
		ИндексСтроки	= Неопределено;
		
		ПараметрыОшибки.Свойство("ПолеОшибки",		ПолеОшибки);
		ПараметрыОшибки.Свойство("ТекстОшибки",		ТекстОшибки);
		ПараметрыОшибки.Свойство("ГруппаОшибок",	ГруппаОшибок);
		ПараметрыОшибки.Свойство("НомерСтроки",		НомерСтроки);
		ПараметрыОшибки.Свойство("ИндексСтроки",	ИндексСтроки);
		
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда            
			Если ЗначениеЗаполнено(НомерСтроки) Тогда
				ТекстОшибки = СтрШаблон(
					НСтр("ru = 'В строке %1 счет учета объекта ОС, НМА, НПА не соответствует выбранному виду имущества.'"),
					НомерСтроки);
			Иначе	
				ТекстОшибки = 
					НСтр("ru = 'Счет учета объекта ОС, НМА, НПА не соответствует выбранному виду имущества.'");
			КонецЕсли;	
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
			ПолеОшибки, ТекстОшибки, ГруппаОшибок, НомерСтроки, ТекстОшибки, ИндексСтроки);
		
	КонецЕсли;
	
	Возврат Соответствует;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ПрослеживаемыйТовар

Функция ДоступнаПрослеживаемость(Объект) Экспорт
	
	Если Объект.ИмуществоКазны Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ПрослеживаемыйВидНФА(Объект.ВидНФА) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Объект.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС")
		И НЕ ПрослеживаемыйТипНФА(Объект.ТипНФА) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

Функция ПрослеживаемыйВидНФА(ВидНФА) Экспорт
	Возврат ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения")
		ИЛИ ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС");
КонецФункции

Функция ПрослеживаемыйТипНФА(ТипНФА) Экспорт
	Возврат ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.Инвентарь")
		ИЛИ ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.Оборудование")
		ИЛИ ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.Прочие")
		ИЛИ ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.Транспорт");
КонецФункции

Функция ПризнакЕстьПрослеживаемыеТоварыВШапке(ВидПоступления) Экспорт
	Возврат	ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление")
		Или ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение");
КонецФункции

Функция ПризнакЕстьПрослеживаемыеТоварыВТабличнойЧасти(ВидПоступления) Экспорт
	Возврат ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс")
		Или ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21")
		Или ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс");
КонецФункции

#КонецОбласти

#Область СуммыРемонтаИМодернизацииПоКФО

// Выполняет распределение суммы затрат на ремонт и/или модернизацию, детализированной по КФО
// по суммам затрат, детализированных по КФО, по каждому объекту табличной части документа
//
// Параметры:
//  Форма - ДанныеФормыСтруктура - форма документа, из которого вызвана процедура
Процедура РаспределитьЗатратыПоСуммамХвТЧ(Форма) Экспорт
	ОбнулитьСуммыХвТЧ(Форма);

	Объект = Форма.Объект;
	МетаданныеДокумента = МетаданныеДокументаМодернизации(Форма);
	СуммаЗатратПоТЧ = СуммаКапвложенийВМодернизациюПоТЧ(Форма, МетаданныеДокумента.ВидДокумента);
	
	МаксИндекс = Объект.ОсновныеСредства.Количество() - 1;
	Для каждого ТекСтрока из Объект.ОсновныеСредства Цикл
		ЭтоПоследняяСтрока = (Объект.ОсновныеСредства.Индекс(ТекСтрока) = МаксИндекс);
		Если ЭтоПоследняяСтрока И СуммаЗатратПоТЧ = Объект[МетаданныеДокумента.ИмяРеквизитаСуммаДокумента] Тогда
			Для к = 1 по 7 Цикл
				Если к = 3 Тогда
					Продолжить;
				КонецЕсли;	
				
				ТекСтрока["Сумма" + к] = Объект["Сумма" + к] - Объект.ОсновныеСредства.Итог("Сумма" + к);
			КонецЦикла;	
		Иначе	
			МаксНенулевоеКФО = 0;
			Для к = 1 по 7 Цикл
				Если к = 3 Тогда
					Продолжить;
				ИначеЕсли Объект["Сумма" + к] = 0 Тогда
					Продолжить;
				КонецЕсли;	
				
				МаксНенулевоеКФО = к;
			КонецЦикла;	
			
			СуммаЗатратПоСтроке = СуммаКапвложенийВМодернизациюПоСтрокеТЧ(
				Форма, ТекСтрока, МетаданныеДокумента.ВидДокумента);
			СуммаСобранная = 0;
			Для к = 1 по 7 Цикл
				Если к = 3 Тогда
					Продолжить;
				КонецЕсли;	
				
				Если к = МаксНенулевоеКФО Тогда
					ТекСтрока["Сумма" + к] = СуммаЗатратПоСтроке - СуммаСобранная; 
				ИначеЕсли Объект[МетаданныеДокумента.ИмяРеквизитаСуммаДокумента] = 0 Тогда
					ТекСтрока["Сумма" + к] = 0; 
				Иначе		
					ТекСтрока["Сумма" + к] = СуммаЗатратПоСтроке 
						* Окр(Объект["Сумма" + к] / Объект[МетаданныеДокумента.ИмяРеквизитаСуммаДокумента], 10);
					СуммаСобранная = СуммаСобранная + ТекСтрока["Сумма" + к];
				КонецЕсли;		
			КонецЦикла;	
		КонецЕсли;	
		СформироватьЗаголовокСуммыПоКФОвТЧ(ТекСтрока)
	КонецЦикла;	
КонецПроцедуры

// Выполняет заполнение одной из сумм по КФО (Сумма1, Сумма2 и т.д.) по общей сумме затрат, указанной в документе
// Сумма1, Сумма2 и т.д - реквизиты документа, содержащие сумму затрат на ремонт и модернизацию по соответствующему КФО
//
// Параметры:
//  Форма - ДанныеФормыСтруктура - форма документа, из которого вызвана процедура
Процедура ЗаполнитьСуммыХПоСуммеДокумента(Форма) Экспорт
	МетаданныеДокумента = МетаданныеДокументаМодернизации(Форма);
	Объект = Форма.Объект;
	Для к = 1 по 7 Цикл
		Если к = 3 Тогда
			Продолжить;
		КонецЕсли;	
		
		Если Строка(к) = Строка(Объект.КФО) Тогда
			Объект["Сумма" + к] = Объект[МетаданныеДокумента.ИмяРеквизитаСуммаДокумента];
		Иначе	
			Объект["Сумма" + к] = 0;
		КонецЕсли;	
	КонецЦикла;	
	СформироватьЗаголовокСуммыПоКФО(Форма);
КонецПроцедуры	

// Обнуляет все суммы по КФО (Сумма1, Сумма2 и т.д.) во всех строках табличной части документа.
// Сумма1, Сумма2 и т.д - реквизиты табличной части документа, содержащие сумму затрат на ремонт и модернизацию по 
// соответствующему КФО по объекту
//
// Параметры:
//  Форма - ДанныеФормыСтруктура - форма документа, из которого вызвана процедура
Процедура ОбнулитьСуммыХвТЧ(Форма) Экспорт
	Объект = Форма.Объект;
	Для каждого ТекСтрока из Объект.ОсновныеСредства Цикл
		ОбнулитьСуммыХвСтрокеТЧ(ТекСтрока);
	КонецЦикла;	
КонецПроцедуры	

// Обнуляет все суммы по КФО (Сумма1, Сумма2 и т.д.) в строке табличной части документа.
// Сумма1, Сумма2 и т.д - реквизиты табличной части документа, содержащие сумму затрат на ремонт и модернизацию по 
// соответствующему КФО по объекту
//
// Параметры:
//  ТекСтрока - ДанныеФормыКоллекция - строка табличной части документа
Процедура ОбнулитьСуммыХвСтрокеТЧ(ТекСтрока) Экспорт
	Для к = 1 по 7 Цикл
		Если к = 3 Тогда
			Продолжить;
		КонецЕсли;	
		ТекСтрока["Сумма" + к] = 0;
	КонецЦикла;	
	СформироватьЗаголовокСуммыПоКФОвТЧ(ТекСтрока);
КонецПроцедуры	

// Формирует заголовок гиперссылки "СуммыПоКФО" во всех строках табличной части документа
//
// Параметры:
//  Форма - ДанныеФормыСтруктура - форма документа, из которого вызвана процедура
Процедура СформироватьЗаголовокСуммыПоКФОвТЧПоВсем(Форма) Экспорт
	Для каждого ТекСтрока из Форма.Объект.ОсновныеСредства Цикл
		СформироватьЗаголовокСуммыПоКФОвТЧ(ТекСтрока);
	КонецЦикла;	
КонецПроцедуры	

// Формирует заголовок гиперссылки "СуммыПоКФО" в строке табличной части документа
//
// Параметры:
//  ТекСтрока - ДанныеФормыКоллекция - строка табличной части документа
Процедура СформироватьЗаголовокСуммыПоКФОвТЧ(ТекСтрока) Экспорт
	ТекСтрока.СуммыПоКФО = ТекстЗаголовкаСуммыПоКФО(ТекСтрока);
КонецПроцедуры	

// Формирует заголовок гиперссылки "СуммыПоКФО" в шапке формы документа
//
// Параметры:
//  Форма - ДанныеФормыСтруктура - форма документа, из которого вызвана процедура
Процедура СформироватьЗаголовокСуммыПоКФО(Форма) Экспорт
	Объект = Форма.Объект;
	МетаданныеДокумента = МетаданныеДокументаМодернизации(Форма);
	
	Форма.Элементы.ДекорацияСуммыПоКФО.Заголовок = ТекстЗаголовкаСуммыПоКФО(Объект);
	Итог = 0;
	Для к = 1 по 7 Цикл
		Если к = 3 Тогда
			Продолжить;
		КонецЕсли;	
		Итог = Итог + Объект["Сумма" + к];
	КонецЦикла;	
	Форма.Элементы.ДекорацияСуммыПоКФО.ЦветТекста = 
	?(Итог = Объект[МетаданныеДокумента.ИмяРеквизитаСуммаДокумента]
	ИЛИ Итог = 0, Новый Цвет(), ЦветОшибкиВПодвалеТаблицыСуммыПоКФО());
КонецПроцедуры	

