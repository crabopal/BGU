#Область ПринятиеКУчетуОбъектовОС

Функция ЭтоПриобретениеИлиИзготовление(ВидОперации) Экспорт
	
	Возврат ВидОперации 
				= ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение")
			ИЛИ ВидОперации 
				= ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление")
			ИЛИ ВидОперации
				= ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПринятиеКУчетуИзготовление");
	
КонецФункции

Функция ЭтоПоступлениеИзПользования(ВидОперации) Экспорт
	
	Операции = Новый Массив;
	
	Операции.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды"));
	Операции.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользования"));
	Операции.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАрендыОперУчет"));
	Операции.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользованияОперУчет"));
	Операции.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзУправления"));
	Операции.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзУправленияОперУчет"));
	Операции.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратАренда"));
	Операции.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратБезвозмездноеПользование"));
	Операции.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратУправление"));
	Операции.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ВозвратЗемУчастковИзПользования"));
	
	Возврат Операции.Найти(ВидОперации) <> Неопределено;
	
КонецФункции

// Функция проверяет необходимость заполнения инв. номера по переданным параметрам или объекту ОС
//
// Параметры:
//  ОбъектОС	 - СправочникСсылка.ОсновныеСредства - проверяемый объект. Может быть не задан,
// если заданы параметры ВидНФА и СчетУчета,
//  ВидНФА		 - ПеречислениеСсылка.ВидыНФА - вид НФА объекта. Может быть не задан, если задан
// параметр ОбъектОС
//  СчетУчета	 - ПланСчетовСсылка.ЕПСБУ - счет учета объекта.  Может быть не задан, если задан
// параметр ОбъектОС
//  Цена		 - Число - цена объекта
//  Причина		 - Строка - возвращаемый параметр, пояснение, почему обязательно указывать инв. номер
// Возвращаемое значение:
// Булево - Истина, если обязательно указание инв. номера, Ложь - если не обязательно.
Функция ДляОбъектаОбязательноУказаниеИнвНомера(Знач ОбъектОС, Знач ВидНФА, Знач СчетУчета, Цена, Причина = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ОбъектОС) И Не ЗначениеЗаполнено(ВидНФА) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	#Если Сервер Тогда
	
	Если Не ЗначениеЗаполнено(ВидНФА) Тогда
		ВидНФА = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектОС, "ВидНФА");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СчетУчета) Тогда
		СчетУчета = УправлениеОсновнымиСредствами.СчетУчетаОС(ОбъектОС);
	КонецЕсли;
	
	#КонецЕсли

	Если ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА")
		Или ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА") Тогда
		
		Причина = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для объектов %1 обязательно указание инвентарного номера.'"),
			Строка(ВидНФА));
		Возврат Истина;
		
	ИначеЕсли ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС") Тогда
		
		ПределыОС = УправлениеОсновнымиСредствамиКлиентСервер.ПолучитьПределыОС();
		Если ОбъектОС.ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.БиблиотечныйФонд") Тогда
			// для библиотечного фонда инв. номер обязателен для ОС дороже 100 000
			Если Цена > ПределыОС.ВторойПределОС Тогда
				Причина = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для библиотечного фонда дороже %1 обязательно указание инвентарного номера.'"),
					ПределыОС.ВторойПределОС);
				Возврат Истина;
			Иначе
				Возврат Ложь;
			КонецЕсли;
			Возврат Цена > ПределыОС.ВторойПределОС;
		Иначе
			// для остальных ОС инв. номер обязателен для ОС дороже 10 000 или недвижимого имущества
			Если Цена > ПределыОС.ПервыйПределОС Тогда
				Причина = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для основных средств дороже %1 обязательно указание инвентарного номера.'"),
					ПределыОС.ПервыйПределОС);
				Возврат Истина;
			ИначеЕсли БухгалтерскийУчетВызовСервера.СчетВИерархии(СчетУчета, "101.10,01.11,01.12") Тогда
				Причина = НСтр("ru = 'Для недвижимого имущества обязательно указание инвентарного номера.'");
				Возврат Истина;
			Иначе
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// остались кап. вложения и непредвиденные случаи
	Возврат Ложь;

КонецФункции

// Определяет структуру порядка амортизации, возвращаемую функцией "РекомендуемыйПорядокПогашенияСтоимости"
//
// Возвращаемое значение:
//  - Структура из:
//    * ПорядокПогашенияСтоимости - ПеречислениеСсылка.ПорядокПогашенияСтоимостиОС
//    * СпособНачисленияАмортизации - ПеречислениеСсылка.СпособНачисленияАмортизации
//    * ПринятиеКУчетуОдновременноСВводомВЭксплуатацию - Булево
//    * ПояснениеУказанногоПорядка - Строка
//    * ДопустимыеСпособыНачисленияАмортизации - Массив из ПеречислениеСсылка.СпособНачисленияАмортизации
Функция СтруктураПорядкаАмортизации() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ПорядокПогашенияСтоимости");
	Результат.Вставить("СпособНачисленияАмортизации");
	Результат.Вставить("ПринятиеКУчетуОдновременноСВводомВЭксплуатацию");
	Результат.Вставить("ПояснениеУказанногоПорядка", "");
	Результат.Вставить("ДопустимыеСпособыНачисленияАмортизации",  Новый Массив);
	
	Возврат Результат;
КонецФункции	

//Вычисляет рекомендованный порядок амортизации в зависимости от переданных параметров ОС
//
// Параметры:
//  ВидНФА - ПеречислениеСсылка.ВидыНФА
//  ТипНФА - Перечисление.ТипыНФА
//  Стоимость - Число - стоимость единицы ОС, НМА, НПА
//  Дата - Дата - дата, на которую определяется порядок
//  ВидИмущества - Перечисление.ВидыИмущества
//  СрокПолезногоИспользования - Число - срок полезного использования НМА. Используется только для НМА 
//  СчетУчета - ПланСчетовСсылка.ЕПСБУ - счет учета НПА. Используется для НПА, являющимся имуществом казны
//
//Возвращаемое значение:
//  - Структура - см. СтруктураПорядкаАмортизации() 
Функция РекомендуемыйПорядокПогашенияСтоимости(ВидНФА, ТипНФА, Стоимость, 
	Дата, ВидИмущества = Неопределено, СрокПолезногоИспользования = 1, СчетУчета = Неопределено) Экспорт
	
	Если ТипЗнч(ВидНФА) <> Тип("ПеречислениеСсылка.ВидыНФА") Тогда
		ВызватьИсключение "Неверные параметры функции УправлениеОсновнымиСредствамиКлиентСервер.РекомендуемыйПорядокПогашенияСтоимости";
	КонецЕсли;
	
	ПределыОС = УправлениеОсновнымиСредствамиКлиентСервер.ПолучитьПределыОС(Дата);
	Если ПределыОС.ПервыйПределОС = 0 И ПределыОС.ВторойПределОС = 0 Тогда
		
		ТекстИсключения = НСтр("ru = 'Не заданые пределы стоимости учета ОС.
			|Необходимо указать пределы стоимости ОС в регистре сведений ""Параметры учета ОС"".
			|Обратитесь к администратору информационной базы.'");
		
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Результат = СтруктураПорядкаАмортизации();
	ЭтоБиблиотечныйФонд = (ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.БиблиотечныйФонд"));
	ЭтоНедвижимоеИмущество = (ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество"));
	// Счет 108.55 это НПА казны и для него нет соответствующего счета начисления амортизации
	// Поэтому, если счет учета 108.55, то амортизация начисляться не должна
	Счет10855 = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("108.55");
	
	Если ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА")
		Или ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА") И СрокПолезногоИспользования = 0 
		Или ЗначениеЗаполнено(СчетУчета) И СчетУчета = Счет10855 Тогда
		Результат.ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");
		Результат.СпособНачисленияАмортизации	= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
		Результат.ДопустимыеСпособыНачисленияАмортизации.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка"));		
		
		Если ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА") Тогда
			Результат.ПояснениеУказанногоПорядка = НСтр("ru = 'На объект НПА не должна начисляться амортизация'");
		ИначеЕсли ЗначениеЗаполнено(СчетУчета) И СчетУчета = Счет10855 Тогда
			Результат.ПояснениеУказанногоПорядка = НСтр("ru = 'На объект, учитываемый на счете 108.55, не должна начисляться амортизация'");
		Иначе
			Результат.ПояснениеУказанногоПорядка = НСтр("ru = 'На объект НМА с неопределенным сроком полезного использования не должна начисляться амортизация'");
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Стоимость)
		И Стоимость > ПределыОС.ВторойПределОС Тогда
		
		Результат.ПорядокПогашенияСтоимости   = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");
		Результат.СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный");
		Результат.ДопустимыеСпособыНачисленияАмортизации.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный"));		
		Результат.ДопустимыеСпособыНачисленияАмортизации.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка"));		
		Результат.ДопустимыеСпособыНачисленияАмортизации.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции"));		
		
		Результат.ПояснениеУказанногоПорядка =
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'На объект стоимостью более %1 должна начисляться амортизация в соответствии с рассчитанными нормами амортизации'"),
				ПределыОС.ВторойПределОС);   
		
	ИначеЕсли ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА")
		Или (ЗначениеЗаполнено(Стоимость) И Стоимость > ПределыОС.ПервыйПределОС)
		Или ЭтоБиблиотечныйФонд 
		Или ЭтоНедвижимоеИмущество Тогда
		
		Результат.ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");
		Результат.СпособНачисленияАмортизации	= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию");
		Результат.ДопустимыеСпособыНачисленияАмортизации.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию"));		
		
		Если ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА") Тогда
			Результат.ПояснениеУказанногоПорядка =
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'На объект НМА стоимостью не более %1 должна начисляться 100% амортизация при вводе в эксплуатацию'"),
					ПределыОС.ВторойПределОС);
		ИначеЕсли ЭтоБиблиотечныйФонд Тогда
			Результат.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию = Истина;
			Результат.ПояснениеУказанногоПорядка =
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'На библиотечный фонд стоимостью не более %1 должна начисляться 100% амортизация при вводе в эксплуатацию (ввод в эксплуатацию обязательно при принятии к учету)'"),
					ПределыОС.ВторойПределОС);
		ИначеЕсли ЭтоНедвижимоеИмущество Тогда
			Результат.ПояснениеУказанногоПорядка =
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'На недвижимое имущество стоимостью не более %1 должна начисляться 100% амортизация при вводе в эксплуатацию'"),
					ПределыОС.ВторойПределОС);
		Иначе
			Результат.ПояснениеУказанногоПорядка =
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'На объект стоимостью более %1 и не более %2 должна начисляться 100% амортизация при вводе в эксплуатацию'"),
					ПределыОС.ПервыйПределОС,
					ПределыОС.ВторойПределОС);
		КонецЕсли;
		
	ИначеЕсли ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС")
		И ЗначениеЗаполнено(Стоимость)
		И Стоимость <= ПределыОС.ПервыйПределОС Тогда
		
		Результат.ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию");
		Результат.СпособНачисленияАмортизации	= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
		Результат.ДопустимыеСпособыНачисленияАмортизации.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка"));		

		Результат.ПояснениеУказанногоПорядка =
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Объекты ОС стоимостью не более %1 списываются при вводе в эксплуатацию'"),
				ПределыОС.ПервыйПределОС);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ПроверитьЗаполнениеСтрокиПринятияКУчетуБУ(ТекущаяСтрока, НеЗаполнятьОшибки,
	ПараметрыОшибок, Ошибки) Экспорт
	
	ЗаполненоКорректно = Истина;
	
	Если ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
		"Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
		
		ПараметрыОшибок.Вставить("ПредставлениеПоля", "Способ начисления амортизации");
		ПараметрыОшибок.Вставить("ИмяПоля", "СпособНачисленияАмортизации");
		ЗаполненоКорректно =
			ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
				ПараметрыОшибок, Ошибки) И ЗаполненоКорректно;
		
		Если НеЗаполнятьОшибки И НЕ ЗаполненоКорректно Тогда
			Возврат ЗаполненоКорректно;
		КонецЕсли;
		
	КонецЕсли;
	
	Если (ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
		"Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
		ИЛИ ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
		"Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию"))
		И ПараметрыОшибок.ПроверятьЗаполнениеСчетаУчетаЗатрат Тогда
		
		// заполнение счета списания затрат
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.СчетУчетаЗатрат) Тогда
			
			ПараметрыОшибок.Вставить("ПредставлениеПоля", "Счет учета затрат");
			ПараметрыОшибок.Вставить("ИмяПоля", "СчетУчетаЗатрат");
			ЗаполненоКорректно =
				ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
					ПараметрыОшибок, Ошибки) И ЗаполненоКорректно;
			
			Если НеЗаполнятьОшибки И НЕ ЗаполненоКорректно Тогда
				Возврат ЗаполненоКорректно;
			КонецЕсли;
			
		Иначе
			
			Если Не ЗначениеЗаполнено(ТекущаяСтрока.КЭКЗатрат) Тогда
				
				ПараметрыОшибок.Вставить("ПредставлениеПоля", "КЭК затрат");
				ПараметрыОшибок.Вставить("ИмяПоля", "КЭКЗатрат");
				ЗаполненоКорректно =
					ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
						ПараметрыОшибок, Ошибки) И ЗаполненоКорректно;
				
				Если НеЗаполнятьОшибки И НЕ ЗаполненоКорректно Тогда
					Возврат ЗаполненоКорректно;
				КонецЕсли;
				
			КонецЕсли;
			
			СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(
				ТекущаяСтрока.СчетУчетаЗатрат);
			
			Если ПараметрыОшибок.УчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям
				И Не СвойстваСчета.РазрешитьНеУказыватьПодразделение И Не ЗначениеЗаполнено(ТекущаяСтрока.ПодразделениеЗатрат) Тогда
				
				ПараметрыОшибок.Вставить("ПредставлениеПоля", "Подразделение затрат");
				ПараметрыОшибок.Вставить("ИмяПоля", "ПодразделениеЗатрат");
				ЗаполненоКорректно =
					ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
						ПараметрыОшибок, Ошибки) И ЗаполненоКорректно;
				
				Если НеЗаполнятьОшибки И НЕ ЗаполненоКорректно Тогда
					Возврат ЗаполненоКорректно;
				КонецЕсли;
				
			КонецЕсли;
			
			Для СчетчикСубконто = 1 По 3 Цикл
			
				Если СвойстваСчета["ВидСубконто" + СчетчикСубконто + "Обязательный"] = Истина
					И Не ЗначениеЗаполнено(ТекущаяСтрока["СубконтоЗатрат" + СчетчикСубконто]) Тогда
					
					ПараметрыОшибок.Вставить("ПредставлениеПоля", "Субконто затрат: "
						+ СвойстваСчета["ВидСубконто" + СчетчикСубконто + "Наименование"]);
					ПараметрыОшибок.Вставить("ИмяПоля", "СубконтоЗатрат" + СчетчикСубконто);
					ЗаполненоКорректно =
						ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока,
							НеЗаполнятьОшибки, ПараметрыОшибок, Ошибки) И ЗаполненоКорректно;
					
					Если НеЗаполнятьОшибки И НЕ ЗаполненоКорректно Тогда
						Возврат ЗаполненоКорректно;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗаполненоКорректно;
	
КонецФункции

Функция ПроверитьЗаполнениеСтрокиПринятияКУчетуНУ(ТекущаяСтрока, НеЗаполнятьОшибки,
	ПараметрыОшибок, Ошибки) Экспорт
	
	ЗаполненоКорректно = Истина;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ПорядокПогашенияСтоимости)
	И НЕ ЗначениеЗаполнено(ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовНУ) Тогда
		
		ПараметрыОшибок.Вставить("ПредставлениеПоля", "Порядок включения стоимости в состав расходов (НУ)");
		ПараметрыОшибок.Вставить("ИмяПоля", "ПорядокВключенияСтоимостиВСоставРасходовНУ");
		ЗаполненоКорректно = ЗаполненоКорректно И
			ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
				ПараметрыОшибок, Ошибки);
		
		Возврат ЗаполненоКорректно;
		
	ИначеЕсли ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда
		
		// дальнейшая проверка не требуется
		Возврат ЗаполненоКорректно;
		
	КонецЕсли;
	
	Если НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(ТекущаяСтрока.СчетУчетаЗатрат)
		И НЕ ЗначениеЗаполнено(ТекущаяСтрока.СтатьяПрочихРасходов) Тогда
		
		ПараметрыОшибок.Вставить("ПредставлениеПоля", "Статья прочих расходов (НУ)");
		ПараметрыОшибок.Вставить("ИмяПоля", "СтатьяПрочихРасходов");
		ЗаполненоКорректно = ЗаполненоКорректно И
			ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
				ПараметрыОшибок, Ошибки);
		
		Если НеЗаполнятьОшибки И НЕ ЗаполненоКорректно Тогда
			Возврат ЗаполненоКорректно;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации") Тогда
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.СрокПолезногоИспользованияНУ) Тогда
			
			ПараметрыОшибок.Вставить("ПредставлениеПоля", "Срок полезного использования (НУ)");
			ПараметрыОшибок.Вставить("ИмяПоля", "СрокПолезногоИспользованияНУ");
			ЗаполненоКорректно = ЗаполненоКорректно И
				ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
					ПараметрыОшибок, Ошибки);
			
			Если НеЗаполнятьОшибки И НЕ ЗаполненоКорректно Тогда
				Возврат ЗаполненоКорректно;
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
		
	Если (ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации")
		ИЛИ ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету"))
		И ТекущаяСтрока.ПроцентКапитальныхВложенийВключаемыхВРасходыНУ > 0 Тогда
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.СчетУчетаЗатратПоАмортизационнойПремии) Тогда
			
			ПараметрыОшибок.Вставить("ПредставлениеПоля", "Счет учета затрат по амортизационной премии (НУ)");
			ПараметрыОшибок.Вставить("ИмяПоля", "СчетУчетаЗатратПоАмортизационнойПремии");
			ЗаполненоКорректно = ЗаполненоКорректно И
				ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
					ПараметрыОшибок, Ошибки);
			
			Если НеЗаполнятьОшибки И НЕ ЗаполненоКорректно Тогда
				Возврат ЗаполненоКорректно;
			КонецЕсли;
			
		Иначе
			
			СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(
				ТекущаяСтрока.СчетУчетаЗатратПоАмортизационнойПремии);
			
			Если ПараметрыОшибок.УчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям
				И Не ЗначениеЗаполнено(ТекущаяСтрока.ПодразделениеПоАмортизационнойПремии) Тогда
				
				ПараметрыОшибок.Вставить("ПредставлениеПоля", "Подразделение затрат по амортизационной премии (НУ)");
				ПараметрыОшибок.Вставить("ИмяПоля", "ПодразделениеПоАмортизационнойПремии");
				ЗаполненоКорректно = ЗаполненоКорректно И
					ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
						ПараметрыОшибок, Ошибки);
				
				Если НеЗаполнятьОшибки И НЕ ЗаполненоКорректно Тогда
					Возврат ЗаполненоКорректно;
				КонецЕсли;
			
			КонецЕсли;
			
			Для СчетчикСубконто = 1 По 3 Цикл
			
				Если СвойстваСчета["ВидСубконто" + СчетчикСубконто + "Обязательный"] = Истина Тогда
					
					ПараметрыОшибок.Вставить("ПредставлениеПоля", "Субконто затрат по амортизационной премии (НУ): "
						+ СвойстваСчета["ВидСубконто" + СчетчикСубконто + "Наименование"]);
					ПараметрыОшибок.Вставить("ИмяПоля", "СубконтоПоАмортизационнойПремии"
						+ СчетчикСубконто);
					ЗаполненоКорректно = ЗаполненоКорректно И
						ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
							ПараметрыОшибок, Ошибки);
					
					Если НеЗаполнятьОшибки И НЕ ЗаполненоКорректно Тогда
						Возврат ЗаполненоКорректно;
					КонецЕсли;
					
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	Возврат ЗаполненоКорректно;

КонецФункции

Функция ПроверитьЗаполнениеСтрокиПринятияКУчетуУСН(ТекущаяСтрока, НеЗаполнятьОшибки,
	ПараметрыОшибок, Ошибки) Экспорт
	
	ЗаполненоКорректно = Истина;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ПорядокПогашенияСтоимости)
	И НЕ ЗначениеЗаполнено(ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовУСН) Тогда
		
		ПараметрыОшибок.Вставить("ПредставлениеПоля", "Порядок включения стоимости в состав расходов (УСН)");
		ПараметрыОшибок.Вставить("ИмяПоля", "ПорядокВключенияСтоимостиВСоставРасходовУСН");
		ЗаполненоКорректно = ЗаполненоКорректно И
			ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
				ПараметрыОшибок, Ошибки);
		
		Возврат ЗаполненоКорректно;
		
	ИначеЕсли ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовУСН = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.НеВключатьВСоставРасходов") Тогда
		
		// дальнейшая проверка не требуется
		Возврат ЗаполненоКорректно;
		
	КонецЕсли;
	
	Если ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовУСН = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА") Тогда
		
		ПараметрыОшибок.Вставить("ПредставлениеПоля", "Срок полезного использования (УСН)");
		ПараметрыОшибок.Вставить("ИмяПоля", "СрокПолезногоИспользованияУСН");
		ЗаполненоКорректно = ЗаполненоКорректно И
			ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
				ПараметрыОшибок, Ошибки);
		
		Если НеЗаполнятьОшибки И НЕ ЗаполненоКорректно Тогда
			Возврат ЗаполненоКорректно;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗаполненоКорректно;

КонецФункции

Функция ПроверитьЗаполнениеПоляСтрокиПринятияКУчету(ТекущаяСтрока, НеЗаполнятьОшибки,
	ПараметрыОшибок, Ошибки)
	
	ЗаполненоКорректно = Истина;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока[ПараметрыОшибок.ИмяПоля]) Тогда
		ЗаполненоКорректно = Ложь;
		Если НЕ НеЗаполнятьОшибки Тогда
			ДобавитьОшибкуПроверкиСтрокиПринятияКУчету(Ошибки, ПараметрыОшибок);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗаполненоКорректно;
	
КонецФункции

Процедура ДобавитьОшибкуПроверкиСтрокиПринятияКУчету(Ошибки, ПараметрыОшибок)

	ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
		ПараметрыОшибок.ВидПоля, ПараметрыОшибок.ВидСообщения,
		ПараметрыОшибок.ПредставлениеПоля, ПараметрыОшибок.НомерСтроки,
		ПараметрыОшибок.ПредставлениеСписка, ПараметрыОшибок.ТекстСообщения);
		
	ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
		ПараметрыОшибок.ИмяСписка + "." + ПараметрыОшибок.ИмяПоля, ТекстСообщения,
		ПараметрыОшибок.ГруппаОшибок, ПараметрыОшибок.ИндексСтроки,
		ТекстСообщения, ПараметрыОшибок.ИндексСтроки);

КонецПроцедуры

Функция ОтражатьВНалоговомУчетеПринятиеКУчету(Объект) Экспорт

	Возврат (ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления)
			ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение(
				"Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс")
			ИЛИ Объект.ВидПоступления = ПредопределенноеЗначение(
				"Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет101"))
		И НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, Объект.КФО);
	
КонецФункции

Функция ОтражатьВУСНДоходыМинусРасходыПринятиеКУчету(Объект) Экспорт

	Возврат ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления)
		И УчетУСНКлиентСервер.ОтражатьВУСНДоходыМинусРасходы(Объект.Организация, Объект.Дата, Объект.КФО);
	
КонецФункции

Функция ПараметрыПроверкиДанныхСтрокиПринятияКУчету() Экспорт

	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("НеЗаполнятьОшибки");
	ПараметрыПроверки.Вставить("Объект");
	ПараметрыПроверки.Вставить("УчетПоПодразделениям");
	ПараметрыПроверки.Вставить("ИндексСтроки");
	ПараметрыПроверки.Вставить("НомерСтроки");
	ПараметрыПроверки.Вставить("ПроверятьЗаполнениеСчетаУчетаЗатрат");
	ПараметрыПроверки.Вставить("ОтражениеВУчетеБУЗаполненоНекорректно", Ложь);
	ПараметрыПроверки.Вставить("ПроверятьКоличествоВТабЧасти", Истина);

	ПараметрыПроверки.Вставить("ОтражениеВУчетеНУЗаполненоНекорректно", Ложь);
	ПараметрыПроверки.Вставить("ОтражениеВУчетеУСНЗаполненоНекорректно", Ложь);
	ПараметрыПроверки.Вставить("ОтражатьВНалоговомУчете");
	ПараметрыПроверки.Вставить("ОтражатьВУСНДоходыМинусРасходы");
	
	Возврат ПараметрыПроверки;

КонецФункции // ПараметрыПроверкиДанныхСтрокиПринятияКУчету()

Функция ДанныеСтрокиПринятияКУчетуЗаполненыКорректно(ТекущаяСтрока, ПараметрыПроверки, Ошибки, ЕстьНУ = Истина) Экспорт
	
	НеЗаполнятьОшибки = ПараметрыПроверки.НеЗаполнятьОшибки;
	Объект = ПараметрыПроверки.Объект;
	УчетПоПодразделениям = ПараметрыПроверки.УчетПоПодразделениям;
	ИндексСтроки = ПараметрыПроверки.ИндексСтроки;
	НомерСтроки = ПараметрыПроверки.НомерСтроки;
	ПроверятьЗаполнениеСчетаУчетаЗатрат = ПараметрыПроверки.ПроверятьЗаполнениеСчетаУчетаЗатрат;
	
	// возвращаемые параметры
	ПараметрыПроверки.ОтражениеВУчетеБУЗаполненоНекорректно  = Ложь;

	ПараметрыПроверкиОшибок = Новый Структура;
	ПараметрыПроверкиОшибок.Вставить("ВидПоля","Колонка");
	ПараметрыПроверкиОшибок.Вставить("ВидСообщения", "Заполнение");
	ПараметрыПроверкиОшибок.Вставить("НомерСтроки",ТекущаяСтрока.НомерСтроки);
	ПараметрыПроверкиОшибок.Вставить("ТекстСообщения","");
	ПараметрыПроверкиОшибок.Вставить("ПредставлениеСписка","Основные средства");
	ПараметрыПроверкиОшибок.Вставить("ИмяСписка","Объект.ОсновныеСредства[%1]");
	ПараметрыПроверкиОшибок.Вставить("ГруппаОшибок","Объект.ОсновныеСредства");
	ПараметрыПроверкиОшибок.Вставить("ИндексСтроки",ИндексСтроки);
	ПараметрыПроверкиОшибок.Вставить("ПроверятьЗаполнениеСчетаУчетаЗатрат",
		ПроверятьЗаполнениеСчетаУчетаЗатрат);
	ПараметрыПроверкиОшибок.Вставить("ПредставлениеПоля");
	ПараметрыПроверкиОшибок.Вставить("УчетПоПодразделениям", УчетПоПодразделениям);
	ПараметрыПроверкиОшибок.Вставить("ИмяПоля");
	
	ЕстьОшибки = Ложь;
	
	Если ПараметрыПроверки.ПроверятьКоличествоВТабЧасти 
		И ЗначениеЗаполнено(ТекущаяСтрока.ИнвентарныйНомер) И ТекущаяСтрока.Количество <> 1 Тогда
		
		ЕстьОшибки = Истина;
		ПараметрыПроверки.ОтражениеВУчетеБУЗаполненоНекорректно = Истина;
		Если НЕ НеЗаполнятьОшибки Тогда
		
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",
				"Корректность", "Количество", НомерСтроки, "Основные средства", НСтр(
				"ru = 'Если в строке выбран инвентарный номер, то количество должно быть равно 1'"));
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
				"Объект.ОсновныеСредства[%1].Количество", ТекстСообщения,
				"Объект.ОсновныеСредства", ИндексСтроки, ТекстСообщения, ИндексСтроки);
		
		КонецЕсли;
			
	КонецЕсли;
	
	Если НЕ ЕстьОшибки ИЛИ НЕ НеЗаполнятьОшибки Тогда
		Если Не ПроверитьЗаполнениеСтрокиПринятияКУчетуБУ(
			ТекущаяСтрока, НеЗаполнятьОшибки, ПараметрыПроверкиОшибок, Ошибки) Тогда
//			Отказ = Истина;
			ПараметрыПроверки.ОтражениеВУчетеБУЗаполненоНекорректно = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЕстьНУ Тогда    
		Возврат НЕ ЕстьОшибки;
	КонецЕсли;	             
	
	ОтражатьВНалоговомУчете = ПараметрыПроверки.ОтражатьВНалоговомУчете;
	ОтражатьВУСНДоходыМинусРасходы = ПараметрыПроверки.ОтражатьВУСНДоходыМинусРасходы;
	ПараметрыПроверки.ОтражениеВУчетеНУЗаполненоНекорректно  = Ложь;
	ПараметрыПроверки.ОтражениеВУчетеУСНЗаполненоНекорректно = Ложь;

	Если (НЕ ЕстьОшибки ИЛИ НЕ НеЗаполнятьОшибки) Тогда
		Если ОтражатьВНалоговомУчете = Неопределено Тогда
			ОтражатьВНалоговомУчете = ОтражатьВНалоговомУчетеПринятиеКУчету(Объект);
		КонецЕсли;
		Если ОтражатьВНалоговомУчете Тогда
			Если Не ПроверитьЗаполнениеСтрокиПринятияКУчетуНУ(
				ТекущаяСтрока, НеЗаполнятьОшибки, ПараметрыПроверкиОшибок, Ошибки) Тогда
				ЕстьОшибки = Истина;
				ПараметрыПроверки.ОтражениеВУчетеНУЗаполненоНекорректно = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если (НЕ ЕстьОшибки ИЛИ НЕ НеЗаполнятьОшибки) Тогда
		Если ОтражатьВУСНДоходыМинусРасходы = Неопределено Тогда
			ОтражатьВУСНДоходыМинусРасходы = ОтражатьВУСНДоходыМинусРасходыПринятиеКУчету(Объект);
		КонецЕсли;
		Если ОтражатьВУСНДоходыМинусРасходы Тогда
			Если Не ПроверитьЗаполнениеСтрокиПринятияКУчетуУСН(
				ТекущаяСтрока, НеЗаполнятьОшибки, ПараметрыПроверкиОшибок, Ошибки) Тогда
				ЕстьОшибки = Истина;
				ТекущаяСтрока.ОтражениеВУчетеУСНЗаполненоНекорректно = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НЕ ЕстьОшибки;
	
КонецФункции

Функция ПараметрыПроверкиДанныхСтрокиПринятияКУчетуПриПроведении() Экспорт

	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ВидИмущества");
	ПараметрыПроверки.Вставить("ПроверятьНомерИнвКарточки", Ложь);
	ПараметрыПроверки.Вставить("ТекстОшибкиВидаИмущества");
	ПараметрыПроверки.Вставить("ПолеОшибки");
	ПараметрыПроверки.Вставить("ТекстОшибки");
	ПараметрыПроверки.Вставить("ГруппаОшибок");
	ПараметрыПроверки.Вставить("НомерСтроки");
	ПараметрыПроверки.Вставить("ИндексСтроки");
	Возврат ПараметрыПроверки;

КонецФункции // ПараметрыПроверкиДанныхСтрокиПринятияКУчетуПриПроведении()

Функция ДанныеСтрокиПринятияКУчетуГотовыКПроведению(ТекущаяСтрока, ПараметрыПроверки, Ошибки) Экспорт

	Перем ПричинаОшибки;
	
	ЕстьОшибки = Ложь;
	ВидИмущества = ПараметрыПроверки.ВидИмущества;
	ПроверятьНомерИнвКарточки = ПараметрыПроверки.ПроверятьНомерИнвКарточки;
	ПроверятьИнвНомер = ПараметрыПроверки.Свойство("ПроверитьИнвентарныйНомер")
		И ПараметрыПроверки["ПроверитьИнвентарныйНомер"];
	
	ИндексСтроки = ТекущаяСтрока.НомерСтроки - 1;
	ЦенаОС = ТекущаяСтрока.Сумма / ?(ТекущаяСтрока.Количество = 0, 1, ТекущаяСтрока.Количество);
	СчетУчетаОС = ?(ПараметрыПроверки.Свойство("СчетУчетаОС"),
		ПараметрыПроверки["СчетУчетаОС"], ТекущаяСтрока.СчетУчетаОС);
	Если ПроверятьИнвНомер И Не ЗначениеЗаполнено(ТекущаяСтрока.ИнвентарныйНомер) 
		И УправлениеОсновнымиСредствамиКлиентСервер.ДляОбъектаОбязательноУказаниеИнвНомера(
		ТекущаяСтрока.ОсновноеСредство,,СчетУчетаОС, ЦенаОС, ПричинаОшибки) Тогда
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",
			"Заполнение", "Инвентарный номер", ТекущаяСтрока.НомерСтроки, "Основные средства")
			+ "
			|
			|" + ПричинаОшибки;
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, 
			"Объект.ОсновныеСредства[%1].ИнвентарныйНомер", ТекстСообщения, 
			"Объект.ОсновныеСредства", ТекущаяСтрока.НомерСтроки, ТекстСообщения, ИндексСтроки);
			
		ЕстьОшибки = Истина;
		
	КонецЕсли;
	
	ПараметрыПроверки.Вставить("ПолеОшибки", "СчетУчетаОС");
	СчетСоответствуетВидуИмущества(СчетУчетаОС, ВидИмущества, Ошибки, ПараметрыПроверки);
	Если ЗначениеЗаполнено(СчетУчетаОС) Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетУчетаОС);
		Если СвойстваСчета.УчетПоКПС И Не ЗначениеЗаполнено(ТекущаяСтрока.КПС) Тогда
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Колонка", "Заполнение", "КПС", ТекущаяСтрока.НомерСтроки, "Основные средства");
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
				"Объект.ОсновныеСредства[%1].КПС", ТекстСообщения, "Объект.ОсновныеСредства",
				ИндексСтроки, ТекстСообщения, ИндексСтроки);
			ЕстьОшибки = Истина;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ПроверятьНомерИнвКарточки И НЕ ЗначениеЗаполнено(ТекущаяСтрока.НомерИнвентарнойКарточки) Тогда
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",
			"Заполнение", "Номер инвентарной карточки",
			ТекущаяСтрока.НомерСтроки, "Основные средства");
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
			"Объект.ОсновныеСредства[%1].НомерИнвентарнойКарточки", ТекстСообщения,
			"Объект.ОсновныеСредства", ИндексСтроки, ТекстСообщения, ИндексСтроки);
		ЕстьОшибки = Истина;
		
	КонецЕсли;

КонецФункции

// Очищает расчетные реквизиты объекта и формы капвложений.
// Вызывается при изменении реквизитов, от которых зависят остатки капвложений. Например, дата документа.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа, из которого вызывается процедура
Процедура ОчиститьРасчетныеДанныеКапвложений(Форма) Экспорт
	Объект = Форма.Объект;
	ТипСсылки = ТипЗнч(Объект.Ссылка);     
	
	РеквизитКоличество                     = "Количество";
	РеквизитСуммаВложений                  = "СуммаВложений";
	РеквизитСуммаАмортизацииВложений       = "СуммаАмортизацииВложений";
	РеквизитСуммаОбесцененияВложений       = "СуммаОбесцененияВложений";
	РеквизитПервоначальнаяСтоимостьЕдиницы = "ПервоначальнаяСтоимостьЕдиницы";

	РеквизитСуммаВложенийНУ                  = "СуммаВложенийНУ";
	РеквизитПервоначальнаяСтоимостьЕдиницыНУ = "ПервоначальнаяСтоимостьЕдиницыНУ";

	Если ТипСсылки = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК") Тогда
		РеквизитКоличество = "";
		РеквизитСуммаВложений = "";
		РеквизитСуммаВложенийНУ = "";
		РеквизитПервоначальнаяСтоимостьЕдиницыНУ = "";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС") Тогда
		РеквизитКоличество = "КоличествоВложений";
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК") Тогда
		РеквизитКоличество = "КоличествоВложений";
		РеквизитСуммаВложенийНУ = "";
		РеквизитПервоначальнаяСтоимостьЕдиницыНУ = "";
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(РеквизитКоличество) И Объект[РеквизитКоличество] <> 0 Тогда
		Объект[РеквизитКоличество] = 0;
	КонецЕсли;	
	Если ЗначениеЗаполнено(РеквизитСуммаВложений) И Объект[РеквизитСуммаВложений] <> 0 Тогда
		Объект[РеквизитСуммаВложений] = 0;
	КонецЕсли;	
	Если ЗначениеЗаполнено(РеквизитСуммаАмортизацииВложений) 
		И Объект[РеквизитСуммаАмортизацииВложений] <> 0 Тогда
		Объект[РеквизитСуммаАмортизацииВложений] = 0;
	КонецЕсли;	
	Если ЗначениеЗаполнено(РеквизитСуммаОбесцененияВложений) 
		И Объект[РеквизитСуммаОбесцененияВложений] <> 0 Тогда
		Объект[РеквизитСуммаОбесцененияВложений] = 0;
	КонецЕсли;	
	Если ЗначениеЗаполнено(РеквизитСуммаВложенийНУ) 
		И Объект[РеквизитСуммаВложенийНУ] <> 0 Тогда
		Объект[РеквизитСуммаВложенийНУ] = 0;
	КонецЕсли;	
	Если ЗначениеЗаполнено(РеквизитПервоначальнаяСтоимостьЕдиницы)
		И Форма[РеквизитПервоначальнаяСтоимостьЕдиницы] <> 0 Тогда
		Форма[РеквизитПервоначальнаяСтоимостьЕдиницы] = 0;
	КонецЕсли;	
	Если ЗначениеЗаполнено(РеквизитПервоначальнаяСтоимостьЕдиницыНУ)
		И Форма[РеквизитПервоначальнаяСтоимостьЕдиницыНУ] <> 0 Тогда
		Форма[РеквизитПервоначальнаяСтоимостьЕдиницыНУ] = 0;
	КонецЕсли;	
	
	Если Объект.КапитальныеВложения.Количество() > 0 Тогда
		Объект.КапитальныеВложения.Очистить();
	КонецЕсли;	
КонецПроцедуры	

