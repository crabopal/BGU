	Параметры.Вставить("ОсновноеСредство",	?(ЗначениеЗаполнено(ОсновноеСредство), ОсновноеСредство, ПредопределенноеЗначение("Справочник.ОсновныеСредства.ПустаяСсылка")));
	Параметры.Вставить("ИнвентарныйНомер",	?(ЗначениеЗаполнено(ИнвентарныйНомер), ИнвентарныйНомер, ПредопределенноеЗначение("Справочник.ИнвентарныеНомераОС.ПустаяСсылка")));
