
#Область ПрограммныйИнтерфейс

// Процедуры и функции работы со счетами.

// Возвращает пустую структуру
Функция СтруктураЗапрашиваемыхСчетов(ЗначениеПоУмолчанию = Ложь) Экспорт

	СтруктураЗапрашиваемыхСчетов = Новый Структура;
	СтруктураЗапрашиваемыхСчетов.Вставить("ВидИмущества", 		Неопределено);
	СтруктураЗапрашиваемыхСчетов.Вставить("ЖилыеПомещения", 	ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("НежилыеПомещения",	ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("Сооружения", 		ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("ИнвестНедвижимость",	ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("Машины", 			ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("Транспорт", 			ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("ХозИнвентарь", 		ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("Биоресурсы", 		ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("Библиотека", 		ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("Прочие", 			ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("Аренда", 			ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("Хранение", 			ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("ЭлементГруппа", 		Ложь);
	СтруктураЗапрашиваемыхСчетов.Вставить("ПолученныеПоЦС", 	ЗначениеПоУмолчанию);
	
	СтруктураЗапрашиваемыхСчетов.Вставить("ИК",					Ложь);
	СтруктураЗапрашиваемыхСчетов.Вставить("ОС",					ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("НМА",				ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("НПА",				ЗначениеПоУмолчанию);
	СтруктураЗапрашиваемыхСчетов.Вставить("КапВложения",		ЗначениеПоУмолчанию);
	
	Возврат СтруктураЗапрашиваемыхСчетов;
	
КонецФункции

// Возвращает массив счетов учета ОС по переданным параметрам. Структура параметров возвращается фунцией СтруктураЗапрашиваемыхСчетов()
// Если вызывается с клиента, то возращаемое значение кэшируется.
// Значение определяется по кэшированной таблице значений, возвращаемой функцией УправлениеОсновнымиСредствамиПовтИсп.СчетаУчетаОСПоВидам(). 
// Параметры:
//	ПараметрыПолученияСчетовОС - Структура - заполненная структура, возвращенная фунцией СтруктураЗапрашиваемыхСчетов().
//
// Возвращаемое значение:
//	Массив - содержащий значения типа: ПланСчетовСсылка.ЕПСБУ
//
// Пример:
//	ПараметрыПолученияСчетовОС = УправлениеОсновнымиСредствамиКлиентСервер.СтруктураЗапрашиваемыхСчетов(Ложь);
//	ПараметрыПолученияСчетовОС.ЖилыеПомещения = Истина;
//	СчетаУчетаЖилыхПомещений = УправлениеОсновнымиСредствамиКлиентСервер.МассивСчетовОС(ПараметрыПолученияСчетовОС);
//
Функция МассивСчетовОС(ПараметрыПолученияСчетовОС) Экспорт
	
	#Если Клиент Тогда
		
		Возврат УправлениеОсновнымиСредствамиВызовСервераПовтИсп.МассивСчетовОСИзТаблицыСчетовОС(ПараметрыПолученияСчетовОС);
		
	#Иначе
		
		Отбор = Новый Структура;
		Для Каждого Параметр Из ПараметрыПолученияСчетовОС Цикл
			
			Если ЗначениеЗаполнено(Параметр.Значение) Тогда
				Отбор.Вставить(Параметр.Ключ, Параметр.Значение);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Отбор) Тогда
			МассивСчетов = Новый Массив;
			Для Каждого ЭлементОтбора Из Отбор Цикл
				
				Если ЭлементОтбора.Значение = Истина Тогда
					ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСчетов,
						УправлениеОсновнымиСредствамиПовтИсп.СчетаУчетаОСПоВидам().Скопировать(
							Новый Структура(ЭлементОтбора.Ключ, Истина)).ВыгрузитьКолонку("Ссылка"), Истина);
				КонецЕсли;
				
			КонецЦикла;
			
			Возврат МассивСчетов;
		Иначе
			Возврат УправлениеОсновнымиСредствамиПовтИсп.СчетаУчетаОСПоВидам().ВыгрузитьКолонку("Ссылка");
		КонецЕсли;
		
	#КонецЕсли
	
КонецФункции

// Возвращает вид НФА для переданного счета учета. Если вызывается с клиента, то возращаемое значение кэшируется.
// Значение определяется по кэшированной таблице значений, возвращаемой функцией УправлениеОсновнымиСредствамиПовтИсп.СчетаУчетаОСПоВидам(). 
// Параметры:
//	СчетУчета - ПланСчетовСсылка
//
// Возвращаемое значение:
//	ПеречислениеСсылка.ВидыНФА
//
Функция ВидНФАпоСчетуУчета(СчетУчета) Экспорт
	
	#Если Клиент Тогда
		
		Возврат УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ВидНФАпоСчетуУчета(СчетУчета);
		
	#Иначе
		
		ТаблицаСчетов = УправлениеОсновнымиСредствамиПовтИсп.СчетаУчетаОСПоВидам();
		СтрокаСчета = ТаблицаСчетов.Найти(СчетУчета, "Ссылка");
		Если СтрокаСчета = Неопределено Тогда
			Возврат Перечисления.ВидыНФА.ПустаяСсылка();
		Иначе
			Возврат СтрокаСчета.ВидНФА;
		КонецЕсли;
		
	#КонецЕсли
	
КонецФункции

// Возвращает вид учета для переданного счета учета. Если вызывается с клиента, то возращаемое значение кэшируется.
// Значение определяется по кэшированной таблице значений, возвращаемой функцией УправлениеОсновнымиСредствамиПовтИсп.СчетаУчетаОСПоВидам(). 
// Параметры:
