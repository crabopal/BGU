Процедура ЗаполнитьДанныеИзСтруктурыПриВыбореОсновногоСредства(Объект, Параметры, ВыбранноеЗначение, ВыборОСОбработан = Ложь) Экспорт
	Перем ВыбраннаяСсылка;
	Перем ЗначениеСвойства;
	
	ВыборОСОбработан = Ложь;

	Если Объект = Неопределено ИЛИ ТипЗнч(ВыбранноеЗначение) <> Тип("Структура") ИЛИ НЕ ВыбранноеЗначение.Свойство("Ссылка", ВыбраннаяСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ТребуемыеДанные Из Параметры Цикл
	
		Если ВыбранноеЗначение.Свойство(ТребуемыеДанные.Ключ, ЗначениеСвойства) Тогда
			Объект[ТребуемыеДанные.Значение] = ЗначениеСвойства;
		КонецЕсли;
	
	КонецЦикла;
	
	ВыборОСОбработан = Истина;
	ВыбранноеЗначение = ВыбраннаяСсылка;

КонецПроцедуры

// Документы приказа 173н.

// Устарела.
//
Функция ПолучитьПараметрыСчетаУчетаИзФормы(Форма, ВидОперации, ВидУчета, Знач СчетУчета = Неопределено) Экспорт

	Если СчетУчета = Неопределено Тогда
		Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет101")
			ИЛИ ЭтоПриобретениеИлиИзготовление(ВидОперации) Тогда
			
			Если ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.НаБалансе") Тогда
				СчетУчета = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("101.00");
			ИначеЕсли ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.Арендованные") Тогда
				СчетУчета = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("01");
			ИначеЕсли ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.НаОтветственномХранении") Тогда
				СчетУчета = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("02");
			КонецЕсли;
				
		ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды") Тогда
			СчетУчета = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("25");
		ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользования") Тогда
			СчетУчета = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("26");
		КонецЕсли;
	ИначеЕсли ТипЗнч(СчетУчета) = Тип("Строка") Тогда
		СчетУчета = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду(СчетУчета);
	КонецЕсли;
	
	Результат = Новый Структура("УчетПоПодразделениям, УчетПоКПС, Контрагенты, Договоры", Ложь, Ложь, Ложь, Ложь);
	
	Если СчетУчета <> Неопределено Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетУчета);
		ЗаполнитьЗначенияСвойств(Результат, СвойстваСчета, "УчетПоПодразделениям, УчетПоКПС");
		Если СвойстваСчета.ВидСубконто1 = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты")
			ИЛИ СвойстваСчета.ВидСубконто2 = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты")
			ИЛИ СвойстваСчета.ВидСубконто3 = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты") Тогда
			Результат.Вставить("Контрагенты", Истина);
		КонецЕсли;
		Если СвойстваСчета.ВидСубконто1 = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Договоры")
			ИЛИ СвойстваСчета.ВидСубконто2 = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Договоры")
			ИЛИ СвойстваСчета.ВидСубконто3 = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Договоры") Тогда
			Результат.Вставить("Договоры", Истина);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПолучитьПараметрыСчетаУчетаИзФормы()

// Устарела. Процедура управляет доступностью и списком выбора элемента "ЭлементСпособНачисленияАмортизации". 
// Если передан параметр "ОграничениеСпособаНачисленияАмортизации", то список выбора ограничивается только этим значением.
//
// Параметры:
//	ПорядокПогашенияСтоимости - ПеречислениеСсылка.ПорядокПогашенияСтоимости
//	ЭлементСпособНачисленияАмортизации - ЭлементФормы
//	ОграничениеСпособаНачисленияАмортизации - ПеречислениеСсылка.СпособНачисленияАмортизации - если задано, то в списке выбора будет только это значение
//
Процедура ИзменитьДоступностьВариантыВыбораПараметровАмортизации(	ПорядокПогашенияСтоимости,
																	ЭлементСпособНачисленияАмортизации, 
																	ОграничениеСпособаНачисленияАмортизации = Неопределено) Экспорт

	Если ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
    	ЭлементСпособНачисленияАмортизации.Доступность = Истина;
		ЭлементСпособНачисленияАмортизации.СписокВыбора.Очистить();
		Если ОграничениеСпособаНачисленияАмортизации = Неопределено Тогда
			ЭлементСпособНачисленияАмортизации.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный"));
			ЭлементСпособНачисленияАмортизации.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию"));
		Иначе
			ЭлементСпособНачисленияАмортизации.СписокВыбора.Добавить(ОграничениеСпособаНачисленияАмортизации);
		КонецЕсли;
	Иначе
		ЭлементСпособНачисленияАмортизации.Доступность = Ложь;
		ЭлементСпособНачисленияАмортизации.СписокВыбора.Очистить();
	КонецЕсли;
		
КонецПроцедуры

// Устарела. Процедура устанавливает доступность группы формы, содержащей реквизиты счета затрат по амортизации
// Параметры:
//	ПорядокПогашенияСтоимости - Перечисление.ПорядокПогашенияСтоимости
//	ГруппаСчетаЗатрат - ГруппаФормы
//
Процедура ИзменитьДоступностьГруппыСчетаЗатрат(	ПорядокПогашенияСтоимости, ГруппаСчетаЗатрат, Знач Форма = Неопределено, Доступность = Неопределено) Экспорт
	
	МассивЭлементовГруппы = Новый Массив;
	ВыбратьРекурсивноИменаПодчиненныхЭлементов(ГруппаСчетаЗатрат, МассивЭлементовГруппы);
	Если Форма = Неопределено Тогда
		Форма = ГруппаСчетаЗатрат;
		Пока Форма <> Неопределено И ТипЗнч(Форма) <> Тип("ФормаКлиентскогоПриложения") Цикл
			Форма = Форма.Родитель;
		КонецЦикла;
	КонецЕсли;
	Доступность = ЗначениеЗаполнено(ПорядокПогашенияСтоимости)
				И ПорядокПогашенияСтоимости <> ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, МассивЭлементовГруппы, "Доступность", Доступность);
	
КонецПроцедуры

Процедура ВыбратьРекурсивноИменаПодчиненныхЭлементов(Группа, МассивЭлементов)

	Для каждого ПодчиненныйЭлемент Из Группа.ПодчиненныеЭлементы Цикл
	
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ГруппаФормы") Тогда
			
			ВыбратьРекурсивноИменаПодчиненныхЭлементов(ПодчиненныйЭлемент, МассивЭлементов);
			
		Иначе
			
			МассивЭлементов.Добавить(ПодчиненныйЭлемент.Имя);	
			
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры

// Устарела. Использовалась до появления в платформе свойства ПодсказкаВвода.
//
Процедура ЗаполнитьСписокВыбораКПСЗатрат(Элемент) Экспорт
	Элемент.СписокВыбора.Очистить();
	Элемент.СписокВыбора.Добавить(ПредопределенноеЗначение("Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка"),
		ТекстАвтоопределенияКПСАмортизации());
КонецПроцедуры

// Устарела. Использовалась до появления в платформе свойства ПодсказкаВвода.
//
Процедура УстановитьТекстИЦветКПСЗатрат(Элемент, КПСЗатрат) Экспорт
	Если ЗначениеЗаполнено(КПСЗатрат) Тогда
		Элемент.ЦветТекста = Новый Цвет();
		Элемент.РежимВыбораИзСписка = Ложь;
	Иначе
		Элемент.ЦветТекста = Новый Цвет(172, 172, 172);
		Элемент.РежимВыбораИзСписка = Истина;
	КонецЕсли;		
КонецПроцедуры

// Устарела.
// По счету учета ОС определяет, относится ли объект к библиотечному фонду.
// Счета учета библиотечного фонда - 101.Х7 и их потомки (вложенные счета).
//
// Параметры:
//  СчетУчетаОС - ПланСчетовСсылка.ЕПСБУ - счет учета объекта ОС (101.ХХ).
// Возвращаемое значение:
//  Булево - Истина, когда передан счет учета библ. фонда, Ложь - в остальных случаях.
//
Функция ЭтоБиблиотечныйФонд(СчетУчетаОС) Экспорт
	
	СтруктураСчетов = УправлениеОсновнымиСредствамиКлиентСервер.СтруктураЗапрашиваемыхСчетов();
	СтруктураСчетов.Библиотека = Истина;
	СчетаУчетаБиблиотечногоФонда = УправлениеОсновнымиСредствамиВызовСервераПовтИсп.МассивСчетовОС(СтруктураСчетов);
	
	Возврат (СчетаУчетаБиблиотечногоФонда.Найти(СчетУчетаОС) <> Неопределено);
	
КонецФункции

// Устарела.
// По счету учета ОС определяет, относится ли объект к зданиям или сооружениям.
// Счета учета зданий и сооружений - 101.Х1, 101.Х2, 101.Х3 и их потомки (вложенные счета).
//
// Параметры:
//  СчетУчетаОС - ПланСчетовСсылка.ЕПСБУ - счет учета объекта ОС (101.ХХ).
// Возвращаемое значение:
//  Булево - Истина, когда передан счет учета зданий или сооружений, Ложь - в остальных случаях.
//
Функция ЭтоЗданиеСооружение(СчетУчетаОС) Экспорт
	
	СтруктураСчетов = УправлениеОсновнымиСредствамиКлиентСервер.СтруктураЗапрашиваемыхСчетов();
	СтруктураСчетов.ЖилыеПомещения   = Истина;
	СтруктураСчетов.НежилыеПомещения = Истина;
	СтруктураСчетов.Сооружения       = Истина;
	СчетаУчетаЗданийСооружений = УправлениеОсновнымиСредствамиВызовСервераПовтИсп.МассивСчетовОС(СтруктураСчетов);
	
	Возврат (СчетаУчетаЗданийСооружений.Найти(СчетУчетаОС) <> Неопределено);
	
КонецФункции

// Устарела.
//
Функция ПолучитьПризнакиУчетаСчетаПоВидуПередачиОС(ВидПередачи, ЦМООбязательно = Неопределено, КонтрагентОбязательно = Неопределено) Экспорт

	Если ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС") Тогда
		ПризнакиУчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("101.00");
	ИначеЕсли ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет")
		ИЛИ ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда")
		ИЛИ ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование") Тогда
		ПризнакиУчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("21");
	ИначеЕсли ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование") Тогда
		ПризнакиУчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("01");
		КонтрагентОбязательно = Истина;
	ИначеЕсли ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении") Тогда
		ПризнакиУчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("02.1,02.3");
	ИначеЕсли ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений") Тогда
		ПризнакиУчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("106.00");
		ЦМООбязательно = Ложь;
	ИначеЕсли ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСАренда") Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("25");
		КонтрагентОбязательно = Истина;
	ИначеЕсли ВидПередачи = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСвПользование") Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("26");
		КонтрагентОбязательно = Истина;
	Иначе
		ПризнакиУчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("000");	
	КонецЕсли;
	
	Возврат ПризнакиУчета;

КонецФункции

// Устарела.
//
Процедура УстановитьПризнакиУчетаСчетаУчетаОС(Объект, СчетУчета) Экспорт

	Если ЗначениеЗаполнено(СчетУчета) Тогда
		Объект.УчетПоКПС = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетУчета).УчетПоКПС;
	Иначе
		Объект.УчетПоКПС = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Устарела.
//
Функция КонтрольныйСимволEAN(ШтрихКод, Тип) Экспорт

	Четн   = 0;
	Нечетн = 0;

	КоличествоИтераций = ?(Тип = 13, 6, 4);

	Для Индекс = 1 По КоличествоИтераций Цикл
		Если (Тип = 8) и (Индекс = КоличествоИтераций) Тогда
		Иначе
			Четн   = Четн   + Сред(ШтрихКод, 2 * Индекс, 1);
		КонецЕсли;
		Нечетн = Нечетн + Сред(ШтрихКод, 2 * Индекс - 1, 1);
	КонецЦикла;

	Если Тип = 13 Тогда
		Четн = Четн * 3;
	Иначе
		Нечетн = Нечетн * 3;
	КонецЕсли;

	КонтЦифра = 10 - (Четн + Нечетн) % 10;

	Возврат ?(КонтЦифра = 10, "0", Строка(КонтЦифра));

КонецФункции // КонтрольныйСимволEAN()

#КонецОбласти
