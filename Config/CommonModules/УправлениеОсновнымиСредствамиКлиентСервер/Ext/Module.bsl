// Функция рассчитывает срок полезного использования по амортизационной группе
//Первая группа (от 1 года до 2 лет включительно)
//Вторая группа (свыше 2 лет до 3 лет включительно)
//Третья группа (свыше 3 лет до 5 лет включительно)
//Четвертая группа (свыше 5 лет до 7 лет включительно)
//Пятая группа (свыше 7 лет до 10 лет включительно)
//Шестая группа (свыше 10 лет до 15 лет включительно)
//Седьмая группа (свыше 15 лет до 20 лет включительно)
//Восьмая группа (свыше 20 лет до 25 лет включительно)
//Девятая группа (свыше 25 лет до 30 лет включительно)
//Десятая группа (свыше 30 лет)
//Отдельная группа (п.1, ст.322 НК РФ) 
//
Функция РасчетСрокаПолезногоИспользования(АмортизационнаяГруппа)Экспорт
	Если НЕ ЗначениеЗаполнено(АмортизационнаяГруппа) Тогда
		СрокПолезногоИспользования = 0;
	Иначе
		Если АмортизационнаяГруппа = ПредопределенноеЗначение("Перечисление.АмортизационныеГруппы.ПерваяГруппа") Тогда
			ЧислоЛет=2;
		ИначеЕсли АмортизационнаяГруппа = ПредопределенноеЗначение("Перечисление.АмортизационныеГруппы.ВтораяГруппа") Тогда
			ЧислоЛет=3;
		ИначеЕсли АмортизационнаяГруппа = ПредопределенноеЗначение("Перечисление.АмортизационныеГруппы.ТретьяГруппа") Тогда
			ЧислоЛет=5;
		ИначеЕсли АмортизационнаяГруппа = ПредопределенноеЗначение("Перечисление.АмортизационныеГруппы.ЧетвертаяГруппа") Тогда
			ЧислоЛет=7;
		ИначеЕсли АмортизационнаяГруппа = ПредопределенноеЗначение("Перечисление.АмортизационныеГруппы.ПятаяГруппа") Тогда
			ЧислоЛет=10;
		ИначеЕсли АмортизационнаяГруппа = ПредопределенноеЗначение("Перечисление.АмортизационныеГруппы.ШестаяГруппа") Тогда
			ЧислоЛет=15;
		ИначеЕсли АмортизационнаяГруппа = ПредопределенноеЗначение("Перечисление.АмортизационныеГруппы.СедьмаяГруппа") Тогда
			ЧислоЛет=20;
		ИначеЕсли АмортизационнаяГруппа = ПредопределенноеЗначение("Перечисление.АмортизационныеГруппы.ВосьмаяГруппа") Тогда
			ЧислоЛет=25;
		ИначеЕсли АмортизационнаяГруппа = ПредопределенноеЗначение("Перечисление.АмортизационныеГруппы.ДевятаяГруппа") Тогда
			ЧислоЛет=30;
		Иначе
			ЧислоЛет=0;
		КонецЕсли;
		СрокПолезногоИспользования=ЧислоЛет*12;
	КонецЕсли;
	Возврат СрокПолезногоИспользования;

КонецФункции

// Процедура устанавливает ПорядокПогашенияСтоимости, СпособНачисленияАмортизации и НачислятьАмортизацию по переданным параметрам
// Параметры:
//	ПорядокПогашенияСтоимости - 	Перечисление.ПорядокПогашенияСтоимости 		- устанавливаемый реквизит объекта
//	СпособНачисленияАмортизации - 	Перечисление.СпособНачисленияАмортизации 	- устанавливаемый реквизит объекта
//	НачислятьАмортизацию - 			Булево  									- устанавливаемый реквизит объекта
//	СтруктураПараметров - Структура - Содержит ключи
//									Дата - Дата документа, для получения пределов стоимости ОС
//									ВидНФА - Перечисление.ВидыНФА
//									СтоимостьНФА
//									БиблФонд - Булево
//									Здание - Булево
//									СчетУчета - Счет учета объекта ОС
//									СчетУчетаЗабалансовый - булево
//
Процедура УстановитьПорядокПогашенияСтоимости(ПорядокПогашенияСтоимости, СпособНачисленияАмортизации, НачислятьАмортизацию, СтруктураПараметров) Экспорт
	Перем Дата, ВидНФА, СтоимостьНФА, БиблФонд, Здание, СчетУчета, СчетУчетаЗабалансовый;
	
	СтруктураПараметров.Свойство("Дата", Дата);
	СтруктураПараметров.Свойство("ВидНФА", ВидНФА);
	СтруктураПараметров.Свойство("СчетУчетаЗабалансовый", СчетУчетаЗабалансовый);
	Если СтруктураПараметров.Свойство("СчетУчета", СчетУчета) Тогда
		Если ЗначениеЗаполнено(СчетУчета) И СчетУчетаЗабалансовый = Неопределено Тогда
			СчетУчетаЗабалансовый = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетУчета).Забалансовый;
		КонецЕсли;
	КонецЕсли;
	Если НЕ СтруктураПараметров.Свойство("СтоимостьНФА", СтоимостьНФА) Тогда
		СтоимостьНФА = 0;
	КонецЕсли;
	Если НЕ СтруктураПараметров.Свойство("БиблФонд", БиблФонд) Тогда
		БиблФонд = Ложь;
	КонецЕсли;
	Если НЕ СтруктураПараметров.Свойство("Здание", Здание) Тогда
		Здание = Ложь;
	КонецЕсли;
	Если СчетУчетаЗабалансовый = Неопределено Тогда
		СчетУчетаЗабалансовый = Ложь;
	КонецЕсли;

	Если ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА") Тогда
		ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");
		СпособНачисленияАмортизации	= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
		НачислятьАмортизацию 		= Ложь;
	ИначеЕсли ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА") Тогда
		ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");
		Если СтоимостьНФА > 0 Тогда
			Если СтоимостьНФА > УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ПолучитьПределыОС(НачалоГода(Дата)).ВторойПределОС Тогда // >40 000
				СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный");
				НачислятьАмортизацию 		= Истина;
			Иначе
				СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию");
				НачислятьАмортизацию 		= Ложь;
			КонецЕсли;
		Иначе
			СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
			НачислятьАмортизацию 		= Ложь;
		КонецЕсли;
	Иначе
		Если СчетУчетаЗабалансовый Тогда
			ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");
			СпособНачисленияАмортизации	= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
			НачислятьАмортизацию 		= Ложь;
		ИначеЕсли СтоимостьНФА>0 Тогда
			Если СтоимостьНФА > УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ПолучитьПределыОС(НачалоГода(Дата)).ВторойПределОС Тогда
				ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");	
			    СпособНачисленияАмортизации	= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный");
				НачислятьАмортизацию 		= Истина;
			ИначеЕсли Здание
				ИЛИ БиблФонд
				ИЛИ СтоимостьНФА > УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ПолучитьПределыОС(НачалоГода(Дата)).ПервыйПределОС Тогда
				ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");	
			    СпособНачисленияАмортизации	= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию");
				НачислятьАмортизацию 		= Ложь;
			Иначе
				ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию");	
			    СпособНачисленияАмортизации	= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
				НачислятьАмортизацию 		= Ложь;
			КонецЕслИ;
		Иначе
			Если Здание ИЛИ БиблФонд Тогда
				ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");
			Иначе
				ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.ПустаяСсылка");	
			КонецЕсли;
		    СпособНачисленияАмортизации	= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
			НачислятьАмортизацию 		= Ложь;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ПредставлениеСтрокиЗаполнитьДанныеОбОС(Знач СтруктураРеквизитовОС, НаДату) Экспорт
    Перем ВидНФА;
	Перем СчетУчета;
	Перем КодПоОКОФ;
	Перем АмортизационнаяГруппа;
	Перем ГрупповойУчет;
	
	ПредставлениеСтроки = "";
	
	Если ТипЗнч(СтруктураРеквизитовОС) <> Тип("Структура") Тогда
		Возврат ПредставлениеСтроки;
	КонецЕсли;
	
	ВсеРеквизитыЗаполнены = Истина;
	
	Если СтруктураРеквизитовОС.Свойство("ВидНФА", ВидНФА) Тогда
		Если ЗначениеЗаполнено(ВидНФА) Тогда
			ПредставлениеСтроки = ПредставлениеСтроки + "; Вид НФА: " + ВидНФА;
		Иначе
			ПредставлениеСтроки = ПредставлениеСтроки + "; <Вид НФА: не указан>";
			ВсеРеквизитыЗаполнены = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если СтруктураРеквизитовОС.Свойство("КодПоОКОФ", КодПоОКОФ) Тогда
		Если ЗначениеЗаполнено(КодПоОКОФ) Тогда
			ПредставлениеСтроки = ПредставлениеСтроки + "; Код по ОКОФ: " + КодПоОКОФ;
		Иначе
			ПредставлениеСтроки = ПредставлениеСтроки + "; <Код по ОКОФ: не указан>";
			ВсеРеквизитыЗаполнены = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если СтруктураРеквизитовОС.Свойство("АмортизационнаяГруппа", АмортизационнаяГруппа) Тогда
		Если ЗначениеЗаполнено(АмортизационнаяГруппа) Тогда
			ПредставлениеСтроки = ПредставлениеСтроки + "; Амортизационная группа: " + АмортизационнаяГруппа;
		Иначе
			ПредставлениеСтроки = ПредставлениеСтроки + "; <Амортизационная группа: не указана>";
			ВсеРеквизитыЗаполнены = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрДлина(ПредставлениеСтроки) > 0 Тогда
		ПредставлениеСтроки = Сред(ПредставлениеСтроки, 3);
	КонецЕсли;
	
	Если НЕ ВсеРеквизитыЗаполнены Тогда
		ПредставлениеСтроки = "<!> " + ПредставлениеСтроки;
	КонецЕсли;
	
	Возврат ПредставлениеСтроки;
	
КонецФункции // ПредставлениеСтрокиЗаполнитьДанныеОбОС()

// Возвращает значение соответствующего ресурса или измерения регистра СоответствиеСчетовОС.
// Если вызывается с клиента, то строка регистра кэшируется.
//
// Параметры:
//	СчетУчета - ПланСчетовСсылка
//	ВидСчета - Строка - имя ресурса или измерения регистра
//
// Возвращаемое значение:
//	ПланСчетовСсылка
//
Функция СчетПоСчетуУчетаОС(СчетУчета, ВидСчета) Экспорт
	Перем СоответствияСчетов;
	Перем Результат;

	#Если Клиент Тогда
	СоответствияСчетов = УправлениеОсновнымиСредствамиВызовСервераПовтИсп.СоответствияСчетовПоСчетуОС(СчетУчета);
	#Иначе
	СоответствияСчетов = РегистрыСведений.СоответствиеСчетовОС.ПолучитьСоответствиеСчетов(СчетУчета);		
	#КонецЕсли

	Если НЕ СоответствияСчетов.Свойство(ВидСчета, Результат) Тогда
		Результат = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СчетПоСчетуУчетаОС()

// Формирует список видов операций по типу документа
//
// Параметры:
//  ТипДокумента - Тип - тип документа. Например Тип("ДокументСсылка.ПередачаЗдания")
//
// Возвращаемое значение:
//  - СписокЗначений Из ПеречислениеСсылка - ссылки на значения перечислений видов операций
Функция СписокВидовОперацииДокумента(ТипДокумента) Экспорт
	СписокВыбора = Новый СписокЗначений();
	Если ТипДокумента = Тип("ДокументСсылка.ПередачаГруппОбъектовОС")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ПередачаЗдания")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектаОС") Тогда
		
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС"));
		Если ТипДокумента <> Тип("ДокументСсылка.ПередачаОбъектаОС") Тогда
			СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет"));
		КонецЕсли;
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСАренда"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСвПользование"));
		Если ТипДокумента = Тип("ДокументСсылка.ПередачаГруппОбъектовОС") Тогда
			СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда"));
			СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование"));
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСвУправление"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСАренда"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСвПользование"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВУправление"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОС"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106"));
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
		
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Передача"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаАренда"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаБезмозмездноеПользование"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаУправление"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.Реализация"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаИКПолученныхВПользование"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаОСнаХранении"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаКапвложений"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаИКвФинансовуюАренду"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийИК.ПередачаЗемУчастковВПользование"));
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СписаниеГруппОбъектовОС") Тогда
		
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС"),
							НСтр("ru = 'Списание собственных ОС, НМА, НПА на балансе (101, 102, 103)'"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет"),
							НСтр("ru = 'Списание собственных ОС в опер. учете (21)'"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений"),
							НСтр("ru = 'Списание вложений в НФА (106)'"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование"),
							НСтр("ru = 'Списание ОС, НМА, НПА, полученных по договорам пользования (01)'"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении"),
							НСтр("ru = 'Списание ОС, НМА, НПА, принятых на хранение (02)'"));
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС") Тогда
		
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС"),
							НСтр("ru = 'Списание собственных ОС на балансе (101)'"));
