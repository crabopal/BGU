// Заполняет список значений видами операций по типу документа
//
// Параметры:
//  ТипДокумента - Тип - тип документа. Например Тип("ДокументСсылка.ПередачаЗдания")
//  Список - СписокЗначений - список значений, который будет заполняться
Процедура ЗаполнитьСписокВидовОперацийДокумента(ТипДокумента, Список) Экспорт
	СписокВидовОпераций = СписокВидовОперацииДокумента(ТипДокумента);
	Для каждого ВидОперации из СписокВидовОпераций Цикл
		Если ЗначениеЗаполнено(ВидОперации.Представление) Тогда
			Список.Добавить(ВидОперации.Значение, ВидОперации.Представление);
		Иначе
			Список.Добавить(ВидОперации.Значение);
		КонецЕсли;		
	КонецЦикла;	
КонецПроцедуры	

// Заполняет список выбора у элемента формы для выбора вида операции
//
// Параметры:
//  ТипДокумента - Тип - тип документа. Например Тип("ДокументСсылка.ПередачаЗдания")
//  Элемент - ПолеФормы - поле формы для выбора вида операции
Процедура ЗаполнитьСписокВыбораВидаОперацииДокумента(ТипДокумента, Элемент) Экспорт
	
	СписокВыбора = Элемент.СписокВыбора;
	СписокВыбора.Очистить();
	ЗаполнитьСписокВидовОперацийДокумента(ТипДокумента, СписокВыбора);
	
КонецПроцедуры

// Возвращает дату или момент времени для получения остатков основных средств. Используется в подборе и расчете стоимости в формах документов ОС.
// Параметры:
//	Объект - ДанныеФормыСтруктура - объект из формы
//	ДатаСписанияСБухУчета - Дата - значение реквизита документа "Дата списания с бух. учета" (если есть реквизит).
//
// Возвращаемое значение:
//	Дата - дата
//	МоментВремени - момент времени ссылки
//
Функция ПериодПолученияОстатковДляДокумента(Объект, Знач ДатаСписанияСБухУчета = Неопределено) Экспорт

	Если ДатаСписанияСБухУчета = Неопределено Тогда
	
		ДатаСписанияСБухУчета = Объект.Дата;		
	
	КонецЕсли;
	
	Если НачалоДня(Объект.Дата) <> НачалоДня(ДатаСписанияСБухУчета) Тогда
		Возврат ДатаСписанияСБухУчета;
	ИначеЕсли Объект.Ссылка.Пустая() Тогда
		Возврат КонецДня(Объект.Дата);
	Иначе
		Возврат Объект.Ссылка.МоментВремени();
	КонецЕсли;

КонецФункции // ПериодПолученияОстатковДляДокумента()

Процедура ЗаполнитьСтруктуруЗапрашиваемыхСчетов(СтруктураЗапрашиваемыхСчетов, ВидНФА, ВидУчета, ВидИмущества, ВсеОС = Ложь) Экспорт

	Если ЗначениеЗаполнено(ВидИмущества) Тогда
		СтруктураЗапрашиваемыхСчетов.ВидИмущества = ВидИмущества;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидНФА) Тогда
		СтруктураЗапрашиваемыхСчетов.ВидНФА = ВидНФА;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидНФА) Тогда
	    СтруктураЗапрашиваемыхСчетов.Аренда		= ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.Арендованные");
	    СтруктураЗапрашиваемыхСчетов.Хранение	= ВидУчета = ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.НаОтветственномХранении");
	Иначе
	    СтруктураЗапрашиваемыхСчетов.Аренда		= Истина;
	    СтруктураЗапрашиваемыхСчетов.Хранение	= Истина;
	КонецЕсли;
	
	Если (Не ЗначениеЗаполнено(ВидНФА) И Не ЗначениеЗаполнено(ВидУчета)) ИЛИ ВсеОС Тогда
		СтруктураЗапрашиваемыхСчетов.ЖилыеПомещения		= Истина;
		СтруктураЗапрашиваемыхСчетов.НежилыеПомещения	= Истина;
		СтруктураЗапрашиваемыхСчетов.Сооружения			= Истина;
		СтруктураЗапрашиваемыхСчетов.Машины				= Истина;
		СтруктураЗапрашиваемыхСчетов.Транспорт			= Истина;
		СтруктураЗапрашиваемыхСчетов.ХозИнвентарь		= Истина;
		СтруктураЗапрашиваемыхСчетов.Библиотека			= Истина;
		СтруктураЗапрашиваемыхСчетов.Прочие				= Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыВыбораОбъектаОС(Знач ДанныеДокумента) Экспорт
    Перем ПараметрыСчетов;
	
	ПараметрыВыбора = Новый Структура;
	ТипДанных = ТипЗнч(ДанныеДокумента);
	
	#Если Клиент Тогда
	Если ТипЗнч(ДанныеДокумента) = Тип("ДанныеФормыСтруктура") Тогда
		ТипДанных = ТипЗнч(ДанныеДокумента.Ссылка);
	Иначе
		Возврат ПараметрыВыбора;
	КонецЕсли;
	#Иначе
	Если ОбщегоНазначения.ЭтоСсылка(ДанныеДокумента)
		И Документы.ТипВсеСсылки().СодержитТип(ТипДанных) Тогда
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеДокумента, "Организация, ВидПоступления");
	ИначеЕсли ТипЗнч(ДанныеДокумента) = Тип("ДанныеФормыСтруктураСКоллекцией") Тогда
		ТипДанных = ТипЗнч(ДанныеДокумента.Ссылка);
	Иначе
		Возврат ПараметрыВыбора;
	КонецЕсли;
	#КонецЕсли
	
	Отбор = Новый Структура("Организация", ДанныеДокумента.Организация);
	
	ПараметрыВыбора.Вставить("ОС",	Истина);
	
	ВидДокумента = "";
		
	Если ВидДокумента = "ПринятиеКУчету" Тогда
		ТребуемыеДанные = "ВидНФА,КодПоОКОФ,АмортизационнаяГруппа";
			
		Если ДанныеДокумента.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды") Тогда
			ТребуемыеДанные = ТребуемыеДанные + ",ИнвентарныйНомер";
		ИначеЕсли ДанныеДокумента.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользования") Тогда
			ТребуемыеДанные = ТребуемыеДанные + ",ИнвентарныйНомер";
		ИначеЕсли Не ЭтоПриобретениеИлиИзготовление(ДанныеДокумента.ВидПоступления) Тогда
			ПараметрыСчетов.Аренда 			= Истина;									
			ПараметрыСчетов.Хранение		= Истина;											
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПараметрыСчетов <> Неопределено Тогда
		ПараметрыВыбора.Вставить("СписокВидовОС",	ПараметрыСчетов);
	КонецЕсли;
		
	ПараметрыВыбора.Вставить("ТребуемыеДанные",	ТребуемыеДанные);
	ПараметрыВыбора.Вставить("Отбор",			Отбор);
	Возврат ПараметрыВыбора;

КонецФункции // ПараметрыВыбораОбъектаОС()

Функция ВидыУчетаПоВидуНФА(ВидНФА) Экспорт

	Список = Новый СписокЗначений;
	Список.Добавить(ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.НаБалансе"));
	Если ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС") ИЛИ ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА") Тогда
		Список.Добавить(ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.Арендованные"));
	КонецЕсли;
	Если ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС") Тогда
		Список.Добавить(ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.НаОтветственномХранении"));
	КонецЕсли;
	Возврат Список;

КонецФункции // ВидыУчетаПоВидуНФА()

Функция АмортизационныеГруппыПоОКОФ(КодПоОКОФ) Экспорт

	Возврат УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ПолучитьАмортизационныеГруппы(КодПоОКОФ);	

КонецФункции // АмортизационныеГруппыПоОКОФ()

#Область СуммыРемонтаИМодернизацииПоКФО_Служебный

Функция СуммаКапвложенийВМодернизациюПоТЧ(Форма, ВидДокумента)
	Объект = Форма.Объект;
	СуммаЗатратПоТЧ = 0; 
	Если ВидДокумента = "РеконструкцияОС" Тогда
		РеквизитСуммы = "СуммаМодернизации";
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.КапРемонтОС") Тогда
			РеквизитСуммы = "СуммаРемонта";
		КонецЕсли;	
		СуммаЗатратПоТЧ = Объект.ОсновныеСредства.Итог(РеквизитСуммы) 
		+ Объект.ОсновныеСредства.Итог("СуммаДемонтажа")
		+ Объект.ОсновныеСредства.Итог("СуммаТранспортировки");
	ИначеЕсли ВидДокумента = "РешениеОПризнанииОбъектовОС" Тогда
		СуммаЗатратПоТЧ = Объект.ОсновныеСредства.Итог("Сумма"); 
	КонецЕсли;
		
	Возврат СуммаЗатратПоТЧ;	
КонецФункции	

Функция СуммаКапвложенийВМодернизациюПоСтрокеТЧ(Форма, ТекСтрока, ВидДокумента)
	Объект = Форма.Объект;
	СуммаЗатратПоСтроке = 0; 
	Если ВидДокумента = "РеконструкцияОС" Тогда
		РеквизитСуммы = "СуммаМодернизации";
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРеконструкцияОС.КапРемонтОС") Тогда
			РеквизитСуммы = "СуммаРемонта";
		КонецЕсли;	
		СуммаЗатратПоСтроке = ТекСтрока[РеквизитСуммы] 
		+ ТекСтрока["СуммаДемонтажа"] + ТекСтрока["СуммаТранспортировки"];
	ИначеЕсли ВидДокумента = "РешениеОПризнанииОбъектовОС" Тогда
		СуммаЗатратПоСтроке = ТекСтрока["Сумма"]; 
	КонецЕсли;
		
	Возврат СуммаЗатратПоСтроке;	
КонецФункции	

Функция МетаданныеДокументаМодернизации(Форма)
	Результат = Новый Структура;
	Объект = Форма.Объект;
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС") Тогда
		Результат.Вставить("ВидДокумента", "РешениеОПризнанииОбъектовОС");
		Результат.Вставить("ИмяРеквизитаСуммаДокумента", "СуммаВложений");
	Иначе // ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РеконструкцияОС") Тогда
		Результат.Вставить("ВидДокумента", "РеконструкцияОС");
		Результат.Вставить("ИмяРеквизитаСуммаДокумента", "СуммаДокумента");
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция ТекстЗаголовкаСуммыПоКФО(ИсточникДанных)
	Заголовок = "Расшифровка затрат по КФО";
	ДопТекст = "";

	Если ТипЗнч(ИсточникДанных) = Тип("ДанныеФормыЭлементКоллекции") 
		ИЛИ ТипЗнч(ИсточникДанных) = Тип("ДанныеФормыСтруктура") Тогда
		Для к = 1 по 7 Цикл
			Если к = 3 ИЛИ ИсточникДанных["Сумма" + к] = 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			ДопТекст = ДопТекст + ?(ДопТекст = "", ": ", ", ") + к + " - " + ИсточникДанных["Сумма" + к];
		КонецЦикла;	
	КонецЕсли;	

	Возврат(Заголовок + ДопТекст);
КонецФункции	

Функция ЦветОшибкиВПодвалеТаблицыСуммыПоКФО()
	Возврат(Новый Цвет(255, 0, 0));
КонецФункции	
	
