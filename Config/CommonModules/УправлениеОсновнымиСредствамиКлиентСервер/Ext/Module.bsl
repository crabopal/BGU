		Возврат УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ВидУчетаПоСчетуУчета(СчетУчета);
		
	#Иначе	
		
		Возврат Перечисления.ВидыУчетаНФА.ПоСчету(СчетУчета);
		
	#КонецЕсли
	
КонецФункции

