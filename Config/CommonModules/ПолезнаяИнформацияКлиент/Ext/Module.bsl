
#Область ПрограммныйИнтерфейс

Процедура ОткрытьГиперссылку(Форма, Команда) Экспорт
	
	Гиперссылка = Форма.ПолезнаяИнформация_Гиперссылки.НайтиПоЗначению(Команда.Имя);
	
	Если Гиперссылка <> Неопределено Тогда
	
		ПерейтиПоНавигационнойСсылке(Гиперссылка.Представление);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьВсеМатериалы(Форма, Команда) Экспорт
	
	Документ = "<html><body>" + Форма[Команда.Имя] + "</body></html>";
	
	ОткрытьФорму("ОбщаяФорма.Обозреватель", Новый Структура("АдресСтраницы, Заголовок, ИспользоватьАвторизацию", Документ, НСтр("ru='Все материалы'"), Истина));
	
КонецПроцедуры

Процедура СкрытьОповещения(Форма, Команда) Экспорт
	
	ИмяГруппы = "ГруппаПолезнаяИнформация";
	Форма.Элементы[ИмяГруппы].Видимость = Ложь;
	
	ИмяНастройки = СтрЗаменить(Команда.Имя, "ПолезнаяИнформацияСкрыть", "");
	
	ОбщегоНазначенияВызовСервера.ХранилищеСистемныхНастроекСохранить("ПолезнаяИнформация", ИмяНастройки, ПолезнаяИнформацияВызовСервера.ПолучитьВерсиюИБ());
	
КонецПроцедуры

// Параметры открытия обработки "Помощь".
// 
// Параметры:
//  ИмяРаздела - Строка
// 
// Возвращаемое значение:
//  Структура - Параметры открытия помощи:
// * Раздел - Строка - Имя раздела 
// * Заголовок - Строка - Заголовок, устанавливаемый в обработке
// * Такси - Булево - открывается вариант настроек для интерфейса Такси
Функция ПараметрыОткрытияПомощи(ИмяРаздела) Экспорт
	ПараметрыОткрытия = Новый Структура("Раздел, Заголовок, Такси", ИмяРаздела, "", Истина);
	Если ИмяРаздела = "ТаксиДенежныеСредства" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Денежные средства""'");
	ИначеЕсли ИмяРаздела = "ТаксиИмуществоКазны" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Имущество казны""'");
	ИначеЕсли ИмяРаздела = "ТаксиМатериальныеЗапасы" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Материальные запасы""'");
	ИначеЕсли ИмяРаздела = "ТаксиНалоги" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Налоги""'");
	ИначеЕсли ИмяРаздела = "ТаксиАдминистрирование" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Администрирование""'");
	ИначеЕсли ИмяРаздела = "ТаксиСправочники" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Справочники""'");
	ИначеЕсли ИмяРаздела = "ТаксиОсновныеСредства" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Основные средства""'");
	ИначеЕсли ИмяРаздела = "ТаксиПланированиеИСанкционирование" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Планирование и санкционирование""'");
	ИначеЕсли ИмяРаздела = "ТаксиПлатноеОбразование" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Платные образовательные услуги""'");
	ИначеЕсли ИмяРаздела = "ТаксиУслугиРаботыПроизводство" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Услуги, работы, производство""'");
	ИначеЕсли ИмяРаздела = "ТаксиУчетГСМ" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Учет ГСМ""'");
	ИначеЕсли ИмяРаздела = "ТаксиУчетИОтчетность" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Учет и отчетность""'");
	ИначеЕсли ИмяРаздела = "ТаксиИнвентаризация" Тогда
		ПараметрыОткрытия.Заголовок = НСтр("ru = 'Полезная информация по разделу ""Инвентаризация""'");
	КонецЕсли;
	Возврат ПараметрыОткрытия;
КонецФункции

// Открывает обработку "Помощь" с отбором информации по указанному разделу.
// Вызывается из обработчика общей команды.
// 
// Параметры:
//  ИмяРаздела - Строка - Имя раздела
//  ПараметрКоманды - Произвольный - Параметр команды
//  ПараметрыВыполненияКоманды - ПараметрыВыполненияКоманды - Параметры выполнения команды
Процедура ОткрытьОбработкуПомощь(ИмяРаздела, ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	ОткрытьФорму("Обработка.Помощь.Форма",
		ПараметрыОткрытияПомощи(ИмяРаздела),
		ПараметрыВыполненияКоманды.Источник,
		"ПолезнаяИнформация" + ИмяРаздела,
		ПараметрыВыполненияКоманды.Окно);
КонецПроцедуры

#КонецОбласти
