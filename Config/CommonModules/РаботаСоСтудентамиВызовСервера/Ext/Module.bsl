// Возвращает сумму начисления для фиксированной за период ставки в указанный период
//
// Параметры
//  Ставка  - СправочникСсылка.СтавкиОплатыОбразование - ссылка на элемент, по которому необходимо получить данные
//  Период  - Дата - Дата в периоде, за который необходимо получить данные
//
// Возвращаемое значение:
//   Число(15, 2) - сумма начисления за период, если за период нет начисления - то 0
//
Функция СуммаНачисленияСтавкиВПериод(Ставка, Период) Экспорт 

	Результат = 0;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СтавкиОплатыПорядокНачисления.СуммаНачисления
	               |ИЗ
	               |	Справочник.СтавкиОплатыОбразование.ПорядокНачисления КАК СтавкиОплатыПорядокНачисления
	               |ГДЕ
	               |	СтавкиОплатыПорядокНачисления.Ссылка = &Ставка
	               |	И НАЧАЛОПЕРИОДА(СтавкиОплатыПорядокНачисления.ПериодНачисления, МЕСЯЦ) = &ПериодНачисления";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ставка", Ставка);
	Запрос.УстановитьПараметр("ПериодНачисления", НачалоМесяца(Период));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.СуммаНачисления;
	КонецЕсли; 

	Возврат Результат;
	
КонецФункции

// Возвращает массив состояний по переданному виду действия начислений (действует или нет).
//
// Параметры
//  ДействуетНачисление  - Булево - реквизит справочника СостоянияСтудентов, определяющий, выполняется ли начисление по учащемуся.
//
// Возвращаемое значение:
//   Массив - содержит элементы справочника СостоянияСтудентов.
Функция СостоянияПоВидуДействия(ДействуетНачисление) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостоянияСтудентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СостоянияСтудентов КАК СостоянияСтудентов
		|ГДЕ
		|	СостоянияСтудентов.ДействуетНачисление = &ДействуетНачисление";
	
	Запрос.УстановитьПараметр("ДействуетНачисление", ДействуетНачисление);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СостоянияПоВидуДействия = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат СостоянияПоВидуДействия;
	
КонецФункции

// Рекомендуется использовать фукнцию РаботаСоСтудентамиПовтИсп.ПолучитьКонтрагентаДляСводнойСчетФактуры()
//
Функция ПолучитьКонтрагентаДляСводнойСчетФактуры() Экспорт 

	Возврат Константы.КонтрагентСводнаяСчетФактураУслугиОбразования.Получить();	

КонецФункции 

Функция ПолучитьАдресаСКДПодбора(ИмяМакета, УникальныйИдентификатор, ДобавлятьПоляБыстрогоОтбора = Ложь, Знач ЗначенияОтбора = Неопределено) Экспорт 
	
	Адреса = Новый Структура("СхемаКомпоновкиДанных, НастройкиКомпоновкиДанных");
	Если ЗначенияОтбора = Неопределено Тогда
		ЗначенияОтбора = Новый Соответствие;
	КонецЕсли;
	
	СхемаКомпоновкиДанных = Справочники.Студенты.ПолучитьМакет(ИмяМакета);
	Адреса.СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	
	Если ДобавлятьПоляБыстрогоОтбора Тогда
		
		НастройкиКомпоновкиДанных = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
		
		ПоляБыстрогоОтбора = Новый Массив;
		ПоляБыстрогоОтбора.Добавить(ПланыВидовХарактеристик.ПоляПриказовОбразование.Группа);
		ПоляБыстрогоОтбора.Добавить(ПланыВидовХарактеристик.ПоляПриказовОбразование.Курс);
		ПоляБыстрогоОтбора.Добавить(ПланыВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента);
		ПоляБыстрогоОтбора.Добавить(ПланыВидовХарактеристик.ПоляПриказовОбразование.СтавкаОплаты);
		НаименованияПолей = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ПоляБыстрогоОтбора, "Наименование");
		
		Для каждого ПолеОтбора Из ПоляБыстрогоОтбора Цикл
		
			ДобавитьЭлементОтбораВНастройку(НастройкиКомпоновкиДанных,
				НаименованияПолей.Получить(ПолеОтбора),
				ЗначенияОтбора.Получить(ПолеОтбора));
		
		КонецЦикла;
		
		Адреса.НастройкиКомпоновкиДанных = ПоместитьВоВременноеХранилище(НастройкиКомпоновкиДанных, УникальныйИдентификатор);
		
	КонецЕсли; 
	
	Возврат Адреса;
	
КонецФункции

Процедура ДобавитьЭлементОтбораВНастройку(Настройки, ИмяПоля, ЗначениеОтбора = Неопределено)
	
	ШаблонИмениПоля = "Студент.[Текущее значение: %ИмяПоля%]";
	ПолноеИмяПоля = СтрЗаменить(ШаблонИмениПоля, "%ИмяПоля%", ИмяПоля);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Настройки.Отбор,
		ПолноеИмяПоля,
		ЗначениеОтбора,
		,
		,
		ЗначениеЗаполнено(ЗначениеОтбора),
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ,
		"");

КонецПроцедуры
 

Функция ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты) Экспорт
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты);
	
КонецФункции

Функция ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита) Экспорт
	
Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита);
	
КонецФункции
	
	

