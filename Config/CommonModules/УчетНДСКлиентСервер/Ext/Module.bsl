Процедура РассчитатьСуммы_РублевыеНДСиБазу(КоллекцияЗначенийПолей, СтруктураИменПолей, УказаноПолеСуммаНДСВалютная, ИспользуетсяРассчитываемыйКурс, ОбозначениеПоляБазы, ИзмененоВалютноеПоле, Множитель, Курс, Кратность, РассчитатьТолькоСуммуНДС = Ложь)
	
	Перем	ИмяПоляБазаРублевая,
			ИмяПоляБазаВалютная,
			ИмяПоляСуммаНДСРублевая,
			ИмяПоляСуммаНДСВалютная,
			РассчитатьСуммуНДСПоСтавке;
	
	ИмяПоляБазаРублевая			= СтруктураИменПолей[ОбозначениеПоляБазы];
	ИмяПоляСуммаНДСРублевая		= СтруктураИменПолей["СуммаНДС"];
	Если УказаноПолеСуммаНДСВалютная Тогда
		ИмяПоляБазаВалютная		= СтруктураИменПолей[ОбозначениеПоляБазы + "Валютная"];
		ИмяПоляСуммаНДСВалютная	= СтруктураИменПолей["СуммаНДСВалютная"];
		
		ПрименяемыйКурс = РассчитатьСуммы_ПолучитьПрименяемыйКурс(КоллекцияЗначенийПолей, СтруктураИменПолей, ИспользуетсяРассчитываемыйКурс, ИмяПоляБазаРублевая, ИмяПоляБазаВалютная, Курс, Кратность);
		Если ПрименяемыйКурс = Неопределено Тогда
			// Рублевые суммы пересчитываем по ставке
			РассчитатьСуммуНДСПоСтавке = Истина;
		Иначе
			// Рублевые суммы пересчитываем по курсу
			
			// Сумма НДС
			КоллекцияЗначенийПолей[ИмяПоляСуммаНДСРублевая]	= Окр(КоллекцияЗначенийПолей[ИмяПоляСуммаНДСВалютная] * ПрименяемыйКурс, 2);
			// База
			РассчитатьБазуДляОпределенияКурса = (ИзмененоВалютноеПоле И НЕ ИспользуетсяРассчитываемыйКурс И НЕ(РассчитатьТолькоСуммуНДС = Истина));
			Если РассчитатьБазуДляОпределенияКурса Тогда
				КоллекцияЗначенийПолей[ИмяПоляБазаРублевая]	= Окр(КоллекцияЗначенийПолей[ИмяПоляБазаВалютная] * ПрименяемыйКурс, 2);
			КонецЕсли;
		КонецЕсли;
	Иначе
		// Рублевые суммы не пересчитываем по валютным
		РассчитатьСуммуНДСПоСтавке = Истина;
	КонецЕсли;
	
	Если РассчитатьСуммуНДСПоСтавке = Истина Тогда
		// Сумма НДС
		КоллекцияЗначенийПолей[ИмяПоляСуммаНДСРублевая]	= Окр(КоллекцияЗначенийПолей[ИмяПоляБазаРублевая] * Множитель, 2);
	КонецЕсли;
	
КонецПроцедуры
		
// Возвращает число или Неопределено (пересчитать суммы по ставке)
Функция РассчитатьСуммы_ПолучитьПрименяемыйКурс(КоллекцияЗначенийПолей, СтруктураИменПолей, ИспользуетсяРассчитываемыйКурс, ИмяПоляБазаРублевая, ИмяПоляБазаВалютная, Курс = Неопределено, Кратность = Неопределено)
	
	Если ИспользуетсяРассчитываемыйКурс Тогда
		БазаВалютная = КоллекцияЗначенийПолей[ИмяПоляБазаВалютная];
		Если БазаВалютная = 0 Тогда
			Результат = Неопределено;
		Иначе
			Результат = КоллекцияЗначенийПолей[ИмяПоляБазаРублевая] / БазаВалютная;
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Курс) И ЗначениеЗаполнено(Кратность) Тогда
			Результат = Курс / Кратность;
		Иначе
			Результат = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

