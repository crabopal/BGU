#КонецОбласти

#Область СтавкиНДС

// Возвращает число процентов ставки (например, 10 для 10%).
Функция ЗначениеСтавкиНДС(СтавкаНДС) Экспорт
	
	Возврат ПолучитьМножительСтавки(СтавкаНДС,, Истина, Истина);
	
КонецФункции

// Возвращает множитель ставки или значение в процентах, возможно приведение ставки к расчетной или обычной.
Функция ПолучитьМножительСтавки(СтавкаНДС, ИспользоватьРасчетнуюСтавку = Ложь, ИспользоватьОбычнуюСтавку = Ложь, ЗначениеВПроцентах = Ложь) Экспорт
	
	Если ИспользоватьРасчетнуюСтавку И ИспользоватьОбычнуюСтавку Тогда
		// Некорректные значения параметров.
		// Возвратим множитель по стандартным правилам.
		ИспользоватьРасчетнуюСтавку = Ложь;
		ИспользоватьОбычнуюСтавку = Ложь;
	КонецЕсли;
	
	Если ИспользоватьРасчетнуюСтавку Тогда
		Ставка = ПолучитьРасчетнуюСтавку(СтавкаНДС);
		
	ИначеЕсли ИспользоватьОбычнуюСтавку Тогда
		Ставка = ПолучитьОбычнуюСтавку(СтавкаНДС);
		
	Иначе
		Ставка = СтавкаНДС;
	КонецЕсли;
	
	Если Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") Тогда
		Возврат ?(ЗначениеВПроцентах, 10, 0.10);
		
	ИначеЕсли Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22") Тогда
		Возврат ?(ЗначениеВПроцентах, 22, 0.22);
		
	ИначеЕсли Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20") Тогда
		Возврат ?(ЗначениеВПроцентах, 20, 0.20);
		
	ИначеЕсли Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18") Тогда
		Возврат ?(ЗначениеВПроцентах, 18, 0.18);
		
	ИначеЕсли Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5") Тогда
		Возврат ?(ЗначениеВПроцентах, 5, 0.05);
		
	ИначеЕсли Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7") Тогда
		Возврат ?(ЗначениеВПроцентах, 7, 0.07);
		
	ИначеЕсли Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110") Тогда
		Возврат ?(ЗначениеВПроцентах, 1000/110, 10/110);
		
	ИначеЕсли Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22_122") Тогда
		Возврат ?(ЗначениеВПроцентах, 2200/122, 22/122);
		
	ИначеЕсли Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20_120") Тогда
		Возврат ?(ЗначениеВПроцентах, 2000/120, 20/120);
		
	ИначеЕсли Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118") Тогда
		Возврат ?(ЗначениеВПроцентах, 1800/118, 18/118);
		
	ИначеЕсли Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5_105") Тогда
		Возврат ?(ЗначениеВПроцентах, 500/105, 5/105);
		
	ИначеЕсли Ставка = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7_107") Тогда
		Возврат ?(ЗначениеВПроцентах, 700/107, 7/107);
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Возвращает соответствующую расчетную ставку.
// Если ставка уже является расчетной, или для нее не предусмотрена расчетная ставка, то возвращается сама ставка.
Функция ПолучитьРасчетнуюСтавку(СтавкаНДС) Экспорт
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110");
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22_122");
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20_120");
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118");
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5_105");
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7_107");
	КонецЕсли;
	
	Возврат СтавкаНДС;
	
КонецФункции

// Возвращает соответствующую обычную ставку.
// Если ставка уже является обычной, или для нее не предусмотрена обычная ставка, то возвращается сама ставка.
Функция ПолучитьОбычнуюСтавку(СтавкаНДС) Экспорт
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10");
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22_122") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22");
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20_120") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18");
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5_105") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5");
		
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7_107") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7");
	КонецЕсли;
	
	Возврат СтавкаНДС;
	
КонецФункции

Функция ПолучитьОсновнуюСтавку(НаДату = Неопределено) Экспорт
	
	Дата = НаДату;
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		#Если Клиент Тогда
			Дата = ОбщегоНазначенияКлиент.ДатаСеанса();
		#Иначе
			Дата = ТекущаяДатаСеанса();
		#КонецЕсли
	КонецЕсли;
	
	Если Дата >= '20260101' Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22");
		
	ИначеЕсли Дата >= '20190101' Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
		
	Иначе
		Возврат ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18");
	КонецЕсли;
	
КонецФункции

// Возвращает расчетную ставку для указанной ставки или расчетную ставку аванса по умолчанию на дату.
Функция ПолучитьСтавкуДляАванса(НаДату = Неопределено, СтавкаПлатежногоДокумента = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(СтавкаПлатежногоДокумента) Тогда
		Ставка = СтавкаПлатежногоДокумента;
	Иначе
		Ставка = ПолучитьОсновнуюСтавку(НаДату);
	КонецЕсли;
	
	Возврат ПолучитьРасчетнуюСтавку(Ставка);
	
КонецФункции

#КонецОбласти

#Область Расчет

// Рассчитывает поля сумм, связанных с НДС.
//
// Параметры:
//	КоллекцияЗначенийПолей		- Коллекция именованных элементов	- значения полей НДС;
//	ИмяИзмененногоПоля			- Строка	- имя одного поля (из указанной коллекции), которое
//									было изменено, и поэтому был вызван данный метод.
//									Определяет направление расчета и состав рассчитываемых полей.
//	СтруктураИменПолей			- Структура	- содержит имена конкретных полей в коллекции.
//									Должна содержать ключи:
//									 - Сумма
//									 - СуммаНДС
//									 - Всего
//									 - СтавкаНДС
//									 - СуммаВалютная (опционально)
//									 - СуммаНДСВалютная (опционально)
//									 - ВсегоВалютная (опционально)
//
//								Вариант 1. Указан ОДИН набор полей (рублевые суммы)
//							  	---------------------------------------------------
//								Расчет сумм:			по ставке
//								Пересчет рублевых сумм:	не используется
//									Курс:				не используется
// 							
//								Вариант 2. Указано ДВА набора полей (рублевые и валютные суммы)
//							  	---------------------------------------------------------------
//								Расчет сумм:			по ставке (валютные)
//														по курсу (рублевые)
//								Пересчет рублевых сумм:	используется
//									Курс:				используется
//														Если курс указан: Используется указанный курс
//															Пересчет рублевой базы:	да
//														Если курс не указан: Используется рассчитываемый курс
//															Курс = БазаРублевая / БазаВалютная
//															Пересчет рублевой базы:	нет
//	ЭтоАванс					- Булево	- определяет направление расчета и состав рассчитываемых полей.
//	ЭтоНалоговыйАгент			- Булево	- определяет направление расчета и состав рассчитываемых полей.
//	Курс, Кратность				- Число		- используются только в варианте с двумя наборами полей.
//									Если указаны значения, то при изменении валютных сумм будут
//									пересчитаны рублевые суммы по этому курсу (и база, и сумма НДС).
//									Если значения не указаны, то используется так называемый рассчитываемый курс,
//									по которому пересчитывается только сумма НДС.
//	РассчитатьКорректностьСумм	- Булево	- возвращать или нет результат проверки корректности получившихся сумм.
//
//	Последовательность расчета полей
//	--------------------------------
//	Это аванс (параметр ЭтоАванс = Истина)
//		Всего (налоговая база) -> СтавкаНДС (расчетная) -> СуммаНДС
//
//	Это налоговый агент (параметр ЭтоНалоговыйАгент = Истина)
//		Сумма (налоговая база) -> СтавкаНДС (обычная) -> СуммаНДС -> Всего
//
//	Иное (параметры ЭтоАванс, ЭтоНалоговыйАгент = Ложь)
//		Сумма (налоговая база) -> СтавкаНДС (указанная) -> СуммаНДС -> Всего
//
// Возвращаемое значение:
//	Булево			- (если РассчитатьКорректностьСумм=Истина) признак равенства сумм Всего = Сумма + СуммаНДС
//	Неопределено	- (если РассчитатьКорректностьСумм=Ложь)
Функция РассчитатьСуммы(КоллекцияЗначенийПолей, ИмяИзмененногоПоля, СтруктураИменПолей, ЭтоАванс = Ложь, ЭтоНалоговыйАгент = Ложь, РассчитатьКорректностьСумм = Ложь, Курс = Неопределено, Кратность = Неопределено) Экспорт
	
	Перем	ИмяПоляСумма,					УказаноПолеСумма,
			ИмяПоляСуммаНДС,				УказаноПолеСуммаНДС,
			ИмяПоляВсего,					УказаноПолеВсего,
			ИмяПоляСтавкаНДС,
			ИмяПоляСуммаВалютная,			УказаноПолеСуммаВалютная,
			ИмяПоляСуммаНДСВалютная,		УказаноПолеСуммаНДСВалютная,
			ИмяПоляВсегоВалютная,			УказаноПолеВсегоВалютная,
			ИспользуетсяРассчитываемыйКурс,
			ПрименяемыйКурс,
	        СуммыКорректные;
			
	// Входная проверка:
	Если ТипЗнч(СтруктураИменПолей) = Тип("Структура") Тогда
		СтруктураИменПолей.Свойство("СтавкаНДС",		ИмяПоляСтавкаНДС);
		УказаноПолеСумма			= СтруктураИменПолей.Свойство("Сумма",				ИмяПоляСумма);
		УказаноПолеВсего			= СтруктураИменПолей.Свойство("Всего",				ИмяПоляВсего);
		УказаноПолеСуммаВалютная	= СтруктураИменПолей.Свойство("СуммаВалютная",		ИмяПоляСуммаВалютная);
		УказаноПолеВсегоВалютная	= СтруктураИменПолей.Свойство("ВсегоВалютная",		ИмяПоляВсегоВалютная);
		УказаноПолеСуммаНДС			= СтруктураИменПолей.Свойство("СуммаНДС",			ИмяПоляСуммаНДС);
		УказаноПолеСуммаНДСВалютная	= СтруктураИменПолей.Свойство("СуммаНДСВалютная",	ИмяПоляСуммаНДСВалютная);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ УказаноПолеСуммаНДС Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИспользуетсяРассчитываемыйКурс = УказаноПолеСуммаНДСВалютная И (Курс = Неопределено И Кратность = Неопределено);
	
	Множитель = УчетНДСКлиентСервер.ПолучитьМножительСтавки(КоллекцияЗначенийПолей[ИмяПоляСтавкаНДС], ЭтоАванс, ЭтоНалоговыйАгент);
	
	// Рассчитываем новые значения полей:
	Если ИмяИзмененногоПоля = ИмяПоляСумма Тогда
		// Сумма
		// Это не аванс всегда
		
		ОбозначениеПоляБазы		= "Сумма";
		ИзмененоВалютноеПоле	= Ложь;
		РассчитатьСуммы_РублевыеНДСиБазу(КоллекцияЗначенийПолей, СтруктураИменПолей, УказаноПолеСуммаНДСВалютная, ИспользуетсяРассчитываемыйКурс, ОбозначениеПоляБазы, ИзмененоВалютноеПоле, Множитель, Курс, Кратность);
		Если УказаноПолеВсего Тогда
			КоллекцияЗначенийПолей[ИмяПоляВсего] = КоллекцияЗначенийПолей[ИмяПоляСумма] + КоллекцияЗначенийПолей[ИмяПоляСуммаНДС];
		КонецЕсли;
		
	ИначеЕсли ИмяИзмененногоПоля = ИмяПоляСуммаВалютная Тогда
		// Сумма
		// Это не аванс всегда
		
		КоллекцияЗначенийПолей[ИмяПоляСуммаНДСВалютная] = Окр(КоллекцияЗначенийПолей[ИмяПоляСуммаВалютная] * Множитель, 2);
		Если УказаноПолеВсегоВалютная Тогда
			КоллекцияЗначенийПолей[ИмяПоляВсегоВалютная] = КоллекцияЗначенийПолей[ИмяПоляСуммаВалютная] + КоллекцияЗначенийПолей[ИмяПоляСуммаНДСВалютная];
		КонецЕсли;
		
		// Пересчет рублевых сумм
		ОбозначениеПоляБазы		= "Сумма";
		ИзмененоВалютноеПоле	= Истина;
		РассчитатьСуммы_РублевыеНДСиБазу(КоллекцияЗначенийПолей, СтруктураИменПолей, УказаноПолеСуммаНДСВалютная, ИспользуетсяРассчитываемыйКурс, ОбозначениеПоляБазы, ИзмененоВалютноеПоле, Множитель, Курс, Кратность);
		Если УказаноПолеВсего Тогда
			КоллекцияЗначенийПолей[ИмяПоляВсего] = КоллекцияЗначенийПолей[ИмяПоляСумма] + КоллекцияЗначенийПолей[ИмяПоляСуммаНДС];
		КонецЕсли;
		
	ИначеЕсли ИмяИзмененногоПоля = ИмяПоляСтавкаНДС Тогда
		// Ставка НДС
		Если ЭтоАванс Тогда
			// Это аванс
			ОбозначениеПоляБазы = "Всего";
			
			Если УказаноПолеСуммаНДСВалютная Тогда
				КоллекцияЗначенийПолей[ИмяПоляСуммаНДСВалютная] = Окр(КоллекцияЗначенийПолей[ИмяПоляВсегоВалютная] * Множитель, 2);
				Если УказаноПолеСуммаВалютная Тогда
					КоллекцияЗначенийПолей[ИмяПоляСуммаВалютная] = КоллекцияЗначенийПолей[ИмяПоляВсегоВалютная] - КоллекцияЗначенийПолей[ИмяПоляСуммаНДСВалютная];
				КонецЕсли;
			КонецЕсли;
			
			// Пересчет рублевых сумм
			ИзмененоВалютноеПоле = Истина;
			РассчитатьСуммы_РублевыеНДСиБазу(КоллекцияЗначенийПолей, СтруктураИменПолей, УказаноПолеСуммаНДСВалютная, ИспользуетсяРассчитываемыйКурс, ОбозначениеПоляБазы, ИзмененоВалютноеПоле, Множитель, Курс, Кратность);
			Если УказаноПолеСумма Тогда
				КоллекцияЗначенийПолей[ИмяПоляСумма] = КоллекцияЗначенийПолей[ИмяПоляВсего] - КоллекцияЗначенийПолей[ИмяПоляСуммаНДС];
			КонецЕсли;
			
		Иначе
			// Это не аванс
			ОбозначениеПоляБазы = "Сумма";
			
			Если УказаноПолеСуммаНДСВалютная Тогда
				КоллекцияЗначенийПолей[ИмяПоляСуммаНДСВалютная] = Окр(КоллекцияЗначенийПолей[ИмяПоляСуммаВалютная] * Множитель, 2);
				Если УказаноПолеВсегоВалютная Тогда
					КоллекцияЗначенийПолей[ИмяПоляВсегоВалютная] = КоллекцияЗначенийПолей[ИмяПоляСуммаВалютная] + КоллекцияЗначенийПолей[ИмяПоляСуммаНДСВалютная];
				КонецЕсли;
			КонецЕсли;
			
			// Пересчет рублевых сумм
			ИзмененоВалютноеПоле = Ложь;
			РассчитатьСуммы_РублевыеНДСиБазу(КоллекцияЗначенийПолей, СтруктураИменПолей, УказаноПолеСуммаНДСВалютная, ИспользуетсяРассчитываемыйКурс, ОбозначениеПоляБазы, ИзмененоВалютноеПоле, Множитель, Курс, Кратность);
			Если УказаноПолеВсего Тогда
				КоллекцияЗначенийПолей[ИмяПоляВсего] = КоллекцияЗначенийПолей[ИмяПоляСумма] + КоллекцияЗначенийПолей[ИмяПоляСуммаНДС];
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ИмяИзмененногоПоля = ИмяПоляСуммаНДС Тогда
		// Сумма НДС
		Если ЭтоАванс Тогда
			// Это аванс
			Если УказаноПолеСумма Тогда
				КоллекцияЗначенийПолей[ИмяПоляСумма] = КоллекцияЗначенийПолей[ИмяПоляВсего] - КоллекцияЗначенийПолей[ИмяПоляСуммаНДС];
			КонецЕсли;
		Иначе
			// Это не аванс
			Если УказаноПолеВсего Тогда
				КоллекцияЗначенийПолей[ИмяПоляВсего] = КоллекцияЗначенийПолей[ИмяПоляСумма] + КоллекцияЗначенийПолей[ИмяПоляСуммаНДС];
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ИмяИзмененногоПоля = ИмяПоляСуммаНДСВалютная Тогда
		// Сумма НДС
		Если ЭтоАванс Тогда
			// Это аванс
			Если УказаноПолеСуммаВалютная Тогда
				КоллекцияЗначенийПолей[ИмяПоляСуммаВалютная] = КоллекцияЗначенийПолей[ИмяПоляВсегоВалютная] - КоллекцияЗначенийПолей[ИмяПоляСуммаНДСВалютная];
			КонецЕсли;
			
			// Пересчет рублевых сумм
			ОбозначениеПоляБазы		= "Всего";
			ИзмененоВалютноеПоле	= Истина;
			РассчитатьСуммы_РублевыеНДСиБазу(КоллекцияЗначенийПолей, СтруктураИменПолей, УказаноПолеСуммаНДСВалютная, ИспользуетсяРассчитываемыйКурс, ОбозначениеПоляБазы, ИзмененоВалютноеПоле, Множитель, Курс, Кратность, Истина);
		Иначе
			// Это не аванс
			Если УказаноПолеВсегоВалютная Тогда
				КоллекцияЗначенийПолей[ИмяПоляВсегоВалютная] = КоллекцияЗначенийПолей[ИмяПоляСуммаВалютная] + КоллекцияЗначенийПолей[ИмяПоляСуммаНДСВалютная];
			КонецЕсли;
			
			// Пересчет рублевых сумм
			ОбозначениеПоляБазы		= "Сумма";
			ИзмененоВалютноеПоле	= Истина;
			РассчитатьСуммы_РублевыеНДСиБазу(КоллекцияЗначенийПолей, СтруктураИменПолей, УказаноПолеСуммаНДСВалютная, ИспользуетсяРассчитываемыйКурс, ОбозначениеПоляБазы, ИзмененоВалютноеПоле, Множитель, Курс, Кратность, Истина);
			
			Если УказаноПолеВсего Тогда
				КоллекцияЗначенийПолей[ИмяПоляВсего] = КоллекцияЗначенийПолей[ИмяПоляСумма] + КоллекцияЗначенийПолей[ИмяПоляСуммаНДС];
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ИмяИзмененногоПоля = ИмяПоляВсего Тогда
		// Всего
		Если ЭтоАванс Тогда
			// Это аванс
			ОбозначениеПоляБазы		= "Всего";
			ИзмененоВалютноеПоле	= Ложь;
			РассчитатьСуммы_РублевыеНДСиБазу(КоллекцияЗначенийПолей, СтруктураИменПолей, УказаноПолеСуммаНДСВалютная, ИспользуетсяРассчитываемыйКурс, ОбозначениеПоляБазы, ИзмененоВалютноеПоле, Множитель, Курс, Кратность);
			Если УказаноПолеСумма Тогда
				КоллекцияЗначенийПолей[ИмяПоляСумма] = КоллекцияЗначенийПолей[ИмяПоляВсего] - КоллекцияЗначенийПолей[ИмяПоляСуммаНДС];
			КонецЕсли;
		Иначе
			// Это не аванс, не рассчитываем другие поля
		КонецЕсли;
		
	ИначеЕсли ИмяИзмененногоПоля = ИмяПоляВсегоВалютная Тогда
		// Всего
		Если ЭтоАванс Тогда
			// Это аванс
			КоллекцияЗначенийПолей[ИмяПоляСуммаНДСВалютная] = КоллекцияЗначенийПолей[ИмяПоляВсегоВалютная] * Множитель;
			Если УказаноПолеСуммаВалютная Тогда
				КоллекцияЗначенийПолей[ИмяПоляСуммаВалютная] = КоллекцияЗначенийПолей[ИмяПоляВсегоВалютная] - КоллекцияЗначенийПолей[ИмяПоляСуммаНДСВалютная];
			КонецЕсли;
			
			// Пересчет рублевых сумм
			ОбозначениеПоляБазы		= "Всего";
			ИзмененоВалютноеПоле	= Истина;
			РассчитатьСуммы_РублевыеНДСиБазу(КоллекцияЗначенийПолей, СтруктураИменПолей, УказаноПолеСуммаНДСВалютная, ИспользуетсяРассчитываемыйКурс, ОбозначениеПоляБазы, ИзмененоВалютноеПоле, Множитель, Курс, Кратность);
			Если УказаноПолеСумма Тогда
				КоллекцияЗначенийПолей[ИмяПоляСумма] = КоллекцияЗначенийПолей[ИмяПоляВсего] - КоллекцияЗначенийПолей[ИмяПоляСуммаНДС];
			КонецЕсли;
		Иначе
			// Это не аванс, не рассчитываем другие поля
		КонецЕсли;
	КонецЕсли;
	
	// Рассчитываем корректность сумм:
	Если РассчитатьКорректностьСумм Тогда
		СуммыКорректные = (КоллекцияЗначенийПолей[ИмяПоляВсего] = КоллекцияЗначенийПолей[ИмяПоляСумма] + КоллекцияЗначенийПолей[ИмяПоляСуммаНДС]);
	КонецЕсли;
	
	Возврат СуммыКорректные;
	
КонецФункции

Функция ПолучитьПредставлениеНомерДатаДокумента(Номер, Дата) Экспорт
	
	Если ЗначениеЗаполнено(Номер) ИЛИ ЗначениеЗаполнено(Дата) Тогда
		Если ТипЗнч(Номер) = Тип("Число") Тогда
			Результат = Строка(Номер) + " от " + Формат(Дата, "ДЛФ=Д");
		Иначе //Если ТипЗнч(Номер) = Тип("Строка") Тогда
			Результат = СокрЛП(Номер) + " от " + Формат(Дата, "ДЛФ=Д");
		КонецЕсли;
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСписокКодовВидовОпераций(СписокВыбора, ЧастьЖурналаСтрокой = Неопределено, НаДату = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(НаДату)
				ИЛИ	НачалоДня(НаДату) >= '20160701' Тогда
		ЗаполнитьСписокКодовВидовОпераций_После20160701(СписокВыбора, ЧастьЖурналаСтрокой);
	Иначе
		ЗаполнитьСписокКодовВидовОпераций_До20160701(СписокВыбора, ЧастьЖурналаСтрокой);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьСтавкуНДСВТаблице(Таблица) Экспорт
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		ОчиститьСтавкуНДСВСтрокеТаблицы(СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьСтавкуНДСВСтрокеТаблицы(СтрокаТаблицы) Экспорт
	
	СтрокаТаблицы["СтавкаНДС"]	= ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка");
	СтрокаТаблицы["СуммаНДС"]	= 0;
	СтрокаТаблицы["Всего"]		= СтрокаТаблицы["Сумма"];
	
КонецПроцедуры

// На основании поля Всего и даты заполняет 3 поля поля: СтавкаНДС, Сумма, СуммаНДС
Процедура ПрименитьСтавкуДляАванса(Таблица, НаДату = Неопределено, СтавкаПлатежногоДокумента = Неопределено) Экспорт
	
	Ставка = ПолучитьСтавкуДляАванса(НаДату, СтавкаПлатежногоДокумента);
	
	МножительСтавки = ПолучитьМножительСтавки(Ставка);
	
	Для Каждого СтрокаТаблицы ИЗ Таблица Цикл
		СтрокаТаблицы["СтавкаНДС"] = Ставка;
		
		СтрокаТаблицы["СуммаНДС"] = Окр(СтрокаТаблицы["Всего"] * МножительСтавки, 2);
		
		СтрокаТаблицы["Сумма"] = СтрокаТаблицы["Всего"] - СтрокаТаблицы["СуммаНДС"];
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьУвеличениеУменьшение(СтрокаТаблицы, ИмяПоля, ИмяПоляКомиссия = Неопределено) Экспорт
	
	Дельта = СтрокаТаблицы[ИмяПоля] - СтрокаТаблицы[ИмяПоля + "ДоИзменения"];
	
	Если Дельта >= 0 Тогда
		Увеличение = Дельта;
		Уменьшение = 0;
	Иначе
		Увеличение = 0;
		Уменьшение = -Дельта;
	КонецЕсли;
	
	СтрокаТаблицы[ИмяПоля + "Увеличение"] = Увеличение;
	СтрокаТаблицы[ИмяПоля + "Уменьшение"] = Уменьшение;
	
	Если НЕ ИмяПоляКомиссия = Неопределено Тогда
		СтрокаТаблицы[ИмяПоляКомиссия + "Увеличение"] = Увеличение;
		СтрокаТаблицы[ИмяПоляКомиссия + "Уменьшение"] = Уменьшение;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Признаки

// Для необлагаемых НДС операций
Функция КонтрагентОбязательный(ДокументСсылка) Экспорт
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаОтпускИК")
		Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах")
		Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОтчетПоКассовойСмене")
		Тогда
		
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ИнструкцииУчетаНДС

Функция ИнструкцииУчета_ОпределитьИдентификатор(Объект, ИмяРеквизитаКонтрольнаяДата = "Дата") Экспорт
	
	СтрокаТаблицы = ИнструкцииУчета_ОпределитьСтрокуОбщейТаблицы(Объект[ИмяРеквизитаКонтрольнаяДата]);
	
	Если СтрокаТаблицы = Неопределено Тогда
		Результат = Неопределено;
	Иначе
		Результат = СтрокаТаблицы["Идентификатор"];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет применяемую инструкцию по дате объекта.
Функция ИнструкцииУчета_ОпределитьСтрокуОбщейТаблицы(КонтрольнаяДата) Экспорт
	
	СписокДат = УчетНДСКлиентСерверПовтИсп.ИнструкцииУчета_ПолучитьСписокДатНачалаПрименения();
	
	ИндексМакс = СписокДат.Количество() - 1;
	ИскомыйИндекс = ИндексМакс;
	Для ИндексСтроки = 0 По ИндексМакс Цикл
		ДатаНачалаПрименения = СписокДат[ИндексСтроки].Значение;
		Если ДатаНачалаПрименения > КонтрольнаяДата Тогда
			ИскомыйИндекс = ИндексСтроки - 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ИскомыйИндекс >= 0 Тогда
		Идентификатор = СписокДат[ИскомыйИндекс].Представление;
		СтрокаТаблицы = УчетНДСКлиентСерверПовтИсп.ИнструкцииУчета_ПолучитьСтрокуОбщейТаблицы(Идентификатор);
	Иначе
		СтрокаТаблицы = Неопределено;
	КонецЕсли;
	
	Возврат СтрокаТаблицы;
	
КонецФункции

Функция ПрименяемаяИнструкция_ПолучитьЗначениеРеквизита(ИмяРеквизита, Форма, ТекущиеДанные) Экспорт
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "ПрименяемаяИнструкция_СтруктураСвойств")
		И ТекущиеДанные["ПрименяемаяИнструкция_СтруктураСвойств"]<> Неопределено Тогда
		Результат = ТекущиеДанные["ПрименяемаяИнструкция_СтруктураСвойств"][ИмяРеквизита];
	Иначе
		Результат = Форма["ПрименяемаяИнструкция_СтруктураСвойств"][ИмяРеквизита];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область АналогТолькоПросмотр

Процедура ТолькоПросмотр_ПоДаннымУчета_Клиент_НастроитьЭлементыТекущейСтроки(Форма, ЭлементФормыТаблица, НоваяСтрока = Ложь) Экспорт
	
	ТекДанные = ЭлементФормыТаблица.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиТаблиц			= Форма["ТолькоПросмотр_ПоДаннымУчета_НастройкиТаблиц"];
	НастройкиОднойТаблицы	= НастройкиТаблиц[ЭлементФормыТаблица.Имя];
	ИмяФлажкаПоДаннымУчета	= НастройкиОднойТаблицы["ИмяФлажкаПоДаннымУчета"];
	
	// В строке, добавленной вручную, сбрасываем флаг "По учету":
	Если НоваяСтрока Тогда
		ТекДанные[ИмяФлажкаПоДаннымУчета] = Ложь;
	КонецЕсли;
	
	// Настраиваем поля текущей строки:
	ПоУчету = ТекДанные[ИмяФлажкаПоДаннымУчета];
	Для Каждого ИмяЭлемента Из НастройкиОднойТаблицы["ИменаЭлементов"] Цикл
		Элемент = Форма.Элементы[ИмяЭлемента];
		Элемент.КнопкаВыбора			= НЕ ПоУчету;
		Элемент.РедактированиеТекста	= НЕ ПоУчету;
	КонецЦикла;
	
КонецПроцедуры

Процедура ТолькоПросмотр_ПоДаннымУчета_Клиент_ОтменитьСтандартнуюОбработкуСобытия(Форма, Элемент, СтандартнаяОбработка) Экспорт
	
	НастройкиТаблиц			= Форма["ТолькоПросмотр_ПоДаннымУчета_НастройкиТаблиц"];
	ИмяТаблицы				= ТолькоПросмотр_ПоДаннымУчета_Клиент_ПолучитьИмяТаблицы(Элемент);
	НастройкиОднойТаблицы	= НастройкиТаблиц[ИмяТаблицы];
	ИмяФлажкаПоДаннымУчета	= НастройкиОднойТаблицы["ИмяФлажкаПоДаннымУчета"];
	
	ТекДанные = Форма.Элементы[ИмяТаблицы].ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		Если ТекДанные[ИмяФлажкаПоДаннымУчета] Тогда
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ТолькоПросмотр_ПоДаннымУчета_Клиент_ПолучитьИмяТаблицы(Элемент)
	
	Результат = "";
	
	ПроверяемыйЭлемент = Элемент;
	
	Пока Истина Цикл
		Если ТипЗнч(ПроверяемыйЭлемент.Родитель) = Тип("ТаблицаФормы") Тогда
			Результат = ПроверяемыйЭлемент.Родитель.Имя;
			Прервать;
		Иначе
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПроверяемыйЭлемент, "Родитель") Тогда
				ПроверяемыйЭлемент = ПроверяемыйЭлемент.Родитель;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область МеханизмАвтоустановкиСубконто

Функция АвтоустановкаСубконто_ВычислитьЗначениеРеквизита(Форма, СтрокаНастроек, ТекущаяСтрока = Неопределено) Экспорт
	
	Результат = Неопределено;
	
	Если СтрокаНастроек["ЭтоРеквизитОбъекта"] Тогда
		Если СтрокаНастроек["ЭтоРеквизитТаблицы"] Тогда
			// Это реквизит табличной части объекта
			
			Если ТекущаяСтрока = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			СтрокаТабличнойЧасти = Форма.Объект[СтрокаНастроек["ИмяРеквизитаТаблица"]].НайтиПоИдентификатору(ТекущаяСтрока);
			
			Если СтрокаТабличнойЧасти = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			Результат = СтрокаТабличнойЧасти[СтрокаНастроек["ИмяРеквизита"]];
		Иначе
			// Это реквизит шапки объекта
			Результат = Форма.Объект[СтрокаНастроек["ИмяРеквизита"]];
		КонецЕсли;
	Иначе
		Если СтрокаНастроек["ЭтоРеквизитТаблицы"] Тогда
			// Это реквизит таблицы формы
			
			Если ТекущаяСтрока = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			СтрокаТабличнойЧасти = Форма[СтрокаНастроек["ИмяРеквизитаТаблица"]].НайтиПоИдентификатору(ТекущаяСтрока);
			
			Если СтрокаТабличнойЧасти = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			Результат = СтрокаТабличнойЧасти[СтрокаНастроек["ИмяРеквизита"]];
		Иначе
			// Это реквизит шапки формы
			Результат = Форма[СтрокаНастроек["ИмяРеквизита"]];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

