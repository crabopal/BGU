Процедура ДокументыОстатковНДС_УстановитьВидимостьИнформационногоЗаголовка(Форма, Видимость) Экспорт
	
	ИменаЭлементов = УчетНДСКлиентСервер.ДокументыОстатковНДС_ИменаЭлементовИнформационногоЗаголовка();
	
	Элемент = Форма.Элементы.Найти(ИменаЭлементов["ГруппаЭлементов"]);
	
	Если Элемент <> Неопределено Тогда
		Элемент.Видимость = Видимость;
	КонецЕсли;
	
	Элемент = Форма.Элементы.Найти(ИменаЭлементов["КнопкаСбросить"]);
	
	Если Элемент <> Неопределено Тогда
		Элемент.Видимость = Видимость;
	КонецЕсли;
	
