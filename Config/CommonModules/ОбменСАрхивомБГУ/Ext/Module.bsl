Функция НайтиСоздатьРольФайлаБИА(УИД, Наименование)

	УстановитьПривилегированныйРежим(Истина);
	
	РольСсылка = Справочники["РолиФайловБИА"].ПолучитьСсылку(УИД);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РолиФайловБИА.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РолиФайловБИА КАК РолиФайловБИА
	|ГДЕ
	|	РолиФайловБИА.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", РольСсылка);
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат РольСсылка;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.РолиФайловБИА");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", РольСсылка);
		Блокировка.Заблокировать();
		
		РольОбъект = Справочники["РолиФайловБИА"].СоздатьЭлемент();
		РольОбъект.УстановитьСсылкуНового(РольСсылка);
		РольОбъект.Наименование = Наименование;
		РольОбъект.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат РольСсылка;
	
КонецФункции

#КонецОбласти

