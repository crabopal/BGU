Процедура ДобавитьВДокументБИАФайлыДополнительногоВнутреннегоЭД(НовыйДокументБИА, УчетныйДокумент, ИдентификаторПечатнойФормы, ДокументыДляВыгрузки, РеквизитыДокументов)
	УстановитьПривилегированныйРежим(Истина);

	ТипОбъекта = ТипЗнч(УчетныйДокумент);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипОбъекта);
    ИмяОбъектаМетаданных = ОбъектМетаданных.Имя;
	
	ДобавитьДокументЛистСогласованияЛистОзнакомления = ДобавитьДокументЛистСогласованияЛистОзнакомления(ИмяОбъектаМетаданных, ИдентификаторПечатнойФормы);
	ДобавитьДокументЛистГолосования = ДобавитьДокументЛистГолосования(ИмяОбъектаМетаданных, ИдентификаторПечатнойФормы);

	Если ДобавитьДокументЛистСогласованияЛистОзнакомления
		ИЛИ ДобавитьДокументЛистГолосования Тогда
		Для Каждого ВнутреннийДокумент Из ДокументыДляВыгрузки Цикл

			ИдентификаторКомандыПечати = РеквизитыДокументов[ВнутреннийДокумент].ИдентификаторКомандыПечати;
			//ЛистСогласования
			//ЛистОзнакомления
			//ЛистГолосования
			Если ИдентификаторКомандыПечати = "ЛистСогласования"
				ИЛИ ИдентификаторКомандыПечати = "ЛистОзнакомления"
				ИЛИ ИдентификаторКомандыПечати = "ЛистаГолосования"
				ИЛИ ИдентификаторКомандыПечати = "ЛистГолосования" Тогда
				
				ОсновнойФайл = РеквизитыДокументов[ВнутреннийДокумент].ОсновнойФайл;
				ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
				ПараметрыДанных.ВызыватьИсключение = Ложь;
				ДанныеФайла = РаботаСФайлами.ДанныеФайла(ОсновнойФайл, ПараметрыДанных);
				Организация = РеквизитыДокументов[ВнутреннийДокумент].Организация;
				
				ОсновнойФайлPDF = РеквизитыДокументов[ВнутреннийДокумент].ОсновнойФайлPDF;
				ПредставлениеФормуляраФайлPDF = РеквизитыДокументов[ВнутреннийДокумент].ПредставлениеФормуляраФайлPDF;
				
				ЕстьФормулярPDF = Ложь;
				Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
					ЕстьФормулярPDF = Истина;
				КонецЕсли;
				
				ВидДокумента = РеквизитыДокументов[ВнутреннийДокумент].ВидДокумента;
				ДатаДокумента = РеквизитыДокументов[ВнутреннийДокумент].ДатаДокумента;
				НомерДокумента = РеквизитыДокументов[ВнутреннийДокумент].НомерДокумента;
				
				Если ЕстьФормулярPDF Тогда
					СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
					СтрокаФайла.Файл = ОсновнойФайлPDF;
					СтрокаФайла.Роль = РольФайлаБИАВнутреннийЭД();
					
					//Добавление сведений о ЭП
					ДобавлениеПодписейФайла(НовыйДокументБИА, ОсновнойФайлPDF);
					
					//Файл визуализации формируем из подписанного MXL файла
					ПредставлениеФормуляраФайлPDF = ФайлВизуализацииФормуляраПРОФИзПодписанногоФайлаMXL(
						Организация, ОсновнойФайл, ДанныеФайла, НовыйДокументБИА);
					Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
						СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
					КонецЕсли;	
				Иначе
					//Нет файла формуляра в формате PDF
			 		СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
					СтрокаФайла.Файл = ОсновнойФайл;
					СтрокаФайла.Роль = РольФайлаБИАВнутреннийЭД();
					
					Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
						//Есть файл представления формуляра
						СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
						
						//Добавление сведений заверяющих подписей при наличии
						ДобавлениеПодписейФайла(НовыйДокументБИА, ПредставлениеФормуляраФайлPDF);
					Иначе
						//Нет файла представления формуляра
						//Файл визуализации формируем из подписанного MXL файла
						ПредставлениеФормуляраФайлPDF = ФайлВизуализацииФормуляраПРОФИзПодписанногоФайлаMXL(
							Организация, ОсновнойФайл, ДанныеФайла, НовыйДокументБИА);
						Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
							СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;
		
		    КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

Функция ЕстьРаспискаИнвентаризации(УчетныйДокумент, ИдентификаторПечатнойФормы) Экспорт
	УстановитьПривилегированныйРежим(Истина);

