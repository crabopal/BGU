Процедура ПодготовитьКВыгрузкеРегламентированныйОтчет(Ссылка, ДополнительныеПараметры)
	
	УстановитьПривилегированныйРежим(Истина);
	
	МетаданныеОбъекта = Ссылка.Метаданные();
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(	
		МетаданныеОбъекта.ПолноеИмя());
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(МетаданныеОбъекта.ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	ЭлементБлокировки = Блокировка.Добавить(Метаданные.Справочники.ДокументыБИА.ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("ОбъектОснование", Ссылка);
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		ЕстьОшибкиПроверки = Ложь;
		ДокументыБИА = СоздатьДокументБИАРегламентированногоОтчета(Ссылка, ДополнительныеПараметры);
		Если ДокументыБИА.Количество() = 0 Тогда
			ВызватьИсключение НСтр("ru = 'Документы для 1С:Архива не сформированы. Обратитесь к администратору.'");
		КонецЕсли;
		Для Каждого ДокументОбъект Из ДокументыБИА Цикл
			Если ДокументОбъект.ПроверитьЗаполнение() Тогда
				ДокументОбъект.Записать();
			Иначе
				ЕстьОшибкиПроверки = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьОшибкиПроверки Тогда
			ВызватьИсключение НСтр("ru = 'Обнаружены ошибки проверки заполнения документов для 1С:Архива'");
		Иначе
			Событие = ОбменСАрхивом.СобытиеДляЛога();
			Событие.ОсновнойОбъект = Ссылка;
			Событие.ТипСобытия = Перечисления.СобытияОбменаС1САрхивом.Информация;
			Событие.КраткоеОписание = НСтр("ru = 'Отметка документа регламентированного отчета к выгрузке.'");
			Событие.ДополнительныеСведения = "";
			ОбменСАрхивом.ЗаписатьВЛог(Событие);
				
			РегистрыСведений.ДокументыОтправленныеВ1САрхив.Добавить(Ссылка);
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция СоздатьДокументБИАРегламентированногоОтчета(СсылкаНаОбъектИсточник, ДополнительныеПараметры)
	
	УстановитьПривилегированныйРежим(Истина);
	
	СформированныеДокументыБИА = Новый Массив;
	
	Если ТипЗнч(СсылкаНаОбъектИсточник) <> Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		Возврат СформированныеДокументыБИА;
	КонецЕсли;
	
	СформированныеДокументыБИА = СоздатьДокументыБИА(СсылкаНаОбъектИсточник);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

Функция ПредставленияКомандВыгрузкиВАрхив()
	
	ПредставленияКоманд = Новый Структура;
	ПредставленияКоманд.Вставить("История",		НСтр("ru='История обмена с 1С:Архивом'"));
	ПредставленияКоманд.Вставить("Отменить",	НСтр("ru='Отменить отправку в 1С:Архив'"));
	ПредставленияКоманд.Вставить("Отправить",	НСтр("ru='Отправить в 1С:Архив'"));
	ПредставленияКоманд.Вставить("Отозвать",	НСтр("ru='Отозвать документ из 1С:Архива'"));
	ПредставленияКоманд.Вставить("Скачать",		НСтр("ru='Скачать'"));
	
	Возврат ПредставленияКоманд;
	
КонецФункции

