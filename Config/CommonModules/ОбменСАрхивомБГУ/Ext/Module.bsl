Функция ФайлВизуализацииВнешнегоЭД(СсылкаНаОбъектИсточник, ИмяФайлаБезРасширения, ТабличныйДокументПредставленияФормуляра, НовыйДокументБИА)
	Результат = Неопределено;
	Формат = ТипФайлаТабличногоДокумента.PDF_A_3;
	ИмяФайлаPDFПредставленияДокументаБезРасширения = СокрЛП(ИмяФайлаБезРасширения) + " (ЭДО с контрагентами, копия)";

	ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
	ПолноеИмяФайлаПредставленияФормуляраPDF = ИмяВременногоКаталога + ИмяФайлаPDFПредставленияДокументаБезРасширения + ".pdf";

	ТабличныйДокументПредставленияФормуляра.АвтоМасштаб = Истина;
	ТабличныйДокументПредставленияФормуляра.Записать(ПолноеИмяФайлаПредставленияФормуляраPDF, Формат);
	
	ДвоичныеДанныеФайлаПредставленияФормуляраPDF = Новый ДвоичныеДанные(ПолноеИмяФайлаПредставленияФормуляраPDF);
	
	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
	ПараметрыФайла.ВладелецФайлов = НовыйДокументБИА.Ссылка;
	ПараметрыФайла.ИмяБезРасширения = ИмяФайлаPDFПредставленияДокументаБезРасширения + ".pdf"; 
	ПараметрыФайла.Служебный = Ложь;
	
	ИдентификаторФормы = Новый УникальныйИдентификатор;
	АдресФайлаПредставленияФормуляраPDF = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаПредставленияФормуляраPDF, ИдентификаторФормы);
	
	ПредставлениеФормуляраФайлPDF = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайлаПредставленияФормуляраPDF);

	Результат = ПредставлениеФормуляраФайлPDF;

	Возврат Результат;
КонецФункции

Функция ФайлВнешнегоДокуменооборотаЦеликом(ВнешнийДокумент, ИмяФайлаPDFПредставленияДокументаБезРасширения, НовыйДокументБИА)
	Результат = Неопределено;
	
	ЭлектронныеДокументы = Новый Массив;
	ЭлектронныеДокументы.Добавить(ВнешнийДокумент);
	
	АдресДанныхВХранилище = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	СоответствиеФайловВыгрузки = ИнтерфейсДокументовЭДОВызовСервера.СформироватьФайлыВыгрузкиЭДДокументооборотЦеликом(
		ЭлектронныеДокументы, 
		АдресДанныхВХранилище);
		
	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
	ПараметрыФайла.ВладелецФайлов = НовыйДокументБИА.Ссылка;
	ПараметрыФайла.ИмяБезРасширения = ИмяФайлаPDFПредставленияДокументаБезРасширения + " (все файлы ЭДО).zip";
	ПараметрыФайла.Служебный = Ложь;
	
	ИдентификаторФормы = Новый УникальныйИдентификатор;
		
	Результат = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресДанныхВХранилище);
		
	Возврат Результат;
КонецФункции	

Функция ФайлВизуализацииВнешнегоИзвещенияИзПоПечатнойФормеДляЭДО(СсылкаНаОбъектИсточник, ИмяФайлаБезРасширения, НовыйДокументБИА)
	Результат = Неопределено;
	ИдентификаторКомандыПечати = "Извещение_Электронное";
	Формат = ТипФайлаТабличногоДокумента.PDF_A_3;
	ИмяФайлаPDFПредставленияДокументаБезРасширения = СокрЛП(ИмяФайлаБезРасширения) + " (копия)";
	
 	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	
	МетаданныеОбъекта = СсылкаНаОбъектИсточник.Метаданные();
	
	ПолноеИмяФормы = МетаданныеОбъекта.ОсновнаяФормаОбъекта.Имя;
	СписокОбъектов = Новый Массив();
	СписокОбъектов.Добавить(МетаданныеОбъекта);
	
	КомандыПечати = МодульУправлениеПечатью.КомандыПечатиФормы(ПолноеИмяФормы, СписокОбъектов);
	НайденнаяКоманда = КомандыПечати.Найти(ИдентификаторКомандыПечати, "Идентификатор");
	Если НайденнаяКоманда = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КомандаПечатиВФайл = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НайденнаяКоманда);

	МассивОбъектовУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаОбъектИсточник);
	
	НастройкиСохранения = МодульУправлениеПечатью.НастройкиСохранения();
	НастройкиСохранения.ФорматыСохранения.Добавить(Формат);
	
	РезультатПечати = Неопределено;
	Попытка
		РезультатПечати = МодульУправлениеПечатью.НапечататьВФайл(КомандаПечатиВФайл, МассивОбъектовУчета, НастройкиСохранения);
	Исключение
		ТекстСообщения  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось сформировать на сервере печатную форму ""%1"" для формуляра документа ""%2"".'"), НайденнаяКоманда, СсылкаНаОбъектИсточник);
		Сообщение       = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
	КонецПопытки;
	
	ДвоичныеДанныеФайлаПредставленияФормуляраPDF = Неопределено;
	Если ЗначениеЗаполнено(РезультатПечати) Тогда
		ДвоичныеДанныеФайлаПредставленияФормуляраPDF = РезультатПечати[0].ДвоичныеДанные;
	КонецЕсли;
	
	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
	ПараметрыФайла.ВладелецФайлов = НовыйДокументБИА.Ссылка;
	ПараметрыФайла.ИмяБезРасширения = ИмяФайлаPDFПредставленияДокументаБезРасширения + ".pdf";
	ПараметрыФайла.Служебный = Ложь;
	
	ИдентификаторФормы = Новый УникальныйИдентификатор;
	АдресФайлаПредставленияФормуляраPDF = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаПредставленияФормуляраPDF, ИдентификаторФормы);
	
	Результат = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайлаПредставленияФормуляраPDF);

	Возврат Результат;
КонецФункции	

Процедура ДобавитьФайлВизуализацииВнешнегоЭД(СсылкаНаОбъектИсточник, ВнешнийДокумент, НовыйДокументБИА, СтрокаФайла, ОписаниеФайла)
	//Файл визуализации внешнего ЭД с штампами ЭП
	НастройкиПредставления = ВизуализацияЭДО.НовыеНастройкиПредставления();
	НастройкиПредставления.ЕстьНастройкаВыводаДополнительныхДанных = Истина;
	НастройкиПредставления.ЕстьНастройкаВыводаБанковскихРеквизитов = Истина;
	НастройкиПредставления.ЕстьНастройкаВыводаКопияВерна = Ложь;
	НастройкиПредставления.ЕстьИдДокумента = Истина;
	НастройкиПредставления.ЕстьQRКод = Ложь;
	
	КэшВизуализации = ВизуализацияЭДО.ПолучитьВизуализациюИзКэша(ВнешнийДокумент.ЭлектронныйДокумент, НастройкиПредставления);
	Если КэшВизуализации.ПредставлениеДокумента = Неопределено ИЛИ КэшВизуализации = Неопределено Тогда
		ВизуализацияЭДОСлужебный.ОбновитьКэшВизуализации(ВнешнийДокумент.ЭлектронныйДокумент);
		КэшФайлаВизуализации = ВизуализацияЭДО.ПолучитьВизуализациюИзКэша(ВнешнийДокумент.ЭлектронныйДокумент, НастройкиПредставления);
	КонецЕсли;	

	Если НЕ КэшВизуализации.ПредставлениеДокумента = Неопределено И НЕ КэшВизуализации = Неопределено Тогда
		ТабДокументВизуализации = КэшВизуализации.ПредставлениеДокумента;
		ФайлВизуализацииВнешнегоЭД = ФайлВизуализацииВнешнегоЭД(СсылкаНаОбъектИсточник, ОписаниеФайла, ТабДокументВизуализации, НовыйДокументБИА);
		Если ЗначениеЗаполнено(ФайлВизуализацииВнешнегоЭД) Тогда
			СтрокаФайла.ФайлВизуализации = ФайлВизуализацииВнешнегоЭД;
		КонецЕсли;
	Иначе
		ТабДокументВизуализации = ВизуализацияСтарыхДокументовВнешнегоЭДО(ВнешнийДокумент.ЭлектронныйДокумент);
		Если НЕ ТабДокументВизуализации = Неопределено Тогда
			ФайлВизуализацииВнешнегоЭД = ФайлВизуализацииВнешнегоЭД(СсылкаНаОбъектИсточник, ОписаниеФайла, ТабДокументВизуализации, НовыйДокументБИА);
			Если ЗначениеЗаполнено(ФайлВизуализацииВнешнегоЭД) Тогда
				СтрокаФайла.ФайлВизуализации = ФайлВизуализацииВнешнегоЭД;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ВизуализацияСтарыхДокументовВнешнегоЭДО(ЭлектронныйДокумент)
	Результат = Неопределено;
	
	ПараметрыСоставаПечати = ИнтерфейсДокументовЭДО.ПараметрыСоставаПечатиЭлектронныхДокументов();
	ПараметрыСоставаПечати.ПечататьЭлектронныйДокумент = Истина;
	ПараметрыСоставаПечати.ПечататьТехнологическиеКвитанции = Ложь;
	ПараметрыСоставаПечати.ПечататьКарточкуЭлектронногоДокумента = Ложь;
	ПараметрыСоставаПечати.ПечататьРеестрЭлектронныхДокументов = Ложь;
	ПараметрыСоставаПечати.ПечататьКарточкуЕслиНеУдалосьНапечататьЭлектронныйДокумент = Ложь;
	ПараметрыСоставаПечати.ВыводитьШтампыПодписей = Истина;
	ПараметрыСоставаПечати.ДополнятьСинонимМакетаВидомПечатнойФормы = Ложь;
	ПараметрыСоставаПечати.ПечататьПротоколОбменаПоДокументу = Ложь;

	ПараметрыВизуализации = ИнтерфейсДокументовЭДО.НовыеПараметрыВизуализацииДокумента();
	ПараметрыВизуализации.ВыводитьБанковскиеРеквизиты = Ложь;
	ПараметрыВизуализации.ВыводитьДопДанные = Ложь;
	ПараметрыВизуализации.ВыводитьКопияВерна = Ложь;

	ПечатныеФормы = ИнтерфейсДокументовЭДО.СформироватьПечатныеФормыЭлектронныхДокументов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЭлектронныйДокумент), ПараметрыСоставаПечати,
	    ПараметрыВизуализации);
	Если ПечатныеФормы.Количество() > 0 Тогда	
		Результат = ПечатныеФормы.Получить(0).ТабличныйДокумент;
	КонецЕсли;
	
	Возврат Результат; 
КонецФункции	

Процедура ДобавитьПриложенныеФайлыВСоставеПрикладногоЭД(УчетныйДокумент, НовыйДокументБИА)
	//Приложенные файлы (в составе прикладного ЭД)
	ДанныеФайловПрисоединенныхКДокументу = ЭлектронныеДокументыБГУ.ДанныеФайловПрисоединенныхКДокументуАктаПередачиНФА(УчетныйДокумент);
	
	Для Каждого ТекФайл Из ДанныеФайловПрисоединенныхКДокументу Цикл
		Файл = ТекФайл.ПрисоединенныйФайл;
		
		Если Файл.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
			
		СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
		СтрокаФайла.Файл = Файл;
		СтрокаФайла.Роль = РольФайлаБИАДополнительныйФайл();
	КонецЦикла;
КонецПроцедуры		

Процедура ДобавитьВнутренниеЭДКПрикладномуЭД(СсылкаНаОбъектИсточник, ВидДокументаБИА, НовыйДокументБИА)

	ДокументыДляВыгрузки = ВнутренниеЭлектронныеДокументыДляВыгрузки(СсылкаНаОбъектИсточник);

	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДокументыДляВыгрузки, 
		"Организация, ОсновнойФайл, ОсновнойФайлPDF, ПредставлениеФормуляраФайлPDF, УчетныйДокумент, ИдентификаторКомандыПечати, ВидДокумента, ДатаДокумента, НомерДокумента");

	Для Каждого ВнутреннийДокумент Из ДокументыДляВыгрузки Цикл
		ОсновнойФайл = РеквизитыДокументов[ВнутреннийДокумент].ОсновнойФайл;
		ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
		ПараметрыДанных.ВызыватьИсключение = Ложь;
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ОсновнойФайл, ПараметрыДанных);
		Организация = РеквизитыДокументов[ВнутреннийДокумент].Организация;
		
		ОсновнойФайлPDF = РеквизитыДокументов[ВнутреннийДокумент].ОсновнойФайлPDF;
		ПредставлениеФормуляраФайлPDF = РеквизитыДокументов[ВнутреннийДокумент].ПредставлениеФормуляраФайлPDF;
		
		ЕстьФормулярPDF = Ложь;
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ЕстьФормулярPDF = Истина;
		КонецЕсли;
		
		ИдентификаторКомандыПечати = РеквизитыДокументов[ВнутреннийДокумент].ИдентификаторКомандыПечати;
		
		ВидДокументаБИАТекущегоДокумента = ВидДокументаДляАрхиваДляВнутреннегоЭД(СсылкаНаОбъектИсточник, ИдентификаторКомандыПечати);
		
		Если ВидДокументаБИАТекущегоДокумента = ВидДокументаБИА Тогда
			
			Если ЕстьФормулярPDF Тогда
				СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
				СтрокаФайла.Файл = ОсновнойФайлPDF;
				СтрокаФайла.Роль = РольФайлаБИАВнутреннийЭД();
				
				//Добавление сведений о ЭП
				ДобавлениеПодписейФайла(НовыйДокументБИА, ОсновнойФайлPDF);
				
				//Файл визуализации формируем из подписанного MXL файла
				ПредставлениеФормуляраФайлPDF = ФайлВизуализацииФормуляраПРОФИзПодписанногоФайлаMXL(
					Организация, ОсновнойФайл, ДанныеФайла, НовыйДокументБИА);
				Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
					СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
				КонецЕсли;	
				
			Иначе
				//Нет файла формуляра в формате PDF
		 		СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
				СтрокаФайла.Файл = ОсновнойФайл;
				СтрокаФайла.Роль = РольФайлаБИАВнутреннийЭД();
				
				Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
					//Есть файл представления формуляра
					СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
					
					//Добавление сведений заверяющих подписей при наличии
					ДобавлениеПодписейФайла(НовыйДокументБИА, ПредставлениеФормуляраФайлPDF);
				Иначе
					//Нет файла представления формуляра
					//Файл визуализации формируем из подписанного MXL файла
					ПредставлениеФормуляраФайлPDF = ФайлВизуализацииФормуляраПРОФИзПодписанногоФайлаMXL(
						Организация, ОсновнойФайл, ДанныеФайла, НовыйДокументБИА);
					Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
						СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	

КонецПроцедуры

Функция ФайлВизуализацииВнешнегоАктаОПриемеПередачеПоПечатнойФормеДляЭДО(СсылкаНаОбъектИсточник, ИмяФайлаБезРасширения, НовыйДокументБИА)
	Результат = Неопределено;
	ИдентификаторКомандыПечати = "АктОПриемеПередачеОбъектовНФАЭлектронный";
	Формат = ТипФайлаТабличногоДокумента.PDF_A_3;
	ИмяФайлаPDFПредставленияДокументаБезРасширения = СокрЛП(ИмяФайлаБезРасширения) + " (копия)";
	
 	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	
	МетаданныеОбъекта = СсылкаНаОбъектИсточник.Метаданные();
	
	ПолноеИмяФормы = МетаданныеОбъекта.ОсновнаяФормаОбъекта.Имя;
	СписокОбъектов = Новый Массив();
	СписокОбъектов.Добавить(МетаданныеОбъекта);
	
	КомандыПечати = МодульУправлениеПечатью.КомандыПечатиФормы(ПолноеИмяФормы, СписокОбъектов);
	НайденнаяКоманда = КомандыПечати.Найти(ИдентификаторКомандыПечати, "Идентификатор");
	Если НайденнаяКоманда = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КомандаПечатиВФайл = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НайденнаяКоманда);

	МассивОбъектовУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаОбъектИсточник);
	
	НастройкиСохранения = МодульУправлениеПечатью.НастройкиСохранения();
	НастройкиСохранения.ФорматыСохранения.Добавить(Формат);
	
	РезультатПечати = Неопределено;
	Попытка
		РезультатПечати = МодульУправлениеПечатью.НапечататьВФайл(КомандаПечатиВФайл, МассивОбъектовУчета, НастройкиСохранения);
	Исключение
		ТекстСообщения  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось сформировать на сервере печатную форму ""%1"" для формуляра документа ""%2"".'"), НайденнаяКоманда, СсылкаНаОбъектИсточник);
		Сообщение       = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
	КонецПопытки;
	
	ДвоичныеДанныеФайлаПредставленияФормуляраPDF = Неопределено;
	Если ЗначениеЗаполнено(РезультатПечати) Тогда
		ДвоичныеДанныеФайлаПредставленияФормуляраPDF = РезультатПечати[0].ДвоичныеДанные;
	КонецЕсли;
	
	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
	ПараметрыФайла.ВладелецФайлов = НовыйДокументБИА.Ссылка;
	ПараметрыФайла.ИмяБезРасширения = ИмяФайлаPDFПредставленияДокументаБезРасширения + ".pdf";
	ПараметрыФайла.Служебный = Ложь;
	
	ИдентификаторФормы = Новый УникальныйИдентификатор;
	АдресФайлаПредставленияФормуляраPDF = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаПредставленияФормуляраPDF, ИдентификаторФормы);
	
	Результат = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайлаПредставленияФормуляраPDF);

	Возврат Результат;
КонецФункции

Функция ОснованиеЭлектронныйДокументПоставщика(СсылкаНаОбъектИсточник)
	Результат = Документы.ЭлектронныйДокументПоставщика.ПустаяСсылка();

	Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПоступлениеИК")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПоступлениеМЗ")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.АктПриемкиМ7")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.НачислениеАмортизацииПравПользованияОС")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПоступлениеМЗВПути")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПоступлениеОС")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПоступлениеОСВПути")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПоступлениеОСИК")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПоступлениеУслугРабот")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПоступлениеУслугРаботПоСчетамУчетаЗатрат")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПриходныйОрдерФондовый")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ПрочееОтражениеЭлектронногоДокументаВУчете")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовМЗ")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовМЗИК")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК") Тогда
