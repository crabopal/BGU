Функция ДокументРаспискиПоДокументуИнвентаризации(УчетныйДокумент) Экспорт
	УстановитьПривилегированныйРежим(Истина);

	Результат = Документы.РаспискаИнвентаризации.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствияДокументовИнвентаризационныхОписейИРасписок.ДокументРасписки.Ссылка КАК ДокументРаспискиСсылка
	               |ИЗ
	               |	РегистрСведений.СоответствияДокументовИнвентаризационныхОписейИРасписок КАК СоответствияДокументовИнвентаризационныхОписейИРасписок
	               |ГДЕ
	               |	СоответствияДокументовИнвентаризационныхОписейИРасписок.ДокументОписи = &ДокументОписи";
	Запрос.УстановитьПараметр("ДокументОписи", УчетныйДокумент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ДокументРаспискиСсылка;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Процедура ДобавитьВДокументБИАФайлыОтдельногоВнутреннегоЭДРасписки(НовыйДокументБИА, СсылкаНаОбъектИсточник)
	ВнутреннийЭД = ВнутренниеЭлектронныеДокументыБГУ.ВнутреннийЭДРаспискиИнвентаризации(СсылкаНаОбъектИсточник);
	
	ДобавитьВДокументБИАФайлыОтдельногоВнутреннегоЭД(НовыйДокументБИА, СсылкаНаОбъектИсточник, ВнутреннийЭД);
КонецПроцедуры

Процедура ДобавитьВДокументБИАФайлыОтдельногоВнутреннегоЭД(НовыйДокументБИА, СсылкаНаОбъектИсточник, ВнутреннийДокумент)
	
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВнутреннийДокумент, 
		"Организация, ОсновнойФайл, ОсновнойФайлPDF, ПредставлениеФормуляраФайлPDF, УчетныйДокумент, ИдентификаторКомандыПечати, ВидДокумента, ДатаДокумента, НомерДокумента");

	ВалютаДокументаПоУмолчанию = Константы.ВалютаРегламентированногоУчета.Получить();
	
	РеквизитыУчетногоДокумента = Новый Структура;
	РеквизитыУчетногоДокумента.Вставить("СуммаДокумента", 0);
	РеквизитыУчетногоДокумента.Вставить("ВалютаДокумента", ВалютаДокументаПоУмолчанию);
	ЗаполнитьЗначенияСвойств(РеквизитыУчетногоДокумента, СсылкаНаОбъектИсточник);

	ОсновнойФайл = РеквизитыДокументов.ОсновнойФайл;
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ВызыватьИсключение = Ложь;
	ДанныеФайла = РаботаСФайлами.ДанныеФайла(ОсновнойФайл, ПараметрыДанных);
	Организация = РеквизитыДокументов.Организация;
	
	ОсновнойФайлPDF = РеквизитыДокументов.ОсновнойФайлPDF;
	ПредставлениеФормуляраФайлPDF = РеквизитыДокументов.ПредставлениеФормуляраФайлPDF;
	
	ЕстьФормулярPDF = Ложь;
	Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
		ЕстьФормулярPDF = Истина;
	КонецЕсли;
	
	Если ЕстьФормулярPDF Тогда
		СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
		СтрокаФайла.Файл = ОсновнойФайлPDF;
		СтрокаФайла.Роль = РольФайлаБИАВнутреннийЭД();
		
		//Добавление сведений о ЭП
		ДобавлениеПодписейФайла(НовыйДокументБИА, ОсновнойФайлPDF);
		
		//Файл визуализации формируем из подписанного MXL файла
		ПредставлениеФормуляраФайлPDF = ФайлВизуализацииФормуляраПРОФИзПодписанногоФайлаMXL(
			Организация, ОсновнойФайл, ДанныеФайла, НовыйДокументБИА);
		Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
			СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
		КонецЕсли;	
		
	Иначе
		//Нет файла формуляра в формате PDF
 		СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
		СтрокаФайла.Файл = ОсновнойФайл;
		СтрокаФайла.Роль = РольФайлаБИАВнутреннийЭД();
		
		Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
			//Есть файл представления формуляра
			СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
			
			//Добавление сведений заверяющих подписей при наличии
			ДобавлениеПодписейФайла(НовыйДокументБИА, ПредставлениеФормуляраФайлPDF);
		Иначе
			//Нет файла представления формуляра
			//Файл визуализации формируем из подписанного MXL файла
			ПредставлениеФормуляраФайлPDF = ФайлВизуализацииФормуляраПРОФИзПодписанногоФайлаMXL(
				Организация, ОсновнойФайл, ДанныеФайла, НовыйДокументБИА);
			Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
				СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	//Присоединенные файлы с ЭЦП и МЧД при наличии
	ДобавитьПрисоединенныеКОбъектуФайлы(СсылкаНаОбъектИсточник, НовыйДокументБИА); 
	
КонецПроцедуры

Процедура ДобавитьПрисоединенныеКОбъектуФайлы(СсылкаНаОбъектИсточник, НовыйДокументБИА) Экспорт
	
	//Присоединенные файлы с ЭЦП и МЧД при наличии
	Файлы = Новый Массив;
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(СсылкаНаОбъектИсточник, Файлы);
	Для Каждого Файл Из Файлы Цикл
		Если Файл.ПометкаУдаления ИЛИ Файл.Служебный Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
		СтрокаФайла.Файл = Файл;
		СтрокаФайла.Роль = РольФайлаБИАДополнительныйФайл();

		//Добавление сведений о ЭП
		ДобавлениеПодписейФайла(НовыйДокументБИА, Файл);
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьДокументыБИАДляДокументаУчетаВнешнегоПрикладногоЭД(СсылкаНаОбъектИсточник, ДокументыБИА) Экспорт
