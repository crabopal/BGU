#Область ПрограммныйИнтерфейс

// Выполняет обновление элементов справочника ВидыДокументовБИА,
//   обусловленное изменением конфигурации.
// 
// Параметры:
//  ПараметрОбработчика - Структура - параметры обязательного обработчика обновления.
//    Если в ходе выполнения обработчика возникает необходимость внесения изменений в ИБ,
//    обработчик должен установить значение свойства ПараметрОбработчика.МонопольныйРежим в Истина
//    и прекратить свое выполнение. После этого обработчик будет вызван повторно
//    после установки монопольного режима, значение ПараметрОбработчика.МонопольныйРежим будет равно Истина.
//    В этом втором вызове следует выполнять необходимые изменения данных. 
//
Процедура ОбновитьВидыДокументовПриОбновленииКонфигурации(ПараметрОбработчика) Экспорт

	Если ПараметрОбработчика <> Неопределено И ПараметрОбработчика.МонопольныйРежим = Ложь Тогда
		ПараметрОбработчика.МонопольныйРежим = Истина;
		Возврат;
	КонецЕсли;
	
	СозданиеОбновлениеВидовДокументовДляБГУ();
	
КонецПроцедуры

// Заполняет таблицу реквизитов объектов НСИ для отправки в Архив.
//  Необходимо передать таблицу с именами колонок, соответствующими именам реквизитов объекта XDTO.
//
// Параметры:
//  СсылкиНаОбъектыНСИ - Массив из СправочникСсылка - порция измененных элементов НСИ одного типа.
//  СвойстваОбъектаXDTO - КоллекцияСвойствXDTO - коллекция всех свойств объекта XDTO. 
//     В новом формате состав коллекции может содержать новые или измененные свойства, поэтому наличие этих свойств
//     в объекте XDTO нужно проверить при выгрузке.
//
// Возвращаемое значение:
//  Неопределено, ТаблицаЗначений -
//   * Ссылка - СправочникСсылка - ссылка на объект НСИ.
//   * <ИмяРеквизитаXDTO> - Произвольный - значение, соответствующее реквизиту объекта XDTO.
//  
//  Неопределено, если для указанного типа не предусмотрен алгоритм формирования данных.
//  В этом случае при обмене будет зафиксирована ошибка в журнале регистрации. 
//
Функция ТаблицаДанныхНСИДляВыгрузки(СсылкиНаОбъектыНСИ, СвойстваОбъектаXDTO) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	ТипОбъекта = ТипЗнч(СсылкиНаОбъектыНСИ[0]);
	
	Если ТипОбъекта = Тип("СправочникСсылка.Организации") Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Таблица.Ссылка КАК Ссылка,
			|	Таблица.Наименование КАК Name,
			|	Таблица.ПометкаУдаления КАК DeletionMark,
			|	Таблица.НаименованиеПолное КАК FullDescr,
			|	Таблица.ИНН КАК TIN,
			|	Таблица.КПП КАК PPC,
			|	ВЫРАЗИТЬ("""" КАК Строка(36)) КАК ID
			|ИЗ
			|	Справочник.Организации КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В(&СсылкиНаОбъектыНСИ)");
		Запрос.УстановитьПараметр("СсылкиНаОбъектыНСИ", СсылкиНаОбъектыНСИ);
		ТабДанныхНСИ = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрНСИ Из ТабДанныхНСИ Цикл
			СтрНСИ.ID = ОбменСАрхивом.ИдентификаторСсылки(СтрНСИ.Ссылка);
		КонецЦикла;
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.Подразделения") Тогда	
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Таблица.Ссылка КАК Ссылка,
			|	Таблица.Наименование КАК Name,
			|	Таблица.ПометкаУдаления КАК DeletionMark,
			|	Таблица.Родитель КАК Родитель,
			|	"""" КАК Руководитель,
			|	ВЫРАЗИТЬ("""" КАК Строка(36)) КАК ID,
			|	ВЫРАЗИТЬ("""" КАК Строка(36)) КАК ParentID,
			|	ВЫРАЗИТЬ("""" КАК Строка(36)) КАК ManagerID
			|ИЗ
			|	Справочник.Подразделения КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В(&СсылкиНаОбъектыНСИ)");
		Запрос.УстановитьПараметр("СсылкиНаОбъектыНСИ", СсылкиНаОбъектыНСИ);
		ТабДанныхНСИ = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрНСИ Из ТабДанныхНСИ Цикл
			СтрНСИ.ID = ОбменСАрхивом.ИдентификаторСсылки(СтрНСИ.Ссылка);
			Если ЗначениеЗаполнено(СтрНСИ.Родитель) Тогда
				СтрНСИ.ParentID = ОбменСАрхивом.ИдентификаторСсылки(СтрНСИ.Родитель);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрНСИ.Руководитель) Тогда
				СтрНСИ.ManagerID = ОбменСАрхивом.ИдентификаторСсылки(СтрНСИ.Руководитель);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.Должности") Тогда	
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Таблица.Ссылка КАК Ссылка,
			|	Таблица.Наименование КАК Name,
			|	Таблица.ПометкаУдаления КАК DeletionMark,
			|	ВЫРАЗИТЬ("""" КАК Строка(36)) КАК ID
			|ИЗ
			|	Справочник.Должности КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В(&СсылкиНаОбъектыНСИ)");
		Запрос.УстановитьПараметр("СсылкиНаОбъектыНСИ", СсылкиНаОбъектыНСИ);
		ТабДанныхНСИ = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрНСИ Из ТабДанныхНСИ Цикл
			СтрНСИ.ID = ОбменСАрхивом.ИдентификаторСсылки(СтрНСИ.Ссылка);
		КонецЦикла;
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ФизическиеЛица") Тогда	
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Таблица.Ссылка КАК Ссылка,
			|	Таблица.ЭтоГруппа КАК IsFolder,
			|	Таблица.Наименование КАК Name,
			|	Таблица.ПометкаУдаления КАК DeletionMark,
			|	Таблица.ДатаРождения КАК BirthDate,
			|	Таблица.Родитель КАК Родитель,
			|	Таблица.ИНН КАК TIN,
			|	Таблица.СтраховойНомерПФР КАК NIN,
			|	ВЫРАЗИТЬ("""" КАК Строка(36)) КАК ID,
			|	ВЫРАЗИТЬ("""" КАК Строка(36)) КАК FolderID
			|ИЗ
			|	Справочник.ФизическиеЛица КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В(&СсылкиНаОбъектыНСИ)");
		Запрос.УстановитьПараметр("СсылкиНаОбъектыНСИ", СсылкиНаОбъектыНСИ);
		ТабДанныхНСИ = Запрос.Выполнить().Выгрузить();

		Для Каждого СтрНСИ Из ТабДанныхНСИ Цикл
			СтрНСИ.ID = ОбменСАрхивом.ИдентификаторСсылки(СтрНСИ.Ссылка);
			Если ЗначениеЗаполнено(СтрНСИ.Родитель) Тогда
				СтрНСИ.FolderID = ОбменСАрхивом.ИдентификаторСсылки(СтрНСИ.Родитель);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.Контрагенты") Тогда	
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Таблица.Ссылка КАК Ссылка,
			|	Таблица.ЭтоГруппа КАК IsFolder,
			|	Таблица.Наименование КАК Name,
			|	Таблица.ПометкаУдаления КАК DeletionMark,
			|	Таблица.ИНН КАК TIN,
			|	Таблица.КПП КАК PPC,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(Таблица.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ЮридическиеЛица)
			|			ТОГДА ВЫРАЗИТЬ(Таблица.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).НаименованиеПолное
			|		КОГДА ТИПЗНАЧЕНИЯ(Таблица.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ФизическиеЛица)
			|			ТОГДА ВЫРАЗИТЬ(Таблица.ЮридическоеФизическоеЛицо КАК Справочник.ФизическиеЛица).Наименование
			|	КОНЕЦ КАК FullDescr,
			|	Таблица.Родитель КАК Родитель,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(Таблица.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ЮридическиеЛица)
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицоКонтрагентаДляАрхива.ЮрЛицо)
			|		КОГДА ТИПЗНАЧЕНИЯ(Таблица.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ФизическиеЛица) И ВЫРАЗИТЬ(Таблица.ЮридическоеФизическоеЛицо КАК Справочник.ФизическиеЛица).ОГРНИП = """"
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицоКонтрагентаДляАрхива.ФизЛицо)
			|		КОГДА ТИПЗНАЧЕНИЯ(Таблица.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ФизическиеЛица) И НЕ ВЫРАЗИТЬ(Таблица.ЮридическоеФизическоеЛицо КАК Справочник.ФизическиеЛица).ОГРНИП = """"
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицоКонтрагентаДляАрхива.ИндивидуальныйПредприниматель)
			|	КОНЕЦ КАК ЮрФизЛицо,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(Таблица.ЮридическоеФизическоеЛицо) = ТИП(Справочник.ФизическиеЛица)
			|			ТОГДА Таблица.ЮридическоеФизическоеЛицо
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
			|	КОНЕЦ КАК ФизЛицо,
			|	ВЫРАЗИТЬ("""" КАК СТРОКА(36)) КАК ID,
			|	ВЫРАЗИТЬ("""" КАК СТРОКА(36)) КАК FolderID,
			|	ВЫРАЗИТЬ("""" КАК СТРОКА(36)) КАК IndividualID,
			|	ВЫРАЗИТЬ("""" КАК СТРОКА(150)) КАК Type
			|ИЗ
			|	Справочник.Контрагенты КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В(&СсылкиНаОбъектыНСИ)");
		Запрос.УстановитьПараметр("СсылкиНаОбъектыНСИ", СсылкиНаОбъектыНСИ);
		ТабДанныхНСИ = Запрос.Выполнить().Выгрузить();

		Для Каждого СтрНСИ Из ТабДанныхНСИ Цикл
			СтрНСИ.ID = ОбменСАрхивом.ИдентификаторСсылки(СтрНСИ.Ссылка);
			Если ЗначениеЗаполнено(СтрНСИ.Родитель) Тогда
				СтрНСИ.FolderID = ОбменСАрхивом.ИдентификаторСсылки(СтрНСИ.Родитель);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрНСИ.ФизЛицо) Тогда
				СтрНСИ.IndividualID = ОбменСАрхивом.ИдентификаторСсылки(СтрНСИ.ФизЛицо);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрНСИ.ЮрФизЛицо) Тогда
				СтрНСИ.Type = Метаданные.Перечисления.ЮрФизЛицоКонтрагентаДляАрхива.ЗначенияПеречисления[
					Перечисления.ЮрФизЛицоКонтрагентаДляАрхива.Индекс(СтрНСИ.ЮрФизЛицо)].Имя;
			Иначе
				СтрНСИ.Type = Неопределено;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТабДанныхНСИ;
	
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//  ДокументыБИА - Массив - массив из СправочникОбъект.ДокументыБИА - созданные документы.
//
Процедура СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, ДокументыБИА, ВызовИсключенияПриОшибке = Истина) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ЗаполнитьСведенияВнутреннихЭД = Истина;
	ИспользуетсяПОД = Ложь;
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		Если ОбщегоНазначения.ПодсистемаСуществует("УчетГосУчрежденийКОРППодсистемы") Тогда
			Если ЭлектронныеДокументыБГУ.ИспользуетсяПОД() Тогда
				ИспользуетсяПОД = Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	//Многосоставные инвентаризации
	Если КодТипаДокументаУчетаДокументовОписиИнвентаризации(СсылкаНаОбъектИсточник) = 2 Тогда
		
		ЗаголовочныйДокументИнвентаризации = ЗаголовочныйДокументИнвентаризационнойОписи(СсылкаНаОбъектИсточник);

		ТекстСообщения  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для содержательных документов инвентаризационных описей документы в 1С:Архив выгружаются из заголовочного документа %1.'"), ЗаголовочныйДокументИнвентаризации);
		ВызватьИсключение ТекстСообщения;
		
		Возврат;
	КонецЕсли;

	Если ИспользуетсяПОД Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.СоздатьДокументыБИАДляДокументаУчетаЭД(СсылкаНаОбъектИсточник, ДокументыБИА, ВызовИсключенияПриОшибке);
	Иначе
		СоздатьДокументыБИАДляДокументаУчетаВнутреннегоЭДДляОтчетаГосУчреждения(СсылкаНаОбъектИсточник, ДокументыБИА);
	КонецЕсли;
	
 	СоздатьДокументыБИАДляДокументаУчетаВнутреннегоЭД(СсылкаНаОбъектИсточник, ДокументыБИА);
	СоздатьДокументыБИАДляДокументаУчетаВнешнегоЭД(СсылкаНаОбъектИсточник, ДокументыБИА);
	СоздатьДокументыБИАДляДокументаУчетаВнешнегоПрикладногоЭД(СсылкаНаОбъектИсточник, ДокументыБИА);
	
КонецПроцедуры

//Настройка удаления файлов документов БГУ
// Вызывается после того как из 1С:Архива получена информация о том,
//  что все документы, созданные на основании указанных объектов, приняты.
//
// Параметры:
//  Документы - Массив из ОпределяемыйТип.СсылкаНаИнтегрируемыйОбъектБИА -
//   ссылки на интегрируемые объекты, переданные в 1С:Архив.
//  СтандартнаяОбработка - Булево - если установить Ложь, стандартный алгоритм удаления выполняться не будет.
//
Процедура УдалитьДанныеДокументовПринятыхВАрхив(Документы, СтандартнаяОбработка) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	УдалятьДанныеДокументовБГУПринятыхВАрхив = Константы.УдалятьДанныеДокументовБГУПринятыхВАрхив.Получить();

	Если УдалятьДанныеДокументовБГУПринятыхВАрхив Тогда
		СтандартнаяОбработка = Истина;
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;	
	
КонецПроцедуры

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// Предназначена для случаев, когда процедура создания документов БИА
//  расположена нестандартно (т.е. не в модуле менеджера прикладного объекта).
//  Если функция возвращает значение, отличное от Неопределено,
//  стандартный вызов в модуль менеджера не выполняется.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаИнтегрируемыйОбъектБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из СправочникОбъект.ДокументыБИА, Неопределено - созданные документы.
//   Если возвращается Неопределено, то выполняется стандартное обращение к модулю менеджера объекта.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		
		СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
		
		Возврат СформированныеДокументыБИА;
	КонецЕсли;	
КонецФункции

// См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииКомандПодключенныхКОбъекту.
Процедура ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды) Экспорт

	Если Не ОбменСАрхивомБГУВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаИсточник Из Источники.Строки Цикл
		ДобавитьКомандыБГУ = Ложь;
		Если СтрокаИсточник.ТипСсылкиДанных = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
			ДобавитьКомандыБГУ = Истина;
		КонецЕсли;
			
		Если ДобавитьКомандыБГУ Тогда
			ПриОпределенииКомандПодключенныхКОбъектуДляОбменаСАрхивом(НастройкиФормы, Источники,
				ПодключенныеОтчетыИОбработки, Команды);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииКомандПодключенныхКОбъекту.
Процедура ПриОпределенииКомандПодключенныхКОбъектуДляОбменаСАрхивом(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды) Экспорт
	
	ИмяКомандыОтправитьВ1САрхив = ИмяКомандыОтправитьВ1САрхив();
	ИмяКомандыОтменитьОтправкуВ1САрхив = ИмяКомандыОтменитьОтправкуВ1САрхив();

	ТипИсточника = Неопределено;
	Если ТипЗнч(Источники) = Тип("ДеревоЗначений") Тогда
		Если Источники.Строки.Количество()>0 Тогда
			ТипИсточника = Источники.Строки[0].ТипСсылкиДанных;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипИсточника = Неопределено Или ТипЗнч(ТипИсточника) <> Тип("Тип") Тогда
		Возврат;
	КонецЕсли;
	
	ТипВладельцаФайла = Неопределено;
	СсылкаНаОбъект = Новый(ТипИсточника);
	Если СсылкаНаОбъект.Метаданные().Реквизиты.Найти("Владелецфайла") <> Неопределено Тогда
		ТипВладельцаФайла = ТипЗнч(СсылкаНаОбъект.ВладелецФайла);
	КонецЕсли;
	
	Если Метаданные.ОпределяемыеТипы.ПрисоединенныйФайл.Тип.СодержитТип(ТипИсточника) ИЛИ НастройкиФормы.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
		Если Метаданные.ОпределяемыеТипы.СсылкаНаИнтегрируемыйОбъектБИА.Тип.СодержитТип(ТипИсточника) Тогда
			Если НастройкиФормы.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
				ИмяРеквизитаВидимостиКоманды = "Ссылка";
			Иначе
				ИмяРеквизитаВидимостиКоманды = "ВладелецФайла";
			КонецЕсли;

			ПредставленияКоманд = ПредставленияКомандВыгрузкиВАрхив();
			
			// Отправить в 1С:Архив - клиент.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Представление = ПредставленияКоманд.Отправить;
			Команда.ВидимостьВФормах = "РегламентированнаяОтчетность";
			Команда.Обработчик = "ОбменСАрхивомБГУКлиент.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыОтправитьВ1САрхив);
			ИмяКомандыСервер = СтрШаблон(НСтр("ru = '%1Обычное__%2'"),ИмяПодменюИнтеграцияС1САрхивом(), ИмяКомандыОтправитьВ1САрхив);
			Команда.ДополнительныеПараметры.Вставить("ИмяКомандыСервер", ИмяКомандыСервер);
			
			// Отправить в 1С:Архив - сервер.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.ВидимостьВФормах = "РегламентированнаяОтчетность";
			Команда.Обработчик = "ОбменСАрхивомБГУ.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыОтправитьВ1САрхив);
			Команда.Идентификатор = ИмяКомандыОтправитьВ1САрхив;
			ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(Команда, ИмяРеквизитаВидимостиКоманды);
			
			// Отменить отправку в 1С:Архив - клиент.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Представление = ПредставленияКоманд.Отменить;
			Команда.ВидимостьВФормах = "РегламентированнаяОтчетность";
			Команда.Обработчик = "ОбменСАрхивомБГУКлиент.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыОтменитьОтправкуВ1САрхив);
			ИмяКомандыСервер = СтрШаблон(НСтр("ru = '%1Обычное__%2'"),ИмяПодменюИнтеграцияС1САрхивом(), ИмяКомандыОтменитьОтправкуВ1САрхив);
			Команда.ДополнительныеПараметры.Вставить("ИмяКомандыСервер", ИмяКомандыСервер);
			
			// Отменить отправку в 1С:Архив - сервер.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.ВидимостьВФормах = "РегламентированнаяОтчетность";
			Команда.Обработчик = "ОбменСАрхивомБГУ.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыОтменитьОтправкуВ1САрхив);
			Команда.Идентификатор = ИмяКомандыОтменитьОтправкуВ1САрхив;
			ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(Команда, ИмяРеквизитаВидимостиКоманды);
			
			// Отозвать - клиент.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Представление = ПредставленияКоманд.Отозвать;
			Команда.ВидимостьВФормах = "РегламентированнаяОтчетность";
			Команда.Обработчик = "ОбменСАрхивомБГУКлиент.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыОтозватьИз1САрхива());
			ИмяКомандыСервер = СтрШаблон(НСтр("ru = '%1Обычное__%2'"),ИмяПодменюИнтеграцияС1САрхивом(), ИмяКомандыОтозватьИз1САрхива());
			Команда.ДополнительныеПараметры.Вставить("ИмяКомандыСервер", ИмяКомандыСервер);
			
			// Отозвать - сервер.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.ВидимостьВФормах = "РегламентированнаяОтчетность";
			Команда.Обработчик = "ОбменСАрхивомБГУ.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыОтозватьИз1САрхива());
			Команда.Идентификатор = ИмяКомандыОтозватьИз1САрхива();
			ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(Команда, ИмяРеквизитаВидимостиКоманды);
			
			// История обмена с 1С:Архивом - клиент.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Представление = ПредставленияКоманд.История;
			Команда.ВидимостьВФормах = "РегламентированнаяОтчетность";
			Команда.Обработчик = "ОбменСАрхивомБГУКлиент.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКомандыИсторияОбмена());
			
			// Нажатие - клиент.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Идентификатор = ИмяЭлементаДокументБИА();
			Команда.ВидимостьВФормах = "РегламентированнаяОтчетность";
			Команда.Обработчик = "ОбменСАрхивомБГУКлиент.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", "Нажатие");
			
			// Скачать контейнер - клиент.
			Команда = Команды.Добавить();
			Команда.Важность = "Обычное";
			Команда.Вид = ИмяВидаКомандИнтеграцияС1САрхивом();
			Команда.Подменю = ИмяПодменюИнтеграцияС1САрхивом();
			Команда.Представление = ПредставленияКоманд.Скачать;
			Команда.Идентификатор = "СкачатьКонтейнерДокументаИз1САрхива";
			Команда.ВидимостьВФормах = "РегламентированнаяОтчетность";
			Команда.Обработчик = "ОбменСАрхивомБГУКлиент.ВыполнитьКомандуИнтеграцииС1САрхивом";
			Команда.ДополнительныеПараметры.Вставить("ИмяКоманды", "СкачатьКонтейнерДокументаИз1САрхива0");
			
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

// См. ОбменСАрхивомПереопределяемый.УстановитьВидимостьИДоступностьКоманд.
Процедура УстановитьВидимостьИДоступностьКоманд(Форма, СтандартнаяОбработка = Неопределено) Экспорт
	
	Если Не ОбменСАрхивомБГУВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;

	Если Не Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
		
		Возврат;
		
	КонецЕсли;
		
	Если Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" Тогда
		ТекущаяСтрока = Форма.Элементы.Отчеты.ТекущаяСтрока;
		Если ТекущаяСтрока = Неопределено Тогда
			Возврат;
		Иначе
			Объект = ТекущаяСтрока.Ссылка;
		КонецЕсли;
	Иначе
		Объект = Форма.Объект;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	
	УстановитьВидимостьИДоступностьКомандОбъекта(Объект, Форма);
	
КонецПроцедуры

Процедура УстановитьВидимостьИДоступностьКомандОбъекта(Объект, Форма)
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,"ТаблицаДокументовБИА") Тогда
		ТаблицаДокументовБИА = Форма.ТаблицаДокументовБИА;
	Иначе
		ТаблицаДокументовБИА = ТаблицаДокументовБИА(Объект, Форма);
	КонецЕсли;
	
	ВидимостьКоманд = ВидимостьКоманд(Объект, Форма, ТаблицаДокументовБИА);
	
	ПредставленияКоманд = ПредставленияКомандВыгрузкиВАрхив();
	
	Для Каждого КомандаФормы Из Форма.Команды Цикл
		Если КомандаФормы.Заголовок = ПредставленияКоманд.История Тогда
			Форма.Элементы[КомандаФормы.Имя].Видимость = ВидимостьКоманд.ВидимостьИстория;
		ИначеЕсли КомандаФормы.Заголовок = ПредставленияКоманд.Отменить Тогда
			Форма.Элементы[КомандаФормы.Имя].Видимость = ВидимостьКоманд.ВидимостьОтменить;
		ИначеЕсли КомандаФормы.Заголовок = ПредставленияКоманд.Отправить Тогда
			Форма.Элементы[КомандаФормы.Имя].Видимость = ВидимостьКоманд.ВидимостьОтправить;
		ИначеЕсли КомандаФормы.Заголовок = ПредставленияКоманд.Отозвать Тогда
			Форма.Элементы[КомандаФормы.Имя].Видимость = ВидимостьКоманд.ВидимостьОтозвать;
		КонецЕсли;
	КонецЦикла;
	
	ИмяКнопкиДокументБИА = ИмяПодменюИнтеграцияС1САрхивом()+"Обычное__"+ИмяЭлементаДокументБИА();
	КнопкаДокументБИА = Форма.Элементы.Найти(ИмяКнопкиДокументБИА);

	ИмяКнопкиСкачатьДокументБИА = ИмяПодменюИнтеграцияС1САрхивом()+"Обычное__"+"СкачатьКонтейнерДокументаИз1САрхива";
	КнопкаСкачатьДокументБИА = Форма.Элементы.Найти(ИмяКнопкиСкачатьДокументБИА);
	
	Если КнопкаДокументБИА = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоДокументов = ?(ТаблицаДокументовБИА = Неопределено, 0, ТаблицаДокументовБИА.Количество());
	Если Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" И Не КоличествоДокументов = 0 Тогда
		
		СтрокаДокумента = ТаблицаДокументовБИА[0];
		
		СтатусыМенеджер = Перечисления.СтатусыОбменаС1САрхивом;
		ПредставленияСтатусов = ПредставленияСтатусов();
		ПредставлениеСтатуса = ?(СтрокаДокумента.Уничтожен,
			НСтр("ru = 'уничтожен в 1С:Архиве'"),
			ПредставленияСтатусов[СтрокаДокумента.Статус]);
		
		КнопкаДокументБИА.Заголовок = СтрШаблон(НСтр("ru = 'Просмотреть документ передачи (%1)'"), ПредставлениеСтатуса);
		КнопкаДокументБИА.Видимость = Истина;
		КнопкаСкачатьДокументБИА.Видимость = СтрокаДокумента.Статус = СтатусыМенеджер.ЗагрузкаВАрхивВыполнена
			Или СтрокаДокумента.Статус = СтатусыМенеджер.ПринятВАрхив;
		
	Иначе
		КнопкаДокументБИА.Видимость = Ложь;
		КнопкаСкачатьДокументБИА.Видимость = Ложь;
	КонецЕсли;
	
	Если КоличествоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Индекс = 0 По КоличествоДокументов - 2 Цикл
		
		ИндексСтрокой = Формат(Индекс, "ЧГ=;ЧН=");
		ГруппаДокумент = Форма.Элементы.Найти("ГруппаДокументБИА" + ИндексСтрокой);
		Если ГруппаДокумент <> Неопределено Тогда
			ГруппаДокумент.Видимость = Ложь; 
		КонецЕсли;
	КонецЦикла;
	
	Индекс = КоличествоДокументов-1;
	ИндексСтрокой = Формат(Индекс, "ЧГ=;ЧН=");
	ГруппаДокумент = Форма.Элементы.Найти("ГруппаДокументБИА" + ИндексСтрокой);
	Если ГруппаДокумент <> Неопределено Тогда
		ЭлементДокументаБИА = Форма.Элементы.Найти("ИнформацияДокументаБИА"+ИндексСтрокой);
		Если ЭлементДокументаБИА <>  Неопределено Тогда
			ЭлементДокументаБИА.Видимость = Ложь;
			
			Форма.Элементы.Переместить(КнопкаДокументБИА, ГруппаДокумент, ЭлементДокументаБИА);
			КнопкаДокументБИА.Вид = ВидКнопкиФормы.Гиперссылка;
			КнопкаДокументБИА.Заголовок = ЭлементДокументаБИА.Заголовок;
			КнопкаДокументБИА.Видимость = Истина;
		КонецЕсли;
		
		ИмяКомандыСкачать = "СкачатьКонтейнерДокументаИз1САрхива" + ИндексСтрокой;
		КнопкаСкачать = Форма.Элементы.Найти(ИмяКомандыСкачать);
		
		Если КнопкаСкачатьДокументБИА <> Неопределено Тогда
			КнопкаСкачатьДокументБИА.Видимость = Ложь;
			Если КнопкаСкачать <> Неопределено Тогда
				КнопкаСкачать.ИмяКоманды = КнопкаСкачатьДокументБИА.ИмяКоманды;
				КнопкаСкачать.Заголовок = НСтр("ru = 'Скачать'");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставленияСтатусов()
	ПредставленияСтатусов = Новый Соответствие;
	СтатусыМенеджер = Перечисления.СтатусыОбменаС1САрхивом;
	ПредставленияСтатусов[СтатусыМенеджер.НеГотовКВыгрузке]
		= НСтр("ru = 'ожидает выгрузки в 1С:Архив'");
	ПредставленияСтатусов[СтатусыМенеджер.ГотовКВыгрузке]
		= НСтр("ru = 'ожидает выгрузки в 1С:Архив'");
	ПредставленияСтатусов[СтатусыМенеджер.ОбнаруженыОшибкиПриВыгрузке]
		= НСтр("ru = 'ошибка выгрузки в 1С:Архив'");
	ПредставленияСтатусов[СтатусыМенеджер.ВыгрузкаВыполнена]
		= НСтр("ru = 'выгружен в 1С:Архив'");
	// Пока нет детализации ошибок пакета по документам, статус "ошибка" не выводится.
	ПредставленияСтатусов[СтатусыМенеджер.ОбнаруженыОшибкиПриЗагрузкеВАрхив]
		= НСтр("ru = 'выгружен в 1С:Архив'");
	ПредставленияСтатусов[СтатусыМенеджер.ОбнаруженыОшибкиПриПроверкеВАрхиве]
		= НСтр("ru = 'выгружен в 1С:Архив'");
	ПредставленияСтатусов[СтатусыМенеджер.ЗагрузкаВАрхивВыполнена]
		= НСтр("ru = 'загружен в 1С:Архив'");
	ПредставленияСтатусов[СтатусыМенеджер.ПринятВАрхив]
		= НСтр("ru = 'принят в 1С:Архив'");
	Возврат ПредставленияСтатусов;
КонецФункции

Функция ТаблицаДокументовБИА(ОснованиеСсылка, Форма)
	
	ТаблицаДокументовБИА = Неопределено;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Параметры, "Ключ")
		И Не ЗначениеЗаполнено(Форма.Параметры.Ключ) Тогда
		Возврат ТаблицаДокументовБИА;
	КонецЕсли;
	
	МодульОбменСАрхивом = ОбщегоНазначения.ОбщийМодуль("ОбменСАрхивом");
	ТаблицаДокументовБИА = МодульОбменСАрхивом.ТаблицаДокументовБИА(ОснованиеСсылка);
	
	Возврат ТаблицаДокументовБИА;
	
КонецФункции

Функция ВидимостьКоманд(Объект, Форма, ТаблицаДокументовБИА)
	
	МетаданныеОбъекта = Объект.Ссылка.Метаданные();
	АвторизованныйПользователь = Пользователи.АвторизованныйПользователь();
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь(,, Ложь);
	ОтправкаДоступнаПоРеквизитам = Не Объект.Ссылка.Пустая() И Не Объект.ПометкаУдаления И (Не ОбщегоНазначения.ЭтоДокумент(МетаданныеОбъекта)
	Или МетаданныеОбъекта.Проведение = Метаданные.СвойстваОбъектов.Проведение.Запретить
	Или Объект.Проведен);
	ЭтоАдминистраторОбмена = РольДоступна(Метаданные.Роли.АдминистрированиеОбменаС1САрхивом);
	ОтправкаДоступнаПоПравам = ЭтоПолноправныйПользователь Или ЭтоАдминистраторОбмена
	Или РольДоступна(Метаданные.Роли.ОтправкаДокументовВ1САрхив);
	ОтменаДоступнаБезОграничений = ЭтоПолноправныйПользователь Или ЭтоАдминистраторОбмена;
	ОтзывДоступенБезОграничений = ЭтоПолноправныйПользователь Или ЭтоАдминистраторОбмена;
	Если ОтправкаДоступнаПоПравам
		И ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		ОтправкаДоступнаПоПравам = ОтправкаДоступнаПоПравам
		И МодульУправлениеДоступом.ИзменениеРазрешено(Объект.Ссылка, АвторизованныйПользователь);
	КонецЕсли;
	
	Если Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность" И Не ЭтоПолноправныйПользователь
		И ОбщегоНазначения.ПодсистемаСуществует("РегламентированнаяОтчетность.ЭлектронныйДокументооборотСКонтролирующимиОрганами")Тогда
		ОтправкаДоступнаПоПравам = ОтправкаДоступнаПоПравам И РольДоступна(Метаданные.Роли.ПросмотрПротоколовОтправкиВКонтролирующиеОрганы);
	КонецЕсли;
	
	Если ТаблицаДокументовБИА = Неопределено Тогда
		ОтмеченКОтправке = Ложь;
		ЕстьВыгруженные = Ложь;
	Иначе
		ОтмеченКОтправке = ТаблицаДокументовБИА.Количество() > 0;
		СтрокиВыгруженныхДокументов = ТаблицаДокументовБИА.НайтиСтроки(Новый Структура("Выгружен", Истина));
		ЕстьВыгруженные = СтрокиВыгруженныхДокументов.Количество() > 0;
	КонецЕсли;
	
	ВидимостьОтправить = ОтправкаДоступнаПоПравам И ОтправкаДоступнаПоРеквизитам И Не ОтмеченКОтправке;
	ВидимостьИстория = Ложь;
	Если ПравоДоступа("Чтение", Метаданные.РегистрыСведений.ИсторияОбменаС1САрхивом) И РегистрыСведений.ИсторияОбменаС1САрхивом.ЕстьЗаписиПоОбъекту(Объект.Ссылка) Тогда
		ВидимостьИстория = Истина;
	КонецЕсли;
	ВидимостьОтменить = Ложь;
	ВидимостьОтозвать = Ложь;
	Если ОтправкаДоступнаПоПравам И ОтмеченКОтправке Тогда
		Если ЕстьВыгруженные Тогда
			ВидимостьОтозвать = ОтзывДоступенБезОграничений;
		ИначеЕсли ОтменаДоступнаБезОграничений Тогда
			ВидимостьОтменить = Истина;
		Иначе
			ЕстьЧужиеДокументы = Ложь;
			Если Не ТаблицаДокументовБИА = Неопределено Тогда
				Для Каждого СтрокаДокумента Из ТаблицаДокументовБИА Цикл
					Если СтрокаДокумента.Автор <> АвторизованныйПользователь Тогда
						ЕстьЧужиеДокументы = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			ВидимостьОтменить = Не ЕстьЧужиеДокументы;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый Структура("ВидимостьИстория,ВидимостьОтменить,ВидимостьОтправить,ВидимостьОтозвать",ВидимостьИстория,ВидимостьОтменить,ВидимостьОтправить,ВидимостьОтозвать);

КонецФункции

Процедура ВыполнитьКомандуИнтеграцииС1САрхивом(Знач Файлы, ДополнительныеПараметры) Экспорт

	Перем ИмяКоманды;
	
	Если Не ОбменСАрхивомБГУВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	МодульОбменСАрхивом = ОбщегоНазначения.ОбщийМодуль("ОбменСАрхивом");
	
	Если Не ДополнительныеПараметры.ОписаниеКоманды.ДополнительныеПараметры.Свойство("ИмяКоманды", ИмяКоманды) = Неопределено Тогда
		
		ДополнительныеПараметры.Вставить("Ссылка", Файлы);
		ДополнительныеПараметры.Вставить("ИмяКоманды", ИмяКоманды);
		
		Если ДополнительныеПараметры.Форма.ИмяФормы = "ОбщаяФорма.РегламентированнаяОтчетность"
			И ИмяКоманды = ИмяКомандыОтправитьВ1САрхив() Тогда
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДополнительныеПараметры.Форма, "АдресБланкаPDFВоВременномХранилище")
				И ТипЗнч(ДополнительныеПараметры.Форма.АдресБланкаPDFВоВременномХранилище) = Тип("СписокЗначений") Тогда
				ДополнительныеПараметры.Вставить("АдресБланкаPDFВоВременномХранилище", Новый ФиксированныйМассив(ДополнительныеПараметры.Форма.АдресБланкаPDFВоВременномХранилище.ВыгрузитьЗначения()));
			КонецЕсли;
		КонецЕсли;
		
		Если ДополнительныеПараметры.ИмяКоманды = ИмяКомандыОтправитьВ1САрхив() 
			И ДополнительныеПараметры.Ссылка.Метаданные() = Метаданные.Документы.РегламентированныйОтчет Тогда
			
			ПодготовитьКВыгрузкеРегламентированныйОтчет(ДополнительныеПараметры.Ссылка, ДополнительныеПараметры);
			МодульОбменСАрхивом.ЗаполнитьДокументыБИАНаФорме(ДополнительныеПараметры.Форма);
			УстановитьВидимостьИДоступностьКоманд(ДополнительныеПараметры.Форма);
			
		Иначе
			
			МодульОбменСАрхивом.ВыполнитьПодключаемуюКоманду(ДополнительныеПараметры.Форма, ДополнительныеПараметры);
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// См. РегламентированнаяОтчетностьПереопределяемый.ОтчетыПриАктивизацииСтрокиНаСервере.
Процедура ОтчетыПриАктивизацииСтрокиНаСервере(СсылкаНаОбъект) Экспорт

	Если Не ОбменСАрхивомБГУВызовСервера.ИнтеграцияС1САрхивомИспользуется() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьВидимостьИДоступностьКоманд(СсылкаНаОбъект);
	
КонецПроцедуры

Функция СписокДокументовБезОтветственного() Экспорт
	Результат = Новый Массив;
	
	Результат.Добавить("Документ.АктПриемкиВходящийЕИС");
	Результат.Добавить("Документ.ПакетВыгрузкиОтчетности");
	Результат.Добавить("Документ.РегламентированныйОтчет");
	Результат.Добавить("Документ.УниверсальныйРегламентированныйОтчет");
	Результат.Добавить("Документ.ЭлектронныйДокументБухгалтерскийОтчет");
	
	Возврат Результат;
КонецФункции	

Процедура ОтправитьВ1САрхивГруппуДокументовОрганизацииПоОтветственномуЗаПериод(Параметры, АдресВХранилище) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ДокументыБИА = Новый Массив;
	
	Организация = Параметры.Организация;
	ОтправлятьТолькоВыбранныеТипы = Параметры.ОтправлятьТолькоВыбранныеТипы;
	ВыбранныеТипыОснований = Параметры.ВыбранныеТипыОснований;
	ОтветственныйПользователь = Параметры.ОтветственныйПользователь;
	НачалоПериода = Параметры.НачалоПериода;
	ОкончаниеПериода = Параметры.ОкончаниеПериода;

	Запрос = Новый Запрос;
	ТекстЗапроса = "";
	СписокДокументовБезОтветственного = СписокДокументовБезОтветственного();
	
	НомерДокумента = 0;
	Для Каждого ТекДокумент Из Метаданные.Документы Цикл
		ИмяДокумента = ТекДокумент.Имя;
		ПолноеИмя = ТекДокумент.ПолноеИмя();
		
		НайденныеСтрокиИсключений = СписокДокументовБезОтветственного.Найти(ПолноеИмя);
		Если НЕ НайденныеСтрокиИсключений = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОтправлятьТолькоВыбранныеТипы Тогда
			НайденныеСтроки = ВыбранныеТипыОснований.Найти(ПолноеИмя);
			Если НайденныеСтроки = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	
			
		Для Каждого ТипПредмета Из Метаданные.ОпределяемыеТипы.СсылкаНаИнтегрируемыйОбъектБИА.Тип.Типы() Цикл
			Если Тип("ДокументСсылка."+ИмяДокумента) = ТипПредмета Тогда
				НомерДокумента = НомерДокумента + 1;
				
				Если НомерДокумента = 1 Тогда
					ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ " + ИмяДокумента + ".Ссылка КАК Ссылка ";
					ТекстЗапроса = ТекстЗапроса + " ПОМЕСТИТЬ СсылкиНаДокументыПрограммы ";
					ТекстЗапроса = ТекстЗапроса + " ИЗ Документ." + ИмяДокумента + " КАК " + ИмяДокумента + " ГДЕ " + ИмяДокумента + ".Организация В (&Организация) И " + ИмяДокумента + ".Проведен = ИСТИНА И " + ИмяДокумента + ".Ответственный = &Ответственный И " + ИмяДокумента + ".Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
				Иначе	
					ТекстЗапроса = ТекстЗапроса + " ОБЪЕДИНИТЬ ВСЕ ";
					ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ " + ИмяДокумента + ".Ссылка КАК Ссылка ";
					ТекстЗапроса = ТекстЗапроса + " ИЗ Документ." + ИмяДокумента + " КАК " + ИмяДокумента + " ГДЕ " + ИмяДокумента + ".Организация В (&Организация) И " + ИмяДокумента + ".Проведен = ИСТИНА И " + ИмяДокумента + ".Ответственный = &Ответственный И " + ИмяДокумента + ".Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
				КонецЕсли;	
				Прервать;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;
	
	ДобавитьДокументыДляОС = Истина;
	Если ОтправлятьТолькоВыбранныеТипы Тогда
		ПолноеИмя = "Справочник.ОсновныеСредства";
		
		НайденныеСтроки = ВыбранныеТипыОснований.Найти(ПолноеИмя);
		Если НайденныеСтроки = Неопределено Тогда
			ДобавитьДокументыДляОС = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	Если ДобавитьДокументыДляОС Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВнутреннийЭлектронныйДокумент.УчетныйДокумент
		|ИЗ
		|	Документ.ВнутреннийЭлектронныйДокумент КАК ВнутреннийЭлектронныйДокумент
		|ГДЕ
		|	ВнутреннийЭлектронныйДокумент.Организация = &Организация
		|	И ВнутреннийЭлектронныйДокумент.Проведен = ИСТИНА
		|	И ВнутреннийЭлектронныйДокумент.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВнутреннийЭлектронныйДокумент.Ответственный = &Ответственный
		|	И ТИПЗНАЧЕНИЯ(ВнутреннийЭлектронныйДокумент.УчетныйДокумент) = ТИП(Справочник.ОсновныеСредства)";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "; ";
	ТекстЗапроса = ТекстЗапроса + "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументыБИА.Ссылка КАК Ссылка,
		|	ДокументыБИА.ОбъектОснование КАК ОбъектОснование
		|ПОМЕСТИТЬ СсылкиНаАктивныеДокументыБИА
		|ИЗ
		|	СсылкиНаДокументыПрограммы КАК СсылкиНаДокументыПрограммы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДокументыБИА КАК ДокументыБИА
		|		ПО (ДокументыБИА.ОбъектОснование = СсылкиНаДокументыПрограммы.Ссылка)
		|ГДЕ
		|	ДокументыБИА.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СсылкиНаДокументыПрограммы.Ссылка КАК ДокументПрограммы,
		|	СсылкиНаАктивныеДокументыБИА.Ссылка КАК ДокументБИА
		|ИЗ
		|	СсылкиНаДокументыПрограммы КАК СсылкиНаДокументыПрограммы
		|		ЛЕВОЕ СОЕДИНЕНИЕ СсылкиНаАктивныеДокументыБИА КАК СсылкиНаАктивныеДокументыБИА
		|		ПО (СсылкиНаДокументыПрограммы.Ссылка = СсылкиНаАктивныеДокументыБИА.ОбъектОснование)
		|ГДЕ
		|	ЕСТЬNULL(СсылкиНаАктивныеДокументыБИА.Ссылка, 0) = 0";	

	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ОкончаниеПериода));
	Запрос.УстановитьПараметр("Ответственный", ОтветственныйПользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СсылкаНаОбъектИсточник = Выборка.ДокументПрограммы;
		
		Если КодТипаДокументаУчетаДокументовОписиИнвентаризации(СсылкаНаОбъектИсточник) = 2 Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ЭтоИсходящийДокументСЭлектроннымиИзвещениями0504805(СсылкаНаОбъектИсточник) Тогда
			Реквизиты = "ВходящееИзвещение";
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
			
			Если ЗначениеЗаполнено(ЗначенияРеквизитов.ВходящееИзвещение) Тогда
				//Попытка выгрузки извещения на стороне получателя
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоВходящийДокументСЭлектроннымиИзвещениями0504805(СсылкаНаОбъектИсточник) Тогда
			Реквизиты = "ДокументОснование";
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
			
			Если ЗначениеЗаполнено(ЗначенияРеквизитов.ДокументОснование) Тогда
				//Попытка выгрузки извещения на стороне отправителя
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") Тогда
			Реквизиты = "Организация, ВидОтчета, ПериодОтчета";
			ЗначенияРеквизитовДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
			Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.Организация) Тогда
				Продолжить;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.ВидОтчета) Тогда
				Продолжить;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.ПериодОтчета) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
			Реквизиты = "Организация, ИсточникОтчета";
			ЗначенияРеквизитовДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
			Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.Организация) Тогда
				Продолжить;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.ИсточникОтчета) Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;
		
		КоличествоДокументовБИАДоДобавления = ДокументыБИА.Количество();
		ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, ДокументыБИА, Ложь);
		Если КоличествоДокументовБИАДоДобавления = ДокументыБИА.Количество() Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru='Отправка документов пользователя %1 в 1С:Архив для %2 не выполнена, т.к. отсутствуют сведения для передачи.'"), СсылкаНаОбъектИсточник, ОтветственныйПользователь);
			ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
				2, УровеньЖурналаРегистрации.Информация, , );
		КонецЕсли;	
	КонецЦикла;

	Если ДокументыБИА.Количество() = 0 Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='Отправка документов пользователя %1 в 1С:Архив завершена. Нет данных для создания документов передачи в 1С:Архив. Документы передачи не созданы.'"), ОтветственныйПользователь);
	Иначе	
		ТекстСообщения = СтрШаблон(НСтр("ru='Отправка документов пользователя %1 в 1С:Архив завершена. Создано %1 документов передачи в 1С:Архив.'"), ОтветственныйПользователь, ДокументыБИА.Количество());
	КонецЕсли;
	ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
		2, УровеньЖурналаРегистрации.Информация, , );
	
КонецПроцедуры	

Процедура ОтправитьВ1САрхивГруппуДокументовОрганизацииЗаПериод(Параметры, АдресВХранилище) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ДокументыБИА = Новый Массив;
	
	Организация = Параметры.Организация;
	ОтправлятьТолькоВыбранныеТипы = Параметры.ОтправлятьТолькоВыбранныеТипы;
	ВыбранныеТипыОснований = Параметры.ВыбранныеТипыОснований;
	НачалоПериода = Параметры.НачалоПериода;
	ОкончаниеПериода = Параметры.ОкончаниеПериода;

	Запрос = Новый Запрос;
	ТекстЗапроса = "";
	
	НомерДокумента = 0;
	Для Каждого ТекДокумент Из Метаданные.Документы Цикл
		ИмяДокумента = ТекДокумент.Имя;
		
		Если ОтправлятьТолькоВыбранныеТипы Тогда
			ПолноеИмя = ТекДокумент.ПолноеИмя();
			
			НайденныеСтроки = ВыбранныеТипыОснований.Найти(ПолноеИмя);
			Если НайденныеСтроки = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	
			
		Для Каждого ТипПредмета Из Метаданные.ОпределяемыеТипы.СсылкаНаИнтегрируемыйОбъектБИА.Тип.Типы() Цикл
			Если Тип("ДокументСсылка."+ИмяДокумента) = ТипПредмета Тогда
				НомерДокумента = НомерДокумента + 1;
				
				Если НомерДокумента = 1 Тогда
					ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ " + ИмяДокумента + ".Ссылка КАК Ссылка ";
					ТекстЗапроса = ТекстЗапроса + "ПОМЕСТИТЬ СсылкиНаДокументыПрограммы";
					ТекстЗапроса = ТекстЗапроса + " ИЗ Документ." + ИмяДокумента + " КАК " + ИмяДокумента + " ГДЕ " + ИмяДокумента + ".Организация В (&Организация) И " + ИмяДокумента + ".Проведен = ИСТИНА И " + ИмяДокумента + ".Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
				Иначе	
					ТекстЗапроса = ТекстЗапроса + " ОБЪЕДИНИТЬ ВСЕ ";
					ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ " + ИмяДокумента + ".Ссылка КАК Ссылка ";
					ТекстЗапроса = ТекстЗапроса + " ИЗ Документ." + ИмяДокумента + " КАК " + ИмяДокумента + " ГДЕ " + ИмяДокумента + ".Организация В (&Организация) И " + ИмяДокумента + ".Проведен = ИСТИНА И " + ИмяДокумента + ".Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
				КонецЕсли;	
				Прервать;
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;
	
	ДобавитьДоговоры = Истина;
	Если ОтправлятьТолькоВыбранныеТипы Тогда
		ПолноеИмя = "Справочник.Договоры";

		НайденныеСтроки = ВыбранныеТипыОснований.Найти(ПолноеИмя);
		Если НайденныеСтроки = Неопределено Тогда
			ДобавитьДоговоры = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	Если ДобавитьДоговоры Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Договоры.Ссылка
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Организация = &Организация
		|	И Договоры.ДатаДоговора МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И Договоры.ПометкаУдаления = ЛОЖЬ";
	КонецЕсли;
	
	ДобавитьДокументыДляОС = Истина;
	Если ОтправлятьТолькоВыбранныеТипы Тогда
		ПолноеИмя = "Справочник.ОсновныеСредства";
		
		НайденныеСтроки = ВыбранныеТипыОснований.Найти(ПолноеИмя);
		Если НайденныеСтроки = Неопределено Тогда
			ДобавитьДокументыДляОС = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	Если ДобавитьДокументыДляОС Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВнутреннийЭлектронныйДокумент.УчетныйДокумент
		|ИЗ
		|	Документ.ВнутреннийЭлектронныйДокумент КАК ВнутреннийЭлектронныйДокумент
		|ГДЕ
		|	ВнутреннийЭлектронныйДокумент.Организация = &Организация
		|	И ВнутреннийЭлектронныйДокумент.Проведен = ИСТИНА
		|	И ВнутреннийЭлектронныйДокумент.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ТИПЗНАЧЕНИЯ(ВнутреннийЭлектронныйДокумент.УчетныйДокумент) = ТИП(Справочник.ОсновныеСредства)";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "; ";
	ТекстЗапроса = ТекстЗапроса + "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументыБИА.Ссылка КАК Ссылка,
		|	ДокументыБИА.ОбъектОснование КАК ОбъектОснование
		|ПОМЕСТИТЬ СсылкиНаАктивныеДокументыБИА
		|ИЗ
		|	СсылкиНаДокументыПрограммы КАК СсылкиНаДокументыПрограммы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДокументыБИА КАК ДокументыБИА
		|		ПО (ДокументыБИА.ОбъектОснование = СсылкиНаДокументыПрограммы.Ссылка)
		|ГДЕ
		|	ДокументыБИА.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СсылкиНаДокументыПрограммы.Ссылка КАК ДокументПрограммы,
		|	СсылкиНаАктивныеДокументыБИА.Ссылка КАК ДокументБИА
		|ИЗ
		|	СсылкиНаДокументыПрограммы КАК СсылкиНаДокументыПрограммы
		|		ЛЕВОЕ СОЕДИНЕНИЕ СсылкиНаАктивныеДокументыБИА КАК СсылкиНаАктивныеДокументыБИА
		|		ПО (СсылкиНаДокументыПрограммы.Ссылка = СсылкиНаАктивныеДокументыБИА.ОбъектОснование)
		|ГДЕ
		|	ЕСТЬNULL(СсылкиНаАктивныеДокументыБИА.Ссылка, 0) = 0";	

	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ОкончаниеПериода));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СсылкаНаОбъектИсточник = Выборка.ДокументПрограммы;
		
		Если ОбменСАрхивомБГУ.КодТипаДокументаУчетаДокументовОписиИнвентаризации(СсылкаНаОбъектИсточник) = 2 Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ОбменСАрхивомБГУ.ЭтоИсходящийДокументСЭлектроннымиИзвещениями0504805(СсылкаНаОбъектИсточник) Тогда
			Реквизиты = "ВходящееИзвещение";
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
			
			Если ЗначениеЗаполнено(ЗначенияРеквизитов.ВходящееИзвещение) Тогда
				//Попытка выгрузки извещения на стороне получателя
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ОбменСАрхивомБГУ.ЭтоВходящийДокументСЭлектроннымиИзвещениями0504805(СсылкаНаОбъектИсточник) Тогда
			Реквизиты = "ДокументОснование";
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
			
			Если ЗначениеЗаполнено(ЗначенияРеквизитов.ДокументОснование) Тогда
				//Попытка выгрузки извещения на стороне отправителя
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") Тогда
			Реквизиты = "Организация, ВидОтчета, ПериодОтчета";
			ЗначенияРеквизитовДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
			Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.Организация) Тогда
				Продолжить;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.ВидОтчета) Тогда
				Продолжить;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.ПериодОтчета) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
			Реквизиты = "Организация, ИсточникОтчета";
			ЗначенияРеквизитовДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
			Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.Организация) Тогда
				Продолжить;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.ИсточникОтчета) Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;
		
		КоличествоДокументовБИАДоДобавления = ДокументыБИА.Количество();
		ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, ДокументыБИА, Ложь);
		Если КоличествоДокументовБИАДоДобавления = ДокументыБИА.Количество() Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru='Отправка документов в 1С:Архив для %1 не выполнена, т.к. отсутствуют сведения для передачи.'"), СсылкаНаОбъектИсточник);
			ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
				2, УровеньЖурналаРегистрации.Информация, , );
		КонецЕсли;	
	КонецЦикла;

	Если ДокументыБИА.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Отправка документов в 1С:Архив завершена. Нет данных для создания документов передачи в 1С:Архив. Документы передачи не созданы.'");
	Иначе	
		ТекстСообщения = СтрШаблон(НСтр("ru='Отправка документов в 1С:Архив завершена. Создано %1 документов передачи в 1С:Архив.'"), ДокументыБИА.Количество());
	КонецЕсли;
	ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
		2, УровеньЖурналаРегистрации.Информация, , );
	
КонецПроцедуры
	
Процедура ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ОписаниеСобытия, КодСобытия, УровеньВажности = Неопределено,
	ОбъектМетаданных = Неопределено, ДанныеСсылка = Неопределено, РежимТранзакции = Неопределено) Экспорт
	
	Если КодСобытия = 1 Тогда
		Подзадача = НСтр("ru = 'Проверка документов перед отправкой в 1С:Архив'", ОбщегоНазначения.КодОсновногоЯзыка());
	ИначеЕсли КодСобытия = 2 Тогда
		Подзадача = НСтр("ru = 'Групповая отправка документов в 1С:Архив'", ОбщегоНазначения.КодОсновногоЯзыка());
	Иначе
		Подзадача = НСтр("ru = 'Общая функциональность'", ОбщегоНазначения.КодОсновногоЯзыка());
	КонецЕсли;	
	
	УровеньВажностиСобытия = ?(ТипЗнч(УровеньВажности) = Тип("УровеньЖурналаРегистрации"),
		УровеньВажности, УровеньЖурналаРегистрации.Ошибка);
		
	ИмяСобытия = СтрЗаменить(НСтр("ru = 'Интеграция с 1С:Архивом.%1'", ОбщегоНазначения.КодОсновногоЯзыка()),
		"%1", Подзадача);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньВажностиСобытия, ОбъектМетаданных, ДанныеСсылка, ОписаниеСобытия,
		РежимТранзакции);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область РаботаСФормами

#КонецОбласти

#Область ОбновлениеИнформационнойБазыБИА

Процедура СозданиеОбновлениеВидовДокументов(Параметры, АдресВХранилище) Экспорт
	СозданиеОбновлениеВидовДокументовДляБГУ();
КонецПроцедуры	

Процедура СозданиеОбновлениеВидовДокументовДляБГУ() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	Попытка
	
