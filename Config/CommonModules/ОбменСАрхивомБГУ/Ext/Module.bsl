Функция ХранилищеПЭП(Подпись) Экспорт
	
	ФайлПЭП = Новый ТекстовыйДокумент;
	ФайлПЭП.ДобавитьСтроку(СтрШаблон("Дата подписи UTC: %1", УниверсальноеВремя(Подпись.ДатаПодписи)));
	ФайлПЭП.ДобавитьСтроку(СтрШаблон("Подписал: %1", Подпись.ВладелецПодписи));
	
	ДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(Подпись.Объект);
	ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.SHA256);
	ХешированиеДанных.Добавить(ДанныеФайла);
	ХешСумма = Base64Строка(ХешированиеДанных.ХешСумма);
	
	ФайлПЭП.ДобавитьСтроку(СтрШаблон("Хеш-сумма SHA-256: %1", ХешСумма));
	
	ИмяФайла = ПолучитьИмяВременногоФайла("txt");
	ФайлПЭП.Записать(ИмяФайла);
	ДвоичныеДанныеПЭП = Новый ДвоичныеДанные(ИмяФайла);
	ХранилищеЗначенияПЭП = Новый ХранилищеЗначения(ДвоичныеДанныеПЭП);
	УдалитьФайлы(ИмяФайла);
	
	Возврат ХранилищеЗначенияПЭП;
	
КонецФункции

Функция ФайлВизуализацииФормуляраПРОФИзПодписанногоФайлаMXL(Организация, ОсновнойФайл, ДанныеФайла, НовыйДокументБИА)
	Результат = Неопределено;
	
	ИмяФайла = ДанныеФайла.ИмяФайла;
	ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
	ПолноеИмяФайлаПредставленияФормуляраPDF = ИмяВременногоКаталога + Сред(ИмяФайла, 1, СтрДлина(ИмяФайла) - 4) + " (копия).pdf";
	ПолноеИмяФайла = ИмяВременногоКаталога + ИмяФайла;
	ИмяФайлаPDFПредставленияФормуляраБезРасширения = Сред(ИмяФайла, 1, СтрДлина(ИмяФайла) - 4) + " (копия)";
	
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
	Если НЕ ДвоичныеДанныеФайла = Неопределено Тогда
		ДвоичныеДанныеФайла.Записать(ПолноеИмяФайла);
	
		//Представление (копия)
		ЭлектронныеПодписи = ЭлектронныеДокументыБГУ.НовыйСписокЭлектронныхПодписейВнутреннегоЭД();
		ЭлектронныеДокументыБГУ.ЗаполнитьСписокПодписей(ЭлектронныеПодписи, ОсновнойФайл, Организация);
		
		СохраненныйТабличныйДокументПредставленияФормуляра = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанныеФайла);

		//Отступ чтобы штампы не накладывались на представление документа
		МакетШтампов = УправлениеПечатью.МакетПечатнойФормы("Документ.ВнутреннийЭлектронныйДокумент.ПФ_MXL_ШтампПЭП");
		ОбластьМакета = МакетШтампов.ПолучитьОбласть("Отступ");
		СохраненныйТабличныйДокументПредставленияФормуляра.Вывести(ОбластьМакета);
		
		ЭлектронныеДокументыБГУ.ДобавитьШтампыЭлектронныхПодписейВнутреннегоЭДО(СохраненныйТабличныйДокументПредставленияФормуляра, ЭлектронныеПодписи, Организация);
		
		СохраненныйТабличныйДокументПредставленияФормуляра.АвтоМасштаб = Истина;
		СохраненныйТабличныйДокументПредставленияФормуляра.Записать(ПолноеИмяФайлаПредставленияФормуляраPDF, ТипФайлаТабличногоДокумента.PDF_A_3);
		
		ДвоичныеДанныеФайлаПредставленияФормуляраPDF = Новый ДвоичныеДанные(ПолноеИмяФайлаПредставленияФормуляраPDF);
		
		ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
		ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
		ПараметрыФайла.ВладелецФайлов = НовыйДокументБИА.Ссылка;
		ПараметрыФайла.ИмяБезРасширения = ИмяФайлаPDFПредставленияФормуляраБезРасширения + ".pdf"; 
		ПараметрыФайла.Служебный = Ложь;
		
		ИдентификаторФормы = Новый УникальныйИдентификатор;
		АдресФайлаПредставленияФормуляраPDF = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаПредставленияФормуляраPDF, ИдентификаторФормы);
		
		ПредставлениеФормуляраФайлPDF = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайлаПредставленияФормуляраPDF);

		Результат = ПредставлениеФормуляраФайлPDF;
	КонецЕсли;
	
	Возврат  Результат;
КонецФункции	

Процедура ДобавлениеПодписейФайла(НовыйДокументБИА, ПодписанныйФайл)

	Реквизиты = "Организация";
	ЗначенияДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НовыйДокументБИА.Ссылка, Реквизиты);
	ОсновнаяОрганизация = ЗначенияДокумента.Организация;
	
	ЭлектронныеПодписи = ВнутреннийЭДО.УстановленныеПодписи(ПодписанныйФайл);
	Для Каждого ЭлектроннаяПодписьФайла Из ЭлектронныеПодписи Цикл
		Если ЭлектроннаяПодписьФайла.ПростаяПодпись = Истина Тогда
			СтрокаПодписи = НовыйДокументБИА.ПодписиДокумента.Добавить();
			СтрокаПодписи.Файл = ПодписанныйФайл;
			
			Подписал = "";
			Должность = "";
			
			//ПЭП
			СведенияПЭП = ХранилищеПЭП(ЭлектроннаяПодписьФайла);
			Подписал = ЭлектроннаяПодписьФайла.ВладелецПодписи;
			Должность = ЭлектроннаяПодписьФайла.Должность;
			Если ЗначениеЗаполнено(ЭлектроннаяПодписьФайла.Организация) И ЗначениеЗаполнено(ОсновнаяОрганизация) Тогда
				//Подписант из ЦБ
				Если НЕ ЭлектроннаяПодписьФайла.Организация = ОсновнаяОрганизация Тогда
					РеквизитыОрганизации = "НаименованиеСокращенное";
					ОрганизацияПодписанта = СокрЛП(ЭлектроннаяПодписьФайла.Организация);
					ЗначенияОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлектроннаяПодписьФайла.Организация, РеквизитыОрганизации);
					Если ЗначениеЗаполнено(ЗначенияОрганизации.НаименованиеСокращенное) Тогда
						ОрганизацияПодписанта = СокрЛП(ЗначенияОрганизации.НаименованиеСокращенное);
					КонецЕсли;	
					Должность = СтрШаблон("%1, %2", ЭлектроннаяПодписьФайла.Должность, ОрганизацияПодписанта);
				КонецЕсли;
			КонецЕсли;		

			СтрокаПодписи.ВидПодписи = Перечисления.ВидыПодписейДокументовБИА.Простая;
			СтрокаПодписи.ДатаПодписи = ЭлектроннаяПодписьФайла.ДатаПодписи;
			СтрокаПодписи.Подписал = Подписал;
			СтрокаПодписи.Должность = Должность;
			СтрокаПодписи.Подпись = СведенияПЭП;
		Иначе
			//ЭЦП
			
			//Сведения об УКЭП добавляются БИА
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

Функция ЗавершенныеВнешниеЭД(СсылкаНаОбъектИсточник)
	ВсеСостояния = Новый Массив;
	ВсеСостояния.Добавить(Перечисления.СостоянияДокументовЭДО.ОбменЗавершен);

	Запрос = Новый Запрос;
	Запрос.Текст = ЭлектронныеДокументыБГУ.ТекстЗапросаЭлектронныхДокументовСФайламиОбъектаУчета();
	Запрос.УстановитьПараметр("ОбъектУчета", СсылкаНаОбъектИсточник);
	Запрос.УстановитьПараметр("СостоянияЗавершения", ВсеСостояния);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции


