Процедура ДоработкаНаименованияВидаОтчета(НаименованиеОтчета)
	ПодстрокаПоиска = "Отчет Отчет";
	Если СтрНайти(НаименованиеОтчета, ПодстрокаПоиска) > 0 Тогда
		Результат = СтрЗаменить(НаименованиеОтчета, ПодстрокаПоиска, "Отчет");
	КонецЕсли;	

	ПодстрокаПоиска = "государственных";
	Если СтрНайти(НаименованиеОтчета, ПодстрокаПоиска) > 0 Тогда
		Результат = СтрЗаменить(НаименованиеОтчета, ПодстрокаПоиска, "гос.");
	КонецЕсли;	

	ПодстрокаПоиска = "государственную";
	Если СтрНайти(НаименованиеОтчета, ПодстрокаПоиска) > 0 Тогда
		Результат = СтрЗаменить(НаименованиеОтчета, ПодстрокаПоиска, "гос.");
	КонецЕсли;	

	ПодстрокаПоиска = "муниципальных";
	Если СтрНайти(НаименованиеОтчета, ПодстрокаПоиска) > 0 Тогда
		Результат = СтрЗаменить(НаименованиеОтчета, ПодстрокаПоиска, "мун.");
	КонецЕсли;	

	ПодстрокаПоиска = "муниципального";
	Если СтрНайти(НаименованиеОтчета, ПодстрокаПоиска) > 0 Тогда
		Результат = СтрЗаменить(НаименованиеОтчета, ПодстрокаПоиска, "мун.");
	КонецЕсли;	
	
	ПодстрокаПоиска = "федеральных";
	Если СтрНайти(НаименованиеОтчета, ПодстрокаПоиска) > 0 Тогда
		Результат = СтрЗаменить(НаименованиеОтчета, ПодстрокаПоиска, "фед.");
	КонецЕсли;	
КонецПроцедуры	

//Виды регламентированных отчетов

Функция ЭлементыСправочникаРегламентированныеОтчеты()
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	РегламентированныеОтчеты.Код КАК КодОтчета,
	                      |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(РегламентированныеОтчеты.Ссылка) КАК ИдентификаторОбъектаИсточника,
	                      |	РегламентированныеОтчеты.Наименование КАК НаименованиеОтчета,
	                      |	РегламентированныеОтчеты.Ссылка КАК СсылкаВидОтчета,
	                      |	РегламентированныеОтчеты.ИсточникОтчета КАК ИсточникОтчета,
	                      |	ВидыОтправляемыхДокументов.ТипПолучателя КАК ТипПолучателя,
	                      |	РегламентированныеОтчеты.ЭтоГруппа КАК ЭтоГруппа,
	                      |	РегламентированныеОтчеты.Родитель КАК ГруппаОтчета
	                      |ИЗ
	                      |	Справочник.РегламентированныеОтчеты КАК РегламентированныеОтчеты
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СкрытыеРегламентированныеОтчеты КАК СкрытыеРегламентированныеОтчеты
	                      |		ПО (СкрытыеРегламентированныеОтчеты.РегламентированныйОтчет = РегламентированныеОтчеты.Ссылка)
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыОтправляемыхДокументов КАК ВидыОтправляемыхДокументов
	                      |		ПО РегламентированныеОтчеты.ИсточникОтчета = ВидыОтправляемыхДокументов.Источник
	                      |			И (ВидыОтправляемыхДокументов.Источник ПОДОБНО ""%[^ ]%"")
	                      |ГДЕ
	                      |	СкрытыеРегламентированныеОтчеты.РегламентированныйОтчет ЕСТЬ NULL
	                      |	И (ВидыОтправляемыхДокументов.ПометкаУдаления ЕСТЬ NULL
	                      |			ИЛИ НЕ ВидыОтправляемыхДокументов.ПометкаУдаления)
	                      |	И РегламентированныеОтчеты.ЭтоГруппа = ЛОЖЬ
	                      |	И РегламентированныеОтчеты.ПометкаУдаления = ЛОЖЬ
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	КодОтчета ИЕРАРХИЯ");
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

