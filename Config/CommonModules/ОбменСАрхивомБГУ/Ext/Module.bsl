		РеквизитыУчетногоДокумента.Вставить("СуммаДокумента", 0);
		РеквизитыУчетногоДокумента.Вставить("ВалютаДокумента", ВалютаДокументаПоУмолчанию);
		ЗаполнитьЗначенияСвойств(РеквизитыУчетногоДокумента, СсылкаНаОбъектИсточник);
		
		Реквизиты = "НомерПервичногоДокумента, ДатаПервичногоДокумента";
		ЗначенияРеквизитовИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПолученныйАкт, Реквизиты);
		РеквизитыУчетногоДокумента.Номер = ЗначенияРеквизитовИсточника.НомерПервичногоДокумента; 
		РеквизитыУчетногоДокумента.Дата = ЗначенияРеквизитовИсточника.ДатаПервичногоДокумента; 

		НовыйДокументБИА = Справочники.ДокументыБИА.СоздатьЭлемент();
		СсылкаНаНовыйДокументБИА = Справочники.ДокументыБИА.ПолучитьСсылку();
		НовыйДокументБИА.УстановитьСсылкуНового(СсылкаНаНовыйДокументБИА);
		ЗаполнитьЗначенияСвойств(НовыйДокументБИА, СсылкаНаОбъектИсточник);
	
		НовыйДокументБИА.ОбъектОснование = СсылкаНаОбъектИсточник;
		НовыйДокументБИА.ВидДокумента =  ВидДокументаБИА;
		НовыйДокументБИА.ЭтоЭлектронныйДокумент = Истина;
		НовыйДокументБИА.Заголовок = СтрШаблон(НСтр("ru = '%1 от %2 г. № %3'"), 
			РеквизитыУчетногоДокумента.Вид, Формат(РеквизитыУчетногоДокумента.Дата, "ДФ=dd.MM.yyyy"), РеквизитыУчетногоДокумента.Номер);
		НовыйДокументБИА.Содержание = СтрШаблон(НСтр("ru = 'Документ сформирован в 1С:БГУ 8 документом программы %1'"), СсылкаНаОбъектИсточник);
		НовыйДокументБИА.Дата = РеквизитыУчетногоДокумента.Дата;
		НовыйДокументБИА.Номер = РеквизитыУчетногоДокумента.Номер;
		НовыйДокументБИА.Сумма = РеквизитыУчетногоДокумента.СуммаДокумента;
		НовыйДокументБИА.Валюта = РеквизитыУчетногоДокумента.ВалютаДокумента;

		НовыйДокументБИА.Записать();
		
		ПредставлениеФормуляраФайлPDF = Справочники.ДокументыБИАПрисоединенныеФайлы.ПустаяСсылка();
	
		Для Каждого ВнешнийДокумент Из ВнешниеЭД Цикл
			ФайлЭД = ВнешнийДокумент.ФайлЭД;
			
			СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
			СтрокаФайла.Файл = ФайлЭД;
			СтрокаФайла.Роль = РольФайлаБИАВнешнийЭД();
				
			//Добавление сведений о ЭП
			ДобавлениеПодписейФайла(НовыйДокументБИА, ФайлЭД);
			
			//Файл визуализации общего внешнего ЭД с штампами ЭП
			ИмяФайлаКопииБезРасширения = НовыйДокументБИА.Заголовок;
			ПредставлениеФормуляраФайлPDF = ФайлВизуализацииВнешнегоАктаОПриемеПередачеПоПечатнойФормеДляЭДО(
				ОтветныйАкт, ИмяФайлаКопииБезРасширения, НовыйДокументБИА);
			Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
				СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
			КонецЕсли;	
			
			//Дополнительный файл с архивом, где собраны все файлы документооборота целиком
	  		ФайлВнешнегоДокуменооборотаЦеликом = ФайлВнешнегоДокуменооборотаЦеликом(ВнешнийДокумент.ЭлектронныйДокумент, НовыйДокументБИА.Заголовок, НовыйДокументБИА);
			Если ЗначениеЗаполнено(ФайлВнешнегоДокуменооборотаЦеликом) Тогда
				СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
				СтрокаФайла.Файл = ФайлВнешнегоДокуменооборотаЦеликом;
				СтрокаФайла.Роль = РольФайлаБИАДополнительныйФайл();
			КонецЕсли;
			
			//Файл визуализации внешнего ЭД с штампами ЭП
			ДобавитьФайлВизуализацииВнешнегоЭД(СсылкаНаОбъектИсточник, ВнешнийДокумент, НовыйДокументБИА, СтрокаФайла, НовыйДокументБИА.Заголовок);
		КонецЦикла;
		
		ДобавитьПриложенныеФайлыВСоставеПрикладногоЭД(ПолученныйАкт, НовыйДокументБИА);

		//Присоединенные файлы с ЭЦП и МЧД при наличии
		ДобавитьПрисоединенныеКОбъектуФайлы(СсылкаНаОбъектИсточник, НовыйДокументБИА);
		
		//Присоединенные файлы полученного акта с ЭЦП и МЧД при наличии
		ДобавитьПрисоединенныеКОбъектуФайлы(ПолученныйАкт, НовыйДокументБИА);
		
		//Исходящее ответное извещение
		ВнешниеЭД = ЗавершенныеВнешниеЭД(ОтветныйАкт);
		Если ВнешниеЭД.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;	
		
		ЗаголовокОтветногоАкта = СтрШаблон(НСтр("ru = '%1 от %2 г. № %3 (ответный документ)'"), 
			РеквизитыУчетногоДокумента.Вид, Формат(РеквизитыУчетногоДокумента.Дата, "ДФ=dd.MM.yyyy"), РеквизитыУчетногоДокумента.Номер);
	
		Для Каждого ВнешнийДокумент Из ВнешниеЭД Цикл
			ФайлЭД = ВнешнийДокумент.ФайлЭД;
			
			СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
			СтрокаФайла.Файл = ФайлЭД;
			СтрокаФайла.Роль = РольФайлаБИАВнешнийЭД();
				
			//Добавление сведений о ЭП
			ДобавлениеПодписейФайла(НовыйДокументБИА, ФайлЭД);
			
			//Файл визуализации общего внешнего ЭД с штампами ЭП
			Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
				СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
			КонецЕсли;	
			
			//Дополнительный файл с архивом, где собраны все файлы документооборота целиком
	  		ФайлВнешнегоДокуменооборотаЦеликом = ФайлВнешнегоДокуменооборотаЦеликом(ВнешнийДокумент.ЭлектронныйДокумент, ЗаголовокОтветногоАкта, НовыйДокументБИА);
			Если ЗначениеЗаполнено(ФайлВнешнегоДокуменооборотаЦеликом) Тогда
				СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
				СтрокаФайла.Файл = ФайлВнешнегоДокуменооборотаЦеликом;
				СтрокаФайла.Роль = РольФайлаБИАДополнительныйФайл();
			КонецЕсли;
			
			//Файл визуализации внешнего ЭД с штампами ЭП
			ДобавитьФайлВизуализацииВнешнегоЭД(ОтветныйАкт, ВнешнийДокумент, НовыйДокументБИА, СтрокаФайла, ЗаголовокОтветногоАкта);
			
		КонецЦикла;

		//Внутренние ЭД с подписями, если они есть
		ДобавитьВнутренниеЭДКПрикладномуЭД(ОтветныйАкт, ВидДокументаБИА, НовыйДокументБИА);

		//Присоединенные файлы с ЭЦП и МЧД при наличии
		ДобавитьПрисоединенныеКОбъектуФайлы(ОтветныйАкт, НовыйДокументБИА);
		
		ДобавитьПриложенныеФайлыВСоставеПрикладногоЭД(СсылкаНаОбъектИсточник, НовыйДокументБИА);
		
		НовыйДокументБИА.Записать();
		
		ДокументыБИА.Добавить(НовыйДокументБИА);
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура СоздатьДокументыБИАДляДокументаУчетаВнутреннегоЭД(СсылкаНаОбъектИсточник, ДокументыБИА) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	ДокументыДляВыгрузки = ВнутренниеЭлектронныеДокументыДляВыгрузки(СсылкаНаОбъектИсточник);

	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДокументыДляВыгрузки, 
		"Организация, ОсновнойФайл, ОсновнойФайлPDF, ПредставлениеФормуляраФайлPDF, УчетныйДокумент, ИдентификаторКомандыПечати, ВидДокумента, ДатаДокумента, НомерДокумента");

	ВалютаДокументаПоУмолчанию = Константы.ВалютаРегламентированногоУчета.Получить();
	
	РеквизитыУчетногоДокумента = Новый Структура;
	РеквизитыУчетногоДокумента.Вставить("СуммаДокумента", 0);
	РеквизитыУчетногоДокумента.Вставить("ВалютаДокумента", ВалютаДокументаПоУмолчанию);
	ЗаполнитьЗначенияСвойств(РеквизитыУчетногоДокумента, СсылкаНаОбъектИсточник);

	Для Каждого ВнутреннийДокумент Из ДокументыДляВыгрузки Цикл

		ОсновнойФайл = РеквизитыДокументов[ВнутреннийДокумент].ОсновнойФайл;
		ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
		ПараметрыДанных.ВызыватьИсключение = Ложь;
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ОсновнойФайл, ПараметрыДанных);
		Организация = РеквизитыДокументов[ВнутреннийДокумент].Организация;
		
		ОсновнойФайлPDF = РеквизитыДокументов[ВнутреннийДокумент].ОсновнойФайлPDF;
		ПредставлениеФормуляраФайлPDF = РеквизитыДокументов[ВнутреннийДокумент].ПредставлениеФормуляраФайлPDF;
		
		ЕстьФормулярPDF = Ложь;
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ЕстьФормулярPDF = Истина;
		КонецЕсли;
		
		ИдентификаторКомандыПечати = РеквизитыДокументов[ВнутреннийДокумент].ИдентификаторКомандыПечати;
		ВидДокумента = РеквизитыДокументов[ВнутреннийДокумент].ВидДокумента;
		ДатаДокумента = РеквизитыДокументов[ВнутреннийДокумент].ДатаДокумента;
		НомерДокумента = РеквизитыДокументов[ВнутреннийДокумент].НомерДокумента;
		Если ЭтоДополнительныйДокументВСоставеОсновногоЭД(СсылкаНаОбъектИсточник, ИдентификаторКомандыПечати) Тогда
			Продолжить;
		КонецЕсли;	
		
		ВидДокументаБИА = ВидДокументаДляАрхиваДляВнутреннегоЭД(СсылкаНаОбъектИсточник, ИдентификаторКомандыПечати);
		
		//Исключения, которые обрабатываются отдельно
		Реквизиты = "СлужебныйИдентификаторВидаДокументаБГУ";
		ЗначенияРеквизитовВидДокументаБИА = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидДокументаБИА, Реквизиты);
		Если НЕ ЗначениеЗаполнено(ВидДокументаБИА) Тогда
			Продолжить;
		КонецЕсли;	
		Если ЗначенияРеквизитовВидДокументаБИА.СлужебныйИдентификаторВидаДокументаБГУ = "0510448"
			ИЛИ ЗначенияРеквизитовВидДокументаБИА.СлужебныйИдентификаторВидаДокументаБГУ = "0504805" Тогда
			Продолжить;
		КонецЕсли;

		НовыйДокументБИА = Справочники.ДокументыБИА.СоздатьЭлемент();
		СсылкаНаНовыйДокументБИА = Справочники.ДокументыБИА.ПолучитьСсылку();
		НовыйДокументБИА.УстановитьСсылкуНового(СсылкаНаНовыйДокументБИА);
		Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			Реквизиты = "Организация";
			ЗначенияРеквизитовСправочника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
			Организация = ЗначенияРеквизитовСправочника.Организация;
			НовыйДокументБИА.Организация = Организация;
		Иначе	
			ЗаполнитьЗначенияСвойств(НовыйДокументБИА, СсылкаНаОбъектИсточник);
		КонецЕсли;
		
		НовыйДокументБИА.ОбъектОснование = СсылкаНаОбъектИсточник;
		НовыйДокументБИА.ВидДокумента =  ВидДокументаБИА;
		НовыйДокументБИА.ЭтоЭлектронныйДокумент = Истина;
		Если ЗначениеЗаполнено(НомерДокумента) Тогда
			НовыйДокументБИА.Заголовок = СтрШаблон(НСтр("ru = '%1 от %2 г. № %3'"), ВидДокумента, Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"), НомерДокумента);
		Иначе
			НовыйДокументБИА.Заголовок = СтрШаблон(НСтр("ru = '%1 от %2 г.'"), ВидДокумента, Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
		НовыйДокументБИА.Содержание = СтрШаблон(НСтр("ru = 'Документ сформирован в 1С:БГУ 8 документом программы %1'"), СсылкаНаОбъектИсточник);
		НовыйДокументБИА.Дата = ДатаДокумента;
		НовыйДокументБИА.Номер = НомерДокумента;
		НовыйДокументБИА.Сумма = РеквизитыУчетногоДокумента.СуммаДокумента;
		НовыйДокументБИА.Валюта = РеквизитыУчетногоДокумента.ВалютаДокумента;
		
		НовыйДокументБИА.Записать();
		
		Если ЕстьФормулярPDF Тогда
			СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
			СтрокаФайла.Файл = ОсновнойФайлPDF;
			СтрокаФайла.Роль = РольФайлаБИАВнутреннийЭД();
			
			//Добавление сведений о ЭП
			ДобавлениеПодписейФайла(НовыйДокументБИА, ОсновнойФайлPDF);
			
			//Файл визуализации формируем из подписанного MXL файла
			ПредставлениеФормуляраФайлPDF = ФайлВизуализацииФормуляраПРОФИзПодписанногоФайлаMXL(
				Организация, ОсновнойФайл, ДанныеФайла, НовыйДокументБИА);
			Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
				СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
			КонецЕсли;	
			
		Иначе
			//Нет файла формуляра в формате PDF
 			СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
			СтрокаФайла.Файл = ОсновнойФайл;
			СтрокаФайла.Роль = РольФайлаБИАВнутреннийЭД();
			
			//Добавление сведений о ЭП
			ДобавлениеПодписейФайла(НовыйДокументБИА, ОсновнойФайл);
			
			Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
				//Есть файл представления формуляра
				СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
				
				//Добавление сведений заверяющих подписей при наличии
				ДобавлениеПодписейФайла(НовыйДокументБИА, ПредставлениеФормуляраФайлPDF);
			Иначе
				//Нет файла представления формуляра
				//Файл визуализации формируем из подписанного MXL файла
				ПредставлениеФормуляраФайлPDF = ФайлВизуализацииФормуляраПРОФИзПодписанногоФайлаMXL(
					Организация, ОсновнойФайл, ДанныеФайла, НовыйДокументБИА);
				Если ЗначениеЗаполнено(ПредставлениеФормуляраФайлPDF) Тогда
					СтрокаФайла.ФайлВизуализации = ПредставлениеФормуляраФайлPDF;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		
		//Многосоставные инвентаризации
		Если ОбменСАрхивомБГУ.КодТипаДокументаУчетаДокументовОписиИнвентаризации(СсылкаНаОбъектИсточник) = 1 Тогда
			ДобавитьВДокументБИАФайлыОтдельныхВнутреннихЭДСодержательныхДокументовИнвентаризаций(НовыйДокументБИА, СсылкаНаОбъектИсточник);
		КонецЕсли;	
		
		//Расписка инвентаризации (другой учетный документ)
		Если ЕстьРаспискаИнвентаризации(СсылкаНаОбъектИсточник, ИдентификаторКомандыПечати) Тогда
			ДокументУчетаРасписка = ДокументРаспискиПоДокументуИнвентаризации(СсылкаНаОбъектИсточник);
			ДобавитьВДокументБИАФайлыОтдельногоВнутреннегоЭДРасписки(НовыйДокументБИА, ДокументУчетаРасписка);
		КонецЕсли;	
		
		//Лист ознакомления, согласования и т.п. (этот учетный документ)
		ДобавитьВДокументБИАФайлыДополнительногоВнутреннегоЭД(НовыйДокументБИА, СсылкаНаОбъектИсточник, ИдентификаторКомандыПечати, ДокументыДляВыгрузки, РеквизитыДокументов);
		
		//Присоединенные файлы с ЭЦП и МЧД при наличии
		ДобавитьПрисоединенныеКОбъектуФайлы(СсылкаНаОбъектИсточник, НовыйДокументБИА);
		
		НовыйДокументБИА.Записать(); 
		
		ДокументыБИА.Добавить(НовыйДокументБИА);
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьДокументыБИАДляДокументаУчетаВнутреннегоЭДДляОтчетаГосУчреждения(СсылкаНаОбъектИсточник, ДокументыБИА) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") Тогда
		Реквизиты = "Организация, ВидОтчета, ПериодОтчета, ДатаЗаполнения, Дата";
		ЗначенияРеквизитовДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
		Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.Организация) Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Для отчета %1 не указана организация. Обмен с 1С:Архив для такого документа не поддерживается.'"), СсылкаНаОбъектИсточник);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.ВидОтчета) Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Для отчета %1 не указан вид. Обмен с 1С:Архив для такого документа не поддерживается.'"), СсылкаНаОбъектИсточник);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.ПериодОтчета) Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Для отчета %1 не указан период отчета. Обмен с 1С:Архив для такого документа не поддерживается.'"), СсылкаНаОбъектИсточник);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		
		Организация = ЗначенияРеквизитовДокумента.Организация;
		ВидОтчета = ЗначенияРеквизитовДокумента.ВидОтчета;
		ПериодОтчета = ЗначенияРеквизитовДокумента.ПериодОтчета;
		ДатаЗаполнения = ЗначенияРеквизитовДокумента.ДатаЗаполнения;
		ВалютаДокументаПоУмолчанию = Константы.ВалютаРегламентированногоУчета.Получить();

		РеквизитыВидаОтчета = "ПолноеНаименование, Наименование, Код, КодФормыПоКлассификатору";
		ЗначенияРеквизитовВидаОтчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидОтчета, РеквизитыВидаОтчета);
		ИдентификаторВидаОтчета = СокрЛП(ВидОтчета.УникальныйИдентификатор());
		КодПоОКУД = СокрЛП(ЗначенияРеквизитовВидаОтчета.КодФормыПоКлассификатору);
		
		ВидДокументаБИА = ВидДокументаДляАрхиваДляВнутреннегоЭДОтчетаГосУчреждения(КодПоОКУД, ИдентификаторВидаОтчета);
		Если ЗначениеЗаполнено(ВидДокументаБИА) Тогда
			ВидДокумента = СокрЛП(ВидДокументаБИА);
		Иначе
			ВидДокументаБИА = ВидДокументовБИАПрочийВнутреннийЭД();
			ВидДокумента = "Отчет";
		КонецЕсли;	
		
		РеквизитыПериодаОтчета = "ДатаНачала, ДатаОкончания, Периодичность, Произвольный";
		ЗначенияРеквизитовПериодаОтчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПериодОтчета, РеквизитыПериодаОтчета);
		ПериодичностьОтчета = ЗначенияРеквизитовПериодаОтчета.Периодичность;
		ДатаНачалаОтчетногоПериода = ЗначенияРеквизитовПериодаОтчета.ДатаНачала;
		ДатаОкончанияОтчетногоПериода = ЗначенияРеквизитовПериодаОтчета.ДатаОкончания;
		ЭтоПроизвольныйПериод = ЗначенияРеквизитовПериодаОтчета.Произвольный;
		
		Если ДатаЗаполнения = Дата(1,1,1) Тогда
			ДатаЗаполнения = ЗначенияРеквизитовДокумента.Дата;
		КонецЕсли;	
		
		НовыйДокументБИА = Справочники.ДокументыБИА.СоздатьЭлемент();
		СсылкаНаНовыйДокументБИА = Справочники.ДокументыБИА.ПолучитьСсылку();
		НовыйДокументБИА.УстановитьСсылкуНового(СсылкаНаНовыйДокументБИА);
		
		НовыйДокументБИА.ОбъектОснование = СсылкаНаОбъектИсточник;
		НовыйДокументБИА.Организация = Организация;
		НовыйДокументБИА.ВидДокумента =  ВидДокументаБИА;
		НовыйДокументБИА.ЭтоЭлектронныйДокумент = Истина;
		НовыйДокументБИА.Заголовок = СтрШаблон(НСтр("ru = 'Отчет ""%1"" (отчетный период: %2)'"), ВидДокумента, ПериодОтчета);
		НовыйДокументБИА.Содержание = СтрШаблон(НСтр("ru = 'Документ сформирован в 1С:БГУ 8 документом программы %1'"), СсылкаНаОбъектИсточник);
		НовыйДокументБИА.Дата = ДатаЗаполнения;
		НовыйДокументБИА.Номер = "";
		НовыйДокументБИА.Валюта = ВалютаДокументаПоУмолчанию;
		
		НовоеДопСвойство = НовыйДокументБИА.ПрочиеСвойства.Добавить();
		НовоеДопСвойство.Значение = СокрЛП(ПериодичностьОтчета);
		НовоеДопСвойство.ИмяСвойства = НСтр("ru = 'ПериодичностьОтчета'");
		НовоеДопСвойство.ПредставлениеСвойства = НСтр("ru = 'Периодичность отчета'");

		НовоеДопСвойство = НовыйДокументБИА.ПрочиеСвойства.Добавить();
		НовоеДопСвойство.Значение = ДатаНачалаОтчетногоПериода;
		НовоеДопСвойство.ИмяСвойства = НСтр("ru = 'ДатаНачалаОтчетногоПериода'");
		НовоеДопСвойство.ПредставлениеСвойства = НСтр("ru = 'Дата начала отчетного периода'");

		НовоеДопСвойство = НовыйДокументБИА.ПрочиеСвойства.Добавить();
		НовоеДопСвойство.Значение = ДатаОкончанияОтчетногоПериода;
		НовоеДопСвойство.ИмяСвойства = НСтр("ru = 'ДатаОкончанияОтчетногоПериода'");
		НовоеДопСвойство.ПредставлениеСвойства = НСтр("ru = 'Дата окончания отчетного периода'");

		НовоеДопСвойство = НовыйДокументБИА.ПрочиеСвойства.Добавить();
		НовоеДопСвойство.Значение = ЭтоПроизвольныйПериод;
		НовоеДопСвойство.ИмяСвойства = НСтр("ru = 'ПроизвольныйПериод'");
		НовоеДопСвойство.ПредставлениеСвойства = НСтр("ru = 'Произвольный период'");
		
		НовыйДокументБИА.Записать();
		
		//Присоединенные файлы с ЭЦП и МЧД при наличии
		
		Файлы = Новый Массив;
		РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(СсылкаНаОбъектИсточник, Файлы);
		Для Каждого Файл Из Файлы Цикл
			Если Файл.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
			СтрокаФайла.Файл = Файл;
			СтрокаФайла.Роль = РольФайлаБИАДополнительныйФайл();

			//Добавление сведений о ЭП
			ДобавлениеПодписейФайла(НовыйДокументБИА, Файл);
		КонецЦикла;
		
		НовыйДокументБИА.Записать(); 
		
		ДокументыБИА.Добавить(НовыйДокументБИА);
	ИначеЕсли ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
		Реквизиты = "Организация, ИсточникОтчета, ПредставлениеПериода, Периодичность, ДатаОтправки, ДатаНачала, ДатаОкончания, ДатаПодписи";
		ЗначенияРеквизитовДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
		Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.Организация) Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Для отчета %1 не указана организация. Обмен с 1С:Архив для такого документа не поддерживается.'"), СсылкаНаОбъектИсточник);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.ИсточникОтчета) Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Для отчета %1 не указан источник отчета (вид). Обмен с 1С:Архив для такого документа не поддерживается.'"), СсылкаНаОбъектИсточник);
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;	
		
		Организация = ЗначенияРеквизитовДокумента.Организация;
		ИсточникОтчета = ЗначенияРеквизитовДокумента.ИсточникОтчета;
		ПериодОтчета = "";
		Если ЗначениеЗаполнено(ЗначенияРеквизитовДокумента.ПредставлениеПериода) Тогда
			ПериодОтчета = ЗначенияРеквизитовДокумента.ПредставлениеПериода;
		КонецЕсли;
		ДатаЗаполнения = ЗначенияРеквизитовДокумента.ДатаПодписи;
		ВалютаДокументаПоУмолчанию = Константы.ВалютаРегламентированногоУчета.Получить();

		ВидДокументаБИА = ВидДокументаДляАрхиваПоИдентификаторуБГУ(ИсточникОтчета);
		Если ЗначениеЗаполнено(ВидДокументаБИА) Тогда
			ВидДокумента = СокрЛП(ВидДокументаБИА);
		Иначе
			ВидДокументаБИА = ВидДокументовБИАПрочийВнутреннийЭД();
			ВидДокумента = "Отчет";
		КонецЕсли;	
		
		ПериодичностьОтчета = ЗначенияРеквизитовДокумента.Периодичность;
		ДатаНачалаОтчетногоПериода = ЗначенияРеквизитовДокумента.ДатаНачала;
		ДатаОкончанияОтчетногоПериода = ЗначенияРеквизитовДокумента.ДатаОкончания;
		Если ЗначениеЗаполнено(ПериодичностьОтчета) Тогда
			ЭтоПроизвольныйПериод = Ложь;
		Иначе
			ЭтоПроизвольныйПериод = Истина;
		КонецЕсли;	
		
		Если ДатаЗаполнения = Дата(1,1,1) Тогда
			ДатаЗаполнения = ЗначенияРеквизитовДокумента.ДатаОтправки;
			Если ДатаЗаполнения = Дата(1,1,1) Тогда
				ДатаЗаполнения = ЗначенияРеквизитовДокумента.ДатаОкончания;
			КонецЕсли;	
		КонецЕсли;	
		Если ДатаЗаполнения = Дата(1,1,1) Тогда
			ДатаЗаполнения = ТекущаяДатаСеанса();
		КонецЕсли;	

		НовыйДокументБИА = Справочники.ДокументыБИА.СоздатьЭлемент();
		СсылкаНаНовыйДокументБИА = Справочники.ДокументыБИА.ПолучитьСсылку();
		НовыйДокументБИА.УстановитьСсылкуНового(СсылкаНаНовыйДокументБИА);
		
		НовыйДокументБИА.ОбъектОснование = СсылкаНаОбъектИсточник;
		НовыйДокументБИА.Организация = Организация;
		НовыйДокументБИА.ВидДокумента =  ВидДокументаБИА;
		НовыйДокументБИА.ЭтоЭлектронныйДокумент = Истина;
		Если ЗначениеЗаполнено(ПериодОтчета) Тогда
			НовыйДокументБИА.Заголовок = СтрШаблон(НСтр("ru = 'Отчет ""%1"" (отчетный период: %2)'"), ВидДокумента, ПериодОтчета);
		Иначе
			НовыйДокументБИА.Заголовок = СтрШаблон(НСтр("ru = 'Отчет ""%1""'"), ВидДокумента);
		КонецЕсли;
		НовыйДокументБИА.Содержание = СтрШаблон(НСтр("ru = 'Документ сформирован в 1С:БГУ 8 документом программы %1'"), СсылкаНаОбъектИсточник);
		НовыйДокументБИА.Дата = ДатаЗаполнения;
		НовыйДокументБИА.Номер = "";
		НовыйДокументБИА.Валюта = ВалютаДокументаПоУмолчанию;
		
		Если ЗначениеЗаполнено(ПериодичностьОтчета) Тогда
			НовоеДопСвойство = НовыйДокументБИА.ПрочиеСвойства.Добавить();
			НовоеДопСвойство.Значение = СокрЛП(ПериодичностьОтчета);
			НовоеДопСвойство.ИмяСвойства = НСтр("ru = 'ПериодичностьОтчета'");
			НовоеДопСвойство.ПредставлениеСвойства = НСтр("ru = 'Периодичность отчета'");
		КонецЕсли;

		Если ЗначениеЗаполнено(ДатаНачалаОтчетногоПериода) Тогда
			НовоеДопСвойство = НовыйДокументБИА.ПрочиеСвойства.Добавить();
			НовоеДопСвойство.Значение = ДатаНачалаОтчетногоПериода;
			НовоеДопСвойство.ИмяСвойства = НСтр("ru = 'ДатаНачалаОтчетногоПериода'");
			НовоеДопСвойство.ПредставлениеСвойства = НСтр("ru = 'Дата начала отчетного периода'");
		КонецЕсли;

		Если ЗначениеЗаполнено(ДатаОкончанияОтчетногоПериода) Тогда
			НовоеДопСвойство = НовыйДокументБИА.ПрочиеСвойства.Добавить();
			НовоеДопСвойство.Значение = ДатаОкончанияОтчетногоПериода;
			НовоеДопСвойство.ИмяСвойства = НСтр("ru = 'ДатаОкончанияОтчетногоПериода'");
			НовоеДопСвойство.ПредставлениеСвойства = НСтр("ru = 'Дата окончания отчетного периода'");
		КонецЕсли;

		НовоеДопСвойство = НовыйДокументБИА.ПрочиеСвойства.Добавить();
		НовоеДопСвойство.Значение = ЭтоПроизвольныйПериод;
		НовоеДопСвойство.ИмяСвойства = НСтр("ru = 'ПроизвольныйПериод'");
		НовоеДопСвойство.ПредставлениеСвойства = НСтр("ru = 'Произвольный период'");
		
		НовыйДокументБИА.Записать();
		
		РольДопФайлов = РольФайлаБИАДополнительныйФайл();
	 	Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет")
			ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
			РольДопФайлов = РольФайлаБИАВнутреннийЭД();
		КонецЕсли;	

		//Присоединенные файлы с ЭЦП и МЧД при наличии
		
		Файлы = Новый Массив;
		РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(СсылкаНаОбъектИсточник, Файлы);
		Для Каждого Файл Из Файлы Цикл
			Если Файл.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
			СтрокаФайла.Файл = Файл;
			СтрокаФайла.Роль = РольДопФайлов;

			//Добавление сведений о ЭП
			ДобавлениеПодписейФайла(НовыйДокументБИА, Файл);
		КонецЦикла;
		
		НовыйДокументБИА.Записать(); 
		
		ДокументыБИА.Добавить(НовыйДокументБИА);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьВДокументБИАФайлыОтдельныхВнутреннихЭДСодержательныхДокументовИнвентаризаций(НовыйДокументБИА, СсылкаНаОбъектИсточник)
	//Выгрузка из заголовочного документа инвентаризации требует добавления данных содержательных документов
    СодержательныеОписи = СодержательныеДокументыИнвентаризационнойОписи(СсылкаНаОбъектИсточник);
	Для Каждого ТекОпись Из СодержательныеОписи Цикл
		Если ЗначениеЗаполнено(ТекОпись.ДокументОписи) Тогда
			ВнутреннийЭД = ВнутренниеЭлектронныеДокументыБГУ.ВнутреннийЭДМногосоставногоДокументаИнвентаризации(ТекОпись.ДокументОписи);
			
			ДобавитьВДокументБИАФайлыОтдельногоВнутреннегоЭД(НовыйДокументБИА, ТекОпись.ДокументОписи, ВнутреннийЭД);
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Процедура СоздатьДокументыБИАДляДокументаУчетаВнешнегоЭДПоЭДП(СсылкаНаОбъектИсточник, ДокументыБИА) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	ВнешниеЭД = ЗавершенныеВнешниеЭД(СсылкаНаОбъектИсточник);
	Если ВнешниеЭД.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВалютаДокументаПоУмолчанию = Константы.ВалютаРегламентированногоУчета.Получить();

	ТипОбъекта = ТипЗнч(СсылкаНаОбъектИсточник);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипОбъекта);
	ПредставлениеОснования = ОбъектМетаданных.Синоним;
	
	ВидДокументаБИА = ВидДокументаДляАрхиваДляВнешнегоЭД(СсылкаНаОбъектИсточник);
	
	РеквизитыУчетногоДокумента = Новый Структура;
	РеквизитыУчетногоДокумента.Вставить("Вид", ?(ЗначениеЗаполнено(ВидДокументаБИА), ВидДокументаБИА.Наименование, ПредставлениеОснования));
	РеквизитыУчетногоДокумента.Вставить("Номер", "");
	РеквизитыУчетногоДокумента.Вставить("Дата", Дата(1,1,1));
	РеквизитыУчетногоДокумента.Вставить("СуммаДокумента", 0);
	РеквизитыУчетногоДокумента.Вставить("ВалютаДокумента", ВалютаДокументаПоУмолчанию);
	ЗаполнитьЗначенияСвойств(РеквизитыУчетногоДокумента, СсылкаНаОбъектИсточник);
	Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("СправочникСсылка.Договоры") Тогда
		Реквизиты = "ВидОбязательства, НомерДоговора, ДатаДоговора";
		ЗначенияРеквизитовИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);

		Если ЗначениеЗаполнено(ЗначенияРеквизитовИсточника.ВидОбязательства) Тогда
			РеквизитыУчетногоДокумента.Вид = ЗначенияРеквизитовИсточника.ВидОбязательства;
		КонецЕсли;
		РеквизитыУчетногоДокумента.Номер = ЗначенияРеквизитовИсточника.НомерДоговора;
		РеквизитыУчетногоДокумента.Дата = ЗначенияРеквизитовИсточника.ДатаДоговора;
	Иначе
		Реквизиты = "Номер, Дата";
		ЗначенияРеквизитовИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
		РеквизитыУчетногоДокумента.Номер = ЭлектронныеДокументыБГУ.НомерДляПечати(СсылкаНаОбъектИсточник, ЗначенияРеквизитовИсточника.Номер); 
	КонецЕсли;

	НовыйДокументБИА = Справочники.ДокументыБИА.СоздатьЭлемент();
	СсылкаНаНовыйДокументБИА = Справочники.ДокументыБИА.ПолучитьСсылку();
	НовыйДокументБИА.УстановитьСсылкуНового(СсылкаНаНовыйДокументБИА);
	ЗаполнитьЗначенияСвойств(НовыйДокументБИА, СсылкаНаОбъектИсточник);
	
	НовыйДокументБИА.ОбъектОснование = СсылкаНаОбъектИсточник;
	НовыйДокументБИА.ВидДокумента =  ВидДокументаБИА;
	НовыйДокументБИА.ЭтоЭлектронныйДокумент = Истина;
	НовыйДокументБИА.Заголовок = СтрШаблон(НСтр("ru = '%1 от %2 г. № %3'"), 
		РеквизитыУчетногоДокумента.Вид, Формат(РеквизитыУчетногоДокумента.Дата, "ДФ=dd.MM.yyyy"), РеквизитыУчетногоДокумента.Номер);
	НовыйДокументБИА.Содержание = СтрШаблон(НСтр("ru = 'Документ сформирован в 1С:БГУ 8 документом программы %1'"), СсылкаНаОбъектИсточник);
	НовыйДокументБИА.Дата = РеквизитыУчетногоДокумента.Дата;
	НовыйДокументБИА.Номер = РеквизитыУчетногоДокумента.Номер;
	НовыйДокументБИА.Сумма = РеквизитыУчетногоДокумента.СуммаДокумента;
	НовыйДокументБИА.Валюта = РеквизитыУчетногоДокумента.ВалютаДокумента;
	
	НовыйДокументБИА.Записать();
	
	Для Каждого ВнешнийДокумент Из ВнешниеЭД Цикл
		ФайлЭД = ВнешнийДокумент.ФайлЭД;
		
		СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
		СтрокаФайла.Файл = ФайлЭД;
		СтрокаФайла.Роль = РольФайлаБИАВнешнийЭД();
			
		//Добавление сведений о ЭП
		ДобавлениеПодписейФайла(НовыйДокументБИА, ФайлЭД);
		
		//Файл визуализации внешнего ЭД с штампами ЭП
		ДобавитьФайлВизуализацииВнешнегоЭД(СсылкаНаОбъектИсточник, ВнешнийДокумент, НовыйДокументБИА, СтрокаФайла, НовыйДокументБИА.Заголовок);
		
		//Дополнительный файл с архивом, где собраны все файлы документооборота целиком
		ФайлВнешнегоДокуменооборотаЦеликом = ФайлВнешнегоДокуменооборотаЦеликом(ВнешнийДокумент.ЭлектронныйДокумент, НовыйДокументБИА.Заголовок, НовыйДокументБИА);
		Если ЗначениеЗаполнено(ФайлВнешнегоДокуменооборотаЦеликом) Тогда
			СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
			СтрокаФайла.Файл = ФайлВнешнегоДокуменооборотаЦеликом;
			СтрокаФайла.Роль = РольФайлаБИАДополнительныйФайл();
		КонецЕсли;	
	КонецЦикла;

	//Присоединенные файлы с ЭЦП и МЧД при наличии
	ДобавитьПрисоединенныеКОбъектуФайлы(СсылкаНаОбъектИсточник, НовыйДокументБИА);
	
	НовыйДокументБИА.Записать();
	
	ДокументыБИА.Добавить(НовыйДокументБИА);

КонецПроцедуры
	
Процедура СоздатьДокументыБИАДляДокументаУчетаВнешнегоЭД(СсылкаНаОбъектИсточник, ДокументыБИА) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЭтоДокументСЭлектроннымиИзвещениями0504805(СсылкаНаОбъектИсточник)
		ИЛИ ЭтоДокументСЭлектроннымиАктами0510448(СсылкаНаОбъектИсточник) Тогда
		Возврат;
	КонецЕсли;	
	
	ВнешниеЭД = ЗавершенныеВнешниеЭД(СсылкаНаОбъектИсточник);
	Если ВнешниеЭД.Количество() = 0 Тогда
		ЭДП = ОснованиеЭлектронныйДокументПоставщика(СсылкаНаОбъектИсточник);
		Если ЗначениеЗаполнено(ЭДП) Тогда
			СоздатьДокументыБИАДляДокументаУчетаВнешнегоЭДПоЭДП(ЭДП, ДокументыБИА);
			Возврат;
		Иначе
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	ВалютаДокументаПоУмолчанию = Константы.ВалютаРегламентированногоУчета.Получить();
	ЭтоВнутреннийЭДОБЭД = Ложь;

	ТипОбъекта = ТипЗнч(СсылкаНаОбъектИсточник);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипОбъекта);
	ПредставлениеОснования = ОбъектМетаданных.Синоним;
	
	Если ВнешниеЭД.Количество() > 0 Тогда
		Если ВнешниеЭД[0].ЭлектронныйДокумент.ВидДокумента.ТипДокумента = Перечисления.ТипыДокументовЭДО.Внутренний Тогда
			//Внутренние ЭД БЭД
			ЭтоВнутреннийЭДОБЭД = Истина;
			ИдентификаторКомандыПечати = ВнешниеЭД[0].ЭлектронныйДокумент.ВидДокумента.ИдентификаторКомандыПечати;
			ВидДокументаБИА = ВидДокументаДляАрхиваДляВнутреннегоЭД(СсылкаНаОбъектИсточник, ИдентификаторКомандыПечати);
			Если НЕ ЗначениеЗаполнено(ВидДокументаБИА) Тогда
				ВидДокументаБИА = ВидДокументовБИАПрочийВнутреннийЭД();
			КонецЕсли;
		Иначе	
			ВидДокументаБИА = ВидДокументаДляАрхиваДляВнешнегоЭД(СсылкаНаОбъектИсточник);
			Если НЕ ЗначениеЗаполнено(ВидДокументаБИА) Тогда
				Если ТипЗнч(ВнешниеЭД[0].ЭлектронныйДокумент) = Тип("ДокументСсылка.ЭлектронныйДокументИсходящийЭДО") Тогда
					ВидДокументаБИА = ВидДокументовБИАВнешнийЭДИсходящий();
				Иначе
					ВидДокументаБИА = ВидДокументовБИАВнешнийЭДВходящий();
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	РеквизитыУчетногоДокумента = Новый Структура;
	РеквизитыУчетногоДокумента.Вставить("Вид", ?(ЗначениеЗаполнено(ВидДокументаБИА), ВидДокументаБИА.Наименование, ПредставлениеОснования));
	РеквизитыУчетногоДокумента.Вставить("Номер", "");
	РеквизитыУчетногоДокумента.Вставить("Дата", Дата(1,1,1));
	РеквизитыУчетногоДокумента.Вставить("СуммаДокумента", 0);
	РеквизитыУчетногоДокумента.Вставить("ВалютаДокумента", ВалютаДокументаПоУмолчанию);
	ЗаполнитьЗначенияСвойств(РеквизитыУчетногоДокумента, СсылкаНаОбъектИсточник);
	Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("СправочникСсылка.Договоры") Тогда
		Реквизиты = "ВидОбязательства, НомерДоговора, ДатаДоговора";
		ЗначенияРеквизитовИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);

		Если ЗначениеЗаполнено(ЗначенияРеквизитовИсточника.ВидОбязательства) Тогда
			РеквизитыУчетногоДокумента.Вид = ЗначенияРеквизитовИсточника.ВидОбязательства;
		КонецЕсли;
		РеквизитыУчетногоДокумента.Номер = ЗначенияРеквизитовИсточника.НомерДоговора;
		РеквизитыУчетногоДокумента.Дата = ЗначенияРеквизитовИсточника.ДатаДоговора;
	Иначе
		Реквизиты = "Номер, Дата";
		ЗначенияРеквизитовИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
		РеквизитыУчетногоДокумента.Номер = ЭлектронныеДокументыБГУ.НомерДляПечати(СсылкаНаОбъектИсточник, ЗначенияРеквизитовИсточника.Номер); 
	КонецЕсли;

	НовыйДокументБИА = Справочники.ДокументыБИА.СоздатьЭлемент();
	СсылкаНаНовыйДокументБИА = Справочники.ДокументыБИА.ПолучитьСсылку();
	НовыйДокументБИА.УстановитьСсылкуНового(СсылкаНаНовыйДокументБИА);
	ЗаполнитьЗначенияСвойств(НовыйДокументБИА, СсылкаНаОбъектИсточник);
	
	НовыйДокументБИА.ОбъектОснование = СсылкаНаОбъектИсточник;
	НовыйДокументБИА.ВидДокумента =  ВидДокументаБИА;
	НовыйДокументБИА.ЭтоЭлектронныйДокумент = Истина;
	НовыйДокументБИА.Заголовок = СтрШаблон(НСтр("ru = '%1 от %2 г. № %3'"), 
		РеквизитыУчетногоДокумента.Вид, Формат(РеквизитыУчетногоДокумента.Дата, "ДФ=dd.MM.yyyy"), РеквизитыУчетногоДокумента.Номер);
	НовыйДокументБИА.Содержание = СтрШаблон(НСтр("ru = 'Документ сформирован в 1С:БГУ 8 документом программы %1'"), СсылкаНаОбъектИсточник);
	НовыйДокументБИА.Дата = РеквизитыУчетногоДокумента.Дата;
	НовыйДокументБИА.Номер = РеквизитыУчетногоДокумента.Номер;
	НовыйДокументБИА.Сумма = РеквизитыУчетногоДокумента.СуммаДокумента;
	НовыйДокументБИА.Валюта = РеквизитыУчетногоДокумента.ВалютаДокумента;
	
	НовыйДокументБИА.Записать();
	
	Для Каждого ВнешнийДокумент Из ВнешниеЭД Цикл
		ФайлЭД = ВнешнийДокумент.ФайлЭД;
		
		СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
		СтрокаФайла.Файл = ФайлЭД;
		СтрокаФайла.Роль = ?(ЭтоВнутреннийЭДОБЭД, РольФайлаБИАВнутреннийЭД(), РольФайлаБИАВнешнийЭД());
			
		//Добавление сведений о ЭП
		ДобавлениеПодписейФайла(НовыйДокументБИА, ФайлЭД);
		
		//Файл визуализации внешнего ЭД с штампами ЭП
		ДобавитьФайлВизуализацииВнешнегоЭД(СсылкаНаОбъектИсточник, ВнешнийДокумент, НовыйДокументБИА, СтрокаФайла, НовыйДокументБИА.Заголовок);
		
		//Дополнительный файл с архивом, где собраны все файлы документооборота целиком
		ФайлВнешнегоДокуменооборотаЦеликом = ФайлВнешнегоДокуменооборотаЦеликом(ВнешнийДокумент.ЭлектронныйДокумент, НовыйДокументБИА.Заголовок, НовыйДокументБИА);
		Если ЗначениеЗаполнено(ФайлВнешнегоДокуменооборотаЦеликом) Тогда
			СтрокаФайла = НовыйДокументБИА.Файлы.Добавить();
			СтрокаФайла.Файл = ФайлВнешнегоДокуменооборотаЦеликом;
			СтрокаФайла.Роль = РольФайлаБИАДополнительныйФайл();
		КонецЕсли;	
	КонецЦикла;

	//Присоединенные файлы с ЭЦП и МЧД при наличии
	ДобавитьПрисоединенныеКОбъектуФайлы(СсылкаНаОбъектИсточник, НовыйДокументБИА); 
	
	НовыйДокументБИА.Записать();
	
	ДокументыБИА.Добавить(НовыйДокументБИА);
	
КонецПроцедуры

//Составные инвентаризации

Функция ДокументУчетаПоддерживаетСерииДокументовОписиИнвентаризации(СсылкаНаОбъектИсточник)
	Результат = Ложь;
	Если ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям") 
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами")
		ИЛИ ТипЗнч(СсылкаНаОбъектИсточник) = Тип("ДокументСсылка.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда
		Результат = Истина;
	Конецесли;	

	Возврат Результат;
КонецФункции

Функция КодТипаДокументаУчетаДокументовОписиИнвентаризации(СсылкаНаОбъектИсточник) Экспорт
	Результат = 0;
	Если ДокументУчетаПоддерживаетСерииДокументовОписиИнвентаризации(СсылкаНаОбъектИсточник) Тогда
		Реквизиты = "ИдентификаторСерииДокументов, ЭтоЗаголовочныйДокумент";
		ЗначенияРеквизитовИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъектИсточник, Реквизиты);
		Если ЗначенияРеквизитовИсточника.ЭтоЗаголовочныйДокумент Тогда
			Результат = 1;
		ИначеЕсли ЗначениеЗаполнено(ЗначенияРеквизитовИсточника.ИдентификаторСерииДокументов) Тогда
			Результат = 2;
		КонецЕсли;	
	Конецесли;	

	Возврат Результат;
КонецФункции

Функция ЗаголовочныйДокументИнвентаризационнойОписи(СсылкаНаОбъектИсточник) Экспорт
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИнвентаризационнаяОписьНФАСписокДокументовСерии.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ИнвентаризационнаяОписьНФА.СписокДокументовСерии КАК ИнвентаризационнаяОписьНФАСписокДокументовСерии
	               |ГДЕ
	               |	ИнвентаризационнаяОписьНФАСписокДокументовСерии.ДокументОписи = &ДокументОписи
	               |	И ИнвентаризационнаяОписьНФАСписокДокументовСерии.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ИнвентаризационнаяОписьРасчетовПоПоступлениямСписокДокументовСерии.Ссылка
	               |ИЗ
	               |	Документ.ИнвентаризационнаяОписьРасчетовПоПоступлениям.СписокДокументовСерии КАК ИнвентаризационнаяОписьРасчетовПоПоступлениямСписокДокументовСерии
	               |ГДЕ
	               |	ИнвентаризационнаяОписьРасчетовПоПоступлениямСписокДокументовСерии.ДокументОписи = &ДокументОписи
	               |	И ИнвентаризационнаяОписьРасчетовПоПоступлениямСписокДокументовСерии.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ИнвентаризационнаяОписьРасчетовСКонтрагентамиСписокДокументовСерии.Ссылка
	               |ИЗ
	               |	Документ.ИнвентаризационнаяОписьРасчетовСКонтрагентами.СписокДокументовСерии КАК ИнвентаризационнаяОписьРасчетовСКонтрагентамиСписокДокументовСерии
	               |ГДЕ
	               |	ИнвентаризационнаяОписьРасчетовСКонтрагентамиСписокДокументовСерии.ДокументОписи = &ДокументОписи
	               |	И ИнвентаризационнаяОписьРасчетовСКонтрагентамиСписокДокументовСерии.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениямСписокДокументовСерии.Ссылка
	               |ИЗ
