#Область ПрограммныйИнтерфейс

Процедура ОткрытьРасшифровкуДекларацияНДС(ИДРедакцииОтчета, ИДИменПоказателей, ПараметрыОтчета) Экспорт
	
	СтрокаРасшифровки = УчетНДСВызовСервера.ПолучитьСтрокуРасшифровкиДляПоказателя(ИДИменПоказателей, ПараметрыОтчета);
	
	Если СтрокаРасшифровки = Неопределено Тогда
		ВерсияСтрокой = Сред(ИДРедакцииОтчета, 12);
		
		ТекстЗаголовкаСообщений = СтрШаблон(НСтр("ru='Декларация НДС %1'"), ВерсияСтрокой);
		
		ТекстСообщения = НСтр("ru='Для выбранной ячейки расшифровка не задана'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
		Возврат;
	КонецЕсли;
	
	ИДИменПоказателей = Новый Массив();
	ИДИменПоказателей.Добавить(СтрокаРасшифровки["ИмяПоказателя"]);
	
	ПараметрыФормы = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ПараметрыОтчета);
	ПараметрыФормы.Вставить("ИДИменПоказателей", ИДИменПоказателей);
	
	ОткрытьФорму("ОбщаяФорма.РасшифровкаПоказателейРегламентированныхОтчетов", ПараметрыФормы, , Истина);
	
КонецПроцедуры

// Параметры для открытия общей формы ДокументыСчетовФактурНаОтгрузку.
Функция НовыйПараметрыОткрытияОбщейФормыДокументыСчетовФактурНаОтгрузку() Экспорт
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("АдресДанных");
	ПараметрыФормы.Вставить("СчетФактура");
	ПараметрыФормы.Вставить("ИсключитьРегистратор");
	
	Возврат ПараметрыФормы;
	
КонецФункции

#Область МеханизмАвтоустановкиСубконто

Процедура АвтоустановкаСубконто_СубконтоНачалоВыбора(Форма, ЭлементСубконто, ДанныеВыбора, СтандартнаяОбработка) Экспорт
	
	АналитикаТекущейСтроки = АвтоустановкаСубконто_ПолучитьАналитикуТекущейСтроки(Форма, ЭлементСубконто);
	
	СтруктураВыбораСубконто = БухгалтерскийУчетКлиент.ИнициализироватьСтруктуруНачалаВыбораСубконто();
	ЗаполнитьЗначенияСвойств(СтруктураВыбораСубконто, АналитикаТекущейСтроки);
	
	Форма.Переопределяемый_АвтоустановкаСубконто_СубконтоНачалоВыбора_Клиент(СтруктураВыбораСубконто);
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбора(ЭлементСубконто,
		ДанныеВыбора,
		СтандартнаяОбработка,
		,											// Организация
		АналитикаТекущейСтроки["ЗначениеСубконто"],	// ТекущееЗначение
		АналитикаТекущейСтроки["Счет"],				// ТекущийСчет
		,											// ПрефиксСубконтоДанных
		СтруктураВыбораСубконто);
	
КонецПроцедуры

Функция АвтоустановкаСубконто_ПолучитьАналитикуТекущейСтроки(Форма, ЭлементСубконто) Экспорт
	
	ИмяЭлементаСубконто = ЭлементСубконто.Имя;
	
	АналитикаТекущейСтроки = Новый Структура();
	
	// Один элемент "субконто" -> элемент "счет" -> таблица элементов "субконто"
	Поиск = Новый Структура("ИмяЭлемента", ИмяЭлементаСубконто);
	МассивСтрок = Форма["АвтоустановкаСубконто_ТаблицаЭлементыСубконто"].НайтиСтроки(Поиск);
	Если МассивСтрок.Количество() > 0 Тогда
		СтрокаЭлементаСубконто = МассивСтрок[0];
		ИмяЭлементаСчет = СтрокаЭлементаСубконто["ИмяЭлементаСчет"];
		
		Поиск = Новый Структура("ИмяЭлемента", ИмяЭлементаСчет);
		МассивСтрок = Форма["АвтоустановкаСубконто_ОбщаяТаблицаНастроек"].НайтиСтроки(Поиск);
		Если МассивСтрок.Количество() > 0 Тогда
			СтрокаОбщейТаблицы = МассивСтрок[0];
			ТаблицаНастроекСчетИСубконто = СтрокаОбщейТаблицы["ТаблицаНастроекСчетИСубконто"];
			
			СтруктураТекущейСтроки = АвтоустановкаСубконто_ПолучитьТекущуюСтроку(Форма, ЭлементСубконто);
			ТекущаяСтрока = СтруктураТекущейСтроки["ТекущаяСтрока"];
			ТекущиеДанные = СтруктураТекущейСтроки["ТекущиеДанные"];
			Если НЕ ТекущиеДанные = Неопределено Тогда
				ИмяРеквизитаСубконто1 = ТаблицаНастроекСчетИСубконто[1]["ИмяРеквизита"];
				ИмяРеквизитаСубконто2 = ТаблицаНастроекСчетИСубконто[2]["ИмяРеквизита"];
				ИмяРеквизитаСубконто3 = ТаблицаНастроекСчетИСубконто[3]["ИмяРеквизита"];
				АналитикаТекущейСтроки.Вставить("Счет",					УчетНДСКлиентСервер.АвтоустановкаСубконто_ВычислитьЗначениеРеквизита(Форма, ТаблицаНастроекСчетИСубконто[0], ТекущаяСтрока));
				АналитикаТекущейСтроки.Вставить("Субконто1",			ТекущиеДанные[ИмяРеквизитаСубконто1]);
				АналитикаТекущейСтроки.Вставить("Субконто2",			ТекущиеДанные[ИмяРеквизитаСубконто2]);
				АналитикаТекущейСтроки.Вставить("Субконто3",			ТекущиеДанные[ИмяРеквизитаСубконто3]);
				Если ИмяЭлементаСубконто = ТаблицаНастроекСчетИСубконто[1]["ИмяЭлемента"] Тогда
					НомерСубконто			= 1;
					ИмяРеквизитаСубконто	= ИмяРеквизитаСубконто1;
					ЗначениеСубконто		= ТекущиеДанные[ИмяРеквизитаСубконто1];
				ИначеЕсли ИмяЭлементаСубконто = ТаблицаНастроекСчетИСубконто[2]["ИмяЭлемента"] Тогда
					НомерСубконто			= 2;
					ИмяРеквизитаСубконто	= ИмяРеквизитаСубконто2;
					ЗначениеСубконто		= ТекущиеДанные[ИмяРеквизитаСубконто2];
				ИначеЕсли ИмяЭлементаСубконто = ТаблицаНастроекСчетИСубконто[3]["ИмяЭлемента"] Тогда
					НомерСубконто			= 3;
					ИмяРеквизитаСубконто	= ИмяРеквизитаСубконто3;
					ЗначениеСубконто		= ТекущиеДанные[ИмяРеквизитаСубконто3];
				Иначе
					НомерСубконто			= 0;
					ИмяРеквизитаСубконто	= "";
					ЗначениеСубконто		= Неопределено;
				КонецЕсли;
				АналитикаТекущейСтроки.Вставить("НомерСубконто",			НомерСубконто);
				АналитикаТекущейСтроки.Вставить("ИмяРеквизитаСубконто",		ИмяРеквизитаСубконто);
				АналитикаТекущейСтроки.Вставить("ЗначениеСубконто",			ЗначениеСубконто);
				
				АналитикаТекущейСтроки.Вставить("ИмяРеквизитаСубконто1",	ИмяРеквизитаСубконто1);
				АналитикаТекущейСтроки.Вставить("ИмяРеквизитаСубконто2",	ИмяРеквизитаСубконто2);
				АналитикаТекущейСтроки.Вставить("ИмяРеквизитаСубконто3",	ИмяРеквизитаСубконто3);
				
				АналитикаТекущейСтроки.Вставить("СтруктураТекущейСтроки",	СтруктураТекущейСтроки);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат АналитикаТекущейСтроки;
	
КонецФункции

Функция АвтоустановкаСубконто_ПолучитьТекущуюСтроку(Форма, Элемент) Экспорт
	
	ОбщаяТаблицаНастроек = Форма["АвтоустановкаСубконто_ОбщаяТаблицаНастроек"];
	
	Результат = Новый Структура("
		|ТекущаяСтрока,
		|ТекущиеДанные,
		|СтруктураДляПередачиНаСервер");
		
	Поиск = Новый Структура("ИмяЭлемента", Элемент.Имя);
	
	МассивСтрок = ОбщаяТаблицаНастроек.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		
		СтрокаОбщейТаблицы = МассивСтрок[0];
		
		ЭлементТаблица = Форма.Элементы[СтрокаОбщейТаблицы["ИмяЭлементаТаблица"]];
		
		Результат.Вставить("ТекущаяСтрока", ЭлементТаблица.ТекущаяСтрока);
		Результат.Вставить("ТекущиеДанные", ЭлементТаблица.ТекущиеДанные);
		
		ЭтоОбслуживаемыйИдентификатор = ЭлементМассиваСуществует(Форма["АвтоустановкаСубконто_МассивОбслуживаемыхИдентификаторов"], СтрокаОбщейТаблицы["Идентификатор"]);
		
		СтруктураДляПередачиНаСервер = Новый Структура();
		СтруктураДляПередачиНаСервер.Вставить("ТекущаяСтрока",					Результат["ТекущаяСтрока"]);
		СтруктураДляПередачиНаСервер.Вставить("ЭтоОбслуживаемыйИдентификатор",	ЭтоОбслуживаемыйИдентификатор);
		
		Результат.Вставить("СтруктураДляПередачиНаСервер", СтруктураДляПередачиНаСервер);
		
	Иначе
		
		ТаблицаЭлементыСубконто = Форма["АвтоустановкаСубконто_ТаблицаЭлементыСубконто"];
		
		МассивСтрок = ТаблицаЭлементыСубконто.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			
			СтрокаТаблицыЭлементыСубконто = МассивСтрок[0];
			
			ЭлементТаблица = Форма.Элементы[СтрокаТаблицыЭлементыСубконто["ИмяЭлементаТаблица"]];
			
			Результат.Вставить("ТекущаяСтрока", ЭлементТаблица.ТекущаяСтрока);
			Результат.Вставить("ТекущиеДанные", ЭлементТаблица.ТекущиеДанные);
			
			ЭтоОбслуживаемыйИдентификатор = ЭлементМассиваСуществует(Форма["АвтоустановкаСубконто_МассивОбслуживаемыхИдентификаторов"], СтрокаТаблицыЭлементыСубконто["Идентификатор"]);
			
			СтруктураДляПередачиНаСервер = Новый Структура();
			СтруктураДляПередачиНаСервер.Вставить("ТекущаяСтрока",					Результат["ТекущаяСтрока"]);
			СтруктураДляПередачиНаСервер.Вставить("ЭтоОбслуживаемыйИдентификатор",	ЭтоОбслуживаемыйИдентификатор);
			
			Результат.Вставить("СтруктураДляПередачиНаСервер", СтруктураДляПередачиНаСервер);
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция АвтоустановкаСубконто_ПриИзмененииСубконтоВТаблице(Форма, Элемент) Экспорт
	
	АналитикаТекущейСтроки	= АвтоустановкаСубконто_ПолучитьАналитикуТекущейСтроки(Форма, Элемент);
	СтруктураТекущейСтроки	= АналитикаТекущейСтроки["СтруктураТекущейСтроки"];
	
	// Сбрасываем флаг "Отметка" для поля измененного субконто:
	Если СтруктураТекущейСтроки["СтруктураДляПередачиНаСервер"]["ЭтоОбслуживаемыйИдентификатор"] Тогда
		ТекущиеДанные = СтруктураТекущейСтроки["ТекущиеДанные"];
		Поиск = Новый Структура("ИмяЭлемента", Элемент.Имя);
		МассивСтрок = Форма["АвтоустановкаСубконто_ТаблицаЭлементыСубконто"].НайтиСтроки(Поиск);
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			ТекущиеДанные[СтрокаТаблицы["ИмяРеквизитаОтметить"]] = Ложь;
		КонецЦикла;
	КонецЕсли;
	
	// Типовой обработчик:
	БухгалтерскиеОперацииКлиент.СубконтоПриИзменении(Элемент, , АналитикаТекущейСтроки);
	
КонецФункции

Функция АвтоустановкаСубконто_ПриИзмененииЗначенияАвтоустановкиВТаблице(Форма, Элемент) Экспорт
	
	СтруктураТекущейСтроки	= АвтоустановкаСубконто_ПолучитьТекущуюСтроку(Форма, Элемент);
	
	Если СтруктураТекущейСтроки["СтруктураДляПередачиНаСервер"]["ЭтоОбслуживаемыйИдентификатор"] Тогда
		ТекущиеДанные = СтруктураТекущейСтроки["ТекущиеДанные"];
		
		// Устанавливаем значение соответствующего субконто:
		Поиск = Новый Структура("ИмяЭлемента", Элемент.Имя);
		МассивСтрок = Форма["АвтоустановкаСубконто_ТаблицаЭлементыАвтоустановкиВТаблице"].НайтиСтроки(Поиск);
		Для Каждого СтрокаТаблицыЭлементыАвтоустановкиВТаблице Из МассивСтрок Цикл
			ЗначениеАвтоустановки	= ТекущиеДанные[СтрокаТаблицыЭлементыАвтоустановкиВТаблице["ИмяРеквизита"]];
			НомерСубконто			= ТекущиеДанные[СтрокаТаблицыЭлементыАвтоустановкиВТаблице["ИмяРеквизитаНомерСубконто"]];
			Если НомерСубконто > 0 Тогда
				НомерСубконтоСтрока		= Строка(НомерСубконто);
				ИмяРеквизитаСубконто	= СтрокаТаблицыЭлементыАвтоустановкиВТаблице["ИмяРеквизитаСубконто" + НомерСубконтоСтрока];
				
				ОписаниеТиповВидаСубконто = СтрокаТаблицыЭлементыАвтоустановкиВТаблице["ОписаниеТиповВидаСубконто"];
				ПриведенноеЗначение = ОписаниеТиповВидаСубконто.ПривестиЗначение(ЗначениеАвтоустановки);
				Если ПриведенноеЗначение = ЗначениеАвтоустановки Тогда
					ТекущиеДанные[ИмяРеквизитаСубконто] = ЗначениеАвтоустановки;
					ФлагОтметить = Истина;
				Иначе
					ФлагОтметить = Ложь;
				КонецЕсли;
				
				// Устанавливаем флаг "Отметка" для поля измененного субконто:
				ИмяРеквизитаОтметить = СтрокаТаблицыЭлементыАвтоустановкиВТаблице["ИмяРеквизитаОтметитьСубконто" + НомерСубконтоСтрока];
				ТекущиеДанные[ИмяРеквизитаОтметить] = ФлагОтметить;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ДокументыОстатковНДС

Процедура ДокументыОстатковНДС_НажатиеКнопкиПоказать(Форма) Экспорт
	
	СписокДокументов = УчетНДСВызовСервера.ДокументОстатковНДС_НайтиВводыНачальныхОстатков(Форма.Объект.Ссылка);
	
	Если СписокДокументов.Количество() = 0 Тогда
		
		ТекстСообщения = НСтр("ru='Не обнаружены проведенные документы ввода остатков НДС по данному документу'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
	Иначе
		
		ОповещениеВыбор = Новый ОписаниеОповещения("ДокументыОстатковНДС_ВыбранДокументВводаОстатковНДС", Форма);
		
		Форма.ПоказатьВыборИзСписка(ОповещениеВыбор, СписокДокументов);
		
	КонецЕсли;
	
КонецПроцедуры
	
Процедура ДокументыОстатковНДС_ПодтвердитьСбросФлажка(Форма) Экспорт
	
	Если НЕ Форма.Объект.ВводНачальныхОстатков Тогда
		
		ТекстСообщения = НСтр("ru='Признак ""Ввод начальных остатков"" уже сброшен'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
		
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru='Сбросить признак ""Ввод начальных остатков""?
		|
		|Сброс признака позволит провести данный документ.'");
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ДокументыОстатковНДС_ПодтвердитьСбросФлажка_Выбор", Форма);
	
	ПоказатьВопрос(ОписаниеОповещенияВыбор, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

Процедура ДокументыОстатковНДС_ПодтвердитьСбросФлажка_Выбор(Форма, РезультатВыбора) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		Форма.Объект["ВводНачальныхОстатков"] = Ложь;
		
		Форма.Модифицированность = Истина;
		
		УчетНДСКлиентСервер.ДокументыОстатковНДС_УстановитьВидимостьИнформационногоЗаголовка(Форма, Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДокументыОстатковНДС_ВыбранДокументВводаОстатковНДС(Результат) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, Результат.Значение);
	
КонецПроцедуры

