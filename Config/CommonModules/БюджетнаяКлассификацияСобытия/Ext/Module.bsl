#Область ПрограммныйИнтерфейс

// Обработчик проверки корректности заполнения кода для бюджетных классификаторов.
// Подписка ПроверитьКодЭлементаБюджетногоКлассификатора
//
Процедура ПроверитьКод(Источник, Отказ, ПроверяемыеРеквизиты) Экспорт
	
	МетаданныеСправочника = Источник.Метаданные();
	
	Если МетаданныеСправочника.Имя = "ПрограммыЦелевыхСтатейКРБ" Тогда 
		Если Источник.ДатаНачалаДействия < Дата(2014, 1, 1) Тогда
			ДлинаКода = 2;
		ИначеЕсли Источник.ДатаНачалаДействия < Дата(2016, 1, 1) Тогда	
			ДлинаКода = 4;
		Иначе
			ДлинаКода = МетаданныеСправочника.ДлинаКода;
		КонецЕсли;	
	ИначеЕсли МетаданныеСправочника.Имя = "ЦелевыеСтатьиКРБ" Тогда 
		Если Источник.ДатаНачалаДействия < Дата(2016, 1, 1) Тогда	
			ДлинаКода = 3;
		Иначе
			ДлинаКода = МетаданныеСправочника.ДлинаКода;
		КонецЕсли;	
	Иначе
		ДлинаКода = МетаданныеСправочника.ДлинаКода;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Источник.Код) И НЕ СтрДлина(СтрЗаменить(СокрЛП(Источник.Код), " ", "")) = ДлинаКода Тогда
		Инд = ПроверяемыеРеквизиты.Найти("Код");
		Если НЕ Инд = Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(Инд);
		КонецЕсли;
		ОбщегоНазначения.СообщитьПользователю(
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Код должен состоять из %1 символов'"),
		ДлинаКода),
		Источник,
		"Код",,
		Отказ);
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ МЕХАНИЗМА АВТОИЕРАРХИИ
//

// Обработчик подписки ОпределитьРодителяДляАвтоиерархии
//
Процедура ОпределитьРодителяДляАвтоиерархии(Источник, Отказ) Экспорт
	
	Перем ПараметрыАвтоиерархии;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОпределитьРодителяДляАвтоиерархииЯвно(Источник, Отказ);
	
КонецПроцедуры

// Процедура будет вызываться явно при записи объектов с признаком ОбменДанным.Загрузка = Истина
// Например, при загрузке классификации.
//
Процедура ОпределитьРодителяДляАвтоиерархииЯвно(Источник, Отказ) Экспорт
	
	Перем ПараметрыАвтоиерархии;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ПометкаУдаления Тогда
		Если НЕ Источник.Родитель.Пустая() Тогда
			Если НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Родитель, "ПометкаУдаления") Тогда
				Источник.Родитель = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Источник.Родитель).ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("ПараметрыАвтоиерархии", ПараметрыАвтоиерархии) Тогда
		
		НовыйКодРодителя = "";
		
		Если ПараметрыАвтоиерархии.Свойство("НовыйРодитель") Тогда
			Источник.Родитель = ПараметрыАвтоиерархии.НовыйРодитель;
			Возврат;
		ИначеЕсли ПараметрыАвтоиерархии.Свойство("НовыйКодРодителя") Тогда
			ОпределитьРодителяСправочникаСАвтоиерархией(Источник, НовыйКодРодителя);
			Возврат;
		КонецЕсли;
		
	Иначе
		
		ПараметрыАвтоиерархии = Новый Структура;
		Источник.ДополнительныеСвойства.Вставить("ПараметрыАвтоиерархии", ПараметрыАвтоиерархии);
		
	КонецЕсли;
	
	Если Источник.Код <> Источник.Ссылка.Код ИЛИ Источник.Ссылка.ПометкаУдаления И НЕ Источник.ПометкаУдаления Тогда
		ПараметрыАвтоиерархии.Вставить("КодИзменен", Истина);
		ОпределитьРодителяСправочникаСАвтоиерархией(Источник);
	Иначе
		ПараметрыАвтоиерархии.Вставить("КодИзменен", Ложь); // нужно очистить флаг, если это вторая запись, а первая не удалась
	КонецЕсли;
	
КонецПроцедуры

// Обработчик подписки ОпределитьПодчиненныеЭлементыДляАвтоиерархии
//
Процедура ОпределитьПодчиненныеЭлементыДляАвтоиерархии(Источник, Отказ) Экспорт
	
	Перем ПараметрыАвтоиерархии, ПредыдущийКод;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	ОпределитьПодчиненныеЭлементыДляАвтоиерархииЯвно(Источник, Отказ);
	
КонецПроцедуры

// Процедура будет вызываться явно при записи объектов с признаком ОбменДанным.Загрузка = Истина
// Например, при загрузке классификации.
//
Процедура ОпределитьПодчиненныеЭлементыДляАвтоиерархииЯвно(Источник, Отмена, СтандартноеПоведение = Истина, ТаблицаОшибок = Неопределено, СоответствиеЭталоновДанных=Неопределено, СоответствиеАктуализации=Неопределено, НужноЗаполнятьТаблицуАктуализации=Ложь) Экспорт
	
	Перем ПараметрыАвтоиерархии, ПредыдущийКод;
	
	Если Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеСправочника = Источник.Метаданные();
	
	ЭтоСправочникЦС = (МетаданныеСправочника.Имя = "ЦелевыеСтатьиКРБ");
	
	Если ЭтоСправочникЦС И Источник.ДатаНачалаДействия < Дата(2014, 1, 1) Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ Источник.ДополнительныеСвойства.Свойство("ПараметрыАвтоиерархии", ПараметрыАвтоиерархии) Тогда
		ПараметрыАвтоиерархии = Новый Структура;
		Источник.ДополнительныеСвойства.Вставить("ПараметрыАвтоиерархии", ПараметрыАвтоиерархии);
	КонецЕсли;
	
	КодИзменен = ПараметрыАвтоиерархии.Свойство("КодИзменен") И ПараметрыАвтоиерархии.КодИзменен;
	
	Менеджер = Справочники[МетаданныеСправочника.Имя];
	ТипОбъекта = ТипЗнч(Источник);
	РеквизитКода = ?(МетаданныеСправочника.ДлинаНаименования>0, "Наименование", "Код");
	
	Если НЕ Источник.ЭтоНовый() И КодИзменен Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	КОСГУ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КОСГУ КАК КОСГУ
		|ГДЕ
		|	КОСГУ.Родитель = &Родитель
		|	И КОСГУ.ПометкаУдаления = ЛОЖЬ";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КОСГУ", МетаданныеСправочника.Имя);
		Запрос = Новый Запрос(ТекстЗапроса);
		
		Запрос.УстановитьПараметр("Родитель", Источник.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ПодчиненныйОбъект = Выборка.Получить(0).ПолучитьОбъект();
			ПодчиненныйОбъект.Заблокировать();
			
			Если НЕ СтандартноеПоведение Тогда
				КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ПодчиненныйОбъект);
				Если СоответствиеЭталоновДанных.Получить(ПодчиненныйОбъект.Ссылка) = Неопределено Тогда
					СоответствиеЭталоновДанных.Вставить(ПодчиненныйОбъект.Ссылка,КопияВСтруктуре);
				КонецЕсли;
			КонецЕсли;		
			
			ПодчиненныйОбъект.ДополнительныеСвойства.Вставить("ПараметрыАвтоиерархии", Новый Структура("НовыйКодРодителя", Источник.Код));
			Если СтандартноеПоведение Тогда
				
				Попытка
					ПодчиненныйОбъект.Записать();
				Исключение
					ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не удалось переопределить группу у дочерних элементов для элемента-родителя %1'"),
					Источник[РеквизитКода]),
					Источник,,,
					Отмена);
					Прервать;
				КонецПопытки;
			Иначе
				Отмена = Ложь;
				ПодчиненныйОбъект.ОбменДанными.Загрузка = Истина;
				
				Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ПодчиненныйОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
				Если НЕ Отмена Тогда
					ПодчиненныйОбъект.Записать();
					Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ПодчиненныйОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
				КонецЕсли;
				Если Отмена Тогда
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось переопределить группу у дочерних элементов для элемента-родителя %1'"),Источник[РеквизитКода]);	
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Источник.Ссылка,ТекстОшибки);
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось переопределить родителя %1 для дочернего элемента %2'"),Источник[РеквизитКода],ПодчиненныйОбъект[РеквизитКода]);	
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ПодчиненныйОбъект.Ссылка,ТекстОшибки);
				Иначе
					Если НужноЗаполнятьТаблицуАктуализации И ТипОбъекта = Тип("СправочникОбъект.ЦелевыеСтатьиКРБ") Тогда
						БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ПодчиненныйОбъект,СоответствиеАктуализации);
					КонецЕсли;
				КонецЕсли; 
				Отмена = Ложь;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ЭтоНовый() ИЛИ КодИзменен Тогда
		
		СтруктураКода = БюджетнаяКлассификация.ПолучитьСтруктуруКодаКлассификатора(МетаданныеСправочника.ПолноеИмя());
		
		Если ЭтоСправочникЦС И Источник.ДатаНачалаДействия < Дата(2016, 1, 1) Тогда
			ДлинаКода = 3;
			ВсегоУровней = 2;
		Иначе
			ДлинаКода = МетаданныеСправочника.ДлинаКода;
			ВсегоУровней = СтруктураКода.Количество();
		КонецЕсли;
		
		Суффикс = "";
		Маска = "";
		Для Н = - (ВсегоУровней - 1) По 0 Цикл
			ОписаниеУровня = СтруктураКода[-Н];
			Суффикс = ОписаниеУровня.ЗначениеПустойГруппы + Суффикс;
			Если Сред(Источник.Код, ОписаниеУровня.ИндексНачальногоСимвола) <> Суффикс Тогда
				Прервать;
			КонецЕсли;
			Если ЭтоСправочникЦС
				И Н = 0
				И Источник.Код = Суффикс Тогда
				//если это ЦС и код 00000, то прервемя и оставим только 00%, чтобы коды вида 000АА вошли в этот код
				Прервать;
			КонецЕсли;
			Маска = Лев(Источник.Код, ОписаниеУровня.ИндексНачальногоСимвола - 1) + "%";
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(Маска)
			И Маска <> "%" Тогда
			
			Запрос = Новый Запрос;
			
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	КОСГУ.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.КОСГУ КАК КОСГУ
			|ГДЕ
			|	КОСГУ.Код ПОДОБНО &Маска
			|	И КОСГУ.ПометкаУдаления = ЛОЖЬ
			|	И (НЕ КОСГУ.Ссылка В ИЕРАРХИИ (&Ссылка))
			|	И КОСГУ.Код = Подстрока(КОСГУ.Код,1,&ДлинаКода)";
			
			Если МетаданныеСправочника.Реквизиты.Найти("ДатаНачалаДействия") <> Неопределено Тогда		
				ТекстЗапроса = ТекстЗапроса + "
				|	И НЕ КОСГУ.ДатаОкончанияДействия <= &ДатаНачалаДействия";
				Запрос.УстановитьПараметр("ДатаНачалаДействия", Источник.ДатаНачалаДействия);
			КонецЕсли;	
			Если МетаданныеСправочника.Реквизиты.Найти("Бюджет") <> Неопределено Тогда	
				ТекстЗапроса = ТекстЗапроса + "
				|	И КОСГУ.Бюджет В ИЕРАРХИИ (&Бюджет)";
				Запрос.УстановитьПараметр("Бюджет", Источник.Бюджет);
			КонецЕсли;
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КОСГУ", МетаданныеСправочника.Имя);
			Запрос.Текст = ТекстЗапроса;
			
			Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
			Запрос.УстановитьПараметр("Маска", Маска);
			// Определяем только элементы с длиной кода как у источника
			Запрос.УстановитьПараметр("ДлинаКода", СтрДлина(СокрЛП(Источник.Код)));
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл;
				ПодчиненныйОбъект = Выборка.Получить(0).ПолучитьОбъект();
				ПодчиненныйОбъект.Заблокировать();
				
				Если НЕ СтандартноеПоведение Тогда
					КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ПодчиненныйОбъект);
					Если СоответствиеЭталоновДанных.Получить(ПодчиненныйОбъект.Ссылка) = Неопределено Тогда
						СоответствиеЭталоновДанных.Вставить(ПодчиненныйОбъект.Ссылка,КопияВСтруктуре);
					КонецЕсли;
				КонецЕсли;	
				
				ПодчиненныйОбъект.ДополнительныеСвойства.Вставить("ПараметрыАвтоиерархии", Новый Структура("НовыйРодитель", Источник.Ссылка));
				
				Если СтандартноеПоведение Тогда
					
					Попытка
						ПодчиненныйОбъект.Записать();
					Исключение
						ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Не удалось переопределить группу у дочерних элементов для элемента-родителя %1'"),
						Источник[РеквизитКода]),
						Источник,,,
						Отмена);
						Прервать;
					КонецПопытки;
					
				Иначе
					Отмена = Ложь;
					ПодчиненныйОбъект.ОбменДанными.Загрузка = Истина;
					
					Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ПодчиненныйОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
					
					Если НЕ Отмена Тогда
						ПодчиненныйОбъект.Записать();
						Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ПодчиненныйОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
					КонецЕсли;
					
					Если Отмена Тогда
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось переопределить группу у дочерних элементов для элемента-родителя %1'"),Источник[РеквизитКода]);	
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Источник.Ссылка,ТекстОшибки);
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось переопределить родителя %1 для дочернего элемента %2'"),Источник[РеквизитКода],ПодчиненныйОбъект[РеквизитКода]);	
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ПодчиненныйОбъект.Ссылка,ТекстОшибки);
						
					ИначеЕсли НужноЗаполнятьТаблицуАктуализации И ТипОбъекта = Тип("СправочникОбъект.ЦелевыеСтатьиКРБ") Тогда
						БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ПодчиненныйОбъект,СоответствиеАктуализации);
					КонецЕсли; 
					Отмена = Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ МЕХАНИЗМА КОНТРОЛЯ ПЕРИОДОВ ДЕЙСТВИЯ
//

//Обработчик подписки ЗаполнитьДатуОкончанияДействияПередЗаписью
//
Процедура ЗаполнитьДатуОкончанияДействия(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДатуОкончанияДействияЯвно(Источник, Отказ);
	
КонецПроцедуры	

// Процедура будет вызываться явно при записи объектов с признаком ОбменДанным.Загрузка = Истина
// Например, при загрузке классификации.
//
Процедура ЗаполнитьДатуОкончанияДействияЯвно(Источник, Отказ) Экспорт
	
	Если ЗначениеЗаполнено(Источник.ОкончаниеДействия) Тогда
		Источник.ДатаОкончанияДействия = Источник.ОкончаниеДействия;
	Иначе
		Источник.ДатаОкончанияДействия = Источник.Метаданные().Реквизиты.ДатаОкончанияДействия.ЗначениеЗаполнения;
	КонецЕсли;
	
КонецПроцедуры	

// Обработчик подписки ПроверитьУникальностьКодаЭлементаБюджетногоКлассификатора
//
Процедура ПроверитьУникальностьКода(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьУникальностьКодаЯвно(Источник, Отказ);
	
КонецПроцедуры

// Процедура будет вызываться явно при записи объектов с признаком ОбменДанным.Загрузка = Истина
// Например, при загрузке классификации.
//
Процедура ПроверитьУникальностьКодаЯвно(Источник, Отказ, ТаблицаОшибок = Неопределено) Экспорт
	
	МетаданныеИсточника = Источник.Метаданные();
	РеквизитКода = ?(МетаданныеИсточника.ДлинаНаименования>0,"Наименование","Код");
	ЕстьБюджет = МетаданныеИсточника.Реквизиты.Найти("Бюджет") <> Неопределено;
	
	Если НЕ ЗначениеЗаполнено(Источник.ДатаНачалаДействия) Тогда
		Если ТаблицаОшибок = Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В элементе с кодом %1 поле ""Дата начала действия"" не заполнено'"),
			Источник[РеквизитКода]),
			Источник,
			"ДатаНачалаДействия",,
			Отказ);
		Иначе
			Отказ = Истина;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В элементе с кодом %1 поле ""Дата начала действия"" не заполнено'"),Источник[РеквизитКода]);   
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Источник.Ссылка,ТекстОшибки);
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Источник.ЭтоНовый() Тогда
		РеквизитыСсылки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник.Ссылка, "Код, ОкончаниеДействия" + ?(МетаданныеИсточника.Реквизиты.Найти("Бюджет") <> Неопределено, ", Бюджет", ""));
		ИзменилсяКод                    = Источник.Код <> РеквизитыСсылки.Код;
		ИзменилосьОкончаниеДействия     = Источник.ОкончаниеДействия <> РеквизитыСсылки.ОкончаниеДействия;
		ИзменилсяБюджет                 = РеквизитыСсылки.Свойство("Бюджет") И Источник.Бюджет <> РеквизитыСсылки.Бюджет;
	Иначе
		ИзменилсяКод                    = Истина;
		ИзменилосьОкончаниеДействия     = Истина;
		ИзменилсяБюджет                 = Истина;
	КонецЕсли;
	
	Если Источник.ДатаНачалаДействия > Источник.ДатаОкончанияДействия Тогда
		
		Если ТаблицаОшибок = Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'У элемента с кодом %3 дата окончания периода действия %2 меньше даты начала %1'"),
			Формат(Источник.ДатаНачалаДействия, "ДЛФ=D"),
			Формат(Источник.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
			Источник[РеквизитКода]),
			Источник,
			?(ИзменилосьОкончаниеДействия, "ОкончаниеДействия", "ДатаНачалаДействия"),,
			Отказ);
		Иначе
			Отказ = Истина;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'У элемента с кодом %3 дата окончания периода действия %2 меньше даты начала %1'"),
			Формат(Источник.ДатаНачалаДействия, "ДЛФ=D"),
			Формат(Источник.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
			Источник[РеквизитКода]);
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Источник.Ссылка,ТекстОшибки);
		КонецЕсли;
		
	КонецЕсли;
	
	// Проверка пересечения по сроку действия с существующими элементами.
	Если НЕ Источник.ПометкаУдаления Тогда
		
		Запрос = Новый Запрос;
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ГлавыПоБюджетнойКлассификации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГлавыПоБюджетнойКлассификации КАК ГлавыПоБюджетнойКлассификации
		|ГДЕ
		|	ГлавыПоБюджетнойКлассификации.ПометкаУдаления = ЛОЖЬ
		|	И ГлавыПоБюджетнойКлассификации.Владелец = &Владелец
		|	И ГлавыПоБюджетнойКлассификации.Ссылка <> &Ссылка
		|	И ГлавыПоБюджетнойКлассификации.Бюджет = &Бюджет
		|	И ГлавыПоБюджетнойКлассификации.Код = &Код
		|	И (ГлавыПоБюджетнойКлассификации.ДатаНачалаДействия <= &ДатаОкончанияДействия
		|				И ГлавыПоБюджетнойКлассификации.ДатаОкончанияДействия >= &ДатаОкончанияДействия
		|			ИЛИ ГлавыПоБюджетнойКлассификации.ДатаОкончанияДействия >= &ДатаНачалаДействия
		|				И ГлавыПоБюджетнойКлассификации.ДатаНачалаДействия <= &ДатаНачалаДействия)";
		
		Если МетаданныеИсточника.Владельцы.Количество() = 0 Тогда
			Если ТипЗнч(Источник) = Тип("СправочникОбъект.ПрограммыЦелевыхСтатейКРБ") Тогда
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ГлавыПоБюджетнойКлассификации.Владелец = &Владелец", "И ГлавыПоБюджетнойКлассификации.ЦелеваяСтатья = &Владелец");
				Запрос.УстановитьПараметр("Владелец", Источник.ЦелеваяСтатья);
			Иначе
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ГлавыПоБюджетнойКлассификации.Владелец = &Владелец", "");
			КонецЕсли;
		Иначе
			Запрос.УстановитьПараметр("Владелец", Источник.Владелец);
		КонецЕсли;
		
		Если ЕстьБюджет Тогда
			Запрос.УстановитьПараметр("Бюджет", Источник.Бюджет);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ГлавыПоБюджетнойКлассификации.Бюджет = &Бюджет", "");
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ГлавыПоБюджетнойКлассификации", МетаданныеИсточника.Имя);
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
		Запрос.УстановитьПараметр("Код",    Источник.Код);
		Запрос.УстановитьПараметр("ДатаОкончанияДействия", Источник.ДатаОкончанияДействия);
		Запрос.УстановитьПараметр("ДатаНачалаДействия",    Источник.ДатаНачалаДействия);
		
		УстановитьПривилегированныйРежим(Истина);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		УстановитьПривилегированныйРежим(Ложь);
		
		КоличествоКонфликтных = РезультатЗапроса.Количество();
		
		Если РезультатЗапроса.Следующий() Тогда
			
			Если КоличествоКонфликтных > 1 ИЛИ Источник.ЭтоНовый() Тогда //ничего нельзя сделать, не обрабатываем
				
				Если ЕстьБюджет Тогда
					Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%3 на период %1-%2 в бюджете «%4» уже существует'"),
					Формат(Источник.ДатаНачалаДействия, "ДЛФ=D"),
					Формат(Источник.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
					Источник[РеквизитКода]+" ("+БюджетнаяКлассификация.ПредставлениеСправочникаБюджетногоКлассификатора(Источник.Ссылка)+")",
					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Бюджет, "Наименование"));
				Иначе
					Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%3 на период %1-%2 уже существует'"),
					Формат(Источник.ДатаНачалаДействия, "ДЛФ=D"),
					Формат(Источник.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
					Источник[РеквизитКода]+" ("+БюджетнаяКлассификация.ПредставлениеСправочникаБюджетногоКлассификатора(Источник.Ссылка)+")");
				КонецЕсли;
				Если ТаблицаОшибок = Неопределено Тогда
					ОбщегоНазначения.СообщитьПользователю(
					Сообщение,
					Источник,
					?(ИзменилсяКод, "Код", ?(ИзменилсяБюджет, "Бюджет", ?(ИзменилосьОкончаниеДействия, "ОкончаниеДействия", "ДатаНачалаДействия"))),,
					Отказ);
				Иначе
					Отказ = Истина;				
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Источник.Ссылка,Сообщение);
				КонецЕсли;
				
			Иначе // Попробуем записать изменения 
				
				РезультатЗапросаОбъект = РезультатЗапроса.Ссылка.ПолучитьОбъект();
				
				Если РезультатЗапросаОбъект.ДатаНачалаДействия <= Источник.ДатаНачалаДействия
					И РезультатЗапросаОбъект.ДатаОкончанияДействия >= Источник.ДатаОкончанияДействия Тогда
					// Элемент был изменен вручную и обнаружили конфликт - значит отказ
					Если ЕстьБюджет Тогда
						Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%3 на период %1-%2 в бюджете «%4» уже существует'"),
						Формат(Источник.ДатаНачалаДействия, "ДЛФ=D"),
						Формат(Источник.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
						Источник[РеквизитКода]+" ("+БюджетнаяКлассификация.ПредставлениеСправочникаБюджетногоКлассификатора(Источник.Ссылка)+")",
						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Бюджет, "Наименование"));
					Иначе
						Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%3 на период %1-%2 уже существует'"),
						Формат(Источник.ДатаНачалаДействия, "ДЛФ=D"),
						Формат(Источник.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
						Источник[РеквизитКода]+" ("+БюджетнаяКлассификация.ПредставлениеСправочникаБюджетногоКлассификатора(Источник.Ссылка)+")");
					КонецЕсли;
					Если ТаблицаОшибок=Неопределено Тогда
						ОбщегоНазначения.СообщитьПользователю(
						Сообщение,
						Источник,
						?(ИзменилсяКод, "Код", ?(ИзменилсяБюджет, "Бюджет", ?(ИзменилосьОкончаниеДействия, "ОкончаниеДействия", "ДатаНачалаДействия"))),,
						Отказ);
					Иначе
						Отказ = Истина;				
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Источник.Ссылка,Сообщение);
					КонецЕсли;
					
				ИначеЕсли РезультатЗапросаОбъект.ДатаНачалаДействия > Источник.ДатаНачалаДействия
					И РезультатЗапросаОбъект.ДатаОкончанияДействия >= Источник.ДатаОкончанияДействия Тогда
					// Период действия нового начинается раньше старого и заканчивается внутри периода действия старого
					// переносим окончание действия нового на начало действия старого
					Источник.ДатаОкончанияДействия = НачалоДня(РезультатЗапросаОбъект.ДатаНачалаДействия) - 1;
					Источник.ОкончаниеДействия =  Источник.ДатаОкончанияДействия;
					
				ИначеЕсли РезультатЗапросаОбъект.ДатаНачалаДействия <= Источник.ДатаНачалаДействия
					И РезультатЗапросаОбъект.ДатаОкончанияДействия < Источник.ДатаОкончанияДействия Тогда
					// Период действия нового начинается внутри старого и заканчивается позже старого
					// переносим начало действия нового на окончание действия старого
					Источник.ДатаНачалаДействия = КонецДня(РезультатЗапросаОбъект.ДатаОкончанияДействия) + 1;
					
				Иначе
					Если ЕстьБюджет Тогда
						Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%3 на период %1-%2 в бюджете «%4» уже существует'"),
						Формат(Источник.ДатаНачалаДействия, "ДЛФ=D"),
						Формат(Источник.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
						Источник[РеквизитКода]+" ("+БюджетнаяКлассификация.ПредставлениеСправочникаБюджетногоКлассификатора(Источник.Ссылка)+")",
						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Бюджет, "Наименование"));
					Иначе
						Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%3 на период %1-%2 уже существует'"),
						Формат(Источник.ДатаНачалаДействия, "ДЛФ=D"),
						Формат(Источник.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
						Источник[РеквизитКода]+" ("+БюджетнаяКлассификация.ПредставлениеСправочникаБюджетногоКлассификатора(Источник.Ссылка)+")");
					КонецЕсли;
					Если ТаблицаОшибок=Неопределено Тогда
						ОбщегоНазначения.СообщитьПользователю(
						Сообщение,
						Источник,
						?(ИзменилсяКод, "Код", ?(ИзменилсяБюджет, "Бюджет", ?(ИзменилосьОкончаниеДействия, "ОкончаниеДействия", "ДатаНачалаДействия"))),,
						Отказ);
					Иначе
						Отказ = Истина;				
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Источник.Ссылка,Сообщение);
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик подписки УправлениеПериодомДействияПодчиненныхЭлементовБюджетногоКлассификатора
//
Процедура УправлениеПериодомДействияПодчиненныхЭлементов(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	УправлениеПериодомДействияПодчиненныхЭлементовЯвно(Источник, Отказ);
	
КонецПроцедуры

// Процедура будет вызываться явно при записи объектов с признаком ОбменДанным.Загрузка = Истина
// Например, при загрузке классификации.
//
Процедура УправлениеПериодомДействияПодчиненныхЭлементовЯвно(Источник, Отказ, СтандартноеПоведение = Истина, ТаблицаОшибок = Неопределено,СоответствиеЭталоновДанных = Неопределено,СоответствиеАктуализации=Неопределено,НужноЗаполнятьТаблицуАктуализации=Ложь) Экспорт
	
	МетаданныеИсточника = Источник.Метаданные();
	РеквизитКода = ?(МетаданныеИсточника.ДлинаНаименования>0,"Наименование","Код");
	ТипОбъекта = ТипЗнч(Источник);
	
	Если МетаданныеИсточника.Иерархический Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	СтатьиКИФ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтатьиКИФ КАК СтатьиКИФ
		|ГДЕ
		|	СтатьиКИФ.Родитель = &Ссылка
		|	И (НЕ СтатьиКИФ.ПометкаУдаления)
		|	И (СтатьиКИФ.ДатаНачалаДействия < &ДатаНачалаДействия
		|			ИЛИ СтатьиКИФ.ДатаОкончанияДействия > &ДатаОкончанияДействия)";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СтатьиКИФ", МетаданныеИсточника.Имя);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
		Запрос.УстановитьПараметр("ДатаНачалаДействия", Источник.ДатаНачалаДействия);
		Запрос.УстановитьПараметр("ДатаОкончанияДействия", Источник.ДатаОкончанияДействия);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ПодчиненныйОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ПодчиненныйОбъект.Заблокировать();
			
			Если НЕ СтандартноеПоведение Тогда
				КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ПодчиненныйОбъект);
				Если СоответствиеЭталоновДанных.Получить(ПодчиненныйОбъект.Ссылка) = Неопределено Тогда
					СоответствиеЭталоновДанных.Вставить(ПодчиненныйОбъект.Ссылка,КопияВСтруктуре);
				КонецЕсли;
			КонецЕсли;
			
			Если ПодчиненныйОбъект.ДатаНачалаДействия <= Источник.ДатаОкончанияДействия
				И ПодчиненныйОбъект.ДатаОкончанияДействия >= Источник.ДатаНачалаДействия Тогда // периоды пересекаются
				
				Если ПодчиненныйОбъект.ДатаНачалаДействия < Источник.ДатаНачалаДействия Тогда
					ПодчиненныйОбъект.ДатаНачалаДействия = Источник.ДатаНачалаДействия;
				КонецЕсли;
				Если ПодчиненныйОбъект.ДатаОкончанияДействия > Источник.ДатаОкончанияДействия Тогда
					ПодчиненныйОбъект.ОкончаниеДействия = Источник.ОкончаниеДействия;
				КонецЕсли;
				
			Иначе // периоды не пересекаются
				
				ПодчиненныйОбъект.ДатаНачалаДействия = Источник.ДатаНачалаДействия;
				ПодчиненныйОбъект.ОкончаниеДействия  = Источник.ОкончаниеДействия
				
			КонецЕсли;
			Если СтандартноеПоведение Тогда
				Попытка
					ПодчиненныйОбъект.Записать();
				Исключение
					Если ТипОбъекта = Тип("СправочникОбъект.СтатьиПодстатьиКДБ") Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия подстатей элемента %1'"),Источник[РеквизитКода]);
					ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.СтатьиКИФ") Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия подстатей элемента %1'"),Источник[РеквизитКода]);
					Иначе
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия действия дочерних элементов для элемента %1'"),Источник[РеквизитКода]);
					КонецЕсли;
					
					ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ТекстСообщения,
					БюджетнаяКлассификация.ПредставлениеЭлементаБюджетногоКлассификатора(Источник)),
					Источник,,,
					Отказ);
					Прервать;
				КонецПопытки;
			Иначе
				Отказ = Ложь;
				ПодчиненныйОбъект.ОбменДанными.Загрузка = Истина;				
				Отказ = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ПодчиненныйОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
				
				Если НЕ Отказ Тогда
					ПодчиненныйОбъект.Записать();
					Отказ = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ПодчиненныйОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
				КонецЕсли;
				
				Если Отказ Тогда
					Если ТипОбъекта = Тип("СправочникОбъект.СтатьиПодстатьиКДБ") Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия подстатей элемента %1'"),Источник[РеквизитКода]);
						ТекстСообщенияПодч = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия подстатьи %1'"),ПодчиненныйОбъект[РеквизитКода]);
					ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.СтатьиКИФ") Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия подстатей элемента  %1'"),Источник[РеквизитКода]);
						ТекстСообщенияПодч = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия подстатьи %1'"),ПодчиненныйОбъект[РеквизитКода]);
					Иначе
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия дочерних элементов для элемента %1'"),Источник[РеквизитКода]);
						ТекстСообщенияПодч = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия дочернего элемента %1'"),ПодчиненныйОбъект[РеквизитКода]);
					КонецЕсли;
					
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Источник.Ссылка,ТекстСообщения);				
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ПодчиненныйОбъект.Ссылка,ТекстСообщенияПодч);
				ИначеЕсли НужноЗаполнятьТаблицуАктуализации Тогда
					БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ПодчиненныйОбъект,СоответствиеАктуализации);
				КонецЕсли; 
				Отказ = Ложь;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка охвата сроком действия периодов действия подчиненных элементов.
	Если ТипОбъекта = Тип("СправочникОбъект.ЦелевыеСтатьиКРБ") Тогда  
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ПрограммыЦелевыхСтатейКРБ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПрограммыЦелевыхСтатейКРБ КАК ПрограммыЦелевыхСтатейКРБ
		|ГДЕ
		|	ПрограммыЦелевыхСтатейКРБ.ЦелеваяСтатья = &Ссылка
		|	И ПрограммыЦелевыхСтатейКРБ.ПометкаУдаления = ЛОЖЬ
		|	И (ПрограммыЦелевыхСтатейКРБ.ДатаНачалаДействия < &ДатаНачалаДействия
		|			ИЛИ ПрограммыЦелевыхСтатейКРБ.ДатаОкончанияДействия > &ДатаОкончанияДействия)";   
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
		Запрос.УстановитьПараметр("ДатаОкончанияДействия", Источник.ДатаОкончанияДействия);
		Запрос.УстановитьПараметр("ДатаНачалаДействия",    Источник.ДатаНачалаДействия);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ПодчиненныйОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ПодчиненныйОбъект.Заблокировать();
			
			Если НЕ СтандартноеПоведение Тогда
				КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ПодчиненныйОбъект);
				Если СоответствиеЭталоновДанных.Получить(ПодчиненныйОбъект.Ссылка) = Неопределено Тогда
					СоответствиеЭталоновДанных.Вставить(ПодчиненныйОбъект.Ссылка,КопияВСтруктуре);
				КонецЕсли;
			КонецЕсли;
			
			Если ПодчиненныйОбъект.ДатаНачалаДействия <= Источник.ДатаОкончанияДействия
				И ПодчиненныйОбъект.ДатаОкончанияДействия >= Источник.ДатаНачалаДействия Тогда // периоды пересекаются
				
				Если ПодчиненныйОбъект.ДатаНачалаДействия < Источник.ДатаНачалаДействия Тогда
					ПодчиненныйОбъект.ДатаНачалаДействия = Источник.ДатаНачалаДействия;
				КонецЕсли;
				Если ПодчиненныйОбъект.ДатаОкончанияДействия > Источник.ДатаОкончанияДействия Тогда
					ПодчиненныйОбъект.ОкончаниеДействия = Источник.ОкончаниеДействия;
				КонецЕсли;
				
			Иначе // периоды не пересекаются
				
				ПодчиненныйОбъект.ДатаНачалаДействия = Источник.ДатаНачалаДействия;
				ПодчиненныйОбъект.ОкончаниеДействия  = Источник.ОкончаниеДействия
				
			КонецЕсли;
			Если СтандартноеПоведение Тогда
				
				Попытка
					ПодчиненныйОбъект.Записать();
				Исключение
					
					Если ТипОбъекта = Тип("СправочникОбъект.ЦелевыеСтатьиКРБ") Тогда
						ТекстСообщения = НСтр("ru = 'Не удалось изменить период действия программ целевой статьи'");  
						
					ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ПрограммыЦелевыхСтатейКРБ") Тогда
						ТекстСообщения = НСтр("ru = 'Не удалось изменить период действия подпрограмм программы целевой статьи'");
					Иначе
						ТекстСообщения = НСтр("ru = 'Не удалось изменить период действия подчиненных элементов'");
					КонецЕсли;
					
					ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ТекстСообщения,
					БюджетнаяКлассификация.ПредставлениеЭлементаБюджетногоКлассификатора(Источник)),
					Источник,,,
					Отказ);
					Прервать;
				КонецПопытки
			Иначе
				Отказ = Ложь;
				ПодчиненныйОбъект.ОбменДанными.Загрузка = Истина;
				
				Отказ = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ПодчиненныйОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
				
				Если НЕ Отказ Тогда
					ПодчиненныйОбъект.Записать();
					Отказ = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ПодчиненныйОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
				КонецЕсли;
				
				Если Отказ Тогда
					
					Если ТипОбъекта = Тип("СправочникОбъект.ЦелевыеСтатьиКРБ") Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия направлений расходов целевой статьи %1'"), Источник[РеквизитКода]);
						ТекстСообщенияПодч = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия направления расходов %1 целевой статьи %2'"), ПодчиненныйОбъект[РеквизитКода], Источник[РеквизитКода]);			
					Иначе
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия подчиненных элементов элемента %1'"),Источник[РеквизитКода]);
						ТекстСообщенияПодч = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить период действия подчиненного элемента %1 для элемента-владельца %2'"),ПодчиненныйОбъект[РеквизитКода],Источник[РеквизитКода]);
					КонецЕсли;
					
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Источник.Ссылка,ТекстСообщения);
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ПодчиненныйОбъект.Ссылка,ТекстСообщенияПодч);
				ИначеЕсли НужноЗаполнятьТаблицуАктуализации Тогда
					БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ПодчиненныйОбъект,СоответствиеАктуализации);	
				КонецЕсли; 
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

