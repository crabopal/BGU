////////////////////////////////////////////////////////////////////////////////
// Справочник ЦелевыеСтатьиКРБ

Процедура ПередЗаписьюЦелевыхСтатейКРБ(ТекОбъект, Отказ) Экспорт
	
	ТекОбъект.ДополнительныеСвойства.Вставить("ПометкаУдаленияИзменена", ТекОбъект.Ссылка.ПометкаУдаления <> ТекОбъект.ПометкаУдаления);	
	
КонецПроцедуры

Процедура ПриЗаписиЦелевыхСтатейКРБ(ТекОбъект, Отмена, СтандартноеПоведение = Истина, ТаблицаОшибок = Неопределено, СоответствиеЭталоновДанных = Неопределено,СоответствиеАктуализации = Неопределено, НужноЗаполнятьТаблицуАктуализации=Ложь) Экспорт
	
	Если ТекОбъект.ДополнительныеСвойства.ПометкаУдаленияИзменена Тогда
				
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрограммыЦелевыхСтатейКРБ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПрограммыЦелевыхСтатейКРБ КАК ПрограммыЦелевыхСтатейКРБ
		|ГДЕ
		|	ПрограммыЦелевыхСтатейКРБ.ЦелеваяСтатья = &ЦелеваяСтатья
		|	И ПрограммыЦелевыхСтатейКРБ.ПометкаУдаления <> &ПометкаУдаления");
		Запрос.УстановитьПараметр("ЦелеваяСтатья", ТекОбъект.Ссылка);
		Запрос.УстановитьПараметр("ПометкаУдаления", ТекОбъект.ПометкаУдаления);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировки = БлокировкаДанных.Добавить("Справочник.ПрограммыЦелевыхСтатейКРБ");
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
		БлокировкаДанных.Заблокировать();

		Программы = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку(0);
				
		Если НЕ Отмена Тогда
			Для каждого ЭлементСсылка Из Программы Цикл
				
				ЭлементОбъект = ЭлементСсылка.ПолучитьОбъект();
				ЭлементОбъект.Заблокировать();
				
				Если НЕ СтандартноеПоведение Тогда
					КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ЭлементОбъект);
					Если СоответствиеЭталоновДанных.Получить(ЭлементОбъект.Ссылка) = Неопределено Тогда
						СоответствиеЭталоновДанных.Вставить(ЭлементОбъект.Ссылка,КопияВСтруктуре);
					КонецЕсли;
				КонецЕсли;
				
				ЭлементОбъект.ПометкаУдаления = ТекОбъект.ПометкаУдаления;
				
				Если СтандартноеПоведение Тогда
					
					Попытка
						ЭлементОбъект.Записать();
					Исключение
						ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Не удалось изменить пометку удаления у программы %2 целевой статьи %1'"),ТекОбъект.Наименование,ЭлементОбъект.Наименование),
						ТекОбъект,,,
						Отмена);
						Прервать;
					КонецПопытки;
					
				Иначе
					ЭлементОбъект.ОбменДанными.Загрузка = Истина;
					Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
					
					Если НЕ Отмена Тогда
						ЭлементОбъект.Записать();
						Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
					КонецЕсли;
					
					Если Отмена Тогда
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить пометку удаления у программы %2 целевой статьи %1'"),ТекОбъект.Наименование,ЭлементОбъект.Наименование);	
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить пометку удаления у целевой статьи %1'"),ТекОбъект.Наименование);		
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ТекОбъект.Ссылка,ТекстОшибки);
					ИначеЕсли НужноЗаполнятьТаблицуАктуализации Тогда
						БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ЭлементОбъект,СоответствиеАктуализации);	
					КонецЕсли; 
					Отмена = Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Справочник ВидыДоходовКДБ

Процедура ПередЗаписьюВидыДоходовКДБ(ТекОбъект, Отказ) Экспорт
	
	ТекОбъект.ДополнительныеСвойства.Вставить("ПометкаУдаленияИзменена", ТекОбъект.Ссылка.ПометкаУдаления <> ТекОбъект.ПометкаУдаления);	
	
	БюджетнаяКлассификацияПереопределяемый.ПередЗаписьюВидыДоходовКДБ(ТекОбъект,Отказ);
	
КонецПроцедуры

Процедура ПриЗаписиВидыДоходовКДБ(ТекОбъект, Отмена, СтандартноеПоведение = Истина, ТаблицаОшибок = Неопределено, СоответствиеЭталоновДанных = Неопределено, СоответствиеАктуализации = Неопределено, НужноЗаполнятьТаблицуАктуализации=Ложь) Экспорт
	
	Если ТекОбъект.ДополнительныеСвойства.ПометкаУдаленияИзменена Тогда

		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГруппыПодвидовКДБ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГруппыПодвидовКДБ КАК ГруппыПодвидовКДБ
		|ГДЕ
		|	ГруппыПодвидовКДБ.ВидДохода = &ВидДохода
		|	И ГруппыПодвидовКДБ.ПометкаУдаления <> &ПометкаУдаления");
		
		Запрос.УстановитьПараметр("ВидДохода", 			ТекОбъект.Ссылка);
		Запрос.УстановитьПараметр("ПометкаУдаления", 	ТекОбъект.ПометкаУдаления);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировки 					= БлокировкаДанных.Добавить("Справочник.ГруппыПодвидовКДБ");
		ЭлементБлокировки.ИсточникДанных 	= РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка"); 
		БлокировкаДанных.Заблокировать();
		
		ГруппыПодвидов = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку(0);
				
		Если НЕ Отмена Тогда
			Для каждого ЭлементСсылка Из ГруппыПодвидов Цикл
				
				ЭлементОбъект = ЭлементСсылка.ПолучитьОбъект();
				ЭлементОбъект.Заблокировать();
				
				Если НЕ СтандартноеПоведение Тогда
					КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ЭлементОбъект);
					Если СоответствиеЭталоновДанных.Получить(ЭлементОбъект.Ссылка) = Неопределено Тогда
						СоответствиеЭталоновДанных.Вставить(ЭлементОбъект.Ссылка, КопияВСтруктуре);
					КонецЕсли;
				КонецЕсли;
				
				ЭлементОбъект.ПометкаУдаления = ТекОбъект.ПометкаУдаления;
				
				Если СтандартноеПоведение Тогда
					
					Попытка
						ЭлементОбъект.Записать();
					Исключение
						ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Не удалось изменить пометку удаления у группы подвида %2 вида дохода %1'"), ТекОбъект.Наименование, ЭлементОбъект.Наименование),
						ТекОбъект,,,
						Отмена);
						Прервать;
					КонецПопытки;
					
				Иначе
					Отмена = Ложь;
					ЭлементОбъект.ОбменДанными.Загрузка = Истина;
					
					Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект, ТаблицаОшибок, СоответствиеЭталоновДанных, СоответствиеАктуализации, НужноЗаполнятьТаблицуАктуализации);
					
					Если НЕ Отмена Тогда
						ЭлементОбъект.Записать();
						Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект, ТаблицаОшибок, СоответствиеЭталоновДанных, СоответствиеАктуализации, НужноЗаполнятьТаблицуАктуализации);
					КонецЕсли;
					
					Если Отмена Тогда
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить пометку удаления у группы подвида %2 вида дохода %1'"), ТекОбъект.Наименование, ЭлементОбъект.Наименование);	
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок, ЭлементОбъект.Ссылка, ТекстОшибки);
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить пометку удаления у вида дохода %1'"),ТекОбъект.Наименование);		
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок, ТекОбъект.Ссылка, ТекстОшибки);
					КонецЕсли; 
					
					Отмена = Ложь;
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	БюджетнаяКлассификацияПереопределяемый.ПриЗаписиВидыДоходовКДБ(ТекОбъект, Отмена, СтандартноеПоведение, ТаблицаОшибок, СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
	
КонецПроцедуры

Процедура ПередУдалениемВидыДоходовКДБ(ТекОбъект, Отказ) Экспорт
	
	БюджетнаяКлассификацияПереопределяемый.ПередУдалениемВидыДоходовКДБ(ТекОбъект, Отказ);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Справочник ПриказыОБК

Процедура ПередЗаписьюПриказыОБК(ТекОбъект,Отказ) Экспорт
	
	Если НЕ ТекОбъект.ЭтоНовый() И ТекОбъект.ДатаНачала <> ТекОбъект.Ссылка.ДатаНачала Тогда
		
		Запрос = Новый Запрос;
		Если ТекОбъект.ДатаНачала > ТекОбъект.Ссылка.ДатаНачала Тогда
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	МАКСИМУМ(ПриказыОБК.ДатаНачала) КАК ДатаНачала
			|ПОМЕСТИТЬ ТаблицаПриказов
			|ИЗ
			|	Справочник.ПриказыОБК КАК ПриказыОБК
			|ГДЕ
			|	ПриказыОБК.ДатаНачала < &ДатаНачала
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ПриказыОБК.Ссылка
			|ИЗ
			|	Справочник.ПриказыОБК КАК ПриказыОБК
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПриказов КАК ТаблицаПриказов
			|		ПО ПриказыОБК.ДатаНачала = ТаблицаПриказов.ДатаНачала";
		Иначе
			ТекстЗапроса =
			"ВЫБРАТЬ
			|	МИНИМУМ(ПриказыОБК.ДатаНачала) КАК ДатаНачала
			|ПОМЕСТИТЬ ТаблицаПриказов
			|ИЗ
			|	Справочник.ПриказыОБК КАК ПриказыОБК
			|ГДЕ
			|	ПриказыОБК.ДатаНачала > &ДатаНачала
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ПриказыОБК.Ссылка
			|ИЗ
			|	Справочник.ПриказыОБК КАК ПриказыОБК
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПриказов КАК ТаблицаПриказов
			|		ПО ПриказыОБК.ДатаНачала = ТаблицаПриказов.ДатаНачала";
		КонецЕсли;
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДатаНачала", ТекОбъект.ДатаНачала);
		
		Приказ = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
		Если НЕ ЗначениеЗаполнено(Приказ) ИЛИ Приказ[0] <> ТекОбъект.Ссылка Тогда
			ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Дата приказа не может быть установлена раньше даты предыдущего приказа или позже даты следующего.'"),
			ТекОбъект,
			"ДатаНачала");
			Возврат;
		КонецЕсли;
		
		ТекОбъект.ДополнительныеСвойства.Вставить("ПредыдущаяДатаНачала", ТекОбъект.Ссылка.ДатаНачала);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписиПриказыОБК(ТекОбъект,Отказ) Экспорт
	
	Перем ПредыдущаяДатаНачала;
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	Если ТекОбъект.ДополнительныеСвойства.Свойство("ПредыдущаяДатаНачала", ПредыдущаяДатаНачала) Тогда
		
		ОбъектыМетаданных = Новый Массив;
		ОбъектыМетаданных.Добавить(Метаданные.Справочники.ГлавыПоБюджетнойКлассификации);
		ОбъектыМетаданных.Добавить(Метаданные.Справочники.СтатьиПодстатьиКДБ);
		ОбъектыМетаданных.Добавить(Метаданные.Справочники.СтатьиКИФ);
		ОбъектыМетаданных.Добавить(Метаданные.Справочники.ЦелевыеСтатьиКРБ);
		ОбъектыМетаданных.Добавить(Метаданные.Справочники.ПрограммыЦелевыхСтатейКРБ);
		ОбъектыМетаданных.Добавить(Метаданные.Справочники.ВидыРасходовКРБ);
		
		Если ТекОбъект.ДатаНачала < ПредыдущаяДатаНачала Тогда // сначала нужно укоротить коды по предыдущему приказу, потом удлинить по новому
			
			// Укорачиваем период действия кодов по предыдущему приказу.
			ОбновитьКлассификаторы(ОбъектыМетаданных,
			Новый Структура("ДатаОкончанияДействия", ПредыдущаяДатаНачала - 86400),
			Новый Структура("ОкончаниеДействия", ТекОбъект.ДатаНачала - 86400),
			НаправлениеСортировки.Убыв);
			// Увеличиваем период действия кодов по текущему приказу.
			ОбновитьКлассификаторы(ОбъектыМетаданных,
			Новый Структура("ДатаНачалаДействия", ПредыдущаяДатаНачала),
			Новый Структура("ДатаНачалаДействия", ТекОбъект.ДатаНачала),
			НаправлениеСортировки.Возр);
			
		Иначе // сначала нужно укоротить коды по нашему приказу, потом удлинить по предыдущему
			
			// Укорачиваем период действия кодов по текущему приказу.
			ОбновитьКлассификаторы(ОбъектыМетаданных,
			Новый Структура("ДатаНачалаДействия", ПредыдущаяДатаНачала),
			Новый Структура("ДатаНачалаДействия", ТекОбъект.ДатаНачала),
			НаправлениеСортировки.Убыв);
			
			// Увеличиваем период действия кодов по предыдущему приказу.
			ОбновитьКлассификаторы(ОбъектыМетаданных,
			Новый Структура("ДатаОкончанияДействия", ПредыдущаяДатаНачала - 86400),
			Новый Структура("ОкончаниеДействия", ТекОбъект.ДатаНачала - 86400),
			НаправлениеСортировки.Возр);
			
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОпределитьРодителяСправочникаСАвтоиерархией(Источник, НовыйКодРодителя = Неопределено)
	
	МетаданныеСправочника = Источник.Метаданные();
	
	ЭтоСправочникЦС = (МетаданныеСправочника.Имя = "ЦелевыеСтатьиКРБ");
	
	Если ЭтоСправочникЦС И Источник.ДатаНачалаДействия < Дата(2014, 1, 1) Тогда
		Возврат;
	КонецЕсли;	
	
	СтруктураКода = БюджетнаяКлассификация.ПолучитьСтруктуруКодаКлассификатора(МетаданныеСправочника.ПолноеИмя());
	
	Если ЭтоСправочникЦС И Источник.ДатаНачалаДействия < Дата(2016, 1, 1) Тогда
		ДлинаКода = 3;
		ВсегоУровней = 2;
	Иначе
		ДлинаКода = МетаданныеСправочника.ДлинаКода;
		ВсегоУровней = СтруктураКода.Количество();
	КонецЕсли;
	
	
	ТаблицаПодходящихКодов = Новый ТаблицаЗначений;
	ТаблицаПодходящихКодов.Колонки.Добавить("Код", 			Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(ДлинаКода)));
	ТаблицаПодходящихКодов.Колонки.Добавить("Приоритет", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2)));
	
	Суффикс = "";
	Для Н = - (ВсегоУровней - 1) По 0 Цикл
		ОписаниеУровня = СтруктураКода[-Н];
		Суффикс = ОписаниеУровня.ЗначениеПустойГруппы + Суффикс;
		Если Сред(Источник.Код, ОписаниеУровня.ИндексНачальногоСимвола) = Суффикс Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоСправочникЦС
			И Н = 0
			И НЕ СтрНачинаетсяС(Источник.Код,"00")
			И Сред(Источник.Код,3,3) = "000" Тогда
			//для целевых статей, если это код вида хх 0 00, то не будем искать родителя, т.к. это код первого уровня
			Продолжить;
		КонецЕсли;
		ПотенциальныйКодРодителя = Лев(Источник.Код, ОписаниеУровня.ИндексНачальногоСимвола - 1) + Суффикс;
		Если ПотенциальныйКодРодителя = НовыйКодРодителя Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицыПодходящихКодов = ТаблицаПодходящихКодов.Добавить();
		СтрокаТаблицыПодходящихКодов.Код       = ПотенциальныйКодРодителя;
		СтрокаТаблицыПодходящихКодов.Приоритет = ТаблицаПодходящихКодов.Количество();
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаПодходящихКодов.Код,
	|	ТаблицаПодходящихКодов.Приоритет
	|ПОМЕСТИТЬ ТаблицаПодходящихКодов
	|ИЗ
	|	&ТаблицаПодходящихКодов КАК ТаблицаПодходящихКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	СпрБК.Ссылка,
	|	&ПолеПорядка КАК ПолеПорядка
	|ИЗ
	|	Справочник.КОСГУ КАК СпрБК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПодходящихКодов КАК ТаблицаПодходящихКодов
	|		ПО СпрБК.Код = ТаблицаПодходящихКодов.Код
	|ГДЕ
	|	СпрБК.ПометкаУдаления = ЛОЖЬ
	|	И НЕ СпрБК.Ссылка = &Ссылка";
	
	
	Если МетаданныеСправочника.Реквизиты.Найти("ДатаНачалаДействия") <> Неопределено Тогда		
		ТекстЗапроса = ТекстЗапроса + "
		|	И СпрБК.ДатаНачалаДействия <= &ДатаНачалаДействия		
		|	И СпрБК.ДатаОкончанияДействия >= &ДатаОкончанияДействия";
		Запрос.УстановитьПараметр("ДатаНачалаДействия", Источник.ДатаНачалаДействия);
		Запрос.УстановитьПараметр("ДатаОкончанияДействия", Источник.ДатаОкончанияДействия);
	КонецЕсли;	
	
	ПолеПорядка = "1";
	
	Если МетаданныеСправочника.Реквизиты.Найти("Бюджет") <> Неопределено Тогда	
		ФедеральныйБюджет = Справочники.Бюджеты.ФедеральныйБюджет;
		СтруктураПараметров = ПолучитьПорядокБюджетовДляЗапроса(Источник.Бюджет, ФедеральныйБюджет);
		
		Для Каждого КлючИЗначение Из СтруктураПараметров.СтруктураБюджетов Цикл
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ,КлючИЗначение.Значение);	
		КонецЦикла;
		
		ПолеПорядка = СтруктураПараметров.ПолеПорядка;							  
		
		ТекстЗапроса = ТекстЗапроса + "
		|	И СпрБК.Бюджет В (&МассивВсеБюджеты)";
		
		Запрос.УстановитьПараметр("МассивВсеБюджеты", СтруктураПараметров.МассивВсеБюджеты);
		
		Если НЕ ЗначениеЗаполнено(ПолеПорядка) Тогда
			ПолеПорядка = "1";
		КонецЕсли;
	КонецЕсли;	
	
	ТекстЗапроса = ТекстЗапроса + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПолеПорядка,
	|	ТаблицаПодходящихКодов.Приоритет";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КОСГУ", МетаданныеСправочника.Имя);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПорядка", ПолеПорядка);
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаПодходящихКодов", ТаблицаПодходящихКодов);
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Если ЗначениеЗаполнено(Источник.Родитель) Тогда
			Источник.Родитель = Справочники[МетаданныеСправочника.Имя].ПустаяСсылка();
		КонецЕсли;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		НовыйРодитель = Выборка.Получить(0);
		Если Источник.Родитель <> НовыйРодитель Тогда
			Источник.Родитель = НовыйРодитель;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПорядокБюджетовДляЗапроса(ТекущийБюджет,ФедеральныйБюджет)
	
	Перем ВыборкаСсылка, ЗапросБюджеты, КоличествоБюджетовВИерархии, РезультатЗапроса;
	
	МассивВсеБюджеты = Новый Массив;
	
	ЗапросБюджеты = Новый Запрос;
	ЗапросБюджеты.Текст = 
	"ВЫБРАТЬ
	|	Бюджеты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Бюджеты КАК Бюджеты
	|ГДЕ
	|	Бюджеты.Ссылка = &Ссылка
	|ИТОГИ ПО
	|	Ссылка ИЕРАРХИЯ";
	
	ЗапросБюджеты.УстановитьПараметр("Ссылка", ТекущийБюджет);
	РезультатЗапроса = ЗапросБюджеты.Выполнить();
	
	ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	КоличествоБюджетовВИерархии = ВыборкаСсылка.Количество();
	
	НуженЗапросДляФедерального = Истина;
	НомерПорядкаДляФБ = КоличествоБюджетовВИерархии + 1;
	
	ТекстПорядка = "ВЫБОР ";
	СтруктураБюджетов = Новый Структура;
	ОтборБюджет = "";
	Пока ВыборкаСсылка.Следующий() Цикл
		ТекстПорядка = ТекстПорядка + "
		|	 КОГДА СпрБК.Бюджет = &Бюджет"+КоличествоБюджетовВИерархии+" ТОГДА "+КоличествоБюджетовВИерархии;
		
		Если ВыборкаСсылка.Ссылка = ФедеральныйБюджет Тогда
			НуженЗапросДляФедерального = Ложь;
		КонецЕсли;
		
		МассивВсеБюджеты.Добавить(ВыборкаСсылка.Ссылка);
		
		СтруктураБюджетов.Вставить("Бюджет"+КоличествоБюджетовВИерархии,ВыборкаСсылка.Ссылка);
		КоличествоБюджетовВИерархии = КоличествоБюджетовВИерархии - 1;
	КонецЦикла;
	
	Если НуженЗапросДляФедерального Тогда
		
		ТекстПорядка = ТекстПорядка + "
		|	 КОГДА СпрБК.Бюджет = &ФедеральныйБюджет ТОГДА "+НомерПорядкаДляФБ;
		
		МассивВсеБюджеты.Добавить(ФедеральныйБюджет);
		СтруктураБюджетов.Вставить("ФедеральныйБюджет",ФедеральныйБюджет);
	КонецЕсли;
	
	
	ТекстПорядка = ТекстПорядка + "
	|	ИНАЧЕ 1000 КОНЕЦ";
	
	СтруктураПараметров = Новый Структура("СтруктураБюджетов,ПолеПорядка,МассивВсеБюджеты",СтруктураБюджетов,ТекстПорядка,МассивВсеБюджеты);
	
	Возврат СтруктураПараметров;
КонецФункции

// Получает значение реквизита "Полный код"
//
Функция ПолучитьПолныйКодКлассификатора(Ссылка)
	
	МетаданныеСсылки= Ссылка.Метаданные();
	ИмяТаблицы = МетаданныеСсылки.ПолноеИмя();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Спр.Наименование КАК КодПолный
	|ИЗ
	|	" + ИмяТаблицы + " КАК Спр
	|ГДЕ
	|	Спр.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.КодПолный;
	
КонецФункции // ПолучитьПолныйКодКлассификатора()

// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ - для записи справочника ПриказыОБК

Процедура ОбновитьЭлементыКлассификатора(Знач ОбъектМетаданных, Знач Отбор, Знач Изменения, Знач НаправлениеОбработки)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СтатьиКИФ.Ссылка
	|ИЗ
	|	Справочник.СтатьиКИФ КАК СтатьиКИФ";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СтатьиКИФ", ОбъектМетаданных.Имя);
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.Текст = ТекстЗапроса;
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Для каждого КлючИЗначение Из Отбор Цикл
		ПостроительЗапроса.Отбор.Добавить("Ссылка." + КлючИЗначение.Ключ).Установить(КлючИЗначение.Значение);
	КонецЦикла;
	
	Если ОбъектМетаданных.ДлинаНаименования <> 0 Тогда
		ПостроительЗапроса.Порядок.Добавить("Ссылка.Наименование",,, НаправлениеОбработки);
	Иначе
		ПостроительЗапроса.Порядок.Добавить("Ссылка.Код",,, НаправлениеОбработки);
	КонецЕсли;
	
	ПостроительЗапроса.Выполнить();
	
	Выборка = ПостроительЗапроса.Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЭлементОбъект = Выборка.Получить(0).ПолучитьОбъект();
		ЭлементОбъект.Заблокировать();
		ЗаполнитьЗначенияСвойств(ЭлементОбъект, Изменения);
		ЭлементОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьКлассификаторы(Знач ОбъектыМетаданных, Знач Отбор, Знач Изменения, Знач НаправлениеОбработки)
	
	Если НаправлениеОбработки = НаправлениеСортировки.Убыв Тогда
		
		Для Н = - ОбъектыМетаданных.ВГраница() По 0 Цикл
			ОбновитьЭлементыКлассификатора(ОбъектыМетаданных[-Н], Отбор, Изменения, НаправлениеОбработки);
		КонецЦикла;
		
	Иначе
		
		Для каждого ОбъектМетаданных Из ОбъектыМетаданных Цикл
			ОбновитьЭлементыКлассификатора(ОбъектМетаданных, Отбор, Изменения, НаправлениеОбработки);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

