
#Область ПрограммныйИнтерфейс

// Параметры распределения общих затрат.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  Дата - Дата
// 
// Возвращаемое значение:
//  Структура - Параметры распределения общих затрат:
// * РаспределятьОПЗ - Булево -
// * РаспределятьОХЗ - Булево -
// * РассчитыватьСебестоимостьВКонцеГода - Булево -
// * МетодыРаспределенияКосвенныхЗатрат - ТаблицаЗначений:
//  ** ВидОбщихЗатрат - ПеречислениеСсылка.ВидыОбщихЗатратНаПроизводство
//  ** КФО - ПеречислениеСсылка.КВД
//  ** ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//  ** БазаРаспределения - ПеречислениеСсылка.БазыРаспределенияДополнительныхРасходов
//  ** ОсновнаяБаза - Булево
//  ** ВключатьВБазуОплатаТрудаКЭК212 - Булево
//  ** ВключатьВБазуОплатаТрудаКЭК213 - Булево
//  ** ВключатьВБазуОплатаТрудаКЭК214 - Булево
Функция ПараметрыРаспределенияОбщихЗатрат(Организация, Дата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(УчетнаяПолитика.РаспределятьОПЗ, ЛОЖЬ) КАК РаспределятьОПЗ,
	|	ЕСТЬNULL(УчетнаяПолитика.РаспределятьОХЗ, ЛОЖЬ) КАК РаспределятьОХЗ,
	|	ЕСТЬNULL(УчетнаяПолитика.РассчитыватьСебестоимостьВКонцеГода, ЛОЖЬ) КАК РассчитыватьСебестоимостьВКонцеГода
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&Период, Организация = &Организация) КАК УчетнаяПолитика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МетодыРаспределения.ВидОбщихЗатратНаПроизводство КАК ВидОбщихЗатрат,
	|	МетодыРаспределения.КФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА МетодыРаспределения.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ КАК ИФО,
	|	МетодыРаспределения.БазаРаспределения,
	|	МетодыРаспределения.ОсновнаяБаза,
	|	МетодыРаспределения.ВключатьВБазуОплатаТрудаКЭК212 КАК ВключатьВБазуОплатаТрудаКЭК212,
	|	МетодыРаспределения.ВключатьВБазуОплатаТрудаКЭК213 КАК ВключатьВБазуОплатаТрудаКЭК213,
	|	МетодыРаспределения.ВключатьВБазуОплатаТрудаКЭК214 КАК ВключатьВБазуОплатаТрудаКЭК214
	|ИЗ
	|	РегистрСведений.МетодыРаспределенияКосвенныхЗатратОрганизаций.СрезПоследних(&Период, Организация = &Организация) КАК МетодыРаспределения
	|ГДЕ
	|	МетодыРаспределения.НеДействует = ЛОЖЬ";
	Запрос.УстановитьПараметр("Период", 		Новый Граница(КонецМесяца(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	СтруктураРаспределения = Новый Структура;
	СтруктураРаспределения.Вставить("РаспределятьОПЗ", Ложь);
	СтруктураРаспределения.Вставить("РаспределятьОХЗ", Ложь);
	СтруктураРаспределения.Вставить("РассчитыватьСебестоимостьВКонцеГода", Ложь);
	ДанныеУчетнойПолитики = РезультатЗапроса[0].Выбрать();
	Если ДанныеУчетнойПолитики.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураРаспределения, ДанныеУчетнойПолитики);
	КонецЕсли;
	
	СтруктураРаспределения.Вставить("МетодыРаспределенияКосвенныхЗатрат", ПустаяТаблицаМетодыРаспределенияКосвенныхЗатрат());
	ВыборкаМетодыРаспределения = РезультатЗапроса[1].Выбрать();
	Пока ВыборкаМетодыРаспределения.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СтруктураРаспределения.МетодыРаспределенияКосвенныхЗатрат.Добавить(), ВыборкаМетодыРаспределения);
	КонецЦикла;
	
	Возврат СтруктураРаспределения;

КонецФункции

Функция РассчитыватьСебестоимостьВКонцеГода(Организация, Дата) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(УчетнаяПолитика.РассчитыватьСебестоимостьВКонцеГода, ЛОЖЬ) КАК РассчитыватьСебестоимостьВКонцеГода
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&Период, Организация = &Организация) КАК УчетнаяПолитика";
	Запрос.УстановитьПараметр("Период", 		КонецМесяца(Дата));
	Запрос.УстановитьПараметр("Организация",	Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.РассчитыватьСебестоимостьВКонцеГода;
	КонецЦикла;

	Возврат Ложь;
	
КонецФункции

// Проверяет возможность проведения документа закрытия счетов с указанной датой по указанной организации
// 
// Параметры:
// 	Организация - СправочникСсылка.Организации - 
// 	ДатаДокумента - Дата -
// 	Отказ - Булево
// Возвращаемое значение:
// 	Булево - Описание
Функция ПроверитьВозможностьЗакрытияСчетовЗатрат(Организация, ДатаДокумента, Отказ = Ложь) Экспорт
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, ДатаДокумента);
	Возврат ПроверитьВозможностьЗакрытияСчетовЗатратПоУчетнойПолитике(УчетнаяПолитика, ДатаДокумента, Отказ);
КонецФункции

// Проверяет возможность проведения документа закрытия счетов с указанной датой по указанной учетной политике
// 
// Параметры:
// 	УчетнаяПолитика - Структура - см. Справочники.Организации.ПолучитьУчетнуюПолитику()
// 	ДатаДокумента
// 	Отказ
// Возвращаемое значение:
// 	Булево - Описание
Функция ПроверитьВозможностьЗакрытияСчетовЗатратПоУчетнойПолитике(УчетнаяПолитика, ДатаДокумента, Отказ = Ложь) Экспорт

	НомерМесяцаДекабрь = 12;
	Если УчетнаяПолитика.РассчитыватьСебестоимостьВКонцеГода И Месяц(ДатаДокумента) <> НомерМесяцаДекабрь Тогда
		
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В учетной политике установлено ежегодное закрытие затрат'"), , , , Отказ);
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПустаяТаблицаМетодыРаспределенияКосвенныхЗатрат()
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВидОбщихЗатрат", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОбщихЗатратНаПроизводство"));
	Результат.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Результат.Колонки.Добавить("ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	Результат.Колонки.Добавить("БазаРаспределения", Новый ОписаниеТипов("ПеречислениеСсылка.БазыРаспределенияКосвенныхЗатрат"));
	Результат.Колонки.Добавить("ОсновнаяБаза", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ВключатьВБазуОплатаТрудаКЭК212", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ВключатьВБазуОплатаТрудаКЭК213", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ВключатьВБазуОплатаТрудаКЭК214", Новый ОписаниеТипов("Булево"));
	Возврат Результат;
КонецФункции

#КонецОбласти 