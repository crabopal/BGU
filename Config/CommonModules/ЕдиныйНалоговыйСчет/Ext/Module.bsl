
#Область ПрограммныйИнтерфейс

// Проверяет можно ли для данного налога использовать отрицательную сумму в уведомлении
//
// Параметры:
//  КодБК - Строка
// 
// Возвращаемое значение:
//  Булево - Истина, если можно
//
Функция МожноИспользоватьОтрицательнуюСуммуВУведомлении(КодБК) Экспорт
	Возврат КодБК = "18210501011011000110"  // УСН_Доходы
		Или КодБК = "18210501021011000110"; // УСН_ДоходыМинусРасходы
КонецФункции

// Возвращаемое значение:
//  Дата - 01.01.2025
//
Функция ДатаВыделенияДополнительныхВзносовЛетчиковИШахтеровИзСоставаЕНП() Экспорт

	Возврат '20250101'

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура СинхронизироватьСостояниеУведомлений(Уведомление) Экспорт
	
	Если Уведомление.ДополнительныеСвойства.Свойство("СинхронизацияСостоянийУведомлений") Тогда
		Возврат;
	Иначе
		Уведомление.ДополнительныеСвойства.Вставить("СинхронизацияСостоянийУведомлений", Истина);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Уведомление",     Уведомление.Ссылка);
	Запрос.УстановитьПараметр("ПометкаУдаления", Уведомление.ПометкаУдаления);
	
	Если ТипЗнч(Уведомление) = Тип("ДокументОбъект.УведомлениеОбИсчисленныхСуммахНалогов") Тогда
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	УведомлениеОСпецрежимахНалогообложения.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.УведомлениеОбИсчисленныхСуммахНалогов КАК УведомлениеОбИсчисленныхСуммахНалогов
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОСпецрежимахНалогообложения КАК УведомлениеОСпецрежимахНалогообложения
			|		ПО УведомлениеОбИсчисленныхСуммахНалогов.Уведомление = УведомлениеОСпецрежимахНалогообложения.Ссылка
			|ГДЕ
			|	УведомлениеОбИсчисленныхСуммахНалогов.Ссылка = &Уведомление
			|	И УведомлениеОСпецрежимахНалогообложения.ПометкаУдаления <> &ПометкаУдаления";
	ИначеЕсли ТипЗнч(Уведомление) = Тип("ДокументОбъект.УведомлениеОСпецрежимахНалогообложения") Тогда
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	УведомлениеОбИсчисленныхСуммахНалогов.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.УведомлениеОбИсчисленныхСуммахНалогов КАК УведомлениеОбИсчисленныхСуммахНалогов
			|ГДЕ
			|	УведомлениеОбИсчисленныхСуммахНалогов.Уведомление = &Уведомление
			|	И УведомлениеОбИсчисленныхСуммахНалогов.ПометкаУдаления <> &ПометкаУдаления";
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.ДополнительныеСвойства.Вставить("СинхронизацияСостоянийУведомлений", Истина);
		ДокументОбъект.УстановитьПометкуУдаления(Уведомление.ПометкаУдаления);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#Область ЗаполнениеУведомления

// Формирует таблицу налогов для уведомления по документу НачислениеИмущественныхНалогов
//
// Параметры:
//  Документ - ДокументСсылка.НачислениеИмущественныхНалогов
//
// Возвращаемое значение:
//   ТаблицаЗначений - см. НоваяТаблицаНалоги()
//
Функция ТаблицаНалогиПоДокументуНачислениеИмущественныхНалогов(Документ) Экспорт
	
	ТаблицаНалоги 			= НоваяТаблицаНалоги();
	
	Организация 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Организация");
	ГоловнаяОрганизация 	= РегламентированнаяОтчетность.ГоловнаяОрганизация(Организация);
	КППГоловнойОрганизации 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГоловнаяОрганизация, "КПП");
	ОКТМООрганизации 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "КодОКТМО");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НачислениеИмущественныхНалоговДвиженияДокумента.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа,
		|	НачислениеИмущественныхНалоговДвиженияДокумента.НалогСборПлатеж КАК НалогСборПлатеж,
		|	ЕСТЬNULL(НачислениеИмущественныхНалоговДвиженияДокумента.НалогСборПлатеж.КодОКТМО, """") КАК КодПоОКТМО,
		|	ЕСТЬNULL(НачислениеИмущественныхНалоговДвиженияДокумента.ВидНалогаИлиПлатежа.КодГлавыБК, """") + ЕСТЬNULL(НачислениеИмущественныхНалоговДвиженияДокумента.ВидНалогаИлиПлатежа.Классификатор, """") КАК КодБК,
		|	СУММА(НачислениеИмущественныхНалоговДвиженияДокумента.Сумма) КАК Сумма,
		|	ВЫБОР
		|		КОГДА НачислениеИмущественныхНалогов.ДокументОснование ССЫЛКА Документ.РасчетЗемельногоНалога
		|			ТОГДА ЕСТЬNULL(РасчетЗемельногоНалога.ОтчетныйПериод, КОНЕЦПЕРИОДА(НачислениеИмущественныхНалогов.Дата, КВАРТАЛ))
		|		КОГДА НачислениеИмущественныхНалогов.ДокументОснование ССЫЛКА Документ.РасчетТранспортногоНалога
		|			ТОГДА ЕСТЬNULL(РасчетТранспортногоНалога.ОтчетныйПериод, КОНЕЦПЕРИОДА(НачислениеИмущественныхНалогов.Дата, КВАРТАЛ))
		|		КОГДА НачислениеИмущественныхНалогов.ДокументОснование ССЫЛКА Документ.РасчетНалогаНаИмущество
		|			ТОГДА ЕСТЬNULL(РасчетНалогаНаИмущество.ОтчетныйПериод, КОНЕЦПЕРИОДА(НачислениеИмущественныхНалогов.Дата, КВАРТАЛ))
		|		ИНАЧЕ КОНЕЦПЕРИОДА(НачислениеИмущественныхНалогов.Дата, КВАРТАЛ)
		|	КОНЕЦ КАК ОтчетныйПериод
		|ИЗ
		|	Документ.НачислениеИмущественныхНалогов КАК НачислениеИмущественныхНалогов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеИмущественныхНалогов.ДвиженияДокумента КАК НачислениеИмущественныхНалоговДвиженияДокумента
		|		ПО НачислениеИмущественныхНалогов.Ссылка = НачислениеИмущественныхНалоговДвиженияДокумента.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасчетНалогаНаИмущество КАК РасчетНалогаНаИмущество
		|		ПО НачислениеИмущественныхНалогов.ДокументОснование = РасчетНалогаНаИмущество.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасчетТранспортногоНалога КАК РасчетТранспортногоНалога
		|		ПО НачислениеИмущественныхНалогов.ДокументОснование = РасчетТранспортногоНалога.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасчетЗемельногоНалога КАК РасчетЗемельногоНалога
		|		ПО НачислениеИмущественныхНалогов.ДокументОснование = РасчетЗемельногоНалога.Ссылка
		|ГДЕ
		|	НачислениеИмущественныхНалогов.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА НачислениеИмущественныхНалогов.ДокументОснование ССЫЛКА Документ.РасчетЗемельногоНалога
		|			ТОГДА ЕСТЬNULL(РасчетЗемельногоНалога.ОтчетныйПериод, КОНЕЦПЕРИОДА(НачислениеИмущественныхНалогов.Дата, КВАРТАЛ))
		|		КОГДА НачислениеИмущественныхНалогов.ДокументОснование ССЫЛКА Документ.РасчетТранспортногоНалога
		|			ТОГДА ЕСТЬNULL(РасчетТранспортногоНалога.ОтчетныйПериод, КОНЕЦПЕРИОДА(НачислениеИмущественныхНалогов.Дата, КВАРТАЛ))
		|		КОГДА НачислениеИмущественныхНалогов.ДокументОснование ССЫЛКА Документ.РасчетНалогаНаИмущество
		|			ТОГДА ЕСТЬNULL(РасчетНалогаНаИмущество.ОтчетныйПериод, КОНЕЦПЕРИОДА(НачислениеИмущественныхНалогов.Дата, КВАРТАЛ))
		|		ИНАЧЕ КОНЕЦПЕРИОДА(НачислениеИмущественныхНалогов.Дата, КВАРТАЛ)
		|	КОНЕЦ,
		|	НачислениеИмущественныхНалоговДвиженияДокумента.НалогСборПлатеж,
		|	НачислениеИмущественныхНалоговДвиженияДокумента.ВидНалогаИлиПлатежа,
		|	ЕСТЬNULL(НачислениеИмущественныхНалоговДвиженияДокумента.НалогСборПлатеж.КодОКТМО, """"),
		|	ЕСТЬNULL(НачислениеИмущественныхНалоговДвиженияДокумента.ВидНалогаИлиПлатежа.КодГлавыБК, """") + ЕСТЬNULL(НачислениеИмущественныхНалоговДвиженияДокумента.ВидНалогаИлиПлатежа.Классификатор, """")";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНалоги = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаНалоги.Следующий() Цикл
    	НоваяСтрока = ТаблицаНалоги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаНалоги);
		
		НоваяСтрока.НачалоПериода = НачалоКвартала(ВыборкаНалоги.ОтчетныйПериод);
		НоваяСтрока.КонецПериода  = КонецКвартала(ВыборкаНалоги.ОтчетныйПериод);
		
		НоваяСтрока.КПП = КППГоловнойОрганизации;
		Если Не ЗначениеЗаполнено(НоваяСтрока.КодПоОКТМО) Тогда
			НоваяСтрока.КодПоОКТМО = ОКТМООрганизации;		
		КонецЕсли;
		
	КонецЦикла;
	
	СвернутьТаблицуНалоги(ТаблицаНалоги);
	
	Возврат ТаблицаНалоги;

КонецФункции

// Формирует таблицу налогов для уведомления по документу ОтражениеЗарплатыВУчете
//
// Параметры:
//  Документ - ДокументСсылка.ОтражениеЗарплатыВУчете
//
// Возвращаемое значение:
//   ТаблицаЗначений - см. НоваяТаблицаНалоги()
//
Функция ТаблицаНалогиПоДокументуОтражениеЗарплатыВУчете(Документ) Экспорт
	
	Период = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Дата");
	
	ТаблицаНалоги 		= НоваяТаблицаНалоги();
	КБКСтраховыхВзносов = Справочники.ВидыОперацийОтраженияЗарплаты.КБКСтраховыхВзносовПоВидуОперации();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтражениеЗарплатыВУчетеОперации.ВидОперации КАК ВидОперации,
		|	ОтражениеЗарплатыВУчетеОперации.ВидНалога КАК ВидНалогаИлиПлатежа,
		|	ЕСТЬNULL(ОтражениеЗарплатыВУчетеОперации.ВидНалога.КодГлавыБК, """") + ЕСТЬNULL(ОтражениеЗарплатыВУчетеОперации.ВидНалога.Классификатор, """") КАК КодБК,
		|	СУММА(ОтражениеЗарплатыВУчетеОперации.Сумма) КАК Сумма,
		|	ОтражениеЗарплатыВУчетеОперации.Ссылка.Организация.КПП КАК КПП,
		|	ОтражениеЗарплатыВУчетеОперации.Ссылка.Организация.КодОКТМО КАК КодПоОКТМО,
		|	ОтражениеЗарплатыВУчетеОперации.Ссылка.Дата КАК ОтчетныйПериод
		|ИЗ
		|	Документ.ОтражениеЗарплатыВУчете.Операции КАК ОтражениеЗарплатыВУчетеОперации
		|ГДЕ
		|	ОтражениеЗарплатыВУчетеОперации.Ссылка = &Ссылка
		|	И ОтражениеЗарплатыВУчетеОперации.ВидОперации В(&ВидыОперацийСтраховыеВзносы)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОтражениеЗарплатыВУчетеОперации.ВидОперации,
		|	ОтражениеЗарплатыВУчетеОперации.ВидНалога,
		|	ЕСТЬNULL(ОтражениеЗарплатыВУчетеОперации.ВидНалога.КодГлавыБК, """") + ЕСТЬNULL(ОтражениеЗарплатыВУчетеОперации.ВидНалога.Классификатор, """"),
		|	ОтражениеЗарплатыВУчетеОперации.Ссылка.Организация.КПП,
		|	ОтражениеЗарплатыВУчетеОперации.Ссылка.Организация.КодОКТМО,
		|	ОтражениеЗарплатыВУчетеОперации.Ссылка.Дата";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	ВидыОперацийСтраховыеВзносы = Новый Массив;
	ВидыОперацийСтраховыеВзносы.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_ЕдиныйСтраховойТариф);
	ВидыОперацийСтраховыеВзносы.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаПодземныхИВредныхРаботахБезСпецОценки);
	ВидыОперацийСтраховыеВзносы.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаПодземныхИВредныхРаботахСпецОценка);
	ВидыОперацийСтраховыеВзносы.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахБезСпецОценки);
	ВидыОперацийСтраховыеВзносы.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахСпецОценка);
	Если Период < ДатаВыделенияДополнительныхВзносовЛетчиковИШахтеровИзСоставаЕНП() Тогда
		ВидыОперацийСтраховыеВзносы.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРДополнительнаяЛетныхЭкипажей);
		ВидыОперацийСтраховыеВзносы.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРДополнительнаяНаДоплатуКПенсииШахтерам);
	КонецЕсли;
	ВидыОперацийСтраховыеВзносы.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ФСС);
	ВидыОперацийСтраховыеВзносы.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ФФОМС);
	ВидыОперацийСтраховыеВзносы.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ОПС_ПоМеждународнымДоговорам);
	ВидыОперацийСтраховыеВзносы.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ОСС_ПоМеждународнымДоговорам);
	ВидыОперацийСтраховыеВзносы.Добавить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ОМС_ПоМеждународнымДоговорам);
	Запрос.УстановитьПараметр("ВидыОперацийСтраховыеВзносы", ВидыОперацийСтраховыеВзносы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНалоги = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаНалоги.Следующий() Цикл
		
    	НоваяСтрока = ТаблицаНалоги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаНалоги);
		
		НоваяСтрока.НачалоПериода = НачалоМесяца(ВыборкаНалоги.ОтчетныйПериод);
		НоваяСтрока.КонецПериода  = КонецМесяца(ВыборкаНалоги.ОтчетныйПериод);
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.КодБК ) Тогда
			НоваяСтрока.КодБК = КБКСтраховыхВзносов[ВыборкаНалоги.ВидОперации];
		КонецЕсли;

	КонецЦикла;
	
	СвернутьТаблицуНалоги(ТаблицаНалоги);
	
	Возврат ТаблицаНалоги;

КонецФункции

// Формирует таблицу налогов для уведомления по документу СведенияОбУдержанномНДФЛ
//
// Параметры:
//  Документ - ДокументСсылка.СведенияОбУдержанномНДФЛ
//
// Возвращаемое значение:
//   ТаблицаЗначений - см. НоваяТаблицаНалоги()
//
Функция ТаблицаНалогиПоДокументуСведенияОбУдержанномНДФЛ(Документ) Экспорт
	
	ТаблицаНалоги = НоваяТаблицаНалоги();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СведенияОбУдержанномНДФЛНДФЛ.КодБК КАК КодБК,
		|	СведенияОбУдержанномНДФЛНДФЛ.КПП КАК КПП,
		|	СведенияОбУдержанномНДФЛНДФЛ.КодПоОКТМО КАК КодПоОКТМО,
		|	СведенияОбУдержанномНДФЛНДФЛ.Сумма КАК Сумма,
		|	СведенияОбУдержанномНДФЛНДФЛ.ДатаУдержания КАК ДатаУдержания
		|ИЗ
		|	Документ.СведенияОбУдержанномНДФЛ.НДФЛ КАК СведенияОбУдержанномНДФЛНДФЛ
		|ГДЕ
		|	СведенияОбУдержанномНДФЛНДФЛ.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНалоги = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаНалоги.Следующий() Цикл
		
    	НоваяСтрока = ТаблицаНалоги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаНалоги);
		
		Если День(ВыборкаНалоги.ДатаУдержания) < 23  Тогда
			НоваяСтрока.НачалоПериода = НачалоМесяца(ВыборкаНалоги.ДатаУдержания);	
			НоваяСтрока.КонецПериода  = Дата(Год(ВыборкаНалоги.ДатаУдержания), Месяц(ВыборкаНалоги.ДатаУдержания), 22);	
		Иначе
			НоваяСтрока.НачалоПериода = Дата(Год(ВыборкаНалоги.ДатаУдержания), Месяц(ВыборкаНалоги.ДатаУдержания), 23);	
			НоваяСтрока.КонецПериода  = КонецМесяца(ВыборкаНалоги.ДатаУдержания);	
		КонецЕсли;
		
	КонецЦикла;
	
	СвернутьТаблицуНалоги(ТаблицаНалоги);
	
	Возврат ТаблицаНалоги;

КонецФункции

// Сворачивает таблицу налогов.
// Если таблица налогов содержит несколько строк с одинаковаыми ключевыми полями 
// и разными значениями справочника ВидыНалоговИПлатежей, такие строки сворачиваются в одну строку.
// Значения ВидНалогаИлиПлатежа, НалогСборПлатеж заполняются первым подходящим значением из исходной таблицы
//
// Параметры:
//  ТаблицаНалоги  - ТаблицаЗначений - см. НоваяТаблицаНалоги()
//
Процедура СвернутьТаблицуНалоги(ТаблицаНалоги) Экспорт
	
	Для каждого СтрокаНалоги Из ТаблицаНалоги Цикл
		СтрокаНалоги.КодПоОКТМО = СокрЛП(СтрокаНалоги.КодПоОКТМО);
	КонецЦикла;
	
	ТаблицаНалогиИсходная 	= ТаблицаНалоги.Скопировать();
	ТаблицаПроверки 		= ТаблицаНалоги.Скопировать();
	
	КлючевыеПоля = "КПП,КодПоОКТМО,КодБК,НачалоПериода,КонецПериода";
	ТаблицаПроверки.Свернуть(КлючевыеПоля, "Сумма");
	
	Если ТаблицаПроверки.Количество() = ТаблицаНалоги.Количество() Тогда
		Возврат;	
	КонецЕсли;

	ПараметрыПоиска = Новый Структура(КлючевыеПоля);
	ТаблицаНалогиИсходная.Индексы.Добавить(КлючевыеПоля);
	
	ТаблицаНалоги = НоваяТаблицаНалоги();
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаПроверки, ТаблицаНалоги);
	
	Для каждого СтрокаНалоги Из ТаблицаНалоги Цикл
		
		ЗаполнитьЗначенияСвойств(ПараметрыПоиска, СтрокаНалоги);
		НашлиСтроки = ТаблицаНалогиИсходная.НайтиСтроки(ПараметрыПоиска);
		Если НашлиСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаИсходнойТаблицы = НашлиСтроки[0];
		СтрокаНалоги.ВидНалогаИлиПлатежа = СтрокаИсходнойТаблицы.ВидНалогаИлиПлатежа;
		СтрокаНалоги.НалогСборПлатеж     = СтрокаИсходнойТаблицы.НалогСборПлатеж;
	
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяТаблицаНалоги()

	ТаблицаНалоги = Новый ТаблицаЗначений;
	ТаблицаНалоги.Колонки.Добавить("ВидНалогаИлиПлатежа", 	Новый ОписаниеТипов("СправочникСсылка.ВидыНалоговИПлатежей"));
	ТаблицаНалоги.Колонки.Добавить("НалогСборПлатеж", 		Новый ОписаниеТипов("СправочникСсылка.НалогиИПлатежиОрганизации"));
	ТаблицаНалоги.Колонки.Добавить("КПП", 					ОбщегоНазначения.ОписаниеТипаСтрока(9));
	ТаблицаНалоги.Колонки.Добавить("КодПоОКТМО", 			ОбщегоНазначения.ОписаниеТипаСтрока(11));
	ТаблицаНалоги.Колонки.Добавить("КодБК", 				ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаНалоги.Колонки.Добавить("Сумма", 				ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ТаблицаНалоги.Колонки.Добавить("НачалоПериода", 		ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаНалоги.Колонки.Добавить("КонецПериода", 			ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	
    Возврат ТаблицаНалоги;
	
КонецФункции


#КонецОбласти
