#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура ВычислитьТекстПоляИИсточникДляОтбораТиповыхОпераций(СхемаКомпоновки, СчетчикТаблиц, РеквизитДокумента, ТекстПоля, ТекстИсточника)

	ИменаТипов = Новый Массив;
	ЧастиТекстаПоля = Новый Массив;
	ЧастиИсточника = Новый Массив;
	ПараметрДобавлен = Ложь;	
	Для Каждого ТекущийТип Из РеквизитДокумента.ТипЗначения.Типы() Цикл
	
		ПолноеИмя = "";
		Если ТекущийТип = Тип("Строка") Тогда
			ЧастиТекстаПоля.Добавить(СтрШаблон("ЕстьNULL(&%1, """")", РеквизитДокумента.ИмяРеквизита));
			ИменаТипов.Добавить("Строка");
		ИначеЕсли ТекущийТип = Тип("Дата") Тогда
			ЧастиТекстаПоля.Добавить(СтрШаблон("ЕстьNULL(&%1, ДатаВремя(1,1,1))", РеквизитДокумента.ИмяРеквизита));
			ИменаТипов.Добавить("Дата");
		ИначеЕсли ТекущийТип = Тип("Число") Тогда
			ЧастиТекстаПоля.Добавить(СтрШаблон("ЕстьNULL(&%1, 0)", РеквизитДокумента.ИмяРеквизита));
			ИменаТипов.Добавить("Число");
		ИначеЕсли ТекущийТип = Тип("Булево") Тогда
			ЧастиТекстаПоля.Добавить(СтрШаблон("ЕстьNULL(&%1, ЛОЖЬ)", РеквизитДокумента.ИмяРеквизита));
			ИменаТипов.Добавить("Булево");
		ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТекущийТип) Тогда
			МетаданныеПеречисления = Метаданные.НайтиПоТипу(ТекущийТип);
			ПолноеИмя = МетаданныеПеречисления.ПолноеИмя();
		ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТекущийТип) Тогда
			Идентификатор = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТекущийТип);
			ПолноеИмя = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Идентификатор, "ПолноеИмя");
		КонецЕсли;
		Если ПолноеИмя <> "" Тогда
			ИменаТипов.Добавить(ПолноеИмя);
			ЧастиТекстаПоля.Добавить(СтрШаблон("ЕстьNULL(Т%2.Ссылка, ЗНАЧЕНИЕ(%3.ПустаяСсылка))",
				РеквизитДокумента.ИмяРеквизита, СчетчикТаблиц, ПолноеИмя));
			ЧастиИсточника.Добавить(СтрШаблон("ЛЕВОЕ СОЕДИНЕНИЕ %3 КАК Т%2
					 |	ПО Т%2.Ссылка = &%1", РеквизитДокумента.ИмяРеквизита, СчетчикТаблиц, ПолноеИмя));
			
			Если Не ПараметрДобавлен Тогда		
				ПараметрСхемы = СхемаКомпоновки.Параметры.Добавить();
				ПараметрСхемы.Имя						= РеквизитДокумента.ИмяРеквизита;
				ПараметрСхемы.ТипЗначения				= РеквизитДокумента.ТипЗначения;
				ПараметрСхемы.ОграничениеИспользования	= Ложь;
				ПараметрДобавлен = Истина;
			КонецЕсли;
			СчетчикТаблиц = СчетчикТаблиц + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если ЧастиТекстаПоля.Количество() = 1 Тогда
		ТекстПоля = ЧастиТекстаПоля[0] + " КАК " + РеквизитДокумента.ИмяРеквизита;
		Если ЧастиИсточника.Количество() = 1 Тогда
			ТекстИсточника = ЧастиИсточника[0];
		КонецЕсли;
	ИначеЕсли ЧастиТекстаПоля.Количество() > 1 Тогда
		ЧастиКогда = Новый Массив;
		ТекстКогда = "
		|	КОГДА ТИПЗНАЧЕНИЯ(&%1) = ТИП(%2)
		|		ТОГДА %3";
		Для Индекс = 0 По ЧастиТекстаПоля.ВГраница() Цикл
			ЧастиКогда.Добавить(СтрШаблон(ТекстКогда, РеквизитДокумента.ИмяРеквизита, ИменаТипов[Индекс], ЧастиТекстаПоля[Индекс]));
		КонецЦикла;
		ТекстПоля = "ВЫБОР"
		+ СтрСоединить(ЧастиКогда)
		+ "
		|	ИНАЧЕ НЕОПРЕДЕЛЕНО
		|КОНЕЦ КАК " + РеквизитДокумента.ИмяРеквизита;
		Если ЧастиИсточника.Количество() > 0 Тогда
			ТекстИсточника = СтрСоединить(ЧастиИсточника, Символы.ПС);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ИнициализироватьОбщийМодуль(ИмяМодуля, ШаблонИсключения, ЗаголовокРасширения)
	Попытка
	
		ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
		Возврат Истина;
	
	Исключение
		
		ТекстИсключения = СтрШаблон(ШаблонИсключения, ИмяМодуля, ЗаголовокРасширения);
		ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииЧтениеДополнительныхМодулей(),
			УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.ТиповыеОперации,, ТекстИсключения);
		Возврат Ложь;
		
	КонецПопытки;
КонецФункции

Функция ТипЗначенияРеквизитаМетаданного(МетаданныеДокумента, ИмяРеквизита)

	РеквизитМетаданного = МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита);
	Если РеквизитМетаданного = Неопределено Тогда
		Для Индекс = 0 По МетаданныеДокумента.СтандартныеРеквизиты.Количество() - 1 Цикл
		
			Если ВРЕГ(МетаданныеДокумента.СтандартныеРеквизиты[Индекс].Имя) = ИмяРеквизита Тогда
				РеквизитМетаданного = МетаданныеДокумента.СтандартныеРеквизиты[Индекс];
				Прервать;
			КонецЕсли;
		
		КонецЦикла; 
	КонецЕсли;
	Если РеквизитМетаданного <> Неопределено Тогда
		Возврат РеквизитМетаданного.Тип;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции // ТипЗначенияРеквизитаМетаданного()

Процедура ДобавитьРекурсивноЭлементыДополнительнойТабличнойЧасти(ВыборкаЭлементы, Дерево, ТекущаяСсылка)

	Для каждого ВыборкаЭлементы Из ВыборкаЭлементы.Строки Цикл
		
		Если ВыборкаЭлементы.Ссылка = ТекущаяСсылка Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавленныйЭлемент = ДобавитьЭлементДополнительнойТабличнойЧасти(ВыборкаЭлементы, Дерево);
	
		Если ВыборкаЭлементы.ЭтоГруппа Тогда
			ДобавитьРекурсивноЭлементыДополнительнойТабличнойЧасти(ВыборкаЭлементы, ДобавленныйЭлемент, ВыборкаЭлементы.Ссылка);
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры

Функция ДобавитьЭлементДополнительнойТабличнойЧасти(ВыборкаЭлементы, Дерево)
	
	Если ВыборкаЭлементы.ЭтоГруппа Тогда
	
		НовыйЭлемент = Дерево.Строки.Добавить();
		НовыйЭлемент.Имя							= ВыборкаЭлементы.ИмяРеквизита;
		НовыйЭлемент.Заголовок						= ВыборкаЭлементы.ЗаголовокРеквизита;
		НовыйЭлемент.РастягиватьПоГоризонтали		= Истина;
		НовыйЭлемент.ТипЭлемента					= Новый ОписаниеТипов("ГруппаФормы");
		НовыйЭлемент.ВидЭлемента					= ВидГруппыФормы.ГруппаКолонок;
		НовыйЭлемент.ОтображатьЗаголовок			= Ложь;
		НовыйЭлемент.Группировка					= ГруппировкаКолонокТаблицыПоСтроке(ВыборкаЭлементы.ГруппировкаЭлементов);
		НовыйЭлемент.ШиринаПодчиненныхЭлементов		= ШиринаПодчиненныхЭлементовФормы.Авто;
		НовыйЭлемент.Отображение					= "Нет";
		НовыйЭлемент.НеПовторять					= Истина;
		
	Иначе
		
		Если НЕ ЗначениеЗаполнено(ВыборкаЭлементы.ТипЗначенияРеквизита) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		НовыйЭлемент = Дерево.Строки.Добавить();
		НовыйЭлемент.Имя 						= ВыборкаЭлементы.ИмяРеквизита;
		НовыйЭлемент.Заголовок 					= ВыборкаЭлементы.ЗаголовокРеквизита;
		НовыйЭлемент.РастягиватьПоГоризонтали	= Истина;
		НовыйЭлемент.ТипЭлемента 				= Новый ОписаниеТипов("ПолеФормы");
		НовыйЭлемент.ВидЭлемента 				= ВидПоляФормыПоСтроке(ВыборкаЭлементы.ВидЭлемента);
		НовыйЭлемент.Валютный 					= Ложь;
		НовыйЭлемент.НеПовторять 				= Истина;
		НовыйЭлемент.ТипЗначения				= ВыборкаЭлементы.ТипЗначенияРеквизита;
		НовыйЭлемент.СвязиПоТипу				= ВыборкаЭлементы.СвязьПоТипу;
		Если НЕ ПустаяСтрока(ВыборкаЭлементы.СвязиПараметровВыбора) Тогда
			МассивСвязей = ЗначениеИзСтрокиВнутр(ВыборкаЭлементы.СвязиПараметровВыбора);
			СвязиПараметровВыбора = Новый Массив;
			Для каждого ТекСвязь Из МассивСвязей Цикл
			
				СвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора(	ТекСвязь.Имя,
																			ТекСвязь.Реквизит,
																			?(ТекСвязь.Режим = "НеИзменять",
																				РежимИзмененияСвязанногоЗначения.НеИзменять,
																				РежимИзмененияСвязанногоЗначения.Очищать)));
																			
			
			КонецЦикла; 
			
			НовыйЭлемент.СвязиПараметровВыбора	= СвязиПараметровВыбора;
		КонецЕсли;
		НовыйЭлемент.Путь 						= ?(ВыборкаЭлементы.ПредопределеннаяТЧ, "Объект.", "") + ВыборкаЭлементы.ИмяТЧ;
		НовыйЭлемент.Обязательный				= ВыборкаЭлементы.ОбязательныйРеквизит;
		НовыйЭлемент.ПоложениеЗаголовка			= ПоложениеЗаголовкаЭлементаФормы.Авто;
		НовыйЭлемент.ЦветФона					= Новый Цвет;
		НовыйЭлемент.ПриИзменении				= "Подключаемый_ПриИзмененииРеквизитаДополнительнойТабличнойЧасти";
		Если Не ПустаяСтрока(ВыборкаЭлементы.СвязьПоТипу) Тогда
			Скобка = Найти(ВыборкаЭлементы.СвязьПоТипу, "(");
			Если Скобка > 0 Тогда
				// удалим из структуры связи по типу "Объект." для облегчения последующего поиска связанных элементов
				ВедущийЭлементИмя = Лев(ВыборкаЭлементы.СвязьПоТипу, Скобка-1);
				Если Лев(ВедущийЭлементИмя, 7) = "Объект." Тогда
					ВедущийЭлементИмя = Сред(ВедущийЭлементИмя, 8);
				КонецЕсли;
				ВедущийЭлементНомер = Сред(ВыборкаЭлементы.СвязьПоТипу, Скобка+1, 1);
				Если Число(ВедущийЭлементНомер) <> 0 Тогда
					СтруктураЗависимости = Новый Структура("ВедущийЭлемент, ПорядокЭлемента, ЗависимыйЭлемент, ЗависимостьПоДоступности, ЗависимостьПоЗаголовку",
															ВедущийЭлементИмя,
															ВедущийЭлементНомер,
															ВыборкаЭлементы.ИмяТЧ + "." + ВыборкаЭлементы.ИмяРеквизита,
															Истина,
															Истина);
					НовыйЭлемент.СтруктураСвязиПоТипу	= СтруктураЗависимости;
				
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ВыборкаЭлементы.ОтборЭлементов) Тогда
			ПараметрыВыбора = Новый Массив;
			ПараметрыВыбора.Добавить(Новый ПараметрВыбора("ПредустановленныйОтбор", ВыборкаЭлементы.ОтборЭлементов));
			// для перечислений добавим текст запроса для СКД обрабатываемой при получении списка выбора.
			Если Перечисления.ТипВсеСсылки().СодержитТип(ВыборкаЭлементы.ТипЗначенияРеквизита.Типы()[0]) Тогда
				ТекстЗапросаОтбора = "Выбрать * Из Перечисление."+Метаданные.НайтиПоТипу(ВыборкаЭлементы.ТипЗначенияРеквизита.Типы()[0]).Имя+" Как Переч";
				ПараметрыВыбора.Добавить(Новый ПараметрВыбора("ТекстЗапросаОтбора", ТекстЗапросаОтбора));
			КонецЕсли;				
			НовыйЭлемент.ПараметрыВыбора			= ПараметрыВыбора;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НовыйЭлемент;
	
КонецФункции

Функция ВидПоляФормыПоСтроке(СтроковоеПредставление)

	Результат = ВидПоляФормы.ПолеВвода;
	Если СтроковоеПредставление = "ПолеФлажка" Тогда
		Результат = ВидПоляФормы.ПолеФлажка;
	КонецЕсли;
	Возврат Результат;

КонецФункции // ВидПоляФормыПоСтроке()

Функция ГруппировкаКолонокТаблицыПоСтроке(СтроковоеПредставление)
	Если СтроковоеПредставление = "Горизонтальная" Тогда
		Возврат ГруппировкаКолонок.Горизонтальная;
	ИначеЕсли СтроковоеПредставление = "ВЯчейке" Тогда
		Возврат ГруппировкаКолонок.ВЯчейке;
	Иначе
		Возврат ГруппировкаКолонок.Вертикальная;
	КонецЕсли;
Конецфункции

#КонецОбласти