
#Область СлужебныйПрограммныйИнтерфейс

Функция ИменаРеквизитовДляПроверкиИспользованияОперации(ИдентификаторДокумента) Экспорт

	ПараметрыИспользования = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИменаРеквизитовДокументовДляВыбораОпераций.ИмяРеквизита КАК ИмяРеквизита
	|ИЗ
	|	РегистрСведений.ИменаРеквизитовДокументовДляВыбораОпераций КАК ИменаРеквизитовДокументовДляВыбораОпераций
	|ГДЕ
	|	ИменаРеквизитовДокументовДляВыбораОпераций.ИдентификаторДокумента = &ИдентификаторДокумента
	|	И ИменаРеквизитовДокументовДляВыбораОпераций.ИмяРеквизита <> """"";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПараметрыИспользования.Вставить(Выборка.ИмяРеквизита);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПараметрыИспользования) Тогда
		Возврат Новый ФиксированнаяСтруктура(ПараметрыИспользования);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ЕстьПравоПросмотраПроводокДокументов() Экспорт

	Возврат ПравоДоступа("Чтение", Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ)
		И ПравоДоступа("Просмотр", Метаданные.Обработки.ФормированиеБухгалтерскихПроводок);

КонецФункции // ЕстьПравоПросмотраПроводокДокументов()

Функция ПараметрыИспользованияОперацийИДопРеквизитов(ИдентификаторДокумента) Экспорт

	Результат = Новый Структура("ТиповыеОперации, ТабличныеЧасти", Ложь, Ложь);
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(Т1.ТиповыеОперации, ЛОЖЬ) КАК ТиповыеОперации,
	               |	ЕСТЬNULL(Т2.ТабличныеЧасти, ЛОЖЬ) КАК ТабличныеЧасти
	               |ИЗ
	               |	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	               |			ИСТИНА КАК ТиповыеОперации
	               |		ИЗ
	               |			Справочник.ТиповыеОперации КАК ТиповыеОперации
	               |		ГДЕ
	               |			ТиповыеОперации.ИдентификаторДокумента = &ИдентификаторДокумента
	               |			И НЕ ТиповыеОперации.НеИспользуется
	               |			И НЕ ТиповыеОперации.ПометкаУдаления) КАК Т1
	               |		ПО Истина
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	               |			ИСТИНА КАК ТабличныеЧасти
	               |		ИЗ
	               |			Справочник.КолонкиДополнительныхТабличныхЧастей КАК КолонкиДополнительныхТабличныхЧастей
	               |		ГДЕ
	               |			КолонкиДополнительныхТабличныхЧастей.Владелец.ИдентификаторДокумента = &ИдентификаторДокумента
	               |			И НЕ КолонкиДополнительныхТабличныхЧастей.Владелец.ПометкаУдаления
	               |			И НЕ КолонкиДополнительныхТабличныхЧастей.ПометкаУдаления) КАК Т2
	               |		ПО Истина
	               |ГДЕ
	               |	ИдентификаторыОбъектовМетаданных.Ссылка = &ИдентификаторДокумента";
				   
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПараметрыИспользованияОперацийИДопРеквизитов()

Функция ПоДокументуВедетсяВалютныйУчет(Идентификатор) Экспорт
	
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(Идентификатор);
	Возврат МетаданныеДокумента.Реквизиты.Найти("ВалютаДокумента") <> Неопределено
			И МетаданныеДокумента.Реквизиты.Найти("Курс")=Неопределено;
	
КонецФункции

// Проверяет наличие в документе реквизита ПервичныйДокумент с типом СправочникСсылка.ПервичныеДокументы
//
// Параметры:
//  Идентификатор - СправочникСсылка.ИдентификаторыОбъектовМетаданных
// 
// Возвращаемое значение:
//  Булево
//
Функция ВДокументеЕстьПервичныйДокумент(Идентификатор) Экспорт
	ОбъектМетаданных = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(Идентификатор);
	РеквизитПервичныйДокумент = ОбъектМетаданных.Реквизиты.Найти("ПервичныйДокумент");
	Возврат РеквизитПервичныйДокумент <> Неопределено
		И ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(
			РеквизитПервичныйДокумент.Тип, Тип("СправочникСсылка.ПервичныеДокументы"));
КонецФункции

Функция ДеревоЭлементовФормыДополнительныхТабличныхЧастей(ИдентификаторДокумента) Экспорт

	Результат = БухгалтерскиеОперацииРаботаСФормами.ПустоеДеревоЭлементовФормы();
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КолонкиДополнительныхТабличныхЧастей.Владелец.Наименование КАК ЗаголовокТЧ,
	|	КолонкиДополнительныхТабличныхЧастей.Владелец.ИмяТабличнойЧасти КАК ИмяТЧ,
	|	КолонкиДополнительныхТабличныхЧастей.ЭтоГруппа,
	|	КолонкиДополнительныхТабличныхЧастей.Владелец.ПредопределеннаяТабличнаяЧасть КАК ПредопределеннаяТЧ,
	|	КолонкиДополнительныхТабличныхЧастей.Наименование КАК ЗаголовокРеквизита,
	|	КолонкиДополнительныхТабличныхЧастей.ИмяКолонки КАК ИмяРеквизита,
	|	КолонкиДополнительныхТабличныхЧастей.ОписаниеТипаКолонки.ТипЗначения КАК ТипЗначенияРеквизита,
	|	КолонкиДополнительныхТабличныхЧастей.СвязиПараметровВыбора,
	|	КолонкиДополнительныхТабличныхЧастей.ПараметрыВыбора,
	|	КолонкиДополнительныхТабличныхЧастей.СвязьПоТипу,
	|	КолонкиДополнительныхТабличныхЧастей.Обязательный КАК ОбязательныйРеквизит,
	|	КолонкиДополнительныхТабличныхЧастей.Родитель КАК Родитель,
	|	КолонкиДополнительныхТабличныхЧастей.Ссылка КАК Ссылка,
	|	КолонкиДополнительныхТабличныхЧастей.ОтборЭлементов,
	|	КолонкиДополнительныхТабличныхЧастей.ГруппировкаЭлементов,
	|	КолонкиДополнительныхТабличныхЧастей.ВидЭлемента
	|ИЗ
	|	Справочник.КолонкиДополнительныхТабличныхЧастей КАК КолонкиДополнительныхТабличныхЧастей
	|ГДЕ
	|	КолонкиДополнительныхТабличныхЧастей.Владелец.ИдентификаторДокумента = &ИдентификаторДокумента
	|	И НЕ КолонкиДополнительныхТабличныхЧастей.ПометкаУдаления
	|	И НЕ КолонкиДополнительныхТабличныхЧастей.Владелец.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	КолонкиДополнительныхТабличныхЧастей.Владелец.Код,
	|	КолонкиДополнительныхТабличныхЧастей.Код
	|ИТОГИ ПО
	|	КолонкиДополнительныхТабличныхЧастей.Владелец,
	|	Ссылка ИЕРАРХИЯ";
	
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Для каждого ВыборкаТЧ Из Дерево.Строки Цикл
	
		ТабличнаяЧасть = Результат.Строки.Добавить();
		ТабличнаяЧасть.Имя 						= ВыборкаТЧ.ИмяТЧ;
		ТабличнаяЧасть.Заголовок 				= ВыборкаТЧ.ЗаголовокТЧ;
		ТабличнаяЧасть.РастягиватьПоГоризонтали	= Истина;
		ТабличнаяЧасть.ТипЭлемента 				= Новый ОписаниеТипов("ТаблицаФормы");
		ТабличнаяЧасть.ВидЭлемента 				= Неопределено;
		ТабличнаяЧасть.Валютный 				= Ложь;
		ТабличнаяЧасть.НеПовторять 				= Истина;
		ТабличнаяЧасть.ПредопределеннаяТЧ		= ВыборкаТЧ.ПредопределеннаяТЧ;
		ТабличнаяЧасть.ЦветФона					= Новый Цвет;
		
		ДобавитьРекурсивноЭлементыДополнительнойТабличнойЧасти(ВыборкаТЧ, ТабличнаяЧасть, Неопределено);
	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДеревоЭлементовФормыТиповойОперации(ТиповаяОперация, ИдентификаторДокумента) Экспорт
	
	Возврат БухгалтерскиеОперацииРаботаСФормами.ДеревоЭлементовФормыТиповойОперации(ТиповаяОперация, ИдентификаторДокумента);
	
КонецФункции

Функция ПараметрыПолученияСохраненныхЗначенийТабличныхЧастей(ИдентификаторДокумента) Экспорт

	ПараметрыПолученияСохраненныхЗначений = Новый Структура;
	
	МассивЗапросов 		= Новый Массив;
	МассивИменТЧ 		= Новый Массив;
	ПараметрыЗапроса	= Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Т.Владелец КАК ТабличнаяЧастьДокумента,
	               |	Т.Владелец.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	               |	Т.Владелец.ПредопределеннаяТабличнаяЧасть КАК ПредопределеннаяТабличнаяЧасть,
	               |	Т.Ссылка КАК РеквизитТабличнойЧасти,
	               |	Т.ИмяКолонки КАК ИмяРеквизита
	               |ИЗ
	               |	Справочник.КолонкиДополнительныхТабличныхЧастей КАК Т
	               |ГДЕ
	               |	Т.Владелец.ИдентификаторДокумента = &ИдентификаторДокумента
	               |	И НЕ Т.ПометкаУдаления
	               |	И НЕ Т.Владелец.ПометкаУдаления
	               |	И НЕ Т.ЭтоГруппа
	               |ИТОГИ ПО
	               |	ТабличнаяЧастьДокумента";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	ВыборкаТЧ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СчетчикТЧ 			= 0;
	СчетчикРеквизитов 	= 0;
	Пока ВыборкаТЧ.Следующий() Цикл
		СчетчикТЧ	= СчетчикТЧ + 1;
		МассивИменТЧ.Добавить(Новый Структура("ИмяТабличнойЧасти, ПредопределеннаяТабличнаяЧасть",
												ВыборкаТЧ.ИмяТабличнойЧасти,
												ВыборкаТЧ.ПредопределеннаяТабличнаяЧасть));
		
		ПараметрыЗапроса.Вставить("ТабличнаяЧасть" + СчетчикТЧ, ВыборкаТЧ.ТабличнаяЧастьДокумента);
		
		ПоляЗапроса = "";
		
		ТекстЗапроса = "";
		ВыборкаРеквизитов = ВыборкаТЧ.Выбрать();
		Пока ВыборкаРеквизитов.Следующий() Цикл
			СчетчикРеквизитов = СчетчикРеквизитов + 1;
			ТекстЗапроса = ТекстЗапроса + "
		               |		ЛЕВОЕ СОЕДИНЕНИЕ СохраненныеЗначения КАК СохраненныеЗначения" + СчетчикРеквизитов + "
		               |		ПО ВложенныйЗапрос.НомерСтрокиДокумента = СохраненныеЗначения" + СчетчикРеквизитов + ".НомерСтрокиДокумента
		               |			И (СохраненныеЗначения" + СчетчикРеквизитов + ".ТабличнаяЧасть = &ТабличнаяЧасть" + СчетчикТЧ + ")
		               |			И (СохраненныеЗначения" + СчетчикРеквизитов + ".РеквизитТабличнойЧасти = &РеквизитТабличнойЧасти" + СчетчикРеквизитов + ")";
			ПараметрыЗапроса.Вставить("РеквизитТабличнойЧасти" + СчетчикРеквизитов, ВыборкаРеквизитов.РеквизитТабличнойЧасти);
			ПоляЗапроса = ПоляЗапроса + ", СохраненныеЗначения" + СчетчикРеквизитов + ".ЗначениеРеквизита Как " + ВыборкаРеквизитов.ИмяРеквизита;	
					   
		КонецЦикла;
			
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ВложенныйЗапрос.НомерСтрокиДокумента" + ПоляЗапроса + "
		               |ИЗ
		               |	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |		СохраненныеЗначения.НомерСтрокиДокумента КАК НомерСтрокиДокумента
		               |	ИЗ
		               |		СохраненныеЗначения КАК СохраненныеЗначения
		               |	ГДЕ
		               |		СохраненныеЗначения.ТабличнаяЧасть = &ТабличнаяЧасть" + СчетчикТЧ + ") КАК ВложенныйЗапрос" 
					   + ТекстЗапроса + "
					   |УПОРЯДОЧИТЬ ПО
					   |	ВложенныйЗапрос.НомерСтрокиДокумента";
		
		МассивЗапросов.Добавить(ТекстЗапроса);
	
	КонецЦикла;
	
	Если МассивЗапросов.Количество() = 0 Тогда
		Возврат ПараметрыПолученияСохраненныхЗначений;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Т.ТабличнаяЧасть,
	               |	Т.КолонкаТабличнойЧасти Как РеквизитТабличнойЧасти,
	               |	Т.НомерСтрокиДокумента,
	               |	Т.Значение Как ЗначениеРеквизита
	               |ПОМЕСТИТЬ СохраненныеЗначения
	               |ИЗ
	               |	РегистрСведений.ЗначенияКолонокДополнительныхТабличныхЧастей КАК Т
	               |ГДЕ
	               |	Т.Объект = &Документ";
	Для каждого ТекЗапрос Из МассивЗапросов Цикл
	
		ТекстЗапроса = ТекстЗапроса + "
	               |;
				   |" + ТекЗапрос;
	
	КонецЦикла;
			   
	ПараметрыПолученияСохраненныхЗначений.Вставить("ТекстЗапроса", 		ТекстЗапроса);
	ПараметрыПолученияСохраненныхЗначений.Вставить("ТабличныеЧасти", 	МассивИменТЧ);
	ПараметрыПолученияСохраненныхЗначений.Вставить("ПараметрыЗапроса",	ПараметрыЗапроса);
	
	Возврат ПараметрыПолученияСохраненныхЗначений;

КонецФункции // ПолучитьПараметрыПолученияСохраненныхЗначений()

Функция СохраненныеДанныеПоставляемойТиповойОперации(ТиповаяОперация) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.ФормулаДата, """") КАК ФормулаДата,
	               |	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.ФормулаОрганизация, """") КАК ФормулаОрганизация,
	               |	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.Условие, """") КАК Условие,
	               |	ДанныеПоставляемыхТиповыхОпераций.СхемаФормированияПроводок,
	               |	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.ИспользуетсяВнешняяПроцедура, ЛОЖЬ) КАК ИспользуетсяВнешняяПроцедура,
	               |	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.ИмяВнешнейПроцедуры, """") КАК ИмяВнешнейПроцедуры,
	               |	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.НастройкаПредставления, """") КАК НастройкаПредставления,
	               |	ДанныеПоставляемыхТиповыхОпераций.СхемаПроверкиУсловия,
	               |	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.ТекстСообщенияПриОшибке, """") КАК ТекстСообщенияПриОшибке
	               |ИЗ
	               |	Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПоставляемыхТиповыхОпераций КАК ДанныеПоставляемыхТиповыхОпераций
	               |		ПО ПоставляемыеТиповыеОперации.Ссылка = ДанныеПоставляемыхТиповыхОпераций.ТиповаяОперация
	               |ГДЕ
	               |	ПоставляемыеТиповыеОперации.Ссылка = &ТиповаяОперация";
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);				   
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Выборка[0]);

КонецФункции // СохраненныеДанныеПоставляемойТиповойОперации()

Функция СхемаКомпоновкиДанныхДляОтбораТиповыхОпераций(ИдентификаторДокумента) Экспорт

	ОписанияРеквизитов = БухгалтерскиеОперацииПовтИспНаВремяСеанса.ПустойИсточникДанныхИзШапкиОбъекта(ИдентификаторДокумента);
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.ТипИсточникаДанных = "local";
	ИсточникДанных.Имя = "ИсточникДанных1";
	
	СчетчикТаблиц = 1;
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	НаборДанных.Имя = "Запрос";
	НаборДанных.Запрос = 
	"ВЫБРАТЬ
	|	ТиповыеОперации.Ссылка КАК ТиповаяОперация,
	|	ТиповыеОперации.Наименование КАК Наименование,
	|	ТиповыеОперации.НеИспользуется,
	|	ТиповыеОперации.ПоставляемаяТиповаяОперация.Поставщик Как Поставщик,
	|	ВЫБОР
	|		КОГДА ТиповыеОперации.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
	|			ТОГДА 0
	|		КОГДА ТиповыеОперации.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки)
	|			ТОГДА 1
	|		КОГДА ТиповыеОперации.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки)
	|			ТОГДА 2
	|		ИНАЧЕ -1
	|	КОНЕЦ Как КартинкаСостояниеПоддержки,
	|	ТиповыеОперации.ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
	|				ГДЕ
	|					ТиповыеОперацииРазрешенныеПользователи.Ссылка = ТиповыеОперации.Ссылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьПравоВсеПользователи,
	|	ВЫБОР
	|		КОГДА ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
	|				ГДЕ
	|					ТиповыеОперацииРазрешенныеПользователи.Ссылка = ТиповыеОперации.Ссылка
	|					И ТиповыеОперацииРазрешенныеПользователи.Пользователь = &ТекущийПользователь)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьПравоТекущийПользователь,
	|	&ДополнительныеПоля КАК ДополнительныеПоля
	|ИЗ
	|	#ИсточникВыборки КАК ТиповыеОперации
	|ГДЕ
	|	ТиповыеОперации.ИдентификаторДокумента = &ИдентификаторДокумента
	|";
	
	ДополнительныеПоля = Новый Массив; // Массив из Строка
	ИсточникиЗапроса = Новый Массив; // Массив из Строка
	ИсточникиЗапроса.Добавить("Справочник.ТиповыеОперации КАК ТиповыеОперации");
	Для каждого РеквизитДокумента Из ОписанияРеквизитов Цикл
		ТекстПоля = "";
		ТекстИсточника = "";
		ВычислитьТекстПоляИИсточникДляОтбораТиповыхОпераций(СхемаКомпоновки, СчетчикТаблиц, РеквизитДокумента,
			ТекстПоля, ТекстИсточника);
		Если ТекстПоля <> "" Тогда
			ДополнительныеПоля.Добавить(ТекстПоля);
		КонецЕсли;
		Если ТекстИсточника <> "" Тогда
			ИсточникиЗапроса.Добавить(ТекстИсточника);
		КонецЕсли;
	КонецЦикла;
						 
	НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос,
		"#ИсточникВыборки КАК ТиповыеОперации",
		СтрСоединить(ИсточникиЗапроса, Символы.ПС));
	Если ДополнительныеПоля.Количество() > 0 Тогда
		НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос,
			"&ДополнительныеПоля КАК ДополнительныеПоля",
			СтрСоединить(ДополнительныеПоля, "," + Символы.ПС));
	Иначе
		НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос,
			"&ДополнительныеПоля КАК ДополнительныеПоля",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	ПараметрСхемы = СхемаКомпоновки.Параметры.Добавить();
	ПараметрСхемы.Имя						= "ИдентификаторДокумента";
	ПараметрСхемы.ТипЗначения				= Новый ОписаниеТипов("СправочникСсылка.ИдентификаторыОбъектовМетаданных");
	ПараметрСхемы.ОграничениеИспользования	= Истина;
	ПараметрСхемы.ВключатьВДоступныеПоля	= Ложь;
	ПараметрСхемы.Значение					= ИдентификаторДокумента;
	
	ПараметрСхемы = СхемаКомпоновки.Параметры.Добавить();
	ПараметрСхемы.Имя						= "ТекущийПользователь";
	ПараметрСхемы.ТипЗначения				= Новый ОписаниеТипов("СправочникСсылка.Пользователи");
	ПараметрСхемы.ВключатьВДоступныеПоля	= Ложь;
	ПараметрСхемы.ОграничениеИспользования	= Истина;
	ПараметрСхемы.Значение					= Пользователи.ТекущийПользователь();
	
	Возврат СхемаКомпоновки;

КонецФункции // СхемаКомпоновкиДанныхДляОтбораТиповыхОпераций()

Функция ПустойИсточникДанныхИзШапкиОбъекта(ИдентификаторДокумента) Экспорт
	
	ИменаРеквизитов	= БухгалтерскиеОперацииПовтИспНаВремяСеанса.ИменаРеквизитовДляВыбораТиповойОперации(ИдентификаторДокумента);
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("ИмяРеквизита", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(254))); 
	ТаблицаЗначений.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("ОписаниеТипов")); 
	
	Для каждого ТекРеквизит Из ИменаРеквизитов Цикл
	
		НоваяСтрока = ТаблицаЗначений.Добавить();
		НоваяСтрока.ИмяРеквизита = ТекРеквизит;
		НоваяСтрока.ТипЗначения = ТипЗначенияРеквизитаМетаданного(МетаданныеДокумента, ТекРеквизит);
	
	КонецЦикла; 
	
	Возврат ТаблицаЗначений;

КонецФункции

Функция ИменаРеквизитовДляВыбораТиповойОперации(ИдентификаторДокумента) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИменаРеквизитовДокументовДляВыбораОпераций.ИмяРеквизита КАК ИмяРеквизита,
	|	НЕОПРЕДЕЛЕНО КАК ТипЗначения
	|ИЗ
	|	РегистрСведений.ИменаРеквизитовДокументовДляВыбораОпераций КАК ИменаРеквизитовДокументовДляВыбораОпераций
	|ГДЕ
	|	ИменаРеквизитовДокументовДляВыбораОпераций.ИдентификаторДокумента = &ИдентификаторДокумента
	|	И ИменаРеквизитовДокументовДляВыбораОпераций.ИмяРеквизита <> """"";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИмяРеквизита");
КонецФункции

Функция ВерсииМакетовТиповыхОпераций52() Экспорт

	Возврат РегистрыСведений.ВерсииПоставляемыхТиповыхОпераций.ВерсииМакетовТиповыхОпераций52();

КонецФункции

// Документы, по которым проводки всегда формируются одновременно с проведением документа,
// независимо от значения константы ФормированиеПроводокПриПроведенииДокумента.
// Не включает документ "ОперацияБух", т.к. он не проводится.
//
// Возвращемое значение:
// - ФиксированныйМассив - идентификаторы объектов (СправочникСсылка.ИдентификаторыОбъектовМетаданных)
//
Функция ДокументыФормирующиеПроводкиВсегдаОдновременно() Экспорт

	ТипыДокументов = Новый Массив;
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ОперацияБух"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ЗакрытиеГода"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ЗакрытиеГодаТехнологическое"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ЗакрытиеГодаТехнологическоеГрупповое"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ЗакрытиеСчетовСанкционирования"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ПереносПоказателейПоСанкционированию"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ФормированиеОстатковПоРасчетам"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ЗакрытиеОстатковПоЖурналамСлужебный"));

	ИОМ = ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(ТипыДокументов);
	
	Результат = Новый Массив;
	Для Каждого ТекущийИОМ Из ИОМ Цикл
		Результат.Добавить(ТекущийИОМ.Значение);		
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции

Функция СчетПоКодуИНачалуДействия(КодСчета, ДатаНачалаДействия) Экспорт
	Запрос = Новый Запрос;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код = &Код";
	Запрос.УстановитьПараметр("Код", КодСчета);
	Если ДатаНачалаДействия <> Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ЕПСБУ.ДатаНачалаДействия = &ДатаНачалаДействия";
		Запрос.УстановитьПараметр("ДатаНачалаДействия", ДатаНачалаДействия);
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
КонецФункции

#Область РаботаСИсточникамиДанных

// Возвращает структуру, содержащую имена модулей функций типовых операций, функций источников данных
// и процедур обработчиков после формирования проводок. Возвращаемое значение содержит структуры,
// в которых "ключ" - имя модуля, "значение" - описание подсистемы или расширения.
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура - содержит ключи:
//		*Функции - Фиксированная структура - имена модулей функций типовых операций.
//		*ИсточникиДанных - Фиксированная структура - имена модулей функций дополнительных источников данных.
//		*Обработчики - Фиксированная структура - имена модулей процедур обработчиков после формирования проводок.
//
Функция ИменаМодулей() Экспорт
	
	ОписанияДополнительныхМодулей = Новый Массив;
	БухгалтерскиеОперацииПереопределяемый.ИменаМодулейОбъявленияФункций(ОписанияДополнительныхМодулей);
	
	ОписанияФункций           = Новый Структура;
	ОписанияИсточниковДанных  = Новый Структура;
	ОписанияОбработчиков      = Новый Структура;
	ОписанияМодулейПроведения = Новый Структура;
	
	ШаблонТекстаИсключения = НСтр("ru = 'Не найден общий модуль ""%1"" в подключенном расширении ""%2"".
		|%ПояснениеНазначенияМодуля%.
		|
		|Для продолжения работы необходимо отключить расширение
		|или исправить имя модуля и переподключить расширение снова'");
	
	ИсключениеМодулиФункций = СтрЗаменить(ШаблонТекстаИсключения, "%ПояснениеНазначенияМодуля%",
		НСтр("ru = 'Этот модуль содержит функции для использования в настройках типовых операций'"));
	ИсключениеМодулиИсточниковДанных = СтрЗаменить(ШаблонТекстаИсключения, "%ПояснениеНазначенияМодуля%",
		НСтр("ru = 'Этот модуль используется для формирования дополнительных источников типовых операций'"));
	ИсключениеМодулиОбработчиков = СтрЗаменить(ШаблонТекстаИсключения, "%ПояснениеНазначенияМодуля%",
		НСтр("ru = 'Этот модуль используется для формирования дополнительных источников типовых операций'"));
	ИсключениеМодулиПроведения = СтрЗаменить(ШаблонТекстаИсключения, "%ПояснениеНазначенияМодуля%",
		НСтр("ru = 'В этом модуле описаны процедуры проведения документов'"));
		
	Для Каждого ОписаниеМодуля Из ОписанияДополнительныхМодулей Цикл
		
		Для Каждого ТекИмяМодуля Из ОписаниеМодуля.МодулиФункций Цикл
			
			Если ИнициализироватьОбщийМодуль(ТекИмяМодуля, ИсключениеМодулиФункций, ОписаниеМодуля.Заголовок) Тогда
				ОписанияФункций.Вставить(ТекИмяМодуля, ОписаниеМодуля.Заголовок);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ТекИмяМодуля Из ОписаниеМодуля.МодулиИсточниковДанных Цикл
			
			Если ИнициализироватьОбщийМодуль(ТекИмяМодуля, ИсключениеМодулиИсточниковДанных, ОписаниеМодуля.Заголовок) Тогда
				ОписанияИсточниковДанных.Вставить(ТекИмяМодуля, ОписаниеМодуля.Заголовок);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ТекИмяМодуля Из ОписаниеМодуля.МодулиОбработчиков Цикл
			
			Если ИнициализироватьОбщийМодуль(ТекИмяМодуля, ИсключениеМодулиОбработчиков, ОписаниеМодуля.Заголовок) Тогда
				ОписанияОбработчиков.Вставить(ТекИмяМодуля, ОписаниеМодуля.Заголовок);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ТекИмяМодуля Из ОписаниеМодуля.МодулиПроведения Цикл
			
			Если ИнициализироватьОбщийМодуль(ТекИмяМодуля, ИсключениеМодулиПроведения, ОписаниеМодуля.Заголовок) Тогда
				ОписанияМодулейПроведения.Вставить(ТекИмяМодуля, ОписаниеМодуля.Заголовок);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ИменаМодулей = Новый Структура("Функции, ИсточникиДанных, Обработчики, ФункцииПроведения");
	ИменаМодулей.Функции           = Новый ФиксированнаяСтруктура(ОписанияФункций);
	ИменаМодулей.ИсточникиДанных   = Новый ФиксированнаяСтруктура(ОписанияИсточниковДанных);
	ИменаМодулей.Обработчики       = Новый ФиксированнаяСтруктура(ОписанияОбработчиков);
	ИменаМодулей.ФункцииПроведения = Новый ФиксированнаяСтруктура(ОписанияМодулейПроведения);
	
	Возврат Новый ФиксированнаяСтруктура(ИменаМодулей);
	
КонецФункции

#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

