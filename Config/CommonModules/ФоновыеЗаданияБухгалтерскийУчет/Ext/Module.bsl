// Загрузка корреспондирующих счетов

Процедура ВыполнитьЗагрузкуКорреспондирующихСчетовВОбщемМодуле(Параметры, АдресВХранилище) Экспорт
	
	ЗаполненоПроводок = 0;
	
	Результат = РегистрыСведений.КорректныеКорреспонденцииСчетов.ЗаполнитьПроводки(
		Параметры.УдалитьВсеСуществующие, Параметры.ДанныеФайла, ЗаполненоПроводок);
	
	СтруктураРезультата = Новый Структура("ЗаполненоПроводок, Результат", ЗаполненоПроводок, Результат);
	ПоместитьВоВременноеХранилище(СтруктураРезультата,АдресВХранилище);
	
КонецПроцедуры

Процедура ВыполнитьВыгрузкуКорреспондирующихСчетовВОбщемМодуле(АдресВХранилище) Экспорт

	ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
	
	РегистрыСведений.КорректныеКорреспонденцииСчетов.СохранитьПроводкиВФайл(ВременныйФайл);
	
	ДанныеФайла = Новый ДвоичныеДанные(ВременныйФайл);
	СтруктураРезультата = Новый Структура("ДанныеФайла", ДанныеФайла);
	ПоместитьВоВременноеХранилище(СтруктураРезультата,АдресВХранилище);
	УдалитьФайлы(ВременныйФайл);
	
КонецПроцедуры

// Поиск и замена значений

 Процедура ПоискИЗаменаЗначений(Параметры,АдресВХранилище) Экспорт
	
	Обработка = Обработки.ПоискИЗаменаЗначений.Создать();
	Результат = Обработка.ВыполнитьЗаменуЭлементов(Параметры);
	ПоместитьВоВременноеХранилище(Результат,АдресВХранилище);
	
КонецПроцедуры 

// Обмен с системой учета имущества

Процедура ВыполнитьОперациюОбменаССистемойУчетаИмущества(Операция, Параметры, АдресВХранилище) Экспорт

	Обработки.ОбменССистемойУчетаИмущества.ВыполнитьОперацию(Операция, Параметры, АдресВХранилище);
	
КонецПроцедуры

// Перепроведение документов

Процедура ВыполнитьПерепроведениеДокументовВОбщемМодуле(Параметры, АдресВХранилище) Экспорт
	
	Попытка 
		
		НачатьТранзакцию();
		
		Для Каждого Док Из Параметры.МассивДокументов Цикл
			
			ДокОбъект = Док.ПолучитьОбъект();
			ДокОбъект.ДополнительныеСвойства.Вставить("НеПроверятьОтчетКассира", Истина);
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
	КонецПопытки
	
КонецПроцедуры
