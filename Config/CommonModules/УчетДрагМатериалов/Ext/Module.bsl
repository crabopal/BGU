Функция СписокДрагМатериаловОбъектаМЗ(ОбъектНФА, ДатаСведений) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала ЕСТЬ NULL 
	|			ТОГДА ""0""
	|		ИНАЧЕ НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала.Код
	|	КОНЕЦ КАК КодДрагМатериала,
	|	0 КАК КодДляСортировки,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток КАК Масса,
	|	0 КАК ЧистаяМасса,
	|	0 КАК ЛигатурнаяМасса,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм КАК ЕдИзм,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток КАК КоличествоДМ
	|ИЗ
	|	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&Период, ОбъектНФА = &ОбъектНФА) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.Организация,
	|	ВЫБОР
	|		КОГДА НаличиеДрагМатериаловВЛомеИОтходахОстатки.ВидДрагМатериала ЕСТЬ NULL 
	|			ТОГДА ""0""
	|		ИНАЧЕ НаличиеДрагМатериаловВЛомеИОтходахОстатки.ВидДрагМатериала.Код
	|	КОНЕЦ,
	|	0,
	|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ВидДрагМатериала,
	|	0,
	|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток,
	|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЛигатурнаяМассаОстаток,
	|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЕдИзм,
	|	0
	|ИЗ
	|	РегистрНакопления.НаличиеДрагМатериаловВЛомеИОтходах.Остатки(&Период, ОбъектНФА = &ОбъектНФА) КАК НаличиеДрагМатериаловВЛомеИОтходахОстатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация";
	
	Запрос.УстановитьПараметр("Период", 	КонецДня(ДатаСведений));
	Запрос.УстановитьПараметр("ОбъектНФА",	ОбъектНФА);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаДрагМатериалов = РезультатЗапроса.Выгрузить();
	Для каждого ТекСтрока Из ТаблицаДрагМатериалов Цикл
		ТекСтрока.КодДляСортировки = Число(ТекСтрока.КодДрагМатериала);
	КонецЦикла;	
	
	ТаблицаДрагМатериалов.Сортировать("Организация, КодДляСортировки"); 
	
	Возврат ТаблицаДрагМатериалов;
	
КонецФункции	

Функция СписокНастроекОтчетовДрагМатериаловОбъектаМЗ(ОбъектНФА, ДатаСведений) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.Организация КАК Организация,
	|	НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОтчетДМ КАК ВидОтчета,
	|	НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта КАК ТипНоменклатурыОтчета
	|ИЗ
	|	РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(&Период, ОбъектНФА = &ОбъектНФА) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	ВидОтчета";
	
	Запрос.УстановитьПараметр("Период", 	КонецДня(ДатаСведений));
	Запрос.УстановитьПараметр("ОбъектНФА",	ОбъектНФА);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Функция ДанныеОДрагМатериалахПоПаспортуДляОбъектаНФА(ОбъектНФА) Экспорт
	Результат = Справочники.ДрагМатериалыВОбъектахНФАПоТехДокументации.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ОбъектНФА) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	ДрагМатериалыВОбъектеПоСведениямТехническойДокументации.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации КАК ДрагМатериалыВОбъектеПоСведениямТехническойДокументации
		               |ГДЕ
		               |	ДрагМатериалыВОбъектеПоСведениямТехническойДокументации.ОбъектНФА = &ОбъектНФА
		               |	И ДрагМатериалыВОбъектеПоСведениямТехническойДокументации.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("ОбъектНФА", ОбъектНФА);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции


