Функция МассивДрагМатериалов(ТипДМ, ГруппаОтбораДМ = Неопределено) Экспорт
	МассивДМ = Новый Массив;
	
	ЗапросДМ = Новый Запрос;
	Если (ГруппаОтбораДМ = Неопределено) ИЛИ (НЕ ЗначениеЗаполнено(ГруппаОтбораДМ)) Тогда
		ЗапросДМ.Текст = "ВЫБРАТЬ
		                 |	ДМ.Ссылка
		                 |ИЗ
		                 |	Справочник.ДрагМеталлы КАК ДМ
		                 |ГДЕ
		                 |	ДМ.ТипДрагМатериала = &ТипДМ
		                 |	И ДМ.ПометкаУдаления = ЛОЖЬ";
		
	Иначе
		ЗапросДМ.Текст = "ВЫБРАТЬ
		                 |	ДМ.Ссылка
		                 |ИЗ
		                 |	Справочник.ДрагМеталлы КАК ДМ
		                 |ГДЕ
		                 |	ДМ.ТипДрагМатериала = &ТипДМ
		                 |	И ДМ.ПометкаУдаления = ЛОЖЬ
		                 |	И ДМ.Родитель В ИЕРАРХИИ(&ГруппаОтбораДМ)";
	КонецЕсли;				 
	ЗапросДМ.УстановитьПараметр("ТипДМ", ТипДМ);
	ЗапросДМ.УстановитьПараметр("ГруппаОтбораДМ", ГруппаОтбораДМ);
	РезультатЗапроса = ЗапросДМ.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивДМ.Добавить(Выборка.Ссылка);
	КонецЦикла;	
	
	Возврат МассивДМ;
КонецФункции	

Функция МассаДрагМатериаловПрописью(Масса) Экспорт
	
	МассаПрописью = ЧислоПрописью(Масса,, "целый,целых,целых,м,стомиллионная,стомиллионные,стомиллионных,ж,8");
	
	ДробнаяЧасть = (Масса - Цел(Масса))*100000000;
	ДробнаяЧастьМассыПрописью = Нрег(ЧислоПрописью(ДробнаяЧасть,, ",,,ж,,,,,0"));
	
	Если ДробнаяЧасть = 0 Тогда
		МассаПрописью = ЧислоПрописью(Масса,, ",,,,,,,,0");
	Иначе
		ДлинаМассыПрописью = СтрДлина(МассаПрописью);
		ПозицияПервогоСимволаПоследнегоСлова = СтрНайти(МассаПрописью, "стомилл", НаправлениеПоиска.СКонца);
		НачальныйНомерПоследняяЧасть = ПозицияПервогоСимволаПоследнегоСлова; 
		ПоследняяЧасть = Сред(МассаПрописью, НачальныйНомерПоследняяЧасть);
		ПоследняяПозицияПерваяЧасть = ПозицияПервогоСимволаПоследнегоСлова - 10; 
		ПерваяЧасть = Сред(МассаПрописью, 0, ПоследняяПозицияПерваяЧасть);
        МассаПрописью = СокрЛП(ПерваяЧасть) + " " + СокрЛП(ДробнаяЧастьМассыПрописью) + " " +СокрЛП(ПоследняяЧасть);
	Конецесли;	
	
	Возврат МассаПрописью;
	
КонецФункции	

Функция КоличествоМЦПрописью(КоличествоМЦ) Экспорт
	
	КоличествоМЦПрописью = ЧислоПрописью(КоличествоМЦ,, "целая,целых,целых,м,тысячная,тысячные,тысячных,ж,3");
	
	ДробнаяЧасть = (КоличествоМЦ - Цел(КоличествоМЦ))*1000;
	ДробнаяЧастьМассыПрописью = Нрег(ЧислоПрописью(ДробнаяЧасть,, ",,,ж,,,,,0"));
	
	Если ДробнаяЧасть = 0 Тогда
		КоличествоМЦПрописью = ЧислоПрописью(КоличествоМЦ,, ",,,,,,,,0");
	Иначе
		ДлинаМассыПрописью = СтрДлина(КоличествоМЦПрописью);
		ПозицияПервогоСимволаПоследнегоСлова = СтрНайти(КоличествоМЦПрописью, "тысячн", НаправлениеПоиска.СКонца);
		НачальныйНомерПоследняяЧасть = ПозицияПервогоСимволаПоследнегоСлова; 
		ПоследняяЧасть = Сред(КоличествоМЦПрописью, НачальныйНомерПоследняяЧасть);
		ПоследняяПозицияПерваяЧасть = ПозицияПервогоСимволаПоследнегоСлова - 5; 
		ПерваяЧасть = Сред(КоличествоМЦПрописью, 0, ПоследняяПозицияПерваяЧасть);
        КоличествоМЦПрописью = СокрЛП(ПерваяЧасть) + " " + СокрЛП(ДробнаяЧастьМассыПрописью)+ " " +СокрЛП(ПоследняяЧасть);
	Конецесли;	
	
	Возврат КоличествоМЦПрописью;
	
КонецФункции	

Функция ТекстЗапросаДвиженияНаличиеДрагМатериаловВОбъектахНФА_Параметры(ИмяТаблицы = "", ВидДвижения = "", Множитель = 1) Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяТаблицы",              ИмяТаблицы);
	Параметры.Вставить("ВидДвижения",             ВидДвижения);
	Параметры.Вставить("Множитель",               Множитель);
	Параметры.Вставить("ПолеПериод",              "&ПериодДвижений");
	Параметры.Вставить("ЕстьИнвентарныйНомер",    Ложь);
	Параметры.Вставить("ИмяПараметраРегистратор", "Ссылка");
	Параметры.Вставить("ЭтоКорректировка",        Ложь);
	Параметры.Вставить("КорректируемыйДокумент");
	Возврат Параметры;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента(Запрос, НомераТаблиц, ПараметрыЗапроса) Экспорт
	
	НомераТаблиц.Вставить("НаличиеДрагМатериаловВОбъектахНФА", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("НаличиеДрагМатериаловВЛомеИОтходах", НомераТаблиц.Количество());
	
	ЗапросНаличиеДрагМатериаловВОбъектахНФА = Новый Массив;
	ЗапросНаличиеДрагМатериаловВОбъектахНФА.Добавить(ТекстЗапросаДвиженияНаличиеДрагМатериаловВОбъектахНФА(ПараметрыЗапроса));
	
	ЗапросНаличиеДрагМатериаловВЛомеИОтходах = Новый Массив;
	ЗапросНаличиеДрагМатериаловВЛомеИОтходах.Добавить(ТекстЗапросаДвиженияНаличиеДрагМатериаловВЛомеИОтходах(ПараметрыЗапроса));
	
	Если ПараметрыЗапроса.ЭтоКорректировка Тогда
		ПараметрыЗапроса.Множитель = -1;
		ПараметрыЗапроса.ИмяПараметраРегистратор = "КорректируемыйДокумент";
		ЗапросНаличиеДрагМатериаловВОбъектахНФА.Добавить(ТекстЗапросаДвиженияНаличиеДрагМатериаловВОбъектахНФА(ПараметрыЗапроса));
		ЗапросНаличиеДрагМатериаловВЛомеИОтходах.Добавить(ТекстЗапросаДвиженияНаличиеДрагМатериаловВЛомеИОтходах(ПараметрыЗапроса));
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Запрос.Текст) Тогда
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов();
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст
		+ СтрСоединить(ЗапросНаличиеДрагМатериаловВОбъектахНФА, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ"))
		+ ОбщегоНазначения.РазделительПакетаЗапросов()
		+ СтрСоединить(ЗапросНаличиеДрагМатериаловВЛомеИОтходах, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ"));
	
КонецПроцедуры

Функция ТекстЗапросаДвиженияНаличиеДрагМатериаловВОбъектахНФА(Параметры) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&ПолеПериод КАК Период,
	|	ТаблицаДрагоценныеМатериалы.Ссылка КАК Регистратор,
	|	&ВидДвижения КАК ВидДвижения,
	|	ТаблицаДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	|	ТаблицаДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	|	ТаблицаДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	|	&ПолеИнвНомер КАК ИнвНомер,
	|	ТаблицаДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	&Множитель * ТаблицаДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	|	&Множитель * ТаблицаДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	|	&ИмяДокументаДМ КАК Основание,
	|	&НомерДокумента КАК НомерОснования,
	|	ТаблицаДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	|	ТаблицаДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	ТаблицаДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации
	|ИЗ
	|	&ТаблицаДрагоценныеМатериалы КАК ТаблицаДрагоценныеМатериалы
	|ГДЕ
	|	ТаблицаДрагоценныеМатериалы.Ссылка = &ИмяПараметраРегистратор
	|	И ТаблицаДрагоценныеМатериалы.МассаДМ > 0";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТаблицаДрагоценныеМатериалы", Параметры.ИмяТаблицы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПериод", Параметры.ПолеПериод);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидДвижения", "ЗНАЧЕНИЕ(ВидДвиженияНакопления." + Параметры.ВидДвижения + ")");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Множитель", Параметры.Множитель);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяПараметраРегистратор", "&" + Параметры.ИмяПараметраРегистратор);
	
	Если Параметры.ЕстьИнвентарныйНомер Тогда
		ПолеИнвНомер = "ТаблицаДрагоценныеМатериалы.ИнвНомер";
	Иначе
		ПолеИнвНомер = "ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИнвНомер", ПолеИнвНомер);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаДвиженияНаличиеДрагМатериаловВЛомеИОтходах(Параметры) Экспорт

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&ПолеПериод КАК Период,
	|	ТаблицаДрагоценныеМатериалы.Ссылка КАК Регистратор,
	|	&ВидДвижения КАК ВидДвижения,
	|	ТаблицаДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	|	ТаблицаДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	|	ТаблицаДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	|	&ПолеИнвНомер КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ) КАК ВидОбъекта,
	|	ТаблицаДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	&Множитель * ТаблицаДрагоценныеМатериалы.ЧистаяМасса КАК ЧистаяМасса,
	|	&Множитель * ТаблицаДрагоценныеМатериалы.ЛигатурнаяМасса КАК ЛигатурнаяМасса,
	|	&ИмяДокументаДМ КАК Основание,
	|	&НомерДокумента КАК НомерОснования,
	|	ТаблицаДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	|	ТаблицаДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	ТаблицаДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации,
	|	ТаблицаДрагоценныеМатериалы.ИсточникОбразования КАК ИсточникОбразования
	|ИЗ
	|	&ТаблицаДрагоценныеМатериалы КАК ТаблицаДрагоценныеМатериалы
	|ГДЕ
	|	ТаблицаДрагоценныеМатериалы.Ссылка = &ИмяПараметраРегистратор
	|	И (ТаблицаДрагоценныеМатериалы.ЛигатурнаяМасса > 0
	|		ИЛИ ТаблицаДрагоценныеМатериалы.ЧистаяМасса > 0)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТаблицаДрагоценныеМатериалы", Параметры.ИмяТаблицы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПериод", Параметры.ПолеПериод);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидДвижения", "ЗНАЧЕНИЕ(ВидДвиженияНакопления." + Параметры.ВидДвижения + ")");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Множитель", Параметры.Множитель);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяПараметраРегистратор", "&" + Параметры.ИмяПараметраРегистратор);
	
	Если Параметры.ЕстьИнвентарныйНомер Тогда
		ПолеИнвНомер = "ТаблицаДрагоценныеМатериалы.ИнвНомер";
	Иначе
		ПолеИнвНомер = "ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИнвНомер", ПолеИнвНомер);
	
	Возврат ТекстЗапроса;

КонецФункции

Функция ТекстЗапросаПроверкиЗаполненияСодержанияДрагМатериаловКапвложений(ВедетсяУчетДрагМатериаловВМЦКапвложений) Экспорт

	Если ВедетсяУчетДрагМатериаловВМЦКапвложений Тогда
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	&Организация КАК Организация,
			|	ДрагМатериалыДокумента.ОбъектНФА,
			|	ДрагМатериалыДокумента.ОбъектМЦ,
			|	ДрагМатериалыДокумента.МассаДМ,
			|	ДрагМатериалыДокумента.КоличествоДМ
			|ПОМЕСТИТЬ ДрагМатериалыДокумента
			|ИЗ
			|	&ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	&Организация КАК Организация,
			|	ОбъектыДокумента.ОбъектНФА,
			|	ОбъектыДокумента.ОбъектМЦ
			|ПОМЕСТИТЬ ОбъектыДокумента
			|ИЗ
			|	&ОбъектыДокумента КАК ОбъектыДокумента
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ОбъектыНФАДокумента.Организация,
			|	ОбъектыНФАДокумента.ОбъектНФА,
			|	ОбъектыНФАДокумента.ОбъектМЦ,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ДрагМатериалыДокумента.МассаДМ, 0) = 0
			|				И ЕСТЬNULL(ДрагМатериалыДокумента.КоличествоДМ, 0) = 0
			|			ТОГДА ЛОЖЬ
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ КАК ЕстьДрагМатериалы
			|ПОМЕСТИТЬ ОбъектыНФАДокумента
			|ИЗ
			|	ОбъектыДокумента КАК ОбъектыНФАДокумента
			|		ЛЕВОЕ СОЕДИНЕНИЕ ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
			|		ПО ОбъектыНФАДокумента.Организация = ДрагМатериалыДокумента.Организация
			|			И ОбъектыНФАДокумента.ОбъектНФА = ДрагМатериалыДокумента.ОбъектНФА
			|			И (ОбъектыНФАДокумента.ОбъектМЦ = ДрагМатериалыДокумента.ОбъектМЦ)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ОбъектыНФАДокумента.ОбъектНФА КАК ОбъектНФА,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОбъектМЦ,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток КАК МассаДМОстаток,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток КАК КоличествоДМОстаток,
			|	ОбъектыНФАДокумента.ЕстьДрагМатериалы КАК ЕстьДрагМатериалы
			|ИЗ
			|	ОбъектыНФАДокумента КАК ОбъектыНФАДокумента
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&ДатаСведений, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
			|		ПО (НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА = ОбъектыНФАДокумента.ОбъектМЦ)
			|			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация = ОбъектыНФАДокумента.Организация)
			|			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер = Значение(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))
			|ГДЕ
			|	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА, 0) <> 0
			|	И ОбъектыНФАДокумента.ЕстьДрагМатериалы = ЛОЖЬ";
	Иначе
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	&Организация КАК Организация,
			|	ДрагМатериалыДокумента.ОбъектНФА,
			|	ДрагМатериалыДокумента.ИнвНомер,
			|	ДрагМатериалыДокумента.МассаДМ,
			|	ДрагМатериалыДокумента.КоличествоДМ
			|ПОМЕСТИТЬ ДрагМатериалыДокумента
			|ИЗ
			|	&ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	&Организация КАК Организация,
			|	ОбъектыДокумента.ОсновноеСредство,
			|	ОбъектыДокумента.ИнвентарныйНомер КАК ИнвНомер
			|ПОМЕСТИТЬ ОбъектыДокумента
			|ИЗ
			|	&ОбъектыДокумента КАК ОбъектыДокумента
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ОбъектыНФАДокумента.Организация,
			|	ОбъектыНФАДокумента.ОсновноеСредство КАК ОсновноеСредство,
			|	ОбъектыНФАДокумента.ИнвНомер,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ДрагМатериалыДокумента.МассаДМ, 0) = 0
			|				И ЕСТЬNULL(ДрагМатериалыДокумента.КоличествоДМ, 0) = 0
			|			ТОГДА ЛОЖЬ
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ КАК ЕстьДрагМатериалы
			|ПОМЕСТИТЬ ОбъектыНФАДокумента
			|ИЗ
			|	ОбъектыДокумента КАК ОбъектыНФАДокумента
			|		ЛЕВОЕ СОЕДИНЕНИЕ ДрагМатериалыДокумента КАК ДрагМатериалыДокумента
			|		ПО ОбъектыНФАДокумента.Организация = ДрагМатериалыДокумента.Организация
			|			И ОбъектыНФАДокумента.ОсновноеСредство = ДрагМатериалыДокумента.ОбъектНФА
			|			И (ОбъектыНФАДокумента.ИнвНомер = ДрагМатериалыДокумента.ИнвНомер)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОбъектНФА,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток КАК МассаДМОстаток,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток КАК КоличествоДМОстаток,
			|	ОбъектыНФАДокумента.ЕстьДрагМатериалы КАК ЕстьДрагМатериалы
			|ИЗ
			|	ОбъектыНФАДокумента КАК ОбъектыНФАДокумента
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&ДатаСведений, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
			|		ПО (НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА = ОбъектыНФАДокумента.ОсновноеСредство)
			|			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация = ОбъектыНФАДокумента.Организация)
			|			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер = ОбъектыНФАДокумента.ИнвНомер)
			|ГДЕ
			|	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА, 0) <> 0
			|	И ОбъектыНФАДокумента.ЕстьДрагМатериалы = ЛОЖЬ";
	КонецЕсли;
	
	Возврат ТекстЗапроса;
		
КонецФункции

функция ДополнитьТестЗапросаОстаткиНаПериодДляМЗ()
	
	ТекстЗапроса = "";
	Если ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
		
		ТекстЗапроса = "
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ЖурналПроводокЕПСБУОстатки.Субконто1,
				|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
				|	ЖурналПроводокЕПСБУОстатки.Субконто2,
				|	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)),
				|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
				|ИЗ
				|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&МассивСчетовМЗ), &МассивСубконтоМЦ, Организация = &Организация И Субконто1 ССЫЛКА Справочник.Номенклатура) КАК ЖурналПроводокЕПСБУОстатки
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
				|				&Период,
				|				Организация = &Организация
				|					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
				|		ПО (ВЫБОР
				|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Номенклатура
				|					ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
				|				ИНАЧЕ ЛОЖЬ
				|			КОНЕЦ)
				|ГДЕ
				|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
				|	И &НетОтбораПоТипуОбъекта";
	
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

функция ДополнитьТекстЗапросаОстаткиНаПериодДляОС() 

	Если ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
		
		ТекстЗапроса = 
			ОбщегоНазначения.РазделительПакетаЗапросов() +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
			|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество,
			|	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта
			|ПОМЕСТИТЬ ДанныеМЦПослеОтбора
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет.Код = ""МЦК"", &МассивСубконтоМЦ, Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
			|		ПО (ВЫБОР
			|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ОсновныеСредства
			|					ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
			|				ИНАЧЕ ЛОЖЬ
			|			КОНЕЦ)
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
			|	И &НетОтбораПоТипуОбъекта
			|	И ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ОсновныеСредства
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеОСПослеОтбора.ОбъектНФА КАК ОбъектНФА,
			|	МестонахождениеОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
			|	ДанныеОСПослеОтбора.ЦМО КАК ЦМО,
			|	ДанныеОСПослеОтбора.Количество КАК Количество
			|ПОМЕСТИТЬ ДанныеОтбора
			|ИЗ
			|	ДанныеОСПослеОтбора КАК ДанныеОСПослеОтбора
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВсеОстаткиРН КАК МестонахождениеОССрезПоследних
			|		ПО ДанныеОСПослеОтбора.ОбъектНФА = МестонахождениеОССрезПоследних.ОсновноеСредство
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ДанныеМЦПослеОтбора.ОбъектНФА,
			|	МестонахождениеОССрезПоследних.ИнвНомер,
			|	ДанныеМЦПослеОтбора.ЦМО,
			|	ДанныеМЦПослеОтбора.Количество
			|ИЗ
			|	ДанныеМЦПослеОтбора КАК ДанныеМЦПослеОтбора
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВсеОстаткиРН КАК МестонахождениеОССрезПоследних
			|		ПО ДанныеМЦПослеОтбора.ОбъектНФА = МестонахождениеОССрезПоследних.ОсновноеСредство
			|			И (МестонахождениеОССрезПоследних.ИнвНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))"		
		    + ОбщегоНазначения.РазделительПакетаЗапросов();
		
	Иначе
		
		 ТекстЗапроса = 
		 	ОбщегоНазначения.РазделительПакетаЗапросов() 			
			+
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеОСПослеОтбора.ОбъектНФА КАК ОбъектНФА,
			|	МестонахождениеОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
			|	ДанныеОСПослеОтбора.ЦМО КАК ЦМО,
			|	ДанныеОСПослеОтбора.Количество КАК Количество
			|ПОМЕСТИТЬ ДанныеОтбора
			|ИЗ
			|	ДанныеОСПослеОтбора КАК ДанныеОСПослеОтбора
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВсеОстаткиРН КАК МестонахождениеОССрезПоследних
			|		ПО ДанныеОСПослеОтбора.ОбъектНФА = МестонахождениеОССрезПоследних.ОсновноеСредство"
			+ ОбщегоНазначения.РазделительПакетаЗапросов();
			
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
	
КонецФункции

Функция ДополнитьТекстЗапросаИнвентаризацияПоУчетуИНВ() Экспорт

	Если ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
		
		ТекстЗапроса = ОбщегоНазначения.РазделительПакетаЗапросов() + 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
				|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК КапвложениеИК,
				|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО
				|ПОМЕСТИТЬ ДанныеПоКапвложениямИК
				|ИЗ
				|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
				|			&ДатаСведений,
				|			Счет В ИЕРАРХИИ (&МассивСчетовКапвложенийИК),
				|			&МассивСубконтоОС,
				|			Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
				|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
				|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
				|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
				|	ВЫБОР
				|		КОГДА ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт = 0
				|			ТОГДА 1
				|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
				|	КОНЕЦ КАК Количество
				|ПОМЕСТИТЬ ДанныеМЦПоЦМО
				|ИЗ
				|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
				|			&ДатаСведений,
				|			Счет В ИЕРАРХИИ (&МассивСчетовМЦ),
				|			&МассивСубконтоМЦ,
				|			Организация = &Организация
				|				И НЕ (Субконто1 В (ВЫБРАТЬ ДанныеПоКапвложениямИК.КапвложениеИК ИЗ ДанныеПоКапвложениямИК КАК ДанныеПоКапвложениямИК))
				|				И &ПодразделенияНет) КАК ЖурналПроводокЕПСБУОстатки
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
				|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
				|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
				|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК ОбщееКоличество
				|ПОМЕСТИТЬ ОстаткиМЦ
				|ИЗ
				|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
				|			&ДатаСведений,
				|			Счет В ИЕРАРХИИ (&МассивСчетовМЗ),
				|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура),
				|			Организация = &Организация
				|				И &ПодразделенияНет) КАК ЖурналПроводокЕПСБУОстатки
				|ГДЕ
				|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ЖурналПроводокЕПСБУОстатки.Организация,
				|	ЖурналПроводокЕПСБУОстатки.Субконто1,
				|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
				|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
				|ИЗ
				|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаСведений, Счет В ИЕРАРХИИ (&МассивСчетовМЗИК), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), ) КАК ЖурналПроводокЕПСБУОстатки
				|ГДЕ
				|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ЖурналПроводокЕПСБУОстатки.Организация,
				|	ЖурналПроводокЕПСБУОстатки.Субконто1,
				|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
				|	ВЫБОР
				|		КОГДА ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт = 0
				|			ТОГДА 1
				|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
				|	КОНЕЦ
				|ИЗ
				|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаСведений, Счет В ИЕРАРХИИ (&МассивСчетовМЦ), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность),) КАК ЖурналПроводокЕПСБУОстатки
				|
				|ОБЪЕДИНИТЬ ВСЕ
				| 
				|ВЫБРАТЬ
				|	ЖурналПроводокЕПСБУОстатки.Организация,
				|	ЖурналПроводокЕПСБУОстатки.Субконто1,
				|	МестонахождениеОС.ИнвНомер,
				|	ВЫБОР
				|		КОГДА ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт = 0
				|			ТОГДА 1
				|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
				|	КОНЕЦ
				|ИЗ
				|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаСведений, Счет В ИЕРАРХИИ(&МассивСчетовОС) И Счет.Код <> ""МЦК"", &МассивСубконтоОС,) КАК ЖурналПроводокЕПСБУОстатки
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МестонахождениеОС КАК МестонахождениеОС
				|		По МестонахождениеОС.ОсновноеСредство = ЖурналПроводокЕПСБУОстатки.Субконто1
				|		И МестонахождениеОС.ЦМО = ЖурналПроводокЕПСБУОстатки.Субконто2 
				|		И МестонахождениеОС.ИнвНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ОстаткиМЦ.Организация КАК Организация,
				|	ОстаткиМЦ.ОбъектНФА КАК ОбъектНФА,
				|	ОстаткиМЦ.ИнвНомер КАК ИнвНомер,
				|	СУММА(ОстаткиМЦ.ОбщееКоличество) КАК ОбщееКоличество
				|ПОМЕСТИТЬ ОстаткиМЦВсего
				|ИЗ
				|	ОстаткиМЦ КАК ОстаткиМЦ
				|
				|СГРУППИРОВАТЬ ПО
				|	ОстаткиМЦ.Организация,
				|	ОстаткиМЦ.ОбъектНФА,
				|	ОстаткиМЦ.ИнвНомер
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ДанныеМЦПоЦМО.Организация КАК Организация,
				|	ДанныеМЦПоЦМО.ОбъектНФА КАК ОбъектНФА,
				|	ДанныеМЦПоЦМО.ИнвНомер КАК ИнвНомер,
				|	ДанныеМЦПоЦМО.ЦМО КАК ЦМО,
				|	ДанныеМЦПоЦМО.Количество КАК Количество,
				|	ОстаткиМЦВсего.ОбщееКоличество КАК ОбщееКоличество,
				|	ЕСТЬNULL(ВЫРАЗИТЬ(ДанныеМЦПоЦМО.ОбъектНФА КАК Справочник.Номенклатура).ЕдиницаИзмерения, &ЕдиницаИзмерения) КАК ЕдиницаИзмерения
				|ПОМЕСТИТЬ ИтоговыеДанныеОбОстаткахМЦ
				|ИЗ
				|	ДанныеМЦПоЦМО КАК ДанныеМЦПоЦМО
				|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиМЦВсего КАК ОстаткиМЦВсего
				|		ПО ДанныеМЦПоЦМО.Организация = ОстаткиМЦВсего.Организация
				|			И ДанныеМЦПоЦМО.ОбъектНФА = ОстаткиМЦВсего.ОбъектНФА
				|			И ДанныеМЦПоЦМО.ИнвНомер = ОстаткиМЦВсего.ИнвНомер
				|ГДЕ
				|	ДанныеМЦПоЦМО.ЦМО В(&МассивЦМО)
				|	И ДанныеМЦПоЦМО.Организация = &Организация
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ИтоговыеДанныеОбОстаткахОС.Организация КАК Организация,
				|	ИтоговыеДанныеОбОстаткахОС.ОбъектНФА КАК ОбъектНФА,
				|	ИтоговыеДанныеОбОстаткахОС.ЦМО КАК ЦМО,
				|	ИтоговыеДанныеОбОстаткахОС.ИнвНомер КАК ИнвНомер,
				|	ИтоговыеДанныеОбОстаткахОС.Количество КАК Количество,
				|	ИтоговыеДанныеОбОстаткахОС.ОбщееКоличество КАК ОбщееКоличество,
				|	ИтоговыеДанныеОбОстаткахОС.ЕдиницаИзмерения КАК ЕдиницаИзмерения
				|ПОМЕСТИТЬ ДанныеМЦ
				|ИЗ
				|	ИтоговыеДанныеОбОстаткахОС КАК ИтоговыеДанныеОбОстаткахОС
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ИтоговыеДанныеОбОстаткахМЗ.Организация,
				|	ИтоговыеДанныеОбОстаткахМЗ.ОбъектНФА,
				|	ИтоговыеДанныеОбОстаткахМЗ.ЦМО,
				|	ИтоговыеДанныеОбОстаткахМЗ.ИнвНомер,
				|	ИтоговыеДанныеОбОстаткахМЗ.Количество,
				|	ИтоговыеДанныеОбОстаткахМЗ.ОбщееКоличество,
				|	ИтоговыеДанныеОбОстаткахМЗ.ЕдиницаИзмерения
				|ИЗ
				|	ИтоговыеДанныеОбОстаткахМЗ КАК ИтоговыеДанныеОбОстаткахМЗ
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ИтоговыеДанныеОбОстаткахМЦ.Организация,
				|	ИтоговыеДанныеОбОстаткахМЦ.ОбъектНФА,
				|	ИтоговыеДанныеОбОстаткахМЦ.ЦМО,
				|	ИтоговыеДанныеОбОстаткахМЦ.ИнвНомер,
				|	ИтоговыеДанныеОбОстаткахМЦ.Количество,
				|	ИтоговыеДанныеОбОстаткахМЦ.ОбщееКоличество,
				|	ИтоговыеДанныеОбОстаткахМЦ.ЕдиницаИзмерения
				|ИЗ
				|	ИтоговыеДанныеОбОстаткахМЦ КАК ИтоговыеДанныеОбОстаткахМЦ" 
				+ ОбщегоНазначения.РазделительПакетаЗапросов();
				
	Иначе
		
		ТекстЗапроса = ОбщегоНазначения.РазделительПакетаЗапросов() +
				"ВЫБРАТЬ
				|	ИтоговыеДанныеОбОстаткахОС.Организация КАК Организация,
				|	ИтоговыеДанныеОбОстаткахОС.ОбъектНФА КАК ОбъектНФА,
				|	ИтоговыеДанныеОбОстаткахОС.ЦМО КАК ЦМО,
				|	ИтоговыеДанныеОбОстаткахОС.ИнвНомер КАК ИнвНомер,
				|	ИтоговыеДанныеОбОстаткахОС.Количество КАК Количество,
				|	ИтоговыеДанныеОбОстаткахОС.ОбщееКоличество КАК ОбщееКоличество,
				|	ИтоговыеДанныеОбОстаткахОС.ЕдиницаИзмерения КАК ЕдиницаИзмерения
				|ПОМЕСТИТЬ ДанныеМЦ
				|ИЗ
				|	ИтоговыеДанныеОбОстаткахОС КАК ИтоговыеДанныеОбОстаткахОС
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ИтоговыеДанныеОбОстаткахМЗ.Организация,
				|	ИтоговыеДанныеОбОстаткахМЗ.ОбъектНФА,
				|	ИтоговыеДанныеОбОстаткахМЗ.ЦМО,
				|	ИтоговыеДанныеОбОстаткахМЗ.ИнвНомер,
				|	ИтоговыеДанныеОбОстаткахМЗ.Количество,
				|	ИтоговыеДанныеОбОстаткахМЗ.ОбщееКоличество,
				|	ИтоговыеДанныеОбОстаткахМЗ.ЕдиницаИзмерения
				|ИЗ
				|	ИтоговыеДанныеОбОстаткахМЗ КАК ИтоговыеДанныеОбОстаткахМЗ" 
				+ ОбщегоНазначения.РазделительПакетаЗапросов();
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ДополнитьТекстЗапросаИнвентаризацияПоУчетуИНВИК() Экспорт

	Если ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
		
		ТекстЗапроса = ОбщегоНазначения.РазделительПакетаЗапросов() + 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК КапвложениеИК
			|ПОМЕСТИТЬ ДанныеПоКапвложениямИК
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В ИЕРАРХИИ (&МассивСчетовКапвложенийИК),
			|			&МассивСубконтоКапвложений,
			|			Организация = &Организация
			|			И &ОтобратьКапвложенияПоЦМО) КАК ЖурналПроводокЕПСБУОстатки
			|;
			|///////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОбъектНФА,
			|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество
			|ПОМЕСТИТЬ ДанныеОСОстаток
			|ИЗ
			|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И &ПодразделенияНет
			|				И ОсновноеСредство В
			|					(ВЫБРАТЬ
			|						СписокОС.ОсновноеСредство
			|					ИЗ
			|						СписокОС КАК СписокОС)) КАК СтоимостьОбъектовОСОстатки
			|ГДЕ
			|	СтоимостьОбъектовОСОстатки.КоличествоОстаток > 0
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЗ),
			|			&МассивСубконтоМЗ,
			|			Организация = &Организация
			|				И &ПодразделенияНет) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
            |
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто2,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В ИЕРАРХИИ (&МассивСчетовМЦ),
			|			&МассивСубконтоМЦ,
			|			Организация = &Организация
			|				И (Субконто1 В (ВЫБРАТЬ ДанныеПоКапвложениямИК.КапвложениеИК ИЗ ДанныеПоКапвложениямИК КАК ДанныеПоКапвложениямИК))
			|				И &ПодразделенияНет) КАК ЖурналПроводокЕПСБУОстатки 
			|;
			|///////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДанныеОСОстаток.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеОСОстаток.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	СУММА(ДанныеОСОстаток.Количество) КАК Количество
			|ПОМЕСТИТЬ ДанныеОС	
			|ИЗ
			|   ДанныеОСОстаток КАК ДанныеОСОстаток
			|СГРУППИРОВАТЬ ПО
			|    ДанныеОСОстаток.ОбъектНФА,
			|    ДанныеОСОстаток.ИнвентарныйНомер" 
			+ ОбщегоНазначения.РазделительПакетаЗапросов();
				
	Иначе
		
		ТекстЗапроса = ОбщегоНазначения.РазделительПакетаЗапросов() +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОбъектНФА,
			|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество
			|ПОМЕСТИТЬ ДанныеОС
			|ИЗ
			|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И &ПодразделенияНет
			|				И ОсновноеСредство В
			|					(ВЫБРАТЬ
			|						СписокОС.ОсновноеСредство
			|					ИЗ
			|						СписокОС КАК СписокОС)) КАК СтоимостьОбъектовОСОстатки
			|ГДЕ
			|	СтоимостьОбъектовОСОстатки.КоличествоОстаток > 0
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЗ),
			|			&МассивСубконтоМЗ,
			|			Организация = &Организация
			|				И &ПодразделенияНет) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0" 
			+ ОбщегоНазначения.РазделительПакетаЗапросов();
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
	
КонецФункции

