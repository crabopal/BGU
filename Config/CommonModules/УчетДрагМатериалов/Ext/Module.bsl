	               |	ДанныеНФА.МассаДМУчетВЕдИзмОтчета КАК МассаДМУчетВЕдИзмОтчета
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, Запись, Счет В (&МассивСчетовМЗ), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), Организация = &Организация, , ) КАК ЖурналПроводокЕПСБУОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ИтогиДМ КАК ДанныеНФА
	               |		ПО ЖурналПроводокЕПСБУОбороты.Субконто1 = ДанныеНФА.ОбъектНФА
	               |ГДЕ
	               |	&НетОтбораПоТипуОбъекта
	               |	И ДанныеНФА.МассаДМУчетВЕдИзмОтчета > 0";

	
	Если (МассивТиповОбъектовМЗ = Неопределено) И (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта",Истина);
	ИначеЕсли (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "ДанныеНФА.ТипОбъекта В (&МассивТиповОбъектовМЗ)");
		Запрос.УстановитьПараметр("МассивТиповОбъектовМЗ", МассивТиповОбъектовМЗ);
	ИначеЕсли (МассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "НЕ (ДанныеНФА.ТипОбъекта В (&НеВыбиратьМассивТиповОбъектовМЗ))");
		Запрос.УстановитьПараметр("НеВыбиратьМассивТиповОбъектовМЗ", НеВыбиратьМассивТиповОбъектовМЗ);
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("Организация", Организация);			   
	Запрос.УстановитьПараметр("СписокРегистраторовСписания", СписокРегистраторовСписания);			   
	Запрос.УстановитьПараметр("МассивСчетовМЗ", МассивСчетовМЗ);			   
	Запрос.УстановитьПараметр("ДрагМатериалы", ДрагМатериалы);			   
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);			   
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);			   
	Запрос.УстановитьПараметр("ОтчетДМ",	ВидОтчета);  
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Штуки());
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;                   
	
КонецФункции

Функция ПереданоРеализованоВОтчетномПериодеМЗ(ВидОтчета, Организация, МассивСчетовМЗ, МассивТиповОбъектовМЗ = Неопределено, НеВыбиратьМассивТиповОбъектовМЗ = Неопределено, ДрагМатериалы, НачалоПериода, КонецПериода)
	
	СписокРегистраторовПередачи = Новый Массив;
	СписокРегистраторовПередачи.Добавить(Тип("ДокументСсылка.ТребованиеНакладная0315006"));
	СписокРегистраторовПередачи.Добавить(Тип("ДокументСсылка.НакладнаяНаОтпускМ15"));
	СписокРегистраторовПередачи.Добавить(Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12"));
	СписокРегистраторовПередачи.Добавить(Тип("ДокументСсылка.ТребованиеНакладнаяИК")); 
	Если ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
		СписокРегистраторовПередачи.Добавить(Тип("ДокументСсылка.ПередачаОбъектовОС"));
		СписокРегистраторовПередачи.Добавить(Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС"));
		СписокРегистраторовПередачи.Добавить(Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС")); 
		СписокРегистраторовПередачи.Добавить(Тип("ДокументСсылка.ПередачаОбъектовИК"));
		СписокРегистраторовПередачи.Добавить(Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК"));
		СписокРегистраторовПередачи.Добавить(Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК"));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
				"ВЫБРАТЬ
				|	НаличиеДрагМатериаловВОбъектахНФАОбороты.ОбъектНФА КАК ОбъектНФА,
				|	НаличиеДрагМатериаловВОбъектахНФАОбороты.ЕдИзм КАК ЕдИзм,
				|	НаличиеДрагМатериаловВОбъектахНФАОбороты.ВидДрагМатериала КАК ВидДрагМатериала,
				|	ЕСТЬNULL(НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент, 0) КАК Коэффициент,
				|	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.МассаДМРасход * ВЫБОР
				|			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент ЕСТЬ NULL
				|				ТОГДА 1
				|			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент = 0
				|				ТОГДА 1
				|			ИНАЧЕ НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент
				|		КОНЕЦ КАК ЧИСЛО(17, 8)) КАК МассаДМУчетВЕдИзмОтчета,
				|	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта
				|ПОМЕСТИТЬ ДанныеНФА
				|ИЗ
				|	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Обороты(
				|			&НачалоПериода,
				|			&КонецПериода,
				|			Запись,
				|			Организация = &Организация
				|				И ОбъектНФА ССЫЛКА Справочник.Номенклатура
				|				И ВидДрагМатериала В (&ДрагМатериалы)) КАК НаличиеДрагМатериаловВОбъектахНФАОбороты
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
				|		ПО НаличиеДрагМатериаловВОбъектахНФАОбороты.ЕдИзм = НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
				|				&КонецПериода,
				|				Организация = &Организация
				|					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
				|		ПО НаличиеДрагМатериаловВОбъектахНФАОбороты.ОбъектНФА = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА 
				|ГДЕ
				|	ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) В (&СписокРегистраторовПередачи)
				|	И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.ПередачаОбъектовОС)
				|			И ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.ПередачаОбъектовОС).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106))
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ДанныеНФА.ОбъектНФА КАК ОбъектНФА,
				|	ДанныеНФА.ЕдИзм КАК ЕдИзм,
				|	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
				|	ДанныеНФА.Коэффициент КАК Коэффициент,
				|	СУММА(ДанныеНФА.МассаДМУчетВЕдИзмОтчета) КАК МассаДМУчетВЕдИзмОтчета,
				|	ДанныеНФА.ТипОбъекта КАК ТипОбъекта
				|ПОМЕСТИТЬ ИтогиДМ
				|ИЗ
				|	ДанныеНФА КАК ДанныеНФА
				|
				|СГРУППИРОВАТЬ ПО
				|	ДанныеНФА.ЕдИзм,
				|	ДанныеНФА.ВидДрагМатериала,
				|	ДанныеНФА.ОбъектНФА,
				|	ДанныеНФА.ТипОбъекта,
				|	ДанныеНФА.Коэффициент
				|;
				|////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК ОбъектНФА,
				|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
				|	ВЫБОР
				|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто1 ССЫЛКА Справочник.Номенклатура
				|			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто1.ЕдиницаИзмерения
				|		ИНАЧЕ &ЕдиницаИзмерения
				|	КОНЕЦ КАК ЕдиницаИзмерения,
				|	0 КАК Количество,
				|	ДанныеНФА.ЕдИзм КАК ЕдИзм,
				|	ДанныеНФА.Коэффициент КАК Коэффициент,
				|	ДанныеНФА.ТипОбъекта КАК ТипОбъекта,
				|	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
				|	ДанныеНФА.МассаДМУчетВЕдИзмОтчета КАК МассаДМУчетВЕдИзмОтчета
				|ИЗ
				|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, Запись, Счет В (&МассивСчетовМЗ), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), Организация = &Организация, , ) КАК ЖурналПроводокЕПСБУОбороты
				|		ЛЕВОЕ СОЕДИНЕНИЕ ИтогиДМ КАК ДанныеНФА
				|		ПО ЖурналПроводокЕПСБУОбороты.Субконто1 = ДанныеНФА.ОбъектНФА
				|ГДЕ
				|	&НетОтбораПоТипуОбъекта
				|	И ДанныеНФА.МассаДМУчетВЕдИзмОтчета > 0
				|   И ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОбороты.Регистратор) В (&СписокРегистраторовПередачи)
				|	И НЕ (ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОбороты.Регистратор) = ТИП(Документ.ТребованиеНакладная0315006)
				|			И ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Регистратор КАК Документ.ТребованиеНакладная0315006).ВключатьМЦВСоставКапвложений)";
	
	Если ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
		
		Запрос.Текст = Запрос.Текст +
				"
				|ОБЪЕДИНИТЬ
				|
				|ВЫБРАТЬ
				|	ЖурналПроводокЕПСБУОбороты.Субконто1,
				|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
				|	ВЫБОР
				|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто1 ССЫЛКА Справочник.Номенклатура
				|			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто1.ЕдиницаИзмерения
				|		ИНАЧЕ &ЕдиницаИзмерения
				|	КОНЕЦ,
				|	0,
				|	ДанныеНФА.ЕдИзм,
				|	ДанныеНФА.Коэффициент,
				|	ДанныеНФА.ТипОбъекта,
				|	ДанныеНФА.ВидДрагМатериала,
				|	ДанныеНФА.МассаДМУчетВЕдИзмОтчета
				|ИЗ
				|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, Запись, Счет В (&МассивСчетовМЗ), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность), Организация = &Организация И Субконто1 ССЫЛКА Справочник.Номенклатура, , ) КАК ЖурналПроводокЕПСБУОбороты
				|		ЛЕВОЕ СОЕДИНЕНИЕ ИтогиДМ КАК ДанныеНФА
				|		ПО ЖурналПроводокЕПСБУОбороты.Субконто1 = ДанныеНФА.ОбъектНФА 
				|ГДЕ
				|	&НетОтбораПоТипуОбъекта
				|	И ДанныеНФА.МассаДМУчетВЕдИзмОтчета > 0  
				|	И ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОбороты.Регистратор) В (&СписокРегистраторовПередачи)
				|	И НЕ (ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОбороты.Регистратор) = ТИП(Документ.ТребованиеНакладная0315006)
				|			И ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Регистратор КАК Документ.ТребованиеНакладная0315006).ВключатьМЦВСоставКапвложений)
				|	И НЕ (ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОбороты.Регистратор) = ТИП(Документ.ПередачаОбъектовОС)
				|			И ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Регистратор КАК Документ.ПередачаОбъектовОС).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106))";    
						
	КонецЕсли;
	
	Если (МассивТиповОбъектовМЗ = Неопределено) И (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта",Истина);
	ИначеЕсли (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "ДанныеНФА.ТипОбъекта В (&МассивТиповОбъектовМЗ)");
		Запрос.УстановитьПараметр("МассивТиповОбъектовМЗ", МассивТиповОбъектовМЗ);
	ИначеЕсли (МассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "НЕ (ДанныеНФА.ТипОбъекта В (&НеВыбиратьМассивТиповОбъектовМЗ))");
		Запрос.УстановитьПараметр("НеВыбиратьМассивТиповОбъектовМЗ", НеВыбиратьМассивТиповОбъектовМЗ);
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("Организация", Организация);			   
	Запрос.УстановитьПараметр("СписокРегистраторовПередачи", СписокРегистраторовПередачи);			   
	Запрос.УстановитьПараметр("МассивСчетовМЗ", МассивСчетовМЗ);			   
	Запрос.УстановитьПараметр("ДрагМатериалы", ДрагМатериалы);			   
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);			   
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);			   
	Запрос.УстановитьПараметр("ОтчетДМ",	ВидОтчета);  
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Штуки());
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;
	
КонецФункции

Функция ПолучитьМассивОКОФ(СтрокаКодов) Экспорт
	
	МассивКодов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаКодов, ",");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивКодов", МассивКодов);
	Запрос.Текст = "ВЫБРАТЬ
	               |	СправочникОКОФ.Ссылка КАК ОКОФ
	               |ПОМЕСТИТЬ КодыОКОФ
	               |ИЗ
	               |	Справочник.ОбщероссийскийКлассификаторОсновныхФондов КАК СправочникОКОФ
	               |ГДЕ
	               |	СправочникОКОФ.Код В(&МассивКодов)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СправочникОКОФ.Ссылка.Код КАК ОКОФ
	               |ИЗ
	               |	Справочник.ОбщероссийскийКлассификаторОсновныхФондов КАК СправочникОКОФ
	               |ГДЕ
	               |	СправочникОКОФ.Ссылка В ИЕРАРХИИ
	               |			(ВЫБРАТЬ
	               |				КодыОКОФ.ОКОФ
	               |			ИЗ
	               |				КодыОКОФ КАК КодыОКОФ)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОКОФ";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОКОФ");
	
КонецФункции

Функция ОстаткиЛомаОтходовНаПериодДляМЗ(ВидОтчета, Организация, МассивСчетовМЗ, МассивИсточниковОбразования = Неопределено, МассивТиповОбъектовМЗ = Неопределено, НеВыбиратьМассивТиповОбъектовМЗ = Неопределено, ДрагМатериалы, ПериодСведений)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
			|	НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта КАК ТипОбъекта,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
			|ПОМЕСТИТЬ ДанныеОСВсе
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&МассивСчетовМЗ), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
			|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
			|	И &НетОтбораПоТипуОбъекта
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
			|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
			|	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
			|ПОМЕСТИТЬ ДанныеОС
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&МассивСчетовМЗ), &МассивСубконтоМЗ, Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
			|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
			|	И &НетОтбораПоТипуОбъекта
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДанныеОС.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ДанныеОС.ЦМО КАК ЦМО,
			|	ДанныеОС.Количество КАК Количество,
			|	ЕСТЬNULL(ДанныеОСВсе.Количество, 1) КАК КоличествоВсего
			|ПОМЕСТИТЬ ПолныеДанныеОС
			|ИЗ
			|	ДанныеОС КАК ДанныеОС
			|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеОСВсе КАК ДанныеОСВсе
			|		ПО (ДанныеОСВсе.ОбъектНФА = ДанныеОС.ОбъектНФА)
			|			И (ДанныеОСВсе.ИнвентарныйНомер = ДанныеОС.ИнвентарныйНомер)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеОС.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ДанныеОС.Количество КАК Количество,
			|	ДанныеОС.КоличествоВсего КАК КоличествоВсего,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
			|	ВЫРАЗИТЬ(НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток * ДанныеОС.Количество / ДанныеОС.КоличествоВсего КАК ЧИСЛО(17, 8)) КАК МассаДМУчет,
			|	ВЫБОР
			|		КОГДА ДанныеОС.ОбъектНФА ССЫЛКА Справочник.Номенклатура
			|			ТОГДА ДанныеОС.ОбъектНФА.ЕдиницаИзмерения
			|		ИНАЧЕ &ЕдиницаИзмерения
			|	КОНЕЦ КАК ЕдиницаИзмерения,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЕдИзм КАК ЕдиницаИзмеренияДрагМатериала
			|ПОМЕСТИТЬ ДанныеВУчетныхЕдиницах
			|ИЗ
			|	ПолныеДанныеОС КАК ДанныеОС
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВЛомеИОтходах.Остатки(
			|				&Период,
			|				Организация = &Организация
			|					И &НетОтбораПоИсточникуОбразования) КАК НаличиеДрагМатериаловВЛомеИОтходахОстатки
			|		ПО ДанныеОС.ОбъектНФА = НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА
			|ГДЕ
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток > 0
			|	И НаличиеДрагМатериаловВЛомеИОтходахОстатки.ВидДрагМатериала В(&ДрагМатериалы)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения КАК УчетнаяЕдиницаИзмерения,
			|	НастройкиЕдиницИзмеренияДрагМатериалов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент
			|ПОМЕСТИТЬ НастройкиЕдиницУчета
			|ИЗ
			|	РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
			|ГДЕ
			|	НастройкиЕдиницИзмеренияДрагМатериалов.Организация = &Организация
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДанныеВУчетныхЕдиницах.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеВУчетныхЕдиницах.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ДанныеВУчетныхЕдиницах.Количество КАК Количество,
			|	ДанныеВУчетныхЕдиницах.КоличествоВсего КАК КоличествоВсего,
			|	ДанныеВУчетныхЕдиницах.ВидДрагМатериала КАК ВидДрагМатериала,
			|	ВЫРАЗИТЬ(ДанныеВУчетныхЕдиницах.МассаДМУчет * ВЫБОР
			|			КОГДА НастройкиЕдиницУчета.Коэффициент ЕСТЬ NULL
			|				ТОГДА 1
			|			КОГДА НастройкиЕдиницУчета.Коэффициент = 0
			|				ТОГДА 1
			|			ИНАЧЕ НастройкиЕдиницУчета.Коэффициент
			|		КОНЕЦ КАК ЧИСЛО(17, 8)) КАК МассаДМУчетВЕдИзмОтчета,
			|	ДанныеВУчетныхЕдиницах.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ДанныеВУчетныхЕдиницах.ЕдиницаИзмеренияДрагМатериала КАК ЕдиницаИзмеренияДрагМатериала
			|ИЗ
			|	ДанныеВУчетныхЕдиницах КАК ДанныеВУчетныхЕдиницах
			|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиЕдиницУчета КАК НастройкиЕдиницУчета
			|		ПО ДанныеВУчетныхЕдиницах.ЕдиницаИзмеренияДрагМатериала = НастройкиЕдиницУчета.УчетнаяЕдиницаИзмерения
			|ГДЕ
			|	ДанныеВУчетныхЕдиницах.МассаДМУчет > 0";			
	
	Если (МассивТиповОбъектовМЗ = Неопределено) И (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта",Истина);
	ИначеЕсли (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &НетОтбораПоТипуОбъекта", "И ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) В (&МассивТиповОбъектовМЗ)");
		Запрос.УстановитьПараметр("МассивТиповОбъектовМЗ", МассивТиповОбъектовМЗ);
	ИначеЕсли (МассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &НетОтбораПоТипуОбъекта", "И НЕ (ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) В (&НеВыбиратьМассивТиповОбъектовМЗ))");
		Запрос.УстановитьПараметр("НеВыбиратьМассивТиповОбъектовМЗ", НеВыбиратьМассивТиповОбъектовМЗ);
	КонецЕсли;
	
	Если МассивИсточниковОбразования = Неопределено Тогда
		Запрос.УстановитьПараметр("НетОтбораПоИсточникуОбразования",Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &НетОтбораПоИсточникуОбразования", "И ИсточникОбразования В (&МассивИсточниковОбразования)");
		Запрос.УстановитьПараметр("МассивИсточниковОбразования", МассивИсточниковОбразования);
	КонецЕсли;	
			
	МассивСубконтоМЗ = Новый Массив;
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	ЕдиницаИзмеренияДМ = ЕдиницаИзмеренияДрагМатериалов(ДрагМатериалы);
	
	Запрос.УстановитьПараметр("Период", 			ПериодСведений);
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Штуки());
	Запрос.УстановитьПараметр("МассивСчетовМЗ",		МассивСчетовМЗ);
	Запрос.УстановитьПараметр("МассивСубконтоМЗ",	МассивСубконтоМЗ);
	Запрос.УстановитьПараметр("ДрагМатериалы",		ДрагМатериалы);
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияДМ",	ЕдиницаИзмеренияДМ);  
	Запрос.УстановитьПараметр("ОтчетДМ",			ВидОтчета);  
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;
КонецФункции	

Функция ПоступилоЛомаОтходовВОтчетномПериодеМЗ(ВидОтчета, Организация, МассивСчетовМЗ, МассивИсточниковОбразования = Неопределено, МассивТиповОбъектовМЗ = Неопределено, НеВыбиратьМассивТиповОбъектовМЗ = Неопределено, ДрагМатериалы, НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НаличиеДрагМатериаловВОбъектахНФАОбороты.ОбъектНФА КАК ОбъектНФА,
	|	НаличиеДрагМатериаловВОбъектахНФАОбороты.ЕдИзм КАК ЕдИзм,
	|	НаличиеДрагМатериаловВОбъектахНФАОбороты.ВидДрагМатериала КАК ВидДрагМатериала,
	|	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент,
	|	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.ЧистаяМассаПриход * ВЫБОР
	|			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент ЕСТЬ NULL
	|				ТОГДА 1
	|			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент = 0
	|				ТОГДА 1
	|			ИНАЧЕ НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент
	|		КОНЕЦ КАК ЧИСЛО(17, 8)) КАК МассаДМУчетВЕдИзмОтчета,
	|	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта
	|ПОМЕСТИТЬ ДанныеНФА
	|ИЗ
	|	РегистрНакопления.НаличиеДрагМатериаловВЛомеИОтходах.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Запись,
	|			Организация = &Организация
	|				И ОбъектНФА ССЫЛКА Справочник.Номенклатура
	|				И ВидДрагМатериала В (&ДрагМатериалы)
	|				И &НетОтбораПоИсточникуОбразования) КАК НаличиеДрагМатериаловВОбъектахНФАОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
	|		ПО НаличиеДрагМатериаловВОбъектахНФАОбороты.ЕдИзм = НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
	|				&КонецПериода,
	|				Организация = &Организация
	|					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
	|		ПО НаличиеДрагМатериаловВОбъектахНФАОбороты.ОбъектНФА = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеНФА.ОбъектНФА КАК ОбъектНФА,
	|	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
	|	СУММА(ДанныеНФА.МассаДМУчетВЕдИзмОтчета) КАК МассаДМУчетВЕдИзмОтчета,
	|	ДанныеНФА.ТипОбъекта КАК ТипОбъекта,
	|	ДанныеНФА.ЕдИзм КАК ЕдИзм,
	|	ДанныеНФА.Коэффициент КАК Коэффициент
	|ПОМЕСТИТЬ ИтогиДМ
	|ИЗ
	|	ДанныеНФА КАК ДанныеНФА
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеНФА.ОбъектНФА,
	|	ДанныеНФА.ВидДрагМатериала,
	|	ДанныеНФА.ТипОбъекта,
	|	ДанныеНФА.ЕдИзм,
	|	ДанныеНФА.Коэффициент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК ОбъектНФА,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто1 ССЫЛКА Справочник.Номенклатура
	|			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто1.ЕдиницаИзмерения
	|		ИНАЧЕ &ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	0 КАК Количество,
	|	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ДанныеНФА.МассаДМУчетВЕдИзмОтчета КАК МассаДМУчетВЕдИзмОтчета
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, Запись, Счет В (&МассивСчетовМЗ), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), Организация = &Организация, , ) КАК ЖурналПроводокЕПСБУОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИтогиДМ КАК ДанныеНФА
	|		ПО ЖурналПроводокЕПСБУОбороты.Субконто1 = ДанныеНФА.ОбъектНФА
	|ГДЕ
	|	&НетОтбораПоТипуОбъекта
	|	И ДанныеНФА.МассаДМУчетВЕдИзмОтчета > 0";	
				   
	Если (МассивТиповОбъектовМЗ = Неопределено) И (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта",Истина);
	ИначеЕсли (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "ДанныеНФА.ТипОбъекта В (&МассивТиповОбъектовМЗ)");
		Запрос.УстановитьПараметр("МассивТиповОбъектовМЗ", МассивТиповОбъектовМЗ);
	ИначеЕсли (МассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "НЕ (ДанныеНФА.ТипОбъекта В (&НеВыбиратьМассивТиповОбъектовМЗ))");
		Запрос.УстановитьПараметр("НеВыбиратьМассивТиповОбъектовМЗ", НеВыбиратьМассивТиповОбъектовМЗ);
	КонецЕсли;
	
	Если МассивИсточниковОбразования = Неопределено Тогда
		Запрос.УстановитьПараметр("НетОтбораПоИсточникуОбразования",Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &НетОтбораПоИсточникуОбразования", "И ИсточникОбразования В (&МассивИсточниковОбразования)");
		Запрос.УстановитьПараметр("МассивИсточниковОбразования", МассивИсточниковОбразования);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);			   
	Запрос.УстановитьПараметр("МассивСчетовМЗ", МассивСчетовМЗ);			   
	Запрос.УстановитьПараметр("ДрагМатериалы", ДрагМатериалы);			   
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);			   
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);			   
	Запрос.УстановитьПараметр("ОтчетДМ",	ВидОтчета);  
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Штуки());
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;
КонецФункции

Функция СданоЛомаОтходовВОтчетномПериодеМЗ(ВидОтчета, Организация, МассивСчетовМЗ, МассивИсточниковОбразования = Неопределено, МассивАналитикиОперации = Неопределено, МассивТиповОбъектовМЗ = Неопределено, НеВыбиратьМассивТиповОбъектовМЗ = Неопределено, ДрагМатериалы, НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НаличиеДрагМатериаловВЛомеИОтходах.ОбъектНФА КАК ОбъектНФА,
	               |	НаличиеДрагМатериаловВЛомеИОтходах.ЕдИзм КАК ЕдИзм,
	               |	НаличиеДрагМатериаловВЛомеИОтходах.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	ЕСТЬNULL(НаличиеДрагМатериаловВЛомеИОтходах.ЧистаяМасса, 0) КАК ЧистаяМассаРасход
	               |ПОМЕСТИТЬ НоменклатураЛомаОтходов
	               |ИЗ
	               |	РегистрНакопления.НаличиеДрагМатериаловВЛомеИОтходах КАК НаличиеДрагМатериаловВЛомеИОтходах
	               |ГДЕ
	               |	НаличиеДрагМатериаловВЛомеИОтходах.Период МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И НаличиеДрагМатериаловВЛомеИОтходах.Организация = &Организация
	               |	И НаличиеДрагМатериаловВЛомеИОтходах.ВидДрагМатериала В(&ДрагМатериалы)
	               |	И &НетОтбораПоИсточникуОбразования
	               |	И НаличиеДрагМатериаловВЛомеИОтходах.ОбъектНФА ССЫЛКА Справочник.Номенклатура
	               |	И НаличиеДрагМатериаловВЛомеИОтходах.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	               |	И &НетОтбораПоАналитикеОперации
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураЛомаОтходов.ОбъектНФА КАК ОбъектНФА,
	               |	НоменклатураЛомаОтходов.ЕдИзм КАК ЕдИзм,
	               |	НоменклатураЛомаОтходов.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент,
	               |	ВЫРАЗИТЬ(НоменклатураЛомаОтходов.ЧистаяМассаРасход * ВЫБОР
	               |			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент ЕСТЬ NULL
	               |				ТОГДА 1
	               |			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент = 0
	               |				ТОГДА 1
	               |			ИНАЧЕ НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент
	               |		КОНЕЦ КАК ЧИСЛО(17, 8)) КАК МассаДМУчетВЕдИзмОтчета,
	               |	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта
	               |ПОМЕСТИТЬ ДанныеНФА
	               |ИЗ
	               |	НоменклатураЛомаОтходов КАК НоменклатураЛомаОтходов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
	               |		ПО НоменклатураЛомаОтходов.ЕдИзм = НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
	               |				&КонецПериода,
	               |				Организация = &Организация
	               |					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
	               |		ПО НоменклатураЛомаОтходов.ОбъектНФА = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеНФА.ОбъектНФА КАК ОбъектНФА,
	               |	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	СУММА(ДанныеНФА.МассаДМУчетВЕдИзмОтчета) КАК МассаДМУчетВЕдИзмОтчета,
	               |	ДанныеНФА.ТипОбъекта КАК ТипОбъекта,
	               |	ДанныеНФА.ЕдИзм КАК ЕдИзм,
	               |	ДанныеНФА.Коэффициент КАК Коэффициент
	               |ПОМЕСТИТЬ ИтогиДМ
	               |ИЗ
	               |	ДанныеНФА КАК ДанныеНФА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДанныеНФА.ОбъектНФА,
	               |	ДанныеНФА.ВидДрагМатериала,
	               |	ДанныеНФА.ТипОбъекта,
	               |	ДанныеНФА.ЕдИзм,
	               |	ДанныеНФА.Коэффициент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК ОбъектНФА,
	               |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	               |	ВЫБОР
	               |		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто1 ССЫЛКА Справочник.Номенклатура
	               |			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто1.ЕдиницаИзмерения
	               |		ИНАЧЕ &ЕдиницаИзмерения
	               |	КОНЕЦ КАК ЕдиницаИзмерения,
	               |	0 КАК Количество,
	               |	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	ДанныеНФА.МассаДМУчетВЕдИзмОтчета КАК МассаДМУчетВЕдИзмОтчета
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, Запись, Счет В (&МассивСчетовМЗ), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), Организация = &Организация, , ) КАК ЖурналПроводокЕПСБУОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ИтогиДМ КАК ДанныеНФА
	               |		ПО ЖурналПроводокЕПСБУОбороты.Субконто1 = ДанныеНФА.ОбъектНФА
	               |ГДЕ
	               |	&НетОтбораПоТипуОбъекта
	               |	И ДанныеНФА.МассаДМУчетВЕдИзмОтчета > 0";			               
	
				   
	Если (МассивТиповОбъектовМЗ = Неопределено) И (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта",Истина);
	ИначеЕсли (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "ДанныеНФА.ТипОбъекта В (&МассивТиповОбъектовМЗ)");
		Запрос.УстановитьПараметр("МассивТиповОбъектовМЗ", МассивТиповОбъектовМЗ);
	ИначеЕсли (МассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "НЕ (ДанныеНФА.ТипОбъекта В (&НеВыбиратьМассивТиповОбъектовМЗ))");
		Запрос.УстановитьПараметр("НеВыбиратьМассивТиповОбъектовМЗ", НеВыбиратьМассивТиповОбъектовМЗ);
	КонецЕсли;
	
	Если МассивИсточниковОбразования = Неопределено Тогда
		Запрос.УстановитьПараметр("НетОтбораПоИсточникуОбразования",Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &НетОтбораПоИсточникуОбразования", "И НаличиеДрагМатериаловВЛомеИОтходах.ИсточникОбразования В (&МассивИсточниковОбразования)");
		Запрос.УстановитьПараметр("МассивИсточниковОбразования", МассивИсточниковОбразования);
	КонецЕсли;
	
	Если МассивАналитикиОперации = Неопределено Тогда
		Запрос.УстановитьПараметр("НетОтбораПоАналитикеОперации",Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &НетОтбораПоАналитикеОперации", "И НаличиеДрагМатериаловВЛомеИОтходах.АналитикаОперации В(&МассивАналитикиОперации)");
		Запрос.УстановитьПараметр("МассивАналитикиОперации", МассивАналитикиОперации);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);			   
	Запрос.УстановитьПараметр("МассивСчетовМЗ", МассивСчетовМЗ);			   
	Запрос.УстановитьПараметр("ДрагМатериалы", ДрагМатериалы);			   
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);			   
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода.Значение);			   
	Запрос.УстановитьПараметр("ОтчетДМ",	ВидОтчета);  
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Штуки());
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;
КонецФункции

#КонецОбласти

#Область ОтчетОДвиженииДрагМатериаловПоЦМО

Функция ДанныеПоСодержаниюДрагматериалов(Организация, ОбъектНФА, ИнвНомер, ВидДрагМатериала, ДатаСведений)  Экспорт
	Результат = Новый Структура;
	Результат.Вставить("МассаДМ", 0);
	Результат.Вставить("КоличествоДК", 0);
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(ОбъектНФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		Если ЗначениеЗаполнено(ИнвНомер) Тогда
			Запрос.Текст = "ВЫБРАТЬ
			               |	НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения КАК УчетнаяЕдиницаИзмерения,
			               |	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент
			               |ПОМЕСТИТЬ НастройкиЕдиницИзмерения
			               |ИЗ
			               |	РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
			               |ГДЕ
			               |	НастройкиЕдиницИзмеренияДрагМатериалов.Организация = &Организация
			               |	И НастройкиЕдиницИзмеренияДрагМатериалов.ЕдиницаИзмерения = &Граммы
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.Организация КАК Организация,
			               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОбъектНФА,
			               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер КАК ИнвНомер,
			               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
			               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм КАК ЕдИзм,
			               |	ВЫБОР
			               |		КОГДА ЕСТЬNULL(НастройкиЕдиницИзмерения.Коэффициент, 0) = 0
			               |			ТОГДА ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток КАК ЧИСЛО(17, 8))
			               |		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток * НастройкиЕдиницИзмерения.Коэффициент КАК ЧИСЛО(17, 8))
			               |	КОНЕЦ КАК МассаДМОстаток,
			               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток КАК КоличествоДМОстаток
			               |ИЗ
			               |	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(
			               |			&ДатаСведений,
			               |			Организация = &Организация
			               |				И ОбъектНФА = &ОбъектНФА
			               |				И ИнвНомер = &ИнвНомер
			               |				И ВидДрагМатериала = &ВидДрагМатериала) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
			               |		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиЕдиницИзмерения КАК НастройкиЕдиницИзмерения
			               |		ПО НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм = НастройкиЕдиницИзмерения.УчетнаяЕдиницаИзмерения";

		Иначе
			МассивСубконтоОС = Новый Массив;
			МассивСубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
			
			СчетаУчетаОС = ПолучитьМассивСчетовДМДляОС(Истина);
			СчетаУчетаОС = ДополнитьМассивСчетовДМДляМЦ(Организация, СчетаУчетаОС, "Основные средства");
						   
