Функция ДанныеДляСправкиДляВнутреннегоПеремещения(МассивОбъектовПеремещения)
	
	//НаименованиеДокумента = НСтр("ru = '""Внутреннее перемещение ОС, НМА, НПА""'");
	//НаименованиеДокумента = НСтр("ru = '""Ведомость на выдачу ОС на нужды учреждения""'");

	//НаименованиеДокумента = НСтр("ru = '""Ведомость на выдачу МЗ на нужды учреждения""'");
	//НаименованиеДокумента = НСтр("ru = '""Требование - накладная (Материальные запасы)""'");
	
	МассивОбъектов = Новый Массив;
	Для Каждого ТекОбъект Из МассивОбъектовПеремещения Цикл
		ДобавитьВМассивОбъектов = Истина;
		Если ТипЗнч(ТекОбъект) = Тип("ДокументСсылка.ВедомостьНаВыдачуМЗНаНуждыУчреждения")
			ИЛИ ТипЗнч(ТекОбъект) = Тип("ДокументСсылка.ТребованиеНакладная0315006") Тогда
			Если ТекОбъект.ДрагоценныеМатериалы.Количество() > 0 Тогда
				ДобавитьВМассивОбъектов = Ложь;
			КонецЕсли;	
		КонецЕсли;
		Если ДобавитьВМассивОбъектов Тогда
			МассивОбъектов.Добавить(ТекОбъект);
		КонецЕсли;	
	КонецЦикла;	

	МассивТиповНеМЗ = ПолучитьМассивТиповНоменклатурыБезДрагМатериалов();
	
	СчетаУчетаОС = ПолучитьМассивСчетовДМДляОС(Истина);
	СчетаУчетаОС = ДополнитьМассивСчетовДМДляМЦ( , СчетаУчетаОС, "Основные средства");
	
	СписокОбъектовНФА = СписокОбъектовНФАПеремещения(МассивОбъектов);
	
	ОстаткиДМДляОбъектовНФА = Новый ТаблицаЗначений;
	
	ОстаткиДМДляОбъектовНФА.Колонки.Добавить("Ссылка", Документы.ТипВсеСсылки());
	ОстаткиДМДляОбъектовНФА.Колонки.Добавить("ОбъектНФА", Справочники.ТипВсеСсылки());
	ОстаткиДМДляОбъектовНФА.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ОстаткиДМДляОбъектовНФА.Колонки.Добавить("ВидДрагМатериала", Новый ОписаниеТипов("СправочникСсылка.ДрагМеталлы"));
	ОстаткиДМДляОбъектовНФА.Колонки.Добавить("ТипДрагМатериала", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыДрагМатериалов"));
	ОстаткиДМДляОбъектовНФА.Колонки.Добавить("ЕдИзм", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ОстаткиДМДляОбъектовНФА.Колонки.Добавить("МассаДМ", Новый ОписаниеТипов("Число"));
	ОстаткиДМДляОбъектовНФА.Колонки.Добавить("КоличествоДМ", Новый ОписаниеТипов("Число"));
	ОстаткиДМДляОбъектовНФА.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	ЗаполнитьОстаткиДМДляОбъектовНФАДляВнутреннихПеремещений(МассивОбъектов, СписокОбъектовНФА, ОстаткиДМДляОбъектовНФА);

	ОстаткиЛомаДМДляОбъектовНФА = Новый ТаблицаЗначений;
	
	ОстаткиЛомаДМДляОбъектовНФА.Колонки.Добавить("Ссылка", Документы.ТипВсеСсылки());
	ОстаткиЛомаДМДляОбъектовНФА.Колонки.Добавить("ОбъектНФА", Справочники.ТипВсеСсылки());
