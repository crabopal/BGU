#КонецОбласти

#Область ПечатьСправкиОбИзмененииСодержанияДрагМатериалов

Функция ПечатьСправкиОбИзмененииСодержанияДрагМатериалов(МассивОбъектов, ОбъектыПечати) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "СправкаОбИзмененииСодержанияДрагМатериалов";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_СправкаОСодержанииДрагМатериалов");
	
	ОбластьЗаголовок		= Макет.ПолучитьОбласть("ЗаголовокИзменения");
	ОбластьОбъект			= Макет.ПолучитьОбласть("ОбъектНФА");
	ОбластьЗаключение		= Макет.ПолучитьОбласть("ЗаключениеОСодержанииДрагМатериалов");
	ОбластьШапкаДМ			= Макет.ПолучитьОбласть("ШапкаТаблицыДМИзменения");
	ОбластьШапкаЛом			= Макет.ПолучитьОбласть("ШапкаТаблицыЛомаИзменения");
	ОбластьСтрокаДМ			= Макет.ПолучитьОбласть("СтрокаТаблицыДМИзменения");
	ОбластьСтрокаЛома		= Макет.ПолучитьОбласть("СтрокаТаблицыЛомаИзменения");
	ОбластьИтог				= Макет.ПолучитьОбласть("ВсегоПоСправке");
	ОбластьПодвал			= Макет.ПолучитьОбласть("Подвал");
	
	Штуки = УчетДрагМатериалов.Штуки();
	
	ПервыйДокумент = Истина;
	РезультатЗапроса = ДанныеДляСправкиОбИзменении(МассивОбъектов);
	ВыборкаДокументов = РезультатЗапроса[0].Выбрать();
	ВыборкаДрагМатериалы = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаЛом = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Если ВыборкаЛом.Количество() = 0 Тогда
		ВыборкаЛом = Неопределено;
	КонецЕсли;
	
	ЕстьДанныеДМ = Ложь;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		ТаблицаИтоговПоСправке = Новый ТаблицаЗначений;
		ТаблицаИтоговПоСправке.Колонки.Добавить("ОбъектНФА", ТипОбъектаНФА());
		ТаблицаИтоговПоСправке.Колонки.Добавить("ВидДвиженияДМ", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвиженийДрагМатериалов"));
		ТаблицаИтоговПоСправке.Колонки.Добавить("ВидДрагМатериала", Новый ОписаниеТипов("СправочникСсылка.ДрагМеталлы"));
		ТаблицаИтоговПоСправке.Колонки.Добавить("ЕдИзм", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
		ТаблицаИтоговПоСправке.Колонки.Добавить("МассаДМ", Новый ОписаниеТипов("Число"));
		ТаблицаИтоговПоСправке.Колонки.Добавить("КоличествоДМ", Новый ОписаниеТипов("Число"));
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
		СтруктураОбластьЗаголовок = Новый Структура;
		СтруктураОбластьЗаголовок.Вставить("НаименованиеОрганизации",?(СокрЛП(ВыборкаДокументов.Организация.НаименованиеПолное) = "", ВыборкаДокументов.Организация.Наименование, ВыборкаДокументов.Организация.НаименованиеПолное));
		СтруктураОбластьЗаголовок.Вставить("ДатаСоставления",Формат(ВыборкаДокументов.ДатаСоставления, "ДЛФ=D"));
		СтруктураОбластьЗаголовок.Вставить("НомерСправки", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаДокументов.Ссылка, ВыборкаДокументов.НомерДокументаОснованияСправки));
		
		ДокументОснованиеСправки = "";
		Если ЗначениеЗаполнено(ВыборкаДокументов.Основание) Тогда
			ДокументОснованиеСправки = ВыборкаДокументов.Основание;
		Иначе
			ДокументОснованиеСправки = "__________________________";
		КонецЕсли;	
		Если ЗначениеЗаполнено(ВыборкаДокументов.НомерОснования) Тогда
			ДокументОснованиеСправки = ДокументОснованиеСправки + НСтр("ru = ' № '") + ВыборкаДокументов.НомерОснования;
		Иначе
			ДокументОснованиеСправки = ДокументОснованиеСправки + НСтр("ru = ' № '") + "____________";
		КонецЕсли;	
		Если ЗначениеЗаполнено(ВыборкаДокументов.ДатаОснования) Тогда
			ДокументОснованиеСправки = ДокументОснованиеСправки + НСтр("ru = ' от '") + Формат(ВыборкаДокументов.ДатаОснования, "ДЛФ=D");
		Иначе
			ДокументОснованиеСправки = ДокументОснованиеСправки + НСтр("ru = ' от '") + "____________";
		КонецЕсли;	
		
		СтруктураОбластьЗаголовок.Вставить("ДокументОснованиеСправки", ДокументОснованиеСправки);
		
		ОбластьЗаголовок.Параметры.Заполнить(СтруктураОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ТаблицаИтоговПоСправке.Очистить();
		
		//Вывод данных об объекте НФА
	    ВыборкаДрагМатериалы.Сбросить();
		СчетчикОбъектов = 1;
	    Если ВыборкаДрагМатериалы.НайтиСледующий(Новый Структура("Ссылка", ВыборкаДокументов.Ссылка)) Тогда
	    	ВыборкаДМ = ВыборкаДрагМатериалы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаДМ.Следующий() Цикл
				
				Если СчетчикОбъектов = 1 Тогда
					ОбластьЗаключение.Параметры.ТекстЗаключения = НСтр("ru = 'Список объектов, содержащих драгоценные материалы'");
					ТабличныйДокумент.Вывести(ОбластьЗаключение);
				КонецЕсли;	
				
			    ЭтоНоваяТаблицаДМ = Истина;
				ВыборкаИнвНомер = ВыборкаДМ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаИнвНомер.Следующий() Цикл
					
					ВыборкаКоличествоОбъектов = ВыборкаИнвНомер.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаКоличествоОбъектов.Следующий() Цикл
						//Объект НФА и единицы измерения объектов
						Если ЗначениеЗаполнено(ВыборкаИнвНомер.ИнвНомер) Тогда
							ОбъектНФАСправки = СокрЛП(ВыборкаИнвНомер.ОбъектНФА.НаименованиеПолное) + " (инв. № "+СокрЛП(ВыборкаИнвНомер.ИнвНомер)+")";
							ЕдиницыИзмерения = Штуки;
						Иначе
							Если ТипЗнч(ВыборкаИнвНомер.ОбъектНФА) = Тип("СправочникСсылка.Номенклатура") Тогда
								ОбъектНФАСправки = СокрЛП(ВыборкаИнвНомер.ОбъектНФА.НаименованиеПолное) + " (ном. № "+СокрЛП(ВыборкаИнвНомер.ОбъектНФА.НоменклатурныйНомер)+")";
								ЕдиницыИзмерения = ВыборкаИнвНомер.ОбъектНФА.ЕдиницаИзмерения;
							Иначе	
								ОбъектНФАСправки = СокрЛП(ВыборкаИнвНомер.ОбъектНФА.НаименованиеПолное);
								ЕдиницыИзмерения = Штуки;
							КонецЕсли;
						КонецЕсли;	
						
						СтруктураСтрокиОбъекта = Новый Структура;
				    	СтруктураСтрокиОбъекта.Вставить("НомерПп", Строка(СчетчикОбъектов));
				    	СтруктураСтрокиОбъекта.Вставить("ОбъектНФА", ОбъектНФАСправки);
				    	СтруктураСтрокиОбъекта.Вставить("Количество", ВыборкаКоличествоОбъектов.Количество);
				    	СтруктураСтрокиОбъекта.Вставить("ЕдиницыИзмерения", ЕдиницыИзмерения);
						
						ОбластьОбъект.Параметры.Заполнить(СтруктураСтрокиОбъекта);
						ТабличныйДокумент.Вывести(ОбластьОбъект);
						
						//Список содержания ДМ
				    	Если ЭтоНоваяТаблицаДМ Тогда
				    		ТабличныйДокумент.Вывести(ОбластьШапкаДМ);
				    		ЭтоНоваяТаблицаДМ = Ложь;
				    	КонецЕсли;
						
						СчетчикДМ = 1;
						ВыборкаСодержаниеДМ = ВыборкаКоличествоОбъектов.Выбрать();
						Пока ВыборкаСодержаниеДМ.Следующий() Цикл
							
							СтруктураСтрокиДМ = Новый Структура;
					    	СтруктураСтрокиДМ.Вставить("НомПпДМ", СчетчикДМ);
					    	СтруктураСтрокиДМ.Вставить("ДрагоценныйМатериал", ВыборкаСодержаниеДМ.ВидДрагМатериала);
					    	СтруктураСтрокиДМ.Вставить("Масса", ВыборкаСодержаниеДМ.МассаДМ);
					    	СтруктураСтрокиДМ.Вставить("Количество", ВыборкаСодержаниеДМ.КоличествоДМ);
					    	СтруктураСтрокиДМ.Вставить("ЕдИзм", ВыборкаСодержаниеДМ.ЕдИзм);
					    	СтруктураСтрокиДМ.Вставить("ВидДвиженияДМ", ВыборкаСодержаниеДМ.ВидДвиженияДМ);
							
							ОбластьСтрокаДМ.Параметры.Заполнить(СтруктураСтрокиДМ);
							ТабличныйДокумент.Вывести(ОбластьСтрокаДМ);
							
							НоваяСтрока = ТаблицаИтоговПоСправке.Добавить();
							НоваяСтрока.ОбъектНФА = ВыборкаСодержаниеДМ.ОбъектНФА;
							НоваяСтрока.ВидДрагМатериала = ВыборкаСодержаниеДМ.ВидДрагМатериала;
							НоваяСтрока.ЕдИзм = ВыборкаСодержаниеДМ.ЕдИзм;
							НоваяСтрока.МассаДМ = ВыборкаСодержаниеДМ.МассаДМ;
							НоваяСтрока.КоличествоДМ = ВыборкаСодержаниеДМ.КоличествоДМ;
							НоваяСтрока.ВидДвиженияДМ = ВыборкаСодержаниеДМ.ВидДвиженияДМ;
							
							СчетчикДМ = СчетчикДМ + 1;
							ЕстьДанныеДМ = Истина;
						КонецЦикла;
						
						СчетчикОбъектов = СчетчикОбъектов + 1;
					КонецЦикла;	
				КонецЦикла;
			КонецЦикла;
	    КонецЕсли;
		
		//Лом и отходы, содержащие драгоценные материалы
		Если ВыборкаЛом <> Неопределено Тогда
			СчетчикОбъектов = 1;
			
		    ВыборкаЛом.Сбросить();
		    Если ВыборкаЛом.НайтиСледующий(Новый Структура("Ссылка", ВыборкаДокументов.Ссылка)) Тогда
		    	ВыборкаДМ = ВыборкаЛом.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаДМ.Следующий() Цикл
					
				    ЭтоНоваяТаблицаДМ = Истина;
					ВыборкаКоличествоОбъектов = ВыборкаДМ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаКоличествоОбъектов.Следующий() Цикл
						
						Если СчетчикОбъектов = 1 Тогда
							ОбластьЗаключение.Параметры.ТекстЗаключения = НСтр("ru = 'Лом и отходы, содержащие драгоценные материалы'");
							ТабличныйДокумент.Вывести(ОбластьЗаключение);
						КонецЕсли;	
					
						//Объект НФА и единицы измерения объектов
						ОбъектНФАСправки = СокрЛП(ВыборкаКоличествоОбъектов.ОбъектНФА.НаименованиеПолное) + " (ном. № "+СокрЛП(ВыборкаКоличествоОбъектов.ОбъектНФА.НоменклатурныйНомер)+")";
						ЕдиницыИзмерения = ВыборкаКоличествоОбъектов.ОбъектНФА.ЕдиницаИзмерения;
						
						СтруктураСтрокиОбъекта = Новый Структура;
				    	СтруктураСтрокиОбъекта.Вставить("НомерПп", Строка(СчетчикОбъектов));
				    	СтруктураСтрокиОбъекта.Вставить("ОбъектНФА", ОбъектНФАСправки);
				    	СтруктураСтрокиОбъекта.Вставить("Количество", ВыборкаКоличествоОбъектов.Количество);
				    	СтруктураСтрокиОбъекта.Вставить("ЕдиницыИзмерения", ЕдиницыИзмерения);
						
						ОбластьОбъект.Параметры.Заполнить(СтруктураСтрокиОбъекта);
						ТабличныйДокумент.Вывести(ОбластьОбъект);
						
						//Список содержания ДМ
				    	Если ЭтоНоваяТаблицаДМ Тогда
				    		ТабличныйДокумент.Вывести(ОбластьШапкаЛом);
				    		ЭтоНоваяТаблицаДМ = Ложь;
				    	КонецЕсли;
						
						СчетчикДМ = 1;
						ВыборкаСодержаниеДМ = ВыборкаКоличествоОбъектов.Выбрать();
						Пока ВыборкаСодержаниеДМ.Следующий() Цикл
							
							СтруктураСтрокиДМ = Новый Структура;
					    	СтруктураСтрокиДМ.Вставить("НомПпДМ", СчетчикДМ);
					    	СтруктураСтрокиДМ.Вставить("ДрагоценныйМатериал", ВыборкаСодержаниеДМ.ВидДрагМатериала);
					    	СтруктураСтрокиДМ.Вставить("ЧистаяМасса", ВыборкаСодержаниеДМ.ЧистаяМасса);
					    	СтруктураСтрокиДМ.Вставить("ЛигатурнаяМасса", ВыборкаСодержаниеДМ.ЛигатурнаяМасса);
					    	СтруктураСтрокиДМ.Вставить("Количество", ВыборкаСодержаниеДМ.КоличествоДМ);
					    	СтруктураСтрокиДМ.Вставить("ЕдИзм", ВыборкаСодержаниеДМ.ЕдИзм);
					    	СтруктураСтрокиДМ.Вставить("ВидДвиженияДМ", ВыборкаСодержаниеДМ.ВидДвиженияДМ);
							
							ОбластьСтрокаЛома.Параметры.Заполнить(СтруктураСтрокиДМ);
							ТабличныйДокумент.Вывести(ОбластьСтрокаЛома);
							
							НоваяСтрока = ТаблицаИтоговПоСправке.Добавить();
							НоваяСтрока.ОбъектНФА = ВыборкаСодержаниеДМ.ОбъектНФА;
							НоваяСтрока.ВидДрагМатериала = ВыборкаСодержаниеДМ.ВидДрагМатериала;
							НоваяСтрока.ЕдИзм = ВыборкаСодержаниеДМ.ЕдИзм;
							НоваяСтрока.МассаДМ = ВыборкаСодержаниеДМ.ЧистаяМасса;
							НоваяСтрока.КоличествоДМ = ВыборкаСодержаниеДМ.КоличествоДМ;
							НоваяСтрока.ВидДвиженияДМ = ВыборкаСодержаниеДМ.ВидДвиженияДМ;
							
							СчетчикДМ = СчетчикДМ + 1;
							ЕстьДанныеДМ = Истина;
						КонецЦикла;
						
						СчетчикОбъектов = СчетчикОбъектов + 1;
					КонецЦикла;
					
				КонецЦикла;
		    КонецЕсли;
			
			
		КонецЕсли;
		
		//Всего по справке
		ТаблицаИтоговПоСправке.Свернуть("ВидДвиженияДМ, ВидДрагМатериала, ЕдИзм", "МассаДМ, КоличествоДМ");
		СчетчикДМ = 1;
		
		Для каждого ТекСтрока Из ТаблицаИтоговПоСправке Цикл
			Если СчетчикДМ = 1 Тогда
				ТабличныйДокумент.Вывести(ОбластьИтог);
				ТабличныйДокумент.Вывести(ОбластьШапкаДМ);
			КонецЕсли;	
			
			СтруктураСтрокиДМ = Новый Структура;
	    	СтруктураСтрокиДМ.Вставить("НомПпДМ", СчетчикДМ);
	    	СтруктураСтрокиДМ.Вставить("ВидДвиженияДМ", ТекСтрока.ВидДвиженияДМ);
	    	СтруктураСтрокиДМ.Вставить("ДрагоценныйМатериал", ТекСтрока.ВидДрагМатериала);
	    	СтруктураСтрокиДМ.Вставить("Масса", ТекСтрока.МассаДМ);
	    	СтруктураСтрокиДМ.Вставить("Количество", ТекСтрока.КоличествоДМ);
	    	СтруктураСтрокиДМ.Вставить("ЕдИзм", ТекСтрока.ЕдИзм);
			
			ОбластьСтрокаДМ.Параметры.Заполнить(СтруктураСтрокиДМ);
			ТабличныйДокумент.Вывести(ОбластьСтрокаДМ);
			
			СчетчикДМ = СчетчикДМ + 1;
		КонецЦикла;	
		
		//Если нет данных для вывода
		Если НЕ ЕстьДанныеДМ Тогда
			ОбластьЗаключение.Параметры.ТекстЗаключения = НСтр("ru = 'Сведения об изменении содержания драгоценных материалов отсутствуют.'");
			ТабличныйДокумент.Вывести(ОбластьЗаключение);
		КонецЕсли;
		
		//Ответственный
		Сотрудник = ВыборкаДокументов.ОтветственныйИсполнитель;
		ДатаСведений = ВыборкаДокументов.ДатаДокументаОснованияСправки;
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Должность", Сотрудник, ДатаСведений);	
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
			Должность = ДанныеСотрудника.Должность;
			ФамилияИнициалы = Справочники.Сотрудники.ФамилияИО(Сотрудник, Ложь,ДатаСведений); 
			
			ДанныеОтветственного = Новый Структура;
			ДанныеОтветственного.Вставить("Должность", Должность);
			ДанныеОтветственного.Вставить("ФамилияИнициалы", ФамилияИнициалы);
			
			ОбластьПодвал.Параметры.Заполнить(ДанныеОтветственного);
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

Функция ДанныеДляСправкиОбИзменении(МассивОбъектов)
	
	//НаименованиеДокумента = НСтр("ru = '""Изменение наличия драгоценных материалов""'");

	МассивТиповНеМЗ = ПолучитьМассивТиповНоменклатурыБезДрагМатериалов();
	
	СчетаУчетаОС = ПолучитьМассивСчетовДМДляОС(Истина);
	СчетаУчетаОС = ДополнитьМассивСчетовДМДляМЦ( , СчетаУчетаОС, "Основные средства");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов"	, МассивОбъектов);
	Запрос.УстановитьПараметр("МассивСчетовОС"	, СчетаУчетаОС);
	Запрос.УстановитьПараметр("МассивСчетовИК"	, ПолучитьМассивСчетовДМДляОС(Истина));
	Запрос.УстановитьПараметр("МассивТиповНеМЗ"	, МассивТиповНеМЗ);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИзменениеНаличияДрагМатериалов.Ссылка КАК Ссылка,
	|	ИзменениеНаличияДрагМатериалов.Ссылка.Дата КАК ДатаСоставления,
	|	ИзменениеНаличияДрагМатериалов.Ссылка.Организация КАК Организация,
	|	""Изменение наличия драгоценных материалов"" КАК ВидДокументаОснованияСправки,
	|	ИзменениеНаличияДрагМатериалов.Ссылка.Номер КАК НомерДокументаОснованияСправки,
	|	ИзменениеНаличияДрагМатериалов.Ссылка.Дата КАК ДатаДокументаОснованияСправки,
	|	ИзменениеНаличияДрагМатериалов.Основание КАК Основание,
	|	ИзменениеНаличияДрагМатериалов.НомерОснования КАК НомерОснования,
	|	ИзменениеНаличияДрагМатериалов.ДатаОснования КАК ДатаОснования,
	|	ИзменениеНаличияДрагМатериалов.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель
	|ИЗ
	|	Документ.ИзменениеНаличияДрагМатериалов КАК ИзменениеНаличияДрагМатериалов
	|ГДЕ
	|	ИзменениеНаличияДрагМатериалов.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСоставления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Ссылка,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ИнвНомер КАК ИнвНомер,
	|	ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДрагМатериала КАК Справочник.ДрагМеталлы).ТипДрагМатериала КАК ТипДрагМатериала,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДвиженияДМ КАК ВидДвиженияДМ,
	|	СУММА(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.МассаДМ) КАК МассаДМ,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	СУММА(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.КоличествоДМ) КАК КоличествоДМ,
	|	ИзменениеНаличияДрагМатериаловСписокНФАДокументаОснования.Количество КАК Количество
	|ИЗ
	|	Документ.ИзменениеНаличияДрагМатериалов.ДрагоценныеМатериалы КАК ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИзменениеНаличияДрагМатериалов.СписокНФАДокументаОснования КАК ИзменениеНаличияДрагМатериаловСписокНФАДокументаОснования
	|		ПО (ИзменениеНаличияДрагМатериаловСписокНФАДокументаОснования.ОбъектНФА = ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ОбъектНФА)
	|			И (ИзменениеНаличияДрагМатериаловСписокНФАДокументаОснования.ИнвНомер = ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ИнвНомер)
	|			И ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка = ИзменениеНаличияДрагМатериаловСписокНФАДокументаОснования.Ссылка
	|ГДЕ
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка В(&МассивОбъектов)
	|	И ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.МассаДМ > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ОбъектНФА,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ИнвНомер,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДрагМатериала,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДвиженияДМ,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ЕдИзм,
	|	ИзменениеНаличияДрагМатериаловСписокНФАДокументаОснования.Количество,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектНФА,
	|	ИнвНомер,
	|	ТипДрагМатериала,
	|	ВидДвиженияДМ,
	|	ВидДрагМатериала
	|ИТОГИ ПО
	|	Ссылка,
	|	ОбъектНФА,
	|	ИнвНомер,
	|	Количество
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка КАК Ссылка,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ИнвНомер КАК ИнвНомер,
	|	ВЫРАЗИТЬ(ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДрагМатериала КАК Справочник.ДрагМеталлы).ТипДрагМатериала КАК ТипДрагМатериала,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ВидДвиженияДМ КАК ВидДвиженияДМ,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ЛигатурнаяМасса КАК ЛигатурнаяМасса,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ЧистаяМасса КАК ЧистаяМасса,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	|	ИзменениеНаличияДрагМатериаловСписокНФАДокументаОснования.Количество КАК Количество
	|ИЗ
	|	Документ.ИзменениеНаличияДрагМатериалов.ДрагоценныеМатериалы КАК ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИзменениеНаличияДрагМатериалов.СписокНФАДокументаОснования КАК ИзменениеНаличияДрагМатериаловСписокНФАДокументаОснования
	|		ПО (ИзменениеНаличияДрагМатериаловСписокНФАДокументаОснования.ОбъектНФА = ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ОбъектНФА)
	|			И (ИзменениеНаличияДрагМатериаловСписокНФАДокументаОснования.ИнвНомер = ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ИнвНомер)
	|			И ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка = ИзменениеНаличияДрагМатериаловСписокНФАДокументаОснования.Ссылка
	|ГДЕ
	|	ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.Ссылка В(&МассивОбъектов)
	|	И ИзменениеНаличияДрагМатериаловДрагоценныеМатериалы.ЧистаяМасса > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектНФА,
	|	ИнвНомер,
	|	ТипДрагМатериала,
	|	ВидДвиженияДМ,
	|	ВидДрагМатериала
	|ИТОГИ ПО
	|	Ссылка,
	|	ОбъектНФА,
	|	Количество";
	
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции 

#КонецОбласти

#Область ЗаполнениеАналитикиИИсточниковОбразованияДрагМатериалов

Процедура ЗаполнитьИсточникиОбразованияЛомаОтходовДрагМатериалов(Организация, ТабЧасть, ДатаСведений) Экспорт
	
	Для каждого ТекСтрока Из ТабЧасть Цикл
		ИсточникОбразованияЛома = ИсточникОбразованияЛомаИОтходов(Организация, ТекСтрока.ОбъектНФА, ДатаСведений);
		Если ЗначениеЗаполнено(ИсточникОбразованияЛома) Тогда
			ТекСтрока.ИсточникОбразования = ИсточникОбразованияЛома;	
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

Функция ИсточникОбразованияЛомаИОтходов(Организация, ОбъектНФА, ДатаСведений) Экспорт
	Результат = Перечисления.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.ПустаяСсылка();
	
	ОтборНФА = Новый Структура;
	ОтборНФА.Вставить("Организация", Организация);
	ОтборНФА.Вставить("ОбъектНФА", ОбъектНФА);
	ОтборНФА.Вставить("ОтчетДМ", "2-ДМ (Приложение)");
	
	ВидыПоОтчетам = РегистрыСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(КонецДня(ДатаСведений), ОтборНФА);
	
	Для каждого ТекСтрока Из ВидыПоОтчетам Цикл
		Если (ТекСтрока.КлассификацияОбъекта = Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет2ДМПриложение_ПроизводствоПродукции) Тогда
			Результат = Перечисления.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.ПроизводствоПродукции;
		ИначеЕсли (ТекСтрока.КлассификацияОбъекта = Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет2ДМПриложение_ПриборыОборудованиеИДругиеИзделия) Тогда
			Результат = Перечисления.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.ИспользованиеПриборовОборудованияИДругихИзделий;
		ИначеЕсли (ТекСтрока.КлассификацияОбъекта = Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет2ДМПриложение_НИОКР) Тогда
			Результат = Перечисления.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.ПроведениеНаучноИсследовательскихИОпытныхРабот;
		ИначеЕсли (ТекСтрока.КлассификацияОбъекта = Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет2ДМПриложение_АКБ) Тогда
			Результат = Перечисления.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.ИспользованиеАккумуляторов;
		ИначеЕсли (ТекСтрока.КлассификацияОбъекта = Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет2ДМПриложение_КомплектующиеИзделия) Тогда
			Результат = Перечисления.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.КомплектующиеИзделия;
		ИначеЕсли (ТекСтрока.КлассификацияОбъекта = Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет2ДМПриложение_КабельнаяПродукция) Тогда
			Результат = Перечисления.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.ИспользованиеКабельнойПродукции;
		ИначеЕсли (ТекСтрока.КлассификацияОбъекта = Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет2ДМПриложение_ТермопарыТермометры) Тогда
			Результат = Перечисления.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.ИспользованиеТермопарИТермометровСопротивления;
		ИначеЕсли (ТекСтрока.КлассификацияОбъекта = Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет2ДМПриложение_ЛабПосудаОстастка) Тогда
			Результат = Перечисления.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.ИспользованиеЛабораторнойПосудыИОснасткиОборудования;
		ИначеЕсли (ТекСтрока.КлассификацияОбъекта = Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет2ДМПриложение_КиноФотоРентген) Тогда
			Результат = Перечисления.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.ИспользованиеКиноФотоРентгеноматериалов;
		ИначеЕсли (ТекСтрока.КлассификацияОбъекта = Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет2ДМПриложение_НизковольтнаяАппаратура) Тогда
			Результат = Перечисления.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.ИспользованиеНизковольтнойАппаратуры;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область УчетМЦКапвложенийСДрагМатериалами

Функция ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Экспорт 

	Возврат Константы.ВестиУчетДрагМатериаловВМЦКапвложений.Получить(); 
	
КонецФункции

// Структура таблицы источника данных "Материальные ценности содержащие драг. материалы".
//
Функция ПустаяТаблицаМЦСДрагМатериалами() Экспорт

	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	ПустаяТаблица.Колонки.Добавить("ИдентификаторСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(36));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ЦМОДт", Новый ОписаниеТипов("СправочникСсылка.ЦМО")); 
	ПустаяТаблица.Колонки.Добавить("ЦМОКт", Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ПустаяТаблица.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	// Объекты НФА   
	ПустаяТаблица.Колонки.Добавить("КапвложениеДт", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ПустаяТаблица.Колонки.Добавить("ОбъектМЦДт", ТипОбъектаНФА());  
	ПустаяТаблица.Колонки.Добавить("КапвложениеКт", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ПустаяТаблица.Колонки.Добавить("ОбъектМЦКт", ТипОбъектаНФА());
	// Количественные и суммовые характеристики.
	ПустаяТаблица.Колонки.Добавить("КоличествоМЦДт", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0,ДопустимыйЗнак.Любой)));
	ПустаяТаблица.Колонки.Добавить("КоличествоМЦКт", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0,ДопустимыйЗнак.Любой)));
	// Содержание проводок.
	ПустаяТаблица.Колонки.Добавить("СодержаниеПроводки", Новый ОписаниеТипов("Строка"));
	Возврат ПустаяТаблица;

КонецФункции

// Подготавливает таблицу документа (в унифицированном формате) для учета списания (выбытия) МЦ, содержащих драг материалы, для целей управленческого учета.
//
Функция ПодготовитьТаблицуМЦСДрагМатериаламиПоДокументу(Документ, Параметры = Неопределено) Экспорт
	
	ТаблицаДокумента = ПустаяТаблицаМЦСДрагМатериалами();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	ТекстШаблона = "";
	
	СписокДокПринятияКУчету = Новый Массив;
	СписокДокПринятияКУчету.Добавить("ПринятиеКУчетуОбъектовОС");
	СписокДокПринятияКУчету.Добавить("РешениеОПризнанииОбъектовОС");
	СписокДокПринятияКУчету.Добавить("ПринятиеКУчетуОбъектовИК");
	СписокДокПринятияКУчету.Добавить("РешениеОПризнанииОбъектовОСИК");
	
	Запрос = Новый Запрос;
	МетаданныеДокумента = Документ.Метаданные();
	ЕстьТабЧастьКапВложения = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("КапВложения", МетаданныеДокумента);

	Если ЕстьТабЧастьКапВложения Тогда // ПоступлениеОС, ПоступлениеОСИК
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ДрагоценныеМатериалы",
			"ОбъектНФА,ОбъектМЦ,КоличествоМЦ", Документ, Параметры); 
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "КапВложения",
			"ВнеоборотныйАктив,КФО", Документ, Параметры);
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Документ",
				"ЦМО", Документ, Параметры);
		
		ТекстШаблона = НСтр("ru = 'МЦ %1 включена в состав капитального вложения %2 для учета драгоценных материалов'");	
			
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КапВложения.КФО КАК КФО,
		|	Документ.ЦМО КАК ЦМОДт,
		|	ТЧДрагоценныеМатериалы.ОбъектНФА КАК КапвложениеДт,
		|	ТЧДрагоценныеМатериалы.ОбъектМЦ КАК ОбъектМЦДт,
		|	ТЧДрагоценныеМатериалы.КоличествоМЦ КАК КоличествоМЦДт
		|ИЗ
		|	ТаблицаДрагоценныеМатериалы КАК ТЧДрагоценныеМатериалы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКапВложения КАК КапВложения
		|		ПО (КапВложения.ВнеоборотныйАктив = ТЧДрагоценныеМатериалы.ОбъектНФА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ КАК Документ
		|		ПО (ИСТИНА)";
		
	ИначеЕсли СписокДокПринятияКУчету.Найти(МетаданныеДокумента.Имя) <> Неопределено Тогда // ПринятиеКУчетуОбъектовОС, РешениеОПризнанииОбъектовОС, ПринятиеКУчетуОбъектовИК, РешениеОПризнанииОбъектовОСИК
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "МЦСДрагоценнымиМатериалами",
				"ОбъектМЦ,Количество", Документ, Параметры); 
		
		Если Документ.МЦСДрагоценнымиМатериалами.Количество() = 0 Тогда
			Возврат ТаблицаДокумента;	
		КонецЕсли;
		
		ТекстШаблона = НСтр("ru = 'МЦ %1 исключена из состава капитального вложения %2 для учета драгоценных материалов'"); 
		
		Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектВложенийКт,
			|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ОбъектМЦКт,
			|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК ЦМОКт,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоМЦКт
			|ПОМЕСТИТЬ СписокМЦОстаток
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет.Код = ""МЦК"",
			|			,
			|			Организация = &Организация
			|				И Субконто1 = &ОбъектВложений) КАК ЖурналПроводокЕПСБУОстатки			
			|;
            |////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ 
			|	СписокМЦОстаток.КФО КАК КФО,
			|	СписокМЦОстаток.ОбъектВложенийКт КАК КапвложениеКт,
			|	МЦСДрагоценнымиМатериалами.ОбъектМЦ КАК ОбъектМЦКт,
			|	СписокМЦОстаток.ЦМОКт КАК ЦМОКт,
			|	ВЫБОР
			|		КОГДА МЦСДрагоценнымиМатериалами.Количество <= СписокМЦОстаток.КоличествоМЦКт
			|			ТОГДА МЦСДрагоценнымиМатериалами.Количество
			|		ИНАЧЕ СписокМЦОстаток.КоличествоМЦКт
			|	КОНЕЦ КАК КоличествоМЦКт
			|ИЗ
			|	ТаблицаМЦСДрагоценнымиМатериалами КАК МЦСДрагоценнымиМатериалами
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокМЦОстаток КАК СписокМЦОстаток
			|		ПО МЦСДрагоценнымиМатериалами.ОбъектМЦ = СписокМЦОстаток.ОбъектМЦКт 
			|ГДЕ
			|	МЦСДрагоценнымиМатериалами.Количество > 0";	
		
		Запрос.УстановитьПараметр("Период", Документ.Дата);
		Запрос.УстановитьПараметр("ОбъектВложений", ?(ТипЗнч(Документ) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК"),
			Документ.ВнеоборотныйАктив, Документ.КапитальноеВложение));
		Запрос.УстановитьПараметр("Организация", Документ.Организация);
			
	ИначеЕсли МетаданныеДокумента.Имя = "ТребованиеНакладная0315006" Тогда //Требование - накладная (Материальные запасы)   
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
				"Номенклатура, КФО, Количество", Документ, Параметры);  
		
		Если Документ.ДрагоценныеМатериалы.Количество() > 0 И НЕ Документ.ВключатьМЦВСоставКапвложений Тогда
			Возврат ТаблицаДокумента;	
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ТаблицаМатериалы.КФО КАК КФО,
			|	ТаблицаМатериалы.Номенклатура КАК ОбъектМЦДт,
			|	ТаблицаМатериалы.Количество КАК КоличествоМЦДт
			|ИЗ
			|	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И ОбъектНФА ССЫЛКА Справочник.Номенклатура) КАК НаличиеДрагМатериаловВОбъектахНФАОбороты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаМатериалы КАК ТаблицаМатериалы
			|		ПО (ТаблицаМатериалы.Номенклатура = НаличиеДрагМатериаловВОбъектахНФАОбороты.ОбъектНФА)";
		
		Запрос.УстановитьПараметр("Период", Документ.Дата - 1);
		Запрос.УстановитьПараметр("Организация", Документ.Организация);
		
	ИначеЕсли МетаданныеДокумента.Имя = "НакладнаяНаВнутреннееПеремещениеОС2"
		ИЛИ МетаданныеДокумента.Имя = "ВнутреннееПеремещениеИК" Тогда  // ВнутреннееПеремещениеИК, НакладнаяНаВнутреннееПеремещениеОС2
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Документ",
				"ЦМОПолучатель", Документ, Параметры);
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ОсновныеСредства",
				"ОсновноеСредство, Количество, КФО", Документ, Параметры);
		
