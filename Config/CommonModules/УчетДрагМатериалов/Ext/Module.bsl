	КонецЦикла;	
КонецПроцедуры	

Процедура ДобавитьСтрокуРасшифровкиОтчетаФормаОтчета2012Кв1(ТаблицаРасшифровок, ИмяПоказателя, ДрагМатериал, ОбъектНФА, ИнвНомер, Количество, ЕдиницаИзмерения, Масса)
	
	Если ТаблицаРасшифровок = Неопределено Тогда
		ТаблицаРасшифровок = Новый ТаблицаЗначений;
		ТаблицаРасшифровок.Колонки.Добавить("ИмяПоказателя");
		ТаблицаРасшифровок.Колонки.Добавить("ДрагМатериал");
		ТаблицаРасшифровок.Колонки.Добавить("ТипОбъектаНФА");
		ТаблицаРасшифровок.Колонки.Добавить("ОбъектНФА");
		ТаблицаРасшифровок.Колонки.Добавить("ИнвНомер");
		ТаблицаРасшифровок.Колонки.Добавить("Количество");
		ТаблицаРасшифровок.Колонки.Добавить("ЕдиницаИзмерения");
		ТаблицаРасшифровок.Колонки.Добавить("ЗнакОперации");
		ТаблицаРасшифровок.Колонки.Добавить("НаименованиеСлагаемого");
		ТаблицаРасшифровок.Колонки.Добавить("ДополнительныеПараметры");
		ТаблицаРасшифровок.Колонки.Добавить("Масса");
		
	КонецЕсли;
	
	Если ТипЗнч(ОбъектНФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		ТипОбъектаНФА = "ОС";
		НаименованиеОбъектаНФА = ОбъектНФА.НаименованиеПолное;
	ИначеЕсли ТипЗнч(ОбъектНФА) = Тип("СправочникСсылка.Номенклатура") Тогда
		ТипОбъектаНФА = "МЗ";	
		НаименованиеОбъектаНФА = ОбъектНФА.НаименованиеПолное;
	Иначе
		ТипОбъектаНФА = "";	
		НаименованиеОбъектаНФА = "";
	КонецЕсли;	
	
	НоваяСтрокаРасшифровки = ТаблицаРасшифровок.Добавить();
	НоваяСтрокаРасшифровки.ИмяПоказателя	= ИмяПоказателя;
	НоваяСтрокаРасшифровки.ДрагМатериал		= ?(ТипЗнч(ДрагМатериал)=Тип("Массив"), "Металлы платиновой группы", ДрагМатериал);
	НоваяСтрокаРасшифровки.ТипОбъектаНФА	= ТипОбъектаНФА;
	НоваяСтрокаРасшифровки.ОбъектНФА		= НаименованиеОбъектаНФА;
	НоваяСтрокаРасшифровки.ИнвНомер			= ИнвНомер;
	НоваяСтрокаРасшифровки.Количество		= Количество;
	НоваяСтрокаРасшифровки.ЕдиницаИзмерения	= ЕдиницаИзмерения;
	НоваяСтрокаРасшифровки.ЗнакОперации = "";
	НоваяСтрокаРасшифровки.НаименованиеСлагаемого = "";
	НоваяСтрокаРасшифровки.ДополнительныеПараметры = "";
	НоваяСтрокаРасшифровки.Масса			= Масса;
	
КонецПроцедуры	

Функция ДобавитьСтрокуРасшифровкиДляРасчетногоЗначенияОтчета4ДМФормаОтчета2012Кв1(ТаблицаРасшифровок, ИмяПоказателя, ДрагМатериал, МассивЗначенийЯчеек)
	
	Если ТаблицаРасшифровок = Неопределено Тогда
		ТаблицаРасшифровок = Новый ТаблицаЗначений;
		ТаблицаРасшифровок.Колонки.Добавить("ИмяПоказателя");
		ТаблицаРасшифровок.Колонки.Добавить("ДрагМатериал");
		ТаблицаРасшифровок.Колонки.Добавить("ТипОбъектаНФА");
		ТаблицаРасшифровок.Колонки.Добавить("ОбъектНФА");
		ТаблицаРасшифровок.Колонки.Добавить("ИнвНомер");
		ТаблицаРасшифровок.Колонки.Добавить("Количество");
		ТаблицаРасшифровок.Колонки.Добавить("ЕдиницаИзмерения");
		ТаблицаРасшифровок.Колонки.Добавить("ЗнакОперации");
		ТаблицаРасшифровок.Колонки.Добавить("НаименованиеСлагаемого");
		ТаблицаРасшифровок.Колонки.Добавить("ДополнительныеПараметры");
		ТаблицаРасшифровок.Колонки.Добавить("Масса");
	КонецЕсли;
	
	СчетчикСтрок = 0;
	Для Каждого ТекСтрока Из МассивЗначенийЯчеек Цикл
		НомерКолонки = СчетчикСтрок + 4;
		НоваяСтрокаРасшифровки = ТаблицаРасшифровок.Добавить();
		НоваяСтрокаРасшифровки.ИмяПоказателя	= ИмяПоказателя;
		НоваяСтрокаРасшифровки.ДрагМатериал		= ДрагМатериал;
		НоваяСтрокаРасшифровки.ТипОбъектаНФА	= "";
		НоваяСтрокаРасшифровки.ОбъектНФА		= "";
		НоваяСтрокаРасшифровки.ИнвНомер			= "";
		НоваяСтрокаРасшифровки.Количество		= "";
		НоваяСтрокаРасшифровки.ЕдиницаИзмерения	= "";
		НоваяСтрокаРасшифровки.ЗнакОперации = ?(НомерКолонки > 5,"-","+");
		НоваяСтрокаРасшифровки.НаименованиеСлагаемого = "П0"+Сред(ИмяПоказателя,3,3)+?(НомерКолонки = 8, "9", Строка(НомерКолонки));
		НоваяСтрокаРасшифровки.ДополнительныеПараметры = "";
		НоваяСтрокаРасшифровки.Масса			= ТекСтрока;
		
		СчетчикСтрок = СчетчикСтрок + 1;
	КонецЦикла;
	
КонецФункции	

