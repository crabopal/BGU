	ОстаткиЛомаДМДляОбъектовНФА.Колонки.Добавить("ВидДрагМатериала", Новый ОписаниеТипов("СправочникСсылка.ДрагМеталлы"));
	ОстаткиЛомаДМДляОбъектовНФА.Колонки.Добавить("ЛигатурнаяМасса", Новый ОписаниеТипов("Число"));
	ОстаткиЛомаДМДляОбъектовНФА.Колонки.Добавить("ЧистаяМасса", Новый ОписаниеТипов("Число"));
	ОстаткиЛомаДМДляОбъектовНФА.Колонки.Добавить("ЕдИзм", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ОстаткиЛомаДМДляОбъектовНФА.Колонки.Добавить("КоличествоДМ", Новый ОписаниеТипов("Число"));
	ОстаткиЛомаДМДляОбъектовНФА.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

