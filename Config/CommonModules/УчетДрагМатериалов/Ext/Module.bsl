	Возврат Результат;
	
КонецФункции

Функция МассаДрагМатериалаДляМЦ(Организация, ЦМО, ОбъектНФА, ИнвНомер, ВидДрагМатериала, ДатаСведений, Регистратор, Поступление)  Экспорт
	
	Результат = 0;
	
	Если (Организация = NULL) ИЛИ (ЦМО = NULL) ИЛИ (ВидДрагМатериала = NULL) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтруктураДанных = ДанныеПоСодержаниюДрагматериалов(Организация, ОбъектНФА, ИнвНомер, ВидДрагМатериала, ДатаСведений);
	
	КоличествоПеремещения = КоличествоПеремещенияИзРегистратора(ЦМО, ОбъектНФА, ИнвНомер, Регистратор);
	
	Если (Поступление  И КоличествоПеремещения > 0) Тогда
		Результат = СтруктураДанных.МассаДМ * КоличествоПеремещения;
	ИначеЕсли (НЕ Поступление И КоличествоПеремещения < 0) Тогда	
		Результат = СтруктураДанных.МассаДМ * КоличествоПеремещения * (-1);
	КонецЕсли;	
		
	Возврат Результат;
	
КонецФункции	
	
Функция КоличествоДрагМатериалаДляМЦ(Организация, ЦМО, ОбъектНФА, ИнвНомер, ВидДрагМатериала, ДатаСведений, Регистратор, Поступление)  Экспорт
	
	Результат = 0;
	
	Если (Организация = NULL) ИЛИ (ЦМО = NULL) ИЛИ (ВидДрагМатериала = NULL) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтруктураДанных = ДанныеПоСодержаниюДрагматериалов(Организация, ОбъектНФА, ИнвНомер, ВидДрагМатериала, ДатаСведений);
	
	КоличествоПеремещения = КоличествоПеремещенияИзРегистратора(ЦМО, ОбъектНФА, ИнвНомер, Регистратор);
	
	Если (Поступление И КоличествоПеремещения > 0)  Тогда
		Результат = СтруктураДанных.КоличествоДК * КоличествоПеремещения;
	ИначеЕсли (НЕ Поступление И КоличествоПеремещения < 0) Тогда	
		Результат = СтруктураДанных.КоличествоДК * КоличествоПеремещения * (-1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция КоличествоПеремещенияИзРегистратора(ЦМО, ОбъектНФА, ИнвНомер, Регистратор)
	Результат = 0;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "";
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.НакладнаяНаВнутреннееПеремещениеОС2") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ВЫБОР
		               |		КОГДА НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.Ссылка.ЦМОПолучатель = &ЦМО
		               |			ТОГДА НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.Количество
		               |		ИНАЧЕ -1 * НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.Количество
		               |	КОНЕЦ КАК Количество
		               |ИЗ
		               |	Документ.НакладнаяНаВнутреннееПеремещениеОС2.ОсновныеСредства КАК НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства
		               |ГДЕ
		               |	НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.ОсновноеСредство = &ОбъектНФА
		               |	И НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.ИнвентарныйНомер = &ИнвНомер
		               |	И НакладнаяНаВнутреннееПеремещениеОС2ОсновныеСредства.Ссылка = &Регистратор";
					   
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ВедомостьНаВыдачуОСНаНуждыУчреждения") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ВЫБОР
		               |		КОГДА ВедомостьНаВыдачуОСНаНуждыУчрежденияОсновныеСредства.ЦМОПолучатель = &ЦМО
		               |			ТОГДА ВедомостьНаВыдачуОСНаНуждыУчрежденияОсновныеСредства.Количество
		               |		ИНАЧЕ -1 * ВедомостьНаВыдачуОСНаНуждыУчрежденияОсновныеСредства.Количество
		               |	КОНЕЦ КАК Количество
		               |ИЗ
		               |	Документ.ВедомостьНаВыдачуОСНаНуждыУчреждения.ОсновныеСредства КАК ВедомостьНаВыдачуОСНаНуждыУчрежденияОсновныеСредства
		               |ГДЕ
		               |	ВедомостьНаВыдачуОСНаНуждыУчрежденияОсновныеСредства.ОсновноеСредство = &ОбъектНФА
		               |	И ВедомостьНаВыдачуОСНаНуждыУчрежденияОсновныеСредства.ИнвентарныйНомер = &ИнвНомер
		               |	И ВедомостьНаВыдачуОСНаНуждыУчрежденияОсновныеСредства.Ссылка = &Регистратор";
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ТребованиеНакладная0315006") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ВЫБОР
		               |		КОГДА ТребованиеНакладная0315006Материалы.Ссылка.ЦМОПолучатель = &ЦМО
		               |			ТОГДА ТребованиеНакладная0315006Материалы.Количество
		               |		ИНАЧЕ -1 * ТребованиеНакладная0315006Материалы.Количество
		               |	КОНЕЦ КАК Количество
		               |ИЗ
		               |	Документ.ТребованиеНакладная0315006.Материалы КАК ТребованиеНакладная0315006Материалы
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТребованиеНакладная0315006 КАК ТребованиеНакладная0315006
		               |		ПО ТребованиеНакладная0315006Материалы.Ссылка = ТребованиеНакладная0315006.Ссылка
		               |ГДЕ
		               |	ТребованиеНакладная0315006Материалы.Номенклатура = &ОбъектНФА
		               |	И ТребованиеНакладная0315006Материалы.Ссылка = &Регистратор";
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ВедомостьНаВыдачуМЗНаНуждыУчреждения") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ВЫБОР
		               |		КОГДА ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.ЦМОПолучатель = &ЦМО
		               |			ТОГДА ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Количество
		               |		ИНАЧЕ -1 * ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Количество
		               |	КОНЕЦ КАК Количество
		               |ИЗ
		               |	Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения.МатериальныеЗапасы КАК ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы
		               |ГДЕ
		               |	ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Ссылка = &Регистратор
		               |	И ВедомостьНаВыдачуМЗНаНуждыУчрежденияМатериальныеЗапасы.Номенклатура = &ОбъектНФА";
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ВводНачальныхОстатков") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ВЫБОР
		               |		КОГДА ВводНачальныхОстатковОС_Основная.ЦМО = &ЦМО
		               |			ТОГДА ВводНачальныхОстатковОС_Основная.Количество
		               |		ИНАЧЕ -1 * ВводНачальныхОстатковОС_Основная.Количество
		               |	КОНЕЦ КАК Количество
		               |ИЗ
		               |	Документ.ВводНачальныхОстатков.ОС_Основная КАК ВводНачальныхОстатковОС_Основная
		               |ГДЕ
		               |	ВводНачальныхОстатковОС_Основная.Ссылка = &Регистратор
		               |	И ВводНачальныхОстатковОС_Основная.ОС = &ОбъектНФА
		               |	И ВводНачальныхОстатковОС_Основная.ИнвНомерОС = &ИнвНомер
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ВЫБОР
		               |		КОГДА ВводНачальныхОстатковМатериалы.ЦМО = &ЦМО
		               |			ТОГДА ВводНачальныхОстатковМатериалы.Количество
		               |		ИНАЧЕ -1 * ВводНачальныхОстатковМатериалы.Количество
		               |	КОНЕЦ
		               |ИЗ
		               |	Документ.ВводНачальныхОстатков.Материалы КАК ВводНачальныхОстатковМатериалы
		               |ГДЕ
		               |	ВводНачальныхОстатковМатериалы.Номенклатура = &ОбъектНФА
		               |	И ВводНачальныхОстатковМатериалы.Ссылка = &Регистратор";
	КонецЕсли;
	
	Если ТекстЗапроса = "" Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ЦМО", ЦМО);
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("ОбъектНФА", ОбъектНФА);
	Запрос.УстановитьПараметр("ИнвНомер", ИнвНомер);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.Количество;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область ПечатьСправкиОСодержанииДрагМатериалов

Функция ПечатьСправкиОСодержанииДрагМатериалов(МассивОбъектов, ОбъектыПечати, ЭтоПоступление = Истина) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "СправкаОСодержанииДрагМатериалов";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_СправкаОСодержанииДрагМатериалов");
	
	Если ЭтоПоступление Тогда
		ОбластьЗаголовок		= Макет.ПолучитьОбласть("Заголовок");
	Иначе
		ОбластьЗаголовок		= Макет.ПолучитьОбласть("ЗаголовокПриСписании");
	КонецЕсли;
	ОбластьОбъект			= Макет.ПолучитьОбласть("ОбъектНФА");
	ОбластьЗаключение		= Макет.ПолучитьОбласть("ЗаключениеОСодержанииДрагМатериалов");
	ОбластьШапкаДМ			= Макет.ПолучитьОбласть("ШапкаТаблицыДМ");
	ОбластьШапкаЛом			= Макет.ПолучитьОбласть("ШапкаТаблицыЛома");
	ОбластьСтрокаДМ			= Макет.ПолучитьОбласть("СтрокаТаблицыДМ");
	ОбластьСтрокаЛома		= Макет.ПолучитьОбласть("СтрокаТаблицыЛома");
	ОбластьИтог				= Макет.ПолучитьОбласть("ВсегоПоСправке");
	ОбластьПодвал			= Макет.ПолучитьОбласть("Подвал");
	
	Штуки = УчетДрагМатериалов.Штуки();
	
	ПервыйДокумент = Истина;
	РезультатЗапроса = ДанныеДляСправки(МассивОбъектов);
	ВыборкаДокументов = РезультатЗапроса[0].Выбрать();
	ВыборкаДрагМатериалы = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаМогутСодержать = РезультатЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Если РезультатЗапроса.Количество() > 4 Тогда
		ВыборкаЛом = РезультатЗапроса[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Иначе
		ВыборкаЛом = Неопределено;
	КонецЕсли;
	
	ЕстьДанныеДМ = Ложь;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		ТаблицаИтоговПоСправке = Новый ТаблицаЗначений;
		ТаблицаИтоговПоСправке.Колонки.Добавить("ОбъектНФА", ТипОбъектаНФА());
		ТаблицаИтоговПоСправке.Колонки.Добавить("ВидДрагМатериала", Новый ОписаниеТипов("СправочникСсылка.ДрагМеталлы"));
		ТаблицаИтоговПоСправке.Колонки.Добавить("ЕдИзм", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
		ТаблицаИтоговПоСправке.Колонки.Добавить("МассаДМ", Новый ОписаниеТипов("Число"));
		ТаблицаИтоговПоСправке.Колонки.Добавить("КоличествоДМ", Новый ОписаниеТипов("Число"));
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
		СтруктураОбластьЗаголовок = Новый Структура;
		СтруктураОбластьЗаголовок.Вставить("НаименованиеОрганизации",?(СокрЛП(ВыборкаДокументов.Организация.НаименованиеПолное) = "", ВыборкаДокументов.Организация.Наименование, ВыборкаДокументов.Организация.НаименованиеПолное));
		СтруктураОбластьЗаголовок.Вставить("ДатаСоставления",Формат(ВыборкаДокументов.ДатаСоставления, "ДЛФ=D"));
		СтруктураОбластьЗаголовок.Вставить("ДокументОснованиеСправки",ВыборкаДокументов.ВидДокументаОснованияСправки + НСтр("ru = ' от '") +Формат(ВыборкаДокументов.ДатаДокументаОснованияСправки, "ДЛФ=D")
		+НСтр("ru = ' № '")+ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаДокументов.Ссылка, ВыборкаДокументов.НомерДокументаОснованияСправки));
		
		ОбластьЗаголовок.Параметры.Заполнить(СтруктураОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		
		ТаблицаИтоговПоСправке.Очистить();
		
		//Вывод данных об объекте НФА
	    ВыборкаДрагМатериалы.Сбросить();
		СчетчикОбъектов = 1;
	    Если ВыборкаДрагМатериалы.НайтиСледующий(Новый Структура("Ссылка", ВыборкаДокументов.Ссылка)) Тогда
	    	ВыборкаДМ = ВыборкаДрагМатериалы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаДМ.Следующий() Цикл
				
				Если СчетчикОбъектов = 1 Тогда
					ОбластьЗаключение.Параметры.ТекстЗаключения = НСтр("ru = 'Список объектов, содержащих драгоценные материалы'");
					ТабличныйДокумент.Вывести(ОбластьЗаключение);
				КонецЕсли;	
				
			    ЭтоНоваяТаблицаДМ = Истина;
				ВыборкаИнвНомер = ВыборкаДМ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаИнвНомер.Следующий() Цикл
					
					ВыборкаКоличествоОбъектов = ВыборкаИнвНомер.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаКоличествоОбъектов.Следующий() Цикл
						//Объект НФА и единицы измерения объектов
						Если ЗначениеЗаполнено(ВыборкаИнвНомер.ИнвНомер) Тогда
							ОбъектНФАСправки = СокрЛП(ВыборкаИнвНомер.ОбъектНФА.НаименованиеПолное) + " (инв. № "+СокрЛП(ВыборкаИнвНомер.ИнвНомер)+")";
							ЕдиницыИзмерения = Штуки;
						Иначе
							Если ТипЗнч(ВыборкаИнвНомер.ОбъектНФА) = Тип("СправочникСсылка.Номенклатура") Тогда
								ОбъектНФАСправки = СокрЛП(ВыборкаИнвНомер.ОбъектНФА.НаименованиеПолное) + " (ном. № "+СокрЛП(ВыборкаИнвНомер.ОбъектНФА.НоменклатурныйНомер)+")";
								ЕдиницыИзмерения = ВыборкаИнвНомер.ОбъектНФА.ЕдиницаИзмерения;
							Иначе	
								ОбъектНФАСправки = СокрЛП(ВыборкаИнвНомер.ОбъектНФА.НаименованиеПолное);
								ЕдиницыИзмерения = Штуки;
							КонецЕсли;
						КонецЕсли;	
						
						СтруктураСтрокиОбъекта = Новый Структура;
				    	СтруктураСтрокиОбъекта.Вставить("НомерПп", Строка(СчетчикОбъектов));
				    	СтруктураСтрокиОбъекта.Вставить("ОбъектНФА", ОбъектНФАСправки);
				    	СтруктураСтрокиОбъекта.Вставить("Количество", ВыборкаКоличествоОбъектов.Количество);
				    	СтруктураСтрокиОбъекта.Вставить("ЕдиницыИзмерения", ЕдиницыИзмерения);
						
						ОбластьОбъект.Параметры.Заполнить(СтруктураСтрокиОбъекта);
						ТабличныйДокумент.Вывести(ОбластьОбъект);
						
						//Список содержания ДМ
				    	Если ЭтоНоваяТаблицаДМ Тогда
				    		ТабличныйДокумент.Вывести(ОбластьШапкаДМ);
				    		ЭтоНоваяТаблицаДМ = Ложь;
				    	КонецЕсли;
						
						СчетчикДМ = 1;
						ВыборкаСодержаниеДМ = ВыборкаКоличествоОбъектов.Выбрать();
						Пока ВыборкаСодержаниеДМ.Следующий() Цикл
							
							СтруктураСтрокиДМ = Новый Структура;
					    	СтруктураСтрокиДМ.Вставить("НомПпДМ", СчетчикДМ);
					    	СтруктураСтрокиДМ.Вставить("ДрагоценныйМатериал", ВыборкаСодержаниеДМ.ВидДрагМатериала);
					    	СтруктураСтрокиДМ.Вставить("Масса", ВыборкаСодержаниеДМ.МассаДМ);
					    	СтруктураСтрокиДМ.Вставить("Количество", ВыборкаСодержаниеДМ.КоличествоДМ);
					    	СтруктураСтрокиДМ.Вставить("ЕдИзм", ВыборкаСодержаниеДМ.ЕдИзм);
							
							ОбластьСтрокаДМ.Параметры.Заполнить(СтруктураСтрокиДМ);
							ТабличныйДокумент.Вывести(ОбластьСтрокаДМ);
							
							НоваяСтрока = ТаблицаИтоговПоСправке.Добавить();
							НоваяСтрока.ОбъектНФА = ВыборкаСодержаниеДМ.ОбъектНФА;
							НоваяСтрока.ВидДрагМатериала = ВыборкаСодержаниеДМ.ВидДрагМатериала;
							НоваяСтрока.ЕдИзм = ВыборкаСодержаниеДМ.ЕдИзм;
							НоваяСтрока.МассаДМ = ВыборкаСодержаниеДМ.МассаДМ;
							НоваяСтрока.КоличествоДМ = ВыборкаСодержаниеДМ.КоличествоДМ;
							
							СчетчикДМ = СчетчикДМ + 1;
							ЕстьДанныеДМ = Истина;
						КонецЦикла;
						
						СчетчикОбъектов = СчетчикОбъектов + 1;
					КонецЦикла;	
				КонецЦикла;
			КонецЦикла;
	    КонецЕсли;
		
		//Объекты, которые могут содержать драгоценные материалы
	    ВыборкаМогутСодержать.Сбросить();
		СчетчикОбъектов = 1;
	    Если ВыборкаМогутСодержать.НайтиСледующий(Новый Структура("Ссылка", ВыборкаДокументов.Ссылка)) Тогда
	    	ВыборкаДМ = ВыборкаМогутСодержать.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
			Пока ВыборкаДМ.Следующий() Цикл
				
				ВыборкаИнвНомер = ВыборкаДМ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаИнвНомер.Следующий() Цикл
					
					ВыборкаКоличествоОбъектов = ВыборкаИнвНомер.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаКоличествоОбъектов.Следующий() Цикл
						
						Если ТаблицаИтоговПоСправке.Найти(ВыборкаИнвНомер.ОбъектНФА, "ОбъектНФА") = Неопределено Тогда
							
							Если СчетчикОбъектов = 1 Тогда
								ОбластьЗаключение.Параметры.ТекстЗаключения = НСтр("ru = 'Список объектов, содержание драгоценных материалов в которых, будет определено после списания и утилизации'");
								ТабличныйДокумент.Вывести(ОбластьЗаключение);
							КонецЕсли;	
							
						Иначе
							Продолжить;
						КонецЕсли;
						
					    ЭтоНоваяТаблицаДМ = Истина;
						
						//Объект НФА и единицы измерения объектов
						Если ЗначениеЗаполнено(ВыборкаИнвНомер.ИнвНомер) Тогда
							ОбъектНФАСправки = СокрЛП(ВыборкаИнвНомер.ОбъектНФА.НаименованиеПолное) + НСтр("ru = ' (инв. № '")+СокрЛП(ВыборкаИнвНомер.ИнвНомер)+")";
							ЕдиницыИзмерения = Штуки;
						Иначе
							Если ТипЗнч(ВыборкаИнвНомер.ОбъектНФА) = Тип("СправочникСсылка.Номенклатура") Тогда
								ОбъектНФАСправки = СокрЛП(ВыборкаИнвНомер.ОбъектНФА.НаименованиеПолное) + НСтр("ru = ' (ном. № '")+СокрЛП(ВыборкаИнвНомер.ОбъектНФА.НоменклатурныйНомер)+")";
								ЕдиницыИзмерения = ВыборкаИнвНомер.ОбъектНФА.ЕдиницаИзмерения;
							Иначе	
								ОбъектНФАСправки = СокрЛП(ВыборкаИнвНомер.ОбъектНФА.НаименованиеПолное);
								ЕдиницыИзмерения = Штуки;
							КонецЕсли;
						КонецЕсли;	
						
						СтруктураСтрокиОбъекта = Новый Структура;
				    	СтруктураСтрокиОбъекта.Вставить("НомерПп", Строка(СчетчикОбъектов));
				    	СтруктураСтрокиОбъекта.Вставить("ОбъектНФА", ОбъектНФАСправки);
				    	СтруктураСтрокиОбъекта.Вставить("Количество", ВыборкаКоличествоОбъектов.Количество);
				    	СтруктураСтрокиОбъекта.Вставить("ЕдиницыИзмерения", ЕдиницыИзмерения);
						
						ОбластьОбъект.Параметры.Заполнить(СтруктураСтрокиОбъекта);
						ТабличныйДокумент.Вывести(ОбластьОбъект);
						
						ЕстьДанныеДМ = Истина;
						
						СчетчикОбъектов = СчетчикОбъектов + 1;
						
					КонецЦикла;	
				КонецЦикла;	
			КонецЦикла;	
		КонецЕсли;
		
		//Лом и отходы, содержащие драгоценные материалы
		Если ВыборкаЛом <> Неопределено Тогда
			СчетчикОбъектов = 1;
			
		    ВыборкаЛом.Сбросить();
		    Если ВыборкаЛом.НайтиСледующий(Новый Структура("Ссылка", ВыборкаДокументов.Ссылка)) Тогда
		    	ВыборкаДМ = ВыборкаЛом.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаДМ.Следующий() Цикл
					
				    ЭтоНоваяТаблицаДМ = Истина;
					ВыборкаКоличествоОбъектов = ВыборкаДМ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаКоличествоОбъектов.Следующий() Цикл
						
						Если СчетчикОбъектов = 1 Тогда
							ОбластьЗаключение.Параметры.ТекстЗаключения = НСтр("ru = 'Лом и отходы, содержащие драгоценные материалы'");
							ТабличныйДокумент.Вывести(ОбластьЗаключение);
						КонецЕсли;	
					
						//Объект НФА и единицы измерения объектов
						ОбъектНФАСправки = СокрЛП(ВыборкаКоличествоОбъектов.ОбъектНФА.НаименованиеПолное) + " (ном. № "+СокрЛП(ВыборкаКоличествоОбъектов.ОбъектНФА.НоменклатурныйНомер)+")";
						ЕдиницыИзмерения = ВыборкаКоличествоОбъектов.ОбъектНФА.ЕдиницаИзмерения;
						
						СтруктураСтрокиОбъекта = Новый Структура;
				    	СтруктураСтрокиОбъекта.Вставить("НомерПп", Строка(СчетчикОбъектов));
				    	СтруктураСтрокиОбъекта.Вставить("ОбъектНФА", ОбъектНФАСправки);
				    	СтруктураСтрокиОбъекта.Вставить("Количество", ВыборкаКоличествоОбъектов.Количество);
				    	СтруктураСтрокиОбъекта.Вставить("ЕдиницыИзмерения", ЕдиницыИзмерения);
						
						ОбластьОбъект.Параметры.Заполнить(СтруктураСтрокиОбъекта);
						ТабличныйДокумент.Вывести(ОбластьОбъект);
						
						//Список содержания ДМ
				    	Если ЭтоНоваяТаблицаДМ Тогда
				    		ТабличныйДокумент.Вывести(ОбластьШапкаЛом);
				    		ЭтоНоваяТаблицаДМ = Ложь;
				    	КонецЕсли;
						
						СчетчикДМ = 1;
						ВыборкаСодержаниеДМ = ВыборкаКоличествоОбъектов.Выбрать();
						Пока ВыборкаСодержаниеДМ.Следующий() Цикл
							
							СтруктураСтрокиДМ = Новый Структура;
					    	СтруктураСтрокиДМ.Вставить("НомПпДМ", СчетчикДМ);
					    	СтруктураСтрокиДМ.Вставить("ДрагоценныйМатериал", ВыборкаСодержаниеДМ.ВидДрагМатериала);
					    	СтруктураСтрокиДМ.Вставить("ЧистаяМасса", ВыборкаСодержаниеДМ.ЧистаяМасса);
					    	СтруктураСтрокиДМ.Вставить("ЛигатурнаяМасса", ВыборкаСодержаниеДМ.ЛигатурнаяМасса);
					    	СтруктураСтрокиДМ.Вставить("Количество", ВыборкаСодержаниеДМ.КоличествоДМ);
					    	СтруктураСтрокиДМ.Вставить("ЕдИзм", ВыборкаСодержаниеДМ.ЕдИзм);
							
							ОбластьСтрокаЛома.Параметры.Заполнить(СтруктураСтрокиДМ);
							ТабличныйДокумент.Вывести(ОбластьСтрокаЛома);
							
							НоваяСтрока = ТаблицаИтоговПоСправке.Добавить();
							НоваяСтрока.ОбъектНФА = ВыборкаСодержаниеДМ.ОбъектНФА;
							НоваяСтрока.ВидДрагМатериала = ВыборкаСодержаниеДМ.ВидДрагМатериала;
							НоваяСтрока.ЕдИзм = ВыборкаСодержаниеДМ.ЕдИзм;
							НоваяСтрока.МассаДМ = ВыборкаСодержаниеДМ.ЧистаяМасса;
							НоваяСтрока.КоличествоДМ = ВыборкаСодержаниеДМ.КоличествоДМ;
							
							СчетчикДМ = СчетчикДМ + 1;
							ЕстьДанныеДМ = Истина;
						КонецЦикла;
						
						СчетчикОбъектов = СчетчикОбъектов + 1;
					КонецЦикла;
					
				КонецЦикла;
		    КонецЕсли;
			
			
		КонецЕсли;
		
		//Всего по справке
		ТаблицаИтоговПоСправке.Свернуть("ВидДрагМатериала, ЕдИзм", "МассаДМ, КоличествоДМ");
		СчетчикДМ = 1;
		
		Для каждого ТекСтрока Из ТаблицаИтоговПоСправке Цикл
			Если СчетчикДМ = 1 Тогда
				ТабличныйДокумент.Вывести(ОбластьИтог);
				ТабличныйДокумент.Вывести(ОбластьШапкаДМ);
			КонецЕсли;	
			
			СтруктураСтрокиДМ = Новый Структура;
	    	СтруктураСтрокиДМ.Вставить("НомПпДМ", СчетчикДМ);
	    	СтруктураСтрокиДМ.Вставить("ДрагоценныйМатериал", ТекСтрока.ВидДрагМатериала);
	    	СтруктураСтрокиДМ.Вставить("Масса", ТекСтрока.МассаДМ);
	    	СтруктураСтрокиДМ.Вставить("Количество", ТекСтрока.КоличествоДМ);
	    	СтруктураСтрокиДМ.Вставить("ЕдИзм", ТекСтрока.ЕдИзм);
			
			ОбластьСтрокаДМ.Параметры.Заполнить(СтруктураСтрокиДМ);
			ТабличныйДокумент.Вывести(ОбластьСтрокаДМ);
			
			СчетчикДМ = СчетчикДМ + 1;
		КонецЦикла;	
		
		//Если нет данных для вывода
		Если НЕ ЕстьДанныеДМ Тогда
			ОбластьЗаключение.Параметры.ТекстЗаключения = НСтр("ru = 'Сведения о содержании драгоценных материалов отсутствуют.'");
			ТабличныйДокумент.Вывести(ОбластьЗаключение);
		КонецЕсли;
		
		//Ответственный
		Сотрудник = ВыборкаДокументов.СотрудникМОЛ;
		ДатаСведений = ВыборкаДокументов.ДатаДокументаОснованияСправки;
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Должность", Сотрудник, ДатаСведений);	
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
			Должность = ДанныеСотрудника.Должность;
			ФамилияИнициалы = Справочники.Сотрудники.ФамилияИО(Сотрудник, Ложь,ДатаСведений); 
			
			ДанныеОтветственного = Новый Структура;
			ДанныеОтветственного.Вставить("Должность", Должность);
			ДанныеОтветственного.Вставить("ФамилияИнициалы", ФамилияИнициалы);
			
			ОбластьПодвал.Параметры.Заполнить(ДанныеОтветственного);
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции	

