	Иначе	
		Результат = "Значение в колонке " + Сред(НаименованиеСлагаемого,6)+ " строки "+Сред(НаименованиеСлагаемого,3,3);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьПолноеНаименованиеСлагаемого()

Функция ПолучитьНаименованиеЗаголовка(ВидОтчетаДМ, ИмяПоказателя) Экспорт

	Если ВидОтчетаДМ = "1-ДМ" Тогда
		Результат = "Код строки "+Сред(ИмяПоказателя,4,2)+", колонка "+Сред(ИмяПоказателя,7);
	ИначеЕсли ВидОтчетаДМ = "2-ДМ (Давальческое сырье)" Тогда
		Результат = "Код строки "+ПолучитьКодСтроки2ДМДавальческоеСырье(ИмяПоказателя)+", колонка "+Сред(ИмяПоказателя,7);
	ИначеЕсли ВидОтчетаДМ = "2-ДМ" Тогда
		Результат = "Код строки "+Сред(ИмяПоказателя,4,2)+", колонка "+Строка(Число(Сред(ИмяПоказателя,6))+1);
	ИначеЕсли ВидОтчетаДМ = "2-ДМ (Приложение)" Тогда
		Результат = "Код строки "+Сред(ИмяПоказателя,4,3)+", колонка "+Строка(Число(Сред(ИмяПоказателя,8))+1);
	Иначе	
		Результат = "Код строки "+Сред(ИмяПоказателя,3,3)+", колонка "+Сред(ИмяПоказателя,6);
	КонецЕсли;	
		
	Возврат Результат;
	
КонецФункции // ПолучитьНаименованиеЗаголовка()

Функция ПолучитьКодСтроки2ДМДавальческоеСырье(ИмяПоказателя)
	Результат = "";
	ЧастьСтроки = Сред(ИмяПоказателя,4,3);
	Если ЧастьСтроки = "010" Тогда
		Результат = "01";
	ИначеЕсли ЧастьСтроки = "020" Тогда
		Результат = "30";
	ИначеЕсли ЧастьСтроки = "030" Тогда
		Результат = "02";
	ИначеЕсли ЧастьСтроки = "040" Тогда
		Результат = "40";
	ИначеЕсли ЧастьСтроки = "050" Тогда
		Результат = "03";
	ИначеЕсли ЧастьСтроки = "060" Тогда
		Результат = "50";
	ИначеЕсли ЧастьСтроки = "070" Тогда
		Результат = "04";
	ИначеЕсли ЧастьСтроки = "080" Тогда
		Результат = "60";
	ИначеЕсли ЧастьСтроки = "090" Тогда
		Результат = "05";
	ИначеЕсли ЧастьСтроки = "100" Тогда
		Результат = "70";
	ИначеЕсли ЧастьСтроки = "110" Тогда
		Результат = "06";
	ИначеЕсли ЧастьСтроки = "120" Тогда
		Результат = "80";
	ИначеЕсли ЧастьСтроки = "130" Тогда
		Результат = "07";
	ИначеЕсли ЧастьСтроки = "140" Тогда
		Результат = "90";
	ИначеЕсли ЧастьСтроки = "150" Тогда
		Результат = "08";
	ИначеЕсли ЧастьСтроки = "160" Тогда
		Результат = "100";
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

