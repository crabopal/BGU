Функция ДобавитьСтрокуРасшифровкиДляРасчетногоЗначенияОтчета1ДМФормаОтчета2012Кв1(ТаблицаРасшифровок, ИмяПоказателя, ДрагМатериал, МассивЗначенийЯчеек)
	
	Если ТаблицаРасшифровок = Неопределено Тогда
		ТаблицаРасшифровок = Новый ТаблицаЗначений;
		ТаблицаРасшифровок.Колонки.Добавить("ИмяПоказателя");
		ТаблицаРасшифровок.Колонки.Добавить("ДрагМатериал");
		ТаблицаРасшифровок.Колонки.Добавить("ТипОбъектаНФА");
		ТаблицаРасшифровок.Колонки.Добавить("ОбъектНФА");
		ТаблицаРасшифровок.Колонки.Добавить("ИнвНомер");
		ТаблицаРасшифровок.Колонки.Добавить("Количество");
		ТаблицаРасшифровок.Колонки.Добавить("ЕдиницаИзмерения");
		ТаблицаРасшифровок.Колонки.Добавить("ЗнакОперации");
		ТаблицаРасшифровок.Колонки.Добавить("НаименованиеСлагаемого");
		ТаблицаРасшифровок.Колонки.Добавить("ДополнительныеПараметры");
		ТаблицаРасшифровок.Колонки.Добавить("Масса");
	КонецЕсли;
	
	СчетчикСтрок = 0;
	Для Каждого ТекСтрока Из МассивЗначенийЯчеек Цикл
		НомерКолонки = СчетчикСтрок + 4;
		НоваяСтрокаРасшифровки = ТаблицаРасшифровок.Добавить();
		НоваяСтрокаРасшифровки.ИмяПоказателя	= ИмяПоказателя;
		НоваяСтрокаРасшифровки.ДрагМатериал		= ДрагМатериал;
		НоваяСтрокаРасшифровки.ТипОбъектаНФА	= "";
		НоваяСтрокаРасшифровки.ОбъектНФА		= "";
		НоваяСтрокаРасшифровки.ИнвНомер			= "";
		НоваяСтрокаРасшифровки.Количество		= "";
		НоваяСтрокаРасшифровки.ЕдиницаИзмерения	= "";
		НоваяСтрокаРасшифровки.ЗнакОперации = ?(НомерКолонки > 5,"-","+");
		НоваяСтрокаРасшифровки.НаименованиеСлагаемого = "П0"+Сред(ИмяПоказателя,3,4)+?(НомерКолонки > 5, Строка(НомерКолонки+1), Строка(НомерКолонки));
		НоваяСтрокаРасшифровки.ДополнительныеПараметры = "";
		НоваяСтрокаРасшифровки.Масса			= ТекСтрока;
		
		СчетчикСтрок = СчетчикСтрок + 1;
	КонецЦикла;
	
КонецФункции	

//Общие функции заполнения
Функция ЕдиницаИзмеренияДрагМатериалов(ДрагМатериалы)
	Результат = Граммы();
	
	Если ТипЗнч(ДрагМатериалы) = Тип("Массив") Тогда
		Если ДрагМатериалы.Количество()>0 Тогда
			ЗначениеДляПроверки = ДрагМатериалы[0];
		КонецЕсли;	
	ИначеЕсли ТипЗнч(ДрагМатериалы) = Тип("СправочникСсылка.ДрагМеталлы") Тогда
		ЗначениеДляПроверки = ДрагМатериалы;
	Иначе
		Возврат Результат;
	КонецЕсли;	
	
	МассивДрагоценныхКамней = МассивДрагКамней();
	Если МассивДрагоценныхКамней.Найти(ЗначениеДляПроверки)<>Неопределено Тогда
		Результат = Караты();
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ОстаткиНаПериодДляОС(ВидОтчета, Организация, МассивСчетовОС, МассивТиповОбъектовОС = Неопределено, НеВыбиратьМассивТиповОбъектовОС = Неопределено, ДрагМатериалы, ПериодСведений)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстатокДт,
			|	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта
			|ПОМЕСТИТЬ ОСПослеОтбора
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&МассивСчетовОС) И Счет.Код <> ""МЦК"", ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства), Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
			|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
			|	И &НетОтбораПоТипуОбъекта
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт,
			|	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка))
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет.Код = ""МЦК"", ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность), Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
			|		ПО (ВЫБОР
			|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ОсновныеСредства
			|					ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
			|				ИНАЧЕ ЛОЖЬ
			|			КОНЕЦ)
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
			|	И &НетОтбораПоТипуОбъекта
			|	И ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ОсновныеСредства
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеОСПослеОтбора.ОбъектНФА КАК ОбъектНФА,
			|	СУММА(ДанныеОСПослеОтбора.КоличествоОстатокДт) КАК КоличествоОстатокДт,
			|	ДанныеОСПослеОтбора.ТипОбъекта КАК ТипОбъекта
			|ПОМЕСТИТЬ ДанныеОСВсеПослеОтбора
			|ИЗ
			|	ОСПослеОтбора КАК ДанныеОСПослеОтбора
			|
			|СГРУППИРОВАТЬ ПО
			|	ДанныеОСПослеОтбора.ОбъектНФА,
			|	ДанныеОСПослеОтбора.ТипОбъекта
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
			|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
