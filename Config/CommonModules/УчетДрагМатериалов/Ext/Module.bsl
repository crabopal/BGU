Функция ДобавитьСтрокуРасшифровкиДляРасчетногоЗначенияОтчета2ДМФормаОтчета2012Кв1(ТаблицаРасшифровок, ИмяПоказателя, ДрагМатериал, МассивЗначенийЯчеек)
	
	Если ТаблицаРасшифровок = Неопределено Тогда
		ТаблицаРасшифровок = Новый ТаблицаЗначений;
		ТаблицаРасшифровок.Колонки.Добавить("ИмяПоказателя");
		ТаблицаРасшифровок.Колонки.Добавить("ДрагМатериал");
		ТаблицаРасшифровок.Колонки.Добавить("ТипОбъектаНФА");
		ТаблицаРасшифровок.Колонки.Добавить("ОбъектНФА");
		ТаблицаРасшифровок.Колонки.Добавить("ИнвНомер");
		ТаблицаРасшифровок.Колонки.Добавить("Количество");
		ТаблицаРасшифровок.Колонки.Добавить("ЕдиницаИзмерения");
		ТаблицаРасшифровок.Колонки.Добавить("ЗнакОперации");
		ТаблицаРасшифровок.Колонки.Добавить("НаименованиеСлагаемого");
		ТаблицаРасшифровок.Колонки.Добавить("ДополнительныеПараметры");
		ТаблицаРасшифровок.Колонки.Добавить("Масса");
	КонецЕсли;
	
	СчетчикСтрок = 0;
	Для Каждого ТекСтрока Из МассивЗначенийЯчеек Цикл
		ДвеПоследниеЦифры = "";
		НомерКолонки = СчетчикСтрок + 4;
		НоваяСтрокаРасшифровки = ТаблицаРасшифровок.Добавить();
		НоваяСтрокаРасшифровки.ИмяПоказателя	= ИмяПоказателя;
		НоваяСтрокаРасшифровки.ДрагМатериал		= ДрагМатериал;
		НоваяСтрокаРасшифровки.ТипОбъектаНФА	= "";
		НоваяСтрокаРасшифровки.ОбъектНФА		= "";
		НоваяСтрокаРасшифровки.ИнвНомер			= "";
		НоваяСтрокаРасшифровки.Количество		= "";
		НоваяСтрокаРасшифровки.ЕдиницаИзмерения	= "";
		НоваяСтрокаРасшифровки.ЗнакОперации = ?(НомерКолонки > 5,"-","+");
		
		НоваяСтрокаРасшифровки.НаименованиеСлагаемого = НаименованиеСлагаемого2ДМ(ИмяПоказателя, СчетчикСтрок);
		НоваяСтрокаРасшифровки.ДополнительныеПараметры = "";
		НоваяСтрокаРасшифровки.Масса			= ТекСтрока;
		
		СчетчикСтрок = СчетчикСтрок + 1;
	КонецЦикла;
	
КонецФункции

Функция НаименованиеСлагаемого2ДМ(ИмяПоказателя, СчетчикСтрок)
	Результат = "П0"+Сред(ИмяПоказателя,3,3);
	Если СчетчикСтрок = 0 Тогда
		Результат = Результат+"04";	
	ИначеЕсли СчетчикСтрок = 1 Тогда
		Результат = Результат+"05";	
	ИначеЕсли СчетчикСтрок = 2 Тогда
		Результат = Результат+"10";	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции
	
