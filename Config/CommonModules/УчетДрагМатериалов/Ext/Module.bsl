	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(796));
	Запрос.УстановитьПараметр("МассивСчетовОС",		МассивСчетовОС);
	Запрос.УстановитьПараметр("МассивСубконтоОС",	МассивСубконтоОС);
	Запрос.УстановитьПараметр("МассивСубконтоМЦ",	МассивСубконтоМЦ);
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияДМ",	ЕдиницаИзмеренияДМ);
	Запрос.УстановитьПараметр("ДрагМатериалы",		ДрагМатериалы);
	Запрос.УстановитьПараметр("ОтчетДМ",			ВидОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;
КонецФункции	

Функция ПоступилоВОтчетномПериодеОС(ВидОтчета, Организация, МассивСчетовОС, МассивТиповОбъектовОС = Неопределено, НеВыбиратьМассивТиповОбъектовОС = Неопределено, ДрагМатериалы, НачалоПериода, КонецПериода)
	
	НеСписокРегистраторовПоступленияДрагМатериалов = Новый Массив;
	НеСписокРегистраторовПоступленияДрагМатериалов.Добавить(Тип("ДокументСсылка.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный"));
	Если НЕ ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
		НеСписокРегистраторовПоступленияДрагМатериалов.Добавить(Тип("ДокументСсылка.ПоступлениеОС"));
		НеСписокРегистраторовПоступленияДрагМатериалов.Добавить(Тип("ДокументСсылка.ПоступлениеОСИК"));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		               |	НаличиеДрагМатериаловВОбъектахНФАОбороты.ОбъектНФА КАК ОбъектНФА,
		               |	НаличиеДрагМатериаловВОбъектахНФАОбороты.ИнвНомер КАК ИнвНомер,
		               |	НаличиеДрагМатериаловВОбъектахНФАОбороты.ЕдИзм КАК ЕдИзм,
		               |	НаличиеДрагМатериаловВОбъектахНФАОбороты.ВидДрагМатериала КАК ВидДрагМатериала,
		               |	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОбороты.МассаДМПриход, 0) КАК МассаДМПриход,
		               |	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта
		               |ПОМЕСТИТЬ ДанныеНФАВсе
		               |ИЗ
		               |	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Обороты(
		               |			&НачалоПериода,
		               |			&КонецПериода,
		               |			Запись,
		               |			Организация = &Организация
		               |				И ОбъектНФА ССЫЛКА Справочник.ОсновныеСредства
		               |				И ВидДрагМатериала В (&ДрагМатериалы)) КАК НаличиеДрагМатериаловВОбъектахНФАОбороты
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
		               |				&КонецПериода,
		               |				Организация = &Организация
		               |					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
		               |		ПО НаличиеДрагМатериаловВОбъектахНФАОбороты.ОбъектНФА = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
		               |ГДЕ
					   |	&НетОтбораПоТипуОбъекта
					   |	И &НеУчитыватьДрагМатериалыВКапвложении
					   |	И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.ПринятиеКУчетуОбъектовОС)
					   |			И ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.ПринятиеКУчетуОбъектовОС).АналитикаОперацииСДрагМатериалами = Значение(Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ВыходИзГрупповогоИнвентарногоУчета))
					   |	И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.ПринятиеКУчетуОбъектовИК)
					   |			И ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.ПринятиеКУчетуОбъектовИК).АналитикаОперацииСДрагМатериалами = Значение(Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ВыходИзГрупповогоИнвентарногоУчета))
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ДанныеНФАВсе.ОбъектНФА КАК ОбъектНФА,
		               |	ДанныеНФАВсе.ИнвНомер КАК ИнвНомер,
		               |	&ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	0 КАК Количество,
		               |	ДанныеНФАВсе.ЕдИзм КАК ЕдИзм,
		               |	ДанныеНФАВсе.ВидДрагМатериала КАК ВидДрагМатериала,
		               |	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент,
		               |	ВЫРАЗИТЬ(ДанныеНФАВсе.МассаДМПриход * ВЫБОР
		               |			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент ЕСТЬ NULL
		               |				ТОГДА 1
		               |			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент = 0
		               |				ТОГДА 1
		               |			ИНАЧЕ НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент
		               |		КОНЕЦ КАК ЧИСЛО(17, 8)) КАК МассаДМУчетВЕдИзмОтчета
		               |ПОМЕСТИТЬ ДанныеНФА
		               |ИЗ
		               |	ДанныеНФАВсе КАК ДанныеНФАВсе
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
		               |		ПО ДанныеНФАВсе.ЕдИзм = НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ДанныеНФА.ОбъектНФА КАК ОбъектНФА,
		               |	ДанныеНФА.ИнвНомер КАК ИнвентарныйНомер,
		               |	ДанныеНФА.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	ДанныеНФА.Количество КАК Количество,
		               |	ДанныеНФА.ЕдИзм КАК ЕдИзм,
		               |	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
		               |	ДанныеНФА.Коэффициент КАК Коэффициент,
		               |	ДанныеНФА.МассаДМУчетВЕдИзмОтчета КАК МассаДМУчетВЕдИзмОтчета
		               |ИЗ
		               |	ДанныеНФА КАК ДанныеНФА
		               |ГДЕ
		               |	ДанныеНФА.МассаДМУчетВЕдИзмОтчета > 0";	


	Если (МассивТиповОбъектовОС = Неопределено) И (НеВыбиратьМассивТиповОбъектовОС = Неопределено) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта",Истина);
	ИначеЕсли (НеВыбиратьМассивТиповОбъектовОС = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) В (&МассивТиповОбъектовОС)");
		Запрос.УстановитьПараметр("МассивТиповОбъектовОС", МассивТиповОбъектовОС);
	ИначеЕсли (МассивТиповОбъектовОС = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "НЕ (ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) В (&НеВыбиратьМассивТиповОбъектовОС))");
		Запрос.УстановитьПараметр("НеВыбиратьМассивТиповОбъектовОС", НеВыбиратьМассивТиповОбъектовОС);
	Иначе
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта", Истина);
	КонецЕсли;	
	
	Если ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&НеУчитыватьДрагМатериалыВКапвложении", 
			" НЕ ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) В (&НеСписокРегистраторовПоступленияДрагМатериалов)
			|И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.ПринятиеКУчетуОбъектовОС)
            |			И (ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.ПринятиеКУчетуОбъектовОС).МЦСДрагоценнымиМатериалами.НомерСтроки ЕСТЬ НЕ NULL))
			|И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.РешениеОПризнанииОбъектовОС)
			|			И (ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.РешениеОПризнанииОбъектовОС).МЦСДрагоценнымиМатериалами.НомерСтроки ЕСТЬ НЕ NULL))
			|И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.ПринятиеКУчетуОбъектовИК)
            |			И (ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.ПринятиеКУчетуОбъектовИК).МЦСДрагоценнымиМатериалами.НомерСтроки ЕСТЬ НЕ NULL))
			|И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.РешениеОПризнанииОбъектовОСИК)
			|			И (ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.РешениеОПризнанииОбъектовОСИК).МЦСДрагоценнымиМатериалами.НомерСтроки ЕСТЬ НЕ NULL)) ");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НеУчитыватьДрагМатериалыВКапвложении",
			" НЕ ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) В (&НеСписокРегистраторовПоступленияДрагМатериалов)
			|И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.ИзменениеНаличияДрагМатериалов)
			|			И ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.ИзменениеНаличияДрагМатериалов).ВидОперацийНаличияДрагМатериалов = 1) ");
		
	КонецЕсли;
	
	МассивСубконтоОС = Новый Массив;
	МассивСубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	МассивСубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	ЕдиницаИзмеренияДМ = ЕдиницаИзмеренияДрагМатериалов(ДрагМатериалы);
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("МассивСчетовОС", МассивСчетовОС);
	Запрос.УстановитьПараметр("МассивСубконтоОС", МассивСубконтоОС);	
	Запрос.УстановитьПараметр("ДрагМатериалы", ДрагМатериалы);			   
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);			   
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);			   
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Штуки());
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияДМ",	ЕдиницаИзмеренияДМ);
	Запрос.УстановитьПараметр("ОтчетДМ",	ВидОтчета);  
	Запрос.УстановитьПараметр("НеСписокРегистраторовПоступленияДрагМатериалов", НеСписокРегистраторовПоступленияДрагМатериалов);
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;
КонецФункции

Функция РезультатыДвиженийВОтчетномПериодеОСПоАналитике(ВидОтчета, Организация, МассивСчетовОС, МассивТиповОбъектовОС = Неопределено, НеВыбиратьМассивТиповОбъектовОС = Неопределено, ДрагМатериалы, НачалоПериода, КонецПериода, ВидДвижения, АналитикаОборотовЗаПериод = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НаличиеДрагМатериаловВОбъектахНФА.ОбъектНФА КАК ОбъектНФА,
	               |	НаличиеДрагМатериаловВОбъектахНФА.ИнвНомер КАК ИнвНомер,
	               |	НаличиеДрагМатериаловВОбъектахНФА.ЕдИзм КАК ЕдИзм,
	               |	НаличиеДрагМатериаловВОбъектахНФА.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФА.МассаДМ, 0) КАК МассаДМПриход,
	               |	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта
	               |ПОМЕСТИТЬ ДанныеНФАВсе
	               |ИЗ
	               |	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА КАК НаличиеДрагМатериаловВОбъектахНФА
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
	               |				&КонецПериода,
	               |				Организация = &Организация
	               |					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
	               |		ПО НаличиеДрагМатериаловВОбъектахНФА.ОбъектНФА = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
	               |ГДЕ
	               |	НаличиеДрагМатериаловВОбъектахНФА.АналитикаОперации В (&АналитикаОперации)
	               |	И НаличиеДрагМатериаловВОбъектахНФА.Период МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И НаличиеДрагМатериаловВОбъектахНФА.Организация = &Организация
	               |	И НаличиеДрагМатериаловВОбъектахНФА.ОбъектНФА ССЫЛКА Справочник.ОсновныеСредства
	               |	И НаличиеДрагМатериаловВОбъектахНФА.ВидДрагМатериала В(&ДрагМатериалы)
	               |	И НаличиеДрагМатериаловВОбъектахНФА.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеНФАВсе.ОбъектНФА КАК ОбъектНФА,
	               |	ДанныеНФАВсе.ИнвНомер КАК ИнвНомер,
	               |	&ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	0 КАК Количество,
	               |	ДанныеНФАВсе.ЕдИзм КАК ЕдИзм,
	               |	ДанныеНФАВсе.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент,
	               |	ВЫРАЗИТЬ(ДанныеНФАВсе.МассаДМПриход * ВЫБОР
	               |			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент ЕСТЬ NULL
	               |				ТОГДА 1
	               |			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент = 0
	               |				ТОГДА 1
	               |			ИНАЧЕ НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент
	               |		КОНЕЦ КАК ЧИСЛО(17, 8)) КАК МассаДМУчетВЕдИзмОтчета
	               |ПОМЕСТИТЬ ДанныеНФА
	               |ИЗ
	               |	ДанныеНФАВсе КАК ДанныеНФАВсе
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
	               |		ПО ДанныеНФАВсе.ЕдИзм = НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения
	               |ГДЕ
	               |	&НетОтбораПоТипуОбъекта
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеНФА.ОбъектНФА КАК ОбъектНФА,
	               |	ДанныеНФА.ИнвНомер КАК ИнвентарныйНомер,
	               |	ДанныеНФА.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ДанныеНФА.Количество КАК Количество,
	               |	ДанныеНФА.ЕдИзм КАК ЕдИзм,
	               |	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	ДанныеНФА.Коэффициент КАК Коэффициент,
	               |	ДанныеНФА.МассаДМУчетВЕдИзмОтчета КАК МассаДМУчетВЕдИзмОтчета
	               |ИЗ
	               |	ДанныеНФА КАК ДанныеНФА
	               |ГДЕ
	               |	ДанныеНФА.МассаДМУчетВЕдИзмОтчета > 0";			
				   
	Если (МассивТиповОбъектовОС = Неопределено) И (НеВыбиратьМассивТиповОбъектовОС = Неопределено) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта",Истина);
	ИначеЕсли (НеВыбиратьМассивТиповОбъектовОС = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "ЕСТЬNULL(ДанныеНФАВсе.ТипОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) В (&МассивТиповОбъектовОС)");
		Запрос.УстановитьПараметр("МассивТиповОбъектовОС", МассивТиповОбъектовОС);
	ИначеЕсли (МассивТиповОбъектовОС = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "НЕ (ЕСТЬNULL(ДанныеНФАВсе.ТипОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) В (&НеВыбиратьМассивТиповОбъектовОС))");
		Запрос.УстановитьПараметр("НеВыбиратьМассивТиповОбъектовОС", НеВыбиратьМассивТиповОбъектовОС);
	Иначе
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта", Истина);
	КонецЕсли;
	
	Если ВидДвижения = "Расход" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)", "ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)");
	КонецЕсли;	
				   
	ЕдиницаИзмеренияДМ = ЕдиницаИзмеренияДрагМатериалов(ДрагМатериалы);
	
	Запрос.УстановитьПараметр("Организация", Организация);			   
	Запрос.УстановитьПараметр("МассивСчетовОС", МассивСчетовОС);			   
	Запрос.УстановитьПараметр("ДрагМатериалы", ДрагМатериалы);			   
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);			   
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода.Значение);			   
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Штуки());
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияДМ",	ЕдиницаИзмеренияДМ);
	Запрос.УстановитьПараметр("ОтчетДМ",	ВидОтчета);  
	Запрос.УстановитьПараметр("ВидДвижения",	ВидДвижения);  
	Запрос.УстановитьПараметр("АналитикаОперации",	АналитикаОборотовЗаПериод);  
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;
КонецФункции

Функция СписаноВЛомВОтчетномПериодеОС(ВидОтчета, Организация, МассивСчетовОС, МассивТиповОбъектовОС = Неопределено, НеВыбиратьМассивТиповОбъектовОС = Неопределено, ДрагМатериалы, НачалоПериода, КонецПериода)
	
	СписокРегистраторовСписания = Новый Массив;
	СписокРегистраторовСписания.Добавить(Тип("ДокументСсылка.СписаниеОбъектовОС"));
	СписокРегистраторовСписания.Добавить(Тип("ДокументСсылка.СписаниеТранспорта"));
	СписокРегистраторовСписания.Добавить(Тип("ДокументСсылка.СписаниеОбъектовИК"));
	СписокРегистраторовСписания.Добавить(Тип("ДокументСсылка.СписаниеТранспортаИК"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НаличиеДрагМатериаловВОбъектахНФАОбороты.ОбъектНФА КАК ОбъектНФА,
	               |	НаличиеДрагМатериаловВОбъектахНФАОбороты.ИнвНомер КАК ИнвНомер,
	               |	НаличиеДрагМатериаловВОбъектахНФАОбороты.ЕдИзм КАК ЕдИзм,
	               |	НаличиеДрагМатериаловВОбъектахНФАОбороты.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОбороты.МассаДМРасход, 0) КАК МассаДМРасход,
	               |	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта
	               |ПОМЕСТИТЬ ДанныеНФАВсе
	               |ИЗ
	               |	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Обороты(
	               |			&НачалоПериода,
	               |			&КонецПериода,
	               |			Запись,
	               |			Организация = &Организация
	               |				И ОбъектНФА ССЫЛКА Справочник.ОсновныеСредства
	               |				И ВидДрагМатериала В (&ДрагМатериалы)) КАК НаличиеДрагМатериаловВОбъектахНФАОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
	               |				&КонецПериода,
	               |				Организация = &Организация
	               |					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
	               |		ПО НаличиеДрагМатериаловВОбъектахНФАОбороты.ОбъектНФА = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) В (&СписокРегистраторовСписания)
	               |	И НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор.НоменклатураЛома <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
				   |	И &УчитыватьДанныеКапвложений
				   |;
				   |///////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ
	               |	ДанныеНФАВсе.ОбъектНФА КАК ОбъектНФА,
	               |	ДанныеНФАВсе.ИнвНомер КАК ИнвНомер,
	               |	ДанныеНФАВсе.ТипОбъекта КАК ТипОбъекта,
	               |	&ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	0 КАК Количество,
	               |	ДанныеНФАВсе.ЕдИзм КАК ЕдИзм,
	               |	ДанныеНФАВсе.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент,
	               |	ВЫРАЗИТЬ(ДанныеНФАВсе.МассаДМРасход * ВЫБОР
	               |			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент ЕСТЬ NULL
	               |				ТОГДА 1
	               |			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент = 0
	               |				ТОГДА 1
	               |			ИНАЧЕ НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент
	               |		КОНЕЦ КАК ЧИСЛО(17, 8)) КАК МассаДМУчетВЕдИзмОтчета
	               |ПОМЕСТИТЬ ДанныеНФА
	               |ИЗ
	               |	ДанныеНФАВсе КАК ДанныеНФАВсе
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
	               |		ПО ДанныеНФАВсе.ЕдИзм = НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения
	               |ГДЕ
	               |	&НетОтбораПоТипуОбъекта
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеНФА.ОбъектНФА КАК ОбъектНФА,
	               |	ДанныеНФА.ИнвНомер КАК ИнвентарныйНомер,
	               |	&ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	0 КАК Количество,
	               |	ДанныеНФА.ЕдИзм КАК ЕдИзм,
	               |	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	ДанныеНФА.Коэффициент КАК Коэффициент,
	               |	ДанныеНФА.ТипОбъекта КАК ТипОбъекта,
	               |	ДанныеНФА.МассаДМУчетВЕдИзмОтчета КАК МассаДМУчетВЕдИзмОтчета
	               |ИЗ
	               |	ДанныеНФА КАК ДанныеНФА
	               |ГДЕ
	               |	ДанныеНФА.МассаДМУчетВЕдИзмОтчета > 0";			
				   
	Если (МассивТиповОбъектовОС = Неопределено) И (НеВыбиратьМассивТиповОбъектовОС = Неопределено) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта",Истина);
	ИначеЕсли (НеВыбиратьМассивТиповОбъектовОС = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "ЕСТЬNULL(ДанныеНФАВсе.ТипОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) В (&МассивТиповОбъектовОС)");
		Запрос.УстановитьПараметр("МассивТиповОбъектовОС", МассивТиповОбъектовОС);
	ИначеЕсли (МассивТиповОбъектовОС = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "НЕ (ЕСТЬNULL(ДанныеНФАВсе.ТипОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) В (&НеВыбиратьМассивТиповОбъектовОС))");
		Запрос.УстановитьПараметр("НеВыбиратьМассивТиповОбъектовОС", НеВыбиратьМассивТиповОбъектовОС);
	Иначе
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта", Истина);
	КонецЕсли;	
	
	Если ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
		Запрос.УстановитьПараметр("УчитыватьДанныеКапвложений", Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УчитыватьДанныеКапвложений", 
		"НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.СписаниеОбъектовОС)
        |			И (ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.СписаниеОбъектовОС).ВидОперации= ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений)))
		|И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.СписаниеОбъектовОС)
		|			И ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.СписаниеОбъектовОС).ВключатьМЦВСоставКапвложений)
		|И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.СписаниеОбъектовИК)
        |			И (ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.СписаниеОбъектовИК).ВидОперации= ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.СписаниеКапвложенийВИК)))");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);			   
	Запрос.УстановитьПараметр("СписокРегистраторовСписания", СписокРегистраторовСписания);			   
	Запрос.УстановитьПараметр("МассивСчетовОС", МассивСчетовОС);			   
	Запрос.УстановитьПараметр("ДрагМатериалы", ДрагМатериалы);			   
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);			   
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);			   
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Штуки());
	Запрос.УстановитьПараметр("ОтчетДМ",	ВидОтчета);  
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;
КонецФункции

