Процедура ЗаполнитьОтчет4ДМФормаОтчета2012Кв1(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки) Экспорт

	ВидОтчета = "4-ДМ";
	
#Область НастройкиОтчета

	Организация		= ПараметрыОтчета.Организация;
	ПериодНачало	= ПараметрыОтчета.мДатаНачалаПериодаОтчета;
	ПериодКонец		= ПараметрыОтчета.мДатаКонцаПериодаОтчета;
	
	Золото = Справочники.ДрагМеталлы.Золото;
	Серебро = Справочники.ДрагМеталлы.Серебро;
	Платина = Справочники.ДрагМеталлы.Платина;
	
	МеталлыПлатиновойГруппы = Новый Массив;
	МеталлыПлатиновойГруппы.Добавить(Справочники.ДрагМеталлы.Палладий);
	МеталлыПлатиновойГруппы.Добавить(Справочники.ДрагМеталлы.Родий);
	МеталлыПлатиновойГруппы.Добавить(Справочники.ДрагМеталлы.Иридий);
	МеталлыПлатиновойГруппы.Добавить(Справочники.ДрагМеталлы.Рутений);
	МеталлыПлатиновойГруппы.Добавить(Справочники.ДрагМеталлы.Осмий);
	
	СчетаУчетаОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляОС(Истина);
	СчетаУчетаОС = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(Организация, СчетаУчетаОС, "Основные средства");
	СчетаУчетаМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ(Истина);
	СчетаУчетаМЗ = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(Организация, СчетаУчетаМЗ, "Номенклатура");
	
	ПериодНаНачало = ПериодНачало;
	ПериодНаКонец = Новый Граница(ПериодКонец, ВидГраницы.Включая);
	
	МассивТиповОбъектовБытоваяАппаратура = Новый Массив;
	МассивТиповОбъектовБытоваяАппаратура.Добавить(Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет4ДМ_БытоваяАппаратураОС);
	
	МассивТиповОбъектовОборудование = Новый Массив;
	МассивТиповОбъектовОборудование.Добавить(Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет4ДМ_Оборудование);
	
	МассивТиповОбъектовИсточникиПитания = Новый Массив;
	МассивТиповОбъектовИсточникиПитания.Добавить(Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет4ДМ_ИсточникиПитания);
	
	МассивТиповОбъектовНеВыбиратьОС = Новый Массив;
	МассивТиповОбъектовНеВыбиратьОС.Добавить(Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет4ДМ_Сырье);
	МассивТиповОбъектовНеВыбиратьОС.Добавить(Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет4ДМ_ТермопарыСопротивления);
	МассивТиповОбъектовНеВыбиратьОС.Добавить(Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет4ДМ_ТермометрыСопротивления);
	МассивТиповОбъектовНеВыбиратьОС.Добавить(Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет4ДМ_Тигли);
	МассивТиповОбъектовНеВыбиратьОС.Добавить(Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет4ДМ_ДругаяТехнологическаяОснастка);
	
	МассивТиповОбъектовНеВыбиратьМЗ = Новый Массив;
	МассивТиповОбъектовНеВыбиратьМЗ.Добавить(Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет4ДМ_Сырье);
	МассивТиповОбъектовНеВыбиратьМЗ.Добавить(Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет4ДМ_ТермопарыСопротивления);
	МассивТиповОбъектовНеВыбиратьМЗ.Добавить(Справочники.КлассификаторОбъектовУчетаДрагМатериалов.Отчет4ДМ_ТермометрыСопротивления);
