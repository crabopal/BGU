	               |	НаличиеДрагМатериаловВОбъектахНФАОбороты.ИнвНомер,
	               |	НаличиеДрагМатериаловВОбъектахНФАОбороты.ЕдИзм,
	               |	НаличиеДрагМатериаловВОбъектахНФАОбороты.ВидДрагМатериала,
	               |	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОбороты.МассаДМРасход,0) КАК МассаДМРасход,
	               |	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта
	               |ПОМЕСТИТЬ ДанныеНФАВсе
	               |ИЗ
	               |	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Обороты(
	               |			&НачалоПериода,
	               |			&КонецПериода,
	               |			Запись,
	               |			Организация = &Организация
	               |				И ОбъектНФА ССЫЛКА Справочник.ОсновныеСредства
	               |				И ВидДрагМатериала В (&ДрагМатериалы)) КАК НаличиеДрагМатериаловВОбъектахНФАОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
	               |				&КонецПериода,
	               |				Организация = &Организация
	               |					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
	               |		ПО НаличиеДрагМатериаловВОбъектахНФАОбороты.ОбъектНФА = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) В (&СписокРегистраторовСписания)
				   |	И &УчитыватьПередачуМЦКапвложений
				   |;
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеНФАВсе.ОбъектНФА,
	               |	ДанныеНФАВсе.ИнвНомер,
	               |	ДанныеНФАВсе.ТипОбъекта,
	               |	&ЕдиницаИзмерения,
	               |	0 КАК Количество,
	               |	ДанныеНФАВсе.ЕдИзм,
	               |	ДанныеНФАВсе.ВидДрагМатериала,
	               |	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент,
	               |	ВЫРАЗИТЬ((ДанныеНФАВсе.МассаДМРасход * ВЫБОР
	               |		КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент ЕСТЬ NULL 
	               |			ТОГДА 1
	               |		КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент
	               |	КОНЕЦ) КАК ЧИСЛО(17,8)) КАК МассаДМУчетВЕдИзмОтчета
	               |ПОМЕСТИТЬ ДанныеНФА
	               |ИЗ
	               |	ДанныеНФАВсе КАК ДанныеНФАВсе
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
	               |		ПО ДанныеНФАВсе.ЕдИзм = НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения
	               |ГДЕ
	               |	&НетОтбораПоТипуОбъекта
	               |;
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеНФА.ОбъектНФА,
	               |	ДанныеНФА.ИнвНомер КАК ИнвентарныйНомер,
	               |	&ЕдиницаИзмерения,
	               |	0 КАК Количество,
	               |	ДанныеНФА.ЕдИзм,
	               |	ДанныеНФА.ВидДрагМатериала,
	               |	ДанныеНФА.Коэффициент,
	               |	ДанныеНФА.МассаДМУчетВЕдИзмОтчета
	               |ИЗ
	               |	ДанныеНФА КАК ДанныеНФА
	               |ГДЕ
	               |	ДанныеНФА.МассаДМУчетВЕдИзмОтчета > 0";			
				   
	Если (МассивТиповОбъектовОС = Неопределено) И (НеВыбиратьМассивТиповОбъектовОС = Неопределено) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта",Истина);
	ИначеЕсли (НеВыбиратьМассивТиповОбъектовОС = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "ЕСТЬNULL(ДанныеНФАВсе.ТипОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) В (&МассивТиповОбъектовОС)");
		Запрос.УстановитьПараметр("МассивТиповОбъектовОС", МассивТиповОбъектовОС);
	ИначеЕсли (МассивТиповОбъектовОС = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "НЕ (ЕСТЬNULL(ДанныеНФАВсе.ТипОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) В (&НеВыбиратьМассивТиповОбъектовОС))");
		Запрос.УстановитьПараметр("НеВыбиратьМассивТиповОбъектовОС", НеВыбиратьМассивТиповОбъектовОС);
	Иначе
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта", Истина);
	КонецЕсли;	
	
	Если ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УчитыватьПередачуМЦКапвложений", 
			"НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.ПередачаОбъектовОС)
        	|		И ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.ПередачаОбъектовОС).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106))");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УчитыватьПередачуМЦКапвложений", 
			"НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.ПередачаОбъектовОС)
        	|		И ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.ПередачаОбъектовОС).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений))
			|И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.ПередачаОбъектовОС)
        	|		И ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.ПередачаОбъектовОС).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПередачиОС.ВозвратПоставщикуСоСчета106))
			|И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.ПередачаОбъектовИК)
        	|		И ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.ПередачаОбъектовИК).ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.ПередачаКапвложений))");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);			   
	Запрос.УстановитьПараметр("СписокРегистраторовСписания", СписокРегистраторовСписания);			   
	Запрос.УстановитьПараметр("МассивСчетовОС", МассивСчетовОС);			   
	Запрос.УстановитьПараметр("ДрагМатериалы", ДрагМатериалы);			   
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);			   
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);			   
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Штуки());
	Запрос.УстановитьПараметр("ОтчетДМ",	ВидОтчета);  
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;
КонецФункции


Функция ОстаткиНаПериодДляМЗ(ВидОтчета, Организация, МассивСчетовМЗ, МассивТиповОбъектовМЗ = Неопределено, НеВыбиратьМассивТиповОбъектовМЗ = Неопределено, ДрагМатериалы, ПериодСведений)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
			|	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
			|ПОМЕСТИТЬ МЗВсеПослеОтбора
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&МассивСчетовМЗ), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
			|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|	И &НетОтбораПоТипуОбъекта
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
			|	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)),
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЗ),
			|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность),
			|			Организация = &Организация
			|				И Субконто1 ССЫЛКА Справочник.Номенклатура) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
			|		ПО (ВЫБОР
			|				КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Номенклатура
			|					ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
			|				ИНАЧЕ ЛОЖЬ
			|			КОНЕЦ)
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|	И &НетОтбораПоТипуОбъекта
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ 
			|	МЗВсеПослеОтбора.ОбъектНФА КАК ОбъектНФА,
			|	МЗВсеПослеОтбора.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	СУММА(МЗВсеПослеОтбора.Количество) КАК Количество
			|ПОМЕСТИТЬ ДанныеОСВсе
			|ИЗ
			|	МЗВсеПослеОтбора КАК МЗВсеПослеОтбора
			|
			|СГРУППИРОВАТЬ ПО
			|	МЗВсеПослеОтбора.ОбъектНФА,
			|	МЗВсеПослеОтбора.ИнвентарныйНомер
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
			|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
			|	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
			|ПОМЕСТИТЬ ДанныеОтбора
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&МассивСчетовМЗ), &МассивСубконтоМЗ, Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
			|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|	И &НетОтбораПоТипуОбъекта" 
			
			+ ДополнитьТестЗапросаОстаткиНаПериодДляМЗ() + ОбщегоНазначения.РазделительПакетаЗапросов() +  
			
			"ВЫБРАТЬ
			|	ДанныеОтбора.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеОтбора.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ДанныеОтбора.ЦМО КАК ЦМО,
			|	СУММА(ДанныеОтбора.Количество) КАК Количество
			|ПОМЕСТИТЬ ДанныеОС
			|ИЗ
			|	ДанныеОтбора КАК ДанныеОтбора
			|
			|СГРУППИРОВАТЬ ПО
			|	ДанныеОтбора.ОбъектНФА,
			|	ДанныеОтбора.ИнвентарныйНомер,
			|	ДанныеОтбора.ЦМО
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДанныеОС.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ДанныеОС.ЦМО КАК ЦМО,
			|	ДанныеОС.Количество КАК Количество,
			|	ЕСТЬNULL(ДанныеОСВсе.Количество, 1) КАК КоличествоВсего
			|ПОМЕСТИТЬ ПолныеДанныеОС
			|ИЗ
			|	ДанныеОС КАК ДанныеОС
			|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеОСВсе КАК ДанныеОСВсе
			|		ПО (ДанныеОСВсе.ОбъектНФА = ДанныеОС.ОбъектНФА)
			|			И (ДанныеОСВсе.ИнвентарныйНомер = ДанныеОС.ИнвентарныйНомер)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеОС.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ДанныеОС.Количество КАК Количество,
			|	ДанныеОС.КоличествоВсего КАК КоличествоВсего,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
			|	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток * ДанныеОС.Количество / ДанныеОС.КоличествоВсего КАК ЧИСЛО(17, 8)) КАК МассаДМУчет,
			|	ВЫБОР
			|		КОГДА ДанныеОС.ОбъектНФА ССЫЛКА Справочник.Номенклатура
			|			ТОГДА ДанныеОС.ОбъектНФА.ЕдиницаИзмерения
			|		ИНАЧЕ &ЕдиницаИзмерения
			|	КОНЕЦ КАК ЕдиницаИзмерения,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм КАК ЕдиницаИзмеренияДрагМатериала
			|ПОМЕСТИТЬ ДанныеВУчетныхЕдиницах
			|ИЗ
			|	ПолныеДанныеОС КАК ДанныеОС
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&Период, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
			|		ПО ДанныеОС.ОбъектНФА = НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА
			|			И ДанныеОС.ИнвентарныйНомер = НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер
			|ГДЕ
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток > 0
			|	И НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала В(&ДрагМатериалы)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения КАК УчетнаяЕдиницаИзмерения,
			|	НастройкиЕдиницИзмеренияДрагМатериалов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент
			|ПОМЕСТИТЬ НастройкиЕдиницУчета
			|ИЗ
			|	РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
			|ГДЕ
			|	НастройкиЕдиницИзмеренияДрагМатериалов.Организация = &Организация
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДанныеВУчетныхЕдиницах.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеВУчетныхЕдиницах.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	ДанныеВУчетныхЕдиницах.Количество КАК Количество,
			|	ДанныеВУчетныхЕдиницах.КоличествоВсего КАК КоличествоВсего,
			|	ДанныеВУчетныхЕдиницах.ВидДрагМатериала КАК ВидДрагМатериала,
			|	ВЫРАЗИТЬ(ДанныеВУчетныхЕдиницах.МассаДМУчет * ВЫБОР
			|			КОГДА НастройкиЕдиницУчета.Коэффициент ЕСТЬ NULL
			|				ТОГДА 1
			|			КОГДА НастройкиЕдиницУчета.Коэффициент = 0
			|				ТОГДА 1
			|			ИНАЧЕ НастройкиЕдиницУчета.Коэффициент
			|		КОНЕЦ КАК ЧИСЛО(17, 8)) КАК МассаДМУчетВЕдИзмОтчета,
			|	ДанныеВУчетныхЕдиницах.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	ДанныеВУчетныхЕдиницах.ЕдиницаИзмеренияДрагМатериала КАК ЕдиницаИзмеренияДрагМатериала
			|ИЗ
			|	ДанныеВУчетныхЕдиницах КАК ДанныеВУчетныхЕдиницах
			|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиЕдиницУчета КАК НастройкиЕдиницУчета
			|		ПО ДанныеВУчетныхЕдиницах.ЕдиницаИзмеренияДрагМатериала = НастройкиЕдиницУчета.УчетнаяЕдиницаИзмерения
			|ГДЕ
			|	ДанныеВУчетныхЕдиницах.МассаДМУчет > 0";
			
	Если (МассивТиповОбъектовМЗ = Неопределено) И (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта",Истина);
	ИначеЕсли (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &НетОтбораПоТипуОбъекта", "И ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) В (&МассивТиповОбъектовМЗ)");
		Запрос.УстановитьПараметр("МассивТиповОбъектовМЗ", МассивТиповОбъектовМЗ);
	ИначеЕсли (МассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &НетОтбораПоТипуОбъекта", "И НЕ (ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) В (&НеВыбиратьМассивТиповОбъектовМЗ))");
		Запрос.УстановитьПараметр("НеВыбиратьМассивТиповОбъектовМЗ", НеВыбиратьМассивТиповОбъектовМЗ);
	КонецЕсли;	
			
	МассивСубконтоМЗ = Новый Массив;
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	МассивСубконтоМЦ = Новый Массив;
	МассивСубконтоМЦ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность);
	МассивСубконтоМЦ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	ЕдиницаИзмеренияДМ = ЕдиницаИзмеренияДрагМатериалов(ДрагМатериалы);
	
	Запрос.УстановитьПараметр("Период", 			ПериодСведений);
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Штуки());
	Запрос.УстановитьПараметр("МассивСчетовМЗ",		МассивСчетовМЗ);
	Запрос.УстановитьПараметр("МассивСубконтоМЗ",	МассивСубконтоМЗ);
	Запрос.УстановитьПараметр("МассивСубконтоМЦ",	МассивСубконтоМЦ);
	Запрос.УстановитьПараметр("ДрагМатериалы",		ДрагМатериалы);
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияДМ",	ЕдиницаИзмеренияДМ);  
	Запрос.УстановитьПараметр("ОтчетДМ",			ВидОтчета);  
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;
КонецФункции	

Функция ПоступилоВОтчетномПериодеМЗ(ВидОтчета, Организация, МассивСчетовМЗ, МассивТиповОбъектовМЗ = Неопределено, НеВыбиратьМассивТиповОбъектовМЗ = Неопределено, ДрагМатериалы, НачалоПериода, КонецПериода)
	          
	НеСписокРегистраторовПоступления = Новый Массив;
	НеСписокРегистраторовПоступления.Добавить(Тип("ДокументСсылка.ТребованиеНакладная0315006"));
	НеСписокРегистраторовПоступления.Добавить(Тип("ДокументСсылка.СписаниеОбъектовОС"));
	НеСписокРегистраторовПоступления.Добавить(Тип("ДокументСсылка.РазукомплектацияКапвложений"));
	НеСписокРегистраторовПоступления.Добавить(Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС"));
	НеСписокРегистраторовПоступления.Добавить(Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС"));
	НеСписокРегистраторовПоступления.Добавить(Тип("ДокументСсылка.НакладнаяНаВнутреннееПеремещениеОС2"));
	НеСписокРегистраторовПоступления.Добавить(Тип("ДокументСсылка.ВнутреннееПеремещениеИК"));
	
	НеСписокРегистраторовПоступленияДрагМатериаловВКапвложение = Новый Массив;
	Если НЕ ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
		НеСписокРегистраторовПоступленияДрагМатериаловВКапвложение.Добавить(Тип("ДокументСсылка.ПоступлениеОС"));
		НеСписокРегистраторовПоступленияДрагМатериаловВКапвложение.Добавить(Тип("ДокументСсылка.ПоступлениеОСИК"));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	НаличиеДрагМатериаловВОбъектахНФАОбороты.ОбъектНФА КАК ОбъектНФА,
		|	НаличиеДрагМатериаловВОбъектахНФАОбороты.ЕдИзм КАК ЕдИзм,
		|	НаличиеДрагМатериаловВОбъектахНФАОбороты.ВидДрагМатериала КАК ВидДрагМатериала,
		|	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент,
		|	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.МассаДМПриход * ВЫБОР
		|			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент ЕСТЬ NULL
		|				ТОГДА 1
		|			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент = 0
		|				ТОГДА 1
		|			ИНАЧЕ НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент
		|		КОНЕЦ КАК ЧИСЛО(17, 8)) КАК МассаДМУчетВЕдИзмОтчета,
		|	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта
		|ПОМЕСТИТЬ ДанныеНФА
		|ИЗ
		|	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Запись,
		|			Организация = &Организация
		|				И ОбъектНФА ССЫЛКА Справочник.Номенклатура
		|				И ВидДрагМатериала В (&ДрагМатериалы)) КАК НаличиеДрагМатериаловВОбъектахНФАОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
		|		ПО НаличиеДрагМатериаловВОбъектахНФАОбороты.ЕдИзм = НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
		|		ПО НаличиеДрагМатериаловВОбъектахНФАОбороты.ОбъектНФА = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
		|ГДЕ
		|	&НеУчитыватьДрагМатериалыВКапвложении
		|
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеНФА.ОбъектНФА КАК ОбъектНФА,
		|	ДанныеНФА.ЕдИзм КАК ЕдИзм,
		|	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
		|	ДанныеНФА.Коэффициент КАК Коэффициент,
		|	СУММА(ДанныеНФА.МассаДМУчетВЕдИзмОтчета) КАК МассаДМУчетВЕдИзмОтчета,
		|	ДанныеНФА.ТипОбъекта КАК ТипОбъекта
		|ПОМЕСТИТЬ ИтогиДМ
		|ИЗ
		|	ДанныеНФА КАК ДанныеНФА
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеНФА.ЕдИзм,
		|	ДанныеНФА.ВидДрагМатериала,
		|	ДанныеНФА.ОбъектНФА,
		|	ДанныеНФА.ТипОбъекта,
		|	ДанныеНФА.Коэффициент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК ОбъектНФА,
		|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто1 ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто1.ЕдиницаИзмерения
		|		ИНАЧЕ &ЕдиницаИзмерения
		|	КОНЕЦ КАК ЕдиницаИзмерения,
		|	0 КАК Количество,
		|	ДанныеНФА.ЕдИзм КАК ЕдИзм,
		|	ДанныеНФА.Коэффициент КАК Коэффициент,
		|	ДанныеНФА.ТипОбъекта КАК ТипОбъекта,
		|	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
		|	ДанныеНФА.МассаДМУчетВЕдИзмОтчета КАК МассаДМУчетВЕдИзмОтчета
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, Запись, Счет В (&МассивСчетовМЗ), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), Организация = &Организация, , ) КАК ЖурналПроводокЕПСБУОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИтогиДМ КАК ДанныеНФА
		|		ПО ЖурналПроводокЕПСБУОбороты.Субконто1 = ДанныеНФА.ОбъектНФА
		|ГДЕ
		|	&НетОтбораПоТипуОбъекта
		|	И ДанныеНФА.МассаДМУчетВЕдИзмОтчета > 0";
		
	Если ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
		
		Запрос.Текст = Запрос.Текст + 
		"
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК ОбъектНФА,
		|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто1 ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто1.ЕдиницаИзмерения
		|		ИНАЧЕ &ЕдиницаИзмерения
		|	КОНЕЦ КАК ЕдиницаИзмерения,
		|	0 КАК Количество,
		|	ДанныеНФА.ЕдИзм КАК ЕдИзм,
		|	ДанныеНФА.Коэффициент КАК Коэффициент,
		|	ДанныеНФА.ТипОбъекта КАК ТипОбъекта,
		|	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
		|	ДанныеНФА.МассаДМУчетВЕдИзмОтчета КАК МассаДМУчетВЕдИзмОтчета
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, Запись, Счет В (&МассивСчетовМЗ), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность), Организация = &Организация И Субконто1 ССЫЛКА Справочник.Номенклатура, , ) КАК ЖурналПроводокЕПСБУОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИтогиДМ КАК ДанныеНФА
		|		ПО ЖурналПроводокЕПСБУОбороты.Субконто1 = ДанныеНФА.ОбъектНФА
		|ГДЕ
		|	&НетОтбораПоТипуОбъекта
		|	И ДанныеНФА.МассаДМУчетВЕдИзмОтчета > 0  
		|	И НЕ ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОбороты.Регистратор) В (&НеСписокРегистраторовПоступления)";
		
	КонецЕсли;
				   
	Если (МассивТиповОбъектовМЗ = Неопределено) И (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта",Истина);
	ИначеЕсли (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "ДанныеНФА.ТипОбъекта В (&МассивТиповОбъектовМЗ)");
		Запрос.УстановитьПараметр("МассивТиповОбъектовМЗ", МассивТиповОбъектовМЗ);
	ИначеЕсли (МассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "НЕ (ДанныеНФА.ТипОбъекта В (&НеВыбиратьМассивТиповОбъектовМЗ))");
		Запрос.УстановитьПараметр("НеВыбиратьМассивТиповОбъектовМЗ", НеВыбиратьМассивТиповОбъектовМЗ);
	КонецЕсли;	
	
	Если ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() Тогда
        Запрос.УстановитьПараметр("НеУчитыватьДрагМатериалыВКапвложении",Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НеУчитыватьДрагМатериалыВКапвложении",
			" НЕ ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) В (&НЕСписокРегистраторовПоступленияДрагМатериаловВКапвложение)
			|И НЕ (ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор) = ТИП(Документ.ИзменениеНаличияДрагМатериалов)
			|			И ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОбороты.Регистратор КАК Документ.ИзменениеНаличияДрагМатериалов).ВидОперацийНаличияДрагМатериалов = 1)");
		Запрос.УстановитьПараметр("НеСписокРегистраторовПоступленияДрагМатериаловВКапвложение", НеСписокРегистраторовПоступленияДрагМатериаловВКапвложение);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);			   
	Запрос.УстановитьПараметр("МассивСчетовМЗ", МассивСчетовМЗ);			   
	Запрос.УстановитьПараметр("ДрагМатериалы", ДрагМатериалы);			   
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);			   
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);			   
	Запрос.УстановитьПараметр("ОтчетДМ",	ВидОтчета);  
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Штуки());
	Запрос.УстановитьПараметр("НеСписокРегистраторовПоступления", НеСписокРегистраторовПоступления);
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;
КонецФункции

Функция РезультатыДвиженийВОтчетномПериодеМЗПоАналитике(ВидОтчета, Организация, МассивСчетовМЗ, МассивТиповОбъектовМЗ = Неопределено, НеВыбиратьМассивТиповОбъектовМЗ = Неопределено, ДрагМатериалы, НачалоПериода, КонецПериода, ВидДвижения, АналитикаОборотовЗаПериод = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НаличиеДрагМатериаловВОбъектахНФА.ОбъектНФА КАК ОбъектНФА,
	               |	НаличиеДрагМатериаловВОбъектахНФА.ЕдИзм КАК ЕдИзм,
	               |	НаличиеДрагМатериаловВОбъектахНФА.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент КАК Коэффициент,
	               |	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФА.МассаДМ * ВЫБОР
	               |			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент ЕСТЬ NULL
	               |				ТОГДА 1
	               |			КОГДА НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент = 0
	               |				ТОГДА 1
	               |			ИНАЧЕ НастройкиЕдиницИзмеренияДрагМатериалов.Коэффициент
	               |		КОНЕЦ КАК ЧИСЛО(17, 8)) КАК МассаДМУчетВЕдИзмОтчета,
	               |	ЕСТЬNULL(НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта, ЗНАЧЕНИЕ(Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ПустаяСсылка)) КАК ТипОбъекта
	               |ПОМЕСТИТЬ ДанныеНФА
	               |ИЗ
	               |	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА КАК НаличиеДрагМатериаловВОбъектахНФА
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЕдиницИзмеренияДрагМатериалов КАК НастройкиЕдиницИзмеренияДрагМатериалов
	               |		ПО НаличиеДрагМатериаловВОбъектахНФА.ЕдИзм = НастройкиЕдиницИзмеренияДрагМатериалов.УчетнаяЕдиницаИзмерения
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
	               |				&КонецПериода,
	               |				Организация = &Организация
	               |					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
	               |		ПО НаличиеДрагМатериаловВОбъектахНФА.ОбъектНФА = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
	               |ГДЕ
	               |	НаличиеДрагМатериаловВОбъектахНФА.АналитикаОперации В(&АналитикаОперации)
	               |	И НаличиеДрагМатериаловВОбъектахНФА.Период МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И НаличиеДрагМатериаловВОбъектахНФА.Организация = &Организация
	               |	И НаличиеДрагМатериаловВОбъектахНФА.ОбъектНФА ССЫЛКА Справочник.Номенклатура
	               |	И НаличиеДрагМатериаловВОбъектахНФА.ВидДрагМатериала В(&ДрагМатериалы)
	               |	И НаличиеДрагМатериаловВОбъектахНФА.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеНФА.ОбъектНФА КАК ОбъектНФА,
	               |	ДанныеНФА.ЕдИзм КАК ЕдИзм,
	               |	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	ДанныеНФА.Коэффициент КАК Коэффициент,
	               |	СУММА(ДанныеНФА.МассаДМУчетВЕдИзмОтчета) КАК МассаДМУчетВЕдИзмОтчета,
	               |	ДанныеНФА.ТипОбъекта КАК ТипОбъекта
	               |ПОМЕСТИТЬ ИтогиДМ
	               |ИЗ
	               |	ДанныеНФА КАК ДанныеНФА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДанныеНФА.ВидДрагМатериала,
	               |	ДанныеНФА.ОбъектНФА,
	               |	ДанныеНФА.ЕдИзм,
	               |	ДанныеНФА.ТипОбъекта,
	               |	ДанныеНФА.Коэффициент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК ОбъектНФА,
	               |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	               |	ВЫБОР
	               |		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто1 ССЫЛКА Справочник.Номенклатура
	               |			ТОГДА ЖурналПроводокЕПСБУОбороты.Субконто1.ЕдиницаИзмерения
	               |		ИНАЧЕ &ЕдиницаИзмерения
	               |	КОНЕЦ КАК ЕдиницаИзмерения,
	               |	0 КАК Количество,
	               |	ДанныеНФА.ЕдИзм КАК ЕдИзм,
	               |	ДанныеНФА.Коэффициент КАК Коэффициент,
	               |	ДанныеНФА.ТипОбъекта КАК ТипОбъекта,
	               |	ДанныеНФА.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	ДанныеНФА.МассаДМУчетВЕдИзмОтчета КАК МассаДМУчетВЕдИзмОтчета
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, Запись, Счет В (&МассивСчетовМЗ), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), Организация = &Организация, , ) КАК ЖурналПроводокЕПСБУОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ИтогиДМ КАК ДанныеНФА
	               |		ПО ЖурналПроводокЕПСБУОбороты.Субконто1 = ДанныеНФА.ОбъектНФА
	               |ГДЕ
	               |	&НетОтбораПоТипуОбъекта
	               |	И ДанныеНФА.МассаДМУчетВЕдИзмОтчета > 0";			               
	
				   
	Если (МассивТиповОбъектовМЗ = Неопределено) И (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоТипуОбъекта",Истина);
	ИначеЕсли (НеВыбиратьМассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "ДанныеНФА.ТипОбъекта В (&МассивТиповОбъектовМЗ)");
		Запрос.УстановитьПараметр("МассивТиповОбъектовМЗ", МассивТиповОбъектовМЗ);
	ИначеЕсли (МассивТиповОбъектовМЗ = Неопределено) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоТипуОбъекта", "НЕ (ДанныеНФА.ТипОбъекта В (&НеВыбиратьМассивТиповОбъектовМЗ))");
		Запрос.УстановитьПараметр("НеВыбиратьМассивТиповОбъектовМЗ", НеВыбиратьМассивТиповОбъектовМЗ);
	КонецЕсли;
	
	Если ВидДвижения = "Расход" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)", "ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)");
	КонецЕсли;	
				   
	Запрос.УстановитьПараметр("Организация", Организация);			   
	Запрос.УстановитьПараметр("МассивСчетовМЗ", МассивСчетовМЗ);			   
	Запрос.УстановитьПараметр("ДрагМатериалы", ДрагМатериалы);			   
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);			   
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода.Значение);			   
	Запрос.УстановитьПараметр("ОтчетДМ",	ВидОтчета);  
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",	Штуки());
	Запрос.УстановитьПараметр("ВидДвижения",	ВидДвижения);  
	Запрос.УстановитьПараметр("АналитикаОперации",	АналитикаОборотовЗаПериод);  
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеДМ = РезультатЗапроса.Выгрузить();
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ДанныеДМ);
	МассивДанных.Добавить(ДанныеДМ.Итог("МассаДМУчетВЕдИзмОтчета"));
	
	Возврат МассивДанных;
КонецФункции

