#Область ПрограммныйИнтерфейс

Функция ЗаполнитьДМДляСписанияОС(Организация, ТаблицаОбъектовНФА, ПериодОстатков, ИмуществоКазны = Ложь) Экспорт

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаОбъектовНФА.ОбъектНФА,
			|	ТаблицаОбъектовНФА.ИнвНомер,
			|	ТаблицаОбъектовНФА.Количество КАК Количество
			|ПОМЕСТИТЬ СписокНФАСписания
			|ИЗ
			|	&ТаблицаОбъектовНФА КАК ТаблицаОбъектовНФА
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
			|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество
			|ПОМЕСТИТЬ ОстаткиРН
			|ИЗ
			|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И ОсновноеСредство В (&ТаблицаОбъектовНФА)) КАК СтоимостьОбъектовОСОстатки
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство,
			|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер,
			|	СтоимостьОбъектовОСПоКонтрагентамОстатки.КоличествоОстаток
			|ИЗ
			|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И ОсновноеСредство В (&ТаблицаОбъектовНФА)
			|				И НЕ &ИмуществоКазны
			|				И (ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПолученоВПользование)
			|					ИЛИ ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении))) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки
			|
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет.Код = ""МЦК"",
			|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность),
			|			Организация = &Организация
			|				И Субконто1 В (&ТаблицаОбъектовНФА)) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|	И ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ОсновныеСредства
			|
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ОстаткиРН.ОсновноеСредство КАК ОсновноеСредство,
			|	ОстаткиРН.ИнвентарныйНомер КАК ИнвНомер,
			|	СУММА(ОстаткиРН.Количество) КАК Количество
			|ПОМЕСТИТЬ ВсеОстаткиРН
			|ИЗ
			|	ОстаткиРН КАК ОстаткиРН
			|
			|СГРУППИРОВАТЬ ПО
			|	ОстаткиРН.ОсновноеСредство,
			|	ОстаткиРН.ИнвентарныйНомер
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
			|	МестонахождениеОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
			|	ЕСТЬNULL(МестонахождениеОССрезПоследних.Количество, ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК Количество
			|ПОМЕСТИТЬ ДанныеОС
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовОС),
			|			&МассивСубконтоОС,
			|			Организация = &Организация
			|				И Субконто1 В (&ТаблицаОбъектовНФА)) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВсеОстаткиРН КАК МестонахождениеОССрезПоследних
			|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = МестонахождениеОССрезПоследних.ОсновноеСредство
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СписокНФАСписания.ОбъектНФА,
			|	СписокНФАСписания.ИнвНомер,
			|	СписокНФАСписания.Количество,
			|	ДанныеОС.Количество КАК КоличествоВсего
			|ПОМЕСТИТЬ ОстаткиОбъектовНФА
			|ИЗ
			|	СписокНФАСписания КАК СписокНФАСписания
			|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеОС КАК ДанныеОС
			|		ПО СписокНФАСписания.ОбъектНФА = ДанныеОС.ОбъектНФА
			|			И СписокНФАСписания.ИнвНомер = ДанныеОС.ИнвентарныйНомер
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиОбъектовНФА.ОбъектНФА КАК ОбъектНФА,
			|	ОстаткиОбъектовНФА.ИнвНомер КАК ИнвНомер,
			|	ОстаткиОбъектовНФА.Количество,
			|	ОстаткиОбъектовНФА.КоличествоВсего,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала.ТипДрагМатериала КАК ТипДрагМатериала,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.Количество
			|			ТОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ((НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток * ОстаткиОбъектовНФА.Количество / ОстаткиОбъектовНФА.КоличествоВсего) КАК ЧИСЛО(17,8))
			|	КОНЕЦ КАК МассаДМ,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм КАК ЕдИзм,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.Количество
			|			ТОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ((НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток * ОстаткиОбъектовНФА.Количество / ОстаткиОбъектовНФА.КоличествоВсего) КАК ЧИСЛО(17,8))
			|	КОНЕЦ КАК КоличествоДМ
			|ИЗ
			|	ОстаткиОбъектовНФА КАК ОстаткиОбъектовНФА
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&Период, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
			|		ПО ОстаткиОбъектовНФА.ОбъектНФА = НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА
			|			И ОстаткиОбъектовНФА.ИнвНомер = НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер
			|ГДЕ
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток > 0
			|
			|УПОРЯДОЧИТЬ ПО
			|	ОбъектНФА,
			|	ИнвНомер,
			|	ТипДрагМатериала";			
			
			
	Если ИмуществоКазны Тогда
		МассивСчетовОС = ПолучитьМассивСчетовДМДляИК();
	Иначе	
		МассивСчетовОС = ПолучитьМассивСчетовДМДляОС();
		МассивСчетовОС = ДополнитьМассивСчетовДМДляМЦ(Организация, МассивСчетовОС, "Основные средства");
	КонецЕсли;	
		
	МассивСубконтоОС = Новый Массив;
	МассивСубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	
	Запрос.УстановитьПараметр("Период", 			ПериодОстатков);
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ТаблицаОбъектовНФА", ТаблицаОбъектовНФА);			   
	Запрос.УстановитьПараметр("МассивСчетовОС",		МассивСчетовОС);
	Запрос.УстановитьПараметр("МассивСубконтоОС",	МассивСубконтоОС);
	Запрос.УстановитьПараметр("ИмуществоКазны",		ИмуществоКазны);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Функция ЗаполнитьДМДляСписанияМЗ(Организация, ТаблицаОбъектовНФА, ПериодОстатков, ИмуществоКазны = Ложь) Экспорт

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаОбъектовНФА.ОбъектНФА КАК ОбъектНФА,
			|	ТаблицаОбъектовНФА.ИнвНомер КАК ИнвНомер,
			|	ТаблицаОбъектовНФА.Количество КАК Количество
			|ПОМЕСТИТЬ СписокНФАСписания
			|ИЗ
			|	&ТаблицаОбъектовНФА КАК ТаблицаОбъектовНФА
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
			|ПОМЕСТИТЬ ДанныеОбъектовОстаток
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЗ),
			|			&МассивСубконтоМЗ,
			|			Организация = &Организация
			|				И Субконто1 В (&ТаблицаОбъектовНФА)) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ 
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка),
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет.Код = ""МЦК"",
			|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность),
			|			Организация = &Организация
			|				И Субконто1 В (&ТаблицаОбъектовНФА)) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|	И ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Номенклатура
			|;
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДанныеОбъектовОстаток.ОбъектНФА КАК ОбъектНФА,
			|	ДанныеОбъектовОстаток.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	СУММА(ДанныеОбъектовОстаток.Количество) КАК Количество
			|ПОМЕСТИТЬ ДанныеОбъектов
			|ИЗ
			|	ДанныеОбъектовОстаток КАК ДанныеОбъектовОстаток
			|
			|СГРУППИРОВАТЬ ПО
			|	ДанныеОбъектовОстаток.ОбъектНФА,
			|	ДанныеОбъектовОстаток.ИнвентарныйНомер
			|;
           	|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СписокНФАСписания.ОбъектНФА КАК ОбъектНФА,
			|	СписокНФАСписания.ИнвНомер КАК ИнвНомер,
			|	СписокНФАСписания.Количество КАК Количество,
			|	ДанныеОбъектов.Количество КАК КоличествоВсего
			|ПОМЕСТИТЬ ОстаткиОбъектовНФА
			|ИЗ
			|	СписокНФАСписания КАК СписокНФАСписания
			|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеОбъектов КАК ДанныеОбъектов
			|		ПО СписокНФАСписания.ОбъектНФА = ДанныеОбъектов.ОбъектНФА
			|			И СписокНФАСписания.ИнвНомер = ДанныеОбъектов.ИнвентарныйНомер
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиОбъектовНФА.ОбъектНФА КАК ОбъектНФА,
			|	ОстаткиОбъектовНФА.ИнвНомер КАК ИнвНомер,
			|	ОстаткиОбъектовНФА.Количество КАК Количество,
			|	ОстаткиОбъектовНФА.КоличествоВсего КАК КоличествоВсего,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ВидДрагМатериала.ТипДрагМатериала КАК ТипДрагМатериала,
			|	0 КАК МассаДМ,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.Количество
			|			ТОГДА НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток * ОстаткиОбъектовНФА.Количество / ОстаткиОбъектовНФА.КоличествоВсего КАК ЧИСЛО(17, 8))
			|	КОНЕЦ КАК ЧистаяМасса,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.Количество
			|			ТОГДА НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЛигатурнаяМассаОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЛигатурнаяМассаОстаток * ОстаткиОбъектовНФА.Количество / ОстаткиОбъектовНФА.КоличествоВсего КАК ЧИСЛО(17, 8))
			|	КОНЕЦ КАК ЛигатурнаяМасса,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ВидОбъекта КАК ВидОбъектаДМ,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЕдИзм КАК ЕдИзм,
			|	0 КАК КоличествоДМ,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ИсточникОбразования КАК ИсточникОбразования
			|ИЗ
			|	ОстаткиОбъектовНФА КАК ОстаткиОбъектовНФА
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВЛомеИОтходах.Остатки(&Период, Организация = &Организация) КАК НаличиеДрагМатериаловВЛомеИОтходахОстатки
			|		ПО ОстаткиОбъектовНФА.ОбъектНФА = НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА
			|ГДЕ
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток + НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЛигатурнаяМассаОстаток > 0
			|	И ОстаткиОбъектовНФА.КоличествоВсего > 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ОстаткиОбъектовНФА.ОбъектНФА,
			|	ОстаткиОбъектовНФА.ИнвНомер,
			|	ОстаткиОбъектовНФА.Количество,
			|	ОстаткиОбъектовНФА.КоличествоВсего,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала.ТипДрагМатериала,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.Количество
			|			ТОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток * ОстаткиОбъектовНФА.Количество / ОстаткиОбъектовНФА.КоличествоВсего КАК ЧИСЛО(17, 8))
			|	КОНЕЦ,
			|	0,
			|	0,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ПустаяСсылка),
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.Количество
			|			ТОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток * ОстаткиОбъектовНФА.Количество / ОстаткиОбъектовНФА.КоличествоВсего КАК ЧИСЛО(17, 8))
			|	КОНЕЦ,
			|	ЗНАЧЕНИЕ(Перечисление.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.ПустаяСсылка)
			|ИЗ
			|	ОстаткиОбъектовНФА КАК ОстаткиОбъектовНФА
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&Период, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
			|		ПО ОстаткиОбъектовНФА.ОбъектНФА = НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА
			|			И ОстаткиОбъектовНФА.ИнвНомер = НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер
			|ГДЕ
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток > 0
			|	И ОстаткиОбъектовНФА.КоличествоВсего > 0
			|
			|УПОРЯДОЧИТЬ ПО
			|	ОбъектНФА,
			|	ИнвНомер,
			|	ТипДрагМатериала";			
			
	МассивСчетовМЗ = ПолучитьМассивСчетовДМДляМЗ(Истина);
	МассивСчетовМЗ = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(Организация, МассивСчетовМЗ, "Номенклатура");
	
	МассивСубконтоМЗ = Новый Массив;
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	
	Запрос.УстановитьПараметр("Период", 			ПериодОстатков);
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ТаблицаОбъектовНФА", ТаблицаОбъектовНФА);			   
	Запрос.УстановитьПараметр("МассивСчетовМЗ",		МассивСчетовМЗ);
	Запрос.УстановитьПараметр("МассивСубконтоМЗ",	МассивСубконтоМЗ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Функция ЗаполнитьДМДляСписанияКапвложений(Организация, ТаблицаОбъектовВложений, ПериодОстатков) Экспорт

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаОбъектовВложений.ОбъектНФА КАК Капвложение,
			|	ВЫБОР
			|		КОГДА ТаблицаОбъектовВложений.Количество = 0
			|			ТОГДА 1
			|		ИНАЧЕ ТаблицаОбъектовВложений.Количество
			|	КОНЕЦ КАК Количество
			|ПОМЕСТИТЬ СписокВложений
			|ИЗ
			|	&ТаблицаОбъектовВложений КАК ТаблицаОбъектовВложений
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СписокВложений.Капвложение КАК Капвложение,
			|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ОбъектМЦ,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоМЦ,
			|	СписокВложений.Количество КАК Количество
			|ПОМЕСТИТЬ СписокМЦСписания
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЦ),
			|			,
			|			Организация = &Организация
			|				И Субконто1 В (&ТаблицаОбъектовВложений)) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ СписокВложений КАК СписокВложений
			|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = СписокВложений.Капвложение
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ОбъектМЦ,
			|	СписокМЦСписания.Капвложение КАК Капвложение,
			|	СписокМЦСписания.Количество КАК Количество,
			|	СписокМЦСписания.КоличествоМЦ КАК КоличествоМЦ,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоВсего
			|ПОМЕСТИТЬ ДанныеОСОстаток
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЦ),
			|			,
			|			Организация = &Организация 
			|				И Субконто1 <> Субконто2
			|				И Субконто2 В
			|					(ВЫБРАТЬ
			|						СписокМЦСписания.ОбъектМЦ
			|					ИЗ
			|						СписокМЦСписания КАК СписокМЦСписания)) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ СписокМЦСписания КАК СписокМЦСписания
			|		ПО ЖурналПроводокЕПСБУОстатки.Субконто2 = СписокМЦСписания.ОбъектМЦ
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	СписокМЦСписания.Капвложение,
			|	СписокМЦСписания.Количество,
			|	СписокМЦСписания.КоличествоМЦ,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЦ),
			|			,
			|			Организация = &Организация
			|				И Субконто1 <> Субконто2
			|				И Субконто1 В
			|					(ВЫБРАТЬ
			|						СписокМЦСписания.ОбъектМЦ
			|					ИЗ
			|						СписокМЦСписания КАК СписокМЦСписания)) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ СписокМЦСписания КАК СписокМЦСписания
			|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = СписокМЦСписания.ОбъектМЦ
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ДанныеОСОстаток.ОбъектМЦ КАК ОбъектМЦ,
			|	ДанныеОСОстаток.Капвложение КАК Капвложение,
			|	ДанныеОСОстаток.Количество КАК Количество,
			|	ДанныеОСОстаток.КоличествоМЦ КАК КоличествоМЦ,
			|	СУММА(ДанныеОСОстаток.КоличествоВсего) КАК КоличествоВсего
			|ПОМЕСТИТЬ ДанныеОС
			|ИЗ
			|	ДанныеОСОстаток КАК ДанныеОСОстаток
			|
			|СГРУППИРОВАТЬ ПО
			|	ДанныеОСОстаток.ОбъектМЦ,
			|	ДанныеОСОстаток.Капвложение,
			|	ДанныеОСОстаток.Количество,
			|	ДанныеОСОстаток.КоличествоМЦ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СписокМЦСписания.ОбъектМЦ КАК ОбъектМЦ,
			|	СписокМЦСписания.Капвложение КАК Капвложение,
			|	СписокМЦСписания.Количество КАК Количество,
			|	СписокМЦСписания.КоличествоМЦ КАК КоличествоМЦ,
			|	ДанныеОС.КоличествоВсего КАК КоличествоВсего
			|ПОМЕСТИТЬ ОстаткиОбъектовНФА
			|ИЗ
			|	СписокМЦСписания КАК СписокМЦСписания
			|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеОС КАК ДанныеОС
			|		ПО СписокМЦСписания.ОбъектМЦ = ДанныеОС.ОбъектМЦ
			|			И СписокМЦСписания.Капвложение = ДанныеОС.Капвложение
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиОбъектовНФА.Капвложение КАК ОбъектНФА, 
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
			|	ОстаткиОбъектовНФА.ОбъектМЦ КАК ОбъектМЦ,
			|	ОстаткиОбъектовНФА.Количество КАК Количество,
			|	ОстаткиОбъектовНФА.КоличествоМЦ КАК КоличествоМЦ,
			|	ОстаткиОбъектовНФА.КоличествоВсего КАК КоличествоВсего,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала.ТипДрагМатериала КАК ТипДрагМатериала,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.КоличествоМЦ
			|			ТОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток * ОстаткиОбъектовНФА.КоличествоМЦ / ОстаткиОбъектовНФА.КоличествоВсего КАК ЧИСЛО(17, 8))
			|	КОНЕЦ КАК МассаДМ,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм КАК ЕдИзм,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.КоличествоМЦ
			|			ТОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток * ОстаткиОбъектовНФА.КоличествоМЦ / ОстаткиОбъектовНФА.КоличествоВсего КАК ЧИСЛО(17, 8))
			|	КОНЕЦ КАК КоличествоДМ
			|ИЗ
			|	ОстаткиОбъектовНФА КАК ОстаткиОбъектовНФА
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&Период, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
			|		ПО ОстаткиОбъектовНФА.ОбъектМЦ = НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА
			|ГДЕ
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток > 0
			|
			|УПОРЯДОЧИТЬ ПО
			|	ОстаткиОбъектовНФА.Капвложение,
			|	ОстаткиОбъектовНФА.ОбъектМЦ,
			|	ТипДрагМатериала";				
			
				     
	МассивСчетовМЦ = ПолучитьМассивСчетовДМДляКапвложенийСМЦ();
	МассивСчетовМЦ = ДополнитьМассивСчетовДМДляМЦ(Организация, МассивСчетовМЦ, "Основные средства");
	МассивСчетовМЦ = ДополнитьМассивСчетовДМДляМЦ(Организация, МассивСчетовМЦ, "Номенклатура");
	
	Запрос.УстановитьПараметр("Период", 				ПериодОстатков);
	Запрос.УстановитьПараметр("Организация",			Организация);
	Запрос.УстановитьПараметр("ТаблицаОбъектовВложений",ТаблицаОбъектовВложений);			   
	Запрос.УстановитьПараметр("МассивСчетовМЦ",			МассивСчетовМЦ);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции


Функция ЗаполнитьДМДляСписанияМатериальныхЦенностей(Организация, Капвложение, ТаблицаОбъектовМЦ, ПериодОстатков) Экспорт

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаОбъектовМЦ.ОбъектНФА КАК ОбъектМЦ,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
			|	ТаблицаОбъектовМЦ.Количество КАК КоличествоМЦ
			|ПОМЕСТИТЬ ТаблицаОбъектовМЦ
			|ИЗ
			|	&ТаблицаОбъектовМЦ КАК ТаблицаОбъектовМЦ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ОбъектМЦ,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстатокДт
			|ПОМЕСТИТЬ ОстаткиМЦКапвложения
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет.Код = ""МЦК"",
			|			,
			|			Организация = &Организация
			|				И Субконто1 = &Капвложение) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТаблицаОбъектовМЦ.ОбъектМЦ КАК ОбъектМЦ,
			|	ТаблицаОбъектовМЦ.ИнвНомер КАК ИнвНомер,
			|	ВЫБОР
			|		КОГДА ТаблицаОбъектовМЦ.КоличествоМЦ > ОстаткиМЦКапвложения.КоличествоОстатокДт
			|			ТОГДА ОстаткиМЦКапвложения.КоличествоОстатокДт
			|		ИНАЧЕ ТаблицаОбъектовМЦ.КоличествоМЦ
			|	КОНЕЦ КАК КоличествоМЦ
			|ПОМЕСТИТЬ СписокМЦ
			|ИЗ
			|	ОстаткиМЦКапвложения КАК ОстаткиМЦКапвложения
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаОбъектовМЦ КАК ТаблицаОбъектовМЦ
			|		ПО ОстаткиМЦКапвложения.ОбъектМЦ = ТаблицаОбъектовМЦ.ОбъектМЦ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СтоимостьОбъектовОСОстатки.Организация КАК Организация,
			|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
			|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвНомер,
			|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО
			|ПОМЕСТИТЬ МестонахождениеОС
			|ИЗ
			|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&Период, Организация = &Организация) КАК СтоимостьОбъектовОСОстатки
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	СтоимостьОбъектовОСПоКонтрагентамОстатки.Организация,
			|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство,
			|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер,
			|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ЦМО
			|ИЗ
			|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И (ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПолученоВПользование)
			|					ИЛИ ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении))) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектМЦ,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоВсего
			|ПОМЕСТИТЬ СписокМЦСписания
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЦ),
			|			&МассивСубконтоМЦ,
			|			Организация = &Организация
			|				И Субконто1 В (&ТаблицаОбъектовМЦ)) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЦ),
			|			&МассивСубконтоМЗ,
			|			Организация = &Организация
			|				И Субконто1 В (&ТаблицаОбъектовМЦ)) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовОС)
			|				И Счет.Код <> ""МЦК"",
			|			&МассивСубконтоОС,
			|			Организация = &Организация
			|				И Субконто1 В (&ТаблицаОбъектовМЦ)) КАК ЖурналПроводокЕПСБУОстатки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МестонахождениеОС КАК МестонахождениеОС
			|		ПО (МестонахождениеОС.ОсновноеСредство = ЖурналПроводокЕПСБУОстатки.Субконто1)
			|			И (МестонахождениеОС.ИнвНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СписокМЦСписания.ОбъектМЦ КАК ОбъектМЦ,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
			|	СУММА(СписокМЦСписания.КоличествоВсего) КАК КоличествоВсего
			|ПОМЕСТИТЬ ДанныеМЦ
			|ИЗ
			|	СписокМЦСписания КАК СписокМЦСписания
			|
			|СГРУППИРОВАТЬ ПО
			|	СписокМЦСписания.ОбъектМЦ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СписокМЦ.ОбъектМЦ КАК ОбъектМЦ,
			|	СписокМЦ.ИнвНомер КАК ИнвНомер,
			|	ДанныеМЦ.ИнвНомер КАК ИнвНомерПоискаМЦ,
			|	СписокМЦ.КоличествоМЦ КАК КоличествоМЦ,
			|	ДанныеМЦ.КоличествоВсего КАК КоличествоВсего
			|ПОМЕСТИТЬ ОстаткиОбъектовНФА
			|ИЗ
			|	СписокМЦ КАК СписокМЦ
			|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеМЦ КАК ДанныеМЦ
			|		ПО СписокМЦ.ОбъектМЦ = ДанныеМЦ.ОбъектМЦ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиОбъектовНФА.ОбъектМЦ КАК ОбъектНФА,
			|	ОстаткиОбъектовНФА.ИнвНомер КАК ИнвНомер,
			|	ОстаткиОбъектовНФА.КоличествоМЦ КАК Количество,
			|	ОстаткиОбъектовНФА.КоличествоВсего КАК КоличествоВсего,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала.ТипДрагМатериала КАК ТипДрагМатериала,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.КоличествоМЦ
			|			ТОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток * ОстаткиОбъектовНФА.КоличествоМЦ / ОстаткиОбъектовНФА.КоличествоВсего КАК ЧИСЛО(17, 8))
			|	КОНЕЦ КАК МассаДМ,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм КАК ЕдИзм,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.КоличествоМЦ
			|			ТОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток * ОстаткиОбъектовНФА.КоличествоМЦ / ОстаткиОбъектовНФА.КоличествоВсего КАК ЧИСЛО(17, 8))
			|	КОНЕЦ КАК КоличествоДМ
			|ПОМЕСТИТЬ ИтогиДрагМатериаловВМЦ
			|ИЗ
			|	ОстаткиОбъектовНФА КАК ОстаткиОбъектовНФА
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&Период, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
			|		ПО ОстаткиОбъектовНФА.ОбъектМЦ = НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА
			|			И (НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер = ОстаткиОбъектовНФА.ИнвНомерПоискаМЦ)
			|ГДЕ
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СУММА(ИтогиДрагМатериаловВМЦ.МассаДМ) КАК МассаДМ,
			|	ИтогиДрагМатериаловВМЦ.ВидДрагМатериала КАК ВидДрагМатериала,
			|	ИтогиДрагМатериаловВМЦ.ТипДрагМатериала КАК ТипДрагМатериала,
			|	ИтогиДрагМатериаловВМЦ.ЕдИзм КАК ЕдИзм,
			|	СУММА(ИтогиДрагМатериаловВМЦ.КоличествоДМ) КАК КоличествоДМ
			|ИЗ
			|	ИтогиДрагМатериаловВМЦ КАК ИтогиДрагМатериаловВМЦ
			|
			|СГРУППИРОВАТЬ ПО
			|	ИтогиДрагМатериаловВМЦ.ВидДрагМатериала,
			|	ИтогиДрагМатериаловВМЦ.ТипДрагМатериала,
			|	ИтогиДрагМатериаловВМЦ.ЕдИзм
			|
			|УПОРЯДОЧИТЬ ПО
			|	ТипДрагМатериала";				
			
				
	МассивСчетовМЦ = ПолучитьМассивСчетовДМДляКапвложенийСМЦ();
	МассивСчетовМЦ = ДополнитьМассивСчетовДМДляМЦ(Организация, МассивСчетовМЦ, "Основные средства");
	МассивСчетовМЦ = ДополнитьМассивСчетовДМДляМЦ(Организация, МассивСчетовМЦ, "Номенклатура");
	
	МассивСчетовОС = ПолучитьМассивСчетовДМДляОС();
	МассивСчетовОС = ДополнитьМассивСчетовДМДляМЦ(Организация, МассивСчетовОС, "Основные средства");
	
	МассивСубконтоМЦ = Новый Массив;
	МассивСубконтоМЦ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность);
	
	МассивСубконтоОС = Новый Массив;
	МассивСубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	
	МассивСубконтоМЗ = Новый Массив;
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	
	Запрос.УстановитьПараметр("Период", 				ПериодОстатков);
	Запрос.УстановитьПараметр("Организация",			Организация);
	Запрос.УстановитьПараметр("ТаблицаОбъектовМЦ",		ТаблицаОбъектовМЦ);			   
	Запрос.УстановитьПараметр("МассивСчетовМЦ",			МассивСчетовМЦ);
	Запрос.УстановитьПараметр("МассивСчетовОС",			МассивСчетовОС);
	Запрос.УстановитьПараметр("МассивСубконтоМЦ",		МассивСубконтоМЦ);
	Запрос.УстановитьПараметр("МассивСубконтоМЗ",		МассивСубконтоМЗ);
	Запрос.УстановитьПараметр("МассивСубконтоОС",		МассивСубконтоОС);
	Запрос.УстановитьПараметр("Капвложение",			Капвложение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Функция ЗаполнитьДМДляСписания(Организация, ТаблицаОбъектовНФА, ПериодОстатков, ИмуществоКазны = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаОбъектовНФА.ОбъектНФА КАК ОбъектНФА,
			|	ТаблицаОбъектовНФА.ИнвНомер КАК ИнвНомер,
			|	ТаблицаОбъектовНФА.Количество КАК Количество
			|ПОМЕСТИТЬ СписокНФАСписания
			|ИЗ
			|	&ТаблицаОбъектовНФА КАК ТаблицаОбъектовНФА
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
			|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество
			|ПОМЕСТИТЬ ОстаткиРН
			|ИЗ
			|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И ОсновноеСредство В (&ТаблицаОбъектовНФА)) КАК СтоимостьОбъектовОСОстатки
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство,
			|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер,
			|	СтоимостьОбъектовОСПоКонтрагентамОстатки.КоличествоОстаток
			|ИЗ
			|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И ОсновноеСредство В (&ТаблицаОбъектовНФА)
			|				И (ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПолученоВПользование)
			|					ИЛИ ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении))) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ОстаткиРН.ОсновноеСредство КАК ОсновноеСредство,
			|	ОстаткиРН.ИнвентарныйНомер КАК ИнвНомер,
			|	СУММА(ОстаткиРН.Количество) КАК Количество
			|ПОМЕСТИТЬ ВсеОстаткиРН
			|ИЗ
			|	ОстаткиРН КАК ОстаткиРН
			|
			|СГРУППИРОВАТЬ ПО
			|	ОстаткиРН.ОсновноеСредство,
			|	ОстаткиРН.ИнвентарныйНомер
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектНФА,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоВсего
			|ПОМЕСТИТЬ ДанныеОбъектов
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовМЗ),
			|			&МассивСубконтоМЗ,
			|			Организация = &Организация
			|				И Субконто1 В (&ТаблицаОбъектовНФА)) КАК ЖурналПроводокЕПСБУОстатки
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОстатки.Субконто1,
			|	МестонахождениеОССрезПоследних.ИнвНомер,
			|	ЕСТЬNULL(МестонахождениеОССрезПоследних.Количество, ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт)
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&Период,
			|			Счет В (&МассивСчетовОС),
			|			&МассивСубконтоОС,
			|			Организация = &Организация
			|				И Субконто1 В (&ТаблицаОбъектовНФА)) КАК ЖурналПроводокЕПСБУОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВсеОстаткиРН КАК МестонахождениеОССрезПоследних
			|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = МестонахождениеОССрезПоследних.ОсновноеСредство
			|ГДЕ
			|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СписокНФАСписания.ОбъектНФА КАК ОбъектНФА,
			|	СписокНФАСписания.ИнвНомер КАК ИнвНомер,
			|	СписокНФАСписания.Количество КАК Количество,
			|	ДанныеОбъектов.КоличествоВсего КАК КоличествоВсего
			|ПОМЕСТИТЬ ОстаткиОбъектовНФА
			|ИЗ
			|	СписокНФАСписания КАК СписокНФАСписания
			|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеОбъектов КАК ДанныеОбъектов
			|		ПО СписокНФАСписания.ОбъектНФА = ДанныеОбъектов.ОбъектНФА
			|			И СписокНФАСписания.ИнвНомер = ДанныеОбъектов.ИнвентарныйНомер
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиОбъектовНФА.ОбъектНФА КАК ОбъектНФА,
			|	ОстаткиОбъектовНФА.ИнвНомер КАК ИнвНомер,
			|	ОстаткиОбъектовНФА.Количество КАК Количество,
			|	ОстаткиОбъектовНФА.КоличествоВсего КАК КоличествоВсего,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ВидДрагМатериала КАК ВидДрагМатериала,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ВидДрагМатериала.ТипДрагМатериала КАК ТипДрагМатериала,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДрагМатериалов.Списание) КАК ВидДвиженияДМ,
			|	0 КАК МассаДМ,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.Количество
			|			ТОГДА НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток * ОстаткиОбъектовНФА.Количество / ОстаткиОбъектовНФА.КоличествоВсего КАК ЧИСЛО(17, 8))
			|	КОНЕЦ КАК ЧистаяМасса,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.Количество
			|			ТОГДА НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЛигатурнаяМассаОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЛигатурнаяМассаОстаток * ОстаткиОбъектовНФА.Количество / ОстаткиОбъектовНФА.КоличествоВсего КАК ЧИСЛО(17, 8))
			|	КОНЕЦ КАК ЛигатурнаяМасса,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ВидОбъекта КАК ВидОбъектаДМ,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЕдИзм КАК ЕдИзм,
			|	0 КАК КоличествоДМ,
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ИсточникОбразования КАК ИсточникОбразования
			|ИЗ
			|	ОстаткиОбъектовНФА КАК ОстаткиОбъектовНФА
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВЛомеИОтходах.Остатки(&Период, Организация = &Организация) КАК НаличиеДрагМатериаловВЛомеИОтходахОстатки
			|		ПО ОстаткиОбъектовНФА.ОбъектНФА = НаличиеДрагМатериаловВЛомеИОтходахОстатки.ОбъектНФА
			|ГДЕ
			|	НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЧистаяМассаОстаток + НаличиеДрагМатериаловВЛомеИОтходахОстатки.ЛигатурнаяМассаОстаток > 0
			|	И ОстаткиОбъектовНФА.КоличествоВсего > 0
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ОстаткиОбъектовНФА.ОбъектНФА,
			|	ОстаткиОбъектовНФА.ИнвНомер,
			|	ОстаткиОбъектовНФА.Количество,
			|	ОстаткиОбъектовНФА.КоличествоВсего,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала,
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала.ТипДрагМатериала,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДрагМатериалов.Списание),
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.Количество
			|			ТОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток * ОстаткиОбъектовНФА.Количество / ОстаткиОбъектовНФА.КоличествоВсего КАК ЧИСЛО(17, 8))
			|	КОНЕЦ,
			|	0,
			|	0,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ПустаяСсылка),
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм,
			|	ВЫБОР
			|		КОГДА ОстаткиОбъектовНФА.КоличествоВсего = ОстаткиОбъектовНФА.Количество
			|			ТОГДА НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток
			|		ИНАЧЕ ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.КоличествоДМОстаток * ОстаткиОбъектовНФА.Количество / ОстаткиОбъектовНФА.КоличествоВсего КАК ЧИСЛО(17, 8))
			|	КОНЕЦ,
			|	ЗНАЧЕНИЕ(Перечисление.ИсточникиОбразованияОтходовИЛомаДрагМатериалов.ПустаяСсылка)
			|ИЗ
			|	ОстаткиОбъектовНФА КАК ОстаткиОбъектовНФА
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&Период, Организация = &Организация) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
			|		ПО ОстаткиОбъектовНФА.ОбъектНФА = НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА
			|			И ОстаткиОбъектовНФА.ИнвНомер = НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер
			|ГДЕ
			|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток > 0
			|	И ОстаткиОбъектовНФА.КоличествоВсего > 0
			|
			|УПОРЯДОЧИТЬ ПО
			|	ОбъектНФА,
			|	ИнвНомер,
			|	ТипДрагМатериала";			
	
	МассивСчетовОС = ПолучитьМассивСчетовДМДляОС(Истина);
	МассивСчетовОС = ДополнитьМассивСчетовДМДляМЦ(Организация, МассивСчетовОС, "Основные средства");
	
	МассивСубконтоОС = Новый Массив;
	МассивСубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
			
	МассивСчетовМЗ = ПолучитьМассивСчетовДМДляМЗ(Истина);
	МассивСчетовМЗ = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(Организация, МассивСчетовМЗ, "Номенклатура");
	
	МассивСубконтоМЗ = Новый Массив;
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	
	Запрос.УстановитьПараметр("Период", 			ПериодОстатков);
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ТаблицаОбъектовНФА", ТаблицаОбъектовНФА);			   
	Запрос.УстановитьПараметр("МассивСчетовОС",		МассивСчетовОС);
	Запрос.УстановитьПараметр("МассивСубконтоОС",	МассивСубконтоОС);
	Запрос.УстановитьПараметр("МассивСчетовМЗ",		МассивСчетовМЗ);
	Запрос.УстановитьПараметр("МассивСубконтоМЗ",	МассивСубконтоМЗ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
КонецФункции	

Функция ЗаполнитьДМДляПринятияКУчетуОбъектовВышедшихИзГрупповогоУчета(Организация, ОбъектыВышедшиеИзГрупповогоИнвУчета) Экспорт
	
	СписокРегистраторовСписанияДрагМатериалов = Новый Массив;
	СписокРегистраторовСписанияДрагМатериалов.Добавить(Тип("ДокументСсылка.СписаниеОбъектовОС"));
	СписокРегистраторовСписанияДрагМатериалов.Добавить(Тип("ДокументСсылка.СписаниеОбъектовИК"));

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаОбъектовНФА.ОбъектНФА КАК ОбъектНФА,
	               |	ТаблицаОбъектовНФА.ИнвНомер КАК ИнвНомер
	               |ПОМЕСТИТЬ СписокНФАВышедшихИзГрупповогоУчета
	               |ИЗ
	               |	&ТаблицаОбъектовНФА КАК ТаблицаОбъектовНФА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СписокНФАВышедшихИзГрупповогоУчета.ОбъектНФА КАК ОбъектНФА,
	               |	СписокНФАВышедшихИзГрупповогоУчета.ИнвНомер КАК ИнвНомер,
	               |	НаличиеДрагМатериаловВОбъектахНФА.Регистратор КАК Регистратор,
	               |	НаличиеДрагМатериаловВОбъектахНФА.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	НаличиеДрагМатериаловВОбъектахНФА.ЕдИзм КАК ЕдИзм,
	               |	НаличиеДрагМатериаловВОбъектахНФА.МассаДМ КАК МассаДМ,
	               |	НаличиеДрагМатериаловВОбъектахНФА.КоличествоДМ КАК КоличествоДМ
	               |ИЗ
	               |	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА КАК НаличиеДрагМатериаловВОбъектахНФА
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокНФАВышедшихИзГрупповогоУчета КАК СписокНФАВышедшихИзГрупповогоУчета
	               |		ПО (ВЫРАЗИТЬ(СписокНФАВышедшихИзГрупповогоУчета.ИнвНомер КАК Справочник.ИнвентарныеНомераОС).ИнвентарныйНомерЗаимствуется)
	               |			И (ВЫРАЗИТЬ(СписокНФАВышедшихИзГрупповогоУчета.ИнвНомер КАК Справочник.ИнвентарныеНомераОС).ИнвентарныйНомерЗаимствованный = НаличиеДрагМатериаловВОбъектахНФА.ИнвНомер)
	               |ГДЕ
	               |	ТИПЗНАЧЕНИЯ(НаличиеДрагМатериаловВОбъектахНФА.Регистратор) В (&ТипыДокументов)
	               |	И НаличиеДрагМатериаловВОбъектахНФА.Организация = &Организация";
	
	
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ТипыДокументов", 	СписокРегистраторовСписанияДрагМатериалов);			   
	Запрос.УстановитьПараметр("ТаблицаОбъектовНФА",	ОбъектыВышедшиеИзГрупповогоИнвУчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции


Функция ПолучитьСписокОстатковМЦ(Дата, Организация, ОбъектВложения) Экспорт

	Запрос = Новый  Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектВложений,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ОбъектМЦ,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстаток
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет.Код = ""МЦК"",
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &ОбъектВложения) КАК ЖурналПроводокЕПСБУОстатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбъектМЦ";  
	
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОбъектВложения", ОбъектВложения); 
	
	Результат = Запрос.Выполнить().Выгрузить(); 
	
	Возврат Результат;
	
КонецФункции

Функция ОбработатьДобавлениеДМДляОбъекта(Знач КоллекцияОбъектовНФА
	, Знач ВыбранноеЗначение, ИмяОС = "ОбъектНФА", КолонкиПоиска = "ОбъектНФА") Экспорт
	
	ТаблицаДМ = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресДМВХранилище);
	ТаблицаДМ.Колонки.ОбъектНФА.Имя = ИмяОС;
	Если СтрНайти(КолонкиПоиска, "ИнвентарныйНомер") > 0 Тогда
		ТаблицаДМ.Колонки.ИнвНомер.Имя = "ИнвентарныйНомер";
	КонецЕсли;
	ИсходныеДанные = КоллекцияОбъектовНФА.Выгрузить();
	ИсходныеДанные.Индексы.Добавить(КолонкиПоиска);
	
	ДобавленныеСтроки = Новый Массив;
	СтруктураПоиска = Новый Структура(КолонкиПоиска);
	
	Для Каждого СтрокаТаблицыДМ Из ТаблицаДМ Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрокаТаблицыДМ);
		СтрокиИсходныхДанных = ИсходныеДанные.НайтиСтроки(СтруктураПоиска);
		Если СтрокиИсходныхДанных.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(КоллекцияОбъектовНФА[СтрокиИсходныхДанных[0].НомерСтроки-1], СтрокаТаблицыДМ);
		Иначе
			ЭлементКоллекции = КоллекцияОбъектовНФА.Добавить();
			ДобавленныеСтроки.Добавить(ЭлементКоллекции);
			ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаТаблицыДМ);
		КонецЕсли;
	КонецЦикла;
	
	//Обработка удаленных строк из списка ДМ
	ОбъектНФА = СтруктураПоиска[ИмяОС];
	Если КолонкиПоиска = "ОбъектНФА,ИнвНомер,ВидДрагМатериала" Тогда
		ИнвНомер = СтруктураПоиска.ИнвНомер;
		КолонкиПоискаНФА = "ОбъектНФА,ИнвНомер";
		СтруктураПоискаНФА = Новый Структура(КолонкиПоискаНФА);
		СтруктураПоискаНФА.ОбъектНФА = ОбъектНФА;
		СтруктураПоискаНФА.ИнвНомер = ИнвНомер;
	ИначеЕсли КолонкиПоиска = "ОсновноеСредство,ИнвентарныйНомер,ВидДрагМатериала" Тогда
		СтруктураПоискаНФА = Новый Структура("ОсновноеСредство,ИнвентарныйНомер",
			ОбъектНФА, СтруктураПоиска.ИнвентарныйНомер);
	Иначе
		КолонкиПоискаНФА = "ОбъектНФА";
		СтруктураПоискаНФА = Новый Структура(КолонкиПоискаНФА);
		СтруктураПоискаНФА.ОбъектНФА = ОбъектНФА;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектНФА) Тогда
		СтрокиИсходныхДанныхДМ = КоллекцияОбъектовНФА.НайтиСтроки(СтруктураПоискаНФА);
		
		Для Каждого ТекСтрока Из СтрокиИсходныхДанныхДМ Цикл
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТекСтрока);
			СтрокиИсходныхДанных = ТаблицаДМ.НайтиСтроки(СтруктураПоиска);
			Если СтрокиИсходныхДанных.Количество()=0 Тогда
				КоллекцияОбъектовНФА.Удалить(ТекСтрока.НомерСтроки-1);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат ДобавленныеСтроки;
	
КонецФункции

Функция ОбработатьДобавлениеДМДляОбъектов(Знач КоллекцияОбъектовНФА
	, Знач ВыбранноеЗначение, ИмяОС = "ОбъектНФА", КолонкиПоиска = "ОбъектНФА") Экспорт
	
	ТаблицаДМ = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресДМВХранилище);
	ТаблицаДМ.Колонки.ОбъектНФА.Имя = ИмяОС;
	ИсходныеДанные = КоллекцияОбъектовНФА.Выгрузить();
	ИсходныеДанные.Индексы.Добавить(КолонкиПоиска);
	
	ДобавленныеСтроки = Новый Массив;
	СтруктураПоиска = Новый Структура(КолонкиПоиска);
	
	Для Каждого СтрокаТаблицыДМ Из ТаблицаДМ Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрокаТаблицыДМ);
		СтрокиИсходныхДанных = ИсходныеДанные.НайтиСтроки(СтруктураПоиска);
		Если СтрокиИсходныхДанных.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(КоллекцияОбъектовНФА[СтрокиИсходныхДанных[0].НомерСтроки-1], СтрокаТаблицыДМ);
		Иначе
			ЭлементКоллекции = КоллекцияОбъектовНФА.Добавить();
			ДобавленныеСтроки.Добавить(ЭлементКоллекции);
			ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаТаблицыДМ);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаНФА = ТаблицаДМ.Скопировать();
	
	Если КолонкиПоиска = "ОбъектНФА,ИнвНомер,ВидДрагМатериала" Тогда
		КолонкиПоискаНФА = "ОбъектНФА,ИнвНомер";
	Иначе
		КолонкиПоискаНФА = "ОбъектНФА";
	КонецЕсли;	
	ТаблицаНФА.Свернуть(КолонкиПоискаНФА);
	
	//Обработка удаленных строк из списка ДМ
	Для Каждого ТекОбъектНФА Из ТаблицаНФА Цикл 
		ОбъектНФА = СтруктураПоиска.ОбъектНФА;
		Если КолонкиПоиска = "ОбъектНФА,ИнвНомер,ВидДрагМатериала" Тогда
			ИнвНомер = СтруктураПоиска.ИнвНомер;
		КонецЕсли;
		
		СтруктураПоискаНФА = Новый Структура(КолонкиПоискаНФА);
		СтруктураПоискаНФА.ОбъектНФА = ТекОбъектНФА.ОбъектНФА;
		Если КолонкиПоиска = "ОбъектНФА,ИнвНомер,ВидДрагМатериала" Тогда
			СтруктураПоискаНФА.ИнвНомер = ТекОбъектНФА.ИнвНомер;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ОбъектНФА) Тогда
			СтрокиИсходныхДанныхДМ = КоллекцияОбъектовНФА.НайтиСтроки(СтруктураПоискаНФА);
			
			Для Каждого	ТекСтрока Из СтрокиИсходныхДанныхДМ Цикл
				ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТекСтрока);
				СтрокиИсходныхДанных = ТаблицаДМ.НайтиСтроки(СтруктураПоиска);
				Если СтрокиИсходныхДанных.Количество()=0 Тогда
					КоллекцияОбъектовНФА.Удалить(ТекСтрока.НомерСтроки-1);
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;	
		
	Возврат ДобавленныеСтроки;
	
КонецФункции

