		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ДрагоценныеМатериалы",
			"ОбъектНФА,ОбъектМЦ,КоличествоМЦ",Документ, Параметры);
		
		ТекстШаблона = НСтр("ru = 'МЦ %1 исключена из состава капитального вложения %2 для учета драгоценных материалов'");
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Документ.КФО КАК КФО,
		|	Документ.ЦМО КАК ЦМОКт,
		|	ТЧДрагоценныеМатериалы.ОбъектНФА КАК КапвложениеКт,
		|	ТЧДрагоценныеМатериалы.ОбъектМЦ КАК ОбъектМЦКт,
		|	ТЧДрагоценныеМатериалы.КоличествоМЦ КАК КоличествоМЦКт
		|ИЗ
		|	ТаблицаДрагоценныеМатериалы КАК ТЧДрагоценныеМатериалы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ КАК Документ
		|		ПО (ИСТИНА)";

	КонецЕсли;
	
	ТаблицаМЦСДрагМатериалами = Запрос.Выполнить().Выгрузить();  
	
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("РазукомплектацияКапвложений");
	МассивИсключений.Добавить("ИзменениеНаличияДрагМатериалов"); 
	МассивИсключений.Добавить("НакладнаяНаВнутреннееПеремещениеОС2"); 
	МассивИсключений.Добавить("ВнутреннееПеремещениеИК");
	МассивИсключений.Добавить("ТребованиеНакладная0315006");
	Если МетаданныеДокумента.Имя = "СписаниеОбъектовОС" И Документ.ВключатьМЦВСоставКапвложений Тогда
	   МассивИсключений.Добавить("СписаниеОбъектовОС");
	КонецЕсли;	
	
	МассивДокПеремещенияМЦ = Новый Массив;
	МассивДокПеремещенияМЦ.Добавить("РазукомплектацияКапвложений");
	МассивДокПеремещенияМЦ.Добавить("ИзменениеНаличияДрагМатериалов");
	МассивДокПеремещенияМЦ.Добавить("НакладнаяНаВнутреннееПеремещениеОС2");
	МассивДокПеремещенияМЦ.Добавить("ВнутреннееПеремещениеИК");
	
	Если ЕстьТабЧастьКапВложения Тогда // ПоступлениеОС
		ТаблицаМЦСДрагМатериалами.Свернуть("КФО, КапвложениеДт, ОбъектМЦДт, ЦМОДт, КоличествоМЦДт");
	ИначеЕсли МассивИсключений.Найти(МетаданныеДокумента.Имя) = Неопределено Тогда
		ТаблицаМЦСДрагМатериалами.Свернуть("КФО, КапвложениеКт, ОбъектМЦКт, ЦМОКт, КоличествоМЦКт");
	КонецЕсли;
		
	Для Каждого Строка Из ТаблицаМЦСДрагМатериалами Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если ЕстьТабЧастьКапВложения Тогда
			НоваяСтрока.СодержаниеПроводки = СтрШаблон(ТекстШаблона, Строка.ОбъектМЦДт, Строка.КапвложениеДт); 
		ИначеЕсли МассивДокПеремещенияМЦ.Найти(МетаданныеДокумента.Имя) <> Неопределено Тогда
						
			ТекстСодержанияПроводкиКт = НСтр("ru = 'МЦ %1 исключена из состава капитального вложения %2 для учета драгоценных материалов'");
			ТекстСодержанияПроводкиДт = НСтр("ru = 'МЦ %1 включена в состав капитального вложения %2 для учета драгоценных материалов'");

			Если ЗначениеЗаполнено(Строка.КапвложениеДт) Тогда
				СодержаниеПроводки = СтрШаблон(ТекстСодержанияПроводкиДт, Строка.ОбъектМЦДт, Строка.КапвложениеДт);	
			Иначе
				СодержаниеПроводки = СтрШаблон(ТекстСодержанияПроводкиКт, Строка.ОбъектМЦКт, Строка.КапвложениеКт);	
			КонецЕсли;
											
			НоваяСтрока.СодержаниеПроводки = СодержаниеПроводки;
			
		ИначеЕсли ТаблицаМЦСДрагМатериалами.Колонки.Найти("КапвложениеКт") <> Неопределено
						И ЗначениеЗаполнено(Строка.КапвложениеКт) Тогда 
			НоваяСтрока.СодержаниеПроводки = СтрШаблон(ТекстШаблона, Строка.ОбъектМЦКт, Строка.КапвложениеКт);
		КонецЕсли;

	КонецЦикла; 
	
	Возврат ТаблицаДокумента;
	
КонецФункции

#КонецОбласти

Процедура ЗаполнитьДляМЗДанныеОТехДокументации(ТаблицаНФА, ВидНФА = "Номенклатура") Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ВидНФА = "ОС" Тогда
		СписокНФАБезПовторов = ТаблицаНФА.ВыгрузитьКолонку("ОсновноеСредство");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Таб.КлючСтроки КАК КлючСтроки,
		               |	Таб.ОсновноеСредство КАК ОсновноеСредство,
		               |	Таб.ИнвентарныйНомер КАК ИнвентарныйНомер,
		               |	Таб.Количество КАК Количество
		               |ПОМЕСТИТЬ ВТДанные
		               |ИЗ
		               |	&Данные КАК Таб
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	МИНИМУМ(ДрагМатериалыВОбъектахНФАПоТехДокументации.Ссылка) КАК Ссылка,
		               |	ДрагМатериалыВОбъектахНФАПоТехДокументации.ОбъектНФА КАК ОбъектНФА
		               |ПОМЕСТИТЬ ТехДокументацияПоОбъектамНФА
		               |ИЗ
		               |	Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации КАК ДрагМатериалыВОбъектахНФАПоТехДокументации
		               |ГДЕ
		               |	ДрагМатериалыВОбъектахНФАПоТехДокументации.ОбъектНФА В(&ОбъектыНФА)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ДрагМатериалыВОбъектахНФАПоТехДокументации.ОбъектНФА
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТДанные.КлючСтроки КАК КлючСтроки,
		               |	ВТДанные.ОсновноеСредство КАК ОсновноеСредство,
		               |	ВТДанные.ИнвентарныйНомер КАК ИнвентарныйНомер,
		               |	ВТДанные.Количество КАК Количество,
		               |	ТехДокументацияПоОбъектамНФА.Ссылка КАК ТехДокументация,
		               |	ВЫБОР
		               |		КОГДА ЕСТЬNULL(ТехДокументацияПоОбъектамНФА.Ссылка, 0) = 0
		               |			ТОГДА ""Заполнить""
		               |		ИНАЧЕ ТехДокументацияПоОбъектамНФА.Ссылка
		               |	КОНЕЦ КАК ТехДокументацияИнфо
		               |ИЗ
		               |	ВТДанные КАК ВТДанные
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ТехДокументацияПоОбъектамНФА КАК ТехДокументацияПоОбъектамНФА
		               |		ПО ВТДанные.ОсновноеСредство = ТехДокументацияПоОбъектамНФА.ОбъектНФА";

	Иначе	
		СписокНФАБезПовторов = ТаблицаНФА.ВыгрузитьКолонку("Номенклатура");
	
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Таб.КлючСтроки КАК КлючСтроки,
		               |	Таб.Номенклатура КАК Номенклатура,
		               |	Таб.Количество КАК Количество
		               |ПОМЕСТИТЬ ВТДанные
		               |ИЗ
		               |	&Данные КАК Таб
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	МИНИМУМ(ДрагМатериалыВОбъектахНФАПоТехДокументации.Ссылка) КАК Ссылка,
		               |	ДрагМатериалыВОбъектахНФАПоТехДокументации.ОбъектНФА КАК ОбъектНФА
		               |ПОМЕСТИТЬ ТехДокументацияПоОбъектамНФА
		               |ИЗ
		               |	Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации КАК ДрагМатериалыВОбъектахНФАПоТехДокументации
		               |ГДЕ
		               |	ДрагМатериалыВОбъектахНФАПоТехДокументации.ОбъектНФА В(&ОбъектыНФА)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ДрагМатериалыВОбъектахНФАПоТехДокументации.ОбъектНФА
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТДанные.КлючСтроки КАК КлючСтроки,
		               |	ВТДанные.Номенклатура КАК Номенклатура,
		               |	ВТДанные.Количество КАК Количество,
		               |	ТехДокументацияПоОбъектамНФА.Ссылка КАК ТехДокументация,
		               |	ВЫБОР
		               |		КОГДА ЕСТЬNULL(ТехДокументацияПоОбъектамНФА.Ссылка, 0) = 0
		               |			ТОГДА ""Заполнить""
		               |		ИНАЧЕ ТехДокументацияПоОбъектамНФА.Ссылка
		               |	КОНЕЦ КАК ТехДокументацияИнфо
		               |ИЗ
		               |	ВТДанные КАК ВТДанные
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ТехДокументацияПоОбъектамНФА КАК ТехДокументацияПоОбъектамНФА
		               |		ПО ВТДанные.Номенклатура = ТехДокументацияПоОбъектамНФА.ОбъектНФА";

	КонецЕсли;

	Запрос.УстановитьПараметр("ОбъектыНФА", СписокНФАБезПовторов);
	Запрос.УстановитьПараметр("Данные", ТаблицаНФА);
	ТаблицаНФА = Запрос.Выполнить().Выгрузить();
КонецПроцедуры	

Процедура ЗаполнитьДляМЗДанныеОСодержанииДрагМатериаловТехДокументации(ТаблицаНФА, ВидНФА = "Номенклатура") Экспорт
 	УстановитьПривилегированныйРежим(Истина);

	ЗаполнитьДляМЗДанныеОТехДокументации(ТаблицаНФА, ВидНФА);

	ТаблицаИтогов = Новый ТаблицаЗначений;
	ТаблицаИтогов.Колонки.Добавить("ОбъектНФА", ТипОбъектаНФА());
	ТаблицаИтогов.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаИтогов.Колонки.Добавить("ОсновноеСредство", ТипОбъектаНФА());
	ТаблицаИтогов.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаИтогов.Колонки.Добавить("ВидДрагМатериала", Новый ОписаниеТипов("СправочникСсылка.ДрагМеталлы"));
	ТаблицаИтогов.Колонки.Добавить("ЕдИзм", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаИтогов.Колонки.Добавить("МассаДМ", Новый ОписаниеТипов("Число"));
	ТаблицаИтогов.Колонки.Добавить("КоличествоДМ", Новый ОписаниеТипов("Число"));

	НомерНФАВСписке = 0;
	Для Каждого ТекСтрока Из ТаблицаНФА Цикл
		НомерНФАВСписке = НомерНФАВСписке + 1;
		ТехДокументация = ТекСтрока.ТехДокументация;
		Если ЗначениеЗаполнено(ТехДокументация) Тогда
			Для Каждого ТекДМ Из ТехДокументация.ДрагМатериалы Цикл
				НоваяСтрока = ТаблицаИтогов.Добавить();
				Если ВидНФА = "ОС" Тогда
					НоваяСтрока.ОбъектНФА = ТекСтрока.ОсновноеСредство;
					НоваяСтрока.ИнвНомер = ТекСтрока.ИнвентарныйНомер;
					НоваяСтрока.ОсновноеСредство = ТекСтрока.ОсновноеСредство;
					НоваяСтрока.ИнвентарныйНомер = ТекСтрока.ИнвентарныйНомер;
				Иначе	
					НоваяСтрока.ОбъектНФА = ТекСтрока.Номенклатура;
				КонецЕсли;
				НоваяСтрока.ВидДрагМатериала = ТекДМ.ВидДрагМатериала;
				НоваяСтрока.ЕдИзм = ТекДМ.ЕдИзм;
				НоваяСтрока.МассаДМ = ТекДМ.МассаДМ * ТекСтрока.Количество;
				НоваяСтрока.КоличествоДМ = ТекДМ.КоличествоДМ * ТекСтрока.Количество;
			КонецЦикла;
		Иначе
			ТекстОшибки = НСтр("ru='Для строки %1 (%2) списка объектов НФА нет сведений о содержании драгоценных материалов по технической документации!'");
			ИмяРеквизита = ?(ВидНФА = "ОС", "ОсновноеСредство", "Номенклатура");
			ТекстСообщенияОбОшибке = СтрШаблон(ТекстОшибки, НомерНФАВСписке, ТекСтрока[ИмяРеквизита]);  
			//ТекстСообщенияОбОшибке = СтрШаблон(ТекстОшибки, НомерНФАВСписке, ТекСтрока.Номенклатура);  
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщенияОбОшибке);
		КонецЕсли;	
	КонецЦикла;	
	
	ТаблицаНФА = ТаблицаИтогов;
КонецПроцедуры	

Процедура ЗаполнитьДляМЗДанныеОСодержанииДрагМатериаловТехДокументацииПоДеталям(ТаблицаНФА, ВидНФА = "Номенклатура") Экспорт
	УстановитьПривилегированныйРежим(Истина);

	ЗаполнитьДляМЗДанныеОТехДокументации(ТаблицаНФА, ВидНФА);

	ТаблицаИтогов = Новый ТаблицаЗначений;
	ТаблицаИтогов.Колонки.Добавить("ОбъектНФА", ТипОбъектаНФА());
	ТаблицаИтогов.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаИтогов.Колонки.Добавить("Деталь", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаИтогов.Колонки.Добавить("ВидДрагМатериала", Новый ОписаниеТипов("СправочникСсылка.ДрагМеталлы"));
	ТаблицаИтогов.Колонки.Добавить("ЕдИзм", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаИтогов.Колонки.Добавить("МассаДМ", Новый ОписаниеТипов("Число"));
	ТаблицаИтогов.Колонки.Добавить("КоличествоДМ", Новый ОписаниеТипов("Число"));

	НомерНФАВСписке = 0;
	Для Каждого ТекСтрока Из ТаблицаНФА Цикл
		НомерНФАВСписке = НомерНФАВСписке + 1;
		ТехДокументация = ТекСтрока.ТехДокументация;
		Если ЗначениеЗаполнено(ТехДокументация) Тогда
			Для Каждого ТекДМ Из ТехДокументация.ДрагМатериалы Цикл
				НоваяСтрока = ТаблицаИтогов.Добавить();
				Если ВидНФА = "ОС" Тогда
					НоваяСтрока.ОбъектНФА = ТекСтрока.ОсновноеСредство;
					НоваяСтрока.ИнвНомер = ТекСтрока.ИнвентарныйНомер;
				Иначе	
					НоваяСтрока.ОбъектНФА = ТекСтрока.Номенклатура;
				КонецЕсли;
				НоваяСтрока.Деталь = ТекДМ.Деталь;
				НоваяСтрока.ВидДрагМатериала = ТекДМ.ВидДрагМатериала;
				НоваяСтрока.ЕдИзм = ТекДМ.ЕдИзм;
				НоваяСтрока.МассаДМ = ТекДМ.МассаДМ * ТекСтрока.Количество;
				НоваяСтрока.КоличествоДМ = ТекДМ.КоличествоДМ * ТекСтрока.Количество;
			КонецЦикла;
		Иначе
			ТекстОшибки = НСтр("ru='Для строки %1 (%2) списка объектов НФА нет сведений о содержании драгоценных материалов по технической документации!'");
			ИмяРеквизита = ?(ВидНФА = "ОС", "ОсновноеСредство", "Номенклатура");
			ТекстСообщенияОбОшибке = СтрШаблон(ТекстОшибки, НомерНФАВСписке, ТекСтрока[ИмяРеквизита]);  
//			ТекстСообщенияОбОшибке = СтрШаблон(ТекстОшибки, НомерНФАВСписке, ТекСтрока.Номенклатура);  
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщенияОбОшибке);
		КонецЕсли;	
	КонецЦикла;	
	
	ТаблицаНФА = ТаблицаИтогов;
КонецПроцедуры	

Функция СодержаниеДрагМатериаловСУчетомТехДокументации(ОстаткиДМ, ТаблицаНФАПодетальная, ВидНФА = "Номенклатура") Экспорт
	Результат = ОстаткиДМ;
	
	КС = Новый КвалификаторыСтроки(100);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
	ТаблицаНФАПодетальная.Колонки.Добавить("КлючСтроки", ОписаниеТиповС, "Ключ строки", 100);
	
	ТаблицаНФА  = Новый ТаблицаЗначений;
	Если ВидНФА = "ОС" Тогда 
		ТаблицаНФА.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	Иначе
		ТаблицаНФА.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	КонецЕсли;
	
	ТаблицаНФА.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаНФА.Колонки.Добавить("ВидДрагМатериала", Новый ОписаниеТипов("СправочникСсылка.ДрагМеталлы"));
	ТаблицаНФА.Колонки.Добавить("ЕдИзм", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаНФА.Колонки.Добавить("МассаДМ", Новый ОписаниеТипов("Число"));
	ТаблицаНФА.Колонки.Добавить("КоличествоДМ", Новый ОписаниеТипов("Число"));
	ТаблицаНФА.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТаблицаНФА.Колонки.Добавить("КлючСтроки", ОписаниеТиповС, "Ключ строки", 100);

	Для Каждого СтрокаТаблицыИсточника Из ТаблицаНФАПодетальная Цикл
		СтрокаТаблицыПриемника = ТаблицаНФА.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыПриемника, СтрокаТаблицыИсточника);
	КонецЦикла;	
	
	ЗаполнитьДляМЗДанныеОСодержанииДрагМатериаловТехДокументации(ТаблицаНФА, ВидНФА);

	Если ВидНФА = "ОС" Тогда 
		ТаблицаНФА.Свернуть("ОбъектНФА, ИнвНомер, ОсновноеСредство, ИнвентарныйНомер, ВидДрагМатериала, ЕдИзм", "МассаДМ, КоличествоДМ"); 
	Иначе
		ТаблицаНФА.Свернуть("ОбъектНФА, ИнвНомер, ВидДрагМатериала, ЕдИзм", "МассаДМ, КоличествоДМ"); 
	КонецЕсли;
	
	ОстаткиРавны = Истина;
	Если ТаблицаНФА.Количество() = ОстаткиДМ.Количество() Тогда
		Для Каждого ТекСтрока Из ОстаткиДМ Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ОбъектНФА", ТекСтрока.ОбъектНФА);
			ПараметрыОтбора.Вставить("ИнвНомер", ТекСтрока.ИнвНомер);
			ПараметрыОтбора.Вставить("ВидДрагМатериала", ТекСтрока.ВидДрагМатериала);
			ПараметрыОтбора.Вставить("ЕдИзм", ТекСтрока.ЕдИзм);
			НайденныеСтроки = ТаблицаНФА.НайтиСтроки(ПараметрыОтбора);   
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				ОстаткиРавны = Ложь;
				Прервать;
			Иначе
				Если ТекСтрока.МассаДМ = НайденныеСтроки[0].МассаДМ 
					И ТекСтрока.КоличествоДМ = НайденныеСтроки[0].КоличествоДМ Тогда
				Иначе
					ОстаткиРавны = Ложь;
					Прервать;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
	Иначе
		ОстаткиРавны = Ложь;
	КонецЕсли;
	
	Если ОстаткиРавны Тогда
		ЗаполнитьДляМЗДанныеОСодержанииДрагМатериаловТехДокументацииПоДеталям(ТаблицаНФАПодетальная, ВидНФА);
		Результат = ТаблицаНФАПодетальная;
	КонецЕсли;	

	Возврат Результат;
КонецФункции	

#КонецОбласти
