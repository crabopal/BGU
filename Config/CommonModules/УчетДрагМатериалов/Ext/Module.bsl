КонецФункции	

Функция ЕдиныйСписокДрагМатериаловДляНесколькихОбъектовНФА(ТаблицаДрагМатериалов, ВыбранныеНФА) Экспорт
	Для Каждого ТекСтрока Из ТаблицаДрагМатериалов Цикл
		ИнвНомер = ?(ТипЗнч(ТекСтрока.ОбъектНФА)=Тип("СправочникСсылка.ОсновныеСредства"),ТекСтрока.ИнвНомер,"");
		ТекСтрока.КлючСтроки = ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ИнвНомер);
	КонецЦикла;	
	
	КС = Новый КвалификаторыСтроки(100);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
	
	ВыбранныеНФА.Колонки.Добавить("КлючСтроки", ОписаниеТиповС, "Ключ строки", 100);
	Для Каждого ТекСтрока Из ВыбранныеНФА Цикл
		ИнвНомер = ?(ТипЗнч(ТекСтрока.ОбъектНФА)=Тип("СправочникСсылка.ОсновныеСредства"),ТекСтрока.ИнвНомер,"");
		ТекСтрока.КлючСтроки = ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ИнвНомер);
	КонецЦикла;	
	
	ОС = Новый ТаблицаЗначений;
	ОС.Колонки.Добавить("ОбъектНФА", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ОС.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ОС.Колонки.Добавить("КлючСтроки", ОписаниеТиповС, "Ключ строки", 100);
	ОС.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	НМ = Новый ТаблицаЗначений;
	НМ.Колонки.Добавить("ОбъектНФА", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	НМ.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	НМ.Колонки.Добавить("КлючСтроки", ОписаниеТиповС, "Ключ строки", 100);
	НМ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекСтрока Из ВыбранныеНФА Цикл
		Если ТипЗнч(ТекСтрока.ОбъектНФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			НоваяСтрока = ОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока); 
		ИначеЕсли ТипЗнч(ТекСтрока.ОбъектНФА) = Тип("СправочникСсылка.Номенклатура") Тогда
			НоваяСтрока = НМ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока); 
		КонецЕсли;	
	КонецЦикла;	
		
	ТаблицаДМ = Новый ТаблицаЗначений;
	ТаблицаДМ.Колонки.Добавить("ВидДрагМатериала",Новый ОписаниеТипов("СправочникСсылка.ДрагМеталлы"));
	ТаблицаДМ.Колонки.Добавить("МассаДМ",Новый ОписаниеТипов("Число"));
	ТаблицаДМ.Колонки.Добавить("КоличествоДМ",Новый ОписаниеТипов("Число"));
	ТаблицаДМ.Колонки.Добавить("ЕдИзм",Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаДМ.Колонки.Добавить("НомерОбъектаНФА",Новый ОписаниеТипов("Число"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаТЧ.КлючСтроки,
	               |	ТаблицаТЧ.ОбъектНФА,
	               |	ТаблицаТЧ.ИнвНомер,
	               |	ТаблицаТЧ.ВидДрагМатериала,
	               |	ТаблицаТЧ.ЕдИзм,
	               |	ТаблицаТЧ.МассаДМ,
	               |	ТаблицаТЧ.КоличествоДМ
	               |ПОМЕСТИТЬ ТЧ
	               |ИЗ
	               |	&ТаблицаТЧ КАК ТаблицаТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаВыбранныхОС.КлючСтроки,
	               |	ТаблицаВыбранныхОС.ОбъектНФА,
	               |	ТаблицаВыбранныхОС.ИнвНомер,
	               |	ТаблицаВыбранныхОС.Количество
	               |ПОМЕСТИТЬ ВыбранныеОС
	               |ИЗ
	               |	&ТаблицаВыбранныхОС КАК ТаблицаВыбранныхОС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаВыбранныхНом.КлючСтроки,
	               |	ТаблицаВыбранныхНом.ОбъектНФА,
	               |	ТаблицаВыбранныхНом.ИнвНомер,
	               |	ТаблицаВыбранныхНом.Количество
	               |ПОМЕСТИТЬ ВыбранныеНом
	               |ИЗ
	               |	&ТаблицаВыбранныхНом КАК ТаблицаВыбранныхНом
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТЧ.КлючСтроки КАК КлючСтроки,
	               |	ТЧ.ОбъектНФА,
	               |	ТЧ.ИнвНомер,
	               |	ТЧ.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	ТЧ.ЕдИзм КАК ЕдИзм,
	               |	ЕСТЬNULL(ТЧ.МассаДМ, 0) КАК МассаДМ,
	               |	ЕСТЬNULL(ТЧ.КоличествоДМ, 0) КАК КоличествоДМ,
	               |	ЕСТЬNULL(ВыбранныеОС.Количество, 1) КАК Количество
	               |ИЗ
	               |	ВыбранныеОС КАК ВыбранныеОС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТЧ КАК ТЧ
	               |		ПО (ТЧ.КлючСтроки = ВыбранныеОС.КлючСтроки)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ТЧ.КлючСтроки,
	               |	ТЧ.ОбъектНФА,
	               |	ТЧ.ИнвНомер,
	               |	ТЧ.ВидДрагМатериала,
	               |	ТЧ.ЕдИзм,
	               |	ЕСТЬNULL(ТЧ.МассаДМ, 0),
	               |	ЕСТЬNULL(ТЧ.КоличествоДМ, 0),
	               |	ЕСТЬNULL(ВыбранныеНом.Количество, 1)
	               |ИЗ
	               |	ВыбранныеНом КАК ВыбранныеНом
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТЧ КАК ТЧ
	               |		ПО ВыбранныеНом.КлючСтроки = ТЧ.КлючСтроки
	               |ИТОГИ
	               |	СУММА(МассаДМ),
	               |	СУММА(КоличествоДМ),
	               |	СУММА(Количество)
	               |ПО
	               |	КлючСтроки,
	               |	ВидДрагМатериала,
	               |	ЕдИзм";
	
	Запрос.УстановитьПараметр("ТаблицаТЧ", ТаблицаДрагМатериалов);
	Запрос.УстановитьПараметр("ТаблицаВыбранныхОС", ОС);
	Запрос.УстановитьПараметр("ТаблицаВыбранныхНом", НМ);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "КлючСтроки");	
	
	ПервыйОбъектНФА = Истина;
	НомерОбъектаНФА = 0;
	
	Пока Выборка.Следующий() Цикл
		НомерОбъектаНФА = НомерОбъектаНФА + 1;
		
		ВыборкаВидДрагМатериала = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидДрагМатериала");
		Пока ВыборкаВидДрагМатериала.Следующий() Цикл
			
			ВыборкаЕдИзм = ВыборкаВидДрагМатериала.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ЕдИзм");
			Пока ВыборкаЕдИзм.Следующий() Цикл
				ВидРагМатериала = ВыборкаВидДрагМатериала.ВидДрагМатериала;
				ЕдИзм = ВыборкаЕдИзм.ЕдИзм;
				Количество = ВыборкаЕдИзм.Количество;
				Если Количество = 0 Тогда
					ТекстОшибки = НСтр("ru='Количество объектов НФА не может быть равно 0!'");
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
				КонецЕсли;
				
				МассаДМ = ВыборкаЕдИзм.МассаДМ/Количество;
				КоличествоДМ = ВыборкаЕдИзм.КоличествоДМ/Количество;
				
				Если ПервыйОбъектНФА Тогда
					НоваяСтрока = ТаблицаДМ.Добавить();
					НоваяСтрока.ВидДрагМатериала = ВидРагМатериала;
					НоваяСтрока.ЕдИзм = ЕдИзм;
					НоваяСтрока.МассаДМ = МассаДМ;
					НоваяСтрока.КоличествоДМ = КоличествоДМ;
					НоваяСтрока.НомерОбъектаНФА = НомерОбъектаНФА;
				Иначе	
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("ВидДрагМатериала", ВидРагМатериала);
					ПараметрыОтбора.Вставить("ЕдИзм", ЕдИзм);
					НайденныеСтроки = ТаблицаДМ.НайтиСтроки(ПараметрыОтбора);   
					
					Если НайденныеСтроки.Количество() = 0 Тогда
						НоваяСтрока = ТаблицаДМ.Добавить();
						НоваяСтрока.ВидДрагМатериала = ВидРагМатериала;
						НоваяСтрока.ЕдИзм = ЕдИзм;
						НоваяСтрока.МассаДМ = 0;
						НоваяСтрока.КоличествоДМ = 0;
						НоваяСтрока.НомерОбъектаНФА = НомерОбъектаНФА;
						
					Иначе
						Для НомерНайденнойСтроки = 1 По НайденныеСтроки.Количество() Цикл
							НайденнаяМассаДМ = НайденныеСтроки[НомерНайденнойСтроки-1].МассаДМ; 
							Если НайденнаяМассаДМ<>МассаДМ Тогда
								НайденныеСтроки[НомерНайденнойСтроки-1].МассаДМ = 0;
							КонецЕсли;	
							НайденноеКоличествоДМ = НайденныеСтроки[НомерНайденнойСтроки-1].КоличествоДМ; 
							Если НайденноеКоличествоДМ<>КоличествоДМ Тогда
								НайденныеСтроки[НомерНайденнойСтроки-1].КоличествоДМ = 0;
							КонецЕсли;	
							
							НайденныеСтроки[НомерНайденнойСтроки-1].НомерОбъектаНФА = НомерОбъектаНФА;
						КонецЦикла;
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЦикла;	
		ПервыйОбъектНФА = Ложь;
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ТаблицаДМ Цикл
		Если ТекСтрока.НомерОбъектаНФА = 1 Тогда
			ТекСтрока.МассаДМ = 0;
			ТекСтрока.КоличествоДМ = 0;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат ТаблицаДМ;	
	
КонецФункции	

Функция ЕдиныйСписокДрагМатериаловДляНесколькихОбъектовВложений(ТаблицаДрагМатериалов, ВыбранныеНФА) Экспорт
	Для Каждого ТекСтрока Из ТаблицаДрагМатериалов Цикл
		ИнвНомер = "";
		ТекСтрока.КлючСтроки = ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ИнвНомер);
	КонецЦикла;	
	
	КС = Новый КвалификаторыСтроки(100);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
	
	ВыбранныеНФА.Колонки.Добавить("КлючСтроки", ОписаниеТиповС, "Ключ строки", 100);
	Для Каждого ТекСтрока Из ВыбранныеНФА Цикл
		ИнвНомер = "";
		ТекСтрока.КлючСтроки = ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ИнвНомер);
	КонецЦикла;	
	
	ОС = Новый ТаблицаЗначений;
	ОС.Колонки.Добавить("ОбъектНФА", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ОС.Колонки.Добавить("КлючСтроки", ОписаниеТиповС, "Ключ строки", 100);
	ОС.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекСтрока Из ВыбранныеНФА Цикл
		Если ТипЗнч(ТекСтрока.ОбъектНФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			НоваяСтрока = ОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока); 
		КонецЕсли;	
	КонецЦикла;	
		
	ТаблицаДМ = Новый ТаблицаЗначений; 
	ТаблицаДМ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТаблицаДМ.Колонки.Добавить("ОбъектМЦ", ТипОбъектаНФА());
	ТаблицаДМ.Колонки.Добавить("КоличествоМЦ", Новый ОписаниеТипов("Число"));
	ТаблицаДМ.Колонки.Добавить("ВидДрагМатериала",Новый ОписаниеТипов("СправочникСсылка.ДрагМеталлы"));
	ТаблицаДМ.Колонки.Добавить("МассаДМ",Новый ОписаниеТипов("Число"));
	ТаблицаДМ.Колонки.Добавить("КоличествоДМ",Новый ОписаниеТипов("Число"));
	ТаблицаДМ.Колонки.Добавить("ЕдИзм",Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ТаблицаДМ.Колонки.Добавить("НомерОбъектаНФА",Новый ОписаниеТипов("Число"));
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаТЧ.КлючСтроки КАК КлючСтроки,
	               |	ТаблицаТЧ.ОбъектМЦ КАК ОбъектМЦ,
	               |	ТаблицаТЧ.КоличествоМЦ КАК КоличествоМЦ,
	               |	ТаблицаТЧ.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	ТаблицаТЧ.ЕдИзм КАК ЕдИзм,
	               |	ТаблицаТЧ.МассаДМ КАК МассаДМ,
	               |	ТаблицаТЧ.КоличествоДМ КАК КоличествоДМ
	               |ПОМЕСТИТЬ ТЧ
	               |ИЗ
	               |	&ТаблицаТЧ КАК ТаблицаТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаВыбранныхОС.КлючСтроки КАК КлючСтроки,
	               |	ТаблицаВыбранныхОС.ОбъектНФА КАК ОбъектНФА,
	               |	ТаблицаВыбранныхОС.Количество КАК Количество
	               |ПОМЕСТИТЬ ВыбранныеОС
	               |ИЗ
	               |	&ТаблицаВыбранныхОС КАК ТаблицаВыбранныхОС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТЧ.КлючСтроки КАК КлючСтроки,
	               |	ТЧ.ОбъектМЦ КАК ОбъектМЦ,
	               |	ТЧ.КоличествоМЦ КАК КоличествоМЦ,
	               |	ТЧ.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	ТЧ.ЕдИзм КАК ЕдИзм,
	               |	ЕСТЬNULL(ТЧ.МассаДМ, 0) КАК МассаДМ,
	               |	ЕСТЬNULL(ТЧ.КоличествоДМ, 0) КАК КоличествоДМ,
	               |	ЕСТЬNULL(ВыбранныеОС.Количество, 1) КАК Количество
	               |ИЗ
	               |	ВыбранныеОС КАК ВыбранныеОС
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТЧ КАК ТЧ
	               |		ПО (ТЧ.КлючСтроки = ВыбранныеОС.КлючСтроки)";
	               	
	Запрос.УстановитьПараметр("ТаблицаТЧ", ТаблицаДрагМатериалов);
	Запрос.УстановитьПараметр("ТаблицаВыбранныхОС", ОС);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ПервыйОбъектНФА = Истина;
	НомерОбъектаНФА = 0;
	ТекКлючСтроки = "";
	
	Для Каждого ТекСтрока Из РезультатЗапроса Цикл
		
		Если ТекКлючСтроки <> ТекСтрока.КлючСтроки Тогда
			НомерОбъектаНФА = НомерОбъектаНФА + 1; 
			ТекКлючСтроки = ТекСтрока.КлючСтроки; 
		КонецЕсли;
		
		Если ПервыйОбъектНФА Тогда
			НоваяСтрока = ТаблицаДМ.Добавить();
			НоваяСтрока.Количество = ТекСтрока.Количество;
			НоваяСтрока.ОбъектМЦ = ТекСтрока.ОбъектМЦ;
			НоваяСтрока.КоличествоМЦ = ТекСтрока.КоличествоМЦ;
			НоваяСтрока.ВидДрагМатериала = ТекСтрока.ВидДрагМатериала;
			НоваяСтрока.ЕдИзм = ТекСтрока.ЕдИзм;
			НоваяСтрока.МассаДМ = ТекСтрока.МассаДМ;
			НоваяСтрока.КоличествоДМ = ТекСтрока.КоличествоДМ;
			НоваяСтрока.НомерОбъектаНФА = НомерОбъектаНФА;
		Иначе	        
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ОбъектМЦ", ТекСтрока.ОбъектМЦ);
			ПараметрыОтбора.Вставить("ВидДрагМатериала", ТекСтрока.ВидДрагМатериала);
			НайденныеСтроки = ТаблицаДМ.НайтиСтроки(ПараметрыОтбора);   
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				
				НоваяСтрока = ТаблицаДМ.Добавить(); 
				НоваяСтрока.Количество = ТекСтрока.Количество;
				НоваяСтрока.ОбъектМЦ = ТекСтрока.ОбъектМЦ;
				НоваяСтрока.КоличествоМЦ = ТекСтрока.КоличествоМЦ;
				НоваяСтрока.ВидДрагМатериала = ТекСтрока.ВидДрагМатериала;
				НоваяСтрока.ЕдИзм = ТекСтрока.ЕдИзм;
				НоваяСтрока.МассаДМ = ТекСтрока.МассаДМ;
				НоваяСтрока.КоличествоДМ = ТекСтрока.КоличествоДМ;
				НоваяСтрока.НомерОбъектаНФА = НомерОбъектаНФА;
				
			КонецЕсли;
			
		КонецЕсли; 
		
    	ПервыйОбъектНФА = Ложь; 
		
	КонецЦикла;	
	
	Возврат ТаблицаДМ;	
	
КонецФункции

