
#Область ПрограммныйИнтерфейс

Процедура ОткрытьГрафикИсполненияДоговора(КонтрагентДоговор, Параметры = Неопределено, Отбор = Неопределено,
	Владелец = Неопределено, Уникальность = Неопределено, Окно = Неопределено, НавигационнаяСсылка = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	ПараметрыФормы.Вставить("КлючВарианта", "КонтрольИсполненияДоговоров");
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "КонтрольИсполненияДоговоров");
	
	Если ТипЗнч(КонтрагентДоговор) = Тип("СправочникСсылка.Контрагенты") Тогда
		ПараметрыФормы.Вставить("Отбор", Новый Структура("Контрагент", КонтрагентДоговор));
	Иначе
		ПараметрыФормы.Вставить("Отбор", Новый Структура("Договор", КонтрагентДоговор));
	КонецЕсли;
	
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Для Каждого Параметр Из Параметры Цикл
			ПараметрыФормы.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Для Каждого ЭлементОтбора Из Отбор Цикл
			ПараметрыФормы.Отбор.Вставить(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
		КонецЦикла;
	КонецЕсли;
	
	ОткрытьФорму("Отчет.КонтрольИсполненияДоговоров.Форма", ПараметрыФормы, Владелец, Уникальность, Окно, НавигационнаяСсылка);
	
КонецПроцедуры

