Процедура ВвестиИзменитьГрафикПоДоговору(Договор, ВидГрафика = "", Параметры = Неопределено,
			Владелец = Неопределено, Уникальность = Неопределено) Экспорт
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("Договор", Договор);
	ЗначенияЗаполнения.Вставить("ВидГрафика", ВидГрафика);
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Для Каждого Параметр Из Параметры Цикл
			ЗначенияЗаполнения.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ФормаНовогоДокумента = ОткрытьФорму("Документ.РегистрацияОбязательствИСведенийПоДоговорам.ФормаОбъекта",
		ПараметрыФормы, Владелец, Уникальность, , , , РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

Процедура ПоказатьСтатусИсполнения(Организация, Контрагент, Договор = Неопределено, Параметры = Неопределено, Владелец = Неопределено, Уникальность = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	ПараметрыФормы.Вставить("Контрагент", Контрагент);
	
	Если ЗначениеЗаполнено(Договор) Тогда
		ПараметрыФормы.Вставить("Договор", Договор);
	КонецЕсли;
	
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Для Каждого Параметр Из Параметры Цикл
			ПараметрыФормы.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.КонтрольИсполненияДоговоров", ПараметрыФормы, Владелец, Уникальность);
	
КонецПроцедуры

Процедура УстановитьСтатусОтразитьДокументВГрафикеИсполнения(Форма, ОтразитьВГрафикеИсполнения) Экспорт
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"КонтрольИсполненияДоговоровОтразитьСейчас", "Видимость",
			ОтразитьВГрафикеИсполнения = ПредопределенноеЗначение("Перечисление.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"КонтрольИсполненияДоговоровОтразитьПозднее", "Видимость",
			ОтразитьВГрафикеИсполнения = ПредопределенноеЗначение("Перечисление.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьПозднее"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"КонтрольИсполненияДоговоровНеОтражать", "Видимость",
			ОтразитьВГрафикеИсполнения = ПредопределенноеЗначение("Перечисление.СтатусыДокументовКонтрольИсполненияДоговоров.НеОтражать"));
	
КонецПроцедуры

