#Область ПрограммныйИнтерфейс

// При заполнении налоговых органов действия.
// 
// Параметры:
//  Организации - Массив, Неопределено
//  НалоговыеОрганыДействия - ТаблицаЗначений
//
Процедура ПриЗаполненииНалоговыхОргановДействия(Организации, НалоговыеОрганыДействия) Экспорт
		
КонецПроцедуры

// Вызывается в форме машиночитаемой доверенности для заполнения реквизитов организации при выборе доверителя и представителя,
// если выбран вид представителя/доверителя "Организация".
// 
// Параметры:
//  Организация - ОпределяемыйТип.Организация - ссылка на организацию, реквизиты которой надо заполнить.
//  Реквизиты - Структура:
//                * ЭтоИндивидуальныйПредприниматель - Булево
//                * ЭтоИностраннаяОрганизация - Булево
//                * ЭтоФилиал - Булево
//                * НаименованиеПолное - Строка
//                * НаименованиеСокращенное - Строка
//                * ИНН - Строка
//                * КПП - Строка
//                * ОГРН - Строка
//                * ЭлектроннаяПочта - Строка
//                * ЭлектроннаяПочтаЗначение - Строка - в формате JSON, как его возвращает
//                  функция КонтактнаяИнформацияОбъекта общего модуля УправлениеКонтактнойИнформацией.
//                * Телефон - Строка
//                * ТелефонЗначение - Строка - в формате JSON, как его возвращает
//                  функция КонтактнаяИнформацияОбъекта общего модуля УправлениеКонтактнойИнформацией.
//                Заполняются для иностранной организации:
//                * НомерЗаписиОбАккредитации - Строка
//                * СтранаРегистрации - СправочникСсылка.СтраныМира
//                * СтранаРегистрацииКод - Строка
//                * РегистрационныйНомерВСтранеРегистрации - Строка
//                * НаименованиеРегистрирующегоОргана - Строка
//                * КодНалогоплательщикаВСтранеРегистрации - Строка
//                * ФактическийАдрес - Строка
//                * ФактическийАдресЗначение - Строка - в формате JSON, как его возвращает
//                  функция КонтактнаяИнформацияОбъекта общего модуля УправлениеКонтактнойИнформацией.
//                * ЮридическийАдресВСтранеРегистрации - Строка
//                * ЮридическийАдресВСтранеРегистрацииЗначение - Строка - в формате JSON, как его возвращает
//                  функция КонтактнаяИнформацияОбъекта общего модуля УправлениеКонтактнойИнформацией.
//                Заполняются для российской организации:
//                * НаименованиеУчредительногоДокумента - Строка
//                * ЮридическийАдрес - Строка
//                * ЮридическийАдресЗначение - Строка - в формате JSON, как его возвращает
//                  функция КонтактнаяИнформацияОбъекта общего модуля УправлениеКонтактнойИнформацией.
//                Заполняются для филиала:
//                * РегистрационныйНомерФилиала - Строка
//                Данные о физическом лице с правом действия без доверенности:
//                * ЛицоБезДоверенности - ОпределяемыйТип.ФизическоеЛицо
//                * РеквизитыЛицаБезДоверенности - см. ПриЗаполненииРеквизитовФизическогоЛица.Реквизиты
//
//  СтандартнаяОбработка - Булево - установите в Ложь, если нужно отменить заполнение реквизитов из подсистемы Организации
//
Процедура ПриЗаполненииРеквизитовОрганизации(Организация, Реквизиты, СтандартнаяОбработка) Экспорт

	Если ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") И ЗначениеЗаполнено(Организация) Тогда
		
		РегистрационныеДанные = Новый Структура(); 
		ОрганизационнаяСтруктура.ПриОпределенииРегистрационныхДанныхРуководителяОрганизации(Организация, Неопределено, Неопределено, РегистрационныеДанные);
		
		Реквизиты.ЛицоБезДоверенности = РегистрационныеДанные.РуководительФизЛицоСсылка; 
		
		Если ЗначениеЗаполнено(Реквизиты.ЛицоБезДоверенности) Тогда
			РеквизитыЛицаБезДоверенности = МашиночитаемыеДоверенностиФНС.РеквизитыПредставителяОрганизации(
			Реквизиты.ЛицоБезДоверенности, Ложь, РегистрационныеДанные.РуководительДолжностьНаименование);
			МашиночитаемыеДоверенностиФНСПереопределяемый.ПриЗаполненииРеквизитовФизическогоЛица(Реквизиты.ЛицоБезДоверенности, РеквизитыЛицаБезДоверенности);
			Реквизиты.РеквизитыЛицаБезДоверенности = РеквизитыЛицаБезДоверенности;
		КонецЕсли; 
		
    КонецЕсли;
	
КонецПроцедуры

// Вызывается в форме машиночитаемой доверенности для заполнения реквизитов физического лица при выборе доверителя и представителя,
// если выбран вид представителя/доверителя "Физическое лицо".
// 
// Параметры:
//  ФизическоеЛицо - ОпределяемыйТип.ФизическоеЛицо - ссылка на физлицо, реквизиты которого надо заполнить.
//  Реквизиты - Структура:
//             =  * ЭтоИндивидуальныйПредприниматель - Булево
//             =  * ЭтоФизическоеЛицо - Булево
//               * ЭтоДолжностноеЛицо - Булево
//               * ДолжностьЛицаДоверителя - Строка
//             =  * Фамилия - Строка
//             =  * Имя - Строка
//             =  * Отчество - Строка
//             =  * Пол - Число - 1 - мужской, 2 - женский
//             =  * ИННФЛ - Строка
//             =  * СтраховойНомерПФР - Строка
//             =  * АдресРегистрации - Строка
//             =  * АдресРегистрацииЗначение - Строка - в формате JSON, как его возвращает
//                  функция КонтактнаяИнформацияОбъекта общего модуля УправлениеКонтактнойИнформацией.
//             =  * ЭлектроннаяПочта - Строка
//             =  * ЭлектроннаяПочтаЗначение - Строка - в формате JSON, как его возвращает
//                  функция КонтактнаяИнформацияОбъекта общего модуля УправлениеКонтактнойИнформацией.
//             =  * Телефон - Строка
//             =  * ТелефонЗначение - Строка - в формате JSON, как его возвращает
//                  функция КонтактнаяИнформацияОбъекта общего модуля УправлениеКонтактнойИнформацией.
//             =  * ДатаРождения - Дата
//             =  * ДокументВид - Строка
//             =  * ДокументНомер - Строка
//             =  * ДокументКемВыдан - Строка
//             =  * ДокументДатаВыдачи - Строка
//             =  * ДокументКодПодразделения - Строка
//             =  * ДокументСрокДействия - Строка
//             =  * Гражданство - СправочникСсылка.СтраныМира
//             =  * БезГражданства - Булево
//             =  * МестоРождения - Строка
//               * НомерЗаписиЕдиногоРегистраНаселения - Строка
//
Процедура ПриЗаполненииРеквизитовФизическогоЛица(ФизическоеЛицо, Реквизиты) Экспорт
	
	Если ТипЗнч(ФизическоеЛицо) = Тип("СправочникСсылка.ФизическиеЛица") И ЗначениеЗаполнено(ФизическоеЛицо) Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	ФизическиеЛица.Ссылка КАК Ссылка,
		|	ФизическиеЛица.ДатаРождения КАК ДатаРождения,
		|	ФизическиеЛица.ИНН КАК ИНН,
		|	ФизическиеЛица.НомерПолисаОМС КАК НомерПолисаОМС,
		|	ФизическиеЛица.ОГРНИП КАК ОГРНИП,
		|	ФизическиеЛица.Пол КАК Пол,
		|	ВЫБОР ФизическиеЛица.Пол
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Женский)
		|			ТОГДА 2
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Мужской)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПолЧислом,
		|	ФизическиеЛица.СтраховойНомерПФР КАК СтраховойНомерПФР,
		|	ФизическиеЛица.СтранаРегистрации КАК СтранаРегистрации,
		|	ФизическиеЛица.МестоРождения КАК МестоРождения,
		|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Фамилия, НЕОПРЕДЕЛЕНО) КАК Фамилия,
		|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Имя, НЕОПРЕДЕЛЕНО) КАК Имя,
		|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Отчество, НЕОПРЕДЕЛЕНО) КАК Отчество,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Представление, НЕОПРЕДЕЛЕНО) КАК УдостоверениеЛичности,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Серия, НЕОПРЕДЕЛЕНО) КАК Серия,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Номер, НЕОПРЕДЕЛЕНО) КАК Номер,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.ДатаВыдачи, НЕОПРЕДЕЛЕНО) КАК ДатаВыдачи,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.СрокДействия, НЕОПРЕДЕЛЕНО) КАК СрокДействия,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.КемВыдан, НЕОПРЕДЕЛЕНО) КАК КемВыдан,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.КодПодразделения, НЕОПРЕДЕЛЕНО) КАК КодПодразделения,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.ВидДокумента, ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПустаяСсылка)) КАК ВидДокумента,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.ВидДокумента.КодФНС, НЕОПРЕДЕЛЕНО) КАК КодВидаДокумента,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.ВидДокумента.Наименование, НЕОПРЕДЕЛЕНО) КАК ВидДокументаНаименование,
		|	ВЫБОР
		|		КОГДА ГражданствоФизическихЛицСрезПоследних.Страна ЕСТЬ NULL
		|				ИЛИ ГражданствоФизическихЛицСрезПоследних.Страна = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
		|		ИНАЧЕ ГражданствоФизическихЛицСрезПоследних.Страна
		|	КОНЕЦ КАК Гражданство
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&Период, ФизическоеЛицо = &ФизическиеЛица) КАК ФИОФизическихЛицСрезПоследних
		|		ПО ФизическиеЛица.Ссылка = ФИОФизическихЛицСрезПоследних.ФизическоеЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(&Период, Физлицо = &ФизическиеЛица) КАК ДокументыФизическихЛицСрезПоследних
		|		ПО ФизическиеЛица.Ссылка = ДокументыФизическихЛицСрезПоследних.Физлицо
		|			И (ДокументыФизическихЛицСрезПоследних.ЯвляетсяДокументомУдостоверяющимЛичность)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГражданствоФизическихЛиц.СрезПоследних(&Период, ФизическоеЛицо = &ФизическиеЛица) КАК ГражданствоФизическихЛицСрезПоследних
		|		ПО ФизическиеЛица.Ссылка = ГражданствоФизическихЛицСрезПоследних.ФизическоеЛицо
		|ГДЕ
		|	ФизическиеЛица.Ссылка = &ФизическиеЛица");
		
		Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("ФизическиеЛица", ФизическоеЛицо);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Реквизиты.Вставить("ЭтоФизическоеЛицо", Истина);
            Реквизиты.Вставить("Фамилия", Выборка.Фамилия);
			Реквизиты.Вставить("Имя", Выборка.Имя);
			Реквизиты.Вставить("Отчество", Выборка.Отчество);
			Реквизиты.Вставить("Пол", Выборка.ПолЧислом);
			Реквизиты.Вставить("ИННФЛ", ?(ЗначениеЗаполнено(Выборка.ИНН), Выборка.ИНН, Неопределено));
			Реквизиты.Вставить("СтраховойНомерПФР", ?(ЗначениеЗаполнено(Выборка.СтраховойНомерПФР), Выборка.СтраховойНомерПФР, Неопределено));
			Реквизиты.Вставить("ДатаРождения", ?(ЗначениеЗаполнено(Выборка.ДатаРождения), Выборка.ДатаРождения, Неопределено)); 
			Реквизиты.Вставить("ДокументВид", Выборка.КодВидаДокумента);
			Если ЗначениеЗаполнено(Выборка.Серия) ИЛИ ЗначениеЗаполнено(Выборка.Номер) Тогда
				Реквизиты.Вставить("ДокументНомер", Строка(Выборка.Серия) + " " + Строка(Выборка.Номер));
			КонецЕсли;
			Реквизиты.Вставить("ДокументКемВыдан", Выборка.КемВыдан);
			Реквизиты.Вставить("ДокументДатаВыдачи", Выборка.ДатаВыдачи);
			Реквизиты.Вставить("ДокументКодПодразделения", Выборка.КодПодразделения);
			Реквизиты.Вставить("ДокументСрокДействия", Выборка.СрокДействия);
			Реквизиты.Вставить("Гражданство", Выборка.Гражданство); 
			Реквизиты.Вставить("БезГражданства", НЕ ЗначениеЗаполнено(Выборка.Гражданство));
			Реквизиты.Вставить("МестоРождения", ?(ЗначениеЗаполнено(Выборка.МестоРождения), Выборка.МестоРождения, Неопределено));  
			Реквизиты.Вставить("ЭтоИндивидуальныйПредприниматель", ЗначениеЗаполнено(Выборка.ОГРНИП));
			
			Контакты = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ФизическоеЛицо,,, Ложь); 
			ОтборКИ = Новый Структура("Вид"); 
			
			ОтборКИ.Вид = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица");
			Контакт = Контакты.НайтиСтроки(ОтборКИ);
			Если Контакт.Количество() > 0 Тогда 
				Реквизиты.Вставить("АдресРегистрации", Контакт[0].Представление);
				Реквизиты.Вставить("АдресРегистрацииЗначение", Контакт[0].Значение);
			КонецЕсли;   
			
			ОтборКИ.Вид = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.EmailФизическиеЛица");
			Контакт = Контакты.НайтиСтроки(ОтборКИ);
			Если Контакт.Количество() > 0 Тогда 
				Реквизиты.Вставить("ЭлектроннаяПочта", Контакт[0].Представление);
				Реквизиты.Вставить("ЭлектроннаяПочтаЗначение", Контакт[0].Значение);
			КонецЕсли; 
			
			ОтборКИ.Вид = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица");
			Контакт = Контакты.НайтиСтроки(ОтборКИ);
			Если Контакт.Количество() > 0 Тогда 
				Реквизиты.Вставить("Телефон", Контакт[0].Представление);
				Реквизиты.Вставить("ТелефонЗначение", Контакт[0].Значение);
			КонецЕсли;
			
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

// Вызывается в форме машиночитаемой доверенности для заполнения реквизитов контрагента при выборе доверителя и представителя,
// если выбран вид представителя/доверителя "Контрагент".
// 
// Параметры:
//  Контрагент - ОпределяемыйТип.Контрагент - ссылка на контрагента, реквизиты которого надо заполнить.
//  Реквизиты - см. ПриЗаполненииРеквизитовОрганизации.Реквизиты
//
Процедура ПриЗаполненииРеквизитовКонтрагента(Контрагент, Реквизиты) Экспорт
	
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Контрагент) Тогда
		
		РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "ЮридическоеФизическоеЛицо,ИНН,КПП,Наименование,НаименованиеСокращенное");
		
		Реквизиты.ИНН = РеквизитыКонтрагента.ИНН;
		Реквизиты.КПП = РеквизитыКонтрагента.КПП; 
		Реквизиты.НаименованиеСокращенное = РеквизитыКонтрагента.НаименованиеСокращенное; 
		
		Если ТипЗнч(РеквизитыКонтрагента.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") 
			И ЗначениеЗаполнено(РеквизитыКонтрагента.ЮридическоеФизическоеЛицо) Тогда
			РеквизитыЮрЛица = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыКонтрагента.ЮридическоеФизическоеЛицо, "НаименованиеПолное,ОГРН");
			Реквизиты.ОГРН = РеквизитыЮрЛица.ОГРН;
			Реквизиты.НаименованиеПолное = РеквизитыЮрЛица.НаименованиеПолное;
		КонецЕсли;
		
		Если ТипЗнч(РеквизитыКонтрагента.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ФизическиеЛица") 
			И ЗначениеЗаполнено(РеквизитыКонтрагента.ЮридическоеФизическоеЛицо) Тогда
			РеквизитыФизЛица = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыКонтрагента.ЮридическоеФизическоеЛицо, "ОГРНИП");
			Реквизиты.ОГРН = РеквизитыФизЛица.ОГРНИП;
			Реквизиты.НаименованиеПолное = РеквизитыКонтрагента.Наименование;
			Реквизиты.ЭтоИндивидуальныйПредприниматель = ЗначениеЗаполнено(РеквизитыФизЛица.ОГРНИП);
		КонецЕсли;

		Если ЗначениеЗаполнено(РеквизитыКонтрагента.ЮридическоеФизическоеЛицо) Тогда
			
			Контакты = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(РеквизитыКонтрагента.ЮридическоеФизическоеЛицо,,, Ложь); 
			ОтборКИ = Новый Структура("Вид"); 
			
			ОтборКИ.Вид = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица");
			Контакт = Контакты.НайтиСтроки(ОтборКИ);
			Если Контакт.Количество() > 0 Тогда 
				Реквизиты.Вставить("ЮридическийАдрес", Контакт[0].Представление);
				Реквизиты.Вставить("ЮридическийАдресЗначение", Контакт[0].Значение);
			КонецЕсли;   

		    ОтборКИ.Вид = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты");
			Контакт = Контакты.НайтиСтроки(ОтборКИ);
			Если Контакт.Количество() > 0 Тогда 
				Реквизиты.Вставить("ЮридическийАдрес", Контакт[0].Представление);
				Реквизиты.Вставить("ЮридическийАдресЗначение", Контакт[0].Значение);
			КонецЕсли;  
		КонецЕсли;	
			
	КонецЕсли;	
	
КонецПроцедуры

