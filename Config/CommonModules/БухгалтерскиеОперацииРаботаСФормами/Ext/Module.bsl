
#Область СлужебныйПрограммныйИнтерфейс

Функция ПустоеДеревоЭлементовФормы() Экспорт

	// используемые типы
	ТипыГруппировок = Новый Массив;
	ТипыГруппировок.Добавить(Тип("ГруппировкаПодчиненныхЭлементовФормы"));
	ТипыГруппировок.Добавить(Тип("ГруппировкаКолонок"));
	ОписаниеТипаГруппировок = Новый ОписаниеТипов(ТипыГруппировок);
	
	ТипСтрока                           = Новый ОписаниеТипов("Строка");
	ТипБулево                           = Новый ОписаниеТипов("Булево");
	ТипЧисло                            = Новый ОписаниеТипов("Число");
	ТипОписаниеТипов                    = Новый ОписаниеТипов("ОписаниеТипов");
	ТипНеопределено                     = Новый ОписаниеТипов("Неопределено");
	ТипФорматированнаяСтрока            = Новый ОписаниеТипов("ФорматированнаяСтрока");
	ТипОтображениеПодсказки             = Новый ОписаниеТипов("ОтображениеПодсказки");
	ТипСквозноеВыравнивание             = Новый ОписаниеТипов("СквозноеВыравнивание");
	ТипВыравниваниеЭлементовИЗаголовков = Новый ОписаниеТипов("ВыравниваниеЭлементовИЗаголовков");
	ТипГоризонтальноеПоложениеЭлемента  = Новый ОписаниеТипов("ГоризонтальноеПоложениеЭлемента");
	ТипВертикальноеПоложениеЭлемента    = Новый ОписаниеТипов("ВертикальноеПоложениеЭлемента");
	ТипПоложениеЗаголовкаЭлементаФормы  = Новый ОписаниеТипов("ПоложениеЗаголовкаЭлементаФормы");
	ТипПроверкаЗаполнения               = Новый ОписаниеТипов("ПроверкаЗаполнения");
	ТипМассив                           = Новый ОписаниеТипов("Массив");
	ТипЦвет                             = Новый ОписаниеТипов("Цвет");
	
	// описание дерева
	Результат = Новый ДеревоЗначений;
	Колонки = Результат.Колонки;
	// общие свойства
	Колонки.Добавить("ИмяДляФормулы",                      ТипСтрока);
	Колонки.Добавить("Имя",                                ТипСтрока);
	Колонки.Добавить("ИмяЭлемента",                        ТипСтрока);
	Колонки.Добавить("Заголовок",                          ТипСтрока);
	Колонки.Добавить("ТипЭлемента",                        ТипОписаниеТипов);
	Колонки.Добавить("ВидЭлемента",                        ТипНеопределено);
	Колонки.Добавить("Валютный",                           ТипБулево);
	Колонки.Добавить("Подсказка",                          ТипСтрока);
	Колонки.Добавить("НеПовторять",                        ТипБулево);
	Колонки.Добавить("ПереопределенныйРеквизит",           ТипБулево);
	Колонки.Добавить("РасширеннаяПодсказка",               ТипФорматированнаяСтрока);
	Колонки.Добавить("ОтображениеПодсказки",               ТипОтображениеПодсказки);
	Колонки.Добавить("РастягиватьПоГоризонтали",           ТипНеопределено);
	// реквизиты команды
	Колонки.Добавить("Действие",                           ТипСтрока);
	Колонки.Добавить("ИмяКартинки",                        ТипСтрока);
	// реквизиты группы
	Колонки.Добавить("ОтображатьЗаголовок",                ТипБулево);
	Колонки.Добавить("Группировка",                        ОписаниеТипаГруппировок);
	Колонки.Добавить("Отображение",                        ТипСтрока);
	Колонки.Добавить("Объединенная",                       ТипБулево);
	Колонки.Добавить("СквозноеВыравнивание",               ТипСквозноеВыравнивание);
	Колонки.Добавить("ВыравниваниеЭлементовИЗаголовков",   ТипВыравниваниеЭлементовИЗаголовков);
	Колонки.Добавить("ГоризонтальноеПоложениеВГруппе",     ТипГоризонтальноеПоложениеЭлемента);
	Колонки.Добавить("ВертикальноеПоложениеВГруппе",       ТипВертикальноеПоложениеЭлемента);
	Колонки.Добавить("ГоризонтальноеПоложениеПодчиненных", ТипГоризонтальноеПоложениеЭлемента);
	Колонки.Добавить("ВертикальноеПоложениеПодчиненных",   ТипВертикальноеПоложениеЭлемента);
	Колонки.Добавить("РастягиватьПоВертикали",             ТипНеопределено);
	// реквизиты элемента
	Колонки.Добавить("ТипЗначения",                        ТипОписаниеТипов);
	Колонки.Добавить("Реквизит",                           ТипСтрока);
	Колонки.Добавить("Путь",                               ТипСтрока);
	Колонки.Добавить("СвязиПараметровВыбора",              ТипНеопределено);
	Колонки.Добавить("СвязиПоТипу",                        ТипСтрока);
	Колонки.Добавить("СтруктураСвязиПоТипу",               ТипНеопределено);
	Колонки.Добавить("ПараметрыВыбора",                    ТипМассив);
	Колонки.Добавить("ПоложениеЗаголовка",                 ТипПоложениеЗаголовкаЭлементаФормы);
	Колонки.Добавить("ЦветФона",                           ТипЦвет);
	Колонки.Добавить("ШиринаЭлемента",                     ТипЧисло);
	Колонки.Добавить("ФункциональныеОпции",                ТипМассив);
	Колонки.Добавить("ТолькоЧтение",                       ТипБулево);
	Колонки.Добавить("Видимость",                          ТипБулево);
	Колонки.Добавить("АвтоМаксимальнаяШирина",             ТипБулево);
	Колонки.Добавить("МаксимальнаяШирина",                 ТипЧисло);
	Колонки.Добавить("ВысотаЗаголовка",                    ТипЧисло);
	Колонки.Добавить("ПроверкаВвода",                      ТипПроверкаЗаполнения);
	Колонки.Добавить("ПодсказкаВвода",                     ТипСтрока);
	Колонки.Добавить("ПодсказкаРастягиватьПоГоризонтали",  ТипНеопределено);
	Колонки.Добавить("ПодсказкаРастягиватьПоВертикали",    ТипНеопределено);
	Колонки.Добавить("ПодсказкаАвтоМаксимальнаяШирина",    ТипБулево);
	Колонки.Добавить("ПодсказкаМаксимальнаяШирина",        ТипЧисло);
	Колонки.Добавить("СписокВыбора",                       Новый ОписаниеТипов("СписокЗначений"));
	// подключаемые процедуры элемента
	Колонки.Добавить("НачалоВыбора",                       ТипСтрока);
	Колонки.Добавить("ПриИзменении",                       ТипСтрока);
	// доп. колонки
	Колонки.Добавить("ИмяТаблицы",                         ТипСтрока);
	Колонки.Добавить("ПредопределеннаяТЧ",                 ТипБулево);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьРеквизитыЭлементыНаФорму(ПараметрыДобавленияЭлементовФормы) Экспорт
	
	Форма                          = ПараметрыДобавленияЭлементовФормы.Форма;
	Объект                         = ПараметрыДобавленияЭлементовФормы.Объект;
	ТипЗначенияСсылки              = ПараметрыДобавленияЭлементовФормы.ТипЗначенияСсылки;
	ПолеДляРеквизитовОперации      = ПараметрыДобавленияЭлементовФормы.ПолеДляРеквизитовОперации;
	ПолеДляДополнительныхТабЧастей = ПараметрыДобавленияЭлементовФормы.ПолеДляДополнительныхТабЧастей;
	ДобавлятьДопТабЧасти           = ПараметрыДобавленияЭлементовФормы.ДобавлятьДопТабЧасти;
	ТиповаяОперация                = ПараметрыДобавленияЭлементовФормы.ТиповаяОперация;
	ПовторноеЧтениеОбъекта         = ПараметрыДобавленияЭлементовФормы.ПовторноеЧтениеОбъекта;
	РеквизитыФормы                 = ПараметрыДобавленияЭлементовФормы.РеквизитыФормы;
	ВалютныйУчет                   = ПараметрыДобавленияЭлементовФормы.ВалютныйУчет;
	ПредварительныйПросмотр        = ПараметрыДобавленияЭлементовФормы.ПредварительныйПросмотр;
	
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗначенияСсылки);
	
	Если ЗначениеЗаполнено(РеквизитыФормы) Тогда
		РеквизитыФормыСтруктурой = Новый Структура(СтрСоединить(РеквизитыФормы,","));
	Иначе
		РеквизитыФормыСтруктурой = Новый Структура;
	КонецЕсли;
	
	// проверить необходимость вывода поля "Типовая операция"
	Если ПараметрыДобавленияЭлементовФормы.ДобавлятьДопРеквизитыОперации Тогда
		
		Если Не ЗначениеЗаполнено(ТиповаяОперация) Тогда
			Если НЕ Справочники.ТиповыеОперации.ЕстьТиповаяОперацияВидаДокумента(ИдентификаторДокумента) Тогда
				// В справочнике нет типовых операций для этого документа. Не выводим поле типовой операции.
				ПараметрыДобавленияЭлементовФормы.ДобавлятьДопРеквизитыОперации = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// получить переопределенные реквизиты, которые не добавляются на форму,
	// а отображаются в имеющиеся реквизиты/колонки/таблицы
	ПереопределенныеРеквизиты = Новый ТаблицаЗначений;
	ПереопределенныеРеквизиты.Колонки.Добавить("ИмяДляФормулы", Новый ОписаниеТипов("Строка"));
	ПереопределенныеРеквизиты.Колонки.Добавить("ИмяРеквизита",  Новый ОписаниеТипов("Строка"));
	ПереопределенныеРеквизиты.Колонки.Добавить("ИмяЭлемента",   Новый ОписаниеТипов("Строка"));
	
	// сформировать дерево добавляемых элементов формы
	ДеревоЭлементовФормы = ПустоеДеревоЭлементовФормы();
	
	Если ПараметрыДобавленияЭлементовФормы.ДобавлятьДопРеквизитыОперации Тогда
		
		Если РеквизитыФормыСтруктурой.Свойство("ТиповыеОперации_ПереопределенныеРеквизиты")
			И ТипЗнч(Форма["ТиповыеОперации_ПереопределенныеРеквизиты"]) = Тип("СписокЗначений") Тогда
			// задан список переопределенных реквизитов формы
			Для каждого ОписаниеПереопределенногоРеквизита Из Форма["ТиповыеОперации_ПереопределенныеРеквизиты"] Цикл
				
				ЭлементФормы = Форма.Элементы.Найти(ОписаниеПереопределенногоРеквизита.Значение);
				Если ЭлементФормы <> Неопределено Тогда
					ПереопределенныйРеквизит = ПереопределенныеРеквизиты.Добавить();
					ПереопределенныйРеквизит.ИмяДляФормулы = ВРЕГ(ОписаниеПереопределенногоРеквизита.Представление);
					СоставПутиКДанным = СтрРазделить(ЭлементФормы.ПутьКДанным, ".");
					Если СоставПутиКДанным.Количество() = 3 Тогда
						// реквизит физической табличной части
						ПереопределенныйРеквизит.ИмяРеквизита = СоставПутиКДанным[2];
					ИначеЕсли СоставПутиКДанным.Количество() = 2 Тогда
						// реквизит виртуальной табличной части
						ПереопределенныйРеквизит.ИмяРеквизита = СоставПутиКДанным[1];
					Иначе
						ПереопределенныйРеквизит.ИмяРеквизита = ЭлементФормы.ПутьКДанным;
					КонецЕсли;
					ПереопределенныйРеквизит.ИмяЭлемента = ЭлементФормы.Имя;
				КонецЕсли;
			
			КонецЦикла;
		КонецЕсли;
		ПереопределенныеРеквизиты.Индексы.Добавить("ИмяДляФормулы");
	
		ДеревоЭлементовТиповойОперации = ДеревоЭлементовТиповойОперации(ТиповаяОперация, ИдентификаторДокумента, НЕ ПредварительныйПросмотр);
		ДобавитьИзДереваВДерево(ДеревоЭлементовТиповойОперации, ДеревоЭлементовФормы, ПереопределенныеРеквизиты);
		
	КонецЕсли;
	
	Если ДобавлятьДопТабЧасти Тогда
		
		ДеревоЭлементовДополнительныхТабличныхЧастей = ДеревоЭлементовДополнительныхТабличныхЧастей(ИдентификаторДокумента);
		ДобавитьИзДереваВДерево(ДеревоЭлементовДополнительныхТабличныхЧастей, ДеревоЭлементовФормы, ПереопределенныеРеквизиты);
		
	КонецЕсли;
	
	// существующие реквизиты используются чтобы ловить конфликты имени физического реквизита и добавляемого
	// в случае конфликтов возможна неправильная интерпретация данных при формировании проводок
	СуществующиеРеквизитыФормы = Новый Соответствие;
	СуществующиеРеквизитыФормы.Вставить("ЭтотОбъект", БухгалтерскиеОперацииСервер.ПолучитьИменаРеквизитовФормы(Форма, "", Истина));
	Для каждого ЭлементДерева Из ДеревоЭлементовФормы.Строки Цикл
	
		Если ЭлементДерева.ВидЭлемента = Неопределено И ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(
				ЭлементДерева.ТипЭлемента, Тип("ТаблицаФормы")) Тогда
				
			Если РеквизитыФормыСтруктурой.Свойство(ЭлементДерева.Имя) Тогда
				Если ЭлементДерева.ПредопределеннаяТЧ <> Истина Тогда 
					СуществующиеРеквизитыФормы.Вставить(ВРЕГ(ЭлементДерева.Имя), Новый Массив);
				Иначе
					ПолноеИмяТЧ = "Объект." + ЭлементДерева.Имя;
					СуществующиеРеквизитыФормы.Вставить(ВРЕГ(ПолноеИмяТЧ), БухгалтерскиеОперацииСервер.ПолучитьИменаРеквизитовФормы(Форма, ПолноеИмяТЧ, Истина));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	// заполнить таблицу добавляемых реквизитов/доп. колонок
	ДобавленныеРеквизитыОперации = ПустаяТаблицаДобавленныхРеквизитовОперации();
	
	ПараметрыПроверкиРеквизитов = Новый Структура;
	ПараметрыПроверкиРеквизитов.Вставить("ВалютныйУчет",                 ВалютныйУчет);
	ПараметрыПроверкиРеквизитов.Вставить("ПовторноеЧтениеОбъекта",       ПовторноеЧтениеОбъекта);
	ПараметрыПроверкиРеквизитов.Вставить("ДобавленныеРеквизитыОперации", ДобавленныеРеквизитыОперации);
	ПараметрыПроверкиРеквизитов.Вставить("ДобавляемыеРеквизиты",         Новый Массив);
	ПараметрыПроверкиРеквизитов.Вставить("УдаляемыеРеквизиты",           Новый Массив);
	ПараметрыПроверкиРеквизитов.Вставить("СуществующиеРеквизитыФормы",   СуществующиеРеквизитыФормы);
	ПараметрыПроверкиРеквизитов.Вставить("КонфликтыИменРеквизитов",      Новый СписокЗначений);
	
	ПроверитьДобавляемыеРеквизитыРекурсивно(ДеревоЭлементовФормы, ПараметрыПроверкиРеквизитов);
		
	КонфликтыИменРеквизитов = ПараметрыПроверкиРеквизитов.КонфликтыИменРеквизитов;
	
	// изменить реквизиты формы
	ДобавляемыеРеквизиты = ПараметрыПроверкиРеквизитов.ДобавляемыеРеквизиты;
	Если Не ПовторноеЧтениеОбъекта Тогда
		ДобавитьОбязательныеРеквизиты(ДобавляемыеРеквизиты);
	КонецЕсли;
	УдаляемыеРеквизиты = Новый Массив;
	Если ПовторноеЧтениеОбъекта Тогда
		Для каждого ОписаниеДопРеквизита Из Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"] Цикл
		
			Если НЕ ОписаниеДопРеквизита.ЭтоГруппа
				И НЕ ОписаниеДопРеквизита.НеПовторять
				И ЗначениеЗаполнено(ОписаниеДопРеквизита.ИмяРеквизита) Тогда
				
				Если НЕ ОписаниеДопРеквизита.ПереопределенныйРеквизит Тогда
					УдаляемыеРеквизиты.Добавить(ОписаниеДопРеквизита.ИмяРеквизита);
				КонецЕсли;
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	Если ДобавляемыеРеквизиты.Количество() > 0 ИЛИ УдаляемыеРеквизиты.Количество() > 0 Тогда
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);
	КонецЕсли;
	
	Если НЕ ДобавлятьДопТабЧасти Тогда
		// если ранее были добавлены реквизиты таб. частей, то данных о них над переписать в новую таблицу
		Для каждого СтрокаРеквизита Из Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"] Цикл
		
			Если ЗначениеЗаполнено(СтрокаРеквизита.ИмяТаблицы) Тогда
				ЗаполнитьЗначенияСвойств(ДобавленныеРеквизитыОперации.Добавить(), СтрокаРеквизита);
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"].Загрузить(ДобавленныеРеквизитыОперации);
	
	// изменить элементы формы
	
	Для каждого ОписаниеРеквизита Из ПереопределенныеРеквизиты Цикл
		
		ВидимостьЭлемента = ДобавленныеРеквизитыОперации.Найти(ОписаниеРеквизита.ИмяЭлемента, "ИмяЭлемента") <> Неопределено;
			
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			ОписаниеРеквизита.ИмяЭлемента, "Видимость", ВидимостьЭлемента);
		
	КонецЦикла; 
	
	Если ПовторноеЧтениеОбъекта Тогда
		УдалитьДобавленныеЭлементыФормыПриПовторномЧтении(Форма,
			Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"], ПолеДляРеквизитовОперации)
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПовторноеЧтениеОбъекта",         ПовторноеЧтениеОбъекта);
	ДополнительныеПараметры.Вставить("ВалютныйУчет",                   ВалютныйУчет);
	ДополнительныеПараметры.Вставить("ПолеДляДополнительныхТабЧастей", ПолеДляДополнительныхТабЧастей);
	ДополнительныеПараметры.Вставить("КонфликтыИменРеквизитов",        КонфликтыИменРеквизитов);
	ДополнительныеПараметры.Вставить("ДеревоЭлементов",                ДеревоЭлементовФормы);
	ДополнительныеПараметры.Вставить("ТиповаяОперация",                ТиповаяОперация);
	
	ОбновитьЭлементыФормы(Форма, ДеревоЭлементовФормы, ПолеДляРеквизитовОперации, ДополнительныеПараметры);
	ДополнительныеПараметры = Неопределено;
	
	// заполнить служебные реквизиты формы
	ПризнакФормированияПроводокАвтоматически = ПолучитьФункциональнуюОпцию("ФормированиеПроводокПриПроведенииДокумента");
	Форма["БухгалтерскиеОперации_ПризнакФормированияПроводокАвтоматически"] = ПризнакФормированияПроводокАвтоматически;
	
	Если Не ПовторноеЧтениеОбъекта Тогда
		ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(Форма, Объект, ТиповаяОперация);
	КонецЕсли;
	
	Если ВалютныйУчет И ПризнакФормированияПроводокАвтоматически Тогда
		Форма.КэшПараметров.Служебные.ОбновлятьКурсВалютыАвтоматически = Истина;
	КонецЕсли;
	
	Форма["БухгалтерскиеОперации_СписокЗависимыхЭлементов"] = ПолучитьСписокСвязанныхРеквизитов(ТиповаяОперация, ИдентификаторДокумента.Имя, ДобавленныеРеквизитыОперации);
	Форма["СписокЭлементовСКонфликтамиИмен"] = КонфликтыИменРеквизитов;
	
	Если Не ПовторноеЧтениеОбъекта И НЕ ПредварительныйПросмотр Тогда
		Форма["БухгалтерскиеОперации_ИмяГруппыЭлементовТиповойОперации"] = ПолеДляРеквизитовОперации.Имя;
	КонецЕсли;
	
	Если ПризнакФормированияПроводокАвтоматически
		И Не ПовторноеЧтениеОбъекта
		И ПараметрыДобавленияЭлементовФормы.ДобавлятьДопРеквизитыОперации Тогда
		
		ДобавитьКомандыУправленияТиповымиОперациями(Форма);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДеревоЭлементовФормыТиповойОперации(ТиповаяОперация, ИдентификаторДокумента) Экспорт
	
	ДокументыБезКнопкиПросмотра = БухгалтерскиеОперацииСервер.ДокументыФормирующиеПроводкиВсегдаОдновременно();
	ДокументыБезКнопкиПросмотра.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.ОперацияБух")));
	
	Результат = ПустоеДеревоЭлементовФормы();
	
	КнопкаПредварительныйПросмотра = ПолучитьФункциональнуюОпцию("ФормированиеПроводокПриПроведенииДокумента")
		И ДокументыБезКнопкиПросмотра.Найти(ИдентификаторДокумента) = Неопределено;
	ДобавитьЭлементыФормыТиповойОперации(Результат, ИдентификаторДокумента, КнопкаПредварительныйПросмотра,
		БухгалтерскийУчет.ПоДокументуВозможноИсправлениеОшибок(ИдентификаторДокумента));
	
	Если ЗначениеЗаполнено(ТиповаяОперация) Тогда
		ДополнитьДеревоЭлементовТиповойОперацииДополнительнымиРеквизитами(Результат, ТиповаяОперация);
		ДобавитьОтветственногоИсполнителя(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Видимость команды предварительного просмотра операции.
// 
// Параметры:
//  Ссылка - ДокументСсылка
// 
// Возвращаемое значение:
//  Булево - Видимость команды предварительного просмотра операции
Функция ВидимостьКомандыПредварительногоПросмотраОперации(Ссылка) Экспорт

	Если Ссылка.Пустая() Тогда
		Видимость = Истина;
	Иначе
		УстановитьПривилегированныйРежим(Истина);	
		ДокументПроведен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен");
		УстановитьПривилегированныйРежим(Ложь);

		Если НЕ ДокументПроведен Тогда
			Видимость = Истина;
		Иначе
			Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Видимость;
	
КонецФункции

Функция ВидимостьПоФункциональнымОпциям(Форма, ПереданныеФО) Экспорт

	Если Не ЗначениеЗаполнено(ПереданныеФО) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(ПереданныеФО) = Тип("Массив") Тогда
		МассивФО = ПереданныеФО;
	Иначе
		МассивФО = СтрРазделить(ПереданныеФО, ",");
	КонецЕсли;
	
	Для каждого ТекФО Из МассивФО Цикл
		Если Форма.ПолучитьФункциональнуюОпциюФормы(ТекФО) = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	// функциональные опции заданы, но ни одна не равна истине
	Возврат Ложь;

КонецФункции

Функция ШаблонСвойствЭлементаФормы(ЭтоГруппа) Экспорт

	ШаблонЗаполнения = Новый Структура;

	Если ЭтоГруппа Тогда
		ШаблонЗаполнения.Вставить("ВидГруппы",                          "Обычная группа");
