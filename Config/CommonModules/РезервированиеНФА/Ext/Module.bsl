// @strict-types

#Область ПрограммныйИнтерфейс

// Проверяет, включено ли в базе резервирование сумм МЗ при выбытии.
// 
// Возвращаемое значение:
//  Булево -  Используется резервирование сумм
Функция ИспользуетсяРезервированиеСумм() Экспорт
	Возврат ПолучитьФункциональнуюОпцию("РезервироватьМЗПриВыбытии")
		И ПолучитьФункциональнуюОпцию("РезервироватьСуммуМЗПриВыбытии");
КонецФункции

// При создании на сервере.
// 
// Параметры:
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктура:
//    ** Ссылка - ДокументСсылка
//    ** Проведен - Булево
//    ** Аннулировано - Булево
//    ** Резервировать - Булево
//  * Элементы - ВсеЭлементыФормы:
//   ** ПереключательРезервирование - ПолеВвода
Процедура ПриСозданииНаСервере(Форма) Экспорт

	Если ЭтоТипДокументаРезервированияМЗ(ТипЗнч(Форма.Объект.Ссылка))
		ИЛИ ЭтоТипДокументаРезервированияОС(ТипЗнч(Форма.Объект.Ссылка)) Тогда

		Если ПолучитьФункциональнуюОпцию("РезервироватьМЗПриВыбытии")
			ИЛИ ПолучитьФункциональнуюОпцию("РезервироватьОСПриВыбытии") Тогда
				
			ЗаполнитьСписокВыбораПереключателяРезервирование(Форма.Элементы.ПереключательРезервирование);
			УстановитьОформлениеГруппыРезервирование(Форма);
			ПриСозданииНаСервереДокумента(Форма);
		Иначе
			Объект = Форма.Объект;
			Если Объект.Ссылка.Пустая() Тогда
				ЗначениеРезервировать = Новый Структура("Резервировать", Ложь);
				ЗаполнитьЗначенияСвойств(Объект, ЗначениеРезервировать);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Перед записью.
// 
// Параметры:
//  Объект - ДокументОбъект
//  РежимЗаписи - РежимЗаписиДокумента
//  Отказ - Булево
Процедура ПередЗаписью(Объект, РежимЗаписи, Отказ) Экспорт

	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоТипДокументаРезервированияМЗ(ТипЗнч(Объект.Ссылка))
		И ПолучитьФункциональнуюОпцию("РезервироватьМЗПриВыбытии") Тогда
		
		ПередЗаписьюДокумента(Объект, РежимЗаписи, Отказ);
		СформироватьДвиженияРезервированиеМЗ(Объект, Отказ);
		
	ИначеЕсли ЭтоТипДокументаРезервированияОС(ТипЗнч(Объект.Ссылка))
		И ПолучитьФункциональнуюОпцию("РезервироватьОСПриВыбытии") Тогда
		
		ПередЗаписьюДокумента(Объект, РежимЗаписи, Отказ);
		СформироватьДвиженияРезервированиеОС(Объект, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Это резервирование НФА.
// 
// Параметры:
//  Объект - ДокументОбъект:
//   * Резервировать - Булево
// 
// Возвращаемое значение:
//  Булево
Функция ЭтоРезервированиеНФА(Объект) Экспорт
	Если ЭтоТипДокументаРезервированияМЗ(ТипЗнч(Объект.Ссылка)) 
		И ПолучитьФункциональнуюОпцию("РезервироватьМЗПриВыбытии")
		ИЛИ ЭтоТипДокументаРезервированияОС(ТипЗнч(Объект.Ссылка))
		И ПолучитьФункциональнуюОпцию("РезервироватьОСПриВыбытии") Тогда
		Возврат Объект.Резервировать;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ЭтоТипДокументаРезервированияМЗ(ТипДокумента) Экспорт
	Возврат ТипыДокументовРезервированияМЗ().Получить(ТипДокумента) <> Неопределено;
КонецФункции

Функция ЭтоТипДокументаРезервированияОС(ТипДокумента) Экспорт
	Возврат ТипыДокументовРезервированияОС().Получить(ТипДокумента) <> Неопределено;
КонецФункции

// Списать резерв после формирования проводок.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект
//  ДополнительныеРеквизиты - Структура
//  ТаблицаПроводок - ТаблицаЗначений
Процедура СписатьРезервМЗПослеФормированияПроводок(ДокументОбъект, ДополнительныеРеквизиты, ТаблицаПроводок) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("РезервироватьМЗПриВыбытии")
		Или Не ОбщегоНазначения.ЕстьРеквизитОбъекта("Резервировать", ДокументОбъект.Метаданные()) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДокументОбъект.Резервировать Тогда
		ТаблицаПроводок.Очистить();
		Возврат;
	КонецЕсли;
	
	ДвиженияРезерва = РегистрыНакопления.РезервМЗ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	ДокументОбъект.ДополнительныеСвойства.Вставить("ДвиженияРезервТМЦ", ДвиженияРезерва);
	Если Не ДокументОбъект.Резервировать Тогда
		ДобавитьДвиженияРезервированияМЗТекущегоДокумента(ДокументОбъект, ДвиженияРезерва);
		Если ДвиженияРезерва.Количество() = 0 Тогда
			// Документ не делал резервирование.
			// Значит не нужно делать списание резервов.
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьДвиженияСписанияРезерва(ДвиженияРезерва,
		БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументОбъект.Ссылка));
	
	НаборЗаписей = РегистрыНакопления.РезервМЗ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ДокументОбъект.Ссылка);
	НаборЗаписей.Загрузить(ДвиженияРезерва);
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Списать резерв после формирования проводок.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект
//  ДополнительныеРеквизиты - Структура
//  ТаблицаПроводок - ТаблицаЗначений
Процедура СписатьРезервОСПослеФормированияПроводок(ДокументОбъект, ДополнительныеРеквизиты, ТаблицаПроводок) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("РезервироватьОСПриВыбытии")
		Или Не ОбщегоНазначения.ЕстьРеквизитОбъекта("Резервировать", ДокументОбъект.Метаданные()) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДокументОбъект.Резервировать Тогда
		ТаблицаПроводок.Очистить();
		Возврат;
	КонецЕсли;
	
	ДвиженияРезерва = РегистрыНакопления.РезервОС.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	ДокументОбъект.ДополнительныеСвойства.Вставить("ДвиженияРезервОС", ДвиженияРезерва);
	Если Не ДокументОбъект.Резервировать Тогда
		ДобавитьДвиженияРезервированияОСТекущегоДокумента(ДокументОбъект, ДвиженияРезерва);
		Если ДвиженияРезерва.Количество() = 0 Тогда
			// Документ не делал резервирование.
			// Значит не нужно делать списание резервов.
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьДвиженияСписанияРезерва(ДвиженияРезерва,
		БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументОбъект.Ссылка));
	
	НаборЗаписей = РегистрыНакопления.РезервОС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ДокументОбъект.Ссылка);
	НаборЗаписей.Загрузить(ДвиженияРезерва);
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Заполнить список выбора переключателя резервирование.
// 
// Параметры:
//  ЭлементФормы - ПолеВвода
Процедура ЗаполнитьСписокВыбораПереключателяРезервирование(ЭлементФормы) Экспорт
	ЭлементФормы.СписокВыбора.Очистить();
	ЭлементФормы.СписокВыбора.Добавить(1, НСтр("ru = 'Резервирование'"));
	ЭлементФормы.СписокВыбора.Добавить(0, НСтр("ru = 'Списание'"));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПриСозданииНаСервереДокумента(Форма)
	Объект = Форма.Объект;
	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Аннулирован",
			"Видимость", Ложь);
	КонецЕсли;
КонецПроцедуры

// Перед записью документа.
// 
// Параметры:
//  Объект - ДокументОбъект:
//   * Аннулирован - Булево
//   * Резервировать - Булево
//  РежимЗаписи - РежимЗаписиДокумента - Режим записи
//  Отказ - Булево - Отказ
Процедура ПередЗаписьюДокумента(Объект, РежимЗаписи, Отказ)
	Если Объект.Аннулирован Тогда
		ВызватьИсключение НСтр("ru = 'Аннулированный документ не может быть проведен'");
	КонецЕсли;
КонецПроцедуры

Функция ТипыДокументовРезервированияМЗ()
	Результат = Новый Соответствие; // Соответствие из Тип
	Результат.Вставить(Тип("ДокументСсылка.АктОбУтилизацииМЗ"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.АктСписанияИК"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.АктСписанияМЗ"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаря"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.ВедомостьНаВыдачуМЗНаНуждыУчреждения"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.МенюТребование"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.НакладнаяНаОтпускИК"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.НакладнаяНаОтпускМ15"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗ"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗИК"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.ТребованиеНакладная0315006"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.ТребованиеНакладнаяИК"), Истина);
	Возврат Результат;
КонецФункции

Функция ТипыДокументовРезервированияОС()
	Результат = Новый Соответствие; // Соответствие из Тип
	Результат.Вставить(Тип("ДокументСсылка.АктОбУтилизацииОС"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.АктОбУтилизацииОСИК"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.СписаниеОбъектовОС"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.СписаниеОбъектовИК"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.СписаниеТранспорта"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.СписаниеТранспортаИК"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.ПередачаОбъектовОС"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.ПередачаОбъектовИК"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.СписаниеЛитературы"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивом"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомИК"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.НакладнаяНаВнутреннееПеремещениеОС2"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.ВнутреннееПеремещениеИК"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.ТребованиеНакладнаяОС"), Истина);
	Результат.Вставить(Тип("ДокументСсылка.ВедомостьНаВыдачуОСНаНуждыУчреждения"), Истина);
	Возврат Результат;
КонецФункции

// Сформировать движения резервирование МЗ.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект
//  Отказ - Булево
Процедура СформироватьДвиженияРезервированиеМЗ(ДокументОбъект, Отказ) Экспорт
	
	ДвиженияРезерва = ТаблицаДвиженийРезервТМЦ();
	ДокументОбъект.ДополнительныеСвойства.Вставить("ДвиженияРезервТМЦ", ДвиженияРезерва);
	Если Не ДокументОбъект.Резервировать Тогда
		ДобавитьДвиженияРезервированияМЗТекущегоДокумента(ДокументОбъект, ДвиженияРезерва);
		Если ДвиженияРезерва.Количество() = 0 Тогда
			// Документ не делал резервирование.
			// Значит не нужно делать списание резервов.
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ДокументОбъект.Резервировать Тогда
		// Списание резерва делается в обработчике "После формирования проводок"
		Возврат;
	КонецЕсли;
	
	Параметры = Новый Структура;
	Параметры.Вставить("Ссылка",          ДокументОбъект.Ссылка);
	Параметры.Вставить("Организация",     ДокументОбъект.Организация);
	Параметры.Вставить("Дата",            ДокументОбъект.Дата);
	
	ТаблицаДокумента = УправлениеМатериальнымиЗапасами.ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(
		ДокументОбъект, Параметры, Отказ);
	УправлениеМатериальнымиЗапасами.ДоработатьТаблицуДокументаДляДвиженийРемонт(ДокументОбъект, ТаблицаДокумента);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
		
	// Подготовим таблицу для отражения списания материальных запасов.
	ТаблицаСписания = УправлениеМатериальнымиЗапасами.ТаблицаСписаниеМатериальныхЗапасов(
		ТаблицаДокумента, Параметры, Отказ);
	// Превышение остатка проверяем только по БУ. Такой подход используется во всех типовых операциях по списанию МЗ.
	Если УправлениеМатериальнымиЗапасами.ОстатокПревышенПоТаблицеСписания(ТаблицаСписания, "БУ") Тогда
		Отказ = Истина;
		ТекстИсключения = СтрШаблон(НСтр("ru = 'Не удалось провести ""%1""'"), Строка(ДокументОбъект));
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	// Сохраним таблицу списания для дальнейшего использования
	РассчитанныеДанные = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДокументОбъект.ДополнительныеСвойства,
		"РассчитанныеДанные",
		Новый Структура); // Структура
	РассчитанныеДанные.Вставить("ТаблицаСписания", ТаблицаСписания);
	ДокументОбъект.ДополнительныеСвойства.Вставить("РассчитанныеДанные", РассчитанныеДанные);
	
	ДобавитьДвиженияРезервовПоТаблицеСписания(ДокументОбъект, ТаблицаСписания);
	
КонецПроцедуры

// Сформировать движения резервирование ОС.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект
//  Отказ - Булево
Процедура СформироватьДвиженияРезервированиеОС(ДокументОбъект, Отказ) Экспорт
	
	ДвиженияРезерва = ТаблицаДвиженийРезервОС();
	ДокументОбъект.ДополнительныеСвойства.Вставить("ДвиженияРезервОС", ДвиженияРезерва);
	Если Не ДокументОбъект.Резервировать Тогда
		ДобавитьДвиженияРезервированияОСТекущегоДокумента(ДокументОбъект, ДвиженияРезерва);
		// Списание резерва делается в обработчике "После формирования проводок"
		Возврат;
	КонецЕсли;
	
//	ДокументОбъект.ТаблицаСписанияОСПоДокументу(ДвиженияРезерва);
	ТаблицаДока = ДокументОбъект.ТаблицаСписанияОСПоДокументу();
	Для каждого СтрокаДока из ТаблицаДока Цикл
		СтрокаРезерва = ДвиженияРезерва.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРезерва, СтрокаДока);
		СтрокаРезерва.Период = ДокументОбъект.Дата;
	КонецЦикла;	
КонецПроцедуры

Процедура ДобавитьДвиженияСписанияРезерва(ДвиженияРезерва, ДатаПроведения = '00010101')

	Для Индекс = 0 По ДвиженияРезерва.Количество() - 1 Цикл
		СтрокаРезерва = ДвиженияРезерва[Индекс];
		СписаниеРезерва = ДвиженияРезерва.Добавить();
		ЗаполнитьЗначенияСвойств(СписаниеРезерва, СтрокаРезерва);
		СписаниеРезерва.ВидДвижения = ВидДвиженияНакопления.Расход;
		Если ЗначениеЗаполнено(ДатаПроведения) Тогда
			СписаниеРезерва.Период = ДатаПроведения;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
 

