Функция ТаблицаДвиженийРезервОС()
	Возврат РегистрыНакопления.РезервОС.СоздатьНаборЗаписей().ВыгрузитьКолонки();
КонецФункции

// Добавить движения резервов по таблице списания.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект:
//   * ДополнительныеСвойства - Структура:
//    ** ДвиженияРезервТМЦ - см. ТаблицаДвиженийРезервТМЦ
//  ТаблицаСписания - ТаблицаЗначений
Процедура ДобавитьДвиженияРезервовПоТаблицеСписания(ДокументОбъект, ТаблицаСписания)

	Если ДокументОбъект.Резервировать Тогда
		ВидДвижения = ВидДвиженияНакопления.Приход;
	Иначе
		ВидДвижения = ВидДвиженияНакопления.Расход;
	КонецЕсли;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	РезервироватьСумму = ПолучитьФункциональнуюОпцию("РезервироватьСуммуМЗПриВыбытии");

	Счета106 = Новый Соответствие;
	Для Каждого Счет Из БухгалтерскийУчет.СписокСчетов("106.00") Цикл
		Счета106.Вставить(Счет, Истина);
	КонецЦикла;
	
	ДвиженияРезервТМЦ = ДокументОбъект.ДополнительныеСвойства.ДвиженияРезервТМЦ; // см. ТаблицаДвиженийРезервТМЦ
	Для Каждого СтрокаСписания Из ТаблицаСписания Цикл
		
		Если СтрокаСписания.ВидУчета <> "БУ" Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ РезервироватьСумму И СтрокаСписания.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СвойстваСчетаУчета = УправлениеМатериальнымиЗапасамиПовтИсп.СвойстваСчетаДляУчетаМЗ(СтрокаСписания.СчетУчета,
			СтрокаСписания.ДопАналитикаВидСубконто,
			СтрокаСписания.ДопИзмерениеВидСубконто,
			СтрокаСписания.ПартияВидСубконто);
		
		Если НЕ СвойстваСчетаУчета.ДопАналитикаЕстьСубконто Или СвойстваСчетаУчета.ДопАналитикаТолькоОбороты Тогда
			ИспользоватьДопАналитику = Ложь;
		ИначеЕсли ПолучитьФункциональнуюОпцию("РезервироватьСуммуМЗПриВыбытии") Тогда
			ИспользоватьДопАналитику = СвойстваСчетаУчета.ДопАналитикаСуммовой;
		Иначе
			ИспользоватьДопАналитику = СвойстваСчетаУчета.ДопАналитикаКоличественный
				И ((Счета106.Получить(СтрокаСписания.СчетУчета) <> Неопределено
					И СтрокаСписания.ДопАналитикаВидСубконто <> ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат)
					Или (Счета106.Получить(СтрокаСписания.СчетУчета) = Неопределено
					И СтрокаСписания.ДопАналитикаВидСубконто <> ПланыВидовХарактеристик.ВидыСубконто.Партии));
		КонецЕсли;
		
		НоваяСтрокаДвижения = ДвиженияРезервТМЦ.Добавить();
		НоваяСтрокаДвижения.ВидДвижения = ВидДвижения;
		НоваяСтрокаДвижения.Период = ДокументОбъект.Дата;
		НоваяСтрокаДвижения.Организация = ДокументОбъект.Организация;
		НоваяСтрокаДвижения.Номенклатура = СтрокаСписания.Номенклатура;
		Если СвойстваСчетаУчета.ДопИзмерениеЕстьСубконто Тогда
			НоваяСтрокаДвижения.ЦМО = СтрокаСписания.ДопИзмерение;
		КонецЕсли;
		НоваяСтрокаДвижения.КФО = СтрокаСписания.КФО;
		НоваяСтрокаДвижения.СчетУчета = СтрокаСписания.СчетУчета;
		НоваяСтрокаДвижения.Количество = СтрокаСписания.Количество;
		Если РезервироватьСумму Тогда
			НоваяСтрокаДвижения.Сумма = СтрокаСписания.Стоимость;
		КонецЕсли;
		Если ИспользоватьДопАналитику Тогда
			НоваяСтрокаДвижения.ДопАналитика = СтрокаСписания.ДопАналитика;
		ИначеЕсли СвойстваСчетаУчета.ПартияЕстьСубконто И СвойстваСчетаУчета.ПартияСуммовой Тогда
			НоваяСтрокаДвижения.ДопАналитика = СтрокаСписания.Партия;
		КонецЕсли;
		Если СвойстваСчетаУчета.УчетПоКПС Тогда
			НоваяСтрокаДвижения.КПС = СтрокаСписания.КПС;
		КонецЕсли;
		Если ИспользоватьУчетПоИФО Тогда
			НоваяСтрокаДвижения.ИФО = СтрокаСписания.ИФО;
		КонецЕсли;
		Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаУчета.УчетПоПодразделениям Тогда
			НоваяСтрокаДвижения.Подразделение = СтрокаСписания.Подразделение;
		КонецЕсли;
		
	КонецЦикла;
	
	СворачиваемыеКолонки = Новый Массив;
	СуммируемыеКолонки = Новый Массив;
	СуммируемыеКолонки.Добавить("Количество");
	СуммируемыеКолонки.Добавить("Сумма");
	СуммируемыеКолонкиИнд = Новый Структура(СтрСоединить(СуммируемыеКолонки, ","));
	
	Для Каждого Колонка Из ДвиженияРезервТМЦ.Колонки Цикл
		Если НЕ СуммируемыеКолонкиИнд.Свойство(Колонка.Имя) Тогда
			СворачиваемыеКолонки.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ДокументОбъект.ДополнительныеСвойства.ДвиженияРезервТМЦ.Свернуть(
		СтрСоединить(СворачиваемыеКолонки, ","),
		СтрСоединить(СуммируемыеКолонки, ","));

КонецПроцедуры

Процедура ДобавитьДвиженияРезервированияМЗТекущегоДокумента(ДокументОбъект, ДвиженияРезерва)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РезервМЗ.Период,
	|	РезервМЗ.ВидДвижения,
	|	РезервМЗ.Организация,
	|	РезервМЗ.Номенклатура,
	|	РезервМЗ.ЦМО,
	|	РезервМЗ.ДопАналитика,
	|	РезервМЗ.КПС,
	|	РезервМЗ.КФО,
	|	РезервМЗ.СчетУчета,
	|	РезервМЗ.ИФО,
	|	РезервМЗ.Подразделение,
	|	РезервМЗ.Количество,
	|	РезервМЗ.Сумма
	|ИЗ
	|	РегистрНакопления.РезервМЗ КАК РезервМЗ
	|ГДЕ
	|	РезервМЗ.Регистратор = &Регистратор
	|	И РезервМЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)";
	Запрос.УстановитьПараметр("Регистратор", ДокументОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ДвиженияРезерва.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

