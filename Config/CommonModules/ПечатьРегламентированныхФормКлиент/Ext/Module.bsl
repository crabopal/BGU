/////////////////////////////////////////////////////////////////////////////////
// Печать регламентированных форм клиент                                       //
/////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура ПроверитьДокументЗаписан(ОбработкаРезультата, Форма) Экспорт 
	                                                      
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Этап", "Начало");
	ДополнительныеПараметры.Вставить("ОбработкаРезультата", ОбработкаРезультата);
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьДокументЗаписанВнутр",ПечатьРегламентированныхФормКлиент,ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	
КонецПроцедуры	

Процедура ПечатьОтчета(Ссылка, ИмяКоманды, КомандыПечати, АдресОбъекта = Неопределено, Форма = Неопределено) Экспорт 
	
	ПечатьРегламентированныхФормКлиентПереопределяемый.ПечатьОтчета(Ссылка, ИмяКоманды, КомандыПечати, АдресОбъекта, Форма); 
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Процедура ПроверитьДокументЗаписанВнутр(Результат, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		Если ДополнительныеПараметры.Форма.Модифицированность = Ложь Тогда // все и так хорошо
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаРезультата);
			Возврат;
		КонецЕсли;

		ДополнительныеПараметры.Этап = "ОбработкаРезультатаВопроса";
		ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьДокументЗаписанВнутр",ПечатьРегламентированныхФормКлиент,ДополнительныеПараметры);
		
		ТекстВопроса = НСтр("ru = 'Для того чтобы распечатать документ, его необходимо предварительно записать. Выполнить запись документа и продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса,РежимДиалогаВопрос.ДаНет);
		
	////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ОбработкаРезультатаВопроса" Тогда 
		
		Если Результат <> КодВозвратаДиалога.Да Тогда 
			Возврат;
		КонецЕсли;
		
		Если ТипЗнч(ДополнительныеПараметры.Форма) = Тип("ФормаКлиентскогоПриложения") Тогда 
			
			Если ДополнительныеПараметры.Форма.Записать() Тогда 
				ДополнительныеПараметры.ОбработкаРезультата.ДополнительныеПараметры.Ссылка = ДополнительныеПараметры.Форма.Объект.Ссылка;
				ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаРезультата);
				Возврат;
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДополнительныеПараметры.Форма) = Тип("Форма") Тогда 
			
			Попытка

				ДополнительныеПараметры.Форма.Записать();
				ДополнительныеПараметры.ОбработкаРезультата.ДополнительныеПараметры.Ссылка = ДополнительныеПараметры.Форма.Ссылка;
				ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаРезультата);
				Возврат;
			Исключение
				Сообщить(ОписаниеОшибки());
			КонецПопытки;	
			
		КонецЕсли;	
		
		ПоказатьПредупреждение(,НСтр("ru = 'Документ не записан. Печать невозможна.'"));
		
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ПечатьОтчетаАсинхрон(Результат, ДополнительныеПараметры) Экспорт
	
	ПечатьОтчета(ДополнительныеПараметры.Ссылка,
	ДополнительныеПараметры.КомандаИмя,
	ДополнительныеПараметры.КомандыПечати,
	ДополнительныеПараметры.АдресОбъекта,
	ДополнительныеПараметры.Форма);
	
КонецПроцедуры	

