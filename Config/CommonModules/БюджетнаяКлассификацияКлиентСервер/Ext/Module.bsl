Процедура ПриОбновленииСоставаПользовательскихНастроек(СтандартнаяОбработка, 
	Форма, 
	ИмяРеквизитаНаДату 		= "НаДату", 
	ИмяРеквизитаБюджет 		= "Бюджет",
	ИмяРеквизитаВладелец	= "Владелец",
	ИмяРеквизитаЦС 			= "ЦелеваяСтатья",
	ИмяРеквизитаВидДохода	= "ВидДохода") Экспорт

	Для Каждого Элемент Из Форма.Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		
		Если ТипЗнч(Элемент) = Тип("ОтборКомпоновкиДанных") Тогда
			
			ПроизвольныйОтбор = Элемент;
			
			Для Каждого ЭлементОтбора Из Элемент.Элементы Цикл
				
				Если НЕ ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
					Продолжить;
				КонецЕсли;	
				
				Если ЭлементОтбора.Использование Тогда
					
					Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДатаНачалаДействия")						
						ИЛИ ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДатаОкончанияДействия") Тогда
						
						ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Форма.Список.Отбор, "ДатаНачалаДействия");
						ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Форма.Список.Отбор, "ДатаОкончанияДействия");
						Форма[ИмяРеквизитаНаДату] = "";
												
					ИначеЕсли ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Бюджет") Тогда
						
						ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Форма.Список.Отбор, "Бюджет"); 
						Если НЕ Форма.Элементы.Найти(ИмяРеквизитаБюджет) = Неопределено Тогда
							Форма[ИмяРеквизитаБюджет] = ""; 
						КонецЕсли;	
						
					ИначеЕсли ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЦелеваяСтатья") Тогда
						
						ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Форма.Список.Отбор, "ЦелеваяСтатья");
						Форма[ИмяРеквизитаЦС] = "";
						
					ИначеЕсли ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец") Тогда
						
						ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Форма.Список.Отбор, "Владелец");
						Форма[ИмяРеквизитаВладелец] = "";
						
					ИначеЕсли ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидДохода") Тогда
						
						ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Форма.Список.Отбор, "ВидДохода");
						Форма[ИмяРеквизитаВидДохода] = "";
	
					КонецЕсли;
													
				КонецЕсли;	
				
			КонецЦикла;	
			
		КонецЕсли	
		
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

#Область НациональныеПроекты

Функция СтрокаКодовНацПроектов(Дата = Неопределено) Экспорт
	
	// До 01.01.2025 применялись коды ADEFGIJLNPRSTVY (буквы латинского алфавита)
	// С 01.01.2025 - АВДЕИКЛМНПРСТЦЧЭЮЯY (буквенные значения русского алфавита и 
	// буква "Y" латинского алфавита)
	// С 01.01.2026 добавлена кириллическая Б
	
	Если Дата = Неопределено ИЛИ Дата > '20251231' Тогда 
		Возврат "АБВДЕИКЛМНПРСТЦЧЭЮЯY";
	ИначеЕсли Дата > '20241231' Тогда
		Возврат "АВДЕИКЛМНПРСТЦЧЭЮЯY"; 
	Иначе
		Возврат "ADEFGIJLNPRSTVY"; 
	КонецЕсли;	
	
КонецФункции	
	
Функция ЭтоКодНацПроекта(ПроверяемыйСимвол, ДатаНачала = Неопределено) Экспорт
	
	Возврат СтрЧислоВхождений(СтрокаКодовНацПроектов(ДатаНачала), ПроверяемыйСимвол) > 0;
	
КонецФункции		

#КонецОбласти


