// Возвращает массив аналитических кодов доходов.
// 
// Параметры:
//  Включать000 - Булево, если "Истина" - в возвращаемый массив будет включен код "000".
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция АналитическиеКодыДоходов(Включать000 = Ложь) Экспорт   
	Возврат СтрРазделить(
	"110
	|120
	|130
	|140
	|150
	|151
	|152
	|153
	|160
	|180
	|190
	|191
	|192
	|193
	|194
	|195
	|196
	|197
	|198
	|199
	|400
	|410
	|420
	|430
	|440
	|460
	|630" + ?(Включать000, Символы.ПС + "000", ""),
	Символы.ПС,
	Ложь); 
КонецФункции	

