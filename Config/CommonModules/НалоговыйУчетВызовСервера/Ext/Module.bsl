
#Область ПрограммныйИнтерфейс

// Параметры учетной политики по налогу на прибыль
//
Функция ПлательщикНалогаНаПрибыль(Организация, Период) Экспорт

	Если ТипЗнч(Период) = Тип("Граница") Тогда
		Если ТипЗнч(Период.Значение) = Тип("МоментВремени") Тогда
			ДатаНачалаМесяца = НачалоМесяца(Период.Значение.Дата);
		Иначе
			ДатаНачалаМесяца = НачалоМесяца(Период.Значение);
		КонецЕсли;
	Иначе
		ДатаНачалаМесяца = НачалоМесяца(Период);
	КонецЕсли;
	
	Результат = ПолучитьФункциональнуюОпцию("ПлательщикНалогаНаПрибыль", 
		Новый Структура("Организация, Период", Организация, ДатаНачалаМесяца));

	Возврат Результат;

КонецФункции

Функция ЕстьРасшифровкаПоПоказателям(АдресХранилищаРасшифровки, ИменаПоказателей) Экспорт
	
	ТаблицаРасшифровок = ПолучитьИзВременногоХранилища(АдресХранилищаРасшифровки);
	ТаблицаРасшифровок.Индексы.Добавить("ИмяПоказателя");
	
	ЕстьПоказателиИзСписка = Ложь;
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		Если ТаблицаРасшифровок.Найти(ИмяПоказателя, "ИмяПоказателя") <> Неопределено Тогда
			ЕстьПоказателиИзСписка = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьПоказателиИзСписка;
	
КонецФункции

Функция ПолучитьПараметрыРасшифровкиОтчета(Адрес, ИмяФормы, Расшифровка) Экспорт
	
	ПараметрыРасшифровки = Новый Структура;
	
	Если ИмяФормы = "Отчет.РегистрыНалоговогоУчета.Форма" Тогда
		
		ДанныеРасшифровки = ПолучитьИзВременногоХранилища(Адрес);
		ПоляРасшифровки = ДанныеРасшифровки.Элементы[Расшифровка].ПолучитьПоля();
		Если ПоляРасшифровки.Количество()>0 Тогда
			ПараметрыРасшифровки.Вставить("ОткрытьОбъект", Истина);
			ПараметрыРасшифровки.Вставить("Значение"       , ПоляРасшифровки[0].Значение);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПараметрыРасшифровки;
	
КонецФункции    

#КонецОбласти