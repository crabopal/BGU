// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Обработчик изменения текущей процедуры в форме редактирования.
//
Процедура ТекущаяПроцедураОбработкаВыбора(Знач ЭтаФорма, Знач Элемент, Знач ВыбранноеЗначение, СтандартнаяОбработка) Экспорт

	ИзменятьМодифицированность = ЭтаФорма.Модифицированность;
	СтандартнаяОбработка       = Ложь;
	
	ПользовательскиеАлгоритмыКлиентСервер.СохранитьТекущиеДанные(ЭтаФорма);
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		// Выбранное значение может быть идентификатором, или именем несуществующей предопределенной процедуры.
		Если ТипЗнч(ВыбранноеЗначение) = Тип("Строка") Тогда
			
			СтрРедактируемых               = ЭтаФорма.ТаблицаРедактированияПроцедур.Добавить();
			СтрРедактируемых.ИмяПроцедуры  = ВыбранноеЗначение;
			СтрРедактируемых.Идентификатор = Новый УникальныйИдентификатор;
			СтрРедактируемых.Загружена     = Истина; // Не считывать из ИБ, даже если там есть такое имя.
			
			// Обозначим изменения в списке выбора.
			ОбновитьСтрокуСпискаВыбора(Элемент.СписокВыбора, ВыбранноеЗначение, СтрРедактируемых.Идентификатор);
			
			ВыбранноеЗначение = СтрРедактируемых.Идентификатор;
			ЭтаФорма.Модифицированность = Истина; // Создана новая процедура.
			
		Иначе
			
			СтрРедактируемых = ПользовательскиеАлгоритмыКлиентСервер.НайтиЗаписьОРедактируемойПроцедуре(ЭтаФорма.ТаблицаРедактированияПроцедур,ВыбранноеЗначение);
			Если СтрРедактируемых = Неопределено Тогда // Если вдруг такой строки в таблице не окажется, необходимо это обработать.
				
				ЭтаФорма.ТекстПроцедуры.УстановитьТекст("");
				ЭтаФорма.Элементы.ТекстПроцедуры.ТолькоПросмотр = Истина;
				Возврат;
				
			КонецЕсли;
			
			Если Не СтрРедактируемых.Загружена Тогда
				
				СтрРедактируемых.ТекстПроцедуры = ПользовательскиеАлгоритмыВызовСервера.ПолучитьТекстПроцедуры(ЭтаФорма.Объект.Ссылка, СтрРедактируемых.ИмяПроцедуры);
				СтрРедактируемых.Загружена      = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЭтаФорма.ТекстПроцедуры.УстановитьТекст(СтрРедактируемых.ТекстПроцедуры);
		ЭтаФорма.Элементы.ТекстПроцедуры.ТолькоПросмотр = Ложь;
		
	Иначе // Процедура не указана, редактировать нечего.
		
		ЭтаФорма.ТекстПроцедуры.УстановитьТекст("");
		ЭтаФорма.Элементы.ТекстПроцедуры.ТолькоПросмотр = Истина;
		
	КонецЕсли;
	
	ЭтаФорма.ТекущаяПроцедура = ВыбранноеЗначение;
	
	Если Не ИзменятьМодифицированность Тогда
		ЭтаФорма.Модифицированность = Ложь;
	КонецЕсли;

КонецПроцедуры // ОбработкаВыбораПроцедуры()

// Обработчик события Открытие элемента управления ТекущаяПроцедура.
//
Процедура  ТекущаяПроцедураОткрытие(Знач ЭтаФорма, Знач Элемент, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ссылка"            , ЭтаФорма.Объект.Ссылка);
	ПараметрыФормы.Вставить("ТаблицаПроцедур"	, ЭтаФорма.ТаблицаРедактированияПроцедур);
	
	СтрРедактируемых = ПользовательскиеАлгоритмыКлиентСервер.НайтиЗаписьОРедактируемойПроцедуре(ЭтаФорма.ТаблицаРедактированияПроцедур, ЭтаФорма.ТекущаяПроцедура);
	Если СтрРедактируемых <> Неопределено Тогда
		ПараметрыФормы.Вставить("ТекущаяСтрока", СтрРедактируемых.Идентификатор);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяФормы","ОбщаяФорма.РедактированиеСпискаПроцедур"); 
	ДополнительныеПараметры.Вставить("ПараметрыФормы",ПараметрыФормы);
	ДополнительныеПараметры.Вставить("ВладелецФормы",ЭтаФорма);
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","Результат <> Неопределено");
	
	ДополнительныеПараметрыФорма = Новый Структура;
	ДополнительныеПараметрыФорма.Вставить("ЭтаФорма",ЭтаФорма);
	ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ТекущаяПроцедураОткрытиеЗавершение",ПользовательскиеАлгоритмыКлиент,ДополнительныеПараметрыФорма)); 
	
	БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Изменяет представление и значение в элементе списка выбора
// при добавлении новой процедуры.
//
Процедура ОбновитьСтрокуСпискаВыбора(Знач СписокВыбора, Знач ИмяПроцедуры, Знач Идентификатор)

	ЭлементСпискаВыбора = СписокВыбора.НайтиПоЗначению(ИмяПроцедуры);
	Если Не ЭлементСпискаВыбора = Неопределено Тогда
		ЭлементСпискаВыбора.Значение      = Идентификатор;
		ЭлементСпискаВыбора.Представление = ИмяПроцедуры;
		ЭлементСпискаВыбора.Картинка      = БиблиотекаКартинок.Процедура;
	КонецЕсли;

КонецПроцедуры

// Обработчик обновления данных формы после редактирования списка процедур
//
Процедура ОбработкаРедактированияСпискаПроцедур(ЭтаФорма, РезультатРедактирования)

	ЭтаФорма.Модифицированность   = Истина;
	
	ЭтаФорма.ТаблицаРедактированияПроцедур.Очистить();
	ОбщегоНазначенияКлиентСервер.ЗаполнитьКоллекциюСвойств(РезультатРедактирования.ТаблицаПроцедур, ЭтаФорма.ТаблицаРедактированияПроцедур); 
	
	ПользовательскиеАлгоритмыКлиентСервер.ОбновитьОтображениеТекстаПроцедуры(ЭтаФорма, ЭтаФорма.ТаблицаРедактированияПроцедур, РезультатРедактирования.ТекущаяПроцедура);

КонецПроцедуры 

Процедура ТекущаяПроцедураОткрытиеЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	
	ОбработкаРедактированияСпискаПроцедур(ДополнительныеПараметры.ЭтаФорма, Результат);
	
КонецПроцедуры	
