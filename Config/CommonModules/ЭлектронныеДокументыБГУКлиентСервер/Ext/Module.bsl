#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьИдентификаторСтроки(Строка) Экспорт

	Строка.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);

КонецПроцедуры

// Формирует представление списков кодов маркировки.
//
// Параметры:
//  КодыУпаковок - Массив - содержит коды упаковок, для которых необходимо сформировать представление.
// 
// Возвращаемое значение:
//  Строка - представление переданных кодов маркировки в виде строки.
//
Функция ПредставлениеКодовМаркировки(Знач КодыУпаковок) Экспорт

	Возврат СтрСоединить(КодыУпаковок, "; ");

КонецФункции

#КонецОбласти

#Область ОбменЭлектроннымиПеревозочнымиДокументами

Процедура ПроверитьВозможностьОформленияЭПД(Форма) Экспорт
	Объект = Форма.Объект;
	
	Форма.МожноОформитьЭПД = ЗначениеЗаполнено(Объект.Организация) 
		И ЭлектронныеДокументыБГУВызовСервера.МожноОформитьЭПД(Объект.Организация, Объект.Контрагент);
		
КонецПроцедуры

Функция ПредопределенноеЗначениеФактическогоАдресаКонтрагента() Экспорт
	Возврат ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты");	
КонецФункции	

Процедура ОбновитьТекстЭПД(Форма) Экспорт
	Элементы = Форма.Элементы;
	Если Элементы.Найти("ГруппаСостояниеЭПД") = Неопределено 
		ИЛИ НЕ Элементы.ГруппаСостояниеЭПД.Видимость Тогда
		
		Возврат;
	КонецЕсли;
	
	Ссылка = Форма.Объект.Ссылка;
	Если ЭлектронныеДокументыБГУВызовСервера.ЭтоОснованиеЭТрН(Ссылка) Тогда
		СписокОснования = ЭлектронныеДокументыБГУВызовСервера.СписокСчетовНаОплатуПокупателю(Ссылка); 
		ТерминальныйТип = Тип("ДокументСсылка.ЭлектроннаяТранспортнаяНакладная");
	Иначе
		СписокОснования = ЭлектронныеДокументыБГУВызовСервера.СписокРеализацийПоСчетуПокупателю(Ссылка);
		ТерминальныйТип = Тип("ДокументСсылка.ЭлектронныйЗаказЗаявка");
	КонецЕсли;
	СписокОснования.Добавить(Ссылка);
	
	СписокДокументов = ЭлектронныеДокументыБГУВызовСервера.ЭлектронныеДокументыПоОснованию(СписокОснования);
	ДокументооборотЗавершен = Ложь;
	Для каждого СтрокаДокумент Из СписокДокументов Цикл
		Если ТипЗнч(СтрокаДокумент.Значение) = ТерминальныйТип 
			И СтрокаДокумент.Пометка Тогда
			
			ДокументооборотЗавершен = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.ДекорацияОформитьЭПД.Видимость = НЕ ДокументооборотЗавершен;
	Элементы.ДекорацияЭПД.Видимость = СписокДокументов.Количество() > 0;
	
	Если СписокДокументов.Количество() = 1 Тогда
		Элементы.ДекорацияЭПД.Заголовок = СписокДокументов[0].Представление;
		Форма.ЭПДСсылка = СписокДокументов[0].Значение;
	Иначе
		Элементы.ДекорацияЭПД.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("ЭПД (%1)", СписокДокументов.Количество());
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОткрытиеФайловPDF

Функция ТекстСообщенияОНеобходимостиСнятьПометкуУдаленияДляОткрытияФайла() Экспорт
	Возврат НСтр("ru = 'Для открытия файла, необходимо снять пометку удаления с документа'");
КонецФункции

#КонецОбласти

