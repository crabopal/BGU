						ТекстОшибки = НСтр("ru='Не удалось подписать заголовок soap-пакета.'");
							
						Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
							КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
						Иначе
							ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
						КонецЕсли;
				
						ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
											
						Возврат;
						
					КонецЕсли;				
				Исключение
					
					ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать заголовок soap-пакета.
						|%1'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
											
					Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
						КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
					Иначе
						ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
					КонецЕсли;
			
					ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
										
					Возврат;
						
				КонецПопытки;
				ФайлОбработан = Истина;
			КонецЕсли;
			
			
			Если ФайлОбработан Тогда 
				СоответствиеОбновленныхФайлов.Вставить(КлючИЗначение.Ключ,СодержимоеФайла);
			КонецЕсли;
		КонецЦикла;
		Если СоответствиеОбновленныхФайлов.Количество()>0 Тогда
			//Записать изменения
			ГосУслуги.ОбновитьПрисоединенныеФайлы(СоответствиеОбновленныхФайлов);
		КонецЕсли;
		
		ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Истина);
	КонецЕсли;	
	
КонецПроцедуры

Функция ОтправитьЗапросКTSAСерверу(АдресTSA,СтруктураНастроекТSA,ТелоЗапроса64,ИмяБлока,ОтправлятьНаСервере) Экспорт
	//ТелоЗапроса64 - строка в Base64, если подписывается на клиенте
	// и двоичные данные, если подписывается на сервере
	
	Если ТипЗнч(ТелоЗапроса64) = Тип("Строка") Тогда
		ТелоЗапросаДвоичныеДанные = Base64Значение(ТелоЗапроса64);
	Иначе
		ТелоЗапросаДвоичныеДанные = ТелоЗапроса64;
	КонецЕсли;
		
	Если ОтправлятьНаСервере = Истина Тогда
		СтруктураНастроек = Новый Структура;
		СтруктураНастроек.Вставить("АдресTSA",АдресTSA);
		СтруктураНастроек.Вставить("СтруктураНастроекТSA",СтруктураНастроекТSA);
		//ТелоЗапросаДвоичныеДанные = Base64Значение(ТелоЗапроса64);
		Результат = ГосУслуги.ОтправитьЗапросКTSAСерверу(СтруктураНастроек,ТелоЗапросаДвоичныеДанные,ИмяБлока);
	Иначе
		ТекПрокси = ПолучениеФайловИзИнтернетаКлиентСервер.ПолучитьПрокси(АдресTSA);
												
		СоединениеHTTP = Новый HTTPСоединение(СтруктураНастроекТSA.Хост,СтруктураНастроекТSA.Порт,,,ТекПрокси,90);					
								
			// формируем запрос к серверу TSA
		ЗаголовокHTTP 	= Новый Соответствие();
		ЗаголовокHTTP.Вставить("Content-Type", "application/timestamp-query");
		ЗаголовокHTTP.Вставить("Host", СтруктураНастроекТSA.Хост);
		
		ЗапросHTTP = Новый HTTPЗапрос(СтруктураНастроекТSA.АдресРесурса, ЗаголовокHTTP);
		
		ЗапросHTTP.УстановитьТелоИзДвоичныхДанных(ТелоЗапросаДвоичныеДанные);
			// обращаемся к серверу TSA и получаем ответ
			
		Результат = Новый Структура("Успех,ТекстОшибки,ТекстОтвета");
		ОтветHTTP = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
		
		Если ОтветHTTP.КодСостояния = 200 Тогда
			Результат.Успех = Истина;
			Ответ = ОтветHTTP.ПолучитьТелоКакДвоичныеДанные();
							
			Результат.ТекстОтвета = Base64Строка(Ответ);
			
		Иначе
			Результат.Успех = Ложь;
			ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать """+ИмяБлока+""".
			| TSA сервер вернул ошибку: (" + ОтветHTTP.КодСостояния + ") - " + ОтветHTTP.ПолучитьТелоКакСтроку()+"'");
			
			Результат.ТекстОшибки = ТекстОшибки;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура НачатьПодготовкуКОтправкеПослеСозданияМенеджераКриптографии(МенеджерКриптографии, КонтекстВыполнения) Экспорт
	
	Если ТипЗнч(МенеджерКриптографии) <> Тип("МенеджерКриптографии") Тогда
		ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);		
		Возврат;
	КонецЕсли;	
		
	мХранилищеСертификатов = МенеджерКриптографии.ПолучитьХранилищеСертификатов();
	
	Если ЗначениеЗаполнено(КонтекстВыполнения.ОтпечатокПодписиСущностей) Тогда
		ДвоичныеДанныеОтпечаткаСущности = Base64Значение(КонтекстВыполнения.ОтпечатокПодписиСущностей);
		СертификатСущности = мХранилищеСертификатов.НайтиПоОтпечатку(ДвоичныеДанныеОтпечаткаСущности);
	КонецЕсли;
		
	Если ЗначениеЗаполнено(КонтекстВыполнения.ОтпечатокПодписиЗаголовка) Тогда
		ДвоичныеДанныеОтпечаткаЗаголовка = Base64Значение(КонтекстВыполнения.ОтпечатокПодписиЗаголовка);
		СертификатЗаголовка = мХранилищеСертификатов.НайтиПоОтпечатку(ДвоичныеДанныеОтпечаткаЗаголовка);
	КонецЕсли;
		
    СущностьНеПодписана = Ложь;
	Если КонтекстВыполнения.ОтпечатокПодписиСущностей<>Неопределено И СертификатСущности = Неопределено Тогда
		СущностьНеПодписана = Истина;
	КонецЕсли;
	
	ЗаголовокНеПодписан = Ложь;
	Если КонтекстВыполнения.ОтпечатокПодписиЗаголовка<>Неопределено И СертификатЗаголовка = Неопределено Тогда
		ЗаголовокНеПодписан = Истина;
	КонецЕсли;
	
	ФайлыДляПереноса = КонтекстВыполнения.Данные.Получить("ФайлыДанных");
	
	СоответствиеОбновленныхФайлов = Новый Соответствие;
	
	ДанныеСертификатаСущности = "";	
	Если СертификатСущности <> Неопределено Тогда
		ДанныеСертификатаСущности = Base64Строка(СертификатСущности.Выгрузить());
		ДанныеСертификатаСущности = СтрЗаменить(ДанныеСертификатаСущности,Символы.ВК,"");
	КонецЕсли;
	
	ДанныеСертификатаЗаголовка = "";
	Если СертификатЗаголовка <> Неопределено Тогда
		ДанныеСертификатаЗаголовка = Base64Строка(СертификатЗаголовка.Выгрузить());
		ДанныеСертификатаЗаголовка = СтрЗаменить(ДанныеСертификатаЗаголовка,Символы.ВК,"");
	КонецЕсли;
	
	//
	
	Попытка
		КомпонентаПодписи = СоздатьОбъектДляПодписиXMLDSIG();
		Если КомпонентаПодписи = Неопределено Тогда
			ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
			Возврат;
		КонецЕсли;
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось создать компоненту для формирования электронной подписи.'"));
	    ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
		Возврат;
	КонецПопытки;
	
	Для Каждого КлючИЗначение ИЗ ФайлыДляПереноса Цикл
		
		СодержимоеФайла = КлючИЗначение.Значение;
		
		ЕстьИзменения = Ложь;
				
		//Подпись начисления (документ "Квитанция на оплату")
		Если Найти(СодержимоеФайла,"<Charge")>0 И СущностьНеПодписана Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать начисление. Не найден сертификат для подписи сущности по установленному отпечатку. Проверьте установленные сертификаты.'"));
			ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
			Возврат;
		ИначеЕсли Найти(СодержимоеФайла,"<Catalog")>0 И СущностьНеПодписана Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать каталог услуг. Не найден сертификат для подписи сущности по установленному отпечатку. Проверьте установленные сертификаты.'"));	
			ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
			Возврат;
		Иначе
			
			ТегИмпортРеквест = "pirs:ImportRequest";
			ДлинаТегаИмпортРеквест = СтрДлина(ТегИмпортРеквест)+1; 
			
			НачальнаяПозиция = Найти(СодержимоеФайла,"<" + ТегИмпортРеквест);
			НачальныйБлок = Сред(СодержимоеФайла,1, НачальнаяПозиция-1);
		    КонечнаяПозиция = Найти(СодержимоеФайла,"</"+ТегИмпортРеквест+">");
			БлокПодписи = Сред(СодержимоеФайла,НачальнаяПозиция,КонечнаяПозиция+ДлинаТегаИмпортРеквест + 2 -НачальнаяПозиция);
			КонечныйБлок = Сред(СодержимоеФайла,КонечнаяПозиция + ДлинаТегаИмпортРеквест + 2);
			
			
			Если Найти(СодержимоеФайла,"<Charge")>0 И СертификатСущности <> Неопределено Тогда
			    Попытка
				    //Тут будет подпись сущности внешней компонентой
					Если КомпонентаПодписи.XMLDSign(БлокПодписи, "Charge", ДанныеСертификатаСущности, Истина, Истина) Тогда
						СодержимоеФайла = НачальныйБлок + КомпонентаПодписи.Sign + КонечныйБлок;
						ЕстьИзменения = Истина;
					Иначе
						ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать начисление.'"));
						ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
						Возврат;
					КонецЕсли;
				Исключение
					ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать начисление.'"));
					ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
					Возврат;					
				КонецПопытки;
				
			КонецЕсли;
			
			// Подпись каталога услуг
			Если Найти(СодержимоеФайла,"<ServiceCatalog")>0 И СертификатСущности <> Неопределено Тогда		
                Попытка
					//Подпись сущности внешней компонентой
					Если КомпонентаПодписи.XMLDSign(БлокПодписи, "ServiceCatalog", ДанныеСертификатаСущности, Истина, Истина) Тогда
						СодержимоеФайла = НачальныйБлок + КомпонентаПодписи.Sign + КонечныйБлок;
						ЕстьИзменения = Истина;
					Иначе
						ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать каталог услуг.'"));
						ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
						Возврат;
					КонецЕсли;
				Исключение
					ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать каталог услуг.'"));
					ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
					Возврат;					
				КонецПопытки;								
			КонецЕсли;
			
			// Подпись измененного каталога услуг
			Если Найти(СодержимоеФайла,"<Changes")>0 И СертификатСущности <> Неопределено Тогда
				Попытка
					//Подпись сущности внешней компонентой
					Если КомпонентаПодписи.XMLDSign(БлокПодписи, "Changes", ДанныеСертификатаСущности, Истина, Истина) Тогда
						СодержимоеФайла = НачальныйБлок + КомпонентаПодписи.Sign + КонечныйБлок;
						ЕстьИзменения = Истина;
					Иначе
						ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать каталог услуг.'"));
						ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
						Возврат;
					КонецЕсли;
				Исключение
					ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать каталог услуг.'"));
					ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
					Возврат;					
				КонецПопытки;	
			КонецЕсли;
		КонецЕсли;
		
		
		Если Найти(СодержимоеФайла,"<soapenv:Body")>0 И ЗаголовокНеПодписан Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать soap-пакет. Не найден сертификат для подписи заголовка soap-пакета по установленному отпечатку. Проверьте установленные сертификаты.'"));	
			ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
			Возврат;
		Иначе
			
			Если Найти(СодержимоеФайла,"<soapenv:Body")>0 И СертификатЗаголовка <> Неопределено Тогда
				НачальныйЗаголовок = "";
				Если Найти(СодержимоеФайла,"<?xml")>0 Тогда
					Позиция = Найти(СодержимоеФайла, "?>");
					Количество = 2;
					Если Сред(СодержимоеФайла,Позиция+2,1)=Символы.ПС Тогда
						Количество = 3;
					КонецЕсли;
					НачальныйЗаголовок = Лев(СодержимоеФайла,Позиция+2);
					СодержимоеФайлаБезЗаголовка = Сред(СодержимоеФайла,Позиция+Количество);
				КонецЕсли;
				
				ПозицияУТМ = Найти(СодержимоеФайлаБезЗаголовка,"<n1:UnifoTransferMsg");
				ТекстДоУТМ = Лев(СодержимоеФайлаБезЗаголовка,ПозицияУТМ);
				ТекстДоУТМ = СтрЗаменить(СтрЗаменить(ТекстДоУТМ,Символы.ПС,""),Символы.Таб,"");
				
				ПозицияКонецУТМ = Найти(СодержимоеФайлаБезЗаголовка,"</n1:UnifoTransferMsg");
				ТекстКонец = Сред(СодержимоеФайлаБезЗаголовка,ПозицияКонецУТМ);
				ТекстКонец = СтрЗаменить(СтрЗаменить(ТекстКонец,Символы.ПС,""),Символы.Таб,"");
				
				ТекстСередина = Сред(СодержимоеФайлаБезЗаголовка,ПозицияУТМ+1,ПозицияКонецУТМ-1-ПозицияУТМ);
				СодержимоеФайлаБезЗаголовка = ТекстДоУТМ + ТекстСередина+ТекстКонец;
				
							
				//Вставляем сертификат в заголовок
				СодержимоеФайлаБезЗаголовка = СтрЗаменить(СодержимоеФайлаБезЗаголовка,"%СертификатЗаголовка%",ДанныеСертификатаЗаголовка);
								
				ИмяИскомогоТега = "</wsse:BinarySecurityToken>";
				ДлинаИскомогоТега = СтрДлина(ИмяИскомогоТега);
				
				НачальнаяПозиция = Найти(СодержимоеФайлаБезЗаголовка, ИмяИскомогоТега);
				НачальныйБлок  = Сред(СодержимоеФайлаБезЗаголовка,1, НачальнаяПозиция+ДлинаИскомогоТега-1);
				
				КонечнаяПозиция = НачальнаяПозиция+ДлинаИскомогоТега;
				КонечныйБлок = СокрЛ(Сред(СодержимоеФайлаБезЗаголовка,КонечнаяПозиция));
				
				БлокПодписи = "";
				Попытка
					//Подпись заголовка soap-пакета внешней компонентой
					Если КомпонентаПодписи.XMLDSign(СодержимоеФайлаБезЗаголовка, "Body", ДанныеСертификатаЗаголовка, Ложь, Ложь) Тогда
						СодержимоеФайла = НачальныйЗаголовок + НачальныйБлок + КомпонентаПодписи.Sign + КонечныйБлок;
						ЕстьИзменения = Истина;
					Иначе
						ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать заголовок soap-пакета.'"));
						ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
						Возврат;
					КонецЕсли;				
				Исключение
					ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать заголовок soap-пакета.'"));
					ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
					Возврат;					
				КонецПопытки;				
			КонецЕсли;
		КонецЕсли;
		
		// Это надо на сервере
		Если ЕстьИзменения Тогда 
			СоответствиеОбновленныхФайлов.Вставить(КлючИЗначение.Ключ,СодержимоеФайла);
		КонецЕсли;
				
	КонецЦикла;
	
	Если СоответствиеОбновленныхФайлов.Количество()>0 Тогда
		//Записать изменения
		ГосУслуги.ОбновитьПрисоединенныеФайлы(СоответствиеОбновленныхФайлов);
	КонецЕсли;
	
	ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Истина);
		
КонецПроцедуры

//

Процедура ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Результат)
	
	КонтекстВыполнения.Вставить("Результат",Результат);
	
	Если КонтекстВыполнения.Свойство("ПослеПодготовкиЗадания") Тогда
		ВыполнитьОбработкуОповещения(КонтекстВыполнения.ПослеПодготовкиЗадания,КонтекстВыполнения);

	ИначеЕсли КонтекстВыполнения.Свойство("ПродолжитьПослеПодготовки") Тогда
		ВыполнитьОбработкуОповещения(КонтекстВыполнения.ПродолжитьПослеПодготовки,Результат);
	КонецЕсли;
	
КонецПроцедуры

//список заданий

Процедура НачатьПодготовкуКОтправкеСпискаЗаданий(КонтекстВыполнения) Экспорт
	
	Если НЕ КонтекстВыполнения.Свойство("Версия") Тогда
		КонтекстВыполнения.Вставить("Версия",1.15);
	КонецЕсли;
	
	Если КонтекстВыполнения.Версия = 1.15 Тогда
		
		СертификатСущности = Неопределено;
		СертификатЗаголовка = Неопределено;
			
		Данные = ГосУслуги.ПолучитьДанныеПодготовкиСпискаЗаданий(КонтекстВыполнения.СписокЗаданий,КонтекстВыполнения.НастройкаОбмена);
		
		Если НЕ Данные.Получить("НужнаПодготовка") Тогда
			ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Истина);
			Возврат;
		КонецЕсли;
		
		СоответствиеПараметров = Данные.Получить("СоответствиеПараметров");
		
		ОтпечатокПодписиСущностей = СоответствиеПараметров.Получить("ОтпечатокСущностей");
		
		ОтпечатокПодписиЗаголовка = СоответствиеПараметров.Получить("ОтпечатокЗаголовка");
		
		Если ОтпечатокПодписиСущностей = Неопределено И ОтпечатокПодписиЗаголовка = Неопределено Тогда
			//В параметрах не указано, что необходимо что-то подписывать, значит и подписывать ничего не будем
			ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Истина);
			Возврат;
		КонецЕсли;

		КонтекстВыполнения.Вставить("Данные", Данные);
		КонтекстВыполнения.Вставить("ОтпечатокПодписиСущностей", ОтпечатокПодписиСущностей);
		КонтекстВыполнения.Вставить("ОтпечатокПодписиЗаголовка", ОтпечатокПодписиЗаголовка);
		КонтекстВыполнения.Вставить("Результат", Истина);
		
		ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(
			Новый ОписаниеОповещения("НачатьПодготовкуКОтправкеСпискаЗаданийПослеСозданияМенеджераКриптографии",
				ЭтотОбъект, КонтекстВыполнения),"");
				
	ИначеЕсли КонтекстВыполнения.Версия = 1.16 Тогда

		СоответствиеЗаданий = ГосУслуги.ПолучитьДанныеПодготовкиСпискаЗаданий_1_16(КонтекстВыполнения.СписокЗаданий);
			
		//Подменяем общую обработку оповещения на свою и обрабатываем задания в цикле. 
		//После обработки каждого задания пишем результат обработки этого задания и текст ошибок.
		//После обработки всех заданий выполняем общую обработку.
		
		ПродолжатьПослеОбработки = Неопределено;
		КонтекстВыполнения.Свойство("ПродолжитьПослеПодготовки",ПродолжатьПослеОбработки);
		КонтекстВыполнения.Вставить("СтруктураРезультата","Результат,ТекстОшибки,ИмяФайла");
		КонтекстВыполнения.Вставить("СоответствиеРезультатовПодготовки", Новый Соответствие);
		
		КонтекстВыполнения.Вставить("ПослеПодготовкиЗадания",Новый ОписаниеОповещения("ПослеПодготовкиЗадания", ЭтотОбъект));	
		
		Для Каждого КлючИЗначение Из СоответствиеЗаданий Цикл
			КонтекстВыполнения.Вставить("ТекущееЗадание",КлючИЗначение.Ключ);
			КонтекстВыполнения.Вставить("ТекстОшибки","");
			КонтекстВыполнения.Вставить("ИмяФайла","");
			ПодписатьДанныеПоФормату_1_16(КонтекстВыполнения,КлючИЗначение.Значение);
		КонецЦикла;
		
		ЕстьОшибки = ГосУслуги.ПродолжениеПодготовкиФайлов_1_16(КонтекстВыполнения.СоответствиеРезультатовПодготовки);
		
		Если ПродолжатьПослеОбработки<>Неопределено Тогда
			ВыполнитьОбработкуОповещения(ПродолжатьПослеОбработки,НЕ ЕстьОшибки);
		КонецЕсли;
		
	Иначе
		ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Истина);
	КонецЕсли;

КонецПроцедуры

Процедура ПослеПодготовкиЗадания(КонтекстВыполнения,ДопПараметр) Экспорт
	СтруктураРезультата = Новый Структура(КонтекстВыполнения.СтруктураРезультата);
	ЗаполнитьЗначенияСвойств(СтруктураРезультата,КонтекстВыполнения);
	КонтекстВыполнения.СоответствиеРезультатовПодготовки.Вставить(КонтекстВыполнения.ТекущееЗадание,СтруктураРезультата);
КонецПроцедуры

Процедура НачатьПодготовкуКОтправкеСпискаЗаданийПослеСозданияМенеджераКриптографии(МенеджерКриптографии, КонтекстВыполнения) Экспорт
	
	Если ТипЗнч(МенеджерКриптографии) <> Тип("МенеджерКриптографии") Тогда
		ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);		
		Возврат;
	КонецЕсли;
	
	мХранилищеСертификатов = МенеджерКриптографии.ПолучитьХранилищеСертификатов();
	
	Если ЗначениеЗаполнено(КонтекстВыполнения.ОтпечатокПодписиСущностей) Тогда
		ДвоичныеДанныеОтпечаткаСущности = Base64Значение(КонтекстВыполнения.ОтпечатокПодписиСущностей);
		СертификатСущности = мХранилищеСертификатов.НайтиПоОтпечатку(ДвоичныеДанныеОтпечаткаСущности);
	КонецЕсли;
		
	Если ЗначениеЗаполнено(КонтекстВыполнения.ОтпечатокПодписиЗаголовка) Тогда
		ДвоичныеДанныеОтпечаткаЗаголовка = Base64Значение(КонтекстВыполнения.ОтпечатокПодписиЗаголовка);
		СертификатЗаголовка = мХранилищеСертификатов.НайтиПоОтпечатку(ДвоичныеДанныеОтпечаткаЗаголовка);
	КонецЕсли;
		
    СущностьНеПодписана = Ложь;
	Если КонтекстВыполнения.ОтпечатокПодписиСущностей<>Неопределено И СертификатСущности = Неопределено Тогда
		СущностьНеПодписана = Истина;
	КонецЕсли;
	
	ЗаголовокНеПодписан = Ложь;
	Если КонтекстВыполнения.ОтпечатокПодписиЗаголовка<>Неопределено И СертификатЗаголовка = Неопределено Тогда
		ЗаголовокНеПодписан = Истина;
	КонецЕсли;
	
	СоответствияЗаданийИФайлов = КонтекстВыполнения.Данные.Получить("ЗаданияИФайлы");
	ДанныеСертификатаСущности = "";	
	Если СертификатСущности <> Неопределено Тогда
		ДанныеСертификатаСущности = Base64Строка(СертификатСущности.Выгрузить());
		ДанныеСертификатаСущности = СтрЗаменить(ДанныеСертификатаСущности,Символы.ВК,"");
	КонецЕсли;
	
	ДанныеСертификатаЗаголовка = "";
	Если СертификатЗаголовка <> Неопределено Тогда
		ДанныеСертификатаЗаголовка = Base64Строка(СертификатЗаголовка.Выгрузить());
		ДанныеСертификатаЗаголовка = СтрЗаменить(ДанныеСертификатаЗаголовка,Символы.ВК,"");
	КонецЕсли;
	
	//
	Попытка
		КомпонентаПодписи = СоздатьОбъектДляПодписиXMLDSIG();
		Если КомпонентаПодписи = Неопределено Тогда
			ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
			Возврат;
		КонецЕсли;
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось создать компоненту для формирования электронной подписи.'"));
	    КомпонентаПодписи = Неопределено;
	КонецПопытки;
	//Если КомпонентаПодписи = Неопределено Тогда
	//	Возврат Ложь;
	//КонецЕсли;
	
	СоответствиеРезультатовПодготовки = Новый Соответствие;
	
	СоответствиеОбновленныхФайлов = Новый Соответствие;	
	
	МассивНеПодписанных = Новый Массив;
	
	Для Каждого ГлКлючИЗначение Из СоответствияЗаданийИФайлов Цикл
	
		ФайлыДляПереноса = ГлКлючИЗначение.Значение;
			
		СоответствиеРезультатовПодготовкиПоЗаданию = Новый Соответствие;
		
		Для Каждого КлючИЗначение ИЗ ФайлыДляПереноса Цикл
			
			Если КомпонентаПодписи = Неопределено Тогда
				ТекстОшибки = НСтр("ru='Не удалось подключить компоненту для формирования ЭП. Подпись не выполнена'");
				СоответствиеРезультатовПодготовкиПоЗаданию.Вставить(КлючИЗначение.Ключ,ТекстОшибки);
				Если МассивНеПодписанных.Найти(ГлКлючИЗначение.Ключ)=Неопределено Тогда
					МассивНеПодписанных.Добавить(ГлКлючИЗначение.Ключ);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
						
			СодержимоеФайла = КлючИЗначение.Значение;
			
			ЕстьИзменения = Ложь;
					
			//Подпись начисления (документ "Квитанция на оплату")
			Если Найти(СодержимоеФайла,"<Charge")>0 И СущностьНеПодписана Тогда
				ТекстОшибки = НСтр("ru='Не удалось подписать начисление. Не найден сертификат для подписи сущности по установленному отпечатку. Проверьте установленные сертификаты.'");
				//ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать начисление. Не найден сертификат для подписи сущности по установленному отпечатку. Проверьте установленные сертификаты.'"));
				СоответствиеРезультатовПодготовкиПоЗаданию.Вставить(КлючИЗначение.Ключ,ТекстОшибки);
				Если МассивНеПодписанных.Найти(ГлКлючИЗначение.Ключ)=Неопределено Тогда
					МассивНеПодписанных.Добавить(ГлКлючИЗначение.Ключ);
				КонецЕсли;
				//Возврат Ложь;
				Продолжить;
			ИначеЕсли Найти(СодержимоеФайла,"<Catalog")>0 И СущностьНеПодписана Тогда
				//ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать каталог услуг. Не найден сертификат для подписи сущности по установленному отпечатку. Проверьте установленные сертификаты.'"));	
				//Возврат Ложь;
				Если МассивНеПодписанных.Найти(ГлКлючИЗначение.Ключ)=Неопределено Тогда
					МассивНеПодписанных.Добавить(ГлКлючИЗначение.Ключ);
				КонецЕсли;
				ТекстОшибки = НСтр("ru='Не удалось подписать каталог услуг. Не найден сертификат для подписи сущности по установленному отпечатку. Проверьте установленные сертификаты.'");
				СоответствиеРезультатовПодготовкиПоЗаданию.Вставить(КлючИЗначение.Ключ,ТекстОшибки);
				Продолжить;
			Иначе
				
				ТегИмпортРеквест = "pirs:ImportRequest";
				ДлинаТегаИмпортРеквест = СтрДлина(ТегИмпортРеквест)+1; 
				
				НачальнаяПозиция = Найти(СодержимоеФайла,"<" + ТегИмпортРеквест);
				НачальныйБлок = Сред(СодержимоеФайла,1, НачальнаяПозиция-1);
			    КонечнаяПозиция = Найти(СодержимоеФайла,"</"+ТегИмпортРеквест+">");
				БлокПодписи = Сред(СодержимоеФайла,НачальнаяПозиция,КонечнаяПозиция+ДлинаТегаИмпортРеквест + 2 -НачальнаяПозиция);
				КонечныйБлок = Сред(СодержимоеФайла,КонечнаяПозиция + ДлинаТегаИмпортРеквест + 2);
				
				
				Если Найти(СодержимоеФайла,"<Charge")>0 И СертификатСущности <> Неопределено Тогда
				    Попытка
					    //Тут будет подпись сущности внешней компонентой
						Если КомпонентаПодписи.XMLDSign(БлокПодписи, "Charge", ДанныеСертификатаСущности, Истина, Истина) Тогда
							СодержимоеФайла = НачальныйБлок + КомпонентаПодписи.Sign + КонечныйБлок;
							ЕстьИзменения = Истина;
						Иначе
							ТекстОшибки = НСтр("ru='Не удалось подписать начисление.'");
							СоответствиеРезультатовПодготовкиПоЗаданию.Вставить(КлючИЗначение.Ключ,ТекстОшибки);
							//ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать начисление.'"));
							//Возврат Ложь;
							Продолжить;
						КонецЕсли;
					Исключение
						ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать начисление.'");
						СоответствиеРезультатовПодготовкиПоЗаданию.Вставить(КлючИЗначение.Ключ,ТекстОшибки);
						Если МассивНеПодписанных.Найти(ГлКлючИЗначение.Ключ)=Неопределено Тогда
							МассивНеПодписанных.Добавить(ГлКлючИЗначение.Ключ);
						КонецЕсли;
						Продолжить;
						//ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать начисление.'"));
						//Возврат Ложь;					
					КонецПопытки;
					
				КонецЕсли;
				
				// Подпись каталога услуг
				Если Найти(СодержимоеФайла,"<ServiceCatalog")>0 И СертификатСущности <> Неопределено Тогда		
	                Попытка
						//Подпись сущности внешней компонентой
						Если КомпонентаПодписи.XMLDSign(БлокПодписи, "ServiceCatalog", ДанныеСертификатаСущности, Истина, Истина) Тогда
							СодержимоеФайла = НачальныйБлок + КомпонентаПодписи.Sign + КонечныйБлок;
							ЕстьИзменения = Истина;
						Иначе
							//ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать каталог услуг.'"));
							//Возврат Ложь;
							
							ТекстОшибки = НСтр("ru='Не удалось подписать каталог услуг.'");
							СоответствиеРезультатовПодготовкиПоЗаданию.Вставить(КлючИЗначение.Ключ,ТекстОшибки);
							Продолжить;
						КонецЕсли;
					Исключение
						//ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать каталог услуг.'"));
						//Возврат Ложь;
						Если МассивНеПодписанных.Найти(ГлКлючИЗначение.Ключ)=Неопределено Тогда
							МассивНеПодписанных.Добавить(ГлКлючИЗначение.Ключ);
						КонецЕсли;
						ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать каталог услуг.'");
						СоответствиеРезультатовПодготовкиПоЗаданию.Вставить(КлючИЗначение.Ключ,ТекстОшибки);
						Продолжить;

					КонецПопытки;								
				КонецЕсли;
				
				// Подпись измененного каталога услуг
				Если Найти(СодержимоеФайла,"<Changes")>0 И СертификатСущности <> Неопределено Тогда
					Попытка
						//Подпись сущности внешней компонентой
						Если КомпонентаПодписи.XMLDSign(БлокПодписи, "Changes", ДанныеСертификатаСущности, Истина, Истина) Тогда
							СодержимоеФайла = НачальныйБлок + КомпонентаПодписи.Sign + КонечныйБлок;
							ЕстьИзменения = Истина;
						Иначе
							//ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать каталог услуг.'"));
							//Возврат Ложь;
							ТекстОшибки = НСтр("ru='Не удалось подписать каталог услуг.'");
							СоответствиеРезультатовПодготовкиПоЗаданию.Вставить(КлючИЗначение.Ключ,ТекстОшибки);
							Продолжить;
						КонецЕсли;
					Исключение
						//ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать каталог услуг.'"));
						//Возврат Ложь;
						Если МассивНеПодписанных.Найти(ГлКлючИЗначение.Ключ)=Неопределено Тогда
							МассивНеПодписанных.Добавить(ГлКлючИЗначение.Ключ);
						КонецЕсли;
						ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать каталог услуг.'");
						СоответствиеРезультатовПодготовкиПоЗаданию.Вставить(КлючИЗначение.Ключ,ТекстОшибки);
						Продолжить;
					КонецПопытки;	
				КонецЕсли;
			КонецЕсли;
			
			
			Если Найти(СодержимоеФайла,"<soapenv:Body")>0 И ЗаголовокНеПодписан Тогда
				//ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать soap-пакет. Не найден сертификат для подписи заголовка soap-пакета по установленному отпечатку. Проверьте установленные сертификаты.'"));	
				//Возврат Ложь;
				ТекстОшибки = НСтр("ru='Не удалось подписать soap-пакет. Не найден сертификат для подписи заголовка soap-пакета по установленному отпечатку. Проверьте установленные сертификаты.'");
				СоответствиеРезультатовПодготовкиПоЗаданию.Вставить(КлючИЗначение.Ключ,ТекстОшибки);
				Продолжить;
			Иначе
				
				Если Найти(СодержимоеФайла,"<soapenv:Body")>0 И СертификатЗаголовка <> Неопределено Тогда
					НачальныйЗаголовок = "";
					Если Найти(СодержимоеФайла,"<?xml")>0 Тогда
						Позиция = Найти(СодержимоеФайла, "?>");
						Количество = 2;
						Если Сред(СодержимоеФайла,Позиция+2,1)=Символы.ПС Тогда
							Количество = 3;
						КонецЕсли;
						НачальныйЗаголовок = Лев(СодержимоеФайла,Позиция+2);
						СодержимоеФайлаБезЗаголовка = Сред(СодержимоеФайла,Позиция+Количество);
					КонецЕсли;
					
					ПозицияУТМ = Найти(СодержимоеФайлаБезЗаголовка,"<n1:UnifoTransferMsg");
					ТекстДоУТМ = Лев(СодержимоеФайлаБезЗаголовка,ПозицияУТМ);
					ТекстДоУТМ = СтрЗаменить(СтрЗаменить(ТекстДоУТМ,Символы.ПС,""),Символы.Таб,"");
					
					ПозицияКонецУТМ = Найти(СодержимоеФайлаБезЗаголовка,"</n1:UnifoTransferMsg");
					ТекстКонец = Сред(СодержимоеФайлаБезЗаголовка,ПозицияКонецУТМ);
					ТекстКонец = СтрЗаменить(СтрЗаменить(ТекстКонец,Символы.ПС,""),Символы.Таб,"");
					
					ТекстСередина = Сред(СодержимоеФайлаБезЗаголовка,ПозицияУТМ+1,ПозицияКонецУТМ-1-ПозицияУТМ);
					СодержимоеФайлаБезЗаголовка = ТекстДоУТМ + ТекстСередина+ТекстКонец;
					
								
					//Вставляем сертификат в заголовок
					СодержимоеФайлаБезЗаголовка = СтрЗаменить(СодержимоеФайлаБезЗаголовка,"%СертификатЗаголовка%",ДанныеСертификатаЗаголовка);
									
					ИмяИскомогоТега = "</wsse:BinarySecurityToken>";
					ДлинаИскомогоТега = СтрДлина(ИмяИскомогоТега);
					
					НачальнаяПозиция = Найти(СодержимоеФайлаБезЗаголовка, ИмяИскомогоТега);
					НачальныйБлок  = Сред(СодержимоеФайлаБезЗаголовка,1, НачальнаяПозиция+ДлинаИскомогоТега-1);
					
					КонечнаяПозиция = НачальнаяПозиция+ДлинаИскомогоТега;
					КонечныйБлок = СокрЛ(Сред(СодержимоеФайлаБезЗаголовка,КонечнаяПозиция));
					
					БлокПодписи = "";
					Попытка
						//Подпись заголовка soap-пакета внешней компонентой
						Если КомпонентаПодписи.XMLDSign(СодержимоеФайлаБезЗаголовка, "Body", ДанныеСертификатаЗаголовка, Ложь, Ложь) Тогда
							СодержимоеФайла = НачальныйЗаголовок + НачальныйБлок + КомпонентаПодписи.Sign + КонечныйБлок;
							ЕстьИзменения = Истина;
						Иначе
							//ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось подписать заголовок soap-пакета.'"));
							//Возврат Ложь;
							ТекстОшибки = НСтр("ru='Не удалось подписать заголовок soap-пакета.'");
							СоответствиеРезультатовПодготовкиПоЗаданию.Вставить(КлючИЗначение.Ключ,ТекстОшибки);
							Продолжить;
						КонецЕсли;				
					Исключение
						//ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать заголовок soap-пакета.'"));
						//Возврат Ложь;
						Если МассивНеПодписанных.Найти(ГлКлючИЗначение.Ключ)=Неопределено Тогда
							МассивНеПодписанных.Добавить(ГлКлючИЗначение.Ключ);
						КонецЕсли;
						ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать заголовок soap-пакета.'");
						СоответствиеРезультатовПодготовкиПоЗаданию.Вставить(КлючИЗначение.Ключ,ТекстОшибки);
						Продолжить;

					КонецПопытки;				
				КонецЕсли;
			КонецЕсли;
			
			Если ЕстьИзменения Тогда 
				СоответствиеОбновленныхФайлов.Вставить(КлючИЗначение.Ключ,СодержимоеФайла);
			КонецЕсли;					
		КонецЦикла;
		
		СоответствиеРезультатовПодготовки.Вставить(ГлКлючИЗначение.Ключ,СоответствиеРезультатовПодготовкиПоЗаданию);
	КонецЦикла;
	
	Результат = НЕ ГосУслуги.ПродолжениеПодготовкиФайлов(СоответствиеОбновленныхФайлов,СоответствиеРезультатовПодготовки,МассивНеПодписанных);
	
	ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Результат);
	
КонецПроцедуры

//

// Подпись начислений отдельно от отправки
Процедура ПодписатьНачисления(ТЧДляПодписи,ИмяУзла,КомпонентаПодписи) Экспорт
	
	СтруктураТребований = ГосУслуги.ПолучитьСтруктуруТребованийКомпоненты();
	
	НужнаКомпонента = Истина;
	
	#Если ВебКлиент Тогда
		//обращение к TSA серверу выполняется только на сервере
		СтруктураТребований.ОбращатьсяКTSAСерверуНаСервере = Истина;
	#КонецЕсли
	
	Если СтруктураТребований.ОбращатьсяКTSAСерверуНаСервере = Истина
		И СтруктураТребований.ПодписыватьСообщенияДляГИСГМПНаСервере = Истина Тогда
		
		ГосУслуги.ПодписатьНачисления_НаСервере(ТЧДляПодписи,ИмяУзла);
		
	Иначе
		ДлинаТега = СтрДлина(ИмяУзла);
		
		
		Для Каждого СтрТЧ Из ТЧДляПодписи Цикл
			Если НЕ ЗначениеЗаполнено(СтрТЧ.РезультатФормирования) Тогда
				ТекстСообщения = НСтр("ru='Не удалось подписать начисление """+СтрТЧ.Объект+""" по причине: не удалось сформировать файл по причине: "+СтрТЧ.ТекстОшибки+"'");
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
				Продолжить;
			КонецЕсли;
			
			ПозицияНачалаФайла = 1;
			Если СтрНачинаетсяС(СтрТЧ.РезультатФормирования,"<?")  Тогда
				ПозицияНачалаФайла = СтрНайти(СтрТЧ.РезультатФормирования,"?>")+2;
				СтрТЧ.РезультатФормирования = СокрЛП(Сред(СтрТЧ.РезультатФормирования,ПозицияНачалаФайла));
			КонецЕсли;
		
			//Если Найти(СтрТЧ.РезультатФормирования,"<?xml version=""1.0"" encoding=""UTF-8""?>")>0 Тогда
			//	СтрТЧ.РезультатФормирования = СтрЗаменить(СтрТЧ.РезультатФормирования,"<?xml version=""1.0"" encoding=""UTF-8""?>"+Символы.ПС,"");		
			//КонецЕсли;
			
			Попытка
				
				ДанныеСертификата = СтрТЧ.СертификатЭПНачислений;		 
				
				НачальнаяПозиция = Найти(СтрТЧ.РезультатФормирования,"<" + ИмяУзла);
				НачальныйБлок = Сред(СтрТЧ.РезультатФормирования,1, НачальнаяПозиция-1);
			    КонечнаяПозиция = Найти(СтрТЧ.РезультатФормирования,"</"+ИмяУзла+">");
				БлокПодписи = Сред(СтрТЧ.РезультатФормирования,НачальнаяПозиция,КонечнаяПозиция+ДлинаТега + 3 -НачальнаяПозиция);
				КонечныйБлок = Сред(СтрТЧ.РезультатФормирования,КонечнаяПозиция + ДлинаТега + 3);
				
				ИдентификаторТекущейПодписи = "_" + Строка(Новый УникальныйИдентификатор());
				
				Если СтруктураТребований.ПодписыватьСообщенияДляГИСГМПНаСервере = Истина Тогда
						
					СтруктураПодписи = ГосУслуги.ПодписатьБлокXML_XadesT(ИдентификаторТекущейПодписи,БлокПодписи,ИмяУзла,ДанныеСертификата,"",Истина,Истина,СтрТЧ.ПарольЭПНачисления);
					
					Если СтруктураПодписи.Свойство("ТекстОшибки") Тогда
						
						ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать начисление %1.
							|%2'");
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,СтрТЧ.Объект,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),СтруктураПодписи.ТекстОшибки);
									
						СтрТЧ.РезультатФормирования = "";

						ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
										
						Возврат;
						
					Иначе
					
						ТелоЗапроса64 = СтруктураПодписи.ТелоЗапроса64;
						Подпись = СтруктураПодписи.Подпись;
					КонецЕсли;
				Иначе
					//В версии 2.2.1.0 добавлено свойство СообщатьОбОшибке Булево и ТекстОшибки Строка
					КомпонентаПодписи.СообщатьОбОшибке = Ложь; //Если ложь, то компонента сама не будет выдавать сообщения об ошибке.
					КомпонентаПодписи.SignatureID = ИдентификаторТекущейПодписи;
					
					Попытка 			
						КомпонентаПодписи.ПодписатьXadesT(
							БлокПодписи,
							ИмяУзла,
							ДанныеСертификата,"",
							//Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"),
							Истина,
							Истина,
							СтрТЧ.ПарольЭПНачисления);
							
						Подпись = КомпонентаПодписи.Подпись;
						ТелоЗапроса64 = КомпонентаПодписи.ПолучитьТелоЗапросаКTSA();
					Исключение
						ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать начисление %1.
							|%2
							|Описание ошибки внешней компоненты: %3'");
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,СтрТЧ.Объект,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),КомпонентаПодписи.ТекстОшибки);
					
						СтрТЧ.РезультатФормирования = "";

						ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);					
						
						Продолжить;
					КонецПопытки;
				КонецЕсли;
								
				РезультатОтправки = ОтправитьЗапросКTSAСерверу(СтрТЧ.АдресTSA,СтрТЧ.НастройкаTSA,ТелоЗапроса64,"начисление",СтруктураТребований.ОбращатьсяКTSAСерверуНаСервере);
						
				Если РезультатОтправки.Успех = Истина Тогда
						
					Если СтруктураТребований.ПодписыватьСообщенияДляГИСГМПНаСервере = Истина Тогда
						ТекстОшибки = "";
						Подпись = ГосУслуги.ПоставитьШтампВремени(ИдентификаторТекущейПодписи,Подпись,РезультатОтправки.ТекстОтвета,ТекстОшибки);
						
						Если ЗначениеЗаполнено(ТекстОшибки) Тогда
							СтрТЧ.РезультатФормирования = "";

							ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
							Продолжить;	
						КонецЕсли;
						
					Иначе
						Попытка
							КомпонентаПодписи.ПоставитьШтампВремени(РезультатОтправки.ТекстОтвета);
							Подпись = КомпонентаПодписи.Подпись;
						Исключение
							ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось поставить штамп времени в подпись начисления %1.
								|%2
								|Описание ошибки внешней компоненты: %3'");
							ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,СтрТЧ.Объект,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),КомпонентаПодписи.ТекстОшибки);
						
							СтрТЧ.РезультатФормирования = "";

							ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
							Продолжить;
						КонецПопытки;
					КонецЕсли;
										
					СтрТЧ.РезультатФормирования = Сред(СтрТЧ.РезультатФормирования,1, КонечнаяПозиция - 1) + Подпись + Сред(СтрТЧ.РезультатФормирования,КонечнаяПозиция);
				
					ФайлОбработан = Истина;
						
				Иначе
					ТекстОшибки = РезультатОтправки.ТекстОшибки;
					
					СтрТЧ.РезультатФормирования = "";
					ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);

				КонецЕсли;
				
			Исключение
				
				ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать начисление %1.
						|%2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,СтрТЧ.Объект,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
				СтрТЧ.РезультатФормирования = "";

				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);					
			КонецПопытки;
					
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

