
//Одно задание

Процедура НачатьПодготовкуКОтправке(КонтекстВыполнения) Экспорт
	
	Если НЕ КонтекстВыполнения.Свойство("Версия") Тогда
		КонтекстВыполнения.Вставить("Версия",1.15);
	КонецЕсли;
	
	Если КонтекстВыполнения.Версия = 1.15 Тогда
		
		СертификатСущности = Неопределено;
		СертификатЗаголовка = Неопределено;
			
		Данные = ГосУслуги.ПолучитьДанныеПодготовки(КонтекстВыполнения.ЗаданиеНаЭкспортСсылка);
		
		Если НЕ Данные.Получить("НужнаПодготовка") Тогда
			ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Истина);
			Возврат;
		КонецЕсли;
		
		СоответствиеПараметров = Данные.Получить("СоответствиеПараметров");
		
		ОтпечатокПодписиСущностей = СоответствиеПараметров.Получить("ОтпечатокСущностей");
		
		ОтпечатокПодписиЗаголовка = СоответствиеПараметров.Получить("ОтпечатокЗаголовка");
		
		Если ОтпечатокПодписиСущностей = Неопределено И ОтпечатокПодписиЗаголовка = Неопределено Тогда
			//В параметрах не указано, что необходимо что-то подписывать, значит и подписывать ничего не будем
			ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Истина);
			Возврат;
		КонецЕсли;
		
		КонтекстВыполнения.Вставить("Данные", Данные);
		КонтекстВыполнения.Вставить("ОтпечатокПодписиСущностей", ОтпечатокПодписиСущностей);
		КонтекстВыполнения.Вставить("ОтпечатокПодписиЗаголовка", ОтпечатокПодписиЗаголовка);
		КонтекстВыполнения.Вставить("Результат", Истина);
		
		ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(
			Новый ОписаниеОповещения("НачатьПодготовкуКОтправкеПослеСозданияМенеджераКриптографии",
				ЭтотОбъект, КонтекстВыполнения),"");
	
	ИначеЕсли КонтекстВыполнения.Версия = 1.16 Тогда
			
		// нужна другая процедура получения данных подготовки - с настройками из регистра НастройкаОрганизацийДляГИСГМП_УНП
		Данные = ГосУслуги.ПолучитьДанныеПодготовки_1_16(КонтекстВыполнения.ЗаданиеНаЭкспортСсылка);
	
		ПодписатьДанныеПоФормату_1_16(КонтекстВыполнения,Данные);
		
	Иначе
		ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Истина);
	КонецЕсли;	
КонецПроцедуры

Процедура ПодписатьДанныеПоФормату_1_16(КонтекстВыполнения,Данные)
	//если в файле - пакет начислений, то начисления по документам "Квитанция на оплату" и "Начисление от подведомственно" 
	//могут иметь различные сертификаты подписи - сущностей. Подпись заголовка всегда одна - подпись отправителя, которого следует получить по организации, 
	//выбранной в документе.
	//чтобы получить подписи сущностей - нужно выделять блоки сущностей, в них есть аттрибут ID - он формируется как  "N_" + ГУИД документа
	//из этих блоков можно по ГУИД найти документ и по документу опеределить сертификат.
		
		
	//Варианта 4:
	// 1 - подпись выполняется на клиенте, обращение к TSA серверу выполняется на клиенте
	// 2 - подпись выполняется на клиенте, обращение к TSA серверу выполняется на сервере
	// 3 - подпись выполняется на сервере, обращение к TSA серверу выполняется на клиенте
	// 4 - подпись выполняется на сервере, обращение к TSA серверу выполняется на сервере
	
	#Если ВебКлиент Тогда
		//обращение к TSA серверу выполняется только на сервере
		Данные["ОбращатьсяКTSAСерверуНаСервере"] = Истина;
	#КонецЕсли
	
	Если Данные["ОбращатьсяКTSAСерверуНаСервере"] = Истина
		И Данные["ПодписыватьСообщенияДляГИСГМПНаСервере"] = Истина Тогда
		//вариант 4
		СтруктураКонтекстаДляСервера = Новый Структура();
		Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
			СтруктураКонтекстаДляСервера.Вставить("ТекстОшибки",КонтекстВыполнения.ТекстОшибки);
		КонецЕсли;
		
		Результат  = ГосУслуги.ПодписатьДанныеПоФормату_1_16_НаСервере(СтруктураКонтекстаДляСервера,Данные);
		
		Для Каждого КлючИЗначение Из СтруктураКонтекстаДляСервера Цикл
			КонтекстВыполнения.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		
		ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Результат);
				
	Иначе
		
		Если Данные["ПодписыватьСообщенияДляГИСГМПНаСервере"] = Ложь Тогда
			КомпонентаПодписи = КонтекстВыполнения.КомпонентаПодписи;
	    	
			Если КомпонентаПодписи = Неопределено Тогда
				ТекстОшибки = НСтр("ru='Не удалось создать компоненту для формирования электронной подписи.'");
				
				Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
					КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
				Иначе
					ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
				КонецЕсли;
				ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
				Возврат;
			Иначе
				//В версии 2.2.1.0 добавлено свойство СообщатьОбОшибке Булево и ТекстОшибки Строка
				КомпонентаПодписи.СообщатьОбОшибке = Ложь; //Если ложь, то компонента сама не будет выдавать сообщения об ошибке.
			КонецЕсли;
		КонецЕсли;
	
		ФайлыДляПереноса = Данные.Получить("ФайлыДанных");
		
		// а теперь парсим и ищем блоки подписей:
		//DoAcknowledgmentRequest - 1 элемент
		//ServiceCatalog - 1 элемент
		//Changes - 1 элемент
		//ExportRequest - 1 элемент
		//Charge - только тут могут быть разные сертификаты, а самих блоков в файле - несколько. Обрабатывается отдельно.
		
		МассивОдиночных = Новый Массив;
		МассивОдиночных.Добавить("DoAcknowledgmentRequest"); //квитирование		
		МассивОдиночных.Добавить("ExportRequest");  //запрос к системе
		МассивОдиночных.Добавить("ServiceCatalog"); //каталог услуг ИС РНИП или ИС УНП
		МассивОдиночных.Добавить("Changes");        //каталог услуг ИС РНИП или ИС УНП
				
		ВыражениеID = " Id=""";
		
		ТекПакетНачислений = Данные["ПакетНачислений"];
		
		СоответствиеОбновленныхФайлов = Новый Соответствие;
		
		НастройкиОтправителя = Данные["СоответствиеНастроекОтправителей"][Данные["Организация"]];
		
		//Принцип использования подписей участников следующий:
		//1) для подписи заголовка всегда используется сертификат заголовка отправителя - организации - прямого участника.
		//2) для подписи сущностей ExportRequest, DoAcknowledgmentRequest - всегда используется сертификат для подписи начислений отправителя - организации - прямого участника,
		//		т.к. предполагается, что все запросы к системе выполняет отправитель (АН - для себя, ГАН - для себя и подведомственных). 
		//		Такой сценарий был реализован для форматов 1.15, его и придерживаемся.
		//3) для подписи сущностей ServiceCatalog, Changes - всегда используется сертификат для подписи начислений отправителя - организации - прямого участника, 
		//		т.к. косвенного взаимодействия при обмене с ИС РНИП и ИС УНП не предусматривается.
		//4) для подписи начислений используется сертификат участника - сформировавшего начисление:
		//		- в документе "Квитанция на оплату" участник - в реквизите Организация - это может быть как участник прямого взаимодейстия, так и косвенного.
		//		- в документе "Начисление от подведомственного" участник - в реквизите Получатель - это участник косвенного взаимодействия.
		Отправитель = Неопределено;
		Если НастройкиОтправителя <> Неопределено Тогда
			ДанныеСертификатаСущности = НастройкиОтправителя.ДанныеСертификатаНачислений;
			ДанныеСертификатаЗаголовка= НастройкиОтправителя.ДанныеСертификатаСообщения;
			Отправитель = Данные["Организация"];
		Иначе
			НастройкиПодведомственного = Данные["СоответствиеНастроекПодведомственных"][Данные["Организация"]];
			
			Если НастройкиПодведомственного = Неопределено Тогда
				ТекстОшибки = "Для организации """ + Данные["Организация"]+""" не заданы настройки участника. Подпись не выполнена.";
						
				Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
					КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
				Иначе
					ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
				КонецЕсли;
			
				ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
				
				Возврат;
			КонецЕсли;                                                         
			
			НастройкиОтправителя = Данные["СоответствиеНастроекОтправителей"][НастройкиПодведомственного.Отправитель];			
			
			Если НастройкиОтправителя <> Неопределено Тогда
				ДанныеСертификатаЗаголовка = НастройкиОтправителя.ДанныеСертификатаСообщения;
				ДанныеСертификатаСущности = НастройкиОтправителя.ДанныеСертификатаНачислений;
				Отправитель = НастройкиПодведомственного.Отправитель;

			КонецЕсли;
		КонецЕсли;

		
		ПодписыватьXMLDSIG = Ложь;
		Тип_ЭП = Неопределено;
		Если Данные["СтруктураПараметровВидаОбмена"].Свойство("ТИП_ЭП",Тип_ЭП) Тогда
			ПодписыватьXMLDSIG = Тип_ЭП = "XMLDSIG";
		КонецЕсли;
		ИмяБлокаObject = "Object";
		ДлинаБлокаObject = СтрДлина(ИмяБлокаObject);
				
		Для Каждого КлючИЗначение ИЗ ФайлыДляПереноса Цикл
		    КонтекстВыполнения.Вставить("ИмяФайла",КлючИЗначение.Ключ);
			
			СодержимоеФайла = КлючИЗначение.Значение;
		
			ЕстьИзменения = Ложь;
			ФайлОбработан = Ложь;		
				
			Для Каждого ЭлМас Из МассивОдиночных Цикл
				НачальнаяПозиция = Найти(СодержимоеФайла,"<"+ЭлМас);
				Если НачальнаяПозиция = 0 Тогда
					Продолжить;
				КонецЕсли;
				ДлинаПодписываемогоТега = СтрДлина(ЭлМас);
				
				НачальныйБлок = Сред(СодержимоеФайла,1, НачальнаяПозиция-1);
		    	КонечнаяПозиция = Найти(СодержимоеФайла,"</"+ЭлМас+">");
				БлокПодписи = Сред(СодержимоеФайла,НачальнаяПозиция,КонечнаяПозиция+ДлинаПодписываемогоТега + 3 - НачальнаяПозиция);
				КонечныйБлок = Сред(СодержимоеФайла,КонечнаяПозиция + ДлинаПодписываемогоТега + 3);						
				
				Попытка
					
					ИдентификаторТекущейПодписи = "_" + Строка(Новый УникальныйИдентификатор()); 
					
					Если Данные["ПодписыватьСообщенияДляГИСГМПНаСервере"] = Истина Тогда
						
						СтруктураПодписи = ГосУслуги.ПодписатьБлокXML_XadesT(ИдентификаторТекущейПодписи,БлокПодписи,ЭлМас,ДанныеСертификатаСущности,"",Истина,Истина,НастройкиОтправителя.ПарольЭПНачисления);
						
						Если СтруктураПодписи.Свойство("ТекстОшибки") Тогда
							
							ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать элемент %1.
									|%2'");
							ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ЭлМас,СтруктураПодписи.ТекстОшибки);
							
							Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
								КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
							Иначе
								ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
							КонецЕсли;
					
							ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
											
							Возврат;
							
						Иначе					
							ТелоЗапроса64 = СтруктураПодписи.ТелоЗапроса64;
							Подпись = СтруктураПодписи.Подпись;
						КонецЕсли;
					Иначе
						КомпонентаПодписи.SignatureID = ИдентификаторТекущейПодписи;
						
						Попытка			
							КомпонентаПодписи.ПодписатьXadesT(
								БлокПодписи,
								ЭлМас,
								ДанныеСертификатаСущности,"",
								//Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"),
								Истина,
								Истина,
								НастройкиОтправителя.ПарольЭПНачисления);
								
							Подпись = КомпонентаПодписи.Подпись;
							ТелоЗапроса64 = КомпонентаПодписи.ПолучитьТелоЗапросаКTSA();
						Исключение
							
							ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать элемент %1.
									|%2
									|Описание ошибки внешней компоненты: %3'");
							ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ЭлМас,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),КомпонентаПодписи.ТекстОшибки);
							
							Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
								КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
							Иначе
								ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
							КонецЕсли;
					
							ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
											
							Возврат;
						КонецПопытки;
					КонецЕсли;
					
					Если ПодписыватьXMLDSIG = Истина Тогда
					
						// XMLDSIG
						
						Подпись = Лев(Подпись,Найти(Подпись,"<"+ИмяБлокаObject)-1)+Сред(Подпись,Найти(Подпись,"</"+ИмяБлокаObject)+ДлинаБлокаObject+3);
						СодержимоеФайла = Сред(СодержимоеФайла, 1, КонечнаяПозиция - 1) + Подпись + Сред(СодержимоеФайла,КонечнаяПозиция);
					
					Иначе
						
						РезультатОтправки = ОтправитьЗапросКTSAСерверу(НастройкиОтправителя.АдресTSA,НастройкиОтправителя.СтруктураНастроекТSA,ТелоЗапроса64,ЭлМас,Данные["ОбращатьсяКTSAСерверуНаСервере"]);
						
						Если РезультатОтправки.Успех = Истина Тогда
							
							Если Данные["ПодписыватьСообщенияДляГИСГМПНаСервере"] = Истина Тогда
								ТекстОшибки = "";
								Подпись = ГосУслуги.ПоставитьШтампВремени(ИдентификаторТекущейПодписи,Подпись,РезультатОтправки.ТекстОтвета,ТекстОшибки);
								Если ЗначениеЗаполнено(ТекстОшибки) Тогда
									Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
										КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
									Иначе
										ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
									КонецЕсли;
							
									ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
									Возврат;
								КонецЕсли;
								
							Иначе
								Попытка
									КомпонентаПодписи.ПоставитьШтампВремени(РезультатОтправки.ТекстОтвета);
									Подпись = КомпонентаПодписи.Подпись;
								Исключение
									ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось поставить штамп времени в подпись элемента %1.
											|%2
											|Описание ошибки внешней компоненты: %3'");
									ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ЭлМас,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),КомпонентаПодписи.ТекстОшибки);
									
									Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
										КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
									Иначе
										ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
									КонецЕсли;
							
									ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
									Возврат;
								КонецПопытки;
							КонецЕсли;
							
							СодержимоеФайла = Сред(СодержимоеФайла, 1, КонечнаяПозиция - 1) + Подпись + Сред(СодержимоеФайла,КонечнаяПозиция);
								
						Иначе
							Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
								КонтекстВыполнения.Вставить("ТекстОшибки",РезультатОтправки.ТекстОшибки);
							Иначе
								ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОтправки.ТекстОшибки);
							КонецЕсли;
					
							ОкончаниеПодготовкиКОтправке(КонтекстВыполнения,Ложь);
											
							Возврат;
						КонецЕсли;
						
					КонецЕсли;
				Исключение
					
