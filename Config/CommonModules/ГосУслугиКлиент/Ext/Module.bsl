// компонента подписи

Функция УстановитьВК()
	
	Попытка
		УстановитьВнешнююКомпоненту("ОбщийМакет.КомпонентаXMLDSIG");
	Исключение
		ТекстСообщения = НСтр("ru='Не удалось установить внешнюю компоненту ОбъектXMLDSIG.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;	
	
КонецФункции

Функция ПодключитьВК(ТихийРежим = Истина)
	
	КодВозврата = ПодключитьВнешнююКомпоненту("ОбщийМакет.КомпонентаXMLDSIG", "ОбъектXMLDSIG");
	
	Если НЕ КодВозврата И НЕ ТихийРежим Тогда
		ТекстСообщения = НСтр("ru='Не удалось подключить внешнюю компоненту ОбъектXMLDSIG.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	Возврат КодВозврата;
	
КонецФункции

Функция СоздатьОбъектДляПодписиXMLDSIG() Экспорт
	//создаем объект
	Крипт = НовыйОбъектДляПодписи(Истина);
	Если Крипт = Неопределено Тогда
		
		Если ПодключитьВК(Истина) Тогда
			
			Крипт = НовыйОбъектДляПодписи(Ложь);
			Если Крипт = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
						
		Иначе
			
			Если УстановитьВК() Тогда
				Если ПодключитьВК(Ложь) Тогда
					Крипт = НовыйОбъектДляПодписи(Ложь);
					Если Крипт = Неопределено Тогда
						Возврат Неопределено;
					КонецЕсли;
				Иначе
					Возврат Неопределено;
				КонецЕсли
			Иначе
				Возврат Неопределено;
			КонецЕсли
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Крипт;
	
КонецФункции

Функция НовыйОбъектДляПодписи(ТихийРежим = Истина)
	
	Попытка
		
		Крипт = Новый("Addin.ОбъектXMLDSIG.XMLDSignAddIn");                //
		Возврат Крипт;
		
	Исключение
		
		Если НЕ ТихийРежим Тогда
			ТекстСообщения = НСтр("ru='Не удалось создать объект для подписи xml файлов в формате XMLDSig.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции



// компонента подписи xades

Функция УстановитьВК_xades()
	
	Попытка
		УстановитьВнешнююКомпоненту("ОбщийМакет.Компонента_xades");
	Исключение
		ТекстСообщения = НСтр("ru='Не удалось установить внешнюю компоненту xades.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;	
	
КонецФункции

Функция ПодключитьВК_xades(ТихийРежим = Истина)
	
	КодВозврата = ПодключитьВнешнююКомпоненту("ОбщийМакет.Компонента_xades", "xades");
	
	Если НЕ КодВозврата И НЕ ТихийРежим Тогда
		ТекстСообщения = НСтр("ru='Не удалось подключить внешнюю компоненту xades.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	Возврат КодВозврата;
	
КонецФункции

Функция СоздатьОбъектДляПодписиXML_xades() Экспорт
	//создаем объект
	Крипт = НовыйОбъектДляПодписи_xades(Истина);
	Если Крипт = Неопределено Тогда
		
		Если ПодключитьВК_xades(Истина) Тогда
			
			Крипт = НовыйОбъектДляПодписи_xades(Ложь);
			Если Крипт = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
						
		Иначе
			
			Если УстановитьВК_xades() Тогда
				Если ПодключитьВК_xades(Ложь) Тогда
					Крипт = НовыйОбъектДляПодписи_xades(Ложь);
					Если Крипт = Неопределено Тогда
						Возврат Неопределено;
					КонецЕсли;
				Иначе
					Возврат Неопределено;
				КонецЕсли
			Иначе
				Возврат Неопределено;
			КонецЕсли
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Крипт;
	
КонецФункции

Функция НовыйОбъектДляПодписи_xades(ТихийРежим = Истина)
	
	Попытка
		
		Крипт = Новый("Addin.xades.Xades2AddIn");                //
		Возврат Крипт;
		
	Исключение
		
		Если НЕ ТихийРежим Тогда
			ТекстСообщения = НСтр("ru='Не удалось создать объект для подписи xml файлов в формате XadES-T.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции

//

Асинх Функция ПодписатьДанныеПоФорматуГИСГМП20НаКлиенте(КомпонентаПодписи, Участник,ТЧДанных,Знач ИмяУзлаПодписиСП="",Знач ИмяУзлаПодписиОВ="") Экспорт
	
	//Имя узла подписи СП может меняться - зависит от вида запроса, иногда может отсутствовать.
	//Имя узла подписи ОВ всегда одинаковое - SenderProvidedRequestData
	ТекстОшибки = "";
	Если НЕ ЗначениеЗаполнено(ИмяУзлаПодписиСП)
		И НЕ ЗначениеЗаполнено(ИмяУзлаПодписиОВ) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	
	ШаблонПодписиСП = "%ПодписьСП%";
	
	ШаблонПодписиОВ = "%ПодписьОВ%";
	
	НастройкиПодисиУчастников = ГосУслуги.ПолучитьНастройкиПодписиУчастников20(Участник);
	
	//т.к. компонента если пароль не хранится выводит не информативное окно ввода пароля, то запрашиваем пароль сами	
	//СоответствиеПаролейСертификатов = Новый Соответствие;
	
	Для Каждого СтрокаТЧ ИЗ ТЧДанных Цикл
		
		ТекущийУчастник = СтрокаТЧ.ТекущийУчастник;
		
		НастройкиУчастника = НастройкиПодисиУчастников[ТекущийУчастник];
		Если НастройкиУчастника = Неопределено Тогда
			
			ТекстОшибки = "Для ""%1"" в настройках не заданы параметры подписи. Подпись не выполнена.";
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекущийУчастник);
			
			Возврат ТекстОшибки;
		КонецЕсли;
		
		ИспользуемыйСертификат = НастройкиУчастника.СертификатЭПНачислений;
		ДанныеСертификатаСущности = НастройкиУчастника.ДанныеСертификатаНачислений;
		ТекПарольУчастника = НастройкиУчастника.ПарольЭПНачисления;
		ТипПрограммыСертификата = НастройкиУчастника.ТипПрограммыСертификатаНачислений;
		ПрограммаСертификата = НастройкиУчастника.ПрограммаСертификатаНачислений;
		ХранитьПароль = НастройкиУчастника.ХранитьПарольЭПНачисления;
		
		СодержимоеФайла = СтрокаТЧ.СодержимоеФайла;
		ПозицияНачалаФайла = 1;
		Если СтрНачинаетсяС(СодержимоеФайла,"<?")  Тогда
			ПозицияНачалаФайла = СтрНайти(СодержимоеФайла,"?>")+2;
			СодержимоеФайла = СокрЛП(Сред(СодержимоеФайла,ПозицияНачалаФайла));
		КонецЕсли;
		
		//СодержимоеФайла = СокрЛП(СтрЗаменить(СодержимоеФайла,"<?xml version=""1.0"" encoding=""UTF-8""?>",""));
				
		//если это обмен с эмулятором, то нужно послать эталонные сообщения
		//эталонные сообщения будут не подписаны и нужно их подписать
		НужнаПодписьСП = СтрНайти(СодержимоеФайла,ШаблонПодписиСП)>0;
		
		Если НужнаПодписьСП Тогда
			//В некоторых системах агрегаторах требуется подписывать ЭП-СП для запросов (платежей, начислений, квитирования и тд.)
			//Если в формате есть ШаблонПодписиСП, то определим подписываемый узел
			
			Если НЕ ЗначениеЗаполнено(ИмяУзлаПодписиСП) Тогда
			    
				Если СтрНайти(СодержимоеФайла,"ImportChargesRequest")>0 Тогда
					//Пакет начислений
					ИмяУзлаПодписиСП = "ImportChargesRequest";
					
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ImportRefundsRequest")>0 Тогда
				    //Пакет возвратов
					ИмяУзлаПодписиСП = "ImportRefundsRequest";
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ExportPaymentsRequest")>0 Тогда	
					//Запрос платежей
					ИмяУзлаПодписиСП = "ExportPaymentsRequest";
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ExportQuittancesRequest")>0 Тогда	
					//Запрос квитанций
					ИмяУзлаПодписиСП = "ExportQuittancesRequest";	
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ExportChargesRequest")>0 Тогда	
					//Запрос начислений и статусов квитирования
					ИмяУзлаПодписиСП = "ExportChargesRequest";
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ForcedAcknowledgementRequest")>0 Тогда	
					//Запрос на квитирование и отмену квитирования
					ИмяУзлаПодписиСП = "ForcedAcknowledgementRequest";
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ExportRefundsRequest")>0 Тогда	
					//Запрос возвратов
					ИмяУзлаПодписиСП = "ExportRefundsRequest";
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ImportCertificateRequest")>0 Тогда	
					//Передача сертификата ЭП
					ИмяУзлаПодписиСП = "ImportCertificateRequest";	
					
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ИмяУзлаПодписиСП)
				И НЕ ЗначениеЗаполнено(ДанныеСертификатаСущности) Тогда
				//подписывать надо, но сертификат не указан, возможно это косвенный участник
				//укажем, что подписывать будем сертификатом ЭП-ОВ
				Отправитель = НастройкиУчастника.Отправитель;
				НастройкиОтправителя = НастройкиПодисиУчастников[Отправитель];
				ИспользуемыйСертификат = НастройкиОтправителя.СертификатЭПСообщения;
				ДанныеСертификатаСущности = НастройкиОтправителя.ДанныеСертификатаСообщения;
				ТекПарольУчастника = НастройкиОтправителя.ПарольЭПСообщения;
				ТипПрограммыСертификата = НастройкиОтправителя.ТипПрограммыСертификатаСообщения;
				ПрограммаСертификата = НастройкиОтправителя.ПрограммаСертификатаСообщения;
				ХранитьПароль = НастройкиОтправителя.ХранитьПарольЭПСообщения;
			КонецЕсли;
			
		КонецЕсли;
			
		
		Если ЗначениеЗаполнено(ИмяУзлаПодписиСП) Тогда		
			
			Если НЕ ЗначениеЗаполнено(ДанныеСертификатаСущности) Тогда
				ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
				|Для участника ""%1"" не задан сертификат подписи начислений.'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекущийУчастник);

				Возврат ТекстОшибки;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТипПрограммыСертификата) Тогда
				//попробуем автоматически определить
			    Попытка
					СвойстваКриптопровайдераРезультат = Ждать КомпонентаПодписи.ПолучитьСвойстваКриптопровайдераАсинх(ДанныеСертификатаСущности);
					ТекущийКриптопровайдер = КриптопровайдерИзОтветаКомпоненты(СвойстваКриптопровайдераРезультат.Значение);
					ТекТип = ТекущийКриптопровайдер["type"];
					Если ТекТип <> Неопределено Тогда
						ТипПрограммыСертификата = ТекТип;
						
						Если НастройкиУчастника.ДанныеСертификатаНачислений = ДанныеСертификатаСущности Тогда
							НастройкиУчастника.ТипПрограммыСертификатаНачислений = ТипПрограммыСертификата;
						ИначеЕсли НастройкиОтправителя.ДанныеСертификатаСообщения = ДанныеСертификатаСущности Тогда
							НастройкиОтправителя.ТипПрограммыСертификатаСообщения = ТипПрограммыСертификата;
						КонецЕсли;
					КонецЕсли;
				Исключение
					
					ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
						|Для участника ""%1"" в сертификате подписи начислений не указано приложение для подписи.
						|При автоматическом определении приложения возникла ошибка: %2'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекущийУчастник,
						ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				    Возврат ТекстОшибки;
				КонецПопытки;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТипПрограммыСертификата) Тогда
				ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
				|Для участника ""%1"" в сертификате подписи начислений не указано приложение для подписи.'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекущийУчастник);

				Возврат ТекстОшибки;
			КонецЕсли;
			
			Если ХранитьПароль = Ложь Тогда
				Ждать КомпонентаПодписи.УстановитьЗапретитьПользовательскийИнтерфейсАсинх(Ложь);
			Иначе
				Ждать КомпонентаПодписи.УстановитьЗапретитьПользовательскийИнтерфейсАсинх(Истина);
			КонецЕсли;
						
			Попытка
				Подпись = Ждать ПодписатьДанныеПоФорматуГИСГМП20КомпонентойБСПНаКлиенте(КомпонентаПодписи,ДанныеСертификатаСущности,СодержимоеФайла,ИмяУзлаПодписиСП,ТекПарольУчастника,ТипПрограммыСертификата);	
				
				СодержимоеФайла = СтрЗаменить(СодержимоеФайла, ШаблонПодписиСП, Подпись);
				
				СтрокаТЧ.Подпись = Подпись;
				СтрокаТЧ.Сертификат = ИспользуемыйСертификат;
			Исключение
								
				ТекстОшибки = НСтр("ru='При формировании подписи СП возникла ошибка. Не удалось подписать %1.
						|%2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ИмяУзлаПодписиСП,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
												
				Возврат ТекстОшибки;					
			КонецПопытки;
						
			СтрокаТЧ.Подписано = Истина;			
		КонецЕсли;
		
		//Имя узла подписи ОВ зависит от вида сообщения
		
		ТекИмяУзлаПодписиОВ = ИмяУзлаПодписиОВ;
		Если ТекИмяУзлаПодписиОВ = "Авто" Тогда
		
			Если СтрокаТЧ.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ИмпортДанныхВСМЭВ")
				ИЛИ СтрокаТЧ.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика") Тогда
				ТекИмяУзлаПодписиОВ = "SenderProvidedRequestData";//стандартный узел для подписи сообщений SendRequest
			ИначеЕсли СтрокаТЧ.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСМЭВ") Тогда //ТекущееДействие = "ЗапроситьДанныеИзОчередиОтветов"
				
				Если СтрНайти(СодержимоеФайла,"MessageTypeSelector")>0 Тогда
					//стандартный узел для подписи сообщений GetResponse
					//или запрос результата обработки по ID в ИС УНП
					ТекИмяУзлаПодписиОВ = "MessageTypeSelector";
				ИначеЕсли СтрНайти(СодержимоеФайла,"OriginalMessageID")>0 Тогда
					//это запрос результата обработки по ID в ИС РНИП
					ТекИмяУзлаПодписиОВ = "OriginalMessageID";
					
				КонецЕсли;
				
			ИначеЕсли СтрокаТЧ.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ПодтверждениеПолученияСообщенияСМЭВ") Тогда //ТекущееДействие = "ПодтвердитьПолучениеСообщения"
				ТекИмяУзлаПодписиОВ = "AckTargetMessage";//стандартный узел для подписи сообщений Ack
			ИначеЕсли СтрокаТЧ.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСтатусов") Тогда //ТекущееДействие = "ЗапроситьДанныеИзОчередиСтатусов"
				ТекИмяУзлаПодписиОВ = "Timestamp";//стандартный узел для подписи сообщений GetStatus	
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекИмяУзлаПодписиОВ)
			И ТекИмяУзлаПодписиОВ<>"Авто" Тогда
			
			Отправитель = НастройкиУчастника.Отправитель;
	
			НастройкиОтправителя = НастройкиПодисиУчастников[Отправитель];
						
			Если НастройкиОтправителя = Неопределено Тогда
				
				ТекстОшибки = "Для ""%1"" в настройках не заданы параметры подписи. Подпись не выполнена.";
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,Отправитель);
				
				Возврат ТекстОшибки;
			КонецЕсли;
			
			ИспользуемыйСертификат = НастройкиОтправителя.СертификатЭПСообщения;
			ДанныеСертификатаЗаголовка = НастройкиОтправителя.ДанныеСертификатаСообщения;
			ТипПрограммыСертификата = НастройкиОтправителя.ТипПрограммыСертификатаСообщения;
			ПрограммаСертификата = НастройкиОтправителя.ПрограммаСертификатаСообщения;
			ХранитьПароль = НастройкиОтправителя.ХранитьПарольЭПСообщения;
			ТекПарольУчастника = НастройкиОтправителя.ПарольЭПСообщения;
					
			Если НЕ ЗначениеЗаполнено(ДанныеСертификатаЗаголовка) Тогда
				ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
				|Для участника ""%1"" не задан сертификат подписи всего сообщения.'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,Отправитель);
				
				Возврат ТекстОшибки;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТипПрограммыСертификата) Тогда
				//попробуем автоматически определить
			    Попытка
					СвойстваКриптопровайдераРезультат = Ждать КомпонентаПодписи.ПолучитьСвойстваКриптопровайдераАсинх(ДанныеСертификатаЗаголовка);
					ТекущийКриптопровайдер = КриптопровайдерИзОтветаКомпоненты(СвойстваКриптопровайдераРезультат.Значение);
					ТекТип = ТекущийКриптопровайдер["type"];
					Если ТекТип <> Неопределено Тогда
						ТипПрограммыСертификата = ТекТип;
						НастройкиОтправителя.ТипПрограммыСертификатаСообщения = ТипПрограммыСертификата;
					КонецЕсли;
				Исключение
					
					ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
						|Для участника ""%1"" в сертификате подписи всего сообщения не указано приложение для подписи.
						|При автоматическом определении приложения возникла ошибка: %2'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекущийУчастник,
						ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				    Возврат ТекстОшибки;
				КонецПопытки;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТипПрограммыСертификата) Тогда
				ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
				|Для участника ""%1"" в сертификате подписи всего сообщения не указано приложение для подписи.'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекущийУчастник);

				Возврат ТекстОшибки;
			КонецЕсли;
			
			Если ХранитьПароль = Ложь Тогда
				Ждать КомпонентаПодписи.УстановитьЗапретитьПользовательскийИнтерфейсАсинх(Ложь);
			Иначе
				Ждать КомпонентаПодписи.УстановитьЗапретитьПользовательскийИнтерфейсАсинх(Истина);
			КонецЕсли;
						
			Попытка
				Подпись = Ждать ПодписатьДанныеПоФорматуГИСГМП20КомпонентойБСПНаКлиенте(КомпонентаПодписи,ДанныеСертификатаЗаголовка,СодержимоеФайла,ТекИмяУзлаПодписиОВ,ТекПарольУчастника,ТипПрограммыСертификата);	
			
				СодержимоеФайла = СтрЗаменить(СодержимоеФайла, ШаблонПодписиОВ, Подпись);
			Исключение
								
				ТекстОшибки = НСтр("ru='При формировании подписи ОВ возникла ошибка. Не удалось подписать %1.
						|%2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекИмяУзлаПодписиОВ,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					
				Возврат ТекстОшибки;					
					
			КонецПопытки;
						
			СтрокаТЧ.Подписано = Истина;
			
		КонецЕсли;	
			
		СтрокаТЧ.СодержимоеФайла = СодержимоеФайла;
		
	КонецЦикла;
	
	Возврат ТекстОшибки;
КонецФункции

Асинх Функция ПодписатьПодтверждениеПолученияСообщенияНаКлиенте(Участник, СодержимоеФайла, КомпонентаПодписи, Знач НастройкиПодисиУчастников) Экспорт
	Отправитель = Участник;
	
	Если НастройкиПодисиУчастников = Неопределено Тогда
		НастройкиПодисиУчастников = ГосУслуги.ПолучитьНастройкиПодписиУчастников20(Участник);
	КонецЕсли;
	
	НастройкиОтправителя = НастройкиПодисиУчастников[Отправитель];
	
	СтруктураРезультата = Новый Структура("ТекстОшибки,СодержимоеФайла","","");
	
	Если НастройкиОтправителя = Неопределено Тогда
		
		ТекстОшибки = "Для ""%1"" в настройках не заданы параметры подписи. Подпись не выполнена.";
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,Отправитель);
		
		СтруктураРезультата.ТекстОшибки = ТекстОшибки;
		
		Возврат СтруктураРезультата;
	КонецЕсли;
	
	ИмяУзлаПодписи = "AckTargetMessage";
	ШаблонПодписиОВ = "%ПодписьОВ%";
	
	ИспользуемыйСертификат = НастройкиОтправителя.СертификатЭПСообщения;
	ДанныеСертификатаЗаголовка = НастройкиОтправителя.ДанныеСертификатаСообщения;
	ТипПрограммыСертификата = НастройкиОтправителя.ТипПрограммыСертификатаСообщения;
	ПрограммаСертификата = НастройкиОтправителя.ПрограммаСертификатаСообщения;
	ХранитьПароль = НастройкиОтправителя.ХранитьПарольЭПСообщения;
	ТекПарольУчастника = НастройкиОтправителя.ПарольЭПСообщения;
			
	Если НЕ ЗначениеЗаполнено(ДанныеСертификатаЗаголовка) Тогда
		ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
		|Для участника ""%1"" не задан сертификат подписи всего сообщения.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,Отправитель);
		
		СтруктураРезультата.ТекстОшибки = ТекстОшибки;
		
		Возврат СтруктураРезультата;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТипПрограммыСертификата) Тогда
		//попробуем автоматически определить
	    Попытка
			СвойстваКриптопровайдераРезультат = Ждать КомпонентаПодписи.ПолучитьСвойстваКриптопровайдераАсинх(ДанныеСертификатаЗаголовка);
			ТекущийКриптопровайдер = КриптопровайдерИзОтветаКомпоненты(СвойстваКриптопровайдераРезультат.Значение);
			ТекТип = ТекущийКриптопровайдер["type"];
			Если ТекТип <> Неопределено Тогда
				ТипПрограммыСертификата = ТекТип;
				НастройкиОтправителя.ТипПрограммыСертификатаСообщения = ТипПрограммыСертификата;
			КонецЕсли;
		Исключение
			
			ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
				|Для участника ""%1"" в сертификате подписи всего сообщения не указано приложение для подписи.
				|При автоматическом определении приложения возникла ошибка: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,Участник,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			СтруктураРезультата.ТекстОшибки = ТекстОшибки;
		
			Возврат СтруктураРезультата;
		КонецПопытки;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТипПрограммыСертификата) Тогда
		ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
		|Для участника ""%1"" в сертификате подписи всего сообщения не указано приложение для подписи.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,Участник);

		СтруктураРезультата.ТекстОшибки = ТекстОшибки;
		
		Возврат СтруктураРезультата;
	КонецЕсли;
	
	Если ХранитьПароль = Ложь Тогда
		Ждать КомпонентаПодписи.УстановитьЗапретитьПользовательскийИнтерфейсАсинх(Ложь);
	Иначе
		Ждать КомпонентаПодписи.УстановитьЗапретитьПользовательскийИнтерфейсАсинх(Истина);
	КонецЕсли;
				
	Попытка
		Подпись = Ждать ПодписатьДанныеПоФорматуГИСГМП20КомпонентойБСПНаКлиенте(КомпонентаПодписи,ДанныеСертификатаЗаголовка,СодержимоеФайла,ИмяУзлаПодписи,ТекПарольУчастника,ТипПрограммыСертификата);	
	
		СодержимоеФайла = СтрЗаменить(СодержимоеФайла, ШаблонПодписиОВ, Подпись);
		
		СтруктураРезультата.СодержимоеФайла = СодержимоеФайла;
	Исключение
						
		ТекстОшибки = НСтр("ru='При формировании подписи ОВ возникла ошибка. Не удалось подписать %1.
				|%2'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ИмяУзлаПодписи,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		СтруктураРезультата.ТекстОшибки = ТекстОшибки;
		
		Возврат СтруктураРезультата;					
			
	КонецПопытки;
				
	Возврат СтруктураРезультата;	
КонецФункции

Функция КриптопровайдерИзОтветаКомпоненты(Знач Текст)

	Результат = Новый Соответствие;

	Попытка
		
		ЗаполнитьСоответствиеИзОтветаJSON(Результат, Текст);
		Возврат Результат;

	Исключение

		ИнформацияОбОшибке = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не удалось прочитать ответ компоненты: %1
						 |%2'"), Текст, ИнформацияОбОшибке);

	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Для функции КриптопровайдерИзОтветаКомпоненты
Процедура ЗаполнитьСоответствиеИзОтветаJSON(Результат, Знач ТекстJSON)
	
	ТекстJSON = СтрЗаменить(СокрЛП(ТекстJSON), Символы.ПС, "");
	ТекстJSON = СокрЛП(Сред(ТекстJSON, 2, СтрДлина(ТекстJSON)-2));
	
	Пока ТекстJSON <> "" Цикл
		
		Позиция = СтрНайти(ТекстJSON, ":");
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ИмяЗначения = СокрЛП(Лев(ТекстJSON, Позиция-1));
		ИмяЗначения = СтрЗаменить(ИмяЗначения, """","");
		
		ЭтоЧисло = Ложь;
		ТекстJSON = СокрЛП(Сред(ТекстJSON, Позиция+1));
		Если Лев(ТекстJSON, 1) = """" Тогда
			ТекстJSON = СокрЛП(Сред(ТекстJSON, 2));
		Иначе
			ЭтоЧисло = Истина;
		КонецЕсли; 
		
		Позиция = 0;
		Для НоваяПозиция = 1 По СтрДлина(ТекстJSON) Цикл
			Символ = Сред(ТекстJSON, НоваяПозиция, 1);
			
			СледующийСимвол = Неопределено;
			Если Символ = "," Тогда
				Для СледующаяПозиция = НоваяПозиция + 1 По СтрДлина(ТекстJSON) Цикл
					СледующийСимвол = Сред(ТекстJSON, СледующаяПозиция, 1);
					Если СледующийСимвол <> " " Тогда
						Прервать;
					КонецЕсли; 
				КонецЦикла; 
			КонецЕсли; 
			Если Символ = "," И (СледующийСимвол = Неопределено ИЛИ СледующийСимвол = """") Тогда
				Позиция = НоваяПозиция;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Позиция = 0 Тогда
			Значение = ТекстJSON;
			ТекстJSON = "";
		Иначе
			Значение = Лев(ТекстJSON, Позиция-1);
			ТекстJSON = СокрЛП(Сред(ТекстJSON, Позиция + ?(Сред(ТекстJSON, Позиция, 1) = ",", 1, 0)));
		КонецЕсли;
		
		Значение = СокрЛП(Значение);
		Если Значение = "true" Тогда
			Значение = Истина;
		ИначеЕсли Значение = "false" Тогда
			Значение = Ложь;
		ИначеЕсли Значение = "null" Тогда
			Значение = Неопределено;
		Иначе
			Если ЭтоЧисло Тогда
				Значение = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Значение);
			Иначе
				Значение = Лев(Значение, СтрДлина(Значение)-1);
			КонецЕсли;
		КонецЕсли;
		
		Результат.Вставить(ИмяЗначения, Значение);
		
	КонецЦикла;
	
КонецПроцедуры

Асинх Функция ПодписатьДанныеПоФорматуГИСГМП20КомпонентойБСПНаКлиенте(КомпонентаПодписиБСП,СертификатКриптографииBase64,СодержимоеФайла,ИмяУзлаПодписи,ТекПарольУчастника,ТипКриптопровайдера)
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////
	//Общая последовательность должна быть такой (на примере SendRequest):
	///////////////////////////////////////////////////////////////////////////////////////////////////////////
	//1. Каноникализация содержимого узла SenderProvidedRequestData;
	//2. Нормализация;
	//3. Расчет хэша;

	//4. Формирование ЭП-ОВ:
	//a. запись cодержимого хэша в CallerInformationSystemSignature\Signature\SignedInfo\Reference\DigestValue
	//b. каноникализация, нормализация элемента CallerInformationSystemSignature\Signature\SignedInfo
	//c. расчёт хэша элемента CallerInformationSystemSignature\Signature\SignedInfo
	//d. подпись хэша CallerInformationSystemSignature\Signature\SignedInfo
	//e. запись значения подписи в CallerInformationSystemSignature\Signature\SignatureValue
	//f. запись данных сертификата в CallerInformationSystemSignature\Signature\KeyInfo\X509Data\X509Certificate
	                   
	// Приводим значение сертификата к нужному виду
	//СертификатКриптографииBase64 = СтрЗаменить(СтрЗаменить(ДанныеСертификатаСущности, Символы.ПС, ""), Символы.ВК, "");
	
	ЭПКонвертXML = ГосУслугиКлиентСервер.ЭПКонвертXML();
	
	//В URI блока подписи подставляется значение атрибута Id подписываемомго узла, поэтому ожидается, что такой атрибут есть.
	ПозицияУзлаПодписи = СтрНайти(СодержимоеФайла,ИмяУзлаПодписи);
	ИмяИскомогоБлокаАтрибута = " Id=""";
	ДлинаБлокаИскомогоАтрибута = СтрДлина(ИмяИскомогоБлокаАтрибута);
	ПозицияIdНачало = СтрНайти(СодержимоеФайла,ИмяИскомогоБлокаАтрибута,,ПозицияУзлаПодписи);
	ПозицияIdКонец = СтрНайти(СодержимоеФайла,"""",,ПозицияIdНачало + ДлинаБлокаИскомогоАтрибута);
	
	ЗначениеURI = Сред(СодержимоеФайла,ПозицияIdНачало+ДлинаБлокаИскомогоАтрибута,ПозицияIdКонец-ПозицияIdНачало-ДлинаБлокаИскомогоАтрибута);
	
	ЭПКонвертXML = СтрЗаменить(ЭПКонвертXML, "%URI%", "#"+ЗначениеURI);
		   
	OID_Алгоритма = "1.2.643.7.1.1.2.2";//ИдентификаторАлгоритмаХеширования ГОСТ 2012/256  
	                   
	// Приводим текст подписной части Signature к канонической
	XPath_Signature = "(//. | //@* | //namespace::*)[ancestor-or-self::*[local-name()='Signature']]";
		
	ЭПКонвертXML = Ждать C14NАсинх(КомпонентаПодписиБСП, ЭПКонвертXML, XPath_Signature);
	ЭПКонвертXML = Ждать КанонизацияСМЭВ(КомпонентаПодписиБСП, ЭПКонвертXML);
	                   
	// 1. Приводим текст запроса, заключенный в тегах <ТекИмяУзлаПодписиОВ> к единой нормальной форме (канонизируем) по двум алгоритмам (C14N и СМЭВ)
	XPath_ИмяУзлаПодписи = "(//. | //@* | //namespace::*)[ancestor-or-self::*[local-name()='" + ИмяУзлаПодписи + "']]";
	КанонXML_ИмяУзлаПодписи = Ждать C14NАсинх(КомпонентаПодписиБСП, СодержимоеФайла, XPath_ИмяУзлаПодписи);
	// 2. Нормализация
	КанонXML_ИмяУзлаПодписи = Ждать КанонизацияСМЭВ(КомпонентаПодписиБСП, КанонXML_ИмяУзлаПодписи);
	
	//ТипКриптопровайдера - для КриптоПро = 80, берется из программы сертификата
	
	// 3. Хешируем наш запрос и помещаем значение в %DigestValue%
	АтрибутDigestValue = Ждать РезультатHash(КомпонентаПодписиБСП, КанонXML_ИмяУзлаПодписи, OID_Алгоритма, ТипКриптопровайдера);
	// 4.а
	ЭПКонвертXML = СтрЗаменить(ЭПКонвертXML, "%DigestValue%", АтрибутDigestValue);

	// 4.b Приводим текст запроса, заключенный в тегах <SignedInfo> к единой нормальной форме (канонизируем) по двум алгоритмам (C14N и СМЭВ)
	XPath_SignedInfo = "(//. | //@* | //namespace::*)[ancestor-or-self::*[local-name()='SignedInfo']]";
	Канон_SignedInfo = Ждать C14NАсинх(КомпонентаПодписиБСП, ЭПКонвертXML, XPath_SignedInfo);
	Канон_SignedInfo = Ждать КанонизацияСМЭВ(КомпонентаПодписиБСП, Канон_SignedInfo);

	// 4.c Хешируем SignedInfo
	ХэшSignedInfo = Ждать РезультатHash(КомпонентаПодписиБСП, Канон_SignedInfo, OID_Алгоритма, ТипКриптопровайдера);
	                   
	// 4.d Подписываем хэш <SignedInfo>.
	//АтрибутSignatureValue = КомпонентаКриптографии.Sign(ХэшSignedInfo, СертификатКриптографииBase64, ТекПарольУчастника);
	АтрибутSignatureValue = Ждать РезультатSign(КомпонентаПодписиБСП, Канон_SignedInfo, СертификатКриптографииBase64, ТекПарольУчастника);
	                   
	// 4.e запись значения подписи в CallerInformationSystemSignature\Signature\SignatureValue
	ЭПКонвертXML = СтрЗаменить(ЭПКонвертXML, "%SignatureValue%", АтрибутSignatureValue);
	                   
	// 4.f запись данных сертификата в CallerInformationSystemSignature\Signature\KeyInfo\X509Data\X509Certificate
	ЭПКонвертXML = СтрЗаменить(ЭПКонвертXML, "%BinarySecurityToken%", СертификатКриптографииBase64);
	
	Подпись = ЭПКонвертXML;
	
	Возврат Подпись;
КонецФункции

Асинх Функция КанонизацияСМЭВ(ОбъектКомпоненты, ТекстXML)
	
	Попытка
		Результат = Ждать ОбъектКомпоненты.TransformSMEVАсинх(ТекстXML);
		КанонизированныйТекстXML = Результат.Значение;
	Исключение
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("TransformSMEV",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Если КанонизированныйТекстXML = Неопределено Тогда
		РезультатОшибка = Ждать ОбъектКомпоненты.ПолучитьОшибкуАсинх();
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("TransformSMEV",
			РезультатОшибка.Значение);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат КанонизированныйТекстXML;
	
КонецФункции

Асинх Функция C14NАсинх(ОбъектКомпоненты, КонвертXML, XPath)
	
	Попытка
		Результат = Ждать ОбъектКомпоненты.C14NАсинх(КонвертXML, XPath);
		КанонизированныйТекстXML = Результат.Значение;
	Исключение
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("C14N",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Если КанонизированныйТекстXML = Неопределено Тогда
		
		РезультатОшибка = Ждать ОбъектКомпоненты.ПолучитьОшибкуАсинх();
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("C14N",
			РезультатОшибка.Значение);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат КанонизированныйТекстXML;
	
КонецФункции

Асинх Функция РезультатHash(ОбъектКомпоненты, КанонизированныйТекстXMLBody, OIDАлгоритмаХеширования, ТипКриптопровайдера)
	
	Попытка
		Результат = Ждать ОбъектКомпоненты.HashАсинх(
			КанонизированныйТекстXMLBody,
			OIDАлгоритмаХеширования,
			ТипКриптопровайдера);
		АтрибутDigestValue = Результат.Значение;
	Исключение
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("Hash",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Если АтрибутDigestValue = Неопределено Тогда
		РезультатОшибка = Ждать ОбъектКомпоненты.ПолучитьОшибкуАсинх();
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("Hash",
			РезультатОшибка.Значение);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат АтрибутDigestValue;
	
КонецФункции

Асинх Функция РезультатSign(ОбъектКомпоненты, КанонизированныйТекстXMLSignedInfo,
	СертификатКриптографииBase64, ПарольДоступаКЗакрытомуКлючу)
	
	Попытка
		Результат = Ждать ОбъектКомпоненты.SignАсинх(
			КанонизированныйТекстXMLSignedInfo,
			СертификатКриптографииBase64,
			ПарольДоступаКЗакрытомуКлючу);
		АтрибутSignatureValue = Результат.Значение;
	Исключение
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("Sign",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Если АтрибутSignatureValue = Неопределено Тогда
		РезультатОшибка = Ждать ОбъектКомпоненты.ПолучитьОшибкуАсинх();
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("Sign",
			РезультатОшибка.Значение);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат АтрибутSignatureValue;
	
КонецФункции

Функция ОшибкаВызоваМетодаКомпоненты(ИмяМетода, ИнформацияОбОшибке) Экспорт
	
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Ошибка вызова метода %1 компоненты %2.'"), ИмяМетода, "ExtraCryptoAPI")
		+ Символы.ПС + ИнформацияОбОшибке;
	
КонецФункции
	


//

// порционная подготовка следующих запросов

Процедура ПолучитьСледующуюПорциюДанных(ЗаданиеСсылка,НастройкаОбмена,ИдентификаторФормы) Экспорт
	
	МассивФайлов = Новый Массив;
	Данные = ГосУслуги.СформироватьФайлыДляПолученияСледующейПорцииДанных(ЗаданиеСсылка);
	
	Если Данные = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось подготовить запрос следующей порции данных из сервиса.");
		Возврат;
	КонецЕсли;
	
	КонтекстВыполнения = Новый Структура;
	КонтекстВыполнения.Вставить("Результат",Истина);
	КонтекстВыполнения.Вставить("ЗаданиеНаЭкспортСсылка",ЗаданиеСсылка);
	КонтекстВыполнения.Вставить("Версия",1.16); // если не задана, то устанавливается 1.15

	ПодписатьДанныеПоФормату_1_16(КонтекстВыполнения,Данные);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("МассивФайлов",Данные["ОтправляемыеФайлы"]);
	ТекстОшибки = "";
	
	КаталогВыгрузки = ЭкспортФайлов.ПолучитьКаталогЗаданияНаЭкспорт(ЗаданиеСсылка);
	ЭкспортФайловКлиент.ЭкспортФайловЗаданияНаЭкспорт(ЗаданиеСсылка,НастройкаОбмена,КаталогВыгрузки,ТекстОшибки,ИдентификаторФормы,ДополнительныеПараметры);
	
	//ЭкспортФайлов.ОтправитьФайлыПоHTTP(ЗаданиеСсылка,Неопределено,ТекстОшибки,ДополнительныеПараметры);
	
	ТребуетсяСледующаяИтерация = Ложь;
	ДополнительныеПараметры.Свойство("ТребуетсяСледующаяИтерация",ТребуетсяСледующаяИтерация);
	
	Если ТребуетсяСледующаяИтерация = Истина Тогда
		ПолучитьСледующуюПорциюДанных(ЗаданиеСсылка,НастройкаОбмена,ИдентификаторФормы);
	КонецЕсли;
		
КонецПроцедуры

