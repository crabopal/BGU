
Функция ВедетсяУчетПоДокументамРасчетов(Организация, Период, КФО, Валюта, Счет) Экспорт

	Если БухгалтерскийУчетВызовСервераПовтИсп.НаСчетеВедетсяУчетПоДокументамРасчетов(Счет) Тогда
		
		// По договорам аренды, при учете по СГС Аренда, учет по документам расчетов не имеет смысла,
		// т.к. вся задолженность начисляется при заключении договора.
		ДатаПереходаНаРедакцию64н = БухгалтерскийУчетВызовСервераПовтИсп.ДатаПереходаНаРедакциюПС(Организация, Дата('20180101'));
		Если НЕ ЗначениеЗаполнено(ДатаПереходаНаРедакцию64н) Тогда
			ДатаПереходаНаРедакцию64н = КонецГода('20180101');
		КонецЕсли;
		Если Период >= ДатаПереходаНаРедакцию64н // Начало применения СГС "Аренда" совпадает с переходом на 64н.
			И БухгалтерскийУчетКлиентСервер.СчетВИерархии(Счет, "205.21,205.22,206.24,206.29,302.24,302.29") Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если БухгалтерскийУчетВызовСервераПовтИсп.ВидСубконтоОбязательный(Счет, "ДокументыРасчетов") Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьВалютныйУчет") И
			ЗначениеЗаполнено(Валюта) И (Валюта <> БухгалтерскийУчетВызовСервераПовтИсп.ВалютаРегламентированногоУчета()) Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если УчетУСНВызовСервера.ПрименяетсяУСН(Организация, Период)
		  И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(КФО) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция ВедетсяУчетОбязательств(ВидДоговора) Экспорт
	
	Возврат ВидДоговора <> ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем")
		И ВидДоговора <> ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СОтправителемТрансферта");
	
КонецФункции

Функция ДопустимыеСчетаРасчетовПоВидуДоговора(ВидДоговора) Экспорт
	
	Если ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг") Тогда
		Возврат "301.12,301.42";
	ИначеЕсли ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПолученныйКредит") Тогда
		Возврат "301.00";
	ИначеЕсли ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленныйКредит") Тогда
		Возврат "207.00";
	ИначеЕсли ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком") Тогда
		Возврат "302.00,304.01";
	ИначеЕсли ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии") Тогда
		Возврат "302.00";
	ИначеЕсли ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем")
		ИЛИ ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СОтправителемТрансферта") Тогда
		Возврат "205.00,209.00";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции


