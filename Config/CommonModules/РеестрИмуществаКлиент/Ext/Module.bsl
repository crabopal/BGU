////////////////////////////////////////////////////////////////////////////////
// Подсистема "Реестр имущества".
//
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Процедура ВыборВТаблице(Форма, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Форма.ВыборВТаблицеСервер();
	ОткрытьФорму("Справочник.РеквизитыСведенийОбИмуществе.Форма.ФормаДополнительная", ПараметрыФормы, Форма);
	
КонецПроцедуры

Процедура ПриНачалеВыбораРеквизита(Форма, Элемент, ДанныеВыбора, СтандартнаяОбработка) Экспорт
	
	СвойстваЭлемента = ПолучитьСвойстваЭлемента(Элемент.Имя);
	
	Если СвойстваЭлемента.ЭтоАдрес Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТаблицаЭлемента = РеестрИмуществаКлиентСервер.ПолучитьРодителяПоТипуЭлемента(Элемент, Тип("ТаблицаФормы"));
		Если ТаблицаЭлемента = Неопределено Тогда
			ДанныеЗаполнения = Форма;
			ИмяЭлемента = СвойстваЭлемента.Имя;
		Иначе
			ДанныеЗаполнения = Форма.Элементы[ТаблицаЭлемента.Имя].ТекущиеДанные;
			ИмяЭлемента = ПолучитьСвойстваЭлемента(Элемент.Имя, ТаблицаЭлемента.Имя).Имя;
		КонецЕсли;
		ЗначенияПолей = ДанныеЗаполнения[ИмяЭлемента];
		
		ВидИнформации = Новый Структура("Тип", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
		ПараметрыФормы = Новый Структура("ЗначенияПолей, ВидКонтактнойИнформации, БлокироватьВладельца, ТолькоПросмотр",
		ЗначенияПолей, ВидИнформации, Истина, Форма.ТолькоПросмотр);
		
		УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыФормы, Форма);
		
	Иначе
		//
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора, Форма) Экспорт
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.РасширенныйВводКонтактнойИнформации.Форма.ВводАдреса" Тогда
		
		ТаблицаЭлемента = РеестрИмуществаКлиентСервер.ПолучитьРодителяПоТипуЭлемента(Форма.ТекущийЭлемент, Тип("ТаблицаФормы"));
		Если ТаблицаЭлемента = Неопределено Тогда
			ДанныеЗаполнения = Форма;
			ИмяРеквизита = ПолучитьСвойстваЭлемента(Форма.ТекущийЭлемент.Имя).Имя;
		Иначе
			ДанныеЗаполнения = Форма.Элементы[ТаблицаЭлемента.Имя].ТекущиеДанные;
			ИмяРеквизита = ПолучитьСвойстваЭлемента(ТаблицаЭлемента.ТекущийЭлемент.Имя, ТаблицаЭлемента.Имя).Имя;
		КонецЕсли;
		
		ДанныеЗаполнения[ИмяРеквизита] = ?(ПустаяСтрока(ВыбранноеЗначение.Представление), "", ВыбранноеЗначение.КонтактнаяИнформация);
		ДанныеЗаполнения[ИмяРеквизита + "_ПредставлениеАдреса"] = ВыбранноеЗначение.Представление;
		
		Форма.Модифицированность = Истина;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.РеквизитыСведенийОбИмуществе.Форма.ФормаДополнительная" Тогда
		
		РеестрИмуществаКлиентСервер.ЗаполнитьФормуДанными(Форма.ТекущийЭлемент.ТекущиеДанные, ВыбранноеЗначение);
		Форма.Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа) Экспорт
	
	Если Копирование И НЕ Группа Тогда
		
		Отказ = Истина;
		
		ТекущийЭлемент = Элемент.ТекущиеДанные.Ссылка;
		
		ИмяОбъекта = ?(ТипЗнч(ТекущийЭлемент) = Тип("СправочникСсылка.ВидыКартСведенийОбИмуществе"), " вида карты", " вида объекта");
		
		ТекстВопроса = НСтр("ru='Будет создан новый элемент. Выполнить копирование" + ИмяОбъекта + "?'");
		ДопПараметры = Новый Структура("ТекущийЭлемент,ИмяОбъекта", ТекущийЭлемент, ИмяОбъекта);
		Оповещение = Новый ОписаниеОповещения("ПередНачаломДобавленияПослеЗакрытияВопроса", ЭтотОбъект, ДопПараметры);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередНачаломДобавленияПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = РеестрИмуществаВызовСервера.СкопироватьУзел(Параметры.ТекущийЭлемент);
	Если ЗначениеЗаполнено(Элемент) Тогда
		ПоказатьОповещениеПользователя("Копирование", ПолучитьНавигационнуюСсылку(Элемент), "Выполнено копирование" + Параметры.ИмяОбъекта,);
		ОповеститьОбИзменении(ТипЗнч(Параметры.ТекущийЭлемент));
		ПоказатьЗначение(Неопределено, Элемент);
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьРеквизиты(Форма) Экспорт
	
	Если ЗначениеЗаполнено(Форма.СлужебноеПоле_АдресМакетаКомпоновкиЗаполнение) Тогда
		Оповещение	= Новый ОписаниеОповещения("Подключаемый_ЗаполнитьРеквизитыПослеЗакрытияВопроса", Форма.ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Будет выполнено заполнение реквизитов.
								|Текущие значения могут быть утеряны.
								|Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ПроверитьЗаполнениеРеквизитов(Форма) Экспорт
	
	ОчиститьСообщения();
	БезОшибок = Форма.ПроверитьЗаполнение();
	Если БезОшибок Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Ошибки заполнения не обнаружены'"))
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСвойстваЭлемента(ПолноеИмяЭлемента, ИмяТаблицы = "")
	
	Если ИмяТаблицы = "" Тогда
		Префикс = РеестрИмуществаКлиентСервер.ПрефиксЭлементовФормы();
		ДлинаПрефикса = СтрДлина(Префикс);
		ИмяЭлемента = Сред(ПолноеИмяЭлемента, ДлинаПрефикса + 1);
	Иначе
		ИмяЭлемента = Сред(ПолноеИмяЭлемента, СтрДлина(ИмяТаблицы) + 1);
	КонецЕсли;
	
	Префикс = "_ПредставлениеАдреса";
	ПозицияПрефикса = СтрДлина(ИмяЭлемента) - СтрДлина(Префикс);
	
	Если Сред(ИмяЭлемента, ПозицияПрефикса + 1) = Префикс Тогда
		ИмяЭлемента = Сред(ИмяЭлемента, 1, ПозицияПрефикса);
		ЭтоАдрес = Истина;
	Иначе
		ЭтоАдрес = Ложь;
	КонецЕсли;
	
	Возврат Новый Структура("Имя, ЭтоАдрес", ИмяЭлемента, ЭтоАдрес);
	
КонецФункции

#КонецОбласти
