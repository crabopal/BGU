функция ПолучитьЗначениеРеквизитаОС(ОсновноеСредство, Реквизит, Дата) Экспорт 
	
	Результат = Новый Структура("Переопределено,Значение");
	Результат.Вставить("Переопределено",Ложь);
	Результат.Вставить("Значение");
	
	ИмяРеквизита = ВРег(Реквизит);
		
	Если ИмяРеквизита = ВРег("СчетУчета") 
		ИЛИ ИмяРеквизита = ВРег("ВидУчета") 
		ИЛИ ИмяРеквизита = ВРег("ВидИмущества")  Тогда 
		
		Результат.Переопределено = Истина;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Дата",Дата);
		Запрос.УстановитьПараметр("ОсновноеСредство",ОсновноеСредство);
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета,
		|	УчетныеДанныеОбъектаОССрезПоследних.ВидУчета КАК ВидУчета,
		|	УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества КАК ВидИмущества
		|ИЗ
		|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
		|			&Дата,
		|				ОсновноеСредство = &ОсновноеСредство) КАК УчетныеДанныеОбъектаОССрезПоследних";
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда 
			Возврат Результат;
		КонецЕсли;
		
		Результат.Значение = РезультатЗапроса.Выгрузить()[0][ИмяРеквизита]; 
		
	ИначеЕсли ИмяРеквизита = ВРег("КадастровыйНомер") 
		ИЛИ ИмяРеквизита = ВРег("КадастровыйНомерЗемли")
		ИЛИ ИмяРеквизита = ВРег("КадастровыйНомерЗдания")
		ИЛИ ИмяРеквизита = ВРег("КадастроваяСтоимость") Тогда
		
		Результат.Переопределено = Истина;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Дата",Дата);
		Запрос.УстановитьПараметр("ОсновноеСредство",ОсновноеСредство);
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер КАК КадастровыйНомер,
		|	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомерЗемлиНедвижимости КАК КадастровыйНомерЗемли,
		|	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомерЗдания КАК КадастровыйНомерЗдания,
		|	СведенияКадастровогоУчетаСрезПоследних.КадастроваяСтоимость КАК КадастроваяСтоимость
		|ИЗ                          
		|	РегистрСведений.СведенияКадастровогоУчета.СрезПоследних(&Дата, ОсновноеСредство = &ОсновноеСредство) КАК СведенияКадастровогоУчетаСрезПоследних";
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда 
			Возврат Результат;
		КонецЕсли;
		
		Результат.Значение = РезультатЗапроса.Выгрузить()[0][ИмяРеквизита]; 
		
	ИначеЕсли ИмяРеквизита = ВРег("Адрес") Тогда
		
		Результат.Переопределено = Истина;
		Результат.Значение = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ОсновноеСредство,Справочники.ВидыКонтактнойИнформации.АдресМестонахожденияОбъектаОС);	
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	


	
Функция ПолучитьЗначениеДополнительногоРеквизитаСправочника(Ссылка,ИмяДопРеквизита,ТипОбъекта = Неопределено) Экспорт
	ИскомоеЗначение = "";
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат ИскомоеЗначение;
	КонецЕсли;
	
	Если ТипОбъекта = Неопределено Тогда
		ТипОбъекта = "Справочник";
	КонецЕсли;
	
	Имя = Ссылка.Метаданные().Имя;
	Свойство = Неопределено;
	Попытка
		Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения[ИмяДопРеквизита];
	Исключение
		Свойство = Неопределено;
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Первые 1
		|	СпрДополнительныеРеквизиты.Значение КАК ИскомоеЗначение
		|ИЗ
		|	"+ТипОбъекта+"."+Имя+".ДополнительныеРеквизиты КАК СпрДополнительныеРеквизиты
		|ГДЕ
		|	СпрДополнительныеРеквизиты.Ссылка = &Ссылка
		|	И ВЫБОР
		|			КОГДА &ПоНаименованию
		|				ТОГДА СпрДополнительныеРеквизиты.Свойство.Наименование = &Наименование
		|			ИНАЧЕ СпрДополнительныеРеквизиты.Свойство = &Свойство
		|		КОНЕЦ";
	Запрос.УстановитьПараметр("ПоНаименованию", НЕ ЗначениеЗаполнено(Свойство));
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Наименование", ИмяДопРеквизита);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ИскомоеЗначение = Выборка.ИскомоеЗначение;
		КонецЕсли;
	Исключение
		ИскомоеЗначение = "";
	КонецПопытки;
	
	Возврат ИскомоеЗначение;
КонецФункции

