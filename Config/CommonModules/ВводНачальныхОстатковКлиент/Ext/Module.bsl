////////////////////////////////////////////////////////////////////////////////
// Применяется для ввода начальных остатков
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Процедура ПриОткрытии(Форма) Экспорт
	
	ЭтоАгрегаторДвижений = Форма.Объект.ЭтоАгрегаторДвижений;
	
	Форма.Элементы.ГруппаАгрегатор.Видимость	= ЭтоАгрегаторДвижений;
	Форма.Элементы.ГруппаДанные.ТолькоПросмотр	= ЭтоАгрегаторДвижений;
	
КонецПроцедуры

Процедура СпроситьИОткрытьФормуВводаНачальныхОстатковОС(Форма) Экспорт
	
	Если Не Форма.Параметры.Ключ.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	РазделУчетаУстарел = ВводНачальныхОстатковКлиентСервер.РазделУчетаДляВводаОстатковУстарел(Форма.Объект.РазделУчета)
		И (Форма.Объект.ОтражатьВБухгалтерскомУчете Или Не Форма.Объект.ОтражатьВНалоговомУчете);
	
	Если НЕ РазделУчетаУстарел Тогда
		Возврат;
	КонецЕсли;
	
	// Предложим воспользоваться новым документом.
	ТекстВопроса = НСтр("ru = 'ВНИМАНИЕ! Ввод начальных остатков по ОС, НМА, НПА
		|выполняется документом ""Ввод начальных остатков ОС, НМА, НПА"".
		|Перейти к новому документу?'");
	
	Если РазделУчетаУстарел Тогда
		ЗапретитьПроведение = ВводНачальныхОстатковКлиентСервер.ЗапретитьПроведениеДокументовСУстаревшимРазделомУчета();
	Иначе
		ЗапретитьПроведение = Ложь;
	КонецЕсли;
	
	ДопПараметры = Новый Структура();
	ДопПараметры.Вставить("Форма",					Форма);
	ДопПараметры.Вставить("ЗапретитьПроведение",	ЗапретитьПроведение);
	
	Оповещение = Новый ОписаниеОповещения("ОткрытьФормуВводаНачальныхОстатковОС", ЭтотОбъект, ДопПараметры);
	
	Если ЗапретитьПроведение Тогда
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена, , КодВозвратаДиалога.ОК);
	Иначе
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	КонецЕсли;
	
КонецПроцедуры

Процедура СнятьПризнакАгрегатора(Форма) Экспорт
	
	Если Форма.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура("Форма", Форма);
	
	Оповещение = Новый ОписаниеОповещения("АгрегаторУправлениеПослеЗакрытияВопроса", ЭтотОбъект, ДопПараметры);
	ТекстВопроса = НСтр("ru = 'ВНИМАНИЕ! Движения документа могут измениться. 
                         |Движения этого документа сформированы программно.
                         |После включения редактирования движения будут сформированы по данным документа.
                         |Продолжить?'");
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

Процедура ДатаДокументаПриИзменении_ПроверитьНеобходимостьИзмененияСоставаГруппСчетов(Форма) Экспорт
	
	НаДату1 = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Форма["КэшДатаДокумента"]);
	НаДату2 = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Форма.Объект["Дата"]);
	
	Если ОбщегоНазначенияБГУКлиентСервер.ЗначенияВОдномДиапазоне(НаДату1, НаДату2, Форма["ДатыИзмененияСоставаГруппСчетов"]) Тогда
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ДатаДокументаПриИзменении_ИзменениеСоставаГруппСчетовНеТребуется", Форма);
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗавершении);
		
		Возврат;
		
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru='Новое значение даты ввода остатков находится в периоде действия другого состава счетов учета НФА.
		|Список групп счетов ввода остатков будет составлен заново.
		|
		|Продолжить и сменить дату ввода остатков?'");
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ДатаДокументаПриИзменении_ПодтвержденоИзменениеСоставаГруппСчетов", Форма);
	
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОткрытьФормуВводаНачальныхОстатковОС(Результат, ДополнительныеПараметры) Экспорт
	
	ЗакрытьФормуУстаревшегоДокумента = (Результат = КодВозвратаДиалога.ОК ИЛИ Результат = КодВозвратаДиалога.Да);
	
	ОткрытьФормуНовогоДокумента = (Результат = КодВозвратаДиалога.Да);
	
	Если ЗакрытьФормуУстаревшегоДокумента Тогда
		ДополнительныеПараметры.Форма.Закрыть();
	КонецЕсли;
	
	Если ОткрытьФормуНовогоДокумента Тогда
		ЗначенияЗаполнения = Новый Структура("Организация,ИФО,КФО,КПС,Счет,Дата,ОтражатьВБухгалтерскомУчете,ОтражатьВНалоговомУчете");
		ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, ДополнительныеПараметры.Форма.Объект);
		ЗначенияЗаполнения.Вставить("СчетУчета", ЗначенияЗаполнения.Счет);
		
		ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
		ОткрытьФорму("Документ.ВводНачальныхОстатковОС.ФормаОбъекта", ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

Процедура АгрегаторУправлениеПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Форма = Параметры.Форма;
		
		Форма.Объект.ЭтоАгрегаторДвижений			= Ложь;
		Форма.Элементы.ГруппаАгрегатор.Видимость	= Ложь;
		Форма.Элементы.ГруппаДанные.ТолькоПросмотр	= Ложь;
		
		Форма.Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
