#Область СлужебныйПрограммныйИнтерфейс

Функция ПредставлениеДокументаПоСвойствам(Свойства, ЭтоНовый = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(Свойства.НомерДокумента) И ЗначениеЗаполнено(Свойства.ДатаДокумента) Тогда
		Представление = СтрШаблон(НСтр("ru = '%1 № %2 от %3'"), Свойства.ВидДокумента,
			Свойства.НомерДокумента, Формат(Свойства.ДатаДокумента, "ДЛФ=D;"));
	ИначеЕсли ЗначениеЗаполнено(Свойства.НомерДокумента) Тогда
		Представление = СтрШаблон(НСтр("ru = '%1 № %2'"), Свойства.ВидДокумента,
			Свойства.НомерДокумента);
	ИначеЕсли ЗначениеЗаполнено(Свойства.ДатаДокумента) Тогда
		Представление = СтрШаблон(НСтр("ru = '%1 от %2'"), Свойства.ВидДокумента,
			Формат(Свойства.ДатаДокумента, "ДЛФ=D;"));
	Иначе
		Представление = Строка(Свойства.ВидДокумента);
	КонецЕсли;
	
	Если ЭтоНовый Тогда
		Представление = СтрШаблон(НСтр("ru = '%1 (Создание)'"), Представление);
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

// Заполняет служебные реквизиты дерева подписания.
//
// Параметры:
//  СтрокаДерева - ДанныеФормыЭлементДерева, СтрокаДереваЗначений - строка дерева.
//  ИмяОсновногоРеквизита- Строка - имя реквизита дерева, который будет выводиться в основной колонке.
//
Процедура ЗаполнитьСлужебныеРеквизитыСтрокиДерева(СтрокаДерева, ИмяОсновногоРеквизита) Экспорт
	
	Если ЗначениеЗаполнено(СтрокаДерева.Группа) ИЛИ СтрокаДерева.ЭтоСтрокаУсловия Тогда
		СтрокаДерева.ЭтоСтрокаУсловия = Истина;
		СтрокаДерева.ИндексКартинки = 2;
		СтрокаДерева.ОсновноеЗначение = ПредставлениеСтрокиУсловия(СтрокаДерева);
	Иначе
		СтрокаДерева.ЭтоСтрокаУсловия = Ложь;
		Если СтрокаДерева.ВидПодписи = ПредопределенноеЗначение(
				"Перечисление.ВидыЭлектронныхПодписейБГУ.Усиленная") Тогда
			СтрокаДерева.ИндексКартинки = 0;
		Иначе
			СтрокаДерева.ИндексКартинки = 1;
		КонецЕсли;
		СтрокаДерева.ОсновноеЗначение = СтрокаДерева[ИмяОсновногоРеквизита];
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставленияГрупп() Экспорт
	
	Представления = Новый Соответствие;
	Представления.Вставить("ПоОчереди", НСтр("ru = 'Все по очереди'"));
	Представления.Вставить("И", НСтр("ru = 'Все одновременно'"));
	Представления.Вставить("ИЛИ", НСтр("ru = 'Любой'"));
	
	Возврат Представления;
	
КонецФункции

Функция ИмяДекорацииСостояниеЭДО() Экспорт
	
	Возврат "ДекорацияСостояниеЭДОБГУ";
	
КонецФункции

Функция ПараметрыОткрытияЭлектронногоДокумента() Экспорт
	
	ПараметрыДокумента = Новый Структура;
	ПараметрыДокумента.Вставить("Организация", Неопределено);
	ПараметрыДокумента.Вставить("УчетныйДокумент", Неопределено);
	ПараметрыДокумента.Вставить("ВидДокумента", Неопределено);
	ПараметрыДокумента.Вставить("НомерДокумента", Неопределено);
	ПараметрыДокумента.Вставить("ДатаДокумента", Неопределено);
	ПараметрыДокумента.Вставить("ИдентификаторДокумента", Неопределено);
	ПараметрыДокумента.Вставить("ЭлектронныйДокумент", Неопределено);
	ПараметрыДокумента.Вставить("ИдентификаторКомандыПечати", Неопределено);
	ПараметрыДокумента.Вставить("АдресТабличногоДокумента", Неопределено);
	ПараметрыДокумента.Вставить("ИмяФайла", Неопределено);
	ПараметрыДокумента.Вставить("ОписаниеОшибки", Неопределено);
	
	Возврат ПараметрыДокумента;
	
КонецФункции

Функция ИмяФайлаПодписиПоУмолчанию(ДанныеПодписи, ПерсональныеНастройки) Экспорт
	
	ИмяФайлаПодписиБезРасширения = ДанныеПодписи.КомуВыданСертификат;
	
	Если СтрДлина(ИмяФайлаПодписиБезРасширения) > 130 Тогда
		ИмяФайлаПодписиБезРасширения = ВнутреннийЭДОВызовСервера.СокращенноеИмяФайла(
			ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайлаПодписиБезРасширения), 130);
	КонецЕсли;
	
	ИмяФайлаПодписи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1.%2",
		ИмяФайлаПодписиБезРасширения, ПерсональныеНастройки.РасширениеДляФайловПодписи);
	
	Возврат ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайлаПодписи);
	
КонецФункции

Функция ИмяФайлаСертификатаПоУмолчанию(ДанныеПодписи, ДлинаПодкаталога = 55) Экспорт
	
	ИмяФайлаСертификатаБезРасширения = ДанныеПодписи.КомуВыданСертификат;
	ДопустимаяДлинаИмени = ?(255 - ДлинаПодкаталога > 32, 255 - ДлинаПодкаталога, 32);
	
	Если СтрДлина(ИмяФайлаСертификатаБезРасширения) > ДопустимаяДлинаИмени Тогда
		ИмяФайлаСертификатаБезРасширения = ВнутреннийЭДОВызовСервера.СокращенноеИмяФайла(
			ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайлаСертификатаБезРасширения), ДопустимаяДлинаИмени);
	КонецЕсли;
	
	ИмяФайлаСертификата = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1.%2",
		ИмяФайлаСертификатаБезРасширения, "cer");
	
	Возврат ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайлаСертификата);
	
КонецФункции

// Возвращает уникальное имя файла, полученное от исходного добавлением порядкового номера.
// 
// Параметры:
//  ИсходноеИмяФайла - Строка - Имя файла.
//  ЭтоКаталог - Булево - Истина, если это каталог.
//  
//  Возвращаемое значение:
//   Строка - Уникальное имя файла.
//
Функция УникальноеИмяФайла(Знач ИсходноеИмяФайла, Знач ЭтоКаталог = Ложь) Экспорт
	
	ПозицияДляДополнения = СтрНайти(ИсходноеИмяФайла, ".", НаправлениеПоиска.СКонца);
	Если ПозицияДляДополнения = 0 Или ЭтоКаталог Тогда
		ПозицияДляДополнения = СтрДлина(ИсходноеИмяФайла) + 1;
	КонецЕсли;
	
	Счетчик = 0;
	Пока Истина Цикл
		
		ДополнениеИмени = ?(Счетчик = 0, "", СтрШаблон(" (%1)", Формат(Счетчик, "ЧГ=0;")));
		ИмяФайла = Лев(ИсходноеИмяФайла, ПозицияДляДополнения - 1) + ДополнениеИмени
			+ Сред(ИсходноеИмяФайла, ПозицияДляДополнения);

		Файл = Новый Файл(ИмяФайла);
		Если Не Файл.Существует() Тогда
			Прервать;
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	Возврат ИмяФайла;
	
КонецФункции

Функция ПредставлениеМаршрутаПоДереву(ДеревоМаршрута) Экспорт
	
	КоличествоПодписантов = КоличествоПодписантовМаршрута(ДеревоМаршрута);
	
	Если КоличествоПодписантов = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СтрШаблон(НСтр("ru='<Заполнен вручную, %1>'"),
				СтрокаСЧислом(";%1 подписант;;%1 подписанта;%1 подписантов;%1 подписанта",
				КоличествоПодписантов, ВидЧисловогоЗначения.Количественное, "L=ru"));
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредставлениеСтрокиУсловия(СтрокаДерева)
	
	Результат = "";
	Если ЗначениеЗаполнено(СтрокаДерева.Группа) Тогда
		Результат = ПредставленияГрупп()[СтрокаДерева.Группа];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КоличествоПодписантовМаршрута(УзелДерева)
	
	Количество = 0;
	
	Для Каждого СтрокаДерева Из УзелДерева.ПолучитьЭлементы() Цикл
		Если ЗначениеЗаполнено(СтрокаДерева.Группа) Тогда
			Количество = Количество + КоличествоПодписантовМаршрута(СтрокаДерева);
		Иначе
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

#КонецОбласти
