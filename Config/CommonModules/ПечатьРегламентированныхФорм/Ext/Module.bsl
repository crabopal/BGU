// непосредственное формирование печатной формы

Функция ПодготовитьГруппыРаскрытияТекущийБланкДляПечати(ЭкземплярОтчета, ТекущийБланк)

	ТабДокВывода = Новый ТабличныйДокумент;
	ТабДокВывода.Вывести(ТекущийБланк);
	
	// Удалим строки-подсказки
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтрокиОтчетов.Код КАК КодСтроки,
	|	СтрокиОтчетов.ГруппаРаскрытия.Код КАК КодГруппыРаскрытия
	|ИЗ
	|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	|ГДЕ
	|	СтрокиОтчетов.ГруппаРаскрытия <> ЗНАЧЕНИЕ(Справочник.ГруппыРаскрытия.ПустаяСсылка)
	|	И СтрокиОтчетов.Владелец = &ВидОтчета";
	
	Запрос.УстановитьПараметр("ВидОтчета",ЭкземплярОтчета.ВидОтчета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МакетыРаскрытия = ЭкземплярОтчета.ВернутьМассивМакетовРаскрытия(СокрП(Выборка.КодГруппыРаскрытия)+"_"+СокрП(Выборка.КодСтроки));
		ИскомаяСтрока = СокрП(Выборка.КодГруппыРаскрытия)+"_"+СокрП(Выборка.КодСтроки)+"_РазметкаПустойСтроки";
		Обл = ТабДокВывода.Области.Найти(ИскомаяСтрока);
		Если МакетыРаскрытия.Строка <> Неопределено Тогда
						
			Макет = МакетыРаскрытия.Строка.ПолучитьОбласть();			
			// точечные границы в раскрытии - условно невидимы при печати
			ЯчейкаСЛевойГраницей  = Новый Массив;
			ЯчейкаСПравойГраницей = Новый Массив;
			
			Для Каждого ОблМакета Из Макет.Области Цикл
				
				Если ОблМакета.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
					Продолжить;
				КонецЕсли;
				
				Если ОблМакета.ГраницаСлева.ТипЛинии = ТипЛинииЯчейкиТабличногоДокумента.Точечная Тогда
					ОблМакета.ГраницаСлева = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
					ЯчейкаСЛевойГраницей.Добавить(ОблМакета.Имя);
				КонецЕсли;
				
				Если ОблМакета.ГраницаСправа.ТипЛинии = ТипЛинииЯчейкиТабличногоДокумента.Точечная Тогда
					ОблМакета.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
					ЯчейкаСПравойГраницей.Добавить(ОблМакета.Имя);
				КонецЕсли;
				
			КонецЦикла;
			
			Инд = 0; // Удаление точечных границ
			ОбработкаЗавершена = Ложь;
			
			Пока Не ОбработкаЗавершена Цикл
				
				СтрокаОбработана = Ложь;
				НомерЯчейки = Формат(Инд,"ЧН=0; ЧГ=");
				Для Каждого ИмяЯчейки Из ЯчейкаСЛевойГраницей Цикл
					Ячейка = ТабДокВывода.Области.Найти(ИмяЯчейки+"_"+НомерЯчейки);
					Если ЗначениеЗаполнено(Ячейка) Тогда
						Ячейка.ГраницаСлева = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
						СтрокаОбработана = Истина;
					КонецЕсли;
				КонецЦикла;
				
				Для Каждого ИмяЯчейки Из ЯчейкаСПравойГраницей Цикл
					Ячейка = ТабДокВывода.Области.Найти(ИмяЯчейки+"_"+НомерЯчейки);
					Если ЗначениеЗаполнено(Ячейка) Тогда
						Ячейка.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
						СтрокаОбработана = Истина;
					КонецЕсли;
				КонецЦикла;
				
				Инд = Инд+1;
				
				ОбработкаЗавершена = Не СтрокаОбработана;
				
			КонецЦикла;
			
			Если Обл <> Неопределено Тогда
				ОбластьМакета = Макет.Область(1,1,Макет.ВысотаТаблицы,Макет.ШиринаТаблицы);
				ОбластьВставки = ТабДокВывода.Область(Обл.Верх,1,Обл.Низ,Обл.Право);
				ТабДокВывода.ВставитьОбласть(ОбластьМакета,ОбластьВставки,ТипСмещенияТабличногоДокумента.БезСмещения);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СкопироватьПараметрыПечати(ТабДокВывода, ТекущийБланк);
	
	Возврат ТабДокВывода;

КонецФункции // ПодготовитьТекущийБланкДляПечати()

Функция СформироватьОтчет(ДокументОбъект,ОписаниеКоманды)
	
	СправочникБланк = ОписаниеКоманды.Бланк;	
	ВариантОтчета = ОписаниеКоманды.НазваниеВарианта;
	
	Макет = СправочникБланк.Макет.Получить();
	Если ТипЗнч(Макет) <> Тип("ТабличныйДокумент") Тогда
		Сообщить("Данный бланк не содержит макета",СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ТабДокРезультат = Новый ТабличныйДокумент;
		
	Попытка
		ДескрипторМодуля = ПользовательскиеАлгоритмы.ПодготовитьДескрипторМодуля(СправочникБланк);
		ВыполнитьАлгоритмФормирования(ДокументОбъект,Макет,ВариантОтчета,ТабДокРезультат,СправочникБланк,ДескрипторМодуля);
		ПользовательскиеАлгоритмы.ОсвободитьДескрипторМодуля(ДескрипторМодуля);
	Исключение
		//Сообщить(Диагностика.ПолучитьТекстОшибки(ИнформацияОбОшибке()),СтатусСообщения.Важное);
		ПользовательскиеАлгоритмы.ОсвободитьДескрипторМодуля(ДескрипторМодуля);
		ВызватьИсключение ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке());
		//Возврат Неопределено;
	КонецПопытки;
	
	СкопироватьПараметрыПечати(ТабДокРезультат, Макет);
		
	Возврат ТабДокРезультат;

КонецФункции // СформироватьФормуОтчета()

Функция ВыполнитьПроцедуру(ОписательПроцедуры, ПараметрыПроцедуры = Неопределено)
	
	Попытка
		ЭтотМодуль           = ОписательПроцедуры.РодительскийМодуль.ПроцедурыМодуля;
		ВозвращаемоеЗначение = Неопределено;
		ТекстПроцедуры       = ПользовательскиеАлгоритмыПовтИсп.ПолучитьТекстПроцедуры(ОписательПроцедуры.РодительскийМодуль.Ссылка,ОписательПроцедуры.ИмяПроцедуры);
		
		УстановитьБезопасныйРежим(Истина);
		Выполнить(ТекстПроцедуры);
		УстановитьБезопасныйРежим(Ложь);
		
		Возврат ВозвращаемоеЗначение;
		
	Исключение
		УстановитьБезопасныйРежим(Ложь);
		ТекстИсключения = "Ошибка при выполнении процедуры """ + ОписательПроцедуры.ИмяПроцедуры + """ в модуле """ + ОписательПроцедуры.РодительскийМодуль.Ссылка + """:
		                  |" + ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке());
		
		ВызватьИсключение ТекстИсключения; 
		
	КонецПопытки;
	
КонецФункции

Процедура ВыполнитьАлгоритмФормирования(ДокументОбъект,Макет,ВариантОтчета,ТабДокРезультат,СправочникБланк,ДескрипторМодуля)
	
	ИмяПроцедуры = ПользовательскиеАлгоритмы.ПолучитьИмяОбработчикаСобытия(ТипЗнч(ДескрипторМодуля.Ссылка),"Печать");
	ЭтотМодуль   = ДескрипторМодуля.ПроцедурыМодуля;
	
	УстановитьБезопасныйРежим(Истина);
	
	Выполнить(ПользовательскиеАлгоритмыПовтИсп.ПолучитьТекстПроцедуры(ДескрипторМодуля.Ссылка,ИмяПроцедуры));
	
	УстановитьБезопасныйРежим(Ложь);
	
КонецПроцедуры

