#Если Клиент Тогда
	
// Устанавливает кнопки вызова печати для произвольных форм.
//
Процедура УстановитьКнопкиПечати(Форма, ЭкземплярОтчета, МестоВывода, ДействиеПечати) Экспорт
	
	МестоВывода.Кнопки.Очистить();
	
	КомандыПечати = ПолучитьКомандыПечати(ЭкземплярОтчета);
	ВыводитьПодразделы = НесколькоПроизвольныхБланковФормы(КомандыПечати);
	
	Форма.КомандыПечати = КомандыПечати;
	
	ЭтоПервый = Истина;
	
	Для Каждого ОписаниеКоманды из КомандыПечати Цикл 
		
		
		Если ВыводитьПодразделы И ЗначениеЗаполнено(ОписаниеКоманды.Подраздел) И ЗначениеЗаполнено(ОписаниеКоманды.ИдПодраздела) Тогда 
			
			ИмяПодраздела = "ПодразделПечатныхФорм_" + ОписаниеКоманды.ИдПодраздела;
			Подраздел = МестоВывода.Кнопки.Найти(ИмяПодраздела);
			Если Подраздел = Неопределено Тогда 
				
				Подраздел = МестоВывода.Кнопки.Добавить(ИмяПодраздела, ТипКнопкиКоманднойПанели.Подменю, ОписаниеКоманды.Подраздел);
				Если ОписаниеКоманды.Тип = "ОсновнойПроизвольныйБланк" Тогда

					Подраздел.Картинка = БиблиотекаКартинок.ЗолотойШар;

				Иначе	
					Подраздел.Картинка = Новый Картинка;
				КонецЕсли;
				
			КонецЕсли;	
			
			МестоВыводаКнопки = Подраздел;
		Иначе 
			МестоВыводаКнопки = МестоВывода;
		КонецЕсли;
		
		НоваяКнопкаПечати = МестоВыводаКнопки.Кнопки.Добавить(ОписаниеКоманды.ИмяКоманды,ТипКнопкиКоманднойПанели.Действие ,ОписаниеКоманды.Название, ДействиеПечати);
		НоваяКнопкаПечати.Подсказка  = ОписаниеКоманды.Подсказка;
		Если ЭтоПервый или ОписаниеКоманды.Основной Тогда 
			НоваяКнопкаПечати.Картинка = БиблиотекаКартинок.Печать;
		Иначе 
			НоваяКнопкаПечати.Картинка = Новый Картинка;
		КонецЕсли;	

		ЭтоПервый = Ложь;
	КонецЦикла;
	
КонецПроцедуры // УстановитьКнопкиПечати()

#КонецЕсли

// Заполняет кнопки печати в управляемой форме.
//
Процедура ОбновитьКнопкиПечатиУФ(ЭтаФорма, ЭкземплярОтчета, МестоВывода) Экспорт
	
	//удаляем то что есть
	Для Каждого ОписаниеКоманды из ЭтаФорма.КомандыПечати Цикл 
		
		КнопкаПечати = ЭтаФорма.Элементы.Найти(ОписаниеКоманды.ИмяКоманды);
		Если КнопкаПечати <> Неопределено Тогда
			ЭтаФорма.Элементы.Удалить(КнопкаПечати);
		КонецЕсли;	
		
		КомандаФормы = ЭтаФорма.Команды.Найти(ОписаниеКоманды.ИмяКоманды);
		Если КомандаФормы <> Неопределено Тогда 
			ЭтаФорма.Команды.Удалить(КомандаФормы);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОписаниеКоманды.ИдПодраздела) Тогда 
			
			ИмяПодраздела = "ПодразделПечатныхФорм_" + ОписаниеКоманды.ИдПодраздела;
			Подраздел = ЭтаФорма.Элементы.Найти(ИмяПодраздела);
			Если Подраздел <> Неопределено Тогда
				ЭтаФорма.Элементы.Удалить(Подраздел);
			КонецЕсли;	
			
		КонецЕсли;	
		
		
	КонецЦикла;	
	
	//Создаем новые
	
	КомандыПечати = ПолучитьКомандыПечати(ЭкземплярОтчета);
	ВыводитьПодразделы = НесколькоПроизвольныхБланковФормы(КомандыПечати);
	
	ЭтаФорма.КомандыПечати.Загрузить(КомандыПечати);
	
	ЭтоПервый = Истина;
	
	Для Каждого ОписаниеКоманды из КомандыПечати Цикл 
		
		КомандаФормы 				= ЭтаФорма.Команды.Добавить(ОписаниеКоманды.ИмяКоманды);
		КомандаФормы.Заголовок  	= ОписаниеКоманды.Название;
		КомандаФормы.Подсказка 		= ОписаниеКоманды.Подсказка;
		КомандаФормы.Действие		= "Печать";
		  
		
		Если ВыводитьПодразделы И ЗначениеЗаполнено(ОписаниеКоманды.Подраздел) И ЗначениеЗаполнено(ОписаниеКоманды.ИдПодраздела) Тогда 
			
			ИмяПодраздела = "ПодразделПечатныхФорм_" + ОписаниеКоманды.ИдПодраздела;
			Подраздел = ЭтаФорма.Элементы.Найти(ИмяПодраздела);
			Если Подраздел = Неопределено Тогда 
				
				Подраздел = ЭтаФорма.Элементы.Вставить(ИмяПодраздела,Тип("ГруппаФормы"),МестоВывода);
				Подраздел.Вид = ВидГруппыФормы.Подменю;
				Подраздел.Заголовок  = ОписаниеКоманды.Подраздел;
				Если ОписаниеКоманды.Тип = "ОсновнойПроизвольныйБланк" Тогда

					Подраздел.Картинка = БиблиотекаКартинок.ЗолотойШар;

				Иначе
					Подраздел.Картинка = Новый Картинка;
				КонецЕсли;	
				
			КонецЕсли;	
			
			МестоВыводаКнопки = Подраздел;
		Иначе 
			МестоВыводаКнопки = МестоВывода;
		КонецЕсли;
		
		НоваяКнопкаПечати = ЭтаФорма.Элементы.Вставить(ОписаниеКоманды.ИмяКоманды,Тип("КнопкаФормы"),МестоВыводаКнопки);
		НоваяКнопкаПечати.ИмяКоманды = ОписаниеКоманды.ИмяКоманды;
		Если ЭтоПервый или ОписаниеКоманды.Основной Тогда 
			НоваяКнопкаПечати.Картинка = БиблиотекаКартинок.Печать;
		Иначе 
			НоваяКнопкаПечати.Картинка = Новый Картинка;
		КонецЕсли;	

		ЭтоПервый = Ложь;
	КонецЦикла;	

КонецПроцедуры // УстановитьКнопкиПечатиУправляемойФормы()

// Функция возвращает заполненную печатную форму документа.
//
// Параметры
//  ЭкземплярОтчета - отчет, выводимый на печать
//
//  КомандаПечати	- структура или строка дерева значений,
//                    возвращаемого ф-ей ПолучитьКомандыПечати().
//					  Используются свойства ИмяКоманды и Текст.
//
// Возвращаемое значение:
//   ТабличныйДокумент - печатная форма документа.
//
Функция ПолучитьПечатнуюФорму(ЭкземплярОтчета, ОписаниеКоманды) Экспорт

	
	Если ТипЗнч(ОписаниеКоманды)= Тип("Структура") И (ОписаниеКоманды.Тип = "ОсновнойПроизвольныйБланк" Или ОписаниеКоманды.Тип = "ДополнительныйПроизвольныйБланк") Тогда
		
		ТабДок = СформироватьОтчет(ЭкземплярОтчета,ОписаниеКоманды);
		
		ИсточникКлюча = ОписаниеКоманды.Бланк;
						
	Иначе 
		ВызватьИсключение НСтр("ru = 'Неизвестный тип шаблона.'");
	КонецЕсли;
	
	
	Если ТипЗнч(ТабДок) <> Тип("ТабличныйДокумент") Тогда
		Возврат Неопределено;
	КонецЕсли;	
		
	Если не ЗначениеЗаполнено(ТабДок.КлючПараметровПечати) Тогда 
			ТабДок.КлючПараметровПечати = ПолучитьКлючНастроекПечати(ИсточникКлюча);
	КонецЕсли;
	
	
	ТабДок.ТолькоПросмотр 		= Истина;
	ТабДок.ОтображатьЗаголовки  = Ложь;
	ТабДок.ОтображатьСетку		= Ложь;
	
	Возврат ТабДок;
	
КонецФункции // ПолучитьПечатнуюФорму()

Функция ПолучитьСтраницуПечатнойФормыТекущегоБланка(ЭкземплярОтчета, ПечатаемаяСтраница) Экспорт
	
	ТабДок = Неопределено;
	ОбщийТабДок = Неопределено;
	ТекТабДок = Неопределено;
	Если ПечатаемаяСтраница <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(ПечатаемаяСтраница.АдресБланка) Тогда
			
			ТекТабДок = ПолучитьИзВременногоХранилища(ПечатаемаяСтраница.АдресБланка);
			ТекНастройки = ПолучитьИзВременногоХранилища(ПечатаемаяСтраница.АдресНастроек);
		Иначе
			СтруктураСтраницы = Справочники.БланкиОтчетов.ПолучитьМакетИНастройкиСтраницыБланка(ЭкземплярОтчета.ШаблонОтчета,ПечатаемаяСтраница.ИмяСтраницы);
			
			ТекТабДок = СтруктураСтраницы.Макет;
			ТекНастройки = СтруктураСтраницы.ПараметрыНастройкиБланка;
		КонецЕсли;
		
		ТабДок = Новый ТабличныйДокумент;
		Если ТекТабДок<>Неопределено Тогда	
			ТабДок.Вывести(ТекТабДок);
		КонецЕсли;
		
		Если ТипЗнч(ТекНастройки) <> Тип("ТаблицаЗначений") Тогда		
			ТекНастройки = Справочники.БланкиОтчетов.ПолучитьПустуюТаблицуНастроекБланка();
		Иначе
			Справочники.БланкиОтчетов.ДополнитьТаблицуНастроекКолонками(ТекНастройки);
		КонецЕсли;
		//Установим текущие настройки			
		ЭкземплярОтчета.мНастройкиБланка = ТекНастройки;
		
		МассивПоказателейСтраницы = ЭкземплярОтчета.ПолучитьМассивПоказателейСтраницы();
	
		ЭкземплярОтчета.ЗаполнитьМакет(ТабДок,МассивПоказателейСтраницы);
		
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭкземплярОтчета.БланкОтчета,"РаскрытиеВМакете") = Перечисления.СпособыРедактированияРаскрытия.ВТелеОтчета Тогда		
			
			ЭкземплярОтчета.ВывестиРаскрытиеВТелеОтчета(ТабДок);
			
			ТабДок.ПоказатьУровеньГруппировокСтрок(1);
			
			ОбщийТабДок = ПодготовитьГруппыРаскрытияТекущийБланкДляПечати(ЭкземплярОтчета,ТабДок);
		Иначе
			ОбщийТабДок = Новый ТабличныйДокумент;
			ОбщийТабДок.Вывести(ТабДок);
		КонецЕсли;
		
		ИсточникКлюча = ЭкземплярОтчета.ШаблонОтчета;
		
		Область = ОбщийТабДок.Область(); //ЧерноБелыйПросмотр не работает в веб клиенте (и с БСП не дружит)
		Область.ЦветФона = Новый Цвет;
		Область.ЦветТекста  = Новый Цвет;
		Область.ЦветРамки  = Новый Цвет;
		Область.ЦветУзора = Новый Цвет;
		Область.ВыделятьОтрицательные = Ложь;

		
		ОбщийТабДок.ЧерноБелаяПечать = Истина;
		
	КонецЕсли;
		
	Если ТипЗнч(ОбщийТабДок) <> Тип("ТабличныйДокумент") Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	КлючПараметровПечати = ПолучитьКлючНастроекПечати(ИсточникКлюча)+"_"+ПечатаемаяСтраница.ИмяСтраницы;

	Если ТекТабДок <> Неопределено Тогда
		//копируем настройки печати из макета страницы бланка отчета
		ПрименитьПользовательскиеНастройкиПечати(КлючПараметровПечати,ОбщийТабДок,ТекТабДок,,ПечатаемаяСтраница.ИмяСтраницы);	
	Иначе
		ОбщийТабДок.КлючПараметровПечати = КлючПараметровПечати;
	КонецЕсли;	
	
	ОбщийТабДок.ТолькоПросмотр 		= Истина;
	ОбщийТабДок.ОтображатьЗаголовки  = Ложь;
	ОбщийТабДок.ОтображатьСетку		= Ложь;
	
	Возврат ОбщийТабДок;
	
КонецФункции


// При наличии сохраненных пользовательских настроек печати применяет их к документу-приемнику
//
Процедура ПрименитьПользовательскиеНастройкиПечати(Знач КлючНастроек, Знач ДокументПриемник, Знач ДокументИсточник, Знач ПриоритетИсточникаПередБазой = Истина, ИмяСтраницы = "") Экспорт 

	Если Не ПустаяСтрока(ДокументПриемник.КлючПараметровПечати) Тогда
		Возврат; // Настройки уже заданы
	КонецЕсли;
	
	Если Не ПустаяСтрока(ДокументИсточник.КлючПараметровПечати) и ПриоритетИсточникаПередБазой Тогда
		СкопироватьПараметрыПечати(ДокументПриемник, ДокументИсточник);
		ДокументПриемник.КлючПараметровПечати = ДокументИсточник.КлючПараметровПечати;
		Возврат;
	КонецЕсли;

	Если ТипЗнч(КлючНастроек) = Тип("Строка") Тогда
		СтрокаКлюч = КлючНастроек;
	Иначе
		СтрокаКлюч = ПолучитьКлючНастроекПечати(КлючНастроек)+?(ЗначениеЗаполнено(ИмяСтраницы),"_"+ИмяСтраницы,"");
	КонецЕсли;
		
	
	СкопироватьПараметрыПечати(ДокументПриемник, ДокументИсточник);
	ДокументПриемник.КлючПараметровПечати = СтрокаКлюч;
	
КонецПроцедуры // ПрименитьПользовательскиеНастройкиПечати()

// Копирует настройки параметров печати страницы из одного табличного документа в другой.
//
// Параметры
//  Приемник  - ТабличныйДокумент - документ, который принимает настройки.
//                 
//  Источник  - ТабличныйДокумент - документ, из которого копируются настройки                 
//
Процедура СкопироватьПараметрыПечати(Приемник,Источник) Экспорт

	СохраняемыеСвойства = "ПолеСверху,ПолеСлева,ПолеСнизу,ПолеСправа,ОриентацияСтраницы,АвтоМасштаб,МасштабПечати,ФиксацияСверху,ФиксацияСлева";
	ЗаполнитьЗначенияСвойств(Приемник,Источник,СохраняемыеСвойства);
	
	Если Источник.ОбластьПечати <> Неопределено Тогда
		Приемник.ОбластьПечати = Приемник.Область(Источник.ОбластьПечати.Имя);
	КонецЕсли;
	Если Источник.ПовторятьПриПечатиСтроки <> Неопределено Тогда
		Приемник.ПовторятьПриПечатиСтроки = Приемник.Область(Источник.ПовторятьПриПечатиСтроки.Имя);
	КонецЕсли;
	Если Источник.ПовторятьПриПечатиКолонки <> Неопределено Тогда
		Приемник.ПовторятьПриПечатиКолонки = Приемник.Область(Источник.ПовторятьПриПечатиКолонки.Имя);
	КонецЕсли;

КонецПроцедуры // СкопироватьПараметрыПечати()

// Функция возвращает таблицу значений с описаниями кнопок управления печатью.
//
// Параметры
//  ЭкземплярОтчета - ДокументОбъект - текущий отчет.
//
// Возвращаемое значение:
//   Таблица значений.
//
Функция ПолучитьКомандыПечати(ЭкземплярОтчета) Экспорт 
	
	КомандыПечати = Новый ТаблицаЗначений;
	КомандыПечати.Колонки.Добавить("ИмяКоманды"		,Новый ОписаниеТипов("Строка"));
	КомандыПечати.Колонки.Добавить("Тип"			,Новый ОписаниеТипов("Строка")); 
	КомандыПечати.Колонки.Добавить("Название"		,Новый ОписаниеТипов("Строка"));
	КомандыПечати.Колонки.Добавить("Подсказка"		,Новый ОписаниеТипов("Строка"));
	КомандыПечати.Колонки.Добавить("Подраздел"		,Новый ОписаниеТипов("Строка"));
	КомандыПечати.Колонки.Добавить("ИдПодраздела"	,Новый ОписаниеТипов("Строка"));
	КомандыПечати.Колонки.Добавить("Основной"		,Новый ОписаниеТипов("Булево")); 
	КомандыПечати.Колонки.Добавить("Бланк"			,Новый ОписаниеТипов("СправочникСсылка.ПроизвольныеБланкиФорм"));
	КомандыПечати.Колонки.Добавить("НомерВарианта"	,Новый ОписаниеТипов("Число"));
	КомандыПечати.Колонки.Добавить("НазваниеВарианта",Новый ОписаниеТипов("Строка"));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Бланк",ЭкземплярОтчета.ОсновнойПечатныйБланк);
	Запрос.УстановитьПараметр("ВидОтчета",ЭкземплярОтчета.ВидОтчета);
	Запрос.УстановитьПараметр("НазваниеТекущегоБланка",НСтр("ru = 'Текущий бланк'"));
	Запрос.УстановитьПараметр("ПодсказкаТекущегоБланка",НСтр("ru = 'Вывод на печать бланка используемого для редактирования отчета.'"));

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПроизвольныеБланкиФормВариантыФорм.Основной КАК Основной,
	|	ПроизвольныеБланкиФормВариантыФорм.Название КАК Название,
	|	ПроизвольныеБланкиФормВариантыФорм.Подсказка КАК Подсказка,
	|	ПроизвольныеБланкиФормВариантыФорм.НомерСтроки КАК НомерВарианта,
	|	ПроизвольныеБланкиФормВариантыФорм.Название КАК НазваниеВарианта,
	|	ПроизвольныеБланкиФормВариантыФорм.Ссылка.Наименование КАК Подраздел,
	|	ПроизвольныеБланкиФормВариантыФорм.Ссылка.Код КАК ИдПодраздела,
	|	2 КАК Приоритет,
	|	ПроизвольныеБланкиФормВариантыФорм.Ссылка КАК Бланк,
	|	""ОсновнойПроизвольныйБланк"" КАК Тип
	|ИЗ
	|	Справочник.ПроизвольныеБланкиФорм.ВариантыФорм КАК ПроизвольныеБланкиФормВариантыФорм
	|ГДЕ
	|	ПроизвольныеБланкиФормВариантыФорм.Ссылка = &Бланк
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЛОЖЬ,
	|	&НазваниеТекущегоБланка,
	|	&ПодсказкаТекущегоБланка,
	|	0,
	|	"""",
	|	"""",
	|	"""",
	|	1,
	|	NULL,
	|	""ТекущийБланк""
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПроизвольныеБланкиФормВариантыФорм.Основной,
	|	ПроизвольныеБланкиФормВариантыФорм.Название,
	|	ПроизвольныеБланкиФормВариантыФорм.Подсказка,
	|	ПроизвольныеБланкиФормВариантыФорм.НомерСтроки,
	|	ПроизвольныеБланкиФормВариантыФорм.Название,
	|	ПроизвольныеБланкиФормВариантыФорм.Ссылка.Наименование,
	|	ПроизвольныеБланкиФормВариантыФорм.Ссылка.Код,
	|	3,
	|	ПроизвольныеБланкиФормВариантыФорм.Ссылка,
	|	""ДополнительныйПроизвольныйБланк""
	|ИЗ
	|	Справочник.ПроизвольныеБланкиФорм.ВариантыФорм КАК ПроизвольныеБланкиФормВариантыФорм
	|ГДЕ
	|	ПроизвольныеБланкиФормВариантыФорм.Ссылка <> &Бланк
	|	И ПроизвольныеБланкиФормВариантыФорм.Ссылка.Использование
	|	И ПроизвольныеБланкиФормВариантыФорм.Ссылка.Владелец = &ВидОтчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	Основной УБЫВ,
	|	НомерВарианта";
	ВариантыБланка = Запрос.Выполнить().Выгрузить();
	
	Счетчик = 0;
	Для Каждого СтрокаВарианта из ВариантыБланка Цикл
		Счетчик = Счетчик+1;
		
		НоваяСтрока = КомандыПечати.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаВарианта);
		НоваяСтрока.ИмяКоманды = "КомандаПечати"+Счетчик;	
		
	КонецЦикла;	
	
	Возврат КомандыПечати;
	
КонецФункции // ПолучитьКомандыПечати()


