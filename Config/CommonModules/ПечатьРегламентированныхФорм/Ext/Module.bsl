// Формирует строковый ключ, по которому сохраняются пользовательские настройки печати.
//
Функция ПолучитьКлючНастроекПечати(Знач БланкОтчета) Экспорт
	
	ИмяТаблицы = "";
	ТипБланка = ТипЗнч(БланкОтчета);
	Если ТипБланка = Тип("СправочникСсылка.БланкиОтчетов") Тогда
		ИмяТаблицы = "Справочник.БланкиОтчетов";
	ИначеЕсли ТипБланка = Тип("СправочникСсылка.ПроизвольныеБланкиФорм") Тогда
		ИмяТаблицы = "Справочник.ПроизвольныеБланкиФорм";
	Иначе
		МетаданныеТипа = Метаданные.НайтиПоТипу(ТипБланка);
		ИмяТаблицы = МетаданныеТипа.ПолноеИмя();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БланкиОтчетов.Код КАК КодБланка,
	|	БланкиОтчетов.Владелец.Код КАК КодОтчета
	|ИЗ
	|	" + ИмяТаблицы + " КАК БланкиОтчетов
	|ГДЕ
	|	БланкиОтчетов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", БланкОтчета);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	
	ВидБланка    = ?(ТипЗнч(БланкОтчета) = Тип("СправочникСсылка.БланкиОтчетов"),"О","П");
	КодВидОтчета = Выборка.КодОтчета;
	КодБланка    = Выборка.КодБланка;
	
	СтрокаКлюч = "НастрокиПечатиОтчета_" + КодВидОтчета+"_"+ВидБланка+"_"+КодБланка;

	Возврат СтрокаКлюч;
	
КонецФункции // ПолучитьКлючНастроекПечати()

// Определяет, для формы существует один произвольный печатный бланк или несколько.
//
// Параметры
//  КомандыПечати - Таблица значений.
//
// Возвращаемое значение:
//   Булево.
// 
Функция НесколькоПроизвольныхБланковФормы(Знач КомандыПечати)
	
	ТаблицаПодразделы = КомандыПечати.Скопировать();
	ТаблицаПодразделы.Свернуть("ИдПодраздела");
	Возврат ТаблицаПодразделы.Количество() > 2;
	
КонецФункции

