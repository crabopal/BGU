Процедура ПередЗаписьюСложныхДляОбменаОбъектов(Источник, Отказ) Экспорт
	
	Если ОбменДаннымиСлужебный.ОбменДаннымиВключен("АвтономнаяРабота",Источник.ОбменДанными.Отправитель) <> Истина
		И ОбменДаннымиСлужебный.ОбменДаннымиВключен("Полный",Источник.ОбменДанными.Отправитель) <> Истина 
		И ОбменДаннымиСлужебный.ОбменДаннымиВключен("ПоОрганизации",Источник.ОбменДанными.Отправитель) <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоПолучениеДанныхИзПодчиненнойБазы = Ложь;
	Если ПланыОбмена.ГлавныйУзел() = Неопределено Тогда
		ЭтоПолучениеДанныхИзПодчиненнойБазы = Истина;
	ИначеЕсли Источник.ОбменДанными.Отправитель <> ПланыОбмена.ГлавныйУзел() Тогда
		ЭтоПолучениеДанныхИзПодчиненнойБазы = Истина;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.ИнвентарныеНомераОС") Тогда
		ЭтоГрупповойУчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.ОС, "ГрупповойУчет");
		Если ТипЗнч(ЭтоГрупповойУчет) = Тип("Булево") Тогда
			Если ЭтоГрупповойУчет Тогда
				Возврат;
			КонецЕсли;
		Иначе
			// Основного средства еще нет... ничего не делаем
			Возврат;
		КонецЕсли;
		Если ЭтоПолучениеДанныхИзПодчиненнойБазы Тогда
			//Проверим наличие других Инвентарных номеров, и если они есть, запишем данный с пометкой удаления
			Если Источник.УжеЕстьИнвНомер(Источник.Владелец,Источник.ОС) Тогда
				Источник.ПометкаУдаления = Истина;
			КонецЕсли;
		Иначе
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ОС", Источник.ОС);
			Запрос.УстановитьПараметр("Организация", Источник.Владелец);
			Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
			
			Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ИнвентарныеНомераОС.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
			|ГДЕ
			|	ИнвентарныеНомераОС.Владелец = &Организация
			|	И ИнвентарныеНомераОС.ОС = &ОС
			|	И ИнвентарныеНомераОС.Ссылка <> &Ссылка
			|	И НЕ ИнвентарныеНомераОС.ПометкаУдаления";
			
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ТекОбъект = Выборка.Ссылка.ПолучитьОбъект();
				ТекОбъект.ПометкаУдаления = Истина;
				ТекОбъект.Записать();
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг") Тогда
		Если ЭтоПолучениеДанныхИзПодчиненнойБазы Тогда
			Если Источник.УжеЕстьШаблон(Источник.Владелец) Тогда
				Источник.ПометкаУдаления = Истина;
			КонецЕсли;
		Иначе
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Организация", Источник.Владелец);
			Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
			Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	СпрШаблоны.Ссылка КАК Ссылка,
			|	СпрШаблоны.Владелец КАК Владелец
			|ИЗ
			|	Справочник.ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг КАК СпрШаблоны
			|ГДЕ
			|	СпрШаблоны.Владелец = &Организация
			|	И НЕ СпрШаблоны.ПометкаУдаления
			|	И СпрШаблоны.Ссылка <> &Ссылка";
			
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				ТекОбъект = Выборка.Ссылка.ПолучитьОбъект();
				ТекОбъект.ПометкаУдаления = Истина;
				ТекОбъект.Записать();
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
