Процедура ПередЗаписьюОбъектовРазрешенныхКИзменениюТолькоВКорневомУзле(Источник, Отказ) Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("СозданиеНачальногоОбраза") 
		ИЛИ Источник.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") 
		ИЛИ Источник.ДополнительныеСвойства.Свойство("РегистрироватьНаУзлахПлановОбменаПриОбновленииИБ") Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Тогда 
		Если Источник.ОбменДанными.Отправитель = Неопределено Тогда
			Отказ = Истина;
			ВызватьИсключение НСтр("ru='Объект """ + Источник.Метаданные().Синоним + """ разрешено редактировать только в центральном узле РИБ'");
			Возврат;
		КонецЕсли;
	Иначе
		Отказ = Истина;
		ВызватьИсключение НСтр("ru='Объект """ + Источник.Метаданные().Синоним + """ разрешено редактировать только в центральном узле РИБ'");
		Возврат;
	КонецЕсли;
КонецПроцедуры

