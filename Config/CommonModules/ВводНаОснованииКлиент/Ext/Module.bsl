////////////////////////////////////////////////////////////////////////////////
// Общий модуль ВводНаОснованииКлиент
// 
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Разбивает данные документа-основания на порции для заполнения новых документов,
// открывает форму для отметки тех порций, по которым следует создать документы.
//
// Параметры
//	ПараметрыВводаНаОсновании				- Структура	- настройки для работы механизма
//		Обязательные ключи:
//			ПараметрКоманды					- Произвольный	- 
//												стандартный параметр
//												из обработчика в модуле команды
//
//			ПараметрыВыполненияКоманды		- ПараметрыВыполненияКоманды	- 
//												стандартный параметр
//												из обработчика в модуле команды
//
//			ИмяТабличнойЧастиДокументаОснования	- Строка	- имя анализируемой табл.части
//
//		Опциональные ключи:
//			ИмяЭлементаСписокВФормеСписка	- Строка	- имя элемента динамического списка
//												в форме списка документа.
//												Значение по умолчанию ="Список".
//												Используется для определения выбранного документа
//												при вызове команды из формы списка документов.
//
//			ИскатьСуществующиеДокументы		- Булево	- проверять наличие существующих документов
//												с совпадающими значениями реквизитов шапки
//												ЗначениеПоУмолчанию = Истина
//
//			РазрешитьОтметкуСуществующихДокументов	- Булево	- разрешать отметку строк,
//														по которым обнаружен уже существующий документ
//														ЗначениеПоУмолчанию = Истина
//
//			ИмяКолонкиВидДокумента			- Строка	- имя колонки в табличной части документа-основания,
//												в которой указан вид создаваемого документа для каждой строки.
//												ЗначениеПоУмолчанию = "ВидДокумента"
//
//			ВидДокумента					- Строка	- вид создаваемых документов, как он задан в конфигураторе.
//												Например, "ТребованиеНакладнаяИК".
//												Если допустимо создавать на основании лишь 1 вид документов,
//												то нет смысла в отдельной колонке ВидДокумента табличной части,
//												а можно заполнить данный параметр.
//												Все создаваемые документы будут рассматриваться как документы этого вида.
//
//			ИмяЭлементаСписокВФормеСписка	- Строка	- имя элемента со списком документов на форме списка документов.
//												Используется для определения того документа (текущей строки списка),
//												для которого была вызвана команда из формы списка документов.
//												ЗначениеПоУмолчанию = "Список"
//
//			РазрешитьВводНаОснованииНепроведенногоДокумента	- Булево	-
//												Опциональный параметр
//												ЗначениеПоУмолчанию = Ложь
//
//			ВводНовогоБезОткрытияФормыВыбора	- Булево - если для ввода на основании доступно создание 
//												только 1 документа, форма выбора не открывается. 
//												Открывается заполненная форма нового документа.
//												ЗначениеПоУмолчанию = Ложь
//
Процедура ОткрытьФормуВводаНаОсновании(ПараметрыВводаНаОсновании) Экспорт
	
	Перем	ДокументОснованиеСсылка,
			ДокументОснованиеПроведен,
			ФормаИсточникСобытия;
	
	// Стандартные параметры обработчика команды
	ПараметрКоманды				= ПараметрыВводаНаОсновании["ПараметрКоманды"];
	ПараметрыВыполненияКоманды	= ПараметрыВводаНаОсновании["ПараметрыВыполненияКоманды"];
	
	ТекстЗаголовкаСообщений = НСтр("ru='Ввод на основании отменен'");
	
	ПроверитьВходныеПараметры(ПараметрыВводаНаОсновании);
	
	ДокументОснование = ОпределитьДокументОснование(ПараметрыВводаНаОсновании);
	ДокументОснованиеСсылка		= ДокументОснование["Ссылка"];
	ДокументОснованиеПроведен	= ДокументОснование["Проведен"];
	ФормаИсточникСобытия		= ДокументОснование["ФормаИсточникСобытия"];
	
	// Входные проверки документа-основания
	Если НЕ ЗначениеЗаполнено(ДокументОснованиеСсылка) Тогда
		ТекстСообщения = НСтр("ru='Ввод на основании отменен: Не удалось определить ссылку на документ-основание'");
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	ОтменитьВводНаОсновании = НЕ ДокументОснованиеПроведен
		И НЕ ПараметрыВводаНаОсновании["РазрешитьВводНаОснованииНепроведенногоДокумента"];
		
	Если ОтменитьВводНаОсновании Тогда
		ТекстСообщения = НСтр("ru='Ввод на основании отменен: Документ-основание не проведен'");
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
		Возврат;
	КонецЕсли;
	
	// Дозаполняем параметры
	ПараметрыВводаНаОсновании.Вставить("ДокументОснованиеСсылка",	ДокументОснованиеСсылка);
	ПараметрыВводаНаОсновании.Вставить("УникальныйИдентификатор",	ФормаИсточникСобытия.УникальныйИдентификатор);
	
	// Удаляем уже не нужные параметры, приводящие к ошибке передачи типа на сервер
	ПараметрыВводаНаОсновании.Удалить("ПараметрКоманды");
	ПараметрыВводаНаОсновании.Удалить("ПараметрыВыполненияКоманды");
	
	РезультатОбработки	= ВводНаОснованииВызовСервера.ОбработатьПараметрыВводаНаОсновании(ПараметрыВводаНаОсновании);
	
	ПараметрыОповещения			= РезультатОбработки["ПараметрыОповещения"];
	ПараметрыФормы				= РезультатОбработки["ПараметрыФормы"];
	КоличествоНовыхДокументов	= РезультатОбработки["КоличествоНовыхДокументов"];
	
	Если КоличествоНовыхДокументов = 0 Тогда
		ТекстСообщения = НСтр("ru='Отсутствуют данные для ввода на основании'");
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
		Возврат;
	ИначеЕсли КоличествоНовыхДокументов = 1
		И ПараметрыВводаНаОсновании["ВводНовогоБезОткрытияФормыВыбора"] Тогда
		
		РезультатВыбора = Новый Структура;
		Для Каждого ЭлементВидДокумента Из ПараметрыОповещения["ПередаваемыеДанные"] Цикл
			ВидДокумента		= ЭлементВидДокумента.Ключ;
			РезультатВыбора.Вставить(ВидДокумента, Новый Структура);
			РезультатВыбора[ВидДокумента].Вставить("Индексы", Новый Массив);
			РезультатВыбора[ВидДокумента]["Индексы"].Добавить(0);
		КонецЦикла;
		ОткрытьФормуВводаНаОсновании_Закрытие(РезультатВыбора, ПараметрыОповещения);
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения_Закрытие = Новый ОписаниеОповещения("ОткрытьФормуВводаНаОсновании_Закрытие", ЭтотОбъект, ПараметрыОповещения);
	
	ОткрытьФорму("ОбщаяФорма.ВводНесколькихДокументовНаОснованииОдного",
		ПараметрыФормы,
		ФормаИсточникСобытия,
		ПараметрыВыполненияКоманды.Уникальность,
		ПараметрыВыполненияКоманды.Окно,
		,
		ОписаниеОповещения_Закрытие,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Обработчик закрытия формы ввода нескольких документов на основании одного
Процедура ОткрытьФормуВводаНаОсновании_Закрытие(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Для Каждого ЭлементВидДокумента Из РезультатВыбора Цикл
			ВидДокумента		= ЭлементВидДокумента.Ключ;
			ОтмеченныеСтроки	= ЭлементВидДокумента.Значение;
			
			Для Каждого Индекс Из ОтмеченныеСтроки["Индексы"] Цикл
				ДанныеМеханизма = Новый Структура();
				ДанныеМеханизма.Вставить("АдресДанныхДляНовогоДокумента",	ПараметрыОповещения["ПередаваемыеДанные"][ВидДокумента]["АдресаДанныхДляНовыхДокументов"][Индекс]);
				ДанныеМеханизма.Вставить("ВидДокумента",					ВидДокумента);
				ДанныеМеханизма.Вставить("ИмяТаблицыНовый",					ПараметрыОповещения["ПередаваемыеДанные"][ВидДокумента]["ИмяТаблицыНовый"]);
				
				// Данные заполнения
				ДанныеЗаполнения = Новый Структура();
				ДанныеЗаполнения.Вставить("Основание", ПараметрыОповещения["ДокументОснованиеСсылка"]);
				ДанныеЗаполнения.Вставить("ДанныеМеханизмаВводаНаОсновании", ДанныеМеханизма);
				
				ПараметрыФормы = Новый Структура();
				ПараметрыФормы.Вставить("Основание",				ДанныеЗаполнения);
				ПараметрыФормы.Вставить("ТиповаяОперация",			ПараметрыОповещения["ПередаваемыеДанные"][ВидДокумента]["ТиповаяОперация"]);
				ПараметрыФормы.Вставить("ЗначенияДопРеквизитов",	ПараметрыОповещения["ПередаваемыеДанные"][ВидДокумента]["ЗначенияРеквизитовТиповойОперации"][Индекс]);
				
				ИмяФормыДокумента = "Документ." + ВидДокумента + ".Форма.ФормаДокумента";
				
				ОткрытьФорму(ИмяФормыДокумента, ПараметрыФормы,, Истина);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьВходныеПараметры(ПараметрыВводаНаОсновании)
	
	Перем ЗначениеПараметра;
	
	// Обязательный параметр ИмяТабличнойЧастиДокументаОснования
	Если ПараметрыВводаНаОсновании.Свойство("ИмяТабличнойЧастиДокументаОснования", ЗначениеПараметра) Тогда
		ЗначениеПараметраДопустимое = (ТипЗнч(ЗначениеПараметра) = Тип("Строка") И НЕ ПустаяСтрока(ЗначениеПараметра));
		Если НЕ ЗначениеПараметраДопустимое Тогда
			ТекстСообщения = НСтр("ru='Указано недопустимое значение параметра ИмяТабличнойЧастиДокументаОснования. Ожидается текстовая строка'");
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	Иначе
		ТекстСообщения = НСтр("ru='Не указано значение обязательного параметра ИмяТабличнойЧастиДокументаОснования'");
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	// Опциональный параметр ИскатьСуществующиеДокументы
	ПараметрыВводаНаОсновании.Свойство("ИскатьСуществующиеДокументы", ЗначениеПараметра);
	Если НЕ ЗначениеПараметра = Ложь Тогда
		ЗначениеПоУмолчанию = Истина;
		ПараметрыВводаНаОсновании.Вставить("ИскатьСуществующиеДокументы", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	// Опциональный параметр РазрешитьОтметкуСуществующихДокументов
	ПараметрыВводаНаОсновании.Свойство("РазрешитьОтметкуСуществующихДокументов", ЗначениеПараметра);
	Если НЕ ЗначениеПараметра = Ложь Тогда
		ЗначениеПоУмолчанию = Истина;
		ПараметрыВводаНаОсновании.Вставить("РазрешитьОтметкуСуществующихДокументов", ЗначениеПоУмолчанию);
	КонецЕсли;
	Если ПараметрыВводаНаОсновании["РазрешитьОтметкуСуществующихДокументов"]
		И НЕ ПараметрыВводаНаОсновании["ИскатьСуществующиеДокументы"] Тогда
		ПараметрыВводаНаОсновании.Вставить("РазрешитьОтметкуСуществующихДокументов", Ложь);
	КонецЕсли;
	
	// Опциональный параметр ИмяКолонкиВидДокумента
	ПараметрыВводаНаОсновании.Свойство("ИмяКолонкиВидДокумента", ЗначениеПараметра);
	Если НЕ (ТипЗнч(ЗначениеПараметра) = Тип("Строка") И НЕ ПустаяСтрока(ЗначениеПараметра)) Тогда
		ЗначениеПоУмолчанию = "ВидДокумента";
		ПараметрыВводаНаОсновании.Вставить("ИмяКолонкиВидДокумента", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	// Опциональный параметр ВидДокумента
	ПараметрыВводаНаОсновании.Свойство("ВидДокумента", ЗначениеПараметра);
	Если НЕ (ТипЗнч(ЗначениеПараметра) = Тип("Строка") И НЕ ПустаяСтрока(ЗначениеПараметра)) Тогда
		ЗначениеПоУмолчанию = "";
		ПараметрыВводаНаОсновании.Вставить("ВидДокумента", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	// Опциональный параметр ИмяЭлементаСписокВФормеСписка
	ПараметрыВводаНаОсновании.Свойство("ИмяЭлементаСписокВФормеСписка", ЗначениеПараметра);
	Если НЕ (ТипЗнч(ЗначениеПараметра) = Тип("Строка") И НЕ ПустаяСтрока(ЗначениеПараметра)) Тогда
		ЗначениеПоУмолчанию = "Список";
		ПараметрыВводаНаОсновании.Вставить("ИмяЭлементаСписокВФормеСписка", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	// Опциональный параметр РазрешитьВводНаОснованииНепроведенногоДокумента
	ПараметрыВводаНаОсновании.Свойство("РазрешитьВводНаОснованииНепроведенногоДокумента", ЗначениеПараметра);
	Если НЕ (ТипЗнч(ЗначениеПараметра) = Тип("Булево")) Тогда
		ЗначениеПоУмолчанию = Ложь;
		ПараметрыВводаНаОсновании.Вставить("РазрешитьВводНаОснованииНепроведенногоДокумента", ЗначениеПоУмолчанию);
	КонецЕсли;
	
	// Опциональный параметр ВводНовогоБезОткрытияФормыВыбора
	ПараметрыВводаНаОсновании.Свойство("ВводНовогоБезОткрытияФормыВыбора", ЗначениеПараметра);
	Если НЕ (ТипЗнч(ЗначениеПараметра) = Тип("Булево")) Тогда
		ЗначениеПоУмолчанию = Ложь;
		ПараметрыВводаНаОсновании.Вставить("ВводНовогоБезОткрытияФормыВыбора", ЗначениеПоУмолчанию);
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьДокументОснование(ПараметрыВводаНаОсновании)
	
	Перем	ДокументОснованиеСсылка,
			ДокументОснованиеПроведен,
			ФормаИсточникСобытия;
			
	// Стандартные параметры обработчика команды
	ПараметрыВыполненияКоманды = ПараметрыВводаНаОсновании["ПараметрыВыполненияКоманды"];
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("ФормаКлиентскогоПриложения") Тогда
		ФормаИсточникСобытия = ПараметрыВыполненияКоманды.Источник;
		
		ОбозначениеФормыСписка		= ".Форма.ФормаСписка";
		ОбозначениеФормыДокумента	= ".Форма.ФормаДокумента";
		
		ВызовИзФормыСписка		= (Прав(ФормаИсточникСобытия.ИмяФормы, СтрДлина(ОбозначениеФормыСписка))	= ОбозначениеФормыСписка);
		ВызовИзФормыДокумента	= (Прав(ФормаИсточникСобытия.ИмяФормы, СтрДлина(ОбозначениеФормыДокумента))	= ОбозначениеФормыДокумента);
		
		Если ВызовИзФормыСписка Тогда
			ИмяЭлементаСписокВФормеСписка = ПараметрыВводаНаОсновании["ИмяЭлементаСписокВФормеСписка"];
			ТекДанные = ФормаИсточникСобытия.Элементы[ИмяЭлементаСписокВФормеСписка].ТекущиеДанные;
			
			Если НЕ ТекДанные = Неопределено Тогда
				ВремСтруктура = Новый Структура("Ссылка,Проведен");
				ЗаполнитьЗначенияСвойств(ВремСтруктура, ТекДанные);
				Ссылка		= ВремСтруктура["Ссылка"];
				Проведен	= ВремСтруктура["Проведен"];
				
				// Для поля Ссылка в динамическом списке
				// должен быть установлен флажок Использовать всегда
				Если ЗначениеЗаполнено(Ссылка) Тогда
					ДокументОснованиеСсылка = Ссылка;
					
					// Для поля Проведен в динамическом списке
					// допустимо произвольное значение флажка Использовать всегда
					Если Проведен = Неопределено Тогда
						ДокументОснованиеПроведен = ВводНаОснованииВызовСервера.ПрочитатьПризнакПроведен(ДокументОснованиеСсылка);
					Иначе
						ДокументОснованиеПроведен = Проведен;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ВызовИзФормыДокумента Тогда
			ДокументОснованиеСсылка		= ФормаИсточникСобытия.Объект.Ссылка;
			ДокументОснованиеПроведен	= ФормаИсточникСобытия.Объект.Проведен;
			
