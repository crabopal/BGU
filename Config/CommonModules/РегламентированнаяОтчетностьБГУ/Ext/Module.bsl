Процедура ЗаполнитьСведения_АктОРасхождениях(СвойстваИсточников, ТолькоОсновныеСвойства)
	
	ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12");
	
	Источники = МассивИсточников(СвойстваИсточников, ТипДокумента);
	
	Если Источники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СозданныеЭлектронныеДокументы = Новый Соответствие;
	ОбменСКонтрагентами.СвойстваОбъектовУчетаЭлектронныхДокументовДляВыгрузкиВФНС(Источники);
	
	ДоступныеВидыЭлектронныхДокументов = ДоступныеВидыЭлектронныхДокументов(ТипДокумента);
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Запрос = Новый Запрос();
	Запрос.Параметры.Вставить("Источники", Источники);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АктОРасхождениях.Ссылка КАК Документ,
	|	АктОРасхождениях.Организация КАК Организация,
	|	АктОРасхождениях.Контрагент КАК Контрагент,
	|	АктОРасхождениях.Организация КАК Покупатель,
	|	АктОРасхождениях.Контрагент КАК Продавец,
	|	АктОРасхождениях.Договор КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(АктОРасхождениях.Договор.НомерДоговора, """") КАК НомерОснования,
	|	ЕСТЬNULL(АктОРасхождениях.Договор.ДатаДоговора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОснования,
	|	ВЫБОР
	|		КОГДА АктОРасхождениях.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|				ИЛИ АктОРасхождениях.ВалютаДокумента = &ВалютаРегУчета
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ОплатаВВалюте,
	|	ЕСТЬNULL(АктОРасхождениях.Номер, """") КАК Номер,
	|	ЕСТЬNULL(АктОРасхождениях.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК Дата,
	|	АктОРасхождениях.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	АктОРасхождениях.Грузополучатель КАК Грузополучатель,
	|	АктОРасхождениях.Грузоотправитель КАК Грузоотправитель,
	|	АктОРасхождениях.ВалютаДокумента КАК ВалютаДокумента,
	|	АктОРасхождениях.СуммаДокумента КАК СуммаВсего,
	|	АктОРасхождениях.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.АктОРасхождениях КАК АктОРасхождениях
	|ГДЕ
	|	АктОРасхождениях.Ссылка В(&Источники)
	|	И АктОРасхождениях.Проведен";
	
	Запрос.УстановитьПараметр("ВалютаРегУчета", ВалютаРегламентированногоУчета);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВидПредставляемогоДокумента = ВидПредставляемогоДокумента(Выборка.Документ, СозданныеЭлектронныеДокументы, 
																				ДоступныеВидыЭлектронныхДокументов);
		
		ОбъектИсточник = Новый Структура();
		ОбъектИсточник.Вставить("Организация",     Выборка.Организация);
		ОбъектИсточник.Вставить("Направление",     Перечисления.НаправленияДокументаПоТребованиюФНС.Выдан);
		ОбъектИсточник.Вставить("Дата",            Выборка.Дата);
		ОбъектИсточник.Вставить("Номер",           ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Выборка.Номер, Истина, Истина));
		ОбъектИсточник.Вставить("Контрагент",      Выборка.Контрагент);
		
		ОбъектИсточник.Вставить("ВидЭлектронногоДокумента", ВидПредставляемогоДокумента);
		
		ЗаполнитьАктОРасхождениях(Выборка, ОбъектИсточник, СвойстваИсточников, ТолькоОсновныеСвойства);
		
		Если ДокументПередаетсяТолькоВЭлектронномВиде(ВидПредставляемогоДокумента) Тогда
			ЗаполнитьЭлектронныйДокумент(Выборка, ОбъектИсточник, СвойстваИсточников, ВидПредставляемогоДокумента);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

