Процедура ЗаполнитьСведения_РеализацияТоваров(СвойстваИсточников, ТолькоОсновныеСвойства)
	
	ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12");
	
	Источники = МассивИсточников(СвойстваИсточников, ТипДокумента);
	
	Если Источники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СозданныеЭлектронныеДокументы = Новый Соответствие;
	ОбменСКонтрагентами.СвойстваОбъектовУчетаЭлектронныхДокументовДляВыгрузкиВФНС(Источники);
	
	ДоступныеВидыЭлектронныхДокументов = ДоступныеВидыЭлектронныхДокументов(ТипДокумента);
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Запрос = Новый Запрос();
	Запрос.Параметры.Вставить("Источники", Источники);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НакладнаяНаРеализациюТорг12.Ссылка КАК Документ,
	|	НакладнаяНаРеализациюТорг12.Организация КАК Организация,
	|	НакладнаяНаРеализациюТорг12.Контрагент КАК Контрагент,
	|	НакладнаяНаРеализациюТорг12.Организация КАК Продавец,
	|	НакладнаяНаРеализациюТорг12.Контрагент КАК Покупатель,
	|	НакладнаяНаРеализациюТорг12.Договор КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12.Договор.НомерДоговора, """") КАК НомерОснования,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12.Договор.ДатаДоговора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОснования,
	|	ВЫБОР
	|		КОГДА НакладнаяНаРеализациюТорг12.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|				ИЛИ НакладнаяНаРеализациюТорг12.ВалютаДокумента = &ВалютаРегУчета
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ОплатаВВалюте,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12.Номер, """") КАК Номер,
	|	ЕСТЬNULL(НакладнаяНаРеализациюТорг12.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК Дата,
	|	НакладнаяНаРеализациюТорг12.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	НакладнаяНаРеализациюТорг12.Грузополучатель КАК Грузополучатель,
	|	НакладнаяНаРеализациюТорг12.Грузоотправитель КАК Грузоотправитель,
	|	НакладнаяНаРеализациюТорг12.ВалютаДокумента КАК ВалютаДокумента,
	|	НакладнаяНаРеализациюТорг12.СуммаДокумента КАК СуммаВсего,
	|	НакладнаяНаРеализациюТорг12.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12 КАК НакладнаяНаРеализациюТорг12
	|ГДЕ
	|	НакладнаяНаРеализациюТорг12.Ссылка В(&Источники)
	|	И НакладнаяНаРеализациюТорг12.Проведен";
	
	Запрос.УстановитьПараметр("ВалютаРегУчета", ВалютаРегламентированногоУчета);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВидПредставляемогоДокумента = ВидПредставляемогоДокумента(Выборка.Документ, СозданныеЭлектронныеДокументы, 
																				ДоступныеВидыЭлектронныхДокументов);
		
		ОбъектИсточник = Новый Структура();
		ОбъектИсточник.Вставить("Организация",     Выборка.Организация);
		ОбъектИсточник.Вставить("Направление",     Перечисления.НаправленияДокументаПоТребованиюФНС.Выдан);
		ОбъектИсточник.Вставить("Дата",            Выборка.Дата);
		ОбъектИсточник.Вставить("Номер",           ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Выборка.Номер, Истина, Истина));
		ОбъектИсточник.Вставить("Контрагент",      Выборка.Контрагент);
		
		ОбъектИсточник.Вставить("ВидЭлектронногоДокумента", ВидПредставляемогоДокумента);
		
		ЗаполнитьТоварнаяНакладнаяТОРГ12(Выборка, ОбъектИсточник, СвойстваИсточников, ТолькоОсновныеСвойства);
		
		Если ДокументПередаетсяТолькоВЭлектронномВиде(ВидПредставляемогоДокумента) Тогда
			ЗаполнитьЭлектронныйДокумент(Выборка, ОбъектИсточник, СвойстваИсточников, ВидПредставляемогоДокумента);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

