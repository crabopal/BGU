	Если ОписаниеИсточника.Свойство("ВидЭлектронногоДокумента")
		И ЗначениеЗаполнено(ОписаниеИсточника.ВидЭлектронногоДокумента) Тогда
		
		Если Документ.ВидДокументаФНС = ОписаниеИсточника.ВидЭлектронногоДокумента Тогда
			Документ.ЭлектронныйДокумент = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУчастника(Участники, Контрагент, ВидКонтрагента = "", Роль = "")
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		
		СвойстваКонтрагента = Новый Структура();
		СвойстваКонтрагента.Вставить("Роль", Роль);
		
		ЯвляетсяЮрЛицом = Ложь;
		Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.Организации") Тогда
			СвойстваДляПолучения = Новый Структура();
			СвойстваДляПолучения.Вставить("ЮридическоеФизическоеЛицо", "Ссылка");
			СвойстваДляПолучения.Вставить("НаименованиеПолное", "Ссылка.НаименованиеПолное");
			СвойстваДляПолучения.Вставить("ИНН", "Ссылка.ИНН");
			СвойстваДляПолучения.Вставить("КПП", "Ссылка.КПП");
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, СвойстваДляПолучения);
			ЯвляетсяЮрЛицом = Истина;
		ИначеЕсли ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
			Если Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
				СвойстваДляПолучения = Новый Структура();
				СвойстваДляПолучения.Вставить("ЮридическоеФизическоеЛицо", "Ссылка.ЮридическоеФизическоеЛицо");
				СвойстваДляПолучения.Вставить("НаименованиеПолное", "Ссылка.ЮридическоеФизическоеЛицо.Наименование");
				СвойстваДляПолучения.Вставить("НаименованиеСокращенное", "Ссылка.НаименованиеСокращенное");
				СвойстваДляПолучения.Вставить("ИНН", "Ссылка.ИНН");
				СвойстваДляПолучения.Вставить("КПП", "Ссылка.КПП");
				СвойстваДляПолучения.Вставить("ОГРНИП", "Ссылка.ЮридическоеФизическоеЛицо.ОГРНИП");
				Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, СвойстваДляПолучения);
				ФИО = РегламентированнаяОтчетность.РазложитьФИО(Реквизиты.НаименованиеПолное);
				Реквизиты.Вставить("ФизЛицоФамилия",     ФИО.Фамилия);
				Реквизиты.Вставить("ФизЛицоИмя",         ФИО.Имя);
				Реквизиты.Вставить("ФизЛицоОтчество",    ФИО.Отчество);
				
				Если ЗначениеЗаполнено(Реквизиты.ОГРНИП) Тогда
					Реквизиты.НаименованиеПолное = Реквизиты.НаименованиеСокращенное;
				КонецЕсли;	
			Иначе	
				СвойстваДляПолучения = Новый Структура();
				СвойстваДляПолучения.Вставить("ЮридическоеФизическоеЛицо", "Ссылка.ЮридическоеФизическоеЛицо");
				СвойстваДляПолучения.Вставить("НаименованиеПолное", "Ссылка.ЮридическоеФизическоеЛицо.НаименованиеПолное");
				СвойстваДляПолучения.Вставить("ИНН", "Ссылка.ИНН");
				СвойстваДляПолучения.Вставить("КПП", "Ссылка.КПП");
				СвойстваДляПолучения.Вставить("НаименованиеСокращенное", "Ссылка.НаименованиеСокращенное");
				Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, СвойстваДляПолучения);
				ЯвляетсяЮрЛицом = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ЯвляетсяЮрЛицом Тогда
			СвойстваКонтрагента.Вставить("ЮрЛицоНаименование", Реквизиты.НаименованиеПолное);
			СвойстваКонтрагента.Вставить("ЮрЛицоИНН",          Реквизиты.ИНН);
			СвойстваКонтрагента.Вставить("ЮрЛицоКПП",          Реквизиты.КПП);
		Иначе
			СвойстваКонтрагента.Вставить("ФизЛицоФамилия",     Реквизиты.ФизЛицоФамилия);
			СвойстваКонтрагента.Вставить("ФизЛицоИмя",         Реквизиты.ФизЛицоИмя);
			СвойстваКонтрагента.Вставить("ФизЛицоОтчество",    Реквизиты.ФизЛицоОтчество);
			СвойстваКонтрагента.Вставить("ФизЛицоИНН",         Реквизиты.ИНН);
		КонецЕсли;
		
		Если ТипЗнч(Контрагент) = Тип("СправочникОбъект.Контрагенты")
			ИЛИ ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			СвойстваКонтрагента.Вставить("Контрагент", Контрагент);
			
		КонецЕсли;
		
		Участники.Добавить(СвойстваКонтрагента);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУчастникаНаименование(Участники, КонтрагентНаименование, ВидКонтрагента = "", Роль = "")
	//Следует заменить на ДобавитьУчастника, но недостаточно данных о ИНН, КПП и ннаименование
	
	Если ЗначениеЗаполнено(КонтрагентНаименование) Тогда
		
		СвойстваКонтрагента = Новый Структура();
		СвойстваКонтрагента.Вставить("Роль", Роль);
		СвойстваКонтрагента.Вставить("ЮрЛицоНаименование", КонтрагентНаименование);
		СвойстваКонтрагента.Вставить("ЮрЛицоИНН",          "");
		СвойстваКонтрагента.Вставить("ЮрЛицоКПП",          "");
		
		Участники.Добавить(СвойстваКонтрагента);
		
	КонецЕсли;
	
КонецПроцедуры

