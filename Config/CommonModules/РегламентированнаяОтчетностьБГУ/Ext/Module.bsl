		Возврат;
	КонецЕсли;
	
	СозданныеЭлектронныеДокументы = Новый Соответствие;
	ОбменСКонтрагентами.СвойстваОбъектовУчетаЭлектронныхДокументовДляВыгрузкиВФНС(Источники);

	ДоступныеВидыЭлектронныхДокументов = ДоступныеВидыЭлектронныхДокументов(ТипДокумента);
	
	Запрос = Новый Запрос();
	Запрос.Параметры.Вставить("Источники", Источники);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка КАК Документ,
	|	КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.Организация КАК Организация,
	|	КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.Контрагент КАК Контрагент,
	|	КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.Договор КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.Договор КАК Справочник.Договоры).НомерДоговора, """") КАК НомерДоговора,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.Договор КАК Справочник.Договоры).ДатаДоговора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДоговора,
	|	КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.Номер КАК Номер,
	|	КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.Дата КАК Дата,
	|	КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.Подразделение КАК Подразделение,
	|	КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	СУММА(КорректировочныйСчетФактураВыданныйСоставНФА.Всего) КАК СуммаВсего,
	|	СУММА(КорректировочныйСчетФактураВыданныйСоставНФА.СуммаНДС) КАК СуммаНДС,
	|	КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.ПричинаНалогообложения КАК ПричинаНалогообложения,
	|	КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.ДокументОснование.Номер КАК НомерОснования,
	|	КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.ДокументОснование.Дата КАК ДатаОснования
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный.СоставНФА КАК КорректировочныйСчетФактураВыданныйСоставНФА
	|ГДЕ
	|	КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка В(&Источники)
	|	И КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.Проведен = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
