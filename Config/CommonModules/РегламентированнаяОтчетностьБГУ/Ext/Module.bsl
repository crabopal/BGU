// Получает пакет электронных представлений документов.
//
// Параметры
//  МассивЭД - Массив - перечень документов для которых
//                 необходимо получить электронные представления в виде двоичных данных.
//  УникальныйИдентификаторФормы - УникальныйИдентификатор - уникальный идентификатор по которому
//                 осуществляется привязка двоичных данных во временном хранилище.
//
// Возвращаемое значение:
//   Соответствие - сответствие переданных ссылок на документы и массива структур с полями:
//                 ТипФайла - Строка - описание типа файла;
//                 ИмяФайла - Строка - имя файла с расширением;
//                 АдресВременногоХранилища - Строка - адрес временного хранилища, в котором размещены двоичные данные файла.
Функция ПолучитьФайлыВыгрузкиЭД(МассивЭД, УникальныйИдентификаторФормы) Экспорт

	Возврат ОбменСКонтрагентами.ВыгрузкаДокументовДляПередачиВФНС(МассивЭД, УникальныйИдентификаторФормы);
	
КонецФункции

//Функция возвращает свойства договоров для массива документов
//
//Параметры 
//	МассивСсылок -  массив ссылок на документы ИБ, на основании которых в данном прикладном решении 
//  формируется электронный документ вида «Акт приемки-сдачи работ (услуг)»
//
//Возвращаемое значение: 
//	Соответствие со следующими свойствами:
//	-	ключ соответствия - ссылка на выгружаемый документ ИБ, взятая из входящего параметра
//	-	значение соответствия - Структура, с полями:
//		-	НомерДоговора, тип: Строка 
//		-	ДатаДоговора, тип: Дата 
//В случае, если требуемые реквизиты у договора не заполнены или при невозможности получения данных реквизитов, следует помещать пустые значения указанных типов.
Функция ПолучитьНомерДатаДоговораДокументов(МассивСсылок) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.Договор КАК Справочник.Договоры).НомерДоговора КАК НомерДоговора,
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.Договор КАК Справочник.Договоры).ДатаДоговора КАК ДатаДоговора,
	               |	НакладнаяНаРеализациюТорг12.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.НакладнаяНаРеализациюТорг12 КАК НакладнаяНаРеализациюТорг12
	               |ГДЕ
	               |	НакладнаяНаРеализациюТорг12.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(АктОбОказанииУслуг.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(АктОбОказанииУслуг.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	АктОбОказанииУслуг.Ссылка
	               |ИЗ
	               |	Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
	               |ГДЕ
	               |	АктОбОказанииУслуг.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	НакладнаяНаОтпускМ15.Ссылка
	               |ИЗ
	               |	Документ.НакладнаяНаОтпускМ15 КАК НакладнаяНаОтпускМ15
	               |ГДЕ
	               |	НакладнаяНаОтпускМ15.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ЭлектронныйДокументПоставщика.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(ЭлектронныйДокументПоставщика.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ЭлектронныйДокументПоставщика.Ссылка
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика КАК ЭлектронныйДокументПоставщика
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщика.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ПоступлениеУслугРабот.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(ПоступлениеУслугРабот.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ПоступлениеУслугРабот.Ссылка
	               |ИЗ
	               |	Документ.ПоступлениеУслугРабот КАК ПоступлениеУслугРабот
	               |ГДЕ
	               |	ПоступлениеУслугРабот.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ПоступлениеОС.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(ПоступлениеОС.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ПоступлениеОС.Ссылка
	               |ИЗ
	               |	Документ.ПоступлениеОС КАК ПоступлениеОС
	               |ГДЕ
	               |	ПоступлениеОС.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ПоступлениеМЗ.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(ПоступлениеМЗ.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ПоступлениеМЗ.Ссылка
	               |ИЗ
	               |	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	               |ГДЕ
	               |	ПоступлениеМЗ.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ГТДИмпорт.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(ГТДИмпорт.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ГТДИмпорт.Ссылка
	               |ИЗ
	               |	Документ.ГТДИмпорт КАК ГТДИмпорт
	               |ГДЕ
	               |	ГТДИмпорт.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(СчетФактураВыданный.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(СчетФактураВыданный.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	СчетФактураВыданный.Ссылка
	               |ИЗ
	               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	               |ГДЕ
	               |	СчетФактураВыданный.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(СчетФактураПолученный.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(СчетФактураПолученный.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	СчетФактураПолученный.Ссылка
	               |ИЗ
	               |	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	               |ГДЕ
	               |	СчетФактураПолученный.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ИсправительныйСчетФактураПолученный.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(ИсправительныйСчетФактураПолученный.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ИсправительныйСчетФактураПолученный.Ссылка
	               |ИЗ
	               |	Документ.ИсправительныйСчетФактураПолученный КАК ИсправительныйСчетФактураПолученный
	               |ГДЕ
	               |	ИсправительныйСчетФактураПолученный.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ИсправительныйСчетФактураВыданный.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(ИсправительныйСчетФактураВыданный.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ИсправительныйСчетФактураВыданный.Ссылка
	               |ИЗ
	               |	Документ.ИсправительныйСчетФактураВыданный КАК ИсправительныйСчетФактураВыданный
	               |ГДЕ
	               |	ИсправительныйСчетФактураВыданный.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(КорректировочныйСчетФактураПолученный.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(КорректировочныйСчетФактураПолученный.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	КорректировочныйСчетФактураПолученный.Ссылка
	               |ИЗ
	               |	Документ.КорректировочныйСчетФактураПолученный КАК КорректировочныйСчетФактураПолученный
	               |ГДЕ
	               |	КорректировочныйСчетФактураПолученный.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ЭлектронныйДокументПоставщика.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(ЭлектронныйДокументПоставщика.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ЭлектронныйДокументПоставщика.Ссылка
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика КАК ЭлектронныйДокументПоставщика
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщика.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускИК.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускИК.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	НакладнаяНаОтпускИК.Ссылка
	               |ИЗ
	               |	Документ.НакладнаяНаОтпускИК КАК НакладнаяНаОтпускИК
	               |ГДЕ
	               |	НакладнаяНаОтпускИК.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(КорректировочныйСчетФактураВыданный.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(КорректировочныйСчетФактураВыданный.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	КорректировочныйСчетФактураВыданный.Ссылка
	               |ИЗ
	               |	Документ.КорректировочныйСчетФактураВыданный КАК КорректировочныйСчетФактураВыданный
	               |ГДЕ
	               |	КорректировочныйСчетФактураВыданный.Ссылка В(&МассивСсылок)";
	
	Запрос.УстановитьПараметр("МассивСсылок",МассивСсылок); 
	
	Соответствие = Новый Соответствие;
	Для Каждого Ссылка Из МассивСсылок Цикл
		
		Соответствие.Вставить(Ссылка,Новый Структура("НомерДоговора, ДатаДоговора","",'00010101'));
		
	КонецЦикла;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Соответствие.Вставить(Выборка.Ссылка, Новый Структура("НомерДоговора, ДатаДоговора",Выборка.НомерДоговора,Выборка.ДатаДоговора));
		
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

