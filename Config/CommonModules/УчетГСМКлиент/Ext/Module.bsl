Процедура ТаксировкаНажатие(Таксировка, Форма, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка = Ложь;
	ДокументОснование = Форма["Объект"].Ссылка;
	
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Форма.Параметры.Ключ) ИЛИ Форма.Модифицированность Тогда
		ОбъектЗаписан = Форма.Записать();
		
		Если НЕ ОбъектЗаписан Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;		
	
	Если ЗначениеЗаполнено(Таксировка) Тогда
		Параметры = Новый Структура("Ключ", Таксировка);
	Иначе
		Если Форма.Объект.ПометкаУдаления Тогда
			ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Таксировку нельзя вводить на основании документа, помеченного на удаление.'"));
			Возврат;
		КонецЕсли;
		
		Параметры = Новый Структура("Основание", Форма.Параметры.Ключ);
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист3") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист4П") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист4С") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист6спец") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛистЭСМ2") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист3спец") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист6") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист412АПК") Тогда
	    ВидТаксировки = "ТаксировкаПутевогоЛиста";
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РабочийЛистАгрегата") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.УчетныйЛистТрактористаМашиниста") Тогда
	    ВидТаксировки = "ТаксировкаРабочегоЛистаАгрегата";
	КонецЕсли;	
	
	ФормаТаксировки = ОткрытьФорму("Документ."+ВидТаксировки+".ФормаОбъекта", Параметры, Форма);
	
КонецПроцедуры	

Функция ПодготовитьСтрокуАдреса(СтрокаАдреса) Экспорт
	ВырезатьС = Найти(СтрокаАдреса, "адрес: ");
	ВырезатьС = ?(ВырезатьС>0, ВырезатьС+6, 0);
	Результат = Сред(СтрокаАдреса, ВырезатьС+1);
	
	Возврат Результат;
КонецФункции

Функция СписокВидыПеревозок() Экспорт
	Результат = Новый СписокЗначений;
													
	Результат.Добавить(НСтр("ru='перевозки для собственных нужд'"));
	Результат.Добавить(НСтр("ru='передвижение и работа специальных транспортных средств'"));
	Результат.Добавить(НСтр("ru='коммерческие перевозки: регулярная перевозка пассажиров и багажа'"));
	Результат.Добавить(НСтр("ru='коммерческие перевозки: перевозка пассажиров и багажа легковым такси'"));
	Результат.Добавить(НСтр("ru='коммерческие перевозки: перевозка грузов на основании договора'"));
	Результат.Добавить(НСтр("ru='коммерческие перевозки: перевозка пассажиров и багажа по заказу'"));
	Результат.Добавить(НСтр("ru='коммерческие перевозки: организованная перевозка групп детей автобусами'"));

	Возврат Результат;
КонецФункции	
	
