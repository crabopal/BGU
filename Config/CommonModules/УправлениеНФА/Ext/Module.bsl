
#Область ПрограммныйИнтерфейс

// Проверить использование имущества казны в информационной базе.
// Если функциональная опция "ВестиУчетИмуществаКазны" не включена,
// то вызывается исключение.
Процедура ПроверитьУчетИмуществаКазны() Экспорт

	Если Не ПолучитьФункциональнуюОпцию("ВестиУчетИмуществаКазны") Тогда
		ВызватьИсключение НСтр("ru='Ведение учета имущества казны отключено в настройках параметров учета'");
	КонецЕсли;

КонецПроцедуры

// Заполняет в таблице реквизит ПринятьНДСКВычету из реквизита объекта.
//
// Параметры:
//  Объект			 - ДанныеФормыСтруктура:
//   * ПринятьНДСКВычету - Булево
//  ТабличнаяЧасть	 - ДанныеФормыКоллекция:
//   * ПринятьНДСКВычету - Булево
//   * СпособУчетаНДС - ПеречислениеСсылка.СпособыУчетаНДС
//
Процедура УстановитьПринятьНДСКВычетуВСтроках(Объект, ТабличнаяЧасть) Экспорт

	Для каждого Строка Из ТабличнаяЧасть Цикл
		Строка.ПринятьНДСКВычету = Объект.ПринятьНДСКВычету;
		Строка.СпособУчетаНДС = УправлениеНФАКлиентСервер.ЗначениеСпособУчетаНДС(Строка.ПринятьНДСКВычету, Строка.НДСКРаспределению);
	КонецЦикла;

КонецПроцедуры

// Проверяет заполнение колонки СпособУчетаНДС. Если есть не заполненные, устанавливает Отказ = Истина
//
// Параметры:
//  Объект				 - ДанныеФормыСтруктура:
//   * ПринятьНДСКВычетуУказываетсяВСтроках - Булево
//  ИмяТабличнойЧасти	 - Строка
//  Отказ				 - Булево
//
Процедура ПроверитьЗаполнение(Объект, ИмяТабличнойЧасти, Отказ) Экспорт

	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ПринятьНДСКВычетуУказываетсяВСтроках")
		Или Не Объект.ПринятьНДСКВычетуУказываетсяВСтроках Тогда
		Возврат;
	КонецЕсли;
	
	ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
	СтрокиСОшибками = Новый Массив;
	Для каждого Строка Из ТабличнаяЧасть Цикл
		Если Не ЗначениеЗаполнено(Строка.СпособУчетаНДС) Тогда
			СтрокиСОшибками.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокиСОшибками.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеДокумента = Объект.Ссылка.Метаданные();
	МетаданныеТЧ = МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
	ИмяТЧ = МетаданныеТЧ.Синоним;
	
	ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", НСтр("ru = 'Способ учета НДС'"), "НомерСтроки", ИмяТЧ);
	Для каждого Строка Из СтрокиСОшибками Цикл
	
		ИндексСтроки = ТабличнаяЧасть.Индекс(Строка);
		ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, ИндексСтроки + 1, "СпособУчетаНДС");
		ОбщегоНазначения.СообщитьПользователю(СтрЗаменить(ТекстОшибки, "НомерСтроки", ИндексСтроки + 1), , ПутьКПолю, "Объект", Отказ);
	
	КонецЦикла;

КонецПроцедуры

// Заполняет свойства реквизитов табличной части документа
//
// СтруктураРеквизитов - Структура - ключем является имя реквизита. Значение - это структура. В значение будут добавлены свойства реквизитов
// ИмяДокумента - Строка - имя документа, как заданов в конфигураторе
// ИмяТЧ - Строка - имя табличной части
Процедура ЗаполнитьСвойстваРеквизитов(СтруктураРеквизитов, ИмяДокумента, ИмяТЧ) Экспорт 
	Реквизиты = Метаданные.Документы.Найти(ИмяДокумента).ТабличныеЧасти[ИмяТЧ].Реквизиты;
	Для каждого ТекЭлемент из СтруктураРеквизитов Цикл
		Если ТекЭлемент.Значение.Свойство("ТипыДляВыбора") И ЗначениеЗаполнено(ТекЭлемент.Значение.ТипыДляВыбора) Тогда
			ТекЭлемент.Значение.Вставить("ОписаниеТипов", ТекЭлемент.Значение.ТипыДляВыбора);
			ТекЭлемент.Значение.Вставить("Синоним", ТекЭлемент.Значение.СинонимДляВыбора);
		Иначе	
			ТекЭлемент.Значение.Вставить("ОписаниеТипов", Реквизиты[ТекЭлемент.Ключ].Тип);
			Если ТекЭлемент.Значение.Свойство("СинонимДляВыбора") 
				И ЗначениеЗаполнено(ТекЭлемент.Значение.СинонимДляВыбора) Тогда
				ТекЭлемент.Значение.Вставить("Синоним", ТекЭлемент.Значение.СинонимДляВыбора);
			Иначе		
				ТекЭлемент.Значение.Вставить("Синоним", Реквизиты[ТекЭлемент.Ключ].Синоним);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	 
КонецПроцедуры	

// Обеспечение сотрудника имуществом. Если не задано или у единственного элемента установлена пометка удаления,
// возвращается пустая ссылка.
// 
// Параметры:
//  Сотрудник - СправочникСсылка.Сотрудники
// 
// Возвращаемое значение:
//  СправочникСсылка.ОбеспечениеСотрудниковИмуществом - Обеспечение сотрудника имуществом
Функция ОбеспечениеСотрудникаИмуществом(Сотрудник) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбеспечениеСотрудниковИмуществом.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОбеспечениеСотрудниковИмуществом КАК ОбеспечениеСотрудниковИмуществом
	|ГДЕ
	|	ОбеспечениеСотрудниковИмуществом.Владелец = &Сотрудник
	|	И НЕ ОбеспечениеСотрудниковИмуществом.ПометкаУдаления";
	Запрос.УстановитьПараметр("Сотрудник",Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.ОбеспечениеСотрудниковИмуществом.ПустаяСсылка();
	КонецЕсли;
КонецФункции

// Состав обеспечения сотрудника имуществом.
// 
// Параметры:
//  Обеспечение - СправочникСсылка.ОбеспечениеСотрудниковИмуществом
// 
// Возвращаемое значение:
//  см. ТаблицаСоставаОбеспеченияСотрудникаИмуществом
Функция СоставОбеспеченияСотрудникаИмуществом(Обеспечение) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом.Имущество,
	|	ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом.НормаВыдачи,
	|	ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом.СрокИспользованияПоНормативу,
	|	ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом.КодУсловияВозвратаИмущества,
	|	ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом.ЕдиницаИзмеренияСрока,
	|	ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом.Приспособления,
	|	ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом.РазмерОдежды,
	|	ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом.РазмерГоловногоУбора,
	|	ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом.РазмерОбуви,
	|	ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом.РазмерИное
	|ИЗ
	|	Справочник.ОбеспечениеСотрудниковИмуществом.ОбеспечениеИмуществом КАК
	|		ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом
	|ГДЕ
	|	ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОбеспечениеСотрудниковИмуществомОбеспечениеИмуществом.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Обеспечение);
	
	Результат = ТаблицаСоставаОбеспеченияСотрудникаИмуществом();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
 
// Очистить реквизиты корректировки.
// 
// Параметры:
//  Объект - ДокументОбъект:
//   * ЭтоКорректировка - Булево
//   * НомерКорректировки - Число
//   * ДокументОснование - ДокументСсылка
//  ОчищаемыеТабличныеДанные - Структура - Очищаемые колонки таблиц объекта:
//   * Ключ - Строка - Имя табличной части
//   * Значение - Массив из Строка - имена очищаемых колонок
Процедура ОчиститьРеквизитыКорректировки(Объект, ОчищаемыеТабличныеДанные) Экспорт

	Объект.ЭтоКорректировка = Ложь;
	Объект.НомерКорректировки = 0;
	Объект.ДокументОснование = Неопределено;
	
	Для Каждого ОчищаемаяТЧ Из ОчищаемыеТабличныеДанные Цикл
		ОчиститьРеквизитыСтрокОбъекта(Объект, ОчищаемаяТЧ.Ключ, ОчищаемаяТЧ.Значение);
	КонецЦикла;

КонецПроцедуры

// Заполняет данные о файлах входящего электронного акта.
//
// Параметры:
//  Объект				 - ДанныеФормыСтруктура:
//  ФайлыВходящегоАкта	 - ДанныеФормыКоллекция - список файлов формы документа учета
//
Процедура ЗаполнитьСписокФайловВходящегоАктаПриемаПередачи(Объект, ФайлыВходящегоАкта) Экспорт
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
			ФайлыПриложенийАкта = ЭлектронныеДокументыБГУ.СписокФайловВходящегоАктаПриемаПередачи(Объект.ДокументОснование);	
			
			ФайлыВходящегоАкта.Загрузить(ФайлыПриложенийАкта);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Возвращает имя вида документа по Виду отклонения и Виду объекта для
// целей ввода учетных документов по данным инвентаризационной описи НФА 0510466
//
// Параметры:
//  ВидОтклонения - ПеречислениеСсылка.ВидыОтклоненийВИнвентаризацииНФА
//  ВидОбъекта - Число(1) - вид объекта. Возможные значения
//   * 1 – ОС;
//   * 2 – ОС (кроме транспорта);
//   * 3 – ОС (транспорт);
//   * 4 – ОС (библиотечный фонд);
//   * 5 – ОС ИК;
//   * 6 – ОС ИК (кроме транспорта);
//   * 7 – ОС ИК (транспорт);
//   * 8 – МЗ;
//   * 9 – МЗ ИК
//   * 11 - БСО
//   * 12 - Денежные документы
//
// Возвращаемое значение:
//  - Строка - имя вида документа
Функция ИмяДокументаПоВидуОтклоненияИОбъекта(ВидОтклонения, ВидОбъекта) Экспорт
	ИмяДокумента = "";     
	ПредставлениеДокумента = "";
	Если ВидОтклонения = Перечисления.ВидыОтклоненийВИнвентаризацииНФА.НеАктивы Тогда
		Если ВидОбъекта = 1 Тогда // ВидОбъекта - ОС
			ИмяДокумента = "РешениеОПрекращенииПризнанияАктивом";
		ИначеЕсли ВидОбъекта = 5 Тогда // ВидОбъекта - ИК ОС
			ИмяДокумента = "РешениеОПрекращенииПризнанияАктивомИК";
		ИначеЕсли ВидОбъекта = 8 Тогда // ВидОбъекта - МЗ
			ИмяДокумента = "РешениеОПрекращенииПризнанияАктивомМЗ";
		ИначеЕсли ВидОбъекта = 9 Тогда // ВидОбъекта - МЗ ИК
			ИмяДокумента = "РешениеОПрекращенииПризнанияАктивомМЗИК";
		КонецЕсли;      
	ИначеЕсли ВидОтклонения = Перечисления.ВидыОтклоненийВИнвентаризацииНФА.Излишки Тогда
		Если ВидОбъекта = 1 Тогда // ВидОбъекта - ОС
			ИмяДокумента = "ПринятиеКУчетуОбъектовОС";
		ИначеЕсли ВидОбъекта = 5 Тогда // ВидОбъекта - ИК ОС
			ИмяДокумента = "ПринятиеКУчетуОбъектовИК";
		ИначеЕсли ВидОбъекта = 8 Тогда // ВидОбъекта - МЗ
			ИмяДокумента = "ПоступлениеМЗ";
		ИначеЕсли ВидОбъекта = 9 Тогда // ВидОбъекта - МЗ ИК
			ИмяДокумента = "ПоступлениеИК";
		ИначеЕсли ВидОбъекта = 11 Тогда // ВидОбъекта - БСО
			ИмяДокумента = "ПоступлениеБСО";
		ИначеЕсли ВидОбъекта = 12 Тогда // ВидОбъекта - ДенежныеДокументы
			ИмяДокумента = "ПриходныйОрдерФондовый";
		КонецЕсли;      
	ИначеЕсли ВидОтклонения = Перечисления.ВидыОтклоненийВИнвентаризацииНФА.Недостача Тогда
		Если ВидОбъекта = 2 Тогда // ВидОбъекта - ОС (кроме транспорта)
			ИмяДокумента = "СписаниеОбъектовОС";
		ИначеЕсли ВидОбъекта = 3 Тогда // ВидОбъекта - ОС (транспорт)
			ИмяДокумента = "СписаниеТранспорта";
		ИначеЕсли ВидОбъекта = 4 Тогда // ВидОбъекта - ОС (библиотечный фонд)
			ИмяДокумента = "СписаниеЛитературы";
		ИначеЕсли ВидОбъекта = 6 Тогда // ВидОбъекта - ИК ОС (кроме транспорта)
			ИмяДокумента = "СписаниеОбъектовИК";
		ИначеЕсли ВидОбъекта = 7 Тогда // ВидОбъекта - ИК ОС (транспорт)
			ИмяДокумента = "СписаниеТранспортаИК";
		ИначеЕсли ВидОбъекта = 8 Тогда // ВидОбъекта - МЗ
			ИмяДокумента = "АктСписанияМЗ";
		ИначеЕсли ВидОбъекта = 9 Тогда // ВидОбъекта - МЗ ИК
			ИмяДокумента = "АктСписанияИК";
		ИначеЕсли ВидОбъекта = 11 Тогда // ВидОбъекта - БСО
			ИмяДокумента = "СписаниеБСО";
		ИначеЕсли ВидОбъекта = 12 Тогда // ВидОбъекта - ДенежныеДокументы
			ИмяДокумента = "РасходныйОрдерФондовый";
		КонецЕсли;      
	ИначеЕсли ВидОтклонения = Перечисления.ВидыОтклоненийВИнвентаризацииНФА.Обесценение Тогда
		Если ВидОбъекта = 1 Тогда // ВидОбъекта - ОС
			ИмяДокумента = "ОбесценениеОС";
		КонецЕсли;	
	ИначеЕсли ВидОтклонения = Перечисления.ВидыОтклоненийВИнвентаризацииНФА.ИзменениеСтоимости Тогда
		Если ВидОбъекта = 1 Тогда // ВидОбъекта - ОС
			ИмяДокумента = "ПереоценкаОС";
		КонецЕсли;	
	КонецЕсли;	

	ПредставлениеДокумента = Метаданные.Документы[ИмяДокумента].Представление();
	
	Возврат(Новый Структура("ИмяДокумента, ПредставлениеДокумента", ИмяДокумента, ПредставлениеДокумента));
КонецФункции	

// Формирует текст запроса по учетным документам для заполнения уже введенных отклонений по инвентаризационным описям.
// 
// Параметры:
//  ИменаУчетныхДокументов - Массив из Строка
// 
// Возвращаемое значение:
//  Строка - Текст запроса учетные документы ввод отклонений по инвентаризации
Функция ТекстЗапросаУчетныеДокументыВводОтклоненийПоИнвентаризации(ИменаУчетныхДокументов) Экспорт
	ЧастиЗапроса = Новый Массив;
	Для Каждого ИмяДокумента Из ИменаУчетныхДокументов Цикл
		Попытка
			ТекстЗапросаДокумента = Документы[ИмяДокумента].ТекстЗапроса_НФАОтработанныеПоИнвентаризации();
			ЧастиЗапроса.Добавить(ТекстЗапросаДокумента);
		Исключение                  
			Продолжить;
		КонецПопытки;	
	КонецЦикла;
	ТекстЗапроса = СтрСоединить(ЧастиЗапроса, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ"));
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	СхемаЗапроса.ПакетЗапросов[0].ТаблицаДляПомещения = "НФАУчетныхДокументов1";
	ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	Возврат ТекстЗапроса;
	
КонецФункции

// Добавляет в переданный запрос параметры для отбора учетного документа, в котором выполняется заполнение
// по инвентаризационной описи.
// 
// Параметры:
//  Запрос - Запрос
//  ИменаУчетныхДокументов - Массив из Строка
//  Ссылка - ДокументСсылка
Процедура ДобавитьВПараметрыЗапросаИнвентаризацииУчетныеДокументы(Запрос, ИменаУчетныхДокументов, Ссылка) Экспорт
	ИмяПараметраУчетныйДокумент = "";
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ИмяПараметраУчетныйДокумент = Ссылка.Метаданные().Имя + "Ссылка";
	КонецЕсли;
	Для Каждого ИмяДокумента Из ИменаУчетныхДокументов Цикл
		ИмяПараметра = ИмяДокумента + "Ссылка";
		Если ИмяПараметра = ИмяПараметраУчетныйДокумент Тогда
			Запрос.УстановитьПараметр(ИмяПараметра, Ссылка);
		Иначе
			Запрос.УстановитьПараметр(ИмяПараметра, Документы[ИмяДокумента].ПустаяСсылка());
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Удаляет из переданного текста запроса поле по заданному псевдониму.
// Если в запросе используется объединение, то поле удаляется из всех объединяемых запросов.
// Если поле по псевдониму не найдено, то возвращается исходный текст запроса.
//
// Параметры:
//  ТекстЗапроса	 - Строка - 
//  ПсевдонимПоля	 - Строка - 
// 
// Возвращаемое значение:
// Строка - 
//
Функция УдалитьПолеИзТекстЗапроса(Знач ТекстЗапроса, ПсевдонимПоля) Экспорт
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	ПервыйЗапрос = СхемаЗапроса.ПакетЗапросов[0];
	Колонки = ПервыйЗапрос.Колонки;
	ИскомоеПоле = Колонки.Найти(ПсевдонимПоля);
	Если ИскомоеПоле <> Неопределено Тогда
		Колонки.Удалить(Колонки.Индекс(ИскомоеПоле));
		ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	КонецЕсли;
	Возврат ТекстЗапроса;
КонецФункции

#Область ГолосованиеКомиссии

// Установить условное оформление решения члена комиссии.
// 
// Параметры:
//  УсловноеОформление - УсловноеОформлениеКомпоновкиДанных
//  ИмяТЧ - Строка
//  ИмяРеквизита - Строка - Имя реквизита
Процедура УстановитьУсловноеОформлениеРешенияЧленаКомиссии(УсловноеОформление, ИмяТЧ, ИмяРеквизита = "РешениеСотрудникаПоРезолюции") Экспорт
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяТЧ + ИмяРеквизита);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТЧ + "." + ИмяРеквизита, ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.За);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаПоложительногоВыполненияЗадачи);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяТЧ + ИмяРеквизита);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект." + ИмяТЧ + "." + ИмяРеквизита, ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.Против);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаОтрицательногоВыполненияЗадачи);
	
КонецПроцедуры

// Получить файл сотрудника параметры.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ОбъектСФайлами - ДокументСсылка
// 
// Возвращаемое значение:
//  Структура - Получить файл сотрудника параметры:
// * Форма - ФормаКлиентскогоПриложения, Неопределено - 
// * ОбъектСФайлами - ДокументСсылка, Неопределено - 
// * ПолеФайла - Строка - 
// * ПолеНадписи - Строка - 
// * ПолеУдалить - Строка - 
// * ЭлементПолеФайла - Строка - 
Функция ФайлСотрудника_Параметры(Форма = Неопределено, ОбъектСФайлами = Неопределено) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Форма", Форма);
	Результат.Вставить("ОбъектСФайлами", ОбъектСФайлами);
	Результат.Вставить("ПолеФайла", "ФайлСотрудника");
	Результат.Вставить("ПолеНадписи", "НадписьФайлНеВыбран");
	Результат.Вставить("ПолеУдалить", "НадписьУдалитьФайл");
	Результат.Вставить("ЭлементПолеФайла", "");
	Возврат Результат;
КонецФункции

// Обертка над вызовом "РаботаСФайламиБГУ.ПолучитьФайлСотрудника".
// Дополнительно умеет изменять видимость элемента формы, содержащего ФайлСотрудника, когда на форме есть 2 реквизита,
// отображающих ФайлСотрудника.
// 
// Параметры:
//  Сотрудник - СправочникСсылка.Сотрудники
//  Параметры - см. ФайлСотрудника_Параметры
// 
// Возвращаемое значение:
//  Неопределено - Получить файл сотрудника
Функция ПолучитьФайлСотрудника(Сотрудник, Параметры) Экспорт
	
	ФайлСотрудника = РаботаСФайламиБГУ.ПолучитьФайлСотрудника(Сотрудник,
		Параметры.Форма,
		Параметры.ОбъектСФайлами,
		Параметры.ПолеФайла,
		Параметры.ПолеНадписи,
		Параметры.ПолеУдалить);

	Если ЗначениеЗаполнено(Параметры.ЭлементПолеФайла) И Параметры.Форма <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Параметры.Форма.Элементы,
			Параметры.ЭлементПолеФайла, "Видимость", ЗначениеЗаполнено(Параметры.Форма[Параметры.ПолеФайла]));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Параметры.Форма.Элементы,
			Параметры.ПолеФайла, "Видимость", Ложь);
	КонецЕсли;
		
	Возврат ФайлСотрудника;
	
КонецФункции

// Обертка над вызовом "РаботаСФайламиБГУ.ОбработатьВыборФайлаСотрудника".
// Дополнительно умеет изменять видимость элемента формы, содержащего ФайлСотрудника, когда на форме есть 2 реквизита,
// отображающих ФайлСотрудника.
// 
// Параметры:
//  ЗначениеВыбора - ОпределяемыйТип.ПрисоединенныйФайл
//  Сотрудник - СправочникСсылка.Сотрудники
//  Параметры - см. ФайлСотрудника_Параметры
Процедура ОбработатьВыборФайлаСотрудника(ЗначениеВыбора, Сотрудник, Параметры) Экспорт

	РаботаСФайламиБГУ.ОбработатьВыборФайлаСотрудника(ЗначениеВыбора, Сотрудник,
		Параметры.Форма,
		Параметры.ПолеФайла,
		Параметры.ПолеНадписи,
		Параметры.ПолеУдалить);

	Если ЗначениеЗаполнено(Параметры.ЭлементПолеФайла) И Параметры.Форма <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Параметры.Форма.Элементы,
			Параметры.ЭлементПолеФайла, "Видимость", ЗначениеЗаполнено(Параметры.Форма[Параметры.ПолеФайла]));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Параметры.Форма.Элементы,
			Параметры.ПолеФайла, "Видимость", Ложь);
	КонецЕсли;

КонецПроцедуры

// Обертка над вызовом "РаботаСФайламиБГУ.ОткрепитьФайлСотрудника".
// Дополнительно умеет изменять видимость элемента формы, содержащего ФайлСотрудника, когда на форме есть 2 реквизита,
// отображающих ФайлСотрудника.
// 
// Параметры:
//  ФайлСотрудника - ОпределяемыйТип.ПрисоединенныйФайл
//  Сотрудник - СправочникСсылка.Сотрудники
//  Параметры - см. ФайлСотрудника_Параметры
Процедура ОткрепитьФайлСотрудника(ФайлСотрудника, Сотрудник, Параметры) Экспорт

	РаботаСФайламиБГУ.ОткрепитьФайлСотрудника(ФайлСотрудника, Сотрудник,
		Параметры.Форма,
		Параметры.ПолеФайла,
		Параметры.ПолеНадписи,
		Параметры.ПолеУдалить);

	Если ЗначениеЗаполнено(Параметры.ЭлементПолеФайла) И Параметры.Форма <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Параметры.Форма.Элементы,
			Параметры.ЭлементПолеФайла, "Видимость", ЗначениеЗаполнено(Параметры.Форма[Параметры.ПолеФайла]));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Параметры.Форма.Элементы,
			Параметры.ПолеФайла, "Видимость", Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область АктПриемкиТРУ

// Установить связи параметров выбора элемента, в котором выбрается 
// значение из справочника "Ответственные лица контрагентов".
// 
// Параметры:
//  Элемент - ПолеФормы
//  ОписаниеСвязей - Массив из Структура:
//   * Имя - Строка
//   * ПутьКДанным - Строка
//   * Очищать - Булево
Процедура УстановитьСвязиПараметровВыбораЭлементаОтветственногоЛица(Элемент, ОписаниеСвязей) Экспорт
	
	СвязиПараметровВыбора = Новый Массив;
	Для Каждого Описание Из ОписаниеСвязей Цикл
		РежимИзменения = ?(Описание.Очищать,
			РежимИзмененияСвязанногоЗначения.Очищать,
			РежимИзмененияСвязанногоЗначения.НеИзменять);
		СвязиПараметровВыбора.Добавить(
			Новый СвязьПараметраВыбора(Описание.Имя, Описание.ПутьКДанным, РежимИзменения));
	КонецЦикла;
	
	Элемент.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиПараметровВыбора);
	
КонецПроцедуры

// Установить связи параметров выбора всех элементов ответственных лиц.
// Если есть реквизит Объект, то вторым параметром передается он. В этом случае связь параметров выбора
// устанавливается с реквизитом объекта.
// Если реквизита нет, то вторым параметром передается форма и связь параметров выбора
// устанавливается с реквизитом формы.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Объект - ФормаКлиентскогоПриложения, ДанныеФормыСтруктура -
Процедура УстановитьСвязиПараметровВыбораВсехЭлементовОтветственныхЛиц(Форма, Объект) Экспорт
	
	РеквизитОбъект = ?(ТипЗнч(Объект) = Тип("ФормаКлиентскогоПриложения"), "", "Объект");
	ТипОтветственноеЛицо = Тип("СправочникСсылка.ОтветственныеЛицаКонтрагентов");
	Элементы = Форма.Элементы;
	
	ОписанияЭлементов = УправлениеНФАКлиентСервер.ИменаРеквизитовОтветственныхЛицКонтрагентовАктПриемкиТРУ();
	Для Каждого Описание Из ОписанияЭлементов Цикл
		Если Форма.Элементы.Найти(Описание.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВременнаяСтруктура = Новый Структура(Описание.Ключ, "---");
		ЗаполнитьЗначенияСвойств(ВременнаяСтруктура, Объект);
		Если ТипЗнч(ВременнаяСтруктура[Описание.Ключ]) <> ТипОтветственноеЛицо Тогда
			Продолжить; 
		КонецЕсли;
		
		ИмяЭлементаВладельца = УправлениеНФАКлиентСервер.ИмяЭлементаВладелецОтветственногоЛица(Описание.Ключ);
		ОжидаемыеСвязиПараметровВыбора = УправлениеНФАКлиентСервер
			.СвязиПараметровВыбораДляФормыВыбораЗначенияФИОКонтактногоЛицаАктПриемкиТРУ(
				"Организация",
				ИмяЭлементаВладельца,
				РеквизитОбъект,
				ТипОтветственноеЛицо);
		УстановитьСвязиПараметровВыбораЭлементаОтветственногоЛица(Элементы[Описание.Ключ],
			ОжидаемыеСвязиПараметровВыбора);				
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПоступлениеНФАНаОснованииАктаПриемкиТРУ

// Обработка поступления НФА на основании акта приемки ТРУ при создании на сервере
// Объединяет проверку незаполненных строк и поиск акта приемки
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа
//  Объект - ДанныеФормыСтруктура - объект формы:
//   * Ссылка - ДокументСсылка
Процедура ПриСозданииНаСервереПоступленияНФАНаОснованииАктПриемкиТРУ(Форма, Объект) Экспорт
	Параметры = Форма.Параметры;
	// Проверка при создании на основании акта приемки
	Если Параметры.Ключ.Пустая() Тогда
		Если ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.АктПриемкиТоваровРаботУслуг") Тогда
			// Установка ссылки на акт приемки
			Форма.АктПриемкиТоваровРаботУслугСсылка = Параметры.Основание;
			Форма.НадписьАктПриемкиТоваровРаботУслуг = Строка(Параметры.Основание);
		КонецЕсли; 
	Иначе
		// Поиск акта приемки ТРУ по документу поступления
		ДанныеАктаПриемкиТРУ = Документы.АктПриемкиТоваровРаботУслуг.НайтиПоДокументуПоступления(Объект.Ссылка, Истина);
		АктПриемкиСсылка = ДанныеАктаПриемкиТРУ.АктПриемкиТРУ;
		Если ЗначениеЗаполнено(АктПриемкиСсылка) Тогда
			Форма.АктПриемкиТоваровРаботУслугСсылка = АктПриемкиСсылка;
			Форма.НадписьАктПриемкиТоваровРаботУслуг = Строка(АктПриемкиСсылка);
			Если Не ДанныеАктаПриемкиТРУ.Добавлен Тогда
				Форма.Элементы.ГруппаАктПриемкиТоваровРаботУслуг.ЦветФона = ЦветаСтиля.ЦветФонаОтрицательногоЗначения;
				ТекстОшибки = НСтр("ru = 'Текущий документ введен на основании ""Акта приемки товаров, работ, услуг"",
					|но не указан в таблице ""Документы поставки"".
					|Откройте ""Акт приемки товаров, работ, услуг"" и обновите таблицу ""Документы поставки"" по введенным документам.'");
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, АктПриемкиСсылка, , , );
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Проверка заполнения документа, если первичный документ - акт приемки ТРУ
//
// Параметры:
//  Объект - ДокументОбъект - документ объекта
//  РежимЗаписи - РежимЗаписиДокумента - режим записи документа
Процедура ПроверитьЗаполнениеДокументаЕслиПервичныйДокументАктПриемкиТРУ(Объект, РежимЗаписи) Экспорт
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ПервичныйДокумент <> ПервичныеДокументыБГУ.ПервичныйДокументАктПриемкиТРУ() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|    АктПриемкиТоваровРаботУслуг.Ссылка КАК Ссылка
	|ИЗ
	|    Документ.АктПриемкиТоваровРаботУслуг.ДокументыПоступления КАК АктПриемкиТоваровРаботУслугДокументыПоступления
	|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктПриемкиТоваровРаботУслуг КАК АктПриемкиТоваровРаботУслуг
	|        ПО АктПриемкиТоваровРаботУслугДокументыПоступления.Ссылка = АктПриемкиТоваровРаботУслуг.Ссылка
	|ГДЕ
	|    АктПриемкиТоваровРаботУслугДокументыПоступления.ДокументОснование = &ДокументОснование
	|    И АктПриемкиТоваровРаботУслуг.ВидПоставки = &ВидПоставки";
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
	Запрос.УстановитьПараметр("ВидПоставки", Перечисления.ВидыПоставкиТоваровРаботУслуг.НеотфактурованнаяПоставка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначения.СообщитьПользователю("В Акте приемки указана неотфактурованная поставка", Выборка.Ссылка);
	КонецЦикла;
	ВызватьИсключение "Первичный документ ""Акт приемки ТРУ"" можно выбирать только в документах, которые принимаются без использования резерва (счет 401.60).";
	
КонецПроцедуры

// Удаление записей в регистре при установке пометки удаления
//
// Параметры:
//  Объект - ДокументОбъект - документ объекта
Процедура УдалитьНезарегистрированноеПоступлениеНФАПоАктуПриемки(Объект) Экспорт
	Если Объект.ПометкаУдаления Тогда
		РегистрыСведений.НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ.УдалитьЗапись(Объект.Ссылка);
	КонецЕсли;
КонецПроцедуры

// Добавление записи в регистр при записи документа
//
// Параметры:
//  Объект - ДокументОбъект - документ объекта
//  АктПриемкиСсылка - ДокументСсылка.АктПриемкиТоваровРаботУслуг - ссылка на акт приемки
//	ПараметрыЗаписи - Структура - структура параметров записи:
//	 * РежимЗаписи - РежимЗаписиДокумента
//
Процедура ПриЗаписиНаСервереПоступленияНаОснованииАктПриемки(Объект, АктПриемкиСсылка, ПараметрыЗаписи) Экспорт
	Если ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		РегистрыСведений.НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ.ДобавитьЗаписьЕслиНеСуществует(
			Объект.Ссылка, АктПриемкиСсылка);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область РаботаСФормойРазделителейДокументов

// Заполняет таблицу разделителей документов на форме на основе переданного массива структур разделителей
// и структуры с заголовками для таблицы разделителей.
// Используется при вводе документов на основании, вводе учетных документов по данным инвентаризации
//
// Параметры:
// 	ДанныеРазделителей - Структура с ключами:
//    * Разделители, значение - Массив из Структура - ключи структуры определяются составом разделителей - элементы 
//    	массива содержит данные таблицы разделителей. Ключи структур соответствуют именам колонок таблицы разделителей 
//    * ЗаголовкиКолонок, Значение - Структура - структура содержит в качестве ключей ключи структур
//        массива "Разделители" (имена колонок таблицы разделителей), а в качестве значений заголовки этих колонок
//   Форма - ФормаКлиентскогоПриложения - форма, в которой необходимо заполнить таблицу разделителей документов
Процедура ЗаполнитьТаблицуРазделителиДокументов(ДанныеРазделителей, Форма) Экспорт
	Форма.РазделителиДокументов.Очистить();       
	Если НЕ ДобавитьКолонкиТаблицыРазделителей(ДанныеРазделителей, Форма) Тогда
		Возврат;
	КонецЕсли;	

	Для каждого ТекСтрока из ДанныеРазделителей.Разделители Цикл
		НоваяСтрока = Форма.РазделителиДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Таблица состава обеспечения сотрудника имуществом.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица состава обеспечения сотрудника имуществом:
// * Имущество - СправочникСсылка.Номенклатура, СправочникСсылка.ОсновныеСредства -
// * НормаВыдачи - Число -
// * СрокИспользованияПоНормативу - Число -
// * КодУсловияВозвратаИмущества - Строка -
// * ЕдиницаИзмеренияСрока - Число -
// * Приспособления - Строка -
// * РазмерОдежды - Число -
// * РазмерГоловногоУбора - Число -
// * РазмерОбуви - Число -
// * РазмерИное - Число -
Функция ТаблицаСоставаОбеспеченияСотрудникаИмуществом()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Имущество", Новый ОписаниеТипов("СправочникСсылка.Номенклатура, СправочникСсылка.ОсновныеСредства"));
	Результат.Колонки.Добавить("НормаВыдачи", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СрокИспользованияПоНормативу", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("КодУсловияВозвратаИмущества", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ЕдиницаИзмеренияСрока", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Приспособления", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("РазмерОдежды", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("РазмерГоловногоУбора", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("РазмерОбуви", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("РазмерИное", Новый ОписаниеТипов("Число"));
	Возврат Результат;
	
КонецФункции

Процедура ОчиститьРеквизитыСтрокОбъекта(Объект, ИмяТабличнойЧасти, ИменаРеквизитов)
	
	ТипыРеквизитов = Новый Структура;
	МетаданныеОбъекта = Объект.Метаданные();
	МетаданныеТЧ = МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
	Если МетаданныеТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		МетаданныеРеквизита = МетаданныеТЧ.Реквизиты.Найти(ИмяРеквизита);
		Если МетаданныеРеквизита <> Неопределено Тогда
			ТипыРеквизитов.Вставить(ИмяРеквизита, МетаданныеРеквизита.Тип);
		КонецЕсли;	
	КонецЦикла;
	Для каждого Строка Из Объект[ИмяТабличнойЧасти] Цикл
		Для каждого РеквизитСТипом Из ТипыРеквизитов Цикл
			Строка[РеквизитСТипом.Ключ] = РеквизитСТипом.Значение.ПривестиЗначение(Неопределено);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#Область РаботаСФормойРазделителейДокументов

Функция ДобавитьКолонкиТаблицыРазделителей(ДанныеРазделителей, Форма)
	Если ДанныеРазделителей.Разделители.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;	     
	
	ДобавляемыеРеквизиты = Новый Массив;
	Для каждого ТекКолонка из ДанныеРазделителей.Разделители[0] Цикл
		МиссивТипов = Новый Массив;
		МиссивТипов.Добавить(ТипЗнч(ТекКолонка.Значение));
	    ОписаниеТипов = Новый ОписаниеТипов(МиссивТипов);
	    ЗаголовокКолонки = ""; 
	    Если ДанныеРазделителей.ЗаголовкиКолонок.Свойство(ТекКолонка.Ключ) Тогда
		    ЗаголовокКолонки = ДанныеРазделителей.ЗаголовкиКолонок[ТекКолонка.Ключ];
		Иначе     
		    ЗаголовокКолонки = ТекКолонка.Ключ;
		КонецЕсли;
		НовыйРеквизит = Новый РеквизитФормы(ТекКолонка.Ключ, ОписаниеТипов, "РазделителиДокументов", ЗаголовокКолонки, Ложь);
		
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	КонецЦикла;	
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Для каждого ТекРеквизит из ДобавляемыеРеквизиты Цикл
		НовыйЭлемент = Форма.Элементы.Добавить(ТекРеквизит.Имя, Тип("ПолеФормы"), Форма.Элементы.РазделителиДокументов);
		НовыйЭлемент.ПутьКДанным = "РазделителиДокументов." + ТекРеквизит.Имя;
	КонецЦикла;	
	
	Возврат Истина;
КонецФункции

#КонецОбласти

Функция ЗначенияКПСКФОПоУмолчаниюДляСчета(Организация, ИФО, СчетУчета, ДатаЗначений, КФО = Неопределено) Экспорт
	
	Возврат ЗначенияКПСКФОПоУмолчаниюДляСчетов(
	Организация,
	ИФО,
	ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СчетУчета),
	ДатаЗначений,
	КФО).Получить(СчетУчета);
	
КонецФункции

Функция ЗначенияКПСКФОПоУмолчаниюДляСчетов(Организация, ИФО, МассивСчетов, ДатаЗначений, КФО = Неопределено) Экспорт
	
	ДанныеВозврата = Новый Соответствие;
	Период = ?(ЗначениеЗаполнено(ДатаЗначений), ДатаЗначений, ОбщегоНазначения.ТекущаяДатаПользователя());
	
	ОтборКПСПоУП = БухгалтерскийУчетПовтИсп.ВидыКПСПоУчетнойПолитике(Организация, ИФО, КФО, ДатаЗначений);
	
	Если Не ЗначениеЗаполнено(КФО) Тогда
		ОтборКФО = БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(Организация, ИФО, ДатаЗначений);
	Иначе
		ОтборКФО = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КФО);
	КонецЕсли;
	
	АУИБУ = ОтборКПСПоУП.Найти(Перечисления.ВидыКБК.АУИБУ) <> Неопределено;
	
	ОтборУточнениеКПС = Новый Массив;
		
	Если АУИБУ Тогда
		ОтборУточнениеКПС.Добавить(Перечисления.ВидыКБК.КДБ);
		ОтборУточнениеКПС.Добавить(Перечисления.ВидыКБК.КРБ);
		ОтборУточнениеКПС.Добавить(Перечисления.ВидыКБК.КИФ);
		ОтборУточнениеКПС.Добавить(Перечисления.ВидыКБК.гКБК);
	Иначе
		ОтборУточнениеКПС.Добавить(Перечисления.ВидыКБК.ПустаяСсылка());
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РабочиеСчетаСрезПоследних.Счет КАК Счет,
	|	РабочиеСчетаСрезПоследних.КПС КАК КПС,
	|	РабочиеСчетаСрезПоследних.КФО КАК КФО
	|ПОМЕСТИТЬ ВТ_РабочиеСчетаСрезПоследних
	|ИЗ
	|	РегистрСведений.РабочиеСчета.СрезПоследних(
	|			&Дата,
	|			ИФО = &ИФО
	|				И Организация = &Организация
	|				И КФО В (&ОтборКФО)
	|				И Счет В (&МассивСчетов)) КАК РабочиеСчетаСрезПоследних
	|ГДЕ
	|	РабочиеСчетаСрезПоследних.Актуален
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_РабочиеСчетаСрезПоследних.Счет КАК Счет,
	|	МАКСИМУМ(ВТ_РабочиеСчетаСрезПоследних.КПС) КАК КПС,
	|	МАКСИМУМ(ВТ_РабочиеСчетаСрезПоследних.КФО) КАК КФО
	|ИЗ
	|	ВТ_РабочиеСчетаСрезПоследних КАК ВТ_РабочиеСчетаСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВидыКБКСчетов КАК ВидыКБКСчетов
	|		ПО ВТ_РабочиеСчетаСрезПоследних.Счет = ВидыКБКСчетов.Счет
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ВТ_РабочиеСчетаСрезПоследних.Счет В (&СчетаУчетаНФА)
	|				ТОГДА ВТ_РабочиеСчетаСрезПоследних.КПС.АналитическийКодКПС = ЗНАЧЕНИЕ(Справочник.АналитическиеКодыКПС.ПустаяСсылка)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА ВТ_РабочиеСчетаСрезПоследних.Счет В (&СчетаУчетаНФА)
	|				ТОГДА ВТ_РабочиеСчетаСрезПоследних.КПС.ВидРасходаКРБ = ЗНАЧЕНИЕ(Справочник.ВидыРасходовКРБ.ПустаяСсылка)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И (ВТ_РабочиеСчетаСрезПоследних.КПС.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ВТ_РабочиеСчетаСрезПоследних.КПС.ДатаОкончанияДействия >= &Дата)
	|	И (ВТ_РабочиеСчетаСрезПоследних.КПС.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ВТ_РабочиеСчетаСрезПоследних.КПС.ДатаНачалаДействия <= &Дата)
	|	И ВТ_РабочиеСчетаСрезПоследних.Счет.УчетПоКПС
	|	И ВТ_РабочиеСчетаСрезПоследних.КПС.ВидПоказателя В(&ОтборКПСПоУП)
	|	И ВЫБОР
	|			КОГДА &АУИБУ
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ВЫБОР
	|					КОГДА НЕ ВидыКБКСчетов.Счет ЕСТЬ NULL
	|						ТОГДА ВТ_РабочиеСчетаСрезПоследних.КПС.ВидПоказателя = ВидыКБКСчетов.ВидКБК
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|		КОНЕЦ
	|	И ВТ_РабочиеСчетаСрезПоследних.КПС.УточнениеПоказателя В(&УточнениеКПС)
	|	И ВЫБОР
	|			КОГДА &АУИБУ
	|				ТОГДА ВЫБОР
	|						КОГДА НЕ ВидыКБКСчетов.Счет ЕСТЬ NULL
	|							ТОГДА ВТ_РабочиеСчетаСрезПоследних.КПС.УточнениеПоказателя = ВидыКБКСчетов.ВидКБК
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_РабочиеСчетаСрезПоследних.Счет
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ВТ_РабочиеСчетаСрезПоследних.КПС) = 1 И
	|	КОЛИЧЕСТВО(ВТ_РабочиеСчетаСрезПоследних.КФО) = 1";
	
	Запрос.УстановитьПараметр("ИФО",
	?(ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"),
	ИФО,
	Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка()));
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", Период);
	Запрос.УстановитьПараметр("МассивСчетов", МассивСчетов);
	Запрос.УстановитьПараметр("УточнениеКПС", ОтборУточнениеКПС);
	Запрос.УстановитьПараметр("ОтборКПСПоУП", ОтборКПСПоУП);
	Запрос.УстановитьПараметр("ОтборКФО", ОтборКФО);
	Запрос.УстановитьПараметр("АУИБУ", АУИБУ);
	
	Запрос.УстановитьПараметр("СчетаУчетаНФА",
	БухгалтерскийУчет.СписокСчетов("101.00,102.00,104.00,105.00,108.00,111.00,112.00,113.00,114.00",
	Период,
	,
	Организация));

	ВыборкаЗначений = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаЗначений.Следующий() Цикл
		СтруктураЗначений = Новый Структура("КПС,КФО");
		ЗаполнитьЗначенияСвойств(СтруктураЗначений, ВыборкаЗначений);
		ДанныеВозврата.Вставить(ВыборкаЗначений.Счет, СтруктураЗначений);
	КонецЦикла;
	
	Возврат ДанныеВозврата;

КонецФункции

#КонецОбласти
