#Область СлужебныйПрограммныйИнтерфейс

#Область НеоблагаемыеНДСОперации

Процедура ДобавитьДвиженияНеоблагаемыеНДСОперации(ТаблицыДляДвижений, ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	
	НастройкиДокумента = ПолучитьНастройкиДокументаДляДвиженийПоНеоблагаемымНДСОперациям(ДокументСсылка, Запрос);
	
	Если НастройкиДокумента = Неопределено Тогда
		ТаблицаДвиженийНДСНеоблагаемыеОперации = Новый ТаблицаЗначений();
		
		ТаблицаДвиженийДокументыПоНеоблагаемымНДСОперациям = Новый ТаблицаЗначений();
	Иначе
		
		ТаблицаДвиженийНДСНеоблагаемыеОперации = Запрос.Выполнить().Выгрузить();
		
		ТаблицаДвиженийДокументыПоНеоблагаемымНДСОперациям = ОпределитьПодтверждающиеДокументы(ТаблицаДвиженийНДСНеоблагаемыеОперации, ДокументСсылка, НастройкиДокумента);
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		ПересчитатьВРубли(ТаблицаДвиженийНДСНеоблагаемыеОперации, ДокументСсылка);
	КонецЕсли;
	
	ТаблицыДляДвижений.Вставить("НДСНеоблагаемыеОперации", ТаблицаДвиженийНДСНеоблагаемыеОперации);
	
	ТаблицыДляДвижений.Вставить("ДокументыПоНеоблагаемымНДСОперациям", ТаблицаДвиженийДокументыПоНеоблагаемымНДСОперациям);
	
КонецПроцедуры

Функция ПолучитьТаблицуКурсКратностьДокументов(МассивСсылок) Экспорт
	
	ТаблицаКурсКратность = ПустаяТаблицаКурсКратность();
	
	ДобавитьКурсКратностьИзШапокДокументов(ТаблицаКурсКратность, МассивСсылок);
	
	ДобавитьКурсКратностьИзТиповыхОперацийДокументов(ТаблицаКурсКратность, МассивСсылок);
	
	Возврат ТаблицаКурсКратность;
	
КонецФункции

Функция ПолучитьКурсКратностьДокумента(ТаблицаКурсКратность, ДокументСсылка) Экспорт
	
	КурсКратность = Новый Структура("Курс,Кратность", 1,1);
	
	Поиск = Новый Структура("Документ", ДокументСсылка);
	
	МассивСтрок = ТаблицаКурсКратность.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат КурсКратность;
	КонецЕсли;
	
	СтрокаДокумента = МассивСтрок[0];
	
	Если ЗначениеЗаполнено(СтрокаДокумента.Курс) Тогда
		КурсКратность.Курс = СтрокаДокумента.Курс;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДокумента.Кратность) Тогда
		КурсКратность.Кратность = СтрокаДокумента.Кратность;
	КонецЕсли;
	
	Возврат КурсКратность;
	
КонецФункции

Функция ПолучитьТипыДоговоровДляНДСНалоговыйАгент() Экспорт
	
	ТипыДоговоров = Новый Массив();
	ТипыДоговоров.Добавить(Перечисления.ТипыДоговоровДляНДС.АгентскийДоговор);
	
	Возврат ТипыДоговоров;
	
КонецФункции

