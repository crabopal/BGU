	|		ИНАЧЕ
	|			ЕСТЬNULL(ДоговорКонтрагента.ДатаДоговора, ДАТАВРЕМЯ(1,1,1))
	|	КОНЕЦ													КАК ДатаДоговора
	|ИЗ
	|	Документ.НачислениеЗаУслугиОбразования.Начисления
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	И Сумма <> 0
	|	И (НЕ Ссылка.УчитыватьНДС ИЛИ СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС))
	|	И (Ссылка.Номенклатура.КодРаздел7ДекларацииНДС <> ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка)
	|		ИЛИ 
	|		(ПорядокВыпискиСФ <> ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно)
	|		И ДоговорКонтрагента.КодРаздел7ДекларацииНДС <> ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка)))";
	
КонецФункции

Функция ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_НачислениеРодительскойПлаты()
	
	// Определение Контрагента, Договора, Номенклатуры выполняется аналогично РаботаСоСтудентами.СформироватьСчетаФактурыНачисленияРодительскойПлаты
	
	Возврат "
	|ВЫБРАТЬ
	|	Ссылка.Дата													КАК Период,
	|	Ссылка.Организация											КАК Организация,
	|	ЕСТЬNULL(ГруппаДетскогоУчреждения.Номенклатура,
	|		ЕСТЬNULL(Ссылка.ГруппаДетскогоУчреждения.Номенклатура,
	|			ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)))	КАК Номенклатура,
	|	ЕСТЬNULL(ГруппаДетскогоУчреждения.Номенклатура,
	|		ЕСТЬNULL(Ссылка.ГруппаДетскогоУчреждения.Номенклатура,
	|			ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)))
	|		<> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)		КАК НоменклатураЗаполнена,
	|	ВЫБОР
	|		КОГДА КонтрагентЭДО <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) ТОГДА
	|			КонтрагентЭДО
	|		КОГДА Ссылка.УчитыватьНДС И ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно) ТОГДА
	|			ВЫРАЗИТЬ(&СводныйКонтрагент КАК Справочник.Контрагенты)
	|		ИНАЧЕ
	|			Контрагент
	|	КОНЕЦ														КАК Контрагент,
	|	Ссылка														КАК ДокументРеализации,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма - СуммаНДС
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ														КАК СуммаРеализацииБезНДС,
	|	СтавкаНДС													КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА ДоговорКонтрагентаЭДО <> ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) ТОГДА
	|			ДоговорКонтрагентаЭДО
	|		КОГДА Ссылка.УчитыватьНДС И ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно) ТОГДА
	|			ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|		ИНАЧЕ
	|			ДоговорКонтрагента
	|	КОНЕЦ														КАК Договор,
	|	ВЫБОР
	|		КОГДА ДоговорКонтрагентаЭДО <> ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) ТОГДА
	|			ДоговорКонтрагентаЭДО
	|		КОГДА Ссылка.УчитыватьНДС И ПорядокВыпискиСФ = ЗНАЧЕНИЕ(Перечисление.ПорядокВыпискиСФЗаУслуги.Сводно) ТОГДА
	|			ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|		ИНАЧЕ
	|			ДоговорКонтрагента
	|	КОНЕЦ <> ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)			КАК ДоговорЗаполнен,
	|	Ссылка.УчитыватьНДС											КАК УчитыватьНДС
	|ПОМЕСТИТЬ
	|	ВТ
	|ИЗ
	|	Документ.НачислениеРодительскойПлаты.Начисления
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Движения по регистрам необлагаемых операций - НачислениеРодительскойПлаты
	|//
	|ВЫБРАТЬ
	|	// Сведения для движений по РегистрНакопления.НДСНеоблагаемыеОпераци
	|	Период														КАК Период,
	|	Организация													КАК Организация,
	|	ВЫБОР
	|		КОГДА НоменклатураЗаполнена ТОГДА
	|			Номенклатура.КодРаздел7ДекларацииНДС
	|		КОГДА ДоговорЗаполнен ТОГДА
	|			Договор.КодРаздел7ДекларацииНДС
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка)
	|	КОНЕЦ														КАК КодОперации,
	|	Контрагент													КАК Контрагент,
	|	ДокументРеализации											КАК ДокументРеализации,
	|	СуммаРеализацииБезНДС										КАК СуммаРеализацииБезНДС,
	|	
	|	// Сведения для движений по РегистрСведений.ДокументыПоНеоблагаемымНДСОперациям
	|	ВЫБОР
	|		КОГДА НоменклатураЗаполнена ТОГДА
	|			ЕСТЬNULL(Номенклатура.КодРаздел7ДекларацииНДС.ВключаетсяВРеестрПодтверждающихДокументов, ЛОЖЬ)
	|		КОГДА ДоговорЗаполнен ТОГДА
	|			ЕСТЬNULL(Договор.КодРаздел7ДекларацииНДС.ВключаетсяВРеестрПодтверждающихДокументов, ЛОЖЬ)
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ														КАК КодОперацииВключаетсяВРеестр,
	|	Договор														КАК Договор,
	|	ЕСТЬNULL(Договор.НомерДоговора, """")							КАК НомерДоговора,
	|	ЕСТЬNULL(Договор.ДатаДоговора, ДАТАВРЕМЯ(1,1,1))			КАК ДатаДоговора
	|ИЗ
	|	ВТ
	|ГДЕ
	|	СуммаРеализацииБезНДС <> 0
	|	И (НЕ УчитыватьНДС ИЛИ СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС))
	|	И ВЫБОР
	|		КОГДА НоменклатураЗаполнена ТОГДА
	|			Номенклатура.КодРаздел7ДекларацииНДС
	|		КОГДА ДоговорЗаполнен ТОГДА
	|			Договор.КодРаздел7ДекларацииНДС
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка)
	|	КОНЕЦ <> ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка)";
	
КонецФункции

