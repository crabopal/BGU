	|		ИЛИ Договор.КодРаздел7ДекларацииНДС <> ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка))";
	
КонецФункции

Функция ОпределитьПодтверждающиеДокументы(ТаблицаДвиженийНДСНеоблагаемыеОперации, ДокументСсылка, НастройкиДокумента)
	
	ТаблицаДвижений = ПустаяТаблицаРегистраСведений("ДокументыПоНеоблагаемымНДСОперациям");
	
	ТипПодтверждающегоДокумента = НастройкиДокумента.ТипПодтверждающегоДокумента;
	
	ОперацииПолные = ТаблицаДвиженийНДСНеоблагаемыеОперации.Скопировать(Новый Структура("КодОперацииВключаетсяВРеестр", Истина));
	
	ПоляСверткиДоговоров = "Организация,Контрагент,Договор";
	РазличныеДоговоры = ОперацииПолные.Скопировать(, ПоляСверткиДоговоров);
	РазличныеДоговоры.Свернуть(ПоляСверткиДоговоров);
	
	ОперацииСвернутые = ОперацииПолные.Скопировать();
	ОперацииСвернутые.Свернуть("Организация, КодОперации, Контрагент, Договор, ДокументРеализации, Период");
	
	ДокументооборотНастроен = ОбменСКонтрагентами.ДокументооборотНастроен(ДокументСсылка);
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата,Номер");
	
	НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, РеквизитыДокумента.Номер);
	
	// Все измерения регистра сведений ДокументыПоНеоблагаемымНДСОперациям (7):
	НоваяСтрока = Новый Структура("
		|Организация,
 		|КодОперации,
 		|Контрагент,
 		|ДокументРеализации,
 		|ТипПодтверждающегоДокумента,
 		|НомерДокумента,
 		|ДатаДокумента");
	
	//
	// Регистрируем документы реализации
	//
	Для Каждого Операция Из ОперацииСвернутые Цикл
		Если ДокументооборотНастроен Тогда
			ИспользуетсяУПД = ОбменСКонтрагентами.ИспользованиеУниверсальногоПередаточногоДокумента(
				Операция.Организация,
				Операция.Контрагент,
				Операция.Договор);
				
			Если ИспользуетсяУПД Тогда 
				ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.УПД;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.Организация					= Операция.Организация;
		НоваяСтрока.КодОперации					= Операция.КодОперации;
		НоваяСтрока.Контрагент					= Операция.Контрагент;
		НоваяСтрока.ДокументРеализации			= Операция.ДокументРеализации;
		НоваяСтрока.ТипПодтверждающегоДокумента	= ТипПодтверждающегоДокумента;
		НоваяСтрока.НомерДокумента				= НомерДокумента;
		НоваяСтрока.ДатаДокумента				= НачалоДня(РеквизитыДокумента.Дата);
		
		ДобавитьУникальнуюСтроку(ТаблицаДвижений, НоваяСтрока);
	КонецЦикла;
	
	Поиск = Новый Структура(ПоляСверткиДоговоров);
	
	//
	// Регистрируем договоры из документов реализации
	//
	Для Каждого СтрокаДоговора Из РазличныеДоговоры Цикл
		Если Не ЗначениеЗаполнено(СтрокаДоговора.Договор) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаДоговора);
		
		МассивСтрок = ОперацииПолные.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Операция = МассивСтрок[0];
		
		Если Не ЗначениеЗаполнено(Операция.НомерДоговора) И Не ЗначениеЗаполнено(Операция.ДатаДоговора) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока.Организация					= Операция.Организация;
		НоваяСтрока.КодОперации					= Операция.КодОперации;
		НоваяСтрока.Контрагент					= Операция.Контрагент;
		НоваяСтрока.ДокументРеализации			= Операция.ДокументРеализации;
		НоваяСтрока.ТипПодтверждающегоДокумента	= Справочники.ТипыДокументов.Договор;
		НоваяСтрока.НомерДокумента				= Операция.НомерДоговора;
		НоваяСтрока.ДатаДокумента				= НачалоДня(Операция.ДатаДоговора);
		
		ДобавитьУникальнуюСтроку(ТаблицаДвижений, НоваяСтрока);
	КонецЦикла;
	
	Возврат ТаблицаДвижений;
	
КонецФункции

Функция ПустаяТаблицаРегистраСведений(ИмяРегистра)
	
	ПустаяТаблица = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	УдаляемыеКолонки = Новый Массив();
	УдаляемыеКолонки.Добавить("Период");
	УдаляемыеКолонки.Добавить("Регистратор");
	УдаляемыеКолонки.Добавить("НомерСтроки");
	УдаляемыеКолонки.Добавить("Активность");
	
	Для Каждого ИмяКолонки Из УдаляемыеКолонки Цикл
		Если ПустаяТаблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПустаяТаблица.Колонки.Удалить(ИмяКолонки);
	КонецЦикла;
	
	Возврат ПустаяТаблица;
	
КонецФункции

Процедура ДобавитьУникальнуюСтроку(Таблица, Значение)
	
	МассивСтрок = Таблица.НайтиСтроки(Значение);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Таблица.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Значение);
	
КонецПроцедуры

Процедура ПересчитатьВРубли(ТаблицаДвиженийНДСНеоблагаемыеОперации, ДокументСсылка)
	
	МассивСсылок = Новый Массив();
	МассивСсылок.Добавить(ДокументСсылка);
	
	ТаблицаКурсКратность = ПолучитьТаблицуКурсКратностьДокументов(МассивСсылок);
	
	КурсКратность = ПолучитьКурсКратностьДокумента(ТаблицаКурсКратность, ДокументСсылка);
	
	Если КурсКратность.Курс = 1 И КурсКратность.Кратность = 1 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДвиженийНДСНеоблагаемыеОперации Цикл
		СтрокаТаблицы.СуммаРеализацииБезНДС = Окр(СтрокаТаблицы.СуммаРеализацииБезНДС * КурсКратность.Курс / КурсКратность.Кратность, 2);
	КонецЦикла;
	
КонецПроцедуры

Функция ПустаяТаблицаКурсКратность()
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Документ");
	Таблица.Колонки.Добавить("Курс",		ОбщегоНазначения.ОписаниеТипаЧисло(10,4,ДопустимыйЗнак.Неотрицательный));
	Таблица.Колонки.Добавить("Кратность",	ОбщегоНазначения.ОписаниеТипаЧисло(10,0,ДопустимыйЗнак.Неотрицательный));
	
	Возврат Таблица;
	
КонецФункции

Процедура ДобавитьКурсКратностьИзШапокДокументов(ТаблицаКурсКратность, МассивСсылок)
	
	ТипыВидыДокументов = ПолучитьТипыВидыДокументов(МассивСсылок);
	
	ТекстЗапросаШаблон = "
	|ВЫБРАТЬ
	|	Ссылка КАК Документ,
	|	%1
	|ИЗ
	|	Документ.%2
	|ГДЕ
	|	Ссылка В(&МассивСсылок)";
	
	ТекстВыбратьШаблон = "%1 КАК %2";
	
	ТекстыЗапросов = Новый Массив();
	
	ИскомыеРеквизиты = Новый Массив();
	ИскомыеРеквизиты.Добавить("Курс");
	ИскомыеРеквизиты.Добавить("Кратность");
	
	Для Каждого ВидДокумента Из ТипыВидыДокументов.ВидыДокументов Цикл
	
		МетаданныеДокумента = Метаданные.Документы.Найти(ВидДокумента);
		
		Если МетаданныеДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИменаПолейВыбрать = Новый Массив();
		
		ЕстьРеквизиты = Ложь;
		
		Для Каждого ИмяРеквизита Из ИскомыеРеквизиты Цикл
			Если МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
				// Реквизит присутствует
				ЕстьРеквизиты = Истина;
				
				ИменаПолейВыбрать.Добавить(СтрШаблон(ТекстВыбратьШаблон, ИмяРеквизита, ИмяРеквизита));
			Иначе
				// Реквизит отсутствует
				ИменаПолейВыбрать.Добавить(СтрШаблон(ТекстВыбратьШаблон, "Неопределено", ИмяРеквизита));
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЕстьРеквизиты Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстВыбрать = СтрСоединить(ИменаПолейВыбрать, ",
			|	");
		
		ТекстыЗапросов.Добавить(СтрШаблон(ТекстЗапросаШаблон, ТекстВыбрать, ВидДокумента));
		
	КонецЦикла;
	
	Если ТекстыЗапросов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивСсылок);
	ЗапросПоиск.Текст = СтрСоединить(ТекстыЗапросов, "
		|ОБЪЕДИНИТЬ ВСЕ
		|");
		
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаКурсКратность.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТипыВидыДокументов(МассивСсылок)
	
	// Аналогично АктСверкиВзаиморасчетов
	
	ТипыДокументов = Новый Массив();
	
	ВидыДокументов = Новый Массив();
	
	Для Каждого Ссылка Из МассивСсылок Цикл
		ТипДокумента = ТипЗнч(Ссылка);
		
		Если ЗначениеЗаполнено(Ссылка) И ТипыДокументов.Найти(ТипДокумента) = Неопределено Тогда
			ТипыДокументов.Добавить(ТипДокумента);
			
			ВидыДокументов.Добавить(Метаданные.НайтиПоТипу(ТипДокумента).Имя);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ТипыДокументов", ТипыДокументов);
	Результат.Вставить("ВидыДокументов", ВидыДокументов);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьКурсКратностьИзТиповыхОперацийДокументов(ТаблицаКурсКратность, МассивСсылок)
	
	// Исключаем документы, для которых уже определили курс и кратность
	ВремТаблица = ТаблицаКурсКратность.Скопировать(,"Документ");
	ВремТаблица.Свернуть("Документ");
	МассивДобавленных = ВремТаблица.ВыгрузитьКолонку("Документ");
	
	МассивНеобработанныхСсылок = Новый Массив();
	
	Для Каждого Ссылка Из МассивСсылок Цикл
		Если МассивДобавленных.Найти(Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МассивНеобработанныхСсылок.Добавить(Ссылка);
	КонецЦикла;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивНеобработанныхСсылок);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Документ	КАК Документ,
	|	Курс		КАК Курс,
	|	Кратность	КАК Кратность
	|ИЗ
	|	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|ГДЕ
	|	ОперацииДокументов.Документ В (&МассивСсылок)";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаКурсКратность.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

