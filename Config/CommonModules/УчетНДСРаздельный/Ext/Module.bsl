Функция ПолучитьНастройкиДокументаДляДвиженийПоНеоблагаемымНДСОперациям(ДокументСсылка, Запрос)
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_АктОбОказанииУслуг();
		
		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Акт;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаОтпускИК") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_НакладнаяНаОтпускИК();
		
		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Накладная;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_НакладнаяНаОтпускМ15();
		
		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Накладная;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_НакладнаяНаРеализациюТорг12();
		
		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Накладная;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НачислениеАмортизацииПравПользованияОС") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_НачислениеАмортизацииПравПользованияОС();
		
		Запрос.УстановитьПараметр("ТипыДоговоровНалоговыйАгент", ПолучитьТипыДоговоровДляНДСНалоговыйАгент());
		
		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Акт;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НачислениеДоходов") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_НачислениеДоходов();
		
		Запрос.УстановитьПараметр("СводныйКонтрагент", РаботаСоСтудентамиПовтИсп.ПолучитьКонтрагентаДляСводнойСчетФактуры());
		
		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Акт;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НачислениеЗаУслугиОбразования") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_НачислениеЗаУслугиОбразования();
		
		Запрос.УстановитьПараметр("СводныйКонтрагент", РаботаСоСтудентамиПовтИсп.ПолучитьКонтрагентаДляСводнойСчетФактуры());

		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Акт;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НачислениеРодительскойПлаты") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_НачислениеРодительскойПлаты();
		
		Запрос.УстановитьПараметр("СводныйКонтрагент", РаботаСоСтудентамиПовтИсп.ПолучитьКонтрагентаДляСводнойСчетФактуры());

		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Акт;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_НачислениеСтудентамЗаПрочиеУслуги();
		
		Запрос.УстановитьПараметр("СводныйКонтрагент", РаботаСоСтудентамиПовтИсп.ПолучитьКонтрагентаДляСводнойСчетФактуры());

		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Акт;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОтчетПоКассовойСмене") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_ОтчетПоКассовойСмене();
		
		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.ОтчетПоКассовойСмене;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОтчетОРозничныхПродажах") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_ОтчетОРозничныхПродажах();
		
		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.ОтчетОРозничныхПродажах;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_ПередачаОбъектовИК();
		
		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Накладная;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_ПередачаОбъектовОС();
		
		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Накладная;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СдачаЭтапаРабот") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_СдачаЭтапаРабот();
		
		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Акт;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов") Тогда
		ТекстЗапроса = ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_СписаниеДоходовБудущихПериодов();
		
		ТипПодтверждающегоДокумента = Справочники.ТипыДокументов.Акт;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;

	НастройкиДокумента = Новый Структура();
	НастройкиДокумента.Вставить("ТипПодтверждающегоДокумента", ТипПодтверждающегоДокумента);
	
	Возврат НастройкиДокумента;
	
КонецФункции

Функция ТекстЗапросаДвиженияНДСНеоблагаемыеОперации_АктОбОказанииУслуг()
	
	Возврат "
	|ВЫБРАТЬ
	|	// Сведения для движений по РегистрНакопления.НДСНеоблагаемыеОпераци
	|	Ссылка.Дата												КАК Период,
	|	Ссылка.Организация										КАК Организация,
	|	ВЫБОР
	|		КОГДА Номенклатура.КодРаздел7ДекларацииНДС <> ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка) ТОГДА
	|			ЕСТЬNULL(Номенклатура.КодРаздел7ДекларацииНДС, ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЕСТЬNULL(Ссылка.Договор.КодРаздел7ДекларацииНДС, ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка))
	|	КОНЕЦ													КАК КодОперации,
	|	Ссылка.Контрагент										КАК Контрагент,
	|	Ссылка													КАК ДокументРеализации,
	|	ВЫБОР
	|		КОГДА Ссылка.СуммаВключаетНДС ТОГДА
	|			Сумма - СуммаНДС
	|		ИНАЧЕ
	|			Сумма
	|	КОНЕЦ													КАК СуммаРеализацииБезНДС,
	|	
	|	// Сведения для движений по РегистрСведений.ДокументыПоНеоблагаемымНДСОперациям
	|	ВЫБОР
	|		КОГДА Номенклатура.КодРаздел7ДекларацииНДС <> ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка) ТОГДА
	|			ЕСТЬNULL(Номенклатура.КодРаздел7ДекларацииНДС.ВключаетсяВРеестрПодтверждающихДокументов, ЛОЖЬ)
	|		ИНАЧЕ
	|			ЕСТЬNULL(Ссылка.Договор.КодРаздел7ДекларацииНДС.ВключаетсяВРеестрПодтверждающихДокументов, ЛОЖЬ)
	|	КОНЕЦ													КАК КодОперацииВключаетсяВРеестр,
	|	Ссылка.Договор											КАК Договор,
	|	ЕСТЬNULL(Ссылка.Договор.НомерДоговора, """")				КАК НомерДоговора,
	|	ЕСТЬNULL(Ссылка.Договор.ДатаДоговора, ДАТАВРЕМЯ(1,1,1))	КАК ДатаДоговора
	|ИЗ
	|	Документ.АктОбОказанииУслуг.УслугиОказанные
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	И Сумма <> 0
	|	И СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|	И (Номенклатура.КодРаздел7ДекларацииНДС <> ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка)
	|		ИЛИ Ссылка.Договор.КодРаздел7ДекларацииНДС <> ЗНАЧЕНИЕ(Справочник.КодыОперацийРаздела7ДекларацииПоНДС.ПустаяСсылка))";
	
КонецФункции

