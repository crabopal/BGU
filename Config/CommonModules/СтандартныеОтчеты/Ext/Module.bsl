// ПРОЦЕДУРЫ РАБОТЫ С КОЛОНТИТУЛАМИ

// Проставление в тексте вместо шаблонов, значений
//
// Параметры
//  Текст           - Строка - Исходный текст шаблона
//  НазваниеОтчета  - Строка - Название отчета
//  Пользователь    - Строка - Имя пользователя
//
// Возвращаемое значение:
//   Строка   - результирующий текст для колонтитула
//
Функция ЗаполнитьТекстКолонтитула(Текст, НазваниеОтчета, Пользователь, Организация)

	Результат = Текст;
	
	Результат = СтрЗаменить(Результат, "[&НазваниеОтчета]", НазваниеОтчета);
	Результат = СтрЗаменить(Результат, "[&Пользователь]",   Пользователь);
	Результат = СтрЗаменить(Результат, "[&Организация]",    Организация);
	
	Возврат Результат;

КонецФункции // ЗаполнитьТекстКолонтитула()    

///////////////////////////////////////////////////////////////////////////////
//  ФУНКЦИИ И ПРОЦЕДУРЫ РАСШИФРОВКИ ОТЧЕТОВ ПО САНКЦИОНИРОВАНИЮ И ПЛАНУ ФХД

Функция ПолучитьНастройкиДляДополнительнойРасшифровки(ИДРасшифровки, МассивПолей, ДанныеОтчета, Счет, КорСчет)
	
	ЕстьПоказатель  = Ложь;
	ЕстьКорЗначение = Ложь;
	ЕстьСчет        = Истина;
	ПервыйЭлемент   = Неопределено;
	Период          = Неопределено;
	Для Каждого Элемент Из МассивПолей Цикл
		Если ТипЗнч(Элемент) = Тип("ЗначениеПоляРасшифровкиКомпоновкиДанных") Тогда
			Если ПервыйЭлемент = Неопределено И Элемент.Поле <> "Показатель" Тогда 
				ПервыйЭлемент = Элемент;
			КонецЕсли;
			Если      Элемент.Поле = "Показатель" Тогда
				ЕстьПоказатель = Истина;
			ИначеЕсли Элемент.Поле = "Период" Тогда
				Период = Элемент.Значение;
			ИначеЕсли Найти(Элемент.Поле, "Кор") = 1 Тогда
				ЕстьКорЗначение = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	
	ДобавитьОтборПоВидСубконто    = Истина;
	ДобавитьОтборПоВидКорСубконто = Истина;
	
	ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	ПользовательскиеОтборы = ПользовательскиеНастройки.Элементы.Добавить(Тип("ОтборКомпоновкиДанных"));
	ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;
	
	ПользовательскиеОтборы.ИдентификаторПользовательскойНастройки = "Отбор";
	
	
	ДополнительныеСвойства.Вставить("РежимРасшифровки", Истина);
	
	ДополнительныеСвойства.Вставить("Счет", Счет);
	ДополнительныеСвойства.Вставить("КорСчет", КорСчет);
	Если ИДРасшифровки = "АнализСчета" и ЗначениеЗаполнено(КорСчет) тогда
	    СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "КорСчет", КорСчет, ВидСравненияКомпоновкиДанных.ВИерархии);	
	КонецЕсли;	
	Если  ИДРасшифровки = "ОборотыСчета" тогда
		ДополнительныеСвойства.Вставить("СальдоНаНачалоДт", Истина);	 
		ДополнительныеСвойства.Вставить("СальдоНаНачалоКт", Истина);	 
		ДополнительныеСвойства.Вставить("СальдоНаКонецДт", Истина);	 
		ДополнительныеСвойства.Вставить("СальдоНаКонецКт", Истина);	 
		ДополнительныеСвойства.Вставить("ОборотыЗаПериодДт", Истина);	 
		ДополнительныеСвойства.Вставить("ОборотыЗаПериодКт", Истина);	 
		ДополнительныеСвойства.Вставить("ОборотыСоСчетамиДт", Истина);	 
		ДополнительныеСвойства.Вставить("ОборотыСоСчетамиКт", Истина);	 
		ДополнительныеСвойства.Вставить("ПоСубсчетамКорСчетов", Истина);	 
		ДополнительныеСвойства.Вставить("Периодичность", 9);	 
		ДополнительныеСвойства.Вставить("ПоСубсчетам", Истина);	 
	КонецЕсли;
	
	СписокПолейОтборов = Новый Массив;
	Для каждого Отбор из МассивПолей Цикл
		Если ТипЗнч(Отбор) = Тип("ЗначениеПоляРасшифровкиКомпоновкиДанных") тогда
			Если Отбор.Значение = NULL тогда
				Продолжить;
			КонецЕсли;
			Если Отбор.Поле = "Организация" Тогда
				ДополнительныеСвойства.Вставить("Организация", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "Показатель" Тогда 
				Показатель = Отбор.Значение;
			ИначеЕсли Отбор.Поле = "Регистратор" или Отбор.Поле = "Период" Тогда 
				ЕСли ИДРасшифровки = "КарточкаСчета" тогда
					СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, Отбор.Поле, Отбор.Значение);
				КонецЕсли;	
			ИначеЕсли Отбор.Поле = "Документ" Тогда 
				ЕСли ИДРасшифровки = "КарточкаСчета" тогда
					СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Регистратор", Отбор.Значение);
				КонецЕсли;	
			ИначеЕсли Отбор.Поле = "КПС" Тогда 
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "КПС", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "КЭК" Тогда 
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "КЭК", Отбор.Значение);
			ИначеЕсли ЗначениеЗаполнено(Счет) Тогда
				НайденоСубконтоПодходящегоТипа = Ложь;
				Для Сч = 0 по Счет.ВидыСубконто.Количество()-1 Цикл
					ТипСубконто = Счет.ВидыСубконто[Сч].ВидСубконто.ТипЗначения;
					Если ТипСубконто.СодержитТип(ТипЗнч(Отбор.Значение)) Тогда
						Если Отбор.Иерархия Тогда
							СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто"+(Сч+1), Отбор.Значение, ВидСравненияКомпоновкиДанных.ВИерархии);
						Иначе
							СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы,  "Субконто"+(Сч+1), Отбор.Значение);
						КонецЕсли;
						НайденоСубконтоПодходящегоТипа = Истина;
					КонецЕсли;
				КонецЦикла;
				Если НайденоСубконтоПодходящегоТипа Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Если Отбор.Поле = "Обязательство" Тогда 
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто2", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "Контрагент" Тогда 
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто2.Контрагент", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "РазделЛицевогоСчета" или Отбор.Поле = "Номенклатура" Тогда 
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто1", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "ЛицевойСчет" И ТипЗнч(Отбор.Значение) = Тип("СправочникСсылка.ЛицевыеСчета") Тогда 
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто1.Владелец", Отбор.Значение);
			КонецЕсли;
		ИначеЕсли ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Если Отбор.Представление = "###ОтборПоОрганизацияСОП###" Тогда
				Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
					Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация") Тогда
						ДополнительныеСвойства.Вставить("Организация"                      , Отбор.ПравоеЗначение);
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли Отбор.Представление = "###Контроль###" Тогда
			КонецЕсли;
		ИначеЕсли ТипЗнч(Отбор) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если СписокПолейОтборов.Найти(Строка(Отбор.ЛевоеЗначение)) = Неопределено Тогда
				Если Отбор.Представление = "###ОтборПоОрганизация###" Тогда
					ДополнительныеСвойства.Вставить("Организация"                      , Отбор.ПравоеЗначение);
				Иначе
					СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, Отбор.ЛевоеЗначение, Отбор.ПравоеЗначение, Отбор.ВидСравнения);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДополнительныеСвойства.Вставить("НачалоПериода", ДанныеОтчета.НачалоПериода);
	ДополнительныеСвойства.Вставить("КонецПериода" , ДанныеОтчета.КонецПериода);
	ДополнительныеСвойства.Вставить("Организация" , ДанныеОтчета.Организация);
	
	ДополнительныеСвойства.Вставить("ПоказательБУ", Истина);
	Если ЗначениеЗаполнено(Счет) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет,"Количественный") Тогда
		ДополнительныеСвойства.Вставить("ПоказательКоличество", Истина);
	КонецЕсли;
	
	Возврат ПользовательскиеНастройки;
	
КонецФункции

Функция УстановитьСчета(Счет,КорСчет)
	Возврат Новый Структура("Счет,КорСчет",Счет,КорСчет);
КонецФункции	

Функция ОпределитьСчетИзМассиваПолей(МассивПолей, Счет)
	
	Для Каждого Поле Из МассивПолей Цикл
		Если ТипЗнч(Поле) <> Тип("ЗначениеПоляРасшифровкиКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Если Поле.Поле = "Счет" Тогда
			Возврат Поле.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Счет;
	
Конецфункции 

