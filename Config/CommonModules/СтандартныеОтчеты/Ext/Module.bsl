// 
Функция ДанныеОтчетаРазвернутоеСальдо(Запрос, Счет = Неопределено) Экспорт
    
    Запрос.Текст =
        "ВЫБРАТЬ
        |   РазвернутоеСальдо.Счет,
        |   РазвернутоеСальдо.Использование,
        |   РазвернутоеСальдо.Субконто1,
        |   РазвернутоеСальдо.Субконто2,
        |   РазвернутоеСальдо.Субконто3
        |ИЗ
        |   РегистрСведений.РазвернутоеСальдо КАК РазвернутоеСальдо
        |";
    Если Счет <> Неопределено Тогда
        Запрос.Текст = Запрос.Текст +
            "ГДЕ
             |   РазвернутоеСальдо.Счет = &Счет
             |";
    КонецЕсли;
    Запрос.Текст = Запрос.Текст +
        "УПОРЯДОЧИТЬ ПО
         |   РазвернутоеСальдо.Счет.Порядок
         |";
         
    Если Счет <> Неопределено Тогда
        Запрос.УстановитьПараметр("Счет", Счет);
    КонецЕсли;
    
    Возврат Запрос.Выполнить().Выбрать();
    
КонецФункции


