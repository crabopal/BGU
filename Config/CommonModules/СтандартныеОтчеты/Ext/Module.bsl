// ПРОЦЕДУРЫ РАБОТЫ С КОЛОНТИТУЛАМИ

// Чтение настроек колонтитулов из константы. Если константа не заполнена, то формируются пустые настройки.
//
// Параметры
//  Нет
//
// Возвращаемое значение:
//   Структура   - Настройки колонтитулов
//
Функция ПолучитьНастройкиКолонтитулов() Экспорт

	Настройка = Константы.НастройкиКолонтитуловПоУмолчанию.Получить().Получить();
	
	Если ТипЗнч(Настройка) <> Тип("Структура") Тогда
		// Если константа не заполнена, то заполним структуру настройками пустых колонтитулов
		
		Настройка = Новый Структура;
		
		Верхний = Новый Структура;
		Нижний = Новый Структура;
		
		Верхний.Вставить("Выводить", Ложь);
		Верхний.Вставить("НачальнаяСтраница", 1);
		Верхний.Вставить("ТекстСлева",   "");
		Верхний.Вставить("ТекстВЦентре", "");
		Верхний.Вставить("ТекстСправа",  "");
		
		Нижний.Вставить("Выводить", Ложь);
		Нижний.Вставить("НачальнаяСтраница", 1);
		Нижний.Вставить("ТекстСлева",   "");
		Нижний.Вставить("ТекстВЦентре", "");
		Нижний.Вставить("ТекстСправа",  "");
		
		Настройка.Вставить("ВерхнийКолонтитул", Верхний);
		Настройка.Вставить("НижнийКолонтитул",  Нижний);
		
	Иначе
		// Если константа заполнена, но нет нужных нам полей, то заполним структуру настройками пустых колонтитулов
	
		Если Не Настройка.Свойство("ВерхнийКолонтитул") Тогда
			
			Верхний = Новый Структура;
			
			Верхний.Вставить("Выводить", Ложь);
			Верхний.Вставить("НачальнаяСтраница", 1);
			Верхний.Вставить("ТекстСлева",   "");
			Верхний.Вставить("ТекстВЦентре", "");
			Верхний.Вставить("ТекстСправа",  "");
			
			Настройка.Вставить("ВерхнийКолонтитул", Верхний);
			
		КонецЕсли;
		
		Если Не Настройка.Свойство("НижнийКолонтитул") Тогда
			
			Нижний = Новый Структура;
			
			Нижний.Вставить("Выводить", Ложь);
			Нижний.Вставить("НачальнаяСтраница", 1);
			Нижний.Вставить("ТекстСлева",   "");
			Нижний.Вставить("ТекстВЦентре", "");
			Нижний.Вставить("ТекстСправа",  "");
			
			Настройка.Вставить("НижнийКолонтитул",  Нижний);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Настройка;

КонецФункции // ПолучитьНастройкиКолонтитулов()

// Запись настроек колонтитулов в константу
//
// Параметры
//  Настройка  - Структура - Настройка колонтитулов
//
Процедура ЗаписатьНастройкиКолонтитулов(Настройка) Экспорт

	Константы.НастройкиКолонтитуловПоУмолчанию.Установить(Новый ХранилищеЗначения(Настройка));

КонецПроцедуры // ЗаписатьНастройкиКолонтитулов()

// Установка колонтитулов для отчета
//
// Параметры
//  ТабличныйДокумент  - ТабличныйДокумент - Отчет, у которого необходимо установить колонтитулы
//  НазваниеОтчета     - Строка            - Название отчета для вывода в колонтитул
//  Пользователь       - Строка            - Имя пользователя для вывода в колонтитул
//
Процедура УстановитьКолонтитулыПоУмолчанию(ТабличныйДокумент, НазваниеОтчета, Пользователь, Организация) Экспорт

	Настройка = СтандартныеОтчеты.ПолучитьНастройкиКолонтитулов();
	
	ТабличныйДокумент.ВерхнийКолонтитул.Выводить          = Настройка.ВерхнийКолонтитул.Выводить;
	ТабличныйДокумент.ВерхнийКолонтитул.НачальнаяСтраница = Настройка.ВерхнийКолонтитул.НачальнаяСтраница;
	ТабличныйДокумент.ВерхнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Низ;
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстСлева   = ЗаполнитьТекстКолонтитула(Настройка.ВерхнийКолонтитул.ТекстСлева, НазваниеОтчета, Пользователь, Организация);
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстВЦентре = ЗаполнитьТекстКолонтитула(Настройка.ВерхнийКолонтитул.ТекстВЦентре, НазваниеОтчета, Пользователь, Организация);
	ТабличныйДокумент.ВерхнийКолонтитул.ТекстСправа  = ЗаполнитьТекстКолонтитула(Настройка.ВерхнийКолонтитул.ТекстСправа, НазваниеОтчета, Пользователь, Организация);
	
	ТабличныйДокумент.НижнийКолонтитул.Выводить          = Настройка.НижнийКолонтитул.Выводить;
	ТабличныйДокумент.НижнийКолонтитул.НачальнаяСтраница = Настройка.НижнийКолонтитул.НачальнаяСтраница;
	ТабличныйДокумент.НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	ТабличныйДокумент.НижнийКолонтитул.ТекстСлева   = ЗаполнитьТекстКолонтитула(Настройка.НижнийКолонтитул.ТекстСлева, НазваниеОтчета, Пользователь, Организация);
	ТабличныйДокумент.НижнийКолонтитул.ТекстВЦентре = ЗаполнитьТекстКолонтитула(Настройка.НижнийКолонтитул.ТекстВЦентре, НазваниеОтчета, Пользователь, Организация);
	ТабличныйДокумент.НижнийКолонтитул.ТекстСправа  = ЗаполнитьТекстКолонтитула(Настройка.НижнийКолонтитул.ТекстСправа, НазваниеОтчета, Пользователь, Организация);
	
КонецПроцедуры // УстановитьКолонтитулы()

///////////////////////////////////////////////////////////////////////////////
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка, ГруппаДополнительныхКоманд = Неопределено) Экспорт
	
	Отчет     = Форма.Отчет;
	Параметры = Форма.Параметры;
	Если Параметры.Свойство("РежимРасшифровки") Тогда 
		Отчет.РежимРасшифровки = Параметры.РежимРасшифровки;
	КонецЕсли;
	
	Если Параметры.Свойство("ВидРасшифровки") Тогда 
		// 1 - из временного хранилища, 2 - из параметров формы
		Если Параметры.ВидРасшифровки = 1 Тогда
			ДанныеОбъекта = ПолучитьИзВременногоХранилища(Параметры.АдресНастроек);
			ПользовательскиеНастройки = ДанныеОбъекта.НастройкиРасшифровки[Параметры.ИДРасшифровки];
		ИначеЕсли Параметры.ВидРасшифровки = 2 Тогда
			ПользовательскиеНастройки = Параметры.ПользовательскиеНастройки;
		КонецЕсли;
		
		// Установка пользовательских настроек
		Отчет.КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки              = "Отбор";
		Отчет.КомпоновщикНастроек.Настройки.Порядок.ИдентификаторПользовательскойНастройки            = "Порядок";
		Отчет.КомпоновщикНастроек.Настройки.УсловноеОформление.ИдентификаторПользовательскойНастройки = "УсловноеОформление";
		
		// Загрузка пользовательских настроек в компоновщик настроек отчета
		Отчет.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(ПользовательскиеНастройки);
		
		// Получение основных настроек компоновщика настроек, с учетом пользовательских настроек
		Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
		
		// Загрузка основных настроек
		Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
		
		// Очистка пользовательских настроек
		Отчет.КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки              = "";
		Отчет.КомпоновщикНастроек.Настройки.Порядок.ИдентификаторПользовательскойНастройки            = "";
		Отчет.КомпоновщикНастроек.Настройки.УсловноеОформление.ИдентификаторПользовательскойНастройки = "";
		
		// Установка значений реквизитов отчета
		Для Каждого ЭлементСтруктуры Из ПользовательскиеНастройки.ДополнительныеСвойства Цикл
			Если Отчет.Свойство(ЭлементСтруктуры.Ключ) Тогда
				// Табличные части отчета могут быть переданны в виде массива структур
				Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("Массив") Тогда 
					Для Каждого СтрокаСведений Из ЭлементСтруктуры.Значение Цикл
						НоваяСтрока = Отчет[ЭлементСтруктуры.Ключ].Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСведений);
					КонецЦикла;
				Иначе
					Отчет[ЭлементСтруктуры.Ключ] = ЭлементСтруктуры.Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ОтчетОбъект = Форма.РеквизитФормыВЗначение("Отчет");
	Если Не ЗначениеЗаполнено(Форма.СхемаКомпоновкиДанных) Тогда
		Форма.СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(ОтчетОбъект.СхемаКомпоновкиДанных, Форма.УникальныйИдентификатор);
	КонецЕсли;
	
	Форма.ДанныеРасшифровки = ПоместитьВоВременноеХранилище(Форма.ДанныеРасшифровки, Форма.УникальныйИдентификатор);
	
	// Для отчетов переделанных в фон
	// Отчеты[СтандартныеОтчеты.ИмяОтчетаПоИмениФормы(Форма)]
	Форма.НаборПоказателей = Новый ФиксированныйМассив(ОтчетОбъект.НаборПоказателей); 
	
	ПараметрМакетОформления = СтандартныеОтчетыКлиентСервер.ПолучитьПараметрВывода(Отчет.КомпоновщикНастроек.Настройки, "МакетОформления");
	СписокМакетовОформления = СтандартныеОтчетыПовтИсп.ПолучитьСписокМакетовОформления();
	Для Каждого ЭлементСписка Из СписокМакетовОформления Цикл
		Форма.Элементы.МакетОформления.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	Если ПараметрМакетОформления.Использование И Не ПустаяСтрока(ПараметрМакетОформления.Значение) Тогда
		Форма.МакетОформления = ПараметрМакетОформления.Значение;
	КонецЕсли;
	
	Форма.Элементы.ПанельНастроек.Пометка = Форма.Элементы.ГруппаПанельНастроек.Видимость;
	
	// Для управления варинтами настроки СКД
	ВариантНастройки = Форма.Элементы.Найти("ВариантНастройки");
	Если ВариантНастройки <> Неопределено тогда
		Для каждого ВариантНастройкиСКД из ОтчетОбъект.СхемаКомпоновкиДанных.ВариантыНастроек цикл
			ВариантНастройки.СписокВыбора.Добавить(ВариантНастройкиСКД.Имя,НСтр("ru='"+ВариантНастройкиСКД.Представление+"'"));
		КонецЦикла;
		Форма.ПользовательскийВариантНастроек = "Пользовательский";
		ВариантНастройки.СписокВыбора.Добавить(Форма.ПользовательскийВариантНастроек,НСтр("ru='Пользовательский'"));
	КонецЕсли;	
	// Конец для управления варинтами настроки СКД
	
	Если Отчет.РежимРасшифровки Тогда
		СтандартнаяОбработка = Ложь;
		Форма.ВыводитьЗаголовок = Истина;
		Форма.ВыводитьПодвал = Истина;
		Попытка
			Форма.ИзменениеСхемыКомпоновкиДанных();
		Исключение
		КонецПопытки;
		Если Параметры.Свойство("ЗаполняемыеНастройки") Тогда
			Форма.ЗаполнитьНастройкамиПоУмолчанию(Параметры.ЗаполняемыеНастройки);
		КонецЕсли;
		Форма.СформироватьОтчетСервер();
	Иначе
		УстановитьНастройкиПоУмолчанию(Форма);
		Если НЕ ЗначениеЗаполнено(Отчет.Организация) Тогда
			Отчет.Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
		КонецЕсли;
		Форма.ВыводитьЗаголовок = Истина;
		Форма.ВыводитьПодвал = Истина;
	КонецЕсли;
	
	// Заполняю флаги учета по функциональным опциям
	Попытка
		Форма.ФОУчетПоИФО 				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
		Форма.ФОВалютныйУчет 			= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
		Форма.ФОУчетПоПодразделениям 	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	Исключение
	КонецПопытки;
	
	РегистрыУчета.ПриСозданииНаСервере(Форма, ГруппаДополнительныхКоманд);

КонецПроцедуры

Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	СвойстваРегистраУчета.Вставить("Организация", 	ОтчетОбъект.Организация);
	СвойстваРегистраУчета.Вставить("НачалоПериода", ОтчетОбъект.НачалоПериода);
	СвойстваРегистраУчета.Вставить("КонецПериода", 	ОтчетОбъект.КонецПериода);
	СвойстваРегистраУчета.Вставить("ДополнениеИмени", "");	
	
	ОтчетОбъект.Свойство("Подразделение",						СвойстваРегистраУчета.ПодразделениеОрганизации);
	ОтчетОбъект.Свойство("ВключатьОбособленныеПодразделения",	СвойстваРегистраУчета.ВключатьОбособленныеПодразделения);
	
		
КонецПроцедуры	

Процедура ДобавитьИзмеренияВГруппировки(КонтролГруппировки, ИмяПоля = "Поле") Экспорт
    
    // ДобавитьГруппировкуЕПСБУ(КонтролГруппировки, "Счет", "Счет", Истина);
	ДобавитьГруппировкуЕПСБУ(КонтролГруппировки, "КФО",, Ложь,, ИмяПоля);
	ДобавитьГруппировкуЕПСБУ(КонтролГруппировки, "КПС",, Ложь,, ИмяПоля);
	ДобавитьГруппировкуЕПСБУ(КонтролГруппировки, "КЭК",, Ложь,, ИмяПоля);
    Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
	    ДобавитьГруппировкуЕПСБУ(КонтролГруппировки, "Подразделение",, Ложь,, ИмяПоля);
    КонецЕсли;
    Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
        ДобавитьГруппировкуЕПСБУ(КонтролГруппировки, "Валюта",, Ложь,, ИмяПоля);
    КонецЕсли;
    Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
	    ДобавитьГруппировкуЕПСБУ(КонтролГруппировки, "ИФО",, Ложь,, ИмяПоля);
    КонецЕсли;
	ДобавитьГруппировкуЕПСБУ(КонтролГруппировки, "Организация",, Ложь,, ИмяПоля);
    
КонецПроцедуры
 

///////////////////////////////////////////////////////////////////////////////
//  ФУНКЦИИ И ПРОЦЕДУРЫ РАСШИФРОВКИ ОТЧЕТОВ ПО САНКЦИОНИРОВАНИЮ И ПЛАНУ ФХД

//   Формирует выпадающие меню для выбора вида расшифровки
//		ПоказательСчет	- тип Струкутра	созданная в модуле отчета
//		Расшифровка		- 
//		Адрес			- тип строка адрес харнилища

Функция ПолучитьСписокДополнительнойРасшифровки(ДанныеОтчета, Адрес, Расшифровка, ПоказательСчет, АдресПараметровДляСтандартныхОтчетов) Экспорт
	
	СписокОтчетов 					= Новый СписокЗначений;
	
	Если ТипЗнч(ПоказательСчет) <> Тип("Структура") тогда
		
		Возврат СписокОтчетов;
		
	КонецЕсли;	
	
	ДанныеРасшифровки 				= ПолучитьИзВременногоХранилища(Адрес);
	
	
	ПараметрыДляСтандартныхОтчетов 	= Новый Структура;
	
	
	МассивПолей = ПолучитьМассивПолейРасшифровки(Расшифровка, ДанныеРасшифровки, , Истина);
	
	Для каждого Поле из МассивПолей цикл
		Если ТипЗнч(Поле) <> Тип("ЗначениеПоляРасшифровкиКомпоновкиДанных") тогда
			Продолжить;
		КонецЕсли;	
		ЭлементМеню = Неопределено;
		Если СтрНайти(Поле.Поле,".") = 0 И ПоказательСчет.Свойство(Поле.Поле,ЭлементМеню) тогда
			ИндексПоля = 0;
			Для каждого Элемент из ЭлементМеню цикл
				Счет 	= Элемент.Значение.Счет;
				КорСчет = Элемент.Значение.КорСчет;
				
				Если НЕ ЗначениеЗаполнено(Счет) Тогда
					Счет = ОпределитьСчетИзМассиваПолей(МассивПолей, Счет);
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(Счет) Тогда
					Продолжить;
				КонецЕсли;
				
				ОписаниеМеню						  = НСтр("ru = 'Счет %Счет% %КорСчет%'");
				ПредставлениеДляОСВПоСчету            = НСтр("ru = 'ОСВ по счету %Счет%'");
				ПредставлениеДляКарточкиСчета         = НСтр("ru = 'Карточка счета %Счет%'");
				ПредставлениеОборотыСчета             = НСтр("ru = 'Обороты счета %Счет%'");
				ПредставлениеДляАнализаСчета          = НСтр("ru = 'Анализ счета %Счет% %КорСчет%'");				
				
				ПредставлениеДляОСВПоСчету			= СтрЗаменить(ПредставлениеДляОСВПоСчету		, "%Счет%",		Счет);
				ПредставлениеДляКарточкиСчета       = СтрЗаменить(ПредставлениеДляКарточкиСчета     , "%Счет%", 	Счет);
				ПредставлениеОборотыСчета		    = СтрЗаменить(ПредставлениеОборотыСчета	        , "%Счет%", 	Счет);
				ПредставлениеДляАнализаСчета        = СтрЗаменить(ПредставлениеДляАнализаСчета      , "%Счет%", 	Счет);
				
				
				ОписаниеМеню						= СтрЗаменить(ОписаниеМеню						, "%Счет%", 	Счет);
				Если ЗначениеЗаполнено(КорСчет) тогда
					ПредставлениеДляАнализаСчета        = СтрЗаменить(ПредставлениеДляАнализаСчета      , "%КорСчет%", 	"кор. счет "+КорСчет);
					ОписаниеМеню						= СтрЗаменить(ОписаниеМеню						, "%КорСчет%", 	" и кор. счет "+КорСчет);
				Иначе
					ПредставлениеДляАнализаСчета        = СтрЗаменить(ПредставлениеДляАнализаСчета      , "%КорСчет%", 	"");
					ОписаниеМеню						= СтрЗаменить(ОписаниеМеню						, "%КорСчет%", 	"");
				КонецЕсли;	
				
				
				ИндексПоля = ИндексПоля + 1;
				ПодМеню = Новый СписокЗначений;
				ПодМеню.Добавить("ОборотноСальдоваяВедомостьПоСчету_"+ИндексПоля,ПредставлениеДляОСВПоСчету); 		
				ПараметрыДляСтандартныхОтчетов.Вставить("ОборотноСальдоваяВедомостьПоСчету_"+ИндексПоля,ПолучитьНастройкиДляДополнительнойРасшифровки("ОборотноСальдоваяВедомостьПоСчету", МассивПолей, ДанныеОтчета, Счет, КорСчет));
				ПодМеню.Добавить("КарточкаСчета_"+ИндексПоля,ПредставлениеДляКарточкиСчета); 		
				ПараметрыДляСтандартныхОтчетов.Вставить("КарточкаСчета_"+ИндексПоля,ПолучитьНастройкиДляДополнительнойРасшифровки("КарточкаСчета", МассивПолей, ДанныеОтчета, Счет, КорСчет));
				ПодМеню.Добавить("ОборотыСчета_"+ИндексПоля,ПредставлениеОборотыСчета);
				ПараметрыДляСтандартныхОтчетов.Вставить("ОборотыСчета_"+ИндексПоля,ПолучитьНастройкиДляДополнительнойРасшифровки("ОборотыСчета", МассивПолей, ДанныеОтчета, Счет, КорСчет));
				ПодМеню.Добавить("АнализСчета_"+ИндексПоля,ПредставлениеДляАнализаСчета);
				ПараметрыДляСтандартныхОтчетов.Вставить("АнализСчета_"+ИндексПоля,ПолучитьНастройкиДляДополнительнойРасшифровки("АнализСчета", МассивПолей, ДанныеОтчета, Счет, КорСчет));
				СписокОтчетов.Добавить(ПодМеню,ОписаниеМеню);
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;	
	
	ДанныеОбъекта = Новый Структура;
	
	ДанныеОбъекта.Вставить("НастройкиРасшифровки",ПараметрыДляСтандартныхОтчетов);
	АдресПараметровДляСтандартныхОтчетов = ПоместитьВоВременноеХранилище(ДанныеОбъекта);
	
	
	Возврат СписокОтчетов;
КонецФункции

//		Устанавливает соответствие между счетами и показателями, т.к. есть суммируемые обороты
//		для получения подробной рассшифровки показателя
//		ПоказательСчет	- тип Структура  данные о соответствии показателя и счетов, которая передается и дополянется
//		Показатель		- строка название показателя
//		Кодсчета		- строка код счета
//		КодКорСчета		- строка код корреспондирующего счета
//		НаДату			- Дата - дата, на которую необходимо получить актуальный счет.
//  	Организация		- СправочникСсылка.Организации - организация, для которой определяется счет
Процедура УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет, Показатель, КодСчета,
	КодКорСчета = Неопределено, НаДату = Неопределено, Организация = Неопределено) Экспорт
	
	Если ТипЗнч(КодСчета) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		Счет = КодСчета;
	Иначе
		Счет = БухгалтерскийУчет.СчетПоКоду(КодСчета, НаДату, Организация);
	КонецЕсли;
	
	Если ТипЗнч(КодКорСчета) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		КорСчет = КодКорСчета;
	Иначе
		КорСчет = БухгалтерскийУчет.СчетПоКоду(КодКорСчета, НаДату, Организация);
	КонецЕсли;
	
	ЗначениеПоказателя = Неопределено;
	Если ПоказательСчет.Свойство(Показатель,ЗначениеПоказателя) Тогда
		Если ТипЗнч(ЗначениеПоказателя) = Тип("СписокЗначений") Тогда
			Добавлять = Истина;
			Для Каждого СчетКорСчет Из ЗначениеПоказателя Цикл
				Если СчетКорСчет.Значение.Счет = Счет и СчетКорСчет.Значение.КорСчет = КорСчет Тогда
					Добавлять = Ложь;
				КонецЕсли;
			КонецЦикла;
			Если Добавлять Тогда
				ЗначениеПоказателя.Добавить(УстановитьСчета(Счет,КорСчет));
			КонецЕсли;
		КонецЕсли;
	Иначе
		НовыйСписок = Новый СписокЗначений;
		НовыйСписок.Добавить(УстановитьСчета(Счет,КорСчет));
		ПоказательСчет.Вставить(Показатель,НовыйСписок);
	КонецЕсли;
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
//  ФУНКЦИИ И ПРОЦЕДУРЫ ФОРМЫ ОТЧЕТОВ ДЛЯ ПРЕДОПРЕДЕЛЕННЫХ НАСТРОЕК

Процедура УстановитьТиповуюНастройку(Форма,ВариантНастройки = неопределено) экспорт
	Отчет     = Форма.Отчет;
	СхемаКомпоновкиДанных = неопределено;
	Если Не ЗначениеЗаполнено(Форма.СхемаКомпоновкиДанных) Тогда
		ОтчетОбъект = Форма.РеквизитФормыВЗначение("Отчет");
		СхемаКомпоновкиДанных = ОтчетОбъект.СхемаКомпоновкиДанных;
	Иначе
		Если ЭтоАдресВременногоХранилища(Форма.СхемаКомпоновкиДанных) Тогда
			СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(Форма.СхемаКомпоновкиДанных);
		КонецЕсли;
	КонецЕсли;
	
	Если СхемаКомпоновкиДанных <> неопределено и ВариантНастройки = неопределено тогда
		Настройки =	СхемаКомпоновкиДанных.ВариантыНастроек[0].Настройки;
		Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
		Отчет.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(Отчет.КомпоновщикНастроек.ПользовательскиеНастройки);	
		Отчет.ВариантНастройки = СхемаКомпоновкиДанных.ВариантыНастроек[0].Имя;
	КонецЕсли;	
	
	Если СхемаКомпоновкиДанных <> неопределено и ВариантНастройки <> неопределено тогда
		Настройки =	СхемаКомпоновкиДанных.ВариантыНастроек[ВариантНастройки].Настройки;
		Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
		Отчет.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(Отчет.КомпоновщикНастроек.ПользовательскиеНастройки);	
	КонецЕсли;	
	
КонецПРоцедуры	

// Синхронизирует отборы установленные в форме отчета (Отчет.КомпоновщикНастроек.Настройки.Отбор) с пользовательскими настройками если они есть
// Устанавливает или удалает организацию в "Быстрых отборах" по данным обычного отбора.
//	Парметры: 
//		- КомпоновщикНастроек - Отчет.КомпоновщикНастроек
//		- НазваниеПоляСКДОрганизация - строка, название поля компоновки данных "Организация", нужно для миграции отчетов БГУ1 <--> БГУ2
	
Функция УстановитьЗначениеОтбора(КомпоновщикНастроек,НазваниеПоляСКД) экспорт
	ВыбранноеЗначение = "";
	Для каждого ЭлементОтбора из КомпоновщикНастроек.Настройки.Отбор.Элементы цикл
		Для Каждого ЭлементНастройки Из КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл	
			Если ЭлементНастройки.ИдентификаторПользовательскойНастройки = ЭлементОтбора.ИдентификаторПользовательскойНастройки Тогда
				ЭлементНастройки.ЛевоеЗначение = ЭлементОтбора.ЛевоеЗначение;
				ЭлементНастройки.Использование = ЭлементОтбора.Использование;
				ЭлементНастройки.ПравоеЗначение = ЭлементОтбора.ПравоеЗначение;
				ЭлементНастройки.ВидСравнения   = ЭлементОтбора.ВидСравнения;
			КонецЕсли;
		КонецЦикла;
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") тогда							
			Продолжить;
		КонецЕсли;	
		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(НазваниеПоляСКД) тогда
			Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СписокЗначений") тогда
				ВыбранноеЗначение = "";
			Иначе	
				ВыбранноеЗначение = ЭлементОтбора.ПравоеЗначение;
			КонецЕсли;	
			Если не ЭлементОтбора.Использование тогда
				ВыбранноеЗначение = "";
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	Возврат ВыбранноеЗначение;
КонецФункции

//  Проверка установки функциональных опций ИФО и Подразделение
Процедура СинхронизироватьПоляОтбораСоСпискомДоступныхПолей(КомпоновщикНастроек) Экспорт
	
	СинхронизироватьПоляОтбораСоСпискомДоступныхПолейРекурсивнаяЧасть(
		КомпоновщикНастроек.Настройки.Отбор, КомпоновщикНастроек.Настройки.Отбор.Элементы);
	
КонецПРоцедуры

// Механизм связи полей шапки и отбора

// Параметры:
//	Форма						- УправляемаяФорма	- форма отчета;
//	ПереданныйМассивСтрокСвязи	- Структура	- описание одной строки связи;
//								- Массив	- описания нескольких строк связи.
//								Допускается указывать несколько строк связи (Массив),
//								в том числе с различными режимами работы;
//		Каждое описание строки связи должно содержать поля:
//		Обязательные поля, независимо от выбранного режима работы строки связи:
//			* РежимСвязи						- Строка	-  одна из строк "ПоВсем" или "ИндикаторСвязи"
//			* ШапкаИмяЭлементаПоля				- Строка	- 
//			* ОтборИмяЭлементаТаблицы			- Строка	- 
//			* ОтборИмяПоля						- Строка	- 
//		Опциональные поля:
//			* ШапкаИменаФункциональныхОпций		- Строка	- (опц) имя функциональной опции (или нескольких, через запятую),
//												к которой привязано поле шапки.
//												Если функц.опция отключена, то связь для поля не создается.
//												По умолчанию="";
// 		Режим "ПоВсем":
//			* ШапкаИмяЭлементаФлажкаПоВсем		- Строка	- 
//			* ОтборКомментарийПоВсемПолный		- Строка	- (опц) по умолчанию="по всем <ШапкаИмяЭлементаПоля>"
//			* ОтборКомментарийПоВсемКороткий	- Строка	- (опц) по умолчанию="всем <ШапкаИмяЭлементаПоля>"
//			* ОтборКомментарийПоОдномуПолный	- Строка	- (опц) по умолчанию="по одному <ШапкаИмяЭлементаПоля>"
//			* ОтборКомментарийПоОдномуКороткий	- Строка	- (опц) по умолчанию="одному <ШапкаИмяЭлементаПоля>"
//
// 		Режим "ИндикаторСвязи":
//			* ШапкаИмяЗаполняемойГруппыФормы	- Строка	- (опц) по умолчанию=группа-родитель поля шапки
//			* ИспользоватьФлажокВместоЗамка		- Булево	- (опц) по умолчанию=Ложь
//			* ВыводитьНадписьПомимоЗамка		- Булево	- (опц) по умолчанию=Истина
//			* УстанавливатьСвязьПриИзмененииПоля- Булево	- (опц) по умолчанию=Истина
//
// Возвращаемое значение:
//	ВозвратИменаСохраняемыхРеквизитовФормы	- Строка	- (опц)
//	ИменаСозданныхРеквизитовФормы			- Структура	- 
Процедура СвязьПолейШапкиИОтбора_ПриСозданииНаСервере(Форма, ПереданныйМассивСтрокСвязи,
	ВозвратИменаСохраняемыхРеквизитовФормы=Неопределено,
	ИменаСозданныхРеквизитовФормы=Неопределено) Экспорт
	
	Перем	МассивСтрокСвязи,
			МассивЗанятыхИменРеквизитовФормы,
			МассивЗанятыхИменЭлементовФормы,
			ДобавляемыеРеквизиты;
	
	// Запоминаем имена созданных реквизитов формы:
	ИменаСозданныхРеквизитовФормы = Новый Структура();
	
	// Микро входная проверка:
	Если ТипЗнч(ПереданныйМассивСтрокСвязи) = Тип("Структура") Тогда
		МассивСтрокСвязи = Новый Массив();
		МассивСтрокСвязи.Добавить(ПереданныйМассивСтрокСвязи);
	ИначеЕсли ТипЗнч(ПереданныйМассивСтрокСвязи) = Тип("Массив") Тогда
		МассивСтрокСвязи = ПереданныйМассивСтрокСвязи;
	Иначе
		// Выходим:
		Возврат;
	КонецЕсли;
	Если ВозвратИменаСохраняемыхРеквизитовФормы = Неопределено Тогда
		ВозвратИменаСохраняемыхРеквизитовФормы = "";
	ИначеЕсли НЕ ТипЗнч(ВозвратИменаСохраняемыхРеквизитовФормы) = Тип("Строка") Тогда
		// Выходим:
		Возврат;
	КонецЕсли;
	
	// Создаем колонки таблицы связи:
	ТаблицаСвязи = Новый ТаблицаЗначений();
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипШапкаЗначениеПоля = Новый ОписаниеТипов();
	ТаблицаСвязи.Колонки.Добавить("ШапкаИмяЭлементаПоля",						ТипСтрока);
	ТаблицаСвязи.Колонки.Добавить("ОтборИмяПоля",								ТипСтрока);
	ТаблицаСвязи.Колонки.Добавить("ОтборИмяЭлементаТаблицы",					ТипСтрока);
	ТаблицаСвязи.Колонки.Добавить("ИспользоватьРежимИндикаторСвязи",			ТипБулево); // Режим ИндикаторСвязи
	ТаблицаСвязи.Колонки.Добавить("ШапкаПутьКДаннымПоля",						ТипСтрока);
	ТаблицаСвязи.Колонки.Добавить("ШапкаПутьКДаннымФлажкаИндикаторСвязи",		ТипСтрока); // Режим ИндикаторСвязи
	ТаблицаСвязи.Колонки.Добавить("ШапкаПутьКДаннымФлажкаПоВсем",				ТипСтрока); // Режим ПоВсем
	ТаблицаСвязи.Колонки.Добавить("ШапкаЗначениеПоля",							ТипШапкаЗначениеПоля);
	ТаблицаСвязи.Колонки.Добавить("ШапкаЗначениеФлажкаИндикаторСвязи",			ТипБулево); // Режим ИндикаторСвязи
	ТаблицаСвязи.Колонки.Добавить("ШапкаЗначениеФлажкаПоВсем",					ТипБулево); // Режим ПоВсем
	ТаблицаСвязи.Колонки.Добавить("ШапкаИмяЭлементаСтраницы",					ТипСтрока); // Режим ИндикаторСвязи
	ТаблицаСвязи.Колонки.Добавить("ШапкаИмяЭлементаСтраницаСвязьУстановлена",	ТипСтрока); // Режим ИндикаторСвязи
	ТаблицаСвязи.Колонки.Добавить("ШапкаИмяЭлементаСтраницаСвязьНеУстановлена",	ТипСтрока); // Режим ИндикаторСвязи
	ТаблицаСвязи.Колонки.Добавить("ШапкаИмяЭлементаФлажокСвязьУстановлена",		ТипСтрока); // Режим ИндикаторСвязи
	ТаблицаСвязи.Колонки.Добавить("ШапкаИмяЭлементаФлажокСвязьНеУстановлена",	ТипСтрока); // Режим ИндикаторСвязи
	ТаблицаСвязи.Колонки.Добавить("ШапкаИмяЭлементаКартинкаСвязьУстановлена",	ТипСтрока); // Режим ИндикаторСвязи
	ТаблицаСвязи.Колонки.Добавить("ШапкаИмяЭлементаКартинкаСвязьНеУстановлена",	ТипСтрока); // Режим ИндикаторСвязи
	ТаблицаСвязи.Колонки.Добавить("УстанавливатьСвязьПриИзмененииПоля",			ТипБулево); // Режим ИндикаторСвязи ***
	ТаблицаСвязи.Колонки.Добавить("ИспользоватьРежимПоВсем",					ТипБулево); // Режим ПоВсем
	ТаблицаСвязи.Колонки.Добавить("ШапкаИмяЭлементаФлажокПоВсем",				ТипСтрока); // Режим ПоВсем
	ТаблицаСвязи.Колонки.Добавить("ОтборКомментарийПоВсемПолный",				ТипСтрока); // Режим ПоВсем
	ТаблицаСвязи.Колонки.Добавить("ОтборКомментарийПоВсемКороткий",				ТипСтрока); // Режим ПоВсем
	ТаблицаСвязи.Колонки.Добавить("ОтборКомментарийПоОдномуПолный",				ТипСтрока); // Режим ПоВсем
	ТаблицаСвязи.Колонки.Добавить("ОтборКомментарийПоОдномуКороткий",			ТипСтрока); // Режим ПоВсем
	// Колонки, необходимые только на время заполнения таблицы:
	ТаблицаСвязи.Колонки.Добавить("ШапкаИмяЗаполняемойГруппыФормы",				ТипСтрока); // Режим ИндикаторСвязи
	ТаблицаСвязи.Колонки.Добавить("ИспользоватьФлажокВместоЗамка",				ТипБулево); // Режим ИндикаторСвязи
	ТаблицаСвязи.Колонки.Добавить("ВыводитьНадписьПомимоЗамка",					ТипБулево); // Режим ИндикаторСвязи
	СлужебныеКолонки = Новый Структура("
		|ШапкаИмяЗаполняемойГруппыФормы,
		|ИспользоватьФлажокВместоЗамка,
		|ВыводитьНадписьПомимоЗамка");
		
	ПрефиксНазванияМеханизма = СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_ПолучитьПрефиксНазванияМеханизма();
	ДобавляемыеРеквизиты = Новый Массив();
	МассивИменЭлементовТаблицаОтбор = Новый Массив();
	МассивЗанятыхИменРеквизитовФормы	= СвязьПолейШапкиИОтбора_ПолучитьИменаРеквизитовФормы(Форма);
	Элементы = Форма.Элементы;
	
	// Итоговые переменные для всей таблицы:
	ИтогоИспользоватьРежимПоВсем			= Ложь;
	ИтогоИспользоватьРежимИндикаторСвязи	= Ложь;
	
	// Заполняем таблицу связи:
	Для Каждого СтрокаСвязи Из МассивСтрокСвязи Цикл
		// Входная проверка:
		Если ТипЗнч(СтрокаСвязи) = Тип("Структура") Тогда
			// Обязательные поля (4 шт):
			ШапкаИмяЭлементаПоля			= Неопределено;
			ОтборИмяЭлементаТаблицы			= Неопределено;
			ОтборИмяПоля					= Неопределено;
			РежимСвязи						= Неопределено;
			
			ИспользоватьРежимПоВсем			= Неопределено;
			ИспользоватьРежимИндикаторСвязи	= Неопределено;
			ОбозначениеРежимаПоВсем			= "ПоВсем";
			ОбозначениеРежимаИндикаторСвязи	= "ИндикаторСвязи";
			
			Если СтрокаСвязи.Свойство("ШапкаИмяЭлементаПоля", ШапкаИмяЭлементаПоля) Тогда
				Если ТипЗнч(ШапкаИмяЭлементаПоля) = Тип("Строка") Тогда
					Если ПустаяСтрока(ШапкаИмяЭлементаПоля) Тогда
						Продолжить;
					КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
			Если СтрокаСвязи.Свойство("ОтборИмяЭлементаТаблицы", ОтборИмяЭлементаТаблицы) Тогда
				Если ТипЗнч(ОтборИмяЭлементаТаблицы) = Тип("Строка") Тогда
					Если ПустаяСтрока(ОтборИмяЭлементаТаблицы) Тогда
						Продолжить;
					КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
			Если СтрокаСвязи.Свойство("ОтборИмяПоля", ОтборИмяПоля) Тогда
				Если ТипЗнч(ОтборИмяПоля) = Тип("Строка") Тогда
					Если ПустаяСтрока(ОтборИмяПоля) Тогда
						Продолжить;
					КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
			
			// Определим режим работы текущей связи:
			Если СтрокаСвязи.Свойство("РежимСвязи", РежимСвязи) Тогда
				Если ТипЗнч(РежимСвязи) = Тип("Строка") Тогда
					ИспользоватьРежимПоВсем			= (ВРег(РежимСвязи) = ВРег(ОбозначениеРежимаПоВсем));
					ИспользоватьРежимИндикаторСвязи	= (ВРег(РежимСвязи) = ВРег(ОбозначениеРежимаИндикаторСвязи));
					Если	НЕ ИспользоватьРежимПоВсем
						И	НЕ ИспользоватьРежимИндикаторСвязи Тогда
						Продолжить;
					КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
			
			// Опциональные поля:
			ШапкаИмяЗаполняемойГруппыФормы		= Неопределено;
			ИспользоватьФлажокВместоЗамка		= Неопределено;
			ВыводитьНадписьПомимоЗамка			= Неопределено;
			УстанавливатьСвязьПриИзмененииПоля	= Неопределено;
			ШапкаИмяЭлементаФлажкаПоВсем		= Неопределено;
			ШапкаПутьКДаннымФлажкаПоВсем		= Неопределено;
			ШапкаИменаФункциональныхОпций		= Неопределено;
			ОтборКомментарийПоВсемПолный		= Неопределено;
			ОтборКомментарийПоВсемКороткий		= Неопределено;
			ОтборКомментарийПоОдномуПолный		= Неопределено;
			ОтборКомментарийПоОдномуКороткий	= Неопределено;
			
			// Не будем использовать эту строку связи, если поле зависит от функциональных опций,
			// отключенных в настоящий момент времени:
			ИспользоватьСтрокуСвязи = Истина;
			Если СтрокаСвязи.Свойство("ШапкаИменаФункциональныхОпций", ШапкаИменаФункциональныхОпций) Тогда
				Если ТипЗнч(ШапкаИменаФункциональныхОпций) = Тип("Строка") Тогда
					Если ЗначениеЗаполнено(ШапкаИменаФункциональныхОпций) Тогда
						ИменаФО = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ШапкаИменаФункциональныхОпций);
						Для Каждого ИмяФО Из ИменаФО Цикл
							Попытка
								Если НЕ ПолучитьФункциональнуюОпцию(ИмяФО) Тогда
									ИспользоватьСтрокуСвязи = Ложь;
									Прервать;
								КонецЕсли;
							Исключение
							КонецПопытки;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Если НЕ ИспользоватьСтрокуСвязи Тогда
				Продолжить;
			КонецЕсли;
			
			Если ИспользоватьРежимИндикаторСвязи Тогда
				ИспользоватьЗначениеПоУмолчанию = Ложь;
				Если СтрокаСвязи.Свойство("ШапкаИмяЗаполняемойГруппыФормы", ШапкаИмяЗаполняемойГруппыФормы) Тогда
					Если ТипЗнч(ШапкаИмяЗаполняемойГруппыФормы) = Тип("Строка") Тогда
						Если ПустаяСтрока(ШапкаИмяЗаполняемойГруппыФормы) Тогда
							ИспользоватьЗначениеПоУмолчанию = Истина;
						КонецЕсли;
					Иначе
						ИспользоватьЗначениеПоУмолчанию = Истина;
					КонецЕсли;
				Иначе
					ИспользоватьЗначениеПоУмолчанию = Истина;
				КонецЕсли;
				Если ИспользоватьЗначениеПоУмолчанию Тогда
					ШапкаИмяЗаполняемойГруппыФормы = ""; // Значение по умолчанию
					СтрокаСвязи.Вставить("ШапкаИмяЗаполняемойГруппыФормы", ШапкаИмяЗаполняемойГруппыФормы);
				КонецЕсли;
				
				ИспользоватьЗначениеПоУмолчанию = Ложь;
				Если СтрокаСвязи.Свойство("ИспользоватьФлажокВместоЗамка", ИспользоватьФлажокВместоЗамка) Тогда
					Если НЕ ТипЗнч(ИспользоватьФлажокВместоЗамка) = Тип("Булево") Тогда
						ИспользоватьЗначениеПоУмолчанию = Истина;
					КонецЕсли;
				Иначе
					ИспользоватьЗначениеПоУмолчанию = Истина;
				КонецЕсли;
				Если ИспользоватьЗначениеПоУмолчанию Тогда
					ИспользоватьФлажокВместоЗамка = Ложь; // Значение по умолчанию
					СтрокаСвязи.Вставить("ИспользоватьФлажокВместоЗамка", ИспользоватьФлажокВместоЗамка);
				КонецЕсли;
				
				ИспользоватьЗначениеПоУмолчанию = Ложь;
				Если СтрокаСвязи.Свойство("ВыводитьНадписьПомимоЗамка", ВыводитьНадписьПомимоЗамка) Тогда
					Если НЕ ТипЗнч(ВыводитьНадписьПомимоЗамка) = Тип("Булево") Тогда
						ИспользоватьЗначениеПоУмолчанию = Истина;
					КонецЕсли;
				Иначе
					ИспользоватьЗначениеПоУмолчанию = Истина;
				КонецЕсли;
				Если ИспользоватьЗначениеПоУмолчанию Тогда
					ВыводитьНадписьПомимоЗамка = Истина; // Значение по умолчанию
					СтрокаСвязи.Вставить("ВыводитьНадписьПомимоЗамка", ВыводитьНадписьПомимоЗамка);
				КонецЕсли;
				
				ИспользоватьЗначениеПоУмолчанию = Ложь;
				Если СтрокаСвязи.Свойство("УстанавливатьСвязьПриИзмененииПоля", УстанавливатьСвязьПриИзмененииПоля) Тогда
					Если НЕ ТипЗнч(УстанавливатьСвязьПриИзмененииПоля) = Тип("Булево") Тогда
						ИспользоватьЗначениеПоУмолчанию = Истина;
					КонецЕсли;
				Иначе
					ИспользоватьЗначениеПоУмолчанию = Истина;
				КонецЕсли;
				Если ИспользоватьЗначениеПоУмолчанию Тогда
					УстанавливатьСвязьПриИзмененииПоля = Истина; // Значение по умолчанию
					СтрокаСвязи.Вставить("УстанавливатьСвязьПриИзмененииПоля", УстанавливатьСвязьПриИзмененииПоля);
				КонецЕсли;
			КонецЕсли;
			
			Если ИспользоватьРежимПоВсем Тогда
				Если СтрокаСвязи.Свойство("ШапкаИмяЭлементаФлажкаПоВсем", ШапкаИмяЭлементаФлажкаПоВсем) Тогда
					Если ТипЗнч(ШапкаИмяЭлементаФлажкаПоВсем) = Тип("Строка") Тогда
						Если ПустаяСтрока(ШапкаИмяЭлементаФлажкаПоВсем) Тогда
							Продолжить;
						Иначе
							Попытка
								ШапкаПутьКДаннымФлажкаПоВсем = Элементы[ШапкаИмяЭлементаФлажкаПоВсем].ПутьКДанным;
							Исключение
								Продолжить;
							КонецПопытки;
						КонецЕсли;
					Иначе
						Продолжить;
					КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
				
				Если СтрокаСвязи.Свойство("ОтборКомментарийПоВсемПолный", ОтборКомментарийПоВсемПолный) Тогда
					Если НЕ ТипЗнч(ОтборКомментарийПоВсемПолный) = Тип("Строка") Тогда
						ОтборКомментарийПоВсемПолный = "";
					КонецЕсли;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ОтборКомментарийПоВсемПолный) Тогда
					ОтборКомментарийПоВсемПолный = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='по всем %1'"), ШапкаИмяЭлементаПоля); // Значение по умолчанию
				КонецЕсли;
					
				Если СтрокаСвязи.Свойство("ОтборКомментарийПоВсемКороткий", ОтборКомментарийПоВсемКороткий) Тогда
					Если НЕ ТипЗнч(ОтборКомментарийПоВсемКороткий) = Тип("Строка") Тогда
						ОтборКомментарийПоВсемКороткий = "";
					КонецЕсли;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ОтборКомментарийПоВсемКороткий) Тогда
					ОтборКомментарийПоВсемКороткий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='всем %1'"), ШапкаИмяЭлементаПоля); // Значение по умолчанию
				КонецЕсли;
				
				Если СтрокаСвязи.Свойство("ОтборКомментарийПоОдномуПолный", ОтборКомментарийПоОдномуПолный) Тогда
					Если НЕ ТипЗнч(ОтборКомментарийПоОдномуПолный) = Тип("Строка") Тогда
						ОтборКомментарийПоОдномуПолный = "";
					КонецЕсли;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ОтборКомментарийПоОдномуПолный) Тогда
					ОтборКомментарийПоОдномуПолный = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='по одному %1'"), ШапкаИмяЭлементаПоля); // Значение по умолчанию:
				КонецЕсли;
				
				Если СтрокаСвязи.Свойство("ОтборКомментарийПоОдномуКороткий", ОтборКомментарийПоОдномуКороткий) Тогда
					Если НЕ ТипЗнч(ОтборКомментарийПоОдномуКороткий) = Тип("Строка") Тогда
						ОтборКомментарийПоОдномуКороткий = "";
					КонецЕсли;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ОтборКомментарийПоОдномуКороткий) Тогда
					ОтборКомментарийПоОдномуКороткий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='одному %1'"), ШапкаИмяЭлементаПоля); // Значение по умолчанию:
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		// Подключаем обработчики событий.
		// Таблица отбора:
		Если МассивИменЭлементовТаблицаОтбор.Найти(ОтборИмяЭлементаТаблицы) = Неопределено Тогда
			МассивИменЭлементовТаблицаОтбор.Добавить(ОтборИмяЭлементаТаблицы);
			Попытка
				Элементы[ОтборИмяЭлементаТаблицы].УстановитьДействие("ПриНачалеРедактирования",		"Подключаемый_СвязьПолейШапкиИОтбора_ПриНачалеРедактированияСтрокиОтбора");
				Элементы[ОтборИмяЭлементаТаблицы].УстановитьДействие("ПриОкончанииРедактирования",	"Подключаемый_СвязьПолейШапкиИОтбора_ПриОкончанииРедактированияСтрокиОтбора");
				Элементы[ОтборИмяЭлементаТаблицы].УстановитьДействие("ПослеУдаления",				"Подключаемый_СвязьПолейШапкиИОтбора_ПослеУдаленияСтрокиОтбора");
				Элементы[ОтборИмяЭлементаТаблицы].УстановитьДействие("ОкончаниеПеретаскивания",		"Подключаемый_СвязьПолейШапкиИОтбора_ПослеУдаленияСтрокиОтбора");
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЕсли;
		Попытка
			// Поле шапки:
			Элементы[ШапкаИмяЭлементаПоля].УстановитьДействие("ПриИзменении", "Подключаемый_СвязьПолейШапкиИОтбора_ПриИзмененииПоляШапки");
			ШапкаПутьКДаннымПоля = Форма.Элементы[ШапкаИмяЭлементаПоля].ПутьКДанным;
			
			Если ИспользоватьРежимПоВсем Тогда
				// Флажок "По всем":
				Элементы[ШапкаИмяЭлементаФлажкаПоВсем].УстановитьДействие("ПриИзменении", "Подключаемый_СвязьПолейШапкиИОтбора_ПриИзмененииФлажкаПоВсем");
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
		
		// Проверка.
		// Исключаем возможные дубли строк:
		ПоискДублей = Новый Структура(
			"ШапкаПутьКДаннымПоля, ОтборИмяПоля, ШапкаПутьКДаннымФлажкаПоВсем",
			ШапкаПутьКДаннымПоля, ОтборИмяПоля, ШапкаПутьКДаннымФлажкаПоВсем);
		Для Каждого	Дубль Из ПоискДублей Цикл
			Поиск = Новый Структура(Дубль.Ключ, Дубль.Значение);
			УжеЕстьСтроки = (ТаблицаСвязи.НайтиСтроки(Поиск).Количество() > 0);
			Если УжеЕстьСтроки Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если УжеЕстьСтроки Тогда
			Продолжить;
		КонецЕсли;
		
		// Создаем реквизиты формы.
		Если ИспользоватьРежимИндикаторСвязи Тогда
			// Флажок "Связь установлена":
			ИмяРеквизитаФлажокСвязьУстановлена = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
				ПрефиксНазванияМеханизма + "ФлажокСвязьУстановлена",
				МассивЗанятыхИменРеквизитовФормы);
			НовыйРеквизитФормы = Новый РеквизитФормы(ИмяРеквизитаФлажокСвязьУстановлена, ТипБулево);
			ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
			ВозвратИменаСохраняемыхРеквизитовФормы = ВозвратИменаСохраняемыхРеквизитовФормы
				+ ?(ЗначениеЗаполнено(ВозвратИменаСохраняемыхРеквизитовФормы), ",", "")
				+ ИмяРеквизитаФлажокСвязьУстановлена;
				
			ИменаСозданныхРеквизитовФормы.Вставить(ИмяРеквизитаФлажокСвязьУстановлена, ИмяРеквизитаФлажокСвязьУстановлена);
		КонецЕсли;
		
		// Добавляем новую строку в таблицу связи:
		НоваяСтрока = ТаблицаСвязи.Добавить();
		НоваяСтрока["ИспользоватьРежимПоВсем"]				= ИспользоватьРежимПоВсем;
		НоваяСтрока["ИспользоватьРежимИндикаторСвязи"]		= ИспользоватьРежимИндикаторСвязи;
		НоваяСтрока["ШапкаИмяЭлементаПоля"]					= ШапкаИмяЭлементаПоля;
		НоваяСтрока["ОтборИмяПоля"]							= ОтборИмяПоля;
		НоваяСтрока["ОтборИмяЭлементаТаблицы"]				= ОтборИмяЭлементаТаблицы;
		НоваяСтрока["ШапкаИмяЗаполняемойГруппыФормы"]		= ШапкаИмяЗаполняемойГруппыФормы;
		НоваяСтрока["ШапкаИмяЭлементаФлажокПоВсем"]			= ШапкаИмяЭлементаФлажкаПоВсем;
		НоваяСтрока["ШапкаПутьКДаннымПоля"]					= ШапкаПутьКДаннымПоля;
		НоваяСтрока["ШапкаПутьКДаннымФлажкаИндикаторСвязи"]	= ИмяРеквизитаФлажокСвязьУстановлена;
		НоваяСтрока["ШапкаПутьКДаннымФлажкаПоВсем"]			= ШапкаПутьКДаннымФлажкаПоВсем;
		НоваяСтрока["ИспользоватьФлажокВместоЗамка"]		= ИспользоватьФлажокВместоЗамка;
		НоваяСтрока["ВыводитьНадписьПомимоЗамка"]			= ВыводитьНадписьПомимоЗамка;
		НоваяСтрока["УстанавливатьСвязьПриИзмененииПоля"]	= УстанавливатьСвязьПриИзмененииПоля;
		
		НоваяСтрока["ОтборКомментарийПоВсемПолный"]		= ОтборКомментарийПоВсемПолный;
		НоваяСтрока["ОтборКомментарийПоВсемКороткий"]	= ОтборКомментарийПоВсемКороткий;
		НоваяСтрока["ОтборКомментарийПоОдномуПолный"]	= ОтборКомментарийПоОдномуПолный;
		НоваяСтрока["ОтборКомментарийПоОдномуКороткий"]	= ОтборКомментарийПоОдномуКороткий;
		
		// Обновляем итоговые значения:
		ИтогоИспользоватьРежимПоВсем			= ИтогоИспользоватьРежимПоВсем			ИЛИ ИспользоватьРежимПоВсем;
		ИтогоИспользоватьРежимИндикаторСвязи	= ИтогоИспользоватьРежимИндикаторСвязи	ИЛИ ИспользоватьРежимИндикаторСвязи;
	КонецЦикла;
	
	Если ТаблицаСвязи.Количество() = 0 Тогда
		// Выходим:
		Возврат;
	КонецЕсли;
	
	// СОЗДАЕМ РЕКВИЗИТЫ ФОРМЫ
	
	// Таблица связи:
	ИмяСозданногоРеквизитаФормыТаблицаСвязи = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
			СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_ПолучитьИмяРеквизитаФормыТаблицаСвязи(),
			МассивЗанятыхИменРеквизитовФормы);
	НовыйРеквизитФормы = Новый РеквизитФормы(ИмяСозданногоРеквизитаФормыТаблицаСвязи, Новый ОписаниеТипов("ТаблицаЗначений"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	// Колонки таблицы:
	Для Каждого Колонка Из ТаблицаСвязи.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		Если СлужебныеКолонки.Свойство(ИмяКолонки) Тогда
			Продолжить;
		КонецЕсли;
		ИмяНовогоРеквизита = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
			ИмяКолонки,
			МассивЗанятыхИменРеквизитовФормы,
			Ложь); // ЗапомнитьИмя
		НовыйРеквизитФормы = Новый РеквизитФормы(
			ИмяНовогоРеквизита,
			Новый ОписаниеТипов(Колонка.ТипЗначения.Типы()),
			ИмяСозданногоРеквизитаФормыТаблицаСвязи);
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	КонецЦикла;
	
	// Имя поля текущей строки таблицы отбора, при начале редактирования:
	ИмяРеквизитаИмяПоляПриНачалеРедактированияСтрокиОтбора = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
			СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_ПолучитьИмяРеквизитаФормыИмяПоляПриНачалеРедактированияСтрокиОтбора(),
			МассивЗанятыхИменРеквизитовФормы);
	НовыйРеквизитФормы = Новый РеквизитФормы(ИмяРеквизитаИмяПоляПриНачалеРедактированияСтрокиОтбора, ТипСтрока);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	
	// Комментарий элемента отбора:
	Если ИтогоИспользоватьРежимПоВсем Тогда
		ИмяРеквизитаКомментарийОтбора = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
			ПрефиксНазванияМеханизма + "КомментарийОтбора",
			МассивЗанятыхИменРеквизитовФормы);
		НовыйРеквизитФормы = Новый РеквизитФормы(ИмяРеквизитаКомментарийОтбора, ТипСтрока);
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	КонецЕсли;
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	ИменаСозданныхРеквизитовФормы.Вставить("ТаблицаСвязи", ИмяСозданногоРеквизитаФормыТаблицаСвязи);
	ИменаСозданныхРеквизитовФормы.Вставить("ИмяПоляПриНачалеРедактированияСтрокиОтбора", ИмяРеквизитаИмяПоляПриНачалеРедактированияСтрокиОтбора);
	
	// НАСТРАИВАЕМ ЭЛЕМЕНТЫ
	
	// Теперь настраиваем элементы формы.
	МассивЗанятыхИменЭлементовФормы		= СвязьПолейШапкиИОтбора_ПолучитьИменаЭлементовФормы(Форма);
	
	// Комментарий таблицы отбора:
	Если ИтогоИспользоватьРежимПоВсем Тогда
		Попытка
			ЭлементТаблицыОтбора = Элементы[ОтборИмяЭлементаТаблицы];
			РодительЭлементаТаблицыОтбора = ЭлементТаблицыОтбора.Родитель;
			ИмяНовогоЭлемента = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
				ПрефиксНазванияМеханизма + "КомментарийОтбора",
				МассивЗанятыхИменЭлементовФормы);
			НовыйЭлемент							= Элементы.Вставить(ИмяНовогоЭлемента, Тип("ПолеФормы"), РодительЭлементаТаблицыОтбора, ЭлементТаблицыОтбора);
			НовыйЭлемент.ПутьКДанным				= ИмяРеквизитаКомментарийОтбора;
			НовыйЭлемент.Вид						= ВидПоляФормы.ПолеНадписи;
			НовыйЭлемент.ПоложениеЗаголовка			= ПоложениеЗаголовкаЭлементаФормы.Нет;
			НовыйЭлемент.ЦветТекста					= ЦветаСтиля.ТекстИнформационнойНадписи;
			
			ИменаСозданныхРеквизитовФормы.Вставить("КомментарийОтбора", ИмяРеквизитаКомментарийОтбора);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	// Создаем новые элементы формы и дозаполняем таблицу связи:
	Для Каждого СтрокаСвязи Из ТаблицаСвязи Цикл
		ИспользоватьРежимИндикаторСвязи	= СтрокаСвязи["ИспользоватьРежимИндикаторСвязи"];
		ИспользоватьРежимПоВсем			= СтрокаСвязи["ИспользоватьРежимПоВсем"];
		
		Если ИспользоватьРежимИндикаторСвязи Тогда
			ШапкаИмяЭлементаПоля					= СтрокаСвязи["ШапкаИмяЭлементаПоля"];
			ШапкаИмяЗаполняемойГруппыФормы			= СтрокаСвязи["ШапкаИмяЗаполняемойГруппыФормы"];
			ИспользоватьФлажокВместоЗамка			= СтрокаСвязи["ИспользоватьФлажокВместоЗамка"];
			ВыводитьНадписьПомимоЗамка				= СтрокаСвязи["ВыводитьНадписьПомимоЗамка"];
			ШапкаПутьКДаннымФлажкаИндикаторСвязи	= СтрокаСвязи["ШапкаПутьКДаннымФлажкаИндикаторСвязи"];
			
			// Куда добавлять новые создаваемые элементы?
			ЭлементРодителяСуществует = НЕ (МассивЗанятыхИменЭлементовФормы.Найти(ШапкаИмяЗаполняемойГруппыФормы) = Неопределено);
			Если ЭлементРодителяСуществует Тогда
				// Добавляем в указанную группу.
				ЭлементРодителя = Элементы[ШапкаИмяЗаполняемойГруппыФормы];
			Иначе
				// Добавляем в ту же группу, что и элемент поля.
				ЭлементРодителя = Элементы[ШапкаИмяЭлементаПоля].Родитель;
			КонецЕсли;
			
			// Страницы для размещения переключателей связи:
			ШапкаИмяЭлементаСтраницы = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
				ПрефиксНазванияМеханизма + "Страницы",
				МассивЗанятыхИменЭлементовФормы);
			СтрокаСвязи["ШапкаИмяЭлементаСтраницы"]	= ШапкаИмяЭлементаСтраницы;
			Попытка
				ЭлементСтраницы = Элементы.Добавить(ШапкаИмяЭлементаСтраницы, Тип("ГруппаФормы"), ЭлементРодителя);
			Исключение
				Продолжить;
			КонецПопытки;
			ЭлементСтраницы.Вид					= ВидГруппыФормы.Страницы;
			ЭлементСтраницы.ОтображениеСтраниц	= ОтображениеСтраницФормы.Нет;
			
			// Страница "Связь установлена":
			ШапкаИмяЭлементаСтраницаСвязьУстановлена	= СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
				ПрефиксНазванияМеханизма + "СвязьУстановлена",
				МассивЗанятыхИменЭлементовФормы);
			НовыйЭлементСтраница				= Элементы.Добавить(ШапкаИмяЭлементаСтраницаСвязьУстановлена, Тип("ГруппаФормы"), ЭлементСтраницы);
			НовыйЭлементСтраница.Вид			= ВидГруппыФормы.Страница;
			НовыйЭлементСтраница.Группировка	= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
			Если ИспользоватьФлажокВместоЗамка Тогда
				// Флажок "Связь установлена" (установленный):
				ШапкаИмяЭлементаФлажокСвязьУстановлена = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
					ПрефиксНазванияМеханизма + "Флажок",
					МассивЗанятыхИменЭлементовФормы);
				НовыйЭлемент							= Элементы.Добавить(ШапкаИмяЭлементаФлажокСвязьУстановлена, Тип("ПолеФормы"), НовыйЭлементСтраница);
				НовыйЭлемент.Вид						= ВидПоляФормы.ПолеФлажка;
				НовыйЭлемент.ПутьКДанным				= ШапкаПутьКДаннымФлажкаИндикаторСвязи;
				НовыйЭлемент.Заголовок					= НСтр("ru='связь с отбором включена'");
				НовыйЭлемент.ПоложениеЗаголовка			= ПоложениеЗаголовкаЭлементаФормы.Право;
				НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_СвязьПолейШапкиИОтбора_ПриИзмененииФлажкаСвязьУстановлена");
			Иначе
				// Закрытый замок (картинка):
				ШапкаИмяЭлементаКартинкаСвязьУстановлена = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
					ПрефиксНазванияМеханизма + "ЗакрытыйЗамокКартинка",
					МассивЗанятыхИменЭлементовФормы);
				НовыйЭлемент							= Элементы.Добавить(ШапкаИмяЭлементаКартинкаСвязьУстановлена, Тип("ДекорацияФормы"), НовыйЭлементСтраница);
				НовыйЭлемент.Вид						= ВидДекорацииФормы.Картинка;
				НовыйЭлемент.Картинка					= БиблиотекаКартинок.ЗанятьФайл;
				НовыйЭлемент.Ширина						= 2;
				НовыйЭлемент.Высота						= 1;
				НовыйЭлемент.Подсказка					= НСтр("ru='Отключить связь с отбором (сейчас включена)'");
				НовыйЭлемент.РастягиватьПоГоризонтали	= Ложь;
				НовыйЭлемент.РастягиватьПоВертикали		= Ложь;
				НовыйЭлемент.Гиперссылка				= Истина;
				НовыйЭлемент.УстановитьДействие("Нажатие", "Подключаемый_СвязьПолейШапкиИОтбора_НажатиеКартинкиСвязьУстановлена");
				
				// Закрытый замок (надпись):
				Если ВыводитьНадписьПомимоЗамка Тогда
					ИмяНовогоЭлемента = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
						ПрефиксНазванияМеханизма + "ЗакрытыйЗамокНадпись",
						МассивЗанятыхИменЭлементовФормы);
					НовыйЭлемент							= Элементы.Добавить(ИмяНовогоЭлемента, Тип("ДекорацияФормы"), НовыйЭлементСтраница);
					НовыйЭлемент.Вид						= ВидДекорацииФормы.Надпись;
					НовыйЭлемент.Заголовок					= НСтр("ru='связь с отбором включена'");
					НовыйЭлемент.РастягиватьПоГоризонтали	= Истина;
				КонецЕсли;
			КонецЕсли;
			
			// Страница "Связь НЕ установлена":
			ШапкаИмяЭлементаСтраницаСвязьНеУстановлена	= СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
				ПрефиксНазванияМеханизма + "СвязьНеУстановлена",
				МассивЗанятыхИменЭлементовФормы);
			НовыйЭлементСтраница				= Элементы.Добавить(ШапкаИмяЭлементаСтраницаСвязьНеУстановлена, Тип("ГруппаФормы"), ЭлементСтраницы);
			НовыйЭлементСтраница.Вид			= ВидГруппыФормы.Страница;
			НовыйЭлементСтраница.Группировка	= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
			Если ИспользоватьФлажокВместоЗамка Тогда
				// Флажок "Связь установлена" (сброшенный):
				ШапкаИмяЭлементаФлажокСвязьНеУстановлена = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
					ПрефиксНазванияМеханизма + "Флажок",
					МассивЗанятыхИменЭлементовФормы);
				НовыйЭлемент							= Элементы.Добавить(ШапкаИмяЭлементаФлажокСвязьНеУстановлена, Тип("ПолеФормы"), НовыйЭлементСтраница);
				НовыйЭлемент.Вид						= ВидПоляФормы.ПолеФлажка;
				НовыйЭлемент.ПутьКДанным				= ШапкаПутьКДаннымФлажкаИндикаторСвязи;
				НовыйЭлемент.Заголовок					= НСтр("ru='связь с отбором отключена'");
				НовыйЭлемент.ПоложениеЗаголовка			= ПоложениеЗаголовкаЭлементаФормы.Право;
				НовыйЭлемент.ЦветТекстаЗаголовка		= ЦветаСтиля.ЗакрытыйДокумент;
				НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_СвязьПолейШапкиИОтбора_ПриИзмененииФлажкаСвязьНеУстановлена");
			Иначе
				// Открытый замок (картинка):
				ШапкаИмяЭлементаКартинкаСвязьНеУстановлена = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
					ПрефиксНазванияМеханизма + "ОткрытыйЗамокКартинка",
					МассивЗанятыхИменЭлементовФормы);
				НовыйЭлемент							= Элементы.Добавить(ШапкаИмяЭлементаКартинкаСвязьНеУстановлена, Тип("ДекорацияФормы"), НовыйЭлементСтраница);
				НовыйЭлемент.Вид						= ВидДекорацииФормы.Картинка;
				НовыйЭлемент.Картинка					= БиблиотекаКартинок.ОсвободитьФайл;
				НовыйЭлемент.Ширина						= 2;
				НовыйЭлемент.Высота						= 1;
				НовыйЭлемент.Подсказка					= НСтр("ru='Включить связь с отбором (сейчас отключена)'");
				НовыйЭлемент.РастягиватьПоГоризонтали	= Ложь;
				НовыйЭлемент.РастягиватьПоВертикали		= Ложь;
				НовыйЭлемент.Гиперссылка				= Истина;
				НовыйЭлемент.УстановитьДействие("Нажатие", "Подключаемый_СвязьПолейШапкиИОтбора_НажатиеКартинкиСвязьНеУстановлена");
				
				// Открытый замок (надпись):
				Если ВыводитьНадписьПомимоЗамка Тогда
					ИмяНовогоЭлемента = СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(
						ПрефиксНазванияМеханизма + "ОткрытыйЗамокНадпись",
						МассивЗанятыхИменЭлементовФормы);
					НовыйЭлемент							= Элементы.Добавить(ИмяНовогоЭлемента, Тип("ДекорацияФормы"), НовыйЭлементСтраница);
					НовыйЭлемент.Вид						= ВидДекорацииФормы.Надпись;
					НовыйЭлемент.Заголовок					= НСтр("ru='связь с отбором отключена'");
					НовыйЭлемент.ЦветТекста					= ЦветаСтиля.ЗакрытыйДокумент;
					НовыйЭлемент.РастягиватьПоГоризонтали	= Истина;
				КонецЕсли;
			КонецЕсли;
			
			// Дозаполняем текущую строку таблицы связи:
			СтрокаСвязи["ШапкаИмяЭлементаСтраницаСвязьУстановлена"]		= ШапкаИмяЭлементаСтраницаСвязьУстановлена;
			СтрокаСвязи["ШапкаИмяЭлементаСтраницаСвязьНеУстановлена"]	= ШапкаИмяЭлементаСтраницаСвязьНеУстановлена;
			СтрокаСвязи["ШапкаИмяЭлементаФлажокСвязьУстановлена"]		= ШапкаИмяЭлементаФлажокСвязьУстановлена;
			СтрокаСвязи["ШапкаИмяЭлементаФлажокСвязьНеУстановлена"]		= ШапкаИмяЭлементаФлажокСвязьНеУстановлена;
			СтрокаСвязи["ШапкаИмяЭлементаКартинкаСвязьУстановлена"]		= ШапкаИмяЭлементаКартинкаСвязьУстановлена;
			СтрокаСвязи["ШапкаИмяЭлементаКартинкаСвязьНеУстановлена"]	= ШапкаИмяЭлементаКартинкаСвязьНеУстановлена;
		КонецЕсли;
		
		Если ИспользоватьРежимПоВсем Тогда
			// УСЛОВНОЕ ОФОРМЛЕНИЕ.
			
			// Поле шапки при установленном флажке "По всем":
			НовыйЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
			НовыйЭлементУО.Представление = "Механизм связи полей шапки и отбора - поле шапки при установленном флажке ""По всем""";
			// Условие:
			Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрокаСвязи["ШапкаПутьКДаннымФлажкаПоВсем"]);
			Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			Условие.ПравоеЗначение = Истина;
			// Оформление:
			НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЗакрытыйДокумент);
			// Оформляемые поля:
			ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(СтрокаСвязи["ШапкаИмяЭлементаПоля"]);
		КонецЕсли;
		
	КонецЦикла;
	
	// Загружаем таблицу связи в форму:
	Форма[ИмяСозданногоРеквизитаФормыТаблицаСвязи].Загрузить(ТаблицаСвязи);
	
КонецПроцедуры

#Область КарточкаКоличественноСуммовогоУчетаМЦ

Функция СчетБУДляОтчета(КПС, КФО, Счет) Экспорт
	Результат = "";
	Если ЗначениеЗаполнено(КПС) Тогда
		Результат = СокрЛП(КПС)+"."+СокрЛП(КФО)+". "+СокрЛП(Счет.Код)
	Иначе
		Результат = СокрЛП(КФО)+"."+СокрЛП(Счет.Код)
	КонецЕсли;	
	
	Возврат Результат;

КонецФункции

Функция НаименованиеОрганизации(Организация) Экспорт
	Результат = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		Если ЗначениеЗаполнено(Организация.НаименованиеПолное) Тогда
			Результат = СокрЛП(Организация.НаименованиеПолное)
		Иначе
			Результат = СокрЛП(Организация.Наименование)
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;

КонецФункции

