//  КАРТОЧКА КОЛИЧЕСТВЕННО-СУММОВОГО УЧЕТА МЦ

Функция ИнвентарныйНомерОС(МЦ)
	Результат = "";
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ИнвентарныеНомераОС.Представление КАК ИнвНомер
	               |ИЗ
	               |	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	               |ГДЕ
	               |	ИнвентарныеНомераОС.ОС = &ОС
	               |	И ИнвентарныеНомераОС.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ОС", МЦ);			   
	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.ИнвНомер;
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции 

// Механизм автоматической установки флажка "Выводить отбор"
// Механизм связи полей шапки и отбора

Функция СвязьПолейШапкиИОтбора_ПолучитьИменаРеквизитовФормы(Форма)
	
	Результат = Новый Массив();
	
	Реквизитыформы = Форма.ПолучитьРеквизиты();
	Для Каждого Элем Из Реквизитыформы Цикл
		Результат.Добавить(Элем.Имя);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СвязьПолейШапкиИОтбора_ПолучитьИменаЭлементовФормы(Форма)
	
	Результат = Новый Массив();
	
	ЭлементыФормы = Форма.Элементы;
	Для Каждого Элем Из ЭлементыФормы Цикл
		Результат.Добавить(Элем.Имя);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СвязьПолейШапкиИОтбора_ПолучитьУникальноеИмя(Знач КандидатИмени, МассивЗанятыхИмен, ЗапомнитьИмя=Истина)
	
	Результат = КандидатИмени;
	сч = 1;
	
	Пока НЕ (МассивЗанятыхИмен.Найти(Результат) = Неопределено) Цикл
		// Имя занято.
		Результат = КандидатИмени + Формат(сч, "ЧГ=0");
		сч = сч + 1;
	КонецЦикла;
	
	Если ЗапомнитьИмя Тогда
		МассивЗанятыхИмен.Добавить(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти