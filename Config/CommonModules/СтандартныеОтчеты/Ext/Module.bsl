	ИначеЕсли ТипЗнч(МЦ) = Тип("СправочникСсылка.Номенклатура") Тогда	
		Результат = СокрЛП(МЦ.НоменклатурныйНомер);
	ИначеЕсли ТипЗнч(МЦ) = Тип("СправочникСсылка.ДенежныеДокументы") Тогда	
		Результат = СокрЛП(МЦ.Серия+" №"+МЦ.Номер);
