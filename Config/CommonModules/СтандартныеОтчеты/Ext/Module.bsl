////////////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ И ПРОЦЕДУРЫ ДЛЯ ФОРМИРОВАНИЯ И ВЫВОДА ОТЧЕТА, ОБРАБОТКА РЕЗУЛЬТАТА ОТЧЕТА
// 
 
// Функция получает у отчета реквизиты объекта необходимые для формирования
// расшифровки.
// Например для Карточки субконто необходим Список субконто и для всех отчетов
// необходим период выполнения отчета
// 
Функция ПолучитьУОбъектаДанныеРасшифровки(ОтчетОбъект)
	
	ДанныеРасшифровки = Новый Структура();
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОтчетОбъект,"НачалоПериода") Тогда
		ДанныеРасшифровки.Вставить("НачалоПериода", ОтчетОбъект.НачалоПериода);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОтчетОбъект,"КонецПериода") Тогда
		ДанныеРасшифровки.Вставить("КонецПериода", ОтчетОбъект.КонецПериода);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОтчетОбъект,"ТипПериода") Тогда
		ДанныеРасшифровки.Вставить("ТипПериода", ОтчетОбъект.ТипПериода);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОтчетОбъект,"ТолькоУказанныйПериод") Тогда
		ДанныеРасшифровки.Вставить("ТолькоУказанныйПериод", ОтчетОбъект.ТолькоУказанныйПериод);
    КонецЕсли;
    
	Попытка
		ДанныеРасшифровки.Вставить("НаборПоказателей" , ОтчетОбъект.НаборПоказателей);
		Для Каждого ИмяПоказателя Из ОтчетОбъект.НаборПоказателей Цикл
			ДанныеРасшифровки.Вставить("Показатель" + ИмяПоказателя , ОтчетОбъект["Показатель" + ИмяПоказателя]);
		КонецЦикла;
	Исключение
	КонецПопытки;
	
		// Счет
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОтчетОбъект,"Счет") Тогда
		ДанныеРасшифровки.Вставить("Счет", ОтчетОбъект.Счет);
	КонецЕсли;
	
		// СписокВидовСубконто
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОтчетОбъект,"СписокВидовСубконто") Тогда
		ДанныеРасшифровки.Вставить("СписокВидовСубконто", ОтчетОбъект.СписокВидовСубконто);
	КонецЕсли;
	
		// СписокВидовКорСубконто
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОтчетОбъект,"СписокВидовКорСубконто") Тогда
		ДанныеРасшифровки.Вставить("СписокВидовКорСубконто", ОтчетОбъект.СписокВидовКорСубконто);
	КонецЕсли;
	
		// Периодичность
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОтчетОбъект,"Периодичность") Тогда
		ДанныеРасшифровки.Вставить("Периодичность", ОтчетОбъект.Периодичность);
	КонецЕсли;
	
	Возврат ДанныеРасшифровки;
	
КонецФункции   

// Возвращает индекс строки или -1
Функция НайтиГруппировкуЕПСБУ(КонтролГруппировки, Группировка, ИмяПоля)
	Для каждого Строка из КонтролГруппировки Цикл
		Если Строка[ИмяПоля] = Группировка Тогда
			Возврат Строка.НомерСтроки - 1;
		КонецЕсли
	КонецЦикла;
	Возврат -1;
КонецФункции

Функция УдалитьГруппировкуЕПСБУ(КонтролГруппировки, Группировка, ИмяПоля)
	Индекс = НайтиГруппировкуЕПСБУ(КонтролГруппировки, Группировка, ИмяПоля);
	Если Индекс <> -1 Тогда
		КонтролГруппировки.Удалить(Индекс);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ДобавитьГруппировкуЕПСБУ(
    КонтролГруппировки, 
    ИмяГруппировки,
    Представление = "",
    Использование = Истина,
    ТипГруппировки = Неопределено,
    ИмяПоля = "Поле"
) Экспорт
	
	Если НайтиГруппировкуЕПСБУ(КонтролГруппировки, ИмяГруппировки, ИмяПоля) <> -1 Тогда
        Возврат Ложь;
    КонецЕсли;
    
    Строка = КонтролГруппировки.Добавить();
	Строка[ИмяПоля] = ИмяГруппировки;
	Строка.Использование = Использование;
	Если Представление = "" Тогда
		Строка.Представление = ИмяГруппировки;
	Иначе
		Строка.Представление = Представление;
    КонецЕсли;
    
    Если Строка.Свойство("ТипГруппировки") Тогда
        Строка.ТипГруппировки = ?(ТипГруппировки = Неопределено, Перечисления.ТипыДетализацииСтандартныхОтчетов.Элементы, ТипГруппировки);
    КонецЕсли; 

    Возврат Истина;
	
КонецФункции

Процедура ЗаменяемВОтбореОрганизациюНаОрганизациюПоУмолчанию(Элементы)
	
    Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
    Если ЗначениеЗаполнено(Организация) Тогда
        ПолеОрганизация = Новый ПолеКомпоновкиДанных("Организация");
    	Для каждого Отбор из Элементы Цикл
    		Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
    			ЗаменяемВОтбореОрганизациюНаОрганизациюПоУмолчанию(Отбор.Элементы);
    		ИначеЕсли
    			Отбор.ЛевоеЗначение = ПолеОрганизация И
    			Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
    		Тогда
    			Отбор.ПравоеЗначение = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
    		КонецЕсли;
    	КонецЦикла;
    КонецЕсли; 
	
КонецПроцедуры

Функция ВыводитьОтборРекурсивнаяЧасть(ОтборСтрока, Отбор, Элементы, МассивИсключенныхПолей, ИсключенноеПоле)
	
	Для каждого ЭлементОтбора из Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Выводить = ВыводитьОтборРекурсивнаяЧасть(ОтборСтрока, Отбор, ЭлементОтбора.Элементы, МассивИсключенныхПолей, ИсключенноеПоле);
			Если Не Выводить Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли
			ЭлементОтбора.Использование И
			(ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный ИЛИ
			ЭлементОтбора.ЛевоеЗначение = ИсключенноеПоле)
		Тогда
			ЭлементОтбора.Использование = Ложь;
			МассивИсключенныхПолей.Добавить(ЭлементОтбора);
		КонецЕсли
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

