	КонецЕсли;	
	Если Разрешить_Линейный Тогда
		СпособыНачисленияАмортизации.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный"));
		СпособыНачисленияАмортизации.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка"));
		СпособыНачисленияАмортизации.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции"));
