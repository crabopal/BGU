		Разрешить_ПриВводеВЭксплуатацию = Ложь;
		Разрешить_Линейный				= Ложь;
	ИначеЕсли Параметры.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА") Тогда
		//Если Параметры.СтоимостьНФА > ПределыОС.ВторойПределОС Тогда
		//	Разрешить_ПриВводеВЭксплуатацию = Ложь;
		//ИначеЕсли Параметры.СтоимостьНФА > 0 Тогда
		//	Разрешить_Линейный				= Ложь;
		//КонецЕсли;
	ИначеЕсли Параметры.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС") Тогда
		
		//Если Параметры.СтоимостьНФА > ПределыОС.ВторойПределОС Тогда
		//	Разрешить_ПриВводеВЭксплуатацию = Ложь;
		//ИначеЕсли Параметры.СтоимостьНФА > 0 Тогда
		//	Разрешить_Линейный				= Ложь;
		//КонецЕсли;
		
	КонецЕсли;
	
	СпособыНачисленияАмортизации = Новый Массив;
	Если Разрешить_ПриВводеВЭксплуатацию Тогда
