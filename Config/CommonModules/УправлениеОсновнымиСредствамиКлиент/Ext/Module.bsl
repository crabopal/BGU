	ОткрытьФорму("Документ." + ИмяЦелевогоДокумента + ".ФормаОбъекта", 
		ПараметрыФормы, ФормаИсточника, Новый УникальныйИдентификатор());
КонецПроцедуры	

Функция СтруктураРазделителяДокументов(МассивРазделителей)
	Разделитель = Неопределено;
	СтруктураРазделителя = Неопределено;
	Если ТипЗнч(МассивРазделителей) = Тип("Массив") Тогда
		Если МассивРазделителей.Количество() <> 0 Тогда
			СтруктураРазделителя = МассивРазделителей[0];
		КонецЕсли;	
	ИначеЕсли ТипЗнч(МассивРазделителей) = Тип("Структура") Тогда
		СтруктураРазделителя = МассивРазделителей;
	КонецЕсли;
		
	Если СтруктураРазделителя <> Неопределено Тогда
		Разделитель = Новый Структура;
		Для каждого ТекПоле из СтруктураРазделителя Цикл
			Разделитель.Вставить(ТекПоле.Ключ);
		КонецЦикла;	
	КонецЕсли;	
	
	Возврат Разделитель;
КонецФункции	

#КонецОбласти


 
