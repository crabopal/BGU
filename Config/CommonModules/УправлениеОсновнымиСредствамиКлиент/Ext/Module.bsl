	Возврат СпособыНачисленияАмортизации;

КонецФункции // ДоступныеСпособыНачисленияАмортизации()

Функция ДоступныеПорядкиПогашенияСтоимости(Параметры)

	Разрешить_СтоимостьНеПогашается 		= Истина;
	Разрешить_СписаниеПриВводеВЭксплуатацию	= Истина;
	Разрешить_НачислениеАмортизации 		= Истина;

	ПределыОС = ПолучитьПределыОС(Параметры);
	
	Если Параметры.ПоступлениеНаСчет21 Тогда
		Разрешить_СтоимостьНеПогашается 		= Ложь;
		Разрешить_НачислениеАмортизации 		= Ложь;
	ИначеЕсли Параметры.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА") Тогда
		Разрешить_СписаниеПриВводеВЭксплуатацию	= Ложь;
		Разрешить_НачислениеАмортизации 		= Ложь;
	ИначеЕсли Параметры.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА") Тогда
		Разрешить_СписаниеПриВводеВЭксплуатацию	= Ложь;
	ИначеЕсли Параметры.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС") Тогда
		Если Параметры.БиблФонд ИЛИ Параметры.Здание Тогда
			Разрешить_СписаниеПриВводеВЭксплуатацию	= Ложь;
		ИначеЕсли Параметры.СтоимостьНФА > ПределыОС.ПервыйПределОС Тогда
			Разрешить_СписаниеПриВводеВЭксплуатацию	= Ложь;
		ИначеЕсли Параметры.СтоимостьНФА <= ПределыОС.ПервыйПределОС Тогда
			Разрешить_НачислениеАмортизации	= Ложь;
		КонецЕсли;
	КонецЕслИ;
	
	ПорядкиПогашенияСтоимости = Новый Массив;
	Если Разрешить_СтоимостьНеПогашается Тогда
		ПорядкиПогашенияСтоимости.Добавить(ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается"));	
	КонецЕсли;
	Если Разрешить_СписаниеПриВводеВЭксплуатацию Тогда
		ПорядкиПогашенияСтоимости.Добавить(ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию"));	
	КонецЕсли;
	Если Разрешить_НачислениеАмортизации Тогда
		ПорядкиПогашенияСтоимости.Добавить(ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации"));	
	КонецЕсли;
	Возврат ПорядкиПогашенияСтоимости;

КонецФункции // ДоступныеПорядкиПогашенияСтоимости()

Функция ПолучитьПределыОС(Параметры)

	Если ЗначениеЗаполнено(Параметры.ДатаВвода) Тогда
		ПределыОС = УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ПолучитьПределыОС(НачалоГода(Параметры.ДатаВвода));
	ИначеЕсли ЗначениеЗаполнено(Параметры.ДатаДокумента) Тогда
		ПределыОС = УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ПолучитьПределыОС(НачалоГода(Параметры.ДатаДокумента));
	Иначе
		ПределыОС = УправлениеОсновнымиСредствамиВызовСервераПовтИсп.ПолучитьПределыОС(НачалоГода(ТекущаяДата()));
	КонецЕсли;
	Возврат ПределыОС;

КонецФункции // ПолучитьПределыОС()

Функция ПорядокПогашенияСтоимостиПоУмолчанию(Параметры)

	ПределыОС = ПолучитьПределыОС(Параметры);
	
	Если Параметры.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА") Тогда
		ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");
	ИначеЕсли Параметры.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА") Тогда
		ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");
	Иначе
		Если Параметры.СчетУчетаЗабалансовый Тогда
			ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");
		ИначеЕсли Параметры.СтоимостьНФА>0 Тогда
			Если Параметры.СтоимостьНФА > ПределыОС.ВторойПределОС Тогда
				ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");	
			ИначеЕсли Параметры.Здание
				ИЛИ Параметры.БиблФонд
				ИЛИ Параметры.СтоимостьНФА > ПределыОС.ПервыйПределОС Тогда
				ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");	
			Иначе
				ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию");	
			КонецЕслИ;
		Иначе
			Если Параметры.Здание ИЛИ Параметры.БиблФонд Тогда
				ПорядокПогашенияСтоимости 	= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");
			Иначе
				ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.ПустаяСсылка");	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат ПорядокПогашенияСтоимости;

КонецФункции // ПорядокПогашенияСтоимостиПоУмолчанию()

Функция СпособНачисленияАмортизацииПоУмолчанию(ПорядокПогашенияСтоимости, Параметры)
	
	Если ПорядокПогашенияСтоимости <> ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
	КонецЕсли;

	ПределыОС = ПолучитьПределыОС(Параметры);
	
	Если Параметры.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА") Тогда
		СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
	ИначеЕсли Параметры.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС") Тогда
		
		Если НЕ Параметры.СчетУчетаЗабалансовый И Параметры.СтоимостьНФА > 0 Тогда
			Если ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
				Если Параметры.СтоимостьНФА > ПределыОС.ВторойПределОС Тогда
					СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный");	
				Иначе
					СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию");
				КонецЕсли;
			Иначе
				СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
			КонецЕсли;
		Иначе
			СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
		КонецЕсли;
	ИначеЕсли Параметры.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА") Тогда
		Если Параметры.СтоимостьНФА>0 Тогда
			Если Параметры.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
				Если Параметры.СтоимостьНФА > ПределыОС.ВторойПределОС Тогда
					СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный");
				Иначе
					СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию");
				КонецЕсли;
			Иначе
				СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");	
			КонецЕсли;
		Иначе
			СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СпособНачисленияАмортизации;

КонецФункции // СпособНачисленияАмортизацииПоУмолчанию()

Функция НачислятьАмортизациюПоУмолчанию(ПорядокПогашенияСтоимости, СпособНачисленияАмортизации)

	Возврат ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") 
		И СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный");
	
КонецФункции // НачислятьАмортизациюПоУмолчанию()

Процедура ДобавитьЗначениеВСписок(Список, Значение, СтрокаПоиска)

	Если СтрокаПоиска = Неопределено
		ИЛИ Лев(Нрег(Значение),СтрДлина(СтрокаПоиска)) = НРег(СтрокаПоиска) Тогда
		Список.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

Функция ПараметрыПодбораОсновныхСредств() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Отбор", Новый Структура("Организация, ИФО, ЦМО, Подразделение, КФО, КПС, СпособНачисленияАмортизации, ТипНФА"));
	Параметры.Вставить("ВидыНФА", Новый Структура);
	Параметры.Вставить("СтруктураПроверяемыхРеквизитов", Новый Структура);
	Параметры.Вставить("Состояние", Новый Массив);
	
	Параметры.Вставить("ВидУчета",                  Неопределено);
	Параметры.Вставить("КФОвТабличнойЧасти",        Ложь);
	Параметры.Вставить("ВключатьБалансовыеСчета",   Ложь);
	Параметры.Вставить("ВключатьЗабалансовыеСчета", Ложь);
	Параметры.Вставить("СписокВидовОС",             Неопределено);
	Параметры.Вставить("ТребуемыеДанные",           "");
	Параметры.Вставить("Дата",           Неопределено);
	Параметры.Вставить("Ссылка",           Неопределено);
	
	Параметры.Вставить("ПереданныеВАренду",        Ложь);
	Параметры.Вставить("НеПереданныеВАренду",      Ложь);
	Параметры.Вставить("ПереданныеВПользование",   Ложь);
	Параметры.Вставить("НеПереданныеВПользование", Ложь);
	
	Параметры.Вставить("АдресОСВХранилище", "");
	
	Параметры.ВидыНФА.Вставить("ОС",          Ложь);
	Параметры.ВидыНФА.Вставить("НМА",         Ложь);
	Параметры.ВидыНФА.Вставить("НПА",         Ложь);
	Параметры.ВидыНФА.Вставить("Казна",       Ложь);
	Параметры.ВидыНФА.Вставить("КапВложения", Ложь);
	
	Возврат Параметры;

КонецФункции

Процедура ОткрытьПодборОсновныхСредств(Форма, Объект, ПараметрыОтбора = Неопределено) Экспорт
	
	Если Не ПроверитьЗаполнениеОбязательныхРеквизитов(Форма, Объект, Истина) Тогда
		Возврат;
	КонецЕсли;
	
	Параметры = Новый Структура("Отбор", Новый Структура);
	Параметры.Отбор.Вставить("Организация", Объект.Организация);
	
	Если ТипЗнч(ПараметрыОтбора) = Тип("Структура") Тогда 
		Для Каждого КлючИЗначение Из ПараметрыОтбора Цикл
			Параметры.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	Иначе
		Форма.ДополнитьПараметрыПодбора(Параметры);
	КонецЕсли;	
	
	Если Не Параметры.Свойство("ВидРаспоряжения") Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Устаревшая форма подбора ОС более не используется'"));
		Возврат;
	КонецЕсли;
	
	Если Не Параметры.Свойство("Период") Тогда
		ПарамДата = Новый Структура("ДатаСписанияСБухУчета");
		ЗаполнитьЗначенияСвойств(ПарамДата, Объект);
		
		ДатыПроведения = Новый Структура("ДатыПроведенияДокументов");
		ЗаполнитьЗначенияСвойств(ДатыПроведения, Форма);
		Если ТипЗнч(ДатыПроведения.ДатыПроведенияДокументов) = Тип("ДанныеФормыСтруктура") Тогда
			ПарамДата.ДатаСписанияСБухУчета = ДатыПроведения.ДатыПроведенияДокументов.ДатаПроведения;
		КонецЕсли;	
		
		Период = ?(ЗначениеЗаполнено(ПарамДата.ДатаСписанияСБухУчета)
			И НачалоДня(ПарамДата.ДатаСписанияСБухУчета) <> НачалоДня(Объект.Дата),
			ПарамДата.ДатаСписанияСБухУчета, Объект.Дата);
			
		Если Объект.Ссылка.Пустая() Тогда
			Период = КонецДня(Период);
		КонецЕсли;
		Параметры.Вставить("Период", Период);
	КонецЕсли;
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПодборПоОстаткамЗавершение", Форма, Параметры);
	
	ОценкаПроизводительностиКлиент.ЗамерВремени("ОткрытиеФормыПодборОсновныхСредствПоОстаткам3");
	
	ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ПодборПоОстаткам", Параметры, Форма,,,, ОповещениеОЗакрытии);
	
КонецПроцедуры

Функция ПроверитьЗаполнениеОбязательныхРеквизитов(Форма, Объект, СообщатьОбОшибках = Ложь) Экспорт
	
	ПроверяемыеПараметры = Форма.СтруктураПроверяемыхРеквизитов();
	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(ПроверяемыеПараметры, Объект, СообщатьОбОшибках);
	Возврат Не Отказ;
	
КонецФункции

Процедура ЗапроситьИзменениеДанныхВТаблицеПриИзмененииВидаОперации(
	СтарыйВидОперации, 
	НовыйВидОперации, 
	ЗаголовокРеквизита, 
	ПересчитываемыеРеквизиты, 
	Форма,
	ИмяОбработчика) Экспорт
	
	ТекстВопроса = НСтр("ru='При измении реквизита ""[ИмяРеквизита]"" с ""[СтарыйВидОперации]"" на ""[НовыйВидОперации]"" необходимо пересчитать [ПересчитываемыеРеквизиты].
							|Изменить [ИмяРеквизита] и пересчитать?'");
	ПараметрыВопроса = Новый Структура;
	ПараметрыВопроса.Вставить("ИмяРеквизита", ЗаголовокРеквизита);
	ПараметрыВопроса.Вставить("СтарыйВидОперации", СтарыйВидОперации);
	ПараметрыВопроса.Вставить("НовыйВидОперации", НовыйВидОперации);
	ПараметрыВопроса.Вставить("ПересчитываемыеРеквизиты", ПересчитываемыеРеквизиты);
	
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстВопроса, ПараметрыВопроса);
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, 		СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НСтр("ru='Изменить [ИмяРеквизита] и пересчитать'"), ПараметрыВопроса));
	Кнопки.Добавить(КодВозвратаДиалога.Нет, 	СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НСтр("ru='Изменить [ИмяРеквизита] и не пересчитывать'"), ПараметрыВопроса));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена,	СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НСтр("ru='Не изменять [ИмяРеквизита]'"), ПараметрыВопроса));
	
	ПоказатьВопрос(Новый ОписаниеОповещения(ИмяОбработчика, Форма, Новый Структура("НовыйВидОперации", НовыйВидОперации)), ТекстВопроса, Кнопки,, КодВозвратаДиалога.Да);
		
КонецПроцедуры

Процедура ЗапроситьПодтверждениеПриИзмененииВидаОперации(Элемент, НовыйВидОперации, СтандартнаяОбработка,
	ИмяРеквизита = "ВидОперации", ЗаголовокРеквизита = "", ИмяТабличнойЧасти = "ОсновныеСредства") Экспорт
	
	Форма = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(Элемент, Тип("ФормаКлиентскогоПриложения"));
	СтарыйВидОперации = Форма.Объект[ИмяРеквизита];
	
	Если СтарыйВидОперации = НовыйВидОперации Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

	Если Не НужноИзменитьСчетаУчета(СтарыйВидОперации, НовыйВидОперации)
		Или Форма.Объект[ИмяТабличнойЧасти].Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗаголовокРеквизита = "" Тогда
		ЗаголовокРеквизита = НСтр("ru = 'Вид операции'");
	КонецЕсли;
	
	Шаблон = НСтр("ru = 'При измении реквизита ""%1"" табличная часть будет очищена. Продолжить?'");	
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ЗаголовокРеквизита);
	
	ДополнительныеПараметры = Новый Структура("Элемент,НовыйВидОперации,ИмяРеквизита,ИмяТабличнойЧасти,Форма",
		Элемент, НовыйВидОперации, ИмяРеквизита, ИмяТабличнойЧасти, Форма);
	Оповщение = Новый ОписаниеОповещения("ВидОперацииОбработкаВыбораЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВопрос(Оповщение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	
КонецПроцедуры

Процедура ВидОперацииОбработкаВыбораЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
		
	ДопПараметры.Форма.Объект[ДопПараметры.ИмяРеквизита] = ДопПараметры.НовыйВидОперации;
	ДопПараметры.Форма.Объект[ДопПараметры.ИмяТабличнойЧасти].Очистить();
	
	ДопПараметры.Форма.ВидОперацииПриИзменении(ДопПараметры.Элемент);
	
КонецПроцедуры

Функция НужноИзменитьСчетаУчета(СтарыйВидОперации, НовыйВидОперации) Экспорт

	Если СтарыйВидОперации = НовыйВидОперации Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ГруппыВидовОпераций = Новый Массив;
	
	ГруппаОпераций = Новый Массив;
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений"));
	ГруппыВидовОпераций.Добавить(ГруппаОпераций);
	
	ГруппаОпераций = Новый Массив;
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет"));
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОСОперУчет"));
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийВыдачаОСНаНуждыУчреждения.ВнутреннееПеремещение"));
	ГруппыВидовОпераций.Добавить(ГруппаОпераций);
	
	ГруппаОпераций = Новый Массив;
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование"));
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхВПользование"));
	ГруппыВидовОпераций.Добавить(ГруппаОпераций);
	
	ГруппаОпераций = Новый Массив;
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении"));
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСнаХранении"));
	ГруппыВидовОпераций.Добавить(ГруппаОпераций);
	
	ГруппаОпераций = Новый Массив;
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСАренда"));
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСвПользование"));
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС"));
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеСобственныхОС"));
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийВыдачаОСНаНуждыУчреждения.ВводВЭксплуатацию"));
	ГруппыВидовОпераций.Добавить(ГруппаОпераций);
	
	ГруппаОпераций = Новый Массив;
	ГруппаОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСПолученныхПоЦС"));
	ГруппыВидовОпераций.Добавить(ГруппаОпераций);
	
	СтарыйИндекс = -1;
	НовыйИндекс = -1;
	ТекущийИндекс = 0;
	Для каждого ГруппаОпераций Из ГруппыВидовОпераций Цикл
	
		Если ГруппаОпераций.Найти(СтарыйВидОперации) <> Неопределено Тогда
			СтарыйИндекс = ТекущийИндекс;
		КонецЕсли;
		Если ГруппаОпераций.Найти(НовыйВидОперации) <> Неопределено Тогда
			НовыйИндекс = ТекущийИндекс;
		КонецЕсли;
		ТекущийИндекс = ТекущийИндекс + 1;
	
	КонецЦикла;
	
	Возврат СтарыйИндекс <> НовыйИндекс;

КонецФункции

Процедура НачалоВыбораАмортизационнойГруппы(Элемент, ДанныеВыбора, СтандартнаяОбработка, КодПоОКОФ, АмортизационнаяГруппа, ПоказатьФормуВыбора = Истина) Экспорт
	
	Если ЗначениеЗаполнено(КодПоОКОФ) Тогда
		
		АмортизационныеГруппыПоОКОФ = УправлениеОсновнымиСредствамиВызовСервера.ПолучитьАмортизационныеГруппы(КодПоОКОФ);
		
		Если  АмортизационныеГруппыПоОКОФ.Количество() = 0 Тогда
			
			Возврат
			
		ИначеЕсли АмортизационныеГруппыПоОКОФ.Количество() = 1 Тогда
			
			Если Не ЗначениеЗаполнено(АмортизационнаяГруппа) ИЛИ НЕ ПоказатьФормуВыбора Тогда
			
				АмортизационнаяГруппа = АмортизационныеГруппыПоОКОФ[0].Группа;
			
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ПоказатьФормуВыбора И АмортизационныеГруппыПоОКОФ.Количество() = 1 Тогда
			
			Возврат;
			
		КонецЕсли;	
		
		СтандартнаяОбработка = Ложь;
		
		Параметры = Новый Структура;
		
		Параметры.Вставить("ОКОФ", КодПоОКОФ);
		Параметры.Вставить("АмортизационнаяГруппа", АмортизационнаяГруппа);
		Параметры.Вставить("АмортизационныеГруппыПоОКОФ", АмортизационныеГруппыПоОКОФ);  
		
		ОткрытьФорму("ОбщаяФорма.ФормаВыбораАмортизационнойГруппы", Параметры, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;

КонецПроцедуры	

Процедура ПолучитьНомерИнвентарнойКарточи(Форма, ИндексСтроки = Неопределено) Экспорт
	
	Если ИндексСтроки <> Неопределено Тогда
		ТекущиеДанные = Форма.Объект.ОсновныеСредства[ИндексСтроки];
	Иначе
		ТекущиеДанные = Форма.Элементы.ОсновныеСредства.ТекущиеДанные;
	КонецЕсли;	
	
	Если Не ТекущиеДанные.СоздатьИнвентарнуюКарточку Или ЗначениеЗаполнено(ТекущиеДанные.НомерИнвентарнойКарточки) Тогда
		Возврат;
	КонецЕсли;
	
	ТабЧасть = Форма.Объект.ОсновныеСредства;
	ИндексТекСтроки = ТабЧасть.Индекс(ТекущиеДанные);
	
	НовыеНомера = Новый Массив;
	Для Каждого Строка Из ТабЧасть Цикл
		Если НЕ Строка.СоздатьИнвентарнуюКарточку Тогда                    
			Продолжить;
		КонецЕсли;	

		Если ИндексТекСтроки > ТабЧасть.Индекс(Строка) 
			И Строка.ОсновноеСредство = ТекущиеДанные.ОсновноеСредство 
			И ЗначениеЗаполнено(Строка.НомерИнвентарнойКарточки) Тогда
			
			ТекущиеДанные.НомерИнвентарнойКарточки = Строка.НомерИнвентарнойКарточки;
			Возврат;
			
		ИначеЕсли ЗначениеЗаполнено(Строка.НомерИнвентарнойКарточки) Тогда
			НовыеНомера.Добавить(Строка.НомерИнвентарнойКарточки);
		КонецЕсли;	
	КонецЦикла;
	
	Отказ = Ложь;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ИФО"				, Форма.Объект.ИФО);
	ДопПараметры.Вставить("КФО"				, Форма.Объект.КФО);
	ДопПараметры.Вставить("ИнвентарныйНомер", ТекущиеДанные.ИнвентарныйНомер);
	
	ТипОбъекта = ТипЗнч(Форма.Объект.Ссылка);
	Если ТипОбъекта = Тип("ДокументСсылка.ПереводГотовойПродукцииВСоставОС") Тогда
		ДопПараметры.Вставить("КПС"			, Форма.Объект.КПС);
		ДопПараметры.Вставить("СчетУчета"	, Форма.Объект.СчетОС);
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС")
		ИЛИ ТипОбъекта = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК") Тогда
		ДопПараметры.Вставить("КПС"			, ТекущиеДанные.КПС);
		ДопПараметры.Вставить("СчетУчета"	, Форма.Объект.СчетУчета);
	Иначе
		ДопПараметры.Вставить("КПС"			, ТекущиеДанные.КПС);
		ДопПараметры.Вставить("СчетУчета"	, ТекущиеДанные.СчетУчетаОС);
	КонецЕсли;
	
	ТекущиеДанные.НомерИнвентарнойКарточки = УправлениеОсновнымиСредствамиВызовСервера.ПолучитьНомерИнвентарнойКарточи(
		Форма.Объект.Ссылка, Форма.Объект.Организация, ТекущиеДанные.ОсновноеСредство, ДопПараметры, КонецДня(Форма.Объект.Дата), НовыеНомера, Отказ);
	
	Если Отказ Тогда
		ТекстСообщения = НСтр("ru = 'Недостаточная длина номера'");
		ПутьКДанным = "Объект.ОсновныеСредства["+Формат(ТекущиеДанные.НомерСтроки-1, "ЧГ=")+"].НомерИнвентарнойКарточки";
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, ПутьКДанным);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьДанныеВТСД(Форма, ТаблицаОСДляТСД) Экспорт
	
	Форма.Доступность = Ложь; // Блокируем интерфейс пользователя.
	
	ДополнительныеПараметры = Новый Структура("Форма", Форма);
	
	Оповещение = Новый ОписаниеОповещения("ВыгрузитьДанныеВТСД_ПослеВыгрузки", ЭтотОбъект, ДополнительныеПараметры);
	ПараметрыОперации = ОборудованиеТерминалыСбораДанныхКлиентСервер.ПараметрыВыгрузкиВТСД();
    ПараметрыОперации.ТаблицаТоваров = ТаблицаОСДляТСД;
	ОборудованиеТерминалыСбораДанныхКлиент.НачатьВыгрузкуДанныеВТСД(Оповещение, Форма.УникальныйИдентификатор, , ПараметрыОперации);
	
КонецПроцедуры

Процедура ВыгрузитьДанныеВТСД_ПослеВыгрузки(Результат, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	
	Форма.Доступность = Истина; // Разблокировка интерфейса пользователя.
	
	Если Результат.Результат Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Данные выгружены'"));
	Иначе
		Шаблон = НСтр("ru = 'При выполнении операции произошла ошибка:""%1"".'");
		ТекстСообщения = СтрШаблон(Шаблон, Результат.ОписаниеОшибки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриОткрытииДокумента173н(Объект, ИмяНовогоДокумента, ЗапретитьСозданиеНового = Истина) Экспорт
	
	Ключ = Объект.Параметры.Ключ;
	
	Если ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗапретитьСозданиеНового Тогда
		Объект.Закрыть();
	КонецЕсли;
	
	СинонимыДокументов = УправлениеОсновнымиСредствамиВызовСервера.СинонимыДокументов173н(Ключ, ИмяНовогоДокумента);
	
	ШрифтДокумента = Новый Шрифт(,,,Истина);
	
	ЧастиТекста = Новый Массив;
	ЧастиТекста.Добавить(НСтр("ru = 'Документ устарел:'"));
	ЧастиТекста.Добавить(Символы.ПС);
	ЧастиТекста.Добавить(Новый ФорматированнаяСтрока(СинонимыДокументов.СинонимСтарогоДокумента, ШрифтДокумента));
	ЧастиТекста.Добавить(Символы.ПС);
	ЧастиТекста.Добавить(Символы.ПС);
	ЧастиТекста.Добавить(НСтр("ru = 'Рекомендуется использовать документ:'"));
	ЧастиТекста.Добавить(Символы.ПС);
	ЧастиТекста.Добавить(Новый ФорматированнаяСтрока(СинонимыДокументов.СинонимНовогоДокумента, ШрифтДокумента));
	ЧастиТекста.Добавить(Символы.ПС);
	ЧастиТекста.Добавить(Символы.ПС);
	ЧастиТекста.Добавить(НСтр("ru = 'Открыть рекомендуемый документ?'"));
	Если Не ЗапретитьСозданиеНового Тогда
		ЧастиТекста.Добавить(Символы.ПС);
		ЧастиТекста.Добавить(НСтр("ru = '(текущий документ будет закрыт)'"));
	КонецЕсли;
	
	ТекстВопроса = Новый ФорматированнаяСтрока(ЧастиТекста);
	
	ДопПараметры = Новый Структура("Форма,ИмяНовогоДокумента,Запретить", Объект, ИмяНовогоДокумента, ЗапретитьСозданиеНового);
	Оповещение = Новый ОписаниеОповещения("ПриОткрытииДокумента173нЗавершение", ЭтотОбъект, ДопПараметры);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Процедура ПриОткрытииДокумента173нЗавершение(Ответ, Параметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Параметры.Запретить Тогда
		Параметры.Форма.Закрыть();
	КонецЕсли;
	
	ОткрытьФорму("Документ." + Параметры.ИмяНовогоДокумента + ".ФормаОбъекта");
	
КонецПроцедуры

Процедура ПриНажатииСведенияИнвентарногоОбъекта(Форма, Элемент, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если СтрНайти(Форма.ИмяФормы, "ИнвентарныеНомераОС") > 0 Тогда
		
		Организация			= Форма.Объект.Владелец;
		ОсновноеСредство	= Форма.Объект.ОС;
		ИнвентарныйНомер	= Форма.Объект.Ссылка;
		
	ИначеЕсли СтрНайти(Форма.ИмяФормы, "ОсновныеСредства") > 0 Тогда
		
		Организация			= Форма.Объект.Организация;
		ОсновноеСредство	= Форма.Объект.Ссылка;
		ИнвентарныйНомер	= Форма.ИнвентарныйНомер;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	ДатаСведений = Форма.ДатаСведений;
	КлючиЗаписей = Форма.КлючиЗаписей;
	
	ИмяЭлемента = Элемент.Имя;
	
	Если ИмяЭлемента = "НалогНаИмущество" Тогда
		
		КлючЗаписи = КлючиЗаписей["НалогНаИмущество"];
		
		Если КлючЗаписи <> Неопределено Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Ключ", КлючЗаписи);
			ОткрытьФорму("Документ.РегистрацияСтавкиНалогаНаИмущество.Форма.ФормаДокумента", ПараметрыФормы, Форма);
		КонецЕсли;		
		
	ИначеЕсли ИмяЭлемента = "ЗемельныйНалог" Тогда
		
		ПараметрыФормы = Новый Структура;	
		КлючЗаписи = КлючиЗаписей["ЗемельныйНалог"];
		Если КлючЗаписи = Неопределено Тогда
			ЗначенияЗаполнения = Новый Структура("Период,Организация,ОсновноеСредство,ИнвентарныйНомер",
				ДатаСведений, Организация, ОсновноеСредство, ИнвентарныйНомер);
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);	
		Иначе
			ПараметрыФормы.Вставить("Ключ", КлючЗаписи);
		КонецЕсли;
		
		ОткрытьФорму("РегистрСведений.РегистрацияЗемельныхУчастков.ФормаЗаписи", ПараметрыФормы, Форма);
		
	ИначеЕсли ИмяЭлемента = "ТранспортныйНалог" Тогда
		
		ПараметрыФормы = Новый Структура;	
		КлючЗаписи = КлючиЗаписей["ТранспортныйНалог"];
		Если КлючЗаписи = Неопределено Тогда
			ЗначенияЗаполнения = Новый Структура("Период,Организация,ОсновноеСредство,ИнвентарныйНомер",
				ДатаСведений, Организация, ОсновноеСредство, ИнвентарныйНомер);
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);	
		Иначе
			ПараметрыФормы.Вставить("Ключ", КлючЗаписи);
		КонецЕсли;
		
		ОткрытьФорму("РегистрСведений.РегистрацияТранспортныхСредств.ФормаЗаписи", ПараметрыФормы, Форма);
	
	ИначеЕсли ИмяЭлемента = "КадастровыйУчет" ИЛИ ИмяЭлемента = "КадастровыйУчет1" Тогда
		
		ПараметрыФормы = Новый Структура;	
		КлючЗаписи = КлючиЗаписей["КадастровыйУчет"];
		Если КлючЗаписи = Неопределено Тогда
			ЗначенияЗаполнения = Новый Структура("Период,Организация,ОсновноеСредство,ИнвентарныйНомер",
				ДатаСведений, Организация, ОсновноеСредство, ИнвентарныйНомер);
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);	
		Иначе
			ПараметрыФормы.Вставить("Ключ", КлючЗаписи);
		КонецЕсли;
		
		ОткрытьФорму("РегистрСведений.СведенияКадастровогоУчета.ФормаЗаписи", ПараметрыФормы, Форма);
		
	ИначеЕсли ИмяЭлемента = "ПТС" Тогда
		
		ПараметрыФормы = Новый Структура;	
		КлючЗаписи = КлючиЗаписей["ПТС"];
		Если КлючЗаписи = Неопределено Тогда
			ЗначенияЗаполнения = Новый Структура("Период,Организация,ОсновноеСредство,ИнвентарныйНомер",
				ДатаСведений, Организация, ОсновноеСредство, ИнвентарныйНомер);
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);	
		Иначе
			ПараметрыФормы.Вставить("Ключ", КлючЗаписи);
		КонецЕсли;
		
		ОткрытьФорму("РегистрСведений.ПаспортаТранспортныхСредств.ФормаЗаписи", ПараметрыФормы, Форма);
		
	ИначеЕсли ИмяЭлемента = "Штрихкоды" Тогда
		
		ДанныеШтрихкоды = КлючиЗаписей["Штрихкоды"];
		КоличествоШтрихкодов = ?(ДанныеШтрихкоды = Неопределено, 0, ДанныеШтрихкоды.Количество);
		
		ПараметрыФормы = Новый Структура;
		
		Если КоличествоШтрихкодов > 1 Тогда
			Отбор = Новый Структура("Объект,ИнвентарныйНомер", ОсновноеСредство, ИнвентарныйНомер);
			ПараметрыФормы.Вставить("Отбор", Отбор);	
			ОткрытьФорму("РегистрСведений.Штрихкоды.ФормаСписка", ПараметрыФормы, Форма);
			Возврат;
		КонецЕсли;
		
		Если КоличествоШтрихкодов = 0 Тогда
			ЗначенияЗаполнения = Новый Структура("Объект,ИнвентарныйНомер", ОсновноеСредство, ИнвентарныйНомер);
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);			
		ИначеЕсли КоличествоШтрихкодов = 1 Тогда
			ПараметрыФормы.Вставить("Ключ", ДанныеШтрихкоды.КлючЗаписи);
		КонецЕсли;	
		
		ОткрытьФорму("РегистрСведений.Штрихкоды.ФормаЗаписи", ПараметрыФормы, Форма);
		
	ИначеЕсли ИмяЭлемента = "ЦМО" Тогда
		
		Если ЗначениеЗаполнено(Форма.ЦМО) Тогда			
			ПоказатьЗначение(, Форма.ЦМО);
		КонецЕсли;
		
	ИначеЕсли ИмяЭлемента = "ДатаПринятияКУчетуОбъектаОС" Тогда
		
		Если ЗначениеЗаполнено(Форма.ДокументПринятияКУчетуОбъектаОС) Тогда
			ПоказатьЗначение(, Форма.ДокументПринятияКУчетуОбъектаОС);
		КонецЕсли;
		
	ИначеЕсли ИмяЭлемента = "ДатаВводаВЭксплуатациюОбъектаОС" Тогда
		
		Если ЗначениеЗаполнено(Форма.ДокументВводаВЭксплуатациюОбектаОС) Тогда
			ПоказатьЗначение(, Форма.ДокументВводаВЭксплуатациюОбектаОС);
		КонецЕсли;
		
	ИначеЕсли ИмяЭлемента = "ДатаСписанияОбъектаОС" Тогда
		
		Если ЗначениеЗаполнено(Форма.ДокументСписанияОбъектаОС) Тогда
			ПоказатьЗначение(, Форма.ДокументСписанияОбъектаОС);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьСписокСведенияИнвентарногоОбъекта(Форма, Элемент) Экспорт
	
	Если СтрНайти(Форма.ИмяФормы, "ИнвентарныеНомераОС") > 0 Тогда
		
		Организация			= Форма.Объект.Владелец;
		ОсновноеСредство	= Форма.Объект.ОС;
		ИнвентарныйНомер	= Форма.Объект.Ссылка;
		
	ИначеЕсли СтрНайти(Форма.ИмяФормы, "ОсновныеСредства") > 0 Тогда
		
		Организация			= Форма.Объект.Организация;
		ОсновноеСредство	= Форма.Объект.Ссылка;
		ИнвентарныйНомер	= Форма.ИнвентарныйНомер;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	ИмяКоманды = Сред(Элемент.Имя, 14);
	
	Если ИмяКоманды = "НалогНаИмущество" Тогда
		
		Отбор = Новый Структура("Организация,ОсновноеСредство,ИнвентарныйНомер", Организация, ОсновноеСредство, ИнвентарныйНомер);
		ПараметрыФормы = Новый Структура("Отбор", Отбор);	
		ОткрытьФорму("РегистрСведений.СтавкиНалогаНаИмуществоПоОсновнымСредствам.ФормаСписка", ПараметрыФормы, Форма);
		
		
	ИначеЕсли ИмяКоманды = "ТранспортныйНалог" Тогда
		
		Отбор = Новый Структура("Организация,ОсновноеСредство,ИнвентарныйНомер", Организация, ОсновноеСредство, ИнвентарныйНомер);
		ПараметрыФормы = Новый Структура("Отбор", Отбор);	
		ОткрытьФорму("РегистрСведений.РегистрацияТранспортныхСредств.ФормаСписка", ПараметрыФормы, Форма);
		
	ИначеЕсли ИмяКоманды = "ЗемельныйНалог" Тогда
		
		Отбор = Новый Структура("Организация,ОсновноеСредство,ИнвентарныйНомер", Организация, ОсновноеСредство, ИнвентарныйНомер);
		ПараметрыФормы = Новый Структура("Отбор", Отбор);	
		ОткрытьФорму("РегистрСведений.РегистрацияЗемельныхУчастков.ФормаСписка", ПараметрыФормы, Форма);
		
		
	ИначеЕсли ИмяКоманды = "КадастровыйУчет" Тогда
		
		Отбор = Новый Структура("Организация,ОсновноеСредство,ИнвентарныйНомер", Организация, ОсновноеСредство, ИнвентарныйНомер);
		ПараметрыФормы = Новый Структура("Отбор", Отбор);	
		ОткрытьФорму("РегистрСведений.СведенияКадастровогоУчета.ФормаСписка", ПараметрыФормы, Форма);
		
		
	ИначеЕсли ИмяКоманды = "ПТС" Тогда
		
		Отбор = Новый Структура("Организация,ОсновноеСредство,ИнвентарныйНомер", Организация, ОсновноеСредство, ИнвентарныйНомер);
		ПараметрыФормы = Новый Структура("Отбор", Отбор);	
		ОткрытьФорму("РегистрСведений.ПаспортаТранспортныхСредств.ФормаСписка", ПараметрыФормы, Форма);
		
	ИначеЕсли ИмяКоманды = "Штрихкоды" Тогда
		
		Отбор = Новый Структура("Объект,ИнвентарныйНомер", ОсновноеСредство, ИнвентарныйНомер);
		ПараметрыФормы = Новый Структура("Отбор", Отбор);	
		ОткрытьФорму("РегистрСведений.Штрихкоды.ФормаСписка", ПараметрыФормы, Форма);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоказатьОсновныеСредстваВСправочнике(Форма, ИмяТабличнойЧасти, ИмяРеквизита) Экспорт
	
	Объекты = Новый Массив;
	Для Каждого СтрокаДокумента Из Форма.Объект[ИмяТабличнойЧасти] Цикл
		Объекты.Добавить(СтрокаДокумента[ИмяРеквизита]);
	КонецЦикла;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Ссылка", Объекты);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Отбор: " + Строка(Форма.Объект.Ссылка));
	ПараметрыФормы.Вставить("ОтображениеТаблицы", ОтображениеТаблицы.Список);
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("Справочник.ОсновныеСредства.ФормаСписка", ПараметрыФормы, Форма);
	
КонецПроцедуры

Процедура ПоказатьКапительныеВложенияВСправочнике(Форма, ИмяТабличнойЧасти, ИмяРеквизита) Экспорт
	
	Объекты = Новый Массив;
	Для Каждого СтрокаДокумента Из Форма.Объект[ИмяТабличнойЧасти] Цикл
