
#Область ПрограммныйИнтерфейс

Процедура ЗапроситьИзменениеДатыСписанияСБухУчета(Объект) Экспорт
	
	Если ЗначениеЗаполнено(Объект.ДатаСписанияСБухУчета)
		И Объект.ДатаСписанияСБухУчета<>Объект.Дата Тогда
		
		ТекстВопроса = НСТР("ru='Изменилась дата документа.
							|Установить дату списания с бух. учета равной дате документа?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да,  НСтр("ru='Установить дату списания'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='Не изменять дату списания'"));
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗапроситьИзменениеДатыСписанияСБухУчетаЗавершение", ЭтотОбъект, Новый Структура("Объект", Объект)), ТекстВопроса, Кнопки,,КодВозвратаДиалога.Да);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗапроситьИзменениеДатыСписанияСБухУчетаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Объект = ДополнительныеПараметры.Объект;
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Объект.ДатаСписанияСБухУчета = Объект.Дата;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОбщиеПараметрыВыбораОсновныхСредствПриВыбытии(ПараметрыВыбора, ВидОперации,
	ВидИмущества = Неопределено) Экспорт
	
	ПараметрыСчетов = УправлениеОсновнымиСредствамиКлиентСервер.СтруктураЗапрашиваемыхСчетов();
	
	Если ТипЗнч(ВидИмущества) = Тип("ПеречислениеСсылка.ВидыИмущества") Тогда
		ПараметрыСчетов.ВидИмущества = ВидИмущества;
	КонецЕсли;
	Если ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПередачиОС.ПередачаОСПолученныхвПользование")
		ИЛИ ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование") Тогда
		ПараметрыСчетов.Аренда = Истина;
		ПараметрыВыбора.Вставить("ОС",  Истина);
		ПараметрыВыбора.Вставить("НПА", Истина);
		ПараметрыВыбора.Отбор.Вставить("ВидУчета", ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.Арендованные"));
		
		ПараметрыСчетов.Вставить("ОС",	Истина);
		ПараметрыСчетов.Вставить("НПА",	Истина);
		
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаОСнаХранении")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеОСнаХранении") Тогда
		ПараметрыСчетов.Хранение = Истина;
		ПараметрыВыбора.Вставить("ОС", Истина);
		ПараметрыВыбора.Отбор.Вставить("ВидУчета", ПредопределенноеЗначение(
			"Перечисление.ВидыУчетаНФА.НаОтветственномХранении"));
		ПараметрыСчетов.Вставить("ОС",	Истина);
		
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаКапвложений")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияОС.СписаниеКапвложений") Тогда
		ПараметрыВыбора.Вставить("КапВложения", Истина);
		ПараметрыСчетов.Вставить("КапВложения", Истина);
	ИначеЕсли ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет") Тогда
		ПараметрыВыбора.Вставить("ОС",	Истина);
		ПараметрыСчетов.ЖилыеПомещения		= Истина;
		ПараметрыСчетов.НежилыеПомещения	= Истина;
		ПараметрыСчетов.Сооружения			= Истина;
		ПараметрыСчетов.Машины				= Истина;
		ПараметрыСчетов.Транспорт			= Истина;
		ПараметрыСчетов.ХозИнвентарь		= Истина;
		ПараметрыСчетов.Библиотека			= Истина;
		ПараметрыСчетов.Прочие				= Истина;
		ПараметрыСчетов.Вставить("ОС",	Истина);
		
	Иначе
		ПараметрыСчетов.Машины			= Истина;
		ПараметрыСчетов.Транспорт		= Истина;
		ПараметрыСчетов.ХозИнвентарь	= Истина;
		ПараметрыСчетов.Библиотека		= Истина;
		ПараметрыСчетов.Прочие			= Истина;
		
		ПараметрыСчетов.Вставить("ОС",	Истина);
		ПараметрыСчетов.Вставить("НПА",	Истина);
		ПараметрыСчетов.Вставить("НМА",	Истина);
		
		ПараметрыВыбора.Вставить("ОС",	Истина);
		ПараметрыВыбора.Вставить("НПА",	Истина);
		ПараметрыВыбора.Вставить("НМА",	Истина);
		Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПередачиОС.ПередачаСобственныхОС") Тогда
			ПараметрыВыбора.Вставить("КапВложения",	Истина);
		КонецЕсли;
		
		ПараметрыВыбора.Отбор.Вставить("ВидУчета", ПредопределенноеЗначение("Перечисление.ВидыУчетаНФА.НаБалансе"));
		
	КонецЕсли;
	
	ПараметрыВыбора.Вставить("СписокВидовОС", ПараметрыСчетов);
	
КонецПроцедуры

Процедура НачалоВыбораПолногоСчетаОбъектаОСВТаблицеДокумента(Форма, СчетУчета, Элемент, ДанныеВыбора,
	СтандартнаяОбработка) Экспорт

	Таблица = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(Элемент, Тип("ТаблицаФормы"));
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект = Форма.Объект;
	ТекущиеДанные = Таблица.ТекущиеДанные;
	
	ИмяЭлемента = Элемент.Имя;
	Если СтрНачинаетсяС(ИмяЭлемента, Таблица.Имя) Тогда
		ИмяЭлемента = Сред(ИмяЭлемента, СтрДлина(Таблица.Имя) + 1);
	КонецЕсли;
	
	Если ИмяЭлемента = "КПС" Тогда
		ЭлементКПС = Элемент;
	Иначе
		ЭлементКПС = Форма.Элементы.Найти(Таблица.Имя + "КПС");
	КонецЕсли;
	Если ИмяЭлемента = "КФО" Тогда
		ЭлементКФО = Элемент;
	Иначе
		ЭлементКФО = Форма.Элементы.Найти(Таблица.Имя + "КФО");
	КонецЕсли;
	Если ИмяЭлемента = "СчетУчета" Тогда
		ЭлементСчетУчета = Элемент;
	Иначе
		ЭлементСчетУчета = Форма.Элементы.Найти(Таблица.Имя + "СчетУчета");
	КонецЕсли;
	
	ТекущийСчет = Новый Структура("Счет, КПС, КФО");
	ТекущийСчет.Счет = ТекущиеДанные.СчетУчета;
	ТекущийСчет.КПС  = ТекущиеДанные.КПС;
	ТекущийСчет.КФО  = ТекущиеДанные.КФО;
	
	ОграниченияКПС = Новый Массив;
	ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"));
	ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
	ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный"));
	
	ОграниченияСписокСчетов = Неопределено;
	ОграничениеПоСубконто = Неопределено;
	// Определить ограничения счета из элемента
	ПараметрыВыбора = Неопределено;
	Если ЭлементСчетУчета <> Неопределено Тогда
		ПараметрыВыбора = ЭлементСчетУчета.ПараметрыВыбора;
	КонецЕсли;
	
	Если ПараметрыВыбора <> Неопределено Тогда
		
		ОграниченияСписокСчетов = Новый СписокЗначений;
		Для каждого ПараметрВыбора Из ПараметрыВыбора Цикл
		
			Если ПараметрВыбора.Имя = "ОграниченияСписокСчетов" Тогда
				ОграниченияСписокСчетов.ЗагрузитьЗначения(Новый Массив(ПараметрВыбора.Значение));
			КонецЕсли;
			
			Если ПараметрВыбора.Имя = "ОграничениеПоСубконто" Тогда
				ОграничениеПоСубконто = Новый Массив(ПараметрВыбора.Значение);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, СтандартнаяОбработка, ТекущийСчет,
		Объект.Организация, Объект.ИФО, ОграниченияСписокСчетов, ТекущиеДанные.КФО, ОграниченияКПС, Объект.Дата,, ОграничениеПоСубконто);
	
КонецПроцедуры

Процедура ОбработкаВыбораПолногоСчетаОбъектаОСВТаблицеДокумента(Форма, Элемент, ВыбранноеЗначение,
	СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Структура") Тогда
		// Стандартная обработка
		Возврат;
	КонецЕсли;
	
	Таблица = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(Элемент, Тип("ТаблицаФормы"));
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Таблица.ТекущиеДанные;
	
	// Получить из структуры КПС, КФО и Счет и заполнить их в колонки строки
	ДанныеСтроки = Новый Структура("КПС, КФО, СчетУчета");
	
	ВыбранныеДанные = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ВыбранноеЗначение);
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(ВыбранныеДанные,
		ДанныеСтроки.КПС, ДанныеСтроки.КФО);
	ДанныеСтроки.СчетУчета = ВыбранныеДанные;
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеСтроки);
	
	// Определить имя элемента для установки параметра ВыбранноеЗначение
	ИмяЭлемента = Элемент.Имя;
	Если СтрНачинаетсяС(ИмяЭлемента, Таблица.Имя) Тогда
		ИмяЭлемента = Сред(ИмяЭлемента, СтрДлина(Таблица.Имя) + 1);
	КонецЕсли;
	Если ИмяЭлемента = "СчетУчета" Тогда
		ВыбранноеЗначение.Свойство("Счет", ВыбранноеЗначение);
	Иначе
		ВыбранноеЗначение.Свойство(ИмяЭлемента, ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

