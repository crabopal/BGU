// Процедуры и функции вызываемые из документов "Принятие к учету ОС"

// Процедура устанавливает ПорядокПогашенияСтоимости, СпособНачисленияАмортизации и НачислятьАмортизацию по переданным параметрам
// Параметры:
//	ПорядокПогашенияСтоимости - 	Перечисление.ПорядокПогашенияСтоимости 		- устанавливаемый реквизит объекта
//	СпособНачисленияАмортизации - 	Перечисление.СпособНачисленияАмортизации 	- устанавливаемый реквизит объекта
//	НачислятьАмортизацию - 			Булево  									- устанавливаемый реквизит объекта
//	СтруктураПараметров - Структура - Содержит ключи
//									Дата - Дата документа, для получения пределов стоимости ОС
//									ВидНФА - Перечисление.ВидыНФА
//									СтоимостьНФА
//									БиблФонд - Булево
//									Здание - Булево
//									СчетУчета - Счет учета объекта ОС
//									СчетУчетаЗабалансовый - булево
//
Процедура УстановитьПорядокПогашенияСтоимости(ПорядокПогашенияСтоимости, СпособНачисленияАмортизации, НачислятьАмортизацию, Параметры) Экспорт
	
	ДоступныеПорядкиПогашенияСтоимости = ДоступныеПорядкиПогашенияСтоимости(Параметры);	
	ПорядокПогашенияСтоимостиПоУмолчанию = ПорядокПогашенияСтоимостиПоУмолчанию(Параметры);
	Если ДоступныеПорядкиПогашенияСтоимости.Найти(ПорядокПогашенияСтоимостиПоУмолчанию) <> Неопределено Тогда
		ПорядокПогашенияСтоимости = ПорядокПогашенияСтоимостиПоУмолчанию;
	ИначеЕсли ДоступныеПорядкиПогашенияСтоимости.Количество() > 0 Тогда
		ПорядокПогашенияСтоимости = ДоступныеПорядкиПогашенияСтоимости[0];
	Иначе
		ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.ПустаяСсылка");
	КонецЕсли;
	
	ДоступныеСпособыНачисленияАмортизации = ДоступныеСпособыНачисленияАмортизации(Параметры);
	СпособНачисленияАмортизацииПоУмолчанию = СпособНачисленияАмортизацииПоУмолчанию(ПорядокПогашенияСтоимости, Параметры);
	Если ДоступныеСпособыНачисленияАмортизации.Найти(СпособНачисленияАмортизацииПоУмолчанию) <> Неопределено Тогда
		СпособНачисленияАмортизации = СпособНачисленияАмортизацииПоУмолчанию;
	ИначеЕсли ДоступныеСпособыНачисленияАмортизации.Количество() > 0 Тогда
		СпособНачисленияАмортизации = ДоступныеСпособыНачисленияАмортизации[0];
	Иначе
		СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПустаяСсылка");
	КонецЕсли;
	
	НачислятьАмортизацию = НачислятьАмортизациюПоУмолчанию(ПорядокПогашенияСтоимости, СпособНачисленияАмортизации);

КонецПроцедуры

// Процедура присваивает значения из структуры ВыбранноеЗначение реквизитам формы по переданному соответствию.
// Если в структуре ВыбранноеЗначение присутствует ключ "Ссылка", то его значение присваивается в ВыбранноеЗначение перед выходом из процедуры,
// для последующей стандартной обработки выбора значения.
// Вызывается из обработчика ОбработкаВыбора для элементов справочника Основные средства.
// Параметры:
//	ВыбранноеЗначение - произвольный - переданное в обработчик значение
//	Форма - УправляемаяФорма
//	СоответствиеРеквизитов - Соответствие - где "ключ" - имя ключа в структуре, "значение" - имя реквизита формы
//	ВыборОбработан - Булево - устанавливается в "Истина", если ВыбранноеЗначение - структура, содержащая значение в ключе "Ссылка"
//
Процедура ОбработкаВыбораОсновногоСредства(ВыбранноеЗначение, ФормаОбъект, СоответствиеРеквизитов, ВыборОбработан=Ложь) Экспорт
	
	Перем Форма, Объект, Ссылка;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ВыборОбработан = ВыбранноеЗначение.Свойство("Ссылка", Ссылка);
		Если ТипЗнч(ФормаОбъект) = Тип("Структура") Тогда
			ФормаОбъект.Свойство("Форма", Форма);
			ФормаОбъект.Свойство("Объект", Объект);
			
			Для каждого ТекРеквизит Из СоответствиеРеквизитов Цикл
				
				ИмяРеквизита = ТекРеквизит.Значение;
				Если Лев(ВРег(ИмяРеквизита),7)="ОБЪЕКТ." Тогда
					Если НЕ Объект = Неопределено Тогда
						ВыбранноеЗначение.Свойство(ТекРеквизит.Ключ, Объект[Сред(ТекРеквизит.Значение, 8)]);	
					КонецЕсли;
				Иначе 
					ВыбранноеЗначение.Свойство(ТекРеквизит.Ключ, Форма[ТекРеквизит.Значение]);
				КонецЕсли;
			
			КонецЦикла;
		Иначе
			Форма = ФормаОбъект;
			Для каждого ТекРеквизит Из СоответствиеРеквизитов Цикл
				
				ИмяРеквизита = ТекРеквизит.Значение;
				Если Лев(ВРег(ИмяРеквизита),7)<>"ОБЪЕКТ." Тогда
					ВыбранноеЗначение.Свойство(ТекРеквизит.Ключ, Форма[ТекРеквизит.Значение]);
				КонецЕсли;
			
			КонецЦикла;
		КонецЕсли;
		Если ВыборОбработан Тогда
			ВыбранноеЗначение = Ссылка;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаВыбораОсновногоСредстваВТабличнойЧасти(ВыбранноеЗначение, СтандартнаяОбработка, ТекущиеДанные, ИменаРеквизитовПолей, ВыборОбработан=Ложь) Экспорт
	Перем Ссылка;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") И ТекущиеДанные <> Неопределено Тогда
		Для каждого ИмяРеквизитаПоля Из ИменаРеквизитовПолей Цикл
		
			 ВыбранноеЗначение.Свойство(ИмяРеквизитаПоля.Значение, ТекущиеДанные[ИмяРеквизитаПоля.Ключ]);
		
		КонецЦикла; 		
		ВыборОбработан = ВыбранноеЗначение.Свойство("Ссылка", Ссылка);
		Если ВыборОбработан Тогда
			ВыбранноеЗначение = Ссылка;
		КонецЕсли;
	КонецЕсли;
