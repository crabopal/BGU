// Возвращает структуру параметров для передачи ее в процедуру "ОбработкаВыбора_ОчисткаТабЧастей"
// в параметре "ДопПараметры"
//
// Возвращаемое значение:
//  Структура
Функция ДопПараметры_ОбработкаВыбора_ОчисткаТабЧастей() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ИмяРеквизита", "");
	Результат.Вставить("ЗаголовокРеквизита", "");
	Результат.Вставить("ИменаТабЧастей", Новый Структура); 
	// см. описание процедуры "УправлениеОсновнымиСредствамиКлиент.ОбработкаВыбора_ОчисткаТабЧастей"
	
	Возврат Результат;
КонецФункции	

// Выполняет обработку выбора значения реквизита в форме объекта по очистке таб. частей при необходимости.
// При необходимости очистки задает вопрос пользователю. В случае положительного отчета очищает таб. части
//
// Параметры:
//  Элемент - ПолеФормы, значение которого меняется
//  НовоеЗначение - Произвольный - новое значение реквизита формы
//  СтандартнаяОбработка - Булево - флаг стандартного обработчика "ОбработкаВыбора" реквизита
//  ДопПараметры - Структура - параметры: Ключи - значения
//    * ИмяРеквизита - Строка - имя реквизита объекта, значение которого меняется
//    * ЗаголовокРеквизита - Строка - для вывода в текст вопроса. Если не заполнен, то имя реквизита в текст впороса
//      не выводится
//    * ИменаТабЧастей - Структура - Ключ - имя таб. части, Значение - представление таб. части для вывода 
//		в текст вопроса. Таб. частей может быть несколько штук 
Процедура ОбработкаВыбора_ОчисткаТабЧастей(Элемент, НовоеЗначение, СтандартнаяОбработка, ДопПараметры) Экспорт
	
	Форма = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(Элемент, Тип("ФормаКлиентскогоПриложения"));
	СтароеЗначение = Форма.Объект[ДопПараметры.ИмяРеквизита];
	
	Если СтароеЗначение = НовоеЗначение Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

	НуженВопрос = Ложь;
	Для каждого ЭлементТЧ из ДопПараметры.ИменаТабЧастей Цикл
		Если Форма.Объект[ЭлементТЧ.Ключ].Количество() > 0 Тогда
			НуженВопрос = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
		
	Если НЕ НуженВопрос Тогда
		Возврат;
	КонецЕсли;	
			
	СтандартнаяОбработка = Ложь;

	ЕстьПараметр = Ложь;
	Текст = "";
	Если ЗначениеЗаполнено(ДопПараметры.ЗаголовокРеквизита) Тогда
		Текст = Текст + НСтр("ru = 'При изменении реквизита ""%1"" будут очищены табличные части: '");
		ЕстьПараметр = Истина;
	Иначе	
		Текст = Текст + НСтр("ru = 'При изменении реквизита '");
	КонецЕсли;	
	
	ТекстТЧ = "";
	Для каждого ТекТЧ из ДопПараметры.ИменаТабЧастей Цикл
		ТекстТЧ = ТекстТЧ + ?(ЗначениеЗаполнено(ТекстТЧ), ", """, """") + ТекТЧ.Значение + """";
	КонецЦикла;	
	
	Текст = Текст + ТекстТЧ + НСтр("ru = '. Продолжить?'");
	Если ЕстьПараметр Тогда
		Текст = СтрШаблон(Текст, ДопПараметры.ЗаголовокРеквизита);
	КонецЕсли;
	
	Параметры = Новый Структура("Элемент, Параметры", Элемент, ДопПараметры);
	ОповещениеДляФормы = Новый ОписаниеОповещения("ОбработкаВыбора_ОчисткаТабЧастей_Завершение", Форма, Параметры);
	
	Параметры1 = Новый Структура("Форма, НовоеЗначение, Оповещение, Параметры", 
		Форма, НовоеЗначение, ОповещениеДляФормы, ДопПараметры);
	Оповещение = Новый ОписаниеОповещения("ОбработкаВыбора_ОчисткаТабЧастей_Завершение", ЭтотОбъект, Параметры1);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да);
КонецПроцедуры

// Обработчик оповещения после вопроса об очистке таб.частей из процедуры 
// УправлениеОсновнымиСредствамиКлиент.ОбработкаВыбора_ОчисткаТабЧастей
Процедура ОбработкаВыбора_ОчисткаТабЧастей_Завершение(Результат, ДопПараметры) Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Форма.Объект[ДопПараметры.Параметры.ИмяРеквизита] = ДопПараметры.НовоеЗначение;
	Для каждого ТекТЧ из ДопПараметры.Параметры.ИменаТабЧастей Цикл
		ДопПараметры.Форма.Объект[ТекТЧ.Ключ].Очистить();
	КонецЦикла;	

	ВыполнитьОбработкуОповещения(ДопПараметры.Оповещение);
КонецПроцедуры	

// Заполняет строковые реквзиты членов комиссии и председателя Должность, Фамилия,Имя Отчество
// в документах по ОС на закладке комиссия. Используется в документах, созданных до приказа 61н
//
// Параметры:
//  ОбъектФормы - ДанныеФормыКоллекция, ДанныеФормыСтруктура - текщие данные строки таб.части "Комиссия"
//				или реквизит формы "Объект"
//  Дата - Дата
//  ЭтоПредседатель - Булево
Процедура ЗаполнитьДанныеЧленаКомиссии(ОбъектФормы, Дата, ЭтоПредседатель = Ложь) Экспорт
	Если ЭтоПредседатель Тогда
		ИмяРеквизита = "Председатель";
		Суффикс = "ПредседателяКомиссии";
	Иначе	
		ИмяРеквизита = "Сотрудник";
		Суффикс = "ЧленаКомиссии";
	КонецЕсли;	
	ТекСотрудник = ?(ЭтоПредседатель, ОбъектФормы.Председатель, ОбъектФормы.Сотрудник);
	ТекДанные = УправлениеОсновнымиСредствамиВызовСервера.ДанныеЧленаКомиссии(ОбъектФормы[ИмяРеквизита], Дата);  
	
	ОбъектФормы["Должность" + Суффикс] = ТекДанные.Должность;
	ОбъектФормы["Фамилия" + Суффикс] = ТекДанные.Фамилия;
	ОбъектФормы["Имя" + Суффикс] = ТекДанные.Имя;
	ОбъектФормы["Отчество" + Суффикс] = ТекДанные.Отчество;
КонецПроцедуры	

#Область ЗаполнениеДокументовНаОснованииДругДруга

// Выполняет действия по вводу целевого документа  на основании документа-основания.
// Формирует массив разделителей, если документов может быть введно несколько. Предлагает выбор разделителя.
// 
// Параметры:
//	ДокументОснования - ДокументСсылка - ссылка на документ-основание
//	ФормаИсточника - ФормаКлиентскогоПриложения - форма, из которой инициируется ввод на основании
//	Оповещение - ОписаниеОповещения - описание оповещения, которое будет вызвано после выбора разделителя документа
//	ИмяЦелевогоДокумента - Строка - имя вида документа, который вводится на основании, например, "СписаниеОбъектовОС" 
Процедура ВвестиЦелевойДокументНаОсновании(
	ДокументОснования, ФормаИсточника, Оповещение = Неопределено, ИмяЦелевогоДокумента = "СписаниеОбъектовОС") Экспорт
	
	СсылкаЦелевогоДокумента = Неопределено;
	Если Оповещение <> Неопределено И ТипЗнч(Оповещение.ДополнительныеПараметры) = Тип("Структура")
		И Оповещение.ДополнительныеПараметры.Свойство("СсылкаЦелевогоДокумента") Тогда
		СсылкаЦелевогоДокумента = Оповещение.ДополнительныеПараметры.СсылкаЦелевогоДокумента;
	КонецЕсли;	
	
	ДанныеРазделителей = УправлениеОсновнымиСредствамиВызовСервера.ТаблицаРазделителейДокументов(
		ДокументОснования, ИмяЦелевогоДокумента, СсылкаЦелевогоДокумента);
	
	МассивРазделителей = ДанныеРазделителей.Разделители;
	Если МассивРазделителей.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'Вероятно, на основании документа ""%1"" все необходимые документы уже введены'"), 
		ДокументОснования));
	ИначеЕсли МассивРазделителей.Количество() = 1 Тогда
		Разделитель = СтруктураРазделителяДокументов(МассивРазделителей);
		ЗаполнитьЗначенияСвойств(Разделитель, МассивРазделителей[0]);
		Если Оповещение <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(Оповещение, Разделитель);
		Иначе	
			ОткрытьФормуЦелевогоДокумента(ДокументОснования, Разделитель, ФормаИсточника, ИмяЦелевогоДокумента);
		КонецЕсли;	
		  
	ИначеЕсли МассивРазделителей.Количество() > 1 Тогда         
		ПараметрыФормы = Новый Структура("РазделителиДокументов", ДанныеРазделителей);
		ПараметрыОповещения = Новый Структура(
			"ДокументОснования, ОповещениеИсходное, ФормаИсточника, ИмяЦелевогоДокумента", 
			ДокументОснования, Оповещение, ФормаИсточника, ИмяЦелевогоДокумента);
		ОповещениеОЗавершении = Новый ОписаниеОповещения(
			"ВвестиЦелевойДокументНаОсновании_Завершение", ЭтотОбъект, ПараметрыОповещения);
		ОткрытьФорму("ОбщаяФорма.ВыборРазделителяДокументов", 
			ПараметрыФормы,,,,, ОповещениеОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры

Процедура ВвестиЦелевойДокументНаОсновании_Завершение(Результат, Параметры) Экспорт
	Разделитель = СтруктураРазделителяДокументов(Результат);
	Если Разделитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ПерваяСтрока = Истина;
	Для каждого ТекСтрока из Результат Цикл                      
		ЗаполнитьЗначенияСвойств(Разделитель, ТекСтрока);
		Если ПерваяСтрока И Параметры.ОповещениеИсходное <> Неопределено Тогда
			ПерваяСтрока = Ложь;
			ВыполнитьОбработкуОповещения(Параметры.ОповещениеИсходное, Разделитель);
			Продолжить;
		КонецЕсли;	
		
		ОткрытьФормуЦелевогоДокумента(
			Параметры.ДокументОснования, Разделитель, Параметры.ФормаИсточника, Параметры.ИмяЦелевогоДокумента);
	КонецЦикла;	
КонецПроцедуры	

#КонецОбласти

#Область ЗаполнениеРеквизитаПричинаСписания

// Обработчик события "НачалоВыбора" элемента формы строкового реквизита "ПричинаСписания" объекта
//
// Параметры:
//  Элемент - ПолеФормы - поле реквизита "ПричинаСписания"
//  ТекущиеДанные - ДанныеФормыЭлементКоллекции или ДанныеФормыСтруктура - текущая строка табличной части, 
//    или сам Объект, если реквизит находится в шапке
//  СтандартнаяОбработка - Булево - флаг стандартной обработки формы                                         
//  ЕстьПричинаСписанияСсылка - Булево - если Истина, то в ТекущиеДанные есть реквизит ПричинаСписанияСсылка 
//  ссылочного типа, и его нужно заполнить. Если Ложь, то реквизита ссылочного типа нет и заполнять его не надо
Процедура ПричинаСписанияНачалоВыбора(Элемент, ТекущиеДанные, СтандартнаяОбработка, ЕстьПричинаСписанияСсылка = Истина) Экспорт
	СтандартнаяОбработка = Ложь;                                           
	Если НЕ ЕстьПричинаСписанияСсылка Тогда
		ПарамВыбора = Новый Структура("РезультатВозвращатьСтруктурой", Истина);
	Иначе	
		ПарамВыбора = Новый Структура("ТекущаяСтрока, РезультатВозвращатьСтруктурой", 
			ТекущиеДанные.ПричинаСписанияСсылка, Истина);
	КонецЕсли;		
	ОткрытьФорму("Справочник.ПричиныСписанияНФА.ФормаВыбора", ПарамВыбора, Элемент);
КонецПроцедуры

// Обработчик события "ОбработкаВыбора" жлемента формы строкового типа "ПричинаСписания" объекта
//
// Параметры:
//  ТекущиеДанные - ДанныеФормыЭлементКоллекции или ДанныеФормыСтруктура - текущая строка табличной части, 
//    или сам Объект, если реквизит находится в шапке
//  ВыбранноеЗначение - Структура - возвращаемое значение формы выбора справочника "ПричиныСписанияНФА"
//    Ключи: 
//      * Ссылка - СправочникСсылка.ПричиныСписанияНФА - ссылка на выбранное значение
//      * Наименование - Строка - наименование выбранного значения
//  ЕстьПричинаСписанияСсылка - Булево - если Истина, то в ТекущиеДанные есть реквизит ПричинаСписанияСсылка 
//  ссылочного типа, и его нужно заполнить. Если Ложь, то реквизита ссылочного типа нет и заполнять его не надо
Процедура ПричинаСписанияОбработкаВыбора(ТекущиеДанные, ВыбранноеЗначение, ЕстьПричинаСписанияСсылка = Истина) Экспорт
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;	
	
	Если ЕстьПричинаСписанияСсылка Тогда
		ТекущиеДанные.ПричинаСписанияСсылка = ВыбранноеЗначение.Ссылка;
	КонецЕсли;	
	ВыбранноеЗначение = ВыбранноеЗначение.Наименование;
КонецПроцедуры

#КонецОбласти

#Область СуммыРемонтаИМодернизацииПоКФО

// Открывает форму для ручного распределения затрат на ремонт и модернизацию по КФО
//
// Параметры:
//  Форма - ДанныеФормыСтруктура - форма документа, из которого вызвана процедура
//  ДопПараметры - Структура - параметры, передаваемые форме при открытии
//  ЭтоШапка - Булево - флаг, определяющий откуда открывается форма, из шапки документа
//                или из строки табличной части
Процедура ОткрытьФормуРаспределениеПоКФО(Форма, ДопПараметры, ЭтоШапка = Ложь) Экспорт
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ЭтоШапка", ЭтоШапка);
	ПараметрыОповещения.Вставить("Форма", Форма);
	ОткрытьФорму("Документ.РеконструкцияОС.Форма.РаспределениеПоКФО",
		ДопПараметры,
		Форма,,,,
		Новый ОписаниеОповещения("ОткрытьФормуРаспределениеПоКФО_Завершение", ЭтотОбъект, ПараметрыОповещения),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

// Процедура оповещения при закрытии формы ручного распределения затрат на ремонт и модернизицию
//
// Параметры:
//  Результат - Произвольный - результат возвращаемый закрываемой формой
//  ДопПараметры - Структура - дополнитлеьныепараметры 
Процедура ОткрытьФормуРаспределениеПоКФО_Завершение(Результат, ДопПараметры) Экспорт
	Если ТипЗнч(Результат) <> Тип("ДанныеФормыКоллекция") Тогда
		Возврат;
	КонецЕсли;
		
	Форма = ДопПараметры.Форма;
	Объект = Форма.Объект;		
	Если ДопПараметры.ЭтоШапка Тогда
		Для каждого ТекСтрока из Результат Цикл
			Объект["Сумма" + ТекСтрока.КФО] = ТекСтрока["Сумма"];
		КонецЦикла;	
		УправлениеОсновнымиСредствамиКлиентСервер.РаспределитьЗатратыПоСуммамХвТЧ(Форма);
		УправлениеОсновнымиСредствамиКлиентСервер.СформироватьЗаголовокСуммыПоКФО(Форма);
	Иначе		
		СтрокаТЧ = Форма.Элементы.ОсновныеСредства.ТекущиеДанные;
		Для каждого ТекСтрока из Результат Цикл
			СтрокаТЧ["Сумма" + ТекСтрока.КФО] = ТекСтрока["Сумма"];
		КонецЦикла;	
		УправлениеОсновнымиСредствамиКлиентСервер.СформироватьЗаголовокСуммыПоКФОвТЧ(СтрокаТЧ);
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти

#Область СервисРегистрацииОбремененийИнвентарныхОбъектов

// Открывает форму для регистрации обременений для инвентарных объектов документа и передает в нее все необходимые
// параметры
//
// Параметры:
//   Объект - ДанныеФормыСтруктура - Реквизит формы "Объект" документа, из формы которого вызывается процедура.
Процедура ОткрытьФормуРегистрацииОбременений(Объект) Экспорт
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Контрагент", Объект.Контрагент);
	ПараметрыФормы.Вставить("Договор", Объект.Договор);
	ПараметрыФормы.Вставить("ВидОперации", Объект.ВидОперации);
	ПараметрыФормы.Вставить("Объекты", Новый Массив);
	Для каждого ТекСтрока из Объект.ОсновныеСредства Цикл  
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ИнвентарныйНомер) Тогда
			Продолжить;
		КонецЕсли;	   
		
		СтрокаПередачи = Новый Структура("ОсновноеСредство, ИнвентарныйНомер"); 
		ЗаполнитьЗначенияСвойств(СтрокаПередачи, ТекСтрока);
		ПараметрыФормы.Объекты.Добавить(СтрокаПередачи);
	КонецЦикла;	
	
	ОткрытьФорму("Документ.ПередачаОбъектовОС.Форма.ФормаРегистрацииОбременений", ПараметрыФормы, ЭтотОбъект
		,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры	

#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

// УСТАРЕЛА. Используется в документах пр. 173н
//
Процедура ПроверитьЗаписатьПринятиеКУчетуПередРасчетомСтоимости(Форма, ИмяОбработчика, СообщатьОбОшибках) Экспорт

	Кнопки = Новый СписокЗначений;
	Если Форма.Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Перед расчетом стоимости необходимо отменить проведение и записать документ.'");
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Отменить проведение и записать документ'"));
		РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
	Иначе
		ТекстВопроса = НСтр("ru = 'Перед расчетом стоимости необходимо записать документ.'");
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Записать документ'"));
		РежимЗаписи = РежимЗаписиДокумента.Запись;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Изменена дата документа.'")
					+ ТекстВопроса + "
		|Продолжить?";
		
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);	
	
	ПоказатьВопрос(Новый ОписаниеОповещения(ИмяОбработчика, Форма, Новый Структура("РежимЗаписи, СообщатьОбОшибках", РежимЗаписи, СообщатьОбОшибках)), ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Да);

КонецПроцедуры // ЗаписатьПринятиеКУчетуПередРасчетомСтоимости()

// УСТАРЕЛА. Следует использовать УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования
//
Функция РасчетСрокаПолезногоИспользования(АмортизационнаяГруппа) Экспорт
	Возврат УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(АмортизационнаяГруппа);
КонецФункции

// УСТАРЕЛА. Следует использовать УправлениеОсновнымиСредствамиКлиентСервер.ИзменитьДоступностьВариантыВыбораПараметровАмортизации
//
Процедура ИзменитьДоступностьВариантыВыбораПараметровАмортизации(	ПорядокПогашенияСтоимости,
																	СпособНачисленияАмортизации, 
																	ОграничениеСпособаНачисленияАмортизации = Неопределено) Экспорт
																	
	УправлениеОсновнымиСредствамиКлиентСервер.ИзменитьДоступностьВариантыВыбораПараметровАмортизации(	ПорядокПогашенияСтоимости,
																										СпособНачисленияАмортизации, 
																										ОграничениеСпособаНачисленияАмортизации);

КонецПроцедуры

// УСТАРЕЛА.
Процедура УстановитьКомиссиюВДокументОС(КомиссияСсылка, Объект, Форма, НомерПриказа=Неопределено, ДатаПриказа = Неопределено) Экспорт
	Объект.СоставКомиссии.Очистить();
	Объект.ДолжностьПредседателяКомиссии	= "";	
	Объект.ФамилияПредседателяКомиссии		= "";
	Объект.ИмяПредседателяКомиссии			= "";
	Объект.ОтчествоПредседателяКомиссии		= "";
	НомерПриказа	= "";
	ДатаПриказа		= Дата('00010101');
	
	ТекущаяКомиссия = ОбщегоНазначенияБГУВызовСервера.ПолучитьДанныеКомиссии(КомиссияСсылка, Объект.Дата);
	НомерПриказа	= ТекущаяКомиссия.НомерПриказа;
	ДатаПриказа		= ТекущаяКомиссия.ДатаПриказа;
	ДанныеКомиссии	= ТекущаяКомиссия.ДанныеКомиссии;
	Для каждого ТекСтрокаКомиссии Из ДанныеКомиссии Цикл
		
		Если ТекСтрокаКомиссии.Председатель Тогда
			Объект.ДолжностьПредседателяКомиссии	= ТекСтрокаКомиссии.ДолжностьЧленаКомиссии;
			Объект.ФамилияПредседателяКомиссии		= ТекСтрокаКомиссии.ФамилияЧленаКомиссии;
			Объект.ИмяПредседателяКомиссии			= ТекСтрокаКомиссии.ИмяЧленаКомиссии;
			Объект.ОтчествоПредседателяКомиссии		= ТекСтрокаКомиссии.ОтчествоЧленаКомиссии;
		Иначе
			ЗаполнитьЗначенияСвойств(Объект.СоставКомиссии.Добавить(), ТекСтрокаКомиссии);
		КонецЕсли;
	
	КонецЦикла;
	Форма.Модифицированность = Истина;
КонецПроцедуры

// УСТАРЕЛА. Следует использовать ОбщегоНазначенияБГУКлиент.ОткрытьПодборКомиссии
Процедура ОткрытьПодборКомиссии(Элемент, Организация, Дата) Экспорт
	
	ПараметрыФормы = Новый Структура(	"ТребуемыеДанные, Отбор, ЗакрыватьПриВыборе",
										"Фамилия, Имя, Отчество, Должность",
										Новый Структура("Владелец", Организация),
										Ложь);
	ОткрытьФорму("Справочник.Сотрудники.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

// УСТАРЕЛА. Следует использовать ОбщегоНазначенияБГУКлиент.ОбработатьПодборКомиссии
Процедура ОбработатьПодборКомиссии(Объект, Форма, ВыбранноеЗначение, СтандартнаяОбработка) Экспорт
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		НоваяСтрока = Объект.СоставКомиссии.Добавить();
		ВыбранноеЗначение.Свойство("Должность", НоваяСтрока.ДолжностьЧленаКомиссии);
		ВыбранноеЗначение.Свойство("Фамилия", 	НоваяСтрока.ФамилияЧленаКомиссии);
		ВыбранноеЗначение.Свойство("Имя", 		НоваяСтрока.ИмяЧленаКомиссии);
		ВыбранноеЗначение.Свойство("Отчество",	НоваяСтрока.ОтчествоЧленаКомиссии);
		
		СтандартнаяОбработка = Ложь;
		Форма.Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

// УСТАРЕЛА. Следует использовать ОбщегоНазначенияБГУКлиент.НачатьВыборПредседателяКомиссии
Процедура ОткрытьВыборПредседателяКомиссии(Элемент, Организация, Дата) Экспорт
	
	ПараметрыФормы = Новый Структура(	"ТребуемыеДанные, Отбор, ЗакрыватьПриВыборе",
										"Фамилия, Имя, Отчество, Должность",
										Новый Структура("Владелец", Организация),
										Истина);
	ОткрытьФорму("Справочник.Сотрудники.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

// УСТАРЕЛА. 
Процедура ОбработатьВыборПредседателяКомиссии(Форма, ВыбранноеЗначение, СтандартнаяОбработка, Должность, Фамилия, Имя, Отчество) Экспорт
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ВыбранноеЗначение.Свойство("Должность", Должность);
		ВыбранноеЗначение.Свойство("Фамилия", 	Фамилия);
		ВыбранноеЗначение.Свойство("Имя", 		Имя);
		ВыбранноеЗначение.Свойство("Отчество",	Отчество);
		
		Если Не ЗначениеЗаполнено(Фамилия) Тогда
			ЧастиИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(Строка(ВыбранноеЗначение.Ссылка));
			Если ЧастиИмени.Количество() > 0 Тогда
				Фамилия = ЧастиИмени[0];
				Если ЧастиИмени.Количество() > 1 Тогда
					Имя = ЧастиИмени[1];
					Если ЧастиИмени.Количество() > 2 Тогда
						Отчество = ЧастиИмени[2];
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		СтандартнаяОбработка = Ложь;
		Форма.Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

// УСТАРЕЛА. Переопределение стандартного события НачалоВыбора для счета затрат
//
Процедура СчетУчетаЗатратНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ПараметрыВызова) Экспорт
	Перем Счет, КПС, КФО, Организация, ИФО, Дата;
	
	СписокСчетов = Новый СписокЗначений;
	СписокСчетов.Добавить("106.3И");
	СписокСчетов.Добавить("106.4И");
	СписокСчетов.Добавить("109.00");
	СписокСчетов.Добавить("401.20");

	ПараметрыФормы = Новый Структура("ОграниченияСписокСчетов", СписокСчетов);
		Если ТипЗнч(ПараметрыВызова) = Тип("Структура") Тогда
			Если ПараметрыВызова.Свойство("Счет") Тогда
				ПараметрыФормы.Вставить("ТекущаяСтрока", ПараметрыВызова.Счет);
			КонецЕсли;
		КонецЕсли;
		ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);
		СтандартнаяОбработка = Ложь;

КонецПроцедуры

// УСТАРЕЛА. Процедура устанавливает доступность группы формы, содержащей реквизиты счета затрат по амортизации
// Параметры:
//	ПорядокПогашенияСтоимости - Перечисление.ПорядокПогашенияСтоимости
//	ГруппаСчетаЗатрат - ГруппаФормы
//
Процедура ИзменитьДоступностьГруппыСчетаЗатрат(	ПорядокПогашенияСтоимости, ГруппаСчетаЗатрат, Знач Форма = Неопределено) Экспорт
	//ГруппаСчетаЗатрат.Доступность = ПорядокПогашенияСтоимости <> ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");
	МассивЭлементовГруппы = Новый Массив;
	ВыбратьРекурсивноИменаПодчиненныхЭлементов(ГруппаСчетаЗатрат, МассивЭлементовГруппы);
	Если Форма = Неопределено Тогда
		Форма = ГруппаСчетаЗатрат;
		Пока Форма <> Неопределено И ТипЗнч(Форма) <> Тип("ФормаКлиентскогоПриложения") Цикл
			Форма = Форма.Родитель;
		КонецЦикла;
	КонецЕсли;
	Доступность = ЗначениеЗаполнено(ПорядокПогашенияСтоимости)
				И ПорядокПогашенияСтоимости <> ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, МассивЭлементовГруппы, "Доступность", Доступность);
КонецПроцедуры

// УСТАРЕЛА.
Процедура ВыбратьРекурсивноИменаПодчиненныхЭлементов(Группа, МассивЭлементов)

	Для каждого ПодчиненныйЭлемент Из Группа.ПодчиненныеЭлементы Цикл
	
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ГруппаФормы") Тогда
			
			ВыбратьРекурсивноИменаПодчиненныхЭлементов(ПодчиненныйЭлемент, МассивЭлементов);
			
		Иначе
			
			МассивЭлементов.Добавить(ПодчиненныйЭлемент.Имя);	
			
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры

