Функция ПолучитьТаблицыАмортизацииТекущегоМесяца(ДокументСсылка, ЭтоИмуществоКазны = Ложь) Экспорт
	
	ТаблицыАмортизации = УправлениеОсновнымиСредствами.ПолучитьТаблицыАмортизацииТекущегоМесяца(ДокументСсылка, ЭтоИмуществоКазны);
	
	Возврат ТаблицыАмортизации;
	
КонецФункции

Функция ДоговорНФА(Период, Организация, НФА, ЭтоКапВложение) Экспорт
	
	Если ЗначениеЗаполнено(Период) Тогда
		ТипПериода = ТипЗнч(Период);
		Если ТипПериода = Тип("Дата") Тогда
			ГраницаСреза = Новый Граница(Период, ВидГраницы.Включая);
		Иначе
			ГраницаСреза = Новый Граница(Период.МоментВремени(), ВидГраницы.Исключая);
		КонецЕсли;
	Иначе
		ГраницаСреза = '00010101000000'; // Последнее актуальное значение регистра.
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"				, ГраницаСреза);
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, НФА);
	
	Если ЭтоКапВложение Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Договор
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет В (&СписокСчетов),
		|			&СписокСубконто,
		|			Организация = &Организация
		|				И Субконто1 = &ОсновноеСредство) КАК ЖурналПроводокЕПСБУОстатки";
		
		Запрос.УстановитьПараметр("СписокСчетов"	, БухгалтерскийУчет.СписокСчетов("106.90"));
		Запрос.УстановитьПараметр("СписокСубконто"	, БухгалтерскийУчет.СписокСубконто("ОсновныеСредства,Договоры"));
		
	Иначе
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СтоимостьОбъектовОСОстатки.Договор КАК Договор
		|ИЗ
		|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ОсновноеСредство = &ОсновноеСредство
		|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки";
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Договор;
	Иначе
		Результат = Справочники.Договоры.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПараметрыАмортизацииОС(ОсновноеСредство, Период) Экспорт
	
	Возврат УправлениеОсновнымиСредствами.ПолучитьПараметрыАмортизацииОС(ОсновноеСредство, Период);
	
КонецФункции

Функция ПараметрыАмортизацииОбъектовОС(Ссылка) Экспорт
	
	Если Ссылка.Метаданные().ТабличныеЧасти.Найти("ОсновныеСредства") <> Неопределено Тогда
		ОсновныеСредства = Ссылка.ОсновныеСредства.ВыгрузитьКолонку("ОсновноеСредство");
	Иначе
		ОсновныеСредства = Новый Массив;
		ОсновныеСредства.Добавить(Ссылка.ОсновноеСредство);
	КонецЕсли;
	
	Возврат УправлениеОсновнымиСредствами.ПараметрыАмортизацииОбъектовОС(ОсновныеСредства, Ссылка);
	
КонецФункции

Функция ПолучитьОстаткиОС(ДокументСсылка,
							Период,
							ИмяТЧ = "ОсновныеСредства",
							КолонкаОС = "ОсновноеСредство",
							КолонкаКоличество = "Количество",
							ЦМО = Неопределено,
							КФО = Неопределено,
							КПС = Неопределено,
							ИФО = Неопределено,
							Подразделение = Неопределено,
							ВключатьБалансовыеСуммы = Ложь,
							ВключатьЗабалансовыеСуммы = Ложь,
							ВключатьСуммыВложений = Ложь,
							ВнеоборотныйАктив = Неопределено) Экспорт
	
	ТипЦМО = Новый ОписаниеТипов("СправочникСсылка.ЦМО");
	ТипКФО = Новый ОписаниеТипов("ПеречислениеСсылка.КВД");
	ТипКПС = Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов");
	ТипИФО = Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения");
	ТипПодразделение = Новый ОписаниеТипов("СправочникСсылка.Подразделения");
	
	Параметры = Новый Структура;
	Параметры.Вставить("Период", Период);
	Параметры.Вставить("Организация", ДокументСсылка.Организация);
	Параметры.Вставить("ВключатьБалансовыеСуммы", ВключатьБалансовыеСуммы);
	Параметры.Вставить("ВключатьЗабалансовыеСуммы", ВключатьЗабалансовыеСуммы);
	Параметры.Вставить("ВключатьСуммыВложений", ВключатьСуммыВложений);
	Параметры.Вставить("ЦМО", ТипЦМО.ПривестиЗначение(ЦМО));
	Параметры.Вставить("КФО", ТипКФО.ПривестиЗначение(КФО));
	Параметры.Вставить("КПС", ТипКПС.ПривестиЗначение(КПС));
	Параметры.Вставить("ИФО", ТипИФО.ПривестиЗначение(ИФО));
	Параметры.Вставить("Подразделение", ТипПодразделение.ПривестиЗначение(Подразделение));
	
	ОсновныеСредстваДокумента = Новый ТаблицаЗначений;
	ОсновныеСредстваДокумента.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ОсновныеСредстваДокумента.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3)));
	
	Если ЗначениеЗаполнено(ВнеоборотныйАктив) Тогда
		НовСтрОС = ОсновныеСредстваДокумента.Добавить();
		НовСтрОС.ОсновноеСредство = ВнеоборотныйАктив;
		НовСтрОС.Количество = ДокументСсылка[ИмяТЧ].Итог(КолонкаКоличество);
	Иначе
		Для Каждого ТекСтрокаОС Из ДокументСсылка[ИмяТЧ] Цикл
			НовСтрОС = ОсновныеСредстваДокумента.Добавить();
			НовСтрОС.ОсновноеСредство = ТекСтрокаОС[КолонкаОС];
			НовСтрОС.Количество = ТекСтрокаОС[КолонкаКоличество];
		КонецЦикла;
	КонецЕсли;
	
	Параметры.Вставить("ОсновныеСредстваДокумента", ОсновныеСредстваДокумента);
	
	Возврат ПолучитьОстаткиОСПоТаблицеОС(Параметры);
	
КонецФункции

Функция ПолучитьОстаткиОСЗабаланс(ДокументСсылка) Экспорт
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	Если МетаданныеДокумента.ТабличныеЧасти.Найти("ОсновныеСредства") = Неопределено Тогда
		ОсновныеСредства = Новый ТаблицаЗначений;
		ОсновныеСредства.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1,0)));
		ОсновныеСредства.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ОсновныеСредства.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
		ОсновныеСредства.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3)));
		ОсновныеСредства.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));
		
		НовСтр = ОсновныеСредства.Добавить();
		НовСтр.НомерСтроки		= 1;
		НовСтр.ОсновноеСредство = ДокументСсылка.ОсновноеСредство;
		НовСтр.ИнвентарныйНомер	= ДокументСсылка.ИнвентарныйНомер;
		НовСтр.Количество		= 1;
		НовСтр.Сумма			= ДокументСсылка.Сумма;
		
	Иначе
		Попытка
			ОсновныеСредства = 
				Документы[МетаданныеДокумента.Имя].ДанныеТЧдляПроверкиОстатковЗабалансомВТО(ДокументСсылка);
		Исключение	
			ОсновныеСредства = ДокументСсылка.ОсновныеСредства.Выгрузить();
		КонецПопытки;	
	КонецЕсли;
	
	КФОвШапке = МетаданныеДокумента.Реквизиты.Найти("КФО") <> Неопределено;
	Если МетаданныеДокумента.Реквизиты.Найти("ЦМООтправитель")<>Неопределено Тогда
		ИмяРеквизитаЦМО = "ЦМООтправитель";
	Иначе
		ИмяРеквизитаЦМО = "ЦМО";
	КонецЕсли;
	Если МетаданныеДокумента.Реквизиты.Найти("ПодразделениеОтправитель")<>Неопределено Тогда
		ИмяРеквизитаПодразделение = "ПодразделениеОтправитель";
	Иначе
		ИмяРеквизитаПодразделение = "Подразделение";
	КонецЕсли;
	                                   
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Договор,
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстаток,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстаток,
	|	ЕПСБУ.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ЕПСБУ.УчетПоКПС КАК УчетПоКПС
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетовД),
	|			&ВидыСубконтоД,
	|			Организация = &Организация
	|				И (ИФО = &ИФО
	|					ИЛИ НЕ &УчетПоИФО)
	|				И (КФО = &КФО
	|					ИЛИ &ПоВсемКФО = ИСТИНА)
	|				И Субконто1 В (&СписокОС)
	|				И Субконто2 = &ЦМО) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ЕПСБУ.Ссылка";
	
	Запрос.Текст = 	Запрос.Текст + "
	| ОБЪЕДИНИТЬ ВСЕ
	|";	
	
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор,
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстаток,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстаток,
	|	ЕПСБУ.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ЕПСБУ.УчетПоКПС КАК УчетПоКПС
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетовК),
	|			&ВидыСубконтоК,
	|			Организация = &Организация
	|				И (ИФО = &ИФО
	|					ИЛИ НЕ &УчетПоИФО)
	|				И (КФО = &КФО
	|					ИЛИ &ПоВсемКФО = ИСТИНА)
	|				И Субконто1 В (&СписокОС)
	|				И Субконто2 = &ЦМО) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ЕПСБУ.Ссылка";
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектаОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаЗдания") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Субконто2 = &ЦМО", "И Субконто2 = &ЦМО И Субконто3 = &Контрагент");
		Запрос.УстановитьПараметр("Контрагент", ДокументСсылка.Контрагент);
	КонецЕсли;
	
	Запрос.Текст = 	Запрос.Текст + "
	| ОБЪЕДИНИТЬ ВСЕ
	|";
	
	Запрос.Текст = 	Запрос.Текст + 
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор,
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстаток,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстаток,
	|	ЕПСБУ.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ЕПСБУ.УчетПоКПС КАК УчетПоКПС
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетов),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И (ИФО = &ИФО
	|					ИЛИ НЕ &УчетПоИФО)
	|				И (КФО = &КФО
	|					ИЛИ &ПоВсемКФО = ИСТИНА)
	|				И Субконто1 В (&СписокОС)
	|				И Субконто2 = &ЦМО) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ЕПСБУ.Ссылка";
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	ВидыСубконтоК = Новый Массив;
	ВидыСубконтоК.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконтоК.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);	
	ВидыСубконтоК.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	
	ВидыСубконтоД = Новый Массив;
	ВидыСубконтоД.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконтоД.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);	
	ВидыСубконтоД.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	
	СписокСчетовВсе	= БухгалтерскийУчет.СписокСчетов("01,02,22");
	СписокСчетов	= Новый Массив;
	СписокСчетовК	= Новый Массив;
	СписокСчетовД	= Новый Массив;
	Для Каждого Счет Из СписокСчетовВсе Цикл
		Если БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Счет, ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства) Тогда
			Если БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Счет, ПланыВидовХарактеристик.ВидыСубконто.Договоры) Тогда
				СписокСчетовД.Добавить(Счет);
			ИначеЕсли БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Счет, ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) Тогда
				СписокСчетовК.Добавить(Счет);
			Иначе
				СписокСчетов.Добавить(Счет);
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
	
	ФОУчетПоИФО 				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ФОУчетПоПодразделениям 		= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Запрос.УстановитьПараметр("Период",				ДокументСсылка.МоментВремени());
	Запрос.УстановитьПараметр("СписокСчетовД",		СписокСчетовД);
	Запрос.УстановитьПараметр("ВидыСубконтоД",		ВидыСубконтоД);	
	Запрос.УстановитьПараметр("СписокСчетовК",		СписокСчетовК);
	Запрос.УстановитьПараметр("ВидыСубконтоК",		ВидыСубконтоК);
	Запрос.УстановитьПараметр("СписокСчетов",		СписокСчетов);
	Запрос.УстановитьПараметр("ВидыСубконто",		ВидыСубконто);	
	Запрос.УстановитьПараметр("Организация",		ДокументСсылка.Организация);
	Запрос.УстановитьПараметр("ИФО",				ДокументСсылка.ИФО);
	Запрос.УстановитьПараметр("УчетПоИФО",			ФОУчетПоИФО);
	Если КФОвШапке Тогда
		Запрос.УстановитьПараметр("КФО",			ДокументСсылка.КФО);
		Запрос.УстановитьПараметр("ПоВсемКФО",		Ложь);
	Иначе
		Запрос.УстановитьПараметр("КФО",			Неопределено);
		Запрос.УстановитьПараметр("ПоВсемКФО",		Истина);
	КонецЕсли;
		
	Запрос.УстановитьПараметр("СписокОС",			ОсновныеСредства.ВыгрузитьКолонку("ОсновноеСредство"));
	Запрос.УстановитьПараметр("ЦМО",				ДокументСсылка[ИмяРеквизитаЦМО]);
	
	ОстаткиОС = Запрос.Выполнить().Выгрузить();
	
	Если ОсновныеСредства.Колонки.Найти("Контрагент") = Неопределено Тогда
		ОсновныеСредства.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	КонецЕсли;	
	Если ОсновныеСредства.Колонки.Найти("Договор") = Неопределено Тогда
		ОсновныеСредства.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	КонецЕсли;	
	ОсновныеСредства.Колонки.Добавить("СуммаВУчете",	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));
	Если ОсновныеСредства.Колонки.Найти("СчетУчета") = Неопределено Тогда
		ОсновныеСредства.Колонки.Добавить("СчетУчета",		Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	КонецЕсли;
	ОсновныеСредства.Колонки.Добавить("Нехватка", 		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1,0)));
	ОсновныеСредства.Колонки.Добавить("ОСРаспределен",	Новый ОписаниеТипов("Булево"));
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	КПСвШапке = МетаданныеДокумента.Реквизиты.Найти("КПС") <> Неопределено;
	КПСвТЧ = НЕ КПСвШапке И МетаданныеДокумента.ТабличныеЧасти.Найти("ОсновныеСредства") <> Неопределено 
			И МетаданныеДокумента.ТабличныеЧасти.ОсновныеСредства.Реквизиты.Найти("КПС") <> Неопределено;
	Если КПСвШапке Тогда
		КПСДокумента = ДокументСсылка.КПС;
	КонецЕсли;
	ПодразделениеДокумента = ДокументСсылка[ИмяРеквизитаПодразделение];
	
	Для каждого ТекОсновноеСредство Из ОсновныеСредства Цикл
	
		СтруктураПоиска = Новый Структура("ОсновноеСредство", ТекОсновноеСредство.ОсновноеСредство);
		Если Не КФОвШапке Тогда
			СтруктураПоиска.Вставить("КФО", ТекОсновноеСредство.КФО);
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекОсновноеСредство.Контрагент) Тогда
			СтруктураПоиска.Вставить("Контрагент", ТекОсновноеСредство.Контрагент);
		КонецЕсли;	
		Если ЗначениеЗаполнено(ТекОсновноеСредство.Договор) Тогда
			СтруктураПоиска.Вставить("Договор", ТекОсновноеСредство.Договор);
		КонецЕсли;	
		
		НайденыСтроки = ОстаткиОС.НайтиСтроки(СтруктураПоиска);
		
		Если НайденыСтроки.Количество() = 0 Тогда
			ТекОсновноеСредство.Нехватка = 1;
			Продолжить;
		КонецЕсли;
		
		ПервыйОбъект = НайденыСтроки[0];
		УчетПоКПС = ПервыйОбъект.УчетПоКПС;
		УчетПоПодразделениям = ФОУчетПоПодразделениям И ПервыйОбъект.УчетПоПодразделениям;
		Для каждого ТекНайденОС Из НайденыСтроки Цикл
			
			Если КПСвТЧ Тогда
				КПСДокумента = ТекНайденОС.КПС;
			КонецЕсли;
			
			Если ТекНайденОС.КоличествоОстаток = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если УчетПоКПС И ТекНайденОС.КПС <> КПСДокумента Тогда
				Продолжить;
			КонецЕсли;
			
			Если УчетПоПодразделениям И ТекНайденОС.Подразделение <> ПодразделениеДокумента Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекНайденОС.КоличествоОстаток < ТекОсновноеСредство.Количество Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекНайденОС.КоличествоОстаток = ТекОсновноеСредство.Количество Тогда
				ТекОсновноеСредство.СуммаВУчете = ТекНайденОС.СуммаОстаток;
				ТекНайденОС.СуммаОстаток = 0;
				ТекНайденОС.КоличествоОстаток = 0;
				ТекОсновноеСредство.ОСРаспределен = Истина;
			Иначе
				ЦенаОС = Окр(ТекНайденОС.СуммаОстаток / ТекНайденОС.КоличествоОстаток, 2);
				ТекОсновноеСредство.СуммаВУчете = ЦенаОС * ТекОсновноеСредство.Количество;
				ТекНайденОС.СуммаОстаток = ТекНайденОС.СуммаОстаток - ТекОсновноеСредство.СуммаВУчете;
				ТекНайденОС.КоличествоОстаток = ТекНайденОС.КоличествоОстаток - ТекОсновноеСредство.Количество;
				ТекОсновноеСредство.ОСРаспределен = Истина;
			КонецЕсли;
			
			Если ТекОсновноеСредство.ОСРаспределен Тогда
				ТекОсновноеСредство.Контрагент = ТекНайденОС.Контрагент;
				ТекОсновноеСредство.Договор = ТекНайденОС.Договор;
				ТекОсновноеСредство.СчетУчета = ТекНайденОС.Счет;
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
		
		Если Не ТекОСновноеСредство.ОсРаспределен Тогда
			ТекОсновноеСредство.Нехватка = 1;
		КонецЕсли;
	
	КонецЦикла; 
	
	Возврат ОсновныеСредства;
	
КонецФункции

Функция ПолучитьОстаткиОСвПути( ДокументСсылка,
								Период,
								ИмяТЧ,
								ИФО,
								КФО,
								КПС,
								Подразделение,
								Контрагент,
								ПоступлениеОСвПути) Экспорт
								
	УчетПоПодразделениям = Ложь;
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЕСТЬNULL(ЕПСБУ.УчетПоПодразделениям, ЛОЖЬ)) КАК УчетПоПодразделениям
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&Счет107)";
	Запрос.УстановитьПараметр("Счет107", БухгалтерскийУчет.СписокСчетов("107.00"));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		УчетПоПодразделениям = Выборка.УчетПоПодразделениям;
	КонецЕсли;
	
	УчетПоПодразделениям = УчетПоПодразделениям И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");

	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	Ложь);
		
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",
		ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И УчетПоПодразделениям);
	Запрос.УстановитьПараметр("ТаблицаОС",             ДокументСсылка[ИмяТч]);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("Период",                Новый Граница(ДокументСсылка.МоментВремени(),
		ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Ссылка",                ДокументСсылка);
	Запрос.УстановитьПараметр("Организация",           ДокументСсылка.Организация);
	Запрос.УстановитьПараметр("ИФО",                   ИФО);
	Запрос.УстановитьПараметр("Подразделение",         Подразделение);
	Запрос.УстановитьПараметр("Контрагент",            Контрагент);
	Запрос.УстановитьПараметр("ПоступлениеОСвПути",    ПоступлениеОСвПути);
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ПартииВПути);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеОСКапВложения.ВнеоборотныйАктив КАК ВнеоборотныйАктив,
	|	СУММА(ПоступлениеОСКапВложения.Количество) КАК Количество,
	|	ПоступлениеОСКапВложения.КПС КАК КПС,
	|	ПоступлениеОСКапВложения.КФО КАК КФО
	|ПОМЕСТИТЬ СоставДокумента
	|ИЗ
	|	Документ.ПоступлениеОС.КапВложения КАК ПоступлениеОСКапВложения
	|ГДЕ
	|	ПоступлениеОСКапВложения.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеОСКапВложения.ВнеоборотныйАктив,
	|	ПоступлениеОСКапВложения.КПС,
	|	ПоступлениеОСКапВложения.КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ВнеоборотныйАктив,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ КАК ИФО,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт) КАК СуммаОстатокДт,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК КоличествоОстатокДт
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет107),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И &УсловиеКПС
	|				И &УсловиеКФО
	|				И Субконто2 = &ПоступлениеОСвПути
	|				И (ИФО = &ИФО
	|					ИЛИ НЕ &ИспользоватьУчетПоИФО)
	|				И (Подразделение = &Подразделение
	|					ИЛИ НЕ &ИспользоватьУчетПоПодразделениям)) КАК ЖурналПроводокЕПСБУОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставДокумента.ВнеоборотныйАктив КАК ВнеоборотныйАктив,
	|	СоставДокумента.Количество КАК Количество,
	|	Остатки.Счет КАК Счет,
	|	Остатки.КПС КАК КПС,
	|	Остатки.КФО КАК КФО,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.СуммаОстатокДт КАК СуммаОстаток,
	|	Остатки.КоличествоОстатокДт КАК КоличествоОстаток,
	|	ВЫБОР
	|		КОГДА СоставДокумента.Количество > ЕСТЬNULL(Остатки.КоличествоОстатокДт, 0)
	|			ТОГДА СоставДокумента.Количество - ЕСТЬNULL(Остатки.КоличествоОстатокДт, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Нехватка,
	|	СоставДокумента.ВнеоборотныйАктив.Наименование КАК ВнеоборотныйАктивНаименование
	|ИЗ
	|	СоставДокумента КАК СоставДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО СоставДокумента.ВнеоборотныйАктив = Остатки.ВнеоборотныйАктив
	|			И СоставДокумента.КПС = Остатки.КПС
	|			И СоставДокумента.КФО = Остатки.КФО";
	Если ЗначениеЗаполнено(КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА");
	КонецЕсли;
	Если ЗначениеЗаполнено(КПС) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС", "КПС = &КПС");
		Запрос.УстановитьПараметр("КПС", КПС);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС", "ИСТИНА");
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьОстаткиОСПоТаблицеОС(Параметры)
	
	УчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОсновныеСредстваДокумента"			, Параметры.ОсновныеСредстваДокумента);
	Запрос.УстановитьПараметр("Период"								, Параметры.Период);
	Запрос.УстановитьПараметр("Организация"							, Параметры.Организация);
	Запрос.УстановитьПараметр("ВключатьБалансовыеСуммы"				, Параметры.ВключатьБалансовыеСуммы);
	Запрос.УстановитьПараметр("ВключатьЗабалансовыеСуммы"			, Параметры.ВключатьЗабалансовыеСуммы);
	Запрос.УстановитьПараметр("ВключатьСуммыВложений"				, Параметры.ВключатьСуммыВложений);
	Запрос.УстановитьПараметр("ЦМО"									, Параметры.ЦМО);
	Запрос.УстановитьПараметр("КФО"									, Параметры.КФО);
	Запрос.УстановитьПараметр("КПС"									, Параметры.КПС);
	Запрос.УстановитьПараметр("ИФО"									, Параметры.ИФО);
	Запрос.УстановитьПараметр("Подразделение"						, Параметры.Подразделение);
	Запрос.УстановитьПараметр("Счет101"								, БухгалтерскийУчет.СписокСчетов("101.00"));
	Запрос.УстановитьПараметр("Счет21"								, БухгалтерскийУчет.СписокСчетов("21"));
	Запрос.УстановитьПараметр("Счет106"								, БухгалтерскийУчет.СписокСчетов("106.00"));
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям"	, УчетПоПодразделениям);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО"				, ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредстваДокумента.ОсновноеСредство КАК ОСДокумента,
	|	ОсновныеСредстваДокумента.Количество КАК КоличествоДокумента
	|ПОМЕСТИТЬ ОсновныеСредстваДокумента1
	|ИЗ
	|	&ОсновныеСредстваДокумента КАК ОсновныеСредстваДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредстваДокумента1.ОСДокумента КАК ОСДокумента,
	|	СУММА(ОсновныеСредстваДокумента1.КоличествоДокумента) КАК КоличествоДокумента
	|ПОМЕСТИТЬ ОсновныеСредстваДокумента
	|ИЗ
	|	ОсновныеСредстваДокумента1 КАК ОсновныеСредстваДокумента1
	|
	|СГРУППИРОВАТЬ ПО
	|	ОсновныеСредстваДокумента1.ОСДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СчетаУчетаОС
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&Счет101)
	|	И &ВключатьБалансовыеСуммы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&Счет21)
	|	И &ВключатьЗаБалансовыеСуммы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&Счет106)
	|	И &ВключатьСуммыВложений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ КАК ИФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстаток) КАК СуммаОстаток,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ПОМЕСТИТЬ ОстаткиОС
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В
	|				(ВЫБРАТЬ
	|					СчетаУчетаОС.Ссылка
	|				ИЗ
	|					СчетаУчетаОС КАК СчетаУчетаОС),
	|			,
	|			Организация = &Организация
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ОсновныеСредстваДокумента.ОСДокумента
	|					ИЗ
	|						ОсновныеСредстваДокумента КАК ОсновныеСредстваДокумента)
	|				И (Субконто2 = &ЦМО
	|					ИЛИ &ЦМО = ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|					ИЛИ &ВключатьСуммыВложений)
	|				И (ИФО = &ИФО
	|					ИЛИ &ИФО = ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|					ИЛИ НЕ &ИспользоватьУчетПоИФО)
	|				И (Подразделение = &Подразделение
	|					ИЛИ НЕ &ИспользоватьУчетПоПодразделениям)
	|				И (КФО = &КФО
	|					ИЛИ &КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка))
	|				И (КПС = &КПС
	|					ИЛИ &КПС = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))) КАК ЖурналПроводокЕПСБУОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.Организация,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиОС.Счет КАК Счет,
	|	ОсновныеСредстваДокумента.ОСДокумента КАК ОсновноеСредство,
	|	ОстаткиОС.ЦМО КАК ЦМО,
	|	ОстаткиОС.Организация КАК Организация,
	|	ОстаткиОС.КПС КАК КПС,
	|	ОстаткиОС.ИФО КАК ИФО,
	|	ОстаткиОС.Подразделение КАК Подразделение,
	|	ОстаткиОС.КФО КАК КФО,
	|	ЕСТЬNULL(ОстаткиОС.СуммаОстаток, 0) КАК СуммаОстаток,
	|	ЕСТЬNULL(ОстаткиОС.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ОсновныеСредстваДокумента.КоличествоДокумента КАК КоличествоДокумента,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОстаткиОС.КоличествоОстаток, 0) < ОсновныеСредстваДокумента.КоличествоДокумента
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Нехватка
	|ИЗ
	|	ОсновныеСредстваДокумента КАК ОсновныеСредстваДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиОС КАК ОстаткиОС
	|		ПО ОсновныеСредстваДокумента.ОСДокумента = ОстаткиОС.ОсновноеСредство";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция НОВАЯ_ОСтаткиОСНМАНПА(ДокументСсылка) Экспорт
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	МетаданныеТЧ = МетаданныеДокумента.ТабличныеЧасти.Найти("ОсновныеСредства");
	ЕстьТЧОсновныеСредства = МетаданныеТЧ <> Неопределено;
	
	ДокументСДатойПроведения = Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(ДокументСсылка));
	ЕстьДатаСписанияСБухУчета = МетаданныеДокумента.Реквизиты.Найти("ДатаСписанияСБухУчета") <> Неопределено ИЛИ ДокументСДатойПроведения;

	РеквизитКПСвШапке = (МетаданныеДокумента.Реквизиты.Найти("КПС") <> Неопределено);
	ЕстьРеквизитКФОВТабличнойЧасти = (МетаданныеДокумента.Реквизиты.Найти("КФОВТабличнойЧасти") <> Неопределено);
	РеквизитКФОвШапке = (МетаданныеДокумента.Реквизиты.Найти("КФО") <> Неопределено);
	
	ИмяРеквизитаЦМО = "";
	Если МетаданныеДокумента.Реквизиты.Найти("ЦМО") <> Неопределено Тогда
		ИмяРеквизитаЦМО = "ЦМО";
	ИначеЕсли МетаданныеДокумента.Реквизиты.Найти("ЦМООтправитель") <> Неопределено Тогда 
		ИмяРеквизитаЦМО = "ЦМООтправитель";
	КонецЕсли;
	
	ИмяРеквизитаПодразделение = "";
	Если МетаданныеДокумента.Реквизиты.Найти("Подразделение") <> Неопределено Тогда
		ИмяРеквизитаПодразделение = "Подразделение";
	ИначеЕсли МетаданныеДокумента.Реквизиты.Найти("ПодразделениеОтправитель") <> Неопределено Тогда 
		ИмяРеквизитаПодразделение = "ПодразделениеОтправитель";
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК") Тогда
		ВидПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ВидПоступления");
		Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(ВидПоступления) Тогда
			ИмяРеквизитаЦМО = "ЦМООтправитель";
			ИмяРеквизитаПодразделение = "ПодразделениеОтправитель";
		КонецЕсли;
	КонецЕсли;
	
	ИменаПараметров = "Ссылка, Дата, Организация, ИФО";
	Если ЕстьДатаСписанияСБухУчета И НЕ ДокументСДатойПроведения Тогда
		ИменаПараметров = ИменаПараметров + ", ДатаСписанияСБухУчета";
	КонецЕсли;
	Если РеквизитКПСвШапке Тогда
		ИменаПараметров = ИменаПараметров + ", КПС";
	КонецЕсли;
	Если РеквизитКФОвШапке Тогда
		ИменаПараметров = ИменаПараметров + ", КФО";
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяРеквизитаЦМО) Тогда
		ИменаПараметров = ИменаПараметров + ", " + ИмяРеквизитаЦМО;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяРеквизитаПодразделение) Тогда
		ИменаПараметров = ИменаПараметров + ", " + ИмяРеквизитаПодразделение;
	КонецЕсли;
	Если ЕстьРеквизитКФОВТабличнойЧасти Тогда
		ИменаПараметров = ИменаПараметров + ", КФОВТабличнойЧасти";
	КонецЕсли;
	Если ЕстьТЧОсновныеСредства Тогда
		ИменаПараметров = ИменаПараметров + ", ОсновныеСредства";
	Иначе
		ИменаПараметров = ИменаПараметров + ", ОсновноеСредство, ИнвентарныйНомер";
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, ИменаПараметров);
	Если РеквизитКФОвШапке И ЕстьРеквизитКФОВТабличнойЧасти И ЗначенияРеквизитов.КФОВТабличнойЧасти Тогда
		ЗначенияРеквизитов.Удалить("КФО");
	КонецЕсли;	 

	Если ДокументСДатойПроведения Тогда
		ЗначенияРеквизитов.Вставить("ДатаСписанияСБухУчета", БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументСсылка));
	КонецЕсли;	
	
	Если ЕстьДатаСписанияСБухУчета Тогда
		ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(ЗначенияРеквизитов, ЗначенияРеквизитов.ДатаСписанияСБухУчета);
	Иначе
		ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(ЗначенияРеквизитов);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяРеквизитаЦМО) И ИмяРеквизитаЦМО <> "ЦМО" Тогда
		ПараметрыПолученияОстатков.ЦМО = ЗначенияРеквизитов[ИмяРеквизитаЦМО];
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяРеквизитаПодразделение) И ИмяРеквизитаПодразделение <> "Подразделение" Тогда
		ПараметрыПолученияОстатков.Подразделение = ЗначенияРеквизитов[ИмяРеквизитаПодразделение];
	КонецЕсли;
	
	Если ЕстьТЧОсновныеСредства Тогда
		ВыборкаОС = ЗначенияРеквизитов.ОсновныеСредства.Выбрать();
		Пока ВыборкаОС.Следующий() Цикл
			НоваяСтрока = ПараметрыПолученияОстатков.ТаблицаОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаОС);
			Если РеквизитКПСвШапке Тогда
				НоваяСтрока.КПС = ЗначенияРеквизитов.КПС;
			КонецЕсли;

			Если НЕ (ЕстьРеквизитКФОВТабличнойЧасти И ЗначенияРеквизитов.КФОВТабличнойЧасти) И РеквизитКФОвШапке Тогда
				НоваяСтрока.КФО = ЗначенияРеквизитов.КФО;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТребованиеНакладнаяОС") Тогда
		// рассчитаем амортизацию, чтобы исключить повторное начисление 100% амортизации
		ПараметрыПолученияОстатков.ПолучатьАмортизацию = Истина;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаВнутреннееПеремещениеОС2") Тогда
		// рассчитаем амортизацию, для возможности перемещения при изменении подразделения
		ПараметрыПолученияОстатков.ПолучатьАмортизацию = Истина;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектаОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуЗдания")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК") Тогда
		// рассчитаем амортизацию, для возможности перемещения при изменении подразделения
		ПараметрыПолученияОстатков.ПолучатьАмортизацию = Истина;
		ПараметрыПолученияОстатков.ПолучатьАмортизациюБезБалансовойСтоимости = Истина;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		// рассчитаем амортизацию, для возможности перемещения при изменении подразделения,
		// при передаче в пользование
		ПараметрыПолученияОстатков.ПолучатьАмортизацию = Истина;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВнутреннееПеремещениеИК") Тогда
		// рассчитаем амортизацию, для возможности перемещения при изменении подразделения
		ПараметрыПолученияОстатков.ПолучатьАмортизацию = Истина;
	КонецЕсли;
	
	ПараметрыПолученияОстатков.УстанавливатьКФО = Ложь;
	
	Возврат УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков);
	
КонецФункции

Функция ОстаткиОСНМАНПА(ДокументСсылка) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТЧОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТЧОсновныеСредства.Ссылка.ЦМО КАК ЦМО,
	|	ТЧОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ВЫРАЗИТЬ(ТЧОсновныеСредства.ОсновноеСредство КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТЧОсновныеСредства.Количество КАК Количество,
	|	ТЧОсновныеСредства.Сумма КАК Сумма,
	|	ТЧОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ТЧОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения
	|ПОМЕСТИТЬ ВТ_Таблица
	|ИЗ
	|	&ТЧ КАК ТЧОсновныеСредства
	|ГДЕ
	|	ТЧОсновныеСредства.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК Стоимость,
	|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТ_ОстаткиСтоимость
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			(Организация, ОсновноеСредство, ИнвентарныйНомер, ЦМО) В
	|					(ВЫБРАТЬ
	|						ВТ_Таблица.Организация КАК Организация,
	|						ВТ_Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|						ВТ_Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|						ВТ_Таблица.ЦМО КАК ЦМО
	|					ИЗ
	|						ВТ_Таблица КАК ВТ_Таблица)
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток КАК СуммаАмортизации,
	|	АмортизацияОбъектовОСОстатки.СуммаОбесцененияОстаток КАК СуммаОбесценения
	|ПОМЕСТИТЬ ВТ_ОстаткиАмортизация
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС.Остатки(
	|			&Период,
	|			(Организация, ОсновноеСредство, ИнвентарныйНомер) В
	|				(ВЫБРАТЬ
	|					ВТ_Таблица.Организация КАК Организация,
	|					ВТ_Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|					ВТ_Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер
	|				ИЗ
	|					ВТ_Таблица КАК ВТ_Таблица)) КАК АмортизацияОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Таблица.НомерСтроки КАК НомерСтроки,
	|	ВТ_Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Таблица.ОсновноеСредство.Наименование КАК Наименование,
	|	ВТ_Таблица.ОсновноеСредство.Код КАК Код,
	|	ВТ_Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Таблица.ЦМО КАК ЦМО,
	|	ВТ_Таблица.Количество КАК Количество,
	|	ВТ_Таблица.Сумма КАК Сумма,
	|	ВТ_Таблица.СуммаАмортизации КАК СуммаАмортизации,
	|	ВТ_Таблица.СуммаОбесценения КАК СуммаОбесценения,
	|	ЕСТЬNULL(ВТ_ОстаткиСтоимость.Количество, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(ВТ_ОстаткиСтоимость.Стоимость, 0) КАК СуммаОстаток,
	|	ЕСТЬNULL(ВТ_ОстаткиАмортизация.СуммаАмортизации, 0) КАК СуммаАмортизацииОстаток,
	|	ЕСТЬNULL(ВТ_ОстаткиАмортизация.СуммаОбесценения, 0) КАК СуммаОбесцененияОстаток
	|ИЗ
	|	ВТ_Таблица КАК ВТ_Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиСтоимость КАК ВТ_ОстаткиСтоимость
	|		ПО ВТ_Таблица.ОсновноеСредство = ВТ_ОстаткиСтоимость.ОсновноеСредство
	|			И ВТ_Таблица.ИнвентарныйНомер = ВТ_ОстаткиСтоимость.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиАмортизация КАК ВТ_ОстаткиАмортизация
	|		ПО ВТ_Таблица.ОсновноеСредство = ВТ_ОстаткиАмортизация.ОсновноеСредство
	|			И ВТ_Таблица.ИнвентарныйНомер = ВТ_ОстаткиАмортизация.ИнвентарныйНомер";
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	
	ОСвШапке = (МетаданныеДокумента.ТабличныеЧасти.Найти("ОсновныеСредства") = Неопределено);
	
	Если ОСвШапке Тогда
		ИмяТаблицы = "Документ." + МетаданныеДокумента.Имя;
		ЕстьАмортизация = (МетаданныеДокумента.Реквизиты.Найти("СуммаАмортизации") <> Неопределено);
		ЕстьОбесценение = (МетаданныеДокумента.Реквизиты.Найти("СуммаОбесценения") <> Неопределено);
		ЕстьКоличество  = Ложь;
	Иначе
		ИмяТаблицы = "Документ." + МетаданныеДокумента.Имя + ".ОсновныеСредства";
		ЕстьАмортизация = (МетаданныеДокумента.ТабличныеЧасти.ОсновныеСредства.Реквизиты.Найти("СуммаАмортизации") <> Неопределено);
		ЕстьОбесценение = (МетаданныеДокумента.ТабличныеЧасти.ОсновныеСредства.Реквизиты.Найти("СуммаОбесценения") <> Неопределено);
		ЕстьКоличество  = Истина;
	КонецЕсли;
	
	ПолеЦМО = "ЦМО";
	Если МетаданныеДокумента.Реквизиты.Найти(ПолеЦМО) = Неопределено Тогда
		ПолеЦМО = "ЦМООтправитель";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТЧ", ИмяТаблицы);
	Если ПолеЦМО <> "ЦМО" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Ссылка.ЦМО", "Ссылка." + ПолеЦМО);
	КонецЕсли;
	Если ОСвШапке Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТЧОсновныеСредства.НомерСтроки", "0");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТЧОсновныеСредства.Ссылка.", "ТЧОсновныеСредства.");
	КонецЕсли;
	Если Не ЕстьКоличество Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТЧОсновныеСредства.Количество", "0");
	КонецЕсли;
	Если Не ЕстьАмортизация Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТЧОсновныеСредства.СуммаАмортизации", "0");
	КонецЕсли;
	Если Не ЕстьОбесценение Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТЧОсновныеСредства.СуммаОбесценения", "0");
	КонецЕсли;
	
	ЕстьДатаСписания = (МетаданныеДокумента.Реквизиты.Найти("ДатаСписанияСБухУчета") <> Неопределено);
	Если ЕстьДатаСписания Тогда
		ДатаСписания = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ДатаСписанияСБухУчета");
	Иначе	
		ДатаСписания = БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументСсылка);
	КонецЕсли;	
	//ДатаСписания = ?(ЕстьДатаСписания, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ДатаСписанияСБухУчета"), '00010101');
	Период = ?(ЗначениеЗаполнено(ДатаСписания), ДатаСписания, Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("Период", Период);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаОСДляСписания(ДокументСсылка, ЭтоКапВложение) Экспорт
	
	Объект = ДокументСсылка;
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	МетаданныеДокумента = Объект.Метаданные();
	
	ДокументСДатойПроведения = Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(Объект));
	ЕстьРеквизитДатаСписания = МетаданныеДокумента.Реквизиты.Найти("ДатаСписанияСБухучета") <> Неопределено ИЛИ ДокументСДатойПроведения;
	ЕстьТаблицаОС = МетаданныеДокумента.ТабличныеЧасти.Найти("ОсновныеСредства") <> Неопределено;
	КПСвШапке = МетаданныеДокумента.Реквизиты.Найти("КПС") <> Неопределено;
	КПСвТЧ = ЕстьТаблицаОС И МетаданныеДокумента.ТабличныеЧасти.ОсновныеСредства.Реквизиты.Найти("КПС") <> Неопределено;
	
	Если ТипДокумента = Тип("ДокументСсылка.ТребованиеНакладнаяОС")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.НакладнаяНаВнутреннееПеремещениеОС2") Тогда
		ИмяРеквизитаЦМО = "ЦМООтправитель";
		ИмяРеквизитаПодразделение = "ПодразделениеОтправитель";
	Иначе
		ИмяРеквизитаЦМО = "ЦМО";
		ИмяРеквизитаПодразделение = "Подразделение";
	КонецЕсли;
	
	СтрокаРеквизитов = "Ссылка,Организация,КФО,ИФО,Дата," + ИмяРеквизитаЦМО + "," + ИмяРеквизитаПодразделение;
	Если ЕстьРеквизитДатаСписания И НЕ ДокументСДатойПроведения Тогда
		СтрокаРеквизитов = СтрокаРеквизитов + ",ДатаСписанияСБухучета";
	КонецЕсли;
	Если КПСвШапке Тогда
		СтрокаРеквизитов = СтрокаРеквизитов + ",КПС";
	КонецЕсли;
	Если ЕстьТаблицаОС Тогда
		СтрокаРеквизитов = СтрокаРеквизитов + ",ОсновныеСредства";
	Иначе
		СтрокаРеквизитов = СтрокаРеквизитов + ",ОсновноеСредство,ИнвентарныйНомер";
	КонецЕсли;
		
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, СтрокаРеквизитов);
	Если ДокументСДатойПроведения Тогда
		ДанныеДокумента.Вставить("ДатаСписанияСБухучета", БухгалтерскийУчет.УстановленнаяДатаПроведения(Объект));
	КонецЕсли;	
	
	Если ЕстьРеквизитДатаСписания Тогда
		ПараметрыОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(ДанныеДокумента, ДанныеДокумента.ДатаСписанияСБухУчета);
	Иначе
		ПараметрыОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(ДанныеДокумента);
	КонецЕсли;
	ПараметрыОстатков.ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ПараметрыОстатков.ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	Если ИмяРеквизитаЦМО <> "ЦМО" Тогда
		ПараметрыОстатков.ЦМО = ДанныеДокумента[ИмяРеквизитаЦМО];
	КонецЕсли;
	Если ИмяРеквизитаПодразделение <> "Подразделение" Тогда
		ПараметрыОстатков.Подразделение = ДанныеДокумента[ИмяРеквизитаПодразделение];
	КонецЕсли;
	Если ЕстьТаблицаОС Тогда
		ВыборкаОС = ДанныеДокумента.ОсновныеСредства.Выбрать();
		Пока ВыборкаОС.Следующий() Цикл
			НоваяСтрокаОС = ПараметрыОстатков.ТаблицаОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОС, ВыборкаОС);
			Если КПСвШапке Тогда
				НоваяСтрокаОС.КПС = ДанныеДокумента.КПС;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтоКапВложение Тогда
		Возврат УправлениеОсновнымиСредствами.ПолучитьОстаткиКапВложений(ПараметрыОстатков);
	Иначе
		Возврат УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыОстатков);
	КонецЕсли;
КонецФункции

Функция ТаблицаОСДляСписанияОперУчет(ДокументСсылка) Экспорт
	Объект = ДокументСсылка;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектаОС") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаЗдания") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеОбъектаОС") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеТранспорта") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеАвтотранспорта") Тогда
		ПериодОстатков = ДокументСсылка.МоментВремени();
		ПараметрыЗапроса = Новый Структура("Период, Организация, КПС, КФО, ИФО, Подразделение, ЦМО, Контрагент",
											ПериодОстатков,
											Объект.Организация,
											Объект.КПС,
											Объект.КФО,
											Объект.ИФО,
											Объект.Подразделение,
											Объект.ЦМО,
											Объект.Контрагент);					
		ТаблицаОС = УправлениеОсновнымиСредствами.ОпределитьСтоимостьОбъектаОС(Объект.ОсновноеСредство, ПараметрыЗапроса,ДокументСсылка.Дата);						
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаГруппОбъектовОС") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеГруппОбъектовОС") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС") Тогда
		ПериодОстатков = Объект.МоментВремени();
		СписокОС = Объект.ОсновныеСредства.Выгрузить(,"ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство");
		
		ТаблицаОС = УправлениеОсновнымиСредствами.ОпределитьЗабСтоимостьСпискаОС(	СписокОС,
																					ПериодОстатков,
																					Объект.Организация,
																					Объект.КФО,
																					Объект.КПС,
																					Объект.ЦМО,
																					Объект.ИФО,
																					Объект.Подразделение);
		
	//ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТребованиеНакладнаяОС") Тогда
	//	ПериодОстатков = Объект.МоментВремени();
	//	СписокОС = Объект.ОсновныеСредства.Выгрузить(,"ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство");
	//	
	//	ТаблицаОС = УправлениеОсновнымиСредствами.ОпределитьЗабСтоимостьСпискаОС(	СписокОС,
	//																				ПериодОстатков,
	//																				Объект.Организация,
	//																				Объект.КФО,
	//																				Объект.КПС,
	//																				Объект.ЦМООтправитель,
	//																				Объект.ИФО,
	//																				Объект.ПодразделениеОтправитель);
		
		
	Иначе
		Возврат Неопределено;																				
	КонецЕсли;
	
	Возврат ТаблицаОС;
КонецФункции

Функция ТаблицаОСДляСписанияНУ(ДокументСсылка, ЭтоКапВложение) Экспорт
	
	Если ДокументСсылка.Метаданные().ТабличныеЧасти.Найти("ОсновныеСредства")<>Неопределено Тогда
		ОсновныеСредства = ДокументСсылка.ОсновныеСредства.ВыгрузитьКолонку("ОсновноеСредство");
	Иначе
		ОсновныеСредства = Новый Массив;
		ОсновныеСредства.Добавить(ДокументСсылка.ОсновноеСредство);
	КонецЕсли;
	
	ТаблицаСписания = НалоговыйУчет.ОпределитьСтоимостьСпискаОС(ОсновныеСредства, ДокументСсылка, ЭтоКапВложение);
	
	Возврат ТаблицаСписания;
	
КонецФункции

Функция СостояниеОС(ДокументСсылка, ОсновноеСредство, ИнвНомер) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СобытияОССрезПоследних.Событие КАК Событие
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И ИнвНомер = &ИнвНомер) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)";
	
	ДатаПроведения = '00010101';                                
	Если Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(ДокументСсылка)) Тогда
		ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументСсылка);
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ДатаСписанияСБухУчета", ДокументСсылка.Метаданные()) Тогда
		ДанныеДок = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ДатаСписанияСБухУчета");
		Если ЗначениеЗаполнено(ДанныеДок.ДатаСписанияСБухУчета) Тогда
			ДатаПроведения = ДанныеДок.ДатаСписанияСБухУчета;
		КонецЕсли;	
	КонецЕсли;	  
	Если ЗначениеЗаполнено(ДатаПроведения) Тогда
		МоментВремени = ДатаПроведения;
	Иначе
		МоментВремени = ДокументСсылка.МоментВремени();
	КонецЕсли;	
	
	//Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ДатаСписанияСБухУчета", ДокументСсылка.Метаданные())
	//	И ЗначениеЗаполнено(ДокументСсылка.ДатаСписанияСБухУчета) Тогда
	//	МоментВремени = ДокументСсылка.ДатаСписанияСБухУчета;
	//Иначе
	//	МоментВремени = ДокументСсылка.МоментВремени();
	//КонецЕсли;
	
	Запрос.УстановитьПараметр("МоментВремени"		, Новый Граница(МоментВремени, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация"			, ДокументСсылка.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвНомер"			, ИнвНомер);
	
	СобытияОС = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СобытияОС.Добавить(Выборка.Событие);
	КонецЦикла;
	
	Если СобытияОС.Найти(Перечисления.ВидыСобытийОС.Списание) <> Неопределено Тогда
		Состояние = Перечисления.СостоянияОС.СнятоСУчета;
	ИначеЕсли СобытияОС.Найти(Перечисления.ВидыСобытийОС.ВводВЭксплуатацию) <> Неопределено Тогда
		Состояние = Перечисления.СостоянияОС.ВведеноВЭксплуатацию;
	ИначеЕсли СобытияОС.Найти(Перечисления.ВидыСобытийОС.ПринятиеКУчету) <> Неопределено Тогда
		Состояние = Перечисления.СостоянияОС.ПринятоКУчету;
	Иначе
		Состояние = Перечисления.СостоянияОС.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Состояние;
	
КонецФункции

// Забалансовый счет ОС по балансовому счету или ссылке на справочник и дате.
// 
// Параметры:
//  Параметр1 - Произвольный
//  Параметр2 - Произвольный
// 
// Возвращаемое значение:
//  ПланСчетовСсылка.ЕПСБУ - Забалансовый счет ОС
Функция ЗабалансовыйСчетОС(Параметр1, Параметр2) Экспорт
	
	СчетУчетаОС = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	Если ТипЗнч(Параметр1) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		// Вызов ЗабалансовыйСчетОС(<СчетУчетаОС>).
		СчетУчетаОС = Параметр1;
	ИначеЕсли ТипЗнч(Параметр1) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		// Вызов ЗабалансовыйСчетОС(<ОсновноеСредство>, <Период (необязательно)>).
		СчетУчетаОС = БухгалтерскиеОперации.СчетУчетаОС(Параметр1, Параметр2);
	Иначе // Неправильный вызов.
		БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(
			НСтр("ru = 'Невозможно определить забалансовый счет учета ОС.
				|Неправильное использование функции БухгалтерскиеОперации.ЗабалансовыйСчетОС в настройке типовой операции.'"),
			"ЗабалансовыйСчетОС");
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	ЗабалансовыйСчетОС = УправлениеОсновнымиСредствамиПовтИсп.ЗабалансовыйСчетОС(СчетУчетаОС);
	Если НЕ ЗначениеЗаполнено(ЗабалансовыйСчетОС) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Невозможно определить забалансовый счет по счету учета внеоборотного актива %1.
				|Проверьте настройки соответствия счетов по гиперссылке ""Соответствие счетов ОС"" в разделе ""Учет и отчетность – См. также"".'"),
				Строка(СчетУчетаОС));
		БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "ЗабалансовыйСчетОС");
	КонецЕсли;
	
	Возврат ЗабалансовыйСчетОС;
	
КонецФункции

#КонецОбласти

#Область ПереносОстатковПоКПС

Функция ОпределитьИзменениеТипаПланаСчетов(Организация,Дата,ИФО) Экспорт
	ЕстьИзменения = Ложь;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		СтруктураРПС_Новая = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(Организация,ИФО,КонецМесяца(Дата)+1);
		СтруктураРПС_Старая = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(Организация,ИФО,Дата);
	Иначе
		СтруктураРПС_Новая = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(Организация,Неопределено, КонецМесяца(Дата)+1);
		СтруктураРПС_Старая = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(Организация,Неопределено, Дата);
	КонецЕсли;
	
	Если СтруктураРПС_Новая <> СтруктураРПС_Старая Тогда
		ТПС_Новый = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРПС_Новая,"ТипПланаСчетов");
		ТПС_Старый = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРПС_Старая,"ТипПланаСчетов");
		Если ТПС_Новый<>ТПС_Старый Тогда
			ЕстьИзменения = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЕстьИзменения;
	
КонецФункции

Функция ОпределитьТипПланаСчетов(Организация,Дата,ИФО) Экспорт
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		СтруктураРПС = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(Организация,ИФО,Дата);
	Иначе
		СтруктураРПС = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(Организация,Неопределено, Дата);
	КонецЕсли;
	
	ТПС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРПС,"ТипПланаСчетов");	
	
	Возврат ТПС;
КонецФункции

Функция ЭтоКонецГода(Дата) Экспорт
	Возврат НачалоДня(КонецГода(Дата)) = НачалоДня(Дата);	
КонецФункции

