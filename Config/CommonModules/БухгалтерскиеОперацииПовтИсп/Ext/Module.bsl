КонецФункции	

// Функция возвращает структуру параметров учета МЗ на счете
//
Функция ПолучитьПараметрыСчетаУчетаМЗ(Счет, УчитыватьДополнительныйВидЗатрат = Ложь) Экспорт
	
	ПараметрыСчетаУчета = Новый Структура;
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ПараметрыСчетаУчета.Вставить("УчетПоКПС",	СвойстваСчета.УчетПоКПС); 
	ПараметрыСчетаУчета.Вставить("УчетПоПодразделениям", ?(УчетПоПодразделениям, СвойстваСчета.УчетПоПодразделениям, Ложь));
	
	ЕстьСубконтоЦМО = Ложь;
	СубконтоЦМОСуммовой = Ложь;
	ЕстьСубконтоДоп = Ложь;
	ВидСубконтоДоп = ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
	СубконтоДопСуммовой = Ложь;
	Для Индекс = 1 По СвойстваСчета.КоличествоСубконто Цикл
	
		Если СвойстваСчета["ВидСубконто" + Индекс] = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
			ЕстьСубконтоЦМО = Истина;
			СубконтоЦМОСуммовой = СвойстваСчета["ВидСубконто" + Индекс + "Суммовой"];
		ИначеЕсли СвойстваСчета["ВидСубконто" + Индекс] <> ПланыВидовХарактеристик.ВидыСубконто.Номенклатура
			И НЕ ЕстьСубконтоДоп Тогда
			Если УчитыватьДополнительныйВидЗатрат = Истина И СвойстваСчета["ВидСубконто" + Индекс] <> ПланыВидовХарактеристик.ВидыСубконто.Партии Тогда
				Продолжить;
			ИначеЕсли УчитыватьДополнительныйВидЗатрат = Ложь И СвойстваСчета["ВидСубконто" + Индекс] = ПланыВидовХарактеристик.ВидыСубконто.Партии Тогда
				Продолжить;
			КонецЕсли;
			ЕстьСубконтоДоп = Истина;
			ВидСубконтоДоп = СвойстваСчета["ВидСубконто" + Индекс];
			СубконтоДопСуммовой = СвойстваСчета["ВидСубконто" + Индекс + "Суммовой"];
		КонецЕсли;
	
	КонецЦикла;
	ПараметрыСчетаУчета.Вставить("ЕстьСубконтоЦМО",		ЕстьСубконтоЦМО);
	ПараметрыСчетаУчета.Вставить("СубконтоЦМОСуммовой",	СубконтоЦМОСуммовой);
	ПараметрыСчетаУчета.Вставить("ЕстьСубконтоДоп",		ЕстьСубконтоДоп);
	ПараметрыСчетаУчета.Вставить("ВидСубконтоДоп",		ВидСубконтоДоп);
	ПараметрыСчетаУчета.Вставить("СубконтоДопСуммовой",	СубконтоДопСуммовой);
	
	Возврат ПараметрыСчетаУчета;
	
КонецФункции

// Счет обесценения БА.
// 
// Параметры:
//  СчетУчетаБА - ПланСчетовСсылка.ЕПСБУ
