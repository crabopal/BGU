////////////////////////////////////////////////////////////////////////////////
// МАТЕРИАЛЬНЫЕ ЗАПАСЫ

// Функция возвращает таблицу значений с остатками материалов на субсчетах счета 105.
// Список расчитываемых материалов берется из табличной части документа.
// Остатки получаются по переданной аналитике: ЦМО, КФО, КПС, ИФО, Подразделение.
// Возвращаемая таблица имеет следующие колонки:
//		Организация
//		КФО					- КФО
//		КПС					- КПС
//		Номенклатура		- Номенклатура
//		ЦМО					- ЦМО
//		ИФО					- ИФО
//		Подразделение		- подразделение
//		СуммаОстаток		- стоимость номенклатуры
//		КоличествоОстаток	- количество номенклатуры по всем ЦМО.
//		КоличествоМОЛ		- количество номенклатуры у нужного ЦМО.
//		Нехватка			- число - 0 если номенклатуры хватает, 1 - если не хватает.
//
// Параметры
//	ДокументСсылка		- ДокументСсылка - Документ, содержащий ТЧ с номенклатурой
//	Период,				- Дата	- Дата документа или период расчета остатков
//	ИмяТЧ				- Строка - Имя ТЧ, по номенклатуре которой расчитываются остатки
//	КолонкаМатериал		- Строка - Имя реквизита ТЧ, содержащего номенклатуру
//	КолонкаКоличество	- Строка - имя реквизита ТЧ, содержащего количество
//	ЦМО					- СправочникСсылка.ЦМО
//	КФО					- ПеречислениеСсылка.КВД
//	КПС					- СправочникСсылка.КлассификационныеПризнакиСчетов
//	ИФО					- СправочникСсылка.ИсточникиФинансовогоОбеспечения
//	Подразделение		- СправочникСсылка.Подразделения
//
// Возвращаемое значение:
//   ТаблицаЗначений
//
Функция ПолучитьОстаткиМатериалов(ДокументСсылка, СтруктураПараметров) Экспорт

	Перем Период, ИмяТЧ, КолонкаМатериал, КолонкаКоличество, ЦМО, КФО, КПС, ИФО, Подразделение, ИмяТЧВозвратнаяТара;
	
	СтруктураПараметров.Свойство("Период",				Период);
	СтруктураПараметров.Свойство("ИмяТЧ",				ИмяТЧ);
	СтруктураПараметров.Свойство("ЦМО",					ЦМО);
	СтруктураПараметров.Свойство("КФО",					КФО);
	СтруктураПараметров.Свойство("КПС",					КПС);
	СтруктураПараметров.Свойство("ИФО",					ИФО);
	СтруктураПараметров.Свойство("Подразделение",		Подразделение);
	СтруктураПараметров.Свойство("ИмяТЧВозвратнаяТара",	ИмяТЧВозвратнаяТара);
 	Если НЕ СтруктураПараметров.Свойство("КолонкаМатериал", КолонкаМатериал) Тогда
		КолонкаМатериал = "Номенклатура";
	КонецЕсли;
	Если Не СтруктураПараметров.Свойство("КолонкаКоличество", КолонкаКоличество) Тогда
		КолонкаКоличество = "Количество";
	КонецЕсли;	

	//МассивМатериалов = ДокументСсылка[ИмяТЧ].ВыгрузитьКолонку(КолонкаМатериал);
	ТипЦМО = Новый ОписаниеТипов("СправочникСсылка.ЦМО");
	ТипКФО = Новый ОписаниеТипов("ПеречислениеСсылка.КВД");
	ТипКПС = Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов");
	ТипИФО = Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения");
	ТипПодразделение = Новый ОписаниеТипов("СправочникСсылка.Подразделения");
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счет105", БухгалтерскийУчет.СписокСчетов("105.00"));		
	
	Если УчетПоПодразделениям Тогда
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	ИСТИНА КАК Поле1
		               |ИЗ
		               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		               |ГДЕ
		               |	ЕПСБУ.Ссылка В(&Счет105)
		               |	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
		               |	И ЕПСБУ.УчетПоПодразделениям = ИСТИНА
		               |	И ИСТИНА В
		               |			(ВЫБРАТЬ ПЕРВЫЕ 1
		               |				ИСТИНА
		               |			ИЗ
		               |				ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		               |			ГДЕ
		               |				ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
		               |				И ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка)";
		УчетПоПодразделениям = НЕ Запрос.Выполнить().Пустой();					   
	КонецЕсли;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МатериалыДокумента",					ДокументСсылка[ИмяТЧ]);
	Запрос.УстановитьПараметр("Период", 							Период);
	Запрос.УстановитьПараметр("Организация", 						ДокументСсылка.Организация);
	Запрос.УстановитьПараметр("ЦМО", 								ТипЦМО.ПривестиЗначение(ЦМО));
	Запрос.УстановитьПараметр("КФО", 								ТипКФО.ПривестиЗначение(КФО));
	Запрос.УстановитьПараметр("КПС", 								ТипКПС.ПривестиЗначение(КПС));
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО",				ИспользоватьУчетПоИФО); 
	Запрос.УстановитьПараметр("ИФО", 								ТипИФО.ПривестиЗначение(ИФО));
	Запрос.УстановитьПараметр("Подразделение", 						ТипПодразделение.ПривестиЗначение(Подразделение));
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", 	УчетПоПодразделениям);
	
	Если ЗначениеЗаполнено(ИмяТЧВозвратнаяТара) Тогда
		Запрос.УстановитьПараметр("ВозвратнаяТара", ДокументСсылка[ИмяТЧВозвратнаяТара]);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(МатериалыДокумента.Номенклатура КАК Справочник.Номенклатура) КАК НоменклатураДокумента,
		               |	МатериалыДокумента.Количество КАК КоличествоДокумента
		               |ПОМЕСТИТЬ МатериалыДокумента1
		               |ИЗ
		               |	&МатериалыДокумента КАК МатериалыДокумента
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(ВозвратнаяТара.Номенклатура КАК Справочник.Номенклатура) КАК НоменклатураДокумента,
		               |	ВозвратнаяТара.Количество КАК КоличествоДокумента
		               |ПОМЕСТИТЬ МатериалыДокумента2
		               |ИЗ
		               |	&ВозвратнаяТара КАК ВозвратнаяТара
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	МатериалыДокумента1.НоменклатураДокумента КАК НоменклатураДокумента,
		               |	МатериалыДокумента1.КоличествоДокумента КАК КоличествоДокумента
		               |ПОМЕСТИТЬ МатериалыДокумента
		               |ИЗ
		               |	МатериалыДокумента1 КАК МатериалыДокумента1
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	МатериалыДокумента2.НоменклатураДокумента,
		               |	МатериалыДокумента2.КоличествоДокумента
		               |ИЗ
		               |	МатериалыДокумента2 КАК МатериалыДокумента2
		               |;";
		
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(МатериалыДокумента.Номенклатура КАК Справочник.Номенклатура) КАК НоменклатураДокумента,
		               |	МатериалыДокумента.Количество КАК КоличествоДокумента
		               |ПОМЕСТИТЬ МатериалыДокумента
		               |ИЗ
		               |	&МатериалыДокумента КАК МатериалыДокумента
		               |;";
    КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "МатериалыДокумента.Номенклатура", "МатериалыДокумента."+КолонкаМатериал);					   
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "МатериалыДокумента.Количество", "МатериалыДокумента."+КолонкаКоличество);
				   
	Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ
	                              |	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	                              |	&ЖурналПроводокЕПСБУОстаткиИФО КАК ИФО,
	                              |	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	                              |	&ЖурналПроводокЕПСБУОстаткиПодразделение КАК Подразделение,
	                              |	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	                              |	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	                              |	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Номенклатура,
	                              |	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто2, ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)) КАК ЦМО,
	                              |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстаток,
	                              |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстаток
	                              |ПОМЕСТИТЬ ОстаткиНоменклатуры
	                              |ИЗ
	                              |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	                              |			&Период,
	                              |			Счет В (&Счет105),
	                              |			,
	                              |			Организация = &Организация
	                              |				И Субконто1 В
	                              |					(ВЫБРАТЬ
	                              |						МатериалыДокумента.НоменклатураДокумента
	                              |					ИЗ
	                              |						МатериалыДокумента КАК МатериалыДокумента)
	                              |				И &УсловиеИФО
	                              |				И &УсловиеПодразделение
	                              |				И &УсловиеКФО
	                              |				И &УсловиеКПС) КАК ЖурналПроводокЕПСБУОстатки
	                              |
	                              |ИНДЕКСИРОВАТЬ ПО
	                              |	Номенклатура,
	                              |	ЦМО,
	                              |	КФО,
	                              |	КПС,
	                              |	Счет
	                              |;
	                              |
	                              |////////////////////////////////////////////////////////////////////////////////
	                              |ВЫБРАТЬ
	                              |	ОстаткиНоменклатуры.Организация КАК Организация,
	                              |	ОстаткиНоменклатуры.ИФО КАК ИФО,
	                              |	ОстаткиНоменклатуры.КФО КАК КФО,
	                              |	ОстаткиНоменклатуры.Подразделение КАК Подразделение,
	                              |	ОстаткиНоменклатуры.КПС КАК КПС,
	                              |	ОстаткиНоменклатуры.Счет КАК Счет,
	                              |	ОстаткиНоменклатуры.Номенклатура КАК Номенклатура,
	                              |	ОстаткиНоменклатурыЦМО.ЦМО КАК ЦМО,
	                              |	ЕСТЬNULL(ОстаткиНоменклатурыЦМО.КоличествоОстаток, 0) КАК КоличествоМОЛ,
	                              |	МатериалыДокумента.НоменклатураДокумента КАК НоменклатураДокумента,
	                              |	МатериалыДокумента.КоличествоДокумента КАК КоличествоДокумента,
	                              |	ОстаткиНоменклатуры.СуммаОстаток КАК СуммаОстаток,
	                              |	ОстаткиНоменклатурыКоличествоВсего.КоличествоОстаток КАК КоличествоОстаток,
	                              |	МатериалыДокумента.НоменклатураДокумента.СчетУчета КАК НоменклатураСчетУчета,
	                              |	ВЫБОР
	                              |		КОГДА ОстаткиНоменклатурыЦМО.КоличествоОстаток >= МатериалыДокумента.КоличествоДокумента
	                              |			ТОГДА 0
	                              |		ИНАЧЕ 1
	                              |	КОНЕЦ КАК Нехватка
	                              |ИЗ
	                              |	МатериалыДокумента КАК МатериалыДокумента
	                              |		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиНоменклатуры КАК ОстаткиНоменклатуры
	                              |			ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиНоменклатуры КАК ОстаткиНоменклатурыЦМО
	                              |			ПО ОстаткиНоменклатуры.Номенклатура = ОстаткиНоменклатурыЦМО.Номенклатура
	                              |				И (ОстаткиНоменклатурыЦМО.ЦМО = &ЦМО)
	                              |				И ОстаткиНоменклатуры.КФО = ОстаткиНоменклатурыЦМО.КФО
	                              |				И ОстаткиНоменклатуры.КПС = ОстаткиНоменклатурыЦМО.КПС
	                              |				И ОстаткиНоменклатуры.Счет = ОстаткиНоменклатурыЦМО.Счет
	                              |			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                              |				ОстаткиНоменклатуры.КФО КАК КФО,
	                              |				ОстаткиНоменклатуры.КПС КАК КПС,
	                              |				ОстаткиНоменклатуры.Счет КАК Счет,
	                              |				ОстаткиНоменклатуры.Номенклатура КАК Номенклатура,
	                              |				СУММА(ОстаткиНоменклатуры.КоличествоОстаток) КАК КоличествоОстаток
	                              |			ИЗ
	                              |				ОстаткиНоменклатуры КАК ОстаткиНоменклатуры
	                              |			ГДЕ
	                              |				ОстаткиНоменклатуры.ЦМО <> ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	                              |			
	                              |			СГРУППИРОВАТЬ ПО
	                              |				ОстаткиНоменклатуры.КФО,
	                              |				ОстаткиНоменклатуры.КПС,
	                              |				ОстаткиНоменклатуры.Счет,
	                              |				ОстаткиНоменклатуры.Номенклатура) КАК ОстаткиНоменклатурыКоличествоВсего
	                              |			ПО ОстаткиНоменклатуры.Номенклатура = ОстаткиНоменклатурыКоличествоВсего.Номенклатура
	                              |				И ОстаткиНоменклатуры.КФО = ОстаткиНоменклатурыКоличествоВсего.КФО
	                              |				И ОстаткиНоменклатуры.КПС = ОстаткиНоменклатурыКоличествоВсего.КПС
	                              |				И ОстаткиНоменклатуры.Счет = ОстаткиНоменклатурыКоличествоВсего.Счет
	                              |		ПО МатериалыДокумента.НоменклатураДокумента = ОстаткиНоменклатуры.Номенклатура
	                              |			И (ОстаткиНоменклатуры.ЦМО = ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка))";
	Если ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЖурналПроводокЕПСБУОстаткиИФО", "ЖурналПроводокЕПСБУОстатки.ИФО");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЖурналПроводокЕПСБУОстаткиИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	Если УчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЖурналПроводокЕПСБУОстаткиПодразделение", "ЖурналПроводокЕПСБУОстатки.Подразделение");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ЖурналПроводокЕПСБУОстатки.Подразделение");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЖурналПроводокЕПСБУОстаткиПодразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ИСТИНА");
	КонецЕсли;
	Если ЗначениеЗаполнено(КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");	
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА");	
	КонецЕсли;
	Если ЗначениеЗаполнено(КПС) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС", "КПС = &КПС");	
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС", "ИСТИНА");	
	КонецЕсли;
				   
	УстановитьПривилегированныйРежим(Истина);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // ПолучитьОстаткиМатериалов()

// Возвращает текущие остатки и величину нехватки материалов, указанных в документе списания.
// Список материалов берется из табличной части указанного документа списания.
//
// Параметры:
//	ДокументСписанияСсылка	- ссылка на документ списания, содержащий табличную часть
//							с номенклатурой и ее количеством;
//	СтруктураПараметров	- содержит отборы для поиска остатков. Структура с полями:
//		(Аналитика остатков)
//			ДатаОстатков
//			Счет
//			ЦМО
//			Подразделение
//			ИФО
//			КФО
//			КПС
//		(Характеристика документа списания)
//			ИмяТаблЧастиМатериалы
//			ИмяКолонкиНоменклатура
//			ИмяКолонкиКоличество
// Возврат:
//	Структура с полями:
//		Нехватка	- количество нехватки номенклатуры, с номерами строк
//					табличной части документа списания
//					(дерево значений)
//		Остатки	- величины остатков сумм и количества номенклатуры
//				(таблица значений)
Функция ПолучитьОстаткиМатериаловЗабаланс(ДокументСписанияСсылка, СтруктураПараметров) Экспорт
	
	// Возвращаемое значение:
	Результат = Новый Структура("Нехватка, Остатки");
	
	// Подготовка:
	ИмяТаблЧастиМатериалы	= СтруктураПараметров["ИмяТаблЧастиМатериалы"];
	ИмяКолонкиНоменклатура	= СтруктураПараметров["ИмяКолонкиНоменклатура"];
	ИмяКолонкиКоличество	= СтруктураПараметров["ИмяКолонкиКоличество"];
	Подразделение = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"),
		СтруктураПараметров["Подразделение"],
		Неопределено);
	ИФО = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"),
		СтруктураПараметров["ИФО"],
		Неопределено);
	ВидыСубконтоНоменклатураЦМО = Новый Массив();
	ВидыСубконтоНоменклатураЦМО.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконтоНоменклатураЦМО.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	// Настраиваем запрос:
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ТЧМатериалы",	ДокументСписанияСсылка[ИмяТаблЧастиМатериалы]);
	ЗапросПоиск.УстановитьПараметр("Организация",	ДокументСписанияСсылка["Организация"]);
	ЗапросПоиск.УстановитьПараметр("ДатаОстатков",	СтруктураПараметров["ДатаОстатков"]);
	ЗапросПоиск.УстановитьПараметр("Подразделение",	Подразделение);
	ЗапросПоиск.УстановитьПараметр("ИФО",			ИФО);
	ЗапросПоиск.УстановитьПараметр("КПС",			СтруктураПараметров["КПС"]);	//(м.б.= Неопределено)
	ЗапросПоиск.УстановитьПараметр("КФО",			СтруктураПараметров["КФО"]);	//(м.б.= Неопределено)
	ЗапросПоиск.УстановитьПараметр("Счет",			СтруктураПараметров["Счет"]);
	ЗапросПоиск.УстановитьПараметр("ЦМО",			СтруктураПараметров["ЦМО"]);	//(м.б.= Неопределено)
	ЗапросПоиск.УстановитьПараметр("ВидыСубконтоНоменклатураЦМО", ВидыСубконтоНоменклатураЦМО);
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Проверяемая табл.часть с материалами
	|//		(Контроль остатков материалов при списании)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.НомерСтроки				КАК НомерСтроки,
	|	ТЧ.<ИмяКолонкиНоменклатура>	КАК Номенклатура,
	|	ТЧ.<ИмяКолонкиКоличество>	КАК Количество
	|ПОМЕСТИТЬ
	|	ТаблЧастьМатериалы
	|ИЗ
	|	&ТЧМатериалы	КАК ТЧ
	|ГДЕ
	|	НЕ ТЧ.<ИмяКолонкиНоменклатура> = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Списываемые материалы, указанные в документе списания.
	|//		(Контроль остатков материалов при списании)
	|ВЫБРАТЬ
	|	Номенклатура		КАК Номенклатура,
	|	СУММА(Количество)	КАК Количество
	|ПОМЕСТИТЬ
	|	МатериалыДокумента
	|ИЗ
	|	ТаблЧастьМатериалы
	|СГРУППИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. (Подготовка) Текущие остатки материалов по данным учета.
	|//		(Контроль остатков материалов при списании)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Остатки.Субконто1	КАК Номенклатура,
	|	СУММА(Остатки.КоличествоРазвернутыйОстатокДт - Остатки.КоличествоРазвернутыйОстатокКт)	КАК КоличествоОстаток,
	|	СУММА(Остатки.СуммаРазвернутыйОстатокДт - Остатки.СуммаРазвернутыйОстатокКт)			КАК СуммаОстаток
	|ПОМЕСТИТЬ
	|	ТекущиеОстатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаОстатков,			// 1 Период
	|		Счет В ИЕРАРХИИ(&Счет),	// 2 Условие счета
	|		&ВидыСубконтоНоменклатураЦМО,	// 3 Виды субконто
	|		
	|		Организация = &Организация
	|		И ВЫБОР 
	|			КОГДА &ИФО = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ИФО = &ИФО
	|		КОНЕЦ
	|		И ВЫБОР 
	|			КОГДА &КФО = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ КФО = &КФО
	|		КОНЕЦ
	|		И ВЫБОР 
	|			КОГДА &ЦМО = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Субконто2 = &ЦМО
	|		КОНЕЦ
	|		И Субконто1 В
	|			(ВЫБРАТЬ
	|				Номенклатура
	|			ИЗ
	|				ТаблЧастьМатериалы)
	|	)	КАК Остатки
	|ГДЕ
	|	ВЫБОР 
	|		КОГДА НЕ &Подразделение = НЕОПРЕДЕЛЕНО И Счет.УчетПоПодразделениям = ИСТИНА ТОГДА
	|			Подразделение = &Подразделение
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА НЕ &КПС = НЕОПРЕДЕЛЕНО И Счет.УчетПоКПС = ИСТИНА ТОГДА
	|			КПС = &КПС
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Субконто1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. (Подготовка) Количество нехватки каждого материала, указанного в документе-списании.
	|//		(Контроль остатков материалов при списании)
	|ВЫБРАТЬ
	|	МатериалыДокумента.Номенклатура	КАК Номенклатура,
	|	ЕСТЬNULL(МатериалыДокумента.Количество - ТекущиеОстатки.КоличествоОстаток, МатериалыДокумента.Количество)	КАК КоличествоНехватка
	|ПОМЕСТИТЬ
	|	Нехватка
	|ИЗ
	|	МатериалыДокумента
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ТекущиеОстатки
	|		ПО	МатериалыДокумента.Номенклатура = ТекущиеОстатки.Номенклатура
	|ГДЕ
	|	ЕСТЬNULL(МатериалыДокумента.Количество - ТекущиеОстатки.КоличествоОстаток, МатериалыДокумента.Количество) > 0
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Нехватка номенклатуры, указанной в документе-списании.
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	ТаблЧастьМатериалы.НомерСтроки									КАК НомерСтроки,
	|	ТаблЧастьМатериалы.Номенклатура									КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(ТаблЧастьМатериалы.Номенклатура.ЕдиницаИзмерения)	КАК ЕдИзм,
	|	Нехватка.КоличествоНехватка										КАК КоличествоНехватка
	|ИЗ
	|	ТаблЧастьМатериалы
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	Нехватка
	|		ПО	ТаблЧастьМатериалы.Номенклатура = Нехватка.Номенклатура
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ
	|	МИНИМУМ(КоличествоНехватка)	КАК КоличествоНехватка
	|ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Текущие остатки номенклатуры, указанной в документе-списании.
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	Номенклатура		КАК Номенклатура,
	|	КоличествоОстаток	КАК КоличествоОстаток,
	|	СуммаОстаток		КАК СуммаОстаток
	|ИЗ
	|	ТекущиеОстатки
	|;";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИмяКолонкиНоменклатура>",	ИмяКолонкиНоменклатура);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИмяКолонкиКоличество>",		ИмяКолонкиКоличество);
	ЗапросПоиск.Текст = ТекстЗапроса;
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыПоиск = ЗапросПоиск.ВыполнитьПакет();
	
	//	[4]	Нехватка номенклатуры, указанной в документе-списании.
	Результат.Вставить("Нехватка", РезультатыПоиск[4].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	//	[5]	Текущие остатки номенклатуры, указанной в документе-списании.
	Результат.Вставить("Остатки", РезультатыПоиск[5].Выгрузить());
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаМЗДляСписанияЗабаланс(ПараметрыПолученияТаблицы) Экспорт

	Возврат УправлениеМатериальнымиЗапасами.ТаблицаМЗДляСписанияЗабаланс(ПараметрыПолученияТаблицы);	

КонецФункции // ТаблицаМЗДляСписанияЗабаланс()

Функция ПараметрыСписанияМЗ(ДокументСсылка) Экспорт

	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Ссылка, Дата, Организация, КФО, КПС, ИФО, СчетУчета,"
																				+ "ЦМООтправитель, ПодразделениеОтправитель, Материалы");
	Параметры = УправлениеМатериальнымиЗапасами.ПустаяСтруктураПараметровДляСписанияМЗ();
	ЗаполнитьЗначенияСвойств(Параметры, ДанныеДокумента, "Дата, Организация, КФО, КПС, ИФО");
	Параметры.Ссылка 						= ДанныеДокумента.Ссылка;
	Параметры.Счет 							= ДанныеДокумента.СчетУчета;
	Параметры.ЦМО 							= ДанныеДокумента.ЦМООтправитель;
	Параметры.Подразделение					= ДанныеДокумента.ПодразделениеОтправитель;
	
	Возврат Параметры;

КонецФункции // ПараметрыСписанияОС()

Функция ТаблицаДокументаДляСписанияМЗЗабаланс(ДокументСсылка) Экспорт

	Результат = Новый ТаблицаЗначений;
	ТипЧисло_5_0	= Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный));
	ТипЧисло_15_3	= Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	Колонки = Результат.Колонки;
	Колонки.Добавить("НомерСтроки", 				ТипЧисло_5_0);
	Колонки.Добавить("Номенклатура", 				Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Колонки.Добавить("Количество", 					ТипЧисло_15_3);
	Колонки.Добавить("ДополнительнаяАналитикаСчета",	Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Материалы");
	
	ТаблицаДокумента = ДанныеДокумента.Материалы.Выбрать();
	Пока ТаблицаДокумента.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), ТаблицаДокумента);
	КонецЦикла;
	
	Возврат Результат;

КонецФункции // ТаблицаДокументаДляСписанияМЗЗабаланс()

Функция ТаблицаМЗДляСписанияНУ(ДокументСсылка) Экспорт
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	ТабличныеЧасти = МетаданныеДокумента.ТабличныеЧасти;
	Если ТабличныеЧасти.Найти("Материалы")<>Неопределено Тогда
		ИмяСписка = "Материалы";
		СинонимСписка = "Материалы";
	ИначеЕсли ТабличныеЧасти.Найти("МатериальныеЗапасы")<>Неопределено Тогда
		ИмяСписка = "МатериальныеЗапасы";
		СинонимСписка = "Материальные запасы";
	КонецЕсли;
	
	ТаблицаМПЗ = ДокументСсылка[ИмяСписка].Выгрузить(,"НомерСтроки,Номенклатура,Количество");
	ТаблицаМПЗ.Колонки.Добавить("ИмяСписка",     Новый ОписаниеТипов("Строка"));
	ТаблицаМПЗ.Колонки.Добавить("СинонимСписка", Новый ОписаниеТипов("Строка"));
	ТаблицаМПЗ.ЗаполнитьЗначения(ИмяСписка,      "ИмяСписка");
	ТаблицаМПЗ.ЗаполнитьЗначения(СинонимСписка,  "СинонимСписка");
	
	// Если есть возвратная тара, добавим ее в таблицу списываемых МПЗ
	Если ТабличныеЧасти.Найти("ВозвратнаяТара")<>Неопределено Тогда
		ИмяСписка = "ВозвратнаяТара";
		СинонимСписка = "Возвратная тара";
		ТаблицаТара = ДокументСсылка[ИмяСписка].Выгрузить(,"НомерСтроки,Номенклатура,Количество");
		ТаблицаТара.Колонки.Добавить("ИмяСписка",     Новый ОписаниеТипов("Строка"));
		ТаблицаТара.Колонки.Добавить("СинонимСписка", Новый ОписаниеТипов("Строка"));
		ТаблицаТара.ЗаполнитьЗначения(ИмяСписка,      "ИмяСписка");
		ТаблицаТара.ЗаполнитьЗначения(СинонимСписка,  "СинонимСписка");
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаТара, ТаблицаМПЗ);
	КонецЕсли;
	
	ТаблицаМПЗ.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("КФО", МетаданныеДокумента) Тогда
		ТаблицаМПЗ.ЗаполнитьЗначения(ДокументСсылка.КФО, "КФО");
	КонецЕсли;
	
	ТаблицаМПЗ.Колонки.Добавить("СчетУчетаНУ", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Для Каждого СтрокаТаблицы Из ТаблицаМПЗ Цикл
		СтрокаТаблицы.СчетУчетаНУ = БухгалтерскиеОперации.ПолучитьСчетНУпоСчетуБУ(БухгалтерскиеОперации.СчетУчетаСсылкаИзНоменклатуры(СтрокаТаблицы.Номенклатура));
	КонецЦикла;
	
	Отказ = Ложь;
	
	ТаблицаСписания = НалоговыйУчет.ПодготовитьТаблицуСписанныеМПЗ(ТаблицаМПЗ, ДокументСсылка, Отказ);
	
	Возврат ТаблицаСписания;
	
КонецФункции

Функция РассчитатьСтоимостьВложенияВНФА(ДокументСсылка) Экспорт
	
	Если ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.ПринятиеКУчетуЗдания") 
		И ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.ПринятиеКУчетуОбъектаОС") 
		И ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.ПринятиеКУчетуОС") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.Счет,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК НФА,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ КАК ИФО,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |				И ЕПСБУ.УчетПоПодразделениям
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ КАК Подразделение,
	               |	ЖурналПроводокЕПСБУОстатки.КФО,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт,
	               |	ЕПСБУ.УчетПоПодразделениям,
	               |	ЕПСБУ.УчетПоКПС,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&ПериодЗапроса,
	               |			Счет = &Счет,
	               |			,
	               |			Организация = &Организация
	               |				И Субконто1 = &НФА
	               |				И (ИФО = &ИФО
	               |					ИЛИ НЕ &ИспользоватьУчетПоИФО)
	               |				И КПС = &КПС
	               |				И КФО = &КФО) КАК ЖурналПроводокЕПСБУОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ПО ЖурналПроводокЕПСБУОстатки.Счет = ЕПСБУ.Ссылка
	               |ГДЕ
	               |	(ЖурналПроводокЕПСБУОстатки.Подразделение = &Подразделение
	               |			ИЛИ НЕ &ИспользоватьУчетПоПодразделениям
	               |			ИЛИ НЕ ЕПСБУ.УчетПоПодразделениям)";
	Запрос.УстановитьПараметр("ИФО",								ДокументСсылка.ИФО);
	Запрос.УстановитьПараметр("ПериодЗапроса",						ДокументСсылка.Дата);
	Запрос.УстановитьПараметр("Счет",								ДокументСсылка.СчетКредита);
	Запрос.УстановитьПараметр("Организация",						ДокументСсылка.Организация);
	Запрос.УстановитьПараметр("НФА",								ДокументСсылка.ВнеоборотныйАктив);
	Запрос.УстановитьПараметр("Подразделение",						ДокументСсылка.Подразделение);
	Запрос.УстановитьПараметр("КПС",								ДокументСсылка.КПС);
	Запрос.УстановитьПараметр("КФО",								ДокументСсылка.КФО);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", 				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		СтоимостьОС = Неопределено;
	Иначе
		Выборка = Результат.Выбрать();
		СтоимостьОС = Новый Структура;
		Выборка.Следующий();
		СтоимостьОС.Вставить("Счет", 			Выборка.Счет);
		СтоимостьОС.Вставить("НФА",				Выборка.НФА);
		СтоимостьОС.Вставить("КПС",				Выборка.КПС);
		СтоимостьОС.Вставить("ИФО",				Выборка.ИФО);
		СтоимостьОС.Вставить("Подразделение",	Выборка.НФА);
		СтоимостьОС.Вставить("КФО",				Выборка.НФА);
		СтоимостьОС.Вставить("Сумма",			Выборка.СуммаОстатокДт);
		СтоимостьОС.Вставить("Количество",		Выборка.КоличествоОстатокДт);
		Если ДокументСсылка.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление Тогда
			СтоимостьОС.Количество = ДокументСсылка.Количество;
		КонецЕсли;	
	КонецЕсли;
	
	ТекстОшибки = "";
	Если СтоимостьОС = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Не обнаружено остатков по внеоборотному активу'");
	Иначе
		Если СтоимостьОС.Количество<ДокументСсылка.Количество Тогда
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru = 'Остаток по внеоборотному активу %1 меньше количества в документе %2'"),
									СтоимостьОС.Количество,
									ДокументСсылка.Количество);
		КонецЕсли;
	КонецЕсли;
	
	Если ТекстОшибки <> "" Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		СтоимостьОС = Неопределено;
	КонецЕсли;
	
	Возврат СтоимостьОС;
	
КонецФункции

// Устарела. Следует использовать источник данных БухгалтерскиеОперацииИсточникиДанных.СписаниеМатериальныхЗапасов()
// Функция возвращает таблицу списанной номенклатуры документа по всем видам учета
//
Функция ТаблицаСписанияНоменклатуры(ДокументСсылка) Экспорт
	
	Возврат УправлениеМатериальнымиЗапасами.ТаблицаСписанияНоменклатуры(ДокументСсылка);
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ЗАЧЕТ АВАНСОВ

Функция ТаблицаСуммАвансовВыданныхПолная(Ссылка, Период, Организация, ИФО, КФО, КПС, Подразделение, Контрагент, Договор = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕПСБУ206.Ссылка КАК Счет206,
	               |	ЕПСБУ302.Ссылка КАК Счет302,
	               |	ЕПСБУ206.Валютный КАК Счет206Валютный,
	               |	ЕПСБУ206.УчетПоПодразделениям КАК Счет206УчетПоПодразделениям,
	               |	ЕПСБУ302.Валютный КАК Счет302Валютный,
	               |	ЕПСБУ302.УчетПоПодразделениям КАК Счет302УчетПоПодразделениям,
	               |	ЕстьNULL(ВидСубконто302_Контрагенты.НомерСтроки, 0) КАК Счет302_Контрагенты,
	               |	ЕстьNULL(ВидСубконто302_Договоры.НомерСтроки, 0) КАК Счет302_Договоры,
	               |	ЕстьNULL(ВидСубконто302_Документы.НомерСтроки, 0) КАК Счет302_Документы,
	               |	ЕстьNULL(ВидСубконто206_Контрагенты.НомерСтроки, 0) КАК Счет206_Контрагенты,
	               |	ЕстьNULL(ВидСубконто206_Договоры.НомерСтроки, 0) КАК Счет206_Договоры,
	               |	ЕстьNULL(ВидСубконто206_Документы.НомерСтроки, 0) КАК Счет206_Документы
	               |ПОМЕСТИТЬ СоответствияСчетов
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ206
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ302
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто302_Контрагенты
	               |			ПО ЕПСБУ302.Ссылка = ВидСубконто302_Контрагенты.Ссылка
	               |				И (ВидСубконто302_Контрагенты.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты))
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто302_Договоры
	               |			ПО ЕПСБУ302.Ссылка = ВидСубконто302_Договоры.Ссылка
	               |				И (ВидСубконто302_Договоры.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры))
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто302_Документы
	               |			ПО ЕПСБУ302.Ссылка = ВидСубконто302_Документы.Ссылка
	               |				И (ВидСубконто302_Документы.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДокументыРасчетов))
	               |		ПО (ПОДСТРОКА(ЕПСБУ206.Код, 5, 2) = ПОДСТРОКА(ЕПСБУ302.Код, 5, 2))
	               |			И (НЕ ЕПСБУ206.ЭлементГруппа)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто206_Контрагенты
	               |		ПО ЕПСБУ206.Ссылка = ВидСубконто206_Контрагенты.Ссылка
	               |			И (ВидСубконто206_Контрагенты.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто206_Договоры
	               |		ПО ЕПСБУ206.Ссылка = ВидСубконто206_Договоры.Ссылка
	               |			И (ВидСубконто206_Договоры.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто206_Документы
	               |		ПО ЕПСБУ206.Ссылка = ВидСубконто206_Документы.Ссылка
	               |			И (ВидСубконто206_Документы.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДокументыРасчетов))
	               |ГДЕ
	               |	ЕПСБУ206.Ссылка В(&Счет206)
	               |	И ЕПСБУ302.Ссылка В(&Счет302)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетАванса,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьВалютныйУчет
	               |				И СоответствияСчетов.Счет206Валютный
	               |				И ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт
	               |		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт
	               |	КОНЕЦ КАК СуммаАванса,
				   |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК РублеваяСуммаАванса,
				   |	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаАванса,
	               |	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК Валюта,
	               |	ЖурналПроводокЕПСБУОстатки.КФО,
	               |	ВЫБОР
	               |		КОГДА СоответствияСчетов.Счет206_Договоры = 1
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Договоры)
	               |		КОГДА СоответствияСчетов.Счет206_Договоры = 2
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры)
	               |		КОГДА СоответствияСчетов.Счет206_Договоры = 3
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Договоры)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |	КОНЕЦ КАК Договор,
	               |	СоответствияСчетов.Счет302 КАК СчетРасчетов,
	               |	ЖурналПроводокЕПСБУОстатки.Организация,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
	               |	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	               |	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	               |	ВЫБОР
	               |		КОГДА СоответствияСчетов.Счет206_Документы = 1
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1
	               |		КОГДА СоответствияСчетов.Счет206_Документы = 2
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто2
	               |		КОГДА СоответствияСчетов.Счет206_Документы = 3
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто3
	               |	КОНЕЦ КАК ДокументАванса,
	               |	ВЫБОР
	               |		КОГДА СоответствияСчетов.Счет206_Документы = 1
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1.Дата
	               |		КОГДА СоответствияСчетов.Счет206_Документы = 2
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто2.Дата
	               |		КОГДА СоответствияСчетов.Счет206_Документы = 3
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто3.Дата
	               |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	               |	КОНЕЦ КАК ДатаАванса,
	               |	ВЫРАЗИТЬ(0 КАК ЧИСЛО(18, 2)) КАК СуммаЗачтено,
	               |	ЛОЖЬ КАК СтрокаЗачтена
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			Счет В
	               |				(ВЫБРАТЬ
	               |					СоответствияСчетов.Счет206
	               |				ИЗ
	               |					СоответствияСчетов),
	               |			,
	               |			Организация = &Организация
	               |				И Субконто1 = &Контрагент
	               |				И &УсловиеКПС
	               |				И &УсловиеКФО
	               |				И &УсловиеИФО
	               |				И &УсловиеПодразделение) КАК ЖурналПроводокЕПСБУОстатки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоответствияСчетов КАК СоответствияСчетов
	               |		ПО ЖурналПроводокЕПСБУОстатки.Счет = СоответствияСчетов.Счет206
	               |ГДЕ
	               |	(СоответствияСчетов.Счет206_Договоры = 0
	               |			ИЛИ &ЗаданоУсловиеДоговор = ЛОЖЬ
	               |			ИЛИ ВЫБОР
	               |				КОГДА СоответствияСчетов.Счет206_Договоры = 1
	               |					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Договоры)
	               |				КОГДА СоответствияСчетов.Счет206_Договоры = 2
	               |					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры)
	               |				КОГДА СоответствияСчетов.Счет206_Договоры = 3
	               |					ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Договоры)
	               |				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |			КОНЕЦ = &Договор)";
	Если Ссылка.Пустая() Тогда				   
		Запрос.УстановитьПараметр("Период",					Период);
	Иначе
		Запрос.УстановитьПараметр("Период", 				Ссылка.МоментВремени());
	КонецЕсли;
	Запрос.УстановитьПараметр("Организация",				Организация);
	Запрос.УстановитьПараметр("Контрагент",					Контрагент);
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет",	ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("ЗаданоУсловиеДоговор", ЗначениеЗаполнено(Договор));
	Запрос.УстановитьПараметр("Счет206", БухгалтерскийУчет.СписокСчетов("206.00"));
	Запрос.УстановитьПараметр("Счет302", БухгалтерскийУчет.СписокСчетов("302.00"));
	Если ЗначениеЗаполнено(КПС) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС", "КПС = &КПС");
		Запрос.УстановитьПараметр("КПС",КПС);
	Иначе
		Запрос.УстановитьПараметр("УсловиеКПС",		Истина);
	КонецЕсли;
	Если ЗначениеЗаполнено(КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО",КФО);
	Иначе
		Запрос.УстановитьПараметр("УсловиеКФО",		Истина);
	КонецЕсли;
	Запрос.УстановитьПараметр("УсловиеИФО",			Истина);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Если ЗначениеЗаполнено(ИФО) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
			Запрос.УстановитьПараметр("ИФО",ИФО);
		КонецЕсли;
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЖурналПроводокЕПСБУОстатки.ИФО", "Значение(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	Запрос.УстановитьПараметр("УсловиеПодразделение",	Истина);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Если БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("206.00").УчетПоПодразделениям Тогда
			Если ЗначениеЗаполнено(Подразделение) Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "Подразделение = &Подразделение");
				Запрос.УстановитьПараметр("Подразделение",Подразделение);
			КонецЕсли;
		КонецЕсли;
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕстьNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, Значение(Справочник.Подразделения.ПустаяСсылка))",
													"Значение(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ТаблицаСуммаАвансовПолученныхПолная(Ссылка, Период, Организация, ИФО, КФО, КПС, Подразделение, Контрагент, Договор) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка КАК Ссылка,
	               |	ПОДСТРОКА(ЕПСБУ.Код, 1, 5) КАК СтрокаСоединения,
	               |	ВЫБОР
	               |		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""А""
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Аванс,
	               |	ЕПСБУ.Валютный КАК Валютный
	               |ПОМЕСТИТЬ ВсеСчета
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В(&Счет205)
	               |	И НЕ ЕПСБУ.ЭлементГруппа
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВсеСчета.Ссылка КАК СчетРасчетов,
	               |	ВсеСчета1.Ссылка КАК СчетАвансов,
	               |	ВсеСчета.Валютный КАК СчетРасчетовВалютный,
	               |	ВсеСчета1.Валютный КАК СчетАвансовВалютный
	               |ПОМЕСТИТЬ СоответствиеСчетов
	               |ИЗ
	               |	ВсеСчета КАК ВсеСчета
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВсеСчета КАК ВсеСчета1
	               |		ПО ВсеСчета.СтрокаСоединения = ВсеСчета1.СтрокаСоединения
	               |			И (НЕ ВсеСчета.Аванс)
	               |			И (ВсеСчета1.Аванс)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Субконто1,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Субконто2,
	               |	ЖурналПроводокЕПСБУОстатки.Валюта КАК Валюта,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	               |	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК РублеваяСуммаАванса,
	               |	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаАванса
	               |ПОМЕСТИТЬ ОстаткиАвансов
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			Счет В
	               |				(ВЫБРАТЬ
	               |					СоответствиеСчетов.СчетАвансов
	               |				ИЗ
	               |					СоответствиеСчетов),
	               |			,
	               |			Организация = &Организация
	               |				И &УсловиеКФО
	               |				И &УсловиеКПС
	               |				И &УсловиеИФО
	               |				И &УсловиеПодразделение
	               |				И &УсловиеДоговор
	               |				И Субконто1 = &Контрагент) КАК ЖурналПроводокЕПСБУОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОстаткиАвансов.Счет КАК СчетАванса,
	               |	ОстаткиАвансов.Субконто1 КАК Контрагент,
	               |	ОстаткиАвансов.Субконто2 КАК Договор,
	               |	ЕСТЬNULL(ОстаткиАвансов.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК Валюта,
	               |	ВЫБОР
	               |		КОГДА ИспользоватьВалютныйУчет.Значение
	               |				И СоответствиеСчетов.СчетАвансовВалютный
	               |				И ЕСТЬNULL(ОстаткиАвансов.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА -ОстаткиАвансов.ВалютнаяСуммаОстатокДт
	               |		ИНАЧЕ -ОстаткиАвансов.СуммаОстатокДт
	               |	КОНЕЦ КАК ОстатокАванса,
	               |	СоответствиеСчетов.СчетРасчетов КАК СчетРасчетов,
	               |	ОстаткиАвансов.КПС КАК КПС,
	               |	ОстаткиАвансов.КФО КАК КФО,
	               |	-ОстаткиАвансов.РублеваяСуммаАванса КАК РублеваяСуммаАванса,
	               |	-ОстаткиАвансов.ВалютнаяСуммаАванса КАК ВалютнаяСуммаАванса
	               |ИЗ
	               |	ОстаткиАвансов КАК ОстаткиАвансов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеСчетов КАК СоответствиеСчетов
	               |		ПО ОстаткиАвансов.Счет = СоответствиеСчетов.СчетАвансов,
	               |	Константа.ИспользоватьВалютныйУчет КАК ИспользоватьВалютныйУчет";
	Если Ссылка.Пустая() Тогда				   
		Запрос.УстановитьПараметр("Период",			Период);
	Иначе
		Запрос.УстановитьПараметр("Период", 		Ссылка.МоментВремени());
	КонецЕсли;
	Запрос.УстановитьПараметр("Организация", 		Организация);
	Запрос.УстановитьПараметр("Контрагент", 		Контрагент);
	Запрос.УстановитьПараметр("Счет205",	 		БухгалтерскийУчет.СписокСчетов("205.00"));
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ИФО) Тогда
		Запрос.УстановитьПараметр("ИФО", 			ИФО);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
	Иначе
		Запрос.УстановитьПараметр("УсловиеИФО",		Истина);
	КонецЕсли;
	Если ЗначениеЗаполнено(КФО) Тогда
		Запрос.УстановитьПараметр("КФО", 			КФО);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
	Иначе
		Запрос.УстановитьПараметр("УсловиеКФО",		Истина);
	КонецЕсли;
	Если ЗначениеЗаполнено(КПС) Тогда
		Запрос.УстановитьПараметр("КПС", 			КПС);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС", "КПС = &КПС");
	Иначе
		Запрос.УстановитьПараметр("УсловиеКПС",		Истина);
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") 
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("205.00").УчетПоПодразделениям Тогда
		Запрос.УстановитьПараметр("Подразделение",	Подразделение);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "Подразделение = &Подразделение");
	Иначе
		Запрос.УстановитьПараметр("УсловиеПодразделение", Истина);
	КонецЕсли;
	Если ЗначениеЗаполнено(Договор) Тогда
		Запрос.УстановитьПараметр("Договор", 		Договор);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор", "Субконто2 = &Договор");
	Иначе
		Запрос.УстановитьПараметр("УсловиеДоговор",	Истина);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

////////////////////////////////////////////////////////////////////////////////
// ОСНОВНЫЕ СРЕДСТВА

// Оставлена для совместимости с ранним программным интерфейсом и типовыми операциями.
//
Функция ПолучитьСчетУчетаОС(ОсновноеСредство, ВидСчета = "СчетУчета", Период = Неопределено) Экспорт
	
	СчетУчетаОС = УправлениеОсновнымиСредствами.СчетУчетаОС(ОсновноеСредство, Период);
	Если ВидСчета = "СчетУчета" Тогда
		Возврат СчетУчетаОС;
	Иначе
		ВсеСчетаУчетаОС = УправлениеОсновнымиСредствами.ВсеСчетаУчетаОС(СчетУчетаОС);
		Если ВсеСчетаУчетаОС.Свойство(ВидСчета) Тогда
			Возврат ВсеСчетаУчетаОС[ВидСчета];
		Иначе
			Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

// Оставлена для совместимости с ранним программным интерфейсом и типовыми операциями.
//
Функция ПолучитьСчетаУчетаОС(ОсновноеСредство, Период = Неопределено) Экспорт
	
	СчетУчетаОС = УправлениеОсновнымиСредствами.СчетУчетаОС(ОсновноеСредство, Период);
	Возврат УправлениеОсновнымиСредствами.ВсеСчетаУчетаОС(СчетУчетаОС);
	
КонецФункции

Функция РассчитанныеОстаткиОСНМАНПА(ДокументСсылка) Экспорт
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	ЭтоДокументОСвШапке			=  (ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектаОС")
								ИЛИ ТипДокумента = Тип("ДокументСсылка.ПередачаЗдания") 
								ИЛИ ТипДокумента = Тип("ДокументСсылка.СписаниеОбъектаОС") 
								ИЛИ ТипДокумента = Тип("ДокументСсылка.СписаниеТранспорта") 
								ИЛИ ТипДокумента = Тип("ДокументСсылка.СписаниеАвтотранспорта"));
	ЭтоДокументОСвТЧ			=  (ТипДокумента = Тип("ДокументСсылка.ПередачаГруппОбъектовОС") 
								ИЛИ ТипДокумента = Тип("ДокументСсылка.СписаниеГруппОбъектовОС") 
								ИЛИ ТипДокумента = Тип("ДокументСсылка.СписаниеЛитературы") 
								ИЛИ ТипДокумента = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС"));
	ЭтоДокументПеремещение		=  (ТипДокумента = Тип("ДокументСсылка.ТребованиеНакладнаяОС")
								ИЛИ ТипДокумента = Тип("ДокументСсылка.НакладнаяНаВнутреннееПеремещениеОС2"));
	//ЕстьДатаСписанияСБухУчета	= ЭтоДокументОСвШапке 
	//							ИЛИ (ЭтоДокументОСвТЧ И ТипДокумента <> Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС"));
	ДокументСДатойПроведения = Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(ДокументСсылка));
	ЕстьДатаСписанияСБухУчета = ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ДатаСписанияСБухУчета", ДокументСсылка.Метаданные()) ИЛИ ДокументСДатойПроведения;
	
	ТребуемыеРеквизитыОбъекта = "Дата, Организация, КФО, ИФО";
	Если ЭтоДокументПеремещение Тогда
		ТребуемыеРеквизитыОбъекта = ТребуемыеРеквизитыОбъекта + ",ЦМООтправитель, ПодразделениеОтправитель";
	Иначе
		ТребуемыеРеквизитыОбъекта = ТребуемыеРеквизитыОбъекта + ",ЦМО, Подразделение";
	КонецЕсли;
	Если ЭтоДокументОСвШапке Тогда
		ТребуемыеРеквизитыОбъекта = ТребуемыеРеквизитыОбъекта + ",ОсновноеСредство, ИнвентарныйНомер, КПС";
	Иначе
		ТребуемыеРеквизитыОбъекта = ТребуемыеРеквизитыОбъекта + ",ОсновныеСредства";
	КонецЕсли;
	Если ЕстьДатаСписанияСБухУчета И НЕ ДокументСДатойПроведения Тогда
		ТребуемыеРеквизитыОбъекта = ТребуемыеРеквизитыОбъекта + ",ДатаСписанияСБухучета";
	КонецЕсли;
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, ТребуемыеРеквизитыОбъекта);
	Если ДокументСДатойПроведения Тогда
		РеквизитыДокумента.Вставить("ДатаСписанияСБухучета", БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументСсылка));
	КонецЕсли;	
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.ПустаяСтруктураПараметровПолученияОстатков();
	Если ЕстьДатаСписанияСБухУчета И РеквизитыДокумента.Дата <> РеквизитыДокумента.ДатаСписанияСБухучета Тогда
		ПараметрыПолученияОстатков.Период = РеквизитыДокумента.ДатаСписанияСБухучета;
	Иначе
		ПараметрыПолученияОстатков.Ссылка = ДокументСсылка;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков, РеквизитыДокумента, "Организация, КФО, ИФО");
	Если ЭтоДокументПеремещение Тогда
		ПараметрыПолученияОстатков.ЦМО 				= РеквизитыДокумента.ЦМООтправитель;
		ПараметрыПолученияОстатков.Подразделение	= РеквизитыДокумента.ПодразделениеОтправитель;
	Иначе	
		ПараметрыПолученияОстатков.ЦМО 				= РеквизитыДокумента.ЦМО;
		ПараметрыПолученияОстатков.Подразделение	= РеквизитыДокумента.Подразделение;
	КонецЕсли;
	Если ЭтоДокументОСвШапке Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков, РеквизитыДокумента, "ОсновноеСредство, ИнвентарныйНомер, КПС");
	Иначе
		ВыборкаСтрок = РеквизитыДокумента.ОсновныеСредства.Выбрать();
		Пока ВыборкаСтрок.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков.ТаблицаОС.Добавить(), ВыборкаСтрок);
		КонецЦикла; 
	КонецЕсли;
	
	ТаблицаОС = ОстаткиОСНМАНПАбаланс(ПараметрыПолученияОстатков);
	Возврат ТаблицаОС;

КонецФункции

// Исп. ПараметрыПолученияОстатков - Структура, возращаемая функцией ПустаяСтруктураПараметровПолученияОстатков()
// Для получения данных из таблицы остатков использовать функцию ЗаполнитьДанныеОстатковОСизТаблицыОстатков
//
Функция ОстаткиОСНМАНПАбаланс(ПараметрыПолученияОстатков)

	ТекстЗапроса = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ТаблицаОС.ОсновноеСредство КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	               |	ТаблицаОС.ИнвентарныйНомер,
	               |	ТаблицаОС.КПС,
	               |	ТаблицаОС.Количество
	               |ПОМЕСТИТЬ ТаблицаОС
	               |ИЗ
	               |	&ТаблицаОС КАК ТаблицаОС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТаблицаОС.ОсновноеСредство,
	               |	ТаблицаОС.ИнвентарныйНомер,
	               |	ТаблицаОС.КПС,
	               |	ТаблицаОС.Количество,
	               |	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета
	               |ПОМЕСТИТЬ ТаблицаУчетаОС
	               |ИЗ
	               |	ТаблицаОС КАК ТаблицаОС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(&Период, Организация В (&Организация)) КАК УчетныеДанныеОбъектаОССрезПоследних
	               |		ПО ТаблицаОС.ОсновноеСредство = УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ТаблицаУчетаОС.СчетУчета КАК СчетУчета,
	               |	ЕСТЬNULL(СоответствиеСчетовОС.СчетАмортизации, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетАмортизации,
	               |	ЕСТЬNULL(СоответствиеСчетовОС.СчетОС.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениямБаланс,
	               |	ЕСТЬNULL(СоответствиеСчетовОС.СчетАмортизации.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениямАморт
	               |ПОМЕСТИТЬ ТаблицаСчетов
	               |ИЗ
	               |	ТаблицаУчетаОС КАК ТаблицаУчетаОС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	               |		ПО ТаблицаУчетаОС.СчетУчета = СоответствиеСчетовОС.СчетОС
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	СчетУчета,
	               |	СчетАмортизации
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЖурналПроводокЕПСБУОстатки.Счет,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ЦМО) КАК ЦМО,
	               |	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК БалансоваяСтоимость,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстаток,
	               |	ЖурналПроводокЕПСБУОстатки.КПС
	               |ПОМЕСТИТЬ ОстаткиБалансПодр
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			Счет В
	               |				(ВЫБРАТЬ
	               |					ТаблицаСчетов.СчетУчета
	               |				ИЗ
	               |					ТаблицаСчетов КАК ТаблицаСчетов
	               |				ГДЕ
	               |					ТаблицаСчетов.СчетУчета <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)),
	               |			&СубконтоОСЦМО,
	               |			Организация = &Организация
	               |				И (&ПоВсемКПС = ИСТИНА
	               |					ИЛИ КПС = &КПС)
	               |				И КФО = &КФО
	               |				И &УсловиеИФО
	               |				И Субконто1 В
	               |					(ВЫБРАТЬ
	               |						ТаблицаУчетаОС.ОсновноеСредство
	               |					ИЗ
	               |						ТаблицаУчетаОС КАК ТаблицаУчетаОС)) КАК ЖурналПроводокЕПСБУОстатки
	               |ГДЕ
	               |	&УсловиеПодразделениеБаланс
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
