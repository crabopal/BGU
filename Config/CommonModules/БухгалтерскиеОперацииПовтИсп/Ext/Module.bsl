// МЗ в пути

Функция ПолучитьОстаткиМЗвПути( ДокументСсылка,
								Период,
								ИмяТЧ,
								СчетУчетаМЗВПути,
								ИФО,
								КФО,
								КПС,
								Подразделение,
								Контрагент) Экспорт
								
	УчетПоПодразделениям = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЕСТЬNULL(ЕПСБУ.УчетПоПодразделениям, ЛОЖЬ)) КАК УчетПоПодразделениям
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&Счет107)";
	Запрос.УстановитьПараметр("Счет107", БухгалтерскийУчет.СписокСчетов("107.00"));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		УчетПоПодразделениям = Выборка.УчетПоПодразделениям;
	КонецЕсли;
	
	УчетПоПодразделениям = УчетПоПодразделениям И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
								
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаМатериалы",					ДокументСсылка[ИмяТч]);
	Запрос.УстановитьПараметр("Период",								Период);
	Запрос.УстановитьПараметр("Организация",						ДокументСсылка.Организация);
	Запрос.УстановитьПараметр("СчетУчетаМЗвПути",					СчетУчетаМЗВПути);
	Запрос.УстановитьПараметр("КФО",								КФО);
	Запрос.УстановитьПараметр("КПС",								КПС);
	Запрос.УстановитьПараметр("ИФО",								ИФО);
	Запрос.УстановитьПараметр("Подразделение",						Подразделение);
	Запрос.УстановитьПараметр("Контрагент",							Контрагент);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	УчетПоПодразделениям);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО",				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ТаблицаМатериалы.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	               |	ТаблицаМатериалы.Количество КАК Количество
	               |ПОМЕСТИТЬ ТаблицаМатериалы
	               |ИЗ
	               |	&ТаблицаМатериалы КАК ТаблицаМатериалы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.Организация,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ КАК ИФО,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ КАК Подразделение,
	               |	ЖурналПроводокЕПСБУОстатки.КФО,
	               |	ЖурналПроводокЕПСБУОстатки.Счет,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ПоступлениеМЗвПути,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Номенклатура,
	               |	СУММА(ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.СуммаОстаток, 0)) КАК СуммаОстаток,
	               |	СУММА(ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстаток, 0)) КАК КоличествоОстаток
	               |ПОМЕСТИТЬ ОстаткиМатериалов
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			Счет = &СчетУчетаМЗвПути,
	               |			,
	               |			Организация = &Организация
	               |				И (ИФО = &ИФО
	               |					ИЛИ &ИФО = ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |					ИЛИ НЕ &ИспользоватьУчетПоИФО)
	               |				И (КПС = &КПС
	               |					ИЛИ &КПС = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))
	               |				И (Подразделение = &Подразделение
	               |					ИЛИ НЕ &ИспользоватьУчетПоПодразделениям)
	               |				И (КФО = &КФО
	               |					ИЛИ &КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка))
	               |				И Субконто1 = &Контрагент
	               |				И Субконто2 В
	               |					(ВЫБРАТЬ
	               |						ТаблицаМатериалы.Номенклатура
	               |					ИЗ
	               |						ТаблицаМатериалы КАК ТаблицаМатериалы)) КАК ЖурналПроводокЕПСБУОстатки,
	               |	ТаблицаМатериалы КАК ТаблицаМатериалы
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЖурналПроводокЕПСБУОстатки.Счет,
	               |	ЖурналПроводокЕПСБУОстатки.КФО,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
	               |	ЖурналПроводокЕПСБУОстатки.Организация,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто2,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто1,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОстаткиМатериалов.Организация,
	               |	ОстаткиМатериалов.КПС,
	               |	ОстаткиМатериалов.ИФО,
	               |	ОстаткиМатериалов.Подразделение,
	               |	ОстаткиМатериалов.КФО,
	               |	ОстаткиМатериалов.Счет,
	               |	ОстаткиМатериалов.ПоступлениеМЗвПути,
	               |	ОстаткиМатериалов.Номенклатура,
	               |	ЕСТЬNULL(ОстаткиМатериалов.СуммаОстаток, 0) КАК СуммаОстаток,
	               |	ЕСТЬNULL(ОстаткиМатериалов.КоличествоОстаток, 0) КАК КоличествоОстаток,
	               |	ВЫБОР
	               |		КОГДА ТаблицаМатериалы.Количество > ЕСТЬNULL(ОстаткиМатериалов.КоличествоОстаток, 0)
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Нехватка,
	               |	ТаблицаМатериалы.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ТаблицаМатериалы.Номенклатура.Наименование,
	               |	ТаблицаМатериалы.Количество
	               |ИЗ
	               |	ТаблицаМатериалы КАК ТаблицаМатериалы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиМатериалов КАК ОстаткиМатериалов
	               |		ПО ТаблицаМатериалы.Номенклатура = ОстаткиМатериалов.Номенклатура";
	Возврат Запрос.Выполнить().Выгрузить();
								
КонецФункции

// Имущество казны

Функция ПолучитьОстаткиМатериаловИК(ДокументСсылка) Экспорт
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаОтпускИК")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТребованиеНакладнаяИК") Тогда
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата, Организация, ИФО, Подразделение, КФО");
		НоменклатураДокумента = ДокументСсылка.Материалы.Выгрузить();
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураДокумента.НомерСтроки КАК НомерСтроки,
	               |	НоменклатураДокумента.Номенклатура КАК Номенклатура,
	               |	НоменклатураДокумента.СчетУчета КАК СчетУчета,
	               |	НоменклатураДокумента.КПС КАК КПС,
	               |	НоменклатураДокумента.Количество КАК Количество
	               |ПОМЕСТИТЬ НоменклатураДокумента
	               |ИЗ
	               |	&НоменклатураДокумента КАК НоменклатураДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ СчетаУчета
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
	               |ГДЕ
	               |	ЕПСБУВидыСубконто.Ссылка В(&Счет10850)
	               |	И НЕ ЕПСБУ.ЭлементГруппа
	               |	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	               |	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Субконто1
	               |ПОМЕСТИТЬ Остатки
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			Счет В
	               |				(ВЫБРАТЬ
	               |					СчетаУчета.Ссылка
	               |				ИЗ
	               |					СчетаУчета КАК СчетаУчета),
	               |			,
	               |			Организация = &Организация
	               |				И КПС В (&КПС)
	               |				И КФО = &КФО
	               |				И Субконто1 В
	               |					(ВЫБРАТЬ
	               |						НоменклатураДокумента.Номенклатура
	               |					ИЗ
	               |						НоменклатураДокумента)) КАК ЖурналПроводокЕПСБУОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураДокумента.НомерСтроки КАК НомерСтроки,
	               |	НоменклатураДокумента.Номенклатура КАК Номенклатура,
	               |	НоменклатураДокумента.СчетУчета КАК СчетУчета,
	               |	НоменклатураДокумента.КПС КАК КПС,
	               |	НоменклатураДокумента.Количество КАК Количество,
	               |	НоменклатураВсего.Количество КАК КоличествоВсего,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстатокДт,
	               |	ВЫБОР
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт <> 0
	               |			ТОГДА ВЫБОР
	               |					КОГДА НоменклатураДокумента.Количество = НоменклатураВсего.Количество
	               |							И НоменклатураДокумента.Количество = ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
	               |						ТОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт
	               |					ИНАЧЕ НоменклатураДокумента.Количество * (ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт / ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК ЧИСЛО(10, 2)))
	               |				КОНЕЦ
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СуммаСписания,
	               |	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет
	               |ПОМЕСТИТЬ СуммыСписания
	               |ИЗ
	               |	НоменклатураДокумента КАК НоменклатураДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			НоменклатураДокумента.Номенклатура КАК Номенклатура,
	               |			НоменклатураДокумента.СчетУчета КАК СчетУчета,
	               |			НоменклатураДокумента.КПС КАК КПС,
	               |			СУММА(НоменклатураДокумента.Количество) КАК Количество
	               |		ИЗ
	               |			НоменклатураДокумента КАК НоменклатураДокумента
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			НоменклатураДокумента.Номенклатура,
	               |			НоменклатураДокумента.СчетУчета,
	               |			НоменклатураДокумента.КПС) КАК НоменклатураВсего
	               |		ПО НоменклатураДокумента.Номенклатура = НоменклатураВсего.Номенклатура
	               |		И НоменклатураДокумента.СчетУчета = НоменклатураВсего.СчетУчета
	               |		И НоменклатураДокумента.КПС = НоменклатураВсего.КПС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК ЖурналПроводокЕПСБУОстатки
	               |		ПО НоменклатураДокумента.Номенклатура = ЖурналПроводокЕПСБУОстатки.Субконто1
	               |		И НоменклатураДокумента.КПС = ЖурналПроводокЕПСБУОстатки.КПС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НомераСтрок.Номенклатура КАК Номенклатура,
	               |	НомераСтрок.СчетУчета КАК СчетУчета,
	               |	НомераСтрок.КПС КАК КПС,
	               |	НомераСтрок.МаксимальныйНомерСтроки КАК МаксимальныйНомерСтроки,
	               |	Корректировки.Корректировка КАК Корректировка
	               |ПОМЕСТИТЬ СуммыКорректировок
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		НоменклатураДокумента.Номенклатура КАК Номенклатура,
	               |		НоменклатураДокумента.СчетУчета КАК СчетУчета,
	               |		НоменклатураДокумента.КПС КАК КПС,
	               |		МАКСИМУМ(НоменклатураДокумента.НомерСтроки) КАК МаксимальныйНомерСтроки
	               |	ИЗ
	               |		НоменклатураДокумента КАК НоменклатураДокумента
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		НоменклатураДокумента.Номенклатура,
	               |		НоменклатураДокумента.СчетУчета,
	               |		НоменклатураДокумента.КПС) КАК НомераСтрок
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			СуммыСписания.Номенклатура КАК Номенклатура,
	               |			СуммыСписания.СчетУчета КАК СчетУчета,
	               |			СуммыСписания.КПС КАК КПС,
	               |			СуммыСписания.СуммаОстатокДт - СУММА(СуммыСписания.СуммаСписания) КАК Корректировка
	               |		ИЗ
	               |			СуммыСписания КАК СуммыСписания
	               |		ГДЕ
	               |			СуммыСписания.КоличествоВсего = СуммыСписания.КоличествоОстатокДт
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			СуммыСписания.Номенклатура,
	               |			СуммыСписания.СчетУчета,
	               |			СуммыСписания.СуммаОстатокДт,
	               |			СуммыСписания.КПС) КАК Корректировки
	               |		ПО НомераСтрок.Номенклатура = Корректировки.Номенклатура
	               |		И НомераСтрок.СчетУчета = Корректировки.СчетУчета
	               |		И НомераСтрок.КПС = Корректировки.КПС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СуммыСписания.НомерСтроки КАК НомерСтроки,
	               |	СуммыСписания.Номенклатура КАК Номенклатура,
	               |	ПРЕДСТАВЛЕНИЕ(СуммыСписания.Номенклатура) КАК НоменклатураПредставление,
	               |	СуммыСписания.СчетУчета КАК СчетУчета,
	               |	СуммыСписания.КПС КАК КПС,
	               |	СуммыСписания.Количество КАК Количество,
	               |	СуммыСписания.КоличествоВсего КАК КоличествоВсего,
	               |	СуммыСписания.КоличествоОстатокДт КАК КоличествоОстатокДт,
	               |	ЕСТЬNULL(СуммыСписания.СуммаСписания, 0) + ЕСТЬNULL(СуммыКорректировок.Корректировка, 0) КАК СуммаСписания,
	               |	ВЫБОР
	               |		КОГДА СуммыСписания.КоличествоВсего > ЕСТЬNULL(СуммыСписания.КоличествоОстатокДт, 0)
	               |				И СуммыКорректировок.МаксимальныйНомерСтроки = СуммыСписания.НомерСтроки
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Нехватка,
	               |	СуммыСписания.Счет КАК Счет
	               |ИЗ
	               |	СуммыСписания КАК СуммыСписания
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СуммыКорректировок КАК СуммыКорректировок
	               |		ПО СуммыСписания.Номенклатура = СуммыКорректировок.Номенклатура
	               |			И СуммыСписания.СчетУчета = СуммыКорректировок.СчетУчета
	               |			И СуммыСписания.КПС = СуммыКорректировок.КПС
	               |			И СуммыСписания.НомерСтроки = СуммыКорректировок.МаксимальныйНомерСтроки
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	
	Запрос.УстановитьПараметр("Период", 				РеквизитыДокумента.Дата-1);
	Запрос.УстановитьПараметр("Организация", 			РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("КПС", 					ОбщегоНазначенияКлиентСервер.СвернутьМассив(НоменклатураДокумента.ВыгрузитьКолонку("КПС")));
	Запрос.УстановитьПараметр("КФО", 					РеквизитыДокумента.КФО);
	Запрос.УстановитьПараметр("НоменклатураДокумента",	НоменклатураДокумента);
	Запрос.УстановитьПараметр("Счет10850",				БухгалтерскийУчет.СписокСчетов("108.50"));
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//И ИФО = &ИФО", "И ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО",				РеквизитыДокумента.ИФО);	
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("108.00").УчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//И Подразделение = &Подразделение", "И Подразделение = &Подразделение");
		Запрос.УстановитьПараметр("Подразделение",		РеквизитыДокумента.Подразделение);	
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Область УчетНеоплаченныхПутевок

// Неоплаченные путевки

Функция ПолучитьТаблицуОстатковПутевок(ДокументСсылка) Экспорт
	Перем ЦМО, Подразделение;	
		
	ИмяРеквизитаЦМО = "";
	ИмяРеквизитаПодразделение = "";
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПеремещениеНеоплаченныхПутевок") Тогда
    	ИмяРеквизитаЦМО 			= "ЦМООтправитель";
		ИмяРеквизитаПодразделение 	= "ПодразделениеОтправитель";
		ИмяДокумента				= "ПеремещениеНеоплаченныхПутевок";
	Иначе 
    	ИмяРеквизитаЦМО 			= "ЦМО";
		ИмяРеквизитаПодразделение 	= "Подразделение";
		ИмяДокумента				= "ВыбытиеНеоплаченныхПутевок";
	КонецЕсли;
		
	РеквизитыДокумента = "СчетУчета,Организация,КФО,ИФО,Дата,"+ИмяРеквизитаЦМО+","+ИмяРеквизитаПодразделение;
	ЗначенияРеквизитовДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, РеквизитыДокумента);
	
	ЗначенияРеквизитовДокумента.Свойство(ИмяРеквизитаЦМО, ЦМО);
	ЗначенияРеквизитовДокумента.Свойство(ИмяРеквизитаПодразделение, Подразделение);
	
	СчетУчета = ЗначенияРеквизитовДокумента.СчетУчета;
	СвойстваСчетаУчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчета);
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И СвойстваСчетаУчета.УчетПоПодразделениям;
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", 							ДокументСсылка);
	Запрос.УстановитьПараметр("Период", 							ЗначенияРеквизитовДокумента.Дата);
	Запрос.УстановитьПараметр("СчетУчета", 							СчетУчета);
	Запрос.УстановитьПараметр("Организация", 						ЗначенияРеквизитовДокумента.Организация);
	Запрос.УстановитьПараметр("КФО", 								ЗначенияРеквизитовДокумента.КФО);
	Запрос.УстановитьПараметр("ЦМО", 								ЦМО);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", 				ИспользоватьУчетПоИФО);
	Запрос.УстановитьПараметр("ИФО", 								ЗначенияРеквизитовДокумента.ИФО);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	Запрос.УстановитьПараметр("Подразделение", 						Подразделение);
	
	МассивСубконто = Новый Массив;
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыДенежныхДокументов);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ДенежныеДокументы);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	Запрос.УстановитьПараметр("МассивСубконто", 					МассивСубконто);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	МатериалыДокумента.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	               |	МатериалыДокумента.ДенежныйДокумент КАК ДенежныйДокумент,
	               |	МатериалыДокумента.НомерСтроки КАК НомерСтроки,
	               |	МатериалыДокумента.Количество КАК Количество
	               |ПОМЕСТИТЬ ИсходныеДанныеДокумента
	               |ИЗ
	               |	Документ.ПеремещениеНеоплаченныхПутевок.Материалы КАК МатериалыДокумента
	               |ГДЕ
	               |	МатериалыДокумента.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МатериалыДокумента.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	               |	МатериалыДокумента.ДенежныйДокумент КАК ДенежныйДокумент,
	               |	СУММА(МатериалыДокумента.Количество) КАК Количество
	               |ПОМЕСТИТЬ ДанныеДокумента
	               |ИЗ
	               |	ИсходныеДанныеДокумента КАК МатериалыДокумента
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	МатериалыДокумента.ВидДенежногоДокумента,
	               |	МатериалыДокумента.ДенежныйДокумент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВсеМатериалыДокумента.ВидДенежногоДокумента,
	               |	ВсеМатериалыДокумента.ДенежныйДокумент,
	               |	ВсеМатериалыДокумента.Количество,
	               |	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.СуммаОстаток, 0) КАК СуммаВсего,
	               |	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстаток, 0) КАК КоличествоВсего
	               |ИЗ
	               |	ДанныеДокумента КАК ВсеМатериалыДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |				&Период,
	               |				Счет = &СчетУчета,
	               |				&МассивСубконто,
	               |				Организация = &Организация
	               |					И КФО = &КФО
	               |					И Субконто3 = &ЦМО
	               |					И (НЕ &ИспользоватьУчетПоИФО
	               |						ИЛИ ИФО = &ИФО)
	               |					И (НЕ &ИспользоватьУчетПоПодразделениям
	               |						ИЛИ Подразделение = &Подразделение)
	               |					И (Субконто1, Субконто2) В
	               |						(ВЫБРАТЬ
	               |							МатериалыДокумента.ВидДенежногоДокумента,
	               |							МатериалыДокумента.ДенежныйДокумент
	               |						ИЗ
	               |							ДанныеДокумента КАК МатериалыДокумента)) КАК ЖурналПроводокЕПСБУОстатки
	               |		ПО ВсеМатериалыДокумента.ВидДенежногоДокумента = ЖурналПроводокЕПСБУОстатки.Субконто1
	               |			И ВсеМатериалыДокумента.ДенежныйДокумент = ЖурналПроводокЕПСБУОстатки.Субконто2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИсходныеДанныеДокумента.НомерСтроки КАК НомерСтроки,
	               |	ИсходныеДанныеДокумента.ВидДенежногоДокумента,
	               |	ИсходныеДанныеДокумента.ДенежныйДокумент,
	               |	ИсходныеДанныеДокумента.Количество
	               |ИЗ
	               |	ИсходныеДанныеДокумента КАК ИсходныеДанныеДокумента
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
				   
	Запрос.Текст = СтрЗаменить(Запрос.Текст, ".ПеремещениеНеоплаченныхПутевок.", "."+ИмяДокумента+".");				   
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ТаблицаСтрокДокумента = Результаты[3].Выгрузить();
	
	ТаблицаОстатки = Результаты[2].Выгрузить();
	
		// Списание номенклатуры с учетом остатков
	ТаблицаСписанных = ТаблицаСтрокДокумента.СкопироватьКолонки();
	ТаблицаСписанных.Колонки.Добавить("Сумма",                Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТаблицаСписанных.Колонки.Добавить("ОстатокПревышен",      Новый ОписаниеТипов("Булево"));
	
	Для каждого СтрокаДокумента Из ТаблицаСтрокДокумента Цикл
	
		КоличествоОсталосьПогасить = СтрокаДокумента.Количество;
		Если КоличествоОсталосьПогасить <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыОтбора = Новый Структура("ВидДенежногоДокумента,ДенежныйДокумент");
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаДокумента);
		
		СтрокиОстатков = ТаблицаОстатки.НайтиСтроки(ПараметрыОтбора);
		
		Для каждого СтрокаОстатков Из СтрокиОстатков Цикл

			Если СтрокаОстатков.Количество <= 0
				ИЛИ СтрокаОстатков.КоличествоВсего <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Количество = Мин(СтрокаОстатков.КоличествоВсего, КоличествоОсталосьПогасить);

			Если СтрокаОстатков.КоличествоВсего = КоличествоОсталосьПогасить Тогда
				Сумма = СтрокаОстатков.СуммаВсего;
			Иначе
				Сумма = Окр(СтрокаОстатков.СуммаВсего * Количество / СтрокаОстатков.КоличествоВсего, 2, 1);
			КонецЕсли;
			
			КоличествоОсталосьПогасить = КоличествоОсталосьПогасить - Количество;

			//СтрокаОстатков.Количество      = СтрокаОстатков.Количество - Количество;
			СтрокаОстатков.КоличествоВсего = СтрокаОстатков.КоличествоВсего - Количество;
			
			СтрокаОстатков.СуммаВсего      = СтрокаОстатков.СуммаВсего - Сумма;

			СтрокаСписанных = ТаблицаСписанных.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСписанных, СтрокаДокумента);
			СтрокаСписанных.Количество     = Количество;
			СтрокаСписанных.Сумма          = Сумма;
			
		КонецЦикла;
		
		// Несписанное количество добавим отдельной строкой
		Если КоличествоОсталосьПогасить > 0  Тогда
			
			СтрокаСписанных = ТаблицаСписанных.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСписанных, СтрокаДокумента);
			СтрокаСписанных.Количество      = КоличествоОсталосьПогасить;
			СтрокаСписанных.ОстатокПревышен = Истина;
			
			ТекстОшибки = НСтр("ru='Указанное количество превышает остаток по счету %3.
				|Остаток: %1; Не хватает: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				СтрокаДокумента.Количество - КоличествоОсталосьПогасить,
				КоличествоОсталосьПогасить,
				СчетУчета);
				
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				НСтр("ru = 'Отпущено'"),
				СтрокаДокумента.НомерСтроки,
				"Материалы",
				ТекстОшибки);
				
			ПолеКоличество = "Материалы[" + Формат(СтрокаДокумента.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Количество";
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка, ПолеКоличество, "Объект");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаСписанных;
		
КонецФункции

#КонецОбласти

#Область УчетОсновныхСредств

