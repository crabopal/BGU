Функция СчетПоставщикаТМЦ(ТМЦ, ВозможныйСчет) Экспорт
	
	Если ЗначениеЗаполнено(ВозможныйСчет) Тогда
		Если БухгалтерскийУчет.СчетВИерархии(ВозможныйСчет, "106.11,106.21,106.31,106.41,107.11,107.21,107.31,107.41") Тогда
			Возврат БухгалтерскийУчет.СчетПоКоду("302.31");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(ВозможныйСчет, "106.22,106.32,106.42") Тогда
			Возврат БухгалтерскийУчет.СчетПоКоду("302.32");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(ВозможныйСчет, "106.13,106.43") Тогда
			Возврат БухгалтерскийУчет.СчетПоКоду("302.33");
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	
КонецФункции

// Функция возвращает ссылку на счет учета, установленный в карточке номенклатуры
