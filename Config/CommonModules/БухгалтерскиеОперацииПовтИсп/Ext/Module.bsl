// Получает значение реквизита элемента, указанное через точку.
// Параметры:
//	Элемент - ЛюбаяСсылка - ссылка из которой получается очередное значение реквизита
//	ИмяРеквизита - Строка - имя получаемого реквизита. Может быть указано через точку
// Возращаемое значение:
//	Произвольный - значение реквизита.
//
Функция ЗначениеРеквизита(Знач Элемент, Знач ИмяРеквизита) Экспорт
	
	// Если Элемент пустой, то возвращаем его или пустую строку.
	// Если нужно Наименование, то возвращаем пустую строку, чтобы не было ошибки при
	// конкатенации в вычисляемом поле.
	Если Не ЗначениеЗаполнено(Элемент) Тогда
		БухгалтерскиеОперации.ДобавитьОшибкуВКонтекстПроведения(
			СтрШаблон(НСтр("ru = 'Не заполнен реквизит объекта.
				|Объект: %1 (тип объекта: %2),
				|Имя реквизита: %3'"),
			Элемент,
			ТипЗнч(Элемент),
			ИмяРеквизита), "ЗначениеРеквизита");
			
		Если ВРег(ИмяРеквизита) = "НАИМЕНОВАНИЕ" Тогда
			Возврат "";
		Иначе
			Возврат Элемент;
		КонецЕсли;
		
	КонецЕсли;
	
	// Последовательно читаем значения реквизитов через точку, чтобы определить где
	// возникла ошибка заполнения.
	Если ИмяРеквизита <> "" Тогда
		СоставИмениРеквизита = СтрРазделить(ИмяРеквизита, ".");
		Для каждого ТекЧастьИмениРеквизита Из СоставИмениРеквизита Цикл
			
			ЭлементДоИзменения = Элемент; // Запомним Элемент, чтобы добавить его в вывод ошибки.
			
			Элемент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент, ТекЧастьИмениРеквизита);
			Если Не ЗначениеЗаполнено(Элемент) Тогда
				
				Если ВРЕГ(ИмяРеквизита) = "НАИМЕНОВАНИЕ" Тогда
					// Возвращаем строку, чтобы не было ошибки при конкатенации в вычисляемом поле.
					Элемент = "";
				КонецЕсли;
				
				// Добавим информацию об ошибке для последующего вывода
				Если СоставИмениРеквизита.Количество() = 1 Тогда
					ТекстСообщения = НСтр("ru = 'Не заполнен реквизит объекта.
						|Объект: %1 (тип объекта: %2),
						|Имя реквизита: %3'");
				Иначе
					// добавим полный путь к реквизиту
					ТекстСообщения = НСтр("ru = 'Не заполнен реквизит объекта.
						|Объект: %1 (тип объекта: %2),
						|Имя реквизита: %3,
						|Полный путь к реквизиту: %4'");
				КонецЕсли;
				
				БухгалтерскиеОперации.ДобавитьОшибкуВКонтекстПроведения(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
						ЭлементДоИзменения,
						ТипЗнч(ЭлементДоИзменения),
						ТекЧастьИмениРеквизита,
						ИмяРеквизита), "БУХГАЛТЕРСКИЕОПЕРАЦИИ.ЗНАЧЕНИЕРЕКВИЗИТА");
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Элемент;
	
КонецФункции

// Возвращает значение дополнительного реквизита из структуры ДополнительныеРеквизиты
// Если нужный ключ отсутствует, то пишется ошибка в журнал регистрации, с указанием типовой операции
// и именем реквизита.
// Используется при формировании проводок в процедуре модуля БухгалтерскиеОперацииПроведениеДокументов
//
Функция ЗначениеДопРеквизита(ДополнительныеРеквизиты, ИмяДопРеквизита) Экспорт
	Результат = Неопределено;
	Если ДополнительныеРеквизиты.Свойство(ИмяДопРеквизита, Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТиповаяОперация = Неопределено;
	ДополнительныеРеквизиты.Свойство("ТиповаяОперация", ТиповаяОперация);
	ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииПроведениеПоВнешнейФункции(), 
		УровеньЖурналаРегистрации.Предупреждение,
		Метаданные.Справочники.ТиповыеОперации,
		ТиповаяОперация,
		СтрШаблон(НСтр("ru='Неверная настройка типовой операции %1: не найден требуемый доп. реквизит %2'"),
			ТиповаяОперация, ИмяДопРеквизита));
	
	ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Ошибки в настройке типовой операции. Подробности в журнале регистрации'"));
КонецФункции

Функция УчетнаяПолитикаОрганизации(Организация, Дата) Экспорт

	Возврат Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, Дата);

КонецФункции // УчетнаяПолитикаОрганизации()

Функция КПССчета(Организация, Знач ИФО = Неопределено, КФО, Период, Счет, ВидПоказателя = Неопределено, КПСКорр = Неопределено) Экспорт
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	КонецЕсли;
	
	КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "Код");
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ" + ?(УчетнаяПолитикаОрганизации(Организация, Период).ЭтоАвтономноеУчреждение ИЛИ КодСчета = "201.35", "", " ПЕРВЫЕ 1") + "
	|	РабочиеСчетаСрезПоследних.КПС КАК КПС,
	|	РабочиеСчетаСрезПоследних.КПС.Код КАК КПСКод,
	|	МАКСИМУМ(РабочиеСчетаСрезПоследних.Период) КАК Период
	|ИЗ
	|	РегистрСведений.РабочиеСчета.СрезПоследних(
	|			&Период,
	|				Организация = &Организация
	|				И КФО = &КФО
	|				И Счет = &Счет
	|				<ВидПоказателя>
	|				И &УсловиеИФО) КАК РабочиеСчетаСрезПоследних
	|ГДЕ
	|	РабочиеСчетаСрезПоследних.Актуален = ИСТИНА
	|СГРУППИРОВАТЬ ПО
	|	РабочиеСчетаСрезПоследних.КПС
	|
	|УПОРЯДОЧИТЬ ПО
	| 	МАКСИМУМ(РабочиеСчетаСрезПоследних.Период) УБЫВ");
	
	Запрос.УстановитьПараметр("Период", 		Период);
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("КФО", 			КФО);
	Запрос.УстановитьПараметр("Счет", 			Счет);
	
	Если ЗначениеЗаполнено(ИФО) Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		
		Запрос.УстановитьПараметр("ИФО", 		ИФО);
		
	Иначе
		
		Запрос.УстановитьПараметр("УсловиеИФО", Истина);
		
	КонецЕсли;
	
	Если ВидПоказателя = Неопределено Тогда
		
		ОтборПоОграничениям = БухгалтерскийУчетПовтИсп.ПолучитьДопустимыеВидыКПССчета(Счет);
		ОтборВидовКПС = БухгалтерскийУчет.ПолучитьВидыКПСПоУчетнойПолитикеИОграничениям(ОтборПоОграничениям, БухгалтерскийУчетПовтИсп.ВидыКПСПоУчетнойПолитике(Организация, ИФО, КФО, Период));
		ОтборУточнениеКПС = БухгалтерскийУчет.ПолучитьУточнениеКПС(ОтборПоОграничениям);
		
		ВидПоказателяТекст = "И КПС.ВидПоказателя В (&ВидПоказателя)
		| И КПС.УточнениеПоказателя В (&УточнениеПоказателя)";
		
		Запрос.УстановитьПараметр("ВидПоказателя", ОтборВидовКПС);
		Запрос.УстановитьПараметр("УточнениеПоказателя", ОтборУточнениеКПС);
		
	Иначе
		ВидПоказателяТекст = "И КПС.ВидПоказателя В (&ВидПоказателя)";
		Если ТипЗнч(ВидПоказателя) = Тип("ПеречислениеСсылка.ВидыКБК") Тогда
			// Указано одно значение.
			ЗначениеПараметраВидПоказателя = ВидПоказателя;
			
		ИначеЕсли ТипЗнч(ВидПоказателя) = Тип("Структура") Тогда
			// Указано несколько значений.
			ЗначениеПараметраВидПоказателя = Новый Массив();
			Для Каждого Элем Из ВидПоказателя Цикл
				ЗначениеПараметраВидПоказателя.Добавить(Элем.Значение);
			КонецЦикла;
			
		Иначе
			ЗначениеПараметраВидПоказателя = Неопределено;
		КонецЕсли;
		Запрос.УстановитьПараметр("ВидПоказателя", ЗначениеПараметраВидПоказателя);
		
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "<ВидПоказателя>", ВидПоказателяТекст);
	
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Если Выборка.Количество() = 1 Тогда
		Возврат Выборка[0].КПС; 
	КонецЕсли;	
	
	Если Выборка.Количество() > 1 И
		ЗначениеЗаполнено(КПСКорр) И 
		(УчетнаяПолитикаОрганизации(Организация, Период).ЭтоАвтономноеУчреждение ИЛИ КодСчета = "201.35") Тогда
		
		КодКПСКорр = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КПСКорр, "Код");
		
		КодДляПоиска2 = Лев(КодКПСКорр, 14) + "000";
		КодДляПоиска1 = Лев(КодКПСКорр, 4) + "0000000000000";
		
		НужныеСтроки = Выборка.НайтиСтроки(Новый Структура("КПСКод", КодДляПоиска1));
		
		Если НужныеСтроки.Количество() = 1 Тогда
			
			Возврат НужныеСтроки[0].КПС;
			
		Иначе
			
			НужныеСтроки = Выборка.НайтиСтроки(Новый Структура("КПСКод", КодДляПоиска2));
			
			Если НужныеСтроки.Количество() = 1 Тогда
				
				Возврат НужныеСтроки[0].КПС;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
		
КонецФункции	

Функция ОбъектВИерархии(Знач Объект, Знач Группа) Экспорт
	Если НЕ ЗначениеЗаполнено(Объект) ИЛИ Не ЗначениеЗаполнено(Группа) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Группа) = Тип("Строка") Тогда
		Группа = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект).НайтиПоКоду(Группа);
		Если Группа = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Объект = Группа ИЛИ Объект.ПринадлежитЭлементу(Группа);
КонецФункции

// Возвращает значение реквизита "НаименованиеПолное", если оно заполнено.
//Если значение реквизита не заполнено или такого реквизита нет, то возвращается значение реквизита "Наименование".
//Если передано не ссылочное значение, то возвращает всегда пустую строку.
//
// Параметры:
//  Объект	 - ЛюбаяСсылка - ссылка на объект.
// Возвращаемое значение:
// Строка - Полное наименование, наименование или пустая строка.
Функция ПолноеНаименованиеОбъекта(Объект) Экспорт
	
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект)) Тогда
		
		ЕстьРеквизитПолноеНаименование = Объект.Метаданные().Реквизиты.Найти("НаименованиеПолное") <> Неопределено;
		
		Если ЕстьРеквизитПолноеНаименование Тогда
			СтрокаРеквизитов = "Наименование,НаименованиеПолное";
		Иначе
			СтрокаРеквизитов = "Наименование";
		КонецЕсли;
		
		ДанныеОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, СтрокаРеквизитов);
		
		Если ЕстьРеквизитПолноеНаименование И ЗначениеЗаполнено(ДанныеОбъекта.НаименованиеПолное) Тогда
			Возврат ДанныеОбъекта.НаименованиеПолное;
		Иначе
			Возврат ДанныеОбъекта.Наименование;
		КонецЕсли;

	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
КонецФункции

Функция СписокТиповСубконто() Экспорт
	СписокРезультат = Новый СписокЗначений;
	ОписаниеТипов = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	МассивТипов = ОписаниеТипов.Типы();
	Для каждого ТекТипСубконто Из МассивТипов Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(ТекТипСубконто);
		Если МетаданныеТипа <> Неопределено Тогда
			СписокРезультат.Добавить(ТекТипСубконто, МетаданныеТипа.ПолноеИмя());
		КонецЕсли;
	КонецЦикла; 
	Возврат СписокРезультат;
КонецФункции

Функция ПолучитьОбъектВоВременномХранилище() Экспорт
	Возврат ПоместитьВоВременноеХранилище(Неопределено);
КонецФункции	

Функция ПоСчетуВедетсяУчетПоПодразделениям(Счет) Экспорт

	Если ТипЗнч(Счет) = Тип("Строка") Тогда
		КодСчета = Счет;
	ИначеЕсли ТипЗнч(Счет) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда 
		КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "Код");
	Иначе
		Возврат Истина;
	КонецЕсли;
	
	Возврат БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета(КодСчета).УчетПоПодразделениям = Истина;

КонецФункции // ПоСчетуВедетсяУчетПоПодразделениям()

// Возвращает кэшированную ссылку на объект. Используется для передачи произвольных данных между
// функциями, вызываемыми в вычисляемых выражениях СКД.
// Параметры:
//	ВидОбъекта - Число - 	1 - Массив
//						    2 - ТаблицаЗначений
//						    3 - СписокЗначений
//						    4 - Структура
//	Идентификатор - Строка - используется только для кэширования, чтобы получить однозначно уникальное значение, в пределах сеанса
//
Функция ПолучитьУказательНаОбъект(ВидОбъекта, Идентификатор = "") Экспорт

	Если ВидОбъекта = 1 Тогда
		Возврат Новый Массив;
	ИначеЕсли ВидОбъекта = 2 Тогда
		Возврат Новый ТаблицаЗначений;
	ИначеЕсли ВидОбъекта = 3 Тогда
		Возврат Новый СписокЗначений;
	ИначеЕсли ВидОбъекта = 4 Тогда
		Возврат Новый Структура;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // ПолучитьУказательНаОбъект()

