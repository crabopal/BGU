// Функция возвращает внешнее представление периода, заданного датами начала и окончания
//
Функция ПолучитьПредставлениеПериода(НачалоПериода, КонецПериода) Экспорт
	
	Если Не ЗначениеЗаполнено(НачалоПериода) И Не ЗначениеЗаполнено(КонецПериода) Тогда
		Возврат "<...>";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НачалоПериода) Тогда
		НачалоПериода = '00010101000000';
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КонецПериода) Тогда
		Возврат Формат(НачалоПериода, "ДЛФ=D") + " - ...";
	КонецЕсли;
	
	Возврат ПредставлениеПериода(НачалоДня(НачалоПериода), КонецДня(КонецПериода));
	
КонецФункции

Функция РезультатыГолосованияКомиссииПоДокументу(ДокументСсылка) Экспорт
	
	РезультатыГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(ДокументСсылка);
	
	Возврат РезультатыГолосованияКомиссии;
	
КонецФункции

// Резолюция комиссии одобрена.
// 
// Параметры:
//  ДокументСсылка - ДокументСсылка
//  ИдентификаторСтроки - Строка - Идентификатор строки
// 
// Возвращаемое значение:
//  Булево - Резолюция комиссии одобрена
Функция РезолюцияКомиссииОдобрена(ДокументСсылка, ИдентификаторСтроки) Экспорт
	
	РезультатыГолосования = БухгалтерскиеОперацииПовтИсп.РезультатыГолосованияКомиссииПоДокументу(ДокументСсылка);
	Если РезультатыГолосования.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НайденныеСтроки = РезультатыГолосования.НайтиСтроки(
		Новый Структура("Документ,ИдентификаторСтроки", ДокументСсылка, ИдентификаторСтроки));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0].РезолюцияКомиссииОдобрена;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

