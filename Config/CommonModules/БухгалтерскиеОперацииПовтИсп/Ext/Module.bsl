	               |			КОГДА ЕСТЬNULL(ОстаткиБалансВсего.КоличествоОстатокЦМО, 0) <> 0
	               |				ТОГДА ВЫРАЗИТЬ(ОстаткиБалансВсего.БалансоваяСтоимостьЦМО / ОстаткиБалансВсего.КоличествоОстатокЦМО КАК ЧИСЛО(19, 3))
	               |			ИНАЧЕ ВЫРАЗИТЬ(0 КАК ЧИСЛО(19, 3))
	               |		КОНЕЦ КАК СтоимостьЕдиницыНеокругленная,
	               |		ТаблицаОСпоМОЛ.ОсновноеСредство.Наименование КАК ОсновноеСредствоНаименование,
	               |		ТаблицаОСпоМОЛ.ОсновноеСредство.Код КАК ОсновноеСредствоКод,
	               |		ТаблицаОСпоМОЛ.ИнвНомер.Код КАК ИнвентарныйНомерКод,
	               |		ТаблицаОСИтог.Количество КАК КоличествоВДокументе,
	               |		ТаблицаУчетаОС.КПС КАК КПСТаблицы,
	               |		ОстаткиБалансВсего.КПС КАК КПСОстатков
	               |	ИЗ
	               |		ТаблицаУчетаОС КАК ТаблицаУчетаОС
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаОСпоМОЛ КАК ТаблицаОСпоМОЛ
	               |				ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиБалансВсего КАК ОстаткиБалансВсего
	               |				ПО ТаблицаОСпоМОЛ.ОсновноеСредство = ОстаткиБалансВсего.ОсновноеСредство
	               |				ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиАмортизация КАК ОстаткиАмортизация
	               |				ПО ТаблицаОСпоМОЛ.ОсновноеСредство = ОстаткиАмортизация.ОсновноеСредство
	               |			ПО ТаблицаУчетаОС.ОсновноеСредство = ТаблицаОСпоМОЛ.ОсновноеСредство
	               |				И ТаблицаУчетаОС.ИнвентарныйНомер = ТаблицаОСпоМОЛ.ИнвНомер
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаОСИтог КАК ТаблицаОСИтог
	               |			ПО ТаблицаУчетаОС.ОсновноеСредство = ТаблицаОСИтог.ОсновноеСредство) КАК Т";
				   
	СубконтоОС = Новый Массив;
	СубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	СубконтоОСЦМО = Новый Массив;
	СубконтоОСЦМО.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	СубконтоОСЦМО.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Если НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период",			ПериодОстатков);
	Запрос.УстановитьПараметр("Организация",	ПараметрыПолученияОстатков.Организация);
	Запрос.УстановитьПараметр("КПС", 			ПараметрыПолученияОстатков.КПС);
	Запрос.УстановитьПараметр("ПоВсемКПС", 		НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.КПС));
	Запрос.УстановитьПараметр("КФО", 			ПараметрыПолученияОстатков.КФО);
	Запрос.УстановитьПараметр("ЦМО",			ПараметрыПолученияОстатков.ЦМО);
	Запрос.УстановитьПараметр("СубконтоОС",		СубконтоОС);
	Запрос.УстановитьПараметр("СубконтоОСЦМО",	СубконтоОСЦМО);
	Если ПараметрыПолученияОстатков.ТаблицаОС.Количество() > 0 Тогда
		ТаблицаОС = ПараметрыПолученияОстатков.ТаблицаОС;
	Иначе
		ТаблицаОС = УправлениеОсновнымиСредствами.ПустаяСтруктураПараметровПолученияОстатков().ТаблицаОС;
		НоваяСтрока = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыПолученияОстатков, "ОсновноеСредство, ИнвентарныйНомер");
		НоваяСтрока.Количество = 1;
	КонецЕсли;
	Запрос.УстановитьПараметр("ТаблицаОС",		ТаблицаОС);
	Если ПараметрыПолученияОстатков.ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО",		ПараметрыПолученияОстатков.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	Если ПараметрыПолученияОстатков.ИспользоватьУчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделениеБаланс", "ВЫБОР
	               |			КОГДА ИСТИНА В
	               |					(ВЫБРАТЬ ПЕРВЫЕ 1
	               |						ИСТИНА
	               |					ИЗ
	               |						ТаблицаСчетов КАК ТаблицаСчетов
	               |					ГДЕ
	               |						ТаблицаСчетов.СчетУчета = ЖурналПроводокЕПСБУОстатки.Счет
	               |						И ТаблицаСчетов.УчетПоПодразделениямБаланс = ИСТИНА)
	               |				ТОГДА ВЫБОР
	               |						КОГДА ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) = &Подразделение
	               |							ТОГДА ИСТИНА
	               |						ИНАЧЕ ЛОЖЬ
	               |					КОНЕЦ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделениеАморт", "ВЫБОР
	               |			КОГДА ИСТИНА В
	               |					(ВЫБРАТЬ ПЕРВЫЕ 1
	               |						ИСТИНА
	               |					ИЗ
	               |						ТаблицаСчетов КАК ТаблицаСчетов
	               |					ГДЕ
	               |						ТаблицаСчетов.СчетАмортизации = ЖурналПроводокЕПСБУОстатки.Счет
	               |						И ТаблицаСчетов.УчетПоПодразделениямАморт = ИСТИНА
	               |						И ТаблицаСчетов.СчетАмортизации <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
	               |				ТОГДА ВЫБОР
	               |						КОГДА ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) = &Подразделение
	               |							ТОГДА ИСТИНА
	               |						ИНАЧЕ ЛОЖЬ
	               |					КОНЕЦ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ");				   
		Запрос.УстановитьПараметр("Подразделение", ПараметрыПолученияОстатков.Подразделение); 			   
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЖурналПроводокЕПСБУОстатки.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделениеБаланс", "ИСТИНА");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделениеАморт", "ИСТИНА");
	КонецЕсли;
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	ТребующиеПроверки = ТаблицаОстатков.Скопировать(Новый Структура("ТребуетсяПроверка", Истина), 
													"ОсновноеСредство, БалансоваяСтоимостьМОЛ, СуммаАмортизации, СтоимостьЕдиницы, Амортизация");
	ТребующиеПроверки.Свернуть("ОсновноеСредство, БалансоваяСтоимостьМОЛ, СуммаАмортизации", "СтоимостьЕдиницы, Амортизация");
	Для каждого ТекТребующийПроверки Из ТребующиеПроверки Цикл
	
		Погрешность = ТекТребующийПроверки.БалансоваяСтоимостьМОЛ - ТекТребующийПроверки.СтоимостьЕдиницы;
		Если Погрешность <> 0 Тогда
			СтрокиОС = ТаблицаОстатков.НайтиСтроки(Новый Структура("ОсновноеСредство", ТекТребующийПроверки.ОсновноеСредство));
			Если ТекТребующийПроверки.СуммаАмортизации <> ТекТребующийПроверки.Амортизация Тогда
				// требуется корректировка амортизации: корректировки ставим в первый объект с амортизацией
				Для каждого ТекСтрокаОС Из СтрокиОС Цикл
					Если ТекСтрокаОС.Амортизация <> 0 Тогда
						
						ТекСтрокаОС.СтоимостьЕдиницы	= ТекСтрокаОС.СтоимостьЕдиницы	+ Погрешность;	
						ТекСтрокаОС.Амортизация 		= ТекСтрокаОС.Амортизация 		+ Погрешность;
						Прервать;
						
					КонецЕсли;
				КонецЦикла; 				
			Иначе
				// не требуется корректировка амортизации: корректировки ставим в первый объект без амортизации
				Для каждого ТекСтрокаОС Из СтрокиОС Цикл
					Если ТекСтрокаОС.Амортизация = 0 Тогда
						
						ТекСтрокаОС.СтоимостьЕдиницы = ТекСтрокаОС.СтоимостьЕдиницы + Погрешность;	
						Прервать;
						
					КонецЕсли;
				КонецЦикла; 				
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла; 
	
	Возврат ТаблицаОстатков;

КонецФункции // ОстаткиОСНМАНПАбаланс()

// Устарела. Для формирования проводок по модернизации ОС, НМА следует использовать источники данных:
// - БухгалтерскиеОперацииИсточникиДанных.МодернизацияОсновныхСредств()
// - БухгалтерскиеОперацииИсточникиДанных.МодернизацияОсновныхСредствУСН()
//
Функция ТаблицаМодернизацииОС(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("Организация", ДокументСсылка.Организация);
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
		
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеконструкцияОСОсновныеСредства.Ссылка КАК Ссылка,
	|	РеконструкцияОСОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	РеконструкцияОСОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	РеконструкцияОСОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	РеконструкцияОСОсновныеСредства.ЦМО КАК ЦМО,
	|	РеконструкцияОСОсновныеСредства.ВосстановительнаяСтоимость КАК ВосстановительнаяСтоимость,
	|	РеконструкцияОСОсновныеСредства.ВосстановительнаяСтоимостьНУ КАК ВосстановительнаяСтоимостьНУ,
	|	РеконструкцияОСОсновныеСредства.ОстаточнаяСтоимость КАК ОстаточнаяСтоимость,
	|	РеконструкцияОСОсновныеСредства.ОстаточнаяСтоимостьНУ КАК ОстаточнаяСтоимостьНУ,
	|	РеконструкцияОСОсновныеСредства.СрокЭксплуатацииФакт КАК СрокЭксплуатацииФакт,
	|	РеконструкцияОСОсновныеСредства.СрокПолезногоИспользованияПослеМодернизации КАК СрокПолезногоИспользованияПослеМодернизации,
	|	РеконструкцияОСОсновныеСредства.СрокПолезногоИспользованияПослеМодернизацииНУ КАК СрокПолезногоИспользованияПослеМодернизацииНУ,
	|	РеконструкцияОСОсновныеСредства.СчетУчетаЗатратПоАмортизационнойПремии КАК СчетУчетаЗатратПоАмортизационнойПремии,
	|	РеконструкцияОСОсновныеСредства.СубконтоПоАмортизационнойПремии1 КАК СубконтоПоАмортизационнойПремии1,
	|	РеконструкцияОСОсновныеСредства.СубконтоПоАмортизационнойПремии2 КАК СубконтоПоАмортизационнойПремии2,
	|	РеконструкцияОСОсновныеСредства.СубконтоПоАмортизационнойПремии3 КАК СубконтоПоАмортизационнойПремии3,
	|	РеконструкцияОСОсновныеСредства.СуммаКапитальныхВложенийВключаемыхВРасходыНУ КАК СуммаКапитальныхВложенийВключаемыхВРасходыНУ,
	|	РеконструкцияОС.Дата КАК Дата,
	|	РеконструкцияОС.Организация КАК Организация,
	|	РеконструкцияОС.ВидОперации КАК ВидОперации,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	ПервоначальныеСведенияОСНалоговыйУчет.ПорядокВключенияСтоимостиВСоставРасходов КАК ПорядокВключенияСтоимостиВСоставРасходов,
	|	ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка) КАК СостояниеОС
	|ИЗ
	|	Документ.РеконструкцияОС.ОсновныеСредства КАК РеконструкцияОСОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеконструкцияОС КАК РеконструкцияОС
	|		ПО РеконструкцияОСОсновныеСредства.Ссылка = РеконструкцияОС.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(&МоментВремени, Организация = &Организация) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|		ПО РеконструкцияОСОсновныеСредства.ОсновноеСредство = ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПервоначальныеСведенияОСНалоговыйУчет.СрезПоследних(&МоментВремени, Организация = &Организация) КАК ПервоначальныеСведенияОСНалоговыйУчет
	|		ПО РеконструкцияОСОсновныеСредства.ОсновноеСредство = ПервоначальныеСведенияОСНалоговыйУчет.ОсновноеСредство
	|ГДЕ
	|	РеконструкцияОСОсновныеСредства.Ссылка = &Ссылка";
	
	ТаблицаМодернизацииОС = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаМодернизацииОС;
	
КонецФункции

// Устарела. Следует использовать функцию ПолучитьТаблицыАмортизацииТекущегоМесяца().
//
Функция ПолучитьСуммуАмортизацииТекущегоМесяца(Ссылка, КФО, КПС = Неопределено) Экспорт
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("ОсновноеСредство", 		Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаРезультат.Колонки.Добавить("СуммаАмортизации", 		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ТаблицаРезультат.Колонки.Добавить("СчетЗатрат", 			Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаРезультат.Колонки.Добавить("КЭКЗатрат", 				Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаРезультат.Колонки.Добавить("КПСЗатрат",				Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаРезультат.Колонки.Добавить("ПодразделениеЗатрат",	Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаРезультат.Колонки.Добавить("СубконтоЗатрат1");
	ТаблицаРезультат.Колонки.Добавить("СубконтоЗатрат2");
	ТаблицаРезультат.Колонки.Добавить("СубконтоЗатрат3");
	
	Возврат ТаблицаРезультат;
	
КонецФункции

// Устарела. Следует использовать функцию ПолучитьТаблицыАмортизацииТекущегоМесяца().
Функция ПолучитьТаблицыАмортизацииТекущегоМесяцаОС(Ссылка, Отказ) Экспорт
		
	ТаблицыАмортизации = УправлениеОсновнымиСредствами.ПолучитьТаблицыАмортизацииТекущегоМесяца(Ссылка);
	
	Возврат ТаблицыАмортизации;
	
КонецФункции

// Устарела. Следует использовать функцию ПолучитьТаблицыАмортизацииТекущегоМесяца().
//
Функция РассчитатьАмортизациюТекущегоМесяцаИК(ДокументСсылка) Экспорт
	
	ТаблицыАмортизации = УправлениеОсновнымиСредствами.ПолучитьТаблицыАмортизацииТекущегоМесяца(ДокументСсылка);	
	ТаблицаАмортизации = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ;
	
	Возврат ТаблицаАмортизации;		
	
КонецФункции

#КонецОбласти

#КонецОбласти
