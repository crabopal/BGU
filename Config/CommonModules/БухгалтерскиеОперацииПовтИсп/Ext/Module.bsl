Функция ПолучитьРеквизитыПроводокДокумента(ДокументСсылка, Счет, ДтКт="", КорСчет=Неопределено) Экспорт
	
	Результат = БухгалтерскийУчет.ПроводкиДокументов(ДокументСсылка, Счет, ДтКт, КорСчет, 1);
	
