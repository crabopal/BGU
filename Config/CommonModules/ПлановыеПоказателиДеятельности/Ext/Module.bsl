#Область ПрограммныйИнтерфейс

// Возвращает код статьи плана.
// 
// Параметры:
//  Объект - ДанныеФормыСтруктура, Структура - содержит значения компонентов статьи плана.
//  ВидСтатьи - ПеречислениеСсылка.ВидыКБК.
//
// Возвращаемое значение:
//  Строка - код статьи плана (20 или 17 знаков), определенный по кодам компонентов.
//  
// Устанавливаемые значения:
//  НовоеНаименование - Строка - наименование статьи плана, определенное по компонентам.
//  ДатаНачала - Дата - Дата начала действия статьи,определенная по дате действия компонентов.
//  ДатаОкончания  - Дата - Дата окончания действия статьи,определенная по дате действия компонентов.
//
Функция НовыйКодСтатьи(Объект, ДатаНачала = Неопределено, ДатаОкончания = Неопределено, НовоеНаименование = "", ВидСтатьи, УточнениеСтатьи = Неопределено) Экспорт
	
	Перем МассивСвойств, МассивДлин, МассивИмен, ЗначениеКОСГУ, ТекущийКод;
	
	ЧастиКода = Новый ТаблицаЗначений;
	ЧастиКода.Колонки.Добавить("Значение");
	ЧастиКода.Колонки.Добавить("Длина");
	
	Если Объект.Свойство("Код") Тогда
		ТекущийКод = "Код";
	ИначеЕсли Объект.Свойство("Наименование") Тогда
		ТекущийКод = "Наименование";
	Иначе
		ТекущийКод = "";
	КонецЕсли;	
	
	Если Объект.Свойство("ДатаНачалаДействия") Тогда
		ОбъектДатаНачала = Объект.ДатаНачалаДействия;
	ИначеЕсли Объект.Свойство("ДатаНачала") Тогда
		ОбъектДатаНачала = Объект.ДатаНачала;
	Иначе
		ОбъектДатаНачала = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	СоставРеквизитовКодаСтатьи(ВидСтатьи, МассивСвойств, МассивДлин, МассивИмен, ТекущийКод, ОбъектДатаНачала, УточнениеСтатьи);
	
	Если МассивСвойств.Количество() > 0 Тогда
		
		Для Инд = 0 По МассивСвойств.Количество() - 1 Цикл
			НоваяСтр = ЧастиКода.Добавить();
			НоваяСтр.Значение = ?(ЗначениеЗаполнено(МассивСвойств[Инд]), Объект[МассивСвойств[Инд]], "");
			НоваяСтр.Длина = МассивДлин[Инд];
		КонецЦикла;
		
		НоваяСтр = ЧастиКода.Добавить();

		Если Объект.Свойство("КОСГУ", ЗначениеКОСГУ) Тогда
			НоваяСтр.Значение = ЗначениеКОСГУ;
			НоваяСтр.Длина = 3;
		Иначе
			НоваяСтр.Значение = "";
			НоваяСтр.Длина = 0;
		КонецЕсли;	
	
	КонецЕсли;
	
	ОпределитьПериодДействияСтатьиПоКомпонентам(ЧастиКода, ДатаНачала, ДатаОкончания);
	
	НовоеНаименование = ВычислитьНовоеНаименование(ЧастиКода, МассивИмен, ВидСтатьи);
	
	Возврат ВычислитьНовыйКод(ЧастиКода);
	
КонецФункции

Функция ВычислитьНовыйКод(ЧастиКода) Экспорт
	
	НовыйКод = "00000000000000000000";
	
	Если ЧастиКода.Количество() > 0 Тогда
		
		НовыйКод = "";
		
		Для Каждого Стр Из ЧастиКода Цикл
			НовыйКод = НовыйКод + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Лев(Стр.Значение, Стр.Длина), Стр.Длина);
		КонецЦикла;	
		
	КонецЕсли;	
	
	Возврат НовыйКод
	
КонецФункции

Процедура СоставРеквизитовКодаСтатьи(ВидСтатьи, МассивСвойств, МассивДлин, МассивИмен, ТекущийКод, ДатаНачала, УточнениеСтатьи = Неопределено) Экспорт
	
	ИмяГлавыПоБК = "Глава";
	
	МассивСвойств 	= Новый Массив;
	МассивДлин 		= Новый Массив;
	МассивИмен 		= Новый Массив;
	
	Если ВидСтатьи = Перечисления.ВидыКБК.гКБК Тогда
		
		МассивСвойств.Добавить("");
		
		МассивДлин.Добавить(17);
		
		МассивИмен.Добавить(0);
			
	ИначеЕсли ВидСтатьи = Перечисления.ВидыКБК.КДБ Тогда
		
		МассивСвойств.Добавить("ВидДоходаКДБ");
		МассивСвойств.Добавить("ГруппаПодвидаКДБ");
		МассивСвойств.Добавить("АналитическаяГруппаКДБ");
		
		МассивДлин.Добавить(10);
		МассивДлин.Добавить(4);
		МассивДлин.Добавить(3);
		
		МассивИмен.Добавить(0);
		МассивИмен.Добавить(1);
		МассивИмен.Добавить(2);
		
	ИначеЕсли ВидСтатьи = Перечисления.ВидыКБК.КРБ Тогда
		
		МассивСвойств.Добавить("РазделПодразделКРБ");
		МассивСвойств.Добавить("ЦелеваяСтатьяКРБ");
		МассивСвойств.Добавить("ПрограммаЦелевойСтатьиКРБ");
		МассивСвойств.Добавить("ВидРасходаКРБ");
		
		МассивДлин.Добавить(4); 		// РЗПР
		МассивДлин.Добавить(5); 		// Программа, подпрограмма, основное мероприятие
		МассивДлин.Добавить(5); 		// Направление расходов
		МассивДлин.Добавить(3); 		// Вид расходов
		
		МассивИмен.Добавить(0);
        МассивИмен.Добавить(1);
		МассивИмен.Добавить(2);
		МассивИмен.Добавить(3);
        МассивИмен.Добавить(4);
		
	ИначеЕсли ВидСтатьи = Перечисления.ВидыКБК.КИФ Тогда
		
		МассивСвойств.Добавить("ГруппаПодгруппаКИФ");
		МассивСвойств.Добавить("СтатьяКИФ");
		МассивСвойств.Добавить("ВидКИФ"); 
		МассивСвойств.Добавить("АналитическаяГруппаКИФ");

		
		МассивДлин.Добавить(4);
		МассивДлин.Добавить(6);
		МассивДлин.Добавить(4);
		МассивДлин.Добавить(3);

		МассивИмен.Добавить(0);
        МассивИмен.Добавить(1);
		МассивИмен.Добавить(2);
		МассивИмен.Добавить(3);
		
	ИначеЕсли ВидСтатьи = Перечисления.ВидыКБК.АУИБУ Тогда
		
		МассивСвойств.Добавить("РазделПодразделКРБ");
		МассивСвойств.Добавить("АналитическийКодКПС");
		
		Если УточнениеСтатьи = Перечисления.ВидыКБК.КРБ Тогда
			МассивСвойств.Добавить("ВидРасходаКРБ");
		ИначеЕсли УточнениеСтатьи = Перечисления.ВидыКБК.КДБ Тогда
			МассивСвойств.Добавить("АналитическаяГруппаКДБ");
		Иначе
			МассивСвойств.Добавить("АналитическаяГруппаКИФ");
	    КонецЕсли;
		
		МассивДлин.Добавить(4);
		МассивДлин.Добавить(10);
		МассивДлин.Добавить(3);
		
		МассивИмен.Добавить(0);
        МассивИмен.Добавить(1);
		МассивИмен.Добавить(2);
		
	ИначеЕсли ВидСтатьи = Перечисления.ВидыКБК.Произвольный Тогда
		
		МассивСвойств.Добавить(ТекущийКод);  
		
		МассивДлин.Добавить(17);
		
	КонецЕсли;
	
КонецПроцедуры

