
#Область ПрограммныйИнтерфейс

// Изменился порядок учета детального КЭК 340 и 440. Это значит, что на дату до изменения использовался детальный КЭК,
// а на дату после изменения - групповой. Или наоборот.
// 
// Параметры:
//  ДатаДоИзменения - Дата
//  ОрганизацияДоИзменения - СправочникСсылка.Организации
//  ДатаПослеИзменения - Дата
//  ОрганизацияПослеИзменения - СправочникСсылка.Организации
// 
// Возвращаемое значение:
//  Булево - Изменился порядок учета КЭКСчета105
Функция ИзменилосьПрименениеДетальногоКЭК340и440(ДатаДоИзменения, ОрганизацияДоИзменения, ДатаПослеИзменения, ОрганизацияПослеИзменения) Экспорт
	ДетальныйКЭКДоИзменения = БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(
		ДатаДоИзменения, ОрганизацияДоИзменения);
	ДетальныйКЭКПослеИзменения = БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(
		ДатаПослеИзменения, ОрганизацияПослеИзменения);
	ИзменилсяПорядокУчетаКЭК = (ДетальныйКЭКДоИзменения <> ДетальныйКЭКПослеИзменения);
	Возврат ИзменилсяПорядокУчетаКЭК;
КонецФункции

// Установить динамическую колонку "ТипНоменклатуры" в строке таблицы формы.
// 
// Параметры:
//  Строка - ДанныеФормыЭлементКоллекции:
//   * ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры
//         - СтрокаТаблицыЗначений:
//   * ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры
//  ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры
Процедура УстановитьТипНоменклатурыВСтрокеДляБиологическихАктивов(Строка, ТипНоменклатуры) Экспорт
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Строка, "ТипНоменклатуры") Тогда
		Возврат;
	КонецЕсли;
	Если ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БиологическиеАктивы") Тогда
		Строка.ТипНоменклатуры = ТипНоменклатуры;
	Иначе
		Строка.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры

// Параметры открытия формы подбора.
// 
// Возвращаемое значение:
//  Структура -  Параметры открытия формы подбора:
// * ДатаРасчетов - Дата - 
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - 
// * Организация - СправочникСсылка.Организации - 
// * ДокументСсылка - Неопределено - 
// * РасширенныйПодборНоменклатуры - Булево - 
// * СотрудникОтбора - Неопределено - 
// * ДополнитьСчетом113 - Булево - 
Функция ПараметрыОткрытияФормыПодбора() Экспорт
	Результат = Новый Структура;
	
	Результат.Вставить("ДатаРасчетов", '00010101');
	Результат.Вставить("ИФО", ПредопределенноеЗначение("Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка"));
	Результат.Вставить("Организация", ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка"));
	Результат.Вставить("ДокументСсылка", Неопределено);
	Результат.Вставить("РасширенныйПодборНоменклатуры", Ложь);
	Результат.Вставить("СотрудникОтбора", Неопределено);
	Результат.Вставить("ДополнитьСчетом113", Ложь);
	
	Возврат Результат;
КонецФункции

Функция ДанныеСчетовУчетаМЗ(Организация, ТолькоБалансовые = Ложь, Включать106 = ЛОЖЬ, Включать113 = Ложь, Включать108 = Ложь) Экспорт

	#Если Клиент Тогда
	Возврат УправлениеМатериальнымиЗапасамиВызовСервераПовтИсп.ДанныеСчетовУчетаМЗ(Организация, ТолькоБалансовые, Включать106, Включать113, Включать108);
	#Иначе
	ПараметрыДанныхСчетов = УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ(Организация, ТолькоБалансовые);
	ПараметрыДанныхСчетов.Включать106 = Включать106;
	ПараметрыДанныхСчетов.Включать108 = Включать108;
	ПараметрыДанныхСчетов.Включать113 = Включать113; 
	Возврат УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов);
	#КонецЕсли

КонецФункции // ДанныеСчетовУчетаМЗ()

// Заполнить динамические колонки параметры.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - 
//  Объект - ДанныеФормыСтруктура - 
// 
// Возвращаемое значение:
//  Структура - Заполнить динамические колонки параметры:
// * Форма - ФормаКлиентскогоПриложения - 
// * Объект - ДанныеФормыСтруктура - 
// * ИмяТаблицы - Строка - 
// * Включать106 - Булево - 
// * Включать113 - Булево - 
// * Включать108 - Булево - 
// * ПараметрыЗаполнения - Структура, Неопределено - 
// * ДанныеСчетов - Структура, Неопределено - 
Функция ЗаполнитьДинамическиеКолонки_Параметры(Форма, Объект) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Форма", Форма);
	Результат.Вставить("Объект", Объект);
	Результат.Вставить("ИмяТаблицы", "Материалы");
	Результат.Вставить("Включать106", Ложь);
	Результат.Вставить("Включать113", Ложь);
	Результат.Вставить("Включать108", Ложь);
	Результат.Вставить("Включать0233", Ложь);
	Результат.Вставить("Включать0234", Ложь);
	Результат.Вставить("ПараметрыЗаполнения", Неопределено);
	Результат.Вставить("ДанныеСчетов", Неопределено);
	Возврат Результат;
КонецФункции

// Заполнить динамические колонки.
// 
// Параметры:
//  ПараметрыЗаполнения - см. ЗаполнитьДинамическиеКолонки_Параметры
Процедура ЗаполнитьДинамическиеКолонки(ПараметрыЗаполнения) Экспорт
	Если ПараметрыЗаполнения.ДанныеСчетов <> Неопределено Тогда
		ЗаполнитьДинамическиеКолонкиВФорме(ПараметрыЗаполнения.Объект,
			ПараметрыЗаполнения.ИмяТаблицы,
			ПараметрыЗаполнения.ПараметрыЗаполнения,
			ПараметрыЗаполнения.ДанныеСчетов);
	Иначе
		УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ПараметрыЗаполнения.Форма,
			ПараметрыЗаполнения.Объект,
			ПараметрыЗаполнения.ИмяТаблицы,
			ПараметрыЗаполнения.Включать106,
			ПараметрыЗаполнения.ПараметрыЗаполнения,
			ПараметрыЗаполнения.Включать113,
			ПараметрыЗаполнения.Включать108)
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьДанныеДинамическихКолонокТаблицыМатериалы(Форма, Объект, ИмяТаблицы = "Материалы", Включать106 = ЛОЖЬ, Параметры = Неопределено, Включать113 = Ложь, Включать108 = Ложь) Экспорт

	#Если Клиент Тогда
	ДанныеСчетов = ДанныеСчетовУчетаМЗ(Объект.Организация,,Включать106, Включать113, Включать108);
	#Иначе
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчетов = Объект.Дата;
	Иначе
		ДатаСчетов = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	ПараметрыДанныхСчетов = УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ(Объект.Организация, Ложь);
	ПараметрыДанныхСчетов.Включать106 = Включать106;
	ПараметрыДанныхСчетов.Включать108 = Включать108;
	ПараметрыДанныхСчетов.Включать113 = Включать113;
	ПараметрыДанныхСчетов.ДатаСчета = ДатаСчетов; 
	ДанныеСчетов = УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов);
	#КонецЕсли
	ЗаполнитьДинамическиеКолонкиВФорме(Объект, ИмяТаблицы, Параметры, ДанныеСчетов);

КонецПроцедуры

Процедура УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(Объект, ТекущаяСтрока, Включать106 = Ложь, Параметры = Неопределено, Включать113 = Ложь) Экспорт
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСчетов = ДанныеСчетовУчетаМЗ(Объект.Организация,, Включать106, Включать113);
	СоответствиеСчетов = Новый Соответствие;
	УстановитьДополнительноеСубконтоВСтроке(ТекущаяСтрока, ДанныеСчетов, СоответствиеСчетов, Параметры);

КонецПроцедуры

// Возвращает заполненную структуру для заполнения КЭК и СчетаУчета номенклатуры. Используется для передачи в процедуру
// УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеСчетаУчетаВСтроке. Если параметр ФормаОбъект = Неопределение,
// то заполнение параметров из объекта или формы не производится. Заполнение нужно делать в вызвающей форме.
// Если параметр Строка не заполнен, то не будут заполнены реквизиты из строки - "счет" и "номенклатура". Их заполнение
// так же возлагается на вызывающую процедуру.
//
// Параметры:
//  ФормаОбъект		 - УправляемаяФорма - форма документа, содержащая реквизит Объект.
//                   - ДанныеФормыСтруктура, ДокументОбъект - объект, содержащий данные документа.
//  Строка			 - ДокументТабличнаяЧастьСтрока, ДанныеФормыЭлементКоллекции - строка из которой заполняются реквизиты номенклатуры.
//  ИмяРеквизитаСчет - Строка - имя реквизита, содержащего счет учета номенклатуры в строке.
//  ИмяРеквизитаКЭК	 - Строка - имя реквизита, содержащего КЭК номенклатуры в строке.
// 
// Возвращаемое значение:
// Структура - структура параметров
//
Функция ПараметрыУстановкиСчетаУчетаВСтроке(ФормаОбъект, Строка = Неопределено, ИмяРеквизитаСчет = "СчетУчета", ИмяРеквизитаКЭК = "КЭК") Экспорт
	
	ПараметрыОбработки = ПараметрыУстановкиСчетаУчетаВСтрокеПоУмолчанию(ИмяРеквизитаСчет, ИмяРеквизитаКЭК);
	
	Если ФормаОбъект = Неопределено Тогда
		Возврат ПараметрыОбработки;
	ИначеЕсли ТипЗнч(ФормаОбъект) = Тип("ФормаКлиентскогоПриложения") Тогда
		Форма = ФормаОбъект;
		Объект = ФормаОбъект.Объект;
	Иначе
		Форма  = Неопределено;
		Объект = ФормаОбъект;
	КонецЕсли;
	
	ЗаполнитьИзОбъектаПараметрыУстановкиСчетаУчетаВСтроке(ПараметрыОбработки, Объект);
	
	Если Строка <> Неопределено Тогда
		ЗаполнитьИзСтрокиПараметрыУстановкиСчетаУчетаВСтроке(ПараметрыОбработки, Строка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбработки.СчетДокумента) Тогда
	
		Если Форма <> Неопределено
			И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "КэшПараметров")
			И Форма.КэшПараметров.Локальные.Свойство("Счет105") Тогда
			
			СчетДляСравнения = Форма.КэшПараметров.Локальные.Счет105;
		Иначе
			
			СчетДляСравнения = БухгалтерскийУчетВызовСервера.СчетПоКоду("105.00", Объект.Дата, Объект.Организация);
		КонецЕсли;
		
		УстановитьСчетДокументаПараметровУстановкиСчетаУчетаВСтроке(ПараметрыОбработки, СчетДляСравнения);
		
	КонецЕсли;
	
	Возврат ПараметрыОбработки;

КонецФункции

Функция ПараметрыУстановкиСчетаУчетаВСтрокеПоУмолчанию(ИмяРеквизитаСчет, ИмяРеквизитаКЭК)
	
	ПараметрыОбработки = Новый Структура;
	
	ПараметрыОбработки.Вставить("Организация");
	ПараметрыОбработки.Вставить("ИФО");
	ПараметрыОбработки.Вставить("Дата");
	ПараметрыОбработки.Вставить("Номенклатура");
	// Значения по умолчанию
	ПараметрыОбработки.Вставить("ТолькоБалансовые",                              Истина);
	ПараметрыОбработки.Вставить("ТолькоБалансовыеИК",                            Истина);
	ПараметрыОбработки.Вставить("Включать105",                                   Истина);
	ПараметрыОбработки.Вставить("Включать106",                                   Ложь);
	ПараметрыОбработки.Вставить("Включать106ИК",                                 Ложь);
	ПараметрыОбработки.Вставить("Включать108",                                   Ложь);
	ПараметрыОбработки.Вставить("Включать113",                                   Ложь);
	ПараметрыОбработки.Вставить("Включать0233",                                   Ложь);
	ПараметрыОбработки.Вставить("Включать0234",                                  Ложь);
	ПараметрыОбработки.Вставить("ЗаполнятьСчет",                                 Истина);
	ПараметрыОбработки.Вставить("ИмяРеквизитаСчет",                              ИмяРеквизитаСчет);
	ПараметрыОбработки.Вставить("ИмяРеквизитаКЭК",                               ИмяРеквизитаКЭК);
	ПараметрыОбработки.Вставить("ИмяРеквизитаУчетПоКПС",                         "УчетПоКПС");
	ПараметрыОбработки.Вставить("ИмяРеквизитаЕстьДополнительноеСубконто",        "ЕстьДополнительноеСубконто");
	ПараметрыОбработки.Вставить("ИмяРеквизитаДополнительнаяАналиткаВидСубконто", "ДополнительнаяАналиткаВидСубконто");
	ПараметрыОбработки.Вставить("ИмяРеквизитаЕстьДополнительноеСубконто3",       "ЕстьДополнительноеСубконто3");
	ПараметрыОбработки.Вставить("ИмяРеквизитаДополнительноеСубконтоВидСубконто", "ДополнительноеСубконтоВидСубконто");
	
	ПараметрыОбработки.Вставить("КФО");
	ПараметрыОбработки.Вставить("ДтКт");
	ПараметрыОбработки.Вставить("Счет");
	ПараметрыОбработки.Вставить("СчетДокумента");
	ПараметрыОбработки.Вставить("ВШапке105");
	ПараметрыОбработки.Вставить("ВШапке106", Ложь);
	ПараметрыОбработки.Вставить("ВШапке108", Ложь);
	
	Возврат ПараметрыОбработки;
	
КонецФункции

Процедура ЗаполнитьИзОбъектаПараметрыУстановкиСчетаУчетаВСтроке(ПараметрыОбработки, Объект)

	ПараметрыОбработки.Организация = Объект.Организация;
	ПараметрыОбработки.ИФО         = Объект.ИФО;
	ПараметрыОбработки.Дата        = Объект.Дата;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "КФО") Тогда
		ПараметрыОбработки.КФО = Объект.КФО;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "СчетУчета") Тогда
		ПараметрыОбработки.СчетДокумента = Объект.СчетУчета;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьИзСтрокиПараметрыУстановкиСчетаУчетаВСтроке(ПараметрыОбработки, Строка)

	ПараметрыОбработки.Номенклатура = Строка.Номенклатура;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Строка, ПараметрыОбработки.ИмяРеквизитаСчет) Тогда
		ПараметрыОбработки.Счет = Строка[ПараметрыОбработки.ИмяРеквизитаСчет];
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьСчетДокументаПараметровУстановкиСчетаУчетаВСтроке(ПараметрыОбработки, СчетДляСравнения)
	
	ПараметрыОбработки.ВШапке105        = ПараметрыОбработки.СчетДокумента = СчетДляСравнения;
	ПараметрыОбработки.ТолькоБалансовые = ПараметрыОбработки.ВШапке105;

КонецПроцедуры

// Заполняет счет учета и КЭК номеклатуры в строке документа. При определении счета учитывается выбранный в шапке документа счет,
// заполнение КЭК производится по дате документа и типу номенклатуры. При необходимости счет учета может не заполняться, КЭК заполняется всегда.
// Если КЭК не должен заполняться, то следует использовать функцию УправлениеМатериальнымиЗапасамиВызовСервера.СчетУчетаНоменклатуры.
//
// Параметры:
//  ТекущаяСтрока	 - СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекции - строка, в которую устанавливаются значения.
//  Параметры		 - см. УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыУстановкиСчетаУчетаВСтроке
//
Процедура УстановитьДанныеСчетаУчетаВСтроке(ТекущаяСтрока, Параметры) Экспорт

	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВШапке106 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ВШапке106", Ложь);
	ВШапке108 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ВШапке108", Ложь);
	Включать106ИК = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Включать106ИК", Ложь);
	
	ТребуетсяПрочитатьСчетУчета = Параметры.ЗаполнятьСчет
		И (Параметры.ВШапке105 = Истина ИЛИ Параметры.ВШапке105 = Неопределено
		ИЛИ ВШапке106
		Или ВШапке108);
		
	Если ТребуетсяПрочитатьСчетУчета Тогда
		
		// Получение даты из параметров безопасным способом на случай, если в параметрах нет даты
		ДатаСчета = Новый Структура("Дата");
		ЗаполнитьЗначенияСвойств(ДатаСчета, Параметры);
		Если ВШапке108 Тогда
			СчетУчета = УправлениеМатериальнымиЗапасамиВызовСервера.СчетУчетаНоменклатурыИК(Параметры.Номенклатура, ДатаСчета.Дата);
		Иначе
			СчетУчета = УправлениеМатериальнымиЗапасамиВызовСервера.СчетУчетаНоменклатуры(Параметры.Номенклатура, ВШапке106, Включать106ИК, ДатаСчета.Дата);
		КонецЕсли;
		Если Параметры.ЗаполнятьСчет Тогда
			ТекущаяСтрока[Параметры.ИмяРеквизитаСчет] = СчетУчета;
		КонецЕсли;
		
		Параметры.Счет = СчетУчета;
		
	Иначе
		
		Если Параметры.ЗаполнятьСчет Тогда
			ТекущаяСтрока[Параметры.ИмяРеквизитаСчет] = Параметры.СчетДокумента;
		КонецЕсли;
		
		СчетУчета = ТекущаяСтрока[Параметры.ИмяРеквизитаСчет];
		
	КонецЕсли;
	
	ДанныеСчетаДляСтроки = УправлениеМатериальнымиЗапасамиВызовСервера.ПолучитьДанныеСчетаУчетаНоменклатуры(Параметры);
	
	Если ЗначениеЗаполнено(Параметры.ИмяРеквизитаКЭК)
			И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущаяСтрока, Параметры.ИмяРеквизитаКЭК) Тогда
		ТекущаяСтрока[Параметры.ИмяРеквизитаКЭК] = ДанныеСчетаДляСтроки.КЭК;
	КонецЕсли;
	
	ДанныеСчетов = ДанныеСчетаДляСтроки.ДанныеСчетов;
	СоответствиеСчетов = Новый Соответствие;
	УстановитьДополнительноеСубконтоВСтроке(ТекущаяСтрока, ДанныеСчетов, СоответствиеСчетов, Параметры);
	
КонецПроцедуры

Функция ДополнительнаяАналитикаСчетаУчетаМатериалов(СчетУчета, Организация) Экспорт

	Если СчетУчета = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("106.00") Тогда
		Возврат ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Партии");
	КонецЕсли;
	
	ДанныеСчетов = ДанныеСчетовУчетаМЗ(Организация);
	
	Если СчетУчета = БухгалтерскийУчетВызовСервераПовтИсп.СчетПоКоду("105.00") Тогда
		// Для счета группы проверяем, что дополнительное субконто одинаково во всех субсчетах.
		// В противном случае не учитывает дополнительное субконто вообще.
		
		ДополнительныеСубконто = Новый Соответствие;
		ЕстьПустоеСубконто = Ложь;
		
		Для каждого ТекСчет Из ДанныеСчетов Цикл
			
			Если ТекСчет.Счет = СчетУчета Тогда
				Если Не ЗначениеЗаполнено(ТекСчет.ДополнительноеСубконто) Тогда
					ЕстьПустоеСубконто = Истина;
					Если ДополнительныеСубконто.Количество() > 0 Тогда
						// уже были заполненные субконто и теперь есть пустое - не используем дополнительное субконто
						Возврат ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка");
					КонецЕсли;
				Иначе
					Если ЕстьПустоеСубконто Тогда
						// уже были пустые субконто и теперь есть заполненное - не используем дополнительное субконто
						Возврат ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка");
					КонецЕсли;
					Если ДополнительныеСубконто.Получить(ТекСчет.ДополнительноеСубконто) = Неопределено Тогда
						ДополнительныеСубконто.Вставить(ТекСчет.ДополнительноеСубконто, ТекСчет.ДополнительноеСубконто);
						Если ДополнительныеСубконто.Количество() = 2 Тогда
							// Используются разные дополнительные субконто или они заполнены не во всех субсчетах
							Возврат ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка");
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого ТекДопСубконто Из ДополнительныеСубконто Цикл
		
			Возврат ТекДопСубконто.Ключ;
		
		КонецЦикла;
		
	Иначе
		// для счета не группы возвращаем фактическое значение
		
		Для каждого ТекСчет Из ДанныеСчетов Цикл
		
			Если ТекСчет.ТекущийСчет = СчетУчета Тогда
				Возврат ТекСчет.ДополнительноеСубконто;
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка");

КонецФункции

