Функция ВедетсяПартионныйУчет(Организация, Период, КФО, Счет) Экспорт

	Если БухгалтерскийУчетВызовСервераПовтИсп.НаСчетеВедетсяПартионныйУчет(Счет) Тогда
		
		УчетнаяПолитика = БухгалтерскийУчетВызовСервера.УчетнаяПолитикаОрганизации(Организация, Период);
		
		Если УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы
		  И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(КФО) Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если БухгалтерскийУчетВызовСервераПовтИсп.ВидСубконтоОбязательный(Счет, "Партии") Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Процедура УстановитьВидимостьЭлементовЗагруженногоДокумента(Форма, ИмяТабличнойЧасти = "Материалы") Экспорт

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить(ИмяТабличнойЧасти + "СуммаСписания");
	ИменаЭлементов.Добавить(ИмяТабличнойЧасти + "СуммаСписанияНУ");
	ИменаЭлементов.Добавить("ДекорацияПредупреждениеДокументЗагружен");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Видимость", Форма.Объект.НеПересчитыватьСумму);

КонецПроцедуры

// Признак, что для типа номенклатуры возможно указать счет учета
// 
// Параметры:
// 	ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры -
// Возвращаемое значение:
// 	Булево - 
Функция ТипНоменклатурыСоСчетомУчета(ТипНоменклатуры) Экспорт

	// Счет учета не используется для услуг, работ и групп номенклатуры
	Возврат ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БиологическиеАктивы")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Блюдо")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БСО")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Тара");
		
КонецФункции

// Признак, что для типа номенклатуры возможно указать страну происхождения
// 
// Параметры:
// 	ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры -
// Возвращаемое значение:
