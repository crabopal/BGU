		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы")
		Или ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ");
	
КонецФункции

// Возвращает соответствие, с ключами "КодСчета" и "СтатьяКОСГУ".
// Ключ соответствия - Перечисление ТипыНоменклатуры
// 
// Возвращаемое значение:
// 	Соответствие - Содержит структуры с ключами:
//   *КодСчета - Строка - код счета учета для этого типа номенклатуры
//   *СтатьяКОСГУ - Строка - последняя цифра детального КОСГУ
Функция КодыСчетаИСтатьиКОСГУПоТипуНоменклатуры() Экспорт
	
	Коды = Новый Соответствие;
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "Медикаменты",                "105.31", "1");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "ПродуктыПитания",            "105.32", "2");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "ГСМ",                        "105.33", "3");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "Стройматериалы",             "105.34", "4");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "МягкийИнвентарь",            "105.35", "5");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "МолоднякИЖивотныеНаОткорме", "105.36", "6");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "Оборудование",               "",       "6");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "Посуда",                     "105.36", "6");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "Продукция",                  "105.37", "6");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "ПрочиеМЗ",                   "105.36", "6");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "Тара",                       "105.36", "6");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "Блюдо",                      "105.32", "6");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "НоменклатурнаяГруппа",       "",       "6");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "БСО",                        "105.36", "9");
	ДобавитьКодСчетаИСтатьюКОСГУ(Коды, "БиологическиеАктивы",        "113.00", "0");
	Возврат Коды;
	
КонецФункции

// Возвращает код счета ЕПСБУ или пустую строку
// 
// Параметры:
// 	ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры - 
// Возвращаемое значение:
// 	Строка - Код счета ЕПСБУ
Функция КодСчетаПоТипуНоменклатуры(ТипНоменклатуры) Экспорт
	ДанныеТипаНоменклатуры = КодыСчетаИСтатьиКОСГУПоТипуНоменклатуры().Получить(ТипНоменклатуры);
	Если ДанныеТипаНоменклатуры = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ДанныеТипаНоменклатуры.КодСчета;
	
КонецФункции

// Возвращает последнюю цифру детального КОСГУ или "0"
// 
// Параметры:
// 	ТипНоменклатуры - ПеречислениеСсылка.ТипыНоменклатуры - 
// Возвращаемое значение:
// 	Строка - последняя цифра детального КЭК
Функция КодСтатьиКОСГУПоТипуНоменклатуры(ТипНоменклатуры) Экспорт

	ДанныеТипаНоменклатуры = КодыСчетаИСтатьиКОСГУПоТипуНоменклатуры().Получить(ТипНоменклатуры);
	Если ДанныеТипаНоменклатуры = Неопределено Тогда
		Возврат "0";
	КонецЕсли;
	Возврат ДанныеТипаНоменклатуры.СтатьяКОСГУ;
	
КонецФункции

// Дополняет номер БСО лидирующими нулями.
// 
// Параметры:
//  Номер - Строка, Число -
//  ДлинаНомера - Число - Длина номера
// 
// Возвращаемое значение:
//  Строка - Номер БСО строкой
Функция НомерБСОСтрокой(Знач Номер, Знач ДлинаНомера = 0) Экспорт
	ТипЧисло = Новый ОписаниеТипов("Число");
	Если Не ЗначениеЗаполнено(ДлинаНомера) Тогда
		ДлинаНомера = ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО();
	КонецЕсли;
	Номер = ТипЧисло.ПривестиЗначение(Номер);
	НомерСтрокой = Формат(Число(Номер), "ЧГ=0;");
	КоличествоСимволов = ДлинаНомера - СтрДлина(НомерСтрокой);
	Для к = 1 по КоличествоСимволов Цикл 
		НомерСтрокой = "0" + НомерСтрокой;
	КонецЦикла;
	Возврат НомерСтрокой;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьДинамическиеКолонкиВФорме(Объект, ИмяТаблицы, Параметры, ДанныеСчетов)
	СоответствиеСчетов = Новый Соответствие;
	Для каждого Счет Из ДанныеСчетов Цикл
		СоответствиеСчетов.Вставить(Счет.ТекущийСчет, Счет);
	КонецЦикла;
	
	Для каждого СтрокаТаблицы Из Объект[ИмяТаблицы] Цикл
		УстановитьДополнительноеСубконтоВСтроке(СтрокаТаблицы, ДанныеСчетов, СоответствиеСчетов, Параметры);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьКодСчетаИСтатьюКОСГУ(Коды, ИмяЗначения, КодСчета, СтатьяКОСГУ)
	Коды.Вставить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры." + ИмяЗначения),
		Новый Структура("КодСчета, СтатьяКОСГУ", КодСчета, СтатьяКОСГУ));
КонецПроцедуры

Процедура УстановитьДополнительноеСубконтоВСтроке(ТекущиеДанные, ДанныеСчетов, СоответствиеСчетов, Параметры = Неопределено)
	
	ИспользуемыеПараметры = ЗаполнитьДинамическиеКолонки_ПрочитатьПараметры(Параметры);
	
	ИмяКолонкиСчетУчета = ИспользуемыеПараметры.ИмяКолонкиСчетУчета;
	ТекущийСчет = СоответствиеСчетов.Получить(ТекущиеДанные[ИмяКолонкиСчетУчета]);
	Если ТекущийСчет = Неопределено И ЗначениеЗаполнено(ТекущиеДанные[ИмяКолонкиСчетУчета]) Тогда
		Для каждого Счет Из ДанныеСчетов Цикл
			Если Счет.ТекущийСчет = ТекущиеДанные[ИмяКолонкиСчетУчета] Тогда
				ТекущийСчет = Счет;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ТекущийСчет <> Неопределено Тогда
			СоответствиеСчетов.Вставить(ТекущиеДанные[ИмяКолонкиСчетУчета], ТекущийСчет);
		КонецЕсли;
	КонецЕсли;
	
	ИмяКолонкиУчетПоКПС = ИспользуемыеПараметры.ИмяКолонкиУчетПоКПС;
	ИмяКолонкиУчетПоКЭК = ИспользуемыеПараметры.ИмяКолонкиУчетПоКЭК;
	ИмяКолонкиЕстьДополнительноеСубконто = ИспользуемыеПараметры.ИмяКолонкиЕстьДополнительноеСубконто;
	ИмяКолонкиЕстьДополнительноеСубконто3 = ИспользуемыеПараметры.ИмяКолонкиЕстьДополнительноеСубконто3;

	ЕстьКолонкаУчетПоКПС    = Ложь;
	ЕстьКолонкаУчетПоКЭК    = Ложь;
	ЕстьКолонкиДопСубконто  = Ложь;
	ЕстьКолонкиДопСубконто3 = Ложь;
	Если ТекущиеДанные <> Неопределено Тогда
		ЕстьКолонкаУчетПоКПС    = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные,
			ИмяКолонкиУчетПоКПС);
		ЕстьКолонкаУчетПоКЭК    = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные,
			ИмяКолонкиУчетПоКЭК);
		ЕстьКолонкиДопСубконто  = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные,
			ИмяКолонкиЕстьДополнительноеСубконто);
		ЕстьКолонкиДопСубконто3 = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные,
			ИмяКолонкиЕстьДополнительноеСубконто3);
	КонецЕсли;
	
	Если ЕстьКолонкаУчетПоКПС Тогда
		Если ИспользуемыеПараметры.ВШапке108 Тогда
			ТекущиеДанные[ИмяКолонкиУчетПоКПС] = Истина;
		Иначе
			ТекущиеДанные[ИмяКолонкиУчетПоКПС] = ?(ТекущийСчет = Неопределено, Ложь, ТекущийСчет.УчетПоКПС);
		КонецЕсли;
	КонецЕсли;
	Если ЕстьКолонкаУчетПоКЭК Тогда
		Если ИспользуемыеПараметры.ВШапке108 Тогда
			ТекущиеДанные[ИмяКолонкиУчетПоКЭК] = Истина;
		Иначе
			ТекущиеДанные[ИмяКолонкиУчетПоКЭК] = ?(ТекущийСчет = Неопределено, Ложь, ТекущийСчет.УчетПоКЭК);
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьКолонкиДопСубконто Тогда
		Если ТекущийСчет = Неопределено Тогда
			ТекущиеДанные[ИмяКолонкиЕстьДополнительноеСубконто] = Ложь;
			ТекущиеДанные[ИспользуемыеПараметры.ИмяКолонкиДополнительнаяАналиткаВидСубконто] = Неопределено;
		Иначе
			ТекущиеДанные[ИмяКолонкиЕстьДополнительноеСубконто] = ЗначениеЗаполнено(ТекущийСчет.ДополнительноеСубконто);
			ТекущиеДанные[ИспользуемыеПараметры.ИмяКолонкиДополнительнаяАналиткаВидСубконто]
				= ТекущийСчет.ДополнительноеСубконто;
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьКолонкиДопСубконто3 Тогда
		Если ТекущийСчет = Неопределено Тогда
			ТекущиеДанные[ИмяКолонкиЕстьДополнительноеСубконто3] = Ложь;
			ТекущиеДанные[ИспользуемыеПараметры.ИмяКолонкиДополнительноеСубконтоВидСубконто] = Неопределено;
		Иначе
			ТекущиеДанные[ИмяКолонкиЕстьДополнительноеСубконто3] =
				ЗначениеЗаполнено(ТекущийСчет.ДополнительноеСубконто3)
				И ЗначениеЗаполнено(ТекущийСчет.НомерСубконтоКонтрагенты)
				И Не ЗначениеЗаполнено(ТекущийСчет.НомерСубконтоЦМО);
			Если ТекущиеДанные[ИмяКолонкиЕстьДополнительноеСубконто3] Тогда
				ТекущиеДанные[ИспользуемыеПараметры.ИмяКолонкиДополнительноеСубконтоВидСубконто]
					= ТекущийСчет.ДополнительноеСубконто3;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ЗаполнитьДинамическиеКолонки_ПрочитатьПараметры(Параметры)
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ИмяКолонкиСчетУчета", "СчетУчета");
	ПараметрыЗаполнения.Вставить("ВШапке108", Ложь);
	ПараметрыЗаполнения.Вставить("ИмяКолонкиУчетПоКПС", "УчетПоКПС");
	ПараметрыЗаполнения.Вставить("ИмяКолонкиУчетПоКЭК", "УчетПоКЭК");
	ПараметрыЗаполнения.Вставить("ИмяКолонкиЕстьДополнительноеСубконто", "ЕстьДополнительноеСубконто");
	ПараметрыЗаполнения.Вставить("ИмяКолонкиДополнительнаяАналиткаВидСубконто", "ДополнительнаяАналиткаВидСубконто");
	ПараметрыЗаполнения.Вставить("ИмяКолонкиЕстьДополнительноеСубконто3", "ЕстьДополнительноеСубконто3");
	ПараметрыЗаполнения.Вставить("ИмяКолонкиДополнительноеСубконтоВидСубконто", "ДополнительноеСубконтоВидСубконто");
	
	Если Параметры <> Неопределено Тогда
		Если Параметры.Свойство("СчетУчета") Тогда
			ПараметрыЗаполнения.ИмяКолонкиСчетУчета = Параметры.СчетУчета;
		ИначеЕсли Параметры.Свойство("ИмяРеквизитаСчет") Тогда
			ПараметрыЗаполнения.ИмяКолонкиСчетУчета = Параметры.ИмяРеквизитаСчет;
		КонецЕсли;
		Если Параметры.Свойство("ВШапке108") Тогда
			ПараметрыЗаполнения.ВШапке108 = Параметры.ВШапке108;
		КонецЕсли;
		Если Параметры.Свойство("УчетПоКПС") Тогда
			ПараметрыЗаполнения.ИмяКолонкиУчетПоКПС = Параметры.УчетПоКПС;
		ИначеЕсли Параметры.Свойство("ИмяРеквизитаУчетПоКПС") Тогда
			ПараметрыЗаполнения.ИмяКолонкиУчетПоКПС = Параметры.ИмяРеквизитаУчетПоКПС;
		КонецЕсли;
		Если Параметры.Свойство("ИмяКолонкиУчетПоКЭК") Тогда
			ПараметрыЗаполнения.ИмяКолонкиУчетПоКЭК = Параметры.ИмяКолонкиУчетПоКЭК;
		КонецЕсли;
		Если Параметры.Свойство("ЕстьДополнительноеСубконто") Тогда
			ПараметрыЗаполнения.ИмяКолонкиЕстьДополнительноеСубконто = Параметры.ЕстьДополнительноеСубконто;
		ИначеЕсли Параметры.Свойство("ИмяРеквизитаЕстьДополнительноеСубконто") Тогда
			ПараметрыЗаполнения.ИмяКолонкиЕстьДополнительноеСубконто
				= Параметры.ИмяРеквизитаЕстьДополнительноеСубконто;
		КонецЕсли;
		Если Параметры.Свойство("ДополнительнаяАналиткаВидСубконто") Тогда
			ПараметрыЗаполнения.ИмяКолонкиДополнительнаяАналиткаВидСубконто
				= Параметры.ДополнительнаяАналиткаВидСубконто;
		ИначеЕсли Параметры.Свойство("ИмяРеквизитаДополнительнаяАналиткаВидСубконто") Тогда
			ПараметрыЗаполнения.ИмяКолонкиДополнительнаяАналиткаВидСубконто
				= Параметры.ИмяРеквизитаДополнительнаяАналиткаВидСубконто;
		КонецЕсли;
		Если Параметры.Свойство("ИмяРеквизитаЕстьДополнительноеСубконто3") Тогда
			ПараметрыЗаполнения.ИмяКолонкиЕстьДополнительноеСубконто3
				= Параметры.ИмяРеквизитаЕстьДополнительноеСубконто3;
		КонецЕсли;
		Если Параметры.Свойство("ИмяРеквизитаДополнительноеСубконтоВидСубконто") Тогда
			ПараметрыЗаполнения.ИмяКолонкиДополнительноеСубконтоВидСубконто
				= Параметры.ИмяРеквизитаДополнительноеСубконтоВидСубконто;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПараметрыЗаполнения;
КонецФункции

// Очищает вид доп. субконто на форме и заголовок колонки "ДополнителноеСубконтоСчета" (3 пользовательское субконто счета)
//
// Параметры:
//  Форма - Управляемая форма
//  ИмяЭлементаСубконто - Строка
Процедура ОчиститьВидДопСубконтоЛичногоПользования(Форма, ИмяЭлементаСубконто) Экспорт
	
	Если ЗначениеЗаполнено(Форма.ДополнительноеСубконто27ВидСубконто) Тогда
		Форма.ДополнительноеСубконто27ВидСубконто = Неопределено;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы,
		ИмяЭлементаСубконто,
		"Заголовок",
		"Доп.субконто");
	КонецЕсли;
	
КонецПроцедуры

// Заполняет признак наличия 3 пользовательского доп субконто в форме
// Параметры:
//  Форма - Управляемая форма
Процедура УстановитьПризнакФормыДополнительноеСубконто3(Форма) Экспорт
	
	Форма.ЕстьДополнительноеСубконто3 = Ложь;
	Если ЗначениеЗаполнено(Форма.Объект.СчетУчета) Тогда
		Для Каждого Счет Из Форма.СчетаДопСубконто3 Цикл
			Если Форма.Объект.СчетУчета = Счет.Значение Тогда
				Форма.ЕстьДополнительноеСубконто3 = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти