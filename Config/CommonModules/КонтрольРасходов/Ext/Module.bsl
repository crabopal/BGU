
#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

Процедура Контроль(Источник, Отказ, РежимЗаписи = Неопределено, ИзДокумента = Ложь, Адрес = Неопределено, Информировать = Истина) Экспорт
	
	КонтрольВозможен = ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаявкаНаКассовыйРасход") 
	Или ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаявкаНаКассовыйРасходСокращенная") 
	Или ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаявкаНаНаличные") 
	Или ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаявкаНаНаличныеБанковскаяКарта") 
	Или ТипЗнч(Источник) = Тип("ДокументОбъект.КассовоеВыбытие") 
	Или ТипЗнч(Источник) = Тип("ДокументОбъект.ПлатежноеПоручение") 
	Или ТипЗнч(Источник) = Тип("ДокументОбъект.СводнаяЗаявкаНаКассовыйРасход")
	Или ТипЗнч(Источник) = Тип("ДокументОбъект.РаспоряжениеОПеречисленииНаКартыМир");
	
	Если Не КонтрольВозможен Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ИзДокумента И РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаКонтроля = Справочники.НастройкиКонтроляОбязательств.НайтиПоРеквизиту("Организация", Источник.Организация);
	
	Если Не ЗначениеЗаполнено(НастройкаКонтроля) Тогда
		Возврат;
	КонецЕсли;
	
	СхемаПроверки = НастройкаКонтроля.СхемаКонтроля.Получить();
	
	СКД = СхемаПроверки[0];
	
	Если СКД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТабДокумент = Новый ТаблицаЗначений;
	КолонкиСвертки = "";
	
	Для Каждого Параметр Из СКД.Параметры Цикл
		
		Если Параметр.Имя = "НачалоПериода" Или Параметр.Имя = "КонецПериода" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Лев(Параметр.Имя, 6) = "Счета_" Тогда
			Продолжить;
		КонецЕсли;
		
		ТабДокумент.Колонки.Добавить(Параметр.Имя, Новый ОписаниеТипов(Параметр.ТипЗначения, "Null"));
		
		КолонкиСвертки = КолонкиСвертки + ?(СтрДлина(КолонкиСвертки) > 0, ",", "") + Параметр.Имя;
	КонецЦикла;
	
	ТабДокумент.Колонки.Добавить("СуммаДокумента", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18,2));
	
	МДИсточника = Источник.Метаданные();
	
	ДобавленыДанныеАвтоПроведения = Ложь;
	
	Если Не Источник.ДополнительныеСвойства.Свойство("ДанныеАвтоПроведения") Тогда
		БухОперация = БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(Источник.Ссылка);
		ДопРеквизиты = БухгалтерскиеОперацииСервер.ЗаполнитьДополнительныеРеквизиты(Источник.Ссылка, БухОперация);
		
		ДанныеАвтоПроведения = Новый Структура;
		ДанныеАвтоПроведения.Вставить("ДополнительныеРеквизиты", ДопРеквизиты);
		
		Источник.ДополнительныеСвойства.Вставить("ДанныеАвтоПроведения", ДанныеАвтоПроведения);
		
		ДобавленыДанныеАвтоПроведения = Истина;
	КонецЕсли;
	
	Если ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("РасшифровкаПлатежа", МДИсточника) Тогда
		ЗаполнитьПоТабличнойЧасти(Источник, ТабДокумент);
	Иначе
		ЗаполнитьПоДокументу(Источник, ТабДокумент);
	КонецЕсли;
	
	Если ДобавленыДанныеАвтоПроведения Тогда
		Источник.ДополнительныеСвойства.Удалить("ДанныеАвтоПроведения");
	КонецЕсли;
	
	Если ТабДокумент.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТабДокумент.Свернуть(КолонкиСвертки, "СуммаДокумента");
	
	УстановитьПараметрыНастроекПоУмолчаниюСКД(Источник, СКД, ТабДокумент);
	
	ВнешниеНаборыДанных = Новый Структура("ДанныеДокумента", ТабДокумент);
	
	Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	УстановитьПривилегированныйРежим(Истина);
	Макет = Компоновщик.Выполнить(СКД, СКД.НастройкиПоУмолчанию,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет, ВнешниеНаборыДанных,, Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	УстановитьПривилегированныйРежим(Ложь);

	
	Если Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТабАнализ = Новый ТаблицаЗначений;
	
	Если ЕстьПревышениеПоРезультатамПроверки(Отказ, Результат, ТабАнализ) Тогда
		Если ИзДокумента Тогда
			Адрес = ПоместитьВоВременноеХранилище(ТабАнализ);
		Иначе
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения(ТабАнализ));
		КонецЕсли;
		
		Если Константы.ДействияПриКонтроле.Получить() = Перечисления.ДействияПриКонтролеОбязательств.ПредупреждатьНеЗаписывать Тогда
			Отказ = Истина;
		КонецЕсли;
	Иначе
		Если ИзДокумента И Информировать Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Превышения сумм обязательств и плановых показателей не происходит!'"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

///////////////////////////////////////////////////////////
//// ОБРАБОТЧИКИ ПОДПИСОК НА СОБЫТИЯ

Процедура ПриЗаписиРегистраБухгалтерии(Источник, Отказ, РежимЗаписи) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Или Источник.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Константы.КонтрольОбязательств.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	Регистратор = Источник.Отбор.Регистратор.Значение;
	
	Если Регистратор.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	РазделыКонтроля = Новый Массив;
	РазделыКонтроля.Добавить("БО");
	РазделыКонтроля.Добавить("ДО");
	
	Для Каждого Раздел Из РазделыКонтроля Цикл
		
		ТабПроводок = ТаблицаПроводок(Источник, Раздел);
		
		Если ТабПроводок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкаКонтроля = Справочники.НастройкиКонтроляОбязательств.НайтиПоРеквизиту("Организация", ТабПроводок[0].Организация);
		
		Если Не ЗначениеЗаполнено(НастройкаКонтроля) Тогда
			Продолжить;
		КонецЕсли;
		
		СхемаПроверки = НастройкаКонтроля.СхемаКонтроля.Получить();
		
		Если Раздел = "ДО" Тогда
			СКД = СхемаПроверки[1];
		Иначе
			СКД = СхемаПроверки[2];
		КонецЕсли;
		
		Если СКД = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТабДокумент = Новый ТаблицаЗначений;
		КолонкиСвертки = "";
		
		Для Каждого Параметр Из СКД.Параметры Цикл
			
			Если Параметр.Имя = "НачалоПериода" Или Параметр.Имя = "КонецПериода" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Лев(Параметр.Имя, 6) = "Счета_" Тогда
				Продолжить;
			КонецЕсли;
			
			ТабДокумент.Колонки.Добавить(Параметр.Имя, Новый ОписаниеТипов(Параметр.ТипЗначения, "Null"));
			
			КолонкиСвертки = КолонкиСвертки + ?(СтрДлина(КолонкиСвертки) > 0, ",", "") + Параметр.Имя;
		КонецЦикла;
		
		ТабДокумент.Колонки.Добавить("СуммаДокумента", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18,2));
		
		Для Каждого Строка Из ТабПроводок Цикл
			Стр = ТабДокумент.Добавить();
			Для Каждого Колонка Из ТабДокумент.Колонки Цикл
				Если ТабПроводок.Колонки.Найти(Колонка.Имя) <> Неопределено Тогда
					Если ЗначениеЗаполнено(Строка[Колонка.Имя]) Тогда
						Стр[Колонка.Имя] = Строка[Колонка.Имя];
					КонецЕсли;
				ИначеЕсли ТабПроводок.Колонки.Найти(Колонка.Имя+"Дт") <> Неопределено Тогда
					Если ЗначениеЗаполнено(Строка[Колонка.Имя+"Дт"]) Тогда
						Стр[Колонка.Имя] = Строка[Колонка.Имя+"Дт"];
					КонецЕсли;
				ИначеЕсли Колонка.Имя = "СуммаДокумента" Тогда
					Если ЗначениеЗаполнено(Строка.Сумма) Тогда
						Стр.СуммаДокумента = Строка.Сумма;
					КонецЕсли;
				Иначе
					Для К = 1 По 3 Цикл
						Если Строка["СубконтоДт"+К] <> Неопределено Тогда
							Для Каждого ТипКолонки Из Колонка.ТипЗначения.Типы() Цикл
								Если ТипКолонки = ТипЗнч(Строка["СубконтоДт"+К]) Тогда
									Стр[Колонка.Имя] = Строка["СубконтоДт"+К];
									Прервать;
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если ТабДокумент.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТабДокумент.Свернуть(КолонкиСвертки, "СуммаДокумента");
		
		УстановитьПараметрыНастроекПоУмолчаниюСКД(Регистратор, СКД, ТабДокумент, Истина, ТабПроводок[0].Период);
		
		ВнешниеНаборыДанных = Новый Структура("ДанныеДокумента", ТабДокумент);
		
		Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
		
		УстановитьПривилегированныйРежим(Истина);
		Макет = Компоновщик.Выполнить(СКД, СКД.НастройкиПоУмолчанию,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(Макет, ВнешниеНаборыДанных,, Истина);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
		Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		УстановитьПривилегированныйРежим(Ложь);
		
		Если Результат.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТабАнализ = Новый ТаблицаЗначений;
		
		Если ЕстьПревышениеПоРезультатамПроверки(Отказ, Результат, ТабАнализ, Истина) Тогда
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения(ТабАнализ));
			
			Если Константы.ДействияПриКонтроле.Получить() = Перечисления.ДействияПриКонтролеОбязательств.ПредупреждатьНеЗаписывать Тогда
				Отказ = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Константы.КонтрольОбязательств.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	Статус = ПолучитьСтатусДокумента(Источник);
	
	Если Не Статус Тогда
		Возврат;
	КонецЕсли;
	
	Контроль(Источник, Отказ, РежимЗаписи);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

///////////////////////////////////////////////////////////
//// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ТаблицаПроводок(Источник, Раздел)
	Если Раздел = "ДО" Тогда
		СчетКт = БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("502.12");
	ИначеЕсли Раздел = "БО" Тогда
		СчетКт = БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("502.11, 502.17");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТабПроводок.ИФО,
	|	ТабПроводок.СчетДт,
	|	ТабПроводок.СчетКт,
	|	ТабПроводок.КПСДт,
	|	ТабПроводок.КПСКт,
	|	ТабПроводок.КФО,
	|	ТабПроводок.КЭКДт,
	|	ТабПроводок.КЭККт,
	|	ТабПроводок.Организация,
	|	ТабПроводок.Период,
	|	ТабПроводок.ПодразделениеДт,
	|	ТабПроводок.ПодразделениеКт,
	|	ТабПроводок.ВидСубконтоДт1,
	|	ТабПроводок.ВидСубконтоДт2,
	|	ТабПроводок.ВидСубконтоДт3,
	|	ТабПроводок.СубконтоДт1,
	|	ТабПроводок.СубконтоДт2,
	|	ТабПроводок.СубконтоДт3,
	|	ТабПроводок.ВидСубконтоКт1,
	|	ТабПроводок.ВидСубконтоКт2,
	|	ТабПроводок.ВидСубконтоКт3,
	|	ТабПроводок.СубконтоКт1,
	|	ТабПроводок.СубконтоКт2,
	|	ТабПроводок.СубконтоКт3,
	|	ТабПроводок.Сумма
	|ПОМЕСТИТЬ ТабПроводок
	|ИЗ
	|	&ТабПроводок КАК ТабПроводок;
	|
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	ТабПроводок
	|ГДЕ
	|	ТабПроводок.СчетКт В(&СчетКт)
	|";
	Запрос.УстановитьПараметр("СчетКт", СчетКт);
	Запрос.УстановитьПараметр("ТабПроводок", Источник.Выгрузить());
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ТекстСообщения(Таблица)
	
	Результат = "";
	
	КолонкиРезультата = Новый Массив;
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Лев(Колонка.Имя, 15) = "Текущий_остаток" Тогда
			КолонкиРезультата.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Стр Из Таблица Цикл
		Для Каждого Колонка Из КолонкиРезультата Цикл
			Если Стр[Колонка] - Стр.Сумма_документа < 0 Тогда
				Результат = Результат + ?(СтрДлина(Результат) > 0, Символы.ПС, "") + 
							СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Превышен %1 (%2 %3) на %4 %5!'"),
							                                                            СтрЗаменить(НРег(Колонка), "_", " "),
																						Формат(Стр[Колонка], "ЧДЦ=2; ЧН=0,00"),
																						НСтр("ru='руб.'"),
																						Формат(Стр.Сумма_документа - Стр[Колонка], "ЧДЦ=2; ЧН=0,00"),
																						НСтр("ru='руб.'"));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьПоТабличнойЧасти(Источник, ТабДокумент)
	
	МДДокумента = Источник.Метаданные();
	
	НалогНаДоходы = ЭтоУплатаНалогаНаДоходы(Источник);
	
	Для Каждого Строка Из Источник.РасшифровкаПлатежа Цикл
		
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("КБКНазначениеПлатежа", МДДокумента, "РасшифровкаПлатежа") И 
			 ЗначениеЗаполнено(Строка.КБКНазначениеПлатежа) И 
			 НЕ Строка.КБКНазначениеПлатежа.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ") И
			 НалогНаДоходы Тогда
			  // Уплату налога на доходы проверяем только для казенных учреждений (платятся по классификации расходов)
			 Продолжить;
		КонецЕсли;
		
		// Не надо проверять платежи по КФО = 3
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Строка,"КФО")
				И ЗначениеЗаполнено(Строка.КФО)
				И Строка.КФО = ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение") Тогда
			Продолжить;
		КонецЕсли;
		
		// Не надо проверять платежи не по классификации расходов
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Строка,"КБКНазначениеПлатежа")
				И ЗначениеЗаполнено(Строка.КБКНазначениеПлатежа)
				И НЕ Строка.КБКНазначениеПлатежа.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ")
				И НЕ Строка.КБКНазначениеПлатежа.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ") Тогда
			Продолжить;
		КонецЕсли;
		
		Стр = ТабДокумент.Добавить();
		
		Для Каждого Колонка Из ТабДокумент.Колонки Цикл
			
			Реквизит = Колонка.Имя;
			
			ТипРеквизита = Колонка.ТипЗначения;
			
			Если Реквизит = "Договоры" И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Договор", МДДокумента) И ЗначениеЗаполнено(Источник.Договор) Тогда
				Стр.Договоры = Источник.Договор;
			ИначеЕсли Реквизит = "РазделыЛицевыхСчетов" Тогда
				ИсточникСредств = Неопределено;
				ИсполняемыйДоговор = Неопределено; 
				РазделЛицевогоСчета = Неопределено;

				Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("ИсточникСредств", МДДокумента, "РасшифровкаПлатежа") 
					И ЗначениеЗаполнено(Строка.ИсточникСредств) Тогда
					ИсточникСредств = Строка.ИсточникСредств;
				ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ИсточникСредств", МДДокумента) 
					И ЗначениеЗаполнено(Источник.ИсточникСредств) Тогда
					ИсточникСредств = Источник.ИсточникСредств;
				ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("РазделЛицевогоСчета", МДДокумента, "РасшифровкаПлатежа") 
					И ЗначениеЗаполнено(Строка.РазделЛицевогоСчета) Тогда
					РазделЛицевогоСчета = Строка.РазделЛицевогоСчета;
				ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("РазделЛицевогоСчета", МДДокумента) 
					И ЗначениеЗаполнено(Источник.РазделЛицевогоСчета) Тогда
					РазделЛицевогоСчета = Источник.РазделЛицевогоСчета;
				КонецЕсли;
				
				Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ИсполняемыйДоговор", МДДокумента) Тогда
					ИсполняемыйДоговор = Источник.ИсполняемыйДоговор;
				КонецЕсли;
				
				Если НЕ РазделЛицевогоСчета = Неопределено Тогда
					Стр.РазделыЛицевыхСчетов = РазделЛицевогоСчета;
				Иначе
					Стр.РазделыЛицевыхСчетов = БухгалтерскийУчетПовтИсп.РазделЛицевогоСчетаПоИсточникуСредств(Источник.ЛицевойСчет, ИсточникСредств, ИсполняемыйДоговор);
				КонецЕсли;
				
			ИначеЕсли Реквизит = "КПС" И (ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("КБКНазначениеПлатежа", МДДокумента, "РасшифровкаПлатежа") 
									И ЗначениеЗаполнено(Строка.КБКНазначениеПлатежа)) Тогда
				Стр.КПС = Строка.КБКНазначениеПлатежа;
				
			ИначеЕсли Реквизит = "КЭК" И (ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("КОСГУНазначениеПлатежа", МДДокумента, "РасшифровкаПлатежа") 
									И ЗначениеЗаполнено(Строка.КОСГУНазначениеПлатежа)) Тогда
				Стр.КЭК = Строка.КОСГУНазначениеПлатежа;
				
			ИначеЕсли Реквизит = "СуммаДокумента" Тогда
				Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("Сумма", МДДокумента, "РасшифровкаПлатежа") Тогда
					Стр.СуммаДокумента = Строка.Сумма;
				ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("СуммаДокумента", МДДокумента, "РасшифровкаПлатежа") Тогда
					Стр.СуммаДокумента = Строка.СуммаДокумента;
				Иначе
					Стр.СуммаДокумента = 0;
				КонецЕсли;
			Иначе
				Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента(Реквизит, МДДокумента, "РасшифровкаПлатежа") И ЗначениеЗаполнено(Строка[Реквизит]) Тогда
					Стр[Реквизит] = Строка[Реквизит];
				ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента(Реквизит, МДДокумента) И ЗначениеЗаполнено(Источник[Реквизит]) Тогда
					Стр[Реквизит] = Источник[Реквизит];
				Иначе
					Значение = Неопределено;
					
					Если ЕстьДанныеАвтоПроведения(Источник, Реквизит, ТипРеквизита, Значение) И Значение <> Неопределено Тогда
						Стр[Реквизит] = Значение;
					ИначеЕсли ЕстьДополнительныеТабличныеЧасти(Источник, Реквизит, ТипРеквизита, Строка.НомерСтроки, Значение) И Значение <> Неопределено Тогда
						Стр[Реквизит] = Значение;
					ИначеЕсли ЕстьРеквизитДокументаПоТипу(Строка, ТипРеквизита, Значение) И Значение <> Неопределено Тогда
						Стр[Реквизит] = Значение;
					ИначеЕсли ЕстьРеквизитДокументаПоТипу(Источник, ТипРеквизита, Значение) И Значение <> Неопределено Тогда
						Стр[Реквизит] = Значение;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьПоДокументу(Источник, ТабДокумент)
	
	НалогНаДоходы = ЭтоУплатаНалогаНаДоходы(Источник);
	
	Если НЕ Источник.КБКНазначениеПлатежа.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ")
		И НалогНаДоходы Тогда
		//уплату налога на доходы проверяем только для казенных учреждений (платятся по классификации расходов)
		Возврат;
	КонецЕсли;
	
	// не надо проверять платежи по КФО = 3
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник,"КФО")
			И ЗначениеЗаполнено(Источник.КФО)
			И Источник.КФО = ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение") Тогда
		Возврат;
	КонецЕсли;
		
	// не надо проверять платежи не по классификации расходов
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник,"КБКНазначениеПлатежа")
			И ЗначениеЗаполнено(Источник.КБКНазначениеПлатежа)
			И НЕ Источник.КБКНазначениеПлатежа.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ")
			И НЕ Источник.КБКНазначениеПлатежа.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ") Тогда
		Возврат;
	КонецЕсли;
	
	МДДокумента = Источник.Метаданные();
	
	Стр = ТабДокумент.Добавить();
	
	Для Каждого Колонка Из ТабДокумент.Колонки Цикл
		Реквизит = Колонка.Имя;
		ТипРеквизита = Колонка.ТипЗначения;
		
		Если Реквизит = "Договоры" И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Договор", МДДокумента) И ЗначениеЗаполнено(Источник.Договор) Тогда
			Стр.Договоры = Источник.Договор;
		ИначеЕсли Реквизит = "РазделыЛицевыхСчетов" Тогда
			ИсполняемыйДоговор = Неопределено;
			Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ИсполняемыйДоговор", МДДокумента) Тогда
				ИсполняемыйДоговор = Источник.ИсполняемыйДоговор;
			КонецЕсли;
			Стр.РазделыЛицевыхСчетов = БухгалтерскийУчетПовтИсп.РазделЛицевогоСчетаПоИсточникуСредств(Источник.ЛицевойСчет, Источник.ИсточникСредств, ИсполняемыйДоговор);
		ИначеЕсли Реквизит = "КПС" Тогда
			Стр.КПС = Источник.КБКНазначениеПлатежа;
		ИначеЕсли Реквизит = "КЭК" Тогда
			Стр.КЭК = Источник.КОСГУНазначениеПлатежа;
		ИначеЕсли Реквизит = "СуммаДокумента" Тогда
			Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Сумма", МДДокумента) Тогда
				Стр.СуммаДокумента = Источник.Сумма;
			ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("СуммаДокумента", МДДокумента) Тогда
				Стр.СуммаДокумента = Источник.СуммаДокумента;
			Иначе
				Стр.СуммаДокумента = 0;
			КонецЕсли;
		Иначе
			Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента(Реквизит, МДДокумента) И ЗначениеЗаполнено(Источник[Реквизит]) Тогда
				Стр[Реквизит] = Источник[Реквизит];
			Иначе
				Значение = Неопределено;
				Если ЕстьДанныеАвтоПроведения(Источник, Реквизит, ТипРеквизита, Значение) И Значение <> Неопределено Тогда
					Стр[Реквизит] = Значение;
				ИначеЕсли ЕстьРеквизитДокументаПоТипу(Источник, ТипРеквизита, Значение) И Значение <> Неопределено Тогда
					Стр[Реквизит] = Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьДанныеАвтоПроведения(Источник, Реквизит, ТипРеквизита, Значение)
	Результат = Ложь;
	
	ДанныеАвтоПроведения = Новый Структура;
	
	Если Не Источник.ДополнительныеСвойства.Свойство("ДанныеАвтоПроведения", ДанныеАвтоПроведения) Или ДанныеАвтоПроведения = Неопределено Тогда
		Возврат Результат;
	Иначе
		ДополнительныеРеквизиты = Новый Структура;
		
		Если Не ДанныеАвтоПроведения.Свойство("ДополнительныеРеквизиты", ДополнительныеРеквизиты) Или ДополнительныеРеквизиты = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеРеквизиты.Свойство(Реквизит, Значение) И ЗначениеЗаполнено(Значение) Тогда
		Результат = Истина;
	ИначеЕсли ЕстьРеквизитДокументаПоТипу(ДополнительныеРеквизиты, ТипРеквизита, Значение) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЕстьДополнительныеТабличныеЧасти(Источник, Реквизит, ТипРеквизита, НомерСтроки, Значение)
	Результат = Ложь;
	
	ДопТабЧасти = Новый ТаблицаЗначений;
	
	Если Не Источник.ДополнительныеСвойства.Свойство("ДанныеДополнительныхТабЧастей", ДопТабЧасти) Или ДопТабЧасти = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Стр = ДопТабЧасти.Найти(НомерСтроки, "НомерСтрокиДокумента");
	
	Если Стр = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ДопТабЧасти.Колонки.Найти(Реквизит) <> Неопределено И ЗначениеЗаполнено(Стр[Реквизит]) Тогда
		Значение = Стр[Реквизит];
		Результат = Истина;
	ИначеЕсли ЕстьРеквизитДокументаПоТипу(Стр, ТипРеквизита, Значение) Тогда
		Результат = Истина;		
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЕстьРеквизитДокументаПоТипу(Источник, ТипРеквизита, Значение)
	
	Результат = Ложь;
	
	Если ТипЗнч(Источник) = Тип("Структура") Тогда
		Для Каждого Элемент Из Источник Цикл
			Для Каждого Тип Из ТипРеквизита.Типы() Цикл
				Если ТипЗнч(Элемент.Значение) = Тип И ЗначениеЗаполнено(Элемент.Значение) Тогда
					Значение = Элемент.Значение;
					Результат = Истина;
				
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Источник) = Тип("СтрокаТаблицыЗначений") Тогда
		Если Источник.ТабличнаяЧасть.ИмяТабличнойЧасти = "РасшифровкаПлатежа" Тогда
			Для Каждого Тип Из ТипРеквизита.Типы() Цикл
				Если ТипЗнч(Источник.Значение) = Тип И ЗначениеЗаполнено(Источник.Значение) Тогда
					Значение = Источник.Значение;
					Результат = Истина;
					
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли Лев(Строка(Источник),28) = "ДокументТабличнаяЧастьСтрока" Тогда
		Для Каждого Элемент Из Источник Цикл
			Для Каждого Тип Из ТипРеквизита.Типы() Цикл
				Если ТипЗнч(Элемент) = Тип И ЗначениеЗаполнено(Элемент) Тогда
					Значение = Элемент;
					Результат = Истина;
				
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Иначе // Это шапка документа
		МДИсточника = Источник.Метаданные();
		
		Для Каждого Реквизит Из МДИсточника.Реквизиты Цикл
			Для Каждого Тип Из ТипРеквизита.Типы() Цикл
				Если Реквизит.Тип.СодержитТип(Тип) И ЗначениеЗаполнено(Источник[Реквизит.Имя]) Тогда
					Значение = Источник[Реквизит.Имя];
					Результат = Истина;
				
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЭтоУплатаНалогаНаДоходы(Источник)

	Значение = Неопределено;
	ТипРеквизитаНалог = Новый ОписаниеТипов("СправочникСсылка.НалогиИПлатежиОрганизации");
	
	Если ЕстьРеквизитДокументаПоТипу(Источник, ТипРеквизитаНалог, Значение) И ЗначениеЗаполнено(Значение) Тогда
		
		// В случае уплаты налогов на доходы (НДС, прибыль, акцизы) контрольрасходов не проводится
		// Прибыль, НДС - группа доходов 10101 и 103 по КДБ
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	НалогиИПлатежиОрганизации.Ссылка
		|ИЗ
		|	Справочник.НалогиИПлатежиОрганизации КАК НалогиИПлатежиОрганизации
		|ГДЕ
		|	НалогиИПлатежиОрганизации.Ссылка = &Ссылка
		|	И (ПОДСТРОКА(НалогиИПлатежиОрганизации.ВидНалогаИлиПлатежа.Классификатор, 1, 5) = ""10101""
		|			ИЛИ ПОДСТРОКА(НалогиИПлатежиОрганизации.ВидНалогаИлиПлатежа.Классификатор, 1, 3) = ""103"")");
		
		Запрос.УстановитьПараметр("Ссылка", Значение);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Возврат НЕ РезультатЗапроса.Пустой();
				
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции	

Функция ПолучитьСтатусДокумента(Источник)
	
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(Источник.Ссылка) Тогда
		
		//Статус установлен в новом незаписаном документе
		
		Если Источник.ДополнительныеСвойства.Свойство("УстановленСтатус") И 
			(Источник.ДополнительныеСвойства.УстановленСтатус =  Перечисления.СтатусыИсполненияДокумента.Подготовлен Или 
			Источник.ДополнительныеСвойства.УстановленСтатус =  Перечисления.СтатусыИсполненияДокумента.НаИсполнении Или 
			Источник.ДополнительныеСвойства.УстановленСтатус =  Перечисления.СтатусыИсполненияДокумента.Исполнен) Или
			ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
			
			Результат = Истина
			
		КонецЕсли;
		
	Иначе
		
		Отбор = Новый Структура("ПлатежноРасчетныйДокумент", Источник.Ссылка);
		Статусы = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Получить(Отбор);
		
		Статус = Неопределено;
		
		Если ТипЗнч(Статусы) = Тип("Структура") И (Статусы.Свойство("Статус", Статус) И
			(Статус = Перечисления.СтатусыИсполненияДокумента.Подготовлен Или
			Статус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении Или
			Статус = Перечисления.СтатусыИсполненияДокумента.Исполнен)) Или
			ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
			
			Результат = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьПараметрыНастроекПоУмолчаниюСКД(Источник, СКД, ТабДокумент, КонтрольПослеЗаписи = Ложь, ДатаПроводки = Неопределено)
	
	Если КонтрольПослеЗаписи Тогда
		Если Источник.Дата = '00010101000000' Тогда
			КонецПериода = ТекущаяДатаСеанса();
		ИначеЕсли Источник.Дата = ДатаПроводки Тогда
			КонецПериода = Новый Граница(Источник.МоментВремени(), ВидГраницы.Включая);
		Иначе
			КонецПериода = Новый Граница(ДатаПроводки, ВидГраницы.Включая);
		КонецЕсли;
	Иначе
		КонецПериода = ?(Источник.Дата <> '00010101000000',
			Новый Граница(Источник.МоментВремени(), ВидГраницы.Исключая),
			ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если ТипЗнч(КонецПериода) = Тип("Граница") Тогда
		Если ТипЗнч(КонецПериода.Значение) = Тип("МоментВремени") Тогда
			НачалоПериода = НачалоГода(КонецПериода.Значение.Дата);
		Иначе
			НачалоПериода = НачалоГода(КонецПериода.Значение);
		КонецЕсли;
	Иначе
		НачалоПериода = НачалоГода(КонецПериода);
	КонецЕсли;
	
	Для Каждого Параметр Из СКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы Цикл
		
		ИмяПараметра = Строка(Параметр.Параметр);
		
		Если СКД.Параметры.Найти(ИмяПараметра) = Неопределено Тогда
			Параметр.Использование = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ИмяПараметра = "ИФО" Тогда
			Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
				Параметр.Значение = Неопределено;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ИмяПараметра = "Подразделение" Тогда
			Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
				Параметр.Значение = Неопределено;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ИмяПараметра = "НачалоПериода" Тогда
			Параметр.Значение = НачалоПериода;
			Параметр.Использование = Истина;
			Продолжить;
		КонецЕсли;
		
		Если ИмяПараметра = "КонецПериода" Тогда
			Параметр.Значение = КонецПериода;
			Параметр.Использование = Истина;
			Продолжить;
		КонецЕсли;
		
		Значение = Неопределено;
		Использование = Ложь;
		
		Если СКД.Параметры[ИмяПараметра].ДоступенСписокЗначений Тогда
			СпЗначений = Новый СписокЗначений;
			СпЗначений.ЗагрузитьЗначения(ТабДокумент.ВыгрузитьКолонку(ИмяПараметра));
			Значение = СпЗначений;
			
			Использование = СпЗначений.Количество() > 0;
		Иначе
			Если ЗначениеЗаполнено(ТабДокумент[0][ИмяПараметра]) Тогда
				Значение = ТабДокумент[0][ИмяПараметра];
				
				Использование = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Параметр.Значение = Значение;
		Параметр.Использование = Использование;
		
	КонецЦикла;
	
КонецПроцедуры

Функция УстановитьИмяКолонки(Колонка)
	Если Колонка = "ИФО" Или Колонка = "КФО" Или Колонка = "КЭК" Или Колонка = "КПС" Тогда
		Возврат Колонка;
	КонецЕсли;
	
	Результат = Лев(Колонка, 1);
	
	Для К = 2 По СтрДлина(Колонка) Цикл
		Символ = Сред(Колонка, К, 1);
		
		Если Символ = ВРег(Символ) Тогда
			Результат = Результат + "_" + НРег(Символ);
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ЕстьПревышениеПоРезультатамПроверки(Отказ, ТабПроверки, ТабАнализ, КонтрольПослеЗаписи = Ложь)
	
	КолонкиАналитик = Новый Массив;
	КолонкиСумм = Новый Массив;
	СоответствиеКолонок = Новый Соответствие;
	
	КолонкиСумм.Добавить("Сумма_документа");
	СоответствиеКолонок.Вставить("СуммаДокумента", "Сумма_документа");
	
	Для Каждого Колонка Из ТабПроверки.Колонки Цикл
		Если Колонка.Имя = "СуммаДокумента" Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(Колонка.Имя, 7) = "Остаток" Тогда
			Раздел = СтрЗаменить(Колонка.Имя, "Остаток", "");
			
			Если Раздел = "БО" Тогда
				КолонкиСумм.Добавить("Текущий_остаток_принятых_обязательств");
				КолонкиСумм.Добавить("Конечный_остаток_принятых_обязательств");
				
				СоответствиеКолонок.Вставить(Колонка.Имя, "Текущий_остаток_принятых_обязательств");
			ИначеЕсли Раздел = "ДО" Тогда
				КолонкиСумм.Добавить("Текущий_остаток_денежных_обязательств");
				КолонкиСумм.Добавить("Конечный_остаток_денежных_обязательств");
				
				СоответствиеКолонок.Вставить(Колонка.Имя, "Текущий_остаток_денежных_обязательств");
			ИначеЕсли Раздел = "ЛБО" Тогда
				КолонкиСумм.Добавить("Текущий_остаток_лимитов_бюджетных_обязательств");
				КолонкиСумм.Добавить("Конечный_остаток_лимитов_бюджетных_обязательств");
				
				СоответствиеКолонок.Вставить(Колонка.Имя, "Текущий_остаток_лимитов_бюджетных_обязательств");
			ИначеЕсли Раздел = "БА" Тогда
				КолонкиСумм.Добавить("Текущий_остаток_бюджетных_ассигнований");
				КолонкиСумм.Добавить("Конечный_остаток_бюджетных_ассигнований");
				
				СоответствиеКолонок.Вставить(Колонка.Имя, "Текущий_остаток_бюджетных_ассигнований");
			ИначеЕсли Раздел = "ПОФ" Тогда
				КолонкиСумм.Добавить("Текущий_остаток_предельных_объемов_финансирования");
				КолонкиСумм.Добавить("Конечный_остаток_предельных_объемов_финансирования");
				
				СоответствиеКолонок.Вставить(Колонка.Имя, "Текущий_остаток_предельных_объемов_финансирования");
			ИначеЕсли Раздел = "ФХД" Тогда
				КолонкиСумм.Добавить("Текущий_остаток_статьи_плана_ФХД");
				КолонкиСумм.Добавить("Конечный_остаток_статьи_плана_ФХД");
				
				СоответствиеКолонок.Вставить(Колонка.Имя, "Текущий_остаток_статьи_плана_ФХД");
			КонецЕсли;
		Иначе
			ИмяКолонки = УстановитьИмяКолонки(Колонка.Имя);
			
			КолонкиАналитик.Добавить(ИмяКолонки);
			
			СоответствиеКолонок.Вставить(Колонка.Имя, ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Колонка Из КолонкиАналитик Цикл
		ТабАнализ.Колонки.Добавить(Колонка);
	КонецЦикла;
	
	Для Каждого Колонка Из КолонкиСумм Цикл
		ТабАнализ.Колонки.Добавить(Колонка, ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18,2));
	КонецЦикла;
	
	ЕстьПревышение = Ложь;
	
	Для Каждого Строка Из ТабПроверки Цикл
		Стр = ТабАнализ.Добавить();
		
		Стр["Сумма_документа"] = ?(ЗначениеЗаполнено(Строка.СуммаДокумента), Строка.СуммаДокумента, 0);
		
		Для Каждого Колонка Из ТабПроверки.Колонки Цикл
			Если Колонка.Имя = "СуммаДокумента" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Лев(Колонка.Имя, 7) <> "Остаток" Тогда
				Стр[СоответствиеКолонок[Колонка.Имя]] = Строка[Колонка.Имя];
			Иначе
				
				Если КонтрольПослеЗаписи Тогда
					ТекущийОстаток = ?(ЗначениеЗаполнено(Строка[Колонка.Имя]), Строка[Колонка.Имя], 0) + Стр["Сумма_документа"];
				Иначе
					ТекущийОстаток = ?(ЗначениеЗаполнено(Строка[Колонка.Имя]), Строка[Колонка.Имя], 0);
				КонецЕсли;
				
				Стр[СоответствиеКолонок[Колонка.Имя]] = ТекущийОстаток;
				Стр[СтрЗаменить(СоответствиеКолонок[Колонка.Имя], "Текущий", "Конечный")] = ТекущийОстаток - Стр["Сумма_документа"];
				
				Если ТекущийОстаток < Стр["Сумма_документа"] Тогда
					ЕстьПревышение = Истина;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ЕстьПревышение;
	
КонецФункции

#КонецОбласти
