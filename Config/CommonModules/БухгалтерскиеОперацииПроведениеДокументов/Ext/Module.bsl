	|	ЕСТЬNULL(ПараметрыАмортизацииПоОбъектамАренды.СчетРасчетов, ПараметрыАмортизацииПоДоговоруВЦелом.СчетРасчетов),
	|	ЕСТЬNULL(ПараметрыАмортизацииПоОбъектамАренды.КПСРасчетов, ПараметрыАмортизацииПоДоговоруВЦелом.КПСРасчетов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОбороты.Организация КАК Организация,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОбороты.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОбороты.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОбороты.Счет КАК СчетДБП,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Справочник.Договоры) КАК Договор,
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборот КАК СуммаДБП
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Счет В (&СчетаДБП),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры),
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Субконто1 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						АмортизацияНачисленнаяЗаПериод.Договор
	|					ИЗ
	|						АмортизацияНачисленнаяЗаПериод),
	|			КорСчет В (&Счета40110),
	|			) КАК ЖурналПроводокЕПСБУОбороты";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", ДополнительныеРеквизиты.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Контрагент) Тогда
		Если ДополнительныеРеквизиты.Контрагент.ЭтоГруппа Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент В ИЕРАРХИИ (&Контрагент)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент = &Контрагент");
		КонецЕсли;
		Запрос.УстановитьПараметр("Контрагент", ДополнительныеРеквизиты.Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "ИСТИНА" );
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Договор) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор",
			"ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры) В(&Договор)");
		Запрос.УстановитьПараметр("Договор", ДополнительныеРеквизиты.Договор);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор", "ИСТИНА" );
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаАмортизацияПравПользования = Результат[НомераТаблиц.АмортизацияПравПользованияБУ].Выгрузить();
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям();
	
	// Распределим остатки ДБП по аналитике прав пользования.
	ДоходыОтПредоставленияПравПользования = Результат[НомераТаблиц.ДоходыОтПредоставленияПравПользования].Выгрузить();
	ТаблицаАмортизацияПравПользования.Колонки.Добавить("СуммаДБП",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	Для Каждого ОстатокДБП Из ДоходыОтПредоставленияПравПользования Цикл
		
		СвойстваСчетаДБП = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ОстатокДБП.СчетДБП);
		
		ОтборПравПользования = ?(ИспользоватьУчетПоПодразделениям И СвойстваСчетаДБП.УчетПоПодразделениям,
			Новый Структура("ИФО,КФО,Подразделение,Договор"),
			Новый Структура("ИФО,КФО,Договор"));
		ЗаполнитьЗначенияСвойств(ОтборПравПользования, ОстатокДБП);
		НайденныеСтрокиПравПользования = ТаблицаАмортизацияПравПользования.НайтиСтроки(ОтборПравПользования);
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(ОстатокДБП.СуммаДБП,
			НайденныеСтрокиПравПользования, "СуммаДБП", "СуммаАмортизации", Ложь);
		
	КонецЦикла;
	
	// Корректировка резерва на сумму начисленной амортизации.
	Для Каждого СтрокаПравПользования Из ТаблицаАмортизацияПравПользования Цикл
		
		СуммаКорректировки = СтрокаПравПользования.СуммаАмортизации - СтрокаПравПользования.СуммаДБП;
		Если СуммаКорректировки = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаПравПользования.СчетРасчетов) Тогда
			СчетРасчетов = СтрокаПравПользования.СчетРасчетов;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СтрокаПравПользования.СчетАмортизации, "104.49") Тогда
			СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.29", ДокументОбъект.Дата, ДокументОбъект.Организация);
		Иначе
			СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.24", ДокументОбъект.Дата, ДокументОбъект.Организация);
		КонецЕсли;
		
		КЭКОперации = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(СчетРасчетов);
		
		СодержаниеПроводки = НСтр("ru = 'Изменение Инструкций по учету: корректировка резервов по договорам операционной аренды (амортизация)'");
		
		НоваяСтрока = ТаблицаПроводок.Добавить();
		НоваяСтрока.КФО = СтрокаПравПользования.КФО;
		Если ИспользоватьУчетПоИФО Тогда
			НоваяСтрока.ИФО = СтрокаПравПользования.ИФО;
		КонецЕсли;
		
		// Дебет.
		НоваяСтрока.СчетДт = ДополнительныеРеквизиты.СчетРезерва;
		БухгалтерскийУчет.УстановитьСубконто(НоваяСтрока, "Дт", "Резервы", ДополнительныеРеквизиты.Резерв);
		БухгалтерскийУчет.УстановитьСубконто(НоваяСтрока, "Дт", "Договоры", СтрокаПравПользования.Договор);
		
		СвойстваСчетаРезервов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетДт);
		Если СвойстваСчетаРезервов.УчетПоКПС Тогда
			НоваяСтрока.КПСДт = СтрокаПравПользования.КПС;
		КонецЕсли;
		Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаРезервов.УчетПоПодразделениям Тогда
			НоваяСтрока.ПодразделениеДт = СтрокаПравПользования.Подразделение;
		КонецЕсли;
		НоваяСтрока.КЭКДт = КЭКОперации; 
		
		// Кредит.
		НоваяСтрока.СчетКт = СчетРасчетов;
		БухгалтерскийУчет.УстановитьСубконто(НоваяСтрока, "Кт", "Контрагенты", СтрокаПравПользования.Контрагент);
		БухгалтерскийУчет.УстановитьСубконто(НоваяСтрока, "Кт", "Договоры", СтрокаПравПользования.Договор);
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетРасчетов);
		Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
			НоваяСтрока.КПСКт = СтрокаПравПользования.КПСРасчетов;
		КонецЕсли;
		Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			НоваяСтрока.ПодразделениеКт = СтрокаПравПользования.Подразделение;
		КонецЕсли;
		Если СвойстваСчетаРасчетов.Валютный Тогда // Учет прав пользования на счетах 111.40, 104.40, 401.40 ведется только в рублях.
			НоваяСтрока.ВалютаКт = Константы.ВалютаРегламентированногоУчета.Получить();
			НоваяСтрока.ВалютнаяСуммаКт = СуммаКорректировки;
		КонецЕсли;
		
		ДанныеПроводки = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
		ДанныеПроводки.Вставить("Организация", СтрокаПравПользования.Организация);
		ДанныеПроводки.Вставить("ИФО", СтрокаПравПользования.ИФО);
		ДанныеПроводки.Вставить("КФО", СтрокаПравПользования.КФО);
		ДанныеПроводки.Вставить("Дата", ДокументОбъект.Дата);
		ДанныеПроводки.Вставить("Счет", НоваяСтрока.СчетКт);
		ДанныеПроводки.Вставить("ДтКт", "Кт");
		ДанныеПроводки.Вставить("Субконто1", НоваяСтрока.СубконтоКт1);
		ДанныеПроводки.Вставить("Субконто2", НоваяСтрока.СубконтоКт2);
		ДанныеПроводки.Вставить("Субконто3", НоваяСтрока.СубконтоКт3);
		ДанныеПроводки.Вставить("КЭКОперации", КЭКОперации);
		НоваяСтрока.КЭККт = БухгалтерскийУчет.КЭКПроводки(ДанныеПроводки); 
		
		НоваяСтрока.Сумма = СуммаКорректировки;
		ЗаполнитьОбщиеРеквизитыПроводки(НоваяСтрока, ДокументОбъект, СодержаниеПроводки);
		
		
		// Отложенные обязательства.
		Если Не ДополнительныеРеквизиты.ОтразитьОтложенныеОбязательства Тогда
			Продолжить;
		КонецЕсли;
		
		СодержаниеПроводки = НСтр("ru = 'Изменение Инструкций по учету: корректировка отложенных обязательств по договорам операционной аренды (амортизация)'");
		
		НоваяСтрока = ТаблицаПроводок.Добавить();
		НоваяСтрока.КФО = СтрокаПравПользования.КФО;
		Если ИспользоватьУчетПоИФО Тогда
			НоваяСтрока.ИФО = СтрокаПравПользования.ИФО;
		КонецЕсли;
		
		// Дебет.
		Если БухгалтерскиеОперации.ЭтоКазенноеУчреждение(ДокументОбъект.Организация, ДокументОбъект.Дата) Тогда
			НоваяСтрока.СчетДт = БухгалтерскийУчет.СчетПоКоду("501.93", ДокументОбъект.Дата, ДокументОбъект.Организация);
		Иначе
			НоваяСтрока.СчетДт = БухгалтерскийУчет.СчетПоКоду("506.90", ДокументОбъект.Дата, ДокументОбъект.Организация);
		КонецЕсли;
		
		БухгалтерскийУчет.УстановитьСубконто(НоваяСтрока, "Дт", "РазделыЛицевыхСчетов", ДополнительныеРеквизиты.РазделыЛицевыхСчетов);
		
		СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетДт);
		Если СвойстваСчетаДт.УчетПоКПС Тогда
			НоваяСтрока.КПСДт = СтрокаПравПользования.КПСРасчетов;
		КонецЕсли;
		Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаДт.УчетПоПодразделениям Тогда
			НоваяСтрока.ПодразделениеДт = СтрокаПравПользования.Подразделение;
		КонецЕсли;
		Если СвойстваСчетаДт.Валютный Тогда
			НоваяСтрока.ВалютаДт = Константы.ВалютаРегламентированногоУчета.Получить();
			НоваяСтрока.ВалютнаяСуммаДт = (-1) * СуммаКорректировки;
		КонецЕсли;
		
		НоваяСтрока.КЭКДт = КЭКОперации; 
		
		// Кредит.
		НоваяСтрока.СчетКт = БухгалтерскийУчет.СчетПоКоду("502.99", ДокументОбъект.Дата, ДокументОбъект.Организация);
		БухгалтерскийУчет.УстановитьСубконто(НоваяСтрока, "Кт", "РазделыЛицевыхСчетов", ДополнительныеРеквизиты.РазделыЛицевыхСчетов);
		БухгалтерскийУчет.УстановитьСубконто(НоваяСтрока, "Кт", "ПринятыеОбязательства", СтрокаПравПользования.Договор);
		
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
		Если СвойстваСчетаКт.УчетПоКПС Тогда
			НоваяСтрока.КПСКт = СтрокаПравПользования.КПСРасчетов;
		КонецЕсли;
		Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаКт.УчетПоПодразделениям Тогда
			НоваяСтрока.ПодразделениеКт = СтрокаПравПользования.Подразделение;
		КонецЕсли;
		Если СвойстваСчетаДт.Валютный Тогда
			НоваяСтрока.ВалютаКт = Константы.ВалютаРегламентированногоУчета.Получить();
			НоваяСтрока.ВалютнаяСуммаКт = (-1) * СуммаКорректировки;
		КонецЕсли;
		
		НоваяСтрока.КЭККт = КЭКОперации; 
		
		НоваяСтрока.Сумма = (-1) * СуммаКорректировки;
		ЗаполнитьОбщиеРеквизитыПроводки(НоваяСтрока, ДокументОбъект, СодержаниеПроводки);
		
	КонецЦикла;
	
	// 2. Корректировка резервов по договорам операционной аренды в части увеличения/уменьшения балансовой стоимости Дт/Кт 111.40.
	// Формирование корректирующих бух.записей Дт/Кт 401.60 на суммы увеличения/уменьшения балансовой стоимости (за исключением безвозмездной части 401.40).
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецМесяца(ДокументОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетаУчетаПравПользования",
		БухгалтерскийУчет.СписокСчетов("111.40", ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("Счета30220",
		БухгалтерскийУчет.СписокСчетов("302.24,302.29", ДокументОбъект.Дата));
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("ИзменениеБалансовойСтоимостиБУ", НомераТаблиц.Количество());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОбороты.Организация КАК Организация,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОбороты.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОбороты.КПС КАК КПС,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОбороты.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ЖурналПроводокЕПСБУОбороты.Счет КАК СчетУчета,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Справочник.Договоры) КАК Договор,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.КорСубконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ЖурналПроводокЕПСБУОбороты.КорСчет КАК СчетРасчетов,
	|	ЖурналПроводокЕПСБУОбороты.КПСКор КАК КПСРасчетов,
	|	ЖурналПроводокЕПСБУОбороты.КорСубконто1 КАК КорСубконто1,
	|	ЖурналПроводокЕПСБУОбороты.КорСубконто2 КАК КорСубконто2,
	|	ЖурналПроводокЕПСБУОбороты.КорСубконто3 КАК КорСубконто3,
	|	ЖурналПроводокЕПСБУОбороты.ВалютаКор КАК Валюта,
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборотДт КАК СуммаОборотДт,
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборотКт КАК СуммаОборотКт,
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборот КАК ИзменениеБалансовойСтоимости,
	|	ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаКорОборот КАК ИзменениеБалансовойСтоимостиВал
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Счет В (&СчетаУчетаПравПользования),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры),
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И &УсловиеКонтрагент
	|				И &УсловиеДоговор,
	|			КорСчет В (&Счета30220),
	|			) КАК ЖурналПроводокЕПСБУОбороты";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", ДополнительныеРеквизиты.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Контрагент) Тогда
		Если ДополнительныеРеквизиты.Контрагент.ЭтоГруппа Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент В ИЕРАРХИИ (&Контрагент)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент = &Контрагент");
		КонецЕсли;
		Запрос.УстановитьПараметр("Контрагент", ДополнительныеРеквизиты.Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "ИСТИНА" );
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Договор) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор",
			"ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры) В(&Договор)");
		Запрос.УстановитьПараметр("Договор", ДополнительныеРеквизиты.Договор);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор", "ИСТИНА" );
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаИзменениеБалансовойСтоимости = Результат[НомераТаблиц.ИзменениеБалансовойСтоимостиБУ].Выгрузить();
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям();
	
	// Корректировка резерва на сумму изменения балансовой стоимости.
	Для Каждого СтрокаПравПользования Из ТаблицаИзменениеБалансовойСтоимости Цикл
		
		СуммаКорректировки = СтрокаПравПользования.ИзменениеБалансовойСтоимости;
		Если СуммаКорректировки = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СчетРасчетов = СтрокаПравПользования.СчетРасчетов;
		
		КЭКОперации = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(СчетРасчетов);
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетРасчетов);
		
		СодержаниеПроводки = НСтр("ru = 'Изменение Инструкций по учету: корректировка резервов по договорам операционной аренды (балансовая стоимость)'");
		
		НоваяСтрока = ТаблицаПроводок.Добавить();
		НоваяСтрока.КФО = СтрокаПравПользования.КФО;
		Если ИспользоватьУчетПоИФО Тогда
			НоваяСтрока.ИФО = СтрокаПравПользования.ИФО;
		КонецЕсли;
		
		// Дебет.
		НоваяСтрока.СчетДт = СчетРасчетов;
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетДт);
		НоваяСтрока.СубконтоДт1 = БухгалтерскийУчет.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, 1,
			СвойстваСчетаРасчетов.ВидСубконто1, СтрокаПравПользования.КорСубконто1,
			СвойстваСчетаРасчетов.ВидСубконто2, СтрокаПравПользования.КорСубконто2,
			СвойстваСчетаРасчетов.ВидСубконто3, СтрокаПравПользования.КорСубконто3);
		НоваяСтрока.СубконтоДт2 = БухгалтерскийУчет.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, 2,
			СвойстваСчетаРасчетов.ВидСубконто1, СтрокаПравПользования.КорСубконто1,
			СвойстваСчетаРасчетов.ВидСубконто2, СтрокаПравПользования.КорСубконто2,
			СвойстваСчетаРасчетов.ВидСубконто3, СтрокаПравПользования.КорСубконто3);
		НоваяСтрока.СубконтоДт3 = БухгалтерскийУчет.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, 3,
			СвойстваСчетаРасчетов.ВидСубконто1, СтрокаПравПользования.КорСубконто1,
			СвойстваСчетаРасчетов.ВидСубконто2, СтрокаПравПользования.КорСубконто2,
			СвойстваСчетаРасчетов.ВидСубконто3, СтрокаПравПользования.КорСубконто3);
		
		Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
			НоваяСтрока.КПСДт = СтрокаПравПользования.КПСРасчетов;
		КонецЕсли;
		Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			НоваяСтрока.ПодразделениеДт = СтрокаПравПользования.Подразделение;
		КонецЕсли;
		Если СвойстваСчетаРасчетов.Валютный Тогда
			НоваяСтрока.ВалютаДт = СтрокаПравПользования.Валюта;
			Если СтрокаПравПользования.ИзменениеБалансовойСтоимостиВал <> 0 Тогда
				НоваяСтрока.ВалютнаяСуммаДт = СтрокаПравПользования.ИзменениеБалансовойСтоимостиВал * (СуммаКорректировки / СтрокаПравПользования.ИзменениеБалансовойСтоимости);
			КонецЕсли;
		КонецЕсли;
		
		ДанныеПроводки = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
		ДанныеПроводки.Вставить("Организация", СтрокаПравПользования.Организация);
		ДанныеПроводки.Вставить("ИФО", СтрокаПравПользования.ИФО);
		ДанныеПроводки.Вставить("КФО", СтрокаПравПользования.КФО);
		ДанныеПроводки.Вставить("Дата", ДокументОбъект.Дата);
		ДанныеПроводки.Вставить("Счет", НоваяСтрока.СчетДт);
		ДанныеПроводки.Вставить("ДтКт", "Дт");
		ДанныеПроводки.Вставить("Субконто1", НоваяСтрока.СубконтоДт1);
		ДанныеПроводки.Вставить("Субконто2", НоваяСтрока.СубконтоДт2);
		ДанныеПроводки.Вставить("Субконто3", НоваяСтрока.СубконтоДт3);
		ДанныеПроводки.Вставить("КЭКОперации", КЭКОперации);
		НоваяСтрока.КЭКДт = БухгалтерскийУчет.КЭКПроводки(ДанныеПроводки); 
		
		// Кредит.
		НоваяСтрока.СчетКт = ДополнительныеРеквизиты.СчетРезерва;
		БухгалтерскийУчет.УстановитьСубконто(НоваяСтрока, "Кт", "Резервы", ДополнительныеРеквизиты.Резерв);
		БухгалтерскийУчет.УстановитьСубконто(НоваяСтрока, "Кт", "Договоры", СтрокаПравПользования.Договор);
		
		СвойстваСчетаРезервов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
		Если СвойстваСчетаРезервов.УчетПоКПС Тогда
			НоваяСтрока.КПСКт = СтрокаПравПользования.КПСРасчетов;
		КонецЕсли;
		Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаРезервов.УчетПоПодразделениям Тогда
			НоваяСтрока.ПодразделениеКт = СтрокаПравПользования.Подразделение;
		КонецЕсли;
		НоваяСтрока.КЭККт = КЭКОперации; 
		
		НоваяСтрока.Сумма = СуммаКорректировки;
		ЗаполнитьОбщиеРеквизитыПроводки(НоваяСтрока, ДокументОбъект, СодержаниеПроводки);
		
		
		// Отложенные обязательства.
		Если Не ДополнительныеРеквизиты.ОтразитьОтложенныеОбязательства Тогда
			Продолжить;
		КонецЕсли;
		
		СодержаниеПроводки = НСтр("ru = 'Изменение Инструкций по учету: корректировка отложенных обязательств по договорам операционной аренды (балансовая стоимость)'");
		
		НоваяСтрока = ТаблицаПроводок.Добавить();
		НоваяСтрока.КФО = СтрокаПравПользования.КФО;
		Если ИспользоватьУчетПоИФО Тогда
			НоваяСтрока.ИФО = СтрокаПравПользования.ИФО;
		КонецЕсли;
		
		// Дебет.
		Если БухгалтерскиеОперации.ЭтоКазенноеУчреждение(ДокументОбъект.Организация, ДокументОбъект.Дата) Тогда
			НоваяСтрока.СчетДт = БухгалтерскийУчет.СчетПоКоду("501.93", ДокументОбъект.Дата, ДокументОбъект.Организация);
		Иначе
			НоваяСтрока.СчетДт = БухгалтерскийУчет.СчетПоКоду("506.90", ДокументОбъект.Дата, ДокументОбъект.Организация);
		КонецЕсли;
		
		БухгалтерскийУчет.УстановитьСубконто(НоваяСтрока, "Дт", "РазделыЛицевыхСчетов", ДополнительныеРеквизиты.РазделыЛицевыхСчетов);
		
		СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетДт);
		Если СвойстваСчетаДт.УчетПоКПС Тогда
			НоваяСтрока.КПСДт = СтрокаПравПользования.КПСРасчетов;
		КонецЕсли;
		Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаДт.УчетПоПодразделениям Тогда
			НоваяСтрока.ПодразделениеДт = СтрокаПравПользования.Подразделение;
		КонецЕсли;
		Если СвойстваСчетаДт.Валютный Тогда
			НоваяСтрока.ВалютаДт = СтрокаПравПользования.Валюта;
			Если СтрокаПравПользования.ИзменениеБалансовойСтоимостиВал <> 0 Тогда
				НоваяСтрока.ВалютнаяСуммаДт = СтрокаПравПользования.ИзменениеБалансовойСтоимостиВал * (СуммаКорректировки / СтрокаПравПользования.ИзменениеБалансовойСтоимости);
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.КЭКДт = КЭКОперации; 
		
		// Кредит.
		НоваяСтрока.СчетКт = БухгалтерскийУчет.СчетПоКоду("502.99", ДокументОбъект.Дата, ДокументОбъект.Организация);
		БухгалтерскийУчет.УстановитьСубконто(НоваяСтрока, "Кт", "РазделыЛицевыхСчетов", ДополнительныеРеквизиты.РазделыЛицевыхСчетов);
		БухгалтерскийУчет.УстановитьСубконто(НоваяСтрока, "Кт", "ПринятыеОбязательства", СтрокаПравПользования.Договор);
		
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
		Если СвойстваСчетаКт.УчетПоКПС Тогда
			НоваяСтрока.КПСКт = СтрокаПравПользования.КПСРасчетов;
		КонецЕсли;
		Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаКт.УчетПоПодразделениям Тогда
			НоваяСтрока.ПодразделениеКт = СтрокаПравПользования.Подразделение;
		КонецЕсли;
		
		НоваяСтрока.КЭККт = КЭКОперации; 
		
		НоваяСтрока.Сумма = СуммаКорректировки;
		ЗаполнитьОбщиеРеквизитыПроводки(НоваяСтрока, ДокументОбъект, СодержаниеПроводки);
		
	КонецЦикла;
	
	ТаблицаПроводок.ЗаполнитьЗначения(Истина, "Активность");
	
	Возврат ТаблицаПроводок;
	
КонецФункции

