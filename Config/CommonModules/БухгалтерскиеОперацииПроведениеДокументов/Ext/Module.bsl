///////////////////////////////////////////////////////////////////////////////////////////////////////////
// БУХГАЛТЕРСКИЕ ОПЕРАЦИИ, ПРОВЕДЕНИЕ ДОКУМЕНТОВ
// В МОДУЛЕ РЕАЛИЗОВАНЫ ФУНКЦИИ, ФОРМИРУЮЩИЕ БУХГАЛТЕРСКИЕ ПРОВОДКИ БЕЗ ДОПОЛНИТЕЛЬНОЙ НАСТРОЙКИ ПРОВОДОК.
//

// Для формирования таблицы проводок необходимо создать функцию, в которую будут передаваться параметры:
//		- ДокументОбъект - проводимый документ.
//		- СправочникСсылка.ТиповаяОперация - ссылка на типовую операцию.
//		- Структура - содержащая значения дополнительных реквизитов проводки. Ключи структуры
//					  соответствуют имени дополнительного параметра в справочнике типовая операция.
//
// Функция должна формировать таблицу проводок - таблицу значений для загрузки в регистр бухгалтерии.
// Имена колонок совпадают с именами измерений, ресурсов и реквизитов журнала проводок.
//
// Имя функции необходимо добавить в процедуре ПолучитьСписокФункций в СписокФункций.
// И после этого выбрать в типовой операции эту функцию.
//

// Для доступа к дополнительным реквизитам операции следует использовать функцию ЗначениеДопРеквизита 
// (например, ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СчетДт"))
// В функции предусмотрена обработка исключительных ситуаций. При этом если пользователь изменит дополнительные реквизиты,
// при попытке доступа к отсутствующему дополнительному реквизиту, будет сделана соответствующая запись в журнал регистрации,
// но формирование операции продолжится.
// Если доступ к дополнительным реквизитам осуществляется через точку (например, ДополнительныеРеквизиты.СчетДт), 
// то при при попытке доступа к отсутствующему дополнительному реквизиту, формирование операции будет остановлено.
// 

#Область ПрограммныйИнтерфейс

Процедура ПолучитьСписокФункцийДляДокумента(СписокФункций, Документ="") Экспорт
	
	СписокФункций.Очистить();
	Если Документ = "" Тогда
		Возврат;
	КонецЕсли;
	
	ВсеФункции = Новый СписокЗначений;
	ИмяДокумента = Документ + "_";
	ДлинаИмениДокумента = СтрДлина(ИмяДокумента);
	
	// Функции этого модуля
	
	ПолучитьСписокФункций(ВсеФункции);
	Для каждого ТекФункция Из ВсеФункции Цикл
	
		Если Лев(ТекФункция.Значение, ДлинаИмениДокумента) = ИмяДокумента Тогда
			СписокФункций.Добавить(ТекФункция.Значение, ТекФункция.Представление);
		КонецЕсли;
	
	КонецЦикла;
	
	// Функции переопределяемого модуля
	
	ВсеФункции = Новый СписокЗначений;
	БухгалтерскиеОперацииПроведениеДокументовПереопределяемый.ЗаполнитьСписокФункций(ВсеФункции);
	Для каждого ТекФункция Из ВсеФункции Цикл
	
		Если Лев(ТекФункция.Значение, ДлинаИмениДокумента) = ИмяДокумента Тогда
			СписокФункций.Добавить("Переопределяемый." + ТекФункция.Значение, ТекФункция.Представление + " (переопределяемый модуль)");
		КонецЕсли;
	
	КонецЦикла;
	
	// Функции дополнительных модулей / расширений
	
	ДополнительныеМодули = БухгалтерскиеОперацииСервер.ОписанияМодулейРасширений("ФункцииПроведения");
	Если ЗначениеЗаполнено(ДополнительныеМодули) Тогда
		ШаблонЗаголовок  = НСтр("ru = '%1 (из расширения ""%2"")'");
		ОшибкиДопМодулей = Новый Массив;
		Для Каждого ТекущийМодуль Из ДополнительныеМодули Цикл
			
			ИмяТекущегоМодуля = ТекущийМодуль.Ключ;
			
			ВсеФункции = Новый СписокЗначений;
			ОбщийМодуль = ОбщегоНазначения.ОбщийМодуль(ИмяТекущегоМодуля);
			ОбщийМодуль.ЗаполнитьСписокФункций(ВсеФункции);
			
			ФункцииДляПроверки = Новый Массив;
			Для каждого ФункцияМодуля Из ВсеФункции Цикл
				ФункцииДляПроверки.Добавить(ФункцияМодуля.Значение);
			КонецЦикла; 
			ТекстОшибки = "";
			Если НЕ БухгалтерскиеОперацииСервер.ПроверитьИменаПроцедурРасширения(
				ФункцииДляПроверки, ИмяТекущегоМодуля, ТекстОшибки) Тогда
				
				ОшибкиДопМодулей.Добавить(ТекстОшибки);
				Продолжить;
			КонецЕсли;
			
			ШаблонИмяФункции  = "%ИмяМодуля%.%1";
			ШаблонИмяФункции = СтрЗаменить(ШаблонИмяФункции, "%ИмяМодуля%", ИмяТекущегоМодуля);
			Для Каждого ОписаниеФункции Из ВсеФункции Цикл
				
				СписокФункций.Добавить(СтрШаблон(ШаблонИмяФункции, ОписаниеФункции.Значение),
					СтрШаблон(ШаблонЗаголовок, ОписаниеФункции.Представление, ТекущийМодуль.Значение));
					
			КонецЦикла;
			
		КонецЦикла;
		
		Если ОшибкиДопМодулей.Количество() > 0 Тогда
			
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Обнаружены ошибки в объявлениях функций дополнительных источников.
				|%1'"), СтрСоединить(ОшибкиДопМодулей, Символы.ПС + Символы.ПС));
			ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииВычислениеИсточникаДанных(),
				УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки);
			ВызватьИсключение "Обнаружены ошибки в объявлениях функций дополнительных источников.
				|Подробную информацию см. в журнале регистрации";
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

// Процедура заполняет входящий список значений именами реализованых в модуле функций.
// После добавления функции, необходимо добавить ее название в список значений "СписокФункций".
Процедура ПолучитьСписокФункций(СписокФункций) Экспорт

	// ОперацияБух
	СписокФункций.Добавить("ОперацияБух_ЗачетАвансаВыданного", "Зачет аванса выданного");
	СписокФункций.Добавить("ОперацияБух_ЗачетАвансаВыданного_ПоДокументу", "Зачет аванса выданного (по документу поступления)");
	СписокФункций.Добавить("ОперацияБух_ЗачетАвансаПолученного", "Зачет аванса полученного");
	СписокФункций.Добавить("ОперацияБух_ЗачетАвансаПолученного_ПоДокументу", "Зачет аванса полученного (по документу реализации)");
	СписокФункций.Добавить("ОперацияБух_КорректировкаОстатковРасходовНеУчитываемыхПриНалогообложении", "Корректировка остатков расходов, не учитываемых при налогообложении (НУ)");
	СписокФункций.Добавить("ОперацияБух_КорректировкаПоложительныхКурсовыхРазницНУ_2022", "Корректировка положительных курсовых разниц (НУ), возникших с 01.01.2022");
	СписокФункций.Добавить("ОперацияБух_ОперационнаяАрендаФормированиеРезервов_2023", "Операционная аренда, формирование резервов (401.60) на 01.01.2023");
	СписокФункций.Добавить("ОперацияБух_ОперационнаяАрендаКорректировкаРезервов_2023", "Операционная аренда, корректировка резервов (401.60) с 01.01.2023");
	СписокФункций.Добавить("ОперацияБух_СверткаКурсовыхРазницНУ_2022", "Свертка отрицательных и отложенных положительных курсовых разниц (НУ) на 31.12.2022");
	СписокФункций.Добавить("ОперацияБух_ФормированиеФактическойСтоимостиМПЗПриПриобретении", "(устарела) Формирование фактической стоимости МПЗ при приобретении");
	СписокФункций.Добавить("ОперацияБух_ФормированиеФактическойСтоимостиМПЗПриПриобретении_ИК", "(устарела) Формирование фактической стоимости МПЗ при приобретении (ИК)");
	СписокФункций.Добавить("ОперацияБух_НачислениеПроцентовПенейШтрафовКПолучению", "(устарела) Начисление процентов, пеней, штрафов к получению");
	СписокФункций.Добавить("ОперацияБух_НачислениеПроцентовПенейШтрафовКУплате", "(устарела) Начисление процентов, пеней, штрафов к уплате");
	
	// Меню - требование
	СписокФункций.Добавить("МенюТребование_СписаниеПродуктовПитания", "Списание продуктов питания");
	
	// Расчет наценки
	СписокФункций.Добавить("РасчетНаценки_РасчетТорговойНаценки", "Расчет торговой наценки по проданным товарам");
	
	// Ввод начальных остатков
	СписокФункций.Добавить("ВводНачальныхОстатков_ОС", "Ввод начальных остатков ОС и НМА");
	СписокФункций.Добавить("ВводНачальныхОстатков_Счет106хП", "Ввод начальных остатков по счету 106.хП");
	СписокФункций.Добавить("ВводНачальныхОстатков_ДенежныеДокументы", "Ввод начальных остатков по денежным документам");
	СписокФункций.Добавить("ВводНачальныхОстатков_ВходящийНДС", "Ввод начальных остатков входящего НДС");
	СписокФункций.Добавить("ВводНачальныхОстатков_ИмуществоКазны", "Ввод начальных остатков по имуществу казны");
	
	// Расчет базы по налогу на прибыль
	СписокФункций.Добавить("РасчетБазыПоНалогуНаПрибыль_РасчетБазыПоНалогуНаПрибыль", "Расчет налоговой базы по налогу на прибыль");
	
	// Закрытие года
	СписокФункций.Добавить("ЗакрытиеГода_ЗакрытиеГода", "Закрытие года");
	
	// Закрытие года технологическое
	СписокФункций.Добавить("ЗакрытиеГодаТехнологическое_ЗакрытиеГода", "Закрытие года");
	СписокФункций.Добавить("ЗакрытиеГодаТехнологическоеГрупповое_ЗакрытиеГода", "Закрытие года");
	СписокФункций.Добавить("ФормированиеОстатковПоРасчетам_ФормированиеОстатковПоРасчетам", "Закрытие года");
	СписокФункций.Добавить("ЗакрытиеОстатковПоЖурналамСлужебный_ЗакрытиеОстатковПоЖурналамСлужебный", "Закрытие года");

	
	// Перенос вложений в НФА
	СписокФункций.Добавить("ПереносВложенийВНФА_ПереносВложенийВНФА", "(Устарела) Перенос вложений в НФА");
	
	// Начисление амортизации ОС
	СписокФункций.Добавить("НачислениеАмортизацииОС_СформироватьДвиженияБух", "(Устарела) Начисление амортизации ОС и НМА");
	
	// Начисление амортизации ИК
	СписокФункций.Добавить("НачислениеАмортизацииИК_СформироватьДвиженияБух", "(Устарела) Начисление амортизации имущества казны");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Функция вызывается из обработки формирования проводок. Функция получает все необходимые параметры
// и вызывает функцию реализующую логику формирования проводок для конкретной типовой операции. 
Функция ПроведениеПоВнешнейФункции(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизитыОперации, Отказ = Ложь) Экспорт
	
	ДанныеТиповойОперации = БухгалтерскиеОперацииСервер.ДанныеТиповойОперации(ТиповаяОперация, "ИспользуетсяВнешняяПроцедура, ИмяВнешнейПроцедуры");
	
	Если НЕ ДанныеТиповойОперации.ИспользуетсяВнешняяПроцедура Тогда
		Возврат РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().Выгрузить();
	КонецЕсли;
	
	ДополнительныеРеквизиты = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительныеРеквизитыОперации);
	ДополнительныеРеквизиты.Вставить("ТиповаяОперация", ТиповаяОперация);
	
	СоставИмениФункции = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ДанныеТиповойОперации.ИмяВнешнейПроцедуры);
	Если СоставИмениФункции.Количество() = 1 Тогда
	
		// Проверить, что передано имя процедуры-обработчика из этого модуля
		Обработчики = Новый СписокЗначений;
		ПолучитьСписокФункций(Обработчики);
		// Для типовых операций "Обмен данными" может использоваться процедура "ПереносДанных"
		Обработчики.Добавить("ПереносДанных");
		Если Обработчики.НайтиПоЗначению(СоставИмениФункции[0]) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'В процедуру БухгалтерскиеОперацииПроведениеДокументов.ПроведениеПоВнешнейФункции передано имя несуществующей функции
				|%1'"), СоставИмениФункции[0]);
		КонецЕсли;
		ИмяФункции = СтрШаблон("%1(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)",
			СоставИмениФункции[0]);
		ТаблицаПроводок = Вычислить(ИмяФункции);
	Иначе
		
		ДополнительныеМодули = БухгалтерскиеОперацииСервер.ОписанияМодулейРасширений("ФункцииПроведения");
		Если ДополнительныеМодули.Свойство(СоставИмениФункции[0]) Тогда
			ИмяИсполняемогоМодуля = СоставИмениФункции[0];
		Иначе
			ИмяИсполняемогоМодуля = "БухгалтерскиеОперацииПроведениеДокументовПереопределяемый";
		КонецЕсли;
		МодульОбработчика = ОбщегоНазначения.ОбщийМодуль(ИмяИсполняемогоМодуля);
		ТаблицаПроводок = МодульОбработчика.ПроведениеПоВнешнейФункции(СоставИмениФункции[1],
			ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ);
	КонецЕсли;
	
	БухгалтерскиеОперацииСервер.ПроверитьЗаполнениеВидовСубконтоТаблицыПроводок(ТаблицаПроводок);
	
	Возврат ТаблицаПроводок;
	
КонецФункции


// Функция возвращает значение дополнительного реквизита из структуры ДополнительныеРеквизиты, по 
// имени ИмяДопРеквизита.
// Если ключ соответствующий имени отсутствует, то будет сделана запись в журнал регистрации, со статусом "Предупреждение".
// На каждый отсутствующий доп. реквизит будет сделана только одна запись в журнал регистрации в текущем вызове сервера.
// Для отсутствующих ключей возвращает значение Неопределено.
//
Функция ЗначениеДопРеквизита(ДополнительныеРеквизиты, ИмяДопРеквизита)
	
	Возврат БухгалтерскиеОперацииПовтИсп.ЗначениеДопРеквизита(ДополнительныеРеквизиты, ИмяДопРеквизита);
	
КонецФункции

Функция ПримерФункции(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	
	ТекстВозврата = "Получены следующие параметры:
					|Документ объект  = "+ДокументОбъект+"
					|Типовая операция = "+ТиповаяОперация+"
					|Дополнительные реквизиты:";
					
	Для каждого ДопРеквизит Из ДополнительныеРеквизиты Цикл
	
		ТекстВозврата = ТекстВозврата + "
						| - " + ДопРеквизит.Ключ + " - "+ДопРеквизит.Значение;
	
	КонецЦикла; 
					
	ОбщегоНазначения.СообщитьПользователю(НСтр("ru='" + ТекстВозврата + "'"));				
									
	Возврат РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().Выгрузить();
	
КонецФункции

// Функция используется для операций при переносе данных. В качестве таблицы проводок возвращаются текущие проводки.
// Т.е. перепроведение документа не меняет текущих проводок.
//
Функция ПереносДанных(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор",		ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("ПустойВидСубконто",	ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Период,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Активность,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1,
	               |	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1, &ПустойВидСубконто) КАК ВидСубконтоДт1,
