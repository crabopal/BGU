	Запрос.УстановитьПараметр("КФО",								ЗначениеДопРеквизита(ДополнительныеРеквизиты, "КФО"));
	Запрос.УстановитьПараметр("КПС",								ЗначениеДопРеквизита(ДополнительныеРеквизиты, "КПС"));
	
	Запрос.УстановитьПараметр("Счет206", БухгалтерскийУчет.СписокСчетов("206.00", ДокументОбъект.Дата,,
		ДокументОбъект.Организация));
	Запрос.УстановитьПараметр("Счет302", БухгалтерскийУчет.СписокСчетов("302.00", ДокументОбъект.Дата,,
		ДокументОбъект.Организация));
	
	ВалютаРегламентированногоУчета		= Константы.ВалютаРегламентированногоУчета.Получить();
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	ЕстьКурсКратность = ДополнительныеРеквизиты.Свойство("Курс", Курс)
						И ДополнительныеРеквизиты.Свойство("Кратность", Кратность);
	Если ЕстьКурсКратность Тогда
		Если НЕ ЗначениеЗаполнено(Курс) Тогда
			Курс = 1;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Кратность) Тогда
			Кратность = 1;
		КонецЕсли;
	КонецЕсли;
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаРасчетов	= РезультатЗапроса[2].Выгрузить();
	ТаблицаАвансов	= РезультатЗапроса[1].Выгрузить();
	
	Для каждого ТекСтрокаРасчетов Из ТаблицаРасчетов Цикл
	
		ОстатокРасчетов = ТекСтрокаРасчетов.СуммаОстаток;
		
		Отбор = Новый Структура("Счет206, Контрагент, Договор, ИФО, КФО, КПС, Валюта");
		ЗаполнитьЗначенияСвойств(Отбор, ТекСтрокаРасчетов);
		
		СтрокиАвансов = ТаблицаАвансов.НайтиСтроки(Отбор);
		
		Для каждого ТекСтрокаАванса Из СтрокиАвансов Цикл
		
			Если ОстатокРасчетов = 0 Тогда
				Прервать;
			КонецЕсли;
			
			СуммаЗачета = Мин(ОстатокРасчетов, ТекСтрокаАванса.СуммаОстаток);
			
			Если СуммаЗачета = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяПроводка = ТаблицаПроводок.Добавить();
			
			НоваяПроводка.Период 		= ДокументОбъект.Дата;
			НоваяПроводка.Организация	= ДокументОбъект.Организация;
			НоваяПроводка.ИФО 			= ДокументОбъект.ИФО;
			НоваяПроводка.КФО			= ТекСтрокаРасчетов.КФО;
		
			НоваяПроводка.СчетДт        = ТекСтрокаРасчетов.Счет302;
			НоваяПроводка.КПСДт         = ТекСтрокаРасчетов.КПС;
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Контрагенты",	ТекСтрокаРасчетов.Контрагент);
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Договоры",		ТекСтрокаРасчетов.Договор);
			НоваяПроводка.КЭКДт			= БухгалтерскиеОперации.КЭКПроводки(НоваяПроводка.Организация,
																			НоваяПроводка.ИФО,
																			НоваяПроводка.КФО,
																			НоваяПроводка.Период,
																			НоваяПроводка.СчетДт,
																			НоваяПроводка.СубконтоДт1,
																			НоваяПроводка.СубконтоДт2,
																			НоваяПроводка.СубконтоДт3,
																			"Дт");
			
			НоваяПроводка.СчетКт        = ТекСтрокаАванса.Счет206;
			НоваяПроводка.КПСКт         = ТекСтрокаАванса.КПС;
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "Контрагенты",		ТекСтрокаАванса.Контрагент);
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "Договоры",			ТекСтрокаАванса.Договор);
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "ДокументыРасчетов",	ТекСтрокаАванса.ДокументАванса);
			НоваяПроводка.КЭККт         = БухгалтерскиеОперации.КЭКПроводки(НоваяПроводка.Организация,
																			НоваяПроводка.ИФО, 
																			НоваяПроводка.КФО, 
																			НоваяПроводка.Период, 
																			НоваяПроводка.СчетКт, 
																			НоваяПроводка.СубконтоКт1,
																			НоваяПроводка.СубконтоКт2,
																			НоваяПроводка.СубконтоКт3,
																			"Кт");
				
			Если ИспользоватьУчетПоПодразделениям Тогда
				Если ТекСтрокаРасчетов.Счет302УчетПоПодразделениям Тогда
					НоваяПроводка.ПодразделениеДт 	= ТекСтрокаРасчетов.Подразделение;
				КонецЕсли;
				Если ТекСтрокаАванса.Счет206УчетПоПодразделениям Тогда
					НоваяПроводка.ПодразделениеКт 	= ТекСтрокаАванса.Подразделение;
				КонецЕсли;
			КонецЕсли;
		
			Если ИспользоватьВалютныйУчет И ТекСтрокаРасчетов.Счет206Валютный Тогда
				НоваяПроводка.ВалютаДт			= ТекСтрокаРасчетов.Валюта;
				НоваяПроводка.ВалютаКт			= ТекСтрокаРасчетов.Валюта;
				НоваяПроводка.ВалютнаяСуммаДт 	= СуммаЗачета;
				НоваяПроводка.ВалютнаяСуммаКт 	= СуммаЗачета;
				
				Если НЕ ЕстьКурсКратность Тогда
					КурсВалюты = БухгалтерскиеОперацииПовтИсп.ПолучитьКурсВалюты(ТекСтрокаАванса.Валюта, ДокументОбъект.Дата);
					Курс 		= КурсВалюты.Курс;
					Кратность	= КурсВалюты.Кратность;
				КонецЕсли;
				НоваяПроводка.Сумма = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
																СуммаЗачета,
																Новый Структура("Валюта, Курс, Кратность",
																				НоваяПроводка.ВалютаДт,
																				Курс,
																				Кратность),
																Новый Структура("Валюта, Курс, Кратность",
																				ВалютаРегламентированногоУчета,
																				1,
																				1));
			Иначе
				НоваяПроводка.Сумма = СуммаЗачета;
			КонецЕсли;
		
			НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
			НоваяПроводка.Содержание     = НСтр("ru='Зачет аванса выданного'");
			
			НоваяПроводка.ВидПервичногоДокумента 	= НСтр("ru='Справка ф. 0504833'");
			НоваяПроводка.ДатаПервичногоДокумента   = ДокументОбъект.Дата;
			НоваяПроводка.НомерПервичногоДокумента  = "";
			
			ОстатокРасчетов = ОстатокРасчетов - СуммаЗачета;
		
		КонецЦикла; 
		
	
	КонецЦикла; 
	
	ДокументОбъект.СуммаДокумента = ТаблицаПроводок.Итог("Сумма");
	ДокументОбъект.Основание = НСтр("ru='Зачет аванса выданного'");
	                                               
	ТаблицаПроводок.ЗаполнитьЗначения(Истина, "Активность");
	
	Возврат ТаблицаПроводок;
	
КонецФункции	

Функция ОперацияБух_ЗачетАвансаВыданного_ПоДокументу(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	Перем Курс;
	Перем Кратность;
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	ДокументОснование = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ДокументОснование");
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат ТаблицаПроводок;
	КонецЕсли;
	
	СпособЗачетаАвансаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "СпособЗачетаАванса");
	Если СпособЗачетаАвансаДокумента <> Перечисления.СпособыЗачетаАвансов.НеЗачитывать Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='По документу уже зачтен аванс'"));
		Возврат ТаблицаПроводок;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Период,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.НомерСтроки,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Активность,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Организация,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ИФО,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ЖурналОпераций,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВидПервичногоДокумента,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ДатаПервичногоДокумента,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.НомерПервичногоДокумента
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	               |			,
	               |			,
	               |			Регистратор = &Регистратор
	               |				И СчетКт В (&Счет302),
	               |			,
	               |			) КАК ЖурналПроводокЕПСБУДвиженияССубконто";
	Запрос.УстановитьПараметр("Регистратор", ДокументОснование);
	Запрос.УстановитьПараметр("Счет302", БухгалтерскийУчет.СписокСчетов("302.00"));
	ВыборкаДвижений = Запрос.Выполнить().Выгрузить();
	
	ТаблицаАвансов = БухгалтерскиеОперации.ПолучитьТаблицуЗачетаАвансаВыданного(ДокументОбъект.Дата, ДокументОбъект.Организация, ДокументОбъект.ИФО, ,,ДокументОснование.Подразделение,
																					ДокументОснование.Контрагент, ДокументОснование.ДОговор,);
																					
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ЕстьКурсКратность = ДополнительныеРеквизиты.Свойство("Курс", Курс)
						И ДополнительныеРеквизиты.Свойство("Кратность", Кратность);
	Если ЕстьКурсКратность Тогда
		Если НЕ ЗначениеЗаполнено(Курс) Тогда
			Курс = 1;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Кратность) Тогда
			Кратность = 1;
		КонецЕсли;
	КонецЕсли;
																					
	Для каждого ТекДвижение Из ВыборкаДвижений Цикл
		
		СуммаПоСтроке = ТекДвижение.Сумма;
																						
		Для каждого СтрокаАванса Из ТаблицаАвансов Цикл
		
			ТекущийИтератор = ТаблицаАвансов.Индекс(СтрокаАванса);
			
			Период = ДокументОбъект.Дата;
			Организация = ДокументОбъект.Организация;
			ИФО = ДокументОбъект.ИФО;
			КФО			= ТекДвижение.КФО;
			КПС         = ТекДвижение.КПСКт;
			Подразделение = ТекДвижение.ПодразделениеКт;
			Контрагент = ТекДвижение.СубконтоКт1;
			Договор = ТекДвижение.СубконтоКт2;
			СчетДт        = ТекДвижение.СчетКт;
			
			СуммаЗачета = БухгалтерскиеОперации.РеквизитЗачетаАвансаВыданного(СуммаПоСтроке, 
																Период,
																Организация,
																ИФО,
																КФО,
																КПС,
																Подразделение,
																Контрагент, 
																Договор, 
																СчетДт, 
																"СуммаАванса", 
																ТекущийИтератор,
																ТекДвижение.НомерСтроки);
																
			Если СуммаЗачета = 0 Тогда
				Продолжить;
			КонецЕсли;

			НоваяПроводка = ТаблицаПроводок.Добавить();
			
			НоваяПроводка.Период 		= Период;
			НоваяПроводка.Организация	= ДокументОбъект.Организация;
			НоваяПроводка.ИФО 			= ИФО;
			НоваяПроводка.КФО			= КФО;
			
			НоваяПроводка.СчетДт        = СчетДт;
			НоваяПроводка.КПСДт         = КПС;
																		 
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Контрагенты",		Контрагент);
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Договоры",			Договор);
			НоваяПроводка.КЭКДт			= БухгалтерскиеОперации.КЭКПроводки(НоваяПроводка.Организация,
																			НоваяПроводка.ИФО,
																			НоваяПроводка.КФО,
																			НоваяПроводка.Период,
																			НоваяПроводка.СчетДт,
																			НоваяПроводка.СубконтоДт1,
																			НоваяПроводка.СубконтоДт2,
																			НоваяПроводка.СубконтоДт3,
																			"Дт");
			
			НоваяПроводка.СчетКт        = БухгалтерскиеОперации.РеквизитЗачетаАвансаВыданного(ТекДвижение.Сумма, 
																Период,
																Организация,
																ИФО,
																КФО,
																КПС,
																Подразделение,
																Контрагент, 
																Договор, 
																СчетДт, 
																"СчетАванса", 
																ТекущийИтератор,
																ТекДвижение.НомерСтроки);
			НоваяПроводка.КПСКт         = КПС;
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "Контрагенты",		Контрагент);
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "Договоры",			Договор);
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "ДокументыРасчетов",	БухгалтерскиеОперации.РеквизитЗачетаАвансаВыданного(ТекДвижение.Сумма, 
																Период,
																Организация,
																ИФО,
																КФО,
																КПС,
																Подразделение,
																Контрагент, 
																Договор, 
																СчетДт, 
																"ДокументАванса", 
																ТекущийИтератор,
																ТекДвижение.НомерСтроки));
			НоваяПроводка.КЭККт         = БухгалтерскиеОперации.КЭКПроводки(НоваяПроводка.Организация,
																			НоваяПроводка.ИФО, 
																			НоваяПроводка.КФО, 
																			НоваяПроводка.Период, 
																			НоваяПроводка.СчетКт, 
																			НоваяПроводка.СубконтоКт1,
																			НоваяПроводка.СубконтоКт2,
																			НоваяПроводка.СубконтоКт3,
																			"Кт");
			
			Если ИспользоватьУчетПоПодразделениям Тогда
				НоваяПроводка.ПодразделениеДт 	= Подразделение;
				НоваяПроводка.ПодразделениеКт 	= Подразделение;
			КонецЕсли;
		
			Если ИспользоватьВалютныйУчет И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетКт).Валютный Тогда
				НоваяПроводка.ВалютаДт			= ТекДвижение.ВалютаКт;
				НоваяПроводка.ВалютаКт			= ТекДвижение.ВалютаКт;
				НоваяПроводка.ВалютнаяСуммаДт 	= СуммаЗачета;
				НоваяПроводка.ВалютнаяСуммаКт 	= СуммаЗачета;
				
				Если НЕ ЕстьКурсКратность Тогда
					КурсВалюты = БухгалтерскиеОперацииПовтИсп.ПолучитьКурсВалюты(ТекДвижение.ВалютаКт, ДокументОбъект.Дата);
					Курс 		= КурсВалюты.Курс;
					Кратность	= КурсВалюты.Кратность;
				КонецЕсли;
				НоваяПроводка.Сумма = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
																СуммаЗачета,
																Новый Структура("Валюта, Курс, Кратность",
																				НоваяПроводка.ВалютаДт,
																				Курс,
																				Кратность),
																Новый Структура("Валюта, Курс, Кратность",
																				ВалютаРегламентированногоУчета,
																				1,
																				1));
			Иначе
				НоваяПроводка.Сумма = СуммаЗачета;
			КонецЕсли;
		
			НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
			НоваяПроводка.Содержание     = НСтр("ru='Зачет аванса выданного'");
			
			НоваяПроводка.ВидПервичногоДокумента 	= НСтр("ru='Справка ф. 0504833'");
			НоваяПроводка.ДатаПервичногоДокумента   = ДокументОбъект.Дата;
			НоваяПроводка.НомерПервичногоДокумента  = "";
			
			СуммаПоСтроке = СуммаПоСтроке - СуммаЗачета;
		КонецЦикла; 																					
		
																	 
	
	КонецЦикла; 																					
	
	Возврат ТаблицаПроводок;
	
КонецФункции	

Функция ОперацияБух_ЗачетАвансаПолученного(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	Перем Курс;
	Перем Кратность;
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка,
	               |	ПОДСТРОКА(ЕПСБУ.Код, 1, 5) КАК СтрокаСоединения,
	               |	ВЫБОР
	               |		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""А""
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Аванс,
	               |	ЕПСБУ.Валютный
	               |ПОМЕСТИТЬ ВсеСчета
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В (&Счет205)
	               |	И НЕ ЕПСБУ.ЭлементГруппа
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВсеСчета.Ссылка КАК СчетРасчетов,
	               |	ВсеСчета1.Ссылка КАК СчетАвансов,
	               |	ВсеСчета.Валютный КАК СчетРасчетовВалютный,
	               |	ВсеСчета1.Валютный КАК СчетАвансовВалютный
	               |ПОМЕСТИТЬ СоответствиеСчетов
	               |ИЗ
	               |	ВсеСчета КАК ВсеСчета
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВсеСчета КАК ВсеСчета1
	               |		ПО ВсеСчета.СтрокаСоединения = ВсеСчета1.СтрокаСоединения
	               |			И (НЕ ВсеСчета.Аванс)
	               |			И (ВсеСчета1.Аванс)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.Счет,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто1,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто2,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
	               |	ЖурналПроводокЕПСБУОстатки.КФО,
	               |	СУММА(ВЫБОР
	               |			КОГДА &ИспользоватьВалютныйУчет
	               |					И ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |				ТОГДА ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстаток
	               |			ИНАЧЕ ЖурналПроводокЕПСБУОстатки.СуммаОстаток
	               |		КОНЕЦ) КАК Сумма,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьВалютныйУчет
	               |				И ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Валюта
	               |		ИНАЧЕ &ВалютаРегламентированногоУчета
	               |	КОНЕЦ КАК Валюта,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ КАК ИФО,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ КАК Подразделение
	               |ПОМЕСТИТЬ Остатки
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			Счет В
	               |				(ВЫБРАТЬ
	               |					СоответствиеСчетов.СчетРасчетов
	               |				ИЗ
	               |					СоответствиеСчетов
	               |			
	               |				ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |				ВЫБРАТЬ
	               |					СоответствиеСчетов.СчетАвансов
	               |				ИЗ
	               |					СоответствиеСчетов),
	               |			,
	               |			Организация = &Организация
	               |				И КФО = &КФО
	               |				И КПС = &КПС
	               |				//И ИФО = &ИФО
	               |				//И Подразделение = &Подразделение
	               |				//И Субконто2 = &Договор
	               |				И Субконто1 = &Контрагент) КАК ЖурналПроводокЕПСБУОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЖурналПроводокЕПСБУОстатки.Счет,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто1,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто2,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
	               |	ЖурналПроводокЕПСБУОстатки.КФО,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьВалютныйУчет
	               |				И ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Валюта
	               |		ИНАЧЕ &ВалютаРегламентированногоУчета
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.Счет Как СчетРасчетов,
	               |	ВложенныйЗапрос.Субконто1 Как Контрагент,
	               |	ВложенныйЗапрос.Субконто2 Как Договор,
	               |	ВложенныйЗапрос.КПС,
	               |	ВложенныйЗапрос.КФО,
	               |	ВложенныйЗапрос.Сумма,
	               |	ВложенныйЗапрос.Валюта,
	               |	ВложенныйЗапрос.ИФО,
	               |	ВложенныйЗапрос.Подразделение,
	               |	ВложенныйЗапрос.СчетАвансов,
	               |	ВложенныйЗапрос.СчетРасчетовВалютный,
	               |	ВложенныйЗапрос.СчетАвансовВалютный,
	               |	ВложенныйЗапрос1.Сумма КАК СуммаАвансаВсего
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		Остатки.Счет КАК Счет,
	               |		Остатки.Субконто1 КАК Субконто1,
	               |		Остатки.Субконто2 КАК Субконто2,
	               |		Остатки.КПС КАК КПС,
	               |		Остатки.КФО КАК КФО,
	               |		Остатки.Сумма КАК Сумма,
	               |		Остатки.Валюта КАК Валюта,
	               |		Остатки.ИФО КАК ИФО,
	               |		Остатки.Подразделение КАК Подразделение,
	               |		СоответствиеСчетов.СчетАвансов КАК СчетАвансов,
	               |		СоответствиеСчетов.СчетРасчетовВалютный КАК СчетРасчетовВалютный,
	               |		СоответствиеСчетов.СчетАвансовВалютный КАК СчетАвансовВалютный
	               |	ИЗ
	               |		Остатки КАК Остатки
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоответствиеСчетов КАК СоответствиеСчетов
	               |			ПО Остатки.Счет = СоответствиеСчетов.СчетРасчетов) КАК ВложенныйЗапрос
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			Остатки.Счет КАК Счет,
	               |			Остатки.Субконто1 КАК Субконто1,
	               |			Остатки.Субконто2 КАК Субконто2,
	               |			Остатки.КПС КАК КПС,
	               |			Остатки.КФО КАК КФО,
	               |			СУММА(-Остатки.Сумма) КАК Сумма,
	               |			Остатки.Валюта КАК Валюта,
	               |			Остатки.ИФО КАК ИФО,
	               |			Остатки.Подразделение КАК Подразделение
	               |		ИЗ
	               |			Остатки КАК Остатки
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			Остатки.Счет,
	               |			Остатки.Субконто1,
	               |			Остатки.Субконто2,
	               |			Остатки.КПС,
	               |			Остатки.КФО,
	               |			Остатки.Валюта,
	               |			Остатки.ИФО,
	               |			Остатки.Подразделение) КАК ВложенныйЗапрос1
	               |		ПО ВложенныйЗапрос.Субконто1 = ВложенныйЗапрос1.Субконто1
	               |			И ВложенныйЗапрос.Субконто2 = ВложенныйЗапрос1.Субконто2
	               |			И ВложенныйЗапрос.КПС = ВложенныйЗапрос1.КПС
	               |			И ВложенныйЗапрос.КФО = ВложенныйЗапрос1.КФО
	               |			И ВложенныйЗапрос.Валюта = ВложенныйЗапрос1.Валюта
	               |			И ВложенныйЗапрос.ИФО = ВложенныйЗапрос1.ИФО
	               |			И ВложенныйЗапрос.Подразделение = ВложенныйЗапрос1.Подразделение
	               |			И ВложенныйЗапрос.СчетАвансов = ВложенныйЗапрос1.Счет";
	ИспользоватьУчетПоИФО 				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
										И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("205.00").УчетПоПодразделениям;
	ИспользоватьВалютныйУчет			= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");	
	ВалютаРегламентированногоУчета 		= Константы.ВалютаРегламентированногоУчета.Получить();
	Запрос.УстановитьПараметр("Период",								?(ДокументОбъект.Ссылка.Пустая(),
																	  КонецДня(ДокументОбъект.Дата),
																	  ДокументОбъект.Дата));				   
	Запрос.УстановитьПараметр("Организация",						ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Контрагент",							ЗначениеДопРеквизита(ДополнительныеРеквизиты,"Контрагент"));
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", 				ИспользоватьУчетПоИФО);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет", 			ИспользоватьВалютныйУчет);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета",		ВалютаРегламентированногоУчета);
	Запрос.УстановитьПараметр("Счет205",							БухгалтерскийУчет.СписокСчетов("205.00",
		ДокументОбъект.Дата,,ДокументОбъект.Организация));
	Если ЗначениеДопРеквизита(ДополнительныеРеквизиты, "Договор") <> Неопределено
		И ЗначениеЗаполнено(ЗначениеДопРеквизита(ДополнительныеРеквизиты, "Договор")) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//И Субконто2 = &Договор", "И Субконто2 = &Договор");	
		Запрос.УстановитьПараметр("Договор",ЗначениеДопРеквизита(ДополнительныеРеквизиты, "Договор"));
	КонецЕсли;
	Запрос.УстановитьПараметр("КФО",ЗначениеДопРеквизита(ДополнительныеРеквизиты, "КФО"));
	Запрос.УстановитьПараметр("КПС",ЗначениеДопРеквизита(ДополнительныеРеквизиты, "КПС"));
	Если ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//И ИФО = &ИФО", "И ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО",ДокументОбъект.ИФО);
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//И Подразделение = &Подразделение", "И Подразделение = &Подразделение");
		Запрос.УстановитьПараметр("Подразделение",ЗначениеДопРеквизита(ДополнительныеРеквизиты, "Подразделение"));
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат ТаблицаПроводок;
	КонецЕсли;
	
	ТаблицаЗачтенныхАвансов = Новый ТаблицаЗначений;
	ТаблицаЗачтенныхАвансов.Колонки.Добавить("СчетАвансов", 	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаЗачтенныхАвансов.Колонки.Добавить("Договор", 		Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаЗачтенныхАвансов.Колонки.Добавить("Подразделение",	Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаЗачтенныхАвансов.Колонки.Добавить("Валюта", 			Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаЗачтенныхАвансов.Колонки.Добавить("СуммаАванса", 	Новый ОписаниеТипов("Число"));
	
	Авансы = Результат.Выгрузить();
	
	ЕстьКурсКратность = ДополнительныеРеквизиты.Свойство("Курс", Курс)
						И ДополнительныеРеквизиты.Свойство("Кратность", Кратность);
	Если ЕстьКурсКратность Тогда
		Если НЕ ЗначениеЗаполнено(Курс) Тогда
			Курс = 1;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Кратность) Тогда
			Кратность = 1;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ТекАванс Из Авансы Цикл
		
		СуммаЗачтенныхАвансов = ТаблицаЗачтенныхАвансов.Скопировать(Новый Структура("СчетАвансов,Договор,"
																					+"Подразделение,Валюта",
																					ТекАванс.СчетАвансов,
																					ТекАванс.Договор,
																					ТекАванс.Подразделение,
																					ТекАванс.Валюта),
																	"СуммаАванса").Итог("СуммаАванса");
		СуммаЗачета = Мин(Макс(ТекАванс.СуммаАвансаВсего - СуммаЗачтенныхАвансов), ТекАванс.Сумма);
		Если СуммаЗачета = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		
		НоваяПроводка = ТаблицаПроводок.Добавить();
		
		НоваяПроводка.Период 		= ДокументОбъект.Дата;
		НоваяПроводка.Организация	= ДокументОбъект.Организация;
		НоваяПроводка.ИФО 			= ДокументОбъект.ИФО;
		НоваяПроводка.КФО			= ТекАванс.КФО;
		
		НоваяПроводка.СчетДт        = ТекАванс.СчетАвансов;
		НоваяПроводка.КПСДт         = ТекАванс.КПС;
		НоваяПроводка.СубконтоДт1	= ТекАванс.Контрагент;
		НоваяПроводка.СубконтоДт2	= ТекАванс.Договор;
		НоваяПроводка.КЭКДт			= БухгалтерскиеОперации.КЭКПроводки(НоваяПроводка.Организация,
																		НоваяПроводка.ИФО,
																		НоваяПроводка.КФО,
																		НоваяПроводка.Период,
																		НоваяПроводка.СчетДт,
																		НоваяПроводка.СубконтоДт1,
																		НоваяПроводка.СубконтоДт2,
																		НоваяПроводка.СубконтоДт3,
																		"Дт");
		
		НоваяПроводка.СчетКт        = ТекАванс.СчетРасчетов;
		НоваяПроводка.КПСКт         = ТекАванс.КПС;
		НоваяПроводка.СубконтоКт1	= ТекАванс.Контрагент;
		НоваяПроводка.СубконтоКт2	= ТекАванс.Договор;
		НоваяПроводка.КЭККт         = БухгалтерскиеОперации.КЭКПроводки(НоваяПроводка.Организация,
																		НоваяПроводка.ИФО, 
																		НоваяПроводка.КФО, 
																		НоваяПроводка.Период, 
																		НоваяПроводка.СчетКт, 
																		НоваяПроводка.СубконтоКт1,
																		НоваяПроводка.СубконтоКт2,
																		НоваяПроводка.СубконтоКт3,
																		"Кт");
		
		Если ИспользоватьУчетПоПодразделениям Тогда
			НоваяПроводка.ПодразделениеДт 	= ТекАванс.Подразделение;
			НоваяПроводка.ПодразделениеКт 	= ТекАванс.Подразделение;
		КонецЕсли;
		
		Если ИспользоватьВалютныйУчет
			И ТекАванс.СчетРасчетовВалютный Тогда
			НоваяПроводка.ВалютаДт			= ТекАванс.Валюта;
			НоваяПроводка.ВалютаКт			= ТекАванс.Валюта;
			НоваяПроводка.ВалютнаяСуммаДт 	= СуммаЗачета;
			НоваяПроводка.ВалютнаяСуммаКт 	= СуммаЗачета;
			
			Если НЕ ЕстьКурсКратность Тогда
				КурсВалюты = БухгалтерскиеОперацииПовтИсп.ПолучитьКурсВалюты(ТекАванс.Валюта, ДокументОбъект.Дата);
				Курс 		= КурсВалюты.Курс;
				Кратность	= КурсВалюты.Кратность;
			КонецЕсли;
			НоваяПроводка.Сумма = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
															СуммаЗачета,
															Новый Структура("Валюта, Курс, Кратность",
																			НоваяПроводка.ВалютаДт,
																			Курс,
																			Кратность),
															Новый Структура("Валюта, Курс, Кратность",
																			ВалютаРегламентированногоУчета,
																			1,
																			1));
		Иначе
			НоваяПроводка.Сумма = СуммаЗачета;
		КонецЕсли;			
		
		ЗачтенныйАванс = ТаблицаЗачтенныхАвансов.Добавить();
		ЗаполнитьЗначенияСвойств(ЗачтенныйАванс, ТекАванс, "СчетАвансов,Договор,Подразделение,Валюта");
		ЗачтенныйАванс.СуммаАванса = СуммаЗачета;
		
		НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
		НоваяПроводка.Содержание     = НСтр("ru='Зачет аванса полученного'");
		
		НоваяПроводка.ВидПервичногоДокумента 	= НСтр("ru='Справка ф. 0504833'");
		НоваяПроводка.ДатаПервичногоДокумента   = ДокументОбъект.Дата;
		НоваяПроводка.НомерПервичногоДокумента  = "";
		
	КонецЦикла;                                          
	
	ДокументОбъект.СуммаДокумента = ТаблицаПроводок.Итог("Сумма");
	ДокументОбъект.Основание = НСтр("ru='Зачет аванса выданного'");
	                                               
	ТаблицаПроводок.ЗаполнитьЗначения(Истина, "Активность");
	
	Возврат ТаблицаПроводок;
				   
КонецФункции

Функция ОперацияБух_ЗачетАвансаПолученного_ПоДокументу(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	Перем Курс;
	Перем Кратность;
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	ДокументОснование = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ДокументОснование");
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат ТаблицаПроводок;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИСТИНА КАК Поле1
	               |ИЗ
	               |	РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
	               |ГДЕ
	               |	ЗначенияДополнительныхРеквизитовОпераций.Объект = &ДокументОснование
	               |	И ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации.ИмяДляФормулы ПОДОБНО &ИмяДляФормулы
	               |	И ЗначенияДополнительныхРеквизитовОпераций.Значение = &Значение";
	Запрос.УстановитьПараметр("ДокументОснование",	ДокументОснование);				   
	Запрос.УстановитьПараметр("ИмяДляФормулы", 		"НеЗачитыватьАванс");				   
	Запрос.УстановитьПараметр("Значение", 			Ложь);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='По документу уже зачтен аванс'"));
		Возврат ТаблицаПроводок;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка,
	               |	ПОДСТРОКА(ЕПСБУ.Код, 1, 5) КАК СтрокаСоединения,
	               |	ВЫБОР
	               |		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""А""
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Аванс,
	               |	ЕПСБУ.Валютный
	               |ПОМЕСТИТЬ ВсеСчета
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В (&Счет205)
	               |	И НЕ ЕПСБУ.ЭлементГруппа
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВсеСчета.Ссылка КАК СчетРасчетов,
	               |	ВсеСчета1.Ссылка КАК СчетАвансов,
	               |	ВсеСчета.Валютный КАК СчетРасчетовВалютный,
	               |	ВсеСчета1.Валютный КАК СчетАвансовВалютный
	               |ПОМЕСТИТЬ СоответствиеСчетов
	               |ИЗ
	               |	ВсеСчета КАК ВсеСчета
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВсеСчета КАК ВсеСчета1
	               |		ПО ВсеСчета.СтрокаСоединения = ВсеСчета1.СтрокаСоединения
	               |			И (НЕ ВсеСчета.Аванс)
	               |			И (ВсеСчета1.Аванс)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ИФО,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ КАК ПодразделениеДт,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ КАК ПодразделениеКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Период,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Организация
	               |ПОМЕСТИТЬ Движения
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(, , Регистратор = &Регистратор, , ) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.СчетРасчетов,
	               |	ВложенныйЗапрос.Субконто1,
	               |	ВложенныйЗапрос.Субконто2,
	               |	ВложенныйЗапрос.КПС,
	               |	ВложенныйЗапрос.ИФО,
	               |	ВложенныйЗапрос.КФО,
	               |	ВложенныйЗапрос.Валюта,
	               |	ВложенныйЗапрос.Подразделение,
	               |	ВложенныйЗапрос.СуммаРасчетов,
	               |	ВложенныйЗапрос.СчетАвансов,
	               |	ЕСТЬNULL(Движения.СуммаАванса, 0) КАК СуммаАванса,
	               |	ВложенныйЗапрос.Период,
	               |	ВложенныйЗапрос.Организация,
				   |	ВложенныйЗапрос.СчетРасчетовВалютный
	               |ПОМЕСТИТЬ ДвиженияСАвансами
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		Движения.СчетДт КАК СчетРасчетов,
	               |		Движения.СубконтоДт1 КАК Субконто1,
	               |		Движения.СубконтоДт2 КАК Субконто2,
	               |		Движения.КПСДт КАК КПС,
	               |		Движения.ИФО КАК ИФО,
	               |		Движения.КФО КАК КФО,
	               |		ВЫБОР
	               |			КОГДА &ИспользоватьВалютныйУчет
	               |					И СоответствиеСчетов.СчетРасчетовВалютный
	               |				ТОГДА Движения.ВалютаДт
	               |			ИНАЧЕ &ВалютаРегламентированногоУчета
	               |		КОНЕЦ КАК Валюта,
	               |		Движения.ПодразделениеДт КАК Подразделение,
	               |		ВЫБОР
	               |			КОГДА &ИспользоватьВалютныйУчет
	               |					И СоответствиеСчетов.СчетРасчетовВалютный
	               |				ТОГДА Движения.ВалютнаяСуммаДт
	               |			ИНАЧЕ Движения.Сумма
	               |		КОНЕЦ КАК СуммаРасчетов,
	               |		СоответствиеСчетов.СчетАвансов КАК СчетАвансов,
	               |		СоответствиеСчетов.СчетРасчетовВалютный КАК СчетРасчетовВалютный,
	               |		СоответствиеСчетов.СчетАвансовВалютный КАК СчетАвансовВалютный,
	               |		Движения.Период КАК Период,
	               |		Движения.Организация КАК Организация
	               |	ИЗ
	               |		Движения КАК Движения
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоответствиеСчетов КАК СоответствиеСчетов
	               |			ПО Движения.СчетДт = СоответствиеСчетов.СчетРасчетов) КАК ВложенныйЗапрос
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			Движения.СчетДт КАК СчетДт,
	               |			Движения.СубконтоДт1 КАК Субконто1,
	               |			Движения.СубконтоДт2 КАК Субконто2,
	               |			Движения.КПСДт КАК КПС,
	               |			ВЫБОР
	               |				КОГДА &ИспользоватьУчетПоИФО
	               |					ТОГДА Движения.ИФО
	               |				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |			КОНЕЦ КАК ИФО,
	               |			Движения.КФО КАК КФО,
	               |			Движения.ПодразделениеДт КАК Подразделение,
	               |			ВЫБОР
	               |				КОГДА &ИспользоватьВалютныйУчет
	               |						И ВложенныйЗапрос.СчетАвансовВалютный
	               |					ТОГДА Движения.ВалютаДт
	               |				ИНАЧЕ &ВалютаРегламентированногоУчета
	               |			КОНЕЦ КАК Валюта,
	               |			ВЫБОР
	               |				КОГДА &ИспользоватьВалютныйУчет
	               |						И ВложенныйЗапрос.СчетАвансовВалютный
	               |					ТОГДА Движения.ВалютнаяСуммаДт
	               |				ИНАЧЕ Движения.Сумма
	               |			КОНЕЦ КАК СуммаАванса,
	               |			Движения.Период КАК Период
	               |		ИЗ
	               |			Движения КАК Движения
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |					СоответствиеСчетов.СчетАвансов КАК СчетАвансов,
	               |					СоответствиеСчетов.СчетАвансовВалютный КАК СчетАвансовВалютный
	               |				ИЗ
	               |					СоответствиеСчетов КАК СоответствиеСчетов) КАК ВложенныйЗапрос
	               |				ПО Движения.СчетДт = ВложенныйЗапрос.СчетАвансов) КАК Движения
	               |		ПО ВложенныйЗапрос.СчетАвансов = Движения.СчетДт
	               |			И ВложенныйЗапрос.КФО = Движения.КФО
	               |			И ВложенныйЗапрос.Субконто1 = Движения.Субконто1
	               |			И ВложенныйЗапрос.Субконто2 = Движения.Субконто2
	               |			И ВложенныйЗапрос.КПС = Движения.КПС
	               |			И ВложенныйЗапрос.ИФО = Движения.ИФО
	               |			И ВложенныйЗапрос.Подразделение = Движения.Подразделение
	               |			И ВложенныйЗапрос.Валюта = Движения.Валюта
	               |ГДЕ
	               |	ЕСТЬNULL(Движения.СуммаАванса, 0) <> ВложенныйЗапрос.СуммаРасчетов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ДвиженияСАвансами.СчетАвансов,
	               |	ДвиженияСАвансами.Субконто1 КАК Контрагент,
	               |	ДвиженияСАвансами.Субконто2 КАК Договор,
	               |	ДвиженияСАвансами.КПС,
	               |	ДвиженияСАвансами.ИФО,
	               |	ДвиженияСАвансами.КФО,
	               |	ДвиженияСАвансами.Валюта,
	               |	ДвиженияСАвансами.Подразделение,
	               |	ДвиженияСАвансами.Период,
	               |	ДвиженияСАвансами.Организация
	               |ИЗ
	               |	ДвиженияСАвансами КАК ДвиженияСАвансами";
	ИспользоватьУчетПоИФО 				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");				   
	ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
										И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("205.00").УчетПоПодразделениям;
	ИспользоватьВалютныйУчет 			= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет")
										И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("205.00").Валютный;
	ВалютаРегламентированногоУчета 		= Константы.ВалютаРегламентированногоУчета.Получить();
	
	Запрос.УстановитьПараметр("Регистратор", ДокументОснование);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО",				ИспользоватьУчетПоИФО);
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет",			ИспользоватьВалютныйУчет);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета",		ВалютаРегламентированногоУчета);
	Запрос.УстановитьПараметр("Счет205",							БухгалтерскийУчет.СписокСчетов("205.00",
		ДокументОбъект.Дата,,ДокументОбъект.Организация));	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='По документу уже зачтен аванс'"));
		Возврат ТаблицаПроводок;
	КонецЕсли;
				   
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.Счет,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто1,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто2,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ КАК ИФО,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ КАК Подразделение,
	               |	ЖурналПроводокЕПСБУОстатки.Валюта КАК Валюта,
	               |	ЖурналПроводокЕПСБУОстатки.КФО,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт,
	               |	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт
	               |ПОМЕСТИТЬ Остатки
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			//УсловиеСчета
				   |			,
	               |			,
	               |			Организация = &Организация
	               |			//ПараметрыОстатков
				   |			) КАК ЖурналПроводокЕПСБУОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДвиженияСАвансами.СчетРасчетов,
	               |	ДвиженияСАвансами.Субконто1 Как Контрагент,
	               |	ДвиженияСАвансами.Субконто2 Как Договор,
	               |	ДвиженияСАвансами.КПС,
	               |	ДвиженияСАвансами.ИФО,
	               |	ДвиженияСАвансами.КФО,
	               |	ДвиженияСАвансами.Валюта,
	               |	ДвиженияСАвансами.Подразделение,
	               |	ДвиженияСАвансами.СуммаРасчетов - ДвиженияСАвансами.СуммаАванса КАК НезачтенныйАванс,
	               |	ДвиженияСАвансами.СчетАвансов,
	               |	ОстаткиАвансов.ОстатокАванса,
				   |	ДвиженияСАвансами.СчетРасчетовВалютный
	               |ИЗ
	               |	ДвиженияСАвансами КАК ДвиженияСАвансами
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			Остатки.Счет КАК Счет,
	               |			Остатки.Субконто1 КАК Субконто1,
	               |			Остатки.Субконто2 КАК Субконто2,
	               |			Остатки.КПС КАК КПС,
	               |			Остатки.ИФО КАК ИФО,
	               |			Остатки.Подразделение КАК Подразделение,
	               |			ВЫБОР
	               |				КОГДА &ИспользоватьВалютныйУчет
	               |						И ВложенныйЗапрос.СчетАвансовВалютный
	               |					ТОГДА Остатки.Валюта
	               |				ИНАЧЕ &ВалютаРегламентированногоУчета
	               |			КОНЕЦ КАК Валюта,
	               |			Остатки.КФО КАК КФО,
	               |			ВЫБОР
	               |				КОГДА &ИспользоватьВалютныйУчет
	               |						И ВложенныйЗапрос.СчетАвансовВалютный
	               |					ТОГДА Остатки.ВалютнаяСуммаОстатокКт
	               |				ИНАЧЕ Остатки.СуммаОстатокКт
	               |			КОНЕЦ КАК ОстатокАванса
	               |		ИЗ
	               |			Остатки КАК Остатки
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |					СоответствиеСчетов.СчетАвансов КАК СчетАвансов,
	               |					СоответствиеСчетов.СчетАвансовВалютный КАК СчетАвансовВалютный
	               |				ИЗ
	               |					СоответствиеСчетов КАК СоответствиеСчетов) КАК ВложенныйЗапрос
	               |				ПО Остатки.Счет = ВложенныйЗапрос.СчетАвансов) КАК ОстаткиАвансов
	               |		ПО ДвиженияСАвансами.СчетАвансов = ОстаткиАвансов.Счет
	               |			И ДвиженияСАвансами.Субконто1 = ОстаткиАвансов.Субконто1
	               |			И ДвиженияСАвансами.Субконто2 = ОстаткиАвансов.Субконто2
	               |			И ДвиженияСАвансами.КПС = ОстаткиАвансов.КПС
	               |			И ДвиженияСАвансами.ИФО = ОстаткиАвансов.ИФО
	               |			И ДвиженияСАвансами.КФО = ОстаткиАвансов.КФО
	               |			И ДвиженияСАвансами.Валюта = ОстаткиАвансов.Валюта
	               |			И ДвиженияСАвансами.Подразделение = ОстаткиАвансов.Подразделение";
		
	ВременныйРезультат = РезультатЗапроса.Выгрузить();
	Запрос.УстановитьПараметр("Период", 		ВременныйРезультат[0].Период); 
	Запрос.УстановитьПараметр("Организация",	ВременныйРезультат[0].Организация); 
	Если ВременныйРезультат.Количество() = 1 Тогда
		СтрокаРезультата = ВременныйРезультат[0];
		УсловиеСчета = "Счет = &Счет";
		ПараметрыОстатков = "И Субконто1 = &Контрагент
							|И Субконто2 = &Договор
							|И КПС = &КПС
							|И КФО = &КФО";
		Запрос.УстановитьПараметр("Контрагент",	СтрокаРезультата.Контрагент);							
		Запрос.УстановитьПараметр("Договор", 	СтрокаРезультата.Договор);							
		Запрос.УстановитьПараметр("КПС", 		СтрокаРезультата.КПС);							
		Запрос.УстановитьПараметр("КФО", 		СтрокаРезультата.КФО);
		Запрос.УстановитьПараметр("Счет", 		СтрокаРезультата.СчетАвансов);
		Если ИспользоватьУчетПоИФО Тогда
			ПараметрыОстатков = ПараметрыОстатков + "
							|И ИФО = &ИФО";
			Запрос.УстановитьПараметр("ИФО", СтрокаРезультата.ИФО);
		КонецЕсли;
		Если ИспользоватьУчетПоПодразделениям Тогда
			ПараметрыОстатков = ПараметрыОстатков + "
							|И Подразделение = &Подразделение";
			Запрос.УстановитьПараметр("Подразделение", СтрокаРезультата.Подразделение);
		КонецЕсли;
	Иначе
		УсловиеСчета = "Счет В (&Счет)";
		ПараметрыОстатков = "И Субконто1 В (&Контрагент)
							|И Субконто2 В (&Договор)
							|И КПС В (&КПС)
							|И КФО В (&КФО)";
		Запрос.УстановитьПараметр("Контрагент",	ВременныйРезультат.ВыгрузитьКолонку("Контрагент"));							
		Запрос.УстановитьПараметр("Договор", 	ВременныйРезультат.ВыгрузитьКолонку("Договор"));							
		Запрос.УстановитьПараметр("КПС", 		ВременныйРезультат.ВыгрузитьКолонку("КПС"));							
		Запрос.УстановитьПараметр("КФО", 		ВременныйРезультат.ВыгрузитьКолонку("КФО"));
		Запрос.УстановитьПараметр("Счет", 		ВременныйРезультат.ВыгрузитьКолонку("СчетАвансов"));
		Если ИспользоватьВалютныйУчет Тогда
			ПараметрыОстатков = ПараметрыОстатков + "
							|И Валюта В (&Валюта)";
			Запрос.УстановитьПараметр("Валюта", ВременныйРезультат.ВыгрузитьКолонку("Валюта"));
		КонецЕсли;
		Если ИспользоватьУчетПоИФО Тогда
			ПараметрыОстатков = ПараметрыОстатков + "
							|И ИФО В (&ИФО)";
			Запрос.УстановитьПараметр("ИФО", ВременныйРезультат.ВыгрузитьКолонку("ИФО"));
		КонецЕсли;
		Если ИспользоватьУчетПоПодразделениям Тогда
			ПараметрыОстатков = ПараметрыОстатков + "
							|И Подразделение В (&Подразделение)";
			Запрос.УстановитьПараметр("Подразделение", ВременныйРезультат.ВыгрузитьКолонку("Подразделение"));
		КонецЕсли;
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//УсловиеСчета", УсловиеСчета);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ПараметрыОстатков", ПараметрыОстатков);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Отстутствуют остатки авансов'"));
		Возврат ТаблицаПроводок;
	КонецЕсли;
	
	ЕстьКурсКратность = ДополнительныеРеквизиты.Свойство("Курс", Курс)
						И ДополнительныеРеквизиты.Свойство("Кратность", Кратность);
	Если ЕстьКурсКратность Тогда
		Если НЕ ЗначениеЗаполнено(Курс) Тогда
			Курс = 1;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Кратность) Тогда
			Кратность = 1;
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаЗачтенныхАвансов = Новый ТаблицаЗначений;
	ТаблицаЗачтенныхАвансов.Колонки.Добавить("СчетАвансов", 	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаЗачтенныхАвансов.Колонки.Добавить("Договор", 		Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаЗачтенныхАвансов.Колонки.Добавить("Подразделение",	Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаЗачтенныхАвансов.Колонки.Добавить("Валюта", 			Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаЗачтенныхАвансов.Колонки.Добавить("СуммаАванса", 	Новый ОписаниеТипов("Число"));
	
	Авансы = Результат.Выгрузить();
	Для каждого ТекАванс Из Авансы Цикл
		
		СуммаЗачтенныхАвансов = ТаблицаЗачтенныхАвансов.Скопировать(Новый Структура("СчетАвансов, Договор,"
																					+"Подразделение,Валюта",
																					ТекАванс.СчетАвансов,
																					ТекАванс.Договор,
																					ТекАванс.Подразделение,
																					ТекАванс.Валюта),
																	"СуммаАванса").Итог("СуммаАванса");
		СуммаЗачета = Мин(Макс(ТекАванс.ОстатокАванса - СуммаЗачтенныхАвансов, 0), ТекАванс.НезачтенныйАванс);
		Если СуммаЗачета = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяПроводка = ТаблицаПроводок.Добавить();
		
		НоваяПроводка.Период 		= ДокументОбъект.Дата;
		НоваяПроводка.Организация	= ДокументОбъект.Организация;
		НоваяПроводка.ИФО 			= ДокументОбъект.ИФО;
		НоваяПроводка.КФО			= ТекАванс.КФО;
		
		НоваяПроводка.СчетДт        = ТекАванс.СчетРасчетов;
		НоваяПроводка.КПСДт         = ТекАванс.КПС;
		НоваяПроводка.СубконтоДт1	= ТекАванс.Контрагент;
		НоваяПроводка.СубконтоДт2	= ТекАванс.Договор;
		НоваяПроводка.КЭКДт			= БухгалтерскиеОперации.КЭКПроводки(НоваяПроводка.Организация,
																		НоваяПроводка.ИФО,
																		НоваяПроводка.КФО,
																		НоваяПроводка.Период,
																		НоваяПроводка.СчетДт,
																		НоваяПроводка.СубконтоДт1,
																		НоваяПроводка.СубконтоДт2,
																		НоваяПроводка.СубконтоДт3,
																		"Дт");
		
		НоваяПроводка.СчетКт        = ТекАванс.СчетАвансов;
		НоваяПроводка.КПСКт         = ТекАванс.КПС;
		НоваяПроводка.СубконтоКт1	= ТекАванс.Контрагент;
		НоваяПроводка.СубконтоКт2	= ТекАванс.Договор;
		НоваяПроводка.КЭККт         = БухгалтерскиеОперации.КЭКПроводки(НоваяПроводка.Организация,
																		НоваяПроводка.ИФО, 
																		НоваяПроводка.КФО, 
																		НоваяПроводка.Период, 
																		НоваяПроводка.СчетКт, 
																		НоваяПроводка.СубконтоКт1,
																		НоваяПроводка.СубконтоКт2,
																		НоваяПроводка.СубконтоКт3,
																		"Кт");
		
		Если ИспользоватьУчетПоПодразделениям Тогда
			НоваяПроводка.ПодразделениеДт 	= ТекАванс.Подразделение;
			НоваяПроводка.ПодразделениеКт 	= ТекАванс.Подразделение;
		КонецЕсли;
		
		Если ИспользоватьВалютныйУчет
			И ТекАванс.СчетРасчетовВалютный Тогда
			НоваяПроводка.ВалютаДт			= ТекАванс.Валюта;
			НоваяПроводка.ВалютаКт			= ТекАванс.Валюта;
			НоваяПроводка.ВалютнаяСуммаДт 	= СуммаЗачета;
			НоваяПроводка.ВалютнаяСуммаКт 	= СуммаЗачета;
			
			Если НЕ ЕстьКурсКратность Тогда
				КурсВалюты = БухгалтерскиеОперацииПовтИсп.ПолучитьКурсВалюты(ТекАванс.Валюта, ДокументОбъект.Дата);
				Курс 		= КурсВалюты.Курс;
				Кратность	= КурсВалюты.Кратность;
			КонецЕсли;
			НоваяПроводка.Сумма = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
															СуммаЗачета,
															Новый Структура("Валюта, Курс, Кратность",
																			НоваяПроводка.ВалютаДт,
																			Курс,
																			Кратность),
															Новый Структура("Валюта, Курс, Кратность",
																			ВалютаРегламентированногоУчета,
																			1,
																			1));
		Иначе
			НоваяПроводка.Сумма = СуммаЗачета;
		КонецЕсли;			
		
		НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
		НоваяПроводка.Содержание     = НСтр("ru='Зачет аванса полученного'");
		
		НоваяПроводка.ВидПервичногоДокумента 	= НСтр("ru='Справка ф. 0504833'");
		НоваяПроводка.ДатаПервичногоДокумента   = ДокументОбъект.Дата;
		НоваяПроводка.НомерПервичногоДокумента  = "";
		
		ЗачтенныйАванс = ТаблицаЗачтенныхАвансов.Добавить();
		ЗаполнитьЗначенияСвойств(ЗачтенныйАванс, ТекАванс, "СчетАвансов, Договор, Подразделение,Валюта");
		ЗачтенныйАванс.СуммаАванса = СуммаЗачета;
	
	КонецЦикла; 
	Возврат ТаблицаПроводок;
	
КонецФункции

Функция ОперацияБух_КорректировкаОстатковРасходовНеУчитываемыхПриНалогообложении(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Организация",   ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаОстатков",  Новый Граница(КонецМесяца(ДокументОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетаРасходов", БухгалтерскийУчет.СписокСчетов("Н20,Н25,Н26,Н44", ДокументОбъект.Дата,,
		ДокументОбъект.Организация));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.КФО КАК КФО,
	|	ВложенныйЗапрос.ИФО КАК ИФО,
	|	ВложенныйЗапрос.Счет КАК СчетКт,
	|	ВложенныйЗапрос.Субконто1 КАК СубконтоКт1,
	|	ВложенныйЗапрос.Субконто2 КАК СубконтоКт2,
	|	ВложенныйЗапрос.Субконто3 КАК СубконтоКт3,
	|	ВложенныйЗапрос.ВидЗатрат КАК ВидЗатрат,
	|	ВложенныйЗапрос.ВидЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат КАК ВидДеятельностиНУ,
	|	ВложенныйЗапрос.ВидЗатрат.ВидРасходовНУ КАК ВидРасходовНУ,
	|	ВложенныйЗапрос.СуммаОстаток КАК Сумма,
	|	ВложенныйЗапрос.СуммаЕНВДОстатокДт КАК СуммаЕНВД,
	|	ВложенныйЗапрос.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУОстатки.Счет КАК Счет,
	|		ЕПСБУОстатки.КФО КАК КФО,
	|		ЕПСБУОстатки.ИФО КАК ИФО,
	|		ЕПСБУОстатки.Субконто1 КАК Субконто1,
	|		ЕПСБУОстатки.Субконто2 КАК Субконто2,
	|		ЕПСБУОстатки.Субконто3 КАК Субконто3,
	|		ВЫБОР
	|			КОГДА ЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ВидыЗатрат
	|				ТОГДА ЕПСБУОстатки.Субконто1
	|			КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ВидыЗатрат
	|				ТОГДА ЕПСБУОстатки.Субконто2
	|			КОГДА ЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ВидыЗатрат
	|				ТОГДА ЕПСБУОстатки.Субконто3
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)
	|		КОНЕЦ КАК ВидЗатрат,
	|		ЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстаток,
	|		ЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СуммаЕНВДОстатокДт,
	|		ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУОстатокДт
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|				&ДатаОстатков,
	|				Счет В (&СчетаРасходов),
	|				,
	|				Организация = &Организация
	|					И &УсловиеИФО
	|					И &УсловиеКФО) КАК ЕПСБУОстатки) КАК ВложенныйЗапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	КФО,
	|	ИФО,
	|	СчетКт,
	|	ВидЗатрат";
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", ДополнительныеРеквизиты.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	ОстаткиРасходов = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаОстатков Из ОстаткиРасходов Цикл
		
		Если СтрокаОстатков.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда
			
			Если СтрокаОстатков.Сумма <> 0 ИЛИ СтрокаОстатков.СуммаНеУчитываетсяНУ <> 0 Тогда
				
				// Списание некорректных сумм на ЕНВД.
				НоваяСтрока = ТаблицаПроводок.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатков, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
				
				НоваяСтрока.Сумма                = СтрокаОстатков.Сумма;
				НоваяСтрока.СуммаНеУчитываетсяНУ = СтрокаОстатков.СуммаНеУчитываетсяНУ;
				
				НоваяСтрока.СуммаЕНВД            = -(СтрокаОстатков.Сумма + СтрокаОстатков.СуммаНеУчитываетсяНУ);
				
				НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
				НоваяСтрока.Содержание     = НСтр("ru = 'Корректировка остатков расходов, не учитываемых при налогообложении'");
				
			КонецЕсли;
			
		ИначеЕсли СтрокаОстатков.ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения
				И СтрокаОстатков.ВидРасходовНУ = Перечисления.ВидыРасходовНУ.НеУчитываемыеВЦеляхНалогообложения Тогда
			
			Если СтрокаОстатков.Сумма <> 0 ИЛИ СтрокаОстатков.СуммаЕНВД <> 0 Тогда
				
				// Списание некорректных сумм на неучитываемые.
				НоваяСтрока = ТаблицаПроводок.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатков, "ИФО,КФО,СчетКт,СубконтоКт1,СубконтоКт2,СубконтоКт3");
				
				НоваяСтрока.Сумма                = СтрокаОстатков.Сумма;
				НоваяСтрока.СуммаЕНВД            = СтрокаОстатков.СуммаЕНВД;
				
				НоваяСтрока.СуммаНеУчитываетсяНУ = -(СтрокаОстатков.Сумма + СтрокаОстатков.СуммаЕНВД);
				
				НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
				НоваяСтрока.Содержание     = НСтр("ru = 'Корректировка остатков расходов, не учитываемых при налогообложении'");
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаПроводок.ЗаполнитьЗначения(Истина, "Активность");
	
	Возврат ТаблицаПроводок;
	
КонецФункции

Функция ОперацияБух_КорректировкаПоложительныхКурсовыхРазницНУ_2022(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Организация",   ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(ДокументОбъект.Дата)); // С 01.01.2022.
	Запрос.УстановитьПараметр("КонецПериода",  КонецДня(ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("СчетаН91",      БухгалтерскийУчет.СписокСчетов("Н91.01,Н91.02"));
	Запрос.УстановитьПараметр("СчетаНПВ",      БухгалтерскийУчет.СписокСчетов("НПВ"));
	Запрос.УстановитьПараметр("СчетаРасчетов", БухгалтерскийУчет.СписокСчетов("205.00,209.00,302.00"));
	
	Запрос.УстановитьПараметр("СубконтоПрочиеДоходыИРасходы", ПланыВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы);
	
	СубконтоКонтрагентыДоговоры = Новый Массив;
	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("СубконтоКонтрагентыДоговоры", СубконтоКонтрагентыДоговоры);
	
	Запрос.УстановитьПараметр("КурсовыеРазницы", Справочники.ПрочиеДоходыИРасходы.КурсовыеРазницы);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОбороты.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.КорСубконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.КорСубконто2 КАК Справочник.Договоры) КАК Договор,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Справочник.ПрочиеДоходыИРасходы) КАК ПрочиеДоходыИРасходы,
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборотДт КАК ОтрицательныеКурсовыеРазницы,
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборотКт КАК ПоложительныеКурсовыеРазницы
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Счет В (&СчетаН91),
	|			&СубконтоПрочиеДоходыИРасходы,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Субконто1 В (&КурсовыеРазницы)
	|				И &УсловиеКонтрагент1
	|				И &УсловиеДоговор1,
	|			КорСчет В (&СчетаНПВ),
	|			&СубконтоКонтрагентыДоговоры) КАК ЖурналПроводокЕПСБУОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.Валюта КАК Валюта,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт КАК ВалютнаяСуммаОстатокКт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&СчетаРасчетов),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И &УсловиеКонтрагент2
	|				И &УсловиеДоговор2) КАК ЖурналПроводокЕПСБУОстатки";
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", ДополнительныеРеквизиты.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Контрагент) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент1", "КорСубконто1 = &Контрагент");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент2", "Субконто1 = &Контрагент");
		Запрос.УстановитьПараметр("Контрагент", ДополнительныеРеквизиты.Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент1", "ИСТИНА" );
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент2", "ИСТИНА" );
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Договор) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор1", "КорСубконто2 = &Договор");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор2", "Субконто2 = &Договор");
		Запрос.УстановитьПараметр("Договор", ДополнительныеРеквизиты.Договор);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор1", "ИСТИНА" );
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор2", "ИСТИНА" );
	КонецЕсли;
	
	Результаты = Запрос.ВыполнитьПакет();
	
	КурсовыеРазницыСНачалаГода = Результаты[0].Выгрузить();
	ОстаткиРасчетовНаДатуПерехода = Результаты[1].Выгрузить();
	
	Для Каждого СтрокаКурсовыеРазницы Из КурсовыеРазницыСНачалаГода Цикл
		
		СуммаКорректировки = СтрокаКурсовыеРазницы.ПоложительныеКурсовыеРазницы - СтрокаКурсовыеРазницы.ОтрицательныеКурсовыеРазницы;
		
		Если СуммаКорректировки > 0 Тогда
			
			Отбор = Новый Структура;
			Отбор.Вставить("ИФО", СтрокаКурсовыеРазницы.ИФО);
			Отбор.Вставить("КФО", СтрокаКурсовыеРазницы.КФО);
			Отбор.Вставить("Субконто1", СтрокаКурсовыеРазницы.Контрагент);
			Отбор.Вставить("Субконто2", СтрокаКурсовыеРазницы.Договор);
			НайденныеСтроки = ОстаткиРасчетовНаДатуПерехода.НайтиСтроки(Отбор);
			
			ОстаткиРасчетов = ОстаткиРасчетовНаДатуПерехода.Скопировать(НайденныеСтроки);
			ОстаткиРасчетов.Колонки.Добавить("ОтложенныеКурсовыеРазницыНУ", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СуммаКорректировки, ОстаткиРасчетов, "ОтложенныеКурсовыеРазницыНУ", "ВалютнаяСуммаОстаток");
			
			Для Каждого СтрокаРасчетов Из ОстаткиРасчетов Цикл
				
				НоваяСтрока = ТаблицаПроводок.Добавить();
				НоваяСтрока.КФО = СтрокаРасчетов.КФО;
				Если ИспользоватьУчетПоИФО Тогда
					НоваяСтрока.ИФО = СтрокаРасчетов.ИФО;
				КонецЕсли;
				
				НоваяСтрока.СчетДт = БухгалтерскийУчет.СчетПоКоду("Н92.01", ДокументОбъект.Дата, ДокументОбъект.Организация);
				
				СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасчетов.Счет);
				НоваяСтрока.СубконтоДт1 = БухгалтерскийУчет.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, 1,
					СвойстваСчетаРасчетов.ВидСубконто1, СтрокаРасчетов.Субконто1,
					СвойстваСчетаРасчетов.ВидСубконто2, СтрокаРасчетов.Субконто2,
					СвойстваСчетаРасчетов.ВидСубконто3, СтрокаРасчетов.Субконто3);
				НоваяСтрока.СубконтоДт2 = БухгалтерскийУчет.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, 2,
					СвойстваСчетаРасчетов.ВидСубконто1, СтрокаРасчетов.Субконто1,
					СвойстваСчетаРасчетов.ВидСубконто2, СтрокаРасчетов.Субконто2,
					СвойстваСчетаРасчетов.ВидСубконто3, СтрокаРасчетов.Субконто3);
				НоваяСтрока.СубконтоДт3 = БухгалтерскийУчет.ПолучитьЗначениеСубконто(НоваяСтрока.СчетДт, 3,
					СвойстваСчетаРасчетов.ВидСубконто1, СтрокаРасчетов.Субконто1,
					СвойстваСчетаРасчетов.ВидСубконто2, СтрокаРасчетов.Субконто2,
					СвойстваСчетаРасчетов.ВидСубконто3, СтрокаРасчетов.Субконто3);
				
				Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
					НоваяСтрока.КПСДт = СтрокаРасчетов.КПС;
				КонецЕсли;
				Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
					НоваяСтрока.ПодразделениеДт = СтрокаРасчетов.Подразделение;
				КонецЕсли;
				
				НоваяСтрока.СчетКт = БухгалтерскийУчет.СчетПоКоду("Н91.01", ДокументОбъект.Дата, ДокументОбъект.Организация);
				СвойстваСчетаН91 = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
				НоваяСтрока.СубконтоКт1 = Справочники.ПрочиеДоходыИРасходы.КурсовыеРазницы;
				Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
					НоваяСтрока.КПСКт = СтрокаРасчетов.КПС;
				КонецЕсли;
				Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
					НоваяСтрока.ПодразделениеКт = СтрокаРасчетов.Подразделение;
				КонецЕсли;
				
				НоваяСтрока.Сумма = (-1) * СтрокаРасчетов.ОтложенныеКурсовыеРазницыНУ;
				
				НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
				НоваяСтрока.Содержание     = НСтр("ru = 'Корректировка положительных курсовых разниц (НУ)'");
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаПроводок.ЗаполнитьЗначения(Истина, "Активность");
	
	Возврат ТаблицаПроводок;
	
КонецФункции

Функция ОперацияБух_СверткаКурсовыхРазницНУ_2022(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Организация",   ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(ДокументОбъект.Дата)); // С 01.01.2022.
	Запрос.УстановитьПараметр("КонецПериода",  КонецДня(ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("СчетН9102",     БухгалтерскийУчет.СписокСчетов("Н91.02"));
	Запрос.УстановитьПараметр("СчетН9201",     БухгалтерскийУчет.СписокСчетов("Н92.01"));
	Запрос.УстановитьПараметр("СчетаНПВ",      БухгалтерскийУчет.СписокСчетов("НПВ"));
	Запрос.УстановитьПараметр("СчетаРасчетов", БухгалтерскийУчет.СписокСчетов("205.00,207.00,209.00,301.00,302.00"));
	
	Запрос.УстановитьПараметр("СубконтоПрочиеДоходыИРасходы", ПланыВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы);
	
	СубконтоКонтрагентыДоговоры = Новый Массив;
	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("СубконтоКонтрагентыДоговоры", СубконтоКонтрагентыДоговоры);
	
	Запрос.УстановитьПараметр("КурсовыеРазницы", Справочники.ПрочиеДоходыИРасходы.КурсовыеРазницы);
	Запрос.УстановитьПараметр("ПустаяВалюта", Справочники.Валюты.ПустаяСсылка());
	Запрос.УстановитьПараметр("ВалютаРубли", Константы.ВалютаРегламентированногоУчета.Получить());
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Н9102Обороты.ИФО КАК ИФО,
	|	Н9102Обороты.КФО КАК КФО,
	|	ВЫРАЗИТЬ(Н9102Обороты.КорСубконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(Н9102Обороты.КорСубконто2 КАК Справочник.Договоры) КАК Договор,
	|	ВЫРАЗИТЬ(Н9102Обороты.Субконто1 КАК Справочник.ПрочиеДоходыИРасходы) КАК ПрочиеДоходыИРасходы,
	|	Н9102Обороты.СуммаОборотДт КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Счет В (&СчетН9102),
	|			&СубконтоПрочиеДоходыИРасходы,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Субконто1 В (&КурсовыеРазницы)
	|				И &УсловиеКонтрагент1
	|				И &УсловиеДоговор1,
	|			КорСчет В (&СчетаНПВ),
	|			&СубконтоКонтрагентыДоговоры) КАК Н9102Обороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Н9201Остатки.Счет КАК Счет,
	|	Н9201Остатки.Субконто1 КАК Субконто1,
	|	Н9201Остатки.Субконто2 КАК Субконто2,
	|	Н9201Остатки.Субконто3 КАК Субконто3,
	|	Н9201Остатки.ИФО КАК ИФО,
	|	Н9201Остатки.КФО КАК КФО,
	|	Н9201Остатки.КПС КАК КПС,
	|	Н9201Остатки.СуммаОстатокКт КАК СуммаОстаток
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&СчетН9201),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И &УсловиеКонтрагент2
	|				И &УсловиеДоговор2) КАК Н9201Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетыОстаткиИОбороты.Субконто1 КАК Субконто1,
	|	РасчетыОстаткиИОбороты.Субконто2 КАК Субконто2,
	|	РасчетыОстаткиИОбороты.Субконто3 КАК Субконто3,
	|	РасчетыОстаткиИОбороты.ИФО КАК ИФО,
	|	РасчетыОстаткиИОбороты.КФО КАК КФО,
	|	РасчетыОстаткиИОбороты.КПС КАК КПС,
	|	ЕСТЬNULL(РасчетыОстаткиИОбороты.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	РасчетыОстаткиИОбороты.Валюта КАК Валюта,
	|	РасчетыОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
	|	РасчетыОстаткиИОбороты.СуммаКонечныйОстатокДт КАК СуммаКонечныйОстатокДт,
	|	РасчетыОстаткиИОбороты.СуммаКонечныйОстатокКт КАК СуммаКонечныйОстатокКт,
	|	РасчетыОстаткиИОбороты.ВалютнаяСуммаКонечныйОстаток КАК ВалютнаяСуммаКонечныйОстаток,
	|	РасчетыОстаткиИОбороты.ВалютнаяСуммаКонечныйОстатокДт КАК ВалютнаяСуммаКонечныйОстатокДт,
	|	РасчетыОстаткиИОбороты.ВалютнаяСуммаКонечныйОстатокКт КАК ВалютнаяСуммаКонечныйОстатокКт,
	|	РасчетыОстаткиИОбороты.СуммаОборот КАК СуммаОборот,
	|	РасчетыОстаткиИОбороты.СуммаОборотДт КАК СуммаОборотДт,
	|	РасчетыОстаткиИОбороты.СуммаОборотКт КАК СуммаОборотКт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			,
	|			Счет В (&СчетаРасчетов),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И &УсловиеКонтрагент2
	|				И &УсловиеДоговор2
	|				И Валюта <> &ПустаяВалюта
	|				И Валюта <> &ВалютаРубли) КАК РасчетыОстаткиИОбороты";
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", ДополнительныеРеквизиты.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Контрагент) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент1", "КорСубконто1 = &Контрагент");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент2", "Субконто1 = &Контрагент");
		Запрос.УстановитьПараметр("Контрагент", ДополнительныеРеквизиты.Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент1", "ИСТИНА" );
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент2", "ИСТИНА" );
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Договор) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор1", "КорСубконто2 = &Договор");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор2", "Субконто2 = &Договор");
		Запрос.УстановитьПараметр("Договор", ДополнительныеРеквизиты.Договор);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор1", "ИСТИНА" );
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор2", "ИСТИНА" );
	КонецЕсли;
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ПризнанныеОтрицательныеКР = Результаты[0].Выгрузить();
	ОтложенныеПоложительныеКР = Результаты[1].Выгрузить();
	ОстаткиРасчетовНаКонецГода = Результаты[2].Выгрузить();
	
	// Распределение отложенных положительных разниц по остаткам расчетов.
	ОстаткиРасчетовНаКонецГода.Колонки.Добавить("ОстатокОтложенныхПоложительныхКР",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	Для Каждого ОстатокОтложенныеПоложительныеКР Из ОтложенныеПоложительныеКР Цикл
		
		Отбор = Новый Структура("ИФО,КФО,КПС,Субконто1");
		ЗаполнитьЗначенияСвойств(Отбор, ОстатокОтложенныеПоложительныеКР);
		Если ЗначениеЗаполнено(ОстатокОтложенныеПоложительныеКР.Субконто2) Тогда
			Отбор.Вставить("Субконто2", ОстатокОтложенныеПоложительныеКР.Субконто2);
		КонецЕсли;
		Если ЗначениеЗаполнено(ОстатокОтложенныеПоложительныеКР.Субконто3) Тогда
			Отбор.Вставить("Субконто3", ОстатокОтложенныеПоложительныеКР.Субконто3);
		КонецЕсли;
		НайденныеОстаткиРасчетов = ОстаткиРасчетовНаКонецГода.НайтиСтроки(Отбор);
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(ОстатокОтложенныеПоложительныеКР.СуммаОстаток,
			НайденныеОстаткиРасчетов, "ОстатокОтложенныхПоложительныхКР", "СуммаКонечныйОстаток", Ложь);
		
	КонецЦикла;
	
	// Расчет сумм корректировки признанных отрицательных курсовых разниц за счет отложенных положительных.
	Для Каждого СтрокаКурсовыеРазницы Из ПризнанныеОтрицательныеКР Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИФО", СтрокаКурсовыеРазницы.ИФО);
		Отбор.Вставить("КФО", СтрокаКурсовыеРазницы.КФО);
		Отбор.Вставить("Субконто1", СтрокаКурсовыеРазницы.Контрагент);
		Отбор.Вставить("Субконто2", СтрокаКурсовыеРазницы.Договор);
		
		ОстаткиРасчетов = ОстаткиРасчетовНаКонецГода.Скопировать(Отбор);
		ОстатокОтложенныхПоложительныхКР = ОстаткиРасчетов.Итог("ОстатокОтложенныхПоложительныхКР");
		
		Если ОстатокОтложенныхПоложительныхКР > 0 Тогда
			
			ОстаткиРасчетов.Колонки.Добавить("ПризнанныеОтрицательныеКР", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СтрокаКурсовыеРазницы.Сумма, ОстаткиРасчетов, "ПризнанныеОтрицательныеКР", "ОстатокОтложенныхПоложительныхКР");
			
			Для Каждого СтрокаРасчетов Из ОстаткиРасчетов Цикл
				
				СуммаКорректировки = Мин( СтрокаРасчетов.ПризнанныеОтрицательныеКР, СтрокаРасчетов.ОстатокОтложенныхПоложительныхКР );
				Если СуммаКорректировки <= 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ТаблицаПроводок.Добавить();
				НоваяСтрока.КФО = СтрокаРасчетов.КФО;
				Если ИспользоватьУчетПоИФО Тогда
					НоваяСтрока.ИФО = СтрокаРасчетов.ИФО;
				КонецЕсли;
				
				НоваяСтрока.СчетДт = БухгалтерскийУчет.СчетПоКоду("Н91.02", ДокументОбъект.Дата, ДокументОбъект.Организация);
				
				СвойстваСчетаН91 = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетДт);
				НоваяСтрока.СубконтоДт1 = Справочники.ПрочиеДоходыИРасходы.КурсовыеРазницы;
				Если СвойстваСчетаН91.УчетПоКПС Тогда
					НоваяСтрока.КПСДт = СтрокаРасчетов.КПС;
				КонецЕсли;
				Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаН91.УчетПоПодразделениям Тогда
					НоваяСтрока.ПодразделениеДт = СтрокаРасчетов.Подразделение;
				КонецЕсли;
				
				НоваяСтрока.СчетКт = БухгалтерскийУчет.СчетПоКоду("Н92.01", ДокументОбъект.Дата, ДокументОбъект.Организация);
				
				СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетКт);
				НоваяСтрока.СубконтоКт1 = БухгалтерскийУчет.ПолучитьЗначениеСубконто(НоваяСтрока.СчетКт, 1,
					СвойстваСчетаРасчетов.ВидСубконто1, СтрокаРасчетов.Субконто1,
					СвойстваСчетаРасчетов.ВидСубконто2, СтрокаРасчетов.Субконто2,
					СвойстваСчетаРасчетов.ВидСубконто3, СтрокаРасчетов.Субконто3);
				НоваяСтрока.СубконтоКт2 = БухгалтерскийУчет.ПолучитьЗначениеСубконто(НоваяСтрока.СчетКт, 2,
					СвойстваСчетаРасчетов.ВидСубконто1, СтрокаРасчетов.Субконто1,
					СвойстваСчетаРасчетов.ВидСубконто2, СтрокаРасчетов.Субконто2,
					СвойстваСчетаРасчетов.ВидСубконто3, СтрокаРасчетов.Субконто3);
				НоваяСтрока.СубконтоКт3 = БухгалтерскийУчет.ПолучитьЗначениеСубконто(НоваяСтрока.СчетКт, 3,
					СвойстваСчетаРасчетов.ВидСубконто1, СтрокаРасчетов.Субконто1,
					СвойстваСчетаРасчетов.ВидСубконто2, СтрокаРасчетов.Субконто2,
					СвойстваСчетаРасчетов.ВидСубконто3, СтрокаРасчетов.Субконто3);
				
				Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
					НоваяСтрока.КПСКт = СтрокаРасчетов.КПС;
				КонецЕсли;
				Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
					НоваяСтрока.ПодразделениеКт = СтрокаРасчетов.Подразделение;
				КонецЕсли;
				
				НоваяСтрока.Сумма = (-1) * СуммаКорректировки;
				
				НоваяСтрока.ВидПервичногоДокумента = НСтр("ru = 'Бухгалтерская справка'");
				НоваяСтрока.ДатаПервичногоДокумента = ДокументОбъект.Дата;
				НоваяСтрока.НомерПервичногоДокумента = ДокументОбъект.Номер;
				
				НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
				НоваяСтрока.Содержание     = НСтр("ru = 'Корректировка отрицательных курсовых разниц (НУ)'");
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаПроводок.ЗаполнитьЗначения(Истина, "Активность");
	
	Возврат ТаблицаПроводок;
	
КонецФункции

Функция ОперацияБух_ОперационнаяАрендаФормированиеРезервов_2023(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецМесяца(ДокументОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетаУчетаПравПользования",
		БухгалтерскийУчет.СписокСчетов("111.40", ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("СчетаАмортизацииПравПользования",
		БухгалтерскийУчет.СписокСчетов("104.40", ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("СчетаДБП",
		БухгалтерскийУчет.СписокСчетов("401.40", ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("Счета30220",
		БухгалтерскийУчет.СписокСчетов("302.24,302.29", ДокументОбъект.Дата));
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("ВидыСубконтоДБП", ВидыСубконто);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ПраваПользованияБУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("АмортизацияПравПользованияБУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ПраваПользования", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ДоходыОтПредоставленияПравПользования", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("КредиторскаяЗадолженность", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПраваПользованияОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ПраваПользованияОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ПраваПользованияОстатки.КФО КАК КФО,
	|	ПраваПользованияОстатки.КПС КАК КПС,
	|	ПраваПользованияОстатки.Счет КАК СчетУчета,
	|	ЕСТЬNULL(ПраваПользованияОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ВЫРАЗИТЬ(ПраваПользованияОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(ПраваПользованияОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ПраваПользованияОстатки.СуммаОстатокДт КАК Сумма
	|ПОМЕСТИТЬ ПраваПользованияБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&СчетаУчетаПравПользования),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И &УсловиеКонтрагент
	|				И &УсловиеДоговор) КАК ПраваПользованияОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор,
	|	Организация,
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияПравПользованияОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(АмортизацияПравПользованияОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	АмортизацияПравПользованияОстатки.КФО КАК КФО,
	|	АмортизацияПравПользованияОстатки.КПС КАК КПС,
	|	ЕСТЬNULL(АмортизацияПравПользованияОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ВЫРАЗИТЬ(АмортизацияПравПользованияОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(АмортизацияПравПользованияОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	АмортизацияПравПользованияОстатки.СуммаОстатокКт КАК СуммаАмортизации
	|ПОМЕСТИТЬ АмортизацияПравПользованияБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&СчетаАмортизацииПравПользования),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Субконто2 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.Договор
	|					ИЗ
	|						ПраваПользованияБУ)) КАК АмортизацияПравПользованияОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор,
	|	Организация,
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПраваПользованияБУ.Организация КАК Организация,
	|	ПраваПользованияБУ.ИФО КАК ИФО,
	|	ПраваПользованияБУ.КФО КАК КФО,
	|	ПраваПользованияБУ.КПС КАК КПС,
	|	ПраваПользованияБУ.СчетУчета КАК СчетУчета,
	|	ПраваПользованияБУ.Подразделение КАК Подразделение,
	|	ПраваПользованияБУ.Договор КАК Договор,
	|	ПраваПользованияБУ.Договор.Контрагент КАК Контрагент,
	|	ПраваПользованияБУ.Сумма - ЕСТЬNULL(АмортизацияБУ.СуммаАмортизации, 0) КАК ОстаточнаяСтоимость
	|ИЗ
	|	ПраваПользованияБУ КАК ПраваПользованияБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ АмортизацияПравПользованияБУ КАК АмортизацияБУ
	|		ПО ПраваПользованияБУ.Договор = АмортизацияБУ.Договор
	|			И ПраваПользованияБУ.Организация = АмортизацияБУ.Организация
	|			И ПраваПользованияБУ.ОсновноеСредство = АмортизацияБУ.ОсновноеСредство
	|			И ПраваПользованияБУ.ИФО = АмортизацияБУ.ИФО
	|			И ПраваПользованияБУ.КФО = АмортизацияБУ.КФО
	|			И ПраваПользованияБУ.КПС = АмортизацияБУ.КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиДБП.Организация КАК Организация,
	|	ЕСТЬNULL(ОстаткиДБП.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(ОстаткиДБП.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ОстаткиДБП.КФО КАК КФО,
	|	ОстаткиДБП.Счет КАК СчетДБП,
	|	ОстаткиДБП.КПС КАК КПСДоходов,
	|	ОстаткиДБП.КЭК КАК КЭКДоходов,
	|	ВЫРАЗИТЬ(ОстаткиДБП.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ОстаткиДБП.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ОстаткиДБП.СуммаОстатокКт КАК ОстатокДБП
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&СчетаДБП),
	|			&ВидыСубконтоДБП,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Субконто2 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.Договор
	|					ИЗ
	|						ПраваПользованияБУ)) КАК ОстаткиДБП
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КредиторскаяЗадолженность.Организация КАК Организация,
	|	ЕСТЬNULL(КредиторскаяЗадолженность.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(КредиторскаяЗадолженность.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	КредиторскаяЗадолженность.КФО КАК КФО,
	|	КредиторскаяЗадолженность.КПС КАК КПС,
	|	КредиторскаяЗадолженность.Счет КАК СчетРасчетов,
	|	КредиторскаяЗадолженность.Субконто1 КАК Субконто1,
	|	КредиторскаяЗадолженность.Субконто2 КАК Субконто2,
	|	КредиторскаяЗадолженность.Субконто3 КАК Субконто3,
	|	ВЫРАЗИТЬ(КредиторскаяЗадолженность.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(КредиторскаяЗадолженность.Субконто1 КАК Справочник.Контрагенты).ТипКонтрагента.Код КАК ТипКонтрагентаКод,
	|	ВЫРАЗИТЬ(КредиторскаяЗадолженность.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	КредиторскаяЗадолженность.Валюта КАК Валюта,
	|	КредиторскаяЗадолженность.ВалютнаяСуммаОстатокКт КАК КредиторскаяЗадолженностьВал,
	|	КредиторскаяЗадолженность.СуммаОстатокКт КАК КредиторскаяЗадолженность
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&Счета30220),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Субконто2 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.Договор
	|					ИЗ
	|						ПраваПользованияБУ)) КАК КредиторскаяЗадолженность";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", ДополнительныеРеквизиты.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Контрагент) Тогда
		Если ДополнительныеРеквизиты.Контрагент.ЭтоГруппа Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент В ИЕРАРХИИ (&Контрагент)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент = &Контрагент");
		КонецЕсли;
		Запрос.УстановитьПараметр("Контрагент", ДополнительныеРеквизиты.Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "ИСТИНА" );
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Договор) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор",
			"ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры) В(&Договор)");
		Запрос.УстановитьПараметр("Договор", ДополнительныеРеквизиты.Договор);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор", "ИСТИНА" );
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаПравПользования = Результат[НомераТаблиц.ПраваПользования].Выгрузить();
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям();
	
	// Распределим остатки ДБП по аналитике прав пользования.
	ДоходыОтПредоставленияПравПользования = Результат[НомераТаблиц.ДоходыОтПредоставленияПравПользования].Выгрузить();
	ТаблицаПравПользования.Колонки.Добавить("СчетДБП",      Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаПравПользования.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПравПользования.Колонки.Добавить("КПСДоходов",   Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаПравПользования.Колонки.Добавить("КЭКДоходов",   Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаПравПользования.Колонки.Добавить("ОстатокДБП",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	Для Каждого ОстатокДБП Из ДоходыОтПредоставленияПравПользования Цикл
		
		СвойстваСчетаДБП = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ОстатокДБП.СчетДБП);
		
		ОтборПравПользования = ?(ИспользоватьУчетПоПодразделениям И СвойстваСчетаДБП.УчетПоПодразделениям,
			Новый Структура("ИФО,КФО,Подразделение,Договор"),
			Новый Структура("ИФО,КФО,Договор"));
		ЗаполнитьЗначенияСвойств(ОтборПравПользования, ОстатокДБП);
		НайденныеСтрокиПравПользования = ТаблицаПравПользования.НайтиСтроки(ОтборПравПользования);
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(ОстатокДБП.ОстатокДБП,
			НайденныеСтрокиПравПользования, "ОстатокДБП", "ОстаточнаяСтоимость", Ложь);
		
		Для Каждого СтрокаПравоПользования Из НайденныеСтрокиПравПользования Цикл
			ЗаполнитьЗначенияСвойств(СтрокаПравоПользования, ОстатокДБП,
				"СчетДБП,Номенклатура,КПСДоходов,КЭКДоходов");
		КонецЦикла;
		
	КонецЦикла;
	
	// Распределим остаточную стоимость прав пользования по остаткам кредиторской задолженности.
	КредиторскаяЗадолженность = Результат[НомераТаблиц.КредиторскаяЗадолженность].Выгрузить();
	КредиторскаяЗадолженность.Колонки.Добавить("ОстаточнаяСтоимость",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	КредиторскаяЗадолженность.Колонки.Добавить("ОстатокДБП",
