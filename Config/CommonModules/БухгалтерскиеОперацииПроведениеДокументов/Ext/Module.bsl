// ДОКУМЕНТ Операция (бухгалтерская)

Функция ОперацияБух_ЗачетАвансаВыданного(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	Перем Курс;
	Перем Кратность;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕПСБУ206.Ссылка КАК Счет206,
	               |	ЕПСБУ302.Ссылка КАК Счет302,
	               |	ЕПСБУ206.Валютный КАК Счет206Валютный,
	               |	ЕПСБУ206.УчетПоПодразделениям КАК Счет206УчетПоПодразделениям,
	               |	ЕПСБУ302.Валютный КАК Счет302Валютный,
	               |	ЕПСБУ302.УчетПоПодразделениям КАК Счет302УчетПоПодразделениям
	               |ПОМЕСТИТЬ СоответствияСчетов
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ206
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ302
	               |		ПО (ПОДСТРОКА(ЕПСБУ206.Код, 5, 2) = ПОДСТРОКА(ЕПСБУ302.Код, 5, 2))
	               |			И (НЕ ЕПСБУ206.ЭлементГруппа)
	               |ГДЕ
	               |	ЕПСБУ206.Ссылка В(&Счет206)
	               |	И ЕПСБУ302.Ссылка В(&Счет302)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет206,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК ДокументАванса,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
	               |	ЖурналПроводокЕПСБУОстатки.КФО,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ КАК ИФО,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |				И СоответствияСчетов.Счет206УчетПоПодразделениям
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ КАК Подразделение,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьВалютныйУчет
	               |				И СоответствияСчетов.Счет206Валютный
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Валюта
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |	КОНЕЦ КАК Валюта,
	               |	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстаток) КАК СуммаОстаток,
	               |	СУММА(ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстаток) КАК ВалютнаяСуммаОстаток,
	               |	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто3.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДокументаАванса,
	               |	СоответствияСчетов.Счет302Валютный,
	               |	СоответствияСчетов.Счет302УчетПоПодразделениям,
	               |	СоответствияСчетов.Счет206Валютный,
	               |	СоответствияСчетов.Счет206УчетПоПодразделениям,
	               |	СоответствияСчетов.Счет206 КАК Счет2061
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			Счет В
	               |				(ВЫБРАТЬ
	               |					СоответствияСчетов.Счет206
	               |				ИЗ
	               |					СоответствияСчетов КАК СоответствияСчетов),
	               |			,
	               |			Организация = &Организация
	               |				И Субконто1 = &Контрагент) КАК ЖурналПроводокЕПСБУОстатки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоответствияСчетов КАК СоответствияСчетов
	               |		ПО ЖурналПроводокЕПСБУОстатки.Счет = СоответствияСчетов.Счет206
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЖурналПроводокЕПСБУОстатки.Счет,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто3,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
	               |	ЖурналПроводокЕПСБУОстатки.КФО,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты),
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры),
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |				И СоответствияСчетов.Счет206УчетПоПодразделениям
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьВалютныйУчет
	               |				И СоответствияСчетов.Счет206Валютный
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Валюта
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |	КОНЕЦ,
	               |	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто3.Дата, ДАТАВРЕМЯ(1, 1, 1)),
	               |	СоответствияСчетов.Счет302Валютный,
	               |	СоответствияСчетов.Счет302УчетПоПодразделениям,
	               |	СоответствияСчетов.Счет206Валютный,
	               |	СоответствияСчетов.Счет206УчетПоПодразделениям,
	               |	СоответствияСчетов.Счет206
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаДокументаАванса
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет302,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
	               |	ЖурналПроводокЕПСБУОстатки.КФО,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ КАК ИФО,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |				И СоответствияСчетов.Счет302УчетПоПодразделениям
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ КАК Подразделение,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьВалютныйУчет
	               |				И СоответствияСчетов.Счет302Валютный
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Валюта
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |	КОНЕЦ КАК Валюта,
	               |	СУММА(-ЖурналПроводокЕПСБУОстатки.СуммаОстаток) КАК СуммаОстаток,
	               |	СУММА(ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстаток) КАК ВалютнаяСуммаОстаток,
	               |	СоответствияСчетов.Счет206,
	               |	СоответствияСчетов.Счет206Валютный,
	               |	СоответствияСчетов.Счет206УчетПоПодразделениям,
	               |	СоответствияСчетов.Счет302Валютный,
	               |	СоответствияСчетов.Счет302УчетПоПодразделениям,
	               |	СоответствияСчетов.Счет302 КАК Счет3021
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&Период,
	               |			Счет В
	               |				(ВЫБРАТЬ
	               |					СоответствияСчетов.Счет302
	               |				ИЗ
	               |					СоответствияСчетов КАК СоответствияСчетов),
	               |			,
	               |			Организация = &Организация
	               |				И Субконто1 = &Контрагент) КАК ЖурналПроводокЕПСБУОстатки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоответствияСчетов КАК СоответствияСчетов
	               |		ПО ЖурналПроводокЕПСБУОстатки.Счет = СоответствияСчетов.Счет302
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЖурналПроводокЕПСБУОстатки.Счет,
	               |	ЖурналПроводокЕПСБУОстатки.КПС,
	               |	ЖурналПроводокЕПСБУОстатки.КФО,
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты),
	               |	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры),
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоПодразделениям
	               |				И СоответствияСчетов.Счет302УчетПоПодразделениям
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьВалютныйУчет
	               |				И СоответствияСчетов.Счет302Валютный
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Валюта
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |	КОНЕЦ,
	               |	СоответствияСчетов.Счет206,
	               |	СоответствияСчетов.Счет206Валютный,
	               |	СоответствияСчетов.Счет206УчетПоПодразделениям,
	               |	СоответствияСчетов.Счет302Валютный,
	               |	СоответствияСчетов.Счет302УчетПоПодразделениям,
	               |	СоответствияСчетов.Счет302";
				   
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет", ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));				   
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));				   
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ?(ДокументОбъект.Ссылка.Пустая(), Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая), ДокументОбъект.Дата));				   
	Запрос.УстановитьПараметр("Контрагент",							ЗначениеДопРеквизита(ДополнительныеРеквизиты,
