#Область СлужебныеПроцедурыИФункции

Функция ФормированиеФактическойСтоимостиМПЗПриПриобретении(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, ДополнительныеПараметры, Отказ)

	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	ПартияМПЗ              = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ПартияМПЗ");
	Счет106                = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "Счет106");
	ВидДвиженияНФА         = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ВидДвиженияНфа");
	ВидДвиженияНфаСписания = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ВидДвиженияНфаСписания");
	КПСДебета              = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "КПСДебета");
	ЦМО                    = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ЦМО");
	
	ПараметрыОстатков = УправлениеМатериальнымиЗапасами.ПараметрыРасчетаФактическойСтоимостиМПЗПоПартии();
	ПараметрыОстатков.Организация            = ДокументОбъект.Организация;
	ПараметрыОстатков.Счет106                = Счет106;
	ПараметрыОстатков.ПартияМПЗ              = ПартияМПЗ;
	ПараметрыОстатков.ИФО                    = ДокументОбъект.ИФО;
	ПараметрыОстатков.УчитыватьПодразделение = Ложь;
	
	Результат = УправлениеМатериальнымиЗапасами.ФактическаяСтоимостьМПЗПоПартии(ПараметрыОстатков);
	
	СчетУчетаМЗ = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеПараметры, "СчетУчетаМЗ");
	
	// Подготовка данных для НУ
	ОтражатьВНалоговомУчете = ДополнительныеПараметры.ОтражатьВНалоговомУчете
		И НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(ДокументОбъект.Организация, ДокументОбъект.Дата);
	Если ОтражатьВНалоговомУчете Тогда
		
		ТаблицаСписанияНУ = ТаблицаПроводок.СкопироватьКолонки();
		ТаблицаСписанияНУ.Колонки.Добавить("СчетУчетаНУ",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ТаблицаСписанияНУ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаСписанияНУ.Колонки.Добавить("Партия",       ПланыВидовХарактеристик.ВидыСубконто.Партии.ТипЗначения);
		ТаблицаСписанияНУ.Колонки.Добавить("Количество",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 3));
		ТаблицаСписанияНУ.Колонки.Добавить("КорСчетНУ",    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		
		МассивКФОдляНУ = НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета();
		
	КонецЕсли;
	
	ДанныеДляРасчетаКЭК = БухгалтерскийУчет.ПараметрыРасчетаКЭКПроводки();
	ЗаполнитьЗначенияСвойств(ДанныеДляРасчетаКЭК, ДокументОбъект, "Дата, Организация, ИФО");
	ДанныеДляРасчетаКЭК.ДтКт = "Дт";
	
	СвойстваСчета106 = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет106);
	
	// Бухгалтерский учет
	Для Каждого Выборка Из Результат Цикл
		
		НоваяПроводка = ТаблицаПроводок.Добавить();
		
		НоваяПроводка.Период      = ДокументОбъект.Дата;
		НоваяПроводка.Организация = ДокументОбъект.Организация;
		НоваяПроводка.ИФО         = ДокументОбъект.ИФО;
		НоваяПроводка.КФО         = Выборка.КФО;
		
		НоваяПроводка.СчетДт = ?(ЗначениеЗаполнено(СчетУчетаМЗ), СчетУчетаМЗ, БухгалтерскиеОперации.СчетУчетаСсылкаИзНоменклатуры(Выборка.Номенклатура));
		НоваяПроводка.КПСДт  = ?(ЗначениеЗаполнено(КПСДебета), КПСДебета, Выборка.КПС);
		
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Номенклатура", Выборка.Номенклатура);
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "ЦМО",          ЦМО);
		Если УправлениеМатериальнымиЗапасамиКлиентСервер.ВедетсяПартионныйУчет(НоваяПроводка.Организация, НоваяПроводка.Период, НоваяПроводка.КФО, НоваяПроводка.СчетДт) Тогда
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Партии", ПартияМПЗ);
		КонецЕсли;
		
		ДанныеДляРасчетаКЭК.КФО       = НоваяПроводка.КФО;
		ДанныеДляРасчетаКЭК.Счет      = НоваяПроводка.СчетДт;
		ДанныеДляРасчетаКЭК.Субконто1 = Выборка.Номенклатура;
		НоваяПроводка.КЭКДт  = БухгалтерскийУчет.КЭКПроводки(ДанныеДляРасчетаКЭК);
		
		НоваяПроводка.СчетКт = Счет106;
		НоваяПроводка.КПСКт  = Выборка.КПС;
		НоваяПроводка.КЭККт  = Выборка.КЭК;
		
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "Партии",       ПартияМПЗ);
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "Номенклатура", Выборка.Номенклатура);
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "ВидыЗатрат",   Выборка.ВидЗатрат);
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
			СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетДт);
			Если СвойстваСчетаДт.УчетПоПодразделениям Тогда
				НоваяПроводка.ПодразделениеДт = Выборка.Подразделение;
			КонецЕсли;
			Если СвойстваСчета106.УчетПоПодразделениям Тогда
				НоваяПроводка.ПодразделениеКт = Выборка.Подразделение;
			КонецЕсли;
		КонецЕсли;
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
			БухгалтерскийУчет.ЗаполнитьСуммыПроводки(НоваяПроводка, Выборка.ВалютнаяСуммаОстаток, Выборка.СуммаОстаток, Выборка.Валюта);
		Иначе
			НоваяПроводка.Сумма = Выборка.СуммаОстаток;
		КонецЕсли;
		
		НоваяПроводка.КоличествоДт = Выборка.КоличествоОстаток;
		НоваяПроводка.КоличествоКт = Выборка.КоличествоОстаток;
		
		НоваяПроводка.ХарактеристикаДвиженияДт = ВидДвиженияНФА;
		НоваяПроводка.ХарактеристикаДвиженияКт = ВидДвиженияНфаСписания;
		
		НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
		НоваяПроводка.Содержание     = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Формирование фактической стоимости: %1'"), НоваяПроводка.СубконтоКт2);
		
		НоваяПроводка.ВидПервичногоДокумента    = НСтр("ru='Справка ф. 0504833'");
		НоваяПроводка.ДатаПервичногоДокумента   = ДокументОбъект.Дата;
		НоваяПроводка.НомерПервичногоДокумента  = "";
		
		Если ОтражатьВНалоговомУчете Тогда
			
			Если МассивКФОдляНУ.Найти(НоваяПроводка.КФО) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаСписанияНУ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НоваяПроводка);
			
			НоваяСтрока.СчетУчетаНУ  = НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ(НоваяПроводка.СчетКт, ДокументОбъект.Дата);
			НоваяСтрока.КорСчетНУ    = НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ(НоваяПроводка.СчетДт, ДокументОбъект.Дата);
			НоваяСтрока.Номенклатура = Выборка.Номенклатура;
			НоваяСтрока.Партия       = ПартияМПЗ;
			НоваяСтрока.Количество   = Выборка.КоличествоОстаток;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументОбъект.СуммаДокумента = ТаблицаПроводок.Итог("Сумма");
	ДокументОбъект.Основание = НСтр("ru='Формирование фактической стоимости приобретения материальных запасов'");
	
	// Налоговый учет
	Если ОтражатьВНалоговомУчете Тогда
		
		ТаблицаСписанныеМПЗ = НалоговыйУчет.ПодготовитьТаблицуСписанныеВложенияМПЗ(ТаблицаСписанияНУ, ДокументОбъект, Отказ);
		
		Для Каждого СтрокаСписанныеМПЗ Из ТаблицаСписанныеМПЗ Цикл
			
			НоваяПроводка = ТаблицаПроводок.Добавить();
			
			НоваяПроводка.Период 		= ДокументОбъект.Дата;
			НоваяПроводка.Организация	= ДокументОбъект.Организация;
			НоваяПроводка.ИФО 			= ДокументОбъект.ИФО;
			
			НоваяПроводка.КФО			= СтрокаСписанныеМПЗ.КФО;
			
			НоваяПроводка.СчетДт        = СтрокаСписанныеМПЗ.КорСчетНУ;
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Номенклатура", СтрокаСписанныеМПЗ.Номенклатура);
			
			НоваяПроводка.СчетКт        = СтрокаСписанныеМПЗ.СчетУчетаНУ;
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "Номенклатура", СтрокаСписанныеМПЗ.Номенклатура);
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "ВидыЗатрат",   СтрокаСписанныеМПЗ.ВидЗатрат);
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "Партии",       СтрокаСписанныеМПЗ.Партия);
			
			НоваяПроводка.Сумма                = СтрокаСписанныеМПЗ.СуммаСписанияНУ;
			НоваяПроводка.СуммаНеУчитываетсяНУ = СтрокаСписанныеМПЗ.СуммаСписанияНеУчитываетсяНУ;
			НоваяПроводка.СуммаЕНВД            = СтрокаСписанныеМПЗ.СуммаСписанияЕНВД;
			
			СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетДт);
			Если СвойстваСчетаДт.Количественный Тогда
				НоваяПроводка.КоличествоДт = СтрокаСписанныеМПЗ.Количество;
			КонецЕсли;
			СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетКт);
			Если СвойстваСчетаКт.Количественный Тогда
				НоваяПроводка.КоличествоКт = СтрокаСписанныеМПЗ.Количество;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяПроводка, СтрокаСписанныеМПЗ,
				"Содержание,ВидПервичногоДокумента,ДатаПервичногоДокумента,НомерПервичногоДокумента");
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаПроводок.ЗаполнитьЗначения(Истина, "Активность");
	
	Возврат ТаблицаПроводок;

КонецФункции

Процедура ЗаполнитьОбщиеРеквизитыПроводки(Проводка, ДокументОбъект, СодержаниеПроводки)
	
	Проводка.ВидПервичногоДокумента = НСтр("ru = 'Бухгалтерская справка'");
	Проводка.ДатаПервичногоДокумента = ДокументОбъект.Дата;
	Проводка.НомерПервичногоДокумента = ДокументОбъект.Номер;
	
	Проводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
	Проводка.Содержание = СодержаниеПроводки;
	
КонецПроцедуры

#КонецОбласти
