// ДОКУМЕНТ Операция (бухгалтерская)

Функция ОперацияБух_ФормированиеФактическойСтоимостиМПЗПриПриобретении(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	
	ДополнительныеПараметры = Новый Структура("ОтражатьВНалоговомУчете", Истина);
	
	Возврат ФормированиеФактическойСтоимостиМПЗПриПриобретении(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, ДополнительныеПараметры, Отказ);
	
КонецФункции

Функция ОперацияБух_ФормированиеФактическойСтоимостиМПЗПриПриобретении_ИК(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	
	ДополнительныеПараметры = Новый Структура("ОтражатьВНалоговомУчете", Истина);
	ДополнительныеПараметры.Вставить("СчетУчетаМЗ", БухгалтерскийУчет.СчетПоКоду("108.56", ДокументОбъект.Дата, ДокументОбъект.Организация));
	
	Возврат ФормированиеФактическойСтоимостиМПЗПриПриобретении(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, ДополнительныеПараметры, Отказ);
	
КонецФункции

Функция ОперацияБух_НачислениеПроцентовПенейШтрафовКПолучению(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Отбор = Новый Структура;
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.ВидРасчетов) Тогда
		Отбор.Вставить("ВидРасчетов", ДополнительныеРеквизиты.ВидРасчетов);
	Иначе // Все, кроме основного долга.
		ПроцентыПениШтрафы = Новый Массив;
		ПроцентыПениШтрафы.Добавить(Перечисления.ВидыРасчетовПоЗаймам.Проценты);
		ПроцентыПениШтрафы.Добавить(Перечисления.ВидыРасчетовПоЗаймам.ПениНаОсновнойДолг);
		ПроцентыПениШтрафы.Добавить(Перечисления.ВидыРасчетовПоЗаймам.ПениНаПроценты);
		ПроцентыПениШтрафы.Добавить(Перечисления.ВидыРасчетовПоЗаймам.Штрафы);
		Отбор.Вставить("ВидРасчетов", ПроцентыПениШтрафы);
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Отбор.Вставить("ИФО", ДокументОбъект.ИФО);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.КФО) Тогда
		Отбор.Вставить("КФО", ДополнительныеРеквизиты.КФО);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Контрагент) Тогда
		Отбор.Вставить("Контрагент", ДополнительныеРеквизиты.Контрагент);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Договор) Тогда
		Отбор.Вставить("Договор", ДополнительныеРеквизиты.Договор);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.ОплатитьДоНеРанее) Тогда
		Отбор.Вставить("ОплатитьДоНеРанее", НачалоДня(ДополнительныеРеквизиты.ОплатитьДоНеРанее));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.ОплатитьДоНеПозднее) Тогда
		Отбор.Вставить("ОплатитьДоНеПозднее", КонецДня(ДополнительныеРеквизиты.ОплатитьДоНеПозднее));
	КонецЕсли;
	
	ПроцентыПениШтрафыКПолучению = КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(
		Отбор, ДокументОбъект.Организация,
		Новый Граница(КонецМесяца(ДокументОбъект.Дата), ВидГраницы.Включая));
	
	Для Каждого СтрокаКПолучению Из ПроцентыПениШтрафыКПолучению Цикл
		
		// Начисление процентов к уплате.
		НоваяПроводка = ТаблицаПроводок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяПроводка, СтрокаКПолучению, "ИФО,КФО");
		
		НоваяПроводка.СчетДт = СтрокаКПолучению.СчетРасчетов;
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Контрагенты", СтрокаКПолучению.Контрагент);
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Договоры", СтрокаКПолучению.Договор);
		НоваяПроводка.КПСДт = СтрокаКПолучению.КПС;
		НоваяПроводка.КЭКДт = БухгалтерскиеОперации.КЭКСчета(
			НоваяПроводка.Организация, НоваяПроводка.ИФО, НоваяПроводка.КФО, НоваяПроводка.Период, НоваяПроводка.СчетДт, "Дт");
		
		НоваяПроводка.СчетКт = ДополнительныеРеквизиты.СчетДоходов;
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", 1, ДополнительныеРеквизиты.СубконтоДоходов1);
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", 2, ДополнительныеРеквизиты.СубконтоДоходов2);
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", 3, ДополнительныеРеквизиты.СубконтоДоходов3);
		НоваяПроводка.КПСКт = СтрокаКПолучению.КПС;
		НоваяПроводка.КЭККт = СтрокаКПолучению.КЭК;
		
		НоваяПроводка.Сумма = СтрокаКПолучению.Сумма;
		
		НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
		
		Если СтрокаКПолучению.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.Проценты Тогда
			НоваяПроводка.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Начисление процентов к получению, оплата %1 по графику платежей'"),
					Формат(СтрокаКПолучению.ОплатитьДо, "ДЛФ=Д"));
		ИначеЕсли СтрокаКПолучению.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ПениНаОсновнойДолг
			ИЛИ СтрокаКПолучению.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ПениНаПроценты Тогда
			НоваяПроводка.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Начисление пеней к получению, оплата %1 по графику платежей'"),
					Формат(СтрокаКПолучению.ОплатитьДо, "ДЛФ=Д"));
		ИначеЕсли СтрокаКПолучению.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.Штрафы Тогда
			НоваяПроводка.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Начисление штрафов к получению, оплата %1 по графику платежей'"),
					Формат(СтрокаКПолучению.ОплатитьДо, "ДЛФ=Д"));
		Иначе
			НоваяПроводка.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Оплата %1 по графику платежей'"),
					Формат(СтрокаКПолучению.ОплатитьДо, "ДЛФ=Д"));
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаПроводок.ЗаполнитьЗначения(Истина, "Активность");
	
	Возврат ТаблицаПроводок;
	
КонецФункции

Функция ОперацияБух_НачислениеПроцентовПенейШтрафовКУплате(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Отбор = Новый Структура;
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.ВидРасчетов) Тогда
		Отбор.Вставить("ВидРасчетов", ДополнительныеРеквизиты.ВидРасчетов);
	Иначе // Все, кроме основного долга.
		ПроцентыПениШтрафы = Новый Массив;
		ПроцентыПениШтрафы.Добавить(Перечисления.ВидыРасчетовПоЗаймам.Проценты);
		ПроцентыПениШтрафы.Добавить(Перечисления.ВидыРасчетовПоЗаймам.ПениНаОсновнойДолг);
		ПроцентыПениШтрафы.Добавить(Перечисления.ВидыРасчетовПоЗаймам.ПениНаПроценты);
		ПроцентыПениШтрафы.Добавить(Перечисления.ВидыРасчетовПоЗаймам.Штрафы);
		Отбор.Вставить("ВидРасчетов", ПроцентыПениШтрафы);
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Отбор.Вставить("ИФО", ДокументОбъект.ИФО);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.КФО) Тогда
		Отбор.Вставить("КФО", ДополнительныеРеквизиты.КФО);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Контрагент) Тогда
		Отбор.Вставить("Контрагент", ДополнительныеРеквизиты.Контрагент);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.Договор) Тогда
		Отбор.Вставить("Договор", ДополнительныеРеквизиты.Договор);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.ОплатитьДоНеРанее) Тогда
		Отбор.Вставить("ОплатитьДоНеРанее", НачалоДня(ДополнительныеРеквизиты.ОплатитьДоНеРанее));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДополнительныеРеквизиты.ОплатитьДоНеПозднее) Тогда
		Отбор.Вставить("ОплатитьДоНеПозднее", КонецДня(ДополнительныеРеквизиты.ОплатитьДоНеПозднее));
	КонецЕсли;
	
	ПроцентыПениШтрафыКУплате = КонтрольИсполненияДоговоров.НеисполненныеПлатежиПоставщикамКредиторам(
		Отбор, ДокументОбъект.Организация,
		Новый Граница(КонецМесяца(ДокументОбъект.Дата), ВидГраницы.Включая));
	
	Для Каждого СтрокаКУплате Из ПроцентыПениШтрафыКУплате Цикл
		
		// Начисление процентов к уплате.
		НоваяПроводка = ТаблицаПроводок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяПроводка, СтрокаКУплате, "ИФО,КФО");
		
		НоваяПроводка.СчетКт = СтрокаКУплате.СчетРасчетов;
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "Контрагенты", СтрокаКУплате.Контрагент);
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "Договоры", СтрокаКУплате.Договор);
		НоваяПроводка.КПСКт = СтрокаКУплате.КПС;
		НоваяПроводка.КЭККт = БухгалтерскиеОперации.КЭКСчета(
			НоваяПроводка.Организация, НоваяПроводка.ИФО, НоваяПроводка.КФО, НоваяПроводка.Период, НоваяПроводка.СчетКт, "Кт");
		
		НоваяПроводка.СчетДт = ДополнительныеРеквизиты.СчетРасходов;
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", 1, ДополнительныеРеквизиты.СубконтоРасходов1);
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", 2, ДополнительныеРеквизиты.СубконтоРасходов2);
		БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", 3, ДополнительныеРеквизиты.СубконтоРасходов3);
		НоваяПроводка.КПСДт = СтрокаКУплате.КПС;
		НоваяПроводка.КЭКДт = СтрокаКУплате.КЭК;
		
		НоваяПроводка.Сумма = СтрокаКУплате.Сумма;
		
		НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
		
		Если СтрокаКУплате.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.Проценты Тогда
			НоваяПроводка.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Начисление процентов к уплате, оплата %1 по графику платежей'"),
					Формат(СтрокаКУплате.ОплатитьДо, "ДЛФ=Д"));
		ИначеЕсли СтрокаКУплате.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ПениНаОсновнойДолг
			ИЛИ СтрокаКУплате.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ПениНаПроценты Тогда
			НоваяПроводка.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Начисление пеней к уплате, оплата %1 по графику платежей'"),
					Формат(СтрокаКУплате.ОплатитьДо, "ДЛФ=Д"));
		ИначеЕсли СтрокаКУплате.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.Штрафы Тогда
			НоваяПроводка.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Начисление штрафов к уплате, оплата %1 по графику платежей'"),
					Формат(СтрокаКУплате.ОплатитьДо, "ДЛФ=Д"));
		Иначе
			НоваяПроводка.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Оплата %1 по графику платежей'"),
					Формат(СтрокаКУплате.ОплатитьДо, "ДЛФ=Д"));
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаПроводок.ЗаполнитьЗначения(Истина, "Активность");
	
	Возврат ТаблицаПроводок;
	
КонецФункции

/////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ДОКУМЕНТ Меню - требование

// Устарела. Для формирования проводок и движений документа "Меню-требование" используются функции:
// 1) Списание продуктов питания:
// - БухгалтерскиеОперацииИсточникиДанных.СписаниеПродуктовПитания(),
// - УправлениеМатериальнымиЗапасами.ТаблицаСписаниеПродуктовПитания(),
// - УправлениеМатериальнымиЗапасами.ОтразитьСписаниеПродуктовПитанияВРегистреРасходПродуктов().
// 2) Возврат продуктов питания:
// - БухгалтерскиеОперацииИсточникиДанных.ВозвратПродуктовПитания(),
// - УправлениеМатериальнымиЗапасами.ТаблицаВозвратПродуктовПитания(),
// - УправлениеМатериальнымиЗапасами.ОтразитьВозвратПродуктовПитанияВРегистреРасходПродуктов().
//
Функция МенюТребование_СписаниеПродуктовПитания(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	Если ДокументОбъект.ЭтоВозврат Тогда
		Возврат Документы.МенюТребование.ПодготовитьТаблицуПроводокВозврат(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ);	
	Иначе
		Возврат Документы.МенюТребование.ПодготовитьТаблицуПроводок(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ);	
	КонецЕсли;
КонецФункции

/////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ДОКУМЕНТ ПОСТУПЛЕНИЕ РАБОТ, УСЛУГ

// Устарела. Сейчас таблица поступления доп.расходов, включаемых в стоимость материальных запасов формируется функциями:
// - УчетРасчетов.ТаблицаПоступлениеДопРасходов() - таблица поступления доп.расходов в унифицированной форме,
// - БухгалтерскиеОперацииИсточникиДанных.ПоступлениеДопРасходов() - источник данных для типовой операции.
//
Функция ПоступлениеУслугРабот_ФормированиеФактическойСтоимостиМПЗ(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.УстановитьДанные(ДокументОбъект);
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	// Расчет базы распределения
	БазаРаспределения = УправлениеМатериальнымиЗапасами.СформироватьБазуРаспределенияРасходовНаПартию(	ДокументОбъект.Дата,
																										ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ПартияМПЗ"), 
																										ЗначениеДопРеквизита(ДополнительныеРеквизиты, "БазаРаспределения"), 
																										ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СчетВложений"));
	ИтогБазы = БазаРаспределения.Итог("БазаРаспределения");
	
	Если ИтогБазы = 0 Тогда
		ТекстСообщения = НСтр("ru='Не найдена база распределения на счете %1 по партии %2'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(	ТекстСообщения,
																					ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СчетВложений"),
																					ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ПартияМПЗ"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат ТаблицаПроводок;
	КонецЕсли;
	
	// Распределение по базе
	
	ТипЗначенияСсылки = Тип("ДокументСсылка.ПоступлениеУслугРабот");
	ИдентификаторОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗначенияСсылки);
	ОписаниеИсточников = БухгалтерскиеОперацииСервер.ПолучитьОписаниеСтруктурыОбъекта(ИдентификаторОбъекта);
	ОписаниеИсточников.Вставить("ДополнительныеРеквизиты", БухгалтерскиеОперацииСервер.ПолучитьОписаниеСтруктурыТиповойОперации(ТиповаяОперация));
		
	СоответствиеДопИсточников = Неопределено;
	ВнешниеНаборыДанных = БухгалтерскиеОперацииСервер.ПолучитьИсточникиДанныхИзОбъекта(ИдентификаторОбъекта, ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, ОписаниеИсточников, СоответствиеДопИсточников);
	
	ТаблицаКоррекции = Новый ТаблицаЗначений;
	ТаблицаКоррекции.Колонки.Добавить("КПС",	Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаКоррекции.Колонки.Добавить("КЭК",	Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаКоррекции.Колонки.Добавить("ПроводкаБУ");
	ТаблицаКоррекции.Колонки.Добавить("ПроводкаНУ");
	ТаблицаКоррекции.Колонки.Добавить("СуммаПроводки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	ТаблицаКоррекции.Колонки.Добавить("СуммаВсего", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)));
	
	СтруктураПоиска = Новый Структура("КПС, КЭК");
	
	Для Каждого СтрБазы Из БазаРаспределения Цикл
	
		// Расчет таблицы документа с зачетом авансов
		Параметры = Новый Структура("КФО", СтрБазы.КФО);
		ТаблицаДокумента = БухгалтерскиеОперацииИсточникиДанных.ПоступлениеУслуг_УслугиИРаботы_СЗачетомАванса("Выполнить", ВнешниеНаборыДанных, ТиповаяОперация, Параметры);
			
		Для Каждого СтрДок Из ТаблицаДокумента Цикл
			
			НоваяПроводкаНУ = Неопределено;
			
			СуммаКРаспределению_ВРублях = 0;
			СуммаКРаспределению = 0;
			
			СуммаРаспределено_ВРублях = 0;
			СуммаРаспределено = 0;
			
			Если ЗначениеДопРеквизита(ДополнительныеРеквизиты, "НДСКВычету") Тогда
				СуммаКРаспределению_ВРублях = СтрДок.Всего_ВРублях - СтрДок.СуммаНДС_ВРублях;
				СуммаКРаспределению = СтрДок.Всего - СтрДок.СуммаНДС;
			Иначе 
				СуммаКРаспределению_ВРублях = СтрДок.Всего_ВРублях;
				СуммаКРаспределению = СтрДок.Всего;
			КонецЕсли;
			
			Если СуммаКРаспределению_ВРублях = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ДоляСтрокиДокумента = СуммаКРаспределению_ВРублях / ИтогБазы;
			
			НоваяПроводка = ТаблицаПроводок.Добавить();
			НоваяПроводка.Период 		= ДокументОбъект.Дата;
			НоваяПроводка.Организация	= ДокументОбъект.Организация;
			НоваяПроводка.ИФО 			= ДокументОбъект.ИФО;
            НоваяПроводка.КФО			= СтрБазы.КФО;

		    НоваяПроводка.СчетДт        = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СчетВложений");
		    НоваяПроводка.КПСДт         = СтрБазы.КПС;
			НоваяПроводка.КЭКДт			= БухгалтерскиеОперации.КЭКСчета(НоваяПроводка.Организация, НоваяПроводка.ИФО, НоваяПроводка.КФО, НоваяПроводка.Период, НоваяПроводка.СчетДт, "Дт");
			
			НоваяПроводка.СубконтоДт1	= ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ПартияМПЗ");
			НоваяПроводка.СубконтоДт2	= СтрБазы.Номенклатура;
			НоваяПроводка.СубконтоДт3   = СтрДок.ВидЗатрат;

			НоваяПроводка.СчетКт        = БухгалтерскиеОперации.СчетПоКЭК(СтрДок.КЭК, "302.00");
			НоваяПроводка.КПСКт         = СтрДок.КПС;
			НоваяПроводка.КЭККт         = БухгалтерскиеОперации.КЭКСчета(НоваяПроводка.Организация, НоваяПроводка.ИФО, НоваяПроводка.КФО, НоваяПроводка.Период, НоваяПроводка.СчетКт, "Кт");

			НоваяПроводка.СубконтоКт1	= ДокументОбъект.Контрагент;
			НоваяПроводка.СубконтоКт2	= ДокументОбъект.Договор;
						
			Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
				НоваяПроводка.ПодразделениеДт 	= СтрБазы.Подразделение;
				НоваяПроводка.ПодразделениеКт 	= ДокументОбъект.Подразделение;
			КонецЕсли;
			
			Если ИспользоватьВалютныйУчет Тогда
				
				СчетДтВалютный = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетДт).Валютный;
				СчетКтВалютный = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетКт).Валютный;
				
			Иначе
				
				СчетДтВалютный = Ложь;
				СчетКтВалютный = Ложь;
				
			КонецЕсли;
			
			СуммаПроводки_ВРублях = Окр(СуммаКРаспределению_ВРублях * СтрБазы.БазаРаспределения / ИтогБазы, 2);
			СуммаПроводки = Окр(СуммаКРаспределению * СтрБазы.БазаРаспределения / ИтогБазы, 2);
			
			СуммаРаспределено_ВРублях = СуммаРаспределено_ВРублях + СуммаПроводки_ВРублях;
			СуммаРаспределено = СуммаРаспределено + СуммаПроводки;
			
			НоваяПроводка.Сумма = СуммаПроводки_ВРублях;
			Если СчетДтВалютный Тогда
				НоваяПроводка.ВалютаДт = ДокументОбъект.ВалютаДокумента;
				НоваяПроводка.ВалютнаяСуммаДт = СуммаПроводки;
			КонецЕсли;
			
			Если СчетКтВалютный Тогда
				НоваяПроводка.ВалютаКт = ДокументОбъект.ВалютаДокумента;
				НоваяПроводка.ВалютнаяСуммаКт = СуммаПроводки;
			КонецЕсли;
			
			НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
			НоваяПроводка.Содержание     = ?(ЗначениеЗаполнено(СтрДок.Содержание), СтрДок.Содержание, СтрДок.Номенклатура.Наименование);
			
			НоваяПроводка.ВидПервичногоДокумента 	= ДокументОбъект.ВидПервичногоДокумента;
			НоваяПроводка.ДатаПервичногоДокумента   = ДокументОбъект.ДатаПервичногоДокумента;
		    НоваяПроводка.НомерПервичногоДокумента  = ДокументОбъект.НомерПервичногоДокумента;
			
			// Налоговый учет
			Если НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(ДокументОбъект.Организация, ДокументОбъект.Дата, СтрБазы.КФО) Тогда
				
				НоваяПроводкаНУ = ТаблицаПроводок.Добавить();
				НоваяПроводкаНУ.Период 		= ДокументОбъект.Дата;
				НоваяПроводкаНУ.Организация	= ДокументОбъект.Организация;
				НоваяПроводкаНУ.ИФО 		= ДокументОбъект.ИФО;
				НоваяПроводкаНУ.КФО			= СтрБазы.КФО;

				Если ЗначениеЗаполнено(ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СчетДебетаНУ")) Тогда
					НоваяПроводкаНУ.СчетДт  = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СчетДебетаНУ");
				Иначе
					НоваяПроводкаНУ.СчетДт  = БухгалтерскиеОперации.ПолучитьСчетНУпоСчетуБУ(НоваяПроводка.СчетДт);
				КонецЕсли;
				
				Если БухгалтерскиеОперации.ПолучитьМассивСчетов("Н08,Н41.02,Н91.02,Н97").Найти(НоваяПроводкаНУ.СчетДт)<>Неопределено
				   И НЕ ЗначениеЗаполнено(ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СубконтоДебетаНУ1")) Тогда
					ТекстСообщения = НСтр("ru='Не заполнен обязательный дополнительный реквизит операции ""Субконто 1""'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"СубконтоДебетаНУ1",,Отказ);
					Возврат ТаблицаПроводок;
				КонецЕсли;
				
				Для Сч=1 По 3 Цикл
					Если ЗначениеЗаполнено(ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СубконтоДебетаНУ"+Сч)) Тогда
						НоваяПроводкаНУ["СубконтоДт"+Сч] = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СубконтоДебетаНУ"+Сч);
					Иначе
						НоваяПроводкаНУ["СубконтоДт"+Сч] = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(НоваяПроводкаНУ.СчетДт, Сч,
							"ВидыЗатрат", СтрДок.ВидЗатрат,
							"Номенклатура", СтрБазы.Номенклатура,
							"Партии", ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ПартияМПЗ"),
							"РеализуемыеАктивы", СтрБазы.Номенклатура);
					КонецЕсли;
				КонецЦикла;
				
				НоваяПроводкаНУ.СчетКт      = БухгалтерскиеОперации.СчетПоКоду("НПВ");
				НоваяПроводкаНУ.СубконтоКт1 = Перечисления.УсловияПоступленияИВыбытияИмущества.ЗаПлату;
				НоваяПроводкаНУ.СубконтоКт2 = ДокументОбъект.Контрагент;
				НоваяПроводкаНУ.СубконтоКт3 = ДокументОбъект.Договор;
							
				НоваяПроводкаНУ.Сумма = СуммаПроводки_ВРублях;
				
				НоваяПроводкаНУ.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводкаНУ.СчетДт, НоваяПроводкаНУ.СчетКт);
				НоваяПроводкаНУ.Содержание     = ?(ЗначениеЗаполнено(СтрДок.Содержание), СтрДок.Содержание, СтрДок.Номенклатура.Наименование);
				
				НоваяПроводкаНУ.ВидПервичногоДокумента    = ДокументОбъект.ВидПервичногоДокумента;
				НоваяПроводкаНУ.ДатаПервичногоДокумента   = ДокументОбъект.ДатаПервичногоДокумента;
				НоваяПроводкаНУ.НомерПервичногоДокумента  = ДокументОбъект.НомерПервичногоДокумента;
			КонецЕсли;
			
			// запомним проводку для коррекции
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрДок);
			НайденыСтроки = ТаблицаКоррекции.НайтиСтроки(СтруктураПоиска);
			Если НайденыСтроки.Количество() = 0 Тогда
				СтрокаКоррекции = ТаблицаКоррекции.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаКоррекции, СтруктураПоиска);
				СтрокаКоррекции.ПроводкаБУ = НоваяПроводка;
				СтрокаКоррекции.ПроводкаНУ = НоваяПроводкаНУ;
				СтрокаКоррекции.СуммаПроводки = СуммаПроводки;
				СтрокаКоррекции.СуммаВсего = СуммаПроводки;
			Иначе
				СтрокаКоррекции = НайденыСтроки[0];	
				Если СуммаПроводки >= СтрокаКоррекции.СуммаПроводки Тогда
					СтрокаКоррекции.СуммаПроводки = СуммаПроводки;
					СтрокаКоррекции.ПроводкаБУ = НоваяПроводка;
					СтрокаКоррекции.ПроводкаНУ = НоваяПроводкаНУ;
				КонецЕсли;
				СтрокаКоррекции.СуммаВсего = СтрокаКоррекции.СуммаВсего + СуммаПроводки_ВРублях;
			КонецЕсли;
			
			Если ЗначениеДопРеквизита(ДополнительныеРеквизиты, "НДСКВычету") И НЕ СтрДок.СуммаНДС_ВРублях = 0 Тогда
			
				НоваяПроводка = ТаблицаПроводок.Добавить();
				НоваяПроводка.Период 		= ДокументОбъект.Дата;
				НоваяПроводка.Организация	= ДокументОбъект.Организация;
				НоваяПроводка.ИФО 			= ДокументОбъект.ИФО;
	            НоваяПроводка.КФО			= СтрБазы.КФО;
			
				Если СтрДок.НДСКРаспределению Тогда
					НоваяПроводка.СчетДт        = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СчетУчетаНДСКРаспределению");
				Иначе
					НоваяПроводка.СчетДт        = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СчетУчетаНДС");
	            КонецЕсли;
		    
			    НоваяПроводка.КПСДт         = СтрДок.КПС;
				НоваяПроводка.КЭКДт			= БухгалтерскиеОперации.КЭКСчета(НоваяПроводка.Организация, НоваяПроводка.ИФО, НоваяПроводка.КФО, НоваяПроводка.Период, НоваяПроводка.СчетДт, "Дт");;
			
				НоваяПроводка.СубконтоДт1	= ДокументОбъект.Контрагент;
				НоваяПроводка.СубконтоДт2	= ДокументОбъект.Ссылка;

				НоваяПроводка.СчетКт        = БухгалтерскиеОперации.СчетПоКЭК(СтрДок.КЭК, "302.00");
				НоваяПроводка.КПСКт         = СтрДок.КПС;
				НоваяПроводка.КЭККт         = БухгалтерскиеОперации.КЭКСчета(НоваяПроводка.Организация, НоваяПроводка.ИФО, НоваяПроводка.КФО, НоваяПроводка.Период, НоваяПроводка.СчетКт, "Кт");;

				НоваяПроводка.СубконтоКт1	= ДокументОбъект.Контрагент;
				НоваяПроводка.СубконтоКт2	= ДокументОбъект.Договор;
				
				Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
					НоваяПроводка.ПодразделениеДт 	= ДокументОбъект.Подразделение;
					НоваяПроводка.ПодразделениеКт 	= ДокументОбъект.Подразделение;
				КонецЕсли;
			
				Если ИспользоватьВалютныйУчет Тогда
					
					СчетДтВалютный = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетДт).Валютный;
					СчетКтВалютный = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетКт).Валютный;
					
				Иначе
					
					СчетДтВалютный = Ложь;
					СчетКтВалютный = Ложь;
					
				КонецЕсли;
				
				СуммаПроводки_ВРублях = Окр(СтрДок.СуммаНДС_ВРублях * СтрБазы.БазаРаспределения / ИтогБазы, 2);
				СуммаПроводки = Окр(СтрДок.СуммаНДС * СтрБазы.БазаРаспределения / ИтогБазы, 2);
			
				НоваяПроводка.Сумма = СуммаПроводки_ВРублях;
				Если СчетДтВалютный Тогда
					НоваяПроводка.ВалютаДт = ДокументОбъект.ВалютаДокумента;
					НоваяПроводка.ВалютнаяСуммаДт = СуммаПроводки;
				КонецЕсли;
				
				Если СчетКтВалютный Тогда
					НоваяПроводка.ВалютаКт = ДокументОбъект.ВалютаДокумента;
					НоваяПроводка.ВалютнаяСуммаКт = СуммаПроводки;
				КонецЕсли;
			                                                    
				НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
				НоваяПроводка.Содержание     = "Учтен НДС: " + ?(ЗначениеЗаполнено(СтрДок.Содержание), СтрДок.Содержание, СтрДок.Номенклатура.Наименование);
				
				НоваяПроводка.ВидПервичногоДокумента 	= ДокументОбъект.ВидПервичногоДокумента;
				НоваяПроводка.ДатаПервичногоДокумента   = ДокументОбъект.ДатаПервичногоДокумента;
			    НоваяПроводка.НомерПервичногоДокумента  = ДокументОбъект.НомерПервичногоДокумента;
			
			КонецЕсли;	
			
		КонецЦикла;
		
		ТаблицаЗачетаАванса = БухгалтерскиеОперацииИсточникиДанных.ТаблицаЗачетаАванса_ПоступлениеУслуг("Выполнить", ВнешниеНаборыДанных, ТиповаяОперация, Параметры);
		
		Для каждого СтрокаАванса Из ТаблицаЗачетаАванса Цикл
		
			НоваяПроводка = ТаблицаПроводок.Добавить();
			НоваяПроводка.Период 		= ДокументОбъект.Дата;
			НоваяПроводка.Организация	= ДокументОбъект.Организация;
			НоваяПроводка.ИФО 			= ДокументОбъект.ИФО;
	        НоваяПроводка.КФО			= СтрокаАванса.КФО;

		    НоваяПроводка.СчетДт        = СтрокаАванса.СчетРасчетов;
		    НоваяПроводка.КПСДт         = СтрокаАванса.КПС;
			НоваяПроводка.КЭКДт			= БухгалтерскиеОперации.КЭКСчета(НоваяПроводка.Организация, НоваяПроводка.ИФО, НоваяПроводка.КФО, НоваяПроводка.Период, НоваяПроводка.СчетДт, "Дт");
			
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Контрагенты",		ДокументОбъект.Контрагент);
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Договоры",			ДокументОбъект.Договор);
			ЗначениеСубконто3 = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(НоваяПроводка.СчетДт, 3,
									БухгалтерскиеОперации.ВидСубконтоСчета(НоваяПроводка.СчетДт, 3), СтрокаАванса.ДопСубконто);
			Если ЗначениеЗаполнено(ЗначениеСубконто3) Тогда
				БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", 3,				ЗначениеСубконто3);
			КонецЕсли;

			НоваяПроводка.СчетКт        = СтрокаАванса.СчетАванса;
			НоваяПроводка.КПСКт         = СтрокаАванса.КПС;
			НоваяПроводка.КЭККт         = БухгалтерскиеОперации.КЭКСчета(НоваяПроводка.Организация, НоваяПроводка.ИФО, НоваяПроводка.КФО, НоваяПроводка.Период, НоваяПроводка.СчетКт, "Кт");

			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "Контрагенты",		ДокументОбъект.Контрагент);
			БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "Договоры",			ДокументОбъект.Договор);
			ЗначениеСубконто3 = БухгалтерскиеОперации.ПолучитьЗначениеСубконто(НоваяПроводка.СчетКт, 3, 
									"ДокументыРасчетов", СтрокаАванса.ДокументАванса,
									БухгалтерскиеОперации.ВидСубконтоСчета(НоваяПроводка.СчетКт, 3), СтрокаАванса.ДопСубконто);
	 		Если ЗначениеЗаполнено(ЗначениеСубконто3) Тогда
				БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", 3,				ЗначениеСубконто3);
			КонецЕсли;
			
			Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
				НоваяПроводка.ПодразделениеДт 	= ДокументОбъект.Подразделение;
				НоваяПроводка.ПодразделениеКт 	= ДокументОбъект.Подразделение;
			КонецЕсли;
			                                                    
			Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
				БухгалтерскийУчет.ЗаполнитьСуммыПроводки(	НоваяПроводка,
															СтрокаАванса.ВалютнаяСумма,
															СтрокаАванса.Сумма,
															СтрокаАванса.Валюта,
															1,
															1);
			Иначе
				НоваяПроводка.Сумма = СтрокаАванса.Сумма;
			КонецЕсли;                                                         
			
			НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
			НоваяПроводка.Содержание     = "Зачтен аванс выданный";
			
			НоваяПроводка.ВидПервичногоДокумента 	= ДокументОбъект.ВидПервичногоДокумента;
			НоваяПроводка.ДатаПервичногоДокумента   = ДокументОбъект.ДатаПервичногоДокумента;
		    НоваяПроводка.НомерПервичногоДокумента  = ДокументОбъект.НомерПервичногоДокумента;

		КонецЦикла; 
		
				
	КонецЦикла;
	
	Если ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ПринятьДенежноеОбязательство") = Истина Тогда
		
		ТаблицаПринятыхОбязательств = БухгалтерскиеОперацииИсточникиДанных.ТаблицаПринятияДенежногоОбязательства_ПоступлениеУслуг("Выполнить", ВнешниеНаборыДанных, ТиповаяОперация, Параметры);
		
		Для каждого СтрокаПринятыхОбязательств Из ТаблицаПринятыхОбязательств Цикл
			
			НоваяПроводка = ТаблицаПроводок.Добавить();
			НоваяПроводка.Период 		= ДокументОбъект.Дата;
			НоваяПроводка.Организация	= ДокументОбъект.Организация;
			НоваяПроводка.ИФО 			= ДокументОбъект.ИФО;
			НоваяПроводка.КФО			= СтрБазы.КФО;
			
			НоваяПроводка.СчетДт        = БухгалтерскиеОперации.СчетПоКоду("502.11");
			НоваяПроводка.КПСДт         = СтрокаПринятыхОбязательств.КПС;
			НоваяПроводка.КЭКДт			= СтрокаПринятыхОбязательств.КЭК;
			
			НоваяПроводка.СубконтоДт1	= ЗначениеДопРеквизита(ДополнительныеРеквизиты, "РазделыЛицевыхСчетов");
			НоваяПроводка.СубконтоДт2	= ДокументОбъект.Договор;
			
			НоваяПроводка.СчетКт        = БухгалтерскиеОперации.СчетПоКоду("502.12");
			НоваяПроводка.КПСКт         = СтрокаПринятыхОбязательств.КПС;
			НоваяПроводка.КЭККт         = СтрокаПринятыхОбязательств.КЭК;
			
			НоваяПроводка.СубконтоКт1	= ЗначениеДопРеквизита(ДополнительныеРеквизиты, "РазделыЛицевыхСчетов");
			НоваяПроводка.СубконтоКт2	= ДокументОбъект.Договор;
			
			Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
				НоваяПроводка.ПодразделениеДт 	= ДокументОбъект.Подразделение;
				НоваяПроводка.ПодразделениеКт 	= ДокументОбъект.Подразделение;
			КонецЕсли;
			
			Если ИспользоватьВалютныйУчет Тогда
				
				СчетДтВалютный = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетДт).Валютный;
				СчетКтВалютный = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетКт).Валютный;
				
			Иначе
				
				СчетДтВалютный = Ложь;
				СчетКтВалютный = Ложь;
				
			КонецЕсли;
			
			НоваяПроводка.Сумма = СтрокаПринятыхОбязательств.Сумма_ВРублях;
			Если СчетДтВалютный Тогда
				НоваяПроводка.ВалютаДт = ДокументОбъект.ВалютаДокумента;
				НоваяПроводка.ВалютнаяСуммаДт = СтрокаПринятыхОбязательств.Сумма;
			КонецЕсли;
			
			Если СчетКтВалютный Тогда
				НоваяПроводка.ВалютаКт = ДокументОбъект.ВалютаДокумента;
				НоваяПроводка.ВалютнаяСуммаКт = СтрокаПринятыхОбязательств.Сумма;
			КонецЕсли;
			
			НоваяПроводка.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяПроводка.СчетДт, НоваяПроводка.СчетКт);
			НоваяПроводка.Содержание     = "Приняты на учет денежные обязательства";
			
			НоваяПроводка.ВидПервичногоДокумента 	= ДокументОбъект.ВидПервичногоДокумента;
			НоваяПроводка.ДатаПервичногоДокумента   = ДокументОбъект.ДатаПервичногоДокумента;
			НоваяПроводка.НомерПервичногоДокумента  = ДокументОбъект.НомерПервичногоДокумента;
			
		КонецЦикла; 
		
	КонецЕсли;
	
	КопияТаблицыДокумента = ДокументОбъект.УслугиИРаботы.Выгрузить(,"КПС, КЭК, Всего, СуммаНДС");
	КопияТаблицыДокумента.Свернуть("КПС, КЭК", "Всего, СуммаНДС");
	Для каждого СтрокаКопииТаблицы Из КопияТаблицыДокумента Цикл
	
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаКопииТаблицы);
		Если ЗначениеДопРеквизита(ДополнительныеРеквизиты, "НДСКВычету") Тогда
			СуммаСтроки = СтрокаКопииТаблицы.Всего - СтрокаКопииТаблицы.СуммаНДС;
		Иначе 
			СуммаСтроки = СтрокаКопииТаблицы.Всего;
		КонецЕсли;
		НайденыСтроки = ТаблицаКоррекции.НайтиСтроки(СтруктураПоиска);
		Если НайденыСтроки.Количество() = 1 Тогда
			СтрокаКоррекции = НайденыСтроки[0];	
			Если СуммаСтроки <> СтрокаКоррекции.СуммаВсего Тогда
				
				ПроводкаДляКоррекции = СтрокаКоррекции.ПроводкаБУ;
				Если ПроводкаДляКоррекции <> Неопределено Тогда
					ЭтоВалютнаяСумма = ЗначениеЗаполнено(ПроводкаДляКоррекции.ВалютаДт) ИЛИ ЗначениеЗаполнено(ПроводкаДляКоррекции.ВалютаКт);
					Если ЭтоВалютнаяСумма Тогда
						Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПроводкаДляКоррекции.СчетДт).Валютный Тогда
							ПроводкаДляКоррекции.ВалютнаяСуммаДт = ПроводкаДляКоррекции.ВалютнаяСуммаДт + СуммаСтроки - СтрокаКоррекции.СуммаВсего;
						КонецЕсли;
						Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПроводкаДляКоррекции.СчетКт).Валютный Тогда
							ПроводкаДляКоррекции.ВалютнаяСуммаКт = ПроводкаДляКоррекции.ВалютнаяСуммаКт + СуммаСтроки - СтрокаКоррекции.СуммаВсего;
						КонецЕсли;
					Иначе
						ПроводкаДляКоррекции.Сумма = ПроводкаДляКоррекции.Сумма + СуммаСтроки - СтрокаКоррекции.СуммаВсего;
						ПроводкаДляКоррекцииНУ = СтрокаКоррекции.ПроводкаНУ;
						Если ПроводкаДляКоррекцииНУ <> Неопределено Тогда
							ПроводкаДляКоррекцииНУ.Сумма = ПроводкаДляКоррекцииНУ.Сумма + СуммаСтроки - СтрокаКоррекции.СуммаВсего;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	
	ТаблицаПроводок.ЗаполнитьЗначения(Истина, "Активность");
	
	Возврат ТаблицаПроводок;
	
КонецФункции	

/////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ДОКУМЕНТ Ввод начальных остатков

// Устарела. Настройка отражения в учете ввода начальных остатков по материалам перенесена в типовую операцию ВводНачальныхОстатков_Материалы.
// см. также БухгалтерскиеОперацииИсточникиДанных.ВводОстатковРасходовУСН(...).
