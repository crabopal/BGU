// ДОКУМЕНТ Перенос вложений в НФА

// Устарела.
Функция ПереносВложенийВНФА_ПереносВложенийВНФА(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)

	ДокументСсылка = ДокументОбъект.Ссылка;
	
	БазовыеСубконто = Новый Массив;
	БазовыеСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	БазовыеСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);

	// массив видов субконто для запроса. начинается всегда с базового субконто
	ВидыСубконто = Новый Массив(1);
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ДокументОбъект.СчетВложений);
	Для Индекс = 1 По 3 Цикл
	
		Если ЗначениеЗаполнено(СвойстваСчета["ВидСубконто" + Индекс]) Тогда
			
			Если БазовыеСубконто.Найти(СвойстваСчета["ВидСубконто" + Индекс]) <> Неопределено Тогда
				
				ВидыСубконто[0] = СвойстваСчета["ВидСубконто" + Индекс];
				
			ИначеЕсли СвойстваСчета["ВидСубконто" + Индекс + "ТолькоОбороты"] <> Истина И СвойстваСчета["ВидСубконто" + Индекс + "ТолькоОбороты"] <> Строка(Истина) Тогда
				
				ВидыСубконто.Добавить(СвойстваСчета["ВидСубконто" + Индекс]);
				
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла;
	
	ИндексСубконтоПартии = ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Партии);
	ИндексСубконтоВидыЗатрат = ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	//ТаблицаНФА = Новый ТаблицаЗначений;
	//ТаблицаНФА.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	//ТаблицаНФА.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	//ТаблицаНФА.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	//
	
	Если ВидыСубконто[0] = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
		МассивНФА = ДокументОбъект.КапитальныеВложения.Выгрузить().ВыгрузитьКолонку("ВнеоборотныйАктив");
	//	
	//	ТаблицаНФА.Колонки.Добавить("НФА", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	//	
	ИначеЕсли ВидыСубконто[0] = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
		МассивНФА = ДокументОбъект.Материалы.Выгрузить().ВыгрузитьКолонку("Номенклатура");
	//
	//	ТаблицаНФА.Колонки.Добавить("НФА", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	//
	//Иначе
	//	
	//	ВызватьИсключение "Выбран неверный счет";
	//	
	КонецЕсли;
	//
	//Запрос.Текст = 
	//"ВЫБРАТЬ
	//|	ТаблицаНФА.НФА
	//|ИЗ
	//|	ТаблицаНФА КАК ТаблицаНФА";
	
	Запрос.УстановитьПараметр("Период", Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Организация"));
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("НФА", МассивНФА);
	Запрос.УстановитьПараметр("Счет", ДокументОбъект.СчетВложений);

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК НФА,";
	Если ВидыСубконто.Количество() > 1 Тогда
		Запрос.Текст = Запрос.Текст + "
		|	ЖурналПроводокЕПСБУОстатки.Субконто2,";
	Иначе
		Запрос.Текст = Запрос.Текст + "
		|	NULL КАК Субконто2,";
	КонецЕсли;
	Если ВидыСубконто.Количество() > 2 Тогда
		Запрос.Текст = Запрос.Текст + "
		|	ЖурналПроводокЕПСБУОстатки.Субконто3,";
	Иначе
		Запрос.Текст = Запрос.Текст + "
		|	NULL КАК Субконто3,";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток Как Сумма,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток Как Количество,
	|	Ложь Как СтрокаЗачтена
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет = &Счет,
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И Субконто1 В (&НФА)) КАК ЖурналПроводокЕПСБУОстатки";
	
	Остатки = Запрос.Выполнить().Выгрузить();
	
	ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Если ВидыСубконто[0] = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
		ТабличнаяЧастьДокумента = "КапитальныеВложения";
		ИмяПоляНФА = "ВнеоборотныйАктив";
		ТекстНехватки = НСтр("ru = 'В строке %1 таблицы ""Капитальные вложения"", задана сумма %2 больше, чем на счете вложений'");
		
	Иначе
		ТабличнаяЧастьДокумента = "Материалы";
		ИмяПоляНФА = "Номенклатура";
		ТекстНехватки = НСтр("ru = 'В строке %1 таблицы ""Материалы"", задана сумма %2 больше, чем на счете вложений'");
	КонецЕсли;
	
	Для каждого СтрокаДокумента Из ДокументОбъект[ТабличнаяЧастьДокумента] Цикл
	
		КоличествоСписания = СтрокаДокумента.Количество;
		СуммаСписания = СтрокаДокумента.Сумма;
		
		Отбор = Новый Структура("НФА", СтрокаДокумента[ИмяПоляНФА]);
		СтрокиОстатковНФА = Остатки.НайтиСтроки(Отбор);
		СтрокиКУдалению = Новый Массив;
		
		Для каждого ТекСтрокаОстатковНФА Из СтрокиОстатковНФА Цикл
			
			Если СуммаСписания = 0 Тогда
				Прервать;
			КонецЕсли;
		
			СуммаПроводки = Мин(Макс(0, ТекСтрокаОстатковНФА.Сумма), СуммаСписания);
			КоличествоПроводки = Мин(Макс(0, ТекСтрокаОстатковНФА.Количество), КоличествоСписания);
			
			Если СуммаПроводки = ТекСтрокаОстатковНФА.Сумма Тогда
				СтрокиКУдалению.Добавить(ТекСтрокаОстатковНФА);
			КонецЕсли;
			
			Если СуммаПроводки = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СуммаСписания = СуммаСписания - СуммаПроводки;
			КоличествоСписания = КоличествоСписания - КоличествоПроводки;
			
			ПроводкаСписание = ТаблицаПроводок.Добавить();
			ПроводкаСписание.Активность		= Истина;
			ПроводкаСписание.Период 		= ДокументОбъект.Дата;
			ПроводкаСписание.Организация	= ДокументОбъект.Организация;
			ПроводкаСписание.ИФО 			= ДокументОбъект.ИФО;
			ПроводкаСписание.КФО			= ДокументОбъект.КФОСписания;
			
			ПроводкаСписание.СчетДт			= ДокументОбъект.КорСчетСписания;
			ПроводкаСписание.КПСДт			= ДокументОбъект.КорКПССписания;
			ПроводкаСписание.КЭКДт			= ДокументОбъект.КорКЭКСписания;
			
			БухгалтерскийУчет.УстановитьСубконто(ПроводкаСписание, "Дт", 1, ДокументОбъект.КорСубконто1Списания);
			БухгалтерскийУчет.УстановитьСубконто(ПроводкаСписание, "Дт", 2, ДокументОбъект.КорСубконто2Списания);
			БухгалтерскийУчет.УстановитьСубконто(ПроводкаСписание, "Дт", 3, ДокументОбъект.КорСубконто3Списания);
			
			ПроводкаСписание.СчетКт			= ДокументОбъект.СчетВложений;
			ПроводкаСписание.КПСКт			= ДокументОбъект.КПССписания;
			ПроводкаСписание.КЭККт			= БухгалтерскиеОперации.КЭКСчета(ПроводкаСписание.Организация, ПроводкаСписание.ИФО, ПроводкаСписание.КФО, ПроводкаСписание.Период, ПроводкаСписание.СчетКт, "Кт");
			
			Если ИндексСубконтоПартии = Неопределено Тогда
				ПроводкаСписание.СубконтоКт1	= БухгалтерскиеОперации.ПолучитьЗначениеСубконто(ДокументОбъект.СчетВложений, 1, 
													"Номенклатура", Отбор.НФА,
													"ОсновныеСредства", Отбор.НФА);
													
			Иначе
				ПроводкаСписание.СубконтоКт1	= БухгалтерскиеОперации.ПолучитьЗначениеСубконто(ДокументОбъект.СчетВложений, 1, 
													"Номенклатура", Отбор.НФА,
													"ОсновныеСредства", Отбор.НФА,
													"Партии", ТекСтрокаОстатковНФА["Субконто" + (ИндексСубконтоПартии + 1)]);
			КонецЕсли;
			
			Если СвойстваСчета.ВидСубконто2ТолькоОбороты = "Да" Или СвойстваСчета.ВидСубконто2ТолькоОбороты = Истина Тогда
				ПроводкаСписание.СубконтоКт2	= БухгалтерскиеОперации.ПолучитьЗначениеСубконто(ДокументОбъект.СчетВложений, 2, 
													"ВидыЗатрат", ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ВидЗатрат"));
				
			ИначеЕсли ИндексСубконтоВидыЗатрат <> Неопределено Тогда
				ПроводкаСписание.СубконтоКт2	= БухгалтерскиеОперации.ПолучитьЗначениеСубконто(ДокументОбъект.СчетВложений, 2, 
													"Номенклатура", Отбор.НФА,
													"ВидыЗатрат", ТекСтрокаОстатковНФА["Субконто" + (ИндексСубконтоВидыЗатрат + 1)]);
				
			КонецЕсли;
												
			Если ИндексСубконтоВидыЗатрат = Неопределено Тогда
				ПроводкаСписание.СубконтоКт3	= БухгалтерскиеОперации.ПолучитьЗначениеСубконто(ДокументОбъект.СчетВложений, 3, 
													"СпособыСтроительства", ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СпособСтроительства"));
				
			Иначе
				ПроводкаСписание.СубконтоКт3	= БухгалтерскиеОперации.ПолучитьЗначениеСубконто(ДокументОбъект.СчетВложений, 3,
													"ВидыЗатрат", ТекСтрокаОстатковНФА["Субконто" + (ИндексСубконтоВидыЗатрат + 1)],
													"СпособыСтроительства", ЗначениеДопРеквизита(ДополнительныеРеквизиты, "СпособСтроительства"));
				
			КонецЕсли;
			
			ПроводкаСписание.ХарактеристикаДвиженияКт = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ВидДвиженияНФАУменьшение");
			
			Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
				ПроводкаСписание.ПодразделениеДт 	= ДокументОбъект.Подразделение;
				ПроводкаСписание.ПодразделениеКт 	= ДокументОбъект.Подразделение;
			КонецЕсли;
		
			ПроводкаСписание.Сумма = СуммаПроводки;
			ПроводкаСписание.КоличествоКт = КоличествоПроводки;
		
			ПроводкаСписание.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(ПроводкаСписание.СчетДт, ПроводкаСписание.СчетКт);
			ПроводкаСписание.Содержание = НСтр("ru = 'Списание вложений в НФА'");
		
			ПроводкаСписание.ВидПервичногоДокумента 	= НСтр("ru='Справка ф. 0504833'");
			ПроводкаСписание.ДатаПервичногоДокумента   = ДокументОбъект.Дата;
			ПроводкаСписание.НомерПервичногоДокумента  = БухгалтерскиеОперации.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ДокументОбъект.Номер);
			
			ПроводкаПоступление = ТаблицаПроводок.Добавить();
			ПроводкаПоступление.Активность		= Истина;
			ЗаполнитьЗначенияСвойств(ПроводкаПоступление, ПроводкаСписание, "Организация, ИФО, Период, ВидПервичногоДокумента, ДатаПервичногоДокумента, НомерПервичногоДокумента, Сумма");
			
			ПроводкаПоступление.КФО				= ДокументОбъект.КФООприходования;
			
			ПроводкаПоступление.СчетДт			= ПроводкаСписание.СчетКт;
			ПроводкаПоступление.КПСДт			= ДокументОбъект.КПСОприходования;
			ПроводкаПоступление.КЭКДт			= БухгалтерскиеОперации.КЭКСчета(ПроводкаПоступление.Организация, ПроводкаПоступление.ИФО, ПроводкаПоступление.КФО, ПроводкаПоступление.Период, ПроводкаПоступление.СчетДт, "Дт");
			ПроводкаПоступление.СубконтоДт1		= ПроводкаСписание.СубконтоКт1;
			ПроводкаПоступление.СубконтоДт2		= ПроводкаСписание.СубконтоКт2;
			ПроводкаПоступление.СубконтоДт3		= ПроводкаСписание.СубконтоКт3;
			
			ПроводкаПоступление.ХарактеристикаДвиженияДт = ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ВидДвиженияНФАУвеличение");
			
			ПроводкаПоступление.СчетКт			= ДокументОбъект.КорСчетОприходования;
			ПроводкаПоступление.КПСКт			= ДокументОбъект.КорКПСОприходования;
			ПроводкаПоступление.КЭККт			= ДокументОбъект.КорКЭКОприходования;
			
			БухгалтерскийУчет.УстановитьСубконто(ПроводкаПоступление, "Кт", 1, ДокументОбъект.КорСубконто1Оприходования);
			БухгалтерскийУчет.УстановитьСубконто(ПроводкаПоступление, "Кт", 2, ДокументОбъект.КорСубконто2Оприходования);
			БухгалтерскийУчет.УстановитьСубконто(ПроводкаПоступление, "Кт", 3, ДокументОбъект.КорСубконто3Оприходования);
			
			ПроводкаПоступление.КоличествоДт 	= ПроводкаСписание.КоличествоКт;
			
			Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
				ПроводкаПоступление.ПодразделениеДт 	= ДокументОбъект.Подразделение;
				ПроводкаПоступление.ПодразделениеКт 	= ДокументОбъект.Подразделение;
			КонецЕсли;
			
			ПроводкаПоступление.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(ПроводкаСписание.СчетДт, ПроводкаСписание.СчетКт);
			ПроводкаПоступление.Содержание = НСтр("ru = 'Оприходование вложений в НФА'");
			
		КонецЦикла; 
			
		Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		
			Остатки.Удалить(СтрокаКУдалению);
		
		КонецЦикла; 	
		
		Если СуммаСписания > 0 Тогда
			// списали не все
			
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстНехватки, СтрокаДокумента.НомерСтроки, СтрокаДокумента[ИмяПоляНФА]),,
				"Объект." + ТабличнаяЧастьДокумента + "[" + (СтрокаДокумента.НомерСтроки - 1) + "].Сумма",,Отказ);
			
		КонецЕсли;
		
		
	КонецЦикла; 

	Возврат ТаблицаПроводок;

КонецФункции // ПереносВложенийВНФА_ПереносВложенийВНФА()


#Область УстаревшиеПроцедурыИФункции

