	Возврат Документы.ВводНачальныхОстатков.ПодготовитьТаблицуПроводок_Материалы(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ);
КонецФункции

// Устарела. Для отражения в учете ввода начальных остатков ОС предусмотрен источник данных ВводОстатковОсновныхСредств
// см. БухгалтерскиеОперацииИсточникиДанных.ВводОстатковОсновныхСредств(...),
// см. БухгалтерскиеОперацииИсточникиДанных.ВводОстатковОсновныхСредствУСН(...).
//
Функция ВводНачальныхОстатков_ОС(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	Возврат Документы.ВводНачальныхОстатков.ПодготовитьТаблицуПроводок_ОС(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ);
КонецФункции

/////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ДОКУМЕНТ НАЧИСЛЕНИЕ АМОРТИЗАЦИИ ОС

// Устарела.
Функция НачислениеАмортизацииОС_СформироватьДвиженияБух(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты, Отказ)
	
	мТаблицаПроводок = ДокументОбъект.Движения.ЖурналПроводокЕПСБУ.ВыгрузитьКолонки();
	
	Отказ = СформироватьДвиженияНачислениеАмортизацииОС(ДокументОбъект, мТаблицаПроводок);

	Если Отказ Тогда
		мТаблицаПроводок.Очистить();
	КонецЕсли;
	
	Возврат мТаблицаПроводок;
	
КонецФункции

Функция СформироватьДвиженияНачислениеАмортизацииОС(ДокументОбъект, ПроводкиБУ)
	
	Отказ = Ложь;
	
	СтруктураШапкиДокумента = СформироватьСтруктуруШапкиДокумента(ДокументОбъект);
	
	ДокументОбъект.СуммаДокумента = 0;
	
	ТаблицыАмортизацииОСиНМА = УправлениеОсновнымиСредствами.РасчетАмортизацииОСиНМА(
		ДокументОбъект.Отбор.Выгрузить(), СтруктураШапкиДокумента, Отказ, Истина, Ложь);
	Если Отказ Тогда
		Возврат Отказ;
	КонецЕсли;
	
	Для Каждого СтрокаБУ Из ТаблицыАмортизацииОСиНМА.ТаблицаНачисленияАмортизацииБУ Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаБУ.СчетАмортизации) Тогда
			СтрокаБУ.СчетАмортизации = УправлениеОсновнымиСредствами.ВсеСчетаУчетаОС(СтрокаБУ.СчетУчета).СчетАмортизации;	
		КонецЕсли;
		
		// Начисление амортизации в БУ
		Проводка = ПроводкиБУ.Добавить();
		Проводка.Активность      = Истина;
		Проводка.Период          = СтруктураШапкиДокумента.Дата;
		Проводка.Организация     = СтруктураШапкиДокумента.Организация;
		Проводка.КФО             = СтрокаБУ.КФО;
		Проводка.ИФО             = СтруктураШапкиДокумента.ИФО;
	
		Проводка.СчетДт          = СтрокаБУ.СчетЗатрат;
		Проводка.КПСДт           = ?(ЗначениеЗаполнено(СтрокаБУ.КПСЗатрат), СтрокаБУ.КПСЗатрат, СтрокаБУ.КПС);
		Проводка.КЭКДт           = СтрокаБУ.КЭКЗатрат;
		БухгалтерскийУчет.УстановитьСубконто(Проводка, "Дт", 1, СтрокаБУ.СубконтоЗатрат1);
		БухгалтерскийУчет.УстановитьСубконто(Проводка, "Дт", 2, СтрокаБУ.СубконтоЗатрат2);
		БухгалтерскийУчет.УстановитьСубконто(Проводка, "Дт", 3, СтрокаБУ.СубконтоЗатрат3);
		Проводка.ПодразделениеДт = СтрокаБУ.ПодразделениеЗатрат;
		
		Проводка.СчетКт          = СтрокаБУ.СчетАмортизации;
		Проводка.КПСКт           = СтрокаБУ.КПС;
		Проводка.КЭККт		     = БухгалтерскиеОперации.КЭКСчета(Проводка.Организация, Проводка.ИФО, Проводка.КФО,
			Проводка.Период, Проводка.СчетКт, "Кт");
		БухгалтерскийУчет.УстановитьСубконто(Проводка, "Кт", "ОсновныеСредства", СтрокаБУ.ОсновноеСредство);
		Проводка.ПодразделениеКт = СтрокаБУ.Подразделение;
		
		Проводка.Сумма           = СтрокаБУ.СуммаАмортизацииБУ;
		
		Проводка.Содержание      = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru ='Начислена амортизация за текущий месяц инв. №:%1, %2'"),
			СокрП(СтрокаБУ.ИнвентарныйНомер), СтрокаБУ.ОсновноеСредство);
		Проводка.ЖурналОпераций  = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
		
		Проводка.ВидПервичногоДокумента   = ДокументОбъект.Метаданные().Синоним;
		Проводка.ДатаПервичногоДокумента  = ДокументОбъект.Дата;
		Проводка.НомерПервичногоДокумента = ДокументОбъект.Номер;
			
		ДокументОбъект.СуммаДокумента = ДокументОбъект.СуммаДокумента + СтрокаБУ.СуммаАмортизацииБУ;
		
	КонецЦикла;
	
	Для Каждого СтрокаНУ Из ТаблицыАмортизацииОСиНМА.ТаблицаНачисленияАмортизацииНУ Цикл
		
		// Начисление амортизации в НУ
		Проводка = ПроводкиБУ.Добавить();
		Проводка.Активность      = Истина;
		Проводка.Период          = СтруктураШапкиДокумента.Дата;
		Проводка.Организация     = СтруктураШапкиДокумента.Организация;
		Проводка.КФО             = СтрокаНУ.КФО;
		Проводка.ИФО             = СтруктураШапкиДокумента.ИФО;
	
		Проводка.СчетКт = СтрокаНУ.СчетАмортизацииНУ;
		
		БухгалтерскийУчет.УстановитьСубконто(Проводка, "Кт", "ОсновныеСредства", СтрокаНУ.ОсновноеСредство);
		
		Проводка.СчетДт = СтрокаНУ.СчетЗатратНУ;
		
		СвойстваСчетаЗатрат = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаНУ.СчетЗатрат);
		
		БухгалтерскийУчет.УстановитьСубконто(
			Проводка, "Дт", СвойстваСчетаЗатрат.ВидСубконто1, СтрокаНУ.СубконтоЗатрат1);
		БухгалтерскийУчет.УстановитьСубконто(
			Проводка, "Дт", СвойстваСчетаЗатрат.ВидСубконто2, СтрокаНУ.СубконтоЗатрат2);
		БухгалтерскийУчет.УстановитьСубконто(
			Проводка, "Дт", СвойстваСчетаЗатрат.ВидСубконто3, СтрокаНУ.СубконтоЗатрат3);
		БухгалтерскийУчет.УстановитьСубконто(Проводка, "Дт", "ПрочиеДоходыИРасходы", СтрокаНУ.СубконтоЗатратНУ);
		БухгалтерскийУчет.УстановитьСубконто(Проводка, "Дт", "РеализуемыеАктивы", СтрокаНУ.ОсновноеСредство);
		
		Проводка.Сумма                = СтрокаНУ.СуммаАмортизацииНУ;
		Проводка.СуммаНеУчитываетсяНУ = СтрокаНУ.СуммаАмортизацииНеУчитываетсяНУ;
		Проводка.СуммаЕНВД            = СтрокаНУ.СуммаАмортизацииЕНВД;
		
		Проводка.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru ='Начислена амортизация за текущий месяц инв. №:%1, %2'"),
				СокрП(СтрокаНУ.ИнвентарныйНомер),
				СтрокаНУ.ОсновноеСредство);
		Проводка.ЖурналОпераций  = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
		
		Проводка.ВидПервичногоДокумента   = ДокументОбъект.Метаданные().Синоним;
		Проводка.ДатаПервичногоДокумента  = ДокументОбъект.Дата;
		Проводка.НомерПервичногоДокумента = ДокументОбъект.Номер;
		
		Если СтрокаНУ.СуммаКапитальныхВложенийВключаемыхВРасходы > 0 Тогда
			
			// Проверяем счет затрат по амортизационной премии.
			Если НЕ ЗначениеЗаполнено(СтрокаНУ.СчетЗатратПоАмортизационнойПремии) Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'В документе %1 не заполнен счет учета расходов по амортизационной премии для основного средства ""%2"".
						|
						|Заполните счет учета расходов по амортизационной премии в документе.'"),
						СтрокаНУ.ДокументАмортизационнойПремии,
						СтрокаНУ.ОсновноеСредство);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, СтрокаНУ.ДокументАмортизационнойПремии);
				Отказ = Истина;
				Продолжить;
			КонецЕсли;
			
			// Проверяем аналитику амортизационной премии.
			СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаНУ.СчетЗатратПоАмортизационнойПремии);
			Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
				Если СвойстваСчета["ВидСубконто" + НомерСубконто + "Обязательный"]
				   И НЕ ЗначениеЗаполнено(СтрокаНУ["СубконтоПоАмортизационнойПремии"+НомерСубконто])
				Тогда
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'В документе %1 не заполнена аналитика учета расходов по амортизационной премии для основного средства ""%2"".
							|
							|Заполните аналитику учета расходов по амортизационной премии в документе.'"),
							СтрокаНУ.ДокументАмортизационнойПремии,
							СтрокаНУ.ОсновноеСредство);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, СтрокаНУ.ДокументАмортизационнойПремии);
					Отказ = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			// Списываем амортизационную премию со счета НКВ
			Проводка = ПроводкиБУ.Добавить();
			Проводка.Активность      = Истина;
			Проводка.Период          = СтруктураШапкиДокумента.Дата;
			Проводка.Организация     = СтруктураШапкиДокумента.Организация;
			Проводка.КФО             = СтрокаНУ.КФО;
			Проводка.ИФО             = СтруктураШапкиДокумента.ИФО;

			Проводка.СчетКт = БухгалтерскийУчет.СчетПоКоду("НКВ", СтруктураШапкиДокумента.Дата,
				СтруктураШапкиДокумента.Организация);
			БухгалтерскийУчет.УстановитьСубконто(Проводка, "Кт", "ОсновныеСредства", СтрокаНУ.ОсновноеСредство);
			БухгалтерскийУчет.УстановитьСубконто(Проводка, "Кт", "ДокументыАмортизационнойПремии",
				СтрокаНУ.ДокументАмортизационнойПремии);

			Проводка.Сумма = СтрокаНУ.СуммаКапитальныхВложенийВключаемыхВРасходы;

			Проводка.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru ='Амортизационная премия инв. №:%1, %2'"),
					СокрП(СтрокаНУ.ИнвентарныйНомер),
					СтрокаНУ.ОсновноеСредство);
			Проводка.ЖурналОпераций  = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
			
			Проводка.ВидПервичногоДокумента   = ДокументОбъект.Метаданные().Синоним;
			Проводка.ДатаПервичногоДокумента  = ДокументОбъект.Дата;
			Проводка.НомерПервичногоДокумента = ДокументОбъект.Номер;

			// Начисляем амортизационную премию.
			Проводка = ПроводкиБУ.Добавить();
			Проводка.Активность      = Истина;
			Проводка.Период          = СтруктураШапкиДокумента.Дата;
			Проводка.Организация     = СтруктураШапкиДокумента.Организация;
			Проводка.КФО             = СтрокаНУ.КФО;
			Проводка.ИФО             = СтруктураШапкиДокумента.ИФО;

			Проводка.СчетДт = СтрокаНУ.СчетЗатратПоАмортизационнойПремии;
			БухгалтерскийУчет.УстановитьСубконто(Проводка, "Дт", 1, СтрокаНУ.СубконтоПоАмортизационнойПремии1);
			БухгалтерскийУчет.УстановитьСубконто(Проводка, "Дт", 2, СтрокаНУ.СубконтоПоАмортизационнойПремии2);
			БухгалтерскийУчет.УстановитьСубконто(Проводка, "Дт", 3, СтрокаНУ.СубконтоПоАмортизационнойПремии3);

			Проводка.СчетКт = СтрокаНУ.СчетУчетаНУ;
			БухгалтерскийУчет.УстановитьСубконто(Проводка, "Кт", "ОсновныеСредства", СтрокаНУ.ОсновноеСредство);

			Проводка.Сумма = СтрокаНУ.СуммаКапитальныхВложенийВключаемыхВРасходы;

			Проводка.Содержание      = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru ='Амортизационная премия инв. №:%1, %2'"),
				СокрП(СтрокаНУ.ИнвентарныйНомер), СтрокаНУ.ОсновноеСредство);
			Проводка.ЖурналОпераций  = БухгалтерскийУчетПовтИсп.НомерЖурнала(Проводка.СчетДт, Проводка.СчетКт);
			
			Проводка.ВидПервичногоДокумента   = ДокументОбъект.Метаданные().Синоним;
			Проводка.ДатаПервичногоДокумента  = ДокументОбъект.Дата;
			Проводка.НомерПервичногоДокумента = ДокументОбъект.Номер;
			
		КонецЕсли;

	КонецЦикла;
	
	Если ПроводкиБУ.Количество()=0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не найдено объектов для начисления амортизации.'"));
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции

// Формирует структуру, содержащую значения реквизитов шапки документа.
//
// Параметры: 
//  ДокументОбъект - объект документа для формирования структуры шапки, 
//
// Возвращаемое значение:
//  Сформированная структура.
//
Функция СформироватьСтруктуруШапкиДокумента(ДокументОбъект)

	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();

	// Первоначальные данные о документе.
	СтруктураШапкиДокумента = Новый Структура;
	СтруктураШапкиДокумента.Вставить("Ссылка", ДокументОбъект.Ссылка);
	СтруктураШапкиДокумента.Вставить("Дата",   ДокументОбъект.Дата);
	СтруктураШапкиДокумента.Вставить("Номер",  ДокументОбъект.Номер);

	МетаданныеДокумента = ДокументОбъект.Метаданные();
	СтруктураШапкиДокумента.Вставить("ВидДокумента",  МетаданныеДокумента.Имя);
	СтруктураШапкиДокумента.Вставить("ПредставлениеВидаДокумента",  МетаданныеДокумента.Представление());
    
	Для каждого Реквизит из МетаданныеДокумента.Реквизиты Цикл
		СтруктураШапкиДокумента.Вставить(Реквизит.Имя, ДокументОбъект[Реквизит.Имя]);
	КонецЦикла;

	// Отображение данных о валютах.
	СтруктураШапкиДокумента.Вставить("ВалютаРегламентированногоУчета", ВалютаРегламентированногоУчета);	

	Возврат СтруктураШапкиДокумента;

КонецФункции // СформироватьСтруктуруШапкиДокумента()


