
#Область СлужебныйПрограммныйИнтерфейс

#Область ЗагрузкаМестонахождения

Процедура ЗагрузитьМестонахождение(Организация, СодержимоеОтветов) Экспорт
	
	Результат = Новый ДеревоЗначений;
	Результат.Колонки.Добавить("Код",			, Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("Наименование"	, Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(256)));
	Результат.Колонки.Добавить("Тип"			, Новый ОписаниеТипов("ПеречислениеСсылка.ТипыМестонахожденияФРМО"));
	Результат.Колонки.Добавить("Здания"			, Новый ОписаниеТипов("Массив"));
	
	// Здания (до подразделений - порядок важен)
	
	Для Каждого СтрокаЗдание Из СодержимоеОтветов.Здания Цикл
		
		СтрокаЗданиеРезультат = Результат.Строки.Добавить();
		СтрокаЗданиеРезультат.Тип = Перечисления.ТипыМестонахожденияФРМО.Здание;
		СтрокаЗданиеРезультат.Код = СтрокаЗдание.id;
		СтрокаЗданиеРезультат.Наименование = СтрокаЗдание.buildName;
		
		Для Каждого СтрокаЭтаж Из СтрокаЗдание.floors Цикл
			
			СтрокаЭтажРезультат = СтрокаЗданиеРезультат.Строки.Добавить();
			СтрокаЭтажРезультат.Тип = Перечисления.ТипыМестонахожденияФРМО.Этаж;
			СтрокаЭтажРезультат.Код = СтрокаЭтаж.floorId;
			СтрокаЭтажРезультат.Наименование = СтрокаЭтаж.floor;
			
			Для Каждого СтрокаПомещение Из СтрокаЭтаж.rooms Цикл
				
				СтрокаПомещениеРезультат = СтрокаЭтажРезультат.Строки.Добавить();
				СтрокаПомещениеРезультат.Тип = Перечисления.ТипыМестонахожденияФРМО.Помещение;
				СтрокаПомещениеРезультат.Код = СтрокаПомещение.roomId;
				СтрокаПомещениеРезультат.Наименование = СтрокаПомещение.roomName;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Подразделения
	
	Для Каждого СтрокаПодразделение Из СодержимоеОтветов.Подразделения Цикл
		
		СтрокаПодразделениеРезультат = Результат.Строки.Добавить();
		СтрокаПодразделениеРезультат.Тип = Перечисления.ТипыМестонахожденияФРМО.Подразделение;
		СтрокаПодразделениеРезультат.Код = СтрокаПодразделение.oid;
		СтрокаПодразделениеРезультат.Наименование = СтрокаПодразделение.departName;
		
		Для Каждого СтрокаЗдание Из СтрокаПодразделение.departBuildings Цикл
			СтрокаПодразделениеРезультат.Здания.Добавить(СтрокаЗдание.buildingId);
		КонецЦикла;
		
		// Отделения стационарных подразделений
		Если СтрокаПодразделение.departHospital <> Неопределено Тогда
			Для Каждого СтрокаОтделение Из СтрокаПодразделение.departHospital.hospitalSubdivision Цикл
				
				СтрокаОтделениеРезультат = СтрокаПодразделениеРезультат.Строки.Добавить();
				СтрокаОтделениеРезультат.Тип = Перечисления.ТипыМестонахожденияФРМО.Отделение;
				СтрокаОтделениеРезультат.Код = СтрокаОтделение.oid;
				СтрокаОтделениеРезультат.Наименование = СтрокаОтделение.subdivisionName;
				
				Для Каждого СтрокаЗдание Из СтрокаОтделение.buildings Цикл
					СтрокаОтделениеРезультат.Здания.Добавить(СтрокаЗдание.id);
				КонецЦикла;
				
			КонецЦикла;
		КонецЕсли;
		
		// Врачебные кабинеты амбулаторных подразделений
		Если СтрокаПодразделение.departReg <> Неопределено Тогда
			Для Каждого СтрокаКабинет Из СтрокаПодразделение.departReg.room Цикл
				
				СтрокаКабинетРезультат = СтрокаПодразделениеРезультат.Строки.Добавить();
				СтрокаКабинетРезультат.Тип = Перечисления.ТипыМестонахожденияФРМО.Кабинет;
				СтрокаКабинетРезультат.Код = СтрокаКабинет.oid;
				СтрокаКабинетРезультат.Наименование = СтрокаКабинет.subdivisionId.subdivision;
				
				Для Каждого СтрокаЗдание Из СтрокаКабинет.buildings Цикл
					СтрокаКабинетРезультат.Здания.Добавить(СтрокаЗдание.id);
				КонецЦикла;
				
			КонецЦикла;
		КонецЕсли;
		
		// Диагностические кабинеты лабораторно-диагностических или инструментально-диагностических подразделений
		Если СтрокаПодразделение.departLabs <> Неопределено Тогда
			Для Каждого СтрокаКабинет Из СтрокаПодразделение.departLabs Цикл
				
				СтрокаКабинетРезультат = СтрокаПодразделениеРезультат.Строки.Добавить();
				СтрокаКабинетРезультат.Тип = Перечисления.ТипыМестонахожденияФРМО.Кабинет;
				СтрокаКабинетРезультат.Код = СтрокаКабинет.labOid;
				СтрокаКабинетРезультат.Наименование = СтрокаКабинет.roomTypeId.subdivision;
				
				Для Каждого СтрокаЗдание Из СтрокаКабинет.buildings Цикл
					СтрокаКабинетРезультат.Здания.Добавить(СтрокаЗдание.id);
				КонецЦикла;
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МестонахождениеФРМО.Идентификатор КАК Идентификатор,
	|	МестонахождениеФРМО.Тип КАК Тип,
	|	МестонахождениеФРМО.Ссылка КАК Ссылка,
	|	МестонахождениеФРМО.ПометкаУдаления КАК ПометкаУдаления,
	|	ЛОЖЬ КАК Просмотрен
	|ИЗ
	|	Справочник.МестонахождениеФРМО КАК МестонахождениеФРМО
	|ГДЕ
	|	МестонахождениеФРМО.Организация = &Организация";
	
	ЭлементыСправочника = Запрос.Выполнить().Выгрузить();
	ЭлементыЗдания = Новый Соответствие;
	
	СоздатьЭлементыМестонахождения(Результат.Строки, ЭлементыСправочника, ЭлементыЗдания, Организация);
	
	ПометитьНеАктуальныеЭлементыМестонахождения(ЭлементыСправочника);
	
КонецПроцедуры

Функция СоздатьЭлементыМестонахождения(СтрокиДерева, ЭлементыСправочника, ЭлементыЗдания, Организация, Родитель = Неопределено)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		ЭлементСправочника = ПолучитьСоздатьЭлементМестонахождения(СтрокаДерева, ЭлементыСправочника, ЭлементыЗдания, Организация, Родитель);
		СоздатьЭлементыМестонахождения(СтрокаДерева.Строки, ЭлементыСправочника, ЭлементыЗдания, Организация, ЭлементСправочника);
	КонецЦикла;
	
КонецФункции

Функция ПолучитьСоздатьЭлементМестонахождения(СтрокаДанных, ЭлементыСправочника, ЭлементыЗдания, Организация, Родитель = Неопределено)
	
	Отбор = Новый Структура("Идентификатор,Тип", СтрокаДанных.Код, СтрокаДанных.Тип);
	Результат = ЭлементыСправочника.НайтиСтроки(Отбор);
	
	Если Результат.Количество() > 0 Тогда
		
		СтрокаТаблицы = Результат[0];
		
		Если СтрокаТаблицы.Просмотрен Тогда
			Возврат СтрокаТаблицы.Ссылка;
		КонецЕсли;
		
		ЭлементОбъект = СтрокаТаблицы.Ссылка.ПолучитьОбъект();
		
	Иначе
		
		СтрокаТаблицы = Неопределено;
		ЭлементОбъект = Справочники.МестонахождениеФРМО.СоздатьЭлемент();
		
	КонецЕсли;
	
	ЭлементОбъект.Тип				= СтрокаДанных.Тип;
	ЭлементОбъект.Идентификатор		= СтрокаДанных.Код;
	ЭлементОбъект.Наименование		= СтрокаДанных.Наименование;
	ЭлементОбъект.Организация		= Организация;
	ЭлементОбъект.Родитель			= ?(Родитель = Неопределено, Справочники.МестонахождениеФРМО.ПустаяСсылка(), Родитель);
	ЭлементОбъект.ПометкаУдаления	= Ложь;
	
	ЭлементОбъект.ЗданияПодразделения.Очистить();
	
	Для Каждого ИдЗдания Из СтрокаДанных.Здания Цикл
		ЗданиеСсылка = ЭлементыЗдания[ИдЗдания];
		Если ЗданиеСсылка <> Неопределено Тогда
			НоваяСтрокаЗдание = ЭлементОбъект.ЗданияПодразделения.Добавить();
			НоваяСтрокаЗдание.Здание = ЗданиеСсылка;
		КонецЕсли;
	КонецЦикла;
	
	ЭлементОбъект.Записать();
	
	Если СтрокаТаблицы = Неопределено Тогда
		СтрокаТаблицы				= ЭлементыСправочника.Добавить();
		СтрокаТаблицы.Тип			= СтрокаДанных.Тип;
		СтрокаТаблицы.Идентификатор	= СтрокаДанных.Код;
		СтрокаТаблицы.Ссылка		= ЭлементОбъект.Ссылка;
	КонецЕсли;
	
	СтрокаТаблицы.Просмотрен = Истина;
	
	Если СтрокаДанных.Тип = Перечисления.ТипыМестонахожденияФРМО.Здание Тогда
		ЭлементыЗдания.Вставить(СтрокаТаблицы.Идентификатор, СтрокаТаблицы.Ссылка);
	КонецЕсли;
	
	Возврат СтрокаТаблицы.Ссылка;
	
КонецФункции

Функция ПометитьНеАктуальныеЭлементыМестонахождения(ЭлементыСправочника)
	
	Для Каждого Элемент Из ЭлементыСправочника Цикл
		Если Не Элемент.Просмотрен И Не Элемент.ПометкаУдаления Тогда
			ЭлементОбъект = Элемент.Ссылка.ПолучитьОбъект();
			ЭлементОбъект.ПометкаУдаления = Истина;
			ЭлементОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

#КонецОбласти

#Область ЗагрузкаОборудования

Функция ЗагрузитьОборудование(Организация, СписокОборудования) Экспорт
	
	ТЧОборудование = Новый ТаблицаЗначений;
	ТЧОборудование.Колонки.Добавить("НомерСтроки"		, Новый ОписаниеТипов("Число"));
	ТЧОборудование.Колонки.Добавить("Идентификатор"		, Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	ТЧОборудование.Колонки.Добавить("ИнвентарныйНомер"	, Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(30)));
	ТЧОборудование.Колонки.Добавить("Данные"			, Новый ОписаниеТипов("Структура"));
	
	Счетчик = 1;
	
	Для Каждого СтрокаОборудование Из СписокОборудования Цикл
		
		НоваяСтрока						= ТЧОборудование.Добавить();
		НоваяСтрока.НомерСтроки			= Счетчик;
		НоваяСтрока.Идентификатор		= СтрокаОборудование.Идентификатор;
		НоваяСтрока.ИнвентарныйНомер	= СтрокаОборудование.ИнвентарныйНомер;
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Таблица", ТЧОборудование);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВТ.Идентификатор КАК Идентификатор,
	|	ВТ.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ВТОборудование
	|ИЗ
	|	&Таблица КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Реестр.ОсновноеСредство ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьДанныеБГУ,
	|	ЕСТЬNULL(Реестр.ОсновноеСредство, ПодборОСиИнвНомера.ОС) КАК ОсновноеСредство,
	|	ЕСТЬNULL(Реестр.ИнвентарныйНомер, ПодборОСиИнвНомера.Ссылка) КАК ИнвентарныйНомер,
	|	Реестр.Идентификатор КАК Идентификатор,
	|	Реестр.ТипОборудования КАК ТипОборудованияСсылка,
	|	ПРЕДСТАВЛЕНИЕ(Реестр.ТипОборудования) КАК ТипОборудования,
	|	Реестр.РазделИзделия.КодМинздрава КАК РазделИзделияКод,
	|	Реестр.РазделИзделия.Описание КАК РазделИзделияНаименование,
	|	Реестр.ТипИзделия.КодМинздрава КАК ТипИзделияКод,
	|	Реестр.ТипИзделия.Наименование КАК ТипИзделияНаименование,
	|	Реестр.ТребуетсяЗамена КАК ТребуетсяЗамена,
	|	Реестр.Общее КАК Общее,
	|	Реестр.НомерУдостоверения КАК НомерУдостоверения,
	|	Реестр.ДатаРегистрации КАК ДатаРегистрации,
	|	Реестр.Модель КАК Модель,
	|	Реестр.Производитель КАК Производитель,
	|	Реестр.СтранаПроизводства КАК СтранаПроизводства,
	|	Реестр.Адрес КАК Адрес,
	|	Реестр.ИнойАдрес КАК ИнойАдрес,
	|	Реестр.ПричинаИногоАдреса КАК ПричинаИногоАдреса,
	|	Реестр.Здание.Идентификатор КАК ЗданиеКод,
	|	Реестр.Здание.Наименование КАК ЗданиеНаименование,
	|	Реестр.Подразделение.Идентификатор КАК ПодразделениеКод,
	|	Реестр.Подразделение.Наименование КАК ПодразделениеНаименование,
	|	Реестр.Наименование КАК Наименование,
	|	Реестр.ИнвентарныйНомерКод КАК ИнвентарныйНомерКод,
	|	Реестр.СерийныйНомер КАК СерийныйНомер,
	|	Реестр.ДатаВыпуска КАК ДатаВыпуска,
	|	Реестр.СрокСлужбы КАК СрокСлужбы,
	|	Реестр.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	|	Реестр.ДатаВыводаИзЭксплуатации КАК ДатаВыводаИзЭксплуатации,
	|	Реестр.ПричинаВыводаИзЭксплуатации КАК ПричинаВыводаИзЭксплуатации,
	|	Реестр.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ВТОборудование.НомерСтроки ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьДанныеФРМО,
	|	ВТОборудование.НомерСтроки КАК НомерСтрокиФРМО
	|ИЗ
	|	РегистрСведений.МедицинскоеОборудованиеФРМО КАК Реестр
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТОборудование КАК ВТОборудование
	|		ПО (Реестр.Идентификатор = ВТОборудование.Идентификатор
	|				ИЛИ Реестр.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|					И (ВЫРАЗИТЬ(Реестр.ИнвентарныйНомерКод КАК СТРОКА(1000))) = ВТОборудование.ИнвентарныйНомер)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ПодборОСиИнвНомера
	|		ПО (ВТОборудование.ИнвентарныйНомер = СОКРП(ПодборОСиИнвНомера.Код))
	|			И (ПодборОСиИнвНомера.Владелец = &Организация)
	|ГДЕ
	|	(Реестр.Организация ЕСТЬ NULL
	|			ИЛИ Реестр.Организация = &Организация)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МестонахождениеМО.ОсновноеСредство КАК ОсновноеСредство,
	|	МестонахождениеМО.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	МестонахождениеМО.Местонахождение.Идентификатор КАК Идентификатор,
	|	МестонахождениеМО.Местонахождение.Наименование КАК Наименование,
	|	МестонахождениеМО.Местонахождение.Тип КАК Тип,
	|	МестонахождениеМО.Местонахождение.Родитель КАК Родитель,
	|	МестонахождениеМО.Местонахождение.Родитель.Идентификатор КАК РодительИдентификатор,
	|	МестонахождениеМО.Местонахождение.Родитель.Наименование КАК РодительНаименование
	|ИЗ
	|	РегистрСведений.МестонахождениеМедицинскогоОборудованияФРМО КАК МестонахождениеМО
	|ГДЕ
	|	МестонахождениеМО.Организация = &Организация";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаМО = РезультатЗапроса[1].Выбрать();
	ТаблицаМестонахождение = РезультатЗапроса[2].Выгрузить();
	
	Результат = Новый Массив;
	
	Пока ВыборкаМО.Следующий() Цикл
		
		ДанныеБГУ  = СформироватьДанныеСтрокиБГУ(ВыборкаМО, ТаблицаМестонахождение);
		ДанныеФРМО = СформироватьДанныеСтрокиФРМО(ВыборкаМО, СписокОборудования);
		
		НоваяСтрока = ИнтеграцияФРМОКлиентСервер.ОписаниеОперацииОборудования();
		
		НоваяСтрока.ОсновноеСредствоБГУ  = ВыборкаМО.ОсновноеСредство;
		НоваяСтрока.ИнвентарныйНомерБГУ  = ВыборкаМО.ИнвентарныйНомер;
		НоваяСтрока.ОсновноеСредствоФРМО = ?(ВыборкаМО.ЕстьДанныеФРМО, ДанныеФРМО.Наименование, "");
		НоваяСтрока.ИнвентарныйНомерФРМО = ?(ВыборкаМО.ЕстьДанныеФРМО, ИнвентарыйНомерФРМО(ДанныеФРМО.ИнвентарныйНомер), "");
		НоваяСтрока.ДанныеБГУ            = ДанныеБГУ;
		НоваяСтрока.ДанныеФРМО           = ДанныеФРМО;
		
		ОпределитьСтатусИОперациюСтроки(НоваяСтрока);
		
		Результат.Добавить(НоваяСтрока);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИнвентарыйНомерФРМО(ИнвентарныйНомер)
	
	Если ИнтеграцияФРМОКлиентСервер.ЭтоПустойНомер(ИнвентарныйНомер) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ИнвентарныйНомер;
	
КонецФункции

Процедура ОпределитьСтатусИОперациюСтроки(СтрокаТаблицы)
	
	Если СтрокаТаблицы.ДанныеФРМО = Неопределено Тогда
		СтрокаТаблицы.Статус = 2; // Только в БГУ
	ИначеЕсли СтрокаТаблицы.ДанныеБГУ = Неопределено Тогда
		СтрокаТаблицы.Статус = 3; // Только в ФРМО
	ИначеЕсли ДанныеСовпадают(СтрокаТаблицы) Тогда
		СтрокаТаблицы.Статус = 0;
	Иначе
		СтрокаТаблицы.Статус = 1;
	КонецЕсли;
	
	Если СтрокаТаблицы.Статус = 0 Тогда
		СтрокаТаблицы.Операция = 4;
		СтрокаТаблицы.Результат = 4;
	ИначеЕсли СтрокаТаблицы.Статус = 2 Тогда
		СтрокаТаблицы.Операция = 1;
	ИначеЕсли СтрокаТаблицы.Статус = 3 Тогда
		СтрокаТаблицы.Операция = 2;
	КонецЕсли;
	
КонецПроцедуры

// Чтение данных из ФРМО

Функция СформироватьДанныеСтрокиФРМО(ВыборкаМО, СписокОборудования)
	
	Если Не ВыборкаМО.ЕстьДанныеФРМО Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СписокОборудования[ВыборкаМО.НомерСтрокиФРМО-1];
	
КонецФункции

// Формирование данных из БГУ

Функция ПолучитьДанныеБГУ(Организация, ОсновноеСредство, ИнвентарныйНомер) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвентарныйНомер"	, ИнвентарныйНомер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИСТИНА КАК ЕстьДанныеБГУ,
	|	Реестр.ОсновноеСредство КАК ОсновноеСредство,
	|	Реестр.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Реестр.Идентификатор КАК Идентификатор,
	|	Реестр.ТипОборудования КАК ТипОборудованияСсылка,
	|	ПРЕДСТАВЛЕНИЕ(Реестр.ТипОборудования) КАК ТипОборудования,
	|	Реестр.РазделИзделия.КодМинздрава КАК РазделИзделияКод,
	|	Реестр.РазделИзделия.Описание КАК РазделИзделияНаименование,
	|	Реестр.ТипИзделия.КодМинздрава КАК ТипИзделияКод,
	|	Реестр.ТипИзделия.Наименование КАК ТипИзделияНаименование,
	|	Реестр.ТребуетсяЗамена КАК ТребуетсяЗамена,
	|	Реестр.Общее КАК Общее,
	|	Реестр.НомерУдостоверения КАК НомерУдостоверения,
	|	Реестр.ДатаРегистрации КАК ДатаРегистрации,
	|	Реестр.Модель КАК Модель,
	|	Реестр.Производитель КАК Производитель,
	|	Реестр.СтранаПроизводства КАК СтранаПроизводства,
	|	Реестр.Адрес КАК Адрес,
	|	Реестр.ИнойАдрес КАК ИнойАдрес,
	|	Реестр.ПричинаИногоАдреса КАК ПричинаИногоАдреса,
	|	Реестр.Здание.Идентификатор КАК ЗданиеКод,
	|	Реестр.Здание.Наименование КАК ЗданиеНаименование,
	|	Реестр.Подразделение.Идентификатор КАК ПодразделениеКод,
	|	Реестр.Подразделение.Наименование КАК ПодразделениеНаименование,
	|	Реестр.Наименование КАК Наименование,
	|	Реестр.ИнвентарныйНомерКод КАК ИнвентарныйНомерКод,
	|	Реестр.СерийныйНомер КАК СерийныйНомер,
	|	Реестр.ДатаВыпуска КАК ДатаВыпуска,
	|	Реестр.СрокСлужбы КАК СрокСлужбы,
	|	Реестр.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	|	Реестр.ДатаВыводаИзЭксплуатации КАК ДатаВыводаИзЭксплуатации,
	|	Реестр.ПричинаВыводаИзЭксплуатации КАК ПричинаВыводаИзЭксплуатации,
	|	Реестр.Количество КАК Количество
	|ИЗ
	|	РегистрСведений.МедицинскоеОборудованиеФРМО КАК Реестр
	|ГДЕ
	|	Реестр.Организация = &Организация
	|	И Реестр.ОсновноеСредство = &ОсновноеСредство
	|	И Реестр.ИнвентарныйНомер = &ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МестонахождениеМО.ОсновноеСредство КАК ОсновноеСредство,
	|	МестонахождениеМО.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	МестонахождениеМО.Местонахождение.Идентификатор КАК Идентификатор,
	|	МестонахождениеМО.Местонахождение.Наименование КАК Наименование,
	|	МестонахождениеМО.Местонахождение.Тип КАК Тип,
	|	МестонахождениеМО.Местонахождение.Родитель КАК Родитель,
	|	МестонахождениеМО.Местонахождение.Родитель.Идентификатор КАК РодительИдентификатор,
	|	МестонахождениеМО.Местонахождение.Родитель.Наименование КАК РодительНаименование
	|ИЗ
	|	РегистрСведений.МестонахождениеМедицинскогоОборудованияФРМО КАК МестонахождениеМО
	|ГДЕ
	|	МестонахождениеМО.Организация = &Организация
	|	И МестонахождениеМО.ОсновноеСредство = &ОсновноеСредство
	|	И МестонахождениеМО.ИнвентарныйНомер = &ИнвентарныйНомер";
	
	Результат = Запрос.ВыполнитьПакет();
	ВыборкаМО = Результат[0].Выбрать();
	ТаблицаМестонахождение = Результат[1].Выгрузить();
	
	ДанныеБГУ = Неопределено;
	
	Пока ВыборкаМО.Следующий() Цикл
		ДанныеБГУ = СформироватьДанныеСтрокиБГУ(ВыборкаМО, ТаблицаМестонахождение);
	КонецЦикла;
	
	Возврат ДанныеБГУ;
	
КонецФункции

Функция СформироватьДанныеСтрокиБГУ(ВыборкаМО, ТаблицаМестонахождение)
	
	Если Не ВыборкаМО.ЕстьДанныеБГУ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = ИнтеграцияФРМОКлиентСервер.ОписаниеМедицинскогоОборудования();
	
	ЗаполнитьЗначенияСвойств(Результат, ВыборкаМО);
	
	Если ЗначениеЗаполнено(ВыборкаМО.РазделИзделияКод) Тогда
		Результат.РазделИзделия = Новый Структура("Код,Наименование", ВыборкаМО.РазделИзделияКод, ВыборкаМО.РазделИзделияНаименование);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВыборкаМО.ТипИзделияКод) Тогда
		Результат.ТипИзделия = Новый Структура("Код,Наименование", ВыборкаМО.ТипИзделияКод, ВыборкаМО.ТипИзделияНаименование);
	КонецЕсли;
	
	Результат.ИнвентарныйНомер	= ВыборкаМО.ИнвентарныйНомерКод;
	Результат.Здание			= СформироватьДанныеЗдание(ВыборкаМО, ТаблицаМестонахождение);
	Результат.Подразделение		= СформироватьДанныеПодразделение(ВыборкаМО, ТаблицаМестонахождение);
	Результат.Адрес				= СформироватьДанныеАдрес(ВыборкаМО);
	
	Для Каждого Свойство Из Результат Цикл
		Если Не ЗначениеЗаполнено(Свойство.Значение) Тогда
			Результат[Свойство.Ключ] = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьДанныеЗдание(Данные, ТаблицаМестонахождение)
	
	Если Данные.ИнойАдрес Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура("Код,Наименование", Данные.ЗданиеКод, Данные.ЗданиеНаименование);
	Результат.Вставить("Этажи", Новый Массив);
	
	Отбор = Новый Структура("ОсновноеСредство,ИнвентарныйНомер", Данные.ОсновноеСредство, Данные.ИнвентарныйНомер);
	СтрокиМестонахождение = ТаблицаМестонахождение.НайтиСтроки(Отбор);
	
	ЭтажиСоответствие = Новый Соответствие;
	
	Для Каждого СтрокаМестонахождение Из СтрокиМестонахождение Цикл
		Если СтрокаМестонахождение.Тип = Перечисления.ТипыМестонахожденияФРМО.Помещение Тогда
			Этаж = ЭтажиСоответствие[СтрокаМестонахождение.Родитель];
			Если Этаж = Неопределено Тогда
				Этаж = Новый Структура("Код,Наименование,Помещения",
					СтрокаМестонахождение.РодительИдентификатор, СтрокаМестонахождение.РодительНаименование, Новый Массив);
				ЭтажиСоответствие.Вставить(СтрокаМестонахождение.Родитель, Этаж);
			КонецЕсли;
			Этаж.Помещения.Добавить(Новый Структура("Код,Наименование", СтрокаМестонахождение.Идентификатор, СтрокаМестонахождение.Наименование));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаЭтаж Из ЭтажиСоответствие Цикл
		Результат.Этажи.Добавить(СтрокаЭтаж.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьДанныеПодразделение(Данные, ТаблицаМестонахождение)
	
	Если Данные.ИнойАдрес Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура("Код,Наименование", Данные.ПодразделениеКод, Данные.ПодразделениеНаименование);
	Результат.Вставить("Отделения", Новый Массив);
	Результат.Вставить("Кабинеты", Новый Массив);
	
	Отбор = Новый Структура("ОсновноеСредство,ИнвентарныйНомер", Данные.ОсновноеСредство, Данные.ИнвентарныйНомер);
	СтрокиМестонахождение = ТаблицаМестонахождение.НайтиСтроки(Отбор);
	
	Для Каждого СтрокаМестонахождение Из СтрокиМестонахождение Цикл
		
		НоваяСтрока = Новый Структура("Код,Наименование", СтрокаМестонахождение.Идентификатор, СтрокаМестонахождение.Наименование);
		
		Если СтрокаМестонахождение.Тип = Перечисления.ТипыМестонахожденияФРМО.Отделение Тогда
			Результат.Отделения.Добавить(НоваяСтрока);
		ИначеЕсли СтрокаМестонахождение.Тип = Перечисления.ТипыМестонахожденияФРМО.Кабинет Тогда
			Результат.Кабинеты.Добавить(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьДанныеАдрес(Данные)
	
	Если Не ЗначениеЗаполнено(Данные.Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.JSONВЗначение(Данные.Адрес,, Ложь);
	
КонецФункции

Функция РегионФедеральногоЗначения(КодРегиона)
	
	// По классификатору "Субъекты Российской Федерации"
	// https://nsi.rosminzdrav.ru/dictionaries/1.2.643.5.1.13.13.99.2.206
	
	ФедеральныеРегионы = Новый Массив;
	ФедеральныеРегионы.Добавить(77); // г. Москва
	ФедеральныеРегионы.Добавить(78); // г. Санкт-Петербург
	ФедеральныеРегионы.Добавить(92); // г. Севастополь
	ФедеральныеРегионы.Добавить(99); // г. Байконур
	
	Возврат (ФедеральныеРегионы.Найти(КодРегиона) <> Неопределено);
	
КонецФункции

Функция АдресБГУвФРМО(Адрес) Экспорт
	
	Результат = Новый Структура("Значение,Представление", "", "");
	
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Поля = ОбщегоНазначения.JSONВЗначение(Адрес,, Ложь);
	
	КодРегиона = АдресныйКлассификатор.КодРегионаПоНаименованию(Поля.area);
	
	Регион = Новый Структура;
	Регион.Вставить("Код"			, КодРегиона);
	Регион.Вставить("КодРегиона"	, КодРегиона);
	Регион.Вставить("Федеральный"	, РегионФедеральногоЗначения(КодРегиона));
	
	ЭтоМуниципальныйАдрес = РаботаСАдресамиКлиентСервер.ЭтоМуниципальныйАдрес(Поля.addressType);
	ИменаУровнейАдреса = ?(ЭтоМуниципальныйАдрес, Поля.munLevels, Поля.admLevels);
	
	КодОбъекта = "";
	ЧастиАдреса = Новый Массив;
	Для Каждого ЧастьАдреса Из ИменаУровнейАдреса Цикл
		
		Если ЧастьАдреса = "area" Тогда
			ИнтеграцияФРМОКлиентСервер.ДобавитьСоставнуюЧастьАдреса(ЧастиАдреса, Поля["areaValue"]);
		ИначеЕсли ЧастьАдреса = "locality" Или ЧастьАдреса = "city" Или ЧастьАдреса = "street" Тогда
			ТипЧасти = ?(Поля.Свойство(ЧастьАдреса + "Type"), Поля[ЧастьАдреса + "Type"], "");
			ИнтеграцияФРМОКлиентСервер.ДобавитьСоставнуюЧастьАдреса(ЧастиАдреса, ТипЧасти, Поля[ЧастьАдреса]);
		ИначеЕсли ЧастьАдреса = "house" Тогда
			ИнтеграцияФРМОКлиентСервер.ДобавитьСоставнуюЧастьАдреса(ЧастиАдреса, Поля["houseNumber"]);
		КонецЕсли;
		
		ИдАдреса = "";
		Поля.Свойство(ЧастьАдреса + "Id", ИдАдреса);
		Если ЗначениеЗаполнено(ИдАдреса) Тогда
			КодОбъекта = ИдАдреса;
		КонецЕсли;
		
	КонецЦикла;
	ПредставлениеАдреса = СтрСоединить(ЧастиАдреса, ", ");
	
	ПоляРезультат = Новый Структура;
	ПоляРезультат.Вставить("КодОбъекта"		, КодОбъекта);
	ПоляРезультат.Вставить("Регион"			, Регион);
	ПоляРезультат.Вставить("Представление"	, ПредставлениеАдреса);
	
	Результат.Представление = ПредставлениеАдреса;
	Результат.Значение = ОбщегоНазначения.ЗначениеВJSON(ПоляРезультат);
	
	Возврат Результат;
	
КонецФункции

Функция АдресФРМОвБГУ(Адрес) Экспорт
	
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Возврат "";
	КонецЕсли;
	
	Поля = ОбщегоНазначения.JSONВЗначение(Адрес);
	
	ДополнительнаяИнформацияАдреса = Новый Структура("АдресВJSON,Муниципальный", Истина, Истина);
	Возврат РаботаСАдресами.АдресПоИдентификатору(Поля["КодОбъекта"], ДополнительнаяИнформацияАдреса);
	
КонецФункции

#Область СравнениеДанных

Функция СвойстваДляСравнения() Экспорт
	
	ЭлементСправочника = Новый Структура;
	ЭлементСправочника.Вставить("Код", "Код");
	ЭлементСправочника.Вставить("Наименование_", "Наименование");
	
	Регион = Новый Структура;
	Регион.Вставить("Код"			, "Код");
	Регион.Вставить("КодРегиона"	, "Код региона в ФНС");
	Регион.Вставить("Федеральный"	, "Федеральный город");
	
	Адрес = Новый Структура;
	Адрес.Вставить("Представление_"	, "Представление");
	Адрес.Вставить("КодОбъекта"		, "Идентификатор объекта адреса по ГАР");
	Адрес.Вставить("Регион"			, Новый Структура("Заголовок,Данные", "Регион", Регион));
	
	Помещения = ОбщегоНазначения.СкопироватьРекурсивно(ЭлементСправочника);
	Помещения.Вставить("Помещения", Новый Структура("Заголовок,Список", "Помещения", ЭлементСправочника));
	
	Здание = ОбщегоНазначения.СкопироватьРекурсивно(ЭлементСправочника);
	Здание.Вставить("Этажи", Новый Структура("Заголовок,Список", "Этажи", Помещения));
	
	Подразделение = ОбщегоНазначения.СкопироватьРекурсивно(ЭлементСправочника);
	Подразделение.Вставить("Отделения", Новый Структура("Заголовок,Список", "Отделения", ЭлементСправочника));
	Подразделение.Вставить("Кабинеты", Новый Структура("Заголовок,Список", "Кабинеты", ЭлементСправочника));
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование"				, "Наименование");
	Результат.Вставить("ИнвентарныйНомер"			, "Инвентарный номер");
	Результат.Вставить("Идентификатор"				, "Идентификатор");
	Результат.Вставить("ТипОборудования"			, "Тип оборудования");
	Результат.Вставить("РазделИзделия"				, Новый Структура("Заголовок,Данные", "Раздел медицинского изделия", ЭлементСправочника));
	Результат.Вставить("ТипИзделия"					, Новый Структура("Заголовок,Данные", "Вид медицинского изделия", ЭлементСправочника));
	Результат.Вставить("НомерУдостоверения"			, "Номер удостоверения");
	Результат.Вставить("ДатаРегистрации" 			, "Дата регистрации");
	Результат.Вставить("Модель"						, "Модель");
	Результат.Вставить("Производитель"				, "Производитель");
	Результат.Вставить("СтранаПроизводства"			, "Страна производства");
	Результат.Вставить("СерийныйНомер"				, "Серийный номер");
	Результат.Вставить("ДатаВыпуска"				, "Дата выпуска");
	Результат.Вставить("ДатаВводаВЭксплуатацию"		, "Дата ввода в эксплуатацию");
	Результат.Вставить("ДатаВыводаИзЭксплуатации"	, "Дата вывода из эксплуатации");
	Результат.Вставить("ПричинаВыводаИзЭксплуатации", "Причина вывода из эксплуатации");
	Результат.Вставить("СрокСлужбы"					, "Срок службы (лет)");
	Результат.Вставить("Количество"					, "Количество");
	Результат.Вставить("ТребуетсяЗамена"			, "Изделие требует замены");
	Результат.Вставить("Общее"						, "Используется персоналом другого подразделения/отделения/кабинета");
	Результат.Вставить("Адрес"						, Новый Структура("Заголовок,Данные", "Адрес", Адрес));
	Результат.Вставить("ПричинаИногоАдреса"			, "Причина иного адреса");
	Результат.Вставить("Здание"						, Новый Структура("Заголовок,Данные", "Здание", Здание));
	Результат.Вставить("Подразделение"				, Новый Структура("Заголовок,Данные", "Подразделение", Подразделение));
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеСовпадают(СтрокаТаблицы)
	
	СвойстваДляСравнения = СвойстваДляСравнения();
	
	Результат = СравнитьСвойстваОбъектов(СвойстваДляСравнения, СтрокаТаблицы.ДанныеБГУ, СтрокаТаблицы.ДанныеФРМО);
	
	Возврат Результат;
	
КонецФункции

Функция СравнитьСвойстваОбъектов(Свойства, Данные1, Данные2)
	
	ТипСтруктура = Тип("Структура");
	
	Для Каждого Свойство Из Свойства Цикл
		
		Если СтрЗаканчиваетсяНа(Свойство.Ключ, "_") Тогда
			Продолжить;
		КонецЕсли;
		
		Значение1 = ?(Данные1 = Неопределено, Неопределено, Данные1[Свойство.Ключ]);
		Значение2 = ?(Данные2 = Неопределено, Неопределено, Данные2[Свойство.Ключ]);
		
		Если ТипЗнч(Свойство.Значение) = ТипСтруктура Тогда
			
			Если Свойство.Значение.Свойство("Данные") Тогда
				Результат = СравнитьСвойстваОбъектов(Свойство.Значение.Данные, Значение1, Значение2);
				Если Не Результат Тогда
					Возврат Ложь;
				КонецЕсли;
			КонецЕсли;
			
			Если Свойство.Значение.Свойство("Список") Тогда
				Результат = СравнитьСпискиОбъектов(Свойство.Значение.Список, Значение1, Значение2);
				Если Не Результат Тогда
					Возврат Ложь;
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			Если Значение1 <> Значение2 Тогда
				Возврат Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СравнитьСпискиОбъектов(Свойства, Список1, Список2)
	
	Количество1 = ?(Список1 = Неопределено, 0, Список1.Количество());
	Количество2 = ?(Список2 = Неопределено, 0, Список2.Количество());
	
	Если Количество1 <> Количество2 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Количество1 = 0 И Количество2 = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	НовыйСписок2 = ОбщегоНазначения.СкопироватьРекурсивно(Список2);
	
	Для Каждого Элемент1 Из Список1 Цикл
		
		Элемент2 = Неопределено;
		ИндексЭлемента = 0;
		Для Каждого ЭлементСписка2 Из НовыйСписок2 Цикл
			Если Элемент1.Код = ЭлементСписка2.Код Тогда
				Элемент2 = ЭлементСписка2;
				Прервать;
			КонецЕсли;
			ИндексЭлемента = ИндексЭлемента + 1;
		КонецЦикла;
		
		Если Элемент2 = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Результат = СравнитьСвойстваОбъектов(Свойства, Элемент1, Элемент2);
		Если Не Результат Тогда
			Возврат Ложь;
		КонецЕсли;
		
		НовыйСписок2.Удалить(ИндексЭлемента);
		
	КонецЦикла;
	
	Возврат (НовыйСписок2.Количество() = 0);
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область Синхронизация

Функция СинхронизироватьОборудование(Организация, ОперацииОборудования) Экспорт
	
	Классификаторы = ИсточникиЭлементовСправочников(Организация, ОперацииОборудования);
	
	СостояниеОпераций = Новый Массив;
	
	Для Каждого ОперацияОборудования Из ОперацииОборудования Цикл
		
		Если ОперацияОборудования.Операция = 1 Тогда
			Сообщение = ВыгрузитьЕдиницуОборудования(ОперацияОборудования, Организация);
		ИначеЕсли ОперацияОборудования.Операция = 2 Тогда
			Сообщение = ЗагрузитьЕдиницуОборудования(ОперацияОборудования, Организация, Классификаторы.Источники);
		ИначеЕсли ОперацияОборудования.Операция = 3 Тогда
			Сообщение = УдалитьЕдиницуОборудования(ОперацияОборудования, Организация);
		Иначе
			Сообщение = "";
		КонецЕсли;
		
		СостояниеОпераций.Добавить(Новый Структура("ИндентификаторСтроки,Сообщение", ОперацияОборудования.ИндентификаторСтроки, Сообщение));
		
	КонецЦикла;
	
	СообщениеДанныеОтсутствуют = СообщениеОтсутствующихДанныхКлассификатора(Классификаторы.ДанныеОтсутствуют);
	
	Возврат Новый Структура("СостояниеОпераций,СообщениеДанныеОтсутствуют", СостояниеОпераций, СообщениеДанныеОтсутствуют);
	
КонецФункции 

Функция ИсточникиЭлементовСправочников(Организация, ОперацииОборудования)
	
	Результат = Новый Структура;
	Результат.Вставить("Источники"			, Новый Структура);
	Результат.Вставить("ДанныеОтсутствуют"	, Новый Структура("РазделыМО,ТипыМО,Местонахождение", Новый Массив, Новый Массив, Новый Массив));
	
	ОперацииЗагрузки = Новый Массив;
	Для Каждого ОперацияОборудования Из ОперацииОборудования Цикл
		Если ОперацияОборудования.Операция = 2 И ОперацияОборудования.ДанныеФРМО <> Неопределено Тогда // Загрузить
			ОперацииЗагрузки.Добавить(ОперацияОборудования);
		КонецЕсли;
	КонецЦикла;
	
	Если ОперацииЗагрузки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыОборудования = Новый Соответствие;
	ТипыОборудования.Вставить("Медицинское оборудование"	, Перечисления.ТипыМедицинскогоОборудованияФРМО.Медицинское);
	ТипыОборудования.Вставить("Прочее оборудование"			, Перечисления.ТипыМедицинскогоОборудованияФРМО.Прочее);
	ТипыОборудования.Вставить("Автотранспорт"				, Перечисления.ТипыМедицинскогоОборудованияФРМО.Автотранспорт);
	
	Результат.Источники.Вставить("ТипыОборудования", ТипыОборудования);
	
	РазделыМО		= Новый Соответствие;
	ТипыМО			= Новый Соответствие;
	Местонахождения	= Новый Соответствие;
	
	Для Каждого СтрокаТаблицы Из ОперацииЗагрузки Цикл
		
		РазделМО = СтрокаТаблицы.ДанныеФРМО.РазделИзделия;
		Если РазделМО <> Неопределено Тогда
			РазделыМО.Вставить(РазделМО.Код, Новый Структура("Наименование,Ссылка", РазделМО.Наименование, Неопределено));
		КонецЕсли;
		
		ТипМО = СтрокаТаблицы.ДанныеФРМО.ТипИзделия;
		Если ТипМО <> Неопределено Тогда
			ТипыМО.Вставить(ТипМО.Код, Новый Структура("Наименование,Ссылка", ТипМО.Наименование, Неопределено));
		КонецЕсли;
		
		Если СтрокаТаблицы.ДанныеФРМО.Здание <> Неопределено Тогда
			ВставитьСтрокуМестонахождения(Местонахождения,
				СтрокаТаблицы.ДанныеФРМО.Здание.Код,
				Перечисления.ТипыМестонахожденияФРМО.Здание,
				"Здание",
				ОбщегоНазначенияКлиентСервер.МассивЗначений(СтрокаТаблицы.ДанныеФРМО.Здание.Наименование));
			Для Каждого СтрокаЭтаж Из СтрокаТаблицы.ДанныеФРМО.Здание.Этажи Цикл
				Для Каждого СтрокаПомещение Из СтрокаЭтаж.Помещения Цикл
					ВставитьСтрокуМестонахождения(Местонахождения,
						СтрокаПомещение.Код,
						Перечисления.ТипыМестонахожденияФРМО.Помещение,
						"Помещение",
						ОбщегоНазначенияКлиентСервер.МассивЗначений(СтрокаТаблицы.ДанныеФРМО.Здание.Наименование,
							СтрокаЭтаж.Наименование, СтрокаПомещение.Наименование));
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
		Если СтрокаТаблицы.ДанныеФРМО.Подразделение <> Неопределено Тогда
			ВставитьСтрокуМестонахождения(Местонахождения,
				СтрокаТаблицы.ДанныеФРМО.Подразделение.Код,
				Перечисления.ТипыМестонахожденияФРМО.Подразделение,
				"Подразделение",
				ОбщегоНазначенияКлиентСервер.МассивЗначений(СтрокаТаблицы.ДанныеФРМО.Подразделение.Наименование));
			Для Каждого СтрокаОтделение Из СтрокаТаблицы.ДанныеФРМО.Подразделение.Отделения Цикл
				ВставитьСтрокуМестонахождения(Местонахождения,
					СтрокаОтделение.Код,
					Перечисления.ТипыМестонахожденияФРМО.Отделение,
					"Отделение",
					ОбщегоНазначенияКлиентСервер.МассивЗначений(СтрокаТаблицы.ДанныеФРМО.Подразделение.Наименование,
						СтрокаОтделение.Наименование));
			КонецЦикла;
			Для Каждого СтрокаКабинет Из СтрокаТаблицы.ДанныеФРМО.Подразделение.Кабинеты Цикл
				ВставитьСтрокуМестонахождения(Местонахождения,
					СтрокаКабинет.Код,
					Перечисления.ТипыМестонахожденияФРМО.Кабинет,
					"Кабинет",
					ОбщегоНазначенияКлиентСервер.МассивЗначений(СтрокаТаблицы.ДанныеФРМО.Подразделение.Наименование,
						СтрокаКабинет.Наименование));
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("КодыРазделыМО"	, КлючиСоответствияВМассив(РазделыМО));
	Запрос.УстановитьПараметр("КодыТипыМО"		, КлючиСоответствияВМассив(ТипыМО));
	Запрос.УстановитьПараметр("Местонахождение"	, ТаблицаМестонахождение(Местонахождения));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица.Код КАК Код,
	|	Таблица.Тип КАК Тип,
	|	Таблица.Префикс КАК Префикс
	|ПОМЕСТИТЬ ВТ_Местонахождение
	|ИЗ
	|	&Местонахождение КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазделыМО.КодМинздрава КАК КодМинздрава,
	|	РазделыМО.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РазделыНоменклатурнойКлассификацииМедицинскихИзделийПоВидам КАК РазделыМО
	|ГДЕ
	|	РазделыМО.КодМинздрава В(&КодыРазделыМО)
	|	И НЕ РазделыМО.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВидыМО.КодМинздрава КАК КодМинздрава,
	|	ВидыМО.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам КАК ВидыМО
	|ГДЕ
	|	ВидыМО.КодМинздрава В(&КодыТипыМО)
	|	И НЕ ВидыМО.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Местонахождение.Код КАК Код,
	|	ВТ_Местонахождение.Тип КАК Тип,
	|	ВТ_Местонахождение.Префикс КАК Префикс,
	|	МестонахождениеФРМО.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.МестонахождениеФРМО КАК МестонахождениеФРМО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Местонахождение КАК ВТ_Местонахождение
	|		ПО МестонахождениеФРМО.Идентификатор = ВТ_Местонахождение.Код
	|			И МестонахождениеФРМО.Тип = ВТ_Местонахождение.Тип
	|ГДЕ
	|	МестонахождениеФРМО.Организация = &Организация
	|	И НЕ МестонахождениеФРМО.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезультатЗапроса[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		РазделыМО[Выборка.КодМинздрава].Ссылка = Выборка.Ссылка;
	КонецЦикла;
	
	Выборка = РезультатЗапроса[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		ТипыМО[Выборка.КодМинздрава].Ссылка = Выборка.Ссылка;
	КонецЦикла;
	
	Выборка = РезультатЗапроса[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		Местонахождения[Выборка.Префикс + "_" + Выборка.Код].Ссылка = Выборка.Ссылка;
	КонецЦикла;
	
	
	ИсточникРазделыМО = Новый Соответствие;
	Для Каждого РазделМО Из РазделыМО Цикл
		Если РазделМО.Значение.Ссылка = Неопределено Тогда
			Ссылка = Справочники.РазделыНоменклатурнойКлассификацииМедицинскихИзделийПоВидам.ПустаяСсылка();
			Результат.ДанныеОтсутствуют.РазделыМО.Добавить(ПредставлениеЭлементаКлассификатора(РазделМО));
		Иначе
			Ссылка = РазделМО.Значение.Ссылка;
		КонецЕсли;
		ИсточникРазделыМО.Вставить(РазделМО.Ключ, Ссылка);
	КонецЦикла;
	Результат.Источники.Вставить("РазделыМО", ИсточникРазделыМО);
	
	ИсточникТипыМО = Новый Соответствие;
	Для Каждого ТипМО Из ТипыМО Цикл
		Если ТипМО.Значение.Ссылка = Неопределено Тогда
			Ссылка = Справочники.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам.ПустаяСсылка();
			Результат.ДанныеОтсутствуют.ТипыМО.Добавить(ПредставлениеЭлементаКлассификатора(ТипМО));
		Иначе
			Ссылка = ТипМО.Значение.Ссылка;
		КонецЕсли;
		ИсточникТипыМО.Вставить(ТипМО.Ключ, Ссылка);
	КонецЦикла;
	Результат.Источники.Вставить("ТипыМО", ИсточникТипыМО);
	
	ИсточникМестонахождение = Новый Соответствие;
	Для Каждого Местонахождение Из Местонахождения Цикл
		Если Местонахождение.Значение.Ссылка = Неопределено Тогда
			Результат.ДанныеОтсутствуют.Местонахождение.Добавить(ПредставлениеМестонахождения(
				Местонахождение.Значение.Наименования, Местонахождение.Значение.Тип));
		Иначе
			ИсточникМестонахождение.Вставить(Местонахождение.Ключ, Местонахождение.Значение.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Результат.Источники.Вставить("Местонахождение", ИсточникМестонахождение);
	
	Возврат Результат;
	
КонецФункции

Процедура ВставитьСтрокуМестонахождения(Местонахождения, Код, Тип, Префикс, Наименования)
	
	Местонахождения.Вставить(Префикс + "_" + Код, Новый Структура("Код,Префикс,Тип,Наименования,Ссылка", Код, Префикс, Тип, Наименования, Неопределено));
	
КонецПроцедуры

Функция ТаблицаМестонахождение(Местонахождения)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Код"		, Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(50)));
	Результат.Колонки.Добавить("Префикс"	, Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(20)));
	Результат.Колонки.Добавить("Тип"		, Новый ОписаниеТипов("ПеречислениеСсылка.ТипыМестонахожденияФРМО"));
	
	Для Каждого Местонахождение Из Местонахождения Цикл
		НоваяСтрока			= Результат.Добавить();
		НоваяСтрока.Код		= Местонахождение.Значение.Код;
		НоваяСтрока.Префикс	= Местонахождение.Значение.Префикс;
		НоваяСтрока.Тип		= Местонахождение.Значение.Тип;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция КлючиСоответствияВМассив(ИсходныеДанные)
	
	Результат = Новый Массив;
	
	Для Каждого КлючИЗначение Из ИсходныеДанные Цикл
		Результат.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеЭлементаКлассификатора(КлючЗначение)
	
	Возврат СтрШаблон("%1 (код минздрава: %2)", КлючЗначение.Значение.Наименование, Формат(КлючЗначение.Ключ, "ЧГ=0"));
	
КонецФункции

Функция ПредставлениеМестонахождения(Наименования, Тип)
	
	Если Тип = Перечисления.ТипыМестонахожденияФРМО.Здание Тогда
		Наименование = СтрШаблон(НСтр("ru = 'Здание  ""%1""'"), Наименования[0]);
	ИначеЕсли Тип = Перечисления.ТипыМестонахожденияФРМО.Помещение Тогда
		Наименование = СтрШаблон(НСтр("ru = 'Здание ""%1"", этаж ""%2"", помещение ""%3""'"), Наименования[0], Наименования[1], Наименования[2]);
	ИначеЕсли Тип = Перечисления.ТипыМестонахожденияФРМО.Подразделение Тогда
		Наименование = СтрШаблон(НСтр("ru = 'Подразделение ""%1""'"), Наименования[0]);
	ИначеЕсли Тип = Перечисления.ТипыМестонахожденияФРМО.Отделение Тогда
		Наименование = СтрШаблон(НСтр("ru = 'Подразделение  ""%1"", отделение ""%2""'"), Наименования[0], Наименования[1]);
	ИначеЕсли Тип = Перечисления.ТипыМестонахожденияФРМО.Кабинет Тогда
		Наименование = СтрШаблон(НСтр("ru = 'Подразделение  ""%1"", кабинет ""%2""'"), Наименования[0], Наименования[1]);
	Иначе
		Наименование = СтрСоединить(Наименования, ", ");
		Если ПустаяСтрока(Наименование) Тогда
			Наименование = НСтр("ru = '<Местонахождение>'");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Наименование;
	
КонецФункции

Функция ВыгрузитьЕдиницуОборудования(СтрокаТаблицы, Организация)
	
	Если СтрокаТаблицы.ОтветСервиса = Неопределено Тогда
		Возврат НСтр("ru = 'Не удалось выполнить запрос'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.ОтветСервиса.СообщениеОбОшибке) Тогда
		Возврат СтрокаТаблицы.ОтветСервиса.СообщениеОбОшибке;
	КонецЕсли;
	
	ТекстОшибки = "";
	Если СтрокаТаблицы.ОтветСервиса.СозданиеНового Тогда
		Идентификатор = СтрокаТаблицы.ОтветСервиса.Содержимое.content.entityId;
		Запись = РегистрыСведений.МедицинскоеОборудованиеФРМО.СоздатьМенеджерЗаписи();
		Запись.Организация = Организация;
		Запись.ОсновноеСредство = СтрокаТаблицы.ОсновноеСредствоБГУ;
		Запись.ИнвентарныйНомер = СтрокаТаблицы.ИнвентарныйНомерБГУ;
		Запись.Прочитать();
		Запись.Идентификатор = Идентификатор;
		Попытка
			Запись.Записать();
		Исключение
			ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция ЗагрузитьЕдиницуОборудования(СтрокаТаблицы, Организация, ИсточникиДанных)
	
	Запись = РегистрыСведений.МедицинскоеОборудованиеФРМО.СоздатьМенеджерЗаписи();
	
	СвойстваКопирования = "Идентификатор,ТребуетсяЗамена,Общее,НомерУдостоверения,ДатаРегистрации,Модель,Производитель,СтранаПроизводства,ПричинаИногоАдреса"
		+ ",Наименование,СерийныйНомер,ДатаВыпуска,ДатаВводаВЭксплуатацию,ДатаВыводаИзЭксплуатации,ПричинаВыводаИзЭксплуатации,СрокСлужбы,Количество";
	ЗаполнитьЗначенияСвойств(Запись, СтрокаТаблицы.ДанныеФРМО, СвойстваКопирования);
	
	Запись.Организация		= Организация;
	Запись.ОсновноеСредство	= СтрокаТаблицы.ОсновноеСредствоБГУ;
	Запись.ИнвентарныйНомер	= СтрокаТаблицы.ИнвентарныйНомерБГУ;
	Запись.ТипОборудования	= ИсточникиДанных.ТипыОборудования[СтрокаТаблицы.ДанныеФРМО.ТипОборудования];
	Запись.РазделИзделия	= ?(СтрокаТаблицы.ДанныеФРМО.РазделИзделия = Неопределено, Справочники.РазделыНоменклатурнойКлассификацииМедицинскихИзделийПоВидам.ПустаяСсылка(),
								ИсточникиДанных.РазделыМО[СтрокаТаблицы.ДанныеФРМО.РазделИзделия.Код]);
	Запись.ТипИзделия		= ?(СтрокаТаблицы.ДанныеФРМО.ТипИзделия = Неопределено, Справочники.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам.ПустаяСсылка(),
								ИсточникиДанных.ТипыМО[СтрокаТаблицы.ДанныеФРМО.ТипИзделия.Код]);
	Запись.ИнойАдрес		= (СтрокаТаблицы.ДанныеФРМО.Адрес <> Неопределено);
	Запись.Адрес			= ?(СтрокаТаблицы.ДанныеФРМО.Адрес = Неопределено, "", ОбщегоНазначения.ЗначениеВJSON(СтрокаТаблицы.ДанныеФРМО.Адрес));
	Запись.Здание			= ?(СтрокаТаблицы.ДанныеФРМО.Здание = Неопределено, Справочники.МестонахождениеФРМО.ПустаяСсылка(),
								ИсточникиДанных.Местонахождение["Здание_" + СтрокаТаблицы.ДанныеФРМО.Здание.Код]);
	Запись.Подразделение	= ?(СтрокаТаблицы.ДанныеФРМО.Подразделение = Неопределено, Справочники.МестонахождениеФРМО.ПустаяСсылка(),
								ИсточникиДанных.Местонахождение["Подразделение_" + СтрокаТаблицы.ДанныеФРМО.Подразделение.Код]);
	Запись.ИнвентарныйНомерКод = СтрокаТаблицы.ДанныеФРМО.ИнвентарныйНомер;
	Запись.ЭксплуатацияЗавершена = ЗначениеЗаполнено(СтрокаТаблицы.ДанныеФРМО.ДатаВыводаИзЭксплуатации);
	
	НаборЗаписейМестонахождение = РегистрыСведений.МестонахождениеМедицинскогоОборудованияФРМО.СоздатьНаборЗаписей();
	НаборЗаписейМестонахождение.Отбор.Организация.Установить(Запись.Организация);
	НаборЗаписейМестонахождение.Отбор.ОсновноеСредство.Установить(Запись.ОсновноеСредство);
	НаборЗаписейМестонахождение.Отбор.ИнвентарныйНомер.Установить(Запись.ИнвентарныйНомер);
	
	Если СтрокаТаблицы.ДанныеФРМО.Здание <> Неопределено Тогда
		Для Каждого СтрокаЭтаж Из СтрокаТаблицы.ДанныеФРМО.Здание.Этажи Цикл
			Для Каждого СтрокаПомещение Из СтрокаЭтаж.Помещения Цикл
				Местонахождение = ИсточникиДанных.Местонахождение["Помещение_" + СтрокаПомещение.Код];
				Если Местонахождение <> Неопределено Тогда
					ЗаписьМестонахождение = НаборЗаписейМестонахождение.Добавить();
					ЗаписьМестонахождение.Организация		= Запись.Организация;
					ЗаписьМестонахождение.ОсновноеСредство	= Запись.ОсновноеСредство;
					ЗаписьМестонахождение.ИнвентарныйНомер	= Запись.ИнвентарныйНомер;
					ЗаписьМестонахождение.Местонахождение	= Местонахождение;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если СтрокаТаблицы.ДанныеФРМО.Подразделение <> Неопределено Тогда
		Для Каждого СтрокаОтделение Из СтрокаТаблицы.ДанныеФРМО.Подразделение.Отделения Цикл
			Местонахождение = ИсточникиДанных.Местонахождение["Отделение_" + СтрокаОтделение.Код];
			Если Местонахождение <> Неопределено Тогда
				ЗаписьМестонахождение = НаборЗаписейМестонахождение.Добавить();
				ЗаписьМестонахождение.Организация		= Запись.Организация;
				ЗаписьМестонахождение.ОсновноеСредство	= Запись.ОсновноеСредство;
				ЗаписьМестонахождение.ИнвентарныйНомер	= Запись.ИнвентарныйНомер;
				ЗаписьМестонахождение.Местонахождение	= Местонахождение;
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаКабинет Из СтрокаТаблицы.ДанныеФРМО.Подразделение.Кабинеты Цикл
			Местонахождение = ИсточникиДанных.Местонахождение["Кабинет_" + СтрокаКабинет.Код];
			Если Местонахождение <> Неопределено Тогда
				ЗаписьМестонахождение = НаборЗаписейМестонахождение.Добавить();
				ЗаписьМестонахождение.Организация		= Запись.Организация;
				ЗаписьМестонахождение.ОсновноеСредство	= Запись.ОсновноеСредство;
				ЗаписьМестонахождение.ИнвентарныйНомер	= Запись.ИнвентарныйНомер;
				ЗаписьМестонахождение.Местонахождение	= Местонахождение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	ТекстОшибки = "";
	Попытка
		Запись.Записать();
		НаборЗаписейМестонахождение.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция УдалитьЕдиницуОборудования(СтрокаТаблицы, Организация)
	
	Если СтрокаТаблицы.ОтветСервиса <> Неопределено И ЗначениеЗаполнено(СтрокаТаблицы.ОтветСервиса.СообщениеОбОшибке) Тогда
		Возврат СтрокаТаблицы.ОтветСервиса.СообщениеОбОшибке;
	КонецЕсли;
	
	ТекстОшибки = ""; 
	
	Если СтрокаТаблицы.ДанныеБГУ <> Неопределено
		И ЗначениеЗаполнено(СтрокаТаблицы.ОсновноеСредствоБГУ)
		И ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомерБГУ) Тогда
		
		Запись = РегистрыСведений.МедицинскоеОборудованиеФРМО.СоздатьМенеджерЗаписи();
		Запись.Организация = Организация;
		Запись.ОсновноеСредство = СтрокаТаблицы.ОсновноеСредствоБГУ;
		Запись.ИнвентарныйНомер = СтрокаТаблицы.ИнвентарныйНомерБГУ;
		Попытка
			Запись.Удалить();
		Исключение
			ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция СообщениеОтсутствующихДанныхКлассификатора(ДанныеОтсутствуют)
	
	ЧастиСообщения = Новый Массив;
	
	Если ДанныеОтсутствуют.РазделыМО.Количество() > 0 Или ДанныеОтсутствуют.ТипыМО.Количество() > 0 Тогда
		ЧастиСообщения.Добавить(НСтр("ru = 'В классификаторе медицинских изделий отсутствуют данные.'"));
		
		Если ДанныеОтсутствуют.РазделыМО.Количество() > 0 Тогда
			ЧастиСообщения.Добавить(НСтр("ru = 'Разделы:'") + Символы.ПС + СтрСоединить(ДанныеОтсутствуют.РазделыМО, Символы.ПС));
		КонецЕсли;
		
		Если ДанныеОтсутствуют.ТипыМО.Количество() > 0 Тогда
			ЧастиСообщения.Добавить(НСтр("ru = 'Типы:'") + Символы.ПС + СтрСоединить(ДанныеОтсутствуют.ТипыМО, Символы.ПС));
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеОтсутствуют.Местонахождение.Количество() > 0 Тогда
		ЧастиСообщения.Добавить(СтрШаблон(НСтр("ru = 'В справочнике ""%1"" отсутствуют данные.'"), Метаданные.Справочники.МестонахождениеФРМО.Синоним));
		ЧастиСообщения.Добавить(СтрСоединить(ДанныеОтсутствуют.Местонахождение, Символы.ПС));
	КонецЕсли;
	
	СообщениеОбОшибке = СтрСоединить(ЧастиСообщения, Символы.ПС + Символы.ПС);
	
	Возврат СообщениеОбОшибке;
	
КонецФункции

#КонецОбласти

#Область Сервис1СФНСИ

Функция ХостСервиса1СФНСИ()
	
	Возврат "fnsi.med.1c.ru/rest";
	
КонецФункции

Функция ДанныеСервиса1СФНСИ(МетодСПараметрами) Экспорт
	
	Результат = Новый Структура("КодСостояния,КодОшибки,СообщениеОбОшибке,Содержимое", 0, "", "", "");
	
	URLОперации = "https://" + ХостСервиса1СФНСИ() + МетодСПараметрами;
	
	ПараметрыОтправки = Новый Структура;
	ПараметрыОтправки.Вставить("Метод"			, "GET");
	ПараметрыОтправки.Вставить("ФорматОтвета"	, 1);
	ПараметрыОтправки.Вставить("НастройкиПрокси", ПолучениеФайловИзИнтернета.НастройкиПроксиНаСервере());
	ПараметрыОтправки.Вставить("Таймаут"		, 30);
	
	РезультатОтправки = ИнтернетПоддержкаПользователей.ЗагрузитьСодержимоеИзИнтернет(URLОперации,,,ПараметрыОтправки);
	
	ЗаполнитьЗначенияСвойств(Результат, РезультатОтправки);
	
	Возврат Результат;
	
КонецФункции 

Функция СодержимоеСправочника1СФНСИ(ОИДСправочника, ИдентификаторЗапроса, ТикетИТС,
	Версия = Неопределено, Отбор = Неопределено, РазмерСтраницы = Неопределено,
	КоличествоСтраницНазад = Неопределено, ТолькоКоличество = Ложь) Экспорт
	
	Параметры = Новый Массив;
	Параметры.Добавить("ticket=" + ТикетИТС);
	Параметры.Добавить("userKey=" + ИдентификаторЗапроса);
	Параметры.Добавить("identifier=" + ОИДСправочника);
	
	Если Отбор <> Неопределено Тогда
		Фильтры = Новый Массив;
		Для Каждого ЭлементОтбора ИЗ Отбор Цикл
			Фильтры.Добавить(ЭлементОтбора.Ключ + "|" + ЭлементОтбора.Значение);
		КонецЦикла;
		Параметры.Добавить("filters=" + СтрСоединить(Фильтры, ","));
	КонецЕсли;
	
	Если Версия <> Неопределено Тогда
		Параметры.Добавить("version=" + Версия);
	КонецЕсли;
	
	Если РазмерСтраницы <> Неопределено Тогда
		Параметры.Добавить("size=" + Формат(РазмерСтраницы,"ЧГ="));
	КонецЕсли;
	
	Если КоличествоСтраницНазад <> Неопределено Тогда
		Параметры.Добавить("back=" + Формат(КоличествоСтраницНазад, "ЧГ="));
	КонецЕсли;
	
	МетодСПараметрами = ?(ТолькоКоличество, "/count?", "/data?") + СтрСоединить(Параметры, "&");
	
	Возврат ДанныеСервиса1СФНСИ(МетодСПараметрами);
	
КонецФункции

Функция ТикетИТСДля1СФНСИ() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат ИнтернетПоддержкаПользователей.ТикетАутентификацииНаПорталеПоддержки("1C-FNSI");
	
КонецФункции

