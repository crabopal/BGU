#Область ПрограммныйИнтерфейс

Функция ПолучитьСвойстваКлассификатора(Знач URIТипаСвязи) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Состав", Неопределено);  
	Результат.Вставить("ЕстьКОСГУ", Ложь);  
	Результат.Вставить("ЕстьПолныйКод", Ложь); 
	Результат.Вставить("ОбработчикПолученияДанных", Неопределено);

	Состав = Новый ТаблицаЗначений;
	Состав.Колонки.Добавить("ОбъектМетаданных");
	Состав.Колонки.Добавить("ТипСсылки");
	Состав.Колонки.Добавить("Характеристики");
	Если URIТипаСвязи = "urn:rels-1c-ru:budget:classification/rzpr-catalog" Тогда
		ДобавитьСтрокуСоставаКлассификатора(Состав, Тип("СправочникСсылка.РазделыПодразделыКРБ"));
		
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/cs-catalog" Тогда
		ДобавитьСтрокуСоставаКлассификатора(Состав, Тип("СправочникСсылка.ЦелевыеСтатьиКРБ"));
		ДобавитьСтрокуСоставаКлассификатора(Состав, Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ"));
		Результат.ЕстьПолныйКод = Истина;
		
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/vr-catalog" Тогда
		ДобавитьСтрокуСоставаКлассификатора(Состав, Тип("СправочникСсылка.ВидыРасходовКРБ"));
		
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kif-catalog" Тогда
		ДобавитьСтрокуСоставаКлассификатора(Состав, Тип("СправочникСсылка.ГруппыПодгруппыКИФ"));
		ДобавитьСтрокуСоставаКлассификатора(Состав, Тип("СправочникСсылка.СтатьиКИФ"));
		ДобавитьСтрокуСоставаКлассификатора(Состав, Тип("СправочникСсылка.ВидыКИФ"));
		Результат.ЕстьКОСГУ     = Истина;
		Результат.ЕстьПолныйКод = Истина;
		
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kosgu-catalog" Тогда
		ДобавитьСтрокуСоставаКлассификатора(Состав, Тип("СправочникСсылка.КОСГУ"));
		
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/ac-catalog" Тогда
		ДобавитьСтрокуСоставаКлассификатора(Состав, Тип("СправочникСсылка.АналитическиеКодыКПС"));	
		
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kdb16-catalog" Тогда
		ДобавитьСтрокуСоставаКлассификатора(Состав, Тип("СправочникСсылка.ВидыДоходовКДБ"));
		ДобавитьСтрокуСоставаКлассификатора(Состав, Тип("СправочникСсылка.ГруппыПодвидовКДБ")); 
		Результат.ЕстьКОСГУ     = Истина;
		Результат.ЕстьПолныйКод = Истина;
		Результат.ОбработчикПолученияДанных = Справочники.ВидыДоходовКДБ;
		
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/adm-catalog" Тогда
		ДобавитьСтрокуСоставаКлассификатора(Состав, Тип("СправочникСсылка.ГлавыПоБюджетнойКлассификации"));
		
	Иначе
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неверное значение параметра URIТипаСвязи (%1).'"),
			URIТипаСвязи);
		
	КонецЕсли;
	
	Результат.Состав = Состав;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьХарактеристикиСправочникаКлассификатора(Знач ИмяМетаданных)
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяМетаданных);
	
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Объект метаданных %1 не найден.'"),
			ИмяМетаданных);
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Результат.Вставить("ЕстьДопустимыеКОСГУ", ОбъектМетаданных.ТабличныеЧасти.Найти("ДопустимыеКОСГУ") <> Неопределено);
	Результат.Вставить("ЕстьАналитическиеГруппы", ОбъектМетаданных.ТабличныеЧасти.Найти("АналитическиеГруппы") <> Неопределено);
	Результат.Вставить("ЕстьБюджет", ОбъектМетаданных.Реквизиты.Найти("Бюджет") <> Неопределено);
	Результат.Вставить("ЕстьПериодДействия", ОбъектМетаданных.Реквизиты.Найти("ДатаНачалаДействия") <> Неопределено
	                   И ОбъектМетаданных.Реквизиты.Найти("ДатаОкончанияДействия") <> Неопределено
	                   И ОбъектМетаданных.Реквизиты.Найти("ОкончаниеДействия") <> Неопределено);
	Результат.Вставить("КонтрольУникальности", ОбъектМетаданных.КонтрольУникальности);
	
	Если ОбъектМетаданных = Метаданные.Справочники.ПрограммыЦелевыхСтатейКРБ Тогда
		Результат.Вставить("ЕстьВладелец", Истина);
		Результат.Вставить("ИмяРеквизитаВладелец", "ЦелеваяСтатья");
	ИначеЕсли ОбъектМетаданных = Метаданные.Справочники.ГруппыПодвидовКДБ Тогда
		Результат.Вставить("ЕстьВладелец", Истина);
		Результат.Вставить("ИмяРеквизитаВладелец", "ВидДохода");
	Иначе
		Результат.Вставить("ЕстьВладелец", ОбъектМетаданных.Владельцы.Количество() > 0);
		Результат.Вставить("ИмяРеквизитаВладелец", "Владелец");
	КонецЕсли;
	
	Результат.Вставить("ЕстьРодитель", ОбъектМетаданных.Иерархический);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСтрокуСоставаКлассификатора(Знач Состав, Знач ТипСсылки)
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипСсылки);
	
	СтрокаСостава = Состав.Добавить();
	СтрокаСостава.ТипСсылки = ТипСсылки;
	СтрокаСостава.ОбъектМетаданных = ОбъектМетаданных;
	СтрокаСостава.Характеристики   = ПолучитьХарактеристикиСправочникаКлассификатора(ОбъектМетаданных.ПолноеИмя());
	
КонецПроцедуры

#КонецОбласти