
#Область ПрограммныйИнтерфейс

#Область ТабличныйДокументСлужебныйИнтеграцияБСП

Функция ПараметрыРасчетаПоказателейЯчеек(ТабличныйДокумент) Экспорт
	
	// Реализует функциональность процедуры
	// ОбщегоНазначенияСлужебныйКлиент.ПараметрыРасчетаПоказателейЯчеек()
	// БСП версии 3.0.2
	
	ПараметрыРасчетаПоказателей = Новый Структура;
	ПараметрыРасчетаПоказателей.Вставить("ВыделенныеОбласти", Новый Массив);
	ПараметрыРасчетаПоказателей.Вставить("РассчитатьНаСервере", Ложь);
	
	ВыделенныеОбласти = ПараметрыРасчетаПоказателей.ВыделенныеОбласти;
	ВыделенныеОбластиДокумента = ТабличныйДокумент.ПолучитьВыделенныеОбласти();
	
	Для Каждого ВыделеннаяОбласть Из ВыделенныеОбластиДокумента Цикл

		Если ТипЗнч(ВыделеннаяОбласть) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;
		ГраницыОбласти = Новый Структура("Верх, Низ, Лево, Право, ТипОбласти");
		ЗаполнитьЗначенияСвойств(ГраницыОбласти, ВыделеннаяОбласть);
		ВыделенныеОбласти.Добавить(ГраницыОбласти);
	КонецЦикла;
	
	ВыделеноВсе = Ложь;
	Если ВыделенныеОбласти.Количество() = 1 Тогда 
		ВыделеннаяОбласть = ВыделенныеОбласти[0];
		ВыделеноВсе = Не Булево(
			ВыделеннаяОбласть.Верх
			+ ВыделеннаяОбласть.Низ
			+ ВыделеннаяОбласть.Лево
			+ ВыделеннаяОбласть.Право);
	КонецЕсли;
	
	ПараметрыРасчетаПоказателей.РассчитатьНаСервере = (ВыделеноВсе Или ВыделенныеОбласти.Количество() >= 100);
	
	Возврат ПараметрыРасчетаПоказателей;
	
КонецФункции	

#КонецОбласти

// При изменении флага отсутствует член комиссии.
// 
// Параметры:
//  Параметры - см. ОбщегоНазначенияБГУКлиентСервер.ПараметрыВыбораФайлаОсобогоМненияСотрудника
Процедура ПриИзмененииФлагаОтсутствуетЧленКомиссии(Параметры) Экспорт

	ТекущиеДанные = Параметры.ТаблицаФормы.ТекущиеДанные;
	Если ТекущиеДанные.Отсутствует Тогда
		ЗапроситьОчисткуФайлаОтсутствующегоЧленаКомиссии(Параметры);
	Иначе
		ТекущиеДанные.ПричинаОтсутствия = "";
	КонецЕсли;
	
КонецПроцедуры

// При изменении причины отсутствия члена комиссии.
// 
// Параметры:
//  Параметры - см. ОбщегоНазначенияБГУКлиентСервер.ПараметрыВыбораФайлаОсобогоМненияСотрудника
Процедура ПриИзмененииПричиныОтсутствияЧленаКомиссии(Параметры) Экспорт

	ТекущиеДанные = Параметры.ТаблицаФормы.ТекущиеДанные;
	ТекущиеДанные.Отсутствует = Не ПустаяСтрока(ТекущиеДанные.ПричинаОтсутствия);
	ЗапроситьОчисткуФайлаОтсутствующегоЧленаКомиссии(Параметры);
	
КонецПроцедуры

// Обработка события "Выбор" в таблице "СоставКомиссии".
// При необходимости вызывается добавление файла, удаление файла, открытие карточки файла.
// 
// Параметры:
//  Параметры - см. ОбщегоНазначенияБГУКлиентСервер.ПараметрыВыбораФайлаОсобогоМненияСотрудника
//  Поле - ПолеФормы
//  СтандартнаяОбработка - Булево
Процедура СоставКомиссииВыборПоляУправленияФайлом(Параметры, Поле, СтандартнаяОбработка) Экспорт
	Если Поле.Имя = "СоставКомиссииФайлОсобогоМненияДобавить" Тогда
		ВыбратьФайлОсобогоМненияСотрудника(
			Параметры,
			СтандартнаяОбработка);
		
	ИначеЕсли Поле.Имя = "СоставКомиссииФайлОсобогоМненияУдалить" Тогда
		ЗапроситьУдалениеФайлаЧленаКомиссии(Параметры, СтандартнаяОбработка);

	ИначеЕсли Поле.Имя = "СоставКомиссииФайлОсобогоМнения" Тогда
		СтандартнаяОбработка = Ложь;
		ТекущиеДанные = Параметры.ТаблицаФормы.ТекущиеДанные;
		Если ЗначениеЗаполнено(ТекущиеДанные.ФайлОсобогоМнения) Тогда
			ПоказатьЗначение(, ТекущиеДанные.ФайлОсобогоМнения);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

// Запросить удаление файла члена комиссии.
// 
// Параметры:
//  Параметры - см. ОбщегоНазначенияБГУКлиентСервер.ПараметрыВыбораФайлаОсобогоМненияСотрудника
//  СтандартнаяОбработка - Булево
Процедура ЗапроситьУдалениеФайлаЧленаКомиссии(Параметры, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Параметры.ТаблицаФормы.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.ФайлОсобогоМнения) Тогда
		ЗапроситьУдалениеФайлаЧленаКомиссииАсинхронно(Параметры);
	КонецЕсли;	
КонецПроцедуры

// Запрашивает очистку файла особого мнения при установке признака "отсутствует" в строке члена комиссии.
// Если отказаться от очистки файла, то признак "Отсутствует" снимается автоматически.
// 
// Параметры:
//  Параметры - см. ОбщегоНазначенияБГУКлиентСервер.ПараметрыВыбораФайлаОсобогоМненияСотрудника
Асинх Процедура ЗапроситьОчисткуФайлаОтсутствующегоЧленаКомиссии(Параметры) Экспорт
	ТекущиеДанные = Параметры.ТаблицаФормы.ТекущиеДанные;
	Если ТекущиеДанные.Отсутствует Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.ФайлОсобогоМнения) Тогда
			ТекстВопроса = СтрШаблон(НСтр("ru = 'У отсутствующего члена комиссии ""%1"" будет очищен файл особого мнения.
				|Продолжить?'"), ТекущиеДанные.Сотрудник);
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Очистить файл особого мнения'"));
			Кнопки.Добавить(КодВозвратаДиалога.Отмена);
			Ответ = Ждать ВопросАсинх(ТекстВопроса, Кнопки, , КодВозвратаДиалога.Отмена);
			Если Ответ <> КодВозвратаДиалога.ОК Тогда
				ТекущиеДанные.Отсутствует = Ложь;
				ТекущиеДанные.ПричинаОтсутствия = "";
			Иначе
				УдалитьФайлОсобогоМненияСотрудника(Параметры, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Выбрать файл особого мнения сотрудника.
// 
// Параметры:
//  Параметры - см. ОбщегоНазначенияБГУКлиентСервер.ПараметрыВыбораФайлаОсобогоМненияСотрудника
//  СтандартнаяОбработка - Булево
Процедура ВыбратьФайлОсобогоМненияСотрудника(Параметры, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка = Ложь;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьВыборФайлаОсобогоМненияСотрудника", ЭтотОбъект, Параметры);
	РаботаСФайламиКлиент.ОткрытьФормуВыбораФайлов(Параметры.Документ, Параметры.Файл, , ОписаниеОповещения);
КонецПроцедуры

// Обработать выбор файла особого мнения сотрудника.
// 
// Параметры:
//  ЗначениеВыбора - ОпределяемыйТип.ПрисоединенныйФайл
//  ДополнительныеПараметры - см. ОбщегоНазначенияБГУКлиентСервер.ПараметрыВыбораФайлаОсобогоМненияСотрудника
Процедура ОбработатьВыборФайлаОсобогоМненияСотрудника(ЗначениеВыбора, ДополнительныеПараметры) Экспорт
	Если ЗначениеЗаполнено(ЗначениеВыбора) Тогда
		ОбщегоНазначенияБГУВызовСервера.ОбработатьВыборФайлаОсобогоМненияСотрудника(ДополнительныеПараметры.Документ,
			ДополнительныеПараметры.Сотрудник, ЗначениеВыбора);
		Если ТипЗнч(ДополнительныеПараметры.ОповещениеПослеВыбора) = Тип("ОписаниеОповещения") Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОповещениеПослеВыбора, ЗначениеВыбора);
		ИначеЕсли ТипЗнч(ДополнительныеПараметры.ОповещениеПослеВыбора) = Тип("Булево")
				И ДополнительныеПараметры.ОповещениеПослеВыбора Тогда
			ТекущиеДанные = ДополнительныеПараметры.ТаблицаФормы.ТекущиеДанные;
			ТекущиеДанные.ФайлОсобогоМнения = ЗначениеВыбора;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Удалить файл особого мнения сотрудника.
// 
// Параметры:
//  Параметры - см. ОбщегоНазначенияБГУКлиентСервер.ПараметрыВыбораФайлаОсобогоМненияСотрудника
//  СтандартнаяОбработка - Булево
Процедура УдалитьФайлОсобогоМненияСотрудника(Параметры, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(Параметры.Сотрудник) И ЗначениеЗаполнено(Параметры.Файл) Тогда
		ОбщегоНазначенияБГУВызовСервера.УдалитьФайлОсобогоМненияСотрудника(Параметры.Документ, Параметры.Сотрудник);
		Если ТипЗнч(Параметры.ОповещениеПослеВыбора) = Тип("ОписаниеОповещения") Тогда
			ВыполнитьОбработкуОповещения(Параметры.ОповещениеПослеВыбора);
		ИначеЕсли ТипЗнч(Параметры.ОповещениеПослеВыбора) = Тип("Булево")
				И Параметры.ОповещениеПослеВыбора Тогда
			ТекущиеДанные = Параметры.ТаблицаФормы.ТекущиеДанные;
			ТекущиеДанные.ФайлОсобогоМнения = Неопределено;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Показывает вопрос об открытии регистратора текущей строки. Если ответ утвердительный, то открывает регистратор.
// Вызывается из события Выбор таблицы проводок в журналах документов
//
// Параметры:
//	ВыбраннаяСтрока - ДанныеФормыЭлементКоллекции, Неопределено - текущая строка таблицы
//
Процедура ОткрытьРегистраторТекущейСтроки(ВыбраннаяСтрока) Экспорт

	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Открыть документ %1?'"), ВыбраннаяСтрока.Регистратор);
		
	ДополнительныеПараметры = Новый Структура("ВыбраннаяСтрока", ВыбраннаяСтрока);
	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьРегистраторТекущейСтрокиЗавершение",
		ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Завершающая процедура к процедуре ОткрытьРегистраторТекущейСтроки.
// Проверяет ответ и, при необходимости, открывает регистратор.
//
Процедура ОткрытьРегистраторТекущейСтрокиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяСтрока = ДополнительныеПараметры.ВыбраннаяСтрока;
	ПоказатьЗначение(Неопределено, ВыбраннаяСтрока.Регистратор);

КонецПроцедуры

// Начинает замер времени создания формы нового документа. Вызывается из обработчика события ПередНачаломДобавления
// списка журнала документов.
//
// Параметры:
//	Параметр - Произвольный - параметр Параметр обработчика события ПередНачаломДобавления
//
Процедура НачатьЗамерВремениДобавление(Параметр) Экспорт

	Если ТипЗнч(Параметр) = Тип("Тип") Тогда
		
		КлючеваяОперация = ОбщегоНазначенияБГУКлиентСервер.ИмяКлючевойОперации(
			Параметр, "СозданиеФормы");
		ОценкаПроизводительностиКлиент.ЗамерВремени(КлючеваяОперация);
		
	КонецЕсли;

КонецПроцедуры

// Начинает замер времени открытия формы существующего документа. Вызывается из обработчика события ПередНачаломИзменения
// списка журнала документов.
// Параметры:
//	Элемент - ЭлементФормы - параметр Элементо обработчика события ПередНачаломИзменения
Процедура НачатьЗамерВремениОткрытие(Элемент) Экспорт

	ДанныеСтроки = Элемент.ТекущиеДанные;
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючеваяОперация = ОбщегоНазначенияБГУКлиентСервер.ИмяКлючевойОперации(
		ДанныеСтроки.Ссылка, "ОткрытиеФормы");
	ОценкаПроизводительностиКлиент.ЗамерВремени(КлючеваяОперация);


КонецПроцедуры

// См. процедуру ОбщегоНазначенияКлиентПереопределяемый.ПриНачалеРаботыСистемы.
//
Процедура ПриНачалеРаботыСистемы(Параметры) Экспорт
	
КонецПроцедуры

// См. процедуру ОбщегоНазначенияКлиентПереопределяемый.ПослеНачалаРаботыСистемы.
//
Процедура ПослеНачалаРаботыСистемы() Экспорт
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументовКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПроцессыОбработкиДокументовКлиент");
		МодульПроцессыОбработкиДокументовКлиент.ПослеНачалаРаботыСистемы();
	КонецЕсли;
	
	БюджетнаяОтчетностьКлиент.ПослеНачалаРаботыСистемы();
	
КонецПроцедуры

#Область РаботаСФормами

// Процедура выполняет общие действия при изменении даты документа:
// - проверяет изменение учетной политики, получает подтверждение пользователя;
// - заполняет признаки в структуре КэшПараметров;
// - при изменении даты передает управление в процедуру-обработчик события "ДатаПриИзменении".
// Вызывается из форм документов, событие "ПриИзмененииДаты".
// 
// Структура КэшПараметров добавляется и инициализируется автоматически процедурами 
// "БухгалтерскиеОперацииСервер.ПриСозданииНаСервере" и "БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере".
//
// Параметры:
//	Форма - УправляемаяФорма - управляемая форма из которой вызывается функция.
//	Объект - ДанныеФормыСтруктура - обычно ЭтаФорма.Объект.
//	ИмяОбработчикаДатаПриИзменении - Строка - имя обработчика события ДатаПриИзменении (&НаКлиенте),
//	в который будет передано управление при изменении даты.
//
Процедура ПриИзмененииДатыДокумента(Форма, Объект, ИмяОбработчикаДатаПриИзменении) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Форма.КэшПараметров.ИзмениласьДатаВПределахДня                     = Ложь;
	Форма.КэшПараметров.ИзмениласьДатаВПределахМесяца                  = Ложь;
	Форма.КэшПараметров.ИзмениласьДатаНаМесяцИБолее                    = Ложь;
	Форма.КэшПараметров.ИзменилсяГодДаты							   = Ложь;
	Форма.КэшПараметров.ИзмениласьДатаСПереходомНачалаПрослеживаемости = Ложь;
	Форма.КэшПараметров.ИзмениласьУчетнаяПолитика                      = Ложь;
	
	Если НачалоДня(Объект.Дата) = НачалоДня(Форма.КэшПараметров.Дата) Тогда
		Форма.КэшПараметров.ИзмениласьДатаВПределахДня = Истина;
	ИначеЕсли НачалоМесяца(Объект.Дата) <> НачалоМесяца(Форма.КэшПараметров.Дата) Тогда
		Форма.КэшПараметров.ИзмениласьДатаНаМесяцИБолее = Истина;
	Иначе
		Форма.КэшПараметров.ИзмениласьДатаВПределахМесяца = Истина;
	КонецЕсли; 
	Если Год(Объект.Дата) <> Год(Форма.КэшПараметров.Дата) Тогда
		Форма.КэшПараметров.ИзменилсяГодДаты = Истина;
	КонецЕсли;	
	Форма.КэшПараметров.ИзмениласьДатаСПереходомНачалаПрослеживаемости =
		(Объект.Дата < ПрослеживаемостьБГУКлиентСервер.ДатаНачалаУчетаПрослеживаемыхТоваров()) <>
		(Форма.КэшПараметров.Дата < ПрослеживаемостьБГУКлиентСервер.ДатаНачалаУчетаПрослеживаемыхТоваров());
	
	Если Форма.КэшПараметров.ИзмениласьДатаНаМесяцИБолее Тогда
	
		// Определим даты учетной политики для сохраненной даты и новой даты
		ДатаУчетнойПолитикиСохр = Форма.КэшПараметров.Дата;
		Для каждого ДатаИзменения Из Форма.КэшПараметров.УчетнаяПолитика.ДатыИзменения Цикл
			Если ДатаИзменения <= ДатаУчетнойПолитикиСохр Тогда
				ДатаУчетнойПолитикиСохр = ДатаИзменения;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ДатаУчетнойПолитикиНов = Объект.Дата;
		Для каждого ДатаИзменения Из Форма.КэшПараметров.УчетнаяПолитика.ДатыИзменения Цикл
			Если ДатаИзменения <= ДатаУчетнойПолитикиНов Тогда
				ДатаУчетнойПолитикиНов = ДатаИзменения;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	
	КонецЕсли;
	
	Форма.КэшПараметров.ИзмениласьУчетнаяПолитика = (Форма.КэшПараметров.ИзмениласьДатаНаМесяцИБолее
		И ДатаУчетнойПолитикиСохр <> ДатаУчетнойПолитикиНов);
	
	Если Форма.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		РеквизитыДокументаЗависящиеОтДаты = Форма.КэшПараметров.Служебные.РеквизитыДокументаЗависящиеОтДаты;
		РеквизитыТиповойОперацииЗависящиеОтДаты = Форма.КэшПараметров.Служебные.РеквизитыТиповойОперацииЗависящиеОтДаты;
		
		ЗадаватьВопрос = РеквизитыДокументаЗависящиеОтДаты.КПС.Количество() > 0
					ИЛИ РеквизитыДокументаЗависящиеОтДаты.КФО.Количество() > 0
					ИЛИ РеквизитыТиповойОперацииЗависящиеОтДаты.Количество() > 0;
		
		Если ЗадаватьВопрос Тогда
			
			Если Форма.КэшПараметров.Дата > Объект.Дата Тогда
				ТекстВопроса =
					НСтр("ru='Установлена дата документа более ранняя, чем дата начала действия текущей учетной политики (рабочего плана счетов).
						|Значения реквизитов КФО и КПС, не соответствующие учетной политике на %1, будут очищены.
						|
						|Изменить дату документа?'");
			Иначе
				ТекстВопроса =
					НСтр("ru='Установлена дата документа более поздняя, чем дата окончания действия текущей учетной политики (рабочего плана счетов).
						|Значения реквизитов КФО и КПС, не соответствующиеучетной политике на %1, будут очищены.
						|
						|Изменить дату документа?'");
			КонецЕсли;
			ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса,
				Формат(ДатаУчетнойПолитикиНов, "ДЛФ=DD"));
			
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Изменить дату документа'"));
			Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='Не изменять дату документа'"));
			
			ДополнительныеПараметры = Новый Структура("Объект, Форма, ИмяОбработчикаДатаПриИзменении, ДатаДействующейУчетнойПолитики",
				Объект, Форма, ИмяОбработчикаДатаПриИзменении, ДатаУчетнойПолитикиНов);
			ПоказатьВопрос(Новый ОписаниеОповещения("ПриИзмененииДатыДокументаЗавершение", ЭтотОбъект, ДополнительныеПараметры),
				ТекстВопроса, Кнопки, 60);
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяОбработчикаДатаПриИзменении = "ДействияПриИзмененииДатыКлиент" Тогда
		// Старый вариант вызова, в типовой конфигурации более не применяется, оставлен для совместимости.
		Оповестить("ОбщегоНазначенияБГУКлиент_ДействияПриИзмененииДаты",
			Дата(1,1,1), Форма.УникальныйИдентификатор);
	Иначе
		ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения(ИмяОбработчикаДатаПриИзменении, Форма));
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриИзмененииДатыДокументаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Объект = ДополнительныеПараметры.Объект;
	Форма  = ДополнительныеПараметры.Форма;
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда // Пользователь отказался от изменения даты документа.
		
		Объект.Дата = Форма.КэшПараметров.Дата; // Возвращаем прежнее значение даты.
		// Сбрасываем признаки изменения даты и учетной политики.
		Форма.КэшПараметров.ИзмениласьДатаВПределахДня    = Ложь;
		Форма.КэшПараметров.ИзмениласьДатаВПределахМесяца = Ложь;
		Форма.КэшПараметров.ИзмениласьДатаНаМесяцИБолее   = Ложь;
		Форма.КэшПараметров.ИзмениласьУчетнаяПолитика     = Ложь;
		
	Иначе // Пользователь подтвердил изменение даты.
		
		Если ДополнительныеПараметры.ИмяОбработчикаДатаПриИзменении = "ДействияПриИзмененииДатыКлиент" Тогда
			// Старый вариант вызова, в типовой конфигурации более не применяется, оставлен для совместимости.
			Оповестить("ОбщегоНазначенияБГУКлиент_ДействияПриИзмененииДаты",
				ДополнительныеПараметры.ДатаДействующейУчетнойПолитики, Форма.УникальныйИдентификатор);
		Иначе
			ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения(ДополнительныеПараметры.ИмяОбработчикаДатаПриИзменении, Форма));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриИзмененииКлючевогоРеквизита(Форма) Экспорт
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументовКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПроцессыОбработкиДокументовКлиент");
		МодульПроцессыОбработкиДокументовКлиент.ОбновитьРеквизитыПоШаблонуПроцесса(Форма);
	КонецЕсли;
	
	ПервичныеДокументыБГУКлиентСервер.ПриИзмененииКлючевогоРеквизита(Форма);
	
КонецПроцедуры

Процедура ПослеИзмененияКлючевыхРеквизитовДокумента(Форма, Объект) Экспорт
	
	// Запомним новые значения реквизитов документа в параметрах контроля.
	Форма.КэшПараметров.Дата        = Объект.Дата;
	Форма.КэшПараметров.Организация = Объект.Организация;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ИФО") Тогда
		Форма.КэшПараметров.ИФО = Объект.ИФО;
	КонецЕсли;  
		
	// Сбрасываем признаки изменения даты и учетной политики.
	Форма.КэшПараметров.ИзмениласьДатаВПределахДня    = Ложь;
	Форма.КэшПараметров.ИзмениласьДатаВПределахМесяца = Ложь;
	Форма.КэшПараметров.ИзмениласьДатаНаМесяцИБолее   = Ложь;
	Форма.КэшПараметров.ИзмениласьУчетнаяПолитика     = Ложь; 
	
	// Если используется отдельная дата проведения, установить новый заголовок, т.к. могла измениться дата документа
	УстановитьЗаголовокРеквизитаДатаПроведения(Форма, Объект);
	
КонецПроцедуры

// Устанавливает значение реквизита формы "ДатаПроведенияЗаголовок", если в документе используется
// отдельная дата проведения.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Объект - ДанныеФормыСтруктура:
//   * Дата - Дата
//
Процедура УстановитьЗаголовокРеквизитаДатаПроведения(Форма, Объект) Экспорт
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ДатыПроведенияДокументов") Тогда
		Форма.ДатаПроведенияЗаголовок = ?(ЗначениеЗаполнено(Форма.ДатыПроведенияДокументов.ДатаПроведения),
			Форма.ДатыПроведенияДокументов.ДатаПроведения,
			Объект.Дата);
	КонецЕсли;
КонецПроцедуры

// Функция возвращает Истина, если при изменении даты документа требуется перечитать 
// настройки из базы данных на сервере.
//
Функция ТребуетсяВызовСервераПриИзмененииДатыДокумента(НоваяДата, ПредыдущаяДата) Экспорт

	Результат = Ложь;
	
	Если НачалоДня(НоваяДата) = НачалоДня(ПредыдущаяДата) Тогда
		// Ничего не изменилось либо изменилось только время, от которого ничего не зависит
		Возврат Ложь;
	КонецЕсли;
	
	Если НачалоМесяца(НоваяДата) <> НачалоМесяца(ПредыдущаяДата) Тогда
		// Учетная политика задается с периодичностью до месяца,
		// поэтому в пределах месяца изменения даты не учитываем.
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СчетФактураНажатие(СчетФактура, Форма, СтандартнаяОбработка, ВидСчетаФактуры=Неопределено) Экспорт
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Форма.Параметры.Ключ) ИЛИ Форма.Модифицированность Тогда
		ОбъектЗаписан = Форма.Записать();
		
		Если НЕ ОбъектЗаписан Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;		
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		Параметры = Новый Структура("Ключ", СчетФактура);
		
		// Определим вид счета-фактуры:
		Если ВидСчетаФактуры = Неопределено Тогда
			Если ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
				ВидСчетаФактуры = "СчетФактураВыданный";
				
			ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
				ВидСчетаФактуры = "КорректировочныйСчетФактураВыданный";
				
			ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
				ВидСчетаФактуры = "ИсправительныйСчетФактураВыданный";
				
			ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				ВидСчетаФактуры = "СчетФактураПолученный";
				
			ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный") Тогда
				ВидСчетаФактуры = "КорректировочныйСчетФактураПолученный";
				
			ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный") Тогда
				ВидСчетаФактуры = "ИсправительныйСчетФактураПолученный";
			
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		Если Форма.Объект.ПометкаУдаления Тогда
			ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Счет-фактуру нельзя вводить на основании документа, помеченного на удаление.'"));
			Возврат;
		КонецЕсли;
		
		Основание = Форма.Параметры.Ключ;
		
		Параметры = Новый Структура("Основание", Основание);
		
		ДокументПоддерживаетКорректировкуРеализации = (
			ТипЗнч(Основание) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
			ИЛИ ТипЗнч(Основание) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		);
		
		ДокументПоддерживаетКорректировкуПоступления = (ТипЗнч(Основание) = Тип("ДокументСсылка.ПоступлениеМЗ"));
		
		Если ДокументПоддерживаетКорректировкуРеализации Тогда
			ВидСчетаФактуры = УчетНДСВызовСервера.ОпределитьПодходящийВидСчетаФактурыРеализация(Основание);
			
			Если ВидСчетаФактуры = Неопределено Тогда
				ТекстСообщения = НСтр("ru='Не удалось автоматически определить подходящий вид создаваемого счета-фактуры.'");
				
				ПоказатьПредупреждение(Неопределено, ТекстСообщения);
				
				Возврат;
			КонецЕсли;
			
		ИначеЕсли ДокументПоддерживаетКорректировкуПоступления Тогда
			ВидСчетаФактуры = УчетНДСВызовСервера.ОпределитьПодходящийВидСчетаФактурыПоступления(Основание);
			
			Если ВидСчетаФактуры = Неопределено Тогда
				ТекстСообщения = НСтр("ru='Не удалось автоматически определить подходящий вид создаваемого счета-фактуры.'");
				
				ПоказатьПредупреждение(Неопределено, ТекстСообщения);
				
				Возврат;
			КонецЕсли;
			
		ИначеЕсли ВидСчетаФактуры = Неопределено Тогда
			Попытка
				ВидСчетаФактурыИзФормы = Форма["ВидСчетаФактуры"];
				Если НЕ ВРег(ВидСчетаФактурыИзФормы) = "СЧЕТФАКТУРАВЫДАННЫЙ" Тогда
					ВидСчетаФактурыИзФормы = "СчетФактураПолученный";
				КонецЕсли;
			Исключение
			КонецПопытки;
			ВидСчетаФактуры = ВидСчетаФактурыИзФормы;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидСчетаФактуры) Тогда
		ВидСчетаФактуры = "СчетФактураПолученный";
	КонецЕсли;
	
	// Открываем форму счета-фактуры:
	ФормаСФ = ОткрытьФорму("Документ."+ВидСчетаФактуры+".ФормаОбъекта", Параметры, Форма);
	
КонецПроцедуры

Процедура ОткрытьФормуДокументаСписанияЗапчастей(ДокументСсылка, Форма) Экспорт
	
	Если ЗначениеЗаполнено(ДокументСсылка) И ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияМЗ") Тогда
		
		ПараметрыФормы = Новый Структура("Ключ", ДокументСсылка);
		ОткрытьФорму("Документ.АктСписанияМЗ.ФормаОбъекта", ПараметрыФормы);
		
	Иначе
		
		Если Форма.Объект.ПометкаУдаления Тогда
			ТекстСообщения = НСтр("ru = 'Списание запчастей нельзя вводить на основании документа, помеченного на удаление.'");
			ПоказатьПредупреждение(Неопределено, ТекстСообщения);
		Иначе
			ПараметрыФормы = Новый Структура("Основание", Форма.Объект.Ссылка);
			ОткрытьФорму("Документ.АктСписанияМЗ.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗакрытием(Форма, Источник, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка) Экспорт
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументовКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПроцессыОбработкиДокументовКлиент");
		МодульПроцессыОбработкиДокументовКлиент.ПередЗакрытием(Форма, Источник, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьЗадачу(Форма, Команда, Источник) Экспорт
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументовКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПроцессыОбработкиДокументовКлиент");
		МодульПроцессыОбработкиДокументовКлиент.ВыполнитьЗадачу(Форма, Команда, Источник);
	КонецЕсли;
	
КонецПроцедуры

Процедура КомментарийНаправившегоОткрытие(Форма, Элемент, СтандартнаяОбработка) Экспорт
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументовКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПроцессыОбработкиДокументовКлиент");
		МодульПроцессыОбработкиДокументовКлиент.КомментарийНаправившегоОткрытие(Форма, Элемент, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

Процедура КомментарийСледующемуНачалоВыбора(Форма, Элемент, ДанныеВыбора, СтандартнаяОбработка) Экспорт
	
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
