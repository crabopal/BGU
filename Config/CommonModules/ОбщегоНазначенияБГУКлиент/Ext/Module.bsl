// Процедура выбора председателя комиссии. Вся логика процедуры реализована здесь, в вызывающем документе
// никакие дополнительные действия не требуются.
//
// Параметры:
//  Форма						 - УправляемаяФорма - форма документа, из которого происходит вызов
//  ИменаРеквизитовЗаполнения	 - 	 -структура имен реквизитов. для получения структуры используется
// функция ОбщегоНазначенияБГУКлиент.СтруктураИменРеквизитовВыбораПредседателяКомиссии()
Процедура НачатьВыборПредседателяКомиссии(Форма, ИменаРеквизитовЗаполнения) Экспорт
	
	Объект = Форма.Объект;
	
	Отбор = Новый Структура("Владелец", Объект.Организация);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ДатаИнвентаризации") Тогда
		Отбор.Вставить("Период", Объект.ДатаИнвентаризации);
	КонецЕсли;
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("Отбор", Отбор);
	ПараметрыВыбора.Вставить("ТребуемыеДанные", "Фамилия,Имя,Отчество,Должность");
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Форма", Форма);
	ДопПараметры.Вставить("ИменаРеквизитов", ИменаРеквизитовЗаполнения);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеВыбораПредседателяКомиссии", ЭтотОбъект, ДопПараметры);
	
	ОткрытьФорму("Справочник.Сотрудники.ФормаВыбора", ПараметрыВыбора, Форма,,,,
		ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Служебная процедура выбора председателя комиссии. Для выбора председателя следует использовать
// ОбщегоНазначенияБГУКлиент.НачатьВыборПредседателяКомиссии()
Процедура ЗавершениеВыбораПредседателяКомиссии(ВыбранноеЗначение, ДопПараметры) Экспорт
	Перем Должность;
	Перем Фамилия;
	Перем Имя;
	Перем Отчество;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		
		Форма = ДопПараметры.Форма;
		Объект = Форма.Объект;
		ИменаРеквизитов = ДопПараметры.ИменаРеквизитов;
		
		ВыбранноеЗначение.Свойство("Должность", Должность);
		ВыбранноеЗначение.Свойство("Фамилия", 	Фамилия);
		ВыбранноеЗначение.Свойство("Имя", 		Имя);
		ВыбранноеЗначение.Свойство("Отчество",	Отчество);
		
		Если Не ЗначениеЗаполнено(Фамилия) Тогда
			ЧастиИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(Строка(ВыбранноеЗначение.Ссылка));
			Если ЧастиИмени.Количество() > 0 Тогда
				Фамилия = ЧастиИмени[0];
				Если ЧастиИмени.Количество() > 1 Тогда
					Имя = ЧастиИмени[1];
					Если ЧастиИмени.Количество() > 2 Тогда
						Отчество = ЧастиИмени[2];
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Объект[ИменаРеквизитов.Должность] = Должность;
		Объект[ИменаРеквизитов.Фамилия] = Фамилия;
		Объект[ИменаРеквизитов.Имя] = Имя;
		Объект[ИменаРеквизитов.Отчество] = Отчество;
		
		Форма.Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// Открывает подбор комиссии из справочника "Сотрудники" с отбором по организации.
// ФИО физлиц получает на дату документа.
//
// Параметры:
//  Элемент		 - ЭлементФормы - Таблица формы, в которую передается событие Выбор
//  Объект	 - ДанныеФормыСтруктура - Объект формы
Процедура ОткрытьПодборКомиссии(Элемент, Объект) Экспорт
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ДатаИнвентаризации") Тогда
		НаДату = Объект.ДатаИнвентаризации;
	Иначе
		НаДату = Объект.Дата;
	КонецЕсли;
	
	Отбор = Новый Структура("Владелец", Объект.Организация);
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("Отбор", Отбор);
	ПараметрыВыбора.Вставить("ТребуемыеДанные", "Фамилия,Имя,Отчество,Должность");
	ПараметрыВыбора.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыВыбора.Вставить("Период", НачалоДня(НаДату));
	
	ОткрытьФорму("Справочник.Сотрудники.ФормаВыбора", ПараметрыВыбора, Элемент);
	
КонецПроцедуры

// Добавляет строку в таблицу "СоставКомиссии". Если параметр ВыбранноеЗначение - структура, то
// из нее получает должность, фамилию, имя и отчество в новую строку таблицы.
// Используется в обработке выбора таблицы "СоставКомиссии".
//
// Параметры:
//  Форма				 - УправляемаяФорма - Вызывающая форма.
//  ВыбранноеЗначение	 - Произвольный - стандартный параметр обработчика "ОбработкаВыбора".
//  СтандартнаяОбработка - Булево - стандартный параметр обработчика "ОбработкаВыбора".
Процедура ОбработатьПодборКомиссии(Форма, ВыбранноеЗначение, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		
		НоваяСтрока = Форма.Объект.СоставКомиссии.Добавить();
		ВыбранноеЗначение.Свойство("Должность"	, НоваяСтрока.ДолжностьЧленаКомиссии);
		ВыбранноеЗначение.Свойство("Фамилия"	, НоваяСтрока.ФамилияЧленаКомиссии);
		ВыбранноеЗначение.Свойство("Имя"		, НоваяСтрока.ИмяЧленаКомиссии);
		ВыбранноеЗначение.Свойство("Отчество"	, НоваяСтрока.ОтчествоЧленаКомиссии);
		
		СтандартнаяОбработка = Ложь;
		Форма.Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура выбора постоянно действующей комиссии в документ. Вся логика выбора реализована здесь,
// в вызывающем документе никакие дополнительные действия не требуются
//
// Параметры:
//  Форма						 - УправляемаяФорма - вызывающая форма.
//  ИменаРеквизитовПредседателя	 - Структура - структура имен реквизитов. для получения структуры используется
// функция ОбщегоНазначенияБГУКлиент.СтруктураИменРеквизитовВыбораПредседателяКомиссии().
//  ЕстьНомерПриказа			 - Булево - Истина, если в документе есть реквизиты "НомерПриказа" и "ДатаПриказа".
//  НаДату                       - Дата - Дата для отбора комиссий по актуальности
Процедура НачатьВыборПостоянноДействующейКомиссии(
	Форма, ИменаРеквизитовПредседателя, ЕстьНомерПриказа = Ложь, НаДату = Неопределено) Экспорт
	
	Объект = Форма.Объект;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", "Организация"),,
			"Объект.Организация");
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("Владелец", Объект.Организация);
	ПараметрыФормы = Новый Структура("Отбор", Отбор);   
	Если ЗначениеЗаполнено(НаДату) Тогда
		ПараметрыФормы.Вставить("НаДату", НаДату);
	КонецЕсли;	
	
	Приказ = Новый Структура("ЕстьНомерПриказа,НомерПриказа,ДатаПриказа", Ложь, "", "");
	Приказ.Вставить("НаименованиеПриказа", "НаименованиеПриказа");
	Если ЕстьНомерПриказа = Истина Тогда
		Приказ.ЕстьНомерПриказа	= Истина;
		Приказ.НомерПриказа		= "НомерПриказа";
		Приказ.ДатаПриказа		= "ДатаПриказа";
	ИначеЕсли ТипЗнч(ЕстьНомерПриказа) = Тип("Структура") Тогда
		Приказ.ЕстьНомерПриказа	= Истина;
		Приказ.НомерПриказа		= ЕстьНомерПриказа.НомерПриказа;
		Приказ.ДатаПриказа		= ЕстьНомерПриказа.ДатаПриказа;
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Форма", Форма);
	ДопПараметры.Вставить("ИменаРеквизитовПредседателя", ИменаРеквизитовПредседателя);
	ДопПараметры.Вставить("Приказ", Приказ);
	ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьКомиссиюВДокумент", Форма, ДопПараметры);
	
	ОткрытьФорму("Справочник.ПостоянноДействующиеКомиссии.ФормаВыбора", ПараметрыФормы, Форма,,,,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Служебная процедура выбора комиссии. Для выбора комиссии следует использовать
// ОбщегоНазначенияБГУКлиент.НачатьВыборПостоянноДействующейКомиссии()
Процедура УстановитьКомиссиюВДокумент(Результат, ДопПараметры, Объект) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиентСервер.ЗаполнитьКомиссиюВДокументе(Результат, ДопПараметры, Объект);
	Форма = Неопределено;
	Если ДопПараметры.Свойство("Форма", Форма) И Форма <> Неопределено Тогда
		Форма.Модифицированность = Истина;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ИнтеграцияПанельАдминистрированияБСП

Процедура ВыполнитьКомандуПанельОбслуживание(Команда) Экспорт
	
	Если Команда.Имя = "ОбработкаЗаменаЗначенийОткрыть" Тогда
		ОткрытьФорму("Обработка.ПоискИЗаменаЗначений.Форма");
		
	ИначеЕсли Команда.Имя = "ОбработкаСверткаИнформационнойБазыОткрыть" Тогда
		ОткрытьФорму("Обработка.СверткаИнформационнойБазыОстатками.Форма.Старт");
		
	ИначеЕсли Команда.Имя = "ПомощникЗаменыОКОФОткрыть" Тогда	
		ОткрытьФорму("Обработка.ПомощникЗаменыОКОФ.Форма");
		
	ИначеЕсли Команда.Имя = "ОбработкаЗаменаТиповыхОперацийДопРеквизитовОткрыть" Тогда
		ОткрытьФорму("Обработка.ЗаменаТиповыхОперацийДопРеквизитов.Форма.Форма");
		
	ИначеЕсли Команда.Имя = "ПомощникПереносаОстатковМеждуСчетамиОткрыть" Тогда
		ОткрытьФорму("Обработка.ПомощникПереносаОстатковМеждуСчетами.Форма.Форма");
		
	ИначеЕсли Команда.Имя = "ПомощникПереносаОстатковУстаревшихСчетовОткрыть" Тогда
		ОткрытьФорму("Обработка.ПомощникПереносаОстатковМеждуСчетами.Форма.ФормаУстаревшиеСчета");
		
	ИначеЕсли Команда.Имя = "ЗаполнениеРегистровОСОткрыть" Тогда
		ОткрытьФорму("Обработка.ЗаполнениеРегистровОС.Форма.Форма");
		
	ИначеЕсли Команда.Имя = "КорректировкаНезаполненныхСубконтоВПроводкахОткрыть" Тогда
		ОткрытьФорму("Обработка.КорректировкаНезаполненныхСубконтоВПроводках.Форма.Форма");
		
	ИначеЕсли Команда.Имя ="ПроверкаИспользованияПодразделенийВалютыОткрыть" Тогда
		ОткрытьФорму("Обработка.ПроверкаИспользованияПодразделенийВалюты.Форма.Форма");
		
	ИначеЕсли Команда.Имя = "КорректировкаАналитикиНалоговогоУчетаОткрыть" Тогда
		ОткрытьФорму("Обработка.КорректировкаАналитикиНалоговогоУчета.Форма.Форма");
		
	ИначеЕсли Команда.Имя = "ПомощникЗаполненияПодразделенийВПроводкахОткрыть" Тогда
		ОткрытьФорму("Обработка.ПомощникЗаполненияПодразделенийВПроводках.Форма.Форма");
		
	ИначеЕсли Команда.Имя = "ЗаменаУстаревших205ВАвансовыхСчетахФактурахОткрыть" Тогда
		ОткрытьФорму("Обработка.ЗаменаУстаревших205ВАвансовыхСчетахФактурах.Форма.Форма");
		
	ИначеЕсли Команда.Имя = "КонсольЗапросовОткрыть" Тогда
		ОткрытьФорму("Обработка.КонсольЗапросов.Форма.Форма");	
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьКомандуПанельОрганайзер(Команда) Экспорт
	
	Если Команда.Имя = "НастройкиПроцессовОбработкиДокументов" Тогда
		ИмяФормы = "ОбщаяФорма.НастройкиПроцессовОбработкиДокументов";
		ОткрытьФорму(ИмяФормы);
	ИначеЕсли Команда.Имя = "ОткрытьСправочникСтатусыДокументов" Тогда
		ИмяФормы = "Справочник.СтатусыДокументов.ФормаСписка";
		ОткрытьФорму(ИмяФормы);
	ИначеЕсли Команда.Имя = "ОткрытьСправочникЭтапыПроцессов" Тогда
		ИмяФормы = "Справочник.ЭтапыПроцессов.ФормаСписка";
		ОткрытьФорму(ИмяФормы);
	ИначеЕсли Команда.Имя = "ОткрытьСправочникШаблоныПроцессов" Тогда
		ИмяФормы = "Справочник.ШаблоныПроцессов.ФормаСписка";
		ОткрытьФорму(ИмяФормы);
	ИначеЕсли Команда.Имя = "ОткрытьСправочникВидыДополнительныхЗаданий" Тогда
		ИмяФормы = "Справочник.ВидыДополнительныхЗаданий.ФормаСписка";
		ОткрытьФорму(ИмяФормы);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьКомандуПанельПечатныеФормыОтчетыИОбработки(Команда) Экспорт
	
	Если Команда.Имя = "ИнструкцияПоСозданиюФаксимильнойПодписиИПечатиБГУ" Тогда
		УправлениеПечатьюКлиент.ПоказатьИнструкциюПоСозданиюФаксимильнойПодписиИПечати();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

 #Область МеханизмГолосованияКомиссии

#Область ОбработчикиКомандФормы

Процедура КомандаСохранитьРезультатыГолосования(Форма) Экспорт
	
	Сотрудник = Форма[Форма.НастройкиМеханизмаГолосованияКомиссии.ИменаРеквизитов.Сотрудник];
	
	ТабличнаяЧасть = Форма.Объект[Форма.НастройкиМеханизмаГолосованияКомиссии.ИмяТабличнойЧасти];
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Форма", Форма);
	ДопПараметры.Вставить("Сотрудник", Сотрудник);
	ДопПараметры.Вставить("РезультатыГолосования", ОбщегоНазначенияБГУКлиентСервер.МеханизмГолосованияКомиссии_ПолучитьРезультатыГолосованияСотрудника(ТабличнаяЧасть));
	
	Оповещение = Новый ОписаниеОповещения("МеханизмГолосованияКомиссии_ВопросСохранитьРезультатыГолосованияЗавершение", ЭтотОбъект, ДопПараметры);
	
	ТекстВопроса = СтрШаблон(НСтр("ru='Сохранить результаты голосования члена комиссии ""%1""?'"), Сотрудник);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_КомандаУстановитьРешениеЗаВВыделенныхСтроках(Форма) Экспорт
	
	МеханизмГолосованияКомиссии_УстановитьГолосВСтрокахДокумента(Форма, "За", Ложь);
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_КомандаУстановитьРешениеЗаВоВсехСтроках(Форма) Экспорт
	
	МеханизмГолосованияКомиссии_УстановитьГолосВСтрокахДокумента(Форма, "За", Истина);
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_КомандаУстановитьРешениеПротивВВыделенныхСтроках(Форма) Экспорт
	
	МеханизмГолосованияКомиссии_УстановитьГолосВСтрокахДокумента(Форма, "Против", Ложь);
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_КомандаУстановитьРешениеПротивВоВсехСтроках(Форма) Экспорт
	
	МеханизмГолосованияКомиссии_УстановитьГолосВСтрокахДокумента(Форма, "Против", Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура МеханизмГолосованияКомиссии_СотрудникПриИзменении(Форма, Элемент) Экспорт
	
	ИменаРеквизитов = Форма.НастройкиМеханизмаГолосованияКомиссии.ИменаРеквизитов;
	
	ТабличнаяЧасть = Форма.Объект[Форма.НастройкиМеханизмаГолосованияКомиссии.ИмяТабличнойЧасти];
	
	РешениеСотрудникаМодифицированность	= Форма[ИменаРеквизитов.РешениеСотрудникаМодифицированность];
	ВыбранныйСотрудник					= Форма[ИменаРеквизитов.ВыбранныйСотрудник];
	Сотрудник							= Форма[ИменаРеквизитов.Сотрудник];
	
	Если РешениеСотрудникаМодифицированность
		И ЗначениеЗаполнено(ВыбранныйСотрудник)
		И ВыбранныйСотрудник <> Сотрудник Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Форма", Форма);
		ДопПараметры.Вставить("Сотрудник", ВыбранныйСотрудник);
		ДопПараметры.Вставить("РезультатыГолосования", ОбщегоНазначенияБГУКлиентСервер.МеханизмГолосованияКомиссии_ПолучитьРезультатыГолосованияСотрудника(ТабличнаяЧасть));
		
		Оповещение = Новый ОписаниеОповещения("МеханизмГолосованияКомиссии_ВопросСохранитьРезультатыГолосованияЗавершение", ЭтотОбъект, ДопПараметры);
		
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Сохранить результаты голосования члена комиссии ""%1""?'"), ВыбранныйСотрудник);
			
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("МеханизмГолосованияКомиссии_СотрудникПриИзменении_Клиент", Форма);
	
	ВыполнитьОбработкуОповещения(Оповещение);
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_СотрудникНачалоВыбора(Форма, Элемент, ДанныеВыбора, СтандартнаяОбработка) Экспорт
	
	// Выбирается из присутствующих членов комиссии.
	
	Объект = Форма.Объект;
	
	ОтборПрисутствующих = Новый Структура("Отсутствует", Ложь);
	
	ПрисутствующиеЧленыКомиссии = Объект.СоставКомиссии.НайтиСтроки(ОтборПрисутствующих);
	
	Элемент.СписокВыбора.Очистить();
	
	Если ПрисутствующиеЧленыКомиссии.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Не указаны присутствующие члены комиссии.
			|Проверьте состав комиссии на закладке ""Комиссия""'"), 20);
	КонецЕсли;
	
	Для Каждого ЧленКомиссии Из ПрисутствующиеЧленыКомиссии Цикл
		Элемент.СписокВыбора.Добавить(ЧленКомиссии.Сотрудник);
	КонецЦикла;
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_РешениеСотрудникаПоРезолюцииОбработкаВыбора(Форма, Элемент, ВыбранноеЗначение, СтандартнаяОбработка) Экспорт
	
	// Используем событие ОбработкаВыбора вместо ПриИзменении потому, что 
	// при изменении поля добавленной колонки ошибочно взводится признак модифицированности формы.
	// Этот признак модифицированности формы нам нужно оставить сброшенным.
	
	СтандартнаяОбработка = Ложь;
	
	ИмяТабличнойЧасти = Форма.НастройкиМеханизмаГолосованияКомиссии.ИмяТабличнойЧасти;
	
	ТекДанные = Форма.Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИменаКолонок = Форма.НастройкиМеханизмаГолосованияКомиссии.ИменаКолонок;
	
	ТекДанные[ИменаКолонок.РешениеСотрудникаПоРезолюции] = ВыбранноеЗначение;
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмГолосованияКомиссии_УстановитьПризнакМодифицированностиРешенияСотрудника(Форма, Истина);
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмГолосованияКомиссии_УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(Форма);
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_ВопросСохранитьРезультатыГолосованияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	// При любом ответе сбрасываем признак модифицированности.
	
	Форма = ДополнительныеПараметры.Форма;
	
	Объект = Форма.Объект;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ДополнительныеПараметры.Удалить("Форма");
		
		Оповещение = Новый ОписаниеОповещения("МеханизмГолосованияКомиссии_СохранитьРезультатыГолосования_Клиент", Форма, ДополнительныеПараметры);
		
		ВыполнитьОбработкуОповещения(Оповещение);
		
		ОповеститьОбИзменении(Объект.Ссылка);
		
	КонецЕсли;
	
	ИменаРеквизитов = Форма.НастройкиМеханизмаГолосованияКомиссии.ИменаРеквизитов;
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмГолосованияКомиссии_УстановитьПризнакМодифицированностиРешенияСотрудника(Форма, Ложь);
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмГолосованияКомиссии_УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(Форма);
	
КонецПроцедуры

Асинх Процедура РешениеСотрудникаПоРезолюцииВыбор(Форма, Поле, СтандартнаяОбработка) Экспорт
	
	Если НЕ Форма.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Если Прав(Поле.Имя, 28) <> "РешениеСотрудникаПоРезолюции" Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ОбщегоНазначенияБГУВызовСервера.ЕстьПравоГолосования() Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.За"));
	СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.Против"));
	
	Результат = Ждать Форма.ВыбратьИзСпискаАсинх(СписокВыбора, Поле);
	
	Если Результат = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	Поле.Родитель.ТекущиеДанные.РешениеСотрудникаПоРезолюции = Результат.Значение;
	
	Форма.РешениеСотрудникаМодифицированность = Истина;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СохранитьРезультатыГолосования", "Доступность",
			ЗначениеЗаполнено(Форма.Сотрудник) И Форма.РешениеСотрудникаМодифицированность);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

Процедура МеханизмГолосованияКомиссии_УстановитьГолосВСтрокахДокумента(Форма, ГолосСотрудника, ВоВсехСтроках = Истина) Экспорт
	
	ТабличнаяЧасть = Форма.Объект[Форма.НастройкиМеханизмаГолосованияКомиссии.ИмяТабличнойЧасти];
	
	ЭлементТаблицы = Форма.Элементы[Форма.НастройкиМеханизмаГолосованияКомиссии.ИмяТабличнойЧасти];
	
	ИмяКолонкиГолос = "РешениеСотрудникаПоРезолюции";
	
	ИмяРеквизитаМодифицированность = "РешениеСотрудникаМодифицированность";
	
	РешениеСотрудникаПоРезолюции = ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.ПустаяСсылка");
	
	Если НРег(ГолосСотрудника) = НРег("За") Тогда
		РешениеСотрудникаПоРезолюции = ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.За");
		
	ИначеЕсли НРег(ГолосСотрудника) = НРег("Против") Тогда
		РешениеСотрудникаПоРезолюции = ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.Против");
		
	КонецЕсли;
	
	Если ВоВсехСтроках Тогда
		Для Каждого СтрокаДокумента Из ТабличнаяЧасть Цикл
			СтрокаДокумента[ИмяКолонкиГолос] = РешениеСотрудникаПоРезолюции;
		КонецЦикла;
	Иначе
		Для Каждого ИдентификаторВыделеннойСтроки Из ЭлементТаблицы.ВыделенныеСтроки Цикл
			СтрокаДокумента = ТабличнаяЧасть.НайтиПоИдентификатору(ИдентификаторВыделеннойСтроки);
			СтрокаДокумента[ИмяКолонкиГолос] = РешениеСотрудникаПоРезолюции;
		КонецЦикла;
	КонецЕсли;
	
	Форма[ИмяРеквизитаМодифицированность] = Истина;
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмГолосованияКомиссии_УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(Форма);
	
КонецПроцедуры

#КонецОбласти

#Область ФайлыСотрудников

// Добавление файла

Процедура МеханизмГолосованияКомиссии_НадписьФайлНеВыбранНажатие(Форма, Элемент) Экспорт
	
	ИменаРеквизитов = Форма.НастройкиМеханизмаГолосованияКомиссии.ИменаРеквизитов;
	
	ИменаЭлементов = Форма.НастройкиМеханизмаГолосованияКомиссии.ИменаЭлементов;
	
	Сотрудник = Форма[ИменаРеквизитов.Сотрудник];
	
	ФайлСотрудника = Форма[ИменаРеквизитов.ФайлСотрудника];
	
	Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ФайлСотрудника) Тогда
		СтандартнаяОбработка = Ложь;
		
		ОповещениеФайла = Новый ОписаниеОповещения("Подключаемый_МеханизмГолосованияКомиссии_ОбработатьВыборФайлаСотрудника", Форма);
		
		РаботаСФайламиКлиент.ОткрытьФормуВыбораФайлов(
			Форма.Объект.Ссылка,
			Форма.Элементы[ИменаЭлементов.ФайлСотрудника],
			,ОповещениеФайла);
	КонецЕсли
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_ОбработатьВыборФайлаСотрудника(Форма, ЗначениеВыбора, ДопПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗначениеВыбора) Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеВыбор = Новый ОписаниеОповещения("МеханизмГолосованияКомиссии_ОбработатьВыборФайлаСотрудникаНаСервере", Форма);
	
	ВыполнитьОбработкуОповещения(ОповещениеВыбор, ЗначениеВыбора);
	
КонецПроцедуры

// Удаление файла

Процедура Подключаемый_МеханизмГолосованияКомиссии_НадписьУдалитьФайлНажатие(Форма, Элемент) Экспорт
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	Оповещение = Новый ОписаниеОповещения("Подключаемый_МеханизмГолосованияКомиссии_НадписьУдалитьФайлНажатиеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВопрос(Оповещение, НСтр("ru='Открепить файл сотрудника?'"), РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Процедура Подключаемый_МеханизмГолосованияКомиссии_НадписьУдалитьФайлНажатиеЗавершение(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ДополнительныеПараметры.Форма;
	
	ИменаРеквизитов = Форма.НастройкиМеханизмаГолосованияКомиссии.ИменаРеквизитов;
	
	ИменаЭлементов = Форма.НастройкиМеханизмаГолосованияКомиссии.ИменаЭлементов;
	
	Сотрудник = Форма[ИменаРеквизитов.Сотрудник];
	
	ФайлСотрудника = Форма[ИменаРеквизитов.ФайлСотрудника];
	
	Если НЕ ЗначениеЗаполнено(Сотрудник) ИЛИ НЕ ЗначениеЗаполнено(ФайлСотрудника) Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеВыбор = Новый ОписаниеОповещения("МеханизмГолосованияКомиссии_ОбработатьВыборФайлаСотрудникаНаСервере", Форма);
	
	ВыполнитьОбработкуОповещения(ОповещениеВыбор);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область РезолюцииКомиссий

Процедура УстановитьРезолюциюПоИдентификаторуВСтроке(Форма, ТекДанные, ИдентификаторРезолюции) Экспорт
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаРезолюцииКомиссий;
	
	МассивРезолюций		= НастройкиМеханизма.МассивРезолюций;
	ИмяПоляРезолюция	= НастройкиМеханизма.ИмяПоляРезолюция;
	
	ТекДанные[ИмяПоляРезолюция] = ОбщегоНазначенияБГУКлиентСервер.ПолучитьТекстРезолюцииПоИдентификатору(МассивРезолюций, ИдентификаторРезолюции);
	
КонецПроцедуры

#КонецОбласти

#Область МеханизмОзнакомленияСотрудников

Процедура МеханизмОзнакомленияСотрудников_ПриОткрытииФормы(Форма) Экспорт
	
	МеханизмОзнакомленияСотрудников_ПодключитьОбработчикОжидания(Форма);

КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ПередЗакрытиемФормы(Форма, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка) Экспорт
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	СоответствиеВидДействия = НастройкиМеханизма.СоответствиеВидДействия;
	
	НесохраненныеВидыДействий = Новый Массив();
	
	Для Каждого ЭлементОписания Из НастройкиМеханизма.ТабличныеЧасти Цикл
		ИмяТабличнойЧасти		= ЭлементОписания.Ключ;
		ОписаниеТабличнойЧасти	= ЭлементОписания.Значение;
		
		ИменаРеквизитов = ОписаниеТабличнойЧасти.ИменаРеквизитов;
		
		Если Форма[ИменаРеквизитов.Модифицированность] Тогда
			ВидДействия = СоответствиеВидДействия.Получить(ИмяТабличнойЧасти);
			
			НесохраненныеВидыДействий.Добавить(ВидДействия);
		КонецЕсли;
	КонецЦикла;
	
	Если НесохраненныеВидыДействий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Отказ = Истина;
	
	ШаблоныСообщенийМеханизма = МеханизмОзнакомленияСотрудников_ШаблоныСообщенийМеханизма();
	
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = МеханизмОзнакомленияСотрудников_ПодставитьВидДействия(ШаблоныСообщенийМеханизма.ЗакрытиеФормы.ЗавершениеРаботы, НесохраненныеВидыДействий);
		
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = МеханизмОзнакомленияСотрудников_ПодставитьВидДействия(ШаблоныСообщенийМеханизма.ЗакрытиеФормы.Сохранить, НесохраненныеВидыДействий);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Форма", Форма);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("МеханизмОзнакомленияСотрудников_ПередЗакрытиемФормы_Ответ", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНетОтмена, 20, КодВозвратаДиалога.Да,, КодВозвратаДиалога.Отмена);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ПередЗакрытиемФормы_Ответ(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ДополнительныеПараметры.Форма;
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Оповещение = Новый ОписаниеОповещения("МеханизмОзнакомленияСотрудников_СохранитьПередЗакрытием_Клиент", Форма);
		
		ВыполнитьОбработкуОповещения(Оповещение);
		
		Если Форма.НастройкиМеханизмаОзнакомленияСотрудников.СообщениеОКонфликтахДействийПриЗаписи <> Неопределено Тогда
			// После обработки оповещения актуальная версия формы в переменной Форма
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				Форма.НастройкиМеханизмаОзнакомленияСотрудников.СообщениеОКонфликтахДействийПриЗаписи.ТекстСообщения,
				Форма.Объект.Ссылка,
				Форма.НастройкиМеханизмаОзнакомленияСотрудников.СообщениеОКонфликтахДействийПриЗаписи.ИмяРеквизитаСотрудник);
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ЭлементОписания Из Форма.НастройкиМеханизмаОзнакомленияСотрудников.ТабличныеЧасти Цикл
		ИмяТабличнойЧасти = ЭлементОписания.Ключ;
		
		ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_УстановитьМодифицированность(Форма, ИмяТабличнойЧасти, Ложь);
	КонецЦикла;
	
	Форма.Закрыть();
	
КонецПроцедуры

// Панель механизма

Процедура МеханизмОзнакомленияСотрудников_СотрудникПриИзменении(Форма, Элемент) Экспорт
	
	ИмяТабличнойЧасти = МеханизмОзнакомленияСотрудников_ОпределитьИмяТабличнойЧасти(Форма, Элемент);
	
	ОписаниеТабличнойЧасти = Форма.НастройкиМеханизмаОзнакомленияСотрудников.ТабличныеЧасти[ИмяТабличнойЧасти];
	
	Сотрудник					= Форма[ОписаниеТабличнойЧасти.ИменаРеквизитов.Сотрудник];
	СотрудникПрежнееЗначение	= Форма[ОписаниеТабличнойЧасти.ИменаРеквизитов.СотрудникПрежнееЗначение];
	Модифицированность			= Форма[ОписаниеТабличнойЧасти.ИменаРеквизитов.Модифицированность];
	
	ВозможноПотребуетсяПодтверждение = (Модифицированность И Сотрудник <> СотрудникПрежнееЗначение);
	
	Если Не ОписаниеТабличнойЧасти.ДопустимоЕдиновременноеДействиеВсехСотрудников Тогда
		ВозможноПотребуетсяПодтверждение = ВозможноПотребуетсяПодтверждение И ЗначениеЗаполнено(СотрудникПрежнееЗначение);
	КонецЕсли;
	
	МеханизмОзнакомленияСотрудников_ПроверитьДопустимостьРедактирования(Форма);
	
	Если Не Форма.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование Тогда
		ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_ТекстСообщенияНедопустимоРедактирование();
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	СледуетЗадатьВопрос = ВозможноПотребуетсяПодтверждение И ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_ПодтверждатьСохранениеРезультатов();
	
	Если СледуетЗадатьВопрос Тогда
		МеханизмОзнакомленияСотрудников_ПодтвердитьИНачатьСохранениеРезультатов(Форма, ИмяТабличнойЧасти, Истина);
	Иначе
		МеханизмОзнакомленияСотрудников_ОтработатьИзменениеСотрудника(Форма, ИмяТабличнойЧасти);
	КонецЕсли;
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_СотрудникНачалоВыбора(Форма, Элемент, ДанныеВыбора, СтандартнаяОбработка) Экспорт
	
	МеханизмОзнакомленияСотрудников_ПроверитьДопустимостьРедактирования(Форма);
	
	Если Не Форма.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование Тогда
		ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_ТекстСообщенияНедопустимоРедактирование();
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	СписокВыбора = МеханизмОзнакомленияСотрудников_ПолучитьСписокВыбораСотрудников(Форма, Элемент);
	
	Элемент.СписокВыбора.ЗагрузитьЗначения(СписокВыбора);
	
	Если Элемент.СписокВыбора.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='В табличной части отсутствуют сотрудники'"), 20);
	КонецЕсли;
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ФлажокПриИзменении(Форма, Элемент) Экспорт
	
	МеханизмОзнакомленияСотрудников_ПроверитьДопустимостьРедактирования(Форма);
	
	Если Не Форма.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование Тогда
		ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_ТекстСообщенияНедопустимоРедактирование();
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	ИмяТабличнойЧасти = МеханизмОзнакомленияСотрудников_ОпределитьИмяТабличнойЧасти(Форма, Элемент);
	
	ИменаРеквизитов = Форма.НастройкиМеханизмаОзнакомленияСотрудников.ТабличныеЧасти[ИмяТабличнойЧасти].ИменаРеквизитов;
	
	Флажок = Форма[ИменаРеквизитов.Флажок];
	
	Если Флажок Тогда
		Дата = ОбщегоНазначенияКлиент.ДатаСеанса();
	Иначе
		Дата = '00010101';
	КонецЕсли;
	
	Форма[ИменаРеквизитов.Дата] = Дата;
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_УстановитьМодифицированность(Форма, ИмяТабличнойЧасти, Истина);
	
	МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементовТабличнойЧасти(Форма, ИмяТабличнойЧасти);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ДатаПриИзменении(Форма, Элемент) Экспорт
	
	МеханизмОзнакомленияСотрудников_ПроверитьДопустимостьРедактирования(Форма);
	
	Если Не Форма.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование Тогда
		ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_ТекстСообщенияНедопустимоРедактирование();
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	ИмяТабличнойЧасти = МеханизмОзнакомленияСотрудников_ОпределитьИмяТабличнойЧасти(Форма, Элемент);
	
	ИменаРеквизитов = Форма.НастройкиМеханизмаОзнакомленияСотрудников.ТабличныеЧасти[ИмяТабличнойЧасти].ИменаРеквизитов;
	
	Дата = Форма[ИменаРеквизитов.Дата];
	
	Флажок = ЗначениеЗаполнено(Дата);
	
	Форма[ИменаРеквизитов.Флажок] = Флажок;
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_УстановитьМодифицированность(Форма, ИмяТабличнойЧасти, Истина);
	
	МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементовТабличнойЧасти(Форма, ИмяТабличнойЧасти);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ПроверитьДопустимостьРедактирования(Форма, Инициализация = Ложь) Экспорт
	
	ДопустимоРедактирование = ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование(Форма);
	
	ЕстьИзменениеДоступности = (Форма.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование <> ДопустимоРедактирование);
	
	Если Не Инициализация И Не ЕстьИзменениеДоступности Тогда
		Возврат;
	КонецЕсли;
	
	Форма.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование = ДопустимоРедактирование;
	
	Оповещение = Новый ОписаниеОповещения("МеханизмОзнакомленияСотрудников_НастроитьФормуПослеПроверкиДопустимостиРедактирования_Клиент", Форма);
	
	ВыполнитьОбработкуОповещения(Оповещение);

КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементовТабличнойЧасти(Форма, ИмяТабличнойЧасти);
	
	Оповещение = Новый ОписаниеОповещения("МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементовТабличнойЧасти_Клиент", Форма, ИмяТабличнойЧасти);
	
	ВыполнитьОбработкуОповещения(Оповещение);
	
КонецПроцедуры

// Табличная часть с сотрудниками

Процедура МеханизмОзнакомленияСотрудников_ПриИзмененииТабличнойЧасти(Форма, Элемент) Экспорт
	
	МеханизмОзнакомленияСотрудников_ПроверитьДопустимостьРедактирования(Форма);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ВыборСтрокиТабличнойЧасти(Форма, Элемент, ВыбраннаяСтрока) Экспорт
	
	Если ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_УстановленОтборСотрудника(Форма) Тогда
		// При установленном отборе сотрудника изменение и выбор сотрудника запрещены
		Возврат;
	КонецЕсли;
	
	МеханизмОзнакомленияСотрудников_ПроверитьДопустимостьРедактирования(Форма);
	
	Если Не Форма.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТабличнойЧасти = МеханизмОзнакомленияСотрудников_ОпределитьИмяТабличнойЧасти(Форма, Элемент);
	
	ИменаРеквизитов = Форма.НастройкиМеханизмаОзнакомленияСотрудников.ТабличныеЧасти[ИмяТабличнойЧасти].ИменаРеквизитов;
	
	МеханизмОзнакомленияСотрудников_УстановитьСотрудника(Форма, Элемент, ВыбраннаяСтрока, ИмяТабличнойЧасти, ИменаРеквизитов);
	
	МеханизмОзнакомленияСотрудников_СотрудникПриИзменении(Форма, Элемент);
	
	МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементовТабличнойЧасти(Форма, ИмяТабличнойЧасти);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_СотрудникТабличнойЧастиПриИзменении(Форма, Элемент) Экспорт
	
	МеханизмОзнакомленияСотрудников_ОчиститьДанныеМеханизмаВТекущейСтроке(Форма, Элемент);
	
КонецПроцедуры

// Команды

Процедура МеханизмОзнакомленияСотрудников_КомандаСохранитьРезультаты(Форма, Команда) Экспорт
	
	ИмяТабличнойЧасти = МеханизмОзнакомленияСотрудников_ОпределитьИмяТабличнойЧасти(Форма, Команда);
	
	Если ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_ПодтверждатьСохранениеРезультатов() Тогда
		МеханизмОзнакомленияСотрудников_ПодтвердитьИНачатьСохранениеРезультатов(Форма, ИмяТабличнойЧасти);
	Иначе
		МеханизмОзнакомленияСотрудников_НачатьСохранениеРезультатов(Форма, ИмяТабличнойЧасти);
	КонецЕсли;
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ПодтвердитьИНачатьСохранениеРезультатовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Форма				= ДополнительныеПараметры.Форма;
	ИмяТабличнойЧасти	= ДополнительныеПараметры.ИмяТабличнойЧасти;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		МеханизмОзнакомленияСотрудников_НачатьСохранениеРезультатов(Форма, ИмяТабличнойЧасти, ДополнительныеПараметры);
	КонецЕсли;
	
	Если ДополнительныеПараметры.СобытиеСохранениеПриИзмененииСотрудника Тогда
		МеханизмОзнакомленияСотрудников_ОтработатьИзменениеСотрудника(Форма, ИмяТабличнойЧасти);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

// Устарела.
// При изменении идентификатора первичного документа.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктура:
//    ** ИдентификаторПечатнойФормы - Строка
//    ** ПредставлениеПечатнойФормы - Строка
//   * ПараметрыПечатныхФорм - Структура из см. ПустаяСтрокаПараметраПечатныхФорм
Процедура ПриИзмененииИдентификатораПервичногоДокумента(Форма) Экспорт
	Форма.Объект.ПредставлениеПечатнойФормы = ПредставлениеПечатнойФормыПоИдентификатору(
		Форма, Форма.Объект.ИдентификаторПечатнойФормы);
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(Форма, Форма.Объект);
КонецПроцедуры

// Устарела. Следует использовать ПервичныеДокументыБГУКлиентСервер.ПриИзмененииКлючевогоРеквизита 
// При изменении ключевого реквизита идентификатора первичного документа.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктура:
//    ** ИдентификаторПечатнойФормы - Строка
//    ** ПредставлениеПечатнойФормы - Строка
//   * Элементы - ВсеЭлементыФормы:
//    ** ИдентификаторПечатнойФормы - ПолеФормы:
//     *** СписокВыбора - СписокЗначений из Строка
Процедура ПриИзмененииКлючевогоРеквизитаИдентификатораПервичногоДокумента(Форма) Экспорт
	ОбщегоНазначенияБГУКлиентСервер.ОбновитьВидыПервичныхДокументов(Форма);
	Если ЗначениеЗаполнено(Форма.Объект.ПервичныйДокумент)
		И Форма.Элементы.ПервичныйДокумент.СписокВыбора.НайтиПоЗначению(Форма.Объект.ПервичныйДокумент) = Неопределено Тогда
		
		Форма.Объект.ПервичныйДокумент = ПредопределенноеЗначение("Справочник.ПервичныеДокументы.ПустаяСсылка");
	КонецЕсли;
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(Форма, Форма.Объект);
КонецПроцедуры

// Устарела.
// Представление печатной формы по идентификатору.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктура:
//    ** ИдентификаторПечатнойФормы - Строка
//    ** ПредставлениеПечатнойФормы - Строка
//   * ПараметрыПечатныхФорм - Структура из см. ПустаяСтрокаПараметраПечатныхФорм
//  ИдентификаторПечатнойФормы - Строка
// 
// Возвращаемое значение:
//  Строка -  Представление печатной формы по идентификатору
Функция ПредставлениеПечатнойФормыПоИдентификатору(Форма, ИдентификаторПечатнойФормы) Экспорт
	ПараметрыПечатнойФормы = Неопределено;
	Если ЗначениеЗаполнено(ИдентификаторПечатнойФормы) Тогда
		Если Форма.ПараметрыПечатныхФорм.Свойство(ИдентификаторПечатнойФормы) Тогда
			ПараметрыПечатнойФормы = Форма.ПараметрыПечатныхФорм[ИдентификаторПечатнойФормы]; // см. ОбщегоНазначенияБГУКлиентСервер.ПустаяСтрокаПараметраПечатныхФорм
		КонецЕсли;
	КонецЕсли;
	Если ПараметрыПечатнойФормы <> Неопределено Тогда
		Возврат ПараметрыПечатнойФормы.ВидПервичногоДокумента;
	КонецЕсли;
	Возврат "";
	
КонецФункции

// Устарела. Следует использовать ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента().
// Процедура определяет дату изменения учетной политики. Вызывается из форм документов, событие "ПриИзмененииДаты".
// При определении используется Объект.Дата(дата после изменения) и Форма["ДатаДокументаДляКонтроляУчетнойПолитики"].
// Реквизиты формы "ДатаДокументаДляКонтроляУчетнойПолитики" добавляется и инициализируется автоматически процедурами 
// "БухгалтерскиеОперацииСервер.ПриСозданииНаСервере" и "БухгалтерскиеОперацииСервер.ПриЧтенииНаСервере".
//
// Возвращает последнюю дату изменения учетной политики между Объект.Дата и Форма["ДатаДокументаДляКонтроляУчетнойПолитики"].
// Перед изменением даты задается вопрос, в котором пользователь может отказаться от изменения даты. При этом Объект.Дата
// устанавливается равным Форма["ДатаДокументаДляКонтроляУчетнойПолитики"].
// Если в указанном периоде дата не изменялась или пользователь отказался от изменения даты, то возвращается пустая дата.
//
// Параметры:
//	Форма - управляемая форма из которой вызывается функция
//	Объект - данные формы структура. Обычно ЭтаФорма.Объект
//
Процедура ПроверитьДатуИзмененияУчетнойПолитики(Форма, Объект) Экспорт
	
	ПриИзмененииДатыДокумента(Форма, Объект, "ДействияПриИзмененииДатыКлиент");
	
КонецПроцедуры

#КонецОбласти

// Возвращает отборы динамического списка как значения заполнения при программном вводе новой строки в список.
//
// Параметры:
//  КомпоновщикНастроек  - КомпоновщикНастроекДинамическогоСписка - компоновщик настроек списка.
//
// Возвращаемое значение:
//   Структура   - значения отборов для заполнения нового элемента списка.
//
Функция ЗначенияЗаполненияДинамическогоСписка(Знач КомпоновщикНастроек) Экспорт
	
	ЗначенияЗаполнения = Новый Структура;
	
	ДобавитьЗначенияЗаполнения(КомпоновщикНастроек.ПользовательскиеНастройки.Элементы, ЗначенияЗаполнения, Истина);
	ДобавитьЗначенияЗаполнения(КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы, ЗначенияЗаполнения);
	
	Возврат ЗначенияЗаполнения;

КонецФункции 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область МеханизмОзнакомленияСотрудников

Процедура МеханизмОзнакомленияСотрудников_ОтработатьИзменениеСотрудника(Форма, ИмяТабличнойЧасти)
	
	ИменаРеквизитов = Форма.НастройкиМеханизмаОзнакомленияСотрудников.ТабличныеЧасти[ИмяТабличнойЧасти].ИменаРеквизитов;
	
	МеханизмОзнакомленияСотрудников_УстановитьСотрудникПрежнееЗначение(Форма, ИменаРеквизитов);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИменаРеквизитов",		ИменаРеквизитов);
	ДополнительныеПараметры.Вставить("ИмяТабличнойЧасти",	ИмяТабличнойЧасти);
	
	Оповещение = Новый ОписаниеОповещения("МеханизмОзнакомленияСотрудников_СотрудникПриИзменении_Клиент", Форма, ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(Оповещение);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ПодключитьОбработчикОжидания(Форма)
	
	ИмяПроцедуры = ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_ИмяПроцедурыОбработчикОжидания();
	
	Форма.ПодключитьОбработчикОжидания(ИмяПроцедуры, 2);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_УстановитьСотрудникПрежнееЗначение(Форма, ИменаРеквизитов)
	
	Форма[ИменаРеквизитов.СотрудникПрежнееЗначение] = Форма[ИменаРеквизитов.Сотрудник];

КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_УстановитьСотрудника(Форма, Элемент, ВыбраннаяСтрока, ИмяТабличнойЧасти, ИменаРеквизитов)
	
	ТабличнаяЧасть = Форма.Объект[ИмяТабличнойЧасти];
	
	ТекДанные = ТабличнаяЧасть.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МеханизмОзнакомленияСотрудников_ИнициализироватьСписокВыбораСотрудника(Форма, ИмяТабличнойЧасти);
	
	Сотрудник = ТекДанные.Сотрудник;
	
	Форма[ИменаРеквизитов.Сотрудник] = Сотрудник;
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ИнициализироватьСписокВыбораСотрудника(Форма, ИмяТабличнойЧасти)
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	ИменаРеквизитов = НастройкиМеханизма.ТабличныеЧасти[ИмяТабличнойЧасти].ИменаРеквизитов;
	
	ЭлементСотрудника = Форма.Элементы[ИменаРеквизитов.Сотрудник];
	
	СписокВыбора = МеханизмОзнакомленияСотрудников_ПолучитьСписокВыбораСотрудников(Форма, ЭлементСотрудника);
	
	ЭлементСотрудника.СписокВыбора.ЗагрузитьЗначения(СписокВыбора);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ОчиститьДанныеМеханизмаВТекущейСтроке(Форма, Элемент, ТекДанные = Неопределено)
	
	Если ТекДанные = Неопределено Тогда
		ИмяТабличнойЧасти = МеханизмОзнакомленияСотрудников_ОпределитьИмяТабличнойЧасти(Форма, Элемент);
		
		ТекДанные = Форма.Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
		
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОчищающаяСтруктура = Новый Структура("Флажок,Дата");
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ПодтвердитьИНачатьСохранениеРезультатов(Форма, ИмяТабличнойЧасти, СобытиеСохранениеПриИзмененииСотрудника = Ложь)
	
	ДополнительныеПараметры = МеханизмОзнакомленияСотрудников_ПолучитьДопПараметрыДляСохраненияРезультатов(Форма, ИмяТабличнойЧасти, СобытиеСохранениеПриИзмененииСотрудника);
	
	Оповещение = Новый ОписаниеОповещения("МеханизмОзнакомленияСотрудников_ПодтвердитьИНачатьСохранениеРезультатовЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ТекстВопроса = МеханизмОзнакомленияСотрудников_ТекстВопросаПередСохранениемРезультата(ДополнительныеПараметры);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_НачатьСохранениеРезультатов(Форма, ИмяТабличнойЧасти, ДополнительныеПараметры = Неопределено)
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = МеханизмОзнакомленияСотрудников_ПолучитьДопПараметрыДляСохраненияРезультатов(Форма, ИмяТабличнойЧасти);
	КонецЕсли;
	
	ДополнительныеПараметры.Удалить("Форма"); // не сериализуется при передаче на сервер
	
	Оповещение = Новый ОписаниеОповещения("МеханизмОзнакомленияСотрудников_СохранитьРезультатыОзнакомления_Клиент", Форма, ДополнительныеПараметры);
	
	ВыполнитьОбработкуОповещения(Оповещение);
	
	Если Форма.НастройкиМеханизмаОзнакомленияСотрудников.СообщениеОКонфликтахДействийПриЗаписи <> Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			Форма.НастройкиМеханизмаОзнакомленияСотрудников.СообщениеОКонфликтахДействийПриЗаписи.ТекстСообщения,
			Форма.Объект.Ссылка,
			Форма.НастройкиМеханизмаОзнакомленияСотрудников.СообщениеОКонфликтахДействийПриЗаписи.ИмяРеквизитаСотрудник);
			
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_УстановитьМодифицированность(Форма, ИмяТабличнойЧасти, Ложь);
	
	МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементовТабличнойЧасти(Форма, ИмяТабличнойЧасти);
	
	ОповеститьОбИзменении(Форма.Объект.Ссылка);
	
КонецПроцедуры

Функция МеханизмОзнакомленияСотрудников_ОпределитьИмяТабличнойЧасти(Форма, Элемент) Экспорт
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	Если ТипЗнч(Элемент) = Тип("Строка") Тогда
		ИмяЭлемента = Элемент;
	Иначе
		ИмяЭлемента = Элемент.Имя;
	КонецЕсли;
	
	Если НастройкиМеханизма.ТабличныеЧасти.Свойство(ИмяЭлемента) Тогда
		Возврат ИмяЭлемента;
	КонецЕсли;
	
	Для Каждого ЭлементОписания Из НастройкиМеханизма.ТабличныеЧасти Цикл
		ИмяТабличнойЧасти		= ЭлементОписания.Ключ;
		ОписаниеТабличнойЧасти	= ЭлементОписания.Значение;
		
		Для Каждого ОписаниеРеквизита Из ОписаниеТабличнойЧасти.ИменаРеквизитов Цикл
			Если ОписаниеРеквизита.Значение = ИмяЭлемента Тогда
				Возврат ИмяТабличнойЧасти;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ОписаниеКоманды Из ОписаниеТабличнойЧасти.ИменаКоманд Цикл
			Если ОписаниеКоманды.Значение = ИмяЭлемента Тогда
				Возврат ИмяТабличнойЧасти;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ОписаниеЭлемента Из ОписаниеТабличнойЧасти.ИменаЭлементов Цикл
			Если ОписаниеЭлемента.Значение = ИмяЭлемента Тогда
				Возврат ИмяТабличнойЧасти;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция МеханизмОзнакомленияСотрудников_ПолучитьСписокВыбораСотрудников(Форма, Элемент) Экспорт
	
	СписокВыбора = Новый Массив();
	
	ИмяТабличнойЧасти = МеханизмОзнакомленияСотрудников_ОпределитьИмяТабличнойЧасти(Форма, Элемент);
	
	Таблица = Форма.Объект[ИмяТабличнойЧасти];
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Сотрудник = СтрокаТаблицы.Сотрудник;
		
		Если Не ЗначениеЗаполнено(Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СписокВыбора.Найти(Сотрудник) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбора.Добавить(Сотрудник);
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

Функция МеханизмОзнакомленияСотрудников_ПолучитьДопПараметрыДляСохраненияРезультатов(Форма, ИмяТабличнойЧасти, СобытиеСохранениеПриИзмененииСотрудника = Ложь) Экспорт
	
	ДопПараметры = Новый Структура();
	ДопПараметры.Вставить("Форма",										Форма);
	ДопПараметры.Вставить("ИмяТабличнойЧасти",							ИмяТабличнойЧасти);
	ДопПараметры.Вставить("СобытиеСохранениеПриИзмененииСотрудника",	СобытиеСохранениеПриИзмененииСотрудника);
	
	Возврат ДопПараметры;
	
КонецФункции

// Вывод сообщений

Функция МеханизмОзнакомленияСотрудников_ТекстВопросаПередСохранениемРезультата(ДополнительныеПараметры)
	
	Форма									= ДополнительныеПараметры.Форма;
	ИмяТабличнойЧасти						= ДополнительныеПараметры.ИмяТабличнойЧасти;
	СобытиеСохранениеПриИзмененииСотрудника	= ДополнительныеПараметры.СобытиеСохранениеПриИзмененииСотрудника;
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	ИменаРеквизитов = НастройкиМеханизма.ТабличныеЧасти[ИмяТабличнойЧасти].ИменаРеквизитов;
	
	Если СобытиеСохранениеПриИзмененииСотрудника Тогда
		ИмяРеквизитаСотрудник = ИменаРеквизитов.СотрудникПрежнееЗначение;
	Иначе
		ИмяРеквизитаСотрудник = ИменаРеквизитов.Сотрудник;
	КонецЕсли;
	
	Сотрудник = Форма[ИмяРеквизитаСотрудник];
	Дата = Форма[ИменаРеквизитов.Дата];
	
	ВидДействия = НастройкиМеханизма.СоответствиеВидДействия.Получить(ИмяТабличнойЧасти);
	
	ШаблоныСообщенийМеханизма = МеханизмОзнакомленияСотрудников_ШаблоныСообщенийМеханизма();
	
	Если ЗначениеЗаполнено(Дата) Тогда
		ПредставлениеДаты = Формат(Дата, "ДФ=""дд.ММ.гггг""");
		
		Если НастройкиМеханизма.ТабличныеЧасти[ИмяТабличнойЧасти].ДопустимоЕдиновременноеДействиеВсехСотрудников И Не ЗначениеЗаполнено(Сотрудник) Тогда
			ШаблонСообщения = МеханизмОзнакомленияСотрудников_ПодставитьВидДействия(ШаблоныСообщенийМеханизма.СохранениеВручную.ЕдиновременноВсеСотрудники.Сохранить, ВидДействия);
			
			ТекстВопроса = СтрШаблон(ШаблонСообщения, ПредставлениеДаты);
		Иначе
			ШаблонСообщения = МеханизмОзнакомленияСотрудников_ПодставитьВидДействия(ШаблоныСообщенийМеханизма.СохранениеВручную.ОдинСотрудник.Сохранить, ВидДействия);
			
			ТекстВопроса = СтрШаблон(ШаблонСообщения, ПредставлениеДаты, Сотрудник);
		КонецЕсли;
		
	Иначе
		Если НастройкиМеханизма.ТабличныеЧасти[ИмяТабличнойЧасти].ДопустимоЕдиновременноеДействиеВсехСотрудников И Не ЗначениеЗаполнено(Сотрудник) Тогда
			ТекстВопроса = МеханизмОзнакомленияСотрудников_ПодставитьВидДействия(ШаблоныСообщенийМеханизма.СохранениеВручную.ЕдиновременноВсеСотрудники.Удалить, ВидДействия);
		Иначе
			ШаблонСообщения = МеханизмОзнакомленияСотрудников_ПодставитьВидДействия(ШаблоныСообщенийМеханизма.СохранениеВручную.ОдинСотрудник.Удалить, ВидДействия);
			
			ТекстВопроса = СтрШаблон(ШаблонСообщения, Сотрудник);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекстВопроса;
	
КонецФункции

Функция МеханизмОзнакомленияСотрудников_ШаблоныСообщенийМеханизма()
	
	ОдинСотрудник = Новый Структура();
	ОдинСотрудник.Вставить("Сохранить",	НСтр("ru='Сохранить результаты [ВидДействия] %1 для сотрудника ""%2""?'"));
	ОдинСотрудник.Вставить("Удалить",	НСтр("ru='Удалить результаты [ВидДействия] сотрудника ""%1""?'"));
	
	ЕдиновременноВсеСотрудники = Новый Структура();
	ЕдиновременноВсеСотрудники.Вставить("Сохранить",НСтр("ru='Сохранить результаты [ВидДействия] %1 для всех указанных сотрудников?'"));
	ЕдиновременноВсеСотрудники.Вставить("Удалить",	НСтр("ru='Удалить результаты [ВидДействия] для всех указанных сотрудников?'"));
	
	СохранениеВручную = Новый Структура();
	СохранениеВручную.Вставить("ОдинСотрудник",				ОдинСотрудник);
	СохранениеВручную.Вставить("ЕдиновременноВсеСотрудники",ЕдиновременноВсеСотрудники);
	
	ЗакрытиеФормы = Новый Структура();
	ЗакрытиеФормы.Вставить("ЗавершениеРаботы",	НСтр("ru='Несохраненные результаты [ВидДействия] сотрудников будут утеряны'"));
	ЗакрытиеФормы.Вставить("Сохранить",			НСтр("ru='Результаты [ВидДействия] сотрудников были изменены, но не записаны.
		|Записать перед закрытием?'"));
	
	ШаблоныСообщенийМеханизма = Новый Структура();
	ШаблоныСообщенийМеханизма.Вставить("СохранениеВручную",			СохранениеВручную);
	ШаблоныСообщенийМеханизма.Вставить("ЗакрытиеФормы",				ЗакрытиеФормы);
	
	Возврат ШаблоныСообщенийМеханизма;
	
КонецФункции

Функция МеханизмОзнакомленияСотрудников_ПодставитьВидДействия(ТекстШаблона, ВидДействия)
	
	// Падеж вида действия является одинаковым для всех сообщений одного вида действия.
	//
	// Пример сообщения:
	// Сохранить результаты [ВидДействия] %1 для сотрудника ""%2""?
	
	Представления = Новый Соответствие();
	Представления.Вставить(ПредопределенноеЗначение("Перечисление.ВидыДействийСотрудникаСДокументом.Ознакомление"), НСтр("ru='ознакомления'"));
	Представления.Вставить(ПредопределенноеЗначение("Перечисление.ВидыДействийСотрудникаСДокументом.Согласование"), НСтр("ru='согласования'"));
	Представления.Вставить(ПредопределенноеЗначение("Перечисление.ВидыДействийСотрудникаСДокументом.ПустаяСсылка"), "");
	
	Если ТипЗнч(ВидДействия) = Тип("ПеречислениеСсылка.ВидыДействийСотрудникаСДокументом") Тогда
		МассивВидовДействий = Новый Массив();
		МассивВидовДействий.Добавить(ВидДействия);
	Иначе
		МассивВидовДействий = ВидДействия;
	КонецЕсли;
	
	ВидДействияПредставление = "";
	
	Для Каждого ВидДействия Из МассивВидовДействий Цикл
		ВидДействияПредставление = ВидДействияПредставление + ?(ВидДействияПредставление = "", "", ", ") + Представления.Получить(ВидДействия);
	КонецЦикла;
	
	Возврат СтрЗаменить(ТекстШаблона, "[ВидДействия]", ВидДействияПредставление);
	
КонецФункции

#КонецОбласти

// Запросить удаление файла члена комиссии.
// 
// Параметры:
//  Параметры - см. ОбщегоНазначенияБГУКлиентСервер.ПараметрыВыбораФайлаОсобогоМненияСотрудника
Асинх Процедура ЗапроситьУдалениеФайлаЧленаКомиссииАсинхронно(Параметры)
	ТекущиеДанные = Параметры.ТаблицаФормы.ТекущиеДанные;
	ТекстВопроса = СтрШаблон(НСтр("ru = 'У члена комиссии ""%1"" будет очищен файл особого мнения.
		|Продолжить?'"), ТекущиеДанные.Сотрудник);
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.ОК, НСтр("ru = 'Очистить файл особого мнения'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);
	Ответ = Ждать ВопросАсинх(ТекстВопроса, Кнопки, , КодВозвратаДиалога.Отмена);
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		УдалитьФайлОсобогоМненияСотрудника(Параметры, Ложь);
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьЗначенияЗаполнения(КоллекцияОтборов, ЗначенияЗаполнения, ЭлементПользовательскойНастройки = Ложь)

	Для каждого ЭлементОтбора Из КоллекцияОтборов Цикл
	
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") 
			И ЭлементОтбора.Использование 
			И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
			
			НаименованиеОтбора = ?(ЭлементПользовательскойНастройки, 
				ЭлементОтбора.ИдентификаторПользовательскойНастройки, 
				Строка(ЭлементОтбора.ЛевоеЗначение));
			Если СтрНайти(НаименованиеОтбора, ".") = 0 Тогда
				ЗначенияЗаполнения.Вставить(НаименованиеОтбора, ЭлементОтбора.ПравоеЗначение);
			КонецЕсли;
		ИначеЕсли ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") 
			И ЭлементОтбора.Использование 
			И ЭлементОтбора.ТипГруппы <> ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе Тогда
			
			ДобавитьЗначенияЗаполнения(ЭлементОтбора.Элементы, ЗначенияЗаполнения);
		ИначеЕсли ТипЗнч(ЭлементОтбора) = Тип("ОтборКомпоновкиДанных") Тогда
			
			ДобавитьЗначенияЗаполнения(ЭлементОтбора.Элементы, ЗначенияЗаполнения);
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

#КонецОбласти


 
