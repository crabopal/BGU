// Открывает для выбора справочник "Идентификаторы объектов метаданных", с установленным отбором "В иерархии".
// Вызывается из процедуры "ПриНачалеВыбораЗначения".
//
// Параметры:
//	Элемент - стандартный параметр обработчика события "ПриНачалеВыбораЗначения".
//	ДанныеВыбора - стандартный параметр обработчика события "ПриНачалеВыбораЗначения".
//	СтандартнаяОбработка - стандартный параметр обработчика события "ПриНачалеВыбораЗначения".
//	ПараметрыФормы - Неопределено или Структура - параметры формы выбора (например, ТекущаяСтрока).
//	ЗначениеОтбора - СписокЗначений, Массив, ФиксированныйМассив, ЛюбаяСсылка - правое значение устанавливаемого отбора.
//					Переданная коллекция автоматически преобразуется к списку значений.
//	ОграничиватьПоРБ - Булево - в форме выбора будут только документы, которые могут формировать проводоки.
//
// Пример:
//&НаКлиенте
//Процедура ИдентификаторДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
//	
//	ОбщегоНазначенияБГУКлиент.ОткрытьФормуВыбораИдентификатораОбъектаМетаданных(
//		Элемент, ДанныеВыбора, СтандартнаяОбработка,
//		Новый Структура("ТекущаяСтрока", ИдентификаторДокумента), 
//		ПредопределенноеЗначение("Справочник.ИдентификаторыОбъектовМетаданных.Документы"));
//	
//КонецПроцедуры
//
Процедура ОткрытьФормуВыбораИдентификатораОбъектаМетаданных(Элемент, ДанныеВыбора, СтандартнаяОбработка, ПараметрыФормы, ЗначениеОтбора, ОграничиватьПоРБ = Ложь) Экспорт

	Если ПараметрыФормы = Неопределено Тогда
		Параметры = Новый Структура;
	Иначе
		Параметры = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ПараметрыФормы);
	КонецЕсли;
	
	Если Параметры.Количество() = 0 И Не ЗначениеЗаполнено(ЗначениеОтбора) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	МассивЗначений = Новый Массив;
	Если ОграничиватьПоРБ Тогда
		
		МассивЗначений = Новый Массив(БухгалтерскийУчетВызовСервера.ВидыДокументовРегистраторовРБ());
		
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивЗначений, ЗначениеОтбора.ВыгрузитьЗначения());
	ИначеЕсли ТипЗнч(ЗначениеОтбора) = Тип("Массив") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивЗначений, ЗначениеОтбора);
	ИначеЕсли ТипЗнч(ЗначениеОтбора) = Тип("ФиксированныйМассив") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивЗначений, Новый Массив(ЗначениеОтбора));
	Иначе
		МассивЗначений.Добавить(ЗначениеОтбора);
	КонецЕсли;
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(МассивЗначений);
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	Отбор = КомпоновщикНастроек.Настройки.Отбор;
	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	Если ОграничиватьПоРБ Тогда
		ЭлементОтбора.ВидСравнения		= ВидСравненияКомпоновкиДанных.ВСписке;
	Иначе
		ЭлементОтбора.ВидСравнения		= ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии;
	КонецЕсли;
	ЭлементОтбора.ПравоеЗначение	= Список;
	
	
	Параметры.Вставить("ФиксированныеНастройки",	КомпоновщикНастроек.Настройки);
	Параметры.Вставить("РежимВыбора",				Истина);
	
	ОткрытьФорму("Справочник.ИдентификаторыОбъектовМетаданных.ФормаВыбора", Параметры, Элемент);

КонецПроцедуры

// Запрос режима записи периодических регистров при редактировании в форме ведущего объекта
// Параметры
//	Форма
//	ИмяРегистра
//	ТекстЗапроса - текст вопроса пользователю
//	ТекстКнопкиДа - текст кнопки, подтверждающей, что нужно ввести новую запись
//	ПериодВФормеРедактируется - признак того, что в форме редактируется дата редактируемой записи регистра
//
// см. также 
//	ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме
// 	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме
//
Процедура ЗапроситьРежимИзмененияРегистра(Форма, ИмяРегистра, ТекстЗапроса, ТекстКнопкиДа, ПериодВФормеРедактируется = Истина, Знач ИмяРеквизита = "", Источник = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		ИмяРеквизита = ИмяРегистра;
	КонецЕсли;
	
	// Требуется запрашивать пользователя об изменении только если еще не принято решение, что запись - новая
	Если Форма[ИмяРеквизита + "НоваяЗапись"] = Истина Тогда
		Возврат;
	КонецЕсли;

	// Требуется запрашивать пользователя об изменении только если задана дата записи
	Если НЕ ЗначениеЗаполнено(Форма[ИмяРеквизита].Период) Тогда
		Возврат;
	КонецЕсли;
	
	// Требуется запрашивать пользователя об изменении только если была считана прежняя запись
	Если НЕ ЗначениеЗаполнено(Форма[ИмяРеквизита + "Прежняя"].Период) Тогда
		Возврат;
	КонецЕсли;
	
	ИзменилсяПериод = (Форма[ИмяРеквизита].Период <> Форма[ИмяРеквизита + "Прежняя"].Период);
	
	ИзменилисьДанные = Ложь;
	Для Каждого Поле Из Форма[ИмяРеквизита + "Прежняя"] Цикл
		Если Поле.Ключ = "Период" Тогда
			Продолжить;
		КонецЕсли;
		ИзменилисьДанные = Форма[ИмяРеквизита][Поле.Ключ] <> Поле.Значение;
		Если ИзменилисьДанные Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Требуется запрашивать пользователя об изменении - изменили и текущие данные, и дату записи
	Если ИзменилисьДанные И (ПериодВФормеРедактируется И ИзменилсяПериод ИЛИ НЕ ПериодВФормеРедактируется) Тогда
		
		Кнопки = Новый СписокЗначений();
		Кнопки.Добавить(КодВозвратаДиалога.Нет,  	НСтр("ru = 'Исправлена ошибка'"));
		Кнопки.Добавить(КодВозвратаДиалога.Да, 		ТекстКнопкиДа);
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, 	НСтр("ru = 'Отмена'"));
		ОтветНаВопрос = Неопределено;

		ПоказатьВопрос(Новый ОписаниеОповещения("ЗапроситьРежимИзмененияРегистраЗавершение", ЭтотОбъект, Новый Структура("ИмяРегистра, ИмяРеквизита, Форма, Источник", ИмяРегистра, ИмяРеквизита, Форма, Источник)), ТекстЗапроса, Кнопки, , КодВозвратаДиалога.Отмена);
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗапроситьРежимИзмененияРегистраЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ИмяРегистра 	= ДополнительныеПараметры.ИмяРегистра;
	ИмяРеквизита 	= ДополнительныеПараметры.ИмяРеквизита;
	Форма 			= ДополнительныеПараметры.Форма;
	Источник		= ДополнительныеПараметры.Источник;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Форма[ИмяРеквизита + "НоваяЗапись"] = Истина;
	КонецЕсли;
	
	Оповестить("ОбщегоНазначенияБГУКлиент_РезультатОтветаНаЗапросИзмененияРегистра" + ИмяРегистра, РезультатВопроса, Источник);

КонецПроцедуры

// Установка режима записи периодических регистров при редактировании в форме ведущего объекта
//
// Если в форме ведущего объекта изменился период и текущие данные - устанавливается признак 
// необходимости создания новой записи.
// В других случаях перезаписывается текущая запись
//
// Параметры
//	Форма
//	ИмяРегистра
//
// см. также 
//	ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме
// 	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме
//
Процедура УстановитьРежимИзмененияРегистра(Форма, ИмяРегистра, Знач ИмяРеквизита = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		ИмяРеквизита = ИмяРегистра;
	КонецЕсли;
	
	// Требуется установка режима записи только если еще не принято решение, что запись - новая
	Если Форма[ИмяРеквизита + "НоваяЗапись"] = Истина Тогда
		Возврат;
	КонецЕсли;

	// Требуется установка режима записи только если задана дата записи
	Если НЕ ЗначениеЗаполнено(Форма[ИмяРеквизита].Период) Тогда
		Возврат;
	КонецЕсли;
	
	// Требуется установка режима записи только если была считана прежняя запись
	Если НЕ ЗначениеЗаполнено(Форма[ИмяРеквизита + "Прежняя"].Период) Тогда
		Возврат;
	КонецЕсли;
	
	ИзменилсяПериод = (Форма[ИмяРеквизита].Период <> Форма[ИмяРеквизита + "Прежняя"].Период);
	
	ИзменилисьДанные = Ложь;
	Для Каждого Поле Из Форма[ИмяРеквизита + "Прежняя"] Цикл
		Если Поле.Ключ = "Период" Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Поле.Значение) = Тип("ХранилищеЗначения") Тогда
			ИзменилисьДанные = Истина;
			Прервать;
		КонецЕсли;
		ИзменилисьДанные = Форма[ИмяРеквизита][Поле.Ключ] <> Поле.Значение;
		Если ИзменилисьДанные Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ИзменилисьДанные И ИзменилсяПериод Тогда
		Форма[ИмяРеквизита + "НоваяЗапись"] = Истина;
	КонецЕсли;
		
КонецПроцедуры

Функция СтандартныйТекстПредупрежденияПриЗавершенииРаботы() Экспорт
	
