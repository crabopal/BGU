Процедура ДобавитьСтрокиВДеревоРекурсивно(Источник, Приемник)
	
	Для Каждого СтрокаИстоника из Источник.Строки Цикл 
		
		НоваяСтрока = Приемник.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИстоника, ,"Родитель,Строки");
		
		ДобавитьСтрокиВДеревоРекурсивно(СтрокаИстоника, НоваяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры	

функция ПолучитьДанныеОтчетов(МассивСсылок) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОтчетов", МассивСсылок);
	Запрос.УстановитьПараметр("ВыгружаемыеВФНС",ИнтеграцияОтчетностиГУИФормы1СОтчетностьПовтИсп.ВидыОтчетовВыгружаемыхФНС());
	Запрос.УстановитьПараметр("ТаблицаСостояний",ПолучитьСостоянияОтчетов(МассивСсылок));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.Отчет,
	|	Таблица.Статус,
	|	Таблица.СостояниеСдачиОтчетности,
	|	Таблица.ЕстьКритическиеОшибкиОтправки
	|ПОМЕСТИТЬ ТаблицаСостояний
	|ИЗ
	|	&ТаблицаСостояний КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УниверсальныйРегламентированныйОтчет.Организация КАК Организация,
	|	УниверсальныйРегламентированныйОтчет.Ссылка КАК Ссылка,
	|	УниверсальныйРегламентированныйОтчет.Дата КАК ДатаСоздания,
	|	ТаблицаСостояний.Статус КАК Статус,
	|	УниверсальныйРегламентированныйОтчет.ВидОтчета.Наименование КАК НаименованиеОтчета,
	|	ВЫБОР
	|		КОГДА УниверсальныйРегламентированныйОтчет.ВидОтчета В (&ВыгружаемыеВФНС)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФНС)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ПустаяСсылка)
	|	КОНЕЦ КАК ВидКонтролирующегоОргана,
	|	ВЫБОР
	|		КОГДА УниверсальныйРегламентированныйОтчет.ВидОтчета В (&ВыгружаемыеВФНС)
	|			ТОГДА УниверсальныйРегламентированныйОтчет.Организация.КодНалоговогоОргана
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодКонтролирующегоОргана,
	|	""-"" КАК ВариантОтчета,
	|	УниверсальныйРегламентированныйОтчет.ПериодОтчета.ДатаНачала КАК ДатаНачала,
	|	УниверсальныйРегламентированныйОтчет.ПериодОтчета.ДатаОкончания КАК ДатаОкончания,
	|	УниверсальныйРегламентированныйОтчет.ПериодОтчета.Наименование КАК ФинансовыйПериод,
	|	УниверсальныйРегламентированныйОтчет.ПометкаУдаления КАК ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА УниверсальныйРегламентированныйОтчет.ПометкаУдаления И ЕСТЬNULL(НаличиеФайлов.ЕстьФайлы, ЛОЖЬ) = ЛОЖЬ
	|			ТОГДА 0
	|		КОГДА УниверсальныйРегламентированныйОтчет.ПометкаУдаления И ЕСТЬNULL(НаличиеФайлов.ЕстьФайлы, ЛОЖЬ) = ИСТИНА
	|			ТОГДА 1
	|		КОГДА УниверсальныйРегламентированныйОтчет.ПометкаУдаления = ЛОЖЬ И ЕСТЬNULL(НаличиеФайлов.ЕстьФайлы, ЛОЖЬ) = ЛОЖЬ
	|			ТОГДА 2
	|		КОГДА УниверсальныйРегламентированныйОтчет.ПометкаУдаления = ЛОЖЬ И ЕСТЬNULL(НаличиеФайлов.ЕстьФайлы, ЛОЖЬ) = ИСТИНА
	|			ТОГДА 3
	|	КОНЕЦ КАК ИндексКартинки,
	|	ТаблицаСостояний.СостояниеСдачиОтчетности КАК СостояниеСдачиОтчетности,
	|	ВЫБОР
	|		КОГДА УниверсальныйРегламентированныйОтчет.ВидОтчета В (&ВыгружаемыеВФНС)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК НеОтправляетсяВКонтролирующийОрган,
	|	ВЫБОР
	|		КОГДА УниверсальныйРегламентированныйОтчет.ВидОтчета В (&ВыгружаемыеВФНС)
	|			ТОГДА ""ФНС "" + УниверсальныйРегламентированныйОтчет.Организация.КодНалоговогоОргана
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПредставлениеКонтролирующегоОргана,
	|	УниверсальныйРегламентированныйОтчет.Комментарий КАК Комментарий,
	|	ТаблицаСостояний.ЕстьКритическиеОшибкиОтправки КАК ЕстьКритическиеОшибкиОтправки
	|ИЗ
	|	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСостояний КАК ТаблицаСостояний
	|		ПО УниверсальныйРегламентированныйОтчет.Ссылка = ТаблицаСостояний.Отчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
    |		ПО УниверсальныйРегламентированныйОтчет.Ссылка = НаличиеФайлов.ОбъектСФайлами
	|ГДЕ
	|	УниверсальныйРегламентированныйОтчет.Ссылка В(&МассивОтчетов)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

функция ПолучитьСостоянияОтчетов(МассивСсылок)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок",МассивСсылок);
	Запрос.УстановитьПараметр("ВыгружаемыеВФНС",ИнтеграцияОтчетностиГУИФормы1СОтчетностьПовтИсп.ВидыОтчетовВыгружаемыхФНС());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УниверсальныйРегламентированныйОтчет.Ссылка КАК Отчет,
	|	ЕСТЬNULL(ВложенныйЗапрос.ЭлДокумент, ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументБухгалтерскийОтчет.ПустаяСсылка)) КАК ЭлДокумент,
	|	ВЫБОР
	|		КОГДА УниверсальныйРегламентированныйОтчет.ВидОтчета В (&ВыгружаемыеВФНС)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Выгружается
	|ИЗ
	|	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов.Отчет КАК Отчет,
	|			МАКСИМУМ(ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов.Ссылка) КАК ЭлДокумент
	|		ИЗ
	|			(ВЫБРАТЬ
	|				ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов.Отчет КАК Отчет,
	|				МАКСИМУМ(ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов.Ссылка.Дата) КАК Дата
	|			ИЗ
	|				Документ.ЭлектронныйДокументБухгалтерскийОтчет.ЭкземплярыОтчетов КАК ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов
	|			ГДЕ
	|				ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов.Отчет В(&МассивСсылок)
	|				И ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов.Ссылка.ПометкаУдаления = ЛОЖЬ
	|			
	|			СГРУППИРОВАТЬ ПО
	|				ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов.Отчет) КАК ВложенныйЗапрос
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭлектронныйДокументБухгалтерскийОтчет.ЭкземплярыОтчетов КАК ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов
	|				ПО ВложенныйЗапрос.Отчет = ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов.Отчет
	|					И ВложенныйЗапрос.Дата = ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов.Ссылка.Дата
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов.Отчет) КАК ВложенныйЗапрос
	|		ПО (ВложенныйЗапрос.Отчет = УниверсальныйРегламентированныйОтчет.Ссылка)
	|ГДЕ
	|	УниверсальныйРегламентированныйОтчет.Ссылка В(&МассивСсылок)";
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	ТаблицаРезультат.Колонки.Добавить("ЕстьКритическиеОшибкиОтправки",Новый ОписаниеТипов("Булево"));
	ТаблицаРезультат.Колонки.Добавить("СостояниеСдачиОтчетности", Новый ОписаниеТипов("ПеречислениеСсылка.СостояниеСдачиОтчетности"));
	ТаблицаРезультат.Колонки.Добавить("Статус",Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная)));
	
	Для Каждого СтрокаРезультата из ТаблицаРезультат Цикл 
		
		Если не СтрокаРезультата.Выгружается или не ЗначениеЗаполнено(СтрокаРезультата.ЭлДокумент) Тогда 
			
			СтрокаРезультата.ЕстьКритическиеОшибкиОтправки = Ложь;
			СтрокаРезультата.СостояниеСдачиОтчетности = Перечисления.СостояниеСдачиОтчетности.ДокументооборотНеНачат;
			СтрокаРезультата.Статус = НСтр("ru = 'Не отправлено'");
			
		Иначе 
			
			ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОпределитьСтатусИСостояниеСдачиОтчетности(СтрокаРезультата.ЭлДокумент,, "ФНС", СтрокаРезультата.СостояниеСдачиОтчетности, СтрокаРезультата.Статус);		
			СтрокаРезультата.ЕстьКритическиеОшибкиОтправки = ЭлектронныйДокументооборотСКонтролирующимиОрганами.ЕстьКритическиеСообщения(СтрокаРезультата.ЭлДокумент);
			
		КонецЕсли;	
		
		
	КонецЦикла;
	Возврат ТаблицаРезультат;
	
КонецФункции	

Функция ПолучитьДанныеЭлДокументов(МассивСсылок)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭлектронныйДокументБухгалтерскийОтчет.НомерКорректировки как НомерКорректировки,
	|	ЭлектронныйДокументБухгалтерскийОтчет.ОтчетныйПериод.ДатаНачала КАК ДатаНачала,
	|	ЭлектронныйДокументБухгалтерскийОтчет.ОтчетныйПериод.ДатаОкончания КАК ДатаОкончания,
	|	ЭлектронныйДокументБухгалтерскийОтчет.Дата КАК ДатаСоздания,
	|	ЭлектронныйДокументБухгалтерскийОтчет.Организация.КодНалоговогоОргана КАК КодКонтролирующегоОргана,
	|	"""" КАК Комментарий,
	|	ЭлектронныйДокументБухгалтерскийОтчет.ЭкземплярыОтчетов.(
	|		Отчет
	|	),
	|	ЭлектронныйДокументБухгалтерскийОтчет.Организация,
	|	ЭлектронныйДокументБухгалтерскийОтчет.ПометкаУдаления,
	|	ЭлектронныйДокументБухгалтерскийОтчет.Ссылка
	|ИЗ
	|	Документ.ЭлектронныйДокументБухгалтерскийОтчет КАК ЭлектронныйДокументБухгалтерскийОтчет
	|ГДЕ
	|	ЭлектронныйДокументБухгалтерскийОтчет.Ссылка В(&МассивСсылок)";
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	ТаблицаРезультата.Колонки.Добавить("Наименование",Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	ТаблицаРезультата.Колонки.Добавить("ВариантОтчета",Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(10, ДопустимаяДлина.Переменная)));

	
	Для Каждого СтрокаТаблицы из ТаблицаРезультата Цикл 
		
		Если СтрокаТаблицы.НомерКорректировки = 0 Тогда 
			СтрокаТаблицы.ВариантОтчета = "П";
		Иначе 
			СтрокаТаблицы.ВариантОтчета = "К/"+СтрокаТаблицы.НомерКорректировки;
		КонецЕсли;
		
		Для Каждого СтрокаЭкземпляра из СтрокаТаблицы.ЭкземплярыОтчетов Цикл
			СтрокаТаблицы.Наименование = СтрокаТаблицы.Наименование + СтрокаЭкземпляра.Отчет.ВидОтчета.Наименование + ","
		КонецЦикла;	
		СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(СтрокаТаблицы.Наименование);
		      
	КонецЦикла;	
	
	Возврат ТаблицаРезультата;
КонецФункции	

Функция ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты) Экспорт 
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты);
	
КонецФункции	

функция ПолучитьСоставЭлДокумента(Ссылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов.Отчет как Отчет
	|ИЗ
	|	Документ.ЭлектронныйДокументБухгалтерскийОтчет.ЭкземплярыОтчетов КАК ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов
	|ГДЕ
	|	ЭлектронныйДокументБухгалтерскийОтчетЭкземплярыОтчетов.Ссылка = &Ссылка";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Отчет");
	
КонецФункции	