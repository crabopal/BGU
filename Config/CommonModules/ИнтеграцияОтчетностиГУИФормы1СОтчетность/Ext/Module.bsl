Процедура ПереопределитьПараметрыОтчета(Отчет, ОрганизацияОтчета, ДатаНачалаПериодаОтчета, ДатаОкончанияПериодаОтчета, ПараметрыОткрытия) Экспорт
	
	Если Отчет.ПолноеИмя = "Документ.УниверсальныйРегламентированныйОтчет" Тогда
		
		// Получаем отчетный период по дате начала и окончания.
		ПериодОтчета = ПолучитьПериодПоДатеНачалаОкончания(ДатаНачалаПериодаОтчета, ДатаОкончанияПериодаОтчета);
		
		ПараметрыОткрытия.Очистить();
		ПараметрыОткрытия.Вставить("ЗначенияЗаполнения", Новый Структура);
		
		ПараметрыОткрытия.ЗначенияЗаполнения.Вставить("ВидОтчета", Отчет.Ссылка);
		ПараметрыОткрытия.ЗначенияЗаполнения.Вставить("ПериодОтчета", ПериодОтчета);
		Если ЗначениеЗаполнено(ОрганизацияОтчета) Тогда
			ПараметрыОткрытия.ЗначенияЗаполнения.Вставить("Организация" , ОрганизацияОтчета);
		КонецЕсли;
		
	КонецЕсли;

	
КонецПроцедуры

Функция ПолучитьПериодПоДатеНачалаОкончания(ДатаНачалаПериодаОтчета, ДатаОкончанияПериодаОтчета) Экспорт
	
	ПериодОтчета = ПредопределенноеЗначение("Справочник.Периоды.ПустаяСсылка");
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Периоды.Ссылка
		|ИЗ
		|	Справочник.Периоды КАК Периоды
		|ГДЕ
		|	Периоды.ДатаНачала = НачалоПериода(&ДатаНачала,ДЕНЬ)
		|	И Периоды.ДатаОкончания = НачалоПериода(&ДатаОкончания,ДЕНЬ)";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаПериодаОтчета);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияПериодаОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ПериодОтчета = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат ПериодОтчета;
	
КонецФункции

Процедура ОткрытиеОтчетаВExcel(ОтчетСсылка,АдресФайлаExcel) Экспорт
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("ОтчетСсылка", ОтчетСсылка);
	
	Документы.УниверсальныйРегламентированныйОтчет.СформироватьФайлДляExcelПакетомОтчетов(СтруктураПараметров, АдресФайлаExcel);	
	
	
КонецПроцедуры

Функция ПолучитьАрхивОтчетов(МассивОтчетов,УникальныйИдентификатор) Экспорт
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("МассивОтчетов", МассивОтчетов);
	
	НаименованиеФоновогоЗадания = НСтр("ru = 'Сохранение регламентированных отчетов в Excel'");
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеФоновогоЗадания;
	
	Результат = ДлительныеОперации.ВыполнитьВФоне("Документы.УниверсальныйРегламентированныйОтчет.СформироватьФайлыДляExcelВАрхиве",
		СтруктураПараметров, 	
	    ПараметрыВыполнения);
	
	Возврат Результат;
		
КонецФункции

