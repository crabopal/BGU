// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура ЗаписатьДанныеОтчетовВЖурнал(МассивСсылок, Отказ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	ДанныеДляЗаписи = ПолучитьДанныеОтчетов(МассивСсылок);
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЖурналОтправокВКонтролирующиеОрганы");
	ЭлементБлокировки.ИсточникДанных = ДанныеДляЗаписи;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка","Ссылка");
	Блокировка.Заблокировать();

 	Для Каждого СтрокаДляЗаписи из ДанныеДляЗаписи Цикл 
		
	НаборЗаписей = РегистрыСведений.ЖурналОтчетовСтатусы.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ссылка.Установить(СтрокаДляЗаписи.Ссылка);
	ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), СтрокаДляЗаписи);
	НаборЗаписей.Записать(Истина);
	
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Процедура ДобавитьВДеревоРегламентированныхОтчетовДругиеОтчеты(ДеревоОтчетов) Экспорт 
	
	ИмяРодительскойгруппы =  НСтр("ru = 'Отчетность государственных учреждений'");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВыгружаемыеВФНС",ИнтеграцияОтчетностиГУИФормы1СОтчетностьПовтИсп.ВидыОтчетовВыгружаемыхФНС());
	Запрос.УстановитьПараметр("ИмяРодительскойгруппы",ИмяРодительскойгруппы);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыОтчетов.Наименование КАК Наименование,
	|	ВЫБОР
	|		КОГДА ВидыОтчетов.ЭтоГруппа
	|			ТОГДА """"
	|		ИНАЧЕ ""Документ.УниверсальныйРегламентированныйОтчет""
	|	КОНЕЦ КАК ПолноеИмя,
	|	ВидыОтчетов.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ВидыОтчетов.Ссылка В (&ВыгружаемыеВФНС)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ФНС)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыКонтролирующихОрганов.ПустаяСсылка)
	|	КОНЕЦ КАК ТипПолучателя,
	|	ВЫБОР
	|		КОГДА ВидыОтчетов.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыОтчетов.ПустаяСсылка)
	|			ТОГДА &ИмяРодительскойгруппы
	|		ИНАЧЕ ВидыОтчетов.Родитель.Наименование
	|	КОНЕЦ КАК Категория,
	|	ВидыОтчетов.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.ВидыОтчетов КАК ВидыОтчетов
	|ГДЕ
	|	ВидыОтчетов.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка ИЕРАРХИЯ";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат;
	КонецЕсли;
	НоваяСтрока = ДеревоОтчетов.Строки.Добавить();
	НоваяСтрока.ЭтоГруппа = Истина;
	НоваяСтрока.Наименование = ИмяРодительскойгруппы;
	
	ДеревоДляДобавления = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ДобавитьСтрокиВДеревоРекурсивно(ДеревоДляДобавления, НоваяСтрока);
КонецПроцедуры

Процедура ОпределитьТаблицуОписанияОбъектовРегламентированнойОтчетности(ТаблицаОписания) Экспорт 
	
	НоваяСтрока = ТаблицаОписания.Добавить();
	НоваяСтрока.Наименование = НСтр("ru = 'Регламентированный бухгалтерский отчет'");
	НоваяСтрока.ТипОбъекта = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет");	
	НоваяСтрока.ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ПустаяСсылка();
	НоваяСтрока.ГруппаВДереве = "";	
	НоваяСтрока.ВидДокумента = Перечисления.СтраницыЖурналаОтчетность.Отчеты;
	НоваяСтрока.НеОтправляетсяВКонтролирующийОрган = Ложь;
	НоваяСтрока.ЯвляетсяАктуальным = Истина;
	НоваяСтрока.ИмяОсновногоМакетаДляПечати = "";
	НоваяСтрока.ВидЭлектронногоПредставления = Справочники.ВидыОтправляемыхДокументов.ПустаяСсылка();
	
	НоваяСтрока = ТаблицаОписания.Добавить();
	НоваяСтрока.Наименование = НСтр("ru = 'Бухгалтерский отчет (электронный документ)'");
	НоваяСтрока.ТипОбъекта = Тип("ДокументСсылка.ЭлектронныйДокументБухгалтерскийОтчет");	
	НоваяСтрока.ВидКонтролирующегоОргана = Перечисления.ТипыКонтролирующихОрганов.ФНС;
	НоваяСтрока.ГруппаВДереве = "";	
	НоваяСтрока.ВидДокумента = Перечисления.СтраницыЖурналаОтчетность.Отчеты;
	НоваяСтрока.НеОтправляетсяВКонтролирующийОрган = Ложь;
	НоваяСтрока.ЯвляетсяАктуальным = Истина;
	НоваяСтрока.ИмяОсновногоМакетаДляПечати = "";
	НоваяСтрока.ВидЭлектронногоПредставления = Справочники.ВидыОтправляемыхДокументов.ПустаяСсылка();

	
КонецПроцедуры	

Процедура ОпределитьСвойстваОбъектовДляОтображенииВФормеОтчетность(СвойстваОбъектов) Экспорт 
	
	МассивСсылок = СвойстваОбъектов.ВыгрузитьКолонку("Ссылка");
	
	ДанныеОтчетов = ПолучитьДанныеОтчетов(МассивСсылок);
	ДанныеЭлДокументов = ПолучитьДанныеЭлДокументов(МассивСсылок);
	
	Для Каждого СтрокаДляЗаполнения из СвойстваОбъектов Цикл
		
		Если ТипЗнч(СтрокаДляЗаполнения.Ссылка) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") Тогда 
			
			НайденныеСтроки = ДанныеОтчетов.НайтиСтроки(Новый Структура("Ссылка",СтрокаДляЗаполнения.Ссылка));
			Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда 
				Продолжить;
			КонецЕсли;
			СтрокаДанных = НайденныеСтроки[0];
			
			ЗаполнитьЗначенияСвойств(СтрокаДляЗаполнения, СтрокаДанных); 
			СтрокаДляЗаполнения.Наименование = СтрокаДанных.НаименованиеОтчета;
			
		КонецЕсли;
		
		Если ТипЗнч(СтрокаДляЗаполнения.Ссылка) = Тип("ДокументСсылка.ЭлектронныйДокументБухгалтерскийОтчет") Тогда 
			
			НайденныеСтроки = ДанныеЭлДокументов.НайтиСтроки(Новый Структура("Ссылка",СтрокаДляЗаполнения.Ссылка));
			Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда 
				Продолжить;
			КонецЕсли;
			СтрокаДанных = НайденныеСтроки[0];
			ЗаполнитьЗначенияСвойств(СтрокаДляЗаполнения,СтрокаДанных);
			
		КонецЕсли;	
			
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ЗаписьОбъектовРегламентированнойОтчетности(Ссылка, Отказ, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЭлектронныйДокументБухгалтерскийОтчет") Тогда 
		СтандартнаяОбработка = Ложь;
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") Тогда 
		СтандартнаяОбработка = Ложь;
		ЗаписатьДанныеОтчетовВЖурнал(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка), Отказ);
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура УстановитьСтатусОтчетов(Ссылка, СтатусОтправки) Экспорт 
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ЭлектронныйДокументБухгалтерскийОтчет") Тогда 
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивСсылок = ПолучитьСоставЭлДокумента(Ссылка); 
	
	ЗаписатьДанныеОтчетовВЖурнал(МассивСсылок,Ложь);
		
КонецПроцедуры	

Процедура ФормаРегламентированнойОтчетности_ПриСозданииНаСервере(Форма) Экспорт
	
	ЭлементыФормы = Форма.Элементы;
	
	ЭлементыФормы.ОтборВидОтчета.РежимВыбораИзСписка = Ложь;
	ЭлементыФормы.ОтборВидОтчета.Ширина = 40;
	
	// Отключаем сервисы ИП
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, "ГруппаФНСИПСервис", "Видимость", Ложь);
	
	
	// Добавление колонок таблицы отчетов.
	
	// Вывод аналитики отчета
	Форма.Отчеты.ТекстЗапроса = СтрЗаменить(Форма.Отчеты.ТекстЗапроса, "РегистрСведенийЖурналОтчетовСтатусы.Ссылка КАК РегламентированныйОтчет,"
                              , "РегистрСведенийЖурналОтчетовСтатусы.Ссылка КАК РегламентированныйОтчет,
                                |ВЫБОР
                                | КОГДА РегистрСведенийЖурналОтчетовСтатусы.Ссылка ССЫЛКА Документ.УниверсальныйРегламентированныйОтчет
                                |	ТОГДА ВЫРАЗИТЬ(РегистрСведенийЖурналОтчетовСтатусы.Ссылка КАК Документ.УниверсальныйРегламентированныйОтчет).ОписаниеАналитики
                                |	ИНАЧЕ """"
                                |КОНЕЦ КАК ОписаниеАналитики,
								|ВЫБОР
                                | КОГДА РегистрСведенийЖурналОтчетовСтатусы.Ссылка ССЫЛКА Документ.УниверсальныйРегламентированныйОтчет
                                |	ТОГДА ВЫРАЗИТЬ(РегистрСведенийЖурналОтчетовСтатусы.Ссылка КАК Документ.УниверсальныйРегламентированныйОтчет).ИФО
                                |	ИНАЧЕ """"
                                |КОНЕЦ КАК ИФО,
								|ВЫБОР
                                | КОГДА РегистрСведенийЖурналОтчетовСтатусы.Ссылка ССЫЛКА Документ.УниверсальныйРегламентированныйОтчет
                                |	ТОГДА ВЫРАЗИТЬ(РегистрСведенийЖурналОтчетовСтатусы.Ссылка КАК Документ.УниверсальныйРегламентированныйОтчет).Номер
                                |	ИНАЧЕ """"
                                |КОНЕЦ КАК НомерОтчета,
								|ВЫБОР
                                | КОГДА РегистрСведенийЖурналОтчетовСтатусы.Ссылка ССЫЛКА Документ.УниверсальныйРегламентированныйОтчет
                                |	ТОГДА ВЫРАЗИТЬ(РегистрСведенийЖурналОтчетовСтатусы.Ссылка КАК Документ.УниверсальныйРегламентированныйОтчет).Дата
                                |	ИНАЧЕ """"
                                |КОНЕЦ КАК ДатаОтчета,
								|ВЫБОР
                                | КОГДА РегистрСведенийЖурналОтчетовСтатусы.Ссылка ССЫЛКА Документ.УниверсальныйРегламентированныйОтчет
                                |	ТОГДА ВЫРАЗИТЬ(РегистрСведенийЖурналОтчетовСтатусы.Ссылка КАК Документ.УниверсальныйРегламентированныйОтчет).Состояние.Порядок
								|	ИНАЧЕ -1
                                |КОНЕЦ КАК ИндексКартинкиСостояния,
								|ВЫБОР
								|	КОГДА РегистрСведенийЖурналОтчетовСтатусы.Ссылка ССЫЛКА Документ.УниверсальныйРегламентированныйОтчет
								|		ТОГДА ВЫРАЗИТЬ(РегистрСведенийЖурналОтчетовСтатусы.Ссылка КАК Документ.УниверсальныйРегламентированныйОтчет).ДатаЗаполнения <> ДАТАВРЕМЯ(1, 1, 1)
								|	ИНАЧЕ ЛОЖЬ
								|КОНЕЦ КАК ЕстьДанныеЗаполнения,");
	
	ГруппаНаименованиеАналитика = ЭлементыФормы.Добавить("ГруппаНаименованиеАналитика", Тип("ГруппаФормы"), ЭлементыФормы["Отчеты"]);
	ГруппаНаименованиеАналитика.Группировка = ГруппировкаКолонок.Вертикальная;
	ГруппаНаименованиеАналитика.Ширина = 18;
	
	ГруппаНаименованиеКартинка = ЭлементыФормы.Добавить("ГруппаНаименованиеКартинка", Тип("ГруппаФормы"), ГруппаНаименованиеАналитика);
	ГруппаНаименованиеКартинка.Группировка = ГруппировкаКолонок.ВЯчейке;
	ГруппаНаименованиеКартинка.ОтображатьЗаголовок = Ложь;
	ГруппаНаименованиеКартинка.Ширина = 18;
	ЭлементыФормы.Переместить(ЭлементыФормы["ОтчетыНаименование"],ГруппаНаименованиеКартинка);
	
	КолонкаСостояниеКартинка = Форма.Элементы.Добавить("СостояниеКартинка", Тип("ПолеФормы"), ГруппаНаименованиеКартинка);
	КолонкаСостояниеКартинка.Вид = ВидПоляФормы.ПолеКартинки;
	КолонкаСостояниеКартинка.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	КолонкаСостояниеКартинка.КартинкаЗначений = БиблиотекаКартинок.СостоянияОтчетов;
	КолонкаСостояниеКартинка.ПутьКДанным = "Отчеты.ИндексКартинкиСостояния";
	
	ГруппаНаименованиеАналитикаИФО = ЭлементыФормы.Добавить("ГруппаНаименованиеАналитикаИФО", Тип("ГруппаФормы"), ГруппаНаименованиеАналитика);
	ГруппаНаименованиеАналитикаИФО.Группировка = ГруппировкаКолонок.Горизонтальная;
	ГруппаНаименованиеАналитикаИФО.ОтображатьЗаголовок = Ложь;
	ГруппаНаименованиеАналитикаИФО.Ширина = 5;
	
	ГруппаНаименованиеАналитикаКартинка = ЭлементыФормы.Добавить("ГруппаНаименованиеАналитикаКартинка", Тип("ГруппаФормы"), ГруппаНаименованиеАналитикаИФО);
	ГруппаНаименованиеАналитикаКартинка.Группировка = ГруппировкаКолонок.ВЯчейке;
	ГруппаНаименованиеАналитикаКартинка.ОтображатьЗаголовок = Ложь;
	ГруппаНаименованиеАналитикаКартинка.Ширина = 13;
	
	КолонкаЕстьДанныеЗаполненияКартинка = Форма.Элементы.Добавить("ЕстьДанныеЗаполнения", Тип("ПолеФормы"), ГруппаНаименованиеАналитикаКартинка);
	КолонкаЕстьДанныеЗаполненияКартинка.Вид = ВидПоляФормы.ПолеКартинки;
	КолонкаЕстьДанныеЗаполненияКартинка.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	КолонкаЕстьДанныеЗаполненияКартинка.КартинкаЗначений = БиблиотекаКартинок.Заполнение;
	КолонкаЕстьДанныеЗаполненияКартинка.ПутьКДанным = "Отчеты.ЕстьДанныеЗаполнения";
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Если ИспользоватьУчетПоИФО Тогда
		КолонкаИФО = Форма.Элементы.Добавить("ИФО", Тип("ПолеФормы"), ГруппаНаименованиеАналитикаИФО);
		КолонкаИФО.ПутьКДанным = "Отчеты.ИФО";
		КолонкаИФО.Заголовок = НСтр("ru = 'ИФО'");
	КонецЕсли;
	
	КолонкаАналитика = Форма.Элементы.Добавить("ОписаниеАналитики", Тип("ПолеФормы"), ГруппаНаименованиеАналитикаКартинка);
	КолонкаАналитика.ПутьКДанным = "Отчеты.ОписаниеАналитики";
	КолонкаАналитика.Заголовок = НСтр("ru = 'Аналитика'");
		
	ЭлементыФормы.Переместить(ГруппаНаименованиеАналитика,ЭлементыФормы["Отчеты"],ЭлементыФормы["ПериодВидОрганизация"]);
	
	// Компоновка номера/даты отчета и комментария
	ГруппаКомментарийНомер = ЭлементыФормы.Добавить("ГруппаКомментарийНомер", Тип("ГруппаФормы"),  ЭлементыФормы["Отчеты"]);
	ГруппаКомментарийНомер.Группировка = ГруппировкаКолонок.Вертикальная;
	ГруппаКомментарийНомер.ОтображатьЗаголовок = Ложь;
		
	// Компоновка номера отчета и даты
	ГруппаКомментарийНомерДата = ЭлементыФормы.Добавить("ГруппаКомментарийНомерДата", Тип("ГруппаФормы"),  ГруппаКомментарийНомер);
