	ИмяПараметра = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
	Массив.Добавить("&" + ИмяПараметра);
	Если ОбщиеПараметры.ИспользуемыеПараметры.Найти(ИмяПараметра) = Неопределено Тогда
		ОбщиеПараметры.ИспользуемыеПараметры.Добавить(ИмяПараметра);
