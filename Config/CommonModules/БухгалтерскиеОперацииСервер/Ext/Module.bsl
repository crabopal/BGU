	КонецЦикла;
	Если Не ЕстьОкончаниеСтроки Тогда
		РазборФормулыОбработатьОшибкуРазбора(ОбщиеПараметры, НСтр("ru = 'Ожидается символ "" (двойная кавычка)'"));
	КонецЕсли;
	ПредыдущийИдентификатор = Истина;
	Токен = Токен + " " + ТекстТокена;
	ТокенБезМакроса = ТокенБезМакроса + " " + ТекстТокена;

КонецПроцедуры

Процедура РазборФормулыПрочитатьОператорВыбора(Идентификатор, Токен,
		ТокенБезМакроса, ОбщиеПараметры)

	Токен = Токен + Идентификатор;
	ТокенБезМакроса = ТокенБезМакроса + Идентификатор;

	Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
	ПроверитьОжидаемыйТокен(ОбщиеПараметры, Идентификатор, "КОГДА");

	ТекущийТокен = "";
	ТекущийТокенБезМакроса = "";
	ПрочитатьТокен(ОбщиеПараметры, ТекущийТокен, ТекущийТокенБезМакроса, Ложь);

	Токен = Токен + Символы.ПС + Идентификатор + " " + ТекущийТокен;
	ТокенБезМакроса = ТокенБезМакроса + Символы.ПС + Идентификатор + " "
		+ ТекущийТокенБезМакроса;

	Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
	ПроверитьОжидаемыйТокен(ОбщиеПараметры, Идентификатор, "ТОГДА");

	ТекущийТокен = "";
	ТекущийТокенБезМакроса = "";
	ПрочитатьТокен(ОбщиеПараметры, ТекущийТокен, ТекущийТокенБезМакроса, Ложь);

	Токен = Токен + Символы.ПС + Идентификатор + " " + ТекущийТокен;
	ТокенБезМакроса = ТокенБезМакроса + Символы.ПС + Идентификатор + " "
		+ ТекущийТокенБезМакроса;
	Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
	Пока Идентификатор = "КОГДА" Цикл

		ТекущийТокен = "";
		ТекущийТокенБезМакроса = "";
		ПрочитатьТокен(ОбщиеПараметры, ТекущийТокен, ТекущийТокенБезМакроса, Ложь);

		Токен = Токен + Символы.ПС + Идентификатор + " " + ТекущийТокен;
		ТокенБезМакроса = ТокенБезМакроса + Символы.ПС + Идентификатор + " "
			+ ТекущийТокенБезМакроса;

		Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
		ПроверитьОжидаемыйТокен(ОбщиеПараметры, Идентификатор, "ТОГДА");

		ТекущийТокен = "";
		ТекущийТокенБезМакроса = "";
		ПрочитатьТокен(ОбщиеПараметры, ТекущийТокен, ТекущийТокенБезМакроса, Ложь);

		Токен = Токен + Символы.ПС + Идентификатор + " " + ТекущийТокен;
		ТокенБезМакроса = ТокенБезМакроса + Символы.ПС + Идентификатор + " "
			+ ТекущийТокенБезМакроса;

		Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
	КонецЦикла;
	Если Идентификатор = "ИНАЧЕ" Тогда

		ТекущийТокен = "";
		ТекущийТокенБезМакроса = "";
		ПрочитатьТокен(ОбщиеПараметры, ТекущийТокен, ТекущийТокенБезМакроса, Ложь);

		Токен = Токен + Символы.ПС + Идентификатор + " " + ТекущийТокен;
		ТокенБезМакроса = ТокенБезМакроса + Символы.ПС + Идентификатор + " "
			+ ТекущийТокенБезМакроса;
		Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
	КонецЕсли;
	ПроверитьОжидаемыйТокен(ОбщиеПараметры, Идентификатор, "КОНЕЦ");
	Токен = Токен + Символы.ПС + Идентификатор;
	ТокенБезМакроса = ТокенБезМакроса + Символы.ПС + Идентификатор;

КонецПроцедуры

Процедура РазборФормулыПрочитатьЗначение(Идентификатор, Токен,
		ТокенБезМакроса, ОбщиеПараметры)

	СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
	Если СледующийСимвол = "(" Тогда
	//Это разбор предопределенного значения
		ПроверитьОжидаемыйТокен(ОбщиеПараметры, СледующийСимвол, "(");
		ТекстТокена = Идентификатор + "(";
		ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
		Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);

		ТекстТокена = ТекстТокена + Идентификатор + ".";
		СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
		ПроверитьОжидаемыйТокен(ОбщиеПараметры, СледующийСимвол, ".");

		ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
		Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
		ТекстТокена = ТекстТокена + Идентификатор;
		СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);

		Если СледующийСимвол = "." Тогда
			ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
			Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
			ТекстТокена = ТекстТокена + "." + Идентификатор;
			СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
		КонецЕсли;

		ПроверитьОжидаемыйТокен(ОбщиеПараметры, СледующийСимвол, ")");

		ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
		ТекстТокена = ТекстТокена + ")";
	Иначе
	//Это разбор значения в форматах обмена
		Массив = Новый Массив;
		Массив.Добавить("<ЗНАЧЕНИЕ>");
		СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
		Пока СледующийСимвол = "." Цикл
			ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
			Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
			Массив.Добавить(Идентификатор);
			СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
		КонецЦикла;
		ТекстТокена = ОбработатьРеквизитыЧерезТочку(Массив, 1, ОбщиеПараметры.ЭтоТиповаяОперация);

	КонецЕсли;

	Токен = Токен + " " + ТекстТокена;
	ТокенБезМакроса = ТокенБезМакроса + " " + ТекстТокена;

КонецПроцедуры

// объединить со следующей
Процедура РазборФормулыПрочитатьФункциюБухгалтерскиеОперации(Идентификатор,
		Токен, ТокенБезМакроса, ОбщиеПараметры, ИмяМодуля = "БУХГАЛТЕРСКИЕОПЕРАЦИИ")

	Токен = Токен + ИмяМодуля + "." + Идентификатор + "(";
	ТокенБезМакроса = ТокенБезМакроса + ИмяМодуля + "." + Идентификатор + "(";

	ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
	ПропуститьНезначащийТекст(ОбщиеПараметры);
	Если Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1) <> ")" Тогда
		ТекущийТокен = "";
		ТекущийТокенБезМакроса = "";
		ПрочитатьТокен(ОбщиеПараметры, ТекущийТокен, ТекущийТокенБезМакроса, Ложь);

		Токен = Токен + ТекущийТокен;
		ТокенБезМакроса = ТокенБезМакроса + ТекущийТокенБезМакроса;
		ПропуститьНезначащийТекст(ОбщиеПараметры);
		Пока Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1) = "," Цикл
			ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
			ТекущийТокен = "";
			ТекущийТокенБезМакроса = "";
			ПрочитатьТокен(ОбщиеПараметры, ТекущийТокен, ТекущийТокенБезМакроса, Ложь);
			Токен = Токен + ", " + ТекущийТокен;
			ТокенБезМакроса = ТокенБезМакроса + ", " + ТекущийТокенБезМакроса;
		КонецЦикла;
	КонецЕсли;

	Если Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1) <> ")" Тогда
		РазборФормулыОбработатьОшибкуРазбора(ОбщиеПараметры, НСтр("ru = 'Ожидается "")"" в конце функции'"));
		Возврат;
	КонецЕсли;

	Если ИмяМодуля = "БУХГАЛТЕРСКИЕОПЕРАЦИИ" И (Идентификатор = "КЭКПРОВОДКИ"
			ИЛИ Идентификатор = "КЭКПРОВОДКИСВЫБОРОМДТКТ"
			ИЛИ Идентификатор = "ДОПУСТИМЫЙКЭКПРОВОДКИ") Тогда
		ОбщиеПараметры.РеквизитыКЭКПроводки.Добавить(ОбщиеПараметры.ТекущийРеквизит);
	КонецЕсли;

	ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
	Токен = Токен + ")";
	ТокенБезМакроса = ТокенБезМакроса + ")";

КонецПроцедуры

// Объединить с предыдущей
Процедура РазборФормулыПрочитатьФункциюОбщегоМодуля(Идентификатор, Токен,
		ТокенБезМакроса, ОбщиеПараметры, ИмяОбщегоМодуля)

	ТекстТокена = "";

	Токен = Токен + ИмяОбщегоМодуля + "." + Идентификатор + "(";
	ТокенБезМакроса = ТокенБезМакроса + ИмяОбщегоМодуля + "." + Идентификатор
		+ "(";

	ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
	ПропуститьНезначащийТекст(ОбщиеПараметры);
	Если Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1) <> ")" Тогда
		ТекущийТокен = "";
		ТекущийТокенБезМакроса = "";
		ПрочитатьТокен(ОбщиеПараметры, ТекущийТокен, ТекущийТокенБезМакроса, Ложь);

		Токен = Токен + ТекущийТокен;
		ТокенБезМакроса = ТокенБезМакроса + ТекущийТокенБезМакроса;
		ПропуститьНезначащийТекст(ОбщиеПараметры);
		Пока Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1) = "," Цикл
			ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
			ТекущийТокен = "";
			ТекущийТокенБезМакроса = "";
			ПрочитатьТокен(ОбщиеПараметры, ТекущийТокен, ТекущийТокенБезМакроса, Ложь);
			Токен = Токен + ", " + ТекущийТокен;
			ТокенБезМакроса = ТокенБезМакроса + ", " + ТекущийТокенБезМакроса;
		КонецЦикла;
	КонецЕсли;

	Если Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1) <> ")" Тогда
		РазборФормулыОбработатьОшибкуРазбора(ОбщиеПараметры, НСтр("ru = 'Ожидается "")"" в конце функции'"));
		Возврат;
	КонецЕсли;

	ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
	Токен = Токен + ")";
	ТокенБезМакроса = ТокенБезМакроса + ")";

	СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);

	Если СледующийСимвол = "." Тогда
		Массив = Новый Массив;
		Массив.Добавить(Токен);

		Пока СледующийСимвол = "." Цикл
			ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
			Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
			Массив.Добавить(Идентификатор);
			СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
		КонецЦикла;

		ТекстТокена = ОбработатьРеквизитыЧерезТочку(Массив, 1, ОбщиеПараметры.ЭтоТиповаяОперация);
		Токен = ТекстТокена;
		ТокенБезМакроса = ТекстТокена;
	КонецЕсли;

КонецПроцедуры

Функция ЭтоФункцияСКД(Идентификатор)

	Возврат Найти(",ПОДОБНО,ФОРМАТ,НАЧАЛОПЕРИОДА,КОНЕЦПЕРИОДА,ДОБАВИТЬКДАТЕ,РАЗНОСТЬДАТ,ДАТАВРЕМЯ,"
		+ "ПОДСТРОКА,ДЛИНАСТРОКИ,ГОД,КВАРТАЛ,МЕСЯЦ,ДЕНЬГОДА,ДЕНЬ,НЕДЕЛЯ,ДЕНЬНЕДЕЛИ,ТИПЗНАЧЕНИЯ,ТИП,"
		+ "ЧАС,МИНУТА,СЕКУНДА,ВЫРАЗИТЬ,ЕСТЬNULL,ПРЕДСТАВЛЕНИЕ,СТРОКА,ЗНАЧЕНИЕЗАПОЛНЕНО,", ","
		+ Идентификатор + ",") > 0;

КонецФункции

Процедура ПрочитатьФункциюСКД(ИдентификаторФункции, Токен, ТокенБезМакроса,
		ОбщиеПараметры)

	Токен = Токен + ИдентификаторФункции + "(";
	ТокенБезМакроса = ТокенБезМакроса + ИдентификаторФункции + "(";

	ПараметрыФункций = ПараметрыФункцийСКД();

	СтрокаФункции = ПараметрыФункций.Найти(ИдентификаторФункции, "Имя");
	КоличествоПараметров = СтрокаФункции.КоличествоПараметров;

	Для СчетчикПараметров = 1 По КоличествоПараметров Цикл

		Токен1 = "";
		ТокенБезМакроса1 = "";
		ПрочитатьТокен(ОбщиеПараметры, Токен1, ТокенБезМакроса1, Ложь);

		Идентификатор = Токен1;

		Токен = Токен + Идентификатор;
		ТокенБезМакроса = ТокенБезМакроса + ТокенБезМакроса1;
		ПропуститьНезначащийТекст(ОбщиеПараметры);
		СледующийСимвол = ВРЕГ(Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1));

		Если СчетчикПараметров = КоличествоПараметров Тогда
			ПроверитьОжидаемыйТокен(ОбщиеПараметры, СледующийСимвол, ")");
		Иначе
			ПроверитьОжидаемыйТокен(ОбщиеПараметры, СледующийСимвол, ",");
		КонецЕсли;

		Если ОбщиеПараметры.Ошибка Тогда
			Возврат;
		КонецЕсли;

		Токен = Токен + СледующийСимвол;
		ТокенБезМакроса = ТокенБезМакроса + СледующийСимвол;
		ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;

	КонецЦикла;

КонецПроцедуры

Функция ПараметрыФункцийСКД()

	ПараметрыФункций = Новый ТаблицаЗначений;
	ПараметрыФункций.Колонки.Добавить("Имя");
	ПараметрыФункций.Колонки.Добавить("КоличествоПараметров");

	ФункцияСКД = ПараметрыФункций.Добавить();
	ФункцияСКД.Имя = "ПОДОБНО";
	ФункцияСКД.КоличествоПараметров = 1;

	ФункцияСКД = ПараметрыФункций.Добавить();
	ФункцияСКД.Имя = "ФОРМАТ";
	ФункцияСКД.КоличествоПараметров = 2;

	ФункцияСКД = ПараметрыФункций.Добавить();
	ФункцияСКД.Имя = "НАЧАЛОПЕРИОДА";
