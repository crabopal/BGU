Процедура ДобавитьВалютныйУчетВФормулуСуммы(Сумма)

	Сумма = "ВЫБОР
		|КОГДА &ИСПОЛЬЗОВАТЬВАЛЮТНЫЙУЧЕТ И ЗНАЧЕНИЕЗАПОЛНЕНО(ДОКУМЕНТ.ВАЛЮТАДОКУМЕНТА)
		|ТОГДА БУХГАЛТЕРСКИЕОПЕРАЦИИ.ПЕРЕСЧИТАТЬИЗВАЛЮТЫВВАЛЮТУ(" + Сумма + "
		|	ДОКУМЕНТ.ВАЛЮТАДОКУМЕНТА,
		|	&ВАЛЮТАРЕГЛУЧЕТА,
		|	&КУРС,
		|	1,
		|	&КРАТНОСТЬ,
		|	1)
		|ИНАЧЕ " + Сумма + "
		|КОНЕЦ";

КонецПроцедуры

Процедура ВычислитьФормулуЗаполненияРеквизита(ОбщиеПараметрыЗаполнения,
		ИмяПоля, ЭтоВидСубконто = Ложь)

	СтрокаПроводки = ОбщиеПараметрыЗаполнения.ТекСтрокаПроводки;
	НастройкаНовойПроводки = ОбщиеПараметрыЗаполнения.НастройкаНовойПроводки;
	ВычисляемыеПоля = ОбщиеПараметрыЗаполнения.ВычисляемыеПоля;
	ИспользуемыеРеквизиты = Новый Массив;

	Если ИмяПоля = "Период" Тогда

		Если ПустаяСтрока(СтрокаПроводки.ФормулаПериод) Тогда

			НастройкаНовойПроводки.Период = "&ПЕРИОД";

		Иначе

			Формула = "";
			ФормулаБезМакроса = "";

			ОбработатьФормулуРеквизитаПроводки(СтрокаПроводки.ФормулаПериод, Формула, ФормулаБезМакроса, ИспользуемыеРеквизиты, СтрокаПроводки.ИмяТабличнойЧастиДокумента, ИмяПоля, ОбщиеПараметрыЗаполнения.ОписаниеОшибки, , , ОбщиеПараметрыЗаполнения.РеквизитыКЭКПроводки);

			НастройкаНовойПроводки.Период = Формула;

		КонецЕсли;

	ИначеЕсли ИмяПоля = "ЖурналОпераций" Тогда

		ИмяПоляПроводки = "НомерЖурнала";

		Если ЗначениеЗаполнено(СтрокаПроводки[ИмяПоляПроводки]) Тогда

			НастройкаНовойПроводки[ИмяПоля] = "НАСТРОЙКАПРОВОДОК."
				+ ВРЕГ(ИмяПоляПроводки);
			НастройкаНовойПроводки[ИмяПоля + "БезМакроса"] = "НАСТРОЙКАПРОВОДОК."
				+ ВРЕГ(ИмяПоляПроводки);

		ИначеЕсли ЗначениеЗаполнено(СтрокаПроводки["Формула"
				+ ИмяПоляПроводки]) Тогда

			Формула = "";
			ФормулаБезМакроса = "";
			ОбработатьФормулуРеквизитаПроводки(СтрокаПроводки["Формула"
				+ ИмяПоляПроводки], Формула, ФормулаБезМакроса, ИспользуемыеРеквизиты, СтрокаПроводки.ИмяТабличнойЧастиДокумента, ИмяПоля, ОбщиеПараметрыЗаполнения.ОписаниеОшибки, , , ОбщиеПараметрыЗаполнения.РеквизитыКЭКПроводки);
			НастройкаНовойПроводки[ИмяПоля] = Формула;
			НастройкаНовойПроводки[ИмяПоля + "БезМакроса"] = ФормулаБезМакроса;

		Иначе

			Формула = "";
			ОбработатьФормулуРеквизитаПроводки("БУХГАЛТЕРСКИЕОПЕРАЦИИ.НОМЕРЖУРНАЛА(ПРОВОДКА.СЧЕТДТ, ПРОВОДКА.СЧЕТКТ)", Формула, "", ИспользуемыеРеквизиты, СтрокаПроводки.ИмяТабличнойЧастиДокумента, ИмяПоля, ОбщиеПараметрыЗаполнения.ОписаниеОшибки, , , ОбщиеПараметрыЗаполнения.РеквизитыКЭКПроводки);
			НастройкаНовойПроводки[ИмяПоля] = Формула;

		КонецЕсли;

	ИначеЕсли ИмяПоля = "НомерСтроки" Тогда

		Если ПустаяСтрока(СтрокаПроводки.ИмяТабличнойЧастиДокумента)
				ИЛИ СокрЛП(СтрокаПроводки.ИмяТабличнойЧастиДокумента) = "<>" Тогда

		Иначе

			НастройкаНовойПроводки.НомерСтроки = "СТРОКАТАБЛИЦЫ.НОМЕРСТРОКИ";

		КонецЕсли;

	ИначеЕсли ИмяПоля = "УсловиеВыполнено" Тогда

		Если ПустаяСтрока(СтрокаПроводки.Условие) Тогда

		Иначе

			Формула = "";
			ОбработатьФормулуРеквизитаПроводки(СтрокаПроводки.Условие, Формула, "", ИспользуемыеРеквизиты, СтрокаПроводки.ИмяТабличнойЧастиДокумента, ИмяПоля, ОбщиеПараметрыЗаполнения.ОписаниеОшибки, , , ОбщиеПараметрыЗаполнения.РеквизитыКЭКПроводки);
			НастройкаНовойПроводки.УсловиеВыполнено = "НастройкаПроводок.ИмяТабличнойЧастиДокумента = ИмяТабличнойЧасти И ("
				+ Формула + ")";

		КонецЕсли;

	ИначеЕсли ИмяПоля = "Организация" Тогда

	ИначеЕсли ИмяПоля = "Активность" Тогда

	ИначеЕсли ЭтоВидСубконто Тогда

		Если ЗначениеЗаполнено(СтрокаПроводки[ИмяПоля]) Тогда
			НастройкаНовойПроводки[ИмяПоля] = "НАСТРОЙКАПРОВОДОК." + ВРЕГ(ИмяПоля);
		КонецЕсли;

	Иначе

		Если ЗначениеЗаполнено(СтрокаПроводки[ИмяПоля]) Тогда

			НастройкаНовойПроводки[ИмяПоля] = "НАСТРОЙКАПРОВОДОК." + ВРЕГ(ИмяПоля);
			НастройкаНовойПроводки[ИмяПоля + "БезМакроса"] = "НАСТРОЙКАПРОВОДОК."
				+ ВРЕГ(ИмяПоля);

		Иначе

			Формула = "";
			ФормулаБезМакроса = "";
			ОбработатьФормулуРеквизитаПроводки(СтрокаПроводки["Формула"
				+ ИмяПоля], Формула, ФормулаБезМакроса, ИспользуемыеРеквизиты, СтрокаПроводки.ИмяТабличнойЧастиДокумента, ИмяПоля, ОбщиеПараметрыЗаполнения.ОписаниеОшибки, , , ОбщиеПараметрыЗаполнения.РеквизитыКЭКПроводки);
			НастройкаНовойПроводки[ИмяПоля] = Формула;
			НастройкаНовойПроводки[ИмяПоля + "БезМакроса"] = ФормулаБезМакроса;

		КонецЕсли;

	КонецЕсли;

	Если ПустаяСтрока(НастройкаНовойПроводки[ИмяПоля]) Тогда
		НастройкаНовойПроводки[ИмяПоля] = ВычисляемыеПоля.Найти(ИмяПоля).Выражение;
		Если ИмяПоля <> "Активность" И ИмяПоля <> "НомерСтроки"
				И ИмяПоля <> "Период" И ИмяПоля <> "УсловиеВыполнено" Тогда
			НастройкаНовойПроводки[ИмяПоля
				+ "БезМакроса"] = ВычисляемыеПоля.Найти(ИмяПоля).Выражение;
		КонецЕсли;
	КонецЕсли;

	ОбщиеПараметрыЗаполнения.ИспользуемыеРеквизиты.Добавить(Новый Структура("ИмяПоля, ИспользуемыеРеквизиты", ИмяПоля, ИспользуемыеРеквизиты));

КонецПроцедуры

Процедура ПрочитатьТокен(ОбщиеПараметры, Токен, ТокенБезМакроса,
		Знач ПредыдущийИдентификатор)

	Токен = "";
	ТокенБезМакроса = "";
	ПервыйСимвол = ПропуститьНезначащийТекст(ОбщиеПараметры);

	Если ПервыйСимвол = "(" Тогда
		ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
		ТекущийТокен = "";
		ТекущийТокенБезМакроса = "";
		ПрочитатьТокен(ОбщиеПараметры, ТекущийТокен, ТекущийТокенБезМакроса, Ложь);
		Токен = Токен + "(" + ТекущийТокен;
		ТокенБезМакроса = ТокенБезМакроса + "(" + ТекущийТокенБезМакроса;

		СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
		ПроверитьОжидаемыйТокен(ОбщиеПараметры, СледующийСимвол, ")");

		Токен = Токен + ")";
		ТокенБезМакроса = ТокенБезМакроса + ")";

		ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
		ПредыдущийИдентификатор = Истина;
	ИначеЕсли ПервыйСимвол = ")" ИЛИ ПервыйСимвол = "," Тогда
		Возврат;
	ИначеЕсли ПервыйСимвол = "#" Тогда
		Токен = "#";
		Возврат;
	ИначеЕсли ПервыйСимвол = "?" Тогда
		ТекущийТокен = "";
		ТекущийТокенБезМакроса = "";
		РазборФормулыПрочитатьУсловныйОператор(ТекущийТокен, ТекущийТокенБезМакроса, ОбщиеПараметры);
		Токен = Токен + ТекущийТокен;
		ТокенБезМакроса = ТокенБезМакроса + ТекущийТокенБезМакроса;
	ИначеЕсли ПервыйСимвол = "&" Тогда
		ТекущийТокен = "";
		ТекущийТокенБезМакроса = "";
		РазборФормулыПрочитатьПараметр(ТекущийТокен, ТекущийТокенБезМакроса, ОбщиеПараметры);
		Токен = Токен + ТекущийТокен;
		ТокенБезМакроса = ТокенБезМакроса + ТекущийТокенБезМакроса;
	ИначеЕсли Найти("-+/*%", ПервыйСимвол) > 0 И ПредыдущийИдентификатор Тогда
		Токен = Токен + ПервыйСимвол;
		ТокенБезМакроса = ТокенБезМакроса + ПервыйСимвол;
		ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
		ПредыдущийИдентификатор = Ложь;
	ИначеЕсли Найти("><=", ПервыйСимвол) > 0 И ПредыдущийИдентификатор Тогда
		Токен = Токен + ПервыйСимвол;
		ТокенБезМакроса = ТокенБезМакроса + ПервыйСимвол;
		ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
		Если ПервыйСимвол = ">" ИЛИ ПервыйСимвол = "<" Тогда
			СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
			Если СледующийСимвол = "=" ИЛИ (СледующийСимвол = ">"
					И ПервыйСимвол = "<") Тогда
				Токен = Токен + СледующийСимвол;
				ТокенБезМакроса = ТокенБезМакроса + СледующийСимвол;
				ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
			КонецЕсли;
		КонецЕсли;
		ПредыдущийИдентификатор = Ложь;
	ИначеЕсли Найти("-+0123456789", ПервыйСимвол) > 0 Тогда
		РазборФормулыПрочитатьЧисло(ПервыйСимвол, Токен, ТокенБезМакроса, ОбщиеПараметры, ПредыдущийИдентификатор);
	ИначеЕсли ПервыйСимвол = """" Тогда
		РазборФормулыПрочитатьСтроку(ПервыйСимвол, Токен, ТокенБезМакроса, ОбщиеПараметры, ПредыдущийИдентификатор);
	Иначе
		Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
		Если Идентификатор = "ПОДОБНО" Тогда
			Токен = Токен + " " + Идентификатор;
			ТокенБезМакроса = ТокенБезМакроса + " " + Идентификатор;
			ПервыйСимвол = ПропуститьНезначащийТекст(ОбщиеПараметры);
			РазборФормулыПрочитатьСтроку(ПервыйСимвол, Токен, ТокенБезМакроса, ОбщиеПараметры, ПредыдущийИдентификатор);
		ИначеЕсли Идентификатор = "И" ИЛИ Идентификатор = "ИЛИ" Тогда
			Токен = Токен + " " + Идентификатор + " ";
			ТокенБезМакроса = ТокенБезМакроса + " " + Идентификатор + " ";
			ПредыдущийИдентификатор = Ложь;
		ИначеЕсли Идентификатор = "РАЗЛИЧНЫЕ" Тогда
			Токен = Идентификатор;
			ТокенБезМакроса = Идентификатор;
			ПредыдущийИдентификатор = Ложь;
			Возврат;
		ИначеЕсли Идентификатор = "НЕОПРЕДЕЛЕНО" ИЛИ Идентификатор = "NULL" Тогда
			Токен = Токен + Идентификатор;
			ТокенБезМакроса = ТокенБезМакроса + Идентификатор;
			ПредыдущийИдентификатор = Истина;
		ИначеЕсли Идентификатор = "ЕСТЬ" Тогда
			Токен = Токен + " " + Идентификатор;
			ТокенБезМакроса = ТокенБезМакроса + " " + Идентификатор;
			Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
			Если Идентификатор = "НЕ" Тогда
				Токен = Токен + " " + Идентификатор;
				ТокенБезМакроса = ТокенБезМакроса + " " + Идентификатор;
				Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
			КонецЕсли;
			ПроверитьОжидаемыйТокен(ОбщиеПараметры, Идентификатор, "NULL");
			Токен = Токен + " " + Идентификатор;
			ТокенБезМакроса = ТокенБезМакроса + " " + Идентификатор;
			ПредыдущийИдентификатор = Истина;
		ИначеЕсли Идентификатор = "ВЫБОР" Тогда
			ТекущийТокен = "";
			ТекущийТокенБезМакроса = "";
			РазборФормулыПрочитатьОператорВыбора(Идентификатор, ТекущийТокен, ТекущийТокенБезМакроса, ОбщиеПараметры);
			Токен = Токен + ТекущийТокен;
			ТокенБезМакроса = ТокенБезМакроса + ТекущийТокенБезМакроса;
			ПредыдущийИдентификатор = Истина;
		ИначеЕсли Найти(",ИСТИНА,ЛОЖЬ,", "," + Идентификатор + ",") > 0 Тогда
			Токен = Токен + " " + Идентификатор;
			ТокенБезМакроса = ТокенБезМакроса + " " + Идентификатор;
			ПредыдущийИдентификатор = Истина;
		ИначеЕсли Идентификатор = "ЗНАЧЕНИЕ" Тогда
			РазборФормулыПрочитатьЗначение(Идентификатор, Токен, ТокенБезМакроса, ОбщиеПараметры);
			Если ОбщиеПараметры.Ошибка Тогда
				Возврат;
			КонецЕсли;
			ПредыдущийИдентификатор = Истина;
		ИначеЕсли ОбщиеПараметры.ЭтоТиповаяОперация И (Идентификатор = "ДОКУМЕНТ"
				ИЛИ Идентификатор = "СТРОКАТАБЛИЦЫ"
				ИЛИ Идентификатор = "ДОПОЛНИТЕЛЬНЫЕРЕКВИЗИТЫ"
				ИЛИ Идентификатор = "ТИПОВАЯОПЕРАЦИЯ") Тогда
			Массив = Новый Массив;
			Массив.Добавить(Идентификатор);
			СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
			Пока СледующийСимвол = "." Цикл
				ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
				Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
				Массив.Добавить(Идентификатор);
				СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
			КонецЦикла;
			ТекстТокена = ОбработатьРеквизитыЧерезТочку(Массив);
			Токен = Токен + ТекстТокена;
			ТокенБезМакроса = ТокенБезМакроса + ТекстТокена;
			ПредыдущийИдентификатор = Истина;
		ИначеЕсли ОбщиеПараметры.ЭтоТиповаяОперация
				И Идентификатор = "ТЕКУЩИЙИТЕРАТОР" Тогда
			Токен = Идентификатор;
			ТокенБезМакроса = Идентификатор;
			Возврат;
		ИначеЕсли Идентификатор = "ЗНАЧЕНИЕРЕКВИЗИТАСТРОКИ" Тогда
		// ЗначениеРеквизитаСтроки оставлено для совместимости ранее созданных типовый операций пользователя.
			// В формулах ее можно заменить аналогом БухгалтерскиеОперации.ЗначениеРеквизитаСтроки.
			СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
			ПроверитьОжидаемыйТокен(ОбщиеПараметры, СледующийСимвол, "(");
			ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;

			ПрочитатьТокен(ОбщиеПараметры, ТекущийТокен, ТекущийТокенБезМакроса, Ложь);

			СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
			ПроверитьОжидаемыйТокен(ОбщиеПараметры, СледующийСимвол, ",");
			ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;

			ИмяТЧ = СокрЛП(СтрЗаменить(ТекущийТокен, """", ""));

			ПрочитатьТокен(ОбщиеПараметры, ТекущийТокен, ТекущийТокенБезМакроса, Ложь);

			СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
			ПроверитьОжидаемыйТокен(ОбщиеПараметры, СледующийСимвол, ",");
			ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;

			НомерСтроки = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);

			СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
			ПроверитьОжидаемыйТокен(ОбщиеПараметры, СледующийСимвол, ")");
			ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;

			// если токен содержит кавычки, то их нужно удвоить перед помещением текста в кавычки агрегатной функции
			ТекущийТокен = СтрЗаменить(ТекущийТокен, """", """""");
			ТекущийТокенБезМакроса = СтрЗаменить(ТекущийТокенБезМакроса, """", """""");

			Токен = Токен + "Вычислить(""МАКСИМУМ(ВЫБОР
				|	КОГДА ИмяТабличнойЧасти = """"" + ИмяТЧ
				+ """"" И СтрокаТаблицы.НомерСтроки = " + НомерСтроки + "
				|		ТОГДА " + ТекущийТокен + "
				|КОНЕЦ)"", ""ОбщийИтог"")";

			ТекущийТокенБезМакроса = ТекущийТокенБезМакроса
				+ "Вычислить(""МАКСИМУМ(ВЫБОР
				|	КОГДА ИмяТабличнойЧасти = """"" + ИмяТЧ
				+ """"" И СтрокаТаблицы.НомерСтроки = " + НомерСтроки + "
				|		ТОГДА " + ТекущийТокен + "
				|КОНЕЦ)"", ""ОбщийИтог"")";

			ПредыдущийИдентификатор = Истина;

		ИначеЕсли НЕ ОбщиеПараметры.ЭтоТиповаяОперация И (Идентификатор = "ОБЪЕКТ"
				ИЛИ Идентификатор = "ЗАДАНИЕ" ИЛИ Идентификатор = "ОБРАБАТЫВАЕМЫЙФОРМАТ"
				ИЛИ Идентификатор = "ДОКУМЕНТ" ИЛИ Идентификатор = "РЕКВИЗИТЫ") Тогда
				// Для форматов обмена	
			// дочитать до конца
			ИмяОбъекта = Идентификатор;
			Массив = Новый Массив;
			Массив.Добавить(Идентификатор);
			СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
			Пока СледующийСимвол = "." Цикл
				ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
				Идентификатор = ПрочитатьИдентификатор(ОбщиеПараметры, ОбщиеПараметры.ИндексСимвола, ОбщиеПараметры.ДлинаТекста, ОбщиеПараметры.Текст);
				Массив.Добавить(Идентификатор);
