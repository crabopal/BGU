Функция ИндексНачалаПараметровФункции(ТекстФормулы, ДлинаФормулы,
		ШаблонФункции, НачальныйИндекс)

	ДлинаШаблона = СтрДлина(ШаблонФункции);
	ПредварительныйИндекс = СтрНайти(ТекстФормулы, ШаблонФункции, , НачальныйИндекс);
	Пока ПредварительныйИндекс > 0 Цикл

	// Проверить, что следующий символ = "("
		ПроверяемыйИндекс = ПредварительныйИндекс + ДлинаШаблона;
		Пока ПроверяемыйИндекс <= ДлинаФормулы
			И ПустаяСтрока(Сред(ТекстФормулы, ПроверяемыйИндекс, 1)) Цикл

			ПроверяемыйИндекс = ПроверяемыйИндекс + 1;
		КонецЦикла;

		Если Сред(ТекстФормулы, ПроверяемыйИндекс, 1) <> "(" Тогда
		// формула найдена ошибочно. Продолжить поиск
			ПредварительныйИндекс = СтрНайти(ТекстФормулы, ШаблонФункции, , ПроверяемыйИндекс);
			Продолжить;
		КонецЕсли;

		// Найдено
		Возврат ПроверяемыйИндекс + 1;

	КонецЦикла;

	Возврат 0;

КонецФункции

Функция ПрочитатьПараметрыФункции(ТекстФормулы, ДлинаФормулы,
		ПроверяемыйИндекс)

	НачальныйИндексПараметра = ПроверяемыйИндекс;
	ОткрытаКавычка = Ложь;
	ПараметрыФункции = Новый Массив;
	ОткрытыеБлоки = Новый Массив;
	Пока ПроверяемыйИндекс <= ДлинаФормулы Цикл

		ПроверяемыйСимвол = Сред(ТекстФормулы, ПроверяемыйИндекс, 1);

		Если ПустаяСтрока(ПроверяемыйСимвол) И ОткрытыеБлоки.Количество() = 0 Тогда
			ПроверяемыйИндекс = ПроверяемыйИндекс + 1;
			Продолжить;
		КонецЕсли;

		Если ПроверяемыйСимвол = "(" Тогда
			ОткрытыеБлоки.Добавить("(");
			ПроверяемыйИндекс = ПроверяемыйИндекс + 1;
			Продолжить;
		ИначеЕсли ПроверяемыйСимвол = """" Тогда

			Если Сред(ТекстФормулы, ПроверяемыйИндекс + 1, 1) <> """"
					ИЛИ Не ОткрытаКавычка Тогда
					// Одинарная кавычка или несколько кавычек, начинающих строку - первая кавычка "открывающая"
				ОткрытаКавычка = Не ОткрытаКавычка;
				ПроверяемыйИндекс = ПроверяемыйИндекс + 1;
				Продолжить;
			Иначе
			// Двойная кавычка
				ПроверяемыйИндекс = ПроверяемыйИндекс + 2;
				Продолжить;
			КонецЕсли;

		ИначеЕсли ПроверяемыйСимвол = ")" Тогда
			Если ОткрытыеБлоки.Количество() = 0 Тогда

			// Добавить параметр
				ПараметрыФункции.Добавить(Сред(ТекстФормулы, НачальныйИндексПараметра, ПроверяемыйИндекс
					- НачальныйИндексПараметра));

				Прервать;

			ИначеЕсли ОткрытыеБлоки[ОткрытыеБлоки.ВГраница()] <> "(" Тогда
				ВызватьИсключение "Не обнаружена парная открывающая скобка";
			Иначе
				ОткрытыеБлоки.Удалить(ОткрытыеБлоки.ВГраница());
				ПроверяемыйИндекс = ПроверяемыйИндекс + 1;
				Продолжить;
			КонецЕсли;

		ИначеЕсли ПроверяемыйСимвол = "," Тогда

		// ДобавитьПараметр
			ПараметрыФункции.Добавить(Сред(ТекстФормулы, НачальныйИндексПараметра, ПроверяемыйИндекс
				- НачальныйИндексПараметра));

			ПроверяемыйИндекс = ПроверяемыйИндекс + 1;
			НачальныйИндексПараметра = ПроверяемыйИндекс;
			Продолжить;

		Иначе

			ПроверяемыйИндекс = ПроверяемыйИндекс + 1;
			Продолжить;

		КонецЕсли;

	КонецЦикла;

	Возврат ПараметрыФункции;

КонецФункции

Процедура ДополнитьИспользуемыеРеквизиты(ОбщиеПараметрыЗаполнения,
		ИмяРеквизита, ИменаСубконто)

	ИспользуемыеРеквизиты = ПолучитьИспользуемыеРеквизиты(ОбщиеПараметрыЗаполнения, ИмяРеквизита);

	Если ИспользуемыеРеквизиты = Неопределено Тогда
		ИспользуемыеРеквизиты = Новый Массив;
		ОбщиеПараметрыЗаполнения.Добавить(Новый Структура("ИмяПоля, ИспользуемыеРеквизиты", ИмяРеквизита, ИспользуемыеРеквизиты));
	КонецЕсли;

	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Организация");
	ИменаРеквизитов.Добавить("ИФО");
	ИменаРеквизитов.Добавить("КФО");
	ИменаРеквизитов.Добавить("Период");
	ИменаРеквизитов.Добавить(ИменаСубконто.Счет);
	ИменаРеквизитов.Добавить(ИменаСубконто.Субконто1);
	ИменаРеквизитов.Добавить(ИменаСубконто.Субконто2);
	ИменаРеквизитов.Добавить(ИменаСубконто.Субконто3);

	Для каждого ТекИмя Из ИменаРеквизитов Цикл

		ТекИспользуемыеРеквизиты = ПолучитьИспользуемыеРеквизиты(ОбщиеПараметрыЗаполнения, ТекИмя);
		Если ТекИспользуемыеРеквизиты <> Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ИспользуемыеРеквизиты, ТекИспользуемыеРеквизиты, Истина);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ПолучитьИспользуемыеРеквизиты(ОбщиеПараметрыЗаполнения, ИмяРеквизита)

	ИспользуемыеРеквизиты = Неопределено;

	Для каждого Элемент Из ОбщиеПараметрыЗаполнения.ИспользуемыеРеквизиты Цикл

		Если Элемент.ИмяПоля = ИмяРеквизита Тогда
			ИспользуемыеРеквизиты = Элемент.ИспользуемыеРеквизиты;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат ИспользуемыеРеквизиты;

КонецФункции

Процедура ОбработатьФормулуРеквизитаПроводки(Знач ФормулаПроводки, Формула,
		ФормулаБезМакросов, ИспользуемыеРеквизиты, ИмяТабличойЧасти, ИмяРеквизита,
		ОписаниеОшибки, ЭтоТиповаяОперация = Истина,
		ИспользуемыеПараметры = Неопределено,
		РеквизитыКЭКПроводки = Неопределено) Экспорт

	Если ИспользуемыеПараметры = Неопределено Тогда
		ИспользуемыеПараметры = Новый Массив;
	КонецЕсли;

	ДлинаТекста = СтрДлина(ФормулаПроводки);

	ОбщиеПараметры = Новый Структура;
	ОбщиеПараметры.Вставить("Текст", ФормулаПроводки);
	ОбщиеПараметры.Вставить("ТекущаяТЧ", ИмяТабличойЧасти);
	ОбщиеПараметры.Вставить("ТекущийРеквизит", ИмяРеквизита);
	ОбщиеПараметры.Вставить("НомерСтроки", 1);
	ОбщиеПараметры.Вставить("ИндексСимвола", 1);
	ОбщиеПараметры.Вставить("ДлинаТекста", ДлинаТекста);
	ОбщиеПараметры.Вставить("Ошибка", Ложь);
	ОбщиеПараметры.Вставить("ОписаниеОшибки", "");
	ОбщиеПараметры.Вставить("ИспользуемыеРеквизиты", ИспользуемыеРеквизиты);
	ОбщиеПараметры.Вставить("ИспользуемыеПараметры", ИспользуемыеПараметры);
	ОбщиеПараметры.Вставить("ЭтоТиповаяОперация", ЭтоТиповаяОперация);
	ОбщиеПараметры.Вставить("РеквизитыКЭКПроводки", Новый Массив);

	Формула = "";
	ФормулаБезМакросов = "";

	Индекс = 1;
	Пока ОбщиеПараметры.ИндексСимвола <= ДлинаТекста Цикл
		Индекс = Индекс + 1;
		Если Индекс = 1000 Тогда
		// ушли в бесконечный цикл: в формуле попалось что то неожиданное
			ОбщиеПараметры.Ошибка = Истина;
			ОписаниеОшибки = НСтр("ru = 'Ошибка разбора текста формулы'") + Символы.ПС
				+ СтрЗаменить(ФормулаПроводки, """", """""");
			Возврат;
		КонецЕсли;
		ТокенБезМакроса = "";
		Токен = "";
		ПрочитатьТокен(ОбщиеПараметры, Токен, ТокенБезМакроса, Ложь);
		Формула = Формула + Токен;
		ФормулаБезМакросов = ФормулаБезМакросов + ТокенБезМакроса;

		Если ОбщиеПараметры.Ошибка Тогда
			ОписаниеОшибки = ОбщиеПараметры.ОписаниеОшибки;
			Возврат;
		КонецЕсли;

	КонецЦикла;

	Если ТипЗнч(РеквизитыКЭКПроводки) = Тип("Массив") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(РеквизитыКЭКПроводки, ОбщиеПараметры.РеквизитыКЭКПроводки);
	КонецЕсли;

КонецПроцедуры

// Формирует структуру доп. реквизитов и их значения. Вызывается при записи из формы документа.
//
// Параметры:
//	Форма - УправляемаяФорма - Форма документа.
//	ДополнительныеРеквизиты - Произвольный - после выполнения содержит структуру с доп. реквизитами: ключ-ИмяДляФормулы, значение - значение доп. реквизита
//	ЗначенияДопРеквизитов - Произвольный - после выполнения содержит готовую таблицу значений, для записи в РС ЗначенияДополнительныхРеквизитовОперации
//  БезВалюты - Булево - признак необходимости получения реквизитов Курс и Кратность. Если валютный учет не ведется, то реквизиты курс и кратность не получаются
//							не зависимо от параметра.
//	
Процедура СформироватьСтруктуруДопРеквизитов(Форма, ДополнительныеРеквизиты,
		ЗначенияДопРеквизитов, БезВалюты = Ложь) Экспорт

	ТекТиповаяОперация = Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитыФормыТиповаяОперацияФактическое(Форма)];
	Если НЕ ЗначениеЗаполнено(ТекТиповаяОперация) Тогда
		Возврат;
	КонецЕсли;

	ЗначенияДопРеквизитов = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	ЗначенияДопРеквизитов.Колонки.Добавить("НаименованиеРеквизита");
	ДобавленныеРеквизиты = Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"];
	ДополнительныеРеквизиты = Новый Структура;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	РеквизитыТиповыхОпераций.Ссылка,
		|	РеквизитыТиповыхОпераций.ИмяДляФормулы,
		|	РеквизитыТиповыхОпераций.РеквизитПроводки,
		|	РеквизитыТиповыхОпераций.РеквизитПроводки.ТипЗначения КАК ТипЗначения,
		|	РеквизитыТиповыхОпераций.Наименование Как НаименованиеРеквизита
		|ИЗ
		|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		|ГДЕ
		|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
		|	И НЕ РеквизитыТиповыхОпераций.ЭтоГруппа
		|	И НЕ РеквизитыТиповыхОпераций.ПометкаУдаления";
	Запрос.УстановитьПараметр("ТиповаяОперация", ТекТиповаяОперация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ТекСоответствие = ДобавленныеРеквизиты.НайтиСтроки(Новый Структура("ИмяДляФормулы", ВРег(Выборка.ИмяДляФормулы)));
		Если ТекСоответствие.Количество() > 0 Тогда

			НовЗначение = ЗначенияДопРеквизитов.Добавить();
			НовЗначение.РеквизитОперации = Выборка.Ссылка;
			НовЗначение.Значение = Форма[ТекСоответствие[0].ИмяРеквизита];

			ДополнительныеРеквизиты.Вставить(Выборка.ИмяДляФормулы, Форма[ТекСоответствие[0].ИмяРеквизита]);

		КонецЕсли;

	КонецЦикла;

	Если Не БезВалюты Тогда
		ДополнительныеРеквизиты.Вставить("Курс",
			БухгалтерскиеОперацииКлиентСервер.ЗначениеДополнительногоРеквизитаИзФормы(
				Форма,
				"Курс"));
		ДополнительныеРеквизиты.Вставить("Кратность",
			БухгалтерскиеОперацииКлиентСервер.ЗначениеДополнительногоРеквизитаИзФормы(
				Форма,
				"Кратность"));
	КонецЕсли;
	
	ИмяРеквизитаИспавлениеОшибок = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаФлажокИсправлениеОшибокПрошлыхЛет();
	ЭтоИсправлениеОшибок = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизитаИспавлениеОшибок)
		И Форма[ИмяРеквизитаИспавлениеОшибок];
	
	Если ЭтоИсправлениеОшибок Тогда
		ДополнительныеРеквизиты.Вставить("ИсправлениеОшибки", Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательИсправлениеОшибокПрошлыхЛет()]);
		ДополнительныеРеквизиты.Вставить("ВыявительОшибки",   Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательВыявительОшибкиПрошлыхЛет()]);
		ДополнительныеРеквизиты.Вставить("ПричинаОшибки",     Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательПричинаОшибкиПрошлыхЛет()]);
	Иначе
		ДополнительныеРеквизиты.Вставить("ИсправлениеОшибки", Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка);
		ДополнительныеРеквизиты.Вставить("ВыявительОшибки",   Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка());
		ДополнительныеРеквизиты.Вставить("ПричинаОшибки",     Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка());
	КонецЕсли;

КонецПроцедуры

Функция ВДокументеИспользуетсяВалютныйУчет(Идентификатор)

	Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		Возврат БухгалтерскиеОперацииПовтИспНаВремяСеанса.ПоДокументуВедетсяВалютныйУчет(Идентификатор);
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Проверяет наличие в документе реквизита ПервичныйДокумент с типом СправочникСсылка.ПервичныеДокументы
//
// Параметры:
//  Идентификатор - СправочникСсылка.ИдентификаторыОбъектовМетаданных
// 
// Возвращаемое значение:
//  Булево
//
Функция ВДокументеЕстьПервичныйДокумент(Идентификатор) Экспорт
	Возврат БухгалтерскиеОперацииПовтИспНаВремяСеанса.ВДокументеЕстьПервичныйДокумент(Идентификатор);
КонецФункции

// Добавляет, при необходимости, в таблицу проводок колонки видов субконто
//
Процедура ДополнитьКолонкиТаблицыПроводок(ТаблицаПроводок)

	ТипВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	Если ТаблицаПроводок.Колонки.Найти("ВидСубконтоДт1") = Неопределено Тогда
		ТаблицаПроводок.Колонки.Добавить("ВидСубконтоДт1", ТипВидСубконто);
	КонецЕсли;
	Если ТаблицаПроводок.Колонки.Найти("ВидСубконтоДт2") = Неопределено Тогда
		ТаблицаПроводок.Колонки.Добавить("ВидСубконтоДт2", ТипВидСубконто);
	КонецЕсли;
	Если ТаблицаПроводок.Колонки.Найти("ВидСубконтоДт3") = Неопределено Тогда
		ТаблицаПроводок.Колонки.Добавить("ВидСубконтоДт3", ТипВидСубконто);
	КонецЕсли;
	Если ТаблицаПроводок.Колонки.Найти("ВидСубконтоКт1") = Неопределено Тогда
		ТаблицаПроводок.Колонки.Добавить("ВидСубконтоКт1", ТипВидСубконто);
	КонецЕсли;
	Если ТаблицаПроводок.Колонки.Найти("ВидСубконтоКт2") = Неопределено Тогда
		ТаблицаПроводок.Колонки.Добавить("ВидСубконтоКт2", ТипВидСубконто);
	КонецЕсли;
	Если ТаблицаПроводок.Колонки.Найти("ВидСубконтоКт3") = Неопределено Тогда
		ТаблицаПроводок.Колонки.Добавить("ВидСубконтоКт3", ТипВидСубконто);
	КонецЕсли;

КонецПроцедуры

