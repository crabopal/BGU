Процедура ДополнительноОбработатьРеквизитыКоличество(НастройкаНовойПроводки)
	Если ПустаяСтрока(НастройкаНовойПроводки.КоличествоКт)
			ИЛИ ВРЕГ(НастройкаНовойПроводки.КоличествоКт) = "NULL"
			ИЛИ ПустаяСтрока(НастройкаНовойПроводки.СчетКт)
			ИЛИ ВРЕГ(НастройкаНовойПроводки.СчетКт) = "NULL" Тогда
		НастройкаНовойПроводки.КоличествоКт = "NULL";
	Иначе
		НастройкаНовойПроводки.КоличествоКт = "ВЫБОР
			|КОГДА " + НастройкаНовойПроводки.СчетКтБезМакроса
			+ " В (&КОЛИЧЕСТВЕННЫЕСЧЕТА)
			|ТОГДА ВЫРАЗИТЬ(" + НастройкаНовойПроводки.КоличествоКт
			+ ", ""ЧИСЛО(15,3)"")
			|ИНАЧЕ NULL
			|КОНЕЦ";
	КонецЕсли;
	Если ПустаяСтрока(НастройкаНовойПроводки.КоличествоДт)
			ИЛИ ВРЕГ(НастройкаНовойПроводки.КоличествоДт) = "NULL"
			ИЛИ ПустаяСтрока(НастройкаНовойПроводки.СчетДт)
			ИЛИ ВРЕГ(НастройкаНовойПроводки.СчетДт) = "NULL" Тогда
		НастройкаНовойПроводки.КоличествоДт = "NULL";
	Иначе
		НастройкаНовойПроводки.КоличествоДт = "ВЫБОР
			|КОГДА " + НастройкаНовойПроводки.СчетДтБезМакроса
			+ " В (&КОЛИЧЕСТВЕННЫЕСЧЕТА)
			|ТОГДА ВЫРАЗИТЬ(" + НастройкаНовойПроводки.КоличествоДт
			+ ", ""ЧИСЛО(15,3)"")
			|ИНАЧЕ NULL
			|КОНЕЦ";
	КонецЕсли;
КонецПроцедуры

