Процедура УстановитьПометкуУдаленияРеквизитамПоставляемыхТиповыхОпераций() Экспорт

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();

	Если ОбновлениеИнформационнойБазы.ВыполняетсяОбновлениеИнформационнойБазы() Тогда

	// Проверку выполнять после окончания обновления областей данных.
		Возврат;

	КонецЕсли;

	Если НЕ ОбщегоНазначения.РазделениеВключено() Тогда

	// Выключить использование рег. задания, т.к. оно было включено не правильно
		ОстановитьРегЗаданиеУдаленияПоставлямойТиповойОперации();
		Возврат;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ПоставляемыеТиповыеОперации.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА ИСТИНА В
		|				(ВЫБРАТЬ ПЕРВЫЕ 1
		|					ИСТИНА КАК Поле1
		|				ИЗ
		|					РегистрСведений.ОтключенныеОтПоддержкиПоставляемыеТиповыеОперации КАК ОтключенныеОтПоддержкиПоставляемыеТиповыеОперации
		|				ГДЕ
		|					ОтключенныеОтПоддержкиПоставляемыеТиповыеОперации.ПоставляемаяТиповаяОперация = ПоставляемыеТиповыеОперации.Ссылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьНеобработанныеОбластиДанных
		|ИЗ
		|	Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
		|ГДЕ
		|	ПоставляемыеТиповыеОперации.ПометкаУдаления = ИСТИНА
		|	И ИСТИНА В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИСТИНА КАК Поле1
		|			ИЗ
		|				Справочник.ПоставляемыеРеквизитыТиповыхОпераций КАК ПоставляемыеРеквизитыТиповыхОпераций
		|			ГДЕ
		|				ПоставляемыеРеквизитыТиповыхОпераций.Владелец = ПоставляемыеТиповыеОперации.Ссылка
		|				И ПоставляемыеРеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ)
		|	И ИСТИНА В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИСТИНА КАК Поле1
		|			ИЗ
		|				Справочник.ПоставляемыеПроводкиТиповыхОпераций КАК ПоставляемыеПроводкиТиповыхОпераций
		|			ГДЕ
		|				ПоставляемыеПроводкиТиповыхОпераций.Владелец = ПоставляемыеТиповыеОперации.Ссылка
		|				И ПоставляемыеПроводкиТиповыхОпераций.ПометкаУдаления = ЛОЖЬ)
		|	И ИСТИНА В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИСТИНА КАК Поле1
		|			ИЗ
		|				Справочник.ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций
		|			ГДЕ
		|				ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.Владелец = ПоставляемыеТиповыеОперации.Ссылка
		|				И ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.ПометкаУдаления = ЛОЖЬ)";

	ЕстьНеобработанныеОбластиДанных = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.ЕстьНеобработанныеОбластиДанных Тогда

			ЕстьНеобработанныеОбластиДанных = Истина;
			Продолжить;

		КонецЕсли;

		Справочники.ПоставляемыеТиповыеОперации.УстановитьПометкуУдаленияПодчиненнымЭлементам(Выборка.Ссылка);

	КонецЦикла;

	Если НЕ ЕстьНеобработанныеОбластиДанных Тогда

	// Выключить использование рег. задания
		ОстановитьРегЗаданиеУдаленияПоставлямойТиповойОперации();

	КонецЕсли;

КонецПроцедуры

Процедура НачатьОтключениеОтПоддержкиТиповойОперацииВОбластяхДанных() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ОбластиДанных.ОбластьДанныхВспомогательныеДанные КАК ОбластьДанныхВспомогательныеДанные
		|ИЗ
		|	РегистрСведений.ОбластиДанных КАК ОбластиДанных
		|ГДЕ
		|	ОбластиДанных.Статус В (Значение(Перечисление.СтатусыОбластейДанных.Новая), Значение(Перечисление.СтатусыОбластейДанных.Используется))";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ПараметрыЗадания = Новый Структура("ОбластьДанных, ИмяМетода");
		ПараметрыЗадания.ОбластьДанных = Выборка.ОбластьДанныхВспомогательныеДанные;
		ПараметрыЗадания.ИмяМетода = "ОтключитьОтПоддержкиТиповыеОперацииВОбластиДанных";

		ОчередьЗаданий.ДобавитьЗадание(ПараметрыЗадания);

	КонецЦикла;

	ЗапуститьРегЗаданиеУдаленияПоставлямойТиповойОперации();

КонецПроцедуры

// Добавляет фоновые задания обновления типовых операций в областях данных.
// 
// Параметры:
//  ТолькоИзменившиеся - Булево - будут обновлены только ТО, у которых дата версии ниже даты версии ПТО
Процедура НачатьФоновоеОбновлениеТиповыхОперацийВОбластяхДанных(ТолькоИзменившиеся) Экспорт

	Если Не ОбщегоНазначения.РазделениеВключено()
			Или ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда

		ТекстОшибки = НСтр("ru = 'Запуск фоновых заданий обновления типовых операций возможен только из неразделенного режима.'"); 
		ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрацииОбновлениеТО(), УровеньЖурналаРегистрации.Ошибка, , ,
			ТекстОшибки);

		ВызватьИсключение ТекстОшибки;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбластиДанных.ОбластьДанныхВспомогательныеДанные КАК ОбластьДанныхВспомогательныеДанные
	|ИЗ
	|	РегистрСведений.ОбластиДанных КАК ОбластиДанных
	|ГДЕ
	|	ОбластиДанных.Статус В (Значение(Перечисление.СтатусыОбластейДанных.Новая),
	|		Значение(Перечисление.СтатусыОбластейДанных.Используется))";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("ОбластьДанных", Выборка.ОбластьДанныхВспомогательныеДанные);
		ПараметрыЗадания.Вставить("ИмяМетода", "ОбновлениеТиповыхОперацийВОбластиДанных");
		ПараметрыЗадания.Вставить("Параметры", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТолькоИзменившиеся));

		ОчередьЗаданий.ДобавитьЗадание(ПараметрыЗадания);

	КонецЦикла;

КонецПроцедуры

Процедура ОстановитьФоновоеОбновлениеТиповыхОперацийВОбластиДанных(Знач ОбластьДанных = 0) Экспорт

	Отбор = Новый Структура("ИмяМетода");
	Отбор.ИмяМетода = "ОбновлениеТиповыхОперацийВОбластиДанных";
	Если ОбластьДанных <> 0 Тогда
		Отбор.Вставить("ОбластьДанных", ОбластьДанных);
	КонецЕсли;

	СуществующиеЗадания = ОчередьЗаданий.ПолучитьЗадания(Отбор);
	Для каждого Задание Из СуществующиеЗадания Цикл

		ОчередьЗаданий.УдалитьЗадание(Задание.Идентификатор);

	КонецЦикла;

КонецПроцедуры

Функция ЗапущеноФоновоеОбновлениеТиповыхОпераций() Экспорт

	Если НЕ ОбщегоНазначения.РазделениеВключено()
			ИЛИ НЕ ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда

		Возврат Ложь;

	КонецЕсли;

	ЗначениеРазделителяСеанса = РаботаВМоделиСервиса.ЗначениеРазделителяСеанса();

	Отбор = Новый Структура("ИмяМетода, ОбластьДанных");
	Отбор.ИмяМетода = "ОбновлениеТиповыхОперацийВОбластиДанных";
	Отбор.ОбластьДанных = ЗначениеРазделителяСеанса;

	СуществующиеЗадания = ОчередьЗаданий.ПолучитьЗадания(Отбор);

	Если СуществующиеЗадания.Количество() > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Отбор.ИмяМетода = "ОтключитьОтПоддержкиТиповыеОперацииВОбластиДанных";

	СуществующиеЗадания = ОчередьЗаданий.ПолучитьЗадания(Отбор);

	Если СуществующиеЗадания.Количество() > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Возврат Ложь;

КонецФункции

Процедура ЗапуститьРегЗаданиеУдаленияПоставлямойТиповойОперации()

	Отбор = Новый Структура("Метаданные", "УстановитьПометкуУдаленияРеквизитовПоставляемыхТиповыхОпераций");
	Задания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);

	Если Задания.Количество() <> 1 Тогда
	// Запись в журнал ошибки опущена.
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура("Использование", Истина);
	РегламентныеЗаданияСервер.ИзменитьЗадание(Задания[0].УникальныйИдентификатор, Параметры);

КонецПроцедуры

Процедура ОстановитьРегЗаданиеУдаленияПоставлямойТиповойОперации()

	Отбор = Новый Структура("Метаданные, Использование");
	Отбор.Метаданные = "УстановитьПометкуУдаленияРеквизитовПоставляемыхТиповыхОпераций";
	Отбор.Использование = Истина;

	Задания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);

	Если Задания.Количество() <> 1 Тогда
	// Нет запущенных заданий
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура("Использование", Ложь);
	РегламентныеЗаданияСервер.ИзменитьЗадание(Задания[0].УникальныйИдентификатор, Параметры);

КонецПроцедуры
#КонецОбласти

#Область ВерсионированиеОбъектов

// см. ВерсионированиеОбъектовПереопределяемый.ПослеРазбораВерсииОбъекта
Процедура ПослеРазбораВерсииДокумента(Ссылка, Результат) Экспорт

	ИдентификаторКолонки = УИДКолонокДопРеквизитовДляВерсионирования()
		+ "ДополнительнаяКолонка";

	Если ЗначениеЗаполнено(Результат.ДополнительныеРеквизиты) Тогда
		Для каждого СтрокаДополнительногоРеквизита Из Результат.ДополнительныеРеквизиты Цикл

			Если СтрокаДополнительногоРеквизита.Идентификатор = ИдентификаторКолонки Тогда

				ОписаниеКолонки = СтрокаДополнительногоРеквизита.Значение;

				Если ТипЗнч(ОписаниеКолонки) <> Тип("Структура")
						ИЛИ НЕ ОписаниеКолонки.Свойство("ЗначениеКолонки") Тогда
					Продолжить;
				КонецЕсли;

				ИмяТЧ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОписаниеКолонки.ТабличнаяЧасть, "ИмяТабличнойЧасти");
				ТекТЧ = Результат.ТабличныеЧасти.Получить(ИмяТЧ);

				Если ТекТЧ = Неопределено Тогда
					Результат.ТабличныеЧасти.Вставить(ИмяТЧ, Новый ТаблицаЗначений);
					ТекТЧ = Результат.ТабличныеЧасти.Получить(ИмяТЧ);
				КонецЕсли;

				ИмяКолонки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОписаниеКолонки.КолонкаТабличнойЧасти, "ИмяКолонки");
				Если ТекТЧ.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
					ТекТЧ.Колонки.Добавить(ИмяКолонки);
				КонецЕсли;

				Если ТекТЧ.Количество() >= ОписаниеКолонки.НомерСтрокиДокумента Тогда
					ТекТЧ[ОписаниеКолонки.НомерСтрокиДокумента
						- 1][ИмяКолонки] = ОписаниеКолонки.ЗначениеКолонки;
				КонецЕсли;

			КонецЕсли;

		КонецЦикла;
	КонецЕсли;

	// Обработать наименования реквизитов
	УИД = УИДКолонокДопРеквизитовДляВерсионирования();
	ДлинаУИД = СтрДлина(УИД);
	НаименованиеРеквизитаТиповаяОперация = НаименованиеРеквизитаВерсииОбъекта_ТиповаяОперация();
	УдаляемыеСтроки = Новый Массив; // строки доп. реквизитов удалить из таблицы реквизитов
	Для каждого СтрокаРеквизита Из Результат.Реквизиты Цикл

		Если СтрНачинаетсяС(СтрокаРеквизита.НаименованиеРеквизита, УИД) Тогда

			Если СтрокаРеквизита.НаименованиеРеквизита = НаименованиеРеквизитаТиповаяОперация Тогда

				СтрокаРеквизита.НаименованиеРеквизита = НСтр("ru = 'Типовая операция'");

			ИначеЕсли Сред(СтрокаРеквизита.НаименованиеРеквизита, ДлинаУИД + 1, 10) = "_Реквизит_" Тогда

				СтрокаРеквизита.НаименованиеРеквизита = СтрШаблон(
					НСтр("ru = '%1 (реквизит операции)'"),
					Сред(СтрокаРеквизита.НаименованиеРеквизита, ДлинаУИД + 11));

			ИначеЕсли Сред(СтрокаРеквизита.НаименованиеРеквизита, ДлинаУИД + 1, 9) = "_Колонка_" Тогда

				УдаляемыеСтроки.Добавить(СтрокаРеквизита);

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Для каждого Строка Из УдаляемыеСтроки Цикл

		Результат.Реквизиты.Удалить(Строка);

	КонецЦикла;

КонецПроцедуры

// см. ВерсионированиеОбъектовПереопределяемый.ПриВосстановленииВерсииОбъекта
Процедура ПриВосстановленииВерсииДокумента(Объект, ДополнительныеРеквизиты) Экспорт

	НаименованиеРеквизитаТиповаяОперация = НаименованиеРеквизитаВерсииОбъекта_ТиповаяОперация();
	Если ДополнительныеРеквизиты.Найти(НаименованиеРеквизитаТиповаяОперация, "Наименование") = Неопределено Тогда
			// Версия сохранена без данных о типовой операции, реквизитах и доп. колонках.
			// Никаких дополнительных действий не производим.
		Возврат;
	КонецЕсли;

	ДанныеОперации = РегистрыСведений.ОперацииДокументов.ПрочитатьОперацию(Объект.Ссылка);

	Если ЗначениеЗаполнено(ДанныеОперации.Операция) Тогда
		ЗаписатьРегистрОперации = Истина;
		ПерезаписьРегистраОперации = Истина;
	Иначе
		ЗаписатьРегистрОперации = Ложь;
		ПерезаписьРегистраОперации = Ложь;
	КонецЕсли;

	РегистрРеквизиты = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
	РегистрРеквизиты.Отбор.Объект.Установить(Объект.Ссылка);
	РегистрРеквизиты.Прочитать();
	Если РегистрРеквизиты.Количество() > 0 Тогда
		РегистрРеквизиты.Очистить();
		ЗаписатьРегистрРеквизиты = Истина;
		ПерезаписьРегистраРеквизиты = Истина;
	Иначе
		ЗаписатьРегистрРеквизиты = Ложь;
		ПерезаписьРегистраРеквизиты = Ложь;
	КонецЕсли;

	РегистрКолонки = РегистрыСведений.ЗначенияКолонокДополнительныхТабличныхЧастей.СоздатьНаборЗаписей();
	РегистрКолонки.Отбор.Объект.Установить(Объект.Ссылка);
	РегистрКолонки.Прочитать();
	Если РегистрКолонки.Количество() > 0 Тогда
		РегистрКолонки.Очистить();
		ЗаписатьРегистрКолонки = Истина;
		ПерезаписьРегистраКолонки = Истина;
	Иначе
		ЗаписатьРегистрКолонки = Ложь;
		ПерезаписьРегистраКолонки = Ложь;
	КонецЕсли;

	УИД = УИДКолонокДопРеквизитовДляВерсионирования();
	ДлинаУИД = СтрДлина(УИД);
	НаименованиеРеквизитаОтветственный = НаименованиеРеквизитаВерсииОбъекта_ОтветственныйИсполнитель();
	Для каждого СтрокаРеквизита Из ДополнительныеРеквизиты Цикл

		Если НЕ СтрНачинаетсяС(СтрокаРеквизита.Наименование, УИД) Тогда

			Продолжить;

		КонецЕсли;

		Если СтрокаРеквизита.Наименование = НаименованиеРеквизитаТиповаяОперация Тогда
			// типовая операция
			Если ЗначениеЗаполнено(СтрокаРеквизита.Значение) Тогда
				ДанныеОперации.Документ = Объект.Ссылка;
				ДанныеОперации.Операция = СтрокаРеквизита.Значение;
				ДанныеОперации.Организация = Объект.Организация;

				ЗаписатьРегистрОперации = Истина;
			Иначе
				Если ЗначениеЗаполнено(ДанныеОперации.Операция) Тогда
					ДанныеОперации = РегистрыСведений.ОперацииДокументов.ДанныеДляЗаписи(Объект.Ссылка);
					ЗаписатьРегистрОперации = Истина;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли СтрокаРеквизита.Наименование = НаименованиеРеквизитаОтветственный Тогда
			Если ДанныеОперации.ОтветственныйИсполнитель <> СтрокаРеквизита.Значение Тогда
				ДанныеОперации.ОтветственныйИсполнитель = СтрокаРеквизита.Значение;
				ЗаписатьРегистрОперации = Истина;
			КонецЕсли;
		ИначеЕсли Сред(СтрокаРеквизита.Наименование, ДлинаУИД + 1, 10) = "_Реквизит_" Тогда
			// дополнительные реквизиты операции
			НоваяЗаписьР = РегистрРеквизиты.Добавить();
			НоваяЗаписьР.Объект = Объект.Ссылка;
			НоваяЗаписьР.РеквизитОперации = СтрокаРеквизита.Идентификатор;
			НоваяЗаписьР.Значение = СтрокаРеквизита.Значение;

			ЗаписатьРегистрРеквизиты = Истина

		ИначеЕсли Сред(СтрокаРеквизита.Наименование, ДлинаУИД + 1, 9) = "_Колонка_" Тогда
			// дополнительные колонки
			ОписаниеКолонки = Новый Структура("ТабличнаяЧасть,КолонкаТабличнойЧасти,НомерСтрокиДокумента,ЗначениеКолонки");
			ЗаполнитьЗначенияСвойств(ОписаниеКолонки, СтрокаРеквизита.Значение);

			Если НЕ ЗначениеЗаполнено(ОписаниеКолонки.ТабличнаяЧасть)
					ИЛИ НЕ ЗначениеЗаполнено(ОписаниеКолонки.КолонкаТабличнойЧасти) Тогда

				Продолжить;
			КонецЕсли;

			НоваяЗаписьК = РегистрКолонки.Добавить();
			НоваяЗаписьК.Объект = Объект.Ссылка;
			НоваяЗаписьК.ТабличнаяЧасть = ОписаниеКолонки.ТабличнаяЧасть;
			НоваяЗаписьК.КолонкаТабличнойЧасти = ОписаниеКолонки.КолонкаТабличнойЧасти;
			НоваяЗаписьК.НомерСтрокиДокумента = ОписаниеКолонки.НомерСтрокиДокумента;
			НоваяЗаписьК.Значение = ОписаниеКолонки.ЗначениеКолонки;

			ЗаписатьРегистрКолонки = Истина;

		КонецЕсли;

	КонецЦикла;

	Если ЗаписатьРегистрОперации Тогда
		РегистрыСведений.ОперацииДокументов.ЗаписатьОперацию(Объект.Ссылка, ДанныеОперации, ПерезаписьРегистраОперации);
	КонецЕсли;

	Если ЗаписатьРегистрРеквизиты Тогда
		РегистрРеквизиты.Записать(ПерезаписьРегистраРеквизиты);
	КонецЕсли;

	Если ЗаписатьРегистрКолонки Тогда
		РегистрКолонки.Записать(ПерезаписьРегистраКолонки);
	КонецЕсли;

КонецПроцедуры

// см. ВерсионированиеОбъектовПереопределяемый.ПриПодготовкеДанныхОбъекта
//
// Параметры:
//  Объект - ДокументОбъект - версионируемый объект:
//   * ДополнительныеСвойства - Структура:
//    ** ДанныеАвтоПроведения - Структура
//    ** ДанныеТиповойОперации - см. НовыйДанныеТиповойОперацииВерсионирование  
//  ДополнительныеРеквизиты - ТаблицаЗначений - коллекция дополнительных реквизитов, которые требуется сохранить вместе
//                                              с версией объекта:
//   * Идентификатор - Произвольный - уникальный идентификатор реквизита. Требуется при восстановлении из версии
//                                    объекта в случае, когда значение реквизита хранится отдельно от объекта.
//   * Наименование - Строка - название реквизита.
//   * Значение - Произвольный - значение реквизита.
Процедура ПриПодготовкеДанныхОбъекта(Объект, ДополнительныеРеквизиты) Экспорт

	Если НЕ ДокументПроводитсяПоРегиструБухгалтерии(Объект) Тогда
		Возврат;
	КонецЕсли;

	УИД = УИДКолонокДопРеквизитовДляВерсионирования();

	Если Объект.ДополнительныеСвойства.Свойство("ДанныеАвтоПроведения") Тогда
		ДанныеАвтоПроведения = Объект.ДополнительныеСвойства.ДанныеАвтоПроведения;
		ТиповаяОперация = ДанныеАвтоПроведения.ТиповаяОперация;
		ТаблицаЗначенийДопРеквизитов = ДанныеАвтоПроведения.ТаблицаЗначенийДопРеквизитов;
		ОтветственныйИсполнитель = ДанныеАвтоПроведения.ОтветственныйИсполнитель;

	ИначеЕсли Объект.ДополнительныеСвойства.Свойство("ДанныеТиповойОперации") Тогда

		ДанныеТиповойОперации = Объект.ДополнительныеСвойства.ДанныеТиповойОперации;
		ТиповаяОперация = ДанныеТиповойОперации.ТиповаяОперация;
		ТаблицаЗначенийДопРеквизитов = ДанныеТиповойОперации.ТаблицаЗначенийДопРеквизитов;
		ОтветственныйИсполнитель = ДанныеТиповойОперации.ОтветственныйИсполнитель;

	Иначе
		ТиповаяОперация = Неопределено;
		ДополнительныеРеквизитыОперации = Неопределено;
		ТаблицаЗначенийДопРеквизитов = Неопределено;
		СформироватьСтруктуруДопРеквизитовИзБазы(Объект, ТиповаяОперация, ДополнительныеРеквизитыОперации,
			ТаблицаЗначенийДопРеквизитов, Истина);
		ОтветственныйИсполнитель = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеРеквизитыОперации,
			"ОтветственныйИсполнитель");
	КонецЕсли;

	Если Объект.ДополнительныеСвойства.Свойство("ДанныеДополнительныхТабЧастей") Тогда
		ДанныеДополнительныхТабЧастей = Объект.ДополнительныеСвойства.ДанныеДополнительныхТабЧастей;
	Иначе
		ДанныеДополнительныхТабЧастей = ПолучитьСохраненныеЗначенияДополнительныхТабличныхЧастей(Объект);
	КонецЕсли;

	Если ТипЗнч(ТиповаяОперация) = Тип("Структура")
			И ТиповаяОперация.Свойство("Операция") Тогда
		ТиповаяОперация = ТиповаяОперация.Операция;
	КонецЕсли;

	// Типовая операция
	// Значение пишем всегда, даже если оно пустое.
	// Потом эта запись используется для анализа необходимости восстановления связанных регистров
	НоваяСтрока = ДополнительныеРеквизиты.Добавить();
	НоваяСтрока.Идентификатор = УИД + "ТиповаяОперация";
	НоваяСтрока.Наименование = НаименованиеРеквизитаВерсииОбъекта_ТиповаяОперация();
	НоваяСтрока.Значение = ТиповаяОперация;
	
	Если ЗначениеЗаполнено(ТиповаяОперация) Тогда
		НоваяСтрока = ДополнительныеРеквизиты.Добавить();
		НоваяСтрока.Идентификатор = УИД + "ОтветственныйИсполнитель";
		НоваяСтрока.Наименование = НаименованиеРеквизитаВерсииОбъекта_ОтветственныйИсполнитель();
		НоваяСтрока.Значение = ОтветственныйИсполнитель;
	КонецЕсли;

	// Дополнительные реквизиты
	Если ТаблицаЗначенийДопРеквизитов <> Неопределено Тогда
		Для Каждого ДопРеквизит Из ТаблицаЗначенийДопРеквизитов Цикл

			НоваяСтрока = ДополнительныеРеквизиты.Добавить();
			НоваяСтрока.Идентификатор = ДопРеквизит.РеквизитОперации;
			НоваяСтрока.Наименование = УИД + "_Реквизит_"
				+ ДопРеквизит.НаименованиеРеквизита;
			НоваяСтрока.Значение = ДопРеквизит.Значение;

		КонецЦикла;
	КонецЕсли;

	// Дополнительные колонки табличных частей
	Если ДанныеДополнительныхТабЧастей <> Неопределено Тогда
		Для Каждого ДопКолонка Из ДанныеДополнительныхТабЧастей Цикл

			НоваяСтрока = ДополнительныеРеквизиты.Добавить();
			НоваяСтрока.Идентификатор = УИД + "ДополнительнаяКолонка";
			НоваяСтрока.Наименование = УИД + "_Колонка_"
				+ ДопКолонка.НаименованиеКолонки;
			НоваяСтрока.Значение = Новый Структура("ТабличнаяЧасть,КолонкаТабличнойЧасти,НомерСтрокиДокумента,ЗначениеКолонки");
			НоваяСтрока.Значение.ТабличнаяЧасть = ДопКолонка.ТабличнаяЧасть;
			НоваяСтрока.Значение.КолонкаТабличнойЧасти = ДопКолонка.КолонкаТабличнойЧасти;
			НоваяСтрока.Значение.НомерСтрокиДокумента = ДопКолонка.НомерСтрокиДокумента;
			НоваяСтрока.Значение.ЗначениеКолонки = ДопКолонка.Значение;

		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиПодписокНаСобытия

// Подписка ПодготовитьТаблицуПроводок (событие = ПередЗаписью)
//
Процедура ПодготовитьТаблицуПроводокПередЗаписью(Источник, Отказ, РежимЗаписи,
		РежимПроведения) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда

		Возврат;

	КонецЕсли;

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение
			И РегистрыСведений.ОперацииДокументов.ПрочитатьОперацию(Источник.Ссылка).РучнаяКорректировка Тогда

		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Проведение документа %1.
			|Бухгалтерские проводки не изменены, т.к. для документа установлен режим ручной корректировки проводок.'"), Источник.Ссылка), Источник.Ссылка, , , Отказ);
		Источник.ДополнительныеСвойства.Вставить("РучнаяКорректировка", Истина);

	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		РегистрыСведений.ОперацииДокументов.ОбновитьЗаписьПриОтменеПроведения(Источник.Ссылка);
	КонецЕсли;

	ПравоДоступаЕПСБУИзменение = ОбщегоНазначенияБГУПовтИсп.ЕстьПравоДоступа("Изменение", "РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
	Если Не ПравоДоступаЕПСБУИзменение И ЕстьПроводкиДокумента(Источник.Ссылка) Тогда
		ТекстИсключения = НСтр("ru = 'Нарушение прав доступа.
			|Пользователю без права формирования проводок запрещено перепроводить документ, у которого сформированы проводки'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	Если Источник.ДополнительныеСвойства.Свойство("ПравоДоступаЕПСБУИзменение") Тогда
		Источник.ДополнительныеСвойства.ПравоДоступаЕПСБУИзменение = ПравоДоступаЕПСБУИзменение;
	Иначе
		Источник.ДополнительныеСвойства.Вставить("ПравоДоступаЕПСБУИзменение", ПравоДоступаЕПСБУИзменение);
	КонецЕсли;

	ПередЗаписьюОбъекта(Источник, Отказ, РежимЗаписи, РежимПроведения);
КонецПроцедуры

// Подписка ЗаписатьБухгалтерскуюОперацию (событие = ПриЗаписи)
//
Процедура ЗаписатьБухгалтерскуюОперациюПриЗаписи(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	//  При проведении устанавливается привелигированный режим, поэтому
	// определить имеет ли пользователь право измеения регистра Рабочие счета
	// надо заранее
	//
	НаборЗаписейРБ = Источник.Движения.Найти("ЖурналПроводокЕПСБУ");
	Если НЕ НаборЗаписейРБ = Неопределено Тогда
		НаборЗаписейРБ.ДополнительныеСвойства.Вставить("ЕстьПравоИзмененияРабочихСчетов", ПравоДоступа("Изменение", Метаданные.РегистрыСведений.РабочиеСчета));
	КонецЕсли;

	Если Источник.ДополнительныеСвойства.Свойство("РучнаяКорректировка")
			И Источник.ДополнительныеСвойства.РучнаяКорректировка = Истина Тогда
		Возврат;
	КонецЕсли;

	ПриЗаписиОбъекта(Источник, Отказ);
	
КонецПроцедуры

// Подписка ЗаписатьТаблицуПроводок (событие = ОбработкаПроведения)
//
Процедура ЗаписатьТаблицуПроводокОбработкаПроведения(Источник, Отказ,
		РежимПроведения) Экспорт
	Если Не ДокументПроводитсяПоРегиструБухгалтерии(Источник) Тогда
		Возврат;
	КонецЕсли;

	Если Источник.ДополнительныеСвойства.Свойство("РучнаяКорректировка")
			И Источник.ДополнительныеСвойства.РучнаяКорректировка = Истина Тогда

		Источник.Движения.ЖурналПроводокЕПСБУ.Прочитать();

		Возврат;
	КонецЕсли;

	ПравоДоступаЕПСБУИзменение = Неопределено;
	Если НЕ Источник.ДополнительныеСвойства.Свойство("ПравоДоступаЕПСБУИзменение", ПравоДоступаЕПСБУИзменение) Тогда
		ПравоДоступаЕПСБУИзменение = Истина;
	КонецЕсли;
	Если НЕ ПравоДоступаЕПСБУИзменение Тогда
		Если Источник.Движения.Найти("РегистрБухгалтерии.ЖурналПроводокЕПСБУ") <> Неопределено Тогда
			Источник.Движения.ЖурналПроводокЕПСБУ.Прочитать();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Источник.ОбменДанными.Загрузка Тогда

		Возврат;

	КонецЕсли;

	ЭтоБухОперация = Ложь;
	ЭтоСторно = Ложь;
	Если НЕ Источник.ДополнительныеСвойства.ДанныеАвтоПроведения.Свойство("ЭтоБухОперация", ЭтоБухОперация) Тогда
		ЭтоБухОперация = Ложь;
	КонецЕсли;
	Если НЕ Источник.ДополнительныеСвойства.ДанныеАвтоПроведения.Свойство("ЭтоСторно", ЭтоСторно) Тогда
		ЭтоСторно = Ложь;
	КонецЕсли;

	Если ЭтоБухОперация ИЛИ ЭтоСторно Тогда

		Возврат;

	КонецЕсли;

	ОбработкаПроведения(Источник, Отказ, РежимПроведения);
КонецПроцедуры
#КонецОбласти

#Область Прочие

Функция ИндексКартинкиСостояниеПоддержки(СостояниеПоддержки) Экспорт

	Если Не ЗначениеЗаполнено(СостояниеПоддержки) Тогда

		Возврат -1;
	ИначеЕсли СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда

		Возврат 0;
	ИначеЕсли СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки Тогда

		Возврат 1;
	ИначеЕсли СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки Тогда

		Возврат 2;
	Иначе

		ВызватьИсключение "Неизвестное состояние поддержки";
	КонецЕсли;

КонецФункции

Функция ПрочитатьЗначениеРеквизитаИзУзлаФайла(ФайлОпераций) Экспорт
	
	ТипЗнч = ФайлОпераций.ПолучитьАтрибут("ТипЗнч");
	
	Если ТипЗнч = Неопределено Тогда
		ФайлОпераций.Прочитать();
		Если ФайлОпераций.Имя = "ЗначениеРеквизита" Тогда
			ТипЗнч = ФайлОпераций.ПолучитьАтрибут("ТипЗнч");
		ИначеЕсли ФайлОпераций.Имя = "ОписаниеТипов" Тогда
			ТипЗнч = "ОписаниеТипов";
		Иначе
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	
	ФайлОпераций.Прочитать();
	Если ТипЗнч="Строка" Тогда
		ЗначениеРеквизита = ФайлОпераций.Значение;
	ИначеЕсли ТипЗнч="Дата" Тогда
		Если ФайлОпераций.Имя = "dateTime" Тогда
			ЗначениеРеквизита = ПрочитатьXML(ФайлОпераций);
		Иначе
			ЗначениеРеквизита = XMLЗначение(Тип("Дата"), ФайлОпераций.Значение);
		КонецЕсли;
	ИначеЕсли ТипЗнч = "Стандартная дата начала" Тогда
		ЗначениеРеквизита = Новый СтандартнаяДатаНачала(ПрочитатьXML(ФайлОпераций));
	ИначеЕсли ТипЗнч = "Булево" Тогда
		ЗначениеРеквизита = ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповБулево().ПривестиЗначение(ФайлОпераций.Значение);
	ИначеЕсли ТипЗнч = "Число" Тогда
		Если ФайлОпераций.Имя = "decimal" Тогда
			ФайлОпераций.Прочитать();
		КонецЕсли;
		ОписаниеТиповЧисло = Новый ОписаниеТипов("Число");
		ЗначениеРеквизита = ОписаниеТиповЧисло.ПривестиЗначение(ФайлОпераций.Значение);
	ИначеЕсли ТипЗнч<>"ОписаниеТипов" Тогда
		Если ФайлОпераций.ТипУзла = ТипУзлаXML.Текст Тогда
			ОписаниеТипа = Новый ОписаниеТипов("Булево");
			ЗначениеРеквизита = ОписаниеТипа.ПривестиЗначение(ФайлОпераций.Значение);
		Иначе
			ЗначениеРеквизита = ПрочитатьXML(ФайлОпераций);
		КонецЕсли;
	Иначе
		ТипЗначения = ПрочитатьXML(ФайлОпераций);
		ПолноеИмя = Метаданные.НайтиПоТипу(ТипЗначения).ПолноеИмя();
		ИмяОбъекта = СтрРазделить(ПолноеИмя, ".")[1];
		ФайлОпераций.Прочитать();
		
		Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
			ФайлОпераций.Прочитать();
			Если ЗначениеЗаполнено(ФайлОпераций.Значение) Тогда
				ЗначениеРеквизита = Перечисления[ИмяОбъекта][ФайлОпераций.Значение];
			Иначе
				ЗначениеРеквизита = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя).ПустаяСсылка();
			КонецЕсли;
		ИначеЕсли ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
			// Со счетами могут быть выгружены сроки действия счетов
			ДатаНачалаДействияИзФайла = ФайлОпераций.ПолучитьАтрибут("ДатаНачалаДействия");
			ДатаОкончанияДействияИзФайла = ФайлОпераций.ПолучитьАтрибут("ДатаОкончанияДействия");
			
			ДатаНачалаДействия = ?(ДатаНачалаДействияИзФайла = Неопределено, Дата(1,1,1), XMLЗначение(Тип("Дата"), ДатаНачалаДействияИзФайла));
			ДатаОкончанияДействия = ?(ДатаОкончанияДействияИзФайла = Неопределено, Дата(1,1,1), XMLЗначение(Тип("Дата"), ДатаОкончанияДействияИзФайла));
			
			ФайлОпераций.Прочитать();
			КодСчета = ФайлОпераций.Значение;
			
			Если ЗначениеЗаполнено(КодСчета) Тогда
			
				ЗначениеРеквизита = ПолучитьСчетПоКодуИПериодуДействия(КодСчета, ДатаНачалаДействия, ДатаОкончанияДействия);
				Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
					
					Если ЗначениеЗаполнено(ДатаНачалаДействия) ИЛИ ЗначениеЗаполнено(ДатаОкончанияДействия) Тогда
						ТекстОшибки = НСтр("ru = 'Не найден счет с кодом %КодСчета% и сроком действия с %ДатаНачалаДействия% по %ДатаОкончанияДействия%.'");
						ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ДатаНачалаДействия%", Формат(ДатаНачалаДействия, "ДЛФ=D"));
						ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ДатаОкончанияДействия%", Формат(ДатаОкончанияДействия, "ДЛФ=D"));
					Иначе
						ТекстОшибки = НСтр("ru = 'Не найден счет с кодом %КодСчета%, с любым сроком действия.'");
					КонецЕсли;
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%КодСчета%", КодСчета);
					
					ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
					УровеньЖурналаРегистрации.Предупреждение, Метаданные.ПланыСчетов.ЕПСБУ,,
					ТекстОшибки);
				КонецЕсли;
			Иначе
				ЗначениеРеквизита = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя).ПустаяСсылка();
			КонецЕсли;
		Иначе
			Предопределенный = ?(ФайлОпераций.ПолучитьАтрибут("Предопределенный")="1", Истина, Ложь);
			Код = ФайлОпераций.ПолучитьАтрибут("Код");
			Наименование = ФайлОпераций.ПолучитьАтрибут("Наименование");
			ФайлОпераций.Прочитать();
			
			Если ЗначениеЗаполнено(Код) Или ЗначениеЗаполнено(Наименование) Или ЗначениеЗаполнено(ФайлОпераций.Значение) Тогда
			
				Если Предопределенный Тогда
					ЗначениеРеквизита = ПредопределенноеЗначение(ФайлОпераций.Значение);
				Иначе
					Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
						Если Метаданные.НайтиПоТипу(ТипЗначения).ОсновноеПредставление = 
							Метаданные.СвойстваОбъектов.ОсновноеПредставлениеСправочника.ВВидеКода Тогда
							ЗначениеРеквизита = Справочники[ИмяОбъекта].НайтиПоКоду(Код);
						Иначе
							ЗначениеРеквизита = Справочники[ИмяОбъекта].НайтиПоНаименованию(Наименование);
						КонецЕсли;
					ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
						ЗначениеРеквизита = ПланыВидовХарактеристик[ИмяОбъекта].НайтиПоНаименованию(Наименование);	
					КонецЕслИ;
				КонецЕсли;
			Иначе
				ЗначениеРеквизита = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя).ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;
	Возврат ЗначениеРеквизита;

КонецФункции

Функция ПолучитьСчетПоКодуИПериодуДействия(КодСчета, Знач ДатаНачалаДействия, ДатаОкончанияДействия)
	
	ИспользоватьОтборПоПериоду = ЗначениеЗаполнено(ДатаНачалаДействия)
		ИЛИ ЗначениеЗаполнено(ДатаОкончанияДействия);
		
	Если ИспользоватьОтборПоПериоду Тогда
		Если НЕ ЗначениеЗаполнено(ДатаНачалаДействия) Тогда
			// ДатаНачалаДействия не должна быть Неопределено
			ДатаНачалаДействия = '00010101';
		КонецЕсли;
	Иначе
		ДатаНачалаДействия = Неопределено;
	КонецЕсли;
	
	Если ДатаНачалаДействия = Неопределено Тогда
		Счет = БухгалтерскийУчет.СчетПоКоду(КодСчета);
	Иначе
		Счет = БухгалтерскиеОперацииПовтИспНаВремяСеанса.СчетПоКодуИНачалуДействия(КодСчета, ДатаНачалаДействия);
	КонецЕсли;
	Возврат Счет;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьИсточникДанныхПоТаблицеДокумента(ОписаниеТЧ, НастройкаДополнительныхТабЧастей, ИсточникиДанных,
		ДокументОбъект, ДанныеДополнительныхТабЧастей, ОбщиеДанныеТаблицы)
	
	ИмяТЧ = ОписаниеТЧ.Имя;	
	ТекДопТабЧасть = НастройкаДополнительныхТабЧастей.Получить(ИмяТЧ);
	Префикс = ПрефиксКолонкиИсточникаДанных(ИмяТЧ);
	ТабЧасть = ИсточникиДанных[ИмяТЧ];
	
	ДобавленныеПользователемРеквизиты = Новый Массив;
	ЗаполняемыеКолонки = Новый Массив;

	// Подготовить таблицу документа для переноса. Колонки переименовываются как в таблице источника данных.
	СоставТаблицы = ДокументОбъект[ИмяТЧ].Выгрузить(); // ТаблицаЗначений
	Для каждого РеквизитТЧ Из ОписаниеТЧ.Реквизиты Цикл
		Если РеквизитТЧ.Предопределенный Тогда
			КолонкаТаблицы = СоставТаблицы.Колонки.Найти(РеквизитТЧ.Имя);
			Если КолонкаТаблицы <> Неопределено Тогда
				НовоеИмяКолонки = Префикс + РеквизитТЧ.Имя;
				КолонкаТаблицы.Имя = НовоеИмяКолонки;
				ЗаполняемыеКолонки.Добавить(НовоеИмяКолонки);
			КонецЕсли;
		Иначе
			ДобавленныеПользователемРеквизиты.Добавить(РеквизитТЧ);
		КонецЕсли;
	КонецЦикла;
	ЗаполняемыеКолонкиСтрокой = СтрСоединить(ЗаполняемыеКолонки, ",");
	
	// Перенести таблицу документа в таблицу источника данных.
	// Колонки, добавленные через механизм дополнительных колонок, заполняются дополнительным вложенным циклом.
	Для каждого СтрокаОбъекта Из СоставТаблицы Цикл

		НоваяСтрока = ТабЧасть.Добавить();
		НоваяСтрока.НомерСтроки = СтрокаОбъекта.НомерСтроки;
		НоваяСтрока.ИмяТабличнойЧасти = ИмяТЧ;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОбъекта, ЗаполняемыеКолонкиСтрокой);
		Для каждого РеквизитТЧ Из ДобавленныеПользователемРеквизиты Цикл

			СтрокиДопРеквизитов = ДанныеДополнительныхТабЧастей.НайтиСтроки(
				Новый Структура("ТабличнаяЧасть, НомерСтрокиДокумента, ИмяКолонкиТабличнойЧасти",
					ТекДопТабЧасть.СсылкаТабличнойЧасти, СтрокаОбъекта.НомерСтроки, РеквизитТЧ.Имя));

			Если СтрокиДопРеквизитов.Количество() > 0 Тогда
				НоваяСтрока[Префикс + РеквизитТЧ.Имя] = СтрокиДопРеквизитов[0].Значение;
			КонецЕсли;
		КонецЦикла;

		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОбщиеДанныеТаблицы);

	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьВсеИсточникиДанныхПоТаблицамДокумента(ТабличныеЧасти, НастройкаДополнительныхТабЧастей, ИсточникиДанных,
		ДокументОбъект, ДанныеДополнительныхТабЧастей, ОбщиеДанныеТаблицы)
		
	Для каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		ОписаниеТЧ = ТабличнаяЧасть.Значение;

		Если Не ОписаниеТЧ.Предопределенный Тогда
			Продолжить;
		КонецЕсли;

		ЗаполнитьИсточникДанныхПоТаблицеДокумента(
			ОписаниеТЧ,
			НастройкаДополнительныхТабЧастей,
			ИсточникиДанных,
			ДокументОбъект,
			ДанныеДополнительныхТабЧастей,
			ОбщиеДанныеТаблицы);
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьПараметрыВыбораОтветственногоИсполнителя(ИдентификаторДокумента, Форма)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЦентрализованнуюБухгалтерию") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаОтветственныйИсполнитель();
	НастройкиЗаполнения = РегистрыСведений.НастройкиВыбораОтветственныхСотрудниковЦБ.НастройкиПоОбъекту(
		ИдентификаторДокумента, ИмяРеквизита);
	Если НастройкиЗаполнения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИмяЭлемента = БухгалтерскиеОперацииКлиентСервер.ИмяЭлементаФормыДополнительногоРеквизита(Форма, ИмяРеквизита);
	ЭлементФормы = Форма.Элементы.Найти(ИмяЭлемента);
	Если ЭлементФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнениеРеквизитовОбъектов.УстановитьПараметрыВыбораСотрудников(ЭлементФормы, НастройкиЗаполнения[0].СпособВыбора);		
КонецПроцедуры

Функция ОтветственныйИсполнительИзФормы(Форма)
	Результат = Новый Структура(БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаОтветственныйИсполнитель());
	ЗаполнитьЗначенияСвойств(Результат, Форма);
	Возврат Результат[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаОтветственныйИсполнитель()];
КонецФункции

#Область ВерсионированиеОбъектов

Функция УИДКолонокДопРеквизитовДляВерсионирования()

	Возврат "32c2d012-f175-4bd7-8619-d555f7067a95";

КонецФункции

// Новый данные типовой операции версионирование.
// 
// Параметры:
//  Операция - СправочникСсылка.ТиповыеОперации
// 
// Возвращаемое значение:
//  Структура - Новый данные типовой операции версионирование:
// * ТиповаяОперация - СправочникСсылка.ТиповыеОперации 
// * ТаблицаЗначенийДопРеквизитов - см. ПустаяТаблицаЗначенияДопРеквизитов 
// * ОтветственныйИсполнитель - СправочникСсылка.Сотрудники - 
Функция НовыйДанныеТиповойОперацииВерсионирование(Операция)
	Результат = Новый Структура;
	Результат.Вставить("ТиповаяОперация", Операция);
	Результат.Вставить("ТаблицаЗначенийДопРеквизитов", ПустаяТаблицаЗначенияДопРеквизитов(Истина));
	Результат.Вставить("ОтветственныйИсполнитель", Справочники.Сотрудники.ПустаяСсылка());
	Возврат Результат;
КонецФункции

Функция НаименованиеРеквизитаВерсииОбъекта_ТиповаяОперация()
	Возврат УИДКолонокДопРеквизитовДляВерсионирования() + "Типовая операция";
КонецФункции

Функция НаименованиеРеквизитаВерсииОбъекта_ОтветственныйИсполнитель()
	Возврат УИДКолонокДопРеквизитовДляВерсионирования() + "_Реквизит_Ответственный исполнитель";
КонецФункции

#КонецОбласти

#Область ОбработчикиПодписокНаСобытия

// Процедура вызывается из подписки на событие.
// Процедура формирует таблицу проводок. Если реквизиты операции есть в ДополнительныхСвойствах объекта,
// то для вычисления таблицы проводок используются переданные реквизиты, иначе берутся записанные в регистр значения.
// Процедура устанавливает только таблицу проводок. Остальные реквизиты остаются без изменения, как пришли.
//
Процедура ПередЗаписьюОбъекта(ТекущийОбъект, Отказ, РежимЗаписи, РежимПроведения)

	ПроведениеСервер.УстановитьРежимПроведения(ТекущийОбъект, РежимЗаписи, РежимПроведения);

	ТекущийОбъект.ДополнительныеСвойства.Вставить("РежимЗаписи",     РежимЗаписи);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("РежимПроведения", РежимПроведения);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ЭтоНовый",        ТекущийОбъект.ЭтоНовый());

	Если НЕ ТекущийОбъект.ДополнительныеСвойства.Свойство("ЗаписьИзФормыДокумента")
			И РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда

		ТекущийОбъект.ДополнительныеСвойства.Вставить("МеткаВремениПередЗаписью",
													  ОценкаПроизводительности.НачатьЗамерВремени());
	КонецЕсли;
	
	Если ТекущийОбъект.ЭтоНовый() Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ЗаписатьДатуПроведенияПриЗаписи", Истина);
	Иначе
		// Если документ записан ранее, то дата проведения записывается в регистр до формирования данных проведения.
		ЗаписатьДатуПроведенияДокумента(ТекущийОбъект);
	КонецЕсли;

КонецПроцедуры

// Процедура вызывается из подписки на событие при записи.
// Процедура записывает типовую операцию документа и дополнительные реквизиты операции.
//
Процедура ПриЗаписиОбъекта(ТекущийОбъект, Отказ)
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ТекущийОбъект.ДополнительныеСвойства, "ЗаписатьДатуПроведенияПриЗаписи", Ложь) Тогда
		// Если документ новый, то дата проведения записывается в регистр после присвоения ссылки.
		ЗаписатьДатуПроведенияДокумента(ТекущийОбъект);
	КонецЕсли;

	Если ТекущийОбъект.ДополнительныеСвойства.Свойство("ДанныеДополнительныхТабЧастей") Тогда
		ЗаписатьДанныеДополнительныхТабЧастей(ТекущийОбъект.Ссылка,
											  ТекущийОбъект.ДополнительныеСвойства.ДанныеДополнительныхТабЧастей);
	КонецЕсли;
	
	Если ТипЗнч(ТекущийОбъект.Ссылка) = Тип("ДокументСсылка.Сторно") Тогда
		ИнициализироватьБухгалтерскиеОперации(ТекущийОбъект);
		Возврат;
	КонецЕсли;

	Если НЕ ПроверитьНеобходимостьДействийПриЗаписиОбъекта(ТекущийОбъект) Тогда
		Возврат;
	КонецЕсли;

	ДанныеАвтоПроведения = ТекущийОбъект.ДополнительныеСвойства.ДанныеАвтоПроведения;

	ДанныеДляЗаписи = ЗаполнитьДанныеДляЗаписиОбъекта(ТекущийОбъект);
	Если НЕ ДанныеДляЗаписи.СформироватьПроводки И НЕ ДанныеДляЗаписи.ЗаписатьОперацию Тогда
		Возврат;
	КонецЕсли;

	Если ДанныеДляЗаписи.ПроверитьКонтролируемыеРеквизиты Тогда
		Объект = ТекущийОбъект.Ссылка.ПолучитьОбъект();
		Если НЕ КонтролируемыеРеквизитыНеИзменены(ТекущийОбъект, Объект) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	РеквизитыБухгалтерскойОперации = Новый Структура("Операция, Дата, Организация", ДанныеДляЗаписи.ТиповаяОперация);

	Если ДанныеДляЗаписи.СформироватьПроводки Тогда

		ВычислитьПроводкиПриЗаписиОбъекта(ТекущийОбъект, ДанныеДляЗаписи, РеквизитыБухгалтерскойОперации, Отказ);

		Если Отказ Тогда
			Возврат;
		КонецЕсли;

		ДанныеАвтоПроведения.ТаблицаПроводок = ДанныеДляЗаписи.ТаблицаПроводок;
	ИначеЕсли ДанныеДляЗаписи.ЗаписатьОперацию И ЗначениеЗаполнено(ДанныеДляЗаписи.ТиповаяОперация) Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыБухгалтерскойОперации,
								ПолучитьДатуИОрганизациюОперации(ТекущийОбъект,
																 ДанныеДляЗаписи.ТиповаяОперация),
																 "Дата, Организация");
	ИначеЕсли ЗначениеЗаполнено(ДанныеАвтоПроведения.ТиповаяОперация) Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыБухгалтерскойОперации,
								ПолучитьДатуИОрганизациюОперации(ТекущийОбъект,
																 ДанныеАвтоПроведения.ТиповаяОперация),
																 "Дата, Организация");
	КонецЕсли;

	ДанныеАвтоПроведения.ФормироватьПроводки = ДанныеДляЗаписи.СформироватьПроводки;
	Если ДанныеАвтоПроведения.ФормироватьПроводки Тогда
		Если ДанныеАвтоПроведения.ВызовИзФормы
				И ЗначениеЗаполнено(ДанныеАвтоПроведения.ОтветственныйИсполнитель) Тогда
			ОтветственныйИсполнитель = ДанныеАвтоПроведения.ОтветственныйИсполнитель;
		Иначе
			ОтветственныйИсполнитель = ДанныеДляЗаписи.ОтветственныйИсполнитель;
		КонецЕсли;
		ЗаполнитьОтветственногоИсполнителяДляЗаписи(ДанныеДляЗаписи, ДанныеАвтоПроведения.ИдентификаторДокумента,
			ОтветственныйИсполнитель, РеквизитыБухгалтерскойОперации, Отказ);
		Если ТекущийОбъект.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение
				И Не ЗначениеЗаполнено(ДанныеДляЗаписи.ОтветственныйИсполнитель) Тогда
			Если ЗапретитьПроведениеБезУказанияОтветственного() Тогда
				ОбщегоНазначения.СообщитьПользователю(
					НСтр("ru = 'Не заполнено поле ""Бухгалтер"" в реквизитах типовой операции'"),
					ТекущийОбъект.Ссылка,
					БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаОтветственныйИсполнитель(),
					,
					Отказ);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ДанныеДляЗаписи.ОтветственныйИсполнитель = Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;

	Если ТипЗнч(ДанныеАвтоПроведения.ТаблицаПроводок) = Тип("ТаблицаЗначений") Тогда
		ДанныеАвтоПроведения.ТаблицаБлокировок = СобратьТаблицуБлокировок(ДанныеАвтоПроведения.ТаблицаПроводок);
	КонецЕсли;

	Если ЗначениеЗаполнено(ДанныеДляЗаписи.ТиповаяОперация) Тогда

		ЗаписатьТиповуюОперациюДокумента(ТекущийОбъект, РеквизитыБухгалтерскойОперации, ДанныеДляЗаписи);

		Если ТипЗнч(ДанныеДляЗаписи.ТаблицаЗначенийДопРеквизитов) = Тип("ТаблицаЗначений") Тогда

			ЗаписатьЗначенияДополнительныхРеквизитовИзТаблицы(ТекущийОбъект.Ссылка,
															  ДанныеДляЗаписи.ТаблицаЗначенийДопРеквизитов);

		ИначеЕсли ТипЗнч(ДанныеДляЗаписи.ДополнительныеРеквизиты) = Тип("Структура") Тогда

			ТекТиповаяОперация = ?(ЗначениеЗаполнено(ДанныеДляЗаписи.ТиповаяОперация),
									ДанныеДляЗаписи.ТиповаяОперация,
									БухгалтерскаяОперацияДокумента(ТекущийОбъект.Ссылка));

			ЗаписатьЗначенияДополнительныхРеквизитовИзСтруктуры(ТекущийОбъект.Ссылка,
																ДанныеДляЗаписи.ДополнительныеРеквизиты,
																ТекТиповаяОперация);

		КонецЕсли;
	Иначе
		РегистрыСведений.ОперацииДокументов.ЗаписатьОперацию(ТекущийОбъект.Ссылка,
			РегистрыСведений.ОперацииДокументов.ДанныеДляЗаписи());
		ЗаписатьПустойНаборДополнительныхРеквизитов(ТекущийОбъект.Ссылка);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьДатуПроведенияДокумента(ТекущийОбъект)
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьОтдельнуюДатуПроведенияДокументов") 
		Или Не Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(ТекущийОбъект.Ссылка)) Тогда
			
		Возврат;
	КонецЕсли;
	
	НоваяДатаПроведения = '00010101';
	Если Не ТекущийОбъект.ДополнительныеСвойства.Свойство("ОтдельнаяДатаПроведения", НоваяДатаПроведения) Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ДатыПроведенияДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ТекущийОбъект.Ссылка);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		Если Не ЗначениеЗаполнено(НоваяДатаПроведения) Тогда
			Возврат;
		КонецЕсли;
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Документ = ТекущийОбъект.Ссылка;
		НоваяЗапись.ДатаПроведения = НоваяДатаПроведения;
		НаборЗаписей.Записать(РежимЗамещения.Добавление);
	Иначе
		Запись = НаборЗаписей[0];
		СохраненнаяДатаПроведения = Запись.ДатаПроведения;
		Если НоваяДатаПроведения = СохраненнаяДатаПроведения Тогда
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НоваяДатаПроведения) Тогда
			Запись.ДатаПроведения = НоваяДатаПроведения;
			НаборЗаписей.Записать(РежимЗамещения.Обновление);
		Иначе
			НаборЗаписей.Записать(РежимЗамещения.Удаление);
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

Функция ЗапретитьПроведениеБезУказанияОтветственного()
	Возврат Ложь;
КонецФункции

// Заполнить ответственного исполнителя для записи.
// 
// Параметры:
//  ДанныеДляЗаписи - см. НовыйДанныеДляЗаписи
//  ИдентификаторДокумента - СправочникСсылка.ИдентификаторыОбъектовМетаданных
//  ОтветственныйИсполнитель - СправочникСсылка.Сотрудники
//  РеквизитыБухгалтерскойОперации - Структура -
//                                 - ДанныеФормыСтруктура:
//   * Организация - СправочникСсылка.Организации
//   * Дата - Дата
//  Отказ - Булево
Процедура ЗаполнитьОтветственногоИсполнителяДляЗаписи(ДанныеДляЗаписи, ИдентификаторДокумента, ОтветственныйИсполнитель, РеквизитыБухгалтерскойОперации, Отказ) Экспорт
	
	// Указанный в документе "бухгалтер" не изменяется
	Если ЗначениеЗаполнено(ОтветственныйИсполнитель) Тогда
		ДанныеДляЗаписи.ОтветственныйИсполнитель = ОтветственныйИсполнитель;
		Возврат;
	КонецЕсли;
	
	// Получить допустимых ответственных
	ТекущийПользователь = Пользователи.АвторизованныйПользователь(); // СправочникСсылка.Пользователи
	СлужебныйПользователь = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийПользователь, "Служебный");
	Если СлужебныйПользователь Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДляЗаписи.ОтветственныйИсполнитель = ОтветственныйИсполнительДляДокумента(ИдентификаторДокумента,
		ОтветственныйИсполнитель, РеквизитыБухгалтерскойОперации.Организация, РеквизитыБухгалтерскойОперации.Дата);
	
КонецПроцедуры

Функция ОтветственныйИсполнительДляДокумента(ИдентификаторДокумента, ОтветственныйИсполнитель, Организация, Дата) Экспорт
	// Получить допустимых ответственных
	ТекущийПользователь = Пользователи.АвторизованныйПользователь(); // СправочникСсылка.Пользователи
	
	ДопустимыеСотрудники = ДопустимыеОтветственныеДляДокумента(ИдентификаторДокумента, Организация);
	Если ДопустимыеСотрудники.Количество() = 1 Тогда
		// Можно без анализа устанавливать нового сотрудника
		Возврат ДопустимыеСотрудники[0];
	КонецЕсли;
	
	СотрудникИзНастройкиПользователя = РегистрыСведений.ОтветственныеИсполнителиПользователей.Ответственный(
		ТекущийПользователь, Организация, Дата);
	Если ЗначениеЗаполнено(СотрудникИзНастройкиПользователя) Тогда
		Возврат СотрудникИзНастройкиПользователя;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтветственныйИсполнитель) Тогда
		Если ДопустимыеСотрудники.Найти(ОтветственныйИсполнитель) <> Неопределено Тогда
			Возврат ОтветственныйИсполнитель;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Справочники.Сотрудники.ПустаяСсылка();
	
КонецФункции

// Допустимые ответственные для документа.
// 
// Параметры:
//  ИдентификаторДокумента - СправочникСсылка.ИдентификаторыОбъектовМетаданных, СправочникСсылка.ИдентификаторыОбъектовРасширений - Идентификатор документа
//  Организация - СправочникСсылка.Организации - Организация
//  СпособВыбора - ПеречислениеСсылка.СпособВыбораОтветственногоЦБ, Неопределено - возвращаемый параметр.
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.Сотрудники - Допустимые ответственные для документа
Функция ДопустимыеОтветственныеДляДокумента(ИдентификаторДокумента, Организация, СпособВыбора = Неопределено) Экспорт
	ТекущийПользователь = Пользователи.АвторизованныйПользователь(); // СправочникСсылка.Пользователи
	
	ОрганизацииДляПроверки = Неопределено;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьЦентрализованнуюБухгалтерию") Тогда
		НастройкиЦБ = РегистрыСведений.НастройкиВыбораОтветственныхСотрудниковЦБ.НастройкиПоОбъекту(
			ИдентификаторДокумента, БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаОтветственныйИсполнитель());
		Если НастройкиЦБ.Количество() > 0 Тогда
			СпособВыбора = НастройкиЦБ[0].СпособВыбора;
			Если СпособВыбора = Перечисления.СпособВыбораОтветственногоЦБ.ИзСотрудниковУчрежденияИЦБ Тогда
				ОрганизацииДляПроверки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация);
				ОрганизацииДляПроверки.Добавить(Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить());
			ИначеЕсли СпособВыбора = Перечисления.СпособВыбораОтветственногоЦБ.ИзСотрудниковЦБ Тогда
				ОрганизацииДляПроверки = Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ОрганизацииДляПроверки = Неопределено Тогда
		ОрганизацииДляПроверки = Организация;
	КонецЕсли;
	
	ДопустимыеСотрудники = ОбщегоНазначенияБГУ.СотрудникиПоПользователю(ТекущийПользователь, ОрганизацииДляПроверки);
	Возврат ДопустимыеСотрудники;
	
КонецФункции

Функция ПроверитьНеобходимостьДействийПриЗаписиОбъекта(ТекущийОбъект)
	
	Если НЕ ДокументПроводитсяПоРегиструБухгалтерии(ТекущийОбъект)
		ИЛИ НЕ ТекущийОбъект.ДополнительныеСвойства.ПравоДоступаЕПСБУИзменение Тогда
		Возврат Ложь;
	КонецЕсли;

	ИнициализироватьБухгалтерскиеОперации(ТекущийОбъект);

	ДанныеАвтоПроведения = ТекущийОбъект.ДополнительныеСвойства.ДанныеАвтоПроведения;

	Если ТипЗнч(ДанныеАвтоПроведения.ТиповаяОперация) = Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	ТиповаяОперация = ДанныеАвтоПроведения.ТиповаяОперация;

	УстановитьПривилегированныйРежим(Истина);

	Если ЗначениеЗаполнено(ТиповаяОперация)
			И НЕ ОбщегоНазначения.СсылкаСуществует(ТиповаяОперация) Тогда
		ТекстОшибки = НСтр("ru = 'В документе %Документ% выбрана не существующая типовая операция'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", Строка(ТекущийОбъект.Ссылка));
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Истина;
	
КонецФункции

Функция НовыйДанныеДляЗаписи()
	ДанныеДляЗаписи = Новый Структура;
	ДанныеДляЗаписи.Вставить("ТиповаяОперация");
	ДанныеДляЗаписи.Вставить("ДополнительныеРеквизиты");
	ДанныеДляЗаписи.Вставить("ТаблицаЗначенийДопРеквизитов");
	ДанныеДляЗаписи.Вставить("ЗаписатьОперацию");
	ДанныеДляЗаписи.Вставить("СформироватьПроводки");
	ДанныеДляЗаписи.Вставить("ПроверитьКонтролируемыеРеквизиты");
	ДанныеДляЗаписи.Вставить("ТаблицаПроводок");
	ДанныеДляЗаписи.Вставить("ОтветственныйИсполнитель");	
	Возврат ДанныеДляЗаписи;
КонецФункции

Функция ЗаполнитьДанныеДляЗаписиОбъекта(ТекущийОбъект)
	
	ДанныеДляЗаписи = НовыйДанныеДляЗаписи();
	
	ДанныеАвтоПроведения = ТекущийОбъект.ДополнительныеСвойства.ДанныеАвтоПроведения;
	ДанныеДляЗаписи.ТиповаяОперация = ДанныеАвтоПроведения.ТиповаяОперация;
	
	Если НЕ ДанныеАвтоПроведения.ВызовИзФормы И НЕ ДанныеАвтоПроведения.ПрограммноеСоздание Тогда
		СформироватьСтруктуруДопРеквизитовИзБазы(ТекущийОбъект,
			ДанныеДляЗаписи.ТиповаяОперация,
			ДанныеДляЗаписи.ДополнительныеРеквизиты,
			ДанныеДляЗаписи.ТаблицаЗначенийДопРеквизитов, Истина);
		Если ТипЗнч(ДанныеДляЗаписи.ДополнительныеРеквизиты) = Тип("Структура")
				И ДанныеДляЗаписи.ДополнительныеРеквизиты.Свойство("ОтветственныйИсполнитель") Тогда
			ДанныеДляЗаписи.ОтветственныйИсполнитель = ДанныеДляЗаписи.ДополнительныеРеквизиты.ОтветственныйИсполнитель;
			ДанныеДляЗаписи.ДополнительныеРеквизиты.Удалить("ОтветственныйИсполнитель");
		КонецЕсли; 
	Иначе
		ДанныеДляЗаписи.ДополнительныеРеквизиты      = ДанныеАвтоПроведения.ДополнительныеРеквизиты;
		ДанныеДляЗаписи.ТаблицаЗначенийДопРеквизитов = ДанныеАвтоПроведения.ТаблицаЗначенийДопРеквизитов;
		ДанныеДляЗаписи.ОтветственныйИсполнитель = ДанныеАвтоПроведения.ОтветственныйИсполнитель;
	КонецЕсли;

	РежимЗаписиПроведение = ТекущийОбъект.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение;
	РежимЗаписиЗапись = ТекущийОбъект.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Запись;

	ФормированиеПроводокОбособленноОтДокумента = ДанныеАвтоПроведения.ФормированиеПроводокОбособленноОтДокумента;

	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ТекущийОбъект));
	ЭтоДокументПроводкиВсегдаОдновременно = ПроводкиФормируютсяВсегдаОдновременно(ИдентификаторДокумента);

	Если ЭтоДокументПроводкиВсегдаОдновременно Тогда
		ДанныеДляЗаписи.ЗаписатьОперацию = Истина;
		ДанныеДляЗаписи.СформироватьПроводки = РежимЗаписиПроведение;
	ИначеЕсли ФормированиеПроводокОбособленноОтДокумента Тогда
	// проводки формируются только если режим записи - "Проведение" и существуют проводки
		ДанныеДляЗаписи.СформироватьПроводки = РежимЗаписиПроведение И ТекущийОбъект.Проведен
			И ЕстьПроводкиДокумента(ТекущийОбъект.Ссылка);
		ДанныеДляЗаписи.ЗаписатьОперацию = ДанныеАвтоПроведения.ПрограммноеСоздание;
	ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеДляЗаписи.ТиповаяОперация) Тогда
		ДанныеДляЗаписи.СформироватьПроводки = Ложь;
		ДанныеДляЗаписи.ЗаписатьОперацию = Истина;
	ИначеЕсли ТекущийОбъект.ДополнительныеСвойства.ПравоДоступаЕПСБУИзменение Тогда
		ДанныеДляЗаписи.СформироватьПроводки = РежимЗаписиПроведение;
		ДанныеДляЗаписи.ЗаписатьОперацию = РежимЗаписиПроведение ИЛИ РежимЗаписиЗапись;
	Иначе
		ДанныеДляЗаписи.СформироватьПроводки = Ложь;
		ДанныеДляЗаписи.ЗаписатьОперацию = РежимЗаписиЗапись И ЗначениеЗаполнено(ДанныеДляЗаписи.ТиповаяОперация);
	КонецЕсли;

	Если ДанныеДляЗаписи.ЗаписатьОперацию Тогда
		ДанныеДляЗаписи.ТиповаяОперация = ?(ЗначениеЗаполнено(ДанныеДляЗаписи.ТиповаяОперация) ИЛИ ДанныеАвтоПроведения.ВызовИзФормы,
							ДанныеДляЗаписи.ТиповаяОперация,
							БухгалтерскаяОперацияДокумента(ТекущийОбъект.Ссылка));
	КонецЕсли;

	ДанныеДляЗаписи.СформироватьПроводки = ДанныеДляЗаписи.СформироватьПроводки
		ИЛИ (ДанныеАвтоПроведения.ПрограммноеСоздание
		И ДанныеАвтоПроведения.ФормироватьПроводки И РежимЗаписиПроведение);

	ДанныеДляЗаписи.ПроверитьКонтролируемыеРеквизиты = (ДанныеДляЗаписи.СформироватьПроводки
		ИЛИ (ДанныеАвтоПроведения.ПрограммноеСоздание
		И ДанныеАвтоПроведения.ФормироватьПроводки))
		И ФормированиеПроводокОбособленноОтДокумента
		И ДанныеДляЗаписи.СформироватьПроводки
		И НЕ ЭтоДокументПроводкиВсегдаОдновременно;
		
	Возврат ДанныеДляЗаписи;
	
КонецФункции

Процедура ВычислитьПроводкиПриЗаписиОбъекта(ТекущийОбъект, ДанныеДляЗаписи, РеквизитыБухгалтерскойОперации, Отказ)
	
	ФормированиеПроводок = Обработки.ФормированиеБухгалтерскихПроводок.Создать();
	// если в документе есть реквизит Курс и Кратность, то берем значения именно этих реквизитов
	Если ТекущийОбъект.Метаданные().Реквизиты.Найти("Курс") <> Неопределено Тогда
		ФормированиеПроводок.ЕстьКурсКратностьВДокументе = Истина;
		ФормированиеПроводок.Курс = ТекущийОбъект.Курс;
		ФормированиеПроводок.Кратность = ТекущийОбъект.Кратность;
	КонецЕсли;

	Попытка

		ПредставлениеДокумента = Строка(ТекущийОбъект.Ссылка);

		ПараметрыАвтоФормированияПроводок = ФормированиеПроводок.ПараметрыАвтоФормированияПроводок();
		ПараметрыАвтоФормированияПроводок.ДопРеквизиты = ДанныеДляЗаписи.ДополнительныеРеквизиты;
		ПараметрыАвтоФормированияПроводок.ТекущийОбъект = ТекущийОбъект;
		ПараметрыАвтоФормированияПроводок.ТаблицаПроводок = Неопределено;

		ФормированиеПроводок.ДокументОснование = ТекущийОбъект.Ссылка;
		ФормированиеПроводок.ТиповаяОперация = ДанныеДляЗаписи.ТиповаяОперация;
		ФормированиеПроводок.ИсправлениеОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДанныеДляЗаписи.ДополнительныеРеквизиты,
			"ИсправлениеОшибки",
			Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка);
		ФормированиеПроводок.ВыявительОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДанныеДляЗаписи.ДополнительныеРеквизиты,
			"ВыявительОшибки",
			Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка());
		ФормированиеПроводок.ПричинаОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДанныеДляЗаписи.ДополнительныеРеквизиты,
			"ПричинаОшибки",
			Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка());
		ФормированиеПроводок.АвтоФормированиеПроводок(ПараметрыАвтоФормированияПроводок, Отказ);

		ДанныеДляЗаписи.ТаблицаПроводок = ПараметрыАвтоФормированияПроводок.ТаблицаПроводок;

		ЗаполнитьЗначенияСвойств(РеквизитыБухгалтерскойОперации, ФормированиеПроводок, "Дата, Организация");

	Исключение

		ИнфоОшибки = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Данные.Изменение'",
								 ОбщегоНазначения.КодОсновногоЯзыка()),
								 УровеньЖурналаРегистрации.Ошибка,
								 ТекущийОбъект.Метаданные(),
								 ТекущийОбъект.Ссылка,
								 ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфоОшибки));
		ТекстОшибки = СтрШаблон(НСтр("ru = 'При проведении документа %1 возникла ошибка:
											|%2
											|Подробная информация записана в журнал регистрации.'"),
								ПредставлениеДокумента,
								ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнфоОшибки));
		ВызватьИсключение ТекстОшибки

	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьЗначенияДополнительныхРеквизитовИзСтруктуры(Документ,
		ДополнительныеРеквизиты, ТиповаяОперация)
	ДополнительныеРеквизитыНабор = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
	ДополнительныеРеквизитыНабор.Отбор.Объект.Установить(Документ);

	ТекТиповаяОперацияДополнительныеРеквизиты = Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(ТиповаяОперация);

	Для каждого ТекРеквизит Из ТекТиповаяОперацияДополнительныеРеквизиты Цикл

		ЗначениеТекДопРеквизита = Неопределено;
		Если ДополнительныеРеквизиты.Свойство(ТекРеквизит.ИмяДляФормулы, ЗначениеТекДопРеквизита) Тогда
			НовРеквизит = ДополнительныеРеквизитыНабор.Добавить();
			НовРеквизит.Объект = Документ;
			НовРеквизит.Значение = ЗначениеТекДопРеквизита;
			НовРеквизит.РеквизитОперации = ТекРеквизит.Ссылка;
		КонецЕсли;

	КонецЦикла;

	ДополнительныеРеквизитыНабор.Записать(Истина);
КонецПроцедуры

Процедура ЗаписатьЗначенияДополнительныхРеквизитовИзТаблицы(Документ,
		ЗначенияРеквизитовОперации)
	ЗначенияРеквизитовОперации.ЗаполнитьЗначения(Документ, "Объект");
	ДополнительныеРеквизитыНабор = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
	ДополнительныеРеквизитыНабор.Отбор.Объект.Установить(Документ);
	ДополнительныеРеквизитыНабор.Загрузить(ЗначенияРеквизитовОперации);
	ДополнительныеРеквизитыНабор.Записать(Истина);
КонецПроцедуры

Процедура ЗаписатьПустойНаборДополнительныхРеквизитов(Документ)
	ДополнительныеРеквизитыНабор = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
	ДополнительныеРеквизитыНабор.Отбор.Объект.Установить(Документ);
	ДополнительныеРеквизитыНабор.Записать(Истина);
КонецПроцедуры

Процедура ЗаписатьТиповуюОперациюДокумента(ТекущийОбъект, РеквизитыБухгалтерскойОперации, ДанныеДляЗаписи)

	Если ТипЗнч(ДанныеДляЗаписи.ТаблицаПроводок) = Тип("ТаблицаЗначений") Тогда
		ПроводкиДляСуммирования = ДанныеДляЗаписи.ТаблицаПроводок;
	ИначеЕсли ТекущийОбъект.Проведен
		И ТекущийОбъект.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
			
		ПроводкиДляСуммирования = ТекущийОбъект.Движения.ЖурналПроводокЕПСБУ;
		ПроводкиДляСуммирования.Прочитать();
	Иначе
		ПроводкиДляСуммирования = Неопределено;
	КонецЕсли;

	Если ПроводкиДляСуммирования = Неопределено Тогда
		// При проведении из регистра бухгалтерии будет запись нужного значения
		ЕстьПроводки  = Ложь;
		СуммаОперации = 0;
	Иначе
		СуммаОперации = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СуммаПроводокПоНастройкамПоУмолчанию(ПроводкиДляСуммирования);
		ЕстьПроводки  = ПроводкиДляСуммирования.Количество() > 0;
	КонецЕсли;
	
	БухгалтерскаяОперация = РегистрыСведений.ОперацииДокументов.ДанныеДляЗаписи(ТекущийОбъект.Ссылка);
	
	БухгалтерскаяОперация.Операция      = РеквизитыБухгалтерскойОперации.Операция;
	БухгалтерскаяОперация.Дата          = РеквизитыБухгалтерскойОперации.Дата;
	БухгалтерскаяОперация.Организация   = РеквизитыБухгалтерскойОперации.Организация;
	БухгалтерскаяОперация.СуммаОперации = СуммаОперации;
	БухгалтерскаяОперация.ЕстьПроводки  = ЕстьПроводки;
	БухгалтерскаяОперация.ОтветственныйИсполнитель = ДанныеДляЗаписи.ОтветственныйИсполнитель;
	
	Если ТипЗнч(ДанныеДляЗаписи.ДополнительныеРеквизиты) = Тип("Структура") Тогда
		БухгалтерскаяОперация.Курс = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДанныеДляЗаписи.ДополнительныеРеквизиты,
			"Курс",
			1);
		БухгалтерскаяОперация.Кратность = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДанныеДляЗаписи.ДополнительныеРеквизиты,
			"Кратность",
			1);
		БухгалтерскаяОперация.ИсправлениеОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДанныеДляЗаписи.ДополнительныеРеквизиты,
			"ИсправлениеОшибки",
			Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка);
		БухгалтерскаяОперация.ВыявительОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДанныеДляЗаписи.ДополнительныеРеквизиты,
			"ВыявительОшибки",
			Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка());
		БухгалтерскаяОперация.ПричинаОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДанныеДляЗаписи.ДополнительныеРеквизиты,
			"ПричинаОшибки",
			Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка());
	КонецЕсли;
 
 	РегистрыСведений.ОперацииДокументов.ЗаписатьОперацию(ТекущийОбъект.Ссылка, БухгалтерскаяОперация);
	
КонецПроцедуры

Процедура ЗаписатьДанныеДополнительныхТабЧастей(Документ,
		ДанныеДополнительныхТабЧастей)
	НаборЗаписей = РегистрыСведений.ЗначенияКолонокДополнительныхТабличныхЧастей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Документ);
	Для каждого ТекДвижение Из ДанныеДополнительныхТабЧастей Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекДвижение);
		НоваяЗапись.Объект = Документ;
	КонецЦикла;
	НаборЗаписей.Записать(Истина);
КонецПроцедуры

// Процедура вызывается из подписки на событие.
// Процедура записывает таблицу проводок.
//
Процедура ОбработкаПроведения(ТекущийОбъект, Отказ, РежимПроведения)

	Если Не ДокументПроводитсяПоРегиструБухгалтерии(ТекущийОбъект) Тогда
		Возврат;
	КонецЕсли;

	ИнициализироватьБухгалтерскиеОперации(ТекущийОбъект);

	Если ТипЗнч(ТекущийОбъект.Ссылка) = Тип("ДокументСсылка.ОперацияБух") Тогда
		Возврат;
	КонецЕсли;

	ФормироватьПроводки       = ТекущийОбъект.ДополнительныеСвойства.ДанныеАвтоПроведения.ФормироватьПроводки;
	ТаблицаПроводок           = ТекущийОбъект.ДополнительныеСвойства.ДанныеАвтоПроведения.ТаблицаПроводок;
	ДолжнаБытьТаблицаПроводок = ФормироватьПроводки
		И ТекущийОбъект.ДополнительныеСвойства.ДанныеАвтоПроведения.ФормированиеПроводокОбособленноОтДокумента;

	Если ТаблицаПроводок = Неопределено И ДолжнаБытьТаблицаПроводок Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='Проводки не сформированы. Проверьте заполнение документа, типовой операции и доп. реквизитов'"),
			,
			"ТиповаяОперация",
			,
			Отказ);
	ИначеЕсли ТаблицаПроводок = Неопределено И НЕ ФормироватьПроводки Тогда
		// Очистить проводки
		ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	КонецЕсли;

	Если НЕ Отказ И ТипЗнч(ТаблицаПроводок) = Тип("ТаблицаЗначений") Тогда

		ЗагрузитьПроводкиДокумента(ТекущийОбъект, ТаблицаПроводок, Отказ);

	КонецЕсли;

	Если ТекущийОбъект.ДополнительныеСвойства.Свойство("МеткаВремениПередЗаписью") Тогда
		ОценкаПроизводительности.ЗакончитьЗамерВремени(
			ОбщегоНазначенияБГУКлиентСервер.ИмяКлючевойОперации(ТекущийОбъект.Ссылка, "Проведение"),
			ТекущийОбъект.ДополнительныеСвойства.МеткаВремениПередЗаписью,
			,
			СтрШаблон(НСтр("ru = 'Неинтерактивное проведение;%1'"), ПараметрыСеанса.КомментарийЗамераВремени),
			Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПроведениеДокументов

Функция НовыйДанныеАвтопроведения()
	ДанныеАвтоПроведения = Новый Структура;
	ДанныеАвтоПроведения.Вставить("ВызовИзФормы", Ложь);
	ДанныеАвтоПроведения.Вставить("ТиповаяОперация"); 
	ДанныеАвтоПроведения.Вставить("ДополнительныеРеквизиты"); 
	ДанныеАвтоПроведения.Вставить("ТаблицаЗначенийДопРеквизитов");
	ДанныеАвтоПроведения.Вставить("ТаблицаПроводок");
	ДанныеАвтоПроведения.Вставить("ФормированиеПроводокОбособленноОтДокумента",
		ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента"));
	ДанныеАвтоПроведения.Вставить("ТаблицаБлокировок");
	ДанныеАвтоПроведения.Вставить("ФормироватьПроводки", Ложь);
	ДанныеАвтоПроведения.Вставить("ЭтоСторно", Ложь);
	ДанныеАвтоПроведения.Вставить("ЭтоБухоперация", Ложь);
	ДанныеАвтоПроведения.Вставить("ПрограммноеСоздание", Ложь);
	ДанныеАвтоПроведения.Вставить("ОтветственныйИсполнитель");
	ДанныеАвтоПроведения.Вставить("ИдентификаторДокумента");
	Возврат ДанныеАвтоПроведения;
	
КонецФункции

// Создает структуру для передачи параметров из события ПередЗаписью в событие ПриЗаписи.
// Структура добавляется в Объект.ДополнительныеСвойства.
// 
// Параметры:
// Объект - ДокументОбъект - документ.
//
Процедура ИнициализироватьБухгалтерскиеОперации(Объект) Экспорт
	
	Если Объект.ДополнительныеСвойства.Свойство("ДанныеАвтоПроведения") Тогда
		Возврат;
	КонецЕсли;
	ТипОбъекта = ТипЗнч(Объект);

	ДанныеАвтоПроведения = НовыйДанныеАвтопроведения();
	ДанныеАвтоПроведения.ЭтоСторно = ТипОбъекта = Тип("ДокументОбъект.Сторно");
	ДанныеАвтоПроведения.ЭтоБухОперация = ТипОбъекта = Тип("ДокументОбъект.ОперацияБух");
	ДанныеАвтоПроведения.ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипОбъекта);

	Объект.ДополнительныеСвойства.Вставить("ДанныеАвтоПроведения", ДанныеАвтоПроведения);

КонецПроцедуры

// Возвращает структуру параметров для процедуры ЗаписатьТиповуюОперациюИДопРеквизиты
// 
// Возвращаемое значение:
//  Структура - Записать типовую операцию и доп реквизиты параметры:
// * Документ - ДокументСсылка
//            - Неопределено 
// * Операция - СправочникСсылка.ТиповыеОперации 
// * Организация - СправочникСсылка.Организации
// * Дата - Дата
//        - Неопределено
// * ДополнительныеРеквизиты - Структура
//                           - Неопределено 
// * РучнаяКорректировка - Булево -
// * ИсправлениеОшибки - ПеречислениеСсылка.ПорядокИсправленияОшибокПрошлыхЛет -
// * ВыявительОшибки - ПеречислениеСсылка.ВыявительОшибокПрошлыхЛет -
// * ПричинаОшибки - СправочникСсылка.ПричиныОшибокПрошлыхЛет -
// * НеЗаписыватьДополнительныеРеквизиты - Булево -
// * ОтветственныйИсполнитель - СправочникСсылка.Сотрудники
Функция ЗаписатьТиповуюОперациюИДопРеквизиты_Параметры() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Документ", Неопределено);
	Результат.Вставить("Операция", Справочники.ТиповыеОперации.ПустаяСсылка());
	Результат.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Результат.Вставить("Дата", Неопределено);
	Результат.Вставить("ДополнительныеРеквизиты", Неопределено);
	Результат.Вставить("РучнаяКорректировка", Ложь);
	Результат.Вставить("ИсправлениеОшибки", Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка);
	Результат.Вставить("ВыявительОшибки", Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка());
	Результат.Вставить("ПричинаОшибки", Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка());
	Результат.Вставить("НеЗаписыватьДополнительныеРеквизиты", Ложь);
	Результат.Вставить("ОтветственныйИсполнитель", Справочники.Сотрудники.ПустаяСсылка());

	Возврат Результат;

КонецФункции

// Процедура записывает типовую операцию с доп. реквизитами
//
// Параметры:
//	ПараметрыЗаписи - см. БухгалтерскиеОперацииСервер.ЗаписатьТиповуюОперациюИДопРеквизиты_Параметры
//	Отказ	- Булево - признак ошибки при записи типовой операции или доп. реквизитов
//
Процедура ЗаписатьТиповуюОперациюИДопРеквизиты(ПараметрыЗаписи, Отказ) Экспорт

	Документ = ПараметрыЗаписи.Документ;
	Операция = ПараметрыЗаписи.Операция;
	Организация = ПараметрыЗаписи.Организация;
	Дата = ПараметрыЗаписи.Дата;
	ДополнительныеРеквизиты = ПараметрыЗаписи.ДополнительныеРеквизиты;
	РучнаяКорректировка = ПараметрыЗаписи.РучнаяКорректировка;
	ИсправлениеОшибки = ПараметрыЗаписи.ИсправлениеОшибки;
	ВыявительОшибки = ПараметрыЗаписи.ВыявительОшибки;
	ПричинаОшибки = ПараметрыЗаписи.ПричинаОшибки;
	ЗаписыватьДополнительныеРеквизиты = НЕ ПараметрыЗаписи.НеЗаписыватьДополнительныеРеквизиты;
	
	ПредставлениеДокумента = Строка(Документ);

	ДанныеОперации = РегистрыСведений.ОперацииДокументов.ДанныеДляЗаписи();
	ДанныеОперации.Документ            = Документ;
	ДанныеОперации.Операция            = Операция;
	ДанныеОперации.Организация         = Организация;
	ДанныеОперации.Дата                = Дата;
	ДанныеОперации.РучнаяКорректировка = РучнаяКорректировка;
	ДанныеОперации.ИсправлениеОшибки   = ИсправлениеОшибки;
	ДанныеОперации.ВыявительОшибки     = ВыявительОшибки;
	ДанныеОперации.ПричинаОшибки       = ПричинаОшибки;
	ДанныеОперации.ОтветственныйИсполнитель = ПараметрыЗаписи.ОтветственныйИсполнитель;
	Если ДополнительныеРеквизиты.Свойство("Курс") Тогда
		ДанныеОперации.Курс            = ДополнительныеРеквизиты.Курс;
		ДанныеОперации.Кратность       = ДополнительныеРеквизиты.Кратность;
	КонецЕсли;
	Если ДополнительныеРеквизиты.Свойство("СуммаОперации") Тогда
		ДанныеОперации.СуммаОперации   = ДополнительныеРеквизиты.СуммаОперации;
	КонецЕсли;

	Если ЗаписыватьДополнительныеРеквизиты Тогда
		ЗначенияДопРеквизитов = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
		ЗначенияДопРеквизитов.Отбор.Объект.Установить(Документ);

		ДополнительныеРеквизитыОперации = Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(Операция, , "Наименование");

		Для каждого ТекРеквизит Из ДополнительныеРеквизитыОперации Цикл
			Если ДополнительныеРеквизиты.Свойство(ТекРеквизит.ИмяДляФормулы) Тогда
				ЗначениеДопРеквизита = ЗначенияДопРеквизитов.Добавить();
				ЗначениеДопРеквизита.Объект = Документ;
				ЗначениеДопРеквизита.РеквизитОперации = ТекРеквизит.Ссылка;
				ЗначениеДопРеквизита.Значение = ДополнительныеРеквизиты[ТекРеквизит.ИмяДляФормулы];
			КонецЕсли;
		КонецЦикла;

		Если ПолучитьФункциональнуюОпцию("ИспользоватьВерсионированиеОбъектов") Тогда
			ДанныеТиповойОперацииВерсионирование = НовыйДанныеТиповойОперацииВерсионирование(Операция);
			ДанныеТиповойОперацииВерсионирование.ОтветственныйИсполнитель = ДанныеОперации.ОтветственныйИсполнитель;

			Для каждого ТекРеквизит Из ДополнительныеРеквизитыОперации Цикл
				Если ДополнительныеРеквизиты.Свойство(ТекРеквизит.ИмяДляФормулы) Тогда

					НоваяСтрокаДанных = ДанныеТиповойОперацииВерсионирование.ТаблицаЗначенийДопРеквизитов.Добавить();
					НоваяСтрокаДанных.Объект = Документ;
					НоваяСтрокаДанных.РеквизитОперации = ТекРеквизит.Ссылка;
					НоваяСтрокаДанных.Значение = ДополнительныеРеквизиты[ТекРеквизит.ИмяДляФормулы];
					НоваяСтрокаДанных.НаименованиеРеквизита = ТекРеквизит.Наименование;

				КонецЕсли;
			КонецЦикла;
			ДокументОбъект = Документ.ПолучитьОбъект();
			ДокументОбъект.ДополнительныеСвойства.Вставить("ДанныеТиповойОперации", ДанныеТиповойОперацииВерсионирование);
			ВерсионированиеОбъектов.ЗаписатьВерсиюОбъекта(ДокументОбъект, РежимЗаписиДокумента.Проведение);
		КонецЕсли;

	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();

	Попытка

		РегистрыСведений.ОперацииДокументов.ЗаписатьОперацию(Документ, ДанныеОперации);
		Если ЗаписыватьДополнительныеРеквизиты Тогда
			ЗначенияДопРеквизитов.Записать(Истина);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();

	Исключение
		
		ОтменитьТранзакцию();
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		ТекстОшибки = НСтр("ru = 'Не удалось записать типовую операцию и дополнительные реквизиты документа %Документ% по причине:
								|%ОписаниеОшибки%'");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ПредставлениеДокумента);
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ОписаниеОшибки%",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		
		ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрацииФормированиеПроводокПроведение(),
			УровеньЖурналаРегистрации.Ошибка,
			Документ.Метаданные(),
			Документ,
			ТекстОшибки);
			
		ВызватьИсключение;

	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура ЗагрузитьПроводкиДокумента(Документ, ТаблицаПроводок, Отказ) Экспорт

	Если Не ДокументПроводитсяПоРегиструБухгалтерии(Документ) Тогда
		ТекстСообщения = НСтр("ru='Документ не проводится по регистру бухгалтерии.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
		Возврат;
	КонецЕсли;

	Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Документ)) Тогда
		Движения = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
		Движения.Отбор.Регистратор.Установить(Документ);
		Движения.Загрузить(ТаблицаПроводок);
		ЗаполнитьОрганизациюИФОВПроводках(Движения, Документ);
		Движения.ДополнительныеСвойства.Вставить("ТаблицаОшибок");
		
		//  При проведении устанавливается привелигированный режим, поэтому
		// определить имеет ли пользователь право измеения регистра Рабочие счета
		// надо заранее
		//
		Движения.ДополнительныеСвойства.Вставить("ЕстьПравоИзмененияРабочихСчетов", ПравоДоступа("Изменение", Метаданные.РегистрыСведений.РабочиеСчета));
		
		Попытка
			Движения.Записать(Истина);
		Исключение
			ТаблицаОшибок = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Движения.ДополнительныеСвойства, "ТаблицаОшибок");
			
			Если ТаблицаОшибок <> Неопределено Тогда
				СообщитьОбОшибкахПроведения(ТаблицаОшибок, Отказ);
			Иначе
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки(),,,,Отказ);
			КонецЕсли;
		КонецПопытки;
	Иначе
		Движения = Документ.Движения.ЖурналПроводокЕПСБУ;
		ЗаполнитьПредставлениеОперации(Документ.ДополнительныеСвойства);
		Попытка
			Движения.Записывать = Истина;
			Движения.Загрузить(ТаблицаПроводок);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрацииФормированиеПроводокПроведение(), УровеньЖурналаРегистрации.Ошибка,
				Документ.Метаданные(), Документ.Ссылка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			ВызватьИсключение ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Проверяет, что документ может делать проводки по регистру бухгалтерии.
// 
// Параметры:
// 	Документ - ДокументОбъект, ДокументСсылка - проверяемый документ
// Возвращаемое значение:
// 	Булево - Истина, если в коллекции движений есть РБ.ЖурналПроводокЕПСБУ, Ложь - если нет.
//
Функция ДокументПроводитсяПоРегиструБухгалтерии(Документ)
	
	ЭтоСсылка = Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Документ)); 

	Если ЭтоСсылка Тогда
		Возврат Документ.Метаданные().Движения.Содержит(Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ);
	Иначе
		Возврат Документ.Движения.Найти("ЖурналПроводокЕПСБУ") <> Неопределено;
	КонецЕсли;
		
КонецФункции

Процедура ЗаполнитьПредставлениеОперации(ДополнительныеСвойства)
	
	ДанныеАвтоПроведения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "ДанныеАвтоПроведения");
	Если ДанныеАвтоПроведения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	 
	ТиповаяОперация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеАвтоПроведения, "ТиповаяОперация");
	
	Если ТипЗнч(ТиповаяОперация) = Тип("Структура") Тогда
		ТиповаяОперация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ТиповаяОперация, "Операция");
	КонецЕсли;

	Если ЗначениеЗаполнено(ТиповаяОперация) Тогда
		ДополнительныеСвойства.Вставить("ПредставлениеОперации", Строка(ТиповаяОперация));
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОрганизациюИФОВПроводках(Движения, Документ)

	ЗаполнятьИФО = Ложь;

	ЧитаемыеДанныеДокумента = Новый Структура("Организация");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО")
		И ОбщегоНазначения.ЕстьРеквизитОбъекта("ИФО", Документ.Метаданные()) Тогда
			
		ЧитаемыеДанныеДокумента.Вставить("ИФО");
		ЗаполнятьИФО = Истина;
	КонецЕсли;
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, ЧитаемыеДанныеДокумента);
	
	Для каждого ТекДвижение Из Движения Цикл
		Если НЕ ЗначениеЗаполнено(ТекДвижение.Организация) Тогда
			ТекДвижение.Организация = ДанныеДокумента.Организация;
		КонецЕсли;
		Если ЗаполнятьИФО И НЕ ЗначениеЗаполнено(ТекДвижение.ИФО) Тогда
			ТекДвижение.ИФО = ДанныеДокумента.ИФО;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция КурсИКратностьДляСхемыФормированияПроводок(Документ, НаборСвойств)
	
	Результат = Новый Структура("Курс, Кратность", 1, 1);
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Для заявок на кассовый расход в иностранной валюте курс определяется по регистру СостояниеПлатежноРасчетныхДокументов,
	// кроме договоров с признаком "Оплата в рублях"
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход") Тогда
		ВалютаДоговор = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "ВалютаДокумента, Договор");
		Если ВалютаДоговор.ВалютаДокумента <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()
			И (НЕ ЗначениеЗаполнено(ВалютаДоговор.Договор)
				ИЛИ НЕ РаботаСОбязательствами.СведенияОВалютеОбязательства(ВалютаДоговор.Договор).ОплатаВРублях) Тогда
			ЗаполнитьЗначенияСвойств(Результат, ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Документ), "Курс, Кратность");
			//Результат.Курс = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Документ).Курс;
			//Результат.Кратность = 1;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	РеквизитыДокумента = БухгалтерскийУчетПовтИсп.ПолучитьМассивРеквизитовОбъекта("Документы", Документ.Метаданные().Имя);
	
	МассивРеквизитов = Новый Массив;
	Если РеквизитыДокумента.Найти("Курс") <> Неопределено Тогда
		МассивРеквизитов.Добавить("Курс");
	КонецЕсли;
	Если РеквизитыДокумента.Найти("Кратность") <> Неопределено Тогда
		МассивРеквизитов.Добавить("Кратность");
	КонецЕсли;
	
	Если МассивРеквизитов.Количество() = 0 Тогда
		КурсИКратностьДокумента = Новый Структура;
	Иначе
		КурсИКратностьДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, МассивРеквизитов);
	Конецесли;
	
	Если НЕ КурсИКратностьДокумента.Свойство("Курс", Результат.Курс) Тогда
		Если НЕ НаборСвойств.Свойство("Курс", Результат.Курс) Тогда
			Результат.Курс = 1;
		КонецЕсли;
	КонецЕсли;
	Если НЕ КурсИКратностьДокумента.Свойство("Кратность", Результат.Кратность) Тогда
		Если НЕ НаборСвойств.Свойство("Кратность", Результат.Кратность) Тогда
			Результат.Кратность = 1;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создать источник данных из шапки объекта.
// 
// Параметры:
//  ТекущийОбъект - ДокументОбъект - Текущий объект
//  ТиповаяОперация - СправочникСсылка.ТиповыеОперации - Типовая операция
//  ДополнительныеРеквизиты - Неопределено - Дополнительные реквизиты
// 
// Возвращаемое значение:
//  Структура - Создать источник данных из шапки объекта:
// * ШапкаДокумента - ТаблицаЗначений 
Функция СоздатьИсточникДанныхИзШапкиОбъекта(ТекущийОбъект, ТиповаяОперация,
		ДополнительныеРеквизиты = Неопределено) Экспорт
	Перем ТиповаяОперацияДляСхемы;

	Если Справочники.ТиповыеОперации.ТиповаяОперацияНеРедактируется(ТиповаяОперация, ТиповаяОперацияДляСхемы) Тогда
		ТипТиповойОперации = Новый ОписаниеТипов("СправочникСсылка.ПоставляемыеТиповыеОперации");
	Иначе
		ТипТиповойОперации = Новый ОписаниеТипов("СправочникСсылка.ТиповыеОперации");
		ТиповаяОперацияДляСхемы = ТиповаяОперация;
	КонецЕсли;

	ИсточникиДанных = Новый Структура;

	МетаданныеДокумента = ТекущийОбъект.Метаданные();

	ТаблицаШапка = Новый ТаблицаЗначений;
	ТаблицаШапка.Колонки.Добавить("Ссылка");
	ТаблицаШапка.Колонки.Добавить("Дата");
	ТаблицаШапка.Колонки.Добавить("Номер");
	ТаблицаШапка.Колонки.Добавить("ДополнительныеРеквизиты");
	ТаблицаШапка.Колонки.Добавить("ФактическаяДатаПроведения",
		Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));

	Для каждого ТекРеквизит Из МетаданныеДокумента.Реквизиты Цикл

		ТаблицаШапка.Колонки.Добавить(ТекРеквизит.Имя);

	КонецЦикла;
	Если МетаданныеДокумента.Реквизиты.Найти("ВалютаДокумента") = Неопределено Тогда
		ТаблицаШапка.Колонки.Добавить("ВалютаДокумента");
	КонецЕсли;

	ТаблицаШапка.Колонки.Добавить("ТиповаяОперация", ТипТиповойОперации);
	СтрокаИменДопРеквизитов = "";
	ТаблицаДополнительныеРеквизиты = Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(ТиповаяОперация);
	Для каждого ТекДопРеквизит Из ТаблицаДополнительныеРеквизиты Цикл

		КолонкаТаблицыШапка = ТаблицаШапка.Колонки.Найти(ТекДопРеквизит.ИмяДляФормулы);
		Если КолонкаТаблицыШапка = Неопределено Тогда
			ТаблицаШапка.Колонки.Добавить(ТекДопРеквизит.ИмяДляФормулы, ТекДопРеквизит.ТипЗначения);
		Иначе
			НовыйТипКолонки = Новый ОписаниеТипов(КолонкаТаблицыШапка.ТипЗначения, ТекДопРеквизит.ТипЗначения.Типы());
			ТаблицаШапка.Колонки.Удалить(ТаблицаШапка.Колонки.Индекс(КолонкаТаблицыШапка));
			ТаблицаШапка.Колонки.Добавить(ТекДопРеквизит.ИмяДляФормулы, НовыйТипКолонки);
		КонецЕсли;
		Если ДополнительныеРеквизиты <> Неопределено
				И ДополнительныеРеквизиты.Свойство(ТекДопРеквизит.ИмяДляФормулы) Тогда
			Если НЕ ПустаяСтрока(СтрокаИменДопРеквизитов) Тогда
				СтрокаИменДопРеквизитов = СтрокаИменДопРеквизитов + ",";
			КонецЕсли;
			СтрокаИменДопРеквизитов = СтрокаИменДопРеквизитов
				+ ТекДопРеквизит.ИмяДляФормулы
		КонецЕсли;

	КонецЦикла;
	НовСтрока = ТаблицаШапка.Добавить();

	ЗаполнитьЗначенияСвойств(НовСтрока, ТекущийОбъект);
	НовСтрока.ФактическаяДатаПроведения = БухгалтерскиеОперацииПовтИсп.ФактическаяДатаПроведенияДокумента(
		ТекущийОбъект.Ссылка); 

	ТаблицаШапка.ЗаполнитьЗначения(ТиповаяОперацияДляСхемы, "ТиповаяОперация");
	Если ДополнительныеРеквизиты <> Неопределено
			И НЕ ПустаяСтрока(СтрокаИменДопРеквизитов) Тогда
		ЗаполнитьЗначенияСвойств(НовСтрока, ДополнительныеРеквизиты, СтрокаИменДопРеквизитов);
	КонецЕсли;

	ИсточникиДанных.Вставить("ШапкаДокумента", ТаблицаШапка);
	Возврат ИсточникиДанных;

КонецФункции

Процедура СообщитьОбОшибкахПроведения(ТаблицаОшибок, Отказ) Экспорт

	Если ТаблицаОшибок <> Неопределено Тогда
		Если ТаблицаОшибок.Количество() > 0 Тогда

			Для каждого ТекОшибка Из ТаблицаОшибок Цикл

				Отказ = Истина;
				ОбщегоНазначения.СообщитьПользователю(ТекОшибка.ТекстОшибки, , "БухгалтерскиеПроводки["
					+ ТекОшибка.НомерПроводки + "]." + ТекОшибка.ПолеОшибки);

			КонецЦикла;

		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ДанныеДокументаДляСхемыФормированияПроводок(ДокументОснование, МетаданныеДокумента)
	
	ЧитаемыеРеквизиты = Новый Структура;
	ДобавитьЧитаемыйРеквизитЕслиЕсть(ЧитаемыеРеквизиты, "ВидМежотчетногоПериода", МетаданныеДокумента);
	ДобавитьЧитаемыйРеквизитЕслиЕсть(ЧитаемыеРеквизиты, "ПервичныйДокумент", МетаданныеДокумента);
	ЭтоВходящийПоЭДОАктПриемки0510448 = Ложь;
	Если ЭтоВозможныйТипВходящийПоЭДОАктПриемки0510448(ДокументОснование)
			И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("НФАПереданыЭлектроннымАктом", МетаданныеДокумента)
			И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("НомерПервичногоДокумента", МетаданныеДокумента)
			И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ДатаПервичногоДокумента", МетаданныеДокумента) Тогда
		ЭтоВходящийПоЭДОАктПриемки0510448 = Истина;
		ЧитаемыеРеквизиты.Вставить("НФАПереданыЭлектроннымАктом");
		ЧитаемыеРеквизиты.Вставить("НомерПервичногоДокумента");
		ЧитаемыеРеквизиты.Вставить("ДатаПервичногоДокумента");
	КонецЕсли;
	Если ЗначениеЗаполнено(ЧитаемыеРеквизиты) Тогда
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЧитаемыеРеквизиты);
	Иначе
		ДанныеДокумента = Новый Структура;
	КонецЕсли;
	ДанныеДокумента.Вставить("Ссылка", ДокументОснование);
	ЭтоВходящийПоЭДОАктПриемки0510448 = ЭтоВходящийПоЭДОАктПриемки0510448
		И ДанныеДокумента.НФАПереданыЭлектроннымАктом = Истина
		И ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(
			ДанныеДокумента.ПервичныйДокумент, "АктПриемаПередачи0510448");
	ДанныеДокумента.Вставить("ЭтоВходящийПоЭДОАктПриемки0510448", ЭтоВходящийПоЭДОАктПриемки0510448);
	Возврат ДанныеДокумента;
КонецФункции

Функция ЭтоВозможныйТипВходящийПоЭДОАктПриемки0510448(ДокументОснование)
	ТипОбъекта = ТипЗнч(ДокументОснование);
	Возврат ТипОбъекта = Тип("ДокументСсылка.ПоступлениеМЗ")
		Или ТипОбъекта = Тип("ДокументСсылка.ПоступлениеИК")
		Или ТипОбъекта = Тип("ДокументСсылка.ПоступлениеОС")
		Или ТипОбъекта = Тип("ДокументСсылка.ПоступлениеОСИК")
		Или ТипОбъекта = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС")
		Или ТипОбъекта = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК");
КонецФункции

Процедура ДобавитьЧитаемыйРеквизитЕслиЕсть(ЧитаемыеРеквизиты, ИмяРеквизита, МетаданныеОбъекта)
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента(ИмяРеквизита, МетаданныеОбъекта) Тогда
		ЧитаемыеРеквизиты.Вставить(ИмяРеквизита);
	КонецЕсли;
КонецПроцедуры

Функция НаборПроводокДляСхемыФормированияПроводок(ТиповаяОперация)
	Запрос = Новый Запрос("ВЫБРАТЬ
		|	ПроводкиТиповыхОпераций.Код,
		|	ПроводкиТиповыхОпераций.Ссылка,
		|	ПроводкиТиповыхОпераций.ПометкаУдаления
		|ИЗ
		|	Справочник.ПроводкиТиповыхОпераций КАК ПроводкиТиповыхОпераций
		|ГДЕ
		|	ПроводкиТиповыхОпераций.Владелец = &Владелец
		|	И НЕ ПроводкиТиповыхОпераций.ПометкаУдаления");
	Запрос.УстановитьПараметр("Владелец", ТиповаяОперация);
	ВыборкаПроводок = Запрос.Выполнить().Выбрать();
	НаборПроводок = Новый Структура;
	Пока ВыборкаПроводок.Следующий() Цикл
		НаборПроводок.Вставить("П" + ВыборкаПроводок.Код, ВыборкаПроводок.Ссылка);
	КонецЦикла;
	Возврат НаборПроводок;
КонецФункции

Функция ЗначениеПараметраДляСхемыФормированияПроводок(ИмяПараметра, ЗаданноеЗначениеПараметра, НаборПроводок)
	
	Если Лев(ИмяПараметра, 9) = "Параметр_" Тогда
	// параметры проводок
		СоставПараметра = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяПараметра, "_");
		Если СоставПараметра.Количество() = 3 Тогда
		// реквизит какой то конкретной проводки
			Если НаборПроводок.Свойство("П" + СоставПараметра[2]) Тогда
				Возврат НаборПроводок
					["П" + СоставПараметра[2]]
					[СоставПараметра[1]];
			КонецЕсли;
		ИначеЕсли СоставПараметра.Количество() = 2 Тогда
			Для каждого ТекПроводка Из НаборПроводок Цикл
				Возврат ТекПроводка.Значение[СоставПараметра[1]];
			КонецЦикла;
		КонецЕслИ;
	Иначе
		Возврат ЗаданноеЗначениеПараметра;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура УстановитьЗначениеПараметраСхемыФормированияПроводок(НастройкиСхемы, ПараметрСхемы, ЗначениеПараметра,
		УстанавливатьИспользованиеПустогоЗначения = Ложь)
	Если ЗначениеЗаполнено(ЗначениеПараметра) Или УстанавливатьИспользованиеПустогоЗначения Тогда
		ПараметрНастройки = НастройкиСхемы.Настройки.ПараметрыДанных.Элементы.Найти(ПараметрСхемы.Имя);
		Если ПараметрНастройки <> Неопределено Тогда
			ПараметрНастройки.Значение = ЗначениеПараметра;
			ПараметрНастройки.Использование = Истина;
		КонецЕсли;
		ПараметрСхемы.Значение = ЗначениеПараметра;
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы,
		ИмяПараметраСхемы, ЗначениеПараметра, УстанавливатьИспользованиеПустогоЗначения = Ложь)
	
	Перем ПараметрСхемы;
	Если ВсеПараметрыСхемы.Свойство(ИмяПараметраСхемы, ПараметрСхемы) Тогда
		УстановитьЗначениеПараметраСхемыФормированияПроводок(НастройкиСхемы, ПараметрСхемы, ЗначениеПараметра,
			УстанавливатьИспользованиеПустогоЗначения);
		ВсеПараметрыСхемы.Удалить(ИмяПараметраСхемы);
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьСчетаДляСхемыФормированияПроводок()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Валютный
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Количественный";
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = Новый Структура("ВалютныеСчета, КоличественныеСчета", Новый СписокЗначений, Новый СписокЗначений);
	Результат.ВалютныеСчета.ЗагрузитьЗначения(РезультатЗапроса[0].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Результат.КоличественныеСчета.ЗагрузитьЗначения(РезультатЗапроса[1].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьПараметрСхемыФормированияПроводокЕстьНеНайден(СхемаКомпоновки, ИмяПараметра)
	ПараметрСхемы = СхемаКомпоновки.Параметры.Найти(ИмяПараметра);
	Если ПараметрСхемы <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрСхемы = СхемаКомпоновки.Параметры.Добавить();
	ПараметрСхемы.Имя = ИмяПараметра;
	ПараметрСхемы.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
КонецПроцедуры

Процедура ЗаполнитьПараметрыСхемыФормированияПроводок(СхемаКомпоновки, НастройкиСхемы, ДанныеДокумента, ПараметрыИнициализации, НаборПроводок)
	Перем ЗначениеВидМежотчетногоПериода;

	ЗначениеПервичныйДокумент = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента,
		"ПервичныйДокумент"); // СправочникСсылка.ПервичныеДокументы
	ИспользуетсяДокументКонтрагента = Ложь;
	ИспользуетсяАктПриемкиТРУ = Ложь;
	ЗначениеПараметра = "";
	Если ЗначениеЗаполнено(ЗначениеПервичныйДокумент)
			И ТипЗнч(ЗначениеПервичныйДокумент) = Тип("СправочникСсылка.ПервичныеДокументы") Тогда
		Если ЗначениеПервичныйДокумент = ПервичныеДокументыБГУ.ПервичныйДокументДокументКонтрагента() Тогда
			ИспользуетсяДокументКонтрагента = Истина;
		ИначеЕсли ЗначениеПервичныйДокумент = ПервичныеДокументыБГУ.ПервичныйДокументАктПриемкиТРУ() Тогда
			ИспользуетсяАктПриемкиТРУ = Истина;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеПервичныйДокумент <> Неопределено Тогда
		ДобавитьПараметрСхемыФормированияПроводокЕстьНеНайден(СхемаКомпоновки, "ПервичныйДокумент");
	КонецЕсли;
	Если ИспользуетсяАктПриемкиТРУ Тогда
		ДанныеАктаПриемкиТРУ = АктПриемкиТРУПоДокументу(ДанныеДокумента.Ссылка);
		Если Не ЗначениеЗаполнено(ДанныеАктаПриемкиТРУ.Ссылка) Тогда
			ТекстИсключения = НСтр("ru = 'В документе выбран первичный документ ""Акт приемки товаров, работ, услуг"",
				|но не найден соответствующий ""Акт приемки"" или он помечен на удаление.
				|Проверьте правильность заполнения ""Акта приемки товаров, работ, услуг"" и после этого проведите текущий документ'");
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;
	КонецЕсли;
	Если ИспользуетсяАктПриемкиТРУ Тогда
		ДобавитьПараметрСхемыФормированияПроводокЕстьНеНайден(СхемаКомпоновки, "АктПриемкиТРУ");
		ДобавитьПараметрСхемыФормированияПроводокЕстьНеНайден(СхемаКомпоновки, "АктПриемкиТРУДата");
		ДобавитьПараметрСхемыФормированияПроводокЕстьНеНайден(СхемаКомпоновки, "АктПриемкиТРУНомер");
	КонецЕсли;

	ДокументОснование = ПараметрыИнициализации.ДокументОснование;
	НаборСвойств = ПараметрыИнициализации.НаборСвойств;
	
	ВсеПараметрыСхемы = Новый Структура;
	Для каждого ПараметрСхемы Из СхемаКомпоновки.Параметры Цикл
		ВсеПараметрыСхемы.Вставить(ПараметрСхемы.Имя, ПараметрСхемы);
	КонецЦикла;
	
	ЕстьВидМежотчетногоПериода = ДанныеДокумента.Свойство("ВидМежотчетногоПериода", ЗначениеВидМежотчетногоПериода);
	Если ЕстьВидМежотчетногоПериода Тогда
		ПараметрВидМежотчетногоПериода = СхемаКомпоновки.Параметры.Найти("ВидМежотчетногоПериода");
		Если ПараметрВидМежотчетногоПериода <> Неопределено Тогда
			ПараметрВидМежотчетногоПериода.Значение = ЗначениеВидМежотчетногоПериода;
		КонецЕсли;
	КонецЕсли;

	// Функциональные опции
	СтрокаФО = "ИспользоватьВалютныйУчет,ИспользоватьУчетПоИФО,ИспользоватьУчетПоПодразделениям";
	Для Каждого ИмяФО Из СтрРазделить(СтрокаФО, ",") Цикл
		УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы,
			ИмяФО, ПолучитьФункциональнуюОпцию(ИмяФО));
	КонецЦикла;
	
	// Константы
	УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы,
		"ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы,
		"ИмяТабличнойЧасти", "РасшифровкаПлатежа");
	
	// Списки счетов
	СчетаДляСхемы = ПолучитьСчетаДляСхемыФормированияПроводок();
	УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы,
		"ВалютныеСчета", СчетаДляСхемы.ВалютныеСчета);
	УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы,
		"КоличественныеСчета", СчетаДляСхемы.КоличественныеСчета);
	
	// Данные документа
	УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы,
		"Документ", ДокументОснование);
	УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы,
		"Период", ПараметрыИнициализации.Дата);
	СтрокаРеквизитовДокумента = "ТиповаяОперация,Организация";
	Для Каждого ИмяРеквизитаДокумента Из СтрРазделить(СтрокаРеквизитовДокумента, ",") Цикл
		УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы,
			ИмяРеквизитаДокумента, ПараметрыИнициализации[ИмяРеквизитаДокумента]);
	КонецЦикла;

	// Курс и кратность
	РеквизитыКурсИКратностьДокумента = КурсИКратностьДляСхемыФормированияПроводок(ДокументОснование, НаборСвойств);
	УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы, "Курс",
		РеквизитыКурсИКратностьДокумента.Курс);
	УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы, "Кратность",
		РеквизитыКурсИКратностьДокумента.Кратность);
	
	// Первичный документ
	Если ИспользуетсяДокументКонтрагента Тогда
		ЗначениеПараметра = Неопределено;
	ИначеЕсли ЗначениеЗаполнено(ЗначениеПервичныйДокумент) Тогда
		ЗначениеПараметра = ПервичныеДокументыБГУ.ВидПервичногоДокумента(ЗначениеПервичныйДокумент);
	КонецЕсли;
	УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы, "ПервичныйДокумент",
		ЗначениеПараметра, Истина);
	Если ИспользуетсяАктПриемкиТРУ Тогда
		УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы,
			"АктПриемкиТРУ", ДанныеАктаПриемкиТРУ.Ссылка);
		УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы,
			"АктПриемкиТРУДата", ДанныеАктаПриемкиТРУ.Дата);
		УстановитьЗначениеПараметраСхемыФормированияПроводокПоИмени(ВсеПараметрыСхемы, НастройкиСхемы,
			"АктПриемкиТРУНомер",
			БухгалтерскиеОперации.ПолучитьНомерДляПечатиПоНастройке(
				ДанныеАктаПриемкиТРУ.Ссылка,
				ДанныеАктаПриемкиТРУ.Номер));
	КонецЕсли;
	
	// Оставшиеся параметры
	Для Каждого ОписаниеПараметраСхемы Из ВсеПараметрыСхемы Цикл
		ПараметрСхемы = ОписаниеПараметраСхемы.Значение;
		ЗначениеПараметра = ЗначениеПараметраДляСхемыФормированияПроводок(ПараметрСхемы.Имя, ПараметрСхемы.Значение,
			НаборПроводок);
		УстановитьЗначениеПараметраСхемыФормированияПроводок(НастройкиСхемы, ПараметрСхемы, ЗначениеПараметра);
	КонецЦикла;
	
КонецПроцедуры

Функция ИспользуетсяПервичныйДокументАктПриемкиТРУ(СхемаКомпоновки)
	Параметр = СхемаКомпоновки.Параметры.Найти("АктПриемкиТРУ");
	Если Параметр = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Параметр.Значение);
КонецФункции

Процедура ОбработатьФормулыПервичногоДокумента(СхемаКомпоновки, ДанныеДокумента)
	
	Если Не ДанныеДокумента.Свойство("ПервичныйДокумент") Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоВходящийАкт0510448 = ДанныеДокумента.ЭтоВходящийПоЭДОАктПриемки0510448;
	ИспользуетсяПервичныйДокументАктПриемкиТРУ = ИспользуетсяПервичныйДокументАктПриемкиТРУ(СхемаКомпоновки);
	
	ВидПервичногоДокумента = СхемаКомпоновки.ВычисляемыеПоля.Найти("ВидПервичногоДокумента");
	Если ЭтоВходящийАкт0510448 Тогда
		ВидПервичногоДокумента.Выражение = "&ПервичныйДокумент";
	Иначе
		ВидПервичногоДокумента.Выражение =
		"ВЫБОР
		|КОГДА НастройкаПроводок.ИспользоватьФормулуПервичногоДокумента = ЛОЖЬ И ЗНАЧЕНИЕЗАПОЛНЕНО(&ПервичныйДокумент)
		|ТОГДА &ПервичныйДокумент
		|ИНАЧЕ " + ВидПервичногоДокумента.Выражение + "
		|КОНЕЦ";
	КонецЕсли;
	
	НомерПервичногоДокумента = СхемаКомпоновки.ВычисляемыеПоля.Найти("НомерПервичногоДокумента");
	Если ЭтоВходящийАкт0510448 Тогда
		НомерПервичногоДокумента.Выражение = "Документ.НомерПервичногоДокумента";
	ИначеЕсли ИспользуетсяПервичныйДокументАктПриемкиТРУ Тогда
		НомерПервичногоДокумента.Выражение =
		"ВЫБОР
		|КОГДА НастройкаПроводок.ИспользоватьФормулуПервичногоДокумента = ЛОЖЬ И ЗНАЧЕНИЕЗАПОЛНЕНО(&ПервичныйДокумент)
		|ТОГДА &АктПриемкиТРУНомер
		|ИНАЧЕ " + НомерПервичногоДокумента.Выражение + "
		|КОНЕЦ";
	Иначе
		НомерПервичногоДокумента.Выражение =
		"ВЫБОР
		|КОГДА НастройкаПроводок.ИспользоватьФормулуПервичногоДокумента = ЛОЖЬ И ЗНАЧЕНИЕЗАПОЛНЕНО(&ПервичныйДокумент)
		|ТОГДА БухгалтерскиеОперации.ПолучитьНомерДляПечатиПоНастройке(Документ.Ссылка, Документ.Номер)
		|ИНАЧЕ " + НомерПервичногоДокумента.Выражение + "
		|КОНЕЦ";
	КонецЕсли;
	
	ДатаПервичногоДокумента = СхемаКомпоновки.ВычисляемыеПоля.Найти("ДатаПервичногоДокумента");
	Если ЭтоВходящийАкт0510448 Тогда
		ДатаПервичногоДокумента.Выражение = "Документ.ДатаПервичногоДокумента";
	ИначеЕсли ИспользуетсяПервичныйДокументАктПриемкиТРУ Тогда
		ДатаПервичногоДокумента.Выражение =
		"ВЫБОР
		|КОГДА НастройкаПроводок.ИспользоватьФормулуПервичногоДокумента = ЛОЖЬ И ЗНАЧЕНИЕЗАПОЛНЕНО(&ПервичныйДокумент)
		|ТОГДА &АктПриемкиТРУДата
		|ИНАЧЕ " + ДатаПервичногоДокумента.Выражение + "
		|КОНЕЦ";
	Иначе
		ДатаПервичногоДокумента.Выражение =
		"ВЫБОР
		|КОГДА НастройкаПроводок.ИспользоватьФормулуПервичногоДокумента = ЛОЖЬ И ЗНАЧЕНИЕЗАПОЛНЕНО(&ПервичныйДокумент)
		|ТОГДА Документ.Дата
		|ИНАЧЕ " + ДатаПервичногоДокумента.Выражение + "
		|КОНЕЦ";
	КонецЕсли;
	
КонецПроцедуры

// Инициализировать схему формирования проводок.
// 
// Параметры:
//  СхемаКомпоновки - СхемаКомпоновкиДанных
//  НастройкиСхемы - КомпоновщикНастроекКомпоновкиДанных
//  ПараметрыИнициализации - Структура
Процедура ИнициализироватьСхемуФормированияПроводок(СхемаКомпоновки,
		НастройкиСхемы, ПараметрыИнициализации) Экспорт

	ТиповаяОперация = ПараметрыИнициализации.ТиповаяОперация;
	ДокументОснование = ПараметрыИнициализации.ДокументОснование;

	НастройкиСхемы = Новый КомпоновщикНастроекКомпоновкиДанных;

	НастройкиСхемы.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки);
	НастройкиСхемы.Инициализировать(ИсточникНастроек);
	
	МетаданныеДокумента = ДокументОснование.Метаданные();
	ДанныеДокумента = ДанныеДокументаДляСхемыФормированияПроводок(ДокументОснование, МетаданныеДокумента);

//	ЕстьВидМежотчетногоПериода = ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ВидМежотчетногоПериода", МетаданныеДокумента);

	НаборПроводок = НаборПроводокДляСхемыФормированияПроводок(ТиповаяОперация);
	ЗаполнитьПараметрыСхемыФормированияПроводок(СхемаКомпоновки, НастройкиСхемы, ДанныеДокумента,
		ПараметрыИнициализации, НаборПроводок);
	
//	ЕстьПервичныйДокумент = ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ПервичныйДокумент", МетаданныеДокумента);
//	Если ЕстьПервичныйДокумент Тогда
//		ИзменитьФормулуЗаполненияПервичногоДокумента(СхемаКомпоновки, НастройкиСхемы, ДанныеДокумента);
//	КонецЕсли;
	ОбработатьФормулыПервичногоДокумента(СхемаКомпоновки, ДанныеДокумента);	
	ДобавитьВФормулыДатуПроведенияДокументаИзРегистра(СхемаКомпоновки, ДокументОснование);

КонецПроцедуры

Функция АктПриемкиТРУПоДокументу(ПоступлениеНФА)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТабДокумент.Ссылка,
	|	ТабДокумент.Номер,
	|	ТабДокумент.Дата
	|ИЗ
	|	Документ.АктПриемкиТоваровРаботУслуг.ДокументыПоступления КАК ТабДокументыПоступления
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктПриемкиТоваровРаботУслуг КАК ТабДокумент
	|	ПО ТабДокументыПоступления.Ссылка = ТабДокумент.Ссылка
	|ГДЕ
	|	ТабДокументыПоступления.ДокументОснование = &ПоступлениеНФА
	|	И Не ТабДокумент.ПометкаУдаления";
	Запрос.УстановитьПараметр("ПоступлениеНФА", ПоступлениеНФА);
	Результат = Новый Структура("Ссылка, Дата, Номер");
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

Процедура ДобавитьВФормулыДатуПроведенияДокументаИзРегистра(СхемаКомпоновки, ДокументОснование)
	Если Не ПрименяетсяОтдельнаяДатаПроведенияДокументаИзРегистра(ТипЗнч(ДокументОснование.Ссылка)) Тогда
		Возврат;
	КонецЕсли;
	ПолеПериод = СхемаКомпоновки.ВычисляемыеПоля.Найти("Период");
	ПолеПериод.Выражение =
		"ВЫБОР
		|	КОГДА ЗНАЧЕНИЕЗАПОЛНЕНО(ФактическаяДатаПроведения)
		|		ТОГДА ФактическаяДатаПроведения
		|	ИНАЧЕ "
		+ ПолеПериод.Выражение
		+ "
		|	КОНЕЦ";
	НаборДанныеДокумента = СхемаКомпоновки.НаборыДанных.Найти("ДанныеДокумента");
	Для Каждого НаборДанных Из НаборДанныеДокумента.Элементы Цикл
		ПолеДатаПроведения = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеДатаПроведения.Поле = "ФактическаяДатаПроведения";
		ПолеДатаПроведения.ПутьКДанным = "ФактическаяДатаПроведения";
	КонецЦикла;
	ПолеДатаПроведения = НаборДанныеДокумента.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	ПолеДатаПроведения.Поле = "ФактическаяДатаПроведения";
	ПолеДатаПроведения.ПутьКДанным = "ФактическаяДатаПроведения";
КонецПроцедуры

Функция ПрименяетсяОтдельнаяДатаПроведенияДокументаИзРегистра(ТипДокумента)
	Возврат Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипДокумента);
КонецФункции

Процедура ПодготовитьНастройкуДополнительныхИсточниковДанных(ТиповаяОперация,
		НастройкаДополнительныхИсточниковДанных)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника.Ссылка.ИмяИсточника КАК ИмяИсточника,
		|	ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника.Ссылка.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
		|	ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника.ИмяКолонки,
		|	ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника.Ресурс
		|ИЗ
		|	Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций.КолонкиИсточника КАК ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника
		|ГДЕ
		|	ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника.Ссылка.Владелец = &ТиповаяОперация
		|	И ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника.Ссылка.СпособЗаполнения = &СпособЗаполнения
		|ИТОГИ ПО
		|	ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника.Ссылка";
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	Запрос.УстановитьПараметр("СпособЗаполнения", Перечисления.СпособыЗаполненияДополнительныхИсточниковДанныхТО.ДанныеДокумента);

	НастройкаДополнительныхИсточниковДанных = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл

		КолонкиГруппировки = "";
		КолонкиСуммирования = "";
		ВыборкаДетальная = Выборка.Выбрать();
		Пока ВыборкаДетальная.Следующий() Цикл

			Если ВыборкаДетальная.Ресурс Тогда
				КолонкиСуммирования = КолонкиСуммирования + ","
					+ ВыборкаДетальная.ИмяКолонки;
			Иначе
				КолонкиГруппировки = КолонкиГруппировки + ","
					+ ВыборкаДетальная.ИмяКолонки;
			КонецЕсли;

		КонецЦикла;

		НастройкаДополнительныхИсточниковДанных.Вставить(Выборка.ИмяТабличнойЧасти, Новый Структура("Имя, КолонкиГруппировки, КолонкиСуммирования", Выборка.ИмяИсточника, КолонкиГруппировки, КолонкиСуммирования));

	КонецЦикла;

КонецПроцедуры

Функция СоздатьИсточникДанныхИзОбъекта(ТекущийОбъект,
		ТиповаяОперация = Неопределено) Экспорт
	Перем ДанныеДополнительныхТабЧастей;
	Перем НастройкаДополнительныхИсточниковДанных;

	Если НЕ ТекущийОбъект.ДополнительныеСвойства.Свойство("ДанныеДополнительныхТабЧастей", ДанныеДополнительныхТабЧастей) Тогда
		ДанныеДополнительныхТабЧастей = ПолучитьСохраненныеЗначенияДополнительныхТабличныхЧастей(ТекущийОбъект);
	КонецЕсли;

	ИсточникиДанных = Новый Структура;

	НастройкаДополнительныхТабЧастей = НастройкаДополнительныхТабЧастей(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ТекущийОбъект.Ссылка)));

	МетаданныеДокумента = ТекущийОбъект.Метаданные();

	Если ТиповаяОперация <> Неопределено Тогда

		ПодготовитьНастройкуДополнительныхИсточниковДанных(ТиповаяОперация, НастройкаДополнительныхИсточниковДанных);

	КонецЕсли;

	ТаблицаШапка = Новый ТаблицаЗначений;
	ТаблицаШапка.Колонки.Добавить("ИмяТабличнойЧасти");
	ТаблицаШапка.Колонки.Добавить("Ссылка");
	ТаблицаШапка.Колонки.Добавить("РеквизитШапкиДата");
	ТаблицаШапка.Колонки.Добавить("РеквизитШапкиНомер");
	ОбщаяСтрокаРеквизитов = "ИмяТабличнойЧасти,Ссылка,РеквизитШапкиДата,РеквизитШапкиНомер";

	Для каждого ТекРеквизит Из МетаданныеДокумента.Реквизиты Цикл

		ТаблицаШапка.Колонки.Добавить("РеквизитШапки" + ТекРеквизит.Имя);
		ОбщаяСтрокаРеквизитов = ОбщаяСтрокаРеквизитов + ",РеквизитШапки"
			+ ТекРеквизит.Имя;

	КонецЦикла;
	Если МетаданныеДокумента.Реквизиты.Найти("ВалютаДокумента") = Неопределено Тогда
		ТаблицаШапка.Колонки.Добавить("РеквизитШапкиВалютаДокумента");
		ОбщаяСтрокаРеквизитов = ОбщаяСтрокаРеквизитов
			+ ",РеквизитШапкиВалютаДокумента";
	КонецЕсли;

	СтрокаШапки = ТаблицаШапка.Добавить();
	СтрокаШапки.РеквизитШапкиДата = ТекущийОбъект.Дата;
	СтрокаШапки.РеквизитШапкиНомер = ТекущийОбъект.Номер;
	СтрокаШапки.ИмяТабличнойЧасти = ""; /////////////////////////////////
	СтрокаШапки.Ссылка = ТекущийОбъект.Ссылка;
	Для каждого ТекРеквизит Из МетаданныеДокумента.Реквизиты Цикл

		СтрокаШапки["РеквизитШапки"
			+ ТекРеквизит.Имя] = ТекущийОбъект[ТекРеквизит.Имя];

	КонецЦикла;

	ИсточникиДанных.Вставить("Документ", ТаблицаШапка);
	ОбработаныТЧ = Новый Массив;

	Для каждого ТекТабЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл

		ТаблицаТЧ = ТаблицаШапка.СкопироватьКолонки();

		ТаблицаТЧ.Колонки.Добавить("НомерСтроки");

		Для каждого ТекРеквизит Из МетаданныеДокумента.ТабличныеЧасти[ТекТабЧасть.Имя].Реквизиты Цикл

			ТаблицаТЧ.Колонки.Добавить(ТекРеквизит.Имя);

		КонецЦикла;

		///////// добавим колонки доп. таб частей		
		ТекДопТабЧасть = НастройкаДополнительныхТабЧастей.Получить(ТекТабЧасть.Имя);
		Если ТекДопТабЧасть <> Неопределено Тогда
			ОбработаныТЧ.Добавить(ТекТабЧасть.Имя);
			Для каждого ТекДопРеквизит Из ТекДопТабЧасть.Реквизиты Цикл

				ТаблицаТЧ.Колонки.Добавить(ТекДопРеквизит.Значение.ИмяРеквизита, ТекДопРеквизит.Значение.ТипЗначения);

			КонецЦикла;
		КонецЕсли;

		Для Каждого ТекСтрока Из ТекущийОбъект[ТекТабЧасть.Имя] Цикл
			НоваяСтрока = ТаблицаТЧ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаШапки);

			Если ТекДопТабЧасть <> Неопределено Тогда
				СтрокиДопРеквизитов = ДанныеДополнительныхТабЧастей.НайтиСтроки(Новый Структура("ТабличнаяЧасть, НомерСтрокиДокумента", ТекДопТабЧасть.СсылкаТабличнойЧасти, ТекСтрока.НомерСтроки));
				Для каждого ТекЗаписьДопРеквизита Из СтрокиДопРеквизитов Цикл

					СвойстваТекДопРеквизита = ТекДопТабЧасть.Реквизиты.Получить(ТекЗаписьДопРеквизита.КолонкаТабличнойЧасти);
					Если СвойстваТекДопРеквизита <> Неопределено Тогда
						НоваяСтрока[СвойстваТекДопРеквизита.ИмяРеквизита] = ТекЗаписьДопРеквизита.Значение;
					КонецЕсли;

				КонецЦикла;

			КонецЕсли;
		КонецЦикла;
		ТаблицаТЧ.ЗаполнитьЗначения(ТекТабЧасть.Имя, "ИмяТабличнойЧасти");

		ИсточникиДанных.Вставить(ТекТабЧасть.Имя, ТаблицаТЧ);

	КонецЦикла;

	Для каждого ТекНастройка Из НастройкаДополнительныхТабЧастей Цикл

		Если ОбработаныТЧ.Найти(ТекНастройка.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ТаблицаТЧ = ТаблицаШапка.СкопироватьКолонки();

		ТаблицаТЧ.Колонки.Добавить("НомерСтроки");

		// добавим колонки доп. таб частей
		ТекДопТабЧасть = ТекНастройка.Значение;
		Если ТекДопТабЧасть <> Неопределено Тогда
			ОбработаныТЧ.Добавить(ТекТабЧасть.Имя);
			Для каждого ТекДопРеквизит Из ТекДопТабЧасть.Реквизиты Цикл

				ТаблицаТЧ.Колонки.Добавить(ТекДопРеквизит.Значение.ИмяРеквизита, ТекДопРеквизит.Значение.ТипЗначения);

			КонецЦикла;
		КонецЕсли;

		СтрокиДопРеквизитов = ДанныеДополнительныхТабЧастей.НайтиСтроки(Новый Структура("ТабличнаяЧасть", ТекДопТабЧасть.СсылкаТабличнойЧасти));
		МаксНомерСтроки = 0;
		Для каждого ТекСтрока Из СтрокиДопРеквизитов Цикл

			МаксНомерСтроки = ?(МаксНомерСтроки < ТекСтрока.НомерСтрокиДокумента, ТекСтрока.НомерСтрокиДокумента, МаксНомерСтроки);

		КонецЦикла;
		Для А = 1 По МаксНомерСтроки Цикл
			НоваяСтрока = ТаблицаТЧ.Добавить();
			НоваяСтрока.НомерСтроки = А;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаШапки);
			НоваяСтрока.ИмяТабличнойЧасти = ТекНастройка.Ключ;
		КонецЦикла;
		Для Каждого ТекСтрока Из ТаблицаТЧ Цикл
			СтрокиДопРеквизитов = ДанныеДополнительныхТабЧастей.НайтиСтроки(Новый Структура("ТабличнаяЧасть, НомерСтрокиДокумента", ТекНастройка.Значение.СсылкаТабличнойЧасти, ТекСтрока.НомерСтроки));
			Для каждого ТекЗаписьДопРеквизита Из СтрокиДопРеквизитов Цикл

				СвойстваТекДопРеквизита = ТекДопТабЧасть.Реквизиты.Получить(ТекЗаписьДопРеквизита.КолонкаТабличнойЧасти);
				Если СвойстваТекДопРеквизита <> Неопределено Тогда
					ТекСтрока[СвойстваТекДопРеквизита.ИмяРеквизита] = ТекЗаписьДопРеквизита.Значение;
				КонецЕсли;

			КонецЦикла;
		КонецЦикла;
		ИсточникиДанных.Вставить(ТекНастройка.Ключ, ТаблицаТЧ);

	КонецЦикла;

	Если ПустаяСтрока(ТекущийОбъект.Номер) Тогда

		Для каждого Источник Из ИсточникиДанных Цикл

			Источник.Значение.ЗаполнитьЗначения("<<НомерДокумента>>", "РеквизитШапкиНомер")
		КонецЦикла;

	КонецЕсли;

	Если НастройкаДополнительныхИсточниковДанных <> Неопределено Тогда
		Для каждого ТекДопИсточник Из НастройкаДополнительныхИсточниковДанных Цикл
			Таблица = Неопределено;
			Если НЕ ИсточникиДанных.Свойство(ТекДопИсточник.Ключ, Таблица) Тогда
				Продолжить;
			КонецЕсли;

			КопияТаблицы = Таблица.Скопировать(, ОбщаяСтрокаРеквизитов
				+ ТекДопИсточник.Значение.КолонкиГруппировки
				+ ТекДопИсточник.Значение.КолонкиСуммирования);
			КопияТаблицы.Свернуть(ОбщаяСтрокаРеквизитов
				+ ТекДопИсточник.Значение.КолонкиГруппировки, ТекДопИсточник.Значение.КолонкиСуммирования);

			Для каждого ТекСтрока Из КопияТаблицы Цикл

				ТекСтрока.ИмяТабличнойЧасти = ТекДопИсточник.Значение.Имя;

			КонецЦикла;

			ИсточникиДанных.Вставить(ТекДопИсточник.Значение.Имя, КопияТаблицы);

		КонецЦикла;
	КонецЕсли;

	Возврат ИсточникиДанных;

КонецФункции

Функция ПолучитьИсточникиДанныхИзОбъекта(ИдентификаторОбъекта, ДокументОбъект,
		ТиповаяОперация, ЗначенияДопРеквизитов, ОписаниеИсточников,
		СоответствиеДопИсточников = Неопределено, Отказ = Ложь) Экспорт

	ИсточникиДанных = СоздатьИсточникиДанныхПоОписанию(ОписаниеИсточников);

	// Добавим в структуру ДокументОбъект для использования в функциях общего модуля БухгалтерскиеОперацииИсточникиДанных.
	ИсточникиДанных.Вставить("ДокументОбъект", ДокументОбъект);

	ДанныеДополнительныхТабЧастей = ПолучитьСохраненныеЗначенияДополнительныхТабличныхЧастей(ДокументОбъект.Ссылка);
	НастройкаДополнительныхТабЧастей = НастройкаДополнительныхТабЧастей(ИдентификаторОбъекта);

	// заполнение данных в источники
	ОбщаяСтрокаРеквизитов = "ИмяТабличнойЧасти,";
	Префикс = ПрефиксКолонкиИсточникаДанных("Документ");
	ОбщиеДанныеТаблицы = Новый Структура;
	ОбщиеДанныеТаблицы.Вставить("ТиповаяОперация", ТиповаяОперация);
	Для каждого Реквизит Из ОписаниеИсточников.Реквизиты Цикл

		ОбщиеДанныеТаблицы.Вставить(Префикс
			+ Реквизит.Имя, ДокументОбъект[Реквизит.Имя]);
		ОбщаяСтрокаРеквизитов = ОбщаяСтрокаРеквизитов + Префикс + Реквизит.Имя
			+ ",";

	КонецЦикла;

	// к общим данным добавляются значения доп реквизитов
	Префикс = ПрефиксКолонкиИсточникаДанных("ДополнительныйРеквизит");
	Для каждого Реквизит Из ОписаниеИсточников.ДополнительныеРеквизиты Цикл

		ЗначениеТекДопРеквизита = Неопределено;
		Если ЗначенияДопРеквизитов.Свойство(Реквизит.Имя, ЗначениеТекДопРеквизита)
				И ЗначениеЗаполнено(ЗначениеТекДопРеквизита) Тогда
			ОбщиеДанныеТаблицы.Вставить(Префикс
				+ Реквизит.Имя, ЗначениеТекДопРеквизита);
		КонецЕсли;

	КонецЦикла;

	ЗаполнитьЗначенияСвойств(ИсточникиДанных.Документ.Добавить(), ОбщиеДанныеТаблицы);
	ЗаполнитьВсеИсточникиДанныхПоТаблицамДокумента(
		ОписаниеИсточников.ТабличныеЧасти,
		НастройкаДополнительныхТабЧастей,
		ИсточникиДанных,
		ДокументОбъект,
		ДанныеДополнительныхТабЧастей,
		ОбщиеДанныеТаблицы);

	Для каждого ТабличнаяЧасть Из ОписаниеИсточников.ТабличныеЧасти Цикл
		ОписаниеТЧ = ТабличнаяЧасть.Значение;

		Если ОписаниеТЧ.Предопределенный Тогда
			Продолжить;
		КонецЕсли;

		ТекДопТабЧасть = НастройкаДополнительныхТабЧастей.Получить(ОписаниеТЧ.Имя);

		Префикс = ПрефиксКолонкиИсточникаДанных(ОписаниеТЧ.Имя);
		ТЧ = Неопределено;
		ИсточникиДанных.Свойство(ОписаниеТЧ.Имя, ТЧ);

		ДанныеТекущейДопТЧ = ДанныеДополнительныхТабЧастей.Скопировать(Новый Структура("ТабличнаяЧасть", ТекДопТабЧасть.СсылкаТабличнойЧасти), "КолонкаТабличнойЧасти, НомерСтрокиДокумента, ИмяКолонкиТабличнойЧасти, Значение");

		НомераСтрокТекущейДопТЧ = ДанныеТекущейДопТЧ.Скопировать(, "НомерСтрокиДокумента");
		НомераСтрокТекущейДопТЧ.Свернуть("НомерСтрокиДокумента");
		НомераСтрокТекущейДопТЧ.Сортировать("НомерСтрокиДокумента");

		Для Каждого НомерСтроки Из НомераСтрокТекущейДопТЧ Цикл

			ТаблицаСтрокиДопТЧ = ДанныеТекущейДопТЧ.Скопировать(Новый Структура("НомерСтрокиДокумента", НомерСтроки.НомерСтрокиДокумента));

			НоваяСтрока = ТЧ.Добавить();
			НоваяСтрока.НомерСтроки = НомерСтроки.НомерСтрокиДокумента;
			НоваяСтрока.ИмяТабличнойЧасти = ОписаниеТЧ.Имя;

			Для каждого РеквизитСтрокиДопТЧ Из ТаблицаСтрокиДопТЧ Цикл

				НоваяСтрока[Префикс
					+ РеквизитСтрокиДопТЧ.ИмяКолонкиТабличнойЧасти] = РеквизитСтрокиДопТЧ.Значение;

			КонецЦикла;

			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОбщиеДанныеТаблицы);

		КонецЦикла;

	КонецЦикла;

	СоответствиеДопИсточников = Новый Соответствие;
	НастройкаДополнительныхИсточниковДанных = Неопределено;
	Если ТиповаяОперация <> Неопределено Тогда

		ПодготовитьНастройкуДополнительныхИсточниковДанных(ТиповаяОперация, НастройкаДополнительныхИсточниковДанных);

		Для каждого ТекДопИсточник Из НастройкаДополнительныхИсточниковДанных Цикл
			Таблица = Неопределено;
			Если НЕ ИсточникиДанных.Свойство(ТекДопИсточник.Ключ, Таблица) Тогда
				Продолжить;
			КонецЕсли;
			СоответствиеДопИсточников.Вставить(ТекДопИсточник.Значение.Имя, ТекДопИсточник.Ключ);

			СтрокаГруппируемыхКолонок = Сред(ОбщаяСтрокаРеквизитов, 1, СтрДлина(ОбщаяСтрокаРеквизитов)
				- ?(Прав(ОбщаяСтрокаРеквизитов, 1) = ",", 1, 0));
			СтрокаСуммируемыхКолонок = "";
			ПрефиксИсходнойТаблицы = ПрефиксКолонкиИсточникаДанных(ТекДопИсточник.Ключ);
			ПрефиксНовойТаблицы = ПрефиксКолонкиИсточникаДанных(ТекДопИсточник.Значение.Имя);

			КолонкиГруппировки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ТекДопИсточник.Значение.КолонкиГруппировки);
			КолонкиСуммирования = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ТекДопИсточник.Значение.КолонкиСуммирования);

			КопияТаблицы = Таблица.СкопироватьКолонки(ОбщаяСтрокаРеквизитов);
			Для каждого ТекИмяКолонки Из КолонкиГруппировки Цикл

				КопияТаблицы.Колонки.Добавить(ПрефиксНовойТаблицы
					+ ТекИмяКолонки, Таблица.Колонки[ПрефиксИсходнойТаблицы
					+ ТекИмяКолонки].ТипЗначения);
				СтрокаГруппируемыхКолонок = СтрокаГруппируемыхКолонок + ","
					+ ПрефиксНовойТаблицы + ТекИмяКолонки;

			КонецЦикла;
			Для каждого ТекИмяКолонки Из КолонкиСуммирования Цикл

				КопияТаблицы.Колонки.Добавить(ПрефиксНовойТаблицы
					+ ТекИмяКолонки, Таблица.Колонки[ПрефиксИсходнойТаблицы
					+ ТекИмяКолонки].ТипЗначения);
				СтрокаСуммируемыхКолонок = СтрокаСуммируемыхКолонок + ПрефиксНовойТаблицы
					+ ТекИмяКолонки + ",";

			КонецЦикла;
			СтрокаСуммируемыхКолонок = Лев(СтрокаСуммируемыхКолонок, СтрДлина(СтрокаСуммируемыхКолонок)
				- 1);

			Для каждого ТекСтрока Из Таблица Цикл

				НоваяСтрока = КопияТаблицы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока, ОбщаяСтрокаРеквизитов);
				Для каждого ТекИмяКолонки Из КолонкиГруппировки Цикл

					НоваяСтрока[ПрефиксНовойТаблицы
						+ ТекИмяКолонки] = ТекСтрока[ПрефиксИсходнойТаблицы + ТекИмяКолонки];

				КонецЦикла;
				Для каждого ТекИмяКолонки Из КолонкиСуммирования Цикл

					НоваяСтрока[ПрефиксНовойТаблицы
						+ ТекИмяКолонки] = ТекСтрока[ПрефиксИсходнойТаблицы + ТекИмяКолонки];

				КонецЦикла;
				НоваяСтрока.ИмяТабличнойЧасти = ТекДопИсточник.Значение.Имя;

			КонецЦикла;

			КопияТаблицы.Свернуть(СтрокаГруппируемыхКолонок, СтрокаСуммируемыхКолонок);

			// добавить колонки доп. реквизитов
			Префикс = ПрефиксКолонкиИсточникаДанных("ДополнительныйРеквизит");
			Для каждого Реквизит Из ОписаниеИсточников.ДополнительныеРеквизиты Цикл

				КопияТаблицы.Колонки.Добавить(Префикс
					+ Реквизит.Имя, Реквизит.ТипЗначения);
				ЗначениеТекДопРеквизита = Неопределено;
				Если ЗначенияДопРеквизитов.Свойство(Реквизит.Имя, ЗначениеТекДопРеквизита)
						И (ЗначениеТекДопРеквизита = Ложь
						ИЛИ ЗначениеЗаполнено(ЗначениеТекДопРеквизита)) Тогда
					КопияТаблицы.ЗаполнитьЗначения(ЗначениеТекДопРеквизита, Префикс
						+ Реквизит.Имя);
				КонецЕсли;

			КонецЦикла;

			ИсточникиДанных.Вставить(ТекДопИсточник.Значение.Имя, КопияТаблицы);

		КонецЦикла;

	КонецЕсли;

	ВсеДополнительныеИсточники = Справочники.ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПолучитьИсточникиДанных(ТиповаяОперация);
	Для каждого ДополнительныйИсточник Из ВсеДополнительныеИсточники Цикл
		ТаблицаИсточника = Справочники.ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПолучитьЗаполнитьИсточникДанных(ДополнительныйИсточник.Ссылка, ТиповаяОперация, ИсточникиДанных, ДополнительныйИсточник);

		// проверим не изменился ли признак Отказ, после заполнения таблицы источника
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		Если КонтекстПроведения.Отказ = Истина Тогда
			Отказ = Истина;
			Возврат ИсточникиДанных;
		КонецЕсли;

		ТаблицаИсточника.ЗаполнитьЗначения(ДополнительныйИсточник.ИмяИсточника, "ИмяТабличнойЧасти");

		Для каждого ТекРеквизит Из ОписаниеИсточников.Реквизиты Цикл

			ИмяКолонки = ПрефиксКолонкиИсточникаДанных("Документ") + ТекРеквизит.Имя;
			ТаблицаИсточника.Колонки.Добавить(ИмяКолонки, ТекРеквизит.ТипЗначения);
			ТаблицаИсточника.ЗаполнитьЗначения(ИсточникиДанных.Документ[0][ИмяКолонки], ИмяКолонки);

		КонецЦикла;

		Для каждого ТекДопРеквизит Из ОписаниеИсточников.ДополнительныеРеквизиты Цикл

			ИмяКолонки = ПрефиксКолонкиИсточникаДанных("ДополнительныйРеквизит")
				+ ТекДопРеквизит.Имя;
			ТаблицаИсточника.Колонки.Добавить(ИмяКолонки, ТекДопРеквизит.ТипЗначения);
			ТаблицаИсточника.ЗаполнитьЗначения(ИсточникиДанных.Документ[0][ИмяКолонки], ИмяКолонки);

		КонецЦикла;

		// добавить колонки дополнительных источников данных и заполнить их данными
		Если ТаблицаИсточника.Колонки.Найти("НомерСтроки") <> Неопределено
				И ТаблицаИсточника.Колонки.Найти("ИмяСписка") <> Неопределено
				И ДанныеДополнительныхТабЧастей.Количество() > 0 Тогда

			Для каждого НастройкаТабЧасти Из НастройкаДополнительныхТабЧастей Цикл

				Для каждого КлючРеквизита Из НастройкаТабЧасти.Значение.Реквизиты Цикл

					ИмяКолонкиДопИсточника = КлючРеквизита.Значение.ИмяРеквизита;
					СуществующаяКолонкаДопИсточника = ТаблицаИсточника.Колонки.Найти(ИмяКолонкиДопИсточника);
					Если СуществующаяКолонкаДопИсточника = Неопределено Тогда
						ТаблицаИсточника.Колонки.Добавить(ИмяКолонкиДопИсточника, КлючРеквизита.Значение.ТипЗначения);
					Иначе
						ИсходныйТипИзменяемойКолонки = СуществующаяКолонкаДопИсточника.ТипЗначения;
						ИсходныйТипСоответствует = Истина;
						Для каждого ЧастьНовогоТипаКолонки Из КлючРеквизита.Значение.ТипЗначения.Типы() Цикл

							Если Не ИсходныйТипИзменяемойКолонки.СодержитТип(ЧастьНовогоТипаКолонки) Тогда
								ИсходныйТипСоответствует = Ложь;
								Прервать;
							КонецЕсли;

						КонецЦикла;
						Если Не ИсходныйТипСоответствует Тогда
							ДанныеКолонки = ТаблицаИсточника.ВыгрузитьКолонку(ИмяКолонкиДопИсточника);
							НовыйТипИзменяемойКолонки = Новый ОписаниеТипов(ИсходныйТипИзменяемойКолонки, КлючРеквизита.Значение.ТипЗначения.Типы());
							ТаблицаИсточника.Колонки.Удалить(ИмяКолонкиДопИсточника);
							ТаблицаИсточника.Колонки.Добавить(ИмяКолонкиДопИсточника, НовыйТипИзменяемойКолонки);
							ТаблицаИсточника.ЗагрузитьКолонку(ДанныеКолонки, ИмяКолонкиДопИсточника);
						КонецЕсли;
					КонецЕсли;

				КонецЦикла;

			КонецЦикла;

			Для каждого СтрокаДопИсточника Из ТаблицаИсточника Цикл

				Если ЗначениеЗаполнено(СтрокаДопИсточника.НомерСтроки)
						И ЗначениеЗаполнено(СтрокаДопИсточника.ИмяСписка) Тогда
						
					//  В документах ЕБП список "РасшифровкаПлатежа" заполняется по данным 
					// табличной части "Детализация платежа"
					Если СтрокаДопИсточника.ИмяСписка = "РасшифровкаПлатежа" 
						И (ИдентификаторОбъекта.Имя = "ПоступлениеНаСчет"
						ИЛИ ИдентификаторОбъекта.Имя = "РСКППеречисление"
						ИЛИ ИдентификаторОбъекта.Имя = "РСКПВозврат"
						ИЛИ ИдентификаторОбъекта.Имя = "РСКППеречислениеМир") Тогда
						ИмяДопИсточника = "ДетализацияПлатежа";
					Иначе
						ИмяДопИсточника = СтрокаДопИсточника.ИмяСписка;
					КонецЕсли;	

					НастройкаДопЧасти = НастройкаДополнительныхТабЧастей.Получить(ИмяДопИсточника);
	
					Если НастройкаДопЧасти <> Неопределено Тогда

						ТекущийОтбор = Новый Структура("ТабличнаяЧасть, НомерСтрокиДокумента", НастройкаДопЧасти.СсылкаТабличнойЧасти, СтрокаДопИсточника.НомерСтроки);

						СтрокиДопКолонок = ДанныеДополнительныхТабЧастей.НайтиСтроки(ТекущийОтбор);

						СтруктураДополнительныхДанных = Новый Структура;
						Для каждого ТекЗначениеДопКолонки Из СтрокиДопКолонок Цикл

							СтруктураДополнительныхДанных.Вставить(ТекЗначениеДопКолонки.ИмяКолонкиТабличнойЧасти, ТекЗначениеДопКолонки.Значение);

						КонецЦикла;
						Если СтруктураДополнительныхДанных.Количество() > 0 Тогда
							ЗаполнитьЗначенияСвойств(СтрокаДопИсточника, СтруктураДополнительныхДанных);
						КонецЕсли;

					КонецЕсли;

				КонецЕсли;

			КонецЦикла;

		КонецЕсли;

		ИсточникиДанных.Вставить(ДополнительныйИсточник.ИмяИсточника, ТаблицаИсточника);

	КонецЦикла;

	ДобавитьДатуПроведенияВИсточникиДанных(ДокументОбъект, ИсточникиДанных);

	Возврат ИсточникиДанных;

КонецФункции

Процедура ДобавитьДатуПроведенияВИсточникиДанных(ДокументОбъект, ИсточникиДанных)
	ДатаПроведения = БухгалтерскиеОперацииПовтИсп.ФактическаяДатаПроведенияДокумента(
		ДокументОбъект.Ссылка);
	Для Каждого Источник Из ИсточникиДанных Цикл
		ЗначениеИсточника = Источник.Значение; // ТаблицаЗначений
		Если ТипЗнч(ЗначениеИсточника) = Тип("ТаблицаЗначений")
				И ЗначениеИсточника.Колонки.Найти("ФактическаяДатаПроведения") = Неопределено Тогда
			ЗначениеИсточника.Колонки.Добавить("ФактическаяДатаПроведения",
				Новый ОписаниеТипов("Дата",,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
			ЗначениеИсточника.ЗаполнитьЗначения(ДатаПроведения, "ФактическаяДатаПроведения");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СоздатьИсточникиДанныхПоОписанию(ОписаниеИсточников)

	ИсточникиДанных = Новый Структура;

	ИсточникиДанных.Вставить("Документ", Новый ТаблицаЗначений);
	ИсточникДокумент = ИсточникиДанных.Документ;

	// общие колонки
	ИсточникДокумент.Колонки.Добавить("ИмяТабличнойЧасти", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	ИсточникДокумент.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
	ВсеТипыТиповойОперации = Новый Массив;
	ВсеТипыТиповойОперации.Добавить(Тип("СправочникСсылка.ТиповыеОперации"));
	ВсеТипыТиповойОперации.Добавить(Тип("СправочникСсылка.ПоставляемыеТиповыеОперации"));
	ИсточникДокумент.Колонки.Добавить("ТиповаяОперация", Новый ОписаниеТипов(ВсеТипыТиповойОперации));

	ДобавитьКолонкиИсточникаИзОписания(ИсточникДокумент, ОписаниеИсточников.Реквизиты, ПрефиксКолонкиИсточникаДанных("Документ"));
	ДобавитьКолонкиИсточникаИзОписания(ИсточникДокумент, ОписаниеИсточников.ДополнительныеРеквизиты, ПрефиксКолонкиИсточникаДанных("ДополнительныйРеквизит"));
	Если ИсточникДокумент.Колонки.Найти(ПрефиксКолонкиИсточникаДанных("Документ")
			+ "ВалютаДокумента") = Неопределено Тогда
		ИсточникДокумент.Колонки.Добавить(ПрефиксКолонкиИсточникаДанных("Документ")
			+ "ВалютаДокумента", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	КонецЕсли;

	Для каждого ОписаниеТЧ Из ОписаниеИсточников.ТабличныеЧасти Цикл

		ИмяТЧ = ОписаниеТЧ.Значение.Имя;

		ИсточникТЧ = ИсточникДокумент.Скопировать();
		Если ИсточникТЧ.Колонки.Найти("НомерСтроки") = Неопределено Тогда
			ИсточникТЧ.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
		КонецЕсли;

		ДобавитьКолонкиИсточникаИзОписания(ИсточникТЧ, ОписаниеТЧ.Значение.Реквизиты, ПрефиксКолонкиИсточникаДанных(ИмяТЧ));

		ИсточникиДанных.Вставить(ИмяТЧ, ИсточникТЧ);

	КонецЦикла;

	Возврат ИсточникиДанных;

КонецФункции

// СоздатьИсточникиДанныхПоОписанию()
Процедура ДобавитьКолонкиИсточникаИзОписания(ТаблицаИсточника, Реквизиты,
		ПрефиксКолонки = "")

	Для каждого ТекущийРеквизит Из Реквизиты Цикл

		ИмяКолонки = ПрефиксКолонки + ТекущийРеквизит.Имя;
		Если ТаблицаИсточника.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			ТаблицаИсточника.Колонки.Добавить(ИмяКолонки, ТекущийРеквизит.ТипЗначения);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// ДобавитьКолонкиИсточникаИзОписания()
Функция ПрефиксКолонкиИсточникаДанных(ИмяИсточника = "") Экспорт

	Если ПустаяСтрока(ИмяИсточника) Тогда
		Возврат "";
	Иначе
		Возврат ИмяИсточника + "_";
	КонецЕсли;

КонецФункции

// ПрефиксКолонкиИсточникаДанных()
Функция ПолучитьОписаниеСтруктурыОбъекта(ИдентификаторОбъекта) Экспорт

	ВсеРеквизитыОбъекта = Новый Массив;
	ВсеТабличныеЧасти = Новый Структура;

	МетаданныеОбъекта = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторОбъекта);

	Для каждого ТекРеквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл

		ДобавитьВОписаниеИсточникаДанных(ВсеРеквизитыОбъекта, ТекРеквизит.Имя, ТекРеквизит.Тип, Истина);

	КонецЦикла;

	Для каждого ТекРеквизит Из МетаданныеОбъекта.Реквизиты Цикл

		ДобавитьВОписаниеИсточникаДанных(ВсеРеквизитыОбъекта, ТекРеквизит.Имя, ТекРеквизит.Тип, Истина);

	КонецЦикла;

	Для каждого ТекТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл

		НоваяТЧ = ДобавитьТабличнуюЧастьВОписаниеИсточникаДанных(ВсеТабличныеЧасти, ТекТабличнаяЧасть.Имя, Истина);
		ВсеРеквизитыТЧ = НоваяТЧ.Реквизиты;

		Для каждого ТекРеквизит Из ТекТабличнаяЧасть.Реквизиты Цикл

			ДобавитьВОписаниеИсточникаДанных(ВсеРеквизитыТЧ, ТекРеквизит.Имя, ТекРеквизит.Тип, Истина);

		КонецЦикла;

	КонецЦикла;

	ДополнитьСтруктуруОбъектаТабличнымиЧастями(ИдентификаторОбъекта, ВсеТабличныеЧасти);

	ОписаниеСтруктурыОбъекта = Новый Структура("Реквизиты, ТабличныеЧасти", ВсеРеквизитыОбъекта, ВсеТабличныеЧасти);

	Возврат ОписаниеСтруктурыОбъекта;

КонецФункции

// ПолучитьОписаниеСтруктурыОбъекта()
Функция ДобавитьВОписаниеИсточникаДанных(Получатель, ИмяРек, ТипРек,
		ПредопределенныйРек)

	ДобавляемоеЗначение = Новый Структура;
	ДобавляемоеЗначение.Вставить("Имя", ИмяРек);
	ДобавляемоеЗначение.Вставить("ТипЗначения", ТипРек);
	ДобавляемоеЗначение.Вставить("Предопределенный", ПредопределенныйРек);

	Получатель.Добавить(ДобавляемоеЗначение);

	Возврат Получатель[Получатель.ВГраница()];

КонецФункции

// ДобавитьВОписаниеИсточникаДанных()
Функция ДобавитьТабличнуюЧастьВОписаниеИсточникаДанных(Получатель, ИмяТЧ,
		ПредопределеннаяТЧ)

	ДобавляемоеЗначение = Новый Структура;
	ДобавляемоеЗначение.Вставить("Имя", ИмяТЧ);
	ДобавляемоеЗначение.Вставить("Предопределенный", ПредопределеннаяТЧ);
	ДобавляемоеЗначение.Вставить("Реквизиты", Новый Массив);

	Получатель.Вставить(ИмяТЧ, ДобавляемоеЗначение);

	Возврат ДобавляемоеЗначение;

КонецФункции

// ДобавитьТабличнуюЧастьВОписаниеИсточникаДанных()
Процедура ДополнитьСтруктуруОбъектаТабличнымиЧастями(ИдентификаторОбъекта,
		ВсеТабличныеЧасти) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ДополнительныеТабличныеЧастиДокументов.Ссылка КАК ТабличнаяЧасть,
		|	ДополнительныеТабличныеЧастиДокументов.ИмяТабличнойЧасти,
		|	ДополнительныеТабличныеЧастиДокументов.ПредопределеннаяТабличнаяЧасть,
		|	КолонкиДополнительныхТабличныхЧастей.Ссылка КАК КолонкаТабличнойЧасти,
		|	КолонкиДополнительныхТабличныхЧастей.ИмяКолонки,
		|	КолонкиДополнительныхТабличныхЧастей.ОписаниеТипаКолонки.ТипЗначения Как ТипЗначения
		|ИЗ
		|	Справочник.КолонкиДополнительныхТабличныхЧастей КАК КолонкиДополнительныхТабличныхЧастей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДополнительныеТабличныеЧастиДокументов КАК ДополнительныеТабличныеЧастиДокументов
		|		ПО КолонкиДополнительныхТабличныхЧастей.Владелец = ДополнительныеТабличныеЧастиДокументов.Ссылка
		|ГДЕ
		|	ДополнительныеТабличныеЧастиДокументов.ИдентификаторДокумента = &ИдентификаторОбъекта
		|	И КолонкиДополнительныхТабличныхЧастей.ЭтоГруппа = ЛОЖЬ
		|	И ДополнительныеТабличныеЧастиДокументов.ПометкаУдаления = ЛОЖЬ
		|	И КолонкиДополнительныхТабличныхЧастей.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ИдентификаторОбъекта", ИдентификаторОбъекта);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ТекТЧ = Неопределено;
		ИмяТЧ = Выборка.ИмяТабличнойЧасти;

		ВсеТабличныеЧасти.Свойство(ИмяТЧ, ТекТЧ);

		Если ТекТЧ = Неопределено
				И Выборка.ПредопределеннаяТабличнаяЧасть = Истина Тогда
			Продолжить;
		КонецЕсли;

		Если ТекТЧ <> Неопределено
				И Выборка.ПредопределеннаяТабличнаяЧасть <> ТекТЧ.Предопределенный Тогда
			Продолжить;
		КонецЕсли;

		Если ТекТЧ = Неопределено Тогда

			ТекТЧ = ДобавитьТабличнуюЧастьВОписаниеИсточникаДанных(ВсеТабличныеЧасти, ИмяТЧ, Ложь);

		КонецЕсли;

		ДобавитьВОписаниеИсточникаДанных(ТекТЧ.Реквизиты, Выборка.ИмяКолонки, Выборка.ТипЗначения, Ложь);

	КонецЦикла;

КонецПроцедуры

Функция ПолучитьОписаниеСтруктурыТиповойОперации(ТиповаяОперация) Экспорт

	ДопРеквизиты = Новый Массив;

	Если Не ЗначениеЗаполнено(ТиповаяОперация) Тогда
		Возврат ДопРеквизиты;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка
	|ПОМЕСТИТЬ УдаленныеГруппы
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.ЭтоГруппа
	|	И РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	|	И РеквизитыТиповыхОпераций.ПометкаУдаления = ИСТИНА
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка
	|ПОМЕСТИТЬ УдаленныеЭлементы
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	НЕ РеквизитыТиповыхОпераций.ЭтоГруппа
	|	И РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	|	И РеквизитыТиповыхОпераций.Ссылка В ИЕРАРХИИ
	|		(ВЫБРАТЬ
	|			Ссылка
	|		ИЗ
	|			УдаленныеГруппы)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы КАК ИмяДляФормулы,
	|	РеквизитыТиповыхОпераций.РеквизитПроводки.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ УдаленныеЭлементы КАК УдаленныеЭлементы
	|		ПО РеквизитыТиповыхОпераций.Ссылка = УдаленныеЭлементы.Ссылка
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	|	И РеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ
	|	И РеквизитыТиповыхОпераций.ЭтоГруппа = ЛОЖЬ
	|	И УдаленныеЭлементы.Ссылка ЕСТЬ NULL";

	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ДобавитьВОписаниеИсточникаДанных(ДопРеквизиты, Выборка.ИмяДляФормулы, Выборка.ТипЗначения, Ложь);

	КонецЦикла;

	Возврат ДопРеквизиты;

КонецФункции

// Функция возвращает структуру - контекст заполнения операции.
// Если параметр "Инициализировать" = Истина,
// то структура будет заново инициализирована и помещена во временное хранилище. Адрес хранилища записывается
// в параметр сеанса КонтекстФормированияБухгалтерскойОперации.
// Если параметр "Инициализировать" = Ложь,
// то будет получена из хранилища ранее сохраненная структура
//
// Параметры:
//  Инициализировать - Булево - необходимость инициализации структуры
// Возвращаемое значение:
//  см. ИнициализироватьКонтекстЗаполненияОперации
Функция ПолучитьКонтекстЗаполненияОперации(Знач Инициализировать = Ложь) Экспорт

	Если НЕ Инициализировать Тогда
		
		КонтекстЗаполненияОперации = ПолучитьСохраненныйКонтекстЗаполненияОперации();
		
		Если КонтекстЗаполненияОперации = Неопределено Тогда
			Инициализировать = Истина;
		КонецЕсли;

	КонецЕсли;

	Если Инициализировать Тогда
		
		УдалитьКонтекстЗаполненияОперации();
		КонтекстЗаполненияОперации = ИнициализироватьКонтекстЗаполненияОперации();

	КонецЕсли;

	Возврат КонтекстЗаполненияОперации;

КонецФункции

// Процедура сохраняет переданный контекст заполнения операции во временное хранилище.
// Перед вызовом должен обязательно быть вызов функции ПолучитьКонтекстЗаполненияОперации(Истина)
//
// Параметры:
//  Контекст - Структура - контекст заполнения операции
Процедура СохранитьКонтекстЗаполненияОперации(Контекст) Экспорт

	АдресВХранилище = АдресХранилищаИзПараметраСеанса();
	ПоместитьВоВременноеХранилище(Контекст, АдресВХранилище);

КонецПроцедуры

Процедура УдалитьКонтекстЗаполненияОперации() Экспорт

	АдресВХранилище = АдресХранилищаИзПараметраСеанса();
	Если ЭтоАдресВременногоХранилища(АдресВХранилище) Тогда
		УдалитьИзВременногоХранилища(АдресВХранилище);
	КонецЕсли;
	ПараметрыСеанса.КонтекстФормированияБухгалтерскойОперации = "";
	
КонецПроцедуры

Функция ПолучитьСохраненныйКонтекстЗаполненияОперации()
	
	АдресВХранилище = АдресХранилищаИзПараметраСеанса();
	Если Не ЭтоАдресВременногоХранилища(АдресВХранилище) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Контекст = ПолучитьИзВременногоХранилища(АдресВХранилище);
	
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Если Контекст.ДокументОбъект = Неопределено
				И ТипЗнч(Контекст.ДокументОбъектСериализованный) = Тип("Строка")
				И Не ПустаяСтрока(Контекст.ДокументОбъектСериализованный) Тогда
			Контекст.ДокументОбъект = ОбщегоНазначения.ЗначениеИзСтрокиXML(Контекст.ДокументОбъектСериализованный);
		КонецЕсли;
		Возврат Контекст;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Инициализировать контекст заполнения операции.
// 
// Возвращаемое значение:
//  Структура - Инициализировать контекст заполнения операции:
// * Ссылка - ДокументСсылка 
// * ДокументОбъект - ДокументОбъект
// * ТаблицаАвансов - ТаблицаЗначений
// * ДокументОбъектСериализованный - Строка
// * Отказ - Булево - 
// * ТаблицаОшибок - ТаблицаЗначений - :
// ** ИмяПоля - Строка 
// ** ТекстСообщения - Строка 
// * ТиповаяОперация - СправочникСсылка.ТиповыеОперации - 
// * ДополнительныеСвойства - Структура - 
// * ИсключениеПриПроверкеЗаполнения - Булево - 
// * ПоследняяОшибка - Строка - 
// * ПоследняяФункция - Строка - 
// * УникальныйИдентификатор - УникальныйИдентификатор - 
// * Курс - Число - 
// * Кратность - Число - 
Функция ИнициализироватьКонтекстЗаполненияОперации()

	ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("ИмяПоля");
	ТаблицаОшибок.Колонки.Добавить("ТекстСообщения");
	
	Контекст = Новый Структура("Ссылка, ДокументОбъект, ТаблицаАвансов");

	Контекст.Вставить("ДокументОбъектСериализованный",   "");
	Контекст.Вставить("Отказ",                           Ложь);
	Контекст.Вставить("ТаблицаОшибок",                   ТаблицаОшибок);
	Контекст.Вставить("ТиповаяОперация",                 Справочники.ТиповыеОперации.ПустаяСсылка());
	Контекст.Вставить("ДополнительныеСвойства",          Новый Структура);
	Контекст.Вставить("ИсключениеПриПроверкеЗаполнения", Ложь);
	Контекст.Вставить("ПоследняяОшибка",                 "");
	Контекст.Вставить("ПоследняяФункция",                "");
	Контекст.Вставить("УникальныйИдентификатор",         Новый УникальныйИдентификатор);
	Контекст.Вставить("Курс",                            1);
	Контекст.Вставить("Кратность",                       1);
	Контекст.Вставить("ПроверятьЗаполнениеРеквизитов",   Истина);

	АдресВХранилище = ПоместитьВоВременноеХранилище(Контекст);
	ПараметрыСеанса.КонтекстФормированияБухгалтерскойОперации = АдресВХранилище;
	
	Возврат Контекст;
	
КонецФункции

Функция АдресХранилищаИзПараметраСеанса()

	АдресВХранилище = ПараметрыСеанса.КонтекстФормированияБухгалтерскойОперации;
	Возврат АдресВХранилище;

КонецФункции

Функция ПустаяТаблицаЗначенияДопРеквизитов(ПолучатьНаименование)

	ЗначенияДопРеквизитов = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	Если ПолучатьНаименование Тогда
		ЗначенияДопРеквизитов.Колонки.Добавить("НаименованиеРеквизита");
	КонецЕсли;
	Возврат ЗначенияДопРеквизитов;

КонецФункции

// Формирует структуру доп. реквизитов и их значения. Вызывается при записи из формы документа.
//
// Параметры:
//	Форма - УправляемаяФорма - Форма документа.
//	ДополнительныеРеквизиты - Произвольный - после выполнения содержит структуру с доп. реквизитами: ключ-ИмяДляФормулы, значение - значение доп. реквизита
//	ЗначенияДопРеквизитов - Произвольный - после выполнения содержит готовую таблицу значений, для записи в РС ЗначенияДополнительныхРеквизитовОперации
//  БезВалюты - Булево - признак необходимости получения реквизитов Курс и Кратность. Если валютный учет не ведется, то реквизиты курс и кратность не получаются
//							не зависимо от параметра.
//	
Процедура СформироватьСтруктуруДопРеквизитовИзБазы(ДокументОбъект,
		ТиповаяОперация, ДополнительныеРеквизиты, ЗначенияДопРеквизитов,
		ПолучатьНаименование = Ложь)
		
	БезВалюты = ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ОперацияБух")
			ИЛИ НЕ ИспользоватьВалютныйУчет(ДокументОбъект);

	ДополнительныеРеквизиты = Новый Структура;
	ЗначенияДопРеквизитов = ПустаяТаблицаЗначенияДопРеквизитов(ПолучатьНаименование);
	СсылкаДокумента = ДокументОбъект.Ссылка;

	Если СсылкаДокумента.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ТиповаяОперация = БухгалтерскаяОперацияДокумента(ДокументОбъект.Ссылка);
	Если НЕ ЗначениеЗаполнено(ТиповаяОперация) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка КАК РеквизитОперации,
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы,
	|	РеквизитыТиповыхОпераций.РеквизитПроводки,
	|	РеквизитыТиповыхОпераций.Наименование КАК НаименованиеРеквизита,
	|	РеквизитыТиповыхОпераций.РеквизитПроводки.ТипЗначения КАК ТипЗначения,
	|	ЗначенияДополнительныхРеквизитовОпераций.Значение
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК
	|			ЗначенияДополнительныхРеквизитовОпераций
	|		ПО РеквизитыТиповыхОпераций.Ссылка = ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации
	|		И (ЗначенияДополнительныхРеквизитовОпераций.Объект = &Документ)
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	|	И
	|	НЕ РеквизитыТиповыхОпераций.ЭтоГруппа
	|	И
	|	НЕ РеквизитыТиповыхОпераций.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОперацииДокументов.Документ,
	|	ОперацииДокументов.Операция,
	|	ОперацииДокументов.ИсправлениеОшибки,
	|	ОперацииДокументов.ВыявительОшибки,
	|	ОперацииДокументов.ПричинаОшибки,
	|	ОперацииДокументов.Курс,
	|	ОперацииДокументов.Кратность,
	|	ОперацииДокументов.ОтветственныйИсполнитель
	|ИЗ
	|	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|ГДЕ
	|	ОперацииДокументов.Документ = &Документ
	|	И ОперацииДокументов.Операция = &ТиповаяОперация";

	Если НЕ ПолучатьНаименование Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеквизитыТиповыхОпераций.Наименование КАК НаименованиеРеквизита,", "");
	КонецЕсли;

	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	Запрос.УстановитьПараметр("Документ", СсылкаДокумента);

	РезультатЗапроса = Запрос.ВыполнитьПакет();

	Выборка = РезультатЗапроса[0].Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ЗначениеЗаполнено(Выборка.ТипЗначения) Тогда

			ЗначениеДопРеквизита = Выборка.ТипЗначения.ПривестиЗначение(Выборка.Значение);

			НовЗначение = ЗначенияДопРеквизитов.Добавить();
			ЗаполнитьЗначенияСвойств(НовЗначение, Выборка);
			НовЗначение.Значение = Выборка.ТипЗначения.ПривестиЗначение(Выборка.Значение);

			ДополнительныеРеквизиты.Вставить(Выборка.ИмяДляФормулы, ЗначениеДопРеквизита);

		КонецЕсли;

	КонецЦикла;

	Выборка = РезультатЗапроса[1].Выбрать();
	Если Выборка.Следующий() Тогда
		Курс = Выборка.Курс;
		Кратность = Выборка.Кратность;
		ИсправлениеОшибки = Выборка.ИсправлениеОшибки;
		ВыявительОшибки = Выборка.ВыявительОшибки;
		ПричинаОшибки = Выборка.ПричинаОшибки;
		ОтветственныйИсполнитель = Выборка.ОтветственныйИсполнитель;
	Иначе 
		Курс = 0;
		Кратность = 0;
		ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка();
		ВыявительОшибки = Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка();
		ПричинаОшибки = Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка();
		ОтветственныйИсполнитель = Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
	ДополнительныеРеквизиты.Вставить("ИсправлениеОшибки", ИсправлениеОшибки);
	ДополнительныеРеквизиты.Вставить("ВыявительОшибки", ВыявительОшибки);
	ДополнительныеРеквизиты.Вставить("ПричинаОшибки", ПричинаОшибки);
	ДополнительныеРеквизиты.Вставить("ОтветственныйИсполнитель", ОтветственныйИсполнитель);

	Если НЕ БезВалюты Тогда

		ДополнительныеРеквизиты.Вставить("Курс", ?(ЗначениеЗаполнено(Курс), Курс, 1));
		ДополнительныеРеквизиты.Вставить("Кратность", ?(ЗначениеЗаполнено(Кратность), Кратность, 1));

	КонецЕсли;

КонецПроцедуры

// Функция проверяет изменение реквизитов, которые нельзя менять пользователю.
//
// Параметры:
// ТекущийОбъект - ДокументОбъект - объект, содержащий измененные данные
// Объект - ДокументОбъект - объект, содержащий записанные данные
//
// Возвращаемое значение:
// Булево - Истина - реквизиты не изменены, Ложь - изменены.
//
Функция КонтролируемыеРеквизитыНеИзменены(ТекущийОбъект, Объект)

	ТекстСообщения = НСтр("ru='Сформированы проводки документа.
		|У Вас отсутствуют права на изменение реквизитов использующихся в проводках.
		|Операция не выполнена.'");
	КонтролируемыеРеквизиты = ПолучитьКонтролируемыеРеквизиты(ТекущийОбъект.Ссылка);

	Если КонтролируемыеРеквизиты <> Неопределено Тогда
		ТаблицаТЧ = КонтролируемыеРеквизиты.Скопировать(, "ИмяТабличнойЧасти");
		ТаблицаТЧ.Свернуть("ИмяТабличнойЧасти");
		МассивТЧ = ТаблицаТЧ.ВыгрузитьКолонку("ИмяТабличнойЧасти");

		ОтборРеквизитов = Новый Структура("ИмяТабличнойЧасти", "");
		ПроверяемыеРеквизиты = КонтролируемыеРеквизиты.Скопировать(ОтборРеквизитов, "ИмяРеквизита");
		Для каждого ТекРеквизит Из ПроверяемыеРеквизиты Цикл

			Если ТекущийОбъект[ТекРеквизит.ИмяРеквизита] <> Объект[ТекРеквизит.ИмяРеквизита] Тогда

				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , );
				Возврат Ложь;

			КонецЕсли;

		КонецЦикла;

		Для каждого ТекТЧ Из МассивТЧ Цикл
			Если ПустаяСтрока(ТекТЧ) Тогда
				Продолжить;
			КонецЕсли;

			Если ТекущийОбъект[ТекТЧ].Количество() <> Объект[ТекТЧ].Количество() Тогда

				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , );
				Возврат Ложь;

			КонецЕсли;

			ОтборРеквизитов = Новый Структура("ИмяТабличнойЧасти", ТекТЧ);
			ПроверяемыеРеквизиты = КонтролируемыеРеквизиты.Скопировать(ОтборРеквизитов, "ИмяРеквизита");
			Для ИндексСтроки = 0 По ТекущийОбъект[ТекТЧ].Количество() - 1 Цикл
				СтрокаТекущийОбъект = ТекущийОбъект[ТекТЧ][ИндексСтроки];
				СтрокаОбъект = Объект[ТекТЧ][ИндексСтроки];
				Для каждого ТекРеквизит Из ПроверяемыеРеквизиты Цикл
					Если СтрокаТекущийОбъект[ТекРеквизит.ИмяРеквизита] <> СтрокаОбъект[ТекРеквизит.ИмяРеквизита] Тогда

						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , );
						Возврат Ложь;

					КонецЕсли;

				КонецЦикла;
			КонецЦикла;

		КонецЦикла;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ТиповаяОперацияСоответствуетДокументу(ТекущийОбъект, ТиповаяОперация)

	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ТекущийОбъект));
	Параметры = ПараметрыДляВыбораТиповойОперации(ТекущийОбъект, ИдентификаторДокумента);

	СписокДопустимыхТиповыхОпераций = Справочники.ТиповыеОперации.ПолучитьСписокТиповыхОперацийПоУсловиям(ИдентификаторДокумента, Параметры);

	Возврат СписокДопустимыхТиповыхОпераций.НайтиПоЗначению(ТиповаяОперация) <> Неопределено;

КонецФункции

Процедура СообщитьТиповаяОперацияНеСоответствуетДокументу(ТекущийОбъект,
		Форма)

	ТекстСообщения = НСтр("ru = 'Выбранная типовая операция не соответствует отбору в документе'");
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ТекущийОбъект.Ссылка, БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитыФормыТиповаяОперацияФактическое(Форма));

КонецПроцедуры

// Получает список реквизитов для контроля из ссылки на типовую операцию. Список возвращается
// по всем проводкам операции.
//
// Параметры
// Ссылка - СправочникСсылка.ТиповаяОперация.
// ЭтоСторно - Булево - признак получения списка реквизитов для сторнированного документа.
//
// Возвращаемое значение
// ТаблицаЗначений с двумя колонками "ИмяТабличнойЧасти" и "ИмяРеквизита".
//
Функция ПолучитьКонтролируемыеРеквизиты(Ссылка, ЭтоСторно = Ложь)
	ПраваПользователяПросмотр = Ложь;
	БухгалтерскаяОперация = БухгалтерскаяОперацияДокумента(Ссылка);
	// если получаем список реквизитов для сторнированного документа, то права пользователей нас не интересуют. Надо запрещать
	// все и всем.
	Если НЕ ЭтоСторно Тогда

		ПраваПользователяПросмотр = Справочники.ТиповыеОперации.ПраваДоступаКТиповойОперации(БухгалтерскаяОперация).Просмотр;

	КонецЕсли;

	Если ПраваПользователяПросмотр Тогда
		Возврат Неопределено;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ПроводкиТиповыхОперацийКонтролируемыеРеквизиты.ИмяТабличнойЧасти,
			|	ПроводкиТиповыхОперацийКонтролируемыеРеквизиты.ИмяРеквизита
			|ИЗ
			|	Справочник.ПроводкиТиповыхОпераций.КонтролируемыеРеквизиты КАК ПроводкиТиповыхОперацийКонтролируемыеРеквизиты
			|ГДЕ
			|	ПроводкиТиповыхОперацийКонтролируемыеРеквизиты.Ссылка.Владелец = &Операция";
		Запрос.УстановитьПараметр("Операция", БухгалтерскаяОперация);
		Возврат Запрос.Выполнить().Выгрузить();
	КонецЕсли;
КонецФункции

// Получает значения реквизитов объекта и заполняет структуру с этими значениями.
// Используется для получения списка операций, доступных для выбора в конкретный документ.
//
// Параметры:
//  ТекущийОбъект			 - ДанныеФормыСтруктура, ДанныеФормыСтруктураСКоллекцией, ДокументОбъект - документ.
//  ИдентификаторДокумента	 - СправочникСсылка.ИдентификаторыОбъектовМетаданных - идентификатор документа
// 
// Возвращаемое значение:
//  Структура - Содержит ключи - имена реквизитов и их значения. Если реквизитов для выбора не задано, то
//							структура пустая.
//
Функция ПараметрыДляВыбораТиповойОперации(ТекущийОбъект, ИдентификаторДокумента)

	Параметры = Новый Структура;

	ИменаРеквизитов = БухгалтерскиеОперацииПовтИспНаВремяСеанса.ИменаРеквизитовДляПроверкиИспользованияОперации(ИдентификаторДокумента);
	Если ЗначениеЗаполнено(ИменаРеквизитов) Тогда
		ПараметрыИспользования = Новый Структура(ИменаРеквизитов);
		ЗаполнитьЗначенияСвойств(ПараметрыИспользования, ТекущийОбъект);
		ВременнаяСтруктура = Новый Структура("Дата, Организация");
		ЗаполнитьЗначенияСвойств(ВременнаяСтруктура, ТекущийОбъект);
		Если ЗначениеЗаполнено(ВременнаяСтруктура.Дата) Тогда
			ДатаДокумента = ВременнаяСтруктура.Дата;
		Иначе
			ДатаДокумента = ОбщегоНазначения.ТекущаяДатаПользователя();
		КонецЕсли;
		ПараметрыИспользования.Вставить("СлужебныйДляВыбораНаДату", ДатаДокумента);
		ПараметрыИспользования.Вставить("СлужебныйДляВыбораОрганизация", ВременнаяСтруктура.Организация);
		Если ПараметрыИспользования.Свойство("Дата") И ПараметрыИспользования.Дата = '00010101' Тогда
			// В новом документе дата еще не задана, но по-умолчанию она будет задана как ТекущаяДатаПользователя
			ПараметрыИспользования.Дата = ДатаДокумента;
		КонецЕсли;
		Параметры.Вставить("ПараметрыИспользования", ПараметрыИспользования);
	КонецЕсли;

	Возврат Параметры;

КонецФункции

#КонецОбласти

#Область РаботаСФормами

Процедура ЗаполнитьОперандыФормул(Форма,
		ЭтоПоставляемаяПроводка = Ложь) Экспорт

	Дерево = Форма.РеквизитФормыВЗначение("ОперандыФормул");

	Элементы = Форма.Элементы;

	// ДобавитьВОперандыФормулРеквизитыДокумента
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(Форма.АдресСКДРеквизитовДокумента, Новый Структура("ИспользоватьВалютныйУчет", Истина));
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);

	Корень = Дерево.Строки.Добавить();
	Корень.Поле = "Документ.Ссылка";
	Корень.ИмяДляФормулы = "Документ.Ссылка";
	Корень.Представление = "Документ.Ссылка";
	Корень.НомерКартинки = 0;

	ДобавитьДеревоДоступныхПолейВДерево(Корень, КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора, "Документ", "", 0);

	Для каждого ТекСтрока Из КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.Элементы Цикл

		Если ТекСтрока.Папка = Истина
				И НЕ ТекСтрока.Поле = Новый ПолеКомпоновкиДанных("СистемныеПоля") Тогда
			Элементы.ИмяТабличнойЧастиДокумента.СписокВыбора.Добавить(Строка(ТекСтрока.Поле), ТекСтрока.Заголовок);
		КонецЕсли;

	КонецЦикла;

	// ДобавитьВОперандыФормулДополнительныеРеквизиты
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(Форма.АдресСКДДополнительныхРеквизитов, Новый Структура("ИспользоватьВалютныйУчет", Истина));
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);

	Корень = Дерево.Строки.Добавить();
	Корень.Поле = "";
	Корень.ИмяДляФормулы = "";
	Корень.Представление = "Дополнительные реквизиты";
	Корень.НомерКартинки = 4;

	ДобавитьДеревоДоступныхПолейВДерево(Корень, КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора, "ДополнительныеРеквизиты", "", 0);

	// ДобавитьВОперандыФормулДополнительныеИсточники
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(Форма.АдресСКДДополнительныхИсточников, Новый Структура("ИспользоватьВалютныйУчет", Истина));
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);

	Корень = Дерево.Строки.Добавить();
	Корень.Поле = "";
	Корень.ИмяДляФормулы = "";
	Корень.Представление = "Дополнительные источники данных";
	Корень.НомерКартинки = 11;

	ДобавитьДеревоДоступныхПолейВДерево(Корень, КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора, "СтрокаТаблицы", "", 0, 1, Истина);

	Для каждого ТекСтрока Из КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.Элементы Цикл

		Если ТекСтрока.Папка = Истина
				И НЕ ТекСтрока.Поле = Новый ПолеКомпоновкиДанных("СистемныеПоля") Тогда
			Элементы.ИмяТабличнойЧастиДокумента.СписокВыбора.Добавить(Строка(ТекСтрока.Поле), ТекСтрока.Заголовок);
		КонецЕсли;

	КонецЦикла;

	// ДобавитьВОперандыФормулАгрегатныеФункции
	Корень = Дерево.Строки.Добавить();
	Корень.Поле = "АгрегатныеФункции";
	Корень.ИмяДляФормулы = "";
	Корень.Представление = "Агрегатные функции";
	Корень.НомерКартинки = 5;

	Для каждого АгрегатнаяФункция Из Справочники.ПроводкиТиповыхОпераций.ДоступныеАгрегатныеФункции() Цикл

		НовСтрока = Корень.Строки.Добавить();
		НовСтрока.Поле = АгрегатнаяФункция.Поле;
		НовСтрока.ИмяДляФормулы = АгрегатнаяФункция.ИмяДляФормулы;
		НовСтрока.Представление = АгрегатнаяФункция.Представление;
		НовСтрока.НомерКартинки = 8;

	КонецЦикла;
	
	Корень = Дерево.Строки.Добавить();
	Корень.Представление = "Функции общего модуля";
	Корень.НомерКартинки = 6;

	ОписанияФункций = БухгалтерскиеОперации.ПолучитьТаблицуОписанийПользовательскихФункций();
	БухгалтерскиеОперации.ЗаполнитьОписанияПользовательскихФункций(ОписанияФункций);
	ДобавитьФункцииОбщегоМодуляВДеревоОперандов(Корень, ОписанияФункций, "БухгалтерскиеОперации");

	ОписанияФункций.Очистить();
	БухгалтерскиеОперацииПереопределяемый.ЗаполнитьОписанияПользовательскихФункций(ОписанияФункций);
	Если ОписанияФункций.Количество() > 0 Тогда
		Корень = Дерево.Строки.Добавить();
		Корень.Представление = "Функции общего модуля (переопределенные)";
		Корень.НомерКартинки = 6;
		ДобавитьФункцииОбщегоМодуляВДеревоОперандов(Корень, ОписанияФункций, "БухгалтерскиеОперацииПереопределяемый", Истина);
	КонецЕсли;

	// добавить функции из расширения
	МодулиРасширений = ОписанияМодулейРасширений("Функции");
	Для каждого ТекМодуль Из МодулиРасширений Цикл

		ОписанияФункций.Очистить();
		ОбщийМодуль = ОбщегоНазначения.ОбщийМодуль(ТекМодуль.Ключ);
		ОбщийМодуль.ЗаполнитьОписанияПользовательскихФункций(ОписанияФункций);

		Если ОписанияФункций.Количество() > 0 Тогда
			Корень = Дерево.Строки.Добавить();
			Корень.Представление = СтрШаблон(НСтр("ru = 'Функции общего модуля расширения (%1)'"), ТекМодуль.Значение);
			Корень.НомерКартинки = 6;
			ДобавитьФункцииОбщегоМодуляВДеревоОперандов(Корень, ОписанияФункций, ТекМодуль.Ключ, Истина);
		КонецЕсли;

	КонецЦикла;

	// ДобавитьВОперандыФормулМакросы
	Корень = Дерево.Строки.Добавить();
	Корень.Поле = "";
	Корень.ИмяДляФормулы = "";
	Корень.Представление = "Макросы";
	Корень.НомерКартинки = 9;

	НовМакрос = Корень.Строки.Добавить();
	НовМакрос.НомерКартинки = 8;
	НовМакрос.ИмяДляФормулы = "#ЗначениеЗаполнено";
	НовМакрос.Представление = "#ЗначениеЗаполнено";

	НовМакрос = Корень.Строки.Добавить();
	НовМакрос.НомерКартинки = 8;
	НовМакрос.ИмяДляФормулы = "#ЗначениеЗаполнено/Прервать";
	НовМакрос.Представление = "#ЗначениеЗаполнено/Прервать";

	// ДобавитьВОперандыФормулРеквизитыПроводок
	РеквизитыПроводки = Новый ТаблицаЗначений;
	РеквизитыПроводки.Колонки.Добавить("ИмяДляФормулы", Новый ОписаниеТипов("Строка"));
	РеквизитыПроводки.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));

	НовСтр = РеквизитыПроводки.Добавить();
	НовСтр.ИмяДляФормулы = "Период";
	НовСтр.Порядок = 1;

	ТекПорядок = 1;
	Для каждого ТекРеквизит Из Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.Измерения Цикл

		ТекПорядок = ТекПорядок + 1;

		Если ТекРеквизит.Балансовый Тогда
			НовСтр = РеквизитыПроводки.Добавить();
			НовСтр.ИмяДляФормулы = ТекРеквизит.Имя;
			НовСтр.Порядок = ТекПорядок;
		Иначе
			НовСтр = РеквизитыПроводки.Добавить();
			НовСтр.ИмяДляФормулы = ТекРеквизит.Имя + "Дт";
			НовСтр.Порядок = 10 + ТекПорядок;
			НовСтр = РеквизитыПроводки.Добавить();
			НовСтр.ИмяДляФормулы = ТекРеквизит.Имя + "Кт";
			НовСтр.Порядок = 20 + ТекПорядок;
		КонецЕсли;

	КонецЦикла;

	ТекПорядок = 1;

	НовСтр = РеквизитыПроводки.Добавить();
	НовСтр.ИмяДляФормулы = "СчетДт";
	НовСтр.Порядок = 30;

	НовСтр = РеквизитыПроводки.Добавить();
	НовСтр.ИмяДляФормулы = "СчетКт";
	НовСтр.Порядок = 35;

	Для Сч = 1 по 3 Цикл
		НовСтр = РеквизитыПроводки.Добавить();
		НовСтр.ИмяДляФормулы = "СубконтоДт" + Сч;
		НовСтр.Порядок = 30 + ТекПорядок;

		НовСтр = РеквизитыПроводки.Добавить();
		НовСтр.ИмяДляФормулы = "СубконтоКт" + Сч;
		НовСтр.Порядок = 35 + ТекПорядок;
	КонецЦикла;

	ТекПорядок = 1;

	Для каждого ТекРеквизит Из Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.Ресурсы Цикл

		ТекПорядок = ТекПорядок + 1;

		Если ТекРеквизит.Балансовый Тогда
			НовСтр = РеквизитыПроводки.Добавить();
			НовСтр.ИмяДляФормулы = ТекРеквизит.Имя;
			НовСтр.Порядок = 40 + ТекПорядок;
		Иначе
			НовСтр = РеквизитыПроводки.Добавить();
			НовСтр.ИмяДляФормулы = ТекРеквизит.Имя + "Дт";
			НовСтр.Порядок = 50 + ТекПорядок;
			НовСтр = РеквизитыПроводки.Добавить();
			НовСтр.ИмяДляФормулы = ТекРеквизит.Имя + "Кт";
			НовСтр.Порядок = 60 + ТекПорядок;
		КонецЕсли;

	КонецЦикла;

	ТекПорядок = 1;

	Для каждого ТекРеквизит Из Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.Реквизиты Цикл

		ТекПорядок = ТекПорядок + 1;

		НовСтр = РеквизитыПроводки.Добавить();
		НовСтр.ИмяДляФормулы = ТекРеквизит.Имя;
		НовСтр.Порядок = 70 + ТекПорядок;

	КонецЦикла;

	РеквизитыПроводки.Сортировать("Порядок");

	Корень = Дерево.Строки.Добавить();
	Корень.Поле = "";
	Корень.ИмяДляФормулы = "";
	Корень.Представление = "ТекущаяПроводка";
	Корень.НомерКартинки = 3;

	Для каждого ТекРеквизитПроводки Из РеквизитыПроводки Цикл

		НовСтрока = Корень.Строки.Добавить();
		НовСтрока.НомерКартинки = 8;
		НовСтрока.ИмяДляФормулы = "Проводка." + ТекРеквизитПроводки.ИмяДляФормулы;
		НовСтрока.Представление = ТекРеквизитПроводки.ИмяДляФормулы;

	КонецЦикла;

	Форма.ЗначениеВРеквизитФормы(Дерево, "ОперандыФормул");

КонецПроцедуры

Процедура ДобавитьФункцииОбщегоМодуляВДеревоОперандов(Корень, ОписанияФункций, ИмяМодуля, НеДобавлятьЕдинственнуюГруппу = Ложь)
	
	ВсеГруппы = ОписанияФункций.Скопировать(,"СинонимГруппы, ПорядокГруппы");
	ВсеГруппы.Свернуть("СинонимГруппы, ПорядокГруппы");
	ВсеГруппы.Сортировать("ПорядокГруппы, СинонимГруппы");
	Если НеДобавлятьЕдинственнуюГруппу И ВсеГруппы.Количество() = 1 Тогда
		ДобавитьФункциюОбщегоМодуляВГруппу(Корень, ОписанияФункций, ИмяМодуля);
	Иначе
		Для Каждого ТекГруппа Из ВсеГруппы Цикл
			КореньГруппы = Корень.Строки.Добавить();
			КореньГруппы.Представление = ТекГруппа.СинонимГруппы;
			КореньГруппы.НомерКартинки = 12;
			ДобавитьФункциюОбщегоМодуляВГруппу(КореньГруппы, ОписанияФункций, ИмяМодуля, ТекГруппа.СинонимГруппы);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьФункциюОбщегоМодуляВГруппу(КореньГруппы, ОписанияФункций, ИмяМодуля, СинонимГруппы = Неопределено)
	Для каждого ТекФункция Из ОписанияФункций Цикл

		Если СинонимГруппы <> Неопределено И ТекФункция.СинонимГруппы <> СинонимГруппы Тогда
			Продолжить;
		КонецЕсли;
	
		НовФункция = КореньГруппы.Строки.Добавить();
		НовФункция.Представление = ТекФункция.ИмяФункции;
		НовФункция.ИмяДляФормулы = ИмяМодуля + "." + ТекФункция.ИмяФункции;
		НовФункция.Поле = ТекФункция.ИмяФункции;
		НовФункция.НомерКартинки = 8;
		НовФункция.Описание = ТекФункция.Описание;
		НовФункция.НеОтображать = Не ТекФункция.Используется;

	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьДеревоДоступныхПолейВДерево(КоллекцияПриемник,
		КоллекцияИсточник, Знач ПервоеПоле, ИмяТаблицы, Счетчик,
		МаксОграничение = 2, ЭтоДополнительныйИсточникДанных = Ложь)

	Если Счетчик = МаксОграничение Тогда
		Возврат;
	КонецЕсли;

	Для каждого ТекЭлемент Из КоллекцияИсточник.Элементы Цикл

		Если НевыводимыйРеквизит(ТекЭлемент.Поле) Тогда
			Продолжить;
		КонецЕсли;

		Если (ПервоеПоле = "Документ" И (ТекЭлемент.Таблица ИЛИ ТекЭлемент.Папка))
				ИЛИ ЭтоДополнительныйИсточникДанных Тогда
			ИмяТекущейТаблицы = Сред(ТекЭлемент.Поле, Найти(ТекЭлемент.Поле, ".") + 1);
		Иначе
			ИмяТекущейТаблицы = ИмяТаблицы;
		КонецЕсли;

		Если ТипЗнч(КоллекцияПриемник) = Тип("СтрокаДереваЗначений") Тогда
			Узел = КоллекцияПриемник.Строки.Добавить();
		Иначе
			Узел = КоллекцияПриемник.ПолучитьЭлементы().Добавить();
		КонецЕсли;
		Если ПервоеПоле = "СтрокаТаблицы" Тогда
			Поле = Сред(ТекЭлемент.Поле, Найти(ТекЭлемент.Поле, ".") + 1);
		Иначе
			Поле = ТекЭлемент.Поле;
		КонецЕсли;
		Узел.Поле = ПервоеПоле + "." + Поле;
		Если ПервоеПоле = "Документ" И (ТекЭлемент.Таблица
				ИЛИ ТекЭлемент.Папка) Тогда
			Узел.Представление = "Таблица." + Поле + " (" + ТекЭлемент.Заголовок + ")";
		Иначе
			Узел.ИмяДляФормулы = ПервоеПоле + "." + Поле;
			Узел.Представление = Узел.ИмяДляФормулы + " (" + ТекЭлемент.Заголовок
				+ ")";
		КонецЕсли;
		Узел.Таблица = ТекЭлемент.Таблица ИЛИ ТекЭлемент.Папка;
		Узел.ИмяТаблицы = ИмяТаблицы;
		Если ТекЭлемент.Таблица ИЛИ ТекЭлемент.Папка Тогда
			Узел.НомерКартинки = 2;
		Иначе
			Узел.НомерКартинки = 1;
		КонецЕсли;
		Узел.ЭтоДополнительныйИсточникДанных = ЭтоДополнительныйИсточникДанных;

		Если ТекЭлемент.Таблица ИЛИ ТекЭлемент.Папка Тогда
			ДобавитьДеревоДоступныхПолейВДерево(Узел, ТекЭлемент, ?(ПервоеПоле = "Документ", "СтрокаТаблицы", ПервоеПоле), ИмяТекущейТаблицы, 0, МаксОграничение, ЭтоДополнительныйИсточникДанных);
		Иначе
			ДобавитьДеревоДоступныхПолейВДерево(Узел, ТекЭлемент, ПервоеПоле, ИмяТекущейТаблицы, Счетчик
				+ 1, МаксОграничение, ЭтоДополнительныйИсточникДанных);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// ДобавитьДеревоДоступныхПолейВДерево()
Функция НевыводимыйРеквизит(Поле)

	РазложениеИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка(Поле), ".");
	ПоследнееПоле = ВРЕГ(РазложениеИмени[РазложениеИмени.ВГраница()]);

	Возврат ПоследнееПоле = "ВЕРСИЯДАННЫХ" ИЛИ ПоследнееПоле = "СИСТЕМНЫЕПОЛЯ"
		ИЛИ ПоследнееПоле = "ССЫЛКА" ИЛИ ПоследнееПоле = "ИДИСТОЧНИКА"
		ИЛИ Найти(Строка(Поле), "[") > 0;

КонецФункции

// НевыводимыйРеквизит()
Процедура ЗаполнитьОперандыФормулТиповойОперации(Форма,
		ОперацияНаПоддержке = Ложь) Экспорт

	ОписанияФункций = БухгалтерскиеОперации.ПолучитьТаблицуОписанийПользовательскихФункций();
	БухгалтерскиеОперации.ЗаполнитьОписанияПользовательскихФункцийУсловийОпераций(ОписанияФункций);

	СтрФункций = Форма.РеквизитыДокумента.ПолучитьЭлементы().Добавить();
	СтрФункций.Имя = "Функции общего модуля";
	СтрФункций.КодДляФормулы = "БухгалтерскиеОперации";
	Для каждого ТекФункция Из ОписанияФункций Цикл

		ТекСтрФункции = СтрФункций.ПолучитьЭлементы().Добавить();
		ТекСтрФункции.Имя = ТекФункция.ИмяФункции;
		ТекСтрФункции.КодДляФормулы = "БухгалтерскиеОперации."
			+ ТекФункция.ИмяФункции;
		ТекСтрФункции.Описание = ТекФункция.Описание;
		ТекСтрФункции.НеОтображать = Не ТекФункция.Используется;

	КонецЦикла;

	Если Не ОперацияНаПоддержке Тогда
		ОписанияФункций.Очистить();

		БухгалтерскиеОперацииПереопределяемый.ЗаполнитьОписанияПользовательскихФункцийУсловийОпераций(ОписанияФункций);

		Если ОписанияФункций.Количество() > 0 Тогда

			СтрФункций = Форма.РеквизитыДокумента.ПолучитьЭлементы().Добавить();
			СтрФункций.Имя = "Функции общего модуля (переопределенные)";
			СтрФункций.КодДляФормулы = "БухгалтерскиеОперацииПереопределяемый";
			Для каждого ТекФункция Из ОписанияФункций Цикл

				ТекСтрФункции = СтрФункций.ПолучитьЭлементы().Добавить();
				ТекСтрФункции.Имя = ТекФункция.ИмяФункции;
				ТекСтрФункции.КодДляФормулы = "БухгалтерскиеОперацииПереопределяемый."
					+ ТекФункция.ИмяФункции;
				ТекСтрФункции.Описание = ТекФункция.Описание;
				ТекСтрФункции.НеОтображать = Не ТекФункция.Используется;

			КонецЦикла;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

// Устанавливает в список формы отбор, заданный в настройке операции.
// Отбор передается в сериализованном виде в параметре "ПредустановленныйОтбор".
// Если отображение динамического списка установлено в иерархический список или дерево, то возможно при установке отбора
// список окажется пустым, т.к. родительские элементы не попадают в отбор. Для предотвращения этого необходимо установить
// отображение динамического списка = "Список". Если динамический список имеет имя "Список", то можно передать в процедуру
// саму форму и отображение будет установлено автоматически.
//
// Параметры:
//	Список - ДинамическийСписок - реквизит формы, содержащий динамический список элементов. (Обычно "Список")
//	Параметры - Структура - параметры формы
//	Форма - УправляемаяФорма - сама форма.
Процедура УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры,
		Форма = Неопределено, Знач УстановленныеЭлементы = Неопределено) Экспорт

	Если НЕ Параметры.Свойство("ПредустановленныйОтбор") Тогда
		Возврат;
	КонецЕсли;

	ПредустановленныйОтбор = Параметры.ПредустановленныйОтбор;

	Если ТипЗнч(ПредустановленныйОтбор) = Тип("Строка")
		И ЗначениеЗаполнено(ПредустановленныйОтбор) Тогда
		НастройкиКомпоновки = ОбщегоНазначения.ЗначениеИзСтрокиXML(ПредустановленныйОтбор);
	Иначе
		Возврат;
	КонецЕсли;

	Отбор = НастройкиКомпоновки.Отбор;

	СкопироватьОтбор(Список.Отбор, Отбор.Элементы, УстановленныеЭлементы);
	ПроверитьПериодДействияПланаСчетовВОтборе(Отбор,
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "НаДату"),
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Организация"));

	Если Форма <> Неопределено Тогда

		Попытка

			ЭлементСписок = Форма.Элементы.Список;
			Если ЭлементСписок.Отображение <> ОтображениеТаблицы.Список Тогда
				ЭлементСписок.Отображение = ОтображениеТаблицы.Список;
			КонецЕсли;

		Исключение

		КонецПопытки;

	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПериодДействияПланаСчетовВОтборе(Отбор, Знач НаДату, Организация) Экспорт
	Если Отбор = Неопределено Или Не ЗначениеЗаполнено(НаДату) Тогда
		Возврат;
	КонецЕсли;
	НаДату = НачалоДня(НаДату);
	
	ИспользуемыеСчета = Новый Массив;
	ВыбратьСчетаИспользуемыеВОтборе(Отбор, ИспользуемыеСчета);
	Если ИспользуемыеСчета.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСчетов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ИспользуемыеСчета, "Код, ДатаНачалаДействия, ДатаОкончанияДействия");
	ЗаменитьНеактуальныеСчетаВОтборе(Отбор, ДанныеСчетов, НаДату, Организация);
	
КонецПроцедуры

Процедура ВыбратьСчетаИспользуемыеВОтборе(Отбор, ИспользуемыеСчета)
	Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ВыбратьСчетаИспользуемыеВОтборе(ЭлементОтбора, ИспользуемыеСчета);
		Иначе
			Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СписокЗначений") Тогда
				Для Каждого ЭлементСписка Из ЭлементОтбора.ПравоеЗначение Цикл
					Если ТипЗнч(ЭлементСписка.Значение) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
						ИспользуемыеСчета.Добавить(ЭлементСписка.Значение);
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
				ИспользуемыеСчета.Добавить(ЭлементОтбора.ПравоеЗначение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаменитьНеактуальныеСчетаВОтборе(Отбор, ДанныеСчетов, НаДату, Организация)
	Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ЗаменитьНеактуальныеСчетаВОтборе(ЭлементОтбора, ДанныеСчетов, НаДату, Организация);
		Иначе
			Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СписокЗначений") Тогда
				Для Каждого ЭлементСписка Из ЭлементОтбора.ПравоеЗначение Цикл
					Если ТипЗнч(ЭлементСписка.Значение) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
						ДанныеСчета = ДанныеСчетов.Получить(ЭлементСписка.Значение);
						ЭлементСписка.Значение = АктуальныйСчетДляОтбора(ЭлементСписка.Значение, ДанныеСчета, НаДату, Организация);
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
				ДанныеСчета = ДанныеСчетов.Получить(ЭлементОтбора.ПравоеЗначение);
				ЭлементОтбора.ПравоеЗначение = АктуальныйСчетДляОтбора(ЭлементОтбора.ПравоеЗначение, ДанныеСчета, НаДату, Организация);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция АктуальныйСчетДляОтбора(Счет, ДанныеСчета, НаДату, Организация)
	Если ДанныеСчета <> Неопределено
		И ((ЗначениеЗаполнено(ДанныеСчета.ДатаНачалаДействия) И ДанныеСчета.ДатаНачалаДействия > НаДату)
			Или (ЗначениеЗаполнено(ДанныеСчета.ДатаОкончанияДействия) И ДанныеСчета.ДатаОкончанияДействия < НаДату)) Тогда
			
		АктуальныйСчет = БухгалтерскийУчет.СчетПоКоду(ДанныеСчета.Код, НаДату, Организация);
		Возврат ?(ЗначениеЗаполнено(АктуальныйСчет), АктуальныйСчет, Счет);
	КонецЕсли;
	Возврат Счет;
КонецФункции

// Получает имена реквизитов формы.
//
// Параметры
//  Форма  - УправляемаяФорма
//  Путь  - Строка - путь к родительскому реквизиту. Если параметр опущен или указана пустая строка, возвращаются
//					имена реквизитов верхнего уровня.
//
// Возвращаемое значение:
//   Массив   - Массив имен реквизитов формы.
//
Функция ПолучитьИменаРеквизитовФормы(Форма, Путь = "",
		ВВерхнемРегистре = Ложь) Экспорт

	Реквизиты = Форма.ПолучитьРеквизиты(Путь);
	Результат = Новый Массив;
	Для каждого ТекРеквизит Из Реквизиты Цикл

		Результат.Добавить(?(ВВерхнемРегистре = Истина, ВРег(ТекРеквизит.Имя), ТекРеквизит.Имя));

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьЭлементыНаФормуПредварительногоПросмотра(ПараметрыПредварительногоПросмотра,
		Отказ) Экспорт

	Форма = ПараметрыПредварительногоПросмотра.Форма;
	ТиповаяОперация = ПараметрыПредварительногоПросмотра.ТиповаяОперация;
	ИдентификаторДокумента = ПараметрыПредварительногоПросмотра.ИдентификаторДокумента;
	МенеджерДокумента = ПараметрыПредварительногоПросмотра.МенеджерДокумента;

	СсылкаДокумента = МенеджерДокумента.ПолучитьСсылку();
	ТипЗначенияСсылки = ТипЗнч(СсылкаДокумента);
	ВалютныйУчет = ВДокументеИспользуетсяВалютныйУчет(ИдентификаторДокумента);

	ПараметрыДобавленияЭлементовФормы = ПараметрыДобавленияЭлементовФормы();
	ПараметрыДобавленияЭлементовФормы.Форма = Форма;
	ПараметрыДобавленияЭлементовФормы.Объект = СсылкаДокумента;
	ПараметрыДобавленияЭлементовФормы.ТипЗначенияСсылки = ТипЗначенияСсылки;
	ПараметрыДобавленияЭлементовФормы.ПолеДляРеквизитовОперации = Форма;
	ПараметрыДобавленияЭлементовФормы.ПолеДляДополнительныхТабЧастей = Форма;
	ПараметрыДобавленияЭлементовФормы.ДобавлятьДопРеквизитыОперации = Истина;
	ПараметрыДобавленияЭлементовФормы.ТиповаяОперация = ТиповаяОперация;
	ПараметрыДобавленияЭлементовФормы.РеквизитыФормы = Новый Массив;
	ПараметрыДобавленияЭлементовФормы.ВалютныйУчет = ВалютныйУчет;
	ПараметрыДобавленияЭлементовФормы.ПредварительныйПросмотр = Истина;

	БухгалтерскиеОперацииРаботаСФормами.ДобавитьРеквизитыЭлементыНаФорму(ПараметрыДобавленияЭлементовФормы);

КонецПроцедуры

// Документы, по которым проводки всегда формируются одновременно с проведением документа.
// Не включает документ "ОперацияБух", т.к. он не проводится.
//
// Возвращемое значение:
// - Массив - массив элементов типа "СправочникСсылка.ИдентификаторыОбъектовМетаданных"
Функция ДокументыФормирующиеПроводкиВсегдаОдновременно() Экспорт

	Возврат Новый Массив(БухгалтерскиеОперацииПовтИспНаВремяСеанса.ДокументыФормирующиеПроводкиВсегдаОдновременно());

КонецФункции

// Проверяет, что по указанному виду документа проводки формируются всегда при проведении документа,
// независимо от значения константы ФормированиеПроводокПриПроведенииДокумента.
// 
// Параметры:
// 	ИдентификаторДокумента - СправочникСсылка.ИдентификаторыОбъектовМетаданных - проверяемый вид документа.
// Возвращаемое значение:
// 	Булево - Истина, если по этому виду документов проводки всегда формируются при проведении документа.
//
Функция ПроводкиФормируютсяВсегдаОдновременно(ИдентификаторДокумента) Экспорт

	Возврат БухгалтерскиеОперацииПовтИспНаВремяСеанса.ДокументыФормирующиеПроводкиВсегдаОдновременно()
		.Найти(ИдентификаторДокумента) <> Неопределено;
	
КонецФункции

Процедура СкопироватьОтбор(ОтборСписка, ЭлементыОтбора, Знач УстановленныеЭлементы = Неопределено)
	
	Для каждого ЭлементОтбора Из ЭлементыОтбора Цикл

		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда

			ПредставлениеГруппы = ?(ПустаяСтрока(ЭлементОтбора.Представление), "ЭлементГруппыПредопределенногоОтбора"
				+ (ЭлементОтбора.Элементы.Количество() + 1), ЭлементОтбора.Представление);
			Группа = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ОтборСписка.Элементы, ПредставлениеГруппы, ЭлементОтбора.ТипГруппы);
			СкопироватьОтбор(Группа, ЭлементОтбора.Элементы);

		Иначе

			Элемент = ОтборСписка.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Элемент.ЛевоеЗначение = ЭлементОтбора.ЛевоеЗначение;
			Элемент.ВидСравнения = ЭлементОтбора.ВидСравнения;
			Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
			Элемент.ПравоеЗначение = ЭлементОтбора.ПравоеЗначение;
			Элемент.Представление = ЭлементОтбора.Представление;
			Элемент.Использование = ЭлементОтбора.Использование;
			
			Если ТипЗнч(УстановленныеЭлементы) = Тип("Массив") Тогда
				УстановленныеЭлементы.Добавить(ЭлементОтбора.ЛевоеЗначение);
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ПараметрыДобавленияЭлементовФормы() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Форма", Неопределено);
	Результат.Вставить("Объект", Неопределено);
	Результат.Вставить("ТипЗначенияСсылки", Неопределено);
	Результат.Вставить("ПолеДляРеквизитовОперации", Неопределено);
	Результат.Вставить("ПолеДляДополнительныхТабЧастей", Неопределено);
	Результат.Вставить("ДобавлятьДопРеквизитыОперации", Ложь);
	Результат.Вставить("ДобавлятьДопТабЧасти", Истина);
	Результат.Вставить("ТиповаяОперация", Справочники.ТиповыеОперации.ПустаяСсылка());
	Результат.Вставить("ПовторноеЧтениеОбъекта", Ложь);
	Результат.Вставить("РеквизитыФормы", Новый Массив);
	Результат.Вставить("ВалютныйУчет", Ложь);
	Результат.Вставить("ПредварительныйПросмотр", Ложь);
	Результат.Вставить("ЗначенияДопРеквизитов", Новый Структура); // не используется. Оставлено для совместимости

	Возврат Результат;

КонецФункции

Процедура ДобавитьРекурсивноЗависимыеЭлементы(СписокЗависимыхЭлементов,
		ДеревоЭлементовФормы)
	Для каждого ТекущийЭлемент Из ДеревоЭлементовФормы.Строки Цикл

		Если ЗначениеЗаполнено(ТекущийЭлемент.СтруктураСвязиПоТипу) Тогда
			СписокЗависимыхЭлементов.Добавить(ТекущийЭлемент.СтруктураСвязиПоТипу);
		КонецЕсли;

		ДобавитьРекурсивноЗависимыеЭлементы(СписокЗависимыхЭлементов, ТекущийЭлемент);

	КонецЦикла;
КонецПроцедуры

Процедура ВыбратьПодчиненныеЭлементыФормыРекурсивно(ПолеДляЭлементов,
		Исключения, УдаляемыеЭлементыФормы)

	Для каждого ТекЭлемент Из ПолеДляЭлементов.ПодчиненныеЭлементы Цикл

		Если Исключения.Найти(ТекЭлемент.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(ТекЭлемент) = Тип("ГруппаФормы") Тогда

			ВыбратьПодчиненныеЭлементыФормыРекурсивно(ТекЭлемент, Исключения, УдаляемыеЭлементыФормы);

		КонецЕсли;

		УдаляемыеЭлементыФормы.Добавить(ТекЭлемент.Имя);

	КонецЦикла;

КонецПроцедуры

Функция ДетальноеОписаниеСвязиПоТипу(СвязиПоТипу) Экспорт

	Результат = Новый Структура;
	Если НЕ ЗначениеЗаполнено(СвязиПоТипу) Тогда
		Возврат Результат;
	КонецЕсли;

	ПозицияОткрСкобки = СтрНайти(СвязиПоТипу, "(");
	ПозицияЗакрСкобки = СтрНайти(СвязиПоТипу, ")");

	ТипЧисло = Новый ОписаниеТипов("Число");

	Если ПозицияОткрСкобки > 0 И ПозицияЗакрСкобки > ПозицияОткрСкобки Тогда

		Результат.Вставить("ИмяСвязи", Лев(СвязиПоТипу, ПозицияОткрСкобки - 1));
		Результат.Вставить("ПорядокСвязи", ТипЧисло.ПривестиЗначение(Сред(СвязиПоТипу, ПозицияОткрСкобки
			+ 1, ПозицияЗакрСкобки - ПозицияОткрСкобки - 1)));

	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьПараметрыДанныхВыбора(Объект, ПараметрыДанныхВыбора,
		ОтборЭлементов, ТекстСвязиПараметровВыбора)

	Если ЗначениеЗаполнено(ОтборЭлементов) Тогда
		ПараметрыДанныхВыбора.Вставить("ПредустановленныйОтбор", ОтборЭлементов);
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстСвязиПараметровВыбора) Тогда
		СвязиПараметровВыбора = ЗначениеИзСтрокиВнутр(ТекстСвязиПараметровВыбора);

		Для каждого ТекСвязьПараметровВыбора Из СвязиПараметровВыбора Цикл
			ЗначениеРеквизита = Неопределено;
			ИмяПоля = "";
			ПолеВОтбор = Ложь;

			Если Лев(ТекСвязьПараметровВыбора.Реквизит, 7) = "Объект." Тогда
				ЗначениеРеквизита = Объект[Сред(ТекСвязьПараметровВыбора.Реквизит, 8)];
			КонецЕсли;
			Если ВРЕГ(Лев(ТекСвязьПараметровВыбора.Имя, 6)) = "ОТБОР." Тогда
				ИмяПоля = СокрП(Сред(ТекСвязьПараметровВыбора.Имя, 7));
				ПолеВОтбор = Истина;
			Иначе
				ИмяПоля = СокрЛП(ТекСвязьПараметровВыбора.Имя);
			КонецЕсли;
			Если ЗначениеЗаполнено(ИмяПоля)
					И ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
				Если ПолеВОтбор Тогда
					ПараметрыДанныхВыбора.Отбор.Вставить(ИмяПоля, ЗначениеРеквизита);
				Иначе
					ПараметрыДанныхВыбора.Вставить(ИмяПоля, ЗначениеРеквизита);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

