	СледующийСимвол = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
	Пока СледующийСимвол = "." Цикл
		ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
