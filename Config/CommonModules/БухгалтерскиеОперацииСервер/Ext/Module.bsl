Функция ПрочитатьИдентификатор(ОбщиеПараметры, ИндексСимвола, ДлинаТекста,
		Текст)
	ПропуститьНезначащийТекст(ОбщиеПараметры);

	Токен = "";
	Пока ИндексСимвола <= ДлинаТекста Цикл
		Буква = ВРЕГ(Сред(Текст, ИндексСимвола, 1));
		Если Найти("еоатинркулмДСвПдОсКцчыгзпбТНИьБФхВяРАЗЭйУЕГМЦжщЙШЩЫЛЯЧЬХЪЖЮЁёшъфэю_1234567890QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm", Буква) = 0 Тогда
			ОбщиеПараметры.ИндексСимвола = ИндексСимвола;
			Возврат Токен;
		КонецЕсли;

		Токен = Токен + Буква;
		ИндексСимвола = ИндексСимвола + 1;
	КонецЦикла;
	ОбщиеПараметры.ИндексСимвола = ИндексСимвола;
	Возврат Токен;

