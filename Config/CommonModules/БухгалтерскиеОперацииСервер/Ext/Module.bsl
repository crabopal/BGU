Функция ОбработатьРеквизитыЧерезТочку(Массив, ПредельноеКоличество = 2,
		ЭтоТиповаяОперация = Истина)

	Если Массив.Количество() = ПредельноеКоличество Тогда
		Результат = "";
		Для ИндексМассива = 0 По ПредельноеКоличество - 1 Цикл
			Результат = Результат + Массив[ИндексМассива]
				+ ?(ИндексМассива = (ПредельноеКоличество - 1)
				Или Массив[ИндексМассива] = "", "", ".");
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Массив.Количество() = 1 Тогда
		ВызватьИсключение "Ожидается имя реквизита";
	Иначе
		Если ЭтоТиповаяОперация Тогда
			Результат = "БУХГАЛТЕРСКИЕОПЕРАЦИИ.ЗНАЧЕНИЕРЕКВИЗИТА(";
		Иначе
			Результат = "БИБЛИОТЕКАФУНКЦИЙОБМЕНА.ЗНАЧЕНИЕРЕКВИЗИТАОБЪЕКТА(";
		КонецЕсли;
		Для ИндексМассива = 0 По ПредельноеКоличество - 1 Цикл
			Результат = Результат + Массив[ИндексМассива]
				+ ?(ИндексМассива = (ПредельноеКоличество - 1)
				Или Массив[ИндексМассива] = "", "", ".");
		КонецЦикла;
		Результат = Результат + ", """;
		КоличествоРеквизитов = Массив.ВГраница();
		Для ИндексМассива = ПредельноеКоличество По КоличествоРеквизитов Цикл

			Результат = Результат + Массив[ИндексМассива]
				+ ?(ИндексМассива = КоличествоРеквизитов, "", ".");

		КонецЦикла;
		Результат = Результат + """)";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура РазборФормулыПрочитатьЧисло(ПервыйСимвол, Токен, ТокенБезМакроса,
		ОбщиеПараметры, ПредыдущийИдентификатор)

	ТекстТокена = "";

	Если ПервыйСимвол = "-" ИЛИ ПервыйСимвол = "+" Тогда
		ТекстТокена = ТекстТокена + ПервыйСимвол;
		ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
		ПропуститьНезначащийТекст(ОбщиеПараметры);
	КонецЕсли;

	ЕстьТочка = Ложь;
	Пока ОбщиеПараметры.ИндексСимвола <= ОбщиеПараметры.ДлинаТекста Цикл
		Буква = Сред(ОбщиеПараметры.Текст, ОбщиеПараметры.ИндексСимвола, 1);
		Если ЭтоЦифра(Буква) Тогда
			ТекстТокена = ТекстТокена + Буква;
		ИначеЕсли Буква = "." Тогда
			Если ЕстьТочка Тогда
				РазборФормулыОбработатьОшибкуРазбора(ОбщиеПараметры, НСтр("ru = 'Вторая точка в числе'"));
				Возврат;
			КонецЕсли;
			ЕстьТочка = Истина;
			ТекстТокена = ТекстТокена + Буква;
		Иначе
			Прервать;
		КонецЕсли;
		ОбщиеПараметры.ИндексСимвола = ОбщиеПараметры.ИндексСимвола + 1;
	КонецЦикла;
	ПредыдущийИдентификатор = Истина;
	Токен = Токен + " " + ТекстТокена;
	ТокенБезМакроса = ТокенБезМакроса + " " + ТекстТокена;

КонецПроцедуры

