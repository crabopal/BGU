#Область ПрограммныйИнтерфейс

#Область ПрограммноеСозданиеДокументов

// Процедура добавляет переданные в структуре ДанныеПроведения данные в ДополнительныеСвойства объекта,
// для обработки в процедуре записи или проведения.
// Параметры:
// Объект - ДокументОбъект - записываемый документ.
// ТиповаяОперация - СправочникСсылка.ТиповыеОперации.
// ДополнительныеРеквизиты - Структура - содержит дополнительные реквизиты типовой операции. 
//							Ключ - ИмяДляФормулы соотвествующего реквизита, Значение - Значение реквизита.
// ФормироватьПроводки - Булево - формировать проводки при проведении документа. Имеет смысл только при формировании 
// 								  проводок обособленно от проведения документа.
// Бухгалтер - СправочникСсылка.Сотрудники - сотрудник для изменения ОтветственныйИсполнитель, который будет записан, если документ будет проведен.
//
Процедура ДобавитьДанныеДляПроведения(Объект, ТиповаяОперация,
		ДополнительныеРеквизиты, ФормироватьПроводки = Ложь, Бухгалтер = Неопределено) Экспорт

	Если Не ДокументПроводитсяПоРегиструБухгалтерии(Объект) Тогда
		Возврат;
	КонецЕсли;

	ИнициализироватьБухгалтерскиеОперации(Объект);
	ДанныеАвтоПроведения = Объект.ДополнительныеСвойства.ДанныеАвтоПроведения;
	ДанныеАвтоПроведения.ТиповаяОперация = ТиповаяОперация;
	ДанныеАвтоПроведения.ДополнительныеРеквизиты = ДополнительныеРеквизиты;
	ДанныеАвтоПроведения.ФормироватьПроводки = ФормироватьПроводки;
	ДанныеАвтоПроведения.ПрограммноеСоздание = Истина;
	ДанныеАвтоПроведения.ОтветственныйИсполнитель = Бухгалтер;

КонецПроцедуры

// Записывает переданные типовую операцию и реквизиты типовой операции в соответствующие регистры.
// Может использоваться в планах обмена, чтобы переносить документы с уже заполненной операцией.
// При заполнении дополнительных реквизитов операции будут получены значения по умолчанию в соответствии с настройками
// текущего пользователя.
// Если нужно установить вместо них другие значения или не заполнять их, то нужно явно задать ключи
// структуры "ДополнительныеРеквизиты" с соответствующими именами.
// Процедура не пытается прочитать проводки, а устанавливает признак ЕстьПроводки из параметра.
//
// Функция применяется для записанного объекта. Для нового объекта всегда возвращает "ложь" и ничего не делает.
//
// Параметры:
//  Объект  - ДокументОбъект - документ, которому будет записана типовая операция и доп. реквизиты.
//  ТиповаяОперация  - СправочникСсылка.ТиповыеОперации - типовая операция.
//  ЗначенияДополнительныхРеквизитов  - Структура - дополнительные реквизиты.
//                              Ключ - "Имя для формулы" дополнительного реквизита, "Значение" - значение реквизита.
//  Курс - Число - курс валюты.
//  Кратность - Число - кратность валюты,
//  ЕстьПроводки - Булево - признак наличия проводок.
//  РегистрироватьНаУзлахПлановОбмена - Булево
//
// Возвращаемое значение:
//  Булево - результат выполнения функции. Истина - успех, данные записаны, Ложь - неудача, данные не записаны.
//
Функция ЗаписатьДанныеТиповойОперацииОбъекта(Объект, ТиповаяОперация,
		Знач ЗначенияДополнительныхРеквизитов = Неопределено, Курс = 1,
		Кратность = 1, ЕстьПроводки = Ложь,
		Знач РегистрироватьНаУзлахПлановОбмена = Истина) Экспорт

	Если Объект.Ссылка.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(ЗначенияДополнительныхРеквизитов) <> Тип("Структура") Тогда
		ЗначенияДополнительныхРеквизитов = Новый Структура;
	КонецЕсли;

	СсылкаОбъекта = Объект.Ссылка;

	// Прочитать реквизиты операции
	РеквизитыОперации = Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(ТиповаяОперация);

	// Значения по умолчанию для выбранной организации установленные для всех пользователей
	РеквизитыПоУмолчанию = РеквизитыТиповойОперацииПоУмолчанию(Неопределено, ТиповаяОперация, Объект.Организация);

	// Вычислить реквизиты операции "Организация" и "Дата"
	ИсточникДанныхШапка = СоздатьИсточникДанныхИзШапкиОбъекта(Объект, ТиповаяОперация);
	ДанныеОперации = Новый Структура("Дата, Организация");

	УстановитьПривилегированныйРежим(Истина);
	РассчитатьРеквизитыОперации(ТиповаяОперация, ИсточникДанныхШапка, ДанныеОперации);
	УстановитьПривилегированныйРежим(Ложь);

	Результат = Истина;
	НачатьТранзакцию();

	Попытка

		// Запись типовой операции
		ДанныеДляЗаписи = РегистрыСведений.ОперацииДокументов.ДанныеДляЗаписи(СсылкаОбъекта);

		ДанныеДляЗаписи.Операция     = ТиповаяОперация;
		ДанныеДляЗаписи.Курс         = Курс;
		ДанныеДляЗаписи.Кратность    = Кратность;
		ДанныеДляЗаписи.ЕстьПроводки = ЕстьПроводки;
		ДанныеДляЗаписи.Организация  = ДанныеОперации.Организация;
		ДанныеДляЗаписи.Дата         = ДанныеОперации.Дата;

		РегистрыСведений.ОперацииДокументов.ЗаписатьОперацию(СсылкаОбъекта, ДанныеДляЗаписи, Истина, РегистрироватьНаУзлахПлановОбмена);

		// Запись дополнительных реквизитов
		НаборЗаписейРеквизиты = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
		НаборЗаписейРеквизиты.Отбор.Объект.Установить(СсылкаОбъекта);

		ЗначениеДопРеквизита = Неопределено;
		Для каждого ДополнительныйРеквизит Из РеквизитыОперации Цикл

		// В регистр пишем только доп. реквизиты, для которых задано значение
			Если НЕ ЗначенияДополнительныхРеквизитов.Свойство(ДополнительныйРеквизит.ИмяДляФормулы, ЗначениеДопРеквизита)
					И НЕ РеквизитыПоУмолчанию.Свойство(ДополнительныйРеквизит.ИмяДляФормулы, ЗначениеДопРеквизита) Тогда

				Продолжить;
			КонецЕсли;

			Запись = НаборЗаписейРеквизиты.Добавить();
			Запись.Объект = СсылкаОбъекта;
			Запись.РеквизитОперации = ДополнительныйРеквизит.Ссылка;
			Запись.Значение = ЗначениеДопРеквизита;

		КонецЦикла;
		
		Если Не РегистрироватьНаУзлахПлановОбмена Тогда
			НаборЗаписейРеквизиты.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
			НаборЗаписейРеквизиты.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
		КонецЕсли;

		НаборЗаписейРеквизиты.Записать(Истина);

		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
	
		ИнформацияОбОшибке = ИнформацияОбОшибке();

		ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрацииУстановкаТиповойОперации(),
			УровеньЖурналаРегистрации.Ошибка,
			Объект.Метаданные(),
			СсылкаОбъекта,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

		Результат = Ложь;

	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ИспользованиеСобственныхМодулейВРасширениях

// Добавляет заготовку для описания расширения в массив ИменаМодулей. Возвращает структуру - добавленное описание.
// Возвращаемая структура содержит ключи:
// 		*Заголовок - Строка - описание, которое добавляется к представлениям функций из расширения.
// 		*МодулиФункций - Массив - имена модулей функций, используемых в проводках и условиях операций.
// 		*МодулиИсточниковДанных - Массив - имена модулей функций дополнительных источников.
// 		*МодулиОбработчиков - Массив - имена модулей обработчиков "после формирования проводок".
// 		*МодулиПроведения - Массив - имена модулей процедур проведения без настройки проводок.
// 
// Параметры:
// 	ИменаМодулей - Массив - массив, в который добавляется пустая заготовка описания.
// Возвращаемое значение:
// 	Структура - добавленная заготовка описания.
Функция ОписаниеРасширения(ИменаМодулей) Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Заголовок", "");
	Описание.Вставить("МодулиФункций", Новый Массив);
	Описание.Вставить("МодулиИсточниковДанных", Новый Массив);
	Описание.Вставить("МодулиОбработчиков", Новый Массив);
	Описание.Вставить("МодулиПроведения", Новый Массив);

	ИменаМодулей.Добавить(Описание);

	Возврат Описание;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийФормы

Функция ЗаполнитьПараметрыДобавленияЭлементовФормы(Форма, Объект, ПолеДляРеквизитовОперации,
	ПараметрПолеДляДополнительныхТабЧастей, ТиповаяОперация, ДобавлятьДопРеквизитыОперации, ДобавлятьДопТабЧасти = Истина)

	Если ТипЗнч(ПараметрПолеДляДополнительныхТабЧастей) = Тип("ГруппаФормы") Тогда
		ПолеДляДополнительныхТабЧастей = ПараметрПолеДляДополнительныхТабЧастей;
	Иначе
		ПолеДляДополнительныхТабЧастей = Форма;
	КонецЕсли;
	
	РеквизитыФормы = ПолучитьИменаРеквизитовФормы(Форма);
	ПовторноеЧтениеОбъекта = РеквизитыФормы.Найти("БухгалтерскиеОперации_ДобавленныеРеквизитыОперации") <> Неопределено;
	
	ТипЗначенияСсылки = ТипЗнч(Объект.Ссылка);
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗначенияСсылки);

	ВалютныйУчет = ВДокументеИспользуетсяВалютныйУчет(ИдентификаторДокумента);
	
	ПараметрыДобавленияЭлементовФормы = ПараметрыДобавленияЭлементовФормы();
	ПараметрыДобавленияЭлементовФормы.Форма = Форма;
	ПараметрыДобавленияЭлементовФормы.Объект = Объект;
	ПараметрыДобавленияЭлементовФормы.ТипЗначенияСсылки = ТипЗначенияСсылки;
	ПараметрыДобавленияЭлементовФормы.ПолеДляРеквизитовОперации = ПолеДляРеквизитовОперации;
	ПараметрыДобавленияЭлементовФормы.ПолеДляДополнительныхТабЧастей = ПолеДляДополнительныхТабЧастей;
	ПараметрыДобавленияЭлементовФормы.ДобавлятьДопТабЧасти = ДобавлятьДопТабЧасти;
	ПараметрыДобавленияЭлементовФормы.ДобавлятьДопРеквизитыОперации = ДобавлятьДопРеквизитыОперации;
	ПараметрыДобавленияЭлементовФормы.ПовторноеЧтениеОбъекта = ПовторноеЧтениеОбъекта;
	ПараметрыДобавленияЭлементовФормы.РеквизитыФормы = РеквизитыФормы;
	ПараметрыДобавленияЭлементовФормы.ВалютныйУчет = ВалютныйУчет;
	ПараметрыДобавленияЭлементовФормы.ТиповаяОперация = ТиповаяОперация;
	
	Возврат ПараметрыДобавленияЭлементовФормы;
	
КонецФункции

Процедура ПриЧтенииНаСервере(Знач Форма, Знач Объект,
		Знач ПолеДляРеквизитовОперации,
		Знач ПараметрПолеДляДополнительныхТабЧастей = Неопределено) Экспорт

	// Даты запрета изменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(Форма, Объект);
	// Конец Даты запрета изменения
	ТипЗначенияСсылки = ТипЗнч(Объект.Ссылка);
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗначенияСсылки);

	ДобавлятьДопРеквизитыОперации = ДобавлятьДопРеквизитыОперации(ИдентификаторДокумента);

	Если ДобавлятьДопРеквизитыОперации Тогда
		ТиповаяОперация = БухгалтерскаяОперацияДокумента(Объект.Ссылка);
	Иначе
		ТиповаяОперация = Неопределено;
	КонецЕсли;

	ПараметрыДобавленияЭлементовФормы = ЗаполнитьПараметрыДобавленияЭлементовФормы(Форма, Объект, ПолеДляРеквизитовОперации,
		ПараметрПолеДляДополнительныхТабЧастей, ТиповаяОперация, ДобавлятьДопРеквизитыОперации);
	БухгалтерскиеОперацииРаботаСФормами.ДобавитьРеквизитыЭлементыНаФорму(ПараметрыДобавленияЭлементовФормы);

	ЗначенияДопКолонок = ПолучитьЗначенияСохраненныхДопКолонок(Форма.Объект);
	ЗаполнитьЗначенияДобавленныхРеквизитов(Форма, Форма.Объект, ЗначенияДопКолонок);
	УстановитьТолькоПросмотрСКонфликтомИмен(Форма);

	Если ПараметрыДобавленияЭлементовФормы.ДобавлятьДопРеквизитыОперации Тогда
		ЗначенияДопРеквизитов = ЗаполнитьДополнительныеРеквизиты(Объект.Ссылка, ТиповаяОперация);
		УстановитьЗначенияИСвойстваЭлементовФормы(Форма, ПолеДляРеквизитовОперации, ТиповаяОперация, ЗначенияДопРеквизитов);
	КонецЕсли;

КонецПроцедуры

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка,
		Знач ПолеДляРеквизитовОперации,
		Знач ПолеДляДополнительныхТабЧастей = Неопределено) Экспорт

	Форма = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(ПолеДляРеквизитовОперации, Тип("ФормаКлиентскогоПриложения"));
	Объект = Форма.Объект;

	ЭтоНовый = Объект.Ссылка.Пустая();
	Если НЕ ЭтоНовый Тогда
		Возврат;
	КонецЕсли;

	ТипЗначенияСсылки = ТипЗнч(Объект.Ссылка);
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗначенияСсылки);
	ВалютныйУчет = ВДокументеИспользуетсяВалютныйУчет(ИдентификаторДокумента);

	ДобавлятьДопРеквизитыОперации = ДобавлятьДопРеквизитыОперации(ИдентификаторДокумента);

	Если ДобавлятьДопРеквизитыОперации Тогда
		ТиповаяОперацияИДопРеквизиты = ТиповаяОперацияДляНовогоДокумента(Форма, Объект, ИдентификаторДокумента, ВалютныйУчет);
		ТиповаяОперация = ТиповаяОперацияИДопРеквизиты.ТиповаяОперация;
		ЗначенияДопРеквизитов = ТиповаяОперацияИДопРеквизиты.ДополнительныеРеквизиты;
	Иначе
		ТиповаяОперация = Справочники.ТиповыеОперации.ПустаяСсылка();
		ЗначенияДопРеквизитов = Новый Структура;
	КонецЕсли;

	ПараметрыДобавленияЭлементовФормы = ЗаполнитьПараметрыДобавленияЭлементовФормы(Форма, Объект, ПолеДляРеквизитовОперации,
		ПолеДляДополнительныхТабЧастей, ТиповаяОперация, ДобавлятьДопРеквизитыОперации);
	БухгалтерскиеОперацииРаботаСФормами.ДобавитьРеквизитыЭлементыНаФорму(ПараметрыДобавленияЭлементовФормы);

	ЗаполнитьЗначенияДобавленныхРеквизитов(Форма, Форма.Объект, ЗначенияДополнительныхКолонокДляНовогоДокумента(Форма));
	УстановитьТолькоПросмотрСКонфликтомИмен(Форма);

	Если ПараметрыДобавленияЭлементовФормы.ДобавлятьДопРеквизитыОперации Тогда
		Если Не ЗначениеЗаполнено(ЗначенияДопРеквизитов) Тогда
			ЗначенияДопРеквизитов = ДополнительныеРеквизитыДляНовогоДокумента(Форма, Объект, ТиповаяОперация, ВалютныйУчет);
		КонецЕсли;
		ИзменитьЗначенияДопРеквизитовПередУстановкой(ИдентификаторДокумента, Объект, ТиповаяОперация, ЗначенияДопРеквизитов);
		Если ВалютныйУчет Тогда
			ЗаполнитьКурсИКратностьОперации(ЗначенияДопРеквизитов, Форма, Объект);
		КонецЕсли;
		УстановитьЗначенияИСвойстваЭлементовФормы(Форма, ПолеДляРеквизитовОперации, ТиповаяОперация, ЗначенияДопРеквизитов);
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьЗначенияИСвойстваЭлементовФормы(Форма, ПолеДляРеквизитовОперации, ТиповаяОперация, ЗначенияДопРеквизитов)
	
	ЗаполнитьДополнительныеРеквизитыВФорме(Форма, ТиповаяОперация, ЗначенияДопРеквизитов);
	БухгалтерскиеОперацииКлиентСервер.ОбновитьВидимостьВсехЭлементов(Форма);
	УстановитьКартинкуЗакладки(Форма, ТиповаяОперация);
	
КонецПроцедуры

Функция ДобавлятьДопРеквизитыОперации(ИдентификаторДокумента)
	
	ДокументОперацияБух = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.ОперацияБух"));
	
	Если ИдентификаторДокумента = ДокументОперацияБух
		ИЛИ ПроводкиФормируютсяВсегдаОдновременно(ИдентификаторДокумента) Тогда
	
		Возврат Истина;
	
	Иначе
	
		Возврат ПравоДоступа("Просмотр", Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ)
			И НЕ ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента");
	
	КонецЕсли;
	
КонецФункции

Функция ЗначенияДополнительныхКолонокДляНовогоДокумента(Форма)

	ЗначениеКопирования = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Параметры, "ЗначениеКопирования");
	Если ЗначениеЗаполнено(ЗначениеКопирования) Тогда
		Возврат ПолучитьЗначенияСохраненныхДопКолонок(ЗначениеКопирования);
	Иначе
		Возврат ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Параметры, "ЗначенияДопКолонок");
	КонецЕсли;
	
КонецФункции

Функция ДополнительныеРеквизитыДляНовогоДокумента(Форма, Объект, ТиповаяОперация, ВалютныйУчет)

	ЗначениеКопирования = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Параметры, "ЗначениеКопирования");
	Основание           = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Параметры, "Основание");
	Если ТипЗнч(Основание) = Тип("Структура") Тогда
		КорректируемыйДокумент = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Основание, "КорректируемыйДокумент");
	Иначе
		КорректируемыйДокумент = Неопределено;
	КонецЕсли;

	Если ЗначениеЗаполнено(КорректируемыйДокумент) Тогда
	    Возврат ЗаполнитьДополнительныеРеквизиты(КорректируемыйДокумент, ТиповаяОперация, ВалютныйУчет);
	ИначеЕсли ЗначениеЗаполнено(ЗначениеКопирования) Тогда
		Возврат ЗаполнитьДополнительныеРеквизиты(ЗначениеКопирования, ТиповаяОперация, ВалютныйУчет);
	Иначе
		Возврат ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Параметры, "ЗначенияДопРеквизитов");
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТиповуюОперациюИзПараметровФормы(Форма, Объект)
	
	ЗначениеКопирования = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Параметры, "ЗначениеКопирования");
	Основание           = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Параметры, "Основание");
	Если ТипЗнч(Основание) = Тип("Структура") Тогда
		КорректируемыйДокумент = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Основание, "КорректируемыйДокумент");
	Иначе
		КорректируемыйДокумент = Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура("ТиповаяОперация, ДополнительныеРеквизиты");
	
	Если ЗначениеЗаполнено(КорректируемыйДокумент) Тогда
	    Результат.ТиповаяОперация = БухгалтерскаяОперацияДокумента(КорректируемыйДокумент);
	ИначеЕсли ЗначениеЗаполнено(ЗначениеКопирования) Тогда
		Результат.ТиповаяОперация = БухгалтерскаяОперацияДокумента(ЗначениеКопирования);
	ИначеЕсли ЗначениеЗаполнено(Основание) И ОбщегоНазначения.ЗначениеСсылочногоТипа(Основание) Тогда
		Результат = ТиповаяОперацияПоДокументуОснованию(Основание, Объект);
	Иначе
		Результат.ТиповаяОперация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Параметры, "ТиповаяОперация");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТиповаяОперацияВходитВСписокДопустимых(ТиповаяОперация, СписокДопустимыхТиповыхОпераций)
	
	Если Не ЗначениеЗаполнено(ТиповаяОперация) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат СписокДопустимыхТиповыхОпераций.НайтиПоЗначению(ТиповаяОперация) <> Неопределено;
	
КонецФункции

Функция ТиповаяОперацияДляНовогоДокумента(Форма, Объект, ИдентификаторДокумента, ВалютныйУчет)

	Результат = ПолучитьТиповуюОперациюИзПараметровФормы(Форма, Объект);

	СписокДопустимыхТиповыхОпераций = Справочники.ТиповыеОперации.ПолучитьСписокТиповыхОперацийПоУсловиям(
		ИдентификаторДокумента,
		ПараметрыДляВыбораТиповойОперации(Объект, ИдентификаторДокумента));

	Если НЕ ТиповаяОперацияВходитВСписокДопустимых(Результат.ТиповаяОперация, СписокДопустимыхТиповыхОпераций) Тогда
		Результат.ТиповаяОперация = Справочники.ТиповыеОперации.ПустаяСсылка();
		Результат.ДополнительныеРеквизиты = Новый Структура;
	КонецЕсли;

	Если ЗначениеЗаполнено(Результат.ТиповаяОперация)
		И ПроверятьПравоПросмотраТиповойОперацииВФорме(Форма)
		И НЕ Справочники.ТиповыеОперации.ПраваДоступаКТиповойОперации(Результат.ТиповаяОперация).Просмотр Тогда
			
		Результат.ТиповаяОперация = Справочники.ТиповыеОперации.ПустаяСсылка();
		Результат.ДополнительныеРеквизиты = Новый Структура;
	КонецЕслИ;

	Если Не ЗначениеЗаполнено(Результат.ТиповаяОперация)
		И (НЕ ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента")
			ИЛИ ПроводкиФормируютсяВсегдаОдновременно(ИдентификаторДокумента)) Тогда
		
		ТиповаяОперацияПоУмолчанию = ТиповаяОперацияПоУмолчанию(ИдентификаторДокумента);
		Если ТиповаяОперацияВходитВСписокДопустимых(ТиповаяОперацияПоУмолчанию, СписокДопустимыхТиповыхОпераций) Тогда
			Результат.ТиповаяОперация = ТиповаяОперацияПоУмолчанию;
		КонецЕсли;

	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Результат.ТиповаяОперация) И СписокДопустимыхТиповыхОпераций.Количество() = 1 Тогда
		Результат.ТиповаяОперация = СписокДопустимыхТиповыхОпераций[0].Значение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверятьПравоПросмотраТиповойОперацииВФорме(Форма)
	Возврат НЕ Форма.Параметры.Свойство("НеПроверятьПраваТиповойОперации")
			ИЛИ Форма.Параметры.НеПроверятьПраваТиповойОперации = Ложь;
КонецФункции

Процедура ЗаполнитьКурсИКратностьОперации(ЗначенияДопРеквизитов, Форма, Объект)
	Если ЗначенияДопРеквизитов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначенияДопРеквизитов.Свойство("Курс") Тогда
		ЗначенияДопРеквизитов.Вставить("Курс");
	КонецЕсли;
	Если Не ЗначенияДопРеквизитов.Свойство("Кратность") Тогда
		ЗначенияДопРеквизитов.Вставить("Кратность");
	КонецЕсли;

	НеПересчитыватьКурс = Форма.Параметры.Свойство("НеПересчитыватьКурсПриВводе")
		И Форма.Параметры.НеПересчитыватьКурсПриВводе = Истина
		И ЗначениеЗаполнено(ЗначенияДопРеквизитов.Курс)
		И ЗначениеЗаполнено(ЗначенияДопРеквизитов.Кратность);

	Если НЕ НеПересчитыватьКурс Тогда
		Если Объект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
			ЗначенияДопРеквизитов.Курс = 1;
			ЗначенияДопРеквизитов.Кратность = 1;
		Иначе
			КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.ВалютаДокумента, Объект.Дата);
			ЗначенияДопРеквизитов.Курс = КурсКратность.Курс;
			ЗначенияДопРеквизитов.Кратность = КурсКратность.Кратность;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Процедура вызывается из формы документа из события ПередЗаписьюНаСервере
// Здесь только записываются в ДополнительныеСвойства текущего объекта типовая операция и 
// дополнительные реквизиты из формы.
//
Процедура ПередЗаписью(Отказ, ТекущийОбъект, ПараметрыЗаписи, Форма) Экспорт

	ТекущийОбъект.ДополнительныеСвойства.Вставить("ЗаписьИзФормыДокумента", Истина);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ДанныеДополнительныхТабЧастей", ПолучитьЗначенияДополнительныхТабличныхЧастейИзФормы(Форма));

	ФормированиеПроводокОбособленноОтДокумента = НЕ Форма["БухгалтерскиеОперации_ПризнакФормированияПроводокАвтоматически"];
	ТипЗначенияСсылки = ТипЗнч(ТекущийОбъект.Ссылка);

	Если ТипЗначенияСсылки <> Тип("ДокументСсылка.ОперацияБух")
			И НЕ ПроводкиФормируютсяВсегдаОдновременно(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗначенияСсылки)) Тогда

		Если ФормированиеПроводокОбособленноОтДокумента Тогда
			Возврат;
		КонецЕсли;

		Если Форма.Элементы.Найти(БухгалтерскиеОперацииКлиентСервер.ПрефиксЭлементовОперации()
				+ БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаФормыТиповаяОперация()) = Неопределено Тогда
				// типовая операция не выводилась на форму
			Возврат;
		КонецЕсли;
		НеИспользоватьВалютныйУчет = Ложь;
	Иначе

		НеИспользоватьВалютныйУчет = Истина;

	КонецЕсли;

	Если Не ДокументПроводитсяПоРегиструБухгалтерии(ТекущийОбъект) Тогда
		Возврат;
	КонецЕсли;

	ИнициализироватьБухгалтерскиеОперации(ТекущийОбъект);

	ТиповаяОперация = Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаФормыТиповаяОперация()];
	Если ЗначениеЗаполнено(ТиповаяОперация)
			И (ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись
			ИЛИ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение)
			И НЕ ТиповаяОперацияСоответствуетДокументу(ТекущийОбъект, ТиповаяОперация) Тогда

		СообщитьТиповаяОперацияНеСоответствуетДокументу(ТекущийОбъект, Форма);
		Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	НеИспользоватьВалютныйУчет = НеИспользоватьВалютныйУчет
		ИЛИ НЕ ИспользоватьВалютныйУчет(ТекущийОбъект);
	ДополнительныеРеквизиты = Неопределено;
	ЗначенияДопРеквизитов = Неопределено;
	СформироватьСтруктуруДопРеквизитов(Форма, ДополнительныеРеквизиты, ЗначенияДопРеквизитов, НеИспользоватьВалютныйУчет);

	ДанныеАвтоПроведения = ТекущийОбъект.ДополнительныеСвойства.ДанныеАвтоПроведения;
	ДанныеАвтоПроведения.ТиповаяОперация = ТиповаяОперация;
	ДанныеАвтоПроведения.ДополнительныеРеквизиты = ДополнительныеРеквизиты;
	ДанныеАвтоПроведения.ТаблицаЗначенийДопРеквизитов = ЗначенияДопРеквизитов;
	ДанныеАвтоПроведения.ВызовИзФормы = Истина;
	ДанныеАвтоПроведения.ОтветственныйИсполнитель = ОтветственныйИсполнительИзФормы(Форма);

КонецПроцедуры

// Вызывается из формы при изменении типовой операции через подключаемую процедуру ПриИзмененииТиповойОперации
//
// Параметры:
// 	ПолеДляРеквизитовОперации - ГруппаФормы - группа формы для размещения элементов типовой операции.
// 	ЗаполнятьЗначенияПоУмолчанию - Булево - Заполнять пустые дополнительные реквизиты по умолчанию.
Процедура ПриИзмененииТиповойОперации(Знач ПолеДляРеквизитовОперации,
		ЗаполнятьЗначенияПоУмолчанию = Истина) Экспорт

	Если ТипЗнч(ПолеДляРеквизитовОперации) = Тип("ФормаКлиентскогоПриложения") Тогда
		Форма = ПолеДляРеквизитовОперации;
	Иначе
		Если ПолеДляРеквизитовОперации.Имя = "ТиповыеОперации_ТиповаяОперацияДокумента" Тогда
			ПолеДляРеквизитовОперации = ПолеДляРеквизитовОперации.Родитель;
		КонецЕсли;
		Форма = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(ПолеДляРеквизитовОперации, Тип("ФормаКлиентскогоПриложения"));
	КонецЕсли;
	ПолеДляРеквизитовОперации = Форма.Элементы[Форма.БухгалтерскиеОперации_ИмяГруппыЭлементовТиповойОперации];
	Объект = Форма["Объект"];

	РеквизитыФормы = ПолучитьИменаРеквизитовФормы(Форма);
	Если РеквизитыФормы.Найти("БухгалтерскиеОперации_ДобавленныеРеквизитыОперации") = Неопределено Тогда
	// Нет реквизита, значит типовая операция не выводилась на форму
		Возврат;
	КонецЕсли;

	ТиповаяОперация = Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитыФормыТиповаяОперацияФактическое(Форма)];

	ТипЗначенияСсылки = ТипЗнч(Объект.Ссылка);
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗначенияСсылки);

	ПараметрыДобавленияЭлементовФормы = ЗаполнитьПараметрыДобавленияЭлементовФормы(Форма, Объект, ПолеДляРеквизитовОперации,
		Неопределено, ТиповаяОперация, Истина, Ложь);

	ЗначенияДопРеквизитовДоИзменения = БухгалтерскиеОперацииКлиентСервер.ЗначенияДополнительныхРеквизитовИзФормы(Форма);

	БухгалтерскиеОперацииРаботаСФормами.ДобавитьРеквизитыЭлементыНаФорму(ПараметрыДобавленияЭлементовФормы);

	ИзменитьЗначенияДопРеквизитовПередУстановкой(ИдентификаторДокумента, Объект, ТиповаяОперация, ЗначенияДопРеквизитовДоИзменения, ЗаполнятьЗначенияПоУмолчанию);
	УстановитьЗначенияИСвойстваЭлементовФормы(Форма, ПолеДляРеквизитовОперации, ТиповаяОперация, ЗначенияДопРеквизитовДоИзменения);
	
	ОбщегоНазначенияБГУ.СохранитьИменаРеквизитовОперацииЗависящихОтУчетнойПолитики(Форма, ТиповаяОперация);
	ПриИзмененииПараметровФункциональныхОпций(ПолеДляРеквизитовОперации);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьЦентрализованнуюБухгалтерию") Тогда
		УстановитьПараметрыВыбораОтветственногоИсполнителя(ИдентификаторДокумента, Форма);
	КонецЕсли;

КонецПроцедуры

// Вызывается из формы документа при изменении реквизита объекта, от которого может зависеть
// список доступных типовых операций.
//
// Пример использования:
//
//&НаКлиенте
//Процедура ВидПоступленияПриИзменении()
//
//	ВидПоступленияПриИзмененииНаСервере();
//
//КонецПроцедуры
//
//&НаСервере
//Процедура ВидПоступленияПриИзмененииНаСервере()
//
//	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект, Объект);
//
//КонецПроцедуры
//
// Пример использования в расширении конфигурации:
//
//&После("ВидПоступленияПриИзмененииНаСервере")
//&НаСервере
//Процедура ВидПоступленияПриИзмененииНаСервере_Расш1()
//
//	БухгалтерскиеОперацииСервер.ПриИзмененииКлючевогоРеквизита(ЭтотОбъект, Объект);
//
//КонецПроцедуры
//
// Параметры:
//  Форма	 - УправляемаяФорма - форма, из которой вызывается процедура.
//  Объект	 - ДанныеФормыСтруктура, ДанныеФормыСтруктураСКоллекцией, ДокументОбъект - документ, из которого получаются значения реквизитов.
// 
Процедура ПриИзмененииКлючевогоРеквизита(Форма, Знач Объект = Неопределено) Экспорт

	Если ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента")
		Или НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "БухгалтерскиеОперации_ДобавленныеРеквизитыОперации") Тогда
		// На форме нет добавленных реквизитов типовой операции
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаТиповаяОперация = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитыФормыТиповаяОперацияФактическое(Форма);
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизитаТиповаяОперация) Тогда
		// На форме нет реквизита хранения типовой операции
		Возврат;
	КонецЕсли;
	
	Если Объект = Неопределено Тогда
		Объект = Форма.Объект;
	КонецЕсли;
	
	ВыбраннаяТиповаяОперация = Форма[ИмяРеквизитаТиповаяОперация];
	Форма.БухгалтерскиеОперации_ИзмениласьТиповаяОперация = БухгалтерскиеОперацииКлиентСервер.ПризнакИзмененияТиповойОперации_БезИзменения();
	
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.Ссылка));
	СписокДопустимыхТиповыхОпераций = Справочники.ТиповыеОперации.ПолучитьСписокТиповыхОперацийПоУсловиям(ИдентификаторДокумента,
		ПараметрыДляВыбораТиповойОперации(Объект, ИдентификаторДокумента));
	
	Если СписокДопустимыхТиповыхОпераций.НайтиПоЗначению(ВыбраннаяТиповаяОперация) <> Неопределено Тогда
		// Типовая операция допустима в контексте реквизиов документа. Действия не требуются.
		Возврат;
	КонецЕсли;
	
	Если СписокДопустимыхТиповыхОпераций.Количество() = 1 Тогда
		Если ЗначениеЗаполнено(Форма[ИмяРеквизитаТиповаяОперация]) Тогда
			Форма.БухгалтерскиеОперации_ИзмениласьТиповаяОперация = БухгалтерскиеОперацииКлиентСервер.ПризнакИзмененияТиповойОперации_Изменена();
		Иначе
			Форма.БухгалтерскиеОперации_ИзмениласьТиповаяОперация = БухгалтерскиеОперацииКлиентСервер.ПризнакИзмененияТиповойОперации_Установлена();
		КонецЕсли;
		Форма[ИмяРеквизитаТиповаяОперация] = СписокДопустимыхТиповыхОпераций[0].Значение;
	Иначе
		Форма.БухгалтерскиеОперации_ИзмениласьТиповаяОперация = БухгалтерскиеОперацииКлиентСервер.ПризнакИзмененияТиповойОперации_Очищена();
		Форма[ИмяРеквизитаТиповаяОперация] = Справочники.ТиповыеОперации.ПустаяСсылка();
	КонецЕсли;
	ПриИзмененииТиповойОперации(Форма);

КонецПроцедуры

Процедура УстановитьКартинкуЗакладки(Форма, ТиповаяОперация)
	
	ГруппаБухгалтерскаяОперация = Форма.Элементы.Найти("БухгалтерскаяОперация");
	
	Если ГруппаБухгалтерскаяОперация = Неопределено Или ГруппаБухгалтерскаяОперация.Вид <> ВидГруппыФормы.Страница Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТиповаяОперация) Тогда
		Картинка = БиблиотекаКартинок.Внимание16;
	Иначе
		Картинка = Новый Картинка();
	КонецЕсли;
	ГруппаБухгалтерскаяОперация.Картинка = Картинка;
	
КонецПроцедуры

Процедура ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	ЗначенияДопКолонок = ПолучитьЗначенияСохраненныхДопКолонок(Форма.Объект);
	ЗаполнитьЗначенияДобавленныхРеквизитов(Форма, Форма.Объект, ЗначенияДопКолонок);
	Если ПолучитьФункциональнуюОпцию("ФормированиеПроводокПриПроведенииДокумента") Тогда
		БухгалтерскиеОперацииКлиентСервер.ОбновитьВидимостьВсехЭлементов(Форма);
		// После записи мог измениться ответственный исполнитель
		ОтветственныйИсполнитель = РегистрыСведений.ОперацииДокументов.ПрочитатьОперацию(ТекущийОбъект.Ссылка)
			.ОтветственныйИсполнитель;
		// Безопасная установка значения реквизита формы, которого может не существовать на форме
		ВременнаяСтруктура = Новый Структура;
		ВременнаяСтруктура.Вставить(БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаОтветственныйИсполнитель(),
			ОтветственныйИсполнитель);
		ЗаполнитьЗначенияСвойств(Форма, ВременнаяСтруктура); 
	КонецЕсли;
КонецПроцедуры

Процедура ПриИзмененииПараметровФункциональныхОпций(ПолеДляРеквизитовОперации) Экспорт

	Форма = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(ПолеДляРеквизитовОперации, Тип("ФормаКлиентскогоПриложения"));

	Для каждого ДобавленныйРеквизит Из Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"] Цикл
		
		ДобавленныйРеквизит.ВидимостьПоФО = БухгалтерскиеОперацииРаботаСФормами.ВидимостьПоФункциональнымОпциям(Форма,
			ДобавленныйРеквизит.ФункциональныеОпции);

	КонецЦикла;
	
	БухгалтерскиеОперацииКлиентСервер.УстановитьВидимостьЭлементов(Форма);

КонецПроцедуры

Процедура ЗаполнитьЗначенияДобавленныхРеквизитов(Форма, Объект, ЗначенияДопКолонок) Экспорт
	Перем ЗначенияКолонокТЧ;

	ДобавленныеРеквизитыОперации = Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"];

	ИменаТЧ = ОбщегоНазначенияКлиентСервер.СвернутьМассив(
		ДобавленныеРеквизитыОперации.Выгрузить(, "ИмяТаблицы").ВыгрузитьКолонку("ИмяТаблицы"));

	Для каждого ИмяТЧ Из ИменаТЧ Цикл

		РеквизитыТЧ = ДобавленныеРеквизитыОперации.НайтиСтроки(Новый Структура("ИмяТаблицы, ЭтоГруппа", ИмяТЧ, Ложь));

		Если НЕ ПустаяСтрока(ИмяТЧ) И ТипЗнч(ЗначенияДопКолонок) = Тип("Структура")
				И ЗначенияДопКолонок.Свойство(ИмяТЧ, ЗначенияКолонокТЧ) Тогда

				// преобразовать таблицу...
			ДанныеТаблицы = ЗначенияКолонокТЧ.ДанныеТаблицы;

			Если ТипЗнч(ДанныеТаблицы) = Тип("Массив") Тогда
				ДанныеТаблицы = ТаблицаЗначенийИзМассива(ДанныеТаблицы);
			КонецЕсли;

			ИменаКолонок = Новый Массив;
			Для каждого ТекРеквизитТЧ Из РеквизитыТЧ Цикл

				Если ПустаяСтрока(ТекРеквизитТЧ.ИмяРеквизита)
						ИЛИ ПустаяСтрока(ТекРеквизитТЧ.ИмяДляФормулы) Тогда
					Продолжить;
				КонецЕсли;

				ДанныеТаблицы.Колонки.Добавить(ТекРеквизитТЧ.ИмяРеквизита, ДанныеТаблицы.Колонки[ТекРеквизитТЧ.ИмяДляФормулы].ТипЗначения);
				ДанныеТаблицы.ЗагрузитьКолонку(ДанныеТаблицы.ВыгрузитьКолонку(ТекРеквизитТЧ.ИмяДляФормулы), ТекРеквизитТЧ.ИмяРеквизита);
				ИменаКолонок.Добавить(ТекРеквизитТЧ.ИмяРеквизита);

				ПредопределеннаяТабличнаяЧасть = ТекРеквизитТЧ.ПредопределеннаяТЧ;

			КонецЦикла;
			СтрокаИменКолонок = СтрСоединить(ИменаКолонок, ",");

			Если ПредопределеннаяТабличнаяЧасть Тогда

				ИндексСтрокиТЧ = 0;
				КоличествоСтрокТЧ = ДанныеТаблицы.Количество();
				Для каждого СтрокаТЧДокумента Из Объект[ИмяТЧ] Цикл

					Пока ИндексСтрокиТЧ < КоличествоСтрокТЧ
						И ДанныеТаблицы[ИндексСтрокиТЧ].НомерСтрокиДокумента < СтрокаТЧДокумента.НомерСтроки Цикл

						ИндексСтрокиТЧ = ИндексСтрокиТЧ + 1;

					КонецЦикла;

					Если ИндексСтрокиТЧ = КоличествоСтрокТЧ Тогда
						Прервать;
					КонецЕсли;

					Если ДанныеТаблицы[ИндексСтрокиТЧ].НомерСтрокиДокумента = СтрокаТЧДокумента.НомерСтроки Тогда

						ЗаполнитьЗначенияСвойств(СтрокаТЧДокумента, ДанныеТаблицы[ИндексСтрокиТЧ], СтрокаИменКолонок);
						ИндексСтрокиТЧ = ИндексСтрокиТЧ + 1;

					КонецЕсли;

				КонецЦикла;

			Иначе

				СтрокиОписанияТЧ = ДобавленныеРеквизитыОперации.НайтиСтроки(Новый Структура("ИмяДляФормулы", ИмяТЧ));

				Если СтрокиОписанияТЧ.Количество() > 0 Тогда
					Форма[СтрокиОписанияТЧ[0].ИмяРеквизита].Загрузить(ДанныеТаблицы);
				КонецЕсли;

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// Фактическая дата проведения документа из регистра сведений ДатыПроведенияДокументов.
// Если дата не заполнена или документа нет в ОТ.ДокументыСОтдельнойДатойПроведения, возвращается пустая дата.
// 
// Параметры:
//  Документ - ДокументСсылка
// 
// Возвращаемое значение:
// 	Дата 
Функция ФактическаяДатаПроведенияДокумента(Документ) Экспорт
	Возврат БухгалтерскийУчет.УстановленнаяДатаПроведения(Документ);
КонецФункции

// Функция проверяет необходимость вывода валютных реквизитов в типовой операции документа.
// Проверяется функциональная опция ИспользоватьВалютныйУчет и наличие реквизитов документа
// "ВалютаДокумента" и "Курс".
//
// Параметры:
//  ОбъектИлиСсылка - ДокументОбъект,ДокументСсылка - проверяемый документ.
// 
// Возвращаемое значение:
// Булево - Истина, если необходимо использовать реквизиты типовой операции "Курс" и "Кратность". Иначе Ложь.
//
Функция ИспользоватьВалютныйУчет(ОбъектИлиСсылка) Экспорт

	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МетаданныеДокумента = ОбъектИлиСсылка.Метаданные();
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ВалютаДокумента", МетаданныеДокумента)
		И НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта("Курс", МетаданныеДокумента) Тогда
		
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ТиповаяОперацияПоУмолчанию(ИдентификаторДокумента, Знач Пользователь = Неопределено) Экспорт

	Если Пользователь = Неопределено Тогда
		Пользователь = Пользователи.ТекущийПользователь();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ТиповыеОперации.Ссылка КАК ТиповаяОперация,
		|	ЕСТЬNULL(ДанныеТиповыхОпераций.ИспользуетсяВнешняяПроцедура, ЛОЖЬ) КАК ИспользуетсяВнешняяПроцедура,
		|	ДанныеТиповыхОпераций.ИмяВнешнейПроцедуры
		|ИЗ
		|	Справочник.ТиповыеОперации КАК ТиповыеОперации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеТиповыхОпераций КАК ДанныеТиповыхОпераций
		|		ПО ТиповыеОперации.Ссылка = ДанныеТиповыхОпераций.ТиповаяОперация
		|ГДЕ
		|	(НЕ ИСТИНА В
		|					(ВЫБРАТЬ
		|						ИСТИНА
		|					ИЗ
		|						Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
		|					ГДЕ
		|						ТиповыеОперацииРазрешенныеПользователи.Ссылка = ТиповыеОперации.Ссылка)
		|			ИЛИ ИСТИНА В
		|				(ВЫБРАТЬ
		|					ИСТИНА
		|				ИЗ
		|					Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
		|				ГДЕ
		|					ТиповыеОперацииРазрешенныеПользователи.Ссылка = ТиповыеОперации.Ссылка
		|					И ТиповыеОперацииРазрешенныеПользователи.Пользователь = &ТекущийПользователь))
		|	И ТиповыеОперации.ИдентификаторДокумента = &ИдентификаторДокумента
		|	И ТиповыеОперации.НеИспользуется = ЛОЖЬ
		|	И ТиповыеОперации.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТиповыеОперацииПоУмолчанию.Пользователь,
		|	ТиповыеОперацииПоУмолчанию.ТиповаяОперация,
		|	1 КАК Порядок
		|ИЗ
		|	РегистрСведений.ТиповыеОперацииПоУмолчанию КАК ТиповыеОперацииПоУмолчанию
		|ГДЕ
		|	ТиповыеОперацииПоУмолчанию.ИдентификаторДокумента = &ИдентификаторДокумента
		|	И ТиповыеОперацииПоУмолчанию.Пользователь = &ТекущийПользователь
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТиповыеОперацииПоУмолчанию.Пользователь,
		|	ТиповыеОперацииПоУмолчанию.ТиповаяОперация,
		|	2
		|ИЗ
		|	РегистрСведений.ТиповыеОперацииПоУмолчанию КАК ТиповыеОперацииПоУмолчанию
		|ГДЕ
		|	ТиповыеОперацииПоУмолчанию.ИдентификаторДокумента = &ИдентификаторДокумента
		|	И ТиповыеОперацииПоУмолчанию.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";

	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);

	Запрос.УстановитьПараметр("ТекущийПользователь", Пользователь);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ТиповыеОперацииПользователя = РезультатЗапроса[0].Выгрузить();
	Если ТиповыеОперацииПользователя.Количество() = 1 Тогда
		Возврат ТиповыеОперацииПользователя[0].ТиповаяОперация;
	КонецЕсли;

	ТиповыеОперацииПоУмолчанию = РезультатЗапроса[1].Выбрать();
	Пока ТиповыеОперацииПоУмолчанию.Следующий() Цикл
		ТекСтрокаОперации = ТиповыеОперацииПользователя.Найти(ТиповыеОперацииПоУмолчанию.ТиповаяОперация, "ТиповаяОперация");
		Если ТекСтрокаОперации <> Неопределено Тогда
			Возврат ТекСтрокаОперации.ТиповаяОперация;
		КонецЕсли;
	КонецЦикла;

	Отбор = Новый Структура("ИспользуетсяВнешняяПроцедура, ИмяВнешнейПроцедуры", Истина, "ПереносДанных");
	ОперацииПереносДанных = ТиповыеОперацииПользователя.НайтиСтроки(Отбор);
	Если ОперацииПереносДанных.Количество() > 0 Тогда
		Для каждого ТекОперацияПереносДанных Из ОперацииПереносДанных Цикл
			ТиповыеОперацииПользователя.Удалить(ТекОперацияПереносДанных);
		КонецЦикла;
	КонецЕсли;

	Если ТиповыеОперацииПользователя.Количество() = 1 Тогда
		Возврат ТиповыеОперацииПользователя[0].ТиповаяОперация;
	КонецЕсли;

	Возврат Справочники.ТиповыеОперации.ПустаяСсылка();

Конецфункции

Функция РеквизитыТиповойОперацииПоУмолчанию(ИдентификаторДокумента,
		ТиповаяОперация, Знач Организация, Знач Пользователь = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ТиповаяОперация) Тогда
		Возврат Новый Структура;
	КонецЕсли;

	Если Пользователь = Неопределено Тогда
