// Устарела.  Следует использовать БухгалтерскиеОперацииКлиентСервер.УстановитьДоступностьЗависимыхРеквизитовФормы()
Процедура УстановитьДоступностьЗависимыхРеквизитовФормы(Форма, ПолеДляРеквизитов = Неопределено) Экспорт

	ВедущиеЭлементы = Новый Массив;

	Для каждого ОписаниеЗависимости Из Форма["БухгалтерскиеОперации_СписокЗависимыхЭлементов"] Цикл

		Если ВедущиеЭлементы.Найти(ОписаниеЗависимости.Значение.ВедущийРеквизит) = Неопределено Тогда

			РеквизитыФормы = Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"].НайтиСтроки(Новый Структура("ИмяРеквизита", ОписаниеЗависимости.Значение.ВедущийРеквизит));
			Если РеквизитыФормы.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;

			ВедущиеЭлементы.Добавить(Новый Структура("ИмяРеквизита, ИмяЭлемента", РеквизитыФормы[0].ИмяРеквизита, РеквизитыФормы[0].ИмяЭлемента));
		КонецЕсли;

	КонецЦикла;

	Для каждого ВедущийЭлемент Из ВедущиеЭлементы Цикл

		ИзменяемыеЭлементы = БухгалтерскиеОперацииКлиентСервер.ПолучитьСписокЗависимыхЭлементовФормы(Форма["БухгалтерскиеОперации_СписокЗависимыхЭлементов"], ВедущийЭлемент.ИмяРеквизита);

		Если ИзменяемыеЭлементы.Количество() > 0 Тогда

			СтруктураИменЭлементов = Новый Структура;
			Если СтрНачинаетсяС(ВедущийЭлемент.ИмяРеквизита, "Объект.") Тогда
				СтруктураИменЭлементов.Вставить("СчетОбъекта", СтрРазделить(ВедущийЭлемент.ИмяРеквизита, ".")[1]);
			Иначе
				СтруктураИменЭлементов.Вставить("СчетФормы", ВедущийЭлемент.ИмяРеквизита);
			КонецЕсли;
			Для каждого ТекЭлемент Из ИзменяемыеЭлементы Цикл

				СтруктураИменЭлементов.Вставить("Субконто"
					+ ТекЭлемент.НомерСубконто, ТекЭлемент.ИмяЭлемента);
				СтруктураИменЭлементов.Вставить("СубконтоФормы"
					+ ТекЭлемент.НомерСубконто, ТекЭлемент.ИмяЭлемента);

			КонецЦикла;

			ОбщегоНазначенияБГУКлиентСервер.УстановитьЗаголовкиСубконто(Форма, Форма.Объект, СтруктураИменЭлементов);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

