Процедура ЗарегистрироватьСнятыеСПоддержкиПоставляемыеОперацииВОбластяхДанных(ПоставляемаяТиповаяОперация) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ОбластиДанных.ОбластьДанныхВспомогательныеДанные КАК ОбластьДанныхВспомогательныеДанные
		|ИЗ
		|	РегистрСведений.ОбластиДанных КАК ОбластиДанных
		|ГДЕ
		|	ОбластиДанных.Статус В (Значение(Перечисление.СтатусыОбластейДанных.Новая), Значение(Перечисление.СтатусыОбластейДанных.Используется))";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Набор = РегистрыСведений.ОтключенныеОтПоддержкиПоставляемыеТиповыеОперации.СоздатьНаборЗаписей();
		Набор.Отбор.ОбластьДанныхВспомогательныеДанные.Установить(Выборка.ОбластьДанныхВспомогательныеДанные);
		Набор.Отбор.ПоставляемаяТиповаяОперация.Установить(ПоставляемаяТиповаяОперация);

		ЗаписьНабора = Набор.Добавить();
		ЗаписьНабора.ОбластьДанныхВспомогательныеДанные = Выборка.ОбластьДанныхВспомогательныеДанные;
		ЗаписьНабора.ПоставляемаяТиповаяОперация = ПоставляемаяТиповаяОперация;

		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(Набор);

	КонецЦикла;

КонецПроцедуры

Процедура ИзменитьЗначенияДопРеквизитовПередУстановкой(ИдентификаторДокумента,
		Объект, ТиповаяОперация, ДопРеквизиты,
		ЗаполнятьЗначенияПоУмолчанию = Истина) Экспорт

	Если ТипЗнч(ДопРеквизиты) <> Тип("Структура") Тогда
		ДопРеквизиты = Новый Структура;
	КонецЕсли;

	// 1. Проверить значения реквизитов по установленным отборам
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	РеквизитыТиповыхОпераций.ИмяДляФормулы КАК ИмяДляФормулы,
		|	РеквизитыТиповыхОпераций.ОтборЭлементов КАК ОтборЭлементов,
		|	ВЫБОР
		|		КОГДА РеквизитыТиповыхОпераций.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
		|			ТОГДА ЕСТЬNULL(ПоставляемыеРеквизитыТиповыхОпераций.СвязиПараметровВыбора, """")
		|		ИНАЧЕ ЕСТЬNULL(ДанныеРеквизитовТиповыхОпераций.СвязиПараметровВыбора, """")
		|	КОНЕЦ КАК СвязиПараметровВыбора,
		|	ВЫБОР
		|		КОГДА РеквизитыТиповыхОпераций.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
		|			ТОГДА ЕСТЬNULL(ПоставляемыеРеквизитыТиповыхОпераций.ЗапретитьИзменение, ЛОЖЬ)
		|		ИНАЧЕ ЕСТЬNULL(ДанныеРеквизитовТиповыхОпераций.ЗапретитьИзменение, ЛОЖЬ)
		|	КОНЕЦ КАК ЗапретитьИзменение,
		|	РеквизитыТиповыхОпераций.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
		|	ВЫБОР
		|		КОГДА РеквизитыТиповыхОпераций.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
		|			ТОГДА ПоставляемыеРеквизитыТиповыхОпераций.УпакованныеНастройки
		|		ИНАЧЕ ДанныеРеквизитовТиповыхОпераций.УпакованныеНастройки
		|	КОНЕЦ КАК УпакованныеНастройки
		|ИЗ
		|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПоставляемыеРеквизитыТиповыхОпераций КАК ПоставляемыеРеквизитыТиповыхОпераций
		|		ПО РеквизитыТиповыхОпераций.ПоставляемыйРеквизитТиповойОперации = ПоставляемыеРеквизитыТиповыхОпераций.Ссылка
		|			И РеквизитыТиповыхОпераций.Владелец.ПоставляемаяТиповаяОперация = ПоставляемыеРеквизитыТиповыхОпераций.Владелец
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеРеквизитовТиповыхОпераций КАК ДанныеРеквизитовТиповыхОпераций
		|		ПО РеквизитыТиповыхОпераций.Ссылка = ДанныеРеквизитовТиповыхОпераций.РеквизитТиповойОперации
		|ГДЕ
		|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
		|	И РеквизитыТиповыхОпераций.ЭтоГруппа = ЛОЖЬ
		|	И РеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ЗначениеРеквизитаОперации = Неопределено;

		Если НЕ ДопРеквизиты.Свойство(Выборка.ИмяДляФормулы, ЗначениеРеквизитаОперации)
				ИЛИ НЕ ЗначениеЗаполнено(ЗначениеРеквизитаОперации) Тогда
			Продолжить;
		КонецЕсли;

		ПараметрыДанныхВыбора = Новый Структура("Отбор", Новый Структура);
		ЗаполнитьПараметрыДанныхВыбора(Объект, ПараметрыДанныхВыбора, Выборка.ОтборЭлементов, Выборка.СвязиПараметровВыбора);
		Если ПараметрыДанныхВыбора.Количество() > 1
				ИЛИ ПараметрыДанныхВыбора.Отбор.Количество() > 0 Тогда
				// Если задан отбор, связи параметров выбора или предустановленный отбор, то проверяем
			// соответствует ли ранее выбранное значение новым отборам
			Если НЕ ВыбранноеЗначениеСоответствуетОтбору(ЗначениеРеквизитаОперации, ПараметрыДанныхВыбора) Тогда
				ДопРеквизиты.Удалить(Выборка.ИмяДляФормулы);
			КонецЕсли;

		ИначеЕсли ЗначениеЗаполнено(Выборка.ЗначениеПоУмолчанию) Тогда
		// Если отбор не задан, но реквизит со свойством ТолькоЧтение и заполненным значением по-умолчанию,
			// то проверяем на равенство значению по-умолчанию.
			ТолькоЧтение = Неопределено;
			Если ТипЗнч(Выборка.УпакованныеНастройки) = Тип("ХранилищеЗначения") Тогда
				УпакованныеНастройки = Выборка.УпакованныеНастройки.Получить();
				Если ТипЗнч(УпакованныеНастройки) = Тип("Структура") Тогда
					УпакованныеНастройки.Свойство("ТолькоЧтение", ТолькоЧтение);
				КонецЕсли;
			КонецЕсли;

			Если ТипЗнч(ТолькоЧтение) <> Тип("Булево") Тогда
				ТолькоЧтение = Выборка.ЗапретитьИзменение = Истина;
			КонецЕсли;

			Если ТолькоЧтение
					И ЗначениеРеквизитаОперации <> Выборка.ЗначениеПоУмолчанию Тогда
				ДопРеквизиты.Удалить(Выборка.ИмяДляФормулы);
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	// 2. Дополнить значения реквизитов значениями по умолчанию
	Если Не ЗаполнятьЗначенияПоУмолчанию Тогда
		Возврат;
	КонецЕсли;

	ЗначенияДопРеквизитовПоУмолчанию = РеквизитыТиповойОперацииПоУмолчанию(ИдентификаторДокумента, ТиповаяОперация, Объект.Организация);

	Для каждого ТекЗначениеПоУмолчанию Из ЗначенияДопРеквизитовПоУмолчанию Цикл
		ЗначениеРеквизитаОперации = Неопределено;
		ЗначениеУжеЗадано = ДопРеквизиты.Свойство(ТекЗначениеПоУмолчанию.Ключ, ЗначениеРеквизитаОперации)
			И ЗначениеЗаполнено(ЗначениеРеквизитаОперации);

		Если НЕ ЗначениеУжеЗадано
				ИЛИ ТипЗнч(ЗначениеРеквизитаОперации) = Тип("Булево") Тогда

			ДопРеквизиты.Вставить(ТекЗначениеПоУмолчанию.Ключ, ТекЗначениеПоУмолчанию.Значение);

		КонецЕсли;

	КонецЦикла;

	УстановитьАктуальныеСчетаВСтруктуре(ДопРеквизиты, Объект.Дата, Объект.Организация);

КонецПроцедуры

Процедура УстановитьАктуальныеСчетаВСтруктуре(ЗначенияРеквизитов, Знач Дата,
		Организация) Экспорт

	Если Не ЗначениеЗаполнено(Дата) Тогда

		ЗначенияНастроек = Новый Структура("РабочаяДата");
		ЗаполнениеРеквизитовОбъектов.ПолучитьЗначенияНастроекПользователя(Пользователи.АвторизованныйПользователь(), ЗначенияНастроек);

		Если ЗначениеЗаполнено(ЗначенияНастроек.РабочаяДата) Тогда
			Дата = ЗначенияНастроек.РабочаяДата;
		Иначе
			Дата = ТекущаяДатаСеанса();
		Конецесли;

	КонецЕсли;

	ЗаменяемыеСчета = Новый ТаблицаЗначений;
	ЗаменяемыеСчета.Колонки.Добавить("ИмяДляФормулы", Новый ОписаниеТипов("Строка"));
	ЗаменяемыеСчета.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка"));
	ЗаменяемыеСчета.Колонки.Добавить("ИсходноеЗначение", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ЗаменяемыеСчета.Колонки.Добавить("НовоеЗначение", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));

	Для каждого ТекЗначение Из ЗначенияРеквизитов Цикл

		Если ТипЗнч(ТекЗначение.Значение) = Тип("ПланСчетовСсылка.ЕПСБУ")
				И ЗначениеЗаполнено(ТекЗначение.Значение) Тогда

			СтрокаЗамены = ЗаменяемыеСчета.Добавить();
			СтрокаЗамены.ИмяДляФормулы = ТекЗначение.Ключ;
			СтрокаЗамены.ИсходноеЗначение = ТекЗначение.Значение;

		КонецЕсли;

	КонецЦикла;

	Если ЗаменяемыеСчета.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СрокиДействияСчетов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ЗаменяемыеСчета.ВыгрузитьКолонку("ИсходноеЗначение"), "Код, ДатаНачалаДействия, ДатаОкончанияДействия, ЭлементГруппа");

	КодыСчетов = Новый Массив;
	ИспользуемыйСчет27 = СчетЭлемент27();
	ДатаНачала2021 = '20210101';

	Для каждого СтрокаПроверки Из ЗаменяемыеСчета Цикл

		ДанныеСчета = СрокиДействияСчетов.Получить(СтрокаПроверки.ИсходноеЗначение);
		СтрокаПроверки.КодСчета = ДанныеСчета.Код;
		
		Если ДанныеСчета.Код = "27" Тогда
			
			Если Дата >= ДатаНачала2021 Тогда
				// Используется новый счет 27.02
				СтрокаПроверки.НовоеЗначение = БухгалтерскийУчет.СчетПоКоду("27.02", Дата);
			ИначеЕсли ДанныеСчета.ЭлементГруппа Тогда
				СтрокаПроверки.НовоеЗначение = ИспользуемыйСчет27;
			Иначе
				СтрокаПроверки.НовоеЗначение = СтрокаПроверки.ИсходноеЗначение;
			КонецЕсли;
			
		ИначеЕсли ДанныеСчета.Код = "27.02" Тогда
			
			Если Дата < ДатаНачала2021 Тогда
				// Используетя старый счет 27
				СтрокаПроверки.НовоеЗначение = ИспользуемыйСчет27;
			Иначе
				СтрокаПроверки.НовоеЗначение = СтрокаПроверки.ИсходноеЗначение;
			КонецЕсли;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеСчета.ДатаНачалаДействия)
				И НЕ ЗначениеЗаполнено(ДанныеСчета.ДатаОкончанияДействия) Тогда
			
			СтрокаПроверки.НовоеЗначение = СтрокаПроверки.ИсходноеЗначение;
			
		Иначе
			
			КодыСчетов.Добавить(СтрокаПроверки.КодСчета);
		КонецЕсли;

		

	КонецЦикла;

	ИспользуемыеСчета = БухгалтерскийУчет.СписокСчетов(КодыСчетов, Дата, Истина, Организация);
	ДанныеСчетов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ИспользуемыеСчета, "Код");
	ДанныеПоКоду = Новый Соответствие;
	Для каждого ТекДанные Из ДанныеСчетов Цикл

		ДанныеПоКоду.Вставить(ТекДанные.Значение.Код, ТекДанные.Ключ);

	КонецЦикла;

	Для каждого ТекЗначение Из ЗаменяемыеСчета Цикл

		Если Не ЗначениеЗаполнено(ТекЗначение.НовоеЗначение) Тогда

			ТекЗначение.НовоеЗначение = ДанныеПоКоду.Получить(ТекЗначение.КодСчета);

		КонецЕсли;

		Если ТекЗначение.ИсходноеЗначение <> ТекЗначение.НовоеЗначение Тогда

			ЗначенияРеквизитов.Вставить(ТекЗначение.ИмяДляФормулы, ТекЗначение.НовоеЗначение);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ВыбранноеЗначениеСоответствуетОтбору(ЗначениеРеквизитаОперации,
		ПараметрыДанныхВыбора)

		// Если задан отбор, связи параметров выбора или предустановленный отбор, то проверяем
	// соответствует ли ранее выбранное значение новым отборам
	Если ПараметрыДанныхВыбора.Свойство("ПредустановленныйОтбор") Тогда
		НастройкаКомпоновщика = ОбщегоНазначения.ЗначениеИзСтрокиXML(ПараметрыДанныхВыбора.ПредустановленныйОтбор);
	Иначе
		КомпоновщикНастроекКомпоновкиДанных = Новый КомпоновщикНастроекКомпоновкиДанных;
		НастройкаКомпоновщика = КомпоновщикНастроекКомпоновкиДанных.Настройки;
	КонецЕсли;
	// Добавим в отбор равенство выбранному значению для сокращения списка
	// Если выбранный элемент соответствует отбору, то будет получен только он,
	// иначе список будет пустой.
	ОтборСсылка = НастройкаКомпоновщика.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСсылка.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	ОтборСсылка.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборСсылка.ПравоеЗначение = ЗначениеРеквизитаОперации;
	ОтборСсылка.Использование = Истина;
	ПараметрыДанныхВыбора.Вставить("ПредустановленныйОтбор", ОбщегоНазначения.ЗначениеВСтрокуXML(НастройкаКомпоновщика));

	ТипЗначенияРеквизита = ТипЗнч(ЗначениеРеквизитаОперации);
	Если ТипЗначенияРеквизита = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
	// Для плана счетов особая проверка
		ТаблицаСчетов = ПланыСчетов.ЕПСБУ.ОбработкаПолученияДанныхВыбораСчетаЕПСБУ(ПараметрыДанныхВыбора);
		Возврат ТаблицаСчетов.Найти(ЗначениеРеквизитаОперации, "Ссылка") <> Неопределено;
	Иначе
	// Получим список подходящих значений
		ДанныеВыбора = ПолучитьДанныеВыбора(ТипЗнч(ЗначениеРеквизитаОперации), ПараметрыДанныхВыбора);
		Возврат ДанныеВыбора.НайтиПоЗначению(ЗначениеРеквизитаОперации) <> Неопределено;
	КонецЕсли;

КонецФункции

Функция ТиповаяОперацияПоДокументуОснованию(Основание, Объект)
	
	Возврат Справочники.ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании.ПравилаЗаполнения(Основание, Объект);
	
КонецФункции

Функция ПолучитьЗначенияСохраненныхДопКолонок(ОбъектФормы)

	Идентификатор = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ОбъектФормы.Ссылка));

	УстановитьПривилегированныйРежим(Истина);
	ЗначенияДопКолонок = Справочники.ДополнительныеТабличныеЧастиДокументов.ДанныеДополнительныхТабличныхЧастей(Идентификатор, ОбъектФормы.Ссылка);
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ЗначенияДопКолонок;

КонецФункции

// Устанавливает типовую операцию и значения дополнительных реквизитов операции в реквизиты формы.
// Также заполняются реквизиты механизма Исправления ошибок.
//
// Параметры:
//  Форма					 - ФормаКлиентскогоПриложения - форма документа:
//   * БухгалтерскиеОперации_ДобавленныеРеквизитыОперации - ТаблицаЗначений
//  ТиповаяОперация			 - СправочникСсылка.ТиповыеОперации - типовая операция документа
//  ЗначенияДопРеквизитов	 - Структура - значения дополнительных реквизитов.Ключ = ИмяДляФормулы.
//  ЗначенияДопКолонок		 - Неопределено - не используется. Оставлено для обратной совместимости.
//
Процедура ЗаполнитьДополнительныеРеквизитыВФорме(Форма, ТиповаяОперация,
		ЗначенияДопРеквизитов, ЗначенияДопКолонок = Неопределено) Экспорт
	Перем ЗначениеДопРеквизита;

	ИмяРеквизитаТиповаяОперация = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитыФормыТиповаяОперацияФактическое(Форма);
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизитаТиповаяОперация) Тогда
		Форма[ИмяРеквизитаТиповаяОперация] = ТиповаяОперация;
	КонецЕсли;

	ДобавленныеРеквизитыОперации = Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"];

	ИменаТЧ = ОбщегоНазначенияКлиентСервер.СвернутьМассив(
		ДобавленныеРеквизитыОперации.Выгрузить(, "ИмяТаблицы").ВыгрузитьКолонку("ИмяТаблицы"));
	ИмяРеквизитаБухгалтер = ВРег(БухгалтерскиеОперацииКлиентСервер.ИмяДляФормулыРеквизитаОтветственныйИсполнитель());
	СохраненныйБухгалтер = Справочники.Сотрудники.ПустаяСсылка();
	ИмяРеквизитаФормыБухгалтер = "";

	Для каждого ИмяТЧ Из ИменаТЧ Цикл

		РеквизитыТЧ = ДобавленныеРеквизитыОперации.НайтиСтроки(Новый Структура("ИмяТаблицы, ЭтоГруппа", ИмяТЧ, Ложь));

		Если ПустаяСтрока(ИмяТЧ) Тогда

			Для каждого РеквизитТиповойОперации Из РеквизитыТЧ Цикл

				Если РеквизитТиповойОперации.ИмяДляФормулы = "ТиповаяОперация" Тогда

					Продолжить;
				КонецЕсли;
				
				Если РеквизитТиповойОперации.ИмяДляФормулы = ИмяРеквизитаБухгалтер Тогда
					ЗначенияДопРеквизитов.Свойство("ОтветственныйИсполнитель", СохраненныйБухгалтер);
					ИмяРеквизитаФормыБухгалтер = РеквизитТиповойОперации.ИмяРеквизита;
				ИначеЕсли (РеквизитТиповойОперации.ИмяДляФормулы = "Курс"
						ИЛИ РеквизитТиповойОперации.ИмяДляФормулы = "Кратность") Тогда

					Если ЗначенияДопРеквизитов.Свойство(РеквизитТиповойОперации.ИмяДляФормулы, ЗначениеДопРеквизита) Тогда
						Форма[РеквизитТиповойОперации.ИмяРеквизита] = ЗначениеДопРеквизита;
					КонецЕсли;

				ИначеЕсли ЗначениеЗаполнено(РеквизитТиповойОперации.ИмяРеквизита)
						И ЗначениеЗаполнено(РеквизитТиповойОперации.ИмяДляФормулы) Тогда

					ЗначенияДопРеквизитов.Свойство(РеквизитТиповойОперации.ИмяДляФормулы, ЗначениеДопРеквизита);
					Форма[РеквизитТиповойОперации.ИмяРеквизита] = ЗначениеДопРеквизита;

				КонецЕсли;

			КонецЦикла;
		КонецЕсли;

	КонецЦикла;
	
	Если ЗначениеЗаполнено(ИмяРеквизитаФормыБухгалтер) Тогда
		Форма[ИмяРеквизитаФормыБухгалтер] = СохраненныйБухгалтер;
	КонецЕсли;
	
	ИмяРеквизитаИсправлениеОшибок = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаФлажокИсправлениеОшибокПрошлыхЛет();
	ЕстьРеквизитИсправлениеОшибок = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизитаИсправлениеОшибок);
	
	Если ЕстьРеквизитИсправлениеОшибок Тогда
		ПорядокИсправленияОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЗначенияДопРеквизитов,
			"ИсправлениеОшибки", Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка);
		ВыявительОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЗначенияДопРеквизитов,
			"ВыявительОшибки", Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка());
		ПричинаОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЗначенияДопРеквизитов,
			"ПричинаОшибки", Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка());
		ЭтоИсправлениеОшибки = ПорядокИсправленияОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода
			               ИЛИ ПорядокИсправленияОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода;
		Форма[ИмяРеквизитаИсправлениеОшибок] = ЭтоИсправлениеОшибки;
		Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательИсправлениеОшибокПрошлыхЛет()] = ПорядокИсправленияОшибки;
		Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательВыявительОшибкиПрошлыхЛет()]   = ВыявительОшибки;
		Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательПричинаОшибкиПрошлыхЛет()]   = ПричинаОшибки;
	КонецЕсли;

КонецПроцедуры

Функция ТаблицаЗначенийИзМассива(МассивСтруктур)

	Таблица = Новый ТаблицаЗначений;

	Если МассивСтруктур.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;

	Для каждого КолонкиСтроки Из МассивСтруктур[0] Цикл

		Таблица.Колонки.Добавить(КолонкиСтроки.Ключ);

	КонецЦикла;

	Для каждого ЗначениеСтроки Из МассивСтруктур Цикл

		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), ЗначениеСтроки);

	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Устанавливает в форме свойство ТолькоПросмотр = Истина, если есть конфликты имен дополнительных колонок.
// Если в фороме подключена процедура БухгалтерскиеОперацииКлиент.ПриОткрытии, то
// будет выведено предупреждение с описанием причин запрета редактирования.
Процедура УстановитьТолькоПросмотрСКонфликтомИмен(Форма)

	Если Форма.СписокЭлементовСКонфликтамиИмен.Количество() > 0 Тогда
		Форма.ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ПриОбработкеПолученияДанныхВыбораКОСГУ(ДанныеВыбора, Параметры,
		СтандартнаяОбработка) Экспорт
	Перем СтрокаПоиска;
	Перем ПредустановленныйОтбор;

	Если НЕ Параметры.Свойство("ПредустановленныйОтбор", ПредустановленныйОтбор)
			ИЛИ НЕ ЗначениеЗаполнено(ПредустановленныйОтбор) Тогда

		Возврат;
	КонецЕсли;

	Параметры.Вставить("ТекстЗапросаОтбора", "ВЫБРАТЬ
		|	КОСГУ.Ссылка,
		|	КОСГУ.ВерсияДанных,
		|	КОСГУ.ПометкаУдаления,
		|	КОСГУ.Родитель,
		|	КОСГУ.Код,
		|	КОСГУ.НаименованиеПолное,
		|	КОСГУ.Предопределенный,
		|	КОСГУ.ИмяПредопределенныхДанных
		|ИЗ
		|	Справочник.КОСГУ КАК КОСГУ");
	Если Параметры.Свойство("СтрокаПоиска", СтрокаПоиска)
			И ЗначениеЗаполнено(СтрокаПоиска) Тогда
		НастройкаКомпоновки = ОбщегоНазначения.ЗначениеИзСтрокиXML(ПредустановленныйОтбор);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(НастройкаКомпоновки.Отбор, "Код", СтрокаПоиска, ВидСравненияКомпоновкиДанных.Содержит, , Истина);
		Параметры.Вставить("ПредустановленныйОтбор", ОбщегоНазначения.ЗначениеВСтрокуXML(НастройкаКомпоновки));
	КонецЕсли;
	УстановитьОтборБыстрогоВыбораИзНастроекКомпоновки(ДанныеВыбора, Параметры, СтандартнаяОбработка);

КонецПроцедуры

// Процедура добавляет сообщение об ошибке в таблицу "ТаблицаОшибок" контекста проведения документа.
// Контекст может быть передан при вызове, если он не был передан, то он будет получен из временного
// хранилища и, после добавления ошибки, снова помещен во временное хранилище.
//
// Параметры:
//  ТекстОшибки			 - Строка - Текст ошибки,
//  ИмяПоляОшибки		 - Строка - имя поля, к которому относится ошибка,
//  Отказ				 - Булево - при выполнении всегда устанавливается = "Истина",
//  КонтекстПроведения	 - Структура - ранее полученный контекст проведения,
//						- Неопределено - будет получен сохраненный контекст.
Процедура ДобавитьСообщениеОбОшибке(ТекстОшибки, ИмяПоляОшибки = "",
		Отказ = Ложь, Знач КонтекстПроведения = Неопределено) Экспорт

	ПереданКонтекст = ЗначениеЗаполнено(КонтекстПроведения);
	Если Не ПереданКонтекст Тогда
		КонтекстПроведения = ПолучитьКонтекстЗаполненияОперации();
	КонецЕсли;
	Если КонтекстПроведения = Неопределено
			ИЛИ КонтекстПроведения.ТаблицаОшибок = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , ИмяПоляОшибки);
	Иначе
		ТаблицаОшибок = КонтекстПроведения.ТаблицаОшибок;
		Если ТаблицаОшибок.Найти(ИмяПоляОшибки, "ИмяПоля") = Неопределено Тогда
			НоваяОшибка = КонтекстПроведения.ТаблицаОшибок.Добавить();
			НоваяОшибка.ИмяПоля = ИмяПоляОшибки;
			НоваяОшибка.ТекстСообщения = ТекстОшибки;
		КонецЕсли;
	КонецЕсли;
	Если Не ПереданКонтекст Тогда
		СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	КонецЕсли;

	Отказ = Истина;

КонецПроцедуры

// Возвращает Истина, если для данной типовой операции нужно вести оценку производительности.
// При этом в параметр КлючеваяОперация возвращается соответствующая Ключевая операция
//
//	Параметры:
//	ТиповаяОперация - СправочникСсылка.ТиповыеОперации
//	КлючеваяОперация - Произвольный - в этот параметр присваивается ключевая операция - СправочникСсылка.КлючевыеОперации
//	Возвращаемое значение:
//	Булево
//
Функция ПоТиповойОперацииВедетсяОценкаПроизводительности(ТиповаяОперация,
		Условие, КлючеваяОперация = Неопределено) Экспорт
	Результат = Ложь;

	МассивПроверяемыхФункций = Новый Массив;
	МассивПроверяемыхФункций.Добавить("БухгалтерскиеОперации.КоличествоМЗвПутиДостаточноДляСписания");
	МассивПроверяемыхФункций.Добавить("БухгалтерскиеОперации.КоличествоНоменклатурыДостаточноДляСписания");
	МассивПроверяемыхФункций.Добавить("БухгалтерскиеОперации.КоличествоОСвПутиДостаточноДляСписания");
	МассивПроверяемыхФункций.Добавить("БухгалтерскиеОперации.КоличествоОСДостаточноДляСписания");
	МассивПроверяемыхФункций.Добавить("БухгалтерскиеОперации.МожноПровестиСписаниеОСВОперУчете");
	МассивПроверяемыхФункций.Добавить("БухгалтерскиеОперации.МожноПровестиСписаниеОСЗабаланс");
	МассивПроверяемыхФункций.Добавить("БухгалтерскиеОперации.ПодготовитсяКСписаниюОСБаланс");
	МассивПроверяемыхФункций.Добавить("БухгалтерскиеОперации.РассчитатьСтоимостьВложенияВНФА");

	МассивФункцийМЗ = Новый Массив;
	МассивФункцийМЗ.Добавить("БухгалтерскиеОперации.КоличествоМЗвПутиДостаточноДляСписания");

	Если ТиповаяОперация = Справочники.ТиповыеОперации.ЗакрытиеПроизводственныхСчетов_ЗакрытиеПроизводственныхСчетов Тогда
		Результат = Истина;
		КлючеваяОперация = "ФормированиеПроводокЗакрытиеСчетов";
	ИначеЕсли НЕ ПустаяСтрока(Условие) Тогда
		Для Каждого ТекФункция Из МассивПроверяемыхФункций Цикл
			Если Найти(Условие, ТекФункция) <> 0 Тогда
				Результат = Истина;
				Если МассивФункцийМЗ.Найти(ТекФункция) <> Неопределено Тогда
					КлючеваяОперация = "ФормированиеПроводокРасчетСебестоимостиМЗ";
				Иначе
					КлючеваяОперация = "ФормированиеПроводокРасчетСебестоимостиОС";
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Заполняет данные выбора в соответствии с отбором из настройки типовой операции. В параметр ДополнительныйОтбор можно
// передать массив элементов, который будет добавлен в отбор в виде условия (И Ссылка В Списке (ДополнительныйОтбор)).
// Сам отбор компоновки данных передается в параметре формы "ПредустановленныйОтбор" в сериализованном виде.
// 
// Параметры
//	ДанныеВыбора - Неопределено - в случае получения необходимого отбора или передачи в процедуру массива элементов 
// 				    			  в параметре ДополнительныйОтбор, в параметр помещается список элементов выбора. При этом
//								  параметр СтандартнаяОбработка будет установлен в Ложь.
//	Параметры - Структура - параметры формы.
//	СтандартнаяОбработка - Булево - признак стандартной обработки.
// 	ДополнительныйОтбор - Массив - массив элементов, который добавляется к условию выборки.
//	
Процедура УстановитьОтборБыстрогоВыбораИзНастроекКомпоновки(ДанныеВыбора,
		Параметры, СтандартнаяОбработка, ДополнительныйОтбор = Неопределено,
		НеСортировать = Ложь) Экспорт

	Если Параметры.Свойство("ПредустановленныйОтбор")
			И Параметры.Свойство("ТекстЗапросаОтбора") Тогда
			// передан отбор из настойки типовой операции
		Настройки = Параметры.ПредустановленныйОтбор;

		Если ТипЗнч(Настройки) = Тип("Строка") Тогда
			НастройкиКомпоновки = ОбщегоНазначения.ЗначениеИзСтрокиXML(Настройки);

			Если ТипЗнч(ДополнительныйОтбор) = Тип("Массив") Тогда
				ЭлементОтбора = НастройкиКомпоновки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
				ЭлементОтбора.ПравоеЗначение = ДополнительныйОтбор;
				ЭлементОтбора.Использование = Истина;
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;

		СхемаКомпоновки = Новый СхемаКомпоновкиДанных;

		ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
		ИсточникДанных.ТипИсточникаДанных = "Local";
		ИсточникДанных.Имя = "ЭтаИБ";

		НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
		НаборДанных.ИсточникДанных = ИсточникДанных.Имя;
		НаборДанных.Имя = "РеквизитыДокумента";
		НаборДанных.Запрос = Параметры.ТекстЗапросаОтбора;

		Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Поле.Поле = "Ссылка";
		Поле.ПутьКДанным = "Ссылка";

		Поле = НастройкиКомпоновки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
		Поле.Использование = Истина;

		Группировка = НастройкиКомпоновки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		Группировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));

		Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
		Компоновщик.ЗагрузитьНастройки(НастройкиКомпоновки);

		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, Компоновщик.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		МассивОтобранныхЭлементов = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных).ВыгрузитьКолонку("Ссылка");

		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.ЗагрузитьЗначения(МассивОтобранныхЭлементов);
		СтандартнаяОбработка = Ложь;
	ИначеЕсли ТипЗнч(ДополнительныйОтбор) = Тип("Массив") Тогда
	// передан массив элементов
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.ЗагрузитьЗначения(ДополнительныйОтбор);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;

	Если ТипЗнч(ДанныеВыбора) = Тип("СписокЗначений") И НЕ НеСортировать Тогда
		ДанныеВыбора.СортироватьПоЗначению();
	КонецЕсли;

КонецПроцедуры

// Функция определяет наличие проведенного документа "Сторно", сторнирующего текущий документа "Ссылка".
// В параметр СсылкаНаСторно передается ссылка на документ сторно.
//
Функция ДокументСторнирован(Ссылка, СсылкаНаСторно = Неопределено) Экспорт

	Если Ссылка.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Сторно.Ссылка
		|ИЗ
		|	Документ.Сторно КАК Сторно
		|ГДЕ
		|	Сторно.Проведен
		|	И Сторно.ДокументОснование = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;

	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	СсылкаНаСторно = Выборка.Ссылка;
	Возврат Истина;

КонецФункции

// Заполняет колонки "ВидСубконтоХХХ" таблицы проводок.
// ВидСубконтоДт1, ВидСубконтоДт2 и т.д.
//
Процедура ПроверитьЗаполнениеВидовСубконтоТаблицыПроводок(ТаблицаПроводок) Экспорт
	ДополнитьКолонкиТаблицыПроводок(ТаблицаПроводок);

	Для каждого ТекПроводка Из ТаблицаПроводок Цикл

		Если ЗначениеЗаполнено(ТекПроводка.СчетДт) Тогда

			Счетчик = 0;
			Для каждого ТекВидСубконто Из ТекПроводка.СчетДт.ВидыСубконто Цикл
				Счетчик = Счетчик + 1;
				Если Не ЗначениеЗаполнено(ТекПроводка["ВидСубконтоДт" + Счетчик]) Тогда
					ТекПроводка["ВидСубконтоДт" + Счетчик] = ТекВидСубконто.ВидСубконто;
				КонецЕсли;
			КонецЦикла;

		КонецЕсли;

		Если ЗначениеЗаполнено(ТекПроводка.СчетКт) Тогда

			Счетчик = 0;
			Для каждого ТекВидСубконто Из ТекПроводка.СчетКт.ВидыСубконто Цикл
				Счетчик = Счетчик + 1;
				Если Не ЗначениеЗаполнено(ТекПроводка["ВидСубконтоКт" + Счетчик]) Тогда
					ТекПроводка["ВидСубконтоКт" + Счетчик] = ТекВидСубконто.ВидСубконто;
				КонецЕсли;
			КонецЦикла;

		КонецЕсли;

	КонецЦикла;
КонецПроцедуры

// Рассчитывает реквизиты операции: Дата, Организация, Условие, ТекстСообщенияПриОшибке.
// Если в параметр ТребуемыеДанные передается структура, содержащая только часть из перечисленых реквизитов, то будут
// рассчитываться не все данные, а только перечисленные в структуре.
// Если ТребуемыеДанные = Неопределено, то будут вычислены все поля. Результат будет помещен в структуру в этот параметр.
// 
// Параметры:
//	ТиповаяОперация - СправочникСсылка.ТиповыеОперации
//	ИсточникДанных - см. СоздатьИсточникДанныхИзШапкиОбъекта
//	ТребуемыеДанные - Структура, Неопределено - в структуре должны быть заданы 
//
Процедура РассчитатьРеквизитыОперации(ТиповаяОперация, ИсточникДанных,
		ТребуемыеДанные) Экспорт

	Если ТипЗнч(ТребуемыеДанные) <> Тип("Структура") Тогда
		ТребуемыеДанные = Новый Структура("Дата, Организация, УсловиеФормирования");
		ТребуемыеДанные.Вставить("ТекстСообщенияПриОшибке", "");
	КонецЕсли;

	ДанныеТиповойОперации = Справочники.ТиповыеОперации.ДанныеТиповойОперации(ТиповаяОперация,
		"СхемаПроверкиУсловия, ТекстСообщенияПриОшибке");

	Если ДанныеТиповойОперации.СхемаПроверкиУсловия = Неопределено Тогда
		ТребуемыеДанные.Вставить("ТекстСообщенияПриОшибке", НСтр("ru = 'Не задана схема проверки условия.
			|Проверьте корректность заданной формулы проверки условия типовой операции.'"));
		Возврат;
	КонецЕсли;

	СхемаПроверкиУсловия = ДанныеТиповойОперации.СхемаПроверкиУсловия.Получить();
	Если ТипЗнч(СхемаПроверкиУсловия) <> Тип("СхемаКомпоновкиДанных") Тогда
		ЗаписьЖурналаРегистрации(
			СобытиеЖурналаРегистрацииВычислениеУсловия(),
			УровеньЖурналаРегистрации.Ошибка,
			ТиповаяОперация.Метаданные(),
			ТиповаяОперация,
			НСтр("ru='В типовой операции отстутствует схема вычисления условия'", ОбщегоНазначения.КодОсновногоЯзыка()));
		ТекстСообщения = НСтр("ru='Для формирования проводок выбранная типовая операция должна быть переформирована.
			|Откройте Типовую операцию и нажмите кнопку Записать'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ВызватьИсключение "Отсутствует схема заполнения даты и организации для операции";
	КонецЕсли;

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	НастройкиСхемы = Новый КомпоновщикНастроекКомпоновкиДанных;

	НастройкиСхемы.ЗагрузитьНастройки(СхемаПроверкиУсловия.НастройкиПоУмолчанию);
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаПроверкиУсловия);
	НастройкиСхемы.Инициализировать(ИсточникНастроек);

	Если ТипЗнч(ТребуемыеДанные) = Тип("Структура") Тогда
		Для каждого ТекЭлементВыбора Из НастройкиСхемы.Настройки.Выбор.Элементы Цикл

			Если Не ТребуемыеДанные.Свойство(Строка(ТекЭлементВыбора.Поле)) Тогда
				ТекЭлементВыбора.Использование = Ложь;
			КонецЕсли;

		КонецЦикла;
	КонецЕсли;

	ПолеОшибки = СхемаПроверкиУсловия.ВычисляемыеПоля.Найти("ТекстСообщенияПриОшибке");
	Если ПустаяСтрока(ДанныеТиповойОперации.ТекстСообщенияПриОшибке) Тогда
		ПолеОшибки.Выражение = """Не выполнено условие формирования операции!""";
	Иначе
		ПолеОшибки.Выражение = """"
			+ СтрЗаменить(ДанныеТиповойОперации.ТекстСообщенияПриОшибке, """", """""")
			+ """";
	КонецЕсли;
	
	ДобавитьФактическуюДатуПроведенияВФормулуДата(ИсточникДанных, СхемаПроверкиУсловия);

	Попытка
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаПроверкиУсловия, НастройкиСхемы.Настройки, , ,
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Исключение
		ТребуемыеДанные.Вставить("ТекстСообщенияПриОшибке",
			НСтр("ru = 'Ошибка вычисления условия формирования операции.
				|Проверьте корректность заданной формулы проверки условия типовой операции.'"));
		ВызватьИсключение НСтр("ru = 'Ошибка вычисления условия формирования операции'");
	КонецПопытки;

	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ИсточникДанных, , Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	Попытка

		ТаблицаРезультатУсловия = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);

		Если ТаблицаРезультатУсловия.Количество() = 0 Тогда
			ЗаписьЖурналаРегистрации(
				СобытиеЖурналаРегистрацииВычислениеУсловия(),
				УровеньЖурналаРегистрации.Ошибка,
				ТиповаяОперация.Метаданные(),
				ТиповаяОперация,
				НСтр("ru='В результирующей таблице 0 записей'", ОбщегоНазначения.КодОсновногоЯзыка()));
			ТекстСообщения = НСтр("ru='Ошибка инициализации типовой операции. Подробности в журнале регистрации.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			ВызватьИсключение "ТаблицаРезультатУсловия.Количество() = 0";
		Иначе
			ЗаполнитьЗначенияСвойств(ТребуемыеДанные, ТаблицаРезультатУсловия[0]);
		КонецЕсли;

	Исключение
		ЗаписьЖурналаРегистрации(
			СобытиеЖурналаРегистрацииВычислениеУсловия(),
			УровеньЖурналаРегистрации.Ошибка,
			ТиповаяОперация.Метаданные(),
			ТиповаяОперация,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстСообщения = НСтр("ru='Ошибка инициализации типовой операции. Подробности в журнале регистрации.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецПопытки;

КонецПроцедуры

Процедура ДобавитьФактическуюДатуПроведенияВФормулуДата(ИсточникДанных, СхемаПроверкиУсловия)
	Если Не ПрименяетсяОтдельнаяДатаПроведенияДокументаИзРегистра(ТипЗнч(ИсточникДанных.ШапкаДокумента[0].Ссылка)) Тогда
		Возврат;
	КонецЕсли;
	ПолеПериод = СхемаПроверкиУсловия.ВычисляемыеПоля.Найти("Дата");
	ПолеПериод.Выражение =
		"ВЫБОР
		|	КОГДА ЗНАЧЕНИЕЗАПОЛНЕНО(ФактическаяДатаПроведения)
		|		ТОГДА ФактическаяДатаПроведения
		|	ИНАЧЕ "
		+ ПолеПериод.Выражение
		+ "
		|	КОНЕЦ";
	НаборДанныеДокумента = СхемаПроверкиУсловия.НаборыДанных.Найти("ШапкаДокумента");
	ПолеДатаПроведения = НаборДанныеДокумента.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	ПолеДатаПроведения.Поле = "ФактическаяДатаПроведения";
	ПолеДатаПроведения.ПутьКДанным = "ФактическаяДатаПроведения";
КонецПроцедуры

// Получает бухгалтерскую операцию документа из регистра ОперацииДокументов
//
// Параметры
//  Документ  - ДокументСсылка - ссылка на документ
//
// Возвращаемое значение:
//   СправочникСсылка.ТиповыеОперации   - Ссылка на типовую операцию или пустая ссылка.
//
Функция БухгалтерскаяОперацияДокумента(Документ) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ОперацииДокументов.Операция
		|ИЗ
		|	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		|ГДЕ
		|	ОперацииДокументов.Документ = &Документ";
	Запрос.УстановитьПараметр("Документ", Документ);
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда

		Возврат Справочники.ТиповыеОперации.ПустаяСсылка();

	КонецЕсли;

	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Операция;

КонецФункции

// Функция возвращает структуру содержающую значения, вычисленные из формул типовой операции
// "Дата" - дата операции, "Организация" - организация операции
// Параметры
// Документ - ДокументОбъект
// Операция - СправочникСсылка.ТиповыеОперации
//
// Возвращаемое значение:
// Структура
//
Функция ПолучитьДатуИОрганизациюОперации(Знач Документ, Операция) Экспорт
	ДатаОрганизация = Новый Структура("Дата, Организация");
	РассчитатьРеквизитыОперации(Операция, СоздатьИсточникДанныхИзШапкиОбъекта(Документ, Операция), ДатаОрганизация);
	Возврат ДатаОрганизация;
КонецФункции

// Функция возвращает "Истина" если в журнале проводок есть проводки с регистратором "Ссылка".
//
Функция ЕстьПроводкиДокумента(Ссылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
		|ГДЕ
		|	ЖурналПроводокЕПСБУ.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	УстановитьПривилегированныйРежим(Истина);
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Возвращает сохраненные значения дополнительных реквизитов операции.
// Возвращает структуру, в которой "Ключ" - ИмяДляФормулы реквизита, "Значение" - значение реквизита.
// Если в базе ведется валютный учет и в документе может учитываться Валюта, добавляются ключи
// "Курс" и "Кратность".
//
// Параметры
//  Документ  - ДокументСсылка - Документ
//  ТиповаяОперация  - СправочникСсылка.ТиповыеОперации - не используется. Оставлена для обработной совместимости.
//  ВалютныйДокумент - Булево - признак использования Валюты в документе. Если не передан, определяется автоматически.
//
// Возвращаемое значение:
//   Структура   - Структура сохраненных дополнительных реквизитов
//
Функция ЗаполнитьДополнительныеРеквизиты(Документ, ТиповаяОперация = Неопределено,
		Знач ВалютныйДокумент = Неопределено) Экспорт

	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	Если ВалютныйДокумент = Неопределено Тогда
		ВалютныйДокумент = ИспользоватьВалютныйУчет
			И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ВалютаДокумента", Документ.Метаданные());
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации,
	|	ЗначенияДополнительныхРеквизитовОпераций.Значение,
	|	ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации.ИмяДляФормулы КАК ИмяДляФормулы
	|ИЗ
	|	РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
	|ГДЕ
	|	ЗначенияДополнительныхРеквизитовОпераций.Объект = &Документ
	|	И
	|		ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации <> ЗНАЧЕНИЕ(Справочник.РеквизитыТиповыхОпераций.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОперацииДокументов.ИсправлениеОшибки,
	|	ОперацииДокументов.ВыявительОшибки,
	|	ОперацииДокументов.ПричинаОшибки,
	|	ОперацииДокументов.ОтветственныйИсполнитель,
	|	Истина Как ВалютныеПоля
	|ИЗ
	|	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|ГДЕ
	|	ОперацииДокументов.Документ = &Документ";
	
	Если ИспользоватьВалютныйУчет Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Истина Как ВалютныеПоля",
			"ЕСТЬNULL(ОперацииДокументов.Курс, 1) КАК Курс,
			|ЕСТЬNULL(ОперацииДокументов.Кратность, 1) КАК Кратность")
	КонецЕсли;
	Запрос.УстановитьПараметр("Документ", Документ);

	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ДопРеквизиты = Новый Структура;
	Выборка = РезультатЗапроса[0].Выбрать();
	Пока Выборка.Следующий() Цикл

		ДопРеквизиты.Вставить(Выборка.ИмяДляФормулы, Выборка.Значение);

	КонецЦикла;

	Курс = 0;
	Кратность = 0;
	ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка();
	ВыявительОшибки = Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка();
	ПричинаОшибки = Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка();
	ОтветственныйИсполнитель = Справочники.Сотрудники.ПустаяСсылка();

	Выборка = РезультатЗапроса[1].Выбрать();
	Если Выборка.Следующий() Тогда
		ИсправлениеОшибки = Выборка.ИсправлениеОшибки;
		ВыявительОшибки = Выборка.ВыявительОшибки;
		ПричинаОшибки = Выборка.ПричинаОшибки;
		ОтветственныйИсполнитель = Выборка.ОтветственныйИсполнитель;
		Если ИспользоватьВалютныйУчет И ВалютныйДокумент Тогда
			Курс = Выборка.Курс;
			Кратность = Выборка.Кратность;
		КонецЕсли;
	КонецЕсли;
	
	ДопРеквизиты.Вставить("ИсправлениеОшибки", ИсправлениеОшибки);
	ДопРеквизиты.Вставить("ВыявительОшибки",   ВыявительОшибки);
	ДопРеквизиты.Вставить("ПричинаОшибки",     ПричинаОшибки);
	ДопРеквизиты.Вставить("ОтветственныйИсполнитель", ОтветственныйИсполнитель);
	
	Если ИспользоватьВалютныйУчет И ВалютныйДокумент Тогда

		ДопРеквизиты.Вставить("Курс", ?(Курс = 0, 1, Курс));
		ДопРеквизиты.Вставить("Кратность", ?(Кратность = 0, 1, Кратность));

	КонецЕсли;

	Возврат ДопРеквизиты;

КонецФункции

// Возвращает реквизиты операции и саму операцию документа
//  Параметры:
//			ДокументСсылка - ссылка на документ
//			ИсходныйСписокРеквизитов -  1. строка содержащая название нужных реквизитов через запятую
//										2. структура содержащая нужные реквизиты 
//										
Функция ПолучитьРеквизитыОперации(ДокументСсылка,
		ИсходныйСписокРеквизитов = "Операция") экспорт
	Если ТипЗнч(ИсходныйСписокРеквизитов) = Тип("Строка") тогда
		СписокРеквизитов = Новый Структура(ИсходныйСписокРеквизитов);
	ИначеЕсли ТипЗнч(ИсходныйСписокРеквизитов) = Тип("Структура") тогда
		СписокРеквизитов = ОбщегоНазначения.СкопироватьРекурсивно(ИсходныйСписокРеквизитов);
	ИначеЕсли ТипЗнч(ИсходныйСписокРеквизитов) <> Тип("Структура") тогда
		СписокРеквизитов = Новый Структура();
	КонецЕсли;
	Реквизиты = Новый Массив;
	Для каждого Ключ из СписокРеквизитов цикл
		Реквизиты.Добавить(Ключ.Ключ);
	КонецЦикла;
	ТекстЗапроса = "ВЫБРАТЬ
		|	ОперацииДокументов.Курс КАК Курс,
		|	ОперацииДокументов.Кратность КАК Кратность,
		|	ОперацииДокументов.Операция
		|ПОМЕСТИТЬ ОперацияДокумента
		|ИЗ
		|	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		|ГДЕ
		|	ОперацииДокументов.Документ = &Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации.ИмяДляФормулы КАК Ключ,
		|	ЗначенияДополнительныхРеквизитовОпераций.Значение
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
		|ГДЕ
		|	ЗначенияДополнительныхРеквизитовОпераций.Объект = &Документ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Операция"",
		|	ЕСТЬNULL(ОперацияДокумента.Операция, Значение(Справочник.ТиповыеОперации.ПустаяСсылка))
		|ИЗ
		|	ОперацияДокумента КАК ОперацияДокумента
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Курс"",
		|	ЕСТЬNULL(ОперацияДокумента.Курс, 0)
		|ИЗ
		|	ОперацияДокумента КАК ОперацияДокумента
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Кратность"",
		|	ЕСТЬNULL(ОперацияДокумента.Кратность, 0)
		|ИЗ
		|	ОперацияДокумента КАК ОперацияДокумента";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Документ", ДокументСсылка);

	УстановитьПривилегированныйРежим(Истина);

	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() цикл
		Если СписокРеквизитов.Свойство(Результат.Ключ) тогда
			СписокРеквизитов[Результат.Ключ] = Результат.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат СписокРеквизитов;
КонецФункции

// Возвращает массив имен табличных частей документа, используемых при формировании проводок.
// Если имя табличной части не заполнено, то вставляется имя "Документ".
//
// Параметры:
// ТиповаяОперация - СправочникСсылка.ТиповыеОперации - ссылка на типовую операцию.
//
// Возвращаемое значение:
// Массив - Массив имен табличных частей.
//
Функция ПолучитьИспользуемыеВПроводкахТЧ(ТиповаяОперация) Экспорт
	Перем ПоставляемаяТиповаяОперация;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫБОР
		|		КОГДА ПроводкиТиповыхОпераций.ИмяТабличнойЧастиДокумента = """"
		|				ИЛИ ПроводкиТиповыхОпераций.ИмяТабличнойЧастиДокумента = ""<>""
		|			ТОГДА ""Документ""
		|		ИНАЧЕ ПроводкиТиповыхОпераций.ИмяТабличнойЧастиДокумента
		|	КОНЕЦ КАК ИмяТабличнойЧастиДокумента
		|ИЗ
		|	Справочник.ПроводкиТиповыхОпераций КАК ПроводкиТиповыхОпераций
		|ГДЕ
		|	ПроводкиТиповыхОпераций.Владелец = &ТиповаяОперация";
	Если Справочники.ТиповыеОперации.ТиповаяОперацияНеРедактируется(ТиповаяОперация, ПоставляемаяТиповаяОперация) Тогда

		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.ПроводкиТиповыхОпераций", "Справочник.ПоставляемыеПроводкиТиповыхОпераций");
		Запрос.УстановитьПараметр("ТиповаяОперация", ПоставляемаяТиповаяОперация);

	Иначе

		Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);

	КонецЕсли;

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИмяТабличнойЧастиДокумента");
КонецФункции

Функция СформироватьСхемуУсловияТиповойОперации(ДанныеТиповойОперации,
		ОписаниеОшибки = "") Экспорт
	Перем РеквизитыТиповойОперации;
	Перем ДополнительныеРеквизитыОперации;
	Перем ТиповаяОперация;

	ДанныеТиповойОперации.Свойство("ДанныеОперации", РеквизитыТиповойОперации);
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(
		РеквизитыТиповойОперации.ИдентификаторДокумента, Ложь);
	Если ТипЗнч(МетаданныеДокумента) <> Тип("ОбъектМетаданных") Тогда
		ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииИзменение(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			НСтр("ru = 'В метаданных не найден документ, к которому относится типовая операция'"));
		Возврат Неопределено;
	КонецЕсли;

	РеквизитыКЭКПроводки = Новый Массив;

	ДанныеТиповойОперации.Свойство("ТиповаяОперация", ТиповаяОперация);
	ДанныеТиповойОперации.Свойство("ДополнительныеРеквизиты", ДополнительныеРеквизитыОперации);

	СхемаКомпоновкиУсловие = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновкиУсловие.ИсточникиДанных.Добавить();
	ИсточникДанных.ТипИсточникаДанных = "Local";
	ИсточникДанных.Имя = "ИсточникДанных1";

	НаборДанных = СхемаКомпоновкиУсловие.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "ШапкаДокумента";
	НаборДанных.ИсточникДанных = СхемаКомпоновкиУсловие.ИсточникиДанных[0].Имя;
	НаборДанных.ИмяОбъекта = "ШапкаДокумента";

	ТипЗначенияПараметра = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(ТиповаяОперация)));

	ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, "Ссылка", "Документ", "", Новый ОписаниеТипов("ДокументСсылка."
		+ МетаданныеДокумента.Имя));
	ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, "Дата", "Документ", "", Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты()));
	ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, "Номер", "Документ", "", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
	ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, "ТиповаяОперация", "", "", ТипЗначенияПараметра);
	Для Каждого ТекДопРеквизит Из ДополнительныеРеквизитыОперации Цикл
		ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, ТекДопРеквизит.ИмяДляФормулы, "ДополнительныеРеквизиты", , ?(ТекДопРеквизит.РеквизитПроводкиТипЗначения = Неопределено, Новый ОписаниеТипов("Неопределено"), ТекДопРеквизит.РеквизитПроводкиТипЗначения));
	КонецЦикла;

	Для каждого ТекРеквизит Из МетаданныеДокумента.Реквизиты Цикл

		ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, ТекРеквизит.Имя, "Документ", , ТекРеквизит.Тип);

	КонецЦикла;

	ТекРеквизит = МетаданныеДокумента.Реквизиты.Найти("ВалютаДокумента");
	Если ТекРеквизит <> Неопределено Тогда
		ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, ТекРеквизит.Имя, "Документ", , ТекРеквизит.Тип);
	КонецЕсли;

	ПолеДата = СхемаКомпоновкиУсловие.ВычисляемыеПоля.Добавить();
	ПолеДата.ПутьКДанным = "Дата";
	Формула = "";
	ОбработатьФормулуРеквизитаПроводки(РеквизитыТиповойОперации.ФормулаДата, Формула, "", Новый Массив, "", "", ОписаниеОшибки, , , РеквизитыКЭКПроводки);
	ПолеДата.Выражение = Формула; //ОбработаннаяФормулаРеквизитаПроводки(РеквизитыТиповойОперации.ФормулаДата, "", Новый Массив, ОписаниеОшибки);
	ПолеДата.ТипЗначения = Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	ПолеДата.Заголовок = "Дата";

	ПолеОрганизация = СхемаКомпоновкиУсловие.ВычисляемыеПоля.Добавить();
	ПолеОрганизация.ПутьКДанным = "Организация";
	Формула = "";
	ОбработатьФормулуРеквизитаПроводки(РеквизитыТиповойОперации.ФормулаОрганизация, Формула, "", Новый Массив, "", "", ОписаниеОшибки, , , РеквизитыКЭКПроводки);
	ПолеОрганизация.Выражение = Формула;
	ПолеОрганизация.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Организации");
	ПолеОрганизация.Заголовок = "Организация";

	ПолеУсловие = СхемаКомпоновкиУсловие.ВычисляемыеПоля.Добавить();
	ПолеУсловие.ПутьКДанным = "УсловиеФормирования";
	Если ПустаяСтрока(РеквизитыТиповойОперации.Условие) Тогда
		ПолеУсловие.Выражение = "Истина";
	Иначе
		Формула = "";
		ОбработатьФормулуРеквизитаПроводки(РеквизитыТиповойОперации.Условие, Формула, "", Новый Массив, "", "", ОписаниеОшибки, , , РеквизитыКЭКПроводки);
		ПолеУсловие.Выражение = Формула;
	КонецЕсли;
	ПолеУсловие.ТипЗначения = Новый ОписаниеТипов("Булево");
	ПолеУсловие.Заголовок = "УсловиеФормирования";

	ПолеТекстПриОшибке = СхемаКомпоновкиУсловие.ВычисляемыеПоля.Добавить();
	ПолеТекстПриОшибке.ПутьКДанным = "ТекстСообщенияПриОшибке";
	ПолеТекстПриОшибке.Выражение = "Выразить(Выбор Когда Подстрока(ТиповаяОперация.ТекстСообщенияПриОшибке,1,100)="""" Тогда ""Не выполнено условие формирования операции!"" Иначе ТиповаяОперация.ТекстСообщенияПриОшибке Конец, ""Строка"")";
	ПолеТекстПриОшибке.Заголовок = "ТекстСообщенияПриОшибке";

	ПолеВывода = СхемаКомпоновкиУсловие.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ПолеВывода.Поле = Новый ПолеКомпоновкиДанных("Дата");
	//ПолеВывода.Использование = Истина;
	ПолеВывода = СхемаКомпоновкиУсловие.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ПолеВывода.Поле = Новый ПолеКомпоновкиДанных("Организация");
	ПолеВывода = СхемаКомпоновкиУсловие.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ПолеВывода.Поле = Новый ПолеКомпоновкиДанных("УсловиеФормирования");
	ПолеВывода = СхемаКомпоновкиУсловие.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ПолеВывода.Поле = Новый ПолеКомпоновкиДанных("ТекстСообщенияПриОшибке");

	Структура = СхемаКомпоновкиУсловие.НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));

	Возврат СхемаКомпоновкиУсловие;

КонецФункции

Функция СформироватьСхемуФормированияПроводок(ДанныеТиповойОперации,
		ОписаниеОшибки = "") Экспорт
	Перем РеквизитыТиповойОперации;
	Перем ЗначенияРеквизитовПроводок;
	Перем ДополнительныеРеквизитыОперации;
	Перем ДополнительныеИсточникиДанных;

	ДанныеТиповойОперации.Свойство("ДанныеОперации", РеквизитыТиповойОперации);
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(
		РеквизитыТиповойОперации.ИдентификаторДокумента, Ложь);
	Если ТипЗнч(МетаданныеДокумента) <> Тип("ОбъектМетаданных") Тогда
		ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрацииИзменение(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			НСтр("ru = 'В метаданных не найден документ, к которому относится типовая операция'"));
		Возврат Неопределено;
	КонецЕсли;
	
	СхемаКомпоновки = Справочники.ТиповыеОперации.ПолучитьМакет("ОбразецСКД");
	ДанныеТиповойОперации.Свойство("Проводки", ЗначенияРеквизитовПроводок);
	ДанныеТиповойОперации.Свойство("ДополнительныеРеквизиты", ДополнительныеРеквизитыОперации);
	ДанныеТиповойОперации.Свойство("ДополнительныеИсточникиДанных", ДополнительныеИсточникиДанных);

	ЕстьВалютаВДокументе = МетаданныеДокумента.Реквизиты.Найти("ВалютаДокумента") <> Неопределено;

	НастройкаПроводок = ПустаяТаблицаНастройкиПроводок();
	Символ0 = Символ(0);

	Для каждого ТекСтрокаПроводки Из ЗначенияРеквизитовПроводок Цикл

		НастройкаНовойПроводки = НастройкаПроводок.Добавить();
		НастройкаНовойПроводки.ТекущаяПроводка = ТекСтрокаПроводки.Ссылка;
		НастройкаНовойПроводки.КодПроводки = ИмяПараметраПроводка(ТекСтрокаПроводки.Ссылка);

		ОбщиеПараметрыЗаполнения = Новый Структура();
		ОбщиеПараметрыЗаполнения.Вставить("ТекСтрокаПроводки", ТекСтрокаПроводки);
		ОбщиеПараметрыЗаполнения.Вставить("ВычисляемыеПоля", СхемаКомпоновки.ВычисляемыеПоля);
		ОбщиеПараметрыЗаполнения.Вставить("НастройкаНовойПроводки", НастройкаНовойПроводки);
		ОбщиеПараметрыЗаполнения.Вставить("ИспользуемыеРеквизиты", Новый Массив);
		ОбщиеПараметрыЗаполнения.Вставить("ОписаниеОшибки", "");
		ОбщиеПараметрыЗаполнения.Вставить("РеквизитыКЭКПроводки", Новый Массив);

		ВычислитьФормулыЗаполненияРеквизитов(ОбщиеПараметрыЗаполнения);

		Если Не ПустаяСтрока(ОбщиеПараметрыЗаполнения.ОписаниеОшибки) Тогда
			ОписаниеОшибки = ОбщиеПараметрыЗаполнения.ОписаниеОшибки;
			Возврат Неопределено;
		КонецЕсли;

		ЗаменитьФункциюКЭКПроводки(ОбщиеПараметрыЗаполнения);

		РеквизитыДляПроверки = Новый Массив;
		Для каждого ТекПоле Из ОбщиеПараметрыЗаполнения.ИспользуемыеРеквизиты Цикл

			Если ТекПоле.ИспользуемыеРеквизиты.Количество() > 0 Тогда
				РеквизитыДляПроверки.Добавить(ТекПоле.ИмяПоля);
			КонецЕсли;

		КонецЦикла;

		Пока РеквизитыДляПроверки.Количество() > 0 Цикл

			ЕстьОбработанныеПоля = Ложь;
			ПоляКУдалению = Новый Массив;
			Для каждого ТекПоле Из РеквизитыДляПроверки Цикл

				ТекстФормулы = НастройкаНовойПроводки[ТекПоле];
				Если ТекПоле = "УсловиеВыполнено" ИЛИ ТекПоле = "Период"
						ИЛИ ТекПоле = "Активность" Тогда
					ТекстФормулыБезМакроса = НастройкаНовойПроводки[ТекПоле];
				Иначе
					ТекстФормулыБезМакроса = НастройкаНовойПроводки[ТекПоле + "БезМакроса"];
				КонецЕсли;

				ПозицияНачала = Найти(ТекстФормулы, Символ0);
				ОбработкаПрервана = Ложь;
				Пока ПозицияНачала <> 0 Цикл
					Длина = 1;
					Пока Сред(ТекстФормулы, ПозицияНачала + Длина, 1) <> Символ0 Цикл
						Длина = Длина + 1;
					КонецЦикла;
					ИмяЗаменяемогоРеквизита = Сред(ТекстФормулы, ПозицияНачала + 1, Длина
						- 1);
					ИмяЗаменяемогоПоля = Сред(ИмяЗаменяемогоРеквизита, 10);
					Если ИмяЗаменяемогоПоля = "ПЕРИОД" ИЛИ ИмяЗаменяемогоПоля = "АКТИВНОСТЬ"
							ИЛИ ПустаяСтрока(НастройкаНовойПроводки[ИмяЗаменяемогоПоля
							+ "БезМакроса"]) Тогда
						ЗаменяющийТекст = НастройкаНовойПроводки[ИмяЗаменяемогоПоля];
					Иначе
						ЗаменяющийТекст = НастройкаНовойПроводки[ИмяЗаменяемогоПоля
							+ "БезМакроса"];
					КонецЕсли;
					Если Найти(ЗаменяющийТекст, Символ0) = 0 Тогда
						ЕстьОбработанныеПоля = Истина;
						ТекстФормулы = СтрЗаменить(ТекстФормулы, Символ0
							+ ИмяЗаменяемогоРеквизита + Символ0, ЗаменяющийТекст);
						ТекстФормулыБезМакроса = СтрЗаменить(ТекстФормулыБезМакроса, Символ0
							+ ИмяЗаменяемогоРеквизита + Символ0, ЗаменяющийТекст);
						НастройкаНовойПроводки[ТекПоле] = ТекстФормулы;
						Если ТекПоле <> "УсловиеВыполнено" И ТекПоле <> "Период"
								И ТекПоле <> "Активность" Тогда

							НастройкаНовойПроводки[ТекПоле
								+ "БезМакроса"] = ТекстФормулыБезМакроса;
						КонецЕсли;
					Иначе
						ОбработкаПрервана = Истина;
						Прервать;
					КонецЕсли;
					ПозицияНачала = Найти(ТекстФормулы, Символ0);
				КонецЦикла;
				Если Не ОбработкаПрервана Тогда
					ПоляКУдалению.Добавить(ТекПоле);
				КонецЕсли;
			КонецЦикла;

			Если НЕ ЕстьОбработанныеПоля Тогда
				ОписаниеОшибки = НСтр("ru = 'В настройках проводок используются циклические ссылки на реквизиты проводки'");
				Возврат Неопределено;
			КонецЕсли;
			Для каждого ПолеКУдалению Из ПоляКУдалению Цикл

				РеквизитыДляПроверки.Удалить(РеквизитыДляПроверки.Найти(ПолеКУдалению));

			КонецЦикла;

		КонецЦикла;

		ДополнительноОбработатьРеквизитыКоличество(НастройкаНовойПроводки);
		ДополнительноОбработатьРеквизитыВалюта(НастройкаНовойПроводки);

		Если ЕстьВалютаВДокументе И НЕ ТекСтрокаПроводки.НеПересчитыватьСумму Тогда
			ДобавитьВалютныйУчетВФормулуСуммы(НастройкаНовойПроводки.Сумма);
			ДобавитьВалютныйУчетВФормулуСуммы(НастройкаНовойПроводки.СуммаНеУчитываетсяНУ);
			ДобавитьВалютныйУчетВФормулуСуммы(НастройкаНовойПроводки.СуммаЕНВД);
			ДобавитьВалютныйУчетВФормулуСуммы(НастройкаНовойПроводки.СуммаНДС);
		КонецЕсли;

	КонецЦикла;

	ВычисляемыеПоля = СхемаКомпоновки.ВычисляемыеПоля;

	СформироватьТекстыВычисляемыхПолей(НастройкаПроводок, ВычисляемыеПоля);

	Если МетаданныеДокумента.Реквизиты.Найти("ВидМежотчетногоПериода") <> Неопределено Тогда

		// Настроить заполнение поля "УточнениеПериода" и "ВидМежотчетногоПериода".
		// Поля заполняются только если проводка формируется последней секундой года.
		ПолеПериод = СхемаКомпоновки.ВычисляемыеПоля.Найти("Период");

		// УточнениеПериода
		ПолеУточнениеПериода = СхемаКомпоновки.ВычисляемыеПоля.Найти("УточнениеПериода");
		ПолеУточнениеПериода.Выражение = ДоработатьФормулуУточненияПериода(ПолеПериод.Выражение,
			"БухгалтерскиеОперации.ЗначениеУточненияПериода(&ВидМежотчетногоПериода)",
			"БухгалтерскиеОперации.ЗначениеУточненияПериода(Перечисления.ВидыМежотчетногоПериода.ПустаяСсылка())");

		ВыбранноеПолеУточнениеПериода = СхемаКомпоновки.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(
			Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПолеУточнениеПериода.Поле = Новый ПолеКомпоновкиДанных("УточнениеПериода");
		ВыбранноеПолеУточнениеПериода.Использование = Истина;

		// ВидМежотчетногоПериода
		ПолеВидМежотчетногоПериода = СхемаКомпоновки.ВычисляемыеПоля.Найти("ВидМежотчетногоПериода");
		ПолеВидМежотчетногоПериода.Выражение = ДоработатьФормулуУточненияПериода(ПолеПериод.Выражение,
			"&ВидМежотчетногоПериода",
			"Перечисления.ВидыМежотчетногоПериода.ПустаяСсылка()");

		ВыбранноеПолеВидМежотчетногоПериода = СхемаКомпоновки.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(
			Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПолеВидМежотчетногоПериода.Поле = Новый ПолеКомпоновкиДанных("ВидМежотчетногоПериода");
		ВыбранноеПолеВидМежотчетногоПериода.Использование = Истина;

	КонецЕсли;

	Если ОбщегоНазначения.РазделениеВключено()
			И НЕ ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		ДополнительныеТабличныеЧасти = Новый ДеревоЗначений;
		ДополнительныеТабличныеЧасти.Колонки.Добавить("ИмяТабличнойЧасти");
		ДополнительныеТабличныеЧасти.Колонки.Добавить("Тип");
		ДополнительныеТабличныеЧасти.Колонки.Добавить("Имя");
		ДополнительныеТабличныеЧасти.Колонки.Добавить("Обработано");
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
			|	КолонкиДополнительныхТабличныхЧастей.Владелец.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
			|	КолонкиДополнительныхТабличныхЧастей.ОписаниеТипаКолонки.ТипЗначения КАК Тип,
			|	КолонкиДополнительныхТабличныхЧастей.ИмяКолонки КАК Имя, ЛОЖЬ КАК Обработано
			|ИЗ
			|	Справочник.КолонкиДополнительныхТабличныхЧастей КАК КолонкиДополнительныхТабличныхЧастей
			|ГДЕ
			|	КолонкиДополнительныхТабличныхЧастей.Владелец.ИдентификаторДокумента = &ИдентификаторДокумента
			|	И НЕ КолонкиДополнительныхТабличныхЧастей.ПометкаУдаления
			|	И НЕ КолонкиДополнительныхТабличныхЧастей.Владелец.ПометкаУдаления
			|ИТОГИ ПО
			|	ИмяТабличнойЧасти";
		Запрос.УстановитьПараметр("ИдентификаторДокумента", РеквизитыТиповойОперации.ИдентификаторДокумента);
		ДополнительныеТабличныеЧасти = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЕсли;

	ИмяДокумента = МетаданныеДокумента.Имя;
	//ДополнительныеРеквизитыОперации = РеквизитыТиповойОперации.ДополнительныеРеквизиты.Выгрузить();
	ДополнительныеРеквизитыОперации.Колонки.Добавить("ТипЗначенияРеквизита", Новый ОписаниеТипов("ОписаниеТипов"));
	Для каждого ТекДопРеквизит Из ДополнительныеРеквизитыОперации Цикл

		Если ТипЗнч(ТекДопРеквизит.РеквизитПроводки) = Тип("Строка") Тогда
			ТекДопРеквизит.ТипЗначенияРеквизита = Новый ОписаниеТипов("Неопределено");
		Иначе
			ТекДопРеквизит.ТипЗначенияРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекДопРеквизит.РеквизитПроводки, "ТипЗначения");
		КонецЕсли;

	КонецЦикла;

	ОбязательныеПоляТаблиц = Новый Массив;
	ОбязательныеПоляТаблиц.Добавить(Новый Структура);
	ОбязательныеПоляТаблиц[0].Вставить("Имя", "ИмяТабличнойЧасти");
	ОбязательныеПоляТаблиц[0].Вставить("Префикс", "");
	ОбязательныеПоляТаблиц[0].Вставить("Префикс2", "");
	ОбязательныеПоляТаблиц[0].Вставить("Тип", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150)));
	ОбязательныеПоляТаблиц.Добавить(Новый Структура);
	ОбязательныеПоляТаблиц[1].Вставить("Имя", "Ссылка");
	ОбязательныеПоляТаблиц[1].Вставить("Префикс", "Документ");
	ОбязательныеПоляТаблиц[1].Вставить("Префикс2", "");
	ОбязательныеПоляТаблиц[1].Вставить("Тип", Новый ОписаниеТипов("ДокументСсылка."
		+ ИмяДокумента));
	ОбязательныеПоляТаблиц.Добавить(Новый Структура);
	ОбязательныеПоляТаблиц[2].Вставить("Имя", "Дата");
	ОбязательныеПоляТаблиц[2].Вставить("Префикс", "Документ");
	ОбязательныеПоляТаблиц[2].Вставить("Префикс2", "РеквизитШапки");
	ОбязательныеПоляТаблиц[2].Вставить("Тип", Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты()));
	ОбязательныеПоляТаблиц.Добавить(Новый Структура);
	ОбязательныеПоляТаблиц[3].Вставить("Имя", "Номер");
	ОбязательныеПоляТаблиц[3].Вставить("Префикс", "Документ");
	ОбязательныеПоляТаблиц[3].Вставить("Префикс2", "РеквизитШапки");
	ОбязательныеПоляТаблиц[3].Вставить("Тип", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(МетаданныеДокумента.ДлинаНомера)));
	ОбязательныеПоляТаблиц.Добавить(Новый Структура);
	ОбязательныеПоляТаблиц[4].Вставить("Имя", "ИмяТабличнойЧасти");
	ОбязательныеПоляТаблиц[4].Вставить("Префикс", "");
	ОбязательныеПоляТаблиц[4].Вставить("Префикс2", "");
	ОбязательныеПоляТаблиц[4].Вставить("Тип", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150)));

	Для каждого ТекРеквизит Из МетаданныеДокумента.Реквизиты Цикл

		ОбязательноеПоле = Новый Структура;
		ОбязательноеПоле.Вставить("Имя", ТекРеквизит.Имя);
		ОбязательноеПоле.Вставить("Префикс", "Документ");
		ОбязательноеПоле.Вставить("Префикс2", "РеквизитШапки");
		ОбязательноеПоле.Вставить("Тип", ТекРеквизит.Тип);
		ОбязательныеПоляТаблиц.Добавить(ОбязательноеПоле);

	КонецЦикла;

	Если НЕ ЕстьВалютаВДокументе Тогда

		ОбязательноеПоле = Новый Структура;
		ОбязательноеПоле.Вставить("Имя", "ВалютаДокумента");
		ОбязательноеПоле.Вставить("Префикс", "Документ");
		ОбязательноеПоле.Вставить("Префикс2", "РеквизитШапки");
		ОбязательноеПоле.Вставить("Тип", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
		ОбязательныеПоляТаблиц.Добавить(ОбязательноеПоле);

	КонецЕсли;

	Для каждого ТекДопРеквизит Из ДополнительныеРеквизитыОперации Цикл

		ОбязательноеПоле = Новый Структура;
		ОбязательноеПоле.Вставить("Имя", ТекДопРеквизит.ИмяДляФормулы);
		ОбязательноеПоле.Вставить("Префикс", "ДополнительныеРеквизиты");
		ОбязательноеПоле.Вставить("Префикс2", "ДополнительныйРеквизит_");
		ОбязательноеПоле.Вставить("Тип", ТекДопРеквизит.ТипЗначенияРеквизита);
		ОбязательныеПоляТаблиц.Добавить(ОбязательноеПоле);

	КонецЦикла;

	Объединение = СхемаКомпоновки.НаборыДанных.Найти("ДанныеДокумента");
	ИмяИсточникаДанных = СхемаКомпоновки.ИсточникиДанных[0].Имя;

	НаборДанных = Объединение.Элементы.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.ИсточникДанных = ИмяИсточникаДанных;
	НаборДанных.Имя = "Документ";
	НаборДанных.ИмяОбъекта = "Документ";

	ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, "НомерСтроки", "", , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
	ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, "НомерСтроки", "", , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
	Для каждого ОбязательноеПолеТаблицы Из ОбязательныеПоляТаблиц Цикл

		ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, ОбязательноеПолеТаблицы.Имя, ОбязательноеПолеТаблицы.Префикс, ОбязательноеПолеТаблицы.Префикс2, ОбязательноеПолеТаблицы.Тип);
		ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, ОбязательноеПолеТаблицы.Имя, ОбязательноеПолеТаблицы.Префикс, , ОбязательноеПолеТаблицы.Тип);

	КонецЦикла;

	Для каждого ТекТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл

		ИмяТЧ = ТекТабличнаяЧасть.Имя;

		НаборДанных = Объединение.Элементы.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
		НаборДанных.ИсточникДанных = ИмяИсточникаДанных;
		НаборДанных.Имя = ТекТабличнаяЧасть.Имя;
		НаборДанных.ИмяОбъекта = ТекТабличнаяЧасть.Имя;

		Для каждого ОбязательноеПолеТаблицы Из ОбязательныеПоляТаблиц Цикл

			ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, ОбязательноеПолеТаблицы.Имя, ОбязательноеПолеТаблицы.Префикс, ОбязательноеПолеТаблицы.Префикс2, ОбязательноеПолеТаблицы.Тип);
			ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, ОбязательноеПолеТаблицы.Имя, ОбязательноеПолеТаблицы.Префикс, , ОбязательноеПолеТаблицы.Тип);

		КонецЦикла;

		ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, "НомерСтроки", "СтрокаТаблицы", , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
		ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, "НомерСтроки", "СтрокаТаблицы", , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
		Сч = 0;
		МетаданныеТабличнаяЧасть = МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТЧ);
		Если МетаданныеТабличнаяЧасть <> Неопределено Тогда
			Для Каждого ТекРеквизит Из МетаданныеТабличнаяЧасть.Реквизиты Цикл
				ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, ТекРеквизит.Имя, "СтрокаТаблицы", , ТекРеквизит.Тип);
				ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, ТекРеквизит.Имя, "СтрокаТаблицы", , ТекРеквизит.Тип);
				Сч = Сч + 1;
			КонецЦикла;
		КонецЕсли;
		РеквизитыДополнительнойТабЧасти = ДополнительныеТабличныеЧасти.Строки.НайтиСтроки(Новый Структура("ИмяТабличнойЧасти", ИмяТЧ), Истина);
		Для каждого ТекРеквизит Из РеквизитыДополнительнойТабЧасти Цикл

			Если ЗначениеЗаполнено(ТекРеквизит.Имя) Тогда

				ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, ТекРеквизит.Имя, "СтрокаТаблицы", , ТекРеквизит.Тип);
				ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, ТекРеквизит.Имя, "СтрокаТаблицы", , ТекРеквизит.Тип);
				Сч = Сч + 1;

			Иначе

				ТекРеквизит.Обработано = ИСТИНА;

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Для каждого ДопТабличнаяЧасть Из ДополнительныеТабличныеЧасти.Строки Цикл

		Если ДопТабличнаяЧасть.Обработано = ИСТИНА Тогда
			Продолжить;
		КонецЕсли;

		ИмяТЧ = ДопТабличнаяЧасть.ИмяТабличнойЧасти;

		НаборДанных = Объединение.Элементы.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
		НаборДанных.ИсточникДанных = ИмяИсточникаДанных;
		НаборДанных.Имя = ИмяТЧ;
		НаборДанных.ИмяОбъекта = ИмяТЧ;

		Для каждого ОбязательноеПолеТаблицы Из ОбязательныеПоляТаблиц Цикл

			ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, ОбязательноеПолеТаблицы.Имя, ОбязательноеПолеТаблицы.Префикс, ОбязательноеПолеТаблицы.Префикс2, ОбязательноеПолеТаблицы.Тип);
			ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, ОбязательноеПолеТаблицы.Имя, ОбязательноеПолеТаблицы.Префикс, , ОбязательноеПолеТаблицы.Тип);

		КонецЦикла;

		ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, "НомерСтроки", "СтрокаТаблицы", , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
		ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, "НомерСтроки", "СтрокаТаблицы", , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
		Для каждого ТекРеквизит Из ДопТабличнаяЧасть.Строки Цикл

			Если ЗначениеЗаполнено(ТекРеквизит.Имя) Тогда

				ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, ТекРеквизит.Имя, "СтрокаТаблицы", , ТекРеквизит.Тип);
				ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, ТекРеквизит.Имя, "СтрокаТаблицы", , ТекРеквизит.Тип);

			Иначе

				ТекРеквизит.Обработано = ИСТИНА;

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Для каждого ДополнительныйИсточникДанных Из ДополнительныеИсточникиДанных.Строки Цикл

		ИмяТЧ = ДополнительныйИсточникДанных.ИмяИсточника;

		НаборДанных = Объединение.Элементы.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
		НаборДанных.ИсточникДанных = ИмяИсточникаДанных;
		НаборДанных.Имя = ИмяТЧ;
		НаборДанных.ИмяОбъекта = ИмяТЧ;

		Для каждого ОбязательноеПолеТаблицы Из ОбязательныеПоляТаблиц Цикл

			ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, ОбязательноеПолеТаблицы.Имя, ОбязательноеПолеТаблицы.Префикс, ОбязательноеПолеТаблицы.Префикс2, ОбязательноеПолеТаблицы.Тип);
			ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, ОбязательноеПолеТаблицы.Имя, ОбязательноеПолеТаблицы.Префикс, , ОбязательноеПолеТаблицы.Тип);

		КонецЦикла;

		ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, "НомерСтроки", "СтрокаТаблицы", , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5)));
		ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, "НомерСтроки", "СтрокаТаблицы", , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5)));
		Для каждого ТекРеквизит Из ДополнительныйИсточникДанных.Строки Цикл

			Если ЗначениеЗаполнено(ТекРеквизит.ИмяКолонки) Тогда

				ТипКолонки = Справочники.ДополнительныеИсточникиДанныхДляТиповыхОпераций.ТипЗначенияКолонкиДополнительногоИсточника(МетаданныеДокумента, ТекРеквизит.ИмяИсточника, ТекРеквизит.ИмяКолонки);

				ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, ТекРеквизит.ИмяКолонки, "СтрокаТаблицы", , ТипКолонки);
				ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, ТекРеквизит.ИмяКолонки, "СтрокаТаблицы", , ТипКолонки);

			КонецЕсли;

		КонецЦикла;

		// в дополнительный источник данных добавим колонки из справочника дополнительные колонки
		Для каждого ДопТабличнаяЧасть Из ДополнительныеТабличныеЧасти.Строки Цикл

			Для каждого ДопКолонкаТЧ Из ДопТабличнаяЧасть.Строки Цикл

				ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных, ДопКолонкаТЧ.Имя, "СтрокаТаблицы", , ДопКолонкаТЧ.Тип);
				ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, ДопКолонкаТЧ.Имя, "СтрокаТаблицы", , ДопКолонкаТЧ.Тип);

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

	Если ЗначенияРеквизитовПроводок.Количество() > 0 Тогда
		ТипЗначенияПараметра = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(ЗначенияРеквизитовПроводок[0].Ссылка)));

		Для каждого ТекСтрокаПроводки Из ЗначенияРеквизитовПроводок Цикл

			НовПараметр = СхемаКомпоновки.Параметры.Добавить();
			НовПараметр.Имя = ИмяПараметраПроводка(ТекСтрокаПроводки.Ссылка);
			НовПараметр.ОграничениеИспользования = Истина;
			НовПараметр.ТипЗначения = ТипЗначенияПараметра;
			НовПараметр.Значение = ТекСтрокаПроводки.Ссылка;

		КонецЦикла;
	КонецЕсли;

	Возврат СхемаКомпоновки;

КонецФункции

Функция ИмяПараметраПроводка(Ссылка)

	Возврат "Проводка_"
		+ СтрЗаменить(Строка(Ссылка.УникальныйИдентификатор()), "-", "");

КонецФункции

Процедура ЗаменитьФункциюКЭКПроводки(ОбщиеПараметрыЗаполнения)

	ПроверяемыеФункции = Новый Соответствие;
	ПроверяемыеФункции.Вставить("БУХГАЛТЕРСКИЕОПЕРАЦИИ.КЭКПРОВОДКИ", Новый Массив);
	ПроверяемыеФункции.Вставить("БУХГАЛТЕРСКИЕОПЕРАЦИИ.КЭКПРОВОДКИСВЫБОРОМДТКТ", Новый Массив);
	ПроверяемыеФункции.Вставить("БУХГАЛТЕРСКИЕОПЕРАЦИИ.ДОПУСТИМЫЙКЭКПРОВОДКИ", Новый Массив);

	ПроверяемыеФункции["БУХГАЛТЕРСКИЕОПЕРАЦИИ.КЭКПРОВОДКИ"].Добавить(Новый Структура("Дт, Кт"));
	ПроверяемыеФункции["БУХГАЛТЕРСКИЕОПЕРАЦИИ.КЭКПРОВОДКИСВЫБОРОМДТКТ"].Добавить(Новый Структура("Дт, Кт"));
	ПроверяемыеФункции["БУХГАЛТЕРСКИЕОПЕРАЦИИ.КЭКПРОВОДКИСВЫБОРОМДТКТ"].Добавить(Новый Структура("Дт, Кт"));
	ПроверяемыеФункции["БУХГАЛТЕРСКИЕОПЕРАЦИИ.ДОПУСТИМЫЙКЭКПРОВОДКИ"].Добавить(Неопределено);
	ПроверяемыеФункции["БУХГАЛТЕРСКИЕОПЕРАЦИИ.ДОПУСТИМЫЙКЭКПРОВОДКИ"].Добавить(Новый Структура("Дт, Кт"));

	ДопустимыеЗначенияСтроковогоРеквизита = Новый Структура("Дт, Кт", Новый Структура("Счет, Субконто1, Субконто2, Субконто3", "СчетДт", "СубконтоДт1", "СубконтоДт2", "СубконтоДт3"), Новый Структура("Счет, Субконто1, Субконто2, Субконто3", "СчетКт", "СубконтоКт1", "СубконтоКт2", "СубконтоКт3"));
	Для каждого ИмяРеквизита Из ОбщегоНазначенияКлиентСервер.СвернутьМассив(ОбщиеПараметрыЗаполнения.РеквизитыКЭКПроводки) Цикл

		ПроверяемыеИмена = Новый Массив;
		ПроверяемыеИмена.Добавить(ИмяРеквизита);
		ПроверяемыеИмена.Добавить(ИмяРеквизита + "БезМакроса");

		Для Каждого ШаблонФункции Из ПроверяемыеФункции Цикл

			Для Каждого ПроверяемоеИмя Из ПроверяемыеИмена Цикл

				ТекстФормулы = ОбщиеПараметрыЗаполнения.НастройкаНовойПроводки[ПроверяемоеИмя];
				СборкаСтроки = Новый Массив;
				ДлинаФормулы = СтрДлина(ТекстФормулы);
				ИндексВхождения = 1;

				ИндексПараметров = ИндексНачалаПараметровФункции(ТекстФормулы, ДлинаФормулы, ШаблонФункции.Ключ, ИндексВхождения);

				Пока ИндексПараметров > 0 Цикл

				// Добавить часть формулы до параметров
					СборкаСтроки.Добавить(Сред(ТекстФормулы, ИндексВхождения, ИндексПараметров
						- ИндексВхождения));

						// Определить параметры функции
					ПроверяемыйИндекс = ИндексПараметров;

					ПараметрыФункции = ПрочитатьПараметрыФункции(ТекстФормулы, ДлинаФормулы, ПроверяемыйИндекс);

					СборкаСтроки.Добавить(ПараметрыФункции);

					ИндексВхождения = ПроверяемыйИндекс;
					ИндексПараметров = ИндексНачалаПараметровФункции(ТекстФормулы, ДлинаФормулы, ШаблонФункции.Ключ, ИндексВхождения);

				КонецЦикла;

				СборкаСтроки.Добавить(Сред(ТекстФормулы, ИндексВхождения, СтрДлина(ТекстФормулы)
					- ИндексВхождения + 1));

					// Проверка параметров и сборка новой функции
				Индекс = 2;
				КоличествоСтрок = СборкаСтроки.Количество();
				Пока Индекс < КоличествоСтрок Цикл

					ПараметрыФункции = СборкаСтроки[Индекс - 1];
					Если ТипЗнч(ПараметрыФункции) <> Тип("Массив")
							ИЛИ ПараметрыФункции.Количество() = 0 Тогда
						ВызватьИсключение СтрШаблон(НСтр("ru = 'В функции %1 не определены параметры'"), ШаблонФункции.Ключ);
					КонецЕсли;

					СторонаПроводки = ПараметрыФункции[0];
					ИменаСубконто = Неопределено;
					Если НЕ ДопустимыеЗначенияСтроковогоРеквизита.Свойство(СтрЗаменить(СторонаПроводки, """", ""), ИменаСубконто) Тогда
						ВызватьИсключение СтрШаблон(НСтр("ru = 'В функции КЭКПроводки необходимо указать сторону проводки ""Дт"" или ""Кт"".
							|В поле ""%1"" в функции %2 установлено значение аргумента 1:
							|%3'"), ИмяРеквизита, ШаблонФункции.Ключ, СторонаПроводки);
					КонецЕсли;
					НовыеПараметры = Новый Массив;
					ТекстФормулы = СтрШаблон("%1, %2, %3, %4, %5, %6, %7, %8, %9", ОбщиеПараметрыЗаполнения.НастройкаНовойПроводки["ОрганизацияБезМакроса"], ОбщиеПараметрыЗаполнения.НастройкаНовойПроводки["ИФОБезМакроса"], ОбщиеПараметрыЗаполнения.НастройкаНовойПроводки["КФОБезМакроса"], ОбщиеПараметрыЗаполнения.НастройкаНовойПроводки["Период"], ОбщиеПараметрыЗаполнения.НастройкаНовойПроводки[ИменаСубконто.Счет
						+ "БезМакроса"], ОбщиеПараметрыЗаполнения.НастройкаНовойПроводки[ИменаСубконто.Субконто1
						+ "БезМакроса"], ОбщиеПараметрыЗаполнения.НастройкаНовойПроводки[ИменаСубконто.Субконто2
						+ "БезМакроса"], ОбщиеПараметрыЗаполнения.НастройкаНовойПроводки[ИменаСубконто.Субконто3
						+ "БезМакроса"], ?(ШаблонФункции.Ключ = "БУХГАЛТЕРСКИЕОПЕРАЦИИ.КЭКПРОВОДКИСВЫБОРОМДТКТ", ПараметрыФункции[1], СторонаПроводки));
					НовыеПараметры.Добавить(ТекстФормулы);
					Если ШаблонФункции.Ключ <> "БУХГАЛТЕРСКИЕОПЕРАЦИИ.КЭКПРОВОДКИСВЫБОРОМДТКТ" Тогда
						Для ИндексПараметра = 1 По ПараметрыФункции.ВГраница() Цикл

							НовыеПараметры.Добавить(ПараметрыФункции[ИндексПараметра]);

						КонецЦикла;
					КонецЕсли;

					ДополнитьИспользуемыеРеквизиты(ОбщиеПараметрыЗаполнения, ИмяРеквизита, ИменаСубконто);

					СборкаСтроки[Индекс - 1] = СтрСоединить(НовыеПараметры, ",");
					Индекс = Индекс + 2;
				КонецЦикла;

				ОбщиеПараметрыЗаполнения.НастройкаНовойПроводки[ПроверяемоеИмя] = СтрСоединить(СборкаСтроки);

			КонецЦикла;
		КонецЦикла;

		//ТекстФормулы = ОбщиеПараметрыЗаполнения.НастройкаНовойПроводки[ИмяРеквизита];
