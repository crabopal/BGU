Функция ПолучитьТаблицуДляЗаписиЗначенийДополнительныхКолонок()

	ТаблицаДвижений = РегистрыСведений.ЗначенияКолонокДополнительныхТабличныхЧастей.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	ТаблицаДвижений.Колонки.Добавить("НаименованиеКолонки"); // используется при записи версий объектов
	ТаблицаДвижений.Колонки.Добавить("ИмяКолонкиТабличнойЧасти");
	Возврат ТаблицаДвижений;

КонецФункции

Функция НастройкаДополнительныхТабЧастей(Идентификатор)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Т.Владелец.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
		|	Т.Владелец КАК ТабличнаяЧасть,
		|	Т.ИмяКолонки КАК ИмяРеквизита,
		|	Т.Ссылка КАК СсылкаРеквизита,
		|	Т.ОписаниеТипаКолонки.ТипЗначения КАК ТипЗначения
		|ИЗ
		|	Справочник.КолонкиДополнительныхТабличныхЧастей КАК Т
		|ГДЕ
		|	НЕ Т.ЭтоГруппа
		|	И Т.Владелец.ИдентификаторДокумента = &ИдентификаторДокумента
		|	И НЕ Т.ПометкаУдаления
		|	И НЕ Т.Владелец.ПометкаУдаления
		|ИТОГИ ПО
		|	ТабличнаяЧасть";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", Идентификатор);

	Результат = Новый Соответствие;
	ВыборкаТЧ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаТЧ.Следующий() Цикл

		МассивРеквизитов = Новый Соответствие;
		Выборка = ВыборкаТЧ.Выбрать();
		Пока Выборка.Следующий() Цикл

			МассивРеквизитов.Вставить(Выборка.СсылкаРеквизита, Новый Структура("ИмяРеквизита, ТипЗначения", Выборка.ИмяРеквизита, Выборка.ТипЗначения))
		КонецЦикла;

		Результат.Вставить(ВыборкаТЧ.ИмяТабличнойЧасти, Новый Структура("СсылкаТабличнойЧасти, Реквизиты", ВыборкаТЧ.ТабличнаяЧасть, МассивРеквизитов));

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьЗначенияДополнительныхТабличныхЧастейИзФормы(Форма)

	Объект = Форма.Объект;
	Идентификатор = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.Ссылка));

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	КолонкиТабличныхЧастей.Владелец.ИмяТабличнойЧасти КАК ИмяТаблицы,
		|	КолонкиТабличныхЧастей.Владелец.ПредопределеннаяТабличнаяЧасть КАК ПредопределеннаяТабличнаяЧасть,
		|	КолонкиТабличныхЧастей.ИмяКолонки КАК ИмяРеквизита,
		|	КолонкиТабличныхЧастей.Наименование КАК НаименованиеКолонки,
		|	КолонкиТабличныхЧастей.ОписаниеТипаКолонки.ТипЗначения КАК ТипЗначенияНастройки,
		|	КолонкиТабличныхЧастей.Владелец КАК ТабличнаяЧасть,
		|	КолонкиТабличныхЧастей.Ссылка КАК Реквизит
		|ИЗ
		|	Справочник.КолонкиДополнительныхТабличныхЧастей КАК КолонкиТабличныхЧастей
		|ГДЕ
		|	КолонкиТабличныхЧастей.Владелец.ИдентификаторДокумента = &ИдентификаторДокумента
		|	И НЕ КолонкиТабличныхЧастей.Владелец.ПометкаУдаления
		|	И НЕ КолонкиТабличныхЧастей.ПометкаУдаления
		|	И НЕ КолонкиТабличныхЧастей.ЭтоГруппа
		|ИТОГИ ПО
		|	ТабличнаяЧасть";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", Идентификатор);

	ТаблицаДвижений = ПолучитьТаблицуДляЗаписиЗначенийДополнительныхКолонок();

	ОписаниеТипов = Новый Соответствие;
	ДобавленныеРеквизиты = Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"];

	ВыборкаТЧ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаТЧ.Следующий() Цикл

		ВыборкаКолонок = ВыборкаТЧ.Выбрать();
		Пока ВыборкаКолонок.Следующий() Цикл

			ОписаниеРеквизита = ДобавленныеРеквизиты.НайтиСтроки(Новый Структура("ИмяТаблицы, ИмяДляФормулы", ВыборкаКолонок.ИмяТаблицы, ВыборкаКолонок.ИмяРеквизита));

			Если ОписаниеРеквизита.Количество() = 0 Тогда
			// такой реквизит не найден
				Продолжить;
			КонецЕсли;

			СоставнойТип = ОписаниеТипов.Получить(ВыборкаКолонок.Реквизит);
			Если СоставнойТип = Неопределено Тогда
				ОписаниеТипов.Вставить(ВыборкаКолонок.Реквизит, ВыборкаКолонок.ТипЗначенияНастройки.Типы().Количество() > 1);
				СоставнойТип = ОписаниеТипов.Получить(ВыборкаКолонок.Реквизит);
			КонецЕсли;

			Если ВыборкаТЧ.ПредопределеннаяТабличнаяЧасть Тогда

				Для каждого СтрокаТЧ Из Объект[ВыборкаТЧ.ИмяТаблицы] Цикл

					Если СоставнойТип
							ИЛИ ЗначениеЗаполнено(СтрокаТЧ[ОписаниеРеквизита[0].ИмяРеквизита]) Тогда

						Движение = ТаблицаДвижений.Добавить();
						Движение.ТабличнаяЧасть = ВыборкаТЧ.ТабличнаяЧасть;
						Движение.КолонкаТабличнойЧасти = ВыборкаКолонок.Реквизит;
						Движение.НомерСтрокиДокумента = СтрокаТЧ.НомерСтроки;
						Движение.Значение = СтрокаТЧ[ОписаниеРеквизита[0].ИмяРеквизита];
						Движение.НаименованиеКолонки = ВыборкаКолонок.НаименованиеКолонки;

					КонецЕсли;

				КонецЦикла;

			Иначе

				ОписаниеТЧ = ДобавленныеРеквизиты.НайтиСтроки(Новый Структура("ИмяДляФормулы, ИмяТаблицы", ВыборкаТЧ.ИмяТаблицы, ""));
				Если ОписаниеТЧ.Количество() > 0 Тогда
					ИмяТаблицы = ОписаниеТЧ[0].ИмяРеквизита;
				Иначе
					ИмяТаблицы = ВыборкаТЧ.ИмяТаблицы;
				КонецЕсли;

				НомерСтроки = 0;
				Для каждого СтрокаТЧ Из Форма[ИмяТаблицы] Цикл
					НомерСтроки = НомерСтроки + 1;

					Если СоставнойТип
							ИЛИ ЗначениеЗаполнено(СтрокаТЧ[ОписаниеРеквизита[0].ИмяРеквизита]) Тогда
							// в базу записываются только заполненные значения
						Движение = ТаблицаДвижений.Добавить();
						Движение.ТабличнаяЧасть = ВыборкаТЧ.ТабличнаяЧасть;
						Движение.КолонкаТабличнойЧасти = ВыборкаКолонок.Реквизит;
						Движение.НомерСтрокиДокумента = НомерСтроки;
						Движение.Значение = СтрокаТЧ[ОписаниеРеквизита[0].ИмяРеквизита];
						Движение.НаименованиеКолонки = ВыборкаКолонок.НаименованиеКолонки;

					КонецЕсли;

				КонецЦикла;

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Возврат ТаблицаДвижений;

КонецФункции

Функция ПолучитьСохраненныеЗначенияДополнительныхТабличныхЧастей(ТекущийОбъект)

	Ссылка = ТекущийОбъект.Ссылка;
	Если Ссылка.Пустая() Тогда
		Возврат ПолучитьТаблицуДляЗаписиЗначенийДополнительныхКолонок();
	КонецЕсли;

	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Ссылка));
	Если НЕ БухгалтерскиеОперацииПовтИспНаВремяСеанса.ПараметрыИспользованияОперацийИДопРеквизитов(ИдентификаторДокумента).ТабличныеЧасти Тогда

		Возврат ПолучитьТаблицуДляЗаписиЗначенийДополнительныхКолонок();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	ЗначенияКолонокДополнительныхТабличныхЧастей.ТабличнаяЧасть,
		|	ЗначенияКолонокДополнительныхТабличныхЧастей.КолонкаТабличнойЧасти,
		|	ЗначенияКолонокДополнительныхТабличныхЧастей.КолонкаТабличнойЧасти.Наименование КАК НаименованиеКолонки,
		|	ЗначенияКолонокДополнительныхТабличныхЧастей.НомерСтрокиДокумента,
		|	ЗначенияКолонокДополнительныхТабличныхЧастей.Значение,
		|	ЗначенияКолонокДополнительныхТабличныхЧастей.КолонкаТабличнойЧасти.ИмяКолонки КАК ИмяКолонкиТабличнойЧасти
		|ИЗ
		|	РегистрСведений.ЗначенияКолонокДополнительныхТабличныхЧастей КАК ЗначенияКолонокДополнительныхТабличныхЧастей
		|ГДЕ
		|	ЗначенияКолонокДополнительныхТабличныхЧастей.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Ссылка);

	УстановитьПривилегированныйРежим(Истина);
	СохраненныеЗначения = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СохраненныеЗначения;

КонецФункции

#КонецОбласти

#Область УправляемыеБлокировки

// Функция создает таблицу значений, каждая колонка которой - блокируемое поле журнала проводок
// Колонки содержат блокируемые значения.
// Пустые значения в колонке заполняются соответствующими значениями из первой строки таблицы.
// Параметры:
// ТаблицаПроводок - ТаблицаЗначений - Таблица проводок, которую будем записывать в регистр.
//
// Возвращаемое значение:
// ТаблицаЗначений - источник данных для объекта блокировка данных
//
Функция СобратьТаблицуБлокировок(ТаблицаПроводок)

	ТаблицаБлокировок = Новый ТаблицаЗначений;
	ТаблицаБлокировок.Колонки.Добавить("Период");
	ТаблицаБлокировок.Колонки.Добавить("Организация");

	Если ТаблицаПроводок.Количество() = 0 Тогда
		Возврат ТаблицаБлокировок;
	КонецЕсли;

	Период = ТаблицаПроводок[0].Период;
	Организация = ТаблицаПроводок[0].Организация;

	ИФО = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ИФО, ТаблицаПроводок.ВыгрузитьКолонку("ИФО"), ИСТИНА);

	КФО = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КФО, ТаблицаПроводок.ВыгрузитьКолонку("КФО"), ИСТИНА);

	ЖурналОпераций = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЖурналОпераций, ТаблицаПроводок.ВыгрузитьКолонку("ЖурналОпераций"), ИСТИНА);

	Счет = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Счет, ТаблицаПроводок.ВыгрузитьКолонку("СчетДт"), ИСТИНА);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Счет, ТаблицаПроводок.ВыгрузитьКолонку("СчетКт"), ИСТИНА);

	Субконто1 = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Субконто1, ТаблицаПроводок.ВыгрузитьКолонку("СубконтоДт1"), ИСТИНА);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Субконто1, ТаблицаПроводок.ВыгрузитьКолонку("СубконтоКт1"), ИСТИНА);

	Субконто2 = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Субконто2, ТаблицаПроводок.ВыгрузитьКолонку("СубконтоДт2"), ИСТИНА);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Субконто2, ТаблицаПроводок.ВыгрузитьКолонку("СубконтоКт2"), ИСТИНА);

	Субконто3 = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Субконто3, ТаблицаПроводок.ВыгрузитьКолонку("СубконтоДт3"), ИСТИНА);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Субконто3, ТаблицаПроводок.ВыгрузитьКолонку("СубконтоКт3"), ИСТИНА);

	КоличествоСтрок = 0;

	Если ИФО.Количество() > 0 Тогда
		ТаблицаБлокировок.Колонки.Добавить("ИФО");
		КоличествоСтрок = Макс(КоличествоСтрок, ИФО.Количество());
	КонецЕсли;

	Если КФО.Количество() > 0 Тогда
		ТаблицаБлокировок.Колонки.Добавить("КФО");
		КоличествоСтрок = Макс(КоличествоСтрок, КФО.Количество());
	КонецЕсли;

	Если ЖурналОпераций.Количество() > 0 Тогда
		ТаблицаБлокировок.Колонки.Добавить("ЖурналОпераций");
		КоличествоСтрок = Макс(КоличествоСтрок, ЖурналОпераций.Количество());
	КонецЕсли;

	Если Счет.Количество() > 0 Тогда
		ТаблицаБлокировок.Колонки.Добавить("Счет");
		КоличествоСтрок = Макс(КоличествоСтрок, Счет.Количество());
	КонецЕсли;

	Если Субконто1.Количество() > 0 Тогда
		ТаблицаБлокировок.Колонки.Добавить("Субконто1");
		КоличествоСтрок = Макс(КоличествоСтрок, Субконто1.Количество());
	КонецЕсли;

	Если Субконто2.Количество() > 0 Тогда
		ТаблицаБлокировок.Колонки.Добавить("Субконто2");
		КоличествоСтрок = Макс(КоличествоСтрок, Субконто2.Количество());
	КонецЕсли;

	Если Субконто3.Количество() > 0 Тогда
		ТаблицаБлокировок.Колонки.Добавить("Субконто3");
		КоличествоСтрок = Макс(КоличествоСтрок, Субконто3.Количество());
	КонецЕсли;

	Для Счетчик = 1 по КоличествоСтрок Цикл
		ТаблицаБлокировок.Добавить();
	КонецЦикла;

	ТаблицаБлокировок.ЗаполнитьЗначения(Период, "Период");
	ТаблицаБлокировок.ЗаполнитьЗначения(Организация, "Организация");
	Если ИФО.Количество() > 0 Тогда
		ТаблицаБлокировок.ЗагрузитьКолонку(ИФО, "ИФО");
	КонецЕсли;
	Если КФО.Количество() > 0 Тогда
		ТаблицаБлокировок.ЗагрузитьКолонку(КФО, "КФО");
	КонецЕсли;
	Если ЖурналОпераций.Количество() > 0 Тогда
		ТаблицаБлокировок.ЗагрузитьКолонку(ЖурналОпераций, "ЖурналОпераций");
	КонецЕсли;
	Если Счет.Количество() > 0 Тогда
		ТаблицаБлокировок.ЗагрузитьКолонку(Счет, "Счет");
	КонецЕсли;
	Если Субконто1.Количество() > 0 Тогда
		ТаблицаБлокировок.ЗагрузитьКолонку(Субконто1, "Субконто1");
	КонецЕсли;
	Если Субконто2.Количество() > 0 Тогда
		ТаблицаБлокировок.ЗагрузитьКолонку(Субконто2, "Субконто2");
	КонецЕсли;
	Если Субконто3.Количество() > 0 Тогда
		ТаблицаБлокировок.ЗагрузитьКолонку(Субконто3, "Субконто3");
	КонецЕсли;

	// заполним все колонки непустыми значениями
	НепустаяТаблица = ТаблицаБлокировок.СкопироватьКолонки();
	ЗаполнитьЗначенияСвойств(НепустаяТаблица.Добавить(), ТаблицаБлокировок[0]);
	НепустаяСтрока = НепустаяТаблица[0];

	Для каждого ТекБлокировка Из ТаблицаБлокировок Цикл

		Для каждого ТекКолонка Из ТаблицаБлокировок.Колонки Цикл

			Если НЕ ЗначениеЗаполнено(ТекБлокировка[ТекКолонка.Имя]) Тогда
				ТекБлокировка[ТекКолонка.Имя] = НепустаяСтрока[ТекКолонка.Имя];
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Возврат ТаблицаБлокировок;

КонецФункции

#КонецОбласти

