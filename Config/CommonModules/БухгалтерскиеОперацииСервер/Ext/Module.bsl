	ПолеСумма = ВычисляемыеПоля.Найти("СуммаНеУчитываетсяНУ");
	ПолеСумма.Выражение = "ВЫРАЗИТЬ(" + ПолеСумма.Выражение
		+ ", ""ЧИСЛО(18,2)"")";
	ПолеСумма = ВычисляемыеПоля.Найти("СуммаНДС");
	ПолеСумма.Выражение = "ВЫРАЗИТЬ(" + ПолеСумма.Выражение
		+ ", ""ЧИСЛО(18,2)"")";
КонецПроцедуры

Процедура СформироватьТекстВычисляемогоПоля(НастройкаПроводок,
		ВычисляемыеПоля, ИмяПоля, ТипВыражения = Неопределено)

	ВременнаяТаблица1 = НастройкаПроводок.Скопировать(, "ТекущаяПроводка, КодПроводки,"
		+ ИмяПоля);
	ВременнаяТаблица2 = ВременнаяТаблица1.Скопировать();
	ВременнаяТаблица2.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ВременнаяТаблица2.ЗаполнитьЗначения(1, "Количество");
	ВременнаяТаблица2.Свернуть(ИмяПоля, "Количество");

	ТекущееВычисляемоеПоле = ВычисляемыеПоля.Найти(ИмяПоля);
	ВыражениеВычисляемогоПоля = "";
	Если ВременнаяТаблица2.Количество() = 1 Тогда
		ВыражениеВычисляемогоПоля = ВременнаяТаблица2[0][ИмяПоля];
	Иначе
		ЗначениеПоУмолчанию = ТекущееВычисляемоеПоле.Выражение;
		Если ПустаяСтрока(ЗначениеПоУмолчанию) Тогда
			ЗначениеПоУмолчанию = "NULL";
		КонецЕсли;
		ВременнаяТаблица2.Сортировать("Количество");
		ВыражениеВычисляемогоПоля = "Выбор";
		Индекс = 0;
		КоличествоСтрок = ВременнаяТаблица2.Количество();
		Для каждого ТекСтрокаФормулы Из ВременнаяТаблица2 Цикл
			Индекс = Индекс + 1;
			Если Индекс = КоличествоСтрок Тогда
				ВыражениеВычисляемогоПоля = ВыражениеВычисляемогоПоля + "
					|Иначе ";
			Иначе
				ВыражениеВычисляемогоПоля = ВыражениеВычисляемогоПоля + "
					|Когда";
				МассивПроводок = ВременнаяТаблица1.НайтиСтроки(Новый Структура(ИмяПоля, ТекСтрокаФормулы[ИмяПоля]));
				ПерваяПроводка = Истина;
				Для каждого ТекущаяОбрабатываемаяПроводка Из МассивПроводок Цикл
					Если ПерваяПроводка Тогда
						ПерваяПроводка = Ложь;
					Иначе
						ВыражениеВычисляемогоПоля = ВыражениеВычисляемогоПоля + "
							|ИЛИ";
					КонецЕсли;
					ВыражениеВычисляемогоПоля = ВыражениеВычисляемогоПоля
						+ " НастройкаПроводок.ТекущаяПроводка = &"
						+ ТекущаяОбрабатываемаяПроводка.КодПроводки;
				КонецЦикла;
				ВыражениеВычисляемогоПоля = ВыражениеВычисляемогоПоля + "
					|Тогда ";
			КонецЕсли;
			Если ПустаяСтрока(ТекСтрокаФормулы[ИмяПоля]) Тогда
				ВыражениеВычисляемогоПоля = ВыражениеВычисляемогоПоля
					+ ЗначениеПоУмолчанию;
			Иначе
				ВыражениеВычисляемогоПоля = ВыражениеВычисляемогоПоля
					+ ТекСтрокаФормулы[ИмяПоля];
			КонецЕсли;

		КонецЦикла;
		ВыражениеВычисляемогоПоля = ВыражениеВычисляемогоПоля + "
			|Конец";
	КонецЕсли;
	Если ТипВыражения <> Неопределено Тогда
		ТекущееВычисляемоеПоле.Выражение = "ВЫРАЗИТЬ(" + ВыражениеВычисляемогоПоля
			+ ", """ + ТипВыражения + """)";
	Иначе
		ТекущееВычисляемоеПоле.Выражение = ВыражениеВычисляемогоПоля;
	КонецЕсли;

КонецПроцедуры

Функция ДоработатьФормулуУточненияПериода(ВыражениеПериод, ВыражениеИстина, ВыражениеЛожь)

	Возврат СтрШаблон("ВЫБОР
		|	КОГДА %1 = КОНЕЦПЕРИОДА(%1, ""ДЕНЬ"")
		|		ТОГДА %2
		|	ИНАЧЕ %3
		|КОНЕЦ", ВыражениеПериод, ВыражениеИстина, ВыражениеЛожь);


КонецФункции

Процедура ДополнитьСписокТиповЗначенийСубконто(ВычисляемыеПоля)

	МассивИменПолей = Новый Массив;
	МассивИменПолей.Добавить("СубконтоКт1");
	МассивИменПолей.Добавить("СубконтоКт2");
	МассивИменПолей.Добавить("СубконтоКт3");
	МассивИменПолей.Добавить("СубконтоДт1");
	МассивИменПолей.Добавить("СубконтоДт2");
	МассивИменПолей.Добавить("СубконтоДт3");
	МассивИменПолей.Добавить("ХарактеристикаДвиженияКт");
	МассивИменПолей.Добавить("ХарактеристикаДвиженияДт");

	ФиктивноеУсловие = "";
	СписокТиповСубконто = БухгалтерскиеОперацииПовтИсп.СписокТиповСубконто();
	Для каждого ТекТипСубконто Из СписокТиповСубконто Цикл
		ФиктивноеУсловие = ФиктивноеУсловие + "
			|КОГДА ЛОЖЬ ТОГДА ЗНАЧЕНИЕ(" + ВРЕГ(ТекТипСубконто.Представление)
			+ ".ПУСТАЯССЫЛКА)";
	КонецЦикла;
	ФиктивноеУсловие = ФиктивноеУсловие + "
		|ИНАЧЕ NULL КОНЕЦ";

	Для каждого ИмяПоля Из МассивИменПолей Цикл

		ПолеСубконто = ВычисляемыеПоля.Найти(ИмяПоля);
		ПолеСубконто.Выражение = "ВЫБОР 
			|КОГДА ИСТИНА
			|ТОГДА " + ПолеСубконто.Выражение + ФиктивноеУсловие;

	КонецЦикла;

КонецПроцедуры

