Функция ОтобратьПодчиненныеСтроки(Таблица, ИмяТЧ, ИдентификаторСтроки,
		НомерСтроки) Экспорт

	Результат = Таблица.СкопироватьКолонки();
	СтрПоиска = ИдентификаторСтроки
		+ ?(ЗначениеЗаполнено(ИдентификаторСтроки), ".", "")
		+ Формат(НомерСтроки, "ЧГ=");
	ДлинаСтроки = СтрДлина(СтрПоиска);

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.СлужебноеПоле_Путь = ИмяТЧ
				И Сред(СтрокаТаблицы.СлужебноеПоле_НомераСтрокПути, 1, ДлинаСтроки) = СтрПоиска Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;

	Результат.Сортировать("СлужебноеПоле_Путь, СлужебноеПоле_НомераСтрокПути, СлужебноеПоле_НомерСтрокиПоля");

	Результат.Колонки.Удалить("СлужебноеПоле_Путь");
	Результат.Колонки.Удалить("СлужебноеПоле_НомераСтрокПути");
	Результат.Колонки.Удалить("СлужебноеПоле_НомерСтрокиПоля");

	Возврат Результат;

КонецФункции

Функция СоединитьСтроки(Таблица, Разделитель = "; ") Экспорт

	Результат = Новый Массив;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значение = СтрокаТаблицы[Колонка.Имя];
			Если ЗначениеЗаполнено(Значение) Тогда
				Результат.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Результат = СтрСоединить(Результат, Разделитель);

	Возврат Результат;

КонецФункции

Функция СчетЭлемент27()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код = &Код
	|	И ЕПСБУ.ДатаНачалаДействия = ДатаВремя(1,1,1)
	|	И ЕПСБУ.ДатаОкончанияДействия = &ДатаОкончанияДействия
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|	И НЕ ЕПСБУ.ПометкаУдаления";
	Запрос.УстановитьПараметр("Код", "27");
	Запрос.УстановитьПараметр("ДатаОкончанияДействия", Дата('20201231'));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла;
	
	Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();

