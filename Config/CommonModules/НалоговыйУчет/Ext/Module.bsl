		|	ЕПСБУОстаткиИОбороты.СуммаКонечныйОстатокДт КАК СуммаКонечныйОстатокДт
		|ПОМЕСТИТЬ ОстаткиРБП
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
		|			&ДатаНач,
		|			&ДатаКон,
		|			Период,
		|			,
		|			Счет В (&СчетаРБП),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.РасходыБудущихПериодов),
		|			Организация В (&СписокОрганизаций)
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						УбыткиПрошлыхЛет.Ссылка
		|					ИЗ
		|						УбыткиПрошлыхЛет)) КАК ЕПСБУОстаткиИОбороты
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Субконто1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиРБП.Субконто1 КАК Субконто1,
		|	СУММА(ОстаткиРБП.СуммаНачальныйОстатокДт) КАК СуммаНачальныйОстатокДт,
		|	СУММА(ОстаткиРБП.СуммаКонечныйОстатокДт) КАК СуммаКонечныйОстатокДт,
		|	СУММА(ЕСТЬNULL(СписаниеРБП.СуммаОборотКт, 0)) КАК КО
		|ИЗ
		|	ОстаткиРБП КАК ОстаткиРБП
		|		ЛЕВОЕ СОЕДИНЕНИЕ СписаниеРБП КАК СписаниеРБП
		|		ПО ОстаткиРБП.Субконто1 = СписаниеРБП.Субконто1
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиРБП.Субконто1";
		УбыткиПрошлыхЛет = Запрос.Выполнить().Выгрузить();
		
		ТаблицаУбытков = Новый ТаблицаЗначений;
		ТаблицаУбытков.Колонки.Добавить("ГодУбыткаПредставление", Новый ОписаниеТипов("Строка"));
		ТаблицаУбытков.Колонки.Добавить("ГодУбытка", Новый ОписаниеТипов("Число"));
		ТаблицаУбытков.Колонки.Добавить("Сумма",     Новый ОписаниеТипов("Число"));
		ТаблицаУбытков.Колонки.Добавить("Остаток",   Новый ОписаниеТипов("Число"));
		ТаблицаУбытков.Колонки.Добавить("РБП",       Новый ОписаниеТипов("СправочникСсылка.РасходыБудущихПериодов"));
		
		ПоследнийГод = Год(ПараметрыОтчета.мДатаКонцаПериодаОтчета) - 1;
		СчетчикГодов = ПоследнийГод;
		
		Пока СчетчикГодов > ПоследнийГод - 10 Цикл
			СтрокаТаблицаУбытков = ТаблицаУбытков.Добавить();
			СтрокаТаблицаУбытков.ГодУбытка = СчетчикГодов;
			СчетчикГодов = СчетчикГодов - 1;
		КонецЦикла;
		
		Для Каждого УбытокПрошлыхЛет Из УбыткиПрошлыхЛет Цикл
			
			ГодУбытка = Год(УбытокПрошлыхЛет.Субконто1.ДатаНачалаСписания) - 1;
			
			СтрокаТаблицаУбытков = ТаблицаУбытков.Найти(ГодУбытка, "ГодУбытка");
			Если СтрокаТаблицаУбытков = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТаблицаУбытков.ГодУбыткаПредставление = СтрЗаменить(Строка(СтрокаТаблицаУбытков.ГодУбытка)," ", "");
			СтрокаТаблицаУбытков.Сумма   = УбытокПрошлыхЛет.СуммаНачальныйОстатокДт;
			СтрокаТаблицаУбытков.Остаток = УбытокПрошлыхЛет.СуммаКонечныйОстатокДт;
			СтрокаТаблицаУбытков.РБП     = УбытокПрошлыхЛет.Субконто1;
		
		КонецЦикла;
		
		ТаблицаУбытков.Сортировать("ГодУбытка Возр");
		
		// Инициализация многосрочной части Прил. 4 к Листу 02.
		МнЧастьЛист02_4 = Контейнер.Лист02.Строки[0].Строки[3].Строки[0].ДанныеМногострочныхЧастей.П00024М1.Строки;
		МнЧастьЛист02_4.Очистить();
		ДобавитьСтрокуПрил4Листа2(МнЧастьЛист02_4, 1);
		
		// Заполнение многосрочной части Прил. 4 к Листу 02.
		СчСтрок = 1;
		Для Каждого СтрокаТаблицаУбытков Из ТаблицаУбытков Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицаУбытков.ГодУбыткаПредставление) Тогда
				Продолжить;
			КонецЕсли;
			
			НомСтроки = Формат(СчСтрок, "ЧН=; ЧГ=");
			
			струкНаборДанных = Новый Структура;
			струкНаборДанных.Вставить("НомерСтроки", СчСтрок);
			струкНаборДанных.Вставить("П00024М100001", СтрокаТаблицаУбытков.ГодУбыткаПредставление);
			струкНаборДанных.Вставить("П00024М100003", СтрокаТаблицаУбытков.Сумма);
			
			УстановитьЗначениеПоказателя(ПараметрыОтчета, Контейнер, "П00024М100001", , струкНаборДанных);
			
			ОтборПоРБП = Новый Структура;
			ОтборПоРБП.Вставить("Субконто1", СтрокаТаблицаУбытков.РБП);
			
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
				"П00024М100003_" + НомСтроки, "Сумма убытка, полученного в " + СтрокаТаблицаУбытков.ГодУбыткаПредставление + " году",
				"+", "!СНД"+"Н97", СтрокаТаблицаУбытков.Сумма, "Лист02_4",
				НастройкиОСВПоСчету(ОбщиеПараметрыРасшифровки, "Н97", ОтборПоРБП));
			
			СчСтрок = СчСтрок + 1;
			
		КонецЦикла;
		
		// Строка 150 - Сумма убытка или части убытка, уменьшающего налоговую базу за отчетный (налоговый) период.
		СуммаПоСтроке050Листа02 = 0;
		СуммаПоСтроке140Листа02 = 0;
		СуммаПоСтроке120Листа05 = 0;
		СуммаПоСтроке120Листа06 = 0;
		СуммаПоСтроке230Листа07 = 0;
		СуммаПоСтроке110Листа08 = 0;
		СуммаПоСтроке590Листа09 = 0;
		
		П000240015003 = УбыткиПрошлыхЛет.Итог("КО");
		УстановитьЗначениеПоказателя(ПараметрыОтчета, Контейнер, "П000240015003", П000240015003);
		
		ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
			"П000240015003",
			"Сумма убытка или части убытка, уменьшающего налоговую базу за отчетный (налоговый) период",
			"+",
			"!КО"+"Н97",
			П000240015003,
			"Лист02_4",
			НастройкиОСВПоВидуДоходовРасходов(ОбщиеПараметрыРасшифровки, "Н97",
				ВидыСубконто.РасходыБудущихПериодов, Перечисления.ВидыРБП.УбыткиПрошлыхЛет),
			ПараметрыОтчета);
		
		// Строка 160 - сумма неперенесенного убытка.
		П000240016003 = УбыткиПрошлыхЛет.Итог("СуммаКонечныйОстатокДт");
		УстановитьЗначениеПоказателя(ПараметрыОтчета, Контейнер, "П000240016003", П000240016003);
		
		ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
			"П000240016003",
			"Остаток неперенесенного убытка на конец налогового периода - всего",
			"+",
			"!СКД"+"Н97",
			П000240016003,
			"Лист02_4",
			НастройкиОСВПоВидуДоходовРасходов(ОбщиеПараметрыРасшифровки, "Н97",
				ВидыСубконто.РасходыБудущихПериодов, Перечисления.ВидыРБП.УбыткиПрошлыхЛет));
		
	КонецЕсли;
	
	#КонецОбласти
	
	// В современных редакциях формы заполнение отчета выполняется фоновым заданием.
	// Для передачи данных из сеанса фонового задания в сеанс пользователя используются заранее подготовленные адреса хранилища.
	
	ПоместитьВоВременноеХранилище(ТаблицаРасшифровки, ПараметрыОтчета.АдресВременногоХранилищаРасшифровки);
	ПоместитьВоВременноеХранилище(Контейнер,          ПараметрыОтчета.АдресВоВременномХранилище);
	
КонецПроцедуры

