// Возвращает таблицу правил определения прямых расходов НУ для заданного вида затрат.
//
Функция ПравилаОпределенияПрямыхРасходов(ВидЗатрат, Организация, ГодДействия) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КонДата",     КонецГода(ГодДействия));
	
	// Определим период действующих (актуальных) правил.
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Периоды.ПериодДействия КАК ПериодДействия
	|ИЗ
	|	РегистрСведений.МетодыОпределенияПрямыхРасходовПроизводстваВНУ КАК Периоды
	|ГДЕ
	|	Периоды.Организация = &Организация
	|	И Периоды.ПериодДействия <= &КонДата
	|
	|СГРУППИРОВАТЬ ПО
	|	Периоды.ПериодДействия
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПериодДействия УБЫВ";
	
	Периоды = Запрос.Выполнить().Выбрать();
	Если Периоды.Следующий() Тогда
		ДатаДействующихПравил = Периоды.ПериодДействия;
	Иначе
		ДатаДействующихПравил = '00010101';
	КонецЕсли;
	
	// Получим таблицу правил с учетом ограничения по виду затрат.
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Правила.ПериодДействия КАК ПериодДействия,
	|	Правила.Организация КАК Организация,
	|	Правила.ВидРасходовНУ КАК ВидРасходовНУ,
	|	Правила.ВидЗатрат КАК ВидЗатрат,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА Правила.ИФО
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ИФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА Правила.Подразделение
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Подразделение,
	|	Правила.Счет КАК Счет,
	|	Правила.КорСчет КАК КорСчет
	|ИЗ
	|	РегистрСведений.МетодыОпределенияПрямыхРасходовПроизводстваВНУ КАК Правила
	|ГДЕ
	|	&УсловиеВидРасходов
	|	И &УсловиеОрганизация
	|	И &УсловиеПериодДействия";
	
	Запрос.УстановитьПараметр("ДатаДействующихПравил", ДатаДействующихПравил);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОрганизация", "Правила.Организация = &Организация");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОрганизация", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГодДействия) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПериодДействия", "Правила.ПериодДействия = &ДатаДействующихПравил");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПериодДействия", "ИСТИНА");
	КонецЕсли;
	
	// 1. Если есть правила с указанием конкретного вида затрат, то нужны только они.
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&УсловиеВидРасходов",
		"Правила.ВидЗатрат = &ВидЗатрат");
	Запрос.УстановитьПараметр("ВидЗатрат", ВидЗатрат);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Возврат Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	// 2. Если нет правил с указанием конкретного вида затрат, получаем правила для вида расходов НУ в целом.
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&УсловиеВидРасходов",
		"Правила.ВидРасходовНУ = &ВидРасходовНУ И Правила.ВидЗатрат = ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)");
	Запрос.УстановитьПараметр("ВидРасходовНУ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЗатрат, "ВидРасходовНУ"));
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ВедетсяУчетКапВложенийНУПоКПС(Знач НаДату = Неопределено) Экспорт
	
	Возврат БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("Н08", , НаДату).УчетПоКПС;
	
КонецФункции

Функция ВедетсяУчетКапВложенийНУПоЦМО(Знач НаДату = Неопределено) Экспорт
	
	ВедетсяУчетПоЦМО = Ложь;
	СвойстваСчетаН08 = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчет.СчетПоКоду("Н08", НаДату));
	Для НомерСубконто = 1 По СвойстваСчетаН08.КоличествоСубконто Цикл
		Если СвойстваСчетаН08["ВидСубконто" + НомерСубконто] = ПланыВидовХарактеристик.ВидыСубконто.ЦМО
			И СвойстваСчетаН08["ВидСубконто" + НомерСубконто + "ТолькоОбороты"] = Ложь Тогда
			ВедетсяУчетПоЦМО = Истина; // На счете Н08 есть вид субконто "ЦМО" (остатки).
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВедетсяУчетПоЦМО;
	
КонецФункции

Функция ПериодПолученияОстатков(Документ) Экспорт
	
	ДокументСДатойПроведения = Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(Документ.Ссылка));
	ДокументСДатойСписания   = ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ДатаСписанияСБухУчета", Документ.Ссылка.Метаданные());
	Если ДокументСДатойПроведения Тогда
		ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(Документ.Ссылка);
	ИначеЕсли ДокументСДатойСписания Тогда
		ДатаПроведения = Документ.ДатаСписанияСБухУчета;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаПроведения) Тогда
		ПериодОстатков = Новый Граница(ДатаПроведения, ВидГраницы.Исключая);
	Иначе
		Если Документ.Ссылка.Пустая() Тогда
			ПериодОстатков = Новый Граница(КонецДня(Документ.Дата), ВидГраницы.Включая);
		Иначе
			ПериодОстатков = Новый Граница(Документ.Ссылка.МоментВремени(), ВидГраницы.Исключая);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПериодОстатков;
	
КонецФункции

Функция ОпределитьСтоимостьСпискаОС(ОсновныеСредства, ДокументСсылка, ЭтоКапВложение=Ложь, ПериодОстатков=Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	
	Если ЭтоКапВложение Тогда
		
		// Устарела. Следует использовать исотчник данных БухгалтерскиеОперацииИсточникиДанных.СписаниеКапВложенийНУ().
		Запрос.Текст = НалоговыйУчет.ТекстЗапросаСчетаНалоговогоУчетаВложенийОСиНМА() +
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.ОсновноеСредство,
		|	СУММА(ВложенныйЗапрос.СтоимостьНУ) КАК Стоимость,
		|	СУММА(ВложенныйЗапрос.СтоимостьНеУчитываетсяНУ) КАК СтоимостьНеУчитываетсяНУ,
		|	СУММА(ВложенныйЗапрос.СтоимостьЕНВД) КАК СтоимостьЕНВД,
		|	СУММА(ВложенныйЗапрос.Количество) КАК Количество
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
		|		ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СтоимостьНУ,
		|		ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СтоимостьНеУчитываетсяНУ,
		|		ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СтоимостьЕНВД,
		|		0 КАК Количество
		|	ИЗ
		|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|				&МоментВремени,
		|				Счет В
		|					(ВЫБРАТЬ
		|						СчетаНалоговогоУчетаВложенийОСиНМА.Счет
		|					ИЗ
		|						СчетаНалоговогоУчетаВложенийОСиНМА),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|				Организация = &Организация
		|					И КФО = &КФО
		|					И &УсловиеИФО
		|					И Субконто1 В (&СписокОС)) КАК ЖурналПроводокЕПСБУОстатки
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
		|		0,
		|		0,
		|		0,
		|		ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
		|	ИЗ
		|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|				&МоментВремени,
		|				Счет В (&Счет106),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|				Организация = &Организация
		|					И КФО = &КФО
		|					И &УсловиеИФО
		|					И Субконто1 В (&СписокОС)) КАК ЖурналПроводокЕПСБУОстатки) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.ОсновноеСредство";
		
		Запрос.УстановитьПараметр("Счет106", БухгалтерскийУчет.СписокСчетов("106.00"));
		
	Иначе
		
		Запрос.Текст = НалоговыйУчет.ТекстЗапросаСчетаНалоговогоУчетаОСиНМА() +
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.ОсновноеСредство КАК ОсновноеСредство,
		|	СУММА(ВложенныйЗапрос.СтоимостьНУ) КАК ВосстановительнаяСтоимость,
		|	СУММА(ВложенныйЗапрос.СтоимостьНУ) КАК ОстаточнаяСтоимость,
		|	СУММА(ВложенныйЗапрос.СтоимостьНеУчитываетсяНУ) КАК ВосстановительнаяСтоимостьНеУчитываетсяНУ,
		|	СУММА(ВложенныйЗапрос.СтоимостьНеУчитываетсяНУ) КАК ОстаточнаяСтоимостьНеУчитываетсяНУ,
		|	СУММА(ВложенныйЗапрос.СтоимостьЕНВД) КАК ВосстановительнаяСтоимостьЕНВД,
		|	СУММА(ВложенныйЗапрос.СтоимостьЕНВД) КАК ОстаточнаяСтоимостьЕНВД,
		|	СУММА(ВложенныйЗапрос.АмортизацияНУ) КАК СуммаНачисленнойАмортизации,
		|	СУММА(ВложенныйЗапрос.АмортизацияНеУчитываетсяНУ) КАК СуммаНачисленнойАмортизацииНеУчитываетсяНУ,
		|	СУММА(ВложенныйЗапрос.АмортизацияЕНВД) КАК СуммаНачисленнойАмортизацииЕНВД
		|ПОМЕСТИТЬ СписокОС_НУ
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
		|		ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СтоимостьНУ,
		|		ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СтоимостьНеУчитываетсяНУ,
		|		ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СтоимостьЕНВД,
		|		0 КАК АмортизацияНУ,
		|		0 КАК АмортизацияНеУчитываетсяНУ,
		|		0 КАК АмортизацияЕНВД
		|	ИЗ
		|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|				&МоментВремени,
		|				Счет В
		|					(ВЫБРАТЬ
		|						СчетаНалоговогоУчетаОС.Счет
		|					ИЗ
		|						СчетаНалоговогоУчетаОС
		|				
		|					ОБЪЕДИНИТЬ ВСЕ
		|				
		|					ВЫБРАТЬ
		|						СчетаНалоговогоУчетаНМА.Счет
		|					ИЗ
		|						СчетаНалоговогоУчетаНМА),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|				Организация = &Организация
		|					И КФО В (&КФО)
		|					И &УсловиеИФО
		|					И Субконто1 В (&СписокОС)) КАК ЖурналПроводокЕПСБУОстатки
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
		|		0,
		|		0,
		|		0,
		|		ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт,
		|		ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокКт,
		|		ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстатокКт
		|	ИЗ
		|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|				&МоментВремени,
		|				Счет В
		|					(ВЫБРАТЬ
		|						СчетаНалоговогоУчетаАмортизацииОС.Счет
		|					ИЗ
		|						СчетаНалоговогоУчетаАмортизацииОС
		|				
		|					ОБЪЕДИНИТЬ ВСЕ
		|				
		|					ВЫБРАТЬ
		|						СчетаНалоговогоУчетаАмортизацииНМА.Счет
		|					ИЗ
		|						СчетаНалоговогоУчетаАмортизацииНМА),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|				Организация = &Организация
		|					И КФО В (&КФО)
		|					И &УсловиеИФО
		|					И Субконто1 В (&СписокОС)) КАК ЖурналПроводокЕПСБУОстатки) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.ОсновноеСредство
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ОстаткиБУ.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
		|	ОстаткиБУ.КоличествоОстатокДт КАК Количество
		|ПОМЕСТИТЬ ОстаткиБУ
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&МоментВремени,
		|			Счет В (&СписокСчетовБУ),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|			Организация = &Организация
		|				И КФО В (&КФО)
		|				И &УсловиеИФО
		|				И Субконто1 В (&СписокОС)) КАК ОстаткиБУ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СписокОС_НУ.ОсновноеСредство КАК ОсновноеСредство,
		|	СписокОС_НУ.ОсновноеСредство.ГрупповойУчет КАК ГрупповойУчет,
		|	СписокОС_НУ.ВосстановительнаяСтоимость КАК ВосстановительнаяСтоимость,
		|	СписокОС_НУ.ОстаточнаяСтоимость КАК ОстаточнаяСтоимость,
		|	СписокОС_НУ.ВосстановительнаяСтоимостьНеУчитываетсяНУ КАК ВосстановительнаяСтоимостьНеУчитываетсяНУ,
		|	СписокОС_НУ.ОстаточнаяСтоимостьНеУчитываетсяНУ КАК ОстаточнаяСтоимостьНеУчитываетсяНУ,
		|	СписокОС_НУ.ВосстановительнаяСтоимостьЕНВД КАК ВосстановительнаяСтоимостьЕНВД,
		|	СписокОС_НУ.ОстаточнаяСтоимостьЕНВД КАК ОстаточнаяСтоимостьЕНВД,
		|	СписокОС_НУ.СуммаНачисленнойАмортизации КАК СуммаНачисленнойАмортизации,
		|	СписокОС_НУ.СуммаНачисленнойАмортизацииНеУчитываетсяНУ КАК СуммаНачисленнойАмортизацииНеУчитываетсяНУ,
		|	СписокОС_НУ.СуммаНачисленнойАмортизацииЕНВД КАК СуммаНачисленнойАмортизацииЕНВД,
		|	ЕСТЬNULL(ОстаткиБУ.Количество, 1) КАК Количество
		|ИЗ
		|	СписокОС_НУ КАК СписокОС_НУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиБУ КАК ОстаткиБУ
		|		ПО СписокОС_НУ.ОсновноеСредство = ОстаткиБУ.ОсновноеСредство";
		
		Запрос.УстановитьПараметр("СписокСчетовБУ", БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00"));
		
	КонецЕсли;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО, "ИФО = &ИФО", "ИСТИНА"));

	Если ЗначениеЗаполнено(ПериодОстатков) Тогда
		Запрос.УстановитьПараметр("МоментВремени", ПериодОстатков);
	Иначе
		Запрос.УстановитьПараметр("МоментВремени", ПериодПолученияОстатков(ДокументСсылка));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация",   ДокументСсылка.Организация);
	Запрос.УстановитьПараметр("СписокОС",      ОсновныеСредства);
	Запрос.УстановитьПараметр("ИФО",           ДокументСсылка.ИФО);
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДанныеФормыСтруктура") И ДокументСсылка.Свойство("КФО") Тогда
		Запрос.УстановитьПараметр("КФО", ДокументСсылка.КФО);
	Иначе // Документ-ссылка.
		МетаданныеДокумента = ДокументСсылка.Метаданные();
		Если МетаданныеДокумента.Имя = "РешениеОПрекращенииПризнанияАктивом"
			ИЛИ (МетаданныеДокумента.Имя = "СписаниеОбъектовОС" И ДокументСсылка.КФОВТабличнойЧасти) Тогда
			Запрос.УстановитьПараметр("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
				ДокументСсылка.ОсновныеСредства.ВыгрузитьКолонку("КФО")));
		Иначе
			Запрос.УстановитьПараметр("КФО", ДокументСсылка.КФО);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

