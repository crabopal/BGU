		СтраницаЛист02_2.П000220013403 = 0;
		
	Иначе
		
		// Строка 131 - Сумма начисленной амортизации, за отчетный (налоговый) период - линейным методом, всего
		СтраницаЛист02_2.П000220013103 = АмортизацияОсновныхСредств8_10;
		
		ДобавитьСтрокиРасшифровкиАмортизации(ТаблицаРасшифровки, ОбщиеПараметрыРасшифровки,
