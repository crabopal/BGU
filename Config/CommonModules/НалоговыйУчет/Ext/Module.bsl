Процедура ЗаполнитьОтчетПрибыльФормаОтчета2025Кв1(ПараметрыОтчета, Контейнер) Экспорт
	
	Перем ТаблицаРасшифровки; // Таблица для сбора сведений о расшифровке. Инициализируется в процедуре добавления записи
	
	НачалоНалоговогоПериода = НалоговыйУчет.НачалоНалоговогоПериода(ПараметрыОтчета.мДатаКонцаПериодаОтчета, ПараметрыОтчета.Организация);
	Если НачалоНалоговогоПериода = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИнициализироватьДополнительныеПараметрыРеглОтчетаПрибыль(ПараметрыОтчета);
	
	ОбщиеПараметрыРасшифровки = Новый Структура;
	ОбщиеПараметрыРасшифровки.Вставить("Организация",   ПараметрыОтчета.Организация);
	ОбщиеПараметрыРасшифровки.Вставить("НачалоПериода", НачалоНалоговогоПериода);
	ОбщиеПараметрыРасшифровки.Вставить("КонецПериода",  ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	ОбщиеПараметрыРасшифровки.Вставить("ПараметрыОтчета", ПараметрыОтчета);
	
	#Область ПолучениеДанных
	
	ВидыСубконто = ПланыВидовХарактеристик.ВидыСубконто;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаНач",           НачалоНалоговогоПериода);
	Запрос.УстановитьПараметр("ДатаКон",           ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("СписокОрганизаций", ПараметрыОтчета.Организация);
	
	
	// Доходы и расходы по обычным видам деятельности.
	Запрос.УстановитьПараметр("СчетаДоходыИРасходы", БухгалтерскийУчет.СписокСчетов("Н90.01,Н90.02,Н90.03,Н90.04,Н90.05"));
	Запрос.УстановитьПараметр("СчетН9009",           БухгалтерскийУчет.СписокСчетов("Н90.09"));
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУОбороты.Счет КАК Счет,
	|	СУММА(ЕПСБУОбороты.СуммаОборотДт) КАК ДО,
	|	СУММА(ЕПСБУОбороты.СуммаОборотКт) КАК КО
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&ДатаНач, &ДатаКон, , Счет В (&СчетаДоходыИРасходы), , Организация В (&СписокОрганизаций), НЕ КорСчет В (&СчетН9009), ) КАК ЕПСБУОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОбороты.Счет
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕПСБУОбороты.Счет.Код";
	
	БухИтоги90 = Запрос.Выполнить().Выгрузить();
	
	
	// Таблица итогов по всем счетам косвенных затрат с рабивкой по виду затрат.
	Запрос.УстановитьПараметр("Счет",    БухгалтерскийУчет.СписокСчетов("Н20,Н25,Н26,Н44"));
	Запрос.УстановитьПараметр("КорСчет", БухгалтерскийУчет.СписокСчетов("Н90.06"));
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУОбороты.Счет КАК Счет,
	|	ЕПСБУОбороты.КорСчет КАК КорСчет,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.ВидыЗатрат).ВидРасходовНУ КАК Субконто1,
	|	СУММА(ЕПСБУОбороты.СуммаОборотКт) КАК КО
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&ДатаНач,
	|			&ДатаКон,
	|			,
	|			Счет В (&Счет),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат),
	|			Организация В (&СписокОрганизаций)
	|				И НЕ ВЫРАЗИТЬ(Субконто1 КАК Справочник.ВидыЗатрат).ВидРасходовНУ = ЗНАЧЕНИЕ(Перечисление.ВидыРасходовНУ.ТранспортныеРасходы),
	|			КорСчет В (&КорСчет),
	|			) КАК ЕПСБУОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОбороты.Счет,
	|	ЕПСБУОбороты.КорСчет,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.ВидыЗатрат).ВидРасходовНУ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕПСБУОбороты.Счет.Код";
	
	БухИтогиКосвЗатрат = Запрос.Выполнить().Выгрузить();
	
	
	// Прочие доходы и расходы.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.ПрочиеДоходыИРасходы).ВидПрочихДоходовИРасходов КАК ВидПрочихДоходовИРасходов,
	|	ЕПСБУОбороты.СуммаОборотДт КАК ДебетовыйОборот,
	|	ЕПСБУОбороты.СуммаОборотКт КАК КредитовыйОборот
	|ПОМЕСТИТЬ ТаблицаПрочиеДоходыРасходыНеЕНВД
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&ДатаНач,
	|			&ДатаКон,
	|			,
	|			Счет В (&СчетаПрочиеДоходыИРасходы),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы),
	|			Организация В (&СписокОрганизаций)
	|				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.ПрочиеДоходыИРасходы).ВидДеятельностиДляНалоговогоУчетаЗатрат В (&МассивНеЕНВД),
	|			НЕ КорСчет В (&СчетН9109),
	|			) КАК ЕПСБУОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.ПрочиеДоходыИРасходы).ВидПрочихДоходовИРасходов КАК ВидПрочихДоходовИРасходов,
	|	ЕПСБУОбороты.СуммаЕНВДОборотКт КАК СуммаРаспределеннаяНаЕНВД
	|ПОМЕСТИТЬ ТаблицаРаспределениеНаЕНВД
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&ДатаНач,
	|			&ДатаКон,
	|			,
	|			Счет В (&СчетН9109),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы),
	|			Организация В (&СписокОрганизаций)
	|				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.ПрочиеДоходыИРасходы).ВидДеятельностиДляНалоговогоУчетаЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты),
	|			КорСчет В (&СчетН99),
	|			) КАК ЕПСБУОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Субконто1 КАК Субконто1,
	|	СУММА(ВложенныйЗапрос.ДО) КАК ДО,
	|	СУММА(ВложенныйЗапрос.КО) КАК КО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаПрочиеДоходыРасходыНеЕНВД.ВидПрочихДоходовИРасходов КАК Субконто1,
	|		ТаблицаПрочиеДоходыРасходыНеЕНВД.ДебетовыйОборот КАК ДО,
	|		ТаблицаПрочиеДоходыРасходыНеЕНВД.КредитовыйОборот КАК КО
	|	ИЗ
	|		ТаблицаПрочиеДоходыРасходыНеЕНВД КАК ТаблицаПрочиеДоходыРасходыНеЕНВД
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТаблицаРаспределениеНаЕНВД.ВидПрочихДоходовИРасходов,
	|		-ТаблицаРаспределениеНаЕНВД.СуммаРаспределеннаяНаЕНВД,
	|		0
	|	ИЗ
	|		ТаблицаРаспределениеНаЕНВД КАК ТаблицаРаспределениеНаЕНВД) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Субконто1";
	Запрос.УстановитьПараметр("СчетаПрочиеДоходыИРасходы", БухгалтерскийУчет.СписокСчетов("Н91.01,Н91.02"));
	Запрос.УстановитьПараметр("СчетН9109",                 БухгалтерскийУчет.СписокСчетов("Н91.09"));
	Запрос.УстановитьПараметр("СчетН99",                   БухгалтерскийУчет.СписокСчетов("Н99"));
	
	МассивНеЕНВД = Новый Массив;
	МассивНеЕНВД.Добавить(Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения);
	МассивНеЕНВД.Добавить(Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты);
	Запрос.УстановитьПараметр("МассивНеЕНВД",  МассивНеЕНВД);
	
	БухИтоги91 = Запрос.Выполнить().Выгрузить();
	
	
	// Ввнереализационные доходы и расходы, перенос убытков от реализации ОС и НМА.
	МассивВнереализационныхРасходов = ПолучитьМассивВнереализационныхРасходов();
	БухИтоги917                     = БухИтоги91.СкопироватьКолонки();
	Для Каждого Строка91 Из БухИтоги91 Цикл
		Если МассивВнереализационныхРасходов.Найти(Строка91.Субконто1) <> Неопределено Тогда
			Строка917 = БухИтоги917.Добавить();
			ЗаполнитьЗначенияСвойств(Строка917, Строка91);
		КонецЕсли;
	КонецЦикла;
	
	
	// Из расходов по реализации амортизируемого имущества вычитаем перенос на расходы убытков от реализации.
	РеализацияАмортизируемогоИмущества = Новый Массив;
	РеализацияАмортизируемогоИмущества.Добавить(Перечисления.ВидыПрочихДоходовИРасходов.РеализацияОсновныхСредств);
	РеализацияАмортизируемогоИмущества.Добавить(Перечисления.ВидыПрочихДоходовИРасходов.РеализацияНематериальныхАктивов);
	Запрос.УстановитьПараметр("РеализацияАмортизируемогоИмущества", РеализацияАмортизируемогоИмущества);
	
	Запрос.УстановитьПараметр("СчетН97", БухгалтерскийУчет.СписокСчетов("Н97"));
	
	Запрос.Текст = 
	"ВЫБРАТЬ
