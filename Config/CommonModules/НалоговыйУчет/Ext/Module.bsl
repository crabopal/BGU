// УЧЕТ МПЗ

Функция ПодготовитьТаблицуСписанныеВложенияМПЗ(ТаблицаВложенияМПЗ, Реквизиты, Отказ) Экспорт

	ТаблицаСписанныеМПЗ = ТаблицаВложенияМПЗ.СкопироватьКолонки();
	ТаблицаСписанныеМПЗ.Колонки.Добавить("ВидЗатрат",                    Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ТаблицаСписанныеМПЗ.Колонки.Добавить("СуммаСписанияНУ",              ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));
	ТаблицаСписанныеМПЗ.Колонки.Добавить("СуммаСписанияЕНВД",            ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));
	ТаблицаСписанныеМПЗ.Колонки.Добавить("СуммаСписанияНеУчитываетсяНУ", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));

	Если ТаблицаВложенияМПЗ.Количество() > 0 Тогда

		ЕстьКолонкаПартия = ( ТаблицаВложенияМПЗ.Колонки.Найти("Партия") <> Неопределено );
		
		МоментВремени = Новый МоментВремени(Реквизиты.Дата, Реквизиты.Ссылка);
		ТаблицаОстатки = ПолучитьОстаткиМПЗ(МоментВремени,
			Реквизиты.Организация, Реквизиты.ИФО,
			ТаблицаВложенияМПЗ);
		ТаблицаОстатки.Индексы.Добавить("Номенклатура, СчетУчетаНУ");

		Для каждого СтрокаДокумента Из ТаблицаВложенияМПЗ Цикл

			КоличествоОсталосьПогасить = СтрокаДокумента.Количество;
			Если КоличествоОсталосьПогасить <= 0 Тогда
				Продолжить;
			КонецЕсли;

			Если ТаблицаОстатки.Количество() <> 0 Тогда

				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Номенклатура", СтрокаДокумента.Номенклатура);
				ПараметрыОтбора.Вставить("СчетУчетаНУ", СтрокаДокумента.СчетУчетаНУ);

				Если ЕстьКолонкаПартия И ЗначениеЗаполнено(СтрокаДокумента.Партия)
				   И ВедетсяПартионныйУчет(СтрокаДокумента.СчетУчетаНУ) Тогда
					ПараметрыОтбора.Вставить("Партия", СтрокаДокумента.Партия);
				КонецЕсли;
				
				ПартииОстатков = ТаблицаОстатки.Скопировать(ПараметрыОтбора);
				
				КоэфПогашения = ?(ПартииОстатков.Итог("Количество")=0, 0, КоличествоОсталосьПогасить / ПартииОстатков.Итог("Количество"));

				Для каждого СтрокаПартии Из ПартииОстатков Цикл

					Количество = Окр(КоэфПогашения * СтрокаПартии.Количество, 2, 1);

					Стоимость                = Окр(КоэфПогашения * СтрокаПартии.Стоимость, 2, 1);
					СтоимостьЕНВД            = Окр(КоэфПогашения * СтрокаПартии.СтоимостьЕНВД, 2, 1);
					СтоимостьНеУчитываетсяНУ = Окр(КоэфПогашения * СтрокаПартии.СтоимостьНеУчитываетсяНУ, 2, 1);

					СтрокаПартии.Количество                = СтрокаПартии.Количество - Количество;
					СтрокаПартии.Стоимость                 = СтрокаПартии.Стоимость - Стоимость;
					СтрокаПартии.СтоимостьЕНВД             = СтрокаПартии.СтоимостьЕНВД - СтоимостьЕНВД;
					СтрокаПартии.СтоимостьНеУчитываетсяНУ  = СтрокаПартии.СтоимостьНеУчитываетсяНУ - СтоимостьНеУчитываетсяНУ;

					СписаннаяПартия = ТаблицаСписанныеМПЗ.Добавить();
					ЗаполнитьЗначенияСвойств(СписаннаяПартия, СтрокаДокумента);
					СписаннаяПартия.ВидЗатрат = СтрокаПартии.ВидЗатрат;
					СписаннаяПартия.Количество = Количество;
					СписаннаяПартия.СуммаСписанияНУ = Стоимость;
					СписаннаяПартия.СуммаСписанияЕНВД = СтоимостьЕНВД;
					СписаннаяПартия.СуммаСписанияНеУчитываетсяНУ = СтоимостьНеУчитываетсяНУ;
					
				КонецЦикла;

			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	Возврат ТаблицаСписанныеМПЗ;

КонецФункции

Функция ПолучитьОстаткиМПЗ(МоментВремени, Организация, ИФО, ТаблицаСписания)
	
	МассивСчетовУчета = РазличныеЗначенияКолонкиТаблицы(ТаблицаСписания, "СчетУчетаНУ");
	ТаблицаСписания.Индексы.Добавить("СчетУчетаНУ");
	
	МассивНоменклатуры = РазличныеЗначенияКолонкиТаблицы(ТаблицаСписания, "Номенклатура");
	
	ЕстьКолонкаПартия    = ( ТаблицаСписания.Колонки.Найти("Партия")    <> Неопределено );
	
	// Блокируем регистр ЖурналПроводокЕПСБУ для получения остатков
	
	Блокировка = Новый БлокировкаДанных;
	
	Для каждого СчетУчетаНУ Из МассивСчетовУчета Цикл
	
		// Отдельная блокировка по каждому счету учета
		Если ЕстьКолонкаПартия Тогда
			ТаблицаСписанияПоСчету = ТаблицаСписания.Скопировать(Новый Структура("СчетУчетаНУ", СчетУчетаНУ), "КФО,Номенклатура,Партия");
			ТаблицаСписанияПоСчету.Свернуть("КФО,Номенклатура,Партия");
		Иначе
			ТаблицаСписанияПоСчету = ТаблицаСписания.Скопировать(Новый Структура("СчетУчетаНУ", СчетУчетаНУ), "КФО,Номенклатура");
			ТаблицаСписанияПоСчету.Свернуть("КФО,Номенклатура");
		КонецЕсли;
		ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
		ЭлементБлокировки.УстановитьЗначение("Период",      Новый Диапазон(, МоментВремени.Дата));
		ЭлементБлокировки.УстановитьЗначение("Организация", Организация);
		ЭлементБлокировки.УстановитьЗначение("Счет",        СчетУчетаНУ);
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ЭлементБлокировки.УстановитьЗначение("ИФО", ИФО);
		КонецЕсли;
		
		ЭлементБлокировки.ИсточникДанных = ТаблицаСписанияПоСчету;
		
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("КФО", "КФО");
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчетаНУ);
		Для Ном = 1 По СвойстваСчета.КоличествоСубконто Цикл
			Если СвойстваСчета["ВидСубконто" + Ном] = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
				ЭлементБлокировки.ИспользоватьИзИсточникаДанных(
					ПланыВидовХарактеристик.ВидыСубконто.Номенклатура, "Номенклатура");
			ИначеЕсли ЕстьКолонкаПартия И СвойстваСчета["ВидСубконто" + Ном] = ПланыВидовХарактеристик.ВидыСубконто.Партии Тогда
				ЭлементБлокировки.ИспользоватьИзИсточникаДанных(
					ПланыВидовХарактеристик.ВидыСубконто.Партии, "Партия");
			КонецЕсли;
		КонецЦикла;
	
	КонецЦикла;
	
	Блокировка.Заблокировать();
	
	// Получаем остатки номенклатуры
	СчетаУчетаН      = Новый Массив; // счета с суммовым учетом только по номенклатуре
	СчетаУчетаНВ     = Новый Массив; // счета с суммовым учетом по номенклатуре и видам затрат
	СчетаУчетаНВП    = Новый Массив; // счета с суммовым учетом по номенклатуре, видам затрат и партиям

	СортировкаСчетовУчета(МассивСчетовУчета,
	                      СчетаУчетаН,
	                      СчетаУчетаНВ,
	                      СчетаУчетаНВП);
	
	ВидыСубконтоН = Новый Массив;
	ВидысубконтоН.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);

	ВидыСубконтоНВ = Новый Массив;
	ВидыСубконтоНВ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконтоНВ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат);

	ВидыСубконтоНВП = Новый Массив;
	ВидыСубконтоНВП.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконтоНВП.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат);
	ВидыСубконтоНВП.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Партии);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МоментВремени",      МоментВремени);
	Запрос.УстановитьПараметр("Организация",        Организация);
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр("СчетаУчетаН",        СчетаУчетаН);
	Запрос.УстановитьПараметр("СчетаУчетаНВ",       СчетаУчетаНВ);
	Запрос.УстановитьПараметр("СчетаУчетаНВП",      СчетаУчетаНВП);
	Запрос.УстановитьПараметр("ВидыСубконтоН",      ВидыСубконтоН);
	Запрос.УстановитьПараметр("ВидыСубконтоНВ",     ВидыСубконтоНВ);
	Запрос.УстановитьПараметр("ВидыСубконтоНВП",    ВидыСубконтоНВП);
	
	Текст = "";

	Если СчетаУчетаН.Количество() > 0 Тогда

		Текст = Текст + 
		"ВЫБРАТЬ
		|	Остатки.Организация КАК Организация,
		|	Остатки.Счет КАК СчетУчетаНУ,
		|	Остатки.Субконто1 КАК Номенклатура,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка) КАК ВидЗатрат,
		|	НЕОПРЕДЕЛЕНО КАК Партия,
		|	СУММА(ЕСТЬNULL(Остатки.КоличествоОстатокДт, 0)) КАК Количество,
		|	СУММА(ЕСТЬNULL(Остатки.СуммаОстатокДт, 0)) КАК Стоимость,
		|	СУММА(ЕСТЬNULL(Остатки.СуммаЕНВДОстатокДт, 0)) КАК СтоимостьЕНВД,
		|	СУММА(ЕСТЬNULL(Остатки.СуммаНеУчитываетсяНУОстатокДт, 0)) КАК СтоимостьНеУчитываетсяНУ
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&МоментВремени,
		|			Счет В (&СчетаУчетаН),
		|			&ВидыСубконтоН,
		|			Субконто1 В (&МассивНоменклатуры)
		|				И Организация = &Организация) КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Счет,
		|	Остатки.Субконто1,
		|	Остатки.Организация";

	КонецЕсли;

	Если СчетаУчетаНВ.Количество() > 0 Тогда

		Если Текст <> "" Тогда
			Текст = Текст + "
			|
			| ОБЪЕДИНИТЬ ВСЕ
			|
			|";
		КонецЕсли;

		Текст = Текст + 
		"ВЫБРАТЬ
		|	Остатки.Организация КАК Организация,
		|	Остатки.Счет КАК СчетУчетаНУ,
		|	Остатки.Субконто1 КАК Номенклатура,
		|	Остатки.Субконто2 КАК ВидЗатрат,
		|	НЕОПРЕДЕЛЕНО КАК Партия,
		|	СУММА(ЕСТЬNULL(Остатки.КоличествоОстатокДт, 0)) КАК Количество,
		|	СУММА(ЕСТЬNULL(Остатки.СуммаОстатокДт, 0)) КАК Стоимость,
		|	СУММА(ЕСТЬNULL(Остатки.СуммаЕНВДОстатокДт, 0)) КАК СтоимостьЕНВД,
		|	СУММА(ЕСТЬNULL(Остатки.СуммаНеУчитываетсяНУОстатокДт, 0)) КАК СтоимостьНеУчитываетсяНУ
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&МоментВремени,
		|			Счет В (&СчетаУчетаНВ),
		|			&ВидыСубконтоНВ,
		|			Субконто1 В (&МассивНоменклатуры)
		|				И Организация = &Организация) КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Счет,
		|	Остатки.Субконто1,
		|	Остатки.Субконто2,
		|	Остатки.Организация";

	КонецЕсли;

	Если СчетаУчетаНВП.Количество() > 0 Тогда

		Если Текст <> "" Тогда
			Текст = Текст + "
			|
			| ОБЪЕДИНИТЬ ВСЕ
			|
			|";
		КонецЕсли;

		Текст = Текст + 
		"ВЫБРАТЬ
		|	Остатки.Организация КАК Организация,
		|	Остатки.Счет КАК СчетУчетаНУ,
		|	Остатки.Субконто1 КАК Номенклатура,
		|	Остатки.Субконто2 КАК ВидЗатрат,
		|	Остатки.Субконто3 КАК Партия,
		|	СУММА(ЕСТЬNULL(Остатки.КоличествоОстатокДт, 0)) КАК Количество,
		|	СУММА(ЕСТЬNULL(Остатки.СуммаОстатокДт, 0)) КАК Стоимость,
		|	СУММА(ЕСТЬNULL(Остатки.СуммаЕНВДОстатокДт, 0)) КАК СтоимостьЕНВД,
		|	СУММА(ЕСТЬNULL(Остатки.СуммаНеУчитываетсяНУОстатокДт, 0)) КАК СтоимостьНеУчитываетсяНУ
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&МоментВремени,
		|			Счет В (&СчетаУчетаНВП),
		|			&ВидыСубконтоНВП,
		|			Субконто1 В (&МассивНоменклатуры)
		|				И &УсловиеПартия
		|				И Организация = &Организация) КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Счет,
		|	Остатки.Субконто1,
		|	Остатки.Субконто2,
		|	Остатки.Субконто3,
		|	Остатки.Организация";

	КонецЕсли;

	Если ЕстьКолонкаПартия Тогда
		Текст = СтрЗаменить(Текст, "&УсловиеПартия", "Субконто3 В (&МассивПартий)");
		Запрос.УстановитьПараметр("МассивПартий", РазличныеЗначенияКолонкиТаблицы(ТаблицаСписания, "Партия"));
	Иначе
		Текст = СтрЗаменить(Текст, "&УсловиеПартия", "ИСТИНА");
	КонецЕсли;

	Запрос.Текст = Текст + "
	|ДЛЯ ИЗМЕНЕНИЯ";

	Результат = Запрос.Выполнить().Выгрузить();

	Возврат Результат;

КонецФункции

Процедура СортировкаСчетовУчета(СчетаУчета,
	СчетаУчетаН,
	СчетаУчетаНВ,
	СчетаУчетаНВП) Экспорт

	Для каждого Счет Из СчетаУчета Цикл

		Если ВедетсяУчетПоВидамЗатрат(Счет) И ВедетсяПартионныйУчет(Счет) Тогда
			СчетаУчетаНВП.Добавить(Счет);
		ИначеЕсли ВедетсяУчетПоВидамЗатрат(Счет) Тогда
			СчетаУчетаНВ.Добавить(Счет);
		Иначе
			СчетаУчетаН.Добавить(Счет);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ВедетсяУчетПоВидамЗатрат(Счет) Экспорт

	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);

	УчетПоВидамЗатрат = СвойстваСчета.ВидСубконто1 = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат
		ИЛИ СвойстваСчета.ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат
		ИЛИ СвойстваСчета.ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат;

	Возврат УчетПоВидамЗатрат;

КонецФункции 

Функция ВедетсяПартионныйУчет(Счет) Экспорт

	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);

	ПартионныйУчет = СвойстваСчета.ВидСубконто1 = ПланыВидовХарактеристик.ВидыСубконто.Партии
		ИЛИ СвойстваСчета.ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.Партии
		ИЛИ СвойстваСчета.ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.Партии;

	Возврат ПартионныйУчет;

КонецФункции 

////////////////////////////////////////////////////////////////////////////////
// УЧЕТ ДОХОДОВ И РАСХОДОВ

Процедура СкорректироватьПроводкиОтраженияДоходовРасходов(ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты) Экспорт
	
	ЭтоДокументСОтдельнойДатойПроведения = Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(ДокументОбъект.Ссылка));
	
	ВидыДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат;
	
	КоличествоПроводок = ТаблицаПроводок.Количество();
	Для НомерПроводки = 1 По КоличествоПроводок Цикл
		
		ИндексПроводки = КоличествоПроводок - НомерПроводки;
		Проводка = ТаблицаПроводок[ИндексПроводки];
		
		СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетДт);
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетКт);
		
		Если НЕ ЗначениеЗаполнено(СвойстваСчетаДт)
		 ИЛИ СвойстваСчетаДт.ТипСчета <> ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый") Тогда
			Продолжить; // корректируем только проводки по счетам НУ
		КонецЕсли;
		
		Проводка.Сумма                = ?(Проводка.Сумма = NULL,                0, Проводка.Сумма);
		Проводка.СуммаНеУчитываетсяНУ = ?(Проводка.СуммаНеУчитываетсяНУ = NULL, 0, Проводка.СуммаНеУчитываетсяНУ);
		Проводка.СуммаЕНВД            = ?(Проводка.СуммаЕНВД = NULL,            0, Проводка.СуммаЕНВД);
		
		// Корректировать нужно, если это доходы (расходы) по деятельности с особым порядком налогообложения (ЕНВД и пр.)
		//  или доходы (расходы), не учитываемые при налогообложении по ст. 251 и 270 НК РФ.
		
		// РАСХОДЫ
		ЭтоНеУчитываемые  = Ложь;
		ЭтоЕНВД           = Ложь;
		
		// Списание в Дт Н08,Н15,Н20,Н25,Н26,Н44.
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "Н08,Н15,Н20,Н25,Н26,Н44") Тогда
			
			ВидЗатрат = Неопределено;
			Для НомерСубконто = 1 По СвойстваСчетаДт.КоличествоСубконто Цикл
				Если СвойстваСчетаДт["ВидСубконто"+НомерСубконто] = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат") Тогда
					ВидЗатрат = Проводка["СубконтоДт"+НомерСубконто];
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ВидЗатрат) И ТипЗнч(ВидЗатрат) = Тип("СправочникСсылка.ВидыЗатрат") Тогда
				ЭтоЕНВД = (ВидЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат = ВидыДеятельностиНУ.ОсобыйПорядокНалогообложения);
				ЭтоНеУчитываемые = (ВидЗатрат.ВидРасходовНУ = Перечисления.ВидыРасходовНУ.НеУчитываемыеВЦеляхНалогообложения);
			КонецЕсли;
			
		КонецЕсли;
		
		// Розница в НТТ Н41.02,Н42.
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "Н41.02,Н42")
		 ИЛИ БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "Н41.02,Н42") Тогда
			УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(ДокументОбъект.Организация, ДокументОбъект.Дата);
			ЭтоЕНВД = УчетнаяПолитика.РозничнаяТорговляОблагаетсяЕНВД;
		КонецЕсли;
		
		// Расходы по обычным видам деятельности Н90.03,Н90.04.
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "Н90.03,Н90.04") Тогда
			
			Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ОтчетОРозничныхПродажах")
			 ИЛИ ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РасчетНаценки") Тогда
				УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(ДокументОбъект.Организация, ДокументОбъект.Дата);
				ЭтоЕНВД = УчетнаяПолитика.РозничнаяТорговляОблагаетсяЕНВД;
			Иначе
				Если ТипЗнч(ДополнительныеРеквизиты) = Тип("Структура") И ДополнительныеРеквизиты.Свойство("ВидДеятельностиНУ") Тогда
					ВидДеятельностиНУ = БухгалтерскиеОперацииПовтИсп.ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ВидДеятельностиНУ");
					Если ЗначениеЗаполнено(ВидДеятельностиНУ) Тогда
						ЭтоЕНВД = (ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// Прочие расходы Н91.02.
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "Н91.02") Тогда
			
			СтатьяПрочихРасходов = Неопределено;
			Для НомерСубконто = 1 По СвойстваСчетаДт.КоличествоСубконто Цикл
				Если СвойстваСчетаДт["ВидСубконто"+НомерСубконто] = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы") Тогда
					СтатьяПрочихРасходов = Проводка["СубконтоДт"+НомерСубконто];
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(СтатьяПрочихРасходов) И ТипЗнч(СтатьяПрочихРасходов) = Тип("СправочникСсылка.ПрочиеДоходыИРасходы") Тогда
				Если ЗначениеЗаполнено(СтатьяПрочихРасходов) И ТипЗнч(СтатьяПрочихРасходов) = Тип("СправочникСсылка.ПрочиеДоходыИРасходы") Тогда
					ЭтоЕНВД = (СтатьяПрочихРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения);
					ЭтоНеУчитываемые = (Не СтатьяПрочихРасходов.ПринятиеКналоговомуУчету);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭтоНеУчитываемые ИЛИ ЭтоЕНВД Тогда
			
			// Скорректируем стоимость списания имущества, вложений, РБП.
			Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "Н01,Н04,Н08,Н10,Н15,Н41.01,Н43,Н97") Тогда
			
				Если ЭтоНеУчитываемые И (Проводка.Сумма <> 0 ИЛИ Проводка.СуммаЕНВД <> 0) Тогда
					
					НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки);
					ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка, ,
						"СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,КПСДт,ПодразделениеДт"); // без корреспонденции
					
					// списываем суммы в остальных ресурсах на не учитываемые
					НоваяПроводка.СуммаНеУчитываетсяНУ = - (Проводка.Сумма + Проводка.СуммаЕНВД);
					
					// количество (если есть) будет списано основной проводкой
					НоваяПроводка.КоличествоДт = 0;
					НоваяПроводка.КоличествоКт = 0;
					
				ИначеЕсли ЭтоЕНВД И (Проводка.Сумма <> 0 ИЛИ Проводка.СуммаНеУчитываетсяНУ <> 0) Тогда
					
					НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки);
					ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка, ,
						"СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,КПСДт,ПодразделениеДт"); // без корреспонденции
					
					// списываем суммы в остальных ресурсах на ЕНВД
					НоваяПроводка.СуммаЕНВД = - (Проводка.Сумма + Проводка.СуммаНеУчитываетсяНУ);
					
					// количество (если есть) будет списано основной проводкой
					НоваяПроводка.КоличествоДт = 0;
					НоваяПроводка.КоличествоКт = 0;
					
				КонецЕсли;
				
			КонецЕсли;
			
			// общую сумму расходов спишем по соответствующему ресурсу
			ОбщаяСуммаРасходов = Проводка.Сумма + Проводка.СуммаНеУчитываетсяНУ + Проводка.СуммаЕНВД;
			
			Проводка.СуммаНеУчитываетсяНУ = ?(ЭтоНеУчитываемые, ОбщаяСуммаРасходов, 0);
			Проводка.СуммаЕНВД            = ?(ЭтоЕНВД,          ОбщаяСуммаРасходов, 0);
			Проводка.Сумма                = 0;
			
		Иначе // списание на расходы по основному виду деятельности
			
			// Отрицательные суммы списания ОС, НМА могут сформироваться из-за начисления амортизации
			// по виду деятельности, отличному от указанного при поступлении.
			Если (Проводка.СуммаНеУчитываетсяНУ < 0 ИЛИ Проводка.СуммаЕНВД < 0)
			   И БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "Н01,Н04") Тогда
				
				Если Проводка.СуммаНеУчитываетсяНУ < 0 Тогда
					
					НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки);
					ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка, ,
						"СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,КПСДт,ПодразделениеДт"); // без корреспонденции
					
					ОсталосьСписать                    = - Проводка.СуммаНеУчитываетсяНУ;
					СуммаКорректировки                 = МИН(Проводка.Сумма, ОсталосьСписать);
					СуммаКорректировкиЕНВД             = ОсталосьСписать - СуммаКорректировки;
					
					НоваяПроводка.Сумма                = СуммаКорректировки;
					НоваяПроводка.СуммаЕНВД            = СуммаКорректировкиЕНВД;
					НоваяПроводка.СуммаНеУчитываетсяНУ = - (СуммаКорректировки + СуммаКорректировкиЕНВД);
					
					// количество (если есть) будет списано основной проводкой
					НоваяПроводка.КоличествоДт = 0;
					НоваяПроводка.КоличествоКт = 0;
					
					// суммы основной проводки корректируем на суммы, списанные новой проводкой
					Проводка.Сумма                = Проводка.Сумма                - НоваяПроводка.Сумма;
					Проводка.СуммаНеУчитываетсяНУ = Проводка.СуммаНеУчитываетсяНУ - НоваяПроводка.СуммаНеУчитываетсяНУ;
					Проводка.СуммаЕНВД            = Проводка.СуммаЕНВД            - НоваяПроводка.СуммаЕНВД;
					
				КонецЕсли;
				
				Если Проводка.СуммаЕНВД < 0 Тогда
					
					НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки);
					ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка, ,
						"СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,КПСДт,ПодразделениеДт"); // без корреспонденции
					
					ОсталосьСписать                    = - Проводка.СуммаЕНВД;
					СуммаКорректировки                 = МИН(Проводка.Сумма, ОсталосьСписать);
					СуммаКорректировкиНеУчитываетсяНУ  = ОсталосьСписать - СуммаКорректировки;
					
					НоваяПроводка.Сумма                = СуммаКорректировки;
					НоваяПроводка.СуммаНеУчитываетсяНУ = СуммаКорректировкиНеУчитываетсяНУ;
					НоваяПроводка.СуммаЕНВД            = - (СуммаКорректировки + СуммаКорректировкиНеУчитываетсяНУ);
					
					// количество (если есть) будет списано основной проводкой
					НоваяПроводка.КоличествоДт = 0;
					НоваяПроводка.КоличествоКт = 0;
					
					// суммы основной проводки корректируем на суммы, списанные новой проводкой
					Проводка.Сумма                = Проводка.Сумма                - НоваяПроводка.Сумма;
					Проводка.СуммаНеУчитываетсяНУ = Проводка.СуммаНеУчитываетсяНУ - НоваяПроводка.СуммаНеУчитываетсяНУ;
					Проводка.СуммаЕНВД            = Проводка.СуммаЕНВД            - НоваяПроводка.СуммаЕНВД;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		// ДОХОДЫ
		ЭтоДоходы = Ложь;
		ЭтоЕНВД = Ложь;
		ЭтоНеУчитываемые = Ложь;
		
		// Доходы по обычным видам деятельности Н90.01,Н90.02
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "Н90.01,Н90.02") Тогда
			
			ЭтоДоходы = Истина;
			
			Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ОтчетОРозничныхПродажах") Тогда
				УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(ДокументОбъект.Организация, ДокументОбъект.Дата);
				ЭтоЕНВД = УчетнаяПолитика.РозничнаяТорговляОблагаетсяЕНВД;
			Иначе
				Если ТипЗнч(ДополнительныеРеквизиты) = Тип("Структура") И ДополнительныеРеквизиты.Свойство("ВидДеятельностиНУ") Тогда
					ВидДеятельностиНУ = БухгалтерскиеОперацииПовтИсп.ЗначениеДопРеквизита(ДополнительныеРеквизиты, "ВидДеятельностиНУ");
					Если ЗначениеЗаполнено(ВидДеятельностиНУ) Тогда
						ЭтоЕНВД = (ВидДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// Прочие доходы Н91.01
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "Н91.01") Тогда
			
			ЭтоДоходы = Истина;
			
			СтатьяПрочихДоходов = Неопределено;
			Для НомерСубконто = 1 По СвойстваСчетаКт.КоличествоСубконто Цикл
				Если СвойстваСчетаКт["ВидСубконто"+НомерСубконто] = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы") Тогда
					СтатьяПрочихДоходов = Проводка["СубконтоКт"+НомерСубконто];
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(СтатьяПрочихДоходов) И ТипЗнч(СтатьяПрочихДоходов) = Тип("СправочникСсылка.ПрочиеДоходыИРасходы") Тогда
				ЭтоЕНВД = (СтатьяПрочихДоходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения);
				ЭтоНеУчитываемые = (Не СтатьяПрочихДоходов.ПринятиеКналоговомуУчету);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭтоНеУчитываемые ИЛИ ЭтоЕНВД Тогда
			
			// общую сумму доходов запишем в соответствующий ресурс
			ОбщаяСуммаДоходов = Проводка.Сумма + Проводка.СуммаНеУчитываетсяНУ + Проводка.СуммаЕНВД;
			
			Проводка.СуммаНеУчитываетсяНУ = ?(ЭтоНеУчитываемые, ОбщаяСуммаДоходов, 0);
			Проводка.СуммаЕНВД            = ?(ЭтоЕНВД,          ОбщаяСуммаДоходов, 0);
			Проводка.Сумма                = 0;
			
		КонецЕсли;
		
		Если ЭтоДокументСОтдельнойДатойПроведения
			И ЭтоДоходы И НЕ (ЭтоНеУчитываемые ИЛИ ЭтоЕНВД) // Это налогооблагаемые доходы НУ.
			И Проводка.Сумма > 0 Тогда
			
			УстановленнаяДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументОбъект.Ссылка);
			Если НачалоКвартала(ДокументОбъект.Дата) < НачалоКвартала(УстановленнаяДатаПроведения) Тогда
				ТекстОшибки = НСтр("ru='Внимание! Доходы, подлежащие налогообложению налогом на прибыль, в сумме %1 %2 отражены в следующем отчетном периоде (квартале).
					|Дата документа: %3; Дата проведения: %4'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					Проводка.Сумма,
					Константы.ВалютаРегламентированногоУчета.Получить(),
					Формат(ДокументОбъект.Дата, "ДЛФ=Д"),
					Формат(УстановленнаяДатаПроведения, "ДЛФ=Д"));
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект.Ссылка, "Дата", "Объект");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// РАСЧЕТ НАЛОГА НА ПРИБЫЛЬ

// Расчет налога на прибыль к начислению
//
Функция ПодготовитьТаблицуРасчетыСБюджетомПоНалогуНаПрибыль(СтруктураПараметров) Экспорт

	ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль = Новый ТаблицаЗначений;
	ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль.Колонки.Добавить("КФО",       Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль.Колонки.Добавить("ИФО",       Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль.Колонки.Добавить("ВидНалога", Новый ОписаниеТипов("СправочникСсылка.ВидыНалоговИПлатежей"));
	ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль.Колонки.Добавить("Сумма",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));
	
	ОписаниеНалоговогоПериода = НалоговыйУчет.БлижайшийНалоговыйПериод(КонецМесяца(СтруктураПараметров.Дата), СтруктураПараметров.Организация);
	Если КонецМесяца(СтруктураПараметров.Дата) < ОписаниеНалоговогоПериода.Начало Тогда
		Возврат ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоНалоговогоПериода", ОписаниеНалоговогоПериода.Начало);
	Запрос.УстановитьПараметр("НачалоМесяца",            НачалоМесяца(СтруктураПараметров.Дата));
	Запрос.УстановитьПараметр("КонДата",                 КонецМесяца(СтруктураПараметров.Дата));
	Запрос.УстановитьПараметр("КонГраница",              Новый Граница(КонецМесяца(СтруктураПараметров.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",             СтруктураПараметров.Организация);
	
	Запрос.УстановитьПараметр("СчетаНалоговаяБаза",             БухгалтерскийУчет.СписокСчетов("Н99"));
	Запрос.УстановитьПараметр("СчетаРасчетыПоНалогуНаПрибыль",  БухгалтерскийУчет.СписокСчетов("303.03"));
	Запрос.УстановитьПараметр("СчетаДоходыРасходыТекущегоГода", БухгалтерскийУчет.СписокСчетов("401.10,401.20"));
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("ТаблицаБазаНалога", НомераТаблиц.Количество());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУОбороты.КФО КАК КФО,
	|	ЕПСБУОбороты.ИФО КАК ИФО,
	|	СУММА(ЕПСБУОбороты.СуммаОборотКт - ЕПСБУОбороты.СуммаОборотДт) КАК БазаНалогаЗаГод
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоНалоговогоПериода,
	|			&КонГраница,
	|			,
	|			Счет В (&СчетаНалоговаяБаза),
	|			,
	|			Организация = &Организация
	|				И &УсловиеКФО
	|				И &УсловиеИФО,
	|			,
	|			) КАК ЕПСБУОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОбороты.КФО,
	|	ЕПСБУОбороты.ИФО";
	
	НомераТаблиц.Вставить("РасчетыСНачалаГода", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("РасчетыСНачалаМесяца", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаСубъектов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЕПСБУОбороты.КФО,
	|	ЕПСБУОбороты.ИФО,
	|	ЕПСБУОбороты.Субконто1,
	|	ЕПСБУОбороты.СуммаОборотКт КАК Налог
	|ПОМЕСТИТЬ РасчетыСНачалаГода
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоНалоговогоПериода,
	|			&КонДата,
	|			,
	|			Счет В (&СчетаРасчетыПоНалогуНаПрибыль),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыНалоговИПлатежей),
	|			Организация = &Организация
	|				И &УсловиеКФО
	|				И &УсловиеИФО
	|				И (Субконто1 = ЗНАЧЕНИЕ(Справочник.ВидыНалоговИПлатежей.ПрибыльФБ)
	|					ИЛИ Субконто1 = ЗНАЧЕНИЕ(Справочник.ВидыНалоговИПлатежей.ПрибыльРБ)),
	|			КорСчет В (&СчетаДоходыРасходыТекущегоГода),
	|			) КАК ЕПСБУОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОбороты.КФО,
	|	ЕПСБУОбороты.ИФО,
	|	ЕПСБУОбороты.Субконто1,
	|	-ЕПСБУОбороты.СуммаОборотКт КАК Налог
	|ПОМЕСТИТЬ РасчетыСНачалаМесяца
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоМесяца,
	|			&КонДата,
	|			,
	|			Счет В (&СчетаРасчетыПоНалогуНаПрибыль),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыНалоговИПлатежей),
	|			Организация = &Организация
	|				И &УсловиеКФО
	|				И &УсловиеИФО
	|				И (Субконто1 = ЗНАЧЕНИЕ(Справочник.ВидыНалоговИПлатежей.ПрибыльФБ)
	|					ИЛИ Субконто1 = ЗНАЧЕНИЕ(Справочник.ВидыНалоговИПлатежей.ПрибыльРБ)),
	|			КорСчет В (&СчетаДоходыРасходыТекущегоГода),
	|			) КАК ЕПСБУОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.КФО,
	|	ВложенныйЗапрос.ИФО,
	|	ВложенныйЗапрос.Субконто1,
	|	СУММА(ВложенныйЗапрос.Налог) КАК Налог
	|ИЗ
	|	(ВЫБРАТЬ
	|		РасчетыСНачалаГода.КФО КАК КФО,
	|		РасчетыСНачалаГода.ИФО КАК ИФО,
	|		РасчетыСНачалаГода.Субконто1 КАК Субконто1,
	|		РасчетыСНачалаГода.Налог КАК Налог
	|	ИЗ
	|		РасчетыСНачалаГода КАК РасчетыСНачалаГода
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РасчетыСНачалаМесяца.КФО,
	|		РасчетыСНачалаМесяца.ИФО,
	|		РасчетыСНачалаМесяца.Субконто1,
	|		РасчетыСНачалаМесяца.Налог
	|	ИЗ
	|		РасчетыСНачалаМесяца КАК РасчетыСНачалаМесяца) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.КФО,
	|	ВложенныйЗапрос.ИФО,
	|	ВложенныйЗапрос.Субконто1";
	
	Если ЗначениеЗаполнено(СтруктураПараметров.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", СтруктураПараметров.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(СтруктураПараметров.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", СтруктураПараметров.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаБазаНалога = Результат[НомераТаблиц.ТаблицаБазаНалога].Выгрузить();
	ТаблицаСубъектов  = Результат[НомераТаблиц.ТаблицаСубъектов].Выгрузить();
	
	Для Каждого Строка Из ТаблицаБазаНалога Цикл
	
		БазаНалогаЗаГод  = Строка.БазаНалогаЗаГод;
		
		СтавкаФБ         = 0;
		СтавкаРФ         = 0;
		
		ТочностьРасчета = ?(СтруктураПараметров.Дата < Дата(2014,01,01), 2, 0); // после 01.01.2014 налог на прибыль округляется до полных рублей
		
		НалоговыйУчет.ПолучитьСтавкуНалогаНаПрибыль(СтруктураПараметров, СтавкаФБ, СтавкаРФ);
		
		Если БазаНалогаЗаГод <> 0 Тогда
			
			// Федеральный бюджет
			СтрокаТаблицаСубъектов = ТаблицаСубъектов.НайтиСтроки(
				Новый Структура("КФО,ИФО,Субконто1", Строка.КФО, Строка.ИФО, Справочники.ВидыНалоговИПлатежей.ПрибыльФБ));
			СуммаНалогаПрошлогоМесяца = ?(СтрокаТаблицаСубъектов = Неопределено Или СтрокаТаблицаСубъектов.Количество() = 0,
				0, СтрокаТаблицаСубъектов[0].Налог);
			
			Если БазаНалогаЗаГод < 0 Тогда
				СуммаФередальногоНалога = -СуммаНалогаПрошлогоМесяца;
			Иначе
				СуммаФередальногоНалога = Окр(БазаНалогаЗаГод * СтавкаФБ, ТочностьРасчета) - СуммаНалогаПрошлогоМесяца;
			КонецЕсли;
			
			Если СуммаФередальногоНалога <> 0  Тогда
				
				Запись = ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, Строка, "КФО, ИФО");
				Запись.ВидНалога = Справочники.ВидыНалоговИПлатежей.ПрибыльФБ;
				Запись.Сумма = СуммаФередальногоНалога;
				
			КонецЕсли;
			
			// Бюджет субъекта РФ
			СтрокаТаблицаСубъектов = ТаблицаСубъектов.НайтиСтроки(
				Новый Структура("КФО,ИФО,Субконто1", Строка.КФО, Строка.ИФО, Справочники.ВидыНалоговИПлатежей.ПрибыльРБ));
			СуммаНалогаПрошлогоМесяца = ?(СтрокаТаблицаСубъектов = Неопределено Или СтрокаТаблицаСубъектов.Количество() = 0,
			0, СтрокаТаблицаСубъектов[0].Налог);
			
			Если БазаНалогаЗаГод < 0 Тогда
				СуммаНалогаДляОдногоСубъекта = -СуммаНалогаПрошлогоМесяца;
			Иначе
				СуммаНалогаДляОдногоСубъекта =  Окр(БазаНалогаЗаГод * СтавкаРФ, ТочностьРасчета) - СуммаНалогаПрошлогоМесяца;
			КонецЕсли;
			
			Если СуммаНалогаДляОдногоСубъекта <> 0 Тогда
				
				Запись = ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, Строка, "КФО, ИФО");
				Запись.ВидНалога = Справочники.ВидыНалоговИПлатежей.ПрибыльРБ;
				Запись.Сумма = СуммаНалогаДляОдногоСубъекта;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль;
	
КонецФункции

// Распределение налога на прибыль по аналитике счета 401.10
//
Функция РаспределитьНалогНаПрибыльПоДоходам(СтруктураПараметров, ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль) Экспорт
	
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	НалогНаПрибыльРаспределенный = ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль.СкопироватьКолонки();
	Колонки = НалогНаПрибыльРаспределенный.Колонки;
	Колонки.Добавить("СчетДт",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Колонки.Добавить("КПСДт",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Колонки.Добавить("КЭКДт",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Колонки.Добавить("ПодразделениеДт", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Колонки.Добавить("СубконтоДт1",     ОписаниеТиповСубконто);
	Колонки.Добавить("СубконтоДт2",     ОписаниеТиповСубконто);
	Колонки.Добавить("СубконтоДт3",     ОписаниеТиповСубконто);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.ИФО,
	|	ВложенныйЗапрос.КФО,
	|	ВложенныйЗапрос.СчетДебета КАК СчетДт,
	|	ВложенныйЗапрос.КПС КАК КПСДт,
	|	ВложенныйЗапрос.КЭК КАК КЭКДт,
	|	ВложенныйЗапрос.Подразделение КАК ПодразделениеДт,
	|	ВложенныйЗапрос.СубконтоСчетДебета1 КАК СубконтоДт1,
	|	ВложенныйЗапрос.СубконтоСчетДебета2 КАК СубконтоДт2,
	|	ВложенныйЗапрос.СубконтоСчетДебета3 КАК СубконтоДт3,
	|	СУММА(ВложенныйЗапрос.БазаРаспределения) КАК БазаРаспределения
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУОбороты.ИФО КАК ИФО,
	|		ЕПСБУОбороты.КФО КАК КФО,
	|		ЕПСБУОбороты.Счет КАК СчетДебета,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям
	|					И ЕПСБУОбороты.Счет.УчетПоПодразделениям
	|				ТОГДА ЕПСБУОбороты.Подразделение
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ КАК Подразделение,
	|		ЕПСБУОбороты.КПС КАК КПС,
	|		ЕПСБУОбороты.КЭК КАК КЭК,
	|		ЕПСБУОбороты.Субконто1 КАК СубконтоСчетДебета1,
	|		ЕПСБУОбороты.Субконто2 КАК СубконтоСчетДебета2,
	|		ЕПСБУОбороты.Субконто3 КАК СубконтоСчетДебета3,
	|		ЕПСБУОбороты.СуммаОборотКт - ЕПСБУОбороты.СуммаОборотДт КАК БазаРаспределения
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|				&НачалоМесяца,
	|				&КонецМесяца,
	|				,
	|				Счет В (&СчетаДоходыТекущегоГода),
	|				,
	|				Организация = &Организация
	|					И &УсловиеКФО
	|					И &УсловиеИФО,
	|				,
	|				) КАК ЕПСБУОбороты
	|	ГДЕ
	|		ЕПСБУОбороты.СуммаОборотКт - ЕПСБУОбороты.СуммаОборотДт > 0) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ИФО,
	|	ВложенныйЗапрос.КФО,
	|	ВложенныйЗапрос.СчетДебета,
	|	ВложенныйЗапрос.КПС,
	|	ВложенныйЗапрос.КЭК,
	|	ВложенныйЗапрос.Подразделение,
	|	ВложенныйЗапрос.СубконтоСчетДебета1,
	|	ВложенныйЗапрос.СубконтоСчетДебета2,
	|	ВложенныйЗапрос.СубконтоСчетДебета3";
	
	Запрос.УстановитьПараметр("НачалоМесяца",            НачалоМесяца(СтруктураПараметров.Дата));
	Запрос.УстановитьПараметр("КонецМесяца",             КонецМесяца(СтруктураПараметров.Дата));
	Запрос.УстановитьПараметр("Организация",             СтруктураПараметров.Организация);
	Запрос.УстановитьПараметр("СчетаДоходыТекущегоГода", БухгалтерскийУчет.СписокСчетов("401.10"));
	
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",
		ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	Если ЗначениеЗаполнено(СтруктураПараметров.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", СтруктураПараметров.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(СтруктураПараметров.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", СтруктураПараметров.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	ТаблицаБазаРаспределения = Запрос.Выполнить().Выгрузить();
	Если ТаблицаБазаРаспределения.Количество() > 0 Тогда
		
		НачислениеНалогаНаПрибыльПоКЭК189 = НалоговыйУчетКлиентСервер.НачислениеНалогаНаПрибыльПоКЭК189(СтруктураПараметров.Дата);
		Если НачислениеНалогаНаПрибыльПоКЭК189 Тогда // Уберем КПС и КЭК из базы распределения.
			ТаблицаБазаРаспределения.Свернуть("ИФО,КФО,СчетДт,ПодразделениеДт,СубконтоДт1,СубконтоДт2,СубконтоДт3", "БазаРаспределения");
		КонецЕсли;
		
		Для Каждого СтрокаТаблицы Из ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль Цикл
			
			НайденныеСтроки = ТаблицаБазаРаспределения.НайтиСтроки(
				Новый Структура("КФО, ИФО", СтрокаТаблицы.КФО, СтрокаТаблицы.ИФО));
			
			МассивКоэффициентов = Новый Массив;
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				МассивКоэффициентов.Добавить(НайденнаяСтрока.БазаРаспределения);
			КонецЦикла;
			
			МассивСумм = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
				СтрокаТаблицы.Сумма, МассивКоэффициентов);
			Если МассивСумм = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Инд = 0 По МассивСумм.Количество() - 1 Цикл
				
				СтрокаБазыРаспределения = НайденныеСтроки[Инд];
				
				НоваяСтрока = НалогНаПрибыльРаспределенный.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаБазыРаспределения);
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "ВидНалога, НалогСборПлатеж");
				НоваяСтрока.Сумма = МассивСумм[Инд];
				
				Если НачислениеНалогаНаПрибыльПоКЭК189 Тогда
					НоваяСтрока.КПСДт = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
					НоваяСтрока.КЭКДт = БухгалтерскийУчетПовтИсп.КЭКПоКоду("189");
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат НалогНаПрибыльРаспределенный;
	
КонецФункции

#Область УчетОсновныхСредств

// Структура таблицы источника данных "Стоимость кап.вложений НУ".
//
Функция ПустаяТаблицаСписаниеКапВложенийНУ() Экспорт

	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	ПустаяТаблица.Колонки.Добавить("ИдентификаторСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(36));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("СчетУчета",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("ЦМО",           Новый ОписаниеТипов("СправочникСсылка.ЦМО")); // Заполняется, если на счете Н08 ведется учет остатков по ЦМО.
	// Объект ОС, НМА, НПА.
	ПустаяТаблица.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	// Количественные и суммовые характеристики.
	ПустаяТаблица.Колонки.Добавить("Количество",                      ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СтоимостьЕдиницыБУ",              ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СтоимостьЕдиницыНУ",              ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СтоимостьЕдиницыНеУчитываетсяНУ", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СтоимостьЕдиницыЕНВД",            ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СтоимостьБУ",                     ОписаниеТипаСуммы); // Стоимость для целей бухгалтерского учета.
	ПустаяТаблица.Колонки.Добавить("СтоимостьНУ",                     ОписаниеТипаСуммы); // Стоимость для целей налогового учета.
	ПустаяТаблица.Колонки.Добавить("СтоимостьНеУчитываетсяНУ",        ОписаниеТипаСуммы); // Стоимость, не учитываемая для целей налогового учета.
	ПустаяТаблица.Колонки.Добавить("СтоимостьЕНВД",                   ОписаниеТипаСуммы); // Стоимость, относящаяся к особым системам налогообложения.
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Реализация основных средств".
//
Функция ТаблицаСписаниеКапВложенийНУ(ТаблицаДокумента, Реквизиты) Экспорт
	
	ТаблицаСписанных = ПустаяТаблицаСписаниеКапВложенийНУ();
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	// Остатки кап.вложений со счетов бухгалтерского и налогового учета.
	Если Реквизиты.Свойство("ПериодОстатков") и ЗначениеЗаполнено(Реквизиты.ПериодОстатков) Тогда
		ПериодОстатков = Реквизиты.ПериодОстатков;
	ИначеЕсли Реквизиты.Ссылка.Пустая() Тогда
		ПериодОстатков = Новый Граница(КонецДня(Реквизиты.Дата), ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	ОстаткиКапВложенийНУ = ОстаткиКапВложенийНУ(ПериодОстатков, ТаблицаДокумента, Реквизиты);
	
	ВедетсяУчетПоПодразделениям = НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоПодразделениям(Реквизиты.Дата);
	ВедетсяУчетПоКПС = НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоКПС(Реквизиты.Дата);
	ВедетсяУчетПоЦМО = НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоЦМО(Реквизиты.Дата);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		Если НЕ НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаДокумента.КФО) Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("КФО,ОсновноеСредство",
			СтрокаДокумента.КФО,
			СтрокаДокумента.ОсновноеСредство);
		
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", СтрокаДокумента.ИФО);
		КонецЕсли;
		Если ВедетсяУчетПоКПС Тогда
			Отбор.Вставить("КПС", СтрокаДокумента.КПС);
		КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И ВедетсяУчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", СтрокаДокумента.Подразделение);
		КонецЕсли;
		Если ВедетсяУчетПоЦМО Тогда
			Отбор.Вставить("ЦМО", СтрокаДокумента.ЦМО);
		КонецЕсли;
		
		НайденныеОстаткиКапВложенийНУ = ОстаткиКапВложенийНУ.НайтиСтроки(Отбор);
		Для Каждого ОстатокКапВложенийНУ Из НайденныеОстаткиКапВложенийНУ Цикл
			
			Если ОстатокКапВложенийНУ.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаСписанных.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИдентификаторСтроки,
				|ОсновноеСредство,СчетУчета,
				|Количество,СтоимостьЕдиницыБУ,СтоимостьБУ");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстатокКапВложенийНУ,
				"ИФО,КФО,КПС,Подразделение,ЦМО");
			
			КоличествоВДокументе = ?(СтрокаДокумента.Количество = 0, 1, СтрокаДокумента.Количество);
			
			Если СтрокаДокумента.Количество = ОстатокКапВложенийНУ.Количество Тогда // Списываем весь остаток.
				
				НоваяСтрока.СтоимостьНУ              = ОстатокКапВложенийНУ.СтоимостьНУ;
				НоваяСтрока.СтоимостьНеУчитываетсяНУ = ОстатокКапВложенийНУ.СтоимостьНеУчитываетсяНУ;
				НоваяСтрока.СтоимостьЕНВД            = ОстатокКапВложенийНУ.СтоимостьЕНВД;
				
				НоваяСтрока.СтоимостьЕдиницыНУ              = НоваяСтрока.СтоимостьНУ / КоличествоВДокументе;
				НоваяСтрока.СтоимостьЕдиницыНеУчитываетсяНУ = НоваяСтрока.СтоимостьНеУчитываетсяНУ / КоличествоВДокументе;
				НоваяСтрока.СтоимостьЕдиницыЕНВД            = НоваяСтрока.СтоимостьЕНВД / КоличествоВДокументе;
				
			Иначе // Рассчитываем пропорционально списанному количеству.
				
				КоэффициентСписания = КоличествоВДокументе / ОстатокКапВложенийНУ.Количество;
				
				НоваяСтрока.СтоимостьЕдиницыНУ              = КоэффициентСписания * ОстатокКапВложенийНУ.СтоимостьНУ / КоличествоВДокументе;
				НоваяСтрока.СтоимостьЕдиницыНеУчитываетсяНУ = КоэффициентСписания * ОстатокКапВложенийНУ.СтоимостьНеУчитываетсяНУ / КоличествоВДокументе;
				НоваяСтрока.СтоимостьЕдиницыЕНВД            = КоэффициентСписания * ОстатокКапВложенийНУ.СтоимостьЕНВД / КоличествоВДокументе;
				
				НоваяСтрока.СтоимостьНУ              = КоличествоВДокументе * НоваяСтрока.СтоимостьЕдиницыНУ;
				НоваяСтрока.СтоимостьНеУчитываетсяНУ = КоличествоВДокументе * НоваяСтрока.СтоимостьЕдиницыНеУчитываетсяНУ;
				НоваяСтрока.СтоимостьЕНВД            = КоличествоВДокументе * НоваяСтрока.СтоимостьЕдиницыЕНВД;
				
			КонецЕсли;
			
			// Учтем списанные кап.вложения в таблице остатков.
			ОстатокКапВложенийНУ.Количество               = ОстатокКапВложенийНУ.Количество               - НоваяСтрока.Количество;
			ОстатокКапВложенийНУ.СтоимостьНУ              = ОстатокКапВложенийНУ.СтоимостьНУ              - НоваяСтрока.СтоимостьНУ;
			ОстатокКапВложенийНУ.СтоимостьНеУчитываетсяНУ = ОстатокКапВложенийНУ.СтоимостьНеУчитываетсяНУ - НоваяСтрока.СтоимостьНеУчитываетсяНУ;
			ОстатокКапВложенийНУ.СтоимостьЕНВД            = ОстатокКапВложенийНУ.СтоимостьЕНВД            - НоваяСтрока.СтоимостьЕНВД;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаСписанных;
	
КонецФункции

// Подготавливает таблицу документа (в унифицированном формате) для учета списания (выбытия) кап.вложений для целей налогового учета.
//
Функция ПодготовитьТаблицуСписаниеКапВложенийНУПоДокументу(Документ, Параметры = Неопределено) Экспорт
	
	ТаблицаДокумента = ПустаяТаблицаСписаниеКапВложенийНУПоДокументу();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КФО", НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета());
	
	МетаданныеДокумента = Документ.Метаданные();
	ЕстьТабЧастьОсновныеСредства = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("ОсновныеСредства", МетаданныеДокумента);
	
	Если МетаданныеДокумента.Имя = "НакладнаяНаВнутреннееПеремещениеОС2" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ОсновныеСредства",
			"НомерСтроки,ИФО,КФО,КПС,ПодразделениеОтправитель,СчетУчета,
			|ОсновноеСредство,ЦМООтправитель,Количество,Цена,Сумма",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""ОсновныеСредства"" КАК ИмяСписка,
		|	""Основные cредства"" КАК СинонимСписка,
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ИФО КАК ИФО,
		|	ОсновныеСредства.КФО КАК КФО,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.ПодразделениеОтправитель КАК Подразделение,
		|	ОсновныеСредства.СчетУчета КАК СчетУчета,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ОсновноеСредство.ВидНФА КАК ВидНФА,
		|	ОсновныеСредства.ЦМООтправитель КАК ЦМО,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.Цена КАК СтоимостьЕдиницыБУ,
		|	ОсновныеСредства.Сумма КАК СтоимостьБУ
		|ИЗ
		|	ТаблицаОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.КФО В(&КФО)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	ИначеЕсли МетаданныеДокумента.Имя = "СписаниеОбъектовОС" Тогда // СписаниеОбъектовОС
		
		Параметры.Вставить("ИдентификаторСтроки", ""); // Пустой идентификатор, если таб.часть ОсновныеСредства не содержит реквизита ИдентификаторСтроки.
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""ОсновныеСредства"" КАК ИмяСписка,
		|	""Основные средства"" КАК СинонимСписка,
		|	СписаниеОбъектовОСОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	СписаниеОбъектовОСОсновныеСредства.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СписаниеОбъектовОСОсновныеСредства.Ссылка.ИФО КАК ИФО,
		|	ВЫБОР
		|		КОГДА СписаниеОбъектовОСОсновныеСредства.Ссылка.КФОВТабличнойЧасти
		|			ТОГДА СписаниеОбъектовОСОсновныеСредства.КФО
		|		ИНАЧЕ СписаниеОбъектовОСОсновныеСредства.Ссылка.КФО
		|	КОНЕЦ КАК КФО,
		|	СписаниеОбъектовОСОсновныеСредства.КПС КАК КПС,
		|	СписаниеОбъектовОСОсновныеСредства.Ссылка.Подразделение КАК Подразделение,
		|	СписаниеОбъектовОСОсновныеСредства.СчетУчета КАК СчетУчета,
		|	СписаниеОбъектовОСОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	СписаниеОбъектовОСОсновныеСредства.ОсновноеСредство.ВидНФА КАК ВидНФА,
		|	СписаниеОбъектовОСОсновныеСредства.Ссылка.ЦМО КАК ЦМО,
		|	СписаниеОбъектовОСОсновныеСредства.Количество КАК Количество,
		|	СписаниеОбъектовОСОсновныеСредства.СтоимостьЕдиницы КАК СтоимостьЕдиницыБУ,
		|	СписаниеОбъектовОСОсновныеСредства.Сумма КАК СтоимостьБУ
		|ИЗ
		|	Документ.СписаниеОбъектовОС.ОсновныеСредства КАК СписаниеОбъектовОСОсновныеСредства
		|ГДЕ
		|	СписаниеОбъектовОСОсновныеСредства.Ссылка = &ДокументИсточник
		|	И ВЫБОР
		|		КОГДА СписаниеОбъектовОСОсновныеСредства.Ссылка.КФОВТабличнойЧасти
		|			ТОГДА СписаниеОбъектовОСОсновныеСредства.КФО
		|		ИНАЧЕ СписаниеОбъектовОСОсновныеСредства.Ссылка.КФО
		|	КОНЕЦ В (&КФО)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		Запрос.УстановитьПараметр("ДокументИсточник", Документ);
		
	ИначеЕсли ЕстьТабЧастьОсновныеСредства Тогда // ПередачаОбъектовОС
		
		Параметры.Вставить("ИдентификаторСтроки", ""); // Пустой идентификатор, если таб.часть ОсновныеСредства не содержит реквизита ИдентификаторСтроки.
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ОсновныеСредства",
			"НомерСтроки,ИдентификаторСтроки,ИФО,КФО,КПС,Подразделение,СчетУчета,
			|ОсновноеСредство,ЦМО,Количество,СтоимостьЕдиницы,Сумма",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""ОсновныеСредства"" КАК ИмяСписка,
		|	""Основные cредства"" КАК СинонимСписка,
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ОсновныеСредства.ИФО КАК ИФО,
		|	ОсновныеСредства.КФО КАК КФО,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.Подразделение КАК Подразделение,
		|	ОсновныеСредства.СчетУчета КАК СчетУчета,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ОсновноеСредство.ВидНФА КАК ВидНФА,
		|	ОсновныеСредства.ЦМО КАК ЦМО,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.СтоимостьЕдиницы КАК СтоимостьЕдиницыБУ,
		|	ОсновныеСредства.Сумма КАК СтоимостьБУ
		|ИЗ
		|	ТаблицаОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.КФО В(&КФО)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	Иначе // СписаниеТранспорта
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Документ",
			"ИФО,КФО,КПС,Подразделение,СчетУчета,
			|ОсновноеСредство,ЦМО,Количество,Сумма",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ОсновныеСредства.ИФО КАК ИФО,
		|	ОсновныеСредства.КФО КАК КФО,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.Подразделение КАК Подразделение,
		|	ОсновныеСредства.СчетУчета КАК СчетУчета,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ОсновноеСредство.ВидНФА КАК ВидНФА,
		|	ОсновныеСредства.ЦМО КАК ЦМО,
		|	1 КАК Количество,
		|	ОсновныеСредства.Сумма КАК СтоимостьЕдиницыБУ,
		|	ОсновныеСредства.Сумма КАК СтоимостьБУ
		|ИЗ
		|	Документ КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.КФО В(&КФО)";
		
	КонецЕсли;
	
	СписаниеКапВложенийНУ = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из СписаниеКапВложенийНУ Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Остатки кап.вложений для целей налогового учета.
//
Функция ОстаткиКапВложенийНУ(Период, ТаблицаДокумента, Реквизиты) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МоментВремени", Период);
	Запрос.УстановитьПараметр("Организация",   Реквизиты.Организация);
	Запрос.УстановитьПараметр("Счет106",       БухгалтерскийУчет.СписокСчетов("106.00"));
	Запрос.УстановитьПараметр("СчетН08",       БухгалтерскийУчет.СписокСчетов("Н08"));
	
	// Поддерживается 2 режима ведения учета на счете Н08 "Вложения во внеоборотные активы":
	// 1. Упрощенный (по умолчанию). Остатки НУ ведутся только в разрезе объектов основных средств. Учет по КПС не ведется.
	// Виды субконто «ЦМО» и «Виды затрат» оборотные, остатки по ним не накапливаются.
	// Информация в разрезе ЦМО и видов затрат фиксируется при аккумулировании кап.вложений по дебету счета Н08.
	// При списании (выбытии) с кредита счета Н08 списывается общая сумма вложений по объекту, без детализации по ЦМО и видам затрат.
	// 2. По аналогии с БУ. Остатки НУ ведутся в тех же разрезах, что и остатки на 106.00 - в разрезе объектов основных средств, КПС и ЦМО.
	// Вид субконто «Виды затрат» оборотный, остатки по нему не накапливаются.
	// Информация в разрезе видов затрат фиксируется при аккумулировании кап.вложений по дебету счета Н08.
	// При списании (выбытии) с кредита счета Н08 списывается общая сумма вложений по объекту и выбранным ЦМО и КПС, без детализации по видам затрат.
	//
	// Опционально к режимам 1 и 2 на счете Н08 может быть установлен учет по подразделениям.
	// Количественный учет по счету Н08 не ведется, количество вложений определяется по данным бух.учета.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ЦМО) КАК ЦМО,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.СуммаОстатокДт КАК СтоимостьНУ,
	|	Остатки.СуммаНеУчитываетсяНУОстатокДт КАК СтоимостьНеУчитываетсяНУ,
	|	Остатки.СуммаЕНВДОстатокДт КАК СтоимостьЕНВД
	|ПОМЕСТИТЬ ОстаткиСтоимостьКапВложенийНУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&МоментВремени,
	|			Счет В (&СчетН08),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И КФО В (&КФО)
	|				И &УсловиеИФО
	|				И &УсловиеКПС
	|				И &УсловиеПодразделение
	|				И &УсловиеЦМО
	|				И Субконто1 В (&СписокОС)) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ЦМО) КАК ЦМО,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.КоличествоОстатокДт КАК Количество
	|ПОМЕСТИТЬ ОстаткиКоличествоКапВложенийБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&МоментВремени,
	|			Счет В (&Счет106),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И КФО В (&КФО)
	|				И &УсловиеИФО
	|				И &УсловиеКПС
	|				И &УсловиеПодразделение
	|				И &УсловиеЦМО
	|				И Субконто1 В (&СписокОС)) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.ОсновноеСредство КАК ОсновноеСредство,
	|	ВложенныйЗапрос.ЦМО КАК ЦМО,
	|	ВложенныйЗапрос.ИФО КАК ИФО,
	|	ВложенныйЗапрос.КФО КАК КФО,
	|	ВложенныйЗапрос.КПС КАК КПС,
	|	ВложенныйЗапрос.Подразделение КАК Подразделение,
	|	СУММА(ВложенныйЗапрос.СтоимостьНУ) КАК СтоимостьНУ,
	|	СУММА(ВложенныйЗапрос.СтоимостьНеУчитываетсяНУ) КАК СтоимостьНеУчитываетсяНУ,
	|	СУММА(ВложенныйЗапрос.СтоимостьЕНВД) КАК СтоимостьЕНВД,
	|	СУММА(ВложенныйЗапрос.Количество) КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОстаткиСтоимостьКапВложенийНУ.ОсновноеСредство КАК ОсновноеСредство,
	|		ОстаткиСтоимостьКапВложенийНУ.ЦМО КАК ЦМО,
	|		ОстаткиСтоимостьКапВложенийНУ.ИФО КАК ИФО,
	|		ОстаткиСтоимостьКапВложенийНУ.КФО КАК КФО,
	|		ОстаткиСтоимостьКапВложенийНУ.КПС КАК КПС,
	|		ОстаткиСтоимостьКапВложенийНУ.Подразделение КАК Подразделение,
	|		ОстаткиСтоимостьКапВложенийНУ.СтоимостьНУ КАК СтоимостьНУ,
	|		ОстаткиСтоимостьКапВложенийНУ.СтоимостьНеУчитываетсяНУ КАК СтоимостьНеУчитываетсяНУ,
	|		ОстаткиСтоимостьКапВложенийНУ.СтоимостьЕНВД КАК СтоимостьЕНВД,
	|		0 КАК Количество
	|	ИЗ
	|		ОстаткиСтоимостьКапВложенийНУ КАК ОстаткиСтоимостьКапВложенийНУ
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ОстаткиКоличествоКапВложенийБУ.ОсновноеСредство,
	|		ОстаткиКоличествоКапВложенийБУ.ЦМО,
	|		ОстаткиКоличествоКапВложенийБУ.ИФО,
	|		ОстаткиКоличествоКапВложенийБУ.КФО,
	|		ОстаткиКоличествоКапВложенийБУ.КПС,
	|		ОстаткиКоличествоКапВложенийБУ.Подразделение,
	|		0,
	|		0,
	|		0,
	|		ОстаткиКоличествоКапВложенийБУ.Количество
	|	ИЗ
	|		ОстаткиКоличествоКапВложенийБУ КАК ОстаткиКоличествоКапВложенийБУ) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ОсновноеСредство,
	|	ВложенныйЗапрос.ЦМО,
	|	ВложенныйЗапрос.ИФО,
	|	ВложенныйЗапрос.КФО,
	|	ВложенныйЗапрос.КПС,
	|	ВложенныйЗапрос.Подразделение";
	
	Запрос.УстановитьПараметр("СписокОС", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("ОсновноеСредство")));
	Запрос.УстановитьПараметр("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("КФО")));
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО В (&ИФО)");
		Запрос.УстановитьПараметр("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("ИФО")));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	ВедетсяУчетПоПодразделениям = НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоПодразделениям(Реквизиты.Дата);
	ВедетсяУчетПоКПС = НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоКПС(Реквизиты.Дата);
	ВедетсяУчетПоЦМО = НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоЦМО(Реквизиты.Дата);
	
	Если ВедетсяУчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "Подразделение В (&Подразделение)");
		Запрос.УстановитьПараметр("Подразделение", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("Подразделение")));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ИСТИНА");
	КонецЕсли;
	
	Если ВедетсяУчетПоКПС Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС", "КПС В (&КПС)");
		Запрос.УстановитьПараметр("КПС", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("КПС")));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.КПС", "ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС", "ИСТИНА");
	КонецЕсли;
	
	Если ВедетсяУчетПоЦМО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЦМО", "Субконто2 В (&ЦМО)");
		Запрос.УстановитьПараметр("ЦМО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("ЦМО")));
		ВидыСубконто = Новый Массив;
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
		Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.ЦМО)", "ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЦМО", "ИСТИНА");
		ВидыСубконто = Новый Массив;
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
		Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Область ЗакрытиеСчетовПроизводственныхЗатрат

// Функция рассчитывает доли списания косвенных расходов
// и сохраняет результат расчета в документе
//
Функция РассчитатьДолиСписанияКосвенныхРасходов(Период, Организация, ДокументОбъект) Экспорт
	
	// Распределение расходов по видам деятельности
	ДокументОбъект.ДоляЕНВД = КоэффициентРаспределенияРасходовПоВидамДеятельности(Организация, Период); // За месяц
	Если ДокументОбъект.ДоляРасходовНеУчитываетсяНУ <> 0 Тогда
		ДокументОбъект.ДоляЕНВД = ДокументОбъект.ДоляЕНВД * (1 - ДокументОбъект.ДоляРасходовНеУчитываетсяНУ);
	КонецЕсли;
	
	// Транспортные расходы могут быть отнесены к остаткам нереализованных товаров - ст. 320 НК РФ
	ДокументОбъект.ДоляТранспортныхРасходов = ДоляТранспортныхРасходовТекущегоМесяца(Период, Организация);
	
	// РАСХОДЫ, ПО КОТОРЫМ ЕСТЬ ОГРАНИЧЕНИЯ
	Ограничения = ДолиСписанияНормируемыхРасходов(Период, Организация, ДокументОбъект);
	
	ВидыРасходов = Перечисления.ВидыРасходовНУ;
	ДокументОбъект.ДоляРасходовНаРекламу                                    = Ограничения[ВидыРасходов.РасходыНаРекламуНормируемые];
	ДокументОбъект.ДоляПредставительскихРасходов                            = Ограничения[ВидыРасходов.ПредставительскиеРасходы];
	ДокументОбъект.ДоляРасходовНаДобровольноеМедицинскоеСтрахование         = Ограничения[ВидыРасходов.ДобровольноеЛичноеСтрахование];
	ДокументОбъект.ДоляРасходовНаДобровольноеСтрахованиеЖизни               = Ограничения[ВидыРасходов.ДобровольноеСтрахованиеПоДоговорамДолгосрочногоСтрахованияЖизниРаботников];
	ДокументОбъект.ДоляРасходовНаДобровольноеСтрахованиеОтНесчастныхСлучаев = Ограничения[ВидыРасходов.ДобровольноеЛичноеСтрахованиеНаСлучайСмертиИлиУтратыРаботоспособности];;
	ДокументОбъект.ДоляРасходовНаВозмещениеПроцентовРаботникам              = Ограничения[ВидыРасходов.РасходыНаВозмещениеЗатратРаботниковПоУплатеПроцентов];
	
	Возврат Ограничения;
	
КонецФункции

// Определяет коэффициент распределения расходов по видам деятельности с разным порядком налогообложения.
//
// Параметры
//  Организация - СправочникСсылка.Организации или массив со значениями этого типа.
//  НачалоПериода - Дата - начало периода, за который рассчитывается коэффициент. Период всегда кратен месяцу.
//  КонецПериода - Дата - (необязательный) конец периода, за который рассчитывается коэффициент. Период всегда кратен месяцу.
//
// Возвращаемое значение:
//   Число - коэффициент распределения расходов по видам деятельности.
//
Функция КоэффициентРаспределенияРасходовПоВидамДеятельности(Организация, Знач НачалоПериода, Знач КонецПериода = Неопределено) Экспорт
	
	// Период
	Если КонецПериода = Неопределено Тогда
		КонецПериода = НачалоПериода;
	КонецЕсли;
	НачалоПериода = НачалоМесяца(НачалоПериода);
	КонецПериода  = КонецМесяца(КонецПериода);
	
	// База распределения
	УчетнаяПолитика = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(Организация, КонецПериода);
	ВключатьПрочиеДоходы = (УчетнаяПолитика.БазаРаспределенияКосвенныхРасходовПоВидамДеятельности =
		Перечисления.БазыРаспределенияКосвенныхРасходовПоВидамДеятельности.ДоходыОтРеализацииИВнереализационные);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода",        НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",         КонецПериода);
	Запрос.УстановитьПараметр("Организация",          Организация);
	
	Если ВключатьПрочиеДоходы Тогда
		Запрос.УстановитьПараметр("СчетаДоходов", БухгалтерскийУчет.СписокСчетов("Н90.01,Н90.02,Н91.01"));
	Иначе
		Запрос.УстановитьПараметр("СчетаДоходов", БухгалтерскийУчет.СписокСчетов("Н90.01,Н90.02"));
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУОбороты.СуммаОборотКт КАК СуммаОсновнаяСистема,
	|	ЕПСБУОбороты.СуммаЕНВДОборотКт КАК СуммаОсобыйПорядок
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, , Счет В (&СчетаДоходов), , Организация В (&Организация), , ) КАК ЕПСБУОбороты";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий(); // В выборке всегда ровно один элемент
	
	Если Выборка.СуммаОсновнаяСистема + Выборка.СуммаОсобыйПорядок = 0 Тогда
		// Если нет определенности, то считаем, что все расходы относятся к деятельности на основной системе обложения
		Возврат 0;
	Иначе
		Возврат Выборка.СуммаОсобыйПорядок / (Выборка.СуммаОсновнаяСистема + Выборка.СуммаОсобыйПорядок);
	КонецЕсли;
	
КонецФункции

Функция ДоляПриносящейДоходДеятельности(Знач НачалоПериода, Знач КонецПериода, Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОбороты.Организация КАК Организация,
	|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборотКт КАК СуммаОборотКт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&НачалоПериода, &КонецПериода, , Счет В (&СчетаДоходов), , Организация = &Организация, , ) КАК ЖурналПроводокЕПСБУОбороты";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);
	Запрос.УстановитьПараметр("Организация",   Организация);
	Запрос.УстановитьПараметр("СчетаДоходов",  БухгалтерскийУчет.СписокСчетов("401.10"));
	
	// Пункт 1 статьи 272 НК РФ "Расходы налогоплательщика, которые не могут быть непосредственно отнесены на затраты по конкретному виду деятельности,
	// распределяются пропорционально доле соответствующего дохода в суммарном объеме всех доходов налогоплательщика".
	ДоходыПоПриносящейДоходДеятельности = 0;
	ДоходыСуммарныйОбъем = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.КФО = Перечисления.КВД.Внебюджет Тогда
			ДоходыПоПриносящейДоходДеятельности = ДоходыПоПриносящейДоходДеятельности + Выборка.СуммаОборотКт;
		КонецЕсли;
		ДоходыСуммарныйОбъем = ДоходыСуммарныйОбъем + Выборка.СуммаОборотКт;
	КонецЦикла;
	
	ДоляПриносящейДоходДеятельности = ?(ДоходыСуммарныйОбъем = 0, 0, ДоходыПоПриносящейДоходДеятельности / ДоходыСуммарныйОбъем);
	
	Возврат ДоляПриносящейДоходДеятельности;
	
КонецФункции

#КонецОбласти

 #Область КурсовыеРазницыНУ

Функция ОтложенныеКурсовыеРазницыНУ(Период, ТаблицаОтбора, Реквизиты) Экспорт
	
	ПараметрыОтбора = Новый Структура;
	Если ТипЗнч(Реквизиты) = Тип("ДокументОбъект.ПереоценкаВалютныхОстатков") Тогда
		ПараметрыОтбора.Вставить("Организация", Реквизиты.Организация);
		Если ЗначениеЗаполнено(Реквизиты.Счет) Тогда
			ПараметрыОтбора.Вставить("СчетРасчетов", Реквизиты.Счет); // Отбор по счету в шапке.
		КонецЕсли;
	Иначе // Структура
		ПараметрыОтбора = Реквизиты;
		Если Реквизиты.Свойство("КорСчет") И ЗначениеЗаполнено(Реквизиты.КорСчет) Тогда
			ПараметрыОтбора.Вставить("СчетРасчетов", Реквизиты.КорСчет); // Из документа погашения задолженности.
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиНУ.Организация КАК Организация,
	|	ОстаткиНУ.ИФО КАК ИФО,
	|	ОстаткиНУ.КФО КАК КФО,
	|	ЕСТЬNULL(ОстаткиНУ.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(ОстаткиНУ.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ОстаткиНУ.Счет КАК Счет,
	|	ВЫРАЗИТЬ(ОстаткиНУ.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(ОстаткиНУ.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ОстаткиНУ.Субконто3 КАК ДокументРасчетов,
	|	-ОстаткиНУ.СуммаОстаток КАК ОстатокОтложенныхКурсовыхРазницНУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетаОтложенныхКурсовыхРазницНУ),
	|			,
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И КФО В (&КФО)
	|				И Субконто1 В (&Контрагенты)
	|				И &УсловиеПоДоговор) КАК ОстаткиНУ";
	
	Запрос.УстановитьПараметр("Период",      Период);
	Запрос.УстановитьПараметр("Организация", ПараметрыОтбора.Организация);
	
	Запрос.УстановитьПараметр("СчетаОтложенныхКурсовыхРазницНУ", БухгалтерскийУчет.СписокСчетов("Н92.01,Н92.02"));
	
	// ИФО.
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Если ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИФО В (&ИФО)");
		Запрос.УстановитьПараметр("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ТаблицаОтбора.ВыгрузитьКолонку("ИФО")) );
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИСТИНА");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОтбора.ВыгрузитьКолонку("КФО")));
	Запрос.УстановитьПараметр("Контрагенты", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОтбора.ВыгрузитьКолонку("Контрагент")));
	
	Если ПараметрыОтбора.Свойство("СчетРасчетов")
		И Не БухгалтерскийУчет.СчетВИерархии(ПараметрыОтбора.СчетРасчетов, "208.00") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоДоговор", "Субконто2 В (&Договоры)");
		Запрос.УстановитьПараметр("Договоры", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ТаблицаОтбора.ВыгрузитьКолонку("Договор")));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоДоговор", "ИСТИНА");
	КонецЕсли;
	
	ОтложенныеКурсовыеРазницыНУ = Запрос.Выполнить().Выгрузить();
	
	Возврат ОтложенныеКурсовыеРазницыНУ;
	
КонецФункции

Функция ПустаяТаблицаПереоценкаВалютныхОстатковНУ() Экспорт
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("ДокументРасчетов", ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов.ТипЗначения);
	
	// Отражение курсовых разниц в налоговом учете.
	ПустаяТаблица.Колонки.Добавить("СчетДтНУ", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СчетКтНУ", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СуммаКурсовыхРазницНУ", ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;
	
КонецФункции

Функция ТаблицаПереоценкаВалютныхОстатковНУ(ДокументОбъект) Экспорт
	
	ТаблицаПереоценкаВалютныхОстатковНУ = ПустаяТаблицаПереоценкаВалютныхОстатковНУ();
	
	Если НЕ НалоговыйУчет.ПлательщикНалогаНаПрибыль(ДокументОбъект.Организация, ДокументОбъект.Дата) Тогда
		Возврат ТаблицаПереоценкаВалютныхОстатковНУ;
	КонецЕсли;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Для Каждого СтрокаПереоценки Из ДокументОбъект.ТаблицаПереоценки Цикл
		
		Если НЕ НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаПереоценки.КФО) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаПереоценки.ВалютнаяСумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СчетИАналитикаРасчетов = Новый Структура;
		СчетИАналитикаРасчетов.Вставить("КФО",          СтрокаПереоценки.КФО);
		СчетИАналитикаРасчетов.Вставить("СчетРасчетов", СтрокаПереоценки.Счет);
		СчетИАналитикаРасчетов.Вставить("Контрагент",   СтрокаПереоценки.Субконто1);
		Если БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(СтрокаПереоценки.Счет) Тогда
			СчетИАналитикаРасчетов.Вставить("Договор", СтрокаПереоценки.Субконто2);
		Иначе
			СчетИАналитикаРасчетов.Вставить("Договор", Справочники.Договоры.ПустаяСсылка());
		КонецЕсли;
		Если БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДокументамРасчетов(СтрокаПереоценки.Счет) Тогда
			СчетИАналитикаРасчетов.Вставить("ДокументРасчетов", СтрокаПереоценки.Субконто3);
		Иначе
			СчетИАналитикаРасчетов.Вставить("ДокументРасчетов", Неопределено);
		КонецЕсли;
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаПереоценки.Счет);
		Если ИспользоватьУчетПоИФО Тогда
			СчетИАналитикаРасчетов.Вставить("ИФО", СтрокаПереоценки.ИФО);
		Иначе
			СчетИАналитикаРасчетов.Вставить("ИФО", Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
		КонецЕсли;
		Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
			СчетИАналитикаРасчетов.Вставить("КПС", СтрокаПереоценки.КПС);
		Иначе
			СчетИАналитикаРасчетов.Вставить("КПС", Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
		КонецЕсли;
		Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			СчетИАналитикаРасчетов.Вставить("Подразделение", СтрокаПереоценки.Подразделение);
		Иначе
			СчетИАналитикаРасчетов.Вставить("Подразделение", Справочники.Подразделения.ПустаяСсылка());
		КонецЕсли;
		
		ПогаситьКурсоваяРазница = ?(СтрокаПереоценки.КурсоваяРазница > 0, СтрокаПереоценки.КурсоваяРазница, -СтрокаПереоценки.КурсоваяРазница);
		
		Если (БухгалтерскийУчет.СчетВИерархии(СтрокаПереоценки.Счет, "205.00, 207.00, 209.00") И СтрокаПереоценки.КурсоваяРазница > 0)
		 ИЛИ (БухгалтерскийУчет.СчетВИерархии(СтрокаПереоценки.Счет, "208.00, 301.00, 302.00") И СтрокаПереоценки.КурсоваяРазница < 0)
		Тогда // Положительная курсовая разница.
			
			Если СтрокаПереоценки.ОтложенныеКурсовыеРазницыНУ < 0 Тогда // Есть доступная отложенная отрицательная курсовая разница.
				
				// Зачитываем отложенную отрицательную.
				НоваяСтрока = ТаблицаПереоценкаВалютныхОстатковНУ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПереоценки, "НомерСтроки");
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СчетИАналитикаРасчетов,
					"ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ДокументРасчетов");
				НоваяСтрока.СчетДтНУ = БухгалтерскийУчет.СчетПоКоду("НПВ");
				НоваяСтрока.СчетКтНУ = БухгалтерскийУчет.СчетПоКоду("Н92.02");
				НоваяСтрока.СуммаКурсовыхРазницНУ = Мин(ПогаситьКурсоваяРазница, -СтрокаПереоценки.ОтложенныеКурсовыеРазницыНУ);
				
				ПогаситьКурсоваяРазница = ПогаситьКурсоваяРазница - НоваяСтрока.СуммаКурсовыхРазницНУ;
				
			КонецЕсли;
			
			Если ПогаситьКурсоваяРазница > 0 Тогда // Есть остаток после зачета отложенных курсовых разниц.
				
				НоваяСтрока = ТаблицаПереоценкаВалютныхОстатковНУ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПереоценки, "НомерСтроки");
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СчетИАналитикаРасчетов,
					"ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ДокументРасчетов");
				
				Если ДокументОбъект.ОтложитьПоложительныеКурсовыеРазницыНУ Тогда // Отражаем отложенные курсовые разницы (НУ).
					// Отражаем отложенную положительную на оставшуюся часть.
					НоваяСтрока.СчетДтНУ = БухгалтерскийУчет.СчетПоКоду("НПВ");
					НоваяСтрока.СчетКтНУ = БухгалтерскийУчет.СчетПоКоду("Н92.01");
					НоваяСтрока.СуммаКурсовыхРазницНУ = ПогаситьКурсоваяРазница;
				Иначе // Отражаем курсовые разницы во внереализационных доходах (НУ).
					НоваяСтрока.СчетДтНУ = БухгалтерскийУчет.СчетПоКоду("НПВ");
					НоваяСтрока.СчетКтНУ = БухгалтерскийУчет.СчетПоКоду("Н91.01");
					НоваяСтрока.СуммаКурсовыхРазницНУ = ПогаситьКурсоваяРазница;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли (БухгалтерскийУчет.СчетВИерархии(СтрокаПереоценки.Счет, "205.00, 207.00, 209.00") И СтрокаПереоценки.КурсоваяРазница < 0)
			  ИЛИ (БухгалтерскийУчет.СчетВИерархии(СтрокаПереоценки.Счет, "208.00, 301.00, 302.00") И СтрокаПереоценки.КурсоваяРазница > 0)
		Тогда // Отрицательная курсовая разница.
			
			Если СтрокаПереоценки.ОтложенныеКурсовыеРазницыНУ > 0 Тогда // Есть доступная отложенная положительная курсовая разница.
				
				// Зачитываем отложенную положительную.
				НоваяСтрока = ТаблицаПереоценкаВалютныхОстатковНУ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПереоценки, "НомерСтроки");
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СчетИАналитикаРасчетов,
					"ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ДокументРасчетов");
				НоваяСтрока.СчетДтНУ = БухгалтерскийУчет.СчетПоКоду("Н92.01");
				НоваяСтрока.СчетКтНУ = БухгалтерскийУчет.СчетПоКоду("НПВ");
				НоваяСтрока.СуммаКурсовыхРазницНУ = Мин(ПогаситьКурсоваяРазница, СтрокаПереоценки.ОтложенныеКурсовыеРазницыНУ);
				
				ПогаситьКурсоваяРазница = ПогаситьКурсоваяРазница - НоваяСтрока.СуммаКурсовыхРазницНУ;
				
			КонецЕсли;
			
			Если ПогаситьКурсоваяРазница > 0 Тогда // Есть остаток после зачета отложенных курсовых разниц.
				
				НоваяСтрока = ТаблицаПереоценкаВалютныхОстатковНУ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПереоценки, "НомерСтроки");
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СчетИАналитикаРасчетов,
					"ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ДокументРасчетов");
				
				Если ДокументОбъект.ОтложитьОтрицательныеКурсовыеРазницыНУ Тогда // Отражаем отложенные курсовые разницы (НУ).
					// Отражаем отложенную отрицательную на оставшуюся часть.
					НоваяСтрока.СчетДтНУ = БухгалтерскийУчет.СчетПоКоду("Н92.02");
					НоваяСтрока.СчетКтНУ = БухгалтерскийУчет.СчетПоКоду("НПВ");
					НоваяСтрока.СуммаКурсовыхРазницНУ = ПогаситьКурсоваяРазница;
				Иначе // Отражаем курсовые разницы во внереализационных расходах (НУ).
					НоваяСтрока.СчетДтНУ = БухгалтерскийУчет.СчетПоКоду("Н91.02");
					НоваяСтрока.СчетКтНУ = БухгалтерскийУчет.СчетПоКоду("НПВ");
					НоваяСтрока.СуммаКурсовыхРазницНУ = ПогаситьКурсоваяРазница;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	МетаданныеТабчасти = Метаданные.Документы.ПереоценкаВалютныхОстатков.ТабличныеЧасти.ТаблицаПереоценки;
	ТаблицаПереоценкаВалютныхОстатковНУ.ЗаполнитьЗначения(МетаданныеТабчасти.Имя, "ИмяСписка");
	ТаблицаПереоценкаВалютныхОстатковНУ.ЗаполнитьЗначения(МетаданныеТабчасти.Синоним, "СинонимСписка");
	
	Возврат ТаблицаПереоценкаВалютныхОстатковНУ;
	
КонецФункции

Функция ПустаяТаблицаОтложенныхКурсовыхРазницНУ() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("ДокументРасчетов", ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов.ТипЗначения);
	
	// Отражение отложенных курсовых разниц в налоговом учете.
	ПустаяТаблица.Колонки.Добавить("СчетДтНУ", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СчетКтНУ", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СуммаОтложенныхКурсовыхРазницНУ", ОписаниеТипаСуммы); // Сумма отложенных курсовых разниц к признанию во внереализационных доходах (расходах).
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаОтложенныхКурсовыхРазницНУПриПогашенииЗадолженности(ТаблицаРасчетовСПогашениемЗадолженности, Реквизиты, Отказ) Экспорт
	
	ТаблицаОтложенныхКурсовыхРазницНУ = ПустаяТаблицаОтложенныхКурсовыхРазницНУ();
	
	Если НЕ НалоговыйУчет.ПлательщикНалогаНаПрибыль(Реквизиты.Организация, Реквизиты.Дата) Тогда
		Возврат ТаблицаОтложенныхКурсовыхРазницНУ;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	// Остатки отложенных (до момента погашения задолженности) курсовых разниц на счетах Н92.01 и Н92.02.
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты.Ссылка));
	ОтложенныеКурсовыеРазницыНУ = НалоговыйУчет.ОтложенныеКурсовыеРазницыНУ(ПериодОстатков, ТаблицаРасчетовСПогашениемЗадолженности, Реквизиты);
	
	Если ОтложенныеКурсовыеРазницыНУ.Количество() > 0 Тогда
		
		Для Каждого СтрокаПлатежа Из ТаблицаРасчетовСПогашениемЗадолженности Цикл
			
			Если НЕ СтрокаПлатежа.РасчетыВВалюте Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаПлатежа.ЭтоАванс Тогда
				Продолжить; // Авансы не переоцениваются.
			КонецЕсли;
			Если НЕ НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаПлатежа.КФО) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ БухгалтерскийУчет.СчетВИерархии(СтрокаПлатежа.СчетРасчетов, "205.00, 209.00")
				И НЕ БухгалтерскийУчет.СчетВИерархии(СтрокаПлатежа.СчетРасчетов, "302.00") Тогда
				Продолжить;
			КонецЕсли;
			
			Отбор = Новый Структура("КФО,Контрагент",
				СтрокаПлатежа.КФО,
				СтрокаПлатежа.Контрагент);
			
			Если БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(СтрокаПлатежа.СчетРасчетов) Тогда
				Отбор.Вставить("Договор", СтрокаПлатежа.Договор);
			КонецЕсли;
			
			Если СтрокаПлатежа.ВидДопСубконтоРасчетов = ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов Тогда
				Отбор.Вставить("ДокументРасчетов", СтрокаПлатежа.ДопСубконтоРасчетов);
			КонецЕсли;
			
			СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаПлатежа.СчетРасчетов);
			Если Реквизиты.ИспользоватьУчетПоИФО Тогда
				Отбор.Вставить("ИФО", СтрокаПлатежа.ИФО);
			КонецЕсли;
			Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
				Отбор.Вставить("КПС", СтрокаПлатежа.КПС);
			КонецЕсли;
			Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
				Отбор.Вставить("Подразделение", СтрокаПлатежа.Подразделение);
			КонецЕсли;
			
			НайденныеОстаткиКурсовыхРазницНУ = ОтложенныеКурсовыеРазницыНУ.НайтиСтроки(Отбор);
			Для Каждого СтрокаКурсовыхРазницНУ Из НайденныеОстаткиКурсовыхРазницНУ Цикл
				
				Если СтрокаПлатежа.СуммаРасчетов >= СтрокаПлатежа.ОстатокРасчетов ИЛИ СтрокаПлатежа.ОстатокРасчетов = 0 Тогда
					СуммаОтложенныхКурсовыхРазницНУ = СтрокаКурсовыхРазницНУ.ОстатокОтложенныхКурсовыхРазницНУ;
				Иначе // Рассчитываем пропорционально зачтенной сумме задолженности.
					СуммаОтложенныхКурсовыхРазницНУ = СтрокаКурсовыхРазницНУ.ОстатокОтложенныхКурсовыхРазницНУ * (СтрокаПлатежа.СуммаРасчетов / СтрокаПлатежа.ОстатокРасчетов);
				КонецЕсли;
				
				Если СуммаОтложенныхКурсовыхРазницНУ = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ТаблицаОтложенныхКурсовыхРазницНУ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлатежа,
					"ИмяСписка,СинонимСписка,НомерСтроки,СчетРасчетов");
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКурсовыхРазницНУ,
					"ИФО,КФО,КПС,Подразделение,Контрагент,Договор,ДокументРасчетов");
				
				Если СуммаОтложенныхКурсовыхРазницНУ > 0 Тогда // Положительная курсовая разница.
					
					НоваяСтрока.СчетДтНУ = БухгалтерскийУчет.СчетПоКоду("Н92.01");
					НоваяСтрока.СчетКтНУ = БухгалтерскийУчет.СчетПоКоду("Н91.01");
					НоваяСтрока.СуммаОтложенныхКурсовыхРазницНУ = СуммаОтложенныхКурсовыхРазницНУ;
					
				ИначеЕсли СуммаОтложенныхКурсовыхРазницНУ < 0 Тогда // Отрицательная курсовая разница.
					
					НоваяСтрока.СчетДтНУ = БухгалтерскийУчет.СчетПоКоду("Н91.02");
					НоваяСтрока.СчетКтНУ = БухгалтерскийУчет.СчетПоКоду("Н92.02");
					НоваяСтрока.СуммаОтложенныхКурсовыхРазницНУ = -СуммаОтложенныхКурсовыхРазницНУ;
					
				КонецЕсли;
				
				СтрокаКурсовыхРазницНУ.ОстатокОтложенныхКурсовыхРазницНУ = СтрокаКурсовыхРазницНУ.ОстатокОтложенныхКурсовыхРазницНУ - СуммаОтложенныхКурсовыхРазницНУ;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаОтложенныхКурсовыхРазницНУ;
	
КонецФункции

Функция ТаблицаОтложенныхКурсовыхРазницНУПоРасшифровкеПлатежа(ТаблицаРасшифровкаПлатежаУнифицированная, Реквизиты, Отказ) Экспорт
	
	ТаблицаОтложенныхКурсовыхРазницНУ = ПустаяТаблицаОтложенныхКурсовыхРазницНУ();
	
	Если НЕ НалоговыйУчет.ПлательщикНалогаНаПрибыль(Реквизиты.Организация, Реквизиты.Дата) Тогда
		Возврат ТаблицаОтложенныхКурсовыхРазницНУ;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("УчитыватьЗадолженностьЕНВД",       Ложь);
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты.Ссылка));
	
	// Остатки отложенных (до момента погашения задолженности) курсовых разниц на счетах Н92.01 и Н92.02.
	ОтложенныеКурсовыеРазницыНУ = НалоговыйУчет.ОтложенныеКурсовыеРазницыНУ(ПериодОстатков, ТаблицаРасшифровкаПлатежаУнифицированная, Реквизиты);
	
	// Остатки задолженности со счетов бухгалтерского учета.
	ОстаткиЗадолженности = УчетРасчетов.ОстаткиЗадолженности(ПериодОстатков, ТаблицаРасшифровкаПлатежаУнифицированная, Реквизиты);
	
	Если ОтложенныеКурсовыеРазницыНУ.Количество() > 0 И ОстаткиЗадолженности.Количество() > 0 Тогда
		
		// Распределим отложенные курсовые разницы пропорционально остаткам задолженности.
		ОстаткиЗадолженности.Колонки.Добавить("ОстатокОтложенныхКурсовыхРазницНУ",
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
		Для Каждого СтрокаКурсовыеРазницыНУ Из ОтложенныеКурсовыеРазницыНУ Цикл
			
			ОтборСтрок = Новый Структура("ИФО,КФО,КПС,Контрагент");
			ЗаполнитьЗначенияСвойств(ОтборСтрок, СтрокаКурсовыеРазницыНУ);
			Если Не БухгалтерскийУчет.СчетВИерархии(Реквизиты.КорСчет, "208.00") Тогда
				ОтборСтрок.Вставить("Договор", СтрокаКурсовыеРазницыНУ.Договор);
			КонецЕсли;
			НайденныеСтрокиЗадолженности = ОстаткиЗадолженности.НайтиСтроки(ОтборСтрок);
			
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаКурсовыеРазницыНУ.ОстатокОтложенныхКурсовыхРазницНУ,
				НайденныеСтрокиЗадолженности, "ОстатокОтложенныхКурсовыхРазницНУ", "СуммаРасчетов", Ложь);
				
		КонецЦикла;
		
		ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
		
		Для Каждого СтрокаПлатежа Из ТаблицаРасшифровкаПлатежаУнифицированная Цикл
			
			Если СтрокаПлатежа.Валюта = ВалютаРегламентированногоУчета Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаПлатежа.КФО) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоПогашениеЗадолженностиНа30100 = (БухгалтерскийУчет.СчетВИерархии(СтрокаПлатежа.СчетРасчетов, "301.00") И Не СтрокаПлатежа.ЭтоПоступление);
			ЭтоПогашениеЗадолженностиНа20800 = (БухгалтерскийУчет.СчетВИерархии(СтрокаПлатежа.СчетРасчетов, "208.00") И Не СтрокаПлатежа.ЭтоПоступление);
			ЭтоПогашениеЗадолженностиНа20700 = (БухгалтерскийУчет.СчетВИерархии(СтрокаПлатежа.СчетРасчетов, "207.00") И СтрокаПлатежа.ЭтоПоступление);
			Если Не ЭтоПогашениеЗадолженностиНа30100 И Не ЭтоПогашениеЗадолженностиНа20800 И Не ЭтоПогашениеЗадолженностиНа20700 Тогда
				Продолжить;
			КонецЕсли;
			
			Отбор = Новый Структура("КФО,Контрагент,Валюта",
				СтрокаПлатежа.КФО,
				СтрокаПлатежа.Контрагент,
				СтрокаПлатежа.Валюта);
			
			Если БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(СтрокаПлатежа.СчетРасчетов) Тогда
				Отбор.Вставить("Договор", СтрокаПлатежа.Договор);
			КонецЕсли;
			
			Если ЭтоПогашениеЗадолженностиНа30100 ИЛИ ЭтоПогашениеЗадолженностиНа20700 Тогда
				Отбор.Вставить("ДопСубконтоРасчетов", СтрокаПлатежа.ВидРасчетов);
			КонецЕсли;
			
			СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаПлатежа.СчетРасчетов);
			Если Реквизиты.ИспользоватьУчетПоИФО Тогда
				Отбор.Вставить("ИФО", СтрокаПлатежа.ИФО);
			КонецЕсли;
			Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
				Отбор.Вставить("КПС", СтрокаПлатежа.КПС);
			КонецЕсли;
			Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
				Отбор.Вставить("Подразделение", СтрокаПлатежа.Подразделение);
			КонецЕсли;
			
			// Рассчитаем остаток задолженности для определения коэффициента списания отложенных курсовых разниц.
			НайденныеОстаткиЗадолженности = ОстаткиЗадолженности.Скопировать(Отбор, "СуммаРасчетов, ОстатокОтложенныхКурсовыхРазницНУ");
			ОстатокРасчетов = 0;
			Если ЭтоПогашениеЗадолженностиНа30100 ИЛИ ЭтоПогашениеЗадолженностиНа20800 Тогда
				ОстатокРасчетов = -НайденныеОстаткиЗадолженности.Итог("СуммаРасчетов");
			ИначеЕсли ЭтоПогашениеЗадолженностиНа20700 Тогда
				ОстатокРасчетов = НайденныеОстаткиЗадолженности.Итог("СуммаРасчетов");
			КонецЕсли;
			ОстатокОтложенныхКурсовыхРазницНУ = НайденныеОстаткиЗадолженности.Итог("ОстатокОтложенныхКурсовыхРазницНУ");
			
			Если СтрокаПлатежа.СуммаРасчетов >= ОстатокРасчетов ИЛИ ОстатокРасчетов = 0 Тогда
				СуммаОтложенныхКурсовыхРазницНУ = ОстатокОтложенныхКурсовыхРазницНУ;
			Иначе // Рассчитываем пропорционально зачтенной сумме задолженности.
				СуммаОтложенныхКурсовыхРазницНУ = ОстатокОтложенныхКурсовыхРазницНУ * (СтрокаПлатежа.СуммаРасчетов / ОстатокРасчетов);
			КонецЕсли;
			
			Если СуммаОтложенныхКурсовыхРазницНУ = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаОтложенныхКурсовыхРазницНУ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлатежа,
				"ИмяСписка,СинонимСписка,НомерСтроки,СчетРасчетов");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПлатежа,
				"ИФО,КФО,КПС,Подразделение,Контрагент");
			
			Если БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(НоваяСтрока.СчетРасчетов) Тогда
				НоваяСтрока.Договор = СтрокаПлатежа.Договор;
			КонецЕсли;
			
			Если СуммаОтложенныхКурсовыхРазницНУ > 0 Тогда // Положительная курсовая разница.
				
				НоваяСтрока.СчетДтНУ = БухгалтерскийУчет.СчетПоКоду("Н92.01");
				НоваяСтрока.СчетКтНУ = БухгалтерскийУчет.СчетПоКоду("Н91.01");
				НоваяСтрока.СуммаОтложенныхКурсовыхРазницНУ = СуммаОтложенныхКурсовыхРазницНУ;
				
			ИначеЕсли СуммаОтложенныхКурсовыхРазницНУ < 0 Тогда // Отрицательная курсовая разница.
				
				НоваяСтрока.СчетДтНУ = БухгалтерскийУчет.СчетПоКоду("Н91.02");
				НоваяСтрока.СчетКтНУ = БухгалтерскийУчет.СчетПоКоду("Н92.02");
				НоваяСтрока.СуммаОтложенныхКурсовыхРазницНУ = -СуммаОтложенныхКурсовыхРазницНУ;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаОтложенныхКурсовыхРазницНУ;
	
КонецФункции

#КонецОбласти


#Область УстаревшиеПроцедурыИФункции

Функция ПлательщикНалогаНаПрибыль(Организация, Период) Экспорт

	Возврат НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, Период);

КонецФункции

