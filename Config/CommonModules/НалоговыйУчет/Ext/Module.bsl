		СтраницаЛист02_2.П000220013103 = АмортизацияОсновныхСредств + АмортизацияНематериальныхАктивов;
		
		ДобавитьСтрокиРасшифровкиАмортизации(ТаблицаРасшифровки, ОбщиеПараметрыРасшифровки,
			"П000220013103", "Строка 131 ""Сумма начисленной амортизации, за отчетный (налоговый) период""",
			"+", ТаблицаАмортизацияЗатраты,       "АмортизацияОсновныхСредств");
		ДобавитьСтрокиРасшифровкиАмортизации(ТаблицаРасшифровки, ОбщиеПараметрыРасшифровки,
			"П000220013103", "Строка 131 ""Сумма начисленной амортизации, за отчетный (налоговый) период""",
			"+", ТаблицаАмортизацияПрочиеРасходы, "АмортизацияОсновныхСредств");
			
		ДобавитьСтрокиРасшифровкиАмортизации(ТаблицаРасшифровки, ОбщиеПараметрыРасшифровки,
			"П000220013103", "Строка 131 ""Сумма начисленной амортизации, за отчетный (налоговый) период""",
			"+", ТаблицаАмортизацияЗатраты,       "АмортизацияНематериальныхАктивов");
		ДобавитьСтрокиРасшифровкиАмортизации(ТаблицаРасшифровки, ОбщиеПараметрыРасшифровки,
			"П000220013103", "Строка 131 ""Сумма начисленной амортизации, за отчетный (налоговый) период""",
			"+", ТаблицаАмортизацияПрочиеРасходы, "АмортизацияНематериальныхАктивов");
		
		// Строка 132 - Сумма начисленной амортизации по нематериальным активам - линейным методом
		СтраницаЛист02_2.П000220013203 = АмортизацияНематериальныхАктивов;
		
		ДобавитьСтрокиРасшифровкиАмортизации(ТаблицаРасшифровки, ОбщиеПараметрыРасшифровки,
			"П000220013203", "Строка 132 ""Сумма начисленной амортизации по нематериальным активам""",
			"+", ТаблицаАмортизацияЗатраты,       "АмортизацияНематериальныхАктивов");
		ДобавитьСтрокиРасшифровкиАмортизации(ТаблицаРасшифровки, ОбщиеПараметрыРасшифровки,
			"П000220013203", "Строка 132 ""Сумма начисленной амортизации по нематериальным активам""",
