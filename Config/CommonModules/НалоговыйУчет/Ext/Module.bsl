Процедура УстановитьЗначениеПоказателя(ПараметрыОтчета, Контейнер, ИмяЯчейки, Сумма, струкНаборДанных = Неопределено)
	
	ИмяСтраницыПанели = роОпределитьСтраницуПанелиПоКодуПоказателя(ИмяЯчейки);
	
	Если струкНаборДанных = Неопределено Тогда
		струкНаборДанных = Новый Структура;
		ИмяИтоговойЯчейки = ИмяЯчейки;
		СуммаИтога = Сумма;
		// Приложение 4 заполняется только за 1-й квартал и за год.
		Если (НЕ ПараметрыОтчета.флИсключаемыеПериоды И ИмяСтраницыПанели = "Лист02_4") ИЛИ (НЕ ПараметрыОтчета.флКвартальноеЗаполнение) Тогда
			НайтиИтоговуюЯчейку(ПараметрыОтчета, ИмяЯчейки, Сумма, ИмяИтоговойЯчейки, СуммаИтога);
			ИмяСтраницыПанели = роОпределитьСтраницуПанелиПоКодуПоказателя(ИмяИтоговойЯчейки);
		КонецЕсли;
		струкНаборДанных.Вставить(ИмяИтоговойЯчейки, СуммаИтога);
	ИначеЕсли струкНаборДанных <> Неопределено И ИмяСтраницыПанели = "Лист02_4" Тогда
		Для каждого ЭлСтрук Из струкНаборДанных Цикл
			Если ЭлСтрук.Ключ = "НомерСтроки" Тогда
				Продолжить;
			Иначе
				ИмяЯчейки = ЭлСтрук.Ключ;
				ИмяИтоговойЯчейки = ИмяЯчейки;
				Сумма = ЭлСтрук.Значение;
				СуммаИтога = Сумма;
				// Приложение 4 заполняется только за 1-й квартал и за год.
				Если НЕ ПараметрыОтчета.флИсключаемыеПериоды ИЛИ НЕ ПараметрыОтчета.флКвартальноеЗаполнение Тогда
					НайтиИтоговуюЯчейку(ПараметрыОтчета, ИмяЯчейки, Сумма, ИмяИтоговойЯчейки, СуммаИтога);
					ИмяСтраницыПанели = роОпределитьСтраницуПанелиПоКодуПоказателя(ИмяИтоговойЯчейки);
					струкНаборДанных.Удалить(ЭлСтрук.Ключ);
					Если НЕ СуммаИтога = 0 Тогда
						струкНаборДанных.Вставить(ИмяИтоговойЯчейки, СуммаИтога);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПоместитьДанныеВДерево(Контейнер, ИмяСтраницыПанели, струкНаборДанных);
	
КонецПроцедуры

Процедура НайтиИтоговуюЯчейку(ПараметрыОтчета, ИмяЯчейки, Сумма, ИмяИтоговойЯчейки, СуммаИтога, ТекстИтога = "")
	
	Строка = ПараметрыОтчета.ТаблицаИтогов.Найти(ИмяЯчейки, "ИмяЯчейки");
	Если Строка = Неопределено Тогда
		ИмяИтоговойЯчейки = ИмяЯчейки; 
		Если ПараметрыОтчета.ЯчейкиСтрочногоТипа.Найти(ИмяИтоговойЯчейки) = Неопределено Тогда
			СуммаИтога = 0;
		Иначе	
			СуммаИтога = "";
		КонецЕсли;	
		Возврат;
	КонецЕсли;
	ИмяИтоговойЯчейки = Строка.ИмяИтоговойЯчейки;
	ТекстИтога        = Строка.ТекстИтоговойЯчейки;
	СтрокаИтогов = ПараметрыОтчета.ТаблицаСуммИтогов.Найти(ИмяИтоговойЯчейки,"ИмяИтоговойЯчейки");
	Если НЕ СтрокаИтогов = Неопределено Тогда
		СтрокаИтогов.СУмма = Сумма + СтрокаИтогов.Сумма;
		СуммаИтога = СтрокаИтогов.СУмма;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоместитьДанныеВДерево(Контейнер, ИмяСтраницы, струкНаборДанных)
	Перем НомерЛиста;
	Перем НомерСтроки;
	
	ДеревоДанных = Контейнер.Лист02;
	Лист02 = ДеревоДанных.Строки[0];
	Если ИмяСтраницы = "Лист02" Тогда
		ДанныеТекЛиста = Лист02.Данные;
	Иначе
		НомерЛиста = 1;
		Если ИмяСтраницы = "Лист02_5" Тогда
			струкНаборДанных.Свойство("НомерЛиста", НомерЛиста);
			струкНаборДанных.Удалить("НомерЛиста");
			Если НомерЛиста > 1 Тогда
				ЛистыПрил5 = Лист02.Строки[4].Строки;
				струкШаблон = ЛистыПрил5[0].Данные;
				ЛистыПрил5.Добавить();
				ПротоЛиста_Данные = Новый Структура;
				Для Каждого ЭлСтрук Из струкШаблон Цикл
					ПротоЛиста_Данные.Вставить(ЭлСтрук.Ключ, ?(ТипЗнч(ЭлСтрук.Значение) = ТипЗнч("Строка"), "", 0));
				КонецЦикла;
				Лист02.Строки[Число(Прав(ИмяСтраницы, 1)) - 1].Строки[НомерЛиста - 1].Данные = ПротоЛиста_Данные;
				Лист02.Строки[Число(Прав(ИмяСтраницы, 1)) - 1].Строки[НомерЛиста - 1].ДанныеМногострочныхЧастей = Новый Структура;
			КонецЕсли;
		КонецЕсли;
		ДанныеТекЛиста = Лист02.Строки[Число(Прав(ИмяСтраницы, 1)) - 1].Строки[НомерЛиста - 1].Данные;
	КонецЕсли;
	
	Если ДанныеТекЛиста["ПризнакВключения"] = "V" Тогда
	Иначе
		Если ИмяСтраницы = "Лист02_4" Тогда
			Если струкНаборДанных.Количество() > 1 Тогда
				УстановитьПризнакВключения(ДанныеТекЛиста, Истина);
			КонецЕсли;
		Иначе
			УстановитьПризнакВключения(ДанныеТекЛиста, Истина);
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСтраницы = "Лист02_3" Тогда
		ПризнакНП = ДанныеТекЛиста["П000230000100"];
		ДанныеТекЛиста["П000230000100"] = ?(ПризнакНП = "", "01", ПризнакНП);
	ИначеЕсли ИмяСтраницы = "Лист02_4" И струкНаборДанных.Свойство("НомерСтроки") Тогда
		струкНаборДанных.Свойство("НомерСтроки", НомерСтроки);
		струкНаборДанных.Удалить("НомерСтроки");
		МнСтрочка = Лист02.Строки[3].Строки[0].ДанныеМногострочныхЧастей.П00024М1.Строки;
		Если струкНаборДанных.Количество() > 0 Тогда
			Если НомерСтроки > 1 Тогда
				ДобавитьСтрокуПрил4Листа2(МнСтрочка, НомерСтроки);
			КонецЕсли;
			ДанныеТекЛиста = МнСтрочка[НомерСтроки - 1].Данные;
		КонецЕсли;
	КонецЕсли;
	
	Для каждого ЭлСтрук Из струкНаборДанных Цикл
		ИмяПоказателя = ЭлСтрук.Ключ;
		ЗначениеПоказателя = ЭлСтрук.Значение;
		// В ходе заполнения нельзя менять тип значения в контейнере
		ДопустимыйТип = ТипЗнч(ДанныеТекЛиста[ИмяПоказателя]);
		Если ТипЗнч(ЗначениеПоказателя) = ДопустимыйТип Тогда
			ДанныеТекЛиста.Вставить(ИмяПоказателя, ЗначениеПоказателя);
		Иначе // очистим значение
			ОпТип = Новый ОписаниеТипов(ЗначениеВМассиве(ДопустимыйТип));
			ДанныеТекЛиста.Вставить(ИмяПоказателя, ОпТип.ПривестиЗначение(ЗначениеПоказателя));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьПризнакВключения(ДанныеТекЛиста, ФлПереключателя)
	
	Если ФлПереключателя Тогда
		флВкл = ДанныеТекЛиста["ПризнакВключения"];
		ДанныеТекЛиста["ПризнакВключения"] = ?(флВкл = "", "V", флВкл);
	Иначе
		флВкл = ДанныеТекЛиста["ПризнакВключения"];
		ДанныеТекЛиста["ПризнакВключения"] = ?(флВкл = "V", "", флВкл);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуПрил4Листа2(МнСтрочка, НомерСтроки)
	
	СтрокаМногострочнойЧасти = МнСтрочка.Добавить();
	
	струкДанные = Новый Структура;
	струкДанные.Вставить("П00024М100001", "");
	струкДанные.Вставить("П00024М100002", "");
	струкДанные.Вставить("П00024М100003", 0);
	
	МнСтрочка[НомерСтроки - 1].Данные = струкДанные;
	МнСтрочка[НомерСтроки - 1].ДанныеМногострочныхЧастей = Новый Структура;
	
КонецПроцедуры

Функция роОпределитьСтраницуПанелиПоКодуПоказателя(Знач ИмяЯчейки)
	Перем ИмяСтраницы;
	
	Если СтрНачинаетсяС82(ИмяЯчейки, "П00002") Тогда
		ИмяСтраницы = "Лист02";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00021") Тогда
		ИмяСтраницы = "Лист02_1";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00022") Тогда
		ИмяСтраницы = "Лист02_2";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00023") Тогда
		ИмяСтраницы = "Лист02_3";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00024") Тогда
		ИмяСтраницы = "Лист02_4";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00025") Тогда
		ИмяСтраницы = "Лист02_5";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00026") Тогда
		ИмяСтраницы = "Лист02_6";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П0026а") Тогда
		ИмяСтраницы = "Лист02_6а";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П0026б0001") Тогда
		ИмяСтраницы = "Лист02_6бА";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П0026б0002") Тогда
		ИмяСтраницы = "Лист02_6бБ";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П0027А") Тогда
		ИмяСтраницы = "Лист02_7А";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П0027Б") Тогда
		ИмяСтраницы = "Лист02_7Б";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П0027В") Тогда
		ИмяСтраницы = "Лист02_7В";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П0027Г") Тогда
		ИмяСтраницы = "Лист02_7Г";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00028") Тогда
		ИмяСтраницы = "Лист02_8";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00029") Тогда
		ИмяСтраницы = "Лист02_9";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00004") Тогда
		ИмяСтраницы = "Лист04";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00005") Тогда
		ИмяСтраницы = "Лист05";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00006") Тогда
		ИмяСтраницы = "Лист06";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00007") Тогда
		ИмяСтраницы = "Лист07";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П00008") Тогда
		ИмяСтраницы = "Лист08";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П0008") Тогда
		ИмяСтраницы = "Лист08";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П0009") Тогда
		ИмяСтраницы = "Лист09";
	ИначеЕсли СтрНачинаетсяС82(ИмяЯчейки, "П009") Тогда
		ИмяСтраницы = "Лист09";
	КонецЕсли;
	
	Возврат ИмяСтраницы;
	
КонецФункции

Функция ЗначениеВМассиве(Значение)
	
	Массив = Новый Массив;
	Массив.Добавить(Значение);
	
	Возврат Массив;
	
КонецФункции

// Процедура добавляет описание строки расшифровки в таблицу расшифровок.
// В случае, если таблица расшифровок не инициализирована, выполняется её инициализация.
//
Процедура ДобавитьСтрокуРасшифровки(ТаблицаРасшифровок, ИмяПоказателя, НаименованиеПоказателя, ЗнакОперации, НаименованиеСлагаемого, Сумма, ИмяРаздела, ДополнительныеПараметры = Неопределено, ПараметрыОтчета = Неопределено)
	
	Если ТаблицаРасшифровок = Неопределено Тогда
		ТаблицаРасшифровок = Новый ТаблицаЗначений;
		ТаблицаРасшифровок.Колонки.Добавить("ИмяПоказателя");
		ТаблицаРасшифровок.Колонки.Добавить("НаименованиеПоказателя");
		ТаблицаРасшифровок.Колонки.Добавить("ЗнакОперации");
		ТаблицаРасшифровок.Колонки.Добавить("НаименованиеСлагаемого");
		ТаблицаРасшифровок.Колонки.Добавить("Сумма");
		ТаблицаРасшифровок.Колонки.Добавить("ИмяРаздела");
		ТаблицаРасшифровок.Колонки.Добавить("ДополнительныеПараметры");
	КонецЕсли;
	
	НоваяСтрокаРасшифровки = ТаблицаРасшифровок.Добавить();
	НоваяСтрокаРасшифровки.ЗнакОперации            = ЗнакОперации;
	НоваяСтрокаРасшифровки.НаименованиеСлагаемого  = НаименованиеСлагаемого;
	Если ЗначениеЗаполнено(ПараметрыОтчета) И Не ПараметрыОтчета.флКвартальноеЗаполнение Тогда
		
		Если Сумма <> 0 Тогда
			
			ИмяИтоговойЯчейки = "";
			СуммаИтога = 0;
			ТекстИтога = "";
			НайтиИтоговуюЯчейку(ПараметрыОтчета, ИмяПоказателя, 0, ИмяИтоговойЯчейки, СуммаИтога, ТекстИтога);
			
			НоваяСтрокаРасшифровки.ИмяПоказателя           = ИмяИтоговойЯчейки;
			НоваяСтрокаРасшифровки.НаименованиеПоказателя  = ТекстИтога;
			НоваяСтрокаРасшифровки.Сумма                   = Сумма;
			НоваяСтрокаРасшифровки.ИмяРаздела              = ?(ИмяРаздела = Неопределено, ИмяРаздела, Лев(ИмяРаздела,6));
			
		КонецЕсли;
		
	Иначе // Квартальное заполнение.
		НоваяСтрокаРасшифровки.ИмяПоказателя           = ИмяПоказателя;
		НоваяСтрокаРасшифровки.НаименованиеПоказателя  = НаименованиеПоказателя;
		НоваяСтрокаРасшифровки.Сумма                   = Сумма;
		НоваяСтрокаРасшифровки.ИмяРаздела              = ИмяРаздела;
	КонецЕсли;
	НоваяСтрокаРасшифровки.ДополнительныеПараметры = ДополнительныеПараметры;
	
КонецПроцедуры

Процедура ДобавитьСтрокиРасшифровкиКосвенныхРасходов(ТаблицаРасшифровки, ОбщиеПараметрыРасшифровки, ИмяПоказателя, НазваниеРасшифровки, БухИтогиКосвЗатрат, ВидРасходовНУ = Неопределено)
	
	Если ВидРасходовНУ = Неопределено Тогда
		СтрокиКосвенныхРасходов = БухИтогиКосвЗатрат;
	Иначе
		СтрокиКосвенныхРасходов = БухИтогиКосвЗатрат.НайтиСтроки(Новый Структура("Субконто1", ВидРасходовНУ));
	КонецЕсли;
	
	Для Каждого КосвенныеРасходы Из СтрокиКосвенныхРасходов Цикл
		Если КосвенныеРасходы.КО <> 0 Тогда
			
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
				ИмяПоказателя, НазваниеРасшифровки,
				"+", "!ОБ"+КосвенныеРасходы.КорСчет.Код+" "+КосвенныеРасходы.Счет.Код, КосвенныеРасходы.КО, "Лист02_2",
				НастройкиАнализаСчетаДляКосвенныхРасходов(ОбщиеПараметрыРасшифровки, КосвенныеРасходы.Счет, КосвенныеРасходы.КорСчет, КосвенныеРасходы.Субконто1),
				?(ОбщиеПараметрыРасшифровки.Свойство("ПараметрыОтчета"), ОбщиеПараметрыРасшифровки.ПараметрыОтчета, Неопределено));
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтрокиРасшифровкиАмортизации(ТаблицаРасшифровки, ОбщиеПараметрыРасшифровки, ИмяПоказателя, НазваниеРасшифровки, ЗнакОперации, ТаблицаАмортизация, НаименованиеСлагаемого)
	
	ЭтоОС   = (Лев(НаименованиеСлагаемого, 26) = "АмортизацияОсновныхСредств");
	КорСчет = ?(ЭтоОС, "Н02", "Н05");
	
	ЭтоЗатраты = (ТаблицаАмортизация.Колонки.Найти("ВидЗатрат")<>Неопределено);
	Если ЭтоЗатраты Тогда
		Для Каждого СтрокаАмортизация Из ТаблицаАмортизация Цикл
			
			Если СтрокаАмортизация[НаименованиеСлагаемого] = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, ИмяПоказателя, НазваниеРасшифровки,
				ЗнакОперации, "!ОБ"+СтрокаАмортизация.Счет+" "+КорСчет, СтрокаАмортизация[НаименованиеСлагаемого], "Лист02_2",
				НастройкиАнализаСчетаДляАмортизации(ОбщиеПараметрыРасшифровки, СтрокаАмортизация.Счет, КорСчет,
					ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат, СтрокаАмортизация.ВидЗатрат));
			
		КонецЦикла;
	Иначе
		Для Каждого СтрокаАмортизация Из ТаблицаАмортизация Цикл
			
			Если СтрокаАмортизация[НаименованиеСлагаемого] = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки, ИмяПоказателя, НазваниеРасшифровки,
				ЗнакОперации, "!ОБ"+СтрокаАмортизация.Счет+" "+КорСчет, СтрокаАмортизация[НаименованиеСлагаемого], "Лист02_2",
				НастройкиАнализаСчетаДляАмортизации(ОбщиеПараметрыРасшифровки, СтрокаАмортизация.Счет, КорСчет,
					ПланыВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы, СтрокаАмортизация.СтатьяПрочихРасходов));
		
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция НастройкиОСВПоСчету(ОбщиеНастройки, Счет, ОтборПоАналитике = Неопределено, Группировка = Неопределено)
	
	Если ОбщиеНастройки.Свойство("ПараметрыРасшифровки") Тогда
		Организация   = ОбщиеНастройки.ПараметрыРасшифровки.Организация;
		НачалоПериода = ОбщиеНастройки.ПараметрыРасшифровки.НачалоПериода;
		КонецПериода  = ОбщиеНастройки.ПараметрыРасшифровки.КонецПериода;
	Иначе
		Организация   = ОбщиеНастройки.Организация;
		НачалоПериода = ОбщиеНастройки.НачалоПериода;
		КонецПериода  = ОбщиеНастройки.КонецПериода;
