Функция ТекстЗапросаСписокПрямыхРасходовНУ(ИмяОсновнойТаблицы, ДатаДействующихПравил, Организация, НомераТаблиц=Неопределено) Экспорт
	
	// Определяем, в каких разрезах установлены правила определения прямых расходов
	Если ЗначениеЗаполнено(ДатаДействующихПравил) Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ПериодДействия", ДатаДействующихПравил);
		Запрос.УстановитьПараметр("Организация",    Организация);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(ВЫБОР
		|			КОГДА Правила.Счет = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК Поле1,
		|	СУММА(ВЫБОР
		|			КОГДА Правила.КорСчет = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК Поле2,
		|	СУММА(ВЫБОР
		|			КОГДА Правила.ВидЗатрат = ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК Поле3,
		|	СУММА(ВЫБОР
		|			КОГДА Правила.ИФО = ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК Поле4,
		|	СУММА(ВЫБОР
		|			КОГДА Правила.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК Поле5
		|ИЗ
		|	РегистрСведений.МетодыОпределенияПрямыхРасходовПроизводстваВНУ КАК Правила
		|ГДЕ
		|	Правила.Организация = &Организация
		|	И Правила.ПериодДействия = &ПериодДействия";
		
		ВидимыеКолонки    = Запрос.Выполнить().Выгрузить();
		ЕстьСчет          = ВидимыеКолонки[0].Поле1 > 0;
		ЕстьКорСчет       = ВидимыеКолонки[0].Поле2 > 0;
		ЕстьВидЗатрат     = ВидимыеКолонки[0].Поле3 > 0;
		ЕстьИФО           = ВидимыеКолонки[0].Поле4 > 0;
		ЕстьПодразделение = ВидимыеКолонки[0].Поле5 > 0;
		
	Иначе
		
		ЕстьСчет          = Ложь;
		ЕстьКорСчет       = Ложь;
		ЕстьВидЗатрат     = Ложь;
		ЕстьИФО           = Ложь;
		ЕстьПодразделение = Ложь;
		
	КонецЕсли;
	
	// Формируем список прямых расходов
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Правила.ВидРасходовНУ,
	|	Правила.ИФО,
	|	Правила.Подразделение,
	|	Правила.Счет,
	|	Правила.КорСчет,
	|	Правила.ВидЗатрат
	|ПОМЕСТИТЬ СписокВсехПравил_"+ИмяОсновнойТаблицы+"
	|ИЗ
	|	РегистрСведений.МетодыОпределенияПрямыхРасходовПроизводстваВНУ КАК Правила
	|ГДЕ
	|	Правила.Организация = &Организация
	|	И Правила.ПериодДействия = &ПериодДействия
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВидРасходовНУ"
	+ ?(ЕстьИФО,           "," + Символы.ПС + "	ИФО", "")
	+ ?(ЕстьПодразделение, "," + Символы.ПС + "	Подразделение", "")
	+ ?(ЕстьСчет,          "," + Символы.ПС + "	Счет", "")
	+ ?(ЕстьКорСчет,       "," + Символы.ПС + "	КорСчет", "")
	+ ?(ЕстьВидЗатрат,     "," + Символы.ПС + "	ВидЗатрат", "")
	+ "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ"
	+ Символы.ПС + ?(ЕстьИФО,           "	ОсновнаяТаблица.ИФО КАК ИФО,",                           "НЕОПРЕДЕЛЕНО КАК ИФО,")
	+ Символы.ПС + ?(ЕстьПодразделение, "	ОсновнаяТаблица.Подразделение КАК Подразделение,",       "НЕОПРЕДЕЛЕНО КАК Подразделение,")
	+ Символы.ПС + ?(ЕстьСчет,          "	ОсновнаяТаблица.СчетЗатрат КАК СчетЗатрат,",             "НЕОПРЕДЕЛЕНО КАК СчетЗатрат,")
	+ Символы.ПС + ?(ЕстьКорСчет,       "	ОсновнаяТаблица.КорСчетЗатрат КАК КорСчетЗатрат,",       "НЕОПРЕДЕЛЕНО КАК КорСчетЗатрат,")
	+ Символы.ПС + ?(ЕстьВидЗатрат,     "	ОсновнаяТаблица.ВидЗатрат КАК ВидЗатрат,",               "НЕОПРЕДЕЛЕНО КАК ВидЗатрат,")
	+ Символы.ПС + "	ОсновнаяТаблица.ВидЗатрат.ВидРасходовНУ КАК ВидЗатратНУ
	|ПОМЕСТИТЬ СписокПрямыхРасходовНУ_"+ИмяОсновнойТаблицы+"
	|ИЗ
	|	"+ИмяОсновнойТаблицы+" КАК ОсновнаяТаблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокВсехПравил_"+ИмяОсновнойТаблицы+" КАК Правила
	|		ПО Правила.ВидРасходовНУ = ОсновнаяТаблица.ВидЗатрат.ВидРасходовНУ"
	+ ?(ЕстьИФО,           Символы.ПС + "			И (ВЫБОР КОГДА Правила.ИФО           <> ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка) ТОГДА Правила.ИФО = ОсновнаяТаблица.ИФО                     ИНАЧЕ ИСТИНА КОНЕЦ)", "")
	+ ?(ЕстьПодразделение, Символы.ПС + "			И (ВЫБОР КОГДА Правила.Подразделение <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)                   ТОГДА Правила.Подразделение = ОсновнаяТаблица.Подразделение ИНАЧЕ ИСТИНА КОНЕЦ)", "")
	+ ?(ЕстьСчет,          Символы.ПС + "			И (ВЫБОР КОГДА Правила.Счет          <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)                           ТОГДА Правила.Счет = ОсновнаяТаблица.СчетЗатрат             ИНАЧЕ ИСТИНА КОНЕЦ)", "")
	+ ?(ЕстьКорСчет,       Символы.ПС + "			И (ВЫБОР КОГДА Правила.КорСчет       <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)                           ТОГДА Правила.КорСчет = ОсновнаяТаблица.КорСчетЗатрат       ИНАЧЕ ИСТИНА КОНЕЦ)", "")
	+ ?(ЕстьВидЗатрат,     Символы.ПС + "			И (ВЫБОР КОГДА Правила.ВидЗатрат     <> ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)                      ТОГДА Правила.ВидЗатрат = ОсновнаяТаблица.ВидЗатрат         ИНАЧЕ ИСТИНА КОНЕЦ)", "")
	+ "
	|СГРУППИРОВАТЬ ПО"
	+ ?(ЕстьИФО,           Символы.ПС + "	ОсновнаяТаблица.ИФО,", "")
	+ ?(ЕстьПодразделение, Символы.ПС + "	ОсновнаяТаблица.Подразделение,", "")
	+ ?(ЕстьСчет,          Символы.ПС + "	ОсновнаяТаблица.СчетЗатрат,", "")
	+ ?(ЕстьКорСчет,       Символы.ПС + "	ОсновнаяТаблица.КорСчетЗатрат,", "")
	+ ?(ЕстьВидЗатрат,     Символы.ПС + "	ОсновнаяТаблица.ВидЗатрат,", "")
	+ Символы.ПС + "	ОсновнаяТаблица.ВидЗатрат.ВидРасходовНУ";
	
	Если НомераТаблиц<>Неопределено Тогда
		НомераТаблиц.Вставить("СписокВсехПравил_"+ИмяОсновнойТаблицы, НомераТаблиц.Количество());
		НомераТаблиц.Вставить("СписокПрямыхРасходовНУ_"+ИмяОсновнойТаблицы, НомераТаблиц.Количество());
	КонецЕсли;
	
	Возврат ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
	
КонецФункции

