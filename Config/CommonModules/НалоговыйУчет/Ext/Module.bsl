	Запрос.УстановитьПараметр("СчетаПрочихРасходов", БухгалтерскийУчет.СписокСчетов("Н91.02"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУОбороты.КорСчет КАК Счет,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.КорСубконто1 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.ОсновныеСредства).АмортизационнаяГруппа КАК АмортизационнаяГруппа,
	|	ВЫБОР
	|		КОГДА ЕПСБУОбороты.Счет В (&Счета02)
	|			ТОГДА ЕПСБУОбороты.СуммаОборотКт
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК АмортизацияОсновныхСредств,
	|	ВЫБОР
	|		КОГДА ЕПСБУОбороты.Счет В (&Счета05)
	|			ТОГДА ЕПСБУОбороты.СуммаОборотКт
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК АмортизацияНематериальныхАктивов
	|ПОМЕСТИТЬ АмортизацияЗатраты
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&ДатаНач,
	|			&ДатаКон,
	|			,
	|			Счет В (&Счета02, &Счета05),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация В (&СписокОрганизаций)
	|				И ВЫРАЗИТЬ(КорСубконто1 КАК Справочник.ВидыЗатрат).ВидДеятельностиДляНалоговогоУчетаЗатрат В (&МассивНеЕНВД),
	|			КорСчет В (&СчетаЗатрат),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат)) КАК ЕПСБУОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОбороты.Счет КАК Счет,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
	|	ЕПСБУОбороты.СуммаЕНВДОборотКт КАК СуммаРаспределеннаяНаЕНВД
	|ПОМЕСТИТЬ РаспределениеНаЕНВД
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&ДатаНач,
	|			&ДатаКон,
	|			,
	|			Счет В (&СчетаЗатрат),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат),
	|			Организация В (&СписокОрганизаций)
	|				И Субконто1 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						АмортизацияЗатраты.ВидЗатрат
	|					ИЗ
	|						АмортизацияЗатраты КАК АмортизацияЗатраты)
	|				И ВЫРАЗИТЬ(Субконто1 КАК Справочник.ВидыЗатрат).ВидДеятельностиДляНалоговогоУчетаЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты),
	|			КорСчет В (&СчетаН90),
	|			) КАК ЕПСБУОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Счет,
	|	ВложенныйЗапрос.ВидЗатрат,
	|	СУММА(ВложенныйЗапрос.АмортизацияОсновныхСредств) КАК АмортизацияОсновныхСредств,
	|	СУММА(ВложенныйЗапрос.АмортизацияНематериальныхАктивов) КАК АмортизацияНематериальныхАктивов,
	|	СУММА(ВложенныйЗапрос.АмортизацияОсновныхСредств8_10) КАК АмортизацияОсновныхСредств8_10,
	|	СУММА(ВложенныйЗапрос.АмортизацияНематериальныхАктивов8_10) КАК АмортизацияНематериальныхАктивов8_10,
	|	СУММА(ВложенныйЗапрос.СуммаРаспределеннаяНаЕНВД) КАК СуммаРаспределеннаяНаЕНВД
	|ИЗ
	|	(ВЫБРАТЬ
	|		АмортизацияЗатраты.Счет КАК Счет,
	|		АмортизацияЗатраты.ВидЗатрат КАК ВидЗатрат,
	|		АмортизацияЗатраты.АмортизацияОсновныхСредств КАК АмортизацияОсновныхСредств,
	|		АмортизацияЗатраты.АмортизацияНематериальныхАктивов КАК АмортизацияНематериальныхАктивов,
	|		ВЫБОР
	|			КОГДА АмортизацияЗатраты.АмортизационнаяГруппа В (ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ВосьмаяГруппа), ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ДевятаяГруппа), ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ДесятаяГруппа))
	|				ТОГДА АмортизацияЗатраты.АмортизацияОсновныхСредств
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК АмортизацияОсновныхСредств8_10,
	|		ВЫБОР
	|			КОГДА АмортизацияЗатраты.АмортизационнаяГруппа В (ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ВосьмаяГруппа), ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ДевятаяГруппа), ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ДесятаяГруппа))
	|				ТОГДА АмортизацияЗатраты.АмортизацияНематериальныхАктивов
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК АмортизацияНематериальныхАктивов8_10,
	|		0 КАК СуммаРаспределеннаяНаЕНВД
	|	ИЗ
	|		АмортизацияЗатраты КАК АмортизацияЗатраты
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РаспределениеНаЕНВД.Счет,
	|		РаспределениеНаЕНВД.ВидЗатрат,
	|		0,
	|		0,
	|		0,
	|		0,
	|		РаспределениеНаЕНВД.СуммаРаспределеннаяНаЕНВД
	|	ИЗ
	|		РаспределениеНаЕНВД КАК РаспределениеНаЕНВД) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Счет,
	|	ВложенныйЗапрос.ВидЗатрат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОбороты.КорСчет КАК Счет,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.КорСубконто1 КАК Справочник.ПрочиеДоходыИРасходы) КАК СтатьяПрочихРасходов,
	|	СУММА(ВЫБОР
	|			КОГДА ЕПСБУОбороты.Счет В (&Счета02)
	|				ТОГДА ЕПСБУОбороты.СуммаОборотКт
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК АмортизацияОсновныхСредств,
	|	СУММА(ВЫБОР
	|			КОГДА ЕПСБУОбороты.Счет В (&Счета05)
	|				ТОГДА ЕПСБУОбороты.СуммаОборотКт
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК АмортизацияНематериальныхАктивов,
	|	СУММА(ВЫБОР
	|			КОГДА ЕПСБУОбороты.Счет В (&Счета02)
	|					И ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.ОсновныеСредства).АмортизационнаяГруппа В (ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ВосьмаяГруппа), ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ДевятаяГруппа), ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ДесятаяГруппа))
	|				ТОГДА ЕПСБУОбороты.СуммаОборотКт
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК АмортизацияОсновныхСредств8_10,
	|	СУММА(ВЫБОР
	|			КОГДА ЕПСБУОбороты.Счет В (&Счета05)
	|					И ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.ОсновныеСредства).АмортизационнаяГруппа В (ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ВосьмаяГруппа), ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ДевятаяГруппа), ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ДесятаяГруппа))
	|				ТОГДА ЕПСБУОбороты.СуммаОборотКт
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК АмортизацияНематериальныхАктивов8_10
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&ДатаНач,
	|			&ДатаКон,
	|			,
	|			Счет В (&Счета02, &Счета05),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация В (&СписокОрганизаций)
	|				И ВЫРАЗИТЬ(КорСубконто1 КАК Справочник.ПрочиеДоходыИРасходы).ВидДеятельностиДляНалоговогоУчетаЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения),
	|			КорСчет В (&СчетаПрочихРасходов),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы)) КАК ЕПСБУОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОбороты.КорСчет,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.КорСубконто1 КАК Справочник.ПрочиеДоходыИРасходы)";
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("АмортизацияЗатраты", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("РаспределениеНаЕНВД", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаАмортизацияЗатраты", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаАмортизацияПрочиеРасходы", НомераТаблиц.Количество());
	
	Результат = Запрос.ВыполнитьПакет();
	ТаблицаАмортизацияЗатраты = Результат[НомераТаблиц.ТаблицаАмортизацияЗатраты].Выгрузить();
	ТаблицаАмортизацияПрочиеРасходы = Результат[НомераТаблиц.ТаблицаАмортизацияПрочиеРасходы].Выгрузить();
	
	// Распределим сумму амортизации по распределяемым видам затрат, отнесенную на ЕНВД, между амортизацией ОС и НМА.
	Для Каждого СтрокаАмортизация Из ТаблицаАмортизацияЗатраты Цикл
		
		Если СтрокаАмортизация.СуммаРаспределеннаяНаЕНВД > 0 Тогда
			
			// Рассчитаем сумму расходов, распределенных на ЕНВД, которые относятся к амортизации объектов 8-10 амортизационных групп,
			// исходя из доли амортизации объектов 8-10 амортизационных групп в общей сумме амортизации.
			Если СтрокаАмортизация.АмортизацияОсновныхСредств + СтрокаАмортизация.АмортизацияНематериальныхАктивов <> 0 Тогда
				СуммаРаспределеннаяНаЕНВД8_10 = СтрокаАмортизация.СуммаРаспределеннаяНаЕНВД
					* (СтрокаАмортизация.АмортизацияОсновныхСредств8_10 + СтрокаАмортизация.АмортизацияНематериальныхАктивов8_10)
					/ (СтрокаАмортизация.АмортизацияОсновныхСредств     + СтрокаАмортизация.АмортизацияНематериальныхАктивов);
			Иначе
				СуммаРаспределеннаяНаЕНВД8_10 = 0;
			КонецЕсли;
			
			// Скорректируем амортизацию ОС и НМА (общую) на сумму расходов, отнесенных к ЕНВД.
			МассивКоэффициентов = Новый Массив;
			МассивКоэффициентов.Добавить(СтрокаАмортизация.АмортизацияОсновныхСредств);
			МассивКоэффициентов.Добавить(СтрокаАмортизация.АмортизацияНематериальныхАктивов);
			
			МассивСуммЕНВД = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаАмортизация.СуммаРаспределеннаяНаЕНВД, МассивКоэффициентов);
			Если МассивСуммЕНВД = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаАмортизация.АмортизацияОсновныхСредств       = СтрокаАмортизация.АмортизацияОсновныхСредств       - МассивСуммЕНВД[0];
			СтрокаАмортизация.АмортизацияНематериальныхАктивов = СтрокаАмортизация.АмортизацияНематериальныхАктивов - МассивСуммЕНВД[1];
			
			// Скорректируем амортизацию ОС и НМА 8-10 амортизационных групп на сумму расходов, отнесенных к ЕНВД.
			Если СуммаРаспределеннаяНаЕНВД8_10 > 0 Тогда
				
				МассивКоэффициентов = Новый Массив;
				МассивКоэффициентов.Добавить(СтрокаАмортизация.АмортизацияОсновныхСредств8_10);
				МассивКоэффициентов.Добавить(СтрокаАмортизация.АмортизацияНематериальныхАктивов8_10);
				
				МассивСуммЕНВД = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СуммаРаспределеннаяНаЕНВД8_10, МассивКоэффициентов);
				Если МассивСуммЕНВД = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаАмортизация.АмортизацияОсновныхСредств8_10       = СтрокаАмортизация.АмортизацияОсновныхСредств8_10       - МассивСуммЕНВД[0];
				СтрокаАмортизация.АмортизацияНематериальныхАктивов8_10 = СтрокаАмортизация.АмортизацияНематериальныхАктивов8_10 - МассивСуммЕНВД[1];
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	АмортизацияОсновныхСредств           = ТаблицаАмортизацияЗатраты.Итог("АмортизацияОсновныхСредств")           + ТаблицаАмортизацияПрочиеРасходы.Итог("АмортизацияОсновныхСредств");
