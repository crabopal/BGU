				КонецЕсли;
				
				СтрокаАмортизация.АмортизацияОсновныхСредств8_10       = СтрокаАмортизация.АмортизацияОсновныхСредств8_10       - МассивСуммЕНВД[0];
				СтрокаАмортизация.АмортизацияНематериальныхАктивов8_10 = СтрокаАмортизация.АмортизацияНематериальныхАктивов8_10 - МассивСуммЕНВД[1];
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	АмортизацияОсновныхСредств           = ТаблицаАмортизацияЗатраты.Итог("АмортизацияОсновныхСредств")           + ТаблицаАмортизацияПрочиеРасходы.Итог("АмортизацияОсновныхСредств");
	АмортизацияНематериальныхАктивов     = ТаблицаАмортизацияЗатраты.Итог("АмортизацияНематериальныхАктивов")     + ТаблицаАмортизацияПрочиеРасходы.Итог("АмортизацияНематериальныхАктивов");
	АмортизацияОсновныхСредств8_10       = ТаблицаАмортизацияЗатраты.Итог("АмортизацияОсновныхСредств8_10")       + ТаблицаАмортизацияПрочиеРасходы.Итог("АмортизацияОсновныхСредств8_10");
	АмортизацияНематериальныхАктивов8_10 = ТаблицаАмортизацияЗатраты.Итог("АмортизацияНематериальныхАктивов8_10") + ТаблицаАмортизацияПрочиеРасходы.Итог("АмортизацияНематериальныхАктивов8_10");
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(ПараметрыОтчета.Организация, ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	МетодНачисленияАмортизацииНУ = УчетнаяПолитика.МетодНачисленияАмортизацииНУ;
	СпособАмортизации = ?(МетодНачисленияАмортизацииНУ = Перечисления.МетодыНачисленияАмортизации.Нелинейный, "2","1");
	
	Если СпособАмортизации = "1" Тогда
		
