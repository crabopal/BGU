			СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Отбор, "Субконто" + Индекс,
				СвойстваСчета["ВидСубконто"+Индекс+"ТипЗначения"].ПривестиЗначение(Неопределено), , Ложь);
		КонецЦикла;
		
	КонецЕсли;
	
	// Группировка.
	Если Группировка = Неопределено Тогда
		
		Группировка = Новый Массив;
		Для Индекс = 1 По СвойстваСчета.КоличествоСубконто Цикл
			ОписаниеГруппировки = Новый Структура;
			ОписаниеГруппировки.Вставить("Использование",  Ложь);
			ОписаниеГруппировки.Вставить("Поле",           "Субконто" + Индекс);
			ОписаниеГруппировки.Вставить("Представление",  СвойстваСчета["ВидСубконто" + Индекс + "Наименование"]);
			ОписаниеГруппировки.Вставить("ТипГруппировки", 0);
			Группировка.Добавить(ОписаниеГруппировки);
		КонецЦикла;
		
	КонецЕсли;
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("Группировка", Группировка);
	
	НастройкиРасшифровки.Отчет.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
	
