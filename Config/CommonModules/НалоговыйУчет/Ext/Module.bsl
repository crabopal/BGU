// Функция рассчитывает прибыли убытки по указанном виду доходов и расходов
//
// Параметры:
//   Счет учета доходов   91.01
//   Счет учета расхоов   91.02
//   Вид доходов и расходов из перечисления ВидыПрочихДоходовИРасходов
//   Флаг выдаваемого результата. "Убыток" - выдать сумму убытка, иначе - выдать сумму прибыли.
//
//
Функция ПрибылиИУбытки(Запрос, ВидРасходов, Флаг) Экспорт
	 
	Запрос.УстановитьПараметр("СчетН9101",   БухгалтерскийУчет.СписокСчетов("Н91.01"));
	Запрос.УстановитьПараметр("СчетН9102",   БухгалтерскийУчет.СписокСчетов("Н91.02"));
	// Надо исключать перенос убытков от реализации амотризируемого имущества - проводки Дт Н91.02 Кт Н97.
	Запрос.УстановитьПараметр("КорСчет",     БухгалтерскийУчет.СписокСчетов("Н97"));
	Запрос.УстановитьПараметр("ВидРасходов", ВидРасходов);
	
	Массив = Новый Массив;
	Массив.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы);
