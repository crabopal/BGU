
#Область ПрограммныйИнтерфейс

#Область НалоговыеСтавки

Функция ПолучитьСтавкуНалогаНаПрибыль(СтруктураПараметров, СтавкаФБ = 0, СтавкаРФ = 0) Экспорт

	КонецПериода = КонецМесяца(СтруктураПараметров.Дата);
	
	ОписаниеНалоговогоПериода = НалоговыйУчет.БлижайшийНалоговыйПериод(КонецПериода, СтруктураПараметров.Организация);
	Если КонецПериода < ОписаниеНалоговогоПериода.Начало Тогда
		Возврат 0;
	КонецЕсли;
	
	ДатаРасчетаСтавки = Макс(КонецПериода, ОписаниеНалоговогоПериода.Период);
	
	СтавкиНалога = РегистрыСведений.СтавкиНалогаНаПрибыльДляВсехОрганизаций.ПолучитьПоследнее(ДатаРасчетаСтавки);
	
	СтавкаФБ     = ?(ТипЗнч(СтавкиНалога.СтавкаФБ)        = Тип("Число"), СтавкиНалога.СтавкаФБ / 100,        0);
	СтавкаРФ     = ?(ТипЗнч(СтавкиНалога.СтавкаСубъектРФ) = Тип("Число"), СтавкиНалога.СтавкаСубъектРФ / 100, 0);
	
	СтавкаНалога = СтавкаФБ + СтавкаРФ;
	
	Возврат СтавкаНалога;

КонецФункции

#КонецОбласти

#Область НалоговыйПериод

// Определяет дату начала налогового периода по налогу на прибыль.
//
// Параметры:
//  Период	    - Дата - дата, характеризующая налоговый период
//  Организация	- СправочникСсылка.Организации - организация, дату регистрации которой следует учесть при получении периода
// 
// Возвращаемое значение:
//  Дата         - дата начала налогового периода по налогу на прибыль
//  Неопределено - в запрошенный период организация не существовала
//
Функция НачалоНалоговогоПериода(Период, Организация) Экспорт
	
	ГоловнаяОрганизация = ОбщегоНазначенияБГУ.ГоловнаяОрганизация(Организация);
	
	ОписаниеПериода = БлижайшийНалоговыйПериод(Период, ГоловнаяОрганизация);
	Если ОписаниеПериода.Начало > Период Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОписаниеПериода.Начало;
	
КонецФункции

// Определяет дату окончания предыдущего отчетного периода по налогу на прибыль в рамках налогового периода.
//
// Параметры:
//  Период	    - Дата - дата, характеризующая налоговый период
//  Организация	- СправочникСсылка.Организации - организация, сведения о которой следует учесть при получении периода
//  Кеш         - Соответствие - можно передать, если для одной и той же организации следует определить множество отчетных периодов.
//                Для вызовов с разными организациями следует передавать разный Кеш.
// 
// Возвращаемое значение:
//  Дата         - дата окончания предыдущего отчетного периода по налогу на прибыль.
//  Неопределено - это первый отчетный период в течение налогового - предыдущего нет
//
Функция КонецПредыдущегоОтчетногоПериода(Период, Организация, Кеш = Неопределено) Экспорт
	
	Если Кеш = Неопределено Тогда
		ПериодичностьОтчетногоПериода = ПериодичностьОтчетногоПериода(Период, Организация);
	Иначе
		НалоговыйПериод = НачалоГода(Период);
		ПериодичностьОтчетногоПериода = Кеш[НалоговыйПериод];
		Если ПериодичностьОтчетногоПериода = Неопределено Тогда
			ПериодичностьОтчетногоПериода = ПериодичностьОтчетногоПериода(Период, Организация);
			Кеш.Вставить(НалоговыйПериод, ПериодичностьОтчетногоПериода);
		КонецЕсли;
	КонецЕсли;
	
	НачалоОчередногоПериода = ИнтерфейсыВзаимодействияБРОКлиентСервер.НачалоПериода(ПериодичностьОтчетногоПериода, Период);
	
	Если НачалоОчередногоПериода = НачалоГода(Период) Тогда
		// Это первый отчетный период.
		// Здесь сравнение именно с формальным идентификатором отчетного периода (началом календарного года),
		// а не налогового периода
		Возврат Неопределено;
	КонецЕсли;
	
	КонецПредыдущегоОтчетногоПериода = НачалоОчередногоПериода - 1;
	
	НачалоНалоговогоПериода = НачалоНалоговогоПериода(Период, Организация);
	Если НачалоНалоговогоПериода = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если КонецПредыдущегоОтчетногоПериода < НачалоНалоговогоПериода Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат КонецПредыдущегоОтчетногоПериода;
	
КонецФункции

// Определяет периодичность, с которой должна отчитываться организация в данном налоговом периоде
//
// Параметры:
//  Период		- Дата - дата, характеризующая налоговый период
//  Организация	- СправочникСсылка.Организации - налогоплательщик
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.Периодичность - периодичность (продолжительность первого отчетного периода)
//
Функция ПериодичностьОтчетногоПериода(Период, Организация) Экспорт
	
	// Согласно п.3 статьи 286 НК РФ бюджетные и автономные учреждения
	// уплачивают только квартальные авансовые платежи по итогам отчетного периода.
	Возврат Перечисления.Периодичность.Квартал;
	
КонецФункции

// Определяет границы налогового периода, к которому относится переданная дата.
//  Возвращает данные первого налогового периода организации, если переданная дата относится к периоду до ее создания.
//
// Параметры:
//  ПроверяемыйПериод	 - Дата - дата в периоде, границы которого определяются
//  Организация			 - СправочникСсылка.Организации - налогоплательщик
// 
// Возвращаемое значение:
//  Структура - границы периода
//    * Период - Дата - стандартное начало налогового периода (например, 01 июля для третьего квартала);
//    * Начало - Дата - фактическое начало налогового периода (может совпадать со стандартным началом или
//               датой регистрации организации;
//    * Конец  - Дата - дата с указанием времени.
// 
Функция БлижайшийНалоговыйПериод(ПроверяемыйПериод, Организация) Экспорт
	
	Возврат ИнтерфейсыВзаимодействияБРО.БлижайшийНалоговыйПериод(
		Организация,
		ПроверяемыйПериод,
		Перечисления.ВариантыРасширенногоПервогоНалоговогоПериода.РегистрацияВДекабре,
		Перечисления.Периодичность.Год);
		
КонецФункции

#КонецОбласти

 ////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ РАБОТЫ С ПРОВОДКАМИ НУ

// Функция возвращает массив с номерами проводок по налоговому учету,
// для переданной коллекции проводок документа.
//
// Параметры
//  ТаблицаДвиженийЕПСБУ - РегистрБухгалтерииНаборЗаписей - таблица проводок,
//   в которой нужно найти проводки по налоговому учету.
//
//
Функция ПолучитьНомераПроводокНУ(Знач ТаблицаДвиженийЕПСБУ) Экспорт
	
	НомераПроводокНУ = Новый Массив;
	
	Для Каждого Проводка Из ТаблицаДвиженийЕПСБУ Цикл
		
		Если Проводка.СчетДт.ТипСчета = ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый")
		 ИЛИ Проводка.СчетКт.ТипСчета = ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый") Тогда
			НомераПроводокНУ.Добавить(Проводка.НомерСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(НомераПроводокНУ);
	
КонецФункции

// Функция возвращает таблицу проводок НУ, соответствующих проводкам БУ.
//
// Параметры
//  ТаблицаДвиженийЕПСБУ - РегистрБухгалтерииНаборЗаписей или ТаблицаЗначений - таблица проводок,
//   по которым нужно сформировать проводки по налоговому учету.
//
Функция СформироватьПроводкиНУпоБУ(ДокументОбъект, Знач ТаблицаДвиженийЕПСБУ) Экспорт
	
	Если ТипЗнч(ТаблицаДвиженийЕПСБУ) = Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ") Тогда
		ТаблицаПроводок = ТаблицаДвиженийЕПСБУ.Выгрузить();
	Иначе // передана таблица значений
		ТаблицаПроводок = ТаблицаДвиженийЕПСБУ;
	КонецЕсли;
	
	Если КонецДня(ДокументОбъект.Дата) = КонецГода(ДокументОбъект.Дата) Тогда
		// Для операций 31.12.хххх разрешаем использовать счета с датой начала действия с начала следующего года.
		ДатаАктуальностиСчетов = НачалоДня(ДокументОбъект.Дата + 24*60*60);
	Иначе
		ДатаАктуальностиСчетов = ДокументОбъект.Дата;
	КонецЕсли;
	
	ВидСубконтоКонтрагенты = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
	ВидСубконтоДоговоры    = ПланыВидовХарактеристик.ВидыСубконто.Договоры;
	
	ТаблицаПроводокНУ = ТаблицаПроводок.СкопироватьКолонки();
	
	// Сформируем проводки НУ по проводкам БУ из таблицы.
	Для Каждого Проводка Из ТаблицаПроводок Цикл
		
		Если Проводка.СчетДт.ТипСчета <> ПредопределенноеЗначение("Перечисление.ТипыСчетов.Бухгалтерский")
		 ИЛИ Проводка.СчетКт.ТипСчета <> ПредопределенноеЗначение("Перечисление.ТипыСчетов.Бухгалтерский") Тогда
			Продолжить; // Проводки НУ формируем только для балансовых проводок по бухгалтерским счетам.
		КонецЕсли;
		
		ВидСчетаДт = НалоговыйУчетКлиентСервер.ВидСчетаБУ(Проводка.СчетДт);
		ВидСчетаКт = НалоговыйУчетКлиентСервер.ВидСчетаБУ(Проводка.СчетКт);
		Если НЕ ЗначениеЗаполнено(ВидСчетаДт)
		 ИЛИ НЕ ЗначениеЗаполнено(ВидСчетаКт) Тогда
			Продолжить; // Для одного из счетов проводки не сможем определить соответствующий счет НУ.
		КонецЕсли;
		
		Если НЕ НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Проводка.Организация, Проводка.Период, Проводка.КФО) Тогда
			Продолжить;
		КонецЕсли;
		
		СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетДт);
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетКт);
		
		ПроводкаНУ = ТаблицаПроводокНУ.Добавить();
		ЗаполнитьЗначенияСвойств(ПроводкаНУ, Проводка,
			"Регистратор,Активность,Период,Организация,ИФО,КФО,Сумма,Содержание,
			|ВидПервичногоДокумента,ДатаПервичногоДокумента,НомерПервичногоДокумента");
		
		// Дт
		СубконтоДт = Новый Соответствие;
		СубконтоДт.Вставить(Проводка.ВидСубконтоДт1, Проводка.СубконтоДт1);
		СубконтоДт.Вставить(Проводка.ВидСубконтоДт2, Проводка.СубконтоДт2);
		СубконтоДт.Вставить(Проводка.ВидСубконтоДт3, Проводка.СубконтоДт3);
		
		Если ВидСчетаДт = "СчетЗатрат" Тогда
			// При выгрузке проводок в таблицу значений субконто могли поменяться местами.
			// В функцию СчетРасходовНУ(...) нужно передать их в правильном порядке - как на счете.
			ПроводкаНУ.СчетДт = НалоговыйУчетКлиентСервер.СчетРасходовНУ(
				Проводка.СчетДт,
				СубконтоДт[СвойстваСчетаДт.ВидСубконто1],
				СубконтоДт[СвойстваСчетаДт.ВидСубконто2],
				СубконтоДт[СвойстваСчетаДт.ВидСубконто3],
				Проводка.СчетКт,
				Проводка.Организация, Проводка.ИФО, Проводка.ПодразделениеДт, ДатаАктуальностиСчетов);
		ИначеЕсли ВидСчетаДт = "СчетФинансовыйРезультатПрошлыхЛет" Тогда
			ПроводкаНУ.СчетДт = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		Иначе
			ПроводкаНУ.СчетДт = НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ(Проводка.СчетДт, ДатаАктуальностиСчетов, "Дт");
		КонецЕсли;
		
		Для НомерСубконто = 1 По 3 Цикл
			БухгалтерскийУчет.УстановитьСубконто(ПроводкаНУ,
				"Дт", Проводка["ВидСубконтоДт"+НомерСубконто], Проводка["СубконтоДт"+НомерСубконто]);
		КонецЦикла;
		Если СубконтоДт.Получить(ВидСубконтоДоговоры) <> Неопределено
			И СубконтоДт.Получить(ВидСубконтоКонтрагенты) = Неопределено Тогда
			// Определим контрагента из реквизита справочника "Договоры".
			БухгалтерскийУчет.УстановитьСубконто(ПроводкаНУ, "Дт", "Контрагенты",
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СубконтоДт.Получить(ВидСубконтоДоговоры), "Контрагент"));
		КонецЕсли;
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "205.00, 209.00, 401.40") Тогда
			БухгалтерскийУчет.УстановитьСубконто(ПроводкаНУ, "Дт", "УсловияПоступленияИВыбытия",
				Перечисления.УсловияПоступленияИВыбытияИмущества.ЗаПлату);
		КонецЕсли;
		
		СвойстваСчетаНУДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПроводкаНУ.СчетДт);
		Если СвойстваСчетаДт.Количественный И СвойстваСчетаНУДт.Количественный Тогда
			ПроводкаНУ.КоличествоДт = Проводка.КоличествоДт;
		КонецЕсли;
		Если СвойстваСчетаДт.Валютный И СвойстваСчетаНУДт.Валютный Тогда
			ПроводкаНУ.ВалютаДт        = Проводка.ВалютаДт;
			ПроводкаНУ.ВалютнаяСуммаДт = Проводка.ВалютнаяСуммаДт;
		КонецЕсли;
		Если СвойстваСчетаДт.УчетПоПодразделениям И СвойстваСчетаНУДт.УчетПоПодразделениям Тогда
			ПроводкаНУ.ПодразделениеДт = Проводка.ПодразделениеДт;
		КонецЕсли;
		Если СвойстваСчетаДт.УчетПоКПС И СвойстваСчетаНУДт.УчетПоКПС Тогда
			ПроводкаНУ.КПСДт = Проводка.КПСДт;
		КонецЕсли;
		
		// Кт
		СубконтоКт = Новый Соответствие;
		СубконтоКт.Вставить(Проводка.ВидСубконтоКт1, Проводка.СубконтоКт1);
		СубконтоКт.Вставить(Проводка.ВидСубконтоКт2, Проводка.СубконтоКт2);
		СубконтоКт.Вставить(Проводка.ВидСубконтоКт3, Проводка.СубконтоКт3);
		
		Если ВидСчетаКт = "СчетЗатрат" Тогда
			// При выгрузке проводок в таблицу значений субконто могли поменяться местами.
			// В функцию СчетРасходовНУ(...) нужно передать их в правильном порядке - как на счете.
			ПроводкаНУ.СчетКт = НалоговыйУчетКлиентСервер.СчетРасходовНУ(
				Проводка.СчетКт,
				СубконтоКт[СвойстваСчетаКт.ВидСубконто1],
				СубконтоКт[СвойстваСчетаКт.ВидСубконто2],
				СубконтоКт[СвойстваСчетаКт.ВидСубконто3],
				Проводка.СчетДт,
				Проводка.Организация, Проводка.ИФО, Проводка.ПодразделениеКт, ДатаАктуальностиСчетов);
		ИначеЕсли ВидСчетаКт = "СчетФинансовыйРезультатПрошлыхЛет" Тогда
			ПроводкаНУ.СчетКт = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "401.40")
				И БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "401.10") Тогда
			// При списании доходов будущих периодов применяется счет доходов Н90.01 "Выручка от реализации товаров, работ, услуг собственного производства".
			ПроводкаНУ.СчетКт = БухгалтерскийУчет.СчетПоКоду("Н90.01", ДатаАктуальностиСчетов, Проводка.Организация);
		Иначе
			ПроводкаНУ.СчетКт = НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ(Проводка.СчетКт, ДатаАктуальностиСчетов, "Кт");
		КонецЕсли;
		
		Для НомерСубконто = 1 По 3 Цикл
			БухгалтерскийУчет.УстановитьСубконто(ПроводкаНУ,
				"Кт", Проводка["ВидСубконтоКт"+НомерСубконто], Проводка["СубконтоКт"+НомерСубконто]);
		КонецЦикла;
		Если СубконтоКт.Получить(ВидСубконтоДоговоры) <> Неопределено
			И СубконтоКт.Получить(ВидСубконтоКонтрагенты) = Неопределено Тогда
			// Определим контрагента из реквизита справочника "Договоры".
			БухгалтерскийУчет.УстановитьСубконто(ПроводкаНУ, "Кт", "Контрагенты",
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СубконтоКт.Получить(ВидСубконтоДоговоры), "Контрагент"));
		КонецЕсли;
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "205.00, 209.00, 401.40") Тогда
			БухгалтерскийУчет.УстановитьСубконто(ПроводкаНУ, "Кт", "УсловияПоступленияИВыбытия",
				Перечисления.УсловияПоступленияИВыбытияИмущества.ЗаПлату);
		КонецЕсли;
		
		СвойстваСчетаНУКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПроводкаНУ.СчетКт);
		Если СвойстваСчетаКт.Количественный И СвойстваСчетаНУКт.Количественный Тогда
			ПроводкаНУ.КоличествоКт = Проводка.КоличествоКт;
		КонецЕсли;
		Если СвойстваСчетаКт.Валютный И СвойстваСчетаНУКт.Валютный Тогда
			ПроводкаНУ.ВалютаКт        = Проводка.ВалютаКт;
			ПроводкаНУ.ВалютнаяСуммаКт = Проводка.ВалютнаяСуммаКт;
		КонецЕсли;
		Если СвойстваСчетаКт.УчетПоПодразделениям И СвойстваСчетаНУКт.УчетПоПодразделениям Тогда
			ПроводкаНУ.ПодразделениеКт = Проводка.ПодразделениеКт;
		КонецЕсли;
		Если СвойстваСчетаКт.УчетПоКПС И СвойстваСчетаНУКт.УчетПоКПС Тогда
			ПроводкаНУ.КПСКт = Проводка.КПСКт;
		КонецЕсли;
		
	КонецЦикла;
	
	// Удалим проводки НУ с одинаковыми счетами и аналитикой по Дт и Кт.
	КоличествоПроводокНУ = ТаблицаПроводокНУ.Количество();
	Для Сч=1 По КоличествоПроводокНУ Цикл
		
		ПроводкаНУ = ТаблицаПроводокНУ[КоличествоПроводокНУ - Сч];
		Если ПроводкаНУ.СчетДт = ПроводкаНУ.СчетКт
		   И ПроводкаНУ.СубконтоДт1 = ПроводкаНУ.СубконтоКт1
		   И ПроводкаНУ.СубконтоДт2 = ПроводкаНУ.СубконтоКт2
		   И ПроводкаНУ.СубконтоДт3 = ПроводкаНУ.СубконтоКт3 Тогда
			ТаблицаПроводокНУ.Удалить(ПроводкаНУ);
		КонецЕсли;
		
	КонецЦикла;
	
	СкорректироватьПроводкиОтраженияДоходовРасходов(ТаблицаПроводокНУ, ДокументОбъект, Новый Структура);
	
	Возврат ТаблицаПроводокНУ;
	
КонецФункции


