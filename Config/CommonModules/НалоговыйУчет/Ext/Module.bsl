		ОписаниеОтбора = Новый Структура("Использование, Поле, ВидСравненияКомпоновкиДанных, Значение");
		ОписаниеОтбора.Вставить("Использование", НомерСубконто=Индекс);
		Если НомерСубконто = Индекс Тогда
			Если ВидСубконтоДоходовРасходов = ПланыВидовХарактеристик.ВидыСубконто.ПрочиеДоходыИРасходы Тогда
				ОписаниеОтбора.Вставить("Поле",                         "Субконто" + Индекс + ".ВидПрочихДоходовИРасходов");
				ОписаниеОтбора.Вставить("ВидСравненияКомпоновкиДанных", ВидСравненияКомпоновкиДанных.Равно);
				ОписаниеОтбора.Вставить("Значение",                     ВидДоходовРасходов);
			ИначеЕсли ВидСубконтоДоходовРасходов = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
				ОписаниеОтбора.Вставить("Поле",                         "Субконто" + Индекс + ".ВидРасходовНУ");
				ОписаниеОтбора.Вставить("ВидСравненияКомпоновкиДанных", ВидСравненияКомпоновкиДанных.Равно);
				ОписаниеОтбора.Вставить("Значение",                     ВидДоходовРасходов);
			КонецЕсли;
		Иначе
			ОписаниеОтбора.Вставить("Поле",                         "Субконто" + Индекс);
			ОписаниеОтбора.Вставить("ВидСравненияКомпоновкиДанных", ВидСравненияКомпоновкиДанных.Равно);
			ОписаниеОтбора.Вставить("Значение",                     СвойстваСчета["ВидСубконто"+Индекс+"ТипЗначения"].ПривестиЗначение(Неопределено));
		КонецЕсли;
		ОтборПоАналитике.Добавить(ОписаниеОтбора);
		
		// группировки
		ОписаниеГруппировки = Новый Структура;
		ОписаниеГруппировки.Вставить("Использование",  НомерСубконто=Индекс);
		ОписаниеГруппировки.Вставить("Поле",           "Субконто" + Индекс);
		ОписаниеГруппировки.Вставить("Представление",  СвойстваСчета["ВидСубконто" + Индекс + "Наименование"]);
		ОписаниеГруппировки.Вставить("ТипГруппировки", 0);
		Группировка.Добавить(ОписаниеГруппировки);
		
	КонецЦикла;
	
	НастройкиРасшифровки = НастройкиАнализаСчета(ОбщиеНастройки, Счет, КорСчет, ОтборПоАналитике, Группировка);
	
	Если ВидСубконтоДоходовРасходов <> Неопределено Тогда
		НастройкиРасшифровки.Вставить("ВидДоходовРасходов",
			Новый Структура("ЭтоДоход, ВидСубконто, ВидДоходовРасходов",
				Лев(СвойстваСчета.Код, 6) = "Н91.01",
				ВидСубконтоДоходовРасходов,
				ВидДоходовРасходов));
	КонецЕсли;
	
	Возврат НастройкиРасшифровки;
	
КонецФункции

Функция НастройкиАнализаСчетаДляКосвенныхРасходов(ОбщиеНастройки, Счет, КорСчет, ВидРасходов = Неопределено)
	
	Если ОбщиеНастройки.Свойство("ПараметрыРасшифровки") Тогда
		Организация   = ОбщиеНастройки.ПараметрыРасшифровки.Организация;
		НачалоПериода = ОбщиеНастройки.ПараметрыРасшифровки.НачалоПериода;
		КонецПериода  = ОбщиеНастройки.ПараметрыРасшифровки.КонецПериода;
	Иначе
		Организация   = ОбщиеНастройки.Организация;
		НачалоПериода = ОбщиеНастройки.НачалоПериода;
		КонецПериода  = ОбщиеНастройки.КонецПериода;
	КонецЕсли;
	
	НомерСубконто = 0;
	
	СчетСсылка = ?(ТипЗнч(Счет) = Тип("Строка"), БухгалтерскийУчетКлиентСервер.СчетПоКоду(Счет, КонецПериода), Счет);
