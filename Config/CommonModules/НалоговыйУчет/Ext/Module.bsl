Функция УбытокОтРеализацииПраваТребованияВключаетсяЕдиновременно(НалоговыйПериод)
	
	// Закон №81-ФЗ от 20 апреля 2014 года внес изменения в п. 2 ст. 279 НК РФ - отменил двухэтапный порядок 
	// включения в расходы убытка от реализации права требования.
	// Это изменение действует с 2015 года. 
	// До этой даты двухэтапный порядок применялся для реализации прав требования после наступления срока платежа.
	// Поэтому в декларации требовалось заполнять детальные сведения о таких убытках.
	ДатаНачалаЕдиновременногоВключенияУбыткаОтРеализацииПраваТребования = '2015-01-01';
	
	Возврат НалоговыйПериод >= ДатаНачалаЕдиновременногоВключенияУбыткаОтРеализацииПраваТребования;
	
КонецФункции	

Функция ЕстьСтрокаДекларацииКорректировкаПрибылиДоРыночныхЦен(НалоговыйПериод)
	
	// С 28 декабря 2016 года строка 107 Приложения 1 к Листу 02 "сумма корректировки прибыли до рыночных цен"
	// исключена из формы налоговой декларации.
	Возврат НалоговыйПериод < '2016-12-28';
	
КонецФункции

Функция ИтогПоСчету(ТаблицаИтогов, Колонка, Счет=Неопределено, Субконто1=Неопределено, Субконто2=Неопределено, Субконто3=Неопределено, КорСчет=Неопределено)
	
	Отбор = Новый Структура;
	Если ЗначениеЗаполнено(Счет) И ТипЗнч(Счет) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		Отбор.Вставить("Счет", Счет);
	КонецЕсли;
	Если ЗначениеЗаполнено(Субконто1) Тогда
		Отбор.Вставить("Субконто1", Субконто1);
	КонецЕсли;
	Если ЗначениеЗаполнено(Субконто2) Тогда
		Отбор.Вставить("Субконто2", Субконто2);
	КонецЕсли;
	Если ЗначениеЗаполнено(Субконто3) Тогда
		Отбор.Вставить("Субконто3", Субконто3);
	КонецЕсли;
	Если ЗначениеЗаполнено(КорСчет) И ТипЗнч(КорСчет) = Тип("ПланСчетовСсылка.ЕПСБУ")  Тогда
		Отбор.Вставить("КорСчет", КорСчет);
	КонецЕсли;
	
	Если Отбор.Количество()=0 Тогда
		СтрокиТаблицы = ТаблицаИтогов;
	Иначе
		СтрокиТаблицы = ТаблицаИтогов.НайтиСтроки(Отбор);
	КонецЕсли;
	
	Итог = 0;
	Для Каждого Строка Из СтрокиТаблицы Цикл
		
		Если ЗначениеЗаполнено(Счет) И ТипЗнч(Счет) = Тип("Строка") Тогда
			Если НЕ БухгалтерскийУчет.СчетВИерархии(Строка.Счет, Счет) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(КорСчет) И ТипЗнч(КорСчет) = Тип("Строка") Тогда
			Если НЕ БухгалтерскийУчет.СчетВИерархии(Строка.КорСчет, КорСчет) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Значение = Строка[Колонка];
		Если Значение <> Неопределено И Значение <> NULL Тогда
			Итог = Итог + Значение;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Итог;
	
КонецФункции

