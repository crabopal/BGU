	Группировка = Новый Массив;
	ОтборПоАналитике = Новый Массив;
	Для Индекс = 1 По СвойстваСчета.КоличествоСубконто Цикл
		
		Если СвойстваСчета["ВидСубконто"+Индекс] = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
			НомерСубконто = Индекс;
		КонецЕсли;
		
		// отборы
		ОписаниеОтбора = Новый Структура("Использование, Поле, ВидСравненияКомпоновкиДанных, Значение");
		ОписаниеОтбора.Вставить("Использование", ЗначениеЗаполнено(ВидРасходов) И (НомерСубконто=Индекс));
		Если ЗначениеЗаполнено(ВидРасходов) И (НомерСубконто=Индекс) Тогда
			ОписаниеОтбора.Вставить("Поле",                         "Субконто" + Индекс + ".ВидРасходовНУ");
			ОписаниеОтбора.Вставить("ВидСравненияКомпоновкиДанных", ВидСравненияКомпоновкиДанных.Равно);
			ОписаниеОтбора.Вставить("Значение",                     ВидРасходов);
		Иначе
			ОписаниеОтбора.Вставить("Поле",                         "Субконто" + Индекс);
			ОписаниеОтбора.Вставить("ВидСравненияКомпоновкиДанных", ВидСравненияКомпоновкиДанных.Равно);
			ОписаниеОтбора.Вставить("Значение",                     СвойстваСчета["ВидСубконто"+Индекс+"ТипЗначения"].ПривестиЗначение(Неопределено));
		КонецЕсли;
		ОтборПоАналитике.Добавить(ОписаниеОтбора);
		
		// группировки
		ОписаниеГруппировки = Новый Структура;
		ОписаниеГруппировки.Вставить("Использование",  НомерСубконто=Индекс);
		ОписаниеГруппировки.Вставить("Поле",           "Субконто" + Индекс);
		ОписаниеГруппировки.Вставить("Представление",  СвойстваСчета["ВидСубконто" + Индекс + "Наименование"]);
		ОписаниеГруппировки.Вставить("ТипГруппировки", 0);
		Группировка.Добавить(ОписаниеГруппировки);
		
	КонецЦикла;
	
	НастройкиРасшифровки = НастройкиАнализаСчета(ОбщиеНастройки, Счет, КорСчет, ОтборПоАналитике, Группировка);
	
	Если ЗначениеЗаполнено(ВидРасходов) Тогда
		НастройкиРасшифровки.Вставить("ВидДоходовРасходов",
			Новый Структура("ЭтоДоход, ВидСубконто, ВидДоходовРасходов",
				Ложь, ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат, ВидРасходов));
	КонецЕсли;
	
	Возврат НастройкиРасшифровки;
	
КонецФункции

