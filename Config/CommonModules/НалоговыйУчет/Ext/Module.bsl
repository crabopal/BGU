Функция ПодготовитьТаблицуСписанныеМПЗ(ТаблицаМПЗ, Реквизиты, Отказ) Экспорт

	ТаблицаСписанныеМПЗ = ТаблицаМПЗ.СкопироватьКолонки();
	ТаблицаСписанныеМПЗ.Колонки.Добавить("СуммаСписанияНУ", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));

	Если ТаблицаМПЗ.Количество() > 0 Тогда

		МоментВремени = Новый МоментВремени(Реквизиты.Дата, Реквизиты.Ссылка);
		ТаблицаОстатки = ПолучитьОстаткиМПЗ(МоментВремени,
			Реквизиты.Организация, Реквизиты.ИФО,
			ТаблицаМПЗ);
		ТаблицаОстатки.Индексы.Добавить("Номенклатура, СчетУчетаНУ");

		Для каждого СтрокаДокумента Из ТаблицаМПЗ Цикл

			КоличествоОсталосьПогасить = СтрокаДокумента.Количество;
			Если КоличествоОсталосьПогасить <= 0 Тогда
				Продолжить;
			КонецЕсли;

			Если ТаблицаОстатки.Количество() <> 0 Тогда

				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Номенклатура", СтрокаДокумента.Номенклатура);
				ПараметрыОтбора.Вставить("СчетУчетаНУ", СтрокаДокумента.СчетУчетаНУ);

				ПартииОстатков = ТаблицаОстатки.НайтиСтроки(ПараметрыОтбора);

				Для каждого СтрокаПартии Из ПартииОстатков Цикл

					Если СтрокаПартии.Количество <= 0 Тогда
						Продолжить;
					КонецЕсли;
					
					Количество = Мин(СтрокаПартии.Количество, КоличествоОсталосьПогасить);

					Стоимость  = Окр(СтрокаПартии.Стоимость * Количество / СтрокаПартии.Количество, 2, 1);

					КоличествоОсталосьПогасить = КоличествоОсталосьПогасить - Количество;

					СтрокаПартии.Количество = СтрокаПартии.Количество - Количество;
					СтрокаПартии.Стоимость  = СтрокаПартии.Стоимость - Стоимость;

					СписаннаяПартия = ТаблицаСписанныеМПЗ.Добавить();
					ЗаполнитьЗначенияСвойств(СписаннаяПартия, СтрокаДокумента);
					СписаннаяПартия.Количество = Количество;
					СписаннаяПартия.СуммаСписанияНУ = Стоимость;
					
				КонецЦикла;

			КонецЕсли;

			// Несписанное количество добавим отдельной строкой в таблицу списанных партий.
			Если КоличествоОсталосьПогасить > 0  Тогда

				СписаннаяПартия = ТаблицаСписанныеМПЗ.Добавить();
				ЗаполнитьЗначенияСвойств(СписаннаяПартия, СтрокаДокумента);
				СписаннаяПартия.Количество = КоличествоОсталосьПогасить;

			КонецЕсли;

			Если КоличествоОсталосьПогасить > 0 Тогда
				
				ТекстОшибки = НСтр("ru='Указанное количество превышает остаток в налоговом учете по счету %3.
					|Остаток: %1; Не хватает: %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					СтрокаДокумента.Количество - КоличествоОсталосьПогасить,
					КоличествоОсталосьПогасить,
					СтрокаДокумента.СчетУчетаНУ);
					
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'Количество'"),
					СтрокаДокумента.НомерСтроки,
					СтрокаДокумента.СинонимСписка,
					ТекстОшибки);
					
				ПолеКоличество = СтрокаДокумента.ИмяСписка + "[" + Формат(СтрокаДокумента.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Количество";
				
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Реквизиты.Ссылка, ПолеКоличество, "Объект");
				
			КонецЕсли;
			
		КонецЦикла;

	КонецЕсли;

	Возврат ТаблицаСписанныеМПЗ;

КонецФункции

// Устарела. Следует использовать функцию .
// Закрытие счетов Н90 и Н91, расчет базы по налогу на прибыль.
//
Функция ПодготовитьТаблицыЗакрытияСчетовН90иН91(СтруктураПараметров) Экспорт
	
	НомераТаблиц = Новый Структура;
	
	Запрос = Новый Запрос;
	
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаСчета90", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаОбороты90", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаЗакрытиеСчета90", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Счет
	|ПОМЕСТИТЬ ВТ_Счета90
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&СчетаДоходыИРасходыПоОбычнымВидамДеятельностиНУ)
	|	И ЕПСБУ.Ссылка <> &СчетПрибыльУбытокОтПродажНУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Организация,
	|	ЕПСБУ.ИФО КАК ИФО,
	|	ЕПСБУ.КФО КАК КФО,
	|	ЕПСБУ.Счет,
	|	ЕПСБУ.Субконто1 КАК Субконто1,
	|	ЕПСБУ.Субконто2 КАК Субконто2,
	|	ЕПСБУ.Субконто3 КАК Субконто3,
	|	ЕСТЬNULL(ЕПСБУ.СуммаОборотКт, 0) - ЕСТЬNULL(ЕПСБУ.СуммаОборотДт, 0) КАК ПрибыльНУ,
	|	ЕСТЬNULL(ЕПСБУ.СуммаНеУчитываетсяНУОборотКт, 0) - ЕСТЬNULL(ЕПСБУ.СуммаНеУчитываетсяНУОборотДт, 0) КАК ПрибыльНеУчитываетсяНУ,
	|	ЕСТЬNULL(ЕПСБУ.СуммаЕНВДОборотКт, 0) - ЕСТЬNULL(ЕПСБУ.СуммаЕНВДОборотДт, 0) КАК ПрибыльЕНВД
	|ПОМЕСТИТЬ Обороты90
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачДата,
	|			&КонДата,
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВТ_Счета90.Счет
	|				ИЗ
	|					ВТ_Счета90),
	|			,
	|			Организация В (&Организация)
	|				И КФО В (&СписокКФО),
	|			КорСчет <> &СчетПрибыльУбытокОтПродажНУ,
	|			) КАК ЕПСБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Обороты90.Организация,
	|	Обороты90.ИФО,
	|	Обороты90.КФО,
	|	&СчетПрибыльУбытокОтПродажНУ КАК СчетПрибылейУбытков,
	|	ВидыСубконто1.ВидСубконто КАК ВидСубконто1,
	|	ВидыСубконто2.ВидСубконто КАК ВидСубконто2,
	|	ВидыСубконто3.ВидСубконто КАК ВидСубконто3,
	|	Обороты90.Субконто1,
	|	Обороты90.Субконто2,
	|	Обороты90.Субконто3,
	|	Обороты90.ПрибыльНУ КАК ПрибыльНУ,
	|	Обороты90.ПрибыльНеУчитываетсяНУ КАК ПрибыльНеУчитываетсяНУ,
	|	Обороты90.ПрибыльЕНВД КАК ПрибыльЕНВД
	|ИЗ
	|	Обороты90 КАК Обороты90
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто1
	|		ПО Обороты90.Счет = ВидыСубконто1.Ссылка
	|			И (ВидыСубконто1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто2
	|		ПО Обороты90.Счет = ВидыСубконто2.Ссылка
	|			И (ВидыСубконто2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто3
	|		ПО Обороты90.Счет = ВидыСубконто3.ВидСубконто
	|			И (ВидыСубконто3.НомерСтроки = 3)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Обороты90.КФО,
	|	Обороты90.ИФО,
	|	Обороты90.Субконто1,
	|	Обороты90.Субконто2,
	|	Обороты90.Субконто3";
	
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаСчета91", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВиртуальнаяТаблицаОбороты91", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаЗакрытиеСчета91", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Счет
	|ПОМЕСТИТЬ ВТ_Счета91
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&СчетаПрочиеДоходыИРасходыНУ)
	|	И ЕПСБУ.Ссылка <> &СчетСальдоПрочихДоходовИРасходовНУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Организация,
	|	ЕПСБУ.ИФО,
	|	ЕПСБУ.КФО,
	|	ЕПСБУ.Счет,
	|	ЕПСБУ.Субконто1,
	|	ЕПСБУ.Субконто2,
	|	ЕПСБУ.Субконто3,
	|	ВЫРАЗИТЬ(ЕПСБУ.Субконто1 КАК Справочник.ПрочиеДоходыИРасходы) КАК СтатьяПрочихДоходовРасходов,
	|	ЕСТЬNULL(ЕПСБУ.СуммаОборотКт, 0) - ЕСТЬNULL(ЕПСБУ.СуммаОборотДт, 0) КАК СуммаОборот,
	|	ЕСТЬNULL(ЕПСБУ.СуммаНеУчитываетсяНУОборотКт, 0) - ЕСТЬNULL(ЕПСБУ.СуммаНеУчитываетсяНУОборотДт, 0) КАК СуммаНеУчитываетсяНУОборот,
	|	ЕСТЬNULL(ЕПСБУ.СуммаЕНВДОборотКт, 0) - ЕСТЬNULL(ЕПСБУ.СуммаЕНВДОборотДт, 0) КАК СуммаЕНВДОборот
	|ПОМЕСТИТЬ Обороты91
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачДата,
	|			&КонДата,
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВТ_Счета91.Счет
	|				ИЗ
	|					ВТ_Счета91),
	|			,
	|			Организация В (&Организация)
	|				И КФО В (&СписокКФО),
	|			КорСчет <> &СчетСальдоПрочихДоходовИРасходовНУ,
	|			) КАК ЕПСБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Обороты91.Организация,
	|	Обороты91.ИФО КАК ИФО,
	|	Обороты91.КФО КАК КФО,
	|	&СчетСальдоПрочихДоходовИРасходовНУ КАК СчетПрибылейУбытков,
	|	ВидыСубконто1.ВидСубконто КАК ВидСубконто1,
	|	ВидыСубконто2.ВидСубконто КАК ВидСубконто2,
	|	ВидыСубконто3.ВидСубконто КАК ВидСубконто3,
	|	Обороты91.Субконто1,
	|	Обороты91.Субконто2,
	|	Обороты91.Субконто3,
	|	Обороты91.СтатьяПрочихДоходовРасходов,
	|	ВЫБОР
	|		КОГДА Обороты91.СтатьяПрочихДоходовРасходов = ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|			ТОГДА Обороты91.СуммаОборот
	|		КОГДА Обороты91.СтатьяПрочихДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения)
	|			ТОГДА Обороты91.СуммаОборот
	|		КОГДА Обороты91.СтатьяПрочихДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты)
	|			ТОГДА Обороты91.СуммаОборот * (1 - &КоэффициентЕНВД)
	|		ИНАЧЕ Обороты91.СуммаОборот
	|	КОНЕЦ КАК ПрибыльНУ,
	|	ВЫБОР
	|		КОГДА Обороты91.СтатьяПрочихДоходовРасходов = ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|			ТОГДА Обороты91.СуммаНеУчитываетсяНУОборот
	|		КОГДА Обороты91.СтатьяПрочихДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения)
	|				И НЕ Обороты91.СтатьяПрочихДоходовРасходов.ПринятиеКналоговомуУчету
	|			ТОГДА Обороты91.СуммаНеУчитываетсяНУОборот
	|		ИНАЧЕ Обороты91.СуммаНеУчитываетсяНУОборот
	|	КОНЕЦ КАК ПрибыльНеУчитываетсяНУ,
	|	ВЫБОР
	|		КОГДА Обороты91.СтатьяПрочихДоходовРасходов = ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|			ТОГДА Обороты91.СуммаЕНВДОборот
	|		КОГДА Обороты91.СтатьяПрочихДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения)
	|			ТОГДА Обороты91.СуммаЕНВДОборот
	|		КОГДА Обороты91.СтатьяПрочихДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты)
	|			ТОГДА Обороты91.СуммаОборот * &КоэффициентЕНВД
	|		ИНАЧЕ Обороты91.СуммаЕНВДОборот
	|	КОНЕЦ КАК ПрибыльЕНВД
	|ИЗ
	|	Обороты91 КАК Обороты91
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто1
	|		ПО Обороты91.Счет = ВидыСубконто1.Ссылка
	|			И (ВидыСубконто1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто2
	|		ПО Обороты91.Счет = ВидыСубконто2.Ссылка
	|			И (ВидыСубконто2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто3
	|		ПО Обороты91.Счет = ВидыСубконто3.ВидСубконто
	|			И (ВидыСубконто3.НомерСтроки = 3)
	|
	|УПОРЯДОЧИТЬ ПО
	|	КФО,
	|	ИФО,
	|	Обороты91.Субконто1,
	|	Обороты91.Субконто2,
	|	Обороты91.Субконто3";
	
	Запрос.УстановитьПараметр("НачДата",         НачалоМесяца(СтруктураПараметров.Дата));
	Запрос.УстановитьПараметр("КонДата",         КонецМесяца(СтруктураПараметров.Дата));
	Запрос.УстановитьПараметр("КонГраница",      Новый Граница(КонецМесяца(СтруктураПараметров.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",     СтруктураПараметров.Организация);
	Запрос.УстановитьПараметр("СписокКФО",       НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета());
	Запрос.УстановитьПараметр("КоэффициентЕНВД", НалоговыйУчет.КоэффициентРаспределенияРасходовПоВидамДеятельности(СтруктураПараметров.Организация, СтруктураПараметров.Дата));
	
	Запрос.УстановитьПараметр("СчетаДоходыИРасходыПоОбычнымВидамДеятельностиНУ",
		БухгалтерскийУчет.СписокСчетов("Н90"));
	Запрос.УстановитьПараметр("СчетПрибыльУбытокОтПродажНУ",
		БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н90.09", КонецМесяца(СтруктураПараметров.Дата)));
	Запрос.УстановитьПараметр("СчетаПрочиеДоходыИРасходыНУ",
		БухгалтерскийУчет.СписокСчетов("Н91"));
	Запрос.УстановитьПараметр("СчетСальдоПрочихДоходовИРасходовНУ",
		БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н91.09", КонецМесяца(СтруктураПараметров.Дата)));
	
	Результат = Запрос.ВыполнитьПакет();
	
	Возврат Новый Структура("ТаблицаЗакрытиеСчета90, ТаблицаЗакрытиеСчета91",
		Результат[НомераТаблиц.ТаблицаЗакрытиеСчета90].Выгрузить(),
		Результат[НомераТаблиц.ТаблицаЗакрытиеСчета91].Выгрузить());
	
КонецФункции

// Устарела. Следует использовать функцию НалоговыйУчетКлиентСервер.СчетНУпоСчетуБУ().
Функция ПолучитьСчетНУпоСчетуБУ(СчетБУ, ДтКт="") Экспорт
	
	ВидСчетаБУ = НалоговыйУчетПовтИсп.ВидСчетаБУ(СчетБУ);
	
	Если ВидСчетаБУ = "СчетЗатрат" Тогда
		// Для определения счета расходов НУ предназначена функция СчетРасходовНУ().
		
	ИначеЕсли ВидСчетаБУ = "СчетОС" ИЛИ ВидСчетаБУ = "СчетНПА" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н01");
		
	ИначеЕсли ВидСчетаБУ = "СчетНМА" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н04");
		
	ИначеЕсли ВидСчетаБУ = "СчетАмортизацииОС" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н02");
		
	ИначеЕсли ВидСчетаБУ = "СчетАмортизацииНМА" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н05");
		
	ИначеЕсли ВидСчетаБУ = "СчетВложенийВНА" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н08");
		
	ИначеЕсли ВидСчетаБУ = "СчетВложенийМЗ" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н15");
		
	ИначеЕсли ВидСчетаБУ = "СчетМатериалов" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н10");
		
	ИначеЕсли ВидСчетаБУ = "СчетГотовойПродукции" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н43");
		
	ИначеЕсли ВидСчетаБУ = "СчетТоваровНаСкладах" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н41.01");
		
	ИначеЕсли ВидСчетаБУ = "СчетТоваровВРознице" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н41.02");
		
	ИначеЕсли ВидСчетаБУ = "СчетТорговойНаценки" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н42");
		
	ИначеЕсли ВидСчетаБУ = "СчетРасчетовПоНалогамИСборам" Тогда
		
		Если БухгалтерскийУчет.СчетВИерархии(СчетБУ, "303.02") Тогда // ФССБольничный
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н69.01");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетБУ, "303.10") Тогда // СтраховаяПенсия
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н69.02");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетБУ, "303.11") Тогда // НакопительнаяПенсия
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н69.03");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетБУ, "303.07") Тогда // ФФОМС
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н69.06");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетБУ, "303.08") Тогда // ТФОМС
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н69.07");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетБУ, "303.09") Тогда // ДополнительныеВзносыНаПенсию
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н69.08");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетБУ, "303.06") Тогда // ФССНесчастныйСлучай
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н69.09");
		Иначе
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("НПВ");
		КонецЕсли;
		
	ИначеЕсли ВидСчетаБУ = "СчетРасчетовСПерсоналом" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н70");
		
	ИначеЕсли ВидСчетаБУ = "СчетРасчетовСПокупателями"
		  ИЛИ ВидСчетаБУ = "СчетРасчетовСПоставщиками"
		  ИЛИ ВидСчетаБУ = "СчетРасчетовСПодотчетнымиЛицами"
		  ИЛИ ВидСчетаБУ = "СчетВложенийВФинансовыеАктивы"
		  ИЛИ ВидСчетаБУ = "СчетПрочихРасчетов" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("НПВ");
		
	ИначеЕсли ВидСчетаБУ = "СчетПрочихДоходов"
		  ИЛИ ВидСчетаБУ = "СчетПрочихРасходов" Тогда
		
		Если ДтКт = "Дт" Тогда
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н91.02");
		Иначе
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н91.01");
		КонецЕсли;
		
	ИначеЕсли ВидСчетаБУ = "СчетРезервовПредстоящихРасходов" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н96");
		
	ИначеЕсли ВидСчетаБУ = "СчетРБП" Тогда
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н97");
		
	КонецЕсли;
	
	Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	
КонецФункции

