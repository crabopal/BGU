#Область ПрограммныйИнтерфейс

// Формирует список шаблонов заданий очереди.
//
// Параметры:
//  ШаблоныЗаданий - Массив - В параметр следует добавить имена предопределенных
//   неразделенных регламентных заданий, которые должны использоваться в качестве
//   шаблонов для заданий очереди.
//
Процедура ПриПолученииСпискаШаблонов(ШаблоныЗаданий) Экспорт
	
	ШаблоныЗаданий.Добавить("ФормированиеПлановыхНачисленийОбразование");
	ШаблоныЗаданий.Добавить("ПереоценкаВалютныхОстатков");
	ШаблоныЗаданий.Добавить("ЗагрузкаКлассификаторовСистемыУчетаИмущества");
	ШаблоныЗаданий.Добавить("ОбновлениеСтатусовОбъектовУчетаСистемыУчетаИмущества");
	ШаблоныЗаданий.Добавить("ОчисткаИсторииЗапросаДанныхИзОчередиГИСГМП");
	ШаблоныЗаданий.Добавить("ОчисткаИсторииОбменаЕБППоНастройке");
	ШаблоныЗаданий.Добавить("ПроверкаСостоянияСистемы");  
	ШаблоныЗаданий.Добавить("ФормированиеДокументовСписанияДБП");
	ШаблоныЗаданий.Добавить("ФормированиеЛистовКассовойКниги");
	
	// БПО
	ИнтеграцияПодсистемБПО.ПриПолученииСпискаШаблонов(ШаблоныЗаданий);
	//Конец БПО
	
	//ВЕТИС
	ШаблоныЗаданий.Добавить(Метаданные.РегламентныеЗадания.ОтправкаПолучениеДанныхВЕТИС.Имя);
	//Конец ВЕТИС
	
	// ЭлектронноеВзаимодействие
	ЭлектронноеВзаимодействие.ПриПолученииСпискаШаблонов(ШаблоныЗаданий);
	// Конец ЭлектронноеВзаимодействие
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПриПолученииСпискаШаблонов(ШаблоныЗаданий);
	КонецЕсли;
	
	// ВнутреннийЭДО
	ШаблоныЗаданий.Добавить(Метаданные.РегламентныеЗадания.УведомлениеОЗадачахВнутреннийЭДО.Имя);
	// Конец ВнутреннийЭДО
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриПолученииСпискаШаблонов(ШаблоныЗаданий);
	// Конец ИнтеграцияС1САрхивом	
		
КонецПроцедуры

// Заполняет соответствие имен методов их псевдонимам для вызова из очереди заданий.
//
// Параметры:
//  СоответствиеИменПсевдонимам - Соответствие - 
//    * Ключ - Псевдоним метода, например ОчиститьОбластьДанных.
//    * Значение - Имя метода для вызова, например РаботаВМоделиСервиса.ОчиститьОбластьДанных.
//        В качестве значения можно указать Неопределено, в этом случае считается что имя 
//        совпадает с псевдонимом.
//
Процедура ПриОпределенииПсевдонимовОбработчиков(СоответствиеИменПсевдонимам) Экспорт
	
	СоответствиеИменПсевдонимам.Вставить("ОбновлениеТиповыхОперацийВОбластиДанных",
		"Справочники.ТиповыеОперации.ОбновлениеТиповыхОперацийВОбластиДанных");
	
	СоответствиеИменПсевдонимам.Вставить("ОтключитьОтПоддержкиТиповыеОперацииВОбластиДанных",
		"Справочники.ТиповыеОперации.ОтключитьОтПоддержкиТиповыеОперацииВОбластиДанных");  
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриОпределенииПсевдонимовОбработчиков(
		СоответствиеИменПсевдонимам);
	// Конец ИнтеграцияС1СДокументооборотом
	
	СоответствиеИменПсевдонимам.Вставить(Метаданные.РегламентныеЗадания.ПроверкаСостоянияСистемы.ИмяМетода);
	
	ОбщегоНазначенияБРО.ПриОпределенииПсевдонимовОбработчиков(СоответствиеИменПсевдонимам);
	
	// БПО
	ИнтеграцияПодсистемБПО.ПриОпределенииПсевдонимовОбработчиков(СоответствиеИменПсевдонимам); 
	// Конец БПО
	
	//ВЕТИС
	СоответствиеИменПсевдонимам.Вставить(Метаданные.РегламентныеЗадания.ОтправкаПолучениеДанныхВЕТИС.ИмяМетода);
	//Конец ВЕТИС
	
	// ЭлектронноеВзаимодействие
	ЭлектронноеВзаимодействие.ПриОпределенииПсевдонимовОбработчиков(СоответствиеИменПсевдонимам);
	// Конец ЭлектронноеВзаимодействие
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПриОпределенииПсевдонимовОбработчиков(СоответствиеИменПсевдонимам);
	КонецЕсли;
	
	// ВнутреннийЭДО
	СоответствиеИменПсевдонимам.Вставить(Метаданные.РегламентныеЗадания.УведомлениеОЗадачахВнутреннийЭДО.ИмяМетода);
	// Конец ВнутреннийЭДО

	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриОпределенииПсевдонимовОбработчиков(СоответствиеИменПсевдонимам);
	// Конец ИнтеграцияС1САрхивом
	
КонецПроцедуры

// Заполняет соответствие методов обработчиков ошибок псевдонимам методов, при возникновении
// ошибок в которых они вызываются.
//
// Параметры:
//  ОбработчикиОшибок - Соответствие -
//    * Ключ - Псевдоним метода, например ОчиститьОбластьДанных.
//    * Значение - Имя метода - обработчика ошибок, для вызова при возникновении ошибки. 
//        Обработчик ошибок вызывается в случае завершения выполнения исходного задания
//        с ошибкой. Обработчик ошибок вызывается в той же области данных, что и исходное задание.
//        Метод обработчика ошибок считается разрешенным к вызову механизмами очереди.
//        Параметры обработчика ошибок:
