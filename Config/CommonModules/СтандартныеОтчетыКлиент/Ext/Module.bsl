Процедура ТабличноеПолеПоСчетамСчетПриИзменении(ФормаОтчета, ИмяЭлемента, Элемент, Другие = "") Экспорт
	
	ТекущиеДанные = ФормаОтчета.Элементы[ИмяЭлемента].ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.Счет) Тогда
			ДанныеСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.Счет);
			Если ДанныеСчета.КоличествоСубконто = 0 Тогда
				ТекущиеДанные.ПоСубсчетам = Истина;
				ТекущиеДанные.ПоСубконто    = СтрЗаменить(ТекущиеДанные.ПоСубконто, "+", "-");
				ТекущиеДанные.Представление = "";
			Иначе
				ТекущиеДанные.ПоСубсчетам = Ложь;
				ТекущиеДанные.ПоСубконто    = СтрЗаменить(ТекущиеДанные.ПоСубконто, "-", "+");
				ТекущиеДанные.Представление = "";
				СтрокаПоСубконто    = "";
				СтрокаПредставление = "";
                Если Другие <> "" Тогда
                    ДрПоля = СтрРазделить(Другие, ",");
                    Для каждого Поле Из ДрПоля Цикл
                        СтрокаПоСубконто    = СтрокаПоСубконто + "-" + Поле;
                    КонецЦикла;
                КонецЕсли;
				Для Индекс = 1 По ДанныеСчета.КоличествоСубконто Цикл
					Если ДанныеСчета["ВидСубконто"+Индекс] = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Партии")
					 ИЛИ ДанныеСчета["ВидСубконто"+Индекс] = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ДокументыРасчетов") Тогда
						// По видам субконто "Партии" и "Документы расчетов" по умолчанию не детализируем.
						СтрокаПоСубконто    = СтрокаПоСубконто + "-" + Индекс;
					Иначе
						СтрокаПоСубконто    = СтрокаПоСубконто + "+" + Индекс;
						СтрокаПредставление = СтрокаПредставление + ДанныеСчета["ВидСубконто" + Индекс + "Наименование"] + ", ";
					КонецЕсли;
				КонецЦикла;
				СтрокаПредставление = Лев(СтрокаПредставление, СтрДлина(СтрокаПредставление) - 2);
				ТекущиеДанные.ПоСубконто    = СтрокаПоСубконто;
				ТекущиеДанные.Представление = СтрокаПредставление;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ТабличноеПолеПоСчетамПоСубсчетамПриИзменении(ФормаОтчета, ИмяЭлемента, Элемент, Другие = "") Экспорт
	
	ТекущиеДанные = ФормаОтчета.Элементы[ИмяЭлемента].ТекущиеДанные;
	ДанныеСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.Счет);
	Если ТекущиеДанные <> Неопределено Тогда
		Если ТекущиеДанные.ПоСубсчетам Тогда
			Если ИмяЭлемента = "РазвернутоеСальдо" Тогда
				ТабличноеПолеПоСчетамПредставлениеОчистка(ФормаОтчета, ИмяЭлемента, Элемент, Ложь);
			КонецЕсли; 
		Иначе
			Если ПустаяСтрока(ТекущиеДанные.Представление) Тогда
				ТекущиеДанные.ПоСубсчетам = Истина;
				Возврат;
			КонецЕсли;
			ТекущиеДанные.ПоСубконто    = СтрЗаменить(ТекущиеДанные.ПоСубконто, "-", "+");
			ТекущиеДанные.Представление = "";
			СтрокаПоСубконто    = "";
			СтрокаПредставление = "";
            Если Другие <> "" Тогда
                ДрПоля = СтрРазделить(Другие, ",");
                Для каждого Поле Из ДрПоля Цикл
                    СтрокаПоСубконто    = СтрокаПоСубконто + "-" + Поле;
                КонецЦикла; 
            КонецЕсли;
			Для Индекс = 1 По ДанныеСчета.КоличествоСубконто Цикл
				СтрокаПоСубконто    = СтрокаПоСубконто + "+" + Индекс;
				СтрокаПредставление = СтрокаПредставление + ДанныеСчета["ВидСубконто" + Индекс + "Наименование"] + ", ";
			КонецЦикла;
			СтрокаПредставление = Лев(СтрокаПредставление, СтрДлина(СтрокаПредставление) - 2);
			ТекущиеДанные.ПоСубконто    = СтрокаПоСубконто;
			ТекущиеДанные.Представление = СтрокаПредставление;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ТабличноеПолеПоСчетамПредставлениеНачалоВыбора(ФормаОтчета, ИмяЭлемента, Элемент, ДанныеВыбора, СтандартнаяОбработка, Другие = "") Экспорт
	
	СтрокаПоСубконто = ФормаОтчета.Элементы[ИмяЭлемента].ТекущиеДанные.ПоСубконто;
	Счет = ФормаОтчета.Элементы[ИмяЭлемента].ТекущиеДанные.Счет;
	ДанныеСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Счет);
	СписокВидовСубконто = Новый СписокЗначений;
	Если ПустаяСтрока(СтрокаПоСубконто) Тогда
        Если Другие <> "" Тогда
            Др = СтрРазделить(Другие, ",");
            Для каждого Д Из Др Цикл
                СписокВидовСубконто.Добавить(Д, Д, ?(СтрНайти(ФормаОтчета.Элементы[ИмяЭлемента].ТекущиеДанные.Представление, Д) > 0, Истина, Ложь));
            КонецЦикла;
        КонецЕсли;
		Для Индекс = 1 По ДанныеСчета.КоличествоСубконто Цикл
			СписокВидовСубконто.Добавить(ДанныеСчета["ВидСубконто" + Индекс], ДанныеСчета["ВидСубконто" + Индекс + "Наименование"]);
		КонецЦикла;
	Иначе
        Стр = СтрокаПоСубконто;
        Стр = СтрЗаменить(СтрокаПоСубконто, "+", "&+");
        Стр = СтрЗаменить(Стр, "-", "&-");
        Элемс = СтрРазделить(Стр, "&");
        Для Элем = 1 По Элемс.Количество() - 1 Цикл
            Имя = Сред(Элемс[Элем], 2);
            Если Имя >= "0" И Имя <= "3" Тогда
    			СписокВидовСубконто.Добавить(ДанныеСчета["ВидСубконто" + Имя], ДанныеСчета["ВидСубконто" + Имя + "Наименование"], ?(Лев(Элемс[Элем], 1) = "+", Истина, Ложь));
            Иначе
    			СписокВидовСубконто.Добавить(Имя, Имя, ?(Лев(Элемс[Элем], 1) = "+", Истина, Ложь));
            КонецЕсли; 
        КонецЦикла; 
	КонецЕсли;	
	ОткрытьФорму("ОбщаяФорма.ФормаНастройкаПоСубконто", Новый Структура("СписокВидовСубконто", СписокВидовСубконто), Элемент);
	
КонецПроцедуры

Процедура ТабличноеПолеПоСчетамПредставлениеОчистка(ФормаОтчета, ИмяЭлемента, Элемент, СтандартнаяОбработка) Экспорт
		
	ФормаОтчета.Элементы[ИмяЭлемента].ТекущиеДанные.ПоСубконто    = СтрЗаменить(ФормаОтчета.Элементы[ИмяЭлемента].ТекущиеДанные.ПоСубконто, "+", "-");
	ФормаОтчета.Элементы[ИмяЭлемента].ТекущиеДанные.Представление = "";
	
КонецПроцедуры

Процедура ТабличноеПолеПоСчетамПредставлениеОбработкаВыбора(ФормаОтчета, ИмяЭлемента, Элемент, ВыбранноеЗначение, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = ФормаОтчета.Элементы[ИмяЭлемента].ТекущиеДанные;
	ДанныеСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.Счет);
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") Тогда 
		СтрокаПоСубконто = "";
		СтрокаПредставление = "";
		Для Каждого ЭлементСписка Из ВыбранноеЗначение Цикл
            Если ТипЗнч(ЭлементСписка.Значение) <> Тип("Строка") Тогда
                Если ЭлементСписка.Пометка Тогда
                    СтрокаПоСубконто    = СтрокаПоСубконто + "+";
                    СтрокаПредставление = СтрокаПредставление + Строка(ЭлементСписка.Значение) + ", ";
    			Иначе
    				СтрокаПоСубконто = СтрокаПоСубконто + "-";
                КонецЕсли;
                Для Й = 1 По 3 Цикл
                    Если ДанныеСчета["ВидСубконто" + Й] = ЭлементСписка.Значение Тогда
                        СтрокаПоСубконто = СтрокаПоСубконто + Й;
                        Прервать;
                    КонецЕсли; 
                КонецЦикла; 
            Иначе
                Если ЭлементСписка.Пометка Тогда
    				СтрокаПоСубконто = СтрокаПоСубконто + "+";
                    СтрокаПредставление = СтрокаПредставление + ЭлементСписка.Значение + ", ";
                Иначе
    				СтрокаПоСубконто = СтрокаПоСубконто + "-";
                КонецЕсли;
    				СтрокаПоСубконто = СтрокаПоСубконто + ЭлементСписка.Значение;
            КонецЕсли;
		КонецЦикла;
		СтрокаПредставление = Лев(СтрокаПредставление, СтрДлина(СтрокаПредставление) - 2);
		
		Если ПустаяСтрока(СтрокаПредставление) И Не ДанныеСчета.ЗапретитьИспользоватьВПроводках Тогда
			Возврат;
		КонецЕсли;
		ТекущиеДанные.ПоСубконто    = СтрокаПоСубконто;
		ТекущиеДанные.Представление = СтрокаПредставление;
		
		Если ПустаяСтрока(СтрокаПредставление) Тогда
			ТекущиеДанные.ПоСубсчетам = Истина;
		Иначе
			Если ИмяЭлемента = "РазвернутоеСальдо" Тогда
				ТекущиеДанные.ПоСубсчетам = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииРаботыСРасшифровкой

Процедура ОбработкаРасшифровкиСтандартногоОтчета(ФормаОтчета, Элемент, Расшифровка, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ИдентификаторОбъекта = СтандартныеОтчетыКлиентСервер.ПолучитьИдентификаторОбъекта(ФормаОтчета);
	
	ПараметрыРасшифровки = СтандартныеОтчетыВызовСервера.ПолучитьПараметрыРасшифровкиОтчета(ФормаОтчета.ДанныеРасшифровки, ИдентификаторОбъекта, Расшифровка);
	
	ЗаполняемыеНастройки = Новый Структура("Показатели, Группировка, Отбор", Ложь, Истина, Ложь);
	Если ПараметрыРасшифровки.ОткрытьЗначение Тогда
		ПоказатьЗначение( , ПараметрыРасшифровки.Значение);
	ИначеЕсли ПараметрыРасшифровки.Свойство("ОткрытьФорму") И ПараметрыРасшифровки.ОткрытьФорму Тогда
		ОткрытьФорму(ПараметрыРасшифровки.Форма, ПараметрыРасшифровки.ПараметрыФормы);		
	Иначе
		СписокПунктовМеню = ПараметрыРасшифровки.СписокПунктовМеню;
		Если СписокПунктовМеню.Количество() = 1 Тогда
			ИДРасшифровки = СписокПунктовМеню[0].Значение;
			ИмяФормы = ПолучитьИмяФормыПоИДРасшифровки(ИДРасшифровки);
			Если ТипЗнч(ИмяФормы) = Тип("Строка") Тогда //отчеты на типовой форме 
				ПараметрыФормы = Новый Структура("ВидРасшифровки, АдресНастроек, СформироватьПриОткрытии, ИДРасшифровки, ЗаполняемыеНастройки",
				1, ФормаОтчета.ДанныеРасшифровки, Истина, ИДРасшифровки, ЗаполняемыеНастройки);
				ОткрытьФорму(ИмяФормы, ПараметрыФормы,, Истина);
			Иначе
				ПоказатьЗначение( , ИмяФормы);
			КонецЕсли;
		ИначеЕсли СписокПунктовМеню.Количество() > 0 Тогда
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ЗаполняемыеНастройки", ЗаполняемыеНастройки);
			ДополнительныеПараметры.Вставить("ФормаОтчета", ФормаОтчета);
			Оповещение = Новый ОписаниеОповещения("ВыбратьИзМенюЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ФормаОтчета.ПоказатьВыборИзМеню(Оповещение, СписокПунктовМеню, Элемент);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыбратьИзМенюЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Если ТипЗнч(Результат.Значение) = Тип("Строка") Тогда
			ИмяФормы = ПолучитьИмяФормыПоИДРасшифровки(Результат.Значение);
			ПараметрыФормы = Новый Структура("ВидРасшифровки, АдресНастроек, СформироватьПриОткрытии, ИДРасшифровки, ЗаполняемыеНастройки",
			1, ДополнительныеПараметры.ФормаОтчета.ДанныеРасшифровки, Истина, Результат.Значение, ДополнительныеПараметры.ЗаполняемыеНастройки);
			ОткрытьФорму(ИмяФормы, ПараметрыФормы,, Истина);
		Иначе
			ПоказатьЗначение( , Результат.Значение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура РезультатПриАктивизацииОбласти(ФормаОтчета, Элемент) Экспорт
	
	ФормаОтчета.ПолеСумма = СтандартныеОтчетыКлиентСервер.СуммаЯчеек(ФормаОтчета.Результат, Неопределено);
	
КонецПроцедуры

#Область ПроцедурыИФункцииРаботыСРасшифровкойОтчетовПоСанкционированиюИФХД

Процедура ОбработкаРасшифровкиСанкционирование(Форма, Элемент, ДанныеРасшифровки, Расшифровка, ПоказательСчет, МассивОсновныхДействий = Неопределено) экспорт
	
	Перем ВыбранноеДействие;
	Перем ПараметрыВыбранногоДействия;
	Перем ПараметрыРасшифровкиДляСтандартныхОтчетов;
	
	Отчет = Форма.Отчет;
	
	ЗаполняемыеНастройки = Новый Структура("Показатели, Группировка, Отбор", Истина, Истина, Ложь);
	
	ДанныеОтчета = Новый Структура("Организация, НачалоПериода, КонецПериода",Отчет.Организация,Отчет.НачалоПериода,Отчет.КонецПериода);
	
	ДополнительныеДействия = СтандартныеОтчетыВызовСервера.ПолучитьСписокДополнительнойРасшифровки(ДанныеОтчета, ДанныеРасшифровки, Расшифровка, ПоказательСчет, ПараметрыРасшифровкиДляСтандартныхОтчетов);
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(ДанныеРасшифровки,Новый ИсточникДоступныхНастроекКомпоновкиДанных(Отчет));
	
	Если МассивОсновныхДействий = Неопределено тогда
		ОбработкаРасшифровки.ПоказатьВыборДействия(Новый ОписаниеОповещения("ОбработкаРасшифровкиСанкционированиеЗавершение", ЭтотОбъект, Новый Структура("ВыбранноеДействие, ДанныеРасшифровки, ЗаполняемыеНастройки, Отчет, ПараметрыВыбранногоДействия, ПараметрыРасшифровкиДляСтандартныхОтчетов, Расшифровка, Форма", ВыбранноеДействие, ДанныеРасшифровки, ЗаполняемыеНастройки, Отчет, ПараметрыВыбранногоДействия, ПараметрыРасшифровкиДляСтандартныхОтчетов, Расшифровка, Форма)), Расшифровка,,ДополнительныеДействия);
	Иначе
		ОбработкаРасшифровки.ПоказатьВыборДействия(Новый ОписаниеОповещения("ОбработкаРасшифровкиСанкционированиеЗавершение", ЭтотОбъект, Новый Структура("ВыбранноеДействие, ДанныеРасшифровки, ЗаполняемыеНастройки, Отчет, ПараметрыВыбранногоДействия, ПараметрыРасшифровкиДляСтандартныхОтчетов, Расшифровка, Форма", ВыбранноеДействие, ДанныеРасшифровки, ЗаполняемыеНастройки, Отчет, ПараметрыВыбранногоДействия, ПараметрыРасшифровкиДляСтандартныхОтчетов, Расшифровка, Форма)), Расшифровка,МассивОсновныхДействий,ДополнительныеДействия);
        Возврат;
	КонецЕсли;
	
	ОбработкаРасшифровкиСанкционированиеДействие(ВыбранноеДействие, ДанныеРасшифровки, ЗаполняемыеНастройки, Отчет, ПараметрыВыбранногоДействия, ПараметрыРасшифровкиДляСтандартныхОтчетов, Расшифровка, Форма);
	
КонецПроцедуры

Процедура ОбработкаРасшифровкиСанкционированиеЗавершение(ВыбранноеДействие, ПараметрыВыбранногоДействия, ДополнительныеПараметры) Экспорт
	
	ДанныеРасшифровки = ДополнительныеПараметры.ДанныеРасшифровки;
	ЗаполняемыеНастройки = ДополнительныеПараметры.ЗаполняемыеНастройки;
	Отчет = ДополнительныеПараметры.Отчет;
	ПараметрыРасшифровкиДляСтандартныхОтчетов = ДополнительныеПараметры.ПараметрыРасшифровкиДляСтандартныхОтчетов;
	Расшифровка = ДополнительныеПараметры.Расшифровка;
	Форма = ДополнительныеПараметры.Форма;
	
	
	ОбработкаРасшифровкиСанкционированиеДействие(ВыбранноеДействие, ДанныеРасшифровки, ЗаполняемыеНастройки, Отчет, ПараметрыВыбранногоДействия, ПараметрыРасшифровкиДляСтандартныхОтчетов, Расшифровка, Форма);

КонецПроцедуры

Процедура ОбработкаРасшифровкиСанкционированиеДействие(ВыбранноеДействие, Знач ДанныеРасшифровки, Знач ЗаполняемыеНастройки, Знач Отчет, Знач ПараметрыВыбранногоДействия, Знач ПараметрыРасшифровкиДляСтандартныхОтчетов, Знач Расшифровка, Знач Форма)
	
	Перем ИмяВыбраннойФормы, ПараметрыФормы;
	
	Если ПараметрыВыбранногоДействия<>Неопределено и ПараметрыВыбранногоДействия<>Null тогда
		Если ВыбранноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение тогда
			ПоказатьЗначение(Неопределено, ПараметрыВыбранногоДействия);
		Иначе
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
			ПараметрыФормы.Вставить("Расшифровка", Новый ОписаниеОбработкиРасшифровкиКомпоновкиДанных(ДанныеРасшифровки, Расшифровка, ПараметрыВыбранногоДействия));
			ПараметрыФормы.Вставить("Организация", 			Отчет.Организация);
			ПараметрыФормы.Вставить("ПредставлениеВарианта","Расшифровка");
			ПараметрыФормы.Вставить("НачалоПериода",		Отчет.НачалоПериода);
			ПараметрыФормы.Вставить("КонецПериода",			Отчет.КонецПериода);
			Если Отчет.Свойство("Счет") тогда
				ПараметрыФормы.Вставить("Счет",			Отчет.Счет);
			КонецЕсли;	
			ОткрытьФорму(Форма.ИмяФормы, ПараметрыФормы,,Истина);
		КонецЕсли;
	ИначеЕсли ВыбранноеДействие <> ДействиеОбработкиРасшифровкиКомпоновкиДанных.Нет Тогда
		ИмяВыбраннойФормы = ПолучитьИмяФормыПоИДРасшифровки(ВыбранноеДействие);
		Если ЗначениеЗаполнено(ИмяВыбраннойФормы) тогда
			ПараметрыФормы = Новый Структура("ВидРасшифровки, АдресНастроек, СформироватьПриОткрытии, ИДРасшифровки, ЗаполняемыеНастройки",
			1, ПараметрыРасшифровкиДляСтандартныхОтчетов, Истина, ВыбранноеДействие, ЗаполняемыеНастройки);
			ОткрытьФорму(ИмяВыбраннойФормы, ПараметрыФормы,, Истина);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ОбновитьОтборКомпоновщикаНастроекБыстрымиОтборами(Элементы,  Отбор) Экспорт
	Для каждого Элемент из Элементы цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") тогда					
			ОбновитьОтборКомпоновщикаНастроекБыстрымиОтборами(Элемент.Элементы,  Отбор);
		КонецЕсли;	
		Для каждого ЭлементОтбора из Отбор цикл
			Если Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЭлементОтбора.Ключ) тогда
				Элемент.Использование  = ЗначениеЗаполнено(ЭлементОтбора.Значение);
				Элемент.ПравоеЗначение = ЭлементОтбора.Значение;
				Элемент.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
				//Для Каждого ЭлементНастройки Из ПользовательскиеНастройки.Элементы Цикл	
				//	Если ЭлементНастройки.ИдентификаторПользовательскойНастройки = ЭлементОтбора.ИдентификаторПользовательскойНастройки Тогда
				//		ЭлементНастройки.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЭлементОтбора.Ключ);
				//		ЭлементНастройки.Использование = ЗначениеЗаполнено(Отчет.Учреждение);
				//		ЭлементНастройки.ПравоеЗначение = Отчет.Учреждение;
				//	КонецЕсли;
				//КонецЦикла;
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;
КонецПРоцедуры	

#КонецОбласти

#КонецОбласти

#Область ПроцедурыИФункцииОпределенияПериода

Процедура УстановитьВидМежотчетногоПериодаПоДате(Отчет) Экспорт
	
	Если НЕ Отчет.Свойство("ТипПериода") Тогда
		Возврат;
	Конецесли;
	
	Если НЕ Отчет.КонецПериода = КонецГода(Отчет.КонецПериода) Тогда
		Если ЗначениеЗаполнено(Отчет.ТипПериода) Тогда
			Отчет.ТипПериода = ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ПустаяСсылка");
			Отчет.ТолькоУказанныйПериод = Ложь;
		КонецЕсли;
	КонецЕсли;
	  
	Если НЕ Отчет.НачалоПериода = КонецГода(Отчет.КонецПериода) Тогда
		Отчет.ТолькоУказанныйПериод = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьДатыПоВидуПериода(Отчет) Экспорт
	
	Если ЗначениеЗаполнено(Отчет.ТипПериода) Тогда 
		Если НЕ Отчет.КонецПериода = КонецГода(Отчет.КонецПериода) Тогда
			Отчет.КонецПериода = КонецГода(Отчет.КонецПериода);
		КонецЕсли;
		Если Отчет.ТолькоУказанныйПериод И НЕ Отчет.НачалоПериода = КонецГода(Отчет.КонецПериода) Тогда
			Отчет.НачалоПериода = КонецГода(Отчет.КонецПериода)
	    КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти

#Область ПроцедурыИФункцииРаботыСКолонтитулами

// Открыть форму настройки колонтитулов и по завершению работы записать настройки.
//
// Параметры
//  Нет
//
Процедура ОткрытьНастройкуКолонтитулов() Экспорт

	Настройка = СтандартныеОтчетыВызовСервера.ПолучитьНастройкиКолонтитулов();
	
	Параметры	= Новый Структура;
	
	Для каждого Элемент Из Настройка Цикл
		Параметры.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	ОткрытьФорму("ОбщаяФорма.ФормаНастройкиКолонтитулов", Параметры,,,,, Новый ОписаниеОповещения("ОткрытьНастройкуКолонтитуловЗавершение", ЭтотОбъект, Новый Структура("Настройка", Настройка)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

Процедура ОткрытьНастройкуКолонтитуловЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Настройка = ДополнительныеПараметры.Настройка;
	
	Если Результат <> КодВозвратаДиалога.Отмена И Результат <> Неопределено Тогда
		
		Для каждого Элемент Из Результат.ВерхнийКолонтитул Цикл
			Настройка.ВерхнийКолонтитул.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
		Для каждого Элемент Из Результат.НижнийКолонтитул Цикл
			Настройка.НижнийКолонтитул.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
		
		СтандартныеОтчетыВызовСервера.ЗаписатьНастройкиКолонтитулов(Настройка);
		
	КонецЕсли;

КонецПроцедуры // ОткрытьНастройкуКолонтитулов()

#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

// Устарела. Следует использовать стандартный диалог выбора периода
//
Функция ВыборПериодаОтчета(Отчет, Форма = Неопределено, ИмяЭкспортнойПроцедурыФормы = "УстановитьПериод_Выбор") Экспорт
	
	Если Форма = Неопределено Тогда
		// По-прежнему используем модальный вызов
		// Используется для обратной совместимости.
		
		ПараметрыФормы = Новый Структура("НачалоПериода, КонецПериода", Отчет.НачалоПериода, Отчет.КонецПериода);
		ВыбранныйПериод = ОткрытьФормуМодально("ОбщаяФорма.НастройкаПериодаОтчета", ПараметрыФормы);
		Если ТипЗнч(ВыбранныйПериод) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Отчет, ВыбранныйПериод);
			Возврат Истина;
		КонецЕсли;
	Иначе
		// Используем немодальный вызов
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения(ИмяЭкспортнойПроцедурыФормы, Форма);
		ОткрытьФорму("ОбщаяФорма.НастройкаПериодаОтчета", Отчет, Форма,,,,ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		//Диалог = Новый ДиалогРедактированияСтандартногоПериода();
		//Диалог.Период.ДатаНачала = Отчет.НачалоПериода;
		//Диалог.Период.ДатаОкончания = Отчет.КонецПериода;
		//Диалог.Показать(ОписаниеОповещенияОЗавершении);

	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

