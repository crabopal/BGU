#Область СлужебныеПроцедурыИФункции

Функция ПолучитьИмяФормыПоИДРасшифровки(ИДРасшифровки) Экспорт
	
	ИмяОбъекта = ИДРасшифровки;
	ШаблонИмениФормы = "Отчет.%ИмяОбъекта%.Форма.ФормаОтчета";
	
	Если Найти(ИДРасшифровки,"ОборотыСчета") <> 0 Тогда
		ИмяОбъекта = "ОборотыСчета";
	ИначеЕсли Найти(ИДРасшифровки,"АнализСчета") <> 0  Тогда
		ИмяОбъекта = "АнализСчета";  
	ИначеЕсли 	Найти(ИДРасшифровки,"ОборотноСальдоваяВедомостьПоСчету") <> 0  Тогда
		ИмяОбъекта = "ОборотноСальдоваяВедомостьПоСчету";
	ИначеЕсли 	Найти(ИДРасшифровки,"КарточкаСчета") <> 0  Тогда
		ИмяОбъекта = "КарточкаСчета";
	ИначеЕсли 	Найти(ИДРасшифровки,"ОтчетПоПроводкам") <> 0  Тогда
		ИмяОбъекта = "ОтчетПоПроводкам";
	ИначеЕсли 	Найти(ИДРасшифровки,"АнализСубконто") <> 0  Тогда
		ИмяОбъекта = "АнализСубконто";
	ИначеЕсли 	Найти(ИДРасшифровки,"КарточкаСубконто") <> 0  Тогда
		ИмяОбъекта = "КарточкаСубконто";
	ИначеЕсли 	Найти(ИДРасшифровки,"ЖурналОпераций0504071") <> 0  Тогда
		ИмяОбъекта = "ЖурналОпераций0504071";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяОбъекта) И ТипЗнч(ИмяОбъекта) = Тип("Строка") Тогда //отчеты на типовой форме
		Возврат СтрЗаменить(ШаблонИмениФормы, "%ИмяОбъекта%", ИмяОбъекта);
	Иначе
		Возврат ИмяОбъекта;
	КонецЕсли;	
	
КонецФункции

