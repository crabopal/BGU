//  ПОДПИСИ
Процедура ПодписиВыводитьПриИзменении(Строка, Результат) Экспорт
    
    Область = "";
    Если Строка.НомерСтроки = 1 Тогда
        Область = "Заголовок";
    ИначеЕсли Строка.НомерСтроки = 2 Тогда
        Область = "Подписи";
    ИначеЕсли Строка.НомерСтроки = 3 Тогда
        Область = "ПодписьГлБухгалтера";
    ИначеЕсли Строка.НомерСтроки = 4 Тогда
        Область = "ПодписьРуководителя";
    КонецЕсли; 
    
    Если НЕ ПустаяСтрока(Область) Тогда
        Обл = Результат.Области.Найти(Область);
        Если Обл <> Неопределено Тогда
            Обл.Видимость = Строка.Выводить;
        КонецЕсли;
    КонецЕсли; 
    
КонецПроцедуры

Функция ПодписиПередНачаломИзменения(Элемент, Данные) Экспорт

    Возврат Элемент.Имя = "ПодписиСотрудник" И НЕ(Данные.ВиденСотрудник);

КонецФункции

Процедура ПодписиСотрудникПриИзменении(Строка, Результат) Экспорт
    
    Область = "";
    Если Строка.НомерСтроки = 2 Тогда
        Обл = Результат.Области.Найти("ДолжностьИсполнителя");
        Если Обл <> Неопределено Тогда
            Обл.Текст  = СтандартныеОтчетыВызовСервера.ПолучитьДолжность(Строка.Сотрудник);
            Результат.Области.ФИОИсполнителя.Текст  = КорреспондентыКлиентСервер.ФИО(Строка(Строка.Сотрудник));
        КонецЕсли; 
    ИначеЕсли Строка.НомерСтроки = 3 Тогда
        Обл = Результат.Области.Найти("ФИОГлавногоБухгалтера");
        Если Обл <> Неопределено Тогда
            Обл.Текст  = КорреспондентыКлиентСервер.ФИО(Строка(Строка.Сотрудник));
        КонецЕсли; 
    ИначеЕсли Строка.НомерСтроки = 4 Тогда
        Обл = Результат.Области.Найти("ФИОРуководителя");
        Если Обл <> Неопределено Тогда
            Обл.Текст  = КорреспондентыКлиентСервер.ФИО(Строка(Строка.Сотрудник));
        КонецЕсли; 
    КонецЕсли; 
КонецПроцедуры

Процедура ПриИзмененииОрганизации(Организация, Подписи) Экспорт
    
    Подписи[2].Сотрудник = СтандартныеОтчетыВызовСервера.ОтветственноеЛицоОрганизации(Организация, "ГлавныйБухгалтер");
    Подписи[3].Сотрудник = СтандартныеОтчетыВызовСервера.ОтветственноеЛицоОрганизации(Организация, "Руководитель");
    
КонецПроцедуры

