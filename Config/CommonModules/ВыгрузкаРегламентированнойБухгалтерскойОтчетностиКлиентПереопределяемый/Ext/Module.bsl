Процедура ДействиеПриОткрытииОбраоткуиВыгрузкиБезПараметров() Экспорт 
	

		ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.ФормаСписка");
		
		Заголовок = НСтр("ru = 'Выгрузка отчетов'");
		ТекстСообщения = НСтр("ru = 'Воспользуйтесь страницей ""Выгрузка"".'");
		
		ПоказатьПредупреждение(,ТекстСообщения,,Заголовок);

	
КонецПроцедуры	

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
// Вызовы частей БСП склонных к изменению
// ЭЦП

Процедура ВыбратьСертификатыДляПодписиВнутр(СтруктураДанных, Форма = Неопределено) Экспорт 
	

		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ВыбранныйСертификат", Неопределено);
		ПараметрыФормы.Вставить("ДляШифрованияИРасшифровки", Ложь);
		
		ЭлектроннаяПодписьСлужебныйКлиент.ВыборСертификатаДляПодписанияИлиРасшифровки(ПараметрыФормы, Форма);

	
КонецПроцедуры	

Процедура СоздатьПодписиВнутр(СтруктураДанных, ОбработкаЗаписи = Неопределено) Экспорт

	
	ПараметрыПодписания = Новый Структура;
	ПараметрыПодписания.Вставить("Операция",НСтр("ru='Подпись файлов пакета'"));
	ПараметрыПодписания.Вставить("ЗаголовокДанных",СтруктураДанных.ОписаниеПодписываемогоОбъекта);
	
	МассивДанных = Новый Массив;
	МассивФайлов = СтруктураДанных.ФайлыДляСозданияПодписей;
	Для Каждого ТекОписаниеФайла Из МассивФайлов Цикл
		СтруктураДляПодписи = Новый Структура;
		СтруктураДляПодписи.Вставить("Данные",ТекОписаниеФайла.ДанныеФайла);
		СтруктураДляПодписи.Вставить("Представление",ТекОписаниеФайла.ПолноеИмя);
		СтруктураДляПодписи.Вставить("ОписаниеФайла",ТекОписаниеФайла);
		МассивДанных.Добавить(СтруктураДляПодписи);
	КонецЦикла;
	ПараметрыПодписания.Вставить("НаборДанных",МассивДанных);
	ПараметрыПодписания.Вставить("ПредставлениеНабора","Файлы (%1)");
	
	
	
	ДанныеДляОбработкиРезультата = Новый Структура;
	ДанныеДляОбработкиРезультата.Вставить("Этап");
	ДанныеДляОбработкиРезультата.Вставить("СтруктураДанных",СтруктураДанных);
	ДанныеДляОбработкиРезультата.Вставить("ОбработкаЗаписи",ОбработкаЗаписи);
	ДанныеДляОбработкиРезультата.Вставить("ПараметрыПодписания",ПараметрыПодписания);
	ДанныеДляОбработкиРезультата.Вставить("СертификатыДляОбработки",Новый Массив);
	
	
	ОбработкаРезультата = Новый ОписаниеОповещения("СоздатьПодписиАсинх", ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентПереопределяемый, ДанныеДляОбработкиРезультата);	
	
	Если СтруктураДанных.РежимПредварительногоВыбораСертификатов = Ложь Тогда  
		
		ДанныеДляОбработкиРезультата.Этап = "2";
		ЭлектроннаяПодписьКлиент.Подписать(ПараметрыПодписания, СтруктураДанных.УидФормы, ОбработкаРезультата);
		
	Иначе 
		
		ДанныеДляОбработкиРезультата.Этап = "Начало";
		ВыполнитьОбработкуОповещения(ОбработкаРезультата);
		
	КонецЕсли;
	

КонецПроцедуры	

Процедура СоздатьПодписиАсинх(Результат, ДополнительныеПараметры) Экспорт

	
	СтруктураДанных = ДополнительныеПараметры.СтруктураДанных;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьПодписиАсинх", ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентПереопределяемый, ДополнительныеПараметры);
	
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		Для Каждого ОписаниеСертификата из ДополнительныеПараметры.СтруктураДанных.МассивОписанийСертификатов Цикл 
			
			ДополнительныеПараметры.СертификатыДляОбработки.Добавить(ОписаниеСертификата);
			
		КонецЦикла;	
		
		
		ДополнительныеПараметры.Этап = "1"; 
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "1" Тогда
		
		Если не ЗначениеЗаполнено(ДополнительныеПараметры.СертификатыДляОбработки) Тогда 
			ДополнительныеПараметры.Этап = "Завершение"; 
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
		КонецЕсли;
		
		ОписаниеСертификата = ДополнительныеПараметры.СертификатыДляОбработки[0];
		ПараметрыПодписания = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительныеПараметры.ПараметрыПодписания);
		ПараметрыПодписания.Вставить("БезПодтверждения",Истина);
		ПараметрыПодписания.Вставить("ОтборСертификатов", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОписаниеСертификата.СертификатСсылка));
		ПараметрыПодписания.Вставить("ОписаниеСертификата", ОписаниеСертификата);
		
		ДополнительныеПараметры.Этап = "2"; 
		
		ЭлектроннаяПодписьКлиент.Подписать(ПараметрыПодписания, СтруктураДанных.УидФормы, ОписаниеОповещения);
		
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "2" Тогда
		Если Не Результат.Успех Тогда 
			СтруктураДанных.Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДополнительныеПараметры.СертификатыДляОбработки) Тогда //может быть уже пустым если вызов идет для режима без предварительного выбора сертификатов 
			ДополнительныеПараметры.СертификатыДляОбработки.Удалить(0);
		КонецЕсли;
		
		
		Если СтруктураДанных.РежимПредварительногоВыбораСертификатов = Ложь Тогда 
			
			ОписаниеСертификата = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент.ДобавитьПодписьВСтруктуру(СтруктураДанных, Результат.ВыбранныйСертификат.Ссылка);
			
		Иначе 
			ОписаниеСертификата = Результат.ОписаниеСертификата;
			
		КонецЕсли;
		
		Для Каждого СтрокаНабора из Результат.НаборДанных Цикл 
			
			ОписаниеПодписи = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьПустуюСтруктуруПараметров("МассивСформированныхПодписей");
			ОписаниеПодписи.НоваяПодписьДвоичныеДанные = СтрокаНабора.СвойстваПодписи.Подпись;
			ОписаниеПодписи.ОписаниеСертификата = ОписаниеСертификата;
			
			Для Каждого ФайлДляСозданияПодписей из СтруктураДанных.ФайлыДляСозданияПодписей Цикл
				Если ФайлДляСозданияПодписей.ДанныеФайла = СтрокаНабора.Данные И 
					ФайлДляСозданияПодписей.ПолноеИмя = СтрокаНабора.ОписаниеФайла.ПолноеИмя Тогда 
					
					ФайлДляСозданияПодписей.МассивСформированныхПодписей.Добавить(ОписаниеПодписи);
				КонецЕсли;	 
			КонецЦикла;
			
		КонецЦикла;	
		
		
		ДополнительныеПараметры.Этап = "1"; 
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда
		
		Если ДополнительныеПараметры.ОбработкаЗаписи<> Неопределено Тогда 
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗаписи);
		КонецЕсли;
		
	КонецЕсли;


КонецПроцедуры



Функция ПолучитьПерсональныеНастройкиРаботыСЭЦП() Экспорт
	

		Возврат ЭлектроннаяПодписьКлиент.ПерсональныеНастройки();

	
КонецФункции

Функция ЗаполнитьСтруктуруСертификата(Сертификат) Экспорт
	

		Возврат ЭлектроннаяПодписьКлиент.СвойстваСертификата(Сертификат);

	
КонецФункции	

Процедура ОткрытьСертификатСоСтруктурой(СтруктураСертификата, Отпечаток, АдресСертификата) Экспорт
	

		ЭлектроннаяПодписьКлиент.ОткрытьСертификат(Отпечаток);

	
КонецПроцедуры	

