#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьДанныеАдреса(КонтактнаяИнформацияОбъекта, ВидАдреса, Префикс, СведенияКонтактнойИнформации) 
	
	СтрокаКИ = КонтактнаяИнформацияОбъекта.Найти(ВидАдреса, "Вид"); 
	
	Если НЕ СтрокаКИ = Неопределено Тогда 
		ДополнительныеПараметры = Новый Структура("НаименованиеВключаетСокращение", Истина);
		СведенияКонтактнойИнформации.Вставить(Префикс, СтрокаКИ.Представление);
		СведенияКонтактнойИнформации.Вставить(Префикс + "XML", СтрокаКИ.ЗначенияПолей);
		СведенияКонтактнойИнформации.Вставить(Префикс + "JSON", СтрокаКИ.Значение);
		СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СведенияКонтактнойИнформации[Префикс + "JSON"], ДополнительныеПараметры); 
		СведенияОбАдресе.Вставить("ЗданиеНомер", СведенияОбАдресе.Здание.Номер);
		СведенияОбАдресе.Вставить("ЗданиеТип", СведенияОбАдресе.Здание.ТипЗдания); 
		Если СтрСравнить(СведенияОбАдресе.Страна, ПредопределенноеЗначение("Справочник.СтраныМира.Россия").Наименование) = 0 Тогда
			СведенияОбАдресе.Вставить("АдресРФ", Истина);
		Иначе
			СведенияОбАдресе.Вставить("АдресРФ", Ложь);
		КонецЕсли;
		Если СведенияОбАдресе.Корпуса.Количество() > 0 Тогда
			СведенияОбАдресе.Вставить("Корпус", СведенияОбАдресе.Корпуса[0].Номер);
			СведенияОбАдресе.Вставить("ТипКорпуса", СведенияОбАдресе.Корпуса[0].ТипКорпуса);
		КонецЕсли;
		Если СведенияОбАдресе.Помещения.Количество() > 0 Тогда
			СведенияОбАдресе.Вставить("Помещение", СведенияОбАдресе.Помещения[0].Номер);
			СведенияОбАдресе.Вставить("ТипПомещения", СведенияОбАдресе.Помещения[0].ТипПомещения);
		КонецЕсли;  
		СведенияОбАдресе.Вставить("ВФормате9Запятых", РегламентированнаяОтчетность.АдресВФормате9Запятых(СтрокаКИ));
		Для Каждого КлючЗначение Из СведенияОбАдресе Цикл 
			СведенияКонтактнойИнформации.Вставить(Префикс + КлючЗначение.Ключ, КлючЗначение.Значение); 
		КонецЦикла;
	КонецЕсли; 
	
КонецПроцедуры	

Функция ПрименяетсяУСНЗаПериод(Организация, НачалоПериода, КонецПериода)
	
	МассивЗначений = Справочники.Организации.ЗначенияЭлементаУчетнойПолитикиЗаПериод(
		"ПрименяетсяУСН",
		Организация,
		НачалоПериода,
		КонецПериода);
	
	Результат = Ложь;
	Для Каждого Значение Из МассивЗначений Цикл
		Результат = Результат ИЛИ Значение;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Процедура ДанныеОтветственногоЛица(Организация, ДатаЗначений, ВидОЛ, СведенияОтветственногоЛица, Постфикс = "")
	
	ОЛ = ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций." + ВидОЛ);
	Данные = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(Организация, ОЛ, ДатаЗначений); 
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("СсылкаНаОбъект", Данные.ОтветственноеЛицоСсылка);
	СтруктураДанных.Вставить("Период", ДатаЗначений); 
	СтруктураДанных.Вставить("УдалятьСсылкуНаОбъект", Истина);
	СтруктураДанных.Вставить("ПолучатьКИдляПечати", Истина); 
	СтруктураДанных.Вставить("EmailФизическиеЛица"); 
	СтруктураДанных.Вставить("EmailФизическиеЛицаЗначение"); 
	СтруктураДанных.Вставить("ТелефонРабочийФизическиеЛица");
	СтруктураДанных.Вставить("ТелефонРабочийФизическиеЛицаЗначение");
	СтруктураДанных.Вставить("АдресПоПропискеФизическиеЛица"); 
	СтруктураДанных.Вставить("АдресПоПропискеФизическиеЛицаЗначение"); 
	СтруктураДанных.Вставить("Фамилия"); 
	СтруктураДанных.Вставить("Имя"); 
	СтруктураДанных.Вставить("Отчество");
	СтруктураДанных.Вставить("НаименованиеПолное");
	СтруктураДанных.Вставить("ИНН"); 
	СтруктураДанных.Вставить("СтраховойНомерПФР");
	СтруктураДанных.Вставить("ДатаРождения");
	СтруктураДанных.Вставить("МестоРождения");
	СтруктураДанных.Вставить("Пол"); 
	СтруктураДанных.Вставить("УдостоверениеЛичности");
	СтруктураДанных.Вставить("ВидДокументаНаименование");
	СтруктураДанных.Вставить("КодВидаДокумента");
	СтруктураДанных.Вставить("ДатаВыдачи");  
	СтруктураДанных.Вставить("КемВыдан");
	СтруктураДанных.Вставить("КодПодразделения");
	СтруктураДанных.Вставить("Номер");
	СтруктураДанных.Вставить("Серия");  
	СтруктураДанных.Вставить("СрокДействия"); 
	СтруктураДанных.Вставить("Гражданство");
	СтруктураДанных.Вставить("ГражданствоНаименование");
	СтруктураДанных.Вставить("ГражданствоКод");
	СтруктураДанных.Вставить("ДолжностьНаименование");
	СтруктураДанных.Вставить("ФизЛицоСсылка");
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(СтруктураДанных); 
	
	Если СтруктураДанных.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский") Тогда
		СтруктураДанных.Вставить("ПолЧислом", 2); 
	ИначеЕсли СтруктураДанных.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской") Тогда
		СтруктураДанных.Вставить("ПолЧислом", 1); 
	Иначе
		СтруктураДанных.Вставить("ПолЧислом", 0);
	КонецЕсли;
	
	Для Каждого КлючЗначение Из СтруктураДанных Цикл
		СведенияОтветственногоЛица.Вставить(ВидОЛ + Постфикс + КлючЗначение.Ключ, КлючЗначение.Значение); 
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПриОпределенииКонтактнойИнформацииОтветственногоЛица(Организация, Поля, Дата, КонтактнаяИнформация, ВидОЛ, Постфикс = "")
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат; // Реквизиты организации нельзя заполнить, если организация не выбрана.
	КонецЕсли;
	
	Если ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации") Тогда
		Возврат;
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(Дата) Тогда
		ДатаЗначений = Дата;
	Иначе
		ДатаЗначений = ТекущаяДатаСеанса();
	КонецЕсли; 	
	
	СведенияКонтактнойИнформации = Новый Структура;
	
	ОЛ = ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций." + ВидОЛ);
	Данные = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(Организация, ОЛ, ДатаЗначений);
	
	Если ЗначениеЗаполнено(Данные.ОтветственноеЛицоКонтрагент) Тогда
		ФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.ОтветственноеЛицоКонтрагент, "ЮридическоеФизическоеЛицо");
		Отбор = УправлениеКонтактнойИнформацией.ОтборКонтактнойИнформации();
		Отбор.Дата = ДатаЗначений;
		КонтактнаяИнформацияОбъекта = УправлениеКонтактнойИнформацией.КонтактнаяИнформация(ФизЛицо, Отбор); 
		Если ТипЗнч(КонтактнаяИнформацияОбъекта) = Тип("ТаблицаЗначений") И КонтактнаяИнформацияОбъекта.Количество() > 0 Тогда 
			ДобавитьДанныеАдреса(КонтактнаяИнформацияОбъекта, ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.АдресМестаПроживанияФизическиеЛица"), 
			ВидОЛ + Постфикс + "Адрес", СведенияКонтактнойИнформации);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Поля) Тогда
		Результат = Новый Структура(Поля); 
		Для Каждого КлючЗначение Из  Результат Цикл
			Если НЕ СведенияКонтактнойИнформации.Свойство(КлючЗначение.Ключ) Тогда
				Результат.Удалить(КлючЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;	
		ЗаполнитьЗначенияСвойств(Результат, СведенияКонтактнойИнформации); 
	Иначе  
		Результат = СведенияКонтактнойИнформации;
	КонецЕсли;   
	
	Для Каждого КлючЗначение Из Результат Цикл
		КонтактнаяИнформация.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти