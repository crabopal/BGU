#Область ПрограммныйИнтерфейс

Функция ЕстьНеВыделенныеНаБалансОбособленныеПодразделения(ОрганизацияСсылка, ТолькоСОтдельнойКассой = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ОрганизацияСсылка", ОрганизацияСсылка);
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Подразделения.Ссылка
	|ИЗ
	|	Справочник.Подразделения КАК Подразделения
	|ГДЕ
	|	Подразделения.ОбособленноеПодразделение = ИСТИНА
	|	И Подразделения.Владелец = &ОрганизацияСсылка";
	
	Если ТолькоСОтдельнойКассой  Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И Подразделения.ВедетсяКассоваяКнига = ИСТИНА";
		
	КонецЕсли;
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции	

Функция ДолжностьСотрудника(Сотрудник, НаДату) Экспорт
	
	ТребуемыеДанные = Новый Структура("СсылкаНаОбъект, Период, Должность", Сотрудник, НаДату);
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные);
	
	Возврат ТребуемыеДанные.Должность;
	
КонецФункции	

Функция ЕдинственноеПодразделениеОрганизации(ОрганизацияСсылка) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	Подразделения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Подразделения КАК Подразделения
	|ГДЕ
	|	Подразделения.Владелец = &Владелец");
	 
	 Запрос.УстановитьПараметр("Владелец", ОрганизацияСсылка);
	 
	 Выборка = Запрос.Выполнить().Выбрать();
	
	 Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;

	КонецЕсли;	

	Возврат Справочники.Подразделения.ПустаяСсылка();
	
КонецФункции	

#Область ОрганизацииСервер

// Возвращает структуру, содержащую сведения о регистрационной информации организации.
// 
// Параметры:
//  Организация - ОпределяемыйТип.Организация - организация, сведения по которой необходимо получить.
//  Поля - Строка - имена полей, перечисленные через запятую, в формате требований к свойствам структуры.
//                  Список допустимых имен полей см. в описании возвращаемого значения (это максимально возможный список
//                  полей, конечный состав определяется в ОрганизацииПереопределяемый.ПриОпределенииРегистрационныхДанныхОрганизации).
//                  Если указана пустая строка, то возвращаются значения всех полей.
//  Дата - Дата
//       - Неопределено - дата, на которую требуется получить данные. Если значение не указано,
//                  то возвращается значение на текущую дату.
//  КодЯзыка - см. СведенияОбОрганизации.КодЯзыка
// Возвращаемое значение:
//   Структура - содержит значения затребованных полей:
//            * ДатаРегистрации - Дата - дата регистрации юридического лица.
//            * ИНН - Строка - ИНН организации.
//            * КодНалоговогоОргана - Строка - код налогового органа.
//            * КодОКВЭД - Строка - код ОКВЭД.
//            * КодОКВЭД2 - Строка - код ОКВЭД2.
//            * КодОКФС - Строка - код ОКФС.
//            * КодПоОКАТО - Строка - код по ОКАТО.
//            * КодПоОКТМО - Строка - код по ОКТМО.
//            * КПП - Строка - КПП организации.
//            * НаименованиеНалоговогоОргана - Строка - наименование налогового органа.
//            * НаименованиеОКВЭД - Строка - наименование ОКВЭД.
//            * НаименованиеОКВЭД2 - Строка - наименование ОКВЭД2.
//            * НаименованиеПолное - Строка - полное наименование.
//            * НаименованиеСокращенное - Строка - сокращенное наименование.
//            * ОГРН - Строка - ОГРН.
//            * *ПризнакНалогоплательщикаКатегория - Строка - признак налогоплательщика категория.
//            * *ПризнакНалогоплательщикаКод - Число - признак налогоплательщика код.
//            * РегистрационныйНомерПФР - Строка - регистрационный номер ПФР.
//            * РегистрационныйНомерТФОМС - Строка - регистрационный номер ТФОМС.
//            * СвидетельствоДатаВыдачи - Дата - дата выдачи свидетельства.
//            * СвидетельствоКодОргана - Строка - код органа выдавшего свидетельство.
//            * СвидетельствоНаименованиеОргана - Строка - наименование органа выдавшего свидетельство.
//            * СвидетельствоСерияНомер - Строка - серия и номер свидетельства.
//            * *СтавкаНалогаНаПрибыльМестный - Число - местная ставка налога на прибыль.
//            * *СтавкаНалогаНаПрибыльСубъектРФ - Число - ставка налога на прибыль субъекта РФ.
//            * *СтавкаНалогаНаПрибыльФБ - Число - ставка налога на прибыль федерального бюджета.
//            * *СтавкаНалогаУСН - Число - ставка налога УСН.
//            * ЭтоФизическоеЛицо - Булево - признак что это физическое лицо.
//            * ЭтоЮридическоеЛицо - Булево - признак что это юридическое лицо.
//
//        * *КодОКОНХ - Строка - код ОКОНХ.
//        * *КодОрганаПФР - Строка - код органа ПФР.
//        * *КодОрганаФСГС - Строка - код органа ФСГС.
//        * *КодПодчиненностиФСС - Строка - код подчиненности ФСС.
//        * КодПодчиненностиФССДобрСтрах - Строка - код подчиненности ФСС добр. страх. 
//        * *НаименованиеТерриториальногоОрганаФСС - Строка - наименование территориального органа ФСС.
//        * *РегистрационныйНомерФСС - Строка - регистрационный номер ФСС.
//        * ШифрСтрахователяФСС - Строка - шифр страхователя ФСС.  
//
//        * ГоловнаяОрганизацияКПП - Строка - КПП головная организация.
//        * ГоловнаяОрганизацияНаименование - Строка - наименование головной организации.
//
Процедура ПриОпределенииРегистрационныхДанныхОрганизации(Организация, Поля, Дата, РегистрационныеДанные) Экспорт 
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат; // Реквизиты организации нельзя заполнить, если организация не выбрана.
	КонецЕсли;
	
	Если ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации") Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Дата) Тогда
		ДатаЗначений = Дата;
	Иначе
		ДатаЗначений = ТекущаяДатаСеанса();
	КонецЕсли; 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Организации.ДатаРегистрации КАК ДатаРегистрации,
	|	Организации.ИНН КАК ИНН,
	|	Организации.КодНалоговогоОргана КАК КодНалоговогоОргана,
	|	Организации.КодОКВЭД КАК КодОКВЭД,
	|	Организации.КодОКВЭД2 КАК КодОКВЭД2,
	|	Организации.КодКФС КАК КодОКФС,
	|	Организации.КодОКАТО КАК КодПоОКАТО,
	|	Организации.КодОКТМО КАК КодПоОКТМО, 
	|	Организации.КодОКПО КАК КодОКПО,
	|	ЕстьNULL(Организации.КодКОПФ.Код, """") КАК КодКОПФ,  
	|	ЕстьNULL(Организации.КодКОПФ.НаименованиеПолное, """") КАК НаименованиеОПФ,  
	|	Организации.КПП КАК КПП,
	|	Организации.НаименованиеНалоговогоОргана КАК НаименованиеНалоговогоОргана,
	|	Организации.НаименованиеОКВЭД КАК НаименованиеОКВЭД,
	|	Организации.НаименованиеОКВЭД2 КАК НаименованиеОКВЭД2,
	|	Организации.НаименованиеПолное КАК НаименованиеПолное,
	|	Организации.НаименованиеСокращенное КАК НаименованиеСокращенное,
	|	Организации.ОГРН КАК ОГРН,
	|	Организации.РегистрационныйНомерПФР КАК РегистрационныйНомерПФР,
	|	Организации.РегистрационныйНомерТФОМС КАК РегистрационныйНомерТФОМС,
	|	Организации.СвидетельствоДатаВыдачи КАК СвидетельствоДатаВыдачи,
	|	Организации.СвидетельствоКодОргана КАК СвидетельствоКодОргана,
	|	Организации.СвидетельствоНаименованиеОргана КАК СвидетельствоНаименованиеОргана,
	|	Организации.СвидетельствоСерияНомер КАК СвидетельствоСерияНомер,
	|	ЛОЖЬ КАК ЭтоФизическоеЛицо,
	|	ЛОЖЬ КАК ЭтоИндивидуальныйПредприниматель,
	|	ИСТИНА КАК ЭтоЮридическоеЛицо,
	|	ИСТИНА КАК ЭтоНекоммерческаяОрганизация,
	|	ВЫБОР
	|		КОГДА Организации.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК ПризнакНалогоплательщикаКод,
	|	""01"" КАК ПризнакНалогоплательщикаКатегория, 
	|	Организации.КодОКОНХ КАК КодОКОНХ,
	|	Организации.КодОрганаПФР КАК КодОрганаПФР,
	|	Организации.НаименованиеТерриториальногоОрганаПФР КАК НаименованиеТерриториальногоОрганаПФР,
	|	Организации.КодОрганаФСГС КАК КодОрганаФСГС,
	|	Организации.КодПодчиненностиФСС КАК КодПодчиненностиФСС,
	|	Организации.НаименованиеТерриториальногоОрганаФСС КАК НаименованиеТерриториальногоОрганаФСС,
	|	Организации.РегистрационныйНомерФСС КАК РегистрационныйНомерФСС,  
	|	Организации.ДополнительныйКодФСС КАК ДополнительныйКодФСС, 
	|	Организации.РегистрационныйНомерСФР КАК РегистрационныйНомерСФР,
	//|	ВЫБОР
	//|		КОГДА Организации.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	//|			ТОГДА """"
	//|		ИНАЧЕ Организации.ГоловнаяОрганизация.РегистрационныйНомерФСС
	//|	КОНЕЦ КАК РегНомерСФРГоловнойОрганизации,
	|	Организации.НаименованиеКФС КАК НаименованиеФормыСобственности,
	|	ЛОЖЬ КАК ПризнакКрупнейшегоНалогоплательщика
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Организация"); 
	
	Запрос.УстановитьПараметр("Организация", Организация); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(); 
	
	ДоступныеДанные = Новый Структура;
	Для Каждого Колонка ИЗ РезультатЗапроса.Колонки Цикл
		ДоступныеДанные.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Поля) Тогда
		Результат = Новый Структура(Поля);
		Для Каждого КлючЗначение Из  Результат Цикл
			Если НЕ ДоступныеДанные.Свойство(КлючЗначение.Ключ) Тогда
				Результат.Удалить(КлючЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;	
	Иначе  
		Результат = ДоступныеДанные;
	КонецЕсли;
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;	
	
	Для Каждого КлючЗначение Из Результат Цикл
		РегистрационныеДанные.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);	
	КонецЦикла;	
	
КонецПроцедуры

// Возвращает структуру, содержащую сведения о дополнительной информации организации.
// 
// Параметры:
//  Организация - ОпределяемыйТип.Организация - организация, сведения по которой необходимо получить.
//  Поля - Строка - имена полей, перечисленные через запятую, в формате требований к свойствам структуры.
//                  Список допустимых имен полей см. в описании возвращаемого значения (это максимально возможный список
//                  полей, конечный состав определяется в ОрганизацииПереопределяемый.ПриОпределенииДополнительныхСведенийОрганизации).
//                  Если указана пустая строка, то возвращаются значения всех полей.
//  Дата - Дата
//       - Неопределено - дата, на которую требуется получить данные. Если значение не указано,
//                  то возвращается значение на текущую дату.
//  КодЯзыка - см. СведенияОбОрганизации.КодЯзыка
// 
// Возвращаемое значение:
//   Структура - содержит значения затребованных полей:
//        * ДолжностьОтправителя - Строка - должность отправителя.
//        * ВидПлательщикаСтраховыхВзносов - Строка - вид плательщика страховых взносов.
//        * ДатаПереходаНаУСН - Дата - дата перехода на УСН.
//        * ОбъектНалогообложенияУСН - Число - объект налогообложения УСН.
//        * ОтветственноеЛицоСтатистикаФИО - Строка - ФИО ответственного лица за статистическую отчетность.
//        * ОтветственноеЛицоСтатистикаДолжность - Строка - должность ответственного лица за статистическую отчетность.
//        * ОтветственноеЛицоСтатистикаТелефон - Строка - телефон ответственного лица за статистическую отчетность.
//        * ОтветственноеЛицоСтатистикаАдресЭлектроннойПочты - Строка - email ответственного лица за статистическую отчетность.
//        * СведенияОбИсполнителеДолжность - Строка - должность исполнителя.
//        * СведенияОбИсполнителеТелефон - Строка - телефон исполнителя.
//        * СведенияОбИсполнителеФИО - Строка - ФИО.
//        * БухгалтерИмя - Строка - имя бухгалтера.
//        * БухгалтерОтчество - Строка - отчество бухгалтера.
//        * БухгалтерФамилия - Строка - фамилия бухгалтера.
//        * БухгалтерАдресЭлектроннойПочты - Строка - адрес электронной почты бухгалтера.	
//        * РуководительДолжность - Строка - должность руководителя.
//        * РуководительИмя - Строка - имя руководителя.
//        * РуководительОтчество - Строка - отчество руководителя.
//        * РуководительФамилия - Строка - фамилия руководителя.
//        * РуководительАдресЭлектроннойПочты - Строка - адрес электронной почты руководителя.
//        * СистемыНалогообложения - Строка - система налогообложения.
//        * СтраховойТариф - Число - страховой тариф.
//        * ЭмблемаОрганизацииДляШтампаЭлектроннойПодписи - Картинка - эмблема организации для штампа электронной 
//            подписи согласно ГОСТ Р 7.0.97-2016.
//  
Процедура ПриОпределенииДополнительныхСведенийОрганизации(Организация, Поля, Дата, ДополнительныеСведения) Экспорт
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат; // Реквизиты организации нельзя заполнить, если организация не выбрана.
	КонецЕсли;
	
	Если ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации") Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Дата) Тогда
		ДатаЗначений = Дата;
	Иначе
		ДатаЗначений = ТекущаяДатаСеанса();
	КонецЕсли; 

	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Организация, ДатаЗначений); 
	
	СистемыНалогообложения = "";
	СистемыНалогообложения = ?(УчетнаяПолитика.ПрименяетсяУСН <> Неопределено И УчетнаяПолитика.ПрименяетсяУСН, "УСН", "ОСНО");
	СистемыНалогообложения = СистемыНалогообложения + ?(УчетнаяПолитика.ПлательщикЕНВД <> Неопределено И УчетнаяПолитика.ПлательщикЕНВД, ", ЕНВД", "");
    ДополнительныеСведения.Вставить("СистемыНалогообложения", СистемыНалогообложения);
	
	ДополнительныеСведения.Вставить("ВидПлательщикаСтраховыхВзносов", ?(УчетнаяПолитика.ЭтоАвтономноеУчреждение, "00", "01"));
	
	Если УчетнаяПолитика.ОбъектНалогообложенияУСН = Перечисления.ОбъектыНалогообложенияПоУСН.Доходы Тогда
		СтавкаНалогаУСН = ?(ЗначениеЗаполнено(УчетнаяПолитика.СтавкаНалогаУСН), УчетнаяПолитика.СтавкаНалогаУСН, 6);
	ИначеЕсли УчетнаяПолитика.ОбъектНалогообложенияУСН = Перечисления.ОбъектыНалогообложенияПоУСН.ДоходыМинусРасходы Тогда
		СтавкаНалогаУСН = ?(ЗначениеЗаполнено(УчетнаяПолитика.СтавкаНалогаУСН), УчетнаяПолитика.СтавкаНалогаУСН, 15);
	Иначе
		СтавкаНалогаУСН = 0;
	КонецЕсли;
 	ДополнительныеСведения.Вставить("СтавкаНалогаУСН", СтавкаНалогаУСН);  
	
	Если УчетнаяПолитика.ОбъектНалогообложенияУСН = Перечисления.ОбъектыНалогообложенияПоУСН.Доходы Тогда
		ОбъектНалогообложенияУСН = 1;
	ИначеЕсли УчетнаяПолитика.ОбъектНалогообложенияУСН = Перечисления.ОбъектыНалогообложенияПоУСН.ДоходыМинусРасходы Тогда
		ОбъектНалогообложенияУСН = 2;
	Иначе
		ОбъектНалогообложенияУСН = 0;
	КонецЕсли;
	ДополнительныеСведения.Вставить("ОбъектНалогообложенияУСН", ОбъектНалогообложенияУСН);  
	
	ДополнительныеСведения.Вставить("ДатаПереходаНаУСН", ?(ЗначениеЗаполнено(УчетнаяПолитика.ДатаПереходаНаУСН), УчетнаяПолитика.ДатаПереходаНаУСН, '00010101000000'));

    ДополнительныеСведения.Вставить("ПрименяетсяУСН", ?(УчетнаяПолитика.ПрименяетсяУСН <> Неопределено И УчетнаяПолитика.ПрименяетсяУСН, 1, 0));
			
	ДополнительныеСведения.Вставить("ПрименяетсяУСНЗаПериод", ПрименяетсяУСНЗаПериод(Организация, НачалоГода(ДатаЗначений), ДатаЗначений)); 
	
	ДополнительныеСведения.Вставить("Сервис_УказываетсяНаименованиеРегистрирующегоОргана", Ложь);   
	
	СтавкаФБ = 0;
	СтавкаРФ = 0;
	СтруктураПараметров = Новый Структура("Организация, Дата", Организация, ДатаЗначений);
	НалоговыйУчет.ПолучитьСтавкуНалогаНаПрибыль(СтруктураПараметров, СтавкаФБ, СтавкаРФ);
    ДополнительныеСведения.Вставить("СтавкаНалогаНаПрибыльМестный", 0);  
    ДополнительныеСведения.Вставить("СтавкаНалогаНаПрибыльСубъектРФ", СтавкаРФ * 100);  
    ДополнительныеСведения.Вставить("СтавкаНалогаНаПрибыльФБ", СтавкаФБ * 100);  

КонецПроцедуры

// Возвращает структуру, содержащую сведения о контактной информации организации.
// 
// Параметры:
//  Организация - ОпределяемыйТип.Организация - организация, сведения по которой необходимо получить.
//  Поля - Строка - имена полей, перечисленные через запятую, в формате требований к свойствам структуры.
//                  Список допустимых имен полей см. в описании возвращаемого значения (это максимально возможный список
//                  полей, конечный состав определяется в ОрганизацииПереопределяемый.ПриОпределенииКонтактнойИнформацииОрганизации).
//                  Если указана пустая строка, то возвращаются значения всех полей.
//  Дата - Дата
//       - Неопределено - дата, на которую требуется получить данные. Если значение не указано,
//                  то возвращается значение на текущую дату.
//  КодЯзыка - см. СведенияОбОрганизации.КодЯзыка
// 
// Возвращаемое значение:
//   Структура - содержит значения затребованных полей:
//            * АдресОрганизации - Строка - адрес организации.
//            * АдресОрганизацииXML - Строка - адрес организации xml.
//            * АдресОрганизацииJSON - Строка - адрес организации json.
//            * АдресОрганизацииГород - Строка - город.
//            * АдресОрганизацииДом - Строка - дом.
//            * АдресОрганизацииИндекс - Строка - индекс.
//            * АдресОрганизацииКвартира - Строка - квартира.
//            * АдресОрганизацииКодРегиона - Строка - код региона.
//            * АдресОрганизацииКорпус - Строка - корпус.
//            * АдресОрганизацииНаселенныйПункт - Строка - населенный пункт.
//            * АдресОрганизацииРайон - Строка - район.
//            * АдресОрганизацииРегион - Строка - регион.
//            * АдресОрганизацииУлица - Строка - улица.
//  
//        * АдресОрганизацииФакт - Строка - адрес организации.
//        * АдресОрганизацииФактXML - Строка - адрес организации xml.
//        * АдресОрганизацииФактJSON - Строка - адрес организации json.
//        * АдресИностраннойОрганизации - Строка - адрес иностранной организации.
//        * АдресИностраннойОрганизацииXML - Строка - адрес иностранной организации.
//        * АдресИностраннойОрганизацииJSON - Строка - адрес иностранной организации.
//        * ПочтовыйАдресОрганизации - Строка - почтовый адрес организации.
//        * ПочтовыйАдресОрганизацииXML - Строка - почтовый адрес организации в формате xml.
//        * ПочтовыйАдресОрганизацииJSON - Строка - почтовый адрес организации в формате json.
//        * ТелефонОрганизации - Строка - телефон организации.
//        * ФаксОрганизации - Строка - факс организации.
//        * АдресЭлектроннойПочтыОрганизации - Строка - email организации.
//
Процедура ПриОпределенииКонтактнойИнформацииОрганизации(Организация, Поля, Дата, КонтактнаяИнформация) Экспорт
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат; // Реквизиты организации нельзя заполнить, если организация не выбрана.
	КонецЕсли;
	
	Если ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации") Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Дата) Тогда
		ДатаЗначений = Дата;
	Иначе
		ДатаЗначений = ТекущаяДатаСеанса();
	КонецЕсли; 	
	
	СведенияКонтактнойИнформации = Новый Структура;
	
	Отбор = УправлениеКонтактнойИнформацией.ОтборКонтактнойИнформации();
	Отбор.Дата = ДатаЗначений;
	КонтактнаяИнформацияОбъекта = УправлениеКонтактнойИнформацией.КонтактнаяИнформация(Организация, Отбор); 
		
	Если ТипЗнч(КонтактнаяИнформацияОбъекта) = Тип("ТаблицаЗначений") И КонтактнаяИнформацияОбъекта.Количество() > 0 Тогда 
		
		ДобавитьДанныеАдреса(КонтактнаяИнформацияОбъекта, ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ЮрАдресОрганизации"), 
		"АдресОрганизации", СведенияКонтактнойИнформации);
		
		ДобавитьДанныеАдреса(КонтактнаяИнформацияОбъекта, ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФактАдресОрганизации"), 
		"АдресОрганизацииФакт", СведенияКонтактнойИнформации);

		ДобавитьДанныеАдреса(КонтактнаяИнформацияОбъекта, ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации"), 
		"ПочтовыйАдресОрганизации", СведенияКонтактнойИнформации);

	    СтрокаКИ = КонтактнаяИнформацияОбъекта.Найти(ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонОрганизации"), "Вид");
		Если НЕ СтрокаКИ = Неопределено Тогда
			СведенияКонтактнойИнформации.Вставить("ТелефонОрганизации", УправлениеКонтактнойИнформацией.СведенияОТелефоне(СтрокаКИ.Значение).Представление);
		КонецЕсли;  
		
		СтрокаКИ = КонтактнаяИнформацияОбъекта.Найти(ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФаксОрганизации"), "Вид");
		Если НЕ СтрокаКИ = Неопределено Тогда
			СведенияКонтактнойИнформации.Вставить("ФаксОрганизации", УправлениеКонтактнойИнформацией.СведенияОТелефоне(СтрокаКИ.Значение).Представление);
		КонецЕсли; 
		
		СтрокаКИ = КонтактнаяИнформацияОбъекта.Найти(ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.EmailОрганизации"), "Вид");
		Если НЕ СтрокаКИ = Неопределено Тогда
			СведенияКонтактнойИнформации.Вставить("АдресЭлектроннойПочтыОрганизации", СтрокаКИ.Представление);
		КонецЕсли; 

	КонецЕсли;  
	
	Если ЗначениеЗаполнено(Поля) Тогда
		Результат = Новый Структура(Поля); 
		Для Каждого КлючЗначение Из  Результат Цикл
			Если НЕ СведенияКонтактнойИнформации.Свойство(КлючЗначение.Ключ) Тогда
				Результат.Удалить(КлючЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;	
		ЗаполнитьЗначенияСвойств(Результат, СведенияКонтактнойИнформации); 
	Иначе  
		Результат = СведенияКонтактнойИнформации;
	КонецЕсли;   
	
	Для Каждого КлючЗначение Из Результат Цикл
		КонтактнаяИнформация.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);	
	КонецЦикла;

КонецПроцедуры

// Переопределяет структуру, содержащую сведения о банковской информации организации.
// 
// Параметры:
//  Организация - ОпределяемыйТип.Организация - организация, сведения по которой необходимо получить.
//  Поля - Строка - имена полей, перечисленные через запятую, в формате требований к свойствам структуры.
//                  Список допустимых имен полей см. в описании возвращаемого значения.
//                  Если указана пустая строка, то возвращаются значения всех полей.
//  Дата - Дата, Неопределено - дата, на которую требуется получить данные. Если значение не указано,
//                  то возвращается значение на текущую дату.
//  БанковскийСчет - Структура -
//                  см. ОрганизацииСервер.БанковскийСчетОрганизации.
Процедура ПриОпределенииБанковскогоСчетаОрганизации(Организация, Поля, Дата, БанковскийСчет) Экспорт
	
КонецПроцедуры

#КонецОбласти

#Область СведенияОбОбособленномПодразделении

// Переопределяет структуру, содержащую сведения о регистрационных данных обособленного подразделения.
// 
// Параметры:
//  Организация - ОпределяемыйТип.Организация - организация, сведения по которой необходимо получить.
//  Поля - Строка - имена полей, перечисленные через запятую, в формате требований к свойствам структуры.
//                  Список допустимых имен полей см. в описании возвращаемого значения.
//                  Если указана пустая строка, то возвращаются значения всех полей.
//  Дата - Дата, Неопределено - дата, на которую требуется получить данные. Если значение не указано,
//                  то возвращается значение на текущую дату.
//  РегистрационныеДанные - Структура -
//                  см. ОрганизацииСервер.РегистрационныеДанныеОбособленногоПодразделения.
Процедура ПриОпределенииРегистрационныхДанныхОбособленногоПодразделения(Организация, Поля, Дата, РегистрационныеДанные) Экспорт	
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат; // Реквизиты организации нельзя заполнить, если организация не выбрана.
	КонецЕсли;
	
	Если ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации") Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Дата) Тогда
		ДатаЗначений = Дата;
	Иначе
		ДатаЗначений = ТекущаяДатаСеанса();
	КонецЕсли; 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Организации.КПП КАК КППОбособленногоПодразделения,
	|	Организации.НаименованиеПолное КАК НаименованиеОбособленногоПодразделенияПолное,
	|	ЕстьNULL(Организации.ГоловнаяОрганизация.КПП, """") КАК ГоловнаяОрганизацияКПП,
	|	ЕстьNULL(Организации.ГоловнаяОрганизация.НаименованиеПолное, """") КАК ГоловнаяОрганизацияНаименование,
	|	ЕстьNULL(Организации.ГоловнаяОрганизация.РегистрационныйНомерСФР, """") КАК ГоловнаяОрганизацияРегистрационныйНомерСФР
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Организация
	|	И НЕ Организации.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)"); 
	
	Запрос.УстановитьПараметр("Организация", Организация); 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();  
	
	ДоступныеДанные = Новый Структура;
	Для Каждого Колонка ИЗ РезультатЗапроса.Колонки Цикл
		ДоступныеДанные.Вставить(Колонка.Имя);
	КонецЦикла;

	Если ЗначениеЗаполнено(Поля) Тогда
		Результат = Новый Структура(Поля);  
		Для Каждого КлючЗначение Из  Результат Цикл
			Если НЕ ДоступныеДанные.Свойство(КлючЗначение.Ключ) Тогда
				Результат.Удалить(КлючЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;	
	Иначе  
		Результат = ДоступныеДанные;
	КонецЕсли;
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;	
	
	Для Каждого КлючЗначение Из Результат Цикл
		РегистрационныеДанные.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);	
	КонецЦикла;	
	
КонецПроцедуры

// Переопределяет структуру, содержащую сведения о контактной информации обособленного подразделения.
// 
// Параметры:
//  Организация - ОпределяемыйТип.Организация - организация, сведения по которой необходимо получить.
//  Поля - Строка - имена полей, перечисленные через запятую, в формате требований к свойствам структуры.
//                  Список допустимых имен полей см. в описании возвращаемого значения.
//                  Если указана пустая строка, то возвращаются значения всех полей.
//  Дата - Дата, Неопределено - дата, на которую требуется получить данные. Если значение не указано,
//                  то возвращается значение на текущую дату.
//  КонтактнаяИнформация - Структура -
// Возвращаемое значение:
//   Структура - содержит имена (ключи) и значения затребованных полей:
//            * АдресОбособленногоПодразделения - Строка - адрес обособленного подразделения.
//            * АдресОбособленногоПодразделенияXML - Строка - адрес обособленного подразделения в xml.
//            * АдресОбособленногоПодразделенияJSON - Строка - адрес обособленного подразделения в json.
//            * АдресОбособленногоПодразделенияГород - Строка - город.
//            * АдресОбособленногоПодразделенияДом - Строка - дом.
//            * АдресОбособленногоПодразделенияИндекс - Строка - индекс.
//            * АдресОбособленногоПодразделенияКвартира - Строка - квартира.
//            * АдресОбособленногоПодразделенияКодРегиона - Строка - регион.
//            * АдресОбособленногоПодразделенияКорпус - Строка - корпус.
//            * АдресОбособленногоПодразделенияНаселенныйПункт - Строка - населенный пункт.
//            * АдресОбособленногоПодразделенияРайон - Строка - район.
//            * АдресОбособленногоПодразделенияРегион - Строка - регион.
//            * АдресОбособленногоПодразделенияУлица - Строка - улица.
//
Процедура ПриОпределенииКонтактнойИнформацииОбособленногоПодразделения(Организация, Поля, Дата, КонтактнаяИнформация) Экспорт

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат; // Реквизиты организации нельзя заполнить, если организация не выбрана.
	КонецЕсли;
	
	Если ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации") Тогда
		Возврат;
	КонецЕсли;  
	
	ГоловнаяОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ГоловнаяОрганизация");   
	
	Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда
		
		Если ЗначениеЗаполнено(Дата) Тогда
			ДатаЗначений = Дата;
		Иначе
			ДатаЗначений = ТекущаяДатаСеанса();
		КонецЕсли; 	
		
		СведенияКонтактнойИнформации = Новый Структура;
		
