////////////////////////////////////////////////////////////////////////////////
// получение уникального имени файла.

Функция ПолучитьШаблонУникальногоИмениФайла(ПутьФайла, ЭтоКаталог = Ложь) Экспорт
	// Добавляет "%1" к имени файла перед расширением "c:\temp\test.txt" -> "c:\temp\test%1.txt".
	// В случае каталога "%1" добавляется к имени последней папки.
	
	Если Найти(ПутьФайла,"%1") <> 0 Тогда 
		Возврат ПутьФайла; 
	КонецЕсли;
	
	Результат = "";
		
	СтруктураИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПутьФайла, ЭтоКаталог);
	
	Результат = СтруктураИмениФайла.Путь;
	Результат = Результат + СтруктураИмениФайла.ИмяБезРасширения;
	Результат = Результат + "%1";
	Если Не ЭтоКаталог Тогда
		Результат = Результат + СтруктураИмениФайла.Расширение;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ПолучитьУникальноеИмяФайла(ШаблонПутиФайла, Итератор = 0) Экспорт 
	
	//используются асинхронные вызовы применять на клиенте осознано 
	//асинхронный аналог тут: ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиент
	
	Если Найти(ШаблонПутиФайла,"%1") = 0 Тогда 
		Возврат ШаблонПутиФайла; 
	КонецЕсли;	
	
	ПодставляемоеЗначение = "";
	Если Итератор > 0 Тогда 
		ПодставляемоеЗначение = "("+Итератор+")";
	КонецЕсли;
	
	ПроверяемыйПуть = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПутиФайла,ПодставляемоеЗначение);
	
	Файл = Новый Файл(ПроверяемыйПуть);
	Если Файл.Существует() Тогда 
		Возврат ПолучитьУникальноеИмяФайла(ШаблонПутиФайла, Итератор+1);
	Иначе 
		Возврат ПроверяемыйПуть;
	КонецЕсли;	
	
КонецФункции

