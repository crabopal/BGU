Функция ИспользоватьЭПДляСпособаВыгрузки(СпособВыгрузки) Экспорт 
	
	МассивИспользующихСпособов = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСерверПереопределяемый.ПолучитьСписокСпособовВыгрузкиДляРаботыСЭЦП();
	Возврат МассивИспользующихСпособов.Найти(СпособВыгрузки) <> Неопределено;	
	
КонецФункции	

Функция ПолучитьПустуюСтруктуруПараметров(ИмяСтруктуры) Экспорт
	
	СтруктураПараметров = Новый Структура;
	
	Если ИмяСтруктуры = "МассивОписанийСертификатов" Тогда
		
		СтруктураПараметров.Вставить("Сертификат"); // двоичные данные
		СтруктураПараметров.Вставить("Комментарий","");
		СтруктураПараметров.Вставить("Пароль","");
		СтруктураПараметров.Вставить("КомуВыданСертификат","");
		СтруктураПараметров.Вставить("Отпечаток","");
		СтруктураПараметров.Вставить("ДатаПодписи",Дата(1,1,1));
		СтруктураПараметров.Вставить("УстановившийПодпись");
		СтруктураПараметров.Вставить("СертификатСсылка");
		СтруктураПараметров.Вставить("ПутиПодписей", Новый Массив);
		
	ИначеЕсли ИмяСтруктуры = "МассивСформированныхПодписей" Тогда
		
		СтруктураПараметров.Вставить("ОписаниеСертификата");
		СтруктураПараметров.Вставить("НоваяПодписьДвоичныеДанные"); // двоичные данные
		СтруктураПараметров.Вставить("ИмяФайлаПодписи","");
		СтруктураПараметров.Вставить("ПолныйПутьФайлаПодписи","");
		СтруктураПараметров.Вставить("ОтносительныйПутьФайлаПодписи","");
		
	ИначеЕсли ИмяСтруктуры = "ФайлыДляСозданияПодписей" Тогда
		
		СтруктураПараметров.Вставить("Группа","");
		СтруктураПараметров.Вставить("Путь","");
		СтруктураПараметров.Вставить("Имя","");
		СтруктураПараметров.Вставить("ИмяБезРасширения","");
		СтруктураПараметров.Вставить("ПолноеИмя","");
		СтруктураПараметров.Вставить("ДанныеФайла"); // двоичные данные
		СтруктураПараметров.Вставить("МассивСформированныхПодписей", Новый Массив);
		
	ИначеЕсли ИмяСтруктуры = "ПутиПодписей" Тогда	
		
		СтруктураПараметров.Вставить("Группа");
		СтруктураПараметров.Вставить("ОтносительныйПутьФайлаПодписи");

	КонецЕсли;
	
	Возврат СтруктураПараметров;
КонецФункции