
#Область ПрограммныйИнтерфейс

// Обработчик подписки ПриКопированииДокумента
//
Процедура ПриКопированииДокумента(ОбъектПриемник, ОбъектИсточник) Экспорт 
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектПриемник, "ИДИсточника") Тогда
		ОбъектПриемник.ИДИсточника = ""; 
	КонецЕсли;	
КонецПРоцедуры	

// Обработчик подписки ОбновитьПериодыДействияКПС
//
Процедура ОбновитьПериодыДействияКПС(Источник, Отказ) Экспорт
	
	Если Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеИменСправочниковРеквизитамКБК = БухгалтерскийУчетПовтИсп.ПолучитьСоответствиеИменСправочниковРеквизитамКПС();
	
	ИмяРеквизитаКБК = СоответствиеИменСправочниковРеквизитамКБК[Источник.Метаданные().Имя];
	
	Если ИмяРеквизитаКБК = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	КБК.Ссылка,
		|   КБК.ВидПоказателя
		|ИЗ
		|	Справочник.КлассификационныеПризнакиСчетов КАК КБК
		|ГДЕ
		|	КБК.ППП = &Ссылка";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КБК.ППП", "КБК" + "." + ИмяРеквизитаКБК);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл;
		
		КБКОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДатаНачала = Неопределено;
		ДатаОкончания = Неопределено;
		
		Попытка
			
			КБКОбъект.Заблокировать();
			
			КБКОбъект.Записать();
			
			КБКОбъект.Разблокировать();
			
		Исключение
			//Отказ = Истина;
			//ВызватьИсключение;
		КонецПопытки;
					
	КонецЦикла;
	
КонецПроцедуры

// Обработчик подписки ПроверитьДопустимостьДатыПередЗаписьюДокумента
//
Процедура ПроверитьДопустимостьДатыПередЗаписьюДокументаПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;
	КонецЕсли;
	
	// проверку выполняем только для документов-регистраторов регистра бухгалтерии или регистров накопления
	ДвиженияДокумента = Источник.Метаданные().Движения;
	ЭтоРегистраторРБ = ДвиженияДокумента.Содержит(Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ);
	Если НЕ ЭтоРегистраторРБ Тогда
		ЭтоРегистраторРН = Ложь;
		Для каждого РегистрНакопления Из Метаданные.РегистрыНакопления Цикл
		
			Если ДвиженияДокумента.Содержит(РегистрНакопления) Тогда
				ЭтоРегистраторРН = Истина;
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ЭтоРегистраторРБ И НЕ ЭтоРегистраторРН Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ГодНачала = БухгалтерскийУчетПовтИсп.ПолучитьГодНачалаВеденияУчетаВИнформационнойБазе();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Год(Источник.Дата) < ГодНачала Тогда
		
		ИсточникГодСтрокой = Формат(Год(Источник.Дата), "ЧЦ=4; ЧВН=; ЧГ=0");
		
		Если Лев(ИсточникГодСтрокой, 2) = "02" И НЕ ОбщегоНазначения.СсылкаСуществует(Источник.Ссылка) Тогда
			//считаем, что пользователь просто ошибся,
			//например, ввел 01.01.214, просто исправим
			//(только для нового документа!)
			
			ГодИсправленный = Число("20" + Прав(ИсточникГодСтрокой, 2));
			
			Мес 	= Месяц(Источник.Дата);
			Дн 		= День(Источник.Дата);
			Ч 		= Час(Источник.Дата);
			М 		= Минута(Источник.Дата);
			С 		= Секунда(Источник.Дата);
			
			Источник.Дата = Дата(ГодИсправленный, Мес, Дн, Ч, М, С);
			
		Иначе
			
			ОбщегоНазначения.СообщитьПользователю(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Год даты документа ""%1"" находится вне допустимого интервала дат'"),
			ИсточникГодСтрокой),
			Источник,
			"Дата",,
			Отказ);
			
		КонецЕсли
		
	КонецЕсли
	
КонецПроцедуры

// Обработчик подписки ПроверитьДокументНаСоответствиеВедомостиПеречислений
//
Процедура ПроверитьДокументНаСоответствиеВедомостиПеречисленийПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("НеПроверятьСоответствиеВедомости")
		И Источник.ДополнительныеСвойства.НеПроверятьСоответствиеВедомости Тогда
		Возврат;
	КонецЕсли;
	
	ПроверкаНеПройдена = Ложь;
	
	Если ЗначениеЗаполнено(Источник.ДокументОснование)
		И (ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.ВедомостьНаВыплатуВБанк")
		Или ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате")) Тогда
		
		ПлатежноРасчетныеДокументы.ПроверитьПлатежныйДокументНаСоответствиеВедомости(Источник.ДокументОснование,
			Источник, ПроверкаНеПройдена);
		
	КонецЕсли;

	Если ПроверкаНеПройдена Тогда
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если Источник.ДополнительныеСвойства.Свойство("УстановленныйСтатусЗаписать")
			И Источник.ДополнительныеСвойства.УстановленныйСтатусЗаписать Тогда
			Статус = Источник.ДополнительныеСвойства.УстановленСтатус;
		ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.КассовоеВыбытие") Тогда
			Статус = ?(РежимЗаписи = РежимЗаписиДокумента.Проведение, Перечисления.СтатусыИсполненияДокумента.Исполнен,
				Перечисления.СтатусыИсполненияДокумента.ВРаботе);
		Иначе
			Статус = БухгалтерскиеОперации.СтатусДокумента(Источник.Ссылка);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Статус) И Статус <> Перечисления.СтатусыИсполненияДокумента.ВРаботе Тогда
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти                                                  