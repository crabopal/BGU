#Область ПрограммныйИнтерфейс

// Выполняет подключаемую переопределяемую команду.
//
// Параметры:
//  Форма    	 - ФормаКлиентскогоПриложения 
//  ЭтотОбъект 	 - Объект 
//  Команда  	 - КомандаФормы
//  ОбъектСсылка - Ссылка
// 	ОбъектФормы  - ДанныеФормыСтруктура, ДанныеФормыКоллекция 
//
Процедура Подключаемый_ВыполнитьКоманду(Форма, ЭтотОбъект, Команда, ОбъектСсылка, ОбъектФормы) Экспорт
	 
	АдресНастроек = ЭтотОбъект.ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд;
	МодульПодключаемыеКомандыКлиентПовтИсп = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиентПовтИсп");
	ОписаниеКоманды = МодульПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(Команда.Имя, АдресНастроек);
	
	МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
	МодульПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, ОбъектФормы);
	
КонецПроцедуры       

// См. процедуру ОбщегоНазначенияКлиентПереопределяемый.ПриНачалеРаботыСистемы.
//
Процедура ПриНачалеРаботыСистемы(Параметры) Экспорт	
	#Если ВебКлиент Тогда
		Возврат;
	#Иначе
		НачальнаяСтраницаИзменена = Ложь;
		ОбщегоНазначенияМСДВызовСервера.ДоступФормыОбменаНаКлиенте(ИмяКомпьютера(), НачальнаяСтраницаИзменена);	
		Если НачальнаяСтраницаИзменена Тогда
			ОбновитьИнтерфейс();	
		КонецЕсли;
	#КонецЕсли
КонецПроцедуры

#КонецОбласти

