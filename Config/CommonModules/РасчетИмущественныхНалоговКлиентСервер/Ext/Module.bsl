#Область ПрограммныйИнтерфейс 

#Область ТранспортныйНалог

// Вычисляет сумму транспортного налога на основе параметров расчета
//
// Параметры:
//   ПараметрыРасчета - см. ПараметрыРасчетаСуммаТранспортногоНалога()
//
// Возвращаемое значение:
//   Число
//
Функция СуммаТранспортногоНалога(ПараметрыРасчета) Экспорт

	СуммаТранспортногоНалога = ПараметрыРасчета.НалоговаяБаза
		* ПараметрыРасчета.НалоговаяСтавка
		* ?(ПараметрыРасчета.ПовышающийКоэффициент = 0, 1, ПараметрыРасчета.ПовышающийКоэффициент)
		* ПараметрыРасчета.МесяцевВладения / 12;

	СуммаТранспортногоНалога = СуммаТранспортногоНалога	* (1 - ПараметрыРасчета.ПроцентУменьшения/100);
	СуммаТранспортногоНалога = СуммаТранспортногоНалога	- ПараметрыРасчета.СуммаУменьшения;
		
	СуммаТранспортногоНалога = Макс(Окр(СуммаТранспортногоНалога), 0);

	Возврат СуммаТранспортногоНалога;
	
КонецФункции

// Создает структуру параметров для расчета суммы транспортного налога.
//
// Возвращаемое значение:
//   Структура:
//     * НалоговаяБаза - Число - налоговая база для расчета
//     * НалоговаяСтавка - Число - налоговая ставка
//     * ПовышающийКоэффициент - Число - повышающий коэффициент
//     * МесяцевВладения - Число - количество месяцев владения
//     * ПроцентУменьшения - Число - процент уменьшения суммы налога
//     * СуммаУменьшения - Число - фиксированная сумма уменьшения налога
//
Функция ПараметрыРасчетаСуммаТранспортногоНалога() Экспорт
	
	ПараметрыРасчетаСуммаТранспортногоНалога = Новый Структура;
	ПараметрыРасчетаСуммаТранспортногоНалога.Вставить("НалоговаяБаза", 0);
	ПараметрыРасчетаСуммаТранспортногоНалога.Вставить("НалоговаяСтавка", 0);
	ПараметрыРасчетаСуммаТранспортногоНалога.Вставить("ПовышающийКоэффициент", 0);
	ПараметрыРасчетаСуммаТранспортногоНалога.Вставить("МесяцевВладения", 0);
	ПараметрыРасчетаСуммаТранспортногоНалога.Вставить("ПроцентУменьшения", 0);
	ПараметрыРасчетаСуммаТранспортногоНалога.Вставить("СуммаУменьшения", 0);
	
	Возврат ПараметрыРасчетаСуммаТранспортногоНалога;
	
КонецФункции

#КонецОбласти

#Область ЗемельныйНалог

// Вычисляет сумму земельного налога с учетом доли собственности, льгот и периода владения.
//
// Параметры:
//   ПараметрыРасчета - Структура - см. ПараметрыРасчетаСуммаЗемельногоНалога()
//
// Возвращаемое значение:
//   Число
//
Функция СуммаЗемельногоНалога(ПараметрыРасчета) Экспорт

	НалоговаяБаза = ПараметрыРасчета.НалоговаяБаза;

	Если ЗначениеЗаполнено(ПараметрыРасчета.ДоляВПравеОбщейСобственностиЗнаменатель) Тогда
		НалоговаяБаза = НалоговаяБаза * ПараметрыРасчета.ДоляВПравеОбщейСобственностиЧислитель
			/ ПараметрыРасчета.ДоляВПравеОбщейСобственностиЗнаменатель;
	КонецЕсли;
	
	НалоговаяБаза = НалоговаяБаза - ПараметрыРасчета.НеОблагаемаяНалогомСумма;
	
	Если ЗначениеЗаполнено(ПараметрыРасчета.ДоляНеОблагаемойНалогомПлощадиЗнаменатель) Тогда
		НалоговаяБаза = НалоговаяБаза 
			* (ПараметрыРасчета.ДоляНеОблагаемойНалогомПлощадиЗнаменатель
			- ПараметрыРасчета.ДоляНеОблагаемойНалогомПлощадиЧислитель)
			/ ПараметрыРасчета.ДоляНеОблагаемойНалогомПлощадиЗнаменатель;
	КонецЕсли;
	
	СуммаЗемельногоНалога = НалоговаяБаза * ПараметрыРасчета.НалоговаяСтавка / 100
		* ПараметрыРасчета.МесяцевВладения / 12;
	СуммаЗемельногоНалога = Окр(СуммаЗемельногоНалога * (1 - ПараметрыРасчета.ПроцентУменьшения / 100)
		- ПараметрыРасчета.СуммаУменьшения);
	СуммаЗемельногоНалога = Макс(СуммаЗемельногоНалога, 0);

	Возврат СуммаЗемельногоНалога;
	
КонецФункции

// Создает структуру параметров для расчета суммы земельного налога.
//
// Возвращаемое значение:
//   Структура:
//     * НалоговаяБаза - Число - налоговая база для расчета
//     * НалоговаяСтавка - Число - налоговая ставка
//     * МесяцевВладения - Число - количество месяцев владения
//     * ДоляВПравеОбщейСобственностиЧислитель - Число - числитель доли в праве общей собственности
//     * ДоляВПравеОбщейСобственностиЗнаменатель - Число - знаменатель доли в праве общей собственности
//     * НеОблагаемаяНалогомСумма - Число - сумма, не облагаемая налогом
//     * ДоляНеОблагаемойНалогомПлощадиЧислитель - Число - числитель доли не облагаемой налогом площади
//     * ДоляНеОблагаемойНалогомПлощадиЗнаменатель - Число - знаменатель доли не облагаемой налогом площади
//     * ПроцентУменьшения - Число - процент уменьшения налога
//     * СуммаУменьшения - Число - сумма уменьшения налога
//
Функция ПараметрыРасчетаСуммаЗемельногоНалога() Экспорт
	
	ПараметрыРасчетаСуммаЗемельногоНалога = Новый Структура;
	ПараметрыРасчетаСуммаЗемельногоНалога.Вставить("НалоговаяБаза", 0);
	ПараметрыРасчетаСуммаЗемельногоНалога.Вставить("НалоговаяСтавка", 0);
	ПараметрыРасчетаСуммаЗемельногоНалога.Вставить("МесяцевВладения", 0);
	ПараметрыРасчетаСуммаЗемельногоНалога.Вставить("ДоляВПравеОбщейСобственностиЧислитель", 0);
	ПараметрыРасчетаСуммаЗемельногоНалога.Вставить("ДоляВПравеОбщейСобственностиЗнаменатель", 0);
	ПараметрыРасчетаСуммаЗемельногоНалога.Вставить("НеОблагаемаяНалогомСумма", 0);
	ПараметрыРасчетаСуммаЗемельногоНалога.Вставить("ДоляНеОблагаемойНалогомПлощадиЧислитель", 0);
	ПараметрыРасчетаСуммаЗемельногоНалога.Вставить("ДоляНеОблагаемойНалогомПлощадиЗнаменатель", 0);
	ПараметрыРасчетаСуммаЗемельногоНалога.Вставить("ПроцентУменьшения", 0);
	ПараметрыРасчетаСуммаЗемельногоНалога.Вставить("СуммаУменьшения", 0);
	
	Возврат ПараметрыРасчетаСуммаЗемельногоНалога;
	
КонецФункции

#КонецОбласти

#Область НалогНаИмущество

// Вычисляет сумму налога на имущество на основе кадастровой стоимости с учетом долей и периода владения.
//
// Параметры:
//   ПараметрыРасчета - Структура - см. ПараметрыРасчетаСуммаНалогаНаИмуществоПоКадастровойСтоимости()
//
// Возвращаемое значение:
//   Число - сумма налога на имущество
//
Функция СуммаНалогаНаИмуществоПоКадастровойСтоимости(ПараметрыРасчета) Экспорт

	Если ПараметрыРасчета.ПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения") Тогда
		Возврат 0;
	КонецЕсли;

	Если ПараметрыРасчета.ДоляСтоимостиЧислитель > 0 И ПараметрыРасчета.ДоляСтоимостиЗнаменатель > 0 Тогда
		ДоляСтоимости = ПараметрыРасчета.ДоляСтоимостиЧислитель / ПараметрыРасчета.ДоляСтоимостиЗнаменатель;
	Иначе
		ДоляСтоимости = 1;
	КонецЕсли;

	Если ПараметрыРасчета.ДоляВПравеОбщейСобственностиЧислитель > 0
		И ПараметрыРасчета.ДоляВПравеОбщейСобственностиЗнаменатель > 0 Тогда
		ДоляВПравеОбщейСобственности = ПараметрыРасчета.ДоляВПравеОбщейСобственностиЧислитель
			/ ПараметрыРасчета.ДоляВПравеОбщейСобственностиЗнаменатель;
	Иначе
		ДоляВПравеОбщейСобственности = 1;
	КонецЕсли;

	НалоговаяБаза = Окр(Макс(ПараметрыРасчета.КадастроваяСтоимость
		- ПараметрыРасчета.НеоблагаемаяКадастроваяСтоимость, 0) * ДоляСтоимости * ДоляВПравеОбщейСобственности);

	СуммаНалога = Окр(НалоговаяБаза * ПараметрыРасчета.НалоговаяСтавка / 100 * ПараметрыРасчета.МесяцевВладения / 12);

	Возврат СуммаНалога;

КонецФункции

// Создает структуру параметров для расчета суммы налога на имущество по кадастровой стоимости.
//
// Возвращаемое значение:
//   Структура:
//     * НалоговаяСтавка - Число - налоговая ставка
//     * ДоляСтоимостиЧислитель - Число - числитель доли стоимости
//     * ДоляСтоимостиЗнаменатель - Число - знаменатель доли стоимости
//     * ДоляВПравеОбщейСобственностиЧислитель - Число - числитель доли в праве общей собственности
//     * ДоляВПравеОбщейСобственностиЗнаменатель - Число - знаменатель доли в праве общей собственности
//     * КадастроваяСтоимость - Число - кадастровая стоимость
//     * НеоблагаемаяКадастроваяСтоимость - Число - необлагаемая кадастровая стоимость
//     * ПорядокНалогообложения - ПеречислениеСсылка.ПорядокНалогообложенияИмущества, Неопределено - порядок налогообложения
//     * МесяцевВладения - Число - количество месяцев владения
//
Функция ПараметрыРасчетаСуммаНалогаНаИмуществоПоКадастровойСтоимости() Экспорт

	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("НалоговаяСтавка", 0);
	ПараметрыРасчета.Вставить("ДоляСтоимостиЧислитель", 0);
	ПараметрыРасчета.Вставить("ДоляСтоимостиЗнаменатель", 0);
	ПараметрыРасчета.Вставить("ДоляВПравеОбщейСобственностиЧислитель", 0);
	ПараметрыРасчета.Вставить("ДоляВПравеОбщейСобственностиЗнаменатель", 0);
	ПараметрыРасчета.Вставить("КадастроваяСтоимость", 0);
	ПараметрыРасчета.Вставить("НеоблагаемаяКадастроваяСтоимость", 0);
	ПараметрыРасчета.Вставить("ПорядокНалогообложения", Неопределено);
	ПараметрыРасчета.Вставить("МесяцевВладения", 0);
	
	Возврат ПараметрыРасчета;
	
КонецФункции

#КонецОбласти

#КонецОбласти