
#Область ПрограммныйИнтерфейс

Функция ПредставленияПричинВыводаИзОборотаСервиса(ТоварнаяГруппа = Неопределено, ОСУ = Неопределено) Экспорт
	
	ЭтоТоварнаяГруппаСоСрокомГодности = Ложь;
	ЭтоТоварнаяГруппаКорректировкиОстатковОСУ = Ложь;
	ЭтоТоварнаяГруппаФасовки = Ложь;
	ЭтоОСУ = Ложь;
	ЭтоНеОСУ = Ложь;
	
	Если ТоварнаяГруппа = Неопределено Тогда
		
		ЭтоТоварнаяГруппаСоСрокомГодности = Истина;
		ЭтоТоварнаяГруппаКорректировкиОстатковОСУ = Истина;
		ЭтоТоварнаяГруппаФасовки = Истина;
		ЭтоОСУ = Истина;
		ЭтоНеОСУ = Истина;
		
	Иначе
		
		ЭтоТоварнаяГруппаСоСрокомГодности
			= ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.МолочнаяПродукция")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.УпакованнаяВода")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.СоковаяПродукция")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.БезалкогольноеПиво");
		
		ЭтоТоварнаяГруппаОСУ = ЭтоТоварнаяГруппаОСУ(ТоварнаяГруппа);
		ЭтоТоварнаяГруппаКорректировкиОстатковОСУ = ЭтоТоварнаяГруппаОСУ;
		
		ЭтоТоварнаяГруппаФасовки
			= ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.МолочнаяПродукция");
		
		ЭтоОСУ = ОСУ;
		ЭтоНеОСУ = Не ОСУ;
		
	КонецЕсли;
	
	Представления = Новый Структура;
	
	Представления.Вставить("OWN_USE",        	НСтр("ru = 'Использование для собственных нужд'")); 
	Представления.Вставить("PRODUCTION_USE"	, 	НСтр("ru = 'Использование для производственных целей'"));
	Если ЭтоТоварнаяГруппаСоСрокомГодности Тогда
		Представления.Вставить("EXPIRATION", НСтр("ru = 'Истечение срока годности'"));
	КонецЕсли;
	Если ЭтоТоварнаяГруппаКорректировкиОстатковОСУ И ЭтоОСУ Тогда
		Представления.Вставить("BALANCE_CORRECTION", НСтр("ru = 'Корректировка остатков (ОСУ)'"));
	КонецЕсли;
	Представления.Вставить("DESTRUCTION",    НСтр("ru = 'Уничтожение'"));
	Представления.Вставить("UTILIZATION",    НСтр("ru = 'Утилизация'"));
	Представления.Вставить("LOSS",           НСтр("ru = 'Утрата'"));
	Если ЭтоТоварнаяГруппаФасовки И ЭтоНеОСУ Тогда
		Представления.Вставить("PACKING", НСтр("ru = 'Фасовка'"));
	КонецЕсли; 
	Представления.Вставить("VETERINARY_USE"	,	НСтр("ru = 'Ветеринарное применение'"));
	Представления.Вставить("DONATION"		,	НСтр("ru = 'Безвозмездная передача'"));
	Представления.Вставить("CONFISCATION"	,	НСтр("ru = 'Конфискация'"));
	Представления.Вставить("DISTANCE"		,	НСтр("ru = 'Дистанционная продажа'"));
	
	ПредставленияПричинВыводаИзОборота = Новый ФиксированнаяСтруктура(Представления);
	
	Возврат ПредставленияПричинВыводаИзОборота;
	
КонецФункции

Функция ЭтоТоварнаяГруппаОСУ(ТоварнаяГруппа) Экспорт
	
	ЭтоГруппаОСУ = Ложь;
	
	Если ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.МолочнаяПродукция")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.УпакованнаяВода")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.Антисептики")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.БАДы")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.СоковаяПродукция")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.Морепродукты")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.БезалкогольныеНапитки")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.КормаДляЖивотных")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.ВетеринарныеПрепараты")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.РастительныеМасла") Тогда
		
		ЭтоГруппаОСУ = Истина;
		
	КонецЕсли;
	
	Возврат ЭтоГруппаОСУ;
	
КонецФункции

