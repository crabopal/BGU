Функция ПредставленияСостоянийДокументаСервиса() Экспорт
	
	Представления = Новый Структура;
	
	Представления.Вставить("IN_PROGRESS",
		ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.Обрабатывается"));
	Представления.Вставить("CHECKED_OK",
		ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.ОбработанУспешно"));
	Представления.Вставить("CHECKED_NOT_OK",
		ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.ОбработанСОшибками"));
	Представления.Вставить("PARSE_ERROR",
		ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.ОбработанСОшибками"));
	
	Представления.Вставить("PROCESSING_ERROR",
		ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.Неизвестно"));
	Представления.Вставить("ACCEPTED",
		ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.Неизвестно"));
	Представления.Вставить("CANCELLED",
		ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.Неизвестно"));
	Представления.Вставить("WAIT_ACCEPTANCE",
		ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.Неизвестно"));
	Представления.Вставить("WAIT_PARTICIPANT_REGISTRATION",
		ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.Неизвестно"));
	Представления.Вставить("WAIT_FOR_CONTINUATION",
		ПредопределенноеЗначение("Перечисление.СтатусыДокументовИСМПБГУ.Неизвестно"));
	
	ПредставленияСостояний = Новый ФиксированнаяСтруктура(Представления);
	
	Возврат ПредставленияСостояний;
	
КонецФункции

Функция ЭтоТоварнаяГруппаСоСтрогимКонтролемМестаДеятельности(ТоварнаяГруппа) Экспорт
	
	ЭтоТоварнаяГруппаСтрогоКонтроляМОД = Ложь;
	
	Если ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.ВетеринарныеПрепараты")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.Духи")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.Обувь")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.СтроительныеМатериалы")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.УпакованнаяВода")
			Или ТоварнаяГруппа = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.Шины") Тогда
		
		ЭтоТоварнаяГруппаСтрогоКонтроляМОД = Истина;
		
	КонецЕсли;
	
	Возврат ЭтоТоварнаяГруппаСтрогоКонтроляМОД;
	
КонецФункции

