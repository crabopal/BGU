		ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.УпакованнаяВода"));
	Представления.Вставить("ANTISEPTIC",
		ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.Антисептики"));
	Представления.Вставить("BIO",
		ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.БАДы"));
