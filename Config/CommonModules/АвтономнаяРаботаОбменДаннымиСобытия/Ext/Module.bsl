// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ

Функция РегистрироватьИзменение(Источник,Удаление = Ложь)

	Если АвтономнаяРаботаСлужебный.ЭтоАвтономноеРабочееМесто() Тогда
		
		МассивТиповИсключений = Новый Массив;
		МассивТиповИсключений.Добавить(Тип("СправочникОбъект.БланкиОтчетов"));
		МассивТиповИсключений.Добавить(Тип("СправочникОбъект.ВидыОтчетов"));
		МассивТиповИсключений.Добавить(Тип("СправочникОбъект.ПравилаОбработки"));
		МассивТиповИсключений.Добавить(Тип("СправочникОбъект.ПроизвольныеБланкиФорм"));
		МассивТиповИсключений.Добавить(Тип("СправочникОбъект.КонтрольныеСоотношения"));
		МассивТиповИсключений.Добавить(Тип("СправочникОбъект.ПравилаЗаполнения"));
		МассивТиповИсключений.Добавить(Тип("СправочникОбъект.ОбластиЗаполнения"));
		Если Удаление Тогда
			МассивТиповИсключений.Добавить(Тип("СправочникОбъект.ТиповыеОперации"));
		КонецЕсли;
		МассивТиповИсключений.Добавить(Тип("СправочникОбъект.ПроводкиТиповыхОпераций"));
		МассивТиповИсключений.Добавить(Тип("РегистрСведенийНаборЗаписей.ОсновныеПравилаЗаполнения"));

		Возврат МассивТиповИсключений.Найти(ТипЗнч(Источник)) = Неопределено;
		
	Иначе
		
		Возврат Истина;
		
	КонецЕсли;

КонецФункции // РегистрироватьИзменение()

Функция ЕстьСсылкаВБазе(Ссылка,Имя)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Спр.Ссылка
		|ИЗ
		|	Справочник."+Имя+" КАК Спр
		|ГДЕ
		|	Спр.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Результат = Запрос.Выполнить();
    Возврат НЕ Результат.Пустой();
	
КонецФункции
