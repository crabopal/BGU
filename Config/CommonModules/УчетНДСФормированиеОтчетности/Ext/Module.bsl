Функция ВсяОрганизация(Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Организация
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ГоловнаяОрганизация = &Организация
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	&Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация";

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Организация");

КонецФункции

Процедура УпорядочитьСтрокиОперацийПоДате(Реестр)
	
	Реестр.Колонки.Добавить("МинимальнаяДатаДокумента", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	Реестр.Колонки.Добавить("МаксимальнаяДатаДокумента", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	
	Для Каждого СтрокаРеестраКодВидОперации Из Реестр.Строки Цикл
		Для Каждого СтрокаТиповойДоговор Из СтрокаРеестраКодВидОперации.Строки Цикл
			Для Каждого СтрокаОперация Из СтрокаТиповойДоговор.Строки Цикл
				МинимальнаяДатаДокумента = '39991231';
				МаксимальнаяДатаДокумента = '00010101';
				
				Для Каждого СтрокаДокумент Из СтрокаОперация.Строки Цикл
					Если ЗначениеЗаполнено(СтрокаДокумент.ДатаДок) Тогда
						МинимальнаяДатаДокумента = Мин(МинимальнаяДатаДокумента, СтрокаДокумент.ДатаДок);
						МаксимальнаяДатаДокумента = Макс(МаксимальнаяДатаДокумента, СтрокаДокумент.ДатаДок);
					КонецЕсли;
				КонецЦикла;
				
				СтрокаОперация.МинимальнаяДатаДокумента = МинимальнаяДатаДокумента;
				СтрокаОперация.МаксимальнаяДатаДокумента = МаксимальнаяДатаДокумента;
			КонецЦикла;
			
			СтрокаТиповойДоговор.Строки.Сортировать("МинимальнаяДатаДокумента, МаксимальнаяДатаДокумента");
		КонецЦикла;
	КонецЦикла;
	
	Реестр.Колонки.Удалить("МинимальнаяДатаДокумента");
	Реестр.Колонки.Удалить("МаксимальнаяДатаДокумента");
	
КонецПроцедуры

