Процедура ЗаполнитьКонтейнерРаздела7(Контейнер, ДеревоДанных, ТаблицаРасшифровки, ПараметрыОтчета)
	
	Если ДеревоДанных.Строки.Количество() = 0 Тогда
		ИнициализироватьРаздел7(Контейнер, ПараметрыОтчета);
		
		Возврат;
	КонецЕсли;
	
	ОчиститьРаздел7(Контейнер, ПараметрыОтчета);
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаКодОперации Из ДеревоДанных.Строки Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ЗаполнитьСтрокуРаздел7(Контейнер, НомерСтроки, СтрокаКодОперации, ТаблицаРасшифровки, ПараметрыОтчета);
	КонецЦикла;
	
КонецПроцедуры

Процедура ИнициализироватьРаздел7(Контейнер, ПараметрыОтчета)
	
	КодОперацииПоУмолчанию = "       ";
	
	Контейнер.Раздел7.Вставить("П000700000101_1", КодОперацииПоУмолчанию); // КодОперации
	Контейнер.Раздел7.Вставить("П000700000102_1", 0); // СтоимостьРеализации
	Контейнер.Раздел7.Вставить("П000700000103_1", 0); // СтоимостьПриобретения
	Контейнер.Раздел7.Вставить("П000700000104_1", 0); // НДС
	
	Контейнер.Раздел7.Вставить("П000700001001", 0); // СуммаАванса
	
	Контейнер.Раздел7_ДанныеДопСтрок.Очистить();
	
	НоваяСтрока = Контейнер.Раздел7_ДанныеДопСтрок.Добавить();
	НоваяСтрока.П000700000101 = КодОперацииПоУмолчанию;
	
КонецПроцедуры

Процедура ОчиститьРаздел7(Контейнер, ПараметрыОтчета)
	
	УдаляемыеЭлементы = Новый Массив();
	
	Для Каждого Элемент Из Контейнер.Раздел7 Цикл
		Если Элемент.Ключ = "П000700001001" Тогда // СуммаАванса
			Продолжить;
		КонецЕсли;
		
		УдаляемыеЭлементы.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	Для Каждого ИмяЭлемента Из УдаляемыеЭлементы Цикл
		Контейнер.Раздел7.Удалить(ИмяЭлемента);
	КонецЦикла;
	
	Контейнер.Раздел7_ДанныеДопСтрок.Очистить();
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуРаздел7(Контейнер, НомерСтроки, ДанныеЗаполнения, ТаблицаРасшифровки, ПараметрыОтчета)
	
	ИмяПоляКодОперации           = "П000700000101";
	ИмяПоляСтоимостьРеализации   = "П000700000102";
	ИмяПоляСтоимостьПриобретения = "П000700000103";
	ИмяПоляНДС                   = "П000700000104";
	
	КодОперацииСтрокой		= ДанныеЗаполнения["Р7_" + ИмяПоляКодОперации + "_Код"];
	СтоимостьРеализации		= ДанныеЗаполнения["Р7_" + ИмяПоляСтоимостьРеализации];
	СтоимостьПриобретения	= ДанныеЗаполнения["Р7_" + ИмяПоляСтоимостьПриобретения];
	НДС						= ДанныеЗаполнения["Р7_" + ИмяПоляНДС];
	
	СтрокаРаздел7 = Контейнер.Раздел7_ДанныеДопСтрок.Добавить();
	СтрокаРаздел7[ИмяПоляКодОперации]			= КодОперацииСтрокой;
	СтрокаРаздел7[ИмяПоляСтоимостьРеализации]	= СтоимостьРеализации;
	СтрокаРаздел7[ИмяПоляСтоимостьПриобретения]	= СтоимостьПриобретения;
	СтрокаРаздел7[ИмяПоляНДС]					= НДС;
	
	ДопОтбор = Новый Структура();
	ДопОтбор.Вставить("Р7_П000700000101_Код", КодОперацииСтрокой);
	
