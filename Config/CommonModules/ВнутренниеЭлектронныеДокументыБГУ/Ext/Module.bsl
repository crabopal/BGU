Функция ВнутреннийЭДМногосоставногоДокументаИнвентаризации(УчетныйДокумент) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Документы.ВнутреннийЭлектронныйДокумент.ПустаяСсылка();
	
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВнутреннийЭлектронныйДокумент.Ссылка КАК Ссылка,
	               |	ВнутреннийЭлектронныйДокумент.ВидДокумента КАК ВидДокумента,
	               |	ВнутреннийЭлектронныйДокумент.ДатаДокумента КАК ДатаДокумента,
	               |	ВнутреннийЭлектронныйДокумент.НомерДокумента КАК НомерДокумента,
	               |	ВнутреннийЭлектронныйДокумент.ИдентификаторКомандыПечати КАК ИдентификаторКомандыПечати
	               |ИЗ
	               |	Документ.ВнутреннийЭлектронныйДокумент КАК ВнутреннийЭлектронныйДокумент
	               |ГДЕ
	               |	ВнутреннийЭлектронныйДокумент.УчетныйДокумент = &УчетныйДокумент";
	Запрос.УстановитьПараметр("УчетныйДокумент", УчетныйДокумент);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ИдентификаторКомандыПечати = НСтр("ru='Форма0510466'")
			ИЛИ Выборка.ИдентификаторКомандыПечати = НСтр("ru='Форма0510468'")
			ИЛИ Выборка.ИдентификаторКомандыПечати = НСтр("ru='Форма0510469'") Тогда
			
			СостояниеЭлектронногоДокумента = ВнутреннийЭДО.СостояниеЭлектронногоДокумента(Выборка.Ссылка);
			
			Если НЕ СостояниеЭлектронногоДокумента.Состояние = Перечисления.СостоянияДокументовВнутреннегоЭДО.Аннулирован
				И НЕ СостояниеЭлектронногоДокумента.Состояние = Перечисления.СостоянияДокументовВнутреннегоЭДО.ЗакрытПринудительно Тогда
				Результат = Выборка.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

