	               |	ВнутреннийЭлектронныйДокумент.ДатаДокумента КАК ДатаДокумента,
	               |	ВнутреннийЭлектронныйДокумент.НомерДокумента КАК НомерДокумента,
	               |	ВнутреннийЭлектронныйДокумент.ИдентификаторКомандыПечати КАК ИдентификаторКомандыПечати
	               |ИЗ
	               |	Документ.ВнутреннийЭлектронныйДокумент КАК ВнутреннийЭлектронныйДокумент
	               |ГДЕ
	               |	ВнутреннийЭлектронныйДокумент.УчетныйДокумент = &УчетныйДокумент";
	Запрос.УстановитьПараметр("УчетныйДокумент", УчетныйДокумент);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ИдентификаторКомандыПечати = НСтр("ru='Расписка'") Тогда
			
			СостояниеЭлектронногоДокумента = ВнутреннийЭДО.СостояниеЭлектронногоДокумента(Выборка.Ссылка);
			
			Если НЕ СостояниеЭлектронногоДокумента.Состояние = Перечисления.СостоянияДокументовВнутреннегоЭДО.Аннулирован
				И НЕ СостояниеЭлектронногоДокумента.Состояние = Перечисления.СостоянияДокументовВнутреннегоЭДО.ЗакрытПринудительно Тогда
				Результат = Выборка.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция НеБлокироватьСозданиеВнутреннихЭДДляНекорректныхДокументовУчета(Организация) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкиЭДОБГУ.НеБлокироватьСозданиеВнутреннихЭДДляНекорректныхДокументовУчета КАК НеБлокировать
	               |ИЗ
	               |	РегистрСведений.НастройкиЭДОБГУ КАК НастройкиЭДОБГУ
	               |ГДЕ
	               |	НастройкиЭДОБГУ.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.НеБлокировать;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ФормулярыВФорматеPDF

Процедура СформироватьФормулярыВФорматеPDF(Параметры, АдресВХранилище) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Организация = Параметры.Организация;

	ОсновнойФайлПустой = Справочники.ВнутреннийЭлектронныйДокументПрисоединенныеФайлы.ПустаяСсылка();

	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ВнутреннийЭлектронныйДокумент.Ссылка КАК Ссылка,
	               |	ВнутреннийЭлектронныйДокументПрисоединенныеФайлы.Ссылка КАК ФайлPDF,
	               |	ВнутреннийЭлектронныйДокумент.ОсновнойФайл КАК ОсновнойФайлZIP,
	               |	ВнутреннийЭлектронныйДокумент.УчетныйДокумент КАК УчетныйДокумент,
	               |	ВнутреннийЭлектронныйДокумент.Организация КАК Организация
	               |ИЗ
	               |	Документ.ВнутреннийЭлектронныйДокумент КАК ВнутреннийЭлектронныйДокумент
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВнутреннийЭлектронныйДокументПрисоединенныеФайлы КАК ВнутреннийЭлектронныйДокументПрисоединенныеФайлы
	               |		ПО ВнутреннийЭлектронныйДокумент.Ссылка = ВнутреннийЭлектронныйДокументПрисоединенныеФайлы.ВладелецФайла
	               |			И ВнутреннийЭлектронныйДокумент.ОсновнойФайл <> ВнутреннийЭлектронныйДокументПрисоединенныеФайлы.Ссылка
	               |ГДЕ
	               |	НЕ ВнутреннийЭлектронныйДокумент.ОсновнойФайл = &ОсновнойФайлПустой
	               |	И ВнутреннийЭлектронныйДокумент.ПредставлениеФормуляраФайлPDF = &ОсновнойФайлПустой
	               |	И ВнутреннийЭлектронныйДокумент.ПометкаУдаления = ЛОЖЬ
	               |	И ВнутреннийЭлектронныйДокумент.УчетныйДокумент.ПометкаУдаления = ЛОЖЬ
	               |	И ВнутреннийЭлектронныйДокумент.НеСоздаватьФормулярPDF = ЛОЖЬ
	               |	И ВнутреннийЭлектронныйДокумент.Организация = &Организация";
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ВнутреннийЭлектронныйДокумент.Организация = &Организация", "");
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ОсновнойФайлПустой", ОсновнойФайлПустой);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.ФайлPDF) Тогда
			//создание нового формуляра
			НеСоздаватьФайлPDF = Ложь;
			ОсновнойФайлPDF = ОсновнойФайлПустой;
			ПредставлениеФормуляраФайлPDF = ОсновнойФайлПустой;
			ВнутреннийЭД = Выборка.Ссылка;
			УчетныйДокумент = Выборка.УчетныйДокумент;
			Организация = Выборка.Организация;
			СозданиеНовогоФормуляраPDF(Организация, ВнутреннийЭД, УчетныйДокумент, Выборка.ОсновнойФайлZIP, ОсновнойФайлPDF, ПредставлениеФормуляраФайлPDF, НеСоздаватьФайлPDF);
			
			Попытка
				ВнутреннийЭДОбъект = ВнутреннийЭД.ПолучитьОбъект();
				Если НеСоздаватьФайлPDF Тогда
					ВнутреннийЭДОбъект.НеСоздаватьФормулярPDF = Истина;
					
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Формуляр внутреннего ЭД %1 в формате PDF для документа учета %2 не создан из-за отсутствия данных в формате MXL.'"), 
						ВнутреннийЭД, УчетныйДокумент);
					ВыполнитьЗаписьСобытияПоВнутреннемуЭДВЖурналРегистрации(ТекстСообщения,
						2, УровеньЖурналаРегистрации.Ошибка, ВнутреннийЭД.Метаданные(), УчетныйДокумент);
				Иначе
					ВнутреннийЭДОбъект.ОсновнойФайлPDF = ОсновнойФайлPDF;
					ВнутреннийЭДОбъект.ПредставлениеФормуляраФайлPDF = ОсновнойФайлPDF;
				КонецЕсли;
				
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ВнутреннийЭДОбъект, Ложь);
			Исключение
				Текст = НСтр("ru = 'Ошибка создания файлов формуляров.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Создание формуляра внутреннего ЭД %1 для документа учета %2.'"), 
					ВнутреннийЭД, УчетныйДокумент)
					+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ВыполнитьЗаписьСобытияПоВнутреннемуЭДВЖурналРегистрации(ТекстСообщения,
					2, УровеньЖурналаРегистрации.Ошибка, ВнутреннийЭД.Метаданные(), УчетныйДокумент);
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;	

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ВыполнитьЗаписьСобытияПоВнутреннемуЭДВЖурналРегистрации(ОписаниеСобытия, КодСобытия, УровеньВажности = Неопределено,
	ОбъектМетаданных = Неопределено, ДанныеСсылка = Неопределено, РежимТранзакции = Неопределено) Экспорт
	
	Если КодСобытия = 1 Тогда
		Подсистема = НСтр("ru = 'Внутренний ЭДО БГУ КОРП'", ОбщегоНазначения.КодОсновногоЯзыка());
	ИначеЕсли КодСобытия = 2 Тогда
		Подсистема = НСтр("ru = 'Внутренний ЭДО БГУ ПРОФ'", ОбщегоНазначения.КодОсновногоЯзыка());
	Иначе	
		Подсистема = НСтр("ru = 'Общая подсистема внутреннего ЭДО БГУ'", ОбщегоНазначения.КодОсновногоЯзыка());
	КонецЕсли;
	
	УровеньВажностиСобытия = ?(ТипЗнч(УровеньВажности) = Тип("УровеньЖурналаРегистрации"),
		УровеньВажности, УровеньЖурналаРегистрации.Ошибка);
		
	ИмяСобытия = СтрЗаменить(НСтр("ru = 'Внутренний ЭДО.%1'", ОбщегоНазначения.КодОсновногоЯзыка()),
		"%1", Подсистема);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньВажностиСобытия, ОбъектМетаданных, ДанныеСсылка, ОписаниеСобытия,
		РежимТранзакции);
	
КонецПроцедуры

Процедура СозданиеНовогоФормуляраPDF(Организация, ВнутреннийЭД, УчетныйДокумент, ОсновнойФайл, ОсновнойФайлPDF, ПредставлениеФормуляраФайлPDF, НеСоздаватьФайлPDF)

	УстановитьПривилегированныйРежим(Истина);

	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ВызыватьИсключение = Ложь;

	ДанныеФайла = РаботаСФайлами.ДанныеФайла(ОсновнойФайл, ПараметрыДанных);
	
	ИмяФайла = ДанныеФайла.ИмяФайла;
	Если ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.РегистрУчета") Тогда
		РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетныйДокумент, "ВидРегистра, НачалоПериода, КонецПериода");
			
		Если ЗначениеЗаполнено(РеквизитыДокументов.НачалоПериода) И ЗначениеЗаполнено(РеквизитыДокументов.КонецПериода) Тогда
			ИмяБезРасширения = СтрШаблон("%1 (%2-%3)    ", РеквизитыДокументов.ВидРегистра, 
				Формат(РеквизитыДокументов.НачалоПериода, "ДФ=dd.MM.yyyy"), Формат(РеквизитыДокументов.КонецПериода, "ДФ=dd.MM.yyyy"));
		ИначеЕсли ЗначениеЗаполнено(РеквизитыДокументов.НачалоПериода) Тогда
			ИмяБезРасширения = СтрШаблон("%1 (%2)    ", РеквизитыДокументов.ВидРегистра, Формат(РеквизитыДокументов.НачалоПериода, "ДФ=dd.MM.yyyy"));
		ИначеЕсли ЗначениеЗаполнено(РеквизитыДокументов.КонецПериода) Тогда
			ИмяБезРасширения = СтрШаблон("%1 (%2)    ", РеквизитыДокументов.ВидРегистра, Формат(РеквизитыДокументов.КонецПериода, "ДФ=dd.MM.yyyy"));
		Иначе
			ИмяБезРасширения = СтрШаблон("%1    ", РеквизитыДокументов.ВидРегистра);
		КонецЕсли;	
			
		ИмяБезРасширения = СтрЗаменить(ИмяБезРасширения, " ", "_");
		ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяБезРасширения, "_");
	КонецЕсли;	
	
	ИмяФайлаБезРасширения = Сред(ИмяФайла, 1, СтрДлина(ИмяФайла) - 4);
	ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
	
	ИмяПодкаталога = ИмяВременногоКаталога;
	
	ИмяФайлаPDFБезРасширения = Сред(ИмяФайла, 1, СтрДлина(ИмяФайла) - 4) + " (формуляр)";
	ПолноеИмяФайлаPDF = ИмяПодкаталога + ИмяФайлаPDFБезРасширения + ".pdf";

	ИмяФайлаPDFПредставленияФормуляраБезРасширения = Сред(ИмяФайла, 1, СтрДлина(ИмяФайла) - 4) + " (копия)";
	ПолноеИмяФайлаПредставленияФормуляраPDF = ИмяПодкаталога + ИмяФайлаPDFПредставленияФормуляраБезРасширения + ".pdf";
	
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
	
	Если ДвоичныеДанныеФайла = Неопределено Тогда
		НеСоздаватьФайлPDF = Истина;
		Возврат;
	КонецЕсли;

	//Формуляр
	СохраненныйТабличныйДокумент = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанныеФайла);
	СохраненныйТабличныйДокумент.АвтоМасштаб = Истина;
	СохраненныйТабличныйДокумент.Записать(ПолноеИмяФайлаPDF, ТипФайлаТабличногоДокумента.PDF_A_3);
	
	ДвоичныеДанныеФайлаPDF = Новый ДвоичныеДанные(ПолноеИмяФайлаPDF);
	
	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
	ПараметрыФайла.ВладелецФайлов = ВнутреннийЭД;
	ПараметрыФайла.ИмяБезРасширения = ИмяФайлаPDFБезРасширения+ ".pdf";
	ПараметрыФайла.Служебный = Ложь;
	
	ИдентификаторФормы = Новый УникальныйИдентификатор;
	АдресФайлаPDF = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаPDF, ИдентификаторФормы);
	
	ОсновнойФайлPDF = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайлаPDF);
	
	//Представление (копия)
	ЭлектронныеПодписи = ЭлектронныеДокументыБГУ.НовыйСписокЭлектронныхПодписейВнутреннегоЭД();
	ЭлектронныеДокументыБГУ.ЗаполнитьСписокПодписей(ЭлектронныеПодписи, ОсновнойФайл, Организация);
	
	СохраненныйТабличныйДокументПредставленияФормуляра = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанныеФайла);

	//Отступ чтобы штампы не накладывались на представление документа
	МакетШтампов = УправлениеПечатью.МакетПечатнойФормы("Документ.ВнутреннийЭлектронныйДокумент.ПФ_MXL_ШтампПЭП");
	ОбластьМакета = МакетШтампов.ПолучитьОбласть("Отступ");
	СохраненныйТабличныйДокументПредставленияФормуляра.Вывести(ОбластьМакета);
	
	ЭлектронныеДокументыБГУ.ДобавитьШтампыЭлектронныхПодписейВнутреннегоЭДО(СохраненныйТабличныйДокументПредставленияФормуляра, ЭлектронныеПодписи, Организация);
	
	СохраненныйТабличныйДокументПредставленияФормуляра.АвтоМасштаб = Истина;
	СохраненныйТабличныйДокументПредставленияФормуляра.Записать(ПолноеИмяФайлаПредставленияФормуляраPDF, ТипФайлаТабличногоДокумента.PDF_A_3);
	
	ДвоичныеДанныеФайлаПредставленияФормуляраPDF = Новый ДвоичныеДанные(ПолноеИмяФайлаПредставленияФормуляраPDF);
	
	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
	ПараметрыФайла.ВладелецФайлов = ВнутреннийЭД;
	ПараметрыФайла.ИмяБезРасширения = ИмяФайлаPDFПредставленияФормуляраБезРасширения+ ".pdf";
	ПараметрыФайла.Служебный = Ложь;
	
	ИдентификаторФормы = Новый УникальныйИдентификатор;
	АдресФайлаПредставленияФормуляраPDF = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаПредставленияФормуляраPDF, ИдентификаторФормы);
	
	ПредставлениеФормуляраФайлPDF = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайлаПредставленияФормуляраPDF);

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область НастройкаОсобенностейВнутреннегоЭДОБГУ

Функция СостояниеВнутреннегоЭДОЗавершено(ДокументРегистратор) Экспорт
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	         |	СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект КАК СсылкаНаОбъект,
	         |	СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО КАК СостояниеЭДО
	         |ИЗ
	         |	РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияПоОбъектамУчетаЭДО
	         |ГДЕ
	         |	СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект = &СсылкаНаОбъект";
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ДокументРегистратор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.СостояниеЭДО = Перечисления.СостоянияДокументовЭДО.ОбменЗавершен Тогда
			Результат = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Процедура НастройкаФормыДокументаВнутреннегоЭДО(ПараметрыНастройки, СозданиеНаСервере = Истина) Экспорт
	
	Форма = ПараметрыНастройки.Форма;
	СсылкаНаДокумент = ПараметрыНастройки.ДокументСсылка;
	
	ИспользоватьВнутренниеДокументыЭДО = ПолучитьФункциональнуюОпцию("ИспользоватьВнутренниеДокументыЭДО");
	Если НЕ ИспользоватьВнутренниеДокументыЭДО Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.СостоянияУчетныхДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	// Если это внутренний документ ЭДО БГУ, то необходимо включить видимость группы с гиперссылкой состояния ЭД,
	// так как видимость может быть выключена по функциональной опции "ИспользоватьОбменЭД"
	ТипыДокументовВнутреннегоЭДО = Новый ОписаниеТипов(ВнутреннийЭДОПовтИсп.ТипыУчетныхДокументовВнутреннегоЭДО());
	Если ТипыДокументовВнутреннегоЭДО.СодержитТип(ТипЗнч(СсылкаНаДокумент)) Тогда
		Если НЕ ПараметрыНастройки.ГруппаСостояниеЭДО.Видимость Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Форма.Элементы, ПараметрыНастройки.ГруппаСостояниеЭДО.Имя, "Видимость", Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Форма.Элементы, ПараметрыНастройки.КонтроллерСостояниеЭДО.Имя, "Видимость", Ложь);
		КонецЕсли;
	КонецЕсли;
	
	// Для не новых документов логика реализована в процедуре ПриЧтенииНаСервере
	Если СозданиеНаСервере И НЕ СсылкаНаДокумент.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыНастройки.КонтроллерСостояниеЭДО.Заголовок) Тогда
		ПараметрыНастройки.КонтроллерСостояниеЭДО.Заголовок = НСтр("ru='ЭДО: '") + ПараметрыНастройки.КонтроллерСостояниеЭДО.Заголовок;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Если это внутренний документ ЭДО БЭД и он еще не начинал обработку, то необходимо скрыть элементы формы БЭД,
	// иначе надо переместить статус БЭД в конец группы, чтобы он отображался после статуса БГУ
	Если ВнутренниеЭлектронныеДокументыБГУ.ЭтоВнутреннийДокументЭДО(ТипЗнч(СсылкаНаДокумент)) Тогда
		Если НЕ ИнтеграцияЭДО.СостояниеОбъектаУчетаУстановлено(СсылкаНаДокумент) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Форма.Элементы, ПараметрыНастройки.КонтроллерСостояниеЭДО.Имя, "Видимость", Ложь);
			Если ПараметрыНастройки.Свойство("МестоРазмещенияКоманд") И ПараметрыНастройки.МестоРазмещенияКоманд <> Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
					Форма.Элементы, ПараметрыНастройки.МестоРазмещенияКоманд.Имя, "Видимость", Ложь);
			КонецЕсли;
			Возврат;
		КонецЕсли;
	Иначе
		Форма.Элементы.Переместить(ПараметрыНастройки.КонтроллерСостояниеЭДО, ПараметрыНастройки.ГруппаСостояниеЭДО);
	КонецЕсли;
	
	ЗапретРедактированияФормы = Ложь;
	ЗапрещеноРедактировать = Ложь;
	
	Если ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаДокумент, "Организация");
		ЗапретРедактированияФормы = ЗапретРедактированияФормДокументовПослеЗавершенияПодписания(Организация);
		
		Если ЗапретРедактированияФормы Тогда
			ЗапрещеноРедактировать = СостояниеВнутреннегоЭДОЗавершено(СсылкаНаДокумент);
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ЗапретРедактированияФормы И ЗапрещеноРедактировать Тогда
		ЕстьПравоДоступа = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.НастройкиВнутреннегоЭДО);
		
		Если ЕстьПравоДоступа Тогда
			Возврат;
		КонецЕсли;	
		
		Форма.ТолькоПросмотр = Истина;
	КонецЕсли;	
	
КонецПроцедуры	

Процедура НастройкаФормыСправочникаВнутреннегоЭДО(ПараметрыНастройки, СозданиеНаСервере = Истина) Экспорт
	
	ИспользоватьВнутренниеДокументыЭДО = ПолучитьФункциональнуюОпцию("ИспользоватьВнутренниеДокументыЭДО");
	Если НЕ ИспользоватьВнутренниеДокументыЭДО Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ПараметрыНастройки.Форма;
	
	Объект = СтрРазделить(Форма.ИмяФормы, ".", Ложь)[1];
	Если Объект <> Метаданные.Справочники.Организации.Имя Тогда
		Возврат;
	КонецЕсли;
	
	// Если это форма организации, то необходимо скрыть команду настроек внутреннего ЭДО БЭД
	СкрытьВидимостьКомандыНастройкиВнутреннегоЭДОБЭД(Форма);
	
КонецПроцедуры

Функция ЗапретРедактированияФормДокументовПослеЗавершенияПодписания(Организация) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкиЭДОБГУ.ВнутреннийЭДОЗапретРедактированияФормДокументовПослеЗавершенияПодписания КАК ЗапретРедактирования
	               |ИЗ
	               |	РегистрСведений.НастройкиЭДОБГУ КАК НастройкиЭДОБГУ
	               |ГДЕ
	               |	НастройкиЭДОБГУ.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ЗапретРедактирования;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Процедура НазначенСтатусПодписан(ЭлектронныйДокумент) Экспорт
	НаправленияДокументов = ОбменСКонтрагентами.НаправленияДокументов();
	
	СведенияЭД = ЭлектронныеДокументыБГУ.СведенияОбЭлектронномДокументе(ЭлектронныйДокумент);
	
	СтатусЭД = Неопределено;
	СтруктураСтатусаЭД = ОбменСКонтрагентами.СтатусДокументооборота(ЭлектронныйДокумент);
	Если ТипЗнч(СтруктураСтатусаЭД) = Тип("Структура") Тогда
		СтатусЭД = СтруктураСтатусаЭД.Статус;
	КонецЕсли;
	
	Если СведенияЭД.ОписаниеВидаДокумента.ТипДокумента = Перечисления.ТипыДокументовЭДО.Внутренний
		И СтатусЭД = "Утвержден" Тогда
		Если СведенияЭД.ОписаниеВидаДокумента.ИдентификаторКомандыПечати = "КО1"
			ИЛИ СведенияЭД.ОписаниеВидаДокумента.ИдентификаторКомандыПечати = "КО2" Тогда
			Если СведенияЭД.ОбъектыУчета.Количество()>0 Тогда
				ДокументУчета = СведенияЭД.ОбъектыУчета[0];
				Если ЗначениеЗаполнено(ДокументУчета) Тогда
					УстановитьПривилегированныйРежим(Истина);
				
					ДокументУчетаОбъект = ДокументУчета.ПолучитьОбъект();
					ДокументИзменен = Ложь;
					ПользовательКассир = ЭлектронныеДокументыБГУ.ПользовательСотрудника(ДокументУчета.Кассир);
					ПользовательГлавБух = ЭлектронныеДокументыБГУ.ПользовательСотрудника(ДокументУчета.ГлБухгалтер);
					Для каждого ТекСтрока Из СведенияЭД.Подписи Цикл
						ПодписантПользователь = ТекСтрока.Подписант;
						Если ПодписантПользователь = ПользовательКассир Тогда
							Если НЕ ДЕНЬ(ДокументУчетаОбъект.ДатаПодписиКассира) = ДЕНЬ(ТекСтрока.Дата) Тогда
								ДокументИзменен = Истина;
								ДокументУчетаОбъект.ДатаПодписиКассира = ТекСтрока.Дата;
							КонецЕсли;
						КонецЕсли;	
						Если ПодписантПользователь = ПользовательГлавБух Тогда
							Если НЕ ДЕНЬ(ДокументУчетаОбъект.ДатаПодписиГлБухгалтера) = ДЕНЬ(ТекСтрока.Дата) Тогда 
								ДокументИзменен = Истина;
								
								ДокументУчетаОбъект.ДатаПодписиГлБухгалтера = ТекСтрока.Дата;
							КонецЕсли;
						КонецЕсли;						
					КонецЦикла;
					Если ДокументИзменен Тогда
						ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументУчетаОбъект, Ложь);
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПослеАннулированияЭДО(ЭлектронныйДокумент) Экспорт
	Если ТипЗнч(ЭлектронныйДокумент) = Тип("ДокументСсылка.ЭлектронныйДокументИсходящийЭДО") Тогда
		Если ЭлектронныйДокумент.ВидДокумента = Справочники.ВидыДокументовЭДО.НайтиПоНаименованию("Расходный кассовый ордер")
			ИЛИ ЭлектронныйДокумент.ВидДокумента = Справочники.ВидыДокументовЭДО.НайтиПоНаименованию("Приходный кассовый ордер") Тогда
			Если ЭлектронныйДокумент.СпособОбменаЭД = Перечисления.СпособыОбменаЭД.Внутренний Тогда
				Если ЭлектронныйДокумент.ВидВнутреннегоДокумента.ИдентификаторКомандыПечати = "КО1"
					ИЛИ ЭлектронныйДокумент.ВидВнутреннегоДокумента.ИдентификаторКомандыПечати = "КО2" Тогда
					СведенияЭД = ЭлектронныеДокументыБГУ.СведенияОбЭлектронномДокументе(ЭлектронныйДокумент);
					Если СведенияЭД.ОбъектыУчета.Количество()>0 Тогда
						ДокументУчета = СведенияЭД.ОбъектыУчета[0];
						Если ЗначениеЗаполнено(ДокументУчета) Тогда
							УстановитьПривилегированныйРежим(Истина);
							
							ДокументУчетаОбъект = ДокументУчета.ПолучитьОбъект();
							ДокументУчетаОбъект.ДатаАннулирования = ЭлектронныйДокумент.ДатаАннулирования;
							ДокументУчетаОбъект.Аннулирован = Истина;
							ДокументУчетаОбъект.Записать();
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция МассивТиповНепроводныхДокументовВнутреннегоЭДО() Экспорт
	Результат = Новый Массив;
	
	Результат.Добавить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход"));
	Результат.Добавить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная"));
	Результат.Добавить(Тип("ДокументСсылка.ЗаявкаНаНаличные"));
	Результат.Добавить(Тип("ДокументСсылка.ЗаявкаНаВозврат"));
	Результат.Добавить(Тип("ДокументСсылка.ПлатежноеПоручение"));
	
	Возврат Результат;
КонецФункции	

Процедура НастройкаФормыСпискаВнутреннегоЭДО(ПараметрыНастройки) Экспорт
	
	ИспользоватьВнутренниеДокументыЭДО = ПолучитьФункциональнуюОпцию("ИспользоватьВнутренниеДокументыЭДО");
	Если НЕ ИспользоватьВнутренниеДокументыЭДО Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ПараметрыНастройки.Форма;
	
	// Если это форма организации, то необходимо скрыть команду настроек внутреннего ЭДО БЭД
	Объект = СтрРазделить(Форма.ИмяФормы, ".", Ложь)[1];
	Если Объект = Метаданные.Справочники.Организации.Имя Тогда
		СкрытьВидимостьКомандыНастройкиВнутреннегоЭДОБЭД(Форма);
		Возврат;
	КонецЕсли;
	
	Если ПараметрыНастройки.КолонкаСостоянияЭДО = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийСписок = Форма[ПараметрыНастройки.КолонкаСостоянияЭДО.Родитель.ПутьКДанным];
	ОсновнаяТаблица = ТекущийСписок.ОсновнаяТаблица;
	
	Если НЕ ЗначениеЗаполнено(ОсновнаяТаблица) Тогда
		Возврат;
	КонецЕсли;
	
	// Если все типы документов из формы списка являются документами внутреннего ЭДО БЭД,
	// и хотя бы для одного из этих типов выполена настройка внутреннего ЭДО БГУ, то колонку БЭД необходимо скрыть,
	// так как ее содержимое будет отбражаться в колонке внутреннего ЭДО БГУ,
	// кроме случаев, когда колонка БЭД используется для отражения ЭД в учете:
	// тогда колонка БЭД должна быть видна, а подменю БЭД - нет
	ТипыДокументовВнутреннегоЭДОБЭД = Новый ОписаниеТипов(ВнутреннийЭДО.ТипыДокументовВнутреннегоЭДОБЭД());
	ТипыДокументовОтраженияЭДвУчете = Метаданные.РегистрыНакопления.ОтражениеЭДВУчете.Измерения.ДокументОтраженияВУчете.Тип;
	ТипыДокументовВнутреннегоЭДОБГУ = Новый ОписаниеТипов(ВнутреннийЭДОПовтИсп.ТипыУчетныхДокументовВнутреннегоЭДО());
	
	ВидимостьКолонкиБЭД = Истина;
	ВидимостьПодменюБЭД = Истина;
	Если СтрРазделить(ОсновнаяТаблица, ".")[0] = "Документ" Тогда
		ТипДокумента = Тип("ДокументСсылка." + СтрРазделить(ОсновнаяТаблица, ".")[1]);
		Если ТипыДокументовВнутреннегоЭДОБЭД.СодержитТип(ТипДокумента)
			И ТипыДокументовВнутреннегоЭДОБГУ.СодержитТип(ТипДокумента) Тогда
			ВидимостьПодменюБЭД = Ложь;
			Если НЕ ТипыДокументовОтраженияЭДвУчете.СодержитТип(ТипДокумента) Тогда
				ВидимостьКолонкиБЭД = Ложь;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли СтрРазделить(ОсновнаяТаблица, ".")[0] = "ЖурналДокументов" Тогда
		Для Каждого РегистируемыйДокумент Из Метаданные.НайтиПоПолномуИмени(ОсновнаяТаблица).РегистрируемыеДокументы Цикл
			ТипДокумента = Тип("ДокументСсылка." + РегистируемыйДокумент.Имя);
			Если ТипыДокументовВнутреннегоЭДОБЭД.СодержитТип(ТипДокумента) Тогда
				Если ТипыДокументовВнутреннегоЭДОБГУ.СодержитТип(ТипДокумента) Тогда
					ВидимостьПодменюБЭД = Ложь;
					Если НЕ ТипыДокументовОтраженияЭДвУчете.СодержитТип(ТипДокумента) Тогда
						ВидимостьКолонкиБЭД = Ложь;
					КонецЕсли;
				КонецЕсли;
			Иначе
				ВидимостьКолонкиБЭД = Истина;
				ВидимостьПодменюБЭД = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ВидимостьКолонкиБЭД Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Форма.Элементы, ПараметрыНастройки.КолонкаСостоянияЭДО.Имя, "Видимость", Ложь);
	КонецЕсли;
	
	Если НЕ ВидимостьПодменюБЭД Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Форма.Элементы, ПараметрыНастройки.МестоРазмещенияКоманд.Имя, "Видимость", Ложь);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область НастройкаОсобенностейВнутреннегоЭДОБГУ

Функция ПользователиПорядка(ТекСтрокаТаблицыПодписантов) Экспорт
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(ТекСтрокаТаблицыПодписантов.Подписант1) Тогда
		Результат.Добавить(ТекСтрокаТаблицыПодписантов.Подписант1);
	КонецЕсли;	
	Если ЗначениеЗаполнено(ТекСтрокаТаблицыПодписантов.Подписант2) Тогда
		Результат.Добавить(ТекСтрокаТаблицыПодписантов.Подписант2);
	КонецЕсли;	
	Если ЗначениеЗаполнено(ТекСтрокаТаблицыПодписантов.Подписант3) Тогда
		Результат.Добавить(ТекСтрокаТаблицыПодписантов.Подписант3);
	КонецЕсли;	
