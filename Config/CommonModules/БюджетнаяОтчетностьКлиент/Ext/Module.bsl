// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


Процедура ВыбратьФайлСпростойОбработкойПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьФайлСпростойОбработкойПродолжение", БюджетнаяОтчетностьКлиент, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "ОбработкаРезультатаПодключенияРасширения" Тогда  
		
		Если Результат Тогда
			
			ДополнительныеПараметры.Этап = "ОбраоткаРезультатаВыбораФайла";
			
			ДиалогВыбора = Новый ДиалогВыбораФайла(ДополнительныеПараметры.РежимРаботы);
			ЗаполнитьЗначенияСвойств(ДиалогВыбора,ДополнительныеПараметры);
			ДополнительныеПараметры.Вставить("ДиалогВыбора",ДиалогВыбора);
			ДиалогВыбора.Показать(ОписаниеОповещения);
			
		Иначе 
			
			Если не ДополнительныеПараметры.Свойство("ОбработкаОтсутствияРасширения") Тогда 
				Возврат;
			КонецЕсли;	
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаОтсутствияРасширения);
			
		КонецЕсли;	
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "ОбраоткаРезультатаВыбораФайла" Тогда
		
		Если ДополнительныеПараметры.Свойство("ПервичнаяПроверка") Тогда 
			
			Отказ = (Вычислить(ДополнительныеПараметры.ПервичнаяПроверка) = Ложь);
			Если Отказ Тогда 
				Возврат;
			КонецЕсли;
			
		КонецЕсли;	
		
		ВозвращаемоеЗначение = Новый Структура;
		ВозвращаемоеЗначение.Вставить("ВыбранныеФайлы",Результат);
		ВозвращаемоеЗначение.Вставить("ДиалогВыбора",ДополнительныеПараметры.ДиалогВыбора);
		
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаРезультата,ВозвращаемоеЗначение);
		
	КонецЕсли;
	
	
	
КонецПроцедуры	

Процедура ОбработкаРезультатаОткрытияФормы(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Свойство("ПервичнаяПроверка") Тогда 
		
		Отказ = (Вычислить(ДополнительныеПараметры.ПервичнаяПроверка) = Ложь);
		Если Отказ Тогда 
			Возврат;
		КонецЕсли;
		
	КонецЕсли;	
	
	
	Если ДополнительныеПараметры.Свойство("ОбработкаРезультата") Тогда 
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаРезультата,Результат);
		
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ПослеНачалаРаботыСистемы() Экспорт
	
	ИмяФормыЗагрузкиКомплекта = "";
	Если БюджетнаяОтчетность.ДоступныНовыеВерсииКомплектов(ИмяФормыЗагрузкиКомплекта,Истина) Тогда
		
		//если доступны новые версии комплектов, и у пользователя есть права на загрузку комплектов, то оповестим об этом при запуске сеанса
		Если НЕ ЗначениеЗаполнено(ИмяФормыЗагрузкиКомплекта) Тогда
			Возврат;
		КонецЕсли;
		ДопПараметры = Новый Структура("ИмяФормы",ИмяФормыЗагрузкиКомплекта);	
					
		ОпОв = Новый ОписаниеОповещения("ОткрытьФормуОбработкиЗагрузкиКомплекта",ЭтотОбъект,ДопПараметры);
		ПоказатьОповещениеПользователя(НСтр("ru = 'Комплекты отчетности:'"), ОпОв, НСтр("ru = 'Доступны новые версии комплектов бухгалтерской/бюджетной отчетности.'"),БиблиотекаКартинок.ИнформацияРаботаСНоменклатурой32,СтатусОповещенияПользователя.Важное);

	КонецЕсли;
КонецПроцедуры

Процедура ОткрытьФормуОбработкиЗагрузкиКомплекта(ДопПараметры) Экспорт
	ОткрытьФорму(ДопПараметры.ИмяФормы);
КонецПроцедуры
	
Процедура ОбработатьОповещениеОЗагрузкеКомплекта(ИмяСобытия, Параметр, Источник, Форма) Экспорт
	Если ИмяСобытия = "Обработка.ИмпортКейса/ОкончаниеЗагрузки" Тогда
		ЕстьКомплектыДляЗагрузки = БюджетнаяОтчетность.ДоступныНовыеВерсииКомплектов("",Ложь);
		Если ЕстьКомплектыДляЗагрузки = Ложь Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,"ГруппаИнформированияОКомплекте","Видимость",Ложь);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
