// ПРОГРАММНЫЙ ИНТЕРФЕЙС

функция СформироватьПараметрыВыбораПоСценарию(ДополнительныеПараметры, ТабличныйДокумент, ГруппаРаскрытия, Форма) Экспорт 

	ТекущееЗначение = ДополнительныеПараметры.ТекущееЗначение;
	ВидАналитики = ДополнительныеПараметры.ВидАналитики;
	ИдентификаторСтроки = ДополнительныеПараметры.ИдентификаторСтроки;
	СценарийВвода = ДополнительныеПараметры.СценарийВвода;

	СтрИдентификатор = Формат(ИдентификаторСтроки,"ЧН=0; ЧГ=0");
	СтруктураОтбора  = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СценарийВвода.ФиксированныйОтбор);
	
	Если СценарийВвода.ЕстьКонтекстныйОтбор Тогда
		
		Если СценарийВвода.ТребуетсяВызовСервера Тогда
			
			// Серверный вызов для получения контекстных данных.
			КонтекстныйОтбор = Форма.ПолучитьОтборИзКонтекстаОтчета(ГруппаРаскрытия, ИдентификаторСтроки, СценарийВвода.СвязиОтбора);
			
		Иначе
			КонтекстныйОтбор = Новый Структура;
			Для Каждого СвязьОтбора Из СценарийВвода.СвязиОтбора Цикл
				ЗначениеОтбора = ТабличныйДокумент.Области[СвязьОтбора.ИмяОбласти+"_"+СтрИдентификатор].Расшифровка;
				КонтекстныйОтбор.Вставить(СвязьОтбора.ПолеОтбора,ЗначениеОтбора);
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого Отбор Из КонтекстныйОтбор Цикл
			ТекЗначениеОтбора = Неопределено;
			Если СтруктураОтбора.Свойство(Отбор.Ключ,ТекЗначениеОтбора) Тогда
				Если ТипЗнч(ТекЗначениеОтбора) = Тип("СписокЗначений") Тогда
					ТекЗначениеОтбора.Добавить(Отбор.Значение);
				Иначе
					локСписок = Новый СписокЗначений;
					локСписок.Добавить(ТекЗначениеОтбора);
					локСписок.Добавить(Отбор.Значение);
					СтруктураОтбора.Вставить(Отбор.Ключ,локСписок);
				КонецЕсли;
			Иначе
				СтруктураОтбора.Вставить(Отбор.Ключ,Отбор.Значение);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДополнительныйОтбор",СтруктураОтбора);
	ПараметрыФормы.Вставить("ТекущаяСтрока"		 ,ТекущееЗначение);
	ПараметрыФормы.Вставить("РежимВыбора"		 ,Истина);	
	ПараметрыФормы.Вставить("ОтветСтруктурой"	 ,Истина);
	
	Если СценарийВвода.Свойство("ДетальныйВидАналитики") Тогда
		ПараметрыФормы.Вставить("ДетальныйВидАналитики", СценарийВвода.ДетальныйВидАналитики);
	КонецЕсли;
	//ПараметрыФормы.Вставить("ДетализируемыйВидАналитики" ,ВидАналитики);
	
	ПараметрыФормы.Вставить("ВидАналитики"	 	 ,ВидАналитики);

	Возврат ПараметрыФормы;	
		
КонецФункции	


Процедура ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры) Экспорт 
	
	// Шаблон:
	// ДополнительныеПараметры = Новый Структура;
	// ДополнительныеПараметры.Вставить("ИмяФормы"); //обязательный
	// ДополнительныеПараметры.Вставить("ПараметрыФормы");
	// ДополнительныеПараметры.Вставить("ВладелецФормы");
	// ДополнительныеПараметры.Вставить("Уникальность");
	// ДополнительныеПараметры.Вставить("Окно");
	// ДополнительныеПараметры.Вставить("НавигационнаяСсылка");
	// ДополнительныеПараметры.Вставить("РежимОткрытияОкна");
	// ДополнительныеПараметры.Вставить("ПервичнаяПроверка");
	// ДополнительныеПараметры.Вставить("ОбработкаРезультата"); //обязательный
	// ДополнительныеПараметры.Вставить("ОбработкаЗавершения");

	ИмяФормы  = ДополнительныеПараметры.ИмяФормы;
	
	Если ДополнительныеПараметры.Свойство("ПараметрыФормы") Тогда 
		ПараметрыФормы = ДополнительныеПараметры.ПараметрыФормы;
	Иначе 
		ПараметрыФормы = Неопределено;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("ВладелецФормы") Тогда 
		ВладелецФормы = ДополнительныеПараметры.ВладелецФормы;
	Иначе 
		ВладелецФормы = Неопределено;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("Уникальность") Тогда 
		Уникальность = ДополнительныеПараметры.Уникальность;
	Иначе 
		Уникальность = Неопределено;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("Окно") Тогда 
		Окно = ДополнительныеПараметры.Окно;
	Иначе 
		Окно = Неопределено;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("НавигационнаяСсылка") Тогда 
		НавигационнаяСсылка = ДополнительныеПараметры.НавигационнаяСсылка;
	Иначе 
		НавигационнаяСсылка = Неопределено;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("РежимОткрытияОкна") Тогда 
		РежимОткрытияОкна = ДополнительныеПараметры.РежимОткрытияОкна;
	Иначе 
		РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	КонецЕсли;
	
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда 
		ЭтоОбычноеПриложение = Истина;
	#Иначе  
		ЭтоОбычноеПриложение = Ложь;
	#КонецЕсли
	
	Если ЭтоОбычноеПриложение и (РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца или РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс) Тогда 
		//не работает в обычном приложении РежимОткрытияОкна 
		Результат = ОткрытьФормуМодально(ИмяФормы,ПараметрыФормы,ВладелецФормы,НавигационнаяСсылка);
		ОбработкаРезультатаОткрытияФормы(Результат, ДополнительныеПараметры);
		
	Иначе 
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаОткрытияФормы",БюджетнаяОтчетностьКлиент,ДополнительныеПараметры);
		ОткрытьФорму(ИмяФормы, ПараметрыФормы, ВладелецФормы, Уникальность, Окно, НавигационнаяСсылка, ОписаниеОповещения, РежимОткрытияОкна);
	
	КонецЕсли;
	
КонецПроцедуры	

Процедура ВыбратьФайлСпростойОбработкой(ДополнительныеПараметры) Экспорт
	
	ДополнительныеПараметры.Вставить("Этап","ОбработкаРезультатаПодключенияРасширения");
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьФайлСпростойОбработкойПродолжение", БюджетнаяОтчетностьКлиент, ДополнительныеПараметры);
	БюджетнаяОтчетностьКлиентПереопределяемый.ПоказатьВопросОбУстановкеРасширенияРаботыСФайлами(ОписаниеОповещения);
	
КонецПроцедуры	

Процедура ПриемникРезультатовПомещенияФайлов(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.Свойство("ПервичнаяПроверка") Тогда 
		
		Отказ = (Вычислить(ДополнительныеПараметры.ПервичнаяПроверка) = Ложь);
		Если Отказ Тогда 
			Возврат;
		КонецЕсли;
		
	КонецЕсли;	
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Результат",Результат);
	ВозвращаемоеЗначение.Вставить("Адрес",Адрес);
	ВозвращаемоеЗначение.Вставить("ВыбранноеИмяФайла",ВыбранноеИмяФайла);
	
	Если ДополнительныеПараметры.Свойство("ОбработкаРезультата") Тогда 
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаРезультата,ВозвращаемоеЗначение);
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПустоеОповещение(Результат, ДополнительныеПараметры) Экспорт
	
	//ничего не делает 
	//нужно чтобы ничего не делать после получения файлов
	
КонецПроцедуры	

Процедура СравнитьСДаннымиАвтозаполнения(ВладелецФормы,СсылкаНаОтчет,УникальныйИдентификатор,АдресРезультатаЗаполнения=Неопределено) Экспорт
	ПараметрыСравнения = БюджетнаяОтчетность.ПолучитьПараметрыСравнения(СсылкаНаОтчет,УникальныйИдентификатор,АдресРезультатаЗаполнения);
	Если ПараметрыСравнения = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Для данного отчета отсутствуют сохраненные данные автозаполнения.'"));
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаСравненияВерсийУправляемая",ПараметрыСравнения,ВладелецФормы,Истина);	
КонецПроцедуры

