#Область ПрограммныйИнтерфейс

// Определяет, является ли счет, счетом капвложений, т.е. счетом 106
// с субконто ОС. 
//
// Параметры:
//  Счет - ПланСчетовСсылка
// 
// Возвращаемое значение:
//  Булево - возвращает ИСТИНА, если это счет капвложений
Функция ЭтоСчетКапвложений(Счет) Экспорт
	Возврат(ОбслуживаниеКарточекКапвложений.ЭтоСчетКапвложений(Счет));
КонецФункции	

// Определяет, являются ли счета, переданные в соответствии "Счета" счетами капвложений, т.е. счетами 106.хх
// с субконто ОС. 
//
// Параметры:
//  Счета - Соответствие. Ключ - СчетСсылка, Значение - Булево
Процедура ОпределитьСчетаКапвложений(Счета) Экспорт
	Для каждого ТекЭлемент Из Счета Цикл      
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Ключ) Тогда
			Счета.Вставить(ТекЭлемент.Ключ, Ложь);
		Иначе	
			Счета.Вставить(ТекЭлемент.Ключ, ЭтоСчетКапвложений(ТекЭлемент.Ключ));
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

// Формирует массив счетов капвложений, для целей учета данных для заполнения
// карточек капвложений. Это счета 106.хх с субконто "Основные средства"
//
// Возвращаемое значение:
//	Массив - массив ссылок на счета капвложений
Функция СчетаКапвложенийДляКарточкиКапвложений() Экспорт
	Возврат ОбслуживаниеКарточекКапвложенийПовтИсп.СчетаКапвложенийДляКарточкиКапвложений();
КонецФункции	

#КонецОбласти