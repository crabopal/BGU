	|	ТЧКонтрагенты.СчетКонтрагента,
	|	ЕСТЬNULL(КонтрагентыСтатусы.КонтрагентСтатус, """")
	|ИЗ
	|	Документ.РегистрацияОбязательствИСведенийПоДоговорам.Контрагенты КАК ТЧКонтрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ФИОКонтрагентаФизЛица КАК ФИОКонтрагентаФизЛица
	|		ПО ТЧКонтрагенты.Контрагент = ФИОКонтрагентаФизЛица.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ КонтрагентыСтатусы КАК КонтрагентыСтатусы
	|		ПО ТЧКонтрагенты.Контрагент = КонтрагентыСтатусы.Контрагент
	|ГДЕ
	|	ТЧКонтрагенты.Ссылка В(&МассивОбъектов)";
				   
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
	
	СтруктураДанныхДляПечати = Новый Структура;
	// ПакетРезультатовЗапроса[0] - ДоговораДокументов
	// ПакетРезультатовЗапроса[1] - РуководителиФИО
	// ПакетРезультатовЗапроса[2] - ДолжностиРуководителей
	// ПакетРезультатовЗапроса[3] - КонтрагентыДокументов
