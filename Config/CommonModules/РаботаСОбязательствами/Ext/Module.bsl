	|	КОНЕЦ КАК КодШтрафа,
    |	ВЫБОР КОГДА ПОДСТРОКА(Неустойки.ПричинаНеустойки.Код, 1, 1) = ""2""
	|		ТОГДА Неустойки.ПричинаНеустойки.Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодПеней,
	|	Неустойки.ПричинаНеустойки.Код КАК КодНеустойки,
	|	Неустойки.ПричинаНеустойки.НаименованиеПолное КАК НаименованиеНеустойки,
	|	ВЫБОР Неустойки.Плательщик
	|		КОГДА 1
	|			ТОГДА ""Заказчик""
	|		КОГДА 2
	|			ТОГДА ""Исполнитель (подрядчик)""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК СторонаПлательщик,
	|	Неустойки.ОснованиеНеустойки КАК ОснованиеНеустойки,
	|	Неустойки.СуммаНачисленная КАК СуммаНачисленная,
	|	Неустойки.РеквизитыДокументаУплаты КАК РеквизитыДокументаУплаты,
	|	Неустойки.СуммаВзысканная КАК СуммаВзысканная,
	|	Неустойки.ОснованиеВозврата КАК ОснованиеВозврата,
	|	Неустойки.СуммаВозвращенная КАК СуммаВозвращенная,
	|	Неустойки.ОснованиеСписания КАК ОснованиеСписания,
	|	Неустойки.СуммаСписания КАК СуммаСписания
	|ИЗ
	|	Документ.ИсполнениеРасторжениеДоговора.Неустойки КАК Неустойки
	|ГДЕ
	|	Неустойки.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Расторжение.Ссылка КАК Ссылка,
	|	Расторжение.ОснованиеРасторженияКонтрактаКод КАК ОснованиеРасторженияКонтрактаКод,
	|	Расторжение.ОснованиеРасторженияКонтракта КАК ОснованиеРасторженияКонтракта,
	|	Расторжение.ОснованиеРасторжения КАК ОснованиеРасторженияДокументВид,
	|	Расторжение.ОснованиеРасторженияКод КАК ОснованиеРасторженияДокументКод,
	|	Расторжение.ДатаРасторжения КАК ДокументДатаРасторжения,
	|	Расторжение.НомерРасторжения КАК ДокументНомерРасторжения,
	|	Расторжение.СуммаОплаты КАК СуммаОплаты,
	|	Расторжение.ДатаРасторженияКонтракта КАК ДатаРасторжения,
	|	Расторжение.ПричинаРасторжения КАК ОснованиеПричинаРасторжения,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Сумма КАК ЦенаКонтракта
	|ИЗ
	|	Документ.ИсполнениеРасторжениеДоговора КАК Расторжение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних КАК СрокиИсполненияИСуммыОбязательствСрезПоследних
	|		ПО Расторжение.Договор = СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство
	|ГДЕ
	|	Расторжение.Ссылка В(&МассивОбъектов)";
				   
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
	                                    
	СтруктураДанныхДляПечати = Новый Структура;
	// ПакетРезультатовЗапроса[0] - временная таблица ДоговораДокументов
	// ПакетРезультатовЗапроса[1] - РуководителиФИО 
	// ПакетРезультатовЗапроса[2] - ОтветственныйИсполнительФИО
	СтруктураДанныхДляПечати.Вставить("РезультатПоШапке", 				ПакетРезультатовЗапроса[3]);
	СтруктураДанныхДляПечати.Вставить("ХарактеристикиОбязательства", 	ПакетРезультатовЗапроса[4]);
	СтруктураДанныхДляПечати.Вставить("Исполнение", 					ПакетРезультатовЗапроса[5]);
	СтруктураДанныхДляПечати.Вставить("Оплата", 						ПакетРезультатовЗапроса[6]);
	СтруктураДанныхДляПечати.Вставить("Товары", 						ПакетРезультатовЗапроса[7]);
	СтруктураДанныхДляПечати.Вставить("Неустойки", 						ПакетРезультатовЗапроса[8]);
	СтруктураДанныхДляПечати.Вставить("Расторжение", 					ПакетРезультатовЗапроса[9]);
	
	
	Возврат СтруктураДанныхДляПечати;
	
КонецФункции

// Функция получает данные для формирования печатной формы "Сведений об исполнении/прекращении госконтракта"
// (приказ Казначейства России от № 17н, в ред. приказа Казначейства России от 12.01.2026 N 1н
//
// Параметры:
// 		ПараметрыПечати - Структура
// 		МассивОбъектов - Массив - Массив ссылок на документы, по которым необходимо получить данные
//
// Возвращаемое значение:
// 		Структура - Структура с полями: "РезультатПоШапке", "ПредметКонтракта", 
//										"ХарактеристикиОбязательства", "РезультатБюджет", 
//										"РезультатВнебюджет", "ПериодыГодами", "КонтактнаяИнформация"
//
Функция ПолучитьДанныеДляПечатнойФормыСведенияОПрекращении17н2026(ПараметрыПечати, МассивОбъектов) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИсполнениеРасторжениеДоговора.Договор КАК Договор,
	|	ИсполнениеРасторжениеДоговора.Ссылка КАК Ссылка,
	|	ИсполнениеРасторжениеДоговора.Дата КАК Дата,
	|	ЕСТЬNULL(ИдентификаторКонтракта.ЗначениеХарактеристики, """") КАК ИдентификаторКонтракта,
	|	ЕСТЬNULL(ДатаПодписанияЗаказчиком.ЗначениеХарактеристики, """") КАК ДатаПодписанияКонтракта,
	|	ЕСТЬNULL(УчетныеНомераОбязательств.УчетныйНомерОбязательства, """") КАК НомерБО
	|ПОМЕСТИТЬ ДоговораДокументов
	|ИЗ
	|	Документ.ИсполнениеРасторжениеДоговора КАК ИсполнениеРасторжениеДоговора
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиОбязательств.СрезПоследних КАК ИдентификаторКонтракта
	|		ПО ИсполнениеРасторжениеДоговора.Договор = ИдентификаторКонтракта.Договор
	|			И (ИдентификаторКонтракта.ВидХарактеристики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыХарактеристикОбязательства.ИдентификаторКонтракта)) 
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиОбязательств.СрезПоследних КАК ДатаПодписанияЗаказчиком
	|		ПО ИсполнениеРасторжениеДоговора.Договор = ДатаПодписанияЗаказчиком.Договор
	|			И (ДатаПодписанияЗаказчиком.ВидХарактеристики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыХарактеристикОбязательства.ДатаПодписанияЗаказчиком)) 
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеНомераОбязательств КАК УчетныеНомераОбязательств
	|		ПО ИсполнениеРасторжениеДоговора.Договор = УчетныеНомераОбязательств.Обязательство
	|ГДЕ
	|	ИсполнениеРасторжениеДоговора.Ссылка В(&МассивОбъектов)
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////01
	|ВЫБРАТЬ
	|	ДанныеРуководителя.Руководитель КАК Руководитель,
	|	ФИОФизическихЛиц.Фамилия КАК Фамилия,
	|	ФИОФизическихЛиц.Имя КАК Имя,
	|	ФИОФизическихЛиц.Отчество КАК Отчество
	|ПОМЕСТИТЬ РуководителиФИО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДоговораДокументов.Ссылка.Руководитель КАК Руководитель,
	|		ДоговораДокументов.Ссылка.Руководитель.Контрагент.ЮридическоеФизическоеЛицо КАК ФизЛицо,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК Период
	|	ИЗ
	|		ДоговораДокументов КАК ДоговораДокументов
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО (ФИОФизическихЛиц.Период <= ДоговораДокументов.Дата)
	|				И ДоговораДокументов.Ссылка.Руководитель.Контрагент.ЮридическоеФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ДоговораДокументов.Ссылка.Руководитель,
	|		ДоговораДокументов.Ссылка.Руководитель.Контрагент.ЮридическоеФизическоеЛицо) КАК ДанныеРуководителя
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО ДанныеРуководителя.Период = ФИОФизическихЛиц.Период
	|			И ДанныеРуководителя.ФизЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеРуководителя.Руководитель,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество,
	|	ФИОФизическихЛиц.Фамилия 
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////02
	|ВЫБРАТЬ
	|	ДанныеОтветственныйИсполнитель.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель, 
	|	ДанныеОтветственныйИсполнитель.ФизЛицо КАК ОтвИспФизЛицо,
	|	ФИОФизическихЛиц.Фамилия КАК Фамилия,
	|	ФИОФизическихЛиц.Имя КАК Имя,
	|	ФИОФизическихЛиц.Отчество КАК Отчество
	|ПОМЕСТИТЬ ОтветственныйИсполнительФИО
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДоговораДокументов.Ссылка.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|		ДоговораДокументов.Ссылка.ОтветственныйИсполнитель.Контрагент.ЮридическоеФизическоеЛицо КАК ФизЛицо,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК Период
	|	ИЗ
	|		ДоговораДокументов КАК ДоговораДокументов
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО (ФИОФизическихЛиц.Период <= ДоговораДокументов.Дата)
	|				И ДоговораДокументов.Ссылка.ОтветственныйИсполнитель.Контрагент.ЮридическоеФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ДоговораДокументов.Ссылка.ОтветственныйИсполнитель,
	|		ДоговораДокументов.Ссылка.ОтветственныйИсполнитель.Контрагент.ЮридическоеФизическоеЛицо) КАК ДанныеОтветственныйИсполнитель
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО ДанныеОтветственныйИсполнитель.Период = ФИОФизическихЛиц.Период
	|			И ДанныеОтветственныйИсполнитель.ФизЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеОтветственныйИсполнитель.ОтветственныйИсполнитель,
	|	ДанныеОтветственныйИсполнитель.ФизЛицо,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество,
	|	ФИОФизическихЛиц.Фамилия
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////03
	|ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Дата КАК ДатаДокумента,
	|	Шапка.Руководитель КАК Руководитель, 
	|	Шапка.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|	Шапка.Организация.НаименованиеПолное КАК НаименованиеЗаказчика,
	|	Шапка.Организация.НаименованиеСокращенное КАК НаименованиеЗаказчикаСокращенное,
	|	Шапка.Организация.КодПоРПБС КАК КодПоРПБС,
	|	Шапка.Организация.ИНН КАК ЗаказчикИНН,
	|	Шапка.Организация.КПП КАК ЗаказчикКПП,
	|	Шапка.Договор.НомерДоговора КАК НомерКонтракта,
	|	Шапка.Договор.ДатаДоговора КАК ДатаЗаключенияКонтракта, 
	|	ВЫБОР Шапка.Организация.КодКФС
	|		КОГДА ""12""
	|			ТОГДА ""1""
	|		КОГДА ""13""
	|			ТОГДА ""2""
	|		КОГДА ""14""
	|			ТОГДА ""3""
	|		ИНАЧЕ ""4""
	|	КОНЕЦ КАК ПервыйРазрядИКУ,
	|	Шапка.ЭтоРасторжение КАК ЭтоРасторжение,
	|	ВЫБОР Шапка.СтатусИсполненияДоговора
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДоговоров.Завершен)
	|			ТОГДА ""1""
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДоговоров.Аннулирован)
	|			ТОГДА ""2""
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДоговоров.ПризнанНедействительным)
	|			ТОГДА ""3""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПризнакИсполнения,
	|	ЕСТЬNULL(ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики, """") КАК НомерРеестровойЗаписи,
	|	ЕСТЬNULL(РуководителиФИО.Фамилия, """") + "" "" + ЕСТЬNULL(РуководителиФИО.Имя, """") + "" "" + ЕСТЬNULL(РуководителиФИО.Отчество, """") КАК ФИОРуководителя, 
	|	ЕСТЬNULL(ОтветственныйИсполнительФИО.Фамилия, """") + "" "" + ЕСТЬNULL(ОтветственныйИсполнительФИО.Имя, """") + "" "" + ЕСТЬNULL(ОтветственныйИсполнительФИО.Отчество, """") КАК ФИООтветственныйИсполнитель,
	|	ЕСТЬNULL(ОтветственныйИсполнительФИО.ОтвИспФизЛицо, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК ОтвИспФизЛицо,
	|	ЕСТЬNULL(ХарактеристикиОбязательствГрифСекретности.ЗначениеХарактеристики, """") КАК ГрифСекретности,
	|	ВЫБОР ХарактеристикиОбязательствГрифСекретности.ЗначениеХарактеристики
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.ПризнакСекретности.НеСекретно)
	|			ТОГДА ""0""
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.ПризнакСекретности.ДСП)
	|			ТОГДА ""1""
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.ПризнакСекретности.Секретно)
	|			ТОГДА ""2""
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.ПризнакСекретности.СовершенноСекретно)
	|			ТОГДА ""3""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ГрифСекретностиКод,
	|	ДоговораДокументов.ИдентификаторКонтракта КАК ИдентификаторКонтракта,
	|	ДоговораДокументов.НомерБО КАК НомерБО,
	|	ДоговораДокументов.ДатаПодписанияКонтракта КАК ДатаПодписанияКонтракта 
	|ИЗ
	|	Документ.ИсполнениеРасторжениеДоговора КАК Шапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РуководителиФИО КАК РуководителиФИО
	|		ПО Шапка.Руководитель = РуководителиФИО.Руководитель
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОтветственныйИсполнительФИО КАК ОтветственныйИсполнительФИО
	|		ПО Шапка.ОтветственныйИсполнитель = ОтветственныйИсполнительФИО.ОтветственныйИсполнитель
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиОбязательств.СрезПоследних КАК ХарактеристикиОбязательствСрезПоследних
	|		ПО Шапка.Договор = ХарактеристикиОбязательствСрезПоследних.Договор
	|			И (ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыХарактеристикОбязательства.НомерРеестровойЗаписи))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиОбязательств.СрезПоследних КАК ХарактеристикиОбязательствГрифСекретности
	|		ПО Шапка.Договор = ХарактеристикиОбязательствГрифСекретности.Договор
	|			И (ХарактеристикиОбязательствГрифСекретности.ВидХарактеристики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыХарактеристикОбязательства.ГрифСекретности))
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДоговораДокументов КАК ДоговораДокументов
	|		ПО Шапка.Ссылка = ДоговораДокументов.Ссылка
	|ГДЕ
	|	Шапка.Ссылка В(&МассивОбъектов)
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////04
	|ВЫБРАТЬ
	|	ДоговораДокументов.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыХарактеристикОбязательства.ПустаяСсылка)) КАК ВидХарактеристики,
	|	ЕСТЬNULL(ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики, """") КАК ЗначениеХарактеристики,
	|	ЕСТЬNULL(ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики.Код, """") КАК ВидХарактеристикиКод
	|ИЗ
