	СтруктураДанныхДляПечати.Вставить("РезультатПоШапке", 				ПакетРезультатовЗапроса[7]);
	СтруктураДанныхДляПечати.Вставить("ХарактеристикиОбязательства", 	ПакетРезультатовЗапроса[8]);
	СтруктураДанныхДляПечати.Вставить("КонтактнаяИнформация", 			ПакетРезультатовЗапроса[9]);
	СтруктураДанныхДляПечати.Вставить("РасшифровкаОбязательства", 		ПакетРезультатовЗапроса[10]);
	СтруктураДанныхДляПечати.Вставить("Контрагенты", 					ПакетРезультатовЗапроса[11]);
	
	Возврат СтруктураДанныхДляПечати;
	
КонецФункции

// Функция получает данные для "информации о соглашениях (нормативных правовых актах) о предоставлении субсидий"
