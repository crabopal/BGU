Функция ЕстьДокументИсполненияРасторжения(ЗНАЧ Договор, СтруктураДокумента = Неопределено) Экспорт 

	Результат = Ложь;
	СтруктураДокумента = Новый Структура("Представление, Ссылка, Дата, Номер");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ИсполнениеРасторжениеДоговора.Представление,
	               |	ИсполнениеРасторжениеДоговора.Ссылка,
	               |	ИсполнениеРасторжениеДоговора.Дата,
	               |	ИсполнениеРасторжениеДоговора.Номер
	               |ИЗ
	               |	Документ.ИсполнениеРасторжениеДоговора КАК ИсполнениеРасторжениеДоговора
	               |ГДЕ
	               |	ИсполнениеРасторжениеДоговора.Договор = &Договор
	               |	И ИсполнениеРасторжениеДоговора.Проведен";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Договор", Договор);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(СтруктураДокумента, Выборка);
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат; 

КонецФункции 

Функция ЗначениеХарактеристикиОбязательства(ЗНАЧ Договор, ЗНАЧ ДатаАктуальности = Неопределено, ИмяХарактеристики) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если ТипЗнч(ИмяХарактеристики) = Тип("Строка") Тогда
		
		ХарактеристикаОбязательства = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НайтиПоНаименованию(ИмяХарактеристики);
		
	ИначеЕсли ТипЗнч(ИмяХарактеристики) = Тип("ПланВидовХарактеристикСсылка.ВидыХарактеристикОбязательства") Тогда
		
		ХарактеристикаОбязательства = ИмяХарактеристики;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДатаАктуальности) Тогда
		
		ДатаАктуальности = ТекущаяДатаСеанса();
		
	КонецЕсли;	
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики КАК ЗначениеХарактеристики
	|ИЗ
	|	РегистрСведений.ХарактеристикиОбязательств.СрезПоследних(
	|			&ДатаАктуальности,
	|			Договор = &Договор
	|				И ВидХарактеристики = &ХарактеристикаОбязательства) КАК ХарактеристикиОбязательствСрезПоследних");
	
	Запрос.УстановитьПараметр("ДатаАктуальности", КонецДня(ДатаАктуальности));
	Запрос.УстановитьПараметр("ХарактеристикаОбязательства", ХарактеристикаОбязательства);
	Запрос.УстановитьПараметр("Договор", Договор);

	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЗначениеХарактеристики;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
	
КонецФункции	

Функция НоменклатураПоставокПоДоговору(ЗНАЧ Договор) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура КАК Номенклатура,
	|	ПланФинансированияОбязательствСрезПоследних.ОКП КАК ОКП,
	|	ВЫБОР
	|		КОГДА ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура ССЫЛКА Справочник.Номенклатура
	|				ИЛИ ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура.СтранаПроисхождения
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|	КОНЕЦ КАК СтранаПроисхождения,
	|	ПланФинансированияОбязательствСрезПоследних.Количество КАК Количество,
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.ПланФинансированияОбязательств.СрезПоследних КАК ПланФинансированияОбязательствСрезПоследних
	|ГДЕ
	|	ПланФинансированияОбязательствСрезПоследних.Обязательство = &Обязательство");
	
	Запрос.УстановитьПараметр("Обязательство", Договор);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает структуру для указания параметров получения остатков НФА по договору с учетом предмета договора.
// Если заполнен параметр "Документ", то из документа будут заполнены ключи "Договор", "Дата", "Документ".
// Используется в функции ОстатокНФАУслугПоДоговору.
// 
// Параметры:
// 	Документ - ДокументОбъект, ДанныеФормыСтруктура - документ или реквизит "Объект" формы документа.
// Возвращаемое значение:
// 	Структура - Описание:
// * ДоговорОснование - СправочникСсылка.Договоры - договор, на основании которого заполняется документ.
// * ПервичныйДоговор - СправочникСсылка.Договоры - договор первого уровня. Только для проверки возможности заполнения. 
// * Дата - Дата - дата, по которую выполняется расчет. Автоматически устанавливается конец месяца документа. 
// * Документ - ДокументСсылка - текущий документ, движения документа не учитываются при расчете.
// * ТипыНоменклатуры - Массив - допустимые типы номеклатуры
// * ПолучитьДанныеДоговора - Булево - получить данные обязательства для заполнения шапки документа.
Функция ПараметрыПолученияОстатковНФАПоДоговору(Документ = Неопределено) Экспорт
	
	Параметры = Новый Структура("ДоговорОснование, ПервичныйДоговор, Дата, Документ, ТипыНоменклатуры, ПолучитьДанныеДоговора");
	
	Параметры.ПолучитьДанныеДоговора = Ложь;
	Если Документ <> Неопределено Тогда
		Параметры.ПервичныйДоговор = Документ.Договор;
		Параметры.Дата             = КонецМесяца(Документ.Дата);
		Параметры.Документ         = Документ.Ссылка;
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Возвращает остаток МЗ и услуг по договору с учетом предмета договора. При расчете учитывается период плана.
// 
// Параметры:
// 	Параметры - Структура - параметры заполнения.(См. ПараметрыПолученияОстатковНФАПоДоговору())
// Возвращаемое значение:
// 	Неопределено - передан ошибочный договор. Причина ошибки выводится сообщением пользователю.
// 	Структура - Описание:
// * ОстаткиНФА - ТаблицаЗначений - таблица остатков НФА и услуг.
// * ДанныеДоговора - Структура - последние данные договора из регистра накопления СрокиИсполненияИСуммыОбязательств.
Функция ОстатокМЗУслугПоДоговору(Параметры) Экспорт
	
	ДоговорОснование = Параметры.ДоговорОснование;
	ПервичныйДоговор = Параметры.ПервичныйДоговор;
	Дата             = Параметры.Дата;
	Документ         = Параметры.Документ;
	ТипыНоменклатуры = Параметры.ТипыНоменклатуры;
	
	Если НЕ ЗначениеЗаполнено(ДоговорОснование) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорОснование, "ПометкаУдаления,Представление,Организация");
	Организация = РеквизитыДоговора.Организация;
	
	Если РеквизитыДоговора.ПометкаУдаления Тогда
		ТекстОшибки = НСтр("ru='Документ поступления можно ввести только на основании не помеченного на удаление договора'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	Если Параметры.ПолучитьДанныеДоговора ИЛИ Не ЗначениеЗаполнено(ПервичныйДоговор) Тогда
		ПервичныйДоговор = ПолучитьДоговорПервогоУровня(ДоговорОснование);
	КонецЕсли;
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПервичныйДоговор, "ВидДоговора, УчетПредметаДоговора,"
		+ "ЗаключаетсяПоРезультатамКонкурсныхПроцедур, ПризнакЗавершенияКонкурсныхПроцедур,"
		+ "РезультатЗавершенияКонкурсныхПроцедур");
	
	Если НЕ (РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
		И РеквизитыДоговора.УчетПредметаДоговора) Тогда
			
		ТекстОшибки = НСтр("ru='Документ поступления можно ввести только на основании договора с поставщиком с установленным признаком ""Учет предмета договора""'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	Если РеквизитыДоговора.ЗаключаетсяПоРезультатамКонкурсныхПроцедур 
		И НЕ РеквизитыДоговора.ПризнакЗавершенияКонкурсныхПроцедур 
		И НЕ РеквизитыДоговора.РезультатЗавершенияКонкурсныхПроцедур = 1 Тогда
			
		ТекстОшибки = НСтр("ru='Документ поступления можно ввести только на основании договора по которому завершены конкурсные процедуры'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
	Запрос.УстановитьПараметр("Обязательство",   ДоговорОснование);
	Запрос.УстановитьПараметр("СсылкаДокумента", Документ);
	Запрос.УстановитьПараметр("КЭК340",          БухгалтерскийУчетПовтИсп.КЭКПоКоду("340")); 
	Запрос.УстановитьПараметр("ДатаОкончания",   КонецМесяца(Дата));
	Запрос.УстановитьПараметр("ТипНоменклатуры", ТипыНоменклатуры);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОСГУ.Ссылка КАК ДетальныйКЭК,
	|	&КЭК340 КАК КЭК340
	|ПОМЕСТИТЬ КЭКМЗ
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Ссылка В ИЕРАРХИИ(&КЭК340)
	|	И КОСГУ.Ссылка <> &КЭК340";
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура КАК Номенклатура,
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КПС КАК КПС,
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КФО КАК КФО,
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КЭК КАК КЭК,
	|	ПланФинансированияОбязательствСрезПоследних.Количество КАК Количество,
	|	ПланФинансированияОбязательствСрезПоследних.СуммаВВалюте КАК СуммаВВалюте
	|ПОМЕСТИТЬ ПланПоступлений
	|ИЗ
	|	РегистрСведений.ПланФинансированияОбязательств.СрезПоследних(, Обязательство = &Обязательство) КАК
	|		ПланФинансированияОбязательствСрезПоследних
	|ГДЕ
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура ССЫЛКА Справочник.Номенклатура
	|	И ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура.ТипНоменклатуры В (&ТипНоменклатуры)
	|	И (ПланФинансированияОбязательствСрезПоследних.КлючАналитики.ПериодПлана.ДатаОкончания <= &ДатаОкончания
	|	ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))";
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА КЭКМЗ.ДетальныйКЭК ЕСТЬ НЕ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ИспользуютсяДетальныеКЭК
	|ИЗ
	|	ПланПоступлений КАК ПланПоступлений
	|		ЛЕВОЕ СОЕДИНЕНИЕ КЭКМЗ КАК КЭКМЗ
	|		ПО ПланПоступлений.КЭК = КЭКМЗ.ДетальныйКЭК";
	
	Выборка = Запрос.Выполнить().Выбрать();
	ИспользуютсяДетальныеКЭК = Выборка.Следующий() И Выборка.ИспользуютсяДетальныеКЭК = Истина;
	Запрос.УстановитьПараметр("ИспользуютсяДетальныеКЭК", ИспользуютсяДетальныеКЭК);
	Запрос.УстановитьПараметр("ПрименяетсяДетальныйКЭК340и440",
		БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(Дата, Организация));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеМЗ.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(Сторно.Ссылка, ЗНАЧЕНИЕ(Документ.Сторно.ПустаяСсылка)) КАК Сторно
	|ПОМЕСТИТЬ ДокументыПоступлений
	|ИЗ
	|	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ДвиженияДокумента
	|		ПО ПоступлениеМЗ.Ссылка = ДвиженияДокумента.Регистратор
	|			И (ДвиженияДокумента.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сторно КАК Сторно
	|		ПО ПоступлениеМЗ.Ссылка = Сторно.ДокументОснование
	|ГДЕ
	|	ПоступлениеМЗ.Договор В ИЕРАРХИИ(&Обязательство)
	|	И ПоступлениеМЗ.ПометкаУдаления = ЛОЖЬ
	|	И ПоступлениеМЗ.Ссылка <> &СсылкаДокумента
	|	И НЕ ПоступлениеМЗ.ДокументОснование ССЫЛКА Документ.ПоступлениеМЗВПути
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеМЗВПути.Ссылка,
	|	ЕСТЬNULL(Сторно.Ссылка, ЗНАЧЕНИЕ(Документ.Сторно.ПустаяСсылка))
	|ИЗ
	|	Документ.ПоступлениеМЗВПути КАК ПоступлениеМЗВПути
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ДвиженияДокумента
	|		ПО ПоступлениеМЗВПути.Ссылка = ДвиженияДокумента.Регистратор
	|			И (ДвиженияДокумента.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сторно КАК Сторно
	|		ПО ПоступлениеМЗВПути.Ссылка = Сторно.ДокументОснование
	|ГДЕ
	|	ПоступлениеМЗВПути.Договор В ИЕРАРХИИ(&Обязательство)
	|	И ПоступлениеМЗВПути.ПометкаУдаления = ЛОЖЬ
	|	И ПоступлениеМЗВПути.Ссылка <> &СсылкаДокумента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеУслугРабот.Ссылка,
	|	ЕСТЬNULL(Сторно.Ссылка, ЗНАЧЕНИЕ(Документ.Сторно.ПустаяСсылка))
	|ИЗ
	|	Документ.ПоступлениеУслугРабот КАК ПоступлениеУслугРабот
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ДвиженияДокумента
	|		ПО ПоступлениеУслугРабот.Ссылка = ДвиженияДокумента.Регистратор
	|			И (ДвиженияДокумента.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сторно КАК Сторно
	|		ПО ПоступлениеУслугРабот.Ссылка = Сторно.ДокументОснование
	|ГДЕ
	|	ПоступлениеУслугРабот.Договор В ИЕРАРХИИ(&Обязательство)
	|	И ПоступлениеУслугРабот.ПометкаУдаления = ЛОЖЬ
	|	И ПоступлениеУслугРабот.Ссылка <> &СсылкаДокумента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(Сторно.Ссылка, ЗНАЧЕНИЕ(Документ.Сторно.ПустаяСсылка)) КАК Сторно
	|ИЗ
	|	Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат КАК ПоступлениеУслугРаботПоСчетамУчетаЗатрат
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ДвиженияДокумента
	|		ПО ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Ссылка = ДвиженияДокумента.Регистратор
	|		И ДвиженияДокумента.НомерСтроки = 1
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сторно КАК Сторно
	|		ПО ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Ссылка = Сторно.ДокументОснование
	|ГДЕ
	|	ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Договор В ИЕРАРХИИ (&Обязательство)
	|	И НЕ ПоступлениеУслугРаботПоСчетамУчетаЗатрат.ПометкаУдаления
	|	И ПоступлениеУслугРаботПоСчетамУчетаЗатрат.Ссылка <> &СсылкаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыПоступлений.Сторно КАК Сторно
	|ИЗ
	|	ДокументыПоступлений КАК ДокументыПоступлений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ДвиженияДокумента
	|		ПО ДокументыПоступлений.Сторно = ДвиженияДокумента.Регистратор
	|			И (ДвиженияДокумента.НомерСтроки = 1)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сторно.НовыеПроводки КАК НовыеПроводки
	|		ПО ДокументыПоступлений.Сторно = НовыеПроводки.Ссылка
	|			И (НовыеПроводки.НомерСтроки = 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НеисполненныеОбязательства.Номенклатура КАК Номенклатура,
	|	ВЫРАЗИТЬ(НеисполненныеОбязательства.Номенклатура КАК Справочник.Номенклатура).СтавкаНДС КАК СтавкаНДС,
	|	ВЫРАЗИТЬ(НеисполненныеОбязательства.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫРАЗИТЬ(НеисполненныеОбязательства.Номенклатура КАК Справочник.Номенклатура).ТипНоменклатуры КАК ТипНоменклатуры,
	|	ВЫРАЗИТЬ(НеисполненныеОбязательства.Номенклатура КАК Справочник.Номенклатура).ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ВЫРАЗИТЬ(НеисполненныеОбязательства.Номенклатура КАК Справочник.Номенклатура).СтранаПроисхождения КАК СтранаПроисхождения,
	|	НеисполненныеОбязательства.КПС КАК КПС,
	|	НеисполненныеОбязательства.КПС КАК КПСРасчетов,
	|	НеисполненныеОбязательства.КФО КАК КФО,
	|	НеисполненныеОбязательства.КЭК КАК КЭК,
	|	СУММА(НеисполненныеОбязательства.Количество) КАК Количество,
	|	СУММА(НеисполненныеОбязательства.Сумма) КАК Сумма,
	|	НеисполненныеОбязательства.Номенклатура.СчетУчета КАК СчетУчетаКод
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПланПоступлений.Номенклатура КАК Номенклатура,
	|		ПланПоступлений.КПС КАК КПС,
	|		ПланПоступлений.КФО КАК КФО,
	|		ВЫБОР
	|			КОГДА НЕ &ПрименяетсяДетальныйКЭК340и440
	|				И ПланПоступлений.КЭК В
	|						(ВЫБРАТЬ
	|							КЭКМЗ.ДетальныйКЭК
	|						ИЗ
	|							КЭКМЗ КАК КЭКМЗ)
	|				ТОГДА &КЭК340 
	|			ИНАЧЕ ПланПоступлений.КЭК
	|		КОНЕЦ КАК КЭК,
	|		ПланПоступлений.Количество КАК Количество,
	|		ПланПоступлений.СуммаВВалюте КАК Сумма
	|	ИЗ
	|		ПланПоступлений КАК ПланПоступлений
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПоступлениеМЗМатериалы.Номенклатура,
	|		ВЫБОР
	|			КОГДА ПоступлениеМЗМатериалы.Ссылка.НесколькоКПСРасчетов
	|				ТОГДА ПоступлениеМЗМатериалы.КПСРасчетов
	|			ИНАЧЕ ПоступлениеМЗМатериалы.Ссылка.КПСРасчетов
	|		КОНЕЦ,
	|		ПоступлениеМЗМатериалы.КФО,
	|		ВЫБОР
	|			КОГДА (НЕ &ИспользуютсяДетальныеКЭК ИЛИ НЕ &ПрименяетсяДетальныйКЭК340и440)
	|					И ПоступлениеМЗМатериалы.КЭК В
	|						(ВЫБРАТЬ
	|							КЭКМЗ.ДетальныйКЭК
	|						ИЗ
	|							КЭКМЗ КАК КЭКМЗ)
	|				ТОГДА &КЭК340
	|			ИНАЧЕ ПоступлениеМЗМатериалы.КЭК
	|		КОНЕЦ,
	|		-ПоступлениеМЗМатериалы.Количество,
	|		-ПоступлениеМЗМатериалы.Всего
	|	ИЗ
	|		Документ.ПоступлениеМЗ.Материалы КАК ПоступлениеМЗМатериалы
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыПоступлений КАК ДокументыПоступлений
	|			ПО ПоступлениеМЗМатериалы.Ссылка = ДокументыПоступлений.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ДвиженияДокумента
	|			ПО (ДокументыПоступлений.Сторно = ДвиженияДокумента.Регистратор)
	|				И (ДвиженияДокумента.НомерСтроки = 1)
	|	ГДЕ
	|		(ДокументыПоступлений.Сторно = ЗНАЧЕНИЕ(Документ.Сторно.ПустаяСсылка)
	|				ИЛИ ДвиженияДокумента.Регистратор ЕСТЬ NULL)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПоступлениеМЗВПутиМатериалы.Номенклатура,
	|		ПоступлениеМЗВПутиМатериалы.КПС,
	|		ПоступлениеМЗВПутиМатериалы.КФО,
	|		ВЫБОР
	|			КОГДА (НЕ &ИспользуютсяДетальныеКЭК ИЛИ НЕ &ПрименяетсяДетальныйКЭК340и440)
	|					И ПоступлениеМЗВПутиМатериалы.КЭК В
	|						(ВЫБРАТЬ
	|							КЭКМЗ.ДетальныйКЭК
	|						ИЗ
	|							КЭКМЗ КАК КЭКМЗ)
	|				ТОГДА &КЭК340
	|			ИНАЧЕ ПоступлениеМЗВПутиМатериалы.КЭК
	|		КОНЕЦ,
	|		-ПоступлениеМЗВПутиМатериалы.Количество,
	|		-ПоступлениеМЗВПутиМатериалы.Всего
	|	ИЗ
	|		Документ.ПоступлениеМЗВПути.Материалы КАК ПоступлениеМЗВПутиМатериалы
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыПоступлений КАК ДокументыПоступлений
	|			ПО ПоступлениеМЗВПутиМатериалы.Ссылка = ДокументыПоступлений.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ДвиженияДокумента
	|			ПО (ДокументыПоступлений.Сторно = ДвиженияДокумента.Регистратор)
	|				И (ДвиженияДокумента.НомерСтроки = 1)
	|	ГДЕ
	|		(ДокументыПоступлений.Сторно = ЗНАЧЕНИЕ(Документ.Сторно.ПустаяСсылка)
	|				ИЛИ ДвиженияДокумента.Регистратор ЕСТЬ NULL)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПоступлениеУслугиИРаботы.Номенклатура,
	|		ПоступлениеУслугиИРаботы.КПС,
	|		ПоступлениеУслугиИРаботы.КФО,
	|		ПоступлениеУслугиИРаботы.КЭК,
	|		-ПоступлениеУслугиИРаботы.Количество,
	|		-ПоступлениеУслугиИРаботы.Всего
	|	ИЗ
	|		Документ.ПоступлениеУслугРабот.УслугиИРаботы КАК ПоступлениеУслугиИРаботы
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыПоступлений КАК ДокументыПоступлений
	|			ПО ПоступлениеУслугиИРаботы.Ссылка = ДокументыПоступлений.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ДвиженияДокумента
	|			ПО (ДокументыПоступлений.Сторно = ДвиженияДокумента.Регистратор)
	|				И (ДвиженияДокумента.НомерСтроки = 1)
	|	ГДЕ
	|		ДокументыПоступлений.Сторно = ЗНАЧЕНИЕ(Документ.Сторно.ПустаяСсылка)
	|		ИЛИ ДвиженияДокумента.Регистратор ЕСТЬ NULL
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ПоступлениеПоСчетамУчетаЗатратУслугиИРаботы.Номенклатура,
	|		ПоступлениеПоСчетамУчетаЗатратУслугиИРаботы.КПС,
	|		ПоступлениеПоСчетамУчетаЗатратУслугиИРаботы.КФО,
	|		ПоступлениеПоСчетамУчетаЗатратУслугиИРаботы.КЭК,
	|		-ПоступлениеПоСчетамУчетаЗатратУслугиИРаботы.Количество,
	|		-ПоступлениеПоСчетамУчетаЗатратУслугиИРаботы.Всего
	|	ИЗ
	|		Документ.ПоступлениеУслугРаботПоСчетамУчетаЗатрат.УслугиИРаботы КАК ПоступлениеПоСчетамУчетаЗатратУслугиИРаботы
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыПоступлений КАК ДокументыПоступлений
	|			ПО ПоступлениеПоСчетамУчетаЗатратУслугиИРаботы.Ссылка = ДокументыПоступлений.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ДвиженияДокумента
	|			ПО ДокументыПоступлений.Сторно = ДвиженияДокумента.Регистратор
	|			И ДвиженияДокумента.НомерСтроки = 1
	|	ГДЕ
	|		ДокументыПоступлений.Сторно = ЗНАЧЕНИЕ(Документ.Сторно.ПустаяСсылка)
	|		ИЛИ ДвиженияДокумента.Регистратор ЕСТЬ NULL) КАК НеисполненныеОбязательства
	|СГРУППИРОВАТЬ ПО
	|	НеисполненныеОбязательства.Номенклатура,
	|	ВЫРАЗИТЬ(НеисполненныеОбязательства.Номенклатура КАК Справочник.Номенклатура).СтавкаНДС,
	|	ВЫРАЗИТЬ(НеисполненныеОбязательства.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения,
	|	ВЫРАЗИТЬ(НеисполненныеОбязательства.Номенклатура КАК Справочник.Номенклатура).ТипНоменклатуры,
	|	ВЫРАЗИТЬ(НеисполненныеОбязательства.Номенклатура КАК Справочник.Номенклатура).ПрослеживаемыйТовар,
	|	ВЫРАЗИТЬ(НеисполненныеОбязательства.Номенклатура КАК Справочник.Номенклатура).СтранаПроисхождения,
	|	НеисполненныеОбязательства.КПС,
	|	НеисполненныеОбязательства.КФО,
	|	НеисполненныеОбязательства.КЭК,
	|	НеисполненныеОбязательства.Номенклатура.СчетУчета
	|
	|ИМЕЮЩИЕ
	|	СУММА(НеисполненныеОбязательства.Количество) > 0";
	
	Если Параметры.ПолучитьДанныеДоговора Тогда
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство.Организация КАК Организация,
		|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство.Контрагент КАК Контрагент,
		|	СрокиИсполненияИСуммыОбязательствСрезПоследних.Обязательство КАК ДокументОснование,
		|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ИФО,
		|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ВалютаРасчетов КАК ВалютаДокумента
		|ИЗ
		|	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(, Обязательство = &Обязательство) КАК
		|		СрокиИсполненияИСуммыОбязательствСрезПоследних";
	КонецЕсли;
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = Новый Структура;
	
	Если Параметры.ПолучитьДанныеДоговора Тогда
		ИндексДанныеДоговора = РезультатЗапроса.ВГраница();
		ДанныеДоговора = РезультатЗапроса[ИндексДанныеДоговора].Выгрузить();
		Результат.Вставить("ДанныеДоговора",
			ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(?(ДанныеДоговора.Количество() > 0,ДанныеДоговора[0], ДанныеДоговора.Добавить())));
		ИндекстОстаткиНФА = ИндексДанныеДоговора - 1;
	Иначе
		ИндекстОстаткиНФА = РезультатЗапроса.ВГраница();
	КонецЕсли;
	
	Результат.Вставить("ОстаткиНФА", РезультатЗапроса[ИндекстОстаткиНФА].Выгрузить());
	
	ОшибочныеСторно = РезультатЗапроса[ИндекстОстаткиНФА - 1].Выбрать();
	Если ОшибочныеСторно.Количество() > 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Обнаружены документы ""Сторно"" с заполненными исправительными проводками. Для правильного заполнения исправительные проводки нужно вносить документами поступления МЗ и услуг (работ)'"));
		Пока ОшибочныеСторно.Следующий() Цикл
			ОбщегоНазначения.СообщитьПользователю(ОшибочныеСторно.Сторно, ОшибочныеСторно.Сторно);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияОВалютеОбязательства(Знач Обязательство) Экспорт
	
	Сведения = Новый Структура;
	Сведения.Вставить("ВалютаРасчетов", ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета());
	Сведения.Вставить("ОплатаВРублях", Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ВалютаРасчетов КАК ВалютаРасчетов,
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних.ОплатаВРублях КАК ОплатаВРублях
	|ИЗ
	|	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(, Обязательство = &Обязательство) КАК СрокиИсполненияИСуммыОбязательствСрезПоследних";
	
	Запрос.УстановитьПараметр("Обязательство", Обязательство);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Сведения, Выборка);
	КонецЕсли;
	
	Возврат Сведения;
	
КонецФункции

Функция ИсполняемыйДоговорПоДоговоруСПоставщиком(Знач Договор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИсполняемыеДоговоры.Ссылка КАК ИсполняемыйДоговор
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК ИсполняемыеДоговоры
	|		ПО Договоры.ОтдельныйСчетДляРасчетовПоГОЗ = ИсполняемыеДоговоры.ОтдельныйСчетДляРасчетовПоГОЗ
	|			И Договоры.РазделЛицевогоСчета = ИсполняемыеДоговоры.РазделЛицевогоСчета
	|			И (ИсполняемыеДоговоры.КонтрактСУчастникомГОЗ)
	|			И (ИсполняемыеДоговоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
	|				ИЛИ ИсполняемыеДоговоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СОтправителемТрансферта))
	|ГДЕ
	|	Договоры.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ИсполняемыйДоговор = Выборка.ИсполняемыйДоговор;
	Иначе
		ИсполняемыйДоговор = Справочники.Договоры.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ИсполняемыйДоговор;
	
КонецФункции

Функция ИсполняемыйДоговорПоЛицевомуСчету(Знач ЛицевойСчет, Знач РазделЛицевогоСчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИсполняемыеДоговоры.Ссылка КАК ИсполняемыйДоговор
	|ИЗ
	|	Справочник.Договоры КАК ИсполняемыеДоговоры
	|ГДЕ
	|	ИсполняемыеДоговоры.ОтдельныйСчетДляРасчетовПоГОЗ = &ЛицевойСчет
	|	И ИсполняемыеДоговоры.РазделЛицевогоСчета = &РазделЛицевогоСчета
	|	И ИсполняемыеДоговоры.КонтрактСУчастникомГОЗ
	|	И (ИсполняемыеДоговоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
	|			ИЛИ ИсполняемыеДоговоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СОтправителемТрансферта))";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("РазделЛицевогоСчета", РазделЛицевогоСчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ИсполняемыйДоговор = Выборка.ИсполняемыйДоговор;
	Иначе
		ИсполняемыйДоговор = Справочники.Договоры.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ИсполняемыйДоговор;
	
КонецФункции

Процедура ВыполнитьКонтрольЦен(ДатаКонтроля, Объект, МассивСтрокКонтроляЦен, ИмяТЧ) Экспорт;

	МассивСтрокКВыделению = Новый Массив;
	
	ТипыНоменклатуры = УправлениеМатериальнымиЗапасами.ТипыНоменклатурыМатериальныеЗапасы();
	ТипыНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.Работа);
	ТипыНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
	ТипыНоменклатуры.Добавить(Перечисления.ТипыНоменклатуры.УслугиАренды);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура КАК Номенклатура,
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КПС КАК КПС,
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КФО КАК КФО,
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КЭК КАК КЭК,
	|	ПланФинансированияОбязательствСрезПоследних.Сумма / ПланФинансированияОбязательствСрезПоследних.Количество КАК Цена
	|ИЗ
	|	РегистрСведений.ПланФинансированияОбязательств.СрезПоследних(&ДатаКонтроля, Обязательство = &Обязательство) КАК ПланФинансированияОбязательствСрезПоследних
	|ГДЕ
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура ССЫЛКА Справочник.Номенклатура
	|	И ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура.ТипНоменклатуры В(&ТипНоменклатуры)
	|	И КОНЕЦПЕРИОДА(ПланФинансированияОбязательствСрезПоследних.КлючАналитики.ПериодПлана.ДатаОкончания, ДЕНЬ) >= &ДатаКонтроля
	|	И НАЧАЛОПЕРИОДА(ПланФинансированияОбязательствСрезПоследних.КлючАналитики.ПериодПлана.ДатаНачала, ДЕНЬ) <= &ДатаКонтроля
	|	И ПланФинансированияОбязательствСрезПоследних.Количество > 0";
	
	Запрос.УстановитьПараметр("ДатаКонтроля", ДатаКонтроля);
	Запрос.УстановитьПараметр("Обязательство", Объект.Договор);
	Запрос.УстановитьПараметр("ТипНоменклатуры", ТипыНоменклатуры);
	
	ТаблицаПлан = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаПлан.Количество() Тогда
		
		ТаблицаПлан.Индексы.Добавить("Номенклатура, КПС, КФО, КЭК");
		
		ЕстьКПСРасчетов     = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "КПСРасчетов");
		ЕстьКПСРасчетовТЧ   = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "НесколькоКПСРасчетов");
		ЕстьПодходящаяНоменклатура = Ложь;
		ОшибкиКонтроля = Неопределено;
		
		СтруктураПоискаЦена = Новый Структура ("Номенклатура, КПС, КФО, КЭК");
		
		Для Каждого СтрокаМатериалы Из Объект[ИмяТЧ] Цикл
			ЗаполнитьЗначенияСвойств(СтруктураПоискаЦена, СтрокаМатериалы);
			Если ЕстьКПСРасчетовТЧ И ЕстьКПСРасчетов Тогда
				СтруктураПоискаЦена.КПС = ?(Объект.НесколькоКПСРасчетов, СтрокаМатериалы.КПСРасчетов, Объект.КПСРасчетов);
			КонецЕсли;
			
			СтрокиЦен = ТаблицаПлан.НайтиСтроки(СтруктураПоискаЦена);
			
			Если СтрокиЦен.Количество() И СтрокаМатериалы.Количество > 0 Тогда
				ЦенаПГФ    = СтрокиЦен[СтрокиЦен.Количество()-1].Цена;
				ЦенаСтрока = СтрокаМатериалы.Всего/СтрокаМатериалы.Количество;
				Погрешность = ЦенаПГФ - ЦенаСтрока;
				СтрокаМатериалы.ЦенаОтличается = Макс(Погрешность, -Погрешность) > 0.02;
				ЕстьПодходящаяНоменклатура = Истина;
			КонецЕсли;
			
			Если СтрокаМатериалы.ЦенаОтличается Тогда
				
				МассивСтрокКВыделению.Добавить(СтрокаМатериалы.ПолучитьИдентификатор());
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'В строке %1 для номенклатуры ""%2"" цена по документу - %3,  цена по плану-графику - %4.'"),
					СтрокаМатериалы.НомерСтроки, СтрокаМатериалы.Номенклатура, Формат(ЦенаСтрока, "ЧЦ=18; ЧДЦ=2; ЧРД='.'"),
					Формат(ЦенаПГФ, "ЧЦ=18; ЧДЦ=2; ЧРД='.'"));
					
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
					ОшибкиКонтроля,
					"Объект.Материалы[%1].Сумма",
					ТекстСообщения,
					,
					,
					,
					Объект[ИмяТЧ].Индекс(СтрокаМатериалы));
				
			КонецЕсли;
			
		КонецЦикла;
		
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(ОшибкиКонтроля);
		МассивСтрокКонтроляЦен = Новый ФиксированныйМассив(МассивСтрокКВыделению);
		
		Если НЕ ЕстьПодходящаяНоменклатура Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'В плане-графике нет номенклатуры, введенной в документе, по соответствующим КФО,КПС,КЭК, за период даты %1.'"), Формат(ДатаКонтроля, "ДЛФ=D"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Иначе
			Если ОшибкиКонтроля = Неопределено Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Контроль цен пройден.'"), Формат(ДатаКонтроля, "ДЛФ=D"));
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'План-график финансирования с предметом договора на период, включающий дату %1, отсутствует.'"), Формат(ДатаКонтроля, "ДЛФ=D"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

