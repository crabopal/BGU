Функция ПолучитьДейстующийДокументОбязательствоУчетПредмета(ЗНАЧ Обязательство) Экспорт 
	
	Результат = Новый Структура("ПервичныйДокумент, ДействующийДокумент, ДействующийДокументДата");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	МАКСИМУМ(Данные.ДействующийДокумент) КАК ДействующийДокумент,
	               |	МАКСИМУМ(Данные.ДействующийДокументДата) КАК ДействующийДокументДата,
	               |	МАКСИМУМ(Данные.ПервичныйДокумент) КАК ПервичныйДокумент
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		Действующий.Регистратор КАК ДействующийДокумент,
	               |		Действующий.Регистратор.Дата КАК ДействующийДокументДата,
	               |		NULL КАК ПервичныйДокумент,
	               |		1 КАК ГруппировочноеПоле
	               |	ИЗ
	               |		РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(, Обязательство = &Договор) КАК Действующий
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		NULL,
	               |		NULL,
	               |		Первичный.Регистратор,
	               |		1
	               |	ИЗ
	               |		РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПервых(, Обязательство = &Договор) КАК Первичный) КАК Данные
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Данные.ГруппировочноеПоле";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Договор", Обязательство);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);		
	КонецЕсли; 
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьУчетныйНомерОбязательства(Обязательство) Экспорт 
	
	Результат = "";
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	УчетныеНомераОбязательств.УчетныйНомерОбязательства
	               |ИЗ
	               |	РегистрСведений.УчетныеНомераОбязательств КАК УчетныеНомераОбязательств
	               |ГДЕ
	               |	УчетныеНомераОбязательств.Обязательство = &Обязательство";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Обязательство", Обязательство);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.УчетныйНомерОбязательства;		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции  

Функция ПолучитьИГК(Обязательство) Экспорт  
	
	Результат = "";
	
	// ИГК по данным ЕИС
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ГосударственныеКонтрактыЕИС.НомерИГК КАК ИГК
	|ИЗ
	|	Справочник.ГосударственныеКонтрактыЕИС КАК ГосударственныеКонтрактыЕИС
	|ГДЕ
	|	ГосударственныеКонтрактыЕИС.ВладелецКонтракта = &Обязательство");
	Запрос.УстановитьПараметр("Обязательство", Обязательство);
	Выборка = Запрос.Выполнить().Выбрать();  
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ИГК;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		// ИГК из характеристик обязательства
		Результат = РаботаСОбязательствами.ЗначениеХарактеристикиОбязательства(Обязательство,, ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыХарактеристикОбязательства.ИдентификаторКонтракта"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьДейстующийДокументОбязательствоБезПредмета(ЗНАЧ Обязательство, ЗНАЧ ДокументОснованиеСсылка, КоличествоВызовов = 0) Экспорт 
	
	Если КоличествоВызовов > 100 Тогда
		
		// Для определения действующего и первичного документа может возникнуть глубокая рекурсия вызовов
		// Такая ситуация может возникнуть, например, если существует следующая цепочка документов:
		// Принятое обязательство - проведен
		// - Заявка на изменение обязательства - не проведен
		// -- Заявка на изменение обязательства - не проведен
		// В этом случае, при определении статуса (недейстующий документ) и получениия ссылки на действующий документ 
		// необходимо проверить документ основание. Но, т.к. документ-основание также не проведен и не имеет записей в регистре - требуется 
		// проверить выше стоящий документ (принятое обязательство)
		// Таким образом, если количество подобных документов > 100 - будет вызвано исключение (для реальной ситуации маловерятное значение)
		
		ВызватьИсключение "Вложенность вызовов превысила допустимое значение! (Определение действующего документа для договора " + Обязательство;
		
	КонецЕсли; 
	
	Результат = Новый Структура("ПервичныйДокумент, ДействующийДокумент, ДействующийДокументДата");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СрокиИсполненияИСуммыОбязательств.ПервичныйДокумент
	               |ПОМЕСТИТЬ ДанныеОснования
	               |ИЗ
	               |	РегистрСведений.СрокиИсполненияИСуммыОбязательств КАК СрокиИсполненияИСуммыОбязательств
	               |ГДЕ
	               |	СрокиИсполненияИСуммыОбязательств.Регистратор = &Основание
	               |	И СрокиИсполненияИСуммыОбязательств.Обязательство = &Обязательство
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СрокиИсполненияИСуммыОбязательствСрезПоследних.Регистратор КАК ДействующийДокумент,
	               |	СрокиИсполненияИСуммыОбязательствСрезПоследних.Период КАК ДействующийДокументДата,
	               |	СрокиИсполненияИСуммыОбязательствСрезПоследних.ПервичныйДокумент
	               |ИЗ
	               |	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(
	               |			,
	               |			Обязательство = &Обязательство
	               |				И ПервичныйДокумент В
	               |					(ВЫБРАТЬ
	               |						ДанныеОснования.ПервичныйДокумент
	               |					ИЗ
	               |						ДанныеОснования КАК ДанныеОснования)) КАК СрокиИсполненияИСуммыОбязательствСрезПоследних";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Обязательство", Обязательство);
	Запрос.УстановитьПараметр("Основание", ДокументОснованиеСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(Результат, Выборка);		
		
	Иначе
		
		Если ДокументОснованиеСсылка.Пустая() Тогда
			// Ничего не делаем
		Иначе
			
			ОснованиеОснования =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснованиеСсылка, "Основание");
			Результат = ПолучитьДейстующийДокументОбязательствоБезПредмета(Обязательство, ОснованиеОснования, КоличествоВызовов + 1);	
			
		КонецЕсли; 
		
	КонецЕсли; 
		
	Возврат Результат;

КонецФункции

Функция ПолучитьДанныеСуммыОплатПоОбязательству(ЗНАЧ Организация, ЗНАЧ Обязательство) Экспорт 
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	Договоры.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ МассивДоговоров
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|ГДЕ
	|	Договоры.Ссылка В ИЕРАРХИИ(&Договор)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Счета_1
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК СчетаЕПСБУ
	|ГДЕ
	|	СчетаЕПСБУ.Ссылка В(&Счета1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Счета_2
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК СчетаЕПСБУ
	|ГДЕ
	|	СчетаЕПСБУ.Ссылка В(&Счета2)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Кредит.Период КАК Период,
	|	Кредит.Сумма КАК Кредит,
	|	0 КАК Дебет,
	|	Кредит.Регистратор КАК Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(Кредит.Регистратор) КАК РегистраторПредставление,
	|	Кредит.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	Кредит.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	Кредит.НомерПервичногоДокумента КАК НомерПервичногоДокумента
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Организация = &Организация
	|				И СубконтоДт2 В
	|					(ВЫБРАТЬ
	|						МассивДоговоров.Ссылка
	|					ИЗ
	|						МассивДоговоров КАК МассивДоговоров)
	|				И СчетДт В
	|					(ВЫБРАТЬ
	|						Счета_1.Ссылка
	|					ИЗ
	|						Счета_1 КАК Счета_1)
	|				И СчетКт В
	|					(ВЫБРАТЬ
	|						Счета_2.Ссылка
	|					ИЗ
	|						Счета_2 КАК Счета_2),
	|			,
	|			) КАК Кредит
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Дебет.Период,
	|	0,
	|	Дебет.Сумма,
	|	Дебет.Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(Дебет.Регистратор),
	|	Дебет.ВидПервичногоДокумента,
	|	Дебет.ДатаПервичногоДокумента,
	|	Дебет.НомерПервичногоДокумента
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Организация = &Организация
	|				И СубконтоКт2 В
	|					(ВЫБРАТЬ
	|						МассивДоговоров.Ссылка
	|					ИЗ
	|						МассивДоговоров КАК МассивДоговоров)
	|				И СчетКт В
	|					(ВЫБРАТЬ
	|						Счета_1.Ссылка
	|					ИЗ
	|						Счета_1 КАК Счета_1)
	|				И СчетДт В
	|					(ВЫБРАТЬ
	|						Счета_2.Ссылка
	|					ИЗ
	|						Счета_2 КАК Счета_2),
	|			,
	|			) КАК Дебет
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";	
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Договор"		, Обязательство);
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("Счета1"		, БухгалтерскийУчет.СписокСчетов("206.00,302.00"));
	Запрос.УстановитьПараметр("Счета2"		, БухгалтерскийУчет.СписокСчетов("201.00,304.05"));
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция ПолучитьДанныеПоставокОплатПоОбязательству(ЗНАЧ Организация, ЗНАЧ Обязательство) Экспорт 
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	Договоры.Ссылка
	|ПОМЕСТИТЬ МассивДоговоров
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|ГДЕ
	|	Договоры.Ссылка В ИЕРАРХИИ(&Договор)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Кредит_302.Период КАК Период,
	|	Кредит_302.Сумма КАК Сумма,
	|	Кредит_302.Регистратор,
	|	ПРЕДСТАВЛЕНИЕ(Кредит_302.Регистратор) КАК РегистраторПредставление,
	|	Кредит_302.ВидПервичногоДокумента,
	|	Кредит_302.ДатаПервичногоДокумента,
	|	Кредит_302.НомерПервичногоДокумента,
	|	ВЫБОР
	|		КОГДА Кредит_302.СчетДт.Количественный
	|			ТОГДА Кредит_302.КоличествоДт
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
