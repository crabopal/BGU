
////////////////////////////////////////////////////////////////////////////////
// Бюджетная отчетность (клиент-сервер):
//
//          Реализация общей логики редактирования данных отчетности
//          в различных режимах запуска
//  
////////////////////////////////////////////////////////////////////////////////


////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Функция ПолучитьПеречислениеПериодичность(ИмяПериода, ВернутьИмя = Истина) Экспорт 
		
	Если БюджетнаяОтчетностьКлиентСервер.ТекущаяКонфигурация() = "БГУ1" Тогда
	
		ИмяПеречисления  = "ПериодичностьОтчетов";
		
	Иначе 
		
		ИмяПеречисления  = "Периодичность";
		
	КонецЕсли;	
	
	Результат = "Перечисление."+ИмяПеречисления+"."+ИмяПериода;
	
	Если ВернутьИмя Тогда
		Возврат Результат;
		
	Иначе 
		Возврат ПредопределенноеЗначение(Результат);
		
	КонецЕсли;	
	
КонецФункции