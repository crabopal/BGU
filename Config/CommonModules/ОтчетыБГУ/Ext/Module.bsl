////////////////////////////////////////////////////////////////////////////////
// Серверные события формы отчета.
//
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// В данной процедуре следует описать дополнительные зависимости объектов метаданных
//   конфигурации, которые будут использоваться для связи настроек отчетов.
//
// Параметры:
//   СвязиОбъектовМетаданных - ТаблицаЗначений - Таблица связей.
//       * ПодчиненныйРеквизит - Строка - Имя реквизита подчиненного объекта метаданных.
//       * ПодчиненныйТип      - Тип    - Тип подчиненного объекта метаданных.
//       * ВедущийТип          - Тип    - Тип ведущего объекта метаданных.
//
Процедура ДополнитьСвязиОбъектовМетаданных(СвязиОбъектовМетаданных) Экспорт
	
	
	
КонецПроцедуры

// Вызывается в форме отчета перед выводом настройки.
//
// Параметры:
//   Форма - УправляемаяФорма, Неопределено - Форма отчета.
//   СвойстваНастройки - Структура - Описание настройки отчета, которая будет выведена в форме отчета.
//       * ОписаниеТипов - ОписаниеТипов -
//           Тип настройки.
//       * ЗначенияДляВыбора - СписокЗначений -
//           Объекты, которые будут предложены пользователю в списке выбора.
//           Дополняет список объектов, уже выбранных пользователем ранее.
//       * ЗапросЗначенийВыбора - Запрос -
//           Возвращает объекты, которыми необходимо дополнить ЗначенияДляВыбора.
//           Первой колонкой (с 0м индексом) должен выбираться объект,
//           который следует добавить в ЗначенияДляВыбора.Значение.
//           Для отключения автозаполнения
//           в свойство ЗапросЗначенийВыбора.Текст следует записать пустую строку.
//       * ОграничиватьВыборУказаннымиЗначениями - Булево -
//           Когда Истина, то выбор пользователя будет ограничен значениями,
//           указанными в ЗначенияДляВыбора (его конечным состоянием).
//
Процедура ПриОпределенииПараметровВыбора(Форма, СвойстваНастройки) Экспорт
	
КонецПроцедуры

// Вызывается в обработчике одноименного события формы отчета после выполнения кода формы.
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   Отказ - Передается из параметров обработчика "как есть".
//   СтандартнаяОбработка - Передается из параметров обработчика "как есть".
//
// См. также:
//   "УправляемаяФорма.ПриСозданииНаСервере" в синтакс-помощнике.
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
 	НеДобавлятьКомандыРегистраУчета = Ложь;
	
	Если ЕстьРеквизитФормы(Форма, "НастройкиОтчета") И ТипЗнч(Форма.НастройкиОтчета) = Тип("Структура") Тогда
		ОтчетыСКомандамиРегистровУчета = Новый Массив;
		ОтчетыСКомандамиРегистровУчета.Добавить("Отчет.КарточкаКапвложений61н"); 
		ОтчетыСКомандамиРегистровУчета.Добавить("Отчет.ИнвентарнаяКарточка61н"); 
		ОтчетыСКомандамиРегистровУчета.Добавить("Отчет.КарточкаУчетаПраваПользованияНФА"); 
		Если ОтчетыСКомандамиРегистровУчета.Найти(СокрЛП(Форма.НастройкиОтчета.ПолноеИмя)) = Неопределено Тогда
			Форма.НастройкиОтчета.Свойство("Контекстный", НеДобавлятьКомандыРегистраУчета); 
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ НеДобавлятьКомандыРегистраУчета И Форма.Параметры.Свойство("НеДобавлятьКомандыРегистраУчета") Тогда
		НеДобавлятьКомандыРегистраУчета = Истина;
	КонецЕсли;	
	
	Если НеДобавлятьКомандыРегистраУчета = Ложь Тогда
		РегистрыУчета.ПриСозданииНаСервере(Форма, "ОсновнаяКоманднаяПанель");
	Конецесли;	
	
	//Расшифровка стандартными отчетами
	МетаданныеОтчета = Метаданные.НайтиПоПолномуИмени(Форма.НастройкиОтчета.ПолноеИмя);
	
	Если НЕ МетаданныеОтчета = Неопределено И НЕ МетаданныеОтчета.Реквизиты.Найти("ДоступнаРасшифровкаСтандартнымиОтчетами") = Неопределено Тогда
		Если НЕ ЕстьРеквизитФормы(Форма, "ДанныеРасшифровки") Тогда 
			ДобавляемыеРеквизиты = Новый Массив;
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДанныеРасшифровки", 	Новый ОписаниеТипов("Строка")));
			Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
			Если ЕстьРеквизитФормы(Форма, "ПостоянныеРеквизиты") Тогда
				Форма.ПостоянныеРеквизиты.Добавить("ДанныеРасшифровки");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Форма.НастройкиОтчета.ПолноеИмя = "Отчет.УниверсальныйОтчет" Тогда
		Если НЕ ЕстьРеквизитФормы(Форма, "НеВыводитьПодвал") Тогда 
			ДобавляемыеРеквизиты = Новый Массив;
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("НеВыводитьПодвал", Новый ОписаниеТипов("Булево"),, "Не выводить подвал", Истина));
			Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
			ПолеВвода = Форма.Элементы.Добавить("ФормаАдресДоставки", Тип("ПолеФормы"), Форма);
			ПолеВвода.Вид = ВидПоляФормы.ПолеФлажка;
			ПолеВвода.ПутьКДанным = "НеВыводитьПодвал";
		КонецЕсли;
		Форма.НеВыводитьПодвал = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("УниверсальныйОтчет_НеВыводитьПодвал", "", Ложь);
	КонецЕсли;
		
	// Создадим служебный реквизит ОбъектыПечати, который можно заполнить соответствием между объектами, по которым
	// формируется отчеты и именованными областями результирующего табличного документа.
	// Заполнение можно выполнить в обработчике ПриКомпоновкеРезультата модуля объекта отчета
	// Этим реквизитом можно впоследствии воспользоваться в форме отчета, например, при формировании регистров учета
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ОбъектыПечати", Новый ОписаниеТипов("СписокЗначений")));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);	
КонецПроцедуры

// Вызывается при формировании выпадающего меню расшифровки, содержащего расшифровку стандартными отчетами.
// Если в структуре ДанныеОтчета нет ключа НачалоПериода или КонецПериода, то будет призведена попытка заполнения
// начала и конца периода из массива МассивПолей. Таким образом, для каждой ячейки отчета можно задать произвольный период
// для расшифровки стандартным отчетом.
// В структуре ДанныеОтчета может быть ключ МассивРазрешенныхОтборов, типа массив. В массиве задаются имена полей,
// по которым возможен отбор. Остальные поля игнорируются. Если ключ МассивРазрешенныхОтборов не определен, то в
// отборе будут использованы все поля.
//
// Параметры:
//   ИДРасшифровки - Строка - Имя стандартного отчета, который будет вызван.
//   МассивПолей - МассивПолей - Массив значений полей расшифровки компоновки данных и элементов отбора компоновки данных.
//   ДанныеОтчета - Структура - Описание свойств отчета для расшифровки, определяется в модуле менеджера отчета в функции
//   СвойстваОбъектаДляРасшифровкиСтандартнымиОтчетами().
//   Счет - Счет ЕПСБУ - Счет, по которому будет сформированы стандартные отчеты.
//   КорСчет - Счет ЕПСБУ - Кор. счет, может быть передан в стандартный отчет.
//
Функция НастройкиДляДополнительнойРасшифровки(ИДРасшифровки, МассивПолей, ДанныеОтчета, Счет, КорСчет) Экспорт
	Перем НачалоПериодаИзПолей; // начало периода из параметра МассивПолей
	Перем КонецПериодаИзПолей; // конец периода из параметра МассивПолей
	
	Период = Неопределено;
	
	Для Каждого Элемент Из МассивПолей Цикл
		Если ТипЗнч(Элемент) = Тип("ЗначениеПоляРасшифровкиКомпоновкиДанных") Тогда
			Если Элемент.Поле = "Период" Тогда
				Период = Элемент.Значение;
			ИначеЕсли Элемент.Поле = "НачалоПериода" Тогда
				НачалоПериодаИзПолей = Элемент.Значение;
			ИначеЕсли Элемент.Поле = "КонецПериода" Тогда
				КонецПериодаИзПолей = Элемент.Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	ПользовательскиеОтборы = ПользовательскиеНастройки.Элементы.Добавить(Тип("ОтборКомпоновкиДанных"));
	ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;
	
	ПользовательскиеОтборы.ИдентификаторПользовательскойНастройки = "Отбор";
	
	ДополнительныеСвойства.Вставить("РежимРасшифровки", Истина);
	
	ДополнительныеСвойства.Вставить("Счет", Счет);
	ДополнительныеСвойства.Вставить("КорСчет", КорСчет);
	
	Если ДанныеОтчета.Свойство("Организация") Тогда
		ДополнительныеСвойства.Вставить("Организация", ДанныеОтчета.Организация);
	КонецЕсли;
	
	Если ИДРасшифровки = "АнализСчета" Тогда
		Если ЗначениеЗаполнено(КорСчет) Тогда
			СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "КорСчет", КорСчет, ВидСравненияКомпоновкиДанных.ВИерархии);
		КонецЕсли;
		ДополнительныеСвойства.Вставить("ПоСубсчетамКорСчетов", Истина);
	ИначеЕсли ИДРасшифровки = "ОборотыСчета" тогда
		ДополнительныеСвойства.Вставить("СальдоНаНачалоДт", Истина);
		ДополнительныеСвойства.Вставить("СальдоНаНачалоКт", Истина);
		ДополнительныеСвойства.Вставить("СальдоНаКонецДт", Истина);
		ДополнительныеСвойства.Вставить("СальдоНаКонецКт", Истина);
		ДополнительныеСвойства.Вставить("ОборотыЗаПериодДт", Истина);
		ДополнительныеСвойства.Вставить("ОборотыЗаПериодКт", Истина);
		ДополнительныеСвойства.Вставить("ОборотыСоСчетамиДт", Истина);
		ДополнительныеСвойства.Вставить("ОборотыСоСчетамиКт", Истина);
		ДополнительныеСвойства.Вставить("ПоСубсчетамКорСчетов", Истина);
		ДополнительныеСвойства.Вставить("Периодичность", 9);
		ДополнительныеСвойства.Вставить("ПоСубсчетам", Истина);
	ИначеЕсли ИДРасшифровки = "АнализСубконто" Тогда
		ДополнительныеСвойства.Вставить("СписокВидовСубконто", ДанныеОтчета.СписокВидовСубконто.Скопировать());
		ДополнительныеСвойства.Вставить("ЕстьСчета", Истина);
		ДополнительныеСвойства.Вставить("ПоСубсчетам", Истина);
	ИначеЕсли ИДРасшифровки = "КарточкаСубконто" Тогда
		ДополнительныеСвойства.Вставить("СписокВидовСубконто", ДанныеОтчета.СписокВидовСубконто.Скопировать());
		ДополнительныеСвойства.Вставить("ЕстьСчета", Истина);
		ДополнительныеСвойства.Вставить("ПоСубсчетам", Истина);
	ИначеЕсли ИДРасшифровки = "ОборотыСчетаПоДням" Тогда
		ДополнительныеСвойства.Вставить("Периодичность", 6);
	ИначеЕсли ИДРасшифровки = "ОборотыСчетаПоМесяцам" Тогда
		ДополнительныеСвойства.Вставить("Периодичность", 9);
	//ИначеЕсли ИДРасшифровки = "ЖурналОпераций0504071" Тогда
	//	ДополнительныеСвойства.Вставить("НомерЖурнала", НомерЖурнала);
	КонецЕсли;
	
	ЕстьРазрешенныеПоляОтборов = ДанныеОтчета.Свойство("МассивРазрешенныхОтборов");
	
	СписокПолейОтборов = Новый Массив;
	Для каждого Отбор из МассивПолей Цикл
		Если ТипЗнч(Отбор) = Тип("ЗначениеПоляРасшифровкиКомпоновкиДанных") тогда
			Если Отбор.Значение = NULL тогда
				Продолжить;
			КонецЕсли;
			Если ЕстьРазрешенныеПоляОтборов Тогда
				// Задан массив полей, которые могут использоваться в отборах.
				// Все остальные поля игнорируются.
				Если ДанныеОтчета.МассивРазрешенныхОтборов.Найти(Отбор.Поле) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			НомерСубконтоДоговоры = 0;
			НомерСубконтоРазделыЛицевыхСчетов = 0;
			ОтборДобавлен = Истина;
			Если Отбор.Поле = "Организация" Тогда
				ДополнительныеСвойства.Вставить("Организация", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "Показатель" Тогда
				Показатель = Отбор.Значение;
			ИначеЕсли (Отбор.Поле = "Регистратор" или Отбор.Поле = "Период") И ИДРасшифровки = "КарточкаСчета" Тогда
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, Отбор.Поле, Отбор.Значение);
			ИначеЕсли Отбор.Поле = "Документ" И (ИДРасшифровки = "КарточкаСчета" ИЛИ ИДРасшифровки = "КарточкаСубконто") Тогда
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Регистратор", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "КПС" Тогда 
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "КПС", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "КЭК" Тогда 
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "КЭК", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "ИФО" Тогда 
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "ИФО", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "Подразделение" Тогда 
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Подразделение", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "КФО" Тогда 
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "КФО", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "Валюта" Тогда 
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Валюта", Отбор.Значение);
			ИначеЕсли ЗначениеЗаполнено(Счет) Тогда
				ОтборДобавлен = Ложь;
				Для Сч = 0 по Счет.ВидыСубконто.Количество()-1 Цикл
					ТипСубконто = Счет.ВидыСубконто[Сч].ВидСубконто.ТипЗначения;
					Если ТипСубконто.СодержитТип(Тип("СправочникСсылка.Договоры")) Тогда
						НомерСубконтоДоговоры = Сч+1;
					КонецЕсли;
					Если ТипСубконто.СодержитТип(Тип("СправочникСсылка.РазделыЛицевыхСчетов")) Тогда
						НомерСубконтоРазделыЛицевыхСчетов = Сч+1;
					КонецЕсли;
					Если ТипСубконто.СодержитТип(ТипЗнч(Отбор.Значение)) Тогда
						Если Отбор.Иерархия Тогда
							СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто"+(Сч+1), Отбор.Значение, ВидСравненияКомпоновкиДанных.ВИерархии);
						ИначеЕсли ЗначениеЗаполнено(Отбор.Значение) Тогда
							СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто"+(Сч+1), Отбор.Значение);
						Иначе
							СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто"+(Сч+1), Отбор.Значение, ВидСравненияКомпоновкиДанных.НеЗаполнено);
						КонецЕсли;
						ОтборДобавлен = Истина;
					КонецЕсли;
				КонецЦикла;
				Если ОтборДобавлен Тогда
					Продолжить;
				КонецЕсли;
			ИначеЕсли ИДРасшифровки = "АнализСубконто" ИЛИ ИДРасшифровки = "КарточкаСубконто" Тогда
				ОтборДобавлен = Ложь;
				Для Сч = 0 по ДанныеОтчета.СписокВидовСубконто.Количество()-1 Цикл
					ТипСубконто = ДанныеОтчета.СписокВидовСубконто[Сч].Значение.ТипЗначения;
					Если ТипСубконто.СодержитТип(ТипЗнч(Отбор.Значение)) Тогда
						Если Отбор.Иерархия Тогда
							СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто"+(Сч+1), Отбор.Значение, ВидСравненияКомпоновкиДанных.ВИерархии);
						Иначе
							СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто"+(Сч+1), Отбор.Значение);
						КонецЕсли;
						ОтборДобавлен = Истина;
					КонецЕсли;
				КонецЦикла;
				Если ОтборДобавлен Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				ОтборДобавлен = Ложь;
			КонецЕсли;
			//Если Отбор.Поле = "Обязательство" Тогда
			//	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто2", Отбор.Значение);
			Если Отбор.Поле = "Контрагент"
				И НомерСубконтоДоговоры > 0 Тогда
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто"+НомерСубконтоДоговоры+".Контрагент", Отбор.Значение);
			//ИначеЕсли Отбор.Поле = "РазделЛицевогоСчета" или Отбор.Поле = "Номенклатура" Тогда
			//	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто1", Отбор.Значение);
			ИначеЕсли Отбор.Поле = "ЛицевойСчет"
				И ТипЗнч(Отбор.Значение) = Тип("СправочникСсылка.ЛицевыеСчета")
				И НомерСубконтоРазделыЛицевыхСчетов > 0 Тогда
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, "Субконто"+НомерСубконтоРазделыЛицевыхСчетов+".Владелец", Отбор.Значение);
			//ИначеЕсли НЕ ОтборДобавлен Тогда
			//	Если Отбор.Иерархия Тогда
			//		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, Отбор.Поле, Отбор.Значение, ВидСравненияКомпоновкиДанных.ВИерархии);
			//	Иначе
			//		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, Отбор.Поле, Отбор.Значение);
			//	КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Если Отбор.Представление = "###ОтборПоОрганизацияСОП###" Тогда
				Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
					Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация") Тогда
						ДополнительныеСвойства.Вставить("Организация"                      , Отбор.ПравоеЗначение);
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли Отбор.Представление = "###Контроль###" Тогда
			КонецЕсли;
		ИначеЕсли ТипЗнч(Отбор) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если СписокПолейОтборов.Найти(Строка(Отбор.ЛевоеЗначение)) = Неопределено Тогда
				Если Отбор.Представление = "###ОтборПоОрганизация###" ИЛИ Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация") Тогда
					ДополнительныеСвойства.Вставить("Организация", Отбор.ПравоеЗначение);
				ИначеЕсли Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Подразделение") Тогда
					ДополнительныеСвойства.Вставить("Подразделение", Отбор.ПравоеЗначение);
				Иначе
					СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ПользовательскиеОтборы, Отбор.ЛевоеЗначение, Отбор.ПравоеЗначение, Отбор.ВидСравнения);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ДанныеОтчета.Свойство("НачалоПериода") И ДанныеОтчета.Свойство("КонецПериода") Тогда
		ДополнительныеСвойства.Вставить("НачалоПериода", ДанныеОтчета.НачалоПериода);
		ДополнительныеСвойства.Вставить("КонецПериода" , ДанныеОтчета.КонецПериода);
	Иначе
		ДополнительныеСвойства.Вставить("НачалоПериода", НачалоПериодаИзПолей);
		ДополнительныеСвойства.Вставить("КонецПериода" , КонецПериодаИзПолей);
	КонецЕсли;
	//ДополнительныеСвойства.Вставить("Организация" , ДанныеОтчета.Организация);
	
	//ДополнительныеСвойства.Вставить("ПоказательСумма", Истина);
	ДополнительныеСвойства.Вставить("ПоказательБУ", Истина);
	Если ЗначениеЗаполнено(Счет) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет,"Количественный") Тогда
		ДополнительныеСвойства.Вставить("ПоказательКоличество", Истина);
	КонецЕсли;
	
	Возврат ПользовательскиеНастройки;
	
КонецФункции

Процедура УстановитьПериодВПараметрахДанных(Форма, НовыеНастройкиКД) Экспорт

	Если Форма.Параметры.Свойство("Период") И ЗначениеЗаполнено(Форма.Параметры.Период) Тогда
		
		ПараметрыДанныхЭлементы = Форма.Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы;
		ПараметрПериод = ПараметрыДанныхЭлементы.Найти("Период");
		Если ТипЗнч(ПараметрПериод) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
			ПараметрПериод.Использование = Истина;
			ПараметрПериод.Значение = Форма.Параметры.Период;
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры	

Процедура УстановитьПериодВПользовательскихНастройках(Форма, НовыеНастройкиКД) Экспорт

	ПараметрПериод = Форма.Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Период");
	Если ТипЗнч(ПараметрПериод) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
		НастройкаПериод = Форма.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрПериод.ИдентификаторПользовательскойНастройки);
		Если ТипЗнч(НастройкаПериод) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
			НастройкаПериод.Использование = Истина;
			НастройкаПериод.Значение = ПараметрПериод.Значение;
		КонецЕсли;
	КонецЕсли;	

КонецПроцедуры	

Процедура ВывестиПодписьИсполнителя(НастройкиОтчета, ОтчетТабличныйДокумент, ОтчетСформирован) Экспорт
	
	ЭлементыОтбора = НастройкиОтчета.СвойстваРезультата.ИтоговыеНастройки.Отбор.Элементы;
	
	Организация = "";  
	Исполнитель =  "";
	Пользователь = Пользователи.АвторизованныйПользователь();
	
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл 
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И
			ЭлементОтбора.Использование И  
			ЭлементОтбора.ЛевоеЗначение = Новый	ПолеКомпоновкиДанных("Организация")
			И ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение)
			Тогда
			Организация = ЭлементОтбора.ПравоеЗначение;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Исполнитель = ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(Пользователь, Организация);
	КонецЕсли;	
	
	ДанныеСотрудника = Новый Структура;
	ДанныеСотрудника.Вставить("Должность", "");
	ДанныеСотрудника.Вставить("НаименованиеПолное", "");
	
	Если ЗначениеЗаполнено(Исполнитель) Тогда
		ДанныеСотрудника.Вставить("СсылкаНаОбъект", Исполнитель); 
		ДанныеСотрудника.Вставить("Период", ТекущаяДатаСеанса());
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, Истина);
		ДанныеСотрудника.Вставить("ФИО", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника.НаименованиеПолное));
		ДанныеСотрудника.Вставить("ТелефонИсполнителя", ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
		ДанныеСотрудника.Вставить("ЭлектроннаяПочтаИсполнителя", ДанныеСотрудника.EmailФизическиеЛица); 
	КонецЕсли;
	
	Макет = ПолучитьОбщийМакет("ПФ_MXL_ОбщиеОбластиСтандартногоОтчета");
	ОбластьПодписи = Макет.ПолучитьОбласть("ПодписьИсполнителя");
	ОбластьПодписи.Параметры.Заполнить(ДанныеСотрудника);
	ОтчетТабличныйДокумент.Вывести(ОбластьПодписи);
	
КонецПроцедуры	

Процедура ВывестиПодписьИсполнителяВОтчетСКД(КомпоновщикНастроек) Экспорт
	
	ИмяГруппировкиИсполнитель = "Исполнитель";
	
	ПараметрВывестиИсполнителя = ОтчетыКлиентСервер.НайтиПараметр(КомпоновщикНастроек.Настройки,
		КомпоновщикНастроек.ПользовательскиеНастройки, "ВывестиИсполнителя");
	
	ВывестиИсполнителя = ?(ПараметрВывестиИсполнителя = Неопределено, Ложь, ПараметрВывестиИсполнителя.Использование);
	
	Если ВывестиИсполнителя Тогда
		
		НайденаГруппировка = Ложь;
		Для Каждого ЭлементСтруктуры Из КомпоновщикНастроек.Настройки.Структура Цикл
			Если ЭлементСтруктуры.Имя = ИмяГруппировкиИсполнитель Тогда
				ЭлементСтруктуры.Использование = Истина;
				НайденаГруппировка = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ НайденаГруппировка Тогда
			ГруппировкаИсполнитель = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
			ГруппировкаИсполнитель.Имя = ИмяГруппировкиИсполнитель;
			ГруппировкаИсполнитель.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
			ПолеИсполнитель = ГруппировкаИсполнитель.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеИсполнитель.Поле = Новый ПолеКомпоновкиДанных("Исполнитель");
		КонецЕсли;
		
		Исполнитель = ПараметрВывестиИсполнителя.Значение;
		
		ДанныеСотрудника = Новый Структура;
		ДанныеСотрудника.Вставить("Должность", "");
		ДанныеСотрудника.Вставить("НаименованиеПолное", "");
		ДанныеСотрудника.Вставить("ФИОИсполнителя", "");
		ДанныеСотрудника.Вставить("ТелефонИсполнителя", "");
		ДанныеСотрудника.Вставить("ЭлектроннаяПочтаИсполнителя", "");
		
		Если ЗначениеЗаполнено(Исполнитель) Тогда
			ДанныеСотрудника.Вставить("СсылкаНаОбъект", Исполнитель);
			ДанныеСотрудника.Вставить("Период", ТекущаяДатаСеанса());
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, Истина);
			ДанныеСотрудника.Вставить("ФИОИсполнителя", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника.НаименованиеПолное));
			ДанныеСотрудника.Вставить("ТелефонИсполнителя", ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
			ДанныеСотрудника.Вставить("ЭлектроннаяПочтаИсполнителя", ДанныеСотрудника.EmailФизическиеЛица); 
		КонецЕсли;
		
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(
			"ДолжностьИсполнителя", ДанныеСотрудника.Должность);
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(
			"ФИОИсполнителя", ДанныеСотрудника.ФИОИсполнителя);
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(
			"ТелефонИсполнителя", ДанныеСотрудника.ТелефонИсполнителя);
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(
			"ЭлектроннаяПочтаИсполнителя", ДанныеСотрудника.ЭлектроннаяПочтаИсполнителя);
		
	Иначе
		ГруппировкаДляУдаления = Неопределено;
		Для Каждого ГруппировкаКД Из КомпоновщикНастроек.Настройки.Структура Цикл
			Если ГруппировкаКД.Имя = ИмяГруппировкиИсполнитель Тогда
				ГруппировкаДляУдаления = ГруппировкаКД;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ГруппировкаДляУдаления <> Неопределено Тогда
			КомпоновщикНастроек.Настройки.Структура.Удалить(ГруппировкаДляУдаления);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

