	Возврат "РеестрИмущества_";	

КонецФункции // ПрефиксЭлементовОперации()

Процедура УстановитьСписокВыбораИЗначениеПоСписку(Элемент, Значение, Список, ПоПредставлению = Истина) Экспорт
	
	ПустойСписок = (Список.Количество() = 0);
	Элемент.ТолькоПросмотр = ПустойСписок;
	
	Если ПустойСписок Тогда
		Значение = Неопределено;
	Иначе
		Если ПоПредставлению И Элемент.СписокВыбора.Количество() > 0 Тогда			
			ПрошлоеЗначение = Элемент.СписокВыбора.НайтиПоЗначению(Значение);
			Если ПрошлоеЗначение = Неопределено Тогда
				Значение = Неопределено; // Исключает ошибки
			Иначе
				ПредставлениеЗначения = ПрошлоеЗначение.Представление;
				НовоеЗначение = Неопределено;
				Для Каждого ЭлементСписка Из Список Цикл
					Если ЭлементСписка.Представление = ПредставлениеЗначения Тогда
						НовоеЗначение = ЭлементСписка.Значение;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Значение = НовоеЗначение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	СписокЭлемента = Элемент.СписокВыбора;
	СписокЭлемента.Очистить();
	Для Каждого ЭлементСписка Из Список Цикл
		СписокЭлемента.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьРодителяПоТипуЭлемента(Элемент, Тип) Экспорт
	
	Если ТипЗнч(Элемент) = Тип Тогда
		Возврат Элемент;
	ИначеЕсли ТипЗнч(Элемент) = Тип("ФормаКлиентскогоПриложения") Тогда
		Возврат Неопределено;
	Иначе
		Возврат ПолучитьРодителяПоТипуЭлемента(Элемент.Родитель, Тип);
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьЭлементФормыПоИмени(Форма, ИмяРеквизита, Путь = "") Экспорт
	
	Реквизиты = Форма.ПолучитьРеквизиты(Путь);
	Для Каждого Реквизит Из Реквизиты Цикл
		Если Реквизит.Имя = ИмяРеквизита Тогда
			Возврат Реквизит;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьПутьРеквизита(Знач Реквизит, Корень = Неопределено) Экспорт
		
	Путь = "";

	Если Реквизит = Корень Тогда
		Возврат Путь;
	КонецЕсли;
	
	ТекЭлемент = Реквизит.Родитель;
		
		Пока ТекЭлемент <> Корень И Не ТекЭлемент.Пустая() Цикл
			Если ТекЭлемент.ВидРеквизита = ПредопределенноеЗначение("Перечисление.ВидыРеквизитовСведенийОбИмуществе.Таблица") Тогда
				Путь = ТекЭлемент.ИмяДляФормулы + ?(Путь = "", "", ".") + Путь;
			КонецЕсли;
			ТекЭлемент = ТекЭлемент.Родитель;
		КонецЦикла;
	
	Возврат Путь;	
	
КонецФункции

Процедура ЗаполнитьФормуДанными(Приемник, ДанныеЗаполнения) Экспорт
	
	Для Каждого Реквизит Из ДанныеЗаполнения Цикл
		Если ТипЗнч(Реквизит.Значение) = Тип("Массив") Или ТипЗнч(Реквизит.Значение) = Тип("СписокЗначений") Тогда
			Приемник[Реквизит.Ключ].Очистить();
			Для Каждого Элемент Из Реквизит.Значение Цикл 
				//ЗаполнитьЗначенияСвойств(Приемник[Реквизит.Ключ].Добавить(), Элемент);
				Если ТипЗнч(Реквизит.Значение) = Тип("Массив") Тогда
					ЗаполнитьФормуДанными(Приемник[Реквизит.Ключ].Добавить(), Элемент);
				Иначе
					ЗаполнитьЗначенияСвойств(Приемник[Реквизит.Ключ].Добавить(), Элемент);
				КонецЕсли;
			КонецЦикла;
			//ЗаполнитьФормуДанными(Приемник, Реквизит.Значение)
		Иначе
			Приемник[Реквизит.Ключ] = Реквизит.Значение;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

Процедура УстановитьИмяДляФормулы(ИмяДляФормулы, Основание = Неопределено) Экспорт
	
	НовоеИмя = ?(Основание = Неопределено Или ЗначениеЗаполнено(ИмяДляФормулы), ИмяДляФормулы, СтрЗаменить(ТРег(Основание), " ", ""));
	УдалитьЗапрещенныеСимволыИзИмени(НовоеИмя);
	ИмяДляФормулы = НовоеИмя;
	
КонецПроцедуры

