
#Область ПрограммныйИнтерфейс

// Количество рабочих дней по графику. Если график не задан, то используется единственный график по производственному
// календарю "Российская федерация". Если таких графиков несколько, то используется сам календарь.
// Когда используется календарь, то количество рабочих дней уменьшается на количество нерабочих дней по особым приказам
// президента не зависимо от того, учитывались ли эти нерабочие дни.
// 
// Параметры:
// 	Дата1 - Дата -
// 	Дата2 - Дата -
// 	ГрафикРаботы - СправочникСсылка.Календари - 
// Возвращаемое значение:
// 	Число - количество рабочих дней или 0, если не удалось определить нужный календарь или календарь не заполнен.
Функция КолРабДней(Дата1, Дата2, Знач ГрафикРаботы = Неопределено) Экспорт
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ГрафикРаботы) Тогда
		// Если по календарю РФ есть только 1 график, нужно использовать его.
		// Если такого графика нет или он не один, то используется производственный календарь.
		ПроизводственныйКалендарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
		ГрафикРаботы = ЕдинственныйГрафикПоПроизводственномуКалендарю(ПроизводственныйКалендарь);
		Если Не ЗначениеЗаполнено(ГрафикРаботы) И ЗначениеЗаполнено(ПроизводственныйКалендарь) Тогда
			ГрафикРаботы = ПроизводственныйКалендарь;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ГрафикРаботы) Тогда
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
	
	КоличествоРабочихДней = КалендарныеГрафики.РазностьДатПоКалендарю(ГрафикРаботы, Дата1, Дата2);
	
	Если КоличествоРабочихДней = 0 ИЛИ КоличествоРабочихДней = Неопределено Тогда
		ДатаНач = НачалоМесяца(Дата1);
		ДатаКон = КонецМесяца(Дата2);
		РасчетыПоРодительскойПлатеПовтИсп.ПроверитьЗаполнениеГрафикаКалендаря(ДатаНач, ДатаКон, ГрафикРаботы);
		Возврат 0;
	КонецЕсли;
	
	Если ТипЗнч(ГрафикРаботы) = Тип("СправочникСсылка.ПроизводственныеКалендари") Тогда
		
		// Рабочие дни по производственному календарю не учитывают дополнительные выходные, введенные
		// указами президента в связи с самоизоляцией. Эти нерабочие дни вычитаются из периода безусловно.
		// Если нерабочие дни должны быть рабочими, то нужно указать это в графике. Если графиков по основному
		// календарю несколько, требуется явное указание графика в группе ДДУ.
		КоличествоРабочихДней = КоличествоРабочихДней
			- КоличествоДополнительныхНерабочихДнейПоГрафику(Дата1, Дата2, ПроизводственныйКалендарь);
		
	КонецЕсли;
	
	Возврат КоличествоРабочихДней;
КонецФункции

// Проверяет заполнение графика или календаря за указанный период.
// Если разность дат по календарю = 0, выводит сообщение о не заполненном календаре
// 
// Параметры:
// 	Дата1 - Дата - 
// 	Дата2 - Дата - 
// 	ГрафикРаботы - СправочникСсылка.ПроизводственныеКалендари, Произвольный, Неопределено, СправочникСсылка.Календари - 
// Возвращаемое значение:
// 	Неопределено - 
Функция ПроверитьЗаполнениеГрафикаКалендаря(Дата1, Дата2, ГрафикРаботы) Экспорт
	
	Если КалендарныеГрафики.РазностьДатПоКалендарю(ГрафикРаботы, Дата1, Дата2) = 0 Тогда
		Если ТипЗнч(ГрафикРаботы) = Тип("СправочникСсылка.ПроизводственныеКалендари") Тогда
			ИмяТипа = НСтр("ru = 'производственный календарь'");
		Иначе
			ИмяТипа = НСтр("ru = 'график'");
		КонецЕсли;
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Не заполнен %1 за %2'"), ИмяТипа, ПредставлениеПериода(Дата1, Дата2));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СтавкаОплаты(Дата1, Дата2, Ставка, РабочихДней, ДнейПосещения, Льгота) Экспорт
	
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	Результат = 0;
	
	Если ТипЗнч(Ставка) <> Тип("СправочникСсылка.СтавкиОплатыОбразование") Тогда
	 	Возврат 0;
	Иначе
		
		КоличествоДнейДействия = День(Дата2) - День(Дата1) + 1;
		КоличествоДнейВПериоде = День(КонецМесяца(Дата2)); 
		ДанныеСтавки = РаботаСоСтудентамиПовтИсп.ПолучитьДанныеСтавки(Ставка, Дата1);
		
		Если ДанныеСтавки.ЭтоФиксированнаяСтавкаЗаПериод Тогда
			
			Если КоличествоДнейДействия <> КоличествоДнейВПериоде Тогда
				Результат = ДанныеСтавки.СуммаНачисления / КоличествоДнейВПериоде * КоличествоДнейДействия;
			Иначе
				Результат = ДанныеСтавки.СуммаНачисления;
			КонецЕсли; 
			
		Иначе
			
			Мультипликатор = Месяц(Дата2) - Месяц(Дата1) + 1 + (Год(Дата2) - Год(Дата1)) * 12;
				
			СуммаФиксированнаяСтавкаЗаМесяц = ДанныеСтавки.СуммаФиксированнаяСтавкаЗаМесяц  * Мультипликатор;
			СуммаПеременнойСтавки = ?(РабочихДней = 0, 0,
				ДанныеСтавки.СуммаПеременнаяСтавкаЗаМесяц * Мультипликатор * ДнейПосещения / РабочихДней);
			СуммаЗаДни = ДанныеСтавки.СуммаСтавкаЗаДень * ДнейПосещения;
			
			Результат = СуммаФиксированнаяСтавкаЗаМесяц + СуммаПеременнойСтавки + СуммаЗаДни;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Результат = Результат * (100 - Льгота) / 100;
	
	Возврат Результат;
КонецФункции

Функция ФиксСтавкаЗаПериод(Дата1, Дата2, Ставка) Экспорт
	Если Не Ставка.ЭтоФиксированнаяСтавкаЗаПериод Тогда
		Возврат 0;
	КонецЕсли;
	
	Результат = 0;
	СуммаНачисления = 0;
	
	КоличествоДнейДействия = День(Дата2) - День(Дата1) + 1;
	КоличествоДнейВПериоде = День(КонецМесяца(Дата2)); 
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СтавкиОплатыПорядокНачисления.СуммаНачисления КАК СуммаНачисления
	|ИЗ
	|	Справочник.СтавкиОплатыОбразование.ПорядокНачисления КАК СтавкиОплатыПорядокНачисления
	|ГДЕ
	|	СтавкиОплатыПорядокНачисления.Ссылка = &Ставка
	|	И НАЧАЛОПЕРИОДА(СтавкиОплатыПорядокНачисления.ПериодНачисления, МЕСЯЦ) = &ПериодНачисления";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ставка", Ставка);
	Запрос.УстановитьПараметр("ПериодНачисления", НачалоМесяца(Дата1));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СуммаНачисления = Выборка.СуммаНачисления;
	КонецЕсли; 

	Если КоличествоДнейДействия <> КоличествоДнейВПериоде Тогда
		Результат = СуммаНачисления / КоличествоДнейВПериоде * КоличествоДнейДействия;
	Иначе
		Результат = СуммаНачисления;
	КонецЕсли; 
	
	Возврат Результат;
КонецФункции

Функция СтавкаКомпенсации(Дата2) Экспорт
	Если Не ЗначениеЗаполнено(Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтавкаКомпенсации.Ставка КАК Ставка
	|ИЗ
	|	РегистрСведений.СтавкаКомпенсацииРодительскойПлаты.СрезПоследних(&Дата2, ) КАК СтавкаКомпенсации";
	Запрос.УстановитьПараметр("Дата2", Дата2);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Ставка;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция ПоступлениеОплатыЗаПериод(Дата1, Дата2, Организация) Экспорт
	Если Не ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.КорСубконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.КорСубконто2 КАК Справочник.Договоры) КАК Договор,
	|	СУММА(ЕСТЬNULL(ЕПСБУОбороты.СуммаОборот, 0)) КАК Оплачено
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&Дата1, &Дата2,, Счет В (&СчетаПоступленияДС),,
	|		Организация = &Организация, КорСчет В (&СчетаРасчетов),) КАК ЕПСБУОбороты
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.КорСубконто1 КАК Справочник.Контрагенты),
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.КорСубконто2 КАК Справочник.Договоры)";
	Запрос.УстановитьПараметр("Дата1", НачалоДня(Дата1));
	Запрос.УстановитьПараметр("Дата2", КонецДня(Дата2));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетаПоступленияДС",
		БухгалтерскийУчет.СписокСчетов("205.30, 205.55, 205.80, 201.11, 201.21, 201.23, 201.34, 210.02, 304.05, 303.05", Дата2, Ложь, Организация));
	Запрос.УстановитьПараметр("СчетаРасчетов",
		БухгалтерскийУчет.СписокСчетов("205.30, 205.55, 205.80", Дата2, Ложь, Организация));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция НачислениеПлатыЗаПериод(Дата1, Дата2, Организация) Экспорт
	Если Не ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	СУММА(ЕСТЬNULL(ЕПСБУОбороты.СуммаОборот, 0)) КАК Начислено
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(&Дата1, &Дата2,, Счет В (&СчетаРасчетов),,
	|		Организация = &Организация, КорСчет В (&СчетаФинРез),) КАК ЕПСБУОбороты
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.Контрагенты),
	|	ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто2 КАК Справочник.Договоры)";
	Запрос.УстановитьПараметр("Дата1", НачалоДня(Дата1));
	Запрос.УстановитьПараметр("Дата2", КонецДня(Дата2));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетаФинРез",
		БухгалтерскийУчет.СписокСчетов("401.10", Дата2, Ложь, Организация));
	Запрос.УстановитьПараметр("СчетаРасчетов",
		БухгалтерскийУчет.СписокСчетов("205.30, 205.55, 205.80", Дата2, Ложь, Организация));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция ТаблицаОстатков(Дата1, Организация) Экспорт
	Если НЕ (ЗначениеЗаполнено(Дата1)) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	СУММА(ЕСТЬNULL(ЕПСБУОстатки.СуммаОстаток, 0)) КАК Задолженность
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Дата1, Счет В (&СчетаРасчетов), , Организация = &Организация) КАК ЕПСБУОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОстатки.Субконто1,
	|	ЕПСБУОстатки.Субконто2";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата1", Дата1);
	Запрос.УстановитьПараметр("СчетаРасчетов", БухгалтерскийУчет.СписокСчетов("205.30, 205.55, 205.80", Дата1, Ложь, Организация));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция КолНеоплНепосещений(Дата1, Дата2, РодительскаяПлатаДопУслуги = 0) Экспорт
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьРедактируемыеТабелиРодительскаяПлата") Тогда
		// Заполнение по данным регистра ТабельУчетаПосещаемостиДетейСКорректировкой.
		// Для совместимости и перезаполнения старых документов учитываются документы ТабельУчетаПосещаемостиДетей.
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеТабелей.Группа КАК Группа,
		|	ДанныеТабелей.Ребенок КАК Ребенок,
		|	СУММА(ДанныеТабелей.Невыходы) КАК Невыходы
		|ИЗ
		|	(ВЫБРАТЬ
		|		Табель.Группа КАК Группа,
		|		Табель.Ребенок КАК Ребенок,
		|		Табель.ФактНевыхода КАК Невыходы
		|	ИЗ
		|		РегистрНакопления.ТабельУчетаПосещаемостиДетей КАК Табель
		|	ГДЕ
		|		Табель.ДатаНевыхода >= &Дата1
		|		И Табель.ДатаНевыхода <= &Дата2
		|		И Табель.РодительскаяПлатаДопУслуги = &РодительскаяПлатаДопУслуги
		|		И Табель.ВидТабеля = 0
		|		И Табель.ВидНевыхода = 1
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Табель.Группа,
		|		Табель.Ребенок,
		|		Табель.НеоплСводно
		|	ИЗ
		|		РегистрНакопления.ТабельУчетаПосещаемостиДетей КАК Табель
		|	ГДЕ
		|		Табель.ДатаНевыхода >= &Дата1
		|		И Табель.ДатаНевыхода <= &КонецМесяцаДата2
		|		И Табель.РодительскаяПлатаДопУслуги = &РодительскаяПлатаДопУслуги
		|		И Табель.ВидТабеля = 1
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ТабельУчетаПосещаемостиДетейСКорректировкойОбороты.Группа,
		|		ТабельУчетаПосещаемостиДетейСКорректировкойОбороты.Ребенок,
		|		ТабельУчетаПосещаемостиДетейСКорректировкойОбороты.НеоплачиваемыеНевыходыОборот
		|	ИЗ
		|		РегистрНакопления.ТабельУчетаПосещаемостиДетейСКорректировкой.Обороты(&Дата1, &Дата2, , РодительскаяПлатаДопУслуги = &РодительскаяПлатаДопУслуги) КАК ТабельУчетаПосещаемостиДетейСКорректировкойОбороты) КАК ДанныеТабелей
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеТабелей.Группа,
		|	ДанныеТабелей.Ребенок";
		
	Иначе
		// Заполнение по данным регистра ТабельУчетаПосещаемостиДетей.
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеТабелей.Группа КАК Группа,
		|	ДанныеТабелей.Ребенок КАК Ребенок,
		|	СУММА(ДанныеТабелей.Невыходы) КАК Невыходы
		|ИЗ
		|	(ВЫБРАТЬ
		|		Табель.Группа КАК Группа,
		|		Табель.Ребенок КАК Ребенок,
		|		Табель.ФактНевыхода КАК Невыходы
		|	ИЗ
		|		РегистрНакопления.ТабельУчетаПосещаемостиДетей КАК Табель
		|	ГДЕ
		|		Табель.ДатаНевыхода >= &Дата1
		|		И Табель.ДатаНевыхода <= &Дата2
		|		И Табель.РодительскаяПлатаДопУслуги = &РодительскаяПлатаДопУслуги
		|		И Табель.ВидТабеля = 0
		|		И Табель.ВидНевыхода = 1
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Табель.Группа,
		|		Табель.Ребенок,
		|		Табель.НеоплСводно
		|	ИЗ
		|		РегистрНакопления.ТабельУчетаПосещаемостиДетей КАК Табель
		|	ГДЕ
		|		Табель.ДатаНевыхода >= &Дата1
		|		И Табель.ДатаНевыхода <= &КонецМесяцаДата2
		|		И Табель.РодительскаяПлатаДопУслуги = &РодительскаяПлатаДопУслуги
		|		И Табель.ВидТабеля = 1) КАК ДанныеТабелей
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеТабелей.Группа,
		|	ДанныеТабелей.Ребенок";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("РодительскаяПлатаДопУслуги", РодительскаяПлатаДопУслуги);
	Запрос.УстановитьПараметр("Дата1", НачалоДня(Дата1));
	Запрос.УстановитьПараметр("Дата2", КонецДня(Дата2));
	Запрос.УстановитьПараметр("КонецМесяцаДата2", КонецМесяца(Дата2));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция КолОплНепосещений(Дата1, Дата2, РодительскаяПлатаДопУслуги = 0) Экспорт
	Если НЕ ДатыЗаполненыКорректно(Дата1, Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьРедактируемыеТабелиРодительскаяПлата") Тогда
		// Заполнение по данным регистра ТабельУчетаПосещаемостиДетейСКорректировкой.
		// Для совместимости и перезаполнения старых документов учитываются документы ТабельУчетаПосещаемостиДетей.
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеТабелей.Группа КАК Группа,
		|	ДанныеТабелей.Ребенок КАК Ребенок,
		|	СУММА(ДанныеТабелей.Невыходы) КАК Невыходы
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТабельУчетаПосещаемостиДетей.Группа КАК Группа,
		|		ТабельУчетаПосещаемостиДетей.Ребенок КАК Ребенок,
		|		ВЫБОР
		|			КОГДА ТабельУчетаПосещаемостиДетей.ВидТабеля = 0
		|				ТОГДА ТабельУчетаПосещаемостиДетей.ФактНевыхода
		|			ИНАЧЕ ТабельУчетаПосещаемостиДетей.ОплСводно
		|		КОНЕЦ КАК Невыходы
		|	ИЗ
		|		РегистрНакопления.ТабельУчетаПосещаемостиДетей КАК ТабельУчетаПосещаемостиДетей
		|	ГДЕ
		|		ТабельУчетаПосещаемостиДетей.ДатаНевыхода >= &Дата1
		|		И ТабельУчетаПосещаемостиДетей.ДатаНевыхода <= &Дата2
		|		И ТабельУчетаПосещаемостиДетей.РодительскаяПлатаДопУслуги = &РодительскаяПлатаДопУслуги
		|		И ВЫБОР
		|				КОГДА ТабельУчетаПосещаемостиДетей.ВидТабеля = 0
		|					ТОГДА ТабельУчетаПосещаемостиДетей.ВидНевыхода = 0
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ТабельУчетаПосещаемостиДетейСКорректировкойОбороты.Группа,
		|		ТабельУчетаПосещаемостиДетейСКорректировкойОбороты.Ребенок,
		|		ТабельУчетаПосещаемостиДетейСКорректировкойОбороты.ОплачиваемыеНевыходыОборот
		|	ИЗ
		|		РегистрНакопления.ТабельУчетаПосещаемостиДетейСКорректировкой.Обороты(&Дата1, &Дата2, , РодительскаяПлатаДопУслуги = &РодительскаяПлатаДопУслуги) КАК ТабельУчетаПосещаемостиДетейСКорректировкойОбороты) КАК ДанныеТабелей
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеТабелей.Группа,
		|	ДанныеТабелей.Ребенок";
		
	Иначе
		// Заполнение по данным регистра ТабельУчетаПосещаемостиДетей.
	
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Табель.Группа КАК Группа,
		|	Табель.Ребенок КАК Ребенок,
		|	СУММА(ВЫБОР
		|			КОГДА Табель.ВидТабеля = 0
		|				ТОГДА Табель.ФактНевыхода
		|			ИНАЧЕ Табель.ОплСводно
		|		КОНЕЦ) КАК Невыходы
		|ИЗ
		|	РегистрНакопления.ТабельУчетаПосещаемостиДетей КАК Табель
		|ГДЕ
		|	Табель.ДатаНевыхода >= &Дата1
		|	И Табель.ДатаНевыхода <= &Дата2
		|	И Табель.РодительскаяПлатаДопУслуги = &РодительскаяПлатаДопУслуги
		|	И ВЫБОР
		|			КОГДА Табель.ВидТабеля = 0
		|				ТОГДА Табель.ВидНевыхода = 0
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	Табель.Группа,
		|	Табель.Ребенок";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("РодительскаяПлатаДопУслуги", РодительскаяПлатаДопУслуги);
	Запрос.УстановитьПараметр("Дата1", НачалоДня(Дата1));
	Запрос.УстановитьПараметр("Дата2", КонецДня(Дата2));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция СуммаКомпенсации(Дата1, Дата2, Организация) Экспорт
	Если Не (ЗначениеЗаполнено(Дата1) Или ЗначениеЗаполнено(Дата2) Или ЗначениеЗаполнено(Организация)) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Дата1 > Дата2 Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Компенсация.Ребенок КАК Ребенок,
	|	СУММА(ЕСТЬNULL(Компенсация.СуммаКомпенсации, 0)) КАК СуммаКомпенсации
	|ИЗ
	|	РегистрСведений.ЖурналУчетаКомпенсацииРодительскойПлаты КАК Компенсация
	|ГДЕ
	|	Компенсация.Организация = &Организация
	|	И Компенсация.НачалоПериода >= &Дата1
	|	И Компенсация.КонецПериода <= &Дата2
	|
	|СГРУППИРОВАТЬ ПО
	|	Компенсация.Ребенок";
	Запрос.УстановитьПараметр("Дата1", НачалоДня(Дата1));
	Запрос.УстановитьПараметр("Дата2", КонецДня(Дата2));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;	
КонецФункции

Функция ПроцентКомпенсации(Дата2) Экспорт
	Если Не ЗначениеЗаполнено(Дата2) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ребенок,
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.НастройкаКомпенсации,
	|	ВЫБОР
	|		КОГДА ПараметрыКомпенсацииРодительскойПлатыПоДетям.НастройкаКомпенсации = ЗНАЧЕНИЕ(Справочник.НастройкиРасчетовПоРодительскойПлате.ПустаяСсылка)
	|			ТОГДА ИСТИНА
	|		КОГДА ПараметрыКомпенсацииРодительскойПлатыПоДетям.НастройкаКомпенсации.ПоУмолчанию
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОсновнойРасчет,
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ставка КАК Процент
	|ИЗ
	|	РегистрСведений.ПараметрыКомпенсацииРодительскойПлатыПоДетям КАК ПараметрыКомпенсацииРодительскойПлатыПоДетям
	|ГДЕ
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаНачала <= &Дата2
	|	И (ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаОкончания = ДатаВремя(1,1,1)
	|	ИЛИ ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаОкончания >= &Дата2)";
	Запрос.УстановитьПараметр("Дата2", НачалоДня(Дата2));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция ПлатаПоСтавке(Дата1, Дата2, ГрафикРаботы, Ставка) Экспорт
	Результат = 0;
	
	КоличествоРабочихДней = КалендарныеГрафики.РазностьДатПоКалендарю(ГрафикРаботы, Дата1, Дата2, Ложь);
	
	КоличествоДнейДействия = День(Дата2) - День(Дата1) + 1;
	КоличествоДнейВПериоде = День(КонецМесяца(Дата2)); 
	
	ДанныеСтавки = РаботаСоСтудентамиПовтИсп.ПолучитьДанныеСтавки(Ставка, Дата1);
	
	Если ДанныеСтавки.ЭтоФиксированнаяСтавкаЗаПериод Тогда
		Если КоличествоДнейДействия <> КоличествоДнейВПериоде Тогда
			Результат = ДанныеСтавки.СуммаНачисления / КоличествоДнейВПериоде * КоличествоДнейДействия;
		Иначе
			Результат = ДанныеСтавки.СуммаНачисления;
		КонецЕсли; 
	Иначе
		СуммаФиксированнаяСтавкаЗаМесяц = ДанныеСтавки.СуммаФиксированнаяСтавкаЗаМесяц / КоличествоДнейВПериоде
			* КоличествоДнейДействия;
		СуммаПеременнойСтавки = ДанныеСтавки.СуммаПеременнаяСтавкаЗаМесяц;
		СуммаЗаДни = ДанныеСтавки.СуммаСтавкаЗаДень * КоличествоРабочихДней;
		
		Результат = СуммаФиксированнаяСтавкаЗаМесяц + СуммаПеременнойСтавки + СуммаЗаДни;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция МассивРабочихДней(Период, ГрафикРаботы) Экспорт
	Если НЕ ЗначениеЗаполнено(ГрафикРаботы) Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ДЕНЬ(ДанныеКалендаря.Дата) КАК РабочиеДни
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.ПроизводственныйКалендарь.Код = ""РФ""
		|	И ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный))";
	Иначе
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ДЕНЬ(ДанныеКалендаря.ДатаГрафика) КАК РабочиеДни
		|ИЗ
		|	РегистрСведений.КалендарныеГрафики КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.ДатаГрафика МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ДанныеКалендаря.ДеньВключенВГрафик
		|	И ДанныеКалендаря.Календарь = &ГрафикРаботы";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Период));
	Запрос.УстановитьПараметр("ГрафикРаботы", ГрафикРаботы);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПредставлениеЛьготы(Льгота) Экспорт
	Если Не ЗначениеЗаполнено(Льгота) Тогда
		Возврат "";
	Иначе
		Возврат Льгота.Наименование + " (" + Льгота.ПроцентЛьготы + "%)";
	КонецЕсли;
КонецФункции

Функция ИзмененияВГруппе(Дата1, Дата2, Группа, РодительскаяПлатаДопУслуги = 0) Экспорт

	Запрос = Новый Запрос;
	Если РодительскаяПлатаДопУслуги = 0 Тогда
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДвижений.Период КАК Период,
		|	ТаблицаДвижений.Ребенок КАК Ребенок,
		|	ТаблицаДвижений.Актуальность КАК Актуальность,
		|	МАКСИМУМ(ТаблицаДвижений.ЭтоИзменениеПараметров) КАК ЭтоИзменениеПараметров
		|ИЗ
		|	(ВЫБРАТЬ
		|		КОНЕЦПЕРИОДА(СоставГруппДДУ.Период, ДЕНЬ) КАК Период,
		|		СоставГруппДДУ.Ребенок КАК Ребенок,
		|		СоставГруппДДУ.Актуальность КАК Актуальность,
		|		ВЫБОР
		|			КОГДА СоставГруппДДУ.Актуальность = ЛОЖЬ
		|					И ИСТИНА В
		|						(ВЫБРАТЬ ПЕРВЫЕ 1
		|							ИСТИНА
		|						ИЗ
		|							РегистрСведений.СоставГруппДДУ КАК ВложеннаяТ
		|						ГДЕ
		|							СоставГруппДДУ.Ребенок = ВложеннаяТ.Ребенок
		|							И ВложеннаяТ.Актуальность = ИСТИНА
		|							И ДОБАВИТЬКДАТЕ(СоставГруппДДУ.Период, ДЕНЬ, 1) = ВложеннаяТ.Период)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ КАК ЭтоИзменениеПараметров
		|	ИЗ
		|		РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ
		|	ГДЕ
		|		СоставГруппДДУ.Период МЕЖДУ &Дата1 И &Дата2
		|		И СоставГруппДДУ.ГруппаДетскогоУчреждения = &Группа
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		&Дата1,
		|		СоставГруппДДУСрезПоследних.Ребенок,
		|		СоставГруппДДУСрезПоследних.Актуальность,
		|		ЛОЖЬ
		|	ИЗ
		|		РегистрСведений.СоставГруппДДУ.СрезПоследних(&Дата11, ГруппаДетскогоУчреждения = &Группа) КАК СоставГруппДДУСрезПоследних
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		&Дата2,
		|		СоставГруппДДУСрезПоследних.Ребенок,
		|		СоставГруппДДУСрезПоследних.Актуальность,
		|		ЛОЖЬ
		|	ИЗ
		|		РегистрСведений.СоставГруппДДУ.СрезПоследних(&Дата2, ГруппаДетскогоУчреждения = &Группа) КАК СоставГруппДДУСрезПоследних) КАК ТаблицаДвижений
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаДвижений.Период,
		|	ТаблицаДвижений.Ребенок,
		|	ТаблицаДвижений.Актуальность
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаИзменений.Период КАК Период,
		|	ТаблицаИзменений.Ребенок КАК Ребенок,
		|	ТаблицаИзменений.Актуальность КАК Актуальность,
		|	МАКСИМУМ(ТаблицаИзменений.ЭтоИзменениеПараметров) КАК ЭтоИзменениеПараметров
		|ИЗ
		|	(ВЫБРАТЬ
		|		КОНЕЦПЕРИОДА(СоставГруппДДУДополнительныеУслуги.Период, ДЕНЬ) КАК Период,
		|		СоставГруппДДУДополнительныеУслуги.Ребенок КАК Ребенок,
		|		СоставГруппДДУДополнительныеУслуги.Актуальность КАК Актуальность,
		|		ВЫБОР
		|			КОГДА СоставГруппДДУДополнительныеУслуги.Актуальность = ЛОЖЬ
		|					И ИСТИНА В
		|						(ВЫБРАТЬ ПЕРВЫЕ 1
		|							ИСТИНА
		|						ИЗ
		|							РегистрСведений.СоставГруппДДУДополнительныеУслуги КАК ВложеннаяТ
		|						ГДЕ
		|							СоставГруппДДУДополнительныеУслуги.Ребенок = ВложеннаяТ.Ребенок
		|							И СоставГруппДДУДополнительныеУслуги.ГруппаДетскогоУчреждения = ВложеннаяТ.ГруппаДетскогоУчреждения
		|							И ВложеннаяТ.Актуальность = ИСТИНА
		|							И ДОБАВИТЬКДАТЕ(СоставГруппДДУДополнительныеУслуги.Период, ДЕНЬ, 1) = ВложеннаяТ.Период)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ КАК ЭтоИзменениеПараметров
		|	ИЗ
		|		РегистрСведений.СоставГруппДДУДополнительныеУслуги КАК СоставГруппДДУДополнительныеУслуги
		|	ГДЕ
		|		СоставГруппДДУДополнительныеУслуги.Период МЕЖДУ &Дата1 И &Дата2
		|		И СоставГруппДДУДополнительныеУслуги.ГруппаДетскогоУчреждения = &Группа
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		&Дата1,
		|		СоставГруппДДУДополнительныеУслугиСрезПоследних.Ребенок,
		|		СоставГруппДДУДополнительныеУслугиСрезПоследних.Актуальность,
		|		ЛОЖЬ
		|	ИЗ
		|		РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(&Дата11, ГруппаДетскогоУчреждения = &Группа) КАК СоставГруппДДУДополнительныеУслугиСрезПоследних
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		&Дата2,
		|		СоставГруппДДУДополнительныеУслугиСрезПоследних.Ребенок,
		|		СоставГруппДДУДополнительныеУслугиСрезПоследних.Актуальность,
		|		ЛОЖЬ
		|	ИЗ
		|		РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(&Дата2, ГруппаДетскогоУчреждения = &Группа) КАК СоставГруппДДУДополнительныеУслугиСрезПоследних) КАК ТаблицаИзменений
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаИзменений.Период,
		|	ТаблицаИзменений.Ребенок,
		|	ТаблицаИзменений.Актуальность
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата11", Дата1 - 1);
	Запрос.УстановитьПараметр("Дата1", Дата1);
	Запрос.УстановитьПараметр("Дата2", Дата2);
	Запрос.УстановитьПараметр("Группа", Группа);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Индексы.Добавить("Ребенок");
	
	Возврат Таблица;

КонецФункции

Функция РебенокВыбыл(Ребенок, Дата) Экспорт

	ДатаВыбытия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ребенок, "ДатаВыбытия");
	
	Возврат ЗначениеЗаполнено(ДатаВыбытия) И НачалоДня(ДатаВыбытия) < НачалоДня(Дата);

КонецФункции

Функция ПолучитьКалендарныйГрафикГруппы(ГруппаДетскогоУчреждения, НаДату = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДата();
	КонецЕсли;
	
	КалендарныйГрафик = Неопределено;
	
	Если ЗначениеЗаполнено(ГруппаДетскогоУчреждения) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГрафикиРаботыГруппДетскогоУчрежденияСрезПоследних.ГрафикРаботы КАК ГрафикРаботы
		|ИЗ
		|	РегистрСведений.ГрафикиРаботыГруппДетскогоУчреждения.СрезПоследних(&НаДату, ГруппаДетскогоУчреждения = &ГруппаДетскогоУчреждения) КАК ГрафикиРаботыГруппДетскогоУчрежденияСрезПоследних";
		
		Запрос.УстановитьПараметр("ГруппаДетскогоУчреждения", ГруппаДетскогоУчреждения);
		Запрос.УстановитьПараметр("НаДату", НаДату);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			КалендарныйГрафик = ВыборкаДетальныеЗаписи.ГрафикРаботы;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КалендарныйГрафик;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕдинственныйГрафикПоПроизводственномуКалендарю(ПроизводственныйКалендарь)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Календари.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Календари КАК Календари
	|ГДЕ
	|	НЕ Календари.ПометкаУдаления
	|	И Календари.ПроизводственныйКалендарь = &ПроизводственныйКалендарь";
	Запрос.УстановитьПараметр("ПроизводственныйКалендарь", ПроизводственныйКалендарь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.Календари.ПустаяСсылка();
	КонецЕсли; 

КонецФункции

Функция КоличествоДополнительныхНерабочихДнейПоГрафику(Дата1, Дата2, ПроизводственныйКалендарь)
	КоличествоНерабочихДней = 0;
	ПериодГрафика = Новый СтандартныйПериод(Дата1, Дата2);
	ПериодыНерабочихДней = КалендарныеГрафики.ПериодыНерабочихДней(ПроизводственныйКалендарь, ПериодГрафика);
	Для каждого ОписаниеПериода Из ПериодыНерабочихДней Цикл
		
		ДатаНачала = Макс(Дата1, ОписаниеПериода.Период.ДатаНачала);
		ДатаОкончания = Мин(Дата2, ОписаниеПериода.Период.ДатаОкончания);
		
		КоличествоНерабочихДней = КоличествоНерабочихДней
			+ КалендарныеГрафики.РазностьДатПоКалендарю(ПроизводственныйКалендарь, ДатаНачала, ДатаОкончания);
	
	КонецЦикла;
	Возврат КоличествоНерабочихДней;
КонецФункции

Функция ДатыЗаполненыКорректно(Дата1, Дата2)

	Возврат ЗначениеЗаполнено(Дата1)
		И ЗначениеЗаполнено(Дата2)
		И ТипЗнч(Дата1) = Тип("Дата")
		И ТипЗнч(Дата2) = Тип("Дата")
		И Дата2 >= Дата1;
	
КонецФункции

#КонецОбласти
