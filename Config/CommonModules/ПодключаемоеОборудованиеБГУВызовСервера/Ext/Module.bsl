Процедура ЗаписатьДополнительныеСведенияКассовогоЧека(ДополнительныеСведения, ИдентификаторЗаписи = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ДополнительныеСведения.ДокументОснование) И
		ЗначениеЗаполнено(ДополнительныеСведения.Контрагент) Тогда
		ДокументОснование = ДополнительныеСведения.ДокументОснование;
		
		Если ЗначениеЗаполнено(ДополнительныеСведения.АбонентскийНомерТелефона) ИЛИ 
			ЗначениеЗаполнено(ДополнительныеСведения.АдресЭлектроннойПочты) Тогда
		
			Если ИдентификаторЗаписи = Неопределено Тогда
				ИдентификаторЗаписи = СокрЛП(ДокументОснование.УникальныйИдентификатор());
			КонецЕсли;	
			
			Физлицо = Справочники.ФизическиеЛица.ПустаяСсылка();
			Если ЗначениеЗаполнено(ДополнительныеСведения.Контрагент) Тогда
				ДанныеКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДополнительныеСведения.Контрагент, "ВидКонтрагента, ЮридическоеФизическоеЛицо");	
				Если ДанныеКонтрагента.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
					Физлицо = ДанныеКонтрагента.ЮридическоеФизическоеЛицо;
				КонецЕсли;	
			КонецЕсли;	
			
			НаборЗаписей = РегистрыСведений.СведенияДляФискальныхОпераций.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументОснование, Истина);
			НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи, Истина);
			НаборЗаписей.Отбор.Физлицо.Установить(Физлицо, Истина);
			
			НоваяСтрока = НаборЗаписей.Добавить();
			НоваяСтрока.ИдентификаторЗаписи = ИдентификаторЗаписи;
			НоваяСтрока.ДокументОснование = ДокументОснование;
			НоваяСтрока.Физлицо = Физлицо;
			НоваяСтрока.АбонентскийНомерТелефона = ДополнительныеСведения.АбонентскийНомерТелефона;
			НоваяСтрока.АдресЭлектроннойПочты = ДополнительныеСведения.АдресЭлектроннойПочты;
			НоваяСтрока.ОтказПокупателяОтСохраненияДанных = ДополнительныеСведения.ОтказПокупателяОтСохраненияДанных;
			
			НаборЗаписей.Записать();
		Иначе
			Физлицо = Справочники.ФизическиеЛица.ПустаяСсылка();
			Если ЗначениеЗаполнено(ДополнительныеСведения.Контрагент) Тогда
				ДанныеКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДополнительныеСведения.Контрагент, "ВидКонтрагента, ЮридическоеФизическоеЛицо");	
				Если ДанныеКонтрагента.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
					Физлицо = ДанныеКонтрагента.ЮридическоеФизическоеЛицо;
				КонецЕсли;	
			КонецЕсли;
			ДополнительныеСведения.Вставить("Физлицо", Физлицо);
			
			ОчиститьДополнительныеСведенияКассовогоЧека(ДополнительныеСведения, ИдентификаторЗаписи);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ДополнительныеСведенияКассовогоЧека(ДокументОснование, ИдентификаторЗаписи = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура;
	Результат.Вставить("АбонентскийНомерТелефона", "");
	Результат.Вставить("АдресЭлектроннойПочты", "");
	Результат.Вставить("ОтказПокупателяОтСохраненияДанных", Истина);
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СведенияДляФискальныхОпераций.АбонентскийНомерТелефона КАК АбонентскийНомерТелефона,
	               |	СведенияДляФискальныхОпераций.АдресЭлектроннойПочты КАК АдресЭлектроннойПочты,
	               |	СведенияДляФискальныхОпераций.Физлицо КАК Физлицо,
	               |	СведенияДляФискальныхОпераций.ОтказПокупателяОтСохраненияДанных КАК ОтказПокупателяОтСохраненияДанных
	               |ИЗ
	               |	РегистрСведений.СведенияДляФискальныхОпераций КАК СведенияДляФискальныхОпераций
	               |ГДЕ
	               |	СведенияДляФискальныхОпераций.ДокументОснование = &ДокументОснование
	               |	И СведенияДляФискальныхОпераций.ИдентификаторЗаписи = &ИдентификаторЗаписи";
	Если ИдентификаторЗаписи = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И СведенияДляФискальныхОпераций.ИдентификаторЗаписи = &ИдентификаторЗаписи", "");
	Иначе
		Запрос.УстановитьПараметр("ИдентификаторЗаписи", ИдентификаторЗаписи);
	КонецЕсли;	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.АбонентскийНомерТелефона = Выборка.АбонентскийНомерТелефона;
		Результат.АдресЭлектроннойПочты = Выборка.АдресЭлектроннойПочты;
		Результат.ОтказПокупателяОтСохраненияДанных = Выборка.ОтказПокупателяОтСохраненияДанных;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Процедура ОчиститьДополнительныеСведенияКассовогоЧека(ДополнительныеСведения, ИдентификаторЗаписи = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ДополнительныеСведения.ДокументОснование) Тогда
		ДокументОснование = ДополнительныеСведения.ДокументОснование;
		
		Если ИдентификаторЗаписи = Неопределено Тогда
			ИдентификаторЗаписи = СокрЛП(ДокументОснование.УникальныйИдентификатор());
		КонецЕсли;	
		
		Физлицо = Справочники.ФизическиеЛица.ПустаяСсылка();
		Если ЗначениеЗаполнено(ДополнительныеСведения.Физлицо) Тогда
			Физлицо = ДополнительныеСведения.Физлицо;
		КонецЕсли;	
		
		НаборЗаписей = РегистрыСведений.СведенияДляФискальныхОпераций.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументОснование, Истина);
		НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи, Истина);
		НаборЗаписей.Отбор.Физлицо.Установить(Физлицо, Истина);
		
		НаборЗаписей.Записать();
	КонецЕсли;
КонецПроцедуры

Функция ДополнительныеСведенияКассовыхЧеков(ДокументОснование) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СведенияДляФискальныхОпераций.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	               |	СведенияДляФискальныхОпераций.АбонентскийНомерТелефона КАК АбонентскийНомерТелефона,
	               |	СведенияДляФискальныхОпераций.АдресЭлектроннойПочты КАК АдресЭлектроннойПочты,
	               |	СведенияДляФискальныхОпераций.Физлицо КАК Физлицо
	               |ИЗ
	               |	РегистрСведений.СведенияДляФискальныхОпераций КАК СведенияДляФискальныхОпераций
	               |ГДЕ
	               |	СведенияДляФискальныхОпераций.ДокументОснование = &ДокументОснование";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

