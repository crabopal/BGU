Функция АдресаЭлектроннойПочты(Контрагент) Экспорт
	Результат = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
		ВидКИ = Новый Массив;
		ВидКИ.Добавить(Справочники.ВидыКонтактнойИнформации.EmailФизическиеЛица);
		ВидКИ.Добавить(Справочники.ВидыКонтактнойИнформации.EmailКонтрагенты);
		ТипКИ = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КонтрагентыКонтактнаяИнформация.АдресЭП КАК АдресЭП
			|ПОМЕСТИТЬ КонтактныеДанные
			|ИЗ
			|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
			|ГДЕ
			|	КонтрагентыКонтактнаяИнформация.Ссылка = &Ссылка
			|	И КонтрагентыКонтактнаяИнформация.Тип = &ТипКИ
			|	И КонтрагентыКонтактнаяИнформация.Вид В(&ВидКИ)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ФизическиеЛицаКонтактнаяИнформация.АдресЭП
			|ИЗ
			|	Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
			|ГДЕ
			|	ФизическиеЛицаКонтактнаяИнформация.Ссылка = &ЮридическоеФизическоеЛицо
			|	И ФизическиеЛицаКонтактнаяИнформация.Тип = &ТипКИ
			|	И ФизическиеЛицаКонтактнаяИнформация.Вид В(&ВидКИ)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	КонтактныеДанные.АдресЭП КАК АдресЭП
			|ИЗ
			|	КонтактныеДанные КАК КонтактныеДанные";			
			
		Запрос.УстановитьПараметр("ТипКИ", ТипКИ);
		Запрос.УстановитьПараметр("ВидКИ", ВидКИ);
		Запрос.УстановитьПараметр("Ссылка", Контрагент);
		Запрос.УстановитьПараметр("ЮридическоеФизическоеЛицо", Контрагент.ЮридическоеФизическоеЛицо);
		РезультатыЗапроса = Запрос.Выполнить();
		Выборка = РезультатыЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.АдресЭП) Тогда
				Результат.Добавить(Выборка.АдресЭП, Выборка.АдресЭП);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции

Функция НомераТелефоновКонтрагента(Контрагент) Экспорт
	Результат = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
			ВидКИ = Новый Массив;
			ВидКИ.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонДомашнийФизическиеЛица);
			ВидКИ.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты);
			ТипКИ = Перечисления.ТипыКонтактнойИнформации.Телефон;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КонтрагентыКонтактнаяИнформация.НомерТелефона КАК НомерТелефона
				|ПОМЕСТИТЬ КонтактныеДанные
				|ИЗ
				|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
				|ГДЕ
				|	КонтрагентыКонтактнаяИнформация.Ссылка = &Ссылка
				|	И КонтрагентыКонтактнаяИнформация.Тип = &ТипКИ
				|	И КонтрагентыКонтактнаяИнформация.Вид В(&ВидКИ)
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ФизическиеЛицаКонтактнаяИнформация.НомерТелефона
				|ИЗ
				|	Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
				|ГДЕ
				|	ФизическиеЛицаКонтактнаяИнформация.Ссылка = &ЮридическоеФизическоеЛицо
				|	И ФизическиеЛицаКонтактнаяИнформация.Тип = &ТипКИ
				|	И ФизическиеЛицаКонтактнаяИнформация.Вид В(&ВидКИ)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	КонтактныеДанные.НомерТелефона КАК НомерТелефона
				|ИЗ
				|	КонтактныеДанные КАК КонтактныеДанные";			
				
			Запрос.УстановитьПараметр("ТипКИ", ТипКИ);
			Запрос.УстановитьПараметр("ВидКИ", ВидКИ);
			Запрос.УстановитьПараметр("Ссылка", Контрагент);
			Запрос.УстановитьПараметр("ЮридическоеФизическоеЛицо", Контрагент.ЮридическоеФизическоеЛицо);
			РезультатыЗапроса = Запрос.Выполнить();
			Выборка = РезультатыЗапроса.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.НомерТелефона) Тогда
					НомерТелефона = СокрЛП(Выборка.НомерТелефона);
					Если СтрДлина(НомерТелефона) > 10 Тогда
						НомерТелефона = Прав(НомерТелефона, 10);
					КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
				
				ТелефонСтрокой = "";
				ПодключаемоеОборудованиеБГУ.ПреобразоватьТелефонКПользовательсткомуВиду(НомерТелефона, ТелефонСтрокой);
				
				Результат.Добавить(НомерТелефона, ТелефонСтрокой);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции	

Функция ПервыйАдресЭлектроннойПочтыПокупателя(Контрагент) Экспорт
