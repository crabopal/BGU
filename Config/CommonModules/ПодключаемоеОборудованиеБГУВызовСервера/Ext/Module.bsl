Функция РасшифровкаКассовогоПоступления(ДокументОснование) Экспорт
	ЕстьДоговорыБезПримененияККТ = Ложь;
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		РасшифровкаРезультат = ДокументОснование.РасшифровкаПлатежа.Выгрузить();
		РасшифровкаРезультат.Очистить();
		
		Расшифровка = ДокументОснование.РасшифровкаПлатежа.Выгрузить();
		Для каждого ТекСтрока Из Расшифровка Цикл
			Договор = ТекСтрока.Договор;
			Если Значениезаполнено(Договор) Тогда
				Если Договор.НеПрименятьККТКромеРасчетовНаличнымиИЭСП Тогда
					ЕстьДоговорыБезПримененияККТ = Истина;
				Иначе	
					НоваяСтрока = РасшифровкаРезультат.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
		
		Результат = Новый Структура;
		Результат.Вставить("ЕстьДоговорыБезПримененияККТ", ЕстьДоговорыБезПримененияККТ);
		Результат.Вставить("Расшифровка", РасшифровкаРезультат);
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

