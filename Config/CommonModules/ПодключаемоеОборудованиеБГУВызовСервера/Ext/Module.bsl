Функция СекцияДляНоменклатуры(НастройкаРаспределенияВыручкиПоСекциям, Номенклатура)
	Результат = 0;
	
	НастройкаРаспределенияНоменклатуры = НастройкаРаспределенияВыручкиПоСекциям.СоответствиеНоменклатурыСекциям.Выгрузить();

	Результат = СекцияГруппы(Номенклатура, НастройкаРаспределенияНоменклатуры, Ложь); 	
	
	Возврат Результат;
КонецФункции

Функция СекцияГруппы(ГруппаНоменклатуры, НастройкаРаспределения, ОкончаниеПоиска)
	НайденнаяСтрока = НастройкаРаспределения.Найти(ГруппаНоменклатуры, "Номенклатура");
	Если НЕ (НайденнаяСтрока = Неопределено) Тогда
		Результат = НайденнаяСтрока.НомерСекции;
		ОкончаниеПоиска = Истина;
	ИначеЕсли НЕ ЗначениеЗаполнено(ГруппаНоменклатуры.Родитель) Тогда
		ОкончаниеПоиска = Истина;
	КонецЕсли;
	
	Если НЕ ОкончаниеПоиска Тогда
		Результат = СекцияГруппы(ГруппаНоменклатуры.Родитель, НастройкаРаспределения, ОкончаниеПоиска);
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция СекциюПоУмолчанию(ТипДокумента, НастройкаРаспределенияВыручкиПоСекциям)
	Результат = 0;
	
	Если ТипДокумента = 1 Тогда
		Результат = НастройкаРаспределенияВыручкиПоСекциям.НомерСекцииДляПриходныхКассовыхОрдеров;		
	ИначеЕсли ТипДокумента = 2 Тогда
		Результат = НастройкаРаспределенияВыручкиПоСекциям.НомерСекцииДляРасходныхКассовыхОрдеров;		
	ИначеЕсли ТипДокумента = 3 Тогда
		Результат = НастройкаРаспределенияВыручкиПоСекциям.НомерСекцииДляОплатыКартой;		
	ИначеЕсли ТипДокумента = 4 Тогда
		Результат = НастройкаРаспределенияВыручкиПоСекциям.НомерСекцииДляВозвратаОплатыНаКарту;
	ИначеЕсли ТипДокумента = 5 Тогда
		Результат = НастройкаРаспределенияВыручкиПоСекциям.НомерСекцииДляРозничнойОплаты;		
	ИначеЕсли ТипДокумента = 6 Тогда
		Результат = НастройкаРаспределенияВыручкиПоСекциям.НомерСекцииДляВозвратаРозничнойОплаты;
	ИначеЕсли ТипДокумента = 7 Тогда
		Результат = НастройкаРаспределенияВыручкиПоСекциям.НомерСекцииДляЧековНаПередачу;
	ИначеЕсли (ТипДокумента > 7) И (ТипДокумента < 15) Тогда
		Результат = НастройкаРаспределенияВыручкиПоСекциям.НомерСекцииДляРасчетноПлатежныхДокументов;
	Иначе
		Результат = НастройкаРаспределенияВыручкиПоСекциям.НомерСекцииПоУмолчаниюДляФискальныхЧеков;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Процедура ОбработатьПереходСправочникаПодключаемоеОборудованиеНаОфлайнОборудование(СсылкаНаПодключаемоеОборудование, СсылкаНаОфлайнОборудование) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ФискальныеРегистраторы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ФискальныеРегистраторы КАК ФискальныеРегистраторы
	               |ГДЕ
	               |	ФискальныеРегистраторы.ПодключаемоеОборудование = &ПодключаемоеОборудование";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПодключаемоеОборудование", СсылкаНаПодключаемоеОборудование);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Пока РезультатЗапроса.Следующий() Цикл  
		СправочникОбъект 							= РезультатЗапроса.Ссылка.ПолучитьОбъект();
		СправочникОбъект.ПодключаемоеОборудование 	= Справочники.ПодключаемоеОборудование.ПустаяСсылка();
		СправочникОбъект.ТипОборудования 			= 1;
		СправочникОбъект.ОффлайнОборудование		= СсылкаНаОфлайнОборудование;
		СправочникОбъект.Записать();
	КонецЦикла;	 
	
КонецПроцедуры 

Процедура ДополнительнаяОбработкаОбъектовПриПереходеНаОфлайнОборудование() Экспорт 
	
	ПравилаОбменаВыборка = Справочники.ПравилаОбменаСПодключаемымОборудованием.Выбрать();
	Пока ПравилаОбменаВыборка.Следующий() Цикл     
		Если НЕ ЗначениеЗаполнено(ПравилаОбменаВыборка.ТипПодключаемогоОборудования) Тогда 
			ПравилоОбменаОбъект = ПравилаОбменаВыборка.ПолучитьОбъект();
			ПравилоОбменаОбъект.ТипПодключаемогоОборудования = Перечисления.ТипыОфлайнОборудования.ККМ;
			ПравилоОбменаОбъект.Записать();
		КонецЕсли;
	КонецЦикла;			
	
КонецПроцедуры	

