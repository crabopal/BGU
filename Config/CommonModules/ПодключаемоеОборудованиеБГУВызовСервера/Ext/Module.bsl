
#Область ПрограммныйИнтерфейс

// Функция выполняет получение параметров кассы ККМ.
//
Функция ПолучитьПараметрыКассыККМ(КассаККМ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КассыККМ.ПодключаемоеОборудование КАК ИдентификаторУстройства,
	|	КассыККМ.Наименование КАК Наименование,
	|	КассыККМ.Организация КАК Организация,
	|	КассыККМ.ИспользоватьБезПодключенияОборудования КАК ИспользоватьБезПодключенияОборудования,
	|	КассыККМ.ЭлектронныйЧекSMSПередаютсяПрограммой1С КАК ЭлектронныйЧекSMSПередаютсяПрограммой1С,
	|	КассыККМ.ЭлектронныйЧекEmailПередаютсяПрограммой1С КАК ЭлектронныйЧекEmailПередаютсяПрограммой1С,
	|	КассыККМ.ИспользоватьДляПечатиРасчетныхДокументовБезПримененияККТ КАК ИспользоватьБезПримененияККТ,
	|	КассыККМ.РеализацияСНулевойЦенойРМК КАК РеализацияСНулевойЦенойРМК
	|ИЗ
	|	Справочник.ФискальныеРегистраторы КАК КассыККМ
	|ГДЕ
	|	КассыККМ.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", КассаККМ);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Новый Структура("ИдентификаторУстройства,
								|Наименование,
								|Организация,
								|ИспользоватьБезПодключенияОборудования,
								|ИспользоватьБезПримененияККТ,
								|ЭлектронныйЧекSMSПередаютсяПрограммой1С,
								|ЭлектронныйЧекEmailПередаютсяПрограммой1С,
								|РеализацияСНулевойЦенойРМК",
								Выборка.ИдентификаторУстройства,
								Выборка.Наименование,
								Выборка.Организация,
								Выборка.ИспользоватьБезПодключенияОборудования,
								Выборка.ИспользоватьБезПримененияККТ,
								Выборка.ЭлектронныйЧекSMSПередаютсяПрограммой1С,
								Выборка.ЭлектронныйЧекEmailПередаютсяПрограммой1С,
								Выборка.РеализацияСНулевойЦенойРМК
				);
		
	Иначе
		
		Возврат Новый Структура("ИдентификаторУстройства,
								|Наименование,
								|Организация,
								|ИспользоватьБезПодключенияОборудования,
								|ИспользоватьБезПримененияККТ,
								|ЭлектронныйЧекSMSПередаютсяПрограммой1С,
								|ЭлектронныйЧекEmailПередаютсяПрограммой1С,
								|РеализацияСНулевойЦенойРМК",
								Справочники.ПодключаемоеОборудование.ПустаяСсылка(),
								"",
								Справочники.Организации.ПустаяСсылка(),
								Истина,
								Ложь,
								Ложь,
								Ложь,
								Ложь
				);
		
	КонецЕсли;
	
КонецФункции // ПолучитьПараметрыКассыККМ()

// Получает распределение выручки по секциям фискального регистратора.
//
Функция ПолучитьРаспределениеВыручкиПоСекциям() Экспорт
	
	Результат = Новый Структура;   
	
	Результат.Вставить("НомерСекцииДляПриходныхКассовыхОрдеров"  	, 2);
	Результат.Вставить("НомерСекцииДляРасходныхКассовыхОрдеров"  	, 2);
	Результат.Вставить("НомерСекцииДляОплатыКартой"              	, 2);
	Результат.Вставить("НомерСекцииДляВозвратаОплатыНаКарту"     	, 2);
	Результат.Вставить("НомерСекцииДляРозничнойОплаты"           	, 2);
	Результат.Вставить("НомерСекцииДляВозвратаРозничнойОплаты"   	, 2);
	Результат.Вставить("НомерСекцииДляЧековНаПередачу"           	, 2);
	Результат.Вставить("НомерСекцииДляРасчетноПлатежныхДокументов"  , 2);
	
	Результат.Вставить("НомерСекцииПоУмолчаниюДляФискальныхЧеков", 1);
	
	Возврат Результат;

КонецФункции

// Заполнить соответствие секций фискального регистратора для табличной части по кассе ККМ.
// 
Процедура ЗаполнитьСоответствиеСекцийДляТабличнойЧастиПоКассеККМ(ДокументСсылка, КассаККМ, СистемаНалогообложенияЧекаККМ,
	Знач Товары, ТаблицаТоваровСоответствииСекциям, ПараметрыДоговораПлатежногоАгентаИзСписка = Неопределено) Экспорт
	
	Секция = 0;
	ЕстьНастройкаРаспределенияВыручкиПоСекциям = Ложь;
	ЕстьСоответствиеПоАгентскимДоговорам = Ложь;
	
	ТипДокумента = ТипДокумента(ДокументСсылка);
	
	НастройкаРаспределенияВыручкиПоСекциям = КассаККМ.НастройкаРаспределенияВыручкиПоСекциям;
	
	Если ЗначениеЗаполнено(НастройкаРаспределенияВыручкиПоСекциям) Тогда
		ЕстьНастройкаРаспределенияВыручкиПоСекциям = Истина;
		
		Если ПараметрыДоговораПлатежногоАгентаИзСписка = Неопределено Тогда
			ПараметрыДоговораПлатежногоАгента = ДокументСсылка.ПараметрыДоговораПлатежногоАгента;
		Иначе	
			ПараметрыДоговораПлатежногоАгента = ПараметрыДоговораПлатежногоАгентаИзСписка;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ПараметрыДоговораПлатежногоАгента) Тогда
			ЕстьСоответствиеПоАгентскимДоговорам = Истина;
			СоответствиеПоАгентскимДоговорам = НастройкаРаспределенияВыручкиПоСекциям.СоответствиеДоговоровПлатежныхАгентовСекциям;
			Если СоответствиеПоАгентскимДоговорам.Количество()>0 Тогда
				СоответствующаяСекция = СекцияАгентскогоДоговора(СоответствиеПоАгентскимДоговорам, ПараметрыДоговораПлатежногоАгента); 	
				Если СоответствующаяСекция = Неопределено Тогда
					Секция = СекциюПоУмолчанию(ТипДокумента, НастройкаРаспределенияВыручкиПоСекциям);
				Иначе
					Секция = СоответствующаяСекция;	
				КонецЕсли;	
			Иначе
				Секция = СекциюПоУмолчанию(ТипДокумента, НастройкаРаспределенияВыручкиПоСекциям);
			КонецЕсли;	
		Иначе
			Секция = СекциюПоУмолчанию(ТипДокумента, НастройкаРаспределенияВыручкиПоСекциям);
		КонецЕсли;
		Если Секция = 0 Тогда
			Секция = СекциюПоУмолчанию(0, НастройкаРаспределенияВыручкиПоСекциям);	
		КонецЕсли;
	Иначе
		Если ТипДокумента > 0 Тогда
			Секция = 2;
		Иначе
			Секция = 1;
		КонецЕсли;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкаРаспределенияВыручкиПоСекциям) Тогда
		СоответствиеСистемНалогообложения = НастройкаРаспределенияВыручкиПоСекциям.СоответствиеСистемНалогообложения;
		Если СоответствиеСистемНалогообложения.Количество() > 0 Тогда
			НайденнаяСтрока = СоответствиеСистемНалогообложения.Найти(СистемаНалогообложенияЧекаККМ, "СистемаНалогообложения");
			Если НЕ НайденнаяСтрока = Неопределено Тогда
				Секция = НайденнаяСтрока.НомерСекции;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		СекцияДляНоменклатуры = 0;
		Если НЕ ЕстьСоответствиеПоАгентскимДоговорам Тогда
			Если ЕстьНастройкаРаспределенияВыручкиПоСекциям Тогда
				Если НастройкаРаспределенияВыручкиПоСекциям.СоответствиеНоменклатурыСекциям.Количество() > 0 Тогда
					СекцияДляНоменклатуры = СекцияДляНоменклатуры(НастройкаРаспределенияВыручкиПоСекциям, СтрокаТЧ.Номенклатура);
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
		СтрокаТЧ.НомерСекции = ?(СекцияДляНоменклатуры = 0, Секция, СекцияДляНоменклатуры);
		ТаблицаТоваровСоответствииСекциям.Вставить(СтрокаТЧ.НомерСтроки, ?(СекцияДляНоменклатуры = 0, Секция, СекцияДляНоменклатуры));
	КонецЦикла;
	
КонецПроцедуры

Функция ТипДокумента(ДокументСсылка) Экспорт
	Результат = 0;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		Результат = 1;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		Результат = 2;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЭквайринговаяОперация") Тогда
		Если ДокументСсылка.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаПлатежнойКартой
			ИЛИ ДокументСсылка.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ОплатаЧерезСервисПриемаПлатежей Тогда
			Результат = 3;
		ИначеЕсли ДокументСсылка.ВидОперации = Перечисления.ВидыОперацииЭквайринга.ВозвратОплатыПлатежнойКартой Тогда
			Результат = 4;
		КонецЕсли;	
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЧекККМ") Тогда
		Результат = 5;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЧекККМНаВозврат") Тогда
		Результат = 6;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЧекККМНаПередачу") Тогда
		Результат = 7;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КассовоеПоступление") Тогда
		Результат = 8;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход") Тогда
		Результат = 9;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная") Тогда
		Результат = 10;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПлатежноеПоручение") Тогда
		Результат = 11;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаявкаНаВозврат") Тогда
		Результат = 12;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
		Результат = 13;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЧекиККМДляРеестраПлатежей") Тогда
		Результат = 14;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЧекККМИсправительный") Тогда
		Если ДокументСсылка.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.НеприменениеККТ Тогда
			Результат = 16;
		ИначеЕсли ДокументСсылка.ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.ИсправлениеКассовогоЧекаККМ Тогда
			Результат = 15;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПоступлениеНаСчет") Тогда
		Результат = 17;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РСКПВозврат") Тогда
		Результат = 18;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РСКППеречисление") Тогда
		Результат = 19;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция СекцияАгентскогоДоговора(ТаблицаДоговоровИСекций, ПараметрыДоговора)
	Результат = Неопределено;
	
	Отбор = Новый Структура("ПараметрыДоговораПлатежногоАгента", ПараметрыДоговора);
	НайденныеСтроки = ТаблицаДоговоровИСекций.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Результат = НайденныеСтроки[0].НомерСекции;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ПолучитьНастройкиОборудования(РабочееМесто, Организация = Неопределено) Экспорт
	
	СтруктураДанныхЭквайринга = Новый Структура("ПараметрыДоговораЭквайринга, ЭквайринговыйТерминал, ФискальныйРегистратор, ПараметрыДоговораПлатежногоАгента");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НастройкиЭквайрингаДляРабочихМест.ПараметрыДоговораЭквайринга КАК ПараметрыДоговораЭквайринга,
	|	НастройкиЭквайрингаДляРабочихМест.ЭквайринговыйТерминал КАК ЭквайринговыйТерминал,
	|	НастройкиЭквайрингаДляРабочихМест.ФискальныйРегистратор КАК ФискальныйРегистратор,
	|	НастройкиЭквайрингаДляРабочихМест.ПараметрыДоговораПлатежногоАгента КАК ПараметрыДоговораПлатежногоАгента,
	|	НастройкиЭквайрингаДляРабочихМест.ПараметрыДоговораОплатыПоQRКоду КАК ПараметрыДоговораОплатыПоQRКоду
	|ИЗ
	|	РегистрСведений.НастройкиЭквайрингаДляРабочихМест КАК НастройкиЭквайрингаДляРабочихМест
	|ГДЕ
	|	НастройкиЭквайрингаДляРабочихМест.РабочееМесто = &РабочееМесто
	|	И ИСТИНА";
	
	Если ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьЦентрализованнуюБухгалтерию") Тогда
		Если НЕ Организация = Неопределено Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ИСТИНА", "И НастройкиЭквайрингаДляРабочихМест.Организация = &Организация");
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураДанныхЭквайринга.Вставить("ПараметрыДоговораЭквайринга", Выборка.ПараметрыДоговораЭквайринга);
		СтруктураДанныхЭквайринга.Вставить("ЭквайринговыйТерминал", Выборка.ЭквайринговыйТерминал);
		СтруктураДанныхЭквайринга.Вставить("ФискальныйРегистратор", Выборка.ФискальныйРегистратор);
		СтруктураДанныхЭквайринга.Вставить("ПараметрыДоговораПлатежногоАгента", Выборка.ПараметрыДоговораПлатежногоАгента);
		СтруктураДанныхЭквайринга.Вставить("ПараметрыДоговораОплатыПоQRКоду", Выборка.ПараметрыДоговораОплатыПоQRКоду);
	Иначе
		СтруктураДанныхЭквайринга.Вставить("ПараметрыДоговораЭквайринга", Справочники.ПараметрыДоговораЭквайринга.ПустаяСсылка());
		СтруктураДанныхЭквайринга.Вставить("ЭквайринговыйТерминал", Справочники.ЭквайринговыеТерминалы.ПустаяСсылка());
		СтруктураДанныхЭквайринга.Вставить("ФискальныйРегистратор", Справочники.ФискальныеРегистраторы.ПустаяСсылка());
		СтруктураДанныхЭквайринга.Вставить("ПараметрыДоговораПлатежногоАгента", Справочники.ПараметрыДоговораПлатежногоАгента.ПустаяСсылка());
		СтруктураДанныхЭквайринга.Вставить("ПараметрыДоговораОплатыПоQRКоду", Справочники.ПараметрыДоговораЭквайринга.ПустаяСсылка());
	КонецЕсли;
	
	Возврат СтруктураДанныхЭквайринга;
	
КонецФункции

Функция ПолучитьККТДляВсехОрганизацийРабочегоМеста(РабочееМесто) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НастройкиЭквайрингаДляРабочихМест.ФискальныйРегистратор КАК КассаККМ
	|ПОМЕСТИТЬ СписокККТ
	|ИЗ
	|	РегистрСведений.НастройкиЭквайрингаДляРабочихМест КАК НастройкиЭквайрингаДляРабочихМест
	|ГДЕ
	|	НастройкиЭквайрингаДляРабочихМест.РабочееМесто = &РабочееМесто
	|	И НЕ НастройкиЭквайрингаДляРабочихМест.ФискальныйРегистратор = &ПустаяКассаККТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокККТ.КассаККМ КАК КассаККМ
	|ИЗ
	|	СписокККТ КАК СписокККТ
	|ГДЕ
	|	СписокККТ.КассаККМ.ПометкаУдаления = ЛОЖЬ
	|	И СписокККТ.КассаККМ.ИспользоватьДляПечатиРасчетныхДокументовБезПримененияККТ = ЛОЖЬ
	|	И СписокККТ.КассаККМ.ИспользоватьБезПодключенияОборудования = ЛОЖЬ";
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.УстановитьПараметр("ПустаяКассаККТ", Справочники.ФискальныеРегистраторы.ПустаяСсылка());
	
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выгрузить();
	
	Возврат Результат;
	
КонецФункции

// Получает доступное подключаемое оборудование.
//
Процедура ПолучитьДоступноеПодключаемоеОборудование(ИспользоватьПодключаемоеОборудование, ЕстьТСД = Ложь) Экспорт
	
	ТипыПодключенногоОборудования = МенеджерОборудованияВызовСервера.ТипыИспользуемогоОборудованияТекущегоРабочегоМеста();
	
	ИспользоватьПодключаемоеОборудование = ПодключаемоеОборудованиеБГУ.ИспользоватьПодключаемоеОборудование(ТипыПодключенногоОборудования);
	
	ЕстьТСД = ИспользоватьПодключаемоеОборудование 
		И ТипыПодключенногоОборудования <> Неопределено
		И ТипыПодключенногоОборудования.Найти(Перечисления.ТипыПодключаемогоОборудования.ТерминалСбораДанных) <> Неопределено;
		
КонецПроцедуры

// Проверяет, что включена ф.о "Использовать подключаемое оборудование" и авторизовался пользователь,
// а не внешний пользователь.
Функция ИспользоватьПодключаемоеОборудование() Экспорт
	
	Возврат ТипЗнч(Пользователи.АвторизованныйПользователь()) = Тип("СправочникСсылка.Пользователи");
	
КонецФункции

// Процедура выполняет закрытие кассовой смены.
//
Функция ЗакрытьКассовуюСмену(КассаККМ, ОписаниеОшибки, СсылкаНаОтчет) Экспорт
	
	Возврат ПодключаемоеОборудованиеБГУ.ЗакрытьКассовуюСмену(КассаККМ, ОписаниеОшибки, СсылкаНаОтчет);
	
КонецФункции // ЗакрытьКассовуюСменуСервер()

// Возвращает ФИО физлица, указанного в текущем пользоватле, с учем замены прав в РМК
Функция ФИОФизЛицаПользователяСУчетомИзмененныхПрав() Экспорт
	
	Пользователь = ПользователиКлиентСервер.ТекущийПользователь();
	
	ФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пользователь, "ФизическоеЛицо");
	
	Если Не ЗначениеЗаполнено(ФизЛицо) Тогда
		Возврат "";
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Наименование");
	РеквизитыКассир = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ФизЛицо, СтруктураРеквизитов);
	
	ДолжностьДляЧекаККМ = ПодключаемоеОборудованиеБГУ.ДолжностьДляЧекаККМ(ФизЛицо, Текущаядата());
	ЗначениеПоляКассир = СокрЛП(ДолжностьДляЧекаККМ + " " + РеквизитыКассир.Наименование);
	
	СтрокаФИО = ЗначениеПоляКассир;
	
	Возврат СтрокаФИО;
	
КонецФункции

// Получает последний порядковый номер документа (чека) для КассыККМ
//
Функция ПолучитьПоследнийНомерДокументаКассыККМ(Ссылка) Экспорт
	НомерЧекаККМ = 0;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ОплатаОтПокупателяПлатежнойКартой.НомерЧекаККМ), 0) КАК НомерЧекаККМ
	                      |ПОМЕСТИТЬ ТаблицаПоследнихДокументов
	                      |ИЗ
	                      |	Документ.ЭквайринговаяОперация КАК ОплатаОтПокупателяПлатежнойКартой
	                      |ГДЕ
	                      |	ОплатаОтПокупателяПлатежнойКартой.ФискальныйРегистратор = &КассаККМ
	                      |	И ОплатаОтПокупателяПлатежнойКартой.ДатаЧекаККМ МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ПриходныйКассовыйОрдер.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	                      |ГДЕ
	                      |	ПриходныйКассовыйОрдер.КассаККМ = &КассаККМ
	                      |	И ПриходныйКассовыйОрдер.ДатаЧекаККМ МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(РасходныйКассовыйОрдер.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	                      |ГДЕ
	                      |	РасходныйКассовыйОрдер.КассаККМ = &КассаККМ
	                      |	И РасходныйКассовыйОрдер.КассаККМ МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ЧекККМ.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЧекККМ КАК ЧекККМ
	                      |ГДЕ
	                      |	ЧекККМ.КассаККМ = &КассаККМ
	                      |	И ЧекККМ.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ЧекККМНаВозврат.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЧекККМНаВозврат КАК ЧекККМНаВозврат
	                      |ГДЕ
	                      |	ЧекККМНаВозврат.КассаККМ = &КассаККМ
	                      |	И ЧекККМНаВозврат.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ЧекККМНаПередачу.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЧекККМНаПередачу КАК ЧекККМНаПередачу
	                      |ГДЕ
	                      |	ЧекККМНаПередачу.КассаККМ = &КассаККМ
	                      |	И ЧекККМНаПередачу.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(КассовоеПоступление.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.КассовоеПоступление КАК КассовоеПоступление
	                      |ГДЕ
	                      |	КассовоеПоступление.КассаККМ = &КассаККМ
	                      |	И КассовоеПоступление.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ЗаявкаНаКассовыйРасход.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЗаявкаНаКассовыйРасход КАК ЗаявкаНаКассовыйРасход
	                      |ГДЕ
	                      |	ЗаявкаНаКассовыйРасход.КассаККМ = &КассаККМ
	                      |	И ЗаявкаНаКассовыйРасход.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ЗаявкаНаКассовыйРасходСокращенная.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЗаявкаНаКассовыйРасходСокращенная КАК ЗаявкаНаКассовыйРасходСокращенная
	                      |ГДЕ
	                      |	ЗаявкаНаКассовыйРасходСокращенная.КассаККМ = &КассаККМ
	                      |	И ЗаявкаНаКассовыйРасходСокращенная.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ПлатежноеПоручение.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	                      |ГДЕ
	                      |	ПлатежноеПоручение.КассаККМ = &КассаККМ
	                      |	И ПлатежноеПоручение.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ЗаявкаНаВозврат.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЗаявкаНаВозврат КАК ЗаявкаНаВозврат
	                      |ГДЕ
	                      |	ЗаявкаНаВозврат.КассаККМ = &КассаККМ
	                      |	И ЗаявкаНаВозврат.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(КассовоеВыбытие.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.КассовоеВыбытие КАК КассовоеВыбытие
	                      |ГДЕ
	                      |	КассовоеВыбытие.КассаККМ = &КассаККМ
	                      |	И КассовоеВыбытие.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ЧекиККМДляРеестраПлатежейЧекиККМ.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЧекиККМДляРеестраПлатежей.ЧекиККМ КАК ЧекиККМДляРеестраПлатежейЧекиККМ
	                      |ГДЕ
	                      |	ЧекиККМДляРеестраПлатежейЧекиККМ.Ссылка.КассаККМ = &КассаККМ
	                      |	И ЧекиККМДляРеестраПлатежейЧекиККМ.Ссылка.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЭквайринговаяОперация КАК ОплатаОтПокупателяПлатежнойКартой
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО ОплатаОтПокупателяПлатежнойКартой.Ссылка = ФискальныеОперации.ДокументОснование
	                      |ГДЕ
	                      |	ОплатаОтПокупателяПлатежнойКартой.ФискальныйРегистратор = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО ПриходныйКассовыйОрдер.Ссылка = ФискальныеОперации.ДокументОснование
	                      |ГДЕ
	                      |	ПриходныйКассовыйОрдер.КассаККМ = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО РасходныйКассовыйОрдер.Ссылка = ФискальныеОперации.ДокументОснование
	                      |ГДЕ
	                      |	РасходныйКассовыйОрдер.КассаККМ = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЧекККМ КАК ЧекККМ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО ЧекККМ.Ссылка = ФискальныеОперации.ДокументОснование
	                      |ГДЕ
	                      |	ЧекККМ.КассаККМ = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЧекККМНаВозврат КАК ЧекККМНаВозврат
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО ЧекККМНаВозврат.Ссылка = ФискальныеОперации.ДокументОснование
	                      |ГДЕ
	                      |	ЧекККМНаВозврат.КассаККМ = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЧекККМНаПередачу КАК ЧекККМНаПередачу
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО ЧекККМНаПередачу.Ссылка = ФискальныеОперации.ДокументОснование
	                      |ГДЕ
	                      |	ЧекККМНаПередачу.КассаККМ = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.КассовоеПоступление КАК КассовоеПоступление
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО КассовоеПоступление.Ссылка = ФискальныеОперации.ДокументОснование
	                      |ГДЕ
	                      |	КассовоеПоступление.КассаККМ = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЗаявкаНаКассовыйРасход КАК ЗаявкаНаКассовыйРасход
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО ЗаявкаНаКассовыйРасход.Ссылка = ФискальныеОперации.ДокументОснование
	                      |ГДЕ
	                      |	ЗаявкаНаКассовыйРасход.КассаККМ = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЗаявкаНаКассовыйРасходСокращенная КАК ЗаявкаНаКассовыйРасходСокращенная
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО ЗаявкаНаКассовыйРасходСокращенная.Ссылка = ФискальныеОперации.ДокументОснование
	                      |ГДЕ
	                      |	ЗаявкаНаКассовыйРасходСокращенная.КассаККМ = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО ПлатежноеПоручение.Ссылка = ФискальныеОперации.ДокументОснование
	                      |ГДЕ
	                      |	ПлатежноеПоручение.КассаККМ = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЗаявкаНаВозврат КАК ЗаявкаНаВозврат
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО ЗаявкаНаВозврат.Ссылка = ФискальныеОперации.ДокументОснование
	                      |ГДЕ
	                      |	ЗаявкаНаВозврат.КассаККМ = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.КассовоеВыбытие КАК КассовоеВыбытие
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО КассовоеВыбытие.Ссылка = ФискальныеОперации.ДокументОснование
	                      |ГДЕ
	                      |	КассовоеВыбытие.КассаККМ = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ФискальныеОперации.НомерЧекаККМ), 0)
	                      |ИЗ
	                      |	Документ.ЧекиККМДляРеестраПлатежей.ЧекиККМ КАК ЧекиККМДляРеестраПлатежейЧекиККМ
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	                      |		ПО ЧекиККМДляРеестраПлатежейЧекиККМ.Ссылка = ФискальныеОперации.ДокументОснование
	                      |			И ЧекиККМДляРеестраПлатежейЧекиККМ.КлючЧека = ФискальныеОперации.ИдентификаторЗаписи
	                      |ГДЕ
	                      |	ЧекиККМДляРеестраПлатежейЧекиККМ.Ссылка.КассаККМ = &КассаККМ
	                      |	И ФискальныеОперации.Дата МЕЖДУ &ДатаНачалаГода И &ДатаОкончанияГода
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ЕСТЬNULL(МАКСИМУМ(ТаблицаПоследнихДокументов.НомерЧекаККМ), 0) КАК НомерЧекаККМ
	                      |ПОМЕСТИТЬ ТаблицаПоследнихНомеров
	                      |ИЗ
	                      |	ТаблицаПоследнихДокументов КАК ТаблицаПоследнихДокументов
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ТаблицаПоследнихНомеров.НомерЧекаККМ КАК НомерЧекаККМ
	                      |ИЗ
	                      |	ТаблицаПоследнихНомеров КАК ТаблицаПоследнихНомеров
	                      |ГДЕ
	                      |	ТаблицаПоследнихНомеров.НомерЧекаККМ <> 0");
	Запрос.УстановитьПараметр("КассаККМ", Ссылка);
	Запрос.УстановитьПараметр("ДатаНачалаГода", НачалоГода(ТекущаяДата()));
	Запрос.УстановитьПараметр("ДатаОкончанияГода", КонецГода(ТекущаяДата()));
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			НомерЧекаККМ = Выборка.НомерЧекаККМ + 1;
		КонецЦикла; 
	КонецЕсли; 

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат НомерЧекаККМ;
	
КонецФункции

// Функция обрабатывает получение штрихкода от сканера штрихкодов.
//
Функция ПолученШтрихкодИзСШК(Штрихкод, Форма) Экспорт
	
	СтруктураРезультат = ДанныеПоискаПоШтрихкоду(Штрихкод, Форма);
	
	НайденоОбъектов = СтруктураРезультат.ЗначенияПоиска.Количество();
	Если НайденоОбъектов = 1 Тогда
		Форма.ОбработатьДанныеПоКодуСервер(СтруктураРезультат);
	ИначеЕсли НайденоОбъектов > 1 Тогда
		ПодготовитьДанныеДляВыбора(СтруктураРезультат);
	КонецЕсли;
	
	Возврат СтруктураРезультат;
	
КонецФункции

// Обработка полученного штрихкода.
// Штрихкод - Строка
// Форма - Форма, в которой определен обработчик действия "ПолученыШтрихкоды"
// СтруктураДействий, ключи: ПроверкаВесовыхТоваров, 
//                           ПроверкаТоваров,
//                           ПроверкаСерийныхНомеров,
//                           ПроверкаКарт [РегистрацияНовойКарты, Пользователь].
//
Функция ДанныеПоискаПоШтрихкоду(Штрихкод, Форма) Экспорт
	
	Если Форма.ПараметрыСобытийПО = Неопределено Тогда
		СтруктураДействий = Новый Структура;
	Иначе
		СтруктураДействий = Форма.ПараметрыСобытийПО;
	КонецЕсли;
	
	НеизвестныеДанныеПО = Истина;
	
	Объект = Форма.Объект;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Прейскурант.Ссылка
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |ГДЕ
	               |	Прейскурант.Штрихкод = &Штрихкод
	               |	И Прейскурант.Организация = &Организация
	               |	И Прейскурант.СнятаСПродажи = ЛОЖЬ
	               |	И Прейскурант.ПометкаУдаления = ЛОЖЬ";
				   
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	НайденоОбъектов = Выборка.Количество();
	СтруктураПараметров = СтруктураДанныхПоиска();
	
	Пока Выборка.Следующий() Цикл
		СтруктураПараметров.ЗначенияПоиска.Добавить(Выборка.Ссылка);
		НеизвестныеДанныеПО = Ложь;
	КонецЦикла;	
	
	СтруктураПараметров.НеизвестныеДанныеПО = НеизвестныеДанныеПО;
	СтруктураПараметров.ДанныеПО = Штрихкод;
	СтруктураПараметров.ТипДанныхПО = "Штрихкод";
	
	Возврат СтруктураПараметров;
	
КонецФункции	

// Функция формирует предопределенную структуру,
// Которая используется при поиске по ШК, магнитному коду и загрузке из ТСД,
// В том числе, и при ручном вводе позиций.
Функция СтруктураДанныхПоиска() Экспорт
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("ЗначенияПоиска", Новый Массив);
	СтруктураПараметров.Вставить("НеизвестныеДанныеПО", Истина);
	СтруктураПараметров.Вставить("ДанныеПО", "");
	СтруктураПараметров.Вставить("ТипДанныхПО", "Штрихкод");
	
	Возврат СтруктураПараметров;
	
КонецФункции

// Подготовка данных для выбора.
//
Процедура ПодготовитьДанныеДляВыбора(СтруктураРезультат) Экспорт
	
	ТаблицаВыбора = Новый ТаблицаЗначений;
	ТаблицаВыбора.Колонки.Добавить("ШтрихКод");
	ТаблицаВыбора.Колонки.Добавить("ТипШтрихКода");
	ТаблицаВыбора.Колонки.Добавить("Номенклатура");
	ТаблицаВыбора.Колонки.Добавить("Характеристика");
	ТаблицаВыбора.Колонки.Добавить("Упаковка");
	ТаблицаВыбора.Колонки.Добавить("Количество");
	ТаблицаВыбора.Колонки.Добавить("СерийныйНомер");
	
	Для Каждого СтрокаТовара Из СтруктураРезультат.ЗначенияПоиска Цикл
		НоваяСтрока = ТаблицаВыбора.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара);
		НоваяСтрока.Номенклатура = СтрокаТовара.Ссылка;
	КонецЦикла;
	
	СтруктураВыбора = Новый Структура;
	СтруктураВыбора.Вставить("ТаблицаВыбора", ТаблицаВыбора);
	Если СтруктураРезультат.ТипДанныхПО = "Штрихкод" Тогда
		СтруктураВыбора.Вставить("Штрихкод", СтруктураРезультат.ДанныеПО);
	КонецЕсли;
	СтруктураРезультат.Вставить("ВыборДанныхПоиска", ПоместитьВоВременноеХранилище(СтруктураВыбора));

КонецПроцедуры

#КонецОбласти

#Область ОфлайнОборудование

#Область ПрограммныйИнтерфейс

Функция ЕстьОбменСОфлайнОборудованием() Экспорт
	Возврат ПолучитьФункциональнуюОпцию("ИспользоватьОбменСПодключаемымОборудованием");	
КонецФункции

// Функция возвращает параметры выбора для поля ввода ПодключаемоеОборудование.
//
Функция ПолучитьПараметрыВыбораТипаКассыККМ() Экспорт
	
	ПараметрыВыбораЭлемента = Новый Массив;
	
	МассивТиповОборудования = новый Массив;
	МассивТиповОборудования.Добавить(Перечисления.ТипыПодключаемогоОборудования.ККТ);
	МассивТиповОборудования.Добавить(Перечисления.ТипыПодключаемогоОборудования.ФискальныйРегистратор); 
	МассивТиповОборудования.Добавить(Перечисления.ТипыПодключаемогоОборудования.ОблачнаяККТ);
		
	НовыйПараметр = Новый ПараметрВыбора("Отбор.ТипОборудования", Новый ФиксированныйМассив(МассивТиповОборудования));
	ПараметрыВыбораЭлемента.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.УстройствоИспользуется", Истина);
	ПараметрыВыбораЭлемента.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.ПометкаУдаления", Ложь);
	ПараметрыВыбораЭлемента.Добавить(НовыйПараметр);
	
	Возврат Новый ФиксированныйМассив(ПараметрыВыбораЭлемента);
	
КонецФункции

Процедура ЗаполнитьСоответствиеСекцийДляОфлайнОборудованияПоКассеККМ(КассаККМ, ТаблицаТоваров) Экспорт
	Секция = 0;
	ЕстьНастройкаРаспределенияВыручкиПоСекциям = Ложь;
	ЕстьСоответствиеПоАгентскимДоговорам = Ложь;
	
	НастройкаРаспределенияВыручкиПоСекциям = КассаККМ.НастройкаРаспределенияВыручкиПоСекциям;
	
	Если ЗначениеЗаполнено(НастройкаРаспределенияВыручкиПоСекциям) Тогда
		Если НастройкаРаспределенияВыручкиПоСекциям.СоответствиеНоменклатурыСекциям.Количество() > 0 Тогда
			ЕстьНастройкаРаспределенияВыручкиПоСекциям = Истина;
		КонецЕсли;
		
		СоответствиеПоАгентскимДоговорам = НастройкаРаспределенияВыручкиПоСекциям.СоответствиеДоговоровПлатежныхАгентовСекциям;
		Если СоответствиеПоАгентскимДоговорам.Количество()>0 Тогда
			ЕстьСоответствиеПоАгентскимДоговорам = Истина;			
		Конецесли;	
		
		Для каждого ТекТовар Из ТаблицаТоваров Цикл
			СоответствиеУстановлено = Ложь;
			Если ЗначениеЗаполнено(ТекТовар.ПараметрыДоговораПлатежногоАгента) Тогда
				Если ЕстьСоответствиеПоАгентскимДоговорам Тогда
					СоответствиеУстановлено = Истина;
					СоответствующаяСекция = СекцияАгентскогоДоговора(СоответствиеПоАгентскимДоговорам, ТекТовар.ПараметрыДоговораПлатежногоАгента); 	
					Если СоответствующаяСекция = Неопределено Тогда
						СоответствиеУстановлено = Ложь;
					Иначе
						Секция = СоответствующаяСекция;	
					КонецЕсли;	
				КонецЕсли;	
			Конецесли;
			
			Если НЕ СоответствиеУстановлено Тогда
				СекцияДляНоменклатуры = 0;
				
				Если ЕстьНастройкаРаспределенияВыручкиПоСекциям Тогда
					Секция = СекцияДляНоменклатуры(НастройкаРаспределенияВыручкиПоСекциям, ТекТовар.Номенклатура);
				Иначе
					Секция = 0;
				КонецЕсли;
			Конецесли;
			
			ТаблицаТоваров.НомерСекции = Секция;
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьРегистрациюПрайсЛистаПослеВыгрузки(ОфлайнОборудование) Экспорт
	
	Параметры = ПолучитьПараметрыОфлайнУстройства(ОфлайнОборудование);
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	Попытка
		
		ПланыОбмена.УдалитьРегистрациюИзменений(Параметры.УзелИнформационнойБазы, Метаданные.Справочники.Прейскурант);
		
		УзелОбъект = Параметры.УзелИнформационнойБазы.ПолучитьОбъект();
		УзелОбъект.ДатаВыгрузки      = ТекущаяДатаСеанса();
		УзелОбъект.ВыгрузкаВыполнена = Истина;
		УзелОбъект.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Функция получает параметры устройства.
//
Функция ПолучитьПараметрыОфлайнУстройства(Устройство) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФискальныеРегистраторы.Организация КАК Организация,
	|	ФискальныеРегистраторы.Ссылка КАК КассаККМ,
	|	ФискальныеРегистраторы.УзелИнформационнойБазы КАК УзелИнформационнойБазы,
	|	ФискальныеРегистраторы.ПравилоОбменаСОборудованием КАК ПравилоОбмена,
	|	ВЫРАЗИТЬ(ФискальныеРегистраторы.ПравилоОбменаСОборудованием КАК Справочник.ПравилаОбменаСПодключаемымОборудованием).ТипЦен КАК ВидЦены,
	|	ФискальныеРегистраторы.Организация КАК Склад,
	|	ВЫРАЗИТЬ(ФискальныеРегистраторы.ПравилоОбменаСОборудованием КАК Справочник.ПравилаОбменаСПодключаемымОборудованием).ТолькоСУстановленнымиЦенами КАК ТолькоСУстановленнымиЦенами,
	|	ВЫРАЗИТЬ(ФискальныеРегистраторы.ПравилоОбменаСОборудованием КАК Справочник.ПравилаОбменаСПодключаемымОборудованием).ВыгружатьГруппыТоваров КАК ВыгружатьГруппыТоваров,
	|	ВЫРАЗИТЬ(ФискальныеРегистраторы.ПравилоОбменаСОборудованием КАК Справочник.ПравилаОбменаСПодключаемымОборудованием).ПараметрыДоговораЭквайринга КАК ПараметрыДоговораЭквайринга,
	|	ВЫРАЗИТЬ(ФискальныеРегистраторы.ОффлайнОборудование КАК Справочник.ОфлайнОборудование).ТипОфлайнОборудования КАК ТипОборудования,
	|	ВЫРАЗИТЬ(ФискальныеРегистраторы.ПравилоОбменаСОборудованием КАК Справочник.ПравилаОбменаСПодключаемымОборудованием).ИспользоватьОплатуПлатежнымиКартами КАК ИспользоватьОплатуПлатежнымиКартами
	|ИЗ
	|	Справочник.ФискальныеРегистраторы КАК ФискальныеРегистраторы
	|ГДЕ
	|	ФискальныеРегистраторы.ОффлайнОборудование = &ПодключаемоеОборудование
	|	И ФискальныеРегистраторы.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ПодключаемоеОборудование", Устройство);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("КассаККМ",                  		Выборка.КассаККМ);
	ВозвращаемоеЗначение.Вставить("ПравилоОбмена",                  Выборка.ПравилоОбмена);
	ВозвращаемоеЗначение.Вставить("УзелИнформационнойБазы",         Выборка.УзелИнформационнойБазы);
	ВозвращаемоеЗначение.Вставить("Склад",                          Выборка.Склад);
	ВозвращаемоеЗначение.Вставить("ВидЦены",                        Выборка.ВидЦены);
	ВозвращаемоеЗначение.Вставить("ТипОборудования",                Выборка.ТипОборудования);
	ВозвращаемоеЗначение.Вставить("Организация",                	Выборка.Организация);
	ВозвращаемоеЗначение.Вставить("ВыгружатьГруппыТоваров",         Выборка.ВыгружатьГруппыТоваров);
	ВозвращаемоеЗначение.Вставить("ТолькоСУстановленнымиЦенами",    Выборка.ТолькоСУстановленнымиЦенами);
	ВозвращаемоеЗначение.Вставить("ПараметрыДоговораЭквайринга",    Выборка.ПараметрыДоговораЭквайринга);
	ВозвращаемоеЗначение.Вставить("ИспользоватьОплатуПлатежнымиКартами",    Выборка.ИспользоватьОплатуПлатежнымиКартами);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Процедура ЗагрузитьОтчетыОПродажахИзККМОфлайн(ОфлайнОборудование, ДанныеОПродажах, Отказ, СообщениеОбОшибке, Параметры) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивСозданныхДокументов = Новый Массив;
	
	Параметры = ПолучитьПараметрыОфлайнУстройства(ОфлайнОборудование);
	
	Если Параметры = Неопределено Тогда
		Отказ = Истина;
		СообщениеОбОшибке =  НСтр("ru = 'Для загрузки отчетов о продажах офлайн ККМ при настройке должен быть создан элемент справочника
		|""Кассы ККМ (фискальные регистраторы)"", у которого заполнены значения реквизитов ""Подключаемое оборудование"",
		|""Правила обмена с офлайн оборудованием"", и определены настройки заполнения документов.'");
		
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;
	КонецЕсли;	
	
	Организация = Параметры.Организация;
	КассаККМ = Параметры.КассаККМ;
	
	ТаблицаОплат = Новый ТаблицаЗначений;
	ТаблицаОплат.Колонки.Добавить("ВидОперации",    Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийЧекККМ"));
	ТаблицаОплат.Колонки.Добавить("КодВидаОплаты", 	Новый ОписаниеТипов("Строка"));
	ТаблицаОплат.Колонки.Добавить("Сумма",         	Новый ОписаниеТипов("Число"));
	ТаблицаОплат.Колонки.Добавить("ТипОплаты",     	Новый ОписаниеТипов("ПеречислениеСсылка.ТипыОплатЧекаККМ"));
	
	ТаблицаОплатПоСтатьям = Новый ТаблицаЗначений;
	ТаблицаОплатПоСтатьям.Колонки.Добавить("ВидОперации",  	Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийЧекККМ"));
	ТаблицаОплатПоСтатьям.Колонки.Добавить("Сумма",        	Новый ОписаниеТипов("Число"));
	ТаблицаОплатПоСтатьям.Колонки.Добавить("ТипОплаты",    	Новый ОписаниеТипов("ПеречислениеСсылка.ТипыОплатЧекаККМ"));
	ТаблицаОплатПоСтатьям.Колонки.Добавить("КодТовара", 	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(11,0)));
	ТаблицаОплатПоСтатьям.Колонки.Добавить("СтавкаНДС",  	Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	
	ТаблицаТоваров   = ПустаяТаблицаТоваров();
	ТаблицаВозвратов = ПустаяТаблицаТоваров();
	
	Для каждого ОтчетОПродажах Из ДанныеОПродажах Цикл
		
		ТаблицаТоваров.Очистить();
		ТаблицаВозвратов.Очистить();
		ТаблицаОплат.Очистить();
		ТаблицаОплатПоСтатьям.Очистить();
		
		Для каждого ЧекККМ Из ОтчетОПродажах.Чеки Цикл
			Если ЧекККМ.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств Тогда
				ЭтоЧекНаВозврат = Ложь;
			ИначеЕсли ЧекККМ.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств Тогда
				ЭтоЧекНаВозврат = Истина;
			Иначе
				Продолжить;
			КонецЕсли;
			
			Для Каждого СтрокаТЧ Из ЧекККМ.Товары Цикл
				Если НЕ (СтрокаТЧ.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаБезОплаты
					ИЛИ СтрокаТЧ.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой
					ИЛИ СтрокаТЧ.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСЧастичнойОплатой) Тогда
					
					Продолжить;
				КонецЕсли;
				
				Если ЭтоЧекНаВозврат Тогда
					НоваяСтрока = ТаблицаВозвратов.Добавить();
					
					НоваяСтрока.Код 		= СтрокаТЧ.Код;
					НоваяСтрока.Количество 	= СтрокаТЧ.Количество;
					НоваяСтрока.Сумма 		= СтрокаТЧ.Сумма;
					НоваяСтрока.Цена 		= ?(СтрокаТЧ.Количество<>0, СтрокаТЧ.Сумма/СтрокаТЧ.Количество, СтрокаТЧ.Цена);
					НоваяСтрока.СтавкаНДС 	= ПолучитьСтавкуНДС(СтрокаТЧ.СтавкаНДС);
				Иначе	
					НоваяСтрока = ТаблицаТоваров.Добавить();
					
					НоваяСтрока.Код 		= СтрокаТЧ.Код;
					НоваяСтрока.Количество 	= СтрокаТЧ.Количество;
					НоваяСтрока.Сумма 		= СтрокаТЧ.Сумма;
					НоваяСтрока.Цена 		= ?(СтрокаТЧ.Количество<>0, СтрокаТЧ.Сумма/СтрокаТЧ.Количество, СтрокаТЧ.Цена);
					НоваяСтрока.СтавкаНДС 	= ПолучитьСтавкуНДС(СтрокаТЧ.СтавкаНДС);
				КонецЕсли;
				
				НоваяСтрокаОплата = ТаблицаОплатПоСтатьям.Добавить();
				НоваяСтрокаОплата.КодТовара = СтрокаТЧ.Код;
				Если ЭтоЧекНаВозврат Тогда 
					НоваяСтрокаОплата.ВидОперации 	= Перечисления.ВидыОперацийЧекККМ.Возврат;
					НоваяСтрокаОплата.Сумма 		= - СтрокаТЧ.Сумма;
				Иначе
					НоваяСтрокаОплата.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Продажа;
					НоваяСтрокаОплата.Сумма 		= СтрокаТЧ.Сумма;
				КонецЕсли;	
				Если ЧекККМ.Оплаты.Количество() = 1 И ЗначениеЗаполнено(ЧекККМ.Оплаты[0].СуммаЭлектроннойОплаты) Тогда 
					НоваяСтрокаОплата.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта;
				Иначе 
					НоваяСтрокаОплата.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные;
				КонецЕсли;	
				НоваяСтрокаОплата.СтавкаНДС 	= НоваяСтрока.СтавкаНДС;	
				
			КонецЦикла;
			
			Для Каждого СтрокаТЧ Из ЧекККМ.Оплаты Цикл
				
				НоваяСтрока = ТаблицаОплат.Добавить();
				
				Если ЭтоЧекНаВозврат Тогда
					НоваяСтрока.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат;
				Иначе
					НоваяСтрока.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Продажа;
				КонецЕсли;	
				
				Если ЗначениеЗаполнено(СтрокаТЧ.КодВидаЭлектроннойОплаты) Тогда
					НоваяСтрока.КодВидаОплаты = СтрокаТЧ.КодВидаЭлектроннойОплаты;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаТЧ.СуммаНаличнойОплаты) Тогда
					
					НоваяСтрока.Сумма = ?(ЭтоЧекНаВозврат, -СтрокаТЧ.СуммаНаличнойОплаты, СтрокаТЧ.СуммаНаличнойОплаты);
					НоваяСтрока.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные;
					
				ИначеЕсли ЗначениеЗаполнено(СтрокаТЧ.СуммаЭлектроннойОплаты) Тогда
					
					НоваяСтрока.Сумма = ?(ЭтоЧекНаВозврат, -СтрокаТЧ.СуммаЭлектроннойОплаты, СтрокаТЧ.СуммаЭлектроннойОплаты);
					НоваяСтрока.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта;
					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;	
		
		ТаблицаТоваров.Свернуть("Код, Цена, СтавкаНДС", "Количество, Сумма, Скидка");
		ТаблицаВозвратов.Свернуть("Код, Цена, СтавкаНДС", "Количество, Сумма, Скидка");
		ТаблицаОплат.Свернуть("ВидОперации, КодВидаОплаты, ТипОплаты", "Сумма");
		ТаблицаОплатПоСтатьям.Свернуть("ВидОперации, КодТовара, ТипОплаты, СтавкаНДС", "Сумма");
		
		ДополнитьНоменклатуройТаблицуТоваров(Организация, ТаблицаТоваров);
		ДополнитьНоменклатуройТаблицуТоваров(Организация, ТаблицаВозвратов);
	
		РеквизитыОтчета = Новый Структура;
		РеквизитыОтчета.Вставить("УникальныйИдентификатор", ОтчетОПродажах.УникальныйИдентификатор);
		РеквизитыОтчета.Вставить("Дата", ОтчетОПродажах.ДатаЗакрытияСмены);
		РеквизитыОтчета.Вставить("НомерСмены", ОтчетОПродажах.НомерСмены);
		
		ТаблицыДанных = Новый Структура("Товары, Оплаты, ВозвратыТоваров, Реквизиты");
		ТаблицыДанных.Товары = ТаблицаТоваров;
		ТаблицыДанных.Оплаты = ТаблицаОплат;
		ТаблицыДанных.ВозвратыТоваров = ТаблицаВозвратов;
		ТаблицыДанных.Реквизиты = РеквизитыОтчета;
		
		Комментарий = СформироватьКомментарий(КассаККМ);
		
		Если КассаККМ.ОффлайнОборудование.ОбработчикОфлайнОборудования = Перечисления.ОбработчикиОфлайнОборудования.Обработчик1СЭвоторККМОфлайн Тогда 
			ТаблицыДанных.Вставить("ОплатыПоСтатьям", ТаблицаОплатПоСтатьям);
			СоздатьИЗаполнитьОтчетОПродажахЭвотор(Организация, КассаККМ, МассивСозданныхДокументов, Параметры, ТаблицыДанных, Комментарий);
		Иначе	
			СоздатьИЗаполнитьОтчетОПродажах(Организация, КассаККМ, МассивСозданныхДокументов, Параметры, ТаблицыДанных, Комментарий);
		КонецЕсли;	
		
	КонецЦикла;	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура НазначитьНомерSKUЕслиНеНазначен(НоменклатураПрейскуранта) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Организация = НоменклатураПрейскуранта.Организация;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КодыТоваровSKU.SKU КАК SKU
	               |ИЗ
	               |	РегистрСведений.КодыТоваровSKU КАК КодыТоваровSKU
	               |ГДЕ
	               |	КодыТоваровSKU.Организация = &Организация
	               |	И КодыТоваровSKU.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураПрейскуранта);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		ПорядковыйНомер = РегистрыСведений.КодыТоваровSKU.НовыйКодSKU(НоменклатураПрейскуранта.Организация);
		
		МенеджерЗаписи = РегистрыСведений.КодыТоваровSKU.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Организация = Организация;
		МенеджерЗаписи.Номенклатура = НоменклатураПрейскуранта;
		МенеджерЗаписи.SKU = ПорядковыйНомер;
		МенеджерЗаписи.Записать(Истина);
	КонецЕсли;	
	
КонецПроцедуры

Функция ПлатежноРасчетныйДокументИсполнен(ПлатежноРасчетныйДокумент) Экспорт
	Результат = Ложь;
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостояниеПлатежноРасчетныхДокументов.Статус КАК Статус
	               |ИЗ
	               |	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
	               |ГДЕ
	               |	СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент = &ПлатежноРасчетныйДокумент";
	
	Запрос.УстановитьПараметр("ПлатежноРасчетныйДокумент", ПлатежноРасчетныйДокумент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.Статус = Перечисления.СтатусыИсполненияДокумента.Исполнен Тогда
			Результат = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Процедура ЗагрузитьЧекиККМИзККМОффлайн(ОфлайнОборудование, ДанныеОПродажах, Отказ, СообщениеОбОшибке, Параметры) Экспорт	
	
	УстановитьПривилегированныйРежим(Истина);
	Комментарий = СформироватьКомментарий(Параметры.КассаККМ);	
	
	ПараметрыДоговораЭквайринга = Параметры.ПараметрыДоговораЭквайринга;
	ЭквайринговыйТерминал = Справочники.ЭквайринговыеТерминалы.ПустаяСсылка();
	Если ЗначениеЗаполнено(ПараметрыДоговораЭквайринга) Тогда
		Если ПараметрыДоговораЭквайринга.Терминалы.Количество()>0 Тогда
			ЭквайринговыйТерминал = ПараметрыДоговораЭквайринга.Терминалы[0].ЭквайринговыйТерминал;
		КонецЕсли;	
	КонецЕсли;
	
	ПроцентТорговойУступки = 0;
	ВидПлатежнойКарты = Справочники.ВидыПлатежныхКарт.ПустаяСсылка();
	Если ЗначениеЗаполнено(ПараметрыДоговораЭквайринга) Тогда 
		Для Каждого ТекНастройка Из ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание Цикл
			Если ТекНастройка.ОсновнойВид Тогда
				ВидПлатежнойКарты 		= ТекНастройка.ВидПлатежнойКарты;
				ПроцентТорговойУступки 	= ТекНастройка.ПроцентТорговойУступки;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ОтчетОПродажах Из ДанныеОПродажах Цикл
		
		Если ЗначениеЗаполнено(ОтчетОПродажах.УникальныйИдентификатор) Тогда
			УИ = Новый УникальныйИдентификатор(ОтчетОПродажах.УникальныйИдентификатор);
			ДокументСменаСсылка = Документы.КассоваяСмена.ПолучитьСсылку(УИ);
			НовыйДокументСмена = ДокументСменаСсылка.ПолучитьОбъект();
			Если НовыйДокументСмена = Неопределено Тогда
				НовыйДокументСмена = Документы.КассоваяСмена.СоздатьДокумент();
				НовыйДокументСмена.УстановитьСсылкуНового(ДокументСменаСсылка);
			КонецЕсли;
		Иначе
			НовыйДокументСмена = Документы.КассоваяСмена.СоздатьДокумент();
		КонецЕсли;
		НовыйДокументСмена.Дата 					= ТекущаяДата();
		НовыйДокументСмена.ДатаСменыККТ             = ОтчетОПродажах.ДатаЗакрытияСмены;
		НовыйДокументСмена.НачалоКассовойСмены		= ОтчетОПродажах.ДатаОткрытияСмены;
		НовыйДокументСмена.ОкончаниеКассовойСмены	= ОтчетОПродажах.ДатаЗакрытияСмены;
		НовыйДокументСмена.НомерСменыККТ			= ОтчетОПродажах.НомерСмены;
		НовыйДокументСмена.Статус 					= Перечисления.СтатусыКассовойСмены.Закрыта;
		НовыйДокументСмена.Организация				= ОфлайнОборудование.Организация;
		НовыйДокументСмена.КассаККМ					= Параметры.КассаККМ;
		НовыйДокументСмена.КоличествоФД             = ОтчетОПродажах.Чеки.Количество();
		НовыйДокументСмена.КоличествоЧеков          = ОтчетОПродажах.Чеки.Количество();
		НовыйДокументСмена.ФискальноеУстройство		= ОфлайнОборудование;
		НовыйДокументСмена.Записать(РежимЗаписиДокумента.Проведение);
		
		Для Каждого ЧекККМ Из ОтчетОПродажах.Чеки Цикл
			
			ПризнакиСпособаРасчета 	= ПолучитьУникальныеЗначенияИзМассива(ЧекККМ.Товары, "ПризнакСпособаРасчета");
			ТипыОплат = Новый Соответствие;
			Для Каждого ТипОплат Из ЧекККМ.Оплаты Цикл 
				Если ЗначениеЗаполнено(ТипОплат.СуммаНаличнойОплаты) Тогда
					ТипыОплат.Вставить(Перечисления.ТипыОплатЧекаККМ.Наличные		, ТипОплат.СуммаНаличнойОплаты);
				ИначеЕсли ЗначениеЗаполнено(ТипОплат.СуммаЭлектроннойОплаты) Тогда 
					ТипыОплат.Вставить(Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта	, ТипОплат.СуммаЭлектроннойОплаты);
				КонецЕсли;	
			КонецЦикла;
			Если ТипыОплат.Количество() = 0 Тогда 
				ТипыОплат.Вставить(Перечисления.ТипыОплатЧекаККМ.Наличные, 0);	
			КонецЕсли;	
			
			Для Каждого ПризнакСпособаРасчета Из ПризнакиСпособаРасчета Цикл 
				Для Каждого ТипОплаты Из ТипыОплат Цикл 
					РеквизитыДокумента = Новый Структура;
					РеквизитыДокумента.Вставить("Дата"							, ЧекККМ.ДатаЧека);
					РеквизитыДокумента.Вставить("НомерСмены"					, ОтчетОПродажах.НомерСмены);
					РеквизитыДокумента.Вставить("Организация"					, Параметры.Организация);
					РеквизитыДокумента.Вставить("КассаККМ"						, Параметры.КассаККМ);
					РеквизитыДокумента.Вставить("Комментарий"					, Комментарий);
					РеквизитыДокумента.Вставить("ЭтоРозничныйПокупатель"		, Истина);
					РеквизитыДокумента.Вставить("ПризнакСпособаРасчетаЧекаККМ"	, ПризнакСпособаРасчета.Значение);
					Если ЗначениеЗаполнено(ЧекККМ.СистемаНалогообложения) Тогда 
						РеквизитыДокумента.Вставить("СистемаНалогообложенияЧекаККМ"	, ЧекККМ.СистемаНалогообложения);
					КонецЕсли;	
					
					Если ЧекККМ.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств Тогда
						Если ЗначениеЗаполнено(ЧекККМ.УникальныйИдентификатор) Тогда
							УИРасчета 		= Сред(ЗначениеВСтрокуВнутр(ПризнакСпособаРасчета.Значение), 6, 8);
							УИТипаОплаты	= Сред(ЗначениеВСтрокуВнутр(ПризнакСпособаРасчета.Значение), 14, 5);
							УИДокумента 	= Прав(Строка(ЧекККМ.УникальныйИдентификатор), 23);
							УИ = Новый УникальныйИдентификатор(УИРасчета + УИТипаОплаты + УИДокумента);
							ДокументСсылка = Документы.ЧекККМ.ПолучитьСсылку(УИ);
							НовыйДокумент = ДокументСсылка.ПолучитьОбъект();
							Если НовыйДокумент = Неопределено Тогда
								НовыйДокумент = Документы.ЧекККМ.СоздатьДокумент();
								НовыйДокумент.УстановитьСсылкуНового(ДокументСсылка);
							КонецЕсли;
						Иначе
							НовыйДокумент = Документы.ЧекККМ.СоздатьДокумент();
						КонецЕсли;
					ИначеЕсли ЧекККМ.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств Тогда
						Если ЗначениеЗаполнено(ЧекККМ.УникальныйИдентификатор) Тогда
							УИРасчета 		= Сред(ЗначениеВСтрокуВнутр(ПризнакСпособаРасчета.Значение), 6, 8);
							УИТипаОплаты	= Сред(ЗначениеВСтрокуВнутр(ПризнакСпособаРасчета.Значение), 14, 5);
							УИДокумента 	= Прав(Строка(ЧекККМ.УникальныйИдентификатор), 23);
							УИ = Новый УникальныйИдентификатор(УИРасчета + УИТипаОплаты + УИДокумента);
							ДокументСсылка = Документы.ЧекККМНаВозврат.ПолучитьСсылку(УИ);
							НовыйДокумент = ДокументСсылка.ПолучитьОбъект();
							Если НовыйДокумент = Неопределено Тогда
								НовыйДокумент = Документы.ЧекККМНаВозврат.СоздатьДокумент();
								НовыйДокумент.УстановитьСсылкуНового(ДокументСсылка);
							КонецЕсли;
						Иначе
							НовыйДокумент = Документы.ЧекККМНаВозврат.СоздатьДокумент();
						КонецЕсли;
						Если ЗначениеЗаполнено(ЧекККМ.УникальныйИдентификаторСвязанногоДокументаККМ) Тогда
							УИДокумента			 		= Прав(Строка(ЧекККМ.УникальныйИдентификаторСвязанногоДокументаККМ), 23);
							УИДокументаОснования		= Новый УникальныйИдентификатор(УИРасчета + УИТипаОплаты + УИДокумента);
							ДокументОснованиеСсылка 	= Документы.ЧекККМ.ПолучитьСсылку(УИДокументаОснования);
							НовыйДокумент.ЧекККМПродажа = ДокументОснованиеСсылка;
						КонецЕсли;
					Иначе
						Продолжить;
					КонецЕсли;
					ЗаполнитьЗначенияСвойств(НовыйДокумент, РеквизитыДокумента);
					
					ТаблицаТоваров = ПустаяТаблицаТоваров();

					СуммаДокумента = 0;
					Для Каждого СтрокаТЧ Из ЧекККМ.Товары Цикл
						СуммаДокумента = СуммаДокумента + СтрокаТЧ.Сумма;
						Если НЕ (СтрокаТЧ.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаБезОплаты
							ИЛИ СтрокаТЧ.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой
							ИЛИ СтрокаТЧ.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСЧастичнойОплатой)
							ИЛИ СтрокаТЧ.ПризнакСпособаРасчета <> ПризнакСпособаРасчета.Значение Тогда
							Продолжить;
						КонецЕсли;
						
						НоваяСтрока = ТаблицаТоваров.Добавить();
						
						НоваяСтрока.Код			 	= СтрокаТЧ.Код;
						НоваяСтрока.Количество 		= СтрокаТЧ.Количество;
						НоваяСтрока.Сумма 			= СтрокаТЧ.Сумма;
						НоваяСтрока.Цена 			= ?(СтрокаТЧ.Количество<>0, СтрокаТЧ.Сумма/СтрокаТЧ.Количество, СтрокаТЧ.Цена);
						НоваяСтрока.СтавкаНДС 		= ПолучитьСтавкуНДС(СтрокаТЧ.СтавкаНДС);
						
					КонецЦикла;
					ДополнитьНоменклатуройТаблицуТоваров(Параметры.Организация, ТаблицаТоваров);
					НовыйДокумент.ТоварыРаботыУслуги.Загрузить(ТаблицаТоваров);
					
					НовыйДокумент.РасшифровкаОплаты.Очистить();
					Для Каждого СтрокаТаблицы Из НовыйДокумент.ТоварыРаботыУслуги Цикл 
						СтрокаТаблицы.ЦенаБезСкидок = СтрокаТаблицы.Цена;
						СтрокаТаблицы.Всего 		= СтрокаТаблицы.Сумма;
						СтавкаНДС 					= УчетНДСКлиентСервер.ЗначениеСтавкиНДС(НоваяСтрока.СтавкаНДС);
						СтрокаТаблицы.СуммаНДС 		= СтрокаТаблицы.Сумма * СтавкаНДС / (100 + СтавкаНДС);
						СтрокаТаблицы.СтавкаНДС 	= КорректировкаЗагруженнойСтавкиНДС(СтрокаТаблицы.Номенклатура, СтрокаТаблицы.СтавкаНДС);
						
						Если ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда 
							НоваяСтрокаОплата 						= НовыйДокумент.РасшифровкаОплаты.Добавить();
							НоваяСтрокаОплата.КлючСвязиОплаты 		= 1;
							НоваяСтрокаОплата.СтатьяАналитикиОплаты = СтрокаТаблицы.Номенклатура.ОсновнаяСтатьяАналитикиОплаты;
							НоваяСтрокаОплата.Сумма					= СтрокаТаблицы.Сумма;
							Если ТипОплаты.Ключ = Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта Тогда 
								НоваяСтрокаОплата.СуммаКомиссии			= СтрокаТаблицы.Сумма/100*ПроцентТорговойУступки;
							КонецЕсли;	
						КонецЕсли; 

					КонецЦикла;	
					НовыйДокумент.РасшифровкаОплаты.Свернуть("СтатьяАналитикиОплаты, КлючСвязиОплаты", "Сумма, СуммаКомиссии");
					
					ПроцентОплаты = НовыйДокумент.ТоварыРаботыУслуги.Итог("Всего")*100/СуммаДокумента;
					
					НовыйДокумент.Оплата.Очистить();
					НоваяСтрока = НовыйДокумент.Оплата.Добавить();
					НоваяСтрока.Сумма			= ТипОплаты.Значение/100*ПроцентОплаты;
					НоваяСтрока.ТипОплаты 		= ТипОплаты.Ключ;
					НоваяСтрока.КлючСвязиОплаты = 1;
					Если ТипОплаты.Ключ = Перечисления.ТипыОплатЧекаККМ.Наличные Тогда  
						НовыйДокумент.ФормаОплаты 		= 0;
					Иначе
						НовыйДокумент.ФормаОплаты 		= 1;
						НоваяСтрока.ДанныеПереданыВБанк 		= Истина;
						НоваяСтрока.ПараметрыДоговораЭквайринга = ПараметрыДоговораЭквайринга;
						НоваяСтрока.ЭквайринговыйТерминал 		= ЭквайринговыйТерминал;
						НоваяСтрока.ВидПлатежнойКарты 			= ВидПлатежнойКарты;
						НоваяСтрока.ПроцентКомиссии				= ПроцентТорговойУступки;
						НоваяСтрока.СуммаКомиссии				= НоваяСтрока.Сумма/100*ПроцентТорговойУступки;
					КонецЕсли;	
					
					НовыйДокумент.СуммаДокумента 	= СуммаДокумента;
					НовыйДокумент.НомерЧекаККМ		= ЧекККМ.НомерЧека;
					НовыйДокумент.СтатусЧекаККМ 	= Перечисления.СтатусыЧековККМ.Пробитый;
					НовыйДокумент.Ответственный 	= ПользователиКлиентСервер.ТекущийПользователь();
					НовыйДокумент.КассоваяСмена		= НовыйДокументСмена.Ссылка;
					НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
					
					ЗаписатьФискальныеДанныеДляРасчетногоДокумента(НовыйДокумент);
				КонецЦикла;
			КонецЦикла;	
		КонецЦикла;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

Процедура ДополнитьНоменклатуройТаблицуТоваров(Организация, ТаблицаТоваров)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КодыТоваровSKU.Номенклатура КАК Номенклатура,
	               |	КодыТоваровSKU.SKU КАК SKU
	               |ПОМЕСТИТЬ КодыSKUДляОрганизации
	               |ИЗ
	               |	РегистрСведений.КодыТоваровSKU КАК КодыТоваровSKU
	               |ГДЕ
	               |	КодыТоваровSKU.Организация = &Организация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Таб.Код КАК Код,
	               |	Таб.Цена КАК Цена,
	               |	Таб.СтавкаНДС КАК СтавкаНДС,
	               |	Таб.Количество КАК Количество,
	               |	Таб.Сумма КАК Сумма,
	               |	Таб.Скидка КАК Скидка
	               |ПОМЕСТИТЬ ТаблицаТоваровДляЗаполнения
	               |ИЗ
	               |	&ТаблицаТоваров КАК Таб
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаТоваровДляЗаполнения.Код КАК Код,
	               |	ТаблицаТоваровДляЗаполнения.Цена КАК Цена,
	               |	ТаблицаТоваровДляЗаполнения.СтавкаНДС КАК СтавкаНДС,
	               |	ТаблицаТоваровДляЗаполнения.Количество КАК Количество,
	               |	ТаблицаТоваровДляЗаполнения.Сумма КАК Сумма,
	               |	ТаблицаТоваровДляЗаполнения.Скидка КАК Скидка,
	               |	ЕСТЬNULL(КодыSKUДляОрганизации.Номенклатура, ЗНАЧЕНИЕ(Справочник.Прейскурант.ПустаяСсылка)) КАК Номенклатура
	               |ИЗ
	               |	ТаблицаТоваровДляЗаполнения КАК ТаблицаТоваровДляЗаполнения
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КодыSKUДляОрганизации КАК КодыSKUДляОрганизации
	               |		ПО ТаблицаТоваровДляЗаполнения.Код = КодыSKUДляОрганизации.SKU";
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	Запрос.УстановитьПараметр("Организация", Организация);
	ТаблицаТоваров = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры	

Процедура СоздатьИЗаполнитьОтчетОПродажах(Организация, КассаККМ, МассивСозданныхДокументов, РеквизитыККМ, ТаблицыДанных, Комментарий = "")

	ОтчетОРозничныхПродажахОбъект = Неопределено;
	
	ТаблицаСтавкиНДС = Новый ТаблицаЗначений;
	ТаблицаСтавкиНДС.Колонки.Добавить("СтатьяОплаты",		Новый ОписаниеТипов("СправочникСсылка.СтатьиАналитикиОплатыЧекаККМ"));
	ТаблицаСтавкиНДС.Колонки.Добавить("СтавкаНДС",			Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ТаблицаСтавкиНДС.Колонки.Добавить("СуммаНДС",			Новый ОписаниеТипов("Число"));
	ТаблицаСтавкиНДС.Колонки.Добавить("Сумма",				Новый ОписаниеТипов("Число"));
	
	ТаблицаСтатейОплаты = Новый ТаблицаЗначений;
	ТаблицаСтатейОплаты.Колонки.Добавить("СтатьяОплаты",		Новый ОписаниеТипов("СправочникСсылка.СтатьиАналитикиОплатыЧекаККМ"));
	ТаблицаСтатейОплаты.Колонки.Добавить("Сумма",				Новый ОписаниеТипов("Число"));
	
	ТаблицаДоговоровПлатежногоАгента = Новый ТаблицаЗначений;
	ТаблицаДоговоровПлатежногоАгента.Колонки.Добавить("ПараметрыДоговора",		Новый ОписаниеТипов("СправочникСсылка.ПараметрыДоговораПлатежногоАгента"));
	ТаблицаДоговоровПлатежногоАгента.Колонки.Добавить("Сумма",					Новый ОписаниеТипов("Число"));
	
	ТаблицаСтатейОплатыИДоговоровПлатежногоАгента = Новый ТаблицаЗначений;
	ТаблицаСтатейОплатыИДоговоровПлатежногоАгента.Колонки.Добавить("СтатьяОплаты",		Новый ОписаниеТипов("СправочникСсылка.СтатьиАналитикиОплатыЧекаККМ"));
	ТаблицаСтатейОплатыИДоговоровПлатежногоАгента.Колонки.Добавить("ПараметрыДоговора",	Новый ОписаниеТипов("СправочникСсылка.ПараметрыДоговораПлатежногоАгента"));
	ТаблицаСтатейОплатыИДоговоровПлатежногоАгента.Колонки.Добавить("Сумма",				Новый ОписаниеТипов("Число"));
	
	Если ЗначениеЗаполнено(ТаблицыДанных.Реквизиты.УникальныйИдентификатор) Тогда
		
		УИ = ТаблицыДанных.Реквизиты.УникальныйИдентификатор;
		
		ОтчетСсылка = Документы.ОтчетПоКассовойСмене.ПолучитьСсылку(УИ);
		
		ОтчетОРозничныхПродажахОбъект = ОтчетСсылка.ПолучитьОбъект();
		
		Если ОтчетОРозничныхПродажахОбъект = Неопределено Тогда
			ОтчетОРозничныхПродажахОбъект = Документы.ОтчетПоКассовойСмене.СоздатьДокумент();
			ОтчетОРозничныхПродажахОбъект.УстановитьСсылкуНового(ОтчетСсылка);
		КонецЕсли;
		
	Иначе
		
		ОтчетОРозничныхПродажахОбъект = Документы.ОтчетПоКассовойСмене.СоздатьДокумент();
		
	КонецЕсли;
	
	ОтчетОРозничныхПродажахОбъект.ОплатаНаличными.Очистить();
	ОтчетОРозничныхПродажахОбъект.ОплатаПлатежнымиКартами.Очистить();
	ОтчетОРозничныхПродажахОбъект.ПродажиПлатежногоАгента.Очистить();
	ОтчетОРозничныхПродажахОбъект.ПродажиТовары.Очистить();
	ОтчетОРозничныхПродажахОбъект.ПродажиРаботыУслуги.Очистить();
	ОтчетОРозничныхПродажахОбъект.ВозвратТовары.Очистить();
