						НоваяСтрока.ВидОперации = Оплата.ВидОперации;
						НоваяСтрока.ЭтоРозничныйПокупатель = Истина;
						НоваяСтрока.ПараметрыДоговораЭквайринга = ПараметрыДоговораЭквайринга;
						НоваяСтрока.СистемаНалогообложенияЧекаККМ = КассаККМ.СистемаНалогообложенияЧекаККМ;
						НоваяСтрока.СтатьяАналитикиОплаты = ТаблицаСтатейОплатыИДоговоровПлатежногоАгента[0].СтатьяОплаты; 
						НоваяСтрока.ПараметрыДоговораПлатежногоАгента = ТаблицаСтатейОплатыИДоговоровПлатежногоАгента[0].ПараметрыДоговора; 
						НоваяСтрока.Контрагент = КассаККМ.КонтрагентДляРозничныхПродаж;
						НоваяСтрока.Договор = КассаККМ.ДоговорДляРозничныхПродаж;
						НоваяСтрока.Сумма = Оплата.Сумма;
						НоваяСтрока.ВидПлатежнойКарты = ВидПлатежнойКарты;
						НоваяСтрока.ПроцентКомиссии = ПроцентТорговойУступки;
						НоваяСтрока.СуммаКомиссии = Окр(Оплата.Сумма*ПроцентТорговойУступки/100, 2);
						НоваяСтрока.ЭквайринговыйТерминал = ЭквайринговыйТерминал;
					Иначе
						ПроцентТорговойУступки = 0;
						ПроцентТорговойУступкиОсновной = 0;
						ВидПлатежнойКарты = Справочники.ВидыПлатежныхКарт.ПустаяСсылка();
						ОсновнойВидПлатежнойКарты = Справочники.ВидыПлатежныхКарт.ПустаяСсылка();
						НомерВидаКарты = 1;
						Для каждого ТекНастройка Из ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание Цикл
							Если ТекНастройка.КодВидаОплатыОфлайнККМ = "" Тогда
								Если Строка(НомерВидаКарты) = Оплата.КодВидаОплаты Тогда
									ВидПлатежнойКарты = ТекНастройка.ВидПлатежнойКарты;
									ПроцентТорговойУступки = ТекНастройка.ПроцентТорговойУступки;
								КонецЕсли;	
							Иначе
								Если ТекНастройка.КодВидаОплатыОфлайнККМ = Оплата.КодВидаОплаты Тогда
									ВидПлатежнойКарты = ТекНастройка.ВидПлатежнойКарты;
									ПроцентТорговойУступки = ТекНастройка.ПроцентТорговойУступки;
								КонецЕсли;	
							КонецЕсли;
							Если ТекНастройка.ОсновнойВид Тогда
								ОсновнойВидПлатежнойКарты = ТекНастройка.ВидПлатежнойКарты;
								ПроцентТорговойУступкиОсновной = ТекНастройка.ПроцентТорговойУступки;
							КонецЕсли;	
							НомерВидаКарты = НомерВидаКарты + 1;
						КонецЦикла;
						
						Если НЕ ЗначениеЗаполнено(ВидПлатежнойКарты) Тогда
							ВидПлатежнойКарты = ОсновнойВидПлатежнойКарты;
							ПроцентТорговойУступки = ПроцентТорговойУступкиОсновной;
						КонецЕсли;	
						
						НоваяСтрока = ОтчетОРозничныхПродажахОбъект.ОплатаПлатежнымиКартами.Добавить();
						НоваяСтрока.ВидОперации = Оплата.ВидОперации;
						НоваяСтрока.ЭтоРозничныйПокупатель = Истина;
						НоваяСтрока.ПараметрыДоговораЭквайринга = ПараметрыДоговораЭквайринга;
						НоваяСтрока.СистемаНалогообложенияЧекаККМ = КассаККМ.СистемаНалогообложенияЧекаККМ;
						НоваяСтрока.СтатьяАналитикиОплаты = ТекСтатьяОплаты.СтатьяОплаты; 
						НоваяСтрока.ПараметрыДоговораПлатежногоАгента = ТекСтатьяОплаты.ПараметрыДоговора; 
						НоваяСтрока.Контрагент = КассаККМ.КонтрагентДляРозничныхПродаж;
						НоваяСтрока.Договор = КассаККМ.ДоговорДляРозничныхПродаж;
						СуммаОплаты = Оплата.Сумма;
						НоваяСтрока.Сумма = СуммаОплаты;
						НоваяСтрока.ВидПлатежнойКарты = ВидПлатежнойКарты;
						НоваяСтрока.ПроцентКомиссии = ПроцентТорговойУступки;
						НоваяСтрока.СуммаКомиссии = Окр(СуммаОплаты*ПроцентТорговойУступки/100, 2);
						НоваяСтрока.ЭквайринговыйТерминал = ЭквайринговыйТерминал;
						
					КонецЕсли;	
				Иначе	
					КомментарийКОплате = 
						НСтр("ru='Не определены параметры договора эквайринга для правила обмена с офлайн оборудованием.
						|Следует в правилах обмена для кассы ККМ (раздел ""Денежные средства"" - Управление ККТ - Кассы ККМ (фискальные регистраторы))
						|указать элемент справочника ""Параметры договора и операций эквайринга"".'");
						
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = КомментарийКОплате;
					Сообщение.Сообщить();
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для каждого ТекПлатеж Из ТаблицаДоговоровПлатежногоАгента Цикл
		Если ЗначениеЗаполнено(ТекПлатеж.ПараметрыДоговора) Тогда
			НоваяСтрока = ОтчетОРозничныхПродажахОбъект.ПродажиПлатежногоАгента.Добавить();
			НоваяСтрока.ПараметрыДоговораПлатежногоАгента = ТекПлатеж.ПараметрыДоговора;
			Если ОплаченоНаличными = 0 Тогда
				НоваяСтрока.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта;
			ИначеЕсли ОплаченоЭлектронно = 0 Тогда
				НоваяСтрока.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные;
			КонецЕсли;	
			НоваяСтрока.Сумма = ТекПлатеж.Сумма;
			ПроцентКомиссионногоВознаграждения = ТекПлатеж.ПараметрыДоговора.ПроцентКомиссионногоВознаграждения;
			НоваяСтрока.СуммаВознаграждения = Окр(ТекПлатеж.Сумма * ПроцентКомиссионногоВознаграждения / 100, 2);
		КонецЕсли;	
	КонецЦикла;
	
	Если ТаблицаДоговоровПлатежногоАгента.Итог("Сумма") > ВсегоОплачено Тогда
		КомментарийКОплате = 
			НСтр("ru='Сумма по строкам на закладке ""Расчеты по договорам платежного агента"" не больше суммы полной оплаты (наличными и платежными картами) и требует уточнения вручную'");
			
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = КомментарийКОплате;
		Сообщение.Сообщить();
	КонецЕсли;
	
	Для каждого ТекСтавка Из ТаблицаСтавкиНДС Цикл
		
		НоваяСтрока = ОтчетОРозничныхПродажахОбъект.ПродажиПоСтавкамНДС.Добавить();
		НоваяСтрока.СтавкаНДС = ТекСтавка.СтавкаНДС;
		НоваяСтрока.СуммаНДС = ТекСтавка.СуммаНДС;
		НоваяСтрока.Сумма = ТекСтавка.Сумма;
		НоваяСтрока.СтатьяАналитикиОплаты = ТекСтавка.СтатьяОплаты;
		НоваяСтрока.ЭтоРозничныйПокупатель = Истина;
		Если ОплаченоНаличными = 0 Тогда
			НоваяСтрока.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта;
		ИначеЕсли ОплаченоЭлектронно = 0 Тогда
			НоваяСтрока.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные;
		КонецЕсли;	
			
	КонецЦикла;
	
	Попытка
		ОтчетОРозничныхПродажахОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ОтчетОРозничныхПродажахОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
	УзелОбъект = РеквизитыККМ.УзелИнформационнойБазы.ПолучитьОбъект();
	УзелОбъект.ДатаЗагрузки = ТекущаяДатаСеанса();
	УзелОбъект.Записать();
	
	МассивСозданныхДокументов.Добавить(ОтчетОРозничныхПродажахОбъект.Ссылка);
	
КонецПроцедуры

Функция ПустаяТаблицаТоваров()
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("Код",        Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("Цена",       Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("Скидка",     Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("Сумма",      Новый ОписаниеТипов("Число"));
	ТаблицаТоваров.Колонки.Добавить("СтавкаНДС",  Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ТаблицаТоваров.Колонки.Добавить("НоменклатураПрейскуранта", Новый ОписаниеТипов("СправочникСсылка.Прейскурант"));
	
	Возврат ТаблицаТоваров;
	
КонецФункции

Функция ПолучитьСтавкуНДС(СтавкаНДСККМ)
	
	Если СтавкаНДСККМ = МенеджерОфлайнОборудования.СтавкаБезНДС() Тогда
		
		Возврат Перечисления.СтавкиНДС.БезНДС;
		
	ИначеЕсли СтавкаНДСККМ = МенеджерОфлайнОборудования.СтавкаНДС0() Тогда
		
		Возврат Перечисления.СтавкиНДС.НДС0;
		
	ИначеЕсли СтавкаНДСККМ = МенеджерОфлайнОборудования.СтавкаНДС10() Тогда
		
		Возврат Перечисления.СтавкиНДС.НДС10;
		
	ИначеЕсли СтавкаНДСККМ = МенеджерОфлайнОборудования.СтавкаНДС18() Тогда
		
		Возврат Перечисления.СтавкиНДС.НДС18;
		
	ИначеЕсли СтавкаНДСККМ = МенеджерОфлайнОборудования.СтавкаНДС20() Тогда
		
		Возврат Перечисления.СтавкиНДС.НДС20; 
		
	ИначеЕсли СтавкаНДСККМ = МенеджерОфлайнОборудования.СтавкаНДС5() Тогда
		
		Возврат Перечисления.СтавкиНДС.НДС5;
		
	ИначеЕсли СтавкаНДСККМ = МенеджерОфлайнОборудования.СтавкаНДС7() Тогда
		
		Возврат Перечисления.СтавкиНДС.НДС7;
		
	ИначеЕсли СтавкаНДСККМ = МенеджерОфлайнОборудования.СтавкаНДС22() Тогда
		
		Возврат Перечисления.СтавкиНДС.НДС22;	
		
	КонецЕсли;
	
КонецФункции

Функция СформироватьКомментарий(КассаККМ)
	
	Комментарий = НСтр("ru = 'Загружено из ККМ Офлайн: %КассаККМ%'");
	Комментарий = СтрЗаменить(Комментарий, "%КассаККМ%", КассаККМ);
	
	Возврат Комментарий;
	
КонецФункции

Функция КорректировкаЗагруженнойСтавкиНДС(НоменклатураПрейскуранта, ЗагруженнаяСтавкаНДС)
	Если ЗагруженнаяСтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда
		Если ЗначениеЗаполнено(НоменклатураПрейскуранта) Тогда
			Номенклатура = НоменклатураПрейскуранта.Номенклатура; 
			Если ЗначениеЗаполнено(Номенклатура) Тогда
				Если Номенклатура.СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда
					Результат = ЗагруженнаяСтавкаНДС;
				Иначе
					Результат = Перечисления.СтавкиНДС.БезНДС;
				КонецЕсли;	
			КонецЕсли;
		Иначе
			Результат = ЗагруженнаяСтавкаНДС;
		Конецесли;	
	Иначе	
		Результат = ЗагруженнаяСтавкаНДС;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ПолучитьУникальныеЗначенияИзМассива(ТабличнаяЧасть, КолонкаТЧ)
	
	Результат = Новый СписокЗначений;
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл 
		Если Результат.НайтиПоЗначению(СтрокаТЧ[КолонкаТЧ]) = Неопределено Тогда 
			Результат.Добавить(СтрокаТЧ[КолонкаТЧ]);
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции	

Процедура ЗаписатьФискальныеДанныеДляРасчетногоДокумента(ДокументОбъект)
	ПараметрыФискализации = Новый Структура;
	ПараметрыФискализации.Вставить("ДатаВремяЧека", ТекущаяДата());
	ПараметрыФискализации.Вставить("ДокументОснование", ДокументОбъект.Ссылка);
	ПараметрыФискализации.Вставить("Организация", ДокументОбъект.Организация);
	ПараметрыФискализации.Вставить("ТипРасчета", ДокументОбъект.ТипРасчета);
	ПараметрыФискализации.Вставить("НомерСменыККТ", 1);
	ПараметрыФискализации.Вставить("НомерЧекаККТ", ДокументОбъект.НомерЧекаККМ);
	ПараметрыФискализации.Вставить("ФискальныйПризнак", Строка(ДокументОбъект.НомерЧекаККМ));
	ПараметрыФискализации.Вставить("ТипДокумента", Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек);
	ПараметрыФискализации.Вставить("АдресСайтаПроверки", "");
	ПараметрыФискализации.Вставить("ЗаводскойНомерФН", "");
	ПараметрыФискализации.Вставить("РегистрационныйНомерККТ", "");
	ПараметрыФискализации.Вставить("ДополнительныйРеквизит", "");
	ПараметрыФискализации.Вставить("ДанныеЧекаXML", Неопределено);
	
	ОбщиеПараметры = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(ДокументОбъект, ДокументОбъект.Ссылка, ДокументОбъект.НомерЧекаККМ);
	
	СуммаЧека = 0;
	ОплатаНаличные = 0;
	ОплатаЭлектронно = 0;
	ОплатаПостоплата = 0;
	ОплатаПредоплата = 0;
	
	Для каждого ТекСтрока Из ОбщиеПараметры.ТаблицаОплат Цикл
		СуммаЧека = СуммаЧека + ТекСтрока.Сумма;
		Если ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Наличные Тогда
			ОплатаНаличные = ОплатаНаличные + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Электронно Тогда
			ОплатаЭлектронно = ОплатаЭлектронно + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Предоплата Тогда
			ОплатаПредоплата = ОплатаПредоплата + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Постоплата Тогда
			ОплатаПостоплата = ОплатаПостоплата + ТекСтрока.Сумма;
		КонецЕсли;	
	КонецЦикла;	
	ПараметрыФискализации.Вставить("СуммаЧека", СуммаЧека);
	ПараметрыФискализации.Вставить("ОплатаНаличные", ОплатаНаличные);
	ПараметрыФискализации.Вставить("ОплатаЭлектронно", ОплатаЭлектронно);
	ПараметрыФискализации.Вставить("ОплатаПредоплата", ОплатаПредоплата);
	ПараметрыФискализации.Вставить("ОплатаПостоплата", ОплатаПостоплата);
	
	ЗаписатьФискальнуюОперацию(ПараметрыФискализации);

КонецПроцедуры

Процедура СоздатьИЗаполнитьОтчетОПродажахЭвотор(Организация, КассаККМ, МассивСозданныхДокументов, РеквизитыККМ, ТаблицыДанных, Комментарий = "")
	
	ОтчетОРозничныхПродажахОбъект = Неопределено;
	
	ТаблицаСтавкиНДС = Новый ТаблицаЗначений;
	ТаблицаСтавкиНДС.Колонки.Добавить("СтатьяОплаты",		Новый ОписаниеТипов("СправочникСсылка.СтатьиАналитикиОплатыЧекаККМ"));
	ТаблицаСтавкиНДС.Колонки.Добавить("СтавкаНДС",			Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ТаблицаСтавкиНДС.Колонки.Добавить("СуммаНДС",			Новый ОписаниеТипов("Число"));
	ТаблицаСтавкиНДС.Колонки.Добавить("Сумма",				Новый ОписаниеТипов("Число"));
	ТаблицаСтавкиНДС.Колонки.Добавить("ТипОплаты",			Новый ОписаниеТипов("ПеречислениеСсылка.ТипыОплатЧекаККМ"));
	
	Если ЗначениеЗаполнено(ТаблицыДанных.Реквизиты.УникальныйИдентификатор) Тогда
		УИ = ТаблицыДанных.Реквизиты.УникальныйИдентификатор;
		ОтчетСсылка = Документы.ОтчетПоКассовойСмене.ПолучитьСсылку(УИ);
		ОтчетОРозничныхПродажахОбъект = ОтчетСсылка.ПолучитьОбъект();
		Если ОтчетОРозничныхПродажахОбъект = Неопределено Тогда
			ОтчетОРозничныхПродажахОбъект = Документы.ОтчетПоКассовойСмене.СоздатьДокумент();
			ОтчетОРозничныхПродажахОбъект.УстановитьСсылкуНового(ОтчетСсылка);
		КонецЕсли;
	Иначе
		ОтчетОРозничныхПродажахОбъект = Документы.ОтчетПоКассовойСмене.СоздатьДокумент();
	КонецЕсли;
	
	ОтчетОРозничныхПродажахОбъект.ОплатаНаличными.Очистить();
	ОтчетОРозничныхПродажахОбъект.ОплатаПлатежнымиКартами.Очистить();
	ОтчетОРозничныхПродажахОбъект.ПродажиПлатежногоАгента.Очистить();
	ОтчетОРозничныхПродажахОбъект.ПродажиТовары.Очистить();
	ОтчетОРозничныхПродажахОбъект.ПродажиРаботыУслуги.Очистить();
	ОтчетОРозничныхПродажахОбъект.ВозвратТовары.Очистить();
	ОтчетОРозничныхПродажахОбъект.ОтменаРаботыУслуги.Очистить();
	ОтчетОРозничныхПродажахОбъект.ПродажиПоСтавкамНДС.Очистить();
	
	ОтчетОРозничныхПродажахОбъект.Организация        = Организация;
	ОтчетОРозничныхПродажахОбъект.Дата               = ТаблицыДанных.Реквизиты.Дата;
	ОтчетОРозничныхПродажахОбъект.НомерСмены         = ТаблицыДанных.Реквизиты.НомерСмены;
	ОтчетОРозничныхПродажахОбъект.КассаККМ           = КассаККМ;
	ОтчетОРозничныхПродажахОбъект.Комментарий        = Комментарий;
	ОтчетОРозничныхПродажахОбъект.Ответственный      = Пользователи.ТекущийПользователь();
	
	ПараметрыДоговораЭквайринга = РеквизитыККМ.ПараметрыДоговораЭквайринга;
	ЭквайринговыйТерминал = Справочники.ЭквайринговыеТерминалы.ПустаяСсылка();
	Если ЗначениеЗаполнено(ПараметрыДоговораЭквайринга) Тогда
		Если ПараметрыДоговораЭквайринга.Терминалы.Количество()>0 Тогда
			ЭквайринговыйТерминал = ПараметрыДоговораЭквайринга.Терминалы[0].ЭквайринговыйТерминал;
		КонецЕсли;	
	КонецЕсли;	
	ИспользоватьОплатуПлатежнымиКартами = РеквизитыККМ.ИспользоватьОплатуПлатежнымиКартами;
	
	ЕстьНеопределеннныеНоменклатуры = Ложь;
	ПризнакиПредметаРасчетаТовары = РозничныеПродажиБГУ.ПризнакиПредметаРасчетаТовары();
	Для Каждого ТекНоменклатура Из ТаблицыДанных.Товары Цикл
		ЭтоУслуга = Истина;
		КомментарийКСтрокеНоменклатуры = "";
		НоменклатураПрейскуранта = ТекНоменклатура.Номенклатура;
		СтатьяАналитикиОплаты = Справочники.СтатьиАналитикиОплатыЧекаККМ.ПустаяСсылка();
		Если ЗначениеЗаполнено(НоменклатураПрейскуранта) Тогда
			Если ЗначениеЗаполнено(НоменклатураПрейскуранта.Номенклатура) Тогда
				ТипНоменклатуры = НоменклатураПрейскуранта.Номенклатура.ТипНоменклатуры;
				Если НЕ ПризнакиПредметаРасчетаТовары.Найти(ТипНоменклатуры) = Неопределено Тогда
					ЭтоУслуга = Ложь;
				КонецЕсли;
			КонецЕсли;
			СтатьяАналитикиОплаты = НоменклатураПрейскуранта.ОсновнаяСтатьяАналитикиОплаты;
		Иначе
			ЕстьНеопределеннныеНоменклатуры = Истина;
			КомментарийКСтрокеНоменклатуры = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Для списка услуг и работ (товаров) не определена номенклатура прейскуранта с кодом %1 не найдена в справочнике ""Прейскурант"".'"),
					СокрЛП(ТекНоменклатура.Код));
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = КомментарийКСтрокеНоменклатуры;
			Сообщение.Сообщить();
		КонецЕсли;
		
		Если ЭтоУслуга Тогда
			НоваяСтрока = ОтчетОРозничныхПродажахОбъект.ПродажиРаботыУслуги.Добавить(); 	
		Иначе
			НоваяСтрока = ОтчетОРозничныхПродажахОбъект.ПродажиТовары.Добавить(); 	
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекНоменклатура);
		
		НоваяСтрока.Номенклатура = НоменклатураПрейскуранта;
		НоваяСтрока.ЭтоРозничныйПокупатель = Истина;
		
		НоваяСтрока.Всего = НоваяСтрока.Сумма;
		СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(НоваяСтрока.СтавкаНДС);
		НоваяСтрока.СуммаНДС = НоваяСтрока.Сумма * СтавкаНДС / (100 + СтавкаНДС);
		НоваяСтрока.СтавкаНДС = КорректировкаЗагруженнойСтавкиНДС(НоменклатураПрейскуранта, НоваяСтрока.СтавкаНДС);
		
		НоваяСтрокаСтавкиНДС = ТаблицаСтавкиНДС.Добавить();
		НоваяСтрокаСтавкиНДС.СтатьяОплаты = СтатьяАналитикиОплаты;
		НоваяСтрокаСтавкиНДС.СтавкаНДС = НоваяСтрока.СтавкаНДС;
		НоваяСтрокаСтавкиНДС.СуммаНДС = НоваяСтрока.СуммаНДС;
		НоваяСтрокаСтавкиНДС.Сумма = НоваяСтрока.Сумма;
	КонецЦикла;	
	
	Для каждого ТекНоменклатура Из ТаблицыДанных.ВозвратыТоваров Цикл
		ЭтоУслуга = Истина;
		КомментарийКСтрокеНоменклатуры = "";
		НоменклатураПрейскуранта = ТекНоменклатура.Номенклатура;
		СтатьяАналитикиОплаты = Справочники.СтатьиАналитикиОплатыЧекаККМ.ПустаяСсылка();
		Если ЗначениеЗаполнено(НоменклатураПрейскуранта) Тогда
			Если ЗначениеЗаполнено(НоменклатураПрейскуранта.Номенклатура) Тогда
				ТипНоменклатуры = НоменклатураПрейскуранта.Номенклатура.ТипНоменклатуры;
				Если НЕ ПризнакиПредметаРасчетаТовары.Найти(ТипНоменклатуры) = Неопределено Тогда
					ЭтоУслуга = Ложь;
				КонецЕсли;
			КонецЕсли;
			СтатьяАналитикиОплаты = НоменклатураПрейскуранта.ОсновнаяСтатьяАналитикиОплаты;
		Иначе
			ЕстьНеопределеннныеНоменклатуры = Истина;
			КомментарийКСтрокеНоменклатуры = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Для списка отмены услуг (возврата товара) не определена номенклатура прейскуранта с кодом %1 не найдена в справочнике ""Прейскурант"".'"),
					СокрЛП(ТекНоменклатура.Код));
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = КомментарийКСтрокеНоменклатуры;
			Сообщение.Сообщить();
		КонецЕсли;
		
		Если ЭтоУслуга Тогда
			НоваяСтрока = ОтчетОРозничныхПродажахОбъект.ОтменаРаботыУслуги.Добавить(); 	
		Иначе
			НоваяСтрока = ОтчетОРозничныхПродажахОбъект.ВозвратТовары.Добавить(); 	
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекНоменклатура);
		
		НоваяСтрока.Номенклатура = НоменклатураПрейскуранта;
		НоваяСтрока.ЭтоРозничныйПокупатель = Истина;
		
		НоваяСтрока.Всего = НоваяСтрока.Сумма;
		СтавкаНДС = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(НоваяСтрока.СтавкаНДС);
		НоваяСтрока.СуммаНДС = НоваяСтрока.Сумма * СтавкаНДС / (100 + СтавкаНДС);
		НоваяСтрока.СтавкаНДС = КорректировкаЗагруженнойСтавкиНДС(НоменклатураПрейскуранта, НоваяСтрока.СтавкаНДС);
		
		НоваяСтрокаСтавкиНДС = ТаблицаСтавкиНДС.Добавить();
		НоваяСтрокаСтавкиНДС.СтатьяОплаты = СтатьяАналитикиОплаты;
		НоваяСтрокаСтавкиНДС.СтавкаНДС = НоваяСтрока.СтавкаНДС;
		НоваяСтрокаСтавкиНДС.СуммаНДС = (-1)*НоваяСтрока.СуммаНДС;
		НоваяСтрокаСтавкиНДС.Сумма = (-1)*НоваяСтрока.Сумма;
		
	КонецЦикла;
	
	ТаблицаСтавкиНДС.Свернуть("СтатьяОплаты, СтавкаНДС","Сумма, СуммаНДС");
	
	Если ЕстьНеопределеннныеНоменклатуры Тогда
		КомментарийКОплате = 
			НСтр("ru='Не определены все значения номенклатуры прейскуранта поэтому статьи аналитики оплаты в строках на закладках
			|""Расчеты наличными"" и ""Расчеты платежными картами"" требуют дополнительной проверки пользователя.'");
			
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = КомментарийКОплате;
		Сообщение.Сообщить();
	КонецЕсли;	
	
	ОплатыПоСтатьямПолная 	= ЗаполнитьСтатьиАналитикиОплаты(ТаблицыДанных.ОплатыПоСтатьям, Организация);
	ОплатыПоСтатьям 		= ОплатыПоСтатьямПолная.Скопировать();
	ОплатыПоСтатьям.Свернуть("ВидОперации, СтатьяАналитикиОплаты, ТипОплаты, ПараметрыДоговораПлатежногоАгента", "Сумма");
	Для Каждого Оплата ИЗ ОплатыПоСтатьям Цикл
		Если Оплата.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные Тогда
			НоваяСтрока = ОтчетОРозничныхПродажахОбъект.ОплатаНаличными.Добавить();
			НоваяСтрока.ВидОперации = Оплата.ВидОперации;
			НоваяСтрока.ЭтоРозничныйПокупатель = Истина;
			НоваяСтрока.СистемаНалогообложенияЧекаККМ = КассаККМ.СистемаНалогообложенияЧекаККМ;
			НоваяСтрока.СтатьяАналитикиОплаты = Оплата.СтатьяАналитикиОплаты; 
			НоваяСтрока.ПараметрыДоговораПлатежногоАгента = Оплата.ПараметрыДоговораПлатежногоАгента; 
			НоваяСтрока.Контрагент = КассаККМ.КонтрагентДляРозничныхПродаж;
			НоваяСтрока.Договор = КассаККМ.ДоговорДляРозничныхПродаж;
			НоваяСтрока.Сумма = Оплата.Сумма;
		ИначеЕсли Оплата.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта Тогда
			Если ЗначениеЗаполнено(ПараметрыДоговораЭквайринга) Тогда
				ПроцентТорговойУступки = 0;
				ПроцентТорговойУступкиОсновной = 0;
				ВидПлатежнойКарты = Справочники.ВидыПлатежныхКарт.ПустаяСсылка();
				ОсновнойВидПлатежнойКарты = Справочники.ВидыПлатежныхКарт.ПустаяСсылка();
				НомерВидаКарты = 1;
				Для каждого ТекНастройка Из ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание Цикл
					Если ТекНастройка.ОсновнойВид Тогда
						ОсновнойВидПлатежнойКарты = ТекНастройка.ВидПлатежнойКарты;
						ПроцентТорговойУступкиОсновной = ТекНастройка.ПроцентТорговойУступки;
					КонецЕсли;	
				КонецЦикла;
				
				Если НЕ ЗначениеЗаполнено(ВидПлатежнойКарты) Тогда
					ВидПлатежнойКарты = ОсновнойВидПлатежнойКарты;
					ПроцентТорговойУступки = ПроцентТорговойУступкиОсновной;
				КонецЕсли;	
				
				НоваяСтрока = ОтчетОРозничныхПродажахОбъект.ОплатаПлатежнымиКартами.Добавить();
				НоваяСтрока.ВидОперации = Оплата.ВидОперации;
				НоваяСтрока.ЭтоРозничныйПокупатель = Истина;
				НоваяСтрока.ПараметрыДоговораЭквайринга = ПараметрыДоговораЭквайринга;
				НоваяСтрока.СистемаНалогообложенияЧекаККМ = КассаККМ.СистемаНалогообложенияЧекаККМ;
				НоваяСтрока.СтатьяАналитикиОплаты = Оплата.СтатьяАналитикиОплаты;; 
				НоваяСтрока.ПараметрыДоговораПлатежногоАгента = Оплата.ПараметрыДоговораПлатежногоАгента; 
				НоваяСтрока.Контрагент = КассаККМ.КонтрагентДляРозничныхПродаж;
				НоваяСтрока.Договор = КассаККМ.ДоговорДляРозничныхПродаж;
				НоваяСтрока.Сумма = Оплата.Сумма;
				НоваяСтрока.ВидПлатежнойКарты = ВидПлатежнойКарты;
				НоваяСтрока.ПроцентКомиссии = ПроцентТорговойУступки;
				НоваяСтрока.СуммаКомиссии = Окр(Оплата.Сумма*ПроцентТорговойУступки/100, 2);
				НоваяСтрока.ЭквайринговыйТерминал = ЭквайринговыйТерминал;
			Иначе	
				КомментарийКОплате = 
				НСтр("ru='Не определены параметры договора эквайринга для правила обмена с офлайн оборудованием.
				|Следует в правилах обмена для кассы ККМ (раздел ""Денежные средства"" - Управление ККТ - Кассы ККМ (фискальные регистраторы))
				|указать элемент справочника ""Параметры договора и операций эквайринга"".'");
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = КомментарийКОплате;
				Сообщение.Сообщить();
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	ОтчетОРозничныхПродажахОбъект.СуммаДокумента 							= ОтчетОРозничныхПродажахОбъект.ОплатаНаличными.Итог("Сумма");
	ОтчетОРозничныхПродажахОбъект.СуммаПродажНаличнымиРозничнымПокупателям 	= ОтчетОРозничныхПродажахОбъект.ОплатаНаличными.Итог("Сумма");
	
	Для Каждого ТекПлатеж Из ОплатыПоСтатьямПолная Цикл
		Если ЗначениеЗаполнено(ТекПлатеж.ПараметрыДоговораПлатежногоАгента) Тогда
			НоваяСтрока 									= ОтчетОРозничныхПродажахОбъект.ПродажиПлатежногоАгента.Добавить();
			НоваяСтрока.ПараметрыДоговораПлатежногоАгента 	= ТекПлатеж.ПараметрыДоговораПлатежногоАгента;
			НоваяСтрока.ТипОплаты 							= ТекПлатеж.ТипОплаты;
			НоваяСтрока.Сумма 								= ТекПлатеж.Сумма;
			ПроцентКомиссионногоВознаграждения 				= ТекПлатеж.ПараметрыДоговора.ПроцентКомиссионногоВознаграждения;
			НоваяСтрока.СуммаВознаграждения 				= Окр(ТекПлатеж.Сумма * ПроцентКомиссионногоВознаграждения / 100, 2);
		КонецЕсли;
		
		НоваяСтрокаСтавкиНДС 						= ОтчетОРозничныхПродажахОбъект.ПродажиПоСтавкамНДС.Добавить();
		СтавкаНДС 									= УчетНДСКлиентСервер.ЗначениеСтавкиНДС(ТекПлатеж.СтавкаНДС);
		НоваяСтрокаСтавкиНДС.СуммаНДС 				= ТекПлатеж.Сумма * СтавкаНДС / (100 + СтавкаНДС);
		НоваяСтрокаСтавкиНДС.СтатьяАналитикиОплаты	= ТекПлатеж.СтатьяАналитикиОплаты;
		НоваяСтрокаСтавкиНДС.СтавкаНДС 				= СтавкаНДС;
		НоваяСтрокаСтавкиНДС.Сумма 					= ТекПлатеж.Сумма;
		НоваяСтрокаСтавкиНДС.ЭтоРозничныйПокупатель = Истина;
		НоваяСтрокаСтавкиНДС.ТипОплаты				= ТекПлатеж.ТипОплаты;
	КонецЦикла;
	ОтчетОРозничныхПродажахОбъект.ПродажиПлатежногоАгента.Свернуть("ПараметрыДоговораПлатежногоАгента, ТипОплаты", "Сумма, СуммаВознаграждения, СуммаКомиссии");
	
	Попытка
		ОтчетОРозничныхПродажахОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ОтчетОРозничныхПродажахОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
	УзелОбъект = РеквизитыККМ.УзелИнформационнойБазы.ПолучитьОбъект();
	УзелОбъект.ДатаЗагрузки = ТекущаяДатаСеанса();
	УзелОбъект.Записать();
	
	МассивСозданныхДокументов.Добавить(ОтчетОРозничныхПродажахОбъект.Ссылка);
	
КонецПроцедуры

Функция ЗаполнитьСтатьиАналитикиОплаты(ТаблицаКодов, Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаКодов.КодТовара КАК КодТовара,
	               |	ТаблицаКодов.ВидОперации КАК ВидОперации,
	               |	ТаблицаКодов.ТипОплаты КАК ТипОплаты,
	               |	ТаблицаКодов.Сумма КАК Сумма,
	               |	ТаблицаКодов.СтавкаНДС КАК СтавкаНДС
	               |ПОМЕСТИТЬ ВТКоды
	               |ИЗ
	               |	&ТаблицаКодов КАК ТаблицаКодов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КодыТоваровSKU.Номенклатура.ОсновнаяСтатьяАналитикиОплаты КАК СтатьяАналитикиОплаты,
	               |	ВТКоды.ВидОперации КАК ВидОперации,
	               |	ВТКоды.ТипОплаты КАК ТипОплаты,
	               |	СУММА(ВТКоды.Сумма) КАК Сумма,
	               |	КодыТоваровSKU.Номенклатура.ПараметрыДоговораПлатежногоАгента КАК ПараметрыДоговораПлатежногоАгента,
	               |	ВТКоды.СтавкаНДС КАК СтавкаНДС
	               |ИЗ
	               |	ВТКоды КАК ВТКоды
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыТоваровSKU КАК КодыТоваровSKU
	               |		ПО ВТКоды.КодТовара = КодыТоваровSKU.SKU
	               |ГДЕ
	               |	КодыТоваровSKU.Организация = &Организация
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КодыТоваровSKU.Номенклатура.ОсновнаяСтатьяАналитикиОплаты,
	               |	ВТКоды.ВидОперации,
