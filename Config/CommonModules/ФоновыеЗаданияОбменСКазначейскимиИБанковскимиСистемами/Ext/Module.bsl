//ПомощникЗагрузкиФорматовОбменаБанкиКС

Процедура ПомощникЗагрузкиФорматовОбменаБанкиКСЗагрузитьФайлВОбщемМодуле(Параметры, АдресВХранилище) Экспорт
	
	СтруктураРезультата = Новый Структура;
	
	Попытка
		ДиспетчерФайлов = Обработки.ПомощникЗагрузкиФорматовОбменаБанкиКС.Создать();
		Результат = ДиспетчерФайлов.ЗагрузитьФайл(ПоместитьВоВременноеХранилище(Параметры.ФайлЗагрузки, Параметры.УникальныйИдентификатор), Параметры.НеОбновлятьВидОбмена);
	Исключение
		Результат = Ложь;
	КонецПопытки;
	
	СтруктураРезультата.Вставить("Результат", Результат);
    ПоместитьВоВременноеХранилище(СтруктураРезультата,АдресВХранилище);
	
КонецПроцедуры

Процедура ЗагрузитьОбъектыИзЗадания(Параметры, АдресВХранилище) Экспорт
	
	ЗаданиеНаИмпорт         = Параметры.ЗаданиеНаИмпорт;	
	
	ОбработкаОбмена         = Справочники.ТипыОбменаБанкиКС.ПолучитьОбработку(ЗаданиеНаИмпорт.ВидОбмена); 
	
	Если ОбработкаОбмена    = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Отказ                   = Ложь;
	ДанныеНовыхКонтрагентов = "";

	ОбработкаОбмена.ЗагрузитьОбъекты(ЗаданиеНаИмпорт, Отказ, ДанныеНовыхКонтрагентов);	
	
	СтруктураРезультата     = Новый Структура;
	
	СтруктураРезультата.Вставить("Отказ",                   Отказ);
    СтруктураРезультата.Вставить("ДанныеНовыхКонтрагентов", ЗначениеВСтрокуВнутр(ДанныеНовыхКонтрагентов));
	СтруктураРезультата.Вставить("ВызыватьДиалог",          (ЗаданиеНаИмпорт.ВидОбмена.ПорядокИмпортаКонтрагентов = 1) И (ДанныеНовыхКонтрагентов.Количество() > 0));
	
	ПоместитьВоВременноеХранилище(СтруктураРезультата, АдресВХранилище);
	
КонецПроцедуры	
