
#Область ПрограммныйИнтерфейс

Функция ЭтоВерсияКОРП() Экспорт
	
	Возврат СтрНайти(ВРег(Метаданные.Имя), "КОРП") > 0;
	
КонецФункции

Функция ЭтоВерсияПРОФ() Экспорт
	
	Возврат НЕ (ЭтоБазоваяВерсия() ИЛИ ЭтоВерсияКОРП());
	
КонецФункции

Функция ЭтоБазоваяВерсия() Экспорт
	
	Возврат СтандартныеПодсистемыСервер.ЭтоБазоваяВерсияКонфигурации();
	
КонецФункции

Функция ИмяПрограммы() Экспорт
	
	//Используется для версий ПРОФ и Базовая в кчестве имени программы
	// для КОРП версии БухгалтерияГосударственногоУчреждения - имя библиотеки, имя программы определяется отдельно
	//
	Если ЭтоБазоваяВерсия() Тогда
		Возврат "БухгалтерияГосударственногоУчрежденияБазовая";
	Иначе
		Возврат "БухгалтерияГосударственногоУчреждения";
	КонецЕсли;
	
КонецФункции

Функция ИмяПрограммыЛат() Экспорт
	
	//Используется для версий ПРОФ и Базовая в кчестве имени программы
	// для КОРП версии StateAccounting - имя библиотеки, имя программы определяется отдельно
	//
	Если ЭтоБазоваяВерсия() Тогда
		Возврат "StateAccountingBase";
	Иначе
		Возврат "StateAccounting";
	КонецЕсли;
	
КонецФункции

Функция ИмяВариантаПриложения() Экспорт
	
	Значение = "Unknown";

	Если ВРег(Метаданные.Имя) = ВРег("БухгалтерияГосударственногоУчреждения") Тогда
		Значение = "StateAccounting";
	ИначеЕсли ВРег(Метаданные.Имя) = ВРег("БухгалтерияГосударственногоУчрежденияБазовая") Тогда
		Значение = "StateAccountingBase";
	ИначеЕсли ВРег(Метаданные.Имя) = ВРег("БухгалтерияГосударственногоУчрежденияКОРП") Тогда
		Значение = "StateAccountingCorp";	
	КонецЕсли;

	Возврат Значение;
	
КонецФункции	

#КонецОбласти
