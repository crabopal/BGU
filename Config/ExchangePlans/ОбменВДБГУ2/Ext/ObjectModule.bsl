#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// В таблице "Организации" очистить не найденные организации - они приехали из другой базы
	МассивКУдалению = Новый Массив;
	Для Каждого СтрТЧ Из Организации Цикл
		Если Не ОбщегоНазначения.СсылкаСуществует(СтрТЧ.Организация) Тогда
			МассивКУдалению.Добавить(СтрТЧ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивКУдалению Цикл
		Организации.Удалить(ЭлМас);
	КонецЦикла;
	
	// В таблице "ЦМОСлужебные" сократить ЦМО - оставить по 1 на каждую организацию
	// и заполнить "Организацию", если она пустая.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЦМОСлужебные",ЦМОСлужебные.Выгрузить());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбменВДБГУ2ЦМОСлужебные.НомерСтроки КАК НомерСтроки,
	|	ВЫРАЗИТЬ(ОбменВДБГУ2ЦМОСлужебные.ЦМО КАК Справочник.ЦМО) КАК ЦМО
	|ПОМЕСТИТЬ Таб
	|ИЗ
	|	&ЦМОСлужебные КАК ОбменВДБГУ2ЦМОСлужебные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(Таб.НомерСтроки) КАК НомерСтроки,
	|	Таб.ЦМО.Владелец КАК ЦМОВладелец
	|ИЗ
	|	Таб КАК Таб
	|ГДЕ
	|	Таб.ЦМО.Владелец ЕСТЬ НЕ NULL 
	|
	|СГРУППИРОВАТЬ ПО
	|	Таб.ЦМО.Владелец";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЧ = РезультатЗапроса.Выгрузить();
	
	МассивКУдалению = Новый Массив;
	Для Каждого СтрТЧ Из ЦМОСлужебные Цикл
		СтрокаЗапроса = ТЧ.Найти(СтрТЧ.НомерСтроки,"НомерСтроки");
		Если СтрокаЗапроса = Неопределено Тогда
			МассивКУдалению.Добавить(СтрТЧ);
		ИначеЕсли Не ЗначениеЗаполнено(СтрТЧ.Организация) Тогда
			СтрТЧ.Организация = СтрокаЗапроса.ЦМОВладелец;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивКУдалению Цикл
		ЦМОСлужебные.Удалить(ЭлМас);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ИнициализироватьОбъект(ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	Если ЭтоЕдинственнаяНастройкаПланаОбмена() Тогда
		Константы.ИспользоватьСинхронизациюСВД.Установить(Ложь);
	КонецЕсли;
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСинхронизациюСВД") Тогда
		Константы.ИспользоватьСинхронизациюСВД.Установить(Истина);
	КонецЕсли;
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ИнициализироватьОбъект(ДанныеЗаполнения)
	
	Если Не ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрироватьИзменения = Ложь;
	ЗагружатьСуммыВыбытияМЗ = Ложь;
	
КонецПроцедуры

Функция ЭтоЕдинственнаяНастройкаПланаОбмена()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	ПланОбмена.ОбменВДБГУ2 КАК ОбменВДБГУ2
	|ГДЕ
	|	ОбменВДБГУ2.Ссылка <> &Ссылка
	|	И ОбменВДБГУ2.Ссылка <> &ЭтотУзел";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ЭтотУзел", ПланыОбмена.ОбменВДБГУ2.ЭтотУзел());
	Возврат Запрос.Выполнить().Пустой();
КонецФункции

#КонецОбласти

#КонецЕсли