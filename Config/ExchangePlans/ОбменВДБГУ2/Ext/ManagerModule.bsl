#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем
	
// Заполняет настройки, влияющие на использование плана обмена.
// 
// Параметры:
//  Настройки - Структура - настройки плана обмена по умолчанию, см. ОбменДаннымиСервер.НастройкиПланаОбменаПоУмолчанию,
//                          описание возвращаемого значения функции.
//
Процедура ПриПолученииНастроек(Настройки) Экспорт

	Настройки.ИмяКонфигурацииИсточника = "БухгалтерияГосударственногоУчреждения";
	Настройки.ИмяКонфигурацииПриемника.Вставить("ВещевоеДовольствие");
	
	Настройки.ПланОбменаИспользуетсяВМоделиСервиса = Истина; 
	
	Настройки.Алгоритмы.ПриПолученииВариантовНастроекОбмена   = Истина;
	Настройки.Алгоритмы.ПриПолученииОписанияВариантаНастройки = Истина;
	
КонецПроцедуры

// Заполняет коллекцию вариантов настроек, предусмотренных для плана обмена.
// 
// Параметры:
//  ВариантыНастроекОбмена - ТаблицаЗначений - коллекция вариантов настроек обмена, см. описание возвращаемого значения
//                                       функции НастройкиПланаОбменаПоУмолчанию общего модуля ОбменДаннымиСервер.
//  ПараметрыКонтекста     - Структура - см. ОбменДаннымиСервер.ПараметрыКонтекстаПолученияВариантовНастроек,
//                                       описание возвращаемого значения функции.
//
Процедура ПриПолученииВариантовНастроекОбмена(ВариантыНастроекОбмена, ПараметрыКонтекста) Экспорт

	ВариантНастройки = ВариантыНастроекОбмена.Добавить();
	ВариантНастройки.ИдентификаторНастройки = "";
	ВариантНастройки.КорреспондентВМоделиСервиса = Истина;
	ВариантНастройки.КорреспондентВЛокальномРежиме = Истина;

КонецПроцедуры

Процедура ПриПолученииОписанияВариантаНастройки(ОписаниеВарианта, ИдентификаторНастройки, ПараметрыКонтекста) Экспорт
	
	ОписаниеВарианта.КраткаяИнформацияПоОбмену   = НСтр("ru = 'Обмен с ""1С: Вещевое довольствие"", редакция 2.0'");
	ОписаниеВарианта.ПодробнаяИнформацияПоОбмену = "ПланОбмена.ОбменВДБГУ2.Форма.ПодробнаяИнформация";
	
	ОписаниеВарианта.ИмяКонфигурацииКорреспондента          = "ВещевоеДовольствие";	
	ОписаниеВарианта.НаименованиеКонфигурацииКорреспондента = НСтр("ru = '1С:Вещевое довольствие 8'");
	
	ОписаниеВарианта.ИмяФайлаНастроекДляПриемника = НСтр("ru = 'Настройки обмена БГУ, ред. 2 - ВД, ред. 2'");
	
	ОписаниеВарианта.ПутьКФайлуКомплектаПравилНаПользовательскомСайте = "https://releases.1c.ru/project/UniformAllowances20";
	ОписаниеВарианта.ПутьКФайлуКомплектаПравилВКаталогеШаблонов = "1c\UniformAllowances\";
	
	ОписаниеВарианта.ЗаголовокКомандыДляСозданияНовогоОбменаДанными = НСтр("ru = 'Обмен с ""1С: Вещевое довольствие"", редакция 2.0'");
	ОписаниеВарианта.ЗаголовокПомощникаСозданияОбмена               = НСтр("ru = 'Обмен с ""1С: Вещевое довольствие"", редакция 2.0 (настройка)'");
	ОписаниеВарианта.ЗаголовокУзлаПланаОбмена                       = НСтр("ru = 'Обмен с ""1С: Вещевое довольствие"", редакция 2.0'");
	
	ОписаниеВарианта.ИспользуемыеТранспортыСообщенийОбмена = ИспользуемыеТранспортыСообщенийОбмена();
	ОписаниеВарианта.ИспользоватьПомощникСозданияОбменаДанными = Истина;
	
	ОписаниеВарианта.ОбщиеДанныеУзлов = "Организации";
	
КонецПроцедуры

Функция ТекстОписанияОграниченийПередачиДанных(ПараметрОрганизации) Экспорт

	Если ПараметрОрганизации.Количество() = 0 Тогда
		
		Возврат НСтр("ru = 'Не выбраны организации, участвующие в обмене.'");
		
	Иначе
		
		Возврат СтрШаблон(НСтр("ru = 'Только по выбранным организациям:
			|%1.'"), СтрСоединить(ПараметрОрганизации, ";" + Символы.ПС));
		
	КонецЕсли;

КонецФункции

#Область Обработчики

Процедура РегистрацияИзмененийНачальнойВыгрузкиДанных(Знач Получатель, СтандартнаяОбработка, Отбор) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ИспользуемыеОрганизации = Новый Массив;
	ОрганизцииОбмена = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Получатель, "Организации, ЦМОСлужебные");
	Выборка = ОрганизцииОбмена.Организации.Выбрать();
	Пока Выборка.Следующий() Цикл
		ИспользуемыеОрганизации.Добавить(Выборка.Организация);
	КонецЦикла;
	ЦМОСлужебные = Новый ТаблицаЗначений;
	ЦМОСлужебные.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ЦМОСлужебные.Колонки.Добавить("ЦМО", Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	Выборка = ОрганизцииОбмена.ЦМОСлужебные.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ЦМОСлужебные.Добавить(), Выборка);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа = ЛОЖЬ
	|	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МягкийИнвентарь)
	|	И Номенклатура.ПометкаУдаления = ЛОЖЬ";
	Запрос.Текст = Запрос.Текст +
	ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Подразделения.Ссылка
	|ИЗ
	|	Справочник.Подразделения КАК Подразделения
	|ГДЕ
	|	Подразделения.Владелец В(&Организации)
	|	И Подразделения.ПометкаУдаления = ЛОЖЬ";
	Запрос.Текст = Запрос.Текст +
	ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудники.Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ЭтоГруппа = ЛОЖЬ
	|	И Сотрудники.ПометкаУдаления = ЛОЖЬ
	|	И Сотрудники.Владелец В(&Организации)
	|	И НЕ ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА КАК Поле1
	|				ИЗ
	|					Справочник.ЦМО КАК ЦМО
	|				ГДЕ
	|					ЦМО.Ссылка В (&ЦМОСлужебные)
	|					И ЦМО.Сотрудник = Сотрудники.Ссылка
	|					И ЦМО.Владелец В (&Организации))";
	Запрос.Текст = Запрос.Текст +
	ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦМО.Ссылка
	|ИЗ
	|	Справочник.ЦМО КАК ЦМО
	|ГДЕ
	|	ЦМО.ПометкаУдаления = ЛОЖЬ
	|	И ЦМО.Владелец В(&Организации)
	|	И НЕ ЦМО.Ссылка В (&ЦМОСлужебные)
	|	И ЦМО.ЭтоГруппа = ЛОЖЬ";
	Запрос.Текст = Запрос.Текст +
	ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МестаХранения.Ссылка
	|ИЗ
	|	Справочник.МестаХранения КАК МестаХранения
	|ГДЕ
	|	МестаХранения.Владелец В(&Организации)
	|	И МестаХранения.ЭтоГруппа = ЛОЖЬ
	|	И МестаХранения.ПометкаУдаления = ЛОЖЬ";
	Запрос.Текст = Запрос.Текст +
	ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОперацииУчетаВещевогоДовольствия.Ссылка
	|ИЗ
	|	Справочник.ОперацииУчетаВещевогоДовольствия КАК ОперацииУчетаВещевогоДовольствия
	|ГДЕ
	|	ОперацииУчетаВещевогоДовольствия.Организация В(&Организации)
	|	И ОперацииУчетаВещевогоДовольствия.ПометкаУдаления = ЛОЖЬ
	|	И ОперацииУчетаВещевогоДовольствия.СпособФормированияОперации В (ЗНАЧЕНИЕ(Перечисление.СпособыФормированияОперацийУчетаВещевогоДовольствия.ОднаОперация), ЗНАЧЕНИЕ(Перечисление.СпособыФормированияОперацийУчетаВещевогоДовольствия.ПоследовательностьОпераций), ЗНАЧЕНИЕ(Перечисление.СпособыФормированияОперацийУчетаВещевогоДовольствия.ОперацияНеПереносится))";
	Запрос.Текст = Запрос.Текст +
	ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтатьиАналитикиВещевогоДовольствия.Ссылка
	|ИЗ
	|	Справочник.СтатьиАналитикиВещевогоДовольствия КАК СтатьиАналитикиВещевогоДовольствия
	|ГДЕ
	|	СтатьиАналитикиВещевогоДовольствия.ПометкаУдаления = ЛОЖЬ
	|	И СтатьиАналитикиВещевогоДовольствия.Организация В(&Организации)";
	Запрос.Текст = Запрос.Текст +
	ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПостоянноДействующиеКомиссии.Ссылка
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии КАК ПостоянноДействующиеКомиссии
	|ГДЕ
	|	ПостоянноДействующиеКомиссии.Владелец В(&Организации)
	|	И ПостоянноДействующиеКомиссии.ПометкаУдаления = ЛОЖЬ";
	Запрос.Текст = Запрос.Текст +
	ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	|	И ЕПСБУ.Код В (&КодыСчетов)";
	
	КодыСчетов = Новый Массив;
	КодыСчетов.Добавить("105.25");
	КодыСчетов.Добавить("105.26");
	КодыСчетов.Добавить("105.35");
	КодыСчетов.Добавить("105.36");
	КодыСчетов.Добавить("105.45");
	КодыСчетов.Добавить("105.46");
	КодыСчетов.Добавить("109.60");
	КодыСчетов.Добавить("109.70");
	КодыСчетов.Добавить("109.80");
	КодыСчетов.Добавить("401.10");
	КодыСчетов.Добавить("401.20");
	КодыСчетов.Добавить("304.04");
	Запрос.УстановитьПараметр("КодыСчетов", КодыСчетов);
	Запрос.УстановитьПараметр("Организации", ИспользуемыеОрганизации);
	Запрос.УстановитьПараметр("ЦМОСлужебные", ЦМОСлужебные.ВыгрузитьКолонку("ЦМО"));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ЗарегистрированныеСсылки = Новый Массив;
	ЗарегистрироватьИзмененияИзРезультатаЗапроса(Получатель, РезультатЗапроса[0].Выбрать()); // номенклатура
	ЗарегистрироватьИзмененияИзРезультатаЗапроса(Получатель, РезультатЗапроса[1].Выбрать()); // подразделения
	ЗарегистрироватьИзмененияИзРезультатаЗапроса(Получатель, РезультатЗапроса[2].Выбрать()); // сотрудники
	ЗарегистрироватьИзмененияИзРезультатаЗапроса(Получатель, РезультатЗапроса[3].Выбрать()); // ЦМО
	ЗарегистрироватьИзмененияИзРезультатаЗапроса(Получатель, РезультатЗапроса[4].Выбрать()); // Места хранения
	ЗарегистрироватьИзмененияИзРезультатаЗапроса(Получатель, РезультатЗапроса[5].Выбрать()); // ОперацииУчетаВещевогоДовольствия
	ЗарегистрироватьИзмененияИзРезультатаЗапроса(Получатель, РезультатЗапроса[6].Выбрать()); // СтатьиАналитикиВещевогоДовольствия
	ЗарегистрироватьИзмененияИзРезультатаЗапроса(Получатель, РезультатЗапроса[7].Выбрать()); // Комиссии
	ЗарегистрироватьИзмененияИзРезультатаЗапроса(Получатель, РезультатЗапроса[8].Выбрать()); // ЕПСБУ
	
КонецПроцедуры

// Возвращает имя обработки выгрузки в составе конфигурации
//
Функция ИмяОбработкиВыгрузки() Экспорт
	
	Возврат "ОбработчикиВыгрузкиВВД2";
	
КонецФункции

// Возвращает имя обработки загрузки в составе конфигурации
//
Функция ИмяОбработкиЗагрузки() Экспорт
	
	Возврат "ОбработчикиЗагрузкиИзВД2";
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает массив используемых транспортов сообщений для этого плана обмена
//
// Возвращаемое значение:
//  Массив из ОбработкаМенеджер
//
Функция ИспользуемыеТранспортыСообщенийОбмена()
	
	Результат = Новый Массив;
	Результат.Добавить(Обработки.ТранспортСообщенийОбменаCOM);
	Результат.Добавить(Обработки.ТранспортСообщенийОбменаFILE);
	Результат.Добавить(Обработки.ТранспортСообщенийОбменаFTP);
	Результат.Добавить(Обработки.ТранспортСообщенийОбменаEMAIL);
	Результат.Добавить(Обработки.ТранспортСообщенийОбменаWS);
	
	Возврат Результат;
 	
КонецФункции

Процедура ЗарегистрироватьИзмененияИзРезультатаЗапроса(Получатель, Выборка, ЗарегистрированныеСсылки = Неопределено, ВключаяРодителя = Ложь)

	Пока Выборка.Следующий() Цикл
	
		ПланыОбмена.ЗарегистрироватьИзменения(Получатель, Выборка.Ссылка);
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
