		Возврат;
	КонецЕсли;
	
	Макет = ПланыОбмена.ОбменБГУ2_БГУ2_ГИСГМП.ПолучитьМакет("ПодробнаяИнформация");
	ПолеHTMLДокумента = Макет.ПолучитьТекст();
	
    Заголовок = НСтр("ru = 'Информация о синхронизации данных ГАН и АН конфигураций БГУ 2.0'");
	
КонецПроцедуры
