	ПоказатьПредупреждение(, Стр);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьАкутивностьОперацийНаСервере(Знач Организации)
	Перем Таб, Отбор, Запись, Объект, Набор;
	
	УстановитьПривилегированныйРежим(Истина);
	Отбор = Новый Структура;
	Отбор.Вставить("ИУИ", ФИББГУМенеджерОбмена.ИзмененУИ());
	Отбор.Вставить("ПУИ", ФИББГУМенеджерОбмена.ПолученУИ());
	Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Док.Ссылка КАК Ссылка
			|ИЗ	Документ.ОперацияБух КАК Док
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК Рег
			|ПО (Рег.Регистратор = Док.Ссылка)
			|ГДЕ (НЕ Док.ПометкаУдаления) И (НЕ Рег.Активность)
			|  И ((Док.ИДИсточника = &ИУИ) ИЛИ (Док.ИДИсточника = &ПУИ))";
	Если (Организации.Количество() <> 0) Тогда
		Текст = Текст + " И (Док.Организация В (&Организации))";
		Отбор.Вставить("Организации", Организации);
	КонецЕсли;	
	Таб = ФИББГУМенеджерОбмена.ПолучитьДанные(Текст, Отбор);
	Для Каждого Запись Из Таб Цикл
		Объект = Запись.Ссылка.ПолучитьОбъект();
		Если (Объект = Неопределено) Тогда
			Продолжить;
		ИначеЕсли Объект.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Набор = Объект.Движения.ЖурналПроводокЕПСБУ;
		Набор.Прочитать();
		Набор.УстановитьАктивность(Истина);
		Попытка
			Набор.Записать();
		Исключение
			ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Запись.Ссылка);
		КонецПопытки;
		Если (Объект.ИДИсточника = Отбор.ПУИ) Тогда
			Объект.ИДИсточника = Отбор.ИУИ;
			Объект.ОбменДанными.Загрузка = Истина;
			Попытка
				Объект.Записать();
			Исключение
				ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Запись.Ссылка);
			КонецПопытки;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьАкутивностьОпераций(Команда)
	Перем Стр, Организации, Запись;
	
	Организации = Новый Массив;
	Для Каждого Запись Из Объект.Организации Цикл
		Если Запись.Организация.Пустая() Тогда
			Продолжить;
		ИначеЕсли (Организации.Найти(Запись.Организация) <> Неопределено) Тогда
			Продолжить;
		КонецЕсли;                               
		Организации.Добавить(Запись.Организация);
	КонецЦикла;	
	УстановитьАкутивностьОперацийНаСервере(Организации);
	Стр = НСтр("ru = 'Активность у бухгалтерских операций установлена'");
	ПоказатьПредупреждение(, Стр);
	
КонецПроцедуры

#КонецОбласти


