// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ
#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПериодРегистрацииВМесяцахЕПСБУПриИзменении(Элемент)
	
	Объект.МинимальныйПериодРегистрацииВМесяцахЕПСБУ = Мин(Макс(1, Объект.МинимальныйПериодРегистрацииВМесяцахЕПСБУ), 96);
	Объект.МаксимальныйПериодРегистрацииВМесяцахЕПСБУ = Макс(Мин(96, Объект.МаксимальныйПериодРегистрацииВМесяцахЕПСБУ), Объект.МинимальныйПериодРегистрацииВМесяцахЕПСБУ);
	Объект.ПериодРегистрацииВМесяцахЕПСБУ = Мин(Макс(Объект.ПериодРегистрацииВМесяцахЕПСБУ, Объект.МинимальныйПериодРегистрацииВМесяцахЕПСБУ), Объект.МаксимальныйПериодРегистрацииВМесяцахЕПСБУ);
	
КонецПроцедуры

&НаКлиенте
Процедура РучнаяНастройкаПриИзменении(Элемент)
	
	Если Объект.ЭтоБМО Тогда
		Элементы.СтраницыВариантовНастройки.ТекущаяСтраница = Элементы.СтраницаВариантНастрокиСБМО;
		Элементы.РучнаяНастройка.Видимость = Ложь;
		Объект.РучнаяНастройка = Ложь;
	ИначеЕсли Объект.РучнаяНастройка Тогда
		Объект.МинимальныйПериодРегистрацииВМесяцахЕПСБУ = 1;
		Объект.МаксимальныйПериодРегистрацииВМесяцахЕПСБУ = 96;
		Если (Не Элементы.СтраницаВариантНастрокиСБГУ.Видимость) Тогда
			Элементы.СтраницаВариантНастрокиСБГУ.Видимость = Истина;
		КонецЕсли;
		Элементы.СтраницыВариантовНастройки.ТекущаяСтраница = Элементы.СтраницаВариантНастрокиСБГУ;
	Иначе
		Элементы.СтраницыВариантовНастройки.ТекущаяСтраница = Элементы.СтраницаВариантНастрокиСБМО;
		Объект.Организации.Очистить();
		Объект.Счета.Очистить();
		Объект.ИспользоватьОтборПоСчетам = Ложь;
		Объект.ВыгружатьДанныеПоЗабалансовымСчетам = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

