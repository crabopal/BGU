&НаСервереБезКонтекста
// Процедура помечает на удаление содержимое справочника.
//
// Параметры :
//	Имя - Строка - имя справочника.
//
Процедура ПометитьНаУдалениеСправочник(Знач Имя)
	Перем Текст, Таб, Запись, Объект;

	УстановитьПривилегированныйРежим(Истина);
	Пока Истина Цикл
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 100
		        |	Спр.Ссылка КАК Ссылка
		        |ИЗ	Справочник." + Имя + " КАК Спр
		        |ГДЕ (НЕ Спр.ПометкаУдаления)";
		Таб = ФИББГУМенеджерОбмена.ПолучитьДанные(Текст);
		Если (Таб.Количество() = 0) Тогда
			Прервать;
		КонецЕсли;
		Для Каждого Запись Из Таб Цикл
			Объект = Запись.Ссылка.ПолучитьОбъект();
			Если (Объект = Неопределено) Тогда
				Продолжить;
			ИначеЕсли Объект.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			Объект.ПометкаУдаления = Истина;
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры	

