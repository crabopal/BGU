&НаСервереБезКонтекста
Процедура УдалитьОперацииНаСервере()
	Перем Текст, Таб, Запись, Объект, Отбор;

	УстановитьПривилегированныйРежим(Истина);
	Отбор = Новый Структура;
	Отбор.Вставить("ИУИ", ФИББГУМенеджерОбмена.ИзмененУИ());
	Отбор.Вставить("ПУИ", ФИББГУМенеджерОбмена.ПолученУИ());
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 100
	        |	Док.Ссылка КАК Ссылка
	        |ИЗ	Документ.ОперацияБух КАК Док
	        |ГДЕ (НЕ Док.ПометкаУдаления)
			|  И (Док.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
			|  И ((Док.ИДИсточника = &ИУИ) ИЛИ (Док.ИДИсточника = &ПУИ))";
	Пока Истина Цикл
		Таб = ФИББГУМенеджерОбмена.ПолучитьДанные(Текст, Отбор);
		Если (Таб.Количество() = 0) Тогда
			Прервать;
		КонецЕсли;
		Для Каждого Запись Из Таб Цикл
			Объект = Запись.Ссылка.ПолучитьОбъект();
			Если (Объект = Неопределено) Тогда
				Продолжить;
			ИначеЕсли Объект.ПометкаУдаления Тогда
				Продолжить;
			ИначеЕсли (Не Объект.Организация.Пустая()) Тогда
				Продолжить;
			КонецЕсли;
			Объект.ИДИсточника = Отбор.ИУИ;
			Объект.ПометкаУдаления = Истина;
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОперации(Команда)
	Перем Стр;
	
	УдалитьОперацииНаСервере();
