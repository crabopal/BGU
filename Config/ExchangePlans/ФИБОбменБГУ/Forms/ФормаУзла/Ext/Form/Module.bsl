
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем Флаг;
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	ОбменДаннымиСервер.ФормаУзлаПриСозданииНаСервере(ЭтотОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
	Элементы.СтраницыВариантовНастройки.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	// Доступность элементов основного узла.
	Флаг = (Не Объект.ЭтотУзел);
	Элементы.ПравилаОтправкиДанных.Видимость = Флаг;
	Элементы.ПравилаПолученияДанных.Видимость = Флаг;
	Элементы.ПроверятьПолученныеДокументы.Видимость = Флаг;
	Элементы.ОписаниеПроверятьПолученныеПроводки.Видимость = Флаг;
	Если Флаг Тогда
		КлючНазначенияИспользования = "Обмен";
		КлючСохраненияПоложенияОкна = "Обмен";
	КонецЕсли;	
	
	// Доступность служебных данных.
	Флаг = ОбщегоНазначения.РазделениеВключено();
	Флаг = Флаг И ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных();
	Если Флаг Тогда
		Элементы.Наименование.Видимость = Ложь;
		Элементы.Служебные.Видимость = Ложь;
	КонецЕсли;
	
	// Изменение даты запрета редактирования.
	Флаг = (Не Объект.ЭтотУзел);
	Флаг = Флаг И ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ДатыЗапретаИзменения);
	Флаг = Флаг И ПолучитьФункциональнуюОпцию("ИспользоватьДатыЗапретаИзменения");
	Элементы.ГруппаПрочее.Видимость = Флаг;

	// НПА.
	Если Объект.РежимВыгрузкиСправочников.Пустая() Тогда
		Объект.РежимВыгрузкиСправочников = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
	КонецЕсли;	                        
	// БК.
	Если Объект.РежимВыгрузкиБК.Пустая() Тогда
		Объект.РежимВыгрузкиБК = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
	КонецЕсли;
	Элементы.ПериодРегистрацииВМесяцахЕПСБУ.ТолькоПросмотр = (Объект.МинимальныйПериодРегистрацииВМесяцахЕПСБУ = Объект.МаксимальныйПериодРегистрацииВМесяцахЕПСБУ);
	ФИББГУМенеджерОбменаПереопределяемый.ФормаУзлаОбмена_ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	Перем Флаг;
	
	Элементы.ВерсияКорреспондента.Видимость = (Не ПустаяСтрока(Объект.ВерсияКорреспондента));
	Если Объект.ЭтоБМО Тогда
		Флаг = (Объект.РежимВыгрузкиЕПСБУ = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию);
		Элементы.ПериодРегистрацииВМесяцахЕПСБУ.Видимость = Флаг;
		Элементы.СтраницыВариантовНастройки.ТекущаяСтраница = Элементы.СтраницаВариантНастрокиСБМО;
		Элементы.Служебные.Видимость = Ложь;
		Элементы.СтраницаВариантНастрокиСБГУ.Видимость = Ложь;
		Элементы.РучнаяНастройка.Видимость = Ложь;
		Объект.РучнаяНастройка = Ложь;
		Объект.РежимВыгрузкиБК = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
		Объект.РежимВыгрузкиСправочников = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
	Иначе
		Элементы.ПериодРегистрацииВМесяцахЕПСБУ.Видимость = Истина;
		// Вариант настройки.
		Если Объект.РучнаяНастройка Тогда
			Объект.МинимальныйПериодРегистрацииВМесяцахЕПСБУ = 1;
			Объект.МаксимальныйПериодРегистрацииВМесяцахЕПСБУ = 96;
			Элементы.СтраницыВариантовНастройки.ТекущаяСтраница = Элементы.СтраницаВариантНастрокиСБГУ;
			Элементы.СтраницаВариантНастрокиСБГУ.Видимость = Истина;
		Иначе
			Элементы.СтраницыВариантовНастройки.ТекущаяСтраница = Элементы.СтраницаВариантНастрокиСБМО;
			Элементы.СтраницаВариантНастрокиСБГУ.Видимость = Ложь;
		КонецЕсли;
		// Бухгалтерия.
		Флаг = (Объект.РежимВыгрузкиЕПСБУ <> Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию);
		Если Флаг Тогда
			Объект.РежимВыгрузкиЕПСБУ = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
		КонецЕсли;
		// БК.
		Флаг = (Объект.РежимВыгрузкиБК <> Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПриНеобходимости);
		Флаг = Флаг И (Объект.РежимВыгрузкиБК <> Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию);
		Если Флаг Тогда
			Объект.РежимВыгрузкиБК = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
		КонецЕсли;
		// НПА.
		Флаг = (Объект.РежимВыгрузкиСправочников <> Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПриНеобходимости);
		Флаг = Флаг И (Объект.РежимВыгрузкиСправочников <> Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию);
		Если Флаг Тогда
			Объект.РежимВыгрузкиСправочников = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
		КонецЕсли;	
	КонецЕсли;	
	Элементы.ПериодРегистрацииВМесяцахЕПСБУ.ТолькоПросмотр = (Объект.МинимальныйПериодРегистрацииВМесяцахЕПСБУ = Объект.МаксимальныйПериодРегистрацииВМесяцахЕПСБУ);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Перем Колво, Сч, Индекс, Запись;
	
	// Удаление пустых организаций.
	Колво = Объект.Организации.Количество();
	Для Сч=1 По Колво Цикл
		Индекс = Колво - Сч;
		Запись = Объект.Организации[Индекс];
		Если Запись.Организация.Пустая() Тогда
			Объект.Организации.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	// Удаление пустых счетов.
	Колво = Объект.Счета.Количество();
	Для Сч=1 По Колво Цикл
		Индекс = Колво - Сч;
		Запись = Объект.Счета[Индекс];
		Если Запись.Счет.Пустая() Тогда
			Объект.Счета.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

