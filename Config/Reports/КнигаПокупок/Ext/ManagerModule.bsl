Функция ПолучитьСтрокуИтогоИзКнигиПокупокЗаНалоговыйПериод(НастройкиСКД_СтрокаИтого, ДатаНачалаПериода, ДатаОкончанияПериода)
	
	РезультатТаблица = Новый ТаблицаЗначений();
	
	ИспользуемаяСхемаКомпоновкиДанных	= НастройкиСКД_СтрокаИтого["ИспользуемаяСхемаКомпоновкиДанных"];
	НовыйКомпоновщикНастроек			= НастройкиСКД_СтрокаИтого["НовыйКомпоновщикНастроек"];
	
	// Устанавливаем параметры:
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаНачалаНалоговогоПериода", ДатаНачалаПериода);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаОкончанияНалоговогоПериода", ДатаОкончанияПериода);
	
	// Выводим результат в таблицу значений:
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		ИспользуемаяСхемаКомпоновкиДанных,				// 1
		НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
		,												// 3
		,												// 4
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));	// 5
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
	ПроцессорВывода.УстановитьОбъект(РезультатТаблица);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Возврат РезультатТаблица[0];
	
КонецФункции


Функция ВывестиОсновнойРаздел(ПараметрыОтчета, ГруппировкаНалоговыйПериод)
	
	ДетальныеЗаписи = ГруппировкаНалоговыйПериод.Строки;
	
	// Возвращаемое значение:
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ИмяПараметровПечати = "ОсновнойРазделКнигиПокупок";
	ТабДокумент.АвтоМасштаб = Истина;
	
	// Используемый макет:
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_КнигаПокупок1137");
	
	//---
	// Заголовок
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",			ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("ДатаНачалаПериода",		ГруппировкаНалоговыйПериод["ДатаНачалаПериода"]);
	ПараметрыОбласти.Вставить("ДатаОкончанияПериода",	ГруппировкаНалоговыйПериод["ДатаОкончанияПериода"]);
	ПараметрыОбласти.Вставить("ВыводитьОтбор",			ПараметрыОтчета["ВыводитьОтбор"]);
	ПараметрыОбласти.Вставить("Отбор",					Строка(ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор));
	ВывестиЗаголовок_ОсновнойРаздел(ТабДокумент, ПараметрыОбласти, Макет);	
	
	//---
	// Строки таблицы
	//---
	ВывестиТаблицу(ПараметрыОтчета, ТабДокумент, Макет, ДетальныеЗаписи);
	
	//---
	// Всего
	//---
	ОбластьВсего = Макет.ПолучитьОбласть("Всего");
	ОбластьВсего.Параметры.Заполнить(ГруппировкаНалоговыйПериод);
	ТабДокумент.Вывести(ОбластьВсего);
		
	//---
	// Подвал
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",	ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("Дата",			ГруппировкаНалоговыйПериод["ДатаОкончанияПериода"]);
	ВывестиПодвал(ТабДокумент, ПараметрыОбласти, Макет);
	
	// Колонтитулы:
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(ТабДокумент,
		ПараметрыОтчета["Колонтитулы_НаименованиеОтчета"],
		ПараметрыОтчета["Колонтитулы_ТекущийПользователь"],
		ПараметрыОтчета["Организация"]);
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ВывестиДопЛист(ПараметрыОтчета, ПараметрыДопЛиста, ДетальныеЗаписи, СтрокаИтого)
	
	// Возвращаемое значение:
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ИмяПараметровПечати = "ДополнительныйЛистКнигиПокупок";
	ТабДокумент.АвтоМасштаб = Истина;
	
	// Используемый макет:
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_КнигаПокупок1137");
	
	// Используемые области:
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("ЗаголовокДопЛист");
	ОбластьИтого		= Макет.ПолучитьОбласть("ИтогоДопЛист");
	ОбластьВсего		= Макет.ПолучитьОбласть("Всего");
	
	//---
	// Заголовок
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("НомерЛиста",				ПараметрыДопЛиста["НомерЛиста"]);
	ПараметрыОбласти.Вставить("Организация",			ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("ДатаНачалаПериода",		ПараметрыДопЛиста["ДатаНачалаПериода"]);
	ПараметрыОбласти.Вставить("ДатаОкончанияПериода",	ПараметрыДопЛиста["ДатаОкончанияПериода"]);
	ПараметрыОбласти.Вставить("ДатаСоставления",		ПараметрыДопЛиста["ДатаСоставления"]);
	ПараметрыОбласти.Вставить("ВыводитьОтбор",			ПараметрыОтчета["ВыводитьОтбор"]);
	ПараметрыОбласти.Вставить("Отбор",					ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	ВывестиЗаголовок_ДопЛист(ТабДокумент, ПараметрыОбласти, Макет);	
	
	//---
	// Строка Итого
	//---
	ОбластьИтого.Параметры.Заполнить(СтрокаИтого);
	ТабДокумент.Вывести(ОбластьИтого);
	
	//---
	// Строки таблицы
	//---
	ВывестиТаблицу(ПараметрыОтчета, ТабДокумент, Макет, ДетальныеЗаписи);
	
	//---
	// Всего
	//---
	Для Каждого Элем Из ПараметрыДопЛиста Цикл
		Попытка
			СтрокаИтого[Элем.Ключ] = СтрокаИтого[Элем.Ключ] + Элем.Значение;
		Исключение
		КонецПопытки;
	КонецЦикла;
	ОбластьВсего.Параметры.Заполнить(СтрокаИтого);
	ТабДокумент.Вывести(ОбластьВсего);
	
	//---
	// Подвал
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",	ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("Дата",			ПараметрыДопЛиста["ДатаОкончанияПериода"]);
	ВывестиПодвал(ТабДокумент, ПараметрыОбласти, Макет);
	
	// Колонтитулы:
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(ТабДокумент,
		ПараметрыОтчета["Колонтитулы_НаименованиеОтчета"],
		ПараметрыОтчета["Колонтитулы_ТекущийПользователь"],
		ПараметрыОтчета["Организация"]);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиЗаголовок_ОсновнойРаздел(ЗаполняемыйТабличныйДокумент, ПараметрыОбласти, ИспользуемыйМакет)
	
	ОбластьЗаголовок = ИспользуемыйМакет.ПолучитьОбласть("Заголовок");
	
	ЗначенияПараметров = Новый Структура();
	Если ЗначениеЗаполнено(ПараметрыОбласти["Организация"]) тогда
		РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОбласти["Организация"],
			"НаименованиеПолное, НаименованиеСокращенное, Наименование, ИНН, КПП");
		НаименованиеПолное		= РеквизитыОрганизации["НаименованиеПолное"];
		НаименованиеСокращенное	= РеквизитыОрганизации["НаименованиеСокращенное"];
		Наименование			= РеквизитыОрганизации["Наименование"];
		Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
			Параметр_Покупатель = НаименованиеПолное;
		ИначеЕсли ЗначениеЗаполнено(НаименованиеСокращенное) Тогда
			Параметр_Покупатель = НаименованиеСокращенное;
		Иначе
			Параметр_Покупатель = Наименование;
		КонецЕсли;
		ЗначенияПараметров.Вставить("Покупатель",		Параметр_Покупатель);
		ЗначенияПараметров.Вставить("ИННПокупателя",	РеквизитыОрганизации["ИНН"]);
		ЗначенияПараметров.Вставить("КПППокупателя",	РеквизитыОрганизации["КПП"]);
	КонецЕсли;
	ЗначенияПараметров.Вставить("НачалоПериода",	Формат(ПараметрыОбласти["ДатаНачалаПериода"], "ДФ=dd.MM.yyyy"));
	ЗначенияПараметров.Вставить("КонецПериода",		Формат(ПараметрыОбласти["ДатаОкончанияПериода"], "ДФ=dd.MM.yyyy"));
	// Отбор:
	Если ПараметрыОбласти["ВыводитьОтбор"] Тогда
		Отбор = ПараметрыОбласти["Отбор"];
		Если ПустаяСтрока(Отбор) Тогда
			Отбор = НСтр("ru='(отбор не установлен)'");
		КонецЕсли;
		ЗначенияПараметров.Вставить("Отбор", Отбор); 
	КонецЕсли;
	// Выводим область:
	ОбластьЗаголовок.Параметры.Заполнить(ЗначенияПараметров);
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
КонецПроцедуры

Процедура ВывестиЗаголовок_ДопЛист(ЗаполняемыйТабличныйДокумент, ПараметрыОбласти, ИспользуемыйМакет)
	
	ОбластьЗаголовок = ИспользуемыйМакет.ПолучитьОбласть("ЗаголовокДопЛист");
	
	ЗначенияПараметров = Новый Структура();
	
	ЗначенияПараметров.Вставить("НомерЛиста",		ПараметрыОбласти["НомерЛиста"]);
	
	Если ЗначениеЗаполнено(ПараметрыОбласти["Организация"]) тогда
		РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОбласти["Организация"],
			"НаименованиеПолное, НаименованиеСокращенное, Наименование, ИНН, КПП");
		НаименованиеПолное		= РеквизитыОрганизации["НаименованиеПолное"];
		НаименованиеСокращенное	= РеквизитыОрганизации["НаименованиеСокращенное"];
		Наименование			= РеквизитыОрганизации["Наименование"];
		Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
			Параметр_Покупатель = НаименованиеПолное;
		ИначеЕсли ЗначениеЗаполнено(НаименованиеСокращенное) Тогда
			Параметр_Покупатель = НаименованиеСокращенное;
		Иначе
			Параметр_Покупатель = Наименование;
		КонецЕсли;
		ЗначенияПараметров.Вставить("Покупатель",		Параметр_Покупатель);
		ЗначенияПараметров.Вставить("ИННПокупателя",	РеквизитыОрганизации["ИНН"]);
		ЗначенияПараметров.Вставить("КПППокупателя",	РеквизитыОрганизации["КПП"]);
	КонецЕсли;
	ЗначенияПараметров.Вставить("НалоговыйПериод",	ПредставлениеПериода(ПараметрыОбласти["ДатаНачалаПериода"], ПараметрыОбласти["ДатаОкончанияПериода"], "ФП"));
	ЗначенияПараметров.Вставить("ДатаСоставления",	Формат(ПараметрыОбласти["ДатаСоставления"], "ДЛФ=Д"));
	// Отбор:
	Если ПараметрыОбласти["ВыводитьОтбор"] Тогда
		Отбор = ПараметрыОбласти["Отбор"];
		Если ПустаяСтрока(Отбор) Тогда
			Отбор = НСтр("ru='(отбор не установлен)'");
		КонецЕсли;
		ЗначенияПараметров.Вставить("Отбор", Отбор); 
	КонецЕсли;
	// Выводим область:
	ОбластьЗаголовок.Параметры.Заполнить(ЗначенияПараметров);
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
КонецПроцедуры

Процедура ВывестиТаблицу(ПараметрыОтчета, ЗаполняемыйТабличныйДокумент, ИспользуемыйМакет, ДетальныеЗаписи, НППСтроки = 0)
	
	СимволПрочерка = "---";
	ВыводитьПолныеНаименования = Истина;
	
	ПричиныНалогообложенияАванс = Новый Массив();
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученный);
	ПокупкаУНерезидентаНалоговыйАгент = Перечисления.ПричиныНалогообложенияНДС.ПокупкаУНерезидентаНалоговыйАгент;
	
	Если НППСтроки = 0 Тогда
		НППСтроки = 1;
	КонецЕсли;
	
	Для Каждого ДетальнаяЗапись Из ДетальныеЗаписи Цикл
		Если ДетальнаяЗапись["ЭтоГруппировкаКонтрагент"] Тогда
			//---
			// Итого по контрагенту
			//---
			ОбластьКонтрагент = ИспользуемыйМакет.ПолучитьОбласть("Контрагент");
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить("КонтрагентПредставление", ?(ВыводитьПолныеНаименования,
				ДетальнаяЗапись["КонтрагентПредставлениеПолное"],
				ДетальнаяЗапись["КонтрагентПредставлениеСокращенное"]));
			ОбластьКонтрагент.Параметры.Заполнить(ДетальнаяЗапись);
			ОбластьКонтрагент.Параметры.Заполнить(ЗначенияПараметров);
			ЗаполняемыйТабличныйДокумент.Вывести(ОбластьКонтрагент);
			
			//---
			// Детальные строки
			//---
			ВывестиТаблицу(ПараметрыОтчета, ЗаполняемыйТабличныйДокумент, ИспользуемыйМакет, ДетальнаяЗапись.Строки, НППСтроки);
			
		Иначе
			//---
			// Детальная строка
			//---
			ОбластьСтрока = ИспользуемыйМакет.ПолучитьОбласть("Строка");
			
			// Подготовка:
			ЭтоНалоговыйАгентП2 = (ДетальнаяЗапись["ПричинаНалогообложения"] = ПокупкаУНерезидентаНалоговыйАгент);
			ЭтоАванс = НЕ (ПричиныНалогообложенияАванс.Найти(ДетальнаяЗапись["ПричинаНалогообложения"]) = Неопределено);
			СтороныОперации = УчетНДС.ОпределитьПродавцаПокупателяИНомерДокумента(ДетальнаяЗапись);
			Параметр_НомерДокумента	= СтороныОперации["НомерДокумента"];
			Продавец				= СтороныОперации["Продавец"];
			Если Продавец = "Организация" Тогда
				Параметр_ПродавецПредставление	= ?(ВыводитьПолныеНаименования,
					ДетальнаяЗапись["ОрганизацияПредставлениеПолное"],
					ДетальнаяЗапись["ОрганизацияПредставлениеСокращенное"]);
				Параметр_ПродавецИНН			= ДетальнаяЗапись["ОрганизацияИНН"];
				Параметр_ПродавецКПП			= ДетальнаяЗапись["ОрганизацияКПП"];
				Параметр_ПродавецСсылка			= ДетальнаяЗапись["Организация"];
			ИначеЕсли Продавец = "ГоловнаяОрганизация" Тогда
				Параметр_ПродавецПредставление	= ?(ВыводитьПолныеНаименования,
					ДетальнаяЗапись["ГоловнаяОрганизацияПредставлениеПолное"],
					ДетальнаяЗапись["ГоловнаяОрганизацияПредставлениеСокращенное"]);
				Параметр_ПродавецИНН			= ДетальнаяЗапись["ГоловнаяОрганизацияИНН"];
				Параметр_ПродавецКПП			= ДетальнаяЗапись["ГоловнаяОрганизацияКПП"];
				Параметр_ПродавецСсылка			= ДетальнаяЗапись["ГоловнаяОрганизация"];
			Иначе
				// Здесь Продавец = "Контрагент"
				Параметр_ПродавецПредставление	= ?(ВыводитьПолныеНаименования,
					ДетальнаяЗапись["КонтрагентПредставлениеПолное"],
					ДетальнаяЗапись["КонтрагентПредставлениеСокращенное"]);
				Параметр_ПродавецИНН			= ДетальнаяЗапись["КонтрагентИНН"];
				Параметр_ПродавецКПП			= ДетальнаяЗапись["КонтрагентКПП"];
				Параметр_ПродавецСсылка			= ДетальнаяЗапись["Контрагент"];
				Если ЭтоНалоговыйАгентП2 Тогда
					Параметр_ПродавецИНН = СимволПрочерка;
					Параметр_ПродавецКПП = СимволПрочерка;
				КонецЕсли;
			КонецЕсли;
			
			// Заполняем область:
			ЗначенияПараметров = Новый Структура();
			
			// 1
			ЗначенияПараметров.Вставить("НПП",					НППСтроки);
			НППСтроки = НППСтроки + 1;
			
			// 2
			Параметр_ДатаНомер = Формат(ДетальнаяЗапись["Дата"], "ДЛФ=Д") + ", № " + Параметр_НомерДокумента;
			ПредставлениеПричиныНалогообложения = ПараметрыОтчета["ПредставленияПричинНалогообложения"].Получить(ДетальнаяЗапись["ПричинаНалогообложения"]);
			Если ЗначениеЗаполнено(ПредставлениеПричиныНалогообложения) Тогда
				Параметр_ДатаНомер = Параметр_ДатаНомер + " " + ПредставлениеПричиныНалогообложения;
			КонецЕсли;
			ЗначенияПараметров.Вставить("ДатаНомер",			Параметр_ДатаНомер);
			
			// 2а
			ЗначенияПараметров.Вставить("НомерДатаИсправления",
				?(ЗначениеЗаполнено(ДетальнаяЗапись["НомерИсправления"]),
					ДетальнаяЗапись["НомерИсправления"] + " от " + Формат(ДетальнаяЗапись["ДатаИсправления"], "ДЛФ=Д"),
					""));
			
			// 2б
			ЗначенияПараметров.Вставить("НомерДатаКСФ",
				?(ЗначениеЗаполнено(ДетальнаяЗапись["НомерКСФ"]),
					ДетальнаяЗапись["НомерКСФ"] + " от " + Формат(ДетальнаяЗапись["ДатаКСФ"], "ДЛФ=Д"),
					""));
			
			// 2в
			ЗначенияПараметров.Вставить("НомерДатаИсправленияКСФ",
				?(ЗначениеЗаполнено(ДетальнаяЗапись["НомерИсправленияКСФ"]),
					ДетальнаяЗапись["НомерИсправленияКСФ"] + " от " + Формат(ДетальнаяЗапись["ДатаИсправленияКСФ"], "ДЛФ=Д"),
					""));
			
			// 3
			ЗначенияПараметров.Вставить("ДатаОплаты",			ДетальнаяЗапись["ДатаОплаты"]);
			
			// 4
			Если ЭтоАванс Тогда
				Параметр_ДатаОприходования = '00010101';
			Иначе
				Параметр_ДатаОприходования = ДетальнаяЗапись["ДатаСобытия"];
				Если НЕ ЗначениеЗаполнено(Параметр_ДатаОприходования) Тогда
					Параметр_ДатаОприходования = '00010101';
				КонецЕсли;
			КонецЕсли;
			ЗначенияПараметров.Вставить("ДатаОприходования",	Параметр_ДатаОприходования);
			
			// 5
			ЗначенияПараметров.Вставить("ПродавецПредставление",Параметр_ПродавецПредставление);
			ЗначенияПараметров.Вставить("ПродавецСсылка",		Параметр_ПродавецСсылка);
			// 5а
			ЗначенияПараметров.Вставить("ПродавецИНН",			Параметр_ПродавецИНН);
			// 5б
			ЗначенияПараметров.Вставить("ПродавецКПП",			Параметр_ПродавецКПП);
			
			// Выводим область:
			ОбластьСтрока.Параметры.Заполнить(ДетальнаяЗапись);
			ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
			ЗаполняемыйТабличныйДокумент.Вывести(ОбластьСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиПодвал(ЗаполняемыйТабличныйДокумент, ПараметрыОбласти, ИспользуемыйМакет)
	
	ОбластьПодвал = ИспользуемыйМакет.ПолучитьОбласть("Подвал");
	
	ЗначенияПараметров = Новый Структура();
	Если ЗначениеЗаполнено(ПараметрыОбласти["Организация"]) Тогда
		ОтветственныеЛица = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
			ПараметрыОбласти["Организация"],
			ПараметрыОбласти["Дата"]);
		
		ЗначенияПараметров.Вставить("РуководительФИО", Справочники.Сотрудники.ФамилияИО(
			ОтветственныеЛица["ОтветственноеЛицоСсылка"],, ПараметрыОбласти["Дата"]));
    КонецЕсли;
	// Выводим область:
	ОбластьПодвал.Параметры.Заполнить(ЗначенияПараметров);
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры


Функция ВывестиВсеОсновныеРазделыОднимСписком(ПараметрыОтчета, ГруппировкаОднимСписком)
	
	ДетальныеЗаписи = ГруппировкаОднимСписком.Строки;
	
	// Возвращаемое значение:
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ИмяПараметровПечати = "ОсновнойРазделКнигиПокупок";
	ТабДокумент.АвтоМасштаб = Истина;
	
	// Используемый макет:
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_КнигаПокупок1137");
	
	//---
	// Заголовок
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",			ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("ДатаНачалаПериода",		ПараметрыОтчета["НачалоПериода"]);
	ПараметрыОбласти.Вставить("ДатаОкончанияПериода",	ПараметрыОтчета["КонецПериода"]);
	ПараметрыОбласти.Вставить("ВыводитьОтбор",			ПараметрыОтчета["ВыводитьОтбор"]);
	ПараметрыОбласти.Вставить("Отбор",					Строка(ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор));
	ВывестиЗаголовок_ОсновнойРаздел(ТабДокумент, ПараметрыОбласти, Макет);
	
	//---
	// Строки таблицы
	//---
	ВывестиТаблицу(ПараметрыОтчета, ТабДокумент, Макет, ДетальныеЗаписи);
	
	//---
	// Всего
	//---
	ОбластьВсего = Макет.ПолучитьОбласть("Всего");
	ОбластьВсего.Параметры.Заполнить(ГруппировкаОднимСписком);
	ТабДокумент.Вывести(ОбластьВсего);
	
	//---
	// Подвал
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",	ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("Дата",			ПараметрыОтчета["КонецПериода"]);
	ВывестиПодвал(ТабДокумент, ПараметрыОбласти, Макет);
	
	// Колонтитулы:
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(ТабДокумент,
		ПараметрыОтчета["Колонтитулы_НаименованиеОтчета"],
		ПараметрыОтчета["Колонтитулы_ТекущийПользователь"],
		ПараметрыОтчета["Организация"]);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура СообщитьОбОшибке(ИнформацияОбОшибке)
	
	Пока НЕ ИнформацияОбОшибке.Причина = Неопределено Цикл
		ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
	КонецЦикла;
	ТекстСообщения = НСтр("ru='Отчет не сформирован!'") + Символы.ПС + ИнформацияОбОшибке.Описание;
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

