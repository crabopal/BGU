		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаНачалаКорректируемогоПериода",	ПараметрыОтчета["НачалоПериода"]);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаКонцаКорректируемогоПериода",	ПараметрыОтчета["КонецПериода"]);
	Иначе
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаНачала",	ПараметрыОтчета["НачалоПериода"]);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаКонца",		ПараметрыОтчета["КонецПериода"]);
	КонецЕсли;
	ПричиныНалогообложенияАванс = Новый СписокЗначений();
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученный);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ПричиныНалогообложенияАванс", ПричиныНалогообложенияАванс);
	
	// Копируем отбор, установленный в форме отчета:
	СтандартныеОтчетыКлиентСервер.СкопироватьОтбор(
		НовыйКомпоновщикНастроек.Настройки.Отбор,
		ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	
	// Настройки группировок:
	Настройки = НовыйКомпоновщикНастроек.Настройки;
	НастройкиСГруппировкойПоКонтрагенту		= Настройки.Структура[1];
	НастройкиБезГруппировкиПоКонтрагенту	= Настройки.Структура[0];
	Если ПараметрыОтчета["ГруппироватьПоКонтрагентам"] Тогда
		// Используем только группировку по контрагенту:
		НастройкиСГруппировкойПоКонтрагенту.Использование	= Истина;
		НастройкиБезГруппировкиПоКонтрагенту.Использование	= Ложь;
	Иначе
		// Используем только детальные записи:
		НастройкиСГруппировкойПоКонтрагенту.Использование	= Ложь;
		НастройкиБезГруппировкиПоКонтрагенту.Использование	= Истина;
	КонецЕсли;
	
	Результат["ИспользуемаяСхемаКомпоновкиДанных"]	= ИспользуемаяСхемаКомпоновкиДанных;
	Результат["НовыйКомпоновщикНастроек"]			= НовыйКомпоновщикНастроек;
	
	Возврат Результат;
	
КонецФункции

