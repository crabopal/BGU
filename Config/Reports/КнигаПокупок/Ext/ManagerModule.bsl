#Область СлужебныйПрограммныйИнтерфейс

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "Основной");
	НастройкиВарианта.Описание = НСтр("ru = '(устарел) В редакции постановления Правительства РФ от 24.10.2013 г. № 952'");
	НастройкиВарианта.ВидимостьПоУмолчанию = Ложь;
	
КонецПроцедуры

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура СформироватьОтчет(Знач ПараметрыОтчета, ВозвратАдресХранилищаРезультата) Экспорт
	
	// Установленные параметры отчета:
	Если ЗначениеЗаполнено(ПараметрыОтчета["НачалоПериода"]) Тогда
		ПараметрыОтчета["НачалоПериода"] = НачалоДня(ПараметрыОтчета["НачалоПериода"]);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета["КонецПериода"]) Тогда
		ПараметрыОтчета["КонецПериода"] = КонецДня(ПараметрыОтчета["КонецПериода"]);
	КонецЕсли;
	СформироватьОсновнойРаздел		= НЕ ПараметрыОтчета["ВыводитьТолькоДопЛисты"];
	СформироватьДопЛисты			= ПараметрыОтчета["ФормироватьДопЛисты"];
	УникальныйИдентификаторФормы	= ПараметрыОтчета["УникальныйИдентификаторФормы"];
	
	// Заменяем параметр на новый, обработанный и готовый к использованию:
	ПараметрыОтчета.Вставить("ПредставленияПричинНалогообложения",
		УчетНДС.ПолучитьПредставленияПричинНалогообложения(
			ПараметрыОтчета["ПредставленияПричинНалогообложения"],
			ПараметрыОтчета["ВыводитьПредставленияПричинНалогообложения"]));
	
	// Результаты отчета:
	СписокСформированныхЛистов = Новый СписокЗначений();
	ДеревоСформированныхЛистов = Новый ДеревоЗначений();
	КЧ = Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Любой);
	ДеревоСформированныхЛистов.Колонки.Добавить("Картинка",								Новый ОписаниеТипов("Картинка"));
	ДеревоСформированныхЛистов.Колонки.Добавить("Наименование",							Новый ОписаниеТипов("Строка"));
	ДеревоСформированныхЛистов.Колонки.Добавить("ПредставлениеНалоговогоПериода",		Новый ОписаниеТипов("Строка"));
	ДеревоСформированныхЛистов.Колонки.Добавить("ИндексСоответствующейСтрокиСписка",	Новый ОписаниеТипов("Число", КЧ));
	ДеревоСформированныхЛистов.Колонки.Добавить("ДатаНачалаПериода",					Новый ОписаниеТипов("Дата"));
	ДеревоСформированныхЛистов.Колонки.Добавить("АдресХранилищаСДаннымиЛиста",			Новый ОписаниеТипов("Строка"));
	ДеревоСформированныхЛистов.Колонки.Добавить("ЭтоДанныеОднимСписком",				Новый ОписаниеТипов("Булево"));
	ДеревоСформированныхЛистов.Колонки.Добавить("ЭтоПустойЛист",						Новый ОписаниеТипов("Булево"));
	
	Если СформироватьОсновнойРаздел Тогда
		СформироватьОсновнойРаздел(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов);
	КонецЕсли;
	
	Если СформироватьДопЛисты Тогда 
		СформироватьДополнительныеЛисты(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов);
	КонецЕсли;
	
	ДозаполнитьДеревоСформированныхЛистов(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, УникальныйИдентификаторФормы);
	
	РезультатыОтчета = Новый Структура();
	РезультатыОтчета.Вставить("ДеревоСформированныхЛистов",	ДеревоСформированныхЛистов);
	ВозвратАдресХранилищаРезультата = ПоместитьВоВременноеХранилище(РезультатыОтчета, УникальныйИдентификаторФормы);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Процедура СформироватьОсновнойРаздел(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов)
	
	РезультатДерево						= Новый ДеревоЗначений();
	ИспользуемаяКартинкаВДеревеЛистов	= БиблиотекаКартинок.ЖурналДокументов;
	
	УникальныйИдентификаторФормы		= ПараметрыОтчета["УникальныйИдентификаторФормы"];
	
    // Настраиваем схему КД:
	НастройкиСКД = ПолучитьНастройкиСКД_ОсновнойРаздел(ПараметрыОтчета);
	ИспользуемаяСхемаКомпоновкиДанных	= НастройкиСКД["ИспользуемаяСхемаКомпоновкиДанных"];
	НовыйКомпоновщикНастроек			= НастройкиСКД["НовыйКомпоновщикНастроек"];
	
	// Выполняем схему:
	Попытка
		// Выводим результат в дерево:
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(
			ИспользуемаяСхемаКомпоновкиДанных,				// 1
			НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
			,												// 3
			,												// 4
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));// 5
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		ПроцессорВывода.УстановитьОбъект(РезультатДерево);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
		
		УчетНДС.СвернутьОдноименныеКолонкиДерева(РезультатДерево);
		
		Для Каждого СтрокаГруппировки Из РезультатДерево.Строки Цикл
			Если СтрокаГруппировки["ЭтоГруппировкаНалоговыйПериод"] = Истина Тогда
				// Выводим в табличный документ:
				ТабДокумент = ВывестиОсновнойРаздел(ПараметрыОтчета, СтрокаГруппировки);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ТабДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				// Строка налогового периода:
				Наименование = ПредставлениеПериода(
					СтрокаГруппировки["ДатаНачалаПериода"],
					СтрокаГруппировки["ДатаОкончанияПериода"],
					"ФП");
				Поиск = Новый Структура("Наименование", Наименование);
				МассивСтрок = ДеревоСформированныхЛистов.Строки.НайтиСтроки(Поиск, Ложь); // ВключатьПодчиненные
				Если МассивСтрок.Количество() > 0 Тогда
					СтрокаНалоговогоПериода = МассивСтрок[0];
				Иначе
					СтрокаНалоговогоПериода = ДеревоСформированныхЛистов.Строки.Добавить();
					СтрокаНалоговогоПериода["Наименование"] = Наименование;
					СтрокаНалоговогоПериода["ПредставлениеНалоговогоПериода"] = Наименование;
				КонецЕсли;
				СтрокаНалоговогоПериода["ИндексСоответствующейСтрокиСписка"] = -1;
				СтрокаНалоговогоПериода["ДатаНачалаПериода"] = СтрокаГруппировки["ДатаНачалаПериода"];
				
				// Строка основного раздела:
				СтрокаОсновногоРаздела = СтрокаНалоговогоПериода.Строки.Добавить();
				СтрокаОсновногоРаздела["Наименование"] = НСтр("ru='Основной раздел'");
				СтрокаОсновногоРаздела["Картинка"] = ИспользуемаяКартинкаВДеревеЛистов;
				СтрокаОсновногоРаздела["ИндексСоответствующейСтрокиСписка"] = ИндексСоответствующейСтрокиСписка;
				СтрокаОсновногоРаздела["ПредставлениеНалоговогоПериода"] = Наименование + " (" + НРег(СтрокаОсновногоРаздела["Наименование"]) + ")";
				
			ИначеЕсли СтрокаГруппировки["ЭтоГруппировкаОднимСписком"] = Истина Тогда
				// Выводим в табличный документ:
				ТабДокумент = ВывестиВсеОсновныеРазделыОднимСписком(ПараметрыОтчета, СтрокаГруппировки);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ТабДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				// Строка самого верхнего уровня:
				СтрокаОднимСписком = ДеревоСформированныхЛистов.Строки.Добавить();
				СтрокаОднимСписком["Наименование"] = НСтр("ru='Книга одним списком'");
				СтрокаОднимСписком["Картинка"] = ИспользуемаяКартинкаВДеревеЛистов;
				СтрокаОднимСписком["ИндексСоответствующейСтрокиСписка"] = ИндексСоответствующейСтрокиСписка;
				СтрокаОднимСписком["ДатаНачалаПериода"] = '00010101';
				СтрокаОднимСписком["ЭтоДанныеОднимСписком"] = Истина;
				Если СтрокаГруппировки.Строки.Количество() = 0 Тогда
					СтрокаОднимСписком["ЭтоПустойЛист"] = Истина;
				КонецЕсли;
				СтрокаОднимСписком["ПредставлениеНалоговогоПериода"] = НСтр("ru='все основные разделы'");
				
			КонецЕсли;
		КонецЦикла;
		
	Исключение
		СообщитьОбОшибке(ИнформацияОбОшибке());
		
	КонецПопытки;
		
КонецПроцедуры

Процедура СформироватьДополнительныеЛисты(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов)
	
	РезультатДерево						= Новый ДеревоЗначений();
	ИспользуемаяКартинкаВДеревеЛистов	= БиблиотекаКартинок.Документ;
	
	УникальныйИдентификаторФормы		= ПараметрыОтчета["УникальныйИдентификаторФормы"];
	
    // Настраиваем схему дополнительных листов:
	НастройкиСКД						= ПолучитьНастройкиСКД_ДополнительныеЛисты(ПараметрыОтчета);
	ИспользуемаяСхемаКомпоновкиДанных	= НастройкиСКД["ИспользуемаяСхемаКомпоновкиДанных"];
	НовыйКомпоновщикНастроек			= НастройкиСКД["НовыйКомпоновщикНастроек"];
	
    // Настраиваем схему строк Итого:
	НастройкиСКД_СтрокаИтого	= ПолучитьНастройкиСКД_ИтогиКнигиПокупокЗаОтчетныйПериод(ПараметрыОтчета);
	
	Попытка
		// Выводим результат в дерево:
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(
			ИспользуемаяСхемаКомпоновкиДанных,							// 1
			НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
			,												// 3
			,												// 4
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));// 5
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		ПроцессорВывода.УстановитьОбъект(РезультатДерево);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
		
		// По группировкам "Налоговый период":
		Для Каждого СтрокаГруппировки Из РезультатДерево.Строки Цикл
			Если НЕ СтрокаГруппировки["ЭтоГруппировкаНалоговыйПериод"] = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			// Получим данные для строки Итого - итоги книги покупок за соответствующий налоговый период:
			СтрокаИтого = ПолучитьСтрокуИтогоИзКнигиПокупокЗаНалоговыйПериод(
				НастройкиСКД_СтрокаИтого,
				СтрокаГруппировки["ДатаНачалаПериода"],
				СтрокаГруппировки["ДатаОкончанияПериода"]);
				
			// По группировкам "Дата составления доп.листа":
			НомерЛиста = 0;
			Для Каждого СтрокаГруппировкиДатаСоставления Из СтрокаГруппировки.Строки Цикл
				Если НЕ СтрокаГруппировкиДатаСоставления["ЭтоГруппировкаДатаСоставления"] = Истина Тогда
					Продолжить;
				КонецЕсли;
				
				// Выводим в табличный документ:
				НомерЛиста = НомерЛиста + 1;
				ПараметрыДопЛиста = Новый Структура("
					|ДатаНачалаПериода,
					|ДатаОкончанияПериода,
					|ДатаСоставления,
					|ВсегоПокупок,
					|Сумма0,
					|СуммаБН,
					|СуммаБезНДС10,
					|СуммаБезНДС18,
					|СуммаБезНДС20,
					|НДС10,
					|НДС18,
					|НДС20");
				ЗаполнитьЗначенияСвойств(ПараметрыДопЛиста, СтрокаГруппировкиДатаСоставления);
				ПараметрыДопЛиста.Вставить("НомерЛиста", НомерЛиста);
				ТабДокумент = ВывестиДопЛист(ПараметрыОтчета, ПараметрыДопЛиста, СтрокаГруппировкиДатаСоставления.Строки, СтрокаИтого);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ТабДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				// Строка налогового периода:
				Наименование = ПредставлениеПериода(
					СтрокаГруппировки["ДатаНачалаПериода"],
					СтрокаГруппировки["ДатаОкончанияПериода"],
					"ФП");
				Поиск = Новый Структура("Наименование", Наименование);
				МассивСтрок = ДеревоСформированныхЛистов.Строки.НайтиСтроки(Поиск, Ложь); // ВключатьПодчиненные
				Если МассивСтрок.Количество() > 0 Тогда
					СтрокаНалоговогоПериода = МассивСтрок[0];
				Иначе
					СтрокаНалоговогоПериода = ДеревоСформированныхЛистов.Строки.Добавить();
					СтрокаНалоговогоПериода["Наименование"] = Наименование;
					СтрокаНалоговогоПериода["ПредставлениеНалоговогоПериода"] = Наименование;
				КонецЕсли;
				СтрокаНалоговогоПериода["ИндексСоответствующейСтрокиСписка"] = -1;
				СтрокаНалоговогоПериода["ДатаНачалаПериода"] = СтрокаГруппировки["ДатаНачалаПериода"];
				// Строка доп.листа:
				СтрокаДопЛиста = СтрокаНалоговогоПериода.Строки.Добавить();
				Текст = НСтр("ru='Доп. лист %1'");
				СтрокаДопЛиста["Наименование"] = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					Текст, НомерЛиста);
				СтрокаДопЛиста["Картинка"] = ИспользуемаяКартинкаВДеревеЛистов;
				СтрокаДопЛиста["ИндексСоответствующейСтрокиСписка"] = ИндексСоответствующейСтрокиСписка;
				СтрокаДопЛиста["ПредставлениеНалоговогоПериода"] = Наименование + " (" + НРег(СтрокаДопЛиста["Наименование"]) + ")";
			КонецЦикла;
			
		КонецЦикла;
		
	Исключение
		СообщитьОбОшибке(ИнформацияОбОшибке());
		
	КонецПопытки;
	
КонецПроцедуры 

Процедура ДозаполнитьДеревоСформированныхЛистов(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, УникальныйИдентификаторФормы)
	
	Если ДеревоСформированныхЛистов.Строки.Количество() = 0 Тогда
		// Добавляем служебную информационную строку:
		СтрокаВерхнегоУровня = ДеревоСформированныхЛистов.Строки.Добавить();
		СтрокаВерхнегоУровня["Наименование"]	= НСтр("ru='поиск не дал результатов'");
		СтрокаВерхнегоУровня["Картинка"]		= БиблиотекаКартинок.Информация;
		СтрокаВерхнегоУровня["ЭтоПустойЛист"]	= Истина;
		СтрокаВерхнегоУровня["ПредставлениеНалоговогоПериода"]	= НСтр("ru='данные отсутствуют'");
		
		ТабДокумент = РегламентированныеРегистры.ПолучитьПредставлениеОтчетаСПустымРезультатом(ПараметрыОтчета);
		ДанныеЛиста = Новый Структура("ТабличныйДокумент", ТабДокумент);
		СтрокаВерхнегоУровня["АдресХранилищаСДаннымиЛиста"] = ПоместитьВоВременноеХранилище(
			ДанныеЛиста,
			УникальныйИдентификаторФормы);
			
	Иначе
		// Упорядочиваем дерево листов по дате:
		ДеревоСформированныхЛистов.Строки.Сортировать("ДатаНачалаПериода", Ложь); // ВключатьПодчиненные
		
		// Собираем табличные документы всех листов из текущего налогового периода
		// в один новый большой документ:
		Для Каждого СтрокаВерхнегоУровня Из ДеревоСформированныхЛистов.Строки Цикл
			КолвоЛистов = СтрокаВерхнегоУровня.Строки.Количество();
			Если КолвоЛистов = 1 Тогда
				СтрокаВерхнегоУровня["ИндексСоответствующейСтрокиСписка"] = СтрокаВерхнегоУровня.Строки[0]["ИндексСоответствующейСтрокиСписка"];
				
			ИначеЕсли КолвоЛистов > 1 Тогда
				ОбщийТабличныйДокумент = Новый ТабличныйДокумент();
				ЭтоОчереднойЛист = Ложь;
				Для Каждого СтрокаЛиста Из СтрокаВерхнегоУровня.Строки Цикл
					ТабличныйДокументЛиста = СписокСформированныхЛистов.Получить(
						СтрокаЛиста["ИндексСоответствующейСтрокиСписка"]).Значение["ТабличныйДокумент"];
					Если ЭтоОчереднойЛист Тогда
						ОбщийТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					Иначе
						// Это первый лист.
						ЭтоОчереднойЛист = Истина;
						ЗаполнитьЗначенияСвойств(ОбщийТабличныйДокумент, ТабличныйДокументЛиста);
					КонецЕсли;
					ОбщийТабличныйДокумент.Вывести(ТабличныйДокументЛиста);
					
					// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
					ДанныеЛиста = Новый Структура();
					ДанныеЛиста.Вставить("ТабличныйДокумент", ОбщийТабличныйДокумент);
					НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
					ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
					
					// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
					СтрокаВерхнегоУровня["ИндексСоответствующейСтрокиСписка"] = ИндексСоответствующейСтрокиСписка;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Размещаем отдельно данные каждого листа в хранилище:
		Для Каждого СтрокаВерхнегоУровня Из ДеревоСформированныхЛистов.Строки Цикл
			СтрокаВерхнегоУровня["АдресХранилищаСДаннымиЛиста"] = ПоместитьВоВременноеХранилище(
				СписокСформированныхЛистов.Получить(СтрокаВерхнегоУровня["ИндексСоответствующейСтрокиСписка"]).Значение,
				УникальныйИдентификаторФормы);
				
			Для Каждого СтрокаЛиста Из СтрокаВерхнегоУровня.Строки Цикл
				СтрокаЛиста["АдресХранилищаСДаннымиЛиста"] = ПоместитьВоВременноеХранилище(
					СписокСформированныхЛистов.Получить(СтрокаЛиста["ИндексСоответствующейСтрокиСписка"]).Значение,
					УникальныйИдентификаторФормы);
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры


Функция ПолучитьНастройкиСКД_ОсновнойРаздел(ПараметрыОтчета)
	
	Результат = Новый Структура("
		|ИспользуемаяСхемаКомпоновкиДанных,
		|НовыйКомпоновщикНастроек");
	
	// Возвращаемые объекты:
	ИспользуемаяСхемаКомпоновкиДанных	= ПолучитьМакет("ОсновнойРазделКнигиПокупок");
	НовыйКомпоновщикНастроек			= Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ИспользуемаяСхемаКомпоновкиДанных));
	НовыйКомпоновщикНастроек.ЗагрузитьНастройки(ИспользуемаяСхемаКомпоновкиДанных.ВариантыНастроек["Основной"].Настройки);
	
	// Настраиваем схему.
	
	// Значения параметров схемы:
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаНачала",	ПараметрыОтчета["НачалоПериода"]);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаКонца",		ПараметрыОтчета["КонецПериода"]);
	ПричиныНалогообложенияАванс = Новый СписокЗначений();
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученный);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ПричиныНалогообложенияАванс", ПричиныНалогообложенияАванс);
	
	// Копируем отбор, установленный в форме отчета:
	СтандартныеОтчетыКлиентСервер.СкопироватьОтбор(
		НовыйКомпоновщикНастроек.Настройки.Отбор,
		ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	
	// Настройки группировок:
	Настройки = НовыйКомпоновщикНастроек.Настройки;
	НастройкиБезГруппировкиПоКонтрагенту				= Настройки.Структура[0];
	НастройкиСГруппировкойПоКонтрагенту					= Настройки.Структура[1];
	НастройкиБезГруппировкиПоКонтрагентуОднимСписком	= Настройки.Структура[2];
	НастройкиСГруппировкойПоКонтрагентуОднимСписком		= Настройки.Структура[3];
	Если ПараметрыОтчета["ГруппироватьПоКонтрагентам"] Тогда
		// Используем только группировку по контрагенту:
		НастройкиБезГруппировкиПоКонтрагенту.Использование				= Ложь;
		НастройкиСГруппировкойПоКонтрагенту.Использование				= Истина;
		НастройкиБезГруппировкиПоКонтрагентуОднимСписком.Использование	= Ложь;
		НастройкиСГруппировкойПоКонтрагентуОднимСписком.Использование	= Истина;
	Иначе
		// Используем только детальные записи:
		НастройкиБезГруппировкиПоКонтрагенту.Использование				= Истина;
		НастройкиСГруппировкойПоКонтрагенту.Использование				= Ложь;
		НастройкиБезГруппировкиПоКонтрагентуОднимСписком.Использование	= Истина;
		НастройкиСГруппировкойПоКонтрагентуОднимСписком.Использование	= Ложь;
	КонецЕсли;
	
	Результат["ИспользуемаяСхемаКомпоновкиДанных"]	= ИспользуемаяСхемаКомпоновкиДанных;
	Результат["НовыйКомпоновщикНастроек"]			= НовыйКомпоновщикНастроек;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНастройкиСКД_ДополнительныеЛисты(ПараметрыОтчета)
	
	Результат = Новый Структура("
		|ИспользуемаяСхемаКомпоновкиДанных,
