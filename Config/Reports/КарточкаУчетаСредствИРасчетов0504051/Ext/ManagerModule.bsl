#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Задает набор показателей, которые позволяет анализировать отчет.
//
// Возвращаемое значение:
//   Массив      - основные суммовые показатели отчета.
//
Функция ПолучитьНаборПоказателей() Экспорт
	
	НаборПоказателей = Новый Массив;
	НаборПоказателей.Добавить("БУ");
	
	Возврат НаборПоказателей;
	
КонецФункции

Функция ПолучитьПараметрыИсполненияОтчета() Экспорт
	
	Возврат Новый Структура(
		"ИспользоватьПередКомпоновкойМакета,
		|ИспользоватьПослеКомпоновкиМакета,
		|ИспользоватьПослеВыводаРезультата,
		|ИспользоватьПриВыводеЗаголовка,
		|ИспользоватьПриВыводеПодвала,
		|ВыводитьОтладочнуюИнформацию,
		|ИспользоватьДанныеРасшифровки,
		|ИспользоватьПривилегированныйРежим",
		Истина, Ложь, Истина, Истина, Истина, Истина, Истина, Истина);
	
КонецФункции
	
Процедура ПриВыводеЗаголовка(ПараметрыОтчета, КомпоновщикНастроек, Результат) Экспорт
	
	Макет = ПолучитьМакет("МакетФиксированныхОбластей");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок.Параметры.КонецПериода 	= Формат(КонецДня(ПараметрыОтчета.КонецПериода) + 1, "ДЛФ=Д");
	ОбластьЗаголовок.Параметры.Организация 		= ПараметрыОтчета.Организация.НаименованиеПолное;
	ОбластьЗаголовок.Параметры.ОКПО 			= ПараметрыОтчета.Организация.КодОКПО;
	ОбластьЗаголовок.Параметры.Подразделение 	= ПараметрыОтчета.Подразделение;
	ОбластьЗаголовок.Параметры.Счет = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета("", "", ПараметрыОтчета.Счет, "",, Истина);
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.ДебиторКредитор) Тогда
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	Контрагенты.ЮридическоеФизическоеЛицо.КодОКПО КАК ОКПО_ДК,
		|	ВЫБОР
		|		КОГДА НЕ Контрагенты.НаименованиеСокращенное = """"
		|			ТОГДА Контрагенты.НаименованиеСокращенное
		|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
		|				И НЕ Контрагенты.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
		|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.НаименованиеПолное
		|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
		|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.Наименование
		|		ИНАЧЕ Контрагенты.Наименование
		|	КОНЕЦ КАК ДебиторКредитор
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Ссылка");
		
		Запрос.УстановитьПараметр("Ссылка", ПараметрыОтчета.ДебиторКредитор);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(ОбластьЗаголовок.Параметры, Выборка);
		КонецЕсли;		
	КонецЕсли;	
	
	Попытка
		ОбластьЗаголовок.Параметры.ЗаПериод = ПредставлениеПериода(НачалоДня(ПараметрыОтчета.НачалоПериода), КонецДня(ПараметрыОтчета.КонецПериода), "ФП");
	Исключение
	КонецПопытки;
	
	Результат.Вывести(ОбластьЗаголовок);
	
	Если ПараметрыОтчета.ВыводитьПолностью Тогда
		СтандартныеОтчеты.ВыводитьОтбор(Результат, КомпоновщикНастроек, "Организация");
	КонецЕсли;
	
	Результат.Область("R1:R" + Результат.ВысотаТаблицы).Имя = "Заголовок";
	Результат.Области.Заголовок.Видимость = КомпоновщикНастроек.ПолучитьНастройки().ДополнительныеСвойства.ВыводитьЗаголовок;
	
КонецПроцедуры

Процедура ПриВыводеПодвала(ПараметрыОтчета, КомпоновщикНастроек, Результат) Экспорт
	
	ДатаДляПодвала = ОбщегоНазначенияБГУ.РабочаяДатаПользователя();
	
	Макет = ПолучитьМакет("МакетФиксированныхОбластей");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");

	ДанныеСотрудника = Новый Структура(
		"СсылкаНаОбъект,Период,Фамилия,Имя,Отчество,Должность",
		ПараметрыОтчета.Исполнитель, ДатаДляПодвала, "", "", "", "");
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина, Истина);
	
	СтруктураОблПодвал = Новый Структура();
	СтруктураОблПодвал.Вставить("ФИОИсполнитель", Справочники.Сотрудники.ФамилияИО(ПараметрыОтчета.Исполнитель, Истина, ДатаДляПодвала));
	СтруктураОблПодвал.Вставить("ДолжностьИсполнитель", ДанныеСотрудника.Должность); 
	СтруктураОблПодвал.Вставить("ТелeфонИсполнитель", ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
	СтруктураОблПодвал.Вставить("ЭлектроннаяПочтаИсполнитель", ДанныеСотрудника.EmailФизическиеЛица); 
	СтруктураОблПодвал.Вставить("ТекущаяДата", Формат(ДатаДляПодвала, "ДЛФ=ДДММММГГГГ"));
	
	ОбластьПодвал.Параметры.Заполнить(СтруктураОблПодвал);
	
	Высота = Результат.ВысотаТаблицы + 1;
	Результат.Вывести(ОбластьПодвал);
	Результат.Область(Высота, ,Результат.ВысотаТаблицы,).Имя = "Подписи";
	Результат.Области.Подписи.Видимость = КомпоновщикНастроек.ПолучитьНастройки().ДополнительныеСвойства.ВыводитьПодвал;
	
КонецПроцедуры

Функция ПолучитьТекстЗаголовка(ПараметрыОтчета, ОрганизацияВНачале = Истина) Экспорт 
	
	Возврат "Карточка учета средств и расчетов";
	
КонецФункции

// В процедуре можно доработать компоновщик перед выводом в отчет
// Изменения сохранены не будут
Процедура ПередКомпоновкойМакета(ПараметрыОтчета, Схема, КомпоновщикНастроек) Экспорт
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.Счет) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Счет", ПараметрыОтчета.Счет);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета.НачалоПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода", НачалоДня(ПараметрыОтчета.НачалоПериода));
	Иначе
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода", Дата(1, 1, 1));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета.КонецПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода", КонецДня(ПараметрыОтчета.КонецПериода));
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаОтчета", КонецДня(ПараметрыОтчета.КонецПериода));
	Иначе
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода", Дата(3999, 11, 1));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Учреждение", ПараметрыОтчета.Организация);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КодОКПО", ПараметрыОтчета.Организация.КодОКПО);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.НачалоПериода) И  ЗначениеЗаполнено(ПараметрыОтчета.КонецПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ЗаПериод", СтандартныеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(ПараметрыОтчета.НачалоПериода, ПараметрыОтчета.КонецПериода));
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек.Настройки.Структура[0].Структура[0].Отбор, "ПериодГруппировки",,ВидСравненияКомпоновкиДанных.Заполнено);
	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек.Настройки.Структура[0].Структура[0].Структура[0].Отбор, "Регистратор",,ВидСравненияКомпоновкиДанных.Заполнено);
	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек.Настройки.Структура[1].Структура[0].Отбор, "Регистратор",,ВидСравненияКомпоновкиДанных.Заполнено);
	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек.Настройки.Структура[2].Структура[0].Отбор, "ПериодГруппировки",,ВидСравненияКомпоновкиДанных.Заполнено);
	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек.Настройки.Структура[2].Структура[0].Структура[0].Отбор, "Регистратор",,ВидСравненияКомпоновкиДанных.Заполнено);
	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек.Настройки.Структура[3].Структура[0].Отбор, "Регистратор",,ВидСравненияКомпоновкиДанных.Заполнено);

	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(КомпоновщикНастроек.Настройки.Структура[0].Структура[0], "ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(КомпоновщикНастроек.Настройки.Структура[0].Структура[0].Структура[0], "ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(КомпоновщикНастроек.Настройки.Структура[1].Структура[0], "ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(КомпоновщикНастроек.Настройки.Структура[2].Структура[0], "ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(КомпоновщикНастроек.Настройки.Структура[2].Структура[0].Структура[0], "ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(КомпоновщикНастроек.Настройки.Структура[3].Структура[0], "ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);

	Если ПараметрыОтчета.Периодичность = 0 Тогда
		КомпоновщикНастроек.Настройки.Структура[0].Использование = Ложь;
		КомпоновщикНастроек.Настройки.Структура[1].Использование = ПараметрыОтчета.СКорСчет;
		КомпоновщикНастроек.Настройки.Структура[2].Использование = Ложь;
		КомпоновщикНастроек.Настройки.Структура[3].Использование = НЕ ПараметрыОтчета.СКорСчет;
	Иначе
		КомпоновщикНастроек.Настройки.Структура[0].Использование = ПараметрыОтчета.СКорСчет;
		КомпоновщикНастроек.Настройки.Структура[1].Использование = Ложь;
		КомпоновщикНастроек.Настройки.Структура[2].Использование = НЕ ПараметрыОтчета.СКорСчет;
		КомпоновщикНастроек.Настройки.Структура[3].Использование = Ложь;
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Периодичность", ПараметрыОтчета.Периодичность);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПС", Символы.ПС);
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.Подразделение) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "Подразделение", ПараметрыОтчета.Подразделение,,, Истина);
    КонецЕсли;
    
    СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыводитьИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	
	ЛинияСплошная = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	
	ТекущийНаборПоказателей = "" + ПараметрыОтчета.ПоказательБУ;
		
	Если ТекущийНаборПоказателей <> ПараметрыОтчета.мТекущийНаборПоказателей Тогда
		
		МассивМакетов = Новый Массив;
		МассивМакетов.Добавить("ПериодГруппировкиЗаголовок");
		МассивМакетов.Добавить("ОбщиеИтогиЗаголовок");
		МассивМакетов.Добавить("ОбщиеИтогиПодвал");
		МассивМакетов.Добавить("ПроводкиЗаголовок");
		
		МассивМакетов.Добавить("ПериодГруппировкиЗаголовокБезКС");
		МассивМакетов.Добавить("ОбщиеИтогиЗаголовокБезКС");
		МассивМакетов.Добавить("ОбщиеИтогиПодвалБезКС");
		МассивМакетов.Добавить("ПроводкиЗаголовокБезКС");
			
		Для Каждого ЭлементМакет Из МассивМакетов Цикл
			Схема.Макеты[ЭлементМакет].Макет = СтандартныеОтчеты.ПолучитьКопиюОписанияМакета(Схема.Макеты[ЭлементМакет + "Образец"].Макет);
			ОписаниеМакета = Схема.Макеты[ЭлементМакет].Макет;
			
			МассивСтрокДляУдаления = Новый Массив;
			Индекс = 0;
			Для Каждого ЭлементМассива Из ПолучитьНаборПоказателей() Цикл
				Если Не ПараметрыОтчета["Показатель" + ЭлементМассива] Тогда 
					МассивСтрокДляУдаления.Добавить(ОписаниеМакета[Индекс]);
				КонецЕсли;
				Индекс = Индекс + 1;
			КонецЦикла;
			
			Для Каждого Строка Из МассивСтрокДляУдаления Цикл
				ОписаниеМакета.Удалить(Строка);
			КонецЦикла;
			
			КоличествоСтрок = ОписаниеМакета.Количество();
			
			// Обвести область
            //Если КоличествоСтрок > 0 Тогда
            //	Для Индекс = 0 По 6 Цикл
            //		ПоследняяСтрока = ?(ЭлементМакет = "ОбщиеИтогиПодвал" И Индекс < 4, 0, КоличествоСтрок - 1);
            //		ПараметрГраницы = СтандартныеОтчетыКлиентСервер.ПолучитьПараметр(ОписаниеМакета[0].Ячейки[Индекс].Оформление.Элементы, "СтильГраницы");
            //		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ПараметрГраницы.ЗначенияВложенныхПараметров, "СтильГраницы.Сверху", ЛинияСплошная);
            //		ПараметрГраницы = СтандартныеОтчетыКлиентСервер.ПолучитьПараметр(ОписаниеМакета[ПоследняяСтрока].Ячейки[Индекс].Оформление.Элементы, "СтильГраницы");
            //		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ПараметрГраницы.ЗначенияВложенныхПараметров, "СтильГраницы.Снизу", ЛинияСплошная);	
            //	КонецЦикла;
            //КонецЕсли;
		КонецЦикла;
		ПараметрыОтчета.мТекущийНаборПоказателей = ТекущийНаборПоказателей;
	КонецЕсли;
	
	СтандартныеОтчеты.ДобавитьОтборПоОрганизацииФ(ПараметрыОтчета, КомпоновщикНастроек);
	
КонецПроцедуры

Процедура ПослеВыводаРезультата(ПараметрыОтчета, Результат) Экспорт
	
	СтандартныеОтчеты.ОбработкаРезультатаОтчетаФ(ПараметрыОтчета.ИдентификаторОтчета, Результат);

	Если Результат.Области.Найти("Заголовок") = Неопределено Тогда
		Результат.ФиксацияСверху = 2;
	Иначе
		Результат.ФиксацияСверху = Результат.Области.Заголовок.Низ + 2;
	КонецЕсли;
	
КонецПроцедуры

