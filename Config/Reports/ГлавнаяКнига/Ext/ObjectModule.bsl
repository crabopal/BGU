	ПозицияНачало = СтрНайти(Запрос, "//ПоляНПКПКЭКНачало");
	ПозицияКонец =  СтрНайти(Запрос, "//ПоляНПКПКЭККонец"); 
	СтрПоляОстаткиНГКЭК = Сред(Запрос, ПозицияНачало + 19, ПозицияКонец - ПозицияНачало - 19);
    СтрПоляОстаткиНГКЭК = СтрЗаменить(СтрПоляОстаткиНГКЭК, "ОстаткиНПКП", "ВложенныйЗапрос");
    СтрПоляОстаткиНГКЭК = СтрПоляОстаткиНГКЭК + Символы.ВК + "ИЗ (" + Символы.ВК;

	// Модификация текста запроса	
	Вставка = 
