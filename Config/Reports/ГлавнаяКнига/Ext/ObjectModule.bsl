#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	МакетШапки = УправлениеПечатью.МакетПечатнойФормы("Отчет.ГлавнаяКнига.МакетФиксированныхОбластей");
	ОбластьЗаголовок = МакетШапки.ПолучитьОбласть("Заголовок");
	ОбластьШапка = МакетШапки.ПолучитьОбласть("Шапка");
	Разделитель = МакетШапки.ПолучитьОбласть("Разделитель");
	
	ДокументРезультат.Вывести(ОбластьЗаголовок);
	ДокументРезультат.НачатьГруппуСтрок();
	
	ПараметрыОтчета = КомпоновщикНастроек.ПолучитьНастройки().ПараметрыДанных;
	ПараметрыШапки = Новый Структура;
	
	Организация = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация"));
	Если НЕ Организация = Неопределено И ЗначениеЗаполнено(Организация.Значение) Тогда
		ПараметрыШапки.Вставить("Учреждение", Справочники.Организации.ПредставлениеУчреждения(Организация.Значение, Ложь));
		
		СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация.Значение, "Бюджет,КодОКПО");
		ПараметрыШапки.Вставить("ОКПО", СвойстваОрганизации.КодОКПО);
		
		РеквизитыБюджета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СвойстваОрганизации.Бюджет, "НаименованиеПубличноПравовогоОбразования,НаименованиеПолное");
		ПараметрыШапки.Вставить("Учредитель", РеквизитыБюджета.НаименованиеПубличноПравовогоОбразования);
		ПараметрыШапки.Вставить("Бюджет", РеквизитыБюджета.НаименованиеПолное);
		
		ПодразделениеОтчета = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Подразделение"));
		Если НЕ ПодразделениеОтчета = Неопределено И ЗначениеЗаполнено(ПодразделениеОтчета.Значение) Тогда
			ПараметрыПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПодразделениеОтчета.Значение, "НаименованиеПолное,Наименование,ОбособленноеПодразделение");
			НазваниеПодразделения = "";
			Если ПараметрыПодразделения.ОбособленноеПодразделение И ЗначениеЗаполнено(ПараметрыПодразделения.НаименованиеПолное) Тогда
				НазваниеПодразделения =	ПараметрыПодразделения.НаименованиеПолное;
			Иначе
				НазваниеПодразделения =	ПараметрыПодразделения.Наименование;
			КонецЕсли;
			ПараметрыШапки.Вставить("Подразделение", НазваниеПодразделения);
		КонецЕсли;	
		
	КонецЕсли;
	
	ПериодОтчета = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	Если НЕ ПериодОтчета = Неопределено Тогда
		ПараметрыШапки.Вставить("СтрокаПериода", ПредставлениеПериода(ПериодОтчета.Значение.ДатаНачала, ПериодОтчета.Значение.ДатаОкончания, "ФП"));
		ПараметрыШапки.Вставить("ДатаОтчета", Формат(ПериодОтчета.Значение.ДатаОкончания + 1, "ДЛФ=Д"));
	КонецЕсли;	

	
	ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
	ДокументРезультат.Вывести(ОбластьШапка);
	ДокументРезультат.ЗакончитьГруппуСтрок();
	ДокументРезультат.Вывести(Разделитель);  
	ДокументРезультат.ПовторятьПриПечатиСтроки = ДокументРезультат.Область("R" + (ДокументРезультат.ВысотаТаблицы + 2) + ":R" + (ДокументРезультат.ВысотаТаблицы + 4));

	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;
	Настройки.События.ПриОпределенииСвойствЭлементовФормыНастроек = Истина;
	Настройки.Печать.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
КонецПроцедуры

Процедура ПриОпределенииСвойствЭлементовФормыНастроек(ТипФормы, СвойстваЭлементов, ПользовательскиеНастройки) Экспорт 
	
	СвойстваГруппы = ОтчетыСервер.СвойстваГруппыЭлементовФормы();
	СвойстваЭлементов.Группы.Вставить("ФиксированныеПараметры_0", СвойстваГруппы);

	ФиксированныеПараметры_0 = Новый Структура("Включать5ХХСчет, ВыводитьРазвернутоеСальдо, БезОтрицательныхОстатков");
	
	Для Каждого ЭлементНастройки Из ПользовательскиеНастройки Цикл 
		
		Если ТипЗнч(ЭлементНастройки) <> Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда 
			Продолжить;
		КонецЕсли;
		
		Если ФиксированныеПараметры_0.Свойство(ЭлементНастройки.Параметр) Тогда
			ИдентификаторГруппы = "ФиксированныеПараметры_0";
		Иначе
			Продолжить;
	    КонецЕсли;
		
		СвойстваПоля = СвойстваЭлементов.Поля.Найти(ЭлементНастройки.ИдентификаторПользовательскойНастройки, "ИдентификаторНастройки");
		
		Если СвойстваПоля = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		СвойстваПоля.ИдентификаторГруппы = ИдентификаторГруппы;
		
	КонецЦикла;
	
КонецПроцедуры

// Вызывается перед загрузкой новых настроек. Используется для изменения схемы компоновки.
//   Например, если схема отчета зависит от ключа варианта или параметров отчета.
//   Чтобы изменения схемы вступили в силу следует вызывать метод ОтчетыСервер.ПодключитьСхему().
//
// Параметры:
//   Контекст - Произвольный - 
//       Параметры контекста, в котором используется отчет.
//       Используется для передачи в параметрах метода ОтчетыСервер.ПодключитьСхему().
//   КлючСхемы - Строка -
//       Идентификатор текущей схемы компоновщика настроек.
//       По умолчанию не заполнен (это означает что компоновщик инициализирован на основании основной схемы).
//       Используется для оптимизации, чтобы переинициализировать компоновщик как можно реже.
//       Может не использоваться если переинициализация выполняется безусловно.
//   КлючВарианта - Строка
//                - Неопределено -
//       Имя предопределенного или уникальный идентификатор пользовательского варианта отчета.
//       Неопределено когда вызов для варианта расшифровки или без контекста.
//   НовыеНастройкиКД - НастройкиКомпоновкиДанных
//                    - Неопределено -
//       Настройки варианта отчета, которые будут загружены в компоновщик настроек после его инициализации.
//       Неопределено когда настройки варианта не надо загружать (уже загружены ранее).
//   НовыеПользовательскиеНастройкиКД - ПользовательскиеНастройкиКомпоновкиДанных
//                                    - Неопределено -
//       Пользовательские настройки, которые будут загружены в компоновщик настроек после его инициализации.
//       Неопределено когда пользовательские настройки не надо загружать (уже загружены ранее).
//
Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт
	
	Если НЕ ТипЗнч(НовыеНастройкиКД) = Тип("НастройкиКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;

	Организация = Неопределено;
	ПараметрОрганизация = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация"));
	Если ПараметрОрганизация <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
		НастройкаОрганизация = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрОрганизация.ИдентификаторПользовательскойНастройки);
		Если НастройкаОрганизация <> Неопределено Тогда
			Организация = НастройкаОрганизация.Значение	
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ПоВсемОрганизациям", ЛОЖЬ);
		СтандартныеОтчетыКлиентСервер.УдалитьОтбор(НовыеНастройкиКД, "Организация", Истина);
		
		Подразделение = Неопределено;
		Исполнитель = Неопределено;
		
		ДатаЗначений = ТекущаяДатаСеанса();
		ПараметрДата = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаФормирования")); 
		Если ПараметрДата <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
			НастройкаДата = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрДата.ИдентификаторПользовательскойНастройки);
			Если НастройкаДата <> Неопределено Тогда
				Если ТипЗнч(НастройкаДата.Значение) = Тип("Дата") Тогда
					ДатаЗначений = НастройкаДата.Значение;
				Иначе
					ДатаЗначений = НастройкаДата.Значение.Дата;
				КонецЕсли; 
			КонецЕсли;  	
		КонецЕсли;
		
		ПараметрИсполнитель = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Исполнитель"));
		Если ПараметрИсполнитель <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
			НастройкаИсполнитель = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрИсполнитель.ИдентификаторПользовательскойНастройки);
			Если НастройкаИсполнитель <> Неопределено Тогда
				Если НЕ ЗначениеЗаполнено(НастройкаИсполнитель.Значение) Тогда
					Исполнитель = СтандартныеОтчеты.ОтветственныйИсполнитель(Организация);
					НастройкаИсполнитель.Значение = Исполнитель;
				Иначе
					Исполнитель = НастройкаИсполнитель.Значение	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Исполнитель) Тогда
			ПараметрПодразделение = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Подразделение"));
			Если ПараметрПодразделение <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
				НастройкаПодразделение = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрПодразделение.ИдентификаторПользовательскойНастройки);
				Если НастройкаПодразделение <> Неопределено Тогда
					Если НЕ ЗначениеЗаполнено(НастройкаПодразделение.Значение) Тогда
						Подразделение = СтандартныеОтчеты.ПодразделениеИсполнителя(Исполнитель, ДатаЗначений);
						НастройкаПодразделение.Значение = Подразделение;
					Иначе
						Подразделение = НастройкаПодразделение.Значение	
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ПараметрГлБухгалтер = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ГлБухгалтер"));
		Если ПараметрГлБухгалтер <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
			НастройкаГлБухгалтер = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрГлБухгалтер.ИдентификаторПользовательскойНастройки);
			Если НастройкаИсполнитель <> Неопределено Тогда
				Если НЕ ЗначениеЗаполнено(НастройкаГлБухгалтер.Значение) Тогда
					ГлБухгалтер = СтандартныеОтчеты.ГлавныйБухгалтер(Организация, ДатаЗначений, Подразделение);
					НастройкаГлБухгалтер.Значение = ГлБухгалтер;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ПоВсемОрганизациям", ИСТИНА);
	КонецЕсли;	
		
	Если ТипЗнч(НовыеНастройкиКД) = Тип("НастройкиКомпоновкиДанных") Тогда
		ОбщийМодульСКД.ДополнитьОтборНастроекКД(НовыеНастройкиКД.Отбор.Элементы, НовыеПользовательскиеНастройкиКД.Элементы);
		ТекстОтбор = СтандартныеОтчеты.ПолучитьТекстОтбора(НовыеНастройкиКД.Отбор, Неопределено); 
		Если ЗначениеЗаполнено(ТекстОтбор) Тогда
			ТекстОтбор = "Примечание. В документе отражены данные, отвечающие условиям: " +  ТекстОтбор;
		КонецЕсли;
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "Комментарий", ТекстОтбор);
	КонецЕсли;

	РазвернутоеСальдо = Истина;
	ПараметрВыводитьРазвернутоеСальдо = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ВыводитьРазвернутоеСальдо"));
	Если ПараметрВыводитьРазвернутоеСальдо <> Неопределено Тогда
		Если НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
			НастройкаРазвернутоеСальдо = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрВыводитьРазвернутоеСальдо.ИдентификаторПользовательскойНастройки);
			Если НастройкаРазвернутоеСальдо <> Неопределено Тогда
				РазвернутоеСальдо = НастройкаРазвернутоеСальдо.Значение;
			КонецЕсли;
		Иначе
			РазвернутоеСальдо = ПараметрВыводитьРазвернутоеСальдо.Значение;
		КонецЕсли;
	КонецЕсли;	
	Если РазвернутоеСальдо = Истина Тогда
		Если НЕ КлючСхемы = "СРазвернутымСальдо" Тогда
			ДобавитьРазвернутыеСчета(СхемаКомпоновкиДанных);
			КлючСхемы = "СРазвернутымСальдо";
			ОтчетыСервер.ПодключитьСхему(ЭтотОбъект, Контекст, СхемаКомпоновкиДанных, КлючСхемы);
		КонецЕсли	
	ИначеЕсли КлючСхемы = "СРазвернутымСальдо" Тогда
		КлючСхемы = "";
		ОтчетыСервер.ПодключитьСхему(ЭтотОбъект, Контекст, СхемаКомпоновкиДанных, КлючСхемы);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазложитьРазвернутыеСчетаПоКатегориям(СписокСчетовВИерархии, МассивСписковСчетовПоСубконто)

    Для Элемент = 0 по МассивСписковСчетовПоСубконто.Количество() - 1 Цикл
        МассивСписковСчетовПоСубконто[Элемент] = Новый Соответствие;
    КонецЦикла;

    СтекВложенныхСчетов = Новый Массив();
    Стр = СтандартныеОтчеты.ДанныеОтчетаРазвернутоеСальдо(Новый Запрос);
    Пока Стр.Следующий() Цикл
        Если Стр.Счет.ЭлементГруппа Тогда
            Продолжить;
        КонецЕсли;
        Если Стр.Использование = Перечисления.ВидыРазвернутогоСальдо.Разворачивать Тогда
                // По субконто
            МассивЗначений = Новый Массив(2);
            МассивЗначений[0] = Новый СписокЗначений; //СписокСубконто 
                // Формируем ключ
            Для Сбк = 1 По 3 Цикл
                Если ЗначениеЗаполнено(Стр["Субконто" + Сбк]) Тогда
                    МассивЗначений[0].Добавить(Стр["Субконто" + Сбк]);
                КонецЕсли;
            КонецЦикла;
            КСубконто    = МассивЗначений[0].Количество();
            ЗначениеПоКлючу = МассивСписковСчетовПоСубконто[КСубконто].Получить(Строка(МассивЗначений[0])); //СписокСчетов
            Если ЗначениеПоКлючу = Неопределено Тогда
                МассивЗначений[1] = Новый СписокЗначений;
            Иначе
                МассивЗначений[1] = ЗначениеПоКлючу[1];
            КонецЕсли;
                
            МассивЗначений[1].Добавить(Стр.Счет);
            МассивСписковСчетовПоСубконто[КСубконто].Вставить(Строка(МассивЗначений[0]), МассивЗначений);
        КонецЕсли;
    КонецЦикла;

    Возврат Истина;

КонецФункции

// Добавляет в запрос развернутое сальдо по заданным счетам
//
Процедура ДобавитьРазвернутыеСчета(Схема)
    
    // Раскладываем развернутые счета по категориям:
    // - Не используется субконто
    // - Используется одно субконто
    //		Соответствие (Ключ - Строка(СписокЗначений(Субконто)), Значение - Массив(СписокЗначений(Субконто), СписокЗначений(Счет)))
    // - Используется два субконто
    //		Соответствие (Ключ - Строка(СписокЗначений(Субконто)), Значение - Массив(СписокЗначений(Субконто), СписокЗначений(Счет)))
    // - ...
    СписокСчетовВИерархии  = Новый СписокЗначений; // - Включена иерархия
    МассивСписковСчетовПоСубконто = Новый Массив(4);
    РазложитьРазвернутыеСчетаПоКатегориям(СписокСчетовВИерархии, МассивСписковСчетовПоСубконто);
	
    // заполнение списка
    СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "РазвернутыеСчета", СписокСчетовВИерархии);
    // Создаем запрос по развернутым остаткам
    // Он будет объединять все запросы по счетам
    // Выбрать ... из БухОстатки(Счет В МассивСписковСчетовПоСубконто[ЙЙ].Значение, Субконто - МассивСписковСчетовПоСубконто[ЙЙ].Ключ)
    // Объеденить все
    // Выбрать ... из БухОстатки(Счет В МассивСписковСчетовПоСубконто[ЙЙ + 1].Значение, Субконто - МассивСписковСчетовПоСубконто[ЙЙ + 1].Ключ)
    // ...
    ТекстЛевогоСоединения = Новый Массив(4);
    ОСТАТКИ_НОВЫЙ_ГОД = 0; // НЕ ИЗМЕНЯТЬ ЗНАЧЕНИЕ
    ОСТАТКИ_ЗА_ПЕРИОД = 1; // НЕ ИЗМЕНЯТЬ ЗНАЧЕНИЕ
	ОСТАТКИ_НОВЫЙ_ГОД_КЭК = 2; // НЕ ИЗМЕНЯТЬ ЗНАЧЕНИЕ
    ОСТАТКИ_ЗА_ПЕРИОД_КЭК = 3; // НЕ ИЗМЕНЯТЬ ЗНАЧЕНИЕ
    ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] = "";
    ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] = ""; 
	ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК] = "";
    ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК] = ""; 
    ЗапросОбъединитьВсе =
        "
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |";
	ЗапросЛевСоединениеВыбор = 
		"ВЫБРАТЬ
        |    Запрос.КПС,
        |    Запрос.КФО,
        |    Запрос.Счет,
		|	 //КЭК для ИЕ 
        |    Запрос.Организация,
        |    NULL Как ИФО,
        |    Запрос.Валюта,
        |";
    ЗапросЛевСоединениеРазвернутыеНКОстатки = //НК Начальные/Конечные остатки - Остатки за период
        "ВЫБОР
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
        |		Запрос.СуммаНачальныйРазвернутыйОстатокДт - Запрос.СуммаНачальныйРазвернутыйОстатокКт
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
        |		0
        |	ИНАЧЕ
        |		Запрос.СуммаНачальныйРазвернутыйОстатокДт
        |КОНЕЦ КАК СуммаНачальныйОстатокДт,
        |ВЫБОР
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
        |		0
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
        |		Запрос.СуммаНачальныйРазвернутыйОстатокКт - Запрос.СуммаНачальныйРазвернутыйОстатокДт
        |	ИНАЧЕ
        |		Запрос.СуммаНачальныйРазвернутыйОстатокКт
        |КОНЕЦ КАК СуммаНачальныйОстатокКт,
        |ВЫБОР
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
        |		Запрос.СуммаКонечныйРазвернутыйОстатокДт - Запрос.СуммаКонечныйРазвернутыйОстатокКт
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
        |			0
        |	ИНАЧЕ
        |		Запрос.СуммаКонечныйРазвернутыйОстатокДт
        |КОНЕЦ КАК СуммаКонечныйОстатокДт,
        |ВЫБОР
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
        |		0
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
        |		Запрос.СуммаКонечныйРазвернутыйОстатокКт - Запрос.СуммаКонечныйРазвернутыйОстатокДт
        |	ИНАЧЕ
        |		Запрос.СуммаКонечныйРазвернутыйОстатокКт
        |КОНЕЦ КАК СуммаКонечныйОстатокКт
        |";
        
    ЗапросЛевСоединениеРазвернутыеНГОстатки = // НГ - Новый Год
        "ВЫБОР
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
        |		Запрос.СуммаРазвернутыйОстатокДт - Запрос.СуммаРазвернутыйОстатокКт
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
        |			0
        |	ИНАЧЕ
        |		Запрос.СуммаРазвернутыйОстатокДт
        |КОНЕЦ КАК СуммаОстатокДт,
        |ВЫБОР
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
        |		0
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
        |		Запрос.СуммаРазвернутыйОстатокКт - Запрос.СуммаРазвернутыйОстатокДт
        |	ИНАЧЕ
        |		Запрос.СуммаРазвернутыйОстатокКт
        |КОНЕЦ КАК СуммаОстатокКт
        |";

    ЗапросОстаткиИОборотыЛевСоединениеИз = // Таблица ОстаткиИОбороты
        "ИЗ
        |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
        |	    {(НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ))},
        |	    {(&КонецПериода)},
        |		,
        |		,
        |	    Счет В (&СчетаПоРазвернутомуСальдо) И НЕ Счет.Забалансовый И (&Включать5ХХСчет = ИСТИНА ИЛИ НЕ Счет В ИЕРАРХИИ (&Счета5ХХ)),
        |	    &СубконтоРазвернутый,
        |	    {(КПС).* КАК КПС, (Организация).* КАК Организация, (КФО) КАК КФО";
        
    ЗапросОстаткиЛевСоединениеИз = // Таблица Остатки
        "ИЗ
        |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
        |		{(НАЧАЛОПЕРИОДА(&НачалоПериода, ГОД))},
        |		Счет В (&СчетаПоРазвернутомуСальдо) И НЕ Счет.Забалансовый И (&Включать5ХХСчет = ИСТИНА ИЛИ НЕ Счет В (&Счета5ХХ)),
        |		&СубконтоРазвернутый,
        |		{(КПС).* КАК КПС, (Организация).* КАК Организация, (КФО) КАК КФО";
        
    ЗапросОстаткиЛевСоединениеИзКак = "}) КАК Запрос";
        
    ЗапросКАКВложенныйЗапрос = 
        ") КАК ВложенныйЗапрос
        |";
	
	ПрефиксПолейПоКЭК = "
	|	0,
	|	0,";
	
    УсловиеПолеСуммаОстатка = "";
    КолВоСубконто = МассивСписковСчетовПоСубконто.Количество() - 1;
    ЗначПарам = Новый СписокЗначений();
    Для Й = 0 По КолВоСубконто Цикл
        ЙЙ = 0;
        Для каждого Сбк из МассивСписковСчетовПоСубконто[Й] Цикл
            // Объединить все
            Если ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] <> "" Тогда
                ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + ЗапросОбъединитьВсе;
                ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + ЗапросОбъединитьВсе; 
				ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК] = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК] + ЗапросОбъединитьВсе;
                ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК] = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК] + ЗапросОбъединитьВсе;
            КонецЕсли;
            // Выбор + развернутые поля
            ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД]  = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + ЗапросЛевСоединениеВыбор;
            ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД]  = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + ЗапросЛевСоединениеРазвернутыеНГОстатки;
            ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД]  = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + ЗапросЛевСоединениеВыбор;
            ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД]  = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + ЗапросЛевСоединениеРазвернутыеНКОстатки;
			
			ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК]  = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК] + СтрЗаменить(ЗапросЛевСоединениеВыбор, "//КЭК для ИЕ", "Запрос.КЭК,");
            ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК]  = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК] + ПрефиксПолейПоКЭК + ЗапросЛевСоединениеРазвернутыеНГОстатки;
            ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК]  = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК] + СтрЗаменить(ЗапросЛевСоединениеВыбор, "//КЭК для ИЕ", "Запрос.КЭК,");            
			ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК]  = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК] + ПрефиксПолейПоКЭК + ЗапросЛевСоединениеРазвернутыеНКОстатки;

            // Из
            ТекстИзЗаНовГод = ЗапросОстаткиЛевСоединениеИз;
            ТекстИзЗаПериод = ЗапросОстаткиИОборотыЛевСоединениеИз;
            Для ЙЙЙ = 0 По КолВоСубконто - 1 Цикл
                СтрокаСбк = Символы.ВК;
                Если ЙЙЙ < Й Тогда
                    СтрокаСбк = СтрокаСбк + ",Субконто" + Строка(ЙЙЙ + 1);
                    ТекстИзЗаПериод = ТекстИзЗаПериод + ", (Субконто" + Строка(ЙЙЙ + 1) + ").* КАК Субконто" + Строка(ЙЙЙ + 1);
                    ТекстИзЗаНовГод = ТекстИзЗаНовГод + ", (Субконто" + Строка(ЙЙЙ + 1) + ").* КАК Субконто" + Строка(ЙЙЙ + 1);
                Иначе
                    СтрокаСбк = СтрокаСбк + ",NULL";
                КонецЕсли;
                ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + СтрокаСбк + " КАК Субконто" + Строка(ЙЙЙ + 1);
                ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + СтрокаСбк + " КАК Субконто" + Строка(ЙЙЙ + 1);
				ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК] = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК] + СтрокаСбк + " КАК Субконто" + Строка(ЙЙЙ + 1);
                ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК] = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК] + СтрокаСбк + " КАК Субконто" + Строка(ЙЙЙ + 1);
            КонецЦикла;
			
			// СчетаПоРазвернутомуСальдо
            Парам = "СчетаПоРазвернутомуСальдо" + Строка(Й) + Строка(ЙЙ);
            ТекстИзЗаНовГод = СтрЗаменить(ТекстИзЗаНовГод, "&СчетаПоРазвернутомуСальдо", "&" + Парам);
            ТекстИзЗаПериод = СтрЗаменить(ТекстИзЗаПериод, "&СчетаПоРазвернутомуСальдо", "&" + Парам);
            Прмтр = СтандартныеОтчеты.СкопироватьПараметрСхемыКомпоновкиДанных(Схема, Парам, "СчетаПоРазвернутомуСальдо", Сбк.Значение[1]);
            Прмтр.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
			
			// Накапливаем условие для сумм
            Если СтрДлина(УсловиеПолеСуммаОстатка) Тогда
                УсловиеПолеСуммаОстатка = УсловиеПолеСуммаОстатка + " ИЛИ";
            КонецЕсли;
            УсловиеПолеСуммаОстатка = УсловиеПолеСуммаОстатка + " Счет В(&" + Парам + ")";
			
			// Добавляем счета в параметр РазвернутыеСчета
            Для каждого Сч из Сбк.Значение[1] Цикл
                ЗначПарам.Добавить(Сч);
			КонецЦикла;
			
            // СубконтоРазвернутый. Если по субконто не разворачиваем, то и не создаем такой параметр
            ЗаменитьНа = "";
            Если Й Тогда
                Парам = "СубконтоРазвернутый" + Строка(Й) +Строка(ЙЙ);
                Прмтр = СтандартныеОтчеты.СкопироватьПараметрСхемыКомпоновкиДанных(Схема, Парам, "СубконтоРазвернутый", Сбк.Значение[0]);
                Прмтр.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
                ЗаменитьНа = "&" + Парам;
            КонецЕсли;
            ТекстИзЗаНовГод = СтрЗаменить(ТекстИзЗаНовГод, "&СубконтоРазвернутый", ЗаменитьНа);
            ТекстИзЗаПериод = СтрЗаменить(ТекстИзЗаПериод, "&СубконтоРазвернутый", ЗаменитьНа);
            
            ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + Символы.ВК + ТекстИзЗаНовГод;
            ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + ЗапросОстаткиЛевСоединениеИзКак;
            ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + Символы.ВК + ТекстИзЗаПериод;
            ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + ЗапросОстаткиЛевСоединениеИзКак;
			ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК] = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК] + Символы.ВК + ТекстИзЗаНовГод;
            ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК] = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК] + ЗапросОстаткиЛевСоединениеИзКак;
            ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК] = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК] + Символы.ВК + ТекстИзЗаПериод;
            ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК] = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК] + ЗапросОстаткиЛевСоединениеИзКак;
            ЙЙ = ЙЙ + 1;
        КонецЦикла;
    КонецЦикла;
	
	// Если не указано ни одного развернутого сальдо
    Если ПустаяСтрока(ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД]) Тогда
        Возврат;
    КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "РазвернутыеСчета", ЗначПарам);

    // Вставляем полученные запросы в основной текст
    Запрос = Схема.НаборыДанных.НаборДанных1.Запрос;

	// Добавляем Объединить все к запросу ОстаткиНГ из накопленного запроса ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД]		
	ПозицияНачало = СтрНайти(Запрос, "//ПоляНГбезКЭКНачало");
	ПозицияКонец =  СтрНайти(Запрос, "//ПоляНГбезКЭККонец"); 
	СтрПоляОстаткиНГ = Сред(Запрос, ПозицияНачало + 20, ПозицияКонец - ПозицияНачало - 20);
    СтрПоляОстаткиНГ = СтрЗаменить(СтрПоляОстаткиНГ, "ОстаткиНГ", "ВложенныйЗапрос");
    СтрПоляОстаткиНГ = СтрЗаменить(СтрПоляОстаткиНГ, "РАЗРЕШЕННЫЕ", "");
	СтрПоляОстаткиНГ = СтрПоляОстаткиНГ + Символы.ВК + "ИЗ (" + Символы.ВК;  
	
	// Добавляем Объединить все к запросу ОстаткиНГ из накопленного запроса ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК]	
	ПозицияНачало = СтрНайти(Запрос, "//ПоляНГКЭКНачало");
