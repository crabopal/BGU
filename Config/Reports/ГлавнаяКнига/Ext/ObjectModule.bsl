	СтрПоляОстаткиНГ + ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + ЗапросКАКВложенныйЗапрос + 
	ЗапросОбъединитьВсе + 
	СтрПоляОстаткиНГКЭК + ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД_КЭК] + ЗапросКАКВложенныйЗапрос;
	 
	Запрос = СтрЗаменить(Запрос, "//ТВ2", Вставка);
		
	// Запросу ОстаткиНГ ставим условие И НЕ(Счет В {(&Счета..) ИЛИ ...}) - УсловиеПолеСуммаОстатка
    Запрос = СтрЗаменить(Запрос, "//СчетаУсловияРазвернутоеКЭКНГ", " И НЕ(" + УсловиеПолеСуммаОстатка + ")"); 
    
    Схема.НаборыДанных.НаборДанных1.Запрос = Запрос;
    
