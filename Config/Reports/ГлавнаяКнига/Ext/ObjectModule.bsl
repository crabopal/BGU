	СтрПоляОстаткиНГКЭК = Сред(Запрос, ПозицияНачало + 17, ПозицияКонец - ПозицияНачало - 17);
    СтрПоляОстаткиНГКЭК = СтрЗаменить(СтрПоляОстаткиНГКЭК, "ОстаткиНГ", "ВложенныйЗапрос");
    СтрПоляОстаткиНГКЭК = СтрПоляОстаткиНГКЭК + Символы.ВК + "ИЗ (" + Символы.ВК;
	
	// Модификация текста запроса	
	Вставка = 
	ЗапросОбъединитьВсе +
	СтрПоляОстаткиНГ + ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + ЗапросКАКВложенныйЗапрос + 
	ЗапросОбъединитьВсе + 
	СтрПоляОстаткиНГКЭК + ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД_КЭК] + ЗапросКАКВложенныйЗапрос;
	
	Запрос = СтрЗаменить(Запрос, "//ТВ1", Вставка); 
		 
    // ОСТАТКИ_ЗА_ПЕРИОД
	
	// Добавляем Объединить все к запросу ОстаткиНГ из накопленного запроса ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД]	
	ПозицияНачало = СтрНайти(Запрос, "//ПоляНПКПбезКЭКНачало");
