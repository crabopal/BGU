#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		
		// удаляем ИФО
		Запрос = СхемаКомпоновкиДанных.НаборыДанных[0].Запрос;
		
		// модифицируем текст запроса
		Запрос = СтрЗаменить(Запрос, "ЕПСБУОстатки.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		Запрос = СтрЗаменить(Запрос, "(ИФО).*,", "");
		
		СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = Запрос;
		
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		
		Запрос = СхемаКомпоновкиДанных.НаборыДанных[0].Запрос;				
		
		Запрос = СтрЗаменить(Запрос, "СтоимостьОбъектовОСОстатки.Подразделение"	, "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
		Запрос = СтрЗаменить(Запрос, "ЕПСБУОстатки.Подразделение"				, "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
		Запрос = СтрЗаменить(Запрос, "(Подразделение).*,", "");				
		
		СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = Запрос;
		
	КонецЕсли;
	
	ПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных;
		
	// установить параметр "Период"
	ТекущиеНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрДата = ТекущиеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПериодОтчета"));
	Если ПараметрДата <> Неопределено И ПараметрДата.Использование И ЗначениеЗаполнено(ПараметрДата.Значение) Тогда
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(
			"Период", Новый Граница(КонецДня(ПараметрДата.Значение), ВидГраницы.Включая));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
