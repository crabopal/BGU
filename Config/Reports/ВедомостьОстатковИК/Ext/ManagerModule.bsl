//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "Основной");
	// TODO:
	//   - Либо заполнить описание: НастройкиВарианта.Описание = НСтр("ru = ''");
	//   - Либо отключить вариант:  НастройкиВарианта.Включен = Ложь;
КонецПроцедуры

Функция СписокСчетов(КодыСчетов, ИмяВидаСубконто) Экспорт
	
	СписокСчетов = БухгалтерскийУчет.СписокСчетов(КодыСчетов);
	ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто[ИмяВидаСубконто];
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокСчетов", СписокСчетов);
	Запрос.УстановитьПараметр("ВидСубконто", ВидСубконто);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУВидыСубконто.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.ВидСубконто = &ВидСубконто
	|	И ЕПСБУВидыСубконто.Ссылка В(&СписокСчетов)";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

