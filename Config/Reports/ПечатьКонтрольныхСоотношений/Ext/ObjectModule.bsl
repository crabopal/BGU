Функция КроссТаблицаПроверки(КонтрольноеСоотношение, СтрокиПроверки, ЭтоПроверкаИтоговыхСтрок)
	
	НаборЗаписей = РегистрыСведений.АналитикаРаскрытияФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Установить(КонтрольноеСоотношение);
	НаборЗаписей.Прочитать();
	
	АналитикаРаскрытияФЛК = НаборЗаписей.Выгрузить();
	АналитикаРаскрытияФЛК.Сортировать("ПорядковыйНомер");

	Если НЕ АналитикаРаскрытияФЛК.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокиПроверки = АналитикаРаскрытияФЛК[0].КодыСтрокПроверок;
	
	Если ЗначениеЗаполнено(АналитикаРаскрытияФЛК[0].ГруппаРаскрытия) Тогда
		ЭтоПроверкаИтоговыхСтрок = Ложь;
	Иначе
		ЭтоПроверкаИтоговыхСтрок = Истина;
	КонецЕсли;
	
	КроссТаблица = Новый ТаблицаЗначений;
	
	КроссТаблица.Колонки.Добавить("УсловиеСтроки",,"Условие");
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Число"));
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТипЧисло = Новый ОписаниеТипов(МассивТипов);
	
	Для Каждого СтрокаИсточник из АналитикаРаскрытияФЛК Цикл
		
		КроссТаблица.Колонки.Добавить(СтрокаИсточник.ИмяРеквизита+"_Знак");
		Если СтрокаИсточник.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
			КроссТаблица.Колонки.Добавить(СтрокаИсточник.ИмяРеквизита,ОписаниеТипЧисло,СтрокаИсточник.ПредставлениеРеквизита);		
		Иначе
			КроссТаблица.Колонки.Добавить(СтрокаИсточник.ИмяРеквизита,,СтрокаИсточник.ПредставлениеРеквизита);		
		КонецЕсли;
		
		
	КонецЦикла;
	
	КроссТаблица.Колонки.Добавить("Отключено",БюджетнаяОтчетность.ПолучитьОписаниеТиповБулево());

	Запрос			= Новый Запрос;
	Запрос.Текст 	= "ВЫБРАТЬ
	             	  |	ЗначенияАналитикиФорматноЛогическогоКонтроля.ИмяРеквизита,
	             	  |	ЗначенияАналитикиФорматноЛогическогоКонтроля.НомерПроверки КАК НомерПроверки,
	             	  |	ЗначенияАналитикиФорматноЛогическогоКонтроля.ВидСравнения,
	             	  |	ЗначенияАналитикиФорматноЛогическогоКонтроля.ЗначениеСравнения,
	             	  |	ЗначенияАналитикиФорматноЛогическогоКонтроля.ЗначениеСсылка,
	             	  |	ЕстьNull(УсловияСтрокиФорматноЛогическогоКонтроля.Условие,"""") КАК Условие,
	             	  |	ЕстьNull(УсловияСтрокиФорматноЛогическогоКонтроля.Отключено,Ложь) КАК Отключено 
	             	  |ИЗ
	             	  |	РегистрСведений.ЗначенияАналитикиФорматноЛогическогоКонтроля КАК ЗначенияАналитикиФорматноЛогическогоКонтроля
	             	  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСтрокиФорматноЛогическогоКонтроля КАК УсловияСтрокиФорматноЛогическогоКонтроля
	             	  |		ПО ЗначенияАналитикиФорматноЛогическогоКонтроля.КонтрольноеСоотношение = УсловияСтрокиФорматноЛогическогоКонтроля.КонтрольноеСоотношение
	             	  |			И ЗначенияАналитикиФорматноЛогическогоКонтроля.НомерПроверки = УсловияСтрокиФорматноЛогическогоКонтроля.НомерПроверки
	             	  |ГДЕ
	             	  |	ЗначенияАналитикиФорматноЛогическогоКонтроля.КонтрольноеСоотношение = &КонтрольноеСоотношение
	             	  |
	             	  |УПОРЯДОЧИТЬ ПО
	             	  |	НомерПроверки
	             	  |ИТОГИ ПО
	             	  |	НомерПроверки";
				   
	Запрос.УстановитьПараметр("КонтрольноеСоотношение",КонтрольноеСоотношение);
	
	ВыборкаНомерПроверки		= Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Пока ВыборкаНомерПроверки.Следующий() Цикл
		
		НоваяСтрока			= КроссТаблица.Добавить();
		ДетальнаяВыборка	= ВыборкаНомерПроверки.Выбрать();
		УсловиеСтроки		= "";
		Отключено = Ложь;
		Пока ДетальнаяВыборка.Следующий() Цикл
			Если ЗначениеЗаполнено(ДетальнаяВыборка.ЗначениеСсылка) Тогда
				НоваяСтрока[ДетальнаяВыборка.ИмяРеквизита] = ДетальнаяВыборка.ЗначениеСсылка;
			Иначе
				НоваяСтрока[ДетальнаяВыборка.ИмяРеквизита] = ДетальнаяВыборка.ЗначениеСравнения;
			КонецЕсли;
			НоваяСтрока[ДетальнаяВыборка.ИмяРеквизита+"_Знак"]	= ДетальнаяВыборка.ВидСравнения;
			УсловиеСтроки										= ДетальнаяВыборка.Условие;
			Отключено											= ДетальнаяВыборка.Отключено;
		КонецЦикла;
		НоваяСтрока.Отключено = Отключено;
		НоваяСтрока.УсловиеСтроки = УсловиеСтроки;
		
	КонецЦикла;		
	
	Возврат КроссТаблица;
КонецФункции

#КонецЕсли