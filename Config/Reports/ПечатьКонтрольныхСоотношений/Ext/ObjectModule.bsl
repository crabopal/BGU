////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Функция СформироватьОтчет(ПереченьСоотношений = Неопределено, СразуВывести = Истина) Экспорт
	
	ТабДок 						= Новый ТабличныйДокумент;
	ТабДок.ОтображатьЗаголовки 	= Ложь;
	ТабДок.ОтображатьСетку		= Ложь;
	ТабДок.ТолькоПросмотр		= Истина;
	
	Данные = ВыполнитьЗапросПоПеречнюКонтрольныхСоотношений(ПереченьСоотношений);
	
	ДеревоДанных = ПодготовитьДеревоДляВыводаВДокумент(Данные);
	
	ВывестиДеревоДанныхВОтчет(ДеревоДанных,ТабДок);
	
	ВывестиКонтрольныеСоотношенияФЛК(ПереченьСоотношений,ТабДок);
		
	#Если Клиент Тогда
		Если СразуВывести Тогда
			ТабДок.Показать("Контрольные соотношения");
		КонецЕсли;
	#КонецЕсли
	
	Возврат ТабДок;

КонецФункции

// Подготавливает дерево для вывода в таблицу отчета.
//
Функция ПодготовитьДеревоДляВыводаВДокумент(РезультатЗапроса)

	Дерево = РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Дерево.Колонки.Добавить("ВыражениеЛев");
	Дерево.Колонки.Добавить("ВыражениеПрав");
	Дерево.Колонки.Добавить("Условие");
	Дерево.Колонки.Добавить("СписокИспользуемыхЛев");
	Дерево.Колонки.Добавить("СписокИспользуемыхПрав");
	
	Возврат Дерево;

КонецФункции // ПодготовитьДеревоДляВыводаВДокумент()

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Заполняет табличный документ в зависимости от режима работы отчета.
//
Процедура ВывестиДеревоДанныхВОтчет(ДеревоДанных,ТабДок)
 
	Макеты = ПолучитьМакеты();
	
	Если ДеревоДанных.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Строка0 = ДеревоДанных.Строки[0];
	Если ЗначениеЗаполнено(Строка0.КонтрольноеСоотношение) Тогда
		ВывестиСписокСоотношенийВДокумент(ДеревоДанных, ТабДок, Макеты);
	Иначе
		ВывестиВидыОтчетаВДокумент(ДеревоДанных, ТабДок, Макеты);
	КонецЕсли;

КонецПроцедуры

// Получение областей из макета обработки.
//
Функция ПолучитьМакеты()

	СтруктураМакетов = Новый Структура;
	Макет = ПолучитьМакет("МакетКонтрольныхСоотношений");
	
	СтруктураМакетов.Вставить("ОбластьЗаголовок",Макет.ПолучитьОбласть("ШапкаСоотношения"));
	СтруктураМакетов.Вставить("ОбластьФормула"  ,Макет.ПолучитьОбласть("Формула"));
	СтруктураМакетов.Вставить("ОбластьОперанд"  ,Макет.ПолучитьОбласть("СтрокаОперанд"));
	СтруктураМакетов.Вставить("ОбластьПодвал"	,Макет.ПолучитьОбласть("ПодвалСоотношения"));
	СтруктураМакетов.Вставить("ОбластьПустая"	,Макет.ПолучитьОбласть("ПустаяСтрока"));
	СтруктураМакетов.Вставить("ОбластьЗаголовокОперандов",Макет.ПолучитьОбласть("ОбластьЗаголовокОперандов"));
	СтруктураМакетов.Вставить("ОбластьВидОтчета"	 	 ,Макет.ПолучитьОбласть("ВидОтчета"));
	СтруктураМакетов.Вставить("ОбластьОрганизация"	 	 ,Макет.ПолучитьОбласть("ОрганизационнаяЕдиница"));
	СтруктураМакетов.Вставить("ОбластьПравилоПроверки"	 ,Макет.ПолучитьОбласть("ПравилоПроверки"));
	
    Возврат СтруктураМакетов;
	
КонецФункции // ПолучитьМакеты()

// Получение областей из макета обработки.
//
Функция ПолучитьМакетыФЛК()

	СтруктураМакетов = Новый Структура;
	Макет = ПолучитьМакет("МакетКонтрольныхСоотношенийФЛК");
	
	СтруктураМакетов.Вставить("ОбластьЗаголовок",Макет.ПолучитьОбласть("ШапкаСоотношения"));
	СтруктураМакетов.Вставить("ОбластьТекстТаблицы",Макет.ПолучитьОбласть("ТекстТаблицы"));
	СтруктураМакетов.Вставить("ОбластьОписаниеСоотношения",Макет.ПолучитьОбласть("ОписаниеСоотношения"));
	СтруктураМакетов.Вставить("ОбластьПустая"	,Макет.ПолучитьОбласть("ПустаяСтрока"));
	СтруктураМакетов.Вставить("ОбластьШапкаТаблицы"	 	 ,Макет.ПолучитьОбласть("КолонкаТаблицы|ШапкаТаблицы "));
	СтруктураМакетов.Вставить("ОбластьСтрокаТаблицы"	 ,Макет.ПолучитьОбласть("КолонкаТаблицы|СтрокаТаблицы"));
	СтруктураМакетов.Вставить("ОбластьСтрокаТаблицыОткл" ,Макет.ПолучитьОбласть("КолонкаТаблицы|СтрокаТаблицыОткл"));
	СтруктураМакетов.Вставить("ОбластьСтрокаУсловия"	 ,Макет.ПолучитьОбласть("КолонкаТаблицы|СтрокаТаблицыУсловия"));
	СтруктураМакетов.Вставить("ОбластьСтрокаУсловияОткл" ,Макет.ПолучитьОбласть("КолонкаТаблицы|СтрокаТаблицыУсловияОткл"));
	 
    Возврат СтруктураМакетов;
	
КонецФункции // ПолучитьМакеты()

// Выводить в табличный документ контрольные соотношения
// по форматно-логическому контролю
//
// Параметры:
//  ПереченьСоотношений	 - Массив -  список контрольных соотношений 
//  ТабДок				 - ТабличныйДокумент - для вывода на печать КС
//
Процедура ВывестиКонтрольныеСоотношенияФЛК(ПереченьСоотношений, ТабДок)
	
	
	Данные = ВыполнитьЗапросПоПеречнюКонтрольныхСоотношенийФЛК(ПереченьСоотношений);
	Макеты = ПолучитьМакетыФЛК();
	
	ОбластьЗаголовок		= Макеты.ОбластьЗаголовок;
	ОбластьОписаниеСоотношения = Макеты.ОбластьОписаниеСоотношения;
	ОбластьШапкаТаблицы		= Макеты.ОбластьШапкаТаблицы;
	ОбластьПустая			= Макеты.ОбластьПустая;
	ОбластьТекстТаблицы		= Макеты.ОбластьТекстТаблицы;
	ОбластьСтрокаТаблицы	= Макеты.ОбластьСтрокаТаблицы;
	ОбластьСтрокаТаблицыОткл= Макеты.ОбластьСтрокаТаблицыОткл;
	ОбластьСтрокаУсловия	= Макеты.ОбластьСтрокаУсловия;
	ОбластьСтрокаУсловияОткл= Макеты.ОбластьСтрокаУсловияОткл;

	

	ЦветОшибки  = WebЦвета.Красный;
	ЦветПредупреждения  = WebЦвета.Синий;
	мПустаяКартинка = Новый Картинка;
	ТипЧисло = Тип("Число");
	
	Список = Новый СписокЗначений;
	Список.Добавить("Заполнено","Заполнено",,БиблиотекаКартинок.Успешно);
	Список.Добавить("НеЗаполнено","Не заполнено",,БиблиотекаКартинок.Удалить);
	Список.Добавить("-","Отключено",,БиблиотекаКартинок.Вычитание);
	Список.Добавить("Код","Произвольный код",,БиблиотекаКартинок.ПроизвольныйКод);

	Для Каждого СтрСоотношение из Данные Цикл
		
		ОбластьЗаголовок.Параметры.ИмяСоотношения 	= СтрСоотношение.КонтрольноеСоотношение;
		ОбластьЗаголовок.Параметры.Номер		  	= СтрСоотношение.НомерСоотношения;
		ОбластьЗаголовок.Параметры.Код				= СтрСоотношение.Код;
		ОбластьЗаголовок.Параметры.ТипСоотношения	= "Форматно-логическое";
		
		ОбластьЗаголовок.Параметры.текстВидОтчета = "Вид отчета:";
		ОбластьЗаголовок.Параметры.ВидОтчета 	  = СтрСоотношение.ВидОтчета;
		
		Если СтрСоотношение.Дополнительное = Истина Тогда
			ОбластьЗаголовок.Параметры.ВидСоотношения = "Дополнительное";
			ОбластьЗаголовок.Области.ВидСоотношения.ЦветТекста = ЦветПредупреждения;
		Иначе
			ОбластьЗаголовок.Параметры.ВидСоотношения = "Обязательное";
			ОбластьЗаголовок.Области.ВидСоотношения.ЦветТекста = ЦветОшибки;
		КонецЕсли;
		
		ОбластьЗаголовок.Параметры.Пояснение = "Описание: " + СтрСоотношение.Описание;
		ТабДок.Вывести(ОбластьПустая);
		
		ТабДок.Вывести(ОбластьЗаголовок);
		
		Если СтрСоотношение.Дополнительное = Истина Тогда
			ОбластьОписаниеСоотношения.Параметры.ТекстОписания = СтрСоотношение.ТекстПояснения;
			ТабДок.Вывести(ОбластьОписаниеСоотношения);
		КонецЕсли;
		
		СтрокиПроверки = "";
		ЭтоПроверкаИтоговыхСтрок = Истина;
		ТаблицаПроверки = КроссТаблицаПроверки(СтрСоотношение.КонтрольноеСоотношение, СтрокиПроверки,ЭтоПроверкаИтоговыхСтрок);
		
		Если ТаблицаПроверки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоПроверкаИтоговыхСтрок Тогда
			ОбластьТекстТаблицы.Параметры.ВидСтроки = "итоговых показателей строк";
		Иначе
			ОбластьТекстТаблицы.Параметры.ВидСтроки = "детальных показателей группы раскрытия строки";
		КонецЕсли;
		
		ОбластьТекстТаблицы.Параметры.СтрокиОтчета = СтрЗаменить(СтрокиПроверки,";",", ");
		ТабДок.Вывести(ОбластьТекстТаблицы);
		ТабДок.НачатьГруппуСтрок();
		ПерваяКолонка = Истина;
		
		ВыхДанные = Новый Массив;
		
		//Выводим шапку таблицы
		Для Каждого Колонка из ТаблицаПроверки.Колонки Цикл
			
			Если Колонка.Имя = "Отключено" 
				ИЛИ СтрЗаканчиваетсяНа(Колонка.Имя,"_Знак") Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ Колонка.Имя = "УсловиеСтроки" Тогда
				ВыхДанные.Добавить(Колонка.Имя);
			КонецЕсли;
			
			ОбластьШапкаТаблицы.Параметры.ЗаголовокКолонки = Колонка.Заголовок;
			Если ПерваяКолонка Тогда
				ТабДок.Вывести(ОбластьШапкаТаблицы);
				ПерваяКолонка = Ложь;
			Иначе
				ТабДок.Присоединить(ОбластьШапкаТаблицы);
			КонецЕсли;
			
		КонецЦикла;
				
		//Выводим данные таблицы
		Для Каждого СтрЗначений Из ТаблицаПроверки Цикл
			
			Отключено = СтрЗначений.Отключено;
			
			ОбластьСтроки = "";
			ИмяЯчейки = "";
			
			Если Отключено Тогда
				ОбластьСтроки = ОбластьСтрокаТаблицыОткл;
				ИмяЯчейки = "ЗнакСравненияОткл";
			Иначе 
				ОбластьСтроки = ОбластьСтрокаТаблицы;
				ИмяЯчейки = "ЗнакСравнения";
			КонецЕсли;
			
			//Вывод условия строки
			Если Отключено Тогда
				ОбластьСтрокаУсловияОткл.Параметры.ЗначениеСравнения = СтрЗначений.УсловиеСтроки;
				ТабДок.Вывести(ОбластьСтрокаУсловияОткл);
			Иначе 
				ОбластьСтрокаУсловия.Параметры.ЗначениеСравнения = СтрЗначений.УсловиеСтроки;
				ТабДок.Вывести(ОбластьСтрокаУсловия);
			КонецЕсли;
		
			//Вывод значений строки таблицы
			Для Каждого Имя из ВыхДанные Цикл
				ЗнакСравнения = СтрЗначений[Имя+"_Знак"];
				Элемент = Список.НайтиПоЗначению(ЗнакСравнения);
				Если Элемент = Неопределено Тогда
					ОбластьСтроки.Области[ИмяЯчейки].Картинка = мПустаяКартинка;
					ОбластьСтроки.Параметры.ВидСравнения = ЗнакСравнения;
				Иначе
					ОбластьСтроки.Области[ИмяЯчейки].Картинка = Элемент.Картинка;
					ОбластьСтроки.Параметры.ВидСравнения = "";
				КонецЕсли;
				
				Если ЗнакСравнения = "Заполнено" Тогда
					ОбластьСтроки.Параметры.ЗначениеСравнения = "<Заполнено>";
				ИначеЕсли ЗнакСравнения = "НеЗаполнено" Тогда
					ОбластьСтроки.Параметры.ЗначениеСравнения = "<НЕ заполнено>";
				ИначеЕсли ЗнакСравнения = "-" Тогда
					ОбластьСтроки.Параметры.ЗначениеСравнения = "<Отключено>";
				Иначе
					ЗначениеСравнения = СтрЗначений[Имя];
					Если НЕ ЗначениеЗаполнено(ЗначениеСравнения) 
						И ТипЗнч(ЗначениеСравнения) = ТипЧисло Тогда
						ОбластьСтроки.Параметры.ЗначениеСравнения = "0";
					Иначе 
						ОбластьСтроки.Параметры.ЗначениеСравнения = СтрЗначений[Имя];
					КонецЕсли;
			    КонецЕсли;
			
				ТабДок.Присоединить(ОбластьСтроки);
			КонецЦикла;
			
		КонецЦикла;
		ТабДок.ЗакончитьГруппуСтрок();
	КонецЦикла;
	
		
КонецПроцедуры

// Процедура формирования области списка соотношений.
//
Процедура ВывестиСписокСоотношенийВДокумент(ТаблицаСоотношений, ТабДок, Макеты)

	ОбластьЗаголовок = Макеты.ОбластьЗаголовок;
	ОбластьФормула	 = Макеты.ОбластьФормула;
	ОбластьОперанд	 = Макеты.ОбластьОперанд;
	ОбластьПодвал	 = Макеты.ОбластьПодвал;
	ОбластьПустая	 = Макеты.ОбластьПустая;
	ОбластьЗаголовокОперандов = Макеты.ОбластьЗаголовокОперандов;
		
	ЦветОшибки  = WebЦвета.Красный;
	ЦветПредупреждения  = WebЦвета.Синий;
	
	Для Каждого СтрСоотношение Из ТаблицаСоотношений.Строки Цикл
		
		Если СтрСоотношение.КонтрольноеСоотношение = Null Тогда
			Продолжить;
		КонецЕсли;
		
		
		
		БюджетнаяОтчетность.РазобратьКонтрольноеСоотношение(СтрСоотношение);
		
		ОбластьЗаголовок.Параметры.ИмяСоотношения 	= СтрСоотношение.КонтрольноеСоотношение;
		ОбластьЗаголовок.Параметры.Номер		  	= СтрСоотношение.НомерСоотношения;
		ОбластьЗаголовок.Параметры.Код				= СтрСоотношение.Код;
		ОбластьЗаголовок.Параметры.ТипСоотношения	= СтрСоотношение.ТипСоотношения;
				
		Если СтрСоотношение.ТипСоотношения = "Внутриформенное" Тогда
			ОбластьЗаголовок.Параметры.текстВидОтчета = "Вид отчета:";
			ОбластьЗаголовок.Параметры.ВидОтчета 	  = СтрСоотношение.ВидОтчета;
			ОбластьЗаголовок.Области.текстВидаОтчета.ВысотаСтроки = 0;
		Иначе
			ОбластьЗаголовок.Параметры.текстВидОтчета = "";
			ОбластьЗаголовок.Параметры.ВидОтчета = "";
			ОбластьЗаголовок.Области.текстВидаОтчета.ВысотаСтроки = 1;
		КонецЕсли;
		
		Если СтрСоотношение.Дополнительное = Истина Тогда
			ОбластьЗаголовок.Параметры.ВидСоотношения = "Дополнительное";
			ОбластьЗаголовок.Области.ВидСоотношения.ЦветТекста = ЦветПредупреждения;
		Иначе
			ОбластьЗаголовок.Параметры.ВидСоотношения = "Обязательное";
			ОбластьЗаголовок.Области.ВидСоотношения.ЦветТекста = ЦветОшибки;
		КонецЕсли;
		
		//Вывод Пояснение КС
		Если НЕ ПустаяСтрока(СтрСоотношение.ТекстПояснения) Тогда
			ОбластьЗаголовок.Параметры.ТекстОписания = СтрСоотношение.ТекстПояснения;
			ОбластьЗаголовок.Области.Пояснение.ВысотаСтроки = 0;
		Иначе 
			ОбластьЗаголовок.Параметры.ТекстОписания = "";
			ОбластьЗаголовок.Области.Пояснение.ВысотаСтроки = 1;
		КонецЕсли;
		
		//Вывод описания КС
		Если НЕ ПустаяСтрока(СтрСоотношение.Описание) Тогда
			ОбластьЗаголовок.Параметры.Пояснение = "Описание: " + СтрСоотношение.Описание;
			ОбластьЗаголовок.Области.Описание.ВысотаСтроки = 0;
		Иначе 
			ОбластьЗаголовок.Параметры.Пояснение = "";
			ОбластьЗаголовок.Области.Описание.ВысотаСтроки = 1;
		КонецЕсли;
		
		ТабДок.Вывести(ОбластьПустая);
		
		ТабДок.Вывести(ОбластьЗаголовок);
		ТабДок.НачатьГруппуСтрок();
		Операнды = СтрСоотношение.Строки;
		
		ФормулаЛев  = ЗаменитьКодыВФормуле(СтрСоотношение.ВыражениеЛев	,СтрСоотношение.СписокИспользуемыхЛев	,Операнды);
		ФормулаПрав = ЗаменитьКодыВФормуле(СтрСоотношение.ВыражениеПрав	,СтрСоотношение.СписокИспользуемыхПрав	,Операнды);
		
		ОбластьФормула.Параметры.ВыражениеЛев  = ФормулаЛев;
		ОбластьФормула.Параметры.ВыражениеПрав = ФормулаПрав;
		ОбластьФормула.Параметры.Условие	   = СтрСоотношение.Условие;
		
		ТабДок.Вывести(ОбластьФормула);
		
		Если ВыводитьОперанды Тогда
			
			ТабДок.Вывести(ОбластьЗаголовокОперандов);
			
			КоличествоСтрокОперанды = Макс(СтрСоотношение.СписокИспользуемыхЛев.Количество(),СтрСоотношение.СписокИспользуемыхПрав.Количество());
			
			Для Сч = 0 По КоличествоСтрокОперанды-1 Цикл
				
				Если Сч < СтрСоотношение.СписокИспользуемыхЛев.Количество() Тогда
					
					СтрОперанд = Операнды.Найти(СтрСоотношение.СписокИспользуемыхЛев[Сч].Значение,"КодОперанда");
					
					Если Не СтрОперанд = Неопределено Тогда
						Значение = СтрОперанд.Операнд;
					Иначе
						Значение = СтрСоотношение.СписокИспользуемыхЛев[Сч].Значение;
					КонецЕсли;
					ОбластьОперанд.Параметры.ОперандЛев = Значение;
					
				Иначе
					ОбластьОперанд.Параметры.ОперандЛев = "";
				КонецЕсли;
				
				Если Сч < СтрСоотношение.СписокИспользуемыхПрав.Количество() Тогда
					
					СтрОперанд = Операнды.Найти(СтрСоотношение.СписокИспользуемыхПрав[Сч].Значение,"КодОперанда");
					
					Если Не СтрОперанд = Неопределено Тогда
						Значение = СтрОперанд.Операнд;
					Иначе
						Значение = СтрСоотношение.СписокИспользуемыхПрав[Сч].Значение;
					КонецЕсли;
					ОбластьОперанд.Параметры.ОперандПрав = Значение;
					
				Иначе
					ОбластьОперанд.Параметры.ОперандПрав = "";
				КонецЕсли;
				
				ТабДок.Вывести(ОбластьОперанд);
				
			КонецЦикла;
			
		КонецЕсли;
		
		ТабДок.Вывести(ОбластьПодвал);
		
		ТабДок.ЗакончитьГруппуСтрок();
		
		
	КонецЦикла;
	
	
	
КонецПроцедуры

// Процедура формирования секции вида отчета и правила проверки.
//
Процедура ВывестиВидыОтчетаВДокумент(ДеревоДанных, ТабДок, Макеты)

	// Виды отчета:
	Для Каждого СтрВидОтчета Из ДеревоДанных.Строки Цикл
		
		Макеты.ОбластьВидОтчета.Параметры.ВидОтчета = СтрВидОтчета.ВидОтчета;
		ТабДок.Вывести(Макеты.ОбластьВидОтчета);
		
		ТабДок.НачатьГруппуСтрок();
		
		// Организационные единицы.
		Для Каждого СтрОрганизация Из СтрВидОтчета.Строки Цикл
			
			Если Не ЗначениеЗаполнено(СтрОрганизация.Организация) Тогда
				ТекстОрганизация = "Все организационные единицы";
			Иначе
				ТекстОрганизация = СтрОрганизация.Организация;
			КонецЕсли;
			
			Макеты.ОбластьОрганизация.Параметры.ОрганизационнаяЕдиница = ТекстОрганизация;
			ТабДок.Вывести(Макеты.ОбластьОрганизация);
			
			ТабДок.НачатьГруппуСтрок();
			
			// Правила проверки.
			Для Каждого СтрПравилоПроверки Из СтрОрганизация.Строки Цикл
				
				Если ЗначениеЗаполнено(СтрПравилоПроверки.ПравилоПроверки) Тогда
					
					Макеты.ОбластьПравилоПроверки.Параметры.ПравилоПроверки = СтрПравилоПроверки.ПравилоПроверки;
					ТабДок.Вывести(Макеты.ОбластьПравилоПроверки);
					
					// Контрольные соотношения.
					ВывестиСписокСоотношенийВДокумент(СтрПравилоПроверки, ТабДок, Макеты);
				Иначе
					Макеты.ОбластьПравилоПроверки.Параметры.ПравилоПроверки = "<Не указано>";
					ТабДок.Вывести(Макеты.ОбластьПравилоПроверки);
				КонецЕсли;
				
			КонецЦикла;
			
			ТабДок.ЗакончитьГруппуСтрок();
			
		КонецЦикла;
		
		ТабДок.ЗакончитьГруппуСтрок();
		
	КонецЦикла;

КонецПроцедуры

Функция ВыполнитьЗапросПоПеречнюКонтрольныхСоотношений(ПереченьСоотношений)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтрольныеСоотношения.Ссылка КАК КонтрольноеСоотношение,
	|	КонтрольныеСоотношения.Процедура,
	|	КонтрольныеСоотношения.Код,
	|	КонтрольныеСоотношения.Дополнительное,
	|	КонтрольныеСоотношения.ТекстПояснения,
	|	КонтрольныеСоотношения.Описание,
	|	КонтрольныеСоотношения.НомерСоотношения,
	|	ВЫБОР
	|		КОГДА КонтрольныеСоотношения.ПоказателиТекущегоОтчета
	|			ТОГДА ""Внутриформенное""
	|		ИНАЧЕ ""Межформенное""
	|	КОНЕЦ КАК ТипСоотношения,
	|	ОперандыПоказателей.Код КАК КодОперанда,
	|	ОперандыПоказателей.Наименование КАК ОперандНаименование,
	|	ОперандыПоказателей.Ссылка КАК Операнд,
	|	КонтрольныеСоотношения.ВидОтчета
	|ИЗ
	|	Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОперандыПоказателей КАК ОперандыПоказателей
	|		ПО КонтрольныеСоотношения.Ссылка = ОперандыПоказателей.Владелец
	|ГДЕ
	|	КонтрольныеСоотношения.ЭтоГруппа = ЛОЖЬ
	|	И КонтрольныеСоотношения.ВидКонтрольногоСоотношения <> ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.ФЛК)";
	
	Если ПереченьСоотношений <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "		
		|	И КонтрольныеСоотношения.Ссылка В ИЕРАРХИИ(&ПереченьСоотношений)";
		
		Запрос.УстановитьПараметр("ПереченьСоотношений",ПереченьСоотношений);
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
	|ИТОГИ ПО
	|	КонтрольноеСоотношение";
	
	Возврат Запрос.Выполнить();

КонецФункции // ВыполнитьЗапросПоПеречнюКонтрольныхСоотношений()

Функция ЗаменитьКодыВФормуле(Знач ИсходнаяФормула,СписокОперандов,ЗначенияОперандов)
 
	Для Каждого Операнд Из СписокОперандов Цикл
		
		СтрОперанд = ЗначенияОперандов.Найти(Операнд.Значение,"КодОперанда");
		Если Не СтрОперанд = Неопределено Тогда
			ИсходнаяФормула = СтрЗаменить(ИсходнаяФормула,"["+СокрП(Операнд.Значение)+"]","["+СокрП(СтрОперанд.ОперандНаименование)+"]");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ИсходнаяФормула;

КонецФункции // ЗаменитьКодыВФормуле()

