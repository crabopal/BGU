
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтандартныеОтчеты.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
    СтандартныеОтчеты.ЗаполнитьПодписиПоУмолчанию(Отчет.Подписи);
	
	Если Отчет.РежимРасшифровки Тогда
		Если Не ЗначениеЗаполнено(Отчет.ПоказательБУ) Тогда
			Отчет.ПоказательБУ = Истина;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Отчет.ПоказательКоличество) Тогда
			Отчет.ПоказательКоличество = Истина;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Отчет.ПоказательВалютнаяСумма) Тогда
			Отчет.ПоказательВалютнаяСумма = Истина;
		КонецЕсли;
	КонецЕсли;
	УстановитьЗначенияПоФункциональнымОпциям();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СтандартныеОтчетыКлиент.ПриОткрытии(ЭтаФорма);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
	РассчитатьПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	СтандартнаяОбработка = НЕ Отчет.РежимРасшифровки;
	
	ВариантМодифицирован                    = Ложь;
	ПользовательскиеНастройкиМодифицированы = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	ДопРеквизитыФормы = Новый Структура("ПоказыватьИФО,ПоказыватьКФО,ПоказыватьКЭК,ПоказыватьКПС,ПоказыватьОрганизацию,ПоказыватьХарактеристикиДвижения,ПоказыватьЖурналОпераций",
									ПоказыватьИФО,ПоказыватьКФО,ПоказыватьКЭК,ПоказыватьКПС,ПоказыватьОрганизацию,ПоказыватьХарактеристикиДвижения,ПоказыватьЖурналОпераций);
	СтандартныеОтчеты.ПриСохраненииПользовательскихНастроекНаСервере(ЭтаФорма, Настройки,,ДопРеквизитыФормы);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
	СтандартныеОтчеты.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	УстановитьЗначенияПоФункциональнымОпциям();
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	СтандартныеОтчеты.ДобавитьОтборПоОрганизации(ЭтаФорма.Отчет);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	СтандартныеОтчетыКлиентСервер.ИзменитьОтборПоОрганизации(Отчет);
    СтандартныеОтчетыКлиент.ПриИзмененииОрганизации(Отчет.Организация, Отчет.Подписи);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	ИзменениеКонтроловВлияющееНаРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартныеОтчетыКлиент.ОбработкаРасшифровкиСтандартногоОтчета(ЭтаФорма, Элемент, Расшифровка, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	// Не будем обрабатывать нажатие на правую кнопку мыши.
	// Покажем стандартное контекстное меню ячейки табличного документа.
	Расшифровка = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент)
		
	ПодключитьОбработчикОжидания("РассчитатьПоказателиДинамически", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ИзменениеПериода(Элемент)
	
	СтандартныеОтчетыКлиент.УстановитьВидМежотчетногоПериодаПоДате(Отчет);
	
    СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПериодаПриИзменении(Элемент)
	
	СтандартныеОтчетыКлиент.УстановитьДатыПоВидуПериода(Отчет);
	
	Модифицированность = Истина;
	
	ОбновитьТекстЗаголовка(ЭтотОбъект);
		
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);

	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоУказанныйПериодПриИзменении(Элемент)
	
	
	СтандартныеОтчетыКлиент.УстановитьДатыПоВидуПериода(Отчет);
	
	Модифицированность = Истина;
	
	ОбновитьТекстЗаголовка(ЭтотОбъект);
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);
	
КонецПроцедуры

