	|	ЕСТЬNULL(ГрафикАмортизацииДолгосрочныйПериодСРезервами.АмортизацияРуб, 0) КАК ГрафикАмортизацииДолгосрочныйПериод,
	|	ЕСТЬNULL(ПраваПользованияБУ.БалансоваяСтоимость, 0) - ЕСТЬNULL(АмортизацияПравПользованияБУ.Амортизация, 0) - ЕСТЬNULL(ОбесценениеПравПользованияБУ.Обесценение, 0) - ЕСТЬNULL(ГрафикАмортизацииКраткосрочныйПериодСРезервами.АмортизацияРуб, 0) КАК Долгосрочные
	|ИЗ
	|	ПраваПользованияБУ КАК ПраваПользованияБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ АмортизацияПравПользованияБУ КАК АмортизацияПравПользованияБУ
	|		ПО ПраваПользованияБУ.ОсновноеСредство = АмортизацияПравПользованияБУ.ОсновноеСредство
	|			И ПраваПользованияБУ.ИФО = АмортизацияПравПользованияБУ.ИФО
	|			И ПраваПользованияБУ.КФО = АмортизацияПравПользованияБУ.КФО
	|			И ПраваПользованияБУ.КПС = АмортизацияПравПользованияБУ.КПС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОбесценениеПравПользованияБУ КАК ОбесценениеПравПользованияБУ
	|		ПО ПраваПользованияБУ.ОсновноеСредство = ОбесценениеПравПользованияБУ.ОсновноеСредство
	|			И ПраваПользованияБУ.ИФО = ОбесценениеПравПользованияБУ.ИФО
	|			И ПраваПользованияБУ.КФО = ОбесценениеПравПользованияБУ.КФО
	|			И ПраваПользованияБУ.КПС = ОбесценениеПравПользованияБУ.КПС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ГрафикАмортизацииКраткосрочныйПериодСРезервами КАК ГрафикАмортизацииКраткосрочныйПериодСРезервами
	|		ПО ПраваПользованияБУ.ОсновноеСредство = ГрафикАмортизацииКраткосрочныйПериодСРезервами.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ГрафикАмортизацииДолгосрочныйПериодСРезервами КАК ГрафикАмортизацииДолгосрочныйПериодСРезервами
	|		ПО ПраваПользованияБУ.ОсновноеСредство = ГрафикАмортизацииДолгосрочныйПериодСРезервами.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЕстьГрафикАмортизацииПравПользованияОС КАК ЕстьГрафикАмортизацииПравПользованияОС
	|		ПО ПраваПользованияБУ.ОсновноеСредство = ЕстьГрафикАмортизацииПравПользованияОС.ОсновноеСредство
	|ГДЕ
	|	&УсловиеТолькоОбъектыСОстаточнойСтоимостью
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетУчета,
	|	ПраваПользованияБУ.ОсновноеСредство.Наименование,
	|	ИФО,
	|	КФО,
	|	КПС";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ПараметрыОтбора.Свойство("ИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИФО В (&ИФО)");
		Запрос.УстановитьПараметр("ИФО", ПараметрыОтбора.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИСТИНА");
	КонецЕсли;
	Если ПараметрыОтбора.Свойство("КФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "КФО В (&КФО)");
		Запрос.УстановитьПараметр("КФО", ПараметрыОтбора.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "ИСТИНА");
	КонецЕсли;
	Если ПараметрыОтбора.Свойство("ОсновноеСредство") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоОС", "Субконто1 В (&ОсновноеСредство)");
		Запрос.УстановитьПараметр("ОсновноеСредство", ПараметрыОтбора.ОсновноеСредство);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоОС", "ИСТИНА");
	КонецЕсли;
	Если ПараметрыОтбора.Свойство("СчетУчета") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСчетуУчета", "Счет В ИЕРАРХИИ (&СчетУчета)");
		Запрос.УстановитьПараметр("СчетУчета", ПараметрыОтбора.СчетУчета);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСчетуУчета", "ИСТИНА");
	КонецЕсли;
	Если ПараметрыОтбора.Свойство("ТолькоОбъектыСОстаточнойСтоимостью") И ПараметрыОтбора.ТолькоОбъектыСОстаточнойСтоимостью Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТолькоОбъектыСОстаточнойСтоимостью",
			"ЕСТЬNULL(ПраваПользованияБУ.БалансоваяСтоимость, 0) - ЕСТЬNULL(АмортизацияПравПользованияБУ.Амортизация, 0) - ЕСТЬNULL(ОбесценениеПравПользованияБУ.Обесценение, 0) <> 0");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТолькоОбъектыСОстаточнойСтоимостью", "ИСТИНА");
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция РассчитатьДолгосрочныеПраваПользованияНМА(Организация, НаДату, ПараметрыОтбора) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НаДату", Новый Граница(КонецДня(НаДату), ВидГраницы.Включая));
	
	ЭтоЗаполнениеНаНачалоГода = (НаДату = НачалоГода(НаДату));
	Если ЭтоЗаполнениеНаНачалоГода Тогда // При заполнении на начало года 01.01.20ХХ остатки получаем на конец предыдущего года с операциями межотчетного периода.
		Запрос.УстановитьПараметр("КонецПериода", БухгалтерскийУчет.КонецПериодаСУточнением(НаДату - 1, Перечисления.ВидыМежотчетногоПериода.ИзменениеВалютыБаланса));
	Иначе
		Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(НаДату), ВидГраницы.Включая));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Счета11160", БухгалтерскийУчет.СписокСчетов("111.60"));
	Запрос.УстановитьПараметр("Счета10460", БухгалтерскийУчет.СписокСчетов("104.60"));
	Запрос.УстановитьПараметр("Счета11460", БухгалтерскийУчет.СписокСчетов("114.60"));
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("ПраваПользованияБУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("АмортизацияПравПользованияБУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОбесценениеПравПользованияБУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВводВЭксплуатацию", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаПраваПользования", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЕПСБУОстатки.СуммаОстатокДт КАК БалансоваяСтоимость
	|ПОМЕСТИТЬ ПраваПользованияБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&Счета11160)
	|				И &УсловиеПоСчетуУчета,
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКФО
	|				И &УсловиеПоОС) КАК ЕПСБУОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ЕПСБУОстатки.СуммаОстатокКт КАК Амортизация
	|ПОМЕСТИТЬ АмортизацияПравПользованияБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&Счета10460),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКФО
	|				И &УсловиеПоОС) КАК ЕПСБУОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ЕПСБУОстатки.СуммаОстатокКт КАК Обесценение
	|ПОМЕСТИТЬ ОбесценениеПравПользованияБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&Счета11460),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКФО
	|				И &УсловиеПоОС) КАК ЕПСБУОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	МАКСИМУМ(СобытияОС.ДатаСобытия) КАК ДатаВводаВЭксплуатацию
	|ПОМЕСТИТЬ ВводВЭксплуатацию
	|ИЗ
	|	РегистрСведений.СобытияОС КАК СобытияОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПраваПользованияБУ КАК СписокОС
	|		ПО СобытияОС.ОсновноеСредство = СписокОС.ОсновноеСредство
	|			И (СобытияОС.Организация = &Организация)
	|			И (СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию))
	|
	|СГРУППИРОВАТЬ ПО
	|	СобытияОС.ОсновноеСредство
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетАмортизацииОС.ОсновноеСредство КАК ОсновноеСредство,
	|	РасчетАмортизацииОС.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	РасчетАмортизацииОС.СрокИспользованияДляВычисленияАмортизации КАК СрокИспользованияДляВычисленияАмортизации,
	|	РасчетАмортизацииОС.СтоимостьДляВычисленияАмортизации КАК СтоимостьДляВычисленияАмортизации,
	|	РасчетАмортизацииОС.КоэффициентУскорения КАК КоэффициентУскорения,
	|	РасчетАмортизацииОС.ПараметрВыработки КАК ПараметрВыработки,
	|	РасчетАмортизацииОС.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработки
	|ПОМЕСТИТЬ ПараметрыАмортизации
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|			&НаДату,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ПраваПользованияБУ.ОсновноеСредство КАК ОсновноеСредство
	|					ИЗ
	|						ПраваПользованияБУ КАК ПраваПользованияБУ)) КАК РасчетАмортизацииОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПраваПользованияБУ.Организация КАК Организация,
	|	ПраваПользованияБУ.ИФО КАК ИФО,
	|	ПраваПользованияБУ.КФО КАК КФО,
	|	ПраваПользованияБУ.КПС КАК КПС,
	|	ПраваПользованияБУ.ОсновноеСредство КАК ОсновноеСредство,
	|	ПраваПользованияБУ.СчетУчета КАК СчетУчета,
	|	ПраваПользованияБУ.БалансоваяСтоимость КАК БалансоваяСтоимость,
	|	ЕСТЬNULL(АмортизацияПравПользованияБУ.Амортизация, 0) КАК Амортизация,
	|	ЕСТЬNULL(ОбесценениеПравПользованияБУ.Обесценение, 0) КАК Обесценение,
	|	ЕСТЬNULL(ПраваПользованияБУ.БалансоваяСтоимость, 0) - ЕСТЬNULL(АмортизацияПравПользованияБУ.Амортизация, 0) - ЕСТЬNULL(ОбесценениеПравПользованияБУ.Обесценение, 0) КАК ОстаточнаяСтоимость,
	|	ЕСТЬNULL(ВводВЭксплуатацию.ДатаВводаВЭксплуатацию, &ПустаяДата) КАК ДатаВводаВЭксплуатацию,
	|	ПараметрыАмортизации.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	ПараметрыАмортизации.СрокИспользованияДляВычисленияАмортизации КАК СрокИспользованияДляВычисленияАмортизации,
	|	ПараметрыАмортизации.СтоимостьДляВычисленияАмортизации КАК СтоимостьДляВычисленияАмортизации,
	|	ПараметрыАмортизации.КоэффициентУскорения КАК КоэффициентУскорения,
	|	ПараметрыАмортизации.ПараметрВыработки КАК ПараметрВыработки,
	|	ПараметрыАмортизации.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработки
	|ИЗ
	|	ПраваПользованияБУ КАК ПраваПользованияБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ АмортизацияПравПользованияБУ КАК АмортизацияПравПользованияБУ
	|		ПО ПраваПользованияБУ.ОсновноеСредство = АмортизацияПравПользованияБУ.ОсновноеСредство
	|			И ПраваПользованияБУ.ИФО = АмортизацияПравПользованияБУ.ИФО
	|			И ПраваПользованияБУ.КФО = АмортизацияПравПользованияБУ.КФО
	|			И ПраваПользованияБУ.КПС = АмортизацияПравПользованияБУ.КПС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОбесценениеПравПользованияБУ КАК ОбесценениеПравПользованияБУ
	|		ПО ПраваПользованияБУ.ОсновноеСредство = ОбесценениеПравПользованияБУ.ОсновноеСредство
	|			И ПраваПользованияБУ.ИФО = ОбесценениеПравПользованияБУ.ИФО
	|			И ПраваПользованияБУ.КФО = ОбесценениеПравПользованияБУ.КФО
	|			И ПраваПользованияБУ.КПС = ОбесценениеПравПользованияБУ.КПС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВводВЭксплуатацию КАК ВводВЭксплуатацию
	|		ПО ПраваПользованияБУ.ОсновноеСредство = ВводВЭксплуатацию.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыАмортизации КАК ПараметрыАмортизации
	|		ПО ПраваПользованияБУ.ОсновноеСредство = ПараметрыАмортизации.ОсновноеСредство
	|ГДЕ
	|	&УсловиеТолькоОбъектыСОстаточнойСтоимостью
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетУчета,
	|	ПраваПользованияБУ.ОсновноеСредство.Наименование,
	|	ИФО,
	|	КФО,
	|	КПС";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ПараметрыОтбора.Свойство("ИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИФО В (&ИФО)");
		Запрос.УстановитьПараметр("ИФО", ПараметрыОтбора.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИСТИНА");
	КонецЕсли;
	Если ПараметрыОтбора.Свойство("КФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "КФО В (&КФО)");
		Запрос.УстановитьПараметр("КФО", ПараметрыОтбора.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "ИСТИНА");
	КонецЕсли;
	Если ПараметрыОтбора.Свойство("ОсновноеСредство") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоОС", "Субконто1 В (&ОсновноеСредство)");
		Запрос.УстановитьПараметр("ОсновноеСредство", ПараметрыОтбора.ОсновноеСредство);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоОС", "ИСТИНА");
	КонецЕсли;
	Если ПараметрыОтбора.Свойство("СчетУчета") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСчетуУчета", "Счет В ИЕРАРХИИ (&СчетУчета)");
		Запрос.УстановитьПараметр("СчетУчета", ПараметрыОтбора.СчетУчета);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСчетуУчета", "ИСТИНА");
	КонецЕсли;
	Если ПараметрыОтбора.Свойство("ТолькоОбъектыСОстаточнойСтоимостью") И ПараметрыОтбора.ТолькоОбъектыСОстаточнойСтоимостью Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТолькоОбъектыСОстаточнойСтоимостью",
			"ЕСТЬNULL(ПраваПользованияБУ.БалансоваяСтоимость, 0) - ЕСТЬNULL(АмортизацияПравПользованияБУ.Амортизация, 0) - ЕСТЬNULL(ОбесценениеПравПользованияБУ.Обесценение, 0) <> 0");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеТолькоОбъектыСОстаточнойСтоимостью", "ИСТИНА");
	КонецЕсли;
	
	ТаблицаПраваПользования = Запрос.Выполнить().Выгрузить();
	
	ТаблицаПраваПользования.Колонки.Добавить("ОставшийсяСрокПолезногоИспользования",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаПраваПользования.Колонки.Добавить("Долгосрочные",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	
	Для Каждого СтрокаТаблицы Из ТаблицаПраваПользования Цикл
		
		ЭтоНеопределенныйСрокПользования = Не ЗначениеЗаполнено(СтрокаТаблицы.СрокПолезногоИспользования);
		
		Если ЭтоНеопределенныйСрокПользования Тогда
			// Увеличение стоимости неисключительных прав на результаты интеллектуальной деятельности с неопределенным сроком полезного использования.
			// Согласно Письму Минфина России от 3 мая 2024 г. N 02-06-08/41605 классифицируются как краткосрочные (оборотные) активы.
			СтрокаТаблицы.Долгосрочные = 0;
			
		Иначе
			
			Если ЭтоЗаполнениеНаНачалоГода Тогда // При заполнении на начало года 01.01.20ХХ остатки получаем на конец предыдущего года с операциями межотчетного периода.
				ДатаРасчета = КонецДня(НачалоГода(НаДату) - 1); // Поэтому и оставшийся срок полезного использования определяем на 31.12.20ХХ предыдущего года.
			Иначе
				ДатаРасчета = КонецДня(НаДату);
			КонецЕсли;
			СтрокаТаблицы.ОставшийсяСрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.ОставшийсяСрокПолезногоИспользования(
				СтрокаТаблицы.ДатаВводаВЭксплуатацию, СтрокаТаблицы.СрокПолезногоИспользования, ДатаРасчета);
			
			// Расчет долгосрочной части прав пользования НМА (111.60).
			Если СтрокаТаблицы.ОставшийсяСрокПолезногоИспользования > 0
				И СтрокаТаблицы.ОставшийсяСрокПолезногоИспользования <= 12 Тогда
				СтрокаТаблицы.Долгосрочные = 0; // Краткосрочные (оборотные) активы.
			ИначеЕсли СтрокаТаблицы.ОставшийсяСрокПолезногоИспользования = 0
				И СтрокаТаблицы.СрокИспользованияДляВычисленияАмортизации = 0 Тогда // Нет данных для расчета.
				СтрокаТаблицы.Долгосрочные = 0; // Краткосрочные (оборотные) активы.
			Иначе
				Если ЗначениеЗаполнено(СтрокаТаблицы.СрокИспользованияДляВычисленияАмортизации)
					И ЗначениеЗаполнено(СтрокаТаблицы.СтоимостьДляВычисленияАмортизации) Тогда
					СтоимостьОдногоМесяцаПользования = СтрокаТаблицы.СтоимостьДляВычисленияАмортизации / СтрокаТаблицы.СрокИспользованияДляВычисленияАмортизации;
				ИначеЕсли СтрокаТаблицы.ОставшийсяСрокПолезногоИспользования = 0 Тогда
					СтоимостьОдногоМесяцаПользования = 0;
				Иначе
					СтоимостьОдногоМесяцаПользования = СтрокаТаблицы.ОстаточнаяСтоимость / СтрокаТаблицы.ОставшийсяСрокПолезногоИспользования;
				КонецЕсли;
				СтрокаТаблицы.Долгосрочные = Макс(0, СтрокаТаблицы.ОстаточнаяСтоимость - СтоимостьОдногоМесяцаПользования * 12);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаПраваПользования;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//   Настройки - Структура - см. возвращаемое значение ФункцииОтчетовКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию().
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.РазрешеноИзменятьСтруктуру = Ложь;
	Настройки.РазрешеноИзменятьВарианты = Ложь;
	Настройки.Печать.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	// Получение данных отчета.
	ПараметрОрганизация = Настройки.ПараметрыДанных.Элементы.Найти("Организация");
	Организация = ПараметрОрганизация.Значение;
	
	ПараметрОтчетныйПериод = Настройки.ПараметрыДанных.Элементы.Найти("ОтчетныйПериод");
	ОтчетныйПериод = ПараметрОтчетныйПериод.Значение;
	РеквизитыОтчетногоПериода = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтчетныйПериод, "ДатаНачала,ДатаОкончания");
	НачалоПериода = КонецМесяца(НачалоМесяца(РеквизитыОтчетногоПериода.ДатаНачала) - 1);
	КонецПериода = КонецМесяца(РеквизитыОтчетногоПериода.ДатаОкончания);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрКФО = Настройки.ПараметрыДанных.Элементы.Найти("КФО");
	Если ПараметрКФО <> Неопределено И ПараметрКФО.Использование Тогда
		ПараметрыОтбора.Вставить("КФО", ПараметрКФО.Значение);
	КонецЕсли;
	ПараметрСчетУчета = Настройки.ПараметрыДанных.Элементы.Найти("СчетУчета");
	Если ПараметрСчетУчета <> Неопределено И ПараметрСчетУчета.Использование Тогда
		ПараметрыОтбора.Вставить("СчетУчета", ПараметрСчетУчета.Значение);
	КонецЕсли;
	ПараметрОсновноеСредство = Настройки.ПараметрыДанных.Элементы.Найти("ОсновноеСредство");
	Если ПараметрОсновноеСредство <> Неопределено И ПараметрОсновноеСредство.Использование Тогда
		ПараметрыОтбора.Вставить("ОсновноеСредство", ПараметрОсновноеСредство.Значение);
	КонецЕсли;
	ПараметрТолькоОбъектыСОстаточнойСтоимостью = Настройки.ПараметрыДанных.Элементы.Найти("ТолькоОбъектыСОстаточнойСтоимостью");
	Если ПараметрТолькоОбъектыСОстаточнойСтоимостью <> Неопределено Тогда
		ПараметрыОтбора.Вставить("ТолькоОбъектыСОстаточнойСтоимостью", ПараметрТолькоОбъектыСОстаточнойСтоимостью.Значение);
	КонецЕсли;
	
	// Права пользования ОС, НПА (111.40).
	ПраваПользованияОСНачалоПериода = РассчитатьДолгосрочныеПраваПользованияОС(Организация, НачалоПериода, ПараметрыОтбора);
	ПраваПользованияОСКонецПериода = РассчитатьДолгосрочныеПраваПользованияОС(Организация, КонецПериода, ПараметрыОтбора);
	
	ПраваПользованияОСНачалоПериода.Колонки.Добавить("ВидОстатка", Новый ОписаниеТипов("Строка"));
	ПраваПользованияОСНачалоПериода.ЗаполнитьЗначения(НСтр("ru = 'На начало периода'"), "ВидОстатка");
	ПраваПользованияОСКонецПериода.Колонки.Добавить("ВидОстатка", Новый ОписаниеТипов("Строка"));
	ПраваПользованияОСКонецПериода.ЗаполнитьЗначения(НСтр("ru = 'На конец периода'"), "ВидОстатка");
	
	ПраваПользованияОС = ПраваПользованияОСНачалоПериода;
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ПраваПользованияОСКонецПериода, ПраваПользованияОС);
	
	// Права пользования НМА (111.60).
	ПраваПользованияНМАНачалоПериода = РассчитатьДолгосрочныеПраваПользованияНМА(Организация, НачалоПериода, ПараметрыОтбора);
	ПраваПользованияНМАКонецПериода = РассчитатьДолгосрочныеПраваПользованияНМА(Организация, КонецПериода, ПараметрыОтбора);
	
	ПраваПользованияНМАНачалоПериода.Колонки.Добавить("ВидОстатка", Новый ОписаниеТипов("Строка"));
	ПраваПользованияНМАНачалоПериода.ЗаполнитьЗначения(НСтр("ru = 'На начало периода'"), "ВидОстатка");
	ПраваПользованияНМАКонецПериода.Колонки.Добавить("ВидОстатка", Новый ОписаниеТипов("Строка"));
	ПраваПользованияНМАКонецПериода.ЗаполнитьЗначения(НСтр("ru = 'На конец периода'"), "ВидОстатка");
	
	ПраваПользованияНМА = ПраваПользованияНМАНачалоПериода;
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ПраваПользованияНМАКонецПериода, ПраваПользованияНМА);
	
	// Внешние наборы данных отчета.
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ПраваПользованияОС", ПраваПользованияОС);
	ВнешниеНаборыДанных.Вставить("ПраваПользованияНМА", ПраваПользованияНМА);
	
	// Формированирование отчета.
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли