#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает сведения о внешнем отчете.
//
// Возвращаемое значение:
//   Структура - Подробнее см. ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке().
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.4.1");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Расчет долгосрочных прав пользования активами.'");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительныйОтчет();
	ПараметрыРегистрации.Версия = "1.0.0.15";
	ПараметрыРегистрации.ОпределитьНастройкиФормы = Истина;
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Расчет долгосрочных прав пользования активами'");
	Команда.Идентификатор = "РасчетДолгосрочныхПравПользованияАктивами";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция РассчитатьДолгосрочныеПраваПользованияОС(Организация, НаДату, ПараметрыОтбора) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВалютаРегл", Константы.ВалютаРегламентированногоУчета.Получить());
	
	Если НаДату = НачалоГода(НаДату) Тогда // При заполнении на начало года 01.01.20ХХ остатки получаем на конец предыдущего года с операциями межотчетного периода.
		Запрос.УстановитьПараметр("КонецПериода", БухгалтерскийУчет.КонецПериодаСУточнением(НаДату - 1, Перечисления.ВидыМежотчетногоПериода.ИзменениеВалютыБаланса));
		НачалоПериодаКраткосрочный = НачалоДня(НаДату);
	Иначе
		Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(НаДату), ВидГраницы.Включая));
		НачалоПериодаКраткосрочный = НачалоДня(КонецДня(НаДату) + 1);
	КонецЕсли;
	
	КонецПериодаКраткосрочный = КонецДня(ДобавитьМесяц(НачалоПериодаКраткосрочный, 12) - 1);
	НачалоПериодаДолгосрочный = НачалоДня(КонецПериодаКраткосрочный + 1);
	Запрос.УстановитьПараметр("НачалоПериодаКраткосрочный", НачалоПериодаКраткосрочный);
	Запрос.УстановитьПараметр("КонецПериодаКраткосрочный", КонецПериодаКраткосрочный);
	Запрос.УстановитьПараметр("НачалоПериодаДолгосрочный", НачалоПериодаДолгосрочный);
	
	Если ТипЗнч(Запрос.Параметры.КонецПериода) = Тип("Граница") Тогда // Конец периода для запросов по оборотам.
		Если ТипЗнч(Запрос.Параметры.КонецПериода.Значение) = Тип("Дата") Тогда
			Запрос.УстановитьПараметр("КонецПериодаДата", КонецДня(Запрос.Параметры.КонецПериода.Значение));
		Иначе
			Запрос.УстановитьПараметр("КонецПериодаДата", КонецДня(Запрос.Параметры.КонецПериода.Значение.Дата));
		КонецЕсли;
	Иначе
		Запрос.УстановитьПараметр("КонецПериодаДата", Запрос.Параметры.КонецПериода);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Счета11140", БухгалтерскийУчет.СписокСчетов("111.40"));
	Запрос.УстановитьПараметр("Счета10440", БухгалтерскийУчет.СписокСчетов("104.40"));
	Запрос.УстановитьПараметр("Счета11440", БухгалтерскийУчет.СписокСчетов("114.40"));
	Запрос.УстановитьПараметр("Счета40160", БухгалтерскийУчет.СписокСчетов("401.60"));
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("ПраваПользованияБУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("АмортизацияПравПользованияБУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ОбесценениеПравПользованияБУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ЕстьГрафикАмортизацииПравПользованияОС", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ГрафикАмортизацииКраткосрочныйПериод", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ГрафикАмортизацииДолгосрочныйПериод", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Резервы40160", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ГрафикАмортизацииКраткосрочныйПериодСРезервами", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ГрафикАмортизацииДолгосрочныйПериодСРезервами", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаПраваПользования", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЕПСБУОстатки.СуммаОстатокДт КАК БалансоваяСтоимость
	|ПОМЕСТИТЬ ПраваПользованияБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&Счета11140)
	|				И &УсловиеПоСчетуУчета,
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКФО
	|				И &УсловиеПоОС) КАК ЕПСБУОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ЕПСБУОстатки.СуммаОстатокКт КАК Амортизация
	|ПОМЕСТИТЬ АмортизацияПравПользованияБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&Счета10440),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКФО
	|				И &УсловиеПоОС) КАК ЕПСБУОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ЕПСБУОстатки.СуммаОстатокКт КАК Обесценение
	|ПОМЕСТИТЬ ОбесценениеПравПользованияБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&Счета11440),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКФО
	|				И &УсловиеПоОС) КАК ЕПСБУОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГрафикАмортизацииПравПользованияОС.Организация КАК Организация,
	|	ГрафикАмортизацииПравПользованияОС.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ ЕстьГрафикАмортизацииПравПользованияОС
	|ИЗ
	|	РегистрНакопления.ГрафикАмортизацииПравПользованияОС КАК ГрафикАмортизацииПравПользованияОС
	|ГДЕ
	|	ГрафикАмортизацииПравПользованияОС.Организация = &Организация
	|	И ГрафикАмортизацииПравПользованияОС.ОсновноеСредство В
	|			(ВЫБРАТЬ
	|				ПраваПользованияБУ.ОсновноеСредство КАК ОсновноеСредство
	|			ИЗ
	|				ПраваПользованияБУ КАК ПраваПользованияБУ)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГрафикАмортизацииПравПользованияОСОбороты.Организация КАК Организация,
	|	ГрафикАмортизацииПравПользованияОСОбороты.ОсновноеСредство КАК ОсновноеСредство,
	|	ГрафикАмортизацииПравПользованияОСОбороты.Договор КАК Договор,
	|	ГрафикАмортизацииПравПользованияОСОбороты.АмортизацияОборот КАК Амортизация,
	|	ГрафикАмортизацииПравПользованияОСОбороты.АренднаяПлатаОборот КАК АренднаяПлата
	|ПОМЕСТИТЬ ГрафикАмортизацииКраткосрочныйПериод
	|ИЗ
	|	РегистрНакопления.ГрафикАмортизацииПравПользованияОС.Обороты(
	|			,
	|			&КонецПериодаДата,
	|			,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.ОсновноеСредство КАК ОсновноеСредство
	|					ИЗ
	|						ПраваПользованияБУ КАК ПраваПользованияБУ)
	|				И Договор В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.Договор КАК Договор
	|					ИЗ
	|						ПраваПользованияБУ КАК ПраваПользованияБУ)
	|				И ДатаНачисленияАмортизации >= &НачалоПериодаКраткосрочный
	|				И ДатаНачисленияАмортизации <= &КонецПериодаКраткосрочный) КАК ГрафикАмортизацииПравПользованияОСОбороты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГрафикАмортизацииПравПользованияОСОбороты.Организация КАК Организация,
	|	ГрафикАмортизацииПравПользованияОСОбороты.ОсновноеСредство КАК ОсновноеСредство,
	|	ГрафикАмортизацииПравПользованияОСОбороты.Договор КАК Договор,
	|	ГрафикАмортизацииПравПользованияОСОбороты.АмортизацияОборот КАК Амортизация,
	|	ГрафикАмортизацииПравПользованияОСОбороты.АренднаяПлатаОборот КАК АренднаяПлата
	|ПОМЕСТИТЬ ГрафикАмортизацииДолгосрочныйПериод
	|ИЗ
	|	РегистрНакопления.ГрафикАмортизацииПравПользованияОС.Обороты(
	|			,
	|			&КонецПериодаДата,
	|			,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.ОсновноеСредство КАК ОсновноеСредство
	|					ИЗ
	|						ПраваПользованияБУ КАК ПраваПользованияБУ)
	|				И Договор В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.Договор КАК Договор
	|					ИЗ
	|						ПраваПользованияБУ КАК ПраваПользованияБУ)
	|				И ДатаНачисленияАмортизации >= &НачалоПериодаДолгосрочный) КАК ГрафикАмортизацииПравПользованияОСОбороты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Договоры) КАК Договор,
	|	ВЫБОР
	|		КОГДА ЕПСБУОстатки.Валюта <> &ВалютаРегл
	|				И ЕПСБУОстатки.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ЕПСБУОстатки.Валюта, &ВалютаРегл)
	|		ИНАЧЕ &ВалютаРегл
	|	КОНЕЦ КАК Валюта,
	|	СУММА(ЕПСБУОстатки.СуммаОстатокКт) КАК РезервРуб,
	|	СУММА(ЕПСБУОстатки.ВалютнаяСуммаОстатокКт) КАК РезервВал
	|ПОМЕСТИТЬ Резервы40160
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&Счета40160),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры),
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКФО
	|				И Субконто1 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ГрафикАмортизацииКраткосрочныйПериод.Договор КАК Договор
	|					ИЗ
	|						ГрафикАмортизацииКраткосрочныйПериод КАК ГрафикАмортизацииКраткосрочныйПериод
	|			
	|					ОБЪЕДИНИТЬ ВСЕ
	|			
	|					ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ГрафикАмортизацииДолгосрочныйПериод.Договор КАК Договор
	|					ИЗ
	|						ГрафикАмортизацииДолгосрочныйПериод КАК ГрафикАмортизацииДолгосрочныйПериод)) КАК ЕПСБУОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОстатки.Организация,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Договоры),
	|	ВЫБОР
	|		КОГДА ЕПСБУОстатки.Валюта <> &ВалютаРегл
	|				И ЕПСБУОстатки.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ЕПСБУОстатки.Валюта, &ВалютаРегл)
	|		ИНАЧЕ &ВалютаРегл
	|	КОНЕЦ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГрафикАмортизацииКраткосрочныйПериод.Организация КАК Организация,
	|	ГрафикАмортизацииКраткосрочныйПериод.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(ГрафикАмортизацииКраткосрочныйПериод.Амортизация) КАК Амортизация,
	|	СУММА(ГрафикАмортизацииКраткосрочныйПериод.АренднаяПлата) КАК АренднаяПлата,
	|	СУММА(Резервы40160.РезервРуб) КАК РезервРуб,
	|	СУММА(Резервы40160.РезервВал) КАК РезервВал,
	|	СУММА(ВЫБОР
	|			КОГДА Резервы40160.Валюта <> &ВалютаРегл
	|					И Резервы40160.Валюта <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|					И Резервы40160.РезервВал <> 0
	|				ТОГДА ГрафикАмортизацииКраткосрочныйПериод.Амортизация * (Резервы40160.РезервРуб / Резервы40160.РезервВал)
