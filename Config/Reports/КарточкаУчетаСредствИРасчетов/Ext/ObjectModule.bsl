#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем НаборПоказателей Экспорт; // Массив показателей отчета
Перем ИмяМакетПроводок;         // Имя макета проводок
Перем Контра;

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ 
//Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
//	
////	СтандартныеОтчеты.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ);
//	
//КонецПроцедуры

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(Результат, ДанныеРасшифровки, СтандартнаяОбработка)
	
    МакетШапки = УправлениеПечатью.МакетПечатнойФормы("Отчет.КарточкаУчетаСредствИРасчетов.МакетФиксированныхОбластей");
	Макет = ПолучитьМакет("МакетФиксированныхОбластей");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Шапка");
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрыОтчета = Настройки.ПараметрыДанных;
	ОбластьЗаголовок.Параметры.КонецПериода 	= Формат(КонецДня(ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период")).Значение.ДатаОкончания) + 1, "ДЛФ=Д");
	Организация = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация"));
	Если НЕ Организация = Неопределено И ЗначениеЗаполнено(Организация.Значение) Тогда
		ОбластьЗаголовок.Параметры.Организация 		= Организация.Значение.НаименованиеПолное;
		ОбластьЗаголовок.Параметры.ОКПО 			= Организация.Значение.КодОКПО;
	КонецЕсли;
    ПодразделениеОтчета = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Подразделение"));
    Если НЕ ПодразделениеОтчета = Неопределено И ЗначениеЗаполнено(ПодразделениеОтчета.Значение) Тогда
    	ПараметрыПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПодразделениеОтчета.Значение, "НаименованиеПолное,Наименование,ОбособленноеПодразделение");
    	НазваниеПодразделения = "";
    	Если ПараметрыПодразделения.ОбособленноеПодразделение И ЗначениеЗаполнено(ПараметрыПодразделения.НаименованиеПолное) Тогда
    		ОбластьЗаголовок.Параметры.Подразделение =	ПараметрыПодразделения.НаименованиеПолное;
    	Иначе
    		ОбластьЗаголовок.Параметры.Подразделение =	ПараметрыПодразделения.Наименование;
    	КонецЕсли;
	КонецЕсли;
	Счет = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Счет"));
	Если НЕ Счет = Неопределено И ЗначениеЗаполнено(Счет.Значение) Тогда
		ОбластьЗаголовок.Параметры.Счет = УправлениеПечатьюБГУ.ПредставлениеРабочегоСчета("", "", Счет.Значение, "",, Истина);
	КонецЕсли;
	
	ДебиторКредитор = Справочники.Контрагенты.ПустаяСсылка();
    УдалитьОтборКонтрагент(КомпоновщикНастроек);
    Контрагент = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Контрагент"));
	Если НЕ Контра = "" И НЕ Контрагент = Неопределено И ЗначениеЗаполнено(Контрагент.Значение) И Контрагент.Использование Тогда
		ДебиторКредитор = Контрагент.Значение;
		СтандартныеОтчетыКлиентСервер.УдалитьОтбор(КомпоновщикНастроек, "Субконто" + Контра);
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(
			КомпоновщикНастроек,
			"Субконто" + Контра,
			ДебиторКредитор,
			ВидСравненияКомпоновкиДанных.Равно,
			,
			Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДебиторКредитор) Тогда
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	Контрагенты.ЮридическоеФизическоеЛицо.КодОКПО КАК ОКПО_ДК,
		|	ВЫБОР
		|		КОГДА НЕ Контрагенты.НаименованиеСокращенное = """"
		|			ТОГДА Контрагенты.НаименованиеСокращенное
		|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
		|				И НЕ Контрагенты.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
		|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.НаименованиеПолное
		|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
		|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.Наименование
		|		ИНАЧЕ Контрагенты.Наименование
		|	КОНЕЦ КАК ДебиторКредитор
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Ссылка");
		
		Запрос.УстановитьПараметр("Ссылка", ДебиторКредитор);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(ОбластьЗаголовок.Параметры, Выборка);
		КонецЕсли;
	КонецЕсли;
	
	ПериодОтчета = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	Если НЕ ПериодОтчета = Неопределено И ЗначениеЗаполнено(ПериодОтчета.Значение) Тогда
		Попытка
			ОбластьЗаголовок.Параметры.ЗаПериод = ПредставлениеПериода(НачалоДня(ПериодОтчета.Значение.ДатаНачала), КонецДня(ПериодОтчета.Значение.ДатаОкончания), "ФП");
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Результат.Вывести(ОбластьЗаголовок);
	
	СтандартныеОтчеты.ВыводитьОтбор(Результат, КомпоновщикНастроек, "Организация");
	
	Результат.Область("R1:R" + Результат.ВысотаТаблицы).Имя = "Заголовок";
	Результат.Области.Заголовок.Видимость = КомпоновщикНастроек.ПолучитьНастройки().ДополнительныеСвойства.ВыводитьЗаголовок;
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Процедура УдалитьОтборКонтрагент(КомпоновщикНастроек)
	
	Если НЕ СтандартныеОтчетыКлиентСервер.УдалитьОтбор(КомпоновщикНастроек, "Контрагент", Истина) Тогда
		Для Индекс = 1 По 3 Цикл
			Если СтандартныеОтчетыКлиентСервер.УдалитьОтбор(КомпоновщикНастроек, "Субконто" + Индекс + ".Контрагент", Истина) Тогда
				Возврат
			КонецЕсли
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.РазрешеноИзменятьСтруктуру = Ложь;
	Настройки.РазрешеноВосстанавливатьСтандартнуюСхему = Истина;
	
	Настройки.Печать.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;

	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;
	Настройки.События.ПриОпределенииСвойствЭлементовФормыНастроек = Истина;
	
	Настройки.ЗагрузитьНастройкиПриИзмененииПараметров = Отчеты.КарточкаУчетаСредствИРасчетов.ЗагрузитьНастройкиПриИзмененииПараметров();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////
// Расположение параметров на форме
Процедура ПриОпределенииСвойствЭлементовФормыНастроек(ТипФормы, СвойстваЭлементов, ПользовательскиеНастройки) Экспорт 
	
	СвойстваГруппы = ОтчетыСервер.СвойстваГруппыЭлементовФормы();
	СвойстваГруппы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	СвойстваЭлементов.Группы.Вставить("ФиксированныеПараметры_0", СвойстваГруппы);
	//СвойстваЭлементов.Группы.Вставить("ФиксированныеПараметры_1", СвойстваГруппы);
	
	//ФиксированныеПараметры_0 = "Период, Счет, Организация";
	//ФиксированныеПараметры_1 = "Периодичность, ПоказатьКорСчет, Исполнитель, СчетДатаФормирования";
	ФиксированныеПараметры_0 = "Период, Периодичность, Исполнитель, Счет, ПоказатьКорСчет, СчетДатаФормирования, Организация";
	
	Для Каждого ЭлементНастройки Из ПользовательскиеНастройки Цикл 
		
		ИдентификаторГруппы = Неопределено;
		ИмяПараметра = Неопределено;
		
		Если ТипЗнч(ЭлементНастройки) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда 
			Если СтрНайти(ФиксированныеПараметры_0, Строка(ЭлементНастройки.Параметр)) > 0 Тогда
				ИдентификаторГруппы = "ФиксированныеПараметры_0"; 
			//ИначеЕсли СтрНайти(ФиксированныеПараметры_1, Строка(ЭлементНастройки.Параметр)) > 0 Тогда
			//	ИдентификаторГруппы = "ФиксированныеПараметры_1"; 
			КонецЕсли;
			ИмяПараметра = Строка(ЭлементНастройки.Параметр);
		КонецЕсли;
		
		СвойстваПоля = СвойстваЭлементов.Поля.Найти(ЭлементНастройки.ИдентификаторПользовательскойНастройки, "ИдентификаторНастройки");
		
		Если СвойстваПоля = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Не ИдентификаторГруппы = Неопределено Тогда
			СвойстваПоля.ИдентификаторГруппы = ИдентификаторГруппы;
		КонецЕсли;
		
		Если ИмяПараметра = "Счет" Тогда 
			СвойстваПоля.Ширина = 7;
			СвойстваПоля.РастягиватьПоГоризонтали = Ложь;
		КонецЕсли;
		
		Если ИмяПараметра = "ДатаФормирования" Тогда 
			СвойстваПоля.Ширина = 18;
			СвойстваПоля.РастягиватьПоГоризонтали = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Вызывается перед загрузкой новых настроек. Используется для изменения схемы компоновки.
//   Например, если схема отчета зависит от ключа варианта или параметров отчета.
//   Чтобы изменения схемы вступили в силу следует вызывать метод ОтчетыСервер.ПодключитьСхему().
//
// Параметры:
//   Контекст - Произвольный - 
//       Параметры контекста, в котором используется отчет.
//       Используется для передачи в параметрах метода ОтчетыСервер.ПодключитьСхему().
//   КлючСхемы - Строка -
//       Идентификатор текущей схемы компоновщика настроек.
//       По умолчанию не заполнен (это означает что компоновщик инициализирован на основании основной схемы).
//       Используется для оптимизации, чтобы переинициализировать компоновщик как можно реже.
//       Может не использоваться если переинициализация выполняется безусловно.
//   КлючВарианта - Строка
//                - Неопределено -
//       Имя предопределенного или уникальный идентификатор пользовательского варианта отчета.
//       Неопределено когда вызов для варианта расшифровки или без контекста.
//   НовыеНастройкиКД - НастройкиКомпоновкиДанных
//                    - Неопределено -
//       Настройки варианта отчета, которые будут загружены в компоновщик настроек после его инициализации.
//       Неопределено когда настройки варианта не надо загружать (уже загружены ранее).
//   НовыеПользовательскиеНастройкиКД - ПользовательскиеНастройкиКомпоновкиДанных
//                                    - Неопределено -
//       Пользовательские настройки, которые будут загружены в компоновщик настроек после его инициализации.
//       Неопределено когда пользовательские настройки не надо загружать (уже загружены ранее).
//
Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт
	
	Счет = Неопределено;
	ПараметрСчет = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Счет"));
	Если ПараметрСчет <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
		НастройкаСчет = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрСчет.ИдентификаторПользовательскойНастройки);
		Если НастройкаСчет <> Неопределено Тогда
			Если ЗначениеЗаполнено(НастройкаСчет.Значение) Тогда
				Счет = НастройкаСчет.Значение
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Периодичность = Неопределено;
	ПараметрПериодичность = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Периодичность"));
	Если ПараметрПериодичность <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
		НастройкаПериодичность = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрПериодичность.ИдентификаторПользовательскойНастройки);
		Если НастройкаПериодичность <> Неопределено Тогда
			Если НастройкаПериодичность.Значение <> Неопределено Тогда
				Периодичность = НастройкаПериодичность.Значение
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПоказатьКорСчет = Неопределено;
	ПараметрПоказатьКорСчет = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПоказатьКорСчет"));
	Если ПараметрПоказатьКорСчет <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
		НастройкаПоказатьКорСчет = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрПоказатьКорСчет.ИдентификаторПользовательскойНастройки);
		Если НастройкаПоказатьКорСчет <> Неопределено Тогда
			Если НастройкаПоказатьКорСчет.Значение <> Неопределено Тогда
				ПоказатьКорСчет = НастройкаПоказатьКорСчет.Значение
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
	КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация"));
	Организация = Неопределено;
	ПараметрОрганизация = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация"));
	Если ПараметрОрганизация <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
		НастройкаОрганизация = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрОрганизация.ИдентификаторПользовательскойНастройки);
		Если НастройкаОрганизация <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(НастройкаОрганизация.Значение) Тогда
				Организация = СтандартныеОтчеты.ОсновнаяОрганизация(Организация);
				НастройкаОрганизация.Значение = Организация;
			Иначе
				Организация = НастройкаОрганизация.Значение
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "Организация", Организация);
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		Подразделение = Неопределено;
		Исполнитель = Неопределено;
		
		ДатаЗначений = ТекущаяДатаСеанса();
		ПараметрДата = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаФормирования")); 
		Если ПараметрДата <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
			НастройкаДата = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрДата.ИдентификаторПользовательскойНастройки);
			Если НастройкаДата <> Неопределено Тогда
				Если ТипЗнч(НастройкаДата.Значение) = Тип("Дата") Тогда
					ДатаЗначений = НастройкаДата.Значение;
				Иначе
					ДатаЗначений = НастройкаДата.Значение.Дата;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
		ПараметрИсполнитель = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Исполнитель"));
		Если ПараметрИсполнитель <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
			НастройкаИсполнитель = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрИсполнитель.ИдентификаторПользовательскойНастройки);
			Если НастройкаИсполнитель <> Неопределено Тогда
				Если НЕ ЗначениеЗаполнено(НастройкаИсполнитель.Значение) Тогда
					Исполнитель = СтандартныеОтчеты.ОтветственныйИсполнитель(Организация);
					НастройкаИсполнитель.Значение = Исполнитель;
				Иначе
					Исполнитель = НастройкаИсполнитель.Значение	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Исполнитель) Тогда
			ПараметрПодразделение = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Подразделение"));
			Если ПараметрПодразделение <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
				НастройкаПодразделение = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрПодразделение.ИдентификаторПользовательскойНастройки);
				Если НастройкаПодразделение <> Неопределено Тогда
					Если НЕ ЗначениеЗаполнено(НастройкаПодразделение.Значение) Тогда
						Подразделение = СтандартныеОтчеты.ПодразделениеИсполнителя(Исполнитель, ДатаЗначений);;
						НастройкаПодразделение.Значение = Подразделение;
					Иначе
						Подразделение = НастройкаПодразделение.Значение;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Периодичность <> Неопределено И ПоказатьКорСчет <> Неопределено Тогда
		Если Периодичность = 0 Тогда
			НовыеНастройкиКД.Структура[0].Использование = Ложь;
			НовыеНастройкиКД.Структура[1].Использование = ПоказатьКорСчет;
			НовыеНастройкиКД.Структура[2].Использование = Ложь;
			НовыеНастройкиКД.Структура[3].Использование = НЕ ПоказатьКорСчет;
		Иначе
			НовыеНастройкиКД.Структура[0].Использование = ПоказатьКорСчет;
			НовыеНастройкиКД.Структура[1].Использование = Ложь;
			НовыеНастройкиКД.Структура[2].Использование = НЕ ПоказатьКорСчет;
			НовыеНастройкиКД.Структура[3].Использование = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Счет) Тогда
		// Устанавливаю имена субконто и дебитор/кредитор
		Сбк = "Субконто";
		Контра = "";
		КоличествоСубконто = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет).КоличествоСубконто;
		Для Индекс = 1 По 3 Цикл
			Поле = СхемаКомпоновкиДанных.НаборыДанных.Проводки.Поля.Найти(Сбк + Индекс);
			Если Индекс <= КоличествоСубконто Тогда
				Если Поле <> Неопределено Тогда
					Поле.Заголовок   = Счет.ВидыСубконто[Индекс - 1].ВидСубконто.Наименование;
					Поле.ТипЗначения = Счет.ВидыСубконто[Индекс - 1].ВидСубконто.ТипЗначения;
					Если Поле.Заголовок = "Контрагенты" Тогда
						Контра = Строка(Индекс);
					ИначеЕсли Поле.Заголовок = "Налоги и платежи организации" ИЛИ Поле.Заголовок = "Объекты финансовых вложений" Тогда
						Контра = Строка(Индекс) + ".Контрагент";
					КонецЕсли;
				КонецЕсли;
			Иначе
				Поле.Заголовок   = Сбк + Индекс;
				Поле.ТипЗначения = Новый ОписаниеТипов();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПараметрПериод = НовыеНастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	
	Если ПараметрПериод <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
		НастройкаПериод = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрПериод.ИдентификаторПользовательскойНастройки);
		Если НастройкаПериод <> Неопределено Тогда
			ЗначениеПериод = НастройкаПериод.Значение; 
			ГраницаНачало 	= ?(ЗначениеЗаполнено(ЗначениеПериод.ДатаНачала), НачалоДня(ЗначениеПериод.ДатаНачала), Дата(1, 1, 1));
			ГраницаКонец 	= ?(ЗначениеЗаполнено(ЗначениеПериод.ДатаОкончания),
				Бухгалтерскийучет.КонецПериодаСУточнением(
					ЗначениеПериод.ДатаОкончания,
					ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ЗаключениеСчетов")), Дата(3999, 12, 31));
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "НачалоПериода", ГраницаНачало);
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "КонецПериода", ГраницаКонец);
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "НачалоПериодаОстатки", ГраницаНачало);
			Если ТипЗнч(ГраницаКонец) = Тип("Дата") Тогда
				СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "КонецПериодаОстатки", ГраницаКонец + 1);
			Иначе
				СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "КонецПериодаОстатки", ГраницаКонец.Значение.Дата + 1);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Обновить отборы
	Для каждого Эл из НовыеПользовательскиеНастройкиКД.Элементы Цикл
		Если Эл.Использование И ТипЗнч(Эл) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Отбор = НайтиОтборПоИД(НовыеНастройкиКД.Отбор.Элементы, Эл.ИдентификаторПользовательскойНастройки);
			Если Отбор <> Неопределено И ТипЗнч(Отбор) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
				Отбор.ПравоеЗначение = Эл.ПравоеЗначение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ОтчетыСервер.ПодключитьСхему(ЭтотОбъект, Контекст, СхемаКомпоновкиДанных, КлючСхемы);
	
КонецПроцедуры

#КонецОбласти

////////////////////////////////////////////////////////////////////////////
Функция НайтиОтборПоИД(Отборы, ИД)

	Для Каждого Отбор из Отборы Цикл
		Если Отбор.ИдентификаторПользовательскойНастройки = ИД Тогда
			Возврат Отбор;
		КонецЕсли;
		Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Нашел = НайтиОтборПоИД(Отбор.Элементы, ИД);
			Если Нашел <> Неопределено Тогда
				Возврат Нашел;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;

КонецФункции

#КонецОбласти

Контра = "";

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
