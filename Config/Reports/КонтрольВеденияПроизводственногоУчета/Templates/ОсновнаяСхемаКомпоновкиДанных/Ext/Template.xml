////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВсеПриходы.СчетДт КАК СчетДт,
	ВсеПриходы.Номенклатура КАК Номенклатура,
	ВсеПриходы.СчетКт КАК СчетКт,
	ВсеПриходы.Сумма КАК Сумма,
	ВсеПриходы.КоличествоДт КАК КоличествоДт,
	ВсеПриходы.Регистратор КАК Регистратор,
	ВсеПриходы.Организация КАК Организация
{ВЫБРАТЬ
	СчетДт.*,
	Номенклатура.*,
	СчетКт.*,
	Сумма,
	КоличествоДт,
	Регистратор.*,
	Организация.*}
ИЗ
	ВсеПриходы КАК ВсеПриходы
ГДЕ
	ВсеПриходы.СчетКт &lt;&gt; &amp;Счет10960
	И ВсеПриходы.Номенклатура В
			(ВЫБРАТЬ
				ВсеПриходы.Номенклатура КАК Номенклатура
			ИЗ
				ВсеПриходы КАК ВсеПриходы
			ГДЕ
				ВсеПриходы.СчетКт = &amp;Счет10960)
	И ИСТИНА В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				ИСТИНА
			ИЗ
				ВсеПриходы КАК Выпуски
			ГДЕ
				Выпуски.СчетКт = &amp;Счет10960
				И Выпуски.Номенклатура = ВсеПриходы.Номенклатура)</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
