&НаКлиенте
Процедура ПроверитьИПерейтиКСтрокеЗначенияПоказателя()
	
	ТекДанные = Элементы["СписокПоказателей"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные["УдовлетворяетОтбору"] Тогда
		ТекстСообщения = НСтр("ru='Перейти к выбранному значению показателя в основной форме помощника?'");
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ТекДанные", ТекДанные);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИПерейтиКСтрокеЗначенияПоказателя_Ответ", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
		
	Иначе
		ТекстСообщения = НСтр("ru='Не получится перейти к выбранному значению показателя,
			|потому что это значение скрыто в основной форме помощника
			|из-за установленого отбора'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИПерейтиКСтрокеЗначенияПоказателя_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ТекДанные = ПараметрыОповещения["ТекДанные"];
		
		ВозвращаемоеЗначение = Новый Структура("
			|флагПоказательИзменен,
			|флагПоказательНовый,
			|ИдСтроки");
			
		ЗаполнитьЗначенияСвойств(ВозвращаемоеЗначение, ТекДанные);
		
		ЭтаФорма.Закрыть(ВозвращаемоеЗначение);
	КонецЕсли;
	
КонецПроцедуры

