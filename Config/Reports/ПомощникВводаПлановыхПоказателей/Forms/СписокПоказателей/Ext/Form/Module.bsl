&НаКлиенте
Перем ТекстЗаголовкаСообщений;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВходныеДанные = ПолучитьИзВременногоХранилища(Параметры["АдресХранилища"]);
	
	ЗаполнитьСписокПоказателей(ВходныеДанные);
	
	// Статистика сеанса работы
	ИзмененныеПоказатели_Количество			= ВходныеДанные["ИзмененныеПоказатели_Количество"];
	ИзмененныеПоказатели_КоличествоПоказано	= ВходныеДанные["ИзмененныеПоказатели_КоличествоОтбор"];
	ИзмененныеПоказатели_КоличествоСкрыто	= ИзмененныеПоказатели_Количество - ИзмененныеПоказатели_КоличествоПоказано;
	НовыеПоказатели_Количество				= ВходныеДанные["НовыеПоказатели_Количество"];
	НовыеПоказатели_КоличествоПоказано		= ВходныеДанные["НовыеПоказатели_КоличествоОтбор"];
	НовыеПоказатели_КоличествоСкрыто		= НовыеПоказатели_Количество - НовыеПоказатели_КоличествоПоказано;
	
	КоличествоСкрытых = (ИзмененныеПоказатели_КоличествоСкрыто + НовыеПоказатели_КоличествоСкрыто);
	
	НадписьКоличествоПоказателей = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='новые (%1),  измененные (%2)'"),
		НовыеПоказатели_Количество,
		ИзмененныеПоказатели_Количество);
	
	// Надпись "Есть скрытые отбором"
	НовыйЗаголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Есть скрытые отбором (%1)'"),
		КоличествоСкрытых);
	НастраиваемыйЭлемент = Элементы["СписокПоказателейЕстьСкрытыеОтбором"];
	НастраиваемыйЭлемент.Видимость	= (КоличествоСкрытых > 0);
	НастраиваемыйЭлемент.Заголовок	= НовыйЗаголовок;
	
	// Учтем значения ФО
	Элементы["СписокПоказателейГруппаИФО"].Видимость			= Параметры["ФОУчетПоИФО"];
	Элементы["СписокПоказателейГруппаПодразделение"].Видимость	= Параметры["ФОУчетПоПодразделениям"];
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Помощник ввода плановых показателей'");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СписокПоказателей

&НаКлиенте
Процедура СписокПоказателейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПроверитьИПерейтиКСтрокеЗначенияПоказателя();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПоказателейПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПоказателейПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЕстьСкрытыеОтбором(Команда)
	
	ТекстСообщения = НСтр("ru='В основной форме помощника установлен отбор.
		|
		|В данной таблице перечислены все модифицированные показатели.
		|Даже те показатели, которые скрыты в основной форме помощника
		|из-за установленного отбора'");
		
	ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПерейти(Команда)
	
	ПроверитьИПерейтиКСтрокеЗначенияПоказателя();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//---
	// 1. Различающиеся значения ИФО
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
