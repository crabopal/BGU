&НаКлиенте
Перем ТекстЗаголовкаСообщений;

&НаКлиенте
Перем ЗакрытьФормуБезусловно;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "Организация, СписокСтатей");
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры["НазначениеСтруктура"]);
	
	ЗаполнитьТаблицуПоказателей();
	
	ВидПоказателяПредставление = Отчеты.ПомощникВводаПлановыхПоказателей.ПолучитьПредставлениеВидаПоказателя(ВидПоказателя, УточнениеПоказателя);
	
	// Учтем значения ФО
	Элементы["ИФО"].Видимость									= Параметры["ФОУчетПоИФО"];
	Элементы["ОтчетСписокПоказателейПодразделение"].Видимость	= Параметры["ФОУчетПоПодразделениям"];
	Элементы["ГрупповоеЗаполнение_Подразделение"].Видимость		= Параметры["ФОУчетПоПодразделениям"];
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Помощник ввода плановых показателей'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗакрытьФормуБезусловно = Истина Тогда
		ЗакрытьФормуБезусловно = Неопределено;
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.Модифицированность Тогда
		Отказ = Истина;
		
		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = НСтр("ru='Изменения значения показателя будут потеряны'");
			Возврат;
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru='Данные были изменены. Сохранить изменения?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
				
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Выбрали "Сохранить изменения"
		
		ПроверитьИЗакрытьФормуССохранениемРедактирования();
		
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		// Выбрали "Не сохранить изменения"
		
		ЗакрытьФормуБезусловно = Истина;
		
		ЗакрытьФормуБезСохраненияРедактирования();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЕстьНезаполненныеПоля() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если ЕстьДублиСтрок() Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СписокПоказателей

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаДобавить(Команда)
	
	ПроверитьИЗакрытьФормуССохранениемРедактирования();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьГрупповоеЗаполнение(Команда)
	
	ПроверитьИВыполнитьГрупповоеЗаполнениеСтрок();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьИЗакрытьФормуССохранениемРедактирования()
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Отчет["СписокПоказателей"].Количество() = 0 Тогда
		ЗакрытьФормуБезСохраненияРедактирования();
	Иначе
		ЗакрытьФормуССохранениемРедактирования();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуССохранениемРедактирования()
	
	ЗакрытьФормуБезусловно = Истина;
	
	АдресХранилища = ПолучитьВозвращаемоеЗначение();
	
	ЭтаФорма.Закрыть(АдресХранилища);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуБезСохраненияРедактирования()
	
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//---
	// 1. Одновременно пустые Поступления и Выбытия
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Одновременно пустые поля Поступление и Выбытие'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Отчет.СписокПоказателей.Поступления");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = 0;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Отчет.СписокПоказателей.Выбытия");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = 0;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОтчетСписокПоказателейПоступления");
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОтчетСписокПоказателейВыбытия");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПоказателей()
	
	Отчет["СписокПоказателей"].Очистить();
	
	Для Каждого Элемент Из СписокСтатей Цикл
		СтатьяПлана = Элемент.Значение;
		
		НоваяСтрока = Отчет["СписокПоказателей"].Добавить();
		
		НоваяСтрока["СтатьяПлана"] = СтатьяПлана;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВозвращаемоеЗначение()
	
	СохраняемоеЗначение = Отчет["СписокПоказателей"].Выгрузить(, "СтатьяПлана, ОтчетныйПериод, Подразделение, Поступления, Выбытия");
	
	АдресХранилища = ПоместитьВоВременноеХранилище(СохраняемоеЗначение);
	
	Возврат АдресХранилища;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИВыполнитьГрупповоеЗаполнениеСтрок()
	
	КолвоВыделенныхСтрок = Элементы["ОтчетСписокПоказателей"].ВыделенныеСтроки.Количество();
	
	Если КолвоВыделенныхСтрок = 0 Тогда
		ТекстСообщения = НСтр("ru='Выберите хотя бы одну строку в таблице ""Добавляемые показатели"" для заполнения'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
	Иначе
		ТекстСообщения = НСтр("ru='Выполнить групповое заполнение строк?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИВыполнитьГрупповоеЗаполнениеСтрок_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИВыполнитьГрупповоеЗаполнениеСтрок_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
			
		ВыполнитьГрупповоеЗаполнениеСтрокСервер();
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ВыполнитьГрупповоеЗаполнениеСтрокСервер()
	
	ВыделенныеСтроки = Элементы["ОтчетСписокПоказателей"].ВыделенныеСтроки;
	
	СтруктураЗаполнения = Новый Структура();
	СтруктураЗаполнения.Вставить("ОтчетныйПериод",	ГрупповоеЗаполнение_ОтчетныйПериод);
	СтруктураЗаполнения.Вставить("Подразделение",	ГрупповоеЗаполнение_Подразделение);
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТЧ = Отчет["СписокПоказателей"].НайтиПоИдентификатору(ИдСтроки);
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтруктураЗаполнения);
	КонецЦикла;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ЕстьНезаполненныеПоля()
	
	// Колонку Подразделение не проверяем на заполненность, даже если ведется учет по подразделениям
	
	ЗапросПроверка = Новый Запрос();
	ЗапросПроверка.УстановитьПараметр("ТаблицаСписокПоказателей", Отчет["СписокПоказателей"].Выгрузить());
	ЗапросПроверка.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Проверяемая таблица
	|//
	|ВЫБРАТЬ
	|	Т.НомерСтроки		КАК НомерСтроки,
	|	Т.СтатьяПлана		КАК СтатьяПлана,
	|	Т.ОтчетныйПериод	КАК ОтчетныйПериод,
	|	Т.Подразделение		КАК Подразделение,
	|	Т.Поступления		КАК Поступления,
	|	Т.Выбытия			КАК Выбытия
	|ПОМЕСТИТЬ
	|	СписокПоказателей
	|ИЗ
	|	&ТаблицаСписокПоказателей	КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Признаки незаполненных полей
	|//
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА СтатьяПлана = ЗНАЧЕНИЕ(Справочник.СтатьиПланаПоступленийВыбытий.ПустаяСсылка) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ		КАК ПустоеПолеСтатьяПлана,
	|	ВЫБОР
	|		КОГДА ОтчетныйПериод = ЗНАЧЕНИЕ(Справочник.Периоды.ПустаяСсылка) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ		КАК ПустоеПолеОтчетныйПериод,
	|	ВЫБОР
	|		КОГДА Поступления = 0 И Выбытия = 0 ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ		КАК ПустыеЗначения
	|ПОМЕСТИТЬ
	|	ПризнакиНезаполненныхПолей
	|ИЗ
	|	СписокПоказателей
	|;	
	|	
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Номера строк и коды ошибок
	|//		(Финальная таблица)
	|//
	|// Пустое поле СтатьяПлана
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки,
	|	1			КАК КодОшибки
	|ИЗ
	|	ПризнакиНезаполненныхПолей
	|ГДЕ
	|	ПустоеПолеСтатьяПлана
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Пустое поле ОтчетныйПериод
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки,
	|	2			КАК КодОшибки
	|ИЗ
	|	ПризнакиНезаполненныхПолей
	|ГДЕ
	|	ПустоеПолеОтчетныйПериод
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Пустые значения
	|ВЫБРАТЬ
	|	НомерСтроки	КАК НомерСтроки,
	|	3			КАК КодОшибки
	|ИЗ
	|	ПризнакиНезаполненныхПолей
	|ГДЕ
	|	ПустыеЗначения
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	КодОшибки
	|;";
	
	РезультатыПроверки = ЗапросПроверка.Выполнить();
	
	Если РезультатыПроверки.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Текст = НСтр("ru='Поле ""Отчетный период"" не заполнено (строка%1)'");
	
	Выборка = РезультатыПроверки.Выбрать();
	Текст = НСтр("ru='Поле ""Отчетный период"" не заполнено (строка%1)'");
	ИмяТаблЧастиДляВыводаСообщений = "СписокПоказателей";
	
	Пока Выборка.Следующий() Цикл
		НомерСтроки		= Выборка["НомерСтроки"];
		ИндексСтроки	= НомерСтроки - 1;
		
		Если Выборка["КодОшибки"] = 1 Тогда
			ТекстШаблон = НСтр("ru='Поле ""Статья плана"" не заполнено (строка%1)'");
			ИмяПоляДляВыводаСообщений = "СтатьяПлана";
			
		ИначеЕсли Выборка["КодОшибки"] = 2 Тогда
			ТекстШаблон = НСтр("ru='Поле ""Отчетный период"" не заполнено (строка%1)'");
			ИмяПоляДляВыводаСообщений = "ОтчетныйПериод";
			
		ИначеЕсли Выборка["КодОшибки"] = 3 Тогда
			ТекстШаблон = НСтр("ru='Не заполнено значение показателя (строка%1)'");
			ИмяПоляДляВыводаСообщений = "Поступления";
		КонецЕсли;
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстШаблон, Символы.НПП + НомерСтроки);
		
		ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстСообщения,
			,
			"Отчет." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ЕстьДублиСтрок()
	
	ИменаКолонок = Новый Массив();
	ИменаКолонок.Добавить("СтатьяПлана");
	ИменаКолонок.Добавить("ОтчетныйПериод");
	Если Параметры["ФОУчетПоПодразделениям"] Тогда
		ИменаКолонок.Добавить("Подразделение");
	КонецЕсли;
	
	ТаблицаДублиСтрок = УчетНДС.НайтиДублиСтрок(Отчет["СписокПоказателей"].Выгрузить(), ИменаКолонок);
	
	Если ТаблицаДублиСтрок.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыВывода = Новый Структура();
	ПараметрыВывода.Вставить("ТаблицаИмя", "Отчет.СписокПоказателей");
	
	УчетНДС.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область ИнформационныйЦентр

#КонецОбласти
