&НаСервере
Процедура ОбновитьНастройкиКомпоновщиков()
	
	НастройкиПоказатели	= Отчет.КомпоновщикНастроек.Настройки;
	НастройкиПланы		= Отчет.КомпоновщикНастроекПланы.Настройки;
	
	//
	// 1. Компоновщик настроек для СКД "Показатели"
	//
	
	// Общие свойства всего отчета - 
	// используем то, что задано в конфигураторе, ничего не меняем.
	
	// А группировки - настраиваем полностью программно.
	
	НастройкиПоказатели.Структура.Очистить();
	
	// Группировки
	ТекущийЭлементГруппировки = НастройкиПоказатели;
	Для Каждого СтрокаТаблицы Из Отчет["Группировка"] Цикл 
		
		Если НЕ СтрокаТаблицы["Использование"] Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = СтрокаТаблицы["Поле"];
		Если СтрокаТаблицы["ТипГруппировки"] = 0 Тогда
			ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
		ИначеЕсли СтрокаТаблицы["ТипГруппировки"] = 1 Тогда
			ТипГруппировки = ТипГруппировкиКомпоновкиДанных.ТолькоИерархия;
		Иначе
			// ТипГруппировки = 2
			ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
		КонецЕсли;
		
		// Новый уровень группировки
		ТекущийЭлементГруппировки = ТекущийЭлементГруппировки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		
		ПолеГруппировки = ТекущийЭлементГруппировки.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Использование  = Истина;
		ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных(ИмяПоля);
		ПолеГруппировки.ТипГруппировки = ТипГруппировки;
			
		ТекущийЭлементГруппировки.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		ТекущийЭлементГруппировки.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	КонецЦикла;
	
	// Детальные записи в самой последней группировке
	ЭлементДетальныхЗаписей = ТекущийЭлементГруппировки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ЭлементДетальныхЗаписей.Использование  = Истина;
	ЭлементДетальныхЗаписей.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	
	// Отключаем отбор по ИФО, если учет по ИФО не ведется:
	Если НЕ ФОУчетПоИФО Тогда
		ОтключитьОтборПоПолюИФО(НастройкиПоказатели.Отбор.Элементы);
	КонецЕсли;
	
	//
	// 2. Компоновщик настроек для СКД "Планы"
	//
	
	// Копируем отбор, установленный в основном компоновщике настроек:
	НастройкиПланы.Отбор.Элементы.Очистить();
	СкопироватьОтбор(НастройкиПланы.Отбор, НастройкиПоказатели.Отбор);
	
	// Устанавливаем значения параметров:
	НастройкиПланы.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", Отчет["Организация"]);
	НастройкиПланы.ПараметрыДанных.УстановитьЗначениеПараметра("ФОУчетПоИФО", ФОУчетПоИФО);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтключитьОтборПоПолюИФО(ЭлементыОтбора)
	
	Для Каждого Элем Из ЭлементыОтбора Цикл
		
		Если ТипЗнч(Элем) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			// Обнаружена группа элементов.
																			   
			// Рекурсивный вызов метода для этой группы:
			ОтключитьОтборПоПолюИФО(Элем.Элементы);
			
		Иначе
			// Обнаружен конечный элемент.
			
			// Это отбор по полю ИФО?
			Если Элем.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИФО") Тогда
				Элем.Использование = Ложь;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СкопироватьОтбор(ОтборПриемник, ОтборИсточник, ДопустимыеЭлементы = Неопределено)
	
	Если ДопустимыеЭлементы = Неопределено Тогда
		ДопустимыеЭлементы = ОтборПриемник.ДоступныеПоляОтбора;
	КонецЕсли;
	
	Для Каждого Элем Из ОтборИсточник.Элементы Цикл
		
		Если ТипЗнч(Элем) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			// Обнаружена группа элементов.
			
			// Создаем новый элемент-группу:
			НовыйЭлемент = ОтборПриемник.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, Элем);
																			   
			// Рекурсивное копирование элементов группы:
			СкопироватьОтбор(НовыйЭлемент, Элем, ДопустимыеЭлементы);
			
		Иначе
			// Обнаружен конечный элемент.
			
			ДоступныйЭлем = ДопустимыеЭлементы.НайтиПоле(Элем.ЛевоеЗначение);
			Если НЕ ДоступныйЭлем = Неопределено Тогда
				
				// Создаем новый элемент:
				НовыйЭлемент = ОтборПриемник.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЗаполнитьЗначенияСвойств(НовыйЭлемент, Элем);
				
			КонецЕсли;
			
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьОтборКлиент(ОтборПриемник, ОтборИсточник, ДопустимыеЭлементы = Неопределено)
	
	Если ДопустимыеЭлементы = Неопределено Тогда
		ДопустимыеЭлементы = ОтборПриемник.ДоступныеПоляОтбора;
	КонецЕсли;
	
	Для Каждого Элем Из ОтборИсточник.Элементы Цикл
		
		Если ТипЗнч(Элем) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			// Обнаружена группа элементов.
			
			// Создаем новый элемент-группу:
			НовыйЭлемент = ОтборПриемник.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, Элем);
																			   
			// Рекурсивное копирование элементов группы:
			СкопироватьОтборКлиент(НовыйЭлемент, Элем, ДопустимыеЭлементы);
			
		Иначе
			// Обнаружен конечный элемент.
			
			ДоступныйЭлем = ДопустимыеЭлементы.НайтиПоле(Элем.ЛевоеЗначение);
			Если НЕ ДоступныйЭлем = Неопределено Тогда
				
				// Создаем новый элемент:
				НовыйЭлемент = ОтборПриемник.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЗаполнитьЗначенияСвойств(НовыйЭлемент, Элем);
				
			КонецЕсли;
			
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//---
// Группировка
//---

&НаКлиенте
Процедура СдвинутьСтрокуГруппировки(Направление)
	
	Перем	ИндексСтрокиДоПеремещения,
			ИндексСтрокиПослеПеремещения;
	
	Если ВозможноПеремещениеТекущейСтрокиГруппировки(Направление, ИндексСтрокиДоПеремещения, ИндексСтрокиПослеПеремещения) Тогда
		
		ПоменятьМестамиСтрокиТЧГруппировка(Отчет["Группировка"], ИндексСтрокиДоПеремещения, ИндексСтрокиПослеПеремещения);
		
		УстановитьТекущуюСтрокуТЧГруппировка(ИндексСтрокиПослеПеремещения);
		
	КонецЕсли;
	
	НастроитьДоступностьКнопокТаблицыГруппировка();

КонецПроцедуры

&НаСервере
Процедура ЗапомнитьИспользованиеПолейГруппировки()
	
	Поиск = Новый Структура("Использование", Истина);
	
	ИменаПолей = Отчет["Группировка"].Выгрузить(Поиск, "Поле").ВыгрузитьКолонку("Поле");
	
	СпискиПолей["ПоляГруппировки"].Вставить("Выбранные", ИменаПолей);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПоменятьМестамиСтрокиТЧГруппировка(ТЧГруппировка, Индекс1, Индекс2)
	
	Строка1 = ТЧГруппировка[Индекс1];
	Строка2 = ТЧГруппировка[Индекс2];
	
	Стр = Новый Структура("Использование, Поле, Представление, Фиксация, ТипГруппировки");
	
	ЗаполнитьЗначенияСвойств(Стр, Строка1);
	ЗаполнитьЗначенияСвойств(Строка1, Строка2);
	ЗаполнитьЗначенияСвойств(Строка2, Стр);
	
КонецПроцедуры

&НаКлиенте
Функция ВозможноПеремещениеТекущейСтрокиГруппировки(Направление = "Вверх", ИндексСтрокиДоПеремещения = Неопределено, ИндексСтрокиПослеПеремещения = Неопределено)
	
	Перем	ИндексСтроки,
			ИндексСтрокиДопустимый;
	
	ТекДанные = Элементы["Группировка"].ТекущиеДанные;
	
	Если ТекДанные = Неопределено ИЛИ ТекДанные["Фиксация"] = Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НаправлениеВверх = (НРег(Направление) = "вверх");
	
	ШагПеремещения = ?(НаправлениеВверх, -1, 1);
	
	ИндексСтроки				= Отчет["Группировка"].Индекс(ТекДанные);
	ИндексСтрокиДоПеремещения	= ИндексСтроки;
	
	МинимальныйИндекс	= 0;
	МаксимальныйИндекс	= (Отчет["Группировка"].Количество() - 1);
	
	Пока Истина Цикл
		ИндексСтроки = ИндексСтроки + ШагПеремещения;
		
		ИндексСтрокиДопустимый = (ИндексСтроки >= МинимальныйИндекс И ИндексСтроки <= МаксимальныйИндекс);
		
		Если НЕ ИндексСтрокиДопустимый Тогда
			Прервать;
		КонецЕсли;
		
		СтрокаТаблицы = Отчет["Группировка"][ИндексСтроки];
		
		ИмяПоля = СтрокаТаблицы["Поле"];
		
		ПолеЗафиксировано = (СпискиПолей["ПоляГруппировки"]["Зафиксированные"].Найти(ИмяПоля) <> Неопределено);
		
		Если ПолеЗафиксировано Тогда
			Продолжить;
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ИндексСтрокиПослеПеремещения = ?(ИндексСтрокиДопустимый, ИндексСтроки, Неопределено);
	
	Возврат ИндексСтрокиДопустимый;
	
КонецФункции

&НаКлиенте
Процедура НастроитьДоступностьКнопокТаблицыГруппировка()
	
	Элементы.КнопкаГруппировкаВверх.Доступность = ВозможноПеремещениеТекущейСтрокиГруппировки("Вверх");
	
	Элементы.КнопкаГруппировкаВниз.Доступность = ВозможноПеремещениеТекущейСтрокиГруппировки("Вниз");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПанельНастроек(Видимость)
	
	Элементы.ГруппаПанельНастроек.Видимость = Видимость;
	
	Элементы.КнопкаПанельНастроек.Пометка = Элементы.ГруппаПанельНастроек.Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущуюСтрокуТЧГруппировка(ИндексСтроки)
	
	ИдСтроки = Отчет.Группировка[ИндексСтроки].ПолучитьИдентификатор();

	Элементы.Группировка.ТекущаяСтрока = ИдСтроки;
	
КонецПроцедуры

