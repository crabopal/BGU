&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение = Неопределено)
	
	ОрганизацияНовоеЗначение	= ВыбранноеЗначение;
	ОрганизацияПрежнееЗначение	= Отчет["Организация"];
	
	ЕстьИзмененияДанных	= (ИзмененныеПоказатели_Количество > 0 ИЛИ НовыеПоказатели_Количество > 0);
	ИзмененаОрганизация	= (НЕ ОрганизацияНовоеЗначение = ОрганизацияПрежнееЗначение);
	
	Если НЕ ИзмененаОрганизация Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	Если ЕстьИзмененияДанных Тогда
		СтандартнаяОбработка = Ложь;
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("ОрганизацияНовоеЗначение",	ОрганизацияНовоеЗначение);
		ПараметрыОповещения.Вставить("ОрганизацияПрежнееЗначение",	ОрганизацияПрежнееЗначение);
		
		ТекстСообщения = НСтр("ru='Изменение организации вызовет потерю
			|несохраненных значений показателей.
			|
			|Продолжить и сменить организацию?'");
			
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОрганизацияПередИзменениемКлиент_Ответ", ЭтотОбъект, ПараметрыОповещения);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		// Отменяем изменение организации
		Отчет["Организация"] = ПараметрыОповещения["ОрганизацияПрежнееЗначение"];
		
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Отчет["Организация"] = ПараметрыОповещения["ОрганизацияНовоеЗначение"];
		
		ЭтаФорма.Модифицированность = Истина;
		
		ОрганизацияПриИзмененииКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзмененииКлиент()
	
	ОчиститьТаблицуИзмененныеПоказатели();
	
	ОчиститьТаблицуНовыеПоказатели();
	
	ОбновитьКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЭлементаСправочника(Ссылка)
	
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.ПланыПоступленийВыбытий") Тогда
		ИмяСправочника = "ПланыПоступленийВыбытий";
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Субсидии") Тогда
		ИмяСправочника = "Субсидии";
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.СтатьиПланаПоступленийВыбытий") Тогда
		ИмяСправочника = "СтатьиПланаПоступленийВыбытий";
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Периоды") Тогда
		ИмяСправочника = "Периоды";
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
		ИмяСправочника = "ИсточникиФинансовогоОбеспечения";
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Подразделения") Тогда
		ИмяСправочника = "Подразделения";
		
	Иначе	
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Ключ", Ссылка);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОбновитьПослеЗакрытияОкна", ЭтотОбъект);
	ОткрытьФорму("Справочник." + ИмяСправочника + ".ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПослеЗакрытияОкна(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	ОбновитьКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИУдалитьНазначение(Отказ)
	
	Отказ = Истина;
	
	ДоступноУдалениеТекущейСтрокиТаблицыПланы = Элементы["ПланыКнопкаУдалитьЗапись"].Доступность;
	
	Если НЕ ДоступноУдалениеТекущейСтрокиТаблицыПланы Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы["Планы"].ТекущиеДанные;
	
	ПланПредставление = Строка(ТекДанные["План"]);
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Удалить выбранное назначение плана ""%1""?'"),
		ПланПредставление);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("СтруктураКлючаЗаписиНазначения",	ПолучитьСтруктуруКлючаЗаписиНазначения(ТекДанные));
	ДополнительныеПараметры.Вставить("ПланПредставление",				ПланПредставление);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИУдалитьНазначение_Ответ", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИУдалитьНазначение_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		УдалитьТекущееНазначениеКлиент(ПараметрыОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьТекущееНазначениеКлиент(ПараметрыОповещения)
	
	СтруктураКлючаЗаписиНазначения	= ПараметрыОповещения["СтруктураКлючаЗаписиНазначения"];
	ПланПредставление				= ПараметрыОповещения["ПланПредставление"];
	
	УдалитьЗаписьНазначенияПлана(СтруктураКлючаЗаписиНазначения);
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Удалено назначение плана ""%1""'"),
		ПланПредставление);
		
	ПоказатьОповещениеПользователя(ЭтаФорма.Заголовок,, ТекстСообщения, БиблиотекаКартинок.Информация32);
	
	ОбновитьКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗакрытьФормуБезусловно = Истина;
		
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОрганизацияЗаполненаВФорме()
	
	// Если организация не выбрана, то должна быть показана панель настроек
	// и установлен курсор в поле "Организация":
	ОрганизацияВыбрана = ЗначениеЗаполнено(Отчет["Организация"]);
	
	Если НЕ ОрганизацияВыбрана Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Выберите организацию'"),
			,
			"Организация");
	КонецЕсли;
	
	Возврат ОрганизацияВыбрана;
	
КонецФункции

&НаКлиенте
Процедура НастроитьНазначениеПоПлану()
	
	ЗначенияДоИзменения = ПолучитьПустуюСтруктуруПоляНазначения();
	ЗаполнитьЗначенияСвойств(ЗначенияДоИзменения, Элементы["Планы"].ТекущиеДанные);
	
	ПланСсылка = ЗначенияДоИзменения["План"];
	
	ПланСтруктура = ПолучитьПустуюСтруктуруПоляПлана();
	ЗаполнитьЗначенияСвойств(ПланСтруктура, ПланСсылка);
	
	// Необходимо проверить, что после того, как назначение будет настроено по плану,
	// не появится дубль назначения
	ПланируемаяАналитикаНазначения = ПолучитьПустуюСтруктуруПоляНазначения();
	ЗаполнитьЗначенияСвойств(ПланируемаяАналитикаНазначения, ЗначенияДоИзменения);
	ЗаполнитьЗначенияСвойств(ПланируемаяАналитикаНазначения, ПланСтруктура);
	
	РезультатПроверки = ОпределитьВозможностьНастроитьНазначениеПоПлану(ПланируемаяАналитикаНазначения);
	
	Если РезультатПроверки["НастройкаДопустима"] Тогда
		// Назначения с такой аналитикой не нашлось
		// Значит, можно внести изменения
		
		СтруктураКлючаДоИзменения		= ПолучитьСтруктуруКлючаЗаписиНазначения(ЗначенияДоИзменения);
		СтруктураКлючаПослеИзменения	= ПолучитьСтруктуруКлючаЗаписиНазначения(ПланируемаяАналитикаНазначения);
		
		ИзменитьЗаписьНазначенияПлана(СтруктураКлючаДоИзменения, СтруктураКлючаПослеИзменения);
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Настроено назначение по плану ""%1""'"),
			Строка(ПланСсылка));
			
		ПоказатьОповещениеПользователя(ЭтаФорма.Заголовок, , ТекстСообщения, БиблиотекаКартинок.Информация32);
		
		ОбновитьКлиент();
		
	Иначе
		// Нашлось назначение с такой аналитикой
		
		НайденнаяСтрокаНазначения = РезультатПроверки["СтрокаДереваПланы"];
		
		// Устанавливаем выделение строки
		НайденнаяСтрокаНазначения["флагВыделитьСтроку"] = Истина;
		
		ТекстСообщения = НСтр("ru='Настроить назначение по полану невозможно:
			|уже существует назначение с планируемой аналитикой'");
			
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("СтрокаДереваПланы", НайденнаяСтрокаНазначения);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("СброситьВыделеннуюСтрокуТаблицыПланы", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьПредупреждение(ОписаниеОповещенияОЗавершении, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьВыделеннуюСтрокуТаблицыПланы(ПараметрыОповещения) Экспорт
	
	СтрокаДереваПланы = ПараметрыОповещения["СтрокаДереваПланы"];
	
	// Снимаем выделение строки
	СтрокаДереваПланы["флагВыделитьСтроку"] = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьПоказатель()
	
	ТекДанные = Элементы["Показатели"].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	План = ТекДанные.План;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("ТекстСообщения",		НСтр("ru='Выберите назначение плана, по которому необходимо заполнить показатель'"));
	СтруктураПараметров.Вставить("План",				План);
	СтруктураПараметров.Вставить("ТекДанные",			ТекДанные);
	СтруктураПараметров.Вставить("ПоследующееДействие",	"НастроитьПоказательПоНазначению");
	
	НачатьВыборКорректногоНазначениеИПоследующееДействие(СтруктураПараметров);
	
КонецПроцедуры

&НаСервере
Функция ОпределитьКоординатыСтрокиДереваЗначений(Дерево, СтрокаДерева)
	
	Координаты = Новый Массив();
	
	ИндексыРодителей = Новый Массив();
	
	ТекущийРодитель = СтрокаДерева.Родитель;
	
	Если ТекущийРодитель = Неопределено Тогда
		ИндексСтрокиДерева = Дерево.Строки.Индекс(СтрокаДерева);
	Иначе
		ИндексСтрокиДерева = ТекущийРодитель.Строки.Индекс(СтрокаДерева);
	КонецЕсли;
	
	// Самый последний элемент массива - индекс детальной строки
	Координаты.Добавить(ИндексСтрокиДерева);
	
	Пока ТекущийРодитель <> Неопределено Цикл
		ВерхнийРодитель = ТекущийРодитель.Родитель;
		
		Если ВерхнийРодитель = Неопределено Тогда
			ИндексТекущегоРодителя = Дерево.Строки.Индекс(ТекущийРодитель);
		Иначе
			ИндексТекущегоРодителя = ВерхнийРодитель.Строки.Индекс(ТекущийРодитель);
		КонецЕсли;
		
		// Все остальные элементы массива, кроме самого последнего, - индексы родительских строк-группировок
		Координаты.Вставить(0, ИндексТекущегоРодителя);
		
		ТекущийРодитель = ВерхнийРодитель;
	КонецЦикла;
	
	Возврат Координаты;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИдентификаторСтрокиДереваПоКоординатам(РеквизитФормыДерево, Координаты)
	
	КоличествоКоординат = Координаты.Количество();
	
	ТекущийРодитель = РеквизитФормыДерево;
	
	Для Счетчик = 1 По КоличествоКоординат Цикл
		Координата = Координаты[Счетчик - 1];
		
		ЭтоПоследняяКоордината = (Счетчик = КоличествоКоординат);
		
		Если ЭтоПоследняяКоордината Тогда
			СтрокаПоказателя = ТекущийРодитель.ПолучитьЭлементы()[Координата];
			
			Возврат СтрокаПоказателя.ПолучитьИдентификатор();
		Иначе
			ТекущийРодитель = ТекущийРодитель.ПолучитьЭлементы()[Координата];
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

//
// Восстановление состояния раскрытия групп дерева показателей
//

&НаКлиенте
Процедура ЗапомнитьСписокОтображаемыхСтатей()
	
	СписокОтображаемыхСтатей = Новый СписокЗначений();
	
	Для Каждого ЭлементСтрокиДерева Из Показатели.ПолучитьЭлементы() Цикл
		
		ДобавитьОтображаемыеСтатьи(ЭлементСтрокиДерева, СписокОтображаемыхСтатей)
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОтображаемыеСтатьи(ЭлементСтрокиДерева, СписокСтатей)
	
	Если ЭлементСтрокиДерева["флагДетальнаяЗапись"] Тогда
		
		СписокСтатей.Добавить(ЭлементСтрокиДерева["СтатьяПлана"]);
		
	Иначе
		
		// Обходим только раскрытые группы
		Если Элементы["Показатели"].Развернут(ЭлементСтрокиДерева.ПолучитьИдентификатор()) Тогда
			Для Каждого ДочернийЭлементСтрокиДерева Из ЭлементСтрокиДерева.ПолучитьЭлементы() Цикл
				
				ДобавитьОтображаемыеСтатьи(ДочернийЭлементСтрокиДерева, СписокСтатей);
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьНовыхРодителейОтображаемыхСтатей(Дерево)
	
	БлижайшиеРодители = Новый Массив();
	
	НовыеРодители = Новый Массив();
	
	Поиск = Новый Структура("флагСтатьяПланаОтображается", Истина);
	
	МассивСтрок = Дерево.Строки.НайтиСтроки(Поиск, Истина);
	
	Для Каждого СтрокаДерева Из МассивСтрок Цикл
		ИндексыРодителей = Новый Массив();
		
		ТекущийРодитель = СтрокаДерева.Родитель;
		
		БлижайшийРодительУжеУчтен = (БлижайшиеРодители.Найти(ТекущийРодитель) <> Неопределено);
		
		Если БлижайшийРодительУжеУчтен Тогда
			Продолжить;
		Иначе
			БлижайшиеРодители.Добавить(ТекущийРодитель);
		КонецЕсли;
		
		Пока ТекущийРодитель <> Неопределено Цикл
			ВерхнийРодитель = ТекущийРодитель.Родитель;
			
			Если ВерхнийРодитель = Неопределено Тогда
				ИндексТекущегоРодителя = Дерево.Строки.Индекс(ТекущийРодитель);
			Иначе
				ИндексТекущегоРодителя = ВерхнийРодитель.Строки.Индекс(ТекущийРодитель);
			КонецЕсли;
			
			ИндексыРодителей.Вставить(0, ИндексТекущегоРодителя);
			
			ТекущийРодитель = ВерхнийРодитель;
		КонецЦикла;
		
		Если ИндексыРодителей.Количество() > 0 Тогда
			НовыеРодители.Добавить(ИндексыРодителей);
		КонецЕсли;
	КонецЦикла;
	
	ВосстановлениеСпискаСтатей_Координаты = Новый ФиксированныйМассив(НовыеРодители);
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьКоординатыТекущейСтрокиДереваПоказатели()
	
	Поиск = Новый Структура("флагЭтоТекущаяСтрока", Истина);
	
	МассивСтрок = Дерево.Строки.НайтиСтроки(Поиск, Истина);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Координаты = ОпределитьКоординатыСтрокиДереваЗначений(Дерево, МассивСтрок[0]);
	Иначе
		Координаты = Новый Массив();
	КонецЕсли;
	
	ВосстановлениеТекущейСтроки_Координаты = Новый ФиксированныйМассив(Координаты);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьСписокОтображаемыхСтатей()
	
	Для Каждого ИндексыРодителей Из ВосстановлениеСпискаСтатей_Координаты Цикл
		
		ТекущийРодитель = Показатели;
		
		Для Каждого ИндексРодителя Из ИндексыРодителей Цикл
			ТекущийРодитель = ТекущийРодитель.ПолучитьЭлементы()[ИндексРодителя];
		КонецЦикла;
		
		ИдСтроки = ТекущийРодитель.ПолучитьИдентификатор();
		
		Элементы["Показатели"].Развернуть(ИдСтроки);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТекущуюСтрокуВТаблицеПоказатели()
	
	ИдентификаторСтроки = ПолучитьИдентификаторСтрокиДереваПоКоординатам(ЭтаФорма["Показатели"], ВосстановлениеТекущейСтроки_Координаты);
	
	Элементы["Показатели"].ТекущаяСтрока = ИдентификаторСтроки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьАналитикуТекущейСтрокиТаблицыПоказатели()
	
	ТекДанные = Элементы["Показатели"].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(АналитикаТекущейСтрокиТаблицыПоказатели, ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьАналитикуТекущейСтрокиТаблицыПланы()
	
	ЗаполнитьЗначенияСвойств(АналитикаТекущейСтрокиТаблицыПланы, Элементы["Планы"].ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьТекущуюСтрокуВТаблицеПланы()
	
	ИдентификаторСтроки = ПолучитьИдентификаторСтрокиДереваПоКоординатам(ЭтаФорма["Планы"], ВосстановлениеТекущейСтрокиПланы_Координаты);
	
	Элементы["Планы"].ТекущаяСтрока = ИдентификаторСтроки;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуАналитикаТекущейСтроки()
	
	ТаблицаАналитикаТекущейСтроки = Новый ТаблицаЗначений();
	
	Для Каждого ЭлементАналитики Из АналитикаТекущейСтрокиТаблицыПоказатели Цикл
		ИмяПоля = ЭлементАналитики.Ключ;
		
		ТаблицаАналитикаТекущейСтроки.Колонки.Добавить(ИмяПоля);
	КонецЦикла;
	
	НоваяСтрока = ТаблицаАналитикаТекущейСтроки.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, АналитикаТекущейСтрокиТаблицыПоказатели);
	
	// Меняем имена колонок для соответствия именам полей внешнего набора данных в скд
	ДобавляемыйПрефикс = "АТС_";
	Для Каждого Колонка Из ТаблицаАналитикаТекущейСтроки.Колонки Цикл
		Колонка.Имя = ДобавляемыйПрефикс + Колонка.Имя;
	КонецЦикла;
	
	Возврат ТаблицаАналитикаТекущейСтроки;
	
КонецФункции

&НаКлиенте
Функция ПолучитьТекстПоясненияДляИскаженногоНазначения()
	
	Возврат НСтр("ru='
		|Обнаружено несогласованное значение поля ИФО в аналитике назначения.
		|
		|В регистре сведений ""Планы по поступлениям (выбытиям) организаций""
		|для выбранного назначения указано значение ИФО, однако учет по ИФО не ведется.
		|
		|Для возможности дальнейшей работы в Помощнике с этим назначением 
		|необходимо привести выбранное назначение в согласованное состояние.
		|Для чего:
		| - либо очистить поле ИФО в регистре сведений у этого назначения;
		| - либо включить учет по ИФО в программе.'");
		
КонецФункции

#КонецОбласти

