&НаКлиенте
Процедура ПроверитьИСоздатьДокументы()
	
	Если ИзмененныеПоказатели_Количество = 0 И НовыеПоказатели_Количество = 0 Тогда
		ТекстСообщения = НСтр("ru='В значения показателей не внесено изменений.
			|
			|Запись значений показателей в базу не произведена.'");
			
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru='Будут созданы новые документы ""Плановые назначения"",
		|которые установят указанные значения плановых показателей.
		|
		|Продолжить и создать документы?'");
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИСоздатьДокументы_Ответ", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИСоздатьДокументы_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Согласились создать документы
		
		// Создаем и проводим документы, очищаем таблицы, заново считываем всю информацию из базы
		СоздатьДокументыИОбновитьСервер();
		
		// Текущую строку дерева Показатели не восстанавливаем
		
		// Настраиваем вид полученных деревьев
		КлиентОбновитьДоступность();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИУдалитьПоказатель()
	
	Если НЕ Элементы["ПоказателиКнопкаУдалить"].Доступность Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы["Показатели"].ТекущиеДанные;
	ТекСтрока = Элементы["Показатели"].ТекущаяСтрока;
	
	Поступления			= Строка(ТекДанные["Поступления"]);
	Выбытия				= Строка(ТекДанные["Выбытия"]);
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Удалить показатель?
		    |
			|Поступления:  %1
			|Выбытия:  %2'"),
		Поступления,
		Выбытия);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТекДанные",	ТекДанные);
	ДополнительныеПараметры.Вставить("ТекСтрока",	ТекСтрока);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИУдалитьПоказатель_Ответ", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИУдалитьПоказатель_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		ТекДанные	= ПараметрыОповещения["ТекДанные"];
		ТекСтрока	= ПараметрыОповещения["ТекСтрока"];
		
		// Итоги
		ИтогоПоступления	= ИтогоПоступления	- ТекДанные["Поступления"];
		ИтогоВыбытия		= ИтогоВыбытия		- ТекДанные["Выбытия"];
		
		УдалитьСтрокуНовогоПоказателя(ТекДанные);
		
		// Обновляем статистику сеанса работы
		НовыеПоказатели_Количество = НовыеПоказатели.Количество();
		НовыеПоказатели_КоличествоОтбор = НовыеПоказатели_КоличествоОтбор - 1;
		НовыеПоказатели_Надпись = ПолучитьТекстЗаголовка_НовыеПоказатели_Надпись(НовыеПоказатели_Количество, НовыеПоказатели_КоличествоОтбор);
		
		Если НЕ ПоказательЯвляетсяКорректным(ТекДанные) Тогда
			КоличествоНекорректныхПоказателей = КоличествоНекорректныхПоказателей - 1;
			
			НастроитьФормуСервер_НадписьОНекорректныхПоказателях();
		КонецЕсли;
		
		// Удаляем текущую строку таблицы "Показатели"
		УдалитьСтрокуТаблицыПоказатели(ТекСтрока);
	КонецЕсли;
	
КонецПроцедуры

