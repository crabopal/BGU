&НаКлиенте
Процедура ДобавитьСтрокуИзмененногоПоказателя(СтрокаРедактируемогоПоказателя, ЗначенияПослеИзменения)
	
	СтрокаТаблицы = ИзмененныеПоказатели.Добавить();
	
	СтрокаТаблицы.УдовлетворяетОтбору = Истина;
	
	// Ядро аналитики
	Для Каждого ИмяПоля Из СпискиПолей["ПоляТаблицыПоказатели"]["Аналитика"]["Ядро"] Цикл
		СтрокаТаблицы[ИмяПоля] = СтрокаРедактируемогоПоказателя[ИмяПоля];
	КонецЦикла;
	
	// Редактируемые поля
	Для Каждого ИмяПоля Из СпискиПолей["ПоляТаблицыПоказатели"]["РедактируемыеПоляПоказателя"] Цикл
		ИмяКолонкиДоИзменения		= ИмяПоля;
		ИмяКолонкиПослеИзменения	= ИмяПоля + "Нов";
		
		СтрокаТаблицы[ИмяКолонкиДоИзменения]	= СтрокаРедактируемогоПоказателя[ИмяПоля];
		СтрокаТаблицы[ИмяКолонкиПослеИзменения] = ЗначенияПослеИзменения[ИмяПоля];
	КонецЦикла;
	
	// Обновляем статистику сеанса работы
	ИзмененныеПоказатели_Количество = ИзмененныеПоказатели.Количество();
	ИзмененныеПоказатели_КоличествоОтбор = ИзмененныеПоказатели_КоличествоОтбор + 1;
	ИзмененныеПоказатели_Надпись = ПолучитьТекстЗаголовка_ИзмененныеПоказатели_Надпись(
		ИзмененныеПоказатели_Количество,
		ИзмененныеПоказатели_КоличествоОтбор);
		
	ИзмененныеПоказатели_МаксимальныйИдСтроки = ИзмененныеПоказатели_МаксимальныйИдСтроки + 1;
	ИдСтроки = ИзмененныеПоказатели_МаксимальныйИдСтроки;
	СтрокаТаблицы["ИдСтроки"] = ИдСтроки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтрокуИзмененногоПоказателя(СтрокаТаблицыИзмененныеПоказатели, ЗначенияПослеИзменения)
	
	// Только редактируемые поля, ядро аналитики не изменяется
	Для Каждого ИмяПоля Из СпискиПолей["ПоляТаблицыПоказатели"]["РедактируемыеПоляПоказателя"] Цикл
		ИмяКолонкиПослеИзменения = ИмяПоля + "Нов";
		
		СтрокаТаблицыИзмененныеПоказатели[ИмяКолонкиПослеИзменения] = ЗначенияПослеИзменения[ИмяПоля];
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция СовпадаютРедактируемыеПоляПоказателей(Показатель1, Показатель2)
	
	ПолностьюСовпадают = Истина;
	
	Для Каждого ИмяПоля Из СпискиПолей["ПоляТаблицыПоказатели"]["РедактируемыеПоляПоказателя"] Цикл
		Если Показатель1[ИмяПоля] <> Показатель2[ИмяПоля] Тогда
			ПолностьюСовпадают = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПолностьюСовпадают;
	
КонецФункции
	
