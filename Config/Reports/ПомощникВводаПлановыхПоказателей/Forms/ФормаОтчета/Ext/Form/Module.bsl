	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Показатели.флагИскаженоЗначениеИФО");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	Условие = ГруппаИЛИ1.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Показатели.флагИскаженоЗначениеПодразделение");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Показатели");
	
	
	//---
	// 14. Таблица "Показатели" - Искаженный показатель
	//---
	ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Таблица ""Показатели"" - Искаженный показатель'");
	
	// Условие
	ГруппаИЛИ1 = ЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаИЛИ1.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ;

	Условие = ГруппаИЛИ1.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Показатели.флагИскаженоЗначениеИФО");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	Условие = ГруппаИЛИ1.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Показатели.флагИскаженоЗначениеПодразделение");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню, , , Ложь, Истина, Ложь, Ложь));
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Показатели");
	
	
	УстановитьУсловноеОформление_НезаполненныеПоляТаблицыПоказатели();
	
	Отчеты.ПомощникВводаПлановыхПоказателей.УстановитьУсловноеОформление_ВидКПСБУАУ(ЭтаФорма, "Планы");
	Отчеты.ПомощникВводаПлановыхПоказателей.УстановитьУсловноеОформление_ВидКПСБУАУ(ЭтаФорма, "Показатели");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление_НезаполненныеПоляТаблицыПоказатели()
	
	ОбозначенияПустыхПолей = Новый Структура();
	
	ИмяПоля = "СтатьяПлана";
	Обозначения = Новый Структура();
	Обозначения.Вставить("КолонкаСсылка",		НСтр("ru='<Статья пустая>'"));
	Обозначения.Вставить("ПерсональнаяКолонка",	НСтр("ru='<пустая>'"));
	ОбозначенияПустыхПолей.Вставить(ИмяПоля, Обозначения);
	
	ИмяПоля = "План";
	Обозначения = Новый Структура();
	Обозначения.Вставить("КолонкаСсылка",		НСтр("ru='<План пустой>'"));
	Обозначения.Вставить("ПерсональнаяКолонка",	НСтр("ru='<пустой>'"));
	ОбозначенияПустыхПолей.Вставить(ИмяПоля, Обозначения);
	
	ИмяПоля = "ВидПоказателя";
	Обозначения = Новый Структура();
	Обозначения.Вставить("КолонкаСсылка",		НСтр("ru='<Вид показателя пустой>'"));
	Обозначения.Вставить("ПерсональнаяКолонка",	НСтр("ru='<пустой>'"));
	ОбозначенияПустыхПолей.Вставить(ИмяПоля, Обозначения);
	
	ИмяПоля = "Субсидия";
	Обозначения = Новый Структура();
	Обозначения.Вставить("КолонкаСсылка",		НСтр("ru='<Субсидия пустая>'"));
	Обозначения.Вставить("ПерсональнаяКолонка",	НСтр("ru='<пустая>'"));
	ОбозначенияПустыхПолей.Вставить(ИмяПоля, Обозначения);
	
	ИмяПоля = "ОтчетныйПериод";
	Обозначения = Новый Структура();
	Обозначения.Вставить("КолонкаСсылка",		НСтр("ru='<Период пустой>'"));
	Обозначения.Вставить("ПерсональнаяКолонка",	НСтр("ru='<пустой>'"));
	ОбозначенияПустыхПолей.Вставить(ИмяПоля, Обозначения);
	
	ИмяПоля = "КФО";
	Обозначения = Новый Структура();
	Обозначения.Вставить("КолонкаСсылка",		НСтр("ru='<КФО пустой>'"));
	Обозначения.Вставить("ПерсональнаяКолонка",	НСтр("ru='<пустой>'"));
	ОбозначенияПустыхПолей.Вставить(ИмяПоля, Обозначения);
	
	ИмяПоля = "ИФО";
	Обозначения = Новый Структура();
	Обозначения.Вставить("КолонкаСсылка",		НСтр("ru='<ИФО пустой>'"));
	Обозначения.Вставить("ПерсональнаяКолонка",	НСтр("ru='<пустой>'"));
	ОбозначенияПустыхПолей.Вставить(ИмяПоля, Обозначения);
	
	ИмяПоля = "Подразделение";
	Обозначения = Новый Структура();
	Обозначения.Вставить("КолонкаСсылка",		НСтр("ru='<Подразделение пустое>'"));
	Обозначения.Вставить("ПерсональнаяКолонка",	НСтр("ru='<пустое>'"));
	ОбозначенияПустыхПолей.Вставить(ИмяПоля, Обозначения);
	
	Для Каждого ЭлементОбозначение Из ОбозначенияПустыхПолей Цикл
		
		ИмяПоля	= ЭлементОбозначение.Ключ;
		Тексты	= ЭлементОбозначение.Значение;
		
		// Для поля СтатьяПлана есть особенность.
		// Оно всегда выводится не в персональной колонке,
		// а в другой - в колонке Ссылка.
		ПолеВыводитсяВПерсональнойКолонке = (НЕ ИмяПоля = "СтатьяПлана");
		
		//---
		// Строки группировки, оформление пустого поля Ссылка
		//---
		ТекстПустогоЗначения = Тексты["КолонкаСсылка"];
		
		Элем = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		Элем.Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Таблица ""Показатели"", строка группировки по %1 - текст ""%2"" в поле Ссылка'"),
			ИмяПоля,
			ТекстПустогоЗначения);
		
		// Условие
		Условие = Элем.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("Показатели.ИмяПоляГруппировки");
		Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение	= ИмяПоля;
		
		Условие = Элем.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("Показатели.Ссылка");
		Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.НеЗаполнено;
		Условие.ПравоеЗначение	= Истина;
		
		// Оформление
		Элем.Оформление.УстановитьЗначениеПараметра("Текст", ТекстПустогоЗначения);
		
		// Оформляемые поля
		ОформляемоеПоле = Элем.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ПоказателиСсылка");
		
		
		//---
		// Детальные строки, оформление пустой персональной колонки
		//---
		Если ПолеВыводитсяВПерсональнойКолонке Тогда
			ТекстПустогоЗначения = Тексты["ПерсональнаяКолонка"];
			
			Элем = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
			Элем.Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Таблица ""Показатели"", детальная строка - текст ""%1"" в поле %2'"),
				ТекстПустогоЗначения,
				ИмяПоля);
			
			// Условие
			Условие = Элем.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("Показатели." + ИмяПоля);
			Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.НеЗаполнено;
			Условие.ПравоеЗначение	= Истина;
			
			Условие = Элем.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("Показатели.флагДетальнаяЗапись");
			Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
			Условие.ПравоеЗначение	= Истина;
			
			// Оформление
			Элем.Оформление.УстановитьЗначениеПараметра("Текст", ТекстПустогоЗначения);
			
			// Оформляемые поля
			ОформляемоеПоле = Элем.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Показатели" + ИмяПоля);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

