КонецПроцедуры

&НаКлиенте
Процедура ГруппировкаПриАктивизацииСтроки(Элемент)
	НастроитьДоступностьКнопокТаблицыГруппировка();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Отбор

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиОтборПриИзменении(Элемент)
	
	ИзмененОтбор = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Планы

// Настраивает доступность кнопок командной панели.
&НаКлиенте
Процедура ПланыПриАктивизацииСтроки(Элемент)
	
	ЗапомнитьАналитикуТекущейСтрокиТаблицыПланы();
	
	НастроитьДоступностьДействийПланы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПланыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяПоля = Поле.Имя;
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ТекДанные["флагДетальнаяЗапись"] Тогда
		// Выбрали детальную строку с назначением
		
		ЭтоИскаженноеНазначение = ТекДанные["флагИскаженоЗначениеИФО"];
		
		Если ЭтоИскаженноеНазначение Тогда
			ТекстСообщения = НСтр("ru='Выбранное назначение не может быть показано.
				|'") + ПолучитьТекстПоясненияДляИскаженногоНазначения();
				
			ПоказатьПредупреждение(, ТекстСообщения, , ТекстЗаголовкаСообщений);
			
			Возврат;
		КонецЕсли;
		
    	Ключ = ПолучитьКлючЗаписи(ПолучитьСтруктуруКлючаЗаписиНазначения(ТекДанные));
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("Ключ",								Ключ);
		ПараметрыФормы.Вставить("ПомощникВводаПлановыхПоказателей",	Новый Структура());
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеЗакрытияОкнаРедактированияНазначения", ЭтотОбъект);
		
		ОткрытьФорму("РегистрСведений.ПланыПоПоступлениямВыбытиямОрганизаций.ФормаЗаписи", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		// Выбрали строку-группу с планом
		
		ОткрытьФормуЭлементаСправочника(ТекДанные["План"]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	// Если добавление новой строки недоступно, то выходим
	Если НЕ Элементы["ПланыКнопкаДобавитьЗапись"].Доступность Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы["Планы"].ТекущиеДанные;
	
	// Добавляемое назначение автоматически заполняется по плану
	Если ТекДанные["флагДетальнаяЗапись"] Тогда
		СтрокаТаблицы = Планы.НайтиПоИдентификатору(Элементы["Планы"].ТекущаяСтрока);
		
		ТекДанные = СтрокаТаблицы.ПолучитьРодителя();
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура();
	ЗначенияЗаполнения.Вставить("Организация",				Отчет["Организация"]);
	ЗначенияЗаполнения.Вставить("КФО",						ТекДанные["КФО"]);
	ЗначенияЗаполнения.Вставить("ВидПоказателя",			ТекДанные["ВидПоказателя"]);
	ЗначенияЗаполнения.Вставить("УточнениеПоказателя",		ТекДанные["УточнениеПоказателя"]);
	ЗначенияЗаполнения.Вставить("Субсидия",					ТекДанные["Субсидия"]);
	ЗначенияЗаполнения.Вставить("ИФО",						ТекДанные["ИФО"]);
	ЗначенияЗаполнения.Вставить("ПланПоступленийВыбытий",	ТекДанные["План"]);
	
	СтруктураНастроек = Новый Структура();
	СтруктураНастроек.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ПомощникВводаПлановыхПоказателей", СтруктураНастроек);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеЗакрытияОкнаРедактированияНазначения", ЭтотОбъект);
	
	ОткрытьФорму("РегистрСведений.ПланыПоПоступлениямВыбытиямОрганизаций.ФормаЗаписи", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияОкнаРедактированияНазначения(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(АналитикаТекущейСтрокиТаблицыПланы, РезультатВыбора);
	
	ОбновитьКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПланыПередУдалением(Элемент, Отказ)
	
	ПроверитьИУдалитьНазначение(Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Показатели

&НаКлиенте
Процедура ПоказателиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяПоля = Поле.Имя;
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ТекДанные["флагДетальнаяЗапись"] Тогда
		// Выбрана детальная строка
		// Открываем форму редактирования показателя
		
		ОткрытьФормуРедактированияПоказателя(ТекДанные)
		
	ИначеЕсли ИмяПоля = "ПоказателиСсылка" Тогда
		// Выбрана колонка Ссылка
		// Открываем элемент справочника
		
		Ссылка = ТекДанные["Ссылка"];
		
		Если ЗначениеЗаполнено(Ссылка) Тогда
			ОткрытьФормуЭлементаСправочника(Ссылка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказателиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	ТекДанные = Элементы["Показатели"].ТекущиеДанные;
	
	КопироватьТекущийПоказатель = Копирование И ТекДанные <> Неопределено И ТекДанные["флагДетальнаяЗапись"];
	
	Если КопироватьТекущийПоказатель Тогда
		ОткрытьФормуРедактированияПоказателя(ТекДанные, Копирование);
	Иначе		
		ВыбратьПланИОткрытьФормуНовогоПоказателя();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказателиПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ПроверитьИУдалитьПоказатель();
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПоказателиПриАктивизацииСтроки(Элемент)
	
	ЗапомнитьАналитикуТекущейСтрокиТаблицыПоказатели();
	
	НастроитьДоступностьДействийПоказатели();
	
КонецПроцедуры

