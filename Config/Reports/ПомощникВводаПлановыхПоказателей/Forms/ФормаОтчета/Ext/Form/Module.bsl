	НастроитьТаблицуДокументы();
	
	Элементы["СписокДокументов"].Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ЕстьНекорректныеНазначения(Команда)
	
	ТекстСообщения = НСтр("ru='Имеются некорректные назначения.
		|
		|Это такие назначения, у которых:
		| - либо аналитика отличается от аналитики плана;
		| - либо значение ИФО является несогласованным.'");
		
	ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	
КонецПроцедуры

&НаКлиенте
Процедура ЕстьНекорректныеПоказатели(Команда)
	
	ТекстСообщения = НСтр("ru='Имеются некорректные показатели.
		|
		|Это такие показатели, у которых:
		| - либо отсутствует назначение;
		| - либо назначение является некорректным;
		| - либо значения ИФО, Подразделение является несогласованными.'");
		
	ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКНазначению(Команда)
	
	ПроверитьИПерейтиКНазначению();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьИПерейтиКНазначению()
	
	ТекДанные = Элементы["Показатели"].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные["флагДетальнаяЗапись"] Тогда
		
		Если ТекДанные["флагОтсутствуетНазначение"] Тогда
			ТекстСообщения = НСтр("ru='Необходимо выбрать показатель, имеющий назначение.
				|Сейчас выбран показатель без назначения'");
			
			ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
			
			Возврат;
		КонецЕсли;
		
	Иначе
		ТекстСообщения = НСтр("ru='Необходимо выбрать строку показателя.
			|Сейчас выбрана строка группировки'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
		Возврат;
	КонецЕсли;
	
	ПерейтиКНазначениюКлиент(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКНазначениюКлиент(СтрокаДереваПоказатели)
	
	НазначениеСтруктура = ПолучитьПустуюСтруктуруПоляНазначения();
	
	ЗаполнитьЗначенияСвойств(НазначениеСтруктура, СтрокаДереваПоказатели);

	КоординатыСтроки = ПолучитьКоординатыСтрокиНазначения(НазначениеСтруктура);
	
	ИдентификаторСтроки = ПолучитьИдентификаторСтрокиДереваПоКоординатам(Планы, КоординатыСтроки);
	
	Элементы["Планы"].ТекущаяСтрока = ИдентификаторСтроки;
	
КонецПроцедуры

