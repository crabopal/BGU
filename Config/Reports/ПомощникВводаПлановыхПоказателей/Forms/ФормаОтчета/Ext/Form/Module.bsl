&НаСервере
Процедура ВывестиВДеревоПоказатели()
	
	// Все показатели:
	//	из базы + измененные + новые
	Таблица = ПолучитьВсеПоказатели();
	
	СКД = ПолучитьИзВременногоХранилища(Отчет.СКДПоказателиСсылка);
	
	ВнешниеНаборыДанных = Новый Структура();
	ВнешниеНаборыДанных.Вставить("Показатели",				Таблица);
	ВнешниеНаборыДанных.Вставить("АналитикаТекущейСтроки",	ПолучитьТаблицуАналитикаТекущейСтроки());
	
	НовыйКомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД));
	НовыйКомпоновщикНастроек.ЗагрузитьНастройки(Отчет.КомпоновщикНастроек.Настройки);
	
	// Значения параметров
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "СписокОтображаемыхСтатей", СписокОтображаемыхСтатей);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(
		СКД,											// 1
		НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
		,												// 3
		,												// 4
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); //5
		
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных();
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных, ВнешниеНаборыДанных);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
	
	Дерево = Новый ДеревоЗначений();
	ПроцессорВывода.УстановитьОбъект(Дерево);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	// Дозаполняем служебные колонки
	ДозаполнитьДеревоПоказатели();
	
	ПрочитатьИтогиИСтатистику_Показатели(Дерево);
	
	// Восстановление текущей строки
	ОпределитьКоординатыТекущейСтрокиДереваПоказатели();
	
	// Восстановление состава отображаемых показателей
	ОпределитьНовыхРодителейОтображаемыхСтатей(Дерево);
	
	ЗначениеВРеквизитФормы(Дерево, "Показатели");
	
КонецПроцедуры

&НаСервере
Процедура ДозаполнитьДеревоПоказатели()
	
	ДобавитьКолонкиВДеревоПоказателей();
	
	// Дозаполняем строки группировок
	СтруктурыПоискаГруппировок = ПолучитьСтруктурыПоискаГруппировок();
	Для Каждого ИмяПоля Из СпискиПолей["ПоляГруппировки"]["Выбранные"] Цикл
		Поиск = СтруктурыПоискаГруппировок[ИмяПоля];
		
		МассивСтрок = Дерево.Строки.НайтиСтроки(Поиск, Истина);
		
		Для Каждого СтрокаДерева Из МассивСтрок Цикл
			СтрокаДерева["Ссылка"]				= СтрокаДерева[ИмяПоля];
			СтрокаДерева["ИмяПоляГруппировки"]	= ИмяПоля;
			
			Если ИмяПоля = "План" Тогда
				СтрокаДерева["ИндексКартинки"]	= СтрокаДерева["ПланИндексКартинки"];
				
			ИначеЕсли ИмяПоля = "СтатьяПлана" Тогда
				СтрокаДерева["ИндексКартинки"]	= СтрокаДерева["СтатьяПланаИндексКартинки"];
				
			ИначеЕсли ИмяПоля = "ИФО" Тогда
				СтрокаДерева["ИндексКартинки"]	= СтрокаДерева["ИФОИндексКартинки"];
				
			ИначеЕсли ИмяПоля = "Субсидия" Тогда
				СтрокаДерева["ИндексКартинки"]	= СтрокаДерева["СубсидияИндексКартинки"];
				
			Иначе
				// Все прочие группировки
				СтрокаДерева["ИндексКартинки"]	= -1;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	// Сначала сбрасываем признак принадлежности отбору у модиф.показателей
	Для Каждого СтрокаПоказателя Из ИзмененныеПоказатели Цикл
		СтрокаПоказателя["УдовлетворяетОтбору"] = Ложь;
	КонецЦикла;
	Для Каждого СтрокаПоказателя Из НовыеПоказатели Цикл
		СтрокаПоказателя["УдовлетворяетОтбору"] = Ложь;
	КонецЦикла;
	
	
	// Обходим детальные строки
	Поиск = Новый Структура("флагДетальнаяЗапись",	Истина);
	МассивДетальныхСтрок = Дерево.Строки.НайтиСтроки(Поиск, Истина);
	
	Поиск = Новый Структура("ИдСтроки");
	
	Для Каждого ДетальнаяСтрока Из МассивДетальныхСтрок Цикл
		ДетальнаяСтрока["Ссылка"] = ДетальнаяСтрока["СтатьяПлана"];
		
		Если ДетальнаяСтрока["флагПоказательНовый"] Тогда
			ДетальнаяСтрока["Карт"] = БиблиотекаКартинок.ПоказательНовый;
			
			// Признаки принадлежности отбору
			ЗаполнитьЗначенияСвойств(Поиск, ДетальнаяСтрока);
			МассивСтрокУдовлетворяетОтбору = НовыеПоказатели.НайтиСтроки(Поиск);
			Для Каждого СтрокаДерева Из МассивСтрокУдовлетворяетОтбору Цикл
				СтрокаДерева["УдовлетворяетОтбору"] = Истина;
			КонецЦикла;
			
		ИначеЕсли ДетальнаяСтрока["флагПоказательИзменен"] Тогда
			ДетальнаяСтрока["Карт"] = БиблиотекаКартинок.ПоказательИзменен;
			
			// Признаки принадлежности отбору
			ЗаполнитьЗначенияСвойств(Поиск, ДетальнаяСтрока);
			МассивСтрокУдовлетворяетОтбору = ИзмененныеПоказатели.НайтиСтроки(Поиск);
			Для Каждого СтрокаДерева Из МассивСтрокУдовлетворяетОтбору Цикл
				СтрокаДерева["УдовлетворяетОтбору"] = Истина;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьИтогиИСтатистику_Показатели(Дерево)
	
	// Общие итоги
	СтрокаИтогов = Дерево.Строки[0];
	
	ИтогоПоступления	= СтрокаИтогов["Поступления"];
	ИтогоВыбытия		= СтрокаИтогов["Выбытия"];
	
	// Статистика
	
	ИзмененныеПоказатели_КоличествоОтбор	= СтрокаИтогов["КоличествоПоказателей_Измененные"];
	НовыеПоказатели_КоличествоОтбор			= СтрокаИтогов["КоличествоПоказателей_Новые"];
	
	// Количество некорректных показателей
	КоличествоНекорректныхПоказателей = СтрокаИтогов["КоличествоНекорректныхПоказателей"];
	
	// Количество новых показателей
	Поиск = Новый Структура("флагПоказательНовый", Истина);
	МассивСтрок = Дерево.Строки.НайтиСтроки(Поиск, Истина);
	Показатели_КоличествоНовые = МассивСтрок.Количество();
	
	// Количество измененных показателей
	Поиск = Новый Структура("флагПоказательИзменен", Истина);
	МассивСтрок = Дерево.Строки.НайтиСтроки(Поиск, Истина);
	Показатели_КоличествоИзмененные = МассивСтрок.Количество();
	
	// Количество прочих показателей
	Поиск = Новый Структура();
	Поиск.Вставить("флагДетальнаяЗапись",	Истина);
	Поиск.Вставить("флагПоказательНовый",	Ложь);
	Поиск.Вставить("флагПоказательИзменен",	Ложь);
	МассивСтрок = Дерево.Строки.НайтиСтроки(Поиск, Истина);
	Показатели_КоличествоПрочие = МассивСтрок.Количество();
	
	Показатели_Количество = Показатели_КоличествоНовые + Показатели_КоличествоИзмененные + Показатели_КоличествоПрочие;
	
	// Удаляем строку общих итогов
	Дерево.Строки.Удалить(СтрокаИтогов);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьИтогиИСтатистику_Планы(Дерево)
	
	// Общие итоги
	ИндексПоследнейСтроки = (Дерево.Строки.Количество() - 1);
	СтрокаИтогов = Дерево.Строки[ИндексПоследнейСтроки];
	
	КоличествоНекорректныхНазначений = СтрокаИтогов["КоличествоНекорректныхНазначений"];
	
	// Количество назначений
	КоличествоКорректных = ?(ЗначениеЗаполнено(СтрокаИтогов["КоличествоКорректныхНазначений"]),
							СтрокаИтогов["КоличествоКорректныхНазначений"],
							0);
	КоличествоНеКорректных = ?(ЗначениеЗаполнено(СтрокаИтогов["КоличествоНекорректныхНазначений"]),
							СтрокаИтогов["КоличествоНекорректныхНазначений"],
							0);
	Планы_Количество = КоличествоКорректных + КоличествоНеКорректных;
	
	// Удаляем строку общих итогов
	Дерево.Строки.Удалить(СтрокаИтогов);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктурыПоискаГруппировок()
	
	// Пример значений флагов группировок и детальных записей
	//
	// Таблица Группировка
	// -------------------
	//	1.КФО
	//	2.План
	//	3.Статья плана
	//	
	// Дерево Показатели
	// -----------------							флаг			флаг			флаг			флаг
	//	Поле					Уровень				Группировка		Группировка		Группировка		Детальная
	//	Ссылка					группировки			КФО				План			СтатьяПлана		Запись
	//	--------------------------------------------------------------------------------------------------------
	//	КФО1					1					Истина			Неопределено	Неопределено	Неопределено
	//		План1				2					Истина			Истина			Неопределено	Неопределено
	//			СтатьяПлана1	детальная запись	Ложь			Ложь			Ложь			Истина
	//			СтатьяПлана2	детальная запись	Ложь			Ложь			Ложь			Истина
	//			...				детальная запись	Ложь			Ложь			Ложь			Истина
	
	СтруктураНеопределено = Новый Структура();
	
	Для Каждого ИмяПоля Из СпискиПолей["ПоляГруппировки"]["Выбранные"] Цикл
		ИмяПоляФлагГруппировка = "флагГруппировка" + ИмяПоля;
		
		СтруктураНеопределено.Вставить(ИмяПоляФлагГруппировка, Неопределено);
	КонецЦикла;
	
	СтруктурыПоискаГруппировок = Новый Структура();
	
	Для Каждого ИмяПоля Из СпискиПолей["ПоляГруппировки"]["Выбранные"] Цикл
		ИмяПоляФлагГруппировка = "флагГруппировка" + ИмяПоля;
		
		СтруктураНеопределено.Вставить(ИмяПоляФлагГруппировка, Истина);
		
		СтруктурыПоиска = Новый Структура(Новый ФиксированнаяСтруктура(СтруктураНеопределено));
		
		СтруктурыПоискаГруппировок.Вставить(ИмяПоля, СтруктурыПоиска);
	КонецЦикла;
	
	Возврат СтруктурыПоискаГруппировок;
	
КонецФункции

