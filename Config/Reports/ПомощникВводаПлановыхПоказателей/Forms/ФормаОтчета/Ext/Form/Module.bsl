&НаКлиенте
Функция ОпределитьВозможностьНастроитьНазначениеПоПлану(ПланируемаяАналитикаНазначения)
	
	Перем	НастройкаДопустима,
			СтрокаДереваПланы;
	
	РеквизитФормыДерево = ЭтаФорма["Планы"];
	
	КоординатыСтроки = ПолучитьКоординатыСтрокиНазначения(ПланируемаяАналитикаНазначения);
	
	Если КоординатыСтроки.Количество() = 0 Тогда
		НастройкаДопустима = Истина;
	Иначе
		НастройкаДопустима = Ложь;
		
		ИдентификаторСтроки = ПолучитьИдентификаторСтрокиДереваПоКоординатам(РеквизитФормыДерево, КоординатыСтроки);
		
		СтрокаДереваПланы = РеквизитФормыДерево.НайтиПоИдентификатору(ИдентификаторСтроки);
	КонецЕсли;
	
	РезультатПроверки = Новый Структура();
	РезультатПроверки.Вставить("НастройкаДопустима",	НастройкаДопустима);
	РезультатПроверки.Вставить("СтрокаДереваПланы",		СтрокаДереваПланы);
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаКлиенте
Функция ОпределитьВозможностьНастроитьПоказательПоНазначению(ПланируемаяАналитикаПоказателя)
	
	Перем	НастройкаДопустима,
			СтрокаДереваПоказатели;
	
	РеквизитФормыДерево = ЭтаФорма["Планы"];
	
	КоординатыСтроки = ПолучитьКоординатыСтрокиПоказателя(ПланируемаяАналитикаПоказателя);
	
	Если КоординатыСтроки.Количество() = 0 Тогда
		НастройкаДопустима = Истина;
	Иначе
		НастройкаДопустима = Ложь;
		
		ИдентификаторСтроки = ПолучитьИдентификаторСтрокиДереваПоКоординатам(РеквизитФормыДерево, КоординатыСтроки);
		
		СтрокаДереваПоказатели = РеквизитФормыДерево.НайтиПоИдентификатору(ИдентификаторСтроки);
	КонецЕсли;
	
	РезультатПроверки = Новый Структура();
	РезультатПроверки.Вставить("НастройкаДопустима",		НастройкаДопустима);
	РезультатПроверки.Вставить("СтрокаДереваПоказатели",	СтрокаДереваПоказатели);
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаКлиенте
Функция ОпределитьВозможностьСохранитьРезультатыРедактированияПоказателяКлиент(ФормаРедактированияПоказателя) Экспорт
	
	Перем	СохранениеДопустимо,
			СтрокаДереваПоказатели;
	
	АналитикаПоказателя = ПолучитьПустуюСтруктуруАналитикаПоказателя();
	
	ЗаполнитьЗначенияСвойств(АналитикаПоказателя, ФормаРедактированияПоказателя);
	
	КоординатыСтроки = ПолучитьКоординатыСтрокиПоказателя(АналитикаПоказателя);
	
	Если КоординатыСтроки.Количество() = 0 Тогда
		СохранениеДопустимо = Истина;
		
	Иначе
		ИдентификаторСтроки = ПолучитьИдентификаторСтрокиДереваПоКоординатам(ЭтаФорма["Показатели"], КоординатыСтроки);
		
		НайденЭтотЖеРедактируемыйПоказатель =
			(ФормаРедактированияПоказателя["ИдентификаторСтроки"] = ИдентификаторСтроки);
			
		СохранениеДопустимо = НайденЭтотЖеРедактируемыйПоказатель;
		
		СтрокаДереваПоказатели = Показатели.НайтиПоИдентификатору(ИдентификаторСтроки);
	КонецЕсли;
	
	РезультатПроверки = Новый Структура();
	РезультатПроверки.Вставить("СохранениеДопустимо",		СохранениеДопустимо);
	РезультатПроверки.Вставить("СтрокаДереваПоказатели",	СтрокаДереваПоказатели);
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция ПолучитьКоординатыСтрокиПоказателя(СтруктураПоиска)
	
	// Т.к. ищем именно назначение, то добавляем условие на детальную запись
	Поиск = Новый Структура(Новый ФиксированнаяСтруктура(СтруктураПоиска));
	Поиск.Вставить("флагДетальнаяЗапись", Истина);
	
	ДеревоПоказатели = РеквизитФормыВЗначение("Показатели");
	
	МассивСтрок = ДеревоПоказатели.Строки.НайтиСтроки(Поиск, Истина);
	
	КоличествоНайденных = МассивСтрок.Количество();
	
	Если КоличествоНайденных = 0 Тогда
		КоординатыСтроки = Новый Массив();
	Иначе
		КоординатыСтроки = ОпределитьКоординатыСтрокиДереваЗначений(ДеревоПоказатели, МассивСтрок[0]);
	КонецЕсли;
	
	Возврат КоординатыСтроки;
	
КонецФункции

&НаСервере
Функция ПолучитьКоординатыСтрокиНазначения(СтруктураПоиска)
	
	// Т.к. ищем именно назначение, то добавляем условие на детальную запись
	Поиск = Новый Структура(Новый ФиксированнаяСтруктура(СтруктураПоиска));
	Поиск.Вставить("флагДетальнаяЗапись", Истина);
	
	ДеревоПланы = РеквизитФормыВЗначение("Планы");
	
	МассивСтрок = ДеревоПланы.Строки.НайтиСтроки(Поиск, Истина);
	
	КоличествоНайденных = МассивСтрок.Количество();
	
	Если КоличествоНайденных = 0 Тогда
		КоординатыСтроки = Новый Массив();
	Иначе
		КоординатыСтроки = ОпределитьКоординатыСтрокиДереваЗначений(ДеревоПланы, МассивСтрок[0]);
	КонецЕсли;
	
	Возврат КоординатыСтроки;
	
КонецФункции

