// Серверная переменная, используется при заполнении и настройке дерева значений "Показатели"
&НаСервере
Перем Дерево;

// Заполняется при создании первого документа кнопкой "Готово"
&НаСервере
Перем ПервыйДокументСсылка;

&НаКлиенте
Перем ТекстЗаголовкаСообщений;

&НаКлиенте
Перем ЗакрытьФормуБезусловно;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнициализироватьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИнициализироватьНаКлиенте();
	
	КлиентОбновитьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗакрытьФормуБезусловно = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьИзмененияДанных	= (ИзмененныеПоказатели_Количество > 0 ИЛИ НовыеПоказатели_Количество > 0);
	
	Если ЕстьИзмененияДанных Тогда
		Отказ = Истина;
		
		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = НСтр("ru='Несохраненные значения показателей будут утеряны'");
			Возврат;
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru='Несохраненные значения показателей будут утеряны при закрытии окна.
			|
			|Продолжить и закрыть окно помощника?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПередЗакрытиемКлиент_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение);
	
КонецПроцедуры

// Открывают формы списков справочников (на странице 1.НСИ)
