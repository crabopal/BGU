&НаСервере
Процедура ИнициализироватьНаСервере()
	
	ВидимостьКолонокАналитики							= Истина;
	ВидимостьКолонокАналитикиУчаствующихВГруппировках	= Истина;
	
	// Флаг по функциональной опции:
	ФОУчетПоИФО				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ФОУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	// Инициализация объекта отчета:
	//	- сохраняем схемы СКД в хранилище и запоминаем ссылки
	//	- считываем с запоминаем настройки отчета 
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.ИнициализироватьОбъект(ФОУчетПоИФО, ФОУчетПоПодразделениям);
	
	ЗначениеВРеквизитФормы(ОтчетОбъект, "Отчет");
	
	Отчеты.ПомощникВводаПлановыхПоказателей.ИнициализироватьТаблицуГруппировка(ЭтаФорма);
	
	Если ЕстьСохраненныеНастройкиФормы() Тогда
		ЗагрузитьНастройкиФормы();
	КонецЕсли;
	
	// Списки полей
	СпискиПолей = Отчеты.ПомощникВводаПлановыхПоказателей.ПолучитьСпискиПолей(ФОУчетПоИФО, ФОУчетПоПодразделениям);
	
	АналитикаТекущейСтрокиТаблицыПоказатели	= Новый Структура(СпискиПолей["ПустыеСтруктуры"]["АналитикаПоказателя"]);
	АналитикаТекущейСтрокиТаблицыПланы		= Новый Структура(СпискиПолей["ПустыеСтруктуры"]["ПоляНазначения"]);
	
	// Флаг используется при упорядочивании статей-групп планов:
	СтатьиПланаРазмещатьГруппыСверху = Метаданные.Справочники.СтатьиПланаПоступленийВыбытий.ГруппыСверху;
	
	НастроитьФормуСервер_ПоНаличиюНСИ();
	
	// Если вся необходимая НСИ имеется, то открываем сразу страницу "2.Значения показателей"
	Если ИмеетсяВсяНеобходимаяНСИ Тогда
		НомерТекущейСтраницы = 2;
	Иначе
		НомерТекущейСтраницы = 1;
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьНаКлиенте()
	
	ТекстЗаголовкаСообщений = НСтр("ru='Помощник ввода плановых показателей'");
	
	// Восстанавливаем отбор из сохраненных настроек:
	Если НЕ ОтборИзНастроек = Неопределено Тогда
		Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
		СкопироватьОтборКлиент(Отчет.КомпоновщикНастроек.Настройки.Отбор, ОтборИзНастроек);
	КонецЕсли;
	
	// Настраиваем кнопки таблицы "Группировка":
	НастроитьДоступностьКнопокТаблицыГруппировка();
	
	// Устанавливаем текущей требующуюся страницу:
	Если НомерТекущейСтраницы = 2 Тогда
		ВыполнитьПереходСтраница2();
	КонецЕсли;
	
КонецПроцедуры

// Открывает страницу "1.НСИ".
&НаКлиенте
Процедура ВыполнитьПереходСтраница1()
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНСИ;
	
	Элементы.ПанельНавигации.ТекущаяСтраница = Элементы.СтраницаНавигацииНачало;
	
	НастроитьФормуСервер_ПоНаличиюНСИ();
	
КонецПроцедуры

// Открывает страницу "2.Значения показателей".
&НаКлиенте
Процедура ВыполнитьПереходСтраница2()
	
	Если НЕ ИмеетсяВсяНеобходимаяНСИ Тогда
		ТекстСообщения = НСтр("ru='В информационной базе не заполнены указанные справочники.
			|Без этих данных невозможно выполнить плановые назначения.
			|
		    |Заполните указанные справочники и повторите запуск помощника'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
		Возврат;
	КонецЕсли;
	
	// Устанавливаем параметр запроса для таблицы "Документы":
	СписокДокументов.Параметры.УстановитьЗначениеПараметра("Организация", Отчет["Организация"]);
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПоказатели;
	
	Элементы.ПанельНавигации.ТекущаяСтраница = Элементы.СтраницаНавигацииОкончание;
	
	// Если можем, то выводим значения показателей:
	ОбновитьКлиент();
	
КонецПроцедуры

//---
// Страница "1. НСИ"
//---

&НаКлиенте
Процедура НастроитьФормуКлиент_ПоНаличиюНСИ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	НастроитьФормуСервер_ПоНаличиюНСИ();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ПоНаличиюНСИ()
	
	// Устанавливаем кнопку по умолчанию (в панели навигации помощника)
	Элементы["КнопкаДалее"].КнопкаПоУмолчанию = Истина;
	
	ИмеетсяВсяНеобходимаяНСИ = Истина;
	
	КоличествоНСИ = ПолучитьКоличествоНСИ();
	
	Для Каждого Элемент Из КоличествоНСИ Цикл
		ОбозначениеНСИ		= Элемент.Ключ;
		КоличествоЭлементов	= Элемент.Значение;
		
		// Декорации для случая заполненного справочника
		Элементы["Декорация" + ОбозначениеНСИ + "Присутствует"].Видимость	= (КоличествоЭлементов > 0);
		
		// Декорации для случая пустого справочника
		Элементы["Декорация" + ОбозначениеНСИ + "Отсутствует"].Видимость	= (КоличествоЭлементов = 0);
		Элементы["Декорация" + ОбозначениеНСИ + "Добавить"].Видимость		= (КоличествоЭлементов = 0);
		
		Если КоличествоЭлементов = 0 Тогда
			ИмеетсяВсяНеобходимаяНСИ = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// Учет по ИФО
	Элементы.ДекорацияСписокИФО.Видимость = ФОУчетПоИФО;
	
	// Выбираем организацию по умолчанию
	Если НЕ ЗначениеЗаполнено(Отчет["Организация"]) И КоличествоНСИ["Организация"] > 0 Тогда
		Отчет["Организация"] = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
		
		Если НЕ ЗначениеЗаполнено(Отчет["Организация"]) Тогда
			Отчет["Организация"] = ПолучитьЕдинственнуюОрганизациюСервер();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЕдинственнуюОрганизациюСервер()
	
	Запр = Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Ссылка
	|ИЗ
	|	Справочник.Организации");
	
	Выборка = Запр.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКоличествоНСИ()
	
	// Возвращаемое значение
	СправочникиНСИ = Новый Структура();
	СправочникиНСИ.Вставить("Организация",		"Справочник.Организации");
	СправочникиНСИ.Вставить("План",				"Справочник.ПланыПоступленийВыбытий");
	СправочникиНСИ.Вставить("ОтчетныйПериод",	"Справочник.Периоды");
	СправочникиНСИ.Вставить("СтатьяПлана",		"Справочник.СтатьиПланаПоступленийВыбытий");
	
	ТекстЗапроса = "";
	
	ЭтоПервыйСправочник = Истина;
	Для Каждого ЭлементСправочник Из СправочникиНСИ Цикл
		ОбозначениеНСИ	= ЭлементСправочник.Ключ;
		ИмяСправочника	= ЭлементСправочник.Значение;
		
		ТекстЗапроса = ТекстЗапроса	+ ?(ЭтоПервыйСправочник, "", "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|");
			
		ТекстЗапроса = ТекстЗапроса	+ "ВЫБРАТЬ " + ?(ЭтоПервыйСправочник, "РАЗРЕШЕННЫЕ ", "") + "
			|	""" + ОбозначениеНСИ + """	КАК ОбозначениеНСИ,
			|	ЕСТЬNULL(КОЛИЧЕСТВО(*), 0)	КАК КоличествоЭлементов
			|ИЗ
			|	" + ИмяСправочника;
		
		ЭтоПервыйСправочник = Ложь;	
	КонецЦикла;
	
	ЗапросНСИ = Новый Запрос(ТекстЗапроса);
	
	Выборка = ЗапросНСИ.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбозначениеНСИ		= Выборка["ОбозначениеНСИ"];
		КоличествоЭлементов = Выборка["КоличествоЭлементов"];
		
		СправочникиНСИ.Вставить(ОбозначениеНСИ, КоличествоЭлементов);
	КонецЦикла;
	
	Возврат СправочникиНСИ;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуСписка(ИмяФормыСписка, ПараметрыФормы = Неопределено)
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("НастроитьФормуКлиент_ПоНаличиюНСИ", ЭтотОбъект);
	
	ОткрытьФорму(ИмяФормыСписка, ПараметрыФормы,,,,,ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНовогоЭлемента(ИмяФормыНовогоЭлемента, ПараметрыФормы = Неопределено)
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("НастроитьФормуКлиент_ПоНаличиюНСИ", ЭтотОбъект);
	
	ОткрытьФорму(ИмяФормыНовогоЭлемента, ПараметрыФормы,,,,,ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

//---
// Страница "2. Показатели"
//---

&НаКлиенте
Процедура ОбновитьКлиент()
	
	ИзмененныеПоказатели_Количество = ИзмененныеПоказатели.Количество();
	НовыеПоказатели_Количество = НовыеПоказатели.Количество();
	
	Если НЕ ОрганизацияЗаполненаВФорме() Тогда
		// Очищаем таблицы, обнуляем статистику:
		ОчиститьТаблицыИСтатистикуСервер();
		
		ОчиститьТаблицуИзмененныеПоказатели();
		ОчиститьТаблицуНовыеПоказатели();
		
		// Настраиваем форму на клиенте:
		Планы.ПолучитьЭлементы().Очистить();
		Показатели.ПолучитьЭлементы().Очистить();
		
		КлиентОбновитьДоступность();
		
		Возврат;
	КонецЕсли;
	
	ЗапомнитьСписокОтображаемыхСтатей();
	
	// Выполняем СКД "Показатели" и "Планы" и выводим результаты в оба дерева:
	ОбновитьСервер(Истина);
	
	// Настраиваем вид полученных деревьев:
	КлиентОбновитьДоступность();
	
	ВосстановитьСписокОтображаемыхСтатей();
	
	ВосстановитьТекущуюСтрокуВТаблицеПланы();
	
	ВосстановитьТекущуюСтрокуВТаблицеПоказатели();
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьСервер(СохранитьНастройкиФормы = Ложь)
	
	ЗапомнитьИспользованиеПолейГруппировки();
	
	ОбновитьНастройкиКомпоновщиков();
	
	// Выполняем СКД "Показатели" и выводим в дерево "Показатели"
	ВывестиВДеревоПоказатели();
	
	// Выполняем СКД "Планы" и выводим в дерево "Планы"
	ВывестиВДеревоПланы();
	
	// Сохраняем настроенный отбор и ТЧ "Группировка"
	Если СохранитьНастройкиФормы Тогда
		СохранитьНастройкиФормы();
	КонецЕсли;
	
	НастроитьФормуСервер_ПослеОбновления();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ПослеОбновления()
	
	Элементы["КнопкаГотово"].КнопкаПоУмолчанию = Истина;
	
	ИзмененаГруппировка	= Ложь;
	ИзмененОтбор		= Ложь;
	
	// ДОКУМЕНТЫ
	НастроитьТаблицуДокументы();
	
	
	// НАЗНАЧЕНИЯ
	НастроитьФормуСервер_НадписьОНекорректныхНазначениях();
	
	
	// ПОКАЗАТЕЛИ
	
	// Применяем настройки отчета к таблице "Показатели":
	НастроитьКолонкиТаблицыПоказатели();
	
	// Настраиваем форму
	ИзмененныеПоказатели_Надпись = ПолучитьТекстЗаголовка_ИзмененныеПоказатели_Надпись(
		ИзмененныеПоказатели_Количество,
		ИзмененныеПоказатели_КоличествоОтбор);
	НовыеПоказатели_Надпись = ПолучитьТекстЗаголовка_НовыеПоказатели_Надпись(
		НовыеПоказатели_Количество,
		НовыеПоказатели_КоличествоОтбор);

	НастроитьФормуСервер_НадписьОНекорректныхПоказателях();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_НадписьОНекорректныхНазначениях()
	
	ЭлементНадписи = Элементы["ПланыЕстьНекорректныеНазначения"];
	
	НоваяВидимость = (КоличествоНекорректныхНазначений > 0);
	
	НовыйЗаголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Есть некорректные (%1)'"),
		КоличествоНекорректныхНазначений);
		
	ЭлементНадписи.Видимость	= НоваяВидимость;
	ЭлементНадписи.Заголовок	= НовыйЗаголовок;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_НадписьОНекорректныхПоказателях()
	
	ЭлементНадписи = Элементы["ПоказателиЕстьНекорректныеПоказатели"];
	
	НоваяВидимость = (КоличествоНекорректныхПоказателей > 0);
	
	НовыйЗаголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Есть некорректные (%1)'"),
		КоличествоНекорректныхПоказателей);
		
	ЭлементНадписи.Видимость	= НоваяВидимость;
	ЭлементНадписи.Заголовок	= НовыйЗаголовок;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ЗаголовокСпискаДокументов()
	
	Если СписокДокументов_Количество = 0 Тогда
		НовыйЗаголовок = НСтр("ru='Здесь будут показаны документы, созданные этим помощником при нажатии кнопки ""Готово""'");
	Иначе
		НовыйЗаголовок = НСтр("ru='Для указанных документов необходимо задать раздел лицевого счета и провести вручную'");
	КонецЕсли;
	
	Элементы["СписокДокументов"].Заголовок = НовыйЗаголовок;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьТекстЗаголовка_ИзмененныеПоказатели_Надпись(Количество, КоличествоОтбор)
	
	Возврат "" + Количество
		+ ?(Количество = КоличествоОтбор,
			"",
			" (" + КоличествоОтбор + ")");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьТекстЗаголовка_НовыеПоказатели_Надпись(Количество, КоличествоОтбор)
	
	Возврат "" + Количество
		+ ?(Количество = КоличествоОтбор,
			"",
			" (" + КоличествоОтбор + ")");
	
КонецФункции

&НаСервере
Процедура ОчиститьТаблицыИСтатистикуСервер()
	
	// Обнуляем статистику
	ИзмененныеПоказатели_Количество			= 0;
	ИзмененныеПоказатели_КоличествоОтбор	= 0;
	НовыеПоказатели_Количество				= 0;
	НовыеПоказатели_КоличествоОтбор			= 0;
	
	КоличествоНекорректныхНазначений	= 0;
	КоличествоНекорректныхПоказателей	= 0;
	СписокДокументов_Количество			= 0;
	
	// Надписи на форме
	ИзмененныеПоказатели_Надпись	= ПолучитьТекстЗаголовка_ИзмененныеПоказатели_Надпись(0, 0);
	НовыеПоказатели_Надпись			= ПолучитьТекстЗаголовка_НовыеПоказатели_Надпись(0, 0);
	
	НастроитьФормуСервер_НадписьОНекорректныхНазначениях();
	НастроитьФормуСервер_НадписьОНекорректныхПоказателях();
	НастроитьФормуСервер_ЗаголовокСпискаДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентОбновитьДоступность()
	
	НастроитьДоступностьДействийПланы();
	НастроитьДоступностьДействийПоказатели();
	
	СписокДокументов.Параметры.УстановитьЗначениеПараметра("Организация", Отчет["Организация"]);
	Элементы.СписокДокументов.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтатистикуСеансаРаботы()
	
	Если (ИзмененныеПоказатели_Количество + НовыеПоказатели_Количество) > 0 Тогда
		// Показываем все измененные и новые показатели в отдельном окне
		
		ПараметрыФормы = ПолучитьПараметрыФормыДляСпискаПоказателей();
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеЗакрытияФормыСпискаПоказателей", ЭтотОбъект);
		
		ОткрытьФорму("Отчет.ПомощникВводаПлановыхПоказателей.Форма.СписокПоказателей", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		ТекстСообщения = НСтр("ru='Показатели еще не редактировались'");
		
		ПоказатьПредупреждение(,ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыСпискаПоказателей(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	КоординатыСтроки = ПолучитьКоординатыСтрокиПоказателя(РезультатВыбора);
	
	ИдентификаторСтроки = ПолучитьИдентификаторСтрокиДереваПоКоординатам(ЭтаФорма["Показатели"], КоординатыСтроки);
	
	Элементы["Показатели"].ТекущаяСтрока = ИдентификаторСтроки;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыФормыДляСпискаПоказателей()
	
	БольшаяСтруктура = Новый Структура();
	БольшаяСтруктура.Вставить("Измененные",								ИзмененныеПоказатели);
	БольшаяСтруктура.Вставить("Новые",									НовыеПоказатели);
	БольшаяСтруктура.Вставить("ИзмененныеПоказатели_Количество",		ИзмененныеПоказатели_Количество);
	БольшаяСтруктура.Вставить("ИзмененныеПоказатели_КоличествоОтбор",	ИзмененныеПоказатели_КоличествоОтбор);
	БольшаяСтруктура.Вставить("НовыеПоказатели_Количество",				НовыеПоказатели_Количество);
	БольшаяСтруктура.Вставить("НовыеПоказатели_КоличествоОтбор",		НовыеПоказатели_КоличествоОтбор);
	
	АдресХранилища = ПоместитьВоВременноеХранилище(БольшаяСтруктура);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ФОУчетПоИФО",							ФОУчетПоИФО);
	ПараметрыФормы.Вставить("ФОУчетПоПодразделениям",				ФОУчетПоПодразделениям);
	ПараметрыФормы.Вставить("АдресХранилища",						АдресХранилища);
	ПараметрыФормы.Вставить("ЭтоПросмотрПередСозданиемДокументов",	Ложь);
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура КлиентДобавитьНовыеПоказателиИОбновить(НазначениеСтруктура)
	
	СвободныеСтатьи = ПолучитьСвободныеСтатьи(НазначениеСтруктура);
	
	Если СвободныеСтатьи["Отсутствуют"] Тогда
		// У выбранного плана отсутствуют статьи
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Новые показатели не добавлены,
				|т.к. вообще отсутствуют статьи плана ""%1""'"),
			НазначениеСтруктура["План"]);
			
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
		Возврат;
	КонецЕсли;
	
	СписокСтатей = СвободныеСтатьи["СписокСтатей"];
	
	Если СписокСтатей.Количество() = 0 Тогда
		// Статьи есть, но доступных нет
		
		ТекстСообщения = НСтр("ru='Новые показатели не добавлены,
			|т.к. для выбранного назначения уже добавлены все доступные показатели'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
	Иначе
		// Есть доступные статьи
		// Открываем форму предварительного просмотра добавляемых показателей
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("Организация",				Отчет["Организация"]);
		ПараметрыФормы.Вставить("НазначениеСтруктура",		НазначениеСтруктура);
		ПараметрыФормы.Вставить("СписокСтатей",				СписокСтатей);
		ПараметрыФормы.Вставить("ФОУчетПоИФО",				ФОУчетПоИФО);
		ПараметрыФормы.Вставить("ФОУчетПоПодразделениям",	ФОУчетПоПодразделениям);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("НазначениеСтруктура", НазначениеСтруктура);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеЗакрытияФормыДобавленияПоказателей", ЭтотОбъект, ДополнительныеПараметры);
		
		ОткрытьФорму("Отчет.ПомощникВводаПлановыхПоказателей.Форма.ДобавлениеВсехПоказателейПлана", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыДобавленияПоказателей(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Перем КоличествоДобавленныхПоказателей;
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НазначениеСтруктура = ПараметрыОповещения["НазначениеСтруктура"];
	
	ДобавитьНовыеПоказателиИОбновитьСервер(НазначениеСтруктура, РезультатВыбора, КоличествоДобавленныхПоказателей);
	
	ВосстановитьТекущуюСтрокуВТаблицеПоказатели();
	
	// Категории для русского языка:
	//	Ноль	(-);
	//	Один	(1 шт);
	//	Два		(-);
	//	Немного	(2 шт);
	//	Много	(5 шт);
	//	Другое	(-)
	
	ТекстДобавлено = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';Добавлен;;Добавлено;Добавлено;'"),
		0);
	
	ТекстХНовыхПоказателей = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';%1 новый показатель;;%1 новых показателя;%1 новых показателей;'"),
		КоличествоДобавленныхПоказателей);
	
	ТекстСообщения = СтрШаблон(
		НСтр("ru='%1 %2 плана ""%3""'"),
		ТекстДобавлено,
		ТекстХНовыхПоказателей,
		НазначениеСтруктура["План"]);
		
	ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНовыеПоказателиИОбновитьСервер(НазначениеСтруктура, АдресХранилища, КоличествоДобавленныхПоказателей)
	
	ТаблицаДобавляемыхПоказателей = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	// Добавляем новые строки в таблицу "Новые показатели":
	Для Каждого ДобавляемаяСтрока Из ТаблицаДобавляемыхПоказателей Цикл
		СтрокаТаблицы = НовыеПоказатели.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, НазначениеСтруктура);
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДобавляемаяСтрока);
		
		НовыеПоказатели_МаксимальныйИдСтроки = НовыеПоказатели_МаксимальныйИдСтроки + 1;
		ИдСтроки = НовыеПоказатели_МаксимальныйИдСтроки;
		СтрокаТаблицы["ИдСтроки"] = ИдСтроки;
		
	КонецЦикла;
	НовыеПоказатели_Количество = НовыеПоказатели.Количество();
	
	// Устанавливаем текущую строку на последний из добавленных показателей
	ЗаполнитьЗначенияСвойств(АналитикаТекущейСтрокиТаблицыПоказатели, СтрокаТаблицы);
	
	// Заново считываем всю информацию из базы
	ОбновитьСервер();
	
	КоличествоДобавленныхПоказателей = ТаблицаДобавляемыхПоказателей.Количество();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыИОбновитьСервер()
	
	// Создаем и проводим документы, очищаем таблицы, 
	СоздатьДокументыСервер();
	
	// Заново считываем всю информацию из базы:
	ОбновитьСервер();
	
	// Переходим на страницу "Документы", чтобы показать то, что создали:
	Элементы["СтраницыПоказателиИДокументы"].ТекущаяСтраница = Элементы["Документы"];
	Элементы["СписокДокументов"].ТекущаяСтрока = ПервыйДокументСсылка;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыСервер()
	
	Результат = ПолучитьДанныеДляДокументов();
	
	ПервыйДокументСсылка = Неопределено;
	
	ТекДата = ТекущаяДата();
	
	// Поля шапки (9 шт.)
	ПоляШапки = Новый Структура("
		|ПланПоступленийВыбытий,
		|КФО,
		|ВидПоказателя,
		|УточнениеПоказателя,
		|ИФО,
		|Подразделение,
		|Субсидия,
		|Периодичность,
		|ГодПлана");
	
	КолвоКТ = ПоляШапки.Количество();
	
	Выборки = Новый Массив(КолвоКТ);
	
	масс = Новый Массив();
	
	// Вычислим общее кол-во создаваемых далее документов
	инд = 0;
	КолвоДокументов = 0;
	Выборки[инд] = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока инд >= 0 Цикл
		Пока Выборки[инд].Следующий() Цикл
			
			масс.Добавить(инд);
			
			Если инд = КолвоКТ - 2 Тогда
				КолвоДокументов = КолвоДокументов + Выборки[инд].Количество();
				инд = инд - 1;
			Иначе
				Выборки[инд+1] = Выборки[инд].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				инд = инд + 1;
			КонецЕсли;
			
		КонецЦикла;
		
		инд = инд - 1;
		
	КонецЦикла;
	
	// Обходим результат запроса и создаем новые документы
	инд = 0;
	НПП = 0;
	Выборки[инд] = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока инд >= 0 Цикл
		Пока Выборки[инд].Следующий() Цикл
			
			масс.Добавить(инд);
			
			Если инд = КолвоКТ - 1 Тогда
				// Самая глубокая группировка
				
				Выборка = Выборки[инд].Выбрать();
				
				НПП = НПП + 1;
				
				Текст = НСтр("ru='#Помощник (%1), документ %2 из %3'");
				Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ТекДата, НПП, КолвоДокументов);
				
				Док = Документы.ПлановыеНазначения.СоздатьДокумент();
				
				// Заполняем шапку
				Док.Организация	= Отчет["Организация"];
				Док.Дата		= ТекДата;
				Док.Комментарий	= Текст;
				ЗаполнитьЗначенияСвойств(Док, Выборки[инд]);
				
				БухгалтерскиеОперацииСервер.ИнициализироватьБухгалтерскиеОперации(Док);
				Док.ДополнительныеСвойства.ДанныеАвтоПроведения.Вставить(
					"ФормированиеПроводокОбособленноОтДокумента", Истина);
				
				// Заполняем табличную часть
				Пока Выборка.Следующий() Цикл
					НоваяСтрока = Док.ПоказателиПлана.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				КонецЦикла;
				
				// Типовая операция
				ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Док));
				УстанавливаемаяТиповаяОперация = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(ИдентификаторДокумента);
				Если НЕ ЗначениеЗаполнено(УстанавливаемаяТиповаяОперация) Тогда
					УстанавливаемаяТиповаяОперация = Справочники.ТиповыеОперации.ПлановыеНазначения_Сметные_назначения_получателя_субсидий;
				КонецЕсли;
			    ДополнительныеРеквизиты = БухгалтерскиеОперацииСервер.РеквизитыТиповойОперацииПоУмолчанию(
					ИдентификаторДокумента,
					УстанавливаемаяТиповаяОперация,
					Док.Организация);
			    БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(Док, УстанавливаемаяТиповаяОперация, ДополнительныеРеквизиты);
				
				Док.Записать(РежимЗаписиДокумента.Проведение);
				
				Если ПервыйДокументСсылка = Неопределено Тогда
					ПервыйДокументСсылка = Док.Ссылка;
				КонецЕсли;
				
				инд = инд - 1;
				
			Иначе
				
				Выборки[инд+1] = Выборки[инд].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				инд = инд + 1;
				
			КонецЕсли;
			
		КонецЦикла;
		
		инд = инд - 1;
		
	КонецЦикла;
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Успешно создано документов: %1
			|Перейдите на закладку ""Документы плановых назначений""
			|и заполните в созданных документах реквизит ""Раздел лицевого счета""'"),
		КолвоДокументов);
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		ТекстСообщения,
		,
		"СписокДокументов");
	
	// Очищаем таблицу "Измененные показатели"
	ИзмененныеПоказатели.Очистить();
	ИзмененныеПоказатели_Количество				= 0;
	ИзмененныеПоказатели_КоличествоОтбор		= 0;
	ИзмененныеПоказатели_МаксимальныйИдСтроки	= 0;
	ИзмененныеПоказатели_Надпись				= ПолучитьТекстЗаголовка_ИзмененныеПоказатели_Надпись(0, 0);
				
	// Очищаем таблицу "Новые показатели"
	НовыеПоказатели.Очистить();
	НовыеПоказатели_Количество					= 0;
	НовыеПоказатели_КоличествоОтбор				= 0;
	НовыеПоказатели_МаксимальныйИдСтроки		= 0;
	НовыеПоказатели_Надпись						= ПолучитьТекстЗаголовка_НовыеПоказатели_Надпись(0, 0);
	
КонецПроцедуры

