&НаКлиенте
Процедура ОткрытьФормуРедактированияПоказателя(ИсточникДанных, Копирование = Неопределено)
	
	ПараметрыФормы = ПолучитьПараметрыФормыРедактированияПоказателя(ИсточникДанных, Копирование);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеЗакрытияФормыРедактированияПоказателя", ЭтотОбъект);
	
	ОткрытьФорму("Отчет.ПомощникВводаПлановыхПоказателей.Форма.ЗначениеПоказателя", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПараметрыФормыРедактированияПоказателя(ИсточникДанных, Копирование = Неопределено) Экспорт
	
	Перем	ИдСтроки,
			ИдентификаторСтроки;
	
	Если ТипЗнч(ИсточникДанных) = Тип("ДанныеФормыЭлементДерева") Тогда
		// Источником данных является текущая строка дерева Показатели
		
		Если Копирование = Истина Тогда
			Режим = "ДобавитьНовыйПоказатель";
			
		Иначе
			Если ИсточникДанных["флагПоказательНовый"] Тогда
				Режим = "ИзменитьНовыйПоказатель";
			Иначе
				Режим = "ИзменитьСуществующийПоказатель";
			КонецЕсли;
			
			ИдСтроки = ИсточникДанных["ИдСтроки"];
			
			ИдентификаторСтроки = ИсточникДанных.ПолучитьИдентификатор();
		КонецЕсли;
		
	Иначе
		// Источником данных является План или Назначение
		
		Режим = "ДобавитьНовыйПоказатель";
	КонецЕсли;
	
	
	Если Режим = "ДобавитьНовыйПоказатель" Тогда
		Если ТипЗнч(ИсточникДанных) = Тип("ДанныеФормыЭлементДерева") Тогда
			// Источником данных является текущая строка дерева Показатели
		
			ДанныеПоказателя = ПолучитьПустуюСтруктуруПоказатель();
			
			ЗаполнитьЗначенияСвойств(ДанныеПоказателя, ИсточникДанных);
			
		ИначеЕсли ТипЗнч(ИсточникДанных) = Тип("СправочникСсылка.ПланыПоступленийВыбытий") Тогда
			// Источником данных является План
			
			СвойстваПлана = ПолучитьСвойстваПлана(ИсточникДанных);
			
			ДанныеПоказателя = ПолучитьПустуюСтруктуруПоказатель();
			
			ЗаполнитьЗначенияСвойств(ДанныеПоказателя, СвойстваПлана);
			
		ИначеЕсли ТипЗнч(ИсточникДанных) = Тип("Структура") Тогда
			// Источником данных является Назначение
			
			ДанныеПоказателя = ПолучитьПустуюСтруктуруПоказатель();
			
			ЗаполнитьЗначенияСвойств(ДанныеПоказателя, ИсточникДанных);
		КонецЕсли;
	
	ИначеЕсли Режим = "ИзменитьНовыйПоказатель" Тогда
		ДанныеПоказателя = ПолучитьПустуюСтруктуруПоказатель();
		
		ЗаполнитьЗначенияСвойств(ДанныеПоказателя, ИсточникДанных);
		
	ИначеЕсли Режим = "ИзменитьСуществующийПоказатель" Тогда
		ДоИзменения = ПолучитьПустуюСтруктуруПоказатель();
		
		СтрокаТаблицыИзмененныеПоказатели = НайтиСтрокуИзмененногоПоказателя(ИдСтроки);
		
		Если СтрокаТаблицыИзмененныеПоказатели = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ДоИзменения, ИсточникДанных);
		Иначе
			ЗаполнитьЗначенияСвойств(ДоИзменения, СтрокаТаблицыИзмененныеПоказатели);
		КонецЕсли;
		
		ПослеИзменения = ПолучитьПустуюСтруктуруПоказатель();
		ЗаполнитьЗначенияСвойств(ПослеИзменения, ИсточникДанных);
		
		ДанныеПоказателя = Новый Структура();
		ДанныеПоказателя.Вставить("ДоИзменения",	ДоИзменения);
		ДанныеПоказателя.Вставить("ПослеИзменения",	ПослеИзменения);
	КонецЕсли;
	
	ОписаниеСтатуса = ПолучитьОписаниеСтатуса(ИсточникДанных);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Режим",						Режим);
	ПараметрыФормы.Вставить("Организация",					Отчет["Организация"]);
	ПараметрыФормы.Вставить("ДанныеПоказателя",				ДанныеПоказателя);
	ПараметрыФормы.Вставить("ИдентификаторСтроки",			ИдентификаторСтроки);
	ПараметрыФормы.Вставить("ФОУчетПоИФО", 					ФОУчетПоИФО);
	ПараметрыФормы.Вставить("ФОУчетПоПодразделениям", 		ФОУчетПоПодразделениям);
	ПараметрыФормы.Вставить("РедактируемыеПоляПоказателя",	СпискиПолей["ПоляТаблицыПоказатели"]["РедактируемыеПоляПоказателя"]);
	ПараметрыФормы.Вставить("ОписаниеСтатуса",				ОписаниеСтатуса);
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Функция ПолучитьОписаниеСтатуса(Основание)
	
	МаркироватьЭлементыВСлучаеНесколькихОшибок = Истина;
	Маркер = "• ";
	
	ПоказательКорректный	= Ложь;
	СтатусОпределен			= Ложь;
	Статус					= НСтр("ru='Не определен'");
	
	Если ТипЗнч(Основание) = Тип("ДанныеФормыЭлементДерева") Тогда
		// Источником данных является текущая строка дерева Показатели
		
		СтатусОпределен = Истина;
		
		ОшибкиПоказателя = ПолучитьОшибкиПоказателя(Основание);
		
		ПоказательКорректный = (ОшибкиПоказателя.Количество() = 0);
		
		Если ПоказательКорректный Тогда
			// Показатель корректный
			
			Статус = НСтр("ru='Корректный показатель'");
		Иначе
			// Показатель некорректный
			
			Если ОшибкиПоказателя.Количество() = 1 Тогда
				Статус = ОшибкиПоказателя[0];
			Иначе
				Статус = "";
				
				Для Индекс = 0 По ОшибкиПоказателя.ВГраница() Цикл
					ТекстОшибки = ОшибкиПоказателя[Индекс];
					
					Статус = Статус
						+ ?(Индекс > 0, Символы.ПС, "")
						+ ?(МаркироватьЭлементыВСлучаеНесколькихОшибок, Маркер, "")
						+ ТекстОшибки;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		// Источником данных является Назначение
		
		// Статус показателя всегда равен "Корректный показатель", ошибки отсутствуют,
		// т.к. основанием является корректное назначение,
		// игнорируются возможные ошибки полей, отсутствующих у назначения
		
		ПоказательКорректный	= Истина;
		СтатусОпределен			= Истина;
		Статус					= НСтр("ru='Корректный показатель'");
	КонецЕсли;
	
	ОписаниеСтатуса = Новый Структура();
	ОписаниеСтатуса.Вставить("ПоказательКорректный",	ПоказательКорректный);
	ОписаниеСтатуса.Вставить("СтатусОпределен",			СтатусОпределен);
	ОписаниеСтатуса.Вставить("Статус",					Статус);
	
	Возврат ОписаниеСтатуса;
	
КонецФункции

&НаКлиенте
Функция ПолучитьОшибкиПоказателя(СтрокаДереваПоказатели)
	
	ОшибкиПоказателя = Новый Массив();
	
	Если НЕ СтрокаДереваПоказатели["флагДетальнаяЗапись"] Тогда
		Возврат ОшибкиПоказателя;
	КонецЕсли;
	
	Если СтрокаДереваПоказатели["флагОтсутствуетНазначение"] Тогда
		ОшибкиПоказателя.Добавить(НСтр("ru='Отсутствует назначение'"));
	Иначе
		Если СтрокаДереваПоказатели["флагИскаженоЗначениеИФОНазначение"] Тогда
			ОшибкиПоказателя.Добавить(НСтр("ru='Некорректное назначение (несогласованное значение поля ИФО)'"));
		КонецЕсли;
		
		Если СтрокаДереваПоказатели["флагРасхождениеСПланомНазначение"] Тогда
			ОшибкиПоказателя.Добавить(НСтр("ru='Некорректное назначение (аналитика отличается от аналитики плана)'"));
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаДереваПоказатели["флагИскаженоЗначениеИФО"] Тогда
		ОшибкиПоказателя.Добавить(НСтр("ru='Несогласованное значение поля ИФО'"));
	КонецЕсли;
				
	Если СтрокаДереваПоказатели["флагИскаженоЗначениеПодразделение"] Тогда
		ОшибкиПоказателя.Добавить(НСтр("ru='Несогласованное значение поля Подразделение'"));
	КонецЕсли;
	
	Возврат ОшибкиПоказателя;
	
КонецФункции

&НаКлиенте
Функция ПолучитьОшибкиНазначения(СтрокаДереваПланы)
	
	ОшибкиНазначения = Новый Массив();
	
	Если НЕ СтрокаДереваПланы["флагДетальнаяЗапись"] Тогда
		Возврат ОшибкиНазначения;
	КонецЕсли;
	
	Если СтрокаДереваПланы["флагКФООтличаются"]
		ИЛИ СтрокаДереваПланы["флагВидПоказателяОтличается"]
		ИЛИ СтрокаДереваПланы["флагУточнениеПоказателяОтличается"] Тогда
		ОшибкиНазначения.Добавить(НСтр("ru='Аналитика отличается от аналитики плана'"));
	КонецЕсли;
	
	Если СтрокаДереваПланы["флагИскаженоЗначениеИФО"] Тогда
		ОшибкиНазначения.Добавить(НСтр("ru='Несогласованное значение поля ИФО'"));
	КонецЕсли;
				
	Возврат ОшибкиНазначения;
	
КонецФункции

&НаКлиенте
Процедура НачатьДобавлениеПоказателяИзТаблицыПланы()
	
	Перем Значение;
	
	ВыбранныйОбъект = ОпределитьВыбранныйОбъектВТаблицеПланы();
	
	Если ВыбранныйОбъект.Свойство("План", Значение) Тогда
		ОткрытьФормуРедактированияПоказателя(Значение);
		
	ИначеЕсли ВыбранныйОбъект.Свойство("КорректноеНазначение", Значение) Тогда
		ОткрытьФормуРедактированияПоказателя(Значение);
		
	ИначеЕсли ВыбранныйОбъект.Свойство("НекорректноеНазначение", Значение) Тогда
		ТекстСообщения = НСтр("ru='Добавление показателя отменено,
			|так как выбрано некорректное назначение плана'");
			
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьДобавлениеВсехПоказателейИзТаблицыПланы()
	
	Перем Значение;
	
	ВыбранныйОбъект = ОпределитьВыбранныйОбъектВТаблицеПланы();
	
	Если ВыбранныйОбъект.Свойство("План", Значение) Тогда
		ОткрытьФормуРедактированияПоказателя(Значение);
		
	ИначеЕсли ВыбранныйОбъект.Свойство("КорректноеНазначение", Значение) Тогда
		КлиентДобавитьНовыеПоказателиИОбновить(Значение);
		
	ИначеЕсли ВыбранныйОбъект.Свойство("НекорректноеНазначение", Значение) Тогда
		ТекстСообщения = НСтр("ru='Добавление всех показателей отменено,
			|так как выбрано некорректное назначение плана'");
			
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОпределитьВыбранныйОбъектВТаблицеПланы()
	
	// В любом случае возвращаем структуру
	ВыбранныйОбъект = Новый Структура();
	
	ТекДанные = Элементы["Планы"].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат ВыбранныйОбъект;
	КонецЕсли;
	
	Если ТекДанные["флагДетальнаяЗапись"] Тогда
		// Выбрана строка назначения
		// Корректного или некорректного
		
		НазначениеСтруктура = ПолучитьПустуюСтруктуруПоляНазначения();
			
		ЗаполнитьЗначенияСвойств(НазначениеСтруктура, ТекДанные);
		
		Если НазначенияЯвляетсяКорректным(ТекДанные) Тогда
			ВыбранныйОбъект.Вставить("КорректноеНазначение", НазначениеСтруктура);
		Иначе
			ВыбранныйОбъект.Вставить("НекорректноеНазначение", НазначениеСтруктура);
		КонецЕсли;
		
	Иначе
		// Выбрана строка плана
		
		ВыбранныйОбъект.Вставить("План", ТекДанные["План"]);
	КонецЕсли;
	
	Возврат ВыбранныйОбъект;
	
КонецФункции

&НаКлиенте	
Процедура ВыбратьПланИОткрытьФормуНовогоПоказателя()
	
	Если НЕ Элементы["ПоказателиКнопкаДобавить"].Доступность Тогда
		Возврат;
	КонецЕсли;
	
	НачатьВыборПлана(
		НСтр("ru='Выберите план для нового показателя'"),
		Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьВыборПлана(ЗаголовокФормы, ДобавляетсяОдинПоказатель)
	
	Перем ПланСсылка;
	
	ТекДанные = Элементы["Показатели"].ТекущиеДанные;
	
	Если НЕ ТекДанные = Неопределено Тогда
		ПланСсылка = ТекДанные["План"];
	КонецЕсли;
	
	СтруктураНастроек = Новый Структура();
	СтруктураНастроек.Вставить("ЗаголовокФормы",		ЗаголовокФормы);
	СтруктураНастроек.Вставить("ПланыСНазначениями",	ПланыСНазначениями);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ПомощникВводаПлановыхПоказателей", СтруктураНастроек);
	Если ЗначениеЗаполнено(ПланСсылка) Тогда
		ПараметрыФормы.Вставить("ТекущаяСтрока", ПланСсылка);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ДобавляетсяОдинПоказатель", ДобавляетсяОдинПоказатель);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеВыбораПлана", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("Справочник.ПланыПоступленийВыбытий.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияОЗавершении,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПлана(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если НЕ ТипЗнч(РезультатВыбора) = Тип("СправочникСсылка.ПланыПоступленийВыбытий") Тогда
		Возврат;
	КонецЕсли;
	
	ПланСсылка = РезультатВыбора;
	
	Если ПараметрыОповещения["ДобавляетсяОдинПоказатель"] Тогда
		// Добавляется один показатель
		
		ОткрытьФормуРедактированияПоказателя(ПланСсылка);
		
	Иначе
		// Добавляются все показатели
		
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("ТекстСообщения",		НСтр("ru='Выберите назначение плана для добавляемых показателей'"));
		СтруктураПараметров.Вставить("План",				ПланСсылка);
		СтруктураПараметров.Вставить("ПоследующееДействие",	"ДобавитьВсеПоказатели");
		
		НачатьВыборКорректногоНазначениеИПоследующееДействие(СтруктураПараметров);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыРедактированияПоказателя(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если НЕ ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	// Устанавливаем текущую строку на отредактированный показатель.
	// Заранее кэшируем аналитику текущей строки, с учетом результатов редактирования показателя.
	// Для того, чтобы последующее обновление формы корректно определило
	// положение текущей строки в дереве Показатели
	ЗаполнитьЗначенияСвойств(АналитикаТекущейСтрокиТаблицыПоказатели, РезультатВыбора["Показатель"]);
	
	ОбработатьИзменениеПоказателя(РезультатВыбора);
	
	ВосстановитьТекущуюСтрокуВТаблицеПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеПоказателя(РезультатВыбора)
	
	Режим				= РезультатВыбора["Режим"];
	ИдентификаторСтроки	= РезультатВыбора["ИдентификаторСтроки"];
	Показатель			= РезультатВыбора["Показатель"];
	
	Если Режим = "ДобавитьНовыйПоказатель" Тогда
		ДобавитьСтрокуНовогоПоказателя(Показатель);
		
	ИначеЕсли Режим = "ИзменитьСуществующийПоказатель" Тогда
		СтрокаРедактируемогоПоказателя = Показатели.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		СтрокаТаблицыИзмененныеПоказатели = НайтиСтрокуИзмененногоПоказателя(СтрокаРедактируемогоПоказателя["ИдСтроки"]);
		
		Если СтрокаТаблицыИзмененныеПоказатели <> Неопределено Тогда
			// Показатель считается уже измененным
			
			Если СовпадаютРедактируемыеПоляПоказателей(СтрокаТаблицыИзмененныеПоказатели, Показатель) Тогда
				// Если все новые значения показателя равны его предыдущим значениям,
				// то нет смысла далее отмечать такой показатель как измененный.
				
				ИзмененныеПоказатели.Удалить(СтрокаТаблицыИзмененныеПоказатели);
			Иначе
			 	ОбновитьСтрокуИзмененногоПоказателя(СтрокаТаблицыИзмененныеПоказатели, Показатель);
			КонецЕсли;

		Иначе
			// Показатель считается пока не измененным
			
			Если НЕ СовпадаютРедактируемыеПоляПоказателей(СтрокаРедактируемогоПоказателя, Показатель) Тогда
				ДобавитьСтрокуИзмененногоПоказателя(СтрокаРедактируемогоПоказателя, Показатель);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Режим = "ИзменитьНовыйПоказатель" Тогда
		СтрокаРедактируемогоПоказателя = Показатели.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		СтрокаТаблицыНовыеПоказатели = НайтиСтрокуНовогоПоказателя(СтрокаРедактируемогоПоказателя["ИдСтроки"]);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыНовыеПоказатели, Показатель);
	КонецЕсли;
	
	// Заново считываем всю информацию из базы
	ОбновитьКлиент();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСвободныеСтатьи(СтруктураНазначение)
	
	ЗапросПоискСтатей = Новый Запрос();
	
	ЗапросПоискСтатей.УстановитьПараметр("Организация",						Отчет["Организация"]);
	ЗапросПоискСтатей.УстановитьПараметр("ФОУчетПоИФО",						ФОУчетПоИФО);
	
	ЗапросПоискСтатей.УстановитьПараметр("НазначениеПлан",					СтруктураНазначение["План"]);
	ЗапросПоискСтатей.УстановитьПараметр("НазначениеКФО",					СтруктураНазначение["КФО"]);
	ЗапросПоискСтатей.УстановитьПараметр("НазначениеВидПоказателя",			СтруктураНазначение["ВидПоказателя"]);
	ЗапросПоискСтатей.УстановитьПараметр("НазначениеУточнениеПоказателя",	СтруктураНазначение["УточнениеПоказателя"]);
	ЗапросПоискСтатей.УстановитьПараметр("НазначениеИФО",					СтруктураНазначение["ИФО"]);
	ЗапросПоискСтатей.УстановитьПараметр("НазначениеСубсидия",				СтруктураНазначение["Субсидия"]);
	
	ЗапросПоискСтатей.УстановитьПараметр("ТаблицаИзмененныеПоказатели",		ИзмененныеПоказатели.Выгрузить());
	ЗапросПоискСтатей.УстановитьПараметр("ТаблицаНовыеПоказатели",			НовыеПоказатели.Выгрузить());
	
	ЗапросПоискСтатей.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Измененные показатели
	|//
	|ВЫБРАТЬ
	|	// Ядро аналитики
	|	Т.План					КАК План,
	|	Т.СтатьяПлана			КАК СтатьяПлана,
	|	Т.КФО					КАК КФО,
	|	Т.ВидПоказателя			КАК ВидПоказателя,
	|	Т.УточнениеПоказателя	КАК УточнениеПоказателя,
	|	
	|	// Оставшаяся часть аналитики, общей с Назначением
	|	Т.ИФОНов				КАК ИФОНов,
	|	Т.СубсидияНов			КАК СубсидияНов
	|ПОМЕСТИТЬ
	|	ИзмененныеПоказатели
	|ИЗ
	|   &ТаблицаИзмененныеПоказатели	КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Новые показатели
	|//
	|ВЫБРАТЬ
	|	// Ядро аналитики
	|	Т.План					КАК План,
	|	Т.СтатьяПлана			КАК СтатьяПлана,
	|	Т.КФО					КАК КФО,
	|	Т.ВидПоказателя			КАК ВидПоказателя,
	|	Т.УточнениеПоказателя	КАК УточнениеПоказателя,
	|	
	|	// Оставшаяся часть аналитики, общей с Назначением
	|	Т.ИФО					КАК ИФО,
	|	Т.Субсидия				КАК Субсидия
	|ПОМЕСТИТЬ
	|	НовыеПоказатели
	|ИЗ
	|   &ТаблицаНовыеПоказатели	КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Текущие показатели из базы
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	// Ядро аналитики
	|	СтатьяПлана									КАК СтатьяПлана,
	|	СтатьяПлана.Владелец						КАК План,
	|	СтатьяПлана.Владелец.КФО					КАК КФО,
	|	СтатьяПлана.Владелец.ВидПоказателя			КАК ВидПоказателя,
	|	СтатьяПлана.Владелец.УточнениеПоказателя	КАК УточнениеПоказателя,
	|	
	|	// Оставшаяся часть аналитики, общей с Назначением
	|	ВЫБОР
	|		КОГДА &ФОУчетПоИФО ТОГДА
	|			ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ										КАК ИФО,
	|	Субсидия									КАК Субсидия
	|ПОМЕСТИТЬ
	|	ПоказателиИзБазы
	|ИЗ
	|	РегистрНакопления.ПоказателиПланаПоПоступлениямВыбытиям.Обороты(
	|		,	// 1
	|		,	// 2
	|		,	// 3
	|		Организация = &Организация	// 4
	|		И СтатьяПлана.Владелец = &НазначениеПлан
	|	) КАК РегистрПоказателиПлана
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Занятые Статьи плана
	|//
	|ВЫБРАТЬ
	|	СтатьяПлана	КАК СтатьяПлана
	|ПОМЕСТИТЬ
	|	ЗанятыеСтатьиПлана
	|ИЗ
	|	НовыеПоказатели
	|ГДЕ
	|	План					= &НазначениеПлан
	|	И КФО					= &НазначениеКФО
	|	И ВидПоказателя			= &НазначениеВидПоказателя
	|	И УточнениеПоказателя	= &НазначениеУточнениеПоказателя
	|	И ИФО					= &НазначениеИФО
	|	И Субсидия				= &НазначениеСубсидия
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтатьяПлана	КАК СтатьяПлана
	|ИЗ
	|	ИзмененныеПоказатели
	|ГДЕ
	|	План					= &НазначениеПлан
	|	И КФО					= &НазначениеКФО
	|	И ВидПоказателя			= &НазначениеВидПоказателя
	|	И УточнениеПоказателя	= &НазначениеУточнениеПоказателя
	|	И ИФОНов				= &НазначениеИФО
	|	И СубсидияНов			= &НазначениеСубсидия
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтатьяПлана	КАК СтатьяПлана
	|ИЗ
	|	ПоказателиИзБазы
	|ГДЕ
	|	План					= &НазначениеПлан
	|	И КФО					= &НазначениеКФО
	|	И ВидПоказателя			= &НазначениеВидПоказателя
	|	И УточнениеПоказателя	= &НазначениеУточнениеПоказателя
	|	И ИФО					= &НазначениеИФО
	|	И Субсидия				= &НазначениеСубсидия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Свободные Статьи плана
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка	КАК СтатьяПлана
	|ИЗ
	|	Справочник.СтатьиПланаПоступленийВыбытий	КАК СтатьиПланаПоступленийВыбытий
	|ГДЕ
	|	Владелец = &НазначениеПлан
	|	И НЕ ЭтоГруппа
	|	И Ссылка НЕ В (ВЫБРАТЬ СтатьяПлана ИЗ ЗанятыеСтатьиПлана)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Признак наличия Статей плана указанного Плана
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Справочник.СтатьиПланаПоступленийВыбытий	КАК СтатьиПланаПоступленийВыбытий
	|ГДЕ
	|	Владелец = &НазначениеПлан
	|	И НЕ ЭтоГруппа
	|;";
	
	РезультатыЗапросов = ЗапросПоискСтатей.ВыполнитьПакет();
	
	// [4]. Свободные Статьи плана
	СвободныеСтатьи = РезультатыЗапросов[4].Выгрузить().ВыгрузитьКолонку("СтатьяПлана");
	СписокСтатей = Новый СписокЗначений();
	СписокСтатей.ЗагрузитьЗначения(СвободныеСтатьи);
	
	// [5]. Признак наличия Статей плана указанного Плана
	Отсутствуют = РезультатыЗапросов[5].Пустой();
	
	Результат = Новый Структура();
	Результат.Вставить("СписокСтатей",	СписокСтатей);
	Результат.Вставить("Отсутствуют",	Отсутствуют);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьКолонкиВДеревоПоказателей()
	
	// Это необходимо, т.к. дерево Показатели полностью очищается (в том числе и колонки)
	// при своем заполнении процессором вывода СКД.
	// Восстанавливаем состав колонок до уровня реквизита-таблицы формы.
	
	Дерево.Колонки.Добавить("Ссылка",				Новый ОписаниеТипов());
	Дерево.Колонки.Добавить("Карт",					Новый ОписаниеТипов("Картинка"));
	Дерево.Колонки.Добавить("флагВыделитьСтроку",	Новый ОписаниеТипов("Булево"));
	Дерево.Колонки.Добавить("ИмяПоляГруппировки",	Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(20)));
	
Конецпроцедуры

&НаСервере
Процедура НастроитьКолонкиТаблицыПоказатели()
	
	НастроитьФормуСервер_ПоложениеКолонокАналитикиТаблицыПоказатели();
	
	НастроитьФормуСервер_ВидимостьКолонокАналитикиТаблицыПоказатели();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ПоложениеКолонокАналитикиТаблицыПоказатели()
	
	СкрываемаяЧастьАналитики = СпискиПолей["ПоляТаблицыПоказатели"]["Аналитика"]["СкрываемаяЧасть"];
	
	// 1) Порядок следования полей берем из таблицы Группировка, обходим с последней строки
	// 2) Каждую следующую колонку располагает левее предыдущей, и начиная от колонки ПоказателиПоступления
	
	ЭлементРодитель		= Элементы["Показатели"];
	ПередЭтимЭлементом	= Элементы["ПоказателиПоступления"];
	
	КоличествоСтрок = Отчет["Группировка"].Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		СтрокаТаблицы = Отчет["Группировка"][КоличествоСтрок - Счетчик];
		
		Использование	= СтрокаТаблицы["Использование"];
		ИмяПоля			= СтрокаТаблицы["Поле"];
		
		ЭтоПолеСкрываемойЧасти = (СкрываемаяЧастьАналитики.Найти(ИмяПоля) <> Неопределено);
		
		Если НЕ ЭтоПолеСкрываемойЧасти Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементКолонки = Элементы["Показатели" + ИмяПоля];
		
		Элементы.Переместить(ЭлементКолонки, ЭлементРодитель, ПередЭтимЭлементом);
		
		ПередЭтимЭлементом = ЭлементКолонки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер_ВидимостьКолонокАналитикиТаблицыПоказатели()
	
	СкрываемаяЧастьАналитики			= СпискиПолей["ПоляТаблицыПоказатели"]["Аналитика"]["СкрываемаяЧасть"];
	СкрываемаяЧастьАналитикиСУчетомФО	= СпискиПолей["ПоляТаблицыПоказатели"]["Аналитика"]["СкрываемаяЧастьСУчетомФО"];
	
	Для Каждого ИмяПоля Из СкрываемаяЧастьАналитики Цикл
		
		ПолеДоступное = (СкрываемаяЧастьАналитикиСУчетомФО.Найти(ИмяПоля) <> Неопределено);
		
		ЕстьГруппировкаПоПолю = (СпискиПолей["ПоляГруппировки"]["Выбранные"].Найти(ИмяПоля) <> Неопределено);
		
		НовВидимость = ВидимостьКолонокАналитики
			И ПолеДоступное
			И ?(ЕстьГруппировкаПоПолю, ВидимостьКолонокАналитикиУчаствующихВГруппировках, Истина);
		
		Элементы["Показатели" + ИмяПоля].Видимость = НовВидимость;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьДействийПоказатели()
	
	ТекДанные = Элементы.Показатели.ТекущиеДанные;
	
	МожноДобавить = ЗначениеЗаполнено(Отчет["Организация"]);
	
	Если ТекДанные = Неопределено Тогда
		// Никакая строка не выбрана
		
		МожноУдалить	= Ложь;
		МожноНастроить	= Ложь;
		МожноОткрыть	= Ложь;
		МожноПерейти	= Ложь;
		
	Иначе
		
		ЭтоСтрокаПоказателя = ТекДанные["флагДетальнаяЗапись"];
		
		МожноУдалить	= (ЭтоСтрокаПоказателя И ТекДанные["флагПоказательНовый"]);
		МожноНастроить	= (ЭтоСтрокаПоказателя И ТекДанные["флагОтсутствуетНазначение"]);
		МожноОткрыть	= ЭтоСтрокаПоказателя;
		МожноПерейти	= (ЭтоСтрокаПоказателя И НЕ ТекДанные["флагОтсутствуетНазначение"]);
		
	КонецЕсли;
	
	// Кнопки "Добавить показатель"
	Элементы.ПоказателиКнопкаДобавить.Доступность					= МожноДобавить;
	Элементы.ПоказателиКонтекстноеМенюКнопкаДобавить.Доступность	= МожноДобавить;
	
	Элементы.ПоказателиКнопкаДобавитьВсе.Доступность				= МожноДобавить;
	
	// Кнопки "Удалить показатель"
	Элементы.ПоказателиКнопкаУдалить.Доступность					= МожноУдалить;
	Элементы.ПоказателиКонтекстноеМенюКнопкаУдалить.Доступность		= МожноУдалить;
	
	// Кнопки "Настроить по назначению"
	Элементы.ПоказателиКнопкаНастроить.Доступность					= МожноНастроить;
	Элементы.ПоказателиКонтекстноеМенюКнопкаНастроить.Доступность	= МожноНастроить;
	
	// Кнопки "Перейти к назначению"
	Элементы.ПоказателиПерейтиКНазначению.Доступность					= МожноПерейти;
	Элементы.ПоказателиКонтекстноеМенюПерейтиКНазначению.Доступность	= МожноПерейти;
	
	// Кнопки "Открыть в новом окне"
	Элементы.ПоказателиКонтекстноеМенюКнопкаОткрытьВОкне.Доступность = МожноОткрыть;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокуТаблицыПоказатели(ТекСтрока)
	
	СтрокаТаблицы = Показатели.НайтиПоИдентификатору(ТекСтрока);
	
	Продолжать = Истина;
	
	Пока Продолжать Цикл
		
		Родитель = СтрокаТаблицы.ПолучитьРодителя();
		Если Родитель = Неопределено Тогда
			Родитель = Показатели;
			Продолжать = Ложь;
		КонецЕсли;
		
		ЭлементыРодителя = Родитель.ПолучитьЭлементы();
		
		инд = ЭлементыРодителя.Индекс(СтрокаТаблицы);
		ЭлементыРодителя.Удалить(инд);
		
		Если ЭлементыРодителя.Количество() = 0 Тогда
			СтрокаТаблицы = Родитель;
		Иначе
			Продолжать = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

