&НаСервере
Процедура ВывестиВДеревоПланы()
	
	СКД = ПолучитьИзВременногоХранилища(Отчет.СКДПланыСсылка);
	
	// Вывод результата в ДЗ
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(
		СКД,										//1
		Отчет.КомпоновщикНастроекПланы.Настройки,	//2
		,											//3
		,											//4
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"), //5
		Ложь);										// 6 Не использовать функц.опции.
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных();
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
	
	Дерево = Новый ДеревоЗначений();
	ПроцессорВывода.УстановитьОбъект(Дерево);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	ПроцессорВывода.ЗакончитьВывод();
	
	// Дозаполняем служебные колонки
	ДозаполнитьДеревоПланы();
	
	ПрочитатьИтогиИСтатистику_Планы(Дерево);
	
	// Восстановление текущей строки
	ОпределитьКоординатыТекущейСтрокиДереваПланы();
	
	ЗначениеВРеквизитФормы(Дерево, "Планы");
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьКоординатыТекущейСтрокиДереваПланы()
	
	МассивСтрок = Дерево.Строки.НайтиСтроки(АналитикаТекущейСтрокиТаблицыПланы, Истина);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Координаты = ОпределитьКоординатыСтрокиДереваЗначений(Дерево, МассивСтрок[0]);
	Иначе
		Координаты = Новый Массив();
	КонецЕсли;
	
	ВосстановлениеТекущейСтрокиПланы_Координаты = Новый ФиксированныйМассив(Координаты);
	
КонецПроцедуры

&НаСервере
Процедура ДозаполнитьДеревоПланы()
	
	ДобавитьКолонкуВыделитьСтроку();
	
	// Удаляем строки назначений для планов, не назначенных организации
	Поиск = Новый Структура("флагПланНазначенОрганизации", Ложь);
	МассивСтрок = Дерево.Строки.НайтиСтроки(Поиск, Истина);
	Для Каждого СтрокаДерева Из МассивСтрок Цикл
		СтрокаРодитель = СтрокаДерева.Родитель;
		
		СтрокаРодитель.Строки.Удалить(СтрокаДерева);
	КонецЦикла;
	
	// Определим планы, для которых заданы назначения
	ВремМассив = Новый Массив();
	Для Каждого СтрокаВерхнегоУровняДерева Из Дерево.Строки Цикл
		
		ЕстьКорректныеНазначения = ЗначениеЗаполнено(СтрокаВерхнегоУровняДерева["КоличествоКорректныхНазначений"]);
		
		Если ЕстьКорректныеНазначения Тогда
			ВремМассив.Добавить(СтрокаВерхнегоУровняДерева["План"]);
		КонецЕсли;
	КонецЦикла;
	ПланыСНазначениями = Новый ФиксированныйМассив(ВремМассив);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкуВыделитьСтроку()
	
	Дерево.Колонки.Добавить("флагВыделитьСтроку", Новый ОписаниеТипов("Булево"));
	
КонецПроцедуры

&НаКлиенте
Функция НазначенияЯвляетсяКорректным(СтрокаДереваПланы)
	
	Возврат (СтрокаДереваПланы.флагДетальнаяЗапись
		И НЕ СтрокаДереваПланы.флагКФООтличаются
		И НЕ СтрокаДереваПланы.флагВидПоказателяОтличается
		И НЕ СтрокаДереваПланы.флагУточнениеПоказателяОтличается
		И НЕ СтрокаДереваПланы.флагИскаженоЗначениеИФО);
	
КонецФункции

&НаКлиенте
Функция ПоказательЯвляетсяКорректным(СтрокаДереваПоказатели)
	
	ОшибкиПоказателя = ПолучитьОшибкиПоказателя(СтрокаДереваПоказатели);
	
	Возврат (ОшибкиПоказателя.Количество() = 0);
	
КонецФункции

&НаКлиенте
Функция ПолучитьСтруктуруКлючаЗаписиНазначения(НазначениеСтруктура)
	
	// Для работы с регистром сведений ПланыПоПоступлениямВыбытиямОрганизаций
	
	СтруктураКлючаНазначения = ПолучитьПустуюСтруктуруПоляНазначения();
	
	ЗаполнитьЗначенияСвойств(СтруктураКлючаНазначения, НазначениеСтруктура);
	
	// Помимо всех полей назначения используется еще 1 поле - Организация
	СтруктураКлючаНазначения.Вставить("Организация", Отчет["Организация"]);
	
	// Поле для плана поступлений/выбытий в регистре называется по-другому
	СтруктураКлючаНазначения.Удалить("План");
	СтруктураКлючаНазначения.Вставить("ПланПоступленийВыбытий", НазначениеСтруктура["План"]);
	
	Возврат СтруктураКлючаНазначения;
	
КонецФункции

&НаКлиенте
Процедура НастроитьДоступностьДействийПланы()
	
	ТекДанные = Элементы.Планы.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		// Никакая строка не выбрана
		
		МожноДобавитьНазначение		= Ложь;
		МожноУдалитьНазначение		= Ложь;
		МожноНастроитьНазначение	= Ложь;
		
		МожноДобавитьПоказатель		= Ложь;
		МожноДобавитьВсеПоказатели	= Ложь;
		
	Иначе
		ЭтоНеискаженноеНазначение = (ТекДанные["флагДетальнаяЗапись"] И НЕ ТекДанные["флагИскаженоЗначениеИФО"]);
		
		МожноДобавитьНазначение		= Истина;
		МожноУдалитьНазначение		= (ЭтоНеискаженноеНазначение);
		МожноНастроитьНазначение	= (ЭтоНеискаженноеНазначение И НЕ НазначенияЯвляетсяКорректным(ТекДанные));
		
		МожноДобавитьПоказатель		= (ЭтоНеискаженноеНазначение И НазначенияЯвляетсяКорректным(ТекДанные));
		МожноДобавитьВсеПоказатели	= МожноДобавитьПоказатель;
	КонецЕсли;
	
	// Кнопки "Добавить назначение"
	Элементы.ПланыКнопкаДобавитьЗапись.Доступность					= МожноДобавитьНазначение;
	Элементы.ПланыКонтекстноеМенюКнопкаДобавитьЗапись.Доступность	= МожноДобавитьНазначение;
	
	// Кнопки "Удалить назначение"
	Элементы.ПланыКнопкаУдалитьЗапись.Доступность					= МожноУдалитьНазначение;
	Элементы.ПланыКонтекстноеМенюКнопкаУдалитьЗапись.Доступность	= МожноУдалитьНазначение;
	
	// Кнопки "Настроить по плану"
	Элементы.ПланыКнопкаНастроитьНазначение.Доступность					= МожноНастроитьНазначение;
	Элементы.ПланыКонтекстноеМенюКнопкаНастроитьНазначение.Доступность	= МожноНастроитьНазначение;
	
	// Кнопки "Добавить показатель"
	Элементы.ПланыКнопкаДобавитьПоказатель.Доступность					= МожноДобавитьПоказатель;
	Элементы.ПланыКонтекстноеМенюКнопкаДобавитьПоказатель.Доступность	= МожноДобавитьПоказатель;
	
	// Кнопки "Добавить все показатели"
	Элементы.ПланыКнопкаДобавитьВсеПоказатели.Доступность				= МожноДобавитьВсеПоказатели;
	Элементы.ПланыКонтекстноеМенюКнопкаДобавитьВсеПоказатели.Доступность= МожноДобавитьВсеПоказатели;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокКорректныхНазначений(План)
	
	СписокНазначений = Новый СписокЗначений();
	
	КоллекцияЭлементов = Планы.ПолучитьЭлементы();
	
	Для Каждого Элем Из КоллекцияЭлементов Цикл
		// Перебираем планы
		Если НЕ Элем.План = План Тогда
			Продолжить;
		КонецЕсли;
		
		// Перебираем назначения
		КоллекцияЭлементов = Элем.ПолучитьЭлементы();
		Для Каждого Элем Из КоллекцияЭлементов Цикл
			Если НЕ НазначенияЯвляетсяКорректным(Элем) Тогда
				Продолжить;
			КонецЕсли;
			
			// Обнаружили корректное назначение
			
			ШаблонПредставление = "КФО=[КФО]; ВидПоказателя=[ВидПоказателя]; Субсидия=""[Субсидия]""";
			
			Если ФОУчетПоИФО Тогда
				ШаблонПредставление = ШаблонПредставление + "; ИФО=""[ИФО]""";
			КонецЕсли;
			
			ВставляемыеЗначения = Новый Структура("
				|КФО,
				|Субсидия,
				|ИФО");
			ЗаполнитьЗначенияСвойств(ВставляемыеЗначения, Элем);
			ВставляемыеЗначения.Вставить("ВидПоказателя", ПолучитьПредставлениеВидаПоказателя(Элем));
			
			Представление = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонПредставление, ВставляемыеЗначения);
			
			СписокНазначений.Добавить(Элем, Представление);
		КонецЦикла;
		
		Прервать;
	КонецЦикла;
	
	Возврат СписокНазначений;
	
КонецФункции

&НаКлиенте
Функция ПолучитьПредставлениеВидаПоказателя(НазначениеСтруктура)
	
	// Сделано по аналогии с БюджетнаяКлассификация.УстановитьУсловноеОформлениеПоляВидКПСБУАУВСписке(...)
	
	ВидПоказателяПредставление = Строка(НазначениеСтруктура["ВидПоказателя"]);
	
	Если НазначениеСтруктура["ВидПоказателя"] = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") Тогда
		Если НазначениеСтруктура["УточнениеПоказателя"] = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ") Тогда
			ВидПоказателяПредставление = "КДБ для АУ и БУ";
			
		ИначеЕсли НазначениеСтруктура["УточнениеПоказателя"] = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ") Тогда
			ВидПоказателяПредставление = "КРБ для АУ и БУ";
			
		ИначеЕсли НазначениеСтруктура["УточнениеПоказателя"] = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ") Тогда
			ВидПоказателяПредставление = "КИФ для АУ и БУ";
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВидПоказателяПредставление;
	
КонецФункции

&НаКлиенте
Процедура НачатьВыборКорректногоНазначениеИПоследующееДействие(СтруктураПараметров)
	
	План = СтруктураПараметров["План"];
	
	СписокКорректныхНазначений = ПолучитьСписокКорректныхНазначений(План);
	
	КоличествоКорректныхНазначений = СписокКорректныхНазначений.Количество();
	
	Если КоличествоКорректныхНазначений = 0 Тогда
		
		ПоследующееДействие = СтруктураПараметров["ПоследующееДействие"];
		
		Если ПоследующееДействие = "ДобавитьВсеПоказатели" Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Новые показатели не добавлены,
					|т.к. для выбранного плана ""%1""
					|отсутствуют корректные назначения'"),
				Строка(План));
			
		ИначеЕсли ПоследующееДействие = "НастроитьПоказательПоНазначению" Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Показатель не может быть настроен по назначению,
					|т.к. для выбранного плана ""%1""
					|отсутствуют корректные назначения'"),
				Строка(План));
		
		КонецЕсли;
		
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
		Возврат;
		
	ИначеЕсли КоличествоКорректныхНазначений = 1 Тогда
		
		КорректноеНазначение = СписокКорректныхНазначений[0];
		
		ПослеВыбораКорректногоНазначения(КорректноеНазначение, СтруктураПараметров);
		
	ИначеЕсли КоличествоКорректныхНазначений > 1 Тогда
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеВыбораКорректногоНазначения", ЭтотОбъект, СтруктураПараметров);
		
		СписокКорректныхНазначений.ПоказатьВыборЭлемента(ОписаниеОповещенияОЗавершении, СтруктураПараметров["ТекстСообщения"]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКорректногоНазначения(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если НЕ ТипЗнч(РезультатВыбора) = Тип("ЭлементСпискаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	НазначениеСтруктура = ПолучитьПустуюСтруктуруПоляНазначения();
		
	ЗаполнитьЗначенияСвойств(НазначениеСтруктура, РезультатВыбора.Значение);
	
	ПоследующееДействие = ПараметрыОповещения["ПоследующееДействие"];
	
	Если ПоследующееДействие = "ДобавитьВсеПоказатели" Тогда
		КлиентДобавитьНовыеПоказателиИОбновить(НазначениеСтруктура);
		
	ИначеЕсли ПоследующееДействие = "НастроитьПоказательПоНазначению" Тогда
	    ПроверитьИНастроитьПоказательПоНазначению(ПараметрыОповещения, НазначениеСтруктура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИНастроитьПоказательПоНазначению(СтруктураПараметров, НазначениеСтруктура)
	
	СтрокаТаблицыПоказатели = СтруктураПараметров["ТекДанные"];
	
	// Необходимо проверить, что после того, как показатель будет настроен по назначению,
	// не появится дубль показателя.
	ПланируемаяАналитикаПоказателя = ПолучитьПустуюСтруктуруАналитикаПоказателя();
	ЗаполнитьЗначенияСвойств(ПланируемаяАналитикаПоказателя, СтрокаТаблицыПоказатели);
	ЗаполнитьЗначенияСвойств(ПланируемаяАналитикаПоказателя, НазначениеСтруктура);
	
	РезультатПроверки = ОпределитьВозможностьНастроитьПоказательПоНазначению(ПланируемаяАналитикаПоказателя);
	
	Если РезультатПроверки["НастройкаДопустима"] Тогда
		// Показателя с такой аналитикой не нашлось
		// Представляем, как-будто закрылось окно редактирования значений показателя,
		// в котором часть аналитики показателя была заменена на аналитику указанного назначения
		
		Показатель = ПолучитьПустуюСтруктуруПоказатель();
		ЗаполнитьЗначенияСвойств(Показатель, СтрокаТаблицыПоказатели);
		ЗаполнитьЗначенияСвойств(Показатель, НазначениеСтруктура);
		
		РезультатВыбора = Новый Структура();
		РезультатВыбора.Вставить("Режим",					"ИзменитьСуществующийПоказатель");
		РезультатВыбора.Вставить("ИдентификаторСтроки",		СтрокаТаблицыПоказатели.ПолучитьИдентификатор());
		РезультатВыбора.Вставить("Показатель",				Показатель);
		
		// Устанавливаем текущую строку на отредактированный показатель.
		// Заранее кэшируем аналитику текущей строки, с учетом результатов редактирования показателя.
		// Для того, чтобы последующее обновление формы корректно определило
		// положение текущей строки в дереве Показатели
		ЗаполнитьЗначенияСвойств(АналитикаТекущейСтрокиТаблицыПоказатели, ПланируемаяАналитикаПоказателя);
		
		ОбработатьИзменениеПоказателя(РезультатВыбора);
		
	Иначе
		// Нашелся показатель с такой аналитикой
		
		НайденнаяСтрокаПоказателя = РезультатПроверки["СтрокаДереваПоказатели"];
		
		// Устанавливаем выделение строки
		НайденнаяСтрокаПоказателя["флагВыделитьСтроку"] = Истина;
		
		ТекстСообщения = НСтр("ru='Настроить показатель по назначению невозможно:
			|уже существует показатель с планируемой аналитикой'");
			
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("СтрокаДереваПоказатели", НайденнаяСтрокаПоказателя);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("СброситьВыделеннуюСтрокуТаблицыПоказатели", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьПредупреждение(ОписаниеОповещенияОЗавершении, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьВыделеннуюСтрокуТаблицыПоказатели(ПараметрыОповещения) Экспорт
	
	СтрокаДереваПоказатели = ПараметрыОповещения["СтрокаДереваПоказатели"];
	
	// Снимаем выделение строки
	СтрокаДереваПоказатели["флагВыделитьСтроку"] = Ложь;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКлючЗаписи(ДанныеКлюча)
	
	Возврат РегистрыСведений.ПланыПоПоступлениямВыбытиямОрганизаций.СоздатьКлючЗаписи(ДанныеКлюча);  
	
КонецФункции

&НаСервереБезКонтекста
Процедура УдалитьЗаписьНазначенияПлана(СтруктураКлючаЗаписиНазначения)
	
	НаборЗаписей = РегистрыСведений.ПланыПоПоступлениямВыбытиямОрганизаций.СоздатьНаборЗаписей();
	
	// Задаем отбор
	Для Каждого ЭлементОтбора Из НаборЗаписей.Отбор Цикл
		ИмяПоля = ЭлементОтбора.Имя;
		
		ЭлементОтбора.Значение		= СтруктураКлючаЗаписиНазначения[ИмяПоля];
		ЭлементОтбора.Использование	= Истина;
	КонецЦикла;
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 1 Тогда
		НаборЗаписей.Удалить(0);
		
		НаборЗаписей.Записать();
	Иначе
		// Такого быть не должно
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзменитьЗаписьНазначенияПлана(СтруктураКлючаДоИзменения, СтруктураКлючаПослеИзменения)
	
	МенеджерЗаписи = РегистрыСведений.ПланыПоПоступлениямВыбытиямОрганизаций.СоздатьМенеджерЗаписи();
	
	// Получаем запись
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураКлючаДоИзменения);
	МенеджерЗаписи.Прочитать();
	
	// Изменяем значения измерений
	Если МенеджерЗаписи.Выбран() Тогда
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураКлючаПослеИзменения);
		
		МенеджерЗаписи.Записать();
	КонецЕсли;

КонецПроцедуры

//---
// Таблица "Документы"
//---

&НаСервере
Процедура НастроитьТаблицуДокументы()
	
	СписокДокументов.Параметры.УстановитьЗначениеПараметра("Организация", Отчет["Организация"]);
	
	// Определим количество существующих документов
	ЗапросПоиск = Новый Запрос(СписокДокументов.ТекстЗапроса);
	ЗапросПоиск.УстановитьПараметр("Организация", Отчет["Организация"]);
