&НаСервере
Функция ЕстьСохраненныеНастройкиФормы()
	
	Настройки = ХранилищеСистемныхНастроек.Загрузить(ПолучитьКлючОбъектаНастройки());
	
	Возврат Настройки <> Неопределено;
	
КонецФункции
	
&НаСервере
Процедура СохранитьНастройкиФормы()
	
	НастройкиКД = Новый НастройкиКомпоновкиДанных();
	
	СкопироватьОтбор(
		НастройкиКД.Отбор,
		Отчет.КомпоновщикНастроек.Настройки.Отбор,
		Отчет.КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора);
	
	Настройки = Новый Соответствие;
	Настройки.Вставить("Организация",				Отчет["Организация"]);
	Настройки.Вставить("Отбор",						НастройкиКД.Отбор);
	Настройки.Вставить("ТЧГруппировка",				Отчет["Группировка"].Выгрузить());
	Настройки.Вставить("ВидимостьНастроек",			Элементы["КнопкаПанельНастроек"].Пометка);
	Настройки.Вставить("ВидимостьКолонокАналитики",	ВидимостьКолонокАналитики);
	
	ХранилищеСистемныхНастроек.Сохранить(ПолучитьКлючОбъектаНастройки(), , Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкиФормы()
	
	Настройки = ХранилищеСистемныхНастроек.Загрузить(ПолучитьКлючОбъектаНастройки());
	
	Если Настройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Организация:
	О = Настройки.Получить("Организация");
	Если ТипЗнч(О) = Тип("СправочникСсылка.Организации") Тогда
		Отчет["Организация"] = О;
	КонецЕсли;
	
	// Отбор - запоминаем и установим на клиенте позже:
	О = Настройки.Получить("Отбор");
	Если ТипЗнч(О) = Тип("ОтборКомпоновкиДанных") Тогда
		ОтборИзНастроек = О;
		Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
		СкопироватьОтбор(Отчет.КомпоновщикНастроек.Настройки.Отбор, ОтборИзНастроек);
	КонецЕсли;
	
	// Таблица Группировка
	//	- настраиваем стандартную таблицу
	//	- из загруженных настроек берем порядок строк и отметки
	//	- все остальные поля и строки остаются стандартными
	ЗагруженноеЗначение = Настройки.Получить("ТЧГруппировка");
	Если ТипЗнч(ЗагруженноеЗначение) = Тип("ТаблицаЗначений") Тогда
		НастраиваемаяТаблица = Отчет["Группировка"];
		
		КоличествоСтрок = ЗагруженноеЗначение.Количество();
		
		Поиск = Новый Структура();
		
		// Если поле не найдено в загруженном значении, то для всех последующих сдвигаемых значений смещение должно быть
		// меньше, т.к. не найденное поле не отображается в списке и общее количество полей может быть меньше.
		ПоправкаСмещения = 0;
		
		Для Счетчик = 1 По КоличествоСтрок Цикл
			ИндексСтроки	= (Счетчик - 1);
			СтрокаТаблицы	= ЗагруженноеЗначение[ИндексСтроки];
			ИмяПоля			= СтрокаТаблицы["Поле"];
			
			Поиск.Вставить("Поле", ИмяПоля);
			
			МассивСтрок = НастраиваемаяТаблица.НайтиСтроки(Поиск);
			Если МассивСтрок.Количество() > 0 Тогда
				НастраиваемаяСтрока = МассивСтрок[0];
				
				// В настраиваемой таблице есть строка с таким полем.
				// Перемещаем такую строку в текущую позицию.
				
				ИндексНастраиваемойСтроки = НастраиваемаяТаблица.Индекс(НастраиваемаяСтрока);
				
				Смещение = (ИндексСтроки - ИндексНастраиваемойСтроки - ПоправкаСмещения);
				
				ВыполнитьСдвиг = (Смещение > 0 И ИндексНастраиваемойСтроки < (НастраиваемаяТаблица.Количество() - 1))
							ИЛИ (Смещение < 0 И ИндексНастраиваемойСтроки > 0);
					
				Если ВыполнитьСдвиг Тогда
					НастраиваемаяТаблица.Сдвинуть(ИндексНастраиваемойСтроки, Смещение);
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НастраиваемаяСтрока, СтрокаТаблицы, "Использование");
			Иначе
				ПоправкаСмещения = ПоправкаСмещения + 1;
			КонецЕсли;
		КонецЦикла;
		
		Отчеты.ПомощникВводаПлановыхПоказателей.СдвинутьЗафиксированныеСтрокиВниз(Отчет["Группировка"]);
	КонецЕсли;
	
	// Видимость панели "Настройки"
	Видимость = Настройки.Получить("ВидимостьНастроек");
	Если ТипЗнч(Видимость) = Тип("Булево") Тогда
		Элементы["КнопкаПанельНастроек"].Пометка	= Видимость;
		Элементы["ГруппаПанельНастроек"].Видимость	= Видимость;
	КонецЕсли;
	
	ЗагруженноеЗначение = Настройки.Получить("ВидимостьКолонокАналитики");
	Если ТипЗнч(ЗагруженноеЗначение) = Тип("Булево") Тогда
		ВидимостьКолонокАналитики = ЗагруженноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКлючОбъектаНастройки()
	
	Возврат "Отчет.ПомощникВводаПлановыхПоказателей.Форма.ФормаОтчета";
	
КонецФункции

