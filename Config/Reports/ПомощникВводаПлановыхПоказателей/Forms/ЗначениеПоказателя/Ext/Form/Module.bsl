&НаКлиенте
Перем ТекстЗаголовкаСообщений;

&НаКлиенте
Перем ЗакрытьФормуБезусловно;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	НастроитьФормуСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Помощник ввода плановых показателей'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗакрытьФормуБезусловно = Истина Тогда
		ЗакрытьФормуБезусловно = Неопределено;
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.Модифицированность Тогда
		Отказ = Истина;
		
		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = НСтр("ru='Изменения значения показателя будут потеряны'");
			Возврат;
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru='Данные были изменены. Сохранить изменения?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
				
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Выбрали "Сохранить изменения"
		
		ПроверитьИЗакрытьФормуССохранениемРедактирования();
		
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		// Выбрали "Не сохранить изменения"
		
		ЗакрытьФормуБезусловно = Истина;
		
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// Нужно проверять реквизит ИФО?
	Если НЕ Параметры.ФОУчетПоИФО Тогда
		инд = ПроверяемыеРеквизиты.Найти("ИФО");
		Если НЕ инд = Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(инд);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияНажатие(Элемент)
	
	ПроверитьИОтменитьРедактированиеПоля(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеПриИзменении(Элемент)
	
	Если Режим = "ИзменитьСуществующийПоказатель" Тогда
		ИмяПоля		= Элемент.Имя;
		ИмяЭлемента	= "Декорация" + ИмяПоля;
		
		ЗначениеДоИзменения		= ДанныеПоказателя["ДоИзменения"][ИмяПоля];
		ЗначениеПослеИзменения	= ЭтаФорма[ИмяПоля];
		
		Элементы[ИмяЭлемента].Доступность = (ЗначениеДоИзменения <> ЗначениеПослеИзменения);
	КонецЕсли;
	
	СброситьСтатус();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ПроверитьИЗакрытьФормуССохранениемРедактирования();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	ПроверитьИЗакрытьФормуСОтменойРедактирования();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//---
	// 1. Статус корректного показателя
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Статус корректного показателя'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СтатусОпределен");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПоказательКорректный");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Зеленый);

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Статус");
	
	
	//---
	// 2. Статус некорректного показателя
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Статус некорректного показателя'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СтатусОпределен");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПоказательКорректный");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Статус");
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер(ИспользуемыеПараметрыФормы = Неопределено)
	
	Если ИспользуемыеПараметрыФормы = Неопределено Тогда
		ИспользуемыеПараметрыФормы = Параметры;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ИспользуемыеПараметрыФормы, "ДанныеПоказателя, ИдентификаторСтроки, Организация, Режим");
	
	Если Режим = "ДобавитьНовыйПоказатель" Тогда
		Заголовок = НСтр("ru='Создание нового показателя'");
		
		СтатьяПланаТолькоПросмотр = Ложь;
		
		Показатель = ИспользуемыеПараметрыФормы["ДанныеПоказателя"];
		
	ИначеЕсли Режим = "ИзменитьСуществующийПоказатель" Тогда
		Заголовок = НСтр("ru='Изменение существующего показателя'");
		
		СтатьяПланаТолькоПросмотр = Истина;
		
		Показатель = ИспользуемыеПараметрыФормы["ДанныеПоказателя"]["ПослеИзменения"];
		
	ИначеЕсли Режим = "ИзменитьНовыйПоказатель" Тогда
		Заголовок = НСтр("ru='Изменение нового показателя'");
		
		СтатьяПланаТолькоПросмотр = Истина;
		
		Показатель = ИспользуемыеПараметрыФормы["ДанныеПоказателя"];
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Показатель);
	
	НастроитьИндикаторыМодификацииПриСоздании();
	
	ВидПоказателяПредставление = Отчеты.ПомощникВводаПлановыхПоказателей.ПолучитьПредставлениеВидаПоказателя(ВидПоказателя, УточнениеПоказателя);
	
	ИнициализироватьСтатус(ИспользуемыеПараметрыФормы);
	
	Элементы["СтатьяПлана"].ТолькоПросмотр		= СтатьяПланаТолькоПросмотр;
	
	// Значения ФО учитываются только один раз, при открытии формы
	Элементы["ГруппаПодразделение"].Видимость	= Параметры["ФОУчетПоПодразделениям"];
	Элементы["ГруппаИФО"].Видимость				= Параметры["ФОУчетПоИФО"];
	
	// Сброс размеров и положения формы
	ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Если ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		ХранилищеСистемныхНастроек.Удалить("Отчет.ПомощникВводаПлановыхПоказателей.Форма.ЗначениеПоказателя", "", ИмяПользователя);
	КонецЕсли;
	КлючСохраненияПоложенияОкна = Строка(Новый УникальныйИдентификатор);
	
	ЭтаФорма.Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьСтатус(ИспользуемыеПараметрыФормы)
	
	ОписаниеСтатуса = ИспользуемыеПараметрыФормы["ОписаниеСтатуса"];
	
	ПоказательКорректный	= ОписаниеСтатуса["ПоказательКорректный"];
	СтатусОпределен			= ОписаниеСтатуса["СтатусОпределен"];
	Статус					= ОписаниеСтатуса["Статус"];
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьСтатус()
	
	Если НЕ СтатусОпределен Тогда
		Возврат;
	КонецЕсли;
	
	СтатусОпределен = Ложь;
	
	Статус = НСтр("ru='Не определен'") + Символы.ПС
		+ НСтр("ru='Прежнее значение: '") + Статус;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗакрытьФормуССохранениемРедактирования()
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	РезультатПроверки = ОпределитьВозможностьСохранитьРезультатыРедактированияПоказателя();
	
	Если РезультатПроверки["СохранениеДопустимо"] Тогда
		// Можно сохранить текущие значения
		
		ЗакрытьФормуССохранениемРедактирования();
		
	Иначе
		// Можно лишь перейти к существующему показателю
		// или продолжить редактирование
		
		// Выделяем строку дерева Показатели
		СтрокаДереваПоказатели = РезультатПроверки["СтрокаДереваПоказатели"];
		СтрокаДереваПоказатели["флагВыделитьСтроку"] = Истина;
		
		Если Режим = "ДобавитьНовыйПоказатель" Тогда
			НачалоТекста = НСтр("ru='Создать новый показатель нельзя'");
		Иначе
			НачалоТекста = НСтр("ru='Изменить показатель нельзя'");
		КонецЕсли;
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='%1:
				|показатель с такой аналитикой уже существует.
				|
				|Существующий показатель:
				|	Поступления:	%2
				|	Выбытия:		%3
				|
				|Перейти к существующему показателю?'"),
			НачалоТекста,
			СтрокаДереваПоказатели.Поступления,
			СтрокаДереваПоказатели.Выбытия);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("СтрокаДереваПоказатели", СтрокаДереваПоказатели);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗакрытьФормуССохранениемРедактирования_Ответ", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗакрытьФормуССохранениемРедактирования_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	СтрокаДереваПоказатели = ПараметрыОповещения["СтрокаДереваПоказатели"];
	
	// Снимаем выделение строки
	СтрокаДереваПоказатели["флагВыделитьСтроку"] = Ложь;
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Выбрали "Да, перейти к редактированию существующего показателя"
		
		ЗагрузитьНайденныйПоказатель(СтрокаДереваПоказатели);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНайденныйПоказатель(СтрокаДереваПоказатели)
	
	ОсновнаяФормаОтчета = ЭтаФорма.ВладелецФормы;
	
	НовыеПараметрыФормы = ОсновнаяФормаОтчета.ПолучитьПараметрыФормыРедактированияПоказателя(СтрокаДереваПоказатели);
	
	НастроитьФормуСервер(НовыеПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуССохранениемРедактирования()
	
	ВозвращаемоеЗначение = ПолучитьВозвращаемоеЗначение();
	
	ЗакрытьФормуБезусловно = Истина;
	
	ЭтаФорма.Закрыть(ВозвращаемоеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗакрытьФормуСОтменойРедактирования()
	
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьВозвращаемоеЗначение()
	
	ОсновнаяФормаОтчета = ЭтаФорма.ВладелецФормы;
	
	Показатель = ОсновнаяФормаОтчета.ПолучитьПустуюСтруктуруПоказатель();
	
	ЗаполнитьЗначенияСвойств(Показатель, ЭтаФорма);
	
	ВозвращаемоеЗначение = Новый Структура();
	ВозвращаемоеЗначение.Вставить("Режим",					Режим);
	ВозвращаемоеЗначение.Вставить("ИдентификаторСтроки",	ИдентификаторСтроки);
	ВозвращаемоеЗначение.Вставить("Показатель",				Показатель);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСвойстваПлана(ПланСсылка)
	
	СвойстваПлана = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПланСсылка, "КФО,ВидПоказателя");
	
	Возврат СвойстваПлана;
	
КонецФункции

&НаКлиенте
Функция ОпределитьВозможностьСохранитьРезультатыРедактированияПоказателя()
	
	ОсновнаяФормаОтчета = ЭтаФорма.ВладелецФормы;
	
	Возврат ОсновнаяФормаОтчета.ОпределитьВозможностьСохранитьРезультатыРедактированияПоказателяКлиент(ЭтаФорма);
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИОтменитьРедактированиеПоля(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	ПрефиксИмениКартинки = "Декорация";
	
	инд = Найти(ИмяЭлемента, ПрефиксИмениКартинки);
	Если инд = 1 Тогда
		
		ИмяПоля = Прав(ИмяЭлемента, СтрДлина(ИмяЭлемента) - СтрДлина(ПрефиксИмениКартинки));
		
		ЗначениеДоИзменения	= ДанныеПоказателя["ДоИзменения"][ИмяПоля];
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Отменить редактирование поля ""%1""
				|и восстановить исходное значение ""%2""?'"),
			ИмяПоля,
			ЗначениеДоИзменения);
			
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ИмяПоля",				ИмяПоля);
		ДополнительныеПараметры.Вставить("ИмяЭлемента",			ИмяЭлемента);
		ДополнительныеПараметры.Вставить("ЗначениеДоИзменения",	ЗначениеДоИзменения);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИОтменитьРедактированиеПоля_Ответ", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИОтменитьРедактированиеПоля_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ОтменитьРедактированиеПоля(ПараметрыОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьРедактированиеПоля(ПараметрыОповещения)
	
	// Восстанавливаем исходное значение поля
	
	ИмяПоля				= ПараметрыОповещения["ИмяПоля"];
	ИмяЭлемента			= ПараметрыОповещения["ИмяЭлемента"];
	ЗначениеДоИзменения	= ПараметрыОповещения["ЗначениеДоИзменения"];
	
	ЭтаФорма[ИмяПоля] = ЗначениеДоИзменения;
	
	Элементы[ИмяЭлемента].Доступность = Ложь;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьИндикаторыМодификацииПриСоздании()
	
	ВидимостьИндикаторов = (Режим = "ИзменитьСуществующийПоказатель");
	
	// Видимость и состояние индикаторов
	Для Каждого ИмяПоля Из Параметры["РедактируемыеПоляПоказателя"] Цикл
		ИмяЭлемента = "Декорация" + ИмяПоля;
		
		Элементы[ИмяЭлемента].Видимость = ВидимостьИндикаторов;
		
		Если ВидимостьИндикаторов Тогда
			ЗначениеДоИзменения		= ДанныеПоказателя["ДоИзменения"][ИмяПоля];
			ЗначениеПослеИзменения	= ДанныеПоказателя["ПослеИзменения"][ИмяПоля];
			
			Элементы[ИмяЭлемента].Доступность = (ЗначениеДоИзменения <> ЗначениеПослеИзменения);
		КонецЕсли;
	КонецЦикла;
	
	// Видимость выравнивающих декораций
	Элементы["ДекорацияПустая1"].Видимость	= ВидимостьИндикаторов;
	Элементы["ДекорацияПустая2"].Видимость	= ВидимостьИндикаторов;
	Элементы["ДекорацияПустая4"].Видимость	= ВидимостьИндикаторов;
	Элементы["ДекорацияПустая6"].Видимость	= ВидимостьИндикаторов;
	
КонецПроцедуры

