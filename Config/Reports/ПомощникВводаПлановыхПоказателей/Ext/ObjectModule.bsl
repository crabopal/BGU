// Сохраняет СКД в хранилище и инициализирует КомпоновщикиНастроек этих СКД
Процедура ИнициализироватьОбъект(ФОУчетПоИФО, ФОУчетПоПодразделениям) Экспорт
	
	СКДПоказатели = ПолучитьМакет("СКД_Показатели");
	СКДПланы = ПолучитьМакет("СКД_Планы");
	
	// Сохраняем используемые СКД во временное хранилище
	СКДПоказателиСсылка = ПоместитьВоВременноеХранилище(СКДПоказатели, Новый УникальныйИдентификатор());
	СКДПланыСсылка = ПоместитьВоВременноеХранилище(СКДПланы, Новый УникальныйИдентификатор());
	
	// Настраиваем компоновщик настроек "Показатели" настройками по умолчанию
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКДПоказатели));
	КомпоновщикНастроек.ЗагрузитьНастройки(СКДПоказатели.НастройкиПоУмолчанию);
	
	// Настраиваем компоновщик настроек "Планы" настройками по умолчанию
	КомпоновщикНастроекПланы.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКДПланы));
	КомпоновщикНастроекПланы.ЗагрузитьНастройки(СКДПланы.НастройкиПоУмолчанию);
	
КонецПроцедуры

