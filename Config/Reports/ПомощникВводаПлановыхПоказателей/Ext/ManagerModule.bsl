Функция ПолучитьПредставлениеПоля(ИмяПоля)
	
	Если ИмяПоля = "СтатьяПлана" тогда
		Возврат НСтр("ru='Статья плана'");
		
	ИначеЕсли ИмяПоля = "ВидПоказателя" тогда
		Возврат НСтр("ru='Вид показателя'");
		
	ИначеЕсли ИмяПоля = "ОтчетныйПериод" тогда
		Возврат НСтр("ru='Отчетный период'");
		
	Иначе
		Возврат ИмяПоля;
	КонецЕсли;
	
