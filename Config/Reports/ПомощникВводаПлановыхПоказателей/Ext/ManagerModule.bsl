Функция ПолучитьПредставлениеВидаПоказателя(ВидПоказателя, УточнениеПоказателя) Экспорт
	
	// Сделано по аналогии с БюджетнаяКлассификация.УстановитьУсловноеОформлениеПоляВидКПСБУАУВСписке(...)
	
	ВидПоказателяПредставление = Строка(ВидПоказателя);
	
	Если ВидПоказателя = Перечисления.ВидыКБК.АУИБУ Тогда
		Если УточнениеПоказателя = Перечисления.ВидыКБК.КДБ Тогда
			ВидПоказателяПредставление = "КДБ для АУ и БУ";
			
		ИначеЕсли УточнениеПоказателя = Перечисления.ВидыКБК.КРБ Тогда
			ВидПоказателяПредставление = "КРБ для АУ и БУ";
			
		ИначеЕсли УточнениеПоказателя = Перечисления.ВидыКБК.КИФ Тогда
			ВидПоказателяПредставление = "КИФ для АУ и БУ";
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВидПоказателяПредставление;
	
КонецФункции

