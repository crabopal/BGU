#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ПомощникВводаПлановыхПоказателей");
	НастройкиВарианта.Включен = Ложь;
	НастройкиОтчета.Включен = Ложь;

КонецПроцедуры

// Выполняет начальное заполнение таблицы
Процедура ИнициализироватьТаблицуГруппировка(Форма) Экспорт
	
	ТаблицаГруппировка		= Форма.Отчет["Группировка"];
	ФОУчетПоИФО				= Форма["ФОУчетПоИФО"];
	ФОУчетПоПодразделениям	= Форма["ФОУчетПоПодразделениям"];
	
	// Тип группировки:
	//	0 - ТипГруппировкиКомпоновкиДанных.Иерархия
	//	1 - ТипГруппировкиКомпоновкиДанных.ТолькоИерархия
	//	2 - ТипГруппировкиКомпоновкиДанных.Элементы
	
	СпискиПолей = ПолучитьСпискиПолей(ФОУчетПоИФО, ФОУчетПоПодразделениям);
	
	ДоступныеСУчетомФО	= СпискиПолей["ПоляГруппировки"]["ДоступныеСУчетомФО"];
	Зафиксированные		= СпискиПолей["ПоляГруппировки"]["Зафиксированные"];
	
	ТаблицаГруппировка.Очистить();
	
	Для Каждого ИмяПоля Из ДоступныеСУчетомФО Цикл
		Если ИмяПоля = "СтатьяПлана" Тогда
			Использование	= Истина;
			ТипГруппировки	= 1;
		Иначе
			Использование	= Ложь;
			ТипГруппировки	= 0;
		КонецЕсли;
		
		Фиксация = (Зафиксированные.Найти(ИмяПоля) <> Неопределено);
		
		НоваяСтрока = ТаблицаГруппировка.Добавить();
		
		НоваяСтрока["Использование"]	= Использование;
		НоваяСтрока["Поле"]				= ИмяПоля;
		НоваяСтрока["Представление"]	= ПолучитьПредставлениеПоля(ИмяПоля);
		НоваяСтрока["Фиксация"]			= Фиксация;
		НоваяСтрока["ТипГруппировки"]	= ТипГруппировки;
	КонецЦикла;
	
	СдвинутьЗафиксированныеСтрокиВниз(ТаблицаГруппировка);
	
КонецПроцедуры

// Имена полей (колонок), используемых помощником.
// Пометка "(авто)" у имени свойства означает, что значение свойства составляется автоматически
// на основании значений других свойств, указываемых явным образом.
//
// Возвращаемое значение
//	Структура	- содержит ключи
//
//	ПоляПлана						- Структура
//		ПолныйСписок					- Массив	- имена полей плана
//
//	ПоляНазначения					- Структура
//		ПолныйСписок					- Массив	- имена всех полей назначения
//
//	ПоляГруппировки					- Структура
//		ПолныйСписок					- Массив	- имена всех полей
//		ДоступныеСУчетомФО (авто)		- Массив	- имена всех полей, за вычетом неиспользуемых опциональных колонок
//		Зафиксированные					- Массив	- имена полей, положение которых в табличной части пользователь не может изменить
//
//	ПоляТаблицыПоказатели			- Структура
//		Аналитика						- Структура
//			ПолныйСписок					- Массив	- имена всех полей
//			Ядро							- Массив	- ядро аналитики (нередактируемая часть аналитики)
//			РедактируемаяЧасть (авто)		- Массив	- все поля, за исключением ядра.
//													Составляется автоматически следующим образом:
//													РедактируемаяЧасть = ПолныйСписок "-" Ядро
//			СкрываемаяЧасть					- Массив	- видимостью этих полей одновременно управляет соответствующая настройка
//			СкрываемаяЧастьСУчетомФО (авто)	- Массив	- скрываемая часть, за вычетом неиспользуемых опциональных колонок
//		Значения						- Массив	- имена полей, предназначенных для значения показателя
//		РедактируемыеПоляПоказателя (авто)	- Массив	- 1)редактируемая часть аналитики, 2)значения
//
//	ПустыеСтруктуры (авто)				- Структура	- составляются автоматически на основании имен полей, указанных выше.
//		Показатель (авто)					- ФиксированнаяСтруктура	- значение Неопределено у ключей 1)аналитики, 2)значений
//		АналитикаПоказателя (авто)			- ФиксированнаяСтруктура	- значение Неопределено у ключей только для аналитики
//		ПоляНазначения (авто)				- ФиксированнаяСтруктура	- значение Неопределено полного списка полей назначения
//		ПоляПлана (авто)					- ФиксированнаяСтруктура	- значение Неопределено полного списка полей плана
//
Функция ПолучитьСпискиПолей(ФОУчетПоИФО, ФОУчетПоПодразделениям) Экспорт
	
	//
	//	Поля плана
	//
	ПоляПлана = Новый Массив();
	ПоляПлана.Добавить("КФО");
	ПоляПлана.Добавить("ВидПоказателя");
	ПоляПлана.Добавить("УточнениеПоказателя");
	
	//
	//	Поля назначения
	//
	ПолныйСписок = Новый Массив();
	ПолныйСписок.Добавить("КФО");
	ПолныйСписок.Добавить("ВидПоказателя");
	ПолныйСписок.Добавить("УточнениеПоказателя");
	ПолныйСписок.Добавить("Субсидия");
	ПолныйСписок.Добавить("ИФО");
	ПолныйСписок.Добавить("План");
	
	ПоляНазначения = Новый Структура();
	ПоляНазначения.Вставить("ПолныйСписок", ПолныйСписок);
	
	//
	// Поля группировки
	// В СКД Показатели эти поля должны быть в списке доступных для группировки
	//
	ПолныйСписок = Новый Массив();				ДоступныеСУчетомФО = Новый Массив();
	ПолныйСписок.Добавить("План");				ДоступныеСУчетомФО.Добавить("План");
	ПолныйСписок.Добавить("КФО");				ДоступныеСУчетомФО.Добавить("КФО");
	ПолныйСписок.Добавить("Субсидия");			ДоступныеСУчетомФО.Добавить("Субсидия");
	ПолныйСписок.Добавить("ВидПоказателя");		ДоступныеСУчетомФО.Добавить("ВидПоказателя");
	ПолныйСписок.Добавить("ОтчетныйПериод");	ДоступныеСУчетомФО.Добавить("ОтчетныйПериод");
	ПолныйСписок.Добавить("СтатьяПлана");		ДоступныеСУчетомФО.Добавить("СтатьяПлана");
	ПолныйСписок.Добавить("ИФО");
	ПолныйСписок.Добавить("Подразделение");
	Если ФОУчетПоИФО Тогда 
		ДоступныеСУчетомФО.Добавить("ИФО");
	КонецЕсли;
	Если ФОУчетПоПодразделениям Тогда
		ДоступныеСУчетомФО.Добавить("Подразделение");
	КонецЕсли;
	
	Зафиксированные = Новый Массив();
	Зафиксированные.Добавить("СтатьяПлана");
	
	ПоляГруппировки = Новый Структура();
	ПоляГруппировки.Вставить("ПолныйСписок",		ПолныйСписок);
	ПоляГруппировки.Вставить("ДоступныеСУчетомФО",	ДоступныеСУчетомФО);
	ПоляГруппировки.Вставить("Зафиксированные",		Зафиксированные);
	
	//
	// Поля аналитики таблицы Показатели
	//
	ПолныйСписок = Новый Массив();
	ПолныйСписок.Добавить("План");
	ПолныйСписок.Добавить("КФО");
	ПолныйСписок.Добавить("Субсидия");
	ПолныйСписок.Добавить("ВидПоказателя");
	ПолныйСписок.Добавить("УточнениеПоказателя");
	ПолныйСписок.Добавить("ОтчетныйПериод");
	ПолныйСписок.Добавить("СтатьяПлана");
	ПолныйСписок.Добавить("ИФО");
	ПолныйСписок.Добавить("Подразделение");
	
	Ядро = Новый Массив();
	Ядро.Добавить("КФО");
	Ядро.Добавить("ВидПоказателя");
	Ядро.Добавить("УточнениеПоказателя");
	Ядро.Добавить("План");
	Ядро.Добавить("СтатьяПлана");
	
	РедактируемаяЧасть = Новый Массив(); // составляется автоматически
	Для Каждого ИмяПоля Из ПолныйСписок Цикл
		ЭтоПолеЯдра = (Ядро.Найти(ИмяПоля) <> Неопределено);
		
		Если НЕ ЭтоПолеЯдра Тогда
			РедактируемаяЧасть.Добавить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	СкрываемаяЧасть = Новый Массив();					СкрываемаяЧастьСУчетомФО = Новый Массив();
	СкрываемаяЧасть.Добавить("План");					СкрываемаяЧастьСУчетомФО.Добавить("План");
	СкрываемаяЧасть.Добавить("КФО");					СкрываемаяЧастьСУчетомФО.Добавить("КФО");
	СкрываемаяЧасть.Добавить("Субсидия");				СкрываемаяЧастьСУчетомФО.Добавить("Субсидия");
	СкрываемаяЧасть.Добавить("ВидПоказателя");			СкрываемаяЧастьСУчетомФО.Добавить("ВидПоказателя");
	СкрываемаяЧасть.Добавить("ОтчетныйПериод");			СкрываемаяЧастьСУчетомФО.Добавить("ОтчетныйПериод");
	СкрываемаяЧасть.Добавить("ИФО");
	СкрываемаяЧасть.Добавить("Подразделение");
	Если ФОУчетПоИФО Тогда 
		СкрываемаяЧастьСУчетомФО.Добавить("ИФО");
	КонецЕсли;
	Если ФОУчетПоПодразделениям Тогда
		СкрываемаяЧастьСУчетомФО.Добавить("Подразделение");
	КонецЕсли;
	
	Аналитика = Новый Структура();
	Аналитика.Вставить("ПолныйСписок",				ПолныйСписок);
	Аналитика.Вставить("Ядро",						Ядро);
	Аналитика.Вставить("РедактируемаяЧасть",		РедактируемаяЧасть);
	Аналитика.Вставить("СкрываемаяЧасть",			СкрываемаяЧасть);
	Аналитика.Вставить("СкрываемаяЧастьСУчетомФО",	СкрываемаяЧастьСУчетомФО);
	
	//
	// Поля значений таблицы Показатели
	//
	Значения = Новый Массив();
	Значения.Добавить("Поступления");
	Значения.Добавить("Выбытия");
	
	//
	// Редактируемые поля показателя (авто)
	//
	РедактируемыеПоляПоказателя = Новый Массив();
	Для Каждого ИмяПоля Из Аналитика["РедактируемаяЧасть"] Цикл
		РедактируемыеПоляПоказателя.Добавить(ИмяПоля);
	КонецЦикла;
	Для Каждого ИмяПоля Из Значения Цикл
		РедактируемыеПоляПоказателя.Добавить(ИмяПоля);
	КонецЦикла;
	
	ПоляТаблицыПоказатели = Новый Структура();
	ПоляТаблицыПоказатели.Вставить("Аналитика",						Аналитика);
	ПоляТаблицыПоказатели.Вставить("Значения",						Значения);
	ПоляТаблицыПоказатели.Вставить("РедактируемыеПоляПоказателя",	РедактируемыеПоляПоказателя);
	
	
	
	//
	// Пустые структуры (авто)
	//
	ПустаяСтруктураПоказатель										= Новый Структура();
	ПустаяСтруктураАналитикаПоказателя								= Новый Структура();
	
	// Добавляем все поля полной аналитики
	Для Каждого ИмяПоля Из ПоляТаблицыПоказатели["Аналитика"]["ПолныйСписок"] Цикл
		ПустаяСтруктураПоказатель.Вставить(ИмяПоля);
		
		ПустаяСтруктураАналитикаПоказателя.Вставить(ИмяПоля);
	КонецЦикла;
	
	// Добавляем все поля значения
	Для Каждого ИмяПоля Из ПоляТаблицыПоказатели["Значения"] Цикл
		ПустаяСтруктураПоказатель.Вставить(ИмяПоля);
	КонецЦикла;
	
	ПустаяСтруктураПоляНазначения = Новый Структура();
	Для Каждого ИмяПоля Из ПоляНазначения["ПолныйСписок"] Цикл
		ПустаяСтруктураПоляНазначения.Вставить(ИмяПоля);
	КонецЦикла;
	
	ПустаяСтруктураПоляПлана = Новый Структура();
	Для Каждого ИмяПоля Из ПоляПлана Цикл
		ПустаяСтруктураПоляПлана.Вставить(ИмяПоля);
	КонецЦикла;
	
	Для Каждого ИмяПоля Из ПоляНазначения["ПолныйСписок"] Цикл
		ПустаяСтруктураПоляНазначения.Вставить(ИмяПоля);
	КонецЦикла;

	ПустыеСтруктуры = Новый Структура();
	ПустыеСтруктуры.Вставить("Показатель",										Новый ФиксированнаяСтруктура(ПустаяСтруктураПоказатель));
	ПустыеСтруктуры.Вставить("АналитикаПоказателя",								Новый ФиксированнаяСтруктура(ПустаяСтруктураАналитикаПоказателя));
	ПустыеСтруктуры.Вставить("ПоляНазначения",									Новый ФиксированнаяСтруктура(ПустаяСтруктураПоляНазначения));
	ПустыеСтруктуры.Вставить("ПоляПлана",										Новый ФиксированнаяСтруктура(ПустаяСтруктураПоляПлана));
	
	СпискиПолей = Новый Структура();
	СпискиПолей.Вставить("ПоляПлана",				ПоляПлана);
	СпискиПолей.Вставить("ПоляНазначения",			ПоляНазначения);
	СпискиПолей.Вставить("ПоляГруппировки",			ПоляГруппировки);
	СпискиПолей.Вставить("ПоляТаблицыПоказатели",	ПоляТаблицыПоказатели);
	СпискиПолей.Вставить("ПустыеСтруктуры",			ПустыеСтруктуры);
	
	Возврат СпискиПолей;
	
КонецФункции

Процедура СдвинутьЗафиксированныеСтрокиВниз(ТаблицаГруппировка) Экспорт
	
	Перем ИндексСтроки;
	
	// Зафиксированные строки располагаем самыми последними
	// Сдвигаем их в самый низ таблицы
	
	КоличествоСтрок = ТаблицаГруппировка.Количество();
	
	МаксимальныйИндекс = (КоличествоСтрок - 1);
	
	ИндексСтроки = 0;
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		
		СтрокаТаблицы = ТаблицаГруппировка[ИндексСтроки];
		
		Фиксация = СтрокаТаблицы["Фиксация"];
		
		Если НЕ Фиксация Тогда
			ИндексСтроки = ИндексСтроки + 1;
			
			Продолжить;
		КонецЕсли;
		
		Смещение = (МаксимальныйИндекс - ИндексСтроки);
		
		Если Смещение > 0 Тогда
			ТаблицаГруппировка.Сдвинуть(ИндексСтроки, Смещение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьУсловноеОформление_ВидКПСБУАУ(Форма, ИмяЭлементаФормыСписок, ПутьКОбъектуСписка = Неопределено) Экспорт
	
	// Сделано по аналогии с БюджетнаяКлассификация.УстановитьУсловноеОформлениеПоляВидКПСБУАУВСписке(...)
	
	Если ПутьКОбъектуСписка = Неопределено Тогда
		ПутьКОбъектуСписка = ИмяЭлементаФормыСписок;
	КонецЕсли;
	
	ПутьКОбъектуСписка = ПутьКОбъектуСписка + ".";
	
	//---
	// 1. Уточнение вида показателя - "Доходы"
	//---
	ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Таблица ""%1"" - уточнение вида показателя - ""Доходы""'"),
		ИмяЭлементаФормыСписок);
	
	// Условие
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКОбъектуСписка + "ВидПоказателя");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Перечисления.ВидыКБК.АУИБУ;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКОбъектуСписка + "УточнениеПоказателя");
