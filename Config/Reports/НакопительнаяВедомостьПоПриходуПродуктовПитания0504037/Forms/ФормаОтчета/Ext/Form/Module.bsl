
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтруктураБыстрыеОтборы = Новый Структура("Организация,НачалоПериода,КонецПериода");

	РегламентированныеРегистры.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Если НЕ ЗначениеЗаполнено(Отчет.ОрганизацияПечать) Тогда
		Отчет.ОрганизацияПечать = Отчет.Организация;
	КонецЕсли;	

	Для каждого КлючЗначение из СтруктураБыстрыеОтборы цикл
		Значение = Неопределено;
		Если Параметры.Свойство(КлючЗначение.Ключ, Значение) тогда
			Отчет[КлючЗначение.Ключ] = Значение;
		КонецЕсли;	
	КонецЦикла;
	
	Отчет.РежимРасшифровки = Параметры.ПредставлениеВарианта = "Расшифровка";
	
	Если Отчет.РежимРасшифровки и ТипЗнч(Параметры.Расшифровка) = Тип("ОписаниеОбработкиРасшифровкиКомпоновкиДанных") тогда
		Для каждого ЭлементСтруктуры из Параметры.Расшифровка.ПрименяемыеНастройки.Структура цикл
			Если ТипЗнч(ЭлементСтруктуры) = Тип("ГруппировкаКомпоновкиДанных") тогда
				Для каждого ЭлементВывода из  ЭлементСтруктуры.ПараметрыВывода.Элементы цикл
					Если ЭлементВывода.Параметр = Новый ПараметрКомпоновкиДанных("МакетОформления") тогда
						ЭлементВывода.Использование = Истина;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВидимостьНастроек();
	РассчитатьПоказатели();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	ВариантМодифицирован                    = Ложь;
	ПользовательскиеНастройкиМодифицированы = Истина;
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	Настройки.ДополнительныеСвойства.Вставить("ТекущиеНастройки", Новый ХранилищеЗначения(Отчет.КомпоновщикНастроек.ПолучитьНастройки()));	
	СтандартныеОтчеты.ПриСохраненииПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	РегламентированныеРегистры.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	СтандартныеОтчетыКлиент.ОбновитьОтборКомпоновщикаНастроекБыстрымиОтборами(Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы, 
			Новый Структура("Организация",Отчет.Организация));

	РегламентированныеРегистрыКлиент.ОтборПравоеЗначениеПриИзмененииОчистка(Новый Структура("Сотрудник,МестоХранения"), Отчет.КомпоновщикНастроек);
		
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ОбновитьОтборПоОрганизации();
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент)
	ПодключитьОбработчикОжидания("РассчитатьПоказателиДинамически", 0.2, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОтборПравоеЗначениеПриИзменении(Элемент)
	Если Элементы.Отбор.ТекущиеДанные.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация") Тогда
		СписокПолейДляОчистки = Новый Структура("Сотрудник,МестоХранения");	
		РегламентированныеРегистрыКлиент.ОтборПравоеЗначениеПриИзмененииОчистка(СписокПолейДляОчистки, Отчет.КомпоновщикНастроек);
		Отчет.Организация = Элементы.Отбор.ТекущиеДанные.ПравоеЗначение;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПравоеЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Найти("В списке, В группе из списка, Не в списке, Не в группе из списка",Элементы.Отбор.ТекущиеДанные.ВидСравнения) = 0 тогда
		СписокЗависимыхПолей = Новый Структура("Сотрудник,МестоХранения",
									Новый Структура("МастерПоле, Отбор","Организация", Новый Структура("ПолеОтбора,Форма","Владелец","Справочник.Сотрудники")),
									Новый Структура("МастерПоле, Отбор","Организация", Новый Структура("ПолеОтбора,Форма","Владелец","Справочник.МестаХранения")));
		РегламентированныеРегистрыКлиент.ОтборПравоеЗначениеНачалоВыбора(Элемент, СтандартнаяОбработка, Элементы.Отбор.ТекущиеДанные, СписокЗависимыхПолей, Отчет.КомпоновщикНастроек);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ЕСли Элемент.ТекущийЭлемент.Вид = ВидПоляФормы.ПолеВвода тогда
		Элемент.ТекущийЭлемент.РежимВыбораИзСписка = Ложь;
		Если ЗначениеЗаполнено(Отчет.Организация) тогда
			Если Элементы.Отбор.ТекущиеДанные.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КФО") и Элемент.текущийЭлемент.Имя = "ОтборПравоеЗначение" тогда
				Элемент.ТекущийЭлемент.РежимВыбораИзСписка = Истина;
				Элемент.ТекущийЭлемент.СписокВыбора.ЗагрузитьЗначения(ПолучитьДоступныеКФО(Отчет.Организация,Отчет.НачалоПериода));
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	МассивОсновныхДействий = Новый Массив;
	МассивОсновныхДействий.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Расшифровать);
	СтандартныеОтчетыКлиент.ОбработкаРасшифровкиСанкционирование(ЭтаФорма, Элемент, ДанныеРасшифровки, Расшифровка, ПоказательСчет, МассивОсновныхДействий);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	ОчиститьСообщения();
	СформироватьОтчетСервер();	
КонецПроцедуры

&НаКлиенте
Процедура ПанельНастроек(Команда)
	Отчет.ВидимостьНастроек = Не Элементы.ГруппаПанельНастроек.Видимость;
	ВидимостьНастроек();	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеНастройки(Команда)
	РегламентированныеРегистрыКлиент.СинхронизироватьОтборПользовательскиеНастройки(ЭтаФорма);
	
	ОткрытьФорму("Обработка.КонструкторПользовательскихНастроек.Форма",
		Новый Структура("КомпоновщикНастроек,Схема",Отчет.КомпоновщикНастроек,СхемаКомпоновкиДанных),
		ЭтотОбъект,,,, Новый ОписаниеОповещения("ПрименитьНовыеНастройки", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
    Диалог.Период.ДатаНачала = Отчет.НачалоПериода;
    Диалог.Период.ДатаОкончания = Отчет.КонецПериода;
    Диалог.Показать(Новый ОписаниеОповещения("УстановитьПериодЗавершение", ЭтотОбъект));

	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодЗавершение(Период, ДополнительныеПараметры) Экспорт
    
    Если Период <> Неопределено Тогда
		
		Отчет.НачалоПериода = Период.ДатаНачала;
        Отчет.КонецПериода  = Период.ДатаОкончания;
		
		Модифицированность = Истина;
		
		СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);

    КонецЕсли; 
	
КонецПроцедуры

