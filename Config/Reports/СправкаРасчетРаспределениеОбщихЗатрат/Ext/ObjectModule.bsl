// ОБРАБОТЧИКИ СОБЫТИЙ

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	НеПроверятьНаправлениеДеятельности = Ложь;
	Если ВидОбщихЗатрат = Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты Тогда
		Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.70")).ЭлементГруппа Тогда
			ПроверяемыйСчет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.71");
		Иначе
			ПроверяемыйСчет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.70");
		КонецЕсли;
		
		НеПроверятьНаправлениеДеятельности = НЕ БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(ПроверяемыйСчет,
																			ПланыВидовХарактеристик.ВидыСубконто.НаправленияДеятельности);
	ИначеЕсли ВидОбщихЗатрат = Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты Тогда
		Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.80")).ЭлементГруппа Тогда
			ПроверяемыйСчет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.81");
		Иначе
			ПроверяемыйСчет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.80");
		КонецЕсли;
		НеПроверятьНаправлениеДеятельности = НЕ БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(ПроверяемыйСчет,
																			ПланыВидовХарактеристик.ВидыСубконто.НаправленияДеятельности);
	КонецЕсли;
	Если НеПроверятьНаправлениеДеятельности Тогда
		ТекРеквизит = ПроверяемыеРеквизиты.Найти("НаправлениеДеятельности");
		Если ТекРеквизит<>Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(ТекРеквизит);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецЕсли
