#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура СформироватьОтчет(ТабДокумент) Экспорт
	
	ЛокальныеПеременные = Новый Структура;
	ЛокальныеПеременные.Вставить("мВидОПЗ",Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты);
	ЛокальныеПеременные.Вставить("мВидОХЗ",Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты);

	ЛокальныеПеременные.Вставить("мБазаОплатаТруда",Перечисления.БазыРаспределенияКосвенныхЗатрат.ОплатаТруда);
	ЛокальныеПеременные.Вставить("мБазаМатериальныеЗатраты", Перечисления.БазыРаспределенияКосвенныхЗатрат.МатериальныеЗатраты);
	ЛокальныеПеременные.Вставить("мБазаПрямыеЗатраты", Перечисления.БазыРаспределенияКосвенныхЗатрат.ПрямыеЗатраты);
	ЛокальныеПеременные.Вставить("мБазаВыручка", Перечисления.БазыРаспределенияКосвенныхЗатрат.Выручка);

	Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.60")).ЭлементГруппа Тогда
		ЛокальныеПеременные.Вставить("мСчет10961", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.61"));
	Иначе
		ЛокальныеПеременные.Вставить("мСчет10961", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.60"));
	КонецЕсли;
	Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.70")).ЭлементГруппа Тогда
		ЛокальныеПеременные.Вставить("мСчет10971", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.71"));
	Иначе
		ЛокальныеПеременные.Вставить("мСчет10971", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.70"));
	КонецЕсли;
	Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.80")).ЭлементГруппа Тогда
		ЛокальныеПеременные.Вставить("мСчет10981", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.81"));
	Иначе
		ЛокальныеПеременные.Вставить("мСчет10981", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.80"));
	КонецЕсли;
	ЛокальныеПеременные.Вставить("мЕстьНаправлениеДеятельности", БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(
																 ?(ВидОбщихЗатрат = ЛокальныеПеременные.мВидОПЗ,
																   ЛокальныеПеременные.мСчет10971, 
																   ЛокальныеПеременные.мСчет10981),
																  ПланыВидовХарактеристик.ВидыСубконто.НаправленияДеятельности));
	РассчитыватьСебестоимостьВКонцеГода = УчетПроизводства.РассчитыватьСебестоимостьВКонцеГода(Организация, КонецПериода);
	ЛокальныеПеременные.Вставить("РассчитыватьСебестоимостьВКонцеГода", РассчитыватьСебестоимостьВКонцеГода);
	
	ТабДокумент.Очистить();
	МассивНоменклатурныхГрупп = СписокНоменклатуры.ВыгрузитьЗначения();
	ДеревоЗапроса = ВыполнитьЗапрос(МассивНоменклатурныхГрупп, ДанныеБУ, ДанныеНУ, ЛокальныеПеременные);
	
	Макет = ПолучитьМакет("Макет");
	ОбластьЗаголовок        = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка            = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока           = Макет.ПолучитьОбласть("Строка");
	ОбластьПодСтрока        = Макет.ПолучитьОбласть("ПодСтрока");
	ОбластьИтого            = Макет.ПолучитьОбласть("Итого");
	ОбластьВсего            = Макет.ПолучитьОбласть("Всего");
	ОбластьОкончаниеТаблицы = Макет.ПолучитьОбласть("ОкончаниеТаблицы");
	ОбластьОтветственный    = Макет.ПолучитьОбласть("Ответственный");
	
	ОрганизацияНаименование = Организация.НаименованиеПолное;
	
	СтрокаОтбора = "";
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		СтрокаОтбора = СтрокаОтбора + ?(ЗначениеЗаполнено(ИФО), "ИФО - " + ИФО, "По всем ИФО") + ", ";
	КонецЕсли;
	СтрокаОтбора = СтрокаОтбора + ?(ЗначениеЗаполнено(КФО), "КФО - " + КФО, "По всем КФО");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		СтрокаОтбора = СтрокаОтбора +
			?(ЗначениеЗаполнено(Подразделение), ", Подразделение - " + Подразделение,
				", По всем подразделениям");
	КонецЕсли;
	Если ЛокальныеПеременные.мЕстьНаправлениеДеятельности Тогда
		СтрокаОтбора = СтрокаОтбора +
			?(ЗначениеЗаполнено(НаправлениеДеятельности), ", Направление деятельности - " + НаправлениеДеятельности,
				", По всем направлениям деятельности");
	КонецЕсли;
	
	Для каждого СтрокаПериод из ДеревоЗапроса.Строки Цикл
		
		Если ДеревоЗапроса.Строки.Индекс(СтрокаПериод) > 0 Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ОбластьЗаголовок.Параметры.ОрганизацияНаименование = ОрганизацияНаименование; 
		Если ЛокальныеПеременные.РассчитыватьСебестоимостьВКонцеГода Тогда
			ПараметрДата = КонецГода(СтрокаПериод.Период);
		Иначе
			ПараметрДата = КонецМесяца(СтрокаПериод.Период);
		КонецЕсли;
		ОбластьЗаголовок.Параметры.Дата   = ПараметрДата; 
		ОбластьЗаголовок.Параметры.Период = "" + ПредставлениеПериода(
			НачалоМесяца(СтрокаПериод.Период), ПараметрДата, "ФП = Истина");
		
		ОбластьЗаголовок.Параметры.СтрокаОтбора = СтрокаОтбора;
		ОбластьЗаголовок.Параметры.ТипЗатрат    = ?(ВидОбщихЗатрат = ЛокальныеПеременные.мВидОПЗ,
			НСтр("ru = 'накладных расходов производства'"),
			НСтр("ru = 'общехозяйственных расходов'"));
		
		ТабДокумент.Вывести(ОбластьЗаголовок);
		
		ОбластьШапка.Параметры.ТипЗатратШапка = ?(ВидОбщихЗатрат = ЛокальныеПеременные.мВидОПЗ,
			НСтр("ru = 'Накладные расходы производства'"),
			НСтр("ru = 'Общехозяйственные расходы'"));
		
		Для каждого СтрокаБазаРаспределения из СтрокаПериод.Строки Цикл
			
			Если СтрокаБазаРаспределения.БазаРаспределения = ЛокальныеПеременные.мБазаМатериальныеЗатраты Тогда
				База      = НСтр("ru = 'Распределение пропорционально материальным затратам'");
				ТекстБазы = НСтр("ru = 'Материальные затраты'");
			ИначеЕсли СтрокаБазаРаспределения.БазаРаспределения = ЛокальныеПеременные.мБазаПрямыеЗатраты Тогда
				База      = НСтр("ru = 'Распределение пропорционально прямым затратам'");
				ТекстБазы = НСтр("ru = 'Прямые затраты'");
			ИначеЕсли СтрокаБазаРаспределения.БазаРаспределения = ЛокальныеПеременные.мБазаОплатаТруда Тогда
				База      = НСтр("ru = 'Распределение пропорционально затратам на оплату труда'");
				ТекстБазы = НСтр("ru = 'Оплата труда'");
			ИначеЕсли СтрокаБазаРаспределения.БазаРаспределения = ЛокальныеПеременные.мБазаВыручка Тогда
				База      = НСтр("ru = 'Распределение пропорционально выручке от продаж'");
				ТекстБазы = НСтр("ru = 'Выручка'");
			Иначе
				База      = НСтр("ru = 'Распределение выполнено вручную'");
				ТекстБазы = НСтр("ru = 'База распределения'");
			КонецЕсли;
			ОбластьШапка.Параметры.База      = База;
			ОбластьШапка.Параметры.ТекстБазы = ТекстБазы;
			
			ТабДокумент.Вывести(ОбластьШапка);
			
			КолСтрок = 0;
			Для каждого СтрокаСчет из СтрокаБазаРаспределения.Строки Цикл
			Для каждого СтрокаКФО из СтрокаСчет.Строки Цикл
			Для каждого СтрокаКПС из СтрокаКФО.Строки Цикл
			Для каждого СтрокаКЭКЗатрат из СтрокаКПС.Строки Цикл
			Для каждого СтрокаВидЗатрат из СтрокаКЭКЗатрат.Строки Цикл
				ЦветФонаГруппировки = ?(КолСтрок % 2 = 0, Новый Цвет(255, 212, 196), Новый Цвет);
				
				ОбластьСтрока.Параметры.Заполнить(СтрокаВидЗатрат);
				ОбластьСтрока.Параметры.СчетУчета = "" + СтрокаВидЗатрат.КПС + "." 
										+ БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(СтрокаВидЗатрат.СчетУчета,,СтрокаВидЗатрат.КФО)
										+ "." + СтрокаВидЗатрат.КЭК;
				ОбластьСтрока.Параметры.СуммаЗатрат = СтрокаВидЗатрат.Сумма;
				
				ТабДокумент.Вывести(ОбластьСтрока);
				ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, 2, ТабДокумент.ВысотаТаблицы, 9).ЦветФона 
																								= ЦветФонаГруппировки;
				
				ВсегоСуммаБазы = СтрокаВидЗатрат.СуммаБазы;
				
				Для каждого СтрокаНоменклатурнаяГруппа из СтрокаВидЗатрат.Строки Цикл
					Для каждого СтрокаКорСчет из СтрокаНоменклатурнаяГруппа.Строки Цикл
						ОбластьПодСтрока.Параметры.Заполнить(СтрокаКорСчет);
						ОбластьПодСтрока.Параметры.КорСчет = "" + СтрокаКорСчет.КорКПС + "." 
										+ БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(СтрокаКорСчет.КорСчет,,СтрокаКорСчет.КФО)
										+ "." + СтрокаКорСчет.КЭК;
						ОбластьПодСтрока.Параметры.Коэффициент = ?(ВсегоСуммаБазы = 0, 0, СтрокаКорСчет.СуммаБазы 
																						  / ВсегоСуммаБазы);
						
						ТабДокумент.Вывести(ОбластьПодСтрока);
						ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, 2, ТабДокумент.ВысотаТаблицы, 9).ЦветФона = ЦветФонаГруппировки;
					КонецЦикла;	
				КонецЦикла;	
				
				ОбластьИтого.Параметры.Заполнить(СтрокаВидЗатрат);
				ТабДокумент.Вывести(ОбластьИтого);
				ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, 2, ТабДокумент.ВысотаТаблицы, 9).ЦветФона = ЦветФонаГруппировки;
				КолСтрок = КолСтрок + 1;
			КонецЦикла;
			КонецЦикла;
			КонецЦикла;
			КонецЦикла;
			КонецЦикла;
			
		КонецЦикла;
		
		ОбластьВсего.Параметры.Заполнить(СтрокаПериод);
		ТабДокумент.Вывести(ОбластьВсего);
		ТабДокумент.Вывести(ОбластьОкончаниеТаблицы);
		ТабДокумент.Вывести(ОбластьОтветственный);
		
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ВыполнитьЗапрос(МассивНоменклатурныхГрупп, ДанныеБУ, ДанныеНУ, ЛокальныеПеременные)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РаспределениеОбщихЗатрат.ПериодРасчета КАК Период,
	|	РаспределениеОбщихЗатрат.Организация,
	|	РаспределениеОбщихЗатрат.ИФО,
	|	РаспределениеОбщихЗатрат.КФО КАК КФО,
	|	РаспределениеОбщихЗатрат.ВидОбщихЗатрат,
	|	РаспределениеОбщихЗатрат.ВидЗатрат КАК ВидЗатрат,
	|	РаспределениеОбщихЗатрат.КЭК КАК КЭК,
	|	РаспределениеОбщихЗатрат.СчетУчета КАК СчетУчета,
	|	РаспределениеОбщихЗатрат.КПС КАК КПС,
	|	РаспределениеОбщихЗатрат.Подразделение,
	|	РаспределениеОбщихЗатрат.НаправлениеДеятельности,
	|	РаспределениеОбщихЗатрат.КорСчет,
	|	РаспределениеОбщихЗатрат.КорКПС,
	|	РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа КАК КорНоменклатурнаяГруппа,
	|	РаспределениеОбщихЗатрат.КорПодразделение,
	|	РаспределениеОбщихЗатрат.КорНаправлениеДеятельности,
	|	СУММА(РаспределениеОбщихЗатрат.Сумма) КАК Сумма,
	|	СУММА(РаспределениеОбщихЗатрат.СуммаБазы) КАК СуммаБазы,
	|	РаспределениеОбщихЗатрат.БазаРаспределения КАК БазаРаспределения
	|ИЗ
	|	РегистрСведений.РасчетРаспределенияОбщихЗатрат КАК РаспределениеОбщихЗатрат
	|ГДЕ
	|	РаспределениеОбщихЗатрат.ПериодРасчета МЕЖДУ &ДатаНачала И &ДатаКонца
	|	И РаспределениеОбщихЗатрат.Организация = &Организация
	|	И (РаспределениеОбщихЗатрат.ИФО = &ИФО
	|			ИЛИ &ИФО = ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
	|	И (РаспределениеОбщихЗатрат.КФО = &КФО
	|			ИЛИ &КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка))
	|	И (РаспределениеОбщихЗатрат.Подразделение = &Подразделение
	|			ИЛИ &Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|	И РаспределениеОбщихЗатрат.ВидОбщихЗатрат = &ВидОбщихЗатрат
	|	И РаспределениеОбщихЗатрат.Активность = ИСТИНА
	|	И &ОтборДанныхБУиНУ
	|	И &ОтборПоНоменклатурнымГруппам
	|	И &ОтборПоНаправлениямДеятельности
	|
	|СГРУППИРОВАТЬ ПО
	|	РаспределениеОбщихЗатрат.ПериодРасчета,
	|	РаспределениеОбщихЗатрат.Организация,
	|	РаспределениеОбщихЗатрат.ИФО,
	|	РаспределениеОбщихЗатрат.КФО,
	|	РаспределениеОбщихЗатрат.ВидОбщихЗатрат,
	|	РаспределениеОбщихЗатрат.ВидЗатрат,
	|	РаспределениеОбщихЗатрат.КЭК,
	|	РаспределениеОбщихЗатрат.СчетУчета,
	|	РаспределениеОбщихЗатрат.КПС,
	|	РаспределениеОбщихЗатрат.Подразделение,
	|	РаспределениеОбщихЗатрат.НаправлениеДеятельности,
	|	РаспределениеОбщихЗатрат.КорСчет,
	|	РаспределениеОбщихЗатрат.КорКПС,
	|	РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа,
	|	РаспределениеОбщихЗатрат.КорПодразделение,
	|	РаспределениеОбщихЗатрат.КорНаправлениеДеятельности,
	|	РаспределениеОбщихЗатрат.БазаРаспределения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период,
	|	РаспределениеОбщихЗатрат.СчетУчета,
	|	РаспределениеОбщихЗатрат.КПС,
	|	РаспределениеОбщихЗатрат.КЭК,
	|	РаспределениеОбщихЗатрат.ВидЗатрат,
	|	РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа,
	|	РаспределениеОбщихЗатрат.КорСчет,
	|	РаспределениеОбщихЗатрат.КорКПС
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаБазы)
	|ПО
	|	Период,
	|	БазаРаспределения,
	|	СчетУчета,
	|	КФО,
	|	КПС,
	|	КЭК,
	|	ВидЗатрат,
	|	КорНоменклатурнаяГруппа";
	
	Если ДанныеБУ И НЕ ДанныеНУ Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборДанныхБУиНУ",
			"РаспределениеОбщихЗатрат.СчетУчета.ТипСчета <> ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Налоговый)");
	ИначеЕсли НЕ ДанныеБУ И ДанныеНУ Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборДанныхБУиНУ",
			"РаспределениеОбщихЗатрат.СчетУчета.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Налоговый)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборДанныхБУиНУ", "ИСТИНА");
	КонецЕсли;
	
	Если МассивНоменклатурныхГрупп.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоНоменклатурнымГруппам",
			"РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа В ИЕРАРХИИ (&МассивНоменклатуры)");
		Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатурныхГрупп);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоНоменклатурнымГруппам", "ИСТИНА");
	КонецЕсли;
	
	Если ЛокальныеПеременные.мЕстьНаправлениеДеятельности Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоНаправлениямДеятельности",
			"(РаспределениеОбщихЗатрат.НаправлениеДеятельности = &НаправлениеДеятельности
	|			ИЛИ &НаправлениеДеятельности = ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка))");
		Запрос.УстановитьПараметр("НаправлениеДеятельности", НаправлениеДеятельности);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоНаправлениямДеятельности", "ИСТИНА");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(НачалоПериода));
	Запрос.УстановитьПараметр("ДатаКонца", КонецМесяца(КонецПериода));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИФО", ИФО);
	Запрос.УстановитьПараметр("КФО", КФО);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("ВидОбщихЗатрат", ВидОбщихЗатрат);
	
	ДеревоЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат ДеревоЗапроса;
	
КонецФункции

