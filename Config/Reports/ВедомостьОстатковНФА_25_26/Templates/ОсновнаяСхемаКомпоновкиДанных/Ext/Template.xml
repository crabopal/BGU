	ЕСТЬNULL(ПереданныеОС.СуммаОстаток, Остатки.СуммаОстаток) КАК СуммаОстаток,
	ЕСТЬNULL(ПереданныеОС.КоличествоОстаток, Остатки.КоличествоОстаток) КАК КоличествоОстаток,
	НомераИнвКарточек.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки,
	НомераИнвКарточек.ДатаИнвентарнойКарточки КАК ДатаИнвентарнойКарточки
ИЗ
	Остатки_БУ КАК Остатки
		ЛЕВОЕ СОЕДИНЕНИЕ Остатки_РН КАК ПереданныеОС
		ПО Остатки.Организация = ПереданныеОС.Организация
			И Остатки.Контрагент = ПереданныеОС.Контрагент
			И Остатки.Подразделение = ПереданныеОС.Подразделение
			И Остатки.ОсновноеСредство = ПереданныеОС.ОсновноеСредство
		ЛЕВОЕ СОЕДИНЕНИЕ НомераИнвКарточек КАК НомераИнвКарточек
		ПО Остатки.Организация = НомераИнвКарточек.Организация
			И Остатки.ОсновноеСредство = НомераИнвКарточек.ОсновноеСредство</query>
