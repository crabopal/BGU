#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	ИсполняемыеНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	ПолучательИзОтбора = ПолучательИзОтбора(ИсполняемыеНастройки);
	ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("ПолучательИзОтбора"), ПолучательИзОтбора);

	// вывод отчета
	СтандартнаяОбработка = Ложь;
	ВозможностьИспользованияВнешнихФункций = Истина;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ИсполняемыеНастройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, ВозможностьИспользованияВнешнихФункций);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);

	ОтчетПустой = Истина;
	ВставитьРазделителиСтраниц(ДокументРезультат, ОтчетПустой);
	
	// Сохранить признак ОтчетПустой для подсистемы Рассылка отчетов
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ОтчетПустой", ОтчетПустой);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучательИзОтбора(ИсполняемыеНастройки)
	ПолеПолучатель = Новый ПолеКомпоновкиДанных("Получатель");
	Для Каждого ЭлементОтбора Из ИсполняемыеНастройки.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если ЭлементОтбора.Использование И ЭлементОтбора.ЛевоеЗначение = ПолеПолучатель Тогда
				Возврат ЭлементОтбора.ПравоеЗначение;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Справочники.Контрагенты.ПустаяСсылка();
КонецФункции

Процедура ВставитьРазделителиСтраниц(ДокументРезультат, ОтчетПустой)
	МакетСРазрывом = ПолучитьМакет("РазрывСтраницы");
	ОбластьРазрыв = МакетСРазрывом.ПолучитьОбласть("Разрыв");
	
	ОбластьРазрыв = МакетСРазрывом.Область(1, , 2, );
	
	ЯчейкаПереводаСтраницы = Неопределено;
	ТекстПереводаСтраницы = "#НоваяСтраница";
	// Перед первой страницей перевод не делается
	ЯчейкаПереводаСтраницы = ДокументРезультат.НайтиТекст(ТекстПереводаСтраницы, , , , Истина, Истина, Истина);
	Если ЯчейкаПереводаСтраницы <> Неопределено Тогда
		ЯчейкаПереводаСтраницы.Текст = "";
		ОтчетПустой = Ложь;
	КонецЕсли;
	
	ТабД = Новый ТабличныйДокумент;
	ТабД.ВывестиГоризонтальныйРазделительСтраниц();
	
	ЯчейкаПереводаСтраницы = ДокументРезультат.НайтиТекст(ТекстПереводаСтраницы, , , , Истина, Истина, Истина);
	Пока ЯчейкаПереводаСтраницы <> Неопределено Цикл
		ТабД = Новый ТабличныйДокумент;
		ТабД.ВывестиГоризонтальныйРазделительСтраниц();
		ЯчейкаПереводаСтраницы.Текст = "";
		ОбластьПриемник = ДокументРезультат.Область(ЯчейкаПереводаСтраницы.Верх, , ЯчейкаПереводаСтраницы.Верх, );
		ДокументРезультат.ВставитьОбласть(ОбластьРазрыв, ОбластьПриемник, ТипСмещенияТабличногоДокумента.ПоВертикали);	
		ЯчейкаПереводаСтраницы = ДокументРезультат.НайтиТекст(ТекстПереводаСтраницы, , , , Истина, Истина, Истина);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли