// [0].	Строка Итого (обороты по Книге покупок за указанный налоговый период)
//
ВЫБРАТЬ
	ЕСТЬNULL(СУММА(КнигаПокупокОбороты.СуммаНДСОборот),	0)	КАК СуммаНДС
{ВЫБРАТЬ
	СуммаНДС}
ИЗ
	РегистрНакопления.КнигаПокупок.Обороты(&amp;ДатаНачалаНалоговогоПериода, &amp;ДатаОкончанияНалоговогоПериода) КАК КнигаПокупокОбороты
{ГДЕ
	КнигаПокупокОбороты.Организация.*,
	КнигаПокупокОбороты.КФО.*,
	КнигаПокупокОбороты.ПричинаНалогообложения,
	КнигаПокупокОбороты.ДатаСобытия,
	КнигаПокупокОбороты.СчетФактура.ИФО.* КАК ИФО,
