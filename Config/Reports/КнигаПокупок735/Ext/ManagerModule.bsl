#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура СформироватьОтчет(Знач ПараметрыОтчета, ВозвратАдресХранилищаРезультата) Экспорт
	
	Перем	ЗаполнитьДанныеДляДекларации,
			ДанныеДляДекларации,
			РедакцияПостановления;
	
	// Установленные параметры отчета:
	Если ЗначениеЗаполнено(ПараметрыОтчета["НачалоПериода"]) Тогда
		ПараметрыОтчета["НачалоПериода"] = НачалоДня(ПараметрыОтчета["НачалоПериода"]);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета["КонецПериода"]) Тогда
		ПараметрыОтчета["КонецПериода"] = КонецДня(ПараметрыОтчета["КонецПериода"]);
	КонецЕсли;
	СформироватьОсновнойРаздел		= НЕ ПараметрыОтчета["ВыводитьТолькоДопЛисты"];
	СформироватьДопЛисты			= ПараметрыОтчета["ФормироватьДопЛисты"];
	УникальныйИдентификаторФормы	= ПараметрыОтчета["УникальныйИдентификаторФормы"];
	
	ПараметрыОтчета.Свойство("РедакцияПостановления", РедакцияПостановления);
	Если НЕ ЗначениеЗаполнено(РедакцияПостановления) Тогда
		РедакцияПостановления = УчетНДС.ПолучитьПостановлениеПоУмолчаниюДляЗаполненияКниги("КнигаПокупок");
		
		ПараметрыОтчета.Вставить("РедакцияПостановления", РедакцияПостановления);
	КонецЕсли;
	
	// Заменяем параметр на новый, обработанный и готовый к использованию:
	ПараметрыОтчета.Вставить("ПредставленияПричинНалогообложения",
		УчетНДС.ПолучитьПредставленияПричинНалогообложения(
			ПараметрыОтчета["ПредставленияПричинНалогообложения"],
			ПараметрыОтчета["ВыводитьПредставленияПричинНалогообложения"]));
	
	// Результаты отчета:
	СписокСформированныхЛистов = Новый СписокЗначений();
	ДеревоСформированныхЛистов = Новый ДеревоЗначений();
	КЧ = Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Любой);
	ДеревоСформированныхЛистов.Колонки.Добавить("Картинка",								Новый ОписаниеТипов("Картинка"));
	ДеревоСформированныхЛистов.Колонки.Добавить("Наименование",							Новый ОписаниеТипов("Строка"));
	ДеревоСформированныхЛистов.Колонки.Добавить("ПредставлениеНалоговогоПериода",		Новый ОписаниеТипов("Строка"));
	ДеревоСформированныхЛистов.Колонки.Добавить("ИндексСоответствующейСтрокиСписка",	Новый ОписаниеТипов("Число", КЧ));
	ДеревоСформированныхЛистов.Колонки.Добавить("ДатаНачалаПериода",					Новый ОписаниеТипов("Дата"));
	ДеревоСформированныхЛистов.Колонки.Добавить("АдресХранилищаСДаннымиЛиста",			Новый ОписаниеТипов("Строка"));
	ДеревоСформированныхЛистов.Колонки.Добавить("ЭтоДанныеОднимСписком",				Новый ОписаниеТипов("Булево"));
	ДеревоСформированныхЛистов.Колонки.Добавить("ЭтоПустойЛист",						Новый ОписаниеТипов("Булево"));
	
	// Декларация
	ПараметрыОтчета.Свойство("ЗаполнитьДанныеДляДекларации", ЗаполнитьДанныеДляДекларации);
	ЗаполнитьДанныеДляДекларации = (ЗаполнитьДанныеДляДекларации = Истина);
	ПараметрыОтчета.Вставить("ЗаполнитьДанныеДляДекларации", ЗаполнитьДанныеДляДекларации);
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		Если ПараметрыОтчета.ПравилаЗаполнения = "2025Кв1" Тогда
			// Применяется в 1 квартале 2026 г. до реализации изменений приказа ФНС России от 18.12.2025 N ЕД-7-3/1227@
			НаДату = '20250101';
		Иначе
			НаДату = ПараметрыОтчета.КонецПериода;
		КонецЕсли;
		
		РедакцияПостановления = УчетНДС.ПолучитьПостановлениеПоУмолчаниюДляЗаполненияКниги("КнигаПокупок", НаДату);
		
		ПараметрыОтчета.Вставить("РедакцияПостановления", РедакцияПостановления);
		
		ДанныеДляДекларации = Новый Структура();
		ИнициализироватьТаблицыДляДекларацииПоНДС(ДанныеДляДекларации, ПараметрыОтчета);
	КонецЕсли;
	
	ДобавитьРассчитываемыеПараметрыОтчета(ПараметрыОтчета);
	
	Если СформироватьОсновнойРаздел Тогда
		СформироватьОсновнойРаздел(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, ДанныеДляДекларации);
	КонецЕсли;
	
	Если СформироватьДопЛисты Тогда 
		СформироватьДополнительныеЛисты(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, ДанныеДляДекларации);
	КонецЕсли;
	
	// Оформляем пустые результаты отчета
	
	ОтсутствуетОсновнойРаздел = ?(СформироватьОсновнойРаздел, ПараметрыОтчета["ОсновнойРазделПустой"], Истина);
	
	ОтсутствуютДопЛисты = ?(СформироватьДопЛисты, ПараметрыОтчета["ОтсутствуютДопЛисты"], Истина);
	
	ВывестиПустойБланкОсновногоРаздела = СформироватьОсновнойРаздел И ОтсутствуетОсновнойРаздел И ОтсутствуютДопЛисты;
	
	ВывестиПустойБланкДопЛиста = НЕ СформироватьОсновнойРаздел И СформироватьДопЛисты И ОтсутствуютДопЛисты;
	
	Если ВывестиПустойБланкОсновногоРаздела Тогда
		
		ТабДокумент = ВывестиПустойОсновнойРаздел(ПараметрыОтчета);
		
		ДобавитьПустойЛист(ДеревоСформированныхЛистов, ТабДокумент, УникальныйИдентификаторФормы);
		
	ИначеЕсли ВывестиПустойБланкДопЛиста Тогда
		
		ТабДокумент = ВывестиПустойДопЛист(ПараметрыОтчета);
		
		ДобавитьПустойЛист(ДеревоСформированныхЛистов, ТабДокумент, УникальныйИдентификаторФормы);
		
	КонецЕсли;
	
	// Декларация
	Если НЕ ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		
		Если НЕ ВывестиПустойБланкОсновногоРаздела И НЕ ВывестиПустойБланкДопЛиста Тогда
			ДозаполнитьДеревоСформированныхЛистов(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, УникальныйИдентификаторФормы);
		КонецЕсли;
		
		РезультатыОтчета = Новый Структура();
		РезультатыОтчета.Вставить("ДеревоСформированныхЛистов",	ДеревоСформированныхЛистов);
		
		ВозвратАдресХранилищаРезультата = ПоместитьВоВременноеХранилище(РезультатыОтчета, УникальныйИдентификаторФормы);
	КонецЕсли;
	
КонецПроцедуры

#Область СлужебныйПрограммныйИнтерфейс

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "Основной");
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Настройки

Функция ПолучитьИспользуемыйМакет(ПараметрыОтчета)
	
	РедакцияПостановления = ПараметрыОтчета.РедакцияПостановления;
	
	Если РедакцияПостановления = "№ 26 от 23.01.2026" Тогда
		ИмяМакета = "ОбщийМакет.ПФ_MXL_КнигаПокупок1137_26";
		
	ИначеЕсли РедакцияПостановления = "№ 534 от 02.04.2021" Тогда
		ИмяМакета = "ОбщийМакет.ПФ_MXL_КнигаПокупок1137_534";
		
	ИначеЕсли РедакцияПостановления = "№ 981 от 19.08.2017" Тогда
		ИмяМакета = "ОбщийМакет.ПФ_MXL_КнигаПокупок1137_981";
		
	Иначе
		ИмяМакета = "ОбщийМакет.ПФ_MXL_КнигаПокупок1137_735";
	КонецЕсли;
	
	Возврат УправлениеПечатью.МакетПечатнойФормы(ИмяМакета);
	
КонецФункции

Процедура ДобавитьРассчитываемыеПараметрыОтчета(ПараметрыОтчета)
	
	ПараметрыОтчета.Вставить("ПостановлениемПредусмотренПоказательСчетаФактурыНаОтгрузку",
		ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026");
	
	ПараметрыОтчета.Вставить("ПостановлениемПредусмотреныПоказателиПрослеживаемости",
		(ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026"
			Или ПараметрыОтчета.РедакцияПостановления = "№ 1448 от 29.10.2024"));
	
КонецПроцедуры

#КонецОбласти

#Область НастройкаСКД

Функция ПолучитьМакетСКДОсновногоРаздела(ПараметрыОтчета)
	
	Если ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026" Тогда
		ИмяМакета = "ОсновнойРазделКнигиПокупок_26";
	Иначе
		ИмяМакета = "ОсновнойРазделКнигиПокупок";
	КонецЕсли;
	
	Возврат ПолучитьМакет(ИмяМакета);
	
КонецФункции

Функция ПолучитьМакетСКДДопЛиста(ПараметрыОтчета)
	
	Если ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026" Тогда
		ИмяМакета = "ДопЛистыКнигиПокупок_26";
	Иначе
		ИмяМакета = "ДопЛистыКнигиПокупок";
	КонецЕсли;
	
	Возврат ПолучитьМакет(ИмяМакета);
	
КонецФункции

Функция ПолучитьНастройкиСКД_ОсновнойРаздел(ПараметрыОтчета)
	
	Результат = Новый Структура("
		|ИспользуемаяСхемаКомпоновкиДанных,
		|НовыйКомпоновщикНастроек");
	
	// Возвращаемые объекты:
	ИспользуемаяСхемаКомпоновкиДанных	= ПолучитьМакетСКДОсновногоРаздела(ПараметрыОтчета);
	НовыйКомпоновщикНастроек			= Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ИспользуемаяСхемаКомпоновкиДанных));
	НовыйКомпоновщикНастроек.ЗагрузитьНастройки(ИспользуемаяСхемаКомпоновкиДанных.ВариантыНастроек["Основной"].Настройки);
	
	// Настраиваем схему.
	УстановитьПараметрыСКД_ОсновнойРаздел(НовыйКомпоновщикНастроек, ПараметрыОтчета);
	
	// Копируем отбор, установленный в форме отчета:
	СтандартныеОтчетыКлиентСервер.СкопироватьОтбор(
		НовыйКомпоновщикНастроек.Настройки.Отбор,
		ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	
	// Настройки группировок:
	Настройки = НовыйКомпоновщикНастроек.Настройки;
	ГруппировкаНалоговыйПериод				= Настройки.Структура[0];
	ГруппировкаНалоговыйПериодКонтрагент	= Настройки.Структура[1];
	ГруппировкаОднимСписком					= Настройки.Структура[2];
	ГруппировкаОднимСпискомКонтрагент		= Настройки.Структура[3];
	
	Если ПараметрыОтчета["ГруппироватьПоКонтрагентам"] Тогда
		ГруппировкаНалоговыйПериод.Использование			= Ложь;
		ГруппировкаНалоговыйПериодКонтрагент.Использование	= Истина;
		ГруппировкаОднимСписком.Использование				= Ложь;
		ГруппировкаОднимСпискомКонтрагент.Использование		= Истина;
	Иначе
		ГруппировкаНалоговыйПериод.Использование			= Истина;
		ГруппировкаНалоговыйПериодКонтрагент.Использование	= Ложь;
		ГруппировкаОднимСписком.Использование				= Истина;
		ГруппировкаОднимСпискомКонтрагент.Использование		= Ложь;
	КонецЕсли;
	
	Результат["ИспользуемаяСхемаКомпоновкиДанных"]	= ИспользуемаяСхемаКомпоновкиДанных;
	Результат["НовыйКомпоновщикНастроек"]			= НовыйКомпоновщикНастроек;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНастройкиСКД_ДополнительныеЛисты(ПараметрыОтчета)
	
	Результат = Новый Структура("
		|ИспользуемаяСхемаКомпоновкиДанных,
		|НовыйКомпоновщикНастроек");
	
	// Возвращаемые объекты:
	ИспользуемаяСхемаКомпоновкиДанных	= ПолучитьМакетСКДДопЛиста(ПараметрыОтчета);
	НовыйКомпоновщикНастроек			= Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ИспользуемаяСхемаКомпоновкиДанных));
	НовыйКомпоновщикНастроек.ЗагрузитьНастройки(ИспользуемаяСхемаКомпоновкиДанных.ВариантыНастроек["Основной"].Настройки);
	
	// Настраиваем схему.
	УстановитьПараметрыСКД_ДопЛист(НовыйКомпоновщикНастроек, ПараметрыОтчета);
	
	// Копируем отбор, установленный в форме отчета:
	СтандартныеОтчетыКлиентСервер.СкопироватьОтбор(
		НовыйКомпоновщикНастроек.Настройки.Отбор,
		ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	
	// Настройки группировок:
	Настройки = НовыйКомпоновщикНастроек.Настройки;
	ГруппировкаНалоговыйПериод				= Настройки.Структура[0];
	ГруппировкаНалоговыйПериодКонтрагент	= Настройки.Структура[1];
	
	Если ПараметрыОтчета["ГруппироватьПоКонтрагентам"] Тогда
		ГруппировкаНалоговыйПериод.Использование			= Ложь;
		ГруппировкаНалоговыйПериодКонтрагент.Использование	= Истина;
	Иначе
		ГруппировкаНалоговыйПериод.Использование			= Истина;
		ГруппировкаНалоговыйПериодКонтрагент.Использование	= Ложь;
	КонецЕсли;
	
	Результат["ИспользуемаяСхемаКомпоновкиДанных"]	= ИспользуемаяСхемаКомпоновкиДанных;
	Результат["НовыйКомпоновщикНастроек"]			= НовыйКомпоновщикНастроек;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНастройкиСКД_ИтогиКнигиПокупокЗаОтчетныйПериод(ПараметрыОтчета)
	
	Результат = Новый Структура("
		|ИспользуемаяСхемаКомпоновкиДанных,
		|НовыйКомпоновщикНастроек");
	
	// Возвращаемые объекты:
	ИспользуемаяСхемаКомпоновкиДанных	= ПолучитьМакет("ИтогиКнигиПокупокЗаОтчетныйПериод");
	НовыйКомпоновщикНастроек			= Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ИспользуемаяСхемаКомпоновкиДанных));
	НовыйКомпоновщикНастроек.ЗагрузитьНастройки(ИспользуемаяСхемаКомпоновкиДанных.ВариантыНастроек["Основной"].Настройки);
	
	// Копируем отбор, установленный в форме отчета:
	СтандартныеОтчетыКлиентСервер.СкопироватьОтбор(
		НовыйКомпоновщикНастроек.Настройки.Отбор,
		ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	
	Результат["ИспользуемаяСхемаКомпоновкиДанных"]	= ИспользуемаяСхемаКомпоновкиДанных;
	Результат["НовыйКомпоновщикНастроек"]			= НовыйКомпоновщикНастроек;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьПараметрыСКД_ОсновнойРаздел(КомпоновщикНастроек, ПараметрыОтчета)
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаНачала",	ПараметрыОтчета["НачалоПериода"]);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаКонца",		ПараметрыОтчета["КонецПериода"]);
	
	ПричиныНалогообложенияАванс = Новый СписокЗначений();
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученный);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаАванс);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПричиныНалогообложенияАванс",	ПричиныНалогообложенияАванс);
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаРУСвойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВалютаРУ, "Код,Наименование");
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРУ",						ВалютаРУ);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРУКод",					ВалютаРУСвойства.Код);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРУНаименование",			ВалютаРУСвойства.Наименование);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ИспользоватьВалютныйУчет",		ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВестиУчетПрослеживаемыхТоваров", ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров"));
	
	ПричиныНалогообложенияШкурыЛом = Новый СписокЗначений();
	ПричиныНалогообложенияШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом);
	ПричиныНалогообложенияШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом);
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПричиныНалогообложенияШкурыЛом",	ПричиныНалогообложенияШкурыЛом);
	
КонецПроцедуры

Процедура УстановитьПараметрыСКД_ДопЛист(КомпоновщикНастроек, ПараметрыОтчета)
	
	ВыбиратьДопЛистыИзменяющиеУказанныйПериод = ПараметрыОтчета["ДополнительныеЛистыЗаТекущийПериод"];
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыбиратьДопЛистыИзменяющиеУказанныйПериод",		ВыбиратьДопЛистыИзменяющиеУказанныйПериод);
	Если ВыбиратьДопЛистыИзменяющиеУказанныйПериод Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаНачалаКорректируемогоПериода",	ПараметрыОтчета["НачалоПериода"]);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаКонцаКорректируемогоПериода",	ПараметрыОтчета["КонецПериода"]);
		
		// Декларация
		Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
			// Доп.лист должен быть сформирован ранее даты формирования (подписи) декларации
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаКонца",	КонецДня(ПараметрыОтчета["ДатаПодписиДекларации"]));
		КонецЕсли;
		
	Иначе
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаНачала",	ПараметрыОтчета["НачалоПериода"]);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаКонца",		ПараметрыОтчета["КонецПериода"]);
	КонецЕсли;
	
	ПричиныНалогообложенияАванс = Новый СписокЗначений();
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученный);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаАванс);
ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПричиныНалогообложенияАванс",	ПричиныНалогообложенияАванс);
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаРУСвойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВалютаРУ, "Код,Наименование");
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРУ",						ВалютаРУ);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРУКод",					ВалютаРУСвойства.Код);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРУНаименование",			ВалютаРУСвойства.Наименование);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ИспользоватьВалютныйУчет",		ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВестиУчетПрослеживаемыхТоваров", ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров"));
	
	ПричиныНалогообложенияШкурыЛом = Новый СписокЗначений();
	ПричиныНалогообложенияШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом);
	ПричиныНалогообложенияШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом);
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПричиныНалогообложенияШкурыЛом",	ПричиныНалогообложенияШкурыЛом);
	
КонецПроцедуры

#КонецОбласти

#Область ВыводТаблицы

Процедура СформироватьОсновнойРаздел(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, ДанныеДляДекларации = Неопределено)
	
	РезультатДерево = Новый ДеревоЗначений();
	
	УчетНДС.ДобавитьКолонкуТаблицаПоказателиПрослеживаемости(РезультатДерево);
	
	ИспользуемаяКартинкаВДеревеЛистов	= БиблиотекаКартинок.ЖурналДокументов;
	
	УникальныйИдентификаторФормы		= ПараметрыОтчета["УникальныйИдентификаторФормы"];
	
    // Настраиваем схему КД:
	НастройкиСКД = ПолучитьНастройкиСКД_ОсновнойРаздел(ПараметрыОтчета);
	ИспользуемаяСхемаКомпоновкиДанных	= НастройкиСКД["ИспользуемаяСхемаКомпоновкиДанных"];
	НовыйКомпоновщикНастроек			= НастройкиСКД["НовыйКомпоновщикНастроек"];
	
	// Декларация
	// СегментацияДанныхДекларации
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		УчетНДС.СегментацияДанныхДекларации_ИнициализироватьПараметры(ПараметрыОтчета, "8");
	КонецЕсли;
	
	// Выполняем схему:
	Попытка
		// Выводим результат в дерево:
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(
			ИспользуемаяСхемаКомпоновкиДанных,				// 1
			НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
			,												// 3
			,												// 4
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"),	// 5
			Ложь);	// 6
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		ПроцессорВывода.УстановитьОбъект(РезультатДерево);
		
		УстановитьПривилегированныйРежим(Истина);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
		УстановитьПривилегированныйРежим(Ложь);
		
		ОсновнойРазделПустой = (РезультатДерево.Строки.Количество() = 1);
		
		ПараметрыОтчета.Вставить("ОсновнойРазделПустой", ОсновнойРазделПустой);
		
		Если ОсновнойРазделПустой Тогда
			Возврат;
		КонецЕсли;
		
		ВывестиДанныеОднимСписком = (РезультатДерево.Строки.Количество() >= 3) // количество периодов >=2 и +1 строка одним списком
			// Декларация
			И НЕ ПараметрыОтчета.ЗаполнитьДанныеДляДекларации;
			
		Для Каждого СтрокаГруппировки Из РезультатДерево.Строки Цикл
			Если СтрокаГруппировки["ЭтоГруппировкаНалоговыйПериод"] = Истина Тогда
				// Выводим в табличный документ:
				ТабДокумент = ВывестиОсновнойРаздел(ПараметрыОтчета, СтрокаГруппировки, ДанныеДляДекларации);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ТабДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				// Строка налогового периода:
				Наименование = ПредставлениеПериода(
					СтрокаГруппировки["ДатаНачалаПериода"],
					СтрокаГруппировки["ДатаОкончанияПериода"],
					"ФП");
				Поиск = Новый Структура("Наименование", Наименование);
				МассивСтрок = ДеревоСформированныхЛистов.Строки.НайтиСтроки(Поиск, Ложь); // ВключатьПодчиненные
				Если МассивСтрок.Количество() > 0 Тогда
					СтрокаНалоговогоПериода = МассивСтрок[0];
				Иначе
					СтрокаНалоговогоПериода = ДеревоСформированныхЛистов.Строки.Добавить();
					СтрокаНалоговогоПериода["Наименование"] = Наименование;
					СтрокаНалоговогоПериода["ПредставлениеНалоговогоПериода"] = Наименование;
				КонецЕсли;
				СтрокаНалоговогоПериода["ИндексСоответствующейСтрокиСписка"] = -1;
				СтрокаНалоговогоПериода["ДатаНачалаПериода"] = СтрокаГруппировки["ДатаНачалаПериода"];
				
				// Строка основного раздела:
				СтрокаОсновногоРаздела = СтрокаНалоговогоПериода.Строки.Добавить();
				СтрокаОсновногоРаздела["Наименование"] = НСтр("ru='Основной раздел'");
				СтрокаОсновногоРаздела["Картинка"] = ИспользуемаяКартинкаВДеревеЛистов;
				СтрокаОсновногоРаздела["ИндексСоответствующейСтрокиСписка"] = ИндексСоответствующейСтрокиСписка;
				СтрокаОсновногоРаздела["ПредставлениеНалоговогоПериода"] = Наименование + " (" + НРег(СтрокаОсновногоРаздела["Наименование"]) + ")";
				
				// Декларация
				// СегментацияДанныхДекларации
				Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
					// Сохраняем итоги всего раздела
					РегламентированнаяОтчетность.ЗаписатьИтогиРазделаДекларацииНДС(
						ПараметрыОтчета.СсылкаНаДекларацию,
						"Раздел8",
						ДанныеДляДекларации["ИтогиРаздел8"]);
				КонецЕсли;
				
			ИначеЕсли СтрокаГруппировки["ЭтоГруппировкаОднимСписком"] = Истина
				И ВывестиДанныеОднимСписком Тогда
				
				// Выводим в табличный документ:
				ТабДокумент = ВывестиВсеОсновныеРазделыОднимСписком(ПараметрыОтчета, СтрокаГруппировки);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ТабДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				// Строка самого верхнего уровня:
				СтрокаОднимСписком = ДеревоСформированныхЛистов.Строки.Добавить();
				СтрокаОднимСписком["Наименование"]						= НСтр("ru='Книга одним списком'");
				СтрокаОднимСписком["Картинка"]							= ИспользуемаяКартинкаВДеревеЛистов;
				СтрокаОднимСписком["ИндексСоответствующейСтрокиСписка"]	= ИндексСоответствующейСтрокиСписка;
				СтрокаОднимСписком["ДатаНачалаПериода"]					= '00010101';
				СтрокаОднимСписком["ЭтоДанныеОднимСписком"]				= Истина;
				Если СтрокаГруппировки.Строки.Количество() = 0 Тогда
					СтрокаОднимСписком["ЭтоПустойЛист"]					= Истина;
				КонецЕсли;
				СтрокаОднимСписком["ПредставлениеНалоговогоПериода"] = НСтр("ru='все основные разделы'");
				
			КонецЕсли;
		КонецЦикла;
		
	Исключение
		СообщитьОбОшибке(ИнформацияОбОшибке());
		
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
		
КонецПроцедуры

Процедура СформироватьДополнительныеЛисты(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, ДанныеДляДекларации = Неопределено)
	
	РезультатДерево = Новый ДеревоЗначений();
	
	УчетНДС.ДобавитьКолонкуТаблицаПоказателиПрослеживаемости(РезультатДерево);
	
	ИспользуемаяКартинкаВДеревеЛистов	= БиблиотекаКартинок.Документ;
	
	УникальныйИдентификаторФормы		= ПараметрыОтчета["УникальныйИдентификаторФормы"];
	
    // Настраиваем схему дополнительных листов:
	НастройкиСКД						= ПолучитьНастройкиСКД_ДополнительныеЛисты(ПараметрыОтчета);
	ИспользуемаяСхемаКомпоновкиДанных	= НастройкиСКД["ИспользуемаяСхемаКомпоновкиДанных"];
	НовыйКомпоновщикНастроек			= НастройкиСКД["НовыйКомпоновщикНастроек"];
	
    // Настраиваем схему строк Итого:
	НастройкиСКД_СтрокаИтого	= ПолучитьНастройкиСКД_ИтогиКнигиПокупокЗаОтчетныйПериод(ПараметрыОтчета);
	
	// Декларация
	// СегментацияДанныхДекларации
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		УчетНДС.СегментацияДанныхДекларации_ИнициализироватьПараметры(ПараметрыОтчета, "8.1");
	КонецЕсли;
	
	Попытка
		// Выводим результат в дерево:
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(
			ИспользуемаяСхемаКомпоновкиДанных,				// 1
			НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
			,												// 3
			,												// 4
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"),	// 5
			Ложь);	// 6
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		ПроцессорВывода.УстановитьОбъект(РезультатДерево);
		
		УстановитьПривилегированныйРежим(Истина);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
		УстановитьПривилегированныйРежим(Ложь);
		
		ОтсутствуютДопЛисты = (РезультатДерево.Строки.Количество() = 0);
		
		ПараметрыОтчета.Вставить("ОтсутствуютДопЛисты", ОтсутствуютДопЛисты);
		
		Если ОтсутствуютДопЛисты Тогда
			Возврат;
		КонецЕсли;
		
		// По группировкам "Налоговый период":
		Для Каждого СтрокаГруппировки Из РезультатДерево.Строки Цикл
			Если НЕ СтрокаГруппировки["ЭтоГруппировкаНалоговыйПериод"] = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			// Получим данные для строки Итого - итоги книги покупок за соответствующий налоговый период:
			СтрокаИтого = ПолучитьСтрокуИтогоИзКнигиПокупокЗаНалоговыйПериод(
				НастройкиСКД_СтрокаИтого,
				СтрокаГруппировки["ДатаНачалаПериода"],
				СтрокаГруппировки["ДатаОкончанияПериода"]);
				
			// По группировкам "Дата составления доп.листа":
			НомерЛиста = 0;
			Для Каждого СтрокаГруппировкиДатаСоставления Из СтрокаГруппировки.Строки Цикл
				Если НЕ СтрокаГруппировкиДатаСоставления["ЭтоГруппировкаДатаСоставления"] = Истина Тогда
					Продолжить;
				КонецЕсли;
				
				// Выводим в табличный документ:
				НомерЛиста = НомерЛиста + 1;
				ПараметрыДопЛиста = Новый Структура("
					|ДатаНачалаПериода,
					|ДатаОкончанияПериода,
					|ДатаСоставления,
					|СуммаНДС");
				ЗаполнитьЗначенияСвойств(ПараметрыДопЛиста, СтрокаГруппировкиДатаСоставления);
				ПараметрыДопЛиста.Вставить("НомерЛиста", НомерЛиста);
				ТабДокумент = ВывестиДопЛист(ПараметрыОтчета, ПараметрыДопЛиста, СтрокаГруппировкиДатаСоставления, СтрокаИтого, ДанныеДляДекларации);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ТабДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				// Строка налогового периода:
				Наименование = ПредставлениеПериода(
					СтрокаГруппировки["ДатаНачалаПериода"],
					СтрокаГруппировки["ДатаОкончанияПериода"],
					"ФП");
				Поиск = Новый Структура("Наименование", Наименование);
				МассивСтрок = ДеревоСформированныхЛистов.Строки.НайтиСтроки(Поиск, Ложь); // ВключатьПодчиненные
				Если МассивСтрок.Количество() > 0 Тогда
					СтрокаНалоговогоПериода = МассивСтрок[0];
				Иначе
					СтрокаНалоговогоПериода = ДеревоСформированныхЛистов.Строки.Добавить();
					СтрокаНалоговогоПериода["Наименование"] = Наименование;
					СтрокаНалоговогоПериода["ПредставлениеНалоговогоПериода"] = Наименование;
				КонецЕсли;
				СтрокаНалоговогоПериода["ИндексСоответствующейСтрокиСписка"] = -1;
				СтрокаНалоговогоПериода["ДатаНачалаПериода"] = СтрокаГруппировки["ДатаНачалаПериода"];
				// Строка доп.листа:
				СтрокаДопЛиста = СтрокаНалоговогоПериода.Строки.Добавить();
				Текст = НСтр("ru='Доп. лист %1'");
				СтрокаДопЛиста["Наименование"] = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					Текст, НомерЛиста);
				СтрокаДопЛиста["Картинка"] = ИспользуемаяКартинкаВДеревеЛистов;
				СтрокаДопЛиста["ИндексСоответствующейСтрокиСписка"] = ИндексСоответствующейСтрокиСписка;
				СтрокаДопЛиста["ПредставлениеНалоговогоПериода"] = Наименование + " (" + НРег(СтрокаДопЛиста["Наименование"]) + ")";
				
			КонецЦикла;
			
			// Декларация
			// СегментацияДанныхДекларации
			Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
				// Сохраняем итоги всего раздела
				РегламентированнаяОтчетность.ЗаписатьИтогиРазделаДекларацииНДС(
					ПараметрыОтчета.СсылкаНаДекларацию,
					"Раздел8_Прил1",
					ДанныеДляДекларации["ИтогиРаздел81"]);
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
		СообщитьОбОшибке(ИнформацияОбОшибке());
		
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры 

Процедура ДозаполнитьДеревоСформированныхЛистов(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, УникальныйИдентификаторФормы)
	
	УпорядочитьДеревоСформированныхЛистов(ДеревоСформированныхЛистов);
	
	// Собираем табличные документы всех листов из текущего налогового периода
	// в один новый большой документ:
	Для Каждого СтрокаВерхнегоУровня Из ДеревоСформированныхЛистов.Строки Цикл
		КолвоЛистов = СтрокаВерхнегоУровня.Строки.Количество();
		Если КолвоЛистов = 1 Тогда
			СтрокаВерхнегоУровня["ИндексСоответствующейСтрокиСписка"] = СтрокаВерхнегоУровня.Строки[0]["ИндексСоответствующейСтрокиСписка"];
			
		ИначеЕсли КолвоЛистов > 1 Тогда
			ОбщийТабличныйДокумент = Новый ТабличныйДокумент();
			ЭтоОчереднойЛист = Ложь;
			Для Каждого СтрокаЛиста Из СтрокаВерхнегоУровня.Строки Цикл
				ТабличныйДокументЛиста = СписокСформированныхЛистов.Получить(
					СтрокаЛиста["ИндексСоответствующейСтрокиСписка"]).Значение["ТабличныйДокумент"];
				Если ЭтоОчереднойЛист Тогда
					ОбщийТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				Иначе
					// Это первый лист.
					ЭтоОчереднойЛист = Истина;
					ЗаполнитьЗначенияСвойств(ОбщийТабличныйДокумент, ТабличныйДокументЛиста);
				КонецЕсли;
				ОбщийТабличныйДокумент.Вывести(ТабличныйДокументЛиста);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ОбщийТабличныйДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				СтрокаВерхнегоУровня["ИндексСоответствующейСтрокиСписка"] = ИндексСоответствующейСтрокиСписка;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Размещаем отдельно данные каждого листа в хранилище:
	Для Каждого СтрокаВерхнегоУровня Из ДеревоСформированныхЛистов.Строки Цикл
		СтрокаВерхнегоУровня["АдресХранилищаСДаннымиЛиста"] = ПоместитьВоВременноеХранилище(
			СписокСформированныхЛистов.Получить(СтрокаВерхнегоУровня["ИндексСоответствующейСтрокиСписка"]).Значение,
			УникальныйИдентификаторФормы);
			
		Для Каждого СтрокаЛиста Из СтрокаВерхнегоУровня.Строки Цикл
			СтрокаЛиста["АдресХранилищаСДаннымиЛиста"] = ПоместитьВоВременноеХранилище(
				СписокСформированныхЛистов.Получить(СтрокаЛиста["ИндексСоответствующейСтрокиСписка"]).Значение,
				УникальныйИдентификаторФормы);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура УпорядочитьДеревоСформированныхЛистов(ДеревоСформированныхЛистов)
	
	ВключатьПодчиненные = Ложь;
	
	// Упорядочиваем по возрастанию даты
	ДеревоСформированныхЛистов.Строки.Сортировать("ДатаНачалаПериода", ВключатьПодчиненные);
	
	// Передвигаем в начало лист с данными одним списком
	Поиск = Новый Структура();
	Поиск.Вставить("ЭтоДанныеОднимСписком", Истина);
	МассивСтрок = ДеревоСформированныхЛистов.Строки.НайтиСтроки(Поиск, ВключатьПодчиненные);
	Для Каждого СтрокаДерева Из МассивСтрок Цикл
		ИндексСтроки = ДеревоСформированныхЛистов.Строки.Индекс(СтрокаДерева);
		ДеревоСформированныхЛистов.Строки.Сдвинуть(ИндексСтроки, -ИндексСтроки);
	КонецЦикла;
	
КонецПроцедуры

Функция ВывестиПустойОсновнойРаздел(ПараметрыОтчета)
	
	ВременныеПараметрыОтчета = Новый Структура(Новый ФиксированнаяСтруктура(ПараметрыОтчета));
	ВременныеПараметрыОтчета.ЗаполнитьДанныеДляДекларации = Ложь;
	
	СтрокаГруппировки = Новый Структура();
	СтрокаГруппировки.Вставить("Строки",				Новый Массив());
	СтрокаГруппировки.Вставить("ДатаНачалаПериода",	ПараметрыОтчета.НачалоПериода);
	СтрокаГруппировки.Вставить("ДатаОкончанияПериода",	ПараметрыОтчета.КонецПериода);
	
	Возврат ВывестиОсновнойРаздел(ВременныеПараметрыОтчета, СтрокаГруппировки);
	
КонецФункции

Функция ВывестиПустойДопЛист(ПараметрыОтчета)
	
	ВременныеПараметрыОтчета = Новый Структура(Новый ФиксированнаяСтруктура(ПараметрыОтчета));
	ВременныеПараметрыОтчета.ЗаполнитьДанныеДляДекларации = Ложь;
	
	ПараметрыДопЛиста = Новый Структура();
	ПараметрыДопЛиста.Вставить("НомерЛиста",			0);
	ПараметрыДопЛиста.Вставить("ДатаНачалаПериода",		ПараметрыОтчета.НачалоПериода);
	ПараметрыДопЛиста.Вставить("ДатаОкончанияПериода",	ПараметрыОтчета.КонецПериода);
	ПараметрыДопЛиста.Вставить("ДатаСоставления",		"");
	
	СтрокаГруппировки = Новый Структура();
	СтрокаГруппировки.Вставить("Строки", Новый Массив());
	
	СтрокаИтого = Новый Структура();
	
	ВременнаяСтрокаГруппировки = Новый Структура();
	ВременнаяСтрокаГруппировки.Вставить("Строки",				Новый Массив());
	ВременнаяСтрокаГруппировки.Вставить("ДатаНачалаПериода",	ПараметрыОтчета.НачалоПериода);
	ВременнаяСтрокаГруппировки.Вставить("ДатаОкончанияПериода",	);
	
	Возврат ВывестиДопЛист(ВременныеПараметрыОтчета, ПараметрыДопЛиста, СтрокаГруппировки, СтрокаИтого);
	
КонецФункции

Процедура ДобавитьПустойЛист(ДеревоСформированныхЛистов, ТабДокумент, УникальныйИдентификаторФормы)
	
	СтрокаВерхнегоУровня = ДеревоСформированныхЛистов.Строки.Добавить();
	СтрокаВерхнегоУровня["Наименование"]	= НСтр("ru='поиск не дал результатов'");
	СтрокаВерхнегоУровня["Картинка"]		= БиблиотекаКартинок.Информация;
	СтрокаВерхнегоУровня["ЭтоПустойЛист"]	= Истина;
	СтрокаВерхнегоУровня["ПредставлениеНалоговогоПериода"]	= НСтр("ru='данные отсутствуют'");
	
	ДанныеЛиста = Новый Структура("ТабличныйДокумент", ТабДокумент);
	
	СтрокаВерхнегоУровня["АдресХранилищаСДаннымиЛиста"] = ПоместитьВоВременноеХранилище(
		ДанныеЛиста,
		УникальныйИдентификаторФормы);
		
КонецПроцедуры

Функция ПолучитьСтрокуИтогоИзКнигиПокупокЗаНалоговыйПериод(НастройкиСКД_СтрокаИтого, ДатаНачалаПериода, ДатаОкончанияПериода)
	
	РезультатТаблица = Новый ТаблицаЗначений();
	
	ИспользуемаяСхемаКомпоновкиДанных	= НастройкиСКД_СтрокаИтого["ИспользуемаяСхемаКомпоновкиДанных"];
	НовыйКомпоновщикНастроек			= НастройкиСКД_СтрокаИтого["НовыйКомпоновщикНастроек"];
	
	// Устанавливаем параметры:
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаНачалаНалоговогоПериода", ДатаНачалаПериода);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаОкончанияНалоговогоПериода", ДатаОкончанияПериода);
	
	// Выводим результат в таблицу значений:
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		ИспользуемаяСхемаКомпоновкиДанных,				// 1
		НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
		,												// 3
		,												// 4
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"),	// 5
		Ложь);	// 6
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
	ПроцессорВывода.УстановитьОбъект(РезультатТаблица);
	
	УстановитьПривилегированныйРежим(Истина);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РезультатТаблица[0];
	
КонецФункции

Функция ВывестиОсновнойРаздел(ПараметрыОтчета, ГруппировкаНалоговыйПериод, ДанныеДляДекларации = Неопределено)
	
	ДетальныеЗаписи = ГруппировкаНалоговыйПериод.Строки;
	
	// Возвращаемое значение:
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ОсновнойРазделКнигиПокупок";
	
	// Используемый макет:
	Макет = ПолучитьИспользуемыйМакет(ПараметрыОтчета);
	
	//---
	// Заголовок
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",			ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("ДатаНачалаПериода",		ГруппировкаНалоговыйПериод["ДатаНачалаПериода"]);
	ПараметрыОбласти.Вставить("ДатаОкончанияПериода",	ГруппировкаНалоговыйПериод["ДатаОкончанияПериода"]);
	ПараметрыОбласти.Вставить("ВыводитьОтбор",			ПараметрыОтчета["ВыводитьОтбор"]);
	ПараметрыОбласти.Вставить("Отбор",					Строка(ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор));
	ВывестиЗаголовок_ОсновнойРаздел(ТабДокумент, ПараметрыОбласти, Макет);	
	
	// Декларация
	// СегментацияДанныхДекларации
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		УчетНДС.СегментацияДанныхДекларации_НастроитьСтатистикуПередВыводомТаблицы(
			"8",
			ТабДокумент,
			ДетальныеЗаписи.Количество(),
			ПараметрыОтчета);
	КонецЕсли;
	
	//---
	// Шапка таблицы
	//---
	ВывестиШапкуТаблицы(ПараметрыОтчета, ТабДокумент, Макет, "ОсновнойРаздел");
	
	//---
	// Строки таблицы
	//---
	ВывестиТаблицу(ПараметрыОтчета, ТабДокумент, Макет, ДетальныеЗаписи, Истина, , ДанныеДляДекларации);
	
	//---
	// Всего
	//---
	ОбластьВсего = Макет.ПолучитьОбласть("Всего");
	ОбластьВсего.Параметры.Заполнить(ГруппировкаНалоговыйПериод);
	ТабДокумент.Вывести(ОбластьВсего);
	
	// Декларация
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		ДанныеДляДекларации["ИтогиРаздел8"]["СумНДСВсКПк"] = ГруппировкаНалоговыйПериод["СуммаНДС"];
		
		// СегментацияДанныхДекларации
		// Записываем текущий сегмент, обновляем статистику
		УчетНДС.СегментацияДанныхДекларации_ЗаписатьТекущийСегмент(
			"8",	// ОбозначениеРаздела
			ТабДокумент,
			ПолучитьИспользуемыйМакет(ПараметрыОтчета),
			ПараметрыОтчета,
			ДанныеДляДекларации,
			Истина);	// ЗакончиласьТаблица
	КонецЕсли;
	
	//---
	// Подвал
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",	ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("Дата",			ГруппировкаНалоговыйПериод["ДатаОкончанияПериода"]);
	ВывестиПодвал(ТабДокумент, ПараметрыОбласти, Макет);
	
	// Колонтитулы:
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(ТабДокумент,
		ПараметрыОтчета["Колонтитулы_НаименованиеОтчета"],
		ПараметрыОтчета["Колонтитулы_ТекущийПользователь"],
		ПараметрыОтчета["Организация"]);
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ВывестиДопЛист(ПараметрыОтчета, ПараметрыДопЛиста, СтрокаГруппировкиДатаСоставления, СтрокаИтого, ДанныеДляДекларации = Неопределено)
	
	ДетальныеЗаписи = СтрокаГруппировкиДатаСоставления.Строки;
	
	// Возвращаемое значение:
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ДополнительныйЛистКнигиПокупок";
	
	// Используемый макет:
	Макет = ПолучитьИспользуемыйМакет(ПараметрыОтчета);
	
	// Используемые области:
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("ЗаголовокДопЛист");
	ОбластьИтого		= Макет.ПолучитьОбласть("ИтогоДопЛист");
	ОбластьВсего		= Макет.ПолучитьОбласть("Всего");
	
	//---
	// Заголовок
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("НомерЛиста",				ПараметрыДопЛиста["НомерЛиста"]);
	ПараметрыОбласти.Вставить("Организация",			ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("ДатаНачалаПериода",		ПараметрыДопЛиста["ДатаНачалаПериода"]);
	ПараметрыОбласти.Вставить("ДатаОкончанияПериода",	ПараметрыДопЛиста["ДатаОкончанияПериода"]);
	ПараметрыОбласти.Вставить("ДатаСоставления",		ПараметрыДопЛиста["ДатаСоставления"]);
	ПараметрыОбласти.Вставить("ВыводитьОтбор",			ПараметрыОтчета["ВыводитьОтбор"]);
	ПараметрыОбласти.Вставить("Отбор",					ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	ВывестиЗаголовок_ДопЛист(ТабДокумент, ПараметрыОбласти, Макет);	
	
	//---
	// Шапка таблицы
	//---
	ВывестиШапкуТаблицы(ПараметрыОтчета, ТабДокумент, Макет, "ДопЛист");
	
	//---
	// Строка Итого
	//---
	ОбластьИтого.Параметры.Заполнить(СтрокаИтого);
	ТабДокумент.Вывести(ОбластьИтого);
	
	// Декларация
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		ЭтоПервыйДопЛист = Не ЕстьЗаполненныйЭлементСтруктуры(ДанныеДляДекларации["ИтогиРаздел81"]);
		Если ЭтоПервыйДопЛист Тогда
			ИтогиРаздел81 = ДанныеДляДекларации["ИтогиРаздел81"];
			// Строка Итого
			ИтогиРаздел81["СумНДСИтКПк"]	= СтрокаИтого["СуммаНДС"];
			// Строка Всего
			ИтогиРаздел81["СумНДСИтП1Р8"]	= ИтогиРаздел81["СумНДСИтКПк"];
		КонецЕсли;
		
		// СегментацияДанныхДекларации
		УчетНДС.СегментацияДанныхДекларации_НастроитьСтатистикуПередВыводомТаблицы(
			"8.1",
			ТабДокумент,
			ДетальныеЗаписи.Количество(),
			ПараметрыОтчета);
	КонецЕсли;
	
	//---
	// Строки таблицы
	//---
	ВывестиТаблицу(ПараметрыОтчета, ТабДокумент, Макет, ДетальныеЗаписи, Ложь, , ДанныеДляДекларации);
	
	//---
	// Всего
	//---
	Для Каждого Элем Из ПараметрыДопЛиста Цикл
		Попытка
			СтрокаИтого[Элем.Ключ] = СтрокаИтого[Элем.Ключ] + Элем.Значение;
		Исключение
		КонецПопытки;
	КонецЦикла;
	ОбластьВсего.Параметры.Заполнить(СтрокаИтого);
	ТабДокумент.Вывести(ОбластьВсего);
	
	// Декларация
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		ИтогиРаздел81 = ДанныеДляДекларации["ИтогиРаздел81"];
		// Строка Всего
		ИтогиРаздел81["СумНДСИтП1Р8"]	= ИтогиРаздел81["СумНДСИтП1Р8"]	+ ПараметрыДопЛиста["СуммаНДС"];
		
		// СегментацияДанныхДекларации
		// Записываем текущий сегмент, обновляем статистику
		УчетНДС.СегментацияДанныхДекларации_ЗаписатьТекущийСегмент(
			"8.1",	// ОбозначениеРаздела
			ТабДокумент,
			ПолучитьИспользуемыйМакет(ПараметрыОтчета),
			ПараметрыОтчета,
			ДанныеДляДекларации,
			Истина);	// ЗакончиласьТаблица
	КонецЕсли;
	
	//---
	// Подвал
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",	ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("Дата",			ПараметрыДопЛиста["ДатаОкончанияПериода"]);
	ВывестиПодвал(ТабДокумент, ПараметрыОбласти, Макет);
	
	// Колонтитулы:
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(ТабДокумент,
		ПараметрыОтчета["Колонтитулы_НаименованиеОтчета"],
		ПараметрыОтчета["Колонтитулы_ТекущийПользователь"],
		ПараметрыОтчета["Организация"]);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиЗаголовок_ОсновнойРаздел(ЗаполняемыйТабличныйДокумент, ПараметрыОбласти, ИспользуемыйМакет)
	
	ОбластьЗаголовок = ИспользуемыйМакет.ПолучитьОбласть("Заголовок");
	
	ЗначенияПараметров = Новый Структура();
	Если ЗначениеЗаполнено(ПараметрыОбласти["Организация"]) тогда
		РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОбласти["Организация"],
			"НаименованиеПолное, НаименованиеСокращенное, Наименование, ИНН, КПП");
		НаименованиеПолное		= РеквизитыОрганизации["НаименованиеПолное"];
		НаименованиеСокращенное	= РеквизитыОрганизации["НаименованиеСокращенное"];
		Наименование			= РеквизитыОрганизации["Наименование"];
		Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
			Параметр_Покупатель = НаименованиеПолное;
		ИначеЕсли ЗначениеЗаполнено(НаименованиеСокращенное) Тогда
			Параметр_Покупатель = НаименованиеСокращенное;
		Иначе
			Параметр_Покупатель = Наименование;
		КонецЕсли;
		ЗначенияПараметров.Вставить("Покупатель",		Параметр_Покупатель);
		ЗначенияПараметров.Вставить("ИННПокупателя",	РеквизитыОрганизации["ИНН"]);
		ЗначенияПараметров.Вставить("КПППокупателя",	РеквизитыОрганизации["КПП"]);
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("НачалоПериода",	Формат(ПараметрыОбласти["ДатаНачалаПериода"], "ДФ=dd.MM.yyyy"));
	ЗначенияПараметров.Вставить("КонецПериода",		Формат(ПараметрыОбласти["ДатаОкончанияПериода"], "ДФ=dd.MM.yyyy"));
	
	// Отбор:
	Если ПараметрыОбласти["ВыводитьОтбор"] Тогда
		Отбор = ПараметрыОбласти["Отбор"];
		Если ПустаяСтрока(Отбор) Тогда
			Отбор = НСтр("ru='(отбор не установлен)'");
		КонецЕсли;
		ЗначенияПараметров.Вставить("Отбор", Отбор); 
	КонецЕсли;
	// Выводим область:
	ОбластьЗаголовок.Параметры.Заполнить(ЗначенияПараметров);
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
КонецПроцедуры

Процедура ВывестиЗаголовок_ДопЛист(ЗаполняемыйТабличныйДокумент, ПараметрыОбласти, ИспользуемыйМакет)
	
	ОбластьЗаголовок = ИспользуемыйМакет.ПолучитьОбласть("ЗаголовокДопЛист");
	
	ЗначенияПараметров = Новый Структура();
	
	ЗначенияПараметров.Вставить("НомерЛиста",		ПараметрыОбласти["НомерЛиста"]);
	
	Если ЗначениеЗаполнено(ПараметрыОбласти["Организация"]) тогда
		РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОбласти["Организация"],
			"НаименованиеПолное, НаименованиеСокращенное, Наименование, ИНН, КПП");
		НаименованиеПолное		= РеквизитыОрганизации["НаименованиеПолное"];
		НаименованиеСокращенное	= РеквизитыОрганизации["НаименованиеСокращенное"];
		Наименование			= РеквизитыОрганизации["Наименование"];
		Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
			Параметр_Покупатель = НаименованиеПолное;
		ИначеЕсли ЗначениеЗаполнено(НаименованиеСокращенное) Тогда
			Параметр_Покупатель = НаименованиеСокращенное;
		Иначе
			Параметр_Покупатель = Наименование;
		КонецЕсли;
		ЗначенияПараметров.Вставить("Покупатель",		Параметр_Покупатель);
		ЗначенияПараметров.Вставить("ИННПокупателя",	РеквизитыОрганизации["ИНН"]);
		ЗначенияПараметров.Вставить("КПППокупателя",	РеквизитыОрганизации["КПП"]);
	КонецЕсли;
	ЗначенияПараметров.Вставить("НалоговыйПериод",	ПредставлениеПериода(ПараметрыОбласти["ДатаНачалаПериода"], ПараметрыОбласти["ДатаОкончанияПериода"], "ФП"));
	ЗначенияПараметров.Вставить("ДатаСоставления",	Формат(ПараметрыОбласти["ДатаСоставления"], "ДФ=dd.MM.yyyy"));
	
	// Отбор:
	Если ПараметрыОбласти["ВыводитьОтбор"] Тогда
		Отбор = ПараметрыОбласти["Отбор"];
		Если ПустаяСтрока(Отбор) Тогда
			Отбор = НСтр("ru='(отбор не установлен)'");
		КонецЕсли;
		ЗначенияПараметров.Вставить("Отбор", Отбор); 
	КонецЕсли;
	// Выводим область:
	ОбластьЗаголовок.Параметры.Заполнить(ЗначенияПараметров);
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
КонецПроцедуры

Процедура ВывестиШапкуТаблицы(ПараметрыОтчета, ТабДокумент, Макет, ВыводимаяТаблица)
	
	Если ВыводимаяТаблица = "ДопЛист" Тогда
		
		ОбластьШапкаПолная = Макет.ПолучитьОбласть("ШапкаПолнаяДопЛист");
		
		ОбластьШапкаСокращенная = Макет.ПолучитьОбласть("ШапкаСокращеннаяДопЛист");
		
	Иначе
		
		ОбластьШапкаПолная = Макет.ПолучитьОбласть("ШапкаПолная");
		
		ОбластьШапкаСокращенная = Макет.ПолучитьОбласть("ШапкаСокращенная");
		
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьШапкаПолная);
	
	// Декларация
	Если НЕ ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		
		ПовторятьПолнуюШапку = ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет, "ПовторятьПолнуюШапку");
		
		ПовторятьСокращеннуюШапку = ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет, "ПовторятьСокращеннуюШапку");
		
		КоличествоСтрокПовтора = 0;
		
		Если ПовторятьПолнуюШапку Тогда
			
			КоличествоСтрокПовтора = ОбластьШапкаПолная.ВысотаТаблицы;
			
		ИначеЕсли ПовторятьСокращеннуюШапку Тогда
			
			КоличествоСтрокПовтора = ОбластьШапкаСокращенная.ВысотаТаблицы;
			
		КонецЕсли;
		
		Если КоличествоСтрокПовтора > 0 Тогда
			
			НомерНачальнойСтроки = ТабДокумент.ВысотаТаблицы - КоличествоСтрокПовтора + 1;
			
			ОбластьПовтора = ТабДокумент.Область(
				НомерНачальнойСтроки,
				,
				НомерНачальнойСтроки + КоличествоСтрокПовтора - 1);
				
			ТабДокумент.ПовторятьПриПечатиСтроки = ОбластьПовтора;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиТаблицу(ПараметрыОтчета, ЗаполняемыйТабличныйДокумент, ИспользуемыйМакет, ДетальныеЗаписи, ЭтоОсновнойРаздел, НППСтроки = Неопределено, ДанныеДляДекларации = Неопределено)
	
	// Декларация
	// СегментацияДанныхДекларации
	Перем	ОбозначениеРазделаКнига,
			СегментацияДанныхРазделаКнига,
			ТаблицаДанныхКнига;
			
	Перем	ВремТабДок,
			ОчищающаяСтруктураПоказателиПрослеживаемости;
	
	ВремТабДок = Новый ТабличныйДокумент();
	
	ОчищающаяСтруктураПоказателиПрослеживаемости = Новый Структура("
		|РНПТ,
		|КоличествоПрослеживаемости,
		|СтоимостьПрослеживаемости,
		|ЕдиницаИзмеренияПрослежКод");

	СимволПрочерка = "---";
	
	ПричиныНалогообложенияАванс = Новый Массив();
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученный);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаАванс);
	ПокупкаУНерезидентаНалоговыйАгент = Перечисления.ПричиныНалогообложенияНДС.ПокупкаУНерезидентаНалоговыйАгент;
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера);
	
	ПричиныНалогообложенияЗакупкаПоКомиссии = Новый Массив ();
	ПричиныНалогообложенияЗакупкаПоКомиссии.Добавить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаПокупкуОтКомиссионера);
	ПричиныНалогообложенияЗакупкаПоКомиссии.Добавить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера);
	
	ВалютаРУ				= Константы.ВалютаРегламентированногоУчета.Получить();
	СвойстваВалютыРУ		= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВалютаРУ, "Код,Наименование");
	ВалютаРУКод				= СвойстваВалютыРУ["Код"];
	ВалютаРУНаименование	= СвойстваВалютыРУ["Наименование"];
	
	Если НППСтроки = Неопределено Тогда
		НППСтроки = 0;
	КонецЕсли;
	
	ПараметрыДобавленияСтроки = НовыйПараметрыДобавленияСтрокиВРазделДекларацииПоНДС();
	ПараметрыДобавленияСтроки.СимволПрочерка = СимволПрочерка;
	
	// Декларация
	// СегментацияДанныхДекларации
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		// Разделы 8, 8.1
		ОбозначениеРазделаКнига = ?(ЭтоОсновнойРаздел,
			"8",	// Основной раздел
			"8.1");	// Дополнительный лист
		ОписаниеРаздела					= УчетНДС.СегментацияДанныхДекларации_ПолучитьОписаниеРаздела(ОбозначениеРазделаКнига);
		ИмяРаздела						= ОписаниеРаздела["ИмяВРегламентированнойОтчетности"];
		СегментацияДанныхРазделаКнига	= ПараметрыОтчета["СегментацияДанныхДекларации"][ИмяРаздела];
		ИмяТаблицыДанных				= ОписаниеРаздела["ИмяТаблицыДанных"];
		ТаблицаДанныхКнига				= ДанныеДляДекларации[ИмяТаблицыДанных];
	КонецЕсли;
	
	Для Каждого ДетальнаяЗапись Из ДетальныеЗаписи Цикл
		Если ДетальнаяЗапись["ЭтоГруппировкаКонтрагент"] Тогда
			//---
			// Итого по контрагенту
			//---
			ОбластьКонтрагент = ИспользуемыйМакет.ПолучитьОбласть("Контрагент");
			ЗначенияПараметров = Новый Структура("КонтрагентПредставление", ДетальнаяЗапись["КонтрагентПредставление"]);
			ОбластьКонтрагент.Параметры.Заполнить(ДетальнаяЗапись);
			ОбластьКонтрагент.Параметры.Заполнить(ЗначенияПараметров);
			ЗаполняемыйТабличныйДокумент.Вывести(ОбластьКонтрагент);
			
			//---
			// Детальные строки
			//---
			ВывестиТаблицу(ПараметрыОтчета, ЗаполняемыйТабличныйДокумент, ИспользуемыйМакет, ДетальнаяЗапись.Строки, ЭтоОсновнойРаздел, НППСтроки, ДанныеДляДекларации);
			
		Иначе
			//---
			// Детальная строка
			//---
			НППСтроки = НППСтроки + 1;
			ОбластьСтрока = ИспользуемыйМакет.ПолучитьОбласть("Строка");
			
			// Подготовка:
			ЭтоНалоговыйАгентП2 = (ДетальнаяЗапись["ПричинаНалогообложения"] = ПокупкаУНерезидентаНалоговыйАгент);
			ЭтоАванс = НЕ (ПричиныНалогообложенияАванс.Найти(ДетальнаяЗапись["ПричинаНалогообложения"]) = Неопределено);
			
			ЭтоЗакупкаПоКомиссии = НЕ (ПричиныНалогообложенияЗакупкаПоКомиссии.Найти(ДетальнаяЗапись["ПричинаНалогообложения"]) = Неопределено);
			
			Продавец = УчетНДС.ОпределитьПродавца(ДетальнаяЗапись)["Продавец"];
			
			Параметр_ПродавецПредставление = Продавец["Наименование"];
			
			Если ЭтоНалоговыйАгентП2 Тогда
				Параметр_ПродавецИНН = СимволПрочерка;
				Параметр_ПродавецКПП = СимволПрочерка;
			ИначеЕсли ЭтоЗакупкаПоКомиссии Тогда
				Параметр_ПродавецПредставление = ДетальнаяЗапись["ПродавецКомиссионера"];
				Параметр_ПродавецИНН 		   = ДетальнаяЗапись["ПродавецКомиссионераИНН"];
				Параметр_ПродавецКПП 		   = ДетальнаяЗапись["ПродавецКомиссионераКПП"];
			Иначе
				Параметр_ПродавецИНН = Продавец["ИНН"];
				Параметр_ПродавецКПП = Продавец["КПП"];
			КонецЕсли;
			
			СтруктураНомерСФ = УчетНДС.ОпределитьНомерСФДляВыводаВРегистрыУчета(ДетальнаяЗапись);
			
			Параметр_ПродавецСсылка = Продавец["Ссылка"];
			
			ЗначенияПараметров = Новый Структура();
			
			// 1
			ЗначенияПараметров.Вставить("НПП",					НППСтроки);
			
			// 3
			Параметр_ДатаНомер = УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
				СтруктураНомерСФ["Номер"], ДетальнаяЗапись["Дата"]);
			ПредставлениеПричиныНалогообложения = ПараметрыОтчета["ПредставленияПричинНалогообложения"].Получить(ДетальнаяЗапись["ПричинаНалогообложения"]);
			Если ЗначениеЗаполнено(ПредставлениеПричиныНалогообложения) Тогда
				Параметр_ДатаНомер = Параметр_ДатаНомер + " " + ПредставлениеПричиныНалогообложения;
			КонецЕсли;
			ЗначенияПараметров.Вставить("ДатаНомер",			Параметр_ДатаНомер);
			
			// 4
			ЗначенияПараметров.Вставить("НомерДатаИсправления",
				УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
					ДетальнаяЗапись["НомерИсправления"], ДетальнаяЗапись["ДатаИсправления"]));
			
			// 5
			ЗначенияПараметров.Вставить("НомерДатаКСФ",
				УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
					СтруктураНомерСФ["НомерКСФ"], ДетальнаяЗапись["ДатаКСФ"]));
			
			// 6
			ЗначенияПараметров.Вставить("НомерДатаИсправленияКСФ",
				УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
					ДетальнаяЗапись["НомерИсправленияКСФ"], ДетальнаяЗапись["ДатаИсправленияКСФ"]));
			
			// 7
			ЗначенияПараметров.Вставить("НомерДатаДокументаУплатыНалога", СформироватьСодержимоеГрафы7(ДетальнаяЗапись, "Текст"));
			
			// 7а
			Если ПараметрыОтчета.ПостановлениемПредусмотренПоказательСчетаФактурыНаОтгрузку Тогда
				ЗаполнитьПараметрыГрафы7а(ЗначенияПараметров, ДетальнаяЗапись);
			КонецЕсли;
			
			// 8
			Если ЭтоАванс Тогда
				Параметр_ДатаОприходования = '00010101';
			Иначе
				Параметр_ДатаОприходования = ДетальнаяЗапись["ДатаСобытия"];
				Если НЕ ЗначениеЗаполнено(Параметр_ДатаОприходования) Тогда
					Параметр_ДатаОприходования = '00010101';
				КонецЕсли;
			КонецЕсли;
			ЗначенияПараметров.Вставить("ДатаОприходования",	Параметр_ДатаОприходования);
			
			// 9
			ЗначенияПараметров.Вставить("ПродавецПредставление",Параметр_ПродавецПредставление);
			ЗначенияПараметров.Вставить("ПродавецСсылка",		Параметр_ПродавецСсылка);
			// 10
			Если ЗначениеЗаполнено(Параметр_ПродавецИНН) ИЛИ ЗначениеЗаполнено(Параметр_ПродавецКПП) Тогда
				Параметр_ПродавецИННКПП = Строка(Параметр_ПродавецИНН) + " / " + Строка(Параметр_ПродавецКПП);
			Иначе
				Параметр_ПродавецИННКПП = "";
			КонецЕсли;
			ЗначенияПараметров.Вставить("ПродавецИННКПП",		Параметр_ПродавецИННКПП);
			
			Если ЭтоЗакупкаПоКомиссии Тогда
				Параметр_ПосредникНаименование = Продавец["Наименование"];
				ЗначенияПараметров.Вставить("ПосредникНаименование",		Параметр_ПосредникНаименование);
				Если ЗначениеЗаполнено(Продавец["ИНН"]) ИЛИ ЗначениеЗаполнено(Продавец["КПП"]) Тогда
					Параметр_ПосредникИННКПП = Строка(Продавец["ИНН"]) + " / " + Строка(Продавец["КПП"]);
				Иначе
					Параметр_ПосредникИННКПП = "";
				КонецЕсли;
				ЗначенияПараметров.Вставить("ПосредникИННКПП",		Параметр_ПосредникИННКПП);
			КонецЕсли;
			
			// 14
			Параметр_ВалютаПредставление = ?(ДетальнаяЗапись["УказанаИностраннаяВалюта"],
				ДетальнаяЗапись["ВалютаНаименование"] + ", " + ДетальнаяЗапись["ВалютаКод"],
				"");
			ЗначенияПараметров.Вставить("ВалютаПредставление",	Параметр_ВалютаПредставление);
			
			Если ДетальнаяЗапись["ЭтоШкурыЛом"] Тогда
				ЗначенияПараметров.Вставить("СуммаНДС", СимволПрочерка);
			КонецЕсли;
			
			// Выводим область
			ОбластьСтрока.Параметры.Заполнить(ДетальнаяЗапись);
			ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
			
			Если ПараметрыОтчета.ПостановлениемПредусмотреныПоказателиПрослеживаемости
				И ДетальнаяЗапись["ТаблицаПоказателиПрослеживаемости"] <> Null Тогда
				
				Для Каждого СтрокаТаблицы Из ДетальнаяЗапись["ТаблицаПоказателиПрослеживаемости"] Цикл
					СтрокаТаблицы.РНПТ = СокрЛП(СтрокаТаблицы.РНПТ);
					ОбластьСтрока.Параметры.Заполнить(СтрокаТаблицы);
					
					ВремТабДок.Вывести(ОбластьСтрока);
					
					ОбластьСтрока.Параметры.Заполнить(ОчищающаяСтруктураПоказателиПрослеживаемости);
				КонецЦикла;
				
				УчетНДС.ОбъединитьЯчейкиПоВысоте(ВремТабДок, 1, 15);
				
				ЗаполняемыйТабличныйДокумент.Вывести(ВремТабДок);
				
				ВремТабДок.Очистить();
			Иначе
				ЗаполняемыйТабличныйДокумент.Вывести(ОбластьСтрока);
			КонецЕсли;
			
			//---
			// Декларация
			//---
			Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
				ПараметрыДобавленияСтроки.СтруктураНомерСФ					= СтруктураНомерСФ;
				ПараметрыДобавленияСтроки.Параметр_ПродавецИНН				= Параметр_ПродавецИНН;
				ПараметрыДобавленияСтроки.Параметр_ПродавецКПП				= Параметр_ПродавецКПП;
				ПараметрыДобавленияСтроки.Параметр_ПродавецСсылка			= Параметр_ПродавецСсылка;
				ПараметрыДобавленияСтроки.Параметр_ПродавецПредставление	= Параметр_ПродавецПредставление;
				ПараметрыДобавленияСтроки.Параметр_ДатаОприходования		= Параметр_ДатаОприходования;
				ПараметрыДобавленияСтроки.ЭтоОсновнойРаздел					= ЭтоОсновнойРаздел;
				
				ДобавитьСтрокуВРаздел8ДекларацииПоНДС(ТаблицаДанныхКнига, ДетальнаяЗапись, НППСтроки, ПараметрыДобавленияСтроки, ПараметрыОтчета);
				
				// СегментацияДанныхДекларации
				УчетНДС.СегментацияДанныхДекларации_НастроитьСтатистикуПослеДобавленияСтрокиТаблицы(СегментацияДанныхРазделаКнига, ПараметрыОтчета);
				
				Если УчетНДС.СегментацияДанныхДекларации_СегментДостигПредельногоРазмера(СегментацияДанныхРазделаКнига, ПараметрыОтчета) Тогда
					Если УчетНДС.СегментацияДанныхДекларации_ЭтоПоследняяСтрокаТаблицы(СегментацияДанныхРазделаКнига, ПараметрыОтчета) Тогда
						// Не отрываем Итоги от всей таблицы.
						// Текущий сегмент запишем позже, после добавления Итогов.
					Иначе
						// Записываем текущий сегмент, обновляем статистику
						УчетНДС.СегментацияДанныхДекларации_ЗаписатьТекущийСегмент(
							ОбозначениеРазделаКнига,
							ЗаполняемыйТабличныйДокумент,
							ИспользуемыйМакет,
							ПараметрыОтчета,
							ДанныеДляДекларации,
							Ложь);		// ЗакончиласьТаблица
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыГрафы7а(ЗначенияПараметров, ДетальнаяЗапись)
	
	ТаблицаСчетаФактурыНаОтгрузку = ДетальнаяЗапись.ТаблицаСчетаФактурыНаОтгрузку;
	
	Если ТаблицаСчетаФактурыНаОтгрузку = Null Тогда
		ТекстГрафы7а = "";
	Иначе
		ТекстГрафы7а = УчетНДС.ПолучитьНадписьСчетаФактурыНаОтгрузку(ТаблицаСчетаФактурыНаОтгрузку, 1000);
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("СчетФактураНаОтгрузку", ТекстГрафы7а);
	
КонецПроцедуры

Процедура ВывестиПодвал(ЗаполняемыйТабличныйДокумент, ПараметрыОбласти, ИспользуемыйМакет)
	
	ОбластьПодвал = ИспользуемыйМакет.ПолучитьОбласть("Подвал");
	
	ЗначенияПараметров = Новый Структура();
	Если ЗначениеЗаполнено(ПараметрыОбласти["Организация"]) Тогда
		ОтветственныеЛица = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
			ПараметрыОбласти["Организация"],
			ПараметрыОбласти["Дата"]);
		
		ЗначенияПараметров.Вставить("РуководительФИО", Справочники.Сотрудники.ФамилияИО(
			ОтветственныеЛица["ОтветственноеЛицоСсылка"],, ПараметрыОбласти["Дата"]));
    КонецЕсли;
	// Выводим область:
	ОбластьПодвал.Параметры.Заполнить(ЗначенияПараметров);
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры

Функция ВывестиВсеОсновныеРазделыОднимСписком(ПараметрыОтчета, ГруппировкаОднимСписком)
	
	ДетальныеЗаписи = ГруппировкаОднимСписком.Строки;
	
	// Возвращаемое значение:
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ОсновнойРазделКнигиПокупок";
	
	// Используемый макет:
	Макет = ПолучитьИспользуемыйМакет(ПараметрыОтчета);
	
	//---
	// Заголовок
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",			ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("ДатаНачалаПериода",		ПараметрыОтчета["НачалоПериода"]);
	ПараметрыОбласти.Вставить("ДатаОкончанияПериода",	ПараметрыОтчета["КонецПериода"]);
	ПараметрыОбласти.Вставить("ВыводитьОтбор",			ПараметрыОтчета["ВыводитьОтбор"]);
	ПараметрыОбласти.Вставить("Отбор",					Строка(ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор));
	ВывестиЗаголовок_ОсновнойРаздел(ТабДокумент, ПараметрыОбласти, Макет);
	
	//---
	// Шапка таблицы
	//---
	ВывестиШапкуТаблицы(ПараметрыОтчета, ТабДокумент, Макет, "ОсновнойРаздел");
	
	//---
	// Строки таблицы
	//---
	ВывестиТаблицу(ПараметрыОтчета, ТабДокумент, Макет, ДетальныеЗаписи, Истина);
	
	//---
	// Всего
	//---
	ОбластьВсего = Макет.ПолучитьОбласть("Всего");
	ОбластьВсего.Параметры.Заполнить(ГруппировкаОднимСписком);
	ТабДокумент.Вывести(ОбластьВсего);
	
	//---
	// Подвал
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",	ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("Дата",			ПараметрыОтчета["КонецПериода"]);
	ВывестиПодвал(ТабДокумент, ПараметрыОбласти, Макет);
	
	// Колонтитулы:
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(ТабДокумент,
		ПараметрыОтчета["Колонтитулы_НаименованиеОтчета"],
		ПараметрыОтчета["Колонтитулы_ТекущийПользователь"],
		ПараметрыОтчета["Организация"]);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура СообщитьОбОшибке(ИнформацияОбОшибке)
	
	Пока НЕ ИнформацияОбОшибке.Причина = Неопределено Цикл
		ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
	КонецЦикла;
	ТекстСообщения = НСтр("ru='Отчет не сформирован!'") + Символы.ПС + ИнформацияОбОшибке.Описание;
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

Функция СформироватьСодержимоеГрафы7(ДетальнаяЗапись, ЧтоПолучить)
	
	НеобходимоПолучитьТекст = (ЧтоПолучить = "Текст");
	
	Результат = ?(НеобходимоПолучитьТекст, "", Новый Массив());
	
	ПримененаУстаревшаяСхемаУказанияРеквизитов = (ЗначениеЗаполнено(ДетальнаяЗапись["НомерДокументаОплаты"])
		ИЛИ ЗначениеЗаполнено(ДетальнаяЗапись["ДатаДокументаОплаты"]));
		
	Если ПримененаУстаревшаяСхемаУказанияРеквизитов Тогда
		
		ВремСтруктура = Новый Структура();
		ВремСтруктура.Вставить("ДатаДокумента", ДетальнаяЗапись["ДатаДокументаОплаты"]);
		ВремСтруктура.Вставить("НомерДокумента", ДетальнаяЗапись["НомерДокументаОплаты"]);
		
		ТаблицаПлатежноРасчетныеДокументы = Новый Массив();
		ТаблицаПлатежноРасчетныеДокументы.Добавить(ВремСтруктура);
		
	Иначе
		
		ТаблицаПлатежноРасчетныеДокументы = ДетальнаяЗапись["ТаблицаПлатежноРасчетныеДокументы"];
		
		Если ТаблицаПлатежноРасчетныеДокументы = Null Тогда
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаПлатежноРасчетныеДокументы Цикл
		
		Если НеобходимоПолучитьТекст Тогда
			// Необходимо получить текст для вывода в ячейку табличного документа
			
			ПредставлениеДокумента = УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
				СтрокаТаблицы["НомерДокумента"],
				СтрокаТаблицы["ДатаДокумента"]);
			
			Результат = Результат +	?(Результат = "", "", ";") + ПредставлениеДокумента;
			
		Иначе
			// Необходимо получить массив сведений для декларации
			
			ВремСтруктура = Новый Структура();
			ВремСтруктура.Вставить("НомДокПдтвУпл", СтрокаТаблицы["НомерДокумента"]);
			ВремСтруктура.Вставить("ДатаДокПдтвУпл", Формат(СтрокаТаблицы["ДатаДокумента"], "ДФ=dd.MM.yyyy"));
			
			Результат.Добавить(ВремСтруктура);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Декларация

Процедура ИнициализироватьТаблицыДляДекларацииПоНДС(СтруктураПараметров, ПараметрыОтчета)
	
	ПравилаЗаполнения = ПараметрыОтчета.ПравилаЗаполнения;
	
	Раздел8 = Новый ТаблицаЗначений;
	
	Раздел8.Колонки.Добавить("НомерПор", ОбщегоНазначения.ОписаниеТипаЧисло(12, 0));
	
	Раздел8.Колонки.Добавить("НомСчФПрод", ОбщегоНазначения.ОписаниеТипаСтрока(0));
	Раздел8.Колонки.Добавить("ДатаСчФПрод", ОбщегоНазначения.ОписаниеТипаСтрока(10));
		
	Раздел8.Колонки.Добавить("НомИспрСчФ", ОбщегоНазначения.ОписаниеТипаЧисло(3, 0));
	Раздел8.Колонки.Добавить("ДатаИспрСчФ", ОбщегоНазначения.ОписаниеТипаСтрока(10));
	
	Раздел8.Колонки.Добавить("НомКСчФПрод", ОбщегоНазначения.ОписаниеТипаСтрока(0));
	Раздел8.Колонки.Добавить("ДатаКСчФПрод", ОбщегоНазначения.ОписаниеТипаСтрока(10));
	
	Раздел8.Колонки.Добавить("НомИспрКСчФ", ОбщегоНазначения.ОписаниеТипаЧисло(3, 0));
	Раздел8.Колонки.Добавить("ДатаИспрКСчФ", ОбщегоНазначения.ОписаниеТипаСтрока(10));
	
	Если ПравилаЗаполнения = "2021Кв3"
		Или ПравилаЗаполнения = "2023Кв1"
		Или ПравилаЗаполнения = "2025Кв1"
		Или ПравилаЗаполнения = "2026Кв1" Тогда
		Раздел8.Колонки.Добавить("СвРегНом", Новый ОписаниеТипов("Массив"));
		
	ИначеЕсли ПравилаЗаполнения = "2017Кв1"
		Или ПравилаЗаполнения = "2019Кв1" Тогда
		Раздел8.Колонки.Добавить("РегНомТД", Новый ОписаниеТипов("Массив"));
		
	Иначе
		Раздел8.Колонки.Добавить("НомТД", ОбщегоНазначения.ОписаниеТипаСтрока(0));
	КонецЕсли;
	
	Если ПравилаЗаполнения = "2026Кв1" Тогда
		Раздел8.Колонки.Добавить("СвЧастСчФ", Новый ОписаниеТипов("Массив")); // Элементы массива НовыйОписаниеСчетаФактурыНаОтгрузкуДляДекларации()
	КонецЕсли;
	
	Раздел8.Колонки.Добавить("ОКВ", ОбщегоНазначения.ОписаниеТипаСтрока(3));
	
	Раздел8.Колонки.Добавить("СтоимПокупВ", ОбщегоНазначения.ОписаниеТипаЧисло(19, 2));
	Раздел8.Колонки.Добавить("СумНДСВыч", ОбщегоНазначения.ОписаниеТипаЧисло(19, 2));
	
	Раздел8.Колонки.Добавить("КодВидОпер", Новый ОписаниеТипов("Массив"));
	
	Раздел8.Колонки.Добавить("ДокПдтвУпл", Новый ОписаниеТипов("Массив"));
	Раздел8.Колонки.Добавить("ДатаУчТов", Новый ОписаниеТипов("Массив"));
	
	Раздел8.Колонки.Добавить("СвПрод", Новый ОписаниеТипов("Массив"));
	Раздел8.Колонки.Добавить("СвПос"); // Тип не задается
	
	Раздел8.Колонки.Добавить("ДокументРасшифровки"); // Тип не задается
	Раздел8.Колонки.Добавить("ДополнительныеСведения");
	
	Раздел81 = Раздел8.СкопироватьКолонки();
	Раздел81.Колонки.СумНДСВыч.Имя = "СумНДС";
	
	СтруктураПараметров.Вставить("ТаблицаРаздел8", Раздел8);
	СтруктураПараметров.Вставить("ТаблицаРаздел81", Раздел81);
	
	ИтогиРаздел8 = Новый Структура("СумНДСВсКПк");
	ИтогиРаздел81 = Новый Структура("СумНДСИтКПк,СумНДСИтП1Р8");
	
	СтруктураПараметров.Вставить("ИтогиРаздел8", ИтогиРаздел8);
	СтруктураПараметров.Вставить("ИтогиРаздел81", ИтогиРаздел81);
	
КонецПроцедуры

Функция НовыйОписаниеСчетаФактурыНаОтгрузкуДляДекларации()
	
	ОписаниеСчетаФактуры = Новый Структура();
	ОписаниеСчетаФактуры.Вставить("НомЧастСчФ", ""); // Строка(1000)
	ОписаниеСчетаФактуры.Вставить("ДатаЧастСчФ", ""); // Строка(10)
	
	Возврат ОписаниеСчетаФактуры;
	
КонецФункции

Функция НовыйПараметрыДобавленияСтрокиВРазделДекларацииПоНДС()
	
	Возврат Новый Структура("
		|СимволПрочерка,
		|СтруктураНомерСФ,
		|Параметр_ПродавецИНН,
		|Параметр_ПродавецКПП,
		|Параметр_ПродавецСсылка,
		|Параметр_ПродавецПредставление,
		|Параметр_ДатаОприходования,
		|ЭтоОсновнойРаздел");
	
КонецФункции

Процедура ДобавитьСтрокуВРаздел8ДекларацииПоНДС(ТаблицаДанныхКнига, ДетальнаяЗапись, НППСтроки, ПараметрыДобавленияСтроки, ПараметрыОтчета)
	
	ПравилаЗаполнения = ПараметрыОтчета.ПравилаЗаполнения;
	
	СимволПрочерка					= ПараметрыДобавленияСтроки.СимволПрочерка;
	СтруктураНомерСФ				= ПараметрыДобавленияСтроки.СтруктураНомерСФ;
	Параметр_ПродавецИНН			= ПараметрыДобавленияСтроки.Параметр_ПродавецИНН;
	Параметр_ПродавецКПП			= ПараметрыДобавленияСтроки.Параметр_ПродавецКПП;
	Параметр_ПродавецСсылка			= ПараметрыДобавленияСтроки.Параметр_ПродавецСсылка;
	Параметр_ПродавецПредставление	= ПараметрыДобавленияСтроки.Параметр_ПродавецПредставление;
	Параметр_ДатаОприходования		= ПараметрыДобавленияСтроки.Параметр_ДатаОприходования;
	ЭтоОсновнойРаздел				= ПараметрыДобавленияСтроки.ЭтоОсновнойРаздел;
	
	НоваяСтрока = ТаблицаДанныхКнига.Добавить();
	
	// Одинаковые колонки для основного раздела и доп.листов
	НоваяСтрока["НомерПор"]		= НППСтроки;
	
	НоваяСтрока["НомСчФПрод"]	= СтруктураНомерСФ["Номер"];
	НоваяСтрока["ДатаСчФПрод"]	= Формат(ДетальнаяЗапись["Дата"], "ДФ=dd.MM.yyyy");
		
	НоваяСтрока["НомИспрСчФ"]	= ДетальнаяЗапись["НомерИсправления"];
	НоваяСтрока["ДатаИспрСчФ"]	= Формат(ДетальнаяЗапись["ДатаИсправления"], "ДФ=dd.MM.yyyy");
	
	НоваяСтрока["НомКСчФПрод"]	= СтруктураНомерСФ["НомерКСФ"];
	НоваяСтрока["ДатаКСчФПрод"]	= Формат(ДетальнаяЗапись["ДатаКСФ"], "ДФ=dd.MM.yyyy");
	
	НоваяСтрока["НомИспрКСчФ"]	= ДетальнаяЗапись["НомерИсправленияКСФ"];
	НоваяСтрока["ДатаИспрКСчФ"]	= Формат(ДетальнаяЗапись["ДатаИсправленияКСФ"], "ДФ=dd.MM.yyyy");
	
	Если ПравилаЗаполнения = "2021Кв3"
		Или ПравилаЗаполнения = "2023Кв1"
		Или ПравилаЗаполнения = "2025Кв1"
		Или ПравилаЗаполнения = "2026Кв1" Тогда
		УчетНДС.ЗаполнитьПоказателиПрослеживаемости_2021Кв3_СвРегНом(НоваяСтрока, ДетальнаяЗапись);
		
	ИначеЕсли ПравилаЗаполнения = "2017Кв1"
		Или ПравилаЗаполнения = "2019Кв1" Тогда
		НоваяСтрока["РегНомТД"] = Новый Массив();
		
	Иначе
		НоваяСтрока["НомТД"] = "";
	КонецЕсли;
	
	Если ПравилаЗаполнения = "2026Кв1" Тогда
		ЗаполнитьСчетаФактурыНаОтгрузкуДляДекларации(НоваяСтрока, ДетальнаяЗапись);
	КонецЕсли;
	
	НоваяСтрока["ОКВ"]			= ?(ДетальнаяЗапись["УказанаИностраннаяВалюта"],
									ДетальнаяЗапись["ВалютаКод"],
									"");
	НоваяСтрока["СтоимПокупВ"]	= ДетальнаяЗапись["ВсегоВалютная"];
	
	ВремМассив = Новый Массив();
	Если ЗначениеЗаполнено(ДетальнаяЗапись["КодВидаОперации"]) Тогда
		ВремМассив.Добавить(ДетальнаяЗапись["КодВидаОперации"]);
	КонецЕсли;
	НоваяСтрока["КодВидОпер"]	= ВремМассив;
	
	НоваяСтрока["ДокПдтвУпл"] = СформироватьСодержимоеГрафы7(ДетальнаяЗапись, "МассивСведений");
	
	ВремМассив = Новый Массив();
	Если ЗначениеЗаполнено(Параметр_ДатаОприходования) Тогда
		ВремМассив.Добавить(Формат(Параметр_ДатаОприходования, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	НоваяСтрока["ДатаУчТов"]	= ВремМассив;
	
	СвПрод = Новый Массив();
	Если Параметр_ПродавецИНН = СимволПрочерка Тогда
		Параметр_ПродавецИНН = "";
	КонецЕсли;
	Если НЕ ПустаяСтрока(Параметр_ПродавецИНН) Тогда
		СтруктураРеквизитовКонтрагента = УчетНДС.ПолучитьСтруктуруРеквизитовКонтрагента(Параметр_ПродавецИНН, Параметр_ПродавецКПП);
		СтруктураРеквизитовКонтрагента.Вставить("Контрагент",				Параметр_ПродавецСсылка);
		СтруктураРеквизитовКонтрагента.Вставить("КонтрагентНаименование",	Параметр_ПродавецПредставление);
		СвПрод.Добавить(СтруктураРеквизитовКонтрагента);
	КонецЕсли;
	НоваяСтрока["СвПрод"]		= СвПрод;
	
	НоваяСтрока["ДокументРасшифровки"] = ДетальнаяЗапись["Регистратор"];
	
	ДополнительныеСведения = Новый Структура("Контрагент,ПредставлениеКонтрагента,Документ,ПредставлениеДокумента");
	ДополнительныеСведения.Вставить("Контрагент",				Параметр_ПродавецСсылка);
	ДополнительныеСведения.Вставить("ПредставлениеКонтрагента",	Параметр_ПродавецПредставление);
	ДополнительныеСведения.Вставить("Документ",					ДетальнаяЗапись["СчетФактура"]);
	ДополнительныеСведения.Вставить("ПредставлениеДокумента",	
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='%1 на сумму %2 %3'"), 
			УчетНДС.ПолучитьПредставлениеДокумента(ДетальнаяЗапись["СчетФактура"], СтруктураНомерСФ["Номер"], ДетальнаяЗапись["Дата"]),
			Формат(ДетальнаяЗапись["ВсегоВалютная"], "ЧДЦ=2; ЧН="),
			ДетальнаяЗапись["ВалютаНаименование"]));
	НоваяСтрока["ДополнительныеСведения"]	= ДополнительныеСведения;
	
	// Различающиеся колонки
	Если ЭтоОсновнойРаздел Тогда
		// Основной раздел
		НоваяСтрока["СумНДСВыч"]= ДетальнаяЗапись["СуммаНДС"];
	Иначе
		// Дополнительный лист
		НоваяСтрока["СумНДС"]	= ДетальнаяЗапись["СуммаНДС"];
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСчетаФактурыНаОтгрузкуДляДекларации(НоваяСтрока, ДетальнаяЗапись)
	
	СчетаФактурыНаОтгрузку = Новый Массив();
	
	ТаблицаСчетаФактурыНаОтгрузку = ДетальнаяЗапись.ТаблицаСчетаФактурыНаОтгрузку;
	
	Если ТаблицаСчетаФактурыНаОтгрузку <> Null Тогда
		Для Каждого СтрокаТаблицы Из ТаблицаСчетаФактурыНаОтгрузку Цикл
			ОписаниеСчетаФактуры = НовыйОписаниеСчетаФактурыНаОтгрузкуДляДекларации();
			ОписаниеСчетаФактуры.НомЧастСчФ = СтрокаТаблицы.Номер;
			ОписаниеСчетаФактуры.ДатаЧастСчФ = Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy");
			
			СчетаФактурыНаОтгрузку.Добавить(ОписаниеСчетаФактуры);
		КонецЦикла;
	КонецЕсли;
	
	НоваяСтрока.СвЧастСчФ = СчетаФактурыНаОтгрузку;
	
КонецПроцедуры

Функция ЕстьЗаполненныйЭлементСтруктуры(СтруктураИтогов)
	
	Для Каждого Элемент Из СтруктураИтогов Цикл
		Если Элемент.Значение <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

