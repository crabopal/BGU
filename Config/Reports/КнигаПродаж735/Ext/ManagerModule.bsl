// Раздел 9.

Процедура ДобавитьСтрокуВРаздел9ДекларацииПоНДС(ТаблицаДанныхКнига, ДетальнаяЗапись, НППСтроки, ПараметрыДобавленияСтроки, ПараметрыОтчета)
	
	ПравилаЗаполнения = ПараметрыОтчета.ПравилаЗаполнения;
	
	СтруктураНомерСФ					= ПараметрыДобавленияСтроки.СтруктураНомерСФ;
	Параметр_ПокупательИНН				= ПараметрыДобавленияСтроки.Параметр_ПокупательИНН;
	Параметр_ПокупательКПП				= ПараметрыДобавленияСтроки.Параметр_ПокупательКПП;
	Параметр_ПокупательСсылка			= ПараметрыДобавленияСтроки.Параметр_ПокупательСсылка;
	Параметр_ПокупательПредставление	= ПараметрыДобавленияСтроки.Параметр_ПокупательПредставление;
	СимволПрочерка						= ПараметрыДобавленияСтроки.СимволПрочерка;
	
	НоваяСтрока = ТаблицаДанныхКнига.Добавить();
	
	// Одинаковые колонки для основного раздела и доп.листов
	НоваяСтрока["НомерПор"]		= НППСтроки;
	
	НоваяСтрока["НомСчФПрод"]	= СтруктураНомерСФ["Номер"];
	НоваяСтрока["ДатаСчФПрод"]	= Формат(ДетальнаяЗапись["Дата"], "ДФ=dd.MM.yyyy");
		
	НоваяСтрока["НомИспрСчФ"]	= ДетальнаяЗапись["НомерИсправления"];
	НоваяСтрока["ДатаИспрСчФ"]	= Формат(ДетальнаяЗапись["ДатаИсправления"], "ДФ=dd.MM.yyyy");
	
	НоваяСтрока["НомКСчФПрод"]	= СтруктураНомерСФ["НомерКСФ"];
	НоваяСтрока["ДатаКСчФПрод"]	= Формат(ДетальнаяЗапись["ДатаКСФ"], "ДФ=dd.MM.yyyy");
	
	НоваяСтрока["НомИспрКСчФ"]	= ДетальнаяЗапись["НомерИсправленияКСФ"];
	НоваяСтрока["ДатаИспрКСчФ"]	= Формат(ДетальнаяЗапись["ДатаИсправленияКСФ"], "ДФ=dd.MM.yyyy");
	
	Если ПравилаЗаполнения = "2021Кв3"
		Или ПравилаЗаполнения = "2023Кв1"
		Или ПравилаЗаполнения = "2025Кв1"
		Или ПравилаЗаполнения = "2026Кв1" Тогда
		УчетНДС.ЗаполнитьПоказателиПрослеживаемости_2021Кв3_СвРегНом(НоваяСтрока, ДетальнаяЗапись);
		
	ИначеЕсли ПравилаЗаполнения = "2017Кв1"
		Или ПравилаЗаполнения = "2019Кв1" Тогда
		НоваяСтрока["РегНомТД"] = Новый Массив();
	КонецЕсли;
	
	Если ПравилаЗаполнения = "2026Кв1" Тогда
		ЗаполнитьСчетаФактурыНаАвансДляДекларации(НоваяСтрока, ДетальнаяЗапись);
	КонецЕсли;
	
	НоваяСтрока["ОКВ"] = ?(ДетальнаяЗапись["УказанаИностраннаяВалюта"],
		ДетальнаяЗапись["ВалютаКод"],
		"");
		
	ЗаполнитьСуммыВСтрокеРаздела9ДекларацииПоНДС(НоваяСтрока, ДетальнаяЗапись, ПараметрыОтчета);
	
	ВремМассив = Новый Массив();
	Если ЗначениеЗаполнено(ДетальнаяЗапись["КодВидаОперации"]) Тогда
		ВремМассив.Добавить(ДетальнаяЗапись["КодВидаОперации"]);
	КонецЕсли;
	НоваяСтрока["КодВидОпер"] = ВремМассив;
	
	НоваяСтрока["ДокПдтвОпл"] = СформироватьСодержимоеГрафы11(ДетальнаяЗапись, "МассивСведений");
	
	СвПокуп = Новый Массив();
	Если Параметр_ПокупательИНН = СимволПрочерка Тогда
		Параметр_ПокупательИНН = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметр_ПокупательИНН) Тогда
		СтруктураРеквизитовКонтрагента = УчетНДС.ПолучитьСтруктуруРеквизитовКонтрагента(Параметр_ПокупательИНН, Параметр_ПокупательКПП);
		СтруктураРеквизитовКонтрагента.Вставить("Контрагент",				Параметр_ПокупательСсылка);
		СтруктураРеквизитовКонтрагента.Вставить("КонтрагентНаименование",	Параметр_ПокупательПредставление);
		СвПокуп.Добавить(СтруктураРеквизитовКонтрагента);
	КонецЕсли;
	НоваяСтрока["СвПокуп"] = СвПокуп;
	
	НоваяСтрока["ДокументРасшифровки"] = ДетальнаяЗапись["Регистратор"];
	
	ДополнительныеСведения = Новый Структура("Контрагент,ПредставлениеКонтрагента,Документ,ПредставлениеДокумента");
	ДополнительныеСведения.Вставить("Контрагент",				Параметр_ПокупательСсылка);
	ДополнительныеСведения.Вставить("ПредставлениеКонтрагента",	Параметр_ПокупательПредставление);
	ДополнительныеСведения.Вставить("Документ",					ДетальнаяЗапись["СчетФактура"]);
	ДополнительныеСведения.Вставить("ПредставлениеДокумента",	
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='%1 на сумму %2 %3'"), 
			УчетНДС.ПолучитьПредставлениеДокумента(
				ДетальнаяЗапись["СчетФактура"],
				СтруктураНомерСФ["Номер"],
				ДетальнаяЗапись["Дата"]),
				Формат(ДетальнаяЗапись["ВсегоПоСчетуФактуре"], "ЧДЦ=2; ЧН="),
				ДетальнаяЗапись["ВалютаНаименование"]));
	НоваяСтрока["ДополнительныеСведения"] = ДополнительныеСведения;
	
КонецПроцедуры

Процедура ЗаполнитьСчетаФактурыНаАвансДляДекларации(НоваяСтрока, ДетальнаяЗапись)
	
	СчетаФактурыНаАванс = Новый Массив();
	
	ТаблицаСчетаФактурыНаАванс = ДетальнаяЗапись.ТаблицаСчетаФактурыНаАванс;
	
	Если ТаблицаСчетаФактурыНаАванс <> Null Тогда
		Для Каждого СтрокаТаблицы Из ТаблицаСчетаФактурыНаАванс Цикл
			ОписаниеСчетаФактуры = НовыйОписаниеСчетаФактурыНаАвансДляДекларации();
			ОписаниеСчетаФактуры.НомЧастСчФ = СтрокаТаблицы.Номер;
			ОписаниеСчетаФактуры.ДатаЧастСчФ = Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy");
			
			СчетаФактурыНаАванс.Добавить(ОписаниеСчетаФактуры);
		КонецЦикла;
	КонецЕсли;
	
	НоваяСтрока.СвЧастСчФ = СчетаФактурыНаАванс;
	
КонецПроцедуры

