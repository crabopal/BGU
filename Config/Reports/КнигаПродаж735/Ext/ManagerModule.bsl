	Если ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026" Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаНачалаПримененияСтавки22дляШкурЛома",
			УчетНДСКлиентСервер.ДатаНачалаПримененияСтавки22дляШкурЛома());
