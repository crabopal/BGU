#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура СформироватьОтчет(Знач ПараметрыОтчета, ВозвратАдресХранилищаРезультата) Экспорт
	
	Перем	ЗаполнитьДанныеДляДекларации,
			ДанныеДляДекларации,
			РедакцияПостановления;
	
	// Установленные параметры отчета:
	Если ЗначениеЗаполнено(ПараметрыОтчета["НачалоПериода"]) Тогда
		ПараметрыОтчета["НачалоПериода"] = НачалоДня(ПараметрыОтчета["НачалоПериода"]);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета["КонецПериода"]) Тогда
		ПараметрыОтчета["КонецПериода"] = КонецДня(ПараметрыОтчета["КонецПериода"]);
	КонецЕсли;
	СформироватьОсновнойРаздел		= НЕ ПараметрыОтчета["ВыводитьТолькоДопЛисты"];
	СформироватьДопЛисты			= ПараметрыОтчета["ФормироватьДопЛисты"];
	УникальныйИдентификаторФормы	= ПараметрыОтчета["УникальныйИдентификаторФормы"];
	
	ПараметрыОтчета.Свойство("РедакцияПостановления", РедакцияПостановления);
	Если НЕ ЗначениеЗаполнено(РедакцияПостановления) Тогда
		РедакцияПостановления = УчетНДС.ПолучитьПостановлениеПоУмолчаниюДляЗаполненияКниги("КнигаПродаж");
		
		ПараметрыОтчета.Вставить("РедакцияПостановления", РедакцияПостановления);
	КонецЕсли;
	
	// Заменяем параметр на новый, обработанный и готовый к использованию:
	ПараметрыОтчета.Вставить("ПредставленияПричинНалогообложения",
		УчетНДС.ПолучитьПредставленияПричинНалогообложения(
			ПараметрыОтчета["ПредставленияПричинНалогообложения"],
			ПараметрыОтчета["ВыводитьПредставленияПричинНалогообложения"]));
	
	// Результаты отчета:
	СписокСформированныхЛистов = Новый СписокЗначений();
	ДеревоСформированныхЛистов = Новый ДеревоЗначений();
	КЧ = Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Любой);
	ДеревоСформированныхЛистов.Колонки.Добавить("Картинка",								Новый ОписаниеТипов("Картинка"));
	ДеревоСформированныхЛистов.Колонки.Добавить("Наименование",							Новый ОписаниеТипов("Строка"));
	ДеревоСформированныхЛистов.Колонки.Добавить("ПредставлениеНалоговогоПериода",		Новый ОписаниеТипов("Строка"));
	ДеревоСформированныхЛистов.Колонки.Добавить("ИндексСоответствующейСтрокиСписка",	Новый ОписаниеТипов("Число", КЧ));
	ДеревоСформированныхЛистов.Колонки.Добавить("ДатаНачалаПериода",					Новый ОписаниеТипов("Дата"));
	ДеревоСформированныхЛистов.Колонки.Добавить("АдресХранилищаСДаннымиЛиста",			Новый ОписаниеТипов("Строка"));
	ДеревоСформированныхЛистов.Колонки.Добавить("ЭтоДанныеОднимСписком",				Новый ОписаниеТипов("Булево"));
	ДеревоСформированныхЛистов.Колонки.Добавить("ЭтоПустойЛист",						Новый ОписаниеТипов("Булево"));
	
	// Декларация
	ПараметрыОтчета.Свойство("ЗаполнитьДанныеДляДекларации", ЗаполнитьДанныеДляДекларации);
	ЗаполнитьДанныеДляДекларации = (ЗаполнитьДанныеДляДекларации = Истина);
	ПараметрыОтчета.Вставить("ЗаполнитьДанныеДляДекларации", ЗаполнитьДанныеДляДекларации);
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		Если ПараметрыОтчета.ПравилаЗаполнения = "2025Кв1" Тогда
			// Применяется в 1 квартале 2026 г. до реализации изменений приказа ФНС России от 18.12.2025 N ЕД-7-3/1227@
			НаДату = '20250101';
		Иначе
			НаДату = ПараметрыОтчета.КонецПериода;
		КонецЕсли;
		
		РедакцияПостановления = УчетНДС.ПолучитьПостановлениеПоУмолчаниюДляЗаполненияКниги("КнигаПродаж", НаДату);
		
		ПараметрыОтчета.Вставить("РедакцияПостановления", РедакцияПостановления);
		
		ДанныеДляДекларации = Новый Структура();
		ИнициализироватьТаблицыДляДекларацииПоНДС(ДанныеДляДекларации, ПараметрыОтчета);
		
		//
		// Раздел 12
		//
		// СегментацияДанныхДекларации
		УчетНДС.СегментацияДанныхДекларации_ИнициализироватьПараметры(ПараметрыОтчета, "12");
		ДанныеДляДекларации.Вставить("ЗаполнятьРаздел12", Ложь); // Далее этот флаг установится в значение, соответствующее действительности
		
		ПараметрыОтчета.Вставить("РазделыДекларации", 0); // разделы 9 (9.1) и 12
		
	КонецЕсли;
	
	ДобавитьРассчитываемыеПараметрыОтчета(ПараметрыОтчета);
	
	Если СформироватьОсновнойРаздел Тогда
		СформироватьОсновнойРаздел(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, ДанныеДляДекларации);
	КонецЕсли;
	
	Если СформироватьДопЛисты Тогда 
		СформироватьДополнительныеЛисты(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, ДанныеДляДекларации);
	КонецЕсли;
	
	// Оформляем пустые результаты отчета
	
	ОтсутствуетОсновнойРаздел = ?(СформироватьОсновнойРаздел, ПараметрыОтчета["ОсновнойРазделПустой"], Истина);
	
	ОтсутствуютДопЛисты = ?(СформироватьДопЛисты, ПараметрыОтчета["ОтсутствуютДопЛисты"], Истина);
	
	ВывестиПустойБланкОсновногоРаздела = СформироватьОсновнойРаздел И ОтсутствуетОсновнойРаздел И ОтсутствуютДопЛисты;
	
	ВывестиПустойБланкДопЛиста = НЕ СформироватьОсновнойРаздел И СформироватьДопЛисты И ОтсутствуютДопЛисты;
	
	Если ВывестиПустойБланкОсновногоРаздела Тогда
		
		ТабДокумент = ВывестиПустойОсновнойРаздел(ПараметрыОтчета);
		
		ДобавитьПустойЛист(ДеревоСформированныхЛистов, ТабДокумент, УникальныйИдентификаторФормы);
		
	ИначеЕсли ВывестиПустойБланкДопЛиста Тогда
		
		ТабДокумент = ВывестиПустойДопЛист(ПараметрыОтчета);
		
		ДобавитьПустойЛист(ДеревоСформированныхЛистов, ТабДокумент, УникальныйИдентификаторФормы);
		
	КонецЕсли;
	
	
	// Декларация
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		
		//
		// Раздел 12
		//
		// СегментацияДанныхДекларации
		Если ДанныеДляДекларации["ЗаполнятьРаздел12"] Тогда
			
			// Выводим итоги всего раздела
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить("СуммаДокумента",	ДанныеДляДекларации["ИтогиРаздел12"]["СтоимТовСНалВс"]);
			ЗначенияПараметров.Вставить("СуммаНДС",			ДанныеДляДекларации["ИтогиРаздел12"]["СумНалПокуп"]);
			ЗначенияПараметров.Вставить("СуммаБезНДС",		ДанныеДляДекларации["ИтогиРаздел12"]["СтоимТовБНалВс"]);
			
			ОбластьВсего = ДанныеДляДекларации["МакетРаздел12"].ПолучитьОбласть("Всего");
			ОбластьВсего.Параметры.Заполнить(ЗначенияПараметров);
			
			ДанныеДляДекларации["ТабДокРаздел12"].Вывести(ОбластьВсего);
			
			// Записываем текущий сегмент, обновляем статистику
			УчетНДС.СегментацияДанныхДекларации_ЗаписатьТекущийСегмент(
				"12",	// ОбозначениеРаздела
				ДанныеДляДекларации["ТабДокРаздел12"],
				ДанныеДляДекларации["МакетРаздел12"],
				ПараметрыОтчета,
				ДанныеДляДекларации,
				Истина);	// ЗакончиласьТаблица
				
			// Сохраняем итоги всего раздела
			РегламентированнаяОтчетность.ЗаписатьИтогиРазделаДекларацииНДС(
				ПараметрыОтчета.СсылкаНаДекларацию,
				"Раздел12",
				ДанныеДляДекларации["ИтогиРаздел12"]);
		КонецЕсли;
		
		РезультатыОтчета = Новый Структура();
		РезультатыОтчета.Вставить("ИтогиРаздел12", ДанныеДляДекларации["ИтогиРаздел12"]);
	Иначе
		
		Если НЕ ВывестиПустойБланкОсновногоРаздела И НЕ ВывестиПустойБланкДопЛиста Тогда
			ДозаполнитьДеревоСформированныхЛистов(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, УникальныйИдентификаторФормы);
		КонецЕсли;
		
		РезультатыОтчета = Новый Структура();
		РезультатыОтчета.Вставить("ДеревоСформированныхЛистов",	ДеревоСформированныхЛистов);
	КонецЕсли;
	ВозвратАдресХранилищаРезультата = ПоместитьВоВременноеХранилище(РезультатыОтчета, УникальныйИдентификаторФормы);
	
КонецПроцедуры

#Область СлужебныйПрограммныйИнтерфейс

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "Основной");
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Настройки

Функция ПолучитьИспользуемыйМакет(ПараметрыОтчета)
	
	РедакцияПостановления = ПараметрыОтчета.РедакцияПостановления;
	
	Если РедакцияПостановления = "№ 26 от 23.01.2026" Тогда
		ИмяМакета = "ОбщийМакет.ПФ_MXL_КнигаПродаж1137_26";
		
	ИначеЕсли РедакцияПостановления = "№ 1448 от 29.10.2024" Тогда
		ИмяМакета = "ОбщийМакет.ПФ_MXL_КнигаПродаж1137_1448";
		
	ИначеЕсли РедакцияПостановления = "№ 534 от 02.04.2021" Тогда
		ИмяМакета = "ОбщийМакет.ПФ_MXL_КнигаПродаж1137_534";
		
	ИначеЕсли РедакцияПостановления = "№ 15 от 19.01.2019" Тогда
		ИмяМакета = "ОбщийМакет.ПФ_MXL_КнигаПродаж1137_15";
		
	ИначеЕсли РедакцияПостановления = "№ 981 от 19.08.2017" Тогда
		ИмяМакета = "ОбщийМакет.ПФ_MXL_КнигаПродаж1137_981";
		
	Иначе
		ИмяМакета = "ОбщийМакет.ПФ_MXL_КнигаПродаж1137_735";
	КонецЕсли;
	
	Возврат УправлениеПечатью.МакетПечатнойФормы(ИмяМакета);
	
КонецФункции

Процедура ДобавитьРассчитываемыеПараметрыОтчета(ПараметрыОтчета)
	
	ПараметрыОтчета.Вставить("ПостановлениемПредусмотренПоказательСчетаФактурыНаАванс",
		ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026");
	
	ПараметрыОтчета.Вставить("ПостановлениемПредусмотреныПоказателиПрослеживаемости",
		(ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026"
			Или ПараметрыОтчета.РедакцияПостановления = "№ 1448 от 29.10.2024"
			Или ПараметрыОтчета.РедакцияПостановления = "№ 534 от 02.04.2021"));
	
КонецПроцедуры

#КонецОбласти

#Область НастройкаСКД

Функция ПолучитьМакетСКДОсновногоРаздела(ПараметрыОтчета)
	
	Если ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026" Тогда
		ИмяМакета = "ОсновнойРазделКнигиПродаж_26";
	Иначе
		ИмяМакета = "ОсновнойРазделКнигиПродаж";
	КонецЕсли;
	
	Возврат ПолучитьМакет(ИмяМакета);
	
КонецФункции

Функция ПолучитьМакетСКДДопЛиста(ПараметрыОтчета)
	
	Если ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026" Тогда
		ИмяМакета = "ДопЛистыКнигиПродаж_26";
	Иначе
		ИмяМакета = "ДопЛистыКнигиПродаж";
	КонецЕсли;
	
	Возврат ПолучитьМакет(ИмяМакета);
	
КонецФункции

Функция ПолучитьМакетСКДИтогиКнигиПродаж(ПараметрыОтчета)
	
	Если ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026" Тогда
		ИмяМакета = "ИтогиКнигиПродажЗаОтчетныйПериод_26";
	Иначе
		ИмяМакета = "ИтогиКнигиПродажЗаОтчетныйПериод";
	КонецЕсли;
	
	Возврат ПолучитьМакет(ИмяМакета);
	
КонецФункции

Функция ПолучитьНастройкиСКД_ОсновнойРаздел(ПараметрыОтчета)
	
	Результат = Новый Структура("
		|ИспользуемаяСхемаКомпоновкиДанных,
		|НовыйКомпоновщикНастроек");
	
	// Возвращаемые объекты:
	ИспользуемаяСхемаКомпоновкиДанных	= ПолучитьМакетСКДОсновногоРаздела(ПараметрыОтчета);
	НовыйКомпоновщикНастроек			= Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ИспользуемаяСхемаКомпоновкиДанных));
	НовыйКомпоновщикНастроек.ЗагрузитьНастройки(ИспользуемаяСхемаКомпоновкиДанных.ВариантыНастроек["Основной"].Настройки);
	
	// Настраиваем схему.
	УстановитьПараметрыСКД_ОсновнойРаздел(НовыйКомпоновщикНастроек, ПараметрыОтчета);
	
	// Копируем отбор, установленный в форме отчета:
	СтандартныеОтчетыКлиентСервер.СкопироватьОтбор(
		НовыйКомпоновщикНастроек.Настройки.Отбор,
		ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	
	// Настройки группировок:
	Настройки = НовыйКомпоновщикНастроек.Настройки;
	ГруппировкаНалоговыйПериод				= Настройки.Структура[0];
	ГруппировкаНалоговыйПериодКонтрагент	= Настройки.Структура[1];
	ГруппировкаОднимСписком					= Настройки.Структура[2];
	ГруппировкаОднимСпискомКонтрагент		= Настройки.Структура[3];
	
	Если ПараметрыОтчета["ГруппироватьПоКонтрагентам"] Тогда
		ГруппировкаНалоговыйПериод.Использование			= Ложь;
		ГруппировкаНалоговыйПериодКонтрагент.Использование	= Истина;
		ГруппировкаОднимСписком.Использование				= Ложь;
		ГруппировкаОднимСпискомКонтрагент.Использование		= Истина;
	Иначе
		ГруппировкаНалоговыйПериод.Использование			= Истина;
		ГруппировкаНалоговыйПериодКонтрагент.Использование	= Ложь;
		ГруппировкаОднимСписком.Использование				= Истина;
		ГруппировкаОднимСпискомКонтрагент.Использование		= Ложь;
	КонецЕсли;
	
	Результат["ИспользуемаяСхемаКомпоновкиДанных"]	= ИспользуемаяСхемаКомпоновкиДанных;
	Результат["НовыйКомпоновщикНастроек"]			= НовыйКомпоновщикНастроек;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНастройкиСКД_ДополнительныеЛисты(ПараметрыОтчета)
	
	Результат = Новый Структура("
		|ИспользуемаяСхемаКомпоновкиДанных,
		|НовыйКомпоновщикНастроек");
	
	// Возвращаемые объекты:
	ИспользуемаяСхемаКомпоновкиДанных	= ПолучитьМакетСКДДопЛиста(ПараметрыОтчета);
	НовыйКомпоновщикНастроек			= Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ИспользуемаяСхемаКомпоновкиДанных));
	НовыйКомпоновщикНастроек.ЗагрузитьНастройки(ИспользуемаяСхемаКомпоновкиДанных.ВариантыНастроек["Основной"].Настройки);
	
	// Настраиваем схему.
	УстановитьПараметрыСКД_ДопЛист(НовыйКомпоновщикНастроек, ПараметрыОтчета);
	
	// Копируем отбор, установленный в форме отчета:
	СтандартныеОтчетыКлиентСервер.СкопироватьОтбор(
		НовыйКомпоновщикНастроек.Настройки.Отбор,
		ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	
	// Настройки группировок:
	Настройки = НовыйКомпоновщикНастроек.Настройки;
	ГруппировкаНалоговыйПериод				= Настройки.Структура[0];
	ГруппировкаНалоговыйПериодКонтрагент	= Настройки.Структура[1];
	
	Если ПараметрыОтчета["ГруппироватьПоКонтрагентам"] Тогда
		ГруппировкаНалоговыйПериод.Использование			= Ложь;
		ГруппировкаНалоговыйПериодКонтрагент.Использование	= Истина;
	Иначе
		ГруппировкаНалоговыйПериод.Использование			= Истина;
		ГруппировкаНалоговыйПериодКонтрагент.Использование	= Ложь;
	КонецЕсли;
	
	Результат["ИспользуемаяСхемаКомпоновкиДанных"]	= ИспользуемаяСхемаКомпоновкиДанных;
	Результат["НовыйКомпоновщикНастроек"]			= НовыйКомпоновщикНастроек;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНастройкиСКД_ИтогиКнигиПродажЗаОтчетныйПериод(ПараметрыОтчета)
	
	Результат = Новый Структура("
		|ИспользуемаяСхемаКомпоновкиДанных,
		|НовыйКомпоновщикНастроек");
	
	// Возвращаемые объекты:
	ИспользуемаяСхемаКомпоновкиДанных	= ПолучитьМакетСКДИтогиКнигиПродаж(ПараметрыОтчета);
	НовыйКомпоновщикНастроек			= Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ИспользуемаяСхемаКомпоновкиДанных));
	НовыйКомпоновщикНастроек.ЗагрузитьНастройки(ИспользуемаяСхемаКомпоновкиДанных.ВариантыНастроек["Основной"].Настройки);
	
	// Настраиваем схему.
	УстановитьПараметрыСКД_ИтогиДопЛиста(НовыйКомпоновщикНастроек, ПараметрыОтчета);
	
	// Копируем отбор, установленный в форме отчета:
	СтандартныеОтчетыКлиентСервер.СкопироватьОтбор(
		НовыйКомпоновщикНастроек.Настройки.Отбор,
		ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	
	Результат["ИспользуемаяСхемаКомпоновкиДанных"]	= ИспользуемаяСхемаКомпоновкиДанных;
	Результат["НовыйКомпоновщикНастроек"]			= НовыйКомпоновщикНастроек;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьПараметрыСКД_ОсновнойРаздел(КомпоновщикНастроек, ПараметрыОтчета)
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаНачала",	ПараметрыОтчета["НачалоПериода"]);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаКонца",		ПараметрыОтчета["КонецПериода"]);
	
	ПричиныНалогообложенияАванс = Новый СписокЗначений();
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученный);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаАванс);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера);
	ПричиныНалогообложенияАванс.Добавить(Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПричиныНалогообложенияАванс",	ПричиныНалогообложенияАванс);
	
	ПричиныНалогообложенияШкурыЛом = Новый СписокЗначений();
	ПричиныНалогообложенияШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом);
	ПричиныНалогообложенияШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПричиныНалогообложенияШкурыЛом",	ПричиныНалогообложенияШкурыЛом);
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаРУСвойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВалютаРУ, "Код,Наименование");
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРУ",						ВалютаРУ);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРУКод",					ВалютаРУСвойства.Код);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРУНаименование",			ВалютаРУСвойства.Наименование);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ИспользоватьВалютныйУчет",		ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПричиныНалогообложенияНалоговыйАгент",	ПолучитьПричиныНалогообложенияНалоговыйАгент());
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "РазделыДекларации",						ПараметрыОтчета["РазделыДекларации"]);
	
