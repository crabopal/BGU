Процедура ЗаполнитьСтрокуВсегоРаздел91(ДанныеДляДекларации, ИтогоЗаДень, ПараметрыОтчета)
	
	Итоги = ДанныеДляДекларации["ИтогиРаздел91"];
		
	// Строка Всего
	Итоги["СтПродВсП1Р9_10"]	= Итоги["СтПродВсП1Р9_10"]	+ ИтогоЗаДень["СуммаБезНДС10"];
	Итоги["СтПродВсП1Р9_0"]		= Итоги["СтПродВсП1Р9_0"]	+ ИтогоЗаДень["Сумма0"];
	Итоги["СумНДСВсП1Р9_10"]	= Итоги["СумНДСВсП1Р9_10"]	+ ИтогоЗаДень["НДС10"];
	Итоги["СтПродОсвП1Р9Вс"]	= Итоги["СтПродОсвП1Р9Вс"]	+ ИтогоЗаДень["СуммаБН"];
	
	Если ПараметрыОтчета.ПравилаЗаполнения = "2026Кв1" Тогда
		// Строка Всего
		Итоги["СтПродВсП1Р9_22"]	= Итоги["СтПродВсП1Р9_22"]	+ ИтогоЗаДень["СуммаБезНДС22"];
		Итоги["СумНДСВсП1Р9_22"]	= Итоги["СумНДСВсП1Р9_22"]	+ ИтогоЗаДень["НДС22"];
		Итоги["СтПродВсП1Р9_20"]	= Итоги["СтПродВсП1Р9_20"]	+ ИтогоЗаДень["СуммаБезНДС20"];
		Итоги["СумНДСВсП1Р9_20"]	= Итоги["СумНДСВсП1Р9_20"]	+ ИтогоЗаДень["НДС20"];
		Итоги["СтПродВсП1Р9_7"]		= Итоги["СтПродВсП1Р9_7"]	+ ИтогоЗаДень["СуммаБезНДС7"];
		Итоги["СумНДСВсП1Р9_7"]		= Итоги["СумНДСВсП1Р9_7"]	+ ИтогоЗаДень["НДС7"];
		Итоги["СтПродВсП1Р9_5"]		= Итоги["СтПродВсП1Р9_5"]	+ ИтогоЗаДень["СуммаБезНДС5"];
		Итоги["СумНДСВсП1Р9_5"]		= Итоги["СумНДСВсП1Р9_5"]	+ ИтогоЗаДень["НДС5"];
		
	ИначеЕсли ПараметрыОтчета.ПравилаЗаполнения = "2025Кв1" Тогда
		// Строка Всего
		Итоги["СтПродВсП1Р9_20"]	= Итоги["СтПродВсП1Р9_20"]	+ ИтогоЗаДень["СуммаБезНДС20"];
		Итоги["СумНДСВсП1Р9_20"]	= Итоги["СумНДСВсП1Р9_20"]	+ ИтогоЗаДень["НДС20"];
		Итоги["СтПродВсП1Р9_18"]	= Итоги["СтПродВсП1Р9_18"]	+ ИтогоЗаДень["СуммаБезНДС18"];
		Итоги["СумНДСВсП1Р9_18"]	= Итоги["СумНДСВсП1Р9_18"]	+ ИтогоЗаДень["НДС18"];
		Итоги["СтПродВсП1Р9_7"]		= Итоги["СтПродВсП1Р9_7"]	+ ИтогоЗаДень["СуммаБезНДС7"];
		Итоги["СумНДСВсП1Р9_7"]		= Итоги["СумНДСВсП1Р9_7"]	+ ИтогоЗаДень["НДС7"];
		Итоги["СтПродВсП1Р9_5"]		= Итоги["СтПродВсП1Р9_5"]	+ ИтогоЗаДень["СуммаБезНДС5"];
		Итоги["СумНДСВсП1Р9_5"]		= Итоги["СумНДСВсП1Р9_5"]	+ ИтогоЗаДень["НДС5"];
		
	ИначеЕсли ПараметрыОтчета["РедакцияПостановления"] = "№ 534 от 02.04.2021"
		Или ПараметрыОтчета["РедакцияПостановления"] = "№ 15 от 19.01.2019" Тогда
		// Строка Всего
		Итоги["СтПродВсП1Р9_20"]	= Итоги["СтПродВсП1Р9_20"]	+ ИтогоЗаДень["СуммаБезНДС20"];
		Итоги["СумНДСВсП1Р9_20"]	= Итоги["СумНДСВсП1Р9_20"]	+ ИтогоЗаДень["НДС20"];
		Итоги["СтПродВсП1Р9_18"]	= Итоги["СтПродВсП1Р9_18"]	+ ИтогоЗаДень["СуммаБезНДС18"];
		Итоги["СумНДСВсП1Р9_18"]	= Итоги["СумНДСВсП1Р9_18"]	+ ИтогоЗаДень["НДС18"];
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьИтогоЗаДеньРаздел91(СтрокаГруппировкиДатаСоставления, ДанныеДляДекларации)
	
	ИтогиЗаДень = ДанныеДляДекларации["ИтогиРаздел12ДетальныеДатаСоставленияДопЛиста"];
	
	ИтогоЗаДеньРаздел91 = Новый Структура();
	
	Для Каждого Элемент Из ИтогиЗаДень Цикл
		
		ИмяПоля = Элемент.Ключ;
		
		ИтогоЗаДеньРаздел91.Вставить(ИмяПоля, СтрокаГруппировкиДатаСоставления[ИмяПоля] - Элемент.Значение);
		
	КонецЦикла;
	
	Возврат ИтогоЗаДеньРаздел91;
	
КонецФункции

Функция ЕстьЗаполненныйЭлементСтруктуры(СтруктураИтогов)
	
	Для Каждого Элемент Из СтруктураИтогов Цикл
		Если Элемент.Значение <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Раздел 12.

Процедура ИнициализироватьТабличныйДокумент_Раздел12(ПараметрыОтчета, ДанныеДляДекларации)
	
	ТабДокРаздел12 = Новый ТабличныйДокумент();
	ТабДокРаздел12.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокРаздел12.АвтоМасштаб = Истина;
	ТабДокРаздел12.КлючПараметровПечати = "Раздел12";
	
	Если ПараметрыОтчета.ПравилаЗаполнения = "2025Кв1"
		Или ПараметрыОтчета.ПравилаЗаполнения = "2026Кв1" Тогда
		ИмяМакета = "ОбщийМакет.СведенияИзСчетовФактур2025Кв1";
	Иначе
		ИмяМакета = "ОбщийМакет.СведенияИзСчетовФактур";
	КонецЕсли;
	
	МакетРаздел12 = УправлениеПечатью.МакетПечатнойФормы(ИмяМакета);
	
	ДанныеДляДекларации.Вставить("ТабДокРаздел12",	ТабДокРаздел12);
	ДанныеДляДекларации.Вставить("МакетРаздел12",	МакетРаздел12);
	
КонецПроцедуры

Процедура ДобавитьСтрокуВРаздел12ДекларацииПоНДС(ДетальнаяЗапись, НППСтрокиРаздел12, ПараметрыДобавленияСтроки, ПараметрыОтчета, ДанныеДляДекларации)
	
	СтруктураНомерСФ					= ПараметрыДобавленияСтроки.СтруктураНомерСФ;
	Параметр_ПокупательИНН				= ПараметрыДобавленияСтроки.Параметр_ПокупательИНН;
	Параметр_ПокупательКПП				= ПараметрыДобавленияСтроки.Параметр_ПокупательКПП;
	Параметр_ПокупательСсылка			= ПараметрыДобавленияСтроки.Параметр_ПокупательСсылка;
	Параметр_ПокупательПредставление	= ПараметрыДобавленияСтроки.Параметр_ПокупательПредставление;
	ЭтоОсновнойРаздел					= ПараметрыДобавленияСтроки.ЭтоОсновнойРаздел;
	ПокупательЯвляетсяФизЛицом			= ПараметрыДобавленияСтроки.ПокупательЯвляетсяФизЛицом;
	Параметр_ПокупательИННКПП			= ПараметрыДобавленияСтроки.Параметр_ПокупательИННКПП;
	
	НППСтрокиРаздел12 = НППСтрокиРаздел12 + 1;
	
	ДатаРаздел12		= Формат(ДетальнаяЗапись["Дата"], "ДФ=dd.MM.yyyy");
	НомерДатаРаздел12	= СтруктураНомерСФ["Номер"] + НСтр("ru=' от '") + ДатаРаздел12;
	СумНалПокуп			= ДетальнаяЗапись["НДСПоСчетуФактуре"];
	СтоимТовСНалВс		= ДетальнаяЗапись["ВсегоПоСчетуФактуре"];
	СтоимТовБНалВс		= СтоимТовСНалВс - СумНалПокуп;
	
	ДополнительныеСведения = Новый Структура("Контрагент,ПредставлениеКонтрагента,Документ,ПредставлениеДокумента");
	
	Если ПустаяСтрока(Параметр_ПокупательИНН) Тогда
		СвПокупРаздел12 = Неопределено;
	Иначе
		СвПокупРаздел12 = Новый Структура();
		Если ПокупательЯвляетсяФизЛицом Тогда
			СвПокупРаздел12.Вставить("ИННФЛ",				Параметр_ПокупательИНН);
		Иначе
			СвПокупРаздел12.Вставить("ИННЮЛ",				Параметр_ПокупательИНН);
			СвПокупРаздел12.Вставить("КПП",					Параметр_ПокупательКПП);
		КонецЕсли;
		СвПокупРаздел12.Вставить("Контрагент",				Параметр_ПокупательСсылка);
		СвПокупРаздел12.Вставить("КонтрагентНаименование",	Параметр_ПокупательПредставление);
		
		ДополнительныеСведения.Вставить("Контрагент",				Параметр_ПокупательСсылка);
		ДополнительныеСведения.Вставить("ПредставлениеКонтрагента",	Параметр_ПокупательПредставление);
	КонецЕсли;
	ДополнительныеСведения.Вставить("ПредставлениеДокумента",	
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='%1 на сумму %2 %3'"), 
			
			УчетНДС.ПолучитьПредставлениеДокумента(
				ДетальнаяЗапись["СчетФактура"],
				СтруктураНомерСФ["Номер"],
				ДетальнаяЗапись["Дата"]),
				Формат(ДетальнаяЗапись["ВсегоПоСчетуФактуре"], "ЧДЦ=2; ЧН="),
				ДетальнаяЗапись["ВалютаНаименование"]));
	ДополнительныеСведения.Вставить("Документ",	ДетальнаяЗапись["СчетФактура"]);
	
	// Записываем в табличный документ
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("Ном",						НППСтрокиРаздел12);
	ЗначенияПараметров.Вставить("НомерДата",				НомерДатаРаздел12);
	ЗначенияПараметров.Вставить("КонтрагентНаименование",	Параметр_ПокупательПредставление);
	ЗначенияПараметров.Вставить("КонтрагентИННКПП",			Параметр_ПокупательИННКПП);
	ЗначенияПараметров.Вставить("Валюта",					ДетальнаяЗапись["ВалютаНаименование"]);
	ЗначенияПараметров.Вставить("СуммаДокумента",			СтоимТовСНалВс);
	ЗначенияПараметров.Вставить("СуммаНДС",					СумНалПокуп);
	ЗначенияПараметров.Вставить("СчетФактураРасшифровка",	ДетальнаяЗапись["Регистратор"]);
	
	Если ПараметрыОтчета.ПравилаЗаполнения = "2025Кв1"
		Или ПараметрыОтчета.ПравилаЗаполнения = "2026Кв1" Тогда
		ЗначенияПараметров.Вставить("КодВидаОперации",		ДетальнаяЗапись.КодВидаОперации);
		ЗначенияПараметров.Вставить("СуммаБезНДС",			СтоимТовБНалВс);
	КонецЕсли;
	
	ОбластьСтрока	= ДанныеДляДекларации.МакетРаздел12.ПолучитьОбласть("Строка");
	ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
	ДанныеДляДекларации.ТабДокРаздел12.Вывести(ОбластьСтрока);
	
	// Записываем в таблицу данных
	НоваяСтрока = ДанныеДляДекларации.ТаблицаРаздел12.Добавить();
	НоваяСтрока["НомерПор"]					= НППСтрокиРаздел12;
	НоваяСтрока["НомСчФ"]					= СтруктураНомерСФ["Номер"];
	НоваяСтрока["ДатаСчФ"]					= ДатаРаздел12;
	
	НоваяСтрока["ОКВ"]						= ?(ДетальнаяЗапись["УказанаИностраннаяВалюта"],
												ДетальнаяЗапись["ВалютаКод"],
												"");
	
	НоваяСтрока["СумНалПокуп"]				= СумНалПокуп;
	НоваяСтрока["СтоимТовСНалВс"]			= СтоимТовСНалВс;
	НоваяСтрока["СтоимТовБНалВс"]			= СтоимТовБНалВс;
	НоваяСтрока["СвПокуп"]					= СвПокупРаздел12;
	
	Если ПараметрыОтчета.ПравилаЗаполнения = "2025Кв1"
		Или ПараметрыОтчета.ПравилаЗаполнения = "2026Кв1" Тогда
		КодВидОпер = Новый Массив();
		КодВидОпер.Добавить(ДетальнаяЗапись.КодВидаОперации);
		НоваяСтрока["КодВидОпер"]			= КодВидОпер;
	КонецЕсли;
	
	НоваяСтрока["ДокументРасшифровки"]		= ДетальнаяЗапись["Регистратор"];
	НоваяСтрока["ДополнительныеСведения"]	= ДополнительныеСведения;
	
	ИтогиРаздел12 = ДанныеДляДекларации["ИтогиРаздел12"];
	ИтогиРаздел12["СумНалПокуп"]	= ИтогиРаздел12["СумНалПокуп"]		+ СумНалПокуп;
	ИтогиРаздел12["СтоимТовСНалВс"]	= ИтогиРаздел12["СтоимТовСНалВс"]	+ СтоимТовСНалВс;
	ИтогиРаздел12["СтоимТовБНалВс"]	= ИтогиРаздел12["СтоимТовБНалВс"]	+ СтоимТовБНалВс;
	
	УвеличитьИтогиРаздел12Детальные(ДетальнаяЗапись, ДанныеДляДекларации, ПараметрыОтчета);
	
	Если НЕ ЭтоОсновнойРаздел Тогда
		УвеличитьИтогиРаздел12ДетальныеДатаСоставленияДопЛиста(ДетальнаяЗапись, ДанныеДляДекларации, ПараметрыОтчета);
	КонецЕсли;
	
КонецПроцедуры

Процедура УвеличитьИтогиРаздел12Детальные(ДетальнаяЗапись, ДанныеДляДекларации, ПараметрыОтчета)
	
	Итоги = ДанныеДляДекларации["ИтогиРаздел12Детальные"];
	
	Итоги["СуммаБезНДС10"]	= Итоги["СуммаБезНДС10"]	+ ДетальнаяЗапись["СуммаБезНДС10"];
	Итоги["Сумма0"]			= Итоги["Сумма0"]			+ ДетальнаяЗапись["Сумма0"];
	Итоги["НДС10"]			= Итоги["НДС10"]			+ ДетальнаяЗапись["НДС10"];
	Итоги["СуммаБН"]		= Итоги["СуммаБН"]			+ ДетальнаяЗапись["СуммаБН"];
	
	Если ПараметрыОтчета.ПравилаЗаполнения = "2026Кв1" Тогда
		Итоги["СуммаБезНДС22"]	= Итоги["СуммаБезНДС22"]	+ ДетальнаяЗапись["СуммаБезНДС22"];
		Итоги["НДС22"]			= Итоги["НДС22"]			+ ДетальнаяЗапись["НДС22"];
		Итоги["СуммаБезНДС20"]	= Итоги["СуммаБезНДС20"]	+ ДетальнаяЗапись["СуммаБезНДС20"];
		Итоги["НДС20"]			= Итоги["НДС20"]			+ ДетальнаяЗапись["НДС20"];
		Итоги["СуммаБезНДС7"]	= Итоги["СуммаБезНДС7"]		+ ДетальнаяЗапись["СуммаБезНДС7"];
		Итоги["НДС7"]			= Итоги["НДС7"]				+ ДетальнаяЗапись["НДС7"];
		Итоги["СуммаБезНДС5"]	= Итоги["СуммаБезНДС5"]		+ ДетальнаяЗапись["СуммаБезНДС5"];
		Итоги["НДС5"]			= Итоги["НДС5"]				+ ДетальнаяЗапись["НДС5"];
		
	ИначеЕсли ПараметрыОтчета.ПравилаЗаполнения = "2025Кв1" Тогда
		Итоги["СуммаБезНДС20"]	= Итоги["СуммаБезНДС20"]	+ ДетальнаяЗапись["СуммаБезНДС20"];
		Итоги["НДС20"]			= Итоги["НДС20"]			+ ДетальнаяЗапись["НДС20"];
		Итоги["СуммаБезНДС18"]	= Итоги["СуммаБезНДС18"]	+ ДетальнаяЗапись["СуммаБезНДС18"];
		Итоги["НДС18"]			= Итоги["НДС18"]			+ ДетальнаяЗапись["НДС18"];
		Итоги["СуммаБезНДС7"]	= Итоги["СуммаБезНДС7"]		+ ДетальнаяЗапись["СуммаБезНДС7"];
		Итоги["НДС7"]			= Итоги["НДС7"]				+ ДетальнаяЗапись["НДС7"];
		Итоги["СуммаБезНДС5"]	= Итоги["СуммаБезНДС5"]		+ ДетальнаяЗапись["СуммаБезНДС5"];
		Итоги["НДС5"]			= Итоги["НДС5"]				+ ДетальнаяЗапись["НДС5"];
		
	ИначеЕсли ПараметрыОтчета["РедакцияПостановления"] = "№ 534 от 02.04.2021"
		Или ПараметрыОтчета["РедакцияПостановления"] = "№ 15 от 19.01.2019" Тогда
		Итоги["СуммаБезНДС20"]	= Итоги["СуммаБезНДС20"]	+ ДетальнаяЗапись["СуммаБезНДС20"];
		Итоги["НДС20"]			= Итоги["НДС20"]			+ ДетальнаяЗапись["НДС20"];
		Итоги["СуммаБезНДС18"]	= Итоги["СуммаБезНДС18"]	+ ДетальнаяЗапись["СуммаБезНДС18"];
		Итоги["НДС18"]			= Итоги["НДС18"]			+ ДетальнаяЗапись["НДС18"];
	КонецЕсли;
	
КонецПроцедуры

Процедура УвеличитьИтогиРаздел12ДетальныеДатаСоставленияДопЛиста(ДетальнаяЗапись, ДанныеДляДекларации, ПараметрыОтчета)
	
	Итоги = ДанныеДляДекларации["ИтогиРаздел12ДетальныеДатаСоставленияДопЛиста"];
	
	Итоги["СуммаБезНДС10"]	= Итоги["СуммаБезНДС10"]	+ ДетальнаяЗапись["СуммаБезНДС10"];
	Итоги["Сумма0"]			= Итоги["Сумма0"]			+ ДетальнаяЗапись["Сумма0"];
	Итоги["НДС10"]			= Итоги["НДС10"]			+ ДетальнаяЗапись["НДС10"];
	Итоги["СуммаБН"]		= Итоги["СуммаБН"]			+ ДетальнаяЗапись["СуммаБН"];
	
	Если ПараметрыОтчета.ПравилаЗаполнения = "2026Кв1" Тогда
		Итоги["СуммаБезНДС22"]	= Итоги["СуммаБезНДС22"]	+ ДетальнаяЗапись["СуммаБезНДС22"];
		Итоги["НДС22"]			= Итоги["НДС22"]			+ ДетальнаяЗапись["НДС22"];
		Итоги["СуммаБезНДС20"]	= Итоги["СуммаБезНДС20"]	+ ДетальнаяЗапись["СуммаБезНДС20"];
		Итоги["НДС20"]			= Итоги["НДС20"]			+ ДетальнаяЗапись["НДС20"];
