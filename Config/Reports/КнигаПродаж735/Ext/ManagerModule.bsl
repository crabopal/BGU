Процедура ИнициализироватьТаблицыДляДекларацииПоНДС(СтруктураПараметров, ПараметрыОтчета)
	
	ПравилаЗаполнения = ПараметрыОтчета.ПравилаЗаполнения;
	
	Если ПравилаЗаполнения = "2026Кв1" Тогда
		ИнициализироватьТаблицыДляДекларацииПоНДС_2026Кв1(СтруктураПараметров, ПараметрыОтчета);
		
	ИначеЕсли ПравилаЗаполнения = "2025Кв1" Тогда
		ИнициализироватьТаблицыДляДекларацииПоНДС_2025Кв1(СтруктураПараметров, ПараметрыОтчета);
		
	ИначеЕсли ПараметрыОтчета["РедакцияПостановления"] = "№ 534 от 02.04.2021" Тогда
		ИнициализироватьТаблицыДляДекларацииПоНДС_2021Кв3(СтруктураПараметров, ПараметрыОтчета);
		
	ИначеЕсли ПараметрыОтчета.РедакцияПостановления = "№ 15 от 19.01.2019" Тогда
		ИнициализироватьТаблицыДляДекларацииПоНДС_2019Кв1(СтруктураПараметров, ПараметрыОтчета);
		
	Иначе
		ИнициализироватьТаблицыДляДекларацииПоНДС_2017Кв1(СтруктураПараметров, ПараметрыОтчета);
	КонецЕсли;
	
