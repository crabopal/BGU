Процедура СформироватьОсновнойРаздел(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, ДанныеДляДекларации = Неопределено)
	
	РезультатДерево = Новый ДеревоЗначений();
	
	УчетНДС.ДобавитьКолонкуТаблицаПоказателиПрослеживаемости(РезультатДерево);
	
	ИспользуемаяКартинкаВДеревеЛистов	= БиблиотекаКартинок.ЖурналДокументов;
	
	УникальныйИдентификаторФормы		= ПараметрыОтчета["УникальныйИдентификаторФормы"];
	
    // Настраиваем схему КД:
	НастройкиСКД = ПолучитьНастройкиСКД_ОсновнойРаздел(ПараметрыОтчета);
	ИспользуемаяСхемаКомпоновкиДанных	= НастройкиСКД["ИспользуемаяСхемаКомпоновкиДанных"];
	НовыйКомпоновщикНастроек			= НастройкиСКД["НовыйКомпоновщикНастроек"];
	
	// Декларация
	// СегментацияДанныхДекларации
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		УчетНДС.СегментацияДанныхДекларации_ИнициализироватьПараметры(ПараметрыОтчета, "9");
	КонецЕсли;
	
	// Выполняем схему:
	Попытка
		// Выводим результат в дерево:
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(
			ИспользуемаяСхемаКомпоновкиДанных,				// 1
			НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
			,												// 3
			,												// 4
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"),	// 5
			Ложь);	// 6
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		ПроцессорВывода.УстановитьОбъект(РезультатДерево);
		
		УстановитьПривилегированныйРежим(Истина);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
		УстановитьПривилегированныйРежим(Ложь);
		
		ОсновнойРазделПустой = (РезультатДерево.Строки.Количество() = 1);
		
		ПараметрыОтчета.Вставить("ОсновнойРазделПустой", ОсновнойРазделПустой);
		
		Если ОсновнойРазделПустой Тогда
			Возврат;
		КонецЕсли;
		
		ВывестиДанныеОднимСписком = (РезультатДерево.Строки.Количество() >= 3) // количество периодов >=2 и +1 строка одним списком
			// Декларация
			И НЕ ПараметрыОтчета.ЗаполнитьДанныеДляДекларации;
		
		Для Каждого СтрокаГруппировки Из РезультатДерево.Строки Цикл
			Если СтрокаГруппировки["ЭтоГруппировкаНалоговыйПериод"] = Истина Тогда
				
				// Декларация
				Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
					//
					// Раздел 12
					//
					Если СтрокаГруппировки["КоличествоСтрокДляРаздела12"] > 0 Тогда
						ДанныеДляДекларации.Вставить("ЗаполнятьРаздел12", Истина);
					КонецЕсли;
					
					//---
					// Шапка
					//---
					ВывестиЗаголовокПриНеобходимости_Раздел12(ПараметрыОтчета, ДанныеДляДекларации);
				КонецЕсли;
				
				// Выводим в табличный документ:
				ТабДокумент = ВывестиОсновнойРаздел(ПараметрыОтчета, СтрокаГруппировки, ДанныеДляДекларации);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ТабДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				// Строка налогового периода:
				Наименование = ПредставлениеПериода(
					СтрокаГруппировки["ДатаНачалаПериода"],
					СтрокаГруппировки["ДатаОкончанияПериода"],
					"ФП");
				Поиск = Новый Структура("Наименование", Наименование);
				МассивСтрок = ДеревоСформированныхЛистов.Строки.НайтиСтроки(Поиск, Ложь); // ВключатьПодчиненные
				Если МассивСтрок.Количество() > 0 Тогда
					СтрокаНалоговогоПериода = МассивСтрок[0];
				Иначе
					СтрокаНалоговогоПериода = ДеревоСформированныхЛистов.Строки.Добавить();
					СтрокаНалоговогоПериода["Наименование"] = Наименование;
					СтрокаНалоговогоПериода["ПредставлениеНалоговогоПериода"] = Наименование;
				КонецЕсли;
				СтрокаНалоговогоПериода["ИндексСоответствующейСтрокиСписка"] = -1;
				СтрокаНалоговогоПериода["ДатаНачалаПериода"] = СтрокаГруппировки["ДатаНачалаПериода"];
				
				// Строка основного раздела:
				СтрокаОсновногоРаздела = СтрокаНалоговогоПериода.Строки.Добавить();
				СтрокаОсновногоРаздела["Наименование"] = НСтр("ru='Основной раздел'");
				СтрокаОсновногоРаздела["Картинка"] = ИспользуемаяКартинкаВДеревеЛистов;
				СтрокаОсновногоРаздела["ИндексСоответствующейСтрокиСписка"] = ИндексСоответствующейСтрокиСписка;
				СтрокаОсновногоРаздела["ПредставлениеНалоговогоПериода"] = Наименование + " (" + НРег(СтрокаОсновногоРаздела["Наименование"]) + ")";
				
				// Декларация
				// СегментацияДанныхДекларации
				Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
					// Сохраняем итоги всего раздела
					РегламентированнаяОтчетность.ЗаписатьИтогиРазделаДекларацииНДС(
						ПараметрыОтчета.СсылкаНаДекларацию,
						"Раздел9",
						ДанныеДляДекларации["ИтогиРаздел9"]);
				КонецЕсли;
				
			ИначеЕсли СтрокаГруппировки["ЭтоГруппировкаОднимСписком"] = Истина 
				И ВывестиДанныеОднимСписком Тогда
				
				// Выводим в табличный документ:
				ТабДокумент = ВывестиВсеОсновныеРазделыОднимСписком(ПараметрыОтчета, СтрокаГруппировки);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ТабДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				// Строка самого верхнего уровня:
				СтрокаОднимСписком = ДеревоСформированныхЛистов.Строки.Добавить();
				СтрокаОднимСписком["Наименование"]						= НСтр("ru='Книга одним списком'");
				СтрокаОднимСписком["Картинка"]							= ИспользуемаяКартинкаВДеревеЛистов;
				СтрокаОднимСписком["ИндексСоответствующейСтрокиСписка"]	= ИндексСоответствующейСтрокиСписка;
				СтрокаОднимСписком["ДатаНачалаПериода"]					= '00010101';
				СтрокаОднимСписком["ЭтоДанныеОднимСписком"]				= Истина;
				Если СтрокаГруппировки.Строки.Количество() = 0 Тогда
					СтрокаОднимСписком["ЭтоПустойЛист"]					= Истина;
				КонецЕсли;
				СтрокаОднимСписком["ПредставлениеНалоговогоПериода"]	= НСтр("ru='все основные разделы'");
				
			КонецЕсли;
		КонецЦикла;
		
	Исключение
		СообщитьОбОшибке(ИнформацияОбОшибке());
		
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
		
КонецПроцедуры

Процедура СформироватьДополнительныеЛисты(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, ДанныеДляДекларации = Неопределено)
	
	РезультатДерево = Новый ДеревоЗначений();
	
	УчетНДС.ДобавитьКолонкуТаблицаПоказателиПрослеживаемости(РезультатДерево);
	
	ИспользуемаяКартинкаВДеревеЛистов	= БиблиотекаКартинок.Документ;
	
	УникальныйИдентификаторФормы		= ПараметрыОтчета["УникальныйИдентификаторФормы"];
	
    // Настраиваем схему дополнительных листов:
	НастройкиСКД						= ПолучитьНастройкиСКД_ДополнительныеЛисты(ПараметрыОтчета);
	ИспользуемаяСхемаКомпоновкиДанных	= НастройкиСКД["ИспользуемаяСхемаКомпоновкиДанных"];
	НовыйКомпоновщикНастроек			= НастройкиСКД["НовыйКомпоновщикНастроек"];
	
	// Настраиваем схему строк Итого:
	НастройкиСКД_СтрокаИтого	= ПолучитьНастройкиСКД_ИтогиКнигиПродажЗаОтчетныйПериод(ПараметрыОтчета);
	
	// Декларация
	// СегментацияДанныхДекларации
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		УчетНДС.СегментацияДанныхДекларации_ИнициализироватьПараметры(ПараметрыОтчета, "9.1");
	КонецЕсли;
	
	Попытка
		// Выводим результат в дерево:
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(
			ИспользуемаяСхемаКомпоновкиДанных,				// 1
			НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
			,												// 3
			,												// 4
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"),	// 5
			Ложь);	// 6
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		ПроцессорВывода.УстановитьОбъект(РезультатДерево);
		
		УстановитьПривилегированныйРежим(Истина);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
		УстановитьПривилегированныйРежим(Ложь);
		
		ОтсутствуютДопЛисты = (РезультатДерево.Строки.Количество() = 0);
		
		ПараметрыОтчета.Вставить("ОтсутствуютДопЛисты", ОтсутствуютДопЛисты);
		
		Если ОтсутствуютДопЛисты Тогда
			Возврат;
		КонецЕсли;
		
		// По группировкам "Налоговый период":
		Для Каждого СтрокаГруппировки Из РезультатДерево.Строки Цикл
			Если НЕ СтрокаГруппировки["ЭтоГруппировкаНалоговыйПериод"] = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			// Декларация
			Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
				//
				// Раздел 12
				//
				Если СтрокаГруппировки["КоличествоСтрокДляРаздела12"] > 0 Тогда
					ДанныеДляДекларации.Вставить("ЗаполнятьРаздел12", Истина);
				КонецЕсли;
				
				//---
				// Шапка
				//---
				ВывестиЗаголовокПриНеобходимости_Раздел12(ПараметрыОтчета, ДанныеДляДекларации);
			КонецЕсли;
			
			// Получим данные для строки Итого - итоги книги продаж за соответствующий налоговый период:
			СтрокаИтого = ПолучитьСтрокуИтогоИзКнигиПродажЗаНалоговыйПериод(
				НастройкиСКД_СтрокаИтого,
				СтрокаГруппировки["ДатаНачалаПериода"],
				СтрокаГруппировки["ДатаОкончанияПериода"]);
			
			// По группировкам "Дата составления доп.листа":
			НомерЛиста = 0;
			Для Каждого СтрокаГруппировкиДатаСоставления Из СтрокаГруппировки.Строки Цикл
				Если НЕ СтрокаГруппировкиДатаСоставления["ЭтоГруппировкаДатаСоставления"] = Истина Тогда
					Продолжить;
				КонецЕсли;
				
				// Выводим в табличный документ:
				НомерЛиста = НомерЛиста + 1;
				
				ПараметрыДопЛиста = Новый Структура("
					|ДатаНачалаПериода,
					|ДатаОкончанияПериода,
					|ДатаСоставления");
				
				ЗаполнитьЗначенияСвойств(ПараметрыДопЛиста, СтрокаГруппировкиДатаСоставления);
				ПараметрыДопЛиста.Вставить("НомерЛиста", НомерЛиста);
				
				ТабДокумент = ВывестиДопЛист(ПараметрыОтчета, ПараметрыДопЛиста, СтрокаГруппировкиДатаСоставления, СтрокаИтого, ДанныеДляДекларации);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ТабДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				// Строка налогового периода:
				Наименование = ПредставлениеПериода(
					СтрокаГруппировки["ДатаНачалаПериода"],
					СтрокаГруппировки["ДатаОкончанияПериода"],
					"ФП");
				Поиск = Новый Структура("Наименование", Наименование);
				МассивСтрок = ДеревоСформированныхЛистов.Строки.НайтиСтроки(Поиск, Ложь); // ВключатьПодчиненные
				Если МассивСтрок.Количество() > 0 Тогда
					СтрокаНалоговогоПериода = МассивСтрок[0];
				Иначе
					СтрокаНалоговогоПериода = ДеревоСформированныхЛистов.Строки.Добавить();
					СтрокаНалоговогоПериода["Наименование"] = Наименование;
					СтрокаНалоговогоПериода["ПредставлениеНалоговогоПериода"] = Наименование;
				КонецЕсли;
				СтрокаНалоговогоПериода["ИндексСоответствующейСтрокиСписка"] = -1;
				СтрокаНалоговогоПериода["ДатаНачалаПериода"] = СтрокаГруппировки["ДатаНачалаПериода"];
				// Строка доп.листа:
				СтрокаДопЛиста = СтрокаНалоговогоПериода.Строки.Добавить();
				Текст = НСтр("ru='Доп. лист %1'");
				СтрокаДопЛиста["Наименование"] = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					Текст, НомерЛиста);
				СтрокаДопЛиста["Картинка"] = ИспользуемаяКартинкаВДеревеЛистов;
				СтрокаДопЛиста["ИндексСоответствующейСтрокиСписка"] = ИндексСоответствующейСтрокиСписка;
				СтрокаДопЛиста["ПредставлениеНалоговогоПериода"] = Наименование + " (" + НРег(СтрокаДопЛиста["Наименование"]) + ")";
			КонецЦикла;
			
			// Декларация
			// СегментацияДанныхДекларации
			Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
				// Сохраняем итоги всего раздела
				РегламентированнаяОтчетность.ЗаписатьИтогиРазделаДекларацииНДС(
					ПараметрыОтчета.СсылкаНаДекларацию,
					"Раздел9_Прил1",
					ДанныеДляДекларации["ИтогиРаздел91"]);
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
		СообщитьОбОшибке(ИнформацияОбОшибке());
		
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры 

Процедура ДозаполнитьДеревоСформированныхЛистов(ПараметрыОтчета, СписокСформированныхЛистов, ДеревоСформированныхЛистов, УникальныйИдентификаторФормы)
	
	УпорядочитьДеревоСформированныхЛистов(ДеревоСформированныхЛистов);
	
	// Собираем табличные документы всех листов из текущего налогового периода
	// в один новый большой документ:
	Для Каждого СтрокаВерхнегоУровня Из ДеревоСформированныхЛистов.Строки Цикл
		КолвоЛистов = СтрокаВерхнегоУровня.Строки.Количество();
		Если КолвоЛистов = 1 Тогда
			СтрокаВерхнегоУровня["ИндексСоответствующейСтрокиСписка"] = СтрокаВерхнегоУровня.Строки[0]["ИндексСоответствующейСтрокиСписка"];
			
		ИначеЕсли КолвоЛистов > 1 Тогда
			ОбщийТабличныйДокумент = Новый ТабличныйДокумент();
			ЭтоОчереднойЛист = Ложь;
			Для Каждого СтрокаЛиста Из СтрокаВерхнегоУровня.Строки Цикл
				ТабличныйДокументЛиста = СписокСформированныхЛистов.Получить(
					СтрокаЛиста["ИндексСоответствующейСтрокиСписка"]).Значение["ТабличныйДокумент"];
				Если ЭтоОчереднойЛист Тогда
					ОбщийТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				Иначе
					// Это первый лист.
					ЭтоОчереднойЛист = Истина;
					ЗаполнитьЗначенияСвойств(ОбщийТабличныйДокумент, ТабличныйДокументЛиста);
				КонецЕсли;
				ОбщийТабличныйДокумент.Вывести(ТабличныйДокументЛиста);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ОбщийТабличныйДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				СтрокаВерхнегоУровня["ИндексСоответствующейСтрокиСписка"] = ИндексСоответствующейСтрокиСписка;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Размещаем отдельно данные каждого листа в хранилище:
	Для Каждого СтрокаВерхнегоУровня Из ДеревоСформированныхЛистов.Строки Цикл
		СтрокаВерхнегоУровня["АдресХранилищаСДаннымиЛиста"] = ПоместитьВоВременноеХранилище(
			СписокСформированныхЛистов.Получить(СтрокаВерхнегоУровня["ИндексСоответствующейСтрокиСписка"]).Значение,
			УникальныйИдентификаторФормы);
		Для Каждого СтрокаЛиста Из СтрокаВерхнегоУровня.Строки Цикл
			СтрокаЛиста["АдресХранилищаСДаннымиЛиста"] = ПоместитьВоВременноеХранилище(
				СписокСформированныхЛистов.Получить(СтрокаЛиста["ИндексСоответствующейСтрокиСписка"]).Значение,
				УникальныйИдентификаторФормы);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура УпорядочитьДеревоСформированныхЛистов(ДеревоСформированныхЛистов)
	
	ВключатьПодчиненные = Ложь;
	
	// Упорядочиваем по возрастанию даты
	ДеревоСформированныхЛистов.Строки.Сортировать("ДатаНачалаПериода", ВключатьПодчиненные);
	
	// Передвигаем в начало лист с данными одним списком
	Поиск = Новый Структура();
	Поиск.Вставить("ЭтоДанныеОднимСписком", Истина);
	МассивСтрок = ДеревоСформированныхЛистов.Строки.НайтиСтроки(Поиск, ВключатьПодчиненные);
	Для Каждого СтрокаДерева Из МассивСтрок Цикл
		ИндексСтроки = ДеревоСформированныхЛистов.Строки.Индекс(СтрокаДерева);
		ДеревоСформированныхЛистов.Строки.Сдвинуть(ИндексСтроки, -ИндексСтроки);
	КонецЦикла;
	
КонецПроцедуры

Функция ВывестиПустойОсновнойРаздел(ПараметрыОтчета)
	
	ВременныеПараметрыОтчета = Новый Структура(Новый ФиксированнаяСтруктура(ПараметрыОтчета));
	ВременныеПараметрыОтчета.ЗаполнитьДанныеДляДекларации = Ложь;
	
	СтрокаГруппировки = Новый Структура();
	СтрокаГруппировки.Вставить("Строки",				Новый Массив());
	СтрокаГруппировки.Вставить("ДатаНачалаПериода",	ПараметрыОтчета.НачалоПериода);
	СтрокаГруппировки.Вставить("ДатаОкончанияПериода",	ПараметрыОтчета.КонецПериода);
	
	Возврат ВывестиОсновнойРаздел(ВременныеПараметрыОтчета, СтрокаГруппировки);
	
КонецФункции

Функция ВывестиПустойДопЛист(ПараметрыОтчета)
	
	ВременныеПараметрыОтчета = Новый Структура(Новый ФиксированнаяСтруктура(ПараметрыОтчета));
	ВременныеПараметрыОтчета.ЗаполнитьДанныеДляДекларации = Ложь;
	
	ПараметрыДопЛиста = Новый Структура();
	ПараметрыДопЛиста.Вставить("НомерЛиста",			0);
	ПараметрыДопЛиста.Вставить("ДатаНачалаПериода",		ПараметрыОтчета.НачалоПериода);
	ПараметрыДопЛиста.Вставить("ДатаОкончанияПериода",	ПараметрыОтчета.КонецПериода);
	ПараметрыДопЛиста.Вставить("ДатаСоставления",		"");
	
	ВремСтруктура = Новый Структура();
	ВремСтруктура.Вставить("НДС10",			0);
	ВремСтруктура.Вставить("НДС18",			0);
	ВремСтруктура.Вставить("НДС20",			0);
	ВремСтруктура.Вставить("СуммаБезНДС10",	0);
	ВремСтруктура.Вставить("СуммаБезНДС18",	0);
	ВремСтруктура.Вставить("СуммаБезНДС20",	0);
	ВремСтруктура.Вставить("СуммаБН",		0);
	ВремСтруктура.Вставить("Сумма0",		0);
	ВремСтруктура.Вставить("СуммаБезНДС7",	0);
	ВремСтруктура.Вставить("НДС7",			0);
	ВремСтруктура.Вставить("СуммаБезНДС5",	0);
	ВремСтруктура.Вставить("НДС5",			0);
	
	НулевыеИтоги = Новый ФиксированнаяСтруктура(ВремСтруктура);
	
	СтрокаГруппировки = Новый Структура(НулевыеИтоги);
	СтрокаГруппировки.Вставить("Строки", Новый Массив());
	
	СтрокаИтого = Новый Структура(НулевыеИтоги);
	
	ВременнаяСтрокаГруппировки = Новый Структура();
	ВременнаяСтрокаГруппировки.Вставить("Строки",				Новый Массив());
	ВременнаяСтрокаГруппировки.Вставить("ДатаНачалаПериода",	ПараметрыОтчета.НачалоПериода);
	ВременнаяСтрокаГруппировки.Вставить("ДатаОкончанияПериода",	);
	
	Возврат ВывестиДопЛист(ВременныеПараметрыОтчета, ПараметрыДопЛиста, СтрокаГруппировки, СтрокаИтого);
	
КонецФункции

Процедура ДобавитьПустойЛист(ДеревоСформированныхЛистов, ТабДокумент, УникальныйИдентификаторФормы)
	
	СтрокаВерхнегоУровня = ДеревоСформированныхЛистов.Строки.Добавить();
	СтрокаВерхнегоУровня["Наименование"]	= НСтр("ru='поиск не дал результатов'");
	СтрокаВерхнегоУровня["Картинка"]		= БиблиотекаКартинок.Информация;
	СтрокаВерхнегоУровня["ЭтоПустойЛист"]	= Истина;
	СтрокаВерхнегоУровня["ПредставлениеНалоговогоПериода"]	= НСтр("ru='данные отсутствуют'");
	
	ДанныеЛиста = Новый Структура("ТабличныйДокумент", ТабДокумент);
	
	СтрокаВерхнегоУровня["АдресХранилищаСДаннымиЛиста"] = ПоместитьВоВременноеХранилище(
		ДанныеЛиста,
		УникальныйИдентификаторФормы);
		
КонецПроцедуры

Функция ПолучитьСтрокуИтогоИзКнигиПродажЗаНалоговыйПериод(НастройкиСКД_СтрокаИтого, ДатаНачалаПериода, ДатаОкончанияПериода)
	
	РезультатТаблица = Новый ТаблицаЗначений();
	
	ИспользуемаяСхемаКомпоновкиДанных	= НастройкиСКД_СтрокаИтого["ИспользуемаяСхемаКомпоновкиДанных"];
	НовыйКомпоновщикНастроек			= НастройкиСКД_СтрокаИтого["НовыйКомпоновщикНастроек"];
	
	// Устанавливаем параметры:
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаНачалаНалоговогоПериода", ДатаНачалаПериода);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаОкончанияНалоговогоПериода", ДатаОкончанияПериода);
	
	// Выводим результат в таблицу значений:
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		ИспользуемаяСхемаКомпоновкиДанных,				// 1
		НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
		,												// 3
		,												// 4
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"),	// 5
		Ложь);	// 6
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
	ПроцессорВывода.УстановитьОбъект(РезультатТаблица);
	
	УстановитьПривилегированныйРежим(Истина);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	УстановитьПривилегированныйРежим(Ложь);
	
	НулевыеИтоги = НовыйНулевыеИтогиДопЛиста(РезультатТаблица);
	
	ИмяСвойстваРаздел9	= "Раздел9";
	ИмяСвойстваРаздел12	= "Раздел12";
	
	НулевыеИтоги = Новый ФиксированнаяСтруктура(НулевыеИтоги);
	
	СтрокаИтогов = Новый Структура(НулевыеИтоги);
	СтрокаИтогов.Вставить(ИмяСвойстваРаздел9, Новый Структура(НулевыеИтоги));
	СтрокаИтогов.Вставить(ИмяСвойстваРаздел12, Новый Структура(НулевыеИтоги));
	
	Для Каждого СтрокаТаблицы Из РезультатТаблица Цикл
		
		ИмяСвойства = ?(СтрокаТаблицы["ЭтоРаздел12"], ИмяСвойстваРаздел12, ИмяСвойстваРаздел9);
		
		ВремСтруктура = Новый Структура(НулевыеИтоги);
		
		ЗаполнитьЗначенияСвойств(ВремСтруктура, СтрокаТаблицы);
		
		СтрокаИтогов.Вставить(ИмяСвойства, ВремСтруктура);
		
		Для Каждого Элемент Из ВремСтруктура Цикл
			ИмяПоля = Элемент.Ключ;
			Сумма = Элемент.Значение;
			
			СтрокаИтогов[ИмяПоля] = СтрокаИтогов[ИмяПоля] + Сумма;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СтрокаИтогов;
	
КонецФункции

Функция ПолучитьПричиныНалогообложенияНалоговыйАгент()
	
	Список = Новый СписокЗначений;
	Список.Добавить(Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент);
	Список.Добавить(Перечисления.ПричиныНалогообложенияНДС.ПокупкаУНерезидентаНалоговыйАгент);
	Список.Добавить(Перечисления.ПричиныНалогообложенияНДС.РеализацияНалоговыйАгент);
	
	Возврат Список;
	
КонецФункции

Функция ВывестиОсновнойРаздел(ПараметрыОтчета, ГруппировкаНалоговыйПериод, ДанныеДляДекларации = Неопределено)
	
	ДетальныеЗаписи = ГруппировкаНалоговыйПериод.Строки;
	
	// Возвращаемое значение:
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ОсновнойРазделКнигиПродаж";
	
	// Используемый макет:
	Макет = ПолучитьИспользуемыйМакет(ПараметрыОтчета);
	
	//---
	// Заголовок
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",			ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("ДатаНачалаПериода",		ГруппировкаНалоговыйПериод["ДатаНачалаПериода"]);
	ПараметрыОбласти.Вставить("ДатаОкончанияПериода",	ГруппировкаНалоговыйПериод["ДатаОкончанияПериода"]);
	ПараметрыОбласти.Вставить("ВыводитьОтбор",			ПараметрыОтчета["ВыводитьОтбор"]);
	ПараметрыОбласти.Вставить("Отбор",					Строка(ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор));
	ВывестиЗаголовок_ОсновнойРаздел(ТабДокумент, ПараметрыОбласти, Макет);	
	
	// Декларация
	// СегментацияДанныхДекларации
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		//
		// Разделы 9, 9.1
		//
		УчетНДС.СегментацияДанныхДекларации_НастроитьСтатистикуПередВыводомТаблицы(
			"9",
			ТабДокумент,
			ДетальныеЗаписи.Количество(),
			ПараметрыОтчета);
	КонецЕсли;
	
	//---
	// Шапка таблицы
	//---
	ВывестиШапкуТаблицы(ПараметрыОтчета, ТабДокумент, Макет, "ОсновнойРаздел");
	
	//---
	// Строки таблицы
	//---
	ВывестиТаблицу(ПараметрыОтчета, ТабДокумент, Макет, ДетальныеЗаписи, Истина, , ДанныеДляДекларации);
	
	//---
	// Всего
	//---
	ОбластьВсего = Макет.ПолучитьОбласть("Всего");
	
	// Декларация
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		
		ИтогиРаздел9Детальные = ПолучитьИтогиРаздел9Детальные(ГруппировкаНалоговыйПериод, ДанныеДляДекларации, ПараметрыОтчета);
		
		ОбластьВсего.Параметры.Заполнить(ИтогиРаздел9Детальные);
		
		ТабДокумент.Вывести(ОбластьВсего);
		
		//
		// Разделы 9, 9.1
		//
		
		ЗаполнитьИтогиРаздел9(ИтогиРаздел9Детальные, ДанныеДляДекларации, ПараметрыОтчета);
		
		// СегментацияДанныхДекларации
		// Записываем текущий сегмент, обновляем статистику
		УчетНДС.СегментацияДанныхДекларации_ЗаписатьТекущийСегмент(
			"9",	// ОбозначениеРаздела
			ТабДокумент,
			ПолучитьИспользуемыйМакет(ПараметрыОтчета),
			ПараметрыОтчета,
			ДанныеДляДекларации,
			Истина);	// ЗакончиласьТаблица
	Иначе
		
		ОбластьВсего.Параметры.Заполнить(ГруппировкаНалоговыйПериод);
		ТабДокумент.Вывести(ОбластьВсего);
	КонецЕсли;
	
	//---
	// Подвал
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",	ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("Дата",			ГруппировкаНалоговыйПериод["ДатаОкончанияПериода"]);
	ВывестиПодвал(ТабДокумент, ПараметрыОбласти, Макет);
	
	// Колонтитулы:
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(ТабДокумент,
		ПараметрыОтчета["Колонтитулы_НаименованиеОтчета"],
		ПараметрыОтчета["Колонтитулы_ТекущийПользователь"],
		ПараметрыОтчета["Организация"]);
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ВывестиДопЛист(ПараметрыОтчета, ПараметрыДопЛиста, СтрокаГруппировкиДатаСоставления, СтрокаИтого, ДанныеДляДекларации = Неопределено)
	
	ДетальныеЗаписи = СтрокаГруппировкиДатаСоставления.Строки;
	
	// Возвращаемое значение:
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ДополнительныйЛистКнигиПродаж";
	
	// Используемый макет:
	Макет = ПолучитьИспользуемыйМакет(ПараметрыОтчета);
	
	// Используемые области:
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("ЗаголовокДопЛист");
	ОбластьИтого		= Макет.ПолучитьОбласть("ИтогоДопЛист");
	ОбластьВсего		= Макет.ПолучитьОбласть("Всего");
	
	//---
	// Заголовок
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("НомерЛиста",				ПараметрыДопЛиста["НомерЛиста"]);
	ПараметрыОбласти.Вставить("Организация",			ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("ДатаНачалаПериода",		ПараметрыДопЛиста["ДатаНачалаПериода"]);
	ПараметрыОбласти.Вставить("ДатаОкончанияПериода",	ПараметрыДопЛиста["ДатаОкончанияПериода"]);
	ПараметрыОбласти.Вставить("ДатаСоставления",		ПараметрыДопЛиста["ДатаСоставления"]);
	ПараметрыОбласти.Вставить("ВыводитьОтбор",			ПараметрыОтчета["ВыводитьОтбор"]);
	ПараметрыОбласти.Вставить("Отбор",					ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	ВывестиЗаголовок_ДопЛист(ТабДокумент, ПараметрыОбласти, Макет);	
	
	//---
	// Шапка таблицы
	//---
	ВывестиШапкуТаблицы(ПараметрыОтчета, ТабДокумент, Макет, "ДопЛист");
	
	//---
	// Строка Итого
	//---
	
	// Декларация
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		СтруктураИтого = СтрокаИтого.Раздел9;
	Иначе
		СтруктураИтого = СтрокаИтого;
	КонецЕсли;
	
	ОбластьИтого.Параметры.Заполнить(СтруктураИтого);
	ТабДокумент.Вывести(ОбластьИтого);
	
	// Декларация
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		
		ОчиститьИтогиРаздел12ДетальныеДатаСоставленияДопЛиста(ДанныеДляДекларации);
		
		//
		// Разделы 9, 9.1
		//
		ЭтоПервыйДопЛист = Не ЕстьЗаполненныйЭлементСтруктуры(ДанныеДляДекларации["ИтогиРаздел91"]);
		Если ЭтоПервыйДопЛист Тогда
			
			ЗаполнитьСтрокиИтогоВсегоРаздел91(СтруктураИтого, ДанныеДляДекларации, ПараметрыОтчета);
			
		КонецЕсли;
		
		// СегментацияДанныхДекларации
		УчетНДС.СегментацияДанныхДекларации_НастроитьСтатистикуПередВыводомТаблицы(
			"9.1",
			ТабДокумент,
			ДетальныеЗаписи.Количество(),
			ПараметрыОтчета);
	КонецЕсли;
	
	//---
	// Строки таблицы
	//---
	ВывестиТаблицу(ПараметрыОтчета, ТабДокумент, Макет, ДетальныеЗаписи, Ложь, , ДанныеДляДекларации);
	
	//---
	// Всего
	//---
	
	// Декларация
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		ИтогоЗаДень = ПолучитьИтогоЗаДеньРаздел91(СтрокаГруппировкиДатаСоставления, ДанныеДляДекларации);
	Иначе
		ИтогоЗаДень = СтрокаГруппировкиДатаСоставления;
	КонецЕсли;
	
	СтруктураВсего = РассчитатьСтрокуВсегоДопЛиста(СтруктураИтого, ИтогоЗаДень, ПараметрыОтчета);
	
	ОбластьВсего.Параметры.Заполнить(СтруктураВсего);
	
	ТабДокумент.Вывести(ОбластьВсего);
	
	// Вычисляем строку Итого для следующего доп.листа
	ЗаполнитьЗначенияСвойств(СтруктураИтого, СтруктураВсего);
	
	// Декларация
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		//
		// Разделы 9, 9.1
		//
		
		ЗаполнитьСтрокуВсегоРаздел91(ДанныеДляДекларации, ИтогоЗаДень, ПараметрыОтчета);
		
		// СегментацияДанныхДекларации
		// Записываем текущий сегмент, обновляем статистику
		УчетНДС.СегментацияДанныхДекларации_ЗаписатьТекущийСегмент(
			"9.1",	// ОбозначениеРаздела
			ТабДокумент,
			ПолучитьИспользуемыйМакет(ПараметрыОтчета),
			ПараметрыОтчета,
			ДанныеДляДекларации,
			Истина);	// ЗакончиласьТаблица
	КонецЕсли;
	
	//---
	// Подвал
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",	ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("Дата",			ПараметрыДопЛиста["ДатаОкончанияПериода"]);
	ВывестиПодвал(ТабДокумент, ПараметрыОбласти, Макет);
	
	// Колонтитулы:
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(ТабДокумент,
		ПараметрыОтчета["Колонтитулы_НаименованиеОтчета"],
		ПараметрыОтчета["Колонтитулы_ТекущийПользователь"],
		ПараметрыОтчета["Организация"]);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиЗаголовок_ОсновнойРаздел(ЗаполняемыйТабличныйДокумент, ПараметрыОбласти, ИспользуемыйМакет)
	
	ОбластьЗаголовок = ИспользуемыйМакет.ПолучитьОбласть("Заголовок");
	
	ЗначенияПараметров = Новый Структура();
	Если ЗначениеЗаполнено(ПараметрыОбласти["Организация"]) тогда
		РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОбласти["Организация"],
			"НаименованиеПолное, НаименованиеСокращенное, Наименование, ИНН, КПП");
		НаименованиеПолное		= РеквизитыОрганизации["НаименованиеПолное"];
		НаименованиеСокращенное	= РеквизитыОрганизации["НаименованиеСокращенное"];
		Наименование			= РеквизитыОрганизации["Наименование"];
		Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
			Параметр_Продавец = НаименованиеПолное;
		ИначеЕсли ЗначениеЗаполнено(НаименованиеСокращенное) Тогда
			Параметр_Продавец = НаименованиеСокращенное;
		Иначе
			Параметр_Продавец = Наименование;
		КонецЕсли;
		ЗначенияПараметров.Вставить("Продавец",		Параметр_Продавец);
		ЗначенияПараметров.Вставить("ИННПродавца",	РеквизитыОрганизации["ИНН"]);
		ЗначенияПараметров.Вставить("КПППродавца",	РеквизитыОрганизации["КПП"]);
	КонецЕсли;
	ЗначенияПараметров.Вставить("НачалоПериода",	Формат(ПараметрыОбласти["ДатаНачалаПериода"], "ДФ=dd.MM.yyyy"));
	ЗначенияПараметров.Вставить("КонецПериода",		Формат(ПараметрыОбласти["ДатаОкончанияПериода"], "ДФ=dd.MM.yyyy"));
	
	// Отбор
	Если ПараметрыОбласти["ВыводитьОтбор"] Тогда
		Отбор = ПараметрыОбласти["Отбор"];
		Если ПустаяСтрока(Отбор) Тогда
			Отбор = НСтр("ru='(отбор не установлен)'");
		КонецЕсли;
		ЗначенияПараметров.Вставить("Отбор", Отбор); 
	КонецЕсли;
	
	// Выводим область
	ОбластьЗаголовок.Параметры.Заполнить(ЗначенияПараметров);
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
КонецПроцедуры

Процедура ВывестиЗаголовок_ДопЛист(ЗаполняемыйТабличныйДокумент, ПараметрыОбласти, ИспользуемыйМакет)
	
	ОбластьЗаголовок = ИспользуемыйМакет.ПолучитьОбласть("ЗаголовокДопЛист");
	
	ЗначенияПараметров = Новый Структура();
	
	ЗначенияПараметров.Вставить("НомерЛиста",		ПараметрыОбласти["НомерЛиста"]);
	
	Если ЗначениеЗаполнено(ПараметрыОбласти["Организация"]) тогда
		РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОбласти["Организация"],
			"НаименованиеПолное, НаименованиеСокращенное, Наименование, ИНН, КПП");
		НаименованиеПолное		= РеквизитыОрганизации["НаименованиеПолное"];
		НаименованиеСокращенное	= РеквизитыОрганизации["НаименованиеСокращенное"];
		Наименование			= РеквизитыОрганизации["Наименование"];
		Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
			Параметр_Продавец = НаименованиеПолное;
		ИначеЕсли ЗначениеЗаполнено(НаименованиеСокращенное) Тогда
			Параметр_Продавец = НаименованиеСокращенное;
		Иначе
			Параметр_Продавец = Наименование;
		КонецЕсли;
		ЗначенияПараметров.Вставить("Продавец",		Параметр_Продавец);
		ЗначенияПараметров.Вставить("ИННПродавца",	РеквизитыОрганизации["ИНН"]);
		ЗначенияПараметров.Вставить("КПППродавца",	РеквизитыОрганизации["КПП"]);
	КонецЕсли;
	ЗначенияПараметров.Вставить("НалоговыйПериод",	ПредставлениеПериода(ПараметрыОбласти["ДатаНачалаПериода"], ПараметрыОбласти["ДатаОкончанияПериода"], "ФП"));
	ЗначенияПараметров.Вставить("ДатаСоставления",	Формат(ПараметрыОбласти["ДатаСоставления"], "ДФ=dd.MM.yyyy"));
	
	// Отбор
	Если ПараметрыОбласти["ВыводитьОтбор"] Тогда
		Отбор = ПараметрыОбласти["Отбор"];
		Если ПустаяСтрока(Отбор) Тогда
			Отбор = НСтр("ru='(отбор не установлен)'");
		КонецЕсли;
		ЗначенияПараметров.Вставить("Отбор", Отбор); 
	КонецЕсли;
	
	// Выводим область
	ОбластьЗаголовок.Параметры.Заполнить(ЗначенияПараметров);
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
КонецПроцедуры

Процедура ВывестиЗаголовокПриНеобходимости_Раздел12(ПараметрыОтчета, ДанныеДляДекларации)
	
	ТабДокСоздан = ДанныеДляДекларации.Свойство("ТабДокРаздел12");
	
	Если НЕ ТабДокСоздан Тогда
		ИнициализироватьТабличныйДокумент_Раздел12(ПараметрыОтчета, ДанныеДляДекларации);
		
		//---
		// Шапка
		//---
		ОбластьШапка = ДанныеДляДекларации["МакетРаздел12"].ПолучитьОбласть("Шапка");
		ДанныеДляДекларации["ТабДокРаздел12"].Вывести(ОбластьШапка);
		
		// СегментацияДанныхДекларации
		Если ДанныеДляДекларации["ЗаполнятьРаздел12"] Тогда
			УчетНДС.СегментацияДанныхДекларации_НастроитьСтатистикуПередВыводомТаблицы(
				"12",
				ДанныеДляДекларации["ТабДокРаздел12"],
				0, // здесь общее количество строк не используем, т.к. итоги по разделу не выводятся, и отслеживать последнюю строку таблицы нет необходимости
				ПараметрыОтчета);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиШапкуТаблицы(ПараметрыОтчета, ТабДокумент, Макет, ВыводимаяТаблица)
	
	Если ВыводимаяТаблица = "ДопЛист" Тогда
		
		ОбластьШапкаПолная = Макет.ПолучитьОбласть("ШапкаПолнаяДопЛист");
		
		ОбластьШапкаСокращенная = Макет.ПолучитьОбласть("ШапкаСокращеннаяДопЛист");
		
	Иначе
		
		ОбластьШапкаПолная = Макет.ПолучитьОбласть("ШапкаПолная");
		
		ОбластьШапкаСокращенная = Макет.ПолучитьОбласть("ШапкаСокращенная");
		
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьШапкаПолная);
	
	// Декларация
	Если НЕ ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		
		ПовторятьПолнуюШапку = ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет, "ПовторятьПолнуюШапку");
		
		ПовторятьСокращеннуюШапку = ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет, "ПовторятьСокращеннуюШапку");
		
		КоличествоСтрокПовтора = 0;
		
		Если ПовторятьПолнуюШапку Тогда
			
			КоличествоСтрокПовтора = ОбластьШапкаПолная.ВысотаТаблицы;
			
		ИначеЕсли ПовторятьСокращеннуюШапку Тогда
			
			КоличествоСтрокПовтора = ОбластьШапкаСокращенная.ВысотаТаблицы;
			
		КонецЕсли;
		
		Если КоличествоСтрокПовтора > 0 Тогда
			
			НомерНачальнойСтроки = ТабДокумент.ВысотаТаблицы - КоличествоСтрокПовтора + 1;
			
			ОбластьПовтора = ТабДокумент.Область(
				НомерНачальнойСтроки,
				,
				НомерНачальнойСтроки + КоличествоСтрокПовтора - 1);
				
			ТабДокумент.ПовторятьПриПечатиСтроки = ОбластьПовтора;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиТаблицу(ПараметрыОтчета, ЗаполняемыйТабличныйДокумент, ИспользуемыйМакет, ДетальныеЗаписи, ЭтоОсновнойРаздел, НППСтроки = Неопределено, ДанныеДляДекларации = Неопределено)
	
	// Декларация
	// СегментацияДанныхДекларации
	Перем	ОбозначениеРазделаКнига,
			СегментацияДанныхРазделаКнига,
			ТаблицаДанныхКнига,
			СегментацияДанныхРаздел12,
			ТаблицаДанныхРаздел12,
			НППСтрокиРаздел12;
	
	Перем	ВремТабДок,
			ОчищающаяСтруктураПоказателиПрослеживаемости;
	
	ВремТабДок = Новый ТабличныйДокумент();
	
	ОчищающаяСтруктураПоказателиПрослеживаемости = Новый Структура("
		|РНПТ,
		|КоличествоПрослеживаемости,
		|СтоимостьПрослеживаемости,
		|ЕдиницаИзмеренияПрослежКод");
	
	СимволПрочерка = "---";
	
	ВалютаРУ				= Константы.ВалютаРегламентированногоУчета.Получить();
	СвойстваВалютыРУ		= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВалютаРУ, "Код,Наименование");
	ВалютаРУКод				= СвойстваВалютыРУ["Код"];
	ВалютаРУНаименование	= СвойстваВалютыРУ["Наименование"];
	
	Если НППСтроки = Неопределено Тогда
		НППСтроки = 0;
	КонецЕсли;
	
	ПараметрыДобавленияСтроки = НовыйПараметрыДобавленияСтрокиВРазделДекларацииПоНДС();
	ПараметрыДобавленияСтроки.СимволПрочерка = СимволПрочерка;
	
	// Декларация
	// СегментацияДанныхДекларации
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		//
		// Разделы 9, 9.1
		//
		ОбозначениеРазделаКнига = ?(ЭтоОсновнойРаздел,
			"9",	// Основной раздел
			"9.1");	// Дополнительный лист
		ОписаниеРаздела					= УчетНДС.СегментацияДанныхДекларации_ПолучитьОписаниеРаздела(ОбозначениеРазделаКнига);
		ИмяРаздела						= ОписаниеРаздела["ИмяВРегламентированнойОтчетности"];
		СегментацияДанныхРазделаКнига	= ПараметрыОтчета["СегментацияДанныхДекларации"][ИмяРаздела];
		ИмяТаблицыДанных				= ОписаниеРаздела["ИмяТаблицыДанных"];
		ТаблицаДанныхКнига				= ДанныеДляДекларации[ИмяТаблицыДанных];
		
		//
		// Раздел 12
		//
		ОписаниеРаздела				= УчетНДС.СегментацияДанныхДекларации_ПолучитьОписаниеРаздела("12");
		ИмяРаздела					= ОписаниеРаздела["ИмяВРегламентированнойОтчетности"];
		СегментацияДанныхРаздел12	= ПараметрыОтчета["СегментацияДанныхДекларации"][ИмяРаздела];
		ИмяТаблицыДанных			= ОписаниеРаздела["ИмяТаблицыДанных"];
		ТаблицаДанныхРаздел12				= ДанныеДляДекларации[ИмяТаблицыДанных];
		Если НЕ ДанныеДляДекларации.Свойство("НППСтрокиРаздел12", НППСтрокиРаздел12) Тогда
			НППСтрокиРаздел12 = 0;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ДетальнаяЗапись Из ДетальныеЗаписи Цикл
		Если ДетальнаяЗапись["ЭтоГруппировкаКонтрагент"] = Истина Тогда
			//---
			// Итого по контрагенту
			//---
			ОбластьКонтрагент = ИспользуемыйМакет.ПолучитьОбласть("Контрагент");
			ЗначенияПараметров = Новый Структура("КонтрагентПредставление", ДетальнаяЗапись["КонтрагентПредставление"]);
			ОбластьКонтрагент.Параметры.Заполнить(ДетальнаяЗапись);
			ОбластьКонтрагент.Параметры.Заполнить(ЗначенияПараметров);
			ЗаполняемыйТабличныйДокумент.Вывести(ОбластьКонтрагент);
			
			//---
			// Детальные строки
			//---
			ВывестиТаблицу(ПараметрыОтчета, ЗаполняемыйТабличныйДокумент, ИспользуемыйМакет, ДетальнаяЗапись.Строки, ЭтоОсновнойРаздел, НППСтроки, ДанныеДляДекларации);
			
		Иначе
			//---
			// Детальная строка
			//---
			
			Если ДетальнаяЗапись["КодВидаОперации"] = "27" Тогда
				Параметр_ПокупательПредставление	= "";
				Параметр_ПокупательИНН				= "";
				Параметр_ПокупательКПП				= "";
				Параметр_ПокупательСсылка			= "";
				ПокупательЯвляетсяФизЛицом			= "";
			Иначе
				Покупатель = УчетНДС.ОпределитьПокупателя(ДетальнаяЗапись)["Покупатель"];
				Параметр_ПокупательПредставление	= Покупатель["Наименование"];
				Параметр_ПокупательИНН				= Покупатель["ИНН"];
				Параметр_ПокупательКПП				= Покупатель["КПП"];
				Параметр_ПокупательСсылка			= Покупатель["Ссылка"];
				ПокупательЯвляетсяФизЛицом			= Покупатель["ЯвляетсяФизЛицом"];
			КонецЕсли;
			
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДетальнаяЗапись, "Посредник") Тогда
				Параметр_ПосредникНаименование	= ДетальнаяЗапись["Посредник"];
				Параметр_ПосредникИНН	= ДетальнаяЗапись["ПосредникИНН"];
				Параметр_ПосредникКПП	= ДетальнаяЗапись["ПосредникКПП"];
			Иначе
				Параметр_ПосредникНаименование	= "";
				Параметр_ПосредникИНН	= "";
				Параметр_ПосредникКПП	= "";
			КонецЕсли;
			
			СтруктураНомерСФ = УчетНДС.ОпределитьНомерСФДляВыводаВРегистрыУчета(ДетальнаяЗапись);
			
			// 3
			Параметр_ДатаНомер = УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
				СтруктураНомерСФ["Номер"], ДетальнаяЗапись["Дата"]);
			ПредставлениеПричиныНалогообложения = ПараметрыОтчета["ПредставленияПричинНалогообложения"].Получить(ДетальнаяЗапись["ПричинаНалогообложения"]);
			Если ЗначениеЗаполнено(ПредставлениеПричиныНалогообложения) Тогда
				Параметр_ДатаНомер = Параметр_ДатаНомер + " " + ПредставлениеПричиныНалогообложения;
			КонецЕсли;
			
			// 8
			Если ЗначениеЗаполнено(Параметр_ПокупательИНН) ИЛИ ЗначениеЗаполнено(Параметр_ПокупательКПП) Тогда
				Параметр_ПокупательИННКПП = Строка(Параметр_ПокупательИНН) + " / " + Строка(Параметр_ПокупательКПП);
			Иначе
				Параметр_ПокупательИННКПП = "";
			КонецЕсли;
			
			// 9
			Если ЗначениеЗаполнено(Параметр_ПосредникИНН) ИЛИ ЗначениеЗаполнено(Параметр_ПосредникКПП) Тогда
				Параметр_ПосредникИННКПП = Строка(Параметр_ПосредникИНН) + " / " + Строка(Параметр_ПосредникКПП);
			Иначе
				Параметр_ПосредникИННКПП = "";
			КонецЕсли;
			
			// 12
			Параметр_ВалютаПредставление = ?(ДетальнаяЗапись["УказанаИностраннаяВалюта"],
				ДетальнаяЗапись["ВалютаНаименование"] + ", " + ДетальнаяЗапись["ВалютаКод"],
				"");
			
			//---
			// Декларация
			//---
			Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
				ДобавитьСтрокуВРаздел12 = ДетальнаяЗапись["ЭтоРаздел12"];
				
				ДобавитьСтрокуВРаздел9 = НЕ ДобавитьСтрокуВРаздел12;
				
				ДобавитьСтрокуВТабличныйДокумент = ДобавитьСтрокуВРаздел9;
			Иначе
				ДобавитьСтрокуВТабличныйДокумент = Истина;
			КонецЕсли;
			
			Если ДобавитьСтрокуВТабличныйДокумент Тогда
				НППСтроки = НППСтроки + 1;
				
				ОбластьСтрока = ИспользуемыйМакет.ПолучитьОбласть("Строка");
				
				ЗначенияПараметров = Новый Структура();
				
				// 1
				ЗначенияПараметров.Вставить("НПП", НППСтроки);
				
				// 3
				ЗначенияПараметров.Вставить("ДатаНомер", Параметр_ДатаНомер);
				
				// 4
				ЗначенияПараметров.Вставить("НомерДатаИсправления",
					УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
						ДетальнаяЗапись["НомерИсправления"], ДетальнаяЗапись["ДатаИсправления"]));
				
				// 5
				ЗначенияПараметров.Вставить("НомерДатаКСФ",
					УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
						СтруктураНомерСФ["НомерКСФ"], ДетальнаяЗапись["ДатаКСФ"]));
				
				// 6
				ЗначенияПараметров.Вставить("НомерДатаИсправленияКСФ",
					УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
						ДетальнаяЗапись["НомерИсправленияКСФ"], ДетальнаяЗапись["ДатаИсправленияКСФ"]));
				
				// 7
				ЗначенияПараметров.Вставить("ПокупательПредставление",	Параметр_ПокупательПредставление);
				ЗначенияПараметров.Вставить("ПокупательСсылка",			Параметр_ПокупательСсылка);
				
				// 8
				ЗначенияПараметров.Вставить("ПокупательИННКПП", Параметр_ПокупательИННКПП);
				
				//9
				ЗначенияПараметров.Вставить("ПосредникНаименование", Параметр_ПосредникНаименование);
				//10
				ЗначенияПараметров.Вставить("ПосредникИННКПП", Параметр_ПосредникИННКПП);
				
				// 11
				ЗначенияПараметров.Вставить("НомерДатаДокументаОплаты", СформироватьСодержимоеГрафы11(ДетальнаяЗапись, "Текст"));
				
				// 11а
				Если ПараметрыОтчета.ПостановлениемПредусмотренПоказательСчетаФактурыНаАванс Тогда
					ЗаполнитьПараметрыГрафы11а(ЗначенияПараметров, ДетальнаяЗапись);
				КонецЕсли;
				
				// 12
				ЗначенияПараметров.Вставить("ВалютаПредставление", Параметр_ВалютаПредставление);
				
				// 13а, 13б
				ЗначенияПараметров.Вставить("ВсегоВалютная",	ДетальнаяЗапись["ВсегоПоСчетуФактуреВал"]);
				ЗначенияПараметров.Вставить("Всего",			ДетальнаяЗапись["ВсегоПоСчетуФактуреРуб"]);
				
				// 14
				Если ДетальнаяЗапись["ЭтоШкурыЛом"] Тогда
					ЗаполнитьПараметрыГрафШкурыЛом(ЗначенияПараметров, ДетальнаяЗапись, ПараметрыОтчета, СимволПрочерка);
				КонецЕсли;
				
				ОбластьСтрока.Параметры.Заполнить(ДетальнаяЗапись);
				ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
				
				Если ПараметрыОтчета.ПостановлениемПредусмотреныПоказателиПрослеживаемости
					И ДетальнаяЗапись["ТаблицаПоказателиПрослеживаемости"] <> Null Тогда
					
					Для Каждого СтрокаТаблицы Из ДетальнаяЗапись["ТаблицаПоказателиПрослеживаемости"] Цикл
						СтрокаТаблицы.РНПТ = СокрЛП(СтрокаТаблицы.РНПТ);
						ОбластьСтрока.Параметры.Заполнить(СтрокаТаблицы);
						
						ВремТабДок.Вывести(ОбластьСтрока);
						
						ОбластьСтрока.Параметры.Заполнить(ОчищающаяСтруктураПоказателиПрослеживаемости);
					КонецЦикла;
					
					УчетНДС.ОбъединитьЯчейкиПоВысоте(ВремТабДок, 1, 23);
					
					ЗаполняемыйТабличныйДокумент.Вывести(ВремТабДок);
					
					ВремТабДок.Очистить();
				Иначе
					ЗаполняемыйТабличныйДокумент.Вывести(ОбластьСтрока);
				КонецЕсли;
			КонецЕсли;
			
			//---
			// Декларация
			//---
			Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
				ПараметрыДобавленияСтроки.СтруктураНомерСФ					= СтруктураНомерСФ;
				ПараметрыДобавленияСтроки.Параметр_ПокупательИНН			= Параметр_ПокупательИНН;
				ПараметрыДобавленияСтроки.Параметр_ПокупательКПП			= Параметр_ПокупательКПП;
				ПараметрыДобавленияСтроки.Параметр_ПокупательСсылка			= Параметр_ПокупательСсылка;
				ПараметрыДобавленияСтроки.Параметр_ПокупательПредставление	= Параметр_ПокупательПредставление;
				ПараметрыДобавленияСтроки.ЭтоОсновнойРаздел					= ЭтоОсновнойРаздел;
				ПараметрыДобавленияСтроки.ПокупательЯвляетсяФизЛицом		= ПокупательЯвляетсяФизЛицом;
				ПараметрыДобавленияСтроки.Параметр_ПокупательИННКПП			= Параметр_ПокупательИННКПП;
				
				//
				// Разделы 9, 9.1
				//
				Если ДобавитьСтрокуВРаздел9 Тогда
					ДобавитьСтрокуВРаздел9ДекларацииПоНДС(ТаблицаДанныхКнига, ДетальнаяЗапись, НППСтроки, ПараметрыДобавленияСтроки, ПараметрыОтчета);
					
					// СегментацияДанныхДекларации
					УчетНДС.СегментацияДанныхДекларации_НастроитьСтатистикуПослеДобавленияСтрокиТаблицы(СегментацияДанныхРазделаКнига, ПараметрыОтчета);
					
					Если УчетНДС.СегментацияДанныхДекларации_СегментДостигПредельногоРазмера(СегментацияДанныхРазделаКнига, ПараметрыОтчета) Тогда
						Если УчетНДС.СегментацияДанныхДекларации_ЭтоПоследняяСтрокаТаблицы(СегментацияДанныхРазделаКнига, ПараметрыОтчета) Тогда
							// Не отрываем Итоги от всей таблицы.
							// Текущий сегмент запишем позже, после добавления Итогов.
						Иначе
							// Записываем текущий сегмент, обновляем статистику
							УчетНДС.СегментацияДанныхДекларации_ЗаписатьТекущийСегмент(
								ОбозначениеРазделаКнига,
								ЗаполняемыйТабличныйДокумент,
								ИспользуемыйМакет,
								ПараметрыОтчета,
								ДанныеДляДекларации,
								Ложь);		// ЗакончиласьТаблица
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				//
				// Раздел 12
				//
				Если ДобавитьСтрокуВРаздел12 Тогда
					ДобавитьСтрокуВРаздел12ДекларацииПоНДС(ДетальнаяЗапись, НППСтрокиРаздел12, ПараметрыДобавленияСтроки, ПараметрыОтчета, ДанныеДляДекларации);
					
					// СегментацияДанныхДекларации
					УчетНДС.СегментацияДанныхДекларации_НастроитьСтатистикуПослеДобавленияСтрокиТаблицы(СегментацияДанныхРаздел12, ПараметрыОтчета);
					
					Если УчетНДС.СегментацияДанныхДекларации_СегментДостигПредельногоРазмера(СегментацияДанныхРаздел12, ПараметрыОтчета) Тогда
						// Записываем текущий сегмент, обновляем статистику
						УчетНДС.СегментацияДанныхДекларации_ЗаписатьТекущийСегмент(
							"12",
							ДанныеДляДекларации.ТабДокРаздел12,
							ДанныеДляДекларации.МакетРаздел12,
							ПараметрыОтчета,
							ДанныеДляДекларации,
							Ложь);		// ЗакончиласьТаблица
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Декларация
	//
	// Раздел 12
	//
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		ДанныеДляДекларации.Вставить("НППСтрокиРаздел12", НППСтрокиРаздел12);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыГрафШкурыЛом(ЗначенияПараметров, ДетальнаяЗапись, ПараметрыОтчета, СимволПрочерка)
	
	// Прочерк выводится в колонке налога по самой большой ставке, предусмотренной редакцией постановления.
	
	Если ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026" Тогда
		ПолеНалога = "НДС22";
		
	ИначеЕсли ПараметрыОтчета.РедакцияПостановления = "№ 981 от 19.08.2017"
		Или ПараметрыОтчета.РедакцияПостановления = "№ 735 от 30.07.2014" Тогда
		
		ПолеНалога = "НДС18";
		
	Иначе
		ПолеНалога = "НДС20";
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("Всего",	СимволПрочерка);
	ЗначенияПараметров.Вставить(ПолеНалога,	СимволПрочерка);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыГрафы11а(ЗначенияПараметров, ДетальнаяЗапись)
	
	ТаблицаСчетаФактурыНаАванс = ДетальнаяЗапись.ТаблицаСчетаФактурыНаАванс;
	
	Если ТаблицаСчетаФактурыНаАванс = Null Тогда
		СчетФактураНаАванс = "";
	Иначе
		СчетФактураНаАванс = УчетНДС.ПолучитьПредставлениеГрафы11аКнигиПродаж(ТаблицаСчетаФактурыНаАванс);
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("СчетФактураНаАванс", СчетФактураНаАванс);
	
КонецПроцедуры

Функция НовыйНулевыеИтогиДопЛиста(РезультатТаблица)
	
	НулевыеИтоги = Новый Структура();
	НулевыеИтоги.Вставить("СуммаБН", 0);
	НулевыеИтоги.Вставить("Сумма0", 0);
	
	Для Каждого Колонка Из РезультатТаблица.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		
		Если СтрНачинаетсяС(ИмяКолонки, "НДС") Или СтрНачинаетсяС(ИмяКолонки, "СуммаБезНДС") Тогда
			НулевыеИтоги.Вставить(ИмяКолонки, 0);
		КонецЕсли;
	КонецЦикла;
	
	Возврат НулевыеИтоги;
	
КонецФункции

Функция РассчитатьСтрокуВсегоДопЛиста(СтруктураИтого, ИтогоЗаДень, ПараметрыОтчета)
	
	// Всего = Итого + ЗаДень.
	
	СтруктураВсего = Новый Структура();
	
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		Для Каждого Элемент Из ИтогоЗаДень Цикл
			ИмяПоля = Элемент.Ключ;
			
			ЗначениеПоляЗаДень = Элемент.Значение;
			
			ЗначениеПоляИтого = СтруктураИтого[ИмяПоля];
			
			СтруктураВсего.Вставить(ИмяПоля, ЗначениеПоляИтого + ЗначениеПоляЗаДень);
		КонецЦикла;
	Иначе
		Для Каждого Элемент Из СтруктураИтого Цикл
			ИмяПоля = Элемент.Ключ;
			ЗначениеПоля = Элемент.Значение;
			
			Если ТипЗнч(ЗначениеПоля) <> Тип("Число") Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураВсего.Вставить(ИмяПоля, СтруктураИтого[ИмяПоля] + ИтогоЗаДень[ИмяПоля]);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтруктураВсего;
	
КонецФункции

Процедура ВывестиПодвал(ЗаполняемыйТабличныйДокумент, ПараметрыОбласти, ИспользуемыйМакет)
	
	ОбластьПодвал = ИспользуемыйМакет.ПолучитьОбласть("Подвал");
	
	ЗначенияПараметров = Новый Структура();
	Если ЗначениеЗаполнено(ПараметрыОбласти["Организация"]) Тогда
		ОтветственныеЛица = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
			ПараметрыОбласти["Организация"],
			ПараметрыОбласти["Дата"]);
		
		ЗначенияПараметров.Вставить("РуководительФИО", Справочники.Сотрудники.ФамилияИО(
			ОтветственныеЛица["ОтветственноеЛицоСсылка"],, ПараметрыОбласти["Дата"]));
	КонецЕсли;
	
	// Выводим область
	ОбластьПодвал.Параметры.Заполнить(ЗначенияПараметров);
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры

Функция ВывестиВсеОсновныеРазделыОднимСписком(ПараметрыОтчета, ГруппировкаОднимСписком)
	
	ДетальныеЗаписи = ГруппировкаОднимСписком.Строки;
	
	// Возвращаемое значение:
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ОсновнойРазделКнигиПродаж";
	
	// Используемый макет:
	Макет = ПолучитьИспользуемыйМакет(ПараметрыОтчета);
	
	//---
	// Заголовок
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",			ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("ДатаНачалаПериода",		ПараметрыОтчета["НачалоПериода"]);
	ПараметрыОбласти.Вставить("ДатаОкончанияПериода",	ПараметрыОтчета["КонецПериода"]);
	ПараметрыОбласти.Вставить("ВыводитьОтбор",			ПараметрыОтчета["ВыводитьОтбор"]);
	ПараметрыОбласти.Вставить("Отбор",					Строка(ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор));
	ВывестиЗаголовок_ОсновнойРаздел(ТабДокумент, ПараметрыОбласти, Макет);
	
	//---
	// Шапка таблицы
	//---
	ВывестиШапкуТаблицы(ПараметрыОтчета, ТабДокумент, Макет, "ОсновнойРаздел");
	
	//---
	// Строки таблицы
	//---
	ВывестиТаблицу(ПараметрыОтчета, ТабДокумент, Макет, ДетальныеЗаписи, Истина);
	
	//---
	// Всего
	//---
	ОбластьВсего = Макет.ПолучитьОбласть("Всего");
	ОбластьВсего.Параметры.Заполнить(ГруппировкаОднимСписком);
	ТабДокумент.Вывести(ОбластьВсего);
	
	//---
	// Подвал
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",	ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("Дата",			ПараметрыОтчета["КонецПериода"]);
	ВывестиПодвал(ТабДокумент, ПараметрыОбласти, Макет);
	
	// Колонтитулы:
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(ТабДокумент,
		ПараметрыОтчета["Колонтитулы_НаименованиеОтчета"],
		ПараметрыОтчета["Колонтитулы_ТекущийПользователь"],
		ПараметрыОтчета["Организация"]);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура СообщитьОбОшибке(ИнформацияОбОшибке)
	
	Пока НЕ ИнформацияОбОшибке.Причина = Неопределено Цикл
		ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
	КонецЦикла;
	ТекстСообщения = НСтр("ru='Отчет не сформирован!'") + Символы.ПС + ИнформацияОбОшибке.Описание;
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

Функция СформироватьСодержимоеГрафы11(ДетальнаяЗапись, ЧтоПолучить)
	
	НеобходимоПолучитьТекст = (ЧтоПолучить = "Текст");
	
	Результат = ?(НеобходимоПолучитьТекст, "", Новый Массив());
	
	ПримененаУстаревшаяСхемаУказанияРеквизитов = (ЗначениеЗаполнено(ДетальнаяЗапись["НомерДокументаОплаты"])
		ИЛИ ЗначениеЗаполнено(ДетальнаяЗапись["ДатаДокументаОплаты"]));
		
	Если ПримененаУстаревшаяСхемаУказанияРеквизитов Тогда
		
		ВремСтруктура = Новый Структура();
		ВремСтруктура.Вставить("ДатаДокумента", ДетальнаяЗапись["ДатаДокументаОплаты"]);
		ВремСтруктура.Вставить("НомерДокумента", ДетальнаяЗапись["НомерДокументаОплаты"]);
		
		ТаблицаПлатежноРасчетныеДокументы = Новый Массив();
		ТаблицаПлатежноРасчетныеДокументы.Добавить(ВремСтруктура);
		
	Иначе
		
		ТаблицаПлатежноРасчетныеДокументы = ДетальнаяЗапись["ТаблицаПлатежноРасчетныеДокументы"];
		
		Если ТаблицаПлатежноРасчетныеДокументы = Null Тогда
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаПлатежноРасчетныеДокументы Цикл
		
		Если НеобходимоПолучитьТекст Тогда
			// Необходимо получить текст для вывода в ячейку табличного документа
			
			ПредставлениеДокумента = УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
				СтрокаТаблицы["НомерДокумента"],
				СтрокаТаблицы["ДатаДокумента"]);
			
			Результат = Результат +	?(Результат = "", "", ";") + ПредставлениеДокумента;
			
		Иначе
			// Необходимо получить массив сведений для декларации
			
			ВремСтруктура = Новый Структура();
			ВремСтруктура.Вставить("НомДокПдтвОпл", СтрокаТаблицы["НомерДокумента"]);
			ВремСтруктура.Вставить("ДатаДокПдтвОпл", Формат(СтрокаТаблицы["ДатаДокумента"], "ДФ=dd.MM.yyyy"));
			
			Результат.Добавить(ВремСтруктура);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

