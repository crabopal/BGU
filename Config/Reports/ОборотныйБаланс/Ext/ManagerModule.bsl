#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Задает набор показателей, которые позволяет анализировать отчет.
//
// Возвращаемое значение:
//   Массив      - основные суммовые показатели отчета.
//
Функция ПолучитьНаборПоказателей() Экспорт
	
	НаборПоказателей = Новый Массив;
	НаборПоказателей.Добавить("БУ");
	
	Возврат НаборПоказателей;
	
КонецФункции

Функция ПолучитьПараметрыИсполненияОтчета() Экспорт
	
	Возврат Новый Структура(
		"ИспользоватьПередКомпоновкойМакета,
		|ИспользоватьПослеКомпоновкиМакета,
		|ИспользоватьПриВыводеЗаголовка,
		|ИспользоватьПослеВыводаРезультата,
		|ИспользоватьДанныеРасшифровки,
		|ВыводитьОтладочнуюИнформацию,
		|ИспользоватьПередВыводомЭлементаРезультата,
		|ИспользоватьПривилегированныйРежим",
		Истина, Истина, Истина, Истина, Истина, Истина, Истина, Истина);
	
КонецФункции

Процедура ПриВыводеЗаголовка(ПараметрыОтчета, КомпоновщикНастроек, Результат) Экспорт
	
	Макет = ПолучитьМакет("МакетФиксированныхОбластей");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Шапка");
	Попытка
		ОбластьЗаголовок.Параметры.СтрокаПериода = СтандартныеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(ПараметрыОтчета.НачалоПериода, ПараметрыОтчета.КонецПериода,, ПараметрыОтчета.ТипПериода, ПараметрыОтчета.ТолькоУказанныйПериод);
		Если ЗначениеЗаполнено(ПараметрыОтчета.Организация) Тогда
			ОбластьЗаголовок.Параметры.Учреждение = Справочники.Организации.ПредставлениеУчрежденияДляПечатнойФормы(ПараметрыОтчета.Организация);
		КонецЕсли
	Исключение
	КонецПопытки;
	
	Результат.Вывести(ОбластьЗаголовок);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ОбщиеОбластиСтандартногоОтчета");
	Результат.Вывести(Макет.ПолучитьОбласть("ЕдиницаИзмерения"));
	
	Если ПараметрыОтчета.ВыводитьПолностью Тогда
		СтандартныеОтчеты.ВыводитьОтбор(Результат, КомпоновщикНастроек, "Учреждение");
	КонецЕсли;
	
	Результат.Область("R1:R" + Результат.ВысотаТаблицы).Имя = "Заголовок";
	Результат.Области.Заголовок.Видимость = КомпоновщикНастроек.ПолучитьНастройки().ДополнительныеСвойства.ВыводитьЗаголовок;
	
КонецПроцедуры

Функция ПолучитьТекстЗаголовка(ПараметрыОтчета, ОрганизацияВНачале = Истина) Экспорт 
	
	Возврат "Оборотный баланс " + СтандартныеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(ПараметрыОтчета.НачалоПериода, ПараметрыОтчета.КонецПериода,, ПараметрыОтчета.ТипПериода, ПараметрыОтчета.ТолькоУказанныйПериод);
	
КонецФункции

Процедура СформироватьОтчетФ(ПараметрыОтчета, АдресХранилища) Экспорт
	
	// НомерПоПорядку = 1;
	СтандартныеОтчеты.ВывестиОтчетФ(ПараметрыОтчета, АдресХранилища);
	
КонецПроцедуры

//-----------------------------------------------------------------------------
// В процедуре можно доработать компоновщик перед выводом в отчет
// Изменения сохранены не будут
Процедура ПередКомпоновкойМакета(ПараметрыОтчета, СхемаКомпоновкиДанных, КомпоновщикНастроек) Экспорт
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.НачалоПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода",
			Бухгалтерскийучет.НачалоПериодаСУточнением(
				ПараметрыОтчета.НачалоПериода, ПараметрыОтчета.ТипПериода, ПараметрыОтчета.ТолькоУказанныйПериод));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета.КонецПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода",
			Бухгалтерскийучет.КонецПериодаСУточнением(
				ПараметрыОтчета.КонецПериода, ПараметрыОтчета.ТипПериода, ПараметрыОтчета.ТолькоУказанныйПериод));
    КонецЕсли;
    
	// Формирование макетов
	Запись = "";
	ЗаписьОбразец = "";
	Подвал = "";
	ПодвалОбразец = "";
	Для каждого Макет из СхемаКомпоновкиДанных.МакетыГруппировок Цикл
		Если Макет.ИмяГруппировки = "ОБалансОбразец" Тогда
			Если Макет.ТипМакета = ТипМакетаОбластиКомпоновкиДанных.Заголовок Тогда
				ЗаписьОбразец = Макет.Макет;
			ИначеЕсли Макет.ТипМакета = ТипМакетаОбластиКомпоновкиДанных.ОбщийИтогПодвал Тогда
				ПодвалОбразец = Макет.Макет;
			КонецЕсли
		ИначеЕсли Макет.ИмяГруппировки = "ОБаланс" Тогда
			Если Макет.ТипМакета = ТипМакетаОбластиКомпоновкиДанных.Заголовок Тогда
				Запись = Макет.Макет;
			ИначеЕсли Макет.ТипМакета = ТипМакетаОбластиКомпоновкиДанных.ОбщийИтогПодвал Тогда
				Подвал = Макет.Макет;
			КонецЕсли
		КонецЕсли
	КонецЦикла;
	Шапка = "";
	ШапкаОбразец = "";
	Для каждого Макет из СхемаКомпоновкиДанных.МакетыЗаголовковГруппировок Цикл
		Если Макет.ИмяГруппировки = "ОБалансОбразец" И Макет.ТипМакета = ТипМакетаОбластиКомпоновкиДанных.Заголовок Тогда
			ШапкаОбразец = Макет.Макет;
		ИначеЕсли Макет.ИмяГруппировки = "ОБаланс" И Макет.ТипМакета = ТипМакетаОбластиКомпоновкиДанных.Заголовок Тогда
			Шапка = Макет.Макет;
		КонецЕсли;
	КонецЦикла;
	МакетЗаписьОбразец = СхемаКомпоновкиДанных.Макеты[ЗаписьОбразец].Макет;
	СхемаКомпоновкиДанных.Макеты[Запись].Макет = СтандартныеОтчеты.ПолучитьКопиюОписанияМакета(МакетЗаписьОбразец, "{http://v8.1c.ru/8.1/data-composition-system/area-template}");
	МакетЗапись = СхемаКомпоновкиДанных.Макеты[Запись].Макет;
	//МакетЗапись = МакетЗаписьОбразец;
	МакетШапкаОбразец = СхемаКомпоновкиДанных.Макеты[ШапкаОбразец].Макет;
	СхемаКомпоновкиДанных.Макеты[Шапка].Макет = СтандартныеОтчеты.ПолучитьКопиюОписанияМакета(МакетШапкаОбразец, "{http://v8.1c.ru/8.1/data-composition-system/area-template}");
	МакетШапка = СхемаКомпоновкиДанных.Макеты[Шапка].Макет;
	//МакетШапка = МакетШапкаОбразец;
	МакетПодвалОбразец = СхемаКомпоновкиДанных.Макеты[ПодвалОбразец].Макет;
	СхемаКомпоновкиДанных.Макеты[Подвал].Макет = СтандартныеОтчеты.ПолучитьКопиюОписанияМакета(МакетПодвалОбразец, "{http://v8.1c.ru/8.1/data-composition-system/area-template}");
	МакетПодвал = СхемаКомпоновкиДанных.Макеты[Подвал].Макет;
	//МакетПодвал = МакетПодвалОбразец;
	МассивЯчеек = Новый Массив();
	МассивЯчеек.Добавить(Новый Структура("Индекс, Имя, Запись, Ячейка, Ячейка1, Ячейка2", 0, "КПС",  МакетЗапись[0].Ячейки[0], МакетШапка[0].Ячейки[0], МакетШапка[1].Ячейки[0], МакетШапка[2].Ячейки[0]));
	МассивЯчеек.Добавить(Новый Структура("Индекс, Имя, Запись, Ячейка, Ячейка1, Ячейка2", 1, "КФО",  МакетЗапись[0].Ячейки[1], МакетШапка[0].Ячейки[1], МакетШапка[1].Ячейки[1], МакетШапка[2].Ячейки[1]));
	МассивЯчеек.Добавить(Новый Структура("Индекс, Имя, Запись, Ячейка, Ячейка1, Ячейка2", 2, "Счет", МакетЗапись[0].Ячейки[2], МакетШапка[0].Ячейки[2], МакетШапка[1].Ячейки[2], МакетШапка[2].Ячейки[2]));
	МассивЯчеек.Добавить(Новый Структура("Индекс, Имя, Запись, Ячейка, Ячейка1, Ячейка2", 3, "КЭК",  МакетЗапись[0].Ячейки[3], МакетШапка[0].Ячейки[3], МакетШапка[1].Ячейки[3], МакетШапка[2].Ячейки[3]));
	
		// Чистим макет от ненужных группировок
	Для каждого Группировка Из ПараметрыОтчета.ГруппировкаЕПСБУ Цикл
		УдалитьСубсчета = Ложь;
		Ячейка = НайтиЯчейку(МассивЯчеек, Группировка.Группировка);
		Если НЕ Группировка.Использование Тогда
			МакетЗапись[0].Ячейки.Удалить(Ячейка.Запись);
			МакетШапка[0].Ячейки.Удалить(Ячейка.Ячейка);
			МакетШапка[1].Ячейки.Удалить(Ячейка.Ячейка1);
			МакетШапка[2].Ячейки.Удалить(Ячейка.Ячейка2);
			МакетПодвал[0].Ячейки.Удалить(1);
			МассивЯчеек.Удалить(МассивЯчеек.Найти(Ячейка));
		КонецЕсли;
	КонецЦикла;
		// Нумеруем массив ячеек
	ПеренумероватьЯчейки(МассивЯчеек);
		// Устанавливаем группировки на места
	Я = 0;
	Для каждого Группировка Из ПараметрыОтчета.ГруппировкаЕПСБУ Цикл
		Ячейка = НайтиЯчейку(МассивЯчеек, Группировка.Группировка);
		Если Группировка.Использование Тогда
			Индекс = МакетЗапись[0].Ячейки.Индекс(Ячейка.Запись);
			Если Я <> Ячейка.Индекс Тогда
					// запись
				МакетЗапись[0].Ячейки.Сдвинуть(Ячейка.Запись, Я - Индекс);
					// шапка
				МакетШапка[0].Ячейки.Сдвинуть(Ячейка.Ячейка,  Я - Индекс);
				МакетШапка[1].Ячейки.Сдвинуть(Ячейка.Ячейка1, Я - Индекс);
				МакетШапка[2].Ячейки.Сдвинуть(Ячейка.Ячейка2, Я - Индекс);
			КонецЕсли;
			Я = Я + 1;
			Если Группировка.Группировка = "КПС" И НЕ ПараметрыОтчета.ПоказыватьВидКПС Тогда
				Ячейка.Запись.Элементы.Удалить(0); // КПС.ВидКПС
				Ячейка.Запись.Элементы.Удалить(0); // " - "
				СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Ячейка.Запись.Оформление.Элементы, "ГоризонтальноеПоложение", ГоризонтальноеПоложение.Центр);
			КонецЕсли
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыОтчета.КоличествоГруппировок = Я;
	
		// Формирование структуры отчета
	КомпоновщикНастроек.Настройки.Структура[0].ПоляГруппировки.Элементы.Очистить();
	Группировки = КомпоновщикНастроек.Настройки.Структура[0].ПоляГруппировки;
	
		// Обходим список заданных группировок и задаем по ним структуру отчета
	Для каждого ГруппировкаОтчета Из ПараметрыОтчета.ГруппировкаЕПСБУ Цикл
		Если ГруппировкаОтчета.Использование Тогда
			ПолеГруппировки = Группировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеГруппировки.Использование  = Истина;
			ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных(ГруппировкаОтчета.Группировка);
		КонецЕсли
	КонецЦикла;
	
	СтандартныеОтчеты.ДобавитьОтборПоОрганизацииФ(ПараметрыОтчета, КомпоновщикНастроек);
    
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ЗначениеЗаполнено(ПараметрыОтчета.Подразделение) Тогда
		// Если среди доступных организаций, нет выбранной, то оставляем фильтр по доступным организациям
		НовыйОтбор = СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "Подразделение", ПараметрыОтчета.Подразделение,,, Истина);
		НовыйОтбор.Представление = "###ОтборПоПодразделение###"; 
		НовыйОтбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;
    
КонецПроцедуры

//-----------------------------------------------------------------------------
Процедура ПослеКомпоновкиМакета(ПараметрыОтчета, МакетКомпоновки) Экспорт
	
	ЗначенияПоказателей = Новый Массив(10);
	Для Индекс = 0 По 5 Цикл
		ЗначенияПоказателей[Индекс] = 0;
	КонецЦикла;
	ПараметрыОтчета.ВременныеДанныеОтчета = Новый Структура;
	
	МакетГруппировкиСчет = СтандартныеОтчеты.ПолучитьМакетГруппировкиПоПолюГруппировки(МакетКомпоновки, "Счет");
	ПараметрыОтчета.ВременныеДанныеОтчета.Вставить("МакетСчет", МакетГруппировкиСчет);
	ПараметрыОтчета.ВременныеДанныеОтчета.Вставить("ЗначенияПоказателей", ЗначенияПоказателей);
	
	МакетПодвалаОтчета = СтандартныеОтчеты.ПолучитьМакетПодвала(МакетКомпоновки);
	ПараметрыОтчета.ВременныеДанныеОтчета.Вставить("МакетПодвал", МакетПодвалаОтчета);
	
КонецПроцедуры

//-----------------------------------------------------------------------------
Функция НайтиЯчейку(МассивЯчеек, Имя)
	Для каждого Ячейка из МассивЯчеек Цикл
		Если Ячейка.Имя = Имя Тогда
			Возврат Ячейка;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

//-----------------------------------------------------------------------------
Процедура ПеренумероватьЯчейки(МассивЯчеек)
	Я = 0;
	Для каждого Ячейка из МассивЯчеек Цикл
		Ячейка.Индекс = Я;
		Я = Я + 1;
	КонецЦикла;
КонецПроцедуры

//-----------------------------------------------------------------------------
Процедура ПередВыводомЭлементаРезультата(ПараметрыОтчета, МакетКомпоновки, ДанныеРасшифровки, ЭлементРезультата, Отказ = Ложь) Экспорт
	
	// Накапливаем суммы по корневым счетам
	Попытка
		Если ПараметрыОтчета.ВременныеДанныеОтчета.МакетСчет.Найти(МакетКомпоновки.Макеты[ЭлементРезультата.Макет]) <> Неопределено Тогда
			ЗначениеСчет = ЭлементРезультата.ЗначенияПараметров["П" + ?(ПараметрыОтчета.ПоказыватьВидКПС, 6, 5)].Значение;
			Счет = ПланыСчетов.ЕПСБУ.НайтиПоКоду(ЗначениеСчет);
			Если Не Счет.ЭлементГруппа И Не Счет.Забалансовый Тогда
				Для ПодИндекс = 0 По 5 Цикл
					Значение = ЭлементРезультата.ЗначенияПараметров[Строка(МакетКомпоновки.Макеты[ЭлементРезультата.Макет].Макет[0].Ячейки[ПодИндекс + ПараметрыОтчета.КоличествоГруппировок].Элементы[0].Значение)].Значение;
					ПараметрыОтчета.ВременныеДанныеОтчета.ЗначенияПоказателей[ПодИндекс] = ПараметрыОтчета.ВременныеДанныеОтчета.ЗначенияПоказателей[ПодИндекс] + Значение;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	// Проставляем накопленные суммы в подвал отчета
	Если ЭлементРезультата.Макет = ПараметрыОтчета.ВременныеДанныеОтчета.МакетПодвал.Имя Тогда
		Для ПодИндекс = 0 По 5 Цикл
			ЭлементРезультата.ЗначенияПараметров[Строка(ПараметрыОтчета.ВременныеДанныеОтчета.МакетПодвал.Макет[0].Ячейки[ПодИндекс + ПараметрыОтчета.КоличествоГруппировок].Элементы[0].Значение)].Значение = ПараметрыОтчета.ВременныеДанныеОтчета.ЗначенияПоказателей[ПодИндекс];
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеВыводаРезультата(ПараметрыОтчета, Результат) Экспорт
	
	//Удалим строки с высотой равной 1
	Индекс = Результат.ВысотаТаблицы;
	Пока Индекс > 0 Цикл
		ИндексСтроки = "R" + Формат(Индекс,"ЧГ=0");
		Если Результат.Область(ИндексСтроки).ВысотаСтроки = 1 Тогда
			Результат.УдалитьОбласть(Результат.Область(ИндексСтроки), ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	СтандартныеОтчеты.ОбработкаРезультатаОтчетаФ(ПараметрыОтчета.ИдентификаторОтчета, Результат);
	
	Если Результат.Области.Найти("Заголовок") = Неопределено Тогда
		Результат.ФиксацияСверху = 3;
	Иначе
		Результат.ФиксацияСверху = Результат.Области.Заголовок.Низ + 3;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

