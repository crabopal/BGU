#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//   Настройки - Структура - см. возвращаемое значение ФункцииОтчетовКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию().
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.Печать.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	//Настройки.ФормироватьСразу = Истина;
	//Настройки.ВыводитьСуммуВыделенныхЯчеек = Ложь;
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	// Установим параметры основной СКД.
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "Организация", Организация, Истина);
	
	// Установим параметры во вложенных СКД из параметров основной СКД.
	ПараметрВидРасчетов  = Настройки.ПараметрыДанных.Элементы.Найти("ВидРасчетов");
	ПараметрСчетРасчетов = Настройки.ПараметрыДанных.Элементы.Найти("СчетРасчетов");
	ПараметрИФО          = Настройки.ПараметрыДанных.Элементы.Найти("ИФО");
	ПараметрКФО          = Настройки.ПараметрыДанных.Элементы.Найти("КФО");
	ПараметрКПС          = Настройки.ПараметрыДанных.Элементы.Найти("КПС");
	ПараметрКЭК          = Настройки.ПараметрыДанных.Элементы.Найти("КЭК");
	Для Каждого ВложеннаяСКД Из Настройки.Структура Цикл
		
		Если ВложеннаяСКД.Имя = "ГрафикПлатежейЗаголовок"
			ИЛИ ВложеннаяСКД.Имя = "ГрафикПлатежейТаблица" Тогда
			ВложеннаяСКД.Использование = ВывестиГрафикПлатежей;
		КонецЕсли;
		
		Если ВложеннаяСКД.Имя = "ПланГрафикИсполненияЗаголовок"
			ИЛИ ВложеннаяСКД.Имя = "ПланГрафикИсполненияТаблица" Тогда
			ВложеннаяСКД.Использование = ВывестиПланГрафикИсполнения;
		КонецЕсли;
		
		Если НЕ ТипЗнч(ВложеннаяСКД) = Тип("НастройкиВложенногоОбъектаКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НачалоПериода) Тогда
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки,
				"НачалоПериода", НачалоДня(НачалоПериода), Истина);
		Иначе
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки,
				"НачалоПериода", НачалоПериода, Истина);
		КонецЕсли;
		Если ЗначениеЗаполнено(КонецПериода) Тогда
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки,
				"КонецПериода", КонецДня(КонецПериода), Истина);
		Иначе
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки,
				"КонецПериода", КонецПериода, Истина);
		КонецЕсли;
		
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки,
			"Организация", Организация, Истина);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки,
			"Контрагент", Контрагент, ЗначениеЗаполнено(Контрагент));
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки,
			"Договор", Договор, ЗначениеЗаполнено(Договор));
		
		Если ПоДатамИсполнения Тогда
			ПериодичностьГрафика = 0;
		Иначе
			ПериодичностьГрафика = ?(Периодичность <> 0, Периодичность, 9); // По умолчанию - по месяцам.
		КонецЕсли;
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки,
			"ПериодичностьГрафика", ПериодичностьГрафика, Истина);
		
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки,
			"ТипПериода", Отчеты.КонтрольИсполненияДоговоров.ТипПериода(ПериодичностьГрафика), Истина);
		
		Если ПараметрВидРасчетов <> Неопределено Тогда
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки, "ВидРасчетов",
				ПараметрВидРасчетов.Значение, ПараметрВидРасчетов.Использование);
		КонецЕсли;
		Если ПараметрСчетРасчетов <> Неопределено Тогда
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки, "СчетРасчетов",
				ПараметрСчетРасчетов.Значение, ПараметрСчетРасчетов.Использование);
		КонецЕсли;
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ПараметрИФО <> Неопределено Тогда
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки, "ИФО",
				ПараметрИФО.Значение, ПараметрИФО.Использование);
		КонецЕсли;
		Если ПараметрКФО <> Неопределено Тогда
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки, "КФО",
				ПараметрКФО.Значение, ПараметрКФО.Использование);
		КонецЕсли;
		Если ПараметрКПС <> Неопределено Тогда
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки, "КПС",
				ПараметрКПС.Значение, ПараметрКПС.Использование);
		КонецЕсли;
		Если ПараметрКЭК <> Неопределено Тогда
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(ВложеннаяСКД.Настройки, "КЭК",
				ПараметрКЭК.Значение, ПараметрКЭК.Использование);
		КонецЕсли;
		
		// Сортировка строк отчета.
		УстановитьПорядокСтрокОтчета(ВложеннаяСКД.Настройки.Порядок, ПоДатамИсполнения, ВложеннаяСКД.Имя);
		
		// Детализация по периодам / датам исполнения.
		Для Каждого ЭлементСтруктуры Из ВложеннаяСКД.Настройки.Структура Цикл
			Если ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
				Для Каждого СтрокаТаблицы Из ЭлементСтруктуры.Строки Цикл
					УстановитьДетализациюПоДатамИсполнения(СтрокаТаблицы, ПоДатамИсполнения, ВложеннаяСКД.Имя);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		// Вывод полей дополнительной аналитики в графиках платежей.
		Если ВложеннаяСКД.Имя = "ГрафикПлатежейТаблица" Тогда
			
			ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками =
				ПолучитьФункциональнуюОпцию("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками");
			ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями =
				ПолучитьФункциональнуюОпцию("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями");
			
			ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей = Ложь;
			Если ЗначениеЗаполнено(Договор) Тогда
				
				ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВидДоговора");
				ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей = КонтрольИсполненияДоговоров.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей(ВидДоговора);
				
			Иначе
				
				ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей = 
					(ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками ИЛИ ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями);
				
			КонецЕсли;
			
			Для Каждого ЭлементСтруктуры Из ВложеннаяСКД.Настройки.Структура Цикл
				Если ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
					Для Каждого СтрокаТаблицы Из ЭлементСтруктуры.Строки Цикл
						УстановитьДетализациюПоДопАналитике(СтрокаТаблицы, ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ВывестиЗаголовокОтчета(ДокументРезультат, Настройки);
	
	// вывод отчета
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	// подпись
	
	ВывестиПодвалОтчета(ДокументРезультат, Настройки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВывестиЗаголовокОтчета(Результат, Настройки)
	
	МакетЗаголовка = УправлениеПечатью.МакетПечатнойФормы("Отчет.КонтрольИсполненияДоговоров.ПФ_MXL_ЗаголовокОтчета");
	
	Если ЭтотОбъект.ВыводитьЗаголовок Тогда
		
		// Заголовок.
		ОбластьЗаголовка = МакетЗаголовка.ПолучитьОбласть("Заголовок");
		ПараметрыЗаголовка = Новый Структура;
		ПараметрыЗаголовка.Вставить("ЗаголовокОтчета", НСтр("ru = 'Контроль исполнения договоров'"));
		ОбластьЗаголовка.Параметры.Заполнить(ПараметрыЗаголовка);
		Результат.Вывести(ОбластьЗаголовка);
		
		Если ЗначениеЗаполнено(НачалоПериода) ИЛИ ЗначениеЗаполнено(КонецПериода) Тогда
			
			ОбластьПериод = МакетЗаголовка.ПолучитьОбласть("Период");
			ОбластьПериод.Параметры.ПериодСтр = ПредставлениеПериода(НачалоДня(НачалоПериода), КонецДня(КонецПериода));
			Результат.Вывести(ОбластьПериод);
			
		КонецЕсли;
		
		// Шапка.
		РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "Наименование,НаименованиеСокращенное");
		РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "Наименование,НаименованиеСокращенное");
		
		ОбластьШапка = МакетЗаголовка.ПолучитьОбласть("Шапка");
		ПараметрыШапка = Новый Структура("НаименованиеОрганизации,КонтрагентДоговор");
		ПараметрыШапка.НаименованиеОрганизации =
			?(ЗначениеЗаполнено(РеквизитыОрганизации.НаименованиеСокращенное),
			РеквизитыОрганизации.НаименованиеСокращенное,
			РеквизитыОрганизации.Наименование);
		ПараметрыШапка.КонтрагентДоговор = "" +
			?(ЗначениеЗаполнено(РеквизитыКонтрагента.НаименованиеСокращенное),
			РеквизитыКонтрагента.НаименованиеСокращенное,
			РеквизитыКонтрагента.Наименование)
			+ ?(ЗначениеЗаполнено(Договор), ", " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "Наименование"), "");
		ОбластьШапка.Параметры.Заполнить(ПараметрыШапка);
		Результат.Вывести(ОбластьШапка);
		
	КонецЕсли;
	
	// Отборы.
	ТекстОтбора = "";
	Для каждого ПараметрДанных Из Настройки.ПараметрыДанных.Элементы Цикл
	
		Если ТипЗнч(ПараметрДанных) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") И ПараметрДанных.Использование Тогда
			
			Если НЕ ЗначениеЗаполнено(ПараметрДанных.ИдентификаторПользовательскойНастройки) Тогда
				Продолжить;
			КонецЕсли;
			
			ПредставлениеОтбора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 Равно ""%2""'"),
				Строка(ПараметрДанных.Параметр), Строка(ПараметрДанных.Значение));
			ТекстОтбора = ТекстОтбора + ?(ПустаяСтрока(ТекстОтбора), "", ", ") + ПредставлениеОтбора;
			
		КонецЕсли;
	
	КонецЦикла;
	Для каждого ТекСтрОтбора Из Настройки.Отбор.Элементы Цикл
	
		Если ТипЗнч(ТекСтрОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ТекСтрОтбора.Использование Тогда
			
			Если ЗначениеЗаполнено(ТекСтрОтбора.ИдентификаторПользовательскойНастройки) 
				И ТекСтрОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация") Тогда
				Продолжить;
			КонецЕсли;
			
			ПредставлениеОтбора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 %2 ""%3""'"),
				Строка(ТекСтрОтбора.ЛевоеЗначение), Строка(ТекСтрОтбора.ВидСравнения), Строка(ТекСтрОтбора.ПравоеЗначение));
			ТекстОтбора = ТекстОтбора + ?(ПустаяСтрока(ТекстОтбора), "", ", ") + ПредставлениеОтбора;
			
		КонецЕсли;
	
	КонецЦикла;
	Если НЕ ПустаяСтрока(ТекстОтбора) Тогда
		ОбластьОтбор = МакетЗаголовка.ПолучитьОбласть("Отбор");
		ОбластьОтбор.Параметры.ТекстОтбора = ТекстОтбора;
		Результат.Вывести(ОбластьОтбор);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиПодвалОтчета(Результат, Настройки)
	
	Если ЭтотОбъект.ВыводитьПодвал Тогда
		СтандартныеОтчеты.ВывестиПодвалОтчета(ЭтотОбъект, Результат);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьПорядокСтрокОтчета(КоллекцияПорядок, Знач ПоДатамИсполнения, Знач ИмяТаблицы)
	
	НовыйЭлемент = КоллекцияПорядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	Если ПоДатамИсполнения Тогда
		Если ИмяТаблицы = "ГрафикПлатежейТаблица" Тогда
			НовыйЭлемент.Поле = Новый ПолеКомпоновкиДанных("ОплатитьДо");
		Иначе
			НовыйЭлемент.Поле = Новый ПолеКомпоновкиДанных("ИсполнитьДо");
		КонецЕсли;
	Иначе
		НовыйЭлемент.Поле = Новый ПолеКомпоновкиДанных("Период");
	КонецЕсли;
	НовыйЭлемент.Использование = Истина;
	
КонецПроцедуры

Процедура УстановитьДетализациюПоДатамИсполнения(СтрокаТаблицы, Знач ПоДатамИсполнения, Знач ИмяТаблицы)
	
	РежимРасшифровки = (Периодичность = 2); // По документам движения.
	
	Для Каждого ЭлементСтруктуры Из СтрокаТаблицы.Структура Цикл
		
		Если ЭлементСтруктуры.Структура.Количество() > 0 Тогда
			// Рекурсивный вызов для вложенных элементов структуры.
			УстановитьДетализациюПоДатамИсполнения(ЭлементСтруктуры, ПоДатамИсполнения, ИмяТаблицы);
		КонецЕсли;
		
		Если СтрНайти(ЭлементСтруктуры.Имя, "ПериодДатаИсполнения") > 0 Тогда
			ЭлементСтруктуры.ПоляГруппировки.Элементы.Очистить();
			ПолеГруппировки = ЭлементСтруктуры.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			Если ПоДатамИсполнения Тогда
				Если ИмяТаблицы = "ГрафикПлатежейТаблица" Тогда
					ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("ОплатитьДо");
				Иначе
					ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("ИсполнитьДо");
				КонецЕсли;
			ИначеЕсли РежимРасшифровки Тогда 
				ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Регистратор");
				ИмяПоказателей = ?(ИмяТаблицы = "ГрафикПлатежейТаблица", "Оплата", "Исполнение");
				ГруппаИЛИ = ОбщийМодульСКД.ДобавитьГруппуОтбораКомпоновкиДанных(ЭлементСтруктуры.Отбор, "ГруппаИЛИ");
				ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(ГруппаИЛИ, ИмяПоказателей + "План", ВидСравненияКомпоновкиДанных.Заполнено);
				ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(ГруппаИЛИ, ИмяПоказателей + "Факт", ВидСравненияКомпоновкиДанных.Заполнено);
			Иначе
				ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("Период");
			КонецЕсли;
			ПолеГруппировки.Использование = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьДетализациюПоДопАналитике(СтрокаТаблицы, Знач ВклОткл)
	
	Для Каждого ЭлементСтруктуры Из СтрокаТаблицы.Структура Цикл
		
		Если ЭлементСтруктуры.Структура.Количество() > 0 Тогда
			// Рекурсивный вызов для вложенных элементов структуры.
			УстановитьДетализациюПоДопАналитике(ЭлементСтруктуры, ВклОткл);
		КонецЕсли;
		
		Если СтрНайти(ЭлементСтруктуры.Имя, "ДопАналитикаВГрафикахПлатежей") > 0 Тогда
			ЭлементСтруктуры.Использование = ВклОткл;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли