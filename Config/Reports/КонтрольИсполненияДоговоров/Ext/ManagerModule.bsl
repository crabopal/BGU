// СтандартныеПодсистемы.ВариантыОтчетов

// См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "КонтрольИсполненияДоговоров");
	НастройкиВарианта.Описание = НСтр("ru = 'План-фактный анализ исполнения графиков по договорам контрагента'");
	НастройкиВарианта.Включен = Ложь;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "КонтрольИсполненияДоговоровСводный");
	НастройкиВарианта.Описание = НСтр("ru = 'План-фактный анализ исполнения графиков по договорам с контрагентами'");
	НастройкиВарианта.Включен = Истина;
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ТипПериода(ПериодичностьГрафика) Экспорт
	
	ТипПериода = "";
	Если ПериодичностьГрафика = 12 Тогда
		ТипПериода = "Год";
	ИначеЕсли ПериодичностьГрафика = 11 Тогда
		ТипПериода = "Полугодие";
	ИначеЕсли ПериодичностьГрафика = 10 Тогда
		ТипПериода = "Квартал";
	ИначеЕсли ПериодичностьГрафика = 9 Тогда
		ТипПериода = "Месяц";
	ИначеЕсли ПериодичностьГрафика = 8 Тогда
		ТипПериода = "Декада";
	ИначеЕсли ПериодичностьГрафика = 7 Тогда
		ТипПериода = "Неделя";
	ИначеЕсли ПериодичностьГрафика = 6 Тогда
		ТипПериода = "День";
	КонецЕсли;
	
	Возврат ТипПериода;
	
КонецФункции

#КонецОбласти

#КонецЕсли


