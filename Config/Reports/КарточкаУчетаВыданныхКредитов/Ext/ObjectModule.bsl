#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДокументРезультат.Очистить();
	
	ДанныеРасшифровкиОбъект = Неопределено;
	
	ТекущиеНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	НовыйКомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	НовыйКомпоновщикНастроек.ЗагрузитьНастройки(ТекущиеНастройки);
	НовыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	
	УстановитьПараметрыОтчета(НовыйКомпоновщикНастроек);
	
	НовыйКомпоновщикНастроек.Восстановить();
	НастройкиДляКомпоновкиМакета = НовыйКомпоновщикНастроек.ПолучитьНастройки();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиДляКомпоновкиМакета, ДанныеРасшифровкиОбъект);
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровкиОбъект, Истина);
	
	ДанныеРасшифровки = ДанныеРасшифровкиОбъект;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	
	ПроцессорВывода.НачатьВывод();
	ТекущаяВысотаТаблицы = 0;
	
	Пока Истина Цикл
		
		ЭлементРезультата = ПроцессорКомпоновки.Следующий();
		Если ЭлементРезультата = Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		ПроцессорВывода.ВывестиЭлемент(ЭлементРезультата);
		ВывестиРазделительСтраниц(ДокументРезультат, ТекущаяВысотаТаблицы, ЭлементРезультата);
		
	КонецЦикла;
	
	ПроцессорВывода.ЗакончитьВывод();
	
	ОтчетПустой = ОтчетыСервер.ОтчетПустой(ЭтотОбъект, ПроцессорКомпоновки);
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ОтчетПустой", ОтчетПустой);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПараметрПериод = СтандартныеОтчетыКлиентСервер.ПолучитьПараметр(КомпоновщикНастроек, "Период");
	
	Если ПараметрПериод <> Неопределено
		И ПараметрПериод.Использование
		И (ПараметрПериод.Значение.ДатаНачала <> НачалоМесяца(ПараметрПериод.Значение.ДатаНачала)
		ИЛИ ПараметрПериод.Значение.ДатаОкончания <> КонецМесяца(ПараметрПериод.Значение.ДатаОкончания)) Тогда

		ТекстСообщения = НСтр("ru = 'Даты периода формирования отчета должны приходиться на начало и конец месяца'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьПараметрыОтчета(Настройки)
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "СчетаРасчетов",
		БухгалтерскийУчет.СписокСчетов("207.00"));

	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "СчетаКассы",
		БухгалтерскийУчет.СписокСчетов("201.00, 210.02, 304.05"));
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ВалютаРегУчета",
		Константы.ВалютаРегламентированногоУчета.Получить());

	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ОкончаниеДоговораВСвойствах",
		Не ПолучитьФункциональнуюОпцию("СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств"));

КонецПроцедуры

Процедура ВывестиРазделительСтраниц(ДокументРезультат, ТекущаяВысотаТаблицы, ЭлементРезультата)

	Если ТекущаяВысотаТаблицы = ДокументРезультат.ВысотаТаблицы Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяВысотаТаблицы = ДокументРезультат.ВысотаТаблицы;

	Если ДокументРезультат.Область(ТекущаяВысотаТаблицы, 1).Текст = "РазрывСтраницы" Тогда
		
		ДокументРезультат.Область(ТекущаяВысотаТаблицы, 1).Текст = "";
		Если ЭлементРезультата.ПроцентВывода <> 100 Тогда
			ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли; 
			
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

#КонецЕсли
