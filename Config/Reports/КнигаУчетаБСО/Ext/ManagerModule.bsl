#Область СлужебныйПрограммныйИнтерфейс

Функция ЭтоРегистрУчета() Экспорт
	
	Возврат Истина;
	
КонецФункции

Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	СтандартныеОтчеты.СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета);
	
КонецПроцедуры	

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "КнигаУчетаБСО");
	НастройкиВарианта.Описание = НСтр("ru = '(устарел. Рекомендуется использовать актуальный вариант отчета.) Отчет группируется по ЦМО. Разные ЦМО с одинаковым Сотрудником выводятся разными листами.'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "КнигаУчетаБСО_ПоСотрудникам");
	НастройкиВарианта.Описание = НСтр("ru = '(устарел. Рекомендуется использовать актуальный вариант отчета.) Отчет группируется по Сотруднику. Разные ЦМО с одинаковым Сотрудником выводятся в один лист.'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "КнигаУчетаБСО_БезЦМО");
	НастройкиВарианта.Описание = НСтр("ru = '(устарел. Рекомендуется использовать актуальный вариант отчета.) Без учета ЦМО и сотрудников. Все ЦМО выводятся в один лист.'");
	
КонецПроцедуры

Функция ПредставлениеПервичногоДокументаБСО(Ссылка, ВидПервичногоДокумента, НомерПервичногоДокумента, ДатаПервичногоДокумента) Экспорт
	Если ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 %2 от %3'"), ВидПервичногоДокумента, НомерПервичногоДокумента, Формат(ДатаПервичногоДокумента, "ДФ=dd.MM.yyyy"));
	Иначе
		Возврат Строка(Ссылка);
	КонецЕсли;
КонецФункции

Процедура ДобавитьДвижениеВТаблицуОстатков(ТаблицаОстатков, СтрокаДвижения) Экспорт
	
	Если СтрокаДвижения.Приход = СтрокаДвижения.Расход Тогда
		// Не влияет на конечные остатки
		Возврат;
	КонецЕсли;
	
	СерияИД = Строка(СтрокаДвижения.СерияБСО.УникальныйИдентификатор());
	НомерНачальный = СтрокаДвижения.НомерНачальный;
	НомерКонечный = ?(СтрокаДвижения.НомерКонечный = 0, СтрокаДвижения.НомерНачальный, СтрокаДвижения.НомерКонечный);;
	
	Если СтрокаДвижения.Приход <> 0 Тогда
		КоличествоДвижения = ?(СтрокаДвижения.Приход < 0, -1, 1);
	Иначе
		КоличествоДвижения = ?(СтрокаДвижения.Расход < 0, 1, -1);
	КонецЕсли;
	// Первую строку в таблицу можно добавить без дополнительных проверок
	Если ТаблицаОстатков.Количество() = 0 Тогда
		СтрокаОстатков = ТаблицаОстатков.Добавить();
		СтрокаОстатков.Серия = СтрокаДвижения.СерияБСО;
		СтрокаОстатков.СерияИД = СерияИД;
		СтрокаОстатков.СерияБСОНаименование = СтрокаДвижения.СерияБСОНаименование;
		СтрокаОстатков.НомерНачальный = НомерНачальный;
		СтрокаОстатков.НомерКонечный = НомерКонечный;
		СтрокаОстатков.Остаток = КоличествоДвижения;
		Возврат;
	КонецЕсли;
	
	// Определить место вставки нового движения в таблицу остатков.
	// Бинарный поиск по отсортированной таблице.
	Начало = 0;
	Конец = ТаблицаОстатков.Количество() - 1;
	ИндексВставки = Цел((Начало + Конец) / 2);
	
	Пока Начало <= Конец Цикл
		Если ТаблицаОстатков[ИндексВставки].СерияИД < СерияИД
			Или ТаблицаОстатков[ИндексВставки].СерияИД = СерияИД
			И ТаблицаОстатков[ИндексВставки].НомерНачальный < НомерНачальный Тогда
			Начало = ИндексВставки + 1;
		ИначеЕсли ТаблицаОстатков[ИндексВставки].СерияИД > СерияИД
			Или ТаблицаОстатков[ИндексВставки].СерияИД = СерияИД
			И ТаблицаОстатков[ИндексВставки].НомерНачальный > НомерНачальный Тогда
			Конец = ИндексВставки - 1;
		ИначеЕсли ТаблицаОстатков[ИндексВставки].СерияИД = СерияИД
			И ТаблицаОстатков[ИндексВставки].НомерНачальный = НомерНачальный Тогда
			Прервать;
		Иначе
			ИндексВставки = Начало;
			Прервать;
		КонецЕсли;
		ИндексВставки = Цел((Начало + Конец) / 2);
	КонецЦикла;
	
	Если Конец < Начало Тогда
		// В последней итерации Начало и Конец указывали на одну строку, но она должна быть после вставляемой.
		// На ее место и нужно вставить новую строку.
		ИндексВставки = Конец + 1;
	КонецЕсли;
	
	// Если новый диапазон пересекается с предыдущим диапазоном, то его тоже нужно включить в обработку.
	Если ИндексВставки - 1 >= 0
		И ТаблицаОстатков[ИндексВставки - 1].Серия = СтрокаДвижения.СерияБСО
		И ТаблицаОстатков[ИндексВставки - 1].НомерКонечный >= НомерНачальный Тогда
		// Включить предыдущий диапазон в обработку
		ИндексВставки = ИндексВставки - 1;
	КонецЕсли;
	
	// Теперь ИндексВставки содержит индекс, в который нужно вставить новую строку.
	// Его нужно сохранить, для последующей обработки измененных диапазонов
	НачальныйИндексВставки = ИндексВставки;
	
	Пока НомерНачальный <= НомерКонечный Цикл
		
		Если ИндексВставки = ТаблицаОстатков.Количество() Тогда
			СтрокаОстатков = ТаблицаОстатков.Вставить(ИндексВставки);
			СтрокаОстатков.Серия = СтрокаДвижения.СерияБСО;
			СтрокаОстатков.СерияИД = СерияИД;
			СтрокаОстатков.СерияБСОНаименование = СтрокаДвижения.СерияБСОНаименование;
			СтрокаОстатков.НомерНачальный = НомерНачальный;
			СтрокаОстатков.НомерКонечный = НомерКонечный;
			СтрокаОстатков.Остаток = КоличествоДвижения;
			НомерНачальный = СтрокаОстатков.НомерКонечный + 1;
		ИначеЕсли ТаблицаОстатков[ИндексВставки].Серия <> СтрокаДвижения.СерияБСО Тогда
			// Диапазоны по нужной серии закончились. Нужно просто вставить оставшийся приход.
			СтрокаОстатков = ТаблицаОстатков.Вставить(ИндексВставки);
			СтрокаОстатков.Серия = СтрокаДвижения.СерияБСО;
			СтрокаОстатков.СерияИД = СерияИД;
			СтрокаОстатков.СерияБСОНаименование = СтрокаДвижения.СерияБСОНаименование;
			СтрокаОстатков.НомерНачальный = НомерНачальный;
			СтрокаОстатков.НомерКонечный = НомерКонечный;
			СтрокаОстатков.Остаток = КоличествоДвижения;
			НомерНачальный = СтрокаОстатков.НомерКонечный + 1;
			ИндексВставки = ИндексВставки + 1;
		ИначеЕсли НомерНачальный > ТаблицаОстатков[ИндексВставки].НомерКонечный Тогда
			// Этот диапазон должен остаться без изменений
			ИндексВставки = ИндексВставки + 1;
		ИначеЕсли НомерНачальный < ТаблицаОстатков[ИндексВставки].НомерНачальный Тогда
			// Добавляемый диапазон начинается раньше следующего диапазона
			Если НомерКонечный < ТаблицаОстатков[ИндексВставки].НомерНачальный Тогда
				// Добавляемый диапазон полностью умещается в пустое место
				// Просто добавить диапазон
				СтрокаОстатков = ТаблицаОстатков.Вставить(ИндексВставки);
				СтрокаОстатков.Серия = СтрокаДвижения.СерияБСО;
				СтрокаОстатков.СерияИД = СерияИД;
				СтрокаОстатков.СерияБСОНаименование = СтрокаДвижения.СерияБСОНаименование;
				СтрокаОстатков.НомерНачальный = НомерНачальный;
				СтрокаОстатков.НомерКонечный = НомерКонечный;
				СтрокаОстатков.Остаток = КоличествоДвижения;
				НомерНачальный = НомерКонечный + 1;
				ИндексВставки = ИндексВставки + 1;
			Иначе
				// Добавляемый диапазон разбивается на 2.
				// Первая часть просто добавляется, а оставшаяся идет на следующие итерации.
				СтрокаОстатков = ТаблицаОстатков.Вставить(ИндексВставки);
				СтрокаОстатков.Серия = СтрокаДвижения.СерияБСО;
				СтрокаОстатков.СерияИД = СерияИД;
				СтрокаОстатков.СерияБСОНаименование = СтрокаДвижения.СерияБСОНаименование;
				СтрокаОстатков.НомерНачальный = НомерНачальный;
				СтрокаОстатков.НомерКонечный = ТаблицаОстатков[ИндексВставки + 1].НомерНачальный - 1;
				СтрокаОстатков.Остаток = КоличествоДвижения;
				НомерНачальный = СтрокаОстатков.НомерКонечный + 1;
				ИндексВставки = ИндексВставки + 1;
			КонецЕсли;
			
		ИначеЕсли НомерНачальный > ТаблицаОстатков[ИндексВставки].НомерНачальный Тогда
			// Добавляемый диапазон начинается в середине следующего диапазона
			// Разделить следующий диапазон на 2 по НомерНачальный,
			// изменить индекс вставки на вторую половину диапазона
			// и перейти к варианту, когда начальные номера равны
			ТаблицаОстатков.Вставить(ИндексВставки + 1);
			ЗаполнитьЗначенияСвойств(ТаблицаОстатков[ИндексВставки + 1], ТаблицаОстатков[ИндексВставки]);
			ТаблицаОстатков[ИндексВставки + 1].НомерНачальный = НомерНачальный;
			ТаблицаОстатков[ИндексВставки].НомерКонечный = НомерНачальный - 1;
			ИндексВставки = ИндексВставки + 1;
		ИначеЕсли НомерНачальный = ТаблицаОстатков[ИндексВставки].НомерНачальный Тогда
			// Добавляемый диапазон начинается с начала текущего диапазона
			Если НомерКонечный >= ТаблицаОстатков[ИндексВставки].НомерКонечный Тогда
				// Добавляемый диапазон заканчивается за границей проверяемого или равен ему.
				// Нужно разбить добавляемый диапазон на 2, добавить ко всему проверяемуму диапазону
				// и перейти к добавлению следующей части диапазона.
				// Если диапазоны оказались равны, то на этом цикл прервется.
				ТаблицаОстатков[ИндексВставки].Остаток = ТаблицаОстатков[ИндексВставки].Остаток + КоличествоДвижения;
				НомерНачальный = ТаблицаОстатков[ИндексВставки].НомерКонечный + 1;
				ИндексВставки = ИндексВставки + 1;
			Иначе // Если НомерКонечный < ТаблицаОстатков[ИндексВставки].НомерКонечный Тогда
				// Вычитаемый диапазон меньше проверяемого диапазона.
				// Разбить проверяемый диапазон на 2 и перейти к вычитанию из равных диапазонов
				ТаблицаОстатков.Вставить(ИндексВставки + 1);
				ЗаполнитьЗначенияСвойств(ТаблицаОстатков[ИндексВставки + 1], ТаблицаОстатков[ИндексВставки]);
				ТаблицаОстатков[ИндексВставки + 1].НомерНачальный = НомерКонечный + 1;
				ТаблицаОстатков[ИндексВставки].НомерКонечный = НомерКонечный;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	// Диапазоны с нулевым количество удаляются
	ПроверяемыйИндекс = НачальныйИндексВставки;
	Пока ПроверяемыйИндекс < ИндексВставки Цикл
		Если ТаблицаОстатков[ПроверяемыйИндекс].Остаток = 0 Тогда
			ТаблицаОстатков.Удалить(ПроверяемыйИндекс);
			ИндексВставки = ИндексВставки - 1;
		Иначе
			ПроверяемыйИндекс = ПроверяемыйИндекс + 1;
		КонецЕсли;
	КонецЦикла;
	
	// Обработанные диапазоны нужно сравнить с предыдущим и по возможности объединить их
	// Нулевой индекс таблицы не проверяется, т.к. перед ним не строк.
	ПроверяемыйИндекс = Макс(НачальныйИндексВставки, 1);
	Пока ПроверяемыйИндекс <= ИндексВставки И ПроверяемыйИндекс < ТаблицаОстатков.Количество() Цикл
		Если ТаблицаОстатков[ПроверяемыйИндекс - 1].Серия <> ТаблицаОстатков[ПроверяемыйИндекс].Серия Тогда
			// Диапазоны по этой серии закончились
			Прервать;
		ИначеЕсли 1 + ТаблицаОстатков[ПроверяемыйИндекс - 1].НомерКонечный = ТаблицаОстатков[ПроверяемыйИндекс].НомерНачальный
			И ТаблицаОстатков[ПроверяемыйИндекс - 1].Остаток = ТаблицаОстатков[ПроверяемыйИндекс].Остаток Тогда
			// Объединить диапазоны. Предыдущий остается, текущий удаляется.
			ТаблицаОстатков[ПроверяемыйИндекс - 1].НомерКонечный = ТаблицаОстатков[ПроверяемыйИндекс].НомерКонечный;
			ТаблицаОстатков.Удалить(ПроверяемыйИндекс);
			ИндексВставки = ИндексВставки - 1;
		Иначе
			ПроверяемыйИндекс = ПроверяемыйИндекс + 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли