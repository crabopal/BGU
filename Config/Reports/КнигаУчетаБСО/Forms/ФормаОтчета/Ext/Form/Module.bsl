#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьОтчетНаСервере()
	
	Результат.Очистить();

	СхемаКомпоновкиДанных = Отчеты.КнигаУчетаБСО.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Отчет.КомпоновщикНастроек.Настройки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных, , , Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	ДеревоРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);

	ПараметрыГруппировок = Новый Структура;
	ПараметрыГруппировок.Вставить("ЕстьЦМО", ДеревоРезультат.Колонки.Найти("ЦМО") <> Неопределено);
	ПараметрыГруппировок.Вставить("ЕстьСотрудник", ДеревоРезультат.Колонки.Найти("Сотрудник") <> Неопределено);

	Макет = УправлениеПечатью.МакетПечатнойФормы("Отчет.КнигаУчетаБСО.ПФ_MXL_КнигаУчетаБСО");
	Если ПараметрыГруппировок.ЕстьЦМО Или ПараметрыГруппировок.ЕстьСотрудник Тогда
		ОбластьЗаголовок 		= Макет.ПолучитьОбласть("Заголовок");
	Иначе
		ОбластьЗаголовок 		= Макет.ПолучитьОбласть("Заголовок_БезЦМО");
	КонецЕсли;
	ОбластьШапка 				= Макет.ПолучитьОбласть("Шапка");
	ОбластьОстатокНаНачало 		= Макет.ПолучитьОбласть("ОстатокНаНачало");
	ОбластьСтрока 				= Макет.ПолучитьОбласть("Строка");
	ОбластьОстатокНаКонец 		= Макет.ПолучитьОбласть("ОстатокНаКонец");
	ОбластьРасшифровкаОстатка	= Макет.ПолучитьОбласть("РасшифровкаОстатка");
	ОбластьПодвал				= Макет.ПолучитьОбласть("Подвал");

	ПерваяСтраница = Истина;
	ШаблонСтрокиПередачи = "%1 -> %2";

	ТаблицаОстатков = Новый ТаблицаЗначений;
	ТаблицаОстатков.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииБСО"));
	ТаблицаОстатков.Колонки.Добавить("СерияИд", Новый ОписаниеТипов("Строка"));
	ТаблицаОстатков.Колонки.Добавить("СерияБСОНаименование", Новый ОписаниеТипов("Строка"));
	ТаблицаОстатков.Колонки.Добавить("НомерНачальный", Новый ОписаниеТипов("Число"));
	ТаблицаОстатков.Колонки.Добавить("НомерКонечный", Новый ОписаниеТипов("Число"));
	ТаблицаОстатков.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число"));

	Для Каждого ТекОрганизация Из ДеревоРезультат.Строки Цикл

		ВывелиГлавныйЗаголовок = Ложь;

		Для Каждого ТекБСО Из ТекОрганизация.Строки Цикл
			ТаблицаОстатков.Очистить();
			ВывелиНачОстаток = Ложь;
			ПараметрыОстатков = Новый Структура("ИтогоПриход, ИтогоРасход, КонечныйОстаток", 0, 0, 0);
			
			Для Каждого ДетальнаяЗапись Из ТекБСО.Строки Цикл
				Если Не ДетальнаяЗапись.ЭтоОстатокНаНачало Тогда
					Продолжить;
				КонецЕсли;

				Отчеты.КнигаУчетаБСО.ДобавитьДвижениеВТаблицуОстатков(ТаблицаОстатков, ДетальнаяЗапись);

			КонецЦикла;

			Если ТаблицаОстатков.Количество() > 0 Тогда
				Если Не ВывелиГлавныйЗаголовок Тогда
					ВывестиГлавныйЗаголовок(ТекОрганизация, ПараметрыГруппировок, ОбластьЗаголовок, ПерваяСтраница,
						ВывелиГлавныйЗаголовок);
				КонецЕсли;

				ВывестиЗаголовок(ТекБСО, ТаблицаОстатков, ОбластьШапка, ОбластьОстатокНаНачало,
					ОбластьРасшифровкаОстатка, ВывелиНачОстаток);
			КонецЕсли;
			
			// обороты
			Для Каждого ДетальнаяЗапись Из ТекБСО.Строки Цикл
				Если ДетальнаяЗапись.ЭтоОстатокНаНачало Или Не (ЗначениеЗаполнено(ДетальнаяЗапись.Приход)
					Или ЗначениеЗаполнено(ДетальнаяЗапись.Расход)) Тогда
					Продолжить;
				КонецЕсли;

				Если Не ВывелиНачОстаток Тогда
					Если Не ВывелиГлавныйЗаголовок Тогда
						ВывестиГлавныйЗаголовок(ТекОрганизация, ПараметрыГруппировок, ОбластьЗаголовок, ПерваяСтраница,
							ВывелиГлавныйЗаголовок);
					КонецЕсли;
					ВывестиЗаголовок(ТекБСО, ТаблицаОстатков, ОбластьШапка, ОбластьОстатокНаНачало,
						ОбластьРасшифровкаОстатка, ВывелиНачОстаток);
				КонецЕсли;

				ПараметрыСтроки = Новый Структура("ДатаДень, ДатаМесяц, ДатаГод, ЦМОНаименование, ЦМО, РегистраторПредставление, Регистратор, Приход, СерияБСОПриход, НомераБСОПриход, Расход, СерияБСОРасход, НомераБСОРасход, ОстатокНаКонец, СерияБСО, НомераБСО, ОтправительПолучатель");
				ЗаполнитьЗначенияСвойств(ПараметрыСтроки, ДетальнаяЗапись, , "ОстатокНаКонец");
				Если ЗначениеЗаполнено(ДетальнаяЗапись.Приход) Тогда
					ПараметрыСтроки.СерияБСОПриход = ДетальнаяЗапись.СерияБСО;
					ПараметрыСтроки.НомераБСОПриход = ДетальнаяЗапись.ДиапазонНомеров;
				КонецЕсли;
				Если ЗначениеЗаполнено(ДетальнаяЗапись.Расход) Тогда
					ПараметрыСтроки.СерияБСОРасход = ДетальнаяЗапись.СерияБСО;
					ПараметрыСтроки.НомераБСОРасход = ДетальнаяЗапись.ДиапазонНомеров;
				КонецЕсли;
				ПараметрыСтроки.ОтправительПолучатель = СтрШаблон(ШаблонСтрокиПередачи,
					СокрЛП(ДетальнаяЗапись.ОтправительНаименование),
					СокрЛП(ДетальнаяЗапись.ПолучательНаименование));

				ОбластьСтрока.Параметры.Заполнить(ПараметрыСтроки);
				Результат.Вывести(ОбластьСтрока);

				ПараметрыОстатков.ИтогоПриход = ПараметрыОстатков.ИтогоПриход + ДетальнаяЗапись.Приход;
				ПараметрыОстатков.ИтогоРасход = ПараметрыОстатков.ИтогоРасход + ДетальнаяЗапись.Расход;

				Отчеты.КнигаУчетаБСО.ДобавитьДвижениеВТаблицуОстатков(ТаблицаОстатков, ДетальнаяЗапись);

			КонецЦикла;

			Если Не ВывелиНачОстаток Тогда
				Продолжить;
			КонецЕсли;
			
			// конечные остатки

			ПараметрыОстатков.КонечныйОстаток = ТекБСО.ОстатокНаНачало + ПараметрыОстатков.ИтогоПриход
				- ПараметрыОстатков.ИтогоРасход;
			ОбластьОстатокНаКонец.Параметры.Заполнить(ПараметрыОстатков);
			Результат.Вывести(ОбластьОстатокНаКонец);

			ВывестиРасшифровкуОстатков(ТекБСО, ТаблицаОстатков, ОбластьРасшифровкаОстатка);

			Результат.Вывести(ОбластьПодвал);

		КонецЦикла;
	КонецЦикла;

	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект, Истина);

КонецПроцедуры // СформироватьОтчетНаСервере()

&НаСервере
Процедура ВывестиГлавныйЗаголовок(ТекОрганизация, ПараметрыГруппировок, ОбластьЗаголовок, ПерваяСтраница, ВывелиГлавныйЗаголовок)
	Если Не ПерваяСтраница Тогда
		Результат.ВывестиГоризонтальныйРазделительСтраниц();
	Иначе
		ПерваяСтраница = Ложь;
	КонецЕсли;
	
	ОбластьЗаголовок.Параметры.Заполнить(ТекОрганизация);
	ПараметрыПериод = Новый Структура("НачалоПериода, КонецПериода, ЦМОНаименование", Отчет.НачалоПериода, Отчет.КонецПериода);
	Если ПараметрыГруппировок.ЕстьСотрудник Тогда
		ПараметрыПериод.ЦМОНаименование = ТекОрганизация.СотрудникНаименование;
	ИначеЕсли ПараметрыГруппировок.ЕстьЦМО Тогда
		ПараметрыПериод.ЦМОНаименование = ТекОрганизация.МОЛПредставление;
	КонецЕсли;
	ОбластьЗаголовок.Параметры.Заполнить(ПараметрыПериод);
	Результат.Вывести(ОбластьЗаголовок);
	ВывелиГлавныйЗаголовок = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиЗаголовок(ТекБСО, ТаблицаОстатков, ОбластьШапка, ОбластьОстатокНаНачало, ОбластьРасшифровкаОстатка, ВывелиНачОстаток)
	
	Результат.ВывестиГоризонтальныйРазделительСтраниц();
	
	// Начальные остатки
	ОбластьШапка.Параметры.Заполнить(ТекБСО);
	ОбластьШапка.Параметры.Заполнить(Новый Структура("БСО", ТекБСО.БСОНаименование));
	Результат.Вывести(ОбластьШапка);
	
	ОбластьОстатокНаНачало.Параметры.Заполнить(ТекБСО);
	Результат.Вывести(ОбластьОстатокНаНачало);

	ВывестиРасшифровкуОстатков(ТекБСО, ТаблицаОстатков, ОбластьРасшифровкаОстатка);
	ВывелиНачОстаток = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиРасшифровкуОстатков(ТекБСО, ОригинальнаяТаблицаОстатков, ОбластьРасшифровкаОстатка)
	ПараметрыОстатков = Новый Структура("Остаток, Серия, ДиапазонНомеров");
	// Чтобы не сломать сортировку таблицы остатков выводится копия таблицы
	ТаблицаОстатков = ОригинальнаяТаблицаОстатков.Скопировать();
	ТаблицаОстатков.Сортировать("СерияБСОНаименование, НомерНачальный");
	Результат.НачатьГруппуСтрок(,Ложь);
	Для каждого ТекСтрОстатков Из ТаблицаОстатков Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыОстатков, ТекСтрОстатков);
		ПараметрыОстатков.ДиапазонНомеров = УправлениеМатериальнымиЗапасами.ПредставлениеДиапазонаНомеров(
			ТекСтрОстатков.НомерНачальный,
			ТекСтрОстатков.НомерКонечный,
			ТекБСО.БСОДлинаНомера);
		ПараметрыОстатков.Остаток = ТекСтрОстатков.Остаток * (1 + ТекСтрОстатков.НомерКонечный - ТекСтрОстатков.НомерНачальный);
		ОбластьРасшифровкаОстатка.Параметры.Заполнить(ПараметрыОстатков);
		ОбластьРасшифровкаОстатка.Параметры.Заполнить(Новый Структура("Серия", ТекСтрОстатков.СерияБСОНаименование));
		Результат.Вывести(ОбластьРасшифровкаОстатка);
	КонецЦикла; 
	Результат.ЗакончитьГруппуСтрок();
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПанелиНастроек(Пометка)

	Элементы.ГруппаПанельНастроек.Видимость = Пометка;

КонецПроцедуры // УстановитьВидимостьПанелиНастроек()

#Область РасчетПоказателейВыделенныхЯчеек

// Выполняет расчет и вывод показателей выделенной области ячеек.
// См. обработчик события ОтчетТабличныйДокументПриАктивизацииОбласти.
//
&НаКлиенте
Процедура РассчитатьПоказателиДинамически()
	Перем ТекущаяКоманда;
	
	КомандыПоказателей = КомандыПоказателей();
	Для Каждого Команда Из КомандыПоказателей Цикл 
		Если Элементы[Команда.Ключ].Пометка Тогда 
			ТекущаяКоманда = Команда.Ключ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	РассчитатьПоказатели(ТекущаяКоманда);
КонецПроцедуры

// Выполняет расчет и вывод показателей выделенных областей ячеек табличного документа.
//
// Параметры:
//  ТекущаяКоманда - Строка - имя команды расчета показателя, например, "РассчитатьСумму".
//                      Определяет, какой показатель является основным.
//
&НаКлиенте
Процедура РассчитатьПоказатели(ТекущаяКоманда = "РассчитатьСумму")
	// Расчет показателей.
	ПараметрыРасчета = ОбщегоНазначенияБГУКлиент.ПараметрыРасчетаПоказателейЯчеек(Элементы.Результат);
	Если ПараметрыРасчета.РассчитатьНаСервере Тогда 
		РасчетныеПоказатели = РасчетныеПоказателиСервер(ПараметрыРасчета);
	Иначе
		РасчетныеПоказатели = ОбщегоНазначенияБГУКлиентСервер.РасчетныеПоказателиЯчеек(
			Результат, ПараметрыРасчета.ВыделенныеОбласти);
	КонецЕсли;
	
	// Установка значений показателей.
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РасчетныеПоказатели);
	
	// Переключение и форматирование показателей.
	КомандыПоказателей = КомандыПоказателей();
	Для Каждого Команда Из КомандыПоказателей Цикл 
		Элементы[Команда.Ключ].Пометка = Ложь;
		
		ЗначениеПоказателя = РасчетныеПоказатели[Команда.Значение];
		РазрядностьПоказателя = Мин(СтрДлина(Макс(ЗначениеПоказателя, -ЗначениеПоказателя) % 1) - 2, 4);
		
		Элементы[Команда.Значение].ФорматРедактирования = "ЧДЦ=" + РазрядностьПоказателя + "; ЧРГ=' '; ЧН=0";
	КонецЦикла;
	Элементы[ТекущаяКоманда].Пометка = Истина;
	
	// Вывод основного показателя.
	ТекущийПоказатель = КомандыПоказателей[ТекущаяКоманда];
	Показатель = ЭтотОбъект[ТекущийПоказатель];
	Элементы.Показатель.ФорматРедактирования = Элементы[ТекущийПоказатель].ФорматРедактирования;
	Элементы.ГруппаВидыПоказателей.Картинка = БиблиотекаКартинок[ТекущийПоказатель];
КонецПроцедуры

// Рассчитывает показатели числовых ячеек в табличном документе.
//  см. ОтчетыКлиентСервер.РасчетныеПоказателиЯчеек.
//
&НаСервере
Функция РасчетныеПоказателиСервер(ПараметрыРасчета)
	Возврат ОбщегоНазначенияБГУКлиентСервер.РасчетныеПоказателиЯчеек(Результат, ПараметрыРасчета.ВыделенныеОбласти);
КонецФункции

// Определяет соответствие между командами расчета показателей и показателями.
//
// Возвращаемое значение:
//   Соответствие - Ключ - имя команды, Значение - имя показателя.
//
&НаКлиенте
Функция КомандыПоказателей()
	КомандыПоказателей = Новый Соответствие();
	КомандыПоказателей.Вставить("РассчитатьСумму", "Сумма");
	КомандыПоказателей.Вставить("РассчитатьКоличество", "Количество");
	КомандыПоказателей.Вставить("РассчитатьСреднее", "Среднее");
	КомандыПоказателей.Вставить("РассчитатьМинимум", "Минимум");
	КомандыПоказателей.Вставить("РассчитатьМаксимум", "Максимум");
	
	Возврат КомандыПоказателей;
КонецФункции

// Управляет признаком видимости панели расчетных показателей.
//
// Параметры:
//  Видимость - Булево - Признак включения / выключения видимости панели показателей.
//              См. также Синтакс-помощник: ГруппаФормы.Видимость.
//
&НаКлиенте
Процедура УстановитьВидимостьПоказателей(Видимость)
	Элементы.ОбластьПоказателей.Видимость = Видимость;
	Элементы.РассчитатьВсеПоказатели.Пометка = Видимость;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

