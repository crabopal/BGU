
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	КлючВарианта = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "КлючВарианта", "");
	Результат.КлючПараметровПечати = "КнигаУчетаБСО_" + КлючВарианта;

	РегистрыУчета.ПриСозданииНаСервере(ЭтаФорма);
	
	Если НЕ ЗначениеЗаполнено(Отчет.Организация) Тогда
			Отчет.Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	КонецЕсли;

	Элементы.ПанельНастроек.Пометка = НЕ Параметры.СформироватьПриОткрытии = Истина;
	УстановитьВидимостьПанелиНастроек(Элементы.ПанельНастроек.Пометка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Отчет.КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	РассчитатьПоказатели();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = НСтр("ru = 'Настройки были изменены. Все изменения будут потеряны.'");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Отчет.КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки = "";
	Отчет.КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки = "Отбор";
	Если Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("НачалоПериода") Тогда
		Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Удалить("НачалоПериода");
	КонецЕсли;
	Если Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("КонецПериода") Тогда
		Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Удалить("КонецПериода");
	КонецЕсли;
	Если ЗначениеЗаполнено(Отчет.НачалоПериода) Тогда
		Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("НачалоПериода", Отчет.НачалоПериода);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отчет.КонецПериода) Тогда
		Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("КонецПериода", Отчет.КонецПериода);
	КонецЕсли;
	
	ВариантМодифицирован = Ложь;
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	Отчет.КомпоновщикНастроек.Настройки.Отбор.ИдентификаторПользовательскойНастройки = "Отбор";
	Отчет.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(Настройки);
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Отчет.КомпоновщикНастроек.ПолучитьНастройки());
	Настройки.ДополнительныеСвойства.Свойство("НачалоПериода", Отчет.НачалоПериода);
	Настройки.ДополнительныеСвойства.Свойство("КонецПериода", Отчет.КонецПериода);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура КонецПериодаПриИзменении(Элемент)
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ПолеОрганизация = Новый ПолеКомпоновкиДанных("ОрганизацияОтбор");
	ЕстьОтборОрганизация = Ложь;
	Для каждого ТекСтр Из Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
	
		Если ТекСтр.ЛевоеЗначение=ПолеОрганизация Тогда
			ЕстьОтборОрганизация = Истина;
			Если ТекСтр.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				И ТекСтр.Использование = Истина Тогда
				
				ТекСтр.ПравоеЗначение = Отчет.Организация;
				ТекСтр.Использование = Истина;
				ЕстьОтборОрганизация = Истина;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла; 
	Если Не ЕстьОтборОрганизация Тогда
		НовОтбор = Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовОтбор.ЛевоеЗначение = ПолеОрганизация;
		НовОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		НовОтбор.ПравоеЗначение = Отчет.Организация;
		НовОтбор.Использование = ЗначениеЗаполнено(Отчет.Организация);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент)
	ПодключитьОбработчикОжидания("РассчитатьПоказателиДинамически", 0.2, Истина);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыНастроекНастройкиОтбор

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиОтборПриИзменении(Элемент)
	ПолеОрганизация = Новый ПолеКомпоновкиДанных("Организация");
	ТекущиеДанные = Элементы.КомпоновщикНастроекНастройкиОтбор.ТекущиеДанные;
	Если ТекущиеДанные.ЛевоеЗначение = ПолеОрганизация
		И ТекущиеДанные.ВидСравнения = "Равно" Тогда
		Для каждого ТекСтр Из Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
			Если ТекСтр.ЛевоеЗначение=ПолеОрганизация 
				И ТекСтр.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
		
				Отчет.Организация = ТекСтр.ПравоеЗначение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	Если ЗначениеЗаполнено(Отчет.НачалоПериода) 
		И ЗначениеЗаполнено(Отчет.КонецПериода)
		И Отчет.НачалоПериода>Отчет.КонецПериода Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Дата начала не может быть больше даты окончания'"),,"Отчет.НачалоПериода");
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	Для каждого ТекСтр Из Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
	
		Если ТекСтр.Использование = Истина И ПустаяСтрока(Строка(ТекСтр.ЛевоеЗначение)) Тогда
			ТекСтр.Использование = Ложь;			
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнено поле отбора'"),,"КомпоновщикНастроекНастройкиОтбор["+(ТекСтр.ТекущаяСтока-1)+"].ЛевоеЗначение",,Отказ);
		КонецЕсли;
	
	КонецЦикла; 
	
	ПараметрНачалоПериода = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("НачалоПериода");
	ПараметрНачалоПериода.Значение 				= Отчет.НачалоПериода;
	ПараметрНачалоПериода.Использование 		= Истина;
	ПараметрКонецПериода = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("КонецПериода");
	ПараметрКонецПериода.Значение 				= КонецДня(Отчет.КонецПериода);
	ПараметрКонецПериода.Использование 			= Истина;
	ПараметрПодразделение = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Подразделение");
	ПараметрПодразделение.Значение				= Отчет.Подразделение;
	ПараметрПодразделение.Использование 		= ЗначениеЗаполнено(Отчет.Подразделение);
	ПараметрНачальныйПериодЗадан = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("НачальныйПериодЗадан");
	ПараметрНачальныйПериодЗадан.Значение 		= ЗначениеЗаполнено(Отчет.НачалоПериода);
	ПараметрНачальныйПериодЗадан.Использование 	= Истина;
	ПараметрКонечныйПериодЗадан = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("КонечныйПериодЗадан");
	ПараметрКонечныйПериодЗадан.Значение 		= ЗначениеЗаполнено(Отчет.КонецПериода);
	ПараметрКонечныйПериодЗадан.Использование	= Истина;
	
	ИспользоватьУчетПоПодразделениям = ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоПодразделениям")
										И БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьПризнакиУчета("03").УчетПоПодразделениям;
	ПараметрИспользоватьУчетПоПодразделениям = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("ИспользоватьУчетПоПодразделениям");
	ПараметрИспользоватьУчетПоПодразделениям.Значение 		= ИспользоватьУчетПоПодразделениям;
	ПараметрИспользоватьУчетПоПодразделениям.Использование	= Истина;

	СформироватьОтчетНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПанельНастроек(Команда)
	Элементы.ПанельНастроек.Пометка = Не Элементы.ПанельНастроек.Пометка;
	УстановитьВидимостьПанелиНастроек(Элементы.ПанельНастроек.Пометка);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
    Диалог.Период.ДатаНачала = Отчет.НачалоПериода;
    Диалог.Период.ДатаОкончания = Отчет.КонецПериода;
    Диалог.Показать(Новый ОписаниеОповещения("УстановитьПериодЗавершение", ЭтотОбъект));

	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодЗавершение(Период, ДополнительныеПараметры) Экспорт
	
	Если Период <> Неопределено Тогда
		
		Отчет.НачалоПериода = Период.ДатаНачала;
        Отчет.КонецПериода  = Период.ДатаОкончания;
		
		Модифицированность = Истина;
				
		СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);

    КонецЕсли; 

КонецПроцедуры

