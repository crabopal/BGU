Процедура РассчитатьМинимум(Команда)
	РассчитатьПоказатели(Команда.Имя);
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьМаксимум(Команда)
	РассчитатьПоказатели(Команда.Имя);
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьВсеПоказатели(Команда)
	УстановитьВидимостьПоказателей(Не Элементы.РассчитатьВсеПоказатели.Пометка);
КонецПроцедуры

&НаКлиенте
Процедура СвернутьПоказатели(Команда)
	УстановитьВидимостьПоказателей(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьПараметрыНомераЖурналаНаСервере()
	
	ЕстьПоказатель = Ложь;
	ЕстьРазделитель = Ложь;
	
	Если ЗначениеЗаполнено(Отчет.НомерЖурнала) Тогда
		
		МежотчетныйПериод = ПолучитьМежотчетныйПериодСервер(Отчет.НомерЖурнала);
		
		ЕстьПоказатель = ЗначениеЗаполнено(Отчет.НомерЖурнала.ПоказательСтрока);
		ЕстьРазделитель = ЗначениеЗаполнено(Отчет.НомерЖурнала.РазделительСтрока);
		
		СтруктураПоказателя = Новый Структура("ПоказательСтрока, ЭтоСубконто, ТипПоказателя, ТипРеквизита", Отчет.НомерЖурнала.ПоказательСтрока, Ложь, Отчет.НомерЖурнала.Показатель);
		СтруктураПоказателя = Справочники.Журналы.ЗаполнитьПоказательПоСтроке(СтруктураПоказателя);
		СтруктураРазделителя = Новый Структура("ПоказательСтрока, ЭтоСубконто, ТипПоказателя, ТипРеквизита", Отчет.НомерЖурнала.РазделительСтрока, Ложь, Отчет.НомерЖурнала.РазделительОпераций);
		СтруктураРазделителя = Справочники.Журналы.ЗаполнитьПоказательПоСтроке(СтруктураРазделителя);
		
		Схема = ПолучитьИзВременногоХранилища(СхемаКомпоновкиДанных);
		
		Для Каждого ЭлементНастройки Из Схема.НаборыДанных.НачальныеОстатки.Поля Цикл
			Если ЭлементНастройки.Поле = "Показатель" Тогда
				ЭлементНастройки.ТипЗначения = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(СтруктураПоказателя.ТипРеквизита)));
			ИначеЕсли ЭлементНастройки.Поле = "Разделитель" Тогда
				ЭлементНастройки.ТипЗначения = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(СтруктураРазделителя.ТипРеквизита)));
			КонецЕсли;
		КонецЦикла;	

		СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(Схема, УникальныйИдентификатор);
				
	КонецЕсли;	

	УстановитьГруппировкуПоРазделителю();

КонецПроцедуры	

&НаСервере
Функция ПолучитьОтветственноеЛицоОрганизации(Организация, Лицо)
	
	Если Лицо = "ГлавныйБухгалтер" Тогда
		Лицо = Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер;
	КонецЕсли;
	Возврат ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(Организация, Лицо, ТекущаяДатаСеанса());
	
КонецФункции

&НаСервере
Процедура УстановитьГруппировкуПоРазделителю()
	
	Если ЗначениеЗаполнено(Отчет.НомерЖурнала) И ЗначениеЗаполнено(Отчет.НомерЖурнала.РазделительСтрока) Тогда
		Элементы.ГруппироватьПоРазделителю.Видимость = Истина;
	Иначе	
		Отчет.ГруппироватьПоРазделителю = Ложь; 
		Элементы.ГруппироватьПоРазделителю.Видимость = Ложь;
	КонецЕсли; 
	
КонецПроцедуры 

&НаСервере
Процедура УдалитГруппировкуРазделительНаСервере()
	
	КУдалению = Отчет.Группировка.НайтиСтроки(Новый Структура("Поле", "Разделитель"));
	
	Для Каждого Стр Из КУдалению Цикл
		
		Отчет.Группировка.Удалить(Стр);
		
	КонецЦикла;	
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовка(Форма)
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМежотчетныйПериодСервер(ОтчетЖурнал)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетЖурнал, "МежотчетныйПериод"); 
	
КонецФункции	

&НаКлиенте
Функция ПолучитьЗапрещенныеПоля(Режим = "") Экспорт
	
	СписокПолей = Новый Массив;
	
	СписокПолей.Добавить("UserFields");
	СписокПолей.Добавить("DataParameters");
	СписокПолей.Добавить("SystemFields");
	СписокПолей.Добавить("Показатели");
	// СписокПолей.Добавить("Период");
	
	СписокПолей.Добавить("ДвиженияИлиГраницаПериода");
	СписокПолей.Добавить("ОборотДляГлавнойКниги");
	СписокПолей.Добавить("СальдоНаНачалоПериода");
	СписокПолей.Добавить("ОборотыЗаПериод");
	СписокПолей.Добавить("СальдоНаКонецПериода");
	СписокПолей.Добавить("Общий");
	
	Если НЕ ЕстьРазделитель Тогда
		СписокПолей.Добавить("Разделитель");
	КонецЕсли;
	
	Если НЕ ЕстьПоказатель Тогда
		СписокПолей.Добавить("Показатель");
	КонецЕсли;
	
	Если Режим = "Выбор" Тогда
		Для Каждого ДоступноеПоле Из Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.Элементы Цикл
			Если ДоступноеПоле.Ресурс Тогда
				СписокПолей.Добавить(Строка(ДоступноеПоле.Поле));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ФОУчетПоПодразделениям Тогда
		СписокПолей.Добавить("Подразделение");
	КонецЕсли;
	
	Если Режим = "Группировка" Тогда
		Если Отчет.ГруппироватьПоРазделителю Тогда
			СписокПолей.Добавить("Разделитель");
	    КонецЕсли;
	ИначеЕсли Режим = "Отбор" ИЛИ Режим = "Порядок" Тогда
		Для Каждого ДоступноеПоле Из Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.Элементы Цикл
			Если ДоступноеПоле.Ресурс Тогда
				СписокПолей.Добавить(Строка(ДоступноеПоле.Поле));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Новый ФиксированныйМассив(СписокПолей);
	
КонецФункции

&НаКлиенте
Процедура УстановитьДатыПоВидуПериода()
	
	Если МежотчетныйПериод Тогда 
		Если НЕ Отчет.КонецПериода = КонецГода(Отчет.КонецПериода) Тогда
			Отчет.КонецПериода = КонецГода(Отчет.КонецПериода);
		КонецЕсли;
		Если НЕ Отчет.НачалоПериода = КонецГода(Отчет.КонецПериода) Тогда
			Отчет.НачалоПериода = КонецГода(Отчет.КонецПериода)
	    КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

