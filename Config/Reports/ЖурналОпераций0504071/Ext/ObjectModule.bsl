#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем НаборПоказателей Экспорт;
Перем ВысотаШапки;
Перем ВременныеДанныеОтчета;
Перем ПоляБезГруппировкиИтогов;

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеОтчеты

Функция ПолучитьПараметрыИсполненияОтчета() Экспорт
	
	Возврат Новый Структура(
		"ИспользоватьПередКомпоновкойМакета,
		|ИспользоватьПослеКомпоновкиМакета,
		|ИспользоватьПриВыводеЗаголовка,
		|ИспользоватьПослеВыводаРезультата,
		|ИспользоватьДанныеРасшифровки,
		|ИспользоватьПередВыводомЭлементаРезультата,
		|ИспользоватьПриВыводеПодвала,
		|ВыводитьОтладочнуюИнформацию,
		|ИспользоватьПривилегированныйРежим",
		Истина, Истина, Истина, Истина, Истина, Ложь, Истина, Истина, Истина);
	
КонецФункции

Процедура ПриВыводеЗаголовка(Результат, ВыводитьПолностью) Экспорт
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "СтрокаПериода", ПредставлениеПериода(НачалоДня(НачалоПериода), КонецДня(КонецПериода), "ФП"));

	СведенияОрг = СведенияОбОрганизации();
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Учреждение", СведенияОрг.Учреждение);
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КодОКПО", СведенияОрг.КодОКПО);

	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Учредитель", СведенияОрг.Учредитель);
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Бюджет", СведенияОрг.Бюджет);
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Подразделение", Подразделение);

	ОписаниеЖурнала = СформироватьОписаниеЖурнала();
			
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ОписаниеЖурнала", ОписаниеЖурнала);

	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ГлавБух", Корреспонденты.ФИОПоОбъекту(ГлавБух,, ТекущаяДатаСеанса()));
	
	ДанныеСотрудника = ПолучитьДанныеИсполнителя();
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Исполнитель", ДанныеСотрудника.ФИО);
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ИсполнительДолжность", ДанныеСотрудника.Должность);
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ТелефонИсполнителя", ДанныеСотрудника.ТелефонИсполнителя);

	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ЭлектроннаяПочтаИсполнителя", ДанныеСотрудника.ЭлектроннаяПочтаИсполнителя);

	ТекстОтбор = СтандартныеОтчеты.ПолучитьТекстОтбора(КомпоновщикНастроек.Настройки.Отбор, "Организация");
	
	Если ЗначениеЗаполнено(ТекстОтбор) Тогда
		ТекстОтбор = "Примечание. В документе отражены данные, отвечающие условиям: " +  ТекстОтбор;
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ТекстОтбор", ТекстОтбор);

КонецПроцедуры

Процедура ПриВыводеПодвала(Результат) Экспорт
	
	// Если отчет пустой выводим шапку и подвал.
	
	Если Результат.ВысотаТаблицы < 2 Тогда
		
		Результат.Очистить();
		
