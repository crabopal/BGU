	Если ЗначениеЗаполнено(Разделитель) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "Разделитель", Разделитель,,, Ложь);
	КонецЕсли;
	
	НаборДанных.Запрос = ТекстЗапроса;
	
	СтандартныеОтчеты.ДобавитьОтборПоОрганизации(ЭтотОбъект);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ЗначениеЗаполнено(Подразделение) Тогда
		// Если среди доступных организаций, нет выбранной, то оставляем фильтр по доступным организациям
		НовыйОтбор = СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "Подразделение", Подразделение,,, Истина);
		НовыйОтбор.Представление = "###ОтборПоПодразделение###"; 
		НовыйОтбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;

КонецПроцедуры

Процедура ПослеВыводаРезультата(Результат) Экспорт
	
	СтандартныеОтчеты.ОбработкаРезультатаОтчета(ЭтотОбъект, Результат);
	Если Результат.Области.Найти("Заголовок") <> Неопределено Тогда
		Результат.ФиксацияСверху = Результат.Области.Заголовок.Низ + ВысотаШапки;
		Результат.ПовторятьПриПечатиСтроки = Результат.Область("R" + (Результат.Области.Заголовок.Низ) + ":R" + (Результат.Области.Заголовок.Низ + 3));
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеКомпоновкиМакета(МакетКомпоновки) Экспорт
	
	КоличествоГруппировок = 0;
	ГруппировкаСчет = ложь;
	Для Каждого Гр Из Группировка Цикл
		Если Гр.Использование Тогда
			КоличествоГруппировок = КоличествоГруппировок + 1;
			Если Гр.Представление = "Счет" Тогда
				ГруппировкаСчет = Истина;
			КонецЕсли
		КонецЕсли;
	КонецЦикла;
	
	ВременныеДанныеОтчета = Новый Структура;
	Если ГруппировкаСчет Тогда
		ЗначенияПоказателей = Новый Массив(10);
		Для Индекс = 0 По 9 Цикл
			ЗначенияПоказателей[Индекс] = 0;
		КонецЦикла;
		МакетГруппировкиСчет = СтандартныеОтчеты.ПолучитьМакетГруппировкиПоПолюГруппировки(МакетКомпоновки, "Счет");
		ВременныеДанныеОтчета.Вставить("МакетСчет", МакетГруппировкиСчет);
		ВременныеДанныеОтчета.Вставить("ЗначенияПоказателей", ЗначенияПоказателей);
	КонецЕсли;
	
	МакетПодвалаОтчета = СтандартныеОтчеты.ПолучитьМакетПодвала(МакетКомпоновки);
	Если МакетПодвалаОтчета <> Неопределено Тогда
		ВременныеДанныеОтчета.Вставить("МакетПодвал", МакетПодвалаОтчета);
	КонецЕсли;
	
КонецПроцедуры

