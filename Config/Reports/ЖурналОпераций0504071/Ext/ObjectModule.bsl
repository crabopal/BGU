		СведенияОрг.Вставить("ДатаОтчета", КонецДня(КонецПериода) + 1); 
		СведенияОрг.Вставить("ОписаниеЖурнала", СформироватьОписаниеЖурнала());
		СведенияОрг.Вставить("НомерЖурнала", НомерЖурнала);
		СведенияОрг.Вставить("ДатаНачала", Формат(НачалоПериода, "ДФ=dd.MM.yyyy"));
