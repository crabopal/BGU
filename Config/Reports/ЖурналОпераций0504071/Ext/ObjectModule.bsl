Функция ПолучитьТекстЗаголовка(ОрганизацияВНачале = Истина) Экспорт 
	
	Возврат "Журнал операций";
	
КонецФункции

// В процедуре можно доработать компоновщик перед выводом в отчет
// Изменения сохранены не будут
Процедура ПередКомпоновкойМакета(Схема) Экспорт
	
	ГруппировкаПоРазделителю = (Группировка.НайтиСтроки(Новый Структура("Использование,Поле", Истина, "Разделитель")).Количество() > 0) ИЛИ ГруппироватьПоРазделителю;
	
	Схема.Макеты.Найти(Схема.МакетыПолей.Найти("Общий").Макет).Параметры.ПоРазделителю.Выражение = "Представление(СтандартныеОтчеты.ПредставлениеРазделителя(Разделитель))";
	
	Если ЗначениеЗаполнено(НомерЖурнала) Тогда
		
		// Получаем Показатели
		СтруктураПоказателя = Новый Структура("ПоказательСтрока, ЭтоСубконто, ТипПоказателя, ТипРеквизита", НомерЖурнала.ПоказательСтрока, Ложь, НомерЖурнала.Показатель);
		СтруктураПоказателя = Справочники.Журналы.ЗаполнитьПоказательПоСтроке(СтруктураПоказателя);
		
		// Получаем Разделители
		Если ГруппировкаПоРазделителю Тогда
			НомерЖурналаРазделительСтрока = НомерЖурнала.РазделительСтрока;
			НомерЖурналаРазделительОпераций = НомерЖурнала.РазделительОпераций;
		Иначе
			НомерЖурналаРазделительСтрока = "";
			НомерЖурналаРазделительОпераций = Неопределено;
		КонецЕсли;	
		СтруктураРазделителя = Новый Структура("ПоказательСтрока, ЭтоСубконто, ТипПоказателя, ТипРеквизита", НомерЖурналаРазделительСтрока, Ложь, НомерЖурналаРазделительОпераций);
		СтруктураРазделителя = Справочники.Журналы.ЗаполнитьПоказательПоСтроке(СтруктураРазделителя);
		
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НомерЖурнала", НомерЖурнала);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВидСубконтоПоказатель", СтруктураПоказателя.ТипПоказателя);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВидСубконтоРазделитель", СтруктураРазделителя.ТипПоказателя);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ОстаткиВРазрезеПоказателя", НомерЖурнала.ОстаткиВРазрезеПоказателя);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыбиратьСНомеромЖурналаСчета", НомерЖурнала.ВыбиратьПроводкиСНомеромЖурналаСчета);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыбиратьСНомеромЖурнала", Истина);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НеВыбиратьИзСпискаЖО", НЕ НомерЖурнала.ВыбиратьИзСпискаЖО.Количество());
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НеВыводитьОстатки", НомерЖурнала.НеВыводитьОстатки);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НеВыводитьОстаткиПоКЭК", НомерЖурнала.НеВыводитьОстаткиПоКЭК);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "СворачиватьОднотипныеПроводки", СворачиватьОднотипныеПроводки);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "МежотчетныйПериод", НомерЖурнала.МежотчетныйПериод);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ГруппироватьПоРазделителю", ГруппировкаПоРазделителю);

		СписокЖО = Новый СписокЗначений;
		Если НомерЖурнала.ВыбиратьИзСпискаЖО.Количество() Тогда
			МассивЖО = НомерЖурнала.ВыбиратьИзСпискаЖО.ВыгрузитьКолонку("Журнал");
			Для Каждого ЖО из МассивЖО Цикл
				СписокЖО.Добавить(Справочники.Журналы.НайтиПоКоду(ЖО));
			КонецЦикла;
		КонецЕсли;
		
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "СписокЖурналовОпераций", СписокЖО);
		
	КонецЕсли;
	
	ГраницаНачало 	= ?(ЗначениеЗаполнено(НачалоПериода), НачалоДня(НачалоПериода), Дата(1, 1, 1));
	ГраницаКонец 	= ?(ЗначениеЗаполнено(КонецПериода),
	                    Бухгалтерскийучет.КонецПериодаСУточнением(КонецПериода, ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ЗаключениеСчетов")),
	                    Дата(3999, 12, 31));
	
	Если НомерЖурнала.МежотчетныйПериод Тогда
		
		ГраницаНачало = Бухгалтерскийучет.НачалоПериодаСУточнением(
		?(ЗначениеЗаполнено(КонецПериода), КонецПериода, Дата(3999, 12, 31)),  
		ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ИзменениеВалютыБаланса"), Истина);
		
		ГраницаКонец = Бухгалтерскийучет.КонецПериодаСУточнением(
		?(ЗначениеЗаполнено(КонецПериода), КонецПериода, Дата(3999, 12, 31)),  
		ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ИзменениеВалютыБаланса"));
		
	КонецЕсли;	
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода", ГраницаНачало);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода", ГраницаКонец);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериодаДата", НачалоПериода);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериодаДата", КонецПериода);
		
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "СворачиватьОднотипныеПроводки", СворачиватьОднотипныеПроводки);
	ЖурОп = "Журнал операций ";
	Жур = "Журнал ";
	ДлинаВырезания = 0;
	Если Найти(НомерЖурнала.Наименование, ЖурОп) Тогда
		ДлинаВырезания = СтрДлина(ЖурОп);
	ИначеЕсли Найти(НомерЖурнала.Наименование, Жур) Тогда
		ДлинаВырезания = СтрДлина(Жур);
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ОписаниеЖурнала", Сред(НомерЖурнала.Наименование, ДлинаВырезания + 1));
	
	Если ЗначениеЗаполнено(Организация) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Организация", Организация);
		Если ЗначениеЗаполнено(Подразделение) Тогда
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Подразделение", Подразделение);
		Иначе
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Подразделение", Справочники.Журналы.ПустаяСсылка());
		КонецЕсли
	КонецЕсли;
	
	Если Группировка.НайтиСтроки(Новый Структура("Использование", Истина)).Количество() > 0 Тогда
		
		Тело = Новый СписокЗначений();
		
		НомерГруппировки = 1;
		Структура = КомпоновщикНастроек.Настройки.Структура[0].Структура[0];
		Структура.Структура.Очистить(); // удаляем 3 группировки
		
		ГруппировкаБезИтогов = Ложь;
		
		Для каждого ГруппировкаОтчета из Группировка Цикл
			
			Если ГруппировкаОтчета.Использование Тогда
				
				Если ГруппировкаОтчета.Поле = "Разделитель" Тогда
					КомпоновщикНастроек.Настройки.Структура[0].ПоляГруппировки.Элементы.Очистить();
					ПолеОбщее = КомпоновщикНастроек.Настройки.Структура[0].ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
					ПолеОбщее.Использование  = Истина;
					ПолеОбщее.Поле = Новый ПолеКомпоновкиДанных("Общий");
