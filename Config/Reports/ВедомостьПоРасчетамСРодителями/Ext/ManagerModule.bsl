// Вызывается при работе в модели сервиса для получения сведений о предопределенных вариантах отчета.
//
// Возвращаемое значение:
//  Массив из Структура:
//    * Имя           - Строка - имя варианта отчета; например, "Основной";
//    * Представление - Строка - имя варианта отчета; например, НСтр("ru = 'Динамика изменений файлов'").
//
Функция ВариантыНастроек() Экспорт
	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("Имя, Представление", "ВедомостьРасчетовГруппировка", НСтр("ru = 'Ведомость расчетов по родительской плате (по группе)'")));
	Результат.Добавить(Новый Структура("Имя, Представление", "ВедомостьРасчетовСписок", НСтр("ru = 'Ведомость расчетов по родительской плате (списком)'")));
	Результат.Добавить(Новый Структура("Имя, Представление", "ВедомостьРасчетовСводно", НСтр("ru = 'Ведомость расчетов по родительской плате (сводно)'")));
	Результат.Добавить(Новый Структура("Имя, Представление", "ВедомостьРасчетовПроизвольный", НСтр("ru = 'Ведомость расчетов по родительской плате (без оформления)'")));
	Возврат Результат;
КонецФункции

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ВедомостьРасчетовГруппировка");
	НастройкиВарианта.Описание = НСтр("ru = 'Полная информация о начислениях, последней оплате, компенсации, ставке оплаты, льготе. Включает данные плательщика. Вывод по группам детского учреждения.'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ВедомостьРасчетовСписок");
	НастройкиВарианта.Описание = НСтр("ru = 'Полная информация о начислениях, последней оплате, компенсации, ставке оплаты, льготе. Включает данные плательщика. Без учета групп детского учреждения.'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ВедомостьРасчетовСводно");
	НастройкиВарианта.Описание = НСтр("ru = 'Информация о начислениях и оплатах по группам детского учреждения/детям без учета договоров.'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ВедомостьРасчетовПроизвольный");
	НастройкиВарианта.Описание = НСтр("ru = 'Произвольный вариант на основе варианта ""Ведомость расчетов по родительской плате (по группе)"". Предназначен для произвольного изменения пользователем.'");
	
КонецПроцедуры

