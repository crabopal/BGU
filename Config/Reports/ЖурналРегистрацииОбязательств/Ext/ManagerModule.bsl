#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

Функция ЭтоРегистрУчета() Экспорт
	
	Возврат Истина;
	
КонецФункции

Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	СвойстваРегистраУчета.Вставить("НачалоПериода", ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0].Значение.ДатаНачала);
	СвойстваРегистраУчета.Вставить("КонецПериода", 	ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0].Значение.ДатаОкончания);
	СвойстваРегистраУчета.Вставить("Организация", 	ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].Значение);
	СвойстваРегистраУчета.Вставить("Подразделение", ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[2].Значение);
	
КонецПроцедуры	

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ЖурналРегистрацииОбязательств");
	НастройкиВарианта.Описание = НСтр("ru = 'Журнал регистрации обязательств ф. 0504064'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ЖурналРегистрацииОбязательствПодробный");
	НастройкиВарианта.Описание = НСтр("ru = 'Подробный журнал регистрации с выводом всех документов по обязательству'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ЖурналРегистрацииОбязательствКонтекст");
	НастройкиВарианта.Включен = Ложь;
	
КонецПроцедуры

Функция СвойстваОбъектаДляРасшифровкиСтандартнымиОтчетами(ОтчетОбъект) Экспорт
	
	СвойстваОбъекта = Новый Структура;

	ПараметрыПериода = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Период");
	Если НЕ ПараметрыПериода = Неопределено Тогда
		ПараметрыПериодаПользовательскаяНастройка = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрыПериода.ИдентификаторПользовательскойНастройки);
		Если НЕ ПараметрыПериодаПользовательскаяНастройка = Неопределено Тогда
			ПараметрыПериода = ПараметрыПериодаПользовательскаяНастройка;
		КонецЕсли;
	Иначе
		Возврат Новый Структура;
	КонецЕсли;
	
	Если ПараметрыПериода.Использование Тогда
		СвойстваОбъекта.Вставить("НачалоПериода", ПараметрыПериода.Значение.ДатаНачала);
		СвойстваОбъекта.Вставить("КонецПериода", ПараметрыПериода.Значение.ДатаОкончания);
	Иначе
		СвойстваОбъекта.Вставить("НачалоПериода", Дата(1,1,1));
		СвойстваОбъекта.Вставить("КонецПериода", Дата(1,1,1));
	КонецЕсли;

	ПараметрОрганизация = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Организация");
	Если НЕ ПараметрОрганизация = Неопределено Тогда
		СвойстваОбъекта.Вставить("Организация", ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрОрганизация.ИдентификаторПользовательскойНастройки).Значение);
	КонецЕсли;
				
	МассивОтчетов = Новый Массив;
	МассивОтчетов.Добавить("КарточкаСчета");
		
	СвойстваОбъекта.Вставить("ОтчетыРасшифровки", МассивОтчетов);
	
	Возврат СвойстваОбъекта;
	
КонецФункции

#КонецОбласти 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РеквизитСотрудника(Реквизит, Сотрудник) Экспорт
	
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат УправлениеПечатьюБГУ.ПолучитьРеквизитСотрудника(Реквизит, Сотрудник, ТекущаяДатаСеанса());
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции	

#КонецОбласти 

#КонецЕсли
