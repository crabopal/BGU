////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.Подразделение.АвтоОтметкаНезаполненного = 	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") 
														И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.32"))
																										.УчетПоПодразделениям;
	
	Параметры.Свойство("МенюТребование", Отчет.МенюТребование);
	
	Если ЗначениеЗаполнено(Отчет.МенюТребование) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Отчет.МенюТребование, "Организация, Дата, ЦМО, Подразделение");
		
		Отчет.Дата = ЗначенияРеквизитов.Дата;
		Отчет.Организация = ЗначенияРеквизитов.Организация;
		Отчет.ЦМО = ЗначенияРеквизитов.ЦМО;
		Отчет.Подразделение = ЗначенияРеквизитов.Подразделение;
		
		ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
		
		Если ПроверитьЗаполнениеРеквизитовОтчета() Тогда
			ОтчетОбъект.СформироватьОтчетПоДокументу(Результат);
		КонецЕсли;
		
		Элементы.Дата.Доступность			= Ложь;
		Элементы.Организация.Доступность 	= Ложь;
		Элементы.ЦМО.Доступность 			= Ложь;
		Элементы.Подразделение.Доступность	= Ложь;
		Элементы.МенюТребование.Видимость	= Истина;
		
	Иначе
		Отчет.Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
		Отчет.Дата = ТекущаяДатаСеанса();
		
		Элементы.Дата.Доступность			= Истина;
		Элементы.Организация.Доступность 	= Истина;
		Элементы.ЦМО.Доступность 			= Истина;
		Элементы.Подразделение.Доступность	= Истина;
		Элементы.МенюТребование.Видимость	= Ложь;
	КонецЕсли;	
	
	
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьДоступностьРеквизитовОрганизации();
	Если Результат.ВысотаТаблицы = 0 Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	ВариантыОтчетов.ПриСохраненииПользовательскихНастроекНаСервере(ЭтотОбъект, Настройки);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	УстановитьДоступностьРеквизитовОрганизации();
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);	
КонецПроцедуры

&НаКлиенте
Процедура ЦМОПриИзменении(Элемент)
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	СформироватьНаСервере();
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура СформироватьНаСервере()

	Если Не ПроверитьЗаполнениеРеквизитовОтчета() Тогда
		Возврат
	КонецЕсли;
		
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "ФОРМИРОВАНИЕОТЧЕТА");
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	ОтчетОбъект.СформироватьОтчет(Результат);
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НЕИСПОЛЬЗОВАТЬ");


КонецПроцедуры // СформироватьНаСервере()

&НаСервере
Функция ПроверитьЗаполнениеРеквизитовОтчета()
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Отчет.Дата) Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,НСтр("ru = 'На дату'"));
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Дата", "Отчет", Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Отчет.Организация) Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,НСтр("ru = 'Организация'"));
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Организация", "Отчет", Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Отчет.ЦМО) Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,НСтр("ru = 'МОЛ/Место хранения'"));
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "ЦМО", "Отчет", Отказ);
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("105.22,105.32").УчетПоПодразделениям
		И Не ЗначениеЗаполнено(Отчет.Подразделение) Тогда
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,НСтр("ru = 'Подразделение'"));
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Подразделение", "Отчет", Отказ);
	КонецЕсли;
	Возврат Не Отказ;
КонецФункции
 
&НаКлиенте
Процедура УстановитьДоступностьРеквизитовОрганизации()

	ДоступностьЭлементов = ЗначениеЗаполнено(Отчет.Организация) И Не ЗначениеЗаполнено(Отчет.МенюТребование);
	Элементы.Подразделение.Доступность 	= ДоступностьЭлементов;
	Элементы.ЦМО.Доступность			= ДоступностьЭлементов;

КонецПроцедуры // УстановитьДоступностьРеквизитовОрганизации()

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
КонецПроцедуры






 