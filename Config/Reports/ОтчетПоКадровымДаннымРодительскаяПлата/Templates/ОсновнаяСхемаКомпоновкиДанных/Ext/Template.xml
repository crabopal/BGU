	Ребенок.*,
	Организация.*,
	Контрагент.*,
	ФизическоеЛицо.*,
	ДатаПриема,
	ДатаВыбытия,
	Плательщик.*,
	СчетПлательщика.*,
	ПлательщикФизическоеЛицо.*,
	ГруппаДетскогоУчреждения.*,
	СтавкаОплаты.*,
	Льгота.*,
	Договор.*,
	ПлатаЗаПрисмотрИУход,
	КомпенсацияДатаНачала,
	КомпенсацияДатаОкончания,
	КомпенсацияСтавка}
ИЗ
	СписокДетей КАК СписокДетей
