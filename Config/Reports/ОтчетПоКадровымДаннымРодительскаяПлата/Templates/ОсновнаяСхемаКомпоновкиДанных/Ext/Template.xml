		ПО СписокДетей.Ребенок = СписокПлательщиков.Ребенок
		ЛЕВОЕ СОЕДИНЕНИЕ СписокЗачисленных КАК СписокЗачисленных
		ПО СписокДетей.Ребенок = СписокЗачисленных.Ребенок
		ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыКомпенсации КАК ПараметрыКомпенсации
		ПО СписокДетей.Ребенок = ПараметрыКомпенсации.Ребенок
{ГДЕ
	СписокДетей.Ребенок.*,
	СписокДетей.Организация.*,
	СписокЗачисленных.ГруппаДетскогоУчреждения.*,
	СписокЗачисленных.СтавкаОплаты.*,
	СписокЗачисленных.Льгота.*,
	СписокЗачисленных.ПлатаЗаПрисмотрИУход}</query>
