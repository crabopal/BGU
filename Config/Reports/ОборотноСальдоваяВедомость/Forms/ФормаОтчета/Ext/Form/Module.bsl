#Область ОписаниеПеременных

&НаКлиенте
Перем ПараметрыОбработчикаОжидания;

&НаКлиенте
Перем УИДЗамера;

// Псевдоконстанты
&НаКлиенте
Функция ДЛИТЕЛЬНОСТЬ_ОЖИДАНИЯ()	Возврат 1; КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтандартныеОтчеты.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ДобавитьГруппировкуЕПСБУ("Счет", "Счет", Истина);
	ДобавитьГруппировкуЕПСБУ("Организация");
    Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
        ДобавитьГруппировкуЕПСБУ("Валюта");
    КонецЕсли;
    Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
	    ДобавитьГруппировкуЕПСБУ("Подразделение");
    КонецЕсли;
	ДобавитьГруппировкуЕПСБУ("КФО");
	ДобавитьГруппировкуЕПСБУ("КПС");
    Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
	    ДобавитьГруппировкуЕПСБУ("ИФО");
    КонецЕсли;
	ДобавитьГруппировкуЕПСБУ("КЭК");
	ДобавитьГруппировкуЕПСБУ("ХХКЭК", Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляГруппировок.Элементы.Найти("ХХКЭК").Заголовок);
    
    СтандартныеОтчеты.ЗаполнитьПодписиПоУмолчанию(Отчет.Подписи);
	
	Отчет.ВыводитьБухгалтерскиеСчета = Истина;
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьТекстЗаголовка(ЭтаФорма);

	Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Если НЕ СтандартныеПодсистемыКлиент.ПараметрыРаботыКлиента().ИнформационнаяБазаФайловая Тогда
			ОбновитьОбработчикОжидания();
		КонецЕсли;
	КонецЕсли;
	
	СтандартныеОтчетыКлиент.ПриОткрытии(ЭтаФорма);
	
	РассчитатьПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	СтандартнаяОбработка = НЕ Отчет.РежимРасшифровки;
	
	ВариантМодифицирован                    = Ложь;
	ПользовательскиеНастройкиМодифицированы = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	СтандартныеОтчеты.ПриСохраненииПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
	Если Не КомпоновщикИнициализирован Тогда
		ПользовательскиеНастройки = ПоместитьВоВременноеХранилище(Настройки, УникальныйИдентификатор);
	КонецЕсли;
	
	СтандартныеОтчеты.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	
    Если НайтиГруппировкуЕПСБУ("ХХКЭК") = -1 Тогда
        Отчет.ГруппировкаЕПСБУ.Очистить();
    	ДобавитьГруппировкуЕПСБУ("Счет", "Счет", Истина);
    	ДобавитьГруппировкуЕПСБУ("Организация");
    	ДобавитьГруппировкуЕПСБУ("КФО");
    	ДобавитьГруппировкуЕПСБУ("КПС");
    	ДобавитьГруппировкуЕПСБУ("КЭК");
		ДобавитьГруппировкуЕПСБУ("ХХКЭК", Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляГруппировок.Элементы.Найти("ХХКЭК").Заголовок);
    КонецЕсли; 
    
    кВалюта = "Валюта";
    Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		УдалитьГруппировкуЕПСБУ(кВалюта);
	Иначе
		Если НайтиГруппировкуЕПСБУ(кВалюта) = -1 Тогда
			ДобавитьГруппировкуЕПСБУ(кВалюта);
		КонецЕсли
	КонецЕсли;
	
    кИФО = "ИФО";
    Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		УдалитьГруппировкуЕПСБУ(кИФО);
	Иначе
		Если НайтиГруппировкуЕПСБУ(кИФО) = -1 Тогда
			ДобавитьГруппировкуЕПСБУ(кИФО);
		КонецЕсли
    КонецЕсли;
    
	
    кПодразделение = "Подразделение";
    ЭтаФорма.Элементы.Подразделение.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
    Если НЕ ЭтаФорма.Элементы.Подразделение.Видимость Тогда
		УдалитьГруппировкуЕПСБУ(кПодразделение);
    Иначе
		Если НайтиГруппировкуЕПСБУ(кПодразделение) = -1 Тогда
			ДобавитьГруппировкуЕПСБУ(кПодразделение);
        КонецЕсли
    КонецЕсли; 
	
	Если
		НЕ Отчет.ВыводитьБухгалтерскиеСчета И
		НЕ Отчет.ВыводитьВспомогательныеСчета И
		НЕ Отчет.ВыводитьЗабалансовыеСчета И
		НЕ Отчет.ВыводитьНалоговыеСчета И
		НЕ Отчет.ВыводитьУправленческиеСчета
	Тогда
		Отчет.ВыводитьБухгалтерскиеСчета = Истина
	КонецЕсли;
	
	УправлениеФормой(ЭтаФорма);
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	
