КонецФункции

&НаСервере
Процедура ИнициализацияКомпоновщикаНастроек()
	
	СтандартныеОтчеты.ИнициализацияКомпоновщикаНастроекФ(ЭтаФорма, Истина);
	
КонецПроцедуры

&НаСервере
Функция СформироватьОтчетСервер() Экспорт
	
	Если Не ПроверитьЗаполнение() Тогда 
		Возврат Новый Структура("ЗаданиеВыполнено, ОтказПроверкиЗаполнения", Истина, Истина);
	КонецЕсли;
	
	Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыводитьЗаголовок", ВыводитьЗаголовок);
	Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыводитьПодвал"   , ВыводитьПодвал);
	Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("УникальныйИдентификатор" , ЭтаФорма.УникальныйИдентификатор);
	
	ИнициализацияКомпоновщикаНастроек();
	
	ПараметрыОтчета = ПодготовитьПараметрыОтчета();
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	ИБФайловая = ОбщегоНазначения.ИнформационнаяБазаФайловая();
	ИдентификаторЗадания = Неопределено;
	Если ИБФайловая Тогда
		АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
		СтандартныеОтчеты.ВывестиОтчетФ(ПараметрыОтчета, АдресХранилища);
		РезультатВыполнения = Новый Структура("ЗаданиеВыполнено", Истина);
	Иначе
		РезультатВыполнения = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
			УникальныйИдентификатор,
			"СтандартныеОтчеты.ВывестиОтчетФ",
			ПараметрыОтчета,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Выполнение отчета: %1'"), ПараметрыОтчета.ИдентификаторОтчета));
		
		АдресХранилища       = РезультатВыполнения.АдресХранилища;
		ИдентификаторЗадания = РезультатВыполнения.ИдентификаторЗадания;
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма, Истина);
	
	Если РезультатВыполнения.ЗаданиеВыполнено Тогда
		ЗагрузитьПодготовленныеДанные();
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНастройкамиПоУмолчанию(ЗаполняемыеНастройки) Экспорт
	
	Если ЗаполняемыеНастройки.Свойство("Показатели") Тогда
		Если ЗаполняемыеНастройки.Показатели Тогда
			// Управление показателями
			Отчет.ПоказательБУ              = Истина;
			Отчет.ПоказательВалютнаяСумма   = Ложь;
			Отчет.ПоказательНеУчитываетсяНУ = Ложь;
			Отчет.ПоказательЕНВД            = Ложь;
			Отчет.ПоказательНДС             = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Форма.Элементы.ПоказательВалютнаяСумма.Доступность = Форма.ФОВалютныйУчет;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьГруппировкуЕПСБУ(ИмяГруппировки, Представление = "", Использование = Ложь)
	
	Строка = Отчет.ГруппировкаЕПСБУ.Добавить();
	Строка.Группировка = ИмяГруппировки;
	Строка.Использование = Использование;
	Если Представление = "" Тогда
		Строка.Представление = ИмяГруппировки;
	Иначе
		Строка.Представление = Представление;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает индекс строки или -1
&НаСервере
Функция НайтиГруппировкуЕПСБУ(Группировка)
	Для каждого Строка из Отчет.ГруппировкаЕПСБУ Цикл
		Если Строка.Группировка = Группировка Тогда
			Возврат Строка.НомерСтроки - 1;
		КонецЕсли
	КонецЦикла;
	Возврат -1;
КонецФункции

&НаСервере
Функция УдалитьГруппировкуЕПСБУ(Группировка)
	Индекс = НайтиГруппировкуЕПСБУ(Группировка);
	Если Индекс <> -1 Тогда
		Отчет.ГруппировкаЕПСБУ.Удалить(Индекс);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

