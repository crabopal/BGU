#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьСтек(СтекПоСубсчетам, счСчет)
    
    Й = СтекПоСубсчетам.Количество() - 1;
    Пока Й >= 0  Цикл
        Если счСчет.ПринадлежитЭлементу(СтекПоСубсчетам[Й]) Тогда
            Возврат;
        Иначе
            СтекПоСубсчетам.Удалить(Й);
        КонецЕсли; 
        Й = Й - 1;
    КонецЦикла; 
    
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРазвернутоеСальдоПоУмолчаниюНаСервере()
    
    НаборЗаписей = РегистрыСведений.РазвернутоеСальдо.СоздатьНаборЗаписей();
    НаборЗаписей.Прочитать();
    Выборка = НаборЗаписей.Выгрузить();
    Выборка.Сортировать("Счет");
    
    Отчет.РазвернутоеСальдо.Очистить();
    
    СтекПоСубсчетам = Новый Массив();
    
    Для каждого Строка Из Выборка Цикл
        Если НЕ Строка.Счет.ЭлементГруппа Тогда
            ПроверитьСтек(СтекПоСубсчетам, Строка.Счет);
            Если Строка.Использование = Перечисления.ВидыРазвернутогоСальдо.РазворачиватьПоСубсчетам Тогда
                Если Строка.Счет.ЭлементГруппа И СтекПоСубсчетам.Количество() = 0 Тогда
                    СтекПоСубсчетам.Добавить(Строка.Счет);
                    НоваяСтрока = Отчет.РазвернутоеСальдо.Добавить();
                    НоваяСтрока.Использование = Истина;
                    НоваяСтрока.ПоСубсчетам = Истина;
                    НоваяСтрока.Счет = Строка.Счет;
                    Если НоваяСтрока.Счет.ЭлементГруппа Тогда
                        НоваяСтрока.Представление = "По субсчетам";
                    КонецЕсли; 
                КонецЕсли; 
            ИначеЕсли
                Строка.Использование = Перечисления.ВидыРазвернутогоСальдо.Разворачивать ИЛИ
                Строка.Использование = Перечисления.ВидыРазвернутогоСальдо.Наследуется
            Тогда
                Если Строка.Счет.ЭлементГруппа Тогда
                    СтекПоСубсчетам.Добавить(Строка.Счет);
                КонецЕсли;
                
                НоваяСтрока = Отчет.РазвернутоеСальдо.Добавить();
                НоваяСтрока.Счет = Строка.Счет;
                НоваяСтрока.Использование = Истина;
                НоваяСтрока.ПоСубсчетам = (Строка.Счет.ЭлементГруппа = Истина);
                СтрокаПоСубконто    = "";
                
                Для Сбк = 1 По Строка.Счет.ВидыСубконто.Количество() Цикл
                    Если ЗначениеЗаполнено(Строка["Субконто" + Сбк]) Тогда
                        СтрокаПоСубконто = СтрокаПоСубконто + "+" + Сбк;
                        Если НЕ ПустаяСтрока(НоваяСтрока.Представление) Тогда
                             НоваяСтрока.Представление = НоваяСтрока.Представление + ", "
                        КонецЕсли; 
                        НоваяСтрока.Представление = НоваяСтрока.Представление + Строка(Строка["Субконто" + Сбк]);
                    Иначе
                        СтрокаПоСубконто = СтрокаПоСубконто + "-" + Сбк;
                    КонецЕсли;
                КонецЦикла;
                
                НоваяСтрока.ПоСубконто = СтрокаПоСубконто;
                
                Если ПустаяСтрока(НоваяСтрока.Представление) Тогда
                    Если НоваяСтрока.Счет.ЭлементГруппа Тогда
                        НоваяСтрока.Представление = "По субсчетам";
                    Иначе
                        НоваяСтрока.Представление = РегистрыСведений.РазвернутоеСальдо.стрНеРазворачивать();
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла; 
    
КонецПроцедуры

