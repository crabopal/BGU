&НаКлиенте
Функция ПолучитьПараметрыВыбораСчета(Парам, ЧастьКода = "")
    
    Парам.Вставить("ТипСчета", ВидСчета.АктивноПассивный);
    Если НЕ ПустаяСтрока(ЧастьКода) Тогда
        Парам.Вставить("СтрокаПоиска", ЧастьКода);
    КонецЕсли; 
    НеиспользованныеСчета = ПолучитьМассивНеиспользованныхСчетов(Новый Массив, ЧастьКода);
    Парам.Вставить("ОграниченияСписокСчетов", НеиспользованныеСчета);
    
    Возврат Парам;
    
КонецФункции
 
// ----------------------------------------------------------------------------
&НаСервере
Функция ПолучитьМассивНеиспользованныхСчетов(Счета, ЧастьКода)
    
    Запрос = Новый Запрос;
    
    Запрос.Текст =
       "ВЫБРАТЬ
       |    ЕПСБУ.Ссылка
       |ИЗ
       |    ПланСчетов.ЕПСБУ КАК ЕПСБУ
       |ГДЕ
       |    ЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
       |    И НЕ ЕПСБУ.Ссылка В (&СписокСчетов)
       |    И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
       |
       |УПОРЯДОЧИТЬ ПО
       |    ЕПСБУ.Код";
       
    Массив = Отчет.РазвернутоеСальдо.Выгрузить(, "Счет").ВыгрузитьКолонку("Счет");
    Если ЭтаФорма.ТекущийЭлемент.ТекущаяСтрока < Массив.Количество() Тогда
        Массив.Удалить(ЭтаФорма.ТекущийЭлемент.ТекущаяСтрока);
    КонецЕсли; 
    Запрос.УстановитьПараметр("СписокСчетов", Массив);
    Счета = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
    
    Возврат Счета;
    
КонецФункции

