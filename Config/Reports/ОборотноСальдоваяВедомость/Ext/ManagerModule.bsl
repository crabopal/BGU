// ----------------------------------------------------------------------------
Функция ПолучитьСчетаГруппировка(ПараметрыОтчета)
    
    Текст =
        "ВЫБРАТЬ
        |    ЕПСБУ.Ссылка КАК Счет,
        |    0 КАК КолВоСбк
        |ИЗ
        |    ПланСчетов.ЕПСБУ КАК ЕПСБУ
        |ГДЕ
        |    ЕПСБУ.Ссылка В ИЕРАРХИИ(&ПоСубконто)
        |
        |УПОРЯДОЧИТЬ ПО
        |    ЕПСБУ.Код";
    Запрос = Новый Запрос(Текст);
    ТЗ = Неопределено;
    Для каждого Запись Из ПараметрыОтчета.Группировка Цикл
        Если НЕ Запись.Использование Тогда
            Продолжить;
        КонецЕсли;
        КолВоСбк = 0;
        Й = 0;
        Пока Й + 2 <= СтрДлина(Запись.ПоСубконто) Цикл
            Номер = Число(Сред(Запись.ПоСубконто, Й + 1, 2));
            Если Номер > 0 Тогда
                КолВоСбк = КолВоСбк + 1;
            КонецЕсли;
            Й = Й + 2;
        КонецЦикла;
        Запрос.УстановитьПараметр("ПоСубконто", Запись.Счет);
        Если ТЗ = Неопределено Тогда
            ТЗ = Запрос.Выполнить().Выгрузить();
            Для каждого Запись1 Из ТЗ Цикл
                Запись1.Установить(1, КолВоСбк);
            КонецЦикла; 
        Иначе
            ТЗ1 = Запрос.Выполнить().Выгрузить();
            Для каждого Запись1 Из ТЗ1 Цикл
                Строка = ТЗ.Добавить();
                Строка.Счет = Запись1.Счет;
                Строка.КолВоСбк = КолВоСбк;
            КонецЦикла; 
        КонецЕсли; 
    КонецЦикла; 
    
    Возврат ТЗ;
    
КонецФункции

// ----------------------------------------------------------------------------
Процедура ФормируемКлючДляМассивСписковСчетовПоСубконто(Стр, МассивЗначений)
        // Формируем ключ
    Й = 0;
    Пока Й + 2 <= СтрДлина(Стр.ПоСубконто) Цикл
        Номер = Число(Сред(Стр.ПоСубконто, Й + 1, 2));
        Если Номер > 0 И МассивЗначений[0].НайтиПоЗначению(Стр.Счет.ВидыСубконто[Номер - 1].ВидСубконто) = Неопределено  Тогда
            МассивЗначений[0].Добавить(Стр.Счет.ВидыСубконто[Номер - 1].ВидСубконто);
        КонецЕсли;
        Й = Й + 2;
    КонецЦикла;
    
КонецПроцедуры

// ----------------------------------------------------------------------------
// Стр - строка выборки по запросу по регистру сведений РазвернутоеСальдо
Функция ПолучитьКлючПоСубконто(Стр)
    
    МассивЗначений = Новый Массив(2);
    МассивЗначений[0] = Новый СписокЗначений;
    ФормируемКлючДляМассивСписковСчетовПоСубконто(Стр, МассивЗначений);
    Возврат Строка(МассивЗначений[0]);
    
КонецФункции

// ----------------------------------------------------------------------------
Функция ОбщееКоличествоРазворачиваемыхСубконто(Счет)
    
    К = 0;
    Для каждого Вид Из Счет.ВидыСубконто Цикл
        Если НЕ Вид.ТолькоОбороты Тогда
            К = К + 1;
        КонецЕсли; 
    КонецЦикла; 
    Возврат К;
    
КонецФункции

// ----------------------------------------------------------------------------
// Счет уже есть, если родительский счет разворачивается и у родителя
// список и порядок субконто одинаков или включает в свое подмножесто.
// 205.00 Контрагенты, Договоры
// 205.11 Контрагенты (подходит, у 205.11 только одно субкното)
// 205.31 Контрагенты (не подойдет, тк 205.31 имеет два субконто)
Функция СчетУжеЕсть(СоответствиеИсключенных, Стр)
    
        // Формируем ключ
    Ключ = ПолучитьКлючПоСубконто(Стр);
        // Если у счета в плане счетов количество субконто меньше чем у
        // родительского счета, то см.выше про 205.11
    ИщемТочноеСоответствие = (СтрЧислоВхождений(Ключ, ";") + 1) <> ОбщееКоличествоРазворачиваемыхСубконто(Стр.Счет);
    
    Счет = Стр.Счет.Родитель;
    Пока Счет <> ПланыСчетов.ЕПСБУ.ПустаяСсылка() Цикл
        Запись = СоответствиеИсключенных.Получить(Счет);
        Если Запись <> Неопределено Тогда
            Если
                (ИщемТочноеСоответствие = Истина И Запись[0] = Ключ) ИЛИ
                (ИщемТочноеСоответствие = Ложь   И Найти(Запись[0], Ключ) = 1)
            Тогда
                Возврат Истина;
            КонецЕсли;
                // Этот счет исключается из родительских счетов
            Если Стр.Счет.ЭлементГруппа Тогда
                СоответствиеИсключенных.Получить(Счет)[1].Добавить(Стр.Счет);
            Иначе
                СоответствиеИсключенных.Получить(Счет)[2].Добавить(Стр.Счет);
            КонецЕсли;
            Прервать;
        КонецЕсли;
        
        Счет = Счет.Родитель;
    КонецЦикла;
        // Не нашли счет - добавляем новый ключ если счет группа
    Если Стр.Счет.ЭлементГруппа Тогда
        Массив = Новый Массив(3);
        Массив[0] = Ключ;
        Массив[1] = Новый СписокЗначений; // Счета Группы
        Массив[2] = Новый СписокЗначений; // Счета Элементы
        СоответствиеИсключенных.Вставить(Стр.Счет, Массив);
    КонецЕсли;
    
    Возврат Ложь;
    
КонецФункции

//-----------------------------------------------------------------------------
// Раскладываем развернутые счета по категориям:
// - Не используется субконто
// - Используется одно субконто
//		Соответствие (Ключ - Строка(СписокЗначений(Субконто) + " [Иерархия|Нет]"), Значение - Массив(СписокЗначений(Субконто), СписокЗначений(Счет)))
// - Используется два субконто
//		Соответствие (Ключ - Строка(СписокЗначений(Субконто) + " [Иерархия|Нет]"), Значение - Массив(СписокЗначений(Субконто), СписокЗначений(Счет)))
// - ...
//   Счет В ИЕРАРХИИ (&СчетаПоРазвернутомуСальдо) И (НЕ Счет = (&СчетаИсключенныеИзПоРазвернутомуСальдо))
// СоответствиеСчетовИсключенныхИзПоРазвернутомуСальдо
//        Соотвествие (Ключ - Счет, Значение - Массив исключенных счетов
Функция РазложитьРазвернутыеСчетаПоКатегориям(ПараметрыОтчета, МассивСписковСчетовПоСубконто, СоответствиеИсключенныхСчетов)

    
    Для Элемент = 0 по МассивСписковСчетовПоСубконто.Количество() - 1 Цикл
        МассивСписковСчетовПоСубконто[Элемент] = Новый Соответствие;
    КонецЦикла;

    СчетаГруппировка =  ПолучитьСчетаГруппировка(ПараметрыОтчета);
    
    Для каждого Стр Из ПараметрыОтчета.РазвернутоеСальдо Цикл
        Если Стр.Использование Тогда
                // Проверяем может этот счет уже развернут. 205.00 Контр, Договоры, 205.30 Контр, Договоры
            Если СчетУжеЕсть(СоответствиеИсключенныхСчетов, Стр) Тогда
                Продолжить;
            КонецЕсли; 
                // По субконто
            МассивЗначений = Новый Массив(2);
            МассивЗначений[0] = Новый СписокЗначений; //СписокСубконто 
                // Формируем ключ
            ФормируемКлючДляМассивСписковСчетовПоСубконто(Стр, МассивЗначений);
            СчетГруппировка = Неопределено;
            Если СчетаГруппировка <> Неопределено Тогда
                СчетГруппировка = СчетаГруппировка.Найти(Стр.Счет);
            КонецЕсли; 
            Представление = " " + ?(СчетГруппировка = Неопределено, "0", Строка(СчетГруппировка.КолВоСбк));
            КСубконто = МассивЗначений[0].Количество();
                // В ключе указываем счет группа или элемент,
                // а так же сколько субконто нужно выводить (1) - ВложенныйЗапрос.Субконто1 КАК Субконто1, NULL КАК Субконто2...
            Ключ      = Строка(МассивЗначений[0]) + " " + ?(Стр.Счет.ЭлементГруппа = Истина И Стр.ПоСубсчетам, "Иерархия", "Нет") + Представление;
            ЗначениеПоКлючу = МассивСписковСчетовПоСубконто[КСубконто].Получить(Ключ); //СписокСчетов
            Если ЗначениеПоКлючу = Неопределено Тогда
                МассивЗначений[1] = Новый СписокЗначений;
            Иначе
                МассивЗначений[1] = ЗначениеПоКлючу[1];
            КонецЕсли;
            МассивЗначений[1].Добавить(Стр.Счет, Представление);
            МассивСписковСчетовПоСубконто[КСубконто].Вставить(Ключ, МассивЗначений);
        КонецЕсли
    КонецЦикла;
    
    Стр = СтандартныеОтчеты.ДанныеОтчетаРазвернутоеСальдо(Новый Запрос);
    Пока Стр.Следующий() Цикл
    КонецЦикла;
        // удаляем служебную информацию
    Для каждого Соот Из СоответствиеИсключенныхСчетов Цикл
        Соот.Значение.Удалить(0);
    КонецЦикла;

    Возврат Истина;

КонецФункции

// ----------------------------------------------------------------------------
// Добавляем те, которые нужно обратить в NULL
Функция ПолучитьМассивГруппировокЕПСБУ(ПараметрыОтчета, МассивГруппировок)
    
    Для каждого Измерение Из Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.Измерения Цикл
        пГруппировка = ПараметрыОтчета.ГруппировкаЕПСБУ.Найти(Измерение.Имя);
        Если пГруппировка = Неопределено ИЛИ НЕ пГруппировка.Использование Тогда
            Если Измерение.Имя <> "КПС" Тогда
                МассивГруппировок.Добавить(Измерение.Имя);
            КонецЕсли; 
        КонецЕсли;
    КонецЦикла; 
    
    Возврат МассивГруппировок;
    
КонецФункции

// ----------------------------------------------------------------------------
Процедура УдалитьПоляСубконтоИзЗапроса(Колонки, й)
    
    Номер = 3;
    Пока Номер > й Цикл
        НомерКолонки = Колонки.Количество() - 1;
        Пока НомерКолонки > 0  Цикл
            Если Колонки[НомерКолонки].Псевдоним = ("Субконто" + Строка(Номер)) Тогда
                Колонки.Удалить(НомерКолонки);
                Прервать;
            КонецЕсли; 
            НомерКолонки = НомерКолонки - 1;
        КонецЦикла; 
        Номер = Номер - 1;
    КонецЦикла;
    
КонецПроцедуры

// ----------------------------------------------------------------------------
Процедура УстановитьПоляСубконтоИзЗапроса(Колонки, Сколько)
    
        // Удаляем поля NULL КАК Субконто1
    Номер = 1;
    Пока Номер <= Сколько Цикл
        НомерКолонки = Колонки.Количество() - 1;
        Пока НомерКолонки > 0  Цикл
            Если Колонки[НомерКолонки].Псевдоним = ("Субконто" + Строка(Номер)) Тогда
                Колонки.Удалить(НомерКолонки);
                Прервать;
            КонецЕсли; 
            НомерКолонки = НомерКолонки - 1;
        КонецЦикла; 
        Номер = Номер + 1;
    КонецЦикла;
        // Изменяем Псевдоним поля ВложенныйЗапрос.Субконто1 КАК Субконто_1 на Субконто1
    Номер = 1;
    Пока Номер <= 3 Цикл
        НомерКолонки = Колонки.Количество() - 1;
        Пока НомерКолонки > 0  Цикл
            Если Колонки[НомерКолонки].Псевдоним = ("Субконто_" + Строка(Номер)) Тогда
                Если Номер <= Сколько Тогда
                    Колонки[НомерКолонки].Псевдоним = "Субконто" + Строка(Номер);
                Иначе
                    Колонки.Удалить(НомерКолонки);
                КонецЕсли; 
                Прервать;
            КонецЕсли; 
            НомерКолонки = НомерКолонки - 1;
        КонецЦикла; 
        Номер = Номер + 1;
    КонецЦикла; 
    
КонецПроцедуры

// ----------------------------------------------------------------------------
Функция ЗапросПоИерархии(Соотв)
    
    Возврат ?(Сред(Соотв.Ключ, СтрДлина(Строка(Соотв.Значение[0])) + 2, 3) = "Нет", Ложь, Истина);
    
КонецФункции

// ----------------------------------------------------------------------------
Функция ПолучитьИсключенныеСчета(Счета, СоответствиеИсключенныхСчетов, Иерархия, СпЗнч)
    
    Для каждого Счет Из Счета Цикл
        Значение = СоответствиеИсключенныхСчетов.Получить(Счет.Значение);
        Если Значение <> Неопределено Тогда
            Для каждого Сч Из Значение[?(Иерархия, 0, 1)] Цикл
                СпЗнч.Добавить(Сч.Значение);
            КонецЦикла; 
        КонецЕсли;
    КонецЦикла;
    
    Возврат СпЗнч;
    
КонецФункции

// ----------------------------------------------------------------------------
Процедура ИзмеренияВNULL(Запрос, МассивГруппировок)
    
    Для каждого Поле Из МассивГруппировок Цикл
        // Развернутое сальдо формируется вне зависимости от группировок всегда с 
        // учетеом КФО и КПС
        Если Поле = "КФО" ИЛИ Поле = "КПС" Тогда
            Продолжить;
        КонецЕсли; 
        Запрос = СтрЗаменить(Запрос, "ОстаткиИОбороты." + Поле + " КАК ", "NULL КАК ");
    КонецЦикла; 
	
	// без учета ИФО
    //Запрос = СтрЗаменить(Запрос, "ОстаткиИОбороты.ИФО КАК ", "NULL КАК ");
	//20.06.2018
	//В ОСВ и Главной книге с группировкой по ИФО выводится развернутое сальдо по ИФО, без группировки по ИФО - свернутое (это правильно).
	//Т.к. если в ОСВ и Главной книге есть группировка по ИФО и она стоит выше группировки по счету - нет возможности выводить свернутое 
	//сальдо без учета ИФО по счету (потому что в верхней группировке по ИФО выводится развернутое сальдо по ИФО, в группировке 
	//ниже - по счету нельзя уже вывести свернутое).
    
КонецПроцедуры
 
