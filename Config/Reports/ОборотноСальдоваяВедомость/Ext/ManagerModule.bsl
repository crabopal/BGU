    мРазвернутые.Добавить("БУНачальныйРазвернутыйОстатокКт");
    мРазвернутые.Добавить("БУКонечныйРазвернутыйОстатокДт");
    мРазвернутые.Добавить("БУКонечныйРазвернутыйОстатокКт");
    мРазвернутые.Добавить("ВалютнаяСуммаНачальныйРазвернутыйОстатокДт");
    мРазвернутые.Добавить("ВалютнаяСуммаНачальныйРазвернутыйОстатокКт");
    мРазвернутые.Добавить("ВалютнаяСуммаКонечныйРазвернутыйОстатокДт");
    мРазвернутые.Добавить("ВалютнаяСуммаКонечныйРазвернутыйОстатокКт");
    мРазвернутые.Добавить("КоличествоНачальныйРазвернутыйОстатокДт");
    мРазвернутые.Добавить("КоличествоНачальныйРазвернутыйОстатокКт");
    мРазвернутые.Добавить("КоличествоКонечныйРазвернутыйОстатокДт");
    мРазвернутые.Добавить("КоличествоКонечныйРазвернутыйОстатокКт");
    
    Для каждого Поле Из мРазвернутые Цикл
        ПолеНД = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
        ПолеНД.Поле = Поле;
        ПолеНД.ПутьКДанным = СтрЗаменить(Поле, "Развернутый", "");
    КонецЦикла;
    
КонецПроцедуры

// ----------------------------------------------------------------------------
Процедура ДоработкаЗапросаПоСубконтоРазвернутое(ПараметрыОтчета, Схема, СчетаИсключенныеИерархия, СчетаИсключенные)
    // Запрос ПоСубконтоРазвернутое. Данные по развороту АП счетов лежат в регистре сведений РазвернутоеСальдо.
    // Записи из регистра группируются по иерархичности счета (имеет дочерние счета - да/нет), по количеству
    // субконто и по их типам. Для каждой записи группировки создается копия запроса, где выставляются параметры
    // Счет В ИЕРАРХИИ (&СчетаПоРазвернутомуСальдо) И (НЕ Счет = (&СчетаИсключенныеИзПоРазвернутомуСальдо))
    // &СчетаПоРазвернутомуСальдо - счета для иерархических счетов
    // &СчетаИсключенныеИзПоРазвернутомуСальдо - дочерние счета для которых задан иной разворот.
    
    // Раскладываем развернутые счета по категориям: МассивСписковСчетовПоСубконто
    // - Не используется субконто
    // - Используется одно субконто
    //		Соответствие (Ключ - Строка(СписокЗначений(Субконто) + ":[Иерархия|Нет]"), Значение - Массив(СписокЗначений(Субконто), СписокЗначений(Счет)))
    // - Используется два субконто
    //		Соответствие (Ключ - Строка(СписокЗначений(Субконто) + ":[Иерархия|Нет]"), Значение - Массив(СписокЗначений(Субконто), СписокЗначений(Счет)))
    // - ...
    // СоответствиеИсключенныхСчетовИсключенных
    // Соотвествие (Ключ - Счет, Значение Массив[2])
    //      Значение Массив[0] - Список значений содержащий счета группы исключенные из Счета(Ключ)
    //      Значение Массив[1] - Список значений содержащий счета элементы исключенные из Счета(Ключ)
    МассивСписковСчетовПоСубконто = Новый Массив(5);
    СоответствиеИсключенныхСчетов = Новый Соответствие();
    РазложитьРазвернутыеСчетаПоКатегориям(ПараметрыОтчета, МассивСписковСчетовПоСубконто, СоответствиеИсключенныхСчетов);
    // Если группировки по измерению нет, то вместо выражение ОстаткиИОбороты.ИмяИзмерения КАК ИмяИзмерения ставим NULL КАК ИмяИзмерения
    МассивГруппировок = ПолучитьМассивГруппировокЕПСБУ(ПараметрыОтчета, Новый Массив);
    
    Для й = 1 По 3 Цикл
        Для каждого Соотв Из МассивСписковСчетовПоСубконто[й] Цикл
            НаборДанных =  Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
            Суффикс = СтрЗаменить(Строка(Соотв.Значение[1][0].Значение), ".", "_");
            НаборДанных.Имя = "ПоСубконтоРазвернутое" + Суффикс;
            ЗаполнитьЗначенияСвойств(НаборДанных, Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконтоРазвернутое,"АвтоЗаполнениеДоступныхПолей,ИсточникДанных");
                // Будем редактировать схему запроса
            СЗ = Новый ("СхемаЗапроса");
            СЗ.УстановитьТекстЗапроса(Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконтоРазвернутое.Запрос);
                //СЗ.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Запрос.Колонки - поля вложенного запроса удаляем ненужные поля Субконто1-3
            УдалитьПоляСубконтоИзЗапроса(СЗ.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Запрос.Колонки, й);
                //СЗ.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Запрос.Колонки - поля вложенного запроса удаляем ненужные поля Субконто1-3
            УстановитьПоляСубконтоИзЗапроса(СЗ.ПакетЗапросов[0].Колонки, Число(Соотв.Значение[1][0].Представление));
                //СЗ.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Запрос.Операторы[0].Источники[0].Источник.Параметры
                //[4].Выражение (Тип ВыражениеСхемыЗапроса) - условие по счету
            Если ЗапросПоИерархии(Соотв) Тогда
                СтандартныеОтчеты.СкопироватьПараметрСхемыКомпоновкиДанных(Схема, "СчетаПоРазвернутомуСальдо" + Суффикс, "СчетаПоРазвернутомуСальдо", Соотв.Значение[1]);
                Условие = "Счет В ИЕРАРХИИ (&СчетаПоРазвернутомуСальдо" + Суффикс + ")";
                СпЗнч = ПолучитьИсключенныеСчета(Соотв.Значение[1], СоответствиеИсключенныхСчетов, Истина, Новый СписокЗначений);
                Если СпЗнч.Количество() Тогда
                    СтандартныеОтчеты.СкопироватьПараметрСхемыКомпоновкиДанных(Схема, "ИерархическиеСчетаИсключенныеИзПоРазвернутомуСальдо" + Суффикс, "ИерархическиеСчетаИсключенныеИзПоРазвернутомуСальдо", СпЗнч);
                    Условие = Условие + " И (НЕ Счет В ИЕРАРХИИ (&ИерархическиеСчетаИсключенныеИзПоРазвернутомуСальдо" + Суффикс + ")) ";
                КонецЕсли; 
                СпЗнч = ПолучитьИсключенныеСчета(Соотв.Значение[1], СоответствиеИсключенныхСчетов, Ложь, Новый СписокЗначений);
                Если СпЗнч.Количество() Тогда
                    СтандартныеОтчеты.СкопироватьПараметрСхемыКомпоновкиДанных(Схема, "СчетаИсключенныеИзПоРазвернутомуСальдо" + Суффикс, "СчетаИсключенныеИзПоРазвернутомуСальдо", СпЗнч);
                    Условие = Условие + " И (НЕ Счет В (&СчетаИсключенныеИзПоРазвернутомуСальдо" + Суффикс + ")) ";
                КонецЕсли; 
                Условие = Условие + " И (НЕ Счет.Забалансовый ИЛИ &ВыводитьЗабалансовыеСчета)";
                СЗ.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Запрос.Операторы[0].Источники[0].Источник.Параметры[4].Выражение = Новый ВыражениеСхемыЗапроса(Условие);
                
                Для каждого Сч Из Соотв.Значение[1] Цикл
                    СчетаИсключенныеИерархия.Добавить(Сч.Значение);
                КонецЦикла; 
            Иначе
                Условие = "Счет В (&СчетаПоРазвернутомуСальдо" + Суффикс + ") И (НЕ Счет.Забалансовый ИЛИ &ВыводитьЗабалансовыеСчета)
                    |И (&ВыводитьБухгалтерскиеСчета
                    |	ИЛИ Счет.ТипСчета <> ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский))
                    |И (&ВыводитьУправленческиеСчета
                    |	ИЛИ Счет.ТипСчета <> ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Управленческий))
                    |И (&ВыводитьНалоговыеСчета
                    |	ИЛИ Счет.ТипСчета <> ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Налоговый))
                    |И (&ВыводитьВспомогательныеСчета
                    |	ИЛИ Счет.ТипСчета <> ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Вспомогательный))";
                СтандартныеОтчеты.СкопироватьПараметрСхемыКомпоновкиДанных(Схема, "СчетаПоРазвернутомуСальдо" + Суффикс, "СчетаПоРазвернутомуСальдо", Соотв.Значение[1]);
                СЗ.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Запрос.Операторы[0].Источники[0].Источник.Параметры[4].Выражение = Новый ВыражениеСхемыЗапроса(Условие);
                
                Для каждого Сч Из Соотв.Значение[1] Цикл
                    СчетаИсключенные.Добавить(Сч.Значение);
                КонецЦикла; 
            КонецЕсли; 
                //[5].Выражение (Тип ВыражениеСхемыЗапроса) - Вычисляемые субконто "&СубконтоРазвернутый"            Иерархия = ЗапросПоИерархии(Соотв);
            СтандартныеОтчеты.СкопироватьПараметрСхемыКомпоновкиДанных(Схема, "СубконтоРазвернутый" + Суффикс, "СубконтоРазвернутый", Соотв.Значение[0]);
            СЗ.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Запрос.Операторы[0].Источники[0].Источник.Параметры[5].Выражение = Новый ВыражениеСхемыЗапроса("&СубконтоРазвернутый" + Суффикс);
                // Устанавливаем текст запроса
            НаборДанных.Запрос = СЗ.ПолучитьТекстЗапроса();
                // Устанавливаем NULL вместо неиспользуемых полей измерений, кроме Счет
            ИзмеренияВNULL(НаборДанных.Запрос, МассивГруппировок);

                // Устанавливаем пути полей
            УстанавливаемПутиРазвернутыхРесурсов(НаборДанных);
        КонецЦикла; 
    КонецЦикла; 
    
    Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.Удалить(Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконтоРазвернутое);
    
КонецПроцедуры

// ----------------------------------------------------------------------------
Процедура ДоработкаЗапросаПоСчетам(Схема, СчетаИсключенныеИерархия, СчетаИсключенные)
    // В этом запросе ничего не меняется, устанавливаются только параметры
    //  &ИерархическиеСчетаИсключенныеИзЗапросаПоСчетам и &СчетаИсключенныеИзЗапросаПоСчетам
    // из условия
    //(НЕ Счет В ИЕРАРХИИ(&ИерархическиеСчетаИсключенныеИзЗапросаПоСчетам) И НЕ Счет В (&СчетаИсключенныеИзЗапросаПоСчетам))
    //И ((НЕ Счет.Забалансовый) ИЛИ &ВыводитьЗабалансовыеСчета)
    Схема.Параметры.ИерархическиеСчетаИсключенныеИзЗапросаПоСчетам.Значение = СчетаИсключенныеИерархия;
    Схема.Параметры.СчетаИсключенныеИзЗапросаПоСчетам.Значение              = СчетаИсключенные;
    
КонецПроцедуры

// ----------------------------------------------------------------------------
Функция ПолучитьСписокСубконто(Запись, спЗнч)
    
    Й = 0;
    Пока Й + 2 <= СтрДлина(Запись.ПоСубконто) Цикл
        Номер = Число(Сред(Запись.ПоСубконто, Й + 1, 2));
        Если Номер > 0 Тогда
            спЗнч.Добавить(Запись.Счет.ВидыСубконто[Номер - 1].ВидСубконто);
        КонецЕсли;
        Й = Й + 2;
    КонецЦикла;
    
    Возврат спЗнч;
    
КонецФункции

// ----------------------------------------------------------------------------
Функция ПолучитьПорядокСубконто(Запись, ПорядокСубконто)
    // Ключ: СписокЗначений(Субконто) : СписокЗначений(Счета)
    // Если порядок субконто не изменен, то тогда не нужно указывать
    // в виртуальной таблице РегистрБухгалтерии.ОстаткиИОбороты
    // параметр &Субконто и вместо СпискаЗначений ключем является Число(0).
    Сбк = 0;
    Й = 0;
    Пока Й + 2 <= СтрДлина(Запись.ПоСубконто) Цикл
        Номер = Число(Сред(Запись.ПоСубконто, Й + 1, 2));
        Если Номер <= 0 ИЛИ Сбк <> (Номер - 1) Тогда
            Прервать;
        КонецЕсли;
        Сбк = Сбк + 1;
        Й = Й + 2;
    КонецЦикла;
    
    Ключ = 0;
    Если Сбк <> СтрДлина(Запись.ПоСубконто) / 2 Тогда
        Ключ = ПолучитьСписокСубконто(Запись, Новый СписокЗначений);
    КонецЕсли;
    спзСчетов = ПорядокСубконто.Получить(Ключ);
    Если спзСчетов = Неопределено Тогда
        спзСчетов = Новый СписокЗначений;
        ПорядокСубконто.Вставить(Ключ, спзСчетов);
    КонецЕсли;
    спзСчетов.Добавить(Запись.Счет);
    
КонецФункции

// ----------------------------------------------------------------------------
Процедура АнализСчетовПоСубконто(ПараметрыОтчета, соотвКолВоСбк)
    
    Для каждого Запись Из ПараметрыОтчета.Группировка Цикл
        Если Запись.Использование Тогда
            КолВо = 0;
            Й = 0;
            Пока Й + 2 <= СтрДлина(Запись.ПоСубконто) Цикл
                Номер = Число(Сред(Запись.ПоСубконто, Й + 1, 2));
                Если Номер > 0 Тогда
                    КолВо = КолВо + 1;
                КонецЕсли;
                Й = Й + 2;
            КонецЦикла;
                // Если разворот счета задан по субсчетам, то вообще пропускаем
            Если КолВо = 0 Тогда
                Продолжить;
            КонецЕсли; 
            соотвСчетов = соотвКолВоСбк.Получить(КолВо);
            Если соотвСчетов = Неопределено Тогда
                    // Ключ: СписокЗначений(Субконто) : СписокЗначений(Счета)
                соотвСчетов = Новый Соответствие;
                соотвКолВоСбк.Вставить(КолВо, соотвСчетов);
            КонецЕсли;
            ПолучитьПорядокСубконто(Запись, соотвСчетов);
        КонецЕсли;
    КонецЦикла; 
    
КонецПроцедуры

// ----------------------------------------------------------------------------
Процедура ДоработкаЗапросаПоСубконто(ПараметрыОтчета, Схема, СчетаИсключенныеИерархия, СчетаИсключенныеНеиерархия, ДетализацияПоСубконто)
    // В ДанныеОтчета.Группировка указаны счета, которые должны быть развернуты по субконто
    // Анализируем счета, которые будут разворачиваться по субконто:
    // 1) Исключаем АП счета, которые 
    // 1) Группируем счета по количеству разворачиваемых субконто и по их порядку
    //    (2 субконто: 2е, 1е),         (2 субконто: 1е, 2е)
    //    (205 счет:   Контрагенты, КЭК)(101 счет: КЭК, ОС)
    соотвКолВоСбк = Новый Соответствие(); // КолВо субконто, соотвСчетов
    АнализСчетовПоСубконто(ПараметрыОтчета, соотвКолВоСбк);
    
    Для каждого колВо Из соотвКолВоСбк Цикл
        Й = 0;
        соотСбкСчет = колВо.Значение;
        Для каждого сбкСчет из соотСбкСчет Цикл
            ДетализацияПоСубконто = Истина;
                // этот счет уже обрабатывается поРазвернутомуСубконто
            Если СчетаИсключенныеИерархия.НайтиПоЗначению(СбкСчет.Значение[0].Значение) <> Неопределено Тогда
                Продолжить;
            КонецЕсли; 
            НаборДанных =  Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
            Суффикс = СтрЗаменить(Строка(сбкСчет.Значение[0].Значение), ".", "_");
            НаборДанных.Имя = "ПоСубконто" + Суффикс;
            ЗаполнитьЗначенияСвойств(НаборДанных, Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконто,"АвтоЗаполнениеДоступныхПолей,ИсточникДанных");
                // Будем редактировать схему запроса
            СЗ = Новый ("СхемаЗапроса");
            СЗ.УстановитьТекстЗапроса(Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконто.Запрос);
                //СЗ.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Запрос.Колонки - поля вложенного запроса удаляем ненужные поля Субконто1-3
            УдалитьПоляСубконтоИзЗапроса(СЗ.ПакетЗапросов[0].Колонки, колВо.Ключ);
                // условие
            СтандартныеОтчеты.СкопироватьПараметрСхемыКомпоновкиДанных(Схема, "СчетДетализации" + Суффикс, "СчетДетализации", сбкСчет.Значение);
            Условие = СтрЗаменить(СЗ.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Параметры[4].Выражение, "&СчетДетализации", "&СчетДетализации" + Суффикс);
            СЗ.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Параметры[4].Выражение = Новый ВыражениеСхемыЗапроса(Условие);
                // субконто
            Если сбкСчет.Ключ = 0 Тогда
                Условие = "";
            Иначе
                СтандартныеОтчеты.СкопироватьПараметрСхемыКомпоновкиДанных(Схема, "СубконтоДетализации" + Суффикс, "СубконтоДетализации", сбкСчет.Ключ);
                Условие = "&СубконтоДетализации" + Суффикс;
            КонецЕсли;
            СЗ.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Параметры[5].Выражение = Новый ВыражениеСхемыЗапроса(Условие);
                // Устанавливаем текст запроса
            НаборДанных.Запрос = СЗ.ПолучитьТекстЗапроса();
            
            Для каждого Сч Из сбкСчет.Значение Цикл
                СчетаИсключенныеИерархия.Добавить(Сч.Значение);
            КонецЦикла; 
        КонецЦикла; 
    КонецЦикла;
    
    Схема.Параметры.СчетаИсключенныеИзПоСальдо.Значение = СчетаИсключенныеНеиерархия;
    Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.Удалить(Схема.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСубконто);
    
КонецПроцедуры

// ----------------------------------------------------------------------------
Процедура ДоработкаСКД(ПараметрыОтчета, Схема, ДетализацияПоСубконто)
    // СхемаКомпоновкиДанных уже прочитана из макета "ОсновнаяСхемаКомпоновкиДанных"
    СчетаИсключенныеИерархия = Новый СписокЗначений(); // Установятся в &ИерархическиеСчетаИсключенныеИзЗапросаПоСчетам
    СчетаИсключенные         = Новый СписокЗначений(); // Установятся в &СчетаИсключенныеИзЗапросаПоСчетам
    
    // Запрос ПоСубконтоРазвернутое. Данные по развороту АП счетов лежат в регистре сведений РазвернутоеСальдо.
    // Записи из регистра группируются по иерархичности счета (имеет дочерние счета - да/нет), по количеству
    // субконто и по их типам. Для каждой записи группировки создается копия запроса, где выставляются параметры
    // Счет В ИЕРАРХИИ (&СчетаПоРазвернутомуСальдо) И (НЕ Счет = (&СчетаИсключенныеИзПоРазвернутомуСальдо))
    // &СчетаПоРазвернутомуСальдо - счета для иерархических счетов
    // &СчетаИсключенныеИзПоРазвернутомуСальдо - дочерние счета для которых задан иной разворот.
    ДоработкаЗапросаПоСубконтоРазвернутое(ПараметрыОтчета, Схема, СчетаИсключенныеИерархия, СчетаИсключенные);
    
    // Запрос ПоСубконто. Тут полагается отсортировать разворачиваемые счета по указанным "по субконто"(работают, когда
    // ОСВ формируется без субсчетов) или субконто. Сортируем по количеству и типу субконто. Для каждой пары количество-тип
    // Копируем запрос ПоСубсчетам и выставляем параметры Счет В ИЕРАРХИИ (&СчетДетализации) и &СубконтоДетализации
    // &СчетДетализации - счета для которых считается детализация
    // &СубконтоДетализации - субконто для которых считается детализация
    ДоработкаЗапросаПоСубконто(ПараметрыОтчета, Схема, СчетаИсключенныеИерархия, СчетаИсключенные, ДетализацияПоСубконто);
    
    // Запрос ПоСчетам не дорабатывается у него устанавливаются параметры
    // &ИерархическиеСчетаИсключенныеИзЗапросаПоСчетам - счета имеющие дочерние счета исключаемые из запроса
    //      в запросе они исключаются условием НЕ Счет В ИЕРАРХИИ(&ИерархическиеСчетаИсключенныеИзЗапросаПоСчетам)
    // &СчетаИсключенныеИзЗапросаПоСчетам - счета исключаемые из запроса и не имеющие дочерних счетов.
    //      в запросе счета исключаются условием НЕ Счет В (&СчетаИсключенныеИзЗапросаПоСчетам)
    ДоработкаЗапросаПоСчетам(Схема, СчетаИсключенныеИерархия, СчетаИсключенные);
    
КонецПроцедуры

//----------------------------------------------------------------------------
// В процедуре можно доработать компоновщик перед выводом в отчет
// Изменения сохранены не будут
Процедура ПередКомпоновкойМакета(ПараметрыОтчета, Схема, КомпоновщикНастроек) Экспорт
	
	МассивПоказателей = Новый Массив;
	МассивПоказателей.Добавить("БУ");
	МассивПоказателей.Добавить("ВалютнаяСумма");
	МассивПоказателей.Добавить("Количество");
	
		// Создаем структуру отчета группировкой выбранных полей
	СозданиеСтруктурыОтчета(ПараметрыОтчета, КомпоновщикНастроек, МассивПоказателей);
    
    ЕстьДетализацияПоСубконто = Ложь;
    ДоработкаСКД(ПараметрыОтчета, Схема, ЕстьДетализацияПоСубконто);
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыводитьЗабалансовыеСчета"   , ПараметрыОтчета.ВыводитьЗабалансовыеСчета);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыводитьБухгалтерскиеСчета"  , ПараметрыОтчета.ВыводитьБухгалтерскиеСчета);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыводитьУправленческиеСчета" , ПараметрыОтчета.ВыводитьУправленческиеСчета);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыводитьНалоговыеСчета"      , ПараметрыОтчета.ВыводитьНалоговыеСчета);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыводитьВспомогательныеСчета", ПараметрыОтчета.ВыводитьВспомогательныеСчета);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыводитьЗабалансовыеСчета"   , ПараметрыОтчета.ВыводитьЗабалансовыеСчета);
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.НачалоПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода",
			Бухгалтерскийучет.НачалоПериодаСУточнением(ПараметрыОтчета.НачалоПериода, ПараметрыОтчета.ТипПериода, ПараметрыОтчета.ТолькоУказанныйПериод));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.КонецПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода",
			Бухгалтерскийучет.КонецПериодаСУточнением(ПараметрыОтчета.КонецПериода, ПараметрыОтчета.ТипПериода, ПараметрыОтчета.ТолькоУказанныйПериод));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.Подразделение) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "Подразделение", ПараметрыОтчета.Подразделение,,, Истина);
	КонецЕсли;
	
	
	// Дополнительные данные
	СтандартныеОтчеты.ДобавитьДополнительныеПоляФ(ПараметрыОтчета, КомпоновщикНастроек);
	
	// Формирование структуры отчета
	Структура = КомпоновщикНастроек.Настройки;
	// Обходим список заданных группировок и задаем по ним структуру отчета
	
	БылаГруппировкаСчет = Ложь;
	Для каждого ГруппировкаОтчета Из ПараметрыОтчета.ГруппировкаЕПСБУ Цикл
		Если ГруппировкаОтчета.Использование Тогда
			Структура = Структура.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
			ПолеГруппировки = Структура.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеГруппировки.Использование  = Истина;
			ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ГруппировкаОтчета.Группировка);
			Если ГруппировкаОтчета.Группировка = "Счет" Тогда
				ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
					// Установка отбора на выводимый уровень иерархии счета
				ГруппаЭлементовОтбора = Структура.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
				ГруппаЭлементовОтбора.Применение = ТипПримененияОтбораКомпоновкиДанных.Иерархия;
				ГруппаЭлементовОтбора.ТипГруппы  = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаЭлементовОтбора, "ПараметрыДанных.ПоСубсчетам", Истина);
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаЭлементовОтбора, "СистемныеПоля.УровеньВГруппировке", 1);
				СписокСчетовПоСубсчетам = СтандартныеОтчеты.ПолучитьСписокСчетовПоСубсчетам(ПараметрыОтчета.Группировка);
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(
					ГруппаЭлементовОтбора, "Счет", СписокСчетовПоСубсчетам,
					ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии, СписокСчетовПоСубсчетам.Количество() > 0);
				СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(Структура, "ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
				БылаГруппировкаСчет = Истина;
			Иначе
				ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
			КонецЕсли;
			Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
		КонецЕсли
	КонецЦикла;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПоСубсчетам", ПараметрыОтчета.ПоСубсчетам);
	
	// Отключим вывод отборов
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(Структура, "ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	
	Если ЕстьДетализацияПоСубконто Тогда
		Для Индекс = 1 По 3 Цикл 
			Структура = Структура.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
			ПолеГруппировки = Структура.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеГруппировки.Использование  = Истина;
			ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных("Субконто" + Индекс);
			ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
			
			Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
			
			Если ПараметрыОтчета.ПоказательВалютнаяСумма Тогда
				Структура = Структура.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
				ПолеГруппировки = Структура.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
				ПолеГруппировки.Использование  = Истина;
				ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных("Валюта");
				ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
				
				Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
				Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СтандартныеОтчеты.ДобавитьОтборПоОрганизацииФ(ПараметрыОтчета, КомпоновщикНастроек);
	
	УсловноеОформление = КомпоновщикНастроек.Настройки.УсловноеОформление.Элементы.Добавить();
	
КонецПроцедуры

Процедура ПослеКомпоновкиМакета(ПараметрыОтчета, МакетКомпоновки) Экспорт
	
	МакетШапкиОтчета = СтандартныеОтчеты.ПолучитьМакетШапки(МакетКомпоновки);
	
	КоличествоПоказателей = СтандартныеОтчеты.КоличествоПоказателейФ(ПараметрыОтчета, ПолучитьНаборПоказателей());
	
	КоличествоГруппировок = 0;
	Для Каждого СтрокаТаблицы Из ПараметрыОтчета.Группировка Цикл
		Если СтрокаТаблицы.Использование Тогда
			КоличествоСубконто = СтрЧислоВхождений(СтрокаТаблицы.ПоСубконто, "+");
			КоличествоГруппировок = Макс(КоличествоГруппировок, КоличествоСубконто);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ГруппаЕПСБУ Из ПараметрыОтчета.ГруппировкаЕПСБУ Цикл
		Если ГруппаЕПСБУ.Использование Тогда
			КоличествоГруппировок = КоличествоГруппировок + 1;
		КонецЕсли;
	КонецЦикла;
	

	КоличествоСтрокШапки = Макс(КоличествоГруппировок, 2);
	ПараметрыОтчета.ВысотаШапки = КоличествоСтрокШапки;
	
	МассивДляУдаления = Новый Массив;
	Для Индекс = КоличествоСтрокШапки По МакетШапкиОтчета.Макет.Количество() - 1 Цикл
		МассивДляУдаления.Добавить(МакетШапкиОтчета.Макет[Индекс]);
	КонецЦикла;
	
	КоличествоСтрок = МакетШапкиОтчета.Макет.Количество();
	Для ИндексСтроки = 2 По КоличествоСтрок - 1 Цикл
		СтрокаМакета = МакетШапкиОтчета.Макет[ИндексСтроки];
		
		КоличествоКолонок = СтрокаМакета.Ячейки.Количество();
		
		Для ИндексКолонки = КоличествоКолонок - 6 По КоличествоКолонок - 1 Цикл
			Ячейка = СтрокаМакета.Ячейки[ИндексКолонки];
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Ячейка.Оформление.Элементы, "ОбъединятьПоВертикали", Истина);
		КонецЦикла;
	КонецЦикла;
	
	Если КоличествоПоказателей > 1 Тогда
		Для ИндексСтроки = 1 По КоличествоСтрок - 1 Цикл
			СтрокаМакета = МакетШапкиОтчета.Макет[ИндексСтроки];
			
			КоличествоКолонок = СтрокаМакета.Ячейки.Количество();
			Ячейка = СтрокаМакета.Ячейки[КоличествоКолонок - 7];
			СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Ячейка.Оформление.Элементы, "ОбъединятьПоВертикали", Истина);
		КонецЦикла;
	КонецЕсли;	
	
	МакетПодвалаОтчета            = СтандартныеОтчеты.ПолучитьМакетПодвала(МакетКомпоновки);
	МакетГруппировкиОрганизация   = СтандартныеОтчеты.ПолучитьМакетГруппировкиПоПолюГруппировки(МакетКомпоновки, "Организация");
	МакетГруппировкиСчет          = СтандартныеОтчеты.ПолучитьМакетГруппировкиПоПолюГруппировки(МакетКомпоновки, "Счет");
	МакетГруппировкиПодразделение = СтандартныеОтчеты.ПолучитьМакетГруппировкиПоПолюГруппировки(МакетКомпоновки, "Подразделение");
	МакетГруппировкиВалюта        = СтандартныеОтчеты.ПолучитьМакетГруппировкиПоПолюГруппировки(МакетКомпоновки, "Валюта");
	
	Для Каждого Элемент Из МассивДляУдаления Цикл
		МакетШапкиОтчета.Макет.Удалить(Элемент);
	КонецЦикла;
	
	//Для Каждого Макет Из МакетКомпоновки.Макеты Цикл 
	//	Если Макет = МакетШапкиОтчета Тогда
	//	Иначе
	//		Индекс = -1;
	//		МассивПоказателей = Новый Массив;
	//		МассивПоказателей.Добавить("БУ");
	//		
	//		Для Каждого ИмяПоказателя Из МассивПоказателей Цикл
	//			Если ЭтотОбъект["Показатель" + ИмяПоказателя] Тогда
	//				Индекс = Индекс + 1;
	//			КонецЕсли;
	//		КонецЦикла;
	//		
	//		Если ПоказательВалютнаяСумма И КоличествоПоказателей = 1 Тогда 
	//			
	//		ИначеЕсли ПоказательВалютнаяСумма Тогда
	//			Индекс = Индекс + 1;
	//			Если МакетГруппировкиВалюта.Найти(Макет) <> Неопределено Тогда
	//				
	//			Иначе
	//				Макет.Макет.Удалить(Макет.Макет[Индекс]);
	//				Индекс = Индекс - 1;
	//			КонецЕсли;
	//		КонецЕсли;
	//	КонецЕсли;
	//КонецЦикла;
	
	КоличествоПоказателей = КоличествоПоказателей - ПараметрыОтчета.ПоказательВалютнаяСумма;
	Если КоличествоПоказателей > 0 Тогда
		ЗначенияПоказателей = Новый Массив(6, КоличествоПоказателей);
		Для Каждого Массив Из ЗначенияПоказателей Цикл
			Для Индекс = 0 По КоличествоПоказателей - 1 Цикл
				Массив[Индекс] = 0;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыОтчета.Удалить("ВременныеДанныеОтчета");
	
	ВременныеДанныеОтчета = Новый Структура;
	ВременныеДанныеОтчета.Вставить("МакетСчет"            , МакетГруппировкиСчет);
	ВременныеДанныеОтчета.Вставить("МакетШапкиОтчета"     , МакетШапкиОтчета);
	ВременныеДанныеОтчета.Вставить("МакетПодвал"          , МакетПодвалаОтчета);
	ВременныеДанныеОтчета.Вставить("КоличествоПоказателей", КоличествоПоказателей);
	ВременныеДанныеОтчета.Вставить("ЗначенияПоказателей"  , ЗначенияПоказателей);
	
	ПараметрыОтчета.Вставить("ВременныеДанныеОтчета", ВременныеДанныеОтчета);
	
КонецПроцедуры

Процедура ПередВыводомЭлементаРезультата(ПараметрыОтчета, МакетКомпоновки, ДанныеРасшифровки, ЭлементРезультата, Отказ = Ложь) Экспорт
	
	ВременныеДанныеОтчета = ПараметрыОтчета.ВременныеДанныеОтчета;
	Попытка
		Если ЭлементРезультата.ЗначенияПараметров.П1.Значение = null 
			И ПараметрыОтчета.ВременныеДанныеОтчета.МакетШапкиОтчета.Имя <> ЭлементРезультата.Макет
			И ЭлементРезультата.Макет <> ПараметрыОтчета.ВременныеДанныеОтчета.МакетПодвал.Имя Тогда
			Отказ = Истина;
		КонецЕсли; 
	Исключение
		// Запись в журнал регистрации не требуется
	КонецПопытки;
	
	СмещениеПоСтроке = ВременныеДанныеОтчета.МакетШапкиОтчета.Макет[0].Ячейки.Количество() - 7;
	// Накапливаем суммы по корневым счетам
	Попытка
		Если ВременныеДанныеОтчета.МакетСчет.Найти(МакетКомпоновки.Макеты[ЭлементРезультата.Макет]) <> Неопределено Тогда
			ЗначениеСчет = ДанныеРасшифровки.Элементы[ЭлементРезультата.ЗначенияПараметров.П2.Значение].ПолучитьПоля()[0].Значение;
			Если Не ЗначениеЗаполнено(ЗначениеСчет.Родитель) И Не ЗначениеСчет.Забалансовый Тогда
				Для Индекс = 0 По ВременныеДанныеОтчета.КоличествоПоказателей - 1 Цикл
					Для ПодИндекс = 1 По 6 Цикл
						Значение = ЭлементРезультата.ЗначенияПараметров[Строка(МакетКомпоновки.Макеты[ЭлементРезультата.Макет].Макет[Индекс].Ячейки[ПодИндекс + СмещениеПоСтроке].Элементы[0].Значение)].Значение;
						ВременныеДанныеОтчета.ЗначенияПоказателей[ПодИндекс - 1][Индекс] = ВременныеДанныеОтчета.ЗначенияПоказателей[ПодИндекс - 1][Индекс] + Значение;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли; 
	Исключение
		// Запись в журнал регистрации не требуется
	КонецПопытки;
	
	// Проставляем накопленные суммы в подвал отчета
	Если ЭлементРезультата.Макет = ВременныеДанныеОтчета.МакетПодвал.Имя Тогда
		Для Индекс = 0 По ВременныеДанныеОтчета.КоличествоПоказателей - 1 Цикл
			Для ПодИндекс = 1 По 6 Цикл
				ЭлементРезультата.ЗначенияПараметров[Строка(ВременныеДанныеОтчета.МакетПодвал.Макет[Индекс].Ячейки[ПодИндекс + СмещениеПоСтроке].Элементы[0].Значение)].Значение = ВременныеДанныеОтчета.ЗначенияПоказателей[ПодИндекс - 1][Индекс];
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеВыводаРезультата(ПараметрыОтчета, Результат) Экспорт
	
	//Удалим строки с высотой равной 1
	Индекс = Результат.ВысотаТаблицы;
	Пока Индекс > 0 Цикл
		ИндексСтроки = "R" + Формат(Индекс,"ЧГ=0");
		Если Результат.Область(ИндексСтроки).ВысотаСтроки = 1 Тогда
			Результат.УдалитьОбласть(Результат.Область(ИндексСтроки), ТипСмещенияТабличногоДокумента.ПоВертикали);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	СтандартныеОтчеты.ОбработкаРезультатаОтчетаФ(ПараметрыОтчета.ИдентификаторОтчета, Результат);
	
	Если Результат.Области.Найти("Заголовок") = Неопределено Тогда
		Результат.ФиксацияСверху = ПараметрыОтчета.ВысотаШапки;
	Иначе
		Результат.ФиксацияСверху = Результат.Области.Заголовок.Низ + ПараметрыОтчета.ВысотаШапки;
	КонецЕсли;
	
КонецПроцедуры

