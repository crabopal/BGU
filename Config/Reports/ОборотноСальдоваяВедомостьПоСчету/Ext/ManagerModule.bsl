//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ОборотноСальдоваяВедомостьПоСчету");
	НастройкиВарианта.Включен = Истина;
	НастройкиВарианта.Описание = НСтр("ru = 'Начальные и конечные остатки, обороты за период для выбранного счета'");
КонецПроцедуры

