////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПлановыеДатыОплаты.Учащийся.Организация КАК Организация,
	ПлановыеДатыОплаты.Учащийся КАК Учащийся,
	ПлановыеДатыОплаты.Факультет КАК Факультет,
	ПлановыеДатыОплаты.Валюта КАК Валюта,
	СУММА(ПлановыеДатыОплаты.Сумма) КАК СуммаПланДоПериода,
	ПлановыеДатыОплаты.Договор КАК Договор
{ВЫБРАТЬ
	Организация.*,
	Учащийся.*,
	Факультет.*,
	Валюта.*,
	Договор.*,
	СуммаПланДоПериода}
ИЗ
	РегистрСведений.ПлановыеДатыОплатыОбразование КАК ПлановыеДатыОплаты
ГДЕ
	ПлановыеДатыОплаты.Регистратор В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				Т.Регистратор
			ИЗ
				СрезПоследних КАК Т
			ГДЕ
				Т.Учащийся = ПлановыеДатыОплаты.Учащийся
				И Т.Факультет = ПлановыеДатыОплаты.Факультет
				И Т.Договор = ПлановыеДатыОплаты.Договор
				И Т.ДатаОплаты = ПлановыеДатыОплаты.ДатаОплаты
				И Т.Период = ПлановыеДатыОплаты.Период
			УПОРЯДОЧИТЬ ПО
				Т.Период УБЫВ,
				Т.Регистратор УБЫВ)
	И ПлановыеДатыОплаты.ДатаОплаты &lt; &amp;НачалоПериодаСрез
{ГДЕ
	ПлановыеДатыОплаты.Учащийся.*,
	ПлановыеДатыОплаты.Факультет.*,
	ПлановыеДатыОплаты.Валюта,
	ПлановыеДатыОплаты.АвтоРасчет,
	ПлановыеДатыОплаты.НачалоПериода,
	ПлановыеДатыОплаты.КонецПериода,
	ПлановыеДатыОплаты.Сумма КАК СуммаПланДоПериода}

СГРУППИРОВАТЬ ПО
	ПлановыеДатыОплаты.Учащийся.Организация,
	ПлановыеДатыОплаты.Учащийся,
	ПлановыеДатыОплаты.Факультет,
	ПлановыеДатыОплаты.Валюта,
	ПлановыеДатыОплаты.Договор
{ХАРАКТЕРИСТИКИ
	ТИП(Справочник.Студенты)
	ВИДЫХАРАКТЕРИСТИК ПланВидовХарактеристик.ПоляПриказовОбразование
	ПОЛЕКЛЮЧА Ссылка
	ПОЛЕИМЕНИ Наименование
	ПОЛЕТИПАЗНАЧЕНИЯ ТипЗначения
	ЗНАЧЕНИЯХАРАКТЕРИСТИК (ВЫБРАТЬ
			СведенияОбУчащихсяСрез.Студент КАК Студент,
			СведенияОбУчащихсяСрез.Поле КАК Поле,
			СведенияОбУчащихсяСрез.Значение КАК Значение
		ИЗ
			РегистрСведений.СведенияОСтудентах.СрезПоследних(&amp;КонецПериода, ) КАК СведенияОбУчащихсяСрез)
	ПОЛЕОБЪЕКТА Студент
	ПОЛЕВИДА Поле
	ПОЛЕЗНАЧЕНИЯ Значение }</query>
			<autoFillFields>false</autoFillFields>
