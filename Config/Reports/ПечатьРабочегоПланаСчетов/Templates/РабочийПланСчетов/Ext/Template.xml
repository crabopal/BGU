		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	КЭКСчетов.Счет КАК Счет,
	КОСГУ.Ссылка КАК КЭК,
	КЭКСчетов.НаименованиеСчета КАК НаименованиеСчета
ПОМЕСТИТЬ ВТ_КЭКСчетовИспользованные
ИЗ
	Справочник.КОСГУ КАК КОСГУ
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КЭКСчетов КАК КЭКСчетов
		ПО (КОСГУ.Ссылка = КЭКСчетов.КЭК ИЛИ
			( &amp;ДетализацияКЭК И
				(КОСГУ.Ссылка.Родитель В (КЭКСчетов.КЭК) ИЛИ КОСГУ.Ссылка.Родитель.Родитель В (КЭКСчетов.КЭК)) И
				КЭКСчетов.Счет В (&amp;СписокСчетов)
			)
		)
ГДЕ
	КЭКСчетов.Использовать = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РабочиеСчета.Счет,
	РабочиеСчета.КПС,
	РабочиеСчета.КФО,
	РабочиеСчета.Организация,
	РабочиеСчета.ИФО,
	РабочиеСчета.Актуален
ПОМЕСТИТЬ СчетаВТ
ИЗ
	РегистрСведений.РабочиеСчета.СрезПоследних({(&amp;Период)}) КАК РабочиеСчета
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СправочникКПС.Ссылка КАК КПС,
	СправочникКПС.Код КАК КПСКод,
	СправочникКПС.Наименование КАК КПСНаименование,
	СправочникКПС.ВидПоказателя КАК ВидКПС,
	СчетаВТ.КФО КАК КФО,
	СчетаВТ.КФО.Порядок + 1 КАК КФОКод,
	ЕПСБУ.Ссылка КАК Счет,
	ВЫБОР
		КОГДА ЕПСБУ.Ссылка.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
			ТОГДА ЕПСБУ.Ссылка
		ИНАЧЕ ВЫБОР
				КОГДА ЕПСБУ.Ссылка.Родитель.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
					ТОГДА ЕПСБУ.Ссылка.Родитель
				ИНАЧЕ ВЫБОР
						КОГДА ЕПСБУ.Ссылка.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
							ТОГДА ЕПСБУ.Ссылка.Родитель.Родитель
						ИНАЧЕ ЕПСБУ.Ссылка.Родитель.Родитель.Родитель
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ КАК СчетУровень0,
	ВЫБОР
		КОГДА ЕПСБУ.Ссылка.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
			ТОГДА ЕПСБУ.Ссылка
		ИНАЧЕ ВЫБОР
				КОГДА ЕПСБУ.Ссылка.Родитель.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
					ТОГДА ЕПСБУ.Ссылка
				ИНАЧЕ ВЫБОР
						КОГДА ЕПСБУ.Ссылка.Родитель.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
							ТОГДА ЕПСБУ.Ссылка.Родитель
						ИНАЧЕ ВЫБОР
								КОГДА ЕПСБУ.Ссылка.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
									ТОГДА ЕПСБУ.Ссылка.Родитель
								ИНАЧЕ ЕПСБУ.Ссылка.Родитель.Родитель
							КОНЕЦ
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ КАК СчетУровень1,
	ВЫБОР
		КОГДА ЕПСБУ.Ссылка.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
				ИЛИ ЕПСБУ.Ссылка.Родитель.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
			ТОГДА ЕПСБУ.Ссылка
		ИНАЧЕ ВЫБОР
				КОГДА ЕПСБУ.Ссылка.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
					ТОГДА ЕПСБУ.Ссылка
				ИНАЧЕ ЕПСБУ.Ссылка.Родитель
			КОНЕЦ
	КОНЕЦ КАК СчетУровень2,
	ЕПСБУ.Код КАК СчетКод,
	ЕПСБУ.Порядок КАК СчетПорядок,
	СправочникКЭК.Ссылка КАК КЭК,
	СправочникКЭК.Код КАК КЭККод,
	ВТ_КЭКСчетовИспользованные.НаименованиеСчета КАК Наименование,
	СчетаВТ.Организация,
	СчетаВТ.ИФО,
	СчетаВТ.Актуален
ИЗ
	СчетаВТ КАК СчетаВТ
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КЭКСчетовИспользованные КАК ВТ_КЭКСчетовИспользованные
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК СправочникКЭК
			ПО ВТ_КЭКСчетовИспользованные.КЭК = СправочникКЭК.Ссылка
		ПО СчетаВТ.Счет = ВТ_КЭКСчетовИспользованные.Счет
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификационныеПризнакиСчетов КАК СправочникКПС
		ПО СчетаВТ.КПС = СправочникКПС.Ссылка
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		ПО СчетаВТ.Счет = ЕПСБУ.Ссылка</query>
