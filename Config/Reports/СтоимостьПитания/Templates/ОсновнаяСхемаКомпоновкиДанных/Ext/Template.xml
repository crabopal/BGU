		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РасходПродуктов.Период КАК Период,
	РасходПродуктов.Организация КАК Организация,
	РасходПродуктов.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
	РасходПродуктов.КФО КАК КФО,
	РасходПродуктов.ИФО КАК ИФО,
	РасходПродуктов.Номенклатура КАК Номенклатура,
	СУММА(РасходПродуктов.Количество) КАК Количество,
	СУММА(РасходПродуктов.Сумма) КАК Сумма,
	КОНЕЦПЕРИОДА(РасходПродуктов.Период, НЕДЕЛЯ) КАК ПериодНеделя,
	КОНЕЦПЕРИОДА(РасходПродуктов.Период, ДЕКАДА) КАК ПериодДекада,
	КОНЕЦПЕРИОДА(РасходПродуктов.Период, МЕСЯЦ) КАК ПериодМесяц,
	КОНЕЦПЕРИОДА(РасходПродуктов.Период, КВАРТАЛ) КАК ПериодКвартал,
	КОНЕЦПЕРИОДА(РасходПродуктов.Период, ПОЛУГОДИЕ) КАК ПериодПолугодие,
	КОНЕЦПЕРИОДА(РасходПродуктов.Период, ГОД) КАК ПериодГод
{ВЫБРАТЬ
	Период,
	Организация.*,
	КатегорияДовольствующихся.*,
	КФО.*,
	ИФО.*,
	Номенклатура.*,
	Количество,
	Сумма}
ИЗ
	(ВЫБРАТЬ
		КОНЕЦПЕРИОДА(РасходПродуктов.Период, ДЕНЬ) КАК Период,
		РасходПродуктов.Организация КАК Организация,
		РасходПродуктов.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
		РасходПродуктов.КФО КАК КФО,
		РасходПродуктов.ИФО КАК ИФО,
		РасходПродуктов.Номенклатура КАК Номенклатура,
		СУММА(РасходПродуктов.Количество) КАК Количество,
		СУММА(РасходПродуктов.Сумма) КАК Сумма,
		МАКСИМУМ(РасходПродуктов.КоличествоДовольствующихся) КАК КоличествоДовольствующихся
	ИЗ
		РегистрНакопления.РасходПродуктов КАК РасходПродуктов
	ГДЕ
		РасходПродуктов.Активность
		И НЕ РасходПродуктов.ДобавитьКОсновномуКонтингенту
		И НЕ РасходПродуктов.Регистратор ССЫЛКА Документ.Сторно
	{ГДЕ
		РасходПродуктов.ИФО.*,
		РасходПродуктов.КФО.*,
		РасходПродуктов.Организация.*,
		(РасходПродуктов.Период &gt;= &amp;НачалоПериода),
		(РасходПродуктов.Период &lt;= &amp;КонецПериода)}
	
	СГРУППИРОВАТЬ ПО
		КОНЕЦПЕРИОДА(РасходПродуктов.Период, ДЕНЬ),
		РасходПродуктов.Организация,
		РасходПродуктов.КатегорияДовольствующихся,
		РасходПродуктов.КФО,
		РасходПродуктов.ИФО,
		РасходПродуктов.Номенклатура
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		КОНЕЦПЕРИОДА(РасходПродуктов.Период, ДЕНЬ),
		РасходПродуктов.Организация,
		РасходПродуктов.КатегорияДовольствующихся,
		РасходПродуктов.КФО,
		РасходПродуктов.ИФО,
		РасходПродуктов.Номенклатура,
		СУММА(РасходПродуктов.Количество),
		СУММА(РасходПродуктов.Сумма),
		СУММА(РасходПродуктов.КоличествоДовольствующихся)
	ИЗ
		РегистрНакопления.РасходПродуктов КАК РасходПродуктов
	ГДЕ
		РасходПродуктов.Активность
		И РасходПродуктов.ДобавитьКОсновномуКонтингенту
		И НЕ РасходПродуктов.Регистратор ССЫЛКА Документ.Сторно
	{ГДЕ
		РасходПродуктов.ИФО.*,
		РасходПродуктов.КФО.*,
		РасходПродуктов.Организация.*,
		(РасходПродуктов.Период &gt;= &amp;НачалоПериода),
		(РасходПродуктов.Период &lt;= &amp;КонецПериода)}
	
	СГРУППИРОВАТЬ ПО
		КОНЕЦПЕРИОДА(РасходПродуктов.Период, ДЕНЬ),
		РасходПродуктов.Организация,
		РасходПродуктов.КатегорияДовольствующихся,
		РасходПродуктов.КФО,
		РасходПродуктов.ИФО,
		РасходПродуктов.Номенклатура) КАК РасходПродуктов

СГРУППИРОВАТЬ ПО
	РасходПродуктов.Период,
	РасходПродуктов.Организация,
	РасходПродуктов.КатегорияДовольствующихся,
	РасходПродуктов.ИФО,
	РасходПродуктов.Номенклатура,
	РасходПродуктов.КФО,
	КОНЕЦПЕРИОДА(РасходПродуктов.Период, НЕДЕЛЯ),
	КОНЕЦПЕРИОДА(РасходПродуктов.Период, ДЕКАДА),
	КОНЕЦПЕРИОДА(РасходПродуктов.Период, МЕСЯЦ),
	КОНЕЦПЕРИОДА(РасходПродуктов.Период, КВАРТАЛ),
	КОНЕЦПЕРИОДА(РасходПродуктов.Период, ПОЛУГОДИЕ),
	КОНЕЦПЕРИОДА(РасходПродуктов.Период, ГОД)</query>
	</dataSet>
