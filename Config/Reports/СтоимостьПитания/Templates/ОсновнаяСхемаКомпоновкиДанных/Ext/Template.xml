			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	РасходПродуктов.Период КАК Период,
	РасходПродуктов.Организация КАК Организация,
	РасходПродуктов.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
	РасходПродуктов.КоличествоДовольствующихся КАК КоличествоДовольствующихся,
	РасходПродуктов.ДобавитьКОсновномуКонтингенту КАК ДобавитьКОсновномуКонтингенту
ПОМЕСТИТЬ ВТ_РасходПродуктов
ИЗ
	РегистрНакопления.РасходПродуктов КАК РасходПродуктов
ГДЕ
	РасходПродуктов.Активность
	И НЕ РасходПродуктов.Регистратор ССЫЛКА Документ.Сторно
{ГДЕ
	(РасходПродуктов.Период &gt;= &amp;НачалоПериода),
	(РасходПродуктов.Период &lt;= &amp;КонецПериода),
	РасходПродуктов.Организация.*,
	РасходПродуктов.КФО.*,
	РасходПродуктов.ИФО.*,
	РасходПродуктов.КатегорияДовольствующихся.*}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РасходПродуктов.Период,
	РасходПродуктов.Организация,
	РасходПродуктов.КатегорияДовольствующихся,
	СУММА(РасходПродуктов.КоличествоДовольствующихся) КАК КоличествоДовольствующихся
ИЗ
	(ВЫБРАТЬ
		КОНЕЦПЕРИОДА(РасходПродуктов.Период, ДЕНЬ) КАК Период,
		РасходПродуктов.Организация КАК Организация,
		РасходПродуктов.КатегорияДовольствующихся КАК КатегорияДовольствующихся,
		МАКСИМУМ(РасходПродуктов.КоличествоДовольствующихся) КАК КоличествоДовольствующихся
	ИЗ
		ВТ_РасходПродуктов КАК РасходПродуктов
	ГДЕ
		РасходПродуктов.ДобавитьКОсновномуКонтингенту = ЛОЖЬ
	
	СГРУППИРОВАТЬ ПО
		КОНЕЦПЕРИОДА(РасходПродуктов.Период, ДЕНЬ),
		РасходПродуктов.Организация,
		РасходПродуктов.КатегорияДовольствующихся
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		КОНЕЦПЕРИОДА(РасходПродуктов.Период, ДЕНЬ),
		РасходПродуктов.Организация,
		РасходПродуктов.КатегорияДовольствующихся,
		СУММА(РасходПродуктов.КоличествоДовольствующихся)
	ИЗ
		ВТ_РасходПродуктов КАК РасходПродуктов
	ГДЕ
		РасходПродуктов.ДобавитьКОсновномуКонтингенту = ИСТИНА
	
	СГРУППИРОВАТЬ ПО
		КОНЕЦПЕРИОДА(РасходПродуктов.Период, ДЕНЬ),
		РасходПродуктов.Организация,
