#Область СлужебныйПрограммныйИнтерфейс

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "СводныеДанныеОбИсполненииБюджетаПБС");
	НастройкиВарианта.Описание = НСтр("ru = 'Суммы доведенных бюджетных назначений, поставленных на учет обязательсв и кассового исполнения.'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "СводныеДанныеОбИсполненииОбязательств");
	НастройкиВарианта.Описание = НСтр("ru = 'Суммы принятых обязательств, денежных обязательств, кассового исполнения и остатков неисполненных обязательств'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "СтруктураКассовыхРасходовПБС");
	НастройкиВарианта.Описание = НСтр("ru = 'Суммы доведенных бюджетных назначений, кассовых расходов и восстановления расходов'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "СводныеДанныеОФинансированииНаБанковскиеСчетаПБС");
	НастройкиВарианта.Описание = НСтр("ru = 'Суммы полученного на банковские счета бюджетного финасирования, остатки на счетах, открытых в учреждениях банка'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "КассовоеИсполнениеГоспрограмм");
	НастройкиВарианта.Описание = НСтр("ru = 'Бюджетные назначения, кассовые расходы и процент исполнения государственных программ'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ДляИзменения");
	НастройкиВарианта.ВидимостьПоУмолчанию = Ложь;
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
	
КонецПроцедуры

Функция СвойстваОбъектаДляРасшифровкиСтандартнымиОтчетами(ОтчетОбъект) Экспорт
	
	ПараметрыПериода = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Период");
	
	Если НЕ ПараметрыПериода = Неопределено Тогда
		ПараметрыПериодаПользовательскаяНастройка = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(
			ПараметрыПериода.ИдентификаторПользовательскойНастройки);
		Если НЕ ПараметрыПериодаПользовательскаяНастройка = Неопределено Тогда
			ПараметрыПериода = ПараметрыПериодаПользовательскаяНастройка;
		КонецЕсли;
	Иначе
		Возврат Новый Структура;
	КонецЕсли;
	
	СвойстваОбъекта = Новый Структура;
	
	Если ПараметрыПериода.Использование Тогда
		СвойстваОбъекта.Вставить("НачалоПериода", ПараметрыПериода.Значение.ДатаНачала);
		СвойстваОбъекта.Вставить("КонецПериода", ПараметрыПериода.Значение.ДатаОкончания);
	Иначе
		СвойстваОбъекта.Вставить("НачалоПериода", Дата(1,1,1));
		СвойстваОбъекта.Вставить("КонецПериода", Дата(1,1,1));
	КонецЕсли;
	
	Организация = Неопределено;
	Для Каждого Настройка Из ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(Настройка) = Тип("ЭлементОтбораКомпоновкиДанных")
			И ТипЗнч(Настройка.ПравоеЗначение) = Тип("СправочникСсылка.Организации") Тогда
			Организация = Настройка.ПравоеЗначение;
		КонецЕсли;
	КонецЦикла;
	
	МассивОтчетов = Новый Массив;
	МассивОтчетов.Добавить("ОборотноСальдоваяВедомостьПоСчету");
	МассивОтчетов.Добавить("КарточкаСчета");
	МассивОтчетов.Добавить("АнализСчета");
	МассивОтчетов.Добавить("ОборотыСчета");
	
	СвойстваОбъекта.Вставить("ОтчетыРасшифровки", МассивОтчетов);
	
	МассивОсновныхДействий = Новый Массив;
	МассивОсновныхДействий.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
	МассивОсновныхДействий.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Расшифровать);
	МассивОсновныхДействий.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Сгруппировать);
	
	СвойстваОбъекта.Вставить("МассивОсновныхДействий", МассивОсновныхДействий);
	
	СвойстваОбъекта.Вставить("ДоступнаРасшифровкаВариантамиОтчета");
	
	// Структура устанавливает соответствие между показателем и счетом, нужно для рассшифровки
	ПараметрыГода = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("ТекущийГод");
	
	Если НЕ ПараметрыГода = Неопределено Тогда
		ПараметрыПериодаПользовательскаяНастройка = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(
			ПараметрыГода.ИдентификаторПользовательскойНастройки);
		Если НЕ ПараметрыПериодаПользовательскаяНастройка = Неопределено Тогда
			ПараметрыГода = ПараметрыПериодаПользовательскаяНастройка;
		КонецЕсли;
	Иначе
		Возврат Новый Структура;
	КонецЕсли;
	ТекущийГод = ПараметрыГода.Значение;
	
	ПоказательСчет = Новый Структура;
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ПолученныеАссигнования",
		"503."+ТекущийГод+"3", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ПолученныеЛБО",
		"501."+ТекущийГод+"3", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ДетализацияАссигнований",
		"503."+ТекущийГод+"3", "503."+ТекущийГод+"3",
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ДетализацияЛБО",
		"501."+ТекущийГод+"3", "501."+ТекущийГод+"3",
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ПолученоНаБанковскиеСчета",
		"304.04", "201.21",
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ПОФ",
		"ПОФ.С", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"Ассигнования",
		"503."+ТекущийГод+"3", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ЛБО",
		"501."+ТекущийГод+"3", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ПринимаемыеОбязательства",
		"502."+ТекущийГод+"7", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ПринятоОбязательств",
		"502."+ТекущийГод+"1", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ПринятоБюджетныхОбязательств",
		"502."+ТекущийГод+"1", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ПринятоБюджетныхОбязательствКонкурс",
		"502."+ТекущийГод+"1", "502."+ТекущийГод+"7",
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ПринятоБОАссигнования",
		"502."+ТекущийГод+"1", "503."+ТекущийГод+"3",
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ПринятоДенежныхОбязательств",
		"502."+ТекущийГод+"2", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"КассовыеВыбытия",
		"18", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"КассовыеВыбытия",
		"304.05", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ВосстановленоРасходов",
		"18", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"ВосстановленоРасходов",
		"304.05", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"КассовыеРасходы",
		"18", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,
		"КассовыеРасходы",
		"304.05", ,
		СвойстваОбъекта.КонецПериода,
		Организация);
	
	СвойстваОбъекта.Вставить("ПоказательСчет", ПоказательСчет);
	
	Возврат СвойстваОбъекта;
	
КонецФункции

#КонецОбласти

#КонецЕсли
