#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ИсполняемыеНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	МОЛИзОтбора = Справочники.Сотрудники.ПустаяСсылка();
	ПодразделениеИзОтбора = Справочники.Подразделения.ПустаяСсылка();
	ПолеЦМО = Новый ПолеКомпоновкиДанных("ЦМО");
	ПолеПодразделение = Новый ПолеКомпоновкиДанных("Подразделение");
	Для каждого ЭлементОтбора Из ИсполняемыеНастройки.Отбор.Элементы Цикл
	
		Если ЭлементОтбора.Использование И ЭлементОтбора.ЛевоеЗначение = ПолеЦМО
			И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
			И ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) Тогда
			
			МОЛИзОтбора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлементОтбора.ПравоеЗначение, "Сотрудник");
			
		КонецЕсли;
	
		Если ЭлементОтбора.Использование И ЭлементОтбора.ЛевоеЗначение = ПолеПодразделение
			И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
			И ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) Тогда
			
			ПодразделениеИзОтбора = ЭлементОтбора.ПравоеЗначение;
			
		КонецЕсли;
	
	КонецЦикла;
	
	ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра("МОЛИзОтбора", МОЛИзОтбора);
	ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПодразделениеИзОтбора", ПодразделениеИзОтбора);
	
	// вывод отчета
	СтандартнаяОбработка = Ложь;
	ВозможностьИспользованияВнешнихФункций = Истина;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ИсполняемыеНастройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, ВозможностьИспользованияВнешнихФункций);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	
	ОтчетПустой = Истина;

	ПроцессорВывода.НачатьВывод();
	Пока Истина Цикл
		
		ЭлементРезультата = ПроцессорКомпоновкиДанных.Следующий();
		Если ЭлементРезультата = Неопределено Тогда
			Прервать;
		Иначе
			ПроцессорВывода.ВывестиЭлемент(ЭлементРезультата);
			// Проверить, что отчет содержит данные
			Если ОтчетПустой Тогда
				Для Каждого ЗначениеПараметраМакета Из ЭлементРезультата.ЗначенияПараметров Цикл
					Попытка
						Если ЗначениеЗаполнено(ЗначениеПараметраМакета.Значение) Тогда
							ОтчетПустой = Ложь;
							Прервать;
						КонецЕсли;
					Исключение
						// Исключение обрабатывать не требуется
					КонецПопытки;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	// Сохранить признак ОтчетПустой для подсистемы Рассылка отчетов
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ОтчетПустой", ОтчетПустой);
	
	// доработка табличного документа
	ДокументРезультат.ФиксацияСлева = 0;
	ДокументРезультат.ФиксацияСверху = 0;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//   Форма - УправляемаяФорма, Неопределено - Форма отчета или форма настроек отчета.
//       Неопределено когда вызов без контекста.
//   КлючВарианта - Строка, Неопределено - Имя предопределенного
//       или уникальный идентификатор пользовательского варианта отчета.
//       Неопределено когда вызов без контекста.
//   Настройки - Структура - см. возвращаемое значение
//       ОтчетыКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию().
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	Настройки.Печать.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
КонецПроцедуры

#КонецОбласти

#КонецЕсли