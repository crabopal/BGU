// Книга продаж, дополнительные листы (отчет)

////////////////////////////////////////////////////////////////////////////////
// [0].	Строка Итого (обороты по Книге продаж за указанный налоговый период).
//		(Финальная таблица)
//
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕСТЬNULL(
		СУММА(КнигаПродажОбороты.СуммаБезНДСОборот + КнигаПродажОбороты.СуммаНДСОборот),
		0)															КАК ВсегоПродаж,
	ЕСТЬNULL(
		СУММА(ВЫБОР
			КОГДА КнигаПродажОбороты.ПричинаНалогообложения В (&amp;ПричиныНалогообложенияАванс) ТОГДА
				0
			ИНАЧЕ
				ВЫБОР
					КОГДА	КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18)
						ИЛИ КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18_118) ТОГДА
						КнигаПродажОбороты.СуммаБезНДСОборот
					ИНАЧЕ
						0
				КОНЕЦ
		КОНЕЦ),
		0)															КАК СуммаБезНДС18,
	ЕСТЬNULL(
		СУММА(ВЫБОР
			КОГДА	КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18)
				ИЛИ КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18_118) ТОГДА
				КнигаПродажОбороты.СуммаНДСОборот
			ИНАЧЕ
				0
		КОНЕЦ),
		0)															КАК НДС18,
	ЕСТЬNULL(
		СУММА(ВЫБОР
			КОГДА КнигаПродажОбороты.ПричинаНалогообложения В (&amp;ПричиныНалогообложенияАванс) ТОГДА
				0
			ИНАЧЕ
				ВЫБОР
					КОГДА	КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10)
						ИЛИ КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10_110) ТОГДА
						КнигаПродажОбороты.СуммаБезНДСОборот
					ИНАЧЕ
						0
				КОНЕЦ
		КОНЕЦ),
		0)															КАК СуммаБезНДС10,
	ЕСТЬNULL(
		СУММА(ВЫБОР
			КОГДА	КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10)
				ИЛИ КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10_110) ТОГДА
				КнигаПродажОбороты.СуммаНДСОборот
			ИНАЧЕ
				0
		КОНЕЦ),
		0)															КАК НДС10,
	ЕСТЬNULL(
		СУММА(ВЫБОР
			КОГДА КнигаПродажОбороты.ПричинаНалогообложения В (&amp;ПричиныНалогообложенияАванс) ТОГДА
				0
			ИНАЧЕ
				ВЫБОР
					КОГДА КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0) ТОГДА
						КнигаПродажОбороты.СуммаБезНДСОборот
					ИНАЧЕ
						0
				КОНЕЦ
		КОНЕЦ),
		0)															КАК Сумма0,
	ЕСТЬNULL(
		СУММА(ВЫБОР
			КОГДА КнигаПродажОбороты.ПричинаНалогообложения В (&amp;ПричиныНалогообложенияАванс) ТОГДА
				0
			ИНАЧЕ
				ВЫБОР
					КОГДА	КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
						ИЛИ КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20_120) ТОГДА
						КнигаПродажОбороты.СуммаБезНДСОборот
					ИНАЧЕ
						0
				КОНЕЦ
		КОНЕЦ),
		0)															КАК СуммаБезНДС20,
	ЕСТЬNULL(
		СУММА(ВЫБОР
			КОГДА КнигаПродажОбороты.ПричинаНалогообложения В (&amp;ПричиныНалогообложенияАванс) ТОГДА
				0
			ИНАЧЕ
				ВЫБОР
					КОГДА	КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
						ИЛИ КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20_120) ТОГДА
						КнигаПродажОбороты.СуммаНДСОборот
					ИНАЧЕ
						0
				КОНЕЦ
		КОНЕЦ),
		0)															КАК НДС20,
	ЕСТЬNULL(
		СУММА(ВЫБОР
			КОГДА КнигаПродажОбороты.ПричинаНалогообложения В (&amp;ПричиныНалогообложенияАванс) ТОГДА
				0
			ИНАЧЕ
				ВЫБОР
					КОГДА	КнигаПродажОбороты.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС) ТОГДА
						КнигаПродажОбороты.СуммаБезНДСОборот
					ИНАЧЕ
						0
				КОНЕЦ
		КОНЕЦ),
		0)															КАК СуммаБН
ИЗ
	РегистрНакопления.КнигаПродаж.Обороты(&amp;ДатаНачалаНалоговогоПериода, &amp;ДатаОкончанияНалоговогоПериода) КАК КнигаПродажОбороты
{ГДЕ
	КнигаПродажОбороты.Организация.*,
	КнигаПродажОбороты.КФО.*,
	КнигаПродажОбороты.ПричинаНалогообложения,
	КнигаПродажОбороты.ДатаОплаты,
	КнигаПродажОбороты.СчетФактура.ИФО.* КАК ИФО,
	КнигаПродажОбороты.СчетФактура.Контрагент.* КАК Контрагент}
;
</query>
