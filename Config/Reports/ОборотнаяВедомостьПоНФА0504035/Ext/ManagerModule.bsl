Функция СвойстваОбъектаДляРасшифровкиСтандартнымиОтчетами(ОтчетОбъект) Экспорт
	
	СвойстваОбъекта = Новый Структура;
	
	МассивОтчетов = Новый Массив;
	МассивОтчетов.Добавить("ОборотноСальдоваяВедомостьПоСчету");
	МассивОтчетов.Добавить("КарточкаСчета");
	МассивОтчетов.Добавить("АнализСчета");
	МассивОтчетов.Добавить("ОборотыСчета");
	МассивОтчетов.Добавить("КарточкаСубконто");
	
	Настройки = ОсновныеИсполняемыеНастройкиОтчета(ОтчетОбъект);
	
	СписокВидовСубконто = Новый СписокЗначений;
	Если ЕстьСубконто(Настройки.Счет, ПланыВидовХарактеристик.ВидыСубконто.Номенклатура) Тогда
		СписокВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	Иначе
		СписокВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	КонецЕсли;
	СписокВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	Период = ПараметрПользовательскихНастроек(ОтчетОбъект, "Период");
	Счет = ПараметрПользовательскихНастроек(ОтчетОбъект, "Счет");
	
	СвойстваОбъекта.Вставить("НачалоПериода",       Период.Значение.ДатаНачала);
	СвойстваОбъекта.Вставить("КонецПериода",        Период.Значение.ДатаОкончания);
	СвойстваОбъекта.Вставить("ОтчетыРасшифровки",   МассивОтчетов);
	СвойстваОбъекта.Вставить("СписокВидовСубконто", СписокВидовСубконто);
	СвойстваОбъекта.Вставить("ПоказательСчет",      Новый Структура);
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(СвойстваОбъекта.ПоказательСчет,
		"Субконто1", "" + Счет.Значение);
	
	
	Возврат СвойстваОбъекта;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрПользовательскихНастроек(ОтчетОбъект, ИмяПараметра)
	
	Параметр = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных
		.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(ИмяПараметра));
	ИдентификаторНастройки = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки
		.ПолучитьИдентификаторПоОбъекту(Параметр);
	ЗначениеПараметра = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки
		.ПолучитьОбъектПоИдентификатору(ИдентификаторНастройки);
	
	Возврат ЗначениеПараметра;
	
КонецФункции

Функция ЗначениеЦМООтбор(ПараметрыОтчета)
	КомпоновщикНастроек = ПараметрыОтчета.КомпоновщикНастроек;
	Для каждого Элемент из КомпоновщикНастроек.настройки.Отбор.Элементы цикл
		Если Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЦМО") и Элемент.Использование тогда
			Если ТипЗнч(Элемент.ПравоеЗначение) = Тип("СправочникСсылка.ЦМО") тогда
//				Возврат Справочники.Сотрудники.ФамилияИО(Элемент.ПравоеЗначение.Сотрудник);
				Возврат Элемент.ПравоеЗначение.Сотрудник;
			ИначеЕсли ТипЗнч(Элемент.ПравоеЗначение) = Тип("СписокЗначений") тогда	
				СтрокаЦМО = "";
				Для каждого ЦМО из Элемент.ПравоеЗначение цикл
					СтрокаЦМО = СтрокаЦМО + ", "+Справочники.Сотрудники.ФамилияИО(ЦМО.Значение.Сотрудник);
				КонецЦикла;	
				Возврат Прав(СтрокаЦМО,СтрДлина(СтрокаЦМО) - 1);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	Возврат "";
КонецФункции	

Функция ЕстьСубконто(Счет, ВидСубконто)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка В ИЕРАРХИИ(&Счет)
	|	И ЕПСБУВидыСубконто.ВидСубконто = &ВидСубконто";
	Запрос.УстановитьПараметр("Счет", Счет);
	Запрос.УстановитьПараметр("ВидСубконто", ВидСубконто);
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ОсновныеИсполняемыеНастройкиОтчета(ОтчетОбъект)
	
	ИсполняемыеНастройки = ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрыОтчета = ИсполняемыеНастройки.ПараметрыДанных;
	
	Настройки = Новый Структура("Организация, Подразделение, Период, Счет");
	
	Настройки.Организация = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация")).Значение;
	Настройки.Подразделение = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Подразделение")).Значение;
	Настройки.Период = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период")).Значение;
	Настройки.Счет = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Счет")).Значение;
	
	Возврат Настройки;
	
КонецФункции

#КонецОбласти

#КонецЕсли