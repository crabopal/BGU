Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	Настройки = ОсновныеИсполняемыеНастройкиОтчета(ОтчетОбъект);
	
	СвойстваРегистраУчета.Вставить("Организация", 	Настройки.Организация);
	СвойстваРегистраУчета.Вставить("НачалоПериода", Настройки.Период.ДатаНачала);
	СвойстваРегистраУчета.Вставить("КонецПериода", 	Настройки.Период.ДатаОкончания);
	СвойстваРегистраУчета.Вставить("ДополнениеИмени", "");	
	СвойстваРегистраУчета.Вставить("ПодразделениеОрганизации", Настройки.Подразделение);
	
	//ОтчетОбъект.Свойство("Подразделение",						СвойстваРегистраУчета.ПодразделениеОрганизации);
