&НаКлиенте
Процедура ОткрытьНастройкиНажатие(Элемент)
	
	ТекущийОтчет = СтрЗаменить(Элемент.Имя,"Настройка","");
	ПриСменеОтчета(ТекущийОтчет);
	
	Меню = НовоеМенюНастроек(ТекущийОтчет);
	Оповещение = Новый ОписаниеОповещения("МенюНастроекСобытийНажатиеЗавершение", ЭтотОбъект, ТекущийОтчет);
	ПоказатьВыборИзМеню(Оповещение, Меню, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ВсеНастройкиЗавершение(Результат, ПараметрыВыполнения) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	БыстрыеНастройкиЗаполнитьКлиент(Результат);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИнтервалы

&НаКлиенте
Процедура ЗавершениеВыбораИнтервала(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		ТекущийИнтервал = ВыбранныйЭлемент.Значение;
		ТекущийИнтервалСтрока = "Периодичность диаграмм: " + ВыбранныйЭлемент.Представление;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнтервалыПриИзменении(Элемент)
	
	Отчет.Интервалы.Сортировать("Значение Возр");
	
	ПерваяСтрока = Истина;
	ПредыдущееЗначение = 0;
	Для Каждого Интервал Из Отчет.Интервалы Цикл
		Если ПерваяСтрока Тогда
			Интервал.Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'До %1 дней'"), Интервал.Значение);
			ПредыдущееЗначение = Интервал.Значение;
			ПерваяСтрока = Ложь;
		Иначе
			Интервал.Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'От %1 до %2 дней'"), ПредыдущееЗначение + 1, Интервал.Значение);
			ПредыдущееЗначение = Интервал.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	СформироватьОтчетНаСервере();
	
	Элементы.Страницы.ТекущаяСтраница = Элементы["СтраницаРезультат"];
	Элементы.НастройкаИнтервалов.Пометка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("НачалоПериода", Отчет.НачалоПериода);
	СтруктураПараметров.Вставить("КонецПериода",  Отчет.КонецПериода);
	
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(СтруктураПараметров, ЭтаФорма, "УстановитьПериодЗавершение");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодЗавершение(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Отчет.НачалоПериода = РезультатВыбора.НачалоПериода;
		Отчет.КонецПериода  = РезультатВыбора.КонецПериода;
		
		УстановитьСостояние(ЭтаФорма);
		УстановитьПризнакиМодифицированности(ЭтаФорма);
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьНастройкуИнтервалов(Команда)
	Элементы.НастройкаИнтервалов.Пометка = НЕ Элементы.НастройкаИнтервалов.Пометка;
	Если Элементы.НастройкаИнтервалов.Пометка Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы["СтраницаИнтервалы"];
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы["СтраницаРезультат"];
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтандартныеНастройкиДляВсехОтчетов(Команда)
	УстановитьСтандартныеНастройкиДляВсехОтчетовНаСервере();
	ЗаполнитьТаблицуИнтерваловПоУмолчанию(Отчет);
	УстановитьСостояние(ЭтаФорма);
	УстановитьПризнакиМодифицированности(ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьОтчетНаСервере()
	
	Если ЗначениеЗаполнено(Отчет.ИФО) И НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Отчет.ИФО = "";
	КонецЕсли;
	Если ЗначениеЗаполнено(Отчет.Подразделение) И НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Отчет.Подразделение = "";
	КонецЕсли;
	
	Результат 				= ЭтаФорма["Результат"+ТекущийОтчет];
	ДанныеРасшифровки 		= "";
	URLСхемы 				= ЭтаФорма["URLСхемы"+ТекущийОтчет];
	СхемаКомпоновкиДанных 	= ПолучитьИзВременногоХранилища(URLСхемы);
	КомпоновщикНастроек 	= ЭтаФорма["КомпоновщикНастроек"+ТекущийОтчет];
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы);
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	
	КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыводитьЗаголовок", ВыводитьЗаголовок);
	КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыводитьПодвал"   , ВыводитьПодвал);
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("НачалоПериода"					 , НачалоДня(Отчет.НачалоПериода));
	ПараметрыОтчета.Вставить("КонецПериода"						 , КонецДня(Отчет.КонецПериода));
	ПараметрыОтчета.Вставить("КонецПериодаГраница"				 , Новый Граница(КонецДня(Отчет.КонецПериода),ВидГраницы.Включая));
	ПараметрыОтчета.Вставить("КомпоновщикНастроек"				 , КомпоновщикНастроек);
	ПараметрыОтчета.Вставить("УникальныйИдентификатор"			 , ЭтаФорма.УникальныйИдентификатор);
	ПараметрыОтчета.Вставить("СхемаКомпоновкиДанных"			 , URLСхемы);
	ПараметрыОтчета.Вставить("ВалютаРегламентная"				 , ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета());
	ПараметрыОтчета.Вставить("ВалютаРегламентнаяСтрока"			 , ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета(), "Наименование"));
	ПараметрыОтчета.Вставить("Организация"						 , Отчет.Организация);
	ПараметрыОтчета.Вставить("НетОрганизации"					 , НЕ ЗначениеЗаполнено(Отчет.Организация));
	ПараметрыОтчета.Вставить("ИФО"								 , Отчет.ИФО);
	ПараметрыОтчета.Вставить("НетИФО"							 , НЕ ЗначениеЗаполнено(Отчет.ИФО));
	ПараметрыОтчета.Вставить("КФО"								 , Отчет.КФО);
	ПараметрыОтчета.Вставить("НетКФО"							 , НЕ ЗначениеЗаполнено(Отчет.КФО));
	ПараметрыОтчета.Вставить("Подразделение"					 , Отчет.Подразделение);
	ПараметрыОтчета.Вставить("НетПодразделения"					 , НЕ ЗначениеЗаполнено(Отчет.Подразделение));
	ПараметрыОтчета.Вставить("Периодичность"					 , ТекущийИнтервал);
	ПараметрыОтчета.Вставить("ТекущийОтчет"						 , ТекущийОтчет);
	ПараметрыОтчета.Вставить("Интервалы"						 , Отчет.Интервалы.Выгрузить());
	ПараметрыОтчета.Вставить("ТекущийИнтервал"					 , ТекущийИнтервал);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы["Результат"+ТекущийОтчет], "ФОРМИРОВАНИЕОТЧЕТА");
	
	Отчеты.КонсольРуководителя.СформироватьОтчет(ПараметрыОтчета, ДанныеРасшифровки, Результат, ПоказательСчет);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы["Результат"+ТекущийОтчет], "НЕИСПОЛЬЗОВАТЬ");
	
	УстановитьСостояние(ЭтаФорма, Истина, "Результат"+ТекущийОтчет);
	УстановитьПризнакиМодифицированности(ЭтаФорма, Ложь, "Модифицированность"+ТекущийОтчет);
	
	ЭтаФорма["ДанныеРасшифровки"+ТекущийОтчет] 	= ДанныеРасшифровки;
	ЭтаФорма["URLСхемы"+ТекущийОтчет] 			= URLСхемы;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеОтчета(ТекОтчет)
	
	УправлениеЦветомСпискаОтчетов(Элементы.Список);
	
	Элементы.ГруппаРезультат.ТекущаяСтраница = Элементы["Группа" + ТекОтчет];
	Элементы.Страницы.ТекущаяСтраница = Элементы["СтраницаРезультат"];
	Элементы.НастройкаИнтервалов.Пометка = Ложь;
	
	Если ЭтаФорма["Модифицированность"+ТекОтчет] Тогда
		СформироватьОтчетНаСервере();
	КонецЕсли;
	
	НастройкиОтчета.Вставить("АдресСхемы", ЭтаФорма["URLСхемы"+ТекОтчет]);
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеЦветомСпискаОтчетов(ГруппаПоиска)
	ИмяТекущегоЭлемента = "Декорация"+ТекущийОтчет;
	Для Каждого Элемент Из ГруппаПоиска.ПодчиненныеЭлементы Цикл
		Если Элемент.Вид = ВидГруппыФормы.ОбычнаяГруппа Тогда
			УправлениеЦветомСпискаОтчетов(Элемент);
		ИначеЕсли Элемент.Вид = ВидДекорацииформы.Надпись Тогда
			Если Элемент.Имя = ИмяТекущегоЭлемента Тогда
				Элемент.ЦветТекста = WebЦвета.Коричневый;
				Элемент.Гиперссылка = Ложь;
			Иначе
				Элемент.ЦветТекста = Новый Цвет();
				Элемент.Гиперссылка = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСостояние(Форма, НеИспользовать = Ложь, ИмяЭлементаФормы = Неопределено)
	
	Если ИмяЭлементаФормы = Неопределено Тогда
		ПоддерживаемыеИменаЭлементовФормы = Новый Структура("
		|РезультатОстаткиДенежныхСредств,
		|РезультатДинамикаОстатковДенежныхСредств,
		|РезультатСтруктураПоступленийДенежныхСредств,
		|РезультатСтруктураРасходовДенежныхСредств,
		|РезультатКредиторыЗадолженностьСрокиИсполнения,
		|РезультатКредиторыЗадолженностьСрокиВозникновения,
		|РезультатКредиторыДинамикаИзмененияЗадолженности,
		|РезультатДебиторыЗадолженностьСрокиИсполнения,
		|РезультатДебиторыЗадолженностьСрокиВозникновения,
		|РезультатДебиторыДинамикаИзмененияЗадолженности,
		|РезультатИсполнениеПлановыхНазначений,
		|РезультатИсполнениеПринятыхОбязательств,
		|РезультатИсполнениеДинамика");
	Иначе
		ПоддерживаемыеИменаЭлементовФормы = Новый Структура("
		|"+ИмяЭлементаФормы);
	КонецЕсли;
	
	Для Каждого Элем Из ПоддерживаемыеИменаЭлементовФормы Цикл
		ИспользуемыйЭлементФормы = Форма.Элементы[Элем.Ключ];
		Если НеИспользовать Тогда
			ИспользуемыйЭлементФормы.ОтображениеСостояния.Видимость                      = Ложь;
			ИспользуемыйЭлементФормы.ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.НеИспользовать;
			ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(ИспользуемыйЭлементФормы, "НЕИСПОЛЬЗОВАТЬ");
		Иначе
			ИспользуемыйЭлементФормы.ОтображениеСостояния.Видимость                      = Истина;
			ИспользуемыйЭлементФормы.ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
			ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(ИспользуемыйЭлементФормы, "НЕАКТУАЛЬНОСТЬ");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПризнакиМодифицированности(Форма, Установить = Истина, ИмяРеквизитаФормы = Неопределено)
	
	Если ИмяРеквизитаФормы = Неопределено Тогда
		ПоддерживаемыеИменаРеквизитовФормы = Новый Структура("
		|МодифицированностьОстаткиДенежныхСредств,
		|МодифицированностьДинамикаОстатковДенежныхСредств,
		|МодифицированностьСтруктураПоступленийДенежныхСредств,
		|МодифицированностьСтруктураРасходовДенежныхСредств,
		|МодифицированностьКредиторыЗадолженностьСрокиИсполнения,
		|МодифицированностьКредиторыЗадолженностьСрокиВозникновения,
		|МодифицированностьКредиторыДинамикаИзмененияЗадолженности,
		|МодифицированностьДебиторыЗадолженностьСрокиИсполнения,
		|МодифицированностьДебиторыЗадолженностьСрокиВозникновения,
		|МодифицированностьДебиторыДинамикаИзмененияЗадолженности,
		|МодифицированностьИсполнениеПлановыхНазначений,
		|МодифицированностьИсполнениеПринятыхОбязательств,
		|МодифицированностьИсполнениеДинамика");
	Иначе
		ПоддерживаемыеИменаРеквизитовФормы = Новый Структура("
		|"+ИмяРеквизитаФормы);
	КонецЕсли;
	
	Для Каждого Элем Из ПоддерживаемыеИменаРеквизитовФормы Цикл
		Форма[Элем.Ключ] = Установить;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРасшифровки(Форма, Элемент, ДанныеРасшифровки, Расшифровка, ПоказательСчет, МассивОсновныхДействий = Неопределено,URLСхемы)
	
	Перем ВыбранноеДействие;
	Перем ПараметрыВыбранногоДействия;
	Перем ПараметрыРасшифровкиДляСтандартныхОтчетов;
	
	МассивОсновныхДействий = Новый Массив;
	МассивОсновныхДействий.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
	
	ЗаполняемыеНастройки = Новый Структура("Показатели, Группировка, Отбор", Ложь, Истина, Ложь);
	
	ДанныеОтчета = Новый Структура("Организация, НачалоПериода, КонецПериода",Отчет.Организация,Отчет.НачалоПериода,Отчет.КонецПериода);
	
	ИзменитьПериодОтчетаДляДиаграмм(ДанныеОтчета, ДанныеРасшифровки, Расшифровка);
	
	ДополнительныеДействия = СтандартныеОтчетыВызовСервера.ПолучитьСписокДополнительнойРасшифровки(ДанныеОтчета, ДанныеРасшифровки, Расшифровка, ПоказательСчет, ПараметрыРасшифровкиДляСтандартныхОтчетов);
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(ДанныеРасшифровки,Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы));
	
	ПараметрыОповещения = Новый Структура("ПараметрыРасшифровкиДляСтандартныхОтчетов,ЗаполняемыеНастройки",ПараметрыРасшифровкиДляСтандартныхОтчетов,ЗаполняемыеНастройки);
	
	ОписаниеОповещенияПослеВыбораДействия = Новый ОписаниеОповещения(
		"ВыполнитьДействиеПослеВыбораРасшифровки",
		Форма,
		ПараметрыОповещения);
	
	ОбработкаРасшифровки.ПоказатьВыборДействия(ОписаниеОповещенияПослеВыбораДействия,Расшифровка,МассивОсновныхДействий,ДополнительныеДействия);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеПослеВыбораРасшифровки(ВыбранноеДействие,ПараметрыВыбранногоДействия, ДополнительныеПараметры) Экспорт
	
	Если ПараметрыВыбранногоДействия<>Неопределено и ПараметрыВыбранногоДействия<>Null тогда
		Если ВыбранноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение тогда
			ПоказатьЗначение(,ПараметрыВыбранногоДействия);
		КонецЕсли;
	ИначеЕсли ВыбранноеДействие <> ДействиеОбработкиРасшифровкиКомпоновкиДанных.Нет Тогда
		ИмяВыбраннойФормы = СтандартныеОтчетыКлиент.ПолучитьИмяФормыПоИДРасшифровки(ВыбранноеДействие);
		Если ЗначениеЗаполнено(ИмяВыбраннойФормы) тогда
			ПараметрыФормы = Новый Структура("ВидРасшифровки, АдресНастроек, СформироватьПриОткрытии, ИДРасшифровки, ЗаполняемыеНастройки",
												 1, ДополнительныеПараметры.ПараметрыРасшифровкиДляСтандартныхОтчетов, Истина, ВыбранноеДействие, ДополнительныеПараметры.ЗаполняемыеНастройки);
			ОткрытьФорму(ИмяВыбраннойФормы, ПараметрыФормы,, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БыстрыеНастройкиЗаполнитьКлиент(ПараметрыЗаполнения)
	Если ПараметрыЗаполнения = Неопределено Тогда
		ПараметрыЗаполнения = Новый Структура("ИмяСобытия", "ПослеИзмененияКоллекции");
	КонецЕсли;
	Если ПараметрыЗаполнения.Свойство("Переформировать") И ПараметрыЗаполнения.Переформировать Тогда
		РезультатКлиента = БыстрыеНастройкиЗаполнить(ПараметрыЗаполнения);
		ОчиститьСообщения();
		СформироватьОтчетНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция БыстрыеНастройкиЗаполнить(Знач ПараметрыКлиента)
	
	// Вставка значений по умолчанию для обязательных ключей параметров заполнения.
	ПараметрыЗаполнения = БыстрыеНастройкиДозаполнитьПараметры(ПараметрыКлиента);
	
	// Вызов переопределяемого модуля.
	Если НастройкиОтчета.События.ПередЗаполнениемПанелиБыстрыхНастроек Тогда
		ОтчетОбъект = ОтчетыСервер.ОтчетОбъект(ПараметрыЗаполнения.ОтчетОбъектИлиПолноеИмя);
		ОтчетОбъект.ПередЗаполнениемПанелиБыстрыхНастроек(ЭтотОбъект, ПараметрыЗаполнения);
	КонецЕсли;
	
	// Запись новых настроек варианта и пользовательских настроек в компоновщик.
	БыстрыеНастройкиЗагрузитьНастройкиВКомпоновщик(ПараметрыЗаполнения);
	
	Возврат ПараметрыЗаполнения.Результат;
	
КонецФункции

&НаСервере
Функция БыстрыеНастройкиДозаполнитьПараметры(ПараметрыКлиента)
	ПараметрыЗаполнения = Новый Структура;
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыЗаполнения, ПараметрыКлиента, Истина);
	Если Не ПараметрыЗаполнения.Свойство("ИмяСобытия") Тогда
		ПараметрыЗаполнения.Вставить("ИмяСобытия", "");
	КонецЕсли;
	Если Не ПараметрыЗаполнения.Свойство("ВариантМодифицирован") Тогда
		ПараметрыЗаполнения.Вставить("ВариантМодифицирован", Ложь);
	КонецЕсли;
	Если Не ПараметрыЗаполнения.Свойство("ПользовательскиеНастройкиМодифицированы") Тогда
		ПараметрыЗаполнения.Вставить("ПользовательскиеНастройкиМодифицированы", Ложь);
	КонецЕсли;
	Если Не ПараметрыЗаполнения.Свойство("Результат") Тогда
		ПараметрыЗаполнения.Вставить("Результат", Новый Структура);
	КонецЕсли;
	
	ПараметрыЗаполнения.Вставить("ОтчетОбъектИлиПолноеИмя", НастройкиОтчета.ПолноеИмя);
	Если НастройкиОтчета.События.ПередЗаполнениемПанелиБыстрыхНастроек
		Или НастройкиОтчета.События.ПослеЗаполненияПанелиБыстрыхНастроек
		Или НастройкиОтчета.События.ПередЗагрузкойНастроекВКомпоновщик Тогда
		ПараметрыЗаполнения.ОтчетОбъектИлиПолноеИмя = РеквизитФормыВЗначение("Отчет");
	КонецЕсли;
	
	Возврат ПараметрыЗаполнения;
КонецФункции

&НаСервере
Процедура БыстрыеНастройкиЗагрузитьНастройкиВКомпоновщик(ПараметрыЗаполнения)
	
	КомпоновщикНастроекФормы = ЭтаФорма["КомпоновщикНастроек"+ТекущийОтчет];
	
	НовыеНастройкиКД = Неопределено;
	НовыеПользовательскиеНастройкиКД = Неопределено;
	Если ПараметрыЗаполнения.Свойство("КомпоновщикНастроекКД") Тогда
		НовыеНастройкиКД = ПараметрыЗаполнения.КомпоновщикНастроекКД.Настройки;
		НовыеПользовательскиеНастройкиКД = ПараметрыЗаполнения.КомпоновщикНастроекКД.ПользовательскиеНастройки;
	Иначе
		Если ПараметрыЗаполнения.Свойство("НастройкиКД") Тогда
			НовыеНастройкиКД = ПараметрыЗаполнения.НастройкиКД;
		КонецЕсли;
		Если ПараметрыЗаполнения.Свойство("ПользовательскиеНастройкиКД") Тогда
			НовыеПользовательскиеНастройкиКД = ПараметрыЗаполнения.ПользовательскиеНастройкиКД;
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиОтчета.События.ПередЗагрузкойНастроекВКомпоновщик Тогда
		НовыеНастройкиXML = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиОтчета, "НовыеНастройкиXML");
		Если ТипЗнч(НовыеНастройкиXML) = Тип("Строка") Тогда
			Попытка
				НовыеНастройкиКД = ОбщегоНазначения.ЗначениеИзСтрокиXML(НовыеНастройкиXML);
			Исключение
				НовыеНастройкиКД = Неопределено;
			КонецПопытки;
			НастройкиОтчета.НовыеНастройкиXML = Неопределено;
		КонецЕсли;
		
		НовыеПользовательскиеНастройкиXML = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиОтчета, "НовыеПользовательскиеНастройкиXML");
		Если ТипЗнч(НовыеПользовательскиеНастройкиXML) = Тип("Строка") Тогда
			Попытка
				НовыеПользовательскиеНастройкиКД = ОбщегоНазначения.ЗначениеИзСтрокиXML(НовыеПользовательскиеНастройкиXML);
			Исключение
				НовыеПользовательскиеНастройкиКД = Неопределено;
			КонецПопытки;
			НастройкиОтчета.НовыеПользовательскиеНастройкиXML = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	СброситьПользовательскиеНастройки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыЗаполнения, "СброситьПользовательскиеНастройки", Ложь);
	Если СброситьПользовательскиеНастройки Тогда
		НовыеПользовательскиеНастройкиКД = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	КонецЕсли;
	
	Если НастройкиОтчета.События.ПередЗагрузкойНастроекВКомпоновщик Тогда
		ОтчетОбъект = ОтчетыСервер.ОтчетОбъект(ПараметрыЗаполнения.ОтчетОбъектИлиПолноеИмя);
		ОтчетОбъект.ПередЗагрузкойНастроекВКомпоновщик(
			ЭтотОбъект,
			НастройкиОтчета.КлючСхемы,
			КлючТекущегоВарианта,
			НовыеНастройкиКД,
			НовыеПользовательскиеНастройкиКД);
	КонецЕсли;
	
	Если ТипЗнч(НовыеНастройкиКД) = Тип("НастройкиКомпоновкиДанных")
		И КомпоновщикНастроекФормы.Настройки <> НовыеНастройкиКД Тогда
		КомпоновщикНастроекФормы.ЗагрузитьНастройки(НовыеНастройкиКД);
		Если ТипЗнч(ФормаПараметры.Отбор) = Тип("Структура") Тогда
			ОтчетыСервер.УстановитьФиксированныеОтборы(ФормаПараметры.Отбор, КомпоновщикНастроекФормы.Настройки, НастройкиОтчета);
		КонецЕсли;
		КомпоновщикНастроекФормы.Настройки.ДополнительныеСвойства.Вставить("КлючВарианта", КлючТекущегоВарианта);
		КомпоновщикНастроекФормы.Настройки.ДополнительныеСвойства.Вставить("ВариантНаименование", ОтчетНаименованиеТекущегоВарианта);
	КонецЕсли;
	Если ТипЗнч(НовыеПользовательскиеНастройкиКД) = Тип("ПользовательскиеНастройкиКомпоновкиДанных")
		И КомпоновщикНастроекФормы.ПользовательскиеНастройки <> НовыеПользовательскиеНастройкиКД Тогда
		КомпоновщикНастроекФормы.ЗагрузитьПользовательскиеНастройки(НовыеПользовательскиеНастройкиКД);
	КонецЕсли;
	
	Если ПараметрыЗаполнения.Свойство("ФормаНастроекРасширенныйРежим") Тогда
		НастройкиОтчета.Вставить("ФормаНастроекРасширенныйРежим", ПараметрыЗаполнения.ФормаНастроекРасширенныйРежим);
	КонецЕсли;
	Если ПараметрыЗаполнения.Свойство("ФормаНастроекИмяСтраницы") Тогда
		НастройкиОтчета.Вставить("ФормаНастроекИмяСтраницы", ПараметрыЗаполнения.ФормаНастроекИмяСтраницы);
	КонецЕсли;
	
	УсловияОтборов = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыЗаполнения, "УсловияОтборов");
	Если УсловияОтборов <> Неопределено Тогда
		УзелКД = КомпоновщикНастроекФормы.ПользовательскиеНастройки;
		Для Каждого КлючИЗначение Из УсловияОтборов Цикл
			ПользовательскаяНастройкаКД = УзелКД.ПолучитьОбъектПоИдентификатору(КлючИЗначение.Ключ);
			ПользовательскаяНастройкаКД.ВидСравнения = КлючИЗначение.Значение;
		КонецЦикла;
	КонецЕсли;
	
	Если ПараметрыЗаполнения.ВариантМодифицирован Тогда
		ВариантМодифицирован = Истина;
	КонецЕсли;
	
	Если ПараметрыЗаполнения.ПользовательскиеНастройкиМодифицированы Тогда
		ПользовательскиеНастройкиМодифицированы = Истина;
	КонецЕсли;
	
	Если НастройкиОтчета.ПрочитатьФлажокФормироватьСразуИзПользовательскихНастроек Тогда
		НастройкиОтчета.ПрочитатьФлажокФормироватьСразуИзПользовательскихНастроек = Ложь;
		НастройкиОтчета.ФормироватьСразу = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			КомпоновщикНастроекФормы.ПользовательскиеНастройки.ДополнительныеСвойства,
			"ФормироватьСразу",
			НастройкиОтчета.ФормироватьСразу);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НовоеМенюНастроек(ТекОтчет)
	
	Меню = Новый СписокЗначений;
	Меню.Добавить("ИзменитьНастройки", НСтр("ru='Настроить'"),,БиблиотекаКартинок.НастройкиОтчета);
	Если ТекОтчет = "КредиторыЗадолженностьСрокиВозникновения"
		ИЛИ ТекОтчет = "ДебиторыЗадолженностьСрокиВозникновения" Тогда
		Меню.Добавить("НастройкаИнтервалов", НСтр("ru='Настройка интервалов'"),,БиблиотекаКартинок.УстановитьИнтервал);
	КонецЕсли;
	Меню.Добавить("СтандартныеНастройки", НСтр("ru='Установить стандартные настройки'"),,БиблиотекаКартинок.СтандартнаяНастройкаКомпоновкиДанных);
	Меню.Добавить("СформироватьОтчет", НСтр("ru='Сформировать отчет'"),,БиблиотекаКартинок.СформироватьОтчет);
	
	Возврат Меню;
	
КонецФункции

&НаКлиенте
Процедура МенюНастроекСобытийНажатиеЗавершение(ЭлементМеню, ПараметрЭлемента) Экспорт

	Если ЭлементМеню = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭлементМеню.Значение = "ИзменитьНастройки" Тогда
		
		КомпоновщикНастроек = ЭтаФорма["КомпоновщикНастроек"+ПараметрЭлемента];
		
		СтрокиВариантов = ТаблицаИменВариантов.НайтиСтроки(Новый Структура("Отчет",ПараметрЭлемента));
		КлючТекущегоВарианта = СтрокиВариантов[0].КлючВарианта;
		ОтчетНаименованиеТекущегоВарианта = СтрокиВариантов[0].НаименованиеВарианта;
		
		Имя = НастройкиОтчета.ПолноеИмя + ".ФормаНастроек";
		
		ПараметрыФормы = Новый Структура;
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыФормы, ФормаПараметры, Истина);
		ПараметрыФормы.Вставить("КлючВарианта",              КлючТекущегоВарианта);
		ПараметрыФормы.Вставить("Вариант",                   КомпоновщикНастроек.Настройки);
		ПараметрыФормы.Вставить("ПользовательскиеНастройки", КомпоновщикНастроек.ПользовательскиеНастройки);
		ПараметрыФормы.Вставить("НастройкиОтчета",           НастройкиОтчета);
		ПараметрыФормы.Вставить("ВариантНаименование",       ОтчетНаименованиеТекущегоВарианта);
		
		Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		
		Обработчик = Новый ОписаниеОповещения("ВсеНастройкиЗавершение", ЭтотОбъект);
		
		ОткрытьФорму(Имя, ПараметрыФормы, ЭтотОбъект, , , , Обработчик, Режим);
		
	ИначеЕсли ЭлементМеню.Значение = "НастройкаИнтервалов" Тогда
		
		Элементы.НастройкаИнтервалов.Пометка = НЕ Элементы.НастройкаИнтервалов.Пометка;
		Элементы.Страницы.ТекущаяСтраница = Элементы["СтраницаИнтервалы"];
		
	ИначеЕсли ЭлементМеню.Значение = "СтандартныеНастройки" Тогда
		
		УстановитьСтандатныеНастройкиИСформироватьОтчет(ПараметрЭлемента);
		
	ИначеЕсли ЭлементМеню.Значение = "СформироватьОтчет" Тогда
		
		СформироватьОтчетНаСервере();
		
	Иначе
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтандатныеНастройкиИСформироватьОтчет(ТекОтчет)
	
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(ЭтаФорма["URLСхемы"+ТекОтчет]);
	ЭтаФорма["КомпоновщикНастроек"+ТекОтчет].ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	
	СформироватьОтчетНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтандартныеНастройкиДляВсехОтчетовНаСервере()
	
	Для Каждого Макет Из ЭтаФорма.РеквизитФормыВЗначение("Отчет").Метаданные().Макеты Цикл
		Если Макет.ТипМакета = Метаданные.СвойстваОбъектов.ТипМакета.СхемаКомпоновкиДанных Тогда
			МакетСКД = Отчеты.КонсольРуководителя.ПолучитьМакет(Макет.Имя);
			ЭтаФорма["КомпоновщикНастроек"+Макет.Имя].ЗагрузитьНастройки(МакетСКД.НастройкиПоУмолчанию);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьТаблицуИнтерваловПоУмолчанию(ТекОтчет)
	
	ТекОтчет.Интервалы.Очистить();
	
	НоваяСтрока = ТекОтчет.Интервалы.Добавить();
	НоваяСтрока.Значение      = 7;
	НоваяСтрока.Представление = "До 7 дней";
	
	НоваяСтрока = ТекОтчет.Интервалы.Добавить();
	НоваяСтрока.Значение      = 15;
	НоваяСтрока.Представление = "От 8 до 15 дней";
	
	НоваяСтрока = ТекОтчет.Интервалы.Добавить();
	НоваяСтрока.Значение      = 30;
	НоваяСтрока.Представление = "От 16 до 30 дней";
	
	НоваяСтрока = ТекОтчет.Интервалы.Добавить();
	НоваяСтрока.Значение      = 60;
	НоваяСтрока.Представление = "От 31 до 60 дней";
	
	НоваяСтрока = ТекОтчет.Интервалы.Добавить();
	НоваяСтрока.Значение      = 90;
	НоваяСтрока.Представление = "От 61 до 90 дней";
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьПериодОтчетаДляДиаграмм(ДанныеОтчета, Адрес, Расшифровка)
	
	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(Адрес);
	
	МассивПолей = СтандартныеОтчеты.ПолучитьМассивПолейРасшифровки(Расшифровка, ДанныеРасшифровки, , Истина);
	
	Для Каждого Поле Из МассивПолей Цикл
		Если ТипЗнч(Поле) <> Тип("ЗначениеПоляРасшифровкиКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Если Поле.Поле <> "Период" Тогда
			Продолжить;
		КонецЕсли;
		ДанныеОтчета.НачалоПериода = Поле.Значение;
		ДанныеОтчета.КонецПериода = КонецПериодаСУчетомТекущегоИнтервала(Поле.Значение);
		Прервать;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция КонецПериодаСУчетомТекущегоИнтервала(НачалоПериода)
	
	Если ТекущийИнтервал = 6 Тогда
		Возврат КонецДня(НачалоПериода);
	ИначеЕсли ТекущийИнтервал = 7 Тогда
		Возврат КонецНедели(НачалоПериода);
	ИначеЕсли ТекущийИнтервал = 8 Тогда // декада
		Возврат КонецДня(НачалоПериода + 10 * 24 * 60 * 60 - 1);
	ИначеЕсли ТекущийИнтервал = 9 Тогда
		Возврат КонецМесяца(НачалоПериода);
	ИначеЕсли ТекущийИнтервал = 10 Тогда
		Возврат КонецКвартала(НачалоПериода);
	ИначеЕсли ТекущийИнтервал = 11 Тогда // полугодие
		Возврат КонецДня(ДобавитьМесяц(НачалоПериода, 6) - 1);
	Иначе
		Возврат КонецГода(НачалоПериода);
	КонецЕсли;
	
КонецФункции

#КонецОбласти
