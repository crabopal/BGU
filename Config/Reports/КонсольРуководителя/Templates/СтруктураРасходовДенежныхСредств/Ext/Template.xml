		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, ГОД)
	КОНЕЦ КАК Период,
	ЕПСБУОбороты.КПС КАК КПС,
	ЕПСБУОбороты.КЭК КАК КЭК,
	ЕПСБУОбороты.СуммаОборотКт - ЕПСБУОбороты.СуммаОборотДт КАК Сумма
ПОМЕСТИТЬ СводныеДанные
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			УточнениеПериода,
			Счет В (&amp;Счета18),
			,
			НЕ(КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
						И КПС.ВидПоказателя &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КРБ))
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение)
				И КЭК.Код &lt;&gt; "510"
				И КЭК.Код &lt;&gt; "610",
			КорСчет ЕСТЬ NULL 
				ИЛИ КорСчет = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка),
			) КАК ЕПСБУОбороты
ГДЕ
	ЕПСБУОбороты.УточнениеПериода = 0

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, ГОД)
	КОНЕЦ,
	ЕПСБУОбороты.КПС,
	ЕПСБУОбороты.КЭК,
	ЕПСБУОбороты.СуммаОборотКт - ЕПСБУОбороты.СуммаОборотДт
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			УточнениеПериода,
			Счет В (&amp;КазнаСчета),
			,
			КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение),
			НЕ КорСчет В (&amp;СчетаВнутриведомственныеРасчеты),
			) КАК ЕПСБУОбороты
ГДЕ
	ЕПСБУОбороты.УточнениеПериода = 0

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА НАЧАЛОПЕРИОДА(ЕПСБУОбороты.Период, ГОД)
	КОНЕЦ,
	ЕПСБУОбороты.КПС,
	ЕПСБУОбороты.КЭК,
	ЕПСБУОбороты.СуммаОборотКт - ЕПСБУОбороты.СуммаОборотДт
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			УточнениеПериода,
			Счет В (&amp;СчетаКасса),
			,
			КФО &lt;&gt; ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение)
				И КЭК.Код &lt;&gt; "510"
				И КЭК.Код &lt;&gt; "610"
				И КФО &lt;&gt; ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет),
			КорСчет ЕСТЬ NULL 
				ИЛИ КорСчет = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка),
			) КАК ЕПСБУОбороты
ГДЕ
	ЕПСБУОбороты.УточнениеПериода = 0
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СводныеДанные.Период КАК Период,
	СводныеДанные.КПС КАК КПС,
	СводныеДанные.КЭК КАК КЭК,
	СУММА(СводныеДанные.Сумма) КАК КассовоеИсполнение
{ВЫБРАТЬ
	Период,
	КПС.*,
	КЭК.*,
	КассовоеИсполнение}
ИЗ
	СводныеДанные КАК СводныеДанные
{ГДЕ
	СводныеДанные.Период,
	СводныеДанные.КПС.*,
	СводныеДанные.КЭК.*,
	СводныеДанные.Сумма}

СГРУППИРОВАТЬ ПО
	СводныеДанные.Период,
	СводныеДанные.КПС,
	СводныеДанные.КЭК

ИМЕЮЩИЕ
	СУММА(СводныеДанные.Сумма) &lt;&gt; 0</query>
	</dataSet>
	<totalField>
		<dataPath>КассовоеИсполнение</dataPath>
