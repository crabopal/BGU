		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Обороты.КПС КАК КПС,
	Обороты.КЭК КАК КЭК,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0)
		ИНАЧЕ 0
	КОНЕЦ КАК ПринятоБюджетныхОбязательств,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаДБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0)
		ИНАЧЕ 0
	КОНЕЦ КАК ПринятоДенежныхОбязательств,
	0 КАК КассовыеВыбытия,
	0 КАК ВосстановленоРасходов,
	Обороты.Период КАК Период
ПОМЕСТИТЬ СводныеДанные
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			День {(&amp;Периодичность)},
			Счет В (&amp;СчетаБО)
				ИЛИ Счет В (&amp;СчетаДБО),
			,
			КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение),
			НЕ КорСчет В (&amp;СчетаЗакрытия),
			) КАК Обороты

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Обороты.КПС,
	Обороты.КЭК,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0)
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаДБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0) - ЕСТЬNULL(Обороты.СуммаОборотДт, 0)
		ИНАЧЕ 0
	КОНЕЦ,
	0,
	0,
	Обороты.Период
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			День {(&amp;Периодичность)},
			Счет В (&amp;СчетаБО)
				ИЛИ Счет В (&amp;СчетаДБО),
			,
			КФО &lt;&gt; ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение),
			НЕ КорСчет В (&amp;СчетаЗакрытия),
			) КАК Обороты

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВЫБОР
		КОГДА Движения.СчетКт В (&amp;Счета18)
				ИЛИ Движения.СчетКт В (&amp;КазнаСчета)
			ТОГДА Движения.КПСКт
		КОГДА Движения.СчетДт В (&amp;Счета18)
				ИЛИ Движения.СчетДт В (&amp;КазнаСчета)
			ТОГДА Движения.КПСДт
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	КОНЕЦ,
	ВЫБОР
		КОГДА Движения.СчетКт В (&amp;Счета18)
				ИЛИ Движения.СчетКт В (&amp;КазнаСчета)
			ТОГДА Движения.КЭККт
		КОГДА Движения.СчетДт В (&amp;Счета18)
				ИЛИ Движения.СчетДт В (&amp;КазнаСчета)
			ТОГДА Движения.КЭКДт
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	КОНЕЦ,
	0,
	0,
	ВЫБОР
		КОГДА Движения.СчетКт В (&amp;Счета18)
				ИЛИ Движения.СчетКт В (&amp;КазнаСчета)
			ТОГДА Движения.Сумма
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА Движения.СчетДт В (&amp;Счета18)
				ИЛИ Движения.СчетДт В (&amp;КазнаСчета)
			ТОГДА Движения.Сумма
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, ГОД)
	КОНЕЦ
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Активность
				И КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И (СчетКт В (&amp;Счета18)
						И (СчетДт ЕСТЬ NULL
							ИЛИ СчетДт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
					ИЛИ СчетКт В (&amp;КазнаСчета)
						И НЕ СчетДт В (&amp;СчетаВнутриведомственныеРасчетыИЗакрытие)
					ИЛИ СчетДт В (&amp;Счета18)
						И (СчетКт ЕСТЬ NULL
							ИЛИ СчетКт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
					ИЛИ СчетДт В (&amp;КазнаСчета)
						И НЕ СчетКт В (&amp;СчетаВнутриведомственныеРасчетыИЗакрытие))
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение),
			,
			) КАК Движения

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВЫБОР
		КОГДА Движения.СчетКт В (&amp;Счета18сКассой)
			ТОГДА Движения.КПСКт
		КОГДА Движения.СчетДт В (&amp;Счета18сКассой)
			ТОГДА Движения.КПСДт
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	КОНЕЦ,
	ВЫБОР
		КОГДА Движения.СчетКт В (&amp;Счета18сКассой)
			ТОГДА Движения.КЭККт
		КОГДА Движения.СчетДт В (&amp;Счета18сКассой)
			ТОГДА Движения.КЭКДт
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	КОНЕЦ,
	0,
	0,
	ВЫБОР
		КОГДА Движения.СчетКт В (&amp;Счета18сКассой)
			ТОГДА Движения.Сумма
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА Движения.СчетДт В (&amp;Счета18сКассой)
			ТОГДА Движения.Сумма
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА НАЧАЛОПЕРИОДА(Движения.Период, ГОД)
	КОНЕЦ
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Активность
				И КФО &lt;&gt; ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И (СчетКт В (&amp;Счета18сКассой)
						И ((СчетДт ЕСТЬ NULL
							ИЛИ СчетДт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
							И КЭККт.Код &lt;&gt; "610")
					ИЛИ СчетДт В (&amp;Счета18сКассой)
						И ((СчетКт ЕСТЬ NULL
							ИЛИ СчетКт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
							И КЭКДт.Код &lt;&gt; "510"))
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение),
			,
			) КАК Движения
;

