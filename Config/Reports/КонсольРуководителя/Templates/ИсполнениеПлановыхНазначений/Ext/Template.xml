		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Обороты.КПС КАК КПС,
	Обороты.КЭК КАК КЭК,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаПлановыхНазначений)
				И НЕ Обороты.КорСчет В (&amp;СчетаПБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0)
		ИНАЧЕ 0
	КОНЕЦ КАК ПлановыеНазначения,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0)
		ИНАЧЕ 0
	КОНЕЦ КАК ПринятоБО,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаПБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0) - ЕСТЬNULL(Обороты.СуммаОборотДт, 0)
		ИНАЧЕ 0
	КОНЕЦ КАК ПринимаемыеБО
ПОМЕСТИТЬ СводнаяТаблица
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			,
			Счет В (&amp;СчетаПлановыхНазначений)
				ИЛИ Счет В (&amp;СчетаБО)
				ИЛИ Счет В (&amp;СчетаПБО),
			,
			КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение),
			НЕ КорСчет В (&amp;СчетаЗакрытия),
			) КАК Обороты

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЕПСБУДвиженияССубконто.КПСДт,
	ЕПСБУДвиженияССубконто.КЭКДт,
	ВЫБОР
		КОГДА ЕПСБУДвиженияССубконто.СчетДт В (&amp;СчетаПлановыхНазначений)
			ТОГДА -ЕПСБУДвиженияССубконто.Сумма
		ИНАЧЕ 0
	КОНЕЦ,
	0,
	0
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Активность
				И КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И СчетДт В (&amp;СчетаПлановыхНазначений)
				И СчетКт В (&amp;СчетаПлановыхНазначений)
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение),
			,
			) КАК ЕПСБУДвиженияССубконто

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Обороты.КПС,
	Обороты.КЭК,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаСметыРасход)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотДт, 0) - ЕСТЬNULL(Обороты.СуммаОборотКт, 0)
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0)
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаПБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0) - ЕСТЬNULL(Обороты.СуммаОборотДт, 0)
		ИНАЧЕ 0
	КОНЕЦ
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			,
			Счет В (&amp;СчетаСметыРасход)
				ИЛИ Счет В (&amp;СчетаПБО)
				ИЛИ Счет В (&amp;СчетаБО),
			,
			КФО &lt;&gt; ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение),
			НЕ КорСчет В (&amp;СчетаЗакрытия),
			) КАК Обороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СводнаяТаблица.КПС КАК КПС,
	СводнаяТаблица.КЭК КАК КЭК,
	СУММА(СводнаяТаблица.ПлановыеНазначения) КАК ПлановыеНазначения,
	СУММА(СводнаяТаблица.ПринятоБО) КАК ПринятоБО,
	СУММА(СводнаяТаблица.ПринимаемыеБО) КАК ПринимаемыеБО
{ВЫБРАТЬ
	КПС.*,
	КЭК.*,
	ПлановыеНазначения,
	ПринятоБО,
	ПринимаемыеБО}
ИЗ
	СводнаяТаблица КАК СводнаяТаблица
{ГДЕ
	СводнаяТаблица.КПС.*,
	СводнаяТаблица.КЭК.*}

СГРУППИРОВАТЬ ПО
	СводнаяТаблица.КПС,
	СводнаяТаблица.КЭК

ИМЕЮЩИЕ
	(СУММА(СводнаяТаблица.ПлановыеНазначения) &lt;&gt; 0
		ИЛИ СУММА(СводнаяТаблица.ПринятоБО) &lt;&gt; 0
		ИЛИ СУММА(СводнаяТаблица.ПринимаемыеБО) &lt;&gt; 0)</query>
	</dataSet>
	<calculatedField>
		<dataPath>ОстатокДляПринятияБО</dataPath>
		<expression>ПлановыеНазначения - ПринятоБО-ПринимаемыеБО</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Остаток для принятия обязательств (RUB)</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<condition>true</condition>
			<group>true</group>
		</useRestriction>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="xs:string">ЧЦ=18; ЧДЦ=2</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>ВыделятьОтрицательные</dcscor:parameter>
				<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
			</dcscor:item>
		</appearance>
