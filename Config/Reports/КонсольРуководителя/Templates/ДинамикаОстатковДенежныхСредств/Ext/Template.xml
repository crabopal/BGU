		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕПСБУ.Ссылка
ПОМЕСТИТЬ СчетаКассы
ИЗ
	ПланСчетов.ЕПСБУ КАК ЕПСБУ
ГДЕ
	ПОДСТРОКА(ЕПСБУ.Код, 1, 3) = "201"
	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕПСБУОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
	ЕПСБУОстаткиИОбороты.Период КАК Период,
	ЕПСБУОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	ЕПСБУОстаткиИОбороты.Счет КАК Счет
{ВЫБРАТЬ
	СуммаКонечныйОстаток,
	Период,
	СуммаНачальныйОстаток,
	Счет}
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			День {(&amp;Периодичность)},
			,
			Счет В
				(ВЫБРАТЬ
					Таб.Ссылка
				ИЗ
					СчетаКассы КАК Таб),
			,
			(&amp;НетОрганизации
				ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение)) КАК ЕПСБУОстаткиИОбороты

УПОРЯДОЧИТЬ ПО
	Период</query>
