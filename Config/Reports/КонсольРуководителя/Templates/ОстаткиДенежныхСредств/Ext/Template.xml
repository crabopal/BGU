		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕПСБУ.Ссылка
ПОМЕСТИТЬ СчетаБезнал
ИЗ
	ПланСчетов.ЕПСБУ КАК ЕПСБУ
ГДЕ
	(ПОДСТРОКА(ЕПСБУ.Код, 1, 5) = "201.1"
				И ЕПСБУ.Код &lt;&gt; "201.13"
			ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 5) = "201.2"
				И ЕПСБУ.Код &lt;&gt; "201.23")
	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕПСБУ.Ссылка
ПОМЕСТИТЬ СчетаВПути
ИЗ
	ПланСчетов.ЕПСБУ КАК ЕПСБУ
ГДЕ
	(ЕПСБУ.Код = "201.13"
			ИЛИ ЕПСБУ.Код = "201.23")
	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕПСБУ.Ссылка
ПОМЕСТИТЬ СчетаНал
ИЗ
	ПланСчетов.ЕПСБУ КАК ЕПСБУ
ГДЕ
	ПОДСТРОКА(ЕПСБУ.Код, 1, 5) = "201.3"
	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОстатки.Субконто1) = ТИП(Справочник.РазделыЛицевыхСчетов)
			ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.РазделыЛицевыхСчетов).Владелец
		ИНАЧЕ "нет л/с"
	КОНЕЦ КАК ЛицевойСчет,
	ВЫБОР
		КОГДА ЕПСБУОстатки.Валюта ЕСТЬ NULL 
				ИЛИ ЕПСБУОстатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			ТОГДА &amp;ВалютаРегламентная
		ИНАЧЕ ЕПСБУОстатки.Валюта
	КОНЕЦ КАК Валюта,
	ЕПСБУОстатки.Счет КАК Счет,
	ЕПСБУОстатки.Счет.Код КАК СчетКод,
	ВЫБОР
		КОГДА ЕПСБУОстатки.ВалютнаяСуммаОстаток ЕСТЬ NULL 
				ИЛИ ЕПСБУОстатки.ВалютнаяСуммаОстаток = НЕОПРЕДЕЛЕНО
			ТОГДА ЕПСБУОстатки.СуммаОстаток
		КОГДА НЕ ЕПСБУОстатки.Счет.Валютный
				И ЕПСБУОстатки.ВалютнаяСуммаОстаток = 0
			ТОГДА ЕПСБУОстатки.СуммаОстаток
		ИНАЧЕ ЕПСБУОстатки.ВалютнаяСуммаОстаток
	КОНЕЦ КАК СуммаВалютнаяОстаток,
	ЕПСБУОстатки.СуммаОстаток КАК СуммаОстаток
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			{(&amp;КонецПериодаГраница)},
			Счет В
				(ВЫБРАТЬ
					Таб.Ссылка
				ИЗ
					СчетаБезнал КАК Таб),
			,
			(&amp;НетОрганизации
				ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение)) КАК ЕПСБУОстатки

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"Средства в пути" + " (" + ВЫБОР
		КОГДА ЕПСБУОстатки.Валюта ЕСТЬ NULL 
				ИЛИ ЕПСБУОстатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			ТОГДА &amp;ВалютаРегламентнаяСтрока
		ИНАЧЕ ЕПСБУОстатки.Валюта.Наименование
	КОНЕЦ + ")",
	ВЫБОР
		КОГДА ЕПСБУОстатки.Валюта ЕСТЬ NULL 
				ИЛИ ЕПСБУОстатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			ТОГДА &amp;ВалютаРегламентная
		ИНАЧЕ ЕПСБУОстатки.Валюта
	КОНЕЦ,
	ЕПСБУОстатки.Счет,
	ЕПСБУОстатки.Счет.Код,
	ВЫБОР
		КОГДА ЕПСБУОстатки.ВалютнаяСуммаОстаток ЕСТЬ NULL 
				ИЛИ ЕПСБУОстатки.ВалютнаяСуммаОстаток = НЕОПРЕДЕЛЕНО
			ТОГДА ЕПСБУОстатки.СуммаОстаток
		КОГДА НЕ ЕПСБУОстатки.Счет.Валютный
				И ЕПСБУОстатки.ВалютнаяСуммаОстаток = 0
			ТОГДА ЕПСБУОстатки.СуммаОстаток
		ИНАЧЕ ЕПСБУОстатки.ВалютнаяСуммаОстаток
	КОНЕЦ,
	ЕПСБУОстатки.СуммаОстаток
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			{(&amp;КонецПериодаГраница)},
			Счет В
				(ВЫБРАТЬ
					Таб.Ссылка
				ИЗ
					СчетаВПути КАК Таб),
			,
			(&amp;НетОрганизации
				ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение)) КАК ЕПСБУОстатки

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"Касса " + ВЫБОР
		КОГДА ЕПСБУОстатки.Счет.Код = "201.35"
			ТОГДА "денежных документов"
		ИНАЧЕ "денежных средств"
	КОНЕЦ + " (" + ВЫБОР
		КОГДА ЕПСБУОстатки.Валюта ЕСТЬ NULL 
				ИЛИ ЕПСБУОстатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			ТОГДА &amp;ВалютаРегламентнаяСтрока
		ИНАЧЕ ЕПСБУОстатки.Валюта.Наименование
	КОНЕЦ + ")",
	ВЫБОР
		КОГДА ЕПСБУОстатки.Валюта ЕСТЬ NULL 
				ИЛИ ЕПСБУОстатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			ТОГДА &amp;ВалютаРегламентная
		ИНАЧЕ ЕПСБУОстатки.Валюта
	КОНЕЦ,
	ЕПСБУОстатки.Счет,
	ЕПСБУОстатки.Счет.Код,
	ВЫБОР
		КОГДА ЕПСБУОстатки.ВалютнаяСуммаОстаток ЕСТЬ NULL 
				ИЛИ ЕПСБУОстатки.ВалютнаяСуммаОстаток = НЕОПРЕДЕЛЕНО
			ТОГДА ЕПСБУОстатки.СуммаОстаток
		КОГДА НЕ ЕПСБУОстатки.Счет.Валютный
				И ЕПСБУОстатки.ВалютнаяСуммаОстаток = 0
			ТОГДА ЕПСБУОстатки.СуммаОстаток
		ИНАЧЕ ЕПСБУОстатки.ВалютнаяСуммаОстаток
	КОНЕЦ,
	ЕПСБУОстатки.СуммаОстаток
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			{(&amp;КонецПериодаГраница)},
			Счет В
				(ВЫБРАТЬ
					Таб.Ссылка
				ИЗ
					СчетаНал КАК Таб),
			,
			(&amp;НетОрганизации
				ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение)) КАК ЕПСБУОстатки

УПОРЯДОЧИТЬ ПО
	СчетКод</query>
