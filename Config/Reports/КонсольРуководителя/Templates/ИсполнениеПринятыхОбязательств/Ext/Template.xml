		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	КОНЕЦ,
	ВЫБОР
		КОГДА ОборотыЛС.СчетДт В (&amp;Счета18сКассой)
			ТОГДА ОборотыЛС.КЭКДт
		КОГДА ОборотыЛС.СчетКт В (&amp;Счета18сКассой)
			ТОГДА ОборотыЛС.КЭККт
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	КОНЕЦ,
	ВЫБОР
		КОГДА ОборотыЛС.ХарактеристикаДвиженияДт ССЫЛКА Справочник.Договоры
			ТОГДА ВЫРАЗИТЬ(ОборотыЛС.ХарактеристикаДвиженияДт КАК Справочник.Договоры)
		КОГДА ОборотыЛС.ХарактеристикаДвиженияКт ССЫЛКА Справочник.Договоры
			ТОГДА ВЫРАЗИТЬ(ОборотыЛС.ХарактеристикаДвиженияКт КАК Справочник.Договоры)
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	КОНЕЦ,
	0,
	0,
	ВЫБОР
		КОГДА ОборотыЛС.СчетКт В (&amp;Счета18сКассой)
			ТОГДА ОборотыЛС.Сумма
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА ОборотыЛС.СчетДт В (&amp;Счета18сКассой)
			ТОГДА ОборотыЛС.Сумма
		ИНАЧЕ 0
	КОНЕЦ
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Активность
				И КФО &lt;&gt; ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И (СчетКт В (&amp;Счета18сКассой)
						И ((СчетДт ЕСТЬ NULL
							ИЛИ СчетДт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
							И КЭККт.Код &lt;&gt; "610")
					ИЛИ СчетДт В (&amp;Счета18сКассой)
						И ((СчетКт ЕСТЬ NULL
							ИЛИ СчетКт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
							И КЭКДт.Код &lt;&gt; "510"))
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение),
			,
			) КАК ОборотыЛС
;

