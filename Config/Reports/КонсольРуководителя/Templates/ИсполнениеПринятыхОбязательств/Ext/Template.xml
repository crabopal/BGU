		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Обороты.Регистратор КАК Регистратор,
	Обороты.КПС КАК КПС,
	Обороты.КЭК КАК КЭК,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(Обороты.Субконто1) = ТИП(Справочник.Договоры)
			ТОГДА ВЫРАЗИТЬ(Обороты.Субконто1 КАК Справочник.Договоры)
		КОГДА ТИПЗНАЧЕНИЯ(Обороты.Субконто2) = ТИП(Справочник.Договоры)
			ТОГДА ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.Договоры)
		КОГДА ТИПЗНАЧЕНИЯ(Обороты.Субконто3) = ТИП(Справочник.Договоры)
			ТОГДА ВЫРАЗИТЬ(Обороты.Субконто3 КАК Справочник.Договоры)
		КОГДА ТИПЗНАЧЕНИЯ(Обороты.КорСубконто1) = ТИП(Справочник.Договоры)
			ТОГДА ВЫРАЗИТЬ(Обороты.КорСубконто1 КАК Справочник.Договоры)
		КОГДА ТИПЗНАЧЕНИЯ(Обороты.КорСубконто2) = ТИП(Справочник.Договоры)
			ТОГДА ВЫРАЗИТЬ(Обороты.КорСубконто2 КАК Справочник.Договоры)
		КОГДА ТИПЗНАЧЕНИЯ(Обороты.КорСубконто3) = ТИП(Справочник.Договоры)
			ТОГДА ВЫРАЗИТЬ(Обороты.КорСубконто3 КАК Справочник.Договоры)
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	КОНЕЦ КАК Обязательство,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0)
		ИНАЧЕ 0
	КОНЕЦ КАК ПринятоБО,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаДБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0)
		ИНАЧЕ 0
	КОНЕЦ КАК ПринятоДБО,
	0 КАК КассовыеВыбытия,
	0 КАК ВосстановлениеРасходов
ПОМЕСТИТЬ СводнаяТаблица
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Регистратор,
			Счет В (&amp;СчетаБО)
				ИЛИ Счет В (&amp;СчетаДБО),
			,
			КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение),
			НЕ КорСчет В (&amp;СчетаЗакрытия),
			) КАК Обороты

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Движения.Регистратор,
	ВЫБОР
		КОГДА Движения.СчетКт В (&amp;Счета18)
				ИЛИ Движения.СчетКт В (&amp;КазнаСчета)
			ТОГДА Движения.КПСКт
		КОГДА Движения.СчетДт В (&amp;Счета18)
				ИЛИ Движения.СчетДт В (&amp;КазнаСчета)
			ТОГДА Движения.КПСДт
		ИНАЧЕ NULL
	КОНЕЦ,
	ВЫБОР
		КОГДА Движения.СчетКт В (&amp;Счета18)
				ИЛИ Движения.СчетКт В (&amp;КазнаСчета)
			ТОГДА Движения.КЭККт
		КОГДА Движения.СчетДт В (&amp;Счета18)
				ИЛИ Движения.СчетДт В (&amp;КазнаСчета)
			ТОГДА Движения.КЭКДт
		ИНАЧЕ NULL
	КОНЕЦ,
	ВЫБОР
		КОГДА Движения.СчетКт В (&amp;Счета18)
				ИЛИ Движения.СчетКт В (&amp;КазнаСчета)
			ТОГДА ВЫБОР
					КОГДА ТИПЗНАЧЕНИЯ(Движения.СубконтоДт1) = ТИП(Справочник.Договоры)
						ТОГДА ВЫРАЗИТЬ(Движения.СубконтоДт1 КАК Справочник.Договоры)
					КОГДА ТИПЗНАЧЕНИЯ(Движения.СубконтоДт2) = ТИП(Справочник.Договоры)
						ТОГДА ВЫРАЗИТЬ(Движения.СубконтоДт2 КАК Справочник.Договоры)
					КОГДА ТИПЗНАЧЕНИЯ(Движения.СубконтоДт3) = ТИП(Справочник.Договоры)
						ТОГДА ВЫРАЗИТЬ(Движения.СубконтоДт3 КАК Справочник.Договоры)
					КОГДА ТИПЗНАЧЕНИЯ(Движения.ХарактеристикаДвиженияКт) = ТИП(Справочник.Договоры)
						ТОГДА ВЫРАЗИТЬ(Движения.ХарактеристикаДвиженияКт КАК Справочник.Договоры)
					ИНАЧЕ NULL
				КОНЕЦ
		КОГДА Движения.СчетДт В (&amp;Счета18)
				ИЛИ Движения.СчетДт В (&amp;КазнаСчета)
			ТОГДА ВЫБОР
					КОГДА ТИПЗНАЧЕНИЯ(Движения.СубконтоКт1) = ТИП(Справочник.Договоры)
						ТОГДА ВЫРАЗИТЬ(Движения.СубконтоКт1 КАК Справочник.Договоры)
					КОГДА ТИПЗНАЧЕНИЯ(Движения.СубконтоКт2) = ТИП(Справочник.Договоры)
						ТОГДА ВЫРАЗИТЬ(Движения.СубконтоКт2 КАК Справочник.Договоры)
					КОГДА ТИПЗНАЧЕНИЯ(Движения.СубконтоКт3) = ТИП(Справочник.Договоры)
						ТОГДА ВЫРАЗИТЬ(Движения.СубконтоКт3 КАК Справочник.Договоры)
					КОГДА ТИПЗНАЧЕНИЯ(Движения.ХарактеристикаДвиженияДт) = ТИП(Справочник.Договоры)
						ТОГДА ВЫРАЗИТЬ(Движения.ХарактеристикаДвиженияДт КАК Справочник.Договоры)
					ИНАЧЕ NULL
				КОНЕЦ
		ИНАЧЕ NULL
	КОНЕЦ,
	0,
	0,
	ВЫБОР
		КОГДА Движения.СчетКт В (&amp;Счета18)
				ИЛИ Движения.СчетКт В (&amp;КазнаСчета)
			ТОГДА Движения.Сумма
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА Движения.СчетДт В (&amp;Счета18)
				ИЛИ Движения.СчетДт В (&amp;КазнаСчета)
			ТОГДА Движения.Сумма
		ИНАЧЕ 0
	КОНЕЦ
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Активность
				И КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И (СчетКт В (&amp;Счета18)
						И (СчетДт ЕСТЬ NULL
							ИЛИ СчетДт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
					ИЛИ СчетКт В (&amp;КазнаСчета)
						И НЕ СчетДт В (&amp;СчетаВнутриведомственныеРасчетыИЗакрытие)
					ИЛИ СчетДт В (&amp;Счета18)
						И (СчетКт ЕСТЬ NULL
							ИЛИ СчетКт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
					ИЛИ СчетДт В (&amp;КазнаСчета)
						И НЕ СчетКт В (&amp;СчетаВнутриведомственныеРасчетыИЗакрытие))
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение),
			,
			) КАК Движения

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Обороты.Регистратор,
	Обороты.КПС,
	Обороты.КЭК,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(Обороты.Субконто1) = ТИП(Справочник.Договоры)
			ТОГДА ВЫРАЗИТЬ(Обороты.Субконто1 КАК Справочник.Договоры)
		КОГДА ТИПЗНАЧЕНИЯ(Обороты.Субконто2) = ТИП(Справочник.Договоры)
			ТОГДА ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.Договоры)
		КОГДА ТИПЗНАЧЕНИЯ(Обороты.Субконто3) = ТИП(Справочник.Договоры)
			ТОГДА ВЫРАЗИТЬ(Обороты.Субконто3 КАК Справочник.Договоры)
		КОГДА ТИПЗНАЧЕНИЯ(Обороты.КорСубконто1) = ТИП(Справочник.Договоры)
			ТОГДА ВЫРАЗИТЬ(Обороты.КорСубконто1 КАК Справочник.Договоры)
		КОГДА ТИПЗНАЧЕНИЯ(Обороты.КорСубконто2) = ТИП(Справочник.Договоры)
			ТОГДА ВЫРАЗИТЬ(Обороты.КорСубконто2 КАК Справочник.Договоры)
		КОГДА ТИПЗНАЧЕНИЯ(Обороты.КорСубконто3) = ТИП(Справочник.Договоры)
			ТОГДА ВЫРАЗИТЬ(Обороты.КорСубконто3 КАК Справочник.Договоры)
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	КОНЕЦ,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0)
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА Обороты.Счет В (&amp;СчетаДБО)
			ТОГДА ЕСТЬNULL(Обороты.СуммаОборотКт, 0) - ЕСТЬNULL(Обороты.СуммаОборотДт, 0)
		ИНАЧЕ 0
	КОНЕЦ,
	0,
	0
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Регистратор,
			Счет В (&amp;СчетаБО)
				ИЛИ Счет В (&amp;СчетаДБО),
			,
			КФО &lt;&gt; ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И (&amp;НетОрганизации
					ИЛИ Организация В (&amp;Организация))
				И (&amp;НетИФО
					ИЛИ ИФО = &amp;ИФО)
				И (&amp;НетКФО
					ИЛИ КФО = &amp;КФО)
				И (&amp;НетПодразделения
					ИЛИ Подразделение = &amp;Подразделение),
			НЕ КорСчет В (&amp;СчетаЗакрытия),
			) КАК Обороты

ОБЪЕДИНИТЬ ВСЕ

