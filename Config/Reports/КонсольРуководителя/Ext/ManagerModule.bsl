#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Процедура СформироватьОтчет(ПараметрыОтчета, ДанныеРасшифровки, Результат, ПоказательСчет) Экспорт
	
	// Структура устанавливает соответствие между показателем и счетом, нужно для рассшифровки
	ПоказательСчет = Новый Структура;
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,"СуммаОстаток","СчетБудетОпределенПриРасшифровке");
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,"СуммаВалютнаяОстаток","СчетБудетОпределенПриРасшифровке");
	
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,"ОстатокДолга","СчетБудетОпределенПриРасшифровке");
	
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,"ПлановыеНазначения","501.13");
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,"ПлановыеНазначения","504.12");
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,"ПринятоБО","502.11");
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,"ПринимаемыеБО","502.17");
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,"ПринятоДБО","502.12");
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,"КассовоеИсполнение","18");
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,"КассовоеИсполнение","304.05");
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,"КассовоеИсполнениеДоходов","17");
	СтандартныеОтчеты.УстановитьСоответствиеДляРасшифровкиПоказательСчет(ПоказательСчет,"КассовоеИсполнениеДоходов","210.02");
	
	Отказ = Ложь;
	ДанныеРасшифровкиОбъект = Неопределено;
	
	Если ТипЗнч(ПараметрыОтчета.СхемаКомпоновкиДанных) = Тип("Строка") Тогда
		Если ЭтоАдресВременногоХранилища(ПараметрыОтчета.СхемаКомпоновкиДанных) Тогда
			СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(ПараметрыОтчета.СхемаКомпоновкиДанных);
		КонецЕсли;
	Иначе
		СхемаКомпоновкиДанных = ПараметрыОтчета.СхемаКомпоновкиДанных;
	КонецЕсли;
	
	КомпоновщикНастроек = ПараметрыОтчета.КомпоновщикНастроек;
	
	Если ПараметрыОтчета.ТекущийОтчет = "КредиторыЗадолженностьСрокиВозникновения"
		ИЛИ ПараметрыОтчета.ТекущийОтчет = "ДебиторыЗадолженностьСрокиВозникновения" Тогда
		
		ДебиторыКредиторы = ?(СтрНайти(ПараметрыОтчета.ТекущийОтчет,"Кредиторы") > 0,"Кредиторы","Дебиторы");
		
		КоличествоИнтервалов = ПараметрыОтчета.Интервалы.Количество();
		
		СхемаКомпоновкиДанных.НаборыДанных.ОсновнойНабор.Запрос = ПолучитьТекстЗапроса(КоличествоИнтервалов, ДебиторыКредиторы);
		
		УстановитьПараметры(ПараметрыОтчета, СхемаКомпоновкиДанных, КомпоновщикНастроек);
		
		ЗаполнитьПоляВСоответствииСоСпискомИнтервалов(ПараметрыОтчета, СхемаКомпоновкиДанных, КомпоновщикНастроек);
		
	КонецЕсли;
	
	Если СтрНайти(ПараметрыОтчета.ТекущийОтчет,"Динамика") > 0
		ИЛИ СтрНайти(ПараметрыОтчета.ТекущийОтчет,"Структура") > 0 Тогда
		
		Для Каждого ГруппировкаКД Из КомпоновщикНастроек.Настройки.Структура Цикл
			
			Если ГруппировкаКД.Имя = "Диаграмма" Тогда
				
				Для Каждого ТекТочка Из ГруппировкаКД.Точки Цикл
					Если ТекТочка.Имя = "Период" Тогда
						УстановитьДополнениеПоПолюПериод(ТекТочка, ПараметрыОтчета.ТекущийИнтервал);
						ЗаполнитьДатыПериодаДополнения(ТекТочка, ПараметрыОтчета.НачалоПериода, ПараметрыОтчета.КонецПериода);
					КонецЕсли;
				КонецЦикла;
				
			ИначеЕсли ГруппировкаКД.Имя = "Таблица" Тогда
				УстановитьДополнениеПоПолюПериод(ГруппировкаКД, ПараметрыОтчета.ТекущийИнтервал);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТекущиеНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	Результат.Очистить();
	
	ПередКомпоновкойМакета(КомпоновщикНастроек, ПараметрыОтчета);
	
	НастройкиДляКомпоновкиМакета = КомпоновщикНастроек.ПолучитьНастройки();
	
	//Сгенерируем макет компоновки данных при помощи компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	Попытка
		
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиДляКомпоновкиМакета, ДанныеРасшифровкиОбъект);
		//Создадим и инициализируем процессор компоновки
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровкиОбъект, Истина);
		
		ДанныеРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровкиОбъект,ПараметрыОтчета.УникальныйИдентификатор);
		
		//Создадим и инициализируем процессор вывода результата
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(Результат);
		
		//Обозначим начало вывода
		ПроцессорВывода.НачатьВывод();
		
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
		
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Пока ИнформацияОбОшибке.Причина <> Неопределено Цикл
			ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
		КонецЦикла;
		ТекстСообщения = НСтр("ru = 'Отчет не сформирован!'") + Символы.ПС + ИнформацияОбОшибке.Описание;
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
	КонецПопытки;
	
КонецПроцедуры

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, Метаданные.Отчеты.КонсольРуководителя, "ПоОтчетам");
	НастройкиОтчета.НастройкиДляПоиска.НаименованияПараметровИОтборов =
	НСтр("ru = 'Период
		|Организация'");
	НастройкиОтчета.НастройкиДляПоиска.НаименованияПолей =
		НСтр("ru = 'Период
			|Организация'");
			
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// В процедуре можно доработать компоновщик перед выводом в отчет
// Изменения сохранены не будут
Процедура ПередКомпоновкойМакета(КомпоновщикНастроек, ПараметрыОтчета)
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода",				ПараметрыОтчета.НачалоПериода);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода",				ПараметрыОтчета.КонецПериода);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериодаГраница",		ПараметрыОтчета.КонецПериодаГраница);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРегламентная",			ПараметрыОтчета.ВалютаРегламентная);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРегламентнаяСтрока",	ПараметрыОтчета.ВалютаРегламентнаяСтрока);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Организация",				ПараметрыОтчета.Организация);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НетОрганизации",				ПараметрыОтчета.НетОрганизации);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ИФО",						ПараметрыОтчета.ИФО);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НетИФО",						ПараметрыОтчета.НетИФО);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КФО",						ПараметрыОтчета.КФО);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НетКФО",						ПараметрыОтчета.НетКФО);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Подразделение",				ПараметрыОтчета.Подразделение);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НетПодразделения",			ПараметрыОтчета.НетПодразделения);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Периодичность",				ПараметрыОтчета.Периодичность);
	
	Если ЗаполнениеОтчетностиКлиентСервер.НайтиЭлементОтбора("Организация", КомпоновщикНастроек.Настройки.Отбор.Элементы) = Неопределено Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "Организация", ПараметрыОтчета.Организация, ВидСравненияКомпоновкиДанных.Равно, НЕ ПараметрыОтчета.НетОрганизации);
	Иначе
		ОбновитьОтборКомпоновщикаНастроекБыстрымиОтборами(КомпоновщикНастроек.Настройки.Отбор.Элементы, 
			Новый Структура("Организация", ПараметрыОтчета.Организация));
	КонецЕсли;
	Если ЗаполнениеОтчетностиКлиентСервер.НайтиЭлементОтбора("ИФО", КомпоновщикНастроек.Настройки.Отбор.Элементы) = Неопределено Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "ИФО", ПараметрыОтчета.ИФО, ВидСравненияКомпоновкиДанных.Равно, НЕ ПараметрыОтчета.НетИФО);
	Иначе
		ОбновитьОтборКомпоновщикаНастроекБыстрымиОтборами(КомпоновщикНастроек.Настройки.Отбор.Элементы, 
			Новый Структура("ИФО", ПараметрыОтчета.ИФО));
	КонецЕсли;
	Если ЗаполнениеОтчетностиКлиентСервер.НайтиЭлементОтбора("КФО", КомпоновщикНастроек.Настройки.Отбор.Элементы) = Неопределено Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "КФО", ПараметрыОтчета.КФО, ВидСравненияКомпоновкиДанных.Равно, НЕ ПараметрыОтчета.НетКФО);
	Иначе
		ОбновитьОтборКомпоновщикаНастроекБыстрымиОтборами(КомпоновщикНастроек.Настройки.Отбор.Элементы, 
			Новый Структура("КФО", ПараметрыОтчета.КФО));
	КонецЕсли;
	Если ЗаполнениеОтчетностиКлиентСервер.НайтиЭлементОтбора("Подразделение", КомпоновщикНастроек.Настройки.Отбор.Элементы) = Неопределено Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "Подразделение", ПараметрыОтчета.Подразделение, ВидСравненияКомпоновкиДанных.Равно, НЕ ПараметрыОтчета.НетПодразделения);
	Иначе
		ОбновитьОтборКомпоновщикаНастроекБыстрымиОтборами(КомпоновщикНастроек.Настройки.Отбор.Элементы, 
			Новый Структура("Подразделение", ПараметрыОтчета.Подразделение));
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса(КоличествоИнтервалов, ДебиторыКредиторы = "Кредиторы")
	
	ПолныйТекстЗапроса = "";
	
	ПолныйТекстЗапроса = ПолныйТекстЗапроса + 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СчетаРасчетовСКредиторами
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	(ПОДСТРОКА(ЕПСБУ.Код, 1, 3) = ""301""
	|		ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 3) = ""302""
	|		ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 3) = ""303""
	|		ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""304.01""
	|		ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""304.02""
	|		ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""304.03"")
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СчетаРасчетовСДебиторами
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|(ПОДСТРОКА(ЕПСБУ.Код, 1, 3) = ""205""
	|			И ПОДСТРОКА(ЕПСБУ.Код, 6, 1) <> ""А""
	|		ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 3) = ""206""
	|		ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 3) = ""207""
	|		ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 3) = ""209""
	|			И ПОДСТРОКА(ЕПСБУ.Код, 6, 1) <> ""А""
	|		ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""210.05"")
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка
	|ПОМЕСТИТЬ Счета40140
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	(ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""401.40""
	|		ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""401.41""
	|		ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""401.49"")
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка
	|ПОМЕСТИТЬ Счета11140
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ПОДСТРОКА(ЕПСБУ.Код, 1, 5) = ""111.4""
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка
	|ПОМЕСТИТЬ Счета10440
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""104.40""
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка
	|ПОМЕСТИТЬ Счета40150
	|ИЗ
