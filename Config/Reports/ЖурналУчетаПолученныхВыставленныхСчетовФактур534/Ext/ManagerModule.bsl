				Если УчетНДС.СегментацияДанныхДекларации_СегментДостигПредельногоРазмера(СегментацияДанныхРазделаКнига, ПараметрыОтчета) Тогда
					// Записываем текущий сегмент, обновляем статистику
					УчетНДС.СегментацияДанныхДекларации_ЗаписатьТекущийСегмент(
					ОбозначениеРазделаКнига,
					ЗаполняемыйТабличныйДокумент,
					ИспользуемыйМакет,
					ПараметрыОтчета,
					ДанныеДляДекларации,
					Ложь);		// ЗакончиласьТаблица
					
				КонецЕсли;
				
			КонецЕсли;
			
		НомерСтрокиГруппировки = НомерСтрокиГруппировки + 1;
		
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиПодвал(ЗаполняемыйТабличныйДокумент, ПараметрыОбласти, ИспользуемыйМакет)
	
	ОбластьПодвал = ИспользуемыйМакет.ПолучитьОбласть("Подвал");
	
	ЗначенияПараметров = Новый Структура();
	Если ЗначениеЗаполнено(ПараметрыОбласти["Организация"]) Тогда
		ОтветственныеЛица = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
		ПараметрыОбласти["Организация"],
		ПараметрыОбласти["Дата"]);
		
		ЗначенияПараметров.Вставить("РуководительФИО", Справочники.Сотрудники.ФамилияИО(
		ОтветственныеЛица["ОтветственноеЛицоСсылка"],, ПараметрыОбласти["Дата"]));
	КонецЕсли;
	// Выводим область:
	ОбластьПодвал.Параметры.Заполнить(ЗначенияПараметров);
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры	

Функция ПолучитьТаблицуСтатусовЧастейЖурнала()
	
	СтатусЧастейЖурнала = Новый ТаблицаЗначений();
	СтатусЧастейЖурнала.Колонки.Добавить("НомерЧастиЖурнала",			Новый ОписаниеТипов("Число"));
	СтатусЧастейЖурнала.Колонки.Добавить("ЧастьЖурнала",				Новый ОписаниеТипов("ПеречислениеСсылка.ЧастиЖурналаУчетаСчетовФактур"));
	СтатусЧастейЖурнала.Колонки.Добавить("ИндексВВерхнейГруппировке",	Новый ОписаниеТипов("Число"));
	НоваяСтрока = СтатусЧастейЖурнала.Добавить();
	НоваяСтрока["НомерЧастиЖурнала"]			= 1;
	НоваяСтрока["ЧастьЖурнала"]					= Перечисления.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры;
	НоваяСтрока["ИндексВВерхнейГруппировке"]	= -1;
	НоваяСтрока = СтатусЧастейЖурнала.Добавить();
	НоваяСтрока["НомерЧастиЖурнала"]			= 2;
	НоваяСтрока["ЧастьЖурнала"]					= Перечисления.ЧастиЖурналаУчетаСчетовФактур.ПолученныеСчетаФактуры;
	НоваяСтрока["ИндексВВерхнейГруппировке"]	= -1;
	
	Возврат СтатусЧастейЖурнала;
	
КонецФункции

Процедура СообщитьОбОшибке(ИнформацияОбОшибке)
	
	Пока НЕ ИнформацияОбОшибке.Причина = Неопределено Цикл
		ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
	КонецЦикла;
	ТекстСообщения = НСтр("ru='Отчет не сформирован!'") + Символы.ПС + ИнформацияОбОшибке.Описание;
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

