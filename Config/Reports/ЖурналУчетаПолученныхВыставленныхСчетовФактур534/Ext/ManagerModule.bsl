#Область Настройки

Функция ПолучитьИспользуемыйМакет(ПараметрыОтчета)
	
	РедакцияПостановления = ПараметрыОтчета.РедакцияПостановления;
	
	Если РедакцияПостановления = "№ 26 от 23.01.2026" Тогда
		ИмяМакета = "ОбщийМакет.ПФ_MXL_ЖурналУчетаПолученныхВыставленныхСчетовФактур1137_26";
	Иначе
		ИмяМакета = "ОбщийМакет.ПФ_MXL_ЖурналУчетаПолученныхВыставленныхСчетовФактур1137_534";
	КонецЕсли;
	
	Возврат УправлениеПечатью.МакетПечатнойФормы(ИмяМакета);
	
КонецФункции

Процедура ДобавитьРедакциюПостановления(ПараметрыОтчета)
	
	НаДату = ПараметрыОтчета.ДатаКонца;
	
	Если Не ЗначениеЗаполнено(НаДату) Тогда
		НаДату = Неопределено;
	КонецЕсли;
	
	РедакцияПостановления = УчетНДС.ПолучитьПостановлениеПоУмолчаниюДляЗаполненияКниги("Журнал", НаДату); 
	
	ПараметрыОтчета.Вставить("РедакцияПостановления", РедакцияПостановления);
	
КонецПроцедуры

Функция ПолучитьНастройкиСКД(ПараметрыОтчета)
	
	Результат = Новый Структура("
		|ИспользуемаяСхемаКомпоновкиДанных,
		|НовыйКомпоновщикНастроек");
	
	// Возвращаемые объекты:
	ИспользуемаяСхемаКомпоновкиДанных	= ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	НовыйКомпоновщикНастроек			= Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ИспользуемаяСхемаКомпоновкиДанных));
	НовыйКомпоновщикНастроек.ЗагрузитьНастройки(ИспользуемаяСхемаКомпоновкиДанных.ВариантыНастроек["Основной"].Настройки);
	
	// Настраиваем схему.
	УстановитьПараметрыСКД(НовыйКомпоновщикНастроек, ПараметрыОтчета);
	
	// Копируем отбор, установленный в форме отчета:
	СтандартныеОтчетыКлиентСервер.СкопироватьОтбор(
		НовыйКомпоновщикНастроек.Настройки.Отбор,
		ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	
	// Настройки группировок:
	Настройки = НовыйКомпоновщикНастроек.Настройки;
	ГруппировкаНалоговыйПериод				= Настройки.Структура[0];
	ГруппировкаОднимСписком					= Настройки.Структура[1];
	
	Если ПараметрыОтчета["ЗаполнитьДанныеДляДекларации"] Тогда
		ГруппировкаНалоговыйПериод.Использование			= Истина;
		ГруппировкаОднимСписком.Использование				= Ложь;
	Иначе
		ГруппировкаНалоговыйПериод.Использование			= Ложь;
		ГруппировкаОднимСписком.Использование				= Истина;
	КонецЕсли;
	
	Результат["ИспользуемаяСхемаКомпоновкиДанных"]	= ИспользуемаяСхемаКомпоновкиДанных;
	Результат["НовыйКомпоновщикНастроек"]			= НовыйКомпоновщикНастроек;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьПараметрыСКД(КомпоновщикНастроек, ПараметрыОтчета)
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаНачала", ПараметрыОтчета["ДатаНачала"]);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаКонца", ПараметрыОтчета["ДатаКонца"]);
	
	ВыводимыеЧастиЖурнала = Новый СписокЗначений();
	Если ПараметрыОтчета["ВыводитьЧасть1"] Тогда
		ВыводимыеЧастиЖурнала.Добавить(Перечисления.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры);
	КонецЕсли;
	Если ПараметрыОтчета["ВыводитьЧасть2"] Тогда
		ВыводимыеЧастиЖурнала.Добавить(Перечисления.ЧастиЖурналаУчетаСчетовФактур.ПолученныеСчетаФактуры);
	КонецЕсли;
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыводимыеЧастиЖурнала",	ВыводимыеЧастиЖурнала);
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	ПричиныНалогообложенияШкурыЛом = Новый СписокЗначений();
	ПричиныНалогообложенияШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом);
	ПричиныНалогообложенияШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПричиныНалогообложенияШкурыЛом", ПричиныНалогообложенияШкурыЛом);
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВалютаРУ", ВалютаРУ);
	
КонецПроцедуры

#КонецОбласти

#Область ВыводТаблицы

Процедура СформироватьЖурналУчета(ПараметрыОтчета, ДанныеДляДекларации, ДокументРезультат = Неопределено)
	
	РезультатДерево = Новый ДеревоЗначений();
	
	// Настраиваем схему КД:
	НастройкиСКД = ПолучитьНастройкиСКД(ПараметрыОтчета);
	ИспользуемаяСхемаКомпоновкиДанных	= НастройкиСКД["ИспользуемаяСхемаКомпоновкиДанных"];
	НовыйКомпоновщикНастроек			= НастройкиСКД["НовыйКомпоновщикНастроек"];
	
	// Декларация
	// СегментацияДанныхДекларации
	Если ПараметрыОтчета["ЗаполнитьДанныеДляДекларации"] Тогда
		УчетНДС.СегментацияДанныхДекларации_ИнициализироватьПараметры(ПараметрыОтчета, "10, 11");
	КонецЕсли;
	
	// Выполняем схему:
	Попытка
		// Выводим результат в дерево:
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(
			ИспользуемаяСхемаКомпоновкиДанных,				// 1
			НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
			,												// 3
			,												// 4
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));// 5
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		ПроцессорВывода.УстановитьОбъект(РезультатДерево);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
		
		УчетНДС.СвернутьОдноименныеКолонкиДерева(РезультатДерево);
		
		Для Каждого СтрокаГруппировки Из РезультатДерево.Строки Цикл
			
			ВывестиЖурналВТабличныйДокумент(ПараметрыОтчета, СтрокаГруппировки, ДанныеДляДекларации, ДокументРезультат);
			
		КонецЦикла;
		
	Исключение
		
		СообщитьОбОшибке(ИнформацияОбОшибке());
		
	КонецПопытки;
		
КонецПроцедуры

Процедура ВывестиЖурналВТабличныйДокумент(ПараметрыОтчета, ГруппировкаНалоговыйПериод, ДанныеДляДекларации, ТабДокумент = Неопределено)
	
	ДетальныеЗаписи = ГруппировкаНалоговыйПериод.Строки;
	
	// Возвращаемое значение:
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
		ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		ТабДокумент.АвтоМасштаб = Истина;
		ТабДокумент.КлючПараметровПечати = "ЖурналУчетаСчетовФактур";
	Иначе
		ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		ТабДокумент.АвтоМасштаб = Истина;
		ТабДокумент.КлючПараметровПечати = "ЖурналУчетаСчетовФактур";
	КонецЕсли;

	// Используемый макет:
	Макет = ПолучитьИспользуемыйМакет(ПараметрыОтчета);
	
	//---
	// Заголовок
	//---
	Если НЕ ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		ВывестиЗаголовок(ТабДокумент, Макет, ПараметрыОтчета);
		
		Если НеобходимоВывестиОтбор(ПараметрыОтчета) Тогда
			ВывестиОтбор(ТабДокумент, Макет, ПараметрыОтчета);
		КонецЕсли;
	КонецЕсли;
	
	//---
	// Таблицы частей 1 и 2
	//---
	ВывестиЧастиЖурнала(ТабДокумент, Макет, ГруппировкаНалоговыйПериод, ПараметрыОтчета, ДетальныеЗаписи, ДанныеДляДекларации);
	
	//---
	// Подвал
	//---
	Если ПараметрыОтчета.ВыводитьПодвал Тогда
		ПараметрыОбласти = Новый Структура();
		ПараметрыОбласти.Вставить("Организация",	ПараметрыОтчета["Организация"]);
		ПараметрыОбласти.Вставить("Дата",			ГруппировкаНалоговыйПериод["ДатаОкончанияПериода"]);
		ВывестиПодвал(ТабДокумент, ПараметрыОбласти, Макет);
	КонецЕсли;
		
	// Колонтитулы:
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(ТабДокумент,
		ПараметрыОтчета["Колонтитулы_НаименованиеОтчета"],
		ПараметрыОтчета["Колонтитулы_ТекущийПользователь"],
		ПараметрыОтчета["Организация"]);
		
КонецПроцедуры

Процедура ВывестиЗаголовок(ЗаполняемыйТабличныйДокумент, ИспользуемыйМакет, ПараметрыОтчета)
	
	СвойстваОрганизации = ПолучитьСвойстваОрганизации(ПараметрыОтчета);
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("ОрганизацияПредставление",	СвойстваОрганизации.Представление);
	ЗначенияПараметров.Вставить("ИНН",						СвойстваОрганизации.ИНН);
	ЗначенияПараметров.Вставить("КПП",						СвойстваОрганизации.КПП);
	
	Если ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026" Тогда
		НаДату = ПараметрыОтчета.ДатаКонца;
		
		Если Не ЗначениеЗаполнено(НаДату) Тогда
			НаДату = ТекущаяДатаСеанса();
		КонецЕсли;
		
		КомпонентыДаты = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(НаДату, Истина);
		
		ЗначенияПараметров.Вставить("НомерКвартала", ПолучитьНомерКвартала(НаДату));
		ЗначенияПараметров.Вставить("Года", КомпонентыДаты.Года);
	Иначе
		ЗначенияПараметров.Вставить("ПериодПредставление", ПолучитьПредставлениеПериода(ПараметрыОтчета));
	КонецЕсли;
	
	ОбластьЗаголовок = ИспользуемыйМакет.ПолучитьОбласть("Заголовок");
	
	ОбластьЗаголовок.Параметры.Заполнить(ЗначенияПараметров);
	
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
КонецПроцедуры

Функция ПолучитьСвойстваОрганизации(ПараметрыОтчета)
	
	СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОтчета["Организация"],
		"Наименование,НаименованиеПолное,НаименованиеСокращенное,ИНН,КПП");
	
	Наименование1 = СвойстваОрганизации["НаименованиеПолное"];
	Наименование2 = СвойстваОрганизации["НаименованиеСокращенное"];
	Наименование3 = СвойстваОрганизации["Наименование"];
	
	Если ЗначениеЗаполнено(Наименование1) Тогда
		ОрганизацияПредставление = Наименование1;
	ИначеЕсли ЗначениеЗаполнено(Наименование2) Тогда
		ОрганизацияПредставление = Наименование2;
	Иначе
		ОрганизацияПредставление = Наименование3;
	КонецЕсли;
	
	СвойстваОрганизации.Вставить("Представление", ОрганизацияПредставление);
	
	Возврат СвойстваОрганизации;
	
КонецФункции

Функция ПолучитьПредставлениеПериода(ПараметрыОтчета)
	
	Если Не ЗначениеЗаполнено(ПараметрыОтчета.ДатаНачала) И Не ЗначениеЗаполнено(ПараметрыОтчета.ДатаКонца) Тогда
		Возврат "... - ...";
	КонецЕсли;
	
	Возврат ПредставлениеПериода(ПараметрыОтчета.ДатаНачала, ПараметрыОтчета.ДатаКонца, "ФП");
	
КонецФункции

Функция	НеобходимоВывестиОтбор(ПараметрыОтчета)
	
	Если ПараметрыОтчета.РедакцияПостановления <> "№ 26 от 23.01.2026" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РеквизитыШапки = Новый Структура("Организация", ПараметрыОтчета.Организация);
	
	Если СтандартныеОтчетыКлиентСервер.УстановленДополнительныйОтбор(
		ПараметрыОтчета.КомпоновщикНастроек.Настройки.Отбор, РеквизитыШапки) Тогда
		
		Возврат Истина;
	КонецЕсли;
	
	Если Не ПериодОтчетаСовпадаетСГраницамиКвартала(ПараметрыОтчета) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ВывестиОтбор(ТабличныйДокумент, ИспользуемыйМакет, ПараметрыОтчета)
	
	ПредставлениеОтбораСКД = Строка(ПараметрыОтчета.КомпоновщикНастроек.Настройки.Отбор);
	
	ТекстыОтбора = Новый Массив();
	
	Если Не ПараметрыОтчета.ВыводитьЧасть1 Тогда
		ТекстыОтбора.Добавить(НСтр("ru='Не выводить часть 1 журнала'"));
	КонецЕсли;
	
	Если Не ПараметрыОтчета.ВыводитьЧасть2 Тогда
		ТекстыОтбора.Добавить(НСтр("ru='Не выводить часть 2 журнала'"));
	КонецЕсли;
	
	Если Не ПериодОтчетаСовпадаетСГраницамиКвартала(ПараметрыОтчета) Тогда
		ТекстыОтбора.Добавить(ПолучитьПредставлениеПериода(ПараметрыОтчета));
	КонецЕсли;
	
	ТекстыОтбора.Добавить(ПредставлениеОтбораСКД);
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("Отбор", СтрСоединить(ТекстыОтбора, НСтр("ru=' И '")));
	
	ОбластьОтбор = ИспользуемыйМакет.ПолучитьОбласть("Отбор");
	
	ОбластьОтбор.Параметры.Заполнить(ЗначенияПараметров);
	
	ТабличныйДокумент.Вывести(ОбластьОтбор);
	
КонецПроцедуры

Функция ПериодОтчетаСовпадаетСГраницамиКвартала(ПараметрыОтчета)
	
	НомерКвартала = 0;
	
	Если Не ЗначениеЗаполнено(ПараметрыОтчета.ДатаНачала) Или Не ЗначениеЗаполнено(ПараметрыОтчета.ДатаКонца) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НаДату = ПараметрыОтчета.ДатаНачала;
	
	ДатаНачалаКвартала = НачалоКвартала(НаДату);
	ДатаКонцаКвартала = КонецКвартала(НаДату);
	
	Возврат НачалоДня(ПараметрыОтчета.ДатаНачала) = ДатаНачалаКвартала
		И КонецДня(ПараметрыОтчета.ДатаКонца) = ДатаКонцаКвартала;
	
КонецФункции

Функция ПолучитьНомерКвартала(НаДату)
	
	Если Не ЗначениеЗаполнено(НаДату) Тогда
		Возврат 0;
	КонецЕсли;
	
	НомерМесяца = Месяц(НаДату);
	
	Возврат Цел((НомерМесяца + 2) / 3);
	
КонецФункции

Процедура ВывестиЧастиЖурнала(ЗаполняемыйТабличныйДокумент, ИспользуемыйМакет, СтрокаВерхнейГруппировки, ПараметрыОтчета, ДетальныеЗаписи, ДанныеДляДекларации)
	
	// Определяем заполненность частей журнала:
	СтатусыЧастейЖурнала = ПолучитьТаблицуСтатусовЧастейЖурнала();
	ИндексВВерхнейГруппировке = 0;
	Для Каждого СтрокаГруппировкаЧастьЖурнала Из СтрокаВерхнейГруппировки.Строки Цикл
		СтрокаСтатуса = СтатусыЧастейЖурнала.Найти(СтрокаГруппировкаЧастьЖурнала["ЧастьЖурнала"], "ЧастьЖурнала");
		Если НЕ СтрокаСтатуса = Неопределено Тогда
			СтрокаСтатуса["ИндексВВерхнейГруппировке"] = ИндексВВерхнейГруппировке;
		КонецЕсли;
		ИндексВВерхнейГруппировке = ИндексВВерхнейГруппировке + 1;
	КонецЦикла;
	
	// Выводим части журнала (таблицу, если есть данные)
	// или только шапки таблиц (если данных в этих частях журнала нет):
	Для Каждого СтрокаСтатуса Из СтатусыЧастейЖурнала Цикл
		ИндексВВерхнейГруппировке = СтрокаСтатуса["ИндексВВерхнейГруппировке"];
		Если ИндексВВерхнейГруппировке >= 0 Тогда
			СтрокаГруппировкаЧастьЖурнала = СтрокаВерхнейГруппировки.Строки[ИндексВВерхнейГруппировке];
		Иначе
			СтрокаГруппировкаЧастьЖурнала = Неопределено;
		КонецЕсли;
		
		ПараметрыВыводаТаблицы = Новый Структура();
		ПараметрыВыводаТаблицы.Вставить("НПП",							1);
		ПараметрыВыводаТаблицы.Вставить("НомерЧастиЖурнала",			СтрокаСтатуса["НомерЧастиЖурнала"]);
		ПараметрыВыводаТаблицы.Вставить("ЗаполняемыйТабличныйДокумент",	ЗаполняемыйТабличныйДокумент);
		ПараметрыВыводаТаблицы.Вставить("ИспользуемыйМакет",			ИспользуемыйМакет);
		ПараметрыВыводаТаблицы.Вставить("СтрокаГруппировки",			СтрокаГруппировкаЧастьЖурнала);
		ПараметрыВыводаТаблицы.Вставить("НумероватьВнутриКонтрагента",	ПараметрыОтчета["НумероватьВнутриКонтрагента"]);
		
		ВывестиЧастьЖурнала(ПараметрыОтчета, ПараметрыВыводаТаблицы, ДетальныеЗаписи, ДанныеДляДекларации);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиЧастьЖурнала(ПараметрыОтчета, ПараметрыВыводаТаблицы, ДетальныеЗаписи, ДанныеДляДекларации)
	
	НомерЧастиЖурнала				= ПараметрыВыводаТаблицы["НомерЧастиЖурнала"];
	СтрокаГруппировкаЧастьЖурнала	= ПараметрыВыводаТаблицы["СтрокаГруппировки"];
	ЗаполняемыйТабличныйДокумент	= ПараметрыВыводаТаблицы["ЗаполняемыйТабличныйДокумент"];
	ИспользуемыйМакет				= ПараметрыВыводаТаблицы["ИспользуемыйМакет"];
	
	Если НомерЧастиЖурнала = 1 Тогда
		ОбозначениеРаздела = "10";
	Иначе
		ОбозначениеРаздела = "11";
	КонецЕсли;
	
	// Декларация
	// СегментацияДанныхДекларации
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		
		УчетНДС.СегментацияДанныхДекларации_НастроитьСтатистикуПередВыводомТаблицы(
		ОбозначениеРаздела,
		ЗаполняемыйТабличныйДокумент,
		ДетальныеЗаписи.Количество(),
		ПараметрыОтчета);
	КонецЕсли;
	
	//---
	// Шапка раздела
	//---
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		Если НомерЧастиЖурнала = 1 Тогда
			ОбластьЗаголовокТаблицы = ИспользуемыйМакет.ПолучитьОбласть("ШапкаРаздел10");
		Иначе
			ОбластьЗаголовокТаблицы = ИспользуемыйМакет.ПолучитьОбласть("ШапкаРаздел11");
		КонецЕсли;
		ЗаполняемыйТабличныйДокумент.Вывести(ОбластьЗаголовокТаблицы);
	КонецЕсли;
	
	//---
	// Заголовок таблицы
	//---
	Если НЕ ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		Если НомерЧастиЖурнала = 1 Тогда
			ОбластьЗаголовокТаблицы = ИспользуемыйМакет.ПолучитьОбласть("ЗаголовокТаблицы1");
		Иначе
			ОбластьЗаголовокТаблицы = ИспользуемыйМакет.ПолучитьОбласть("ЗаголовокТаблицы2");
		КонецЕсли;
		ЗаполняемыйТабличныйДокумент.Вывести(ОбластьЗаголовокТаблицы);
	КонецЕсли;
	
	//---
	// Шапка таблицы
	//---
	Если НомерЧастиЖурнала = 1 Тогда
		ОбластьШапка = ИспользуемыйМакет.ПолучитьОбласть("Шапка1");
	Иначе
		ОбластьШапка = ИспользуемыйМакет.ПолучитьОбласть("Шапка2");
	КонецЕсли;
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьШапка);
	
	// Если часть журнала пустая, то выводим только шапку таблицы, и больше ничего:
	Если СтрокаГруппировкаЧастьЖурнала = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//---
	// Строки таблицы
	//---
	ВывестиСтрокиЧастиЖурнала(ПараметрыОтчета, ПараметрыВыводаТаблицы, ДанныеДляДекларации, ОбозначениеРаздела);
	
	
	// Декларация
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		
		// СегментацияДанныхДекларации
		// Записываем текущий сегмент, обновляем статистику
		УчетНДС.СегментацияДанныхДекларации_ЗаписатьТекущийСегмент(
			ОбозначениеРаздела,	// ОбозначениеРаздела
			ЗаполняемыйТабличныйДокумент,
			ПолучитьИспользуемыйМакет(ПараметрыОтчета),
			ПараметрыОтчета,
			ДанныеДляДекларации,
			Истина);	// ЗакончиласьТаблица
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиСтрокиЧастиЖурнала(ПараметрыОтчета, ПараметрыВыводаТаблицы, ДанныеДляДекларации, ОбозначениеРаздела)
	
	// Декларация
	// СегментацияДанныхДекларации
	Перем	ОбозначениеРазделаКнига,
	СегментацияДанныхРазделаКнига,
	ТаблицаДанныхКнига;
	
	СтрокаГруппировки = ПараметрыВыводаТаблицы["СтрокаГруппировки"];
	
	СимволПрочерка = "---";
	
	// Декларация
	// СегментацияДанныхДекларации
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		// Разделы 10, 11
		ОбозначениеРазделаКнига = ОбозначениеРаздела;
		ОписаниеРаздела					= УчетНДС.СегментацияДанныхДекларации_ПолучитьОписаниеРаздела(ОбозначениеРазделаКнига);
		ИмяРаздела						= ОписаниеРаздела["ИмяВРегламентированнойОтчетности"];
		СегментацияДанныхРазделаКнига	= ПараметрыОтчета["СегментацияДанныхДекларации"][ИмяРаздела];
		ИмяТаблицыДанных				= ОписаниеРаздела["ИмяТаблицыДанных"];
		ТаблицаДанныхКнига				= ДанныеДляДекларации[ИмяТаблицыДанных];
	КонецЕсли;
	
	ТекстБезНДС = "без НДС";
	ТекстПустаяСтрока = "";
	
	НомерПП = 1;
	
	Для Каждого СтрокаДереваГруппировки Из СтрокаГруппировки.Строки Цикл
		
		НомерСтрокиГруппировки = 1;
		
		Для каждого СтрокаДерева Из СтрокаДереваГруппировки.Строки Цикл
			
			
			НомерЧастиЖурнала				= ПараметрыВыводаТаблицы["НомерЧастиЖурнала"];
			ЗаполняемыйТабличныйДокумент	= ПараметрыВыводаТаблицы["ЗаполняемыйТабличныйДокумент"];
			ИспользуемыйМакет				= ПараметрыВыводаТаблицы["ИспользуемыйМакет"];
			НумероватьВнутриКонтрагента		= ПараметрыВыводаТаблицы["НумероватьВнутриКонтрагента"];
			
			ЗакупкаКомиссия = СтрокаДерева["ПричинаНалогообложения"] = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаПокупку
				ИЛИ СтрокаДерева["ПричинаНалогообложения"] = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаАванс;
			
			//---
			// Строка таблицы
			//---
			ЗначенияПараметров = Новый Структура();
			
			Если НомерСтрокиГруппировки = 1 ИЛИ СтрокаДерева.ЧастьЖурнала = Перечисления.ЧастиЖурналаУчетаСчетовФактур.ПолученныеСчетаФактуры Тогда
				ОбластьСтрока = ИспользуемыйМакет.ПолучитьОбласть("СтрокаЧасть" + НомерЧастиЖурнала);
				
				// 1
				Параметр_НПП = НомерПП;
				
				ЗначенияПараметров.Вставить("НПП",					Параметр_НПП);
				НомерПП = НомерПП + 1;
				ПараметрыВыводаТаблицы["НПП"] = НомерПП;
				
			Иначе
				ОбластьСтрока = ИспользуемыйМакет.ПолучитьОбласть("СтрокаЧасть1Группировка");
				// 1
				ЗначенияПараметров.Вставить("НПП",					Параметр_НПП);
				ПараметрыВыводаТаблицы["НПП"] = Параметр_НПП;
				
			КонецЕсли;
			
			ОбластьСтрока.Параметры.Заполнить(СтрокаДерева);
			
			Если НомерЧастиЖурнала = 1 Тогда
				СторонаCделки = УчетНДС.ОпределитьПокупателя(СтрокаДерева)["Покупатель"];
			Иначе
				СторонаCделки = УчетНДС.ОпределитьПродавца(СтрокаДерева)["Продавец"];
			КонецЕсли;
			
			Параметр_ПокупательПродавецПредставление	= СторонаCделки["Наименование"];
			Параметр_ПокупательПродавецИНН				= СторонаCделки["ИНН"];
			Параметр_ПокупательПродавецКПП				= СторонаCделки["КПП"];
			Параметр_ПокупательПродавецСсылка			= СторонаCделки["Ссылка"];
			
			СтруктураНомерСФ = УчетНДС.ОпределитьНомерСФДляВыводаВРегистрыУчета(СтрокаДерева);
			
			// 4
			ЗначенияПараметров.Вставить("НомерДатаСФ",
			УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
			СтруктураНомерСФ["Номер"], СтрокаДерева["Дата"]));
			
			// 5
			ЗначенияПараметров.Вставить("НомерДатаИсправленияСФ",
			УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
			СтрокаДерева["НомерИсправления"], СтрокаДерева["ДатаИсправления"]));
			
			// 6
			ЗначенияПараметров.Вставить("НомерДатаКСФ",
			УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
			СтруктураНомерСФ["НомерКСФ"], СтрокаДерева["ДатаКСФ"]));
			
			// 7
			ЗначенияПараметров.Вставить("НомерДатаИсправленияКСФ",
			УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
			СтрокаДерева["НомерИсправленияКСФ"], СтрокаДерева["ДатаИсправленияКСФ"]));
			
			// 8
			ЗначенияПараметров.Вставить("ПокупательПродавецПредставление",	Параметр_ПокупательПродавецПредставление);
			ЗначенияПараметров.Вставить("ПокупательПродавецСсылка",			Параметр_ПокупательПродавецСсылка);
			
			// 9
			Если ЗначениеЗаполнено(Параметр_ПокупательПродавецИНН) ИЛИ ЗначениеЗаполнено(Параметр_ПокупательПродавецКПП) Тогда
				Параметр_ИННКПП = Строка(Параметр_ПокупательПродавецИНН) + " / " + Строка(Параметр_ПокупательПродавецКПП);
			Иначе
				Параметр_ИННКПП = "";
			КонецЕсли;
			ЗначенияПараметров.Вставить("ИННКПП", Параметр_ИННКПП);
			
			//10
			Если ЗакупкаКомиссия Тогда
				Параметр_ПосредникНаименование	= СтрокаДерева["ПродавецПредставление"];
				ЗначенияПараметров.Вставить("ПосредникНаименование", Параметр_ПосредникНаименование);
			КонецЕсли;
			
			//11 
			Если ЗакупкаКомиссия Тогда
				Если ЗначениеЗаполнено(СтрокаДерева["ПродавецИНН"]) ИЛИ ЗначениеЗаполнено(СтрокаДерева["ПродавецКПП"]) Тогда
