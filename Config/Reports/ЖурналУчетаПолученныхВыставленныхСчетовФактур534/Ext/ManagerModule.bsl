#Область ПрограммныйИнтерфейс

Процедура СформироватьОтчет(Знач ПараметрыОтчета, ВозвратАдресХранилищаРезультата, ДокументРезультат = Неопределено) Экспорт
	
	Перем	ЗаполнитьДанныеДляДекларации,
		ДанныеДляДекларации;
	
	// Установленные параметры отчета:
	Если ЗначениеЗаполнено(ПараметрыОтчета["ДатаНачала"]) Тогда
		ПараметрыОтчета["ДатаНачала"] = НачалоДня(ПараметрыОтчета["ДатаНачала"]);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета["ДатаКонца"]) Тогда
		ПараметрыОтчета["ДатаКонца"] = КонецДня(ПараметрыОтчета["ДатаКонца"]);
	КонецЕсли;
	
	ДобавитьРедакциюПостановления(ПараметрыОтчета);
	
	// Декларация
	ПараметрыОтчета.Свойство("ЗаполнитьДанныеДляДекларации", ЗаполнитьДанныеДляДекларации);
	ЗаполнитьДанныеДляДекларации = (ЗаполнитьДанныеДляДекларации = Истина);
	ПараметрыОтчета.Вставить("ЗаполнитьДанныеДляДекларации", ЗаполнитьДанныеДляДекларации);
	Если ПараметрыОтчета.ЗаполнитьДанныеДляДекларации Тогда
		
		ДанныеДляДекларации = Новый Структура();
		ИнициализироватьТаблицыДляДекларацииПоНДС(ДанныеДляДекларации);
		
	КонецЕсли;
	
	СформироватьЖурналУчета(ПараметрыОтчета, ДанныеДляДекларации, ДокументРезультат);
	
КонецПроцедуры

#Область СлужебныйПрограммныйИнтерфейс

