&НаКлиенте
Процедура СортировкаПередНачаломИзменения(Элемент, Отказ)
	
	СтандартныеОтчетыКлиент.СортировкаПередНачаломИзменения(ЭтаФорма, Элемент, Отказ);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ ОФОРМЛЕНИЕ

&НаКлиенте
Процедура МакетОформленияПриИзменении(Элемент)
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(Отчет.КомпоновщикНастроек.Настройки, "МакетОформления", МакетОформления);
	
	ИзменениеКонтроловВлияющееНаРезультат(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыводитьЗаголовокПриИзменении(Элемент)

	ОбластьПоиска = Результат.Области.Найти("Заголовок");
	Если ОбластьПоиска = Неопределено Тогда
		СформироватьОтчет(Ложь);
	Иначе
		ОбластьПоиска.Видимость = ВыводитьЗаголовок;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыводитьПодвалПриИзменении(Элемент)
	
	ОбластьПоиска = Результат.Области.Найти("Подписи");
	Если ОбластьПоиска = Неопределено Тогда
		СформироватьОтчет(Ложь);
	Иначе
		ОбластьПоиска.Видимость = ВыводитьПодвал;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент)
		
	ПодключитьОбработчикОжидания("РассчитатьПоказателиДинамически", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ТолькоУказанныйПериодПриИзменении(Элемент)
	
	
	СтандартныеОтчетыКлиент.УстановитьДатыПоВидуПериода(Отчет);
	
	Модифицированность = Истина;
	
	ОбновитьТекстЗаголовка(ЭтотОбъект);
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеПериода(Элемент)
	
	СтандартныеОтчетыКлиент.УстановитьВидМежотчетногоПериодаПоДате(Отчет);
	
    СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПериодаПриИзменении(Элемент)
	
	СтандартныеОтчетыКлиент.УстановитьДатыПоВидуПериода(Отчет);
	
	Модифицированность = Истина;
	
	ОбновитьТекстЗаголовка(ЭтотОбъект);
		
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);

	
КонецПроцедуры

&НаКлиенте
Процедура ПодписиВыводитьПриИзменении(Элемент)

    СтандартныеОтчетыКлиент.ПодписиВыводитьПриИзменении(Элемент.Родитель.ТекущиеДанные, ЭтаФорма.Результат);

КонецПроцедуры

&НаКлиенте
Процедура ПодписиПередНачаломИзменения(Элемент, Отказ)

    Отказ = СтандартныеОтчетыКлиент.ПодписиПередНачаломИзменения(Элемент.ТекущийЭлемент, Элемент.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ПодписиСотрудникПриИзменении(Элемент)

    СтандартныеОтчетыКлиент.ПодписиСотрудникПриИзменении(Элемент.Родитель.ТекущиеДанные, ЭтаФорма.Результат);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	ОчиститьСообщения();
	
	ОтключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания");
	
	УИДЗамера = ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Ложь, "ФормированиеОтчетаАнализСчета");
	
	РезультатВыполнения = СформироватьОтчетСервер();
	Если Не РезультатВыполнения.ЗаданиеВыполнено Тогда
		ОбновитьОбработчикОжидания();
	Иначе
		ЗафиксироватьДлительностьКлючевойОперации();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПанельНастроек(Команда)
	
	Элементы.ГруппаПанельНастроек.Видимость = Не Элементы.ГруппаПанельНастроек.Видимость;
	Элементы.ПанельНастроек.Пометка = Элементы.ГруппаПанельНастроек.Видимость;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеПоляСнятьФлажки(Команда)
	
	Для Каждого СтрокаТаблицы Из Отчет.ДополнительныеПоля Цикл
		СтрокаТаблицы.Использование = Ложь;
	КонецЦикла;
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеПоляУстановитьФлажки(Команда)
	
	Для Каждого СтрокаТаблицы Из Отчет.ДополнительныеПоля Цикл
		СтрокаТаблицы.Использование = Истина;
	КонецЦикла;
	
