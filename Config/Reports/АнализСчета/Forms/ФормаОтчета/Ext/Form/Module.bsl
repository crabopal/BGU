#Область ОписаниеПеременных

&НаКлиенте
Перем ПараметрыОбработчикаОжидания;

&НаКлиенте
Перем УИДЗамера;

// Псевдоконстанты
&НаКлиенте
Функция ДЛИТЕЛЬНОСТЬ_ОЖИДАНИЯ()	Возврат 1; КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтандартныеОтчеты.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
    
    СтандартныеОтчеты.ДобавитьИзмеренияВГруппировки(Отчет.Группировка);
	СтандартныеОтчеты.ДобавитьГруппировкуЕПСБУ(Отчет.Группировка, "ХХКЭК", Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляГруппировок.Элементы.Найти("ХХКЭК").Заголовок, Ложь);
    
    СтандартныеОтчеты.ЗаполнитьПодписиПоУмолчанию(Отчет.Подписи);
    
	УправлениеФормой(ЭтаФорма);
		
	УстановитьЗначенияПоФункциональнымОпциям();
    
    СИ = Новый СистемнаяИнформация;
    LinuxServer = СИ.ТипПлатформы = ТипПлатформы.Linux_x86 ИЛИ СИ.ТипПлатформы = ТипПлатформы.Linux_x86_64;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
	Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Если НЕ СтандартныеПодсистемыКлиент.ПараметрыРаботыКлиента().ИнформационнаяБазаФайловая Тогда
			ОбновитьОбработчикОжидания();
		КонецЕсли;
	КонецЕсли;

	СтандартныеОтчетыКлиент.ПриОткрытии(ЭтаФорма);
	
	РассчитатьПоказатели();
	
	ОчиститьУсловия();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьУсловия()
    // Если Линукс и PostgreSQL тогда у всех доступных полей отбора
    // Откусываем ТипыСравнения "ВГруппе" "ВГруппеИзСписка"
    Стр = СтрокаСоединенияИнформационнойБазы();
    Если LinuxServer И СтрНайти(Стр, "Srvr=") > 0 Тогда
        массивВСИсключить = Новый Массив();
        массивВСИсключить.Добавить(ВидСравненияКомпоновкиДанных.ВИерархии);
        массивВСИсключить.Добавить(ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии);
        массивВСИсключить.Добавить(ВидСравненияКомпоновкиДанных.НеВИерархии);
        массивВСИсключить.Добавить(ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии);
        Для каждого ДПО Из Отчет.КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора.Элементы Цикл
            Если НЕ ДПО.Папка Тогда
                Для каждого ВС Из массивВСИсключить Цикл
                    ЭСЗ = ДПО.ДоступныеВидыСравнения.НайтиПоЗначению(ВС);
                    Если ЭСЗ <> Неопределено Тогда
                        ДПО.ДоступныеВидыСравнения.Удалить(ЭСЗ);
                    КонецЕсли; 
                КонецЦикла; 
            КонецЕсли; 
        КонецЦикла; 
    КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	СтандартнаяОбработка = НЕ Отчет.РежимРасшифровки;
	
	ВариантМодифицирован                    = Ложь;
	ПользовательскиеНастройкиМодифицированы = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	СтандартныеОтчеты.ПриСохраненииПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
	Если Не КомпоновщикИнициализирован Тогда
		ПользовательскиеНастройки = ПоместитьВоВременноеХранилище(Настройки, УникальныйИдентификатор);
	КонецЕсли;
	
	СтандартныеОтчеты.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	СтандартныеОтчеты.ДобавитьИзмеренияВГруппировки(Отчет.Группировка);
	СтандартныеОтчеты.ДобавитьГруппировкуЕПСБУ(Отчет.Группировка, "ХХКЭК", Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляГруппировок.Элементы.Найти("ХХКЭК").Заголовок, Ложь);
	ИзменениеСхемыКомпоновкиДанных();
	УправлениеФормой(ЭтаФорма);
	УстановитьЗначенияПоФункциональнымОпциям();
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	СтандартныеОтчеты.ДобавитьОтборПоОрганизации(ЭтаФорма.Отчет);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	
	СчетПриИзмененииСервер();
	
	ОбновитьТекстЗаголовка(ЭтаФорма); 
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
    
    ОчиститьУсловия();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ИзменитьОтборПоОрганизации(Отчет);
    
    СтандартныеОтчетыКлиент.ПриИзмененииОрганизации(Отчет.Организация, Отчет.Подписи);
    
	ОбновитьТекстЗаголовка(ЭтаФорма);
	ИзменениеКонтроловВлияющееНаРезультат(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеКонтроловВлияющееНаРезультат(Элемент)
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартныеОтчетыКлиент.ОбработкаРасшифровкиСтандартногоОтчета(ЭтаФорма, Элемент, Расшифровка, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	// Не будем обрабатывать нажатие на правую кнопку мыши.
	// Покажем стандартное контекстное меню ячейки табличного документа.
	Расшифровка = Неопределено;
	
КонецПроцедуры

// Оформление

