#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем НаборПоказателей Экспорт;
Перем ВысотаШапки;
Перем ВременныеДанныеОтчета;

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеОтчеты

Функция ПолучитьПараметрыИсполненияОтчета() Экспорт
	
	Возврат Новый Структура(
	"ИспользоватьПередКомпоновкойМакета,
	|ИспользоватьПослеКомпоновкиМакета,
	|ИспользоватьПриВыводеЗаголовка,
	|ИспользоватьПослеВыводаРезультата,
	|ИспользоватьДанныеРасшифровки,
	|ИспользоватьПередВыводомЭлементаРезультата,
	|ИспользоватьПриВыводеПодвала,
	|ВыводитьОтладочнуюИнформацию,
	|ИспользоватьПривилегированныйРежим",
	Истина, Истина, Истина, Истина, Истина, Ложь, Истина, Истина, Истина);
	
КонецФункции
	
Процедура ПередКомпоновкойМакета(Схема) Экспорт
    
    КомпоновщикНастроек.Настройки.Структура.Очистить();
    
    Если ЗначениеЗаполнено(НачалоПериода) Тогда
        СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода", НачалоДня(НачалоПериода));
        СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Период", НачалоПериода);
    Иначе
        СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода", Дата(1, 1, 1));
        СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Период", Дата(1, 1, 1));
    КонецЕсли;
    Если ЗначениеЗаполнено(КонецПериода) Тогда
        СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода", Бухгалтерскийучет.КонецПериодаСУточнением(КонецПериода, ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ЗаключениеСчетов")));
    Иначе
        СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода", Дата(3999, 11, 1));
    КонецЕсли;
    СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоГода", НачалоГода(НачалоПериода));
    СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Год", Формат(НачалоПериода, "ДФ=yyyy"));
    СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НП", Формат(НачалоПериода, "ДЛФ=DD"));
    СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПериодОтчета", ПредставлениеПериода(НачалоДня(НачалоПериода), КонецДня(КонецПериода), "ФП"));
    СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КП", Формат(КонецДня(КонецПериода), "ДЛФ=DD"));
    
    
    СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Включать5ХХСчет", Включать5ХХСчет);

    Если ЗначениеЗаполнено(Организация) Тогда
        СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Организация", Организация);
        Если ЗначениеЗаполнено(Подразделение) Тогда
            СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Подразделение", Подразделение);
        Иначе
            СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Подразделение", Справочники.Журналы.ПустаяСсылка());
        КонецЕсли
    КонецЕсли;
    
    МассивПоказателей = Новый Массив;
    МассивПоказателей.Добавить("БУ");
    ПоказательБУ = Истина;
	
	Если НЕ НеВыводитьРазвернутоеСальдо Тогда
    	ДобавитьРазвернутыеСчета(Схема);
	КонецЕсли;	
    
    Структура = КомпоновщикНастроек.Настройки;
    
    КомпоновщикНастроек.Настройки.Структура.Очистить();
	
	// вставляем пользовательские группировки
    НомерГруппировки = 1;
    МассивЧтоЕсть = Новый Массив();
    Эталон = Неопределено;
    Для каждого ГруппировкаОтчета из Группировка Цикл
        Если ГруппировкаОтчета.Использование Тогда
            МассивЧтоЕсть.Добавить(Строка(ГруппировкаОтчета.Поле));
            Структура = Структура.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
            
			Если ГруппировкаОтчета.Поле <> "Организация" Тогда
				Если ГруппировкаОтчета.Поле <> "КЭК" Тогда
					Структура.Имя = "Группировка" + НомерГруппировки;
				Иначе
					Структура.Имя = "ГруппировкаКЭК";
				КонецЕсли;
			КонецЕсли;
			
			ПолеГруппировки = Структура.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
            ПолеГруппировки.Использование  = Истина;
            ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ГруппировкаОтчета.Поле);
            Если ГруппировкаОтчета.ТипГруппировки = 0 Тогда
                ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
            ИначеЕсли ГруппировкаОтчета.ТипГруппировки = 1 Тогда
                ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
            Иначе
                ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.ТолькоИерархия;
            КонецЕсли;
            
            Структура.ПараметрыВывода.УстановитьЗначениеПараметра("ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
						
			// для группировок по КЭК
			Если ГруппировкаОтчета.Поле = "КЭК" Тогда
				
				ГруппаИли = Структура.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
				ГруппаИли.ТипГруппы  = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;

				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИли, "НГСуммаНачальныйОстатокДтКЭК", 0, ВидСравненияКомпоновкиДанных.НеРавно);
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИли, "НГСуммаНачальныйОстатокКтКЭК", 0, ВидСравненияКомпоновкиДанных.НеРавно);
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИли, "СуммаНачальныйОстатокДтКЭК", 0, ВидСравненияКомпоновкиДанных.НеРавно);
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИли, "СуммаНачальныйОстатокКтКЭК", 0, ВидСравненияКомпоновкиДанных.НеРавно);
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИли, "НГСуммаКонечныйОстатокДтКЭК", 0, ВидСравненияКомпоновкиДанных.НеРавно);
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИли, "НГСуммаКонечныйОстатокКтКЭК", 0, ВидСравненияКомпоновкиДанных.НеРавно);
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИли, "НГСуммаОборотДт", 0, ВидСравненияКомпоновкиДанных.НеРавно);
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИли, "НГСуммаОборотКт", 0, ВидСравненияКомпоновкиДанных.НеРавно);
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИли, "СуммаОборотДт", 0, ВидСравненияКомпоновкиДанных.НеРавно);
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИли, "СуммаОборотКт", 0, ВидСравненияКомпоновкиДанных.НеРавно);
			КонецЕсли;
			
			// для группировки по ЖО
			Если ГруппировкаОтчета.Поле = "ЖурналОпераций" Тогда
				
				ГруппаИли = Структура.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
				ГруппаИли.ТипГруппы  = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;

                СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Структура.Отбор, "ЖурналОпераций", 0, ВидСравненияКомпоновкиДанных.Заполнено);
            КонецЕсли;
            
            Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
            Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
                // устанавливаем макет для группировки
            Для каждого МакетГруппировки из СхемаКомпоновкиДанных.МакетыГруппировок Цикл
                Если
					МакетГруппировки.ИмяГруппировки = Структура.Имя И
                    МакетГруппировки.ТипМакета = ТипМакетаОбластиКомпоновкиДанных.Заголовок
                Тогда
                    Макет = Схема.Макеты.Найти(МакетГруппировки.Макет);
                    Если Эталон = Неопределено Тогда
                        Эталон = Схема.Макеты.Найти(ПолучитьМакетЭталоннойГруппировки());
                    КонецЕсли;
                        // Проставляем выражения для КПС, КФО, Счет (Счет.НомерЖурнала), КОСГУ
                        // Если были такие группировки, то Представление(ИмяПоля), если нет, то нужное количество нулей
                    УстановитьПараметрМакета(МассивЧтоЕсть, "КПС",            """00000000000000000""", Макет, Эталон);
                    УстановитьПараметрМакета(МассивЧтоЕсть, "КФО",            """0""",                 Макет, Эталон);
                    УстановитьПараметрМакета(МассивЧтоЕсть, "Счет",           """000.00""",            Макет, Эталон);
                    УстановитьПараметрМакета(МассивЧтоЕсть, "КЭК",            """000""",               Макет, Эталон);
                    УстановитьПараметрМакета(МассивЧтоЕсть, "ЖурналОпераций", """-""",                 Макет, Эталон);
                    Прервать;
                КонецЕсли;
			КонецЦикла;
			
            НомерГруппировки = НомерГруппировки + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
    СтандартныеОтчеты.ДобавитьОтборПоОрганизации(ЭтотОбъект);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ЗначениеЗаполнено(Подразделение) Тогда
		// Если среди доступных организаций, нет выбранной, то оставляем фильтр по доступным организациям
		НовыйОтбор = СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "Подразделение", Подразделение,,, Истина);
		НовыйОтбор.Представление = "###ОтборПоПодразделение###"; 
		НовыйОтбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;

КонецПроцедуры

Процедура ПослеКомпоновкиМакета(МакетКомпоновки) Экспорт
    
    КоличествоГруппировок = 0;
    ГруппировкаСчет = ложь;
    Для Каждого Гр Из Группировка Цикл
        Если Гр.Использование Тогда
            КоличествоГруппировок = КоличествоГруппировок + 1;
            Если Гр.Представление = "Счет" Тогда
                ГруппировкаСчет = Истина;
            КонецЕсли
        КонецЕсли;
    КонецЦикла;
    
    ВременныеДанныеОтчета = Новый Структура;
    Если ГруппировкаСчет Тогда
        ЗначенияПоказателей = Новый Массив(10);
        Для Индекс = 0 По 9 Цикл
            ЗначенияПоказателей[Индекс] = 0;
        КонецЦикла;
        МакетГруппировкиСчет = СтандартныеОтчеты.ПолучитьМакетГруппировкиПоПолюГруппировки(МакетКомпоновки, "Счет");
        ВременныеДанныеОтчета.Вставить("МакетСчет", МакетГруппировкиСчет);
        ВременныеДанныеОтчета.Вставить("ЗначенияПоказателей", ЗначенияПоказателей);
    КонецЕсли;
    
    МакетПодвалаОтчета = СтандартныеОтчеты.ПолучитьМакетПодвала(МакетКомпоновки);
    Если МакетПодвалаОтчета <> Неопределено Тогда
        ВременныеДанныеОтчета.Вставить("МакетПодвал", МакетПодвалаОтчета);
    КонецЕсли;
    
КонецПроцедуры

Процедура ПриВыводеЗаголовка(Результат, ВыводитьПолностью) Экспорт
	
	Макет = ПолучитьМакет("МакетФиксированныхОбластей");
    ОбластьЗаголовок = Макет.ПолучитьОбласть("Шапка");
	
	СтруктураШапки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, Новый Структура("Учреждение, ОКПО, Бюджет", "НаименованиеПолное", "КодОКПО"));
	СтруктураШапки.Вставить("ДатаОтчета", Формат(КонецДня(КонецПериода) + 1, "ДЛФ=Д")); 
	СтруктураШапки.Вставить("Подразделение", Подразделение); 
	СтруктураШапки.Вставить("СтрокаПериода", ПредставлениеПериода(НачалоДня(НачалоПериода), КонецДня(КонецПериода), "ФП"));
	
	Если ЗначениеЗаполнено(СтруктураШапки.Бюджет) Тогда
		
		РеквизитыБюджета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураШапки.Бюджет, "НаименованиеПубличноПравовогоОбразования,НаименованиеПолное");
		
		СтруктураШапки.Вставить("Учредитель", РеквизитыБюджета.НаименованиеПубличноПравовогоОбразования);
		СтруктураШапки.Вставить("Бюджет ", РеквизитыБюджета.НаименованиеПолное);
		
	КонецЕсли;	
	
	ОбластьЗаголовок.Параметры.Заполнить(СтруктураШапки);
	
    Результат.Вывести(ОбластьЗаголовок);
    
    Если ВыводитьПолностью Тогда
        СтандартныеОтчеты.ВыводитьОтбор(Результат, КомпоновщикНастроек, "Организация");
    КонецЕсли;
    
    Результат.Область("R1:R" + Результат.ВысотаТаблицы).Имя = "Заголовок";
    Результат.Области.Заголовок.Видимость = КомпоновщикНастроек.ПолучитьНастройки().ДополнительныеСвойства.ВыводитьЗаголовок;
    
КонецПроцедуры

Функция ПолучитьТекстЗаголовка(ОрганизацияВНачале = Истина) Экспорт 
    
    Возврат "Главная книга";
    
КонецФункции

Процедура ПослеВыводаРезультата(Результат) Экспорт
    
    СтандартныеОтчеты.ОбработкаРезультатаОтчета(ЭтотОбъект, Результат);
    Если Результат.Области.Найти("Заголовок") <> Неопределено И Результат.Области.Найти("Подписи") <> Неопределено Тогда
        Если Результат.Области.Заголовок.Низ = Результат.Области.Подписи.Верх Тогда
            Результат.ФиксацияСверху = Результат.Области.Заголовок.Низ + ВысотаШапки + 3;
            //Результат.ПовторятьПриПечатиСтроки = Результат.Область("R" + (Результат.Области.Заголовок.Низ) + ":R" + (Результат.Области.Заголовок.Низ + 3));
		КонецЕсли;
		Результат.ПовторятьПриПечатиСтроки = Результат.Область("R" + (Результат.Области.Заголовок.Низ + 1) + ":R" + (Результат.Области.Заголовок.Низ + 3));
		Результат.ЧерноБелаяПечать = Истина;
		Результат.ЧерноБелыйПросмотр = Истина;
    КонецЕсли;
    
КонецПроцедуры

Процедура ПриВыводеПодвала(Результат) Экспорт
    
    Макет = ПолучитьМакет("МакетФиксированныхОбластей");
    ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	СтруктураПодвала = Новый Структура;
	СтруктураПодвала.Вставить("ГлавБух", Корреспонденты.ФИОПоОбъекту(ГлавБух,, ТекущаяДатаСеанса()));
	СтруктураПодвала.Вставить("ТекущаяДата", Формат(ТекущаяДатаСеанса(), "ДЛФ=ДДММММГГГГ")); 
	
	Если ЗначениеЗаполнено(Исполнитель) Тогда
		
		ДанныеСотрудника = Новый Структура;
		ДанныеСотрудника.Вставить("СсылкаНаОбъект", Исполнитель); 
		ДанныеСотрудника.Вставить("Период", ТекущаяДатаСеанса());
		ДанныеСотрудника.Вставить("Фамилия", "");
		ДанныеСотрудника.Вставить("Имя", "");
		ДанныеСотрудника.Вставить("Отчество", "");
		ДанныеСотрудника.Вставить("Должность", "");
		
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, Истина);
		
		СтруктураПодвала.Вставить("Исполнитель", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника));
		СтруктураПодвала.Вставить("ИсполнительДолжность", ДанныеСотрудника.Должность); 
		СтруктураПодвала.Вставить("ТелефонИсполнителя", ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
		СтруктураПодвала.Вставить("ЭлектроннаяПочтаИсполнителя", ДанныеСотрудника.EmailФизическиеЛица); 
		
	КонецЕсли;	
	
	ОбластьПодвал.Параметры.Заполнить(СтруктураПодвала);
	
	Высота = Результат.ВысотаТаблицы + 1;
    Результат.Вывести(ОбластьПодвал);
    Результат.Область(Высота, ,Результат.ВысотаТаблицы,).Имя = "Подписи";
	
	Результат.Области.Подписи.Видимость = КомпоновщикНастроек.ПолучитьНастройки().ДополнительныеСвойства.ВыводитьПодвал;
    
КонецПроцедуры

