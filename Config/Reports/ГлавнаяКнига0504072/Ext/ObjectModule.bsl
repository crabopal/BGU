Процедура СформироватьОтчет(Результат = Неопределено, ДанныеРасшифровки = Неопределено, Схема = Неопределено, ВыводитьПолностью = Истина) Экспорт
    
    СтандартныеОтчеты.ВывестиОтчет(ЭтотОбъект, Результат, ДанныеРасшифровки, Схема, ВыводитьПолностью); 
    
КонецПроцедуры

Функция ПолучитьСчета(Счет, Запрос)
    
    Запрос.Текст =
        "ВЫБРАТЬ
        |	ЕПСБУ.Ссылка КАК Счет
        |ИЗ
        |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
        |ГДЕ
        |	ЕПСБУ.Ссылка В ИЕРАРХИИ(&ВыбСчет)
        |	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
        |	И ЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)";
        
    Запрос.УстановитьПараметр("ВыбСчет", Счет);
    Возврат Запрос.Выполнить().Выбрать();
    
КонецФункции // ПолучитьСчета()
 
Функция РазложитьРазвернутыеСчетаПоКатегориям(СписокСчетовВИерархии, МассивСписковСчетовПоСубконто)

    Для Элемент = 0 по МассивСписковСчетовПоСубконто.Количество() - 1 Цикл
        МассивСписковСчетовПоСубконто[Элемент] = Новый Соответствие;
    КонецЦикла;

    СтекВложенныхСчетов = Новый Массив();
    Стр = СтандартныеОтчеты.ДанныеОтчетаРазвернутоеСальдо(Новый Запрос);
    Пока Стр.Следующий() Цикл
        Если Стр.Счет.ЭлементГруппа Тогда
            Продолжить;
        КонецЕсли;
        Если Стр.Использование = Перечисления.ВидыРазвернутогоСальдо.Разворачивать Тогда
                // По субконто
            МассивЗначений = Новый Массив(2);
            МассивЗначений[0] = Новый СписокЗначений; //СписокСубконто 
                // Формируем ключ
            Для Сбк = 1 По 3 Цикл
                Если ЗначениеЗаполнено(Стр["Субконто" + Сбк]) Тогда
                    МассивЗначений[0].Добавить(Стр["Субконто" + Сбк]);
                КонецЕсли;
            КонецЦикла;
            КСубконто    = МассивЗначений[0].Количество();
            ЗначениеПоКлючу = МассивСписковСчетовПоСубконто[КСубконто].Получить(Строка(МассивЗначений[0])); //СписокСчетов
            Если ЗначениеПоКлючу = Неопределено Тогда
                МассивЗначений[1] = Новый СписокЗначений;
            Иначе
                МассивЗначений[1] = ЗначениеПоКлючу[1];
            КонецЕсли;
                
            МассивЗначений[1].Добавить(Стр.Счет);
            МассивСписковСчетовПоСубконто[КСубконто].Вставить(Строка(МассивЗначений[0]), МассивЗначений);
        КонецЕсли;
    КонецЦикла;

    Возврат Истина;

КонецФункции

// Добавляет в запрос развернутое сальдо по заданным счетам
//
Процедура ДобавитьРазвернутыеСчета(Схема)
    
    // Раскладываем развернутые счета по категориям:
    // - Не используется субконто
    // - Используется одно субконто
    //		Соответствие (Ключ - Строка(СписокЗначений(Субконто)), Значение - Массив(СписокЗначений(Субконто), СписокЗначений(Счет)))
    // - Используется два субконто
    //		Соответствие (Ключ - Строка(СписокЗначений(Субконто)), Значение - Массив(СписокЗначений(Субконто), СписокЗначений(Счет)))
    // - ...
    СписокСчетовВИерархии  = Новый СписокЗначений; // - Включена иерархия
    МассивСписковСчетовПоСубконто = Новый Массив(4);
    РазложитьРазвернутыеСчетаПоКатегориям(СписокСчетовВИерархии, МассивСписковСчетовПоСубконто);
	
    // заполнение списка
    СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "РазвернутыеСчета", СписокСчетовВИерархии);
    // Создаем запрос по развернутым остаткам
    // Он будет объединять все запросы по счетам
    // Выбрать ... из БухОстатки(Счет В МассивСписковСчетовПоСубконто[ЙЙ].Значение, Субконто - МассивСписковСчетовПоСубконто[ЙЙ].Ключ)
    // Объеденить все
    // Выбрать ... из БухОстатки(Счет В МассивСписковСчетовПоСубконто[ЙЙ + 1].Значение, Субконто - МассивСписковСчетовПоСубконто[ЙЙ + 1].Ключ)
    // ...
    ТекстЛевогоСоединения = Новый Массив(2);
    ОСТАТКИ_НОВЫЙ_ГОД = 0; // НЕ ИЗМЕНЯТЬ ЗНАЧЕНИЕ
    ОСТАТКИ_ЗА_ПЕРИОД = 1; // НЕ ИЗМЕНЯТЬ ЗНАЧЕНИЕ
    ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] = "";
    ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] = "";
    ЗапросОбъединитьВсе =
        "
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |";
	ЗапросЛевСоединениеВыбор = 
		"ВЫБРАТЬ
        |    Запрос.КПС,
        |    Запрос.КФО,
        |    Запрос.Счет,
        |    Запрос.Организация,
        |    Запрос.ИФО,
        |    Запрос.Валюта,
        |    Запрос.Подразделение,
        |";
    ЗапросЛевСоединениеРазвернутыеНКОстатки = //НК Начальные/Конечные остатки - Остатки за период
        "ВЫБОР
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
        |		Запрос.СуммаНачальныйРазвернутыйОстатокДт - Запрос.СуммаНачальныйРазвернутыйОстатокКт
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
        |		0
        |	ИНАЧЕ
        |		Запрос.СуммаНачальныйРазвернутыйОстатокДт
        |КОНЕЦ КАК СуммаНачальныйОстатокДт,
        |ВЫБОР
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
        |		0
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
        |		Запрос.СуммаНачальныйРазвернутыйОстатокКт - Запрос.СуммаНачальныйРазвернутыйОстатокДт
        |	ИНАЧЕ
        |		Запрос.СуммаНачальныйРазвернутыйОстатокКт
        |КОНЕЦ КАК СуммаНачальныйОстатокКт,
        |ВЫБОР
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
        |		Запрос.СуммаКонечныйРазвернутыйОстатокДт - Запрос.СуммаКонечныйРазвернутыйОстатокКт
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
        |			0
        |	ИНАЧЕ
        |		Запрос.СуммаКонечныйРазвернутыйОстатокДт
        |КОНЕЦ КАК СуммаКонечныйОстатокДт,
        |ВЫБОР
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
        |		0
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
        |		Запрос.СуммаКонечныйРазвернутыйОстатокКт - Запрос.СуммаКонечныйРазвернутыйОстатокДт
        |	ИНАЧЕ
        |		Запрос.СуммаКонечныйРазвернутыйОстатокКт
        |КОНЕЦ КАК СуммаКонечныйОстатокКт
        |";
        
    ЗапросЛевСоединениеРазвернутыеНГОстатки = // НГ - Новый Год
        "ВЫБОР
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
        |		Запрос.СуммаРазвернутыйОстатокДт - Запрос.СуммаРазвернутыйОстатокКт
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
        |			0
        |	ИНАЧЕ
        |		Запрос.СуммаРазвернутыйОстатокДт
        |КОНЕЦ КАК СуммаОстатокДт,
        |ВЫБОР
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА
        |		0
        |	КОГДА Запрос.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА
        |		Запрос.СуммаРазвернутыйОстатокКт - Запрос.СуммаРазвернутыйОстатокДт
        |	ИНАЧЕ
        |		Запрос.СуммаРазвернутыйОстатокКт
        |КОНЕЦ КАК СуммаОстатокКт
        |";

    ЗапросОстаткиИОборотыЛевСоединениеИз = // Таблица ОстаткиИОбороты
        "ИЗ
        |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
        |	    {(НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ))},
        |	    {(&КонецПериода)},
        |		,
        |		,
        |	    Счет В (&СчетаПоРазвернутомуСальдо) И НЕ Счет.Забалансовый И (&Включать5ХХСчет = ИСТИНА ИЛИ НЕ Счет В ИЕРАРХИИ (&Счета5ХХ)),
        |	    &СубконтоРазвернутый,
        |	    {(КПС).* КАК КПС, (Организация).* КАК Организация, (КФО) КАК КФО";
        
    ЗапросОстаткиЛевСоединениеИз = // Таблица Остатки
        "ИЗ
        |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
        |		{(НАЧАЛОПЕРИОДА(&НачалоПериода, ГОД))},
        |		Счет В (&СчетаПоРазвернутомуСальдо) И НЕ Счет.Забалансовый И (&Включать5ХХСчет = ИСТИНА ИЛИ НЕ Счет В (&Счета5ХХ)),
        |		&СубконтоРазвернутый,
        |		{(КПС).* КАК КПС, (Организация).* КАК Организация, (КФО) КАК КФО";
        
    ЗапросОстаткиЛевСоединениеИзКак = "}) КАК Запрос";
        
    ЗапросКАКВложенныйЗапрос = 
        ") КАК ВложенныйЗапрос
        |";
        
    УсловиеПолеСуммаОстатка = "";
    КолВоСубконто = МассивСписковСчетовПоСубконто.Количество() - 1;
    ЗначПарам = Новый СписокЗначений();
    Для Й = 0 По КолВоСубконто Цикл
        ЙЙ = 0;
        Для каждого Сбк из МассивСписковСчетовПоСубконто[Й] Цикл
                // Объединить все
            Если ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] <> "" Тогда
                ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + ЗапросОбъединитьВсе;
                ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + ЗапросОбъединитьВсе;
            КонецЕсли;
                // Выбор + развернутые поля
            ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД]  = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + ЗапросЛевСоединениеВыбор;
            ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД]  = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + ЗапросЛевСоединениеРазвернутыеНГОстатки;
            ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД]  = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + ЗапросЛевСоединениеВыбор;
            ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД]  = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + ЗапросЛевСоединениеРазвернутыеНКОстатки;
                // Из
            ТекстИзЗаНовГод = ЗапросОстаткиЛевСоединениеИз;
            ТекстИзЗаПериод = ЗапросОстаткиИОборотыЛевСоединениеИз;
            Для ЙЙЙ = 0 По КолВоСубконто - 1 Цикл
                СтрокаСбк = Символы.ВК;
                Если ЙЙЙ < Й Тогда
                    СтрокаСбк = СтрокаСбк + ",Субконто" + Строка(ЙЙЙ + 1);
                    ТекстИзЗаПериод = ТекстИзЗаПериод + ", (Субконто" + Строка(ЙЙЙ + 1) + ").* КАК Субконто" + Строка(ЙЙЙ + 1);
                    ТекстИзЗаНовГод = ТекстИзЗаНовГод + ", (Субконто" + Строка(ЙЙЙ + 1) + ").* КАК Субконто" + Строка(ЙЙЙ + 1);
                Иначе
                    СтрокаСбк = СтрокаСбк + ",NULL";
                КонецЕсли;
                ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + СтрокаСбк + " КАК Субконто" + Строка(ЙЙЙ + 1);
                ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + СтрокаСбк + " КАК Субконто" + Строка(ЙЙЙ + 1);
            КонецЦикла;
                // СчетаПоРазвернутомуСальдо
            Парам = "СчетаПоРазвернутомуСальдо" + Строка(Й) + Строка(ЙЙ);
            ТекстИзЗаНовГод = СтрЗаменить(ТекстИзЗаНовГод, "&СчетаПоРазвернутомуСальдо", "&" + Парам);
            ТекстИзЗаПериод = СтрЗаменить(ТекстИзЗаПериод, "&СчетаПоРазвернутомуСальдо", "&" + Парам);
            Прмтр = СтандартныеОтчеты.СкопироватьПараметрСхемыКомпоновкиДанных(Схема, Парам, "СчетаПоРазвернутомуСальдо", Сбк.Значение[1]);
            Прмтр.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
                // Накапливаем условие для сумм
            Если СтрДлина(УсловиеПолеСуммаОстатка) Тогда
                УсловиеПолеСуммаОстатка = УсловиеПолеСуммаОстатка + " ИЛИ";
            КонецЕсли;
            УсловиеПолеСуммаОстатка = УсловиеПолеСуммаОстатка + " Счет В(&" + Парам + ")";
                // Добавляем счета в параметр РазвернутыеСчета
            Для каждого Сч из Сбк.Значение[1] Цикл
                ЗначПарам.Добавить(Сч);
            КонецЦикла;
                // СубконтоРазвернутый. Если по субконто не разворачиваем, то и не создаем такой параметр
            ЗаменитьНа = "";
            Если Й Тогда
                Парам = "СубконтоРазвернутый" + Строка(Й) +Строка(ЙЙ);
                Прмтр = СтандартныеОтчеты.СкопироватьПараметрСхемыКомпоновкиДанных(Схема, Парам, "СубконтоРазвернутый", Сбк.Значение[0]);
                Прмтр.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
                ЗаменитьНа = "&" + Парам;
            КонецЕсли;
            ТекстИзЗаНовГод = СтрЗаменить(ТекстИзЗаНовГод, "&СубконтоРазвернутый", ЗаменитьНа);
            ТекстИзЗаПериод = СтрЗаменить(ТекстИзЗаПериод, "&СубконтоРазвернутый", ЗаменитьНа);
            
            ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + Символы.ВК + ТекстИзЗаНовГод;
            ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] = ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + ЗапросОстаткиЛевСоединениеИзКак;
            ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + Символы.ВК + ТекстИзЗаПериод;
            ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] = ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + ЗапросОстаткиЛевСоединениеИзКак;
            ЙЙ = ЙЙ + 1;
        КонецЦикла;
    КонецЦикла;
	
	// Если не указано ни одного развернутого сальдо
    Если ПустаяСтрока(ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД]) Тогда
        Возврат;
    КонецЕсли;
    СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "РазвернутыеСчета", ЗначПарам);

    // Вставляем полученные запросы в основной текст
    Запрос = Схема.НаборыДанных.НаборДанных1.Запрос;

	// Добавляем Объединить все к запросу ОстаткиНГ из накопленного запроса ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД]
    ПоместитьОстаткиНГ = "ПОМЕСТИТЬ ОстаткиНГ";
    ПозОстаткиНГ = Найти(Запрос, ПоместитьОстаткиНГ);
    ПозВыбирать = ПозОстаткиНГ;
    ВЫБРАТЬ = "ВЫБРАТЬ";
    Пока Сред(Запрос, ПозВыбирать, СтрДлина(ВЫБРАТЬ)) <>  ВЫБРАТЬ Цикл
        ПозВыбирать = ПозВыбирать - 1;
    КонецЦикла; 
    СтрПоляОстаткиНГ = Сред(Запрос, ПозВыбирать, ПозОстаткиНГ - ПозВыбирать);
    СтрПоляОстаткиНГ = СтрЗаменить(СтрПоляОстаткиНГ, "ОстаткиНГ", "ВложенныйЗапрос");
    СтрПоляОстаткиНГ = СтрЗаменить(СтрПоляОстаткиНГ, "РАЗРЕШЕННЫЕ", "");
    СтрПоляОстаткиНГ = СтрЗаменить(СтрПоляОстаткиНГ, "ВложенныйЗапрос.КЭК", "&КЭК0");
	
	СтрПоляОстаткиНГ = СтрПоляОстаткиНГ + Символы.ВК + "ИЗ (" + Символы.ВК;
        // Запросу ОстаткиНГ ставим условие И НЕ(Счет В {(&Счета..) ИЛИ ...}) - УсловиеПолеСуммаОстатка
        // Третья запятая
    ПозицияПоместить = ПозОстаткиНГ + Найти(Сред(Запрос, ПозОстаткиНГ), "}") + 2;
    ПозицияПоместить = ПозицияПоместить + Найти(Сред(Запрос, ПозицияПоместить), ",") - 1;
	
	Запрос = Лев(Запрос, ПозицияПоместить - 1) + " И НЕ(" + УсловиеПолеСуммаОстатка + ")" + Сред(Запрос, ПозицияПоместить);
		// ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] добавляем в запрос ПОМЕСТИТЬ ОстаткиНГ
	ПозицияПоместить = Найти(Запрос, ПоместитьОстаткиНГ);
	ПозицияКонцаЗапроса = ПозицияПоместить + Найти(Сред(Запрос, ПозицияПоместить), ";") - 1;
	    // Вставляем Вложенный запрос как Объединить все
	НачалоЗапроса = Лев(Запрос, ПозицияКонцаЗапроса - 1);
	КонецЗапроса = Сред(Запрос, ПозицияКонцаЗапроса);
		// Между ними вставляем наше левое соединение
		
	Запрос = НачалоЗапроса + 
	ЗапросОбъединитьВсе +
	СтрПоляОстаткиНГ + ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] + ЗапросКАКВложенныйЗапрос + КонецЗапроса;
    
    // ОСТАТКИ_ЗА_ПЕРИОД
        // Добавляем Объединить все к запросу ОстаткиНГ из накопленного запроса ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД]
    ПозОстаткиНГ = Найти(Запрос, "ПОМЕСТИТЬ ОстаткиНПКП");
    ПозВыбирать = ПозОстаткиНГ;
    ВЫБРАТЬ = "ВЫБРАТЬ";
    Пока Сред(Запрос, ПозВыбирать, СтрДлина(ВЫБРАТЬ)) <>  ВЫБРАТЬ Цикл
        ПозВыбирать = ПозВыбирать - 1;
    КонецЦикла; 
    СтрПоляОстаткиНГ = Сред(Запрос, ПозВыбирать, ПозОстаткиНГ - ПозВыбирать);
    СтрПоляОстаткиНГ = СтрЗаменить(СтрПоляОстаткиНГ, "ОстаткиНПКП", "ВложенныйЗапрос");
    СтрПоляОстаткиНГ = СтрЗаменить(СтрПоляОстаткиНГ, "РАЗРЕШЕННЫЕ", "");
	СтрПоляОстаткиНГ = СтрЗаменить(СтрПоляОстаткиНГ, "ВложенныйЗапрос.КЭК", "&КЭК0");

    СтрПоляОстаткиНГ = СтрПоляОстаткиНГ + Символы.ВК + "ИЗ (" + Символы.ВК;
        // Запросу ОстаткиНГ ставим условие И НЕ(Счет В {(&Счета..) ИЛИ ...}) - УсловиеПолеСуммаОстатка
        // 7 запятая
    ПозицияПоместить = ПозОстаткиНГ;
    Для Й = 1 По 6 Цикл
        ПозицияПоместить = ПозицияПоместить + Найти(Сред(Запрос, ПозицияПоместить + 1), ",");
    КонецЦикла;
    Запрос = Лев(Запрос, ПозицияПоместить - 1) + " И НЕ(" + УсловиеПолеСуммаОстатка + ")" + Сред(Запрос, ПозицияПоместить);
        // ТекстЛевогоСоединения[ОСТАТКИ_НОВЫЙ_ГОД] добавляем в запрос ПОМЕСТИТЬ ОстаткиНГ
    ПозицияПоместить = Найти(Запрос, "ПОМЕСТИТЬ ОстаткиНПКП");
    ПозицияКонцаЗапроса = ПозицияПоместить + Найти(Сред(Запрос, ПозицияПоместить), ";") - 1;
        // Вставляем Вложенный запрос как Объединить все
    НачалоЗапроса = Лев(Запрос, ПозицияКонцаЗапроса - 1);
    КонецЗапроса = Сред(Запрос, ПозицияКонцаЗапроса);
        // Между ними вставляем наше левое соединение
		
	Запрос = НачалоЗапроса + 
	ЗапросОбъединитьВсе +
	СтрПоляОстаткиНГ + ТекстЛевогоСоединения[ОСТАТКИ_ЗА_ПЕРИОД] + ЗапросКАКВложенныйЗапрос + КонецЗапроса;
    
    Схема.НаборыДанных.НаборДанных1.Запрос = Запрос;
    
КонецПроцедуры

Функция ПолучитьМакетЭталоннойГруппировки()
    Для каждого МакетГруппировки из СхемаКомпоновкиДанных.МакетыГруппировок Цикл
        Если
            МакетГруппировки.ИмяГруппировки = "Эталон" И
            МакетГруппировки.ТипМакета = ТипМакетаОбластиКомпоновкиДанных.Заголовок
        Тогда
            Возврат МакетГруппировки.Макет;
        КонецЕсли
    КонецЦикла;
    
    Возврат "Ошибка";
    
КонецФункции

Процедура УстановитьПараметрМакета(МассивЧтоЕсть, Поле, Значение, Макет, Эталон)
    
    Если МассивЧтоЕсть.Найти(Поле) = Неопределено Тогда
        Если Макет.Параметры.Найти(Поле) <> Неопределено Тогда
            Макет.Параметры[Поле].Выражение = Значение;
        Иначе
            Макет.Параметры[Поле].Выражение = Эталон.Параметры[Поле].Выражение;
        КонецЕсли
    Иначе
        Макет.Параметры[Поле].Выражение = Эталон.Параметры[Поле].Выражение;
    КонецЕсли;
    
КонецПроцедуры

