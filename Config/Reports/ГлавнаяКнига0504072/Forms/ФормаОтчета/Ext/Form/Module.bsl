
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтандартныеОтчеты.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
	ДобавитьГруппировкуЕПСБУ("Счет");
	ДобавитьГруппировкуЕПСБУ("КФО");
	ДобавитьГруппировкуЕПСБУ("КПС");
	ДобавитьГруппировкуЕПСБУ("КЭК");
	ДобавитьГруппировкуЕПСБУ("ЖурналОпераций", "Номер журнала операций");
	ВыводитьЗаголовок = Истина;
	ВыводитьПодвал = Истина;
	Если НЕ Отчет.РежимРасшифровки Тогда
		Отчет.НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
		Отчет.КонецПериода  = КонецМесяца(ТекущаяДатаСеанса());
		Отчет.Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
		Если ЗначениеЗаполнено(Отчет.Организация) Тогда
			Бух = ПолучитьОтветственноеЛицоОрганизации(Отчет.Организация, "ГлавныйБухгалтер");
			Отчет.ГлавБух = Бух.ОтветственноеЛицоСсылка;
		КонецЕсли;
	КонецЕсли;

	УправлениеФормой(ЭтаФорма);
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СтандартныеОтчетыКлиент.ПриОткрытии(ЭтаФорма);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	Отчет.ПоказательБУ = Истина;
	СформироватьОтчет(Ложь);
	
	РассчитатьПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	ВариантМодифицирован                    = Ложь;
	ПользовательскиеНастройкиМодифицированы = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	СтандартныеОтчеты.ПриСохраненииПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
	СтандартныеОтчеты.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	
	ИзменениеСхемыКомпоновкиДанных();
	
	ЭтаФорма.Элементы.Подразделение.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	УправлениеФормой(ЭтаФорма);
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);
	
КонецПроцедуры


#КонецОбласти

