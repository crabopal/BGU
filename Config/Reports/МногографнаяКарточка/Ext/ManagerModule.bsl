Процедура ПослеВыводаРезультата(ПараметрыОтчета, Результат) Экспорт
	
	Если ПараметрыОтчета.ВыводитьОстатки Тогда
		ПрименитьМаркерыОбработки(ПараметрыОтчета, Результат);
		Возврат;
	КонецЕсли;
	
	// Область "Дебет/Кредит" в шапке начинается с 5го столбца
	НомерПоследнегоСтолбца = 5;
	НомерСтроки = Результат.Области.Заголовок.Низ + 1;
	Пока Результат.Область(НомерСтроки, НомерПоследнегоСтолбца, НомерСтроки, НомерПоследнегоСтолбца).Текст = "QQ" Цикл
		НомерПоследнегоСтолбца = НомерПоследнегоСтолбца + 1;
	КонецЦикла;
	
	Если НомерПоследнегоСтолбца > 5 Тогда
		ОбластьТекстаДК = Результат.Область(НомерСтроки, 5, НомерСтроки, НомерПоследнегоСтолбца - 1);
		ОбластьТекстаДК.Объединить();
		ОбластьТекстаДК.Текст = ?(ПараметрыОтчета.КорДебет = Истина, "Кредит счёта ", "Дебет счёта ") + ПараметрыОтчета.Счет.Код;
	КонецЕсли
	
КонецПроцедуры

