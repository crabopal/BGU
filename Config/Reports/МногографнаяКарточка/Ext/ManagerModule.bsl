		Истина, Истина, Истина, Истина, Истина, Истина, Истина, Истина, Истина);
	
КонецФункции

Процедура ПриВыводеЗаголовка(ПараметрыОтчета, КомпоновщикНастроек, Результат) Экспорт
	Макет = ПолучитьМакет("МакетФиксированныхОбластей");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок.Параметры.ДатаОтчета = Формат(КонецДня(ПараметрыОтчета.КонецПериода) + 1, "ДЛФ=Д");
	ОбластьЗаголовок.Параметры.Организация = ПараметрыОтчета.Организация.НаименованиеПолное;
	ОбластьЗаголовок.Параметры.ОКПО = ПараметрыОтчета.Организация.КодОКПО;
	ОбластьЗаголовок.Параметры.НомерКарточки = ПараметрыОтчета.НомерКарточки;
	ОбластьЗаголовок.Параметры.Подразделение = ПараметрыОтчета.Подразделение;
	ОбластьЗаголовок.Параметры.ВыбСчет = ПараметрыОтчета.Счет;
	Попытка
		ОбластьЗаголовок.Параметры.СтрокаПериода = ПредставлениеПериода(НачалоДня(ПараметрыОтчета.НачалоПериода), КонецДня(ПараметрыОтчета.КонецПериода), "ФП");
	Исключение
	КонецПопытки;
	
	Результат.Вывести(ОбластьЗаголовок);
	
	Если ПараметрыОтчета.ВыводитьПолностью Тогда
		СтандартныеОтчеты.ВыводитьОтбор(Результат, КомпоновщикНастроек, "Организация");
	КонецЕсли;
	
	Результат.Область("R1:R" + Результат.ВысотаТаблицы).Имя = "Заголовок";
	Результат.Области.Заголовок.Видимость = ПараметрыОтчета.ВыводитьЗаголовок;
	
КонецПроцедуры

Процедура ПриВыводеПодвала(ПараметрыОтчета, КомпоновщикНастроек, Результат) Экспорт
    
    Макет = ПолучитьМакет("МакетФиксированныхОбластей");
    ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	СтруктураПодвала = Новый Структура;
	СтруктураПодвала.Вставить("ГлавБух", Корреспонденты.ФИОПоОбъекту(ПараметрыОтчета.ГлавБух,, ТекущаяДатаСеанса()));
	СтруктураПодвала.Вставить("ТекущаяДата", Формат(ТекущаяДатаСеанса(), "ДЛФ=ДДММММГГГГ")); 
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.Исполнитель) Тогда
		
		ДанныеСотрудника = Новый Структура;
		ДанныеСотрудника.Вставить("СсылкаНаОбъект", ПараметрыОтчета.Исполнитель); 
		ДанныеСотрудника.Вставить("Период", ТекущаяДатаСеанса());
		ДанныеСотрудника.Вставить("Фамилия", "");
		ДанныеСотрудника.Вставить("Имя", "");
		ДанныеСотрудника.Вставить("Отчество", "");
		ДанныеСотрудника.Вставить("Должность", "");
		
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, Истина);
		
		СтруктураПодвала.Вставить("Исполнитель", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника));
		СтруктураПодвала.Вставить("ИсполнительДолжность", ДанныеСотрудника.Должность); 
		СтруктураПодвала.Вставить("ТелефонИсполнителя", ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
		СтруктураПодвала.Вставить("ЭлектроннаяПочтаИсполнителя", ДанныеСотрудника.EmailФизическиеЛица); 
		
	КонецЕсли;	
	
	ОбластьПодвал.Параметры.Заполнить(СтруктураПодвала);
	
	Высота = Результат.ВысотаТаблицы + 1;
    Результат.Вывести(ОбластьПодвал);
    Результат.Область(Высота, ,Результат.ВысотаТаблицы,).Имя = "Подписи";
	
	Результат.Области.Подписи.Видимость = ПараметрыОтчета.ВыводитьПодвал;
    
КонецПроцедуры

Функция ПолучитьТекстЗаголовка(ПараметрыОтчета, ОрганизацияВНачале = Истина) Экспорт 
	
	Возврат "Многографная карточка "
		+ ПараметрыОтчета.Счет
		+ СтандартныеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(ПараметрыОтчета.НачалоПериода, ПараметрыОтчета.КонецПериода);
	
КонецФункции

Процедура ПрименитьМаркерыОбработки(ПараметрыОтчета, Результат, Знач ТекстПоиска = "@МаркерОбработки")
	
	Область = Результат.НайтиТекст(ТекстПоиска);
	Если Область <> Неопределено Тогда
		
		ИсходныйТекстКоманды = Область.Текст;
		ТекстКоманды  = СтрЗаменить(Область.Текст,ТекстПоиска+"_","");
		Область.Текст = "";
		МассивКоманд  = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстКоманды,"_");
		
		Для каждого КомандаОбработки Из МассивКоманд Цикл
			
			ПараметрыКомандыОбработки = Новый Массив;
			ПозицияПараметров = Найти(КомандаОбработки,"&");
			Если ПозицияПараметров <> 0 Тогда
				ПараметрыКомандыОбработки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Сред(КомандаОбработки,ПозицияПараметров+1),"&");
				КомандаОбработки = Лев(КомандаОбработки,ПозицияПараметров-1);
			КонецЕсли;
			
			Если КомандаОбработки = "КонецСтраницы" Тогда
				
				ОбластьОбработки = Результат.Область("R"+Формат(Область.Низ,"ЧГ=0"));
				ОбластьОбработки.КонецСтраницы = Истина;
				
			ИначеЕсли КомандаОбработки = "НачалоСтраницы" Тогда
				
				ОбластьОбработки = Результат.Область("R"+Формат(Область.Низ,"ЧГ=0"));
				ОбластьОбработки.НачалоСтраницы = Истина;
				
			ИначеЕсли КомандаОбработки = "УдалитьСтроку" Тогда
				
				ОбластьОбработки = Результат.Область("R"+Формат(Область.Низ,"ЧГ=0"));
				Результат.УдалитьОбласть(ОбластьОбработки,ТипСмещенияТабличногоДокумента.ПоВертикали);
				
			ИначеЕсли КомандаОбработки = "Очистить" Тогда
				
				ОбластьОбработки = Результат.Область("R"+Формат(Область.Низ,"ЧГ=0"));
				ОбластьОбработки.Очистить(Истина,Истина,Истина);
				
			ИначеЕсли КомандаОбработки = "ВставитьЗаголовок" Тогда
				
				ОбластьОбработки = Результат.Область("R"+Формат(Область.Низ,"ЧГ=0"));
				
				ОбластьНачало       = Результат.НайтиТекст("@НачалоЗаголовка");
				ОбластьНачало.Текст = СтрЗаменить(ОбластьНачало.Текст,"@НачалоЗаголовка","");
				ОбластьКонец        = Результат.НайтиТекст("@КонецЗаголовка");
				ОбластьКонец.Текст  = СтрЗаменить(ОбластьКонец.Текст,"@КонецЗаголовка","");
				
				ОбластьЗаголовка    = Результат.Область("R"+Формат(ОбластьНачало.Верх,"ЧГ=0")+":R"+Формат(ОбластьКонец.Низ,"ЧГ=0"));
				
				Результат.ВставитьОбласть(ОбластьЗаголовка,ОбластьОбработки,ТипСмещенияТабличногоДокумента.ПоВертикали);
				
				ОбластьУдаления = Результат.Область("R"+Формат((ОбластьОбработки.Низ+ОбластьЗаголовка.Низ-ОбластьЗаголовка.Верх+1),"ЧГ=0"));
				Результат.УдалитьОбласть(ОбластьУдаления,ТипСмещенияТабличногоДокумента.ПоВертикали);
				
				Для НомСтр = ОбластьЗаголовка.Верх По ОбластьЗаголовка.Низ Цикл
					Для НомКол = 1 По Результат.ШиринаТаблицы Цикл
						ОбластьЗамены = Результат.Область(НомСтр,НомКол);
						Если СокрЛП(ОбластьЗамены.Текст) = "Таблица" Тогда
							ОбластьЗамены.Текст = "Дебет счёта " + ПараметрыОтчета.Счет;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
				
				Для НомСтр = ОбластьОбработки.Верх По ОбластьОбработки.Низ Цикл
					Для НомКол = 1 По Результат.ШиринаТаблицы Цикл
						ОбластьЗамены = Результат.Область(НомСтр,НомКол);
						Если СокрЛП(ОбластьЗамены.Текст) = "Таблица" Тогда
							ОбластьЗамены.Текст = "Кредит счёта " + ПараметрыОтчета.Счет;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
				
			ИначеЕсли КомандаОбработки = "ОбъединитьОбластьПоСтроке" Тогда
				
				НомСтр = Область.Верх;
				НомКол = Область.Лево + 1;
				Пока НомКол <= Результат.ШиринаТаблицы Цикл
                    Если 
                        Результат.Область(НомСтр,НомКол).Текст <> ИсходныйТекстКоманды И
                        НЕ ПустаяСтрока(Результат.Область(НомСтр,НомКол).Текст)
                    Тогда
						Прервать;
					КонецЕсли;
					НомКол = НомКол + 1;
				КонецЦикла;
				
				ОбластьОбработки = Результат.Область(НомСтр,Область.Лево,НомСтр,НомКол-1);
				ОбластьОбработки.Объединить();
				
				Для каждого ПараметрКомандыОбработки Из ПараметрыКомандыОбработки Цикл
					ОбластьОбработки.Текст = ОбластьОбработки.Текст + " " + ПараметрКомандыОбработки;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ПрименитьМаркерыОбработки(ПараметрыОтчета, Результат,ТекстПоиска);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьОтчетФ(ПараметрыОтчета, АдресХранилища) Экспорт
	
	НомерПоПорядку = 1;
	СтандартныеОтчеты.ВывестиОтчетФ(ПараметрыОтчета, АдресХранилища);
	
КонецПроцедуры

Процедура НомерПоПорядку(Номер = 1) Экспорт
	НомерПоПорядку = Номер;
КонецПроцедуры

#Область ОтчетСОстатками

// Редактирование структуры настроек

Функция ПолучитьЭлементСтруктурыНастроекПоТипу(СтруктураНастроек,Тип) Экспорт
	
	Если ТипЗнч(Тип) <> Тип("Тип") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для каждого ЭлементСтруктуры Из СтруктураНастроек Цикл
		Если ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
			Возврат ЭлементСтруктуры;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьЭлементСтруктурыНастроекПоИмени(СтруктураНастроек,Имя) Экспорт
	
	Элемент = Неопределено;
	
	Для каждого ЭлементСтруктуры Из СтруктураНастроек Цикл
		Если ЭлементСтруктуры.Имя = Имя Тогда
			Возврат ЭлементСтруктуры;
		ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
			Элемент = ПолучитьЭлементСтруктурыНастроекПоИмени(ЭлементСтруктуры.Строки,Имя);
			Если Элемент = Неопределено Тогда
				Элемент = ПолучитьЭлементСтруктурыНастроекПоИмени(ЭлементСтруктуры.Колонки,Имя);
			КонецЕсли;
			Если Элемент <> Неопределено Тогда
				Возврат Элемент;
			КонецЕсли;
		Иначе
			Элемент = ПолучитьЭлементСтруктурыНастроекПоИмени(ЭлементСтруктуры.Структура,Имя);
			Если Элемент <> Неопределено Тогда
				Возврат Элемент;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Элемент;
	
КонецФункции

Процедура НайтиЭлементНастроекКДвКоллекции(ПолеГруппировки, Знач КоллекцияЭлементов, ИмяРеквизитаЭлемента, ИмяПоля)
	Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	
	Для каждого ТекПолеГруппировки Из КоллекцияЭлементов Цикл
		Если ТипЗнч(ТекПолеГруппировки) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			НайтиЭлементНастроекКДвКоллекции(ПолеГруппировки, ТекПолеГруппировки.Элементы, 
											ИмяРеквизитаЭлемента, ИмяПоля);
			Если ПолеГруппировки <> Неопределено Тогда
				Прервать;	
			Иначе
				Продолжить;
			КонецЕсли;	
		ИначеЕсли НЕ ТекПолеГруппировки.Использование Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ТекПолеГруппировки[ИмяРеквизитаЭлемента] = Поле Тогда
			ПолеГруппировки = ТекПолеГруппировки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиЭлементНастроекКД(Знач КомпоновщикНастроек,Знач ИмяГруппировки = "",Знач ИмяСвойстваНастроекКД = "",Знач ИмяРеквизитаЭлемента,Знач ИмяПоля) Экспорт
	
	ПолеГруппировки = Неопределено;
	
	Если ПустаяСтрока(ИмяСвойстваНастроекКД) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяГруппировки) Тогда
		ГруппировкаКД = КомпоновщикНастроек.Настройки;
	Иначе
		ГруппировкаКД = ПолучитьЭлементСтруктурыНастроекПоИмени(КомпоновщикНастроек.Настройки.Структура,ИмяГруппировки);
	КонецЕсли;
	
	Если ГруппировкаКД <> Неопределено Тогда
		НайтиЭлементНастроекКДвКоллекции(ПолеГруппировки, ГруппировкаКД[ИмяСвойстваНастроекКД].Элементы, 
											ИмяРеквизитаЭлемента, ИмяПоля);
	КонецЕсли;
	
	Возврат ПолеГруппировки;
	
КонецФункции

Процедура ПередКомпоновкойМакетаСОстатками(ПараметрыОтчета, Схема, КомпоновщикНастроек)
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Счет", ПараметрыОтчета.Счет);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВидСчета", ПараметрыОтчета.Счет.Вид);
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.НачалоПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода", НачалоДня(ПараметрыОтчета.НачалоПериода));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета.КонецПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода", Бухгалтерскийучет.КонецПериодаСУточнением(КонецДня(ПараметрыОтчета.КонецПериода), ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ЗаключениеСчетов")));
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериодаДата", ПараметрыОтчета.КонецПериода);
	КонецЕсли;
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Корреспонденции", ПараметрыОтчета.Корреспонденции);
	Попытка
		Корр = Число(ПараметрыОтчета.Корреспонденции) - 1;
	Исключение
		Корр = -1;
	КонецПопытки;
	Если Корр >= 0 Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВидАналитикиОборотноеСубконто", ПараметрыОтчета.Счет.ВидыСубконто[Корр].ТолькоОбороты);
	КонецЕсли;
	
	МассивПоказателей = Новый Массив;
	МассивПоказателей.Добавить("БУ");
	
	//
	// Заполнение группировок в настройках отчета
	
	// Включается группировка по учреждению если нет отбора по учреждений
	ГруппироватьПоУчреждениям = Ложь;
	ОтборУчреждение = НайтиЭлементНастроекКД(КомпоновщикНастроек,"","Отбор","ЛевоеЗначение","Организация");
	Если (ОтборУчреждение <> Неопределено) И ЗначениеЗаполнено(ОтборУчреждение.ПравоеЗначение) Тогда
		ГруппировкаУчреждение = ПолучитьЭлементСтруктурыНастроекПоИмени(КомпоновщикНастроек.Настройки.Структура,"Организация");
		ГруппировкаТБ = ПолучитьЭлементСтруктурыНастроекПоИмени(КомпоновщикНастроек.Настройки.Структура,"ТБ");
		Если ГруппировкаУчреждение <> Неопределено И ГруппировкаТБ <> Неопределено И ГруппировкаТБ.Родитель = ГруппировкаУчреждение Тогда
			ГруппировкаТБНовая = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ТаблицаКомпоновкиДанных"));
			ЗаполнениеОтчетностиСервер.СкопироватьНастройкиКомпоновкиДанных(ГруппировкаТБНовая,ГруппировкаТБ);
			ГруппировкаУчреждение.Структура.Очистить();
			ГруппировкаУчреждение.Использование = Ложь;
		КонецЕсли;
	ИначеЕсли ГруппироватьПоУчреждениям Тогда
		ГруппировкаУчреждение = ПолучитьЭлементСтруктурыНастроекПоИмени(КомпоновщикНастроек.Настройки.Структура,"Учреждение");
		ГруппировкаТБ = ПолучитьЭлементСтруктурыНастроекПоИмени(КомпоновщикНастроек.Настройки.Структура,"ТБ");
		Если ГруппировкаУчреждение <> Неопределено И ГруппировкаТБ <> Неопределено И ГруппировкаТБ.Родитель <> ГруппировкаУчреждение Тогда
			ГруппировкаУчреждение.Использование = Истина;
			ГруппировкаТБНовая = ГруппировкаУчреждение.Структура.Добавить(Тип("ТаблицаКомпоновкиДанных"));
			ЗаполнениеОтчетностиСервер.СкопироватьНастройкиКомпоновкиДанных(ГруппировкаТБНовая,ГруппировкаТБ);
			ГруппировкаТБ.Родитель.Структура.Удалить(ГруппировкаТБ);
		КонецЕсли;
	КонецЕсли;
	
	// Включение группировок и их взаимное подчинение. Все группировки подчинены группировке "Таблица".
	
	КореньНастроек = КомпоновщикНастроек.Настройки.Структура;
	РодительскаяГруппировка = ПолучитьЭлементСтруктурыНастроекПоИмени(КомпоновщикНастроек.Настройки.Структура,"Таблица");
	ГруппировкаСтрока = ПолучитьЭлементСтруктурыНастроекПоИмени(КомпоновщикНастроек.Настройки.Структура,"ДетальныеЗаписи");
	ШаблонГруппировки = ПолучитьЭлементСтруктурыНастроекПоИмени(КомпоновщикНастроек.Настройки.Структура,"ШаблонГруппировки");
	
	// Изначально у группировки "Таблица" нет подчиненных группировок.
	РодительскаяГруппировка.Структура.Очистить();
	
	НомерГруппировки = 1;
	Для каждого ГруппировкаОтчета Из ПараметрыОтчета.Группировка Цикл
		
		Если ГруппировкаОтчета.Использование Тогда
				
			НоваяГруппировка = РодительскаяГруппировка.Структура.Добавить();
			Если ГруппировкаОтчета.Поле <> Неопределено Тогда // Это шаблон
				ЗаполнениеОтчетностиСервер.СкопироватьНастройкиКомпоновкиДанных(НоваяГруппировка, ШаблонГруппировки);
				НоваяГруппировка.ПоляГруппировки.Элементы.Очистить();
				НовоеПолеГруппировки = НоваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
				НовоеПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ГруппировкаОтчета.Поле);
				НоваяГруппировка.Имя = "Группировка" + НомерГруппировки;
					// устанавливаем макет для группировки
				Для каждого МакетГруппировки из Схема.МакетыГруппировок Цикл
					Если МакетГруппировки.ИмяГруппировки = "Группировка" + НомерГруппировки Тогда
						Макет = Схема.Макеты.Найти(МакетГруппировки.Макет);
						Макет.Параметры.ПолеГруппировки.Выражение = "Представление(" + ГруппировкаОтчета.Поле + ")";
						Прервать;
					КонецЕсли;
				КонецЦикла;
				НомерГруппировки = НомерГруппировки + 1;
				Если ГруппировкаОтчета.ТипГруппировки = 0 Тогда
					НовоеПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
				ИначеЕсли ГруппировкаОтчета.ТипГруппировки = 1 Тогда
					НовоеПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
				Иначе
					НовоеПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.ТолькоИерархия;
				КонецЕсли;
			Иначе
				ЗаполнениеОтчетностиСервер.СкопироватьНастройкиКомпоновкиДанных(НоваяГруппировка,ГруппировкаСтрока);
			КонецЕсли;
			НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			НоваяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
			НоваяГруппировка.Использование = ГруппировкаОтчета.Использование;
			РодительскаяГруппировка = НоваяГруппировка;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НоваяГруппировка = РодительскаяГруппировка.Структура.Добавить();
	ЗаполнениеОтчетностиСервер.СкопироватьНастройкиКомпоновкиДанных(НоваяГруппировка,ГруппировкаСтрока);
	НоваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	НоваяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	НоваяГруппировка.Использование = Истина;
	
	// Да/Нет сворачивать проводки
	стрРегистратор = "Регистратор";
	ПолучитьПолеКД(НоваяГруппировка.Выбор.Элементы, Новый ПолеКомпоновкиДанных(стрРегистратор)).Использование = ПараметрыОтчета.НеСворачиватьПроводки;
	ПолучитьПолеКД(НоваяГруппировка.Выбор.Элементы, Новый ПолеКомпоновкиДанных("НомерСтроки")).Использование = ПараметрыОтчета.НеСворачиватьПроводки;
	ПолучитьПолеКД(НоваяГруппировка.ПоляГруппировки.Элементы, Новый ПолеКомпоновкиДанных(стрРегистратор)).Использование = ПараметрыОтчета.НеСворачиватьПроводки;
	
	Для каждого МГ Из Схема.МакетыГруппировок Цикл
		Если МГ.ИмяГруппировки = "ДетальныеЗаписи" И МГ.ТипМакета = ТипМакетаОбластиКомпоновкиДанных.Заголовок Тогда
			// Схема.Макеты["Макет4"].Параметры["Р"].ВыраженияПолей.ПараметрыДанных.Счет.Поле
			ВП = Схема.Макеты[МГ.Макет].Параметры["Р"].ВыраженияПолей;
			ЭВП = ВП.Найти(стрРегистратор);
			Если ЭВП = Неопределено Тогда
				Если ПараметрыОтчета.НеСворачиватьПроводки Тогда
					Выражение = ВП.Добавить();
					Выражение.Выражение = стрРегистратор;
					Выражение.Поле = стрРегистратор;
				КонецЕсли;
			Иначе
				Если НЕ ПараметрыОтчета.НеСворачиватьПроводки Тогда
					ВП.Удалить(ЭВП);
				КонецЕсли;
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// ----------------------------------------------------------------------------
Функция ПолучитьПолеКД(Коллекция, Поле)

	Для Индекс = 0 По Коллекция.Количество() Цикл
		Если Коллекция[Индекс].Поле = Поле Тогда
			Возврат Коллекция[Индекс];
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

// В процедуре можно доработать компоновщик перед выводом в отчет
// Изменения сохранены не будут
Процедура ПередКомпоновкойМакета(ПараметрыОтчета, Схема, КомпоновщикНастроек) Экспорт
	
		// Почему-то при переключении настроек не перезаполняются поля выбора
		// Поэтому берем поля из настроек по умолчанию
	КомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();
	Для Каждого й из Схема.НастройкиПоУмолчанию.Выбор.Элементы Цикл
		Поле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(Поле, й);
	КонецЦикла;
	
	Если ПараметрыОтчета.ВыводитьОстатки Тогда
		ПередКомпоновкойМакетаСОстатками(ПараметрыОтчета, Схема, КомпоновщикНастроек);
		Возврат;
	КонецЕсли;
	
	// КомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Счет", ПараметрыОтчета.Счет);
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.НачалоПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода", НачалоДня(ПараметрыОтчета.НачалоПериода));
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета.КонецПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода", Бухгалтерскийучет.КонецПериодаСУточнением(КонецДня(ПараметрыОтчета.КонецПериода), ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ЗаключениеСчетов")));
	КонецЕсли;
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаОтчета", Формат(КонецДня(ПараметрыОтчета.КонецПериода) + 1, "ДЛФ=Д"));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "СтрокаПериода", ПредставлениеПериода(НачалоДня(ПараметрыОтчета.НачалоПериода), КонецДня(ПараметрыОтчета.КонецПериода), "ФП"));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыбОрганизация", ПараметрыОтчета.Организация.НаименованиеПолное);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ОКПО", ПараметрыОтчета.Организация.КодОКПО);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВыбПодразделение", ПараметрыОтчета.Подразделение);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Счет", ПараметрыОтчета.Счет);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПоДтКт", ?(ПараметрыОтчета.КорДебет, "Кт", "Дт"));
		
	МассивПоказателей = Новый Массив;
	МассивПоказателей.Добавить("БУ");
	
		// Меняем структуру настроек таблицы
		
	Структура = КомпоновщикНастроек.Настройки.Структура[0];
	Структура.Имя = "ТаблицаДт";
	Колонки = Структура.Колонки;
	Строки  = Структура.Строки;
	
		// Строки
	Строки.Очистить();
	Структура = Строки.Добавить();
	ИмяГруппировки = "";
	НомерГруппировки = 1;
	Для каждого ГруппировкаОтчета из ПараметрыОтчета.Группировка Цикл
		Если ГруппировкаОтчета.Использование Тогда
			ДобавитьГруппировку(Структура, ГруппировкаОтчета.Поле);
			Структура.Имя = "Группировка" + НомерГруппировки;
			НомерГруппировки = НомерГруппировки + 1;
			Если ИмяГруппировки = "" Тогда
				ИмяГруппировки = Структура.Имя;
			КонецЕсли;
			Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
			// СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Структура.Отбор, "ДтКт", ?(ЙЙ = 0, "Дт", "Кт"));
			// СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(Структура, "ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
				// Ставим, что выводить в параметр
			Для каждого МакетГруппировки из Схема.МакетыГруппировок Цикл
				Если МакетГруппировки.ИмяГруппировки = Структура.Имя И МакетГруппировки.ТипМакета = ТипМакетаОбластиКомпоновкиДанных.Заголовок Тогда
					МакетДляИзменения = Схема.Макеты.Найти(МакетГруппировки.Макет);
					МакетДляИзменения.Параметры[Структура.Имя].Выражение = "Представление(" + ГруппировкаОтчета.Поле + ")";
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Структура = Структура.Структура.Добавить();
			
		КонецЕсли;
	КонецЦикла;
	
	Если ПараметрыОтчета.НеСворачиватьПроводки Тогда
		ПолеГруппировки = Структура.ПоляГруппировки.Элементы.Добавить(Тип("АвтоПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Использование  = Истина;
	Иначе
		ДобавитьГруппировку(Структура, "Дата");
		ДобавитьГруппировку(Структура, "Номер");
		ДобавитьГруппировку(Структура, "Содержание");
	КонецЕсли;
	
	Структура.Имя = "ШапкаКор";
	Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	// ЗначениеОтбора = СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Структура.Отбор, "ДтКт", ?(ЙЙ = 0, "Дт", "Кт"));
	
	Если ИмяГруппировки = "" Тогда
		ИмяГруппировки = Структура.Имя;
	КонецЕсли;
	Схема.МакетыЗаголовковГруппировок[0].ИмяГруппировки = ИмяГруппировки; // Заголовок
	Схема.МакетыЗаголовковГруппировок[1].ИмяГруппировки = ИмяГруппировки; // Подвал
	
		// Колонки
	Колонки.Очистить();
	Измерение = Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.Измерения.Найти(ПараметрыОтчета.Корреспонденции);
	Структура = Колонки.Добавить();
	Структура.Имя = "Корреспонденции";
	ПолеГруппировки = Структура.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Использование  = Истина;
	ИмяПоля = "";
	Если Измерение <> Неопределено Тогда
		ИмяПоля = ПараметрыОтчета.Корреспонденции;
		Если НЕ Измерение.Балансовый Тогда
			// ИмяПоля = ?(КорДебет, "Кор", "") + ИмяПоля;
			ИмяПоля = ИмяПоля;
		КонецЕсли;
	Иначе
		// Субконто
		// ИмяПоля = ?(КорДебет, "Кор", "") + "Субконто"+ Корреспонденции;
		ИмяПоля = "Субконто"+ ПараметрыОтчета.Корреспонденции;
	КонецЕсли;
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	//Кор_ция = Структура.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	//Кор_ция.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
		// устанавливаем текст заголовка для колонок корреспонденции
	Для каждого МакетГруппировки из Схема.МакетыГруппировок Цикл
		Если МакетГруппировки.ИмяГруппировки = "Корреспонденции" И МакетГруппировки.ТипМакета = ТипМакетаОбластиКомпоновкиДанных.Заголовок Тогда
			МакетДляИзменения = Схема.Макеты.Найти(МакетГруппировки.Макет);
			МакетДляИзменения.Параметры.QQ.Выражение = "Представление(" + ИмяПоля + ")";
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Схема.Макеты.Макет3.Параметры.QQ.Выражение = "Представление(" + ИмяПоля + ")";
	
	СтандартныеОтчеты.ДобавитьОтборПоОрганизацииФ(ПараметрыОтчета, КомпоновщикНастроек);
	
КонецПроцедуры

Процедура ДобавитьГруппировку(Структура, Имя, Использование = Истина, Иерархия = 0)
	ПолеГруппировки = Структура.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Использование  = Использование;
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(Имя);
	Если Иерархия = 0 Тогда
		ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
	ИначеЕсли Иерархия = 1 Тогда
		ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
	Иначе
		ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.ТолькоИерархия;
	КонецЕсли;
КонецПроцедуры

