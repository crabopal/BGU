
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтандартныеОтчеты.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка, "ГруппаОсновнаяКоманднаяПанель");
	
	Если НЕ ЗначениеЗаполнено(Отчет.ОрганизацияПечать) Тогда
		Отчет.ОрганизацияПечать = Отчет.Организация;
	КонецЕсли;	
	
	Отчет.РежимРасшифровки = (Параметры.ПредставлениеВарианта = "Расшифровка");
	
	ЗаполнитьСпискиДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьТекстЗаголовка(ЭтаФорма);
	ВидимостьНастроек();
	Если Не ЗначениеЗаполнено(Отчет.ГруппаДокументов) Или Элементы.ГруппаДокументов.СписокВыбора.Количество() = 0 Тогда
		Отчет.ГруппаДокументов = "Все";
		ОбновитьСписокДокументовОтбора();
	КонецЕсли;	
	
	РассчитатьПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	ВариантМодифицирован                    = Ложь;
	ПользовательскиеНастройкиМодифицированы = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	СтандартныеОтчеты.ПриСохраненииПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
	Если Настройки.ДополнительныеСвойства.Свойство("ТекущиеНастройки") Тогда
		ТекущиеНастройки = Настройки.ДополнительныеСвойства.ТекущиеНастройки.Получить();
		Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(ТекущиеНастройки);
	КонецЕсли;		
	
	СтандартныеОтчеты.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
		
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КонецПериодаПриИзменении(Элемент)
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
		
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
    ОбновитьТекстЗаголовка(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОтборПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ОбновитьОтборы();
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Поле = Новый ПолеКомпоновкиДанных("Организация");
	Отбор = Отчет.КомпоновщикНастроек.Настройки.Отбор;
	
	Если ЗаполнениеОтчетностиКлиентСервер.НайтиЭлементОтбора(Поле, Отбор.Элементы) = Неопределено Тогда
		
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Отбор, Поле, Отчет.Организация, ВидСравненияКомпоновкиДанных.Равно, Истина);
		
	Иначе
		
	СтандартныеОтчетыКлиент.ОбновитьОтборКомпоновщикаНастроекБыстрымиОтборами(Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы, 
			Новый Структура("Организация", Отчет.Организация));
		
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаДокументовПриИзменении(Элемент)
	
	ОбновитьСписокДокументовОтбора();	
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)
	
	ОбновитьСписокДокументовОтбора();
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СдалПриИзменении(Элемент)
	
	Поле = Новый ПолеКомпоновкиДанных("МОЛ");
	Отбор = Отчет.КомпоновщикНастроек.Настройки.Отбор;
	
	Если ЗаполнениеОтчетностиКлиентСервер.НайтиЭлементОтбора(Поле, Отбор.Элементы) = Неопределено Тогда
		
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Отбор, Поле, Отчет.Сдал, ВидСравненияКомпоновкиДанных.Равно, Истина);
		
	Иначе
		
		СтандартныеОтчетыКлиент.ОбновитьОтборКомпоновщикаНастроекБыстрымиОтборами(Отбор.Элементы,
			Новый Структура("МОЛ",Отчет.Сдал));
		
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовДляОтбораПометкаПриИзменении(Элемент)
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовДляОтбораПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовДляОтбораПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент)
	
	ПодключитьОбработчикОжидания("РассчитатьПоказателиДинамически", 0.2, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	ОчиститьСообщения();
	СформироватьОтчетСервер(Отчет.КомпоновщикНастроек);
	
КонецПроцедуры

&НаКлиенте
Процедура ПанельНастроек(Команда)
	
	Отчет.ВидимостьНастроек = Не Элементы.ГруппаПанельНастроек.Видимость;
	ВидимостьНастроек();	
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеНастройки(Команда)
	
	ОткрытьФорму("Обработка.КонструкторПользовательскихНастроек.Форма", Новый Структура("КомпоновщикНастроек,Схема",Отчет.КомпоновщикНастроек,СхемаКомпоновкиДанных),,,,, Новый ОписаниеОповещения("ДополнительныеНастройкиЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеНастройкиЗавершение(ОтветФормы, ДополнительныеПараметры) Экспорт
	
	Если ОтветФормы <> Неопределено Тогда
		ОбновитьКомпоновщикНастроек(ОтветФормы);	
		СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
    Диалог.Период.ДатаНачала = Отчет.НачалоПериода;
    Диалог.Период.ДатаОкончания = Отчет.КонецПериода;
    Диалог.Показать(Новый ОписаниеОповещения("УстановитьПериодЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодЗавершение(Период, ДополнительныеПараметры) Экспорт
    
    Если Период <> Неопределено Тогда
		
		Отчет.НачалоПериода = Период.ДатаНачала;
        Отчет.КонецПериода  = Период.ДатаОкончания;
		
		Модифицированность = Истина;
		
		ОбновитьТекстЗаголовка(ЭтотОбъект);
		
		СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);

    КонецЕсли; 

КонецПроцедуры

