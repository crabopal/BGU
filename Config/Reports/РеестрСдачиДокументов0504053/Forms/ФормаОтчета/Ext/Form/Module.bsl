#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСпискиДокументов()
	
	ОбъектОтчет = РеквизитФормыВЗначение("Отчет");
	Макет = ОбъектОтчет.ПолучитьМакет("СпискиДокументов");
	
	СписокГруппДокументов = Элементы.ГруппаДокументов.СписокВыбора;
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Значение");
	Таблица.Колонки.Добавить("Представление");
	ПолучитьТаблицуИзОбласти(Макет, "ГруппыДокументов", Таблица);
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СписокГруппДокументов.Добавить(СтрокаТаблицы.Значение, СтрокаТаблицы.Представление);
	КонецЦикла;
	
	Если СписокГруппДокументов.Количество() = 0 Тогда
		Элементы.ГруппаДокументов.Видимость = Ложь;
	Иначе
		Если СписокГруппДокументов.НайтиПоЗначению("Все") = Неопределено Тогда
			СписокГруппДокументов.Добавить("Все", "[Все типы документов отчета]");
		КонецЕсли;
	КонецЕсли;

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ГруппаДокументов"				, Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ТипДокумента"					, Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Приходные"					, Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Расходные"					, Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ИсключатьИзПриходныхРасходных", Новый ОписаниеТипов("Булево"));
	
	ПолучитьТаблицуИзОбласти(Макет, "ТипыДокументовНовая", Таблица);
	
	Таблица.Колонки.Добавить("ТипПриведенный"		, Новый ОписаниеТипов("Тип"));
	
	Для Каждого ДокументСписка Из Таблица Цикл
		ДокументСписка.ТипПриведенный = Тип("ДокументСсылка."+ДокументСписка.ТипДокумента);
	КонецЦикла;
	
	СписокДокументов.Загрузить(Таблица);
	
	Для Каждого Эл Из СписокГруппДокументов Цикл
		СтрокаПрочихДокументов = СписокДокументов.Добавить();
		СтрокаПрочихДокументов.ГруппаДокументов = Эл.Значение;
		СтрокаПрочихДокументов.ТипДокумента = "";
		СтрокаПрочихДокументов.Приходные = Истина;
		СтрокаПрочихДокументов.Расходные = Истина;
		СтрокаПрочихДокументов.ТипПриведенный = "<прочие документы>";
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьТаблицуИзОбласти(Макет, ИмяОбласти, Таблица)
	
	Область = Макет.Области.Найти(ИмяОбласти);
	Если Область = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Область.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Строки Тогда
		
		ВерхОбласти	= Область.Верх;
		НизОбласти	= Область.Низ;
			
		Для НомСтроки = ВерхОбласти По НизОбласти Цикл
			
			НомерКолонки = 1;
			ЕстьДанные = Ложь;
			
			СтрокаТаблицы = Таблица.Добавить();
			
			Для Каждого Колонка Из Таблица.Колонки Цикл
				Значение = СокрП(Макет.Область(НомСтроки, НомерКолонки).Текст);
				СтрокаТаблицы[Колонка.Имя] = ?(Колонка.ТипЗначения.СодержитТип(Тип("Булево")), ЗначениеЗаполнено(Значение), Колонка.ТипЗначения.ПривестиЗначение(Значение));
				ЕстьДанные = ЗначениеЗаполнено(Значение) Или ЕстьДанные;
				НомерКолонки = НомерКолонки + 1;
			КонецЦикла;
			
			Если Не ЕстьДанные Тогда
				Таблица.Удалить(СтрокаТаблицы);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокДокументовОтбора()
	
	Отбор = Новый Структура();
	Если ЗначениеЗаполнено(Отчет.ВидДокумента) Тогда
		Отбор.Вставить(Отчет.ВидДокумента, Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отчет.ГруппаДокументов) И Отчет.ГруппаДокументов <> "Все" Тогда
		Отбор.Вставить("ГруппаДокументов", Отчет.ГруппаДокументов);
	КонецЕсли;
	
	ТипыДокументов = СписокДокументов.Выгрузить(Отбор);
	
	ТипыДокументов.Свернуть("ТипПриведенный");
	ТипыДокументов.Сортировать("ТипПриведенный");
	
	Отчет.СписокДокументовДляОтбора.ЗагрузитьЗначения(ТипыДокументов.ВыгрузитьКолонку("ТипПриведенный"));
	
	Отчет.СписокДокументовДляОтбора.ЗаполнитьПометки(Истина);
	
	// некоторые документы, например "Принятие к учету ОС, НМА, НПА", могут делать движения по дебету и кредиту счета 101 одновременно
	// но по сути этот документ является приходным, поэтому необходимо принудительно исключить его из "прочих" расходных документов
	Отбор.Очистить();
	Если ЗначениеЗаполнено(Отчет.ВидДокумента) Тогда
		Отбор.Вставить(Отчет.ВидДокумента, Ложь);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отчет.ГруппаДокументов) И Отчет.ГруппаДокументов <> "Все" Тогда
		Отбор.Вставить("ГруппаДокументов", Отчет.ГруппаДокументов);
	КонецЕсли;
	Отбор.Вставить("ИсключатьИзПриходныхРасходных", Истина);
	
	ТипыДокументов = СписокДокументов.Выгрузить(Отбор);
	
	Отчет.СписокДокументовДляИсключения.ЗагрузитьЗначения(ТипыДокументов.ВыгрузитьКолонку("ТипПриведенный"));
	
КонецПроцедуры

&НаСервере
ПРоцедура ОбновитьКомпоновщикНастроек(КомпоновщикНастроек)
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	Отчет.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(КомпоновщикНастроек.ПользовательскиеНастройки);
	
	Для каждого ЭлементОтбора из Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы цикл
		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация") тогда
			Отчет.Организация = ЭлементОтбора.ПравоеЗначение;
			Если не ЭлементОтбора.Использование тогда
				Отчет.Организация = "";
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	ЗначениеПараметра = Отчет.КомпоновщикНастроек.Настройки.ПараметрыВывода.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МакетОформления"));
	
	Если ЗначениеПараметра <> Неопределено Тогда
		МакетОформления = ЗначениеПараметра.Значение;
	КонецЕсли;
	
	Для Каждого ЭлементНастройки Из Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл	
		Если ЭлементНастройки.ИдентификаторПользовательскойНастройки = ЗначениеПараметра.ИдентификаторПользовательскойНастройки Тогда
			МакетОформления = ЗначениеПараметра.Значение;
		КонецЕсли;
	КонецЦикла;
		
КонецПРоцедуры

&НаСервере
Функция ОбновитьОтборы()
	
	Отчет.Организация	 = СтандартныеОтчеты.УстановитьЗначениеОтбора(Отчет.КомпоновщикНастроек, "Организация");
	Отчет.Сдал			 = СтандартныеОтчеты.УстановитьЗначениеОтбора(Отчет.КомпоновщикНастроек, "МОЛ");
	
КонецФункции	

&НаСервере
Процедура СформироватьОтчетСервер(Знач КомпоновщикНастроек) Экспорт
	
	Отказ = Не ПроверитьЗаполнение();
	Если Не Отказ Тогда
		СтандартныеОтчеты.ОбработкаПроверкиЗаполнения(Отчет, Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыводитьЗаголовок", ВыводитьЗаголовок);
	Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыводитьПодвал"   , ВыводитьПодвал);
	
	ОбъектОтчет = РеквизитФормыВЗначение("Отчет");
	ОбъектОтчет.СформироватьОтчет(Результат, ДанныеРасшифровки, СхемаКомпоновкиДанных, КомпоновщикНастроек, УникальныйИдентификатор);
	
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(Результат, ОбъектОтчет.Метаданные().Синоним, Строка(ПользователиКлиентСервер.АвторизованныйПользователь()), Отчет.Организация);
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьНастроек()
	
	Элементы.ГруппаПанельНастроек.Видимость	= Отчет.ВидимостьНастроек;
	Элементы.ПанельНастроек.Пометка			= Элементы.ГруппаПанельНастроек.Видимость;
	
КонецПРоцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовка(Форма)
	
	Отчет = Форма.Отчет;	
	ЗаголовокОтчета = "Реестр сдачи документов ф.0504053 за период " + СтандартныеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(Отчет.НачалоПериода, Отчет.КонецПериода, Истина);
	Форма.Заголовок = ЗаголовокОтчета;

КонецПроцедуры

#Область РасчетПоказателейВыделенныхЯчеек

// Выполняет расчет и вывод показателей выделенной области ячеек.
// См. обработчик события ОтчетТабличныйДокументПриАктивизацииОбласти.
//
&НаКлиенте
Процедура РассчитатьПоказателиДинамически()
	Перем ТекущаяКоманда;
	
	КомандыПоказателей = КомандыПоказателей();
	Для Каждого Команда Из КомандыПоказателей Цикл 
		Если Элементы[Команда.Ключ].Пометка Тогда 
			ТекущаяКоманда = Команда.Ключ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	РассчитатьПоказатели(ТекущаяКоманда);
КонецПроцедуры

// Выполняет расчет и вывод показателей выделенных областей ячеек табличного документа.
//
// Параметры:
//  ТекущаяКоманда - Строка - имя команды расчета показателя, например, "РассчитатьСумму".
//                      Определяет, какой показатель является основным.
//
&НаКлиенте
Процедура РассчитатьПоказатели(ТекущаяКоманда = "РассчитатьСумму")
	// Расчет показателей.
	ПараметрыРасчета = ОбщегоНазначенияБГУКлиент.ПараметрыРасчетаПоказателейЯчеек(Элементы.Результат);
	Если ПараметрыРасчета.РассчитатьНаСервере Тогда 
		РасчетныеПоказатели = РасчетныеПоказателиСервер(ПараметрыРасчета);
	Иначе
		РасчетныеПоказатели = ОбщегоНазначенияБГУКлиентСервер.РасчетныеПоказателиЯчеек(
			Результат, ПараметрыРасчета.ВыделенныеОбласти);
	КонецЕсли;
	
	// Установка значений показателей.
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РасчетныеПоказатели);
	
	// Переключение и форматирование показателей.
	КомандыПоказателей = КомандыПоказателей();
	Для Каждого Команда Из КомандыПоказателей Цикл 
		Элементы[Команда.Ключ].Пометка = Ложь;
		
		ЗначениеПоказателя = РасчетныеПоказатели[Команда.Значение];
		РазрядностьПоказателя = Мин(СтрДлина(Макс(ЗначениеПоказателя, -ЗначениеПоказателя) % 1) - 2, 4);
		
		Элементы[Команда.Значение].ФорматРедактирования = "ЧДЦ=" + РазрядностьПоказателя + "; ЧРГ=' '; ЧН=0";
	КонецЦикла;
	Элементы[ТекущаяКоманда].Пометка = Истина;
	
	// Вывод основного показателя.
	ТекущийПоказатель = КомандыПоказателей[ТекущаяКоманда];
	Показатель = ЭтотОбъект[ТекущийПоказатель];
	Элементы.Показатель.ФорматРедактирования = Элементы[ТекущийПоказатель].ФорматРедактирования;
	Элементы.ГруппаВидыПоказателей.Картинка = БиблиотекаКартинок[ТекущийПоказатель];
КонецПроцедуры

// Рассчитывает показатели числовых ячеек в табличном документе.
//  см. ОтчетыКлиентСервер.РасчетныеПоказателиЯчеек.
//
&НаСервере
Функция РасчетныеПоказателиСервер(ПараметрыРасчета)
	Возврат ОбщегоНазначенияБГУКлиентСервер.РасчетныеПоказателиЯчеек(Результат, ПараметрыРасчета.ВыделенныеОбласти);
КонецФункции

// Определяет соответствие между командами расчета показателей и показателями.
//
// Возвращаемое значение:
//   Соответствие - Ключ - имя команды, Значение - имя показателя.
//
&НаКлиенте
Функция КомандыПоказателей()
	КомандыПоказателей = Новый Соответствие();
	КомандыПоказателей.Вставить("РассчитатьСумму", "Сумма");
	КомандыПоказателей.Вставить("РассчитатьКоличество", "Количество");
	КомандыПоказателей.Вставить("РассчитатьСреднее", "Среднее");
	КомандыПоказателей.Вставить("РассчитатьМинимум", "Минимум");
	КомандыПоказателей.Вставить("РассчитатьМаксимум", "Максимум");
	
	Возврат КомандыПоказателей;
КонецФункции

// Управляет признаком видимости панели расчетных показателей.
//
// Параметры:
//  Видимость - Булево - Признак включения / выключения видимости панели показателей.
//              См. также Синтакс-помощник: ГруппаФормы.Видимость.
//
&НаКлиенте
Процедура УстановитьВидимостьПоказателей(Видимость)
	Элементы.ОбластьПоказателей.Видимость = Видимость;
	Элементы.РассчитатьВсеПоказатели.Пометка = Видимость;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

