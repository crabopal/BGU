#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем НаборПоказателей Экспорт; // Массив показателей отчета

#Область СлужебныйПрограммныйИнтерфейс

Процедура СформироватьОтчет(Результат = Неопределено, ДанныеРасшифровки = Неопределено, Схема = Неопределено, КомпоновщикНастроекКД, УникальныйИдентификатор) Экспорт
		
	ДанныеРасшифровкиОбъект = Неопределено;
		
	Если ТипЗнч(Схема) = Тип("Строка") Тогда
		Если ЭтоАдресВременногоХранилища(Схема) Тогда
			СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(Схема);
		КонецЕсли;
	Иначе
		СхемаКомпоновкиДанных = Схема;
	КонецЕсли;
	
	Результат.Очистить();
	
	Список = Новый СписокЗначений;
	СписокНеотмеченых = СписокДокументовДляИсключения.Скопировать();
	
	Для Каждого Элемент Из СписокДокументовДляОтбора Цикл
		Если Не Элемент.Пометка Тогда
			СписокНеотмеченых.Добавить(Элемент.Значение);
		Иначе
			Список.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ВнешниеДанные = Новый Структура;
	
	Если ГруппаДокументов <> "Все" И ЗначениеЗаполнено(ГруппаДокументов) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроекКД, "Группа", ГруппаДокументов, ВидСравненияКомпоновкиДанных.ВСписке);
	КонецЕсли;
	
	Если Список.НайтиПоЗначению("<прочие документы>") <> Неопределено Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроекКД, "ТипДокумента", СписокНеотмеченых, ВидСравненияКомпоновкиДанных.НеВСписке);
	Иначе
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроекКД, "ТипДокумента", Список, ВидСравненияКомпоновкиДанных.ВСписке);
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "ВидДокумента", ВидДокумента);
		
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "НачалоПериода", НачалоПериода);
	КонецЕсли;
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "КонецПериода", КонецПериода);
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "НомерРеестра", НомерРеестра);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "ПодразделениеПечать", ПодразделениеПечать);
	Если ЗначениеЗаполнено(ОрганизацияПечать) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "ОрганизацияПечать", ОрганизацияПечать.НаименованиеПолное);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "ОКПО", ОрганизацияПечать.КодОКПО);
	Иначе
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "ОрганизацияПечать", Организация.НаименованиеПолное);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "ОКПО", Организация.КодОКПО);
	КонецЕсли;	
	
	ТЗ = РегистрыСведений.ДанныеСотрудников.ПолучитьПоследнее(ТекущаяДата(), Новый Структура("Сотрудник", Сдал));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "Сдал", Корреспонденты.ФИОПоОбъекту(Сдал));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "СдалДолжность", ТЗ.Должность);
	
	ТЗ = РегистрыСведений.ДанныеСотрудников.ПолучитьПоследнее(ТекущаяДата(), Новый Структура("Сотрудник", Принял));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "Принял", Корреспонденты.ФИОПоОбъекту(Принял));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекКД, "ПринялДолжность", ТЗ.Должность);	
	
	//Сгенерируем макет компоновки данных при помощи компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		
	Попытка
		
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроекКД.Настройки, ДанныеРасшифровкиОбъект);
		//Создадим и инициализируем процессор компоновки
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеДанные, ДанныеРасшифровкиОбъект, Истина);
		
		ДанныеРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровкиОбъект, УникальныйИдентификатор);
		
		//Создадим и инициализируем процессор вывода результата
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
		ПроцессорВывода.УстановитьДокумент(Результат);
		
		//Обозначим начало вывода
		ПроцессорВывода.НачатьВывод();
		
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Пока ИнформацияОбОшибке.Причина <> Неопределено Цикл
			ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
		КонецЦикла;
		ТекстСообщения = НСтр("ru = 'Отчет не сформирован!'") + Символы.ПС + ИнформацияОбОшибке.Описание;
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	КонецПопытки;
		
КонецПроцедуры

#КонецОбласти

НаборПоказателей = Новый Массив;

#КонецЕсли