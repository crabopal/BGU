#Область СлужебныеПроцедурыИФункции

Функция ПолучитьЗначениеПараметра(ОтчетОбъект, ИмяПараметра)
	
	Параметр = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных(ИмяПараметра));
	
	Возврат Параметр.Значение;
	
КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	
	Методы.Вставить("ОбновитьНаименованиеРегистраУчета");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли