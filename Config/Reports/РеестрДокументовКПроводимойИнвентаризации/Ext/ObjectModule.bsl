#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//   Настройки - Структура - см. возвращаемое значение ФункцииОтчетовКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию().
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.РазрешеноИзменятьСтруктуру = Ложь;
	Настройки.РазрешеноИзменятьВарианты = Ложь;
	
	Настройки.События.ПриСозданииНаСервере = Истина;
	Настройки.События.ПередЗагрузкойВариантаНаСервере = Истина;
	Настройки.События.ПослеЗаполненияПанелиБыстрыхНастроек = Истина;
	Настройки.События.ПриЗагрузкеПользовательскихНастроекНаСервере = Истина;
	Настройки.События.ПриОпределенииПараметровВыбора = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Перем ДанныеОписи;
	
	Параметры = Форма.Параметры;
	
	ЭтоСтандартныйКонтекстныйВызов = Параметры.Свойство("ПараметрКоманды");
	ЭтоВызовРегистраУчета = Параметры.Свойство("НеДобавлятьКомандыРегистраУчета")
		И Параметры.Свойство("ПользовательскиеНастройки")
		И Параметры.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СведенияДляРегистраУчета");
	
	// Для запуска отчета необходима ссылка на документ описи, к которому будет формироваться реестр документов.
	Если ЭтоСтандартныйКонтекстныйВызов Тогда
		ДокументОписи = Параметры.ПараметрКоманды;
		
	ИначеЕсли ЭтоВызовРегистраУчета Тогда
		СведенияДляРегистраУчета = Параметры.ПользовательскиеНастройки.ДополнительныеСвойства.СведенияДляРегистраУчета;
		
		ДокументОписи = СведенияДляРегистраУчета.ДокументОписи;
	Иначе
		Отказ = Истина;
		
		ТекстШаблон = Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПолучитьШаблонСообщенияПроверкиПередФормированиемРеестра();
		
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстШаблон,
			НСтр("ru='Не указан документ инвентаризационной описи, к которому необходимо сформировать Реестр документов.'")));
		
		Возврат;
	КонецЕсли;
	
	ПроверитьДокументОписи(ДокументОписи, Отказ, ДанныеОписи);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДокументОписи", ДокументОписи);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаИнвентаризации", ДанныеОписи.ДатаИнвентаризации);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачала", ДанныеОписи.ДатаНачала);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончания", ДанныеОписи.ДатаОкончания);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", ДанныеОписи.Организация);
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Подразделение", ДанныеОписи.Подразделение);
	
	РегистрыУчета.ПриСозданииНаСервере(Форма, "ОсновнаяКоманднаяПанель");
	
КонецПроцедуры

Процедура ПередЗагрузкойВариантаНаСервере(Форма, НовыеНастройкиКД) Экспорт
	
	// Чтобы не копировать параметры в новые настройки, можно было бы
	// разместить параметры в фиксированных настройках.
	// Но фиксированные настройки не передаются при формировании отчета из подсистемы "Регистры учета".
	
	НовыеНастройкиКД.ПараметрыДанных.УстановитьЗначениеПараметра("ДокументОписи",
		ПолучитьЗначениеПараметра("ДокументОписи"));
	
	НовыеНастройкиКД.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаИнвентаризации",
		ПолучитьЗначениеПараметра("ДатаИнвентаризации"));
	
	НовыеНастройкиКД.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачала",
		ПолучитьЗначениеПараметра("ДатаНачала"));
	
	НовыеНастройкиКД.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончания",
		ПолучитьЗначениеПараметра("ДатаОкончания"));
	
	НовыеНастройкиКД.ПараметрыДанных.УстановитьЗначениеПараметра("Организация",
		ПолучитьЗначениеПараметра("Организация"));
	
	НовыеНастройкиКД.ПараметрыДанных.УстановитьЗначениеПараметра("Подразделение",
		ПолучитьЗначениеПараметра("Подразделение"));
	
КонецПроцедуры

Процедура ПослеЗаполненияПанелиБыстрыхНастроек(Форма, ПараметрыЗаполнения) Экспорт
	
    НастроитьЭлементФормыПараметраРежимФормирования(Форма);
	
КонецПроцедуры

Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Форма, НовыеПользовательскиеНастройкиКД) Экспорт
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек.ПользовательскиеНастройки, "РежимФормирования",
		ПолучитьЗначениеПараметраРежимФормированияПоУмолчанию());
		
	НовыеПользовательскиеНастройкиКД = КомпоновщикНастроек.ПолучитьНастройки();
	
КонецПроцедуры

Процедура ПриОпределенииПараметровВыбора(Форма, СвойстваНастройки) Экспорт
	
	Если СвойстваНастройки.ПолеКД = Новый ПолеКомпоновкиДанных("ПараметрыДанных.РежимФормирования") Тогда
		СвойстваНастройки.ОграничиватьВыборУказаннымиЗначениями = Истина;
		СвойстваНастройки.ЗначенияДляВыбора = ПолучитьДоступныеЗначенияПараметраРежимФормирования();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДокументРезультат.АвтоМасштаб = Истина;
	ДокументРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ДокументРезультат.КлючПараметровПечати = "Отчет_РеестрДокументовКПроводимойИнвентаризации";
	
	ДокументРезультат.Очистить();
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	ДокументОписи = ПолучитьЗначениеПараметра("ДокументОписи");
	
	ДанныеОписи = ПрочитатьДанныеОписи(ДокументОписи);
	
	РежимФормирования = СтандартныеОтчетыКлиентСервер.ПолучитьПараметр(Настройки, "РежимФормирования").Значение;
	
	Если РежимФормирования = Неопределено Тогда
		// Именно 0 как пустое значение типа Число. Такое значение устанавливается в списке выбора при очистке.
		РежимФормирования = 0;
		
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек.ПользовательскиеНастройки, "РежимФормирования",
			РежимФормирования);
	КонецЕсли;
	
	ПериодФормирования = Отчеты.РеестрДокументовКПроводимойИнвентаризации.ОпределитьПериодФормирования(
		РежимФормирования,
		ПолучитьЗначениеПараметра("ДатаИнвентаризации"),
		ПолучитьЗначениеПараметра("ДатаНачала"),
		ПолучитьЗначениеПараметра("ДатаОкончания"));
	
	ТаблицаДокументов = НайтиДокументыДляРеестра(ДанныеОписи, РежимФормирования, ПериодФормирования);
	
	ДобавитьСведенияДляРегистраУчета(ДанныеОписи);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Отчет.РеестрДокументовКПроводимойИнвентаризации.ПФ_MXL_РеестрДокументов");
	
	ВывестиЗаголовокОтчета(ДокументРезультат, ДанныеОписи, ПериодФормирования, Макет);
	
	ИтогоКоличествоЗаписей = 0;
	
	ВывестиРазделыОтчета(РежимФормирования, ДокументРезультат, Настройки, ДанныеРасшифровки, ТаблицаДокументов, Макет,
		ДанныеОписи, ИтогоКоличествоЗаписей);
	
	ВывестиПодвалОтчета(ДокументРезультат, Макет, ИтогоКоличествоЗаписей);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПараметрРежимФормирования

Функция ПолучитьЗначениеПараметраРежимФормированияПоУмолчанию()
	
	ДатаИнвентаризации	= ПолучитьЗначениеПараметра("ДатаИнвентаризации");
	ДатаНачала			= ПолучитьЗначениеПараметра("ДатаНачала");
	ДатаОкончания		= ПолучитьЗначениеПараметра("ДатаОкончания");
	
	Коды = Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПолучитьКодыРежимовФормирования();
	
	Если ДатаИнвентаризации = ДатаНачала Тогда
		Возврат Коды.ПериодПроведенияИнвентаризации;
	Иначе
		Возврат Коды.ОтДатыИнвентаризацииДоДатыОкончанияПроведенияИнвентаризации;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДоступныеЗначенияПараметраРежимФормирования()
	
	ДатаИнвентаризации	= ПолучитьЗначениеПараметра("ДатаИнвентаризации");
	ДатаНачала			= ПолучитьЗначениеПараметра("ДатаНачала");
	ДатаОкончания		= ПолучитьЗначениеПараметра("ДатаОкончания");
	
	Коды = Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПолучитьКодыРежимовФормирования();
	
	ДоступныеЗначения = Новый СписокЗначений();
	
	ДоступныеЗначения.Добавить(Коды.ПериодПроведенияИнвентаризации,
		ПолучитьПредставлениеПериодаФормирования(ДатаНачала, ДатаОкончания, НСтр("ru='период проведения инвентаризации'")));
	
	Если ДатаИнвентаризации <> ДатаНачала Тогда
		ДоступныеЗначения.Добавить(Коды.ОтДатыИнвентаризацииДоДатыНачалаПроведенияИнвентаризации,
			ПолучитьПредставлениеПериодаФормирования(ДатаИнвентаризации, ДатаНачала, НСтр("ru='до начала проведения инвентаризации'")));
		
		ДоступныеЗначения.Добавить(Коды.ОтДатыИнвентаризацииДоДатыОкончанияПроведенияИнвентаризации,
			ПолучитьПредставлениеПериодаФормирования(ДатаИнвентаризации, ДатаОкончания, НСтр("ru='до окончания проведения инвентаризации'")));
	КонецЕсли;
	
	Возврат ДоступныеЗначения;
	
КонецФункции

Функция ПолучитьПредставлениеПериодаФормирования(Дата1, Дата2, Комментарий)
	
	ФорматнаяСтрока = "ДФ=dd.MM.yyyy";
	
	Возврат СтрШаблон(НСтр("ru='%1 - %2 (%3)'"), Формат(Дата1, ФорматнаяСтрока), Формат(Дата2, ФорматнаяСтрока), Комментарий);
	
КонецФункции

// Настройка элемента формы на панели быстрого отбора.

Процедура НастроитьЭлементФормыПараметраРежимФормирования(Форма)
	
	Элемент = ПолучитьЭлементФормыПараметраРежимФормирования(Форма);
	
	Если Элемент.СписокВыбора.Количество() = 1 Тогда
		НовТолькоПросмотр = Истина;
		НовПодсказка = "";
		НовОтображениеПодсказки = ОтображениеПодсказки.Нет;
	Иначе
		НовТолькоПросмотр = Ложь;
		НовПодсказка = ПолучитьТекстПодсказкиПараметраРежимФормирования(Элемент.СписокВыбора);
		НовОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	КонецЕсли;
	
	Элемент.ТолькоПросмотр = НовТолькоПросмотр;
	Элемент.АвтоМаксимальнаяШирина = Ложь;
	Элемент.Ширина = 42;
	Элемент.РасширеннаяПодсказка.Заголовок = НовПодсказка;
	Элемент.ОтображениеПодсказки = НовОтображениеПодсказки;
	
КонецПроцедуры

Функция ПолучитьТекстПодсказкиПараметраРежимФормирования(СписокВыбора)
	
	МассивСтрок = Новый Массив();
	МассивСтрок.Добавить(НСтр("ru='Варианты периода формирования отчета:'"));
	
	Коды = Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПолучитьКодыРежимовФормирования();
	
	Счетчик = 0;
	
	Для Каждого Элемент Из СписокВыбора Цикл
		Счетчик = Счетчик + 1;
		
		ПредставлениеПериода = Лев(Элемент.Представление, СтрНайти(Элемент.Представление, " (") - 1);
		
		МассивСтрок.Добавить(Символы.ПС);
		МассивСтрок.Добавить(Символы.ПС);
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(СтрШаблон("%1) ", Счетчик)));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(ПредставлениеПериода));
		МассивСтрок.Добавить(Символы.ПС);
		
		Код = Элемент.Значение;
		
		Если Код = Коды.ОтДатыИнвентаризацииДоДатыНачалаПроведенияИнвентаризации Тогда
			Комментарий = НСтр("ru='от даты инвентаризации до даты начала проведения инвентаризации'");
			
		ИначеЕсли Код = Коды.ПериодПроведенияИнвентаризации Тогда
			Комментарий = НСтр("ru='период проведения инвентаризации'");
			
		ИначеЕсли Код = Коды.ОтДатыИнвентаризацииДоДатыОкончанияПроведенияИнвентаризации Тогда
			Комментарий = НСтр("ru='от даты инвентаризации до даты окончания проведения инвентаризации'");
		КонецЕсли;
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока("    " + Комментарий,, ЦветаСтиля.ТекстИнформационнойНадписи));
	КонецЦикла;
	
	Возврат Новый ФорматированнаяСтрока(МассивСтрок);
	
КонецФункции

Функция ПолучитьЭлементФормыПараметраРежимФормирования(Форма)
	
	Индекс = 0;
	
	Для Каждого Элемент Из Форма.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если Строка(Элемент.Параметр) = "РежимФормирования" Тогда
			Прервать;
		КонецЕсли;
		
		Индекс = Индекс + 1;
	КонецЦикла;
	
	ПутьКДанным = СтрШаблон("Отчет.КомпоновщикНастроек.ПользовательскиеНастройки[%1].Значение", Формат(Индекс, "ЧГ=0;ЧН=0"));
	
	Возврат НайтиЭлементФормыПоПутиКДанным(Форма.Элементы.ПанельБыстрыхНастроек.ПодчиненныеЭлементы, ПутьКДанным);
	
КонецФункции

Функция НайтиЭлементФормыПоПутиКДанным(КоллекцияЭлементовФормы, ПутьКДанным)
	
	Для Каждого Элемент Из КоллекцияЭлементовФормы Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
			ПодчиненныйЭлемент = НайтиЭлементФормыПоПутиКДанным(Элемент.ПодчиненныеЭлементы, ПутьКДанным);
			
			Если ПодчиненныйЭлемент <> Неопределено Тогда
				Возврат ПодчиненныйЭлемент;
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Элемент) = Тип("ПолеФормы") Тогда
			Если Элемент.ПутьКДанным = ПутьКДанным Тогда
				Возврат Элемент;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область ПодготовкаДанных

Функция ПрочитатьДанныеОписи(Знач ДокументОписи, ИмяДокумента = Неопределено)
	
	ТипДокумента = ТипЗнч(ДокументОписи);
	
	Если ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО") Тогда
		ИмяДокумента = "ИнвентаризационнаяОписьБСО";
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		ИмяДокумента = "ИнвентаризационнаяОписьНФА";
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда
		ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям";
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами") Тогда
		ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям";
		
	Иначе
		ИмяДокумента = Неопределено;
		
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Документы[ИмяДокумента].ПрочитатьДанныеОписиДляРеестраДокументовКПроводимойИнвентаризации(ДокументОписи);
	
КонецФункции

Процедура ПроверитьДокументОписи(Знач ДокументОписи, Отказ, ДанныеОписи = Неопределено)
	
	Перем ИмяДокумента;
	
	Если Не ЗначениеЗаполнено(ДокументОписи) Тогда
		Отказ = Истина;
		
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Формирование Реестра документов, отраженных во время проведения инвентаризации, отменено.
			|Не указан документ описи, к которому должен быть составлен Реестр документов.'"));
		
		Возврат;
	КонецЕсли;
	
	ДанныеОписи = ПрочитатьДанныеОписи(ДокументОписи, ИмяДокумента);
	
	Если ИмяДокумента = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
			НСтр("ru='Формирование Реестра документов, отраженных во время проведения инвентаризации, отменено.
				|Для документа описи ""%1"" составление Реестра документов в настоящее время не поддерживается.'"),
			Строка(ТипЗнч(ДокументОписи))),,,, Отказ);
		
		Возврат;
	КонецЕсли;
	
	Документы[ИмяДокумента].ПроверитьДанныеОписиДляРеестраДокументовКПроводимойИнвентаризации(ДанныеОписи, Отказ);
	
КонецПроцедуры

Функция НайтиДокументыДляРеестра(ДанныеОписи, РежимФормирования, ПериодФормирования)
	
	Перем ТаблицаДокументов;
	
	ДокументОписи = ДанныеОписи.Ссылка;
	
	ТипДокумента = ТипЗнч(ДокументОписи);
	
	Если ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО") Тогда
		ИмяДокумента = "ИнвентаризационнаяОписьБСО";
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		ИмяДокумента = "ИнвентаризационнаяОписьНФА";
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда
		ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям";
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами") Тогда
		ИмяДокумента = "ИнвентаризационнаяОписьРасчетовСКонтрагентами";
	КонецЕсли;
	
	ТаблицаДокументов = Документы[ИмяДокумента].НайтиДокументыДляРеестраДокументовКПроводимойИнвентаризации(ДанныеОписи, ПериодФормирования);
	
	ОбработатьТаблицуДокументов(ТаблицаДокументов, РежимФормирования, ПериодФормирования, ДанныеОписи);
	
	Возврат ТаблицаДокументов;
	
КонецФункции

Процедура ОбработатьТаблицуДокументов(ТаблицаДокументов, РежимФормирования, ПериодФормирования, ДанныеОписи)
	
	// Показатели дебета и кредита, расположенные в исходной таблице "в ширину",
	// разворачиваются здесь "в высоту".
	
	ОбщиеПоля = "ДокументСсылка,Период,НаименованиеДокумента,НомерДокумента,ДатаДокумента,КФО";

	НоваяТаблица = ТаблицаИзНабораДанных(СхемаКомпоновкиДанных);
	
	Коды = Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПолучитьКодыРежимовФормирования();
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		Если СтрокаТаблицы.СторонаДтСоответствуетОтбору Тогда
			НоваяСтрока = НоваяТаблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, ОбщиеПоля + ",КоличествоДт");
			
			НоваяСтрока.Счет = СтрокаТаблицы.СчетДт;
			НоваяСтрока.СуммаДт = СтрокаТаблицы.Сумма;
			
			ЗаполнитьНомерРаздела(НоваяСтрока, РежимФормирования, Коды, ДанныеОписи);
		КонецЕсли;
		
		Если СтрокаТаблицы.СторонаКтСоответствуетОтбору Тогда
			НоваяСтрока = НоваяТаблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, ОбщиеПоля + ",КоличествоКт");
			
			НоваяСтрока.Счет = СтрокаТаблицы.СчетКт;
			НоваяСтрока.СуммаКт = СтрокаТаблицы.Сумма;
			
			ЗаполнитьНомерРаздела(НоваяСтрока, РежимФормирования, Коды, ДанныеОписи);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаДокументов = НоваяТаблица;
	
КонецПроцедуры

Процедура ЗаполнитьНомерРаздела(НоваяСтрока, РежимФормирования, Коды, ДанныеОписи)
	
	Если РежимФормирования = Коды.ПериодПроведенияИнвентаризации Тогда
		НомерРаздела = 2;
		
	ИначеЕсли РежимФормирования = Коды.ОтДатыИнвентаризацииДоДатыНачалаПроведенияИнвентаризации Тогда
		НомерРаздела = 1;
		
	ИначеЕсли РежимФормирования = Коды.ОтДатыИнвентаризацииДоДатыОкончанияПроведенияИнвентаризации Тогда
		НомерРаздела = ?(НоваяСтрока.Период >= ДанныеОписи.ДатаНачала, 2, 1);
	КонецЕсли;
	
	НоваяСтрока.НомерРаздела = НомерРаздела;
	
КонецПроцедуры

Функция ПолучитьЗначениеПараметра(ИмяПараметра)
	
	Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных(ИмяПараметра));
	
	Возврат Параметр.Значение;
	
КонецФункции

Функция ТаблицаИзНабораДанных(СхемаКомпоновкиДанных)
	
	Результат = Новый ТаблицаЗначений();
	
	НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Найти("ТаблицаДокументов");
	
	Для Каждого Поле Из НаборДанных.Поля Цикл
		Результат.Колонки.Добавить(Поле.Поле, Поле.ТипЗначения, Поле.Заголовок);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСимволПрочерка()
	
	Возврат НСтр("ru='—'");
	
КонецФункции

Процедура ДобавитьСведенияДляРегистраУчета(ДанныеОписи)
	
	СведенияДляРегистраУчета = Новый Структура();
	СведенияДляРегистраУчета.Вставить("ДокументОписи", ДанныеОписи.Ссылка);
	
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить(
		"СведенияДляРегистраУчета", СведенияДляРегистраУчета);
	
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить(
		"ПользовательскиеНастройкиМодифицированы", Истина);	
	
КонецПроцедуры

#КонецОбласти

#Область ВыводОтчета

Процедура ВывестиЗаголовокОтчета(ДокументРезультат, ДанныеОписи, ПериодФормирования, Макет)
	
	ДатаНачала			= ПериодФормирования.Дата1;
	ДатаОкончания		= ПериодФормирования.Дата2;
	НаименованиеОписи	= ПолучитьНаименованиеОписи(ДанныеОписи.Ссылка);
	ДатаОписи			= ДанныеОписи.Дата;
	НомерОписи			= РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
							ДанныеОписи.Ссылка, ДанныеОписи.Номер);
	
	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	ДатаНачала		= ?(ЗначениеЗаполнено(ДатаНачала),		Формат(ДатаНачала, ФорматДаты),		ПолучитьСимволПрочерка());
	ДатаОкончания	= ?(ЗначениеЗаполнено(ДатаОкончания),	Формат(ДатаОкончания, ФорматДаты),	ПолучитьСимволПрочерка());
	ДатаОписи		= ?(ЗначениеЗаполнено(ДатаОписи),		Формат(ДатаОписи, ФорматДаты),		ПолучитьСимволПрочерка());
	НомерОписи		= ?(ЗначениеЗаполнено(НомерОписи),		НомерОписи,							ПолучитьСимволПрочерка());
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("ДатаНачала",			ДатаНачала);
	ЗначенияПараметров.Вставить("ДатаОкончания",		ДатаОкончания);
	ЗначенияПараметров.Вставить("НаименованиеОписи",	НаименованиеОписи);
	ЗначенияПараметров.Вставить("ДатаОписи",			ДатаОписи);
	ЗначенияПараметров.Вставить("НомерОписи",			НомерОписи);
	
	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.Заполнить(ЗначенияПараметров);
	
	ДокументРезультат.Вывести(Область);
	
КонецПроцедуры

Функция ПолучитьНаименованиеОписи(Ссылка)
	
	ТипДокумента = ТипЗнч(Ссылка);
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекОписей61н();
	
	Поиск = Новый Структура("ТипДокумента", ТипДокумента);
	
	МассивСтрок = ТаблицаНастроек.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат МассивСтрок[0].НаименованиеОписи;
	КонецЕсли;
	
	НаименованиеОписи = Строка(ТипДокумента);
	
	Если ПустаяСтрока(НаименованиеОписи) Тогда
		НаименованиеОписи = ПолучитьСимволПрочерка();
	КонецЕсли;
	
	Возврат НаименованиеОписи;
	
КонецФункции

Процедура ВывестиЗаголовокРаздела(НомерРаздела, РежимФормирования, ДокументРезультат, Макет, ДанныеОписи)
	
	Область = Макет.ПолучитьОбласть(СтрШаблон("Раздел%1Заголовок", Формат(НомерРаздела, "ЧГ=0")));
	
	ДокументРезультат.Вывести(Область);
	
	Коды = Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПолучитьКодыРежимовФормирования();
	
	Если НомерРаздела = 1 Тогда
		Если ДанныеОписи.ДатаИнвентаризации = ДанныеОписи.ДатаНачала Тогда
			Область = Макет.ПолучитьОбласть("ПериодОтсутствует");
			
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить("ДатаНачала", Формат(ДанныеОписи.ДатаНачала, "ДФ=dd.MM.yyyy"));
			
			Область.Параметры.Заполнить(ЗначенияПараметров);
			
			ДокументРезультат.Вывести(Область);
		Иначе
			Область = Макет.ПолучитьОбласть("ПериодСуществует");
			
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить("ДатаНач", Формат(ДанныеОписи.ДатаИнвентаризации, "ДФ=dd.MM.yyyy"));
			ЗначенияПараметров.Вставить("ДатаКон", Формат(ДанныеОписи.ДатаНачала, "ДФ=dd.MM.yyyy"));
			
			Область.Параметры.Заполнить(ЗначенияПараметров);
			
			ДокументРезультат.Вывести(Область);
		КонецЕсли;
		
		Если РежимФормирования = Коды.ПериодПроведенияИнвентаризации Тогда
			Область = Макет.ПолучитьОбласть("РазделНеФормируется");
			
			ДокументРезультат.Вывести(Область);
		КонецЕсли;
		
	ИначеЕсли НомерРаздела = 2 Тогда
		Область = Макет.ПолучитьОбласть("ПериодСуществует");
		
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("ДатаНач", Формат(ДанныеОписи.ДатаНачала, "ДФ=dd.MM.yyyy"));
		ЗначенияПараметров.Вставить("ДатаКон", Формат(ДанныеОписи.ДатаОкончания, "ДФ=dd.MM.yyyy"));
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
		ДокументРезультат.Вывести(Область);
		
		Если РежимФормирования = Коды.ОтДатыИнвентаризацииДоДатыНачалаПроведенияИнвентаризации Тогда
			Область = Макет.ПолучитьОбласть("РазделНеФормируется");
			
			ДокументРезультат.Вывести(Область);
		КонецЕсли;
	КонецЕсли;
	
	Область = Макет.ПолучитьОбласть("ПустаяСтрока");
	
	ДокументРезультат.Вывести(Область);
	
КонецПроцедуры

Процедура ВывестиРазделыОтчета(РежимФормирования, ДокументРезультат, Настройки, ДанныеРасшифровки, ТаблицаДокументов, Макет,
		ДанныеОписи, ИтогоКоличествоЗаписей)
	
	Перем КоличествоЗаписейРаздела;
	
	ТабДокСКД = ВывестиСКД(ДокументРезультат, Настройки, ДанныеРасшифровки, ТаблицаДокументов);
	
	НомераСтрокРазделов = ОпределитьНомераСтрокТабличногоДокументаСоответствующихРазделов(ТабДокСКД);
	
	ИтогоКоличествоЗаписей = 0;
	
	Для НомерРаздела = 1 По 2 Цикл
		ВывестиЗаголовокРаздела(НомерРаздела, РежимФормирования, ДокументРезультат, Макет, ДанныеОписи);
		
		ВывестиТаблицуРаздела(НомерРаздела, ДокументРезультат, ТабДокСКД, НомераСтрокРазделов);
		
		ВывестиПодвалРаздела(НомерРаздела, ДокументРезультат, Настройки, ТаблицаДокументов, Макет, КоличествоЗаписейРаздела);
		
		ИтогоКоличествоЗаписей = ИтогоКоличествоЗаписей + КоличествоЗаписейРаздела;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиТаблицуРаздела(НомерРаздела, ДокументРезультат, ТабДокСКД, НомераСтрокРазделов)
	
	НомераСтрокРаздела = НомераСтрокРазделов.Получить(НомерРаздела);
	
	ТабДокТаблицыСКД = ТабДокСКД.ПолучитьОбласть(НомераСтрокРаздела.ПерваяСтрока,, НомераСтрокРаздела.ПоследняяСтрока);
	
	ДокументРезультат.Вывести(ТабДокТаблицыСКД);
	
	НомерПоследнейСтроки = ДокументРезультат.ВысотаТаблицы;
	НомерПервойСтроки = НомерПоследнейСтроки - ТабДокТаблицыСКД.ВысотаТаблицы + 1;
	
	ОбластьТаблицы = ДокументРезультат.Область(НомерПервойСтроки,, НомерПоследнейСтроки);
	ОбластьТаблицы.СоздатьФорматСтрок();
	
	КоличествоКолонокСКД = ТабДокТаблицыСКД.ШиринаТаблицы;
	
	Для НомерКолонки = 1 По КоличествоКолонокСКД Цикл
		ОбластьКолонкиСКД = ТабДокСКД.Область(НомераСтрокРаздела.ПерваяСтрока, НомерКолонки, НомераСтрокРаздела.ПоследняяСтрока, НомерКолонки);
		
		ОбластьКолонки = ДокументРезультат.Область(НомерПервойСтроки, НомерКолонки, НомерПоследнейСтроки, НомерКолонки);
		ОбластьКолонки.ШиринаКолонки = ОбластьКолонкиСКД.ШиринаКолонки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиПодвалРаздела(НомерРаздела, ДокументРезультат, Настройки, ТаблицаДокументов, Макет, КоличествоЗаписейРаздела)
	
	Поиск = Новый Структура("НомерРаздела", НомерРаздела);
	
	ТаблицаДокументовРаздела = ТаблицаДокументов.Скопировать(Поиск);
	
	КоличествоЗаписейРаздела = ПолучитьКоличествоЗаписей(Настройки, ТаблицаДокументовРаздела);
	
	Область = Макет.ПолучитьОбласть("КоличествоЗаписейВРазделе");
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НомерРаздела", Формат(НомерРаздела, "ЧГ=0"));
	ЗначенияПараметров.Вставить("КоличествоЗаписей", Формат(КоличествоЗаписейРаздела, "ЧН=0"));
	
	Область.Параметры.Заполнить(ЗначенияПараметров);
	
	ДокументРезультат.Вывести(Область);
	
КонецПроцедуры

Функция ВывестиСКД(ДокументРезультат, Настройки, ДанныеРасшифровки, ТаблицаДокументов)
	
	ТабДокСКД = Новый ТабличныйДокумент();
	
	УстановитьИспользованиеПоляСчет(Настройки);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	ВнешниеНаборыДанных = Новый Структура();
	ВнешниеНаборыДанных.Вставить("ТаблицаДокументов", ТаблицаДокументов);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Ложь);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДокСКД);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат ТабДокСКД;
	
КонецФункции

Функция ОпределитьНомераСтрокТабличногоДокументаСоответствующихРазделов(ТабДокСКД)
	
	ТекстN = "N"; // Признак первой строки раздела.
	ТекстИтого = "Итого"; // Признак последней строки раздела.
	
	НомераСтрокРазделов = Новый Соответствие();
	
	ЯчейкаЦеликом = Истина;
	
	ОбластьНачалаПоиска = Неопределено;
	
	Для НомерРаздела = 1 По 2 Цикл
		ОбластьN = ТабДокСКД.НайтиТекст(ТекстN, ОбластьНачалаПоиска,, ЯчейкаЦеликом);
		ОбластьИтого = ТабДокСКД.НайтиТекст(ТекстИтого, ОбластьНачалаПоиска,, ЯчейкаЦеликом);
		
		ОбластьНачалаПоиска = ОбластьИтого;
		
		ПерваяСтрока = ОбластьN.Низ;
		ПоследняяСтрока = ОбластьИтого.Низ;
		
		НомераСтрокРаздела = Новый Структура();
		НомераСтрокРаздела.Вставить("ПерваяСтрока", ПерваяСтрока);
		НомераСтрокРаздела.Вставить("ПоследняяСтрока", ПоследняяСтрока);
		
		НомераСтрокРазделов.Вставить(НомерРаздела, НомераСтрокРаздела);
	КонецЦикла;
	
	Возврат НомераСтрокРазделов;
	
КонецФункции

Процедура ВывестиПодвалОтчета(ДокументРезультат, Макет, КоличествоЗаписей)
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("КоличествоЗаписей", Формат(КоличествоЗаписей, "ЧН=0"));
	
	Область = Макет.ПолучитьОбласть("Подвал");
	Область.Параметры.Заполнить(ЗначенияПараметров);
	
	ДокументРезультат.Вывести(Область);
	
КонецПроцедуры

Процедура УстановитьИспользованиеПоляСчет(Настройки)
	
	ВыводитьСписокСчетов = СтандартныеОтчетыКлиентСервер.ПолучитьПараметр(Настройки, "ВыводитьСписокСчетов").Значение;
	
	ПолеСчет = Новый ПолеКомпоновкиДанных("Счет");
	
	Для Каждого ВыбранноеПоле Из Настройки.Выбор.Элементы Цикл
		Если ВыбранноеПоле.Поле = ПолеСчет Тогда
			ВыбранноеПоле.Использование = ВыводитьСписокСчетов;
			
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьКоличествоЗаписей(Знач Настройки, Знач ТаблицаДокументов)
	
	// Поля свертки определяются полями группировки отчета.
	ИменаПолейГруппировки = Новый Массив();
	
	Для Каждого Элемент Из Настройки.Структура[0].ПоляГруппировки.Элементы Цикл
		ИменаПолейГруппировки.Добавить(Строка(Элемент.Поле));
	КонецЦикла;
	
	ТаблицаДокументов.Свернуть(СтрСоединить(ИменаПолейГруппировки, ","));
	
	Возврат ТаблицаДокументов.Количество();
	
КонецФункции

