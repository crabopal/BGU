#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура СформироватьОтчет(ТабДокумент) Экспорт
	
	ЛокальныеПеременные = Новый Структура;
	Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.60")).ЭлементГруппа Тогда
		ЛокальныеПеременные.Вставить("мСчет10961", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.61"));
	Иначе
		ЛокальныеПеременные.Вставить("мСчет10961", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.60"));
	КонецЕсли;
	ЛокальныеПеременные.Вставить("мСчет105", ПланыСчетов.ЕПСБУ.НайтиПоКоду("105.00"));
	ЛокальныеПеременные.Вставить("мЕстьНаправлениеДеятельности", БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(
																 ЛокальныеПеременные.мСчет10961,
																 ПланыВидовХарактеристик.ВидыСубконто.НаправленияДеятельности));
	ЛокальныеПеременные.Вставить("мТипПлановойСтоимости", Константы.ТипЦеныПлановойСебестоимостиПродукции.Получить());
	РассчитыватьСебестоимостьВКонцеГода = УчетПроизводства.РассчитыватьСебестоимостьВКонцеГода(Организация, КонецПериода);
	ЛокальныеПеременные.Вставить("РассчитыватьСебестоимостьВКонцеГода", РассчитыватьСебестоимостьВКонцеГода);
	
	ТабДокумент.Очистить();
	МассивНоменклатурныхГрупп = СписокНоменклатуры.ВыгрузитьЗначения();
	МассивРезультатов = ВыполнитьЗапрос(МассивНоменклатурныхГрупп, ЛокальныеПеременные);
	ДеревоЗатрат        = МассивРезультатов[4].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоСебестоимости = МассивРезультатов[5].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = ПолучитьМакет("Макет");
	ОбластьЗаголовок        = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка            = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока           = Макет.ПолучитьОбласть("Строка");
	ОбластьПодСтрока        = Макет.ПолучитьОбласть("ПодСтрока");
	ОбластьИтого            = Макет.ПолучитьОбласть("Итого");
	ОбластьВсего            = Макет.ПолучитьОбласть("Всего");
	ОбластьОкончаниеТаблицы = Макет.ПолучитьОбласть("ОкончаниеТаблицы");
	ОбластьОтветственный    = Макет.ПолучитьОбласть("Ответственный");
	
	ОрганизацияНаименование = Организация.НаименованиеПолное;
	
	СтрокаОтбора = "";
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		СтрокаОтбора = СтрокаОтбора + "ИФО - " + ?(ЗначениеЗаполнено(ИФО), ИФО, "<>, ");
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		СтрокаОтбора = СтрокаОтбора + "Подразделение - " + ?(ЗначениеЗаполнено(Подразделение), Подразделение, "<>")+", ";
	КонецЕсли;
	СтрокаОтбора = СтрокаОтбора + "КФО - " + КФО;
	Если ЛокальныеПеременные.мЕстьНаправлениеДеятельности Тогда
		СтрокаОтбора = СтрокаОтбора + ", Направление деятельности - " 
									+ ?(ЗначениеЗаполнено(НаправлениеДеятельности), НаправлениеДеятельности, "<>");
	КонецЕсли;	
	
	Для каждого СтрокаПериодЗатраты из ДеревоЗатрат.Строки Цикл
		Если ДеревоЗатрат.Строки.Индекс(СтрокаПериодЗатраты) > 0 Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		
		СтрокаПериодаСебестоимость = ДеревоСебестоимости.Строки.Найти(СтрокаПериодЗатраты.Период, "Период", Ложь);
		Если СтрокаПериодаСебестоимость = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		ОбластьЗаголовок.Параметры.ОрганизацияНаименование = ОрганизацияНаименование;
		Если ЛокальныеПеременные.РассчитыватьСебестоимостьВКонцеГода Тогда
			ПараметрДата = КонецГода(СтрокаПериодЗатраты.Период);
		Иначе
			ПараметрДата = КонецМесяца(СтрокаПериодЗатраты.Период);
		КонецЕсли;
		ОбластьЗаголовок.Параметры.Дата   = ПараметрДата; 
		ОбластьЗаголовок.Параметры.Период = "" + ПредставлениеПериода(НачалоМесяца(СтрокаПериодЗатраты.Период),
																	  ПараметрДата, 
																	  "ФП = Истина");
		ОбластьЗаголовок.Параметры.СтрокаОтбора = СтрокаОтбора;
		ТабДокумент.Вывести(ОбластьЗаголовок);
		ТабДокумент.Вывести(ОбластьШапка);
		
		СтоимостьПлановаяВсего = 0;
		СуммаВсего             = 0;
		СуммаОтклоненияВсего   = 0;
		КолСтрок = 0;
		Для каждого СтрокаНомГруппаЗатраты из СтрокаПериодЗатраты.Строки Цикл
			СтрокаНомГруппаСебестоимость = СтрокаПериодаСебестоимость.Строки.Найти(СтрокаНомГруппаЗатраты.НоменклатурнаяГруппа,
																				   "НоменклатурнаяГруппа", 
																				   Ложь);
			Если СтрокаНомГруппаСебестоимость = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			
			Для каждого СтрокаСчетЗатраты из СтрокаНомГруппаЗатраты.Строки Цикл
				СтрокаСчетСебестоимость = СтрокаНомГруппаСебестоимость.Строки.Найти(СтрокаСчетЗатраты.Счет, "Счет", Ложь);
				Если СтрокаСчетСебестоимость = Неопределено Тогда
					Продолжить;
				КонецЕсли;	
				
				Для каждого СтрокаДетальнаяЗатраты из СтрокаСчетЗатраты.Строки Цикл
					ЦветФонаГруппировки = ?(КолСтрок % 2 = 0, Новый Цвет(255, 212, 196), Новый Цвет);
					
					ОбластьСтрока.Параметры.Заполнить(СтрокаДетальнаяЗатраты); 
					ОбластьСтрока.Параметры.СчетЗатрат = БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(СтрокаДетальнаяЗатраты.Счет,,КФО);
					ОбластьСтрока.Параметры.СуммаНП = СтрокаДетальнаяЗатраты.КонечныйОстаток;
					ОбластьСтрока.Параметры.СуммаРасходовБезНП = СтрокаДетальнаяЗатраты.СуммаРасходов 
															   - СтрокаДетальнаяЗатраты.КонечныйОстаток;
					ТабДокумент.Вывести(ОбластьСтрока);
					ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, 2, ТабДокумент.ВысотаТаблицы, 12).ЦветФона 
																									= ЦветФонаГруппировки;
					
					МаксИндекс = СтрокаСчетСебестоимость.Строки.Количество() - 1;
					КоэффициентИтого = 0;
					Для каждого СтрокаДетальнаяСебестоимость из СтрокаСчетСебестоимость.Строки Цикл
						ОбластьПодСтрока.Параметры.Заполнить(СтрокаДетальнаяСебестоимость);
						ОбластьПодСтрока.Параметры.СуммаОтклонения = СтрокаДетальнаяСебестоимость.Сумма 
																   - СтрокаДетальнаяСебестоимость.СтоимостьПлановая;
						
						Если СтрокаСчетСебестоимость.Строки.Индекс(СтрокаДетальнаяСебестоимость) = МаксИндекс Тогда
							ОбластьПодСтрока.Параметры.Коэффициент = 1 - КоэффициентИтого;
						Иначе	
							ТекКоэффициент = СтрокаДетальнаяСебестоимость.Сумма / СтрокаСчетСебестоимость.Сумма;
							ОбластьПодСтрока.Параметры.Коэффициент = ТекКоэффициент;
							КоэффициентИтого = КоэффициентИтого + ТекКоэффициент;
						КонецЕсли;	
						
						ТабДокумент.Вывести(ОбластьПодСтрока);
						ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, 2, ТабДокумент.ВысотаТаблицы, 12).ЦветФона 
																										= ЦветФонаГруппировки;
					КонецЦикла;	
					
					ОбластьИтого.Параметры.Заполнить(СтрокаСчетСебестоимость);
					ТекОтклонение = СтрокаСчетСебестоимость.Сумма - СтрокаСчетСебестоимость.СтоимостьПлановая;
					ОбластьИтого.Параметры.СуммаОтклонения = ТекОтклонение;
					ТабДокумент.Вывести(ОбластьИтого);
					ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, 2, ТабДокумент.ВысотаТаблицы, 12).ЦветФона 
																									= ЦветФонаГруппировки;
					
					СтоимостьПлановаяВсего = СтоимостьПлановаяВсего + СтрокаСчетСебестоимость.СтоимостьПлановая;
					СуммаВсего             = СуммаВсего + СтрокаСчетСебестоимость.Сумма;
					СуммаОтклоненияВсего   = СуммаОтклоненияВсего + ТекОтклонение;
					КолСтрок = КолСтрок + 1;
				КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;	
		
		ОбластьВсего.Параметры.СуммаРасходов      = СтрокаПериодЗатраты.СуммаРасходов;
		ОбластьВсего.Параметры.СуммаНП            = СтрокаПериодЗатраты.КонечныйОстаток;
		ОбластьВсего.Параметры.СуммаРасходовБезНП = СтрокаПериодЗатраты.СуммаРасходов - СтрокаПериодЗатраты.КонечныйОстаток;
		ОбластьВсего.Параметры.СтоимостьПлановая  = СтоимостьПлановаяВсего;
		ОбластьВсего.Параметры.Сумма              = СуммаВсего;
		ОбластьВсего.Параметры.СуммаОтклонения    = СуммаОтклоненияВсего;
		ТабДокумент.Вывести(ОбластьВсего);
		ТабДокумент.Вывести(ОбластьОкончаниеТаблицы);
		ТабДокумент.Вывести(ОбластьОтветственный);
	КонецЦикла;	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ВыполнитьЗапрос(МассивНоменклатурныхГрупп, ЛокальныеПеременные)
	ОтборПоНоменклатурнымГруппам = "";
	ОтборПоНоменклатурнымГруппамДляЦен = "";
	Если МассивНоменклатурныхГрупп.Количество() > 0 Тогда
		ОтборПоНоменклатурнымГруппам = "
										|И Субконто1 В ИЕРАРХИИ (&МассивНоменклатуры)";
		ОтборПоНоменклатурнымГруппамДляЦен = "
										|И Номенклатура В ИЕРАРХИИ (&МассивНоменклатуры)";
	КонецЕсли;	
	
	ОтборПоНаправлениюДеятельности = "";
	Если ЛокальныеПеременные.мЕстьНаправлениеДеятельности Тогда
		ОтборПоНаправлениюДеятельности = "
										|И Субконто3 = &НаправлениеДеятельности";
	КонецЕсли;	
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЖурналПроводокЕПСБУОбороты.Период,
					|	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК НоменклатурнаяГруппа,
					|	ЖурналПроводокЕПСБУОбороты.Счет,
					|	СУММА(ЖурналПроводокЕПСБУОбороты.СуммаОборотДт) КАК СуммаОборотДт
					|ПОМЕСТИТЬ ТабЗатрат
					|ИЗ
					|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
					|			&ДатаНачала,
					|			&ДатаКонца,
					|			&Периодичность,
					|			Счет = &Счет10961,
					|			,
					|			Организация = &Организация
					|				И (ИФО = &ИФО или &ИФО = Значение(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
					|				И (Подразделение = &Подразделение или &Подразделение = Значение(Справочник.Подразделения.ПустаяСсылка))
					|				И КФО = &КФО" + ОтборПоНоменклатурнымГруппам + ОтборПоНаправлениюДеятельности + ",
					|			,
					|			) КАК ЖурналПроводокЕПСБУОбороты
					|
					|СГРУППИРОВАТЬ ПО
					|	ЖурналПроводокЕПСБУОбороты.Период,
					|	ЖурналПроводокЕПСБУОбороты.Субконто1,
					|	ЖурналПроводокЕПСБУОбороты.Счет
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЕПСБУОстаткиИОбороты.Период,
					|	ЕПСБУОстаткиИОбороты.Субконто1 КАК НоменклатурнаяГруппа,
					|	ЕПСБУОстаткиИОбороты.Счет,
					|	ЕПСБУОстаткиИОбороты.СуммаНачальныйОстаток,
					|	ЕПСБУОстаткиИОбороты.СуммаКонечныйОстаток
					|ПОМЕСТИТЬ ТабОстаткиНП
					|ИЗ
					|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
					|			&ДатаНачала,
					|			&Датаконца,
					|			&Периодичность,
					|			,
					|			Счет = &Счет10961,
					|			,
					|			Организация = &Организация
					|				И (ИФО = &ИФО или &ИФО = Значение(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
					|				И (Подразделение = &Подразделение или &Подразделение = Значение(Справочник.Подразделения.ПустаяСсылка))
					|				И КФО = &КФО" + ОтборПоНоменклатурнымГруппам + ОтборПоНаправлениюДеятельности + "
					|				) КАК ЕПСБУОстаткиИОбороты
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЖурналПроводокЕПСБУОбороты.Период,
					|	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК НоменклатурнаяГруппа,
					|	ЖурналПроводокЕПСБУОбороты.Счет,
					|	ЖурналПроводокЕПСБУОбороты.КорСубконто1 КАК Номенклатура,
					|	СУММА(ЖурналПроводокЕПСБУОбороты.СуммаОборотКт) КАК СуммаОборотКт,
					|	СУММА(ЖурналПроводокЕПСБУОбороты.КоличествоКорОборотКт) КАК КоличествоКорОборотКт
					|ПОМЕСТИТЬ ТабВыпуска
					|ИЗ
					|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
					|			&ДатаНачала,
					|			&ДатаКонца,
					|			&Периодичность,
					|			Счет = &Счет10961,
					|			,
					|			Организация = &Организация
					|				И (ИФО = &ИФО или &ИФО = Значение(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
					|				И (Подразделение = &Подразделение или &Подразделение = Значение(Справочник.Подразделения.ПустаяСсылка))
					|				И КФО = &КФО" + ОтборПоНоменклатурнымГруппам + ОтборПоНаправлениюДеятельности + ",
					|			КорСчет В ИЕРАРХИИ (&Счет105),
					|			) КАК ЖурналПроводокЕПСБУОбороты
					|
					|СГРУППИРОВАТЬ ПО
					|	ЖурналПроводокЕПСБУОбороты.Субконто1,
					|	ЖурналПроводокЕПСБУОбороты.КорСубконто1,
					|	ЖурналПроводокЕПСБУОбороты.Период,
					|	ЖурналПроводокЕПСБУОбороты.Счет
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
					|	ЦеныНоменклатурыСрезПоследних.Цена
					|ПОМЕСТИТЬ ТабЦен
					|ИЗ
					|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
					|			&ДатаКонца,
					|			Организация = &Организация
					|				И ТипЦен = &ТипПлановойСтоимости" + ОтборПоНоменклатурнымГруппамДляЦен + ") КАК ЦеныНоменклатурыСрезПоследних
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ВЫБОР
					|		КОГДА ТабЗатрат.Период ЕСТЬ NULL 
					|			ТОГДА ТабОстаткиНП.Период
					|		ИНАЧЕ ТабЗатрат.Период
					|	КОНЕЦ КАК Период,
					|	ВЫБОР
					|		КОГДА ТабЗатрат.НоменклатурнаяГруппа ЕСТЬ NULL 
					|			ТОГДА ТабОстаткиНП.НоменклатурнаяГруппа
					|		ИНАЧЕ ТабЗатрат.НоменклатурнаяГруппа
					|	КОНЕЦ КАК НоменклатурнаяГруппа,
					|	ВЫБОР
					|		КОГДА ТабЗатрат.Счет ЕСТЬ NULL 
					|			ТОГДА ТабОстаткиНП.Счет
					|		ИНАЧЕ ТабЗатрат.Счет
					|	КОНЕЦ КАК Счет,
					|	СУММА(ВЫБОР
					|			КОГДА ТабЗатрат.СуммаОборотДт ЕСТЬ NULL 
					|				ТОГДА 0
					|			ИНАЧЕ ТабЗатрат.СуммаОборотДт
					|		КОНЕЦ) КАК СуммаРасходов,
					|	МАКСИМУМ(ВЫБОР
					|			КОГДА ТабОстаткиНП.СуммаНачальныйОстаток ЕСТЬ NULL 
					|				ТОГДА 0
					|			ИНАЧЕ ТабОстаткиНП.СуммаНачальныйОстаток
					|		КОНЕЦ) КАК НачальныйОстаток,
					|	МАКСИМУМ(ВЫБОР
					|			КОГДА ТабОстаткиНП.СуммаКонечныйОстаток ЕСТЬ NULL 
					|				ТОГДА 0
					|			ИНАЧЕ ТабОстаткиНП.СуммаКонечныйОстаток
					|		КОНЕЦ) КАК КонечныйОстаток
					|ИЗ
					|	ТабЗатрат КАК ТабЗатрат
					|		ПОЛНОЕ СОЕДИНЕНИЕ ТабОстаткиНП КАК ТабОстаткиНП
					|		ПО ТабЗатрат.Период = ТабОстаткиНП.Период
					|			И ТабЗатрат.НоменклатурнаяГруппа = ТабОстаткиНП.НоменклатурнаяГруппа
					|			И ТабЗатрат.Счет = ТабОстаткиНП.Счет
					|
					|СГРУППИРОВАТЬ ПО
					|	ВЫБОР
					|		КОГДА ТабЗатрат.Период ЕСТЬ NULL 
					|			ТОГДА ТабОстаткиНП.Период
					|		ИНАЧЕ ТабЗатрат.Период
					|	КОНЕЦ,
					|	ВЫБОР
					|		КОГДА ТабЗатрат.НоменклатурнаяГруппа ЕСТЬ NULL 
					|			ТОГДА ТабОстаткиНП.НоменклатурнаяГруппа
					|		ИНАЧЕ ТабЗатрат.НоменклатурнаяГруппа
					|	КОНЕЦ,
					|	ВЫБОР
					|		КОГДА ТабЗатрат.Счет ЕСТЬ NULL 
					|			ТОГДА ТабОстаткиНП.Счет
					|		ИНАЧЕ ТабЗатрат.Счет
					|	КОНЕЦ
					|ИТОГИ
					|	СУММА(СуммаРасходов),
					|	МАКСИМУМ(НачальныйОстаток),
					|	МАКСИМУМ(КонечныйОстаток)
					|ПО
					|	Период,
					|	НоменклатурнаяГруппа,
					|	Счет
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ТабВыпуска.Период КАК Период,
					|	ТабВыпуска.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
					|	ТабВыпуска.Счет КАК Счет,
					|	ТабВыпуска.Номенклатура,
					|	ТабВыпуска.СуммаОборотКт КАК Сумма,
					|	ВЫБОР
					|		КОГДА ТабЦен.Цена ЕСТЬ NULL
					|			ТОГДА 0
					|		ИНАЧЕ ТабВыпуска.КоличествоКорОборотКт * ТабЦен.Цена
					|	КОНЕЦ  КАК СтоимостьПлановая
					|ИЗ
					|	ТабВыпуска КАК ТабВыпуска
					|		ЛЕВОЕ СОЕДИНЕНИЕ ТабЦен КАК ТабЦен
					|		ПО ТабВыпуска.Номенклатура = ТабЦен.Номенклатура
					|ИТОГИ
					|	СУММА(Сумма),
					|	СУММА(СтоимостьПлановая)
					|ПО
					|	Период,
					|	НоменклатурнаяГруппа,
					|	Счет";
	Если ЛокальныеПеременные.РассчитыватьСебестоимостьВКонцеГода Тогда
		Периодичность = "Год";
		НачалоПериода = НачалоГода(НачалоПериода);
	Иначе
		Периодичность = "Месяц";
		НачалоПериода = НачалоМесяца(НачалоПериода);
	КонецЕсли;

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Периодичность",                  Периодичность);
	
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("ДатаНачала", НачалоПериода);
	Запрос.УстановитьПараметр("ДатаКонца", КонецМесяца(КонецПериода));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИФО", ИФО);
	Запрос.УстановитьПараметр("КФО", КФО);
	Запрос.УстановитьПараметр("Счет10961", ЛокальныеПеременные.мСчет10961);
	Запрос.УстановитьПараметр("Счет105", ЛокальныеПеременные.мСчет105);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатурныхГрупп);
	Запрос.УстановитьПараметр("ТипПлановойСтоимости", ЛокальныеПеременные.мТипПлановойСтоимости);
	Если ЛокальныеПеременные.мЕстьНаправлениеДеятельности ТОгда
		Запрос.УстановитьПараметр("НаправлениеДеятельности", НаправлениеДеятельности);
	КонецЕсли;	
	
	МассивРезуьтат = Запрос.ВыполнитьПакет();
	
	Возврат МассивРезуьтат;
КонецФункции	

#КонецЕсли
