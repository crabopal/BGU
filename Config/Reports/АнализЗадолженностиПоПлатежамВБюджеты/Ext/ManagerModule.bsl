#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция АнализЗадолженностиПоПлатежамВБюджеты(Знач Организация, Знач НачалоПериода, Знач КонецПериода, Знач Отбор = Неопределено) Экспорт
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода",  КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Организация",    Организация);
	Запрос.УстановитьПараметр("Счета30300", БухгалтерскийУчет.СписокСчетов("303.00"));
	Запрос.УстановитьПараметр("Счет30314", БухгалтерскийУчет.СписокСчетов("303.14")); // Расчеты по единому налоговому платежу.
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиИОбороты30300.Организация КАК Организация,
	|	ОстаткиИОбороты30300.ИФО КАК ИФО,
	|	ОстаткиИОбороты30300.КФО КАК КФО,
	|	ОстаткиИОбороты30300.КПС КАК КПС,
	|	ОстаткиИОбороты30300.Подразделение КАК Подразделение,
	|	ОстаткиИОбороты30300.Счет30300 КАК Счет30300,
	|	ОстаткиИОбороты30300.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа,
	|	ОстаткиИОбороты30300.НалогСборПлатеж КАК НалогСборПлатеж,
	|	ОстаткиИОбороты30300.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	|	ОстаткиИОбороты30300.СуммаОборотДт КАК СуммаОборотДт,
	|	ОстаткиИОбороты30300.СуммаОборотКт КАК СуммаОборотКт,
	|	ОстаткиИОбороты30300.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
	|ИЗ
	|	(ВЫБРАТЬ
	|		Счет303ОстаткиИОбороты.Организация КАК Организация,
	|		Счет303ОстаткиИОбороты.ИФО КАК ИФО,
	|		Счет303ОстаткиИОбороты.КФО КАК КФО,
	|		Счет303ОстаткиИОбороты.КПС КАК КПС,
	|		Счет303ОстаткиИОбороты.Подразделение КАК Подразделение,
	|		Счет303ОстаткиИОбороты.Счет КАК Счет30300,
	|		ВЫРАЗИТЬ(Счет303ОстаткиИОбороты.Субконто1 КАК Справочник.ВидыНалоговИПлатежей) КАК ВидНалогаИлиПлатежа,
	|		ВЫРАЗИТЬ(Счет303ОстаткиИОбороты.Субконто2 КАК Справочник.НалогиИПлатежиОрганизации) КАК НалогСборПлатеж,
	|		Счет303ОстаткиИОбороты.СуммаНачальныйОстатокКт КАК СуммаНачальныйОстаток,
	|		Счет303ОстаткиИОбороты.СуммаОборотДт КАК СуммаОборотДт,
	|		Счет303ОстаткиИОбороты.СуммаОборотКт КАК СуммаОборотКт,
	|		Счет303ОстаткиИОбороты.СуммаКонечныйОстатокКт КАК СуммаКонечныйОстаток
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				,
	|				,
	|				Счет В (&Счета30300)
	|					И НЕ Счет В (&Счет30314),
	|				,
	|				Организация = &Организация
	|					И &УсловиеПоИФО
	|					И &УсловиеПоКФО
	|					И &УсловиеПоКПС
	|					И &УсловиеПоСубконто1) КАК Счет303ОстаткиИОбороты) КАК ОстаткиИОбороты30300
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиИОбороты30300.Организация,
	|	ОстаткиИОбороты30300.ИФО,
	|	ОстаткиИОбороты30300.КФО,
	|	ОстаткиИОбороты30300.КПС,
	|	ОстаткиИОбороты30300.Подразделение,
	|	ОстаткиИОбороты30300.Счет30300,
	|	ОстаткиИОбороты30300.ВидНалогаИлиПлатежа,
	|	ОстаткиИОбороты30300.НалогСборПлатеж,
	|	ОстаткиИОбороты30300.СуммаНачальныйОстаток,
	|	ОстаткиИОбороты30300.СуммаОборотДт,
	|	ОстаткиИОбороты30300.СуммаОборотКт,
	|	ОстаткиИОбороты30300.СуммаКонечныйОстаток
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СрокиИсполненияПоПлатежамВБюджеты.Организация КАК Организация,
	|	СрокиИсполненияПоПлатежамВБюджеты.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа,
	|	СрокиИсполненияПоПлатежамВБюджеты.НалогСборПлатеж КАК НалогСборПлатеж,
	|	СрокиИсполненияПоПлатежамВБюджеты.Счет КАК Счет30300,
	|	СрокиИсполненияПоПлатежамВБюджеты.ИФО КАК ИФО,
	|	СрокиИсполненияПоПлатежамВБюджеты.КФО КАК КФО,
	|	СрокиИсполненияПоПлатежамВБюджеты.КПС КАК КПС,
	|	СрокиИсполненияПоПлатежамВБюджеты.Подразделение КАК Подразделение,
	|	СрокиИсполненияПоПлатежамВБюджеты.СрокИсполнения КАК СрокИсполнения,
	|	СрокиИсполненияПоПлатежамВБюджеты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	|	СрокиИсполненияПоПлатежамВБюджеты.СуммаПриход КАК СуммаНачислено,
	|	СрокиИсполненияПоПлатежамВБюджеты.СуммаРасход КАК СуммаОплачено,
	|	СрокиИсполненияПоПлатежамВБюджеты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
	|ИЗ
	|	РегистрНакопления.СрокиИсполненияПоПлатежамВБюджеты.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			,
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКФО
	|				И &УсловиеПоКПС
	|				И &УсловиеПоВидНалогаИлиПлатежа) КАК СрокиИсполненияПоПлатежамВБюджеты
	|
	|УПОРЯДОЧИТЬ ПО
	|	СрокИсполнения";
	
	УстановитьОтборОстатков(Запрос, Отбор);
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("ОстаткиИОбороты30300", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СрокиИсполненияПоПлатежамВБюджеты", НомераТаблиц.Количество());
	
	Результат = Запрос.ВыполнитьПакет();
	
	АнализЗадолженности = Результат[НомераТаблиц.СрокиИсполненияПоПлатежамВБюджеты].Выгрузить();
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
	АнализЗадолженности.Колонки.Добавить("СуммаНачальныйОстаток30300", ОписаниеТипаСуммы);
	АнализЗадолженности.Колонки.Добавить("СуммаНачислено30300", ОписаниеТипаСуммы);
	АнализЗадолженности.Колонки.Добавить("СуммаОплачено30300", ОписаниеТипаСуммы);
	АнализЗадолженности.Колонки.Добавить("СуммаКонечныйОстаток30300", ОписаниеТипаСуммы);
	
	// Классификация задолженности.
	НаДату = ?(ТипЗнч(КонецПериода) = Тип("Дата"), КонецПериода, КонецПериода.Дата); // Просроченную задолженность рассчитываем на конец периода.
	ДатаПросрочено = КонецДня(НаДату);
	ДатаПросроченоБолее30Дней = КонецДня(НаДату - 31*24*60*60);
	ДатаПросроченоБолее60Дней = КонецДня(НаДату - 61*24*60*60);
	ДатаПросроченоБолее90Дней = КонецДня(НаДату - 91*24*60*60);
	ДатаПросроченоБолее1Года = КонецДня(ДобавитьМесяц(НаДату, -12));
	ДатаПросроченоБолее3Лет = КонецДня(ДобавитьМесяц(НаДату, -3*12));
	АнализЗадолженности.Колонки.Добавить("Просроченная",            ОписаниеТипаСуммы); // Менее отчетной даты = просроченная итого.
	АнализЗадолженности.Колонки.Добавить("ПросроченнаяБолее30Дней", ОписаниеТипаСуммы); // Просроченная более 30 дней.
	АнализЗадолженности.Колонки.Добавить("ПросроченнаяБолее60Дней", ОписаниеТипаСуммы); // Просроченная более 60 дней.
	АнализЗадолженности.Колонки.Добавить("ПросроченнаяБолее90Дней", ОписаниеТипаСуммы); // Просроченная более 90 дней.
	АнализЗадолженности.Колонки.Добавить("ПросроченнаяБолее1Года",  ОписаниеТипаСуммы); // Просроченная более 1 года от отчетной даты.
	АнализЗадолженности.Колонки.Добавить("ПросроченнаяБолее3Лет",   ОписаниеТипаСуммы); // Просроченная более 3-х лет от отчетной даты.
	
	АнализЗадолженности.Колонки.Добавить("ЭтоНераспределенныйОстаток", Новый ОписаниеТипов("Булево"));
	
	АнализЗадолженности.Индексы.Добавить("Организация,КФО,КПС,Счет30300,ВидНалогаИлиПлатежа,ЭтоНераспределенныйОстаток"
		+ ?(ИспользоватьУчетПоИФО, ",ИФО", ""));
	
	ТаблицаОстаткиИОбороты30300 = Результат[НомераТаблиц.ОстаткиИОбороты30300].Выгрузить();
	
	СписокСчетов30300 = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТаблицаОстаткиИОбороты30300.ВыгрузитьКолонку("Счет30300"));
	СвойстваСчетов30300 = БухгалтерскийУчет.ПолучитьСвойстваСчетов(СписокСчетов30300);
	
	Для Каждого Строка30300 Из ТаблицаОстаткиИОбороты30300 Цикл
		
		НераспределеннаяСуммаНачальныйОстаток = Строка30300.СуммаНачальныйОстаток;
		НераспределеннаяСуммаОборотДт = Строка30300.СуммаОборотДт;
		НераспределеннаяСуммаОборотКт = Строка30300.СуммаОборотКт;
		НераспределеннаяСуммаКонечныйОстаток = Строка30300.СуммаКонечныйОстаток;
		Если НераспределеннаяСуммаНачальныйОстаток = 0
			И НераспределеннаяСуммаОборотДт = 0
			И НераспределеннаяСуммаОборотКт = 0
			И НераспределеннаяСуммаКонечныйОстаток = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборПоОстаткам = Новый Структура("Организация,КФО,КПС,Счет30300,ВидНалогаИлиПлатежа");
		ЗаполнитьЗначенияСвойств(ОтборПоОстаткам, Строка30300);
		ОтборПоОстаткам.Вставить("ЭтоНераспределенныйОстаток", Ложь);
		Если ИспользоватьУчетПоИФО Тогда
			ОтборПоОстаткам.Вставить("ИФО", Строка30300.ИФО);
		КонецЕсли;
		СвойстваСчета30300 = СвойстваСчетов30300[Строка30300.Счет30300];
		Если ИспользоватьУчетПоПодразделениям И СвойстваСчета30300.УчетПоПодразделениям Тогда
			ОтборПоОстаткам.Вставить("Подразделение", Строка30300.Подразделение);
		КонецЕсли;
		Если ЗначениеЗаполнено(СвойстваСчета30300.ВидСубконто2)
			И СвойстваСчета30300.ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.НалогиИПлатежиОрганизации Тогда
			ОтборПоОстаткам.Вставить("НалогСборПлатеж", Строка30300.НалогСборПлатеж);
		КонецЕсли;
		НайденныеСтроки = АнализЗадолженности.НайтиСтроки(ОтборПоОстаткам);
		
		Для Каждого СтрокаАнализЗадолженности Из НайденныеСтроки Цикл
			
			// Распределяем остатки и обороты 303.00 по соответсвующим остаткам и оборотам регистра с тем же знаком (по срокам исполнения).
			Если СтрокаАнализЗадолженности.СуммаНачальныйОстаток > 0 И Строка30300.СуммаНачальныйОстаток > 0 Тогда
				ПогашеннаяСуммаНачальныйОстаток = Мин(СтрокаАнализЗадолженности.СуммаНачальныйОстаток, Строка30300.СуммаНачальныйОстаток);
			ИначеЕсли СтрокаАнализЗадолженности.СуммаНачальныйОстаток < 0 И Строка30300.СуммаНачальныйОстаток < 0 Тогда
				ПогашеннаяСуммаНачальныйОстаток = Макс(СтрокаАнализЗадолженности.СуммаНачальныйОстаток, Строка30300.СуммаНачальныйОстаток);
			Иначе
				ПогашеннаяСуммаНачальныйОстаток = 0;
			КонецЕсли;
			
			Если СтрокаАнализЗадолженности.СуммаОплачено > 0 И Строка30300.СуммаОборотДт > 0 Тогда
				ПогашеннаяСуммаОборотДт = Мин(СтрокаАнализЗадолженности.СуммаОплачено, Строка30300.СуммаОборотДт);
			ИначеЕсли СтрокаАнализЗадолженности.СуммаОплачено < 0 И Строка30300.СуммаОборотДт < 0 Тогда
				ПогашеннаяСуммаОборотДт = Макс(СтрокаАнализЗадолженности.СуммаОплачено, Строка30300.СуммаОборотДт);
			Иначе
				ПогашеннаяСуммаОборотДт = 0;
			КонецЕсли;
			
			Если СтрокаАнализЗадолженности.СуммаНачислено > 0 И Строка30300.СуммаОборотКт > 0 Тогда
				ПогашеннаяСуммаОборотКт = Мин(СтрокаАнализЗадолженности.СуммаНачислено, Строка30300.СуммаОборотКт);
			ИначеЕсли СтрокаАнализЗадолженности.СуммаНачислено < 0 И Строка30300.СуммаОборотДт < 0 Тогда
				ПогашеннаяСуммаОборотКт = Макс(СтрокаАнализЗадолженности.СуммаНачислено, Строка30300.СуммаОборотКт);
			Иначе
				ПогашеннаяСуммаОборотКт = 0;
			КонецЕсли;
			
			Если СтрокаАнализЗадолженности.СуммаКонечныйОстаток > 0 И Строка30300.СуммаКонечныйОстаток > 0 Тогда
				ПогашеннаяСуммаКонечныйОстаток = Мин(СтрокаАнализЗадолженности.СуммаКонечныйОстаток, Строка30300.СуммаКонечныйОстаток);
			ИначеЕсли СтрокаАнализЗадолженности.СуммаКонечныйОстаток < 0 И Строка30300.СуммаНачальныйОстаток < 0 Тогда
				ПогашеннаяСуммаКонечныйОстаток = Макс(СтрокаАнализЗадолженности.СуммаКонечныйОстаток, Строка30300.СуммаКонечныйОстаток);
			Иначе
				ПогашеннаяСуммаКонечныйОстаток = 0;
			КонецЕсли;
			
			СтрокаАнализЗадолженности.СуммаНачальныйОстаток30300 = ПогашеннаяСуммаНачальныйОстаток;
			СтрокаАнализЗадолженности.СуммаНачислено30300        = ПогашеннаяСуммаОборотКт;
			СтрокаАнализЗадолженности.СуммаОплачено30300         = ПогашеннаяСуммаОборотДт;
			СтрокаАнализЗадолженности.СуммаКонечныйОстаток30300  = ПогашеннаяСуммаКонечныйОстаток;
			
			НераспределеннаяСуммаНачальныйОстаток = НераспределеннаяСуммаНачальныйОстаток - ПогашеннаяСуммаНачальныйОстаток;
			НераспределеннаяСуммаОборотДт = НераспределеннаяСуммаОборотДт - ПогашеннаяСуммаОборотДт;
			НераспределеннаяСуммаОборотКт = НераспределеннаяСуммаОборотКт - ПогашеннаяСуммаОборотКт;
			НераспределеннаяСуммаКонечныйОстаток = НераспределеннаяСуммаКонечныйОстаток - ПогашеннаяСуммаКонечныйОстаток;
			
			// Рассчитываем пропроченную задолженность.
			Если СтрокаАнализЗадолженности.СрокИсполнения <= ДатаПросрочено Тогда
				СтрокаАнализЗадолженности.Просроченная = СтрокаАнализЗадолженности.Просроченная + ПогашеннаяСуммаКонечныйОстаток;
			КонецЕсли;
			Если СтрокаАнализЗадолженности.СрокИсполнения <= ДатаПросроченоБолее30Дней Тогда
				СтрокаАнализЗадолженности.ПросроченнаяБолее30Дней = СтрокаАнализЗадолженности.ПросроченнаяБолее30Дней + ПогашеннаяСуммаКонечныйОстаток;
			КонецЕсли;
			Если СтрокаАнализЗадолженности.СрокИсполнения <= ДатаПросроченоБолее60Дней Тогда
				СтрокаАнализЗадолженности.ПросроченнаяБолее60Дней = СтрокаАнализЗадолженности.ПросроченнаяБолее60Дней + ПогашеннаяСуммаКонечныйОстаток;
			КонецЕсли;
			Если СтрокаАнализЗадолженности.СрокИсполнения <= ДатаПросроченоБолее90Дней Тогда
				СтрокаАнализЗадолженности.ПросроченнаяБолее90Дней = СтрокаАнализЗадолженности.ПросроченнаяБолее90Дней + ПогашеннаяСуммаКонечныйОстаток;
			КонецЕсли;
			Если СтрокаАнализЗадолженности.СрокИсполнения <= ДатаПросроченоБолее1Года Тогда
				СтрокаАнализЗадолженности.ПросроченнаяБолее1Года = СтрокаАнализЗадолженности.ПросроченнаяБолее1Года + ПогашеннаяСуммаКонечныйОстаток;
			КонецЕсли;
			Если СтрокаАнализЗадолженности.СрокИсполнения <= ДатаПросроченоБолее3Лет Тогда
				СтрокаАнализЗадолженности.ПросроченнаяБолее3Лет = СтрокаАнализЗадолженности.ПросроченнаяБолее3Лет + ПогашеннаяСуммаКонечныйОстаток;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ (НераспределеннаяСуммаНачальныйОстаток = 0
			И НераспределеннаяСуммаОборотДт = 0
			И НераспределеннаяСуммаОборотКт = 0
			И НераспределеннаяСуммаКонечныйОстаток = 0) Тогда // Не все остатки и обороты 303.00 удалось классифицировать по срокам исполнения.
			
			// Добавляем нераспределенные суммы отдельной строкой.
			НоваяСтрока = АнализЗадолженности.Добавить();
			НоваяСтрока.ЭтоНераспределенныйОстаток = Истина;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка30300,
				"Организация,ВидНалогаИлиПлатежа,НалогСборПлатеж,Счет30300,ИФО,КФО,КПС");
			
			НоваяСтрока.СуммаНачальныйОстаток30300 = НераспределеннаяСуммаНачальныйОстаток;
			НоваяСтрока.СуммаНачислено30300        = НераспределеннаяСуммаОборотКт;
			НоваяСтрока.СуммаОплачено30300         = НераспределеннаяСуммаОборотДт;
			НоваяСтрока.СуммаКонечныйОстаток30300  = НераспределеннаяСуммаКонечныйОстаток;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат АнализЗадолженности;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ЭтоРегистрУчета() Экспорт
	
	Возврат Истина;
	
КонецФункции

Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт   
	
	ПараметрПериод = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	Если НЕ ПараметрПериод = Неопределено Тогда
		Период = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрПериод.ИдентификаторПользовательскойНастройки);
		Если НЕ Период = Неопределено Тогда
			СвойстваРегистраУчета.Вставить("НачалоПериода", Период.Значение.ДатаНачала);
			СвойстваРегистраУчета.Вставить("КонецПериода", 	Период.Значение.ДатаОкончания);
		КонецЕсли;
	КонецЕсли;
	
	ПараметрОрганизация = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация"));
	Если НЕ ПараметрОрганизация = Неопределено Тогда
		Организация = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрОрганизация.ИдентификаторПользовательскойНастройки);
		Если НЕ Организация = Неопределено Тогда
			СвойстваРегистраУчета.Вставить("Организация", Организация.Значение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "Основной");
	НастройкиВарианта.Включен = Истина;
	НастройкиВарианта.Описание = НСтр("ru = 'Анализ задолженности по платежам в бюджеты'");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьОтборОстатков(Запрос, ОтборОстатков)
	
	Если ТипЗнч(ОтборОстатков) = Тип("Структура") Тогда
		ТипОтбораОстатков = "Структура";
	ИначеЕсли ТипЗнч(ОтборОстатков) = Тип("ТаблицаЗначений") Тогда
		ТипОтбораОстатков = "ТаблицаЗначений";
	Иначе
		ТипОтбораОстатков = "Отсутствует";
	КонецЕсли;
	
	// ИФО.
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Если ИспользоватьУчетПоИФО И ТипОтбораОстатков = "ТаблицаЗначений"
		И ОтборОстатков.Колонки.Найти("ИФО") <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИФО В (&ИФО)");
		Запрос.УстановитьПараметр("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ОтборОстатков.ВыгрузитьКолонку("ИФО")) );
	ИначеЕсли ИспользоватьУчетПоИФО И ТипОтбораОстатков = "Структура" И ОтборОстатков.Свойство("ИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИФО В (&ИФО)");
		Запрос.УстановитьПараметр("ИФО", ОтборОстатков.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИСТИНА");
	КонецЕсли;
	
	// КФО.
	Если ТипОтбораОстатков = "ТаблицаЗначений"
		И ОтборОстатков.Колонки.Найти("КФО") <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "КФО В (&КФО)");
		Запрос.УстановитьПараметр("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ОтборОстатков.ВыгрузитьКолонку("КФО")) );
	ИначеЕсли ТипОтбораОстатков = "Структура" И ОтборОстатков.Свойство("КФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "КФО В (&КФО)");
		Запрос.УстановитьПараметр("КФО", ОтборОстатков.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "ИСТИНА");
	КонецЕсли;
	
	// КПС.
	Если ТипОтбораОстатков = "ТаблицаЗначений" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКПС", "КПС В (&КПС)");
		Запрос.УстановитьПараметр("КПС", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ОтборОстатков.ВыгрузитьКолонку("КПС")) );
	ИначеЕсли ТипОтбораОстатков = "Структура" И ОтборОстатков.Свойство("КПС") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКПС", "КПС В (&КПС)");
		Запрос.УстановитьПараметр("КПС", ОтборОстатков.КПС);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКПС", "ИСТИНА");
	КонецЕсли;
	
	// ВидНалогаИлиПлатежа.
	Если ТипОтбораОстатков = "ТаблицаЗначений"
		И ОтборОстатков.Колонки.Найти("ВидНалогаИлиПлатежа") <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоВидНалогаИлиПлатежа", "ВидНалогаИлиПлатежа В (&ВидНалогаИлиПлатежа)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСубконто1", "Субконто1 В (&ВидНалогаИлиПлатежа)");
		Запрос.УстановитьПараметр("ВидНалогаИлиПлатежа", ОтборОстатков.ВыгрузитьКолонку("ВидНалогаИлиПлатежа"));
	ИначеЕсли ТипОтбораОстатков = "Структура" И ОтборОстатков.Свойство("ВидНалогаИлиПлатежа") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоВидНалогаИлиПлатежа", "ВидНалогаИлиПлатежа В (&ВидНалогаИлиПлатежа)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСубконто1", "Субконто1 В (&ВидНалогаИлиПлатежа)");
		Запрос.УстановитьПараметр("ВидНалогаИлиПлатежа", ОтборОстатков.ВидНалогаИлиПлатежа);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоВидНалогаИлиПлатежа", "ИСТИНА");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСубконто1", "ИСТИНА");
	КонецЕсли;
	
	// СрокИсполнения.
	УсловиеСрокИсполнения = "";
	Если ТипОтбораОстатков = "Структура" И ОтборОстатков.Свойство("СрокИсполнения") Тогда
		УсловиеПоСрокИсполнения = "СрокИсполнения = &СрокИсполнения";
		Запрос.УстановитьПараметр("СрокИсполнения", НачалоДня(ОтборОстатков.СрокИсполнения));
	КонецЕсли;
	// СрокИсполненияНеРанее.
	Если ТипОтбораОстатков = "Структура" И ОтборОстатков.Свойство("СрокИсполненияНеРанее") Тогда
		УсловиеПоСрокИсполнения = ?(ПустаяСтрока(УсловиеПоСрокИсполнения), "", УсловиеПоСрокИсполнения + " И ") +
			"СрокИсполнения >= &СрокИсполненияНеРанее";
		Запрос.УстановитьПараметр("СрокИсполненияНеРанее", НачалоДня(ОтборОстатков.СрокИсполненияНеРанее));
	КонецЕсли;
	// СрокИсполненияНеПозднее.
	Если ТипОтбораОстатков = "Структура" И ОтборОстатков.Свойство("СрокИсполненияНеПозднее") Тогда
		УсловиеПоСрокИсполнения = ?(ПустаяСтрока(УсловиеПоСрокИсполнения), "", УсловиеПоСрокИсполнения + " И ") +
			"СрокИсполнения <= &СрокИсполненияНеПозднее";
		Запрос.УстановитьПараметр("СрокИсполненияНеПозднее", КонецДня(ОтборОстатков.СрокИсполненияНеПозднее));
	КонецЕсли;
	Если ПустаяСтрока(УсловиеПоСрокИсполнения) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСрокИсполнения", "ИСТИНА");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСрокИсполнения", УсловиеПоСрокИсполнения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли