Функция ЭтоРегистрУчета() Экспорт
	
	Возврат Истина;
	
КонецФункции

Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	СтандартныеОтчеты.СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета);
	
	ДополнениеИмени = "";
	
	Если ОтчетОбъект.Фондовые = 1 И ПолучитьФункциональнуюОпцию("ФондоваяКнигаОтдельноОтДенежной") Тогда
		ДополнениеИмени = ДополнениеИмени + " Денежная касса";
	ИначеЕсли ОтчетОбъект.Фондовые = 2 Тогда
		ДополнениеИмени = ДополнениеИмени + " Фондовая касса";
	КонецЕсли;	
	
	СвойстваРегистраУчета.Вставить("ДополнениеИмени", ДополнениеИмени);
		
КонецПроцедуры	

