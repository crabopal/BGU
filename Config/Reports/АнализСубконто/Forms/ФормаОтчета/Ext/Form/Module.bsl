#Область ОписаниеПеременных

&НаКлиенте
Перем ПараметрыОбработчикаОжидания;

&НаКлиенте
Перем УИДЗамера;

// Псевдоконстанты
&НаКлиенте
Функция ДЛИТЕЛЬНОСТЬ_ОЖИДАНИЯ()	Возврат 1; КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтандартныеОтчеты.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Отчет.СписокВидовСубконто.ТипЗначения = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
    СтандартныеОтчеты.ДобавитьИзмеренияВГруппировки(Отчет.Группировка);
    СтандартныеОтчеты.ЗаполнитьПодписиПоУмолчанию(Отчет.Подписи);
	
	УправлениеФормой(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьТекстЗаголовка(ЭтаФорма);
		
	Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Если НЕ СтандартныеПодсистемыКлиент.ПараметрыРаботыКлиента().ИнформационнаяБазаФайловая Тогда
			ОбновитьОбработчикОжидания();
		КонецЕсли;
	КонецЕсли;
	
	СтандартныеОтчетыКлиент.ПриОткрытии(ЭтаФорма);
	ЭтаФорма.КлючУникальности = ТекущаяДата();
	РассчитатьПоказатели();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	СтандартнаяОбработка = НЕ Отчет.РежимРасшифровки;

	ВариантМодифицирован                    = Ложь;
	ПользовательскиеНастройкиМодифицированы = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	СтандартныеОтчеты.ПриСохраненииПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
    // Заплатка. Случайно попали пустые "Подписи" в сохраненные настройки. Нужно убрать.
    Попытка
        ДопНастройки = Настройки.ДополнительныеСвойства.ДанныеОтчета.Получить();
        Если ДопНастройки.Свойство("Подписи") И ДопНастройки.Подписи.Количество() = 0 Тогда
            ДопНастройки.Удалить("Подписи");
        КонецЕсли;
    Исключение
    КонецПопытки;
    
	Если Не КомпоновщикИнициализирован Тогда
		ПользовательскиеНастройки = ПоместитьВоВременноеХранилище(Настройки, УникальныйИдентификатор);
	КонецЕсли;
	
    СтандартныеОтчеты.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
    СтандартныеОтчеты.ДобавитьИзмеренияВГруппировки(Отчет.Группировка);
	ИзменениеСхемыКомпоновкиДанных();
	ЗаполнитьПризнакиУчета();
	УправлениеФормой(ЭтаФорма);
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	СтандартныеОтчеты.ДобавитьОтборПоОрганизации(ЭтаФорма.Отчет);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	СтандартныеОтчетыКлиентСервер.ИзменитьОтборПоОрганизации(Отчет);
    
    СтандартныеОтчетыКлиент.ПриИзмененииОрганизации(Отчет.Организация, Отчет.Подписи);
	
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
	ИзменениеКонтроловВлияющееНаРезультат(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеКонтроловВлияющееНаРезультат(Элемент)
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартныеОтчетыКлиент.ОбработкаРасшифровкиСтандартногоОтчета(ЭтаФорма, Элемент, Расшифровка, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	// Не будем обрабатывать нажатие на правую кнопку мыши.
	// Покажем стандартное контекстное меню ячейки табличного документа.
	Расшифровка = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент)
	
	ПодключитьОбработчикОжидания("РассчитатьПоказателиДинамически", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ИзменениеПериода(Элемент)
	
	СтандартныеОтчетыКлиент.УстановитьВидМежотчетногоПериодаПоДате(Отчет);
	
    СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПериодаПриИзменении(Элемент)
	
	СтандартныеОтчетыКлиент.УстановитьДатыПоВидуПериода(Отчет);
	
	Модифицированность = Истина;
	
	ОбновитьТекстЗаголовка(ЭтотОбъект);
		
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);

	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоУказанныйПериодПриИзменении(Элемент)
	
	
	СтандартныеОтчетыКлиент.УстановитьДатыПоВидуПериода(Отчет);
	
	Модифицированность = Истина;
	
	ОбновитьТекстЗаголовка(ЭтотОбъект);
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтотОбъект);
	
КонецПроцедуры

// ----------------------------------------------------------------------------
&НаКлиенте
Процедура ПодписиВыводитьПриИзменении(Элемент)

    СтандартныеОтчетыКлиент.ПодписиВыводитьПриИзменении(Элемент.Родитель.ТекущиеДанные, ЭтаФорма.Результат);

КонецПроцедуры

&НаКлиенте
Процедура ПодписиПередНачаломИзменения(Элемент, Отказ)

    Отказ = СтандартныеОтчетыКлиент.ПодписиПередНачаломИзменения(Элемент.ТекущийЭлемент, Элемент.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ПодписиСотрудникПриИзменении(Элемент)

    СтандартныеОтчетыКлиент.ПодписиСотрудникПриИзменении(Элемент.Родитель.ТекущиеДанные, ЭтаФорма.Результат);

КонецПроцедуры

// Дополнительные поля

// Оформление

&НаКлиенте
Процедура ВыводитьЗаголовокПриИзменении(Элемент)

	ОбластьПоиска = Результат.Области.Найти("Заголовок");
	Если ОбластьПоиска = Неопределено Тогда
		СформироватьОтчет(Ложь);
	Иначе
		ОбластьПоиска.Видимость = ВыводитьЗаголовок;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыводитьПодвалПриИзменении(Элемент)
	
	ОбластьПоиска = Результат.Области.Найти("Подписи");
	Если ОбластьПоиска = Неопределено Тогда
		СформироватьОтчет(Ложь);
	Иначе
		ОбластьПоиска.Видимость = ВыводитьПодвал;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура МакетОформленияПриИзменении(Элемент)
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(Отчет.КомпоновщикНастроек.Настройки, "МакетОформления", МакетОформления);
	
	ИзменениеКонтроловВлияющееНаРезультат(Элемент);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
