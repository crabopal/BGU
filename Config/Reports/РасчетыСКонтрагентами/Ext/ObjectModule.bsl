#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Настройки общей формы отчета подсистемы "Варианты отчетов".
//
// Параметры:
//   Форма - УправляемаяФорма - Форма отчета.
//   КлючВарианта - Строка - Имя предопределенного варианта отчета или уникальный идентификатор пользовательского.
//   Настройки - Структура - см. возвращаемое значение ФункцииОтчетовКлиентСервер.ПолучитьНастройкиОтчетаПоУмолчанию().
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.Печать.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	// Установим параметры основной СКД.
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки,
		"Организация", Организация, ЗначениеЗаполнено(Организация));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки,
		"Контрагент", Контрагент, ЗначениеЗаполнено(Контрагент));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки,
		"Договор", Договор, ЗначениеЗаполнено(Договор));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки,
		"ПолнаяЗадолженностьПоДолгосрочнымДоговорам", ПолнаяЗадолженностьПоДолгосрочнымДоговорам, Истина);
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки,
			"НачалоПериода", НачалоДня(НачалоПериода), Истина);
	Иначе
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки,
			"НачалоПериода", НачалоПериода, Истина);
	КонецЕсли;
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки,
			"КонецПериода", КонецДня(КонецПериода), Истина);
	Иначе
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки,
			"КонецПериода", КонецПериода, Истина);
	КонецЕсли;
	
	ПериодичностьОборотов = ?(Периодичность <> 0, Периодичность, 2); // По умолчанию - по документам.
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки,
		"ПериодичностьОборотов", ПериодичностьОборотов, Истина);
	
	Для Каждого ЭлементСтруктуры Из Настройки.Структура Цикл
		
		Если ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
			
			Если РежимОтладки Тогда
				ЭлементСтруктуры.Использование = Ложь;
				Продолжить;
			КонецЕсли;
			
			Если ПериодичностьОборотов = 2 Тогда // По документам.
				Для Каждого СтрокаТаблицы Из ЭлементСтруктуры.Строки Цикл
					УстановитьДетализациюПоРегистратору(СтрокаТаблицы);
				КонецЦикла;
			КонецЕсли;
			
		Иначе
			
			Если ЭлементСтруктуры.Имя = "ОрганизацияРежимОтладки" И РежимОтладки Тогда
				ЭлементСтруктуры.Использование = Истина;
			КонецЕсли;
			
			Если ПериодичностьОборотов = 2 Тогда // По документам.
				УстановитьДетализациюПоРегистратору(ЭлементСтруктуры);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки,
		"ТипПериода", Отчеты.РасчетыСКонтрагентами.ТипПериода(ПериодичностьОборотов), Истина);
	
	ВывестиЗаголовокОтчета(ДокументРезультат, Настройки);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ВывестиПодвалОтчета(ДокументРезультат, Настройки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВывестиЗаголовокОтчета(Результат, Настройки)
	
	МакетЗаголовка = УправлениеПечатью.МакетПечатнойФормы("Отчет.РасчетыСКонтрагентами.ПФ_MXL_ЗаголовокОтчета");
	
	Если ЭтотОбъект.ВыводитьЗаголовок Тогда
		
		// Заголовок.
		ОбластьЗаголовка = МакетЗаголовка.ПолучитьОбласть("Заголовок");
		ПараметрыЗаголовка = Новый Структура;
		ПараметрыЗаголовка.Вставить("ЗаголовокОтчета", НСтр("ru = 'Расчеты с контрагентами'"));
		ОбластьЗаголовка.Параметры.Заполнить(ПараметрыЗаголовка);
		Результат.Вывести(ОбластьЗаголовка);
		
		Если ЗначениеЗаполнено(НачалоПериода) ИЛИ ЗначениеЗаполнено(КонецПериода) Тогда
			
			ОбластьПериод = МакетЗаголовка.ПолучитьОбласть("Период");
			ОбластьПериод.Параметры.ПериодСтр = ПредставлениеПериода(НачалоДня(НачалоПериода), КонецДня(КонецПериода));
			Результат.Вывести(ОбластьПериод);
			
		КонецЕсли;
		
		// Шапка.
		РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "Наименование,НаименованиеСокращенное");
		РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "Наименование,НаименованиеСокращенное");
		
		ОбластьШапка = МакетЗаголовка.ПолучитьОбласть("Шапка");
		ПараметрыШапка = Новый Структура("НаименованиеОрганизации,КонтрагентДоговор");
		ПараметрыШапка.НаименованиеОрганизации =
			?(ЗначениеЗаполнено(РеквизитыОрганизации.НаименованиеСокращенное),
			РеквизитыОрганизации.НаименованиеСокращенное,
			РеквизитыОрганизации.Наименование);
		ПараметрыШапка.КонтрагентДоговор = "" +
			?(ЗначениеЗаполнено(РеквизитыКонтрагента.НаименованиеСокращенное),
			РеквизитыКонтрагента.НаименованиеСокращенное,
			РеквизитыКонтрагента.Наименование)
			+ ?(ЗначениеЗаполнено(Договор), ", " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "Наименование"), "");
		ОбластьШапка.Параметры.Заполнить(ПараметрыШапка);
		Результат.Вывести(ОбластьШапка);
		
	КонецЕсли;
	
	// Отборы.
	ТекстОтбора = "";
	Для каждого ПараметрДанных Из Настройки.ПараметрыДанных.Элементы Цикл
	
		Если ТипЗнч(ПараметрДанных) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") И ПараметрДанных.Использование Тогда
			
			Если НЕ ЗначениеЗаполнено(ПараметрДанных.ИдентификаторПользовательскойНастройки) Тогда
				Продолжить;
			КонецЕсли;
			
			ПредставлениеОтбора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 Равно ""%2""'"),
				Строка(ПараметрДанных.Параметр), Строка(ПараметрДанных.Значение));
			ТекстОтбора = ТекстОтбора + ?(ПустаяСтрока(ТекстОтбора), "", ", ") + ПредставлениеОтбора;
			
		КонецЕсли;
	
	КонецЦикла;
	Для каждого ТекСтрОтбора Из Настройки.Отбор.Элементы Цикл
	
		Если ТипЗнч(ТекСтрОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ТекСтрОтбора.Использование Тогда
			
			Если ЗначениеЗаполнено(ТекСтрОтбора.ИдентификаторПользовательскойНастройки) 
				И ТекСтрОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация") Тогда
				Продолжить;
			КонецЕсли;
			
			ПредставлениеОтбора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 %2 ""%3""'"),
				Строка(ТекСтрОтбора.ЛевоеЗначение), Строка(ТекСтрОтбора.ВидСравнения), Строка(ТекСтрОтбора.ПравоеЗначение));
			ТекстОтбора = ТекстОтбора + ?(ПустаяСтрока(ТекстОтбора), "", ", ") + ПредставлениеОтбора;
			
		КонецЕсли;
	
	КонецЦикла;
	Если НЕ ПустаяСтрока(ТекстОтбора) Тогда
		ОбластьОтбор = МакетЗаголовка.ПолучитьОбласть("Отбор");
		ОбластьОтбор.Параметры.ТекстОтбора = ТекстОтбора;
		Результат.Вывести(ОбластьОтбор);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиПодвалОтчета(Результат, Настройки)
	
	Если ЭтотОбъект.ВыводитьПодвал Тогда
		СтандартныеОтчеты.ВывестиПодвалОтчета(ЭтотОбъект, Результат);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьДетализациюПоРегистратору(СтрокаТаблицы)
	
	Для Каждого ЭлементСтруктуры Из СтрокаТаблицы.Структура Цикл
		
		Если ЭлементСтруктуры.Структура.Количество() > 0 Тогда
			// Рекурсивный вызов для вложенных элементов структуры.
			УстановитьДетализациюПоРегистратору(ЭлементСтруктуры);
		КонецЕсли;
		
		// Группировку Период заменим на группировку по документам движения (регистраторам).
		Если СтрНайти(ЭлементСтруктуры.Имя, "Период") > 0 Тогда
			ЭлементСтруктуры.Использование = Ложь;
		ИначеЕсли СтрНайти(ЭлементСтруктуры.Имя, "Документ") > 0 Тогда
			ЭлементСтруктуры.Использование = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли