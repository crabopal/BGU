// СтандартныеПодсистемы.ВариантыОтчетов

// См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "РасчетыСКонтрагентами");
	НастройкиВарианта.Описание = НСтр("ru = 'Оборотная ведомость по расчетам с дебиторами (покупателями, заказчиками) и кредиторами (поставщиками, подрядчиками).
	|Текущая задолженность по договорам аренды и иным долгосрочным договорам подряда, оказания услуг'");
	НастройкиВарианта.Включен = Истина;
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ТипПериода(ПериодичностьОборотов) Экспорт
	
	ТипПериода = "";
	Если ПериодичностьОборотов = 12 Тогда
		ТипПериода = "Год";
	ИначеЕсли ПериодичностьОборотов = 11 Тогда
		ТипПериода = "Полугодие";
	ИначеЕсли ПериодичностьОборотов = 10 Тогда
		ТипПериода = "Квартал";
	ИначеЕсли ПериодичностьОборотов = 9 Тогда
		ТипПериода = "Месяц";
	ИначеЕсли ПериодичностьОборотов = 8 Тогда
		ТипПериода = "Декада";
	ИначеЕсли ПериодичностьОборотов = 7 Тогда
		ТипПериода = "Неделя";
	ИначеЕсли ПериодичностьОборотов = 6 Тогда
		ТипПериода = "День";
	ИначеЕсли ПериодичностьОборотов = 2 Тогда
		ТипПериода = "Регистратор";
	КонецЕсли;
	
	Возврат ТипПериода;
	
КонецФункции

#КонецОбласти

#КонецЕсли