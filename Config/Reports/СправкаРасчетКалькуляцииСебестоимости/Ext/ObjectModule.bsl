#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура СформироватьОтчет(ТабДокумент) Экспорт
	
	
	
	ЛокальныеПеременные = Новый Структура;
	Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.60")).ЭлементГруппа Тогда
		ЛокальныеПеременные.Вставить("мСчет10961", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.61"));
	Иначе
		ЛокальныеПеременные.Вставить("мСчет10961", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.60"));
	КонецЕсли;
	Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.70")).ЭлементГруппа Тогда
		ЛокальныеПеременные.Вставить("мСчет10971", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.71"));
	Иначе
		ЛокальныеПеременные.Вставить("мСчет10971", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.70"));
	КонецЕсли;
	Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.80")).ЭлементГруппа Тогда
		ЛокальныеПеременные.Вставить("мСчет10981", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.81"));
	Иначе
		ЛокальныеПеременные.Вставить("мСчет10981", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("109.80"));
	КонецЕсли;
	ЛокальныеПеременные.Вставить("мСчет105", ПланыСчетов.ЕПСБУ.НайтиПоКоду("105.00"));
	ЛокальныеПеременные.Вставить("мЕстьНаправлениеДеятельности", БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(
																 ЛокальныеПеременные.мСчет10961,
																 ПланыВидовХарактеристик.ВидыСубконто.НаправленияДеятельности));
	РассчитыватьСебестоимостьВКонцеГода = УчетПроизводства.РассчитыватьСебестоимостьВКонцеГода(Организация, КонецПериода);
	ЛокальныеПеременные.Вставить("РассчитыватьСебестоимостьВКонцеГода", РассчитыватьСебестоимостьВКонцеГода);
																 
	ТабДокумент.Очистить();
	МассивНоменклатурныхГрупп = СписокНоменклатуры.ВыгрузитьЗначения();
	МассивРезультатов = ВыполнитьЗапрос(МассивНоменклатурныхГрупп, ЛокальныеПеременные);
	ДеревоВыпуска = МассивРезультатов[0].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоПЗ      = МассивРезультатов[1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоКЗ      = МассивРезультатов[2].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоОНП     = МассивРезультатов[3].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = ПолучитьМакет("Макет");
	ОбластьЗаголовок                = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка                    = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаПЗ                  = Макет.ПолучитьОбласть("ШапкаПЗ");
	ОбластьИтого                    = Макет.ПолучитьОбласть("Итого");
	ОбластьШапкаКЗ                  = Макет.ПолучитьОбласть("ШапкаКЗ");
	ОбластьСтрокаЗатрат             = Макет.ПолучитьОбласть("СтрокаЗатрат");
	ОбластьКОСГУЗатрат              = Макет.ПолучитьОбласть("КОСГУЗатрат");
	ОбластьСчетЗатрат               = Макет.ПолучитьОбласть("СчетЗатрат");
	ОбластьСтрокаНоменклатурыЗатрат = Макет.ПолучитьОбласть("СтрокаНоменклатурыЗатрат");
	ОбластьНПСтрока                 = Макет.ПолучитьОбласть("НПСтрока");
	ОбластьОкончаниеТаблицы         = Макет.ПолучитьОбласть("ОкончаниеТаблицы");
	ОбластьОтветственный            = Макет.ПолучитьОбласть("Ответственный");
	
	ОрганизацияНаименование = Организация.НаименованиеПолное;
	
	СтрокаОтбора = "ИФО - " + ?(ЗначениеЗаполнено(ИФО), ИФО, "<>, ");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		СтрокаОтбора = СтрокаОтбора + "Подразделение - " + ?(ЗначениеЗаполнено(Подразделение), Подразделение, "<>") + ", ";
	КонецЕсли;
	СтрокаОтбора = СтрокаОтбора + "КФО - " + КФО;
	Если ЛокальныеПеременные.мЕстьНаправлениеДеятельности Тогда
		СтрокаОтбора = СтрокаОтбора + ", Направление деятельности - " 
									+ ?(ЗначениеЗаполнено(НаправлениеДеятельности), НаправлениеДеятельности, "<>");
	КонецЕсли;	
	
	Для каждого СтрокаПериодаВыпуска из ДеревоВыпуска.Строки Цикл
		Если ДеревоВыпуска.Строки.Индекс(СтрокаПериодаВыпуска) > 0 Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		
		СтрокаПериодаПЗ  = ПолучитьВеткуДерева(ДеревоПЗ, СтрокаПериодаВыпуска.Период, "Период");
		СтрокаПериодаКЗ  = ПолучитьВеткуДерева(ДеревоКЗ, СтрокаПериодаВыпуска.Период, "Период");
		СтрокаПериодаОНП = ПолучитьВеткуДерева(ДеревоОНП, СтрокаПериодаВыпуска.Период, "Период");
		
		ОбластьЗаголовок.Параметры.ОрганизацияНаименование = ОрганизацияНаименование; 
		Если ЛокальныеПеременные.РассчитыватьСебестоимостьВКонцеГода Тогда
			ПараметрДата = КонецГода(СтрокаПериодаВыпуска.Период);
		Иначе
			ПараметрДата = КонецМесяца(СтрокаПериодаВыпуска.Период);
		КонецЕсли;
		ОбластьЗаголовок.Параметры.Дата   = ПараметрДата; 
		ОбластьЗаголовок.Параметры.Период = "" + ПредставлениеПериода(НачалоМесяца(СтрокаПериодаВыпуска.Период),
																	  ПараметрДата, "ФП = Истина");
		ОбластьЗаголовок.Параметры.СтрокаОтбора = СтрокаОтбора;
		ТабДокумент.Вывести(ОбластьЗаголовок);
		
		Для каждого СтрокаНоменклатурнойГруппыВыпуска из СтрокаПериодаВыпуска.Строки Цикл
			ТаблицаНГ_ВидЗатрат = СформироватьТаблицуНГ_ВидЗатрат(СтрокаНоменклатурнойГруппыВыпуска);
			
			СтрокаНоменклатурнойГруппыПЗ  = ПолучитьВеткуДерева(СтрокаПериодаПЗ,
																СтрокаНоменклатурнойГруппыВыпуска.НоменклатурнаяГруппа,
																"НоменклатурнаяГруппа");
			СтрокаНоменклатурнойГруппыКЗ  = ПолучитьВеткуДерева(СтрокаПериодаКЗ, 
																СтрокаНоменклатурнойГруппыВыпуска.НоменклатурнаяГруппа,
																"НоменклатурнаяГруппа");
			СтрокаНоменклатурнойГруппыОНП = ПолучитьВеткуДерева(СтрокаПериодаОНП, 
																СтрокаНоменклатурнойГруппыВыпуска.НоменклатурнаяГруппа,
																"НоменклатурнаяГруппа");
			
			Для каждого СтрокаНоменклатураВыпуска из СтрокаНоменклатурнойГруппыВыпуска.Строки Цикл
				ОбластьШапка.Параметры.Заполнить(СтрокаНоменклатураВыпуска);
				
				СтрокаАналитикиВыпуска = "" + СтрокаНоменклатурнойГруппыВыпуска.НоменклатурнаяГруппа;
				Если ЛокальныеПеременные.мЕстьНаправлениеДеятельности Тогда
					СтрокаАналитикиВыпуска = СтрокаАналитикиВыпуска + " (" + НаправлениеДеятельности + ")";
				КонецЕсли;	
				ОбластьШапка.Параметры.АналитикаВыпуска = СтрокаАналитикиВыпуска;
				ОбластьШапка.Параметры.ЦенаВыпуска      = ?(СтрокаНоменклатураВыпуска.КоличествоВыпуска = 0, 0,
															СтрокаНоменклатураВыпуска.СуммаВыпуска 
															/ СтрокаНоменклатураВыпуска.КоличествоВыпуска);
				ТабДокумент.Вывести(ОбластьШапка);
				ТабДокумент.Вывести(ОбластьШапкаПЗ);
				
				СтруктураДанных = Новый Структура("ТабДокумент, СтрокаНоменклатураВыпуска, СтрокаНоменклатурнойГруппыЗатрат, 
													|ОбластьКОСГУЗатрат, ОбластьСтрокаЗатрат, ОбластьСчетЗатрат, 
													|ОбластьСтрокаНоменклатурыЗатрат, ОбластьИтого, ТаблицаНГ_ВидЗатрат",
													ТабДокумент,
													СтрокаНоменклатураВыпуска,
													СтрокаНоменклатурнойГруппыПЗ, 
													ОбластьКОСГУЗатрат,
													ОбластьСтрокаЗатрат,
													ОбластьСчетЗатрат,
													ОбластьСтрокаНоменклатурыЗатрат,
													ОбластьИтого,
													ТаблицаНГ_ВидЗатрат);
				РазвернутьПЗпоВидамЗатрат(СтруктураДанных);
				
				ОбластьШапкаКЗ.Параметры.ТипКЗ = "Накладные расходы производства";
				ТабДокумент.Вывести(ОбластьШапкаКЗ);
				СтруктураДанных = Новый Структура("ТабДокумент, СтрокаНоменклатураВыпуска, СтрокаНоменклатурнойГруппыЗатрат, 
													|ОбластьКОСГУЗатрат, ОбластьСтрокаЗатрат, ОбластьИтого, ТипКЗ,
													|ТаблицаНГ_ВидЗатрат",
													ТабДокумент,
													СтрокаНоменклатураВыпуска,
													СтрокаНоменклатурнойГруппыКЗ, 
													ОбластьКОСГУЗатрат, 
													ОбластьСтрокаЗатрат,
													ОбластьИтого,
													"ОПЗ", 
													ТаблицаНГ_ВидЗатрат);
				РазвернутьКЗпоВидамЗатрат(СтруктураДанных);
				
				ОбластьШапкаКЗ.Параметры.ТипКЗ = "Общехозяйственные расходы";
				ТабДокумент.Вывести(ОбластьШапкаКЗ);
				СтруктураДанных = Новый Структура("ТабДокумент, СтрокаНоменклатураВыпуска, СтрокаНоменклатурнойГруппыЗатрат, 
													|ОбластьКОСГУЗатрат, ОбластьСтрокаЗатрат, ОбластьИтого, ТипКЗ,
													|ТаблицаНГ_ВидЗатрат",
													ТабДокумент,
													СтрокаНоменклатураВыпуска,
													СтрокаНоменклатурнойГруппыКЗ, 
													ОбластьКОСГУЗатрат, 
													ОбластьСтрокаЗатрат,
													ОбластьИтого,
													"ОХЗ",
													ТаблицаНГ_ВидЗатрат);
				РазвернутьКЗпоВидамЗатрат(СтруктураДанных);
				
				ОбластьШапкаКЗ.Параметры.ТипКЗ = "Остаток незавершенного производства";
				ТабДокумент.Вывести(ОбластьШапкаКЗ);
				СтруктураДанных = Новый Структура("ТабДокумент, СтрокаНоменклатураВыпуска, СтрокаНоменклатурнойГруппыЗатрат, 
													|ОбластьКОСГУЗатрат, ОбластьСтрокаЗатрат, ОбластьИтого, ОбластьНПСтрока, 
													|ТаблицаНГ_ВидЗатрат",
													ТабДокумент,
													СтрокаНоменклатураВыпуска,
													СтрокаНоменклатурнойГруппыОНП, 
													ОбластьКОСГУЗатрат, 
													ОбластьСтрокаЗатрат,
													ОбластьИтого,
													ОбластьНПСтрока,
													ТаблицаНГ_ВидЗатрат);
				РазвернутьНПпоВидамЗатрат(СтруктураДанных);
				ТабДокумент.Вывести(ОбластьОкончаниеТаблицы);
				
			КонецЦикла;	
		КонецЦикла;	
		
		ТабДокумент.Вывести(ОбластьОтветственный);
	КонецЦикла;	
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция СформироватьТаблицуНГ_ВидЗатрат(СтрокаНоменклатурнойГруппыВыпуска)
	ТаблицаНГ_ВидЗатрат = Новый ТаблицаЗначений;
	ТаблицаНГ_ВидЗатрат.Колонки.Добавить("НоменклатурнаяГруппа", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНГ_ВидЗатрат.Колонки.Добавить("КОСГУЗатрат", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаНГ_ВидЗатрат.Колонки.Добавить("СуммаВыпуска", Новый ОписаниеТипов("Число"));
	
	Для каждого СтрокаНоменклатурыВыпуска из СтрокаНоменклатурнойГруппыВыпуска.Строки Цикл
		Для каждого СтрокаДетальная из СтрокаНоменклатурыВыпуска.Строки Цикл
			НоваяСтрока = ТаблицаНГ_ВидЗатрат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДетальная);
		КонецЦикла;	
	КонецЦикла;	
	ТаблицаНГ_ВидЗатрат.Свернуть("НоменклатурнаяГруппа, КОСГУЗатрат", "СуммаВыпуска");
	ТаблицаНГ_ВидЗатрат.Индексы.Добавить("НоменклатурнаяГруппа, КОСГУЗатрат");
	
	Возврат ТаблицаНГ_ВидЗатрат;
КонецФункции	

Функция ПредставлениеСчета(КодСчета, НаименованиеСчета)
	Возврат НаименованиеСчета;
КонецФункции	

Функция ВыполнитьЗапрос(МассивНоменклатурныхГрупп, ЛокальныеПеременные)
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЖурналПроводокЕПСБУОбороты.Период КАК Период,
					|	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК НоменклатурнаяГруппа,
					|	ЖурналПроводокЕПСБУОбороты.КЭК КАК КОСГУЗатрат,
					|	ЖурналПроводокЕПСБУОбороты.Субконто2 КАК ВидЗатрат,
					|	ЖурналПроводокЕПСБУОбороты.КорСубконто1 КАК Номенклатура,
					|	СУММА(ЖурналПроводокЕПСБУОбороты.СуммаОборотКт) КАК СуммаВыпуска,
					|	МАКСИМУМ(ЖурналПроводокЕПСБУОбороты.КоличествоКорОборотКт) КАК КоличествоВыпуска
					|ИЗ
					|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
					|			&ДатаНачала,
					|			&ДатаКонца,
					|			&Периодичность,
					|			Счет = &Счет10961,
					|			,
					|			Организация = &Организация
					|				И КФО = &КФО
					|				И &ОтборПоНоменклатурнымГруппам 
					|				И &ОтборПоНаправлениюДеятельности
					|				И (ИФО = &ИФО или &ИФО = Значение(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
					|				И (Подразделение = &Подразделение или &Подразделение = Значение(Справочник.Подразделения.ПустаяСсылка)),
					|			КорСчет В ИЕРАРХИИ (&Счет105),
					|			) КАК ЖурналПроводокЕПСБУОбороты
					|
					|СГРУППИРОВАТЬ ПО
					|	ЖурналПроводокЕПСБУОбороты.Субконто1,
					|	ЖурналПроводокЕПСБУОбороты.КЭК,
					|	ЖурналПроводокЕПСБУОбороты.Субконто2,
					|	ЖурналПроводокЕПСБУОбороты.КорСубконто1,
					|	ЖурналПроводокЕПСБУОбороты.Период
					|ИТОГИ
					|	СУММА(СуммаВыпуска),
					|	МАКСИМУМ(КоличествоВыпуска)
					|ПО
					|	Период,
					|	НоменклатурнаяГруппа,
					|	Номенклатура,
					|	КОСГУЗатрат,
					|	ВидЗатрат
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЖурналПроводокЕПСБУОбороты.Период КАК Период,
					|	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК НоменклатурнаяГруппа,
					|	ЖурналПроводокЕПСБУОбороты.КЭК КАК КОСГУЗатрат,
					|	ЖурналПроводокЕПСБУОбороты.Субконто2 КАК ВидЗатрат,
					|	ЖурналПроводокЕПСБУОбороты.КорСчет КАК КорСчет,
					|	ЖурналПроводокЕПСБУОбороты.КорСчет.Наименование КАК НаименованиеКорСчет,
					|	ЖурналПроводокЕПСБУОбороты.КорСчет.Код КАК КодКорСчет,
					|	ЖурналПроводокЕПСБУОбороты.КорСубконто1 КАК КорСубконто1,
					|	СУММА(ЖурналПроводокЕПСБУОбороты.СуммаОборотДт) КАК СуммаПЗ,
					|	СУММА(ЖурналПроводокЕПСБУОбороты.СуммаОборотДт) КАК СуммаПЗДоп,
					|	МАКСИМУМ(ЖурналПроводокЕПСБУОбороты.КоличествоКорОборотДт) КАК КоличествоПЗ,
					|	МАКСИМУМ(ЖурналПроводокЕПСБУОбороты.КоличествоКорОборотДт) КАК КоличествоПЗДоп
					|ИЗ
					|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
					|			&ДатаНачала,
					|			&ДатаКонца,
					|			&Периодичность,
					|			Счет = &Счет10961,
					|			,
					|			Организация = &Организация
					|				И КФО = &КФО
					|				И &ОтборПоНоменклатурнымГруппам 
					|				И &ОтборПоНаправлениюДеятельности
					|				И (ИФО = &ИФО или &ИФО = Значение(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
					|				И (Подразделение = &Подразделение или &Подразделение = Значение(Справочник.Подразделения.ПустаяСсылка)),
					|			(НЕ КорСчет = &Счет10971)
					|				И (НЕ КорСчет = &Счет10981),
					|			) КАК ЖурналПроводокЕПСБУОбороты
					|ГДЕ
					|	ЖурналПроводокЕПСБУОбороты.СуммаОборотДт <> 0
					|
					|СГРУППИРОВАТЬ ПО
					|	ЖурналПроводокЕПСБУОбороты.Субконто1,
					|	ЖурналПроводокЕПСБУОбороты.КЭК,
					|	ЖурналПроводокЕПСБУОбороты.Субконто2,
					|	ЖурналПроводокЕПСБУОбороты.КорСчет,
					|	ЖурналПроводокЕПСБУОбороты.КорСубконто1,
					|	ЖурналПроводокЕПСБУОбороты.Период
					|ИТОГИ
					|	СУММА(СуммаПЗ),
					|	СУММА(СуммаПЗДоп),
					|	МАКСИМУМ(КоличествоПЗ),
					|	МАКСИМУМ(КоличествоПЗДоп)
					|ПО
					|	Период,
					|	НоменклатурнаяГруппа,
					|	КОСГУЗатрат,
					|	ВидЗатрат,
					|	КорСчет
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЖурналПроводокЕПСБУОбороты.Период КАК Период,
					|	ЖурналПроводокЕПСБУОбороты.Субконто1 КАК НоменклатурнаяГруппа,
					|	ЖурналПроводокЕПСБУОбороты.КЭК КАК КОСГУЗатрат,
					|	ЖурналПроводокЕПСБУОбороты.Субконто2 КАК ВидЗатрат,
					|	ВЫБОР
					|		КОГДА ЖурналПроводокЕПСБУОбороты.КорСчет = &Счет10971
					|			ТОГДА ""ОПЗ""
					|		ИНАЧЕ ""ОХЗ""
					|	КОНЕЦ КАК ТипКЗ,
					|	СУММА(ЖурналПроводокЕПСБУОбороты.СуммаОборотДт) КАК СуммаКЗ,
					|	СУММА(ЖурналПроводокЕПСБУОбороты.СуммаОборотДт) КАК СуммаКЗДоп
					|ИЗ
					|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
					|			&ДатаНачала,
					|			&ДатаКонца,
					|			&Периодичность,
					|			Счет = &Счет10961,
					|			,
					|			Организация = &Организация
					|				И КФО = &КФО
					|				И &ОтборПоНоменклатурнымГруппам 
					|				И &ОтборПоНаправлениюДеятельности
					|				И (ИФО = &ИФО или &ИФО = Значение(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
					|				И (Подразделение = &Подразделение или &Подразделение = Значение(Справочник.Подразделения.ПустаяСсылка)),
					|			КорСчет = &Счет10971
					|				ИЛИ КорСчет = &Счет10981,
					|			) КАК ЖурналПроводокЕПСБУОбороты
					|ГДЕ
					|	ЖурналПроводокЕПСБУОбороты.СуммаОборотДт <> 0
					|
					|СГРУППИРОВАТЬ ПО
					|	ЖурналПроводокЕПСБУОбороты.Субконто1,
					|	ЖурналПроводокЕПСБУОбороты.КЭК,
					|	ЖурналПроводокЕПСБУОбороты.Субконто2,
					|	ВЫБОР
					|		КОГДА ЖурналПроводокЕПСБУОбороты.КорСчет = &Счет10971
					|			ТОГДА ""ОПЗ""
					|		ИНАЧЕ ""ОХЗ""
					|	КОНЕЦ,
					|	ЖурналПроводокЕПСБУОбороты.Период
					|ИТОГИ
					|	СУММА(СуммаКЗ),
					|	СУММА(СуммаКЗДоп)
					|ПО
					|	Период,
					|	НоменклатурнаяГруппа,
					|	ТипКЗ,
					|	КОСГУЗатрат
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЕПСБУОстаткиИОбороты.Период КАК Период,
					|	ЕПСБУОстаткиИОбороты.Субконто1 КАК НоменклатурнаяГруппа,
					|	ЕПСБУОстаткиИОбороты.КЭК КАК КОСГУЗатрат,
					|	ЕПСБУОстаткиИОбороты.Субконто2 КАК ВидЗатрат,
					|	СУММА(ЕПСБУОстаткиИОбороты.СуммаНачальныйОстаток) КАК НачальныйОстаток,
					|	СУММА(ЕПСБУОстаткиИОбороты.СуммаКонечныйОстаток) КАК КонечныйОстаток
					|ИЗ
					|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
					|			&ДатаНачала,
					|			&ДатаКонца,
					|			&Периодичность,
					|			,
					|			Счет = &Счет10961,
					|			,
					|			Организация = &Организация
					|				И (ИФО = &ИФО или &ИФО = Значение(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
					|				И (Подразделение = &Подразделение или &Подразделение = Значение(Справочник.Подразделения.ПустаяСсылка))
					|				И &ОтборПоНоменклатурнымГруппам 
					|				И &ОтборПоНаправлениюДеятельности
					|				И КФО = &КФО) КАК ЕПСБУОстаткиИОбороты
					|
					|ГДЕ
					|	(ЕПСБУОстаткиИОбороты.СуммаНачальныйОстаток <> 0
					|			ИЛИ ЕПСБУОстаткиИОбороты.СуммаКонечныйОстаток <> 0)
					|СГРУППИРОВАТЬ ПО
					|	ЕПСБУОстаткиИОбороты.Субконто1,
					|	ЕПСБУОстаткиИОбороты.КЭК,
					|	ЕПСБУОстаткиИОбороты.Субконто2,
					|	ЕПСБУОстаткиИОбороты.Период
					|ИТОГИ
					|	СУММА(НачальныйОстаток),
					|	СУММА(КонечныйОстаток)
					|ПО
					|	Период,
					|	НоменклатурнаяГруппа,
					|	КОСГУЗатрат,
					|	ВидЗатрат";

	Если МассивНоменклатурныхГрупп.Количество() > 0 Тогда
		ОтборПоНоменклатурнымГруппам = "Субконто1 В ИЕРАРХИИ (&МассивНоменклатуры)";
	Иначе
		ОтборПоНоменклатурнымГруппам = "ИСТИНА";
	КонецЕсли;	
	Если ЛокальныеПеременные.мЕстьНаправлениеДеятельности Тогда
		ОтборПоНаправлениюДеятельности = "Субконто3 = &НаправлениеДеятельности";
	Иначе
		ОтборПоНаправлениюДеятельности = "ИСТИНА";
	КонецЕсли;
	Если ЛокальныеПеременные.РассчитыватьСебестоимостьВКонцеГода Тогда
		Периодичность = "Год";
		НачалоПериода = НачалоГода(НачалоПериода);
	Иначе
		Периодичность = "Месяц";
		НачалоПериода = НачалоМесяца(НачалоПериода);
	КонецЕсли;
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоНоменклатурнымГруппам",   ОтборПоНоменклатурнымГруппам);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоНаправлениюДеятельности", ОтборПоНаправлениюДеятельности);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Периодичность",                  Периодичность);
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("ДатаНачала", НачалоПериода);
	Запрос.УстановитьПараметр("ДатаКонца", КонецМесяца(КонецПериода));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИФО", ИФО);
	Запрос.УстановитьПараметр("КФО", КФО);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("Счет10961", ЛокальныеПеременные.мСчет10961);
	Запрос.УстановитьПараметр("Счет10971", ЛокальныеПеременные.мСчет10971);
	Запрос.УстановитьПараметр("Счет10981", ЛокальныеПеременные.мСчет10981);
	Запрос.УстановитьПараметр("Счет105", ЛокальныеПеременные.мСчет105);
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатурныхГрупп);
	Если ЛокальныеПеременные.мЕстьНаправлениеДеятельности Тогда
		Запрос.УстановитьПараметр("НаправлениеДеятельности", НаправлениеДеятельности);
	КонецЕсли;	
	
	МассивРезультат = Запрос.ВыполнитьПакет();
	
	Возврат МассивРезультат;
КонецФункции	

Функция ПолучитьВеткуДерева(ТекВетка, ЗначениеПоиска, ИмяКолонки)
	ВеткаДерева = Неопределено;
	Если ТекВетка <> Неопределено Тогда
		ВеткаДерева = ТекВетка.Строки.Найти(ЗначениеПоиска, ИмяКолонки, Ложь);
	КонецЕсли;	
	
	Возврат ВеткаДерева;
КонецФункции	

Функция ВернутьКоэффициент(СтрокаВидЗатратВыпуска, ТаблицаНГ_ВидЗатрат)
	Коэффициент = 0;
	СтруктураПоиска = Новый Структура("НоменклатурнаяГруппа, КОСГУЗатрат",
									   СтрокаВидЗатратВыпуска.НоменклатурнаяГруппа,
									   СтрокаВидЗатратВыпуска.КОСГУЗатрат);
	МассивСтрок = ТаблицаНГ_ВидЗатрат.НайтиСтроки(СтруктураПоиска);
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Коэффициент;
	КонецЕсли;	
	Коэффициент = ?(МассивСтрок[0].СуммаВыпуска = 0, 0, СтрокаВидЗатратВыпуска.СуммаВыпуска / МассивСтрок[0].СуммаВыпуска);
	
	Возврат Коэффициент;
КонецФункции	

// Вывод прямых затрат ****************************************

Процедура ВывестиДанныеПЗ(СтруктураДанных)
	ТабДокумент                     = СтруктураДанных.ТабДокумент;
	СтрокаКОСГУЗатратПЗ             = СтруктураДанных.СтрокаКОСГУЗатратПЗ;
	ОбластьСтрокаЗатрат             = СтруктураДанных.ОбластьСтрокаЗатрат;
	ОбластьКОСГУЗатрат              = СтруктураДанных.ОбластьКОСГУЗатрат;
	ОбластьСчетЗатрат               = СтруктураДанных.ОбластьСчетЗатрат;
	ОбластьСтрокаНоменклатурыЗатрат = СтруктураДанных.ОбластьСтрокаНоменклатурыЗатрат;
	ОбластьИтого                    = СтруктураДанных.ОбластьИтого;
	Коэффициент                     = СтруктураДанных.Коэффициент;
	СтрокаКОСГУЗатратВыпуска        = СтруктураДанных.СтрокаКОСГУЗатратВыпуска;
	
	СуммаСписанияПоКОСГУЗатрат     = СтрокаКОСГУЗатратПЗ.СуммаПЗ * Коэффициент;
	СтрокаКОСГУЗатратПЗ.СуммаПЗДоп = СтрокаКОСГУЗатратПЗ.СуммаПЗДоп - СуммаСписанияПоКОСГУЗатрат;
	СтруктураДанных.СуммаИтого     = СтруктураДанных.СуммаИтого + СуммаСписанияПоКОСГУЗатрат;
	
	ОбластьКОСГУЗатрат.Параметры.СуммаЗатрат = СуммаСписанияПоКОСГУЗатрат;
	ОбластьКОСГУЗатрат.Параметры.КОСГУЗатрат = СтрокаКОСГУЗатратПЗ.КОСГУЗатрат;
	ТабДокумент.Вывести(ОбластьКОСГУЗатрат);
	
	Для каждого СтрокаВидЗатратПЗ из СтрокаКОСГУЗатратПЗ.Строки Цикл
		СуммаСписанияПоВидуЗатрат    = СтрокаВидЗатратПЗ.СуммаПЗ * Коэффициент;
		СтрокаВидЗатратПЗ.СуммаПЗДоп = СтрокаВидЗатратПЗ.СуммаПЗДоп - СуммаСписанияПоВидуЗатрат;
		
		ОбластьСтрокаЗатрат.Параметры.СуммаЗатрат = СуммаСписанияПоВидуЗатрат;
		ОбластьСтрокаЗатрат.Параметры.ВидЗатрат   = СтрокаВидЗатратПЗ.ВидЗатрат;
		ТабДокумент.Вывести(ОбластьСтрокаЗатрат);
		
		Для каждого СтрокаСчета из СтрокаВидЗатратПЗ.Строки Цикл
			СуммаСписанияПоСчету   = СтрокаСчета.СуммаПЗ * Коэффициент;
			СтрокаСчета.СуммаПЗДоп = СтрокаСчета.СуммаПЗДоп - СуммаСписанияПоСчету;
			
			ОбластьСчетЗатрат.Параметры.СуммаЗатрат             = СуммаСписанияПоСчету;
			ОбластьСчетЗатрат.Параметры.НаименованиеСчетаЗатрат = ПредставлениеСчета(СтрокаСчета.КодКорСчет,
																					 СтрокаСчета.НаименованиеКорСчет);
			ТабДокумент.Вывести(ОбластьСчетЗатрат);
			
			Для каждого СтрокаДетальная из СтрокаСчета.Строки Цикл
				СуммаСписанияДетальная = СтрокаДетальная.СуммаПЗ * Коэффициент;
				КоличествоСписания     = СтрокаДетальная.КоличествоПЗ * Коэффициент;
				
				СтрокаДетальная.СуммаПЗДоп      = СтрокаДетальная.СуммаПЗДоп - СуммаСписанияДетальная;
				СтрокаДетальная.КоличествоПЗДоп = СтрокаДетальная.КоличествоПЗДоп - КоличествоСписания;
				
				ОбластьСтрокаНоменклатурыЗатрат.Параметры.СуммаЗатрат  = СуммаСписанияДетальная;
				ОбластьСтрокаНоменклатурыЗатрат.Параметры.КоличествоПЗ = КоличествоСписания;
				ОбластьСтрокаНоменклатурыЗатрат.Параметры.ЦенаПЗ = ?(КоличествоСписания = 0, 0, СуммаСписанияДетальная 
																								/ КоличествоСписания);
				ОбластьСтрокаНоменклатурыЗатрат.Параметры.НаименованиеНоменклатурыЗатрат = СтрокаДетальная.КорСубконто1;
				ТабДокумент.Вывести(ОбластьСтрокаНоменклатурыЗатрат);
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
КонецПроцедуры	

Процедура РазвернутьПЗпоВидамЗатрат(СтруктураДанных)
	ТабДокумент                      = СтруктураДанных.ТабДокумент;
	СтрокаНоменклатураВыпуска        = СтруктураДанных.СтрокаНоменклатураВыпуска;
	СтрокаНоменклатурнойГруппыЗатрат = СтруктураДанных.СтрокаНоменклатурнойГруппыЗатрат;
	ОбластьКОСГУЗатрат               = СтруктураДанных.ОбластьКОСГУЗатрат;
	ОбластьСтрокаЗатрат              = СтруктураДанных.ОбластьСтрокаЗатрат;
	ОбластьСчетЗатрат                = СтруктураДанных.ОбластьСчетЗатрат;
	ОбластьСтрокаНоменклатурыЗатрат  = СтруктураДанных.ОбластьСтрокаНоменклатурыЗатрат;
	ОбластьИтого                     = СтруктураДанных.ОбластьИтого;
	ТаблицаНГ_ВидЗатрат              = СтруктураДанных.ТаблицаНГ_ВидЗатрат;
	
	СуммаИтого = 0;
	Для каждого СтрокаКОСГУЗатратВыпуска из СтрокаНоменклатураВыпуска.Строки Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаКОСГУЗатратВыпуска.КОСГУЗатрат) Тогда
			Продолжить;
		КонецЕсли;	
		
		Коэффициент = ВернутьКоэффициент(СтрокаКОСГУЗатратВыпуска, ТаблицаНГ_ВидЗатрат);
		
		СтрокаКОСГУЗатратПЗ = ПолучитьВеткуДерева(СтрокаНоменклатурнойГруппыЗатрат,
												  СтрокаКОСГУЗатратВыпуска.КОСГУЗатрат, 
												  "КОСГУЗатрат");
		Если СтрокаКОСГУЗатратПЗ = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		СтруктураДанных = Новый Структура("ТабДокумент, СтрокаКОСГУЗатратПЗ, ОбластьКОСГУЗатрат, ОбластьСтрокаЗатрат,
										  |ОбластьСчетЗатрат, ОбластьСтрокаНоменклатурыЗатрат, ОбластьИтого, Коэффициент,
										  |СуммаИтого, СтрокаКОСГУЗатратВыпуска",
										  ТабДокумент, 
										  СтрокаКОСГУЗатратПЗ,
										  ОбластьКОСГУЗатрат,
										  ОбластьСтрокаЗатрат,
										  ОбластьСчетЗатрат, 
										  ОбластьСтрокаНоменклатурыЗатрат,
										  ОбластьИтого,
										  Коэффициент,
										  СуммаИтого,
										  СтрокаКОСГУЗатратВыпуска);
		ВывестиДанныеПЗ(СтруктураДанных);
		СуммаИтого = СтруктураДанных.СуммаИтого;
	КонецЦикла;	
	
	ОбластьИтого.Параметры.ИтогоСумма = СуммаИтого;
	ТабДокумент.Вывести(ОбластьИтого);
КонецПроцедуры	

// Вывод косвенных затрат *************************************

Процедура РазвернутьКЗпоВидамЗатрат(СтруктураДанных)
	ТабДокумент                      = СтруктураДанных.ТабДокумент;
	СтрокаНоменклатураВыпуска        = СтруктураДанных.СтрокаНоменклатураВыпуска;
	СтрокаНоменклатурнойГруппыЗатрат = СтруктураДанных.СтрокаНоменклатурнойГруппыЗатрат;
	ОбластьСтрокаЗатрат              = СтруктураДанных.ОбластьСтрокаЗатрат;
	ОбластьКОСГУЗатрат               = СтруктураДанных.ОбластьКОСГУЗатрат;
	ОбластьИтого                     = СтруктураДанных.ОбластьИтого;
	ТипКЗ                            = СтруктураДанных.ТипКЗ;
	ТаблицаНГ_ВидЗатрат              = СтруктураДанных.ТаблицаНГ_ВидЗатрат;
	
	СтрокаТипКЗ = ПолучитьВеткуДерева(СтрокаНоменклатурнойГруппыЗатрат, ТипКЗ, "ТипКЗ");
	Если СтрокаТипКЗ = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	СуммаИтого = 0;
	Для каждого СтрокаКОСГУЗатратВыпуска из СтрокаНоменклатураВыпуска.Строки Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаКОСГУЗатратВыпуска.КОСГУЗатрат) Тогда
			Продолжить;
		КонецЕсли;	
		
		Коэффициент = ВернутьКоэффициент(СтрокаКОСГУЗатратВыпуска, ТаблицаНГ_ВидЗатрат);
		
		СтрокаКОСГУЗатратКЗ = ПолучитьВеткуДерева(СтрокаТипКЗ, СтрокаКОСГУЗатратВыпуска.КОСГУЗатрат, "КОСГУЗатрат");
		Если СтрокаКОСГУЗатратКЗ = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		СуммаСписанияПоКОСГУЗатрат     = СтрокаКОСГУЗатратКЗ.СуммаКЗ * Коэффициент;
		СтрокаКОСГУЗатратКЗ.СуммаКЗДоп = СтрокаКОСГУЗатратКЗ.СуммаКЗДоп - СуммаСписанияПоКОСГУЗатрат;
		
		ОбластьКОСГУЗатрат.Параметры.СуммаЗатрат = СуммаСписанияПоКОСГУЗатрат;
		ОбластьКОСГУЗатрат.Параметры.КОСГУЗатрат = СтрокаКОСГУЗатратКЗ.КОСГУЗатрат;
		ТабДокумент.Вывести(ОбластьКОСГУЗатрат);
		
		Для каждого СтрокаВидЗатратВыпуска из СтрокаКОСГУЗатратВыпуска.Строки Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаВидЗатратВыпуска.ВидЗатрат) Тогда
				Продолжить;
			КонецЕсли;	
			
			СтрокаВидЗатратКЗ = ПолучитьВеткуДерева(СтрокаКОСГУЗатратКЗ, СтрокаВидЗатратВыпуска.ВидЗатрат, "ВидЗатрат");
			Если СтрокаВидЗатратКЗ = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			
			СуммаСписанияПоВидуЗатрат    = СтрокаВидЗатратКЗ.СуммаКЗ * Коэффициент;
			СтрокаВидЗатратКЗ.СуммаКЗДоп = СтрокаВидЗатратКЗ.СуммаКЗДоп - СуммаСписанияПоВидуЗатрат;
			
			ОбластьСтрокаЗатрат.Параметры.СуммаЗатрат = СуммаСписанияПоВидуЗатрат;
			ОбластьСтрокаЗатрат.Параметры.ВидЗатрат   = СтрокаВидЗатратКЗ.ВидЗатрат;
			ТабДокумент.Вывести(ОбластьСтрокаЗатрат);
			СуммаИтого = СуммаИтого + СуммаСписанияПоВидуЗатрат;
		КонецЦикла;	
	КонецЦикла;	
	ОбластьИтого.Параметры.ИтогоСумма = СуммаИтого;
	ТабДокумент.Вывести(ОбластьИтого);
КонецПроцедуры	

// Вывод остатков незавершенного производства *****************

Процедура РазвернутьНПпоВидамЗатрат(СтруктураДанных)
	ТабДокумент                      = СтруктураДанных.ТабДокумент;
	СтрокаНоменклатураВыпуска        = СтруктураДанных.СтрокаНоменклатураВыпуска;
	СтрокаНоменклатурнойГруппыЗатрат = СтруктураДанных.СтрокаНоменклатурнойГруппыЗатрат;
	ОбластьСтрокаЗатрат              = СтруктураДанных.ОбластьСтрокаЗатрат;
	ОбластьКОСГУЗатрат               = СтруктураДанных.ОбластьКОСГУЗатрат;
	ОбластьИтого                     = СтруктураДанных.ОбластьИтого;
	ТаблицаНГ_ВидЗатрат              = СтруктураДанных.ТаблицаНГ_ВидЗатрат;
	ОбластьНПСтрока                  = СтруктураДанных.ОбластьНПСтрока;
	
	СуммаИтого = 0;
	Для каждого СтрокаКОСГУЗатратВыпуска из СтрокаНоменклатураВыпуска.Строки Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаКОСГУЗатратВыпуска.КОСГУЗатрат) Тогда
			Продолжить;
		КонецЕсли;	
		
		Коэффициент = ВернутьКоэффициент(СтрокаКОСГУЗатратВыпуска, ТаблицаНГ_ВидЗатрат);
		
		СтрокаКОСГУЗатратНП = ПолучитьВеткуДерева(СтрокаНоменклатурнойГруппыЗатрат,
												  СтрокаКОСГУЗатратВыпуска.КОСГУЗатрат,
												  "КОСГУЗатрат");
		Если СтрокаКОСГУЗатратНП = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Для каждого СтрокаВидЗатратВыпуска из СтрокаКОСГУЗатратВыпуска.Строки Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаВидЗатратВыпуска.ВидЗатрат) Тогда
				Продолжить;
			КонецЕсли;	
			
			СтрокаВидЗатратНП = ПолучитьВеткуДерева(СтрокаКОСГУЗатратНП, СтрокаВидЗатратВыпуска.ВидЗатрат, "ВидЗатрат");
			Если СтрокаВидЗатратНП = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
			
			СуммаОстаткаНач = СтрокаВидЗатратНП.НачальныйОстаток * Коэффициент;
			СуммаОстаткаКон = СтрокаВидЗатратНП.КонечныйОстаток * Коэффициент;
			
			Если СуммаОстаткаНач <> 0 ИЛИ СуммаОстаткаКон <> 0 Тогда
				ОбластьСтрокаЗатрат.Параметры.СуммаЗатрат = 0;
				ОбластьСтрокаЗатрат.Параметры.ВидЗатрат   = СтрокаВидЗатратНП.ВидЗатрат;
				
				ОбластьНПСтрока.Параметры.НачальныйОстатокНП = СуммаОстаткаНач;
				ОбластьНПСтрока.Параметры.КонечныйОстатокНП  = СуммаОстаткаКон;
				ОбластьНПСтрока.Параметры.ДатаНачала = Формат(НачалоМесяца(СтрокаВидЗатратВыпуска.Период), "ДФ=dd.MM.yyyy");
				ОбластьНПСтрока.Параметры.ДатаКонца  = Формат(КонецМесяца(СтрокаВидЗатратВыпуска.Период), "ДФ=dd.MM.yyyy");
				
				ТабДокумент.Вывести(ОбластьСтрокаЗатрат);
				ТабДокумент.Вывести(ОбластьНПСтрока);
			КонецЕсли;	
			СуммаИтого = СуммаИтого + СуммаОстаткаНач - СуммаОстаткаКон;
		КонецЦикла;	
	КонецЦикла;	
	ОбластьИтого.Параметры.ИтогоСумма = СуммаИтого;
	ТабДокумент.Вывести(ОбластьИтого);
КонецПроцедуры	

#КонецЕсли