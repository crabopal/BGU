#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТаблицаПроверки = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.ХранилищеТаблицы.Получить();
	
	НастройкиКомпоновщика = КомпоновщикНастроек.ПолучитьНастройки();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновщика, ДанныеРасшифровки);

	ВнешниеНаборыДанных = Новый Структура("ТаблицаДляПроверки", ТаблицаПроверки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных , ДанныеРасшифровки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;
	
	Настройки.ЗагрузитьНастройкиПриИзмененииПараметров = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый ПараметрКомпоновкиДанных("ПлановыйПериод")); 

	Настройки.РазрешеноИзменятьСтруктуру = Ложь;
	Настройки.РазрешеноИзменятьВарианты = Ложь;
	Настройки.ФормироватьСразу = Истина;

	Настройки.Печать.ОриентацияСтраницы = ОриентацияСтраницы.Портрет; 
	
	Настройки.РазрешеноВосстанавливатьСтандартнуюСхему = Истина;
		
КонецПроцедуры

// Вызывается перед загрузкой новых настроек. Используется для изменения схемы компоновки.
//   Например, если схема отчета зависит от ключа варианта или параметров отчета.
//   Чтобы изменения схемы вступили в силу следует вызывать метод ОтчетыСервер.ПодключитьСхему().
//
// Параметры:
//   Контекст - Произвольный - 
//       Параметры контекста, в котором используется отчет.
//       Используется для передачи в параметрах метода ОтчетыСервер.ПодключитьСхему().
//   КлючСхемы - Строка -
//       Идентификатор текущей схемы компоновщика настроек.
//       По умолчанию не заполнен (это означает что компоновщик инициализирован на основании основной схемы).
//       Используется для оптимизации, чтобы переинициализировать компоновщик как можно реже.
//       Может не использоваться если переинициализация выполняется безусловно.
//   КлючВарианта - Строка
//                - Неопределено -
//       Имя предопределенного или уникальный идентификатор пользовательского варианта отчета.
//       Неопределено когда вызов для варианта расшифровки или без контекста.
//   НовыеНастройкиКД - НастройкиКомпоновкиДанных
//                    - Неопределено -
//       Настройки варианта отчета, которые будут загружены в компоновщик настроек после его инициализации.
//       Неопределено когда настройки варианта не надо загружать (уже загружены ранее).
//   НовыеПользовательскиеНастройкиКД - ПользовательскиеНастройкиКомпоновкиДанных
//                                    - Неопределено -
//       Пользовательские настройки, которые будут загружены в компоновщик настроек после его инициализации.
//       Неопределено когда пользовательские настройки не надо загружать (уже загружены ранее).
//
Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт
	
	Если НЕ ТипЗнч(НовыеНастройкиКД) = Тип("НастройкиКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Контекст) = Тип("ФормаКлиентскогоПриложения") 
		И Контекст.Параметры.Свойство("Организация") Тогда
		
		НовыеПользовательскиеНастройкиКД.ДополнительныеСвойства.Вставить("Организация", Контекст.Параметры.Организация);
		НовыеПользовательскиеНастройкиКД.ДополнительныеСвойства.Вставить("Период",Контекст.Параметры.Период);
        НовыеПользовательскиеНастройкиКД.ДополнительныеСвойства.Вставить("Основание",Контекст.Параметры.Основание); 
		НовыеПользовательскиеНастройкиКД.ДополнительныеСвойства.Вставить("ХранилищеТаблицы", Контекст.Параметры.ХранилищеТаблицы); 

	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "Организация", НовыеПользовательскиеНастройкиКД.ДополнительныеСвойства.Организация);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "Период", НовыеПользовательскиеНастройкиКД.ДополнительныеСвойства.Период);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "Основание", НовыеПользовательскиеНастройкиКД.ДополнительныеСвойства.Основание);
	
	ПлановыйПериод = "1";
	ПараметрПлановыйПериод = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПлановыйПериод"));
	НастройкаПлановыйПериод = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрПлановыйПериод.ИдентификаторПользовательскойНастройки);
	Если НЕ НастройкаПлановыйПериод = Неопределено Тогда
		ПлановыйПериод = НастройкаПлановыйПериод.Значение;
	Иначе
		ПлановыйПериод = ПараметрПлановыйПериод.Значение;
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "СчетаЛБО", БухгалтерскийУчет.СписокСчетов("501." + ПлановыйПериод + "3"));
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли