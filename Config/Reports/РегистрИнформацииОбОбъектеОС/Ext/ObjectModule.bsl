#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Перем ПользовательскиеНастройкиПериод;
Перем ПользовательскиеНастройкиОрганизация;
Перем ПользовательскиеНастройкиСписокОС;
Перем ПользовательскиеНастройкиОтветственный;


Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ПользовательскиеНастройкиПериод = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0];
	ПользовательскиеНастройкиОрганизация = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1];
	ПользовательскиеНастройкиСписокОС = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[2];
	ПользовательскиеНастройкиОтветственный = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[3];	
	
	Если ПользовательскиеНастройкиПериод.Значение = Дата(1,1,1) Тогда
		ТекстСообщения = НСтр("ru = 'Параметр ""Дата сведений"" не заполнен. Отчет не сформирован.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;	
	
	Если НЕ Значениезаполнено(ПользовательскиеНастройкиОрганизация.Значение) Тогда
		ТекстСообщения = НСтр("ru = 'Параметр ""Организация"" не заполнен. Отчет не сформирован.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;	
	
	Если ПользовательскиеНастройкиСписокОС.Значение = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Параметр ""Список объектов основных средств"" не заполнен. Отчет не сформирован.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(ПользовательскиеНастройкиСписокОС.Значение) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		ВыводДанныхОбОбъекте(ДокументРезультат,ПользовательскиеНастройкиСписокОС.Значение);
	Иначе
		Для каждого ОбъектСписка Из ПользовательскиеНастройкиСписокОС.Значение Цикл
			ВыводДанныхОбОбъекте(ДокументРезультат,ОбъектСписка);
		КонецЦикла;	
	КонецЕсли; 
	
	
КонецПроцедуры

Процедура ВыводДанныхОбОбъекте(ДокументРезультат,ОбъектОС)
	ПользовательскиеНастройкиОсновноеСредство = ОбъектОС;
	
	ВложеннаяСхема = СхемаКомпоновкиДанных.ВложенныеСхемыКомпоновкиДанных.Найти("РегистрУчетаПоОС");
	
	Если ВложеннаяСхема = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось получить вложенную схему компоновки данных ""Регистр учета по ОС"".'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;		
	
	Настройки = ВложеннаяСхема.Схема.НастройкиПоУмолчанию;

	ПараметрВложеннойСхемыПериод = ВложеннаяСхема.Схема.Параметры.Найти("Период");
	ПараметрВложеннойСхемыПериод.Значение = ПользовательскиеНастройкиПериод.Значение;
		
	ПараметрВложеннойСхемыОрганизация = ВложеннаяСхема.Схема.Параметры.Найти("Организация");
	ПараметрВложеннойСхемыОрганизация.Значение = ПользовательскиеНастройкиОрганизация.Значение;
		
	ПараметрВложеннойСхемыОС = ВложеннаяСхема.Схема.Параметры.Найти("ОсновноеСредство");
	ПараметрВложеннойСхемыОС.Значение = ?(ТипЗнч(ПользовательскиеНастройкиСписокОС.Значение) = Тип("СправочникСсылка.ОсновныеСредства"),ПользовательскиеНастройкиОсновноеСредство,ПользовательскиеНастройкиОсновноеСредство.Значение);
		
	ПараметрВложеннойСхемыОтветственный = ВложеннаяСхема.Схема.Параметры.Найти("Ответственный");
	ПараметрВложеннойСхемыОтветственный.Значение = ПользовательскиеНастройкиОтветственный.Значение;
	
	Настройки.ПараметрыДанных.Элементы[0].Значение = ПользовательскиеНастройкиПериод.Значение; 
	Настройки.ПараметрыДанных.Элементы[1].Значение = ПользовательскиеНастройкиОрганизация.Значение; 
	Настройки.ПараметрыДанных.Элементы[2].Значение = ?(ТипЗнч(ПользовательскиеНастройкиСписокОС.Значение) = Тип("СправочникСсылка.ОсновныеСредства"),ПользовательскиеНастройкиОсновноеСредство,ПользовательскиеНастройкиОсновноеСредство.Значение); 
	Настройки.ПараметрыДанных.Элементы[3].Значение = Корреспонденты.ФИОПоОбъекту(ПользовательскиеНастройкиОтветственный.Значение); 
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(ВложеннаяСхема.Схема, Настройки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,, Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;

	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);	
	
	ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
КонецПроцедуры	

#КонецЕсли

