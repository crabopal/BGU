#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ВариантыОтчетов

// Задать настройки формы отчета.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения
//         - Неопределено
//   КлючВарианта - Строка
//                - Неопределено
//   Настройки - см. ОтчетыКлиентСервер.НастройкиОтчетаПоУмолчанию
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	Настройки.РазрешеноИзменятьСтруктуру = Ложь;
	Настройки.События.ПриСозданииНаСервере = Истина;
	Настройки.События.ПередЗагрузкойВариантаНаСервере    = Истина; 
	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;
КонецПроцедуры

// См. ОтчетыПереопределяемый.ПриСозданииНаСервере.
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	// Связь между справочником "Основные средства, НМА, НПА", документами по учету прав пользования ОС, НПА
	// и параметром СКД при контекстном вызове отчета.
	ПараметрКоманды = Неопределено;
	Если Форма.Параметры.Свойство("ПараметрКоманды", ПараметрКоманды)
		И ЗначениеЗаполнено(ПараметрКоманды) Тогда
		
		ОбъектыПравПользования = Новый Массив;
		
		Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ОбъектыПравПользования.Добавить(ПараметрКоманды);
			
		ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("Массив") 
			И ПараметрКоманды.Количество() > 0 
			И ТипЗнч(ПараметрКоманды[0]) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ОбъектыПравПользования = ПараметрКоманды;
			
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ПараметрКоманды)) Тогда
			МассивДокументов = Новый Массив;
			МассивДокументов.Добавить(ПараметрКоманды);
			ОбъектыПравПользования = УправлениеОсновнымиСредствами.ОбъектыДляГрупповойПечатиКарточек(
				МассивДокументов, "ОсновноеСредство", ИмяТабличнойЧастиСОбъектамиОС(ПараметрКоманды));
			
		ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("Массив") 
			И ПараметрКоманды.Количество() > 0 
			И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ПараметрКоманды[0])) Тогда
			ОбъектыПравПользования = УправлениеОсновнымиСредствами.ОбъектыДляГрупповойПечатиКарточек(
				ПараметрКоманды, "ОсновноеСредство", ИмяТабличнойЧастиСОбъектамиОС(ПараметрКоманды[0]));
			
		КонецЕсли;
		
		ПараметрОбъектыПравПользования = Новый Структура("ОбъектыПравПользования", ПараметрДанных(ОбъектыПравПользования));
		УстановитьПараметрыДанных(КомпоновщикНастроек.Настройки, ПараметрОбъектыПравПользования);
		
	КонецЕсли;  
	
	// Дата сведений.
	ДатаСведений = Неопределено;
	Если Форма.Параметры.Свойство("ДатаСведений", ДатаСведений)
		И ЗначениеЗаполнено(ДатаСведений) Тогда 
		ПараметрДатаСведений = Новый Структура("ДатаСведений", ПараметрДанных(КонецДня(ДатаСведений)));
	Иначе
		ПараметрДатаСведений = Новый Структура("ДатаСведений", ПараметрДанных(КонецДня(ОбщегоНазначенияБГУ.РабочаяДатаПользователя())));
	КонецЕсли;
	УстановитьПараметрыДанных(КомпоновщикНастроек.Настройки, ПараметрДатаСведений);   
	
	// Организация.
	Организация = Неопределено;
	Если Форма.Параметры.Свойство("Организация", Организация)
		И ЗначениеЗаполнено(Организация) Тогда 
		ПараметрОрганизация = Новый Структура("Организация", ПараметрДанных(Организация));
		
	ИначеЕсли ТипЗнч(ОбъектыПравПользования) = Тип("Массив") И ОбъектыПравПользования.Количество() > 0
		И ТипЗнч(ОбъектыПравПользования[0]) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		ПараметрОрганизация = Новый Структура("Организация", ПараметрДанных(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектыПравПользования[0], "Организация")));
		
	ИначеЕсли ТипЗнч(ОбъектыПравПользования) = Тип("СправочникСсылка.ОсновныеСредства") 
		И ЗначениеЗаполнено(ОбъектыПравПользования) Тогда
		ПараметрОрганизация = Новый Структура("Организация", ПараметрДанных(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектыПравПользования, "Организация")));
		
	Иначе
		ПараметрОрганизация = Новый Структура("Организация", ПараметрДанных(ОбщегоНазначенияБГУ.ТекущаяОрганизация()));
		
	КонецЕсли;
	УстановитьПараметрыДанных(КомпоновщикНастроек.Настройки, ПараметрОрганизация);   
	
КонецПроцедуры

// См. ОтчетыПереопределяемый.ПередЗагрузкойВариантаНаСервере.
Процедура ПередЗагрузкойВариантаНаСервере(Форма, НовыеНастройкиКД) Экспорт
	
	СтруктураПараметровДанных = Новый Структура;
	Для Каждого ТекущийПараметр Из КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл
		Если ТекущийПараметр.Использование Тогда
			СтруктураПараметровДанных.Вставить(Строка(ТекущийПараметр.Параметр), ПараметрДанных(ТекущийПараметр.Значение));
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПараметрыДанных(НовыеНастройкиКД, СтруктураПараметровДанных);
	
КонецПроцедуры

// Вызывается перед загрузкой новых настроек. Используется для изменения СКД отчета.
//
// Параметры:
//   Контекст - Произвольный
//   КлючСхемы - Строка
//   КлючВарианта - Строка
//                - Неопределено
//   НовыеНастройкиКД - НастройкиКомпоновкиДанных
//                    - Неопределено
//   НовыеПользовательскиеНастройкиКД - ПользовательскиеНастройкиКомпоновкиДанных
//                                    - Неопределено
//
Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт
	
	СтруктураПараметровДанных = Новый Структура;
	Для Каждого ТекущийПараметр Из КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл
		Если ТекущийПараметр.Использование Тогда
			СтруктураПараметровДанных.Вставить(Строка(ТекущийПараметр.Параметр), ПараметрДанных(ТекущийПараметр.Значение));
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПараметрыДанных(НовыеНастройкиКД, СтруктураПараметровДанных, НовыеПользовательскиеНастройкиКД);
	
КонецПроцедуры 

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДокументРезультат.Очистить();

	ИсполняемыеНастройки = КомпоновщикНастроек.ПолучитьНастройки();

	ПараметрДатаСведений = ИсполняемыеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаСведений"));
	Если ТипЗнч(ПараметрДатаСведений.Значение) = Тип("Дата") Тогда
		ДатаСведений = КонецДня(ПараметрДатаСведений.Значение);
	Иначе
		ДатаСведений = КонецДня(ПараметрДатаСведений.Значение.Дата);
	КонецЕсли;
	
	ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("НачалоПериода"), Дата(1,1,1));
	ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("КонецПериода"), ДатаСведений);
	ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("СчетаУчетаПравПользования"), БухгалтерскийУчет.СписокСчетов("111.40"));

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ИсполняемыеНастройки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных, , , Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	ДеревоРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	ОтчетПустой = ДеревоРезультат.Строки.Количество() = 0;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ОтчетПустой", ОтчетПустой);

	МассивОбъектов = Новый Массив;
	Для Каждого ТекушаяОрганизация Из ДеревоРезультат.Строки Цикл
		Для Каждого ТекушийСчетУчета Из ТекушаяОрганизация.Строки Цикл
			Для Каждого ОбъектОС Из ТекушийСчетУчета.Строки Цикл
				МассивОбъектов.Добавить(ОбъектОС.ОсновноеСредство);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДатаСведений", ДатаСведений);
	
	Если СтрНайти(ИсполняемыеНастройки.ДополнительныеСвойства.КлючВарианта, "ВсяИстория") Тогда
		ПараметрыПечати.Вставить("ВыводитьПолныйГрафикАмортизации", Истина);
		ПараметрыПечати.Вставить("ВыводитьВсюИсторию", Истина);
	ИначеЕсли СтрНайти(ИсполняемыеНастройки.ДополнительныеСвойства.КлючВарианта, "Развернутая") Тогда
		ПараметрыПечати.Вставить("ВыводитьПолныйГрафикАмортизации", Истина);
		ПараметрыПечати.Вставить("ВыводитьВсюИсторию", Ложь);
	Иначе // Обычная.
		ПараметрыПечати.Вставить("ВыводитьПолныйГрафикАмортизации", Ложь);
		ПараметрыПечати.Вставить("ВыводитьВсюИсторию", Ложь);
	КонецЕсли;
	
	Отчеты.КарточкаУчетаПраваПользованияНФА.ПечатьКарточкиУчетаПраваПользованияНФА(
		ДокументРезультат, МассивОбъектов, ОбъектыПечати, ПараметрыПечати);
	
	// ОбъектыПечати можно добавить в доп. свойства пользовательских настроек и они будут доступны в форме 
	// отчета после его формирования 	
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ОбъектыПечати", ОбъектыПечати);
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить(
		"ПользовательскиеНастройкиМодифицированы", Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьПараметрыДанных(Настройки, ЗначенияПараметров, ПользовательскиеНастройки = Неопределено)
	
	ПараметрыДанных = Настройки.ПараметрыДанных.Элементы;
	
	Для Каждого ЗначениеПараметра Из ЗначенияПараметров Цикл 
		
		ПараметрДанных = ПараметрыДанных.Найти(ЗначениеПараметра.Ключ);
		
		Если ПараметрДанных = Неопределено Тогда
             Продолжить;
		КонецЕсли;
		
		ПараметрДанных.Использование = ЗначениеПараметра.Значение.Использование;
		ПараметрДанных.Значение = ЗначениеПараметра.Значение.ЗначениеПараметра;
		
		Если Не ЗначениеЗаполнено(ПараметрДанных.ИдентификаторПользовательскойНастройки)
			Или ТипЗнч(ПользовательскиеНастройки) <> Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда 
			Продолжить;
		КонецЕсли;
		
		СоответствующийПараметр = ПользовательскиеНастройки.Элементы.Найти(
			ПараметрДанных.ИдентификаторПользовательскойНастройки);
		
		Если СоответствующийПараметр <> Неопределено Тогда 
			ЗаполнитьЗначенияСвойств(СоответствующийПараметр, ПараметрДанных, "Использование, Значение");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПараметрДанных(ЗначениеПараметра, Использование = Истина)

	Возврат Новый Структура("ЗначениеПараметра, Использование", ЗначениеПараметра, Использование);
	
КонецФункции

Функция ИмяТабличнойЧастиСОбъектамиОС(ДокументСсылка)
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПрекращениеПравПользованияОС") Тогда
		Возврат "ПраваПользования";
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктПриемкиОбъектовПравПользованияОС") Тогда
		Возврат "СведенияОбИмуществе";
	Иначе
		Возврат "ОсновныеСредства";
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецЕсли