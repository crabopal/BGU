	КонецЕсли;
	
	СведенияОбОбъектах = Результаты[ИндексыРезультатов.СведенияИСтоимостьОбъектовПравПользования].Выгрузить();
	ДанныеДляПечати.Вставить("СведенияОбОбъектах", СведенияОбОбъектах);
	
	ГрафикНачисленияАмортизации = Результаты[ИндексыРезультатов.ГрафикНачисленияАмортизации].Выгрузить();
	ДанныеДляПечати.Вставить("ГрафикНачисленияАмортизации", ГрафикНачисленияАмортизации);
	
	СоставОбъектов = Результаты[ИндексыРезультатов.СоставОбъектовПравПользованияОС].Выгрузить();
	ДанныеДляПечати.Вставить("СоставОбъектов", СоставОбъектов);
	
	СведенияОНеотделимыхУлучшениях = Результаты[ИндексыРезультатов.СведенияОНеотделимыхУлучшениях].Выгрузить();
	ДанныеДляПечати.Вставить("СведенияОНеотделимыхУлучшениях", СведенияОНеотделимыхУлучшениях);
	
	РезервыПоДоговорам = Результаты[ИндексыРезультатов.РезервыПоДоговорам].Выгрузить();
	РезервыПоДоговорам.Индексы.Добавить("Организация, Договор");
	
	// Пересчет числовых показателей в валюту регламентированного учета.
	Если ДанныеДляПечати.ДанныеБУ.Свойство("ПервоначальнаяСтоимость") Тогда
		КурсПересчета = ОпределитьКурсПересчетаПоДаннымОРезервах(ДанныеДляПечати.ДанныеБУ, РезервыПоДоговорам);
		ДанныеДляПечати.ДанныеБУ.ПервоначальнаяСтоимость = КурсПересчета * ДанныеДляПечати.ДанныеБУ.ПервоначальнаяСтоимость;
	КонецЕсли;
	Для Каждого СтрокаСведенияОбОбъектах Из ДанныеДляПечати.СведенияОбОбъектах Цикл
		КурсПересчета = ОпределитьКурсПересчетаПоДаннымОРезервах(СтрокаСведенияОбОбъектах, РезервыПоДоговорам);
		СтрокаСведенияОбОбъектах.АренднаяПлатаСумма      = КурсПересчета * СтрокаСведенияОбОбъектах.АренднаяПлатаСумма;
		СтрокаСведенияОбОбъектах.АренднаяПлатаОбщаяСумма = КурсПересчета * СтрокаСведенияОбОбъектах.АренднаяПлатаОбщаяСумма;
		СтрокаСведенияОбОбъектах.АренднаяПлатаИзменение  = КурсПересчета * СтрокаСведенияОбОбъектах.АренднаяПлатаИзменение;
		СтрокаСведенияОбОбъектах.АмортизацияОбщаяСумма   = КурсПересчета * СтрокаСведенияОбОбъектах.АмортизацияОбщаяСумма;
		СтрокаСведенияОбОбъектах.АмортизацияИзменение    = КурсПересчета * СтрокаСведенияОбОбъектах.АмортизацияИзменение;
	КонецЦикла;
	Для Каждого СтрокаГрафикНачисленияАмортизации Из ДанныеДляПечати.ГрафикНачисленияАмортизации Цикл
		КурсПересчета = ОпределитьКурсПересчетаПоДаннымОРезервах(СтрокаГрафикНачисленияАмортизации, РезервыПоДоговорам);
		СтрокаГрафикНачисленияАмортизации.Амортизация                 = КурсПересчета * СтрокаГрафикНачисленияАмортизации.Амортизация;
		СтрокаГрафикНачисленияАмортизации.АренднаяПлата               = КурсПересчета * СтрокаГрафикНачисленияАмортизации.АренднаяПлата;
		СтрокаГрафикНачисленияАмортизации.СуммаПоПервоначальнойОценке = КурсПересчета * СтрокаГрафикНачисленияАмортизации.СуммаПоПервоначальнойОценке;
		СтрокаГрафикНачисленияАмортизации.СуммаПоПоследующейОценке    = КурсПересчета * СтрокаГрафикНачисленияАмортизации.СуммаПоПоследующейОценке;
	КонецЦикла;
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Процедура ВывестиШапкуКарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, ДанныеБУ, ДатаСведений, СведенияИсполнителя)
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Заполнить(ОбъектПраваПользования);
	
	// Наименование структурного подразделения, в котором сформирован документ.
	Если СведенияИсполнителя.Свойство("СтруктурноеПодразделение")
		И ЗначениеЗаполнено(СведенияИсполнителя.СтруктурноеПодразделение) Тогда
		ОбластьШапка.Параметры.СтруктурноеПодразделение = СведенияИсполнителя.СтруктурноеПодразделение;
	КонецЕсли;
	Если СведенияИсполнителя.Свойство("НаименованиеСтруктурногоПодразделения")
		И ЗначениеЗаполнено(СведенияИсполнителя.НаименованиеСтруктурногоПодразделения) Тогда
		ОбластьШапка.Параметры.НаименованиеСтруктурногоПодразделения = СведенияИсполнителя.НаименованиеСтруктурногоПодразделения;
	КонецЕсли;
	
	Если ДанныеБУ.Количество() > 0 Тогда
		
		ОбластьШапка.Параметры.Заполнить(ДанныеБУ);
		
		ОбластьШапка.Параметры.НомерСчета = СтрШаблон("%1 %2 %3 %4",
			СокрЛП(ДанныеБУ.КПС),
			СокрЛП(ДанныеБУ.КФО),
			СтрЗаменить(ДанныеБУ.СчетУчета, ".", " "),
			"000");
		
		Если ЗначениеЗаполнено(ДанныеБУ.МестоХранения) Тогда
			АдресМестаХранения = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ДанныеБУ.МестоХранения,
				Справочники.ВидыКонтактнойИнформации.АдресМестаХранения);
		Иначе
			АдресМестаХранения = "";
		КонецЕсли;
		Если ЗначениеЗаполнено(АдресМестаХранения) Тогда
			МестонахождениеОбъекта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1, %2'"), ДанныеБУ.МестоХранения, АдресМестаХранения);
		Иначе
			МестонахождениеОбъекта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1'"), ДанныеБУ.МестоХранения);
		КонецЕсли;
		ОбластьШапка.Параметры.МестонахождениеОбъекта = МестонахождениеОбъекта;
		
		Если ЗначениеЗаполнено(ДанныеБУ.Сотрудник) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект,Период,Фамилия,Имя,Отчество,Должность,ДолжностьНаименование", ДанныеБУ.Сотрудник, ДатаСведений);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
			ОтветственноеЛицоФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь, , Ложь);
			ОбластьШапка.Параметры.ОтветственноеЛицо = ?(ЗначениеЗаполнено(ДанныеСотрудника.ДолжностьНаименование),
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, %2'"), ОтветственноеЛицоФИО, ДанныеСотрудника.ДолжностьНаименование),
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"), ОтветственноеЛицоФИО));
		КонецЕсли;
		
	КонецЕсли;
	
	ОбластьШапка.Параметры.Дата = Формат(ДатаСведений, "ДЛФ=Д");
	
	ОбластьШапка.Параметры.ДатаЗакрытия = ?(ОбъектПраваПользования.ОбъектВыбылВЗаданномПериоде И ЗначениеЗаполнено(ОбъектПраваПользования.МаксДатаВыбытия),
			Формат(ОбъектПраваПользования.МаксДатаВыбытия, "ДЛФ=Д"),
			Дата(1, 1, 1));
	
	ТабДокумент.Вывести(ОбластьШапка);
	
КонецПроцедуры

Процедура ВывестиРаздел1КарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, ДанныеБУ, СведенияОбОбъекте)
	
	ОбластьРаздел11Шапка  = Макет.ПолучитьОбласть("Раздел11Шапка");
	ОбластьРаздел11Строка = Макет.ПолучитьОбласть("Раздел11Строка");
	ОбластьРаздел11Итоги  = Макет.ПолучитьОбласть("Раздел11Итоги");
	ОбластьРаздел12Шапка  = Макет.ПолучитьОбласть("Раздел12Шапка");
	ОбластьРаздел12Строка = Макет.ПолучитьОбласть("Раздел12Строка");
	ОбластьРаздел12Итоги  = Макет.ПолучитьОбласть("Раздел12Итоги");
	
	// Раздел 1.1.
	ТабДокумент.Вывести(ОбластьРаздел11Шапка);
	
	Для Каждого СтрокаСведений Из СведенияОбОбъекте Цикл
		
		Если ЗначениеЗаполнено(СтрокаСведений.ТипИзмененийУсловийПользования) Тогда
			Продолжить;
		КонецЕсли;
		
		ОбластьРаздел11Строка.Параметры.Заполнить(СтрокаСведений);
		
		Если ДанныеБУ.Количество() > 0 Тогда
			Если Не ЗначениеЗаполнено(ОбластьРаздел11Строка.Параметры.ДатаПриемкиВПользование) Тогда
				// Если дата приемки не заполнена по данным регистра СведенияОбОбъектахПравПользованияОС (новый вариант),
				// то заполним по данным регистра СоставОбъектовПравПользованияОС (устаревший вариант).
				ОбластьРаздел11Строка.Параметры.ДатаПриемкиВПользование = ДанныеБУ.ДатаПриемкиВПользование;
			КонецЕсли;
			ОбластьРаздел11Строка.Параметры.АренднаяПлатаОбщаяСумма =
				?(ЗначениеЗаполнено(СтрокаСведений.ДатаОкончанияПользования), ДанныеБУ.ПервоначальнаяСтоимость, "х");
		КонецЕсли;
		
		Если СтрНайти("12,22", СтрокаСведений.УсловиеПользованияКод)
			ИЛИ НЕ ЗначениеЗаполнено(ОбластьРаздел11Строка.Параметры.ДатаОкончанияПользования) Тогда
			// Графа 7 принимает значение "31.12.2999", если графы 4 - 5 принимают одно из значений:
			// 12 - аренда с неопределенным сроком использования или
			// 22 - безвозмездное пользование с неопределенным сроком использования.
			ОбластьРаздел11Строка.Параметры.ДатаОкончанияПользования = Дата(2999,12,31);
		КонецЕсли;
		Если ОбластьРаздел11Строка.Параметры.ДатаОкончанияПользования = Дата(2999,12,31) Тогда
			// Графа 12 не заполняется, если графа 7 принимает значение "31.12.2999".
			ОбластьРаздел11Строка.Параметры.АренднаяПлатаОбщаяСумма = 0;
		КонецЕсли;
		Если СтрНайти("21,22", СтрокаСведений.УсловиеПользованияКод) Тогда
			 // Графа 11 не заполняется для договоров безвозмездного пользования.
			ОбластьРаздел11Строка.Параметры.АренднаяПлатаДеньНачисления = "";
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьРаздел11Строка);
		
	КонецЦикла;
	
	ТабДокумент.Вывести(ОбластьРаздел11Итоги);
	
	// Раздел 1.2.
	ТабДокумент.Вывести(ОбластьРаздел12Шапка);
	
	КодСтроки = 0;
	АренднаяПлатаСуммаИзменения = 0;
	АмортизацияСуммаИзменения = 0;
	Для Каждого СтрокаСведений Из СведенияОбОбъекте Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСведений.ТипИзмененийУсловийПользования) Тогда
			Продолжить;
		КонецЕсли;
		
		КодСтроки = КодСтроки + 1;
		АренднаяПлатаСуммаИзменения = АренднаяПлатаСуммаИзменения + СтрокаСведений.АренднаяПлатаИзменение;
		АмортизацияСуммаИзменения   = АмортизацияСуммаИзменения   + СтрокаСведений.АмортизацияИзменение;
		
		ОбластьРаздел12Строка.Параметры.Заполнить(СтрокаСведений);
		ОбластьРаздел12Строка.Параметры.КодСтроки = КодСтроки;
		
		Если СтрНайти("А1", СтрокаСведений.ТипИзмененийУсловийПользованияКод) Тогда
			ОбластьРаздел12Строка.Параметры.ДатаНачалаПользования = "х";
			ОбластьРаздел12Строка.Параметры.ДатаОкончанияПользования = "х";
		ИначеЕсли СтрНайти("С1,С2,С3,С4,С5,С6", СтрокаСведений.ТипИзмененийУсловийПользованияКод) Тогда
			ОбластьРаздел12Строка.Параметры.АренднаяПлатаЗаПериод = "х";
			ОбластьРаздел12Строка.Параметры.АренднаяПлатаСумма = "х";
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьРаздел12Строка);
		
	КонецЦикла;
	
	ОбластьРаздел12Итоги.Параметры.АмортизацияСуммаИзменения = АмортизацияСуммаИзменения;
	ТабДокумент.Вывести(ОбластьРаздел12Итоги);
	
КонецПроцедуры

Процедура ВывестиРаздел2КарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, ГрафикНачисленияАмортизации, ДатаСведений, ПараметрыПечати)
	
	ОбластьРаздел2Шапка = Макет.ПолучитьОбласть("Раздел2Шапка");
	ОбластьРаздел2Строка = Макет.ПолучитьОбласть("Раздел2Строка");
	ОбластьРаздел2Итоги = Макет.ПолучитьОбласть("Раздел2Итоги");
	ОбластьРаздел2ИтогиПоГодам = Макет.ПолучитьОбласть("Раздел2ИтогиПоГодам");
	ОбластьРаздел2Подвал = Макет.ПолучитьОбласть("Раздел2Подвал");
	
	ТабДокумент.Вывести(ОбластьРаздел2Шапка);
	
	ВыводитьПолныйГрафикАмортизации = ?(ПараметрыПечати.Свойство("ВыводитьПолныйГрафикАмортизации"), ПараметрыПечати.ВыводитьПолныйГрафикАмортизации, Ложь);
	
	// График начисления амортизации, свернутый по периодам.
	ИтогиПоГодам = Новый ТаблицаЗначений;
	ИтогиПоГодам.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	ИтогиПоГодам.Колонки.Добавить("ТипПериода", Новый ОписаниеТипов("Строка"));
	ИтогиПоГодам.Колонки.Добавить("СуммаПоПервоначальнойОценке", Новый ОписаниеТипов("Число"));
	ИтогиПоГодам.Колонки.Добавить("СуммаПоПоследующейОценке", Новый ОписаниеТипов("Число"));
	ДатаНачалаАмортизации = '00010101';
	ДатаОкончанияАмортизации = '00010101';
	
	КодСтроки = 1;
	Для Каждого СтрокаГрафика Из ГрафикНачисленияАмортизации Цикл
		
		ЭтоПредыдущиеГоды = ( Год(СтрокаГрафика.ДатаНачисленияАмортизации) < Год(ДатаСведений) );
		ЭтоТекущийГод     = ( Год(СтрокаГрафика.ДатаНачисленияАмортизации) = Год(ДатаСведений) );
		ЭтоСледующиеГоды  = ( Год(СтрокаГрафика.ДатаНачисленияАмортизации) > Год(ДатаСведений) );
		НоваяСтрока = ИтогиПоГодам.Добавить();
		Если ЭтоПредыдущиеГоды Тогда
			НоваяСтрока.ТипПериода = "ЗаПредыдущиеГоды";
			НоваяСтрока.Период = '00010101';
		ИначеЕсли ЭтоТекущийГод Тогда
			НоваяСтрока.ТипПериода = "ЗаТекущийГод";
			НоваяСтрока.Период = НачалоМесяца(СтрокаГрафика.ДатаНачисленияАмортизации);
		ИначеЕсли ЭтоСледующиеГоды Тогда
			Если Год(СтрокаГрафика.ДатаНачисленияАмортизации) - Год(ДатаСведений) <= 3 Тогда
				НоваяСтрока.ТипПериода = "НаПоследующие3Года";
				НоваяСтрока.Период = НачалоГода(СтрокаГрафика.ДатаНачисленияАмортизации);
			Иначе
				НоваяСтрока.ТипПериода = "НаПоследующиеГоды";
				НоваяСтрока.Период = '29991231';
			КонецЕсли;
		КонецЕсли;
		НоваяСтрока.СуммаПоПервоначальнойОценке = СтрокаГрафика.СуммаПоПервоначальнойОценке;
		НоваяСтрока.СуммаПоПоследующейОценке = СтрокаГрафика.СуммаПоПоследующейОценке;
		
		// Даты начала и окончания амортизации рассчитываем по данным графика.
		ДатаНачалаАмортизации = ?(ЗначениеЗаполнено(ДатаНачалаАмортизации),
			Мин(ДатаНачалаАмортизации, СтрокаГрафика.ДатаНачисленияАмортизации),
			СтрокаГрафика.ДатаНачисленияАмортизации);
		ДатаОкончанияАмортизации = ?(ЗначениеЗаполнено(ДатаОкончанияАмортизации),
			Макс(ДатаОкончанияАмортизации, СтрокаГрафика.ДатаНачисленияАмортизации),
			СтрокаГрафика.ДатаНачисленияАмортизации);
		
		Если ВыводитьПолныйГрафикАмортизации Тогда // Вывод строк графика в разделе 2 - полный график амортизации.
			ОбластьРаздел2Строка.Параметры.Заполнить(СтрокаГрафика);
			ОбластьРаздел2Строка.Параметры.КодСтроки = КодСтроки;
			ОбластьРаздел2Строка.Параметры.ДатаНачисленияАмортизации = Формат(СтрокаГрафика.ДатаНачисленияАмортизации, "ДЛФ=Д");
			ТабДокумент.Вывести(ОбластьРаздел2Строка);
		КонецЕсли;
		
		КодСтроки = КодСтроки + 1;
		
	КонецЦикла;
	
	ИтогиПоГодам.Свернуть("ТипПериода,Период", "СуммаПоПервоначальнойОценке,СуммаПоПоследующейОценке");
	ИтогиПоГодам.Сортировать("Период");
	
	Если Не ВыводитьПолныйГрафикАмортизации Тогда // Вывод строк графика в разделе 2 - свернутый график амортизации.
		
		КодСтроки = 1;
		Для Каждого ГодовойИтог Из ИтогиПоГодам Цикл
			
			ОбластьРаздел2Строка.Параметры.Заполнить(ГодовойИтог);
			ОбластьРаздел2Строка.Параметры.КодСтроки = КодСтроки;
			ОбластьРаздел2Строка.Параметры.ДатаНачисленияАмортизации =
				ОписаниеПериодаГрафикаАмортизации(ГодовойИтог.Период, ГодовойИтог.ТипПериода, ДатаНачалаАмортизации, ДатаОкончанияАмортизации, ДатаСведений, "ТАБЛИЦА");
			ТабДокумент.Вывести(ОбластьРаздел2Строка);
			
			КодСтроки = КодСтроки + 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Общий итог.
	ОбластьРаздел2Итоги.Параметры.СуммаПоПервоначальнойОценке = ИтогиПоГодам.Итог("СуммаПоПервоначальнойОценке");
	ОбластьРаздел2Итоги.Параметры.СуммаПоПоследующейОценке = ИтогиПоГодам.Итог("СуммаПоПоследующейОценке");
	ТабДокумент.Вывести(ОбластьРаздел2Итоги);
	
	// Секция "в том числе по годам".
	ШаблонВТомЧислеПоГодам = НСтр("ru = 'в том числе по годам: '");
	ОтборЗаТекущийГод = Новый Структура("ТипПериода", "ЗаТекущийГод");
	СтрокиЗаТекущийГод = ИтогиПоГодам.НайтиСтроки(ОтборЗаТекущийГод);
	Для Каждого СтрокаИтогов Из СтрокиЗаТекущийГод Цикл
		// Приводим Период к началу года, чтобы свернуть по месяцам текущего года.
		СтрокаИтогов.Период = НачалоГода(СтрокаИтогов.Период);
	КонецЦикла;
	ИтогиПоГодам.Свернуть("ТипПериода,Период", "СуммаПоПервоначальнойОценке,СуммаПоПоследующейОценке");
	ИтогиПоГодам.Сортировать("Период");
	Для Каждого ГодовойИтог Из ИтогиПоГодам Цикл
		
		ОбластьРаздел2ИтогиПоГодам.Параметры.Заполнить(ГодовойИтог);
		ОбластьРаздел2ИтогиПоГодам.Параметры.ЗаголовокИтого = ШаблонВТомЧислеПоГодам +
			ОписаниеПериодаГрафикаАмортизации(ГодовойИтог.Период, ГодовойИтог.ТипПериода, ДатаНачалаАмортизации, ДатаОкончанияАмортизации, ДатаСведений, "ИТОГИ");
		ШаблонВТомЧислеПоГодам = ""; // Очищаем, выводим только в первой строке.
		
		ТабДокумент.Вывести(ОбластьРаздел2ИтогиПоГодам);
		
	КонецЦикла;
	
	ТабДокумент.Вывести(ОбластьРаздел2Подвал);
	
КонецПроцедуры

Процедура ВывестиРаздел3КарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, ДанныеБУ, СведенияОбОбъекте)
	
	ОбластьРаздел3Шапка  = Макет.ПолучитьОбласть("Раздел3Шапка");
	ОбластьРаздел3Строка = Макет.ПолучитьОбласть("Раздел3Строка");
	ОбластьРаздел3Итоги  = Макет.ПолучитьОбласть("Раздел3Итоги");
	
	ОбластьРаздел3Строка.Параметры.Заполнить(ОбъектПраваПользования);
	
	Если ДанныеБУ.Количество() > 0 Тогда
		
		ОбластьРаздел3Строка.Параметры.Заполнить(ДанныеБУ);
		
		ОбластьРаздел3Строка.Параметры.ИзменениеСтоимости =
			ДанныеБУ.БалансоваяСтоимость - ДанныеБУ.ПервоначальнаяСтоимость;
		ОбластьРаздел3Строка.Параметры.ОстаточнаяСтоимость =
			ДанныеБУ.БалансоваяСтоимость - ДанныеБУ.СуммаАмортизации - ДанныеБУ.СуммаОбесценения;
		
	КонецЕсли;
	
	// Определяем дополнительные параметры.
	СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПустаяСсылка();
	АренднаяПлатаДеньНачисления = 0;
	Для Каждого СтрокаСведений Из СведенияОбОбъекте Цикл
		Если ЗначениеЗаполнено(СтрокаСведений.СпособПризнанияРасходов) Тогда
			СпособПризнанияРасходов = СтрокаСведений.СпособПризнанияРасходов; // Последний зарегистрированный способ.
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаСведений.АренднаяПлатаДеньНачисления) Тогда
			АренднаяПлатаДеньНачисления = СтрокаСведений.АренднаяПлатаДеньНачисления; // Последний зарегистрированный.
		КонецЕсли;
	КонецЦикла;
	
	Если СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам
		Или СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням Тогда
		ОбластьРаздел3Строка.Параметры.СрокНачисления = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'ежемесячно %1 числа'"), АренднаяПлатаДеньНачисления);
	ИначеЕсли СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику Тогда
		ОбластьРаздел3Строка.Параметры.СрокНачисления = НСтр("ru = 'в соответствии с графиком арендных платежей'");
	Иначе
		ОбластьРаздел3Строка.Параметры.СрокНачисления = НСтр("ru = 'в особом порядке'");
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьРаздел3Шапка);
	ТабДокумент.Вывести(ОбластьРаздел3Строка);
	
	ЗаполнитьЗначенияСвойств(ОбластьРаздел3Итоги.Параметры, ОбластьРаздел3Строка.Параметры,
		"БалансоваяСтоимость,СуммаАмортизации,СуммаОбесценения,ОстаточнаяСтоимость");
	ТабДокумент.Вывести(ОбластьРаздел3Итоги);
	
КонецПроцедуры

Процедура ВывестиРаздел41КарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, СоставОбъекта)
	
