#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Функция ЭтоРегистрУчета() Экспорт
	
	Возврат Истина;
	
КонецФункции

Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	НастройкиКН = ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрыДанных = НастройкиКН.ПараметрыДанных;
	
	Параметр = ПараметрыДанных.Элементы.Найти("Организация");
	Если Параметр <> Неопределено Тогда
		СвойстваРегистраУчета.Вставить("Организация", Параметр.Значение);
	КонецЕсли;
	
	Параметр = ПараметрыДанных.Элементы.Найти("ДатаСведений");
	Если Параметр <> Неопределено Тогда
		СвойстваРегистраУчета.Вставить("КонецПериода", Параметр.Значение);
	КонецЕсли;
	СвойстваРегистраУчета.Вставить("НачалоПериода", '00010101');
	
	Параметр = ПараметрыДанных.Элементы.Найти("ОбъектыПравПользования");
	Если Параметр <> Неопределено Тогда   
		Если ТипЗнч(Параметр.Значение) = Тип("СписокЗначений") Тогда
			Если СвойстваРегистраУчета.Свойство("Объект") И ЗначениеЗаполнено(СвойстваРегистраУчета.Объект) Тогда
				ДополнениеИмени = " " + СвойстваРегистраУчета.Объект;

				// Т.к. отчет строился по списку объектов, а свойства регистра собираем для одного объекта,
				// заменим компоновщик настроек и установим ему новый параметр отбора по текущему объекту
				РегистрыУчета.УстановитьВСвойстваКомпоновщикСОтборомПоОбъекту(
					НастройкиКН, Параметр, СвойстваРегистраУчета);
			Иначе	
				ДополнениеИмени = Параметр.Значение.ВыгрузитьЗначения();
				ДополнениеИмени = " " + СтрСоединить(ДополнениеИмени, "; ");
			КонецЕсли;	
		Иначе
			ДополнениеИмени = " " + Параметр.Значение;
		КонецЕсли;	
		СвойстваРегистраУчета.Вставить("ДополнениеИмени", ДополнениеИмени);
	КонецЕсли;
	
КонецПроцедуры

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "КарточкаУчетаПраваПользованияНФА");
	НастройкиВарианта.Описание = НСтр("ru = 'Карточка учета права пользования НФА'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "КарточкаУчетаПраваПользованияНФАРазвернутая");
	НастройкиВарианта.Описание = НСтр("ru = 'Карточка учета права пользования НФА (развернутая)'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "КарточкаУчетаПраваПользованияНФАВсяИстория");
	НастройкиВарианта.Описание = НСтр("ru = 'Карточка учета права пользования НФА (вся история)'");
	
КонецПроцедуры

// Определяет состав программного интерфейса для интеграции с конфигурацией.
//
// Параметры:
//   Настройки - Структура - Настройки интеграции этого объекта.
//       См. возвращаемое значение функции ПодключаемыеКоманды.НастройкиПодключаемыхОтчетовИОбработок().
//
Процедура ПриОпределенииНастроек(Настройки) Экспорт       
	
	Настройки.Размещение.Добавить(Метаданные.Справочники.ОсновныеСредства);
	Настройки.Размещение.Добавить(Метаданные.Документы.ПринятиеКУчетуПравПользованияОС);
	Настройки.Размещение.Добавить(Метаданные.Документы.ПрекращениеПравПользованияОС);
	Настройки.Размещение.Добавить(Метаданные.Документы.АктПриемкиОбъектовПравПользованияОС);
	Настройки.Размещение.Добавить(Метаданные.Документы.ВнутреннееПеремещениеОбъектовПравПользованияОС);
	Настройки.Размещение.Добавить(Метаданные.Документы.ВводИсторииПравПользованияОС);
	Настройки.ДобавитьКомандыОтчетов = Истина;
	
КонецПроцедуры     

// Определяет список команд отчетов.
//
// Параметры:
//   КомандыОтчетов - ТаблицаЗначений - Таблица с командами отчетов. Для изменения.
//       См. описание 1 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт
	
	Если ПравоДоступа("Просмотр", Метаданные.Отчеты.КарточкаУчетаПраваПользованияНФА) Тогда
		
		Если СтрНайти(Параметры.ИмяФормы, "Справочник.ОсновныеСредства") > 0 Тогда 
			
			Команда = КомандыОтчетов.Добавить();
			Команда.Представление = НСтр("ru = 'Карточка учета права пользования НФА'");
			Команда.КлючВарианта = "КарточкаУчетаПраваПользованияНФА";
			Команда.Картинка = БиблиотекаКартинок.Отчет;
			Команда.МножественныйВыбор = Истина;
			Команда.Менеджер = "Отчет.КарточкаУчетаПраваПользованияНФА";
			Команда.ЕстьУсловияВидимости = Истина;
			ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(Команда,
				"ВидНФА", Перечисления.ВидыНФА.ПраваПользованияИмуществом, ВидСравненияКомпоновкиДанных.Равно);
			
			Команда = КомандыОтчетов.Добавить();
			Команда.Представление = НСтр("ru = 'Карточка учета права пользования НФА (развернутая)'");
			Команда.КлючВарианта = "КарточкаУчетаПраваПользованияНФАРазвернутая";
			Команда.Картинка = БиблиотекаКартинок.Отчет;
			Команда.МножественныйВыбор = Истина;
			Команда.Менеджер = "Отчет.КарточкаУчетаПраваПользованияНФА";
			Команда.ЕстьУсловияВидимости = Истина;
			ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(Команда,
				"ВидНФА", Перечисления.ВидыНФА.ПраваПользованияИмуществом, ВидСравненияКомпоновкиДанных.Равно);
			
			Команда = КомандыОтчетов.Добавить();
			Команда.Представление = НСтр("ru = 'Карточка учета права пользования НФА (вся история)'");
			Команда.КлючВарианта = "КарточкаУчетаПраваПользованияНФАВсяИстория";
			Команда.Картинка = БиблиотекаКартинок.Отчет;
			Команда.МножественныйВыбор = Истина;
			Команда.Менеджер = "Отчет.КарточкаУчетаПраваПользованияНФА";
			Команда.ЕстьУсловияВидимости = Истина;
			ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(Команда,
				"ВидНФА", Перечисления.ВидыНФА.ПраваПользованияИмуществом, ВидСравненияКомпоновкиДанных.Равно);
			
		ИначеЕсли СтрНайти(Параметры.ИмяФормы, "Документ.") > 0
			ИЛИ СтрНайти(Параметры.ИмяФормы, "ЖурналДокументов.") > 0 Тогда
			
			Команда = КомандыОтчетов.Добавить();
			Команда.Представление = УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
				НСтр("ru = 'Карточки учета прав пользования НФА'"), "0509214");
			Команда.КлючВарианта = "КарточкаУчетаПраваПользованияНФА";
			Команда.Картинка = БиблиотекаКартинок.Отчет;
			Команда.МножественныйВыбор = Истина;
			Команда.Менеджер = "Отчет.КарточкаУчетаПраваПользованияНФА";
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КарточкаУчетаПраваПользованияНФА

Функция ПечатьКарточкиУчетаПраваПользованияНФА(ТабДокумент, МассивОбъектов, ОбъектыПечати, ПараметрыПечати = Неопределено) Экспорт
	
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ТолькоПросмотр		= Истина;
	ТабДокумент.КлючПараметровПечати	= "ПараметрыПечати_КарточкаУчетаПраваПользованияНФА_0509214";
	
	Макет = Отчеты.КарточкаУчетаПраваПользованияНФА.ПолучитьМакет("ПФ_MXL_0509214");
	
	Если ПараметрыПечати <> Неопределено И ПараметрыПечати.Свойство("ДатаСведений") Тогда
		ДатаСведений = КонецДня(ПараметрыПечати.ДатаСведений);
	Иначе
		ДатаСведений = КонецДня(ОбщегоНазначенияБГУ.РабочаяДатаПользователя());
	КонецЕсли;
	
	ВыводитьВсюИсторию = ?(ПараметрыПечати.Свойство("ВыводитьВсюИсторию"), ПараметрыПечати.ВыводитьВсюИсторию, Ложь);
	
	ДанныеПоОбъектам = ПолучитьДанныеОбъектовПравПользованияНФА(МассивОбъектов, ДатаСведений);
	
	НапечатаноКарточек = Новый ТаблицаЗначений;
	НапечатаноКарточек.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	НапечатаноКарточек.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Для Каждого ОбъектОС Из МассивОбъектов Цикл // Начальная инициализация.
		СтрокаНапечатаноКарточек = НапечатаноКарточек.Добавить();
		СтрокаНапечатаноКарточек.ОсновноеСредство = ОбъектОС;
		СтрокаНапечатаноКарточек.Количество = 0;
	КонецЦикла;
	
	Для Каждого ОбъектПраваПользования Из ДанныеПоОбъектам.ОбъектыПраваПользования Цикл // Цикл по объектам.
		
		СтрокаНапечатаноКарточек = НапечатаноКарточек.Найти(ОбъектПраваПользования.ОсновноеСредство, "ОсновноеСредство");
		Если СтрокаНапечатаноКарточек = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ОбъектПраваПользования.ЕстьСведенияДляФормированияКарточкиПоДоговору Тогда
			Продолжить; // Пропускаем договоры, по которым Карточка 0509214 не ведется (нет данных в регистре СведенияОбОбъектахПравПользованияОС).
		КонецЕсли;
		
		Если Не ВыводитьВсюИсторию
			И ОбъектПраваПользования.ОбъектВыбылВЗаданномПериоде
			И СтрокаНапечатаноКарточек.Количество > 0 Тогда
			// Для выбывших объектов печатаем последнюю Карточку и пропускаем остальные закрытые карточки.
			Продолжить;
		КонецЕсли;
		
		Если НапечатаноКарточек.Количество() > 0 Тогда // Для второго и последующих объектов.
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		Если ОбъектПраваПользования.ОбъектВыбылВЗаданномПериоде И ЗначениеЗаполнено(ОбъектПраваПользования.МаксДатаВыбытия) Тогда
			// Для выбывших объектов балансовая стоимость, амортизация и другие сведения
			// определяются на дату перед последним документом выбытия.
			ДатаСреза = Новый Граница(ОбъектПраваПользования.МаксДатаВыбытия, ВидГраницы.Исключая);
		Иначе
			ДатаСреза = ДатаСведений;
		КонецЕсли;
		
		// Сведения об исполнителе.
		Исполнитель = ?(ПараметрыПечати.Свойство("Исполнитель"), ПараметрыПечати["Исполнитель"], Неопределено);
		СведенияИсполнителя = Новый Структура("Значения,Исполнитель,ТекущийИсполнитель,ДатаСведений",
			Новый Соответствие, Исполнитель, Неопределено, ДатаСведений);
		СведенияИсполнителя = Справочники.ОсновныеСредства.СведенияИсполнителяОрганизации(СведенияИсполнителя, ОбъектПраваПользования.Организация);
		
		ДанныеПоОбъекту = ПолучитьДанныеКарточкиУчетаПраваПользованияНФАПоОбъекту(
			ОбъектПраваПользования.ОсновноеСредство,
			ОбъектПраваПользования.Договор,
			ОбъектПраваПользования.Организация,
			ДатаСреза);
		
		ВывестиШапкуКарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, ДанныеПоОбъекту.ДанныеБУ, ДатаСведений, СведенияИсполнителя);
		ВывестиРаздел1КарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, ДанныеПоОбъекту.ДанныеБУ, ДанныеПоОбъекту.СведенияОбОбъектах);
		ВывестиРаздел2КарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, ДанныеПоОбъекту.ГрафикНачисленияАмортизации, ДатаСведений, ПараметрыПечати);
		ВывестиРаздел3КарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, ДанныеПоОбъекту.ДанныеБУ, ДанныеПоОбъекту.СведенияОбОбъектах);
		ВывестиРаздел41КарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, ДанныеПоОбъекту.СоставОбъектов);
		ВывестиРаздел42КарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, ДанныеПоОбъектам.СведенияОДвиженииОбъектов);
		ВывестиРаздел43КарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, ДанныеПоОбъекту.СведенияОНеотделимыхУлучшениях);
		ВывестиПодвалКарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, ДатаСведений, СведенияИсполнителя);
		
		// Подсчет напечатанных карточек по объектам ОС.
		СтрокаНапечатаноКарточек.Количество = СтрокаНапечатаноКарточек.Количество + 1;
		
		// В табличном документе зададим имя области, в которую был
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ОбъектПраваПользования.ОсновноеСредство);
		
		// информация для сохранения регистра учета из формы печати
		СвойстваРегистраУчета = Новый Структура;
		СвойстваРегистраУчета.Вставить("Организация", ОбъектПраваПользования.Организация);
		СвойстваРегистраУчета.Вставить("НачалоПериода", ДатаСведений);
		СвойстваРегистраУчета.Вставить("КонецПериода", ДатаСведений);
		
		СвойстваРегистраУчета.Вставить("Объект", ОбъектПраваПользования.ОсновноеСредство);
		СвойстваРегистраУчета.Вставить("ФорматНаименования", "%ВидРегистра.Наименование %Объект");
		
		Если НЕ ПараметрыПечати.Свойство("СвойстваРегистровУчета") Тогда
			ПараметрыПечати.Вставить("СвойстваРегистровУчета", Новый Соответствие);
		КонецЕсли;
		
		ПараметрыПечати.СвойстваРегистровУчета.Вставить(ОбъектПраваПользования.ОсновноеСредство, СвойстваРегистраУчета);
		
		// информация для создания внутреннего электронного документа
		СвойстваВнутреннегоЭД = Новый Структура;
		СвойстваВнутреннегоЭД.Вставить("ДатаДокумента", ДатаСведений);
		СвойстваВнутреннегоЭД.Вставить("НомерДокумента", СтрШаблон("%1/%2",
			?(ДанныеПоОбъекту.ДанныеБУ.Свойство("КодОбъектаОС"), ДанныеПоОбъекту.ДанныеБУ.КодОбъектаОС, ""),
			?(ДанныеПоОбъекту.ДанныеБУ.Свойство("КодДоговора"),  ДанныеПоОбъекту.ДанныеБУ.КодДоговора, "")));
		
		ПараметрыПечати.Вставить("СвойстваВнутреннегоЭД", СвойстваВнутреннегоЭД);
		
	КонецЦикла;
	
	Для Каждого СтрокаНапечатаноКарточек Из НапечатаноКарточек Цикл
		
		Если СтрокаНапечатаноКарточек.Количество = 0 Тогда
			
			Если ВыводитьВсюИсторию Тогда
				Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'По объекту ""%1"" отсутствует история ведения Карточек учета прав пользования (ф.0509214).'"),
						СтрокаНапечатаноКарточек.ОсновноеСредство);
			Иначе
				Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'По объекту ""%1"" Карточка учета прав пользования (ф.0509214) не ведется.'"),
						СтрокаНапечатаноКарточек.ОсновноеСредство);
			КонецЕсли;
			
			ОбщегоНазначения.СообщитьПользователю(Текст);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьДанныеОбъектовПравПользованияНФА(МассивОбъектов, ДатаСведений)
	
	ИндексыРезультатов = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Запрос.УстановитьПараметр("СчетаУчетаПравПользования", БухгалтерскийУчет.СписокСчетов("111.40"));
	Запрос.УстановитьПараметр("СчетаАмортизацииПравПользования", БухгалтерскийУчет.СписокСчетов("104.40"));
	Запрос.УстановитьПараметр("СчетаВводаНачальныхОстатков", БухгалтерскийУчет.СписокСчетов("000"));
	Запрос.УстановитьПараметр("СчетаИсправленияОшибокПрошлыхЛет", БухгалтерскийУчет.СписокСчетов("304.66,304.76,304.86,304.96"));
	Запрос.УстановитьПараметр("СчетаПоступленийВыбытий", БухгалтерскийУчет.СписокСчетов("302.20,401.40,401.60"));
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	Запрос.УстановитьПараметр("ВидыСубконтоПраваПользования", ВидыСубконто);
	
	ИндексыРезультатов.Вставить("ВТ_Обороты11140", ИндексыРезультатов.Количество());
	ИндексыРезультатов.Вставить("ВТ_СведенияОДвиженииОбъектов", ИндексыРезультатов.Количество());
	ИндексыРезультатов.Вставить("ВТ_ИтоговыеОбороты11140", ИндексыРезультатов.Количество());
	ИндексыРезультатов.Вставить("ВТ_МаксимальнаяДатаВыбытия", ИндексыРезультатов.Количество());
	ИндексыРезультатов.Вставить("ВТ_СведенияОбОбъектахПравПользованияОС", ИндексыРезультатов.Количество());
	ИндексыРезультатов.Вставить("ВТ_МестаХраненияКонтактнаяИнформация", ИндексыРезультатов.Количество());
	ИндексыРезультатов.Вставить("СведенияОДвиженииОбъектов", ИндексыРезультатов.Количество());
	ИндексыРезультатов.Вставить("ОбъектыПраваПользования", ИндексыРезультатов.Количество());
	
	Если ДатаСведений >= Документы.ПринятиеКУчетуПравПользованияОС.НачалоПримененияФормыСведения0510478() Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДвиженияССубконто.Регистратор КАК Регистратор,
		|	ДвиженияССубконто.Период КАК Период,
		|	ДвиженияССубконто.Организация КАК Организация,
		|	ДвиженияССубконто.СчетДт КАК СчетДт,
		|	ДвиженияССубконто.СчетКт КАК СчетКт,
		|	ВЫБОР
		|		КОГДА ДвиженияССубконто.СчетДт В (&СчетаУчетаПравПользования)
		|			ТОГДА ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоДт1 КАК Справочник.ОсновныеСредства)
		|		ИНАЧЕ ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоКт1 КАК Справочник.ОсновныеСредства)
		|	КОНЕЦ КАК ОсновноеСредство,
		|	ВЫБОР
		|		КОГДА ДвиженияССубконто.СчетДт В (&СчетаУчетаПравПользования)
		|			ТОГДА ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоДт2 КАК Справочник.Договоры)
		|		ИНАЧЕ ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоКт2 КАК Справочник.Договоры)
		|	КОНЕЦ КАК Договор,
		|	ВЫБОР
		|		КОГДА ДвиженияССубконто.СчетДт В (&СчетаУчетаПравПользования)
		|			ТОГДА ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоДт3 КАК Справочник.ЦМО)
		|		ИНАЧЕ ВЫРАЗИТЬ(ДвиженияССубконто.СубконтоКт3 КАК Справочник.ЦМО)
		|	КОНЕЦ КАК ЦМО,
		|	ВЫБОР
		|		КОГДА ДвиженияССубконто.СчетДт В (&СчетаУчетаПравПользования)
		|				И ДвиженияССубконто.СчетКт В (&СчетаУчетаПравПользования)
		|			ТОГДА ""перемещение""
		|		КОГДА ДвиженияССубконто.СчетДт В (&СчетаУчетаПравПользования)
		|			ТОГДА ""поступление""
		|		КОГДА ДвиженияССубконто.СчетКт В (&СчетаУчетаПравПользования)
		|			ТОГДА ""выбытие""
		|		ИНАЧЕ ""прочее""
		|	КОНЕЦ КАК ВидОперации,
		|	ДвиженияССубконто.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
		|	ДвиженияССубконто.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
		|	ДвиженияССубконто.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
		|	ВЫБОР
		|		КОГДА ДвиженияССубконто.СчетДт В (&СчетаУчетаПравПользования)
		|				И ДвиженияССубконто.СчетКт В (&СчетаУчетаПравПользования)
		|			ТОГДА 0
		|		КОГДА ДвиженияССубконто.СчетДт В (&СчетаУчетаПравПользования)
		|			ТОГДА ДвиженияССубконто.Сумма
		|		КОГДА ДвиженияССубконто.СчетКт В (&СчетаУчетаПравПользования)
		|			ТОГДА -1 * ДвиженияССубконто.Сумма
		|		ИНАЧЕ ДвиженияССубконто.Сумма
		|	КОНЕЦ КАК СуммаОборот
		|ПОМЕСТИТЬ ВТ_Обороты11140
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
		|			,
		|			&ДатаСведений,
		|			Счет В (&СчетаУчетаПравПользования)
		|				И Субконто1 В (&МассивОбъектов),
		|			,
		|			) КАК ДвиженияССубконто
		|ГДЕ
		|	НЕ ДвиженияССубконто.Регистратор ССЫЛКА Документ.ЗакрытиеГодаТехнологическое
		|	И НЕ ДвиженияССубконто.Регистратор ССЫЛКА Документ.ЗакрытиеГодаТехнологическоеГрупповое
		|	И НЕ ДвиженияССубконто.Регистратор ССЫЛКА Документ.ЗакрытиеОстатковПоЖурналамСлужебный
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Обороты11140.Период КАК Период,
		|	Обороты11140.Регистратор КАК Регистратор,
		|	Обороты11140.ОсновноеСредство КАК ОсновноеСредство,
		|	Обороты11140.Договор КАК Договор,
		|	Обороты11140.Организация КАК Организация,
		|	Обороты11140.ЦМО КАК ЦМО,
		|	Обороты11140.ВидОперации КАК ВидОперации,
		|	Обороты11140.ЦМО.Сотрудник КАК Сотрудник,
		|	Обороты11140.ЦМО.МестоХранения КАК МестоХранения,
		|	ВЫБОР
		|		КОГДА Обороты11140.ВидОперации = ""выбытие""
		|				И Обороты11140.Регистратор ССЫЛКА Документ.ПрекращениеПравПользованияОС
		|			ТОГДА ВЫРАЗИТЬ(Обороты11140.Регистратор КАК Документ.ПрекращениеПравПользованияОС).ВидОперации
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ПричинаВыбытия,
		|	Обороты11140.ВидПервичногоДокумента КАК ДокументОснованиеВид,
		|	Обороты11140.ДатаПервичногоДокумента КАК ДокументОснованиеДата,
		|	Обороты11140.НомерПервичногоДокумента КАК ДокументОснованиеНомер
		|ПОМЕСТИТЬ ВТ_СведенияОДвиженииОбъектов
		|ИЗ
		|	ВТ_Обороты11140 КАК Обороты11140";
		
	Иначе // Устаревший вариант (до 01.01.2026).
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Обороты11140.Регистратор КАК Регистратор,
		|	Обороты11140.Период КАК Период,
		|	Обороты11140.Организация КАК Организация,
		|	ВЫРАЗИТЬ(Обороты11140.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
		|	ВЫРАЗИТЬ(Обороты11140.Субконто2 КАК Справочник.Договоры) КАК Договор,
		|	ВЫРАЗИТЬ(Обороты11140.Субконто3 КАК Справочник.ЦМО) КАК ЦМО,
		|	Обороты11140.Счет КАК Счет,
		|	Обороты11140.КорСчет КАК КорСчет,
		|	Обороты11140.СуммаОборот КАК СуммаОборот,
		|	Обороты11140.СуммаОборотДт КАК СуммаОборотДт,
		|	Обороты11140.СуммаОборотКт КАК СуммаОборотКт,
		|	ВЫБОР
		|		КОГДА Обороты11140.КорСчет В (&СчетаУчетаПравПользования)
		|				И Обороты11140.СуммаОборот > 0
		|			ТОГДА ""перемещение""
