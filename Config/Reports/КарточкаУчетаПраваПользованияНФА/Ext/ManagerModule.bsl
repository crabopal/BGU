Функция ОписаниеПериодаГрафикаАмортизации(Период, ТипПериода, ДатаНачалаАмортизации, ДатаОкончанияАмортизации, ДатаСведений, Раздел)
	
	ОписаниеПериода = "";
	
	Если ТипПериода = "ЗаПредыдущиеГоды" Тогда
		
		Если НачалоГода(ДатаНачалаАмортизации) = НачалоГода(ДобавитьМесяц(НачалоГода(ДатаСведений), -1)) Тогда
			ОписаниеПериода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"),
				Формат(НачалоГода(ДатаНачалаАмортизации), "ДФ=""гггг"""));
		Иначе
			ОписаниеПериода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 - %2'"),
				Формат(НачалоГода(ДатаНачалаАмортизации), "ДФ=""гггг"""),
				Формат(НачалоГода(ДатаСведений)-1, "ДФ=""гггг"""));
		КонецЕсли;
		
	ИначеЕсли ТипПериода = "ЗаТекущийГод" Тогда
		
		ОписаниеПериода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"),
			Формат(Период, ?(Раздел = "ТАБЛИЦА", "ДФ=""ММ.гггг""", "ДФ=""гггг""")));
		
	ИначеЕсли ТипПериода = "НаПоследующие3Года"  Тогда
		
		ОписаниеПериода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"),
			Формат(Период, "ДФ=""гггг"""));
		
	ИначеЕсли ТипПериода = "НаПоследующиеГоды"  Тогда
		
		Если КонецГода(ДатаОкончанияАмортизации) = КонецГода(ДобавитьМесяц(КонецГода(ДатаСведений) + 1, 3*12)) Тогда
			ОписаниеПериода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"),
				Формат(КонецГода(ДатаОкончанияАмортизации), "ДФ=""гггг"""));
		Иначе
			ОписаниеПериода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 - %2'"),
				Формат(ДобавитьМесяц(КонецГода(ДатаСведений) + 1, 3*12), "ДФ=""гггг"""),
				Формат(КонецГода(ДатаОкончанияАмортизации), "ДФ=""гггг"""));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОписаниеПериода;
	
КонецФункции

Функция ОпределитьКурсПересчетаПоДаннымОРезервах(СтрокаКарточки, РезервыПоДоговорам)
	
	Отбор = Новый Структура("Организация, Договор");
	ЗаполнитьЗначенияСвойств(Отбор, СтрокаКарточки);
	НайденнаяСтрокаРезервов = РезервыПоДоговорам.НайтиСтроки(Отбор);
	
	Если НайденнаяСтрокаРезервов.Количество() > 0 Тогда
		Возврат НайденнаяСтрокаРезервов[0].КоэффициентПересчетаВРубли;
	Иначе
		Возврат 1;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецЕсли