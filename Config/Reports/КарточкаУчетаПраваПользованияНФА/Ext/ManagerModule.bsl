Процедура ВывестиРаздел42КарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, СведенияОДвиженииОбъектов)
	
	ОбластьРаздел42Шапка = Макет.ПолучитьОбласть("Раздел42Шапка");
	ОбластьРаздел42Строка = Макет.ПолучитьОбласть("Раздел42Строка");
	ОбластьРаздел42Итоги = Макет.ПолучитьОбласть("Раздел42Итоги");
	
	ТабДокумент.Вывести(ОбластьРаздел42Шапка);
	
	Отбор = Новый Структура("Организация,Договор,ОсновноеСредство");
	ЗаполнитьЗначенияСвойств(Отбор, ОбъектПраваПользования);
	
	КодСтроки = 1;
	СведенияОДвиженииОбъекта = СведенияОДвиженииОбъектов.НайтиСтроки(Отбор);
	Для Каждого СтрокаДвижениеОбъекта Из СведенияОДвиженииОбъекта Цикл
		
		ОбластьРаздел42Строка.Параметры.Заполнить(СтрокаДвижениеОбъекта);
		ОбластьРаздел42Строка.Параметры.КодСтроки = КодСтроки;
		
		Если СтрокаДвижениеОбъекта.ВидОперации = "поступление" Тогда
			ОбластьРаздел42Строка.Параметры.ВидОперации = НСтр("ru = 'поступление'");
		ИначеЕсли СтрокаДвижениеОбъекта.ВидОперации = "перемещение" Тогда
			ОбластьРаздел42Строка.Параметры.ВидОперации = НСтр("ru = 'внутреннее перемещение'");
		ИначеЕсли СтрокаДвижениеОбъекта.ВидОперации = "выбытие" Тогда
			ОбластьРаздел42Строка.Параметры.ВидОперации = НСтр("ru = 'выбытие'");
		Иначе
			ОбластьРаздел42Строка.Параметры.ВидОперации = "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДвижениеОбъекта.АдресМестаХранения) Тогда
			МестонахождениеОбъекта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1, %2'"), СтрокаДвижениеОбъекта.МестоХранения, СтрокаДвижениеОбъекта.АдресМестаХранения);
		Иначе
			МестонахождениеОбъекта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1'"), СтрокаДвижениеОбъекта.МестоХранения);
		КонецЕсли;
		ОбластьРаздел42Строка.Параметры.МестонахождениеОбъекта = МестонахождениеОбъекта;
		
		Если ЗначениеЗаполнено(СтрокаДвижениеОбъекта.Сотрудник) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект,Период,Фамилия,Имя,Отчество,Должность,ДолжностьНаименование", СтрокаДвижениеОбъекта.Сотрудник, СтрокаДвижениеОбъекта.Период);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
			ОтветственноеЛицоФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь, , Ложь);
			ОбластьРаздел42Строка.Параметры.ОтветственноеЛицо = ?(ЗначениеЗаполнено(ДанныеСотрудника.ДолжностьНаименование),
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, %2'"), ОтветственноеЛицоФИО, ДанныеСотрудника.ДолжностьНаименование),
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"), ОтветственноеЛицоФИО));
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьРаздел42Строка);
		
		КодСтроки = КодСтроки + 1;
		
	КонецЦикла;
	
	ТабДокумент.Вывести(ОбластьРаздел42Итоги);
	
КонецПроцедуры

Процедура ВывестиРаздел43КарточкиУчетаПраваПользованияНФА(Макет, ТабДокумент, ОбъектПраваПользования, СведенияОНеотделимыхУлучшениях)
	
