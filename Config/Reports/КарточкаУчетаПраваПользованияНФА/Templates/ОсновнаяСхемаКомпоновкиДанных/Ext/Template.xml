	Обороты11140.Организация КАК Организация,
	ВЫРАЗИТЬ(Обороты11140.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	ВЫРАЗИТЬ(Обороты11140.Субконто2 КАК Справочник.Договоры) КАК Договор,
	ВЫРАЗИТЬ(Обороты11140.Субконто3 КАК Справочник.ЦМО) КАК ЦМО,
	Обороты11140.Счет КАК Счет,
	Обороты11140.КФО КАК КФО,
	Обороты11140.КПС КАК КПС,
	Обороты11140.СуммаОборот КАК СуммаОборот,
	Обороты11140.СуммаОборотДт КАК СуммаОборотДт,
	Обороты11140.СуммаОборотКт КАК СуммаОборотКт
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(, &amp;ДатаСведений, , Счет В (&amp;СчетаУчетаПравПользования), , {(Организация = &amp;Организация), (Субконто1 В (&amp;ОбъектыПравПользования))}, , ) КАК Обороты11140
{ГДЕ
	(ВЫРАЗИТЬ(Обороты11140.Субконто1 КАК Справочник.ОсновныеСредства)).* КАК ОсновноеСредство,
	(ВЫРАЗИТЬ(Обороты11140.Субконто2 КАК Справочник.Договоры)).* КАК Договор,
	(ВЫРАЗИТЬ(Обороты11140.Субконто3 КАК Справочник.ЦМО)).* КАК ЦМО,
	Обороты11140.Счет.*,
	Обороты11140.ИФО.*,
	Обороты11140.КФО.*,
	Обороты11140.КПС.*}</query>
