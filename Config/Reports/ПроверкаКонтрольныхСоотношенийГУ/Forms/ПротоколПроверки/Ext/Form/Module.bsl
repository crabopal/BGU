////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ПустаяСтрока(Параметры.АдресДанныхПротокола) Тогда
		ДанныеПротокола = ПолучитьИзВременногоХранилища(Параметры.АдресДанныхПротокола);
		
		ДанныеПротокола.Свойство("ОбъектИсточник",ОбъектИсточник);
		
		ВыводСтраницыСводно = Ложь;
		
		Если ДанныеПротокола.Свойство("ДанныеОтобранныхОтчетов") И ДанныеПротокола.ДанныеОтобранныхОтчетов.Количество()>1 Тогда
			
			ВыводСтраницыСводно = Истина;
			
			МакетРезультатПроверки = Отчеты.ПроверкаКонтрольныхСоотношенийГУ.ПолучитьМакетРезультатПроверки();
			ОбластьЗаголовок = МакетРезультатПроверки.ПолучитьОбласть("Заголовок");
			ОбластьОбщиеИтоги = МакетРезультатПроверки.ПолучитьОбласть("ОбщиеИтоги");
			ОбластьСтрокаПоОтчету = МакетРезультатПроверки.ПолучитьОбласть("СтрокаПоОтчету");
			
			ПротоколСводно.Вывести(ОбластьЗаголовок);
			
			ДанныеОтобранныхОтчетов = ПоместитьВоВременноеХранилище(ДанныеПротокола.ДанныеОтобранныхОтчетов,УникальныйИдентификатор);	

			
			НомСтр = 1;
			Для Каждого СтрокаОтчета Из ДанныеПротокола.ДанныеОтобранныхОтчетов Цикл
				
				ОбластьСтрокаПоОтчету.Параметры.НомСтр			= НомСтр;
				ОбластьСтрокаПоОтчету.Параметры.Период			= СтрокаОтчета.ОтчетныйПериод;
				ОбластьСтрокаПоОтчету.Параметры.ИФО				= СтрокаОтчета.ИФО;
				ОбластьСтрокаПоОтчету.Параметры.ВидОтчета		= СокрЛП(СтрокаОтчета.ВидОтчета);
				ОбластьСтрокаПоОтчету.Параметры.ОписаниеАналитики = СтрокаОтчета.ОписаниеАналитики;
				ОбластьСтрокаПоОтчету.Параметры.Организация		= СтрокаОтчета.Организация;
	            ОбластьСтрокаПоОтчету.Параметры.ИНН				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОтчета.Организация,"ИНН");
				ОбластьСтрокаПоОтчету.Параметры.Ошибок			= СтрокаОтчета.ВсегоОшибок;	
				ОбластьСтрокаПоОтчету.Параметры.Предупреждений	= СтрокаОтчета.ВсегоПредупреждений;
				ОбластьСтрокаПоОтчету.Параметры.РасшифровкаОтчетСсылка = СтрокаОтчета.Ссылка;
				
				ПротоколСводно.Вывести(ОбластьСтрокаПоОтчету);
				
				НомСтр = НомСтр + 1;
				
			КонецЦикла;	
			
			ОбластьОбщиеИтоги.Параметры.ИтогоОшибок = ДанныеПротокола.ДанныеОтобранныхОтчетов.Итог("ВсегоОшибок");
			ОбластьОбщиеИтоги.Параметры.ИтогоПредупреждений = ДанныеПротокола.ДанныеОтобранныхОтчетов.Итог("ВсегоПредупреждений");
			ОбластьОбщиеИтоги.Параметры.ДатаФормирования = ТекущаяДатаСеанса();
			
			ПротоколСводно.Вывести(ОбластьОбщиеИтоги);
			
		КонецЕсли;
		
		Элементы.СтраницаСводно.Видимость = ВыводСтраницыСводно;
		Элементы.ВывестиПолныйПротокол.Видимость = ВыводСтраницыСводно;
		Элементы.ГруппаТаблицы.ОтображениеСтраниц = ?(ВыводСтраницыСводно, ОтображениеСтраницФормы.ЗакладкиСверху, ОтображениеСтраницФормы.Нет);
				
		ДанныеПолногоПротокола = ПоместитьВоВременноеХранилище(ДанныеПротокола.ТабличныйДокумент,УникальныйИдентификатор);
		АдресДанныхРасшифровки = ПоместитьВоВременноеХранилище(ДанныеПротокола.ДанныеРасшифровки,УникальныйИдентификатор);
		
		ТабличныйДокументПротокола.Вывести(ДанныеПротокола.ТабличныйДокумент);
		ВыводПолногоПротокола = Истина;
		Элементы.ВывестиПолныйПротокол.Видимость = НЕ ВыводПолногоПротокола;
		Элементы.СтраницаПодробно.Заголовок = НСтр("ru='Протокол по всем отчетам'");
		
	Иначе
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаОтчетыСравнения.Видимость	= Ложь;
	Элементы.ПоказатьИсходныеОтчеты.Пометка		= Ложь;
	Элементы.ГруппаОтчетЛевый.Видимость			= Ложь;
	Элементы.ГруппаОтчетПравый.Видимость		= Ложь;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура ТабличныйДокументПротоколаОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(Расшифровка) = Тип("Число") Тогда
		ТекущаяОбласть = Элемент.ТекущаяОбласть;
		
		ТекущаяЯчейкаВерх = ТекущаяОбласть.Верх;
		ТекущаяЯчейкаЛево = ТекущаяОбласть.Лево;
		ТекущаяЯчейкаПраво = ТекущаяОбласть.Право;
		
		КолонкаТекста = ?(ТекущаяЯчейкаЛево = 7, ТекущаяЯчейкаПраво+1, ТекущаяЯчейкаЛево-1); 
			
		ТекстПоказатель = ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерх, КолонкаТекста).Текст;
		ТекстЗаголовкаРасшифровки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
    						НСтр("ru='Текущий показатель: %1'"), СокрЛП(ТекстПоказатель));
							
		//Из-за смены цвета области происходит сдвиг таблицы расшифровки. Нужно вернуть его в корректное положение.
		Элементы.ТабличныйДокументПротокола.ТекущаяОбласть = ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерх,1);
		
		РасшифроватьЗначение(Расшифровка, ТекстЗаголовкаРасшифровки, Элемент.Имя, ТекущаяЯчейкаВерх,ТекущаяЯчейкаЛево);
		
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("СправочникСсылка.КонтрольныеСоотношения")
		ИЛИ ТипЗнч(Расшифровка) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") Тогда
		ПоказатьЗначение(,Расшифровка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетСравненияОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(Расшифровка) = Тип("Число") Тогда
		
		ЭтоПравыйПоказательОтчетСравнения = Элемент.Имя = "ОтчетСписокПравый";		
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимРасшифровки"	,Истина);
		ПараметрыФормы.Вставить("ОткрытьБланк",Истина);
		
		ПараметрыФормы.Вставить("ДанныеРасшифровки" ,Новый Структура("Идентификатор,АдресХранилища",Расшифровка,АдресДанныхОтчетСравнения));
		
		ФормаРегламентированныйОтчет = ПолучитьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаДокумента",ПараметрыФормы,ЭтаФорма);
	
		Если НЕ ФормаРегламентированныйОтчет = Неопределено Тогда
			
			ОтчетСсылка = ФормаРегламентированныйОтчет.Объект.Ссылка;
			
			ТабличныйДокументСравнения = ФормаРегламентированныйОтчет.ТабличныйДокументОтчета;
			ТекущаяОбластьСравнения = ФормаРегламентированныйОтчет.Элементы.ТабличныйДокументОтчета.ТекущаяОбласть;
			
			ПараметрыОбласти = Новый Структура();
			ПараметрыОбласти.Вставить("ОтчетСсылка", ОтчетСсылка);
			ПараметрыОбласти.Вставить("ТекущаяОбластьВерх",ТекущаяОбластьСравнения.Верх);
			ПараметрыОбласти.Вставить("ТекущаяОбластьЛево",ТекущаяОбластьСравнения.Лево);
			ПараметрыОбласти.Вставить("ЭлементИсточник", Элемент.Имя);
			
			Если Элемент.Имя = "ОтчетСравненияПравый" Тогда
				ПараметрыОбласти.Вставить("ЗаголовокРасшифровки", Элементы.ОтчетПравыйОписание.Заголовок);
			Иначе
				ПараметрыОбласти.Вставить("ЗаголовокРасшифровки", Элементы.ОтчетЛевыйОписание.Заголовок);
			КонецЕсли;	
						
			ВывестиОтчетСравнения(ИсходнаяРасшифровкаДляСписка, ТабличныйДокументСравнения, ПараметрыОбласти, Истина);
			ФормаРегламентированныйОтчет = Неопределено;
		Иначе
			ПоказатьПредупреждение(,НСтр("ru = 'Экземпляр отчета с данным показателем не найден.'"), 10);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетСписокЛевыйОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	ОтчетСравненияОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ОтчетСписокПравыйОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	ОтчетСравненияОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ОтчетСравненияЛевыйПриАктивизацииОбласти(Элемент)
	ПараметрыАвтосуммы = ПолучитьАвтосуммуПоказателей(ОтчетСравненияЛевый);
	АвтоСуммаЛевый = Формат(ПараметрыАвтосуммы.СуммаЗначений,ПараметрыАвтосуммы.ФорматОбласти);
КонецПроцедуры

&НаКлиенте
Процедура ОтчетСравненияПравыйПриАктивизацииОбласти(Элемент)
	ПараметрыАвтосуммы = ПолучитьАвтосуммуПоказателей(ОтчетСравненияПравый);
	АвтоСуммаПравый = Формат(ПараметрыАвтосуммы.СуммаЗначений,ПараметрыАвтосуммы.ФорматОбласти);
КонецПроцедуры

&НаКлиенте
Процедура ПротоколСводноОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;
	
	ВыводПолногоПротокола = Ложь;
	ВывестиПротоколПоОтчетуНаСервере(Расшифровка);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиПротоколПоОтчетуНаСервере(ОтчетСсылка)
	
	Элементы.ВывестиПолныйПротокол.Видимость = НЕ ВыводПолногоПротокола;
	
	Если ЭтоАдресВременногоХранилища(ДанныеОтобранныхОтчетов) Тогда
		ДанныеОтчетовТаблица = ПолучитьИзВременногоХранилища(ДанныеОтобранныхОтчетов);
		СтрокаПоОтчету = ДанныеОтчетовТаблица.Найти(ОтчетСсылка,"Ссылка");
		Если СтрокаПоОтчету <> Неопределено Тогда
			ТабличныйДокументПротокола.Очистить();
			ТабличныйДокументПротокола.Вывести(СтрокаПоОтчету.ПротоколПроверки.ТабличныйДокумент);
			Элементы.ТабличныйДокументПротокола.ТекущаяОбласть = ТабличныйДокументПротокола.Область("R1C1");
			Элементы.ГруппаТаблицы.ТекущаяСтраница = Элементы.СтраницаПодробно;
			
			Элементы.ВывестиПолныйПротокол.Видимость = НЕ ВыводПолногоПротокола;
			ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
    						НСтр("ru='Протокол по отчету №%1'"), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетСсылка,"Номер"));
			Элементы.СтраницаПодробно.Заголовок = ТекстЗаголовка;
			
		КонецЕсли;
	Иначе
		ВывестиПолныйПротоколНаСервере();
	КонецЕсли;
		
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ПоказатьИсходныеОтчеты(Команда)
	УстановитьВидимостьИсходныхОтчетов(Истина, НЕ Элементы.ПоказатьИсходныеОтчеты.Пометка);
КонецПроцедуры

&НаКлиенте
Процедура ВернутьсяКПротоколу(Команда)
	
	Элементы.ТабличныйДокументПротокола.ТекущаяОбласть = ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхЛевая,ТекущаяЯчейкаЛевоЛевая);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетЛевый(Команда)
	ПараметрыФормы = Новый Структура("Ключ", ОтчетЛевыйСсылка);
	ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.ФормаОбъекта", ПараметрыФормы);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетПравый(Команда)
	ПараметрыФормы = Новый Структура("Ключ", ОтчетПравыйСсылка);
	ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.ФормаОбъекта", ПараметрыФормы);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетExcelЛевый(Команда)
	СохранитьОтчетExcelНаСервере("ОтчетСравненияЛевый");
	ВывестиФайлExcel();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетExcelПравый(Команда)
	СохранитьОтчетExcelНаСервере("ОтчетСравненияПравый");
	ВывестиФайлExcel();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПротоколExcel(Команда)
	
	Если Элементы.ГруппаТаблицы.ТекущаяСтраница = Элементы.СтраницаПодробно Тогда
		СохранитьОтчетExcelНаСервере("ТабличныйДокументПротокола");
	Иначе
		СохранитьОтчетExcelНаСервере("ПротоколСводно");
	КонецЕсли;	
		
	ВывестиФайлExcel();
	
КонецПроцедуры

&НаКлиенте
Процедура СледующееОтклонение(Команда)
	ПерейтиКОшибкеСписка(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПредыдушееОтклонение(Команда)
	ПерейтиКОшибкеСписка(Ложь)
КонецПроцедуры

&НаКлиенте
Процедура ВывестиПолныйПротокол(Команда)
	
	ВыводПолногоПротокола = Истина;
	ВывестиПолныйПротоколНаСервере();
	УстановитьВидимостьИсходныхОтчетов(Ложь, Истина);
	Элементы.ВывестиПолныйПротокол.Видимость = НЕ ВыводПолногоПротокола;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиПолныйПротоколНаСервере()
	
	ТабличныйДокументПротокола.Очистить();
	ТабличныйДокументПротокола.Вывести(ПолучитьИзВременногоХранилища(ДанныеПолногоПротокола));
	Элементы.ТабличныйДокументПротокола.ТекущаяОбласть = ТабличныйДокументПротокола.Область("R1C1");
	Элементы.ГруппаТаблицы.ТекущаяСтраница = Элементы.СтраницаПодробно;
	
	Элементы.ВывестиПолныйПротокол.Видимость = НЕ ВыводПолногоПротокола;
	Элементы.СтраницаПодробно.Заголовок = НСтр("ru='Протокол по всем отчетам'");
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура РасшифроватьЗначение(ЗначениеРасшифровки, ЗаголовокРасшифровки, ЭлементИсточник,ТекущаяЯчейкаВерх,ТекущаяЯчейкаЛево)
	
	Если ЭтоРасшифровкаСтрокиСообщения(Новый Структура("Идентификатор,АдресХранилища",ЗначениеРасшифровки,АдресДанныхРасшифровки),ЗаголовокРасшифровки,ТекущаяЯчейкаВерх,ТекущаяЯчейкаЛево) Тогда 
		УстановитьВидимостьИсходныхОтчетов(Истина, Истина);
		Возврат;
	КонецЕсли;
	
	АдресДанныхРасшифровкиФормы = Неопределено;
	
	ЭтоПравыйПоказательОтчетСравнения = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимРасшифровки"	,Истина);
	ПараметрыФормы.Вставить("ДанныеРасшифровки" ,Новый Структура("Идентификатор,АдресХранилища",ЗначениеРасшифровки,АдресДанныхРасшифровки));
	ПараметрыФормы.Вставить("ОткрытьБланк",Истина);
		
	Если ЗначениеЗаполнено(ОбъектИсточник) Тогда
		ПараметрыФормы.ДанныеРасшифровки.Вставить("ОбъектИсточник",ОбъектИсточник);
	КонецЕсли;
	
	ФормаРегламентированныйОтчет = ПолучитьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаДокумента",ПараметрыФормы,ЭтаФорма);
	ВидимостьКнопок = Истина;
	
	Если НЕ ФормаРегламентированныйОтчет = Неопределено Тогда
		
		ОтчетСсылка = ФормаРегламентированныйОтчет.Объект.Ссылка;
		
		ПараметрыОбласти = Новый Структура();
		ПараметрыОбласти.Вставить("ТекущаяОбластьВерх",1);
		ПараметрыОбласти.Вставить("ТекущаяОбластьЛево",1);
		ПараметрыОбласти.Вставить("ОтчетСсылка", ОтчетСсылка);
		ПараметрыОбласти.Вставить("ЗаголовокРасшифровки", ЗаголовокРасшифровки);
		ПараметрыОбласти.Вставить("ЭлементИсточник", ЭлементИсточник);
		
		МножественнаяРасшифровка = Ложь;
			
		Если НЕ ОтчетСсылка.Пустая() Тогда
			ТабличныйДокументСравнения = ФормаРегламентированныйОтчет.ТабличныйДокументОтчета;
			ТекущаяОбластьСравнения = ФормаРегламентированныйОтчет.Элементы.ТабличныйДокументОтчета.ТекущаяОбласть;
			ПараметрыОбласти.Вставить("ТекущаяОбластьВерх",ТекущаяОбластьСравнения.Верх);
			ПараметрыОбласти.Вставить("ТекущаяОбластьЛево",ТекущаяОбластьСравнения.Лево);
			
		Иначе
			// Расшифровка показателя, состоящего из нескольких отчетов.
			МножественнаяРасшифровка = Истина;
			ИсходнаяРасшифровкаДляСписка = ЗначениеРасшифровки;
			ПараметрыФормыРасшифровки = ФормаРегламентированныйОтчет.ДанныеДляОтображенияРасшифровки.РасшифровкаПоказателей;
			ФормаРасшифровки = ПолучитьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.РасшифровкаПоказателей",ПараметрыФормыРасшифровки,ЭтаФорма);
			ТабличныйДокументСравнения = ФормаРасшифровки.ТабличныйДокументРасшифровки;
			
			АдресДанныхРасшифровкиФормы = ФормаРасшифровки.АдресДанныхРасшифровки;
			
		КонецЕсли;
		
		ВывестиОтчетСравнения(ЗначениеРасшифровки, ТабличныйДокументСравнения, ПараметрыОбласти, МножественнаяРасшифровка,ТекущаяЯчейкаВерх,ТекущаяЯчейкаЛево,АдресДанныхРасшифровкиФормы);
		ФормаРегламентированныйОтчет = Неопределено;
		ФормаРасшифровки = Неопределено;

	Иначе
		ПоказатьПредупреждение(,НСтр("ru = 'Экземпляр отчета с данным показателем не найден.'"), 10);
		ОтчетЛевыйСсылка = Неопределено;
		ОтчетПравыйСсылка = Неопределено;
		ВидимостьКнопок = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьИсходныхОтчетов(ВидимостьКнопок, Истина);
	
КонецПроцедуры // РасшифроватьЗначение()

&НаСервере
Процедура ВывестиОтчетСравнения(Знач ЗначениеРасшифровки,Знач ТабличныйДокументСравнения,Знач ПараметрыОбласти,Знач МножественнаяРасшифровка,Знач ТекущаяЯчейкаВерх=Неопределено,Знач ТекущаяЯчейкаЛево=Неопределено,Знач АдресДанныхРасшифровкиФормы=Неопределено)
	
 	ЗначениеТекущейРасшифровки = ПолучитьИзВременногоХранилища(АдресДанныхРасшифровки)[ЗначениеРасшифровки];
	ЭтоМежформенноеСоотношение = Ложь;
	
	Если ЭтоАдресВременногоХранилища(АдресДанныхРасшифровкиФормы) Тогда
		ДанныеФормыРасшифровки = ПолучитьИзВременногоХранилища(АдресДанныхРасшифровкиФормы);
		АдресДанныхОтчетСравнения = ПоместитьВоВременноеХранилище(ДанныеФормыРасшифровки,УникальныйИдентификатор);	
	КонецЕсли;
	
	Если ЗначениеТекущейРасшифровки.Свойство("Операнд") Тогда
		РежимРасшифровки = "Операнд";
	Иначе
		РежимРасшифровки = "Показатель";
	КонецЕсли;
	
	Сбросить = Ложь;
	Если РежимРасшифровки = "Операнд" Тогда
	
		Операнд = ЗначениеТекущейРасшифровки.Операнд;
		Если ТипЗнч(Операнд) = Тип("СправочникСсылка.ОперандыПоказателей") Тогда
		
			ТекущееКС = Операнд.Владелец;
			Если НЕ РанееПросмотреноКС = ТекущееКС Тогда
				Сбросить = Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Сбросить = Истина;
		ТекущееКС = Неопределено;
	КонецЕсли;
	
	Если Сбросить Тогда		
		ОтчетСравненияЛевый.Очистить();
		ОтчетСравненияПравый.Очистить();
		ОтчетСписокЛевый.Очистить();
		ОтчетСписокПравый.Очистить();
		
		// Устанавливаем стандартный цвет для предыдущей активной ячейки расшифровки и выделяем новую.
		Если ЗначениеЗаполнено(ТекущаяЯчейкаВерхЛевая) Тогда
			ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхЛевая,ТекущаяЯчейкаЛевоЛевая).ЦветФона = Новый Цвет(245, 245, 220);
			ТекущаяЯчейкаВерхЛевая = 0;
			ТекущаяЯчейкаЛевоЛевая = 0;
		КонецЕсли;	
		Если ЗначениеЗаполнено(ТекущаяЯчейкаВерхПравая) Тогда
			ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхПравая,ТекущаяЯчейкаЛевоПравая).ЦветФона = Новый Цвет(245, 245, 220);
			ТекущаяЯчейкаВерхПравая = 0;
			ТекущаяЯчейкаЛевоПравая = 0;
		КонецЕсли;
		
		ПустаяСсылка = Документы.УниверсальныйРегламентированныйОтчет.ПустаяСсылка();
		ОтчетПравыйСсылка	= ПустаяСсылка;
		ОтчетЛевыйСсылка	= ПустаяСсылка;
		
		ТекстЗаголовкаГруппыСравнения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Расшифровка КС: %1'"), Строка(ТекущееКС));
		Элементы.ЗаголовокОтчетовСравнения.Заголовок = ТекстЗаголовкаГруппыСравнения;
		
	КонецЕсли;	
	РанееПросмотреноКС = ТекущееКС;
	
	Если РежимРасшифровки = "Операнд" Тогда	
		Если ТипЗнч(ТекущееКС) = Тип("СправочникСсылка.КонтрольныеСоотношения") Тогда
			ЭтоМежформенноеСоотношение = НЕ ТекущееКС.ПоказателиТекущегоОтчета;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если РежимРасшифровки = "Операнд" Тогда
		Если (ЭтоМежформенноеСоотношение И ЗначениеТекущейРасшифровки.ЭтоПравыйПоказатель) ИЛИ ЭтоПравыйПоказательОтчетСравнения Тогда
			ОтчетСравненияПравый.Очистить();
			ОтчетПравыйСсылка = ПараметрыОбласти.ОтчетСсылка;
			
			//Перекрасим старые покрашенные ячейки в обычный цвет и покрасим новые
			Если ЗначениеЗаполнено(ТекущаяЯчейкаВерх) Тогда
				Если ЗначениеЗаполнено(ТекущаяЯчейкаВерхПравая) Тогда
					ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхПравая,ТекущаяЯчейкаЛевоПравая).ЦветФона = Новый Цвет(245, 245, 220);
				КонецЕсли;
				ТекущаяЯчейкаВерхПравая = ТекущаяЯчейкаВерх;
				ТекущаяЯчейкаЛевоПравая = ТекущаяЯчейкаЛево;
				ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхПравая,ТекущаяЯчейкаЛевоПравая).ЦветФона =  WebЦвета.Розовый;
				
			КонецЕсли;
			
			Если МножественнаяРасшифровка Тогда
				Если ПараметрыОбласти.ЭлементИсточник = "ТабличныйДокументПротокола" Тогда
					// Расшифровка из протокола. Отображается список.
					ОтчетСписокПравый.Очистить();
					ОтчетСписокПравый.Вывести(ТабличныйДокументСравнения);
					Элементы.СтраницыОтчетПравый.ТекущаяСтраница = Элементы.СтраницаПравыйСписок;
					Элементы.СтраницаПравыйРасшифровка.Видимость = Ложь;
				Иначе
					ОтчетСравненияПравый.Вывести(ТабличныйДокументСравнения);
					Элементы.СтраницыОтчетПравый.ТекущаяСтраница = Элементы.СтраницаПравыйРасшифровка;
					Элементы.СтраницаПравыйРасшифровка.Видимость = Истина;
				КонецЕсли;
				Элементы.СтраницыОтчетПравый.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
			Иначе	
				ОтчетСравненияПравый.Вывести(ТабличныйДокументСравнения);
				Элементы.СтраницыОтчетПравый.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
				Элементы.СтраницыОтчетПравый.ТекущаяСтраница = Элементы.СтраницаПравыйРасшифровка;
				Элементы.СтраницаПравыйРасшифровка.Видимость = Истина;
			КонецЕсли;
			
			Элементы.ОтчетСравненияПравый.ТекущаяОбласть = ТабличныйДокументСравнения.Область(ПараметрыОбласти.ТекущаяОбластьВерх,ПараметрыОбласти.ТекущаяОбластьЛево);
			Элементы.ОтчетПравыйОписание.Заголовок = ПараметрыОбласти.ЗаголовокРасшифровки;
			
		Иначе
			ОтчетСравненияЛевый.Очистить();
			ОтчетЛевыйСсылка = ПараметрыОбласти.ОтчетСсылка;
			
			//Перекрасим старые покрашенные ячейки в обычный цвет и покрасим новые
			Если ЗначениеЗаполнено(ТекущаяЯчейкаВерх) Тогда
				Если ЗначениеЗаполнено(ТекущаяЯчейкаВерхЛевая) Тогда
					ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхЛевая,ТекущаяЯчейкаЛевоЛевая).ЦветФона = Новый Цвет(245, 245, 220);
				КонецЕсли;
				ТекущаяЯчейкаВерхЛевая = ТекущаяЯчейкаВерх;
				ТекущаяЯчейкаЛевоЛевая = ТекущаяЯчейкаЛево;
				ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхЛевая,ТекущаяЯчейкаЛевоЛевая).ЦветФона =  WebЦвета.Розовый;
			КонецЕсли;	
			
			Если МножественнаяРасшифровка Тогда
				Если ПараметрыОбласти.ЭлементИсточник = "ТабличныйДокументПротокола" Тогда
					// Расшифровка из протокола. Отображается список.
					ОтчетСписокЛевый.Очистить();
					ОтчетСписокЛевый.Вывести(ТабличныйДокументСравнения);
					Элементы.СтраницыОтчетЛевый.ТекущаяСтраница = Элементы.СтраницаЛевыйСписок;
					Элементы.СтраницаЛевыйРасшифровка.Видимость = Ложь;
				Иначе
					ОтчетСравненияЛевый.Вывести(ТабличныйДокументСравнения);
					Элементы.СтраницыОтчетЛевый.ТекущаяСтраница = Элементы.СтраницаЛевыйРасшифровка;
					Элементы.СтраницаЛевыйРасшифровка.Видимость = Истина;
				КонецЕсли;
				Элементы.СтраницыОтчетЛевый.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
			Иначе	
				ОтчетСравненияЛевый.Вывести(ТабличныйДокументСравнения);
				Элементы.СтраницыОтчетЛевый.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
				Элементы.СтраницыОтчетЛевый.ТекущаяСтраница = Элементы.СтраницаЛевыйРасшифровка;
				Элементы.СтраницаЛевыйРасшифровка.Видимость = Истина;
			КонецЕсли;
				
			Элементы.ОтчетСравненияЛевый.ТекущаяОбласть = ТабличныйДокументСравнения.Область(ПараметрыОбласти.ТекущаяОбластьВерх,ПараметрыОбласти.ТекущаяОбластьЛево);
			Элементы.ОтчетЛевыйОписание.Заголовок = ПараметрыОбласти.ЗаголовокРасшифровки;
			
		КонецЕсли;
	Иначе
		ОтчетСравненияЛевый.Очистить();
		ОтчетЛевыйСсылка = ПараметрыОбласти.ОтчетСсылка;
		
		//Перекрасим старые покрашенные ячейки в обычный цвет и покрасим новые
		Если ЗначениеЗаполнено(ТекущаяЯчейкаВерх) Тогда
			Если ЗначениеЗаполнено(ТекущаяЯчейкаВерхЛевая) Тогда
				ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхЛевая,ТекущаяЯчейкаЛевоЛевая).ЦветФона = Новый Цвет(245, 245, 220);
			КонецЕсли;
			ТекущаяЯчейкаВерхЛевая = ТекущаяЯчейкаВерх;
			ТекущаяЯчейкаЛевоЛевая = ТекущаяЯчейкаЛево;
			ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхЛевая,ТекущаяЯчейкаЛевоЛевая).ЦветФона =  WebЦвета.Розовый;
		КонецЕсли;	
		
		Если МножественнаяРасшифровка Тогда
			Если ПараметрыОбласти.ЭлементИсточник = "ТабличныйДокументПротокола" Тогда
				// Расшифровка из протокола. Отображается список.
				ОтчетСписокЛевый.Очистить();
				ОтчетСписокЛевый.Вывести(ТабличныйДокументСравнения);
				Элементы.СтраницыОтчетЛевый.ТекущаяСтраница = Элементы.СтраницаЛевыйСписок;
				Элементы.СтраницаЛевыйРасшифровка.Видимость = Ложь;
			Иначе
				ОтчетСравненияЛевый.Вывести(ТабличныйДокументСравнения);
				Элементы.СтраницыОтчетЛевый.ТекущаяСтраница = Элементы.СтраницаЛевыйРасшифровка;
				Элементы.СтраницаЛевыйРасшифровка.Видимость = Истина;
			КонецЕсли;
			Элементы.СтраницыОтчетЛевый.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
		Иначе	
			ОтчетСравненияЛевый.Вывести(ТабличныйДокументСравнения);
			Элементы.СтраницыОтчетЛевый.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
			Элементы.СтраницыОтчетЛевый.ТекущаяСтраница = Элементы.СтраницаЛевыйРасшифровка;
			Элементы.СтраницаЛевыйРасшифровка.Видимость = Истина;
		КонецЕсли;
			
		Элементы.ОтчетСравненияЛевый.ТекущаяОбласть = ТабличныйДокументСравнения.Область(ПараметрыОбласти.ТекущаяОбластьВерх,ПараметрыОбласти.ТекущаяОбластьЛево);
		Элементы.ОтчетЛевыйОписание.Заголовок = ПараметрыОбласти.ЗаголовокРасшифровки;
	КонецЕсли;
	Элементы.ГруппаОтчетЛевый.Видимость = ОтчетСравненияЛевый.ВысотаТаблицы > 0 ИЛИ ОтчетСписокЛевый.ВысотаТаблицы > 0;
	Элементы.ГруппаОтчетПравый.Видимость = (ОтчетСравненияПравый.ВысотаТаблицы > 0 ИЛИ ОтчетСписокПравый.ВысотаТаблицы > 0) И (ЭтоМежформенноеСоотношение ИЛИ МножественнаяРасшифровка);
			
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьИсходныхОтчетов(ОтображениеКнопок, ОтображениеГруппы)
	
	Элементы.ГруппаОтчетыСравнения.Видимость = ОтображениеКнопок;
	
	Если ОтображениеГруппы Тогда
		Элементы.ПоказатьИсходныеОтчеты.Заголовок = НСтр("ru='Скрыть данные исходных отчетов'");
	Иначе	
		Элементы.ПоказатьИсходныеОтчеты.Заголовок = НСтр("ru='Показать данные исходных отчетов'");
	КонецЕсли;
	
	Элементы.ПоказатьИсходныеОтчеты.Пометка = ОтображениеГруппы;
	Элементы.ГруппаТабличныеДокументыСравнения.Видимость = ОтображениеГруппы;
	
КонецПроцедуры

&НаСервере
Функция ЭтоРасшифровкаСтрокиСообщения(ПараметрыСтроки,ЗаголовокРасшифровки,ТекущаяЯчейкаВерх,ТекущаяЯчейкаЛево)
	
	АдресХранилища = "";
	ПараметрыСтроки.Свойство("АдресХранилища",АдресХранилища);
	
	ИндексСтроки = "";
	ПараметрыСтроки.Свойство("Идентификатор",ИндексСтроки);
	
	СтруктураРасшифровки = ПолучитьИзВременногоХранилища(АдресХранилища);
	ЗначениеРасшифровки = СтруктураРасшифровки[ИндексСтроки];
	
	Если Не ЗначениеРасшифровки.Свойство("РасшифровкаСтроки") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекущееКС = ЗначениеРасшифровки.КонтрольноеСоотношение;
	ТабДокумент = Новый ТабличныйДокумент;
	
	//всегда обновляем, т.к. расшифровываемая строка раскрытия может быть на другой странице бланка
	ОбновлятьТабличныйДокумент = Истина;
	
	Если ОбновлятьТабличныйДокумент Тогда
		
		ОтчетСравненияЛевый.Очистить();
		ОтчетСравненияПравый.Очистить();
		ОтчетСписокЛевый.Очистить();
		ОтчетСписокПравый.Очистить();
		
		// Устанавливаем стандартный цвет для предыдущей активной ячейки расшифровки и выделяем новую.
		Если ЗначениеЗаполнено(ТекущаяЯчейкаВерхЛевая) Тогда
			ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхЛевая,ТекущаяЯчейкаЛевоЛевая).ЦветФона = Новый Цвет(245, 245, 220);
			ТекущаяЯчейкаВерхЛевая = 0;
			ТекущаяЯчейкаЛевоЛевая = 0;
		КонецЕсли;	
		Если ЗначениеЗаполнено(ТекущаяЯчейкаВерхПравая) Тогда
			ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхПравая,ТекущаяЯчейкаЛевоПравая).ЦветФона = Новый Цвет(245, 245, 220);
			ТекущаяЯчейкаВерхПравая = 0;
			ТекущаяЯчейкаЛевоПравая = 0;
		КонецЕсли;
		
		ПустаяСсылка = Документы.УниверсальныйРегламентированныйОтчет.ПустаяСсылка();
		ОтчетПравыйСсылка	= ПустаяСсылка;
		ОтчетЛевыйСсылка	= ПустаяСсылка;
		
		ТекстЗаголовкаГруппыСравнения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
											НСтр("ru='Расшифровка КС: %1'"), Строка(ТекущееКС));
		Элементы.ЗаголовокОтчетовСравнения.Заголовок = ТекстЗаголовкаГруппыСравнения;
		
		//Получаем документ и его бланк
		//
		ОтчетОбъект = ЗначениеРасшифровки.ДокументСсылка.ПолучитьОбъект();
		ОтчетОбъект.РежимДиалога = Истина;
		ОтчетОбъект.ПроверитьКонтекстИнициализирован();
		
		//Инициализация настроек компактного отображения длинных строк
		ИменаЯчеекДлинныхСтрок = Неопределено;
		НастройкаОтображенияДлСтр = ОтчетОбъект.мНастройкиБланка.Найти("<ОтображениеЯчеек>","ИмяЯчейки");
		Если НастройкаОтображенияДлСтр <> Неопределено Тогда
			ИменаЯчеекДлинныхСтрок = Новый ФиксированныйМассив(СтрРазделить(НастройкаОтображенияДлСтр.СтруктураНастроек.ЯчейкиДляКомпактногоОтображения,",",Ложь));
		КонецЕсли;
		
		ТабДокумент = Документы.УниверсальныйРегламентированныйОтчет.ОпределитьСтраницуБланкаПоПоказателям(ОтчетОбъект,Неопределено,ЗначениеРасшифровки.КодСтроки);
		
		МассивПоказателейСтраницы = ОтчетОбъект.ПолучитьМассивПоказателейСтраницы();
	
		ОтчетОбъект.ЗаполнитьМакет(ТабДокумент,МассивПоказателейСтраницы);
				
		РежимРаскрытия 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетОбъект.ШаблонОтчета,"РаскрытиеВМакете");
		ВыводитьРаскрытиеВТеле  = (РежимРаскрытия = Перечисления.СпособыРедактированияРаскрытия.ВТелеОтчета);
		
		Если ВыводитьРаскрытиеВТеле Тогда			
			ОтчетОбъект.ВывестиРаскрытиеВТелеОтчета(ТабДокумент);
		КонецЕсли;
		
		ПрименитьНастройкуВыводаДлинныхСтрок(ТабДокумент,ИменаЯчеекДлинныхСтрок,Истина);

	Иначе 
		ТабДокумент.Вывести(ОтчетСравненияЛевый);
	КонецЕсли;	
		
	ОтчетЛевыйСсылка = ЗначениеРасшифровки.ДокументСсылка;
	
	//Выделяем новые ячейки (ранее выделенные также остаются выделенными)
	Если ЗначениеЗаполнено(ТекущаяЯчейкаВерх) Тогда
		Если ЗначениеЗаполнено(ТекущаяЯчейкаВерхЛевая) Тогда
			ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхЛевая,ТекущаяЯчейкаЛевоЛевая).ЦветФона = Новый Цвет(245, 245, 220);
		КонецЕсли;
		ТекущаяЯчейкаВерхЛевая = ТекущаяЯчейкаВерх;
		ТекущаяЯчейкаЛевоЛевая = ТекущаяЯчейкаЛево;
		ТабличныйДокументПротокола.Область(ТекущаяЯчейкаВерхЛевая,ТекущаяЯчейкаЛевоЛевая).ЦветФона =  WebЦвета.Розовый;
	КонецЕсли;	
	
	//Поиск нужной строки в бланке
	//и скрытие ненужных строк
	Верх = 1; Низ = 1; Право = 1;	Лево = 0;
	СкрытьОбласти = Новый Массив;
	Если ЗначениеРасшифровки.ИтогПоСтроке Тогда
		СтрокаПоиска = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеРасшифровки.ГруппаРаскрытия,"Код")+"_"+ЗначениеРасшифровки.КодСтроки+"_";
		Для Каждого Стр из ТабДокумент.Области Цикл
			ИмяОбласти = Стр.Имя;
			Если СтрНачинаетсяС(ИмяОбласти,"XLS_Граница_")
				ИЛИ СтрНачинаетсяС(ИмяОбласти,"XLS_Раздел_")
				ИЛИ СтрНачинаетсяС(ИмяОбласти,"XLS_Шапка_") Тогда
				//Это имена строк для разделения бланка на страницы, при сохранении его в Excel.
				//Такие строки не анализируются.
				Продолжить;
			КонецЕсли;
			КоличествоВхождений = СтрЧислоВхождений(ИмяОбласти,"_");
			Если НЕ КоличествоВхождений Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрНачинаетсяС(ИмяОбласти,СтрокаПоиска) 
				И СтрЗаканчиваетсяНа(ИмяОбласти,"_"+ЗначениеРасшифровки.НомерСтроки)  Тогда
				Верх	= Стр.Верх;
				Низ		= Стр.Низ;
				Право	= Макс(Право,Стр.Право); 				
				Лево	= ?(Лево=0,Стр.Лево,Мин(Лево,Стр.Лево));
			ИначеЕсли КоличествоВхождений > 1 Тогда 
				СкрытьОбласти.Добавить(Стр.Верх);
			КонецЕсли;			
		КонецЦикла;
	Иначе
		СтрокаПоиска = ЗначениеРасшифровки.КодСтроки+"_";
		Для Каждого Стр из ТабДокумент.Области Цикл
			ИмяОбласти = Стр.Имя;
			Если СтрНачинаетсяС(ИмяОбласти,"XLS_Граница_")
				ИЛИ СтрНачинаетсяС(ИмяОбласти,"XLS_Раздел_")
				ИЛИ СтрНачинаетсяС(ИмяОбласти,"XLS_Шапка_") Тогда
				//Это имена строк для разделения бланка на страницы, при сохранении его в Excel.
				//Такие строки не анализируются.
				Продолжить;
			КонецЕсли;
			Если СтрНачинаетсяС(ИмяОбласти,СтрокаПоиска) Тогда
				Верх	= Стр.Верх;
				Низ		= Стр.Низ;
				Право	= Макс(Право,Стр.Право); 				
				Лево	= ?(Лево=0,Стр.Лево,Мин(Лево,Стр.Лево));
			ИначеЕсли СтрЧислоВхождений(ИмяОбласти,"_") > 1 Тогда 
				СкрытьОбласти.Добавить(Стр.Верх);
			КонецЕсли;			
		КонецЦикла;
	КонецЕсли;
	СкрытьОбласти = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СкрытьОбласти);
	Для Каждого НомСтроки из СкрытьОбласти Цикл
		ТабДокумент.Область("R"+Формат(НомСтроки,"ЧГ=0")).Видимость = Ложь;
	КонецЦикла;
	
	ОбластьВыделить = ТабДокумент.Область(Верх,Лево,Низ,Право);
	ОбластьВыделить.ЦветФона = WebЦвета.Розовый;
	ТабДокумент.Область("R"+Формат(Верх,"ЧГ=0")+":R"+Формат(Низ,"ЧГ=0")).Видимость = Истина;
	
	//Вывод бланка в табличный документ формы
	//
	ОтчетСравненияЛевый.Очистить();	
	ОтчетСравненияЛевый.Вывести(ТабДокумент);
	Элементы.СтраницыОтчетЛевый.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	Элементы.СтраницыОтчетЛевый.ТекущаяСтраница = Элементы.СтраницаЛевыйРасшифровка;
	Элементы.СтраницаЛевыйРасшифровка.Видимость = Истина;
	
	ПозицияПереноса = СтрНайти(ЗаголовокРасшифровки,Символы.ПС);
	
	Если ПозицияПереноса>0 Тогда
		ЗаголовокРасшифровки = Лев(ЗаголовокРасшифровки,ПозицияПереноса-1);
	КонецЕсли;
	
	Элементы.ОтчетЛевыйОписание.Заголовок = ЗаголовокРасшифровки;
	Элементы.ГруппаОтчетЛевый.Видимость = ОтчетСравненияЛевый.ВысотаТаблицы > 0 ИЛИ ОтчетСписокЛевый.ВысотаТаблицы > 0;
	Элементы.ОтчетСравненияЛевый.ТекущаяОбласть = ТабДокумент.Область(Верх,Лево,Низ,Право);
	
	РанееПросмотреноКС = ТекущееКС;
	Возврат Истина;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьНастройкуВыводаДлинныхСтрок(ТабДок,ИменаЯчеекДлинныхСтрок,ВыводитьДлинныеПоляВОднуСтроку)
	
	Если ИменаЯчеекДлинныхСтрок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастроекОтображения = Новый Структура;
	
	МинимальнаяДлинаАнализируемойОбласти = 1000;
	Для Каждого ИмяЯчейкиДлСтр Из ИменаЯчеекДлинныхСтрок Цикл 
		
		ДлинаИмени = СтрДлина(ИмяЯчейкиДлСтр);	
		
		СтруктураНастроекОтображения.Вставить(ИмяЯчейкиДлСтр,ДлинаИмени);
		
		МинимальнаяДлинаАнализируемойОбласти = Мин(МинимальнаяДлинаАнализируемойОбласти,ДлинаИмени);
	КонецЦикла;
	
	КоллекцияОбластей = ТабДок.Области;
	Для Каждого ТекОбл Из КоллекцияОбластей Цикл
		Если ТипЗнч(ТекОбл) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;
		
		ДлинаИмениОбласти = СтрДлина(ТекОбл.Имя);
		
		Если ДлинаИмениОбласти < МинимальнаяДлинаАнализируемойОбласти Тогда
			//длина имени области меньше чем длина самого короткого имени из перечня нужных областей,
			//нет смысла проверять подробнее
			Продолжить;
		КонецЕсли;
		
		Для Каждого ИмяЯчейкиДлСтр Из ИменаЯчеекДлинныхСтрок Цикл
			ДлинаИмени = СтруктураНастроекОтображения[ИмяЯчейкиДлСтр];
			
			Если Найти(ТекОбл.Имя,ИмяЯчейкиДлСтр) <> 1 Тогда
				Продолжить;
			КонецЕсли; 
			
			Если ДлинаИмениОбласти > ДлинаИмени 
				И Найти("0123456789",Сред(ТекОбл.Имя,ДлинаИмени+2,1)) = 0 Тогда
				Продолжить;
			КонецЕсли;
				 			
			Если ВыводитьДлинныеПоляВОднуСтроку Тогда				
				ТекОбл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Обрезать;
			Иначе
				ТекОбл.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			КонецЕсли;
			СтрокаОбласти = ТабДок.Область(ТекОбл.Верх,,ТекОбл.Низ);
			Если СтрокаОбласти.АвтоВысотаСтроки = Ложь Тогда
				СтрокаОбласти.АвтоВысотаСтроки = Истина;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;	
КонецПроцедуры

// Выполняет суммирование значений в выделенных ячейках.
//
&НаКлиенте
Функция ПолучитьАвтосуммуПоказателей(ТабличныйДокумент)
	
	ПараметрыАвтосуммы = Новый Структура;
	СуммаЗначений = 0;
	ФорматОбласти = "";
	ОбработанныеОбласти = Новый Соответствие;
	
	Для Каждого Область Из ТабличныйДокумент.ВыделенныеОбласти Цикл
		
		Если ТипЗнч(Область) <> Тип("ОбластьЯчеекТабличногоДокумента") или Область.ТипОбласти <> ТипОбластиЯчеекТабличногоДокумента.Прямоугольник Тогда
			Продолжить;
		КонецЕсли;
		
		Для СчСтрок = Область.Верх По Область.Низ Цикл
			Для СчКолонок = Область.Лево По Область.Право Цикл
				
				ТекущаяОбласть = ТабличныйДокумент.Область(СчСтрок,СчКолонок);
				Если Не (ТекущаяОбласть.СодержитЗначение И ТипЗнч(ТекущаяОбласть.Значение) = Тип("Число")) Тогда
					Продолжить;
				КонецЕсли;
				
 				ИмяОбласти = ТекущаяОбласть.Имя;
				
				// ТабличныйДокумент может добавлять в ВыделенныеОбласти одни и те же ячейки.
				// Обработаем данную ситуацию.
				Если ОбработанныеОбласти[ИмяОбласти] = Неопределено Тогда
					ОбработанныеОбласти.Вставить(ИмяОбласти,Истина);
				Иначе
					Продолжить;
				КонецЕсли;
				
				СуммаЗначений = СуммаЗначений + ТекущаяОбласть.Значение;
				ФорматОбласти = ТекущаяОбласть.Формат;
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;

	ПараметрыАвтосуммы.Вставить("СуммаЗначений", СуммаЗначений);
	ПараметрыАвтосуммы.Вставить("ФорматОбласти", ФорматОбласти);
	
	Возврат ПараметрыАвтосуммы;
	
КонецФункции // ПолучитьАвтосуммуПоказателей()

&НаСервере
Процедура СохранитьОтчетExcelНаСервере(ИмяРеквизита)
	ИмяФайлаExcel = ПолучитьИмяВременногоФайла("xlsx");
	ЭтотОбъект[ИмяРеквизита].Записать(ИмяФайлаExcel,ТипФайлаТабличногоДокумента.XLSX);
	ФайлДанных = Новый ДвоичныеДанные(ИмяФайлаExcel);
	АдресФайлаExcel = ПоместитьВоВременноеХранилище(ФайлДанных, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ВывестиФайлExcel()
	
	#Если ВебКлиент Тогда
		ПолучитьФайл(АдресФайлаExcel, "Report.xlsx", Истина);
	#Иначе
		ИмяФайлаExcel = ПолучитьИмяВременногоФайла("xlsx");
		ПолучитьФайл(АдресФайлаExcel, ИмяФайлаExcel, Ложь);
		
		Оповещение = Новый ОписаниеОповещения("ЗапускПриложения", ЭтотОбъект);
		НачатьЗапускПриложения(Оповещение, ИмяФайлаExcel);
	#КонецЕсли	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапускПриложения(Результат, ДополнительныйПараметр) Экспорт
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКОшибкеСписка(ПереходВперед = Истина)
	
	ТекОблТаблицы = ТабличныйДокументПротокола.ТекущаяОбласть;
	
	Если ПереходВперед Тогда
		Если ТекОблТаблицы <> Неопределено Тогда
			НачальнаяСтрока = ТекОблТаблицы.Низ+1;
		Иначе
			НачальнаяСтрока = 1;
		КонецЕсли;
		КонечнаяСтрока = ТабличныйДокументПротокола.ВысотаТаблицы;
	Иначе
		Если ТекОблТаблицы <> Неопределено Тогда
			НачальнаяСтрока = -(ТекОблТаблицы.Верх-1);
		Иначе
			НачальнаяСтрока = -1;
		КонецЕсли;
		КонечнаяСтрока = -1;
	КонецЕсли;
	
	Для СчСтрок = НачальнаяСтрока По КонечнаяСтрока Цикл
		
		НомерСтрокиТаблицы = Макс(СчСтрок, -СчСтрок);
		
		ОбластьРезультатРасчета = ТабличныйДокументПротокола.Область(НомерСтрокиТаблицы, 9); //Задана фикированная область
		
		Если ОбластьРезультатРасчета.Текст = "Ошибка" ИЛИ ОбластьРезультатРасчета.Текст = "Предупреждение" Тогда
			Элементы.ТабличныйДокументПротокола.ТекущаяОбласть = ТабличныйДокументПротокола.Область(НомерСтрокиТаблицы,9);
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

