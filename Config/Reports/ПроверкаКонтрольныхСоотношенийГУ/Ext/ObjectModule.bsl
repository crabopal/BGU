#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Перем мФабрикаXDTO;

Перем мСписокПроверяемыхДокументов;

Перем мКэшДанныхОтобранныхОтчетов; // Переменная хранит данные проверяемых отчетов

// Устанавливает список проверяемых отчетов
//
Процедура УстановитьСписокОтчетов(СписокОтчетов) Экспорт
	
	Если ТипЗнч(СписокОтчетов) = Тип("СписокЗначений") Тогда
		мСписокПроверяемыхДокументов = СписокОтчетов;
	ИначеЕсли ТипЗнч(СписокОтчетов) = Тип("Массив") Тогда
		мСписокПроверяемыхДокументов = Новый СписокЗначений;
		мСписокПроверяемыхДокументов.ЗагрузитьЗначения(СписокОтчетов);
	КонецЕсли;
	
КонецПроцедуры // УстановитьСписокОтчетов()

// Выполняет группировку протоколов из кэша.
//
Функция СгруппироватьПротоколыПоЗаданнымПолям(Знач ПоляГруппировки, ТаблицаПротоколов = Неопределено, ТипПреобразованияИзXDTO = Неопределено) Экспорт

	ГруппировочныйКэш = Новый ТаблицаЗначений;
	
	Если ТипЗнч(ПоляГруппировки) = Тип("Строка") Тогда
		ПоляГруппировки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПоляГруппировки);
	КонецЕсли;
	
	Для Каждого Поле Из ПоляГруппировки Цикл
		ГруппировочныйКэш.Колонки.Добавить(Поле);
		ГруппировочныйКэш.Индексы.Добавить(Поле);
	КонецЦикла;
	
	Если ТаблицаПротоколов = Неопределено Тогда
		ТаблицаПротоколов = мКэшДанныхОтобранныхОтчетов;
	КонецЕсли;
	
	ГруппировочныйКэш.Колонки.Добавить("ПротоколПроверки");
	
	Для Каждого ОтчетИсточник Из ТаблицаПротоколов Цикл
		
		Если ОтчетИсточник.ПротоколПроверки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура;
		Для Каждого Поле Из ПоляГруппировки Цикл
			СтруктураПоиска.Вставить(Поле,ОтчетИсточник[Поле]);
		КонецЦикла;
		
		// Получим результирующий документ
		Протоколы = ГруппировочныйКэш.НайтиСтроки(СтруктураПоиска);
		
		Если Протоколы.Количество() = 0 Тогда
			// Результирующий документ еще не сформирован
			СтрПротокол = ГруппировочныйКэш.Добавить();
			ЗаполнитьЗначенияСвойств(СтрПротокол,ОтчетИсточник);
			
			Протокол = Неопределено;
		Иначе
			Протокол = Протоколы[0].ПротоколПроверки;
		КонецЕсли;
		 
		Если Протокол = Неопределено Тогда
			Протокол 					 = Новый ТабличныйДокумент;
			СтрПротокол.ПротоколПроверки = Протокол;
		КонецЕсли;
			
		Протокол.Вывести(ОтчетИсточник.ПротоколПроверки);
		
	КонецЦикла;
	
	Возврат ГруппировочныйКэш;

КонецФункции // СгруппироватьПротоколыПоЗаданнымПолям()

// Возвращает таблицу, которую можно использовать для группировки протоколов
//
Функция ПолучитьТаблицуГруппировкиПротоколов() Экспорт
	
	ТаблицаКэша = Новый ТаблицаЗначений;
	
	ТаблицаКэша.Колонки.Добавить("Ссылка");
	ТаблицаКэша.Колонки.Добавить("Организация");
	ТаблицаКэша.Колонки.Добавить("ВидОтчета");
	ТаблицаКэша.Колонки.Добавить("ОписаниеАналитики");
	ТаблицаКэша.Колонки.Добавить("ОтчетныйПериод");
	ТаблицаКэша.Колонки.Добавить("ИФО");
	ТаблицаКэша.Колонки.Добавить("ПротоколПроверки");
	ТаблицаКэша.Колонки.Добавить("ОбщийРезультатПроверки");
	ТаблицаКэша.Колонки.Добавить("ВсегоОшибок");
	ТаблицаКэша.Колонки.Добавить("ВсегоПредупреждений");
	
	Возврат ТаблицаКэша;
	
КонецФункции // ПолучитьТаблицуГруппировкиПротоколов()

// Функция определяет работает ли отчет в режиме внешнего вызова
//
Функция ИспользоватьВнешнийСписокОтчетов() Экспорт
	
	Возврат Не (мСписокПроверяемыхДокументов = Неопределено);
	
КонецФункции // ИспользоватьВнешнийСписокОтчетов()


