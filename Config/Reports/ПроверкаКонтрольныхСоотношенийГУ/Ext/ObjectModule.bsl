// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ ФОРМИРОВАНИЯ ПРОТОКОЛОВ ПРОВЕРКИ
//

// Вспомогательная процедура вывода табличного протокола.
//
Процедура ВывестиОбластьРеквизита(ИмяРеквизита,ЗначениеРеквизита,ОбластьРеквизита,ТабДокумент)
	
	ОбластьРеквизита.Параметры.ИмяРеквизита=ИмяРеквизита+": ";
	ОбластьРеквизита.Параметры.ЗначениеРеквизита=ЗначениеРеквизита;
	
	ТабДокумент.Вывести(ОбластьРеквизита);
	
КонецПроцедуры // ВывестиОбластьРеквизита()

Функция ПолучитьОписаниеФормулы(ОтчетОбъект, СтрСоотношение, Часть, СтруктураОперандов, ФорматЗначения, ТолькоОшибочные)
	
	ТекстСоотношения = СтрСоотношение["Выражение" + Часть];
	
	ЕстьАналитика = Ложь;
	Для Каждого КолонкаРасчета Из СтрСоотношение.ДанныеРасчета.Колонки Цикл
		Если Лев(КолонкаРасчета.Имя,9) = "Аналитика" Тогда
			ЕстьАналитика = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрДанные ИЗ СтрСоотношение["СписокИспользуемых"+Часть] Цикл
		
		КодОперанда = СтрДанные.Значение;
		
		ТекстЗначениеОперанда = "";
		Если СтрСоотношение.ДанныеРасчета <> Неопределено Тогда
			ЗначениеОперанда = 0;
			
			Если ЕстьАналитика = Ложь Тогда
				Отбор = Новый Структура();
				Отбор.Вставить("ИтогПоПоказателю",Истина);
				ДанныеРасчетаДляФормулы = СтрСоотношение.ДанныеРасчета.НайтиСтроки(Отбор);
				
				Для Каждого СтрокаДанныхДляФормулы Из ДанныеРасчетаДляФормулы Цикл
					ЗначениеОперанда = ЗначениеОперанда + СтрокаДанныхДляФормулы["_"+КодОперанда];
				КонецЦикла;	
			Иначе
				Для Каждого СтрокаДанныхДляФормулы Из СтрСоотношение.ДанныеРасчета Цикл
					Если СтрокаДанныхДляФормулы.РезультатРасчета И ТолькоОшибочные Тогда
						Продолжить;
					КонецЕсли;
					
					Если СтрокаДанныхДляФормулы.ИтогПоПоказателю Тогда
						Продолжить;
					КонецЕсли;
					ЗначениеОперанда = ЗначениеОперанда + СтрокаДанныхДляФормулы["_"+КодОперанда];
				КонецЦикла;
			КонецЕсли;	
			
			ТекстЗначениеОперанда = " ("+Формат(ЗначениеОперанда,ФорматЗначения+";ЧН=0")+")";
		КонецЕсли;	
		
		СтрОперанд = Неопределено;
		СтруктураОперандов.Свойство(КодОперанда,СтрОперанд);
		
		Если Не СтрОперанд = Неопределено Тогда
			ТекстСоотношения = СтрЗаменить(ТекстСоотношения,"["+КодОперанда+"]","["+СтрОперанд.Наименование+"]"+ТекстЗначениеОперанда+Символы.НПП);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СокрЛП(ТекстСоотношения);
	
КонецФункции


