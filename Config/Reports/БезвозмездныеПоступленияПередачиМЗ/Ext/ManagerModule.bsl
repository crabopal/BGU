// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	МатериальныеЗапасыВыбытиеИПеремещение = Неопределено;                                    
	МатериальныеЗапасыПоступление = Неопределено;
	ИмуществоКазныМатериальныеЗапасы = Неопределено;

	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "БезвозмездныеВыбытияМЗ_ПоМесяцамИКонтрагентам");
	НастройкиВарианта.Описание = НСтр("ru = 'Передачи МЗ и ИК в корреспонденции со счетами 304.04 и 401.10, сгруппированные по месяцу выбытия и контрагенту.'");
	НастройкиВарианта.Размещение.Вставить(Метаданные.Подсистемы.ТаксиМатериальныеЗапасы.Подсистемы.ВыбытиеИПеремещение, "");
	НастройкиВарианта.Размещение.Вставить(Метаданные.Подсистемы.ТаксиИмуществоКазны.Подсистемы.МатериальныеЗапасы, "");
	Если НЕ МатериальныеЗапасыВыбытиеИПеремещение = Неопределено Тогда
		НастройкиВарианта.Размещение.Вставить(МатериальныеЗапасыВыбытиеИПеремещение, "");
	КонецЕсли;
	Если НЕ ИмуществоКазныМатериальныеЗапасы = Неопределено Тогда
		НастройкиВарианта.Размещение.Вставить(ИмуществоКазныМатериальныеЗапасы, "");
	КонецЕсли;
		
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "БезвозмездныеВыбытияМЗ");
	НастройкиВарианта.Описание = НСтр("ru = 'Передачи МЗ и ИК в корреспонденции со счетами 304.04 и 401.10, сгруппированные по дате выбытия.'");
	НастройкиВарианта.Размещение.Вставить(Метаданные.Подсистемы.ТаксиМатериальныеЗапасы.Подсистемы.ВыбытиеИПеремещение, "");
	НастройкиВарианта.Размещение.Вставить(Метаданные.Подсистемы.ТаксиИмуществоКазны.Подсистемы.МатериальныеЗапасы, "");
	Если НЕ МатериальныеЗапасыВыбытиеИПеремещение = Неопределено Тогда
		НастройкиВарианта.Размещение.Вставить(МатериальныеЗапасыВыбытиеИПеремещение, "");
	КонецЕсли;
	Если НЕ ИмуществоКазныМатериальныеЗапасы = Неопределено Тогда
		НастройкиВарианта.Размещение.Вставить(ИмуществоКазныМатериальныеЗапасы, "");
	КонецЕсли;
		
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "БезвозмездныеПоступленияМЗ_ПоМесяцамИКонтрагентам");
	НастройкиВарианта.Описание = НСтр("ru = 'Поступления МЗ и ИК в корреспонденции со счетами 304.04 и 401.10, сгруппированные по месяцу поступления и контрагенту.'");
	НастройкиВарианта.Размещение.Вставить(Метаданные.Подсистемы.ТаксиМатериальныеЗапасы.Подсистемы.Поступление, "");
	НастройкиВарианта.Размещение.Вставить(Метаданные.Подсистемы.ТаксиИмуществоКазны.Подсистемы.МатериальныеЗапасы, "");
	Если НЕ МатериальныеЗапасыПоступление = Неопределено Тогда
		НастройкиВарианта.Размещение.Вставить(МатериальныеЗапасыПоступление, "");
	КонецЕсли;
	Если НЕ ИмуществоКазныМатериальныеЗапасы = Неопределено Тогда
		НастройкиВарианта.Размещение.Вставить(ИмуществоКазныМатериальныеЗапасы, "");
	КонецЕсли;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "БезвозмездныеПоступленияМЗ");
	НастройкиВарианта.Описание = НСтр("ru = 'Поступления МЗ и ИК в корреспонденции со счетами 304.04 и 401.10, сгруппированные по дате поступления.'");
	НастройкиВарианта.Размещение.Вставить(Метаданные.Подсистемы.ТаксиМатериальныеЗапасы.Подсистемы.Поступление, "");
	НастройкиВарианта.Размещение.Вставить(Метаданные.Подсистемы.ТаксиИмуществоКазны.Подсистемы.МатериальныеЗапасы, "");
	Если НЕ МатериальныеЗапасыПоступление = Неопределено Тогда
		НастройкиВарианта.Размещение.Вставить(МатериальныеЗапасыПоступление, "");
	КонецЕсли;
	Если НЕ ИмуществоКазныМатериальныеЗапасы = Неопределено Тогда
		НастройкиВарианта.Размещение.Вставить(ИмуществоКазныМатериальныеЗапасы, "");
	КонецЕсли;
	
КонецПроцедуры

