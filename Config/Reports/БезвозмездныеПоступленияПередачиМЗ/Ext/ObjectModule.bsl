#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	// Программное выполнение отчета
	СтандартнаяОбработка = Ложь;
	
	ИсполняемыеНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидыДвиженийНФАБезвозмезднойПередачи", ВидыДвиженийНФАБезвозмезднойПередачи());
	ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидыДвиженийНФАБезвозмедногоПоступления", ВидыДвиженийНФАБезвозмедногоПоступления());
	ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра("КЭКБезвозмездногоПоступления", КЭКБезвозмездногоПоступления());
	ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра("КЭКБезвозмезднойПередачи", КЭКБезвозмезднойПередачи());
	
	//ИсполняемыеНастройки = Настройки.ПолучитьНастройки();
	ВнешниеНаборыДанных = Неопределено;
	ВозможностьИспользованияВнешнихФункций = Истина;
	
	КомпоновщикМакетаКД = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКД = КомпоновщикМакетаКД.Выполнить(СхемаКомпоновкиДанных, ИсполняемыеНастройки, ДанныеРасшифровки);
	
	ПроцессорКД = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКД.Инициализировать(МакетКД, ВнешниеНаборыДанных, ДанныеРасшифровки,
		ВозможностьИспользованияВнешнихФункций);
		
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКД, Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КЭКБезвозмезднойПередачи()
	Возврат БухгалтерскийУчет.СписокКЭК("240,250,280");
КонецФункции

Функция КЭКБезвозмездногоПоступления()
	Возврат БухгалтерскийУчет.СписокКЭК("190");
КонецФункции

Функция ВидыДвиженийНФАБезвозмедногоПоступления()
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ВидыДвиженийНФА.ПоступлениеБезвозмездноеИное);
	Результат.Добавить(Перечисления.ВидыДвиженийНФА.ПоступлениеВнутриведомственное);
	Результат.Добавить(Перечисления.ВидыДвиженийНФА.ПоступлениеМежбюджетное);
	Результат.Добавить(Перечисления.ВидыДвиженийНФА.ПоступлениеОдногоУровняБюджета);
	Возврат Результат;
КонецФункции

Функция ВидыДвиженийНФАБезвозмезднойПередачи()
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ВидыДвиженийНФА.СписаниеБезвозмездноеИное);
	Результат.Добавить(Перечисления.ВидыДвиженийНФА.СписаниеВнутриведомственное);
	Результат.Добавить(Перечисления.ВидыДвиженийНФА.СписаниеМежбюджетное);
	Результат.Добавить(Перечисления.ВидыДвиженийНФА.СписаниеОдногоУровняБюджета);
	Возврат Результат;
КонецФункции

#КонецОбласти

