		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Основная.Период КАК ПериодС,
	МИНИМУМ(Вспомогательная.Период) КАК ПериодПо,
	Основная.Студент КАК Студент,
	Основная.Контрагент КАК Контрагент,
	Основная.Договор КАК ДоговорКонтрагента,
	Основная.ПорядокВыпискиСФ КАК ПорядокВыпискиСФ
ПОМЕСТИТЬ СтудентыПериоды
ИЗ
	РегистрСведений.ПлательщикиПоДоговоруОбразование КАК Основная
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлательщикиПоДоговоруОбразование КАК Вспомогательная
		ПО Основная.Студент = Вспомогательная.Студент
			И Основная.Период &lt; Вспомогательная.Период
{ГДЕ
	Основная.Студент.*,
	Основная.Контрагент.*,
	Основная.Договор.*,
	Основная.ПорядокВыпискиСФ}

СГРУППИРОВАТЬ ПО
	Основная.Период,
	Основная.Студент,
	Основная.Контрагент,
	Основная.Договор,
	Основная.ПорядокВыпискиСФ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СтудентыПериоды.ПериодС КАК ПериодС,
	СтудентыПериоды.ПериодПо КАК ПериодПо,
	СтудентыПериоды.Студент КАК Студент,
	СтудентыПериоды.Контрагент КАК Контрагент,
	СтудентыПериоды.ДоговорКонтрагента КАК ДоговорКонтрагента,
	СтудентыПериоды.ПорядокВыпискиСФ КАК ПорядокВыпискиСФ,
	СтудентыСтавки.СтавкаОплаты КАК СтавкаОплаты
{ВЫБРАТЬ
	ПериодС,
	ПериодПо,
	Студент.*,
	Контрагент.*,
	ДоговорКонтрагента.*,
	ПорядокВыпискиСФ,
	СтавкаОплаты.*}
ИЗ
	СтудентыПериоды КАК СтудентыПериоды
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			СведенияОСтудентах.Период КАК Период,
			СведенияОСтудентах.Студент КАК Студент,
			СведенияОСтудентах.Факультет КАК Факультет,
			СведенияОСтудентах.Значение КАК СтавкаОплаты
		ИЗ
			РегистрСведений.СведенияОСтудентах КАК СведенияОСтудентах
		ГДЕ
			СведенияОСтудентах.Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СтавкаОплаты)) КАК СтудентыСтавки
		ПО СтудентыПериоды.Студент = СтудентыСтавки.Студент
			И (СтудентыСтавки.Период &gt;= СтудентыПериоды.ПериодС)
			И (СтудентыСтавки.Период &lt; ЕСТЬNULL(СтудентыПериоды.ПериодПо, &amp;НаДату))</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>Период.ПериодПоРасчетный</dataPath>
		<expression>ВЫБОР КОГДА ЕстьNULL(ПериодПо, 0) = 0 ТОГДА
	"Действует сейчас"
ИНАЧЕ
	ДОБАВИТЬКДАТЕ(ПериодПо, "ДЕНЬ", -1)
КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>по</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<condition>true</condition>
		</useRestriction>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="xs:string">ДФ='dd.MM.yyyy'</dcscor:value>
			</dcscor:item>
		</appearance>
		<valueType>
			<v8:Type>xs:string</v8:Type>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:StringQualifiers>
				<v8:Length>0</v8:Length>
				<v8:AllowedLength>Variable</v8:AllowedLength>
			</v8:StringQualifiers>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
	</calculatedField>
	<parameter>
