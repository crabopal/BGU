Процедура ВставитьГруппировку(НомерЖурнала, Структура, ИмяГруппировки, ЗначениеОтбора, Порядок = "", Позиция = Неопределено)
	
	Если Позиция = Неопределено Тогда
		ГруппировкаКД = Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Иначе
		ГруппировкаКД = Структура.Вставить(Позиция, Тип("ГруппировкаКомпоновкиДанных"));
	КонецЕсли;
	ГруппировкаКД.Имя = ИмяГруппировки;
	ГруппировкаКД.ПоляГруппировки.Элементы.Добавить(Тип("АвтоПолеГруппировкиКомпоновкиДанных"));
	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппировкаКД.Отбор, "ДвиженияИлиГраницаПериода", ЗначениеОтбора);
	Если ЗначениеОтбора = -1 ИЛИ ЗначениеОтбора = 1 Тогда //убираем пустые остатки
		ГруппаОтбора = ГруппировкаКД.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаОтбора, "СуммаНачальныйОстатокДт", 0, ВидСравненияКомпоновкиДанных.НеРавно);
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаОтбора, "СуммаНачальныйОстатокКт", 0, ВидСравненияКомпоновкиДанных.НеРавно);
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаОтбора, "СуммаКонечныйОстатокДт", 0, ВидСравненияКомпоновкиДанных.НеРавно);
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаОтбора, "СуммаКонечныйОстатокКт", 0, ВидСравненияКомпоновкиДанных.НеРавно);
	КонецЕсли;
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(ГруппировкаКД, "ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	ГруппировкаКД.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Если Порядок = "" Тогда
		ГруппировкаКД.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	Иначе
		// Полей может быть несколько. Тогда они должны быть разделены запятой
		МассивПорядка = СтрРазделить(Порядок, ",");
		Для Каждого ЭлПорядка Из МассивПорядка Цикл
			ЭлементПорядка = ГруппировкаКД.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
			ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных(ЭлПорядка);
			ЭлементПорядка.Использование = Истина;
		КонецЦикла;	
	
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьОстаткиПоКЭК(ТекстЗапроса,
		НачальнаяМеткаГруппировки, //"//{Начало Группировки начальных остатков",
		КонечнаяМеткаГруппировки, //"//}Конец Группировки начальных остатков",
		ИмяТаблицы, //"НачальныеОстатки",
		НачальнаяМеткаТаблицы, //"//{Начало Выбор таблицы начальных остатков",
		КонечнаяМеткаТаблицы //"//{Конец Выбор таблицы начальных остатков");
)
	ТекстРеквизит = НачальнаяМеткаГруппировки +
		СтандартныеОтчеты.ПолучитьТекстПоМаркерамСБелымиСимволами(
			ТекстЗапроса, НачальнаяМеткаГруппировки, КонечнаяМеткаГруппировки);
	
	ТекстРеквизитЗамена = НачальнаяМеткаГруппировки;
	
	ТекстРеквизитЗамена = ТекстРеквизитЗамена + "
		|ВЫБРАТЬ
		|	${Таблица}.Счет КАК Счет,
		|	ВЫБОР 
		|		КОГДА (${Таблица}.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)) И (${Таблица}.СчетДт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) 
		|			ТОГДА ${Таблица}.СчетКт
		|		КОГДА (${Таблица}.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)) И НЕ (${Таблица}.СчетДт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) 
		|			ТОГДА ${Таблица}.СчетДт
		|		ИНАЧЕ ${Таблица}.СчетДт
		|	КОНЕЦ КАК СчетДт,
		|	ВЫБОР
		|		КОГДА (${Таблица}.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)) И (${Таблица}.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) 
		|			ТОГДА ${Таблица}.СчетДт
		|		КОГДА (${Таблица}.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)) И НЕ (${Таблица}.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) 
		|			ТОГДА ${Таблица}.СчетКт
		|		ИНАЧЕ ${Таблица}.СчетКт
		|	КОНЕЦ КАК СчетКт,
		|	${Таблица}.Субконто1 КАК Субконто1,
		|	${Таблица}.Субконто2 КАК Субконто2,
		|	${Таблица}.Субконто3 КАК Субконто3,
		|	${Таблица}.Организация,
		|	${Таблица}.Показатель,
		|	${Таблица}.РазделительQQ,
		|	${Таблица}.КПС КАК КПС,
		|	${Таблица}.КЭК КАК КЭК,
		|	${Таблица}.ИФО КАК ИФО,
		|	${Таблица}.Валюта КАК Валюта,
		|	${Таблица}.Подразделение,
		|	${Таблица}.КФО,
		|	${Таблица}.Регистратор,
		|	${Таблица}.ВидПервичногоДокумента,
		|	${Таблица}.ДатаПервичногоДокумента,
		|	${Таблица}.НомерПервичногоДокумента,
		|	СУММА(${Таблица}.СуммаНачальныйОстатокДт)КАК СуммаНачальныйОстатокДт,
		|	СУММА(${Таблица}.СуммаНачальныйОстатокКт)КАК СуммаНачальныйОстатокКт,
		|	СУММА(${Таблица}.Сумма) КАК Сумма,
		|	СУММА(${Таблица}.СуммаКонечныйОстатокДт) КАК СуммаКонечныйОстатокДт,
		|	СУММА(${Таблица}.СуммаКонечныйОстатокКт) КАК СуммаКонечныйОстатокКт,
		|	${Таблица}.ДвиженияИлиГраницаПериода КАК ДвиженияИлиГраницаПериода,
		|	${Таблица}.Период,
		|	${Таблица}.КПСДт,
		|	${Таблица}.КПСКт,
		|	${Таблица}.КЭКДт КАК КЭКДт,
		|	${Таблица}.КЭККт КАК КЭККт,
		|	${Таблица}.ПодразделениеДт КАК ПодразделениеДт,
		|	${Таблица}.ПодразделениеКт КАК ПодразделениеКт,
		|	${Таблица}.Содержание КАК Содержание,
		|	${Таблица}.ХарактеристикаДвиженияДт КАК ХарактеристикаДвиженияДт,
		|	${Таблица}.ХарактеристикаДвиженияКт КАК ХарактеристикаДвиженияКт,
		|	СУММА(${Таблица}.ВалютнаяСуммаДт) КАК ВалютнаяСуммаДт,
		|	СУММА(${Таблица}.ВалютнаяСуммаКт) КАК ВалютнаяСуммаКт,
		|	${Таблица}.ОборотДляГлавнойКниги КАК ОборотДляГлавнойКниги
		|ПОМЕСТИТЬ ДляГруппировкиКЭК";
		ТекстРеквизитЗамена = ТекстРеквизитЗамена + "${Таблица}
		|ИЗ
		|	${Таблица} КАК ${Таблица}
		|СГРУППИРОВАТЬ ПО
		|	${Таблица}.Счет,
		|	ВЫБОР 
		|		КОГДА (${Таблица}.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)) И (${Таблица}.СчетДт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) 
		|			ТОГДА ${Таблица}.СчетКт
		|		КОГДА (${Таблица}.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)) И НЕ (${Таблица}.СчетДт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) 
		|			ТОГДА ${Таблица}.СчетДт
		|		ИНАЧЕ ${Таблица}.СчетДт
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА (${Таблица}.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)) И (${Таблица}.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) 
		|			ТОГДА ${Таблица}.СчетДт
		|		КОГДА (${Таблица}.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)) И НЕ (${Таблица}.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) 
		|			ТОГДА ${Таблица}.СчетКт
		|		ИНАЧЕ ${Таблица}.СчетКт
		|	КОНЕЦ,
		|	${Таблица}.Субконто1,
		|	${Таблица}.Субконто2,
		|	${Таблица}.Субконто3,
		|	${Таблица}.Организация,
		|	${Таблица}.Показатель,
		|	${Таблица}.РазделительQQ,
		|	${Таблица}.КПС,
		|	${Таблица}.КЭК,
		|	${Таблица}.ИФО,
		|	${Таблица}.Валюта,
		|	${Таблица}.Подразделение,
		|	${Таблица}.КФО,
		|	${Таблица}.Регистратор,
		|	${Таблица}.ВидПервичногоДокумента,
		|	${Таблица}.ДатаПервичногоДокумента,
		|	${Таблица}.НомерПервичногоДокумента,
		|	${Таблица}.ДвиженияИлиГраницаПериода,
		|	${Таблица}.Период,
		|	${Таблица}.КПСДт,
		|	${Таблица}.КПСКт,
		|	${Таблица}.КЭКДт,
		|	${Таблица}.КЭККт,
		|	${Таблица}.ПодразделениеДт,
		|	${Таблица}.ПодразделениеКт,
		|	${Таблица}.Содержание,
		|	${Таблица}.ХарактеристикаДвиженияДт,
		|	${Таблица}.ХарактеристикаДвиженияКт,
		|	${Таблица}.ОборотДляГлавнойКниги
		|;
		|ВЫБРАТЬ
		|	МАКСИМУМ(${Таблица}.Счет) КАК Счет,
		|	ВЫБОР
		|		КОГДА ${Таблица}.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
		|     		ТОГДА 
		|				ВЫБОР 
		|					КОГДА (${Таблица}.СуммаНачальныйОстатокДт - ${Таблица}.СуммаНачальныйОстатокКт > 0
		|						ИЛИ ${Таблица}.СуммаКонечныйОстатокДт - ${Таблица}.СуммаКонечныйОстатокКт > 0)
		|						ТОГДА ${Таблица}.СчетДт
		|                 ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|				КОНЕЦ
		|		ИНАЧЕ ${Таблица}.СчетДт
		|	КОНЕЦ КАК СчетДт,
		|	ВЫБОР
		|		КОГДА ${Таблица}.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
		|     		ТОГДА 
		|				ВЫБОР 
		|					КОГДА (${Таблица}.СуммаНачальныйОстатокДт - ${Таблица}.СуммаНачальныйОстатокКт < 0
		|						ИЛИ ${Таблица}.СуммаКонечныйОстатокДт - ${Таблица}.СуммаКонечныйОстатокКт < 0)
		|				ТОГДА ${Таблица}.СчетКт
		|                 ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|				КОНЕЦ
		|		ИНАЧЕ ${Таблица}.СчетКт
		|	КОНЕЦ КАК СчетКт,
		|	МАКСИМУМ(${Таблица}.Субконто1) КАК Субконто1,
		|	МАКСИМУМ(${Таблица}.Субконто2) КАК Субконто2,
		|	МАКСИМУМ(${Таблица}.Субконто3) КАК Субконто3,
		|	${Таблица}.Организация,
		|	${Таблица}.Показатель,
		|	${Таблица}.РазделительQQ,
		|	МАКСИМУМ(${Таблица}.КПС) КАК КПС,
		|	${Таблица}.КЭК КАК КЭК,
		|	${Таблица}.ИФО КАК ИФО,
		|	МАКСИМУМ(${Таблица}.Валюта) КАК Валюта,
		|	${Таблица}.Подразделение,
		|	${Таблица}.КФО,
		|	${Таблица}.Регистратор,
		|	${Таблица}.ВидПервичногоДокумента,
		|	${Таблица}.ДатаПервичногоДокумента,
		|	${Таблица}.НомерПервичногоДокумента,
		|	СУММА(ВЫБОР
		|			КОГДА ${Таблица}.СуммаНачальныйОстатокКт > 0
		|				ТОГДА ВЫБОР
		|						КОГДА ${Таблица}.СуммаНачальныйОстатокДт - ${Таблица}.СуммаНачальныйОстатокКт > 0
		|							ТОГДА ${Таблица}.СуммаНачальныйОстатокДт - ${Таблица}.СуммаНачальныйОстатокКт
		|						ИНАЧЕ 0
		|					КОНЕЦ
		|			ИНАЧЕ ${Таблица}.СуммаНачальныйОстатокДт
		|		КОНЕЦ) КАК СуммаНачальныйОстатокДт,
		|	СУММА(ВЫБОР
		|			КОГДА ${Таблица}.СуммаНачальныйОстатокДт > 0
		|				ТОГДА ВЫБОР
		|						КОГДА ${Таблица}.СуммаНачальныйОстатокКт - ${Таблица}.СуммаНачальныйОстатокДт > 0
		|							ТОГДА ${Таблица}.СуммаНачальныйОстатокКт - ${Таблица}.СуммаНачальныйОстатокДт
		|						ИНАЧЕ 0
		|					КОНЕЦ
		|			ИНАЧЕ ${Таблица}.СуммаНачальныйОстатокКт
		|		КОНЕЦ) КАК СуммаНачальныйОстатокКт,
		|	СУММА(${Таблица}.Сумма) КАК Сумма,
		|	СУММА(ВЫБОР
		|			КОГДА ${Таблица}.СуммаКонечныйОстатокКт > 0
		|				ТОГДА ВЫБОР
		|						КОГДА ${Таблица}.СуммаКонечныйОстатокДт - ${Таблица}.СуммаКонечныйОстатокКт > 0
		|							ТОГДА ${Таблица}.СуммаКонечныйОстатокДт - ${Таблица}.СуммаКонечныйОстатокКт
		|						ИНАЧЕ 0
		|					КОНЕЦ
		|			ИНАЧЕ ${Таблица}.СуммаКонечныйОстатокДт
		|		КОНЕЦ) КАК СуммаКонечныйОстатокДт,
		|	СУММА(ВЫБОР
		|			КОГДА ${Таблица}.СуммаКонечныйОстатокДт > 0
		|				ТОГДА ВЫБОР
		|						КОГДА ${Таблица}.СуммаКонечныйОстатокКт - ${Таблица}.СуммаКонечныйОстатокДт > 0
		|							ТОГДА ${Таблица}.СуммаКонечныйОстатокКт - ${Таблица}.СуммаКонечныйОстатокДт
		|						ИНАЧЕ 0
		|					КОНЕЦ
		|			ИНАЧЕ ${Таблица}.СуммаКонечныйОстатокКт
		|		КОНЕЦ) КАК СуммаКонечныйОстатокКт,
		|	МАКСИМУМ(${Таблица}.ДвиженияИлиГраницаПериода) КАК ДвиженияИлиГраницаПериода,
		|	${Таблица}.Период,
		|	${Таблица}.КПСДт,
		|	${Таблица}.КПСКт,
		|	МАКСИМУМ(${Таблица}.КЭКДт) КАК КЭКДт,
		|	МАКСИМУМ(${Таблица}.КЭККт) КАК КЭККт,
		|	МАКСИМУМ(${Таблица}.ПодразделениеДт) КАК ПодразделениеДт,
		|	МАКСИМУМ(${Таблица}.ПодразделениеКт) КАК ПодразделениеКт,
		|	МАКСИМУМ(${Таблица}.Содержание) КАК Содержание,
		|	МАКСИМУМ(${Таблица}.ХарактеристикаДвиженияДт) КАК ХарактеристикаДвиженияДт,
		|	МАКСИМУМ(${Таблица}.ХарактеристикаДвиженияКт) КАК ХарактеристикаДвиженияКт,
		|	СУММА(${Таблица}.ВалютнаяСуммаДт) КАК ВалютнаяСуммаДт,
		|	СУММА(${Таблица}.ВалютнаяСуммаКт) КАК ВалютнаяСуммаКт,
		|	МАКСИМУМ(${Таблица}.ОборотДляГлавнойКниги) КАК ОборотДляГлавнойКниги
		|ПОМЕСТИТЬ Сгруппированные${Таблица}
		|ИЗ
		|	ДляГруппировкиКЭК${Таблица} КАК ${Таблица}
		|
		|СГРУППИРОВАТЬ ПО
		|	${Таблица}.Организация,
		|	${Таблица}.Подразделение,
		|	${Таблица}.Регистратор,
		|	${Таблица}.ВидПервичногоДокумента,
		|	${Таблица}.ДатаПервичногоДокумента,
		|	${Таблица}.НомерПервичногоДокумента,
		|	${Таблица}.Показатель,
		|	${Таблица}.РазделительQQ,
		|	${Таблица}.КПСДт,
		|	${Таблица}.КПСКт,
		|	${Таблица}.КФО,
		|	${Таблица}.ИФО,
		|	ВЫБОР
		|		КОГДА ${Таблица}.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
		|     	ТОГДА 
		|				ВЫБОР 
		|					КОГДА (${Таблица}.СуммаНачальныйОстатокДт - ${Таблица}.СуммаНачальныйОстатокКт > 0
		|						ИЛИ ${Таблица}.СуммаКонечныйОстатокДт - ${Таблица}.СуммаКонечныйОстатокКт > 0)
		|						ТОГДА ${Таблица}.СчетДт
		|                 ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|				КОНЕЦ
		|		ИНАЧЕ ${Таблица}.СчетДт
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ${Таблица}.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
		|     	ТОГДА 
		|				ВЫБОР 
		|					КОГДА (${Таблица}.СуммаНачальныйОстатокДт - ${Таблица}.СуммаНачальныйОстатокКт < 0
		|						ИЛИ ${Таблица}.СуммаКонечныйОстатокДт - ${Таблица}.СуммаКонечныйОстатокКт < 0)
		|				ТОГДА ${Таблица}.СчетКт
		|                 ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|				КОНЕЦ
		|		ИНАЧЕ ${Таблица}.СчетКт
		|	КОНЕЦ,
		|	${Таблица}.Период,
		|	${Таблица}.КЭК
		|;
		|";
	ТекстРеквизитЗамена = СтрЗаменить(ТекстРеквизитЗамена, "${Таблица}", ИмяТаблицы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТекстРеквизит, ТекстРеквизитЗамена);
	
		// Меняем имя таблицы
	ТекстРеквизит = НачальнаяМеткаТаблицы +
		СтандартныеОтчеты.ПолучитьТекстПоМаркерамСБелымиСимволами(
			ТекстЗапроса, НачальнаяМеткаТаблицы, КонечнаяМеткаТаблицы);
	ТекстРеквизитЗамена = НачальнаяМеткаТаблицы +
		"
		|	";
	ТекстРеквизитЗамена = ТекстРеквизитЗамена + "Сгруппированные";
	ТекстРеквизитЗамена = ТекстРеквизитЗамена + "${Таблица} КАК ${Таблица}";
	ТекстРеквизитЗамена = СтрЗаменить(ТекстРеквизитЗамена, "${Таблица}", ИмяТаблицы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТекстРеквизит, ТекстРеквизитЗамена);
	
	Возврат ТекстЗапроса;
