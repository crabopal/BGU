#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Перем ПоляБезГруппировкиИтогов;

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ДокументРезультат.УстановитьРастягиваниеПоГоризонтали(ЛОЖЬ);
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;
	Настройки.События.ПриОпределенииСвойствЭлементовФормыНастроек = Истина; 
	Настройки.РазрешеноИзменятьСтруктуру = Ложь;
	Настройки.Печать.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт; 
	
	Настройки.ЗагрузитьНастройкиПриИзмененииПараметров = Отчеты.ЖурналОпераций.ЗагрузитьНастройкиПриИзмененииПараметров(); 
	Настройки.РазрешеноВосстанавливатьСтандартнуюСхему = Истина;
		
	Настройки.ПараметрыРасположенияЭлементовУправления = Отчеты.ЖурналОпераций.ПараметрыРасположенияЭлементовУправления();
	
КонецПроцедуры

Процедура ПриОпределенииСвойствЭлементовФормыНастроек(ТипФормы, СвойстваЭлементов, ПользовательскиеНастройки) Экспорт 
	
	СвойстваГруппы = ОтчетыСервер.СвойстваГруппыЭлементовФормы();
	СвойстваГруппы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	СвойстваГруппы.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
	СвойстваЭлементов.Группы.Вставить("ФиксированныеПараметры_0", СвойстваГруппы);
	
	ФиксированныеПараметры_0 = "ГруппироватьПоРазделителю, ОтборПоРазделителю"; 
	
	ШиринаПоля = Новый Структура("НомерЖурнала, ГруппировкиПользователя", 5, 30); 
	
	Для Каждого ЭлементНастройки Из ПользовательскиеНастройки Цикл 
		
		ИдентификаторГруппы = Неопределено;
		ИмяПараметра = Неопределено;
		
		Если ТипЗнч(ЭлементНастройки) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда 
			Если СтрНайти(ФиксированныеПараметры_0, ЭлементНастройки.Параметр) > 0 Тогда
				ИдентификаторГруппы = "ФиксированныеПараметры_0"; 
			КонецЕсли;
			ИмяПараметра = Строка(ЭлементНастройки.Параметр);
		КонецЕсли; 
		
		Если ТипЗнч(ЭлементНастройки) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда 
			Если СтрНайти(ФиксированныеПараметры_0, ЭлементНастройки.ИдентификаторПользовательскойНастройки) > 0 Тогда
				ИдентификаторГруппы = "ФиксированныеПараметры_0"; 
			КонецЕсли; 
			ИмяПараметра = Строка(ЭлементНастройки.ИдентификаторПользовательскойНастройки);
		КонецЕсли; 
		
		СвойстваПоля = СвойстваЭлементов.Поля.Найти(ЭлементНастройки.ИдентификаторПользовательскойНастройки, "ИдентификаторНастройки");
		
		Если СвойстваПоля = Неопределено Тогда 
			Продолжить;
		КонецЕсли;  
		
		Если Не ИдентификаторГруппы = Неопределено Тогда
			СвойстваПоля.ИдентификаторГруппы = ИдентификаторГруппы;
		КонецЕсли;
		
		Если ИмяПараметра = "НомерЖурнала" Тогда 
			СвойстваПоля.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
			СвойстваПоля.Ширина = 5;
			СвойстваПоля.РастягиватьПоГоризонтали = Ложь;
			СвойстваПоля.Представление = "Номер журнала";
		ИначеЕсли ИмяПараметра = "ГруппировкиПользователя" Тогда	
			СвойстваПоля.Ширина = 30;
			СвойстваПоля.РастягиватьПоГоризонтали = Ложь;
			СвойстваПоля.Представление = "Дополнительные группировки";
			СвойстваПоля.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Вызывается перед загрузкой новых настроек. Используется для изменения схемы компоновки.
//   Например, если схема отчета зависит от ключа варианта или параметров отчета.
//   Чтобы изменения схемы вступили в силу следует вызывать метод ОтчетыСервер.ПодключитьСхему().
//
// Параметры:
//   Контекст - Произвольный - 
//       Параметры контекста, в котором используется отчет.
//       Используется для передачи в параметрах метода ОтчетыСервер.ПодключитьСхему().
//   КлючСхемы - Строка -
//       Идентификатор текущей схемы компоновщика настроек.
//       По умолчанию не заполнен (это означает что компоновщик инициализирован на основании основной схемы).
//       Используется для оптимизации, чтобы переинициализировать компоновщик как можно реже.
//       Может не использоваться если переинициализация выполняется безусловно.
//   КлючВарианта - Строка
//                - Неопределено -
//       Имя предопределенного или уникальный идентификатор пользовательского варианта отчета.
//       Неопределено когда вызов для варианта расшифровки или без контекста.
//   НовыеНастройкиКД - НастройкиКомпоновкиДанных
//                    - Неопределено -
//       Настройки варианта отчета, которые будут загружены в компоновщик настроек после его инициализации.
//       Неопределено когда настройки варианта не надо загружать (уже загружены ранее).
//   НовыеПользовательскиеНастройкиКД - ПользовательскиеНастройкиКомпоновкиДанных
//                                    - Неопределено -
//       Пользовательские настройки, которые будут загружены в компоновщик настроек после его инициализации.
//       Неопределено когда пользовательские настройки не надо загружать (уже загружены ранее).
//
Процедура ПередЗагрузкойНастроекВКомпоновщик(Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт
	
	Если НЕ ТипЗнч(НовыеНастройкиКД) = Тип("НастройкиКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	
	Организация = Неопределено;
	ПараметрОрганизация = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация"));
	Если ПараметрОрганизация <> Неопределено Тогда  
		НастройкаОрганизация = Неопределено;
		Если НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
			НастройкаОрганизация = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрОрганизация.ИдентификаторПользовательскойНастройки);
		КонецЕсли;	
		Если НастройкаОрганизация = Неопределено Тогда   
			НастройкаОрганизация = НовыеНастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрОрганизация.Параметр);
		КонецЕсли;
		Если НастройкаОрганизация <> Неопределено Тогда 
			Организация = НастройкаОрганизация.Значение;
		Иначе
			Организация = ПараметрОрганизация.Значение;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) Тогда 
		
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ПоВсемОрганизациям", Ложь);
		СтандартныеОтчетыКлиентСервер.УдалитьОтбор(НовыеНастройкиКД, "Организация", Истина);
		
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "НаименованиеУчреждения", Справочники.Организации.ПредставлениеУчреждения(Организация, Ложь));
		СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "Бюджет,КодОКПО");
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "КодОКПО", СвойстваОрганизации.КодОКПО);
		РеквизитыБюджета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СвойстваОрганизации.Бюджет, "НаименованиеПубличноПравовогоОбразования,НаименованиеПолное");  
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "Учредитель", РеквизитыБюджета.НаименованиеПубличноПравовогоОбразования);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "Бюджет", РеквизитыБюджета.НаименованиеПолное);
		
		Подразделение = Неопределено;
		Исполнитель = Неопределено;
		
		ДатаЗначений = ТекущаяДатаСеанса();
		ПараметрДата = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаФормирования")); 
		Если ПараметрДата <> Неопределено Тогда 
			НастройкаДата = Неопределено;
			Если НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
				НастройкаДата = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрДата.ИдентификаторПользовательскойНастройки);
			КонецЕсли;
			Если НастройкаДата = Неопределено Тогда
				НастройкаДата = НовыеНастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрДата.Параметр);
			КонецЕсли;
			Если НастройкаДата <> Неопределено Тогда
				Если ТипЗнч(НастройкаДата.Значение) = Тип("Дата") Тогда
					ДатаЗначений = НастройкаДата.Значение;
				Иначе
					ДатаЗначений = НастройкаДата.Значение.Дата;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
		ПараметрИсполнитель = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Исполнитель"));
		Если ПараметрИсполнитель <> Неопределено Тогда  
			НастройкаИсполнитель = Неопределено;
			Если НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
				НастройкаИсполнитель = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрИсполнитель.ИдентификаторПользовательскойНастройки);  
			КонецЕсли;
			Если НастройкаИсполнитель = Неопределено Тогда
				НастройкаИсполнитель = НовыеНастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрИсполнитель.Параметр);
			КонецЕсли;
			Если НастройкаИсполнитель <> Неопределено Тогда
				Если НЕ ЗначениеЗаполнено(НастройкаИсполнитель.Значение) Тогда
					Исполнитель = СтандартныеОтчеты.ОтветственныйИсполнитель(Организация);
					НастройкаИсполнитель.Значение = Исполнитель;
				Иначе
					Исполнитель = НастройкаИсполнитель.Значение	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
			
		ПараметрПодразделение = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Подразделение"));
		Если ПараметрПодразделение <> Неопределено Тогда   
			НастройкаПодразделение = Неопределено;
			Если НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
				НастройкаПодразделение = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрПодразделение.ИдентификаторПользовательскойНастройки); 
			КонецЕсли;
			Если НастройкаПодразделение = Неопределено Тогда
				НастройкаПодразделение = НовыеНастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрПодразделение.Параметр);
			КонецЕсли;
			Если НастройкаПодразделение <> Неопределено Тогда
				Если НЕ ЗначениеЗаполнено(НастройкаПодразделение.Значение) И ЗначениеЗаполнено(Исполнитель) Тогда
					Подразделение = СтандартныеОтчеты.ПодразделениеИсполнителя(Исполнитель, ДатаЗначений);
					НастройкаПодразделение.Значение = Подразделение;
				Иначе
					Подразделение = НастройкаПодразделение.Значение	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ПараметрГлБухгалтер = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ГлБухгалтер"));
		Если ПараметрГлБухгалтер <> Неопределено Тогда    
			НастройкаГлБухгалтер = Неопределено;
			Если НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
				НастройкаГлБухгалтер = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрГлБухгалтер.ИдентификаторПользовательскойНастройки); 
			КонецЕсли;
			Если НастройкаГлБухгалтер = Неопределено Тогда
				НастройкаГлБухгалтер = НовыеНастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрГлБухгалтер.Параметр);
			КонецЕсли;
			Если НастройкаГлБухгалтер <> Неопределено Тогда
				Если НЕ ЗначениеЗаполнено(НастройкаГлБухгалтер.Значение) Тогда
					ГлБухгалтер = СтандартныеОтчеты.ГлавныйБухгалтер(Организация, ДатаЗначений, Подразделение);
					НастройкаГлБухгалтер.Значение = ГлБухгалтер;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
		
		НаименованиеПодразделения = "";
		Если ЗначениеЗаполнено(Подразделение) И ОбщегоНазначения.СсылкаСуществует(Подразделение) Тогда    
			ПараметрыПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Подразделение, "НаименованиеПолное,Наименование,ОбособленноеПодразделение");
			Если ПараметрыПодразделения.ОбособленноеПодразделение И ЗначениеЗаполнено(ПараметрыПодразделения.НаименованиеПолное) Тогда
				НаименованиеПодразделения =	ПараметрыПодразделения.НаименованиеПолное;
			Иначе
				НаименованиеПодразделения =	ПараметрыПодразделения.Наименование;
			КонецЕсли;
		КонецЕсли;
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "НаименованиеПодразделения", НаименованиеПодразделения);
		
	Иначе
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "НаименованиеУчреждения", "");
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "КодОКПО", "");
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "Учредитель", "");
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "Бюджет", "");
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "НаименованиеПодразделения", "");
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "Исполнитель", "");
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "Подразделение", "");
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ГлБухгалтер", "");
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ПоВсемОрганизациям", ИСТИНА);
	КонецЕсли;	
	
	ЕстьПоказатель = Ложь;
	ЕстьРазделитель = Ложь;
	ПараметрЖурнал = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("НомерЖурнала")); 
	НастройкаЖурнал = Неопределено;
	Если НЕ ПараметрЖурнал = Неопределено Тогда
		Если НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
			НастройкаЖурнал = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрЖурнал.ИдентификаторПользовательскойНастройки);
		КонецЕсли; 
		Если НастройкаЖурнал = Неопределено Тогда
			НастройкаЖурнал = НовыеНастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрЖурнал.Параметр);
		КонецЕсли;
	КонецЕсли;
	Если НастройкаЖурнал <> Неопределено Тогда
		
		Журнал = НастройкаЖурнал.Значение;	
		
		МежотчетныйПериод = Журнал.МежотчетныйПериод;
		
		ЕстьПоказатель = ЗначениеЗаполнено(Журнал.ПоказательСтрока);
		ЕстьРазделитель = ЗначениеЗаполнено(Журнал.РазделительСтрока);
		СтруктураПоказателя = Новый Структура("ПоказательСтрока, ЭтоСубконто, ТипПоказателя, ТипРеквизита", Журнал.ПоказательСтрока, Ложь, Журнал.Показатель);
		СтруктураПоказателя = Справочники.Журналы.ЗаполнитьПоказательПоСтроке(СтруктураПоказателя);
		СтруктураРазделителя = Новый Структура("ПоказательСтрока, ЭтоСубконто, ТипПоказателя, ТипРеквизита", Журнал.РазделительСтрока, Ложь, Журнал.РазделительОпераций); 
		СтруктураРазделителя = Справочники.Журналы.ЗаполнитьПоказательПоСтроке(СтруктураРазделителя);
		
		Для Каждого ЭлементНастройки Из СхемаКомпоновкиДанных.НаборыДанных.НачальныеОстатки.Поля Цикл
			Если ЭлементНастройки.Поле = "Показатель" Тогда
				ЭлементНастройки.ТипЗначения = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(СтруктураПоказателя.ТипРеквизита)));
			ИначеЕсли ЭлементНастройки.Поле = "Разделитель" Тогда
				ЭлементНастройки.ТипЗначения = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(СтруктураРазделителя.ТипРеквизита)));
			КонецЕсли;
		КонецЦикла;	 
		ЕстьПоказатель = ЗначениеЗаполнено(Журнал.ПоказательСтрока);
		ЕстьРазделитель = ЗначениеЗаполнено(Журнал.РазделительСтрока);
		
		ГруппироватьПоРазделителю = Ложь;
		РазделительВГруппировке = Ложь;
		
		ПараметрГруппироватьПоРазделителю = НовыеНастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ГруппироватьПоРазделителю"));
		Если НЕ ПараметрГруппироватьПоРазделителю = Неопределено Тогда 
			НастройкаГруппировакаПоРазделителю = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрГруппироватьПоРазделителю.ИдентификаторПользовательскойНастройки);
			Если НастройкаГруппировакаПоРазделителю <> Неопределено Тогда
				ГруппироватьПоРазделителю = НастройкаГруппировакаПоРазделителю.Значение И ЕстьРазделитель; 
			Иначе
				ГруппироватьПоРазделителю = ПараметрГруппироватьПоРазделителю.Значение И ЕстьРазделитель;
			КонецЕсли; 
			Если ГруппироватьПоРазделителю Тогда
				Если НовыеНастройкиКД.Отбор.Элементы.Количество() = 0 
					ИЛИ НЕ НовыеНастройкиКД.Отбор.Элементы.Получить(0).ИдентификаторПользовательскойНастройки = "ОтборПоРазделителю" Тогда
					ОтборРазделитель = НовыеНастройкиКД.Отбор.Элементы.Вставить(0, Тип("ЭлементОтбораКомпоновкиДанных")); 
					ОтборРазделитель.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Разделитель");  
					ОтборРазделитель.Применение = ТипПримененияОтбораКомпоновкиДанных.Элементы; 
					ОтборРазделитель.ИдентификаторПользовательскойНастройки = "ОтборПоРазделителю";
					ОтборРазделитель.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
					ОтборРазделитель.Использование = Ложь;
				КонецЕсли;
			Иначе
				Если НовыеНастройкиКД.Отбор.Элементы.Количество() > 0 Тогда 
					ОтборРазделитель = НовыеНастройкиКД.Отбор.Элементы.Получить(0);
					Если ОтборРазделитель.ИдентификаторПользовательскойНастройки = "ОтборПоРазделителю" Тогда
						НовыеНастройкиКД.Отбор.Элементы.Удалить(ОтборРазделитель);
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
			ПараметрГруппироватьПоРазделителю.РежимОтображения = ?(ЕстьРазделитель, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		КонецЕсли;
		
		ПараметрПериод = НовыеНастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
		
		Если ПараметрПериод <> Неопределено И НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
			НастройкаПериод = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрПериод.ИдентификаторПользовательскойНастройки);
			Если НастройкаПериод <> Неопределено Тогда
				ЗначениеПериод = НастройкаПериод.Значение; 
				Если МежотчетныйПериод Тогда
					ЗначениеПериод.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
					ЗначениеПериод.ДатаНачала = КонецГода(ЗначениеПериод.ДатаНачала);
					ЗначениеПериод.ДатаОкончания = КонецГода(ЗначениеПериод.ДатаНачала);
					
					ГраницаНачало = Бухгалтерскийучет.НачалоПериодаСУточнением(
					?(ЗначениеЗаполнено(ЗначениеПериод.ДатаОкончания), ЗначениеПериод.ДатаОкончания, Дата(3999, 12, 31)),  
					ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ИзменениеВалютыБаланса"), Истина);
					
					ГраницаКонец = Бухгалтерскийучет.КонецПериодаСУточнением(
					?(ЗначениеЗаполнено(ЗначениеПериод.ДатаОкончания), ЗначениеПериод.ДатаОкончания, Дата(3999, 12, 31)),  
					ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ИзменениеВалютыБаланса"));
				Иначе
					ГраницаНачало 	= ?(ЗначениеЗаполнено(ЗначениеПериод.ДатаНачала), НачалоДня(ЗначениеПериод.ДатаНачала), Дата(1, 1, 1));
					ГраницаКонец 	= ?(ЗначениеЗаполнено(ЗначениеПериод.ДатаОкончания),
					Бухгалтерскийучет.КонецПериодаСУточнением(ЗначениеПериод.ДатаОкончания, ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ЗаключениеСчетов")),
					Дата(3999, 12, 31));
				КонецЕсли;	
				СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "НачалоПериода", ГраницаНачало);
				СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "КонецПериода", ГраницаКонец);
			КонецЕсли;
		КонецЕсли;
		
		СворачиватьОднотипныеПроводки = Ложь;
		ПараметрСворачиватьОднотипныеПроводки = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("СворачиватьОднотипныеПроводки"));
		НастройкаСворачиватьОднотипныеПроводки = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрСворачиватьОднотипныеПроводки.ИдентификаторПользовательскойНастройки);
		Если НастройкаСворачиватьОднотипныеПроводки <> Неопределено Тогда
			СворачиватьОднотипныеПроводки = НастройкаСворачиватьОднотипныеПроводки.Значение; 	
		КонецЕсли;
		
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ВидСубконтоПоказатель", СтруктураПоказателя.ТипПоказателя);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ВидСубконтоРазделитель", СтруктураРазделителя.ТипПоказателя);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ОстаткиВРазрезеПоказателя", Журнал.ОстаткиВРазрезеПоказателя);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ВыбиратьСНомеромЖурналаСчета", Журнал.ВыбиратьПроводкиСНомеромЖурналаСчета);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ВыбиратьСНомеромЖурнала", Истина);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "НеВыбиратьИзСпискаЖО", НЕ Журнал.ВыбиратьИзСпискаЖО.Количество());
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "НеВыводитьОстатки", Журнал.НеВыводитьОстатки);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "НеВыводитьОстаткиПоКЭК", Журнал.НеВыводитьОстаткиПоКЭК);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "МежотчетныйПериод", МежотчетныйПериод); 
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ГруппироватьПоРазделителю", ГруппироватьПоРазделителю); 
		
		СписокЖО = Новый СписокЗначений;
		Если Журнал.ВыбиратьИзСпискаЖО.Количество() Тогда
			МассивЖО = Журнал.ВыбиратьИзСпискаЖО.ВыгрузитьКолонку("Журнал");
			Для Каждого ЖО из МассивЖО Цикл
				СписокЖО.Добавить(Справочники.Журналы.НайтиПоКоду(ЖО));
			КонецЦикла;
		КонецЕсли;
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "СписокЖурналовОпераций", СписокЖО);
		
		ЖурОп = "Журнал операций ";
		Жур = "Журнал ";
		ДлинаВырезания = 0;
		Если Найти(Журнал.Наименование, ЖурОп) Тогда
			ДлинаВырезания = СтрДлина(ЖурОп);
		ИначеЕсли Найти(Журнал.Наименование, Жур) Тогда
			ДлинаВырезания = СтрДлина(Жур);
		КонецЕсли;
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ОписаниеЖурнала", Сред(Журнал.Наименование, ДлинаВырезания + 1));
		
		Если НовыеНастройкиКД.Структура[0].Структура[0].Структура.Количество() < 4 Тогда
			// старая СКД  
			ИспользуемыйВариант = ВариантыОтчетов.ВариантОтчета(ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Отчет.ЖурналОпераций"), КлючВарианта);
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Настройки варианта отчета ""%1"" не соответсвуют схеме. Возможно некорректное отображение данных. 
			|Рекомендуется внести изменения в настройки варианта отчета.'"),
			ИспользуемыйВариант);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Иначе	
			// Выводить/не_выводить обороты главной книги 
			НовыеНастройкиКД.Структура[0].Структура[0].Структура[1].Использование = Журнал.ВыводитьОборотыГлавнойКниги И НЕ Журнал.ОборотыГлавнойКнигиБезКорреспонденции;
			НовыеНастройкиКД.Структура[0].Структура[0].Структура[2].Использование = Журнал.ВыводитьОборотыГлавнойКниги И Журнал.ОборотыГлавнойКнигиБезКорреспонденции;
			НовыеНастройкиКД.Структура[0].Структура[0].Структура[3].Использование = Журнал.ВыводитьОборотыГлавнойКниги И Журнал.ОборотыГлавнойКнигиБезКорреспонденции;
		КонецЕсли;
		
		ОбщийМодульСКД.ДополнитьОтборНастроекКД(НовыеНастройкиКД.Отбор.Элементы, НовыеПользовательскиеНастройкиКД.Элементы);
		ТекстОтбор = СтандартныеОтчеты.ПолучитьТекстОтбора(НовыеНастройкиКД.Отбор, Неопределено);
		Если ЗначениеЗаполнено(ТекстОтбор) Тогда
			ТекстОтбор = "Примечание. В документе отражены данные, отвечающие условиям: " +  ТекстОтбор;
		КонецЕсли;
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыеНастройкиКД, "ТекстОтбор", ТекстОтбор);
		
	Иначе
		Возврат;
	КонецЕсли;
	
	НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.НачальныеОстатки; //Начало Субконто"
	ТекстЗапроса = НаборДанных.Запрос;
	
	// Группировки..... 
	СписокГруппировок = Новый СписокЗначений;
	ПараметрГруппировка = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ГруппировкиПользователя")); 
	Если ПараметрГруппировка <> Неопределено Тогда
		НастройкаГруппировка = Неопределено;
		Если НовыеПользовательскиеНастройкиКД <> Неопределено Тогда
			НастройкаГруппировка = НовыеПользовательскиеНастройкиКД.Элементы.Найти(ПараметрГруппировка.ИдентификаторПользовательскойНастройки); 
		КонецЕсли;
		Если НастройкаГруппировка = Неопределено Тогда
			НастройкаГруппировка = НовыеНастройкиКД.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрГруппировка.Параметр);
		КонецЕсли;
		Если НастройкаГруппировка <> Неопределено Тогда
			Если НастройкаГруппировка.Использование И ЗначениеЗаполнено(НастройкаГруппировка.Значение) Тогда 
				Если ТипЗнч(НастройкаГруппировка.Значение) = Тип("Строка") Тогда
					СписокГруппировок.Добавить(НастройкаГруппировка.Значение);
				Иначе
					СписокГруппировок = НастройкаГруппировка.Значение.Скопировать();	
				КонецЕсли; 
			Иначе
				НастройкаГруппировка.Использование = Ложь;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если СписокГруппировок.Количество() > 0 Тогда
		
		НомерГруппировки = 1;
		Структура = НовыеНастройкиКД.Структура[0].Структура[0].Структура[0];
		Структура.Структура.Очистить(); // удаляем 3 группировки
		ГруппировкаБезИтогов = Ложь;
		РазделительВГруппировке = Ложь;
		
		Для каждого ГруппировкаОтчета из СписокГруппировок Цикл
			
			Если ГруппировкаОтчета.Значение = "РазделительДанных" Тогда 
				Если ГруппироватьПоРазделителю Или НЕ ЕстьРазделитель Тогда
					Продолжить;
				Иначе
					РазделительВГруппировке = Истина;
				КонецЕсли;
			КонецЕсли;	
			
			Структура = Структура.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
			Структура.Имя = "Группировка" + НомерГруппировки;
			СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(Структура, "РасположениеИтогов", РасположениеИтоговКомпоновкиДанных.Нет);
			СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(Структура, "ВертикальноеРасположениеОбщихИтогов", РасположениеИтоговКомпоновкиДанных.Нет);
			ПолеГруппировки = Структура.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			ПолеГруппировки.Использование  = Истина;
			ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ГруппировкаОтчета.Значение);
			
			Если НЕ ПоляБезГруппировкиИтогов.Найти(ГруппировкаОтчета.Значение) = Неопределено Тогда
				
				ГруппировкаБезИтогов = Истина;
				
				ГруппаОтбора = Структура.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
				ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаОтбора, "Сумма", 0, ВидСравненияКомпоновкиДанных.НеРавно);
				СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаОтбора, "ДвиженияИлиГраницаПериода", 0, ВидСравненияКомпоновкиДанных.Равно);
				
				СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(Структура, "ВыводитьОтбор", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
				
			КонецЕсли;
			
			Если ГруппировкаОтчета.Значение = "Показатель" ИЛИ ГруппировкаОтчета.Значение = "РазделительДанных" Тогда   
				
				ГруппаОтбора = Структура.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
