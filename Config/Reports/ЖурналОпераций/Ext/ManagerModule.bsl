#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// Регистры учета

Функция ЭтоРегистрУчета() Экспорт
	Возврат Истина;
КонецФункции	

Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	ПараметрОрганизация = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация"));
	Если НЕ ПараметрОрганизация = Неопределено Тогда
		Организация = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрОрганизация.ИдентификаторПользовательскойНастройки);
		Если НЕ Организация = Неопределено Тогда
			СвойстваРегистраУчета.Вставить("Организация", Организация.Значение);
		КонецЕсли;
	КонецЕсли;

	ПараметрПериод = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	Если НЕ ПараметрПериод = Неопределено Тогда
		Период = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрПериод.ИдентификаторПользовательскойНастройки);
		Если НЕ Период = Неопределено Тогда
			СвойстваРегистраУчета.Вставить("НачалоПериода", Период.Значение.ДатаНачала);
			СвойстваРегистраУчета.Вставить("КонецПериода", 	Период.Значение.ДатаОкончания);
		КонецЕсли;
	КонецЕсли;
	
	ПараметрПодразделение = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Подразделение"));
	Если НЕ ПараметрПодразделение = Неопределено Тогда
		Подразделение = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрПодразделение.ИдентификаторПользовательскойНастройки);
		Если НЕ Подразделение = Неопределено Тогда
			СвойстваРегистраУчета.Вставить("Подразделение", Подразделение.Значение);
		КонецЕсли;
	КонецЕсли;
	
	ПараметрЖурнал = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("НомерЖурнала")); 
	Если НЕ ПараметрЖурнал = Неопределено Тогда
		НомерЖурнала = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрЖурнал.ИдентификаторПользовательскойНастройки);
		Если НЕ НомерЖурнала = Неопределено Тогда
			СвойстваРегистраУчета.Вставить("ДополнениеИмени", " № " + СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НомерЖурнала.Значение, "Код")));
		КонецЕсли;
	КонецЕсли;
				
КонецПроцедуры	

// Регистры учета

// СтандартныеПодсистемы.ВариантыОтчетов

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
		
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;

	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ЖурналОпераций0504071");
	НастройкиВарианта.Описание = НСтр("ru = 'Журнал операций (ф.0504071)'");
	
КонецПроцедуры

// СтандартныеПодсистемы.ВариантыОтчетов

// Возникает после окончания формирования отчета: после завершения фонового задания.
// Позволяет переопределить обработку результата формирования отчета.
//
// Параметры:
//  ФормаОтчета - ФормаКлиентскогоПриложения - форма отчета.
//  ОтчетСформирован - Булево - Истина если отчет был успешно сформирован.
//
Процедура ПослеФормирования(НастройкиОтчета, ТабличныйДокумент, ОтчетСформирован) Экспорт
	
	Если НастройкиОтчета.СвойстваРезультата.КомпоновщикНастроек = Неопределено Тогда // не указаны параметры формирования отчета
		Возврат;
	КонецЕсли;
	
	// Выводим пустой отчет
	
	ТабличныйДокумент.Очистить();
		
	СтруктураПараметров = Новый Структура;
	
	ПараметрыДанных = НастройкиОтчета.СвойстваРезультата.КомпоновщикНастроек.Настройки.ПараметрыДанных;
	
	ЭлементыОтбора = НастройкиОтчета.СвойстваРезультата.КомпоновщикНастроек.Настройки.Отбор.Элементы;
	
	ОбщийМодульСКД.ДополнитьОтборНастроекКД(ЭлементыОтбора, НастройкиОтчета.СвойстваРезультата.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы);
	ТекстОтбор = СтандартныеОтчеты.ПолучитьТекстОтбора(НастройкиОтчета.СвойстваРезультата.КомпоновщикНастроек.Настройки.Отбор, Неопределено);
	Если ЗначениеЗаполнено(ТекстОтбор) Тогда
		ТекстОтбор = "Примечание. В документе отражены данные, отвечающие условиям: " +  ТекстОтбор;
	КонецЕсли;
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НастройкиОтчета.СвойстваРезультата.КомпоновщикНастроек.Настройки, "ТекстОтбор", ТекстОтбор);
									
	Параметр = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("НомерЖурнала"));
	Если НЕ Параметр = Неопределено Тогда
		СтруктураПараметров.Вставить("НомерЖурнала", Параметр.Значение);	
	КонецЕсли;
	
	Параметр = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ОписаниеЖурнала"));
	Если НЕ Параметр = Неопределено Тогда
		СтруктураПараметров.Вставить("ОписаниеЖурнала", Параметр.Значение);	
	КонецЕсли;
	
	Если ЭлементыОтбора.Количество() > 0 Тогда 
		ЭлементОтбора = ЭлементыОтбора[0];	
		Если ЭлементОтбора.ИдентификаторПользовательскойНастройки = "ОтборПоРазделителю" Тогда
			СтруктураПараметров.Вставить("ПоРазделителю", СтандартныеОтчеты.ПредставлениеРазделителя(ЭлементОтбора.ПравоеЗначение));
		КонецЕсли;
	КонецЕсли;	
	
	Параметр = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	Если НЕ Параметр = Неопределено Тогда
		СтруктураПараметров.Вставить("СтрокаПериода", ПредставлениеПериода(Параметр.Значение.ДатаНачала, Параметр.Значение.ДатаОкончания, "ФП"));
		СтруктураПараметров.Вставить("ДатаОтчета", Формат(Параметр.Значение.ДатаОкончания + 1, "ДЛФ=Д"));
		СтруктураПараметров.Вставить("ДатаНачала", Формат(Параметр.Значение.ДатаНачала, "ДЛФ=Д"));
		СтруктураПараметров.Вставить("ДатаОкончания", Формат(Параметр.Значение.ДатаОкончания, "ДЛФ=Д"));
	КонецЕсли;	
				
	Параметр = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("НаименованиеУчреждения"));
	Если НЕ Параметр = Неопределено Тогда
		СтруктураПараметров.Вставить("Учреждение", Параметр.Значение);
	КонецЕсли;	
	
	Параметр = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("КодОКПО"));
	Если НЕ Параметр = Неопределено Тогда
		СтруктураПараметров.Вставить("КодОКПО", Параметр.Значение);
	КонецЕсли;	

	Параметр = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("НаименованиеПодразделения"));
	Если НЕ Параметр = Неопределено Тогда
		СтруктураПараметров.Вставить("Подразделение", Параметр.Значение);	
	КонецЕсли;
	
	Параметр = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Учредитель"));
	Если НЕ Параметр = Неопределено Тогда
		СтруктураПараметров.Вставить("Учредитель", Параметр.Значение);	
	КонецЕсли;
	
	Параметр = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Бюджет"));
	Если НЕ Параметр = Неопределено Тогда
		СтруктураПараметров.Вставить("Бюджет", Параметр.Значение);	
	КонецЕсли;
	
	Параметр = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ТекстОтбор"));
	Если НЕ Параметр = Неопределено Тогда
		СтруктураПараметров.Вставить("Примечание", Параметр.Значение);	
	КонецЕсли;

	ДатаФормирования = ТекущаяДатаСеанса();
	Параметр = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаФормирования"));
	Если НЕ Параметр = Неопределено Тогда
		Если ТипЗнч(Параметр.Значение) = Тип("Дата") Тогда
			ДатаФормирования = Параметр.Значение;
		Иначе
			ДатаФормирования = Параметр.Значение.Дата;
		КонецЕсли;	
	КонецЕсли;
	СтруктураПараметров.Вставить("ТекущаяДата", ДатаФормирования);
	
	Параметр = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ГлБухгалтер"));
	Если НЕ Параметр = Неопределено Тогда
		СтруктураПараметров.Вставить("ГлавБух", Корреспонденты.ФИОПоОбъекту(Параметр.Значение,,ДатаФормирования));	
	КонецЕсли;
	
	Параметр = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Исполнитель"));
	Если НЕ Параметр = Неопределено Тогда
		СтруктураПараметров.Вставить("Исполнитель", Корреспонденты.ФИОПоОбъекту(Параметр.Значение,,ДатаФормирования));
		СтруктураПараметров.Вставить("ИсполнительДолжность", СтандартныеОтчеты.ДолжностьИсполнителя(Параметр.Значение, ДатаФормирования)); 
		СтруктураПараметров.Вставить("ТелефонИсполнителя", СтандартныеОтчеты.ТелефонИсполнителя(Параметр.Значение, ДатаФормирования));
	    СтруктураПараметров.Вставить("ЭлектроннаяПочтаИсполнителя", СтандартныеОтчеты.ЭлПочтаИсполнителя(Параметр.Значение, ДатаФормирования));
	КонецЕсли;
	
	МакетШапки = УправлениеПечатью.МакетПечатнойФормы("Отчет.ЖурналОпераций.МакетФиксированныхОбластей");
	ОбластьПустойОтчет = МакетШапки.ПолучитьОбласть("ПустойОтчет");
	ОбластьПустойОтчет.Параметры.Заполнить(СтруктураПараметров);
	ТабличныйДокумент.Вывести(ОбластьПустойОтчет);
							 
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗагрузитьНастройкиПриИзмененииПараметров() Экспорт 
	
	Параметры = Новый Массив;
	Параметры.Добавить(Новый ПараметрКомпоновкиДанных("НомерЖурнала"));
	Параметры.Добавить(Новый ПараметрКомпоновкиДанных("ГруппироватьПоРазделителю"));
	Параметры.Добавить(Новый ПараметрКомпоновкиДанных("ГруппировкиПользователя"));
	Параметры.Добавить(Новый ПараметрКомпоновкиДанных("Организация"));

	Возврат Параметры; 
	
КонецФункции

Функция ПараметрыРасположенияЭлементовУправления() Экспорт
	
	МассивНастроек              = Новый Массив; 
	
	НастройкиЭлементаУправления = Новый Структура;
	НастройкиЭлементаУправления.Вставить("Поле",                     "НомерЖурнала");
	НастройкиЭлементаУправления.Вставить("РастягиватьПоГоризонтали", Ложь);
	НастройкиЭлементаУправления.Вставить("АвтоМаксимальнаяШирина",   Истина);
	НастройкиЭлементаУправления.Вставить("Ширина",                   12); 
	
	МассивНастроек.Добавить(НастройкиЭлементаУправления);  
	
	НастройкиЭлементаУправления = Новый Структура;
	НастройкиЭлементаУправления.Вставить("Поле",                     "ГруппировкиПользователя");
	НастройкиЭлементаУправления.Вставить("РастягиватьПоГоризонтали", Ложь);
	НастройкиЭлементаУправления.Вставить("АвтоМаксимальнаяШирина",   Истина);
	НастройкиЭлементаУправления.Вставить("Ширина",                   30); 
	
	МассивНастроек.Добавить(НастройкиЭлементаУправления);

	
	НастройкиЭлементовУправления = Новый Структура();
	НастройкиЭлементовУправления.Вставить("ПараметрыДанных", МассивНастроек);
	
	Возврат НастройкиЭлементовУправления;
	
КонецФункции

#КонецОбласти

#КонецЕсли
