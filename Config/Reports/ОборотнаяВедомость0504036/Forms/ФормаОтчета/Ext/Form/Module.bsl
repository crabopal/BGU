&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовка(Форма)
	
	Отчет = Форма.Отчет;
	
	ЗаголовокОтчета = "Оборотная ведомость " + Отчет.Счет + СтандартныеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(Отчет.НачалоПериода, Отчет.КонецПериода,, Отчет.ТипПериода, Отчет.ТолькоУказанныйПериод);

	Если ЗначениеЗаполнено(Отчет.Организация) Тогда
		ЗаголовокОтчета = ЗаголовокОтчета + " " + СтандартныеОтчетыПовтИсп.ПолучитьТекстОрганизация(Отчет.Организация, Отчет.ВключатьОбособленныеПодразделения);
	КонецЕсли;
	
	Форма.Заголовок = ЗаголовокОтчета;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидМежотчетногоПериодаПоДате()
	
	Если НЕ Отчет.КонецПериода = КонецГода(Отчет.КонецПериода) Тогда
		Если ЗначениеЗаполнено(Отчет.ТипПериода) Тогда
			Отчет.ТипПериода = ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ПустаяСсылка");
			Отчет.ТолькоУказанныйПериод = Ложь;
		КонецЕсли;
	КонецЕсли;
	  
	Если НЕ Отчет.НачалоПериода = КонецГода(Отчет.КонецПериода) Тогда
		Отчет.ТолькоУказанныйПериод = Ложь;
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьДатыПоВидуПериода()
	
	Если ЗначениеЗаполнено(Отчет.ТипПериода) Тогда 
		Если НЕ Отчет.КонецПериода = КонецГода(Отчет.КонецПериода) Тогда
			Отчет.КонецПериода = КонецГода(Отчет.КонецПериода);
		КонецЕсли;
		Если Отчет.ТолькоУказанныйПериод И НЕ Отчет.НачалоПериода = КонецГода(Отчет.КонецПериода) Тогда
			Отчет.НачалоПериода = КонецГода(Отчет.КонецПериода)
	    КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Функция ПолучитьЗапрещенныеПоля(Режим = "") Экспорт
	
	СписокПолей = Новый Массив;
	
	СписокПолей.Добавить("UserFields");
	СписокПолей.Добавить("DataParameters");
	СписокПолей.Добавить("SystemFields");
	СписокПолей.Добавить("Показатели");
    СписокПолей.Добавить("ЗаПериод");
	
	Если Режим = "Выбор" Тогда
		Для Каждого ДоступноеПоле Из Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.Элементы Цикл
			Если ДоступноеПоле.Ресурс Тогда
				СписокПолей.Добавить(Строка(ДоступноеПоле.Поле));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отчет.Счет) Тогда 
		КоличествоСубконто = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Отчет.Счет).КоличествоСубконто;
	Иначе
		КоличествоСубконто = 0;
	КонецЕсли;
	Для Индекс = КоличествоСубконто + 1 По 3 Цикл
		СписокПолей.Добавить("Субконто" + Индекс);
	КонецЦикла;
	
	Если НЕ ФОУчетПоПодразделениям Тогда
		СписокПолей.Добавить("Подразделение");
	КонецЕсли;
	
	Если Не ФОУчетПоИФО Тогда
		СписокПолей.Добавить("ИФО");
	КонецЕсли;
	
	Если НЕ ФОВалютныйУчет Тогда
		СписокПолей.Добавить("Валюта");
	КонецЕсли;
	
	Если Режим = "Группировка" Тогда
		// СписокПолей.Добавить("Счет");
		СписокПолей.Добавить("СальдоНаНачалоПериода");
		СписокПолей.Добавить("ОборотыЗаПериод");
		СписокПолей.Добавить("СальдоНаКонецПериода");
	ИначеЕсли Режим = "Выбор" Тогда
		СписокПолей.Добавить("СальдоНаНачалоПериода");
		СписокПолей.Добавить("ОборотыЗаПериод");
		СписокПолей.Добавить("СальдоНаКонецПериода");
	ИначеЕсли Режим = "Отбор" ИЛИ Режим = "Порядок" Тогда
		СтандартныеОтчетыКлиент.ДобавитьПоляРесурсовВЗапрещенныеПоля(ЭтаФорма, СписокПолей);
	КонецЕсли;
	
	Возврат Новый ФиксированныйМассив(СписокПолей);
	
КонецФункции

&НаСервере
Функция ПодготовитьПараметрыОтчета()

	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("ВключатьОбособленныеПодразделения", Отчет.ВключатьОбособленныеПодразделения);
	ПараметрыОтчета.Вставить("КонецПериода"                     , Отчет.КонецПериода);
	ПараметрыОтчета.Вставить("НачалоПериода"                    , Отчет.НачалоПериода);
	ПараметрыОтчета.Вставить("Организация"                      , Отчет.Организация);
	ПараметрыОтчета.Вставить("Подразделение"					, Отчет.Подразделение);
	ПараметрыОтчета.Вставить("ПоСубсчетам"						, Отчет.ПоСубсчетам);
	ПараметрыОтчета.Вставить("Счет"              				, Отчет.Счет);
	ПараметрыОтчета.Вставить("ПоказательБУ"                     , Отчет.ПоказательБУ);
	ПараметрыОтчета.Вставить("РазвернутоеСальдо"				, Отчет.РазвернутоеСальдо);
	ПараметрыОтчета.Вставить("РазмещениеДополнительныхПолей"	, Отчет.РазмещениеДополнительныхПолей);
	ПараметрыОтчета.Вставить("РежимРасшифровки"					, Отчет.РежимРасшифровки);
	ПараметрыОтчета.Вставить("ТипПериода"                 		, Отчет.ТипПериода);
	ПараметрыОтчета.Вставить("ТолькоУказанныйПериод"            , Отчет.ТолькоУказанныйПериод);
	ПараметрыОтчета.Вставить("Исполнитель"						, Отчет.Исполнитель);
	
	ПараметрыОтчета.Вставить("Группировка"						, Отчет.Группировка.Выгрузить());
	ПараметрыОтчета.Вставить("ДополнительныеПоля"				, Отчет.ДополнительныеПоля.Выгрузить());

	ПараметрыОтчета.Вставить("ДанныеРасшифровки"                , ДанныеРасшифровки);
	ПараметрыОтчета.Вставить("ВыводитьЗаголовок"                , ВыводитьЗаголовок);
	ПараметрыОтчета.Вставить("ВыводитьПодвал"                   , ВыводитьПодвал);
	ПараметрыОтчета.Вставить("СхемаКомпоновкиДанных"            , ПолучитьИзВременногоХранилища(СхемаКомпоновкиДанных));
	ПараметрыОтчета.Вставить("ИдентификаторОтчета"              , СтандартныеОтчеты.ИмяОтчетаПоИмениФормы(ЭтаФорма));
	ПараметрыОтчета.Вставить("НастройкиКомпоновкиДанных"        , Отчет.КомпоновщикНастроек.ПолучитьНастройки());
	ПараметрыОтчета.Вставить("НаборПоказателей"                 , Отчеты[ПараметрыОтчета.ИдентификаторОтчета].ПолучитьНаборПоказателей());
	ПараметрыОтчета.Вставить("ВыводитьПолностью"				, Истина);
	ПараметрыОтчета.Вставить("ВысотаШапки"						, 0);

	Возврат ПараметрыОтчета;

КонецФункции

&НаСервере
Процедура ИнициализацияКомпоновщикаНастроек()
	
	СтандартныеОтчеты.ИнициализацияКомпоновщикаНастроекФ(ЭтаФорма, Истина);
	
