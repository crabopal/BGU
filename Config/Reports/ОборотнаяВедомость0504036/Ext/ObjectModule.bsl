// СтандартныеОтчеты

Процедура ПриВыводеЗаголовка(Результат, ВыводитьПолностью) Экспорт

	Макет = ПолучитьМакет("МакетФиксированныхОбластей");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок.Параметры.ДатаОтчета = Формат(КонецДня(КонецПериода) + 1, "ДЛФ=Д");
	ОбластьЗаголовок.Параметры.Организация = Организация.НаименованиеПолное;
	ОбластьЗаголовок.Параметры.ОКПО = Организация.КодОКПО;
	ОбластьЗаголовок.Параметры.Счет = Счет;
	ОбластьЗаголовок.Параметры.Подразделение = Подразделение;
	Попытка
		ОбластьЗаголовок.Параметры.СтрокаПериода = ПредставлениеПериода(НачалоДня(НачалоПериода), КонецДня(КонецПериода), "ФП");
	Исключение
	КонецПопытки;
	Результат.Вывести(ОбластьЗаголовок);
	Результат.Область("R1:R" + Результат.ВысотаТаблицы).Имя = "Заголовок";
	Результат.Области.Заголовок.Видимость = КомпоновщикНастроек.ПолучитьНастройки().ДополнительныеСвойства.ВыводитьЗаголовок;

КонецПроцедуры

Процедура ПриВыводеПодвала(Результат) Экспорт
	
	Макет = ПолучитьМакет("МакетФиксированныхОбластей");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ДанныеСотрудника = Новый Структура(
		"СсылкаНаОбъект,Период,Фамилия,Имя,Отчество,Должность",
		Исполнитель, ТекущаяДатаСеанса(), "", "", "", "");
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина, Истина);
	
	СтруктураОблПодвал = Новый Структура();
	СтруктураОблПодвал.Вставить("ФИОИсполнитель", Справочники.Сотрудники.ФамилияИО(Исполнитель, Истина, ТекущаяДатаСеанса()));
	СтруктураОблПодвал.Вставить("ДолжностьИсполнитель", ДанныеСотрудника.Должность); 
	СтруктураОблПодвал.Вставить("ТелeфонИсполнитель", ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
	СтруктураОблПодвал.Вставить("ЭлектроннаяПочтаИсполнитель", ДанныеСотрудника.EmailФизическиеЛица); 
	СтруктураОблПодвал.Вставить("ТекущаяДата", Формат(ТекущаяДатаСеанса(), "ДЛФ=ДДММММГГГГ"));
		
	ОбластьПодвал.Параметры.Заполнить(СтруктураОблПодвал);
	
	Высота = Результат.ВысотаТаблицы + 1;
	Результат.Вывести(ОбластьПодвал);
	Результат.Область(Высота, ,Результат.ВысотаТаблицы,).Имя = "Подписи";
	Результат.Области.Подписи.Видимость = КомпоновщикНастроек.ПолучитьНастройки().ДополнительныеСвойства.ВыводитьПодвал;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	СтандартныеОтчеты.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
	НомерГруппировкиДоговор = 0;
	НомерГруппировкиДатаИсполнения = 0;
	НомерГруппировкиКЭК = 0;
	Сч = 0;
	Для Каждого ТекущаяГруппировка Из Группировка Цикл
		
		Если Не ТекущаяГруппировка.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		Сч = Сч + 1;
		
		Если ТекущаяГруппировка.Поле = "Субконто2" Тогда
			НомерГруппировкиДоговор = Сч;
		ИначеЕсли ТекущаяГруппировка.Поле = "ДатаИсполнения" Тогда
			НомерГруппировкиДатаИсполнения = Сч;
		ИначеЕсли ТекущаяГруппировка.Поле = "КЭК" Тогда
			НомерГруппировкиКЭК = Сч;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НомерГруппировкиКЭК > 0 И НомерГруппировкиДатаИсполнения > 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не поддерживается одновременная детализация данных в разрезе КЭК и дат исполнения (погашения) задолженности.
			|Необходимо отключить одну из группировок: ""КЭК"", ""Дата исполнения"" (по кнопке ""Настройки"", раздел ""Группировка"").'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Группировка", , Отказ);
	КонецЕсли;
	
	Если НомерГруппировкиДатаИсполнения > 0 И НомерГруппировкиДоговор = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Группировка в разрезе дат исполнения (погашения) задолженности возможна только при детализации данных по договорам (правовым основаниям).
			|Необходимо включить группировку ""Договор"" (по кнопке ""Настройки"", раздел ""Группировка"").'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Группировка", , Отказ);
	КонецЕсли;
	
	Если НомерГруппировкиДатаИсполнения > 0 И НомерГруппировкиДоговор > НомерГруппировкиДатаИсполнения Тогда
		ТекстСообщения = НСтр("ru = 'Группировка по договорам (правовым основаниям) должна предшествовать группировке по датам исполнения (погашения) задолженности.
			|Необходимо переместить группировку ""Договор"" выше группировки ""Дата исполнения"" (по кнопке ""Настройки"", раздел ""Группировка"").'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Группировка", , Отказ);
	КонецЕсли;
	
КонецПроцедуры

