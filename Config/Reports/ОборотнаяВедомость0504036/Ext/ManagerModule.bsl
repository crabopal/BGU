#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеОтчеты

// Задает набор показателей, которые позволяет анализировать отчет.
//
// Возвращаемое значение:
//   Массив      - основные суммовые показатели отчета.
//
Функция ПолучитьНаборПоказателей() Экспорт
	
	НаборПоказателей = Новый Массив;
	НаборПоказателей.Добавить("БУ");
	
	Возврат НаборПоказателей;
	
КонецФункции

Функция ПолучитьПараметрыИсполненияОтчета() Экспорт
	
	Возврат Новый Структура(
		"ИспользоватьПередКомпоновкойМакета,
		|ИспользоватьПослеКомпоновкиМакета,
		|ИспользоватьПриВыводеЗаголовка,
		|ИспользоватьПередВыводомЭлементаРезультата,
		|ИспользоватьПослеВыводаРезультата,
		|ВыводитьОтладочнуюИнформацию,
		|ИспользоватьПриВыводеПодвала,
		|ИспользоватьДанныеРасшифровки,
		|ИспользоватьПривилегированныйРежим",
		Истина, Истина, Истина, Истина, Истина, Истина, Истина, Истина, Истина);
	
КонецФункции

Процедура ПриВыводеЗаголовка(ПараметрыОтчета, КомпоновщикНастроек, Результат) Экспорт

	Макет = ПолучитьМакет("МакетФиксированныхОбластей");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок.Параметры.ДатаОтчета = Формат(КонецДня(ПараметрыОтчета.КонецПериода) + 1, "ДЛФ=Д");
	ОбластьЗаголовок.Параметры.Организация = ПараметрыОтчета.Организация.НаименованиеПолное;
	ОбластьЗаголовок.Параметры.ОКПО = ПараметрыОтчета.Организация.КодОКПО;
	ОбластьЗаголовок.Параметры.Счет = ПараметрыОтчета.Счет;
	ОбластьЗаголовок.Параметры.Подразделение = ПараметрыОтчета.Подразделение;
	Попытка
		ОбластьЗаголовок.Параметры.СтрокаПериода = ПредставлениеПериода(НачалоДня(ПараметрыОтчета.НачалоПериода), КонецДня(ПараметрыОтчета.КонецПериода), "ФП");
	Исключение
	КонецПопытки;
	Результат.Вывести(ОбластьЗаголовок);
	Результат.Область("R1:R" + Результат.ВысотаТаблицы).Имя = "Заголовок";
	Результат.Области.Заголовок.Видимость = КомпоновщикНастроек.ПолучитьНастройки().ДополнительныеСвойства.ВыводитьЗаголовок;

КонецПроцедуры

Процедура ПриВыводеПодвала(ПараметрыОтчета, КомпоновщикНастроек, Результат) Экспорт
	
	Макет = ПолучитьМакет("МакетФиксированныхОбластей");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ДанныеСотрудника = Новый Структура(
		"СсылкаНаОбъект,Период,Фамилия,Имя,Отчество,Должность",
		ПараметрыОтчета.Исполнитель, ТекущаяДатаСеанса(), "", "", "", "");
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина, Истина);
	
	СтруктураОблПодвал = Новый Структура();
	СтруктураОблПодвал.Вставить("ФИОИсполнитель", Справочники.Сотрудники.ФамилияИО(ПараметрыОтчета.Исполнитель, Истина, ТекущаяДатаСеанса()));
	СтруктураОблПодвал.Вставить("ДолжностьИсполнитель", ДанныеСотрудника.Должность); 
	СтруктураОблПодвал.Вставить("ТелeфонИсполнитель", ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
	СтруктураОблПодвал.Вставить("ЭлектроннаяПочтаИсполнитель", ДанныеСотрудника.EmailФизическиеЛица); 
	СтруктураОблПодвал.Вставить("ТекущаяДата", Формат(ТекущаяДатаСеанса(), "ДЛФ=ДДММММГГГГ"));
		
	ОбластьПодвал.Параметры.Заполнить(СтруктураОблПодвал);
	
	Высота = Результат.ВысотаТаблицы + 1;
	Результат.Вывести(ОбластьПодвал);
	Результат.Область(Высота, ,Результат.ВысотаТаблицы,).Имя = "Подписи";
	Результат.Области.Подписи.Видимость = КомпоновщикНастроек.ПолучитьНастройки().ДополнительныеСвойства.ВыводитьПодвал;
	
КонецПроцедуры

Функция ПолучитьВнешниеНаборыДанных(ПараметрыОтчета, Схема, КомпоновщикНастроек) Экспорт
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("АнализЗадолженности",
		ВнешнийНаборДанныхАнализЗадолженности(ПараметрыОтчета, Схема, КомпоновщикНастроек));
	
	Возврат ВнешниеНаборыДанных;
	
КонецФункции

// В процедуре можно доработать компоновщик перед выводом в отчет
// Изменения сохранены не будут
Процедура ПередКомпоновкойМакета(ПараметрыОтчета, Схема, КомпоновщикНастроек) Экспорт
	
    Если НЕ КомпоновщикНастроек.Настройки.Структура.Количество() ИЛИ
        Тип(КомпоновщикНастроек.Настройки.Структура[0]) <> Тип("ТаблицаКомпоновкиДанных")
    Тогда
        // неверные начальные настройки СКД
        Возврат;
    КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Счет", ПараметрыОтчета.Счет);
    ВидСчет = 0;
    Если ПараметрыОтчета.Счет.Вид = ВидСчета.Активный Тогда
        ВидСчет = 1;
    ИначеЕсли ПараметрыОтчета.Счет.Вид = ВидСчета.Пассивный Тогда
        ВидСчет = -1;
    КонецЕсли; 
    СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ВидСчета", ВидСчет);
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.НачалоПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода", НачалоДня(ПараметрыОтчета.НачалоПериода));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.КонецПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода",
			Бухгалтерскийучет.КонецПериодаСУточнением(
				КонецДня(ПараметрыОтчета.КонецПериода), ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ЗаключениеСчетов")));
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПараметрПериод", НачалоМесяца(ПараметрыОтчета.КонецПериода));
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаОстаткаНаКонец", КонецДня(ПараметрыОтчета.КонецПериода) + 1);
	Иначе
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода",
			Бухгалтерскийучет.КонецПериодаСУточнением(КонецДня(ТекущаяДата()), ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ЗаключениеСчетов")));
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПараметрПериод", НачалоМесяца(ТекущаяДата()));
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ДатаОстаткаНаКонец", КонецДня(ТекущаяДата()) + 1);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОтчета.Подразделение) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек, "Подразделение", ПараметрыОтчета.Подразделение,,, Истина);
    КонецЕсли;
    
        // Набиваем выбранные поля Период 
    ГруппаПериод = КомпоновщикНастроек.Настройки.Выбор;
    ГруппаПериод.Элементы.Очистить();
    АП = (ПараметрыОтчета.Счет.Вид = ВидСчета.АктивноПассивный);
    СтандартныеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаПериод, "СальдоНаНачалоПериода.БУНачальный" + ?(АП, "Развернутый", "") + "ОстатокДт");
    СтандартныеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаПериод, "СальдоНаНачалоПериода.БУНачальный" + ?(АП, "Развернутый", "") + "ОстатокКт");
    СтандартныеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаПериод, "ОборотыЗаПериод.БУОборотДт");
    СтандартныеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаПериод, "ОборотыЗаПериод.БУОборотКт");
    // и ПериодКонОст
    ГруппаПериод = КомпоновщикНастроек.Настройки.Структура[0].Колонки[1].Выбор;
    ГруппаПериод.Элементы.Очистить();
    СтандартныеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаПериод, "СальдоНаКонецПериода.БУКонечный" + ?(АП, "Развернутый", "") + "ОстатокДт");
    СтандартныеОтчетыКлиентСервер.ДобавитьВыбранноеПоле(ГруппаПериод, "СальдоНаКонецПериода.БУКонечный" + ?(АП, "Развернутый", "") + "ОстатокКт");
	
	// Удаляем все строки - группировки
    Структура = КомпоновщикНастроек.Настройки.Структура[0].Строки;
    Структура.Очистить();
    
    НомерГруппировки = 0;
    Для Каждого ПолеВыбраннойГруппировки Из ПараметрыОтчета.Группировка Цикл 
        Если ПолеВыбраннойГруппировки.Использование Тогда
            НомерГруппировки = НомерГруппировки + 1;
            Если Тип(Структура) = Тип("КоллекцияЭлементовСтруктурыТаблицыКомпоновкиДанных") Тогда
                Структура = Структура.Добавить();
            Иначе
                Структура = Структура.Структура.Добавить();
            КонецЕсли; 
            Структура.Имя = "Группировка" + НомерГруппировки;
            
            ПолеГруппировки = Структура.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
            ПолеГруппировки.Использование  = Истина;
            ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных(ПолеВыбраннойГруппировки.Поле);
            Если ПолеВыбраннойГруппировки.ТипГруппировки = Перечисления.ТипыДетализацииСтандартныхОтчетов.Иерархия Тогда
                ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
            ИначеЕсли ПолеВыбраннойГруппировки.ТипГруппировки = Перечисления.ТипыДетализацииСтандартныхОтчетов.ТолькоИерархия Тогда
                ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.ТолькоИерархия;
            Иначе
                ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
            КонецЕсли;
            Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
            Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
            
            Для каждого МакетГруппировки Из Схема.МакетыГруппировок Цикл
                Если
                    МакетГруппировки.ИмяГруппировки = Структура.Имя И
                    МакетГруппировки.ТипМакета = ТипМакетаОбластиКомпоновкиДанных.Заголовок
                Тогда
                    Макет = Схема.Макеты.Найти(МакетГруппировки.Макет);
                    Если Макет <> Неопределено Тогда
                        Если ПолеВыбраннойГруппировки.Поле = "КЭК" Тогда
                            Макет.Параметры.Код.Выражение = "Представление(КЭК)";
                            Макет.Параметры.Наименование.Выражение = """""";
                        ИначеЕсли ПолеВыбраннойГруппировки.Поле = "КПС" Тогда
                            Макет.Параметры.Код.Выражение = """""";
                            Макет.Параметры.Наименование.Выражение = "Представление(КПС)";
                        ИначеЕсли ПолеВыбраннойГруппировки.Поле = "КФО" Тогда
                            Макет.Параметры.Код.Выражение = """""";
                            Макет.Параметры.Наименование.Выражение = "Представление(КФО)";
                        ИначеЕсли ПолеВыбраннойГруппировки.Поле = "ДатаИсполнения" Тогда
                            Макет.Параметры.Код.Выражение = """""";
                            Макет.Параметры.Наименование.Выражение = "ВЫБОР КОГДА ЗначениеЗаполнено(ДатаИсполнения) ТОГДА Формат(ДатаИсполнения, ""ДЛФ=Д"") ИНАЧЕ ""<не указано>"" КОНЕЦ";
                        Иначе
                            Макет.Параметры.Код.Выражение = ПолеВыбраннойГруппировки.Поле + ".Код";
                            Макет.Параметры.Наименование.Выражение = ПолеВыбраннойГруппировки.Поле + ".Наименование";
                        КонецЕсли;
                            // Дополнительные данные
                        Для Каждого ПолеГруппировки Из ПараметрыОтчета.ДополнительныеПоля Цикл 
                            Если ПолеГруппировки.Использование Тогда
                                    // В дополнительном поле нашли с первой позиции "КЭК."
                                Если СтрНайти(ПолеГруппировки.Поле, ПолеВыбраннойГруппировки.Поле + ".")  = 1 Тогда
                                    Макет.Параметры.Наименование.Выражение = Макет.Параметры.Наименование.Выражение + " + "", 
                                    |"" + Представление(" + ПолеГруппировки.Поле + ")";
                                КонецЕсли;
                            КонецЕсли;
                        КонецЦикла;
                    КонецЕсли;
                    Прервать;
                КонецЕсли; 
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    
    Если НомерГруппировки  = 0 Тогда
        Структура = Структура.Добавить();
        Структура.Имя = "Группировка" + НомерГруппировки;
        ПолеГруппировки = Структура.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
        ПолеГруппировки.Использование  = Истина;
        Структура.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
        Структура.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
    КонецЕсли; 
	
	СтандартныеОтчеты.ДобавитьОтборПоОрганизацииФ(ПараметрыОтчета, КомпоновщикНастроек);
	
КонецПроцедуры

Процедура ПослеКомпоновкиМакета(ПараметрыОтчета, МакетКомпоновки) Экспорт
	
    ПараметрыОтчета.ВысотаШапки = 2;
    Возврат;
	
КонецПроцедуры

Процедура ПередВыводомЭлементаРезультата(ПараметрыОтчета, МакетКомпоновки, ДанныеРасшифровки, ЭлементРезультата, Отказ = Ложь) Экспорт
	
КонецПроцедуры

Процедура ПослеВыводаРезультата(ПараметрыОтчета, Результат) Экспорт
	
	СтандартныеОтчеты.ОбработкаРезультатаОтчетаФ(ПараметрыОтчета.ИдентификаторОтчета, Результат);

	Если Результат.Области.Найти("Заголовок") = Неопределено Тогда
		Результат.ФиксацияСверху = ПараметрыОтчета.ВысотаШапки;
	Иначе
		Результат.ФиксацияСверху = Результат.Области.Заголовок.Низ + ПараметрыОтчета.ВысотаШапки;
	КонецЕсли;
	
КонецПроцедуры

// СтандартныеОтчеты

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ЭтоРегистрУчета() Экспорт
	
	Возврат Истина;
	
КонецФункции	

Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	СтандартныеОтчеты.СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета);
	
КонецПроцедуры	

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ОборотнаяВедомость");
	НастройкиВарианта.Описание = НСтр("ru = 'Оборотная ведомость (ф. 0504036), данные аналогичны Оборотно-сальдовой ведомости по счету'");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВнешнийНаборДанныхАнализЗадолженности(ПараметрыОтчета, Схема, КомпоновщикНастроек)
	
	// Общая таблица анализа задолженности по всем периодам (месяцам), включенным в отчет.
	АнализЗадолженностиОбщий = КонтрольИсполненияДоговоров.НовыйАнализЗадолженности();
	ОписаниеТипаСумм = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	АнализЗадолженностиОбщий.Колонки.Добавить("ЗадолженностьНачальныйОстатокДт", ОписаниеТипаСумм);
	АнализЗадолженностиОбщий.Колонки.Добавить("ЗадолженностьНачальныйОстатокКт", ОписаниеТипаСумм);
	АнализЗадолженностиОбщий.Колонки.Добавить("ЗадолженностьКонечныйОстатокДт",  ОписаниеТипаСумм);
	АнализЗадолженностиОбщий.Колонки.Добавить("ЗадолженностьКонечныйОстатокКт",  ОписаниеТипаСумм);
	АнализЗадолженностиОбщий.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	
	ГруппировкаДатаИсполнения = ПараметрыОтчета.Группировка.Найти("ДатаИсполнения", "Поле");
	ГруппировкаДатаИсполненияУстановлена = (ГруппировкаДатаИсполнения <> Неопределено И ГруппировкаДатаИсполнения.Использование);
	
	Если ГруппировкаДатаИсполненияУстановлена Тогда
		
			// Остатки и обороты по счету, аналогичные тем, которые выбираются запросом в ОсновнойНаборДанных в СКД.
			// Выбираем периоды и аналитику для анализа задолженности. Затем присоединяем анализ задолженности к ОсновнойНаборДанных в СКД.
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиИОбороты.Счет КАК СчетРасчетов,
			|	ОстаткиИОбороты.Организация КАК Организация,
			|	ВЫРАЗИТЬ(ОстаткиИОбороты.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
			|	ВЫРАЗИТЬ(ОстаткиИОбороты.Субконто2 КАК Справочник.Договоры) КАК Договор,
			|	ОстаткиИОбороты.ИФО КАК ИФО,
			|	ОстаткиИОбороты.КФО КАК КФО,
			|	ОстаткиИОбороты.КПС КАК КПС,
			|	ВЫБОР
			|		КОГДА ОстаткиИОбороты.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|			ТОГДА &ВалютаРеглУчета
			|		ИНАЧЕ ЕСТЬNULL(ОстаткиИОбороты.Валюта, &ВалютаРеглУчета)
			|	КОНЕЦ КАК Валюта,
			|	ОстаткиИОбороты.Период КАК Период,
			|	ОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокДт КАК БУНачальныйРазвернутыйОстатокДт,
			|	ОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокКт КАК БУНачальныйРазвернутыйОстатокКт,
			|	ОстаткиИОбороты.СуммаОборотДт КАК БУОборотДт,
			|	ОстаткиИОбороты.СуммаОборотКт КАК БУОборотКт,
			|	ОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокДт КАК БУКонечныйРазвернутыйОстатокДт,
			|	ОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокКт КАК БУКонечныйРазвернутыйОстатокКт
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
			|			&НачалоПериода,
			|			&КонецПериода,
			|			Месяц,
			|			ДвиженияИГраницыПериода,
			|			Счет В ИЕРАРХИИ (&Счет),
			|			&ВидыСубконтоКонтрагентыДоговоры,
			|			Организация = &Организация
			|				И &УсловиеПоИФО
			|				И &УсловиеПоКФО
			|				И &УсловиеПоКПС
			|				И &УсловиеПоКонтрагент
			|				И &УсловиеПоДоговор) КАК ОстаткиИОбороты
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период
			|ИТОГИ
			|	СУММА(БУНачальныйРазвернутыйОстатокДт),
			|	СУММА(БУНачальныйРазвернутыйОстатокКт),
			|	СУММА(БУОборотДт),
			|	СУММА(БУОборотКт),
			|	СУММА(БУКонечныйРазвернутыйОстатокДт),
			|	СУММА(БУКонечныйРазвернутыйОстатокКт)
			|ПО
			|	Период ПЕРИОДАМИ(МЕСЯЦ, , )";
			Запрос.УстановитьПараметр("НачалоПериода",   ПараметрыОтчета.НачалоПериода);
			Запрос.УстановитьПараметр("КонецПериода",    ПараметрыОтчета.КонецПериода);
			Запрос.УстановитьПараметр("Организация",     ПараметрыОтчета.Организация);
			Запрос.УстановитьПараметр("Счет",            ПараметрыОтчета.Счет);
			Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
			
			ВидыСубконтоКонтрагентыДоговоры = Новый Массив;
			ВидыСубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
			ВидыСубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
			Запрос.УстановитьПараметр("ВидыСубконтоКонтрагентыДоговоры", ВидыСубконтоКонтрагентыДоговоры);
			
			ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
			Настройки = КомпоновщикНастроек.ПолучитьНастройки();
			
			// Отборы синхронизированы с отчетом (СКД).
			Для Каждого ЭлементОтбора Из Настройки.Отбор.Элементы Цикл
				
				Если НЕ ЭлементОтбора.Использование Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СправочникСсылка.Контрагенты") Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКонтрагент", "Субконто1 В (&Контрагент)");
					Запрос.УстановитьПараметр("Контрагент", ЭлементОтбора.ПравоеЗначение);
				
				ИначеЕсли ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СправочникСсылка.Договоры") Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоДоговор", "Субконто2 В (&Договор)");
					Запрос.УстановитьПараметр("Договор", ЭлементОтбора.ПравоеЗначение);
					
				ИначеЕсли ИспользоватьУчетПоИФО И ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИФО В (&ИФО)");
					Запрос.УстановитьПараметр("ИФО", ЭлементОтбора.ПравоеЗначение);
					
				ИначеЕсли ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("ПеречислениеСсылка.КВД") Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "КФО В (&КФО)");
					Запрос.УстановитьПараметр("КФО", ЭлементОтбора.ПравоеЗначение);
					
				ИначеЕсли ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СправочникСсылка.КлассификационныеПризнакиСчетов") Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКПС", "КПС В (&КПС)");
					Запрос.УстановитьПараметр("КПС", ЭлементОтбора.ПравоеЗначение);
					
				КонецЕсли;
				
			КонецЦикла;
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИСТИНА");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "ИСТИНА");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКПС", "ИСТИНА");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКонтрагент", "ИСТИНА");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоДоговор", "ИСТИНА");
			
			Результат = Запрос.Выполнить();
			
			ВыборкаПериод = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Период", "ВСЕ");
			Пока ВыборкаПериод.Следующий() Цикл
				
				Выборка = ВыборкаПериод.Выбрать();
				Пока Выборка.Следующий() Цикл
					
					Отбор = Новый Структура("ИФО,КФО,КПС,СчетРасчетов,Контрагент,Договор,Валюта");
					ЗаполнитьЗначенияСвойств(Отбор, Выборка);
					
					ПараметрыАнализаЗадолженности = КонтрольИсполненияДоговоров.НовыеПараметрыАнализаЗадолженности();
					ДатаАнализаНачальныйОстаток = НачалоДня(Выборка.Период) - 1;
					ДатаАнализаКонечныйОстаток = КонецМесяца(Выборка.Период);
					
					Если Выборка.БУНачальныйРазвернутыйОстатокДт <> 0 Тогда // Дебиторская, начальный остаток.
						
						АнализЗадолженностиДт = КонтрольИсполненияДоговоров.АнализЗадолженности(
								Выборка.Организация,
								ДатаАнализаНачальныйОстаток,
								Отбор,
								Перечисления.ВидыЗадолженности.Дебиторская,
								Неопределено,
								ПараметрыАнализаЗадолженности);
						АнализЗадолженностиДт.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
						АнализЗадолженностиДт.ЗаполнитьЗначения(Выборка.Период, "Период");
						
						Для Каждого СтрокаАнализЗадолженности Из АнализЗадолженностиДт Цикл
							
							Если СтрокаАнализЗадолженности.Остаток = 0 Тогда
								Продолжить;
							КонецЕсли;
							
							НоваяСтрока = АнализЗадолженностиОбщий.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАнализЗадолженности);
							НоваяСтрока.ЗадолженностьНачальныйОстатокДт = СтрокаАнализЗадолженности.ОстатокРуб;
							
						КонецЦикла;
						
					КонецЕсли;
					
					Если Выборка.БУНачальныйРазвернутыйОстатокКт <> 0 Тогда // Кредиторская, начальный остаток.
						
						АнализЗадолженностиКт = КонтрольИсполненияДоговоров.АнализЗадолженности(
								Выборка.Организация,
								ДатаАнализаНачальныйОстаток,
								Отбор,
								Перечисления.ВидыЗадолженности.Кредиторская,
								Неопределено,
								ПараметрыАнализаЗадолженности);
						АнализЗадолженностиКт.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
						АнализЗадолженностиКт.ЗаполнитьЗначения(Выборка.Период, "Период");
						
						Для Каждого СтрокаАнализЗадолженности Из АнализЗадолженностиКт Цикл
							
							Если СтрокаАнализЗадолженности.Остаток = 0 Тогда
								Продолжить;
							КонецЕсли;
							
							НоваяСтрока = АнализЗадолженностиОбщий.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАнализЗадолженности);
							НоваяСтрока.ЗадолженностьНачальныйОстатокКт = СтрокаАнализЗадолженности.ОстатокРуб;
							
						КонецЦикла;
						
					КонецЕсли;
					
					Если Выборка.БУКонечныйРазвернутыйОстатокДт <> 0 Тогда // Дебиторская, конечный остаток.
						
						АнализЗадолженностиДт = КонтрольИсполненияДоговоров.АнализЗадолженности(
								Выборка.Организация,
								ДатаАнализаКонечныйОстаток,
								Отбор,
								Перечисления.ВидыЗадолженности.Дебиторская,
								Неопределено,
								ПараметрыАнализаЗадолженности);
						АнализЗадолженностиДт.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
						АнализЗадолженностиДт.ЗаполнитьЗначения(Выборка.Период, "Период");
						
						Для Каждого СтрокаАнализЗадолженности Из АнализЗадолженностиДт Цикл
							
							Если СтрокаАнализЗадолженности.Остаток = 0 Тогда
								Продолжить;
							КонецЕсли;
							
							НоваяСтрока = АнализЗадолженностиОбщий.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАнализЗадолженности);
							НоваяСтрока.ЗадолженностьКонечныйОстатокДт = СтрокаАнализЗадолженности.ОстатокРуб;
							
						КонецЦикла;
						
					КонецЕсли;
					
					Если Выборка.БУКонечныйРазвернутыйОстатокКт <> 0 Тогда // Кредиторская, конечный остаток.
						
						АнализЗадолженностиКт = КонтрольИсполненияДоговоров.АнализЗадолженности(
								Выборка.Организация,
								ДатаАнализаКонечныйОстаток,
								Отбор,
								Перечисления.ВидыЗадолженности.Кредиторская,
								Неопределено,
								ПараметрыАнализаЗадолженности);
						АнализЗадолженностиКт.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
						АнализЗадолженностиКт.ЗаполнитьЗначения(Выборка.Период, "Период");
						
						Для Каждого СтрокаАнализЗадолженности Из АнализЗадолженностиКт Цикл
							
							Если СтрокаАнализЗадолженности.Остаток = 0 Тогда
								Продолжить;
							КонецЕсли;
							
							НоваяСтрока = АнализЗадолженностиОбщий.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАнализЗадолженности);
							НоваяСтрока.ЗадолженностьКонечныйОстатокКт = СтрокаАнализЗадолженности.ОстатокРуб;
							
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
	КонецЕсли;
	
	АнализЗадолженностиОбщий.Колонки.СрокИсполнения.Имя = "ДатаИсполнения";
	
	Возврат АнализЗадолженностиОбщий;
	
КонецФункции

#КонецОбласти

#КонецЕсли