#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс	

Процедура СформироватьОтчет(Результат = Неопределено, ДанныеРасшифровки = Неопределено, Схема = Неопределено, ВыводитьПолностью = Истина) Экспорт
	
	Результат.Очистить();
	Результат.ТолькоПросмотр = Истина;
	Результат.ЧерноБелаяПечать = Истина;
	Результат.ИмяПараметровПечати = "ПараметрыПечати_ТОРГ29";
	
	//СтандартныеОтчеты.ВывестиОтчет(ЭтотОбъект, Результат, ДанныеРасшифровки, Схема, ВыводитьПолностью); 
	Если ТипЗнч(Схема) = Тип("Строка") Тогда
		Если ЭтоАдресВременногоХранилища(Схема) Тогда
			СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(Схема);
		КонецЕсли;
	Иначе
		СхемаКомпоновкиДанных = Схема;
	КонецЕсли;
	
	КомпоновщикНастроек.Восстановить();
	
	СчетаРозницы   = Новый СписокЗначений;
	// 105.Г8 105.Б8 
	СчетаРозницы.Добавить(ПланыСчетов.ЕПСБУ.НайтиПоКоду("105.Г8"));
	СчетаРозницы.Добавить(ПланыСчетов.ЕПСБУ.НайтиПоКоду("105.Б8"));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "СчетаРозницы", СчетаРозницы);
	
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "НачалоПериода", НачалоДня(НачалоПериода));
	КонецЕсли;
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КонецПериода", КонецДня(КонецПериода));
	КонецЕсли;
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "Подразделение", Подразделение);
	
	СтандартныеОтчетыКлиентСервер.УдалитьОтбор(КомпоновщикНастроек,"ЦМО");

	Если ЗначениеЗаполнено(ЦМО) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикНастроек,"ЦМО",ЦМО,,,,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	КонецЕсли;
	
	НастройкиДляКомпоновкиМакета = КомпоновщикНастроек.ПолучитьНастройки();
		
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиДляКомпоновкиМакета,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКД = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКД.Инициализировать(МакетКомпоновки,,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ДеревоРезультат = Новый ДеревоЗначений;
	ПроцессорВывода.УстановитьОбъект(ДеревоРезультат);
	ПроцессорВывода.Вывести(ПроцессорКД);

	Макет =  УправлениеПечатью.МакетПечатнойФормы("Отчет.ТОРГ29.ПФ_MXL_ТОРГ29");
	ОбластьЗаголовок   = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка       = Макет.ПолучитьОбласть("Шапка");
	ОбластьВидДвижения = Макет.ПолучитьОбласть("ВидДвижения");
	ОбластьСтрока      = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог        = Макет.ПолучитьОбласть("Итог");
	ОбластьОстаток     = Макет.ПолучитьОбласть("Остаток");
	ОбластьПодвал      = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьЗаголовок.Параметры.ДатаНачала = НачалоПериода;
	ОбластьЗаголовок.Параметры.ДатаКонца  = КонецПериода;
	
	СтруктураЗаголовка = Новый Структура("Учреждение, Подразделение, КодОКПО, ТабельныйНомер, Фамилия, Имя, Отчество, Должность");	
	
	ТекУчреждение = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		ДанныеУчреждения = Новый Структура("ДанныеУчреждения");
		ДанныеУчреждения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "КодОКПО,НаименованиеПолное");
		
		СтруктураЗаголовка.Учреждение = ДанныеУчреждения.НаименованиеПолное;
		СтруктураЗаголовка.КодОКПО    = ДанныеУчреждения.КодОКПО;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ЦМО) Тогда
		ДанныеЦМО = ПолучитьДанныеЦМО(ЦМО);
		
		ЗаполнитьЗначенияСвойств(СтруктураЗаголовка, ДанныеЦМО);
	КонецЕсли;	
	
	ОбластьЗаголовок.Параметры.Заполнить(СтруктураЗаголовка);
	ДанныеЗаголовка = Новый Структура("Подразделение,МОЛ",Подразделение);
	
	ДанныеЗаголовка.МОЛ = "" + СтруктураЗаголовка.Должность + " " + СтруктураЗаголовка.Фамилия + " " 
									+ СтруктураЗаголовка.Имя + " " + СтруктураЗаголовка.Отчество;
									
	ОбластьЗаголовок.Параметры.Заполнить(ДанныеЗаголовка);
	
	Результат.Вывести(ОбластьЗаголовок);
	Результат.Вывести(ОбластьШапка);
	
	НачальныйОстаток = 0;
	ОбластьОстаток.Параметры.ДатаОстатка = НачалоПериода;
	СтрокаОстатка = ДеревоРезультат.Строки.Найти("Остаток", "ВидДвижения", Ложь);
	Если СтрокаОстатка <> Неопределено И СтрокаОстатка.Строки.Количество() <> 0 Тогда
		ОбластьОстаток.Параметры.Сумма = СтрокаОстатка.Строки[0].Сумма;
		НачальныйОстаток = ОбластьОстаток.Параметры.Сумма;
	КонецЕсли;	
	Результат.Вывести(ОбластьОстаток);
	
	СуммаДвиженийПриход = 0;
	ВывестиДвижения(ДеревоРезультат, "ПРИХОД", СуммаДвиженийПриход, ОбластьВидДвижения, ОбластьСтрока, Результат);
	
	ВывестиИтог("Итого по приходу ", СуммаДвиженийПриход, ОбластьИтог, Результат);
	ВывестиИтог("Итого с остатком ", НачальныйОстаток + СуммаДвиженийПриход, ОбластьИтог, Результат);
	
	Результат.ВывестиГоризонтальныйРазделительСтраниц();
	Результат.Вывести(ОбластьШапка);
	
	СуммаДвиженийРасход = 0;
	ВывестиДвижения(ДеревоРезультат, "РАСХОД", СуммаДвиженийРасход, ОбластьВидДвижения, ОбластьСтрока, Результат);
	
	ВывестиИтог("Итого по расходу ", СуммаДвиженийРасход, ОбластьИтог, Результат);

	ОбластьОстаток.Параметры.ДатаОстатка = КонецПериода;
	ОбластьОстаток.Параметры.Сумма = НачальныйОстаток + СуммаДвиженийПриход - СуммаДвиженийРасход;
	Результат.Вывести(ОбластьОстаток);
	
	ОбластьПодвал.Параметры.ДолжностьМОЛ = СтруктураЗаголовка.Должность;
	СтруктураФИО = Новый Структура("Фамилия, Имя, Отчество", СтруктураЗаголовка.Фамилия, СтруктураЗаголовка.Имя, СтруктураЗаголовка.Отчество);
	ОбластьПодвал.Параметры.ФИОМОЛ = КорреспондентыКлиентСервер.ФИО(СтруктураФИО, Истина);
	
	Результат.Вывести(ОбластьПодвал);

КонецПроцедуры

Функция ПолучитьДанныеЦМО(ТекЦМО) Экспорт
	СтруктураРезультат = Новый Структура("Подразделение, Фамилия, Имя, Отчество, ТабельныйНомер, Должность");
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЦМО.Сотрудник,
	               |	ЦМО.Сотрудник.Код КАК ТабельныйНомер,
	               |	ФИОФизическихЛицСрезПоследних.Фамилия,
	               |	ФИОФизическихЛицСрезПоследних.Имя,
	               |	ФИОФизическихЛицСрезПоследних.Отчество
	               |ПОМЕСТИТЬ ТабСотрудник
	               |ИЗ
	               |	Справочник.ЦМО КАК ЦМО
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&ДатаСреза, ) КАК ФИОФизическихЛицСрезПоследних
	               |		ПО ЦМО.Сотрудник.Контрагент.ЮридическоеФизическоеЛицо = ФИОФизическихЛицСрезПоследних.ФизическоеЛицо
	               |ГДЕ
	               |	ЦМО.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДанныеСотрудниковСрезПоследних.Должность,
	               |	ДанныеСотрудниковСрезПоследних.Сотрудник
	               |ПОМЕСТИТЬ ТабРС
	               |ИЗ
	               |	РегистрСведений.ДанныеСотрудников.СрезПоследних(
	               |			&ДатаСреза,
	               |			Сотрудник В
	               |				(ВЫБРАТЬ
	               |					Таб.Сотрудник
	               |				ИЗ
	               |					ТабСотрудник КАК Таб)) КАК ДанныеСотрудниковСрезПоследних
				   |;
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабСотрудник.Фамилия,
	               |	ТабСотрудник.Имя,
	               |	ТабСотрудник.Отчество,
	               |	ТабСотрудник.ТабельныйНомер,
	               |	ТабРС.Должность
	               |ИЗ
	               |	ТабСотрудник КАК ТабСотрудник
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТабРС КАК ТабРС
	               |		ПО ТабСотрудник.Сотрудник = ТабРС.Сотрудник";
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("Ссылка", ТекЦМО);
	Запрос.УстановитьПараметр("ДатаСреза", КонецПериода);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураРезультат, Выборка);
	КонецЕсли;	
	
	Возврат СтруктураРезультат;
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВывестиДвижения(ДеревоРезультат, ВидДвижения, СуммаДвижений, ОбластьВидДвижения, ОбластьСтрока, Результат)
	ОбластьВидДвижения.Параметры.ВидДвижения = ВидДвижения;
	Результат.Вывести(ОбластьВидДвижения);
	
	СтрокаВидаДвижений = ДеревоРезультат.Строки.Найти(ВидДвижения, "ВидДвижения", Ложь);
	Если СтрокаВидаДвижений <> Неопределено Тогда
		Для каждого ДетЗапись из СтрокаВидаДвижений.Строки Цикл
			ОбластьСтрока.Параметры.Заполнить(ДетЗапись);
			Результат.Вывести(ОбластьСтрока);
			СуммаДвижений = СуммаДвижений + ДетЗапись.Сумма;
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры	

Процедура ВывестиИтог(ТекстИтог, Сумма, ОбластьИтог, Результат)
	ОбластьИтог.Параметры.ТекстИтог = ТекстИтог;
	ОбластьИтог.Параметры.Сумма     = Сумма;
	Результат.Вывести(ОбластьИтог);
КонецПроцедуры	

#КонецОбласти

#КонецЕсли