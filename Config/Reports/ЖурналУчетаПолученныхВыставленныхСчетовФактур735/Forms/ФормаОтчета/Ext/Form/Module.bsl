&НаСервере
Процедура СвязьПолейШапкиИОтбора_ПриСозданииНаСервере()
	
	МассивСтрокСвязи = Новый Массив();
	
	// Организация:
	СтрокаСвязи = Новый Структура();
	СтрокаСвязи.Вставить("РежимСвязи",						"ИндикаторСвязи");
	СтрокаСвязи.Вставить("ШапкаИмяЭлементаПоля",			"Организация");
	СтрокаСвязи.Вставить("ОтборИмяЭлементаТаблицы",			"Отбор");
	СтрокаСвязи.Вставить("ОтборИмяПоля",					"Организация");
	МассивСтрокСвязи.Добавить(СтрокаСвязи);
	
	// ИФО:
	СтрокаСвязи = Новый Структура();
	СтрокаСвязи.Вставить("РежимСвязи",						"ИндикаторСвязи");
	СтрокаСвязи.Вставить("ШапкаИмяЭлементаПоля",			"ИФО");
	СтрокаСвязи.Вставить("ОтборИмяЭлементаТаблицы",			"Отбор");
	СтрокаСвязи.Вставить("ОтборИмяПоля",					"ИФО");
	СтрокаСвязи.Вставить("ШапкаИменаФункциональныхОпций",	"ИспользоватьУчетПоИФО");
	СтрокаСвязи.Вставить("ВыводитьНадписьПомимоЗамка",		Ложь);
	МассивСтрокСвязи.Добавить(СтрокаСвязи);
	
	// Контрагент:
	СтрокаСвязи = Новый Структура();
	СтрокаСвязи.Вставить("РежимСвязи",						"ИндикаторСвязи");
	СтрокаСвязи.Вставить("ШапкаИмяЭлементаПоля",			"Контрагент");
	СтрокаСвязи.Вставить("ОтборИмяЭлементаТаблицы",			"Отбор");
	СтрокаСвязи.Вставить("ОтборИмяПоля",					"Контрагент");
	СтрокаСвязи.Вставить("ВыводитьНадписьПомимоЗамка",		Ложь);
	МассивСтрокСвязи.Добавить(СтрокаСвязи);
	
	СтандартныеОтчеты.СвязьПолейШапкиИОтбора_ПриСозданииНаСервере(ЭтаФорма,
		МассивСтрокСвязи,					// МассивСтрокСвязи
		ИменаСохраняемыхРеквизитовФормы,	// ИменаСохраняемыхРеквизитовФормы
		);									// ИменаСозданныхРеквизитовФормы
	
КонецПроцедуры

