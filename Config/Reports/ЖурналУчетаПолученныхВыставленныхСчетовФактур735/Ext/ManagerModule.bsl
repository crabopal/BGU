		ПараметрыОтчета["Организация"]);
	
	Возврат ТабДокумент;
	
КонецФункции


Процедура ВывестиЗаголовок(ЗаполняемыйТабличныйДокумент, ПараметрыОбласти, ИспользуемыйМакет)
	
	// Используемый макет:
	ОбластьЗаголовок	= ИспользуемыйМакет.ПолучитьОбласть("Заголовок");
	ОбластьОтбор		= ИспользуемыйМакет.ПолучитьОбласть("Отбор");
	
	// Подготовка:
	СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОбласти["Организация"],
		"Наименование,НаименованиеПолное,НаименованиеСокращенное,ИНН,КПП");
	Наименование1 = СвойстваОрганизации["НаименованиеПолное"];
	Наименование2 = СвойстваОрганизации["НаименованиеСокращенное"];
	Наименование3 = СвойстваОрганизации["Наименование"];
	Если ЗначениеЗаполнено(Наименование1) Тогда
		ОрганизацияПредставление = Наименование1;
	ИначеЕсли ЗначениеЗаполнено(Наименование2) Тогда
		ОрганизацияПредставление = Наименование2;
	Иначе
		ОрганизацияПредставление = Наименование3;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОбласти["ДатаНачалаПериода"])
		ИЛИ ЗначениеЗаполнено(ПараметрыОбласти["ДатаОкончанияПериода"]) Тогда
		ПериодПредставление = ПредставлениеПериода(ПараметрыОбласти["ДатаНачалаПериода"], ПараметрыОбласти["ДатаОкончанияПериода"], "ФП");
	Иначе
		ПериодПредставление = "... - ...";
	КонецЕсли;
	
	// Заполняем параметры области:
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("ОрганизацияПредставление",	ОрганизацияПредставление);
	ЗначенияПараметров.Вставить("ИНН",						СвойстваОрганизации["ИНН"]);
	ЗначенияПараметров.Вставить("КПП",						СвойстваОрганизации["КПП"]);
	ЗначенияПараметров.Вставить("ПериодПредставление",		ПериодПредставление);
	ОбластьЗаголовок.Параметры.Заполнить(ЗначенияПараметров);
	// Выводим область:
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
	// Отбор:
	Если ПараметрыОбласти["ВыводитьОтбор"] Тогда
		ОтборВТаблице = ПараметрыОбласти["Отбор"];
		ОтборЧастиЖурнала = "";
		Если НЕ ПараметрыОбласти["ВыводитьЧасть1"] Тогда
			ОтборЧастиЖурнала = ОтборЧастиЖурнала
				+ ?(ПустаяСтрока(ОтборЧастиЖурнала), "", " И ")
				+ НСтр("ru='Не выводить часть 1 журнала'");
		КонецЕсли;
		Если НЕ ПараметрыОбласти["ВыводитьЧасть2"] Тогда
			ОтборЧастиЖурнала = ОтборЧастиЖурнала
				+ ?(ПустаяСтрока(ОтборЧастиЖурнала), "", " И ")
				+ НСтр("ru='Не выводить часть 2 журнала'");
		КонецЕсли;
		
		Отбор = ОтборЧастиЖурнала
			+ ?(ПустаяСтрока(ОтборЧастиЖурнала) ИЛИ ПустаяСтрока(ОтборВТаблице), "", " И ")
			+ ОтборВТаблице;
		
		Если ПустаяСтрока(Отбор) Тогда
			Отбор = НСтр("ru='(отбор не установлен)'");
		КонецЕсли;
		
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("Отбор", Отбор);
		ОбластьОтбор.Параметры.Заполнить(ЗначенияПараметров);
		ЗаполняемыйТабличныйДокумент.Вывести(ОбластьОтбор);
	КонецЕсли;
	
КонецПроцедуры


Процедура ВывестиЧастиЖурнала(ЗаполняемыйТабличныйДокумент, ИспользуемыйМакет, СтрокаВерхнейГруппировки, ПараметрыОтчета)
	
	// Определяем заполненность частей журнала:
	СтатусыЧастейЖурнала = ПолучитьТаблицуСтатусовЧастейЖурнала();
	ИндексВВерхнейГруппировке = 0;
	Для Каждого СтрокаГруппировкаЧастьЖурнала Из СтрокаВерхнейГруппировки.Строки Цикл
		СтрокаСтатуса = СтатусыЧастейЖурнала.Найти(СтрокаГруппировкаЧастьЖурнала["ЧастьЖурнала"], "ЧастьЖурнала");
		Если НЕ СтрокаСтатуса = Неопределено Тогда
			СтрокаСтатуса["ИндексВВерхнейГруппировке"] = ИндексВВерхнейГруппировке;
		КонецЕсли;
		ИндексВВерхнейГруппировке = ИндексВВерхнейГруппировке + 1;
	КонецЦикла;
	
	// Выводим части журнала (таблицу, если есть данные)
	// или только шапки таблиц (если данных в этих частях журнала нет):
	Для Каждого СтрокаСтатуса Из СтатусыЧастейЖурнала Цикл
		ИндексВВерхнейГруппировке = СтрокаСтатуса["ИндексВВерхнейГруппировке"];
		Если ИндексВВерхнейГруппировке >= 0 Тогда
			СтрокаГруппировкаЧастьЖурнала = СтрокаВерхнейГруппировки.Строки[ИндексВВерхнейГруппировке];
		Иначе
			СтрокаГруппировкаЧастьЖурнала = Неопределено;
		КонецЕсли;
		
		ПараметрыВыводаТаблицы = Новый Структура();
		ПараметрыВыводаТаблицы.Вставить("НПП",							1);
		ПараметрыВыводаТаблицы.Вставить("НомерЧастиЖурнала",			СтрокаСтатуса["НомерЧастиЖурнала"]);
		ПараметрыВыводаТаблицы.Вставить("ЗаполняемыйТабличныйДокумент",	ЗаполняемыйТабличныйДокумент);
		ПараметрыВыводаТаблицы.Вставить("ИспользуемыйМакет",			ИспользуемыйМакет);
		ПараметрыВыводаТаблицы.Вставить("СтрокаГруппировки",			СтрокаГруппировкаЧастьЖурнала);
		ПараметрыВыводаТаблицы.Вставить("ВыводитьИтоги",				ПараметрыОтчета["ВыводитьИтоги"]);
		ПараметрыВыводаТаблицы.Вставить("ГруппироватьПоКонтрагентам",	ПараметрыОтчета["ГруппироватьПоКонтрагентам"]);
		ПараметрыВыводаТаблицы.Вставить("НумероватьВнутриКонтрагента",	ПараметрыОтчета["НумероватьВнутриКонтрагента"]);

		ВывестиЧастьЖурнала(ПараметрыВыводаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиЧастьЖурнала(ПараметрыВыводаТаблицы)
	
	НомерЧастиЖурнала				= ПараметрыВыводаТаблицы["НомерЧастиЖурнала"];
	СтрокаГруппировкаЧастьЖурнала	= ПараметрыВыводаТаблицы["СтрокаГруппировки"];
	ВыводитьИтоги					= ПараметрыВыводаТаблицы["ВыводитьИтоги"];
	ЗаполняемыйТабличныйДокумент	= ПараметрыВыводаТаблицы["ЗаполняемыйТабличныйДокумент"];
	ИспользуемыйМакет				= ПараметрыВыводаТаблицы["ИспользуемыйМакет"];
	
	//---
	// Шапка таблицы
	//---
	Если НомерЧастиЖурнала = 1 Тогда
		ОбластьШапка = ИспользуемыйМакет.ПолучитьОбласть("Шапка1");
	Иначе
		ОбластьШапка = ИспользуемыйМакет.ПолучитьОбласть("Шапка2");
	КонецЕсли;
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьШапка);
	
	// Если часть журнала пустая, то выводим только шапку таблицы, и больше ничего:
	Если СтрокаГруппировкаЧастьЖурнала = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//---
	// Строки таблицы
	//---
	ВывестиСтрокиЧастиЖурнала(ПараметрыВыводаТаблицы);
	
	//---
	// Итоги
	//---
	Если ВыводитьИтоги Тогда
		Если СтрокаГруппировкаЧастьЖурнала["ВалютыРазличные"] Тогда
			ОбластьИтого = ИспользуемыйМакет.ПолучитьОбласть("ИтогоВалютыРазличные");
		Иначе
			ОбластьИтого = ИспользуемыйМакет.ПолучитьОбласть("Итого");
			ОбластьИтого.Параметры.Заполнить(СтрокаГруппировкаЧастьЖурнала);
		КонецЕсли;
		ЗаполняемыйТабличныйДокумент.Вывести(ОбластьИтого);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиГруппировкуКонтрагент(ПараметрыВыводаТаблицы)
	
	СтрокаГруппировкаКонтрагент		= ПараметрыВыводаТаблицы["СтрокаГруппировки"];
	ЗаполняемыйТабличныйДокумент	= ПараметрыВыводаТаблицы["ЗаполняемыйТабличныйДокумент"];
	ИспользуемыйМакет				= ПараметрыВыводаТаблицы["ИспользуемыйМакет"];
	ВыводитьИтоги					= ПараметрыВыводаТаблицы["ВыводитьИтоги"];
	
	//---
	// Итого по контрагенту
	//---
	Если СтрокаГруппировкаКонтрагент["ВалютыРазличные"] Тогда
		ОбластьКонтрагент = ИспользуемыйМакет.ПолучитьОбласть("КонтрагентВалютыРазличные");
	Иначе
		ОбластьКонтрагент = ИспользуемыйМакет.ПолучитьОбласть("Контрагент");
	КонецЕсли;
	ОбластьКонтрагент.Параметры.Заполнить(СтрокаГруппировкаКонтрагент);
	ЗначенияПараметров = Новый Структура("КонтрагентПредставление", СтрокаГруппировкаКонтрагент["КонтрагентПредставление"]);
	ОбластьКонтрагент.Параметры.Заполнить(ЗначенияПараметров);
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьКонтрагент);
	
	//---
	// Детальные строки
	//---
	ВывестиСтрокиЧастиЖурнала(ПараметрыВыводаТаблицы); //НомерЧастиЖурнала, ЗаполняемыйТабличныйДокумент, ИспользуемыйМакет, СтрокаГруппировкаКонтрагент, ВыводитьИтоги, НППСтроки);
	
КонецПроцедуры

Процедура ВывестиСтрокиЧастиЖурнала(ПараметрыВыводаТаблицы)
	
	СтрокаГруппировки				= ПараметрыВыводаТаблицы["СтрокаГруппировки"];
	
	СимволПрочерка = "---";
	
	Для Каждого СтрокаДерева Из СтрокаГруппировки.Строки Цикл
		Если СтрокаДерева["ЭтоГруппировкаКонтрагент"] Тогда
			
			ПараметрыВыводаТаблицы["СтрокаГруппировки"] = СтрокаДерева;
			ВывестиГруппировкуКонтрагент(ПараметрыВыводаТаблицы);
			
		Иначе
			НПП								= ПараметрыВыводаТаблицы["НПП"];
			НомерЧастиЖурнала				= ПараметрыВыводаТаблицы["НомерЧастиЖурнала"];
			ВыводитьИтоги					= ПараметрыВыводаТаблицы["ВыводитьИтоги"];
			ЗаполняемыйТабличныйДокумент	= ПараметрыВыводаТаблицы["ЗаполняемыйТабличныйДокумент"];
			ИспользуемыйМакет				= ПараметрыВыводаТаблицы["ИспользуемыйМакет"];
			ГруппироватьПоКонтрагентам		= ПараметрыВыводаТаблицы["ГруппироватьПоКонтрагентам"];
			НумероватьВнутриКонтрагента		= ПараметрыВыводаТаблицы["НумероватьВнутриКонтрагента"];
			
			//---
			// Строка таблицы
			//---
			ОбластьСтрока = ИспользуемыйМакет.ПолучитьОбласть("СтрокаЧасть" + НомерЧастиЖурнала);
			
			ОбластьСтрока.Параметры.Заполнить(СтрокаДерева);
			
			Если НомерЧастиЖурнала = 1 Тогда
				СторонаCделки = УчетНДС.ОпределитьПокупателя(СтрокаДерева)["Покупатель"];
			Иначе
				СторонаCделки = УчетНДС.ОпределитьПродавца(СтрокаДерева)["Продавец"];
			КонецЕсли;
				
			Параметр_ПокупательПродавецПредставление	= СторонаCделки["Наименование"];
			Параметр_ПокупательПродавецИНН				= СторонаCделки["ИНН"];
			Параметр_ПокупательПродавецКПП				= СторонаCделки["КПП"];
			Параметр_ПокупательПродавецСсылка			= СторонаCделки["Ссылка"];
			
			СтруктураНомерСФ = УчетНДС.ОпределитьНомерСФДляВыводаВРегистрыУчета(СтрокаДерева);
			
			ЗначенияПараметров = Новый Структура();
			
			// 1
			Если ГруппироватьПоКонтрагентам И НумероватьВнутриКонтрагента Тогда
				Параметр_НПП = Строка(СтрокаДерева["СистемныеПоляНомерПоПорядкуВГруппировке"])
					+ " (" + Строка(НПП) + ")";
			Иначе
				Параметр_НПП = Строка(НПП);
			КонецЕсли;
			ЗначенияПараметров.Вставить("НПП",					Параметр_НПП);
			НПП = НПП + 1;
			ПараметрыВыводаТаблицы["НПП"] = НПП;
			
			// 4
			ЗначенияПараметров.Вставить("НомерДатаСФ",
				УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
					СтруктураНомерСФ["Номер"], СтрокаДерева["Дата"]));
			
			// 5
			ЗначенияПараметров.Вставить("НомерДатаИсправленияСФ",
				УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
					СтрокаДерева["НомерИсправления"], СтрокаДерева["ДатаИсправления"]));
			
			// 6
			ЗначенияПараметров.Вставить("НомерДатаКСФ",
				УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
					СтруктураНомерСФ["НомерКСФ"], СтрокаДерева["ДатаКСФ"]));
			
			// 7
			ЗначенияПараметров.Вставить("НомерДатаИсправленияКСФ",
				УчетНДСКлиентСервер.ПолучитьПредставлениеНомерДатаДокумента(
					СтрокаДерева["НомерИсправленияКСФ"], СтрокаДерева["ДатаИсправленияКСФ"]));
			
			// 8
			ЗначенияПараметров.Вставить("ПокупательПродавецПредставление",	Параметр_ПокупательПродавецПредставление);
			ЗначенияПараметров.Вставить("ПокупательПродавецСсылка",			Параметр_ПокупательПродавецСсылка);
			
			// 9
			Если ЗначениеЗаполнено(Параметр_ПокупательПродавецИНН) ИЛИ ЗначениеЗаполнено(Параметр_ПокупательПродавецКПП) Тогда
				Параметр_ИННКПП = Строка(Параметр_ПокупательПродавецИНН) + " / " + Строка(Параметр_ПокупательПродавецКПП);
			Иначе
				Параметр_ИННКПП = "";
			КонецЕсли;
			ЗначенияПараметров.Вставить("ИННКПП", Параметр_ИННКПП);
			
			// 14, 15
			Если СтрокаДерева["ЭтоШкурыЛом"] Тогда
				ЗначенияПараметров.Вставить("СуммаПоСчетуФактуре",	СимволПрочерка);
				ЗначенияПараметров.Вставить("СуммаНДС",				СимволПрочерка);
			КонецЕсли;
			
			ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
			
			ЗаполняемыйТабличныйДокумент.Вывести(ОбластьСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


Процедура ВывестиПодвал(ЗаполняемыйТабличныйДокумент, ПараметрыОбласти, ИспользуемыйМакет)
	
	ОбластьПодвал = ИспользуемыйМакет.ПолучитьОбласть("Подвал");
	
	ЗначенияПараметров = Новый Структура();
	Если ЗначениеЗаполнено(ПараметрыОбласти["Организация"]) Тогда
		ОтветственныеЛица = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
			ПараметрыОбласти["Организация"],
			ПараметрыОбласти["Дата"]);
		
		ЗначенияПараметров.Вставить("РуководительФИО", Справочники.Сотрудники.ФамилияИО(
			ОтветственныеЛица["ОтветственноеЛицоСсылка"],, ПараметрыОбласти["Дата"]));
    КонецЕсли;
	// Выводим область:
	ОбластьПодвал.Параметры.Заполнить(ЗначенияПараметров);
	ЗаполняемыйТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры	


Функция ПолучитьТаблицуСтатусовЧастейЖурнала()
	
	СтатусЧастейЖурнала = Новый ТаблицаЗначений();
	СтатусЧастейЖурнала.Колонки.Добавить("НомерЧастиЖурнала",			Новый ОписаниеТипов("Число"));
	СтатусЧастейЖурнала.Колонки.Добавить("ЧастьЖурнала",				Новый ОписаниеТипов("ПеречислениеСсылка.ЧастиЖурналаУчетаСчетовФактур"));
	СтатусЧастейЖурнала.Колонки.Добавить("ИндексВВерхнейГруппировке",	Новый ОписаниеТипов("Число"));
	НоваяСтрока = СтатусЧастейЖурнала.Добавить();
	НоваяСтрока["НомерЧастиЖурнала"]			= 1;
	НоваяСтрока["ЧастьЖурнала"]					= Перечисления.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры;
	НоваяСтрока["ИндексВВерхнейГруппировке"]	= -1;
	НоваяСтрока = СтатусЧастейЖурнала.Добавить();
	НоваяСтрока["НомерЧастиЖурнала"]			= 2;
	НоваяСтрока["ЧастьЖурнала"]					= Перечисления.ЧастиЖурналаУчетаСчетовФактур.ПолученныеСчетаФактуры;
	НоваяСтрока["ИндексВВерхнейГруппировке"]	= -1;
	
	Возврат СтатусЧастейЖурнала;
	
КонецФункции

Процедура СообщитьОбОшибке(ИнформацияОбОшибке)
	
	Пока НЕ ИнформацияОбОшибке.Причина = Неопределено Цикл
		ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
	КонецЦикла;
	ТекстСообщения = НСтр("ru='Отчет не сформирован!'") + Символы.ПС + ИнформацияОбОшибке.Описание;
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

