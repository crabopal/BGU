#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "Основной");
	НастройкиВарианта.Описание = НСтр("ru = '(устарел) В редакции постановления Правительства РФ от 30.07.2014 № 981'");
	НастройкиВарианта.ВидимостьПоУмолчанию = Ложь;
	
КонецПроцедуры

#КонецОбласти

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура СформироватьОтчет(Знач ПараметрыОтчета, ВозвратАдресХранилищаРезультата) Экспорт
	
	// Установленные параметры отчета:
	Если ЗначениеЗаполнено(ПараметрыОтчета["НачалоПериода"]) Тогда
		ПараметрыОтчета["НачалоПериода"] = НачалоДня(ПараметрыОтчета["НачалоПериода"]);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыОтчета["КонецПериода"]) Тогда
		ПараметрыОтчета["КонецПериода"] = КонецДня(ПараметрыОтчета["КонецПериода"]);
	КонецЕсли;
	УникальныйИдентификаторФормы	= ПараметрыОтчета["УникальныйИдентификаторФормы"];
	
	// Результаты отчета:
	СписокСформированныхЛистов = Новый СписокЗначений();
	ТаблицаСформированныхЛистов = Новый ТаблицаЗначений();
	КЧ = Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Любой);
	ТаблицаСформированныхЛистов.Колонки.Добавить("Картинка",							Новый ОписаниеТипов("Картинка"));
	ТаблицаСформированныхЛистов.Колонки.Добавить("Наименование",						Новый ОписаниеТипов("Строка"));
	ТаблицаСформированныхЛистов.Колонки.Добавить("ПредставлениеНалоговогоПериода",		Новый ОписаниеТипов("Строка"));
	ТаблицаСформированныхЛистов.Колонки.Добавить("ИндексСоответствующейСтрокиСписка",	Новый ОписаниеТипов("Число", КЧ));
	ТаблицаСформированныхЛистов.Колонки.Добавить("ДатаНачалаПериода",					Новый ОписаниеТипов("Дата"));
	ТаблицаСформированныхЛистов.Колонки.Добавить("АдресХранилищаСДаннымиЛиста",			Новый ОписаниеТипов("Строка"));
	ТаблицаСформированныхЛистов.Колонки.Добавить("ЭтоДанныеОднимСписком",				Новый ОписаниеТипов("Булево"));
	ТаблицаСформированныхЛистов.Колонки.Добавить("ЭтоПустойЛист",						Новый ОписаниеТипов("Булево"));
	
	СформироватьЖурналУчета(ПараметрыОтчета, СписокСформированныхЛистов, ТаблицаСформированныхЛистов);
	
	ДозаполнитьДеревоСформированныхЛистов(ПараметрыОтчета, СписокСформированныхЛистов, ТаблицаСформированныхЛистов, УникальныйИдентификаторФормы);
	
	РезультатыОтчета = Новый Структура();
	РезультатыОтчета.Вставить("ТаблицаСформированныхЛистов",	ТаблицаСформированныхЛистов);
	ВозвратАдресХранилищаРезультата = ПоместитьВоВременноеХранилище(РезультатыОтчета, УникальныйИдентификаторФормы);
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПолучитьИспользуемыйМакет()
	
	Возврат УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ЖурналУчетаПолученныхВыставленныхСчетовФактур1137_981");
	
КонецФункции

Процедура СформироватьЖурналУчета(ПараметрыОтчета, СписокСформированныхЛистов, ТаблицаСформированныхЛистов)
	
	РезультатДерево											= Новый ДеревоЗначений();
	ИспользуемаяКартинкаВДеревеЛистовПоНалоговымПериодам	= Неопределено;
	ИспользуемаяКартинкаВДеревеЛистовОднимСписком			= БиблиотекаКартинок.РежимПросмотраСпискаСписок;
	
	УникальныйИдентификаторФормы		= ПараметрыОтчета["УникальныйИдентификаторФормы"];
	
    // Настраиваем схему КД:
	НастройкиСКД = ПолучитьНастройкиСКД(ПараметрыОтчета);
	ИспользуемаяСхемаКомпоновкиДанных	= НастройкиСКД["ИспользуемаяСхемаКомпоновкиДанных"];
	НовыйКомпоновщикНастроек			= НастройкиСКД["НовыйКомпоновщикНастроек"];
	
	// Выполняем схему:
	Попытка
		// Выводим результат в дерево:
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(
			ИспользуемаяСхемаКомпоновкиДанных,				// 1
			НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
			,												// 3
			,												// 4
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));// 5
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		ПроцессорВывода.УстановитьОбъект(РезультатДерево);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
		
		УчетНДС.СвернутьОдноименныеКолонкиДерева(РезультатДерево);
		
		ВывестиДанныеОднимСписком = (РезультатДерево.Строки.Количество() >= 3); // количество периодов >=2 и +1 строка одним списком
		
		Для Каждого СтрокаГруппировки Из РезультатДерево.Строки Цикл
			
			Если СтрокаГруппировки["ЭтоГруппировкаНалоговыйПериод"] = Истина Тогда
				// Выводим в табличный документ:
				ТабДокумент = ВывестиЖурналЗаНалоговыйПериод(ПараметрыОтчета, СтрокаГруппировки);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ТабДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				// Строка налогового периода:
				Наименование = ПредставлениеПериода(
					СтрокаГруппировки["ДатаНачалаПериода"],
					СтрокаГруппировки["ДатаОкончанияПериода"],
					"ФП");
				СтрокаНалоговогоПериода = ТаблицаСформированныхЛистов.Добавить();
				СтрокаНалоговогоПериода["Наименование"]						= Наименование;
				СтрокаНалоговогоПериода["ПредставлениеНалоговогоПериода"]	= Наименование;
				СтрокаНалоговогоПериода["Картинка"]							= ИспользуемаяКартинкаВДеревеЛистовПоНалоговымПериодам;
				СтрокаНалоговогоПериода["ДатаНачалаПериода"]				= СтрокаГруппировки["ДатаНачалаПериода"];
				СтрокаНалоговогоПериода["ИндексСоответствующейСтрокиСписка"] = ИндексСоответствующейСтрокиСписка;
				
			ИначеЕсли СтрокаГруппировки["ЭтоГруппировкаОднимСписком"] = Истина
				И ВывестиДанныеОднимСписком Тогда
				
				// Выводим в табличный документ:
				ТабДокумент = ВывестиЖурналЗаВсеПериодыОднимСписком(ПараметрыОтчета, СтрокаГруппировки);
				
				// СПИСОК СФОРМИРОВАННЫХ ЛИСТОВ:
				ДанныеЛиста = Новый Структура();
				ДанныеЛиста.Вставить("ТабличныйДокумент", ТабДокумент);
				НовыйЭлементСписка = СписокСформированныхЛистов.Добавить(ДанныеЛиста);
				ИндексСоответствующейСтрокиСписка = СписокСформированныхЛистов.Индекс(НовыйЭлементСписка);
				
				// ДЕРЕВО СФОРМИРОВАНЫХ ЛИСТОВ:
				// Строка самого верхнего уровня:
				СтрокаОднимСписком = ТаблицаСформированныхЛистов.Добавить();
				СтрокаОднимСписком["Наименование"]						= НСтр("ru='Журнал учета одним списком'");
				СтрокаОднимСписком["ПредставлениеНалоговогоПериода"]	= НСтр("ru='Весь период'");
				СтрокаОднимСписком["Картинка"]							= ИспользуемаяКартинкаВДеревеЛистовОднимСписком;
				СтрокаОднимСписком["ДатаНачалаПериода"]					= '00010101';
				СтрокаОднимСписком["ИндексСоответствующейСтрокиСписка"]	= ИндексСоответствующейСтрокиСписка;
				СтрокаОднимСписком["ЭтоДанныеОднимСписком"]				= Истина;
				Если СтрокаГруппировки.Строки.Количество() = 0 Тогда
					СтрокаОднимСписком["ЭтоПустойЛист"]					= Истина;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	Исключение
		СообщитьОбОшибке(ИнформацияОбОшибке());
		
	КонецПопытки;
		
КонецПроцедуры

Процедура ДозаполнитьДеревоСформированныхЛистов(ПараметрыОтчета, СписокСформированныхЛистов, ТаблицаСформированныхЛистов, УникальныйИдентификаторФормы)
	
	Если ТаблицаСформированныхЛистов.Количество() = 0 Тогда
		// Добавляем служебную информационную строку:
		СтрокаВерхнегоУровня = ТаблицаСформированныхЛистов.Добавить();
		СтрокаВерхнегоУровня["Наименование"]					= НСтр("ru='поиск не дал результатов'");
		СтрокаВерхнегоУровня["ПредставлениеНалоговогоПериода"]	= НСтр("ru='данные отсутствуют'");
		СтрокаВерхнегоУровня["Картинка"]						= БиблиотекаКартинок.Информация;
		СтрокаВерхнегоУровня["ЭтоПустойЛист"]					= Истина;
		
		ТабДокумент = РегламентированныеРегистры.ПолучитьПредставлениеОтчетаСПустымРезультатом(ПараметрыОтчета);
		ДанныеЛиста = Новый Структура("ТабличныйДокумент", ТабДокумент);
		СтрокаВерхнегоУровня["АдресХранилищаСДаннымиЛиста"] = ПоместитьВоВременноеХранилище(
			ДанныеЛиста,
			УникальныйИдентификаторФормы);
			
	Иначе
		// Упорядочиваем дерево листов по дате:
		ТаблицаСформированныхЛистов.Сортировать("ДатаНачалаПериода");
		
		// Размещаем отдельно данные каждого листа в хранилище:
		Для Каждого СтрокаВерхнегоУровня Из ТаблицаСформированныхЛистов Цикл
			СтрокаВерхнегоУровня["АдресХранилищаСДаннымиЛиста"] = ПоместитьВоВременноеХранилище(
				СписокСформированныхЛистов.Получить(СтрокаВерхнегоУровня["ИндексСоответствующейСтрокиСписка"]).Значение,
				УникальныйИдентификаторФормы);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры


Функция ПолучитьНастройкиСКД(ПараметрыОтчета)
	
	Результат = Новый Структура("
		|ИспользуемаяСхемаКомпоновкиДанных,
		|НовыйКомпоновщикНастроек");
	
	// Возвращаемые объекты:
	ИспользуемаяСхемаКомпоновкиДанных	= ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	НовыйКомпоновщикНастроек			= Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ИспользуемаяСхемаКомпоновкиДанных));
	НовыйКомпоновщикНастроек.ЗагрузитьНастройки(ИспользуемаяСхемаКомпоновкиДанных.ВариантыНастроек["Основной"].Настройки);
	
	// Настраиваем схему.
	
	// Значения параметров схемы:
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаНачала",	ПараметрыОтчета["НачалоПериода"]);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ДатаКонца",		ПараметрыОтчета["КонецПериода"]);
	ВыводимыеЧастиЖурнала = Новый СписокЗначений();
	Если ПараметрыОтчета["ВыводитьЧасть1"] Тогда
		ВыводимыеЧастиЖурнала.Добавить(Перечисления.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры);
	КонецЕсли;
	Если ПараметрыОтчета["ВыводитьЧасть2"] Тогда
		ВыводимыеЧастиЖурнала.Добавить(Перечисления.ЧастиЖурналаУчетаСчетовФактур.ПолученныеСчетаФактуры);
	КонецЕсли;
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ВыводимыеЧастиЖурнала",	ВыводимыеЧастиЖурнала);
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	ПричиныНалогообложенияШкурыЛом = Новый СписокЗначений();
	ПричиныНалогообложенияШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом);
	ПричиныНалогообложенияШкурыЛом.Добавить(Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ПричиныНалогообложенияШкурыЛом", ПричиныНалогообложенияШкурыЛом);
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(НовыйКомпоновщикНастроек, "ВалютаРУ", ВалютаРУ);
	
	// Копируем отбор, установленный в форме отчета:
	СтандартныеОтчетыКлиентСервер.СкопироватьОтбор(
		НовыйКомпоновщикНастроек.Настройки.Отбор,
		ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор);
	
	// Настройки группировок:
	Настройки = НовыйКомпоновщикНастроек.Настройки;
	ГруппировкаНалоговыйПериод				= Настройки.Структура[0];
	ГруппировкаНалоговыйПериодКонтрагент	= Настройки.Структура[1];
	ГруппировкаОднимСписком					= Настройки.Структура[2];
	ГруппировкаОднимСпискомКонтрагент		= Настройки.Структура[3];
	
	Если ПараметрыОтчета["ГруппироватьПоКонтрагентам"] Тогда
		ГруппировкаНалоговыйПериод.Использование			= Ложь;
		ГруппировкаНалоговыйПериодКонтрагент.Использование	= Истина;
		ГруппировкаОднимСписком.Использование				= Ложь;
		ГруппировкаОднимСпискомКонтрагент.Использование		= Истина;
	Иначе
		ГруппировкаНалоговыйПериод.Использование			= Истина;
		ГруппировкаНалоговыйПериодКонтрагент.Использование	= Ложь;
		ГруппировкаОднимСписком.Использование				= Истина;
		ГруппировкаОднимСпискомКонтрагент.Использование		= Ложь;
	КонецЕсли;
	
	Результат["ИспользуемаяСхемаКомпоновкиДанных"]	= ИспользуемаяСхемаКомпоновкиДанных;
	Результат["НовыйКомпоновщикНастроек"]			= НовыйКомпоновщикНастроек;
	
	Возврат Результат;
	
КонецФункции


Функция ВывестиЖурналЗаНалоговыйПериод(ПараметрыОтчета, ГруппировкаНалоговыйПериод)
	
	// Возвращаемое значение:
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ЖурналУчетаСчетовФактур";
	
	// Используемый макет:
	Макет = ПолучитьИспользуемыйМакет();
	
	//---
	// Заголовок
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",			ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("ДатаНачалаПериода",		ГруппировкаНалоговыйПериод["ДатаНачалаПериода"]);
	ПараметрыОбласти.Вставить("ДатаОкончанияПериода",	ГруппировкаНалоговыйПериод["ДатаОкончанияПериода"]);
	ПараметрыОбласти.Вставить("ВыводитьОтбор",			ПараметрыОтчета["ВыводитьОтбор"]);
	ПараметрыОбласти.Вставить("Отбор",					Строка(ПараметрыОтчета["КомпоновщикНастроек"].Настройки.Отбор));
	ПараметрыОбласти.Вставить("ВыводитьЧасть1",			ПараметрыОтчета["ВыводитьЧасть1"]);
	ПараметрыОбласти.Вставить("ВыводитьЧасть2",			ПараметрыОтчета["ВыводитьЧасть2"]);
	ВывестиЗаголовок(ТабДокумент, ПараметрыОбласти, Макет);	
	
	//---
	// Таблицы частей 1 и 2
	//---
	ВывестиЧастиЖурнала(ТабДокумент, Макет, ГруппировкаНалоговыйПериод, ПараметрыОтчета);
	
	//---
	// Подвал
	//---
	ПараметрыОбласти = Новый Структура();
	ПараметрыОбласти.Вставить("Организация",	ПараметрыОтчета["Организация"]);
	ПараметрыОбласти.Вставить("Дата",			ГруппировкаНалоговыйПериод["ДатаОкончанияПериода"]);
	ВывестиПодвал(ТабДокумент, ПараметрыОбласти, Макет);
	
	// Колонтитулы:
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(ТабДокумент,
		ПараметрыОтчета["Колонтитулы_НаименованиеОтчета"],
		ПараметрыОтчета["Колонтитулы_ТекущийПользователь"],
		ПараметрыОтчета["Организация"]);
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ВывестиЖурналЗаВсеПериодыОднимСписком(ПараметрыОтчета, ГруппировкаОднимСписком)
	
	// Возвращаемое значение:
