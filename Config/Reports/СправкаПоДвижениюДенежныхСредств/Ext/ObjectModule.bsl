#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ВыводитьВалютныеПоказатели = Ложь;
	
	ПараметрПоказательВалютнаяСумма = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("ПоказательВалютнаяСумма");
	Если НЕ ПараметрПоказательВалютнаяСумма = Неопределено Тогда
		ПараметрПоказательВалютнаяСуммаПользовательскаяНастройка = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ПараметрПоказательВалютнаяСумма.ИдентификаторПользовательскойНастройки);
		Если НЕ ПараметрПоказательВалютнаяСуммаПользовательскаяНастройка = Неопределено Тогда
			ВыводитьВалютныеПоказатели = ПараметрПоказательВалютнаяСуммаПользовательскаяНастройка.Использование
											И ПараметрПоказательВалютнаяСуммаПользовательскаяНастройка.Значение;
		КонецЕсли;
	КонецЕсли;
	
	МассивПолейСВалютойРегУчета = Новый Массив();
	МассивПолейСВалютойРегУчета.Добавить(Новый ПолеКомпоновкиДанных("Поступило1718ВВалютеРегУчета"));
	МассивПолейСВалютойРегУчета.Добавить(Новый ПолеКомпоновкиДанных("СуммаПоступленийБСВВалютеРегУчета"));
	МассивПолейСВалютойРегУчета.Добавить(Новый ПолеКомпоновкиДанных("ОтклонениеПоступленияВВалютеРегУчета"));
	МассивПолейСВалютойРегУчета.Добавить(Новый ПолеКомпоновкиДанных("Выбыло1718ВВалютеРегУчета"));
	МассивПолейСВалютойРегУчета.Добавить(Новый ПолеКомпоновкиДанных("СуммаВыбытийБСВВалютеРегУчета"));
	МассивПолейСВалютойРегУчета.Добавить(Новый ПолеКомпоновкиДанных("ОтклонениеВыбытияВВалютеРегУчета"));
	
	МассивПолейСВалютой = Новый Массив();
	МассивПолейСВалютой.Добавить(Новый ПолеКомпоновкиДанных("Поступило1718ВВалюте"));
	МассивПолейСВалютой.Добавить(Новый ПолеКомпоновкиДанных("СуммаПоступленийБСВВалюте"));
	МассивПолейСВалютой.Добавить(Новый ПолеКомпоновкиДанных("ОтклонениеПоступленияВВалюте"));
	МассивПолейСВалютой.Добавить(Новый ПолеКомпоновкиДанных("Выбыло1718ВВалюте"));
	МассивПолейСВалютой.Добавить(Новый ПолеКомпоновкиДанных("СуммаВыбытийБСВВалюте"));
	МассивПолейСВалютой.Добавить(Новый ПолеКомпоновкиДанных("ОтклонениеВыбытияВВалюте"));
	
	Для Каждого ВыбранноеПолеКД Из КомпоновщикНастроек.Настройки.Выбор.Элементы Цикл
		Если НЕ ТипЗнч(ВыбранноеПолеКД) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Если ВыбранноеПолеКД.Заголовок = "Показатели" Тогда
			ВыбранноеПолеКД.Использование = ВыводитьВалютныеПоказатели;
			Продолжить;
		КонецЕсли;
		Для Каждого ВложенноеПолеКД Из ВыбранноеПолеКД.Элементы Цикл
			Если НЕ МассивПолейСВалютойРегУчета.Найти(ВложенноеПолеКД.Поле) = Неопределено Тогда
				ВложенноеПолеКД.Использование = НЕ ВыводитьВалютныеПоказатели;
			ИначеЕсли НЕ МассивПолейСВалютой.Найти(ВложенноеПолеКД.Поле) = Неопределено Тогда
				ВложенноеПолеКД.Использование = ВыводитьВалютныеПоказатели;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти   

#Область ПрограммныйИнтерфейс

