#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	СтандартнаяОбработка=ЛОжь;
	
	Организация = Неопределено;
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	ПараметрОрганизация = Настройки.ПараметрыДанных.Элементы.Найти("Организация");
	Если ПараметрОрганизация<>Неопределено Тогда
		Организация = ПараметрОрганизация.Значение;
	КонецЕсли;
	
	ПараметрАдрес = Настройки.ПараметрыДанных.Элементы.Найти("АдресТаблицыКодыТМЦ");
	Если ПараметрАдрес<>Неопределено Тогда
		
		ТаблицаКодыМЦ = Отчеты.КарточкаКоличественноСуммовогоУчетаМЦ.ПолучитьТаблицуКодыМЦ(Организация);
		
		АдресТаблицыКодыМЦ = ПоместитьВоВременноеХранилище(ТаблицаКодыМЦ);
		
		ПараметрАдрес.Значение = АдресТаблицыКодыМЦ;
		ПараметрАдрес.Использование = Истина;
	КонецЕсли;
	
	ВидСубконтоОС = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства;
	ВидСубконтоНоменклатура = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
	ВидСубконтоЦМО = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
	ВидСубконтоКонтрагенты = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
	ВидСубконтоДоговоры = ПланыВидовХарактеристик.ВидыСубконто.Договоры;
	
	//параметы счета заполняем по субконто, т.к. у пользователей могут быть свои счета
	ПараметрСчетаМЗ = Настройки.ПараметрыДанных.Элементы.Найти("СчетаМЗ");	
	
	Если ПараметрСчетаМЗ<>Неопределено Тогда
		
		//счета 105 с субконто 1 МЗ, 2 ЦМО
		НастройкаОтбора = Новый Структура;
		НастройкаОтбора.Вставить("СсылкаВИерархии",БухгалтерскийУчет.СписокСчетов("105.00",,Истина));
		НастройкаОтбора.Вставить("ВидСубконто1",ВидСубконтоНоменклатура);
		НастройкаОтбора.Вставить("ВидСубконто2",ВидСубконтоЦМО);
		
		СчетаМЗ = ПолучитьСчетаПоНастройке(НастройкаОтбора);
	
		//СчетаМЗ = БухгалтерскийУчет.СписокСчетов("105.21,105.22,105.23,105.24,105.25,105.26,105.27,105.А8,105.31,105.32,105.33,105.34,105.35,105.36,105.37,105.В8,105.44,105.46");	
		
		ПараметрСчетаМЗ.Значение = СчетаМЗ;
		ПараметрСчетаМЗ.Использование = Истина;
	КонецЕсли;
	
	СчетаДляКарточки = БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00,107.00,01,02,05,07,08,09,12,13,21,22,23,24,25,26,27",,Истина);
	
	ПараметрСчетаМЦ_ЦМО = Настройки.ПараметрыДанных.Элементы.Найти("СчетаМЦ_ЦМО");
	Если ПараметрСчетаМЦ_ЦМО<>Неопределено Тогда
		//счета ОС с субконто 1 ОС/Номенклатура, 2 ЦМО
		
		НастройкаОтбора = Новый Структура;

		НастройкаОтбора.Вставить("СсылкаВИерархии",СчетаДляКарточки);
		
		МассивВС1 = Новый Массив;
		МассивВС1.Добавить(ВидСубконтоНоменклатура);
		МассивВС1.Добавить(ВидСубконтоОС);
		
		НастройкаОтбора.Вставить("ВидСубконто1",МассивВС1);
		НастройкаОтбора.Вставить("ВидСубконто2",ВидСубконтоЦМО);
		
		СчетаМЦ_ЦМО = ПолучитьСчетаПоНастройке(НастройкаОтбора);
				
		ПараметрСчетаМЦ_ЦМО.Значение = СчетаМЦ_ЦМО;
		ПараметрСчетаМЦ_ЦМО.Использование = Истина;
	КонецЕсли;
	
	ПараметрСчетаМЦ_ДД_ЦМО = Настройки.ПараметрыДанных.Элементы.Найти("СчетаМЦ_ДД_ЦМО");
	Если ПараметрСчетаМЦ_ДД_ЦМО<>Неопределено Тогда
		//счета с субконто 1 Виды денежных документов, 2 Денежные документы, 3 ЦМО 
		
		НастройкаОтбора = Новый Структура;
		
		НастройкаОтбора.Вставить("СсылкаВИерархии",СчетаДляКарточки);
		НастройкаОтбора.Вставить("ВидСубконто1",ПланыВидовХарактеристик.ВидыСубконто.ВидыДенежныхДокументов);
		НастройкаОтбора.Вставить("ВидСубконто2",ПланыВидовХарактеристик.ВидыСубконто.ДенежныеДокументы);
		НастройкаОтбора.Вставить("ВидСубконто3",ВидСубконтоЦМО);
		
		СчетаМЦ_ДД_ЦМО = ПолучитьСчетаПоНастройке(НастройкаОтбора);
		
		//СчетаМЦ_ДД_ЦМО = БухгалтерскийУчет.СписокСчетов("08");
		
		ПараметрСчетаМЦ_ДД_ЦМО.Значение = СчетаМЦ_ДД_ЦМО;
		ПараметрСчетаМЦ_ДД_ЦМО.Использование = Истина;
	КонецЕсли;
	
	ПараметрСчетаКНТ_МЦ = Настройки.ПараметрыДанных.Элементы.Найти("СчетаКНТ_МЦ");
	Если ПараметрСчетаКНТ_МЦ<>Неопределено Тогда
		//счета с субконто 1 Контрагенты, 2 ОС/Номенклатура, 3 - нет, или не используется, главное, что не ЦМО 
		
		НастройкаОтбора = Новый Структура;

		МассивВС2 = Новый Массив;
		МассивВС2.Добавить(ВидСубконтоНоменклатура);
		МассивВС2.Добавить(ВидСубконтоОС);
		
		НастройкаОтбора.Вставить("СсылкаВИерархии",СчетаДляКарточки);
		НастройкаОтбора.Вставить("ВидСубконто1",ВидСубконтоКонтрагенты);
		НастройкаОтбора.Вставить("ВидСубконто2",МассивВС2);
		НастройкаОтбора.Вставить("НЕВидСубконто3",ВидСубконтоЦМО);
		
		СчетаКНТ_МЦ = ПолучитьСчетаПоНастройке(НастройкаОтбора);
		
		//СчетаКНТ_МЦ = БухгалтерскийУчет.СписокСчетов("107.00,24.10,24.20,24.30,25.10,25.20,25.30,25.50,26.10,26.20,26.30,26.50,27");
		
		ПараметрСчетаКНТ_МЦ.Значение = СчетаКНТ_МЦ;
		ПараметрСчетаКНТ_МЦ.Использование = Истина;
	КонецЕсли;
	
	ПараметрСчетаКНТ__МЦ = Настройки.ПараметрыДанных.Элементы.Найти("СчетаКНТ__МЦ");
	Если ПараметрСчетаКНТ__МЦ<>Неопределено Тогда
		//счета с субконто 1 Контрагенты, 2 - не важно, 3 ОС/Номенклатура 
		
		НастройкаОтбора = Новый Структура;

		МассивВС3 = Новый Массив;
		МассивВС3.Добавить(ВидСубконтоНоменклатура);
		МассивВС3.Добавить(ВидСубконтоОС);
		
		НастройкаОтбора.Вставить("СсылкаВИерархии",СчетаДляКарточки);
		НастройкаОтбора.Вставить("ВидСубконто1",ВидСубконтоКонтрагенты);
		НастройкаОтбора.Вставить("ВидСубконто3",МассивВС3);
		
		СчетаКНТ__МЦ = ПолучитьСчетаПоНастройке(НастройкаОтбора);
		
		//СчетаКНТ__МЦ = БухгалтерскийУчет.СписокСчетов("05");
				
		ПараметрСчетаКНТ__МЦ.Значение = СчетаКНТ__МЦ;
		ПараметрСчетаКНТ__МЦ.Использование = Истина;
	КонецЕсли;
	
	ПараметрСчетаОС_МЦ_ЦМО = Настройки.ПараметрыДанных.Элементы.Найти("СчетаОС_МЦ_ЦМО");
	Если ПараметрСчетаОС_МЦ_ЦМО<>Неопределено Тогда
		//счета с субконто 1 ОС, 2 - Номенклатура, 3 ЦМО 
		
		НастройкаОтбора = Новый Структура;
		
		НастройкаОтбора.Вставить("СсылкаВИерархии",СчетаДляКарточки);
		НастройкаОтбора.Вставить("ВидСубконто1",ВидСубконтоОС);
		НастройкаОтбора.Вставить("ВидСубконто2",ВидСубконтоНоменклатура);
		НастройкаОтбора.Вставить("ВидСубконто3",ВидСубконтоЦМО);
		
		СчетаОС_МЦ_ЦМО = ПолучитьСчетаПоНастройке(НастройкаОтбора);
		
		//СчетаОС_МЦ_ЦМО = БухгалтерскийУчет.СписокСчетов("09");
		
		ПараметрСчетаОС_МЦ_ЦМО.Значение = СчетаОС_МЦ_ЦМО;
		ПараметрСчетаОС_МЦ_ЦМО.Использование = Истина;
	КонецЕсли;
	
	ПараметрСчетаКНТ_МЦ_ЦМО = Настройки.ПараметрыДанных.Элементы.Найти("СчетаКНТ_МЦ_ЦМО");
	Если ПараметрСчетаКНТ_МЦ_ЦМО<>Неопределено Тогда
		//счета с субконто 1 Контрагенты/Договоры, 2 - ОС/Номенклатура, 3 ЦМО 
		
		НастройкаОтбора = Новый Структура;

		МассивВС2 = Новый Массив;
		МассивВС2.Добавить(ВидСубконтоНоменклатура);
		МассивВС2.Добавить(ВидСубконтоОС);
		
		МассивВС1 = Новый Массив;
		МассивВС1.Добавить(ВидСубконтоКонтрагенты);
		МассивВС1.Добавить(ВидСубконтоДоговоры);
		
		НастройкаОтбора.Вставить("СсылкаВИерархии",СчетаДляКарточки);
		НастройкаОтбора.Вставить("ВидСубконто1",МассивВС1);		
		НастройкаОтбора.Вставить("ВидСубконто2",МассивВС2);
		НастройкаОтбора.Вставить("ВидСубконто3",ВидСубконтоЦМО);
		
		СчетаКНТ_МЦ_ЦМО = ПолучитьСчетаПоНастройке(НастройкаОтбора);
		
		//СчетаКНТ_МЦ_ЦМО = БухгалтерскийУчет.СписокСчетов("01,02.10,02.20,02.30,02.50,22");
		
		ПараметрСчетаКНТ_МЦ_ЦМО.Значение = СчетаКНТ_МЦ_ЦМО;
		ПараметрСчетаКНТ_МЦ_ЦМО.Использование = Истина;
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ,ДанныеРасшифровки, Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);

	ПроцессорВывода.НачатьВывод();

	ОбъектыПечати = Новый СписокЗначений;
	НачИндексРасшифровки = 0;
	НачалоТаблицы = 1;
	ЭтоПерваяТаблица = Истина;
	ОбъектПечати = Неопределено;
	ПредОбъектПечати = Неопределено;
	 
	ЭлементРезультата = ПроцессорКомпоновки.Следующий();
	Пока ЭлементРезультата <> Неопределено Цикл
		Если ЭлементРезультата.ЗначенияПараметров.Количество() > 18 Тогда
			ОбъектПечати = ОбъектПечатиИзРасшифровки(ДанныеРасшифровки, НачИндексРасшифровки);
			
			Если НЕ ЭтоПерваяТаблица И ОбъектПечати <> ПредОбъектПечати Тогда
				УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
					ДокументРезультат, НачалоТаблицы, ОбъектыПечати, ПредОбъектПечати);
				НачалоТаблицы = ДокументРезультат.ВысотаТаблицы + 1;	
			КонецЕсли;
					
			Если НЕ ЭтоПерваяТаблица Тогда
				ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;	
			ЭтоПерваяТаблица = Ложь;
			ПредОбъектПечати = ОбъектПечати;
		КонецЕсли;	
		
		ПроцессорВывода.ВывестиЭлемент(ЭлементРезультата);
		ЭлементРезультата = ПроцессорКомпоновки.Следующий();
	КонецЦикла;
	Если ОбъектПечати <> Неопределено Тогда
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ДокументРезультат, НачалоТаблицы, ОбъектыПечати, ОбъектПечати);
	КонецЕсли;
	
	ПроцессорВывода.ЗакончитьВывод();
	КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ОбъектыПечати", ОбъектыПечати);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция возвращает объект печати из данных расшифровки.
//
// Параметры:
//  ДанныеРасшифровки - ДанныеРасшифровкиКомпоновкиДанных - 
//  	данные расшифровки, из которых необходимо получить объект печати.
//  НачИндексРасшифровки - Число - 
//  	начальный индекс элемента расшифровки, с которого необходимо начать поиск объекта печати.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура, СправочникСсылка.ОсновныеСредства, Неопределено - 
//  	найденный объект печати или Неопределено, если объект печати не найден.
Функция ОбъектПечатиИзРасшифровки(ДанныеРасшифровки, НачИндексРасшифровки)
	ОбъектПечати = Неопределено;
	ТипНоменклатура = Тип("СправочникСсылка.Номенклатура");
	ТипОС           = Тип("СправочникСсылка.ОсновныеСредства");

	МаксИндексРасшифровки = ДанныеРасшифровки.Элементы.Количество() - 1;
	ПродолжатьЦикл = Истина;
	Для к = НачИндексРасшифровки по МаксИндексРасшифровки Цикл
		Если ТипЗнч(ДанныеРасшифровки.Элементы[к]) <> Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
			Продолжить;
		КонецЕсли;
			
		Поля = ДанныеРасшифровки.Элементы[к].ПолучитьПоля();
		Для каждого Поле из Поля Цикл
			ТипПоля = ТипЗнч(Поле.Значение); 
			Если (ТипПоля = ТипНоменклатура ИЛИ ТипПоля = ТипОС) И ЗначениеЗаполнено(Поле.Значение) Тогда
				ОбъектПечати = Поле.Значение;	
				ПродолжатьЦикл = Ложь;
				Прервать;
			КонецЕсли;	 
		КонецЦикла;	
		
		Если НЕ ПродолжатьЦикл Тогда
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	НачИндексРасшифровки = МаксИндексРасшифровки + 1;
	
	Возврат ОбъектПечати;
КонецФункции	

Функция ПолучитьСчетаПоНастройке(НастройкаОтбора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУВидыСубконто.Ссылка КАК Ссылка,
		|	ЕПСБУВидыСубконто.НомерСтроки КАК НомерСтроки,
		|	ЕПСБУВидыСубконто.ВидСубконто КАК ВидСубконто
		|ПОМЕСТИТЬ ТабВидыСубконто
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Счет,
		|	ЕПСБУ.Код КАК Код,
		|	ТабВидыСубконто1.ВидСубконто КАК ВидСубконто1,
		|	ТабВидыСубконто2.ВидСубконто КАК ВидСубконто2,
		|	ТабВидыСубконто3.ВидСубконто КАК ВидСубконто3
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТабВидыСубконто КАК ТабВидыСубконто1
		|		ПО (ТабВидыСубконто1.Ссылка = ЕПСБУ.Ссылка)
		|			И (ТабВидыСубконто1.НомерСтроки = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТабВидыСубконто КАК ТабВидыСубконто2
		|		ПО (ТабВидыСубконто2.Ссылка = ЕПСБУ.Ссылка)
		|			И (ТабВидыСубконто2.НомерСтроки = 2)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТабВидыСубконто КАК ТабВидыСубконто3
		|		ПО (ТабВидыСубконто3.Ссылка = ЕПСБУ.Ссылка)
		|			И (ТабВидыСубконто3.НомерСтроки = 3)
		|ГДЕ
		|	&Условие
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЕПСБУ.Порядок";
	
	Условие = "";
	МассивУсловий = Новый Массив;
	Если НастройкаОтбора.Свойство("Код") Тогда
		МассивУсловий.Добавить("ЕПСБУ.Код ПОДОБНО &Код");
		Запрос.УстановитьПараметр("Код",НастройкаОтбора.Код);
	КонецЕсли;
	
