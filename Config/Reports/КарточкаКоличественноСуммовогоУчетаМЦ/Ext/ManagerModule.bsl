Функция ЭтоРегистрУчета() Экспорт
	
	Возврат Истина;
	
КонецФункции

Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	СвойстваРегистраУчета.Вставить("Организация", 	ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].Значение);
	СвойстваРегистраУчета.Вставить("НачалоПериода", ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0].Значение.ДатаНачала);
	СвойстваРегистраУчета.Вставить("КонецПериода", 	ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0].Значение.ДатаОкончания);
	СвойстваРегистраУчета.Вставить("Подразделение", ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[2].Значение);
	
КонецПроцедуры	

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "КарточкаКоличественноСуммовогоУчета");
	НастройкиВарианта.Описание = НСтр("ru = '(устарел с 01.01.2018) Карточка количественно-суммового учета'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "КарточкаКоличественноСуммовогоУчета194н");
	НастройкиВарианта.Описание = НСтр("ru = 'Карточка количественно-суммового учета (в ред. приказа 194н)'");
	
КонецПроцедуры

Функция ПолучитьТаблицуКодыМЦ(Знач Организация) Экспорт
	
	ТаблицаКодыМЦ = Новый ТаблицаЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК МЦОС
	|ПОМЕСТИТЬ ТабОС
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Организация = &Организация
	|	И ОсновныеСредства.ГрупповойУчет = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабОС.МЦОС КАК ГрафаМЦ,
	|	ЕСТЬNULL(ТабИнвНомера.ИнвНомер, """") КАК КодМЦ
	|ИЗ
	|	ТабОС КАК ТабОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МИНИМУМ(ИнвентарныеНомераОС.Код) КАК ИнвНомер,
	|			ИнвентарныеНомераОС.ОС КАК ОС
	|		ИЗ
	|			Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|		ГДЕ
	|			ИнвентарныеНомераОС.ОС В
	|					(ВЫБРАТЬ
	|						ТабОС.МЦОС КАК МЦОС
	|					ИЗ
	|						ТабОС КАК ТабОС)
	|			И ИнвентарныеНомераОС.ПометкаУдаления = ЛОЖЬ
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ИнвентарныеНомераОС.ОС) КАК ТабИнвНомера
	|		ПО ТабОС.МЦОС = ТабИнвНомера.ОС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	Номенклатура.НоменклатурныйНомер
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.НоменклатурныйНомер <> """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДенежныеДокументы.Ссылка,
	|	ДенежныеДокументы.Серия + "" №"" + ДенежныеДокументы.Номер
	|ИЗ
	|	Справочник.ДенежныеДокументы КАК ДенежныеДокументы";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаКодыМЦ = РезультатЗапроса.Выгрузить();
	
	Для Каждого СтрТЧ Из ТаблицаКодыМЦ Цикл
		СтрТЧ.КодМЦ = СокрЛП(СтрТЧ.КодМЦ);	
	КонецЦикла;
	
	ТаблицаКодыМЦ.Индексы.Добавить("ГрафаМЦ");
	
	Возврат ТаблицаКодыМЦ;
	
КонецФункции

