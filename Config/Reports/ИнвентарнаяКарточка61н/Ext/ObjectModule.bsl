#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ВариантыОтчетов

// Задать настройки формы отчета.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения
//         - Неопределено
//   КлючВарианта - Строка
//                - Неопределено
//   Настройки - см. ОтчетыКлиентСервер.НастройкиОтчетаПоУмолчанию
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	Настройки.РазрешеноИзменятьСтруктуру = Ложь;
	Настройки.События.ПриСозданииНаСервере = Истина;
	Настройки.События.ПередЗагрузкойВариантаНаСервере    = Истина; 
	Настройки.События.ПередЗагрузкойНастроекВКомпоновщик = Истина;
КонецПроцедуры

// См. ОтчетыПереопределяемый.ПриСозданииНаСервере.
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	// Если есть контекст, определим его для установки параметров СКД при контекстном вызове отчета.
	КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ЭтоКонтекстныйВызов", Ложь);
	ДанныеДокумента = Неопределено;
	Объекты = Неопределено;
	Если Форма.Параметры.Свойство("ПараметрКоманды", Объекты)
		И ЗначениеЗаполнено(Объекты) Тогда 
		
		Если ТипЗнч(Объекты) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			МассивОбъектов = Новый Массив;
			МассивОбъектов.Добавить(Объекты);
			
		ИначеЕсли ТипЗнч(Объекты) = Тип("Массив") 
			И Объекты.Количество() <> 0 
			И ТипЗнч(Объекты[0]) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			МассивОбъектов = Объекты;
			
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Объекты))
			ИЛИ (ТипЗнч(Объекты) = Тип("Массив") 
			И Объекты.Количество() = 1 
			И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Объекты[0]))) Тогда
			
			ДанныеДокумента = СтруктураДанныхДокумента();
			ДанныеДокумента(Объекты, ДанныеДокумента);
			МассивОбъектов = ДанныеДокумента.Объекты;
			
		ИначеЕсли ТипЗнч(Объекты) = Тип("Массив") 
			И Объекты.Количество() > 1 
			И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Объекты[0])) Тогда
			ТекстСообщения = НСтр("ru = 'Инвентарные карточки объектов можно сформировать только по одному документу.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			Возврат;
		КонецЕсли;	
		
		ПараметрОбъектыНФА = Новый Структура("ОбъектыНФА", Отчеты.ИнвентарнаяКарточка61н.ПараметрДанных(МассивОбъектов));
		Отчеты.ИнвентарнаяКарточка61н.УстановитьПараметрыДанных(КомпоновщикНастроек.Настройки, ПараметрОбъектыНФА);   
		КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ЭтоКонтекстныйВызов", Истина);
	КонецЕсли;  
	
	// Период получения данных.
	Период = Неопределено;
	Если ДанныеДокумента <> Неопределено И ЗначениеЗаполнено(ДанныеДокумента.Дата) Тогда       
		// Данные передаются из контекста
		ПараметрПериод = Новый Структура("Период", Отчеты.ИнвентарнаяКарточка61н.ПараметрДанных(КонецДня(ДанныеДокумента.Дата)));
		
	ИначеЕсли Форма.Параметры.Свойство("Период", Период)
		И ЗначениеЗаполнено(Период) Тогда 
		ПараметрПериод = Новый Структура("Период", Отчеты.ИнвентарнаяКарточка61н.ПараметрДанных(КонецДня(Период)));
		
	Иначе
		ПараметрПериод = Новый Структура(
			"Период", Отчеты.ИнвентарнаяКарточка61н.ПараметрДанных(КонецДня(ОбщегоНазначенияБГУ.РабочаяДатаПользователя())));
	КонецЕсли;
	Отчеты.ИнвентарнаяКарточка61н.УстановитьПараметрыДанных(КомпоновщикНастроек.Настройки, ПараметрПериод);   
	
	// Организация.
	Организация = Неопределено;
	Если ДанныеДокумента <> Неопределено И ЗначениеЗаполнено(ДанныеДокумента.Организация) Тогда       
		// Данные передаются из контекста
		ПараметрОрганизация = Новый Структура("Организация", Отчеты.ИнвентарнаяКарточка61н.ПараметрДанных(ДанныеДокумента.Организация));
		
	ИначеЕсли Форма.Параметры.Свойство("Организация", Организация)
		И ЗначениеЗаполнено(Организация) Тогда 
		ПараметрОрганизация = Новый Структура("Организация", Отчеты.ИнвентарнаяКарточка61н.ПараметрДанных(Организация));
		
	ИначеЕсли ТипЗнч(Объекты) = Тип("Массив") И Объекты.Количество() > 0
		И ТипЗнч(Объекты[0]) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		ПараметрОрганизация = Новый Структура("Организация", 
			Отчеты.ИнвентарнаяКарточка61н.ПараметрДанных(
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объекты[0], "Организация")));
			
	ИначеЕсли ТипЗнч(Объекты) = Тип("СправочникСсылка.ОсновныеСредства") 
		И ЗначениеЗаполнено(Объекты) Тогда
		ПараметрОрганизация = Новый Структура("Организация", 
		Отчеты.ИнвентарнаяКарточка61н.ПараметрДанных(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объекты, "Организация")));
		
	Иначе
		ПараметрОрганизация = Новый Структура(
		"Организация", Отчеты.ИнвентарнаяКарточка61н.ПараметрДанных(ОбщегоНазначенияБГУ.ТекущаяОрганизация()));
	КонецЕсли;
	Отчеты.ИнвентарнаяКарточка61н.УстановитьПараметрыДанных(КомпоновщикНастроек.Настройки, ПараметрОрганизация);
	Отчеты.ИнвентарнаяКарточка61н.ЗаполнитьОтветственногоИсполнителя(
	КомпоновщикНастроек.Настройки, ПараметрОрганизация.Организация.ЗначениеПараметра);
КонецПроцедуры

// См. ОтчетыПереопределяемый.ПередЗагрузкойВариантаНаСервере.
Процедура ПередЗагрузкойВариантаНаСервере(Форма, НовыеНастройкиКД) Экспорт
	
	СтруктураПараметровДанных = Новый Структура;
	Для Каждого ТекущийПараметр Из КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл
		Если ТекущийПараметр.Использование Тогда
			СтруктураПараметровДанных.Вставить(
				Строка(ТекущийПараметр.Параметр), Отчеты.ИнвентарнаяКарточка61н.ПараметрДанных(ТекущийПараметр.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Отчеты.ИнвентарнаяКарточка61н.УстановитьПараметрыДанных(НовыеНастройкиКД, СтруктураПараметровДанных);
	
	ЭтоКонтекстныйВызов = Ложь;
	Если КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Свойство("ЭтоКонтекстныйВызов", ЭтоКонтекстныйВызов) Тогда
		НовыеНастройкиКД.ДополнительныеСвойства.Вставить("ЭтоКонтекстныйВызов", ЭтоКонтекстныйВызов);
	КонецЕсли;	
КонецПроцедуры

// Вызывается перед загрузкой новых настроек. Используется для изменения СКД отчета.
//
// Параметры:
//   Контекст - Произвольный
//   КлючСхемы - Строка
//   КлючВарианта - Строка
//                - Неопределено
//   НовыеНастройкиКД - НастройкиКомпоновкиДанных
//                    - Неопределено
//   НовыеПользовательскиеНастройкиКД - ПользовательскиеНастройкиКомпоновкиДанных
//                                    - Неопределено
//
Процедура ПередЗагрузкойНастроекВКомпоновщик(
		Контекст, КлючСхемы, КлючВарианта, НовыеНастройкиКД, НовыеПользовательскиеНастройкиКД) Экспорт
		
	ЭтоКонтекстныйВызов = Ложь;
	Если (КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Свойство("ЭтоКонтекстныйВызов", ЭтоКонтекстныйВызов) 
		ИЛИ НовыеНастройкиКД.ДополнительныеСвойства.Свойство("ЭтоКонтекстныйВызов", ЭтоКонтекстныйВызов))
		И ЭтоКонтекстныйВызов Тогда
		
		СтруктураПараметровДанных = Новый Структура;
		Для Каждого ТекущийПараметр Из КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл
			Если ТекущийПараметр.Использование Тогда
				СтруктураПараметровДанных.Вставить(Строка(ТекущийПараметр.Параметр), 
				Отчеты.ИнвентарнаяКарточка61н.ПараметрДанных(ТекущийПараметр.Значение));
			КонецЕсли;
		КонецЦикла;
		
		Отчеты.ИнвентарнаяКарточка61н.УстановитьПараметрыДанных(НовыеНастройкиКД, СтруктураПараметровДанных, НовыеПользовательскиеНастройкиКД);
	КонецЕсли;	
	
	Если КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Свойство("ЭтоКонтекстныйВызов") Тогда
		КомпоновщикНастроек.Настройки.ДополнительныеСвойства.ЭтоКонтекстныйВызов = Ложь;           
	КонецЕсли;	
	Если НовыеНастройкиКД.ДополнительныеСвойства.Свойство("ЭтоКонтекстныйВызов") Тогда
		НовыеНастройкиКД.ДополнительныеСвойства.ЭтоКонтекстныйВызов = Ложь;
	КонецЕсли;	
КонецПроцедуры 

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДокументРезультат.Очистить();

	ИсполняемыеНастройки = КомпоновщикНастроек.ПолучитьНастройки();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ИсполняемыеНастройки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных, , , Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	ОтчетПустой = Результат.Количество() = 0;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ОтчетПустой", ОтчетПустой);

	// Запрос возвращает поля "Основное средство" и "Инвентарный номер", чтобы была возможность сортировки по 
	// инвентарному номеру. Для групповых ОС будет несколько строк 
	// Инвентарная карточка строится по объектам, поэтому таблицу нужно свернуть по объекту ОС
	Результат.Свернуть("ОсновноеСредство");
	
	МассивОбъектов = Новый Массив;
	Для Каждого ОбъектОС Из Результат Цикл
		МассивОбъектов.Добавить(ОбъектОС.ОсновноеСредство);
	КонецЦикла;
	
	ИменаФайловПечати = Новый Соответствие;
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыПечати = Новый Структура;   
	ПараметрПериод = ИсполняемыеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	Если ПараметрПериод <> Неопределено Тогда
		ПараметрыПечати.Вставить("ДатаСведений", КонецДня(ПараметрПериод.Значение));
	КонецЕсли;	
	
	ПараметрОтветственныйИсполнитель = ИсполняемыеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("ОтветственныйИсполнитель"));
	Если ПараметрОтветственныйИсполнитель <> Неопределено 
		И ЗначениеЗаполнено(ПараметрОтветственныйИсполнитель.Значение) Тогда
		ПараметрыПечати.Вставить("Исполнитель", ПараметрОтветственныйИсполнитель.Значение);
	КонецЕсли;	
	
	ПараметрыПечати.Вставить("СворачиватьАмортизациюПрошлыхЛет", Ложь);
	ПараметрСворачиватьАмортизацию = ИсполняемыеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("СворачиватьАмортизациюПрошлыхЛет"));
	Если ПараметрСворачиватьАмортизацию <> Неопределено 
		И ПараметрСворачиватьАмортизацию.Значение <> Неопределено
		И ПараметрСворачиватьАмортизацию.Значение Тогда
		ПараметрыПечати.Вставить("СворачиватьАмортизациюПрошлыхЛет", ПараметрСворачиватьАмортизацию.Значение);
	КонецЕсли;	
	
	ТабДок = Справочники.ОсновныеСредства.ПечатьИнвентарнойКарточки61н(
		МассивОбъектов, ПараметрыПечати, ОбъектыПечати, ИменаФайловПечати);
		
	// ОбъектыПечати можно добавить в доп. свойства пользовательских настроек и они будут доступны в форме 
	// отчета после его формирования 	
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ОбъектыПечати", ОбъектыПечати);
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить(
		"ПользовательскиеНастройкиМодифицированы", Истина);
	
	ДокументРезультат.Вывести(ТабДок);	
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтруктураДанныхДокумента()
	Возврат(Новый Структура("Дата, Организация, Объекты", 
		'00010101', Справочники.Организации.ПустаяСсылка(), Новый Массив));
КонецФункции	

Процедура ДанныеДокумента(Доки, ДанныеДокумента)
	Док = Документы.ПередачаОбъектовОС.ПустаяСсылка();
	Если ТипЗнч(Доки) = Тип("Массив") Тогда
		Док = Доки[0];
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Доки)) Тогда
		Док = Доки;
	КонецЕсли;	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТабЧасть.ОсновноеСредство КАК ОсновноеСредство,
	|	ТабЧасть.Ссылка.Дата КАК Дата,
	|	ТабЧасть.Ссылка.Организация КАК Организация
	|ИЗ
	|	&ВидДокумента КАК ТабЧасть
	|ГДЕ
	|	ТабЧасть.Ссылка = &Док
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабЧасть.ОсновноеСредство,
	|	ТабЧасть.Ссылка.Дата,
	|	ТабЧасть.Ссылка.Организация";
	
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса, "&ВидДокумента", "Документ." + Док.Метаданные().Имя + ".ОсновныеСредства");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Док", Док);
	Таблица = Запрос.Выполнить().Выгрузить();
	
	ДанныеДокумента.Вставить("Объекты", Таблица.ВыгрузитьКолонку("ОсновноеСредство"));
	Если Таблица.Количество() <> 0 Тогда
		ЗаполнитьЗначенияСвойств(ДанныеДокумента, Таблица[0], "Дата, Организация");
	КонецЕсли;	                                                
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
