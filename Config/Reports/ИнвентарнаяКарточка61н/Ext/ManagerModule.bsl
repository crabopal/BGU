#Область СлужебныйПрограммныйИнтерфейс

Функция ЭтоРегистрУчета() Экспорт
	
	Возврат Истина;
	
КонецФункции

Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	НастройкиКН = ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрыДанных = НастройкиКН.ПараметрыДанных;
	Параметр = ПараметрыДанных.Элементы.Найти("Организация");
	Если Параметр <> Неопределено Тогда
		СвойстваРегистраУчета.Вставить("Организация", Параметр.Значение);
	КонецЕсли;
	Параметр = ПараметрыДанных.Элементы.Найти("Период");
	Если Параметр <> Неопределено Тогда
		КонецПериода = Параметр.Значение;
		Если ТипЗнч(КонецПериода) = Тип("СтандартнаяДатаНачала") Тогда
			КонецПериода = КонецПериода.Дата;
		КонецЕсли;	
		СвойстваРегистраУчета.Вставить("КонецПериода", КонецДня(КонецПериода));
	КонецЕсли;
	СвойстваРегистраУчета.Вставить("НачалоПериода", '00010101');
	
	Параметр = ПараметрыДанных.Элементы.Найти("ОбъектыНФА");
	Если Параметр <> Неопределено Тогда   
		Если ТипЗнч(Параметр.Значение) = Тип("СписокЗначений") Тогда
			Если СвойстваРегистраУчета.Свойство("Объект") И ЗначениеЗаполнено(СвойстваРегистраУчета.Объект) Тогда
				ТекОбъекты = СвойстваРегистраУчета.Объект;

				// Т.к. отчет строился по списку объектов, а свойства регистра собираем для одного объекта,
				// заменим компоновщик настроек и установим ему новый параметр отбора по текущему объекту
				РегистрыУчета.УстановитьВСвойстваКомпоновщикСОтборомПоОбъекту(
					НастройкиКН, Параметр, СвойстваРегистраУчета);
			Иначе	
				ТекОбъекты = Параметр.Значение.ВыгрузитьЗначения();
			КонецЕсли;	
		Иначе
			ТекОбъекты = Параметр.Значение;
		КонецЕсли;	
		ДополнениеИмени = СтрокаОбъектовДляОписанияРегистраУчета(ТекОбъекты);
		СвойстваРегистраУчета.Вставить("ДополнениеИмени", ДополнениеИмени);
	КонецЕсли;
КонецПроцедуры

// СтандартныеПодсистемы.ВариантыОтчетов

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиОтчета.ОпределитьНастройкиФормы = Истина;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ИнвентарнаяКарточка61н");
	НастройкиВарианта.Описание = НСтр("ru = 'Инвентарная карточка (приказ 61н)'");
	//НастройкиВарианта.Размещение.Вставить(Метаданные.Подсистемы.ТаксиОсновныеСредства, "");
	
КонецПроцедуры

// Определяет состав программного интерфейса для интеграции с конфигурацией.
//
// Параметры:
//   Настройки - Структура - Настройки интеграции этого объекта.
//       См. возвращаемое значение функции ПодключаемыеКоманды.НастройкиПодключаемыхОтчетовИОбработок().
//
Процедура ПриОпределенииНастроек(Настройки) Экспорт       
	Настройки.Размещение.Добавить(Метаданные.Справочники.ОсновныеСредства);
	Настройки.Размещение.Добавить(Метаданные.Документы.ПередачаОбъектовОС);
	Настройки.Размещение.Добавить(Метаданные.Документы.ПередачаОбъектовИК);
	Настройки.Размещение.Добавить(Метаданные.Документы.АктОбУтилизацииОС);
	Настройки.Размещение.Добавить(Метаданные.Документы.АктОбУтилизацииОСИК);
	Настройки.Размещение.Добавить(Метаданные.Документы.СписаниеОбъектовОС);
	Настройки.Размещение.Добавить(Метаданные.Документы.СписаниеОбъектовИК);
    Настройки.ДобавитьКомандыОтчетов = Истина;
КонецПроцедуры     

// Определяет список команд отчетов.
//
// Параметры:
//   КомандыОтчетов - ТаблицаЗначений - Таблица с командами отчетов. Для изменения.
//       См. описание 1 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт

	Если ПравоДоступа("Просмотр", Метаданные.Отчеты.ИнвентарнаяКарточка61н) Тогда
		
		Команда = КомандыОтчетов.Добавить();
		Команда.Представление = НСтр("ru = 'Инвентарная карточка (приказ 61н)'");
		Команда.КлючВарианта  = "ИнвентарнаяКарточка61н";
		Команда.Картинка = БиблиотекаКартинок.Отчет;
		Команда.МножественныйВыбор = Истина;
		//Команда.Менеджер = "Отчет.ИнвентарнаяКарточка61н";
		Команда.ЕстьУсловияВидимости = Истина;
		ВидыНФА = Новый Массив;
		ВидыНФА.Добавить(Перечисления.ВидыНФА.НМА);
		ВидыНФА.Добавить(Перечисления.ВидыНФА.ОС);
		ВидыНФА.Добавить(Перечисления.ВидыНФА.НПА);
		ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды(
			Команда, "ВидНФА", ВидыНФА, ВидСравненияКомпоновкиДанных.ВСписке);
		
	КонецЕсли;

КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

Процедура УстановитьПараметрыДанных(Настройки, ЗначенияПараметров, ПользовательскиеНастройки = Неопределено) Экспорт
	
	ПараметрыДанных = Настройки.ПараметрыДанных.Элементы;
	
	Для Каждого ЗначениеПараметра Из ЗначенияПараметров Цикл 
		
		ПараметрДанных = ПараметрыДанных.Найти(ЗначениеПараметра.Ключ);
		
		Если ПараметрДанных = Неопределено Тогда
             Продолжить;
		КонецЕсли;
		
		ПараметрДанных.Использование = ЗначениеПараметра.Значение.Использование;
		ПараметрДанных.Значение = ЗначениеПараметра.Значение.ЗначениеПараметра;
		
		Если Не ЗначениеЗаполнено(ПараметрДанных.ИдентификаторПользовательскойНастройки)
			Или ТипЗнч(ПользовательскиеНастройки) <> Тип("ПользовательскиеНастройкиКомпоновкиДанных") Тогда 
			Продолжить;
		КонецЕсли;
		
		СоответствующийПараметр = ПользовательскиеНастройки.Элементы.Найти(
			ПараметрДанных.ИдентификаторПользовательскойНастройки);
		
		Если СоответствующийПараметр <> Неопределено Тогда 
			ЗаполнитьЗначенияСвойств(СоответствующийПараметр, ПараметрДанных, "Использование, Значение");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПараметрДанных(ЗначениеПараметра, Использование = Истина) Экспорт

	Возврат Новый Структура("ЗначениеПараметра, Использование", ЗначениеПараметра, Использование);
	
КонецФункции

Процедура ЗаполнитьОтветственногоИсполнителя(НастройкиКомпоновщика, ТекОрганизация) Экспорт
	Организации = Новый Массив;
	Организации.Добавить(ТекОрганизация);
	ЕстьЦБ = ПолучитьФункциональнуюОпцию("ИспользоватьЦентрализованнуюБухгалтерию");
	Если ЕстьЦБ Тогда
		ОрганизацияЦБ = Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить();
		Если ЗначениеЗаполнено(ОрганизацияЦБ) Тогда
			Организации.Добавить(ОрганизацияЦБ);
		КонецЕсли;	
	КонецЕсли;	 

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ПОМЕСТИТЬ Контрагенты
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО Контрагенты.ЮридическоеФизическоеЛицо = Пользователи.ФизическоеЛицо
	|ГДЕ
	|	Пользователи.Ссылка = &Пользователь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.Владелец КАК Организация
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Контрагенты КАК Контрагенты
	|		ПО Сотрудники.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	Сотрудники.Владелец В (&Организации)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организации", Организации);
	Запрос.УстановитьПараметр("Пользователь", Пользователи.АвторизованныйПользователь());
	
	Выборка = Запрос.Выполнить().Выбрать();
	ОтветственныйИсполнитель = Справочники.Сотрудники.ПустаяСсылка();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Организация = ТекОрганизация Тогда
			ОтветственныйИсполнитель = Выборка.Сотрудник;
			Прервать;
		ИначеЕсли ЕстьЦБ И Выборка.Организация = ОрганизацияЦБ И ЗначениеЗаполнено(ОрганизацияЦБ) Тогда
			ОтветственныйИсполнитель = Выборка.Сотрудник;
		КонецЕсли;	
	КонецЦикла;	

	ПараметрОтветственныйИсполнитель = 
		Новый Структура("ОтветственныйИсполнитель", ПараметрДанных(ОтветственныйИсполнитель, Истина));
	УстановитьПараметрыДанных(НастройкиКомпоновщика, ПараметрОтветственныйИсполнитель);
КонецПроцедуры	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтрокаОбъектовДляОписанияРегистраУчета(ТекОбъекты)
	Результат = "";
	
	Объекты = Новый Массив; 
	Если ТипЗнч(ТекОбъекты) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		Объекты.Добавить(ТекОбъекты);
	Иначе
		Объекты = ТекОбъекты;
	КонецЕсли;	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнвентарныеНомераОС.ОС КАК ОсновноеСредство,
	|	МАКСИМУМ(ИнвентарныеНомераОС.Код) КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ТабИнвНомера
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.ОС В (&ОС)
	|	И НЕ ИнвентарныеНомераОС.ОС.ГрупповойУчет
	|	И НЕ ИнвентарныеНомераОС.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	ИнвентарныеНомераОС.ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПРЕДСТАВЛЕНИЕ(ОсновныеСредства.Ссылка) КАК ОсновноеСредствоПредставление,
	|	ЕСТЬNULL(ТабИнвНомера.ИнвентарныйНомер, """") КАК ИнвентарныйНомер
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабИнвНомера КАК ТабИнвНомера
	|		ПО ОсновныеСредства.Ссылка = ТабИнвНомера.ОсновноеСредство
	|ГДЕ
	|	ОсновныеСредства.Ссылка В (&ОС)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ОС", Объекты);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Результат
		+ ?(ЗначениеЗаполнено(Результат), "; ", " ") 
		+ СокрЛП(Выборка.ОсновноеСредствоПредставление) 
		+ ?(ЗначениеЗаполнено(Выборка.ИнвентарныйНомер), " (" + СокрЛП(Выборка.ИнвентарныйНомер) + ")", ""); 
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#КонецЕсли
