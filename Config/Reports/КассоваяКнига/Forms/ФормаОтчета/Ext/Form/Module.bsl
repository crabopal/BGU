
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(Отчет, Параметры);
	
	Если НЕ ЗначениеЗаполнено(Отчет.Организация) Тогда
		Отчет.Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	КонецЕсли;
	
	Отчет.Фондовые = 1;
	
	Если Не ЗначениеЗаполнено(Отчет.НачалоПериода) Тогда
		Отчет.НачалоПериода = НачалоДня(ТекущаяДата());
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Отчет.КонецПериода) Тогда
		Отчет.КонецПериода = КонецДня(ТекущаяДата());
	КонецЕсли;
	
	Если НЕ ПолучитьФункциональнуюОпцию("ФондоваяКнигаОтдельноОтДенежной") Тогда
		Элементы.Фондовые.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ВывестиТолькоТитульныеЛисты.Доступность = Отчет.ВывестиТитульныеЛисты;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоВсемОрганизациямПриИзменении(Элемент)
	
	Если Отчет.ПоВсемОрганизациям Тогда
		
		Отчет.Организация = ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка");
		Отчет.Подразделение = ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка");
		
	КонецЕсли;	
		
	Элементы.Организация.Доступность = НЕ Отчет.ПоВсемОрганизациям;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Подразделение", "Доступность", НЕ Отчет.ПоВсемОрганизациям);

КонецПроцедуры

&НаКлиенте
Процедура ВывестиТитульныеЛистыПриИзменении(Элемент)
	
	Отчет.ВывестиТолькоТитульныеЛисты = Отчет.ВывестиТолькоТитульныеЛисты И Отчет.ВывестиТитульныеЛисты;
	
	Элементы.ВывестиТолькоТитульныеЛисты.Доступность = Отчет.ВывестиТитульныеЛисты;
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	ОчиститьСообщения();
	
	Отказ = Ложь;
	
	СформироватьОтчетСервер(Отказ);
	
	
	Если Отказ Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Нет данных для печати. Проверьте параметры отчета.'"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	
	Диалог.Период.ДатаНачала 	= Отчет.НачалоПериода;
	Диалог.Период.ДатаОкончания = Отчет.КонецПериода;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьПериодЗавершение", ЭтотОбъект);
	
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьПериодЗавершение(Период, ДополнительныеПараметры) Экспорт
	
	Если Период <> Неопределено Тогда
		
		Отчет.НачалоПериода = Период.ДатаНачала;
		Отчет.КонецПериода  = Период.ДатаОкончания;
		
	КонецЕсли;

КонецПроцедуры

// Процедура вызывает заполнение отчета. В случае формирования по одной
 // организации, удаляются все дополнительные закладки и таблицы с формы,
 // кроме стандартных.
 // В случае формирования отчета по всем организациям, закладка Кассовая книга
 // прячется и на форме создаются закладки и таблицы для каждой организации.
 // 
&НаСервере
Процедура СформироватьОтчетСервер(Отказ = Ложь)
	
	Если Не ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДатаНачала", 		НачалоДня(Отчет.НачалоПериода));
	Запрос.УстановитьПараметр("ДатаКонца", 			КонецДня(Отчет.КонецПериода));
	Запрос.УстановитьПараметр("ПоВсемОрганизациям", Отчет.ПоВсемОрганизациям);	
	Запрос.УстановитьПараметр("Организация", 		Отчет.Организация);	
	Запрос.УстановитьПараметр("ЕстьПодразделение", 	ЗначениеЗаполнено(Отчет.Подразделение)); 	
	Запрос.УстановитьПараметр("Подразделение", 		Отчет.Подразделение);	
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЛистКассовойКниги.Организация,
	|	ВЫБОР
	|		КОГДА ЛистКассовойКниги.Подразделение.ВедетсяКассоваяКнига
	|			ТОГДА ЛистКассовойКниги.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ЛистКассовойКниги.Организация.ИспользоватьВПлатежныхДокументахСокращенноеНаименование
	|			ТОГДА ЛистКассовойКниги.Организация.НаименованиеСокращенное
	|		КОГДА ЛистКассовойКниги.Организация.НаименованиеПолное = """"
	|			ТОГДА ЛистКассовойКниги.Организация.Наименование
	|		ИНАЧЕ ЛистКассовойКниги.Организация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	ЛистКассовойКниги.Организация.Наименование КАК ОргНаименование,
	|	ЛистКассовойКниги.Организация.Код КАК ОргКод,
	|	ЛистКассовойКниги.Организация.КодОКПО КАК КодОКПО,
	|	ВЫБОР
	|		КОГДА ЛистКассовойКниги.Подразделение.ВедетсяКассоваяКнига
	|			ТОГДА ВЫБОР
	|					КОГДА ЛистКассовойКниги.Подразделение.НаименованиеПолное = """"
	|						ТОГДА ЛистКассовойКниги.Подразделение.Наименование
	|					ИНАЧЕ ЛистКассовойКниги.Подразделение.НаименованиеПолное
	|				КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НаименованиеПодразделения,
	|	ВЫБОР
	|		КОГДА ЛистКассовойКниги.Подразделение.ВедетсяКассоваяКнига
	|			ТОГДА ЛистКассовойКниги.Подразделение.Наименование
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПодрНаименование,
	|	ВЫБОР
	|		КОГДА ЛистКассовойКниги.Подразделение.ВедетсяКассоваяКнига
	|			ТОГДА ЛистКассовойКниги.Подразделение.Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПодрКод,
	|	ОтветственныеЛицаГлавныйБухгалтер.ОтветственноеЛицо КАК ГлБухгалтер,
	|	ОтветственныеЛицаРуководитель.ОтветственноеЛицо КАК Руководитель,
	|	ЛистКассовойКниги.Ссылка КАК ЛистКассовойКнигиСсылка,
	|	ЛистКассовойКниги.КоличествоЛистов КАК КолВоЛистов,
	|	ЛистКассовойКниги.Дата КАК Дата,
	|	ЛистКассовойКниги.НомерЛиста КАК НомерЛиста
	|ПОМЕСТИТЬ ВсеЛистыКниги
	|ИЗ
	|	Документ.ЛистКассовойКниги КАК ЛистКассовойКниги
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&ДатаКонца, ВидОтветственногоЛица = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)) КАК ОтветственныеЛицаРуководитель
	|		ПО ЛистКассовойКниги.Организация = ОтветственныеЛицаРуководитель.Организация
	|			И (ЛистКассовойКниги.Подразделение.ВедетсяКассоваяКнига
	|					И ЛистКассовойКниги.Подразделение = ОтветственныеЛицаРуководитель.Подразделение
	|				ИЛИ (НЕ ЛистКассовойКниги.Подразделение.ВедетсяКассоваяКнига
	|					ИЛИ ЛистКассовойКниги.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|						И (ОтветственныеЛицаРуководитель.Подразделение ЕСТЬ NULL 
	|							ИЛИ ОтветственныеЛицаРуководитель.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&ДатаКонца, ВидОтветственногоЛица = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер)) КАК ОтветственныеЛицаГлавныйБухгалтер
	|		ПО ЛистКассовойКниги.Организация = ОтветственныеЛицаГлавныйБухгалтер.Организация
	|					И (ЛистКассовойКниги.Подразделение.ВедетсяКассоваяКнига
	|						И ЛистКассовойКниги.Подразделение = ОтветственныеЛицаГлавныйБухгалтер.Подразделение
	|				ИЛИ (НЕ ЛистКассовойКниги.Подразделение.ВедетсяКассоваяКнига
	|					ИЛИ ЛистКассовойКниги.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|						И (ОтветственныеЛицаГлавныйБухгалтер.Подразделение ЕСТЬ NULL 
	|							ИЛИ ОтветственныеЛицаГлавныйБухгалтер.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))))
	|ГДЕ
	|	ЛистКассовойКниги.Проведен
	|	И ЛистКассовойКниги.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|	И (&ЕстьПодразделение
	|				И ЛистКассовойКниги.Подразделение = &Подразделение
	|			ИЛИ НЕ &ЕстьПодразделение
	|				И (ЛистКассовойКниги.Подразделение ЕСТЬ NULL 
	|					ИЛИ ЛистКассовойКниги.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|					ИЛИ НЕ ЛистКассовойКниги.Подразделение.ВедетсяКассоваяКнига)
	|			ИЛИ &ПоВсемОрганизациям)
	|	И (НЕ &ПоВсемОрганизациям
	|				И ЛистКассовойКниги.Организация = &Организация
	|			ИЛИ &ПоВсемОрганизациям)";
	
	Если НЕ ПолучитьФункциональнуюОпцию("ФондоваяКнигаОтдельноОтДенежной") Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЛистКассовойКнигиФондовый.Организация,
		|	ВЫБОР
		|		КОГДА ЛистКассовойКнигиФондовый.Подразделение.ВедетсяКассоваяКнига
		|			ТОГДА ЛистКассовойКнигиФондовый.Подразделение
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЛистКассовойКнигиФондовый.Организация.ИспользоватьВПлатежныхДокументахСокращенноеНаименование
		|			ТОГДА ЛистКассовойКнигиФондовый.Организация.НаименованиеСокращенное
		|		КОГДА ЛистКассовойКнигиФондовый.Организация.НаименованиеПолное = """"
		|			ТОГДА ЛистКассовойКнигиФондовый.Организация.Наименование
		|		ИНАЧЕ ЛистКассовойКнигиФондовый.Организация.НаименованиеПолное
		|	КОНЕЦ,
		|	ЛистКассовойКнигиФондовый.Организация.Наименование,
		|	ЛистКассовойКнигиФондовый.Организация.Код,
		|	ЛистКассовойКнигиФондовый.Организация.КодОКПО,
		|	ВЫБОР
		|		КОГДА ЛистКассовойКнигиФондовый.Подразделение.ВедетсяКассоваяКнига
		|			ТОГДА ВЫБОР
		|					КОГДА ЛистКассовойКнигиФондовый.Подразделение.НаименованиеПолное = """"
		|						ТОГДА ЛистКассовойКнигиФондовый.Подразделение.Наименование
		|					ИНАЧЕ ЛистКассовойКнигиФондовый.Подразделение.НаименованиеПолное
		|				КОНЕЦ
		|		ИНАЧЕ """"
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЛистКассовойКнигиФондовый.Подразделение.ВедетсяКассоваяКнига
		|			ТОГДА ЛистКассовойКнигиФондовый.Подразделение.Наименование
		|		ИНАЧЕ """"
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЛистКассовойКнигиФондовый.Подразделение.ВедетсяКассоваяКнига
		|			ТОГДА ЛистКассовойКнигиФондовый.Подразделение.Код
		|		ИНАЧЕ """"
		|	КОНЕЦ,
		|	ОтветственныеЛицаГлавныйБухгалтер.ОтветственноеЛицо,
		|	ОтветственныеЛицаРуководитель.ОтветственноеЛицо,
		|	ЛистКассовойКнигиФондовый.Ссылка,
		|	ЛистКассовойКнигиФондовый.КоличествоЛистов,
		|	ЛистКассовойКнигиФондовый.Дата,
		|	ЛистКассовойКнигиФондовый.НомерЛиста
		|ИЗ
		|	Документ.ЛистКассовойКнигиФондовый КАК ЛистКассовойКнигиФондовый
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&ДатаКонца, ВидОтветственногоЛица = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)) КАК ОтветственныеЛицаРуководитель
		|		ПО ЛистКассовойКнигиФондовый.Организация = ОтветственныеЛицаРуководитель.Организация
		|			И (ЛистКассовойКнигиФондовый.Подразделение.ВедетсяКассоваяКнига
		|					И ЛистКассовойКнигиФондовый.Подразделение = ОтветственныеЛицаРуководитель.Подразделение
		|				ИЛИ (НЕ ЛистКассовойКнигиФондовый.Подразделение.ВедетсяКассоваяКнига
		|					ИЛИ ЛистКассовойКнигиФондовый.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|						И (ОтветственныеЛицаРуководитель.Подразделение ЕСТЬ NULL 
		|							ИЛИ ОтветственныеЛицаРуководитель.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&ДатаКонца, ВидОтветственногоЛица = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер)) КАК ОтветственныеЛицаГлавныйБухгалтер
		|		ПО ЛистКассовойКнигиФондовый.Организация = ОтветственныеЛицаГлавныйБухгалтер.Организация
		|					И (ЛистКассовойКнигиФондовый.Подразделение.ВедетсяКассоваяКнига
		|						И ЛистКассовойКнигиФондовый.Подразделение = ОтветственныеЛицаГлавныйБухгалтер.Подразделение
		|				ИЛИ (НЕ ЛистКассовойКнигиФондовый.Подразделение.ВедетсяКассоваяКнига
		|					ИЛИ ЛистКассовойКнигиФондовый.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|						И (ОтветственныеЛицаГлавныйБухгалтер.Подразделение ЕСТЬ NULL 
		|							ИЛИ ОтветственныеЛицаГлавныйБухгалтер.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))))
		|ГДЕ
		|	ЛистКассовойКнигиФондовый.Проведен
		|	И ЛистКассовойКнигиФондовый.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
		|	И (&ЕстьПодразделение
		|				И ЛистКассовойКнигиФондовый.Подразделение = &Подразделение
		|			ИЛИ НЕ &ЕстьПодразделение
		|				И (ЛистКассовойКнигиФондовый.Подразделение ЕСТЬ NULL 
		|					ИЛИ ЛистКассовойКнигиФондовый.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|					ИЛИ НЕ ЛистКассовойКнигиФондовый.Подразделение.ВедетсяКассоваяКнига)
		|			ИЛИ &ПоВсемОрганизациям)
		|	И (НЕ &ПоВсемОрганизациям
		|				И ЛистКассовойКнигиФондовый.Организация = &Организация
		|			ИЛИ &ПоВсемОрганизациям)";
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеЛистыКниги.Организация КАК Организация,
	|	ВсеЛистыКниги.Подразделение КАК Подразделение,
	|	ВсеЛистыКниги.ОргКод,
	|	ВсеЛистыКниги.ОргНаименование,
	|	ВсеЛистыКниги.НаименованиеОрганизации,
	|	ВсеЛистыКниги.КодОКПО,
	|	ВсеЛистыКниги.ПодрКод,
	|	ВсеЛистыКниги.ПодрНаименование,
	|	ВсеЛистыКниги.НаименованиеПодразделения,
	|	ФИОГлБухгалтер.Фамилия КАК ГлБухгалтерФамилия,
	|	ФИОГлБухгалтер.Имя КАК ГлБухгалтерИмя,
	|	ФИОГлБухгалтер.Отчество КАК ГлБухгалтерОтчество,
	|	ФИОРуководитель.Фамилия КАК РуководительФамилия,
	|	ФИОРуководитель.Имя КАК РуководительИмя,
	|	ФИОРуководитель.Отчество КАК РуководительОтчество,
	|	СУММА(ВсеЛистыКниги.КолВоЛистов) КАК КолВоЛистов
	|ИЗ
	|	ВсеЛистыКниги КАК ВсеЛистыКниги
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&ДатаКонца, ) КАК ФИОГлБухгалтер
	|		ПО ВсеЛистыКниги.ГлБухгалтер.Контрагент.ЮридическоеФизическоеЛицо = ФИОГлБухгалтер.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц.СрезПоследних КАК ФИОРуководитель
	|		ПО ВсеЛистыКниги.Руководитель.Контрагент.ЮридическоеФизическоеЛицо = ФИОРуководитель.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	ВсеЛистыКниги.ОргНаименование,
	|	ВсеЛистыКниги.ОргКод,
	|	ВсеЛистыКниги.НаименованиеОрганизации,
	|	ВсеЛистыКниги.КодОКПО,
	|	ФИОРуководитель.Имя,
	|	ФИОРуководитель.Отчество,
	|	ВсеЛистыКниги.Организация,
	|	ВсеЛистыКниги.Подразделение,
	|	ВсеЛистыКниги.ПодрКод,
	|	ВсеЛистыКниги.ПодрНаименование,
	|	ВсеЛистыКниги.НаименованиеПодразделения,
	|	ФИОГлБухгалтер.Фамилия,
	|	ФИОГлБухгалтер.Имя,
	|	ФИОГлБухгалтер.Отчество,
	|	ФИОРуководитель.Фамилия
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеЛистыКниги.Организация КАК Организация,
	|	ВсеЛистыКниги.Подразделение КАК Подразделение,
	|	ВсеЛистыКниги.ЛистКассовойКнигиСсылка
	|ИЗ
	|	ВсеЛистыКниги КАК ВсеЛистыКниги
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	Подразделение,
	|	ВсеЛистыКниги.Дата,
	|	ВсеЛистыКниги.НомерЛиста";
	
	
	Если ПолучитьФункциональнуюОпцию("ФондоваяКнигаОтдельноОтДенежной") И Отчет.Фондовые = 2 Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ЛистКассовойКниги", "Документ.ЛистКассовойКнигиФондовый");
		
	КонецЕсли;
	
	
			
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаОрганизации = МассивРезультатов[1].Выбрать();
	
	ТаблицаДокументов =  МассивРезультатов[2].Выгрузить();
	
	Отказ = ВыборкаОрганизации.Количество() = 0;
	
	// удалим все добавленные элементы
	МассивУдаляемыхРеквизитов = Новый Массив;
	МассивУдаляемыхЭлементов = Новый Массив;
	Для ТекИнд = 2 по Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.Количество() Цикл
		МассивУдаляемыхРеквизитов.Добавить(Элементы.ГруппаСтраниц.ПодчиненныеЭлементы[ТекИнд-1].ПодчиненныеЭлементы[0].ПутьКДанным);	
		МассивУдаляемыхЭлементов.Добавить(Элементы.ГруппаСтраниц.ПодчиненныеЭлементы[ТекИнд-1]);
	КонецЦикла;
	Для каждого Элемент из МассивУдаляемыхЭлементов Цикл
		Элементы.Удалить(Элемент);
	КонецЦикла;
	ИзменитьРеквизиты(, МассивУдаляемыхРеквизитов);
	
	Если Отказ Тогда
		
		КассоваяКнига.Очистить();
		Элементы.ГруппаСтраниц.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		Элементы.ГруппаКассоваяКнига.Видимость = Истина;
		
		Возврат;
		
	КонецЕсли;	

	ТипыРеквизита = Новый Массив;
	ТипыРеквизита.Добавить(Тип("ТабличныйДокумент"));
	ОписаниеТиповРеквизитов = Новый ОписаниеТипов(ТипыРеквизита);
	
	КассовыеКниги = Новый Массив;
	 
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ОтчетКассира");
	 
	ОбластьТитульныйЛист = Макет.ПолучитьОбласть("ТитульныйЛист"); 
	
	Пока ВыборкаОрганизации.Следующий() Цикл
		
		КассоваяКнигаОрганизации = Новый ТабличныйДокумент;
		
		Если Отчет.ВывестиТитульныеЛисты Тогда
			
			СтруктураОбл = Новый Структура;
			СтруктураОбл.Вставить("РуководительФИО", 		КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", ВыборкаОрганизации.РуководительФамилия, ВыборкаОрганизации.РуководительИмя, ВыборкаОрганизации.РуководительОтчество), Истина));					
			СтруктураОбл.Вставить("ГлБухгалтерФИО", 		КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", ВыборкаОрганизации.ГлБухгалтерФамилия, ВыборкаОрганизации.ГлБухгалтерИмя, ВыборкаОрганизации.ГлБухгалтерОтчество), Истина));
			СтруктураОбл.Вставить("КолВоЛистовПрописью",	ЧислоПрописью(ВыборкаОрганизации.КолВоЛистов, , " лист, листа, листов, м,,,,,0"));
			СтруктураОбл.Вставить("ЗаПериод", 				"За " + ПредставлениеПериода(НачалоДня(Отчет.НачалоПериода), КонецДня(Отчет.КонецПериода), "ФП = Истина")); 
			
			ОбластьТитульныйЛист.Параметры.Заполнить(ВыборкаОрганизации);
            ОбластьТитульныйЛист.Параметры.Заполнить(СтруктураОбл);
			
            КассоваяКнигаОрганизации.Вывести(ОбластьТитульныйЛист);
			
			КассоваяКнигаОрганизации.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЕсли;	
		
		Если НЕ Отчет.ВывестиТолькоТитульныеЛисты Тогда
			
			ВрТаблица = ТаблицаДокументов.Скопировать(Новый Структура("Организация, Подразделение", ВыборкаОрганизации.Организация, ВыборкаОрганизации.Подразделение));
			
			МассивОбъектов = ВрТаблица.ВыгрузитьКолонку("ЛистКассовойКнигиСсылка");
			
			ОбъектыПечати = Новый СписокЗначений;
			
			КассоваяКнигаОрганизации.Вывести(КассаОрганизации.ПечатьОтчетаКассира(МассивОбъектов, ОбъектыПечати, , , , "ПФ_MXL_ОтчетКассира"));
			
			//Элемент и реквизит формы для размещения кассовой книги
			МассивДобавляемыхРеквизитов = Новый Массив;
			
			ИДКассовойКниги = СокрЛП(ВыборкаОрганизации.ОргКод) + СокрЛП(ВыборкаОрганизации.ПодрКод);
			
			НовСтр = Элементы.Добавить("Страница" + ИДКассовойКниги, Тип("ГруппаФормы"), Элементы.ГруппаСтраниц);
			НовСтр.Заголовок = ВыборкаОрганизации.ПодрНаименование + " " + ВыборкаОрганизации.ОргНаименование;
			
			НовыйРеквизит = Новый РеквизитФормы("Таблица" + ИДКассовойКниги, ОписаниеТиповРеквизитов);
			МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
			ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
			
			КассовыеКниги.Добавить(НовСтр);
			
			НовТаб=Элементы.Добавить("Таблица" + ИДКассовойКниги, Тип("ПолеФормы"), НовСтр);
			НовТаб.ПутьКДанным="Таблица" + ИДКассовойКниги;
			НовТаб.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
			
			ЭтаФорма["Таблица" + ИДКассовойКниги].Очистить();
			ЭтаФорма["Таблица" + ИДКассовойКниги].Вывести(КассоваяКнигаОрганизации);
			
		Иначе
			
			КассоваяКнига.Вывести(КассоваяКнигаОрганизации);

		КонецЕсли;
		
	КонецЦикла;	
	
	Если Отчет.ВывестиТолькоТитульныеЛисты Тогда
		
		Элементы.ГруппаКассоваяКнига.Видимость = Истина;
		
		КассовыеКниги.Добавить(Элементы.ГруппаКассоваяКнига);
		
	Иначе
		
		Элементы.ГруппаКассоваяКнига.Видимость = Ложь;
		
	КонецЕсли;	
	
	
	Если КассовыеКниги.Количество() > 1 Тогда
		
		Элементы.ГруппаСтраниц.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
		
	Иначе
	
		Элементы.ГруппаСтраниц.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		
	КонецЕсли;
	
	Элементы.ГруппаСтраниц.ТекущаяСтраница = КассовыеКниги[0];
		
 КонецПроцедуры

 #КонецОбласти




