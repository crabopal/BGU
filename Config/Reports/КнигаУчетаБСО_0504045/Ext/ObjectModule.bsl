#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем НачалоПериода; // Дата
Перем КонецПериода; // Дата
Перем ПараметрыГруппировок; // Структура

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Задать настройки формы отчета.
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения, Неопределено -
//   КлючВарианта - Строка, Неопределено -
//   Настройки - см. ОтчетыКлиентСервер.НастройкиОтчетаПоУмолчанию
//
Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	Настройки.РазрешеноИзменятьСтруктуру = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДокументРезультат.Очистить();

	ИсполняемыеНастройки = КомпоновщикНастроек.ПолучитьНастройки();

	ПараметрКД = ИсполняемыеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	НачалоПериода = ПараметрКД.Значение.ДатаНачала;
	КонецПериода = ПараметрКД.Значение.ДатаОкончания;

	СхемаКомпоновкиДанных = Отчеты.КнигаУчетаБСО_0504045.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("ИспользоватьУчетПоПодразделениям"),
		ИспользоватьУчетПоПодразделениям);
	ИспользоватьОтборПоПодразделениям = Ложь;
	ПараметрКД = ИсполняемыеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("Подразделение"));
	Если ПараметрКД <> Неопределено Тогда
		Если ПараметрКД.Использование Тогда
			ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра(
				Новый ПараметрКомпоновкиДанных("ПодразделениеОтбор"),
				ПараметрКД.Значение);
			Если ИспользоватьУчетПоПодразделениям Тогда
				Если БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("03", , КонецПериода).УчетПоПодразделениям Тогда
					ИспользоватьОтборПоПодразделениям = Истина;
				КонецЕсли;
			КонецЕсли;
		Иначе
			ПараметрКД.Использование = Истина;
		КонецЕсли;
	КонецЕсли;
	ИсполняемыеНастройки.ПараметрыДанных.УстановитьЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("ИспользоватьОтборПоПодразделениям"),
		ИспользоватьОтборПоПодразделениям);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ИсполняемыеНастройки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных, , , Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	ДеревоРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	ОтчетПустой = ДеревоРезультат.Строки.Количество() = 0;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ОтчетПустой", ОтчетПустой);

	ПараметрыГруппировок = Новый Структура;
	ПараметрыГруппировок.Вставить("ЕстьЦМО", ДеревоРезультат.Колонки.Найти("ЦМО") <> Неопределено);
	ПараметрыГруппировок.Вставить("ЕстьСотрудник", ДеревоРезультат.Колонки.Найти("Сотрудник") <> Неопределено);

	Макет = УправлениеПечатью.МакетПечатнойФормы("Отчет.КнигаУчетаБСО_0504045.ПФ_MXL_КнигаУчетаБСО");
	Если ПараметрыГруппировок.ЕстьЦМО Или ПараметрыГруппировок.ЕстьСотрудник Тогда
		ОбластьЗаголовок 		= Макет.ПолучитьОбласть("Заголовок");
	Иначе
		ОбластьЗаголовок 		= Макет.ПолучитьОбласть("Заголовок_БезЦМО");
	КонецЕсли;
	ОбластьШапка 				= Макет.ПолучитьОбласть("Шапка");
	ОбластьОстатокНаНачало 		= Макет.ПолучитьОбласть("ОстатокНаНачало");
	ОбластьСтрока 				= Макет.ПолучитьОбласть("Строка");
	ОбластьОстатокНаКонец 		= Макет.ПолучитьОбласть("ОстатокНаКонец");
	ОбластьРасшифровкаОстатка	= Макет.ПолучитьОбласть("РасшифровкаОстатка");
	ОбластьПодвал				= Макет.ПолучитьОбласть("Подвал");

	ПерваяСтраница = Истина;
	ШаблонСтрокиПередачи = "%1 -> %2";

	ТаблицаОстатков = Новый ТаблицаЗначений;
	ТаблицаОстатков.Колонки.Добавить("Серия", Новый ОписаниеТипов("СправочникСсылка.СерииБСО"));
	ТаблицаОстатков.Колонки.Добавить("СерияИд", Новый ОписаниеТипов("Строка"));
	ТаблицаОстатков.Колонки.Добавить("СерияБСОНаименование", Новый ОписаниеТипов("Строка"));
	ТаблицаОстатков.Колонки.Добавить("НомерНачальный", Новый ОписаниеТипов("Число"));
	ТаблицаОстатков.Колонки.Добавить("НомерКонечный", Новый ОписаниеТипов("Число"));
	ТаблицаОстатков.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число"));

	Для Каждого ТекОрганизация Из ДеревоРезультат.Строки Цикл

		ВывелиГлавныйЗаголовок = Ложь;

		Для Каждого ТекБСО Из ТекОрганизация.Строки Цикл
			ТаблицаОстатков.Очистить();
			ВывелиНачОстаток = Ложь;
			ПараметрыОстатков = Новый Структура("ИтогоПриход, ИтогоРасход, КонечныйОстаток", 0, 0, 0);
			
			Для Каждого ДетальнаяЗапись Из ТекБСО.Строки Цикл
				Если Не ДетальнаяЗапись.ЭтоОстатокНаНачало Тогда
					Продолжить;
				КонецЕсли;

				ДобавитьДвижениеВТаблицуОстатков(ТаблицаОстатков, ДетальнаяЗапись);

			КонецЦикла;

			Если ТаблицаОстатков.Количество() > 0 Тогда
				Если Не ВывелиГлавныйЗаголовок Тогда
					ВывестиГлавныйЗаголовок(ДокументРезультат, ТекОрганизация, ОбластьЗаголовок, ПерваяСтраница);
					ВывелиГлавныйЗаголовок = Истина;
				КонецЕсли;

				ВывестиЗаголовок(ДокументРезультат, ТекБСО, ТаблицаОстатков, ОбластьШапка, ОбластьОстатокНаНачало,
					ОбластьРасшифровкаОстатка);
				ВывелиНачОстаток = Истина;
			КонецЕсли;
			
			// обороты
			Для Каждого ДетальнаяЗапись Из ТекБСО.Строки Цикл
				Если ДетальнаяЗапись.ЭтоОстатокНаНачало Или Не (ЗначениеЗаполнено(ДетальнаяЗапись.Приход)
					Или ЗначениеЗаполнено(ДетальнаяЗапись.Расход)) Тогда
					Продолжить;
				КонецЕсли;

				Если Не ВывелиНачОстаток Тогда
					Если Не ВывелиГлавныйЗаголовок Тогда
						ВывестиГлавныйЗаголовок(ДокументРезультат, ТекОрганизация, ОбластьЗаголовок, ПерваяСтраница);
						ВывелиГлавныйЗаголовок = Истина;
					КонецЕсли;
					ВывестиЗаголовок(ДокументРезультат, ТекБСО, ТаблицаОстатков, ОбластьШапка, ОбластьОстатокНаНачало,
						ОбластьРасшифровкаОстатка);
					ВывелиНачОстаток = Истина;
				КонецЕсли;

				ПараметрыСтроки = Новый Структура("ДатаДень, ДатаМесяц, ДатаГод, ЦМОНаименование, ЦМО, РегистраторПредставление, Регистратор, Приход, СерияБСОПриход, НомераБСОПриход, Расход, СерияБСОРасход, НомераБСОРасход, ОстатокНаКонец, СерияБСО, НомераБСО, ОтправительПолучатель");
				ЗаполнитьЗначенияСвойств(ПараметрыСтроки, ДетальнаяЗапись, , "ОстатокНаКонец");
				Если ЗначениеЗаполнено(ДетальнаяЗапись.Приход) Тогда
					ПараметрыСтроки.СерияБСОПриход = ДетальнаяЗапись.СерияБСО;
					ПараметрыСтроки.НомераБСОПриход = ДетальнаяЗапись.ДиапазонНомеров;
				КонецЕсли;
				Если ЗначениеЗаполнено(ДетальнаяЗапись.Расход) Тогда
					ПараметрыСтроки.СерияБСОРасход = ДетальнаяЗапись.СерияБСО;
					ПараметрыСтроки.НомераБСОРасход = ДетальнаяЗапись.ДиапазонНомеров;
				КонецЕсли;
				ПараметрыСтроки.ОтправительПолучатель = СтрШаблон(ШаблонСтрокиПередачи,
					СокрЛП(ДетальнаяЗапись.ОтправительНаименование),
					СокрЛП(ДетальнаяЗапись.ПолучательНаименование));

				ОбластьСтрока.Параметры.Заполнить(ПараметрыСтроки);
				ДокументРезультат.Вывести(ОбластьСтрока);

				ПараметрыОстатков.ИтогоПриход = ПараметрыОстатков.ИтогоПриход + ДетальнаяЗапись.Приход;
				ПараметрыОстатков.ИтогоРасход = ПараметрыОстатков.ИтогоРасход + ДетальнаяЗапись.Расход;

				ДобавитьДвижениеВТаблицуОстатков(ТаблицаОстатков, ДетальнаяЗапись);

			КонецЦикла;

			Если Не ВывелиНачОстаток Тогда
				Продолжить;
			КонецЕсли;
			
			// конечные остатки

			ПараметрыОстатков.КонечныйОстаток = ТекБСО.ОстатокНаНачало + ПараметрыОстатков.ИтогоПриход
				- ПараметрыОстатков.ИтогоРасход;
			ОбластьОстатокНаКонец.Параметры.Заполнить(ПараметрыОстатков);
			ДокументРезультат.Вывести(ОбластьОстатокНаКонец);

			ВывестиРасшифровкуОстатков(ДокументРезультат, ТекБСО, ТаблицаОстатков, ОбластьРасшифровкаОстатка);

			ДокументРезультат.Вывести(ОбластьПодвал);

		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВывестиГлавныйЗаголовок(ДокументРезультат, ТекОрганизация, ОбластьЗаголовок, ПерваяСтраница)
	Если Не ПерваяСтраница Тогда
		ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
	Иначе
		ПерваяСтраница = Ложь;
	КонецЕсли;
	
	ОбластьЗаголовок.Параметры.Заполнить(ТекОрганизация);
	ПараметрыПериод = Новый Структура("НачалоПериода, КонецПериода, ЦМОНаименование", НачалоПериода, КонецПериода);
	Если ПараметрыГруппировок.ЕстьСотрудник Тогда
		ПараметрыПериод.ЦМОНаименование = ТекОрганизация.СотрудникНаименование;
	ИначеЕсли ПараметрыГруппировок.ЕстьЦМО Тогда
		ПараметрыПериод.ЦМОНаименование = ТекОрганизация.МОЛПредставление;
	КонецЕсли;
	ОбластьЗаголовок.Параметры.Заполнить(ПараметрыПериод);
	ДокументРезультат.Вывести(ОбластьЗаголовок);
	
КонецПроцедуры

Процедура ВывестиЗаголовок(ДокументРезультат, ТекБСО, ТаблицаОстатков, ОбластьШапка, ОбластьОстатокНаНачало, ОбластьРасшифровкаОстатка)
	
	ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
	
	// Начальные остатки
	ОбластьШапка.Параметры.Заполнить(ТекБСО);
	ОбластьШапка.Параметры.Заполнить(Новый Структура("БСО", ТекБСО.БСОНаименование));
	ДокументРезультат.Вывести(ОбластьШапка);
	
	ОбластьОстатокНаНачало.Параметры.Заполнить(ТекБСО);
	ДокументРезультат.Вывести(ОбластьОстатокНаНачало);

	ВывестиРасшифровкуОстатков(ДокументРезультат, ТекБСО, ТаблицаОстатков, ОбластьРасшифровкаОстатка);
	
КонецПроцедуры

Процедура ВывестиРасшифровкуОстатков(ДокументРезультат, ТекБСО, ОригинальнаяТаблицаОстатков, ОбластьРасшифровкаОстатка)
	ПараметрыОстатков = Новый Структура("Остаток, Серия, ДиапазонНомеров");
	// Чтобы не сломать сортировку таблицы остатков выводится копия таблицы
	ТаблицаОстатков = ОригинальнаяТаблицаОстатков.Скопировать();
	ТаблицаОстатков.Сортировать("СерияБСОНаименование, НомерНачальный");
	ДокументРезультат.НачатьГруппуСтрок(,Ложь);
	Для каждого ТекСтрОстатков Из ТаблицаОстатков Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыОстатков, ТекСтрОстатков);
		ПараметрыОстатков.ДиапазонНомеров = УправлениеМатериальнымиЗапасами.ПредставлениеДиапазонаНомеров(
			ТекСтрОстатков.НомерНачальный,
			ТекСтрОстатков.НомерКонечный,
			ТекБСО.БСОДлинаНомера);
		ПараметрыОстатков.Остаток = ТекСтрОстатков.Остаток * (1 + ТекСтрОстатков.НомерКонечный - ТекСтрОстатков.НомерНачальный);
		ОбластьРасшифровкаОстатка.Параметры.Заполнить(ПараметрыОстатков);
		ОбластьРасшифровкаОстатка.Параметры.Заполнить(Новый Структура("Серия", ТекСтрОстатков.СерияБСОНаименование));
		ДокументРезультат.Вывести(ОбластьРасшифровкаОстатка);
	КонецЦикла; 
	ДокументРезультат.ЗакончитьГруппуСтрок();
КонецПроцедуры

Процедура ДобавитьДвижениеВТаблицуОстатков(ТаблицаОстатков, СтрокаДвижения)
	
	Если СтрокаДвижения.Приход = СтрокаДвижения.Расход Тогда
		// Не влияет на конечные остатки
		Возврат;
	КонецЕсли;
	
	СерияИД = Строка(СтрокаДвижения.СерияБСО.УникальныйИдентификатор());
	НомерНачальный = СтрокаДвижения.НомерНачальный;
	НомерКонечный = ?(СтрокаДвижения.НомерКонечный = 0, СтрокаДвижения.НомерНачальный, СтрокаДвижения.НомерКонечный);;
	
	Если СтрокаДвижения.Приход <> 0 Тогда
		КоличествоДвижения = ?(СтрокаДвижения.Приход < 0, -1, 1);
	Иначе
		КоличествоДвижения = ?(СтрокаДвижения.Расход < 0, 1, -1);
	КонецЕсли;
	// Первую строку в таблицу можно добавить без дополнительных проверок
	Если ТаблицаОстатков.Количество() = 0 Тогда
		СтрокаОстатков = ТаблицаОстатков.Добавить();
		СтрокаОстатков.Серия = СтрокаДвижения.СерияБСО;
		СтрокаОстатков.СерияИД = СерияИД;
		СтрокаОстатков.СерияБСОНаименование = СтрокаДвижения.СерияБСОНаименование;
		СтрокаОстатков.НомерНачальный = НомерНачальный;
		СтрокаОстатков.НомерКонечный = НомерКонечный;
		СтрокаОстатков.Остаток = КоличествоДвижения;
		Возврат;
	КонецЕсли;
	
	// Определить место вставки нового движения в таблицу остатков.
	// Бинарный поиск по отсортированной таблице.
	Начало = 0;
	Конец = ТаблицаОстатков.Количество() - 1;
	ИндексВставки = Цел((Начало + Конец) / 2);
	
	Пока Начало <= Конец Цикл
		Если ТаблицаОстатков[ИндексВставки].СерияИД < СерияИД
			Или ТаблицаОстатков[ИндексВставки].СерияИД = СерияИД
			И ТаблицаОстатков[ИндексВставки].НомерНачальный < НомерНачальный Тогда
			Начало = ИндексВставки + 1;
		ИначеЕсли ТаблицаОстатков[ИндексВставки].СерияИД > СерияИД
			Или ТаблицаОстатков[ИндексВставки].СерияИД = СерияИД
			И ТаблицаОстатков[ИндексВставки].НомерНачальный > НомерНачальный Тогда
			Конец = ИндексВставки - 1;
		ИначеЕсли ТаблицаОстатков[ИндексВставки].СерияИД = СерияИД
			И ТаблицаОстатков[ИндексВставки].НомерНачальный = НомерНачальный Тогда
			Прервать;
		Иначе
			ИндексВставки = Начало;
			Прервать;
		КонецЕсли;
		ИндексВставки = Цел((Начало + Конец) / 2);
	КонецЦикла;
	
	Если Конец < Начало Тогда
		// В последней итерации Начало и Конец указывали на одну строку, но она должна быть после вставляемой.
		// На ее место и нужно вставить новую строку.
		ИндексВставки = Конец + 1;
	КонецЕсли;
	
	// Если новый диапазон пересекается с предыдущим диапазоном, то его тоже нужно включить в обработку.
	Если ИндексВставки - 1 >= 0
		И ТаблицаОстатков[ИндексВставки - 1].Серия = СтрокаДвижения.СерияБСО
		И ТаблицаОстатков[ИндексВставки - 1].НомерКонечный >= НомерНачальный Тогда
		// Включить предыдущий диапазон в обработку
		ИндексВставки = ИндексВставки - 1;
	КонецЕсли;
	
	// Теперь ИндексВставки содержит индекс, в который нужно вставить новую строку.
	// Его нужно сохранить, для последующей обработки измененных диапазонов
	НачальныйИндексВставки = ИндексВставки;
	
	Пока НомерНачальный <= НомерКонечный Цикл
		
		Если ИндексВставки = ТаблицаОстатков.Количество() Тогда
			СтрокаОстатков = ТаблицаОстатков.Вставить(ИндексВставки);
			СтрокаОстатков.Серия = СтрокаДвижения.СерияБСО;
			СтрокаОстатков.СерияИД = СерияИД;
			СтрокаОстатков.СерияБСОНаименование = СтрокаДвижения.СерияБСОНаименование;
			СтрокаОстатков.НомерНачальный = НомерНачальный;
			СтрокаОстатков.НомерКонечный = НомерКонечный;
			СтрокаОстатков.Остаток = КоличествоДвижения;
			НомерНачальный = СтрокаОстатков.НомерКонечный + 1;
		ИначеЕсли ТаблицаОстатков[ИндексВставки].Серия <> СтрокаДвижения.СерияБСО Тогда
			// Диапазоны по нужной серии закончились. Нужно просто вставить оставшийся приход.
			СтрокаОстатков = ТаблицаОстатков.Вставить(ИндексВставки);
			СтрокаОстатков.Серия = СтрокаДвижения.СерияБСО;
			СтрокаОстатков.СерияИД = СерияИД;
			СтрокаОстатков.СерияБСОНаименование = СтрокаДвижения.СерияБСОНаименование;
			СтрокаОстатков.НомерНачальный = НомерНачальный;
			СтрокаОстатков.НомерКонечный = НомерКонечный;
			СтрокаОстатков.Остаток = КоличествоДвижения;
			НомерНачальный = СтрокаОстатков.НомерКонечный + 1;
			ИндексВставки = ИндексВставки + 1;
		ИначеЕсли НомерНачальный > ТаблицаОстатков[ИндексВставки].НомерКонечный Тогда
			// Этот диапазон должен остаться без изменений
			ИндексВставки = ИндексВставки + 1;
		ИначеЕсли НомерНачальный < ТаблицаОстатков[ИндексВставки].НомерНачальный Тогда
			// Добавляемый диапазон начинается раньше следующего диапазона
			Если НомерКонечный < ТаблицаОстатков[ИндексВставки].НомерНачальный Тогда
				// Добавляемый диапазон полностью умещается в пустое место
				// Просто добавить диапазон
				СтрокаОстатков = ТаблицаОстатков.Вставить(ИндексВставки);
				СтрокаОстатков.Серия = СтрокаДвижения.СерияБСО;
				СтрокаОстатков.СерияИД = СерияИД;
				СтрокаОстатков.СерияБСОНаименование = СтрокаДвижения.СерияБСОНаименование;
				СтрокаОстатков.НомерНачальный = НомерНачальный;
				СтрокаОстатков.НомерКонечный = НомерКонечный;
				СтрокаОстатков.Остаток = КоличествоДвижения;
				НомерНачальный = НомерКонечный + 1;
				ИндексВставки = ИндексВставки + 1;
			Иначе
				// Добавляемый диапазон разбивается на 2.
				// Первая часть просто добавляется, а оставшаяся идет на следующие итерации.
				СтрокаОстатков = ТаблицаОстатков.Вставить(ИндексВставки);
				СтрокаОстатков.Серия = СтрокаДвижения.СерияБСО;
				СтрокаОстатков.СерияИД = СерияИД;
				СтрокаОстатков.СерияБСОНаименование = СтрокаДвижения.СерияБСОНаименование;
				СтрокаОстатков.НомерНачальный = НомерНачальный;
				СтрокаОстатков.НомерКонечный = ТаблицаОстатков[ИндексВставки + 1].НомерНачальный - 1;
				СтрокаОстатков.Остаток = КоличествоДвижения;
				НомерНачальный = СтрокаОстатков.НомерКонечный + 1;
				ИндексВставки = ИндексВставки + 1;
			КонецЕсли;
			
		ИначеЕсли НомерНачальный > ТаблицаОстатков[ИндексВставки].НомерНачальный Тогда
			// Добавляемый диапазон начинается в середине следующего диапазона
			// Разделить следующий диапазон на 2 по НомерНачальный,
			// изменить индекс вставки на вторую половину диапазона
			// и перейти к варианту, когда начальные номера равны
			ТаблицаОстатков.Вставить(ИндексВставки + 1);
			ЗаполнитьЗначенияСвойств(ТаблицаОстатков[ИндексВставки + 1], ТаблицаОстатков[ИндексВставки]);
			ТаблицаОстатков[ИндексВставки + 1].НомерНачальный = НомерНачальный;
			ТаблицаОстатков[ИндексВставки].НомерКонечный = НомерНачальный - 1;
			ИндексВставки = ИндексВставки + 1;
		ИначеЕсли НомерНачальный = ТаблицаОстатков[ИндексВставки].НомерНачальный Тогда
			// Добавляемый диапазон начинается с начала текущего диапазона
			Если НомерКонечный >= ТаблицаОстатков[ИндексВставки].НомерКонечный Тогда
				// Добавляемый диапазон заканчивается за границей проверяемого или равен ему.
				// Нужно разбить добавляемый диапазон на 2, добавить ко всему проверяемуму диапазону
				// и перейти к добавлению следующей части диапазона.
				// Если диапазоны оказались равны, то на этом цикл прервется.
				ТаблицаОстатков[ИндексВставки].Остаток = ТаблицаОстатков[ИндексВставки].Остаток + КоличествоДвижения;
				НомерНачальный = ТаблицаОстатков[ИндексВставки].НомерКонечный + 1;
				ИндексВставки = ИндексВставки + 1;
			Иначе // Если НомерКонечный < ТаблицаОстатков[ИндексВставки].НомерКонечный Тогда
				// Вычитаемый диапазон меньше проверяемого диапазона.
				// Разбить проверяемый диапазон на 2 и перейти к вычитанию из равных диапазонов
				ТаблицаОстатков.Вставить(ИндексВставки + 1);
				ЗаполнитьЗначенияСвойств(ТаблицаОстатков[ИндексВставки + 1], ТаблицаОстатков[ИндексВставки]);
				ТаблицаОстатков[ИндексВставки + 1].НомерНачальный = НомерКонечный + 1;
				ТаблицаОстатков[ИндексВставки].НомерКонечный = НомерКонечный;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	// Диапазоны с нулевым количество удаляются
	ПроверяемыйИндекс = НачальныйИндексВставки;
	Пока ПроверяемыйИндекс < ИндексВставки Цикл
		Если ТаблицаОстатков[ПроверяемыйИндекс].Остаток = 0 Тогда
			ТаблицаОстатков.Удалить(ПроверяемыйИндекс);
			ИндексВставки = ИндексВставки - 1;
		Иначе
			ПроверяемыйИндекс = ПроверяемыйИндекс + 1;
		КонецЕсли;
	КонецЦикла;
	
	// Обработанные диапазоны нужно сравнить с предыдущим и по возможности объединить их
	// Нулевой индекс таблицы не проверяется, т.к. перед ним не строк.
	ПроверяемыйИндекс = Макс(НачальныйИндексВставки, 1);
	Пока ПроверяемыйИндекс <= ИндексВставки И ПроверяемыйИндекс < ТаблицаОстатков.Количество() Цикл
		Если ТаблицаОстатков[ПроверяемыйИндекс - 1].Серия <> ТаблицаОстатков[ПроверяемыйИндекс].Серия Тогда
			// Диапазоны по этой серии закончились
			Прервать;
		ИначеЕсли 1 + ТаблицаОстатков[ПроверяемыйИндекс - 1].НомерКонечный = ТаблицаОстатков[ПроверяемыйИндекс].НомерНачальный
			И ТаблицаОстатков[ПроверяемыйИндекс - 1].Остаток = ТаблицаОстатков[ПроверяемыйИндекс].Остаток Тогда
			// Объединить диапазоны. Предыдущий остается, текущий удаляется.
			ТаблицаОстатков[ПроверяемыйИндекс - 1].НомерКонечный = ТаблицаОстатков[ПроверяемыйИндекс].НомерКонечный;
			ТаблицаОстатков.Удалить(ПроверяемыйИндекс);
			ИндексВставки = ИндексВставки - 1;
		Иначе
			ПроверяемыйИндекс = ПроверяемыйИндекс + 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли