#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Инициализация:
	РегламентированныеРегистры.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	//---
	// Механизм связи полей шапки и отбора
	//---
	СвязьПолейШапкиИОтбора_ПриСозданииНаСервере();
	//---
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьФормуКлиент_ОбновитьЗаголовокФормы();
	
	//---
	// Механизм связи полей шапки и отбора
	//---
	СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_ПриОткрытии(ЭтаФорма, Отчет);
	//---
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ВариантМодифицирован = Ложь;
	
	ПользовательскиеНастройкиМодифицированы = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	РегламентированныеРегистры.ПриСохраненииПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
	РегламентированныеРегистры.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	
	НастроитьФормуСервер_ВидимостьНастроек();
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	
	НастроитьФормуКлиент_ПриИзмененииЭлементаФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура КонецПериодаПриИзменении(Элемент)
	
	НастроитьФормуКлиент_ПриИзмененииЭлементаФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетТабличныйДокументПриАктивизацииОбласти(Элемент)
	
	ИнтервалОжидания = ?(ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая, 1, 0.2);
	
	ПодключитьОбработчикОжидания("Подключаемый_РассчитатьСуммуЯчеек", ИнтервалОжидания, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Отбор

&НаКлиенте
Процедура ОтборПравоеЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СписокЗависимыхПолей = Новый Структура("Подразделение",Новый Структура("МастерПоле, Отбор","Организация", Новый Структура("ПолеОтбора,Форма","Владелец","Справочник.Подразделения")));
	РегламентированныеРегистрыКлиент.ОтборПравоеЗначениеНачалоВыбора(Элемент, СтандартнаяОбработка, Элементы.Отбор.ТекущиеДанные, СписокЗависимыхПолей, Отчет.КомпоновщикНастроек);
КонецПроцедуры

&НаКлиенте
Процедура ОтборПравоеЗначениеПриИзменении(Элемент)
	Если Элементы.Отбор.ТекущиеДанные.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация") Тогда
		СписокПолейДляОчистки = Новый Структура("Подразделение");	
		РегламентированныеРегистрыКлиент.ОтборПравоеЗначениеПриИзмененииОчистка(СписокПолейДляОчистки, Отчет.КомпоновщикНастроек);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДополнительныеНастройки(Команда)
	
	РегламентированныеРегистрыКлиент.СинхронизироватьОтборПользовательскиеНастройки(ЭтаФорма);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("КомпоновщикНастроек",	Отчет.КомпоновщикНастроек);
	ПараметрыФормы.Вставить("Схема",				СхемаКомпоновкиДанных);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОбновитьКомпоновщикНастроек", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.КонструкторПользовательскихНастроек.Форма", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПанельНастроек(Команда)
	
	Отчет["ВидимостьНастроек"] = НЕ Отчет["ВидимостьНастроек"];
	
	НастроитьФормуСервер_ВидимостьНастроек();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	ОчиститьСообщения();
	СформироватьОтчетСервер();	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("НачалоПериода", Отчет.НачалоПериода);
	СтруктураПараметров.Вставить("КонецПериода",  Отчет.КонецПериода);
	
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(СтруктураПараметров, ЭтаФорма, "УстановитьПериодЗавершение");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодЗавершение(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Отчет.НачалоПериода = РезультатВыбора.НачалоПериода;
		Отчет.КонецПериода  = РезультатВыбора.КонецПериода;
		ЭтаФорма.Модифицированность = Истина;
		
		НастроитьФормуКлиент_ПриИзмененииЭлементаФормы();
	КонецЕсли
	
КонецПроцедуры

// Скопировано из общей формы "ФормаОтчета"
&НаКлиенте
Процедура ВычислитьСумму(Команда)
	СуммаВыделенныхЯчеек = ВычислитьСуммуСервер(ОтчетТабличныйДокумент, ВыделенныеОбласти());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере // вызывается из общего модуля
Процедура ОпределитьИменаСохраняемыхРеквизитов() Экспорт
	
	// Реквизиты отчета:
	ИменаСохраняемыхРеквизитовОтчета = "
		|Организация,
		|НачалоПериода,
		|КонецПериода,
		|ВидимостьНастроек";
		
	// Реквизиты формы:
	ИменаСохраняемыхРеквизитовФормы = "";
	
КонецПроцедуры
&НаСервере
Функция ПолучитьПараметрыОтчета()
	
	ПараметрыОтчета = Новый Структура();
	
	ПараметрыОтчета.Вставить("НачалоПериода", 			Отчет["НачалоПериода"]);
	ПараметрыОтчета.Вставить("КонецПериода", 			Отчет["КонецПериода"]);
	ПараметрыОтчета.Вставить("КомпоновщикНастроек", 	Отчет["КомпоновщикНастроек"]);
	ПараметрыОтчета.Вставить("СхемаКомпоновкиДанных", 	СхемаКомпоновкиДанных);
	ПараметрыОтчета.Вставить("УникальныйИдентификатор", ЭтаФорма.УникальныйИдентификатор);
	
	Возврат ПараметрыОтчета;
	
КонецФункции
&НаСервере
Процедура СформироватьОтчетСервер() Экспорт
	
	Если НЕ ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрыОтчета = ПолучитьПараметрыОтчета();
	
	Отчеты.ЖурналУчетаПолученныхСчетовФактур.СформироватьОтчет(ПараметрыОтчета, ОтчетТабличныйДокумент, ДанныеРасшифровки);
	
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(ОтчетТабличныйДокумент, РеквизитФормыВЗначение("Отчет").Метаданные().Синоним, Строка(ПользователиКлиентСервер.АвторизованныйПользователь()), Отчет.Организация);
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма, Истина);
	
КонецПроцедуры

&НаСервере // вызывается из общего модуля
Процедура ЗаполнитьНастройкамиПоУмолчанию(ЗаполняемыеНастройки = Неопределено) Экспорт
	
	Если ЗаполняемыеНастройки = Неопределено Тогда
		// Задаем настройки по умолчанию при первом открытии отчета:
		
	Иначе
		// Настраиваем отчет по переданным параметрам.
		// Устанавливаем реквизиты отчета:
		ВремСтруктура = Новый Структура(ИменаСохраняемыхРеквизитовОтчета);
		ЗаполнитьЗначенияСвойств(ВремСтруктура, ЗаполняемыеНастройки);
		ЗаполнитьЗначенияСвойств(Отчет, ВремСтруктура);
		
		// Устанавливаем реквизиты формы:
		ВремСтруктура = Новый Структура(ИменаСохраняемыхРеквизитовФормы);
		ЗаполнитьЗначенияСвойств(ВремСтруктура, ЗаполняемыеНастройки);
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ВремСтруктура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте // вызывается в том числе механизмом связи полей шапки и отбора
Процедура НастроитьФормуКлиент_ПриИзмененииЭлементаФормы(УстановитьСостояниеТабличногоДокумента = Истина) Экспорт
	
	НастроитьФормуКлиент_ОбновитьЗаголовокФормы();
	
	Если УстановитьСостояниеТабличногоДокумента Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура НастроитьФормуСервер_ВидимостьНастроек()
	
	НовВидимость = Отчет["ВидимостьНастроек"];
	
	Элементы["ГруппаПанельНастроек"].Видимость	= НовВидимость;
	Элементы["ПанельНастроек"].Пометка			= НовВидимость;
	
КонецПРоцедуры
&НаКлиенте
Процедура НастроитьФормуКлиент_ОбновитьЗаголовокФормы()
	
	ЗаголовокОтчета = НСтр("ru='Журнал учета полученных счетов-фактур'") + СтандартныеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(
		Отчет["НачалоПериода"],
		Отчет["КонецПериода"]);
	
	ЭтаФорма.Заголовок = ЗаголовокОтчета;

КонецПроцедуры

// Скопировано из общей формы "ФормаОтчета"
&НаКлиенте
Функция ВыделенныеОбласти()
	Результат = Новый Массив;
	Для Каждого ВыделеннаяОбласть Из ОтчетТабличныйДокумент.ВыделенныеОбласти Цикл
		Если ТипЗнч(ВыделеннаяОбласть) <> Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Продолжить;
		КонецЕсли;
		Структура = Новый Структура("Верх, Низ, Лево, Право, ТипОбласти");
		ЗаполнитьЗначенияСвойств(Структура, ВыделеннаяОбласть);
		Результат.Добавить(Структура);
	КонецЦикла;
	Возврат Результат;
КонецФункции
&НаКлиенте
Процедура Подключаемый_РассчитатьСуммуЯчеек()
	
	Сумма = СтандартныеОтчетыКлиентСервер.РассчитатьСуммуВыделенныхЯчеек(ОтчетТабличныйДокумент, Неопределено);
	Если ТипЗнч(Сумма) = Тип("Число") Тогда
		СуммаВыделенныхЯчеек = Формат(Сумма, "ЧН=0");
	Иначе
		СуммаВыделенныхЯчеек = "-";
	КонецЕсли;
	
КонецПроцедуры
&НаСервереБезКонтекста
Функция ВычислитьСуммуСервер(Знач ОтчетТабличныйДокумент, Знач ВыделенныеОбласти)
	Сумма = СтандартныеОтчетыКлиентСервер.РассчитатьСуммуВыделенныхЯчеек(ОтчетТабличныйДокумент, ВыделенныеОбласти);
	Возврат Формат(Сумма, "ЧН=0");
КонецФункции

//------------------------------------------------------------------------------
// Механизм связи полей шапки и отбора

&НаСервере
Процедура СвязьПолейШапкиИОтбора_ПриСозданииНаСервере()
	
	// Организация:
	СтрокаСвязи = Новый Структура();
	СтрокаСвязи.Вставить("РежимСвязи",					"ИндикаторСвязи");
	СтрокаСвязи.Вставить("ШапкаИмяЭлементаПоля",		"Организация");
	СтрокаСвязи.Вставить("ОтборИмяЭлементаТаблицы",		"Отбор");
	СтрокаСвязи.Вставить("ОтборИмяПоля",				"Организация");
	
	СтандартныеОтчеты.СвязьПолейШапкиИОтбора_ПриСозданииНаСервере(ЭтаФорма,
		СтрокаСвязи,						// МассивСтрокСвязи
		ИменаСохраняемыхРеквизитовФормы,	// ИменаСохраняемыхРеквизитовФормы
		);									// ИменаСозданныхРеквизитовФормы
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвязьПолейШапкиИОтбора_НажатиеКартинкиСвязьНеУстановлена(Элемент)
	
	СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_НажатиеКартинкиСвязьНеУстановлена(ЭтаФорма, Отчет, Элемент);
	
	Попытка
		ЭтаФорма.НастроитьФормуКлиент_ПриИзмененииЭлементаФормы(Ложь);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвязьПолейШапкиИОтбора_НажатиеКартинкиСвязьУстановлена(Элемент)
	
	СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_НажатиеКартинкиСвязьУстановлена(ЭтаФорма, Отчет, Элемент);
	
	Попытка
		ЭтаФорма.НастроитьФормуКлиент_ПриИзмененииЭлементаФормы(Ложь);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвязьПолейШапкиИОтбора_ПриИзмененииПоляШапки(Элемент)
	
	СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_ПриИзмененииПоляШапки(ЭтаФорма, Отчет, Элемент);
	
	Попытка
		ЭтаФорма.НастроитьФормуКлиент_ПриИзмененииЭлементаФормы();
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвязьПолейШапкиИОтбора_ПриИзмененииФлажкаПоВсем(Элемент)
	
	СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_ПриИзмененииФлажкаПоВсем(ЭтаФорма, Отчет, Элемент);
	
	Попытка
		ЭтаФорма.НастроитьФормуКлиент_ПриИзмененииЭлементаФормы(Ложь);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвязьПолейШапкиИОтбора_ПриИзмененииФлажкаСвязьНеУстановлена(Элемент)
	
	СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_ПриИзмененииФлажкаСвязьНеУстановлена(ЭтаФорма, Отчет, Элемент);
	
	Попытка
		ЭтаФорма.НастроитьФормуКлиент_ПриИзмененииЭлементаФормы(Ложь);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвязьПолейШапкиИОтбора_ПриИзмененииФлажкаСвязьУстановлена(Элемент)
	
	СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_ПриИзмененииФлажкаСвязьУстановлена(ЭтаФорма, Отчет, Элемент);
	
	Попытка
		ЭтаФорма.НастроитьФормуКлиент_ПриИзмененииЭлементаФормы(Ложь);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвязьПолейШапкиИОтбора_ПриНачалеРедактированияСтрокиОтбора(Элемент, НоваяСтрока, Копирование)
	
	СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_ПриНачалеРедактированияСтрокиОтбора(ЭтаФорма, Отчет, Элемент, НоваяСтрока, Копирование);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвязьПолейШапкиИОтбора_ПриОкончанииРедактированияСтрокиОтбора(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_ПриОкончанииРедактированияСтрокиОтбора(ЭтаФорма, Отчет, Элемент, НоваяСтрока, ОтменаРедактирования);
	
	Попытка
		ЭтаФорма.НастроитьФормуКлиент_ПриИзмененииЭлементаФормы(Ложь);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвязьПолейШапкиИОтбора_ПослеУдаленияСтрокиОтбора(Элемент)
	
	ПодключитьОбработчикОжидания("Подключаемый_СвязьПолейШапкиИОтбора_ПослеУдаленияСтрокиОтбора_Служебный", 0.5, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СвязьПолейШапкиИОтбора_ПослеУдаленияСтрокиОтбора_Служебный()
	
	СтандартныеОтчетыКлиентСервер.СвязьПолейШапкиИОтбора_ПриОткрытии(ЭтаФорма, Отчет);
	
	Попытка
		ЭтаФорма.НастроитьФормуКлиент_ПриИзмененииЭлементаФормы(Ложь);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Механизм связи полей шапки и отбора
//------------------------------------------------------------------------------

&НаКлиенте
Процедура ОбновитьКомпоновщикНастроек(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) <> Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	
	РегламентированныеРегистрыКлиент.ОбновитьКомпоновщикНастроек(ЭтаФорма, РезультатВыбора);	
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти
