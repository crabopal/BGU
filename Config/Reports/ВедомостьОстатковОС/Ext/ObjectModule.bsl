#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		
		// удаляем ИФО	
		Запрос = СхемаКомпоновкиДанных.НаборыДанных[0].Запрос;				
		
		// модифицируем текст запроса
		Запрос = СтрЗаменить(Запрос, "ЕПСБУОстатки.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		Запрос = СтрЗаменить(Запрос, "(ИФО).*,", "");
		
		СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = Запрос;
		
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		
		Запрос = СхемаКомпоновкиДанных.НаборыДанных[0].Запрос;				
		
		Запрос = СтрЗаменить(Запрос, "СтоимостьОбъектовОСОстатки.Подразделение"			, "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
		Запрос = СтрЗаменить(Запрос, "СтоимостьОбъектовОСПоКонтрагентам.Подразделение"	, "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
		Запрос = СтрЗаменить(Запрос, "(Подразделение).*,", "");				
		
		СхемаКомпоновкиДанных.НаборыДанных[0].Запрос = Запрос;
		
	КонецЕсли;
	
	ПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных;
		
	// установить параметр "Граница отчета"
	ТекущиеНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрДата = ТекущиеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДатаОтчета"));
	Если ПараметрДата <> Неопределено И ПараметрДата.Использование И ЗначениеЗаполнено(ПараметрДата.Значение) Тогда
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(
			"ГраницаОтчета", Новый Граница(КонецДня(ПараметрДата.Значение), ВидГраницы.Включая));
	КонецЕсли;
	
	// Корректировка пользовательского отбора для видов сравнения "Содержит" "Не содержит". Из-за ошибки БСП, в форме 
	// настроек конмпоновщика настроек, правое значение строкового реквзита в отборе, это фиксированная строка длиной, 
	// равной длине выбранного реквизита. Из-за этого поиск по указанным видам сравнения идет не по набранной 
	// пользователем стрке, а с добавленными справа пробелами
	Для каждого ЭлементНастройки из КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ЭлементНастройки) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Продолжить; 
		ИначеЕсли НЕ ЭлементНастройки.Использование 
			ИЛИ НЕ (ЭлементНастройки.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит
				ИЛИ ЭлементНастройки.ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит) Тогда
			Продолжить;
		КонецЕсли;	
		
		ЭлементНастройки.ПравоеЗначение = СокрЛП(ЭлементНастройки.ПравоеЗначение); 
	КонецЦикла;	

КонецПроцедуры

#КонецОбласти

#КонецЕсли
