		<group>РСКП</group>
	</totalField>
	<totalField>
		<dataPath>ПереданЕБП</dataPath>
		<expression>Сумма(ВычислитьВыражениеСГруппировкойМассив("Максимум(ПереданЕБПКоличество)", "РСКП"))</expression>
		<group>ДатаПередачиВСервис</group>
		<group>ЛицевойСчет</group>
		<group>Организация</group>
		<group>ОбщийИтог</group>
	</totalField>
