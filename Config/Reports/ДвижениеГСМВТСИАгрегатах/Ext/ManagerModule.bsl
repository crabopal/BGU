#Область СлужебныйПрограммныйИнтерфейс

Функция ЭтоРегистрУчета() Экспорт
	
	Возврат Истина;
	
КонецФункции

Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	НастройкиОтчета = ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки(); 
	
	СвойстваРегистраУчета.Вставить("Организация", СтандартныеОтчетыКлиентСервер.ПолучитьПараметр(НастройкиОтчета, "Организация").Значение);
	СвойстваРегистраУчета.Вставить("НачалоПериода", СтандартныеОтчетыКлиентСервер.ПолучитьПараметр(НастройкиОтчета, "Период").Значение.ДатаНачала);
	СвойстваРегистраУчета.Вставить("КонецПериода", 	СтандартныеОтчетыКлиентСервер.ПолучитьПараметр(НастройкиОтчета, "Период").Значение.ДатаОкончания);
	СвойстваРегистраУчета.Вставить("ДополнениеИмени", " дата формирования " + Формат(ТекущаяДатаСеанса(),"ДФ=dd.MM.yyyy"));
	
КонецПроцедуры

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ДвижениеГСМВТС");
	НастройкиВарианта.Описание = НСтр("ru = 'Сведения о пробеге и движении ГСМ по видам за период для транспортных средств'");
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ДвижениеГСМВАгрегатах");
	НастройкиВарианта.Описание = НСтр("ru = 'Сведения о движении ГСМ по видам за период для агрегатов'");
	
КонецПроцедуры

