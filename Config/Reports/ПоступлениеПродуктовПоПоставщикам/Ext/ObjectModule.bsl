#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ОтчетПустой; // Сохраняет признак, что в отчете есть данные

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	Перем АдресВХранилище;
	
	СтандартнаяОбработка = Ложь;
	ОтчетПустой = Истина;
	ДокументРезультат.Очистить();
	СформироватьОтчет(ДокументРезультат, АдресВХранилище, СхемаКомпоновкиДанных);
	
	// Сохранить признак ОтчетПустой для подсистемы Рассылка отчетов
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ОтчетПустой", ОтчетПустой);
	
	// восстановим данные расшифровки из временного хранилища
	СохраненныеДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресВХранилище);
	Если ТипЗнч(СохраненныеДанныеРасшифровки) = Тип("Структура") Тогда
		СохраненныеДанныеРасшифровки.Свойство("ДанныеРасшифровки", ДанныеРасшифровки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура СформироватьОтчет(Результат = Неопределено, ДанныеРасшифровки = Неопределено, 
	Схема = Неопределено, ВыводитьПолностью = Истина) Экспорт
	
	ДополнительныеСвойства = КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	
	ДополнительныеСвойства.Вставить("ВыводитьЗаголовок",       Истина);
	ДополнительныеСвойства.Вставить("ВыводитьПодвал",          Ложь);
	ДополнительныеСвойства.Вставить("УникальныйИдентификатор", Новый УникальныйИдентификатор);
	
	СтандартныеОтчеты.ВывестиОтчет(ЭтотОбъект, Результат, ДанныеРасшифровки, Схема, ВыводитьПолностью);
	
КонецПроцедуры

Функция ПолучитьПараметрыИсполненияОтчета() Экспорт
	
	Параметры = Новый Структура("ИспользоватьПередКомпоновкойМакета, ИспользоватьПриВыводеЗаголовка,"
		+ "ИспользоватьДанныеРасшифровки, ИспользоватьПередВыводомЭлементаРезультата");
		
	Параметры.ИспользоватьПередКомпоновкойМакета         = Истина;
	Параметры.ИспользоватьПриВыводеЗаголовка             = Истина;
	Параметры.ИспользоватьДанныеРасшифровки              = Истина;
	Параметры.ИспользоватьПередВыводомЭлементаРезультата = Истина;
	
	Возврат Параметры;
	
КонецФункции

Процедура ПередКомпоновкойМакета(Схема) Экспорт
	
	// Параметры:
	Параметр = Схема.Параметры.Найти("СчетаПоставщиков");
	Параметр.Значение = БухгалтерскийУчет.СписокСчетов("302.00, 401.10, 401.20, 304.04, 401.60");
	
	Параметр = Схема.Параметры.Найти("СчетаПП");
	Параметр.Значение = БухгалтерскийУчет.СписокСчетов("105.22, 105.32, 106.2П, 106.3П", ТекущаяДатаСеанса());
	
	Параметр = Схема.Параметры.Найти("СчетаВложений");
	Параметр.Значение = БухгалтерскийУчет.СписокСчетов("106.2П, 106.3П", '20201231');

КонецПроцедуры

Процедура ПослеВыводаРезультата(Результат) Экспорт
	
	СтандартныеОтчеты.ОбработкаРезультатаОтчета(ЭтотОбъект, Результат);

КонецПроцедуры

Процедура ПриВыводеЗаголовка(Результат, ВыводитьПолностью) Экспорт
	
	Мак = ПолучитьМакет("МакетОтчета");
	
	Обл = Мак.ПолучитьОбласть("Заголовок");
	Результат.Вывести(Обл);
	
	Обл = Мак.ПолучитьОбласть("Параметры");
	
	ТекущиеНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрПериод = ТекущиеНастройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПериодОтчета"));
	Если ПараметрПериод.Использование Тогда
		НачалоПериода = ПараметрПериод.Значение.ДатаНачала;
		КонецПериода = ПараметрПериод.Значение.ДатаОкончания;
	Иначе
		НачалоПериода = '00010101';
		КонецПериода = '00010101';
	КонецЕсли;
	
	Организация = Справочники.Организации.ПустаяСсылка();
	ПолеКомпоновкиОрганизация = Новый ПолеКомпоновкиДанных("Организация");
	Для каждого ЭлементОтбора Из ТекущиеНастройки.Отбор.Элементы Цикл
	
		Если ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновкиОрганизация И ЗначениеЗаполнено(ЭлементОтбора.ИдентификаторПользовательскойНастройки) Тогда
			
			Если ЭлементОтбора.Использование И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
				Организация = ЭлементОтбора.ПравоеЗначение;
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла;
	
	Если ЗначениеЗаполнено(НачалоПериода) ИЛИ ЗначениеЗаполнено(КонецПериода) Тогда
		Обл.Параметры.ОписаниеПериода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'за %1'"), ПредставлениеПериода(НачалоПериода, КонецПериода, "ФП = Истина"));
	Иначе
		Обл.Параметры.ОписаниеПериода = Нстр("ru = 'Без ограничения периода'");
	КонецЕсли;
	Если ЗначениеЗаполнено(Организация) Тогда
		Обл.Параметры.Организация = Организация;
	Иначе
		Обл.Параметры.Организация = НСтр("ru = 'По всем учреждениям'");
	КонецЕсли;
	Результат.Вывести(Обл);
	
	Результат.Область("R1:R" + Результат.ВысотаТаблицы).Имя = "Заголовок";
	
КонецПроцедуры

Процедура ПередВыводомЭлементаРезультата(МакетКомпоновки, ДанныеРасшифровкиОбъект, ЭлементРезультата, Отказ) Экспорт
	
	Если ОтчетПустой Тогда
		Для Каждого ЗначениеПараметраМакета Из ЭлементРезультата.ЗначенияПараметров Цикл
			Попытка
				Если ЗначениеЗаполнено(ЗначениеПараметраМакета.Значение) Тогда
					ОтчетПустой = Ложь;
					Прервать;
				КонецЕсли;
			Исключение
				// Исключение обрабатывать не требуется
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли