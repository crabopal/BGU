#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ВывестиТитульныйЛист(ДокументРезультат, КомпоновщикНастроек.ПолучитьНастройки().ПараметрыДанных);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.РазрешеноИзменятьСтруктуру 	= Ложь;
	Настройки.РазрешеноИзменятьВарианты 	= Ложь;
	
	Настройки.События.ПриОпределенииСвойствЭлементовФормыНастроек 	= Истина;
	
КонецПроцедуры

// Вызывается после определения свойств элементов формы, связанных с пользовательскими настройками.
// См. ОтчетыСервер.СвойстваЭлементовФормыНастроек()
// Позволяет переопределить свойства, для целей персонализации отчета.
//
// Параметры:
//  ТипФормы - ТипФормыОтчета - см. Синтакс-помощник.
//  СвойстваЭлементов - Структура - см. ОтчетыСервер.СвойстваЭлементовФормыНастроек().
//  ПользовательскиеНастройки - КоллекцияЭлементовПользовательскихНастроекКомпоновкиДанных - элементы актуальных
//                              пользовательских настроек, влияющих на создание связанных элементов формы.
//
Процедура ПриОпределенииСвойствЭлементовФормыНастроек(ТипФормы, СвойстваЭлементов, ПользовательскиеНастройки) Экспорт 
	
	СвойстваГруппы = ОтчетыСервер.СвойстваГруппыЭлементовФормы();
	СвойстваГруппы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	СвойстваЭлементов.Группы.Вставить("ФиксированныеПараметры_0", СвойстваГруппы);
	
	СвойстваГруппы = ОтчетыСервер.СвойстваГруппыЭлементовФормы();
	СвойстваГруппы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	СвойстваГруппы.Вставить("Отображение", ОтображениеОбычнойГруппы.ОбычноеВыделение);
	СвойстваЭлементов.Группы.Вставить("ФиксированныеПараметры_1", СвойстваГруппы);

	ФиксированныеПараметры_0 = Новый Структура("Период, ДатаФормирования, ТипКассы");
	ФиксированныеПараметры_1 = Новый Структура("Организация, ОтветственныйИсполнитель");
	
	ШиринаПоля = Новый Структура("Счет, Организация, Подразделение, ПоПодразделениям, ГлавныйБухгалтер, НачальникОтдела, Исполнитель, ДатаПодписания", 
	5, 0, 0, 0, 0, 0, 0, 0);
	
	Для Каждого ЭлементНастройки Из ПользовательскиеНастройки Цикл 
		
		Если ТипЗнч(ЭлементНастройки) <> Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда 
			Продолжить;
		КонецЕсли;
		
		Если ФиксированныеПараметры_0.Свойство(ЭлементНастройки.Параметр) Тогда
			ИдентификаторГруппы = "ФиксированныеПараметры_0";
		ИначеЕсли ФиксированныеПараметры_1.Свойство(ЭлементНастройки.Параметр) Тогда
			ИдентификаторГруппы = "ФиксированныеПараметры_1";
		Иначе
			Продолжить;
	    КонецЕсли;
		
		СвойстваПоля = СвойстваЭлементов.Поля.Найти(
			ЭлементНастройки.ИдентификаторПользовательскойНастройки, "ИдентификаторНастройки");
		
		Если СвойстваПоля = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		СвойстваПоля.ИдентификаторГруппы = ИдентификаторГруппы;
		
		ИмяПараметра = Строка(ЭлементНастройки.Параметр);
		Если ИмяПараметра = "ТипКассы" Тогда 
			СвойстваПоля.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ИначеЕсли ИмяПараметра = "ДатаФормирования" Тогда	
			СвойстваПоля.Ширина = 14;
			СвойстваПоля.РастягиватьПоГоризонтали = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВывестиТитульныйЛист(ДокументРезультат, ПараметрыОтчета)
	
	МакетШапки = УправлениеПечатью.МакетПечатнойФормы("Отчет.ЖурналРегистрацииКассовыхОрдеров_0504093.ПФ_MXL_МакетШапки");
	ОбластьШапка = МакетШапки.ПолучитьОбласть("Заголовок");
	ОбластьПодвал = МакетШапки.ПолучитьОбласть("Подвал");
		
	ПараметрыШапки = Новый Структура;
	
	Организация = ЗначениеПараметра(ПараметрыОтчета, "Организация");
	
	ПараметрыШапки.Вставить("Учреждение", Справочники.Организации.ПредставлениеУчреждения(Организация, Ложь));
	ПараметрыШапки.Вставить("КодРПБС", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "КодПоРПБС")); 
	
	Подразделение = ЗначениеПараметра(ПараметрыОтчета, "Подразделение");
	
	Если ЗначениеЗаполнено(Подразделение) Тогда
		ПараметрыПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Подразделение, "НаименованиеПолное,Наименование,ОбособленноеПодразделение");
		НазваниеПодразделения = "";
		Если ПараметрыПодразделения.ОбособленноеПодразделение И ЗначениеЗаполнено(ПараметрыПодразделения.НаименованиеПолное) Тогда
			НазваниеПодразделения =	ПараметрыПодразделения.НаименованиеПолное;
		Иначе
			НазваниеПодразделения =	ПараметрыПодразделения.Наименование;
		КонецЕсли;
		ПараметрыШапки.Вставить("Подразделение", НазваниеПодразделения);
	КонецЕсли;
	
	ПараметрыШапки.Вставить("НачПериода", ЗначениеПараметра(ПараметрыОтчета, "Период").ДатаНачала);
    ПараметрыШапки.Вставить("КонПериода", ЗначениеПараметра(ПараметрыОтчета, "Период").ДатаОкончания);
	ПараметрыШапки.Вставить("ДатаФормирования", ЗначениеПараметра(ПараметрыОтчета, "ДатаФормирования").Дата);
	
	ПараметрыШапки.Вставить("ДатаОткрытия",	ПараметрыШапки.НачПериода);
	ПараметрыШапки.Вставить("ДатаЗакрытия",	ПараметрыШапки.КонПериода);
	
	СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(ПараметрыШапки.НачПериода);
	ПараметрыШапки.Вставить("ЧДН", 			СтруктураДаты.Число);
	ПараметрыШапки.Вставить("МДН", 			СтруктураДаты.Месяц);
	ПараметрыШапки.Вставить("ГДН", 			СтруктураДаты.Год);
	СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(ПараметрыШапки.КонПериода);
	ПараметрыШапки.Вставить("ЧДК", 			СтруктураДаты.Число);
	ПараметрыШапки.Вставить("МДК", 			СтруктураДаты.Месяц);
	ПараметрыШапки.Вставить("ГДК", 			СтруктураДаты.Год);

	Исполнитель = ЗначениеПараметра(ПараметрыОтчета, "ОтветственныйИсполнитель");
	Если ЗначениеЗаполнено(Исполнитель) Тогда
		
		ПараметрыШапки.Вставить("Подпись", Справочники.Сотрудники.ФамилияИО(Исполнитель));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект,Период,ДолжностьНаименование,НаименованиеПолное,Код", Исполнитель, ПараметрыШапки.ДатаФормирования);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, , Истина);
		
		ПараметрыШапки.Вставить("Должность", ДанныеСотрудника.ДолжностьНаименование);
		ПараметрыШапки.Вставить("ИсполнительФИО", ДанныеСотрудника.НаименованиеПолное); 
		ПараметрыШапки.Вставить("ТабНомер", ДанныеСотрудника.Код);
		
		ПараметрыШапки.Вставить("ТелефонИсполнителя", ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
		ПараметрыШапки.Вставить("ЭлАдресИсполнителя", ДанныеСотрудника.EmailФизическиеЛица);
		
	КонецЕсли;

	СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(ПараметрыШапки.ДатаФормирования);
	ПараметрыШапки.Вставить("ЧД", 			СтруктураДаты.Число);
	ПараметрыШапки.Вставить("МД", 			СтруктураДаты.Месяц);
	ПараметрыШапки.Вставить("ГД", 			СтруктураДаты.Год);

	ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
	ДокументРезультат.Вывести(ОбластьШапка);
	
	ОбластьПодвал.Параметры.Заполнить(ПараметрыШапки);
	ДокументРезультат.Вывести(ОбластьПодвал);
	
	ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
	
КонецПроцедуры

Функция ЗначениеПараметра(ПараметрыОтчета, ИмяПараметра)
	Параметр = ПараметрыОтчета.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(ИмяПараметра));
	Если Параметр = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат Параметр.Значение;
	КонецЕсли;
КонецФункции


#КонецОбласти

#КонецЕсли