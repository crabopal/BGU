////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СтоимостьОС.Организация КАК Организация,
	СтоимостьОС.ИФО КАК ИФО,
	СтоимостьОС.Счет КАК Счет,
	СтоимостьОС.КПС КАК КПС,
	СтоимостьОС.КФО КАК КФО,
	СтоимостьОС.ОсновноеСредство КАК ОсновноеСредство,
	СтоимостьОС.Договор КАК Договор,
	СтоимостьОС.ЦМО КАК ЦМО,
	СтоимостьОС.БалансоваяСтоимость КАК БалансоваяСтоимость,
	ЕСТЬNULL(АмортизацияОС.СуммаАмортизации, 0) КАК СуммаАмортизации,
	ВТ_ПараметрыАмортизации.ВидОперации КАК ВидОперации,
	ВТ_ПараметрыАмортизации.СпособПризнанияРасходов КАК СпособПризнанияРасходов,
	ЕСТЬNULL(ВТ_СведенияОбОбъектахПравПользованияОС.ДатаНачалаСрокаПользования, ВТ_ПараметрыАмортизации.ДатаНачалаАмортизации) КАК ДатаНачалаАмортизации,
	ЕСТЬNULL(ВТ_СведенияОбОбъектахПравПользованияОС.ДатаОкончанияСрокаПользования, ВТ_ПараметрыАмортизации.ДатаОкончанияАмортизации) КАК ДатаОкончанияАмортизации,
	ВТ_ПараметрыАмортизации.СчетРасходов КАК СчетРасходов,
	ВТ_ПараметрыАмортизации.КПСРасходов КАК КПСРасходов,
	ВТ_ПараметрыАмортизации.КЭКРасходов КАК КЭКРасходов,
	ВТ_ПараметрыАмортизации.СубконтоРасходов1 КАК СубконтоРасходов1,
	ВТ_ПараметрыАмортизации.СубконтоРасходов2 КАК СубконтоРасходов2,
	ВТ_ПараметрыАмортизации.СубконтоРасходов3 КАК СубконтоРасходов3,
	ВТ_ПараметрыАмортизации.СтатьяПрочихРасходовНУ КАК СтатьяПрочихРасходовНУ,
	ВТ_ПараметрыАмортизации.ПринятьНДСКВычету КАК ПринятьНДСКВычету
ИЗ
	ВТ_Стоимость КАК СтоимостьОС
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Амортизация КАК АмортизацияОС
		ПО СтоимостьОС.ОсновноеСредство = АмортизацияОС.ОсновноеСредство
			И СтоимостьОС.Договор = АмортизацияОС.Договор
			И СтоимостьОС.Организация = АмортизацияОС.Организация
			И СтоимостьОС.ИФО = АмортизацияОС.ИФО
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПараметрыАмортизации КАК ВТ_ПараметрыАмортизации
		ПО СтоимостьОС.Организация = ВТ_ПараметрыАмортизации.Организация
			И СтоимостьОС.Договор = ВТ_ПараметрыАмортизации.Договор
			И СтоимостьОС.ОсновноеСредство = ВТ_ПараметрыАмортизации.ОсновноеСредство
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СведенияОбОбъектахПравПользованияОС КАК ВТ_СведенияОбОбъектахПравПользованияОС
		ПО СтоимостьОС.Организация = ВТ_СведенияОбОбъектахПравПользованияОС.Организация
			И СтоимостьОС.Договор = ВТ_СведенияОбОбъектахПравПользованияОС.Договор
			И СтоимостьОС.ОсновноеСредство = ВТ_СведенияОбОбъектахПравПользованияОС.ОсновноеСредство</query>
	</dataSet>
	<calculatedField>
		<dataPath>ОстаточнаяСтоимость</dataPath>
		<expression>БалансоваяСтоимость - СуммаАмортизации</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Остаточная стоимость</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>ЧДЦ=2</v8:content>
					</v8:item>
				</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>СрокПользованияПолный</dataPath>
		<expression>РазностьДат(ДатаНачалаАмортизации, ДатаОкончанияАмортизации, "Месяц") + 1</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Срок пользования (полный)</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>СрокПользованияОставшийся</dataPath>
		<expression>ВЫБОР
    КОГДА &amp;ДатаОтчета &gt; ДатаОкончанияАмортизации
        ТОГДА 0
    ИНАЧЕ РазностьДат(&amp;ДатаОтчета, ДатаОкончанияАмортизации, "Месяц") + 1
КОНЕЦ</expression>
