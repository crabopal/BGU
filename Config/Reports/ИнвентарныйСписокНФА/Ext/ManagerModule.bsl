#Область СлужебныйПрограммныйИнтерфейс

Функция ЭтоРегистрУчета() Экспорт
	
	Возврат Истина;
	
КонецФункции

Процедура СвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	СвойстваРегистраУчета.Вставить("Организация", 		ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0].Значение);
	СвойстваРегистраУчета.Вставить("Подразделение", 	ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[3].Значение);
	СвойстваРегистраУчета.Вставить("НачалоПериода", 	ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[2].Значение.Дата);
	СвойстваРегистраУчета.Вставить("КонецПериода", 		ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[2].Значение.Дата);
	
	ЦМО = ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].Значение;
	
	Если ЗначениеЗаполнено(ЦМО) Тогда
		
		СвойстваРегистраУчета.Вставить("ДополнениеИмени", " " + СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦМО, "Наименование")));
		
	КонецЕсли;
	
КонецПроцедуры	

// Настройки размещения в панели отчетов.
//
// Параметры:
//   Настройки - Коллекция - Используется для описания настроек отчетов и вариантов
//       см. описание к ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации()
//   НастройкиОтчета - СтрокаДереваЗначений - Настройки размещения всех вариантов отчета.
//       см. "Реквизиты для изменения" функции ВариантыОтчетов.ДеревоНастроекВариантовОтчетовКонфигурации().
//
// Описание:
//   См. ВариантыОтчетовПереопределяемый.НастроитьВариантыОтчетов().
//
// Вспомогательные методы:
//   НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "<ИмяВарианта>");
//   ВариантыОтчетов.УстановитьРежимВыводаВПанеляхОтчетов(Настройки, НастройкиОтчета, Истина/Ложь); // Отчет поддерживает только этот режим.
//
Процедура НастроитьВариантыОтчета(Настройки, НастройкиОтчета) Экспорт
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ИнвентарныйСписокНФА");
	НастройкиВарианта.Описание = НСтр("ru = '(устарел с 01.01.2018) Инвентарный список НФА'");
	НастройкиВарианта.Включен = Истина;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ИнвентарныйСписокНФА194н");
	НастройкиВарианта.Включен = Истина;
	
	НастройкиВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, НастройкиОтчета, "ИнвентарныйСписокНФА103н");
	НастройкиВарианта.Включен = Истина;
	
КонецПроцедуры

Функция СведенияИсполнителя(Исполнитель, Период, Поле) Экспорт
	
	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат null;
	КонецЕсли;
	
	ДанныеСотрудника = Новый Структура("СсылкаНаОбъект,Период,Должность,ДолжностьНаименование,Фамилия,Имя,Отчество", Исполнитель, Период);
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, , Истина);
	
	Сведения = Новый Структура;
	
	Сведения.Вставить("ФИО"					, КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
	Сведения.Вставить("Должность"			, ДанныеСотрудника.ДолжностьНаименование);
	Сведения.Вставить("НомерТелефона"		, ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
	Сведения.Вставить("ЭлектроннаяПочта"	, ДанныеСотрудника.EmailФизическиеЛица);
	
	Результат = Сведения[Поле];
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли