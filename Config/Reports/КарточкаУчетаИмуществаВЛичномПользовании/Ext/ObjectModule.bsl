#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,, ДанныеРасшифровки);
	
	Данные = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Данные);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти("Организация");
	Организация = ?(Параметр = Неопределено Или Не Параметр.Использование, Справочники.Организации.ПустаяСсылка(), Параметр.Значение);
	
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти("Период");
	Период = ?(Параметр = Неопределено Или Не Параметр.Использование, ОбщегоНазначенияБГУ.РабочаяДатаПользователя(), Параметр.Значение);
	
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти("Подразделение");
	Подразделение = ?(Параметр = Неопределено Или Не Параметр.Использование, Справочники.Подразделения.ПустаяСсылка(), Параметр.Значение);
	
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти("Исполнитель");
	Исполнитель = ?(Параметр = Неопределено Или Не Параметр.Использование, Справочники.Сотрудники.ПустаяСсылка(), Параметр.Значение);
	
	ТабДок = СформироватьКарточки(Данные, КонецДня(Период), Организация, Подразделение, Исполнитель);
	
	ДокументРезультат.Вывести(ТабДок);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
	
	Настройки.События.ПриЗагрузкеПользовательскихНастроекНаСервере = Истина;
	
КонецПроцедуры

Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Форма, НовыеНастройкиКД) Экспорт
	
	УстановитьПараметрВПользовательскихНастройках(Форма, "Период");
	УстановитьПараметрВПользовательскихНастройках(Форма, "Организация", Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьПараметрВПользовательскихНастройках(Форма, ИмяПараметра, СкрытьИзБыстрогоДоступа = Ложь)
	
	Если Форма.Параметры.Свойство(ИмяПараметра) И ЗначениеЗаполнено(Форма.Параметры[ИмяПараметра]) Тогда
		
		Параметр = Форма.Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
		Если ТипЗнч(Параметр) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
			Настройка = Форма.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(Параметр.ИдентификаторПользовательскойНастройки);
			Если ТипЗнч(Настройка) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
				Настройка.Использование = Истина;
				Настройка.Значение = Форма.Параметры[ИмяПараметра];
				Если СкрытьИзБыстрогоДоступа Тогда
					Параметр.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьКарточки(Данные, Период, Организация, Подразделение, Исполнитель)
	
	Контрагенты = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Данные.ВыгрузитьКолонку("Контрагент"));
	
	Данные.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(5,0)));
	Для Сч = 1 По Данные.Количество() Цикл
		Данные[Сч-1].Порядок = Сч;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Таблица"		, Данные);
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("Контрагенты"	, Контрагенты);
	Запрос.УстановитьПараметр("Период"		, Период);
	Запрос.УстановитьПараметр("СчетОС"		, БухгалтерскийУчет.СписокСчетов("27.01"));
	Запрос.УстановитьПараметр("СчетМЗ"		, БухгалтерскийУчет.СписокСчетов("27.02"));
	Запрос.УстановитьПараметр("ЕдИзмШт"		, Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	
	Запрос.Текст = ТекстЗапроса();
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаКарточка		= Результат[03].Выбрать();
	ВыборкаОбеспечение	= Результат[05].Выбрать();
	ВыборкаДвиженияОС	= Результат[07].Выбрать();
	ВыборкаДвиженияМЗ	= Результат[08].Выбрать();
	Остатки				= Результат[10].Выгрузить();
	Характеристики		= Результат[12].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Отчет.КарточкаУчетаИмуществаВЛичномПользовании.ПФ_MXL_Карточка0509097");
	
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьР1Шапка		= Макет.ПолучитьОбласть("Раздел1_Шапка");
	ОбластьР1Строка		= Макет.ПолучитьОбласть("Раздел1_Строка");
	ОбластьР2Шапка		= Макет.ПолучитьОбласть("Раздел2_Шапка");
	ОбластьР2Строка		= Макет.ПолучитьОбласть("Раздел2_Строка");
	ОбластьР3Шапка		= Макет.ПолучитьОбласть("Раздел3_Шапка");
	ОбластьР3Строка		= Макет.ПолучитьОбласть("Раздел3_Строка");
	ОбластьР3Подвал		= Макет.ПолучитьОбласть("Раздел3_Подвал");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	
	ТабДок = Новый ТабличныйДокумент;
	ПерваяКарточка = Истина;
	
	РеквизитыШапки = Новый Структура;
	РеквизитыШапки.Вставить("ДатаФормирования", Период);
	
	Если ЗначениеЗаполнено(Подразделение) Тогда
		ДанныеПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Подразделение, "Наименование,НаименованиеПолное");
		РеквизитыШапки.Вставить("СтруктурноеПодразделение", Подразделение);
		РеквизитыШапки.Вставить("НаименованиеСтруктурногоПодразделения",
			?(ЗначениеЗаполнено(ДанныеПодразделения.НаименованиеПолное),
				ДанныеПодразделения.НаименованиеПолное, ДанныеПодразделения.Наименование));
	КонецЕсли;
	
	РеквизитыПодвала = Новый Структура;
	Если ЗначениеЗаполнено(Исполнитель) Тогда
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность, ДолжностьНаименование", Исполнитель, Период);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, Истина);
		ФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь);
		
		РеквизитыПодвала.Вставить("Исполнитель"				, Исполнитель);
		РеквизитыПодвала.Вставить("ФИО"						, ФИО);
		РеквизитыПодвала.Вставить("Должность"				, ДанныеСотрудника.Должность);
		РеквизитыПодвала.Вставить("ДолжностьНаименование"	, ДанныеСотрудника.ДолжностьНаименование);
		РеквизитыПодвала.Вставить("НомерТелефона"			, ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
		РеквизитыПодвала.Вставить("ЭлектроннаяПочта"		, ДанныеСотрудника.EmailФизическиеЛица);
		
	КонецЕсли;
	
	ТаблицаХарактеристик = ХарактеристикиИмущества(Характеристики);
	
	Пока ВыборкаКарточка.Следующий() Цикл
		
		Если Не ПерваяКарточка Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПерваяКарточка = Ложь;
		
		// Шапка
		ОбластьШапка.Параметры.Заполнить(ВыборкаКарточка);
		ОбластьШапка.Параметры.Заполнить(РеквизитыШапки);
		ТабДок.Вывести(ОбластьШапка);
		
		// Таблица 1
		
		СтруктураПоиска = Новый Структура("Карточка", ВыборкаКарточка.Карточка);
		
		ТабДок.Вывести(ОбластьР1Шапка);
		
		КарточкаЗакрыта = ЗначениеЗаполнено(ВыборкаКарточка.ДатаЗакрытия) И Период >= ВыборкаКарточка.ДатаЗакрытия;
		
		ВыборкаОбеспечение.Сбросить();
		Пока ВыборкаОбеспечение.НайтиСледующий(СтруктураПоиска) Цикл
			
			СтрокиОстатка = Остатки.НайтиСтроки(Новый Структура("Контрагент,Имущество", ВыборкаКарточка.Контрагент, ВыборкаОбеспечение.Имущество));
			КоличествоОстаток = ?(СтрокиОстатка.Количество() > 0, СтрокиОстатка[0].Количество, 0);
			
			НормаВыдачи = ?(КарточкаЗакрыта, 0, ВыборкаОбеспечение.НормаВыдачи);
			Разница = НормаВыдачи - КоличествоОстаток;
			ПараметрыСтроки = Новый Структура("ВПользовании", КоличествоОстаток);
			ПараметрыСтроки.Вставить("КВыдаче", ?(Разница > 0, Разница, 0));
			ПараметрыСтроки.Вставить("КВозврату", ?(Разница < 0 И ВыборкаОбеспечение.КодВозврата <> "03", - Разница, 0));
			ПараметрыСтроки.Вставить("КСнятию", ?(Разница < 0 И ВыборкаОбеспечение.КодВозврата = "03", - Разница, 0));
			
			Если ЗначениеЗаполнено(ВыборкаОбеспечение.СПИ) Тогда
				ПараметрыСтроки.Вставить("СПИ", Строка(ВыборкаОбеспечение.СПИ)
					+ " " + ?(ВыборкаОбеспечение.ЕдИзмСПИ = 1, НСтр("ru = 'д.'"), НСтр("ru = 'м.'")));
			КонецЕсли;
			
			ОбластьР1Строка.Параметры.Заполнить(ВыборкаОбеспечение);
			ОбластьР1Строка.Параметры.Заполнить(ПараметрыСтроки);
			ТабДок.Вывести(ОбластьР1Строка);
			
		КонецЦикла;
		
		// Таблица 2
		
		СтруктураПоиска = Новый Структура("Контрагент", ВыборкаКарточка.Контрагент);
		
		ТабДок.Вывести(ОбластьР2Шапка);
		
		ВыборкаДвиженияОС.Сбросить();
		Пока ВыборкаДвиженияОС.НайтиСледующий(СтруктураПоиска) Цикл
			
			ПараметрыСтроки = ПараметрыСтрокиДвижения(ВыборкаДвиженияОС, Период, ТаблицаХарактеристик);
			
			ОбластьР2Строка.Параметры.Заполнить(ВыборкаДвиженияОС);
			ОбластьР2Строка.Параметры.Заполнить(ПараметрыСтроки);
			ТабДок.Вывести(ОбластьР2Строка);
			
		КонецЦикла;
		
		// Таблица 3
		
		ТабДок.Вывести(ОбластьР3Шапка);
		
		ВыборкаДвиженияМЗ.Сбросить();
		Пока ВыборкаДвиженияМЗ.НайтиСледующий(СтруктураПоиска) Цикл
			
			ПараметрыСтроки = ПараметрыСтрокиДвижения(ВыборкаДвиженияМЗ, Период, ТаблицаХарактеристик);
			
			ОбластьР3Строка.Параметры.Заполнить(ВыборкаДвиженияМЗ);
			ОбластьР3Строка.Параметры.Заполнить(ПараметрыСтроки);
			ТабДок.Вывести(ОбластьР3Строка);
			
		КонецЦикла;
		
		// Подвал
		ОбластьПодвал.Параметры.Заполнить(РеквизитыПодвала);
		ТабДок.Вывести(ОбластьПодвал);
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

Функция ТекстЗапроса()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Таблица.Организация КАК Справочник.Организации) КАК Организация,
	|	ВЫРАЗИТЬ(Таблица.Сотрудник КАК Справочник.Сотрудники) КАК Сотрудник,
	|	Таблица.Контрагент КАК Контрагент,
	|	Таблица.Карточка КАК Карточка,
	|	Таблица.НомерКарточки КАК НомерКарточки,
	|	Таблица.ДатаОткрытияКарточки КАК ДатаОткрытияКарточки,
	|	Таблица.ДатаЗакрытияКарточки КАК ДатаЗакрытияКарточки,
	|	Таблица.Порядок КАК Порядок
	|ПОМЕСТИТЬ ВТ_Карточки
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСПоКонтрагентам.Период КАК Период,
	|	СтоимостьОбъектовОСПоКонтрагентам.Контрагент КАК Контрагент,
	|	СтоимостьОбъектовОСПоКонтрагентам.ОсновноеСредство КАК Имущество,
	|	СтоимостьОбъектовОСПоКонтрагентам.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСПоКонтрагентам.Количество КАК Количество,
	|	СтоимостьОбъектовОСПоКонтрагентам.Стоимость КАК Сумма,
	|	СтоимостьОбъектовОСПоКонтрагентам.НазваниеДокумента КАК ВидПервичногоДокумента,
	|	СтоимостьОбъектовОСПоКонтрагентам.ДатаДокумента КАК ДатаПервичногоДокумента,
	|	СтоимостьОбъектовОСПоКонтрагентам.НомерДокумента КАК НомерПервичногоДокумента,
	|	СтоимостьОбъектовОСПоКонтрагентам.ВидДвижения КАК ВидДвижения,
	|	СтоимостьОбъектовОСПоКонтрагентам.МоментВремени КАК МоментВремени,
	|	СтоимостьОбъектовОСПоКонтрагентам.НомерСтроки КАК НомерСтроки,
	|	СтоимостьОбъектовОСПоКонтрагентам.Регистратор КАК Регистратор,
	|	ВЫБОР
	|		КОГДА СтоимостьОбъектовОСПоКонтрагентам.Регистратор ССЫЛКА Документ.НакладнаяНаВнутреннееПеремещениеОС2
	|				И СтоимостьОбъектовОСПоКонтрагентам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА ВЫРАЗИТЬ(СтоимостьОбъектовОСПоКонтрагентам.Регистратор КАК Документ.НакладнаяНаВнутреннееПеремещениеОС2).ЦМООтправитель.Сотрудник
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	КОНЕЦ КАК Сотрудник
	|ПОМЕСТИТЬ ДвиженияОС
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам КАК СтоимостьОбъектовОСПоКонтрагентам
	|ГДЕ
	|	СтоимостьОбъектовОСПоКонтрагентам.Период <= &Период
	|	И СтоимостьОбъектовОСПоКонтрагентам.Организация = &Организация
	|	И СтоимостьОбъектовОСПоКонтрагентам.Контрагент В(&Контрагенты)
	|	И СтоимостьОбъектовОСПоКонтрагентам.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВЛичноеПользование)
	|	И СтоимостьОбъектовОСПоКонтрагентам.Активность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Период КАК Период,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.Контрагенты) КАК КонтрагентДт,
