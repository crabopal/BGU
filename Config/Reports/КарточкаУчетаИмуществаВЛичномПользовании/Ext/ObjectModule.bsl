Функция ПараметрыСтрокиДвижения(Выборка, Период, ТаблицаХарактеристик)
	
	Если ЗначениеЗаполнено(Выборка.Сотрудник) Тогда
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", Выборка.Сотрудник, Период);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		ФИО = СокрЛП(ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество);
	Иначе
		ФИО = "";
	КонецЕсли;
	
	ЭтоВыдача = (Выборка.ВидДвижения = ВидДвиженияНакопления.Приход);
	
	ПараметрыСтроки = Новый Структура;
	ПараметрыСтроки.Вставить("ФИО"								, ФИО);
	ПараметрыСтроки.Вставить("КоличествоВыдачи"					, ?(ЭтоВыдача, Выборка.Количество, 0));
	ПараметрыСтроки.Вставить("СуммаВыдачи"						, ?(ЭтоВыдача, Выборка.Сумма, 0));
	ПараметрыСтроки.Вставить("НаименованиеДокументаВыдачи"		, ?(ЭтоВыдача, Выборка.ВидПервичногоДокумента, ""));
	ПараметрыСтроки.Вставить("НомерДокументаВыдачи"				, ?(ЭтоВыдача, Выборка.НомерПервичногоДокумента, ""));
	ПараметрыСтроки.Вставить("ДатаДокументаВыдачи"				, ?(ЭтоВыдача, Выборка.ДатаПервичногоДокумента, '00010101'));
	ПараметрыСтроки.Вставить("ДокументВыдачи"					, ?(ЭтоВыдача, Выборка.Регистратор, Неопределено));
	ПараметрыСтроки.Вставить("КоличествоСписания"				, ?(Не ЭтоВыдача, Выборка.Количество, 0));
	ПараметрыСтроки.Вставить("СуммаСписания"					, ?(Не ЭтоВыдача, Выборка.Сумма, 0));
	ПараметрыСтроки.Вставить("НаименованиеДокументаСписания"	, ?(Не ЭтоВыдача, Выборка.ВидПервичногоДокумента, ""));
	ПараметрыСтроки.Вставить("НомерДокументаСписания"			, ?(Не ЭтоВыдача, Выборка.НомерПервичногоДокумента, ""));
	ПараметрыСтроки.Вставить("ДатаДокументаСписания"			, ?(Не ЭтоВыдача, Выборка.ДатаПервичногоДокумента, '00010101'));
	ПараметрыСтроки.Вставить("ДокументСписания"					, ?(Не ЭтоВыдача, Выборка.Регистратор, Неопределено));
	
	Если ЗначениеЗаполнено(Выборка.СПИ) Тогда
		ПараметрыСтроки.Вставить("СПИ", Строка(Выборка.СПИ) + " " + ?(Выборка.ЕдИзмСПИ = 1, НСтр("ru = 'д.'"), НСтр("ru = 'м.'")));
	КонецЕсли;
	
	ЗначениеХарактеристик = ТаблицаХарактеристик[Выборка.Имущество];
	ПараметрыСтроки.Вставить("Характеристика", ?(ЗначениеЗаполнено(ЗначениеХарактеристик), ЗначениеХарактеристик, ""));
	
	Возврат ПараметрыСтроки;
	
КонецФункции

Функция ХарактеристикиИмущества(Выборка)
	
	Результат = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		Значения = Новый Массив;
		ВыборкаХарактеристика = Выборка.Выбрать();
		Пока ВыборкаХарактеристика.Следующий() Цикл
			ЗначениеХарактеристики = ?(ЗначениеЗаполнено(ВыборкаХарактеристика.ТекстоваяСтрока),
				ВыборкаХарактеристика.ТекстоваяСтрока, ВыборкаХарактеристика.ЗначениеХарактеристики);
			Значения.Добавить(ВыборкаХарактеристика.Характеристика + " - " + ЗначениеХарактеристики);
		КонецЦикла;
		Значение = СтрСоединить(Значения, "; ");
		Результат.Вставить(Выборка.Имущество, Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

