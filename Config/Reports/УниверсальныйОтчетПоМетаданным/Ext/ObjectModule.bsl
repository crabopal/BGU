Функция СформироватьЗапросПоМетаданным() Экспорт
	
	ТекстЗапроса = " ВЫБРАТЬ РАЗРЕШЕННЫЕ " + Символы.ПС;
	
	Если ТипДанных = "РегистрыСведений" Тогда
		ИмяТипаДанных = "РегистрСведений";
	ИначеЕсли ТипДанных = "РегистрыНакопления" Тогда
		ИмяТипаДанных = "РегистрНакопления";
	ИначеЕсли ТипДанных = "Справочники" Тогда
		ИмяТипаДанных = "Справочник";
	ИначеЕсли ТипДанных = "Документы" Тогда
		ИмяТипаДанных = "Документ";
	ИначеЕсли ТипДанных = "РегистрыБухгалтерии" Тогда
		ИмяТипаДанных = "РегистрБухгалтерии";
	КонецЕсли;

	ТекстЗапроса = Лев(ТекстЗапроса,СтрДлина(ТекстЗапроса)-2);
	ТекстЗапроса = ТекстЗапроса +
	"* ИЗ " + ИмяТипаДанных + "." + ИмяОбъекта;
	
	Если Не ПустаяСтрока(ИмяТаблицы) Тогда
		ТекстЗапроса = ТекстЗапроса + "." + ИмяТаблицы;
	КонецЕсли;

	Если ИмяТаблицы = "ОстаткиИОбороты" ИЛИ ИмяТаблицы = "Обороты" Тогда
		ТекстЗапроса = ТекстЗапроса + "({&НачалоПериода} ,{&КонецПериода} ,Авто)";
	КонецЕсли;
	
	Если ИмяТаблицы = "СрезПервых" Тогда
		ТекстЗапроса = ТекстЗапроса + "({&НачалоПериода} ,)";
	КонецЕсли;
	
    Если ИмяТаблицы = "СрезПоследних" Тогда
		ТекстЗапроса = ТекстЗапроса + "({&КонецПериода} ,)";
	КонецЕсли;
	
	Если ИмяТаблицы = "Остатки" Тогда
		ТекстЗапроса = ТекстЗапроса + "({&КонецПериода} ,)";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + " КАК ИсточникДанных";
	Если ТипДанных = "Документы" И ИмяТаблицы = "" Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|{ГДЕ
			|	(ИсточникДанных.Дата >= &НачалоПериода),(ИсточникДанных.Дата <= &КонецПериода)}";
	КонецЕсли;
		
	Если ТипДанных = "Документы" И ИмяТаблицы <> "" Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|{ГДЕ
			|	(ИсточникДанных.Ссылка.Дата >= &НачалоПериода),(ИсточникДанных.Ссылка.Дата <= &КонецПериода)}";
	КонецЕсли;


	Если ТипДанных = "РегистрыБухгалтерии" И ИмяТаблицы = "" Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|{ГДЕ
			|	(ИсточникДанных.Период >= &НачалоПериода),(ИсточникДанных.Период <= &КонецПериода)}";
	КонецЕсли;

	
	ТекстЗапроса = ТекстЗапроса + "
	|{ХАРАКТЕРИСТИКИ
	|	ТИП(Справочник.Договоры)
	|	СПИСОК ПланВидовХарактеристик.ВидыХарактеристикОбязательства
	|	ИДЕНТИФИКАТОР Ссылка
	|	ИМЯ Наименование
	|	ТИПЗНАЧЕНИЯ ТипЗначения
	|	ЗНАЧЕНИЯ РегистрСведений.ХарактеристикиОбязательств
	|	ОБЪЕКТ Договор
	|	ХАРАКТЕРИСТИКА ВидХарактеристики
	|	ЗНАЧЕНИЕ ЗначениеХарактеристики } ";
	//|{ХАРАКТЕРИСТИКИ
	//|	ТИП(Справочник.Контрагенты)
	//|	СПИСОК ПланВидовХарактеристик.ВидыХарактеристикКонтрагентов
	//|	ИДЕНТИФИКАТОР Ссылка
	//|	ИМЯ Наименование
	//|	ТИПЗНАЧЕНИЯ ТипЗначения
	//|	ЗНАЧЕНИЯ РегистрСведений.ХарактеристикиКонтрагентов
	//|	ОБЪЕКТ Контрагент
	//|	ХАРАКТЕРИСТИКА ВидХарактеристики
	//|	ЗНАЧЕНИЕ ЗначениеХарактеристики }
	//|{ХАРАКТЕРИСТИКИ
	//|	ТИП(Справочник.ДополнительнаяБюджетнаяКлассификация)
	//|	СПИСОК ПланВидовХарактеристик.ВидыДополнительныхБюджетныхКлассификаторов
	//|	ИДЕНТИФИКАТОР Ссылка
	//|	ИМЯ Наименование
	//|	ТИПЗНАЧЕНИЯ ТипЗначения
	//|	ЗНАЧЕНИЯ РегистрСведений.ХарактеристикиДополнительнойБюджетнойКлассификации
	//|	ОБЪЕКТ ДополнительнаяБюджетнаяКлассификация
	//|	ХАРАКТЕРИСТИКА ВидДопКлассификатора
	//|	ЗНАЧЕНИЕ ЗначениеДопКлассификатора }
	//|{ХАРАКТЕРИСТИКИ
	//|	ТИП(Справочник.ОсновныеСредства)
	//|	СПИСОК ПланВидовХарактеристик.ХарактеристикиОС
	//|	ИДЕНТИФИКАТОР Ссылка
	//|	ИМЯ Наименование
	//|	ТИПЗНАЧЕНИЯ ТипЗначения
	//|	ЗНАЧЕНИЯ РегистрСведений.ЗначенияХарактеристикОС
	//|	ОБЪЕКТ ОсновноеСредство
	//|	ХАРАКТЕРИСТИКА ВидХарактеристики
	//|	ЗНАЧЕНИЕ ЗначениеХарактеристики }";
	
	Возврат ТекстЗапроса;
	
КонецФункции

