// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СтруктураБыстрыеОтборы = Новый Структура("ТипДанных,ИмяОбъекта,ИмяТаблицы,НачалоПериода,КонецПериода,Организация,Подразделение");
	
	СтандартныеОтчеты.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Отчет.РежимРасшифровки = Параметры.ПредставлениеВарианта = "Расшифровка";
	
	Если Отчет.РежимРасшифровки Тогда
		Для каждого КлючЗначение из СтруктураБыстрыеОтборы цикл
			Значение = Неопределено;
			Если Параметры.Свойство(КлючЗначение.Ключ, Значение) тогда
				Отчет[КлючЗначение.Ключ] = Значение;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	ИнициализацияЭлементовФормы();
	ИнициализироватьОтчет();
	
	Если Отчет.РежимРасшифровки и ТипЗнч(Параметры.Расшифровка) = Тип("ОписаниеОбработкиРасшифровкиКомпоновкиДанных") Тогда
		//Отчет.Группировка.Очистить();
		АдресГруппировки = Неопределено;
		Если Параметры.Свойство("ИспользуемаяГруппировка",АдресГруппировки) Тогда
			ТекГруппировка = ПолучитьИзВременногоХранилища(АдресГруппировки);
			Отчет.Группировка.Загрузить(ТекГруппировка);
		КонецЕсли;
		Для каждого ЭлементСтруктуры из Параметры.Расшифровка.ПрименяемыеНастройки.Структура цикл
			Если ТипЗнч(ЭлементСтруктуры) = Тип("ГруппировкаКомпоновкиДанных") тогда
				Для каждого ЭлементВывода из  ЭлементСтруктуры.ПараметрыВывода.Элементы цикл
					Если ЭлементВывода.Параметр = Новый ПараметрКомпоновкиДанных("МакетОформления") тогда
						ЭлементВывода.Использование = Истина;
					КонецЕсли;	
				КонецЦикла;
				Для каждого ЭлементГруппировки из ЭлементСтруктуры.ПоляГруппировки.Элементы цикл
					НовСтр = Отчет.Группировка.Добавить();
					НовСтр.Поле = ЭлементГруппировки.Поле;
					НовСтр.Представление = Строка(ЭлементГруппировки.Поле);
					НовСтр.ТипГруппировки = ?(ЭлементГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы,0,?(ЭлементГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия,1,2));
					НовСтр.Использование = ЭлементГруппировки.Использование;
				КонецЦикла;
			КонецЕсли;	
		КонецЦикла;		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СтандартныеОтчетыКлиент.ПриОткрытии(ЭтаФорма);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	Если НЕ Отчет.РежимРасшифровки Тогда
		ИнициализироватьОтчет();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	ВариантМодифицирован                    = Ложь;
	ПользовательскиеНастройкиМодифицированы = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	//СтандартныеОтчеты.ПриСохраненииПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	ПриСохраненииПользовательскихНастроекНаСервере_СтандартныеДействия(ЭтаФорма, Настройки);
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
	//Если НЕ Отчет.РежимРасшифровки Тогда
	//	ИнициализироватьОтчет(Истина);
	//КонецЕсли;
	
	//Если НЕ Отчет.РежимРасшифровки Тогда
		//СтандартныеОтчеты.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	//КонецЕсли;
	
	ПриЗагрузкеПользовательскихНастроекНаСервере_СтандартныеДействия(ЭтаФорма, Настройки);
	
	ОбновитьСписокВыбораОбъектов();
	ОбновитьСписокВыбораТаблиц();
    СписокВыбораТаблиц = Элементы.ИмяТаблицы.СписокВыбора;
	Если СписокВыбораТаблиц.Количество() > 1 Тогда
		Элементы.ИмяТаблицы.Видимость = Истина;
	Иначе
		Элементы.ИмяТаблицы.Видимость = Ложь;
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма);
	Если Отчет.РежимРасшифровки Тогда
		СформироватьОтчетСервер();
	КонецЕсли;
	ОбновитьТекстЗаголовка(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере_СтандартныеДействия(ФормаОтчета, Настройки, СохранятьТолькоРеквизиты = Ложь, ДопРеквизитыФормы = Неопределено) Экспорт
	
	Если Не РольДоступна(Метаданные.Роли.СохранениеДанныхПользователя) И НЕ РольДоступна(Метаданные.Роли.ПолныеПрава) Тогда
		Возврат;
	КонецЕсли;
	
	ОтчетОбъект = ФормаОтчета.РеквизитФормыВЗначение("Отчет");
	
	Попытка
		Если ОтчетОбъект.РежимРасшифровки Тогда
			Возврат;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	ОтчетМетаданные = ОтчетОбъект.Метаданные();
	
	Если НЕ СохранятьТолькоРеквизиты Тогда
		ТекущиеНастройки = ОтчетОбъект.КомпоновщикНастроек.Настройки;
		
		// Очистка пользовательских настроек
		ТекущиеНастройки.Отбор.ИдентификаторПользовательскойНастройки              = "";
		ТекущиеНастройки.Порядок.ИдентификаторПользовательскойНастройки            = "";
		ТекущиеНастройки.УсловноеОформление.ИдентификаторПользовательскойНастройки = "";
		ТекущиеНастройки.Выбор.ИдентификаторПользовательскойНастройки 			   = "";
		
		// Установка пользовательских настроек
		ТекущиеНастройки.Отбор.ИдентификаторПользовательскойНастройки              = "Отбор";
		ТекущиеНастройки.Порядок.ИдентификаторПользовательскойНастройки            = "Порядок";
		ТекущиеНастройки.УсловноеОформление.ИдентификаторПользовательскойНастройки = "УсловноеОформление";
		ТекущиеНастройки.Выбор.ИдентификаторПользовательскойНастройки 			   = "Выбор";
	КонецЕсли;

	// Сохранение реквизитов отчета
	ДополнительныеСвойства = Новый Структура;
	Для Каждого Реквизит Из ОтчетМетаданные.Реквизиты Цикл
		ДополнительныеСвойства.Вставить(Реквизит.Имя, ОтчетОбъект[Реквизит.Имя]);
	КонецЦикла;
	Для Каждого Реквизит Из ОтчетМетаданные.ТабличныеЧасти Цикл
		ДополнительныеСвойства.Вставить(Реквизит.Имя, ОтчетОбъект[Реквизит.Имя].Выгрузить());
	КонецЦикла;
	
	Если НЕ СохранятьТолькоРеквизиты Тогда
		// Сохранение реквизитов формы
		ДополнительныеСвойства.Вставить("ВыводитьЗаголовок", ФормаОтчета.ВыводитьЗаголовок);
		ДополнительныеСвойства.Вставить("ВыводитьПодвал"   , ФормаОтчета.ВыводитьПодвал);	
		ДополнительныеСвойства.Вставить("МакетОформления"  , ФормаОтчета.МакетОформления);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДопРеквизитыФормы) Тогда
		ДополнительныеСвойства.Вставить("ДопРеквизитыФормы",ДопРеквизитыФормы);
	КонецЕсли;
	
	Настройки.ДополнительныеСвойства.Вставить("ДанныеОтчета", Новый ХранилищеЗначения(ДополнительныеСвойства));
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере_СтандартныеДействия(ФормаОтчета, Настройки, ЗагружатьТолькоРеквизиты = Ложь) Экспорт
	
	ОтчетОбъект = ФормаОтчета.РеквизитФормыВЗначение("Отчет");
	Попытка
		Если ОтчетОбъект.РежимРасшифровки Тогда
			Возврат;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Если Настройки = Неопределено ИЛИ (Не РольДоступна(Метаданные.Роли.СохранениеДанныхПользователя) И НЕ РольДоступна(Метаданные.Роли.ПолныеПрава)) Тогда
		// Установка настроек по умолчанию
		СтандартныеОтчеты.УстановитьНастройкиПоУмолчанию(ФормаОтчета);
	Иначе 
		// Восстановление сохраненных настроек
		Если Настройки.ДополнительныеСвойства.Свойство("ДанныеОтчета") Тогда
			ДополнительныеСвойства = Настройки.ДополнительныеСвойства.ДанныеОтчета.Получить();
			Для Каждого ЭлементСтруктуры Из ДополнительныеСвойства Цикл
				// Восстановление реквизитов отчета
				Если ФормаОтчета.Отчет.Свойство(ЭлементСтруктуры.Ключ) Тогда
					Если ТипЗнч(ЭлементСтруктуры.Значение) = Тип("ТаблицаЗначений") Тогда
						ФормаОтчета.Отчет[ЭлементСтруктуры.Ключ].Загрузить(ЭлементСтруктуры.Значение);
					Иначе
						Если ЭлементСтруктуры.Ключ = "Организация" И ЗначениеЗаполнено(ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию()) Тогда
							ФормаОтчета.Отчет[ЭлементСтруктуры.Ключ] = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
						Иначе
							ФормаОтчета.Отчет[ЭлементСтруктуры.Ключ] = ЭлементСтруктуры.Значение;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				Если Не ЗагружатьТолькоРеквизиты Тогда
					// Восстановление реквизитов формы
					Если ЭлементСтруктуры.Ключ = "ВыводитьЗаголовок" Тогда
						ФормаОтчета.ВыводитьЗаголовок = ЭлементСтруктуры.Значение;
					ИначеЕсли ЭлементСтруктуры.Ключ = "ВыводитьПодвал" Тогда
						ФормаОтчета.ВыводитьПодвал = ЭлементСтруктуры.Значение;
					ИначеЕсли ЭлементСтруктуры.Ключ = "МакетОформления" Тогда
						ФормаОтчета.МакетОформления = ЭлементСтруктуры.Значение;
						СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(
							ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки, 
							"МакетОформления", ФормаОтчета.МакетОформления);
					КонецЕсли;
					Если ЭлементСтруктуры.Ключ = "ДопРеквизитыФормы" Тогда
						Для Каждого ДопРеквизитФормы Из ЭлементСтруктуры.Значение Цикл
							Если ТипЗнч(ДопРеквизитФормы.Значение) = Тип("ТаблицаЗначений") Тогда
								ФормаОтчета[ДопРеквизитФормы.Ключ].Загрузить(ДопРеквизитФормы.Значение);
							Иначе
								ФормаОтчета[ДопРеквизитФормы.Ключ] = ДопРеквизитФормы.Значение;
							КонецЕсли; 	
						КонецЦикла;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ИнициализироватьОтчет(Ложь,Ложь);
		
		Если Не ЗагружатьТолькоРеквизиты Тогда
			
			
			ТекущиеНастройки = ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки;
			
			// Установка пользовательских настроек
			ТекущиеНастройки.Отбор.ИдентификаторПользовательскойНастройки              = "Отбор";
			ТекущиеНастройки.Порядок.ИдентификаторПользовательскойНастройки            = "Порядок";
			ТекущиеНастройки.УсловноеОформление.ИдентификаторПользовательскойНастройки = "УсловноеОформление";
			ТекущиеНастройки.Выбор.ИдентификаторПользовательскойНастройки 			   = "Выбор";
			// Перенос пользовательских настроек в основные
			ФормаОтчета.Отчет.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(Настройки);
			ФормаОтчета.Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(ФормаОтчета.Отчет.КомпоновщикНастроек.ПолучитьНастройки());
			
			// Очистка пользовательских настроек
			ТекущиеНастройки = ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки;
			ТекущиеНастройки.Отбор.ИдентификаторПользовательскойНастройки              = "";
			ТекущиеНастройки.Порядок.ИдентификаторПользовательскойНастройки            = "";
			ТекущиеНастройки.УсловноеОформление.ИдентификаторПользовательскойНастройки = "";
			ТекущиеНастройки.Выбор.ИдентификаторПользовательскойНастройки 			   = "";
			
			// Если стоит отбор по Организации вида "Организация = ...", то "...",
			// заменяем на ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию()
			ЗаменяемВОтбореОрганизациюНаОрганизациюПоУмолчанию(ТекущиеНастройки.Отбор.Элементы);
			
		КонецЕсли;
	КонецЕсли;
	
	СтандартныеОтчеты.СинхронизироватьПоляОтбораСоСпискомДоступныхПолей(ФормаОтчета.Отчет.КомпоновщикНастроек);

КонецПроцедуры

Процедура ЗаменяемВОтбореОрганизациюНаОрганизациюПоУмолчанию(Элементы)
	
	ПолеОрганизация = Новый ПолеКомпоновкиДанных("Организация");
	Для каждого Отбор из Элементы Цикл
		Если ТипЗнч(Отбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ЗаменяемВОтбореОрганизациюНаОрганизациюПоУмолчанию(Отбор.Элементы);
		ИначеЕсли
			Отбор.ЛевоеЗначение = ПолеОрганизация И
			Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
		Тогда
			Отбор.ПравоеЗначение = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	Перем ВыбранноеДействие;
	Перем ПараметрыВыбранногоДействия;
	Перем ПараметрыРасшифровкиДляСтандартныхОтчетов;
	
	МассивОсновныхДействий = Новый Массив;
	МассивОсновныхДействий.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение);
	МассивОсновныхДействий.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Расшифровать);
	МассивОсновныхДействий.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Отфильтровать);
    МассивОсновныхДействий.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.Сгруппировать);
	
	СтандартнаяОбработка = Ложь;
	ПоказательСчет = Новый Структура;
		
	ЗаполняемыеНастройки = Новый Структура("Показатели, Группировка, Отбор", Истина, Истина, Ложь);
	
	ДанныеОтчета = Новый Структура("Организация, НачалоПериода, КонецПериода, ТипДанных, ИмяОбъекта, ИмяТаблицы",Отчет.Организация,Отчет.НачалоПериода,Отчет.КонецПериода,Отчет.ТипДанных,Отчет.ИмяОбъекта,Отчет.ИмяТаблицы);
	
	//ДополнительныеДействия = СтандартныеОтчеты.ПолучитьСписокДополнительнойРасшифровки(ДанныеОтчета, ДанныеРасшифровки, Расшифровка, ПоказательСчет, ПараметрыРасшифровкиДляСтандартныхОтчетов);
	
	ДополнительныеДействия = Новый СписокЗначений;
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(ДанныеРасшифровки,Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	
	Если МассивОсновныхДействий = Неопределено тогда
		ОбработкаРасшифровки.ПоказатьВыборДействия(Новый ОписаниеОповещения("РезультатОбработкаРасшифровкиЗавершение", ЭтотОбъект, Новый Структура("ВыбранноеДействие, ПараметрыВыбранногоДействия, Расшифровка", ВыбранноеДействие, ПараметрыВыбранногоДействия, Расшифровка)), Расшифровка,, ДополнительныеДействия);
	Иначе
		ОбработкаРасшифровки.ПоказатьВыборДействия(Новый ОписаниеОповещения("РезультатОбработкаРасшифровкиЗавершение", ЭтотОбъект, Новый Структура("ВыбранноеДействие, ПараметрыВыбранногоДействия, Расшифровка", ВыбранноеДействие, ПараметрыВыбранногоДействия, Расшифровка)), Расшифровка, МассивОсновныхДействий, ДополнительныеДействия);
        Возврат;
	КонецЕсли;	
	
	РезультатОбработкаРасшифровкиФрагмент(ВыбранноеДействие, ПараметрыВыбранногоДействия, Расшифровка);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровкиЗавершение(ВыбранноеДействие, ПараметрыВыбранногоДействия, ДополнительныеПараметры) Экспорт
	
	Расшифровка = ДополнительныеПараметры.Расшифровка;
	
	
	РезультатОбработкаРасшифровкиФрагмент(ВыбранноеДействие, ПараметрыВыбранногоДействия, Расшифровка);

КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровкиФрагмент(Знач ВыбранноеДействие, Знач ПараметрыВыбранногоДействия, Знач Расшифровка)
	
	Перем ПараметрыФормы;
	
	Если ПараметрыВыбранногоДействия<>Неопределено И ПараметрыВыбранногоДействия<>Null тогда
		Если ВыбранноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение тогда
			ПоказатьЗначение(Неопределено, ПараметрыВыбранногоДействия);
		Иначе
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
			ПараметрыФормы.Вставить("Расшифровка", Новый ОписаниеОбработкиРасшифровкиКомпоновкиДанных(ДанныеРасшифровки, Расшифровка, ПараметрыВыбранногоДействия));
			ПараметрыФормы.Вставить("Организация", 			Отчет.Организация);
			ПараметрыФормы.Вставить("Подразделение", 		Отчет.Подразделение);
			ПараметрыФормы.Вставить("ТипДанных", 			Отчет.ТипДанных);
			ПараметрыФормы.Вставить("ИмяОбъекта", 			Отчет.ИмяОбъекта);
			ПараметрыФормы.Вставить("ИмяТаблицы", 			Отчет.ИмяТаблицы);
			ПараметрыФормы.Вставить("ПредставлениеВарианта","Расшифровка");
			ПараметрыФормы.Вставить("НачалоПериода",		Отчет.НачалоПериода);
			ПараметрыФормы.Вставить("КонецПериода",			Отчет.КонецПериода);
			Если ВыбранноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Отфильтровать 
				ИЛИ ВыбранноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Упорядочить 
				ИЛИ ВыбранноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Сгруппировать
				ИЛИ ВыбранноеДействие = ДействиеОбработкиРасшифровкиКомпоновкиДанных.Оформить Тогда
				ПараметрыФормы.Вставить("ИспользуемаяГруппировка",ПоместитьГруппировкуВоВременноеХранилище());
			КонецЕсли;	
			ОткрытьФорму(ЭтаФорма.ИмяФормы, ПараметрыФормы,,Истина);
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПоместитьГруппировкуВоВременноеХранилище()
	Возврат ПоместитьВоВременноеХранилище(Отчет.Группировка.Выгрузить(),УникальныйИдентификатор);	
КонецФункции

&НаКлиенте
Процедура РезультатОбработкаДополнительнойРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	// Не будем обрабатывать нажатие на правую кнопку мыши.
	// Покажем стандартное контекстное меню ячейки табличного документа.
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяОбъектаПриИзменении(Элемент)
	
	Отчет.ИмяТаблицы = "";
	
	ИсточникПриИзмененииНаСервере("ИмяОбъекта");
	
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяТаблицыПриИзменении(Элемент)
	
	ИнициализироватьОтчет(Истина);
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипДанныхПриИзменении(Элемент)
	
	Отчет.ИмяОбъекта = "";
	Отчет.ИмяТаблицы = "";
	ИсточникПриИзмененииНаСервере("ТипДанных");
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

