&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовка(Форма)
	
	Отчет = Форма.Отчет;
	
	ТекТипДанных = "";
	ИскомоеЗначениеТипаДанных = Форма.Элементы.ТипДанных.СписокВыбора.НайтиПоЗначению(Отчет.ТипДанных);
	Если ИскомоеЗначениеТипаДанных<>Неопределено Тогда
		ТекТипДанных = ИскомоеЗначениеТипаДанных.Представление;
	Иначе
		ТекТипДанных = Отчет.ТипДанных;
	КонецЕсли;
	
	ТекИмяОбъекта = "";
	ИскомоеЗначениеИмяОбъекта = Форма.Элементы.ИмяОбъекта.СписокВыбора.НайтиПоЗначению(Отчет.ИмяОбъекта);
	Если ИскомоеЗначениеИмяОбъекта<>Неопределено Тогда
		ТекИмяОбъекта = ИскомоеЗначениеИмяОбъекта.Представление;
	Иначе
		ТекИмяОбъекта = Отчет.ИмяОбъекта;
	КонецЕсли;
	
	ТекИмяТаблицы = "";
	Если ЗначениеЗаполнено(Отчет.ИмяТаблицы) Тогда
		ИскомоеЗначениеИмяТаблицы = Форма.Элементы.ИмяТаблицы.СписокВыбора.НайтиПоЗначению(Отчет.ИмяТаблицы);
		Если ИскомоеЗначениеИмяТаблицы<>Неопределено Тогда
			ТекИмяТаблицы = ИскомоеЗначениеИмяТаблицы.Представление;
		Иначе
			ТекИмяТаблицы = Отчет.ИмяТаблицы;
		КонецЕсли;		
	КонецЕсли;
	
	ЗаголовокОтчета =  "Универсальный отчет по данным: Тип данных - """ + ТекТипДанных + """,  Имя объекта """ + ТекИмяОбъекта + ?(ЗначениеЗаполнено(Отчет.ИмяТаблицы),""", Имя таблицы """+ТекИмяТаблицы+""" ","""")
				+ СтандартныеОтчетыКлиентСервер.ПолучитьПредставлениеПериода(Отчет.НачалоПериода, Отчет.КонецПериода);
	
	Форма.Заголовок = ЗаголовокОтчета;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьЗапрещенныеПоля(Режим = "") Экспорт
	
	СписокПолей = Новый Массив;
	
	СписокПолей.Добавить("UserFields");
	СписокПолей.Добавить("DataParameters");
	СписокПолей.Добавить("SystemFields");
	
	Если Не ФОУчетПоПодразделениям Тогда
		СписокПолей.Добавить("Подразделение");
		СписокПолей.Добавить("ПодразделениеКор");
		СписокПолей.Добавить("ПодразделениеДт");
		СписокПолей.Добавить("ПодразделениеКт");
	КонецЕсли;
	Если Не ФОУчетПоИФО Тогда
		СписокПолей.Добавить("ИФО");
		СписокПолей.Добавить("ИФОКор");
	КонецЕсли;
	Если Не ФОВалютныйУчет Тогда
		СписокПолей.Добавить("Валюта");
		СписокПолей.Добавить("ВалютаДт");
		СписокПолей.Добавить("ВалютаКт");
		СписокПолей.Добавить("ВалютнаяСумма");
		СписокПолей.Добавить("ВалютнаяСуммаДт");
        СписокПолей.Добавить("ВалютнаяСуммаКт");

		
	КонецЕсли;
	
	Если Режим = "Группировка" Тогда
		МассивРесурсов = Новый Массив;
		Если Отчет.ТипДанных = "РегистрыНакопления" Тогда
			МассивРесурсов = ПолучитьПоляРегистраНакопления("Ресурсы",Отчет.ИмяОбъекта);
		ИначеЕсли Отчет.ТипДанных = "РегистрыБухгалтерии" Тогда
			МассивРесурсов = ПолучитьПоляРегистраБухгалтерии("Ресурсы",Отчет.ИмяОбъекта);
		КонецЕсли;
		Если МассивРесурсов.Количество()>0 Тогда
			Для Каждого РесурсМассива Из МассивРесурсов Цикл
				СписокПолей.Добавить(РесурсМассива);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый ФиксированныйМассив(СписокПолей);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПоляРегистраНакопления(ВидПоля,ИмяРегистра)
	
	Массив = Новый Массив;
	ВидыПолей = Новый Массив;
	ВидыПолей.Добавить("");
	ВидыПолей.Добавить("Приход");
	ВидыПолей.Добавить("Расход");
	ВидыПолей.Добавить("Оборот");
	ВидыПолей.Добавить("НачальныйОстаток");
	ВидыПолей.Добавить("КонечныйОстаток");
	
	Для Каждого Элемент Из Метаданные.РегистрыНакопления[ИмяРегистра][ВидПоля] Цикл
		Для Каждого ВидПоля Из ВидыПолей Цикл
			Массив.Добавить(Элемент.Имя + ВидПоля);
		КонецЦикла;
	КонецЦикла;

	Возврат Массив;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПоляРегистраБухгалтерии(ВидПоля,ИмяРегистра)
	
	Массив = Новый Массив;
	ВидыПолей = Новый Массив;
	ВидыПолей.Добавить("");
	ВидыПолей.Добавить("Дт");
	ВидыПолей.Добавить("Кт");
	ВидыПолей.Добавить("Оборот");
	ВидыПолей.Добавить("ОборотДт");
	ВидыПолей.Добавить("ОборотКт");
	ВидыПолей.Добавить("КорОборот");
	ВидыПолей.Добавить("КорОборотДт");
	ВидыПолей.Добавить("КорОборотКт");
	ВидыПолей.Добавить("Остаток");
	ВидыПолей.Добавить("ОстатокДт");
	ВидыПолей.Добавить("ОстатокКт");
	ВидыПолей.Добавить("РазвернутыйОстатокДт");
	ВидыПолей.Добавить("РазвернутыйОстатокКт");
	ВидыПолей.Добавить("НачальныйОстаток");
	ВидыПолей.Добавить("НачальныйОстатокДт");
	ВидыПолей.Добавить("НачальныйОстатокКт");
	ВидыПолей.Добавить("НачальныйРазвернутыйОстатокДт");
	ВидыПолей.Добавить("НачальныйРазвернутыйОстатокКт");
	ВидыПолей.Добавить("КонечныйОстаток");
    ВидыПолей.Добавить("КонечныйОстатокДт");
	ВидыПолей.Добавить("КонечныйОстатокКт");
	ВидыПолей.Добавить("КонечныйРазвернутыйОстатокДт");
	ВидыПолей.Добавить("КонечныйРазвернутыйОстатокКт");
	
	Для Каждого Элемент Из Метаданные.РегистрыБухгалтерии[ИмяРегистра][ВидПоля] Цикл
		Для Каждого ВидПоля Из ВидыПолей Цикл
			Массив.Добавить(Элемент.Имя + ВидПоля);
		КонецЦикла;
	КонецЦикла;

	Возврат Массив;
	
КонецФункции

&НаСервере
Процедура СформироватьОтчетСервер() Экспорт
	Перем ОбъектДанныхРасшифровки;
	Если Не ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
	
	Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыводитьЗаголовок", ВыводитьЗаголовок);
	Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыводитьПодвал"   , ВыводитьПодвал);
	ОбъектОтчет = РеквизитФормыВЗначение("Отчет");
	
	ОбъектОтчет.СформироватьОтчет(Результат, ДанныеРасшифровки, СхемаКомпоновкиДанных, Истина,ЭтаФорма.УникальныйИдентификатор);
	СтандартныеОтчеты.УстановитьКолонтитулыПоУмолчанию(Результат, ОбъектОтчет.Метаданные().Синоним, Строка(ПользователиКлиентСервер.АвторизованныйПользователь()), Отчет.Организация);

	СтандартныеОтчетыКлиентСервер.УстановитьСостояние(ЭтаФорма, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкамиПоУмолчанию(ЗаполняемыеНастройки) Экспорт
	//Процедура оставлена для совместимости
КонецПроцедуры


&НаСервере
Процедура УстановитьПоУмолчаниюТипДанных()
	
	Если ПустаяСтрока(Отчет.ТипДанных) Тогда
		Отчет.ТипДанных = "РегистрыНакопления";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьПоУмолчаниюОбъект()
	
	Если ПустаяСтрока(Отчет.ИмяОбъекта) Тогда
		Отчет.ИмяОбъекта = Элементы.ИмяОбъекта.СписокВыбора[0].Значение;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьПоУмолчаниюТаблицу()
	
	СписокВыбораТаблиц = Элементы.ИмяТаблицы.СписокВыбора;
	Если СписокВыбораТаблиц.Количество() > 1 Тогда
		Отчет.ИмяТаблицы = СписокВыбораТаблиц[1].Значение;
		Элементы.ИмяТаблицы.Видимость = Истина;
	Иначе
		Элементы.ИмяТаблицы.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализацияЭлементовФормы()
	ОбновитьСписокВыбораТипДанных();
	УстановитьПоУмолчаниюТипДанных();
	ОбновитьСписокВыбораОбъектов();
	УстановитьПоУмолчаниюОбъект();
	ОбновитьСписокВыбораТаблиц();
	УстановитьПоУмолчаниюТаблицу();	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокВыбораТипДанных()
	
    Элементы.ТипДанных.СписокВыбора.Очистить();
	Элементы.ТипДанных.СписокВыбора.Добавить("Документы", "Документ", , БиблиотекаКартинок.Документ);
	Элементы.ТипДанных.СписокВыбора.Добавить("Справочники", "Справочник", , БиблиотекаКартинок.Справочник);
	Элементы.ТипДанных.СписокВыбора.Добавить("РегистрыНакопления", "Регистр накопления", , БиблиотекаКартинок.РегистрНакопления);
	Элементы.ТипДанных.СписокВыбора.Добавить("РегистрыСведений", "Регистр сведений", , БиблиотекаКартинок.РегистрСведений);
	Элементы.ТипДанных.СписокВыбора.Добавить("РегистрыБухгалтерии", "Регистр бухгалтерии", , БиблиотекаКартинок.РегистрБухгалтерии);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокВыбораОбъектов()
	
	Элементы.ИмяОбъекта.СписокВыбора.Очистить();
	СписокОбъектов = Новый СписокЗначений;
	Для каждого Объект Из Метаданные[Отчет.ТипДанных] Цикл
		Элементы.ИмяОбъекта.СписокВыбора.Добавить(Объект.Имя, Объект.Синоним);
	КонецЦикла;
	Элементы.ИмяОбъекта.СписокВыбора.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокВыбораТаблиц()
	Элементы.ИмяТаблицы.СписокВыбора.Очистить();
	СписокВыбораТаблиц = Элементы.ИмяТаблицы.СписокВыбора;
	СписокВыбораТаблиц.Добавить("", "");
	Если Отчет.ТипДанных = "Документы" ИЛИ Отчет.ТипДанных = "Справочники" Тогда
		Для каждого ТабличнаяЧасть Из Метаданные[Отчет.ТипДанных][Отчет.ИмяОбъекта].ТабличныеЧасти Цикл
			СписокВыбораТаблиц.Добавить(ТабличнаяЧасть.Имя, ТабличнаяЧасть.Синоним);
		КонецЦикла;
	ИначеЕсли Отчет.ТипДанных = "РегистрыНакопления" Тогда
		Если Метаданные[Отчет.ТипДанных][Отчет.ИмяОбъекта].ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			СписокВыбораТаблиц.Добавить("ОстаткиИОбороты", "Остатки и обороты");
		Иначе
			СписокВыбораТаблиц.Добавить("Обороты", "Обороты");
		КонецЕсли;
	ИначеЕсли Отчет.ТипДанных = "РегистрыСведений" Тогда 
		Если Метаданные[Отчет.ТипДанных][Отчет.ИмяОбъекта].ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		Иначе
			СписокВыбораТаблиц.Добавить("СрезПоследних", "Срез последних");
			СписокВыбораТаблиц.Добавить("СрезПервых", "Срез первых");
		КонецЕсли;
	ИначеЕсли Отчет.ТипДанных = "РегистрыБухгалтерии" Тогда
		СписокВыбораТаблиц.Добавить("ОстаткиИОбороты", "Остатки и обороты");
		СписокВыбораТаблиц.Добавить("Остатки", "Остатки");
		СписокВыбораТаблиц.Добавить("Обороты", "Обороты");
		СписокВыбораТаблиц.Добавить("ОборотыДтКт", "Обороты Дт/Кт");
		СписокВыбораТаблиц.Добавить("ДвиженияССубконто", "Движения с субконто");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИсточникПриИзмененииНаСервере(ИмяИсточника)
	
	Если ИмяИсточника = "ТипДанных" Тогда
		ОбновитьСписокВыбораОбъектов();
		УстановитьПоУмолчаниюОбъект();
	КонецЕсли;
	
	Если ИмяИсточника = "ТипДанных" ИЛИ ИмяИсточника = "ИмяОбъекта" Тогда
		ОбновитьСписокВыбораТаблиц();
		УстановитьПоУмолчаниюТаблицу();
	КонецЕсли;
	
	Отчет.РежимРасшифровки = Ложь;
	
	ИнициализироватьОтчет(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьОтчет(ОчиститьПоляГруппировки = Ложь, ЗаполнятьСтруктуруПоУмолчанию = Истина)
	
	Если ПустаяСтрока(Отчет.ТипДанных) ИЛИ ПустаяСтрока(Отчет.ИмяОбъекта) Тогда
		Возврат;
	КонецЕсли;
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	Если ОчиститьПоляГруппировки Тогда
		ОтчетОбъект.Группировка.Очистить();
	КонецЕсли;
	
	СКД = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СКД.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "НаборДанных1";
	НаборДанных.ИсточникДанных = ИсточникДанных.Имя;
	
	СКД.ПоляИтога.Очистить();
	ОтчетОбъект.КомпоновщикНастроек.Восстановить(); 
    ОтчетОбъект.КомпоновщикНастроек.Настройки.Структура.Очистить();
	ОтчетОбъект.КомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();

	СКД.НаборыДанных[0].Запрос = ОтчетОбъект.СформироватьЗапросПоМетаданным();
	ОтчетОбъект.ДобавитьПоляНабораДанных(СКД);
	СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СКД,УникальныйИдентификатор);
	ОтчетОбъект.КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	ОтчетОбъект.КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
	Если НЕ Отчет.РежимРасшифровки И ЗаполнятьСтруктуруПоУмолчанию Тогда
		ОтчетОбъект.ЗаполнитьСтруктуруПоУмолчанию();
	КонецЕсли;
	ОтчетОбъект.ДобавитьПоказатели();
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(ОтчетОбъект.КомпоновщикНастроек, "Title", Метаданные[Отчет.ТипДанных][Отчет.ИмяОбъекта].Синоним);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(ОтчетОбъект.КомпоновщикНастроек, "TitleOutput", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(ОтчетОбъект.КомпоновщикНастроек, "FilterOutput", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(ОтчетОбъект.КомпоновщикНастроек, "DataParametersOutput", ТипВыводаТекстаКомпоновкиДанных.НеВыводить);
    
	
	ЗначениеВРеквизитФормы(ОтчетОбъект,"Отчет");
	
КонецПроцедуры
	
