
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

	
#Область ОписаниеПеременных

// Используется в обработчике события ПриЗаписи.
Перем СтароеЗначение;

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СтароеЗначение = Константы.ВестиУчетИмуществаКазны.Получить();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Значение <> СтароеЗначение Тогда
		ПараметрыНабора = УправлениеСвойствами.СтруктураПараметровНабораСвойств();
		ПараметрыНабора.Используется = ПолучитьФункциональнуюОпцию("ВестиУчетИмуществаКазны");
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_НакладнаяНаОтпускИК", ПараметрыНабора);	
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_ПоступлениеИК", ПараметрыНабора);	
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_ПринятиеКУчетуОбъектовИК", ПараметрыНабора); 
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_РешениеОПрекращенииПризнанияАктивомМЗИК", ПараметрыНабора); 
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_РешениеОПризнанииОбъектовМЗИК", ПараметрыНабора); 
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_РешениеОбОценкеИмуществаМЗИК", ПараметрыНабора); 
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_АктСписанияИК", ПараметрыНабора);
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_ПоступлениеОСИК", ПараметрыНабора); 
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_СписаниеТранспортаИК", ПараметрыНабора);
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_ПередачаОбъектовИК", ПараметрыНабора); 
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_ВнутреннееПеремещениеИК", ПараметрыНабора);
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_ПередачаГруппОбъектовИК", ПараметрыНабора);
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_РешениеОПризнанииОбъектовОСИК", ПараметрыНабора); 
		УправлениеСвойствами.УстановитьПараметрыНабораСвойств("Документ_РешениеОПрекращенииПризнанияАктивомИК", ПараметрыНабора);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли