#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра = "РегистрНакопления.РасчетыСоСтудентами";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РасчетыСоСтудентами.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.РасчетыСоСтудентами КАК РасчетыСоСтудентами
	|ГДЕ
	|	(РасчетыСоСтудентами.Регистратор ССЫЛКА Документ.РаспределениеОплатыОбразование
	|			ИЛИ РасчетыСоСтудентами.Регистратор ССЫЛКА Документ.НачислениеЗаУслугиОбразования)
	|	И РасчетыСоСтудентами.Факультет = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";
	
	Регистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	
	ОбновлениеИнформационнойБазы.ОтметитьРегистраторыКОбработке(Параметры, Регистраторы, ПолноеИмяРегистра);
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра = "РегистрНакопления.РасчетыСоСтудентами";
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьРегистраторыРегистраДляОбработки(
		Параметры.Очередь, Неопределено, ПолноеИмяРегистра);
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоДвижения = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = ПолноеИмяРегистра;
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ПредставлениеРегистратора = Строка(Выборка.Регистратор);
			ЗаполнитьФакультетДвижениях(Выборка.Регистратор);
		
		Исключение
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не удалось обработать движения документа: %1 по причине:
					|%2'"), 
					ПредставлениеРегистратора, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.РегистрыНакопления.РасчетыСоСтудентами, , ТекстСообщения);
		КонецПопытки;
				
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяРегистра);
	
КонецПроцедуры

Процедура ЗаполнитьФакультетДвижениях(Документ)

	НачатьТранзакцию();
	Попытка
	
		// Блокируем объект от изменения другими сеансами.
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.РасчетыСоСтудентами.НаборЗаписей");
		ЭлементБлокировки.УстановитьЗначение("Регистратор", Документ);
		Блокировка.Заблокировать();
		
		ДокументОбъект = Документ.ПолучитьОбъект();
		
		Если ДокументОбъект <> Неопределено И ЕстьНезаполненныеФакультетыВДвижениях(Документ) Тогда
			
			ДокументОбъект.Заблокировать();
			
			ТипДокумента = ТипЗнч(Документ);
			Если ТипДокумента = Тип("ДокументСсылка.НачислениеЗаУслугиОбразования") Тогда
				ЗаполнитьФакультетНачисление(Документ);
			ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РаспределениеОплатыОбразование") Тогда
				ЗаполнитьФакультетРаспределениеОплаты(Документ);
			Иначе	
				ВызватьИсключение "Неправильный тип документа " + ТипДокумента;
			КонецЕсли;
			
		Иначе
			// Документ удален или движения документа не соответствуют ожидаемым
			ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
			ДополнительныеПараметры.ПолноеИмяРегистра = "РегистрНакопления.РасчетыСоСтудентами";
			ДополнительныеПараметры.ЭтоДвижения = Истина;
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Документ, ДополнительныеПараметры);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ЕстьНезаполненныеФакультетыВДвижениях(Документ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	РегистрНакопления.РасчетыСоСтудентами КАК РасчетыСоСтудентами
	|ГДЕ
	|	РасчетыСоСтудентами.Регистратор = &Регистратор
	|	И РасчетыСоСтудентами.Факультет = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Регистратор", Документ);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат НЕ РезультатЗапроса.Пустой();

КонецФункции

Процедура ЗаполнитьФакультетНачисление(Документ)
	
	ФакультетДокумента = Документ.Факультет;
	
	НаборЗаписей = РегистрыНакопления.РасчетыСоСтудентами.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Документ);
	НаборЗаписей.Прочитать();
	Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
		ЗаписьНабора.Факультет = ФакультетДокумента;
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);

КонецПроцедуры

Процедура ЗаполнитьФакультетРаспределениеОплаты(Документ)

	ДополнительныеСвойства = Новый Структура;
	ДополнительныеСвойства.Вставить("ТаблицыДляДвижений", Новый Структура);
	
	Документы.РаспределениеОплатыОбразование.ИнициализироватьДанныеДокумента(Документ, ДополнительныеСвойства);
			
	НаборЗаписей = РегистрыНакопления.РасчетыСоСтудентами.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Документ);
	НаборЗаписей.Загрузить(ДополнительныеСвойства.ТаблицыДляДвижений.РасчетыСоСтудентами);
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			
КонецПроцедуры

#КонецОбласти

#КонецЕсли
