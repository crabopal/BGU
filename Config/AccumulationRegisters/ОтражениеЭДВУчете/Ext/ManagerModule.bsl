// Формирует текст запроса по документу для формирование движений в регистре
// накопления "ОтражениеЭДВУчете"
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ, для которого формируется запрос
//
// Возвращаемое значение:
//  - Строка - текст запроса 
Функция ТекстЗапросаПоОтражениюЭДВУчете(ДокументСсылка) Экспорт
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовМЗ")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовМЗИК")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС") Тогда
		Текст =
		"ВЫБРАТЬ
		|	ОтражениеЭДВУчете.Ссылка КАК Регистратор,
		|	ВЫБОР
		|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
		|		ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА ОтражениеЭДВУчете.Дата
		|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
		|	КОНЕЦ КАК Период,
		|	ОтражениеЭДВУчете.Организация КАК Организация,
		|	ОтражениеЭДВУчете.ДокументОснование КАК ДокументЭД,
		|	ОтражениеЭДВУчете.Ссылка КАК ДокументОтраженияВУчете,
		|	ОтражениеЭДВУчете.СуммаДокумента КАК Сумма
		|ИЗ
		|	&ДокументИсточник КАК ОтражениеЭДВУчете
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
		|		ПО ДатыПроведенияДокументов.Документ = ОтражениеЭДВУчете.Ссылка
		|ГДЕ
		|	ОтражениеЭДВУчете.Ссылка = &Ссылка
		|	И ОтражениеЭДВУчете.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
		|	И НЕ ОтражениеЭДВУчете.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка)";
	Иначе	
		Текст =
		"ВЫБРАТЬ
		|	ОтражениеЭДВУчете.Ссылка КАК Регистратор,
		|	ВЫБОР
		|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
		|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА ОтражениеЭДВУчете.Дата
		|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
		|	КОНЕЦ КАК Период,
		|	ОтражениеЭДВУчете.Организация КАК Организация,
		|	ОтражениеЭДВУчете.ДокументОснование КАК ДокументЭД,
		|	ОтражениеЭДВУчете.Ссылка КАК ДокументОтраженияВУчете,
		|	ОтражениеЭДВУчете.СуммаДокумента КАК Сумма
		|ИЗ
		|	&ДокументИсточник КАК ОтражениеЭДВУчете
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
		|		ПО (ДатыПроведенияДокументов.Документ = ОтражениеЭДВУчете.Ссылка)
		|ГДЕ
		|	ОтражениеЭДВУчете.Ссылка = &Ссылка
		|	И ОтражениеЭДВУчете.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
		|	И НЕ ОтражениеЭДВУчете.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОтражениеЭДВУчете.Ссылка,
		|	ВЫБОР
		|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
		|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА ОтражениеЭДВУчете.Дата
		|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
		|	КОНЕЦ,
		|	ОтражениеЭДВУчете.Организация,
		|	ОтражениеЭДВУчете.ДокументОснование,
		|	ОтражениеЭДВУчете.Ссылка,
		|	ОтражениеЭДВУчете.СуммаДокумента
		|ИЗ
		|	&ДокументИсточник КАК ОтражениеЭДВУчете
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
		|		ПО (ДатыПроведенияДокументов.Документ = ОтражениеЭДВУчете.Ссылка)
		|ГДЕ
		|	ОтражениеЭДВУчете.Ссылка = &Ссылка
		|	И ОтражениеЭДВУчете.ДокументОснование ССЫЛКА Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий
		|	И НЕ ОтражениеЭДВУчете.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.ПустаяСсылка)";
	КонецЕсли;
	
	Текст = СтрЗаменить(Текст, "&ДокументИсточник", "Документ." + ДокументСсылка.Метаданные().Имя);
	
	Возврат Текст;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаРегистров = "РегистрНакопления.ОтражениеЭДВУчете";
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиРегистраторыРегистра();
	ПараметрыВыборки.МаксимумВыборки = 1000;
	
	Если НЕ ВБазеЕстьЭлектронныеДокументыПоставщика() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеМЗ.Ссылка КАК Регистратор,
	               |	ПоступлениеМЗ.ДокументОснование КАК ДокументОснование,
	               |	ОтражениеЭДВУчете.ДокументЭД КАК ДокументЭД
	               |ИЗ
	               |	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОтражениеЭДВУчете КАК ОтражениеЭДВУчете
	               |		ПО ПоступлениеМЗ.Ссылка = ОтражениеЭДВУчете.Регистратор
	               |ГДЕ
	               |	ПоступлениеМЗ.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	               |	И НЕ ПоступлениеМЗ.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка)
	               |	И ПоступлениеМЗ.Проведен = ИСТИНА
	               |	И ОтражениеЭДВУчете.ДокументЭД ЕСТЬ NULL
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоступлениеМЗВПути.Ссылка,
	               |	ПоступлениеМЗВПути.ДокументОснование,
	               |	ОтражениеЭДВУчете.ДокументЭД
	               |ИЗ
	               |	Документ.ПоступлениеМЗВПути КАК ПоступлениеМЗВПути
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОтражениеЭДВУчете КАК ОтражениеЭДВУчете
	               |		ПО ПоступлениеМЗВПути.Ссылка = ОтражениеЭДВУчете.Регистратор
	               |ГДЕ
	               |	ПоступлениеМЗВПути.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	               |	И НЕ ПоступлениеМЗВПути.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка)
	               |	И ПоступлениеМЗВПути.Проведен = ИСТИНА
	               |	И ОтражениеЭДВУчете.ДокументЭД ЕСТЬ NULL
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	АктПриемкиМ7.Ссылка,
	               |	АктПриемкиМ7.ДокументОснование,
	               |	ОтражениеЭДВУчете.ДокументЭД
	               |ИЗ
	               |	Документ.АктПриемкиМ7 КАК АктПриемкиМ7
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОтражениеЭДВУчете КАК ОтражениеЭДВУчете
	               |		ПО АктПриемкиМ7.Ссылка = ОтражениеЭДВУчете.Регистратор
	               |ГДЕ
	               |	АктПриемкиМ7.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	               |	И НЕ АктПриемкиМ7.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка)
	               |	И АктПриемкиМ7.Проведен = ИСТИНА
	               |	И ОтражениеЭДВУчете.ДокументЭД ЕСТЬ NULL
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоступлениеОС.Ссылка,
	               |	ПоступлениеОС.ДокументОснование,
	               |	ОтражениеЭДВУчете.ДокументЭД
	               |ИЗ
	               |	Документ.ПоступлениеОС КАК ПоступлениеОС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОтражениеЭДВУчете КАК ОтражениеЭДВУчете
	               |		ПО ПоступлениеОС.Ссылка = ОтражениеЭДВУчете.Регистратор
	               |ГДЕ
	               |	ПоступлениеОС.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	               |	И НЕ ПоступлениеОС.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка)
	               |	И ПоступлениеОС.Проведен = ИСТИНА
	               |	И ОтражениеЭДВУчете.ДокументЭД ЕСТЬ NULL
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоступлениеИК.Ссылка,
	               |	ПоступлениеИК.ДокументОснование,
	               |	ОтражениеЭДВУчете.ДокументЭД
	               |ИЗ
	               |	Документ.ПоступлениеИК КАК ПоступлениеИК
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОтражениеЭДВУчете КАК ОтражениеЭДВУчете
	               |		ПО ПоступлениеИК.Ссылка = ОтражениеЭДВУчете.Регистратор
	               |ГДЕ
	               |	ПоступлениеИК.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	               |	И НЕ ПоступлениеИК.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка)
	               |	И ПоступлениеИК.Проведен = ИСТИНА
	               |	И ОтражениеЭДВУчете.ДокументЭД ЕСТЬ NULL
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоступлениеОСВПути.Ссылка,
	               |	ПоступлениеОСВПути.ДокументОснование,
	               |	ОтражениеЭДВУчете.ДокументЭД
	               |ИЗ
	               |	Документ.ПоступлениеОСВПути КАК ПоступлениеОСВПути
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОтражениеЭДВУчете КАК ОтражениеЭДВУчете
	               |		ПО ПоступлениеОСВПути.Ссылка = ОтражениеЭДВУчете.Регистратор
	               |ГДЕ
	               |	ПоступлениеОСВПути.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	               |	И НЕ ПоступлениеОСВПути.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка)
	               |	И ПоступлениеОСВПути.Проведен = ИСТИНА
	               |	И ОтражениеЭДВУчете.ДокументЭД ЕСТЬ NULL
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПоступлениеУслугРабот.Ссылка,
	               |	ПоступлениеУслугРабот.ДокументОснование,
	               |	ОтражениеЭДВУчете.ДокументЭД
	               |ИЗ
	               |	Документ.ПоступлениеУслугРабот КАК ПоступлениеУслугРабот
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОтражениеЭДВУчете КАК ОтражениеЭДВУчете
	               |		ПО ПоступлениеУслугРабот.Ссылка = ОтражениеЭДВУчете.Регистратор
	               |ГДЕ
	               |	ПоступлениеУслугРабот.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	               |	И НЕ ПоступлениеУслугРабот.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка)
	               |	И ПоступлениеУслугРабот.Проведен = ИСТИНА
	               |	И ОтражениеЭДВУчете.ДокументЭД ЕСТЬ NULL
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПринятиеКУчетуОбъектовОС.Ссылка,
	               |	ПринятиеКУчетуОбъектовОС.ДокументОснование,
	               |	ОтражениеЭДВУчете.ДокументЭД
	               |ИЗ
	               |	Документ.ПринятиеКУчетуОбъектовОС КАК ПринятиеКУчетуОбъектовОС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОтражениеЭДВУчете КАК ОтражениеЭДВУчете
	               |		ПО ПринятиеКУчетуОбъектовОС.Ссылка = ОтражениеЭДВУчете.Регистратор
	               |ГДЕ
	               |	ПринятиеКУчетуОбъектовОС.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	               |	И НЕ ПринятиеКУчетуОбъектовОС.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка)
	               |	И ПринятиеКУчетуОбъектовОС.Проведен = ИСТИНА
	               |	И ОтражениеЭДВУчете.ДокументЭД ЕСТЬ NULL
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПринятиеКУчетуОбъектовИК.Ссылка,
	               |	ПринятиеКУчетуОбъектовИК.ДокументОснование,
	               |	ОтражениеЭДВУчете.ДокументЭД
	               |ИЗ
	               |	Документ.ПринятиеКУчетуОбъектовИК КАК ПринятиеКУчетуОбъектовИК
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОтражениеЭДВУчете КАК ОтражениеЭДВУчете
	               |		ПО ПринятиеКУчетуОбъектовИК.Ссылка = ОтражениеЭДВУчете.Регистратор
	               |ГДЕ
	               |	ПринятиеКУчетуОбъектовИК.ДокументОснование ССЫЛКА Документ.ЭлектронныйДокументПоставщика
	               |	И НЕ ПринятиеКУчетуОбъектовИК.ДокументОснование = ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументПоставщика.ПустаяСсылка)
	               |	И ПринятиеКУчетуОбъектовИК.Проведен = ИСТИНА
	               |	И ОтражениеЭДВУчете.ДокументЭД ЕСТЬ NULL";
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Счетчик = 0;
	РазмерПорции = 1000;
	ПорцияРегистраторов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Если Счетчик = РазмерПорции Тогда
			
			ЗарегистрироватьПорциюКОбработке(Параметры, ПорцияРегистраторов);
			ПорцияРегистраторов.Очистить();
			
			Счетчик = 0;
		КонецЕсли;
		
		ПорцияРегистраторов.Добавить(Выборка.Регистратор);
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	Если Счетчик > 0 Тогда
