#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ОтключитьПроверку") Тогда
		Возврат;
	КонецЕсли;

	КоличествоСубконто = 3;
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		Если Не ЗначениеЗаполнено(Запись.Счет) Тогда
			Продолжить;
		КонецЕсли;
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Запись.Счет);
		
		Если Не СвойстваСчета.УчетПоПодразделениям И ЗначениеЗаполнено(Запись.Подразделение) Тогда
			Запись.Подразделение = Справочники.Подразделения.ПустаяСсылка();
		КонецЕсли;
		
		Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ЗначениеЗаполнено(Запись.Подразделение) Тогда
			Запись.Подразделение = Справочники.Подразделения.ПустаяСсылка();
		КонецЕсли;
		
		Для НомерСубконто = 1 По КоличествоСубконто Цикл
			
			ИмяПоля = "Субконто" + НомерСубконто;
			ЗначениеСубконто = Запись[ИмяПоля];
			
			Если НомерСубконто > СвойстваСчета.КоличествоСубконто Тогда
				ЗначениеСубконто = Неопределено;
			Иначе	
				
				ИмяСвойстваТипЗначения = "ВидСубконто" + НомерСубконто + "ТипЗначения"; // См. ПолучитьСвойстваСчета()
				ТипСубконто = СвойстваСчета[ИмяСвойстваТипЗначения];
				
				Если Не ЗначениеЗаполнено(ЗначениеСубконто) И ТипСубконто.Типы().Количество() > 1 Тогда
					ЗначениеСубконто = Неопределено;
				Иначе
					ЗначениеСубконто = ТипСубконто.ПривестиЗначение(ЗначениеСубконто);
				КонецЕсли;
				
			КонецЕсли;
			
			Если Запись[ИмяПоля] <> ЗначениеСубконто Тогда
				Запись[ИмяПоля] = ЗначениеСубконто;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли