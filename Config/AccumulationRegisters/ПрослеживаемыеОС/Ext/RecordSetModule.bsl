#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "КонтрольОстатковПослеПроведения", Ложь) Тогда
		
		БлокироватьДляИзменения = Истина;
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = ДополнительныеСвойства.МенеджерТаблицИзмененияРегистров;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Таблица.Период КАК Период,
		|	Таблица.ВидДвижения КАК ВидДвижения,
		|	Таблица.Организация КАК Организация,
		|	Таблица.ОсновноеСредство КАК ОсновноеСредство,
		|	Таблица.СтранаПроисхождения КАК СтранаПроисхождения,
		|	Таблица.РНПТ КАК РНПТ,
		|	Таблица.Комплектующее КАК Комплектующее,
		|	Таблица.Количество КАК Количество
		|ПОМЕСТИТЬ ДвиженияПрослеживаемыеОСПередЗаписью
		|ИЗ
		|	РегистрНакопления.ПрослеживаемыеОС КАК Таблица
		|ГДЕ
		|	Таблица.Регистратор = &Регистратор";
		
		Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
		Запрос.Выполнить();

	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	ДополнительныеСвойства.Вставить("КонтрольИзмененийПриЗаписи", Ложь);
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "КонтрольОстатковПослеПроведения", Ложь) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Таблица.Период КАК Период,
		|	Таблица.Организация КАК Организация,
		|	Таблица.ОсновноеСредство КАК ОсновноеСредство,
		|	Таблица.РНПТ КАК РНПТ,
		|	Таблица.Комплектующее КАК Комплектующее,
		|	СУММА(Таблица.Количество) КАК Количество,
		|	Таблица.СтранаПроисхождения КАК СтранаПроисхождения
		|ПОМЕСТИТЬ ПрослеживаемыеОСИзменения
		|ИЗ
		|	(ВЫБРАТЬ
		|		Таблица.Период КАК Период,
		|		Таблица.ВидДвижения КАК ВидДвижения,
		|		Таблица.Организация КАК Организация,
		|		Таблица.ОсновноеСредство КАК ОсновноеСредство,
		|		Таблица.СтранаПроисхождения КАК СтранаПроисхождения,
		|		Таблица.РНПТ КАК РНПТ,
		|		Таблица.Комплектующее КАК Комплектующее,
		|		ВЫБОР
		|			КОГДА Таблица.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА Таблица.Количество
		|			ИНАЧЕ -Таблица.Количество
		|		КОНЕЦ КАК Количество
		|	ИЗ
		|		ДвиженияПрослеживаемыеОСПередЗаписью КАК Таблица
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Таблица.Период,
		|		Таблица.ВидДвижения,
		|		Таблица.Организация,
		|		Таблица.ОсновноеСредство,
		|		Таблица.СтранаПроисхождения,
		|		Таблица.РНПТ,
		|		Таблица.Комплектующее,
		|		ВЫБОР
		|			КОГДА Таблица.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА -Таблица.Количество
		|			ИНАЧЕ Таблица.Количество
		|		КОНЕЦ
		|	ИЗ
		|		РегистрНакопления.ПрослеживаемыеОС КАК Таблица
		|	ГДЕ
		|		Таблица.Регистратор = &Регистратор) КАК Таблица
		|
		|СГРУППИРОВАТЬ ПО
		|	Таблица.Организация,
		|	Таблица.ОсновноеСредство,
		|	Таблица.РНПТ,
		|	Таблица.Комплектующее,
		|	Таблица.Период,
		|	Таблица.СтранаПроисхождения
		|
		|ИМЕЮЩИЕ
		|	СУММА(Таблица.Количество) <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ДвиженияПрослеживаемыеОСПередЗаписью");
		
		Запрос.МенеджерВременныхТаблиц = ДополнительныеСвойства.МенеджерТаблицИзмененияРегистров;
		Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
		
		Результат = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
		
		ДополнительныеСвойства.КонтрольИзмененийПриЗаписи = Результат[0].Выбрать().Следующий();
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли