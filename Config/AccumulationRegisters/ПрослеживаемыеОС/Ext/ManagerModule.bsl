
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Формирует тексты запросов для контроля изменений записанных движений регистров.
//
// Параметры:
//  ТекстыЗапроса - СписокЗначений - список текстов запросов и их имен.
//
Процедура ИнициализироватьДанныеКонтроляИзменений(ТекстыЗапроса) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПрослеживаемыеОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	ПрослеживаемыеОСОстатки.Организация КАК Организация,
	|	ПрослеживаемыеОСОстатки.Комплектующее КАК Комплектующее,
	|	ПрослеживаемыеОСОстатки.РНПТ КАК РНПТ,
	|	ПрослеживаемыеОСОстатки.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеОСОстатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Остатки(
	|			&МоментВремени,
	|			(Организация, ОсновноеСредство, Комплектующее, РНПТ, СтранаПроисхождения) В
	|				(ВЫБРАТЬ
	|					ПрослеживаемыеОСИзменения.Организация,
	|					ПрослеживаемыеОСИзменения.ОсновноеСредство,
	|					ПрослеживаемыеОСИзменения.Комплектующее,
	|					ПрослеживаемыеОСИзменения.РНПТ,
	|					ПрослеживаемыеОСИзменения.СтранаПроисхождения
	|				ИЗ
	|					ПрослеживаемыеОСИзменения КАК ПрослеживаемыеОСИзменения)) КАК ПрослеживаемыеОСОстатки
	|ГДЕ
	|	ПрослеживаемыеОСОстатки.КоличествоОстаток < 0";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ПрослеживаемыеОС");
	
КонецПроцедуры

// Подготавливает сообщения пользователю при наличии ошибок контроля изменений записанных движений регистров.
//
// Параметры:
//  РезультатыКонтроля - Структура - таблицы с результатами контроля изменений
//  Ошибки - см. ДобавитьОшибкуПользователю.Ошибки
//
Процедура ПодготовитьСообщенияОРезультатахКонтроляИзменений(РезультатыКонтроля, Ошибки) Экспорт
	
	ШаблонСообщения = "ОС: %1, Комплектующее: %2, РНПТ: %3, Страна происхождения: %4 - не хватает количества %5";
	
	Для Каждого СтрокаОшибки Из РезультатыКонтроля Цикл
		
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
		СтрокаОшибки.ОсновноеСредство,
		СтрокаОшибки.Комплектующее,
		СокрЛП(СтрокаОшибки.РНПТ),
		СтрокаОшибки.СтранаПроисхождения,
		СтрокаОшибки.Количество);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,,ТекстСообщения,,,,);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
