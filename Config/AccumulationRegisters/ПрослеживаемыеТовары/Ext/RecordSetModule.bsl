#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если НЕ ЗначениеЗаполнено(Запись.Комплектующее) Тогда
			Запись.СуммаБезНДС = 0;
		КонецЕсли;
		Если Запись.КоличествоВложений > 0 И Запись.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
			Запись.КоличествоВложений =0;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "КонтрольОстатковПослеПроведения", Ложь) Тогда
		
		БлокироватьДляИзменения = Истина;
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = ДополнительныеСвойства.МенеджерТаблицИзмененияРегистров;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Таблица.Период КАК Период,
		|	Таблица.ВидДвижения КАК ВидДвижения,
		|	Таблица.Организация КАК Организация,
		|	Таблица.Номенклатура КАК Номенклатура,
		|	Таблица.СтранаПроисхождения КАК СтранаПроисхождения,
		|	Таблица.РНПТ КАК РНПТ,
		|	Таблица.ВариантКомплекта КАК ВариантКомплекта,
		|	Таблица.Комплектующее КАК Комплектующее,
		|	Таблица.Количество КАК Количество
		|ПОМЕСТИТЬ ДвиженияПрослеживаемыеТоварыПередЗаписью
		|ИЗ
		|	РегистрНакопления.ПрослеживаемыеТовары КАК Таблица
		|ГДЕ
		|	Таблица.Регистратор = &Регистратор";
		
		Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
		Запрос.Выполнить();

	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	ДополнительныеСвойства.Вставить("КонтрольИзмененийПриЗаписи", Ложь);
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийРегистратор = ЭтотОбъект.Отбор.Регистратор.Значение;
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЭтотОбъект.ДополнительныеСвойства, "ЗаписьСостава", Ложь) Тогда
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СоставыКомплектовМЗПТ.НаборЗаписей");
		ЭлементБлокировки.УстановитьЗначение("Регистратор", ТекущийРегистратор);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрослеживаемыеТовары.Организация КАК Организация,
		|	ПрослеживаемыеТовары.Номенклатура КАК Номенклатура,
		|	ПрослеживаемыеТовары.ВариантКомплекта КАК ВариантКомплекта,
		|	ПрослеживаемыеТовары.Комплектующее КАК Комплектующее,
		|	СУММА(ПрослеживаемыеТовары.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТ_НаборПрослеживаемыеТовары
		|ИЗ
		|	РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
		|ГДЕ
		|	ПрослеживаемыеТовары.Регистратор = &Регистратор
		|	И ПрослеживаемыеТовары.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И ПрослеживаемыеТовары.Комплектующее <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПрослеживаемыеТовары.Организация,
		|	ПрослеживаемыеТовары.Номенклатура,
		|	ПрослеживаемыеТовары.ВариантКомплекта,
		|	ПрослеживаемыеТовары.Комплектующее
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаТоваровРегистратора.Номенклатура КАК Номенклатура,
		|	ТаблицаТоваровРегистратора.ВариантКомплектаПТ КАК ВариантКомплектаПТ,
		|	СУММА(ТаблицаТоваровРегистратора.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТ_ТаблицаТоваров
		|ИЗ
		|	#ИмяТаблицы КАК ТаблицаТоваровРегистратора
		|ГДЕ
		|	ТаблицаТоваровРегистратора.Ссылка = &Регистратор
		|	И (ТаблицаТоваровРегистратора.Номенклатура, ТаблицаТоваровРегистратора.ВариантКомплектаПТ) В
		|			(ВЫБРАТЬ
		|				ВТ_НаборПрослеживаемыеТовары.Номенклатура,
		|				ВТ_НаборПрослеживаемыеТовары.ВариантКомплекта
		|			ИЗ
		|				ВТ_НаборПрослеживаемыеТовары)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаТоваровРегистратора.Номенклатура,
		|	ТаблицаТоваровРегистратора.ВариантКомплектаПТ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_НаборПрослеживаемыеТовары.Организация КАК Организация,
		|	ВТ_НаборПрослеживаемыеТовары.Номенклатура КАК Комплект,
		|	ВТ_НаборПрослеживаемыеТовары.ВариантКомплекта КАК ВариантКомплекта,
		|	ВТ_НаборПрослеживаемыеТовары.Комплектующее КАК Комплектующее,
		|	ВТ_НаборПрослеживаемыеТовары.Количество / ЕСТЬNULL(ВТ_ТаблицаТоваров.Количество, 1) КАК КоличествоВложений
		|ПОМЕСТИТЬ ВТ_ТекущийНабор
		|ИЗ
		|	ВТ_НаборПрослеживаемыеТовары КАК ВТ_НаборПрослеживаемыеТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаТоваров КАК ВТ_ТаблицаТоваров
		|		ПО ВТ_НаборПрослеживаемыеТовары.Номенклатура = ВТ_ТаблицаТоваров.Номенклатура
		|			И ВТ_НаборПрослеживаемыеТовары.ВариантКомплекта = ВТ_ТаблицаТоваров.ВариантКомплектаПТ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставыКомплектовМЗПТ.Организация КАК Организация,
		|	СоставыКомплектовМЗПТ.Комплект КАК Комплект,
		|	СоставыКомплектовМЗПТ.ВариантКомплекта КАК ВариантКомплекта,
		|	СоставыКомплектовМЗПТ.Комплектующее КАК Комплектующее,
		|	СоставыКомплектовМЗПТ.КоличествоВложений КАК КоличествоВложений
		|ПОМЕСТИТЬ ВТ_ПервичныйНабор
		|ИЗ
		|	РегистрСведений.СоставыКомплектовМЗПТ КАК СоставыКомплектовМЗПТ
		|ГДЕ
		|	СоставыКомплектовМЗПТ.Регистратор <> &Регистратор
		|	И (СоставыКомплектовМЗПТ.Организация, СоставыКомплектовМЗПТ.Комплект, СоставыКомплектовМЗПТ.ВариантКомплекта) В
		|			(ВЫБРАТЬ
		|				ВТ_НаборПрослеживаемыеТовары.Организация,
		|				ВТ_НаборПрослеживаемыеТовары.Номенклатура,
		|				ВТ_НаборПрослеживаемыеТовары.ВариантКомплекта
		|			ИЗ
		|				ВТ_НаборПрослеживаемыеТовары)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Организация КАК Организация,
		|	ВложенныйЗапрос.Комплект КАК Комплект,
		|	ВложенныйЗапрос.Комплектующее КАК Комплектующее,
		|	ВложенныйЗапрос.ВариантКомплекта КАК ВариантКомплекта,
		|	СУММА(ВложенныйЗапрос.КоличествоВложений) КАК КоличествоВложений
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ_ПервичныйНабор.Организация КАК Организация,
		|		ВТ_ПервичныйНабор.Комплект КАК Комплект,
		|		ВТ_ПервичныйНабор.ВариантКомплекта КАК ВариантКомплекта,
		|		ВТ_ПервичныйНабор.Комплектующее КАК Комплектующее,
		|		-ВТ_ПервичныйНабор.КоличествоВложений КАК КоличествоВложений
		|	ИЗ
		|		ВТ_ПервичныйНабор КАК ВТ_ПервичныйНабор
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ВТ_Набор.Организация,
		|		ВТ_Набор.Комплект,
		|		ВТ_Набор.ВариантКомплекта,
		|		ВТ_Набор.Комплектующее,
		|		ВТ_Набор.КоличествоВложений
		|	ИЗ
		|		ВТ_ТекущийНабор КАК ВТ_Набор) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Комплектующее,
		|	ВложенныйЗапрос.ВариантКомплекта,
		|	ВложенныйЗапрос.Организация,
		|	ВложенныйЗапрос.Комплект
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВложенныйЗапрос.КоличествоВложений) <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрослеживаемыеТовары.Регистратор КАК Регистратор,
		|	ПрослеживаемыеТовары.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТекущийНабор КАК ВТ_ТекущийНабор
		|		ПО ПрослеживаемыеТовары.Организация = ВТ_ТекущийНабор.Организация
		|			И ПрослеживаемыеТовары.Номенклатура = ВТ_ТекущийНабор.Комплект
		|			И ПрослеживаемыеТовары.ВариантКомплекта = ВТ_ТекущийНабор.ВариантКомплекта
		|			И ПрослеживаемыеТовары.Комплектующее = ВТ_ТекущийНабор.Комплектующее
		|ГДЕ
		|	(ПрослеживаемыеТовары.Номенклатура, ПрослеживаемыеТовары.ВариантКомплекта, ПрослеживаемыеТовары.Организация) В
		|			(ВЫБРАТЬ
		|				ВТ_НаборПрослеживаемыеТовары.Номенклатура,
		|				ВТ_НаборПрослеживаемыеТовары.ВариантКомплекта,
		|				ВТ_НаборПрослеживаемыеТовары.Организация
		|			ИЗ
		|				ВТ_НаборПрослеживаемыеТовары)
		|	И ПрослеживаемыеТовары.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И ПрослеживаемыеТовары.ВариантКомплекта <> ЗНАЧЕНИЕ(Справочник.ВариантыКомплектовМЗПТ.ПустаяСсылка)
		|	И ТИПЗНАЧЕНИЯ(&Регистратор) В (ТИП(Документ.ПоступлениеМЗ), ТИП(Документ.ВыпускПродукцииСоСчета106))
		|	И ПрослеживаемыеТовары.КоличествоВложений <> ЕСТЬNULL(ВТ_ТекущийНабор.КоличествоВложений, 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПрослеживаемыеТовары.Регистратор,
		|	ПрослеживаемыеТовары.Номенклатура,
		|	ПрослеживаемыеТовары.Организация");
		
		Если ТипЗнч(ТекущийРегистратор) = Тип("ДокументСсылка.ВыпускПродукцииСоСчета106") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ИмяТаблицы", "Документ.ВыпускПродукцииСоСчета106.Продукция");
		ИначеЕсли ТипЗнч(ТекущийРегистратор) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ИмяТаблицы", "Документ.ПоступлениеМЗ.Материалы");
		КонецЕсли;
		Запрос.УстановитьПараметр("Регистратор", ТекущийРегистратор);
		
		Результат = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
		ТаблицаДляЗаписи = Новый ТаблицаЗначений;
		
		Если Результат[3].Пустой() Тогда
			Если Результат[5].Пустой() Тогда
				ТаблицаДляЗаписи = Результат[2].Выгрузить();
			Иначе
				ВыборкаДокументов = Результат[5].Выбрать();
				Расхождения = Неопределено;
				Пока ВыборкаДокументов.Следующий() Цикл
					ТекстОшибки = СтрШаблон("Для номенклатуры %1 уже есть документ расхода с другим составом: %2", ВыборкаДокументов.Номенклатура, ВыборкаДокументов.Регистратор);
					ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Расхождения,,ТекстОшибки);
				КонецЦикла;
				ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Расхождения, Отказ);
			КонецЕсли;
		Иначе
			Если НЕ Результат[4].Пустой() Тогда
				ТекстОшибки = НСтр("ru='Несоответствие составу комплекта, текущий состав можно посмотреть в карточке варианта!'");
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ТекущийРегистратор, , , Отказ);
			КонецЕсли;
		КонецЕсли;
		
		НаборСостава = РегистрыСведений.СоставыКомплектовМЗПТ.СоздатьНаборЗаписей();
		НаборСостава.Отбор.Регистратор.Установить(ТекущийРегистратор);
		НаборСостава.Загрузить(ТаблицаДляЗаписи);
		НаборСостава.Записать();
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "КонтрольОстатковПослеПроведения", Ложь) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Таблица.Период КАК Период,
		|	Таблица.Организация КАК Организация,
		|	Таблица.Номенклатура КАК Номенклатура,
		|	Таблица.РНПТ КАК РНПТ,
		|	Таблица.ВариантКомплекта КАК ВариантКомплекта,
		|	Таблица.Комплектующее КАК Комплектующее,
		|	СУММА(Таблица.Количество) КАК Количество,
		|	Таблица.СтранаПроисхождения КАК СтранаПроисхождения
		|ПОМЕСТИТЬ ПрослеживаемыеТоварыИзменения
		|ИЗ
		|	(ВЫБРАТЬ
		|		Таблица.Период КАК Период,
		|		Таблица.ВидДвижения КАК ВидДвижения,
		|		Таблица.Организация КАК Организация,
		|		Таблица.Номенклатура КАК Номенклатура,
		|		Таблица.СтранаПроисхождения КАК СтранаПроисхождения,
		|		Таблица.РНПТ КАК РНПТ,
		|		Таблица.ВариантКомплекта КАК ВариантКомплекта,
		|		Таблица.Комплектующее КАК Комплектующее,
		|		ВЫБОР
		|			КОГДА Таблица.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА Таблица.Количество
		|			ИНАЧЕ -Таблица.Количество
		|		КОНЕЦ КАК Количество
		|	ИЗ
		|		ДвиженияПрослеживаемыеТоварыПередЗаписью КАК Таблица
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Таблица.Период,
		|		Таблица.ВидДвижения,
		|		Таблица.Организация,
		|		Таблица.Номенклатура,
		|		Таблица.СтранаПроисхождения,
		|		Таблица.РНПТ,
		|		Таблица.ВариантКомплекта,
		|		Таблица.Комплектующее,
		|		ВЫБОР
		|			КОГДА Таблица.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА -Таблица.Количество
		|			ИНАЧЕ Таблица.Количество
		|		КОНЕЦ
		|	ИЗ
		|		РегистрНакопления.ПрослеживаемыеТовары КАК Таблица
		|	ГДЕ
		|		Таблица.Регистратор = &Регистратор) КАК Таблица
		|
		|СГРУППИРОВАТЬ ПО
		|	Таблица.Организация,
		|	Таблица.Номенклатура,
		|	Таблица.РНПТ,
		|	Таблица.ВариантКомплекта,
		|	Таблица.Комплектующее,
		|	Таблица.Период,
