#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

// Формирует обороты по регистру накопления "ОборотыРасчетовСУчредителями" при записи движений
// по регистру бухгалтерии.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ-ссылка, формирующий движения по регистру бухгалтерии
//  НаборЗаписейБУ - РегистрНакопленияНаборЗаписей.ЖурналПроводокЕПСБУ - набор записей регистра бухгалтерии, который записывается документом
Процедура СформироватьОборотыОЦИ(ДокументСсылка, НаборЗаписейБУ) Экспорт
	
	Если НЕ ДокументСсылка.Метаданные().Движения.Содержит(Метаданные.РегистрыНакопления.ОборотыРасчетовСУчредителями) Тогда
		Возврат;
	КонецЕсли;	
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация, Дата");
	Организация   = ДанныеДокумента.Организация;
	ДатаПроведения = ДанныеДокумента.Дата;
	Если ТипЗнч(НаборЗаписейБУ) = Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ") И НаборЗаписейБУ.Количество() > 0 Тогда
		ДатаПроведения = НаборЗаписейБУ[0].Период;
	КонецЕсли;	

	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетнаяПолитика.Организация КАК Организация,
	|	УчетнаяПолитика.РасчетыСУчредителемКорректироватьОборотами КАК РасчетыСУчредителемКорректироватьОборотами,
	|	УчетнаяПолитика.СтруктураРПС.ТипПланаСчетов КАК ТипРПС
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&ДатаУП, Организация = &Организация) КАК УчетнаяПолитика";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаУП", ДатаПроведения);
	
	ТипРПС = Неопределено;
	РасчетыСУчредителемКорректироватьОборотами = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	Если Выборка.Следующий() Тогда
		ТипРПС = Выборка.ТипРПС;
		РасчетыСУчредителемКорректироватьОборотами = Выборка.РасчетыСУчредителемКорректироватьОборотами;
	КонецЕсли;	                      
	
	Если РасчетыСУчредителемКорректироватьОборотами = Неопределено ИЛИ НЕ РасчетыСУчредителемКорректироватьОборотами Тогда
		// Если в учетной политике не установлена опция корректировки расчетов с учредителем оборотами, то 
		// обороты ОЦИ, изменяющие расчеты с учредителем, не формируем
		Возврат;
	КонецЕсли;	
	
	РПС_БУ = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляБюджетных");
	РПС_АУ = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляАвтономных");

	РПС_БУиАУ = Новый Массив;
	РПС_БУиАУ.Добавить(РПС_БУ);
	РПС_БУиАУ.Добавить(РПС_АУ);
	Если ТипРПС = Неопределено ИЛИ РПС_БУиАУ.Найти(ТипРПС) = Неопределено Тогда
		// Движения формируем только для бюджетных или автономных учреждений
		Возврат;
	КонецЕсли;	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Проводки.Организация КАК Организация,
	|	Проводки.Период КАК Период,
	|	Проводки.ИФО КАК ИФО,
	|	Проводки.КФО КАК КФО,
	|	Проводки.СчетДт КАК СчетДт,
	|	Проводки.СчетКт КАК СчетКт,
	|	ВЫБОР
	|		КОГДА Проводки.СубконтоДт1 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА Проводки.ПодразделениеДт
	|		КОГДА Проводки.СубконтоКт1 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА Проводки.ПодразделениеКт
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Подразделение,
	|	ВЫБОР
	|		КОГДА Проводки.СубконтоДт1 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА Проводки.СубконтоДт1
	|		КОГДА Проводки.СубконтоКт1 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА Проводки.СубконтоКт1
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ОсновноеСредство,
	|	Проводки.Сумма КАК Сумма
	|ПОМЕСТИТЬ Проводки
	|ИЗ
	|	&Проводки КАК Проводки
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ ВТ_Изменения
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&ДатаПроведения,
	|			Организация = &Организация
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						Таб.ОсновноеСредство
	|					ИЗ
	|						Проводки КАК Таб)) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия < &ДатаИзменения
	|
	|СГРУППИРОВАТЬ ПО
	|	СобытияОССрезПоследних.ОсновноеСредство
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Проводки.Организация КАК Организация,
	|	Проводки.Период КАК Период,
	|	Проводки.ИФО КАК ИФО,
	|	Проводки.КФО КАК КФО,
	|	Проводки.Подразделение КАК Подразделение,
	|	СУММА(ВЫБОР
	|			КОГДА Проводки.КФО = &КФО4
	|					И Проводки.СчетДт В (&Счета4)
	|					И НЕ Проводки.СчетКт В (&Счета4)
	|				ТОГДА Проводки.Сумма
	|			КОГДА &ТипРПС = &РПС_БУ
	|					И Проводки.КФО = &КФО2
	|					И Проводки.СчетДт В (&Счета2)
	|					И НЕ Проводки.СчетКт В (&Счета2)
	|				ТОГДА Проводки.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СтоимостьУвеличение,
	|	СУММА(ВЫБОР
	|			КОГДА Проводки.КФО = &КФО4
	|					И Проводки.СчетДт В (&СчетаАм4)
	|					И НЕ Проводки.СчетКт В (&СчетаАм4)
	|				ТОГДА Проводки.Сумма
	|			КОГДА &ТипРПС = &РПС_БУ
	|					И Проводки.КФО = &КФО2
	|					И Проводки.СчетДт В (&СчетаАм2)
	|					И НЕ Проводки.СчетКт В (&СчетаАм2)
	|				ТОГДА Проводки.Сумма
	|			КОГДА НЕ ВТ_Изменения.ОсновноеСредство ЕСТЬ NULL
	|					И Проводки.КФО В (&КФОИзменения)
	|					И Проводки.СчетДт В (&СчетаАмИзменения)
	|					И НЕ Проводки.СчетКт В (&СчетаАмИзменения)
	|				ТОГДА Проводки.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК АмортизацияУменьшение,
	|	СУММА(ВЫБОР
	|			КОГДА Проводки.КФО = &КФО4
	|					И Проводки.СчетКт В (&Счета4)
	|					И НЕ Проводки.СчетДт В (&Счета4)
	|				ТОГДА Проводки.Сумма
	|			КОГДА &ТипРПС = &РПС_БУ
	|					И Проводки.КФО = &КФО2
	|					И Проводки.СчетКт В (&Счета2)
	|					И НЕ Проводки.СчетДт В (&Счета2)
	|				ТОГДА Проводки.Сумма
	|			КОГДА НЕ ВТ_Изменения.ОсновноеСредство ЕСТЬ NULL
	|					И Проводки.КФО В (&КФОИзменения)
	|					И Проводки.СчетКт В (&СчетаИзменения)
	|					И НЕ Проводки.СчетДт В (&СчетаИзменения)
	|				ТОГДА Проводки.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СтоимостьУменьшение,
	|	СУММА(ВЫБОР
	|			КОГДА Проводки.КФО = &КФО4
	|					И Проводки.СчетКт В (&СчетаАм4)
	|					И НЕ Проводки.СчетДт В (&СчетаАм4)
	|				ТОГДА Проводки.Сумма
	|			КОГДА &ТипРПС = &РПС_БУ
	|					И Проводки.КФО = &КФО2
	|					И Проводки.СчетКт В (&СчетаАм2)
	|					И НЕ Проводки.СчетДт В (&СчетаАм2)
	|				ТОГДА Проводки.Сумма
	|			КОГДА НЕ ВТ_Изменения.ОсновноеСредство ЕСТЬ NULL
	|					И Проводки.КФО В (&КФОИзменения)
	|					И Проводки.СчетКт В (&СчетаАмИзменения)
	|					И НЕ Проводки.СчетДт В (&СчетаАмИзменения)
	|				ТОГДА Проводки.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК АмортизацияУвеличение
	|ИЗ
	|	Проводки КАК Проводки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Изменения КАК ВТ_Изменения
	|		ПО (ВТ_Изменения.ОсновноеСредство = Проводки.ОсновноеСредство)
	|
	|СГРУППИРОВАТЬ ПО
	|	Проводки.Организация,
	|	Проводки.Период,
	|	Проводки.ИФО,
	|	Проводки.КФО,
	|	Проводки.Подразделение
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ВЫБОР
	|				КОГДА Проводки.КФО = &КФО4
	|						И Проводки.СчетДт В (&Счета4)
	|						И НЕ Проводки.СчетКт В (&Счета4)
	|					ТОГДА Проводки.Сумма
	|				КОГДА &ТипРПС = &РПС_БУ
	|						И Проводки.КФО = &КФО2
	|						И Проводки.СчетДт В (&Счета2)
	|						И НЕ Проводки.СчетКт В (&Счета2)
	|					ТОГДА Проводки.Сумма
	|				ИНАЧЕ 0
	|			КОНЕЦ) <> 0
	|		ИЛИ СУММА(ВЫБОР
	|				КОГДА Проводки.КФО = &КФО4
	|						И Проводки.СчетДт В (&СчетаАм4)
	|						И НЕ Проводки.СчетКт В (&СчетаАм4)
	|					ТОГДА Проводки.Сумма
	|				КОГДА &ТипРПС = &РПС_БУ
	|						И Проводки.КФО = &КФО2
	|						И Проводки.СчетДт В (&СчетаАм2)
	|						И НЕ Проводки.СчетКт В (&СчетаАм2)
	|					ТОГДА Проводки.Сумма
	|				КОГДА НЕ ВТ_Изменения.ОсновноеСредство ЕСТЬ NULL
	|						И Проводки.КФО В (&КФОИзменения)
	|						И Проводки.СчетДт В (&СчетаАмИзменения)
	|						И НЕ Проводки.СчетКт В (&СчетаАмИзменения)
	|					ТОГДА Проводки.Сумма
	|				ИНАЧЕ 0
	|			КОНЕЦ) <> 0
	|		ИЛИ СУММА(ВЫБОР
	|				КОГДА Проводки.КФО = &КФО4
	|						И Проводки.СчетКт В (&Счета4)
	|						И НЕ Проводки.СчетДт В (&Счета4)
	|					ТОГДА Проводки.Сумма
	|				КОГДА &ТипРПС = &РПС_БУ
	|						И Проводки.КФО = &КФО2
	|						И Проводки.СчетКт В (&Счета2)
	|						И НЕ Проводки.СчетДт В (&Счета2)
	|					ТОГДА Проводки.Сумма
	|				КОГДА НЕ ВТ_Изменения.ОсновноеСредство ЕСТЬ NULL
	|						И Проводки.КФО В (&КФОИзменения)
	|						И Проводки.СчетКт В (&СчетаИзменения)
	|						И НЕ Проводки.СчетДт В (&СчетаИзменения)
	|					ТОГДА Проводки.Сумма
	|				ИНАЧЕ 0
	|			КОНЕЦ) <> 0
	|		ИЛИ СУММА(ВЫБОР
	|				КОГДА Проводки.КФО = &КФО4
	|						И Проводки.СчетКт В (&СчетаАм4)
	|						И НЕ Проводки.СчетДт В (&СчетаАм4)
	|					ТОГДА Проводки.Сумма
	|				КОГДА &ТипРПС = &РПС_БУ
	|						И Проводки.КФО = &КФО2
	|						И Проводки.СчетКт В (&СчетаАм2)
	|						И НЕ Проводки.СчетДт В (&СчетаАм2)
	|					ТОГДА Проводки.Сумма
	|				КОГДА НЕ ВТ_Изменения.ОсновноеСредство ЕСТЬ NULL
	|						И Проводки.КФО В (&КФОИзменения)
	|						И Проводки.СчетКт В (&СчетаАмИзменения)
	|						И НЕ Проводки.СчетДт В (&СчетаАмИзменения)
	|					ТОГДА Проводки.Сумма
	|				ИНАЧЕ 0
	|			КОНЕЦ) <> 0)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Проводки", НаборЗаписейБУ.Выгрузить());
	
	КФО4 = ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаГосзадание");
	КФО2 = ПредопределенноеЗначение("Перечисление.КВД.Внебюджет");
	КФО7 = ПредопределенноеЗначение("Перечисление.КВД.СредстваОМС");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаПроведения", ДатаПроведения);
	Запрос.УстановитьПараметр("ТипРПС", ТипРПС);
	Запрос.УстановитьПараметр("РПС_БУ", РПС_БУ);
	Запрос.УстановитьПараметр("КФО4", ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаГосзадание"));
	Запрос.УстановитьПараметр("КФО2", ПредопределенноеЗначение("Перечисление.КВД.Внебюджет"));
	Запрос.УстановитьПараметр("Счета2", БухгалтерскийУчет.СписокСчетов("101.10,103.11"));
	Запрос.УстановитьПараметр("Счета4", БухгалтерскийУчет.СписокСчетов("101.10,101.20,102.20,103.11"));
	Запрос.УстановитьПараметр("СчетаАм2", БухгалтерскийУчет.СписокСчетов("104.10"));
	Запрос.УстановитьПараметр("СчетаАм4", БухгалтерскийУчет.СписокСчетов("104.10,104.20,104.29"));
	
	ДанныеУП = РегистрыСведений.УчетнаяПолитикаОрганизаций.ПолучитьДатуИзмененияТипаУчреждения(Организация, ДатаПроведения);
	Запрос.УстановитьПараметр("ДатаИзменения", ДанныеУП.ДатаИзменения);
	
	СчетИзменения	= ?(ТипРПС = РПС_БУ, "", "101.10,") + "101.20,102.20";
	СчетАмИзменения	= ?(ТипРПС = РПС_БУ, "", "104.10,") + "104.20,104.29";
	
	Запрос.УстановитьПараметр("СчетаИзменения", БухгалтерскийУчетПовтИсп.СписокСчетов(СчетИзменения));
	Запрос.УстановитьПараметр("СчетаАмИзменения", БухгалтерскийУчетПовтИсп.СписокСчетов(СчетАмИзменения));

	КФОИзменения = Новый Массив;
	КФОИзменения.Добавить(КФО2);
	КФОИзменения.Добавить(КФО7);
	Запрос.УстановитьПараметр("КФОИзменения", КФОИзменения);
	
	ТабЗаписей = Запрос.Выполнить().Выгрузить();
	
	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ДокументСсылка);  
	НаборЗаписей.Записывать = Истина;
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() > 0 Тогда
		НаборЗаписей.Очистить();
	КонецЕсли;	
	НаборЗаписей.Загрузить(ТабЗаписей);  
	
	Если НаборЗаписей.Количество() <> 0 Тогда
		НаборЗаписей.Записать(Истина);
	КонецЕсли;	
	
КонецПроцедуры		

#КонецОбласти

#КонецЕсли
