#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ОтключитьПроверку") Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьДетализациюПоКОСГУ = ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками");
	ИспользоватьДополнительнуюАналитику = ПолучитьФункциональнуюОпцию("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками");
	Если Не ИспользоватьДетализациюПоКОСГУ ИЛИ Не ИспользоватьДополнительнуюАналитику Тогда
		
		Для Каждого Запись Из ЭтотОбъект Цикл
			
			Если Не ИспользоватьДетализациюПоКОСГУ Тогда
				Запись.КЭК = Справочники.КОСГУ.ПустаяСсылка();
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Запись.СчетРасчетов, "304.01") Тогда
				Запись.КЭК = БухгалтерскийУчетПовтИсп.КЭК0(); // По средствам во временном распоряжении используется КЭК 000.
			КонецЕсли;
			
			Если Не ИспользоватьДополнительнуюАналитику Тогда
				Запись.ДопКлассификация = Справочники.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка();
				Запись.КодМероприятия   = Справочники.Мероприятия.ПустаяСсылка();
				Запись.КодЦели          = Справочники.ВидыЦелевыхСредств.ПустаяСсылка();
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	КонтрольИсполненияДоговоров.ЗаполнитьДатуИзмененияГрафиков(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли