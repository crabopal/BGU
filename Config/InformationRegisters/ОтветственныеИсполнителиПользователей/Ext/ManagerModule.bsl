// Ответственный.
// 
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//  Организация - СправочникСсылка.Организации, Неопределено - Организация
//  Период - Дата
// 
// Возвращаемое значение:
//  СправочникСсылка.Сотрудники - Ответственный
Функция Ответственный(Пользователь, Организация = Неопределено, Период = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОтветственныйИсполнитель.Организация,
	|	ОтветственныйИсполнитель.Сотрудник
	|ИЗ
	|	РегистрСведений.ОтветственныеИсполнителиПользователей.СрезПоследних(&Период, Пользователь = &Пользователь) КАК
	|		ОтветственныйИсполнитель
	|ГДЕ
	|	ОтветственныйИсполнитель.Организация = &Организация
	|	ИЛИ ОтветственныйИсполнитель.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА ОтветственныйИсполнитель.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ";
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	Если Пользователь = Пользователи.АвторизованныйПользователь() Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сотрудник;
	КонецЕсли;
	
	Возврат Справочники.Сотрудники.ПустаяСсылка();
КонецФункции

