#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ДобавитьЗаписьЕслиНеСуществует(ПоступлениеНФА, АктПриемкиТРУ) Экспорт
	
	Если ЗначениеЗаполнено(АктПриемкиТРУ)
			И Не Документы.АктПриемкиТоваровРаботУслуг.НайтиПоДокументуПоступления(ПоступлениеНФА).Добавлен Тогда
		ДобавитьЗапись(ПоступлениеНФА, АктПриемкиТРУ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЗапись(ПоступлениеНФА, АктПриемкиТРУ) Экспорт
	
	Если ЗначениеЗаполнено(ПоступлениеНФА) И ЗначениеЗаполнено(АктПриемкиТРУ) Тогда
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ");
			ЭлементБлокировки.УстановитьЗначение("ПоступлениеНФА", ПоступлениеНФА);
			Блокировка.Заблокировать();

			МенеджерЗаписи = СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ПоступлениеНФА = ПоступлениеНФА;
			МенеджерЗаписи.АктПриемкиТРУ = АктПриемкиТРУ;
			МенеджерЗаписи.Прочитать();
			Если Не МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.ПоступлениеНФА = ПоступлениеНФА;
				МенеджерЗаписи.АктПриемкиТРУ = АктПриемкиТРУ;
				МенеджерЗаписи.Записать(Ложь);
			КонецЕсли;
		Исключение
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьЗапись(ПоступлениеНФА) Экспорт
	
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ");
		ЭлементБлокировки.УстановитьЗначение("ПоступлениеНФА", ПоступлениеНФА);
		Блокировка.Заблокировать();
		
		УстановитьОтключениеБезопасногоРежима(Истина);
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПоступлениеНФА.Установить(ПоступлениеНФА);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0 Тогда
			НаборЗаписей.Записать(РежимЗамещения.Удаление);
		КонецЕсли;
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция ВсеДокументыПоставкиДобавленыВАкт(АктПриемкиТРУ, Знач ДобавленныеНоНеЗаписанные = Неопределено) Экспорт
	Если ДобавленныеНоНеЗаписанные = Неопределено Тогда
		ДобавленныеНоНеЗаписанные = Новый Массив;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	РегистрСведений.НезарегистрированныеПоступленияНФАПоАктамПриемкиТРУ КАК ДанныеРегистра
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктПриемкиТоваровРаботУслуг.ДокументыПоступления КАК ДокументПриемки
	|		ПО ДанныеРегистра.ПоступлениеНФА = ДокументПриемки.ДокументОснование
	|		И ДокументПриемки.Ссылка = &АктПриемкиТРУ
	|ГДЕ
	|	ДанныеРегистра.АктПриемкиТРУ = &АктПриемкиТРУ
	|	И ДокументПриемки.ДокументОснование ЕСТЬ NULL
	|	И ДанныеРегистра.ПоступлениеНФА НЕ В (&ДобавленныеНоНеЗаписанные)";
	Запрос.УстановитьПараметр("АктПриемкиТРУ", АктПриемкиТРУ);
	Запрос.УстановитьПараметр("ДобавленныеНоНеЗаписанные", ДобавленныеНоНеЗаписанные);
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Возврат Запрос.Выполнить().Пустой();
КонецФункции

#КонецОбласти

#КонецЕсли