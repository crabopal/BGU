&НаКлиенте
Перем ЭтоНоваяСтрока;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.ДатаАктуальности = ТекущаяДатаСеанса();
	ЗаполнитьСчетаУчетаМЗ105(ЭтаФорма);
	
	Если Параметры.Ключ.Пустой() Тогда
		Запись.Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	КонецЕсли;
	
	ИнициализироватьНастройкиСписанияМЗДляРедактированияНаФорме(ЭтаФорма, Запись.Организация, Запись.ОсновноеСредство);
	
	ПодготовитьФормуНаСервере();

	УстановитьДанныеДинамическихКолонокТаблицыМатериалы(ЭтаФорма, Запись, "НастройкиУчетаГСМДляОС");
	
	УстановитьУсловноеОформлениеСпискаМатериалов(ЭтаФорма, "НастройкиУчетаГСМДляОС");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Запись.НаименованиеНастройки = СокрЛП(Запись.ОсновноеСредство);
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	//Настройки списания
	Набор = РегистрыСведений.НастройкиУчетаГСМДляОС.СоздатьНаборЗаписей(); 
	Набор.Отбор.Организация.Установить(Запись.Организация); 
	Набор.Отбор.ОсновноеСредство.Установить(Запись.ОсновноеСредство); 
	Для Каждого СтрокаТаблицы Из ЭтаФорма["НастройкиУчетаГСМДляОС"] Цикл 
	 	ЗаписьНастроекСписания = Набор.Добавить(); 
	 	ЗаписьНастроекСписания.Организация = Запись.Организация; 
	 	ЗаписьНастроекСписания.ОсновноеСредство = Запись.ОсновноеСредство; 
	 	ЗаписьНастроекСписания.ВидГСМ = СтрокаТаблицы.ВидГСМ;
	 	ЗаписьНастроекСписания.Номенклатура = СтрокаТаблицы.Номенклатура;
	 	ЗаписьНастроекСписания.ЦМО = СтрокаТаблицы.ЦМО;
	 	ЗаписьНастроекСписания.ИФО = СтрокаТаблицы.ИФО;
	 	ЗаписьНастроекСписания.Подразделение = СтрокаТаблицы.Подразделение;
	 	ЗаписьНастроекСписания.КФО = СтрокаТаблицы.КФО;
	 	ЗаписьНастроекСписания.СчетУчета = СтрокаТаблицы.СчетУчета;
	 	ЗаписьНастроекСписания.ДополнительнаяАналитикаСчета = СтрокаТаблицы.ДополнительнаяАналитикаСчета;
	 	ЗаписьНастроекСписания.КПС = СтрокаТаблицы.КПС;
	 	ЗаписьНастроекСписания.СчетДт = СтрокаТаблицы.СчетДт;
	 	ЗаписьНастроекСписания.СубконтоДт1 = СтрокаТаблицы.СубконтоДт1;
	 	ЗаписьНастроекСписания.СубконтоДт2 = СтрокаТаблицы.СубконтоДт2;
	 	ЗаписьНастроекСписания.СубконтоДт3 = СтрокаТаблицы.СубконтоДт3;
	 	ЗаписьНастроекСписания.СчетНУ = СтрокаТаблицы.СчетНУ;
	 	ЗаписьНастроекСписания.СубконтоНУ1 = СтрокаТаблицы.СубконтоНУ1;
	 	ЗаписьНастроекСписания.СубконтоНУ2 = СтрокаТаблицы.СубконтоНУ2;
	 	ЗаписьНастроекСписания.СубконтоНУ3 = СтрокаТаблицы.СубконтоНУ3;
	 	ЗаписьНастроекСписания.ПричинаСписания = СтрокаТаблицы.ПричинаСписания;
	 	ЗаписьНастроекСписания.Наименование = СтрокаТаблицы.Наименование;
	 	ЗаписьНастроекСписания.ПодразделениеДт = СтрокаТаблицы.ПодразделениеДт;
	 	ЗаписьНастроекСписания.КПСДт = СтрокаТаблицы.КПСДт;
	КонецЦикла; 
	Набор.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.НастройкаОтраженияВУчете" Тогда
		ОбработкаВыбораОтраженияВУчетеНаКлиенте(ВыбранноеЗначение);
	КонецЕсли;
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ИнициализироватьНастройкиСписанияМЗДляРедактированияНаФорме(ЭтаФорма, Запись.Организация, Запись.ОсновноеСредство);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиТаблицыФормыНастройкиУчетаГСМДляОС

&НаКлиенте
Процедура НастройкиУчетаГСМДляОСОтражениеВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуНастройкиОтраженияВУчете(Элементы.НастройкиУчетаГСМДляОС.ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчетаГСМДляОСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "НастройкиУчетаГСМДляОСОтражениеВУчете" Тогда
		ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчетаГСМДляОСПриАктивизацииЯчейки(Элемент)
	Если Элементы.НастройкиУчетаГСМДляОС.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.НастройкиУчетаГСМДляОС.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "НастройкиУчетаГСМДляОСОтражениеВУчете"
			И НЕ Элементы.НастройкиУчетаГСМДляОС.ТекущиеДанные.ОтражениеВУчетеЗаполнено Тогда
			ВыбраннаяСтрока = Элементы.НастройкиУчетаГСМДляОС.ТекущаяСтрока;
			ОткрытьФормуНастройкиОтраженияВУчете(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчетаГСМДляОСПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ЭтоНоваяСтрока = НоваяСтрока;
	СтрокаТаблицы = Элементы.НастройкиУчетаГСМДляОС.ТекущиеДанные;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(Запись, Элементы.НастройкиУчетаГСМДляОС.ТекущиеДанные);
		//ТекНомерСтроки = СтрокаТаблицы.НомерСтроки;
		ТекНомерСтроки = 1;
		Если ТекНомерСтроки >1 Тогда
			Элементы.НастройкиУчетаГСМДляОС.ТекущиеДанные.ПричинаСписания = ЭтаФорма.НастройкиУчетаГСМДляОС[ТекНомерСтроки-2].ПричинаСписания;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;

	СтрокаТаблицы.ОтражениеВУчете = "<...>";
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчетаГСМДляОСПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Если ОтменаРедактирования И НоваяСтрока Тогда
		// Закроем форму настройки отражения в учете, т.к. пользователь отменяет ввод
		Оповестить("ФормаНастройкаОтраженияВУчете_Закрыть", Неопределено, ЭтаФорма);
	КонецЕсли;

	ЭтоНоваяСтрока = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчетаГСМДляОСОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.НаправленияРасходаМПЗ") Тогда
		МассивСтрок = Элементы.НастройкиУчетаГСМДляОС.ВыделенныеСтроки;
		Для Каждого ЭлМас Из МассивСтрок Цикл
			ТекСтр = ЭтаФорма.НастройкиУчетаГСМДляОС.НайтиПоИдентификатору(ЭлМас);
			Если ТекСтр <> Неопределено Тогда
				ТекСтр.ПричинаСписания = ВыбранноеЗначение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчетаГСМДляОССчетУчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.НастройкиУчетаГСМДляОС.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			ТекущиеДанные.СчетУчета, 
																			ТекущиеДанные.КПС, 
																			ТекущиеДанные.КФО), 
															Запись.Организация,
															ТекущиеДанные.ИФО,
															ВсеСчета105,
															ТекущиеДанные.КФО,
															,
															ДатаАктуальности);
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчетаГСМДляОССчетУчетаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.НастройкиУчетаГСМДляОС.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															ТекущиеДанные.КПС,
															ТекущиеДанные.КФО,
															,);
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчетаГСМДляОССчетУчетаАвтоПодбор(Элемент, Текст, ДанныеВыбора, Параметры, Ожидание, СтандартнаяОбработка)
	ПараметрыАвтоПодбора = Новый Структура("СтрокаПоиска", Текст);
	ПараметрыАвтоПодбора.Вставить("Отбор", Новый Структура("ЭлементГруппа", Ложь));
	ПараметрыАвтоПодбора.Вставить("ОграниченияСписокСчетов", ВсеСчета105);
	ПараметрыАвтоПодбора.Вставить("ВидСравненияВСписке", Истина);
	
	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("ПланСчетовСсылка.ЕПСБУ"), ПараметрыАвтоПодбора);
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчетаГСМДляОССчетУчетаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры, СтандартнаяОбработка)
	УправлениеМатериальнымиЗапасамиКлиент.ОкончаниеВводаТекстаСчетаМатериалаВТаблицеДокумента(ЭтаФорма,, Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчетаГСМДляОССчетУчетаПриИзменении(Элемент)
	УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(Запись, Элементы.НастройкиУчетаГСМДляОС.ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьНастройкиСписанияМЗДляРедактированияНаФорме(Форма, Организация, ТранспортноеСредство)
	
	ТЗ = УчетГСМ.ДанныеНастроекОСДляСписанияГСМ(Организация, ТранспортноеСредство);
	Форма["НастройкиУчетаГСМДляОС"].Загрузить(ТЗ);
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСчетаУчетаМЗ105(Форма)
	СчетаУчета = БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("105.23,105.33");
	Форма.ВсеСчета105.ЗагрузитьЗначения(СчетаУчета);	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = НастройкиУчетаГСМДляОС.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Подразделение, ИФО,
		|КФО, КПС, КЭК, Количество");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Запись);
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.КПС = ДанныеСтроки.КПСДт;	
	
	ПараметрыФормы.Дата = ДатаАктуальности;
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО и КЭК изменять не нужно
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", 	Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотрКЭК", 	Истина);
	ПараметрыФормы.Вставить("ВидимостьКПС",      	Истина);
	ПараметрыФормы.Вставить("ВидимостьКЭК",      	Ложь);
	ПараметрыФормы.Вставить("ВидимостьКоличество",  Ложь);
	
	// Бухгалтерский учет
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетДт);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоДт1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоДт2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоДт3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Настройка отражения расходов в учете'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Счет дебета'"));
	
		// Налоговый учет
	ПараметрыФормы.Вставить("СчетНУ",      ДанныеСтроки.СчетНУ);
	ПараметрыФормы.Вставить("СубконтоНУ1", ДанныеСтроки.СубконтоНУ1);
	ПараметрыФормы.Вставить("СубконтоНУ2", ДанныеСтроки.СубконтоНУ2);
	ПараметрыФормы.Вставить("СубконтоНУ3", ДанныеСтроки.СубконтоНУ3);
	
	ЗаполнитьОграниченияСчетов(ПараметрыФормы);
		
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьОграниченияСчетов(СтруктураПараметров)
	
	ПараметрыСчета = Новый Структура("ОграниченияСписокСчетов",	БухгалтерскийУчетКлиентСервер.СписокСчетов("106.00,109.00,401.20", СтруктураПараметров.Дата));
	СтруктураПараметров.Вставить("ПараметрыСчета", ПараметрыСчета);

	ПараметрыСчетаНУ = Новый Структура("ОграниченияСписокСчетов", БухгалтерскийУчетКлиентСервер.СписокСчетов("Н08,Н15,Н20,Н25,Н26,Н44,Н91.02", СтруктураПараметров.Дата));
	СтруктураПараметров.Вставить("ПараметрыСчетаНУ", ПараметрыСчетаНУ);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаВыбораОтраженияВУчетеНаКлиенте(СтруктураОтражениеВУчете)

	ТекущиеДанные = Элементы.НастройкиУчетаГСМДляОС.ТекущиеДанные;
	КоличествоМатериалов = ТекущиеДанные.Количество;
	СтруктураОтражениеВУчете.Вставить("КПСДт", СтруктураОтражениеВУчете.КПС);
	СтруктураОтражениеВУчете.КПС = ТекущиеДанные.КПС;
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураОтражениеВУчете); // КФО, КПС, КЭК и пр.
	
	ТекущиеДанные.СчетДт      = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоДт1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоДт2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоДт3 = СтруктураОтражениеВУчете.Субконто3;
	
	ТекущиеДанные.СчетНУ          = СтруктураОтражениеВУчете.СчетНУ;
	ТекущиеДанные.СубконтоНУ1     = СтруктураОтражениеВУчете.СубконтоНУ1;
	ТекущиеДанные.СубконтоНУ2     = СтруктураОтражениеВУчете.СубконтоНУ2;
	ТекущиеДанные.СубконтоНУ3     = СтруктураОтражениеВУчете.СубконтоНУ3;
	
	ТекущиеДанные.Количество = КоличествоМатериалов;
	
	ПоляФормы = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
		"СчетДт", "СубконтоДт1", "СубконтоДт2", "СубконтоДт3");
	ПараметрыОбъекта = Новый Структура("ОтражатьВНалоговомУчете, ОтражатьВНалоговомУчетеУСН, ЕстьНДС",
		НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Запись.Организация, ДатаАктуальности, ТекущиеДанные.КФО),
		Ложь,
		Ложь);
	ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ТекущиеДанные, ПараметрыОбъекта, ПоляФормы);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеСпискаМатериалов(Форма, ИмяТаблицы = "Материалы") Экспорт
	ЦветТекста = Метаданные.ЭлементыСтиля.НедоступныеДанныеЦвет.Значение;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Использование    = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		ЦветТекста);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",				"<не используется>");
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);

	ЭлементУсловия                = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".ЕстьДополнительноеСубконто");
	ЭлементУсловия.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Ложь;
	ЭлементУсловия.Использование  = Истина;

	ОформляемоеПоле      = Элемент.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "ДополнительнаяАналитикаСчета");	
	ОформляемоеПоле.Использование = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()
	
	// Колонки ОтражениеВУчете
	ПоляФормы = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
		"СчетДт", "СубконтоДт1", "СубконтоДт2", "СубконтоДт3");
	Для Каждого СтрокаТаблицы Из ЭтаФорма.НастройкиУчетаГСМДляОС Цикл
		ПараметрыОбъекта = Новый Структура("ОтражатьВНалоговомУчете, ОтражатьВНалоговомУчетеУСН, ЕстьНДС",
			НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Запись.Организация, ЭтаФорма.ДатаАктуальности, СтрокаТаблицы.КФО),
			Ложь,
			Ложь);
		ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, ПараметрыОбъекта, ПоляФормы);

	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДанныеДинамическихКолонокТаблицыМатериалы(Форма, Объект, ИмяТаблицы = "Материалы", Включать106 = ЛОЖЬ) Экспорт

	ДанныеСчетов = УправлениеМатериальнымиЗапасамиКлиентСервер.ДанныеСчетовУчетаМЗ(Объект.Организация,,Включать106);
	СоответствиеСчетов = Новый Соответствие;
	
	Для каждого ТекСтр Из Форма[ИмяТаблицы] Цикл
	
		УстановитьДополнительноеСубконтоВСтроке(ТекСтр, ДанныеСчетов, СоответствиеСчетов);
	
	КонецЦикла; 	

КонецПроцедуры

&НаСервере
Процедура УстановитьДополнительноеСубконтоВСтроке(ТекущиеДанные, ДанныеСчетов, СоответствиеСчетов)
	
	ТекущийСчет = СоответствиеСчетов.Получить(ТекущиеДанные.СчетУчета);
	Если ТекущийСчет = Неопределено Тогда
		Для каждого Счет Из ДанныеСчетов Цикл
			Если Счет.ТекущийСчет = ТекущиеДанные.СчетУчета Тогда
				ТекущийСчет = Счет;
				Прервать;
			КонецЕсли;
		КонецЦикла; 
		Если ТекущийСчет <> Неопределено Тогда
			СоответствиеСчетов.Вставить(ТекущиеДанные.СчетУчета, ТекущийСчет);
		КонецЕсли;
	КонецЕсли;

	Если ТекущийСчет = Неопределено Тогда
		ТекущиеДанные.ЕстьДополнительноеСубконто = Ложь;
		ТекущиеДанные.УчетПоКПС = Ложь;
	Иначе
		ТекущиеДанные.ЕстьДополнительноеСубконто = ЗначениеЗаполнено(ТекущийСчет.ДополнительноеСубконто);
		ТекущиеДанные.УчетПоКПС = ТекущийСчет.УчетПоКПС;
		ТекущиеДанные.ДополнительнаяАналиткаВидСубконто = ТекущийСчет.ДополнительноеСубконто;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ТекущиеДанные, ПараметрыОбъекта, ПоляФормы)

	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(ТекущиеДанные, ПараметрыОбъекта, ПоляФормы);
	
	Если ТекущиеДанные.ОтражениеВУчетеЗаполнено Тогда
		ОтражениеВУчете = ТекущиеДанные.ОтражениеВУчете;
		ПозицияПервойЗапятой = СтрНайти(ОтражениеВУчете, ",");
		Если ПозицияПервойЗапятой > 0 Тогда
			Если ЗначениеЗаполнено(ТекущиеДанные.КПСДт) Тогда
				НовоеОтражениеВУчете = Сред(ОтражениеВУчете, 1, ПозицияПервойЗапятой) + " " + СокрЛП(ТекущиеДанные.КПСДт)+Сред(ОтражениеВУчете, ПозицияПервойЗапятой);
				ТекущиеДанные.ОтражениеВУчете = НовоеОтражениеВУчете;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры	

#КонецОбласти

ЭтоНоваяСтрока = Ложь;