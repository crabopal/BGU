
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    РегистрыСведений.РазвернутоеСальдо.ЗаполнитьРазвернутоеСальдо(РазвернутоеСальдо);
    
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    
    РегистрыСведений.РазвернутоеСальдо.СохранитьИзменения(ТекущийОбъект, РазвернутоеСальдо.ПолучитьЭлементы());
    
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРазвернутоеСальдо

&НаКлиенте
Процедура РазвернутоеСальдоПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    
    ТекущаяСтрока = ПодчиненныеЭлементы["РазвернутоеСальдо"].ТекущиеДанные;
    Если ТекущаяСтрока <> Неопределено Тогда
        ОткрытьФорму("ОбщаяФорма.ФормаНастройкаПоСубконто", Новый Структура("СписокВидовСубконто", ТекущаяСтрока.ПоСубконто.Скопировать()), Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура РазвернутоеСальдоПредставлениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
    
    ТекущаяСтрока = ПодчиненныеЭлементы["РазвернутоеСальдо"].ТекущиеДанные;

    СтандартнаяОбработка = Ложь;

    Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") Тогда
        ТекущаяСтрока.ПоСубконто    = ВыбранноеЗначение;
        ТекущаяСтрока.Представление = ПолучитьПредставление(Новый Структура("ПоСубконто,Счет", ВыбранноеЗначение, ТекущаяСтрока.Счет), ВыбранноеЗначение);
        
        Если
            ТекущаяСтрока.Представление = стрПоСубсчетам() ИЛИ
            ТекущаяСтрока.Представление = стрНеРазворачивать()
        Тогда
            Если ТекущаяСтрока.Использование = ПредопределенноеЗначение("Перечисление.ВидыРазвернутогоСальдо.Разворачивать") Тогда
                ТекущаяСтрока.Использование = ПредопределенноеЗначение("Перечисление.ВидыРазвернутогоСальдо.РазворачиватьПоСубсчетам");
            Иначе 
                ТекущаяСтрока.Использование = ПредопределенноеЗначение("Перечисление.ВидыРазвернутогоСальдо.НеРазворачивать");
            КонецЕсли;
        Иначе
            ТекущаяСтрока.Использование = ПредопределенноеЗначение("Перечисление.ВидыРазвернутогоСальдо.Разворачивать");
        КонецЕсли;
        
        УстановитьДляПодчиненных(ТекущаяСтрока, ВыбранноеЗначение);
        
        ЭтаФорма.Модифицированность = Истина;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура РазвернутоеСальдоПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

    Отказ = Истина;
    
    ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПолучитьПараметрыВыбораСчета(Новый Структура), Элемент,,,, Новый ОписаниеОповещения("ВыбралиСчет", ЭтотОбъект));
    
КонецПроцедуры

&НаКлиенте
Процедура РазвернутоеСальдоПослеУдаления(Элемент)
    
    ЭтаФорма.Модифицированность = Истина;
    
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВосстановитьСтандартныеНастройки(Команда)
    
    ВосстановитьСтандартныеНастройкиНаСервере();
    Для каждого Стр Из РазвернутоеСальдо.ПолучитьЭлементы() Цикл
        Элементы.РазвернутоеСальдо.Развернуть(Стр.ПолучитьИдентификатор(), Истина);
    КонецЦикла; 
    ЭтаФорма.Модифицированность = Истина;
    
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВосстановитьСтандартныеНастройкиНаСервере()
    
    РегистрыСведений.РазвернутоеСальдо.ЗаполнитьРегистрПоУмолчанию();
    РазвернутоеСальдо.ПолучитьЭлементы().Очистить();
    РегистрыСведений.РазвернутоеСальдо.ЗаполнитьРазвернутоеСальдо(РазвернутоеСальдо);
    
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДляПодчиненных(РодительскаяСтрока, ВыбранноеЗначение)
    
    Для каждого ТекСтрока Из РодительскаяСтрока.ПолучитьЭлементы() Цикл
        ТекСтрока.Представление = ПолучитьПредставление(Новый Структура("ПоСубконто,Счет", ВыбранноеЗначение, ТекСтрока.Счет), ВыбранноеЗначение);
        ТекСтрока.Использование = ПредопределенноеЗначение("Перечисление.ВидыРазвернутогоСальдо.Наследуется");
        Если ТекСтрока.Счет.ЭлементГруппа Тогда
            УстановитьДляПодчиненных(ТекСтрока, ВыбранноеЗначение);
        КонецЕсли;
    КонецЦикла; 
    
КонецПроцедуры

&НаКлиенте
Процедура РазвернутоеСальдоПредставлениеОчистка(Элемент, СтандартнаяОбработка)

    ТекущаяСтрока = Элементы.РазвернутоеСальдо.ТекущиеДанные;

    СтандартнаяОбработка = Ложь;

    Для Каждого СтрокаСписка Из ТекущаяСтрока.ПоСубконто Цикл
        СтрокаСписка.Пометка = Ложь;
    КонецЦикла;

    ТекущаяСтрока.Использование = ПредопределенноеЗначение("Перечисление.ВидыРазвернутогоСальдо.РазворачиватьПоСубсчетам");
    ТекущаяСтрока.Представление = стрНеРазворачивать();

    ЭтаФорма.Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Функция стрНеРазворачивать()
    
    Возврат РегистрыСведений.РазвернутоеСальдо.стрНеРазворачивать();
    
КонецФункции

&НаСервере
Функция стрПоСубсчетам()
    
    Возврат РегистрыСведений.РазвернутоеСальдо.стрПоСубсчетам();
    
КонецФункции

&НаСервере
Функция ПолучитьПредставление(ТекСтрока, ВыбранноеЗначение)
    
    Возврат РегистрыСведений.РазвернутоеСальдо.ПолучитьПредставление(ТекСтрока, ВыбранноеЗначение);
    
КонецФункции

&НаСервере
Функция ПолучитьСписокСчетов(Список, Строки)
    
    Для каждого Стр Из Строки Цикл
        Если НЕ Стр.Счет.ЭлементГруппа Тогда
            Список.Добавить(Стр.Счет);
        Иначе
            ПолучитьСписокСчетов(Список, Стр.ПолучитьЭлементы());
        КонецЕсли;
    КонецЦикла; 
    
    Возврат Список;

КонецФункции

&НаСервере
Функция ДобавитьСчет(Строки, Счет)
    
    Место = 0;
    Для каждого Стр Из Строки Цикл
        Если Стр.Счет.Код > Счет.Код Тогда
            Прервать;
        КонецЕсли; 
        Место = Место + 1;
    КонецЦикла;
    НоваяСтрока               = Строки.Вставить(Место);
    НоваяСтрока.Счет          = Счет;
    НоваяСтрока.Использовать  = Истина;
    НоваяСтрока.ЭлементГруппа = Счет.ЭлементГруппа;
    Если Счет.ЭлементГруппа Тогда
        НоваяСтрока.Использование = ПредопределенноеЗначение("Перечисление.ВидыРазвернутогоСальдо.Наследуется");
    Иначе
        НоваяСтрока.Использование = ПредопределенноеЗначение("Перечисление.ВидыРазвернутогоСальдо.Разворачивать");
    КонецЕсли; 
    Для каждого Сбк из Счет.ВидыСубконто Цикл
        Если НЕ Сбк.ТолькоОбороты Тогда
            Если НоваяСтрока.ПоСубконто.НайтиПоЗначению(Сбк.ВидСубконто) = Неопределено Тогда
                Сбк = НоваяСтрока.ПоСубконто.Добавить(Сбк.ВидСубконто, , Истина);
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    
    НоваяСтрока.Представление = ПолучитьПредставление(Новый Структура("ПоСубконто,Счет", НоваяСтрока.ПоСубконто, НоваяСтрока.Счет), НоваяСтрока.ПоСубконто);

    Возврат НоваяСтрока;
    
КонецФункции
 
&НаСервере
Функция ПолучитьМассивНеиспользованныхСчетов(Счета, ЧастьКода)
    
    Запрос = Новый Запрос;
    
    Запрос.Текст =
       "ВЫБРАТЬ
       |    ЕПСБУ.Ссылка
       |ИЗ
       |    ПланСчетов.ЕПСБУ КАК ЕПСБУ
       |ГДЕ
       |    ЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
       |    И НЕ ЕПСБУ.Ссылка В (&СписокСчетов)
       |    И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
       |    И ЕПСБУ.Забалансовый = ЛОЖЬ
       |    И ЕПСБУ.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
       |
       |УПОРЯДОЧИТЬ ПО
       |    ЕПСБУ.Код";
       
    Массив = ПолучитьСписокСчетов(Новый Массив, РазвернутоеСальдо.ПолучитьЭлементы());
    Запрос.УстановитьПараметр("СписокСчетов", Массив);
    Счета = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
    
    Возврат Счета;
    
КонецФункции

&НаКлиенте
Функция ПолучитьПараметрыВыбораСчета(Парам, ЧастьКода = "")
    
    Парам.Вставить("ТипСчета", ВидСчета.АктивноПассивный);
    Если НЕ ПустаяСтрока(ЧастьКода) Тогда
        Парам.Вставить("СтрокаПоиска", ЧастьКода);
    КонецЕсли; 
    НеиспользованныеСчета = ПолучитьМассивНеиспользованныхСчетов(Новый Массив, ЧастьКода);
    Парам.Вставить("ОграниченияСписокСчетов", НеиспользованныеСчета);
    
    Возврат Парам;
    
КонецФункции
 
&НаКлиенте
Процедура ВыбралиСчет(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
    
    Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
        Элементы.РазвернутоеСальдо.ТекущаяСтрока = ВыбралиСчетСервер(ВыбранноеЗначение);
        Разворачивать = Ложь;
        ТочкаРазворота = Элементы.РазвернутоеСальдо.ТекущиеДанные;
        Пока ТочкаРазворота.ПолучитьРодителя() <> Неопределено  Цикл
            ТочкаРазворота = ТочкаРазворота.ПолучитьРодителя();
            Разворачивать = Истина;
        КонецЦикла;
        Если Разворачивать Тогда
            Элементы.РазвернутоеСальдо.Развернуть(ТочкаРазворота.ПолучитьИдентификатор(), Истина);
        КонецЕсли; 
        ЭтаФорма.Модифицированность = Истина;
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ВыбралиСчетСервер(ВыбранноеЗначение)
    
            // Собираем родителей
        МассивРодителей           = Новый Массив;
        Й = ВыбранноеЗначение.Родитель;
        Пока ЗначениеЗаполнено(Й) Цикл
            МассивРодителей.Вставить(0, Й);
            Й = Й.Родитель;
        КонецЦикла;
        Й = РазвернутоеСальдо;
        Для каждого Родитель Из МассивРодителей Цикл
            ЙЙ = Неопределено;
            Для каждого ЙЙЙ Из Й.ПолучитьЭлементы() Цикл
                Если ЙЙЙ.Счет = Родитель Тогда
                    ЙЙ = ЙЙЙ;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
            Если ЙЙ = Неопределено Тогда
                Й = ДобавитьСчет(Й.ПолучитьЭлементы(), Родитель);
            Иначе
                Й = ЙЙ;
            КонецЕсли; 
        КонецЦикла;
        
        Возврат ДобавитьСчет(Й.ПолучитьЭлементы(), ВыбранноеЗначение).ПолучитьИдентификатор();
        
КонецФункции

#КонецОбласти
 