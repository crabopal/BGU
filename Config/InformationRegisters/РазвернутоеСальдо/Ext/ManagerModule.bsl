					Сбк = Счет.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
                    Если Сбк <> Неопределено И НЕ Сбк.ТолькоОбороты Тогда
                        Строка.Субконто2 = Сбк.ВидСубконто;
                    КонецЕсли;
                КонецЕсли;
            // 209
            ИначеЕсли Найти(Счет.Код, "209") Тогда
                Строка = НаборЗаписей.Добавить();
                Строка.Счет = Счет.Ссылка;
                Строка.Использование  = Перечисления.ВидыРазвернутогоСальдо.Разворачивать;
                Сбк = Счет.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
                Если Сбк <> Неопределено И НЕ Сбк.ТолькоОбороты Тогда
                    Строка.Субконто1 = Сбк.ВидСубконто;
                    Сбк = Счет.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
                    Если Сбк <> Неопределено И НЕ Сбк.ТолькоОбороты Тогда
                        Строка.Субконто2 = Сбк.ВидСубконто;
                    КонецЕсли;
                КонецЕсли;
            // 303
            ИначеЕсли Найти(Счет.Код, "303") Тогда
                Строка = НаборЗаписей.Добавить();
