Процедура ЗаполнитьПоСубконто(Строка, Субконто)

    Если ЗначениеЗаполнено(Субконто) Тогда
        Если Строка.Счет.ВидыСубконто.Найти(Субконто) <> Неопределено Тогда
            Строка.ПоСубконто.Добавить(Субконто, , Истина);
            Строка.Представление = Строка.Представление + ?(ПустаяСтрока(Строка.Представление), "", ", ") + Строка(Субконто);
        КонецЕсли; 
    КонецЕсли;
    
    Если ПустаяСтрока(Строка.Представление) Тогда
        Строка.Представление = стрНеРазворачивать();
    КонецЕсли; 

КонецПроцедуры

Функция НайтиРодителя(Дерево, Родитель)

    Для каждого Элем Из Дерево.ПолучитьЭлементы() Цикл
        Если Элем.Счет = Родитель Тогда
            Возврат Элем;
        КонецЕсли;
        Результат = НайтиРодителя(Элем, Родитель);
        Если Результат <> Неопределено Тогда
            Возврат Результат;
        КонецЕсли; 
    КонецЦикла; 
    
КонецФункции

Процедура ЗаполнитьДерево(Выборка, Дерево)
    КолВо = Выборка.Количество();
    НомерСтроки = 0;
    НомерСтрокиРодителя = -1;
    Пока НомерСтроки < КолВо Цикл
            // Вставляем строку в дерево или добавляем
        Родитель = НайтиРодителя(Дерево, Выборка[НомерСтроки].Счет.Родитель);
        Если Родитель = Неопределено Тогда
            Родитель = Дерево;
        КонецЕсли; 
        
        Строка = Родитель.ПолучитьЭлементы().Добавить();
            // Заполняем строку
        Строка.Счет          = Выборка[НомерСтроки].Счет;
        Строка.ЭлементГруппа = Строка.Счет.ЭлементГруппа;
        Строка.Использование = Выборка[НомерСтроки].Использование;
        Строка.Использовать  = (Строка.Использование <> Перечисления.ВидыРазвернутогоСальдо.НеРазворачивать);
        ИспользоватьРодителя = Ложь;
        Если
            Строка.Использование = Перечисления.ВидыРазвернутогоСальдо.РазворачиватьПоСубсчетам И
            ТипЗнч(Дерево) = Тип("СтрокаДереваЗначений")
        Тогда
            ИспользоватьРодителя = Истина;
        КонецЕсли; 
        Для Й = 1 По 3 Цикл
            Если ИспользоватьРодителя И НомерСтрокиРодителя <> -1 Тогда
                ЗаполнитьПоСубконто(Строка, Выборка[НомерСтрокиРодителя]["Субконто" + Й]);
            Иначе
                ЗаполнитьПоСубконто(Строка, Выборка[НомерСтроки]["Субконто" + Й]);
            КонецЕсли; 
        КонецЦикла;
        Если Строка.Счет.ЭлементГруппа Тогда
            Строка.Представление = стрПоСубсчетам();
        КонецЕсли; 
        Для каждого Сбк из Выборка[НомерСтроки].Счет.ВидыСубконто Цикл
            Если НЕ Сбк.ТолькоОбороты Тогда
                Если Строка.ПоСубконто.НайтиПоЗначению(Сбк.ВидСубконто) = Неопределено Тогда
                    Сбк = Строка.ПоСубконто.Добавить(Сбк.ВидСубконто, , Ложь);
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
    
КонецПроцедуры

Процедура ЗаполнитьДерево2(Выборка, Строки, НомерСтроки, СтекРодителей, НомерСтрокиРодителя = -1)
    
    КолВо = Выборка.Количество();
    Пока НомерСтроки < КолВо Цикл
            // Вставляем строку в дерево или добавляем
        Строка = Строки.ПолучитьЭлементы().Добавить(); // ПолучитьЭлементы
            // Заполняем строку
        Строка.Счет          = Выборка[НомерСтроки].Счет;
        Строка.ЭлементГруппа = Строка.Счет.ЭлементГруппа;
        Строка.Использование = Выборка[НомерСтроки].Использование;
        Строка.Использовать  = (Строка.Использование <> Перечисления.ВидыРазвернутогоСальдо.НеРазворачивать);
        ИспользоватьРодителя = Ложь;
        Если
            Строка.Использование = Перечисления.ВидыРазвернутогоСальдо.РазворачиватьПоСубсчетам И
            ТипЗнч(Строки) = Тип("СтрокаДереваЗначений")
        Тогда
            ИспользоватьРодителя = Истина;
        КонецЕсли; 
        Для Й = 1 По 3 Цикл
            Если ИспользоватьРодителя И НомерСтрокиРодителя <> -1 Тогда
                ЗаполнитьПоСубконто(Строка, Выборка[НомерСтрокиРодителя]["Субконто" + Й]);
            Иначе
                ЗаполнитьПоСубконто(Строка, Выборка[НомерСтроки]["Субконто" + Й]);
            КонецЕсли; 
        КонецЦикла;
        Если
            // Строка.Использование = Перечисления.ВидыРазвернутогоСальдо.РазворачиватьПоСубсчетам И
            // ПустаяСтрока(Строка.Представление) И
            Строка.Счет.ЭлементГруппа
        Тогда
            Строка.Представление = стрПоСубсчетам();
        КонецЕсли; 
        Для каждого Сбк из Выборка[НомерСтроки].Счет.ВидыСубконто Цикл
            Если НЕ Сбк.ТолькоОбороты Тогда
                Если Строка.ПоСубконто.НайтиПоЗначению(Сбк.ВидСубконто) = Неопределено Тогда
                    Сбк = Строка.ПоСубконто.Добавить(Сбк.ВидСубконто, , Ложь);
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        НомерСтроки = НомерСтроки + 1;
        Если НомерСтроки < КолВо Тогда
            Если СтекРодителей.Найти(Выборка[НомерСтроки].Счет.Родитель) = Неопределено Тогда
                СтекРодителей.Добавить(Строка.Счет);
                Если Строка.Использование = Перечисления.ВидыРазвернутогоСальдо.Разворачивать Тогда
                    ЗаполнитьДерево2(Выборка, Строка, НомерСтроки, СтекРодителей, НомерСтроки - 1);
                Иначе
                    ЗаполнитьДерево2(Выборка, Строка, НомерСтроки, СтекРодителей, НомерСтрокиРодителя);
                КонецЕсли; 
                СтекРодителей.Удалить(СтекРодителей.ВГраница());
            КонецЕсли;
            Если НомерСтроки = КолВо ИЛИ Выборка[НомерСтроки].Счет.Родитель <> СтекРодителей[СтекРодителей.ВГраница()] Тогда
                Возврат;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    
КонецПроцедуры

Процедура СохранитьДерево(НаборЗаписей, СтекРодителей, Строки)

    Для каждого Строка из Строки Цикл
        Запись = НаборЗаписей.Добавить();
        Запись.Счет = Строка.Счет;
        Если Строка.Использовать Тогда
            Запись.Использование = Строка.Использование;
        Иначе
            Запись.Использование = Перечисления.ВидыРазвернутогоСальдо.НеРазворачивать;
        КонецЕсли;
        Н = 1;
        Для каждого Сбк из Строка.ПоСубконто Цикл
            Если Сбк.Пометка = Истина Тогда
                Запись["Субконто" + Н] = Сбк.Значение;
                Н = Н + 1;
            КонецЕсли;
        КонецЦикла;
        
        Если Строка.ПолучитьЭлементы().Количество() Тогда
            СтекРодителей.Добавить(Строка);
            СохранитьДерево(НаборЗаписей, СтекРодителей, Строка.ПолучитьЭлементы());
            СтекРодителей.Удалить(СтекРодителей.ВГраница());
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

