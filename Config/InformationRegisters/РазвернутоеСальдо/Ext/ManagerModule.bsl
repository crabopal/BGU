КонецПроцедуры

Функция ПолучитьПредставление(ТекСтрока, ВыбранноеЗначение) Экспорт
    
    Представление = "";
    Й = 0;
    Для Каждого СтрокаСписка Из ВыбранноеЗначение Цикл
        Если СтрокаСписка.Пометка Тогда
            Если
                Й < ТекСтрока.ПоСубконто.Количество() И
                ТекСтрока.ПоСубконто.НайтиПоЗначению(СтрокаСписка.Значение) <> Неопределено
            Тогда
                Представление = Представление + СтрокаСписка.Значение + ", ";
            Иначе
                Прервать;
            КонецЕсли;
            Й = Й + 1;
        КонецЕсли;
    КонецЦикла;
    Если ТекСтрока.Счет.ЭлементГруппа Тогда
        Представление = стрПоСубсчетам();
    ИначеЕсли НЕ ПустаяСтрока(Представление) Тогда
        Представление = Сред(Представление, 1, СтрДлина(Представление) - 2);
    Иначе 
        Представление = стрНеРазворачивать();
    КонецЕсли;
    
    Возврат Представление;
    
КонецФункции
 
Процедура ЗаполнитьРазвернутоеСальдо(РазвернутоеСальдо) Экспорт
    
    НаборЗаписей = РегистрыСведений.РазвернутоеСальдо.СоздатьНаборЗаписей();
    НаборЗаписей.Прочитать();
    Выборка = НаборЗаписей.Выгрузить();
    Выборка.Колонки.Добавить("СчетКод", Новый ОписаниеТипов("Строка"));
    Выборка.Колонки.Добавить("СчетДатаНачала", Новый ОписаниеТипов("Дата"));
    Для каждого Строка Из Выборка Цикл
        Строка["СчетКод"] = Строка["Счет"].Код;
        Строка["СчетДатаНачала"] = Строка["Счет"].ДатаОкончанияДействия;
    КонецЦикла; 
    Выборка.Сортировать("СчетКод, СчетДатаНачала Убыв");
    ЗаполнитьДерево(Выборка, РазвернутоеСальдо);
   
КонецПроцедуры

Процедура СохранитьИзменения(НаборЗаписей, Строки) Экспорт
    
    НаборЗаписей.Очистить();
    
    СтекРодителей = Новый Массив;
    СохранитьДерево(НаборЗаписей, СтекРодителей, Строки);
        
КонецПроцедуры

Функция ПолучитьСписокСчетов(Список) Экспорт
    
    Выборка = РегистрыСведений.РазвернутоеСальдо.Выбрать();
    Пока Выборка.Следующий() Цикл
        Если НЕ Выборка.Счет.ЭлементГруппа Тогда
            Список.Добавить(Выборка.Счет);
        КонецЕсли;
    КонецЦикла;
    
    Возврат Список;

КонецФункции

Функция стрПоСубсчетам() Экспорт
    
    Возврат "Итог по подчиненным";
    
КонецФункции

Функция стрНеРазворачивать() Экспорт
    
    Возврат "Не разворачивать";
    
КонецФункции

