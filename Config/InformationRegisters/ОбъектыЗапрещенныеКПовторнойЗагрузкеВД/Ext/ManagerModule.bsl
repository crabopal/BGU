// Состояние запрета загрузки документов.
// 
// Параметры:
//  ЗагружаемыеДокументы - ДокументСсылка
//                       - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//  Структура - Состояние запрета загрузки документов:
// * УстановленЗапрет - Булево - 
// * РучнаяКорректировка - Булево - 
// * НачатПроцессВнутреннегоЭДО - Булево - 
// * НачатПроцессПОД - Булево - 
Функция СостояниеЗапретаЗагрузкиДокументов(ЗагружаемыеДокументы) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("УстановленЗапрет", Ложь);
	Результат.Вставить("РучнаяКорректировка", Ложь);
	Результат.Вставить("НачатПроцессВнутреннегоЭДО", Ложь);
	Результат.Вставить("НачатПроцессПОД", Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	РегистрСведений.ОбъектыЗапрещенныеКПовторнойЗагрузкеВД КАК ЗапрещенныеОбъекты
	|ГДЕ
	|	ЗапрещенныеОбъекты.ЗагруженныйОбъект В (&ЗагружаемыеДокументы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|ГДЕ
	|	ОперацииДокументов.Документ В (&ЗагружаемыеДокументы)
	|	И ОперацииДокументов.РучнаяКорректировка";
	Запрос.УстановитьПараметр("ЗагружаемыеДокументы", ЗагружаемыеДокументы);
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);	
	Результат.УстановленЗапрет = Не РезультатЗапроса[0].Пустой();
	Результат.РучнаяКорректировка = Не РезультатЗапроса[1].Пустой();
	
	// Дополнительная проверка ДО ПРОФ
	Если ВнутреннийЭДОПереопределяемый.ИспользуютсяВнутренниеДокументы() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА
		|ИЗ
		|	РегистрСведений.СостоянияУчетныхДокументов КАК СостоянияУчетныхДокументов
		|ГДЕ
		|	СостоянияУчетныхДокументов.УчетныйДокумент В (&ЗагружаемыеДокументы)
		|	И СостоянияУчетныхДокументов.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовВнутреннегоЭДО.НеНачат)";
		Запрос.УстановитьПараметр("ЗагружаемыеДокументы", ЗагружаемыеДокументы);
		УстановитьПривилегированныйРежим(Истина);
		РезультатЗапроса = Запрос.Выполнить();
		УстановитьПривилегированныйРежим(Ложь);
		Результат.НачатПроцессВнутреннегоЭДО = Не РезультатЗапроса.Пустой();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Причины блокировки. Если блокировка не установлена, возвращается Неопределено.
// 
// Параметры:
//  ЗагружаемыеДокументы - ДокументСсылка
//                       - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//  Неопределено, Структура - Причины блокировки:
// * УстановленЗапрет - Булево - 
// * РучнаяКорректировка - Булево - 
// * НачатПроцессВнутреннегоЭДО - Булево - 
// * НачатПроцессПОД - Булево - 
Функция ПричиныБлокировки(ЗагружаемыеДокументы) Экспорт
	СостояниеЗапрета = СостояниеЗапретаЗагрузкиДокументов(ЗагружаемыеДокументы);
	УдаляемыеКлючи = Новый Массив;
	Для Каждого КлючИЗначение Из СостояниеЗапрета Цикл
		Если Не КлючИЗначение.Значение Тогда
			УдаляемыеКлючи.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ключ Из УдаляемыеКлючи Цикл
		СостояниеЗапрета.Удалить(Ключ);
	КонецЦикла;
	Если ЗначениеЗаполнено(СостояниеЗапрета) Тогда
		Возврат СостояниеЗапрета;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Наименование причины.
// 
// Параметры:
//  КлючПричины - Строка
//  КодЯзыка - Неопределено - Код языка
// 
// Возвращаемое значение:
//  Строка - Наименование причины
Функция НаименованиеПричины(КлючПричины, КодЯзыка = Неопределено) Экспорт
	Если КлючПричины = "УстановленЗапрет" Тогда
		Возврат НСтр("ru = 'Установлен запрет на загрузку'", КодЯзыка);
	ИначеЕсли КлючПричины = "РучнаяКорректировка" Тогда
		Возврат НСтр("ru = 'Включена ручная корректировка проводок'", КодЯзыка);
	ИначеЕсли КлючПричины = "НачатПроцессВнутреннегоЭДО" Тогда
		Возврат НСтр("ru = 'Начат процесс подписания с использованием внутреннего ЭДО'", КодЯзыка);
	ИначеЕсли КлючПричины = "НачатПроцессПОД" Тогда
		Возврат НСтр("ru = 'Начат процесс обработки документа'", КодЯзыка);
	Иначе
		ВызватьИсключение НСтр("ru = 'Неизвестный ключ причины в функции РегистрыСведений.ОбъектыЗапрещенныеКПовторнойЗагрузке.НаименованиеПричины'");
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоляДокументовВТекстеЗапроса(ТекстЗапроса, ПолеДокумент) Экспорт
	
	ЧастиТекстаОрганизация = Новый Массив;
	ЧастиТекстаДата = Новый Массив;
	ЧастиТекстаНомер = Новый Массив;
	ЧастиТекстаКонтрагент = Новый Массив;
	ЧастиТекстаЦМООтправитель = Новый Массив;
	ЧастиТекстаЦМОПолучатель = Новый Массив;
	ЧастиТекстаПометкаУдаления = Новый Массив;
	ЧастиТекстаПроведен = Новый Массив;
	ЧастиТекстаКомментарий = Новый Массив;
	СоединяемыеТаблицы = Новый Массив;
	МетаданныеОбъектов = ОбщегоНазначения.ОбъектыМетаданныхПоИдентификаторам(
		Справочники.ОперацииУчетаВещевогоДовольствия.ДопустимыеВидыДокументаПоВидуОперации(Неопределено));
	Для Каждого КлючИЗачение Из МетаданныеОбъектов Цикл
		МетаданныеДокумента = КлючИЗачение.Значение;
		ВидДокумента = МетаданныеДокумента.Имя;
		СоединяемыеТаблицы.Добавить(ВидДокумента);
		Индекс = СоединяемыеТаблицы.ВГраница();
		ЧастиТекстаОрганизация.Добавить(ЧастьТекстаВыбораРеквизита(ПолеДокумент, ВидДокумента, "Организация", Индекс));
		ЧастиТекстаДата.Добавить(ЧастьТекстаВыбораРеквизита(ПолеДокумент, ВидДокумента, "Дата", Индекс));
		ЧастиТекстаНомер.Добавить(ЧастьТекстаВыбораРеквизита(ПолеДокумент, ВидДокумента, "Номер", Индекс));
		ЧастиТекстаПометкаУдаления.Добавить(ЧастьТекстаВыбораРеквизита(ПолеДокумент, ВидДокумента, "ПометкаУдаления", Индекс));
		ЧастиТекстаПроведен.Добавить(ЧастьТекстаВыбораРеквизита(ПолеДокумент, ВидДокумента, "Проведен", Индекс));
		ЧастиТекстаКомментарий.Добавить(ЧастьТекстаВыбораРеквизита(ПолеДокумент, ВидДокумента, "Комментарий", Индекс));
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Контрагент", МетаданныеДокумента) Тогда
			ЧастиТекстаКонтрагент.Добавить(ЧастьТекстаВыбораРеквизита(ПолеДокумент, ВидДокумента, "Контрагент", Индекс));
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЦМООтправитель", МетаданныеДокумента) Тогда
			ЧастиТекстаЦМООтправитель.Добавить(ЧастьТекстаВыбораРеквизита(ПолеДокумент, ВидДокумента, "ЦМООтправитель", Индекс));
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЦМОПолучатель", МетаданныеДокумента) Тогда
			ЧастиТекстаЦМОПолучатель.Добавить(ЧастьТекстаВыбораРеквизита(ПолеДокумент, ВидДокумента, "ЦМОПолучатель", Индекс));
		КонецЕсли;
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЦМО", МетаданныеДокумента) Тогда
			Если МетаданныеДокумента.Имя = "ПоступлениеМЗ" Тогда
				ЧастиТекстаЦМОПолучатель.Добавить(ЧастьТекстаВыбораРеквизита(ПолеДокумент, ВидДокумента, "ЦМО", Индекс));
			Иначе
				ЧастиТекстаЦМООтправитель.Добавить(ЧастьТекстаВыбораРеквизита(ПолеДокумент, ВидДокумента, "ЦМО", Индекс));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьСоединенияВЗапрос(ТекстЗапроса, СоединяемыеТаблицы, ПолеДокумент);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДата", ПолныйТекстВыбораРеквизита(ЧастиТекстаДата));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНомер", ПолныйТекстВыбораРеквизита(ЧастиТекстаНомер));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеОрганизация", ПолныйТекстВыбораРеквизита(ЧастиТекстаОрганизация));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПометкаУдаления", ПолныйТекстВыбораРеквизита(ЧастиТекстаПометкаУдаления));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПроведен", ПолныйТекстВыбораРеквизита(ЧастиТекстаПроведен));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКонтрагент", ПолныйТекстВыбораРеквизита(ЧастиТекстаКонтрагент));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЦМООтправитель", ПолныйТекстВыбораРеквизита(ЧастиТекстаЦМООтправитель));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЦМОПолучатель", ПолныйТекстВыбораРеквизита(ЧастиТекстаЦМОПолучатель));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКомментарий", ПолныйТекстВыбораРеквизита(ЧастиТекстаКомментарий));
	
КонецПроцедуры

Процедура ДобавитьСоединенияВЗапрос(ТекстЗапроса, СоединяемыеТаблицы, ПолеДокумент)
	ПострочныйТекст = Новый ТекстовыйДокумент;
	ПострочныйТекст.УстановитьТекст(ТекстЗапроса);
	ЕстьСекцияИз = Ложь;
	НомерСтрокиГде = 0;
	Для НомерСтроки = 1 По ПострочныйТекст.КоличествоСтрок() Цикл
		Если ПострочныйТекст.ПолучитьСтроку(НомерСтроки) = "ИЗ" Тогда
			ЕстьСекцияИз = Истина;
		ИначеЕсли ПострочныйТекст.ПолучитьСтроку(НомерСтроки) = "ГДЕ" Тогда
			НомерСтрокиГде = НомерСтроки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьСекцияИз И НомерСтрокиГде = 0 Тогда
		НомерСтрокиГде = ПострочныйТекст.КоличествоСтрок() + 1;
	КонецЕсли;
	Если НомерСтрокиГде = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонСоединения1 = "		ЛЕВОЕ СОЕДИНЕНИЕ Документ.%2 КАК Т%1";
	ШаблонСоединения2 = "		ПО %2 = Т%1.Ссылка";
	
	Для Индекс = 0 По СоединяемыеТаблицы.ВГраница() Цикл
		ПострочныйТекст.ВставитьСтроку(НомерСтрокиГде,
			СтрШаблон(ШаблонСоединения1, Индекс, СоединяемыеТаблицы[Индекс]));
		ПострочныйТекст.ВставитьСтроку(НомерСтрокиГде + 1,
			СтрШаблон(ШаблонСоединения2, Индекс, ПолеДокумент));
		НомерСтрокиГде = НомерСтрокиГде + 2;
	КонецЦикла;
	
	ТекстЗапроса = ПострочныйТекст.ПолучитьТекст();
КонецПроцедуры

Функция ЧастьТекстаВыбораРеквизита(ПолеДокумент, ВидДокумента, ИмяРеквизита, ИндексТаблицы)
	Возврат СтрШаблон("КОГДА %1 ССЫЛКА Документ.%2 ТОГДА Т%4.%3",
			ПолеДокумент, ВидДокумента, ИмяРеквизита, ИндексТаблицы);
КонецФункции

Функция ПолныйТекстВыбораРеквизита(ЧастиТекста)
	Возврат "ВЫБОР
	|	" + СтрСоединить(ЧастиТекста, Символы.ПС) + "
	|КОНЕЦ";
КонецФункции

#КонецОбласти

#КонецЕсли