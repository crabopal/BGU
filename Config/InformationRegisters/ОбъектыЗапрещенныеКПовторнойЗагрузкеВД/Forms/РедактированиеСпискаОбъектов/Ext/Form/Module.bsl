
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.СоответствияОбъектовИнформационныхБаз) Тогда
		ТекстИсключения = НСтр("ru = 'Для работы со списком объектов, запрещенных к повторной загрузке из Вещевого довольствия не хватает прав.
			|Необходимые права предоставляются в дополнительном профиле доступа ""Изменение списка объектов, запрещенных к повторной загрузке из Вещевого довольствия""'");
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Доступ. Отказ в доступе'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.СоответствияОбъектовИнформационныхБаз,
			,
			ТекстИсключения);
		
		ВызватьИсключение(ТекстИсключения, КатегорияОшибки.НарушениеПравДоступа);
	КонецЕсли;
	ОткрытиеИзНастройкиСинхронизации = Параметры.ОткрытиеИзНастройкиСинхронизации;
	УстановитьЗапросДинамическогоСписка();
	ЗаполнитьСписокТиповДокументов();
	УстановитьНачальноеЗначениеОтбора();
	ПрименитьВсеОтборы();
	Элементы.НастройкаСинхронизации.СписокВыбора.ЗагрузитьЗначения(ДопустимыеКонвертацииДанных());	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "РегистрацияЗапретаПовторнойЗагрузкиОбъектаВД" Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	// Если форма открывается из настройки синхронизации, то не нужно использовать сохраненные настройки.
	// Изменения настроек не нужно сохранять. Для этого ранее сохраненные настройки сохраняются в данных формы.
	Если ОткрытиеИзНастройкиСинхронизации Тогда
		СохраненныеНастройкиПользователя = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Истина);
		Настройки.Очистить();
	Иначе
		УстановитьОтборПоТекущейОрганизации();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	ПрименитьВсеОтборы();
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	// Если форма открывается из настройки синхронизации, то не нужно сохранять текущие настройки.
	// Нужно сохранить настройки, которые были получены при открытии формы.
	Если ОткрытиеИзНастройкиСинхронизации И СохраненныеНастройкиПользователя <> Неопределено Тогда
		Настройки.Очистить();
		Для Каждого КлючИЗначение Из СохраненныеНастройкиПользователя Цикл
			Настройки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

