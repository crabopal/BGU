#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ДопустимыеКонвертацииДанных()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбменВДБГУ2.Ссылка
	|ИЗ
	|	ПланОбмена.ОбменВДБГУ2 КАК ОбменВДБГУ2
	|ГДЕ
	|	ОбменВДБГУ2.Ссылка <> &ЭтотУзел";
	Запрос.УстановитьПараметр("ЭтотУзел", ПланыОбмена.ОбменВДБГУ2.ЭтотУзел());
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

&НаСервере
Процедура УстановитьОтборПоТекущейОрганизации()
	Если Параметры.СписокОрганизаций.Количество() > 0 Тогда
		ОрганизацияСписок.ЗагрузитьЗначения(Параметры.СписокОрганизаций.ВыгрузитьЗначения());
	Иначе
		Организация = ОбщегоНазначенияБГУ.ТекущаяОрганизация();
		Если ЗначениеЗаполнено(Организация) Тогда
			ОрганизацияСписок.Очистить();
			ОрганизацияСписок.Добавить(Организация);
		КонецЕсли;
	КонецЕсли;
	ОрганизацияИспользование = ЗначениеЗаполнено(ОрганизацияСписок);
КонецПроцедуры

&НаСервере
Процедура ПрименитьВсеОтборы()
	ПоляОтборов = Новый Массив;
	ПоляОтборов.Добавить("Период");
	ПоляОтборов.Добавить("Контрагент");
	ПоляОтборов.Добавить("НастройкаСинхронизации");
	ПоляОтборов.Добавить("ОрганизацияСписок");
	ПоляОтборов.Добавить("СостояниеОперации");
	ПоляОтборов.Добавить("ТипДокумента");
	ПоляОтборов.Добавить("ЦМООтправитель");
	ПоляОтборов.Добавить("ЦМОПолучатель");
	Для Каждого ПолеОтбора Из ПоляОтборов Цикл
		УстановитьОтбор(ЭтотОбъект, ПолеОтбора);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНачальноеЗначениеОтбора()
	Если Не ЗначениеЗаполнено(Период) Тогда
		Период = Новый СтандартныйПериод(НачалоМесяца(ТекущаяДатаСеанса()), КонецМесяца(ТекущаяДатаСеанса()));
	КонецЕсли;
	ПериодИспользование = ЗначениеЗаполнено(Период);
	УстановитьОтборПоТекущейОрганизации();
	Если Не Параметры.НастройкаСинхронизации.Пустая() Тогда
		НастройкаСинхронизации = Параметры.НастройкаСинхронизации;
		НастройкаСинхронизацииИспользование = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокТиповДокументов()
	ТипыДокументов = Справочники.ОперацииУчетаВещевогоДовольствия
		.ДопустимыеВидыДокументаПоВидуОперации(Неопределено); // Массив из СправочникСсылка.ИдентификаторыОбъектовМетаданных 
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ТипыДокументов, "Имя, Синоним");
	Для Каждого КлючИЗначение Из РеквизитыДокументов Цикл
		Элементы.ТипДокумента.СписокВыбора.Добавить(КлючИЗначение.Значение.Имя, КлючИЗначение.Значение.Синоним);
	КонецЦикла;
	Элементы.ТипДокумента.СписокВыбора.СортироватьПоПредставлению();
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииИспользованияОтбора(ИмяФлажка)
	УстановитьОтбор(ЭтотОбъект, Лев(ИмяФлажка, СтрДлина(ИмяФлажка) - СтрДлина("Использование")));
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НормализованноеИмяОтбора(ИмяОтбора)
	Если СтрЗаканчиваетсяНа(ИмяОтбора, "Список") Тогда
		Возврат Лев(ИмяОтбора, СтрДлина(ИмяОтбора) - СтрДлина("Список"));
	КонецЕсли;
	Возврат ИмяОтбора;
КонецФункции

&НаКлиенте
Процедура ПриИзмененииЗначенияОтбора(ИмяОтбора)
	Если ЗначениеЗаполнено(ЭтотОбъект[ИмяОтбора]) Тогда
		ЭтотОбъект[НормализованноеИмяОтбора(ИмяОтбора) + "Использование"] = Истина;
	КонецЕсли;
	УстановитьОтбор(ЭтотОбъект, ИмяОтбора);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтбор(Форма, Знач ИмяОтбора)
	Если ИмяОтбора = "Период" Тогда
		ЗначениеОтбора = Форма[ИмяОтбора]; // СтандартныйПериод
		ДатаНачала = ЗначениеОтбора.ДатаНачала;
		ДатаОкончания = ЗначениеОтбора.ДатаОкончания;
		ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора(
			Форма.Список.КомпоновщикНастроек.Настройки.Отбор, , НСтр("ru = 'Начало периода'"),
				ДатаНачала, ВидСравненияКомпоновкиДанных.БольшеИлиРавно,
				ЗначениеЗаполнено(ДатаНачала) И Форма[ИмяОтбора + "Использование"],
				РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора(
			Форма.Список.КомпоновщикНастроек.Настройки.Отбор, , НСтр("ru = 'Окончание периода'"),
				ДатаОкончания, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,
				ЗначениеЗаполнено(ДатаОкончания) И Форма[ИмяОтбора + "Использование"],
				РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	Иначе
		Если ИмяОтбора = "Организация" Тогда
			НормализованноеИмяОтбора = ИмяОтбора;
			ИмяОтбора = ИмяОтбора + "Список";
		Иначе			
			НормализованноеИмяОтбора = НормализованноеИмяОтбора(ИмяОтбора);
		КонецЕсли;
		Если НормализованноеИмяОтбора = "ТипДокумента" Тогда
			Если ЗначениеЗаполнено(Форма[ИмяОтбора]) Тогда
				ЗначениеОтбора = Тип("ДокументСсылка." + Форма[ИмяОтбора]);
			Иначе
				ЗначениеОтбора = Неопределено;
			КонецЕсли;
		Иначе
			ЗначениеОтбора = Форма[ИмяОтбора];
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.Список,
			НормализованноеИмяОтбора, ЗначениеОтбора, , , Форма[НормализованноеИмяОтбора + "Использование"],
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкуОбъекта()
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("УникальныйИдентификаторИсточника", ТекущиеДанные.УникальныйИдентификаторПриемника);
	ОткрытьФорму("РегистрСведений.ОбъектыЗапрещенныеКПовторнойЗагрузкеВД.ФормаЗаписи", ПараметрыФормы);
КонецПроцедуры

&НаСервере
Процедура УстановитьЗапросДинамическогоСписка()
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СоответствияОбъектовПереопределяемый.УникальныйИдентификаторИсточника,
	|	СоответствияОбъектовПереопределяемый.УзелИнформационнойБазы КАК НастройкаСинхронизации,
	|	СоответствияОбъектовПереопределяемый.УникальныйИдентификаторПриемника,
	|	ВЫБОР
	|		КОГДА ЗапрещенныеОбъекты.ЗагруженныйОбъект ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЗапретУстановлен,
	|	&ПолеДата КАК Дата,
	|	&ПолеНомер КАК Номер,
	|	&ПолеОрганизация КАК Организация,
	|	&ПолеПометкаУдаления КАК ПометкаУдаления,
	|	&ПолеПроведен КАК Проведен,
	|	&ПолеКонтрагент КАК Контрагент,
	|	&ПолеЦМООтправитель КАК ЦМООтправитель,
	|	&ПолеЦМОПолучатель КАК ЦМОПолучатель,
	|	&ПолеКомментарий КАК Комментарий,
	|	ТИПЗНАЧЕНИЯ(СоответствияОбъектовПереопределяемый.УникальныйИдентификаторИсточника) КАК ТипДокумента,
	|	ВЫБОР
	|		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
	|		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
	|		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
	|		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
	|		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	|	КОНЕЦ КАК СостояниеОперации,
	|	ОперацииДокументов.ЕстьПроводки КАК ЕстьПроводки,
	|	ОперацииДокументов.ДокументСторнирован КАК ДокументСторнирован,
	|	ОперацииДокументов.РучнаяКорректировка КАК РучнаяКорректировка,
	|	ОперацииДокументов.ИсправлениеОшибки КАК ИсправлениеОшибки
	|	
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовПереопределяемый
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОбъектыЗапрещенныеКПовторнойЗагрузкеВД КАК ЗапрещенныеОбъекты
	|		ПО СоответствияОбъектовПереопределяемый.УникальныйИдентификаторИсточника = ЗапрещенныеОбъекты.ЗагруженныйОбъект
	|		И СоответствияОбъектовПереопределяемый.УникальныйИдентификаторПриемника = ЗапрещенныеОбъекты.УникальныйИдентификаторИсточника
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО СоответствияОбъектовПереопределяемый.УникальныйИдентификаторИсточника = ОперацииДокументов.Документ
	|ГДЕ
	|	&ОсновноеУсловие";
	РегистрыСведений.ОбъектыЗапрещенныеКПовторнойЗагрузкеВД.ЗаполнитьПоляДокументовВТекстеЗапроса(
		ТекстЗапроса, "СоответствияОбъектовПереопределяемый.УникальныйИдентификаторИсточника");
	ЧастиУсловия = Новый Массив;
	СвойстваМетаданных = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(
		Справочники.ОперацииУчетаВещевогоДовольствия.ДопустимыеВидыДокументаПоВидуОперации(Неопределено),
		"ПолноеИмя");
	Для Каждого СвойствоМетаданного Из СвойстваМетаданных Цикл
		ЧастиУсловия.Добавить("СоответствияОбъектовПереопределяемый.УникальныйИдентификаторИсточника ССЫЛКА "
			+ СвойствоМетаданного.Значение);
	КонецЦикла;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОсновноеУсловие", СтрСоединить(ЧастиУсловия, " ИЛИ "));
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, СвойстваСписка);
	
КонецПроцедуры

#КонецОбласти
