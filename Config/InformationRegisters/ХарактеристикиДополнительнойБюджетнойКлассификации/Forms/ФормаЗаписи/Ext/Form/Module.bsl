
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Попытка
		ИзменитьНаименование();		
	Исключение	
		Отказ = Истина;
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Не удалось изменить запись:'") + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;		

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИзменитьНаименование()
	
	РегистрыСведений.ХарактеристикиДополнительнойБюджетнойКлассификации.ИзменитьНаименованиеДопКлассификации(Запись.ДополнительнаяБюджетнаяКлассификация);	
	
КонецПроцедуры

#КонецОбласти



