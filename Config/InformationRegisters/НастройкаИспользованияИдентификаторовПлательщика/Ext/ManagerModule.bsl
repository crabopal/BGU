#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПериодАктуальныхНастроек(Номенклатура,Дата = Неопределено) Экспорт

	Если Дата = Неопределено Тогда
		ТекДата = ТекущаяДатаСеанса();
	Иначе
		ТекДата = Дата;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	НастройкаИспользованияИдентификаторовПлательщикаСрезПоследних.Период
		|ИЗ
		|	РегистрСведений.НастройкаИспользованияИдентификаторовПлательщика.СрезПоследних(&ТекущаяДата, Номенклатура = &Номенклатура) КАК НастройкаИспользованияИдентификаторовПлательщикаСрезПоследних";

	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ТекущаяДата",  ТекДата);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Период;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

