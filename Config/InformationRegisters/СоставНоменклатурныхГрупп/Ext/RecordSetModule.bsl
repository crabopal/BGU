#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ТипыНоменклатурныхГрупп = Перечисления.ТипыНоменклатуры.ПолучитьТипыНоменклатурныхГрупп();
	ТипыУслугРабот          = Перечисления.ТипыНоменклатуры.ПолучитьТипыУслугРабот();
	
	Для Каждого ЗаписьРегистра Из ЭтотОбъект Цикл
		
		Если ТипыНоменклатурныхГрупп.Найти(ЗаписьРегистра.НоменклатурнаяГруппа.ТипНоменклатуры) = Неопределено Тогда
			
			ТекстОшибки = НСтр("ru='Некорректное значение в колонке ""Номенклатурная группа"".
				|
				|В качестве номенклатурных групп используются элементы справочника ""Номенклатура""
				|с типами ""%1"" или ""%2"".'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				Строка(Перечисления.ТипыНоменклатуры.НоменклатурнаяГруппа),
				Строка(Перечисления.ТипыНоменклатуры.ГруппаУслуг));
				
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,, Отказ);
			
		КонецЕсли;
		
		Если ЗаписьРегистра.НоменклатурнаяГруппа.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.НоменклатурнаяГруппа
		   И ТипыУслугРабот.Найти(ЗаписьРегистра.Номенклатура.ТипНоменклатуры) <> Неопределено Тогда
			
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='В состав номенклатурной группы продукции не рекомендуется включать работы, услуги.
					|
					|Тип номенклатуры ""%1"" - %2.'"),
					ЗаписьРегистра.Номенклатура,
					ЗаписьРегистра.Номенклатура.ТипНоменклатуры);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			
		ИначеЕсли ЗаписьРегистра.НоменклатурнаяГруппа.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ГруппаУслуг
		   И ТипыУслугРабот.Найти(ЗаписьРегистра.Номенклатура.ТипНоменклатуры) = Неопределено Тогда
			
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='В состав номенклатурной группы работ, услуг не следует включать готовую продукцию и другие материальные запасы.
					|
					|Тип номенклатуры ""%1"" - %2.'"),
					ЗаписьРегистра.Номенклатура,
					ЗаписьРегистра.Номенклатура.ТипНоменклатуры);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,, Отказ);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
