
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Ключ")
		И ЗначениеЗаполнено(Параметры.Ключ) Тогда
		НоменклатурнаяГруппа = Параметры.Ключ.НоменклатурнаяГруппа;
	ИначеЕсли Параметры.Свойство("НоменклатурнаяГруппа")
		И ЗначениеЗаполнено(Параметры.НоменклатурнаяГруппа) Тогда
		НоменклатурнаяГруппа = Параметры.НоменклатурнаяГруппа;
	ИначеЕсли Параметры.Свойство("ЗначенияЗаполнения")
		И ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура") Тогда
		Параметры.ЗначенияЗаполнения.Свойство("НоменклатурнаяГруппа", НоменклатурнаяГруппа);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоменклатурнаяГруппа) Тогда
		
		ПрочитатьДанныеРегистра();
		
		Элементы.НоменклатурнаяГруппа.ТолькоПросмотр = Истина;
		Элементы.НоменклатурнаяГруппа.РедактированиеТекста = Ложь;
		Элементы.НоменклатурнаяГруппа.КнопкаОткрытия = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		Отказ = Истина;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
			НСтр("ru = 'Данные были изменены. Сохранить изменения?'"),
			РежимДиалогаВопрос.ДаНетОтмена, ,КодВозвратаДиалога.Да);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИЗаписать();
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НоменклатурнаяГруппаПриИзменении(Элемент)
	
	ПрочитатьДанныеРегистра();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставГруппы

&НаКлиенте
Процедура СоставГруппыКоэффициентПриИзменении(Элемент)
	
	ИтогКоэффициент = СоставГруппы.Итог("Коэффициент");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Перечитать(Команда)
	
	ПрочитатьДанныеРегистра();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Отказ = ПроверитьИЗаписать();
	Если Не Отказ Тогда
		Закрыть();
		Оповестить("ИзмененСоставНоменклатурнойГруппы");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	ПроверитьИЗаписать();
	Оповестить("ИзмененСоставНоменклатурнойГруппы");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьДанныеРегистра()

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СоставНоменклатурныхГрупп.Номенклатура,
	|	СоставНоменклатурныхГрупп.Коэффициент
	|ИЗ
	|	РегистрСведений.СоставНоменклатурныхГрупп КАК СоставНоменклатурныхГрупп
	|ГДЕ
	|	СоставНоменклатурныхГрупп.НоменклатурнаяГруппа = &НоменклатурнаяГруппа";
	Запрос.УстановитьПараметр("НоменклатурнаяГруппа", НоменклатурнаяГруппа);
	
	СоставГруппы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ИтогКоэффициент = СоставГруппы.Итог("Коэффициент");
	
	Модифицированность = Ложь;

КонецПроцедуры

&НаКлиенте
Функция ПроверитьИЗаписать()
	Перем Ошибки;
	
	Отказ = НЕ СоставНоменклатурнойГруппыЗаполненКорректно(Ошибки);
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
		Возврат Отказ;
	КонецЕсли;
	
	ЗаписатьДанныеРегистра(Отказ);
	
	Если Отказ Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Не удалось записать состав номенклатурной группы.'"));
	Иначе
		Модифицированность = Ложь;
	КонецЕсли;
	
	Возврат Отказ;

КонецФункции

&НаСервере
Процедура ЗаписатьДанныеРегистра(Отказ)
	
	НаборЗаписей = РегистрыСведений.СоставНоменклатурныхГрупп.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.НоменклатурнаяГруппа.Установить(НоменклатурнаяГруппа);
	
	Для каждого СтрокаТаблицы Из СоставГруппы Цикл
	
		Запись = НаборЗаписей.Добавить();
		Запись.НоменклатурнаяГруппа = НоменклатурнаяГруппа;
		Запись.Номенклатура = СтрокаТаблицы.Номенклатура;
		Запись.Коэффициент = СтрокаТаблицы.Коэффициент;
	
	КонецЦикла;
	
	Попытка
		НаборЗаписей.Записать(Истина);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Отказ = Истина;
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция СоставНоменклатурнойГруппыЗаполненКорректно(Ошибки)
	
	МассивНоменклатуры = Новый Массив;
	МассивНомеровСтрок = Новый Массив;
	НомерСтроки = 0;
	
	Для каждого СтрокаТаблицы Из СоставГруппы Цикл
		НомерСтроки = НомерСтроки + 1;
	
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'Номенклатура'"), НомерСтроки, НСтр("ru = 'Состав номенклатурной группы'"));
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
				"СоставГруппы["+(НомерСтроки-1)+"].Номенклатура", ТекстОшибки, "");
		Иначе
			ПозицияНоменклатуры = МассивНоменклатуры.Найти(СтрокаТаблицы.Номенклатура);
			Если ПозицияНоменклатуры <> Неопределено Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Номенклатура ""%1"" уже выбрана в строке %2.'"),
					СтрокаТаблицы.Номенклатура,
					МассивНомеровСтрок[ПозицияНоменклатуры]);
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
					"СоставГруппы["+(НомерСтроки-1)+"].Номенклатура", ТекстОшибки, "");
			Иначе
				МассивНоменклатуры.Добавить(СтрокаТаблицы.Номенклатура);
				МассивНомеровСтрок.Добавить(НомерСтроки);
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат (Ошибки = Неопределено);

КонецФункции

#КонецОбласти
