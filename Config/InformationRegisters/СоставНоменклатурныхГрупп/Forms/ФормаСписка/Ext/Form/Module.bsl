
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Отбор.Свойство("НоменклатурнаяГруппа", ОтборНоменклатурнаяГруппа) Тогда
		Параметры.Свойство("НоменклатурнаяГруппа", ОтборНоменклатурнаяГруппа);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборНоменклатурнаяГруппа) Тогда
		Если ОтборНоменклатурнаяГруппа.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.НоменклатурнаяГруппа Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
			"НоменклатурнаяГруппа", ОтборНоменклатурнаяГруппа,,, ЗначениеЗаполнено(ОтборНоменклатурнаяГруппа));
		
		Элементы.ОтборНоменклатурнаяГруппа.ТолькоПросмотр = Истина;
		Элементы.ОтборНоменклатурнаяГруппа.РедактированиеТекста = Ложь;
		
	КонецЕсли;
	
	Элементы.НоменклатурнаяГруппа.Видимость = НЕ ЗначениеЗаполнено(ОтборНоменклатурнаяГруппа);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененСоставНоменклатурнойГруппы" Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборНоменклатурнаяГруппаПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
		"НоменклатурнаяГруппа", ОтборНоменклатурнаяГруппа,,, ЗначениеЗаполнено(ОтборНоменклатурнаяГруппа));
	Элементы.НоменклатурнаяГруппа.Видимость = НЕ ЗначениеЗаполнено(ОтборНоменклатурнаяГруппа);
	
КонецПроцедуры

#КонецОбласти
