#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	СообщениеЗапрос = ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыXML(ТекущийОбъект.АвторизацияЗапрос.Получить());
	СообщениеОтвет = ОбщегоНазначенияКлиентСервер.УдалитьНедопустимыеСимволыXML(ТекущийОбъект.АвторизацияОтвет.Получить());
	ЭтотОбъект.ТолькоПросмотр = Истина;
КонецПроцедуры

&НаКлиенте
Асинх Процедура СохранитьФайлыОбмена(Команда)
	ОписаниеФайла = СохранитьФайлыОбменаНаСервере();
	
	Если ОписаниеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Диалог = Новый ПараметрыДиалогаПолученияФайлов;
	Диалог.ВыборКаталога = Истина;
	ПолучитьФайлССервераАсинх(ОписаниеФайла.Адрес,ОписаниеФайла.ИмяФайла,Диалог);
КонецПроцедуры


#КонецОбласти

