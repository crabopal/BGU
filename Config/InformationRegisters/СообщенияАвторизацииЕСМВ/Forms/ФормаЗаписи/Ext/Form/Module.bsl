#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СохранитьФайлыОбменаНаСервере()
	
	ТекЗапись = РеквизитФормыВЗначение("Запись");
	
	ИмяФайлаЗапрос = "АвторизацияЗапрос.txt";	
	ИмяФайлаОтвет = "АвторизацияОтвет.txt";
				
	ТекКаталогАрхива = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПолучитьИмяВременногоФайла());
	СоздатьКаталог(ТекКаталогАрхива);
	ТекАрхиватор = Новый ЗаписьZipФайла();
		
	СохраняемоеИмяОтдельногоАрхива = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла("Файлы авторизации в ЕБП от "+ТекЗапись.ДатаОбмена," ");
		
	СохраняемоеИмяОтдельногоАрхива = СохраняемоеИмяОтдельногоАрхива + ".zip";
		
	//Запрос
	ТекИмя = ПолучитьИмяВременногоФайла("txt");
	ЗаписьТекста = Новый ЗаписьТекста(ТекИмя,КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(ТекЗапись.АвторизацияЗапрос.Получить());
	ЗаписьТекста.Закрыть();
	
	ПереместитьФайл(ТекИмя, ТекКаталогАрхива + ИмяФайлаЗапрос);
	ТекАрхиватор.Добавить(ТекКаталогАрхива + ИмяФайлаЗапрос);
	
	//Ответ
	ТекИмя = ПолучитьИмяВременногоФайла("txt");
	ЗаписьТекста = Новый ЗаписьТекста(ТекИмя,КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(ТекЗапись.АвторизацияОтвет.Получить());
	ЗаписьТекста.Закрыть();
	
	ПереместитьФайл(ТекИмя, ТекКаталогАрхива + ИмяФайлаОтвет);
	ТекАрхиватор.Добавить(ТекКаталогАрхива + ИмяФайлаОтвет);
		
	ДДАрхива = ТекАрхиватор.ПолучитьДвоичныеДанные();
	
	ОписаниеФайла = Новый Структура;
	ОписаниеФайла.Вставить("ИмяФайла", СохраняемоеИмяОтдельногоАрхива);
	ОписаниеФайла.Вставить("Адрес", ПоместитьВоВременноеХранилище(ДДАрхива,УникальныйИдентификатор));		
		
	Возврат ОписаниеФайла;
	
КонецФункции

#КонецОбласти
