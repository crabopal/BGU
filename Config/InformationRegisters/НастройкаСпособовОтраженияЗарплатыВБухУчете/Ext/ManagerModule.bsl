Функция ПолучитьПараметрыВыбораСчетНаСервере(МассивВидОперации) Экспорт
	
	ПараметрыВыбораСчета = Новый Структура;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СоответствиеОперацийУчетаЗарплаты.ОперацияБГУ.ОграниченияСчет.(
	                      |		Счет КАК Счет
	                      |	) КАК СписокСчетов
	                      |ИЗ
	                      |	РегистрСведений.СоответствиеОперацийУчетаЗарплаты КАК СоответствиеОперацийУчетаЗарплаты
	                      |ГДЕ
	                      |	СоответствиеОперацийУчетаЗарплаты.ОперацияЗГУ В(&ОперацияЗГУ)");
	
	Запрос.УстановитьПараметр("ОперацияЗГУ", МассивВидОперации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивСчетов = Новый Массив;
	
	Если Выборка.Следующий() Тогда
		
		ВыборкаСчет = Выборка.СписокСчетов.Выбрать();
		
		Пока ВыборкаСчет.Следующий() Цикл
			
			МассивСчетов.Добавить(ВыборкаСчет.Счет);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПолучитьОграниченияОперацииРезервовПоОтпускам(МассивВидОперации, МассивСчетов);
	
	Если МассивСчетов.Количество() > 0 Тогда
		
		ПараметрыВыбораСчета.Вставить("ОграниченияСписокСчетов", МассивСчетов);
		
	Иначе
		// по корреспонденции
		ПараметрыВыбораСчета.Вставить("КорреспонденцияКтКод", "302.00");
		
	КонецЕсли;	
	
	Возврат ПараметрыВыбораСчета;
	
КонецФункции

Процедура ПолучитьОграниченияОперацииРезервовПоОтпускам(МассивВидОперации, МассивСчетов)
	
	ТекстМакета = Документы.НачислениеРезервовПоОтпускам.ПолучитьМакет("ОграниченияОпераций").ПолучитьТекст(); 
	ВидыОпераций = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекстМакета);
	
	Для Каждого ТекВидОперации Из МассивВидОперации Цикл 
		
		СтрокаОграничений = ВидыОпераций.Найти(ТекВидОперации, "ВидОперацииПоЗарплате");
		
		Если СтрокаОграничений = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Объект.Ссылка КАК Счет
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК Объект
		|ГДЕ
		|	Объект.Код В (&МассивОграничений)
		|УПОРЯДОЧИТЬ ПО
		|	Объект.Код";
		
		Запрос.УстановитьПараметр("МассивОграничений", СтрРазделить(СтрокаОграничений.ОграничениеСчет, ","));
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Пока Результат.Следующий() Цикл
			
			Если МассивСчетов.Найти(Результат.Счет) = Неопределено Тогда
				МассивСчетов.Добавить(Результат.Счет);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры

Функция МассивПараметровВыбораВидаОперации() Экспорт
	МДРегистра = Метаданные.РегистрыСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете;
	
	Возврат МДРегистра.Измерения.ВидОперации.ПараметрыВыбора;
КонецФункции

Процедура УдалитьНаборЗаписей(СтруктураОтбора) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчете.ВидОперации КАК ВидОперации,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчете.Период КАК Период,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчете.Организация КАК Организация,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчете.КодНалоговогоОргана КАК КодНалоговогоОргана,
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчете.СпособОтраженияЗарплатыВБухУчете КАК СпособОтраженияЗарплатыВБухУчете
	               |ИЗ
	               |	РегистрСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете КАК НастройкаСпособовОтраженияЗарплатыВБухУчете
	               |ГДЕ
	               |	НастройкаСпособовОтраженияЗарплатыВБухУчете.Период = &Период
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.СпособОтраженияЗарплатыВБухУчете = &СпособОтраженияЗарплатыВБухУчете
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.ВидОперации = &ВидОперации
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.Организация = &Организация
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.КодНалоговогоОргана = &КодНалоговогоОргана
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.СчетДт = &СчетДт
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.Субконто1 = &Субконто1
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.Субконто2 = &Субконто2
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.Субконто3 = &Субконто3
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.СчетНУ = &СчетНУ
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.СубконтоНУ1 = &СубконтоНУ1
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.СубконтоНУ2 = &СубконтоНУ2
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.СубконтоНУ3 = &СубконтоНУ3
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.ОтражениеВУСН = &ОтражениеВУСН
	               |	И НастройкаСпособовОтраженияЗарплатыВБухУчете.НеИспользоватьВходящиеДанныеЗГУ = &НеИспользоватьВходящиеДанныеЗГУ";

	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",								СтруктураОтбора.Период);
	Запрос.УстановитьПараметр("Организация",						СтруктураОтбора.Организация);
	Запрос.УстановитьПараметр("КодНалоговогоОргана",				СтруктураОтбора.КодНалоговогоОргана);
	Запрос.УстановитьПараметр("СпособОтраженияЗарплатыВБухУчете",	СтруктураОтбора.СпособОтраженияЗарплатыВБухУчете);
	Запрос.УстановитьПараметр("ВидОперации",						СтруктураОтбора.ВидОперации);
	Запрос.УстановитьПараметр("СчетДт",								СтруктураОтбора.СчетДт);
	Запрос.УстановитьПараметр("Субконто1",							СтруктураОтбора.Субконто1);
	Запрос.УстановитьПараметр("Субконто2",							СтруктураОтбора.Субконто2);
	Запрос.УстановитьПараметр("Субконто3",							СтруктураОтбора.Субконто3);
	Запрос.УстановитьПараметр("СчетНУ",								СтруктураОтбора.СчетНУ);
	Запрос.УстановитьПараметр("СубконтоНУ1",						СтруктураОтбора.СубконтоНУ1);
	Запрос.УстановитьПараметр("СубконтоНУ2",						СтруктураОтбора.СубконтоНУ2);
	Запрос.УстановитьПараметр("СубконтоНУ3",						СтруктураОтбора.СубконтоНУ3);
	Запрос.УстановитьПараметр("ОтражениеВУСН",						СтруктураОтбора.ОтражениеВУСН);
	Запрос.УстановитьПараметр("НеИспользоватьВходящиеДанныеЗГУ",		СтруктураОтбора.НеИспользоватьВходящиеДанныеЗГУ);
	
	Если Не ЗначениеЗаполнено(СтруктураОтбора.ВидОперации) 
		ИЛИ ТипЗнч(СтруктураОтбора.ВидОперации) = Тип("Строка") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"И НастройкаСпособовОтраженияЗарплатыВБухУчете.ВидОперации = &ВидОперации","");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	ТВидыОпераций = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ТВидыОпераций Цикл
		НаборЗаписейЭталон = РегистрыСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете.СоздатьНаборЗаписей();
		НаборЗаписейЭталон.Отбор.Период.Установить(СтрокаТаблицы.Период);
		НаборЗаписейЭталон.Отбор.СпособОтраженияЗарплатыВБухУчете.Установить(СтрокаТаблицы.СпособОтраженияЗарплатыВБухУчете);
		НаборЗаписейЭталон.Отбор.Организация.Установить(СтрокаТаблицы.Организация);
		НаборЗаписейЭталон.Отбор.КодНалоговогоОргана.Установить(СтрокаТаблицы.КодНалоговогоОргана);
		НаборЗаписейЭталон.Отбор.ВидОперации.Установить(СтрокаТаблицы.ВидОперации);
		НаборЗаписейЭталон.Очистить();
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписейЭталон);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли