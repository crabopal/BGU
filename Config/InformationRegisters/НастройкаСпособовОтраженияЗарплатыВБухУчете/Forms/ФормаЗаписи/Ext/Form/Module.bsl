#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПриИзмененииОрганизацииНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	УстановитьВидимостьЭлементовНаСервере();
	
	Если НЕ ПлательщикНалогаНаПрибыль И ЗначениеЗаполнено(Запись.СчетНУ) Тогда
		
		Запись.СчетНУ = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
		Запись.СубконтоНУ1 = Неопределено;
		Запись.СубконтоНУ2 = Неопределено;
		Запись.СубконтоНУ3 = Неопределено;
		
	КонецЕсли;	
	
	Если НЕ ПрименяетсяУСНДоходыМинусРасходы И ЗначениеЗаполнено(Запись.ОтражениеВУСН) Тогда
		
		 Запись.ОтражениеВУСН  = ПредопределенноеЗначение("Перечисление.ОтражениеВУСН.ПустаяСсылка");
		 
	КонецЕсли;	 
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьВидимостьЭлементовНаСервере()
	
	Элементы.ГруппаОтражениеВНУ.Видимость  = ПлательщикНалогаНаПрибыль;
	Элементы.ГруппаОтражениеВУСН.Видимость = ПрименяетсяУСНДоходыМинусРасходы;
	Элементы.КодНалоговогоОргана.Видимость = ЭтоОперацииНДФЛ;
	
	МассивСпособыОтраженияЗарплаты = Новый Массив;
	МассивСпособыОтраженияЗарплаты.Добавить(Справочники.СпособыОтраженияЗарплатыВБухУчете.ВедомостьНаВыплатуЗарплатыВБанк);
	МассивСпособыОтраженияЗарплаты.Добавить(Справочники.СпособыОтраженияЗарплатыВБухУчете.ВедомостьПрочихДоходовВБанк);
	
	Элементы.НастройкиБУиНУ.Видимость = МассивСпособыОтраженияЗарплаты.Найти(Запись.СпособОтраженияЗарплатыВБухУчете) = Неопределено;
	
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы()
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрОрганизацияФункциональныхОпцийФормы(
		ЭтаФорма, Запись.Организация, Запись.Период);
	
	ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(
		Запись.Организация, Запись.Период);
	
	ПрименяетсяУСНДоходыМинусРасходы = УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(
		Запись.Организация, Запись.Период);
		
	ЭтоОперацииНДФЛ = Ложь;
	Если Запись.СпособОтраженияЗарплатыВБухУчете = Справочники.СпособыОтраженияЗарплатыВБухУчете.НДФЛ Тогда
		ЭтоОперацииНДФЛ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойстваСчета(Форма)

	МассивПолей = Новый Массив;
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "Субконто1", "Субконто1", Истина, "Субконто1", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "Субконто2", "Субконто2", Истина, "Субконто2", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "Субконто3", "Субконто3", Истина, "Субконто3", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Форма.Запись.СчетДт, Форма, Форма.Запись, МассивПолей);
	
	Для Индекс = 1 По 3 Цикл
		СубконтоДоступно = Форма.Элементы["Субконто"+Индекс].Доступность;
		Если НЕ СубконтоДоступно Тогда
			Форма.Запись["Субконто"+Индекс] = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойстваСчетаНУ(Форма)

	МассивПолей = Новый Массив;
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоНУ1", "СубконтоНУ1", Истина, "СубконтоНУ1", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоНУ2", "СубконтоНУ2", Истина, "СубконтоНУ2", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоНУ3", "СубконтоНУ3", Истина, "СубконтоНУ3", Истина, Истина, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Форма.Запись.СчетНУ, Форма, Форма.Запись, МассивПолей);
	
	Для Индекс = 1 По 3 Цикл
		СубконтоДоступно = Форма.Элементы["СубконтоНУ"+Индекс].Доступность;
		Если НЕ СубконтоДоступно Тогда
			Форма.Запись["СубконтоНУ"+Индекс] = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыВыбораСчетДтНаСервере(ЗаписьВидОперации)
	
	МассивВидыОпераций = Новый Массив;
	МассивВидыОпераций.Добавить(ЗаписьВидОперации);
	
	ПараметрыВыбораСчета = РегистрыСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете.ПолучитьПараметрыВыбораСчетНаСервере(МассивВидыОпераций);
	
	Возврат ПараметрыВыбораСчета;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьНачалоВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ТекНомерСубконто, ПрефиксСчета = "Дт")
	
	ТекСчет = Запись["Счет" + ПрефиксСчета];
		
	Если НЕ ЗначениеЗаполнено(ТекСчет) Тогда
		ТекстПредупреждения = НСтр("ru='Не выбран счет затрат'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		СтандартнаяОбработка = Ложь;
		Возврат;
	Иначе
		СвойстваСчета = ПолучитьСвойстваСчета(ТекСчет);
		
		Если ТипЗнч(СвойстваСчета["ВидСубконто"+ТекНомерСубконто]) = Тип("Неопределено") Тогда
			ТекстПредупреждения = НСтр("ru='Для счета %1 субконто %2 не определено'");
			ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(	ТекстПредупреждения,
																							ТекСчет,
																							ТекНомерСубконто);
			ПоказатьПредупреждение(, ТекстПредупреждения);																						
			СтандартнаяОбработка = Ложь;
			Возврат;
		КонецЕсли;
	КонецЕслИ;
	
	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									ТекСчет,
									?(ПрефиксСчета = "Дт", Запись.Субконто1, Запись.СубконтоНУ1),
									?(ПрефиксСчета = "Дт", Запись.Субконто2, Запись.СубконтоНУ2),
									?(ПрефиксСчета = "Дт", Запись.Субконто3, Запись.СубконтоНУ3));
	
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбораСпр(Элемент, ДанныеВыбора, СтандартнаяОбработка, Запись.Организация,
													СтрокаДанных, ТекНомерСубконто);
	
КонецПроцедуры // ОбработатьВыборСубконто()

&НаСервереБезКонтекста
Функция ПолучитьСвойстваСчета(Счет)
	Возврат БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
КонецФункции

&НаКлиенте
Функция ПроверитьЗаполнениеФормы()
	
	ПроверяемыеРеквизиты = Новый Структура;	
		
	ПроверяемыеРеквизиты.Вставить("СпособОтраженияЗарплатыВБухУчете",	НСтр("ru = 'Способ отражения'"));
	ПроверяемыеРеквизиты.Вставить("Организация",						НСтр("ru = 'Организация'"));
	ПроверяемыеРеквизиты.Вставить("Период",								НСтр("ru = 'Настройка действует с'"));
	ПроверяемыеРеквизиты.Вставить("ВидОперации",						НСтр("ru = 'Вид операции'"));

	Ошибки = Неопределено;
	Для Каждого ПроверяемыйРеквизит Из ПроверяемыеРеквизиты Цикл
		Если НЕ ЗначениеЗаполнено(Запись[ПроверяемыйРеквизит.Ключ]) Тогда
			ТекстОшибки = НСтр("ru = 'Не заполнено обязательное поле ""%1""'");
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
				Ошибки,
				ПроверяемыйРеквизит.Ключ,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ПроверяемыйРеквизит.Значение),);
		КонецЕсли;
	КонецЦикла;
	
	// Счет
	Если ЗначениеЗаполнено(Запись.СчетДт) Тогда
		// Субконто
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Запись.СчетДт);
		Для Инд = 1 По СвойстваСчета.КоличествоСубконто Цикл
			Если СвойстваСчета["ВидСубконто" + Инд + "Обязательный"]
			   И Не ЗначениеЗаполнено(Запись["Субконто" + Инд]) Тогда
				ТекстОшибкиТЧ = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
					СвойстваСчета["ВидСубконто" + Инд + "Наименование"]);
					
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
					Ошибки,
					"Субконто" + Инд,
					ТекстОшибкиТЧ,);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Счет НУ
	Если ЗначениеЗаполнено(Запись.СчетНУ) Тогда
		// Субконто НУ.
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Запись.СчетНУ);
		Для Инд = 1 По СвойстваСчета.КоличествоСубконто Цикл
			Если СвойстваСчета["ВидСубконто" + Инд + "Обязательный"]
			   И Не ЗначениеЗаполнено(Запись["СубконтоНУ" + Инд]) Тогда
				ТекстОшибкиТЧ = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
					СвойстваСчета["ВидСубконто" + Инд + "Наименование"]);
					
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
					Ошибки,
					"СубконтоНУ" + Инд,
					ТекстОшибкиТЧ,);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Отказ = Ложь;
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	
	Возврат Отказ;

КонецФункции

&НаСервере
Процедура УстановитьПараметрыВыбора()
	
	Если Запись.СпособОтраженияЗарплатыВБухУчете = Справочники.СпособыОтраженияЗарплатыВБухУчете.ВедомостьНаВыплатуЗарплатыВБанк
		ИЛИ Запись.СпособОтраженияЗарплатыВБухУчете = Справочники.СпособыОтраженияЗарплатыВБухУчете.ВедомостьПрочихДоходовВБанк Тогда
		ПараметрВыбораОперации = Новый ПараметрВыбора("Отбор.ГруппаОпераций","ВедомостьВБанк");
	ИначеЕсли Запись.СпособОтраженияЗарплатыВБухУчете = Справочники.СпособыОтраженияЗарплатыВБухУчете.НДФЛ Тогда
		ПараметрВыбораОперации = Новый ПараметрВыбора("Отбор.ГруппаОпераций", "НДФЛ");
	Иначе
		ДопустимыеГруппыОпераций = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
			"Начисления,НачисленияОценочныеОбязательстваИРезервы,ВзносыОценочныеОбязательстваИРезервы,НачислениеРезервов,Взносы,Удержания", ",");
		ПараметрВыбораОперации = Новый ПараметрВыбора("Отбор.ГруппаОпераций", Новый ФиксированныйМассив(ДопустимыеГруппыОпераций));
	КонецЕсли;
	
	ПараметрыВыбораОперации = Новый Массив();
	ПараметрыВыбораОперации.Добавить(ПараметрВыбораОперации);
	Элементы.ВидОперации.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораОперации);
	
КонецПроцедуры

