
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Свойство("Организация") Тогда
		ОтборОрганизация = Параметры.Отбор.Организация;
		УстановитьОтборСписка("Организация", ОтборОрганизация);
	Иначе
		ОбщегоНазначенияБГУ.УстановитьОтборСпискаПоОрганизации(ЭтаФорма, "Список", "Организация", ОтборОрганизация)
	КонецЕсли;
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтотОбъект, Элементы.ИнформационныеСсылки);
	
	МассивПараметровВыбораВидаОперации = РегистрыСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете.МассивПараметровВыбораВидаОперации();
	Элементы.ОтборВидОперации.ПараметрыВыбора = МассивПараметровВыбораВидаОперации;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьОтборСписка("Актуальность", ОтборАктуальность, (ОтборАктуальность = 0));
	УстановитьВидимостьЭлементов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	УстановитьОтборСписка("Организация", ОтборОрганизация);
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидОперацииПриИзменении(Элемент)
	УстановитьОтборСписка("ВидОперации", ОтборВидОперации);
КонецПроцедуры

&НаКлиенте
Процедура ОтборСчетПриИзменении(Элемент)
	УстановитьОтборСписка("СчетДт", ОтборСчет);
КонецПроцедуры

&НаКлиенте
Процедура ОтборАктуальностьПриИзменении(Элемент)
	УстановитьОтборСписка("Актуальность", ОтборАктуальность, (ОтборАктуальность = 0));
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборСписка(ПолеОтбора, ЗначениеОтбора, Использование = Неопределено)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
	Список.Отбор, 
	ПолеОтбора, 
	ЗначениеОтбора, 
	ВидСравненияКомпоновкиДанных.Равно, 
	, 
	?(Использование = Неопределено, ЗначениеЗаполнено(ЗначениеОтбора), Использование));
	
КонецПроцедуры
													
&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	Элементы.Организация.Видимость = Не ЗначениеЗаполнено(ОтборОрганизация);
	Элементы.ВидОперации.Видимость = Не ЗначениеЗаполнено(ОтборВидОперации);
	Элементы.ВидОперации.Видимость = Не ЗначениеЗаполнено(ОтборСчет);
КонецПроцедуры

#КонецОбласти