
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.Период) Тогда
		ОтборПериод = Параметры.Период;
	ИначеЕсли НЕ Параметры.Отбор.Свойство("Период", ОтборПериод) Тогда
		ОтборПериод = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("Период", ОтборПериод);
	
	Если НЕ (Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Организация", ОтборОрганизация)) Тогда
		Параметры.Свойство("Организация", ОтборОрганизация);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
		Элементы.ОтборОрганизация.ТолькоПросмотр = Истина;
		Элементы.ОтборОрганизация.РедактированиеТекста = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОтборОрганизация) Тогда
		ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация, , , ЗначениеЗаполнено(ОтборОрганизация));
	КонецЕсли;
	
	Если НЕ (Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("ТипЦен", ОтборТипЦен)) Тогда
		Параметры.Свойство("ТипЦен", ОтборТипЦен);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборТипЦен) Тогда
		Элементы.ОтборТипЦен.ТолькоПросмотр = Истина;
		Элементы.ОтборТипЦен.РедактированиеТекста = Ложь;
	КонецЕсли;
	
	Если НЕ (Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Номенклатура", ОтборНоменклатура)) Тогда
		Параметры.Свойство("Номенклатура", ОтборНоменклатура);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборНоменклатура) Тогда
		Элементы.ОтборНоменклатура.ТолькоПросмотр = Истина;
		Элементы.ОтборНоменклатура.РедактированиеТекста = Ложь;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ТипЦен", ОтборТипЦен, , , ЗначениеЗаполнено(ОтборТипЦен));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Номенклатура", ОтборНоменклатура, , , ЗначениеЗаполнено(ОтборНоменклатура));
	
	Элементы.Организация.Видимость 	= НЕ ЗначениеЗаполнено(ОтборОрганизация);
	Элементы.ТипЦен.Видимость 		= НЕ ЗначениеЗаполнено(ОтборТипЦен);
	Элементы.Номенклатура.Видимость	= НЕ  ЗначениеЗаполнено(ОтборНоменклатура);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПериодПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(ОтборПериод) Тогда
		ОтборПериод = ТекущаяДата();
	КонецЕсли;
	Список.Параметры.УстановитьЗначениеПараметра("Период", ОтборПериод);		
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
														 "Организация",
														 ОтборОрганизация,
														 ,
														 ,
														 ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
КонецПроцедуры

&НаКлиенте
Процедура ОтборТипЦенПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
														 "ТипЦен",
														 ОтборТипЦен,
														 ,
														 ,
														 ЗначениеЗаполнено(ОтборТипЦен));
	Элементы.ТипЦен.Видимость = НЕ ЗначениеЗаполнено(ОтборТипЦен);
КонецПроцедуры

&НаКлиенте
Процедура ОтборНоменклатураПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
														 "Номенклатура",
														 ОтборНоменклатура,
														 ,
														 ,
														 ЗначениеЗаполнено(ОтборНоменклатура));
	Элементы.Номенклатура.Видимость = НЕ ЗначениеЗаполнено(ОтборНоменклатура);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОткрытьДокументДляРедактирования();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьДокумент(Команда)
	ОткрытьДокументДляРедактирования();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьДокументДляРедактирования()

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		ПоказатьЗначение(Неопределено, ТекущиеДанные.Ссылка);
	КонецЕсли;

КонецПроцедуры // ОткрытьДокументДляРедактирования()
 
#КонецОбласти