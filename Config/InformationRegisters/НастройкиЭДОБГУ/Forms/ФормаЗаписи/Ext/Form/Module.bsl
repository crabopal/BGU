#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Организация") Тогда
		Запись.Организация = Параметры.Организация;
		ОрганизацияДляНастройки = Параметры.Организация;
	Иначе
		ОрганизацияДляНастройки = Параметры.Ключ.Организация;
	КонецЕсли;
	
	Если Параметры.Свойство("ТолькоВнутреннийЭДО") Тогда
		ТолькоВнутреннийЭДО = Истина;
	КонецЕсли;
	
	УстановитьВидимостьДоступностьНастроекЭДОБГУ(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПередачаКодовМаркировкиПриИзменении(Элемент)
	
	УстановитьВидимостьДоступностьНастроекЭДОБГУ(ЭтаФорма);

КонецПроцедуры

 &НаКлиенте
Процедура ЗагружатьДополнительныеСведенияОбъектовНФАПриИзменении(Элемент)
	
	Если НЕ Запись.ЗагружатьДополнительныеСведенияОбъектовНФА Тогда
		Запись.ЗагружатьТолькоСуществующиеДополнительныеСведенияОбъектовНФА = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьДоступностьНастроекЭДОБГУ(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагружатьДополнительныеРеквизитыОбъектовНФАПриИзменении(Элемент)
	
	Если НЕ Запись.ЗагружатьДополнительныеРеквизитыОбъектовНФА Тогда
		Запись.ЗагружатьТолькоСуществующиеДополнительныеРеквизитыОбъектовНФА = Ложь;
	КонецЕсли;

	УстановитьВидимостьДоступностьНастроекЭДОБГУ(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнятьСведенияОтветственныхВЭлектронныУПДПриИзменении(Элемент)
	
	УстановитьВидимостьДоступностьНастроекЭДОБГУ(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура НадписьДопСведенияЭлектронногоУПДНажатие(Элемент)
	
	СтандартнаяОбработка = Ложь;
	ВариантВводаДанныхУПД = 2;
	
	ПараметрыДопСведений = НовыеПараметрыДополнительныхСведенийУПД();
	
	ПараметрыДопСведений.Организация = Запись.Организация;
	ПараметрыДопСведений.ОтветственныйПередалТРУ = Запись.ОтветственныйПередалТРУ;
	ПараметрыДопСведений.ОтветственныйПередалТРУВид = Запись.ОтветственныйПередалТРУВид;
	ПараметрыДопСведений.ОтветственныйПередалТРУДоверенность = Запись.ОтветственныйПередалТРУДоверенность;
	ПараметрыДопСведений.ОтветственныйПередалТРУДолжность = Запись.ОтветственныйПередалТРУДолжность;
	ПараметрыДопСведений.ОтветственныйПередалТРУИныеСведения = Запись.ОтветственныйПередалТРУИныеСведения;
	ПараметрыДопСведений.ОтветственныйПередалТРУКонтрагент = Запись.ОтветственныйПередалТРУКонтрагент;
	ПараметрыДопСведений.ОтветственныйПередалТРУДокументПолномочий = Запись.ОтветственныйПередалТРУДокументПолномочий;
	
	ПараметрыДопСведений.ВариантВводаДанныхУПД = ВариантВводаДанныхУПД;
	
	Оповещение = Новый ОписаниеОповещения("СохранениеСведенийОтправителяВУПД", ЭтотОбъект);
	
	ОткрытьФорму("РегистрСведений.НастройкиЭДОБГУ.Форма.СведенияОбОтветственномДляЭлектронногоУПД", ПараметрыДопСведений, ЭтотОбъект,,,,Оповещение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьДоступностьНастроекЭДОБГУ(Форма)
	
	Объект = Форма.Запись;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИспользоватьОбъемноСортовойУчетМаркированныхТоваров", "Доступность", Объект.ПередачаКодовМаркировки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ЗагружатьТолькоСуществующиеДополнительныеРеквизитыОбъектовНФА", "Доступность", Объект.ЗагружатьДополнительныеРеквизитыОбъектовНФА);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ЗагружатьТолькоСуществующиеДополнительныеСведенияОбъектовНФА", "Доступность", Объект.ЗагружатьДополнительныеСведенияОбъектовНФА);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Организация", "ТолькоПросмотр", ЗначениеЗаполнено(Форма.ОрганизацияДляНастройки));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"НадписьДопСведенияЭлектронногоУПД", "Доступность", Объект.УПДЗаполнятьСведенияОЛицеОтветственномЗаПередачу);
	
	ЗаполненостьСведенийПоОтветственномуУПД = 
		ЗначениеЗаполнено(Объект.ОтветственныйПередалТРУКонтрагент) ИЛИ ЗначениеЗаполнено(Объект.ОтветственныйПередалТРУ); 
		
	Если ЗаполненостьСведенийПоОтветственномуУПД Тогда
		
		ТекстНадписи = ?(ЗначениеЗаполнено(Объект.ОтветственныйПередалТРУ), Объект.ОтветственныйПередалТРУ,Объект.ОтветственныйПередалТРУКонтрагент);		
		
	КонецЕсли;
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"НадписьДопСведенияЭлектронногоУПД", "Заголовок", ?(ЗаполненостьСведенийПоОтветственномуУПД, 
		ТекстНадписи, НСтр("ru = '<не указан>'")));
	
	Для Каждого ЭлементФормы Из Форма.ПодчиненныеЭлементы Цикл
		Если Лев(ЭлементФормы.Имя, 6) = "Группа" И ЭлементФормы.Имя <> "ГруппаВнутреннийЭДО" Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Форма.Элементы, ЭлементФормы.Имя, "Видимость", НЕ Форма.ТолькоВнутреннийЭДО);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НовыеПараметрыДополнительныхСведенийУПД()
	Возврат ЭлектронныеДокументыБГУ.НовыеПараметрыДополнительныхСведенийУПД();
КонецФункции

&НаКлиенте
Процедура СохранениеСведенийОтправителяВУПД(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		Запись.ОтветственныйПередалТРУ = Результат.ОтветственныйПередалТРУ;
		Запись.ОтветственныйПередалТРУВид = Результат.ОтветственныйПередалТРУВид;
		Запись.ОтветственныйПередалТРУДоверенность = Результат.ОтветственныйПередалТРУДоверенность;
		Запись.ОтветственныйПередалТРУДолжность = Результат.ОтветственныйПередалТРУДолжность;
		Запись.ОтветственныйПередалТРУИныеСведения = Результат.ОтветственныйПередалТРУИныеСведения;
		Запись.ОтветственныйПередалТРУКонтрагент = Результат.ОтветственныйПередалТРУКонтрагент;
		Запись.ОтветственныйПередалТРУДокументПолномочий = Результат.ОтветственныйПередалТРУДокументПолномочий;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
	УстановитьВидимостьДоступностьНастроекЭДОБГУ(ЭтаФорма);
	
КонецПроцедуры	

#КонецОбласти

