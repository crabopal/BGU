#Область СлужебныйПрограммныйИнтерфейс

Функция ПрочитатьВерсииПоставляемыхТиповыхОпераций() Экспорт
	
	Таблица52 = БухгалтерскиеОперацииПовтИспНаВремяСеанса.ВерсииМакетовТиповыхОпераций52();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица52.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	Таблица52.ДатаВерсии КАК ДатаВерсии
	|ПОМЕСТИТЬ Таблица52
	|ИЗ
	|	&Таблица52 КАК Таблица52
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоставляемыеТиповыеОперации.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ПоставляемыеТиповыеОперации.ИдентификаторДокумента.Имя КАК ИмяДокумента,
	|	ПоставляемыеТиповыеОперации.Ссылка КАК ПоставляемаяТиповаяОперация,
	|	ЕСТЬNULL(ВерсииПоставляемыхТиповыхОпераций.ДатаВерсии, Таблица52.ДатаВерсии) КАК ДатаВерсии,
	|	ПоставляемыеТиповыеОперации.ИдентификаторПоддержки КАК ИДПоддержки
	|ИЗ
	|	Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВерсииПоставляемыхТиповыхОпераций КАК ВерсииПоставляемыхТиповыхОпераций
	|		ПО ПоставляемыеТиповыеОперации.Ссылка = ВерсииПоставляемыхТиповыхОпераций.ПоставляемаяТиповаяОперация
	|			И ПоставляемыеТиповыеОперации.ИдентификаторДокумента = ВерсииПоставляемыхТиповыхОпераций.ИдентификаторДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Таблица52 КАК Таблица52
	|		ПО ПоставляемыеТиповыеОперации.ИдентификаторДокумента = Таблица52.ИдентификаторДокумента
	|ГДЕ
	|	(ВерсииПоставляемыхТиповыхОпераций.ДатаВерсии ЕСТЬ НЕ NULL 
	|			ИЛИ Таблица52.ДатаВерсии ЕСТЬ НЕ NULL )";
	Запрос.УстановитьПараметр("Таблица52", Таблица52);
	
	ДанныеРегистра = Запрос.Выполнить().Выгрузить();
	ДанныеРегистра.Колонки.Добавить("ИдентификаторПоддержки", Новый ОписаниеТипов("Строка"));
	Для каждого СтрокаРегистра Из ДанныеРегистра Цикл
	
		СтрокаРегистра.ИмяДокумента = ВРЕГ(СтрокаРегистра.ИмяДокумента);
		СтрокаРегистра.ИдентификаторПоддержки = Строка(СтрокаРегистра.ИДПоддержки);
	
	КонецЦикла;
	
	Возврат ДанныеРегистра;

КонецФункции

Функция ВерсииМакетовТиповыхОпераций52() Экспорт
	
	Макет = РегистрыСведений.ВерсииПоставляемыхТиповыхОпераций.ПолучитьМакет("ПервоначальныеДатыВерсий");
	ТаблицаИзМакета = ОбщегоНазначения.ЗначениеИзСтрокиXML(Макет.ПолучитьТекст());
	
	Таблица52 = Новый ТаблицаЗначений;
	Таблица52.Колонки.Добавить("ИдентификаторДокумента", Новый ОписаниеТипов("СправочникСсылка.ИдентификаторыОбъектовМетаданных"));
	Таблица52.Колонки.Добавить("ДатаВерсии", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	
	Для каждого СтрокаИзМакета Из ТаблицаИзМакета Цикл
	
		НоваяСтрока = Таблица52.Добавить();
		НоваяСтрока.ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка." + СтрокаИзМакета.ИмяДокумента));
		НоваяСтрока.ДатаВерсии = СтрокаИзМакета.ДатаВерсии;
	
	КонецЦикла;
	
	Возврат Таблица52;
	
КонецФункции

Функция ВерсияПоИдентификаторуДокумента(ИдентификаторДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВерсииПоставляемыхТиповыхОпераций.ДатаВерсии КАК ДатаВерсии
	|ИЗ
	|	РегистрСведений.ВерсииПоставляемыхТиповыхОпераций КАК ВерсииПоставляемыхТиповыхОпераций
	|ГДЕ
	|	ВерсииПоставляемыхТиповыхОпераций.ИдентификаторДокумента = &ИдентификаторДокумента";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаВерсии;
	КонецЕсли;
	
	Версии = ПрочитатьВерсииПоставляемыхТиповыхОпераций();
	
	СтрокаВерсии = Версии.Найти(ИдентификаторДокумента, "ИдентификаторДокумента");
	
	Если СтрокаВерсии = Неопределено Тогда
		Возврат Дата(1,1,1);
	Иначе
		Возврат СтрокаВерсии.ДатаВерсии;
	КонецЕсли;

КонецФункции

Процедура ЗаписатьВерсиюТиповойОперацииВРегистр(ПоставляемаяТиповаяОперация, ДатаВерсии) Экспорт

	Набор = РегистрыСведений.ВерсииПоставляемыхТиповыхОпераций.СоздатьНаборЗаписей();
	Набор.Отбор.ПоставляемаяТиповаяОперация.Установить(ПоставляемаяТиповаяОперация.Ссылка);
	Набор.Отбор.ИдентификаторДокумента.Установить(ПоставляемаяТиповаяОперация.ИдентификаторДокумента);
	
	Запись = Набор.Добавить();
	Запись.ПоставляемаяТиповаяОперация = ПоставляемаяТиповаяОперация.Ссылка;
	Запись.ИдентификаторДокумента = ПоставляемаяТиповаяОперация.ИдентификаторДокумента;
	Запись.ДатаВерсии = ДатаВерсии;
	
	Набор.Записать(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбновлениеИнформационнойБазы

Процедура ЗаполнитьПоставляемуюТиповуюОперациюВРегистре() Экспорт

	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	РегистрСведений.ВерсииПоставляемыхТиповыхОпераций КАК ВерсииПоставляемыхТиповыхОпераций
	|ГДЕ
	|	ВерсииПоставляемыхТиповыхОпераций.ПоставляемаяТиповаяОперация <> ЗНАЧЕНИЕ(Справочник.ПоставляемыеТиповыеОперации.ПустаяСсылка)";
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		
		// Обработка уже выполнялась
		Возврат;
	
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВерсииПоставляемыхТиповыхОпераций.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ВерсииПоставляемыхТиповыхОпераций.ДатаВерсии КАК ДатаВерсии,
	|	ПоставляемыеТиповыеОперации.Ссылка КАК ПоставляемаяТиповаяОперация
	|ИЗ
	|	РегистрСведений.ВерсииПоставляемыхТиповыхОпераций КАК ВерсииПоставляемыхТиповыхОпераций
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
	|		ПО ВерсииПоставляемыхТиповыхОпераций.ИдентификаторДокумента = ПоставляемыеТиповыеОперации.ИдентификаторДокумента";
	
	НаборЗаписей = РегистрыСведений.ВерсииПоставляемыхТиповыхОпераций.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, Истина, Истина);

КонецПроцедуры

#КонецОбласти

#КонецОбласти


#КонецЕсли