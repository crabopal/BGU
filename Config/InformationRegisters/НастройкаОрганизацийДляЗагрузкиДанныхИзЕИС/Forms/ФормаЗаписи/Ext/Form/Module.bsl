#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект,ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Параметры.Организация)
		И НЕ ЗначениеЗаполнено(Запись.Организация) Тогда
		ТекЗапись = РеквизитФормыВЗначение("Запись");
		ТекЗапись.Организация = Параметры.Организация;
		ТекЗапись.Прочитать();
		Если НЕ ТекЗапись.Выбран() Тогда
			ТекЗапись.Организация = Параметры.Организация;
			//заполнение по умолчанию
			ТекЗапись.ВидОбмена = Справочники.ТипыОбменаБанкиКС.НайтиПоРеквизиту("ПредставлениеВНомереВерсии", "UISP");
		КонецЕсли;
		
		ЗначениеВРеквизитФормы(ТекЗапись,"Запись");
	КонецЕсли;
	
	ОбновитьКодВидаОбмена();
	ОбновитьСпособОбменаНастройки();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект,ТекущийОбъект,ПараметрыЗаписи);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("ОбновленаНастройкаОрганизацийДляЗагрузкиДанныхИзЕИС",Запись.Организация,ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидОбменаПриИзменении(Элемент)
	
	ПриИзмененииВидаОбмена();

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВидаОбмена()
	
    ОбновитьКодВидаОбмена();
	ОбновитьСпособОбменаНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОбменаПриИзменении(Элемент)
	ОбновитьСпособОбменаНастройки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьСпособОбменаНастройки()
	Если ЗначениеЗаполнено(Запись.НастройкаОбмена) Тогда
		СпособОбменаНастройки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.НастройкаОбмена,"СпособОбмена");
	Иначе
		СпособОбменаНастройки = Неопределено;
	КонецЕсли;
	
	ВидимостьОшибки = Ложь;
	Если ЗначениеЗаполнено(СпособОбменаНастройки)
		И СпособОбменаНастройки <> Перечисления.СпособыВыгрузкиФайловПередачи.WebСервис Тогда
		
		ВидимостьОшибки = Истина;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"НадписьНастройкаОбмена","Видимость",ВидимостьОшибки);
КонецПроцедуры

&НаСервере
Процедура ОбновитьКодВидаОбмена()
	Если ЗначениеЗаполнено(Запись.ВидОбмена) Тогда
		КодВидаОбмена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.ВидОбмена,"ПредставлениеВНомереВерсии");
	Иначе
		КодВидаОбмена = "";
	КонецЕсли;
	
	ВидимостьОшибки = Ложь;
	Если ЗначениеЗаполнено(КодВидаОбмена)
		И КодВидаОбмена <> "UISP" Тогда
		
		ВидимостьОшибки = Истина;
		
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ДекорацияОтступВидОбмена","Видимость",ВидимостьОшибки);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"НадписьВидОбмена","Видимость",ВидимостьОшибки);
КонецПроцедуры

#КонецОбласти

