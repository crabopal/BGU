#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	Элементы.ВидОбъекта.СписокВыбора.Добавить(ТекущийОбъект.ВидОбъекта, ТекущийОбъект.ПредставлениеВидаОбъекта);
	ПолучитьРеквизитыОбъекта();	
	Элементы.ВидОбъекта.ТолькоПросмотр = Истина;
	Элементы.ИмяРеквизита.ТолькоПросмотр = Истина;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Запись.ТипРеквизита) Тогда
		
		УстановитьОграничениеТипРеквизита();
		
	КонецЕсли;
	
	Если Параметры.ЗначенияЗаполнения.Свойство("ВидОбъекта") Тогда
		
		Запись.ВидОбъекта = Параметры.ЗначенияЗаполнения.ВидОбъекта;
		ПолучитьРеквизитыОбъекта();
		
	КонецЕсли;
	
	Элементы.ВидОбъекта.ПараметрыВыбора = Новый ФиксированныйМассив(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		Новый ПараметрВыбора("Отбор.Ссылка", РегистрыСведений.ЗначениеРеквизитовПоУмолчанию.ВозможныеИОМ())));
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ОбъектМетаданные = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ТекущийОбъект.ВидОбъекта);
	Если ОбъектМетаданные.Реквизиты.Найти(ТекущийОбъект.ИмяРеквизита) <> Неопределено Тогда
		ТекущийОбъект.ПредставлениеИмениРеквизита = ОбъектМетаданные.Реквизиты[ТекущийОбъект.ИмяРеквизита].Синоним;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия="ВыборОбъектовМетаданных" и Источник = УникальныйИдентификатор и ТипЗнч(Параметр) = Тип("СписокЗначений") Тогда
		Если Параметр.Количество()>0 Тогда
			Запись.ВидОбъекта = Параметр[0].Значение;
			Запись.ПредставлениеВидаОбъекта = Параметр[0].Представление;
			Элементы.ВидОбъекта.СписокВыбора.Очистить();
			Элементы.ВидОбъекта.СписокВыбора.Добавить(Параметр[0].Значение, Параметр[0].Представление);
			
			ПолучитьРеквизитыОбъекта();
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидОбъектаПриИзменении(Элемент)
	ПолучитьРеквизитыОбъекта();
КонецПроцедуры

&НаКлиенте
Процедура ИмяРеквизитаПриИзменении(Элемент)
	
	Тип = ПолучитьТипРеквизита(Запись.ВидОбъекта, Запись.ИмяРеквизита);
	Элементы.ЗначениеРеквизита.ОграничениеТипа = Тип;
	Тип.ПривестиЗначение(Элементы.ЗначениеРеквизита);
	Элементы.ЗначениеРеквизита.ВыбиратьТип=Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеРеквизитаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Запись.ЗначениеРеквизита) и Не ЗначениеЗаполнено(Запись.ТипРеквизита) Тогда
		ПолучитьТипВыбанногоЗначения();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Элемент.ОграничениеТипа. СодержитТип(Тип("ПланСчетовСсылка.ЕПСБУ")) Тогда
		Элемент.ВыборГруппИЭлементов = ГруппыИЭлементы.ГруппыИЭлементы;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Устанавливает доступные для выбора типы, реквизита ЗначениеРеквизита
// Доступные типы берутся реквизита ТипРеквизита записи регистра.
//
&НаСервере
Процедура УстановитьОграничениеТипРеквизита() Экспорт
	ТипРеквизита=Запись.ТипРеквизита;
	Элемент=Элементы.ЗначениеРеквизита;
	
	Если Найти(ТипРеквизита,"Ссылка.")=0 Тогда
		ТипРеквизита = СтрЗаменить(ТипРеквизита,".","Ссылка.");
	КонецЕсли;
	
	Тип = Новый ОписаниеТипов(ТипРеквизита);
	
	Элемент.ОграничениеТипа = Тип;
	Тип.ПривестиЗначение(Элемент);

КонецПроцедуры

&НаСервере
Процедура ПолучитьРеквизитыОбъекта()
	
	СписокРеквизитов = БухгалтерскийУчетПовтИсп.ПолучитьСписокРеквизитовОбъектаМетаданных(Запись.ВидОбъекта);
	
	СписокВыбора = Элементы.ИмяРеквизита.СписокВыбора;
	СписокВыбора.Очистить();
	
	Если СписокРеквизитов.Количество() = 0 Тогда
		Запись.ВидОбъекта = Неопределено;
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекЗначение Из СписокРеквизитов Цикл
		// Значения по умолчанию можно установить только для реквизитов объекта,
		// но не для реквизитов табличных частей.
		Если СтрНайти(ТекЗначение.Значение, ".") = 0 Тогда
			СписокВыбора.Добавить(ТекЗначение.Значение, ТекЗначение.Представление);
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТипРеквизита(ВидОбъекта, ИмяРеквизита)

	Возврат ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ВидОбъекта).Реквизиты[ИмяРеквизита].Тип;

КонецФункции // ПолучитьТипРеквизита()

 // Заполняет реквизит ТипРеквизита полным именем объекта метаданных ЗначенияРеквизита
 //
 // Параметры
 //  <Параметр1>  - <Тип.Вид> - <описание параметра>
 //                 <продолжение описания параметра>
 //  <Параметр2>  - <Тип.Вид> - <описание параметра>
 //                 <продолжение описания параметра>
 //
&НаСервере
Процедура ПолучитьТипВыбанногоЗначения()
	Если ТипЗнч(Запись.ЗначениеРеквизита) = Тип("Строка") Тогда
		ПолноеИмя = "Строка";
	ИначеЕсли ТипЗнч(Запись.ЗначениеРеквизита) = Тип("Число") Тогда
		ПолноеИмя = "Число";
	ИначеЕсли ТипЗнч(Запись.ЗначениеРеквизита) = Тип("Дата") Тогда
		ПолноеИмя = "Дата";
	ИначеЕсли ТипЗнч(Запись.ЗначениеРеквизита) = Тип("Булево") Тогда
		ПолноеИмя = "Булево";
	Иначе
		ПолноеИмя = Запись.ЗначениеРеквизита.Метаданные().ПолноеИмя();
	КонецЕсли;
	Запись.ТипРеквизита = ПолноеИмя;
КонецПроцедуры

#КонецОбласти
