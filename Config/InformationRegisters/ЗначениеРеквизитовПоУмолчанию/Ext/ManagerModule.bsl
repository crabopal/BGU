#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗагрузитьЭлементы");
КонецПроцедуры

#КонецОбласти

Процедура ЗагрузитьЭлементы(Очищать = Ложь) Экспорт

	Если Очищать Тогда
		Регистр = РегистрыСведений.ЗначениеРеквизитовПоУмолчанию.СоздатьНаборЗаписей();
		Регистр.Очистить();
		Регистр.Записать();
	КонецЕсли;	

	
	Макет = ПолучитьМакет("ЗначенияРеквизитов");	
	Для ТекСтр=2 По Макет.ВысотаТаблицы Цикл
	
		СоздатьЭлемент(Макет.Область("R"+ТекСтр+"C1").Текст,
						Макет.Область("R"+ТекСтр+"C2").Текст,
						Макет.Область("R"+ТекСтр+"C3").Текст,
						Макет.Область("R"+ТекСтр+"C4").Текст,
						Макет.Область("R"+ТекСтр+"C5").Текст);
	
	КонецЦикла; 
	

КонецПроцедуры // ЗагрузитьЭлементы()()

Процедура СоздатьЭлемент(Дата, ВидОбъекта, ИмяРеквизита, ТипРеквизита, СтрЗначениеРеквизита) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ИдентификаторыОбъектовМетаданных.Ссылка
	|ИЗ
	|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	|ГДЕ
	|	ИдентификаторыОбъектовМетаданных.ПолноеИмя = &ПолноеИмя");
	Запрос.УстановитьПараметр("ПолноеИмя", ВидОбъекта);
	
	РезультатВыборки = Запрос.Выполнить().Выбрать();	
	Если НЕ РезультатВыборки.Следующий() Тогда
		Возврат;
	КонецЕсли;	
	
	Регистр = РегистрыСведений.ЗначениеРеквизитовПоУмолчанию.СоздатьНаборЗаписей();
	Регистр.Отбор.Период.Установить(Дата);
	Регистр.Отбор.ВидОбъекта.Установить(РезультатВыборки.Ссылка);
	Регистр.Отбор.ИмяРеквизита.Установить(ИмяРеквизита);
	
	НовЗапись = Регистр.Добавить();
	НовЗапись.Период 				= Дата;
	НовЗапись.ВидОбъекта 			= РезультатВыборки.Ссылка;
	НовЗапись.ИмяРеквизита 			= ИмяРеквизита;
		
	ОбъектМетаданные = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(НовЗапись.ВидОбъекта);
	Если ОбъектМетаданные.Реквизиты.Найти(НовЗапись.ИмяРеквизита) <> Неопределено Тогда
		НовЗапись.ПредставлениеИмениРеквизита = ОбъектМетаданные.Реквизиты[НовЗапись.ИмяРеквизита].Синоним;
	КонецЕсли;

	НовЗапись.ТипРеквизита 			= ТипРеквизита;
	НовЗапись.ЗначениеРеквизита 	= ПолучитьЗначениеРеквизита(ТипРеквизита, СтрЗначениеРеквизита);

	Регистр.Записать(Истина);
	
КонецПроцедуры // СоздатьЭлемент()

// Возвращает фиксированный массив тип СправочникСсылка.ИдентификаторыОбъектовМетаданных,
// для которых имеет смысл создавать значения реквизитов по умолчанию
// Возвращаемое значение:
// ФиксированныйМассив - содержит элементы типа СправочникСсылка.ИдентификаторыОбъектовМетаданных
Функция ВозможныеИОМ() Экспорт

	МассивВозможныхТипов = Новый Массив;
	Для каждого ТипВходящегоОбъекта Из Метаданные.ПодпискиНаСобытия.ЗаполнитьРеквизитыОбъектовПоУмолчанию.Источник.Типы() Цикл
	
		МассивВозможныхТипов.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипВходящегоОбъекта));
	
	КонецЦикла;
	Для каждого ТипВходящегоОбъекта Из Метаданные.ПодпискиНаСобытия.ЗаполнитьРеквизитыДокументовПоУмолчанию.Источник.Типы() Цикл
	
		МассивВозможныхТипов.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипВходящегоОбъекта));
	
	КонецЦикла;
	МассивВозможныхТипов.Добавить(ОбщегоНазначенияБГУПовтИсп.СсылкаИдентификатораОбъектаМетаданных("Справочники"));
	МассивВозможныхТипов.Добавить(ОбщегоНазначенияБГУПовтИсп.СсылкаИдентификатораОбъектаМетаданных("Документы"));

	Возврат Новый ФиксированныйМассив(МассивВозможныхТипов);
	
КонецФункции // СписокВозможныхИОМ()

Функция ЗначенияРеквизитовОбъектаПоУмолчанию(Дата, ВидОбъекта, ИменаРеквизитов) Экспорт
	
	ИдентификаторОбъекта = ВидОбъекта;
	
	Если ТипЗнч(ИдентификаторОбъекта) = Тип("Строка") Тогда
		ИдентификаторОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ИдентификаторОбъекта);
	КонецЕсли;
	
	// Удаление пробелов.
	Реквизиты = СтрЗаменить(ИменаРеквизитов, " ", "");
	// Преобразование параметра в массив полей.
	Реквизиты = СтрРазделить(Реквизиты, ",");
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	ЗначениеРеквизитовПоУмолчаниюСрезПоследних.ЗначениеРеквизита КАК ЗначениеРеквизита,
	|	ЗначениеРеквизитовПоУмолчаниюСрезПоследних.ИмяРеквизита КАК ИмяРеквизита
	|ИЗ
	|	РегистрСведений.ЗначениеРеквизитовПоУмолчанию.СрезПоследних(
	|			&ДатаЗначения,
	|			ВидОбъекта = &ВидОбъекта
	|				И ИмяРеквизита В (&Реквизиты)) КАК ЗначениеРеквизитовПоУмолчаниюСрезПоследних");
	
	Запрос.УстановитьПараметр("ВидОбъекта", ИдентификаторОбъекта);
	Запрос.УстановитьПараметр("Реквизиты", Реквизиты);
	Запрос.УстановитьПараметр("ДатаЗначения", Дата); 

	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Результат = Новый Структура;
	
	Для Каждого Реквизит Из Реквизиты Цикл
		
		Ключ = Реквизит;
		Значение = "";
		
		Стр = ТабРезультат.Найти(Реквизит, "ИмяРеквизита");
		Если НЕ Стр = Неопределено Тогда
			Значение = Стр.ЗначениеРеквизита;
		КонецЕсли;
		
		Результат.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция ищет значение реквизита по заданному представлению. Для справочников поиск ведется по основному представлению.
//
// Возвращаемое значение:
//   Найденное значение реквизита
//
Функция ПолучитьЗначениеРеквизита(ТипРеквизита, СтрЗначениеРеквизита)
	
	Если ТипРеквизита = "Строка" Тогда
		Возврат СтрЗначениеРеквизита;
	ИначеЕсли ТипРеквизита = "Число" Тогда
		ТипЧисло = Новый ОписаниеТипов("Число");
		Возврат ТипЧисло.ПривестиЗначение(СтрЗначениеРеквизита);
	ИначеЕсли ТипРеквизита = "Дата" Тогда
		ТипДата = Новый ОписаниеТипов("Дата");
		Возврат ТипДата.ПривестиЗначение(СтрЗначениеРеквизита);
	ИначеЕсли ТипРеквизита = "Булево" Тогда
		ТипБулево = Новый ОписаниеТипов("Булево");
		Возврат ТипБулево.ПривестиЗначение(СтрЗначениеРеквизита);
	КонецЕсли;

	ЧастиИмени = СтрРазделить(ТипРеквизита, ".");
	ТипОбъекта=ЧастиИмени[0];
	ВидОбъекта=ЧастиИмени[1];
	
	Если ТипОбъекта="ПланСчетов" Тогда
		Возврат БухгалтерскийУчет.СчетПоКоду(СтрЗначениеРеквизита, ТекущаяДатаСеанса());
	ИначеЕсли ТипОбъекта="Справочник" Тогда
		Если Метаданные.НайтиПоПолномуИмени(ТипРеквизита).ОсновноеПредставление
					= Метаданные.СвойстваОбъектов.ОсновноеПредставлениеСправочника.ВВидеКода Тогда
			Возврат Справочники[ВидОбъекта].НайтиПоКоду(СтрЗначениеРеквизита);
		Иначе
			Возврат Справочники[ВидОбъекта].НайтиПоНаименованию(СтрЗначениеРеквизита);
		КонецЕсли;
	ИначеЕсли ТипОбъекта="Перечисление" Тогда
		Возврат Перечисления[ВидОбъекта][СтрЗначениеРеквизита];
	ИначеЕсли ТипОбъекта="ПланВидовХарактеристик" Тогда
		Если Метаданные.НайтиПоПолномуИмени(ТипРеквизита).ОсновноеПредставление
					= Метаданные.СвойстваОбъектов.ОсновноеПредставлениеВидаХарактеристики.ВВидеКода Тогда
			Возврат ПланыВидовХарактеристик[ВидОбъекта].НайтиПоКоду(СтрЗначениеРеквизита);
		Иначе
			Возврат ПланыВидовХарактеристик[ВидОбъекта].НайтиПоНаименованию(СтрЗначениеРеквизита);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции // ПолучитьЗначениеРеквизита()

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ПолноеИмяРегистра = "РегистрСведений.ЗначениеРеквизитовПоУмолчанию";
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
			
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначениеРеквизитовПоУмолчанию.ВидОбъекта КАК ВидОбъекта,
	|	ЗначениеРеквизитовПоУмолчанию.ИмяРеквизита КАК ИмяРеквизита,
	|	ЗначениеРеквизитовПоУмолчанию.УдалитьВидОбъекта КАК УдалитьВидОбъекта,
	|	ЗначениеРеквизитовПоУмолчанию.Период КАК Период
	|ИЗ
	|	РегистрСведений.ЗначениеРеквизитовПоУмолчанию КАК ЗначениеРеквизитовПоУмолчанию
	|ГДЕ
	|	ЗначениеРеквизитовПоУмолчанию.ИмяРеквизита = &ИмяРеквизита";
	Запрос.УстановитьПараметр("ИмяРеквизита", "ИдентификаторПечатнойФормы");
	
	Данные = Запрос.Выполнить().Выгрузить();
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные, ДополнительныеПараметры);
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	Параметры.ОбработкаЗавершена = Ложь;
	 
	ПолноеИмяРегистра = "РегистрСведений.ЗначениеРеквизитовПоУмолчанию";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьИзмеренияНезависимогоРегистраСведенийДляОбработки(Параметры.Очередь,
		ПолноеИмяРегистра);
	Если Выборка.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ПолноеИмяРегистра = ПолноеИмяРегистра;
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
	
	ТаблицаРегистра = Новый ТаблицаЗначений;
	ТаблицаРегистра.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	ТаблицаРегистра.Колонки.Добавить("ВидОбъекта", Новый ОписаниеТипов("СправочникСсылка.ИдентификаторыОбъектовМетаданных"));
	ТаблицаРегистра.Колонки.Добавить("ИмяРеквизита", Новый ОписаниеТипов("Строка"));
	ТаблицаРегистра.Колонки.Добавить("УдалитьВидОбъекта", Новый ОписаниеТипов("Строка"));
	
	Пока Выборка.Следующий() Цикл
		СозданаНоваяЗапись = Ложь;
		ВидОбъекта = Выборка.ВидОбъекта; // СправочникСсылка.ИдентификаторыОбъектовМетаданных
		Если ЗначениеЗаполнено(ВидОбъекта) Тогда
			ОбъектМетаданных = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ВидОбъекта); // ОбъектМетаданныхДокумент
			РеквизитПервичныйДокумент = ОбъектМетаданных.Реквизиты.Найти("ПервичныйДокумент");
			Если РеквизитПервичныйДокумент <> Неопределено
					И ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(
					РеквизитПервичныйДокумент.Тип, Тип("СправочникСсылка.ПервичныеДокументы"))
					И ОбъектМетаданных.Реквизиты.Найти("ИдентификаторПечатнойФормы") = Неопределено Тогда
				СозданаНоваяЗапись = ДобавитьЗаписьПервичныйДокумент(Выборка.Период, ВидОбъекта, ОбъектМетаданных); 
			КонецЕсли;
		КонецЕсли;
		Если СозданаНоваяЗапись Тогда
			ТаблицаРегистра.Очистить();
			НоваяСтрока = ТаблицаРегистра.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ТаблицаРегистра, ДополнительныеПараметры);	
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ДобавитьЗаписьПервичныйДокумент(Период, ВидОбъекта, ОбъектМетаданных)
	ПредставлениеВидаОбъекта = ОбъектМетаданных.ПолноеИмя();
	СозданаНоваяЗапись = Ложь;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных();
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗначениеРеквизитовПоУмолчанию");
		ЭлементБлокировки.УстановитьЗначение("Период", Период);
		ЭлементБлокировки.УстановитьЗначение("ВидОбъекта", ВидОбъекта);
		Блокировка.Заблокировать();
		
		СтарыйНаборЗаписей = СоздатьНаборЗаписей();
		СтарыйНаборЗаписей.Отбор.Период.Установить(Период);
		СтарыйНаборЗаписей.Отбор.ВидОбъекта.Установить(ВидОбъекта);
		СтарыйНаборЗаписей.Отбор.ИмяРеквизита.Установить("ИдентификаторПечатнойФормы");
		СтарыйНаборЗаписей.Прочитать();
		Если СтарыйНаборЗаписей.Количество() > 0 И ТипЗнч(СтарыйНаборЗаписей[0].ЗначениеРеквизита) = Тип("Строка") Тогда
			ИдентификаторПФ = СтарыйНаборЗаписей[0].ЗначениеРеквизита;
			Если ИдентификаторПФ = "ДокументКонтрагента" Тогда
				ПервичныйДокумент = ПервичныеДокументыБГУ.ПервичныйДокументДокументКонтрагента();
			Иначе
				ПервичныйДокумент = ПервичныеДокументыБГУ.НайтиПоИдентификатору(ИдентификаторПФ);
			КонецЕсли;
			Если ЗначениеЗаполнено(ПервичныйДокумент) Тогда
				НовыйНабор = СоздатьНаборЗаписей();
				НовыйНабор.Отбор.Период.Установить(Период);
				НовыйНабор.Отбор.ВидОбъекта.Установить(ВидОбъекта);
				НовыйНабор.Отбор.ИмяРеквизита.Установить("ПервичныйДокумент");
				Запись = НовыйНабор.Добавить();
				Запись.Период = Период;
				Запись.ВидОбъекта = ВидОбъекта;
				Запись.ИмяРеквизита = "ПервичныйДокумент";
				Запись.ЗначениеРеквизита = ПервичныйДокумент;
				Запись.ПредставлениеИмениРеквизита = ОбъектМетаданных.Реквизиты.ПервичныйДокумент.Синоним;
				Запись.ТипРеквизита = ПервичныйДокумент.Метаданные().ПолноеИмя();
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НовыйНабор);
				
				// Удалить старую запись
				СтарыйНаборЗаписей.Очистить();
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(СтарыйНаборЗаписей);
				
				// Удалить парную ей запись с представлением первичного документа
				СтарыйНаборЗаписей.Отбор.ИмяРеквизита.Установить("ПредставлениеПечатнойФормы");
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(СтарыйНаборЗаписей);
				
			КонецЕсли;
		КонецЕсли;
		СозданаНоваяЗапись = Истина;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		СозданаНоваяЗапись = Ложь;
		ТекстСообщения = НСтр("ru = 'Не удалось записать ""Значения реквизитов по умолчанию"": вид объекта - %Документ%, имя реквизита - ПервичныйДокумент,  по причине: %Причина%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеВидаОбъекта);
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.РегистрыСведений.ЗначениеРеквизитовПоУмолчанию,
			,
			ТекстСообщения);
	КонецПопытки;
	
	Возврат СозданаНоваяЗапись;
КонецФункции

