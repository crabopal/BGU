////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Заполняет сохраненные настройки для текущего пользоателя
//
&НаСервере
Процедура ЗаполнитьЗначенияНастроек()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПерсональныеНастройки.Родитель,
	               |	ПерсональныеНастройки.Ссылка КАК Настройка,
	               |	ПерсональныеНастройки.ЭтоГруппа КАК ЭтоГруппа,
	               |	ЗначенияНастроек.ЗначениеНастройки,
	               |	ВЫБОР
	               |		КОГДА ПерсональныеНастройки.ЭтоГруппа
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК Картинка
	               |ИЗ
	               |	ПланВидовХарактеристик.ПерсональныеНастройки КАК ПерсональныеНастройки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПерсональныеНастройки КАК ЗначенияНастроек
	               |		ПО (ЗначенияНастроек.Настройка = ПерсональныеНастройки.Ссылка)
	               |			И (ЗначенияНастроек.Пользователь = &Пользователь)
	               |ГДЕ
	               |	(&ИспользоватьУчетПоИФО
	               |			ИЛИ ПерсональныеНастройки.Ссылка <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПерсональныеНастройки.ОсновнойИФО))
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭтоГруппа ИЕРАРХИЯ,
	               |	ПерсональныеНастройки.Код";
				   
	Запрос.УстановитьПараметр("Пользователь", ТекущийПользователь);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	СохраненныеНастройки = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);

	ЗначениеВДанныеФормы(СохраненныеНастройки, СписокНастроек);
	
КонецПроцедуры // ЗаполнитьЗначенияНастроек()

// Возвращает описание типов для текущего типа
//
// Параметры
//  СтрокаТип  - Строка - Строковое представление типа
//
// Возвращаемое значение:
//   ОписаниеТипов   - Описание типов, содержащее нужный тип
//
&НаКлиенте
Функция ПолучитьОписаниеТипов(СтрокаТип)

	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип(СтрокаТип));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);

	Возврат ОписаниеТипов;
	
КонецФункции // ПолучитьОписаниеТипов()

// Получает структуру возможных настроек
//
// Параметры
//  СтруктураНастроек  - Структура - Содержит соответствие между представлением
//                 настройки и планом видов характеристик
//
&НаСервере
Процедура ПолучитьСтруктуруНастроек(СтруктураНастроек)

	СтруктураНастроек = Новый Структура("ОсновнаяОрганизация, ОсновноеПодразделение, ОсновнойИФО",
										ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновнаяОрганизация,
										ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновноеПодразделение,
										ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновнойИФО);

КонецПроцедуры // ПолучитьСтруктуруНастроек()

// Записывает установленные значения настроек	
//
&НаСервере
Процедура ЗаписатьНаСервере()

	ДеревоНастроек = ДанныеФормыВЗначение(СписокНастроек, Тип("ДеревоЗначений"));
	
	НаборЗаписей = РегистрыСведений.ПерсональныеНастройки.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Пользователь.Установить(ТекущийПользователь);
	ЗаписатьНаСервереРекурсивно(ДеревоНастроек, НаборЗаписей);
	НаборЗаписей.Записать(Истина);

КонецПроцедуры // ЗаписатьНаСервере()

// Обходит дерево значений и добавляет настройки и значения в результирующий набор записей
//
// Параметры
//  ДеревоНастроек  - ДеревоЗначений - Дерево настроек
//  НаборЗаписей  - РегистрСведенийНаборЗаписей - результирующий набор записей регистра
//
&НаСервере
Процедура ЗаписатьНаСервереРекурсивно(ДеревоНастроек, НаборЗаписей)

	Для каждого ТекСтрока Из ДеревоНастроек.Строки Цикл
	
		Если ТекСтрока.ЭтоГруппа Тогда
		
			ЗаписатьНаСервереРекурсивно(ТекСтрока, НаборЗаписей);
			
		Иначе
			
			НовЗапись = НаборЗаписей.Добавить();
			НовЗапись.Пользователь = ТекущийПользователь;
			НовЗапись.Настройка = ТекСтрока.Настройка;
			НовЗапись.ЗначениеНастройки = ТекСтрока.ЗначениеНастройки;
			
		КонецЕсли; 
	
	КонецЦикла; 

КонецПроцедуры // ЗаписатьНаСервереРекурсивно()

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ПравоДоступа("Изменение", Метаданные.Справочники.Пользователи) Тогда
		Элементы.Декорация1.Видимость = Истина;
		Элементы.ГруппаНастройкиРазрешены.Видимость = Ложь;
		Возврат;
	ИначеЕсли НЕ (РольДоступна(Метаданные.роли.ПолныеПрава) ИЛИ РольДоступна(Метаданные.Роли.ДобавлениеИзменениеПользователей)) Тогда
		Элементы.ТекущийПользователь.ТолькоПросмотр = Истина;
	КонецЕсли;
	Если Параметры.Отбор.Свойство("Пользователь") Тогда
		ТекущийПользователь = Параметры.Отбор.Пользователь;
	ИначеЕсли Параметры.Свойство("ТекущийПользователь") Тогда
		ТекущийПользователь = Параметры.ТекущийПользователь;
	КонецЕсли; 
	Если Не ЗначениеЗаполнено(ТекущийПользователь) Тогда
		Элементы.ТекущийПользователь.РедактированиеТекста = Ложь;
		Элементы.ТекущийПользователь.КнопкаВыбора = Ложь;
		Элементы.ТекущийПользователь.КнопкаОчистки = Ложь;
		
		ТекущийПользователь = ВнешниеПользователи.ТекущийВнешнийПользователь();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущийПользователь) Тогда
		Пользователи.ТекущийПользователь();
	КонецЕсли;
	ЗаполнитьЗначенияНастроек();
	
	//ТолькоПросмотр = НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ПерсональныеНастройки);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура ТекущийПользовательПриИзменении(Элемент)
	ЗаполнитьЗначенияНастроек();
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ СписокНастроек

&НаКлиенте
Процедура СписокНастроекПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	СтруктураНастроек = Неопределено;
	
	ПолучитьСтруктуруНастроек(СтруктураНастроек);
	Если Элемент.ТекущиеДанные.Настройка=СтруктураНастроек.ОсновнаяОрганизация Тогда
		Элементы.СписокНастроекЗначениеНастройки.ОграничениеТипа = ПолучитьОписаниеТипов("СправочникСсылка.Организации");
	ИначеЕсли Элемент.ТекущиеДанные.Настройка=СтруктураНастроек.ОсновноеПодразделение Тогда
		Элементы.СписокНастроекЗначениеНастройки.ОграничениеТипа = ПолучитьОписаниеТипов("СправочникСсылка.Подразделения");
	ИначеЕсли Элемент.ТекущиеДанные.Настройка=СтруктураНастроек.ОсновнойИФО Тогда
		Элементы.СписокНастроекЗначениеНастройки.ОграничениеТипа = ПолучитьОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНастроекЗначениеНастройкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = НЕ Элементы.СписокНастроек.ТекущиеДанные.ЭтоГруппа; 
КонецПроцедуры

&НаКлиенте
Процедура СписокНастроекПередНачаломИзменения(Элемент, Отказ)
	Отказ = Элемент.ТекущиеДанные.ЭтоГруппа;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура Записать(Команда)
	ЗаписатьНаСервере();
КонецПроцедуры

