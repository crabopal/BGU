// Определяет основное правило заполнения
// Основное правило используется по умолчанию при заполнении отчета
//
// Параметры:
//  ВидОтчета - Ссылка на вид отчета
//
// Возвращаемое значение:
//  ПравилоЗаполнения - Ссылка на правило заполнения
//  Неопределено - Основное правило заполнения не задано
//
Функция ПолучитьОсновноеПравило(Знач ВидОтчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ОсновныеПравилаЗаполнения.ПравилоЗаполнения КАК ПравилоЗаполнения
	|ИЗ
	|	РегистрСведений.ОсновныеПравилаЗаполнения КАК ОсновныеПравилаЗаполнения
	|ГДЕ
	|	ОсновныеПравилаЗаполнения.ВидОтчета = &ВидОтчета";
	
	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.ПравилоЗаполнения;
		
	КонецЕсли;
	
КонецФункции

// Устанавливает переданное правило заполнения в качестве основного для вида отчета владельца
// Основное правило используется по умолчанию при заполнении отчета
//
// Параметры:
//  ПравилоЗаполнения - Ссылка на правило заполнения
//
// Возвращаемое значение:
//  Нет
//
Процедура НазначитьПравилоЗаполнения(Знач ПравилоЗаполнения) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.ОсновныеПравилаЗаполнения.СоздатьМенеджерЗаписи();
	
	Если ТипЗнч(ПравилоЗаполнения) = Тип("СправочникСсылка.ПравилаЗаполнения") И ЗначениеЗаполнено(ПравилоЗаполнения) Тогда
		
		ВидОтчета =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПравилоЗаполнения, "Владелец");
		
		МенеджерЗаписи.ВидОтчета = ВидОтчета;
		МенеджерЗаписи.ПравилоЗаполнения = ПравилоЗаполнения;
		
	КонецЕсли;
	
	МенеджерЗаписи.Записать(Истина);
	
КонецПроцедуры

// Назначает переданное правило заполнения в качестве дополнительного
// Дополнительное правило заполнения не используется по умолчанию при заполнении вида отчета
//
// Параметры:
//  ПравилоЗаполнения - Ссылка на правило заполнения
//
// Возвращаемое значение:
//  Нет
//
Процедура УдалитьОсновноеПравило(Знач ПравилоЗаполнения) Экспорт
	
	Если ТипЗнч(ПравилоЗаполнения) = Тип("СправочникСсылка.ПравилаЗаполнения") И ЗначениеЗаполнено(ПравилоЗаполнения) Тогда
		
		МенеджерЗаписи = РегистрыСведений.ОсновныеПравилаЗаполнения.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ВидОтчета = ПравилоЗаполнения.Владелец;
		МенеджерЗаписи.ПравилоЗаполнения = ПравилоЗаполнения;
		
		МенеджерЗаписи.Удалить();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли