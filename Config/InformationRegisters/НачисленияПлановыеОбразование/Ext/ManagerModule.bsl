Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Регистрация данных к обработке не производится. Все данные выбираются в обработчике
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НачисленияПлановыеОбразование.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ИЗ
	|	РегистрСведений.НачисленияПлановыеОбразование КАК НачисленияПлановыеОбразование
	|ГДЕ
	|	НачисленияПлановыеОбразование.ДоговорКонтрагента = ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)";
	
	Если Запрос.Выполнить().Пустой() Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.НачисленияПлановыеОбразование.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		
		Если ЗначениеЗаполнено(Запись.УдалитьКонтрагент) Тогда
			Запись.Контрагент = Запись.УдалитьКонтрагент;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Запись.УдалитьДоговорКонтрагента) Тогда
			Запись.ДоговорКонтрагента = Запись.УдалитьДоговорКонтрагента;
		КонецЕсли;
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
	Параметры.ОбработкаЗавершена = Истина;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
