#Область ПрограммныйИнтерфейс

Функция ПолучитьСписокКодовЕдиницИзмеренияТС() Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Значение");
	Таблица.Колонки.Добавить("Представление");
	Таблица.Колонки.Добавить("Наименование");
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Значение		= "251";
	НоваяСтрока.Представление	= НСтр("ru='л. с'");
	НоваяСтрока.Наименование	= НСтр("ru = 'Мощность двигателя'");
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Значение		= "999";
	НоваяСтрока.Представление	= НСтр("ru='Кгс'");
	НоваяСтрока.Наименование	= НСтр("ru = 'Сила тяги'");
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Значение		= "181";
	НоваяСтрока.Представление	= НСтр("ru='БРТ'");
	НоваяСтрока.Наименование	= НСтр("ru = 'Валовая вместимость'");
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Значение		= "796";
	НоваяСтрока.Представление	= НСтр("ru='шт'");
	НоваяСтрока.Наименование	= "";
	
	Возврат Таблица;
	
КонецФункции

// Возвращаемое значение:
//   Соответствие - соответствие кода и наименования вида транспортного средства
//
Функция КодыВидовТС(Год) Экспорт

	КодыВидовТС = Новый Соответствие;
	Макет = ПолучитьМакет("СпискиКодов");
	ТекущаяОбласть = ОбластьМакетаАктуальныхВидовТС(Макет, Год);  
	
	Если ТекущаяОбласть <> Неопределено Тогда
	
		Для Ряд = ТекущаяОбласть.Верх По ТекущаяОбласть.Низ Цикл
			КодПоказателя       = СокрП(Макет.Область(Ряд, 1).Текст);
			Если ПустаяСтрока(КодПоказателя) Тогда
				Продолжить;
			Иначе
				КодыВидовТС.Вставить(КодПоказателя, СокрП(Макет.Область(Ряд, 2).Текст));	
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат КодыВидовТС;

КонецФункции

