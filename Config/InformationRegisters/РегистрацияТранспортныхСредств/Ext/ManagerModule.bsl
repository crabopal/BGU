#Область СлужебныеПроцедурыИФункции

Функция ОбластьМакетаАктуальныхВидовТС(Макет, Год)
	
	ТекущийГод = 0;
	ТекущаяОбласть = Неопределено;
	Префикс = "КодВидаТС_";
	ДлинаПрефикса = СтрДлина(Префикс);
	
	Для каждого Область Из Макет.Области Цикл
		
		Если Сред(Область.Имя, 1, ДлинаПрефикса) <> Префикс Тогда
			Продолжить;
		КонецЕсли;
						
		ГодОбласти = Число(Сред(Область.Имя, ДлинаПрефикса + 1, 4));
		
		Если ГодОбласти <= Год
			И ГодОбласти > ТекущийГод Тогда
			
			ТекущийГод = ГодОбласти;
			ТекущаяОбласть = Область;
			
		КонецЕсли;
		
	КонецЦикла; 
			
	Возврат ТекущаяОбласть;
		
КонецФункции	

#КонецОбласти

