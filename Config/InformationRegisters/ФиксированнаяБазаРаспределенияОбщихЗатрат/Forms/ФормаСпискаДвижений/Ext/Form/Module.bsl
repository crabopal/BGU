
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем ТекРегистратор;
	
	Если Параметры.Свойство("Отбор")
		И Параметры.Отбор.Количество() = 1
		И Параметры.Отбор.Свойство("Регистратор", ТекРегистратор)
		И ТипЗнч(ТекРегистратор) = Тип("ДокументСсылка.УстановкаЦенНоменклатуры") Тогда
		
		Элементы.Регистратор.Видимость = Ложь;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Регистратор", ТекРегистратор,,, Истина);
		
	КонецЕсли;
	
КонецПроцедуры
