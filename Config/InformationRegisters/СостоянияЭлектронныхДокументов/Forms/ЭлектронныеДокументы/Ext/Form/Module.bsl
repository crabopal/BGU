
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	УчетныйДокумент = Параметры.УчетныйДокумент;
	
	// Запрет создания формы, если документ уже обрабатывается при помощи внутреннего ЭДО БЭД
	Если ВнутреннийЭДО.ДокументОбрабатываетсяВнутреннимЭДОБЭД(УчетныйДокумент) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ПараметрыУчетногоДокумента = ВнутреннийЭДО.ПараметрыУчетногоДокумента(УчетныйДокумент);
	
	ИдентификаторДокумента = ПараметрыУчетногоДокумента.ИдентификаторДокумента;
	НомерДокумента = ПараметрыУчетногоДокумента.НомерДокумента;
	ДатаДокумента = ПараметрыУчетногоДокумента.ДатаДокумента;
	Организация = ПараметрыУчетногоДокумента.Организация;
	
	СообщениеНетНастроенныхФорм = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Для документа ""%1"" не настроено использование внутреннего документооборота ни для одной печатной формы'"),
		ИдентификаторДокумента);
	
	ЗаполнитьТаблицуЭлектронныхДокументов();
	
	УправлениеВидимостьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД() Тогда
		
		ЗаполнитьТаблицуЭлектронныхДокументов();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЭлектронныеДокументы

&НаКлиенте
Процедура ЭлектронныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	ПараметрыДокумента = ВнутреннийЭДОКлиентСервер.ПараметрыОткрытияЭлектронногоДокумента();
	
	ПараметрыДокумента.Организация = Организация;
	ПараметрыДокумента.УчетныйДокумент = УчетныйДокумент;
	ПараметрыДокумента.ВидДокумента = ТекущиеДанные.ВидДокумента;
	ПараметрыДокумента.НомерДокумента = НомерДокумента;
	ПараметрыДокумента.ДатаДокумента = ДатаДокумента;
	ПараметрыДокумента.ИдентификаторДокумента = ИдентификаторДокумента;
	ПараметрыДокумента.ЭлектронныйДокумент = ТекущиеДанные.ЭлектронныйДокумент;
	ПараметрыДокумента.ИдентификаторКомандыПечати = ТекущиеДанные.ИдентификаторКомандыПечати;
	
	ВнутреннийЭДОКлиент.ОткрытьФормуЭлектронногоДокумента(ПараметрыДокумента);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НастроитьВнутреннийЭДО(Команда)
	
	ПараметрыНастройки = Новый Структура;
	ПараметрыНастройки.Вставить("Организация", Организация);
	ПараметрыНастройки.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
	
	ОткрытьФорму("РегистрСведений.НастройкиВнутреннегоЭДОБГУ.Форма.НастройкаВнутреннегоЭДО", ПараметрыНастройки);
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуЭлектронныхДокументов()
	
	Таблица = РеквизитФормыВЗначение("ЭлектронныеДокументы");
	Таблица.Очистить();
	
	ЗаполненныеИдентификаторы = Новый Соответствие;
	
	МетаданныеОбъекта = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	
	ОбъектыСоСпециальнымиКомандамиПечати = ВнутреннийЭДОПереопределяемый.ОбъектыСоСпециальнымиКомандамиПечати();
	
	Если ОбъектыСоСпециальнымиКомандамиПечати[ТипЗнч(УчетныйДокумент)] <> Неопределено Тогда
		КомандыПечати = ОбъектыСоСпециальнымиКомандамиПечати[ТипЗнч(УчетныйДокумент)];
	Иначе
		КомандыПечати = ВнутреннийЭДО.КомандыПечатиОбъекта(МетаданныеОбъекта);
	КонецЕсли;
	
	ТаблицаКомандПечатиИсключений = ВнутреннийЭДО.ПодготовитьТаблицуИсключенийКомандПечати();
	ВнутреннийЭДОПереопределяемый.ПриЗаполненииТаблицыИсключенийКомандПечатиЭДО(ТаблицаКомандПечатиИсключений);
	
	Для Каждого Строка Из ВнутреннийЭДО.ЭлектронныеДокументыАктуальные(УчетныйДокумент) Цикл
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.ОжидаемоеДействие = ОжидаемоеДействиеПоСостояниюДокумента(НоваяСтрока.Состояние);
		ЗаполненныеИдентификаторы.Вставить(Строка.ИдентификаторКомандыПечати, Истина);
	КонецЦикла;
	
	Для Каждого Строка Из ВнутреннийЭДО.ЭлектронныеДокументыИзНастройки(Организация, ИдентификаторДокумента) Цикл
		
		Если ЗаполненныеИдентификаторы[Строка.ИдентификаторКомандыПечати] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		КомандаПечати = ВнутреннийЭДО.КомандаПечатиПоИдентификатору(КомандыПечати, Строка.ИдентификаторКомандыПечати);
		Если КомандаПечати = Неопределено
			ИЛИ НЕ ВнутреннийЭДО.КомандаПечатиПодходитПоУсловиям(КомандаПечати, УчетныйДокумент) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеПустойСсылки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторДокумента, "ЗначениеПустойСсылки");
		СтруктураОтбора = Новый Структура;  
		СтруктураОтбора.Вставить("УчетныйДокумент", ЗначениеПустойСсылки);  
		СтруктураОтбора.Вставить("ИдентификаторКомандыПечати", КомандаПечати.Идентификатор);  
		
		КомандаПечатиИсключение = ТаблицаКомандПечатиИсключений.НайтиСтроки(СтруктураОтбора);
		
		Если КомандаПечатиИсключение.Количество() > 0  Тогда
			Продолжить;			
		КонецЕсли;
		
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.ОжидаемоеДействие = ОжидаемоеДействиеПоСостояниюДокумента(НоваяСтрока.Состояние);
		
		Если ЗначениеЗаполнено(КомандаПечати) Тогда
			НоваяСтрока.ВидДокумента = КомандаПечати.Представление;
			НоваяСтрока.ПредставлениеДокумента = ВнутреннийЭДОКлиентСервер.ПредставлениеДокументаПоСвойствам(
				Новый Структура("ВидДокумента, ДатаДокумента, НомерДокумента",
					НоваяСтрока.ВидДокумента, ДатаДокумента, НомерДокумента));
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Таблица, "ЭлектронныеДокументы");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОжидаемоеДействиеПоСостояниюДокумента(Состояние)
	
	ОжидаемоеДействие = "";
	
	Если Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.НеНачат") Тогда
		ОжидаемоеДействие = НСтр("ru = 'Сформировать'");
	ИначеЕсли Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание") Тогда
		ОжидаемоеДействие = НСтр("ru = 'Подписать'");
	КонецЕсли;
	
	Возврат ОжидаемоеДействие;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ЭлектронныеДокументыОжидаемоеДействие");
	
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭлектронныеДокументы.ОжидаемоеДействие");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ЭлектронныеДокументыСостояние");
	
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭлектронныеДокументы.ОжидаемоеДействие");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура УправлениеВидимостьюЭлементовФормы()
	
	ВидимостьЭлектронныхДокументов = ЭлектронныеДокументы.Количество() > 0;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЭлектронныеДокументы", "Видимость", ВидимостьЭлектронныхДокументов);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "СообщениеНетНастроенныхФорм", "Видимость", НЕ ВидимостьЭлектронныхДокументов);
		
	ВидимостьКнопкиНастройка = НЕ ВидимостьЭлектронныхДокументов
		И ПравоДоступа("Редактирование", Метаданные.РегистрыСведений.НастройкиВнутреннегоЭДОБГУ);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "НастроитьВнутреннийЭДО", "Видимость", ВидимостьКнопкиНастройка);
	
КонецПроцедуры

#КонецОбласти
