// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Документ.Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьРегистр() Экспорт
	
	СписокТипов = СписокТиповДокументов();
	
	Для Сч = 1 По СписокТипов.Количество() Цикл
		
		ТекстЗапроса = ТекстЗапросаТипаДокумента(СписокТипов[Сч-1]);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Запись = РегистрыСведений.ОсновноеСредствоДокумента.СоздатьМенеджерЗаписи();
			Запись.Документ = Выборка.Ссылка;
			Запись.ОсновноеСредство = Выборка.ОсновноеСредство;
			Запись.ИнвентарныйНомер = Выборка.ИнвентарныйНомер;
			
			Запись.Записать();
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СписокТиповДокументов()
	
	ТипыДокументов = Метаданные.ПодпискиНаСобытия.ЗаполнитьОсновноеСредствоДокумента.Источник.Типы();
	
	СписокТипов = Новый Массив;
	
	Для Каждого ТипДокумента Из ТипыДокументов Цикл
		ИмяДокумента = Метаданные.НайтиПоТипу(ТипДокумента).Имя;
		СписокТипов.Добавить(ИмяДокумента);
	КонецЦикла;
	
	Возврат СписокТипов;
	
КонецФункции

Функция ТекстЗапросаТипаДокумента(ИмяДокумента, Ограничить = Ложь)
	
	ИмяТаблицы		= "ОсновныеСредства";
	ИмяПоляОС		= "ОсновноеСредство";
	
	ЕстьИнвНомер = Истина;
	
	Если ИмяДокумента = "ПереносВложенийВНФА" Тогда
		ИмяТаблицы	= "КапитальныеВложения";
		ИмяПоляОС	= "ВнеоборотныйАктив";
		ЕстьИнвНомер = Ложь;
	ИначеЕсли ИмяДокумента = "ИнвентаризацияОС" Тогда
		ИмяТаблицы	= "Инвентаризация";
	ИначеЕсли ИмяДокумента = "ПринятиеКУчетуПравПользованияОС"
		Или ИмяДокумента = "ВнутреннееПеремещениеОбъектовПравПользованияОС" Тогда
		ЕстьИнвНомер = Ложь;
	ИначеЕсли ИмяДокумента = "НачислениеАмортизацииПравПользованияОС"
		Или ИмяДокумента = "ПрекращениеПравПользованияОС" Тогда
		ИмяТаблицы	= "ПраваПользования";
		ЕстьИнвНомер = Ложь;
	ИначеЕсли ИмяДокумента = "ПоступлениеОС"
		Или ИмяДокумента = "ПоступлениеОСИК"
		Или ИмяДокумента = "ПоступлениеОСВПути" Тогда
		ИмяТаблицы	= "КапВложения";
		ИмяПоляОС	= "ВнеоборотныйАктив";
		ЕстьИнвНомер = Ложь;
	ИначеЕсли ИмяДокумента = "ИзменениеПараметровАмортизации" Тогда
		ЕстьИнвНомер = Ложь;
	ИначеЕсли ИмяДокумента = "РегистрацияСпособаРаспределенияНалогаПоИсточникамФинансирования" Тогда
		ЕстьИнвНомер = Ложь;
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьНФА" Тогда
		ИмяТаблицы	= "Раздел21";
		ИмяПоляОС	= "НФА";
	ИначеЕсли ИмяДокумента = "ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный" Тогда
		ИмяТаблицы	= "ИнвентарныеНомера";
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаОС.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТаблицаОС.&ИмяПоляОС) КАК КоличествоОС,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТаблицаОС.ИнвентарныйНомер) КАК КоличествоИнвНомеров
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.&ИмяДокумента.&ИмяТаблицы КАК ТаблицаОС
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаОС.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Док.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(ТаблицаОС.&ИмяПоляОС, &ПустоеОС) КАК ОсновноеСредство,
	|	ЕСТЬNULL(ТаблицаОС.ИнвентарныйНомер, &ПустойНомер) КАК ИнвентарныйНомер
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|		ПО Док.Ссылка = ВТ.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновноеСредствоДокумента КАК ОсновноеСредствоДокумента
	|		ПО Док.Ссылка = ОсновноеСредствоДокумента.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.&ИмяДокумента.&ИмяТаблицы КАК ТаблицаОС
	|		ПО Док.Ссылка = ТаблицаОС.Ссылка
	|			И (ТаблицаОС.НомерСтроки = 1)
	|ГДЕ
	|	(ЕСТЬNULL(ВТ.КоличествоОС, 0) <= 1
	|				И ОсновноеСредствоДокумента.Документ ЕСТЬ NULL
	|			ИЛИ ЕСТЬNULL(ВТ.КоличествоИнвНомеров, 0) = 1
	|				И ЕСТЬNULL(ОсновноеСредствоДокумента.ИнвентарныйНомер, &ПустойНомер) = &ПустойНомер
	|				И ЕСТЬNULL(ТаблицаОС.ИнвентарныйНомер, &ПустойНомер) <> &ПустойНомер)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяДокумента", ИмяДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТаблицы", ИмяТаблицы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяПоляОС", ИмяПоляОС);
	
	Если Не Ограничить Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПЕРВЫЕ 1000", "");
	КонецЕсли;
	
	Если Не ЕстьИнвНомер Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТаблицаОС.ИнвентарныйНомер)", "2");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаОС.ИнвентарныйНомер", "&ПустойНомер");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПустоеОС", "ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПустойНомер", "ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)");
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#КонецЕсли
