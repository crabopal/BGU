#Область СлужебныеПроцедурыИФункции
    
Функция ЗаписьИзмененийНевозможна(Организация, РедакцияПС) Экспорт
	
	Если РедакцияПС = ПредопределенноеЗначение("Перечисление.РедакцииПланаСчетов.Приказ64н2018") Тогда
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПереносОстатков64нНФА.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПереносОстатков64нНФА КАК ПереносОстатков64нНФА
		|ГДЕ
		|	ПереносОстатков64нНФА.Организация = &Организация
		|	И ПереносОстатков64нНФА.Проведен = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПереносОстатков64нРасчеты.Ссылка
		|ИЗ
		|	Документ.ПереносОстатков64нРасчеты КАК ПереносОстатков64нРасчеты
		|ГДЕ
		|	ПереносОстатков64нРасчеты.Организация = &Организация
		|	И ПереносОстатков64нРасчеты.Проведен = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПереносОстатков64нКЭК.Ссылка
		|ИЗ
		|	Документ.ПереносОстатков64нКЭК КАК ПереносОстатков64нКЭК
		|ГДЕ
		|	ПереносОстатков64нКЭК.Организация = &Организация
		|	И ПереносОстатков64нКЭК.Проведен = ИСТИНА");		
		
		Запрос.УстановитьПараметр("Организация", Организация);
		
		Возврат НЕ Запрос.Выполнить().Пустой();
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#КонецОбласти 

#КонецЕсли