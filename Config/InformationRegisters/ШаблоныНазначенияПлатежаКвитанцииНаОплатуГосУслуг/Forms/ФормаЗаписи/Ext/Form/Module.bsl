
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ Параметры.Ключ.Пустой() И НЕ ЗначениеЗаполнено(Запись.Номенклатура) Тогда
		ЭтоОсновнойШаблон = Истина;
	КонецЕсли;
	Элементы.Номенклатура.Доступность = НЕ ЭтоОсновнойШаблон;
	ИсходнаяНоменклатура = Параметры.Ключ.Номенклатура;
КонецПроцедуры

&НаКлиенте
Процедура ЭтоОсновнойШаблонПриИзменении(Элемент)
	Если ЭтоОсновнойШаблон Тогда 
		Запись.Номенклатура = Неопределено;
	Иначе
		ОчиститьСообщения();
		Если НЕ Параметры.Ключ.Пустой() И НЕ ЗначениеЗаполнено(ИсходнаяНоменклатура) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не рекомендуется устанавливать номенклатуру для записи, содержащей настройку основного шаблона заполнения.
			|Если в системе не будет записи с настройкой для основного шаблона заполнения, при работе могут возникать ошибки.'"));
		КонецЕсли;
	КонецЕсли;
	Элементы.Номенклатура.Доступность = НЕ ЭтоОсновнойШаблон;
КонецПроцедуры
