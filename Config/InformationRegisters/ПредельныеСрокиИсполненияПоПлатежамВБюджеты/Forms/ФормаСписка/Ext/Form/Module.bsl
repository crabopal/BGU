
&НаСервере
Функция ЗагрузитьИзФайлаНаСервере(ИмяФайла)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.Прочитать(ИмяФайла);
	
	ЗагруженоЗаписей = РегистрыСведений.ПредельныеСрокиИсполненияПоПлатежамВБюджеты.ЗагрузитьИзМакета(ТабДокумент);
	
	Возврат ЗагруженоЗаписей;
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	
	// Выбор файла для загрузки.
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок					= НСтр("ru = 'Выберите файл макета'");
	Диалог.ПредварительныйПросмотр  	= Ложь;
	Диалог.Фильтр   					= НСтр("ru = 'Файл макета (*.mxl)|*.mxl'");
	Диалог.Расширение   				= "mxl";
	Диалог.ПроверятьСуществованиеФайла  = Истина;
	Диалог.МножественныйВыбор			= Ложь;
	Если Диалог.Выбрать() Тогда
		
		ЗагруженоЗаписей = ЗагрузитьИзФайлаНаСервере(Диалог.ПолноеИмяФайла);
		
		ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Загрузка завершена. Загружено записей: %1'"), ЗагруженоЗаписей);
		ПоказатьПредупреждение(, ТекстПредупреждения);
		
		Элементы.Список.Обновить();
		
	КонецЕсли;
	
КонецПроцедуры
