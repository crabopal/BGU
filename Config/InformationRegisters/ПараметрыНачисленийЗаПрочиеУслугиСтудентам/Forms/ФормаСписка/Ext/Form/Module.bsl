
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("НачислениеСтудентамЗаПрочиеУслуги", ОтборНачисление);
	Параметры.Свойство("СтавкаОплаты", ОтборСтавкаОплаты);
	Параметры.Свойство("ГрафикОплаты", ОтборГрафикОплаты);
	
	Если ЗначениеЗаполнено(ОтборНачисление) Тогда
		Элементы.ОтборНачисление.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	УстановитьОтборПоНачислению();
	УстановитьОтборПоСтавкеОплаты();
	УстановитьОтборПоГрафикуОплаты();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтборНачислениеПриИзменении(Элемент)
	УстановитьОтборПоНачислению();
КонецПроцедуры

&НаКлиенте
Процедура ОтборСтавкаОплатыПриИзменении(Элемент)
	УстановитьОтборПоСтавкеОплаты();
КонецПроцедуры

&НаКлиенте
Процедура ОтборГрафикОплатыПриИзменении(Элемент)
	УстановитьОтборПоГрафикуОплаты();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборПоНачислению()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "НачислениеСтудентамЗаПрочиеУслуги", ОтборНачисление,
		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ОтборНачисление));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НачислениеСтудентамЗаПрочиеУслуги", "Видимость", Не ЗначениеЗаполнено(ОтборНачисление));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоСтавкеОплаты()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "СтавкаОплаты", ОтборСтавкаОплаты,
		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ОтборСтавкаОплаты));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтавкаОплаты", "Видимость", Не ЗначениеЗаполнено(ОтборСтавкаОплаты));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоГрафикуОплаты()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ГрафикОплаты", ОтборГрафикОплаты,
		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(ОтборГрафикОплаты));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГрафикОплаты", "Видимость", Не ЗначениеЗаполнено(ОтборГрафикОплаты));
	
КонецПроцедуры


#КонецОбласти