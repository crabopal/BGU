
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ПравоДоступа("Редактирование", Метаданные.РегистрыСведений.ИсключенияОтображенияДатыПодписанияВШтампе) Тогда
		Элементы.СписокОрганизаций.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ЗаполнитьСписокПоРегиструИсключений();
	ПредупреждениеПриЗакрытии = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокОрганизаций

&НаКлиенте
Процедура СписокОрганизацийПриИзменении(Элемент)
	
	ПредупреждениеПриЗакрытии = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	
	ЗаписатьНаСервере();
	
	ПредупреждениеПриЗакрытии = Ложь;
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокПоРегиструИсключений()
	
	СписокОрганизаций.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсключенияОтображенияДатыПодписанияВШтампе.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.ИсключенияОтображенияДатыПодписанияВШтампе КАК ИсключенияОтображенияДатыПодписанияВШтампе";
	
	ОрганизацииИсключения = Запрос.Выполнить().Выгрузить();
	
	Если ОрганизацииИсключения.Количество() Тогда
		СписокОрганизаций.ЗагрузитьЗначения(ОрганизацииИсключения.ВыгрузитьКолонку("Организация"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()
	
	Если НЕ ПравоДоступа("Редактирование", Метаданные.РегистрыСведений.ИсключенияОтображенияДатыПодписанияВШтампе) Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныеОрганизации = Новый ТаблицаЗначений;
	ВыбранныеОрганизации.Колонки.Добавить("Организация");
	
	Для Каждого ВыбраннаяОрганизация Из СписокОрганизаций Цикл 
		НоваяСтрока = ВыбранныеОрганизации.Добавить();
		НоваяСтрока.Организация = ВыбраннаяОрганизация.Значение;
	КонецЦикла;
	ВыбранныеОрганизации.Свернуть("Организация");
	
	НаборЗаписей = РегистрыСведений.ИсключенияОтображенияДатыПодписанияВШтампе.СоздатьНаборЗаписей();
	Для Каждого СтрокаОрганизации Из ВыбранныеОрганизации Цикл 
		Если ЗначениеЗаполнено(СтрокаОрганизации.Организация) Тогда
			НоваяЗапись = НаборЗаписей.Добавить(); 
			НоваяЗапись.Организация = СтрокаОрганизации.Организация;
		КонецЕсли;
	КонецЦикла;
	НаборЗаписей.Записать();
	
	ЗаполнитьСписокПоРегиструИсключений();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы ИЛИ Не ПредупреждениеПриЗакрытии Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	ПоказатьВопрос(
		Новый ОписаниеОповещения("ВопросПередЗакрытиемЗавершение", ЭтотОбъект),
		НСтр("ru = 'Сохранить изменения в списке организаций?'"),
		РежимДиалогаВопрос.ДаНет,
		,
		КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаписатьНаСервере();
	КонецЕсли;
	
	ПредупреждениеПриЗакрытии = Ложь;
	Закрыть();
	
КонецПроцедуры

#КонецОбласти