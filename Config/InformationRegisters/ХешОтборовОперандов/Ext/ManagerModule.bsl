#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Если ПланыОбмена.ГлавныйУзел()<>Неопределено Тогда
		//обработчик должен выполняться только в главном узле, поэтому регистрируем объекты только в главном
		Возврат;
	КонецЕсли;
	
	// Заполнение регистра ХешОтборовОперандов.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперандыПоказателей.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХешОтборовОперандов КАК ХешОтборовОперандов
	|		ПО ХешОтборовОперандов.Операнд = ОперандыПоказателей.Ссылка
	|ГДЕ
	|	ХешОтборовОперандов.Операнд ЕСТЬ NULL";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Справочник.ОперандыПоказателей";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	СоответствиеОперандов = Новый Соответствие;
	МассивОперандов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
			// Вероятно был удален раньше, чем обработчик дошел до него
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		МассивОперандов.Добавить(Выборка.Ссылка);
		СоответствиеОперандов.Вставить(Выборка.Ссылка,Ложь);		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОперандыПоказателейПравилаВычисленияПараметров.Операнд КАК Операнд,
		|	ОперандыПоказателейПравилаВычисленияПараметров.ИмяПараметра КАК ИмяПараметра,
		|	ОперандыПоказателейПравилаВычисленияПараметров.СпособВычисленияПараметра КАК СпособВычисленияПараметра,
		|	ОперандыПоказателейПравилаВычисленияПараметров.УточнениеСпособаОпределения КАК УточнениеСпособаОпределения,
		|	ОперандыПоказателейПравилаВычисленияПараметров.ВидАналитикиОтбор КАК ВидАналитикиОтбор,
		|	ОперандыПоказателейПравилаВычисленияПараметров.РеквизитАналитики КАК РеквизитАналитики
		|ИЗ
		|	РегистрСведений.ОперандыПоказателейПравилаВычисленияПараметров КАК ОперандыПоказателейПравилаВычисленияПараметров
		|ГДЕ
		|	ОперандыПоказателейПравилаВычисленияПараметров.Операнд В(&МассивОперандов)";
	
	Запрос.УстановитьПараметр("МассивОперандов", МассивОперандов);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВсяТаблица = РезультатЗапроса.Выгрузить();
	
	ТабОперандов = ВсяТаблица.Скопировать(,"Операнд");
	ТабОперандов.Свернуть("Операнд");
	ВсяТаблица.Индексы.Добавить("Операнд");
	
	Для Каждого СтрОперанда Из ТабОперандов Цикл
		
		НачатьТранзакцию();
		
		Попытка
		
			ТаблицаДляОбработки = ВсяТаблица.Скопировать(Новый Структура("Операнд",СтрОперанда.Операнд));
			РегистрыСведений.ОперандыПоказателейПравилаВычисленияПараметров.ЗаписатьХешОтборовОперанда(ТаблицаДляОбработки, Истина);
			ЗафиксироватьТранзакцию();
		    ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СтрОперанда.Операнд);
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать хеш отборов операнда: %Операнд% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Операнд%", СтрОперанда.Операнд);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Справочники.ОперандыПоказателей,
				СтрОперанда.Операнд,
				ТекстСообщения);
			//ВызватьИсключение; 
			//исключение не вызываем, если не удалось записать хеш, это не критично
			
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СтрОперанда.Операнд);//не записали хеш, не страшно
		КонецПопытки;
		
		СоответствиеОперандов.Вставить(СтрОперанда.Операнд,Истина);
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из СоответствиеОперандов Цикл
		Если КлючИЗначение.Значение = Ложь Тогда
			//в РС ОперандыПоказателейПравилаВычисленияПараметров для операнда нет записей (в идеале такого быть не должно),
			//поэтому в цикле выше он не обработан, отметим тут, что обработка завершена
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли