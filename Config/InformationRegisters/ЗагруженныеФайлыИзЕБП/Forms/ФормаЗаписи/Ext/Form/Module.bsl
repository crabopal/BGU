#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТолькоПросмотр = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура СохранитьФайл(Команда)
	ОписаниеФайла = СохранитьФайлНаСервере();
	
	Если ОписаниеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Диалог = Новый ПараметрыДиалогаПолученияФайлов;
	Диалог.ВыборКаталога = Истина;
	ПолучитьФайлССервераАсинх(ОписаниеФайла.Адрес,ОписаниеФайла.ИмяФайла,Диалог);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СохранитьФайлНаСервере()
	ТекЗапись = РеквизитФормыВЗначение("Запись");
	ДДФайла = ТекЗапись.ДвоичныеДанныеФайла.Получить();
	
	ОписаниеФайла = Новый Структура;
	ОписаниеФайла.Вставить("ИмяФайла", ТекЗапись.ИмяФайла+"."+ТекЗапись.Расширение);
	ОписаниеФайла.Вставить("Адрес", ПоместитьВоВременноеХранилище(ДДФайла,УникальныйИдентификатор));		
		
	Возврат ОписаниеФайла;
КонецФункции

#КонецОбласти
