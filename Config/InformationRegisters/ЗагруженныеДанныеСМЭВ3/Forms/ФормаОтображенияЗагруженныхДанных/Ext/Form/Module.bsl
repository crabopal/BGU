
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
			
	Запрос = Новый Запрос;
	
	Если ЗначениеЗаполнено(Параметры.ЗапросСМЭВ) Тогда

	    Запрос.УстановитьПараметр("ЗапросКСМЭВ", Параметры.ЗапросСМЭВ);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ЗагруженныеДанныеСМЭВ3.ЗагруженныйОбъект КАК Док,
			|	МАКСИМУМ(ЗагруженныеДанныеСМЭВ3.БылИзменен) КАК БылИзменен
			|ИЗ
			|	РегистрСведений.ЗагруженныеДанныеСМЭВ3 КАК ЗагруженныеДанныеСМЭВ3
			|ГДЕ
			|	ЗагруженныеДанныеСМЭВ3.ЗапросКСМЭВ = &ЗапросКСМЭВ
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗагруженныеДанныеСМЭВ3.ЗагруженныйОбъект";
		
	ИначеЕсли ЗначениеЗаполнено(Параметры.УИДНастройкиОбщегоЗапроса) Тогда
		Запрос.УстановитьПараметр("УИДНастройкиОбщегоЗапроса", Параметры.УИДНастройкиОбщегоЗапроса);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДВыполняемогоЗапросаКГИСГМП КАК УИДВыполняемогоЗапросаКГИСГМП
			|ПОМЕСТИТЬ УИДДляОтбора
			|ИЗ
			|	РегистрСведений.ВыполняемыеЗапросыОчередиКГИСГМП КАК ВыполняемыеЗапросыОчередиКГИСГМП
			|ГДЕ
			|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиОбщегоЗапроса = &УИДНастройкиОбщегоЗапроса
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.ЗагруженныйОбъект КАК Док,
			|	МАКСИМУМ(ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.БылИзменен) КАК БылИзменен
			|ИЗ
			|	РегистрСведений.ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3 КАК ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3
			|ГДЕ
			|	ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.УИДВыполняемогоЗапросаКГИСГМП В
			|			(ВЫБРАТЬ
			|				УИДДляОтбора.УИДВыполняемогоЗапросаКГИСГМП
			|			ИЗ
			|				УИДДляОтбора)
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.ЗагруженныйОбъект";
		
	ИначеЕсли ЗначениеЗаполнено(Параметры.УИДНастройкиДетальногоЗапроса) Тогда
		Запрос.УстановитьПараметр("УИДНастройкиДетальногоЗапроса", Параметры.УИДНастройкиДетальногоЗапроса);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДВыполняемогоЗапросаКГИСГМП КАК УИДВыполняемогоЗапросаКГИСГМП
			|ПОМЕСТИТЬ УИДДляОтбора
			|ИЗ
			|	РегистрСведений.ВыполняемыеЗапросыОчередиКГИСГМП КАК ВыполняемыеЗапросыОчередиКГИСГМП
			|ГДЕ
			|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиДетальногоЗапроса = &УИДНастройкиДетальногоЗапроса
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.ЗагруженныйОбъект КАК Док,
			|	МАКСИМУМ(ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.БылИзменен) КАК БылИзменен
			|ИЗ
			|	РегистрСведений.ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3 КАК ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3
			|ГДЕ
			|	ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.УИДВыполняемогоЗапросаКГИСГМП В
			|			(ВЫБРАТЬ
			|				УИДДляОтбора.УИДВыполняемогоЗапросаКГИСГМП
			|			ИЗ
			|				УИДДляОтбора)
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.ЗагруженныйОбъект";
		
	ИначеЕсли ЗначениеЗаполнено(Параметры.УИДВыполняемогоЗапросаКГИСГМП) Тогда
		Запрос.УстановитьПараметр("УИДВыполняемогоЗапросаКГИСГМП", Параметры.УИДВыполняемогоЗапросаКГИСГМП);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДВыполняемогоЗапросаКГИСГМП КАК УИДВыполняемогоЗапросаКГИСГМП
			|ПОМЕСТИТЬ УИДДляОтбора
			|ИЗ
			|	РегистрСведений.ВыполняемыеЗапросыОчередиКГИСГМП КАК ВыполняемыеЗапросыОчередиКГИСГМП
			|ГДЕ
			|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДВыполняемогоЗапросаКГИСГМП = &УИДВыполняемогоЗапросаКГИСГМП
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.ЗагруженныйОбъект КАК Док,
			|	МАКСИМУМ(ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.БылИзменен) КАК БылИзменен
			|ИЗ
			|	РегистрСведений.ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3 КАК ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3
			|ГДЕ
			|	ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.УИДВыполняемогоЗапросаКГИСГМП В
			|			(ВЫБРАТЬ
			|				УИДДляОтбора.УИДВыполняемогоЗапросаКГИСГМП
			|			ИЗ
			|				УИДДляОтбора)
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.ЗагруженныйОбъект";
		
	ИначеЕсли Параметры.ПоПодписке Тогда
		//по подписке выводим документы, загруженные за последние 3-4 месяца
		Запрос.УстановитьПараметр("ЗапросКСМЭВ", Параметры.ЗапросСМЭВ);
		Запрос.УстановитьПараметр("Организация", Параметры.Организация);
		
		ДатаНачала = ДобавитьМесяц(НачалоМесяца(ТекущаяДатаСеанса()),-3);
		ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
		
		Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
		
		ЭтотОбъект.Заголовок = "Загруженные документы по уведомлениям от подписок с "+Формат(ДатаНачала,"ДФ=dd.MM.yyyy")+" по "+Формат(ДатаОкончания,"ДФ=dd.MM.yyyy");
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	СообщенияЗапросаДанныхОчередиСМЭВ3.ИдентификаторСообщенияСМЭВ КАК ИдентификаторСообщенияСМЭВ
			|ПОМЕСТИТЬ НужныеИдентификаторыСообщений
			|ИЗ
			|	РегистрСведений.СообщенияЗапросаДанныхОчередиСМЭВ3 КАК СообщенияЗапросаДанныхОчередиСМЭВ3
			|ГДЕ
			|	СообщенияЗапросаДанныхОчередиСМЭВ3.Организация = &Организация
			|	И СообщенияЗапросаДанныхОчередиСМЭВ3.ДатаЗапроса МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И СообщенияЗапросаДанныхОчередиСМЭВ3.ЕстьДанные
			|	И СообщенияЗапросаДанныхОчередиСМЭВ3.ИдентификаторСообщенияУчастника = """"
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ЗагруженныеДанныеСМЭВ3.ЗагруженныйОбъект КАК Док,
			|	МАКСИМУМ(ЗагруженныеДанныеСМЭВ3.БылИзменен) КАК БылИзменен
			|ИЗ
			|	РегистрСведений.ЗагруженныеДанныеСМЭВ3 КАК ЗагруженныеДанныеСМЭВ3
			|ГДЕ
			|	ЗагруженныеДанныеСМЭВ3.ЗапросКСМЭВ = &ЗапросКСМЭВ
			|	И ИСТИНА В
			|			(ВЫБРАТЬ ПЕРВЫЕ 1
			|				ИСТИНА
			|			ИЗ
			|				НужныеИдентификаторыСообщений КАК ТТ
			|			ГДЕ
			|				ТТ.ИдентификаторСообщенияСМЭВ = ЗагруженныеДанныеСМЭВ3.ИдентификаторСообщения)
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗагруженныеДанныеСМЭВ3.ЗагруженныйОбъект";
		
	Иначе 
		ВызватьИсключение НСтр("ru='Не задан параметр формы по данным которого требуется отображение загруженных данных.'");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ТипНачисленияАЗ = Тип("ДокументСсылка.НачислениеКонтрагентамГИСГМП");
	ТипНачислениеСобственное = Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг");
	ТипПлатежиАЗ = Тип("ДокументСсылка.ПлатежКонтрагентовГИСГМП");
	
	ТипПлатежАН = Тип("ДокументСсылка.ПлатежВОплатуГосуслуг");
	ТипПлатежПодведАН = Тип("ДокументСсылка.ПлатежПодведомственному");
	
	ТипНачисленияПодведАН = Тип("ДокументСсылка.НачислениеОтПодведомственного");
	
	ТипНачисленияПосредника = Тип("ДокументСсылка.НачислениеОтПосредникаГИСГМП");
	
	МассивНачисленийАЗ = Новый Массив;
	МассивНовыхНачАЗ = Новый Массив;
	
	МассивНачисленийСобственных = Новый Массив;
	МассивНовыхНачисленийСобств = Новый Массив;
	
	МассивНачисленийПодведАН = Новый Массив;
	МассивНовыхНачисленийПодведАН = Новый Массив;
	
	МассивПлатежейАЗ = Новый Массив;
	МассивНовыхПлатАЗ = Новый Массив;
	
	МассивПлатежейАН = Новый Массив;
	МассивНовыхПлатежейАН = Новый Массив;
	
	МассивПлатежейПодведАН = Новый Массив;
	МассивНовыхПлатежейПодведАН = Новый Массив;
	
	МассивНачисленийОтПосредника = Новый Массив;
	МассивНовыхНачисленийОтПосредника = Новый Массив;
	
	ЕстьДанные = Ложь;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТипДокументаВыборки = ТипЗнч(ВыборкаДетальныеЗаписи.Док);
		Если ТипДокументаВыборки = ТипНачисленияАЗ Тогда
			МассивНачисленийАЗ.Добавить(ВыборкаДетальныеЗаписи.Док);
			
			Если ВыборкаДетальныеЗаписи.БылИзменен Тогда
				МассивНовыхНачАЗ.Добавить(ВыборкаДетальныеЗаписи.Док);
			КонецЕсли;
			
		ИначеЕсли ТипДокументаВыборки = ТипНачислениеСобственное Тогда
			МассивНачисленийСобственных.Добавить(ВыборкаДетальныеЗаписи.Док);
			
			Если ВыборкаДетальныеЗаписи.БылИзменен Тогда
				МассивНовыхНачисленийСобств.Добавить(ВыборкаДетальныеЗаписи.Док);
			КонецЕсли;
			
		ИначеЕсли ТипДокументаВыборки = ТипПлатежиАЗ Тогда
			МассивПлатежейАЗ.Добавить(ВыборкаДетальныеЗаписи.Док);
			
			Если ВыборкаДетальныеЗаписи.БылИзменен Тогда
				МассивНовыхПлатАЗ.Добавить(ВыборкаДетальныеЗаписи.Док);
			КонецЕсли;
			
		ИначеЕсли ТипДокументаВыборки = ТипПлатежАН Тогда
			МассивПлатежейАН.Добавить(ВыборкаДетальныеЗаписи.Док);
			
			Если ВыборкаДетальныеЗаписи.БылИзменен Тогда
				МассивНовыхПлатежейАН.Добавить(ВыборкаДетальныеЗаписи.Док);
			КонецЕсли;
			
		ИначеЕсли ТипДокументаВыборки = ТипПлатежПодведАН Тогда
			МассивПлатежейПодведАН.Добавить(ВыборкаДетальныеЗаписи.Док);
			
			Если ВыборкаДетальныеЗаписи.БылИзменен Тогда
				МассивНовыхПлатежейПодведАН.Добавить(ВыборкаДетальныеЗаписи.Док);
			КонецЕсли;
			
		ИначеЕсли ТипДокументаВыборки = ТипНачисленияПодведАН Тогда
			МассивНачисленийПодведАН.Добавить(ВыборкаДетальныеЗаписи.Док);
			
			Если ВыборкаДетальныеЗаписи.БылИзменен Тогда
				МассивНовыхНачисленийПодведАН.Добавить(ВыборкаДетальныеЗаписи.Док);
			КонецЕсли;
			
		ИначеЕсли ТипДокументаВыборки = МассивНачисленийОтПосредника Тогда
			МассивНачисленийОтПосредника.Добавить(ВыборкаДетальныеЗаписи.Док);
			
			Если ВыборкаДетальныеЗаписи.БылИзменен Тогда
				МассивНовыхНачисленийОтПосредника.Добавить(ВыборкаДетальныеЗаписи.Док);
			КонецЕсли;
			
		КонецЕсли;
		ЕстьДанные = Истина;
	КонецЦикла;
	
	Если ЕстьДанные = Ложь Тогда
		ТекстСообщения = НСтр("ru='Нет данных для отображения'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(НачисленияСобственные,"ИзмененныеДокументы",МассивНовыхНачисленийСобств,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(НачисленияАЗ,"ИзмененныеДокументы",МассивНовыхНачАЗ,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПлатежиАЗ,"ИзмененныеДокументы",МассивНовыхПлатАЗ,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПлатежиСобственныеАН,"ИзмененныеДокументы",МассивНовыхПлатежейАН,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПлатежиПодведомственнымАН,"ИзмененныеДокументы",МассивНовыхПлатежейПодведАН,Истина);	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(НачисленияПодведомственныхАН,"ИзмененныеДокументы",МассивНовыхНачисленийПодведАН,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(НачисленияОтПосредника,"ИзмененныеДокументы",МассивНовыхНачисленийОтПосредника,Истина);
	
	УстановитьВидимостьСпискаДокументов(МассивНачисленийАЗ,"ГруппаНачисленияАЗ",НачисленияАЗ);
	УстановитьВидимостьСпискаДокументов(МассивНачисленийСобственных,"ГруппаСобственныеНачисления",НачисленияСобственные);
	УстановитьВидимостьСпискаДокументов(МассивНачисленийПодведАН,"ГруппаНачисленияОтПодведомственныхАН",НачисленияПодведомственныхАН);
	УстановитьВидимостьСпискаДокументов(МассивПлатежейАЗ,"ГруппаПлатежиАЗ",ПлатежиАЗ);
	УстановитьВидимостьСпискаДокументов(МассивПлатежейАН,"ГруппаСобственныеПлатежи",ПлатежиСобственныеАН);
	УстановитьВидимостьСпискаДокументов(МассивПлатежейПодведАН,"ГруппаПлатежиПодведомственным",ПлатежиПодведомственнымАН);
	УстановитьВидимостьСпискаДокументов(МассивНачисленийОтПосредника,"ГруппаНачисленияОтПосредника",НачисленияОтПосредника);	
	
	// Печать НачисленияАЗ
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.НачисленияАЗ.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.НачислениеКонтрагентамГИСГМП);
	ПараметрыРазмещения.ПрефиксГрупп = "НачисленияАЗ";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец Печать НачисленияАЗ
	
	// Печать ПлатежиАЗ
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ПлатежиАЗ.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.ПлатежКонтрагентовГИСГМП);
	ПараметрыРазмещения.ПрефиксГрупп = "ПлатежиАЗ";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец Печать ПлатежиАЗ
	
