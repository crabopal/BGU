#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ВсеШтрихкоды = ЭтотОбъект.ВыгрузитьКолонку("Штрихкод");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Штрихкоды.Объект,
	|	Штрихкоды.ИнвентарныйНомер,
	|	Штрихкоды.ТипШтрихкода,
	|	Штрихкоды.Штрихкод
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Штрихкод В(&ВсеШтрихкоды)";
	Запрос.УстановитьПараметр("ВсеШтрихкоды", ВсеШтрихкоды);
	
	Выборка = Запрос.Выполнить().Выгрузить();
	Выборка.Индексы.Добавить("Штрихкод");
	
	ШаблонОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность", "Штрихкод",,,
		НСтр("ru = 'Штрихкод %1 уже записан в базу ранее'"));
	
	Для Каждого НоваяЗапись Из ЭтотОбъект Цикл
		
		СтрокаШтрихкода = Выборка.Найти(НоваяЗапись.Штрихкод, "Штрихкод");
		Если СтрокаШтрихкода <> Неопределено
			И (НоваяЗапись.Объект <> СтрокаШтрихкода.Объект
			Или НоваяЗапись.ИнвентарныйНомер <> СтрокаШтрихкода.ИнвентарныйНомер) Тогда
			
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(ШаблонОшибки, НоваяЗапись.Штрихкод),, "Запись.Штрихкод",, Отказ);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("ИнвентарныйНомер")
		И Не ДанныеЗаполнения.Свойство("Объект")
		И ЗначениеЗаполнено(ДанныеЗаполнения["ИнвентарныйНомер"]) Тогда
		
		ДанныеЗаполнения.Вставить("Объект", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.ИнвентарныйНомер, "ОС"));
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли