
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Параметры.МассивОбъектов) = Тип("Массив") Тогда
		Если Параметры.МассивОбъектов.Количество() = 1 Тогда
			Если ТипЗнч(Параметры.МассивОбъектов[0]) <> Тип("СправочникСсылка.ОсновныеСредства") Тогда
				ВызватьИсключение(НСтр("ru = 'Команда не может быть выполнена для указанного объекта!'"));
			Иначе
				ОсновноеСредство = Параметры.МассивОбъектов[0];
			КонецЕсли;
		Иначе
			Элементы.ОсновноеСредство.Видимость = Ложь;
		КонецЕсли;
		
		ЗаполнитьТаблицуИнвНомеров(Параметры.МассивОбъектов);
	ИначеЕсли ТипЗнч(Параметры.МассивОбъектов) = Тип("Строка")
		И ЭтоАдресВременногоХранилища(Параметры.МассивОбъектов) Тогда
		
		Элементы.ОсновноеСредство.Видимость = Ложь;
		ТаблицаШтрихкодов.Загрузить(ПолучитьИзВременногоХранилища(Параметры.МассивОбъектов));
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОсновноеСредствоПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		ЗаполнитьТаблицуИнвНомеров(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОсновноеСредство));
	Иначе
		ТаблицаШтрихкодов.Очистить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ИмяТаблицыФормы

&НаКлиенте
Процедура ТаблицаШтрихкодовПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаШтрихкодов.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Штрихкод) И НЕ РазрешатьИзменятьСуществующиеШтрихкоды Тогда
		ТекущиеДанные.Пометка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьПометки(Команда)
	ИзменитьПометки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	ИзменитьПометки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ИнвертироватьПометки(Команда)
	ИзменитьПометки(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкиВсемБезШК(Команда)
	ИзменитьПометки(Истина, Истина);
КонецПроцедуры

&НаКлиенте
Процедура СформироватьШК(Команда)
	
	СформироватьШтрихкоды();
	
	Оповестить("ЗаписьШтрихКода", Новый Структура("Объект,ТипШтрихкода",
		ОсновноеСредство, ПредопределенноеЗначение("ПланВидовХарактеристик.ТипыШтрихкодов.EAN13")));
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЭтикеток(Команда)
	
	ОткрытьФорму("Обработка.ПечатьЭтикеток.Форма", Новый Структура("АдресТаблицыОбъектов", ПоместитьВХранилищеТаблицуОбъектов()));
	
КонецПроцедуры

&НаКлиенте
Процедура РазрешатьИзменятьСуществующиеШтрихкодыПриИзменении(Элемент)
	
	Если Не РазрешатьИзменятьСуществующиеШтрихкоды Тогда
		СнятьПометкиСоСтрокСШК();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуИнвНомеров(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ИнвентарныеНомераОС.Ссылка, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА ШтрихКоды1.Штрихкод
	|		ИНАЧЕ ШтрихКоды.Штрихкод
	|	КОНЕЦ КАК Штрихкод,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ИнвентарныеНомераОС.Ссылка, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|				И ЕСТЬNULL(ШтрихКоды1.Штрихкод, """") = """"
	|			ТОГДА ИСТИНА
	|		КОГДА ЕСТЬNULL(ШтрихКоды.Штрихкод, """") = """"
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Пометка
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихКоды
	|			ПО ИнвентарныеНомераОС.Ссылка = ШтрихКоды.ИнвентарныйНомер
	|				И ИнвентарныеНомераОС.ОС = ШтрихКоды.Объект
	|				И (ШтрихКоды.ТипШтрихкода = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ТипыШтрихкодов.EAN13))
	|		ПО ОсновныеСредства.Ссылка = ИнвентарныеНомераОС.ОС
	|			И ОсновныеСредства.Организация = ИнвентарныеНомераОС.Владелец
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихКоды1
	|		ПО ОсновныеСредства.Ссылка = ШтрихКоды1.Объект
	|			И (ЕСТЬNULL(ШтрихКоды1.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))
	|			И (ШтрихКоды1.ТипШтрихкода = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ТипыШтрихкодов.EAN13))
	|ГДЕ
	|	ОсновныеСредства.Ссылка В ИЕРАРХИИ(&МассивОбъектов)
	|	И НЕ ОсновныеСредства.ЭтоГруппа";
	
	Результат = Запрос.Выполнить().Выгрузить();
	ТаблицаШтрихкодов.Загрузить(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьПометки(Пометка = Неопределено, ТолькоБезШК = Ложь)
	
	Для Каждого ТекСтр Из ТаблицаШтрихкодов Цикл
		
		НовоеЗначениеПометки = ?(Пометка = Неопределено, Не ТекСтр.Пометка, Пометка);
		
		Если НовоеЗначениеПометки = Истина Тогда
			Если (ТолькоБезШК Или Не РазрешатьИзменятьСуществующиеШтрихкоды) И ЗначениеЗаполнено(ТекСтр.Штрихкод) Тогда
				НовоеЗначениеПометки = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		ТекСтр.Пометка = НовоеЗначениеПометки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СнятьПометкиСоСтрокСШК()
	
	Для Каждого ТекСтр Из ТаблицаШтрихкодов Цикл
		
		Если ЗначениеЗаполнено(ТекСтр.Штрихкод) Тогда
			ТекСтр.Пометка = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьШтрихкоды(ТолькоПустые = Ложь)
	
	МаксимальныйШтрихкод = Неопределено;
	
	Для Каждого ТекСтр Из ТаблицаШтрихкодов Цикл
		
		Если ТекСтр.Пометка И (Не ТолькоПустые Или ПустаяСтрока(ТекСтр.Штрихкод)) Тогда
			
			Запись					= РегистрыСведений.ШтрихКоды.СоздатьМенеджерЗаписи();
			Запись.Объект			= ТекСтр.ОсновноеСредство;
			Запись.ИнвентарныйНомер	= ТекСтр.ИнвентарныйНомер;
			Запись.ТипШтрихкода		= ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
			Запись.Штрихкод			= РегистрыСведений.ШтрихКоды.СформироватьШтрихКодEAN13(МаксимальныйШтрихКод);
			
			Запись.Записать(Не ТолькоПустые);
			
			ТекСтр.Штрихкод = Запись.Штрихкод;
			МаксимальныйШтрихкод = Запись.Штрихкод;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьВХранилищеТаблицуОбъектов()
	
	Таблица = ТаблицаШтрихкодов.Выгрузить(Новый Структура("Пометка", Истина));
	Таблица.Колонки.Добавить("ТипШтрихкода");
	Таблица.ЗаполнитьЗначения(ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13, "ТипШтрихкода");
	
	Возврат ПоместитьВоВременноеХранилище(Таблица, УникальныйИдентификатор);
	
КонецФункции

#КонецОбласти
