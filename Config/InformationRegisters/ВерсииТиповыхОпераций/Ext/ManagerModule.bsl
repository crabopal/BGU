// Возвращает таблицу дат версий типовых операций. Даты читаются из регистра "ВерсииТиповыхОпераций".
// Если в регистре нет версии для типовой операции, то она берется из макета "ПервоначальныеДатыВерсий"
// регистра "ВерсииПоставляемыхТиповыхОпераций".
// 
// Возвращаемое значение:
// ТаблицаЗначений - Таблица, содержащая колонки:
//					- ИдентификаторДокумента - СправочникСсылка.ИдентификаторыОбъектовМетаданных - документ,
//					- ДатаВерсии - Дата - дата версии типовой операции,
//					- ТиповаяОперация - СправочникСсылка.ТиповыеОперации - Типовая операция.
//
Функция ПрочитатьВерсииТиповыхОпераций() Экспорт
	
	Таблица52 = БухгалтерскиеОперацииПовтИспНаВремяСеанса.ВерсииМакетовТиповыхОпераций52();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица52.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	Таблица52.ДатаВерсии КАК ДатаВерсии
	|ПОМЕСТИТЬ Таблица52
	|ИЗ
	|	&Таблица52 КАК Таблица52
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	МАКСИМУМ(Т.ДатаВерсии) КАК ДатаВерсии,
	|	Т.ТиповаяОперация КАК ТиповаяОперация
	|ИЗ
	|	(ВЫБРАТЬ
	|		Таблица52.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|		Таблица52.ДатаВерсии КАК ДатаВерсии,
	|		ТиповыеОперации.Ссылка КАК ТиповаяОперация
	|	ИЗ
	|		Справочник.ТиповыеОперации КАК ТиповыеОперации
	|			ЛЕВОЕ СОЕДИНЕНИЕ Таблица52 КАК Таблица52
	|			ПО ТиповыеОперации.ИдентификаторДокумента = Таблица52.ИдентификаторДокумента
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВерсииТиповыхОпераций.ИдентификаторДокумента,
	|		ВерсииТиповыхОпераций.ДатаВерсии,
	|		ВерсииТиповыхОпераций.ТиповаяОперация
	|	ИЗ
	|		РегистрСведений.ВерсииТиповыхОпераций КАК ВерсииТиповыхОпераций) КАК Т
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.ИдентификаторДокумента,
	|	Т.ТиповаяОперация";
	Запрос.УстановитьПараметр("Таблица52", Таблица52);
	
	ДанныеРегистра = Запрос.Выполнить().Выгрузить();
	
	Возврат ДанныеРегистра;

КонецФункции

// Записывает дату и время версии типовой операции в регистр сведений "ВерсииТиповыхОпераций".
//
// Параметры:
//  ТиповаяОперация	 - СправочникОбъект.ТиповыеОперации - типовая операция
//  ДатаВерсии		 - Дата - Дата и время версии типовой операции
//
Процедура ЗаписатьВерсиюТиповойОперацииВРегистр(ТиповаяОперация, ДатаВерсии) Экспорт

	Набор = РегистрыСведений.ВерсииТиповыхОпераций.СоздатьНаборЗаписей();
	Набор.Отбор.ТиповаяОперация.Установить(ТиповаяОперация.Ссылка);
	
	Запись = Набор.Добавить();
	Запись.ТиповаяОперация = ТиповаяОперация.Ссылка;
	Запись.ИдентификаторДокумента = ТиповаяОперация.ИдентификаторДокумента;
	Запись.ДатаВерсии = ДатаВерсии;
	
	Набор.Записать(Истина);

КонецПроцедуры

