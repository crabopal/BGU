
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НоваяЗапись = Ложь; 
	
	Если ЗначениеЗаполнено(Параметры.Организация)
		И НЕ ЗначениеЗаполнено(Запись.Организация) Тогда
		ТекЗапись = РеквизитФормыВЗначение("Запись");
		ТекЗапись.Организация = Параметры.Организация;
		ТекЗапись.Прочитать();
		Если НЕ ТекЗапись.Выбран() Тогда
			ТекЗапись.Организация = Параметры.Организация;
			//заполнение адресов
			ЗаполнитьЗначенияСвойств(ТекЗапись,ПолучитьАдресаПромышенногоСтендаПоУмолчанию_От2025_11());
			НоваяЗапись = Истина;
		КонецЕсли;
		ЗначениеВРеквизитФормы(ТекЗапись,"Запись");
	ИначеЕсли НЕ ЗначениеЗаполнено(Параметры.Организация)
		И НЕ ЗначениеЗаполнено(Запись.Организация) Тогда
		//заполнение адресов
		ЗаполнитьЗначенияСвойств(Запись, ПолучитьАдресаПромышенногоСтендаПоУмолчанию_От2025_11());
		НоваяЗапись = Истина;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СертификатыПользователейЕБП, "Организация", ?(ЗначениеЗаполнено(Запись.Организация), Запись.Организация, Неопределено));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"СертификатыПользователейЕБП", "ТолькоПросмотр", НоваяЗапись);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаНадписьСертификаты", "Видимость", НоваяЗапись); 
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СертификатыПользователейЕБП, "Организация", Запись.Организация);
	Элементы.СертификатыПользователейЕБП.ТолькоПросмотр = Ложь;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаНадписьСертификаты", "Видимость", Ложь); 
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерезаполнитьАдресаПромышленногоСтенда(Команда)
	//адреса, используемые до 11.2025
	ЗаполнитьЗначенияСвойств(Запись, ПолучитьАдресаПромышенногоСтендаПоУмолчанию());
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьАдресаПромышленногоСтенда_От2025_11(Команда)
	ЗаполнитьЗначенияСвойств(Запись, ПолучитьАдресаПромышенногоСтендаПоУмолчанию_От2025_11());
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьАдресаТестовогоСтенда(Команда)
	ЗаполнитьЗначенияСвойств(Запись, ПолучитьАдресаТестовогоСтендаПоУмолчанию());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьАдресаТестовогоСтендаПоУмолчанию()
	СтруктураАдресов = Новый Структура;
	СтруктураАдресов.Вставить("АдресАвторизации","https://auth.ebp01.roskazna.ru/api/auth/api/v1/auth/ext-system");
	СтруктураАдресов.Вставить("АдресЗагрузкиФайлов","https://ext.ebp01.roskazna.ru/api/rest-adapter/xml/integration-files/upload");
	СтруктураАдресов.Вставить("АдресПередачиПакетов","https://ext.ebp01.roskazna.ru/api/rest-adapter/xml/integration/import");
	СтруктураАдресов.Вставить("АдресЗапросаРезультатов","https://ext.ebp01.roskazna.ru/api/rest-adapter/xml/integration/search");
	СтруктураАдресов.Вставить("АдресЗапросаДокументов","https://ext.ebp01.roskazna.ru/api/rest-adapter/xml/integration/export-search");
	СтруктураАдресов.Вставить("АдресЗапросаФайлов","https://ext.ebp01.roskazna.ru/api/rest-adapter/export-files/{fileId}/download");
	Возврат СтруктураАдресов;
КонецФункции

