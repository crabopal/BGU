Функция ТекущаяНастройкаВнутреннегоЭДОБГУ(Организация = Неопределено) Экспорт
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиВнутреннегоЭДОБГУ.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	НастройкиВнутреннегоЭДОБГУ.ИдентификаторКомандыПечати КАК ИдентификаторКомандыПечати,
	|	НастройкиВнутреннегоЭДОБГУ.Формировать КАК Формировать,
	|	НастройкиВнутреннегоЭДОБГУ.МаршрутПодписания КАК МаршрутПодписания,
	|	НастройкиВнутреннегоЭДОБГУ.ОсновнаяПечатнаяФорма КАК ОсновнаяПечатнаяФорма
	|ИЗ
	|	РегистрСведений.НастройкиВнутреннегоЭДОБГУ КАК НастройкиВнутреннегоЭДОБГУ
	|ГДЕ
	|	НастройкиВнутреннегоЭДОБГУ.Организация = &Организация
	|ИТОГИ ПО
	|	ИдентификаторДокумента";
	
	Если Организация = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НастройкиВнутреннегоЭДОБГУ.Организация = &Организация", "ИСТИНА");
	Иначе
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;
	
	ВыборкаПоДокументам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоДокументам.Следующий() Цикл
		ПечатныеФормы = Новый Соответствие;
		ВыборкаПоФормам = ВыборкаПоДокументам.Выбрать();
		Пока ВыборкаПоФормам.Следующий() Цикл
			ПечатныеФормы.Вставить(ВыборкаПоФормам.ИдентификаторКомандыПечати,
				Новый Структура("Формировать, МаршрутПодписания, ОсновнаяПечатнаяФорма",
					ВыборкаПоФормам.Формировать,
					ВыборкаПоФормам.МаршрутПодписания,
					ВыборкаПоФормам.ОсновнаяПечатнаяФорма));
		КонецЦикла;
		Результат.Вставить(ВыборкаПоДокументам.ИдентификаторДокумента, ПечатныеФормы);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает маршрут подписания по переданным параметрам
//
// Параметры:
//  Организация - СправочникСсылка.Организации 
//  УчетныйДокумент - ОпределяемыйТип.ОснованиеВнутреннегоЭлектронногоДокумента - ссылка на учетный документ
//  ИдентификаторКомандыПечати - Строка
//
// Возвращаемое знаение:
//  - СправочникСсылка.МаршрутыПодписанияБГУ - маршрут подписания
Функция МаршрутИзНастройкиВнутреннегоЭДОБГУ(Организация, УчетныйДокумент, ИдентификаторКомандыПечати) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиВнутреннегоЭДОБГУ.МаршрутПодписания КАК МаршрутПодписания
	|ИЗ
	|	РегистрСведений.НастройкиВнутреннегоЭДОБГУ КАК НастройкиВнутреннегоЭДОБГУ
	|ГДЕ
	|	НастройкиВнутреннегоЭДОБГУ.Организация = &Организация
	|	И НастройкиВнутреннегоЭДОБГУ.ИдентификаторДокумента = &ИдентификаторДокумента
	|	И НастройкиВнутреннегоЭДОБГУ.ИдентификаторКомандыПечати = &ИдентификаторКомандыПечати
	|	И НастройкиВнутреннегоЭДОБГУ.Формировать";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИдентификаторДокумента",
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(УчетныйДокумент)));
	Запрос.УстановитьПараметр("ИдентификаторКомандыПечати", ИдентификаторКомандыПечати);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Маршрут = Справочники.МаршрутыПодписанияБГУ.ПустаяСсылка();
	Если Выборка.Следующий() Тогда
		Маршрут = Выборка.МаршрутПодписания;
	КонецЕсли;
	
	Возврат Маршрут;
КонецФункции	

