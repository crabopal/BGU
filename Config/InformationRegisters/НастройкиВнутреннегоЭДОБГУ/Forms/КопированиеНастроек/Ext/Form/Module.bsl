#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОрганизацияКуда = Параметры.ОрганизацияКуда;
	
	ЧтоКопировать = "ПечатныеФормыИМаршруты";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	
	КомпоновщикНастроекКомпоновкиДанных = Новый КомпоновщикНастроекКомпоновкиДанных;
	НастройкаКомпоновщика = КомпоновщикНастроекКомпоновкиДанных.Настройки;
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(НастройкаКомпоновщика.Отбор,
		"Ссылка", ВидСравненияКомпоновкиДанных.НеРавно, ОрганизацияКуда, , Истина);
	ПараметрыФормы.Вставить("ФиксированныеНастройки", НастройкаКомпоновщика);
	
	ОткрытьФорму("Справочник.Организации.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Скопировать(Команда)
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Выберите организацию, настройки которой необходимо скопировать'"), , "Организация");
		Возврат;
	КонецЕсли;
	
	АдресХраненияНастроек = АдресХраненияНастроекВнутреннегоЭДО(ВладелецФормы.УникальныйИдентификатор);
	ОповеститьОВыборе(АдресХраненияНастроек);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция АдресХраненияНастроекВнутреннегоЭДО(УИДВладельца)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиВнутреннегоЭДОБГУ.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	НастройкиВнутреннегоЭДОБГУ.ИдентификаторКомандыПечати КАК ИдентификаторКомандыПечати,
	|	НастройкиВнутреннегоЭДОБГУ.Формировать КАК Формировать,
	|	ВЫБОР
	|		КОГДА &КопироватьМаршруты
	|			ТОГДА НастройкиВнутреннегоЭДОБГУ.МаршрутПодписания
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.МаршрутыПодписанияБГУ.ПустаяСсылка)
	|	КОНЕЦ КАК МаршрутПодписания,
	|	НастройкиВнутреннегоЭДОБГУ.ОсновнаяПечатнаяФорма КАК ОсновнаяПечатнаяФорма
	|ИЗ
	|	РегистрСведений.НастройкиВнутреннегоЭДОБГУ КАК НастройкиВнутреннегоЭДОБГУ
	|ГДЕ
	|	НастройкиВнутреннегоЭДОБГУ.Организация = &Организация
	|ИТОГИ ПО
	|	ИдентификаторДокумента";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("КопироватьМаршруты", ЧтоКопировать = "ПечатныеФормыИМаршруты");
	
	Результат = Новый Соответствие;
	
	ВыборкаПоДокументам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоДокументам.Следующий() Цикл
		ПечатныеФормы = Новый Соответствие;
		ВыборкаПоФормам = ВыборкаПоДокументам.Выбрать();
		Пока ВыборкаПоФормам.Следующий() Цикл
			ПечатныеФормы.Вставить(ВыборкаПоФормам.ИдентификаторКомандыПечати,
				Новый Структура("Формировать, МаршрутПодписания, ОсновнаяПечатнаяФорма",
					ВыборкаПоФормам.Формировать,
					ВыборкаПоФормам.МаршрутПодписания,
					ВыборкаПоФормам.ОсновнаяПечатнаяФорма));
		КонецЦикла;
		Результат.Вставить(ВыборкаПоДокументам.ИдентификаторДокумента, ПечатныеФормы);
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(Результат, УИДВладельца);
	
КонецФункции

#КонецОбласти
