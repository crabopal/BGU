
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьНастройку();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	ЗаполнитьНастройку();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", ТекущиеДанные.Организация);
	
	ОткрытьФорму("РегистрСведений.НастройкиВнутреннегоЭДОБГУ.Форма.НастройкаВнутреннегоЭДО",
		ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Добавить(Команда)
	
	ОрганизацииСписок = Новый СписокЗначений;
	ОрганизацииСписок.ЗагрузитьЗначения(ОрганизацииБезНастройки());
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыборОрганизацииДляНастройки", ЭтотОбъект);
	ЗаголовокСписка = НСтр("ru = 'Выберите организацию для новой настройки'");
	ОрганизацииСписок.ПоказатьВыборЭлемента(Оповещение, ЗаголовокСписка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНастройку()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	НастройкиВнутреннегоЭДОБГУ.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.НастройкиВнутреннегоЭДОБГУ КАК НастройкиВнутреннегоЭДОБГУ";
	
	Список.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОрганизацииБезНастройки()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	НастройкиВнутреннегоЭДОБГУ.Организация КАК Организация
	|ПОМЕСТИТЬ ОрганизацииСНастройкой
	|ИЗ
	|	РегистрСведений.НастройкиВнутреннегоЭДОБГУ КАК НастройкиВнутреннегоЭДОБГУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.Ссылка В
	|				(ВЫБРАТЬ
	|					Т.Организация
	|				ИЗ
	|					ОрганизацииСНастройкой КАК Т)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаКлиенте
Процедура ПослеВыборОрганизацииДляНастройки(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", ВыбранныйЭлемент.Значение);
	
	ОткрытьФорму("РегистрСведений.НастройкиВнутреннегоЭДОБГУ.Форма.НастройкаВнутреннегоЭДО",
		ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти