&НаКлиенте
Процедура ЗаполнитьОтметкуУРодителя(Родитель)
	
	Формировать = Ложь;
	Для Каждого Строка Из Родитель.ПолучитьЭлементы() Цикл
		Формировать = Формировать ИЛИ Строка.Формировать;
	КонецЦикла;
	Родитель.Формировать = Формировать;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандуЗаписать()
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	СохранитьНастройки();
	
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()
	
	НастройкиДляЗаписиВРегистр = РегистрыСведений.НастройкиВнутреннегоЭДОБГУ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	
	Для Каждого СтрокаДокумент Из Настройки.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаПечать Из СтрокаДокумент.ПолучитьЭлементы() Цикл
			НоваяСтрока = НастройкиДляЗаписиВРегистр.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПечать);
			НоваяСтрока.Организация = Организация;
		КонецЦикла;
	КонецЦикла;
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.НастройкиВнутреннегоЭДОБГУ");
		ЭлементБлокировки.УстановитьЗначение("Организация", Организация);
		Блокировка.Заблокировать();
		
		НаборЗаписей = РегистрыСведений.НастройкиВнутреннегоЭДОБГУ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(Организация);
		НаборЗаписей.Загрузить(НастройкиДляЗаписиВРегистр);
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ИмяСобытия = НСтр("ru = 'Запись настроек внутреннего электронного документооборота БГУ'",
			ОбщегоНазначения.КодОсновногоЯзыка());
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемОкнаФормы(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда
		ВыполнитьКомандуЗаписать();
	КонецЕсли;
	
	Закрыть();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьНастройкаЭДОБГУ(ОрганизацияДляПоиска)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НастройкиЭДОБГУ.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.НастройкиЭДОБГУ КАК НастройкиЭДОБГУ
	|ГДЕ
	|	НастройкиЭДОБГУ.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", ОрганизацияДляПоиска);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервереБезКонтекста
Функция СписокПодписантовМаршрута(Маршрут)
	
	Возврат ВнутреннийЭДО.ПодписантыМаршрутаПодписания(Маршрут);
	
КонецФункции 

#КонецОбласти
