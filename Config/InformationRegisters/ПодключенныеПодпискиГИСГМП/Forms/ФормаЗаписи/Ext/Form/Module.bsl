
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТолькоПросмотр = Истина;
	
	ДобавитьРеквизитыТаблицыПоПараметрамПодписки();
	
	Таблица = РеквизитФормыВЗначение("ТаблицаЗначенийПараметров");
	Таблица.Индексы.Добавить("КлючСтроки");

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыПодписокГИСГМПСрезПоследних.ИдентификаторГруппыПараметров КАК ИдентификаторГруппыПараметров,
		|	ПараметрыПодписокГИСГМПСрезПоследних.КодПараметра КАК КодПараметра,
		|	ПараметрыПодписокГИСГМПСрезПоследних.ЗначениеПараметра КАК ЗначениеПараметра,
		|	ПараметрыПодписокГИСГМПСрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.ПараметрыПодписокГИСГМП.СрезПоследних КАК ПараметрыПодписокГИСГМПСрезПоследних
		|ГДЕ
		|	ПараметрыПодписокГИСГМПСрезПоследних.Организация = &Организация
		|	И ПараметрыПодписокГИСГМПСрезПоследних.Подписка = &Подписка
		|	И ПараметрыПодписокГИСГМПСрезПоследних.ПараметрАктивен
		|	И ПараметрыПодписокГИСГМПСрезПоследних.ИдентификаторПодписки = &ИдентификаторПодписки";
	
	Запрос.УстановитьПараметр("ИдентификаторПодписки", Запись.ИдентификаторПодписки);
	Запрос.УстановитьПараметр("Организация", Запись.Организация);
	Запрос.УстановитьПараметр("Подписка", Запись.Подписка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаТЧ = Таблица.Найти(ВыборкаДетальныеЗаписи.ИдентификаторГруппыПараметров,"КлючСтроки");
		Если СтрокаТЧ = Неопределено Тогда
			СтрокаТЧ = Таблица.Добавить();
			СтрокаТЧ.КлючСтроки = ВыборкаДетальныеЗаписи.ИдентификаторГруппыПараметров;
			СтрокаТЧ.Период = ВыборкаДетальныеЗаписи.Период;
		КонецЕсли;
		
		СтрокаТЧ[ВыборкаДетальныеЗаписи.КодПараметра] = ВыборкаДетальныеЗаписи.ЗначениеПараметра;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Таблица,"ТаблицаЗначенийПараметров");

	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыТаблицыПоПараметрамПодписки()
	
	ИмяПоляТаблицыФормы = "ТаблицаЗначенийПараметров";
	
	УдаляемыеРеквизиты = Новый Массив;
	Таблица = РеквизитФормыВЗначение(ИмяПоляТаблицыФормы);
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Колонка.Имя = "КлючСтроки"
			ИЛИ Колонка.Имя = "Период" Тогда
			Продолжить;
		КонецЕсли;
		УдаляемыеРеквизиты.Добавить(ИмяПоляТаблицыФормы+"."+Колонка.Имя);
		СтарыйЭлемент = Элементы.Найти(ИмяПоляТаблицыФормы + Колонка.Имя);
		Если СтарыйЭлемент <> Неопределено Тогда
			Элементы.Удалить(СтарыйЭлемент);
		КонецЕсли;
	КонецЦикла;
	
	ДобавляемыеРеквизиты = Новый Массив;
	ТипСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(50);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодпискиГИСГМППараметрыПодписки.Ссылка КАК Ссылка,
		|	ПодпискиГИСГМППараметрыПодписки.НомерСтроки КАК НомерСтроки,
		|	ПодпискиГИСГМППараметрыПодписки.КодПараметра КАК КодПараметра,
		|	ПодпискиГИСГМППараметрыПодписки.НаименованиеПараметра КАК НаименованиеПараметра,
		|	ПодпискиГИСГМППараметрыПодписки.ФорматПараметра КАК ФорматПараметра,
		|	ПодпискиГИСГМППараметрыПодписки.Обязательный КАК Обязательный,
		|	ПодпискиГИСГМППараметрыПодписки.ОписаниеДопОграничений КАК ОписаниеДопОграничений
		|ИЗ
		|	Справочник.ПодпискиГИСГМП.ПараметрыПодписки КАК ПодпискиГИСГМППараметрыПодписки
		|ГДЕ
		|	ПодпискиГИСГМППараметрыПодписки.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", Запись.Подписка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ВыборкаДетальныеЗаписи.КодПараметра, ТипСтрока, ИмяПоляТаблицыФормы, ВыборкаДетальныеЗаписи.НаименованиеПараметра, Истина));
	КонецЦикла;
		
	ИзменитьРеквизиты(ДобавляемыеРеквизиты,УдаляемыеРеквизиты);
	
	ВыборкаДетальныеЗаписи.Сбросить();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ЭлементРеквизита					= Элементы.Добавить(ИмяПоляТаблицыФормы + ВыборкаДетальныеЗаписи.КодПараметра, Тип("ПолеФормы"), Элементы.ТаблицаЗначенийПараметров);
        ЭлементРеквизита.ПутьКДанным		= ИмяПоляТаблицыФормы + "." + ВыборкаДетальныеЗаписи.КодПараметра;
        ЭлементРеквизита.Вид				= ВидПоляФормы.ПолеВвода;
		ЭлементРеквизита.АвтоОтметкаНезаполненного = ВыборкаДетальныеЗаписи.Обязательный;
		
    КонецЦикла;
КонецПроцедуры
