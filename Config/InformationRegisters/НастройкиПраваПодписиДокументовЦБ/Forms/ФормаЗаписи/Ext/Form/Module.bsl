#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЦентрализованнаяБухгалтерия = Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить();
	
	УправлениеЭлементамиФормы(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СпособОпределенияПодписантаПриИзменении(Элемент)
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбслуживаемоеУчреждениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура();
	
	КомпоновщикНастроекКомпоновкиДанных = Новый КомпоновщикНастроекКомпоновкиДанных;
	НастройкаКомпоновщика = КомпоновщикНастроекКомпоновкиДанных.Настройки;
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(НастройкаКомпоновщика.Отбор,
		"Ссылка",ВидСравненияКомпоновкиДанных.НеРавно,ЦентрализованнаяБухгалтерия,,Истина);
	ПараметрыФормы.Вставить("ФиксированныеНастройки", НастройкаКомпоновщика);
		
	ОткрытьФорму("Справочник.Организации.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УправлениеЭлементамиФормы(Инициализация = Ложь)
	
	Если Запись.СпособОпределенияПодписанта = ПредопределенноеЗначение("Перечисление.СпособыОпределенияПодписантаВЦБ.СотрудникЦБ")
		ИЛИ Запись.СпособОпределенияПодписанта = ПредопределенноеЗначение("Перечисление.СпособыОпределенияПодписантаВЦБ.СотрудникУчреждения") Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтаФорма.Элементы,
		"Сотрудник", "Видимость", Истина);
		
		Если Запись.СпособОпределенияПодписанта = ПредопределенноеЗначение("Перечисление.СпособыОпределенияПодписантаВЦБ.СотрудникЦБ") Тогда
			НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Владелец", "ЦентрализованнаяБухгалтерия");
		Иначе
			НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Владелец", "Запись.ОбслуживаемоеУчреждение");
		КонецЕсли;
		
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(НоваяСвязь);
		НовыеСвязи = Новый ФиксированныйМассив(НовыйМассив);
		
		Если НЕ ОбщегоНазначения.ДанныеСовпадают(ЭтаФорма.Элементы.Сотрудник.СвязиПараметровВыбора,НовыеСвязи) Тогда
			ЭтаФорма.Элементы.Сотрудник.СвязиПараметровВыбора = НовыеСвязи;
			Если Не Инициализация Тогда
				Запись.Сотрудник = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтаФорма.Элементы,
		"Сотрудник", "Видимость", Ложь);
		
		Если Не Инициализация Тогда
			Запись.Сотрудник = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
