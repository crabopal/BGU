#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Запись.ОбслуживаемоеУчреждение = Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить() Тогда
			ТекстСообщения = НСтр("ru='В качестве обслуживаемого учреждения не может быть указана централизованная бухгалтерия!'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"Запись.ОбслуживаемоеУчреждение",,Отказ);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
