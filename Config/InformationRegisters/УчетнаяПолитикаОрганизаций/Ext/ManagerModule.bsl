// Заполнение значений параметров налогового учета по налогу на прибыль значениями по умолчанию
Процедура ЗаполнитьПараметрыНалоговогоУчетаПоУмолчанию() Экспорт

	НаборЗаписей = РегистрыСведений.УчетнаяПолитикаОрганизаций.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();

	Для каждого Запись Из НаборЗаписей Цикл
		
		Запись.СистемаНалогообложения       = Перечисления.СистемыНалогообложения.ОсобыйПорядок;
		Запись.МетодНачисленияАмортизацииНУ = Перечисления.МетодыНачисленияАмортизации.Линейный;
		
	КонецЦикла;

	Попытка
		НаборЗаписей.Записать();
	Исключение
		ТекстСообщения	= НСтр("ru = 'Не выполнено обновление записей регистра сведений ""Учетная политика""'");
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ПриОбновлении_2_0_9_7_ПлательщикНалогаНаПрибыль() Экспорт
	
	НовыйНаборЗаписей = РегистрыСведений.УчетнаяПолитикаОрганизаций.СоздатьНаборЗаписей();
	НовыйНаборЗаписей.Прочитать();

	Для каждого Запись Из НовыйНаборЗаписей Цикл
		
		Запись.ПлательщикНалогаНаПрибыль = Запись.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Общая;
		
	КонецЦикла;

	Попытка
		НовыйНаборЗаписей.Записать();
	Исключение
		ОбъектМетаданных	= Метаданные.РегистрыСведений.УчетнаяПолитикаОрганизаций;
		ИмяСобытия			= НСтр("ru='Данные. Изменение'");
		КомментарийОшибка	= НСтр("ru='Ошибка при групповой обработке записей регистра ""Учетная политика организаций"": '");
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,							// имя события
			УровеньЖурналаРегистрации.Ошибка,	// уровень
			ОбъектМетаданных,					// объект метаданных
			,									// данные
			КомментарийОшибка + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	// комментарий
	КонецПопытки;

КонецПроцедуры

Процедура ЗаполнитьПараметрыРаспределенияРасходовПоУмолчанию() Экспорт

	НаборЗаписей = РегистрыСведений.УчетнаяПолитикаОрганизаций.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();

	Для каждого Запись Из НаборЗаписей Цикл
		
		Если НЕ ЗначениеЗаполнено(Запись.БазаРаспределенияКосвенныхРасходовПоВидамДеятельности) Тогда
			Запись.БазаРаспределенияКосвенныхРасходовПоВидамДеятельности =
				Перечисления.БазыРаспределенияКосвенныхРасходовПоВидамДеятельности.ДоходыОтРеализации;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Запись.МетодРаспределенияРасходовУСНПоВидамДеятельности) Тогда
			Запись.МетодРаспределенияРасходовУСНПоВидамДеятельности =
				Перечисления.МетодыРаспределенияРасходовУСНПоВидамДеятельности.ЗаКвартал;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Запись.БазаРаспределенияРасходовУСНПоВидамДеятельности) Тогда
			Запись.БазаРаспределенияРасходовУСНПоВидамДеятельности =
				Перечисления.БазаРаспределенияРасходовУСНПоВидамДеятельности.ДоходыОтРеализацииБУ;
		КонецЕсли;
		
	КонецЦикла;

	Попытка
		НаборЗаписей.Записать();
	Исключение
		ТекстСообщения	= НСтр("ru = 'Не выполнено обновление записей регистра сведений ""Учетная политика""'");
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ПроверитьУдалитьНекорректныеЗаписи(ПараметрОбработчика = Неопределено) Экспорт
	
	НекорректныеЗаписи = РегистрыСведений.УчетнаяПолитикаОрганизаций.СоздатьНаборЗаписей();
	НекорректныеЗаписи.Отбор.Организация.Установить(Справочники.Организации.ПустаяСсылка());
	НекорректныеЗаписи.Записывать = Истина;
	НекорректныеЗаписи.Прочитать();
	
	Если НекорректныеЗаписи.Количество() > 0 Тогда 
		
		// в режиме запуска, как обработчика обновления (*) выполняем только в монопольном режиме
		Если ПараметрОбработчика <> Неопределено И ПараметрОбработчика.МонопольныйРежим = Ложь Тогда
			// установим признак необходимости монопольного режима
			ПараметрОбработчика.МонопольныйРежим = Истина;
			Возврат;
		КонецЕсли;
		
		НекорректныеЗаписи.Очистить();
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НекорректныеЗаписи);
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик обновления 2.0.101.46
Процедура ПриОбновлении_2_0_101_УстановитьФлажокНДСПрименяетсяОсвобождениеОтУплатыПриУСН() Экспорт
	
	// Устанавливает флажок "Применяется освобождение от уплаты НДС" в учетной политике
	// для учреждений на УСН, если у них еще не выбрана ставка НДС.
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.Текст = "ВЫБРАТЬ
	|	Организация,
	|	Период
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(
	|		,
	|		СистемаНалогообложения = ЗНАЧЕНИЕ(Перечисление.СистемыНалогообложения.Упрощенная)
	|		И НЕ НДСПрименяетсяОсвобождениеОтУплаты
	|		И СтавкаНалогообложенияПриУСН = ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.ПустаяСсылка)
	|	)";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		
		Попытка
			НаборЗаписей = РегистрыСведений.УчетнаяПолитикаОрганизаций.СоздатьНаборЗаписей();
			
			НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
			НаборЗаписей.Отбор.Организация.Установить(Выборка.Организация);		
			
			НаборЗаписей.Прочитать();
			
			Для Каждого Запись Из НаборЗаписей Цикл
				Запись.НДСПрименяетсяОсвобождениеОтУплаты = Истина;
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОбъектМетаданных	= Метаданные.РегистрыСведений.УчетнаяПолитикаОрганизаций;
			ИмяСобытия			= НСтр("ru='Данные. Изменение'");
			КомментарийОшибка	= НСтр("ru='Ошибка при групповой обработке записей регистра ""Учетная политика организаций"": '");
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				ОбъектМетаданных,					// объект метаданных
				,									// данные
				КомментарийОшибка + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	// комментарий
				
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеЗаписиРегистра

Процедура УстановитьПараметрыУчетнойПолитикиПоУмолчанию(ЗаписьРегистра, ДанныеЗаполнения) Экспорт

	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "Организация", ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию());
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "Период", НачалоГода(ТекущаяДатаСеанса()));
	
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "СистемаНалогообложения", Перечисления.СистемыНалогообложения.ОсобыйПорядок);
	
	Если ЗаписьРегистра.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная Тогда
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПлательщикНалогаНаПрибыль", Ложь);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПрименяетсяУСН", Истина);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПрименяетсяУСНДоходы", Истина);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПрименяетсяУСНДоходыМинусРасходы", Ложь);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПлательщикЕНВД", Ложь);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "НДСПрименяетсяОсвобождениеОтУплаты", Истина);
		
	ИначеЕсли ЗаписьРегистра.СистемаНалогообложения = Перечисления.СистемыНалогообложения.ОсобыйПорядок Тогда
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПлательщикНалогаНаПрибыль", Ложь);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПрименяетсяУСН", Ложь);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПрименяетсяУСНДоходы", Ложь);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПрименяетсяУСНДоходыМинусРасходы", Ложь);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПлательщикЕНВД", Ложь);
	Иначе
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПлательщикНалогаНаПрибыль", Истина);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПрименяетсяУСН", Ложь);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПрименяетсяУСНДоходы", Ложь);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПрименяетсяУСНДоходыМинусРасходы", Ложь);
		УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПлательщикЕНВД", Ложь);
	КонецЕсли;
	
	// Налог на прибыль
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "МетодНачисленияАмортизацииНУ", 
		Перечисления.МетодыНачисленияАмортизации.Линейный);
	
	// УСН
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ОбъектНалогообложенияУСН", 
		Перечисления.ОбъектыНалогообложенияПоУСН.Доходы);
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПоложенияПереходногоПериодаУСН", Ложь);
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "СтавкаНалогаУСН",
		?(ЗаписьРегистра.ПрименяетсяУСН, ?(ЗаписьРегистра.ПрименяетсяУСНДоходы, 6, 15), 0));
		
	// УСН: Учет расходов
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПорядокПризнанияМатериальныхРасходов", 
		Перечисления.ПорядокПризнанияМатериальныхРасходов.ПоОплатеПоставщику);
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПорядокПризнанияРасходовПоТоварам", 
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоФактуРеализации);
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПорядокПризнанияРасходовПоНДС", 
		Перечисления.ПорядокПризнанияРасходовПоНДС.ВключатьВСтоимость);
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПорядокПризнанияДопРасходов",
		Перечисления.ПорядокПризнанияДопРасходов.ПоОплатеПоставщику);
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "ПорядокПризнанияТаможенныхПлатежей",
		Перечисления.ПорядокПризнанияТаможенныхПлатежей.ВключатьВСтоимость);
		
	// ЕНВД
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "РозничнаяТорговляОблагаетсяЕНВД",
		ЗаписьРегистра.ПлательщикЕНВД);
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "БазаРаспределенияКосвенныхРасходовПоВидамДеятельности",
		Перечисления.БазыРаспределенияКосвенныхРасходовПоВидамДеятельности.ДоходыОтРеализации);
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "МетодРаспределенияРасходовУСНПоВидамДеятельности",
		Перечисления.МетодыРаспределенияРасходовУСНПоВидамДеятельности.ЗаКвартал);
	УстановитьЗначениеРеквизита(ЗаписьРегистра, ДанныеЗаполнения, "БазаРаспределенияРасходовУСНПоВидамДеятельности",
		Перечисления.БазаРаспределенияРасходовУСНПоВидамДеятельности.ДоходыОтРеализацииБУ);
	
КонецПроцедуры

Процедура УстановитьПараметрыУчетнойПолитикиПоУмолчаниюНаПериод(ЗаписьРегистра) Экспорт

	ЗаписьРегистра.НДСНалоговыйПериод = ?(ЗаписьРегистра.Период < '20080101', Перечисления.Периодичность.Месяц, Перечисления.Периодичность.Квартал);

КонецПроцедуры

