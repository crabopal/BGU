// Конец СтандартныеПодсистемы.УправлениеДоступом

// Определяет дату изменения типа учреждения, т.е. дату перехода на план счетов бюджетный или автономный
//
// Параметры:
//  Организация - СправочникСсылка.Организации - учреждение, для которого определяем дату
//  Период - Дата - дата, на которую определяем дату перехода
//
// Возвращаемое значение
//  Структура - Ключи: 
//    * ТипПланаСчетов - ПеречислениеСсылка.ТипыПлановСчетов - актуальный тип плана счетов
//    * ДатаИзменения - Дата - дата перехода на бюджетный или автономный план счетов
Функция ПолучитьДатуИзмененияТипаУчреждения(Организация, Период) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	УчетнаяПолитикаОрганизаций.Период КАК Период,
	|	УчетнаяПолитикаОрганизаций.СтруктураРПС.ТипПланаСчетов КАК ТипПланаСчетов
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|ГДЕ
	|	УчетнаяПолитикаОрганизаций.Организация = &Организация
	|	И УчетнаяПолитикаОрганизаций.Период <= &Период
	|	И УчетнаяПолитикаОрганизаций.СтруктураРПС.ТипПланаСчетов <> ЗНАЧЕНИЕ(Перечисление.ТипыПлановСчетов.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период"		, Период);
	Запрос.УстановитьПараметр("Организация"	, Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТипПланаСчетов = Неопределено;
	ДатаИзменения = '00010101';
	
	ТПС_ДляКазенных = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных");
	Пока Выборка.Следующий() Цикл
		Если ТипПланаСчетов = Неопределено Тогда
			ТипПланаСчетов = Выборка.ТипПланаСчетов;
		КонецЕсли;
		Если Выборка.ТипПланаСчетов = ТПС_ДляКазенных Тогда
			Прервать;
		КонецЕсли;
		ДатаИзменения = Выборка.Период;
	КонецЦикла;
	
	Результат = Новый Структура("ТипПланаСчетов, ДатаИзменения", ТипПланаСчетов, ДатаИзменения);
	
	Возврат Результат;
	
КонецФункции

