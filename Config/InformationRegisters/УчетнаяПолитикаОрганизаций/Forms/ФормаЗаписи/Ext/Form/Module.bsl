Функция ЕстьОшибкаНастройкиРассчитыватьСебестоимостьВКонцеГода(Форма)
	Возврат Форма.Запись.РассчитыватьСебестоимостьВКонцеГода
		И ЕстьПроведенныеЕжемесячныеЗакрытия(Форма.Запись.Организация, Форма.Запись.Период, Форма.ОкончаниеДействия);
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьПроведенныеЕжемесячныеЗакрытия(Знач Организация, Знач ДатаНачала, Знач ДатаОкончания)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПроверяемыйДокумент.Ссылка
	|ИЗ
	|	Документ.ЗакрытиеСчетовПроизводственныхЗатрат КАК ПроверяемыйДокумент
	|ГДЕ
	|	ПроверяемыйДокумент.Организация = &Организация
	|	И ПроверяемыйДокумент.Проведен
	|	И МЕСЯЦ(ПроверяемыйДокумент.Дата) <> 12
	|	И &УсловиеПериод
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПроверяемыйДокумент.Ссылка
	|ИЗ
	|	Документ.СписаниеЗатратПоУслугам КАК ПроверяемыйДокумент
	|ГДЕ
	|	ПроверяемыйДокумент.Организация = &Организация
	|	И ПроверяемыйДокумент.Проведен
	|	И МЕСЯЦ(ПроверяемыйДокумент.Дата) <> 12
	|	И &УсловиеПериод
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПроверяемыйДокумент.Ссылка
	|ИЗ
	|	Документ.РегистрацияБазыРаспределенияОбщихЗатрат КАК ПроверяемыйДокумент
	|ГДЕ
	|	ПроверяемыйДокумент.Организация = &Организация
	|	И ПроверяемыйДокумент.Проведен
	|	И МЕСЯЦ(ПроверяемыйДокумент.Дата) <> 12
	|	И &УсловиеПериод
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПроверяемыйДокумент.Ссылка
	|ИЗ
	|	Документ.НезавершенноеПроизводство КАК ПроверяемыйДокумент
	|ГДЕ
	|	ПроверяемыйДокумент.Организация = &Организация
	|	И ПроверяемыйДокумент.Проведен
	|	И МЕСЯЦ(ПроверяемыйДокумент.Дата) <> 12
	|	И &УсловиеПериод";
	Запрос.УстановитьПараметр("Организация", Организация);
	
	УсловиеПериод = Новый Массив;
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		УсловиеПериод.Добавить("ПроверяемыйДокумент.Дата >= &ДатаНачала");
		Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		УсловиеПериод.Добавить("ПроверяемыйДокумент.Дата <= &ДатаОкончания");
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	КонецЕсли;
	Если УсловиеПериод.Количество() = 0 Тогда
		УсловиеПериодСтрокой = "ИСТИНА";
	Иначе
		УсловиеПериодСтрокой = СтрСоединить(УсловиеПериод, " И ");
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПериод", УсловиеПериодСтрокой);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

&НаКлиенте
Процедура ВвестиДатуИзмененияУчетнойПолитикиПослеЗакрытияВопроса(Дата, Параметры) Экспорт
	
	Если Дата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьСуществованиеЗаписиНаВыбраннуюДату(Дата, Запись.Организация) Тогда
		ЗаписатьДанныеНаДату(Дата);
	Иначе
		ДопПараметры = Новый Структура("Дата", Дата);
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаменитьЗаписьПослеЗакрытияВопроса", ЭтотОбъект, ДопПараметры);
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'На %1 уже есть запись. Заменить?'"), Формат(Дата, "ДЛФ=D"));
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет); 
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьЗаписьПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаписатьДанныеНаДату(Параметры.Дата);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДанныеНаДату(Дата)
	
	Модифицированность = Ложь;
	ПараметрыЗаписи = Новый Структура("НоваяДата",Дата);
	Записать(ПараметрыЗаписи);	
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьПараметрыУчетнойПолитики(Знач Организация, Знач НаДату, УстанавливатьЗначенияПоУмолчанию=Ложь)
	
	УчетнаяПолитикаМенеджерЗаписи = РеквизитФормыВЗначение("Запись");
	ПараметрыУчетнойПолитики = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, НаДату);
	ЗаполнитьЗначенияСвойств(УчетнаяПолитикаМенеджерЗаписи, ПараметрыУчетнойПолитики);
	УчетнаяПолитикаМенеджерЗаписи.Прочитать();
	
	Если УстанавливатьЗначенияПоУмолчанию
	   И НЕ ЗначениеЗаполнено(УчетнаяПолитикаМенеджерЗаписи.Организация)
	   И НЕ ЗначениеЗаполнено(УчетнаяПолитикаМенеджерЗаписи.Период) Тогда // еще нет учетной политики для этой организации
		
		РегистрыСведений.УчетнаяПолитикаОрганизаций.УстановитьПараметрыУчетнойПолитикиПоУмолчанию(
			УчетнаяПолитикаМенеджерЗаписи, Новый Структура("Организация, Период", Организация, НачалоГода(НаДату)));
		
		РегистрыСведений.УчетнаяПолитикаОрганизаций.УстановитьПараметрыУчетнойПолитикиПоУмолчаниюНаПериод(
			УчетнаяПолитикаМенеджерЗаписи);
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(УчетнаяПолитикаМенеджерЗаписи, "Запись");
	ПараметрыУчетнойПолитики.Свойство("ОкончаниеДействия", ОкончаниеДействия);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередВыборомПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Модифицированность = Ложь;
		УстановитьУчетнуюПолитикуНаДату();
	Иначе
		Элементы.Список.ТекущаяСтрока = Запись.ИсходныйКлючЗаписи;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУчетнуюПолитикуНаДату()
	
	ТекущиеДанные = Элементы.Список.ТекущаяСтрока;
	
	ПолучитьПараметрыУчетнойПолитики(ТекущиеДанные.Организация, ТекущиеДанные.Период + 1);	
	УправлениеФормойСервер();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьСуществованиеЗаписиНаВыбраннуюДату(Дата,Организация)
	НоваяЗапись = РегистрыСведений.УчетнаяПолитикаОрганизаций.СоздатьМенеджерЗаписи();	
	НоваяЗапись.Период = НачалоМесяца(Дата);
	НоваяЗапись.Организация = Организация;
	НоваяЗапись.Прочитать();
	
	Возврат НоваяЗапись.Выбран();
	
КонецФункции

&НаКлиенте
Процедура ДоступностьНачисленияАмортизацииИК()

	Элементы.НачислятьАмортизациюИмуществаКазны.Доступность = Запись.ВедениеАналитическогоУчетаИмуществаКазны;

КонецПроцедуры // ДоступностьНачисленияАмортизацииИК()

&НаСервереБезКонтекста
Функция ПолучитьТекущийРПС(СтруктураРПС)
	
	Возврат СтруктураРПС.ТипПланаСчетов;

КонецФункции	

&НаСервере
Процедура УправлениеФормойСервер()
	
	ЭтоОСН 				= Запись.СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.Общая");
	ЭтоУСН 				= Запись.СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.Упрощенная");
	ЭтоОсобыйПорядок 	= Запись.СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.ОсобыйПорядок");
	
	Элементы.СтраницаНалогНаПрибыль.Видимость 	= ЭтоОСН;
	Элементы.СтраницаУСН.Видимость				= ЭтоУСН;
	Элементы.СтраницаЕНВД.Видимость				= ЭтоОСН ИЛИ ЭтоУСН;
	
	Элементы.ПорядокПризнанияРасходовУСН.Видимость = Запись.ПрименяетсяУСНДоходыМинусРасходы;
	
	Элементы.РозничнаяТорговляОблагаетсяЕНВД.Доступность                       = Запись.ПлательщикЕНВД;
	Элементы.БазаРаспределенияКосвенныхРасходовПоВидамДеятельности.Доступность = Запись.ПлательщикЕНВД;
	Элементы.МетодРаспределенияУСН.Доступность                                 = Запись.ПлательщикЕНВД;
	Элементы.БазаРаспределенияУСН.Доступность                                  = Запись.ПлательщикЕНВД;
	
	Если ЭтоОСН Тогда
		Элементы.ГруппаСтраницыРаспределениеРасходовЕНВД.ТекущаяСтраница = Элементы.ГруппаРаспределениеРасходовНалогНаПрибыль;
	ИначеЕсли ЭтоУСН Тогда
		Элементы.ГруппаСтраницыРаспределениеРасходовЕНВД.ТекущаяСтраница = Элементы.ГруппаРаспределениеРасходовУСН;
	Иначе
		Элементы.ГруппаСтраницыРаспределениеРасходовЕНВД.ТекущаяСтраница = Элементы.ГруппаРаспределениеРасходовНеРаспределяются;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовПрогрессивнойШкалыУСН(ЭтотОбъект);
	
	НДС_НастроитьФормуСервер();
	
	УчетНаСчете21ВУсловнойОценке		= ?(Запись.УчетНаСчете21ВУсловнойОценке, 0, 1);
	НачислятьАмортизациюПервымЧислом    = ?(Запись.НачислятьАмортизациюПервымЧислом, 1, 0);
	ПорядокНумерацииИнвНомеров			= ?(ЗначениеЗаполнено(Запись.ШаблонИнвентарныхНомеров), 1, 0);
	АвтонумерацияИнвентарныхКарточек	= (Запись.ПорядокНумерацииИнвентарныхКарточек > 0);
	ПорядокНумерацииИнвентарныхКарточек	= Макс(Запись.ПорядокНумерацииИнвентарныхКарточек - 1, 0);
	
	НалогНаИмуществоНеПодлежитНалогообложению = (Запись.НалогНаИмуществоПорядокНалогообложения
		= Перечисления.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению);
	Элементы.ГруппаНалогНаИмущество.Видимость = Не НалогНаИмуществоНеПодлежитНалогообложению;
	УправлениеВидимостьюНалогНаИмуществоКодЛьготы(ЭтотОбъект);
	УправлениеВидимостьюНалогНаИмуществоКодОснованияЛьготы(ЭтотОбъект);
		
	Элементы.ШаблонИнвентарныхНомеров.ТолькоПросмотр					= (ПорядокНумерацииИнвНомеров <> 1);
	Элементы.ГруппаПорядокНумерацииИнвентарныхКарточек.ТолькоПросмотр	= Не АвтонумерацияИнвентарныхКарточек;
	Элементы.ШаблонНомеровИнвентарныхКарточек.ТолькоПросмотр			= (ПорядокНумерацииИнвентарныхКарточек <> 2);
	
	УстановитьВидимостьПредупрежденияРассчитыватьСебестоимостьВКонцеГода(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовПрогрессивнойШкалыУСН(Форма)
	
	ПрименяетсяУСН =
		Форма.Запись.СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.Упрощенная");
	ПрименяетсяУСНДоходы =
		Форма.Запись.ОбъектНалогообложенияУСН = ПредопределенноеЗначение("Перечисление.ОбъектыНалогообложенияПоУСН.Доходы");
	ПрименяетсяУСНДоходыМинусРасходы =
		Форма.Запись.ОбъектНалогообложенияУСН = ПредопределенноеЗначение("Перечисление.ОбъектыНалогообложенияПоУСН.ДоходыМинусРасходы");
	
	Если ЗначениеЗаполнено(Форма.ОкончаниеДействия) Тогда
		ПрименяетсяПрогрессивнаяШкалаУСН = ПрименяетсяУСН
			И Форма.ОкончаниеДействия >= УчетУСНКлиентСервер.ДатаНачалаПрогрессивнойШкалы()
			И Форма.ОкончаниеДействия < УчетУСНКлиентСервер.ДатаОтменыПрогрессивнойШкалы();
	Иначе // Дата окончания действия учетной политики не указана.
		ПрименяетсяПрогрессивнаяШкалаУСН = ПрименяетсяУСН
			И Форма.Запись.Период < УчетУСНКлиентСервер.ДатаОтменыПрогрессивнойШкалы();
	КонецЕсли;
	
	ЭлементыПрогрессивнойШкалыУСН = Новый Массив;
	ЭлементыПрогрессивнойШкалыУСН.Добавить("СтавкаНалогаУСНПовышенная");
	ЭлементыПрогрессивнойШкалыУСН.Добавить("ДекорацияСтавкаУСНПовышеннаяПроцент");
	ЭлементыПрогрессивнойШкалыУСН.Добавить("СредняяЧисленностьРаботниковОрганизации");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыПрогрессивнойШкалыУСН, "Видимость", ПрименяетсяПрогрессивнаяШкалаУСН);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияОтменаПрогрессивнойШкалыУСН", "Видимость", ПрименяетсяПрогрессивнаяШкалаУСН И НЕ ЗначениеЗаполнено(Форма.ОкончаниеДействия));
	
	Если ПрименяетсяПрогрессивнаяШкалаУСН Тогда
		
		СтавкиПоУмолчанию = УчетУСНКлиентСервер.НалоговыеСтавкиПоУмолчанию(Макс(Форма.Запись.Период, УчетУСНКлиентСервер.ДатаНачалаПрогрессивнойШкалы()));
		Если ПрименяетсяУСНДоходы Тогда
			Форма.СтавкаНалогаУСНПовышенная = СтавкиПоУмолчанию.СтавкаУСНДоходыПовышенная;
		ИначеЕсли ПрименяетсяУСНДоходыМинусРасходы Тогда
			Форма.СтавкаНалогаУСНПовышенная = СтавкиПоУмолчанию.СтавкаУСНДоходыМинусРасходыПовышенная;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СтавкаНалогаУСН", "Заголовок", НСтр("ru = 'Основная ставка'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДекорацияПроцентНалогаУСН", "ОтображениеПодсказки", ОтображениеПодсказки.ОтображатьСправа);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДекорацияСтавкаУСНПовышеннаяПроцент", "ОтображениеПодсказки", ОтображениеПодсказки.ОтображатьСправа);
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СтавкаНалогаУСН", "Заголовок", НСтр("ru = 'Ставка налога'"));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДекорацияПроцентНалогаУСН", "ОтображениеПодсказки", ОтображениеПодсказки.Нет);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДекорацияСтавкаУСНПовышеннаяПроцент", "ОтображениеПодсказки", ОтображениеПодсказки.Нет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСоответствиеРПССистемеНалогообложения()
	
	Если Запись.СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.Упрощенная")
		И ( ТекущийТипРПС = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляБюджетных") 
		ИЛИ ТекущийТипРПС = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных") ) Тогда
		
		ПоказатьПредупреждение(,НСтр("ru = 'Согласно п.3 статьи 346.12 НК РФ казенные и бюджетные учреждения не вправе применять УСН.'"));
		Если ТекущийТипРПС = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных") Тогда
			Запись.СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.ОсобыйПорядок");
		Иначе
			Запись.СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.Общая");
		КонецЕсли;
		
	ИначеЕсли Запись.СистемаНалогообложения <> ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.ОсобыйПорядок")
		И ТекущийТипРПС = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных") Тогда
		
		ПоказатьПредупреждение(,НСтр("ru = 'Для казенных учреждений применяется особый порядок отражения операций в налоговом учете:
			|1. Доходы казенного учреждения, подлежащие включению в налоговую базу по налогу на прибыль,
			|отражаются документом «Операция (бухгалтерская)» проводками Дт НПВ Кт Н90.01, Н90.02, Н91.01.
			|2. Для расчета налоговой базы и начисления налога на прибыль используются регламентные документы
			|«Расчет базы по налогу на прибыль» и «Расчет налога на прибыль» (в разделе «Налог на прибыль - Регламентные документы»).
			|3. Декларация по налогу на прибыль и регистры налогового учета заполняются автоматически по данным,
			|отраженным на счетах налогового учета Н01-Н99.'"));
		Запись.СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.ОсобыйПорядок");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОпределенияПрямыхРасходовНУ()
	
	ПараметрыОтбора = Новый Структура("Организация", Запись.Организация);
	ОткрытьФорму("РегистрСведений.МетодыОпределенияПрямыхРасходовПроизводстваВНУ.ФормаСписка",
		Новый Структура("Отбор", ПараметрыОтбора));
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьСписокПрямыхРасходов(Запись)

	ТекущийПериод = НачалоГода(Запись.Период);

	Набор = РегистрыСведений.МетодыОпределенияПрямыхРасходовПроизводстваВНУ.СоздатьНаборЗаписей();

	Набор.Отбор.ПериодДействия.Установить(ТекущийПериод);
	Набор.Отбор.Организация.Установить(Запись.Организация);
	
	СчетаСебестоимость           = БухгалтерскийУчет.СписокСчетов("109.60,106.2И,106.3И,106.4И");
	СчетНакладныеРасходы         = БухгалтерскийУчет.СчетПоКоду("109.70", ТекущийПериод);
	СчетОбщехозяйственныеРасходы = БухгалтерскийУчет.СчетПоКоду("109.80", ТекущийПериод);

	Если Запись.РаспределятьОХЗ И Запись.РаспределятьОПЗ Тогда
		ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор,ТекущийПериод, Запись.Организация,
													Перечисления.ВидыРасходовНУ.МатериальныеРасходы);
		ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор,ТекущийПериод, Запись.Организация,
													Перечисления.ВидыРасходовНУ.Амортизация);
		ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор,ТекущийПериод, Запись.Организация,
													Перечисления.ВидыРасходовНУ.ОплатаТруда);
	Иначе
		Для Каждого СчетСебестоимость Из СчетаСебестоимость Цикл
			ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор,ТекущийПериод, Запись.Организация,
														Перечисления.ВидыРасходовНУ.МатериальныеРасходы, СчетСебестоимость);
			ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор,ТекущийПериод, Запись.Организация,
														Перечисления.ВидыРасходовНУ.Амортизация, СчетСебестоимость);
			ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор,ТекущийПериод, Запись.Организация,
														Перечисления.ВидыРасходовНУ.ОплатаТруда, СчетСебестоимость);
		КонецЦикла;
		Если Запись.РаспределятьОПЗ Тогда
			ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор,ТекущийПериод, Запись.Организация,
														Перечисления.ВидыРасходовНУ.МатериальныеРасходы, СчетНакладныеРасходы);
			ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор,ТекущийПериод, Запись.Организация,
														Перечисления.ВидыРасходовНУ.Амортизация, СчетНакладныеРасходы);
			ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор,ТекущийПериод, Запись.Организация,
														Перечисления.ВидыРасходовНУ.ОплатаТруда, СчетНакладныеРасходы);
		КонецЕсли;
		Если Запись.РаспределятьОХЗ Тогда
			ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор,ТекущийПериод, Запись.Организация,
														Перечисления.ВидыРасходовНУ.МатериальныеРасходы, СчетОбщехозяйственныеРасходы);
			ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор,ТекущийПериод, Запись.Организация,
														Перечисления.ВидыРасходовНУ.Амортизация, СчетОбщехозяйственныеРасходы);
			ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор,ТекущийПериод, Запись.Организация,
														Перечисления.ВидыРасходовНУ.ОплатаТруда, СчетОбщехозяйственныеРасходы);
		КонецЕсли;
	КонецЕсли;


	ВидРасходовНУ    = Перечисления.ВидыРасходовНУ.СтраховыеВзносы;
	ВидРасходовНУПФР = Перечисления.ВидыРасходовНУ.СтраховыеВзносы;
	ВидРасходовНУПНС = Перечисления.ВидыРасходовНУ.ПрочиеРасходы;

	Для Каждого СчетСебестоимость Из СчетаСебестоимость Цикл
		ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор, ТекущийПериод, Запись.Организация,
													ВидРасходовНУ,СчетСебестоимость,БухгалтерскийУчет.СчетПоКоду("303.02", ТекущийПериод));

		ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор, ТекущийПериод, Запись.Организация,
													ВидРасходовНУПФР,СчетСебестоимость,БухгалтерскийУчет.СчетПоКоду("303.10", ТекущийПериод));
		ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор, ТекущийПериод, Запись.Организация,
													ВидРасходовНУПФР,СчетСебестоимость,БухгалтерскийУчет.СчетПоКоду("303.11", ТекущийПериод));
		ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор, ТекущийПериод, Запись.Организация,
													ВидРасходовНУПФР,СчетСебестоимость,БухгалтерскийУчет.СчетПоКоду("303.09", ТекущийПериод));


		ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор, ТекущийПериод, Запись.Организация,
													ВидРасходовНУ,СчетСебестоимость,БухгалтерскийУчет.СчетПоКоду("303.07", ТекущийПериод));
		ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор, ТекущийПериод, Запись.Организация,
													ВидРасходовНУ,СчетСебестоимость,БухгалтерскийУчет.СчетПоКоду("303.08", ТекущийПериод));


		ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Набор, ТекущийПериод, Запись.Организация,
													ВидРасходовНУПНС,СчетСебестоимость,БухгалтерскийУчет.СчетПоКоду("303.06", ТекущийПериод));
	КонецЦикла;

	Набор.Записать();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьЗаписьСпискаПрямыхРасходовПоУмолчанию(Объект, ТекущийПериод, ТекущаяОрганизация, ВидРасходовНУ, СчетДебета = Неопределено,СчетКредита = Неопределено)

	НоваяЗапись = Объект.Добавить();
	НоваяЗапись.ПериодДействия = ТекущийПериод;
	НоваяЗапись.Организация    = ТекущаяОрганизация;
	НоваяЗапись.ВидРасходовНУ  = ВидРасходовНУ;
	НоваяЗапись.Счет           = СчетДебета;
	НоваяЗапись.КорСчет        = СчетКредита;

КонецПроцедуры

// НДС

&НаСервере
Процедура НДС_НастроитьФормуСервер()
	
	// Оформление Индекса подразделения
	ГоловнаяОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись["Организация"], "ГоловнаяОрганизация");
	НДС_ЭтоОбособленноеПодразделение = ЗначениеЗаполнено(ГоловнаяОрганизация);
	Элементы["НДС_ИндексПодразделения"].Подсказка = НДС_ИндексПодразделенияПолучитьТекстКомментария(
		Запись["НДСИндексПодразделения"],
		НДС_ЭтоОбособленноеПодразделение);
	
	ПорядокРегистрацииПоУмолчанию = УчетНДСКлиентСервер.ПолучитьПорядокРегистрацииСчетовФактурНаАвансПоУмолчанию();
	
	Элементы["НДСПорядокРегистрацииСчетовФактурНаАванс"].ПодсказкаВвода = ПорядокРегистрацииПоУмолчанию;
	
	НДС_НастроитьФорму_ПоНачислятьПоКОСГУ189ПоВнебюджету(ЭтаФорма);
	
	УстановитьИндикаторНачислятьНДСприУСН(ЭтотОбъект);
	НастроитьВидимостьИндикатораНачислятьНДСприУСН();
	НастроитьДоступностьИндикатораНачислятьНДСприУСН(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НДС_ИндексПодразделенияПолучитьТекстКомментария(ИндексПодразделения, ЭтоОбособленноеПодразделение)
	
	Если ЭтоОбособленноеПодразделение Тогда
		Возврат НСтр("ru='применяется при печати выданных счетов-фактур'");
		
	Иначе
		Возврат НСтр("ru='не применяется, т.к. организация не является обособленным подразделением'");
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПорядокНумерацииИнвНомеровПриИзменении(Элемент)
	
	Элементы.ШаблонИнвентарныхНомеров.ТолькоПросмотр = (ПорядокНумерацииИнвНомеров <> 1);
	
КонецПроцедуры

&НаКлиенте
Процедура АвтонумерацияИнвентарныхКарточекПриИзменении(Элемент)
	
	Элементы.ГруппаПорядокНумерацииИнвентарныхКарточек.ТолькоПросмотр = Не АвтонумерацияИнвентарныхКарточек;
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокНумерацииИнвентарныхКарточекПриИзменении(Элемент)
	
	Элементы.ШаблонНомеровИнвентарныхКарточек.ТолькоПросмотр = (ПорядокНумерацииИнвентарныхКарточек <> 2);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияУправлениеНомерамиНажатие(Элемент)
	
	ОткрытьФорму("Обработка.УправлениеНомерамиИнвентарныхКарточек.Форма");
	
КонецПроцедуры

&НаКлиенте
Процедура НДСНачислятьПоКОСГУ189ПоВнебюджетуПриИзменении(Элемент)
	
	НДС_НастроитьФорму_ПоНачислятьПоКОСГУ189ПоВнебюджету(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НДС_НастроитьФорму_ПоНачислятьПоКОСГУ189ПоВнебюджету(Форма)
	
	Форма.Элементы["НДСКБКдляКОСГУ189"].ТолькоПросмотр = НЕ Форма.Запись["НДСНачислятьПоКОСГУ189ПоВнебюджету"];
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьИндикаторНачислятьНДСприУСН(Форма)
	
	Форма.НачислятьНДСприУСН = 0;
	
	Если Форма.Запись.НДСПрименяетсяОсвобождениеОтУплаты Тогда
		Возврат;
	КонецЕсли;
	
	СтавкаНалогообложенияПриУСН = Форма.Запись.СтавкаНалогообложенияПриУСН;
	
	Если СтавкаНалогообложенияПриУСН = ПредопределенноеЗначение("Перечисление.ВидыСтавокНДС.ПониженнаяУСН") Тогда
		Форма.НачислятьНДСприУСН = 1;
		
	ИначеЕсли СтавкаНалогообложенияПриУСН = ПредопределенноеЗначение("Перечисление.ВидыСтавокНДС.ОбщаяУСН") Тогда
		Форма.НачислятьНДСприУСН = 2;
		
	ИначеЕсли СтавкаНалогообложенияПриУСН = ПредопределенноеЗначение("Перечисление.ВидыСтавокНДС.Общая") Тогда
		Форма.НачислятьНДСприУСН = 3;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРесурсСтавкаНалогообложенияПриУСН(Форма)
	
	Форма.Запись.СтавкаНалогообложенияПриУСН = Неопределено;
	
	Если Форма.Запись.НДСПрименяетсяОсвобождениеОтУплаты Тогда
		Возврат;
	КонецЕсли;
	
	НачислятьНДСприУСН = Форма.НачислятьНДСприУСН;
	
	Если НачислятьНДСприУСН = 1 Тогда
		Форма.Запись.СтавкаНалогообложенияПриУСН = ПредопределенноеЗначение("Перечисление.ВидыСтавокНДС.ПониженнаяУСН");
		
	ИначеЕсли НачислятьНДСприУСН = 2 Тогда
		Форма.Запись.СтавкаНалогообложенияПриУСН = ПредопределенноеЗначение("Перечисление.ВидыСтавокНДС.ОбщаяУСН");
		
	ИначеЕсли НачислятьНДСприУСН = 3 Тогда
		Форма.Запись.СтавкаНалогообложенияПриУСН = ПредопределенноеЗначение("Перечисление.ВидыСтавокНДС.Общая");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьИндикатораНачислятьНДСприУСН()
	
	ЭтоУСН = (Запись.СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.Упрощенная"));
	
	Элементы.НачислятьНДСприУСН.Видимость = ЭтоУСН;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьДоступностьИндикатораНачислятьНДСприУСН(Форма)
	
	Форма.Элементы.НачислятьНДСприУСН.Доступность = Не Форма.Запись.НДСПрименяетсяОсвобождениеОтУплаты;
	
КонецПроцедуры

&НаКлиенте
Процедура НачислятьНДСприУСНПриИзменении(Элемент)
	
	УстановитьРесурсСтавкаНалогообложенияПриУСН(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеНачислятьНДСприУСН(Отказ)
	
	ЭтоУСН = (Запись.СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.СистемыНалогообложения.Упрощенная"));
	
	Если Не ЭтоУСН Или Запись.НДСПрименяетсяОсвобождениеОтУплаты Или ЗначениеЗаполнено(НачислятьНДСприУСН) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", , НСтр("ru = 'Начислять НДС по ставке'"));
	
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "НачислятьНДСприУСН",, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыНДСПоУмолчанию()
	
	Запись.НДСПрименяетсяОсвобождениеОтУплаты = (Запись.ПрименяетсяУСНДоходы Или Запись.ПрименяетсяУСНДоходыМинусРасходы);
	
	Запись.НДСНалоговыйПериод = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал");
	
	Запись.НДСНачислятьПоКОСГУ189ПоВнебюджету = Ложь;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НалогНаИмуществоЗаполнитьКодЛьготы(Форма)

	Запись = Форма.Запись;

	Если Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения") Тогда
				
		Форма.НалогНаИмуществоКодЛьготы = Запись.НалогНаИмуществоКодЛьготы;
		
	ИначеЕсли Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.ОблагаетсяПоСниженнойСтавке") Тогда
				
		Форма.НалогНаИмуществоКодЛьготы = "2012400";
		
	ИначеЕсли Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент") Тогда
				
		Форма.НалогНаИмуществоКодЛьготы = "2012500";
				
	Иначе
			
		Форма.НалогНаИмуществоКодЛьготы = "";
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюНалогНаИмуществоКодЛьготы(Форма)

	Элементы = Форма.Элементы;
	Запись = Форма.Запись;

	ВидимостьКодЛьготы = (Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения"))
		Или (Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.ОблагаетсяПоСниженнойСтавке"))
		Или (Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент"));
	
	Элементы.НалогНаИмуществоКодЛьготы.Видимость = ВидимостьКодЛьготы;

	Элементы.НалогНаИмуществоПроцентУменьшенияСуммыНалога.Видимость = Запись.НалогНаИмуществоПорядокНалогообложения =
		ПредопределенноеЗначение("Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент");

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюНалогНаИмуществоКодОснованияЛьготы(Форма)

	Элементы = Форма.Элементы;

	РегиональныеЛьготы = Новый Соответствие;
	РегиональныеЛьготы.Вставить("2012000", Истина);
	РегиональныеЛьготы.Вставить("2012400", Истина);
	РегиональныеЛьготы.Вставить("2012500", Истина);
	
	ВидимостьКодОснованияЛьготы = Элементы.НалогНаИмуществоКодЛьготы.Видимость
		И РегиональныеЛьготы[Форма.НалогНаИмуществоКодЛьготы] <> Неопределено;
		
	Элементы.ДекорацияКодЛьготы.Видимость = ВидимостьКодОснованияЛьготы;
	Элементы.НалогНаИмуществоКодОснованияЛьготы.Видимость = ВидимостьКодОснованияЛьготы;
	
КонецПроцедуры

#КонецОбласти
