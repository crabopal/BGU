
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ПолучитьНаТекущуюДату") Тогда
		// Форма открыта командой
		Если НЕ Параметры.Свойство("Организация", Запись.Организация) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Параметры.Свойство("НаДату", НаДату) Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ПолучитьПараметрыУчетнойПолитики(Запись.Организация, НаДату, Истина);
	
	Элементы.ОкончаниеДействия.Видимость 	= Истина;
	Элементы.Организация.ТолькоПросмотр 	= Истина;
	Элементы.Организация.КнопкаОткрытия 	= Ложь;
	ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы.ФормаЗаписать.КнопкаПоУмолчанию 	= Истина;
	ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы.ФормаЗаписать.Отображение 			= ОтображениеКнопки.КартинкаИТекст;
	ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы.ФормаЗаписатьИЗакрыть.Видимость 	= Ложь;
	
	Элементы.Список.Видимость = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", Запись.Организация, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	Элементы.Список.ТекущаяСтрока = Запись.ИсходныйКлючЗаписи;
	
	Если Константы.ИспользоватьУчетПоИФО.Получить() Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(НастройкиИспользованияРПС.Отбор, "Организация", Запись.Организация, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	Иначе
		Элементы.СтраницаНастройкиРПСПоИФО.Видимость = Ложь;
	КонецЕсли;	
	
	Элементы.СтраницаУчетИмуществаКазны.Видимость = ПолучитьФункциональнуюОпцию("ВестиУчетИмуществаКазны");
	
	ТекущийТипРПС = Запись.СтруктураРПС.ТипПланаСчетов;
	ТекущаяСтавкаНалогаУСН = Запись.СтавкаНалогаУСН;
	ПорядокИсключенияНДСизДоходовУСНприПогашенииЗадолженности = ?(Запись.ИсключатьНДСИзДоходовУСНПоДаннымКнигиПродаж = Истина, 1, 0);
	
	Если Параметры.Ключ.Организация.Пустая() Тогда
		НалогНаИмуществоЗаполнитьКодЛьготы(ЭтотОбъект);
		УправлениеФормойСервер();
	КонецЕсли;
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	НалогНаИмуществоЗаполнитьКодЛьготы(ЭтотОбъект);
	УправлениеФормойСервер();
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ДоступностьНачисленияАмортизацииИК();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если (ПорядокНумерацииИнвНомеров = 1) И Не ЗначениеЗаполнено(Запись.ШаблонИнвентарныхНомеров) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнен шаблон инвентарных номеров'"), ,
			"Запись.ШаблонИнвентарныхНомеров", , Отказ);
	КонецЕсли;
	Если ПорядокНумерацииИнвНомеров = 0 Тогда
		Запись.ШаблонИнвентарныхНомеров = ПредопределенноеЗначение("Справочник.ШаблоныНомеровНФА.ПустаяСсылка");
	КонецЕсли;
	Если (ПорядокНумерацииИнвентарныхКарточек = 2) И Не ЗначениеЗаполнено(Запись.ШаблонНомеровИнвентарныхКарточек) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнен шаблон номеров инвентарных карточек'"), ,
			"Запись.ШаблонНомеровИнвентарныхКарточек", , Отказ);
	КонецЕсли;
	
	Если НалогНаИмуществоНеПодлежитНалогообложению Тогда

		Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению");

	ИначеЕсли Не ЗначениеЗаполнено(Запись.НалогНаИмуществоПорядокНалогообложения)
		Или Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
			"Перечисление.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению") Тогда

		ТекстСообщения = НСтр("ru='Не заполнена налоговая льгота'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "Запись.НалогНаИмуществоПорядокНалогообложения",
			, Отказ);

	КонецЕсли;

	Если Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения") Тогда

		Запись.НалогНаИмуществоКодЛьготы = НалогНаИмуществоКодЛьготы;
		Если Не ЗначениеЗаполнено(Запись.НалогНаИмуществоКодЛьготы) Тогда
			ТекстСообщения = НСтр("ru='Не заполнен код льготы'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "НалогНаИмуществоКодЛьготы", , Отказ);
		КонецЕсли;

	Иначе
		Запись.НалогНаИмуществоКодЛьготы = "";
	КонецЕсли;

	Если Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент")
		И Запись.НалогНаИмуществоПроцентУменьшенияСуммыНалога = 0 Тогда

		ТекстСообщения = НСтр("ru='Не заполнен процент уменьшения суммы налога'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, ,
			"Запись.НалогНаИмуществоПроцентУменьшенияСуммыНалога", , Отказ);

	КонецЕсли;
	
	ПроверитьЗаполнениеНачислятьНДСприУСН(Отказ);
	
	Запись.ИсключатьНДСИзДоходовУСНПоДаннымКнигиПродаж = (ПорядокИсключенияНДСизДоходовУСНприПогашенииЗадолженности = 1);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если АвтонумерацияИнвентарныхКарточек Тогда
		Запись.ПорядокНумерацииИнвентарныхКарточек = ПорядокНумерацииИнвентарныхКарточек + 1;
	Иначе
		Запись.ПорядокНумерацииИнвентарныхКарточек = 0;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		Отказ = Истина;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВвестиДатуИзмененияУчетнойПолитикиПослеЗакрытияВопроса",
			ЭтотОбъект);
		ПоказатьВводДаты(ОписаниеОповещения, Запись.Период, "Изменения учетной политики вступают в силу с:",
			ЧастиДаты.Дата);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Перем НоваяДата;
	
	Если ПараметрыЗаписи.Свойство("НоваяДата",НоваяДата) Тогда
		
		НоваяЗапись = РегистрыСведений.УчетнаяПолитикаОрганизаций.СоздатьМенеджерЗаписи();
		НоваяЗапись.Период = НачалоМесяца(НоваяДата);
		НоваяЗапись.Организация = Запись.Организация;
		НоваяЗапись.Прочитать();
		ЗаполнитьЗначенияСвойств(НоваяЗапись,Запись);
		НоваяЗапись.Период = НачалоМесяца(НоваяДата);
		НоваяЗапись.Записать();
		ПолучитьПараметрыУчетнойПолитики(Запись.Организация, НоваяЗапись.Период+1);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", Запись.Организация, ВидСравненияКомпоновкиДанных.Равно,, Истина);
		Модифицированность = Ложь;
		
		Отказ = Истина;
		
	КонецЕсли;
	
	Если Не Отказ Тогда
		Если ТекущийОбъект.РассчитыватьСебестоимостьВКонцеГода
			И ЕстьОшибкаНастройкиРассчитыватьСебестоимостьВКонцеГода(ЭтотОбъект) Тогда
			
			ТекстОшибки = Нстр("ru = 'В этом периоде действия учетной политики есть проведенные регламентные документы не в конце года.
				|Перед записью необходимо отменить проведение этих документов.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Запись.РассчитыватьСебестоимостьВКонцеГода", , Отказ);
				
		КонецЕсли;
	КонецЕсли;
	
	УправлениеФормойСервер();
	
	ЗначенияКлюча = Новый Структура("Период,Организация", Запись.Период, Запись.Организация);
	Элементы.Список.ТекущаяСтрока = РегистрыСведений.УчетнаяПолитикаОрганизаций.СоздатьКлючЗаписи(ЗначенияКлюча);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ИмяСобытия = "ИзменениеУчетнойПолитики";
	Параметр = Запись["Организация"];
	Оповестить(ИмяСобытия, Параметр);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Запись.Период = НачалоМесяца(Запись.Период);
	
	УстановитьВидимостьЭлементовПрогрессивнойШкалыУСН(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(НастройкиИспользованияРПС.Отбор, "Организация", Запись.Организация, ВидСравненияКомпоновкиДанных.Равно,, Истина);
КонецПроцедуры

&НаКлиенте
Процедура СтруктураРПСПриИзменении(Элемент)
	
	ТекущийТипРПС = ПолучитьТекущийРПС(Запись.СтруктураРПС);
	
	ПроверитьСоответствиеРПССистемеНалогообложения();
	
	УправлениеФормойСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура СистемаНалогообложенияПриИзменении(Элемент)
	
	ПроверитьСоответствиеРПССистемеНалогообложения();
	
	Запись.РозничнаяТорговляОблагаетсяЕНВД = Запись.ПлательщикЕНВД;
	
	Если НЕ ЗначениеЗаполнено(Запись.ОбъектНалогообложенияУСН) Тогда
		Запись.ОбъектНалогообложенияУСН = ПредопределенноеЗначение("Перечисление.ОбъектыНалогообложенияПоУСН.Доходы");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Запись.МетодРаспределенияРасходовУСНПоВидамДеятельности) Тогда
		Запись.МетодРаспределенияРасходовУСНПоВидамДеятельности = ПредопределенноеЗначение("Перечисление.МетодыРаспределенияРасходовУСНПоВидамДеятельности.ЗаКвартал");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Запись.БазаРаспределенияРасходовУСНПоВидамДеятельности) Тогда
		Запись.БазаРаспределенияРасходовУСНПоВидамДеятельности = ПредопределенноеЗначение("Перечисление.БазаРаспределенияРасходовУСНПоВидамДеятельности.ДоходыОтРеализацииБУ");
	КонецЕсли;
	
	УстановитьСтавкуНалогаУСН();
	
	УстановитьПараметрыНДСПоУмолчанию();
	
	УправлениеФормойСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура УчетНаСчете21ВУсловнойОценкеПриИзменении(Элемент)

	Запись.УчетНаСчете21ВУсловнойОценке = (УчетНаСчете21ВУсловнойОценке = 0);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВедениеАналитическогоУчетаИмуществаКазныПриИзменении(Элемент)
	Если НЕ Запись.ВедениеАналитическогоУчетаИмуществаКазны
		И Запись.НачислятьАмортизациюИмуществаКазны Тогда
		ТекстСообщения = НСтр("ru='Флаг ""Начислять амортизацию имущества казны"" очищен автоматически'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Запись.НачислятьАмортизациюИмуществаКазны = Ложь;
	КонецЕсли;
	ДоступностьНачисленияАмортизацииИК();
КонецПроцедуры

&НаКлиенте
Процедура НалогНаИмуществоНеПодлежитНалогообложениюПриИзменении(Элемент)
	
	Если Не НалогНаИмуществоНеПодлежитНалогообложению
		И Не ЗначениеЗаполнено(Запись.НалогНаИмуществоПорядокНалогообложения) Тогда
		Запись.НалогНаИмуществоПорядокНалогообложения =
			ПредопределенноеЗначение("Перечисление.ПорядокНалогообложенияИмущества.ОсобыеЛьготыНеУстановлены");
	КонецЕсли;
	
	Элементы.ГруппаНалогНаИмущество.Видимость = Не НалогНаИмуществоНеПодлежитНалогообложению;
	
КонецПроцедуры

&НаКлиенте
Процедура НалогНаИмуществоПорядокНалогообложенияПриИзменении(Элемент)

	НалогНаИмуществоЗаполнитьКодЛьготы(ЭтотОбъект);
	УправлениеВидимостьюНалогНаИмуществоКодЛьготы(ЭтотОбъект);
	УправлениеВидимостьюНалогНаИмуществоКодОснованияЛьготы(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОткрытьПомощникНажатие(Элемент)
	
	ОбщаяСтавка = Новый Структура("НалогНаИмуществоПорядокНалогообложения,НалогНаИмуществоСтавка,НалогНаИмуществоКодЛьготы");
	ЗаполнитьЗначенияСвойств(ОбщаяСтавка, Запись);
	ПараметрыФормы = Новый Структура("Организация,Период,ОбщаяСтавка", Запись.Организация, Запись.Период, ОбщаяСтавка);
	ОткрытьФорму("Документ.РегистрацияСтавкиНалогаНаИмущество.Форма.ПомощникПерехода", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура НалогНаИмуществоКодЛьготыПриИзменении(Элемент)
	
	УправлениеВидимостьюНалогНаИмуществоКодОснованияЛьготы(ЭтотОбъект);
	
	Если Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения") Тогда
			
		Запись.НалогНаИмуществоКодЛьготы = НалогНаИмуществоКодЛьготы;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НалогНаИмуществоКодЛьготыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", "Код льготы");
	ПараметрыФормы.Вставить("ИмяМакета", "Документ.РегистрацияСтавкиНалогаНаИмущество.СпискиВыбора");
	ПараметрыФормы.Вставить("ТекущийПериод", Запись.Период);
	ПараметрыФормы.Вставить("ТекущийКод", НалогНаИмуществоКодЛьготы);

	Если Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.ОсвобождаетсяОтНалогообложения") Тогда

		ПараметрыФормы.Вставить("Префикс", "КодЛьготы");

	ИначеЕсли Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.ОблагаетсяПоСниженнойСтавке") Тогда

		ПараметрыФормы.Вставить("Префикс", "КодЛьготыСнижениеСтавки");
	
	ИначеЕсли Запись.НалогНаИмуществоПорядокНалогообложения = ПредопределенноеЗначение(
		"Перечисление.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент") Тогда

		ПараметрыФормы.Вставить("Префикс", "КодЛьготыСнижениеСуммы");

	Иначе
		
		Возврат;
				
	КонецЕсли;

	ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура НалогНаИмуществоКодОснованияЛьготыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОснованиеЛьготы", Элемент.ТекстРедактирования);
	ОткрытьФорму("ОбщаяФорма.ФормаВводаОснованияЛьготы", ПараметрыФормы, Элемент);

КонецПроцедуры

