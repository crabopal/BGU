&НаСервереБезКонтекста
Функция НаличиеСписковПрямыхРасходов(Организация)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	МетодыОпределенияПрямыхРасходовПроизводстваВНУ.ПериодДействия,
	|	МетодыОпределенияПрямыхРасходовПроизводстваВНУ.Организация
	|ИЗ
	|	РегистрСведений.МетодыОпределенияПрямыхРасходовПроизводстваВНУ КАК МетодыОпределенияПрямыхРасходовПроизводстваВНУ
	|ГДЕ
	|	МетодыОпределенияПрямыхРасходовПроизводстваВНУ.Организация = &Организация";

	РезультатЗапроса = Запрос.Выполнить();

	НаличиеСписков = Новый Структура();
	НаличиеСписков.Вставить("ЕстьСписокПрямыхРасходов", НЕ РезультатЗапроса.Пустой());

	Возврат НаличиеСписков;

КонецФункции

&НаКлиенте
Процедура МетодыОпределенияПрямыхРасходовПроизводстваНУ(Команда)

	НаличиеСписков = НаличиеСписковПрямыхРасходов(Запись.Организация);

	Если НаличиеСписков.ЕстьСписокПрямыхРасходов Тогда
		ОткрытьФормуОпределенияПрямыхРасходовНУ();
	Иначе
		
		ТекстВопроса = НСтр("ru = 'Список пуст.
		|
		|Создать записи, соответствующие рекомендациям ст.318 НК РФ?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьЗаписиПоРекомендациямПослеЗакрытияВопроса", ЭтотОбъект);
		ЗаголовокДиалогаВопроса = НСтр("ru = 'Методы определения прямых расходов НУ'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, ЗаголовокДиалогаВопроса);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаписиПоРекомендациямПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СтруктураЗаписи = Новый Структура("Организация, Период, РаспределятьОПЗ, РаспределятьОХЗ");
		ЗаполнитьЗначенияСвойств(СтруктураЗаписи, Запись);
		ЗаполнитьСписокПрямыхРасходов(СтруктураЗаписи);
	КонецЕсли;

	ОткрытьФормуОпределенияПрямыхРасходовНУ();

КонецПроцедуры

&НаКлиенте
Процедура ПорядокПризнанияРасходовУСН(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	ПараметрыФормы.Вставить("ПорядокПризнанияМатериальныхРасходов", Запись.ПорядокПризнанияМатериальныхРасходов);
	ПараметрыФормы.Вставить("ПорядокПризнанияРасходовПоТоварам", Запись.ПорядокПризнанияРасходовПоТоварам);
	ПараметрыФормы.Вставить("ПорядокПризнанияРасходовПоНДС", Запись.ПорядокПризнанияРасходовПоНДС);
	ПараметрыФормы.Вставить("ПорядокПризнанияДопРасходов", Запись.ПорядокПризнанияДопРасходов);
	ПараметрыФормы.Вставить("ПорядокПризнанияТаможенныхПлатежей", Запись.ПорядокПризнанияТаможенныхПлатежей);
	
	Оповещение = Новый ОписаниеОповещения(
		"ЗакрытиеФормыПорядокПризнанияРасходовУСН",
		ЭтотОбъект);
	
	ОткрытьФорму("РегистрСведений.УчетнаяПолитикаОрганизаций.Форма.ПорядокПризнанияРасходовУСН",
		ПараметрыФормы, ЭтаФорма,,,, Оповещение);
	
КонецПроцедуры

