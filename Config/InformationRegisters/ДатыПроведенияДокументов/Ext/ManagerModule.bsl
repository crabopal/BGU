#Область СлужебныйПрограммныйИнтерфейс

// Дата проведения документа, установленная пользователем.
// Если дата не заполнена или документа нет в определяемом типе ДокументыСОтдельнойДатойПроведения, возвращается пустая дата.
// 
// Параметры:
//  Ссылка - ОпределяемыйТип.ДокументыСОтдельнойДатойПроведения
// 
// Возвращаемое значение:
//  Дата 
Функция УстановленнаяДатаПроведения(Ссылка) Экспорт
	Если Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДатыПроведенияДокументов.ДатаПроведения
		|ИЗ
		|	РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
		|ГДЕ
		|	ДатыПроведенияДокументов.Документ = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		УстановитьПривилегированныйРежим(Истина);
		Выборка = Запрос.Выполнить().Выбрать();
		УстановитьПривилегированныйРежим(Ложь);
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ДатаПроведения;
		КонецЕсли;
	КонецЕсли;
	Возврат '00010101';
КонецФункции

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию2096(Параметры) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ПередачаОбъектовОС.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПередачаОбъектовОС КАК ПередачаОбъектовОС
	|ГДЕ
	|	НЕ ПередачаОбъектовОС.УдалитьДатаСписанияСБухУчета = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПередачаОбъектовИК.Ссылка
	|ИЗ
	|	Документ.ПередачаОбъектовИК КАК ПередачаОбъектовИК
	|ГДЕ
	|	НЕ ПередачаОбъектовИК.УдалитьДатаСписанияСБухУчета = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СписаниеЛитературы.Ссылка
	|ИЗ
	|	Документ.СписаниеЛитературы КАК СписаниеЛитературы
	|ГДЕ
	|	НЕ СписаниеЛитературы.УдалитьДатаСписанияСБухУчета = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СписаниеОбъектовИК.Ссылка
	|ИЗ
	|	Документ.СписаниеОбъектовИК КАК СписаниеОбъектовИК
	|ГДЕ
	|	НЕ СписаниеОбъектовИК.УдалитьДатаСписанияСБухУчета = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СписаниеОбъектовОС.Ссылка
	|ИЗ
	|	Документ.СписаниеОбъектовОС КАК СписаниеОбъектовОС
	|ГДЕ
	|	НЕ СписаниеОбъектовОС.УдалитьДатаСписанияСБухУчета = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СписаниеТранспорта.Ссылка
	|ИЗ
	|	Документ.СписаниеТранспорта КАК СписаниеТранспорта
	|ГДЕ
	|	НЕ СписаниеТранспорта.УдалитьДатаСписанияСБухУчета = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СписаниеТранспортаИК.Ссылка
	|ИЗ
	|	Документ.СписаниеТранспортаИК КАК СписаниеТранспортаИК
	|ГДЕ
	|	НЕ СписаниеТранспортаИК.УдалитьДатаСписанияСБухУчета = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)"); 
	
	МассивСсылок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, МассивСсылок);
	
КонецПроцедуры   

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию2096(Параметры) Экспорт  
	
	ОбработкаЗавершена = Истина;
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, "Документ.ПередачаОбъектовОС");
	Если Выборка.Количество() > 0 Тогда    
		ОбработкаЗавершена = Ложь;
		УстановитьДатыПроведенияДокумента(Выборка, "Документ.ПередачаОбъектовОС");
	КонецЕсли;  
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, "Документ.ПередачаОбъектовИК");
	Если Выборка.Количество() > 0 Тогда  
		ОбработкаЗавершена = Ложь;
		УстановитьДатыПроведенияДокумента(Выборка, "Документ.ПередачаОбъектовИК");
	КонецЕсли; 
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, "Документ.СписаниеЛитературы");
	Если Выборка.Количество() > 0 Тогда
		ОбработкаЗавершена = Ложь;
		УстановитьДатыПроведенияДокумента(Выборка, "Документ.СписаниеЛитературы");
	КонецЕсли;  
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, "Документ.СписаниеОбъектовИК");
	Если Выборка.Количество() > 0 Тогда
		УстановитьДатыПроведенияДокумента(Выборка, "Документ.СписаниеОбъектовИК");
	КонецЕсли; 
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, "Документ.СписаниеОбъектовОС");
	Если Выборка.Количество() > 0 Тогда 
		ОбработкаЗавершена = Ложь;
		УстановитьДатыПроведенияДокумента(Выборка, "Документ.СписаниеОбъектовОС");
	КонецЕсли;  
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, "Документ.СписаниеТранспорта");
	Если Выборка.Количество() > 0 Тогда 
		ОбработкаЗавершена = Ложь;
		УстановитьДатыПроведенияДокумента(Выборка, "Документ.СписаниеТранспорта");
	КонецЕсли;
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, "Документ.СписаниеТранспортаИК");
	Если Выборка.Количество() > 0 Тогда
		ОбработкаЗавершена = Ложь;
		УстановитьДатыПроведенияДокумента(Выборка, "Документ.СписаниеТранспортаИК");
	КонецЕсли;  
	
	Параметры.ОбработкаЗавершена = ОбработкаЗавершена;

КонецПроцедуры 

