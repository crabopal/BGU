#Область ОписаниеПеременных

&НаКлиенте
Перем СтруктураСохраняемыхРеквизитов;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустой() Тогда
		
		Если Не ЗначениеЗаполнено(Запись.Организация) И ЗначениеЗаполнено(Запись.ОсновноеСредство) Тогда
			Запись.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.ОсновноеСредство, "Организация");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Запись.ОсновноеСредство) Тогда
			ЗаполнитьПараметрыПоОсновномуСредству();
		КонецЕсли;

		УстановитьРеквизитыФормы();
		УстановитьСинонимОКТМО(ЭтотОбъект);
		УправлениеФормой(ЭтотОбъект);
		
	КонецЕсли;

	УстановитьУсловноеОформление();
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтотОбъект, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "РегистрСведений.РегистрацияЗемельныхУчастков.Форма.ФормаНастройкиЛьготы" Тогда
		ЗаполнитьЗначенияСвойств(Запись, ВыбранноеЗначение);
		УстановитьТекстНалоговойЛьготы(ЭтотОбъект);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УстановитьРеквизитыФормы();
	УстановитьСинонимОКТМО(ЭтотОбъект);
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Запись.ВидЗаписи <> Перечисления.ВидЗаписиОРегистрации.Регистрация Тогда
		Возврат;
	КонецЕсли;
	
	Если ПостановкаНаУчетВНалоговомОргане = 1 Тогда
		Если Не ЗначениеЗаполнено(Запись.НалоговыйОрган) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, , НСтр("ru = 'Налоговый орган'"));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Запись.НалоговыйОрган", , Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если КодОКТМОЗадан = 1 Тогда
		Если Не ЗначениеЗаполнено(Запись.КодПоОКАТО) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, , НСтр("ru = 'Код по ОКТМО'"));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Запись.КодПоОКАТО", , Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если ДоляУказана Тогда
		Если Не ЗначениеЗаполнено(Запись.ДоляВПравеОбщейСобственностиЧислитель) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, , НСтр("ru = 'Доля в праве на участок (числитель)'"));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Запись.ДоляВПравеОбщейСобственностиЧислитель", , Отказ);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Запись.ДоляВПравеОбщейСобственностиЗнаменатель) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, , НСтр("ru = 'Доля в праве на участок (знаменатель)'"));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Запись.ДоляВПравеОбщейСобственностиЗнаменатель", , Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если ЖилищноеСтроительство Тогда
		Если Не ЗначениеЗаполнено(Запись.ДатаНачалаПроектирования) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, , НСтр("ru = 'Начало проектирования'"));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Запись.ДатаНачалаПроектирования", , Отказ);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Запись.ДатаРегистрацииПравНаОбъектНедвижимости) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, , НСтр("ru = 'Регистрация прав на недвижимость'"));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Запись.ДатаРегистрацииПравНаОбъектНедвижимости", , Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "СведенияКадастровогоУчетаЗаписаны" Тогда
		УправлениеФормой(ЭтотОбъект, "НалоговаяБаза");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидЗаписиПриИзменении(Элемент)
	
	УправлениеФормой(ЭтотОбъект, "ВидЗаписи");
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ЗаполнитьПараметрыПоОсновномуСредству();
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоПриИзменении(Элемент)
	
	ЗаполнитьПараметрыПоОсновномуСредству();
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ЗаполнитьПараметрыПоОсновномуСредству();
	УправлениеФормой(ЭтотОбъект);
	УстановитьСинонимОКТМО(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПостановкаПоМестуНахожденияПриИзменении(Элемент)
	ПостановкаНаУчетВНалоговомОрганеПриИзменении();
КонецПроцедуры

&НаКлиенте
Процедура ПостановкаВДругомНОПриИзменении(Элемент)
	ПостановкаНаУчетВНалоговомОрганеПриИзменении();
КонецПроцедуры

&НаКлиенте
Процедура КодНалоговогоОрганаПриИзменении(Элемент)
	КодОКТМОЗаданПриИзменении();
КонецПроцедуры

&НаКлиенте
Процедура КодДругойПриИзменении(Элемент)
	КодОКТМОЗаданПриИзменении();
КонецПроцедуры

&НаКлиенте
Процедура КодКатегорииЗемельНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Префикс"		, "КатегорияЗемли");
	ПараметрыФормы.Вставить("Заголовок"		, "Выбор категории земли");
	ПараметрыФормы.Вставить("ТекущийКод"	, Элемент.ТекстРедактирования);
	ПараметрыФормы.Вставить("ТекущийПериод"	, Запись.Период);
	ПараметрыФормы.Вставить("ИмяМакета"		, "РегистрСведений.РегистрацияЗемельныхУчастков.СпискиКодов");
	
	ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КБКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Префикс"		, "КБК");
	ПараметрыФормы.Вставить("Заголовок"		, "Выбор КБК");
	ПараметрыФормы.Вставить("ТекущийКод"	, Элемент.ТекстРедактирования);
	ПараметрыФормы.Вставить("ТекущийПериод"	, Запись.Период);
	ПараметрыФормы.Вставить("ИмяМакета"		, "РегистрСведений.РегистрацияЗемельныхУчастков.СпискиКодов");
	
	ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщаяСобственностьПриИзменении(Элемент)
	
	Если ДоляУказана Тогда
		ВосстановитьЗначениеРеквизитаФормы("ДоляВПравеОбщейСобственностиЧислитель", Запись, СтруктураСохраняемыхРеквизитов);
		ВосстановитьЗначениеРеквизитаФормы("ДоляВПравеОбщейСобственностиЗнаменатель", Запись, СтруктураСохраняемыхРеквизитов);
	Иначе
		СохранитьЗначениеРеквизитаФормы("ДоляВПравеОбщейСобственностиЧислитель", Запись, СтруктураСохраняемыхРеквизитов);
		СохранитьЗначениеРеквизитаФормы("ДоляВПравеОбщейСобственностиЗнаменатель", Запись, СтруктураСохраняемыхРеквизитов);
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект, "ОбщаяСобственность");
	
КонецПроцедуры

&НаКлиенте
Процедура ЖилищноеСтроительствоПриИзменении(Элемент)
	
	Если ЖилищноеСтроительство Тогда
		ВосстановитьЗначениеРеквизитаФормы("ДатаНачалаПроектирования", Запись, СтруктураСохраняемыхРеквизитов);
		ВосстановитьЗначениеРеквизитаФормы("ДатаРегистрацииПравНаОбъектНедвижимости", Запись, СтруктураСохраняемыхРеквизитов);
	Иначе
		СохранитьЗначениеРеквизитаФормы("ДатаНачалаПроектирования", Запись, СтруктураСохраняемыхРеквизитов);
		СохранитьЗначениеРеквизитаФормы("ДатаРегистрацииПравНаОбъектНедвижимости", Запись, СтруктураСохраняемыхРеквизитов);
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект, "ЖилищноеСтроительство");
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстНалоговойБазыНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если ТекстНалоговойБазы = НСтр("ru = 'Не задана'") И ДоступноРедактированиеНалоговойБазы Тогда
		
		ПараметрыФормы = Новый Структура;	
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Период", Запись.Период);	
		ЗначенияЗаполнения.Вставить("Организация", Запись.Организация);	
		ЗначенияЗаполнения.Вставить("ОсновноеСредство", Запись.ОсновноеСредство);	
		ЗначенияЗаполнения.Вставить("ИнвентарныйНомер", Запись.ИнвентарныйНомер);	
		ЗначенияЗаполнения.Вставить("ВидОбъектаНедвижимости", ПредопределенноеЗначение(
			"Перечисление.ВидыОбъектовНедвижимости.ЗемельныйУчасток"));	
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);	
		
		ОткрытьФорму("РегистрСведений.СведенияКадастровогоУчета.ФормаЗаписи", ПараметрыФормы, ЭтотОбъект);
		
	Иначе
		
		ОткрытьСписокСведенияКадастровогоУчета();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТекстНалоговойЛьготыНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения,ТолькоПросмотр", Запись, ТолькоПросмотр);
	ОткрытьФорму("РегистрСведений.РегистрацияЗемельныхУчастков.Форма.ФормаНастройкиЛьготы", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИсторияНалоговойБазы(Команда)
	ОткрытьСписокСведенияКадастровогоУчета();
КонецПроцедуры

// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтотОбъект, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ИмяФормы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьРеквизитыФормы()
	
	ПостановкаНаУчетВНалоговомОргане = ?(ЗначениеЗаполнено(Запись.НалоговыйОрган), 1, 0);
	КодОКТМОЗадан = ?(ЗначениеЗаполнено(Запись.КодПоОКАТО), 1, 0);	
	ДоляУказана = ЗначениеЗаполнено(Запись.ДоляВПравеОбщейСобственностиЧислитель)
		Или ЗначениеЗаполнено(Запись.ДоляВПравеОбщейСобственностиЗнаменатель);
	ЖилищноеСтроительство = ЗначениеЗаполнено(Запись.ДатаНачалаПроектирования)
		Или ЗначениеЗаполнено(Запись.ДатаРегистрацииПравНаОбъектНедвижимости);	

	ДоступноРедактированиеНалоговойБазы = ПравоДоступа("Редактирование",
		Метаданные.РегистрыСведений.СведенияКадастровогоУчета);
	ДоступенПросмотрНалоговойБазы = ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.СведенияКадастровогоУчета);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПостановкаНаУчетВНалоговомОрганеПриИзменении()
	
	Если ПостановкаНаУчетВНалоговомОргане = 1 Тогда
		ВосстановитьЗначениеРеквизитаФормы("НалоговыйОрган", Запись, СтруктураСохраняемыхРеквизитов);
	Иначе
		СохранитьЗначениеРеквизитаФормы("НалоговыйОрган", Запись, СтруктураСохраняемыхРеквизитов);
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект, "НалоговыйОрган");
	
КонецПроцедуры

&НаКлиенте
Процедура КодОКТМОЗаданПриИзменении()
	
	Если КодОКТМОЗадан = 1 Тогда
		ВосстановитьЗначениеРеквизитаФормы("КодПоОКАТО", Запись, СтруктураСохраняемыхРеквизитов);
	Иначе
		СохранитьЗначениеРеквизитаФормы("КодПоОКАТО", Запись, СтруктураСохраняемыхРеквизитов);
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект, "КодПоОКАТО");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма, ЭлементУправления = "")
	
	Запись = Форма.Запись;
	Элементы = Форма.Элементы;
	ПостановкаНаУчетВНалоговомОргане = Форма.ПостановкаНаУчетВНалоговомОргане;
	КодОКТМОЗадан = Форма.КодОКТМОЗадан;
	ДоляУказана = Форма.ДоляУказана;
	ЖилищноеСтроительство = Форма.ЖилищноеСтроительство;
	
	Если ЭлементУправления = "ВидЗаписи" Или ЭлементУправления = "" Тогда
		ЭтоРегистрация = (Запись.ВидЗаписи = ПредопределенноеЗначение("Перечисление.ВидЗаписиОРегистрации.Регистрация"));
		Элементы.ПараметрыРегистрации.Видимость = ЭтоРегистрация;
	КонецЕсли;
	
	Если ЭлементУправления = "НалоговыйОрган" Или ЭлементУправления = "" Тогда
		Элементы.НалоговыйОрган.Доступность               = (ПостановкаНаУчетВНалоговомОргане = 1);
		Элементы.НалоговыйОрган.АвтоОтметкаНезаполненного = (ПостановкаНаУчетВНалоговомОргане = 1);
		Элементы.НалоговыйОрган.ОтметкаНезаполненного     = (ПостановкаНаУчетВНалоговомОргане = 1) 
			И Запись.НалоговыйОрган.Пустая();
	КонецЕсли;
	
	Если ЭлементУправления = "КодПоОКАТО" Или ЭлементУправления = "" Тогда
		Элементы.КодПоОКАТО.Доступность               = (КодОКТМОЗадан = 1);
		Элементы.КодПоОКАТО.АвтоОтметкаНезаполненного = (КодОКТМОЗадан = 1);
		Элементы.КодПоОКАТО.ОтметкаНезаполненного     = (КодОКТМОЗадан = 1) И ПустаяСтрока(Запись.КодПоОКАТО);
	КонецЕсли;
	
	Если ЭлементУправления = "НалоговаяЛьгота" Или ЭлементУправления = "" Тогда
		УстановитьТекстНалоговойЛьготы(Форма);
	КонецЕсли;
	
	Если ЭлементУправления = "ОбщаяСобственность" Или ЭлементУправления = "" Тогда
		
		Элементы.ДоляВПравеОбщейСобственностиЧислитель.Доступность               = ДоляУказана;
		Элементы.ДоляВПравеОбщейСобственностиЧислитель.АвтоОтметкаНезаполненного = ДоляУказана;
		Элементы.ДоляВПравеОбщейСобственностиЧислитель.ОтметкаНезаполненного     = ДоляУказана 
			И Запись.ДоляВПравеОбщейСобственностиЧислитель = 0;
		
		Элементы.ДоляВПравеОбщейСобственностиЗнаменатель.Доступность               = ДоляУказана;
		Элементы.ДоляВПравеОбщейСобственностиЗнаменатель.АвтоОтметкаНезаполненного = ДоляУказана;
		Элементы.ДоляВПравеОбщейСобственностиЗнаменатель.ОтметкаНезаполненного     = ДоляУказана 
			И Запись.ДоляВПравеОбщейСобственностиЗнаменатель = 0;
		
	КонецЕсли;
	
	Если ЭлементУправления = "ЖилищноеСтроительство" Или ЭлементУправления = "" Тогда
		
		Элементы.ДатаНачалаПроектирования.Доступность				= ЖилищноеСтроительство;
		Элементы.ДатаНачалаПроектирования.АвтоОтметкаНезаполненного	= ЖилищноеСтроительство;
		Элементы.ДатаНачалаПроектирования.ОтметкаНезаполненного     = ЖилищноеСтроительство 
			И Не ЗначениеЗаполнено(Запись.ДатаНачалаПроектирования);
		
		Элементы.ДатаРегистрацииПравНаОбъектНедвижимости.Доступность				= ЖилищноеСтроительство;
		Элементы.ДатаРегистрацииПравНаОбъектНедвижимости.АвтоОтметкаНезаполненного	= ЖилищноеСтроительство;
		Элементы.ДатаРегистрацииПравНаОбъектНедвижимости.ОтметкаНезаполненного		= ЖилищноеСтроительство 
			И Не ЗначениеЗаполнено(Запись.ДатаРегистрацииПравНаОбъектНедвижимости);
		
	КонецЕсли;
	
	Если ЭлементУправления = "НалоговаяБаза" Или ЭлементУправления = "" Тогда
		УстановитьТекстНалоговойБазы(Форма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыПоОсновномуСредству()
	
	Если Не ЗначениеЗаполнено(Запись.ОсновноеСредство) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.Организация) Тогда
		Запись.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.ОсновноеСредство, "Организация");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОсновноеСредство", Запись.ОсновноеСредство);
	Запрос.УстановитьПараметр("Организация",      Запись.Организация);
	Запрос.УстановитьПараметр("Период",           Запись.Период);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегистрацияЗемельныхУчастковСрезПоследних.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	РегистрацияЗемельныхУчастковСрезПоследних.КодКатегорииЗемель КАК КодКатегорииЗемель,
	|	РегистрацияЗемельныхУчастковСрезПоследних.ДоляВПравеОбщейСобственностиЧислитель КАК ДоляВПравеОбщейСобственностиЧислитель,
	|	РегистрацияЗемельныхУчастковСрезПоследних.ДоляВПравеОбщейСобственностиЗнаменатель КАК ДоляВПравеОбщейСобственностиЗнаменатель,
	|	РегистрацияЗемельныхУчастковСрезПоследних.ДатаНачалаПроектирования КАК ДатаНачалаПроектирования,
	|	РегистрацияЗемельныхУчастковСрезПоследних.ДатаРегистрацииПравНаОбъектНедвижимости КАК ДатаРегистрацииПравНаОбъектНедвижимости,
	|	РегистрацияЗемельныхУчастковСрезПоследних.НалоговыйОрган КАК НалоговыйОрган,
	|	РегистрацияЗемельныхУчастковСрезПоследних.КодПоОКАТО КАК КодПоОКАТО,
	|	РегистрацияЗемельныхУчастковСрезПоследних.КБК КАК КБК,
	|	РегистрацияЗемельныхУчастковСрезПоследних.НалоговаяСтавка КАК НалоговаяСтавка,
	|	РегистрацияЗемельныхУчастковСрезПоследних.НалоговаяЛьготаПоНалоговойБазе КАК НалоговаяЛьготаПоНалоговойБазе,
	|	РегистрацияЗемельныхУчастковСрезПоследних.КодНалоговойЛьготыОсвобождениеОтНалогообложенияПоСтатье395 КАК КодНалоговойЛьготыОсвобождениеОтНалогообложенияПоСтатье395,
	|	РегистрацияЗемельныхУчастковСрезПоследних.ДоляНеОблагаемойНалогомПлощадиЧислитель КАК ДоляНеОблагаемойНалогомПлощадиЧислитель,
	|	РегистрацияЗемельныхУчастковСрезПоследних.ДоляНеОблагаемойНалогомПлощадиЗнаменатель КАК ДоляНеОблагаемойНалогомПлощадиЗнаменатель,
	|	РегистрацияЗемельныхУчастковСрезПоследних.НеОблагаемаяНалогомСумма КАК НеОблагаемаяНалогомСумма,
	|	РегистрацияЗемельныхУчастковСрезПоследних.СниженнаяНалоговаяСтавка КАК СниженнаяНалоговаяСтавка,
	|	РегистрацияЗемельныхУчастковСрезПоследних.ПроцентУменьшенияСуммыНалога КАК ПроцентУменьшенияСуммыНалога,
	|	РегистрацияЗемельныхУчастковСрезПоследних.СуммаУменьшенияСуммыНалога КАК СуммаУменьшенияСуммыНалога
	|ИЗ
	|	РегистрСведений.РегистрацияЗемельныхУчастков.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство) КАК РегистрацияЗемельныхУчастковСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		УстановитьРеквизитыФормы();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.ИнвентарныйНомер) Тогда
		ПараметрыОС = Новый Структура("ОсновноеСредство", Запись.ОсновноеСредство);
		Результат = УправлениеОсновнымиСредствами.ПолучитьДанныеИнвентарногоНомераОС(ПараметрыОС);
		Запись.ИнвентарныйНомер = Результат.ИнвентарныйНомер;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТекстНалоговойБазы(Форма)
	
	Запись = Форма.Запись;
	ДоступенПросмотрНалоговойБазы = Форма.ДоступенПросмотрНалоговойБазы;
	
	ТекстНалоговойБазы = "";
	Если ДоступенПросмотрНалоговойБазы Тогда
		
		СведенияНалоговойБазы = СведенияНалоговойБазы(Запись.Организация, Запись.ОсновноеСредство,
			Запись.ИнвентарныйНомер);
		
		Если СведенияНалоговойБазы.НалоговаяБаза > 0 Тогда
			ТекстНалоговойБазы = СтрШаблон(НСтр("ru = '%1 руб. c %2'"), 
				Формат(СведенияНалоговойБазы.НалоговаяБаза, "ЧДЦ=2"),
				Формат(СведенияНалоговойБазы.ДатаПрименения, "ДЛФ=D"));
		КонецЕсли;
		
	Иначе
		ТекстНалоговойБазы = НСтр("ru = 'Не доступно'");
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстНалоговойБазы) Тогда
		ТекстНалоговойБазы = НСтр("ru = 'Не задана'");
	КонецЕсли;
	
	Форма.ТекстНалоговойБазы = ТекстНалоговойБазы;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СведенияНалоговойБазы(Знач Организация, Знач ОсновноеСредство, Знач ИнвентарныйНомер)
	
	СведенияНалоговойБазы = Новый Структура;
	СведенияНалоговойБазы.Вставить("ДатаПрименения", Дата(1,1,1));
	СведенияНалоговойБазы.Вставить("НалоговаяБаза", 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СведенияКадастровогоУчета.КадастроваяСтоимость КАК КадастроваяСтоимость,
		|	СведенияКадастровогоУчета.Период КАК Период,
		|	СведенияКадастровогоУчета.ДатаПримененияНовойСтоимостиКРасчетуНалога КАК ДатаПримененияНовойСтоимостиКРасчетуНалога
		|ИЗ
		|	РегистрСведений.СведенияКадастровогоУчета КАК СведенияКадастровогоУчета
		|ГДЕ
		|	СведенияКадастровогоУчета.Организация = &Организация
		|	И СведенияКадастровогоУчета.ОсновноеСредство = &ОсновноеСредство
		|	И СведенияКадастровогоУчета.ИнвентарныйНомер = &ИнвентарныйНомер
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвентарныйНомер", ИнвентарныйНомер);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат СведенияНалоговойБазы;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	СведенияНалоговойБазы.НалоговаяБаза = Выборка.КадастроваяСтоимость;
	
	Если ЗначениеЗаполнено(Выборка.ДатаПримененияНовойСтоимостиКРасчетуНалога) Тогда
		СведенияНалоговойБазы.ДатаПрименения = Выборка.ДатаПримененияНовойСтоимостиКРасчетуНалога; 
	Иначе
		СведенияНалоговойБазы.ДатаПрименения = ДатаПримененияКадастровойСтоимости(
			Выборка.КадастроваяСтоимость,
			Организация,
			ОсновноеСредство,
			ИнвентарныйНомер,
			Выборка.Период); 
	КонецЕсли;
	
	Возврат СведенияНалоговойБазы;	
КонецФункции

&НаСервереБезКонтекста
Функция ДатаПримененияКадастровойСтоимости(КадастроваяСтоимость, Организация, ОсновноеСредство, ИнвентарныйНомер,
	Период)
	
	ДатаПримененияКадастровойСтоимости = Период;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СведенияКадастровогоУчета.Период КАК Период
		|ИЗ
		|	РегистрСведений.СведенияКадастровогоУчета КАК СведенияКадастровогоУчета
		|ГДЕ
		|	СведенияКадастровогоУчета.Организация = &Организация
		|	И СведенияКадастровогоУчета.ОсновноеСредство = &ОсновноеСредство
		|	И СведенияКадастровогоУчета.ИнвентарныйНомер = &ИнвентарныйНомер
		|	И СведенияКадастровогоУчета.КадастроваяСтоимость <> 0
		|	И СведенияКадастровогоУчета.КадастроваяСтоимость <> &КадастроваяСтоимость
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвентарныйНомер", ИнвентарныйНомер);
	Запрос.УстановитьПараметр("КадастроваяСтоимость", КадастроваяСтоимость);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		// ранее кадастровая стоимость не устанавливалась
		Возврат ДатаПримененияКадастровойСтоимости;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	// было изменение кадастровой стоимости
	// уточним дату первого применения новой стоимости
	
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СведенияКадастровогоУчета.Период КАК Период
		|ИЗ
		|	РегистрСведений.СведенияКадастровогоУчета КАК СведенияКадастровогоУчета
		|ГДЕ
		|	СведенияКадастровогоУчета.Период > &ДатаПоследнейУстановки
		|	И СведенияКадастровогоУчета.Организация = &Организация
		|	И СведенияКадастровогоУчета.ОсновноеСредство = &ОсновноеСредство
		|	И СведенияКадастровогоУчета.ИнвентарныйНомер = &ИнвентарныйНомер
		|	И СведенияКадастровогоУчета.КадастроваяСтоимость = &КадастроваяСтоимость
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	
	Запрос.УстановитьПараметр("ДатаПоследнейУстановки", Выборка.Период);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ДатаПримененияКадастровойСтоимости = Выборка.Период;
	КонецЕсли;

	Если НачалоГода(ДатаПримененияКадастровойСтоимости) <> ДатаПримененияКадастровойСтоимости Тогда
		ДатаПримененияКадастровойСтоимости = НачалоГода(ДобавитьМесяц(ДатаПримененияКадастровойСтоимости, 12));
	КонецЕсли;
	
	Возврат ДатаПримененияКадастровойСтоимости;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТекстНалоговойЛьготы(Форма)
	
	Запись = Форма.Запись;
	
	Льгота = Запись.НалоговаяЛьготаПоНалоговойБазе;
	ОписаниеНалоговыхЛьгот = Новый Массив;
	
	Если Льгота = ПредопределенноеЗначение(
		"Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.ОсвобождениеОтНалогообложенияМестное") Тогда
		
		ТекстНалоговойЛьготы = НСтр("ru = 'Освобождение от налогообложения'");
		ОписаниеНалоговыхЛьгот.Добавить(ТекстНалоговойЛьготы);
		
	ИначеЕсли Льгота = ПредопределенноеЗначение(
		"Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.ОсвобождениеОтНалогообложенияПоСтатье395") Тогда
		
		Шаблон = НСтр("ru = 'Освобождение от налогообложения (%1)'");
		ТекстНалоговойЛьготы = СтрШаблон(Шаблон, Запись.КодНалоговойЛьготыОсвобождениеОтНалогообложенияПоСтатье395);
		ОписаниеНалоговыхЛьгот.Добавить(ТекстНалоговойЛьготы);
		
	Иначе
		
		Если Льгота = ПредопределенноеЗначение(
			"Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.УменьшениеНалоговойБазы") Тогда
				
			Шаблон = НСтр("ru = 'Не облагаемая налогом сумма %1 руб.'");
			ТекстНалоговойЛьготы = СтрШаблон(Шаблон, Запись.НеОблагаемаяНалогомСумма);
			ОписаниеНалоговыхЛьгот.Добавить(ТекстНалоговойЛьготы);
			
		ИначеЕсли Льгота = ПредопределенноеЗначение(
			"Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.НеОблагаемаяНалогомПлощадь") Тогда
				
			Шаблон = НСтр("ru = 'Доля необлагаемой площади %1 / %2'");
			ТекстНалоговойЛьготы = СтрШаблон(Шаблон,
				Запись.ДоляНеОблагаемойНалогомПлощадиЧислитель, Запись.ДоляНеОблагаемойНалогомПлощадиЗнаменатель);
			ОписаниеНалоговыхЛьгот.Добавить(ТекстНалоговойЛьготы);
				
		КонецЕсли;

		Если Запись.СуммаУменьшенияСуммыНалога <> 0 Тогда
			
			Шаблон = НСтр("ru = 'Уменьшение суммы налога на %1 руб.'");
			ТекстНалоговойЛьготы = СтрШаблон(Шаблон, Запись.СуммаУменьшенияСуммыНалога);
			ОписаниеНалоговыхЛьгот.Добавить(ТекстНалоговойЛьготы);
				
		ИначеЕсли Запись.ПроцентУменьшенияСуммыНалога <> 0 Тогда
			
			Шаблон = НСтр("ru = 'Уменьшение суммы налога на %1 %2'");
			ТекстНалоговойЛьготы = СтрШаблон(Шаблон, Запись.ПроцентУменьшенияСуммыНалога, "%");
			ОписаниеНалоговыхЛьгот.Добавить(ТекстНалоговойЛьготы);
				
		КонецЕсли;
		
	КонецЕсли;
	
	Если Запись.СниженнаяНалоговаяСтавка <> 0 Тогда		

		Шаблон = НСтр("ru = 'Снижение налоговой ставки до %1 %2'");
		ТекстНалоговойЛьготы = СтрШаблон(Шаблон, Запись.СниженнаяНалоговаяСтавка, "%");
		ОписаниеНалоговыхЛьгот.Добавить(ТекстНалоговойЛьготы);
		
	КонецЕсли;
	
	Если ОписаниеНалоговыхЛьгот.Количество() = 0 Тогда
		ТекстНалоговойЛьготы = НСтр("ru = 'Не применяется'");
		ОписаниеНалоговыхЛьгот.Добавить(ТекстНалоговойЛьготы);
	КонецЕсли;
	
	Форма.ТекстНалоговойЛьготы = СтрСоединить(ОписаниеНалоговыхЛьгот, Символы.ПС);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьЗначениеРеквизитаФормы(ИмяРеквизита, Данные, СтруктураРеквизитов) Экспорт
	
	Если Не Элементы[ИмяРеквизита].Доступность Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРеквизитов.Вставить(ИмяРеквизита, Данные[ИмяРеквизита]);
	
	Данные[ИмяРеквизита] = ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Данные[ИмяРеквизита]));
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьЗначениеРеквизитаФормы(ИмяРеквизита, Данные, СтруктураРеквизитов) Экспорт
	
	Если Элементы[ИмяРеквизита].Доступность И Не Элементы[ИмяРеквизита].ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураРеквизитов.Свойство(ИмяРеквизита) Тогда
		Данные[ИмяРеквизита] = СтруктураРеквизитов[ИмяРеквизита];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСинонимОКТМО(Форма)
	
	Запись = Форма.Запись;
	Элементы = Форма.Элементы;
	
	КодОКТМО = БухгалтерскийУчетКлиентСервер.ОКАТООКТМОПоДате(Запись.Период, "ОКАТО", "ОКТМО");
	ТекстЗаголовка = СтрШаблон(НСтр("ru = 'Код по %1'"), КодОКТМО); 
	Элементы.ГруппаКодОКТМО.Заголовок = ТекстЗаголовка;
	Элементы.КодПоОКАТО.Заголовок = ТекстЗаголовка; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокСведенияКадастровогоУчета()
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", Запись.Организация);
	Отбор.Вставить("ОсновноеСредство", Запись.ОсновноеСредство);
	Отбор.Вставить("ИнвентарныйНомер", Запись.ИнвентарныйНомер);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);		
	ОткрытьФорму("РегистрСведений.СведенияКадастровогоУчета.ФормаСписка", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТекстНалоговойБазы");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ТекстНалоговойБазы", ВидСравненияКомпоновкиДанных.Равно, НСтр("ru = 'Не задана'"));
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненныйРеквизит);
	
КонецПроцедуры

