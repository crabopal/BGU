
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗначенияЗаполнения") Тогда
		ЗаполнитьРеквизитыФормы(Параметры.ЗначенияЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность Тогда
		
		Отказ = Истина;
		
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(КодВозврата, ДопПараметры) Экспорт 
	
	Если КодВозврата = КодВозвратаДиалога.Да Тогда
		
		ЗаписатьДанные();
		
	ИначеЕсли КодВозврата = КодВозвратаДиалога.Нет Тогда
		
		Модифицированность = Ложь;
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если УменьшениеНалоговойБазы = 1 Тогда 
		ПроверяемыеРеквизиты.Добавить("НеОблагаемаяНалогомСумма");
	ИначеЕсли УменьшениеНалоговойБазы = 2 Тогда		
		ПроверяемыеРеквизиты.Добавить("ДоляЧислитель");
		ПроверяемыеРеквизиты.Добавить("ДоляЗнаменатель");
	КонецЕсли;
	
	Если УменьшениеСуммыНалога = 2 Тогда
		ПроверяемыеРеквизиты.Добавить("КодЛьготы395");
	ИначеЕсли УменьшениеСуммыНалога = 3 Тогда
		ПроверяемыеРеквизиты.Добавить("СуммаУменьшенияСуммыНалога");
	ИначеЕсли УменьшениеСуммыНалога = 4 Тогда
		ПроверяемыеРеквизиты.Добавить("ПроцентУменьшенияСуммыНалога");
	КонецЕсли;
	
	Если СнижениеНалоговойСтавки Тогда
		ПроверяемыеРеквизиты.Добавить("СниженнаяНалоговаяСтавка");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КодЛьготы395НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Префикс"		, "КодЛьготы395");
	ПараметрыФормы.Вставить("Заголовок"		, "Выбор льготы");
	ПараметрыФормы.Вставить("ТекущийКод"	, Элемент.ТекстРедактирования);
	ПараметрыФормы.Вставить("ТекущийПериод"	, Период);
	ПараметрыФормы.Вставить("ИмяМакета"		, "РегистрСведений.РегистрацияЗемельныхУчастков.СпискиКодов");
	
	ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура УменьшениеСуммыНалогаПриИзменении(Элемент)
	
	Если УменьшениеСуммыНалога = 1 Или УменьшениеСуммыНалога = 2 Тогда
		УменьшениеНалоговойБазы = 0;
	КонецЕсли;
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура УменьшениеНалоговойБазыПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура СнижениеНалоговойСтавкиПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	ЗаписатьДанные();
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Модифицированность = Ложь;
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.КодЛьготы395.Видимость					= (УменьшениеСуммыНалога = 2);
	Элементы.СуммаУменьшенияСуммыНалога.Видимость	= (УменьшениеСуммыНалога = 3);
	Элементы.ПроцентУменьшенияСуммыНалога.Видимость	= (УменьшениеСуммыНалога = 4);
	
	Элементы.Группа3.Доступность = (УменьшениеСуммыНалога <> 1 И УменьшениеСуммыНалога <> 2);
	
	Элементы.НеОблагаемаяНалогомСумма.Видимость	= (УменьшениеНалоговойБазы = 1);
	Элементы.ГруппаДоля.Видимость				= (УменьшениеНалоговойБазы = 2);
	
	Элементы.СниженнаяНалоговаяСтавка.Видимость = СнижениеНалоговойСтавки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДанные()
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	
	ОповеститьОВыборе(ВернутьПараметрыДляЗаполнения());
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыФормы(ЗначенияЗаполнения)
	
	Льгота = ЗначенияЗаполнения.НалоговаяЛьготаПоНалоговойБазе;
	Льготы = Перечисления.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе;
	
	Если ЗначенияЗаполнения.ПроцентУменьшенияСуммыНалога <> 0 Тогда
		УменьшениеСуммыНалога = 4;
		ПроцентУменьшенияСуммыНалога = ЗначенияЗаполнения.ПроцентУменьшенияСуммыНалога;
	КонецЕсли;
	
	Если ЗначенияЗаполнения.СуммаУменьшенияСуммыНалога <> 0 Тогда
		УменьшениеСуммыНалога = 3;
		СуммаУменьшенияСуммыНалога = ЗначенияЗаполнения.СуммаУменьшенияСуммыНалога;
	КонецЕсли;
	
	Если Льгота = Льготы.ОсвобождениеОтНалогообложенияМестное Тогда
		УменьшениеСуммыНалога = 1;
	ИначеЕсли Льгота = Льготы.ОсвобождениеОтНалогообложенияПоСтатье395 Тогда
		УменьшениеСуммыНалога = 2;
		КодЛьготы395 = ЗначенияЗаполнения.КодНалоговойЛьготыОсвобождениеОтНалогообложенияПоСтатье395;
	ИначеЕсли Льгота = Льготы.УменьшениеНалоговойБазы Тогда
		УменьшениеНалоговойБазы = 1;
		НеОблагаемаяНалогомСумма = ЗначенияЗаполнения.НеОблагаемаяНалогомСумма;
	ИначеЕсли Льгота = Льготы.НеОблагаемаяНалогомПлощадь Тогда
		УменьшениеНалоговойБазы = 2;
		ДоляЧислитель	= ЗначенияЗаполнения.ДоляНеОблагаемойНалогомПлощадиЧислитель;
		ДоляЗнаменатель	= ЗначенияЗаполнения.ДоляНеОблагаемойНалогомПлощадиЗнаменатель;
	КонецЕсли;
	
	Если ЗначенияЗаполнения.СниженнаяНалоговаяСтавка <> 0 Тогда
		СнижениеНалоговойСтавки = Истина;
		СниженнаяНалоговаяСтавка = ЗначенияЗаполнения.СниженнаяНалоговаяСтавка;
	КонецЕсли;
	
	Период = ЗначенияЗаполнения.Период;
	
КонецПроцедуры

&НаКлиенте
Функция ВернутьПараметрыДляЗаполнения()
	
	ЗначенияЗаполнения = Новый Структура(
		"НалоговаяЛьготаПоНалоговойБазе,
		|КодНалоговойЛьготыОсвобождениеОтНалогообложенияПоСтатье395,
		|СуммаУменьшенияСуммыНалога,
		|ПроцентУменьшенияСуммыНалога,
		|НеОблагаемаяНалогомСумма,
		|ДоляНеОблагаемойНалогомПлощадиЧислитель,
		|ДоляНеОблагаемойНалогомПлощадиЗнаменатель,
		|СниженнаяНалоговаяСтавка");
	
	Если УменьшениеСуммыНалога = 1 Тогда
		ЗначенияЗаполнения.НалоговаяЛьготаПоНалоговойБазе =
			ПредопределенноеЗначение("Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.ОсвобождениеОтНалогообложенияМестное");
	ИначеЕсли УменьшениеСуммыНалога = 2 Тогда	
		ЗначенияЗаполнения.НалоговаяЛьготаПоНалоговойБазе =
			ПредопределенноеЗначение("Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.ОсвобождениеОтНалогообложенияПоСтатье395");
		ЗначенияЗаполнения.КодНалоговойЛьготыОсвобождениеОтНалогообложенияПоСтатье395 = КодЛьготы395;
	ИначеЕсли УменьшениеНалоговойБазы = 1 Тогда 
		ЗначенияЗаполнения.НалоговаяЛьготаПоНалоговойБазе =
			ПредопределенноеЗначение("Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.УменьшениеНалоговойБазы");
		ЗначенияЗаполнения.НеОблагаемаяНалогомСумма = НеОблагаемаяНалогомСумма;
	ИначеЕсли УменьшениеНалоговойБазы = 2 Тогда
		ЗначенияЗаполнения.НалоговаяЛьготаПоНалоговойБазе =
			ПредопределенноеЗначение("Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.НеОблагаемаяНалогомПлощадь");
		ЗначенияЗаполнения.ДоляНеОблагаемойНалогомПлощадиЧислитель		= ДоляЧислитель;
		ЗначенияЗаполнения.ДоляНеОблагаемойНалогомПлощадиЗнаменатель	= ДоляЗнаменатель;
	Иначе
		ЗначенияЗаполнения.НалоговаяЛьготаПоНалоговойБазе =
			ПредопределенноеЗначение("Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.НеПрименяется");
	КонецЕсли;
	
	Если УменьшениеСуммыНалога = 3 Тогда
		ЗначенияЗаполнения.СуммаУменьшенияСуммыНалога = СуммаУменьшенияСуммыНалога;
	ИначеЕсли УменьшениеСуммыНалога = 4 Тогда
		ЗначенияЗаполнения.ПроцентУменьшенияСуммыНалога = ПроцентУменьшенияСуммыНалога;
	КонецЕсли;
	
	Если СнижениеНалоговойСтавки Тогда
		ЗначенияЗаполнения.СниженнаяНалоговаяСтавка = СниженнаяНалоговаяСтавка;
	КонецЕсли;
	
	Возврат ЗначенияЗаполнения;
	
КонецФункции

#КонецОбласти
