#Область ПрограммныйИнтерфейс

// Возвращает данные из регистра по ребенку на дату.
// 
// Параметры:
// 	Дата - Дата - дата получения данных
// 	Организация - СправочникСсылка.Организации - организация
// 	Ребенок - СправочникСсылка.Дети - ребенок
// Возвращаемое значение:
// 	Структура - структура с ключами:
//  * Плательщик - СправочникСсылка.Контрагенты - плательщик
//  * СчетПлательщика - СправочникСсылка.БанковскиеИКазначейскиеСчета - банковский счет плательщика
Функция ДанныеПлательщикаРебенка(Дата, Организация, Ребенок) Экспорт
	
	Данные = Новый Структура("Плательщик, СчетПлательщика");
	Данные.Плательщик = Справочники.Контрагенты.ПустаяСсылка();
	Данные.СчетПлательщика = Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПлательщикиПоУслугамДДУСрезПоследних.Плательщик,
	|	ПлательщикиПоУслугамДДУСрезПоследних.СчетПлательщика
	|ИЗ
	|	РегистрСведений.ПлательщикиПоУслугамДДУ.СрезПоследних(&Дата, Ребенок = &Ребенок И Организация = &Организация) КАК
	|		ПлательщикиПоУслугамДДУСрезПоследних";
	Запрос.УстановитьПараметр("Дата",        Дата);
	Запрос.УстановитьПараметр("Ребенок",     Ребенок);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Данные, Выборка);
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

