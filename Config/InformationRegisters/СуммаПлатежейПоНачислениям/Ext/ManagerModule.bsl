Процедура ПерезаполнитьПоДаннымСоответствияНачисленийИПлатежей() Экспорт
	//для перезаполнения регистра
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоответствиеНачисленийИПлатежей.Начисление КАК Начисление,
		|	СУММА(СоответствиеНачисленийИПлатежей.Платеж.СуммаДокумента) КАК СуммаПлатежей,
		|	СУММА(СоответствиеНачисленийИПлатежей.Платеж.СуммаВозврата) КАК СуммаВозвратов
		|ПОМЕСТИТЬ ТабДанные
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.БанковскийИдентификаторПлатежаЗаполнен = ИСТИНА
		|	И НЕ СоответствиеНачисленийИПлатежей.Начисление В (&ПустыеСсылки)
		|
		|СГРУППИРОВАТЬ ПО
		|	СоответствиеНачисленийИПлатежей.Начисление
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ТабДанные.Начисление, СуммаПлатежейПоНачислениям.Начисление) КАК Начисление,
		|	ЕСТЬNULL(ТабДанные.СуммаПлатежей, 0) КАК СуммаПлатежей,
		|	ЕСТЬNULL(ТабДанные.СуммаВозвратов, 0) КАК СуммаВозвратов
		|ИЗ
		|	ТабДанные КАК ТабДанные
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.СуммаПлатежейПоНачислениям КАК СуммаПлатежейПоНачислениям
		|		ПО ТабДанные.Начисление = СуммаПлатежейПоНачислениям.Начисление
		|ГДЕ
		|	ЕСТЬNULL(СуммаПлатежейПоНачислениям.СуммаПлатежей, 0) <> ЕСТЬNULL(ТабДанные.СуммаПлатежей, 0)";
	
	ПустыеСсылки = Новый Массив;
	ПустыеСсылки.Добавить(Документы.КвитанцияНаОплатуГосуслуг.ПустаяСсылка());
	ПустыеСсылки.Добавить(Документы.НачислениеОтПодведомственного.ПустаяСсылка());
	
	Запрос.УстановитьПараметр("ПустыеСсылки",ПустыеСсылки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Запись = РегистрыСведений.СуммаПлатежейПоНачислениям.СоздатьМенеджерЗаписи();
		Запись.Начисление = ВыборкаДетальныеЗаписи.Начисление;
		Запись.СуммаПлатежей = ВыборкаДетальныеЗаписи.СуммаПлатежей;
		Запись.СуммаВозвратов = ВыборкаДетальныеЗаписи.СуммаВозвратов;
		Запись.Записать(Истина);
	КонецЦикла;
		
КонецПроцедуры

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СоответствиеНачисленийИПлатежей.Начисление КАК Начисление
	|ИЗ
	|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
	|ГДЕ
	|	СоответствиеНачисленийИПлатежей.БанковскийИдентификаторПлатежаЗаполнен = ИСТИНА
	|	И НЕ СоответствиеНачисленийИПлатежей.Начисление В (&ПустыеСсылки)
	|	И НЕ ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					РегистрСведений.СуммаПлатежейПоНачислениям КАК ТТ
	|				ГДЕ
	|					ТТ.Начисление = СоответствиеНачисленийИПлатежей.Начисление)";
	
	ПустыеСсылки = Новый Массив;
	ПустыеСсылки.Добавить(Документы.КвитанцияНаОплатуГосуслуг.ПустаяСсылка());
	ПустыеСсылки.Добавить(Документы.НачислениеОтПодведомственного.ПустаяСсылка());
	
	Запрос.УстановитьПараметр("ПустыеСсылки",ПустыеСсылки);
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = "РегистрСведений.СуммаПлатежейПоНачислениям";
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры,Запрос.Выполнить().Выгрузить(),ДополнительныеПараметры);

КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяРегистра = "РегистрСведений.СуммаПлатежейПоНачислениям";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
			
	РезультатВыборки = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуИзмеренийНезависимогоРегистраСведенийДляОбработки(
		Параметры.Очередь,
		ПолноеИмяРегистра,
		МенеджерВременныхТаблиц,		
		ДополнительныеПараметры);
	
	Если НЕ РезультатВыборки.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	ИначеЕсли НЕ РезультатВыборки.ЕстьЗаписиВоВременнойТаблице Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВременнойТаблицы = РезультатВыборки.ИмяВременнойТаблицы;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СоответствиеНачисленийИПлатежей.Начисление КАК Начисление,
		|	ПРЕДСТАВЛЕНИЕ(СоответствиеНачисленийИПлатежей.Начисление) КАК НачислениеПредставление,
		|	СУММА(СоответствиеНачисленийИПлатежей.Платеж.СуммаДокумента) КАК СуммаПлатежей
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.БанковскийИдентификаторПлатежаЗаполнен = ИСТИНА
		|	И СоответствиеНачисленийИПлатежей.Начисление В
		|			(ВЫБРАТЬ
		|				ТТ.Начисление
		|			ИЗ
		|				&ТТ КАК ТТ)
		|
		|СГРУППИРОВАТЬ ПО
		|	СоответствиеНачисленийИПлатежей.Начисление";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ТТ",ИмяВременнойТаблицы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НачатьТранзакцию();
		Попытка
				
			ПредставлениеОбъекта = ВыборкаДетальныеЗаписи.НачислениеПредставление;
			НаборЗаписей = РегистрыСведений.СуммаПлатежейПоНачислениям.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Начисление.Установить(ВыборкаДетальныеЗаписи.Начисление);
			
			Запись = НаборЗаписей.Добавить();
			Запись.Начисление = ВыборкаДетальныеЗаписи.Начисление;
			Запись.СуммаПлатежей = ВыборкаДетальныеЗаписи.СуммаПлатежей;
			
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей,Истина,Ложь,Ложь);		
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось обработать объект: %Объект% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Объект%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
									УровеньЖурналаРегистрации.Ошибка,
									ВыборкаДетальныеЗаписи.Начисление.Метаданные(),
									ВыборкаДетальныеЗаписи.Начисление,
									ТекстСообщения);
				
		КонецПопытки;
	КонецЦикла;
	
	Если РезультатЗапроса.Пустой() Тогда
		//если из регистра были удалены записи, то чтобы не было зацикливания, отметим, что обработка выполнена
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТТ.Начисление
			|ИЗ
			|	&ТТ КАК ТТ";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"&ТТ",ИмяВременнойТаблицы);
		
		ТаблицаДанных = Запрос.Выполнить().Выгрузить();
		ДопПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
		ДопПараметры.ЭтоНезависимыйРегистрСведений = Истина;
		ДопПараметры.ПолноеИмяРегистра = "РегистрСведений.СуммаПлатежейПоНачислениям";
	
		ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ТаблицаДанных,ДопПараметры,Параметры.Очередь);
		
	КонецЕсли;
			
	Параметры.ОбработкаЗавершена = НЕ ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь,
		ПолноеИмяРегистра);
		
		
		
КонецПроцедуры


#КонецЕсли