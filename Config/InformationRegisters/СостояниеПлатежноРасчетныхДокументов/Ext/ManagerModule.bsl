#Область ПрограммныйИнтерфейс

// Печать первичных образов расчетных документов, импортированных
// из файлов казначейства
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если ПараметрыПечати.Свойство("ИмяМакета") И ПараметрыПечати.Свойство("ОбъектПечати") Тогда
		Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, ПараметрыПечати.ИмяМакета) Тогда
			// Формируем табличный документ и добавляем его в коллекцию печатных форм.
			УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ПараметрыПечати.ИмяМакета, "Печать первичного образа документа",
			ПечатьОбраза(ПараметрыПечати.ОбъектПечати, ОбъектыПечати));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

#Область ОбновлениеИнформационнойБазы

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции


Процедура ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, Область, ИсточникПараметров, ПоляПодвала, Шапка = Неопределено, ШапкаРаздела = Неопределено)
	
	ВыводимыеОбласти = Новый Массив();
	ВыводимыеОбласти.Добавить(Макет.ПолучитьОбласть(Область));
	ВыводимыеОбласти.Добавить(Макет.ПолучитьОбласть("Подвал"));
	ВыводимыеОбласти[0].Параметры.Заполнить(ИсточникПараметров);
	ВыводимыеОбласти[1].Параметры.Заполнить(ПоляПодвала);
	
	Попытка 
		Если НЕ ТабДокумент.ПроверитьВывод(ВыводимыеОбласти) Тогда
			ТабДокумент.Вывести(ВыводимыеОбласти[1]);
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			Если НЕ ШапкаРаздела = Неопределено Тогда
				ТабДокумент.Вывести(ШапкаРаздела);	
			КонецЕсли;	
			Если НЕ Шапка = Неопределено Тогда
				ТабДокумент.Вывести(Макет.ПолучитьОбласть(Шапка));	
			КонецЕсли;	
		КонецЕсли;
		ТабДокумент.Вывести(ВыводимыеОбласти[0]);
	Исключение
		Сообщить("В системе не установлено ни одного принтера.");
	КонецПопытки;
	
КонецПроцедуры  

Процедура ВывестиОбластьСПодсчетомСтраниц_Подвал(Макет, ТабДокумент, Область, ИсточникПараметров, ПоляПодвала, Шапка = Неопределено, ШапкаРаздела = Неопределено, ЛокальныйПодвал = Неопределено)  
		
	ВыводимыеОбласти = Новый Массив();
	ВыводимыеОбласти.Добавить(Макет.ПолучитьОбласть(Область));
	ВыводимыеОбласти[0].Параметры.Заполнить(ИсточникПараметров);
	Если НЕ ЛокальныйПодвал = Неопределено Тогда
		ВыводимыеОбласти.Добавить(ЛокальныйПодвал);
	КонецЕсли;
	
	Попытка
		Если НЕ ТабДокумент.ПроверитьВывод(ВыводимыеОбласти) Тогда
			Если НЕ ЛокальныйПодвал = Неопределено Тогда
				ТабДокумент.Вывести(ЛокальныйПодвал);
			КонецЕсли;
			
			//ТабДокумент.Вывести(ВыводимыеОбласти[1]);
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			Если НЕ ШапкаРаздела = Неопределено Тогда
				ТабДокумент.Вывести(ШапкаРаздела);	
			КонецЕсли;	
			Если НЕ Шапка = Неопределено Тогда
				ТабДокумент.Вывести(Макет.ПолучитьОбласть(Шапка));	
			КонецЕсли;	
		КонецЕсли;
		ТабДокумент.Вывести(ВыводимыеОбласти[0]);
	Исключение
//		Сообщить("В системе не установлено ни одного принтера.");
	КонецПопытки;

КонецПроцедуры


// Формирует табличный документ, заполненный значениями переданных
// параметров
//
Функция ОткрытьДокументВМакете(Знач Параметры, ИмяМакета, НазваниеДокумента, ТабДокумент)       
	
	Перем ВидПлатежа;
	Перем НомерДок;
	Перем СуммаДок;
	
	МассивВО = Новый Массив;
	МассивВО.Добавить(" ");
	МассивВО.Добавить("почтой");
	МассивВО.Добавить("телеграфом");
	МассивВО.Добавить("электронно");
	МассивВО.Добавить("срочно");
	
	ВидПлатежа = 0;
	Если Параметры.Свойство("ВидПлатежа", ВидПлатежа) Тогда
		Попытка
			ВидПлатежа = Число(ВидПлатежа);
		Исключение
			ВидПлатежа = 0;
		КонецПопытки;
		
		Если ВидПлатежа > 4 Тогда
			ВидПлатежа = 0;
		КонецЕсли;
	Иначе
		ВидПлатежа = 0;
	КонецЕсли;
	Параметры.Вставить("ВидПлатежа", МассивВО[ВидПлатежа]);
	
	Если Параметры.Свойство("НомерДокумента", НомерДок) Тогда
		НомерДок = Строка(НомерДок);
	Иначе	
		НомерДок = "";	
	КонецЕсли;
	Параметры.Вставить("НаименованиеНомер", НазваниеДокумента + НомерДок);
	
	Если Параметры.Свойство("СуммаДокумента", СуммаДок) Тогда
		Попытка
			СуммаДок = Число(СуммаДок);
		Исключение
			СуммаДок = 0;
		КонецПопытки;
	Иначе
		СуммаДок = 0;
	КонецЕсли; 
	
	Параметры.Вставить("СуммаЧислом", ПлатежноРасчетныеДокументы.ФорматироватьСуммуПлатежногоДокумента(СуммаДок, ЛОЖЬ));
	Параметры.Вставить("СуммаПрописью", ПлатежноРасчетныеДокументы.ФорматироватьСуммуПрописьюПлатежногоДокумента(СуммаДок, , ЛОЖЬ));
	
	Комментарий = "";
	
	Если Параметры.Свойство("ОФКДатаЗачисления") Тогда
		Комментарий = "Дата зачисления на счет ОрФК - " + Параметры.ОФКДатаЗачисления;
	КонецЕсли;
	
	Если Параметры.Свойство("ОФКGUID") Тогда
		Комментарий = Комментарий + " /GUID " + Параметры.ОФКGUID;
	КонецЕсли;  
	
	Параметры.Вставить("Комментарий", Комментарий);
	
	Если Параметры.Свойство("ИННПлательщика") Тогда
		ИННПлательщика = "ИНН " + Параметры.ИННПлательщика;   
		Параметры.Вставить("ИННПлательщика", ИННПлательщика);
	КонецЕсли;    
	
	Если Параметры.Свойство("ИННПолучателя") Тогда
		ИННПолучателя = "ИНН " + Параметры.ИННПолучателя;   
		Параметры.Вставить("ИННПолучателя", ИННПолучателя);
	КонецЕсли; 
	
	Если Параметры.Свойство("КПППлательщика") Тогда
		КПППлательщика = "КПП " + Параметры.КПППлательщика;   
		Параметры.Вставить("КПППлательщика", КПППлательщика);
	КонецЕсли;    
	
	Если Параметры.Свойство("КПППолучателя") Тогда
		КПППолучателя = "КПП " + Параметры.КПППолучателя;   
		Параметры.Вставить("КПППолучателя", КПППолучателя);
	КонецЕсли; 
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент;
	КонецЕсли;	
	
	Если Параметры.ВидОперации = "ZR" Тогда
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявкаНаКассовыйРасход."+ИмяМакета);
		Обл   = Макет.ПолучитьОбласть("Заголовок");
		
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(Параметры.ДатаДок);
		
		Параметры.Вставить("ЧислоДаты", СтруктураДаты.Число);	
		Параметры.Вставить("МесяцДаты", СтруктураДаты.Месяц);
		Параметры.Вставить("ГодДаты",   СтруктураДаты.Год);
		
		ДанныеДляПечати = Параметры;
		
		// вывод в табличный документ
		ОбластьВывода = Макет.ПолучитьОбласть("Заголовок");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		
		ТабДокумент.Вывести(ОбластьВывода);
		
		// Раздел 1
		ШапкаРаздела 			= Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "1");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_1", ДанныеДляПечати, ДанныеДляПечати, ,ШапкаРаздела); 
		
		// Раздел 2
		
		//<-- раздел 2 со след. страницы
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ШапкаРаздела = Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "2");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		
		ТабДокумент.Вывести(ШапкаРаздела);
		//<--
		
		// таблица раздела 2
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2", Новый Структура, ДанныеДляПечати);  		 
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2_Строка", ДанныеДляПечати, ДанныеДляПечати, "Раздел_2_Шапка", ШапкаРаздела);  
		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Разделитель_2"));
		
		// Раздел 3
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_3", ДанныеДляПечати, ДанныеДляПечати, ,ШапкаРаздела); 
		
		// Раздел 4
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_4", ДанныеДляПечати, ДанныеДляПечати, ,ШапкаРаздела); 		
		// Раздел 5
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ШапкаРаздела = Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "3");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ШапкаРаздела);
		
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_5", Новый Структура, ДанныеДляПечати);  
		Для Каждого СтрВыборка Из ДанныеДляПечати.РасшифровкаПлатежа Цикл 
			ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_5_Строка", СтрВыборка, ДанныеДляПечати, "Раздел_5_Шапка", ШапкаРаздела);  
		КонецЦикла;
		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Разделитель"));
		
		// последняя подпись ответственного исполнителя 
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		//ОбластьВывода.Области.ОбластьМестоПечати.Текст = "М.П.";
		ТабДокумент.Вывести(ОбластьВывода);
		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("ОтметкаФК"));
		
	ИначеЕсли Параметры.ВидОперации = "ZV" Тогда
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявкаНаВозврат."+ИмяМакета);
		Обл   = Макет.ПолучитьОбласть("Заголовок");
		
		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(Параметры.ДатаДок);
		
		Параметры.Вставить("ЧислоДаты", СтруктураДаты.Число);	
		Параметры.Вставить("МесяцДаты", СтруктураДаты.Месяц);
		Параметры.Вставить("ГодДаты",   СтруктураДаты.Год);
		
		ДанныеДляПечати = Параметры;
		
		ОбластьВывода = Макет.ПолучитьОбласть("Заголовок");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		
		ТабДокумент.Вывести(ОбластьВывода);
		
		// дальше надо смотреть, умещается ли на страницу
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_1", ДанныеДляПечати, ДанныеДляПечати); 
		
		ШапкаРаздела 			= Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "1");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_2", ДанныеДляПечати, ДанныеДляПечати, ,ШапкаРаздела); 
		
		
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ШапкаРаздела 			= Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "2");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ШапкаРаздела);
		
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел_3", ДанныеДляПечати, ДанныеДляПечати, ,ШапкаРаздела); 
		
		// последняя подпись ответственного исполнителя 
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("ОтметкаФК")); 
		
	ИначеЕсли Параметры.ВидОперации = "UK" Тогда
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.УведомлениеОбУточненииОперацийКлиента." + ИмяМакета);
		
		ДанныеДляПечати = Параметры;
		
		ОблЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		ОблЗаголовок.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОблЗаголовок);
		
		// дальше надо смотреть, умещается ли на страницу
		// Раздел 1
		ШапкаРаздела = Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "1");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		ВывестиОбластьСПодсчетомСтраниц(Макет, ТабДокумент, "Раздел1_Ш", Новый Структура(), ДанныеДляПечати, ,ШапкаРаздела); 
		
		ЛокальныйПодвал = Макет.ПолучитьОбласть("Раздел1_П");
		
		Для Каждого СтрВыборка Из ДанныеДляПечати.РеквизитыПлатежногоДокумента Цикл 
			ВывестиОбластьСПодсчетомСтраниц_Подвал(Макет, ТабДокумент, "Раздел1_С", СтрВыборка, ДанныеДляПечати, "Раздел1_Ш", ШапкаРаздела, ЛокальныйПодвал);  
		КонецЦикла;
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Раздел1_П"));
		
		// Раздел 2
		//ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		ШапкаРаздела = Макет.ПолучитьОбласть("ШапкаРаздела");
		ДанныеДляПечати.Вставить("пНомерСтраницы", "2");
		ШапкаРаздела.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Раздел2_Ш"));
		ЛокальныйПодвал = Макет.ПолучитьОбласть("Раздел2_П");
		
		Для Каждого СтрВыборка Из ДанныеДляПечати.ИзмененныеРеквизиты Цикл
			ВывестиОбластьСПодсчетомСтраниц_Подвал(Макет, ТабДокумент, "Раздел2_С", СтрВыборка, ДанныеДляПечати, "Раздел2_Ш", ШапкаРаздела, ЛокальныйПодвал);  
		КонецЦикла;
		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Раздел2_П"));
		ОблПодвал = Макет.ПолучитьОбласть("Подвал");
		ОблПодвал.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОблПодвал);
		
		ОблПодвал = Макет.ПолучитьОбласть("Отметки");
		ТабДокумент.Вывести(ОблПодвал);	  
		
	ИначеЕсли Лев(Параметры.ВидОперации, 2) = "ED" Тогда
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет." + ИмяМакета);
		Обл   = Макет.ПолучитьОбласть("Сообщение");
		Обл.Параметры.Заполнить(Параметры);
		
		ТабДокумент.Вывести(Обл);
		
	Иначе
	
		Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет." + ИмяМакета);
		Обл   = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
		Обл.Параметры.Заполнить(Параметры);
		
		ТабДокумент.Вывести(Обл);
		
	КонецЕсли;
	
    Возврат ТабДокумент;
КонецФункции

Функция ПечатьОбраза(МассивОбъектов, ОбъектыПечати)
	
	ТабДокумент = Новый ТабличныйДокумент;
	Если МассивОбъектов = Неопределено Тогда
		Возврат ТабДокумент;
	КонецЕсли;
	
	Для Каждого ПервичныйОбраз Из МассивОбъектов Цикл
		Если НЕ ТипЗнч(ПервичныйОбраз) = Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;	
		
		ВидОперации = "";
		Если ПервичныйОбраз.Свойство("ВидОперации", ВидОперации) Тогда 
			Если ВидОперации = "01" Тогда
				//01 Списано, зачислено по платежному поручению
				ТабДокумент = ОткрытьДокументВМакете(ПервичныйОбраз, "ПФ_MXL_ПлатежноеПоручение", "ПЛАТЕЖНОЕ ПОРУЧЕНИЕ N ", ТабДокумент);
			ИначеЕсли ВидОперации = "16" Тогда	
				//16 Списано, зачислено по платежному ордеру
				ТабДокумент = ОткрытьДокументВМакете(ПервичныйОбраз, "ПФ_MXL_ПлатежныйОрдер", "ПЛАТЕЖНЫЙ ОРДЕР N ", ТабДокумент);
			ИначеЕсли ВидОперации = "ZR" Тогда	
				//Списано, зачислено по Заявке на кассовый расход
				ТабДокумент = ОткрытьДокументВМакете(ПервичныйОбраз, "ПФ_MXL_Форма0531801_16н", "ЗАЯВКА НА КАССОВЫЙ РАСХОД N ", ТабДокумент);
			ИначеЕсли ВидОперации = "ZV" Тогда	
				//Списано, зачислено по Заявке на возврат
				ТабДокумент = ОткрытьДокументВМакете(ПервичныйОбраз, "ПФ_MXL_Форма0531803_16н", "ЗАЯВКА НА ВОЗВРАТ N ", ТабДокумент);
			ИначеЕсли ВидОперации = "UK" Тогда	
				//Списано, зачислено по Заявке на возврат
				ТабДокумент = ОткрытьДокументВМакете(ПервичныйОбраз, "ПФ_MXL_Форма0531852_21н", "УВЕДОМЛЕНИЕ ОБ УТОЧНЕНИИ ОПЕРАЦИЙ КЛИЕНТА N ", ТабДокумент);	
			ИначеЕсли ВидОперации = "0" Тогда
				//Списано, зачислено по Поручению о перечислении на счет
				ТабДокумент = ОткрытьДокументВМакете(ПервичныйОбраз, "ПФ_MXL_РеквизитыПлатежногоДокумента", "ПОРУЧЕНИЕ О ПЕРЕЧИСЛЕНИИ НА СЧЕТ N ", ТабДокумент);
			ИначеЕсли ВидОперации = "ED206" Тогда
				//Списано, зачислено по Поручению о перечислении на счет
				ТабДокумент = ОткрытьДокументВМакете(ПервичныйОбраз, "ПодтверждениеДебета_УФЭБС", "ПОДТВЕРЖДЕНИЕ ДЕБЕТА N ", ТабДокумент);	
			ИначеЕсли ВидОперации = "ED222" Тогда
				//Списано, зачислено по Поручению о перечислении на счет
				ТабДокумент = ОткрытьДокументВМакете(ПервичныйОбраз, "ИзвещениеОДКдляКассовыхдокументов", "ИЗВЕЩЕНИЕ О ДЕБЕТЕ/КРЕДИТЕ ДЛЯ КАССОВЫХ ДОКУМЕНТОВ N ", ТабДокумент);	
			Иначе
				// неизвестный тип документа или значение не заполнено
				ТабДокумент = ОткрытьДокументВМакете(ПервичныйОбраз, "ПФ_MXL_РеквизитыПлатежногоДокумента", "ПЛАТЕЖНЫЙ ДОКУМЕНТ N ", ТабДокумент);
			КонецЕсли;   
		Иначе
			// неизвестный тип документа или значение не заполнено   
			ПервичныйОбраз.Вставить("ВидОперации", ВидОперации);
			ТабДокумент = ОткрытьДокументВМакете(ПервичныйОбраз, "ПФ_MXL_РеквизитыПлатежногоДокумента", "ПЛАТЕЖНЫЙ ДОКУМЕНТ N ", ТабДокумент);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции	

#КонецОбласти

#КонецЕсли