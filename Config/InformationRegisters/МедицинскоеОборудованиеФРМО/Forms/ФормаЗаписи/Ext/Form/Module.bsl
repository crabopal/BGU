
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Запись, ЭтотОбъект);
	
	Если Параметры.Свойство("Аудит") Тогда
		ИсполнитьАудит(Параметры.Аудит);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИнициализироватьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		
		Если ВыбранноеЗначение.Свойство("ЭтоРегистрационноеУдостоверение") Тогда
			
			Запись.НомерУдостоверения	= ВыбранноеЗначение.Номер;
			Запись.ДатаРегистрации		= ВыбранноеЗначение.Дата;
			Запись.Модель				= ВыбранноеЗначение.Модель;
			Запись.Производитель		= ВыбранноеЗначение.Производитель;
			Запись.СтранаПроизводства	= ВыбранноеЗначение.Страна;
			
			ЗаполнитьТипРазделИзРУ(ВыбранноеЗначение.ВидМодели);
			
			Модифицированность = Истина;
			
		КонецЕсли;
		
		Если ВыбранноеЗначение.Свойство("ЭтоМестонахождение") Тогда
			
			Если ВыбранноеЗначение.Ключ = "ЭтажиПомещения" Тогда
				ЭтажиПомещения.ЗагрузитьЗначения(ВыбранноеЗначение.Данные);
				УстановитьЗаголовокЭтажиПомещения();
			ИначеЕсли ВыбранноеЗначение.Ключ = "ОтделенияКабинеты" Тогда
				ОтделенияКабинеты.ЗагрузитьЗначения(ВыбранноеЗначение.Данные);
				УстановитьЗаголовокОтделенияКабинеты();
			КонецЕсли;
			
			Модифицированность = Истина;
			
		КонецЕсли;
		
		Если ВыбранноеЗначение.Свойство("ЭтоОС") Тогда
			
			Запись.ОсновноеСредство = ВыбранноеЗначение.ОсновноеСредство;
			Запись.ИнвентарныйНомер = ВыбранноеЗначение.ИнвентарныйНомер;
			
			ОсновноеСредствоПриИзменении(Неопределено); // TODO: Вынести из обработчика
			
			Модифицированность = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбменФРМО"
		И Параметр.ОсновноеСредство = Запись.ОсновноеСредство
		И Параметр.ИнвентарныйНомер = Запись.ИнвентарныйНомер Тогда
		
		Если Параметр.Операция = "Обновлено" Тогда
			Прочитать();
			ИнициализироватьФорму();
		ИначеЕсли Параметр.Операция = "Удалено" Тогда
			//Закрыть();
			ТолькоПросмотр = Истина;
			Элементы.ПодобратьУдостоверение.Доступность = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПрочитатьМестонахождение();
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СохранитьМестонахождение();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	УстановитьЗаголовокЭтажиПомещения();
	УстановитьЗаголовокОтделенияКабинеты();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ВидМестоположения = 1 // Иной адрес
		И Не ЗначениеЗаполнено(Запись.Адрес) Тогда
		ПроверяемыеРеквизиты.Добавить("АдресПредставление");
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Запись"));
		Отказ = Истина;
	КонецЕсли;
	
	Если Не РазделИТипСоответствуют() Тогда
		ТекстСообщения = НСтр("ru = 'Тип медицинского изделия не соответствует разделу'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Запись.ТипИзделия",, Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	ОчиститьРеквизитыОС();
	ОчиститьРеквизитыОбъекта();
	
	УстановитьВидимостьПолейСписания();
	УстановитьВидимостьПолейПоТипуОборудования(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоПриИзменении(Элемент)
	
	ОчиститьРеквизитыОС();
	ОчиститьРеквизитыОбъекта();
	
	Если ЗначениеЗаполнено(Запись.ОсновноеСредство) Тогда
		ОсновноеСредствоПриИзмененииСервер();
	КонецЕсли;
	
	УстановитьВидимостьПолейСписания();
	УстановитьВидимостьПолейПоТипуОборудования();
	
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныйНомерПриИзменении(Элемент)
	
	ОчиститьРеквизитыОбъекта();
	
	Если ЗначениеЗаполнено(Запись.ИнвентарныйНомер) Тогда
		ПрочитатьДанныеОбъекта();
	Иначе
		ЗаполнитьДанныеПустогоОбъекта(Запись);
	КонецЕсли;
	
	УстановитьВидимостьПолейСписания();
	УстановитьВидимостьПолейПоТипуОборудования();
	УстановитьДоступностьКоличества();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипОборудованияПриИзменении(Элемент)
	
	УстановитьВидимостьПолейПоТипуОборудования();
	
КонецПроцедуры

&НаКлиенте
Процедура РазделИзделияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Запись.ТипИзделия) И Не ЗначениеЗаполнено(Запись.РазделИзделия) Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = РазделыТипаИзделия(Запись.ТипИзделия);
	Иначе
		ОткрытьФормуВыбораКлассификацииИзделия(Элемент, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазделИзделияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка) 
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ОбработатьВыборКлассификацииИзделия(ВыбранноеЗначение, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипИзделияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФормуВыбораКлассификацииИзделия(Элемент, СтандартнаяОбработка)
	
КонецПроцедуры

&НаКлиенте
Процедура ТипИзделияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ОбработатьВыборКлассификацииИзделия(ВыбранноеЗначение, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭксплуатацияЗавершенаПриИзменении(Элемент)
	
	УстановитьВидимостьПолейСписания();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидМестоположенияПриИзменении(Элемент)
	
	Запись.ИнойАдрес = (ВидМестоположения = 1);
	УстановитьВидимостьПолейМестоположения();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗданиеПриИзменении(Элемент)
	
	ЭтажиПомещения.Очистить();
	УстановитьЗаголовокЭтажиПомещения();
	
	ОтделенияКабинеты.Очистить();
	УстановитьЗаголовокОтделенияКабинеты();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЭтажиНажатие(Элемент)
	
	ЕстьОшибки = Ложь;
	
	Если Не ЗначениеЗаполнено(Запись.Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать организацию'"),, "Запись.Организация",, ЕстьОшибки);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.Здание) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать здание'"),, "Запись.Здание",, ЕстьОшибки);
	КонецЕсли;
	
	Если ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	ВыбираемыеТипы = Новый Массив;
	ВыбираемыеТипы.Добавить(ПредопределенноеЗначение("Перечисление.ТипыМестонахожденияФРМО.Помещение"));
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ"				, "ЭтажиПомещения");
	ПараметрыФормы.Вставить("Заголовок"			, НСтр("ru = 'Этажи и помещения'"));
	ПараметрыФормы.Вставить("Организация"		, Запись.Организация);
	ПараметрыФормы.Вставить("Родитель"			, Запись.Здание);
	ПараметрыФормы.Вставить("ВыбираемыеТипы"	, ВыбираемыеТипы);
	ПараметрыФормы.Вставить("Данные"			, ЭтажиПомещения.ВыгрузитьЗначения());
	ПараметрыФормы.Вставить("ТолькоПросмотр"	, ТолькоПросмотр);
	
	ОткрытьФорму("РегистрСведений.МедицинскоеОборудованиеФРМО.Форма.ФормаПодбораМестонахождения", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	ОтделенияКабинеты.Очистить();
	УстановитьЗаголовокОтделенияКабинеты();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияКабинетыНажатие(Элемент)
	
	ЕстьОшибки = Ложь;
	
	Если Не ЗначениеЗаполнено(Запись.Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать организацию'"),, "Запись.Организация",, ЕстьОшибки);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.Здание) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать здание'"),, "Запись.Здание",, ЕстьОшибки);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.Подразделение) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать подразделение'"),, "Запись.Подразделение",, ЕстьОшибки);
	КонецЕсли;
	
	Если ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	ВыбираемыеТипы = Новый Массив;
	ВыбираемыеТипы.Добавить(ПредопределенноеЗначение("Перечисление.ТипыМестонахожденияФРМО.Отделение"));
	ВыбираемыеТипы.Добавить(ПредопределенноеЗначение("Перечисление.ТипыМестонахожденияФРМО.Кабинет"));
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ"				, "ОтделенияКабинеты");
	ПараметрыФормы.Вставить("Заголовок"			, НСтр("ru = 'Отделения и кабинеты'"));
	ПараметрыФормы.Вставить("Организация"		, Запись.Организация);
	ПараметрыФормы.Вставить("Здание"			, Запись.Здание);
	ПараметрыФормы.Вставить("Родитель"			, Запись.Подразделение);
	ПараметрыФормы.Вставить("ВыбираемыеТипы"	, ВыбираемыеТипы);
	ПараметрыФормы.Вставить("Данные"			, ОтделенияКабинеты.ВыгрузитьЗначения());
	ПараметрыФормы.Вставить("ТолькоПросмотр"	, ТолькоПросмотр);
	
	ОткрытьФорму("РегистрСведений.МедицинскоеОборудованиеФРМО.Форма.ФормаПодбораМестонахождения", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ВидКонтактнойИнформации"	, ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.АдресМестонахожденияОбъектаОС"));
	ПараметрыОткрытияФормы.Вставить("ЗначенияПолей"				, ?(ЗначениеЗаполнено(Запись.Адрес), АдресФРМОвБГУ(Запись.Адрес), ""));
	
	ОповещениеЗакрытия = Новый ОписаниеОповещения("АдресЗавершениеРедактирования", ЭтотОбъект);
	УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыОткрытияФормы, ЭтотОбъект, ОповещениеЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресОчистка(Элемент, СтандартнаяОбработка)
	
	Запись.Адрес = "";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодобратьОС(Команда)
	
	ПараметрыФормы = Новый Структура("Организация", Запись.Организация);
	ОткрытьФорму("РегистрСведений.МедицинскоеОборудованиеФРМО.Форма.ФормаПодбораОС", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьУдостоверение(Команда)
	
	ПараметрыФормы = Новый Структура("ВидМодели", Запись.ТипИзделия);
	ОткрытьФорму("РегистрСведений.МедицинскоеОборудованиеФРМО.Форма.ФормаПодбораРегистрационногоУдостоверения", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьСтрану(Команда)
	
	ПараметрыФормы = Новый Структура("РежимВыбора", Истина);
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораСтраны", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.СтраныМира.ФормаВыбора", ПараметрыФормы, ЭтотОбъект,,,,
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИнициализироватьФорму()
	
	ВидМестоположения = ?(Запись.ИнойАдрес, 1, 0);
	УстановитьПредставлениеАдреса();
	
	УстановитьВидимостьПолейСписания();
	
	УстановитьВидимостьПолейПоТипуОборудования();
	УстановитьВидимостьПолейМестоположения();
	
	УстановитьДоступностьКоличества();
	
	УстановитьЗаголовокЭтажиПомещения();
	УстановитьЗаголовокОтделенияКабинеты();
	
	Элементы.ПодобратьОС.Доступность = Не ТолькоПросмотр;
	Элементы.ПодобратьУдостоверение.Доступность = Не ТолькоПросмотр;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРеквизитыОС()
	
	Запись.Наименование	= "";
	Запись.СрокСлужбы	= 0;
	Запись.Адрес		= "";
	Запись.ИнойАдрес	= Ложь;
	ВидМестоположения	= 0;
	АдресПредставление	= ""; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРеквизитыОбъекта()
	
	Запись.ИнвентарныйНомерКод			= "";
	Запись.СерийныйНомер				= "";
	Запись.ПричинаВыводаИзЭксплуатации	= "";
	Запись.ДатаВводаВЭксплуатацию		= '00010101';
	Запись.ДатаВыводаИзЭксплуатации		= '00010101';
	Запись.ДатаВыпуска					= '00010101';
	Запись.Количество					= 0;
	Запись.ЭксплуатацияЗавершена		= Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПредставлениеАдреса()
	
	АдресПредставление = ?(Не ЗначениеЗаполнено(Запись.Адрес), "",
		ПредставлениеАдреса(Запись.Адрес));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеАдреса(Адрес)
	
	Возврат ОбщегоНазначения.JSONВЗначение(Адрес)["Представление"];
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьПолейСписания()
	
	Элементы.ДатаВыводаИзЭксплуатации.Видимость = Запись.ЭксплуатацияЗавершена;
	Элементы.ПричинаВыводаИзЭксплуатации.Видимость = Запись.ЭксплуатацияЗавершена;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПолейПоТипуОборудования()
	
	ЭтоМедицинскоеОборудование = (Запись.ТипОборудования = ПредопределенноеЗначение("Перечисление.ТипыМедицинскогоОборудованияФРМО.Медицинское"));
	
	// Классификация медицинского изделия
	
	Элементы.РазделИзделия.Видимость	= ЭтоМедицинскоеОборудование;
	Элементы.ТипИзделия.Видимость		= ЭтоМедицинскоеОборудование;
	
	// Удостоверение
	
	Элементы.ПодобратьУдостоверение.Видимость				= ЭтоМедицинскоеОборудование;
	Элементы.НомерУдостоверения.Видимость					= ЭтоМедицинскоеОборудование;
	Элементы.ДатаРегистрации.Видимость						= ЭтоМедицинскоеОборудование;
	
	//Элементы.Модель.ТолькоПросмотр						= ЭтоМедицинскоеОборудование;
	Элементы.Модель.АвтоОтметкаНезаполненного				= Не ЭтоМедицинскоеОборудование;
	Элементы.Модель.ОтметкаНезаполненного					= Не ЭтоМедицинскоеОборудование И Не ЗначениеЗаполнено(Запись.Модель);
	//Элементы.Производитель.ТолькоПросмотр					= ЭтоМедицинскоеОборудование;
	//Элементы.СтранаПроизводства.ТолькоПросмотр			= ЭтоМедицинскоеОборудование;
	Элементы.СтранаПроизводства.АвтоОтметкаНезаполненного	= Не ЭтоМедицинскоеОборудование;
	Элементы.СтранаПроизводства.ОтметкаНезаполненного		= Не ЭтоМедицинскоеОборудование И Не ЗначениеЗаполнено(Запись.СтранаПроизводства);
	//Элементы.ПодобратьСтрану.Видимость					= Не ЭтоМедицинскоеОборудование;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКоличества()
	
	Элементы.Количество.ТолькоПросмотр = ЗначениеЗаполнено(Запись.ИнвентарныйНомер);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьПолейМестоположения()
	
	Элементы.СтраницыМестоположение.ТекущаяСтраница = ?(ВидМестоположения = 0,
		Элементы.СтраницаМестонахождение, Элементы.СтраницаАдрес);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораКлассификацииИзделия(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(Запись.РазделИзделия) И Не ЗначениеЗаполнено(Запись.ТипИзделия) Тогда
		ПараметрыФормы.Вставить("ОтборРазделИзделия", Запись.РазделИзделия);
	Иначе
		ПараметрыФормы.Вставить("ВернутьВидИРазделИзделия", Истина);
		ПараметрыФормы.Вставить("РазделИзделия", Запись.РазделИзделия);
		ПараметрыФормы.Вставить("ВидИзделия", Запись.ТипИзделия);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборКлассификацииИзделия(ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Запись.РазделИзделия = ВыбранноеЗначение.РазделИзделия;
	Запись.ТипИзделия = ВыбранноеЗначение.ВидИзделия;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокЭтажиПомещения()
	
	Элементы.ДекорацияПомещения.Заголовок = СтрШаблон(НСтр("ru = 'Помещения (%1)'"), ЭтажиПомещения.Количество());
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокОтделенияКабинеты()
	
	Элементы.ДекорацияКабинеты.Заголовок = СтрШаблон(НСтр("ru = 'Кабинеты / отделения (%1)'"), ОтделенияКабинеты.Количество());
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеОС()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"		, Запись.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", Запись.ОсновноеСредство);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредства.НаименованиеПолное КАК НаименованиеПолное,
	|	ОсновныеСредстваКонтактнаяИнформация.Значение КАК Адрес,
	|	КТРУ.Ссылка КАК КТРУ,
	|	ИзготовителиКонтактнаяИнформация.Страна КАК СтранаПроизводства,
	|	ЕСТЬNULL(ОсновныеСредства.ИзготовительОС.НаименованиеПолное, """") КАК Изготовитель,
	|	ОсновныеСредства.Сведения КАК Сведения,
	|	ОсновныеСредства.ТипНФА КАК ТипНФА
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КТРУ КАК КТРУ
	|		ПО ОсновныеСредства.КодПоКТРУ = КТРУ.Код
	|			И (ОсновныеСредства.КодПоКТРУ <> """")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства.КонтактнаяИнформация КАК ОсновныеСредстваКонтактнаяИнформация
	|		ПО ОсновныеСредства.Ссылка = ОсновныеСредстваКонтактнаяИнформация.Ссылка
	|			И (ОсновныеСредстваКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресМестонахожденияОбъектаОС))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Изготовители.КонтактнаяИнформация КАК ИзготовителиКонтактнаяИнформация
	|		ПО ОсновныеСредства.ИзготовительОС = ИзготовителиКонтактнаяИнформация.Ссылка
	|			И (ИзготовителиКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресИзготовителя))
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетАмортизацииОССрезПоследних.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(, ОсновноеСредство = &ОсновноеСредство) КАК РасчетАмортизацииОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних";
		
	Результат = Запрос.ВыполнитьПакет();
	
	пТипНФА = Неопределено;
	пКТРУ = Неопределено;
	
	Выборка = Результат[0].Выбрать();
	Если Выборка.Следующий() Тогда
		
		Запись.Наименование			= Выборка.НаименованиеПолное;
		Запись.Производитель		= Выборка.Изготовитель;
		Запись.Модель				= Выборка.Сведения;
		Запись.СтранаПроизводства	= Выборка.СтранаПроизводства;
		
		пТипНФА	= Выборка.ТипНФА;
		пКТРУ	= Выборка.КТРУ;
		
		СвойстваАдреса = ИнтеграцияФРМО.АдресБГУвФРМО(Выборка.Адрес);
		АдресПредставление = СвойстваАдреса.Представление;
		Запись.Адрес = СвойстваАдреса.Значение;
		
	КонецЕсли;
	
	Выборка = Результат[1].Выбрать();
	Если Выборка.Следующий() Тогда
		Запись.СрокСлужбы = Окр(Выборка.СрокПолезногоИспользования / 12);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.ИнвентарныйНомер) Тогда
		Выборка = Результат[2].Выбрать();
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			Запись.ИнвентарныйНомер = Выборка.ИнвентарныйНомер;
		КонецЕсли;
	КонецЕсли;
	
	Если пТипНФА = Перечисления.ТипыНФА.Транспорт Тогда
		
		Запись.ТипОборудования = Перечисления.ТипыМедицинскогоОборудованияФРМО.Автотранспорт;
		
	ИначеЕсли ЗначениеЗаполнено(пКТРУ) Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("КТРУ", пКТРУ);
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КТРУКлассификаторы.Классификатор КАК Классификатор
		|ИЗ
		|	Справочник.КТРУ.Классификаторы КАК КТРУКлассификаторы
		|ГДЕ
		|	КТРУКлассификаторы.Ссылка = &КТРУ
		|	И КТРУКлассификаторы.Классификатор ССЫЛКА Справочник.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			Запись.ТипИзделия = Выборка.Классификатор;
			
			Разделы = РазделыТипаИзделия(Выборка.Классификатор);
			Если Разделы.Количество() = 0 Тогда
				Запись.РазделИзделия = Неопределено;
			ИначеЕсли Разделы.Количество() = 1 Тогда
				Запись.РазделИзделия = Разделы[0].Значение;
			ИначеЕсли ЗначениеЗаполнено(Запись.РазделИзделия)
				И Разделы.НайтиПоЗначению(Запись.РазделИзделия) = Неопределено Тогда
				Запись.РазделИзделия = Неопределено;
			КонецЕсли;
			
			Запись.ТипОборудования = Перечисления.ТипыМедицинскогоОборудованияФРМО.Медицинское;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеОбъекта()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"			, Запись.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, Запись.ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвентарныйНомер"	, Запись.ИнвентарныйНомер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИнвентарныеНомераОС.ЗаводскойНомер КАК ЗаводскойНомер,
	|	ИнвентарныеНомераОС.Код КАК Код,
	|	ИнвентарныеНомераОС.ДатаВыпуска КАК ДатаВыпуска
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.Ссылка = &ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияОССрезПоследних.Событие КАК Событие,
	|	СобытияОССрезПоследних.ДатаСобытия КАК ДатаСобытия,
	|	СобытияОССрезПоследних.ПричинаСписания КАК ПричинаСписания
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И ИнвНомер = &ИнвентарныйНомер) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)";
	
	Результат = Запрос.ВыполнитьПакет();
	
	Выборка = Результат[0].Выбрать();
	Если Выборка.Следующий() Тогда
		Запись.ИнвентарныйНомерКод	= СокрЛП(Выборка.Код);
		Запись.СерийныйНомер		= Выборка.ЗаводскойНомер;
		Запись.ДатаВыпуска			= Выборка.ДатаВыпуска
	КонецЕсли;
	
	Выборка = Результат[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Событие = Перечисления.ВидыСобытийОС.ВводВЭксплуатацию Тогда
			Запись.ДатаВводаВЭксплуатацию = Выборка.ДатаСобытия;
		ИначеЕсли Выборка.Событие = Перечисления.ВидыСобытийОС.Списание Тогда
			Запись.ЭксплуатацияЗавершена = Истина;
			Запись.ДатаВыводаИзЭксплуатации = Выборка.ДатаСобытия;
			Запись.ПричинаВыводаИзЭксплуатации = Выборка.ПричинаСписания;
		КонецЕсли;
	КонецЦикла;
	
	Запись.Количество = 1;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДанныеПустогоОбъекта(Запись)
	
	Запись.ИнвентарныйНомерКод	= ИнтеграцияФРМОКлиентСервер.ПустойНомерПоУмолчанию();
	Запись.СерийныйНомер		= ИнтеграцияФРМОКлиентСервер.ПустойНомерПоУмолчанию();
	
КонецПроцедуры

&НаСервере
Процедура ОсновноеСредствоПриИзмененииСервер()
	
	ПрочитатьДанныеОС();
	
	Если ЗначениеЗаполнено(Запись.ИнвентарныйНомер) Тогда
		ПрочитатьДанныеОбъекта();
	Иначе
		ЗаполнитьДанныеПустогоОбъекта(Запись);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РазделИТипСоответствуют()
	
	Если Не ЗначениеЗаполнено(Запись.РазделИзделия) Или Не ЗначениеЗаполнено(Запись.ТипИзделия) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Разделы = РазделыТипаИзделия(Запись.ТипИзделия);
	
	Возврат (Разделы.НайтиПоЗначению(Запись.РазделИзделия) <> Неопределено);
	
КонецФункции

&НаСервере
Процедура ПрочитатьМестонахождение()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"			, Запись.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, Запись.ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвентарныйНомер"	, Запись.ИнвентарныйНомер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МестонахождениеМО.Местонахождение КАК Местонахождение,
	|	МестонахождениеМО.Местонахождение.Тип КАК Тип
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.МестонахождениеМедицинскогоОборудованияФРМО КАК МестонахождениеМО
	|ГДЕ
	|	МестонахождениеМО.Организация = &Организация
	|	И МестонахождениеМО.ОсновноеСредство = &ОсновноеСредство
	|	И МестонахождениеМО.ИнвентарныйНомер = &ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Местонахождение КАК Местонахождение
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВТ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыМестонахожденияФРМО.Помещение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Местонахождение КАК Местонахождение
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	(ВТ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыМестонахожденияФРМО.Отделение)
	|			ИЛИ ВТ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыМестонахожденияФРМО.Кабинет))";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ЭтажиПомещения.ЗагрузитьЗначения(Результат[1].Выгрузить().ВыгрузитьКолонку("Местонахождение"));
	ОтделенияКабинеты.ЗагрузитьЗначения(Результат[2].Выгрузить().ВыгрузитьКолонку("Местонахождение"));
	
КонецПроцедуры

&НаСервере
Процедура СохранитьМестонахождение()
	
	НаборЗаписей = РегистрыСведений.МестонахождениеМедицинскогоОборудованияФРМО.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Запись.Организация);
	НаборЗаписей.Отбор.ОсновноеСредство.Установить(Запись.ОсновноеСредство);
	НаборЗаписей.Отбор.ИнвентарныйНомер.Установить(Запись.ИнвентарныйНомер);
	
	ТаблицыМестонахождения = Новый Массив;
	ТаблицыМестонахождения.Добавить(ЭтажиПомещения);
	ТаблицыМестонахождения.Добавить(ОтделенияКабинеты);
	
	Для Каждого Таблица Из ТаблицыМестонахождения Цикл
		Если ВидМестоположения = 0 Тогда
			Для Каждого СтрокаМестонахождение Из Таблица Цикл
				НоваяЗапись						= НаборЗаписей.Добавить();
				НоваяЗапись.Организация			= Запись.Организация;
				НоваяЗапись.ОсновноеСредство	= Запись.ОсновноеСредство;
				НоваяЗапись.ИнвентарныйНомер	= Запись.ИнвентарныйНомер;
				НоваяЗапись.Местонахождение		= СтрокаМестонахождение.Значение;
			КонецЦикла;
		Иначе
			Таблица.Очистить();
		КонецЕсли;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РазделыТипаИзделия(ТипИзделия)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипИзделия", ТипИзделия);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Классификатор.Раздел КАК Ссылка,
	|	Классификатор.Раздел.Представление КАК Представление,
	|	Классификатор.Раздел.Родитель КАК Родитель1,
	|	ЕСТЬNULL(Классификатор.Раздел.Родитель.Родитель, ЗНАЧЕНИЕ(Справочник.РазделыНоменклатурнойКлассификацииМедицинскихИзделийПоВидам.ПустаяСсылка)) КАК Родитель2
	|ИЗ
	|	Справочник.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам.Разделы КАК Классификатор
	|ГДЕ
	|	Классификатор.Ссылка = &ТипИзделия
	|
	|УПОРЯДОЧИТЬ ПО
	|	Классификатор.НомерСтроки";
	
	Разделы = Запрос.Выполнить().Выгрузить();
	
	Родители = Новый Массив;
	Для Каждого Раздел Из Разделы Цикл
		Если ЗначениеЗаполнено(Раздел.Родитель1) Тогда
			Родители.Добавить(Раздел.Родитель1);
		КонецЕсли;
		Если ЗначениеЗаполнено(Раздел.Родитель2) Тогда
			Родители.Добавить(Раздел.Родитель2);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый СписокЗначений;
	Для Каждого Раздел Из Разделы Цикл
		Если Родители.Найти(Раздел.Ссылка) = Неопределено Тогда
			Результат.Добавить(Раздел.Ссылка, Раздел.Представление);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораСтраны(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запись.СтранаПроизводства = НаименованиеСтраны(Результат);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НаименованиеСтраны(Страна)
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Страна, "Наименование,НаименованиеПолное");
	Разделитель = ?(ЗначениеЗаполнено(Реквизиты.Наименование) И ЗначениеЗаполнено(Реквизиты.НаименованиеПолное), " ", "");
	Наименование = Реквизиты.Наименование + Разделитель + Реквизиты.НаименованиеПолное;
	
	Возврат Наименование;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТипРазделИзРУ(ВидМодели)
	
	Если Не ЗначениеЗаполнено(ВидМодели) Тогда
		Возврат;
	КонецЕсли;
	
	ТипРаздел = ТипРазделИзРУСервер(ВидМодели);
	
	Если Запись.ТипИзделия <> ТипРаздел.Тип Тогда
		Запись.ТипИзделия = ТипРаздел.Тип;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Тип медицинского изделия был изменен'"),, "Запись.ТипИзделия");
	КонецЕсли;
	
	Если ТипРаздел.Разделы.Количество() = 1 Тогда
		Если Запись.РазделИзделия <> ТипРаздел.Разделы[0] Тогда
			Запись.РазделИзделия = ТипРаздел.Разделы[0];
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Раздел медицинского изделия был изменен'"),, "Запись.РазделИзделия");
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Запись.РазделИзделия) Тогда
		Если ТипРаздел.Разделы.Найти(Запись.РазделИзделия) = Неопределено Тогда
			Запись.РазделИзделия = Неопределено;
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Раздел медицинского изделия был изменен'"),, "Запись.РазделИзделия");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипРазделИзРУСервер(ВидМодели)
	
	Результат = Новый Структура("Тип,Разделы", Справочники.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам.ПустаяСсылка(), Новый Массив);
	
	ТипИзделия = Справочники.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам.НайтиПоКоду(ВидМодели);
	
	Если ТипИзделия = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Тип = ТипИзделия;
	Результат.Разделы = РазделыТипаИзделия(ТипИзделия).ВыгрузитьЗначения();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура АдресЗавершениеРедактирования(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(Результат.Значение) Тогда
		СвойстваАдреса = Новый Структура("Значение,Представление", "", "");
	Иначе
		СвойстваАдреса = АдресБГУвФРМО(Результат.Значение);
	КонецЕсли;
	
	АдресПредставление	= СвойстваАдреса.Представление;
	Запись.Адрес		= СвойстваАдреса.Значение;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция АдресФРМОвБГУ(Адрес)
	
	Возврат ИнтеграцияФРМО.АдресФРМОвБГУ(Адрес);
	
КонецФункции

&НаСервереБезКонтекста
Функция АдресБГУвФРМО(Адрес)
	
	Возврат ИнтеграцияФРМО.АдресБГУвФРМО(Адрес);
	
КонецФункции

&НаСервере
Функция ИсполнитьАудит(Аудит)
	
	Для Каждого СтрокаЗаменить Из Аудит.Заменить Цикл
		Запись[СтрокаЗаменить.Ключ] = СтрокаЗаменить.Значение;
		УстановитьОтображениеПоля(СтрокаЗаменить.Ключ, Истина);
	КонецЦикла;
	
	Для Каждого СтрокаПропустить Из Аудит.Пропустить Цикл
		УстановитьОтображениеПоля(СтрокаПропустить, Ложь);
	КонецЦикла;
	
	Если Аудит.Заменить.Количество() > 0 Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецФункции 

&НаСервере
Процедура УстановитьОтображениеПоля(ИмяПоля, Замена)
	
	Поле = Элементы[ИмяПоля];
	
	Если Поле.Вид = ВидПоляФормы.ПолеВвода Тогда
		Поле.ЦветФона = ?(Замена, ЦветаСтиля.ЦветФонаПоложительногоЗначения, ЦветаСтиля.ЦветФонаПредупреждения);
	ИначеЕсли Поле.Вид = ВидПоляФормы.ПолеФлажка Тогда
		Поле.ЦветТекстаЗаголовка =?(Замена, ЦветаСтиля.ЦветТекстаПоложительногоЗначения, ЦветаСтиля.ЦветТекстаОтрицательногоЗначения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
