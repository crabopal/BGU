
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.ВидМодели) Тогда
		ОтборВидМодели = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ВидМодели, "Код");
	КонецЕсли;
	
	РазмерСтраницы = Элементы.РазмерСтраницы.СписокВыбора[0].Значение;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИнициализироватьЭлементыФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтборНомерПриИзменении(Элемент)
	
	ИнициализироватьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборМодельПриИзменении(Элемент)
	
	ИнициализироватьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура РазмерСтраницыПриИзменении(Элемент)
	
	ИнициализироватьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура РазмерСтраницыОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура УдостоверенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Результат = Новый Структура("Номер,Дата,Модель,Производитель,Страна,ВидМодели");
	ЗаполнитьЗначенияСвойств(Результат, Удостоверения.НайтиПоИдентификатору(ВыбраннаяСтрока));
	Результат.Вставить("ЭтоРегистрационноеУдостоверение");
	ОповеститьОВыборе(Результат);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиУдостоверения(Команда)
	
	Если Не ЗначениеЗаполнено(ОтборВидМодели) И Не ЗначениеЗаполнено(ОтборНомер) И Не ЗначениеЗаполнено(ОтборМодель) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо указать отбор по «Номер» и/или «Модель»'"));
		Возврат;
	КонецЕсли;
	
	ИнициализироватьЭлементыФормы();
	
	НайтиУдостоверенияКлиент(0);
	
КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)
	
	НайтиУдостоверенияКлиент(1);
	
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	
	НайтиУдостоверенияКлиент(-1);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИнициализироватьЭлементыФормы()
	
	Удостоверения.Очистить();
	Версия = "?";
	НомерСтраницы = 1;
	ВсегоСтраниц = 0;
	НастроитьНавигацию();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьНавигацию()
	
	Элементы.ГруппаНавигация.Видимость = (ВсегоСтраниц > 1);
	
	Элементы.ДекорацияСтраница.Заголовок = СтрШаблон(НСтр("ru = 'Страница %1 из %2'"),
		Формат(НомерСтраницы, "ЧГ="), Формат(ВсегоСтраниц, "ЧГ="));
	
	Элементы.ФормаНазад.Доступность = (НомерСтраницы > 1);
	Элементы.ФормаДалее.Доступность = (НомерСтраницы < ВсегоСтраниц);
	
КонецПроцедуры

#Область НайтиУдостоверения

&НаКлиенте
Процедура НайтиУдостоверенияКлиент(Шаг)
	
	ДанныеФормы = Новый Структура;
	ДанныеФормы.Вставить("Шаг"					, Шаг);
	ДанныеФормы.Вставить("ТокенИТС"				, ТокенИТС);
	ДанныеФормы.Вставить("ИдентификаторЗапроса"	, ИдентификаторЗапроса);
	ДанныеФормы.Вставить("Версия"				, Версия);
	ДанныеФормы.Вставить("РазмерСтраницы"		, РазмерСтраницы);
	ДанныеФормы.Вставить("ОтборВидМодели"		, ОтборВидМодели);
	ДанныеФормы.Вставить("ОтборМодель"			, ОтборМодель);
	ДанныеФормы.Вставить("ОтборНомер"			, ОтборНомер);
	
	Результат = НайтиУдостоверенияСервер(ДанныеФормы);
	
	Если ЗначениеЗаполнено(Результат.КодОшибки) Тогда
		
		Если Результат.КодОшибки = "ИТС_НеверныйЛогинИлиПароль" Тогда
			ПодключитьИнтернетПоддержку(Шаг);
		ИначеЕсли ЗначениеЗаполнено(Результат.СообщениеОбОшибке) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.СообщениеОбОшибке);
		КонецЕсли;
		
	Иначе
		
		НомерСтраницы = НомерСтраницы + Шаг;
		
		Удостоверения.Очистить();
		НомерСтроки = (НомерСтраницы - 1) * РазмерСтраницы;
		Для Каждого Удостоверение Из Результат.Удостоверения Цикл
			НоваяСтрока = Удостоверения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Удостоверение);
			НомерСтроки = НомерСтроки + 1;
			НоваяСтрока.НомерСтроки = НомерСтроки;
		КонецЦикла;
		
	КонецЕсли;
	
	Если Результат.ПараметрыИтерации <> Неопределено Тогда
		ТокенИТС = Результат.ПараметрыИтерации.ТокенИТС;
		ИдентификаторЗапроса = Результат.ПараметрыИтерации.ИдентификаторЗапроса;
		Версия = Результат.ПараметрыИтерации.Версия;
		ВсегоСтраниц = Цел((Результат.ПараметрыИтерации.ВсегоЗаписей + РазмерСтраницы - 1) / РазмерСтраницы);
	КонецЕсли;
	
	НастроитьНавигацию();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиУдостоверенияСервер(ДанныеФормы)
	
	Результат = Новый Структура("ПараметрыИтерации,Удостоверения,КодОшибки,СообщениеОбОшибке", Неопределено, Неопределено, "", "");
	
	ПараметрыИтерации = Новый Структура;
	ПараметрыИтерации.Вставить("ТокенИТС"				, ДанныеФормы.ТокенИТС);
	ПараметрыИтерации.Вставить("ИдентификаторЗапроса"	, ДанныеФормы.ИдентификаторЗапроса);
	ПараметрыИтерации.Вставить("Версия"					, ДанныеФормы.Версия);
	ПараметрыИтерации.Вставить("ВсегоЗаписей"			, 0);
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ВидМодели"				, ДанныеФормы.ОтборВидМодели);
	ПараметрыЗапроса.Вставить("Модель"					, ДанныеФормы.ОтборМодель);
	ПараметрыЗапроса.Вставить("Номер"					, ДанныеФормы.ОтборНомер);
	ПараметрыЗапроса.Вставить("РазмерСтраницы"			, ДанныеФормы.РазмерСтраницы);
	ПараметрыЗапроса.Вставить("Назад"					, ДанныеФормы.Шаг < 0);
	
	ЭтоНовыйЗапрос = (ДанныеФормы.Шаг = 0);
	
	Если ЭтоНовыйЗапрос Тогда
		
		Авторизация = ИнтеграцияФРМО.ТикетИТСДля1СФНСИ();
		Если ЗначениеЗаполнено(Авторизация.КодОшибки) Тогда
			Результат.КодОшибки = "ИТС_" + Авторизация.КодОшибки;
			Результат.СообщениеОбОшибке = Авторизация.СообщениеОбОшибке;
			Возврат Результат;
		КонецЕсли;
		
		ПараметрыИтерации.ТокенИТС = Авторизация.Тикет;
		ПараметрыИтерации.ИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор());
		ПараметрыИтерации.Версия = Неопределено;
		
		ОтветСервиса = ДанныеИзФНСИ(ПараметрыИтерации, ПараметрыЗапроса, Истина);
		
		Если ЗначениеЗаполнено(ОтветСервиса.КодОшибки) Тогда
			Результат.КодОшибки = "1СФНСИ_" + ОтветСервиса.КодОшибки;
			Результат.СообщениеОбОшибке = ОтветСервиса.СообщениеОбОшибке;
			Возврат Результат;
		КонецЕсли;
		
		ПараметрыИтерации.Версия = ОтветСервиса.Данные.Версия;
		ПараметрыИтерации.ВсегоЗаписей = ОтветСервиса.Данные.ВсегоЗаписей;
		
		Результат.ПараметрыИтерации = ПараметрыИтерации;
		
		Если ПараметрыИтерации.ВсегоЗаписей = 0 Тогда
			Результат.Удостоверения = Новый Массив;
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	ОтветСервиса = ДанныеИзФНСИ(ПараметрыИтерации, ПараметрыЗапроса, Ложь);
	
	Если ЗначениеЗаполнено(ОтветСервиса.КодОшибки) Тогда
		Результат.КодОшибки = "1СФНСИ_" + ОтветСервиса.КодОшибки;
		Результат.СообщениеОбОшибке = ОтветСервиса.СообщениеОбОшибке;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Удостоверения = ОтветСервиса.Данные;
	
	Возврат Результат;
	
КонецФункции 

&НаСервереБезКонтекста
Функция ДанныеИзФНСИ(ПараметрыИтерации, ПараметрыЗапроса, ТолькоКоличество)
	
	Результат = Новый Структура("Данные,КодОшибки,СообщениеОбОшибке", Неопределено, "", "");
	
	Отбор = Новый Соответствие;
	Если ЗначениеЗаполнено(ПараметрыЗапроса.Модель) Тогда
		Отбор.Вставить("Label", МаскироватьЗначение(ПараметрыЗапроса.Модель) + "|LIKE");
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыЗапроса.Номер) Тогда
		Отбор.Вставить("Registration_number", ПараметрыЗапроса.Номер + "|EXACT");
	КонецЕсли;
	Если Отбор.Количество() = 0 И ЗначениеЗаполнено(ПараметрыЗапроса.ВидМодели) Тогда
		Отбор.Вставить("Kind", ПараметрыЗапроса.ВидМодели + "|EXACT");
	КонецЕсли;
	Если Отбор.Количество() = 0 Тогда
		Отбор = Неопределено;
	КонецЕсли;
	
	РазмерСтраницы = ?(ТолькоКоличество, Неопределено, ПараметрыЗапроса.РазмерСтраницы);
	КоличествоСтраницНазад = ?(Не ТолькоКоличество И ПараметрыЗапроса.Назад, 1, Неопределено);
	
	ОтветСервиса = ИнтеграцияФРМО.СодержимоеСправочника1СФНСИ("1.2.643.5.1.13.13.99.2.538",
		ПараметрыИтерации.ИдентификаторЗапроса, ПараметрыИтерации.ТокенИТС, ПараметрыИтерации.Версия,
		Отбор, РазмерСтраницы, КоличествоСтраницНазад, ТолькоКоличество);
		
	Если Лев(ОтветСервиса.Содержимое, 1) = "{" Тогда
		Содержимое = ОбщегоНазначения.JSONВЗначение(ОтветСервиса.Содержимое);
	Иначе
		Содержимое = Новый Соответствие;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтветСервиса.КодОшибки) Тогда
		УточнениеОшибки = Содержимое["resultText"];
		Результат.КодОшибки = ОтветСервиса.КодОшибки;
		Результат.СообщениеОбОшибке = ?(Не ЗначениеЗаполнено(УточнениеОшибки), ОтветСервиса.СообщениеОбОшибке,
			СтрШаблон(НСтр("ru = 'Ошибка %1: %2'"), ОтветСервиса.КодСостояния, УточнениеОшибки));
		Возврат Результат;
	КонецЕсли;
	
	Если ТолькоКоличество Тогда
		Результат.Данные = Новый Структура("ВсегоЗаписей,Версия", Содержимое["total"], Содержимое["codeSystemVersion"]);
	Иначе
		Результат.Данные = ПрочитатьУдостоверения(Содержимое);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьУдостоверения(Содержимое)
	
	Удостоверения = Новый Массив;
	
	СписокЗаписей = Содержимое["list"];
	Если СписокЗаписей = Неопределено Тогда
		Возврат Удостоверения;
	КонецЕсли;
	
	Для Каждого Запись Из СписокЗаписей Цикл
		
		Удостоверение = Новый Структура("Номер,Дата,Модель,Производитель,Страна,ВидМодели", "", '00010101', "", "", "", "");
		
		Для Каждого Поле Из Запись Цикл
			
			ИмяПоля = Поле["column"];
			ЗначениеПоля = Поле["value"];
			
			Если ИмяПоля = "Registration_number" Тогда
				Удостоверение.Номер = ЗначениеПоля;
			ИначеЕсли ИмяПоля = "Registration_date" Тогда
				Удостоверение.Дата = ПрочитатьДату(ЗначениеПоля);
			ИначеЕсли ИмяПоля = "Label" Тогда
				Удостоверение.Модель = ЗначениеПоля;
			ИначеЕсли ИмяПоля = "Producer" Тогда
				Удостоверение.Производитель = ЗначениеПоля;
			ИначеЕсли ИмяПоля = "Producer_country" Тогда
				Удостоверение.Страна = ЗначениеПоля;
			ИначеЕсли ИмяПоля = "Kind" Тогда
				Удостоверение.ВидМодели = ЗначениеПоля;
			КонецЕсли;
			
		КонецЦикла;
		
		Удостоверения.Добавить(Удостоверение);
		
	КонецЦикла;
	
	Возврат Удостоверения;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьДату(Значение)
	
	Попытка
		Если СтрНайти(Значение, "-") = 5 Тогда
			// В формате "гггг-мм-дд" - ошибочный вариант
			Результат = Дата(Сред(Значение,1,4), Сред(Значение,6,2), Сред(Значение,9,2));
		Иначе
			// В формате "дд.мм.гггг" - ожидаемый вариант
			Результат = Дата(Сред(Значение,7,4), Сред(Значение,4,2), Сред(Значение,1,2));
		КонецЕсли;
	Исключение
		Результат = '00010101';
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция МаскироватьЗначение(Текст)
	
	// Служебные символы сервиса
	Результат =
		СтрЗаменить(
		СтрЗаменить(
		СтрЗаменить(
			Текст,
			";", "\;"),
			",", "\,"),
			"|", "\|");
	
	// Служебные символы протокола
	Возврат КодироватьСтроку(Результат, СпособКодированияСтроки.КодировкаURL)
	
КонецФункции

#КонецОбласти

#Область ПодключениеИнтернетПоддержки

&НаКлиенте
Процедура ПодключитьИнтернетПоддержку(Шаг)
	
	ТекстВопроса = НСтр("ru = 'Для поиска регистрационных удостоверений необходимо подключить Интернет-поддержку пользователей.'");
	ДопПараметры = Новый Структура("Шаг", Шаг);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПодключенияИнтернетПоддержки", ЭтотОбъект, ДопПараметры);
	
	ИнтеграцияФРМОКлиент.ПодключитьИнтернетПоддержку(ТекстВопроса, ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияИнтернетПоддержки(Результат, ДополнительныеПараметры) Экспорт
	
	НайтиУдостоверенияКлиент(ДополнительныеПараметры.Шаг);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
