
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация		 = Параметры.Организация;
	ОсновноеСредство = Параметры.ОсновноеСредство;
	ИнвентарныйНомер = Параметры.ИнвентарныйНомер;
	
	Заключение = ОбщегоНазначения.ЗначениеИзСтрокиXML(Параметры.Заключение);
	
	Для Каждого СтрокаЗначение Из Заключение Цикл
		НоваяСтрока = Данные.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗначение);
		НоваяСтрока.Заменить = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	ИзменитьФлажки(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	ИзменитьФлажки(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьЗначения(Команда)
	
	ЗначенияЗаменить   = Новый Структура;
	ЗначенияПропустить = Новый Массив;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если СтрокаДанных.Заменить Тогда
			ЗначенияЗаменить.Вставить(СтрокаДанных.ИмяРеквизита, СтрокаДанных.ЗначениеБГУ);
			
			Если СтрокаДанных.ИмяРеквизита = "ДатаВыводаИзЭксплуатации" Тогда
				Если ЗначениеЗаполнено(СтрокаДанных.ЗначениеБГУ) <> ЗначениеЗаполнено(СтрокаДанных.ЗначениеФРМО) Тогда
					ЗначенияЗаменить.Вставить("ЭксплуатацияЗавершена", ЗначениеЗаполнено(СтрокаДанных.ЗначениеБГУ));
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			ЗначенияПропустить.Добавить(СтрокаДанных.ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	РезультатАудита = Новый Структура("Заменить,Пропустить", ЗначенияЗаменить, ЗначенияПропустить);
	КлючЗаписи = ИнтеграцияФРМОКлиент.КлючЗаписиМедицинскоеОборудованиеФРМО(Организация, ОсновноеСредство, ИнвентарныйНомер);
	ПараметрыФормы = Новый Структура("Ключ,Аудит", КлючЗаписи, РезультатАудита);
	
	ОткрытьФорму("РегистрСведений.МедицинскоеОборудованиеФРМО.ФормаЗаписи",
		ПараметрыФормы, ВладелецФормы,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИзменитьФлажки(Пометка)
	
	Для Каждого СтрокаДанных Из Данные Цикл
		СтрокаДанных.Заменить = Пометка;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
