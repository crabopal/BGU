
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Заголовок = Параметры.Заголовок;
	Ключ = Параметры.Ключ;
	ЗаполнитьСписок(Параметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИнициализацияПроверитьРодителя(Список);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	ВыбранныеЭлементы = Новый Массив;
	ПолучитьВыбранныеЭлементы(Список.ПолучитьЭлементы(), ВыбранныеЭлементы);
	
	Результат = Новый Структура("ЭтоМестонахождение,Ключ,Данные", Истина, Ключ, ВыбранныеЭлементы);
	ОповеститьОВыборе(Результат);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокПометкаПриИзменении(Элемент)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные.Пометка = 2 Тогда
		ТекДанные.Пометка = 0;
	КонецЕсли;
	
	ПроверитьРодителя(ТекДанные.ПолучитьРодителя());
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.СписокПометка.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Список.ДоступенВыбор", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписок(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"			, Параметры.Организация);
	Запрос.УстановитьПараметр("Родитель"			, Параметры.Родитель);
	Запрос.УстановитьПараметр("Данные"				, Параметры.Данные);
	Запрос.УстановитьПараметр("ВыбираемыеТипы"		, Параметры.ВыбираемыеТипы);
	Запрос.УстановитьПараметр("Здание"				, Параметры.Здание);
	Запрос.УстановитьПараметр("НеОтбиратьПоЗданию"	, Параметры.Здание = Неопределено);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МестонахождениеФРМО.Ссылка КАК Местонахождение,
	|	ВЫБОР
	|		КОГДА МестонахождениеФРМО.Тип В (&ВыбираемыеТипы)
	|				И МестонахождениеФРМО.Ссылка В (&Данные)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Пометка,
	|	ВЫБОР
	|		КОГДА МестонахождениеФРМО.Тип В (&ВыбираемыеТипы)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ДоступенВыбор
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.МестонахождениеФРМО КАК МестонахождениеФРМО
	|ГДЕ
	|	МестонахождениеФРМО.Организация = &Организация
	|	И МестонахождениеФРМО.Родитель В ИЕРАРХИИ(&Родитель)
	|	И НЕ МестонахождениеФРМО.ПометкаУдаления
	|	И (&НеОтбиратьПоЗданию
	|			ИЛИ МестонахождениеФРМО.Ссылка В
	|				(ВЫБРАТЬ
	|					ВТ.Ссылка
	|				ИЗ
	|					Справочник.МестонахождениеФРМО.ЗданияПодразделения КАК ВТ
	|				ГДЕ
	|					ВТ.Ссылка.Организация = &Организация
	|					И ВТ.Здание = &Здание))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Местонахождение КАК Местонахождение,
	|	ВТ.Пометка КАК Пометка,
	|	ВТ.ДоступенВыбор КАК ДоступенВыбор,
	|	ВЫБОР
	|		КОГДА ВТ.Пометка
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Количество
	|ИЗ
	|	ВТ КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Местонахождение ИЕРАРХИЯ";
	
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ЗначениеВРеквизитФормы(Результат, "Список");
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализацияПроверитьРодителя(СтрокаДерева)
	
	Для Каждого СтрДерева Из СтрокаДерева.ПолучитьЭлементы() Цикл
		ИнициализацияПроверитьРодителя(СтрДерева);
	КонецЦикла;
	Если СтрокаДерева <> Список И СтрокаДерева.ПолучитьЭлементы().Количество() > 0 Тогда
		ПроверитьРодителя(СтрокаДерева);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРодителя(Родитель)
	
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьЛожь = Ложь;
	ЕстьИстина = Ложь;
	ЕстьСмешение = Ложь;
	
	Для Каждого СтрокаДерева Из Родитель.ПолучитьЭлементы() Цикл
		Если СтрокаДерева.Пометка = 1 Тогда
			ЕстьИстина = Истина;
		ИначеЕсли СтрокаДерева.Пометка = 0 Тогда
			ЕстьЛожь = Истина;
		Иначе
			ЕстьСмешение = Истина;
		КонецЕсли;
		Если ЕстьЛожь И ЕстьИстина И ЕстьСмешение Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьЛожь И Не ЕстьСмешение И ЕстьИстина Тогда
		Родитель.Пометка = 1;
	ИначеЕсли (ЕстьЛожь И ЕстьИстина) Или ЕстьСмешение Тогда
		Родитель.Пометка = 2;
	Иначе
		Родитель.Пометка = 0;
	КонецЕсли;
	
	ПроверитьРодителя(Родитель.ПолучитьРодителя());
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВыбранныеЭлементы(СтрокиСписка, ВыбранныеЭлементы);
	
	Для Каждого СтрокаСписка Из СтрокиСписка Цикл
		Если СтрокаСписка.Пометка = 1 И СтрокаСписка.ДоступенВыбор Тогда
			ВыбранныеЭлементы.Добавить(СтрокаСписка.Местонахождение);
		КонецЕсли;
		ПолучитьВыбранныеЭлементы(СтрокаСписка.ПолучитьЭлементы(), ВыбранныеЭлементы);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
