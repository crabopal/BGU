#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		Если Запись.ТипОборудования = Перечисления.ТипыМедицинскогоОборудованияФРМО.Медицинское Тогда
			НеПроверяемыеРеквизиты.Добавить("Модель");
			НеПроверяемыеРеквизиты.Добавить("СтранаПроизводства");
		Иначе
			НеПроверяемыеРеквизиты.Добавить("РазделИзделия");
			НеПроверяемыеРеквизиты.Добавить("ТипИзделия");
			НеПроверяемыеРеквизиты.Добавить("НомерУдостоверения");
			НеПроверяемыеРеквизиты.Добавить("ДатаРегистрации");
		КонецЕсли;
		
		Если Не Запись.ЭксплуатацияЗавершена Тогда
			НеПроверяемыеРеквизиты.Добавить("ДатаВыводаИзЭксплуатации");
			НеПроверяемыеРеквизиты.Добавить("ПричинаВыводаИзЭксплуатации");
		КонецЕсли;
		
		Если Запись.ИнойАдрес Тогда
			НеПроверяемыеРеквизиты.Добавить("Здание");
			НеПроверяемыеРеквизиты.Добавить("Подразделение");
		Иначе
			НеПроверяемыеРеквизиты.Добавить("Адрес");
		КонецЕсли;
		
	КонецЦикла;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СогласоватьДанные();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СогласоватьДанные()
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		Если Запись.ТипОборудования <> Перечисления.ТипыМедицинскогоОборудованияФРМО.Медицинское Тогда
			Запись.РазделИзделия		= Справочники.РазделыНоменклатурнойКлассификацииМедицинскихИзделийПоВидам.ПустаяСсылка();
			Запись.ТипИзделия			= Справочники.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам.ПустаяСсылка();
			Запись.НомерУдостоверения	= "";
			Запись.ДатаРегистрации		= '00010101';
		КонецЕсли;
		
		Если Не Запись.ЭксплуатацияЗавершена Тогда
			Запись.ДатаВыводаИзЭксплуатации		= '00010101';
			Запись.ПричинаВыводаИзЭксплуатации	= "";
		КонецЕсли;
		
		Если Запись.ИнойАдрес Тогда
			Запись.Здание				= Справочники.МестонахождениеФРМО.ПустаяСсылка();
			Запись.Подразделение		= Справочники.МестонахождениеФРМО.ПустаяСсылка();
		Иначе
			Запись.Адрес				= "";
			Запись.ПричинаИногоАдреса	= "";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

