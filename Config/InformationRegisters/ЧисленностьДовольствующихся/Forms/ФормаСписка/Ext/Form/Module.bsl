
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация);
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	
	Если НЕ Параметры.Отбор.Свойство("КатегорияДовольствующихся", ОтборКатегория) Тогда
		Параметры.Свойство("КатегорияДовольствующихся", ОтборКатегория);
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "КатегорияДовольствующихся", ОтборКатегория,,, ЗначениеЗаполнено(ОтборКатегория));
	Элементы.КатегорияДовольствующихся.Видимость = НЕ ЗначениеЗаполнено(ОтборКатегория);
	
	Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
		Элементы.ОтборОрганизация.ТолькоПросмотр = Истина;
		Элементы.ОтборОрганизация.КнопкаОткрытия = Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборКатегория) Тогда
		Элементы.ОтборКатегория.ТолькоПросмотр = Истина;
		Элементы.ОтборКатегория.КнопкаОткрытия = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборКатегорияПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "КатегорияДовольствующихся", ОтборКатегория,,, ЗначениеЗаполнено(ОтборКатегория));
	Элементы.КатегорияДовольствующихся.Видимость = НЕ ЗначениеЗаполнено(ОтборКатегория);
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
КонецПроцедуры

#КонецОбласти