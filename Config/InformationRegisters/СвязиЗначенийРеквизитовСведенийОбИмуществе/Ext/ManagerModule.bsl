#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура ЗаполнитьПоУмолчанию(Перезаполнять = Ложь) Экспорт
	
	ВыполнитьЗагрузку = Перезаполнять;
	
	Если Не Перезаполнять Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		                      |	СвязиЗначенийРеквизитовСведенийОбИмуществе.Значение
		                      |ИЗ
		                      |	РегистрСведений.СвязиЗначенийРеквизитовСведенийОбИмуществе КАК СвязиЗначенийРеквизитовСведенийОбИмуществе");
		
		РезультатЗапроса = Запрос.Выполнить();		
		ВыполнитьЗагрузку = РезультатЗапроса.Пустой();		
		
	КонецЕсли;
	
	Если ВыполнитьЗагрузку Тогда
		ЗагрузитьЗначения();
	КонецЕсли; 
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ВыгрузитьЗначения() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СвязиЗначенийРеквизитовСведенийОбИмуществе.Значение.Родитель.Код КАК КодСправочника,
	               |	СвязиЗначенийРеквизитовСведенийОбИмуществе.Значение.Код КАК Код,
	               |	СвязиЗначенийРеквизитовСведенийОбИмуществе.Раздел,
	               |	СвязиЗначенийРеквизитовСведенийОбИмуществе.КоллекцияДокументов
	               |ИЗ
	               |	РегистрСведений.СвязиЗначенийРеквизитовСведенийОбИмуществе КАК СвязиЗначенийРеквизитовСведенийОбИмуществе";
				   
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(Результат);
	
КонецФункции

Процедура ЗагрузитьЗначения(Данные = "") Экспорт
	
	Если ТипЗнч(Данные) = Тип("ТаблицаЗначений") Тогда
		
		Таблица = Данные;
		
	ИначеЕсли ТипЗнч(Данные) = Тип("Строка") Тогда
		
		Если ПустаяСтрока(Данные) Тогда
			
			Макет = ПолучитьМакет("ЗначенияПоУмолчанию");
			ТекстМакета = Макет.ПолучитьТекст();
			Если ПустаяСтрока(ТекстМакета) Тогда
				Возврат;
			КонецЕсли;			
		Иначе
			ТекстМакета = Данные;
		КонецЕсли;
	
		Таблица = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекстМакета);
		
	Иначе
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Таблица", Таблица);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаСвязей.КодСправочника,
	               |	ТаблицаСвязей.Код,
	               |	ТаблицаСвязей.Раздел,
	               |	ТаблицаСвязей.КоллекцияДокументов
	               |ПОМЕСТИТЬ ВТ_Таблица
	               |ИЗ
	               |	&Таблица КАК ТаблицаСвязей
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗначенияРеквизитовСведенийОбИмуществе.Ссылка КАК Значение,
	               |	ВТ_Таблица.Раздел,
	               |	ВТ_Таблица.КоллекцияДокументов
	               |ИЗ
	               |	ВТ_Таблица КАК ВТ_Таблица
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗначенияРеквизитовСведенийОбИмуществе КАК ЗначенияРеквизитовСведенийОбИмуществе
	               |		ПО ВТ_Таблица.КодСправочника = ЗначенияРеквизитовСведенийОбИмуществе.Родитель.Код
	               |			И ВТ_Таблица.Код = ЗначенияРеквизитовСведенийОбИмуществе.Код
	               |ГДЕ
	               |	НЕ ЗначенияРеквизитовСведенийОбИмуществе.Ссылка ЕСТЬ NULL 
	               |	И НЕ ЗначенияРеквизитовСведенийОбИмуществе.ПометкаУдаления
	               |	И (ВТ_Таблица.Раздел <> """"
	               |			ИЛИ ВТ_Таблица.КоллекцияДокументов <> """")
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗначенияРеквизитовСведенийОбИмуществе.Ссылка,
	               |	ВТ_Таблица.Раздел,
	               |	ВТ_Таблица.КоллекцияДокументов";
				   
	ТаблицаСвязей = Запрос.Выполнить().Выгрузить();
	
	НаборЗаписей = РегистрыСведений.СвязиЗначенийРеквизитовСведенийОбИмуществе.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(ТаблицаСвязей);
	НаборЗаписей.Записать();	
				
КонецПроцедуры

#КонецЕсли