
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Отбор.Свойство("Ребенок", ОтборРебенок) Тогда
		
		Параметры.Свойство("Ребенок", ОтборРебенок)
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборРебенок) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ребенок", ОтборРебенок,,, ЗначениеЗаполнено(ОтборРебенок));
		ОтборОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборРебенок, "Организация");
		Элементы.ОтборГруппаДетскогоУчреждения.Видимость 	= Ложь;
		Элементы.ОтборОрганизация.ТолькоПросмотр			= Истина;
		Элементы.ОтборРебенок.ТолькоПросмотр				= Истина;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Ребенок", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РебенокОрганизация", "Видимость", Ложь);
		
	ИначеЕсли НЕ Параметры.Отбор.Свойство("ГруппаДетскогоУчреждения", ОтборГруппаДетскогоУчреждения) Тогда
		
		Параметры.Свойство("ГруппаДетскогоУчреждения", ОтборГруппаДетскогоУчреждения);
		
		Если ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения) Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ГруппаДетскогоУчреждения", ОтборГруппаДетскогоУчреждения,,, ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));	
			ОтборОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборГруппаДетскогоУчреждения, "Владелец");
			Элементы.ОтборОрганизация.ТолькоПросмотр 				= Истина;
            Элементы.ОтборГруппаДетскогоУчреждения.ТолькоПросмотр	= Истина;
            ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РебенокОрганизация", "Видимость", Ложь);
            ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДетскогоУчреждения", "Видимость", Ложь);
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ОтборОрганизация) Тогда
		
		ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация, "Организация");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РебенокОрганизация", "Видимость", НЕ ЗначениеЗаполнено(ОтборОрганизация));

	КонецЕсли;
	
	Элементы.СписокЗаполнитьПодборомДетей.Видимость = ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения);
	Элементы.ГруппаОтборыПериод.Видимость = ЗначениеЗаполнено(НачалоНачисления);
	
	ТолькоАктуальные = Истина;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененСоставГруппыДетскогоУчреждения" Тогда
		Элементы.Список.Обновить();
	ИначеЕсли ИмяСобытия = "ВыбранРебенок_СоставГруппДДУ" Тогда
		ОбработатьПодборНаСервере(Параметр);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеВидимостьюИОтбором();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ОтборГруппаДетскогоУчрежденияПриИзменении(Элемент)  
	
	УправлениеВидимостьюИОтбором();
	Элементы.СписокЗаполнитьПодборомДетей.Видимость = ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	УправлениеВидимостьюИОтбором();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборРебенокПриИзменении(Элемент)
	
	УправлениеВидимостьюИОтбором();
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьНаВсюИсторию(Элемент)
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаИстория;
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьНаТекущиеЗначенияНажатие(Элемент)
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаСписок;
КонецПроцедуры

&НаКлиенте
Процедура ТолькоАктуальныеПриИзменении(Элемент)
	УправлениеВидимостьюИОтбором();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИстория

&НаКлиенте
Процедура ИсторияПослеУдаления(Элемент)
	ИмяСобытия = "ИзменениеСоставаГруппДДУ";
	Оповестить(ИмяСобытия, ОтборРебенок);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПодборомДетей(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", ЛОЖЬ);
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Организация", ОтборОрганизация));
	
	ОткрытьФорму("Справочник.Дети.ФормаВыбора", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИнтервалДатДляПросмотра(Команда)
	
	ПараметрыФормы = Новый Структура("НачалоПериода, КонецПериода", НачалоНачисления, ОкончаниеНачисления);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ВыбратьПериод_Выбор", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.НастройкаПериодаОтчета", ПараметрыФормы,,,,,ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбработатьПодборНаСервере(Знач Ребенок)
	
	ТекущееСостояние = РегистрыСведений.СоставГруппДДУ.СрезПоследних(ТекущаяДатаСеанса(), Новый Структура("Ребенок", Ребенок));
	
	НаборЗаписей = РегистрыСведений.СоставГруппДДУ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ребенок.Установить(Ребенок);
	НаборЗаписей.Прочитать();
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.Актуальность = Истина;
	НоваяЗапись.ГруппаДетскогоУчреждения = ОтборГруппаДетскогоУчреждения;
	НоваяЗапись.Ребенок = Ребенок;
	НоваяЗапись.Договор = ?(ТекущееСостояние.Количество() > 0, ТекущееСостояние[0].Договор, Справочники.Договоры.ПустаяСсылка());
	НоваяЗапись.Период = ТекущаяДатаСеанса();
	НоваяЗапись.СтавкаОплаты = ?(ТекущееСостояние.Количество() > 0, ТекущееСостояние[0].СтавкаОплаты, Справочники.СтавкиОплатыОбразование.ПустаяСсылка());
	НоваяЗапись.Льгота = ?(ТекущееСостояние.Количество() > 0, ТекущееСостояние[0].Льгота, Справочники.ЛьготыСтудентов.ПустаяСсылка());
	
	Попытка
		НаборЗаписей.Записать();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ВыбратьПериод_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
	
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Период", РезультатВыбора.НачалоПериода, ВидСравненияКомпоновкиДанных.БольшеИлиРавно, , ЗначениеЗаполнено(РезультатВыбора.НачалоПериода));
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(История.Отбор, "Период", РезультатВыбора.НачалоПериода, ВидСравненияКомпоновкиДанных.БольшеИлиРавно, , ЗначениеЗаполнено(РезультатВыбора.НачалоПериода));
		
		НачалоНачисления = РезультатВыбора.НачалоПериода;
		
	КонецЕсли;
	
	Элементы.ГруппаОтборыПериод.Видимость = ЗначениеЗаполнено(НачалоНачисления);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура УправлениеВидимостьюИОтбором()
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(История.Отбор, "ГруппаДетскогоУчреждения", ОтборГруппаДетскогоУчреждения,,, ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсторияГруппаДетскогоУчреждения", "Видимость", НЕ ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(История.Отбор, "Ребенок.Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсторияРебенокОрганизация", "Видимость", НЕ ЗначениеЗаполнено(ОтборОрганизация));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(История.Отбор, "Ребенок", ОтборРебенок,,, ЗначениеЗаполнено(ОтборРебенок));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсторияРебенок", "Видимость", НЕ ЗначениеЗаполнено(ОтборРебенок));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(История.Отбор, "Актуальность", ТолькоАктуальные,,, ТолькоАктуальные);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокИсторияАктуальность", "Видимость", Не ТолькоАктуальные);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ГруппаДетскогоУчреждения", ОтборГруппаДетскогоУчреждения,,, ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДетскогоУчреждения", "Видимость", НЕ ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РебенокОрганизация", "Видимость", НЕ ЗначениеЗаполнено(ОтборОрганизация));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ребенок", ОтборРебенок,,, ЗначениеЗаполнено(ОтборРебенок));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Ребенок", "Видимость", НЕ ЗначениеЗаполнено(ОтборРебенок));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Актуальность", ТолькоАктуальные,,, ТолькоАктуальные);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Актуальность", "Видимость", Не ТолькоАктуальные);
КонецПроцедуры

#КонецОбласти