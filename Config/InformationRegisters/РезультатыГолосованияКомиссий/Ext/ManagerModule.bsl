Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Регистрация данных к обработке не производится. Все данные выбираются в обработчике
	// ОбработатьДанныеДляПереходаНаНовуюВерсию.
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АктОбУтилизацииМЗМатериалы.Ссылка КАК Ссылка,
	|	""Материалы"" КАК ИмяТЧ
	|ИЗ
	|	Документ.АктОбУтилизацииМЗ.Материалы КАК АктОбУтилизацииМЗМатериалы
	|ГДЕ
	|	АктОбУтилизацииМЗМатериалы.ИдентификаторСтроки = """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АктОбУтилизацииОСОсновныеСредства.Ссылка,
	|	""ОсновныеСредства""
	|ИЗ
	|	Документ.АктОбУтилизацииОС.ОсновныеСредства КАК АктОбУтилизацииОСОсновныеСредства
	|ГДЕ
	|	АктОбУтилизацииОСОсновныеСредства.ИдентификаторСтроки = """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОбОценкеИмуществаОсновныеСредства.Ссылка,
	|	""ОсновныеСредства""
	|ИЗ
	|	Документ.РешениеОбОценкеИмущества.ОсновныеСредства КАК РешениеОбОценкеИмуществаОсновныеСредства
	|ГДЕ
	|	РешениеОбОценкеИмуществаОсновныеСредства.ИдентификаторСтроки = """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОПрекращенииПризнанияАктивомОсновныеСредства.Ссылка,
	|	""ОсновныеСредства""
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом.ОсновныеСредства КАК РешениеОПрекращенииПризнанияАктивомОсновныеСредства
	|ГДЕ
	|	РешениеОПрекращенииПризнанияАктивомОсновныеСредства.ИдентификаторСтроки = """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОПрекращенииПризнанияАктивомМЗМатериалы.Ссылка,
	|	""Материалы""
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивомМЗ.Материалы КАК РешениеОПрекращенииПризнанияАктивомМЗМатериалы
	|ГДЕ
	|	РешениеОПрекращенииПризнанияАктивомМЗМатериалы.ИдентификаторСтроки = """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОПризнанииОбъектовМЗМатериалы.Ссылка,
	|	""Материалы""
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовМЗ.Материалы КАК РешениеОПризнанииОбъектовМЗМатериалы
	|ГДЕ
	|	РешениеОПризнанииОбъектовМЗМатериалы.ИдентификаторСтроки = """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РешениеОПризнанииОбъектовОСОсновныеСредства.Ссылка,
	|	""ОсновныеСредства""
	|ИЗ
	|	Документ.РешениеОПризнанииОбъектовОС.ОсновныеСредства КАК РешениеОПризнанииОбъектовОСОсновныеСредства
	|ГДЕ
	|	РешениеОПризнанииОбъектовОСОсновныеСредства.ИдентификаторСтроки = """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			// Заполняем пустые идентификаторы
			Для Каждого СтрокаТаблицы Из ДокОбъект[Выборка.ИмяТЧ] Цикл
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.ИдентификаторСтроки) Тогда
					СтрокаТаблицы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
				КонецЕсли;
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
			
			// Исправляем идентификатор в регистре
			Если ДокОбъект[Выборка.ИмяТЧ].Количество() = 1 Тогда
				ЗаполнитьИДВРегистре(Выборка.Ссылка, ДокОбъект[Выборка.ИмяТЧ][0].ИдентификаторСтроки);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ ""%1"" причине: %2'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, Выборка.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,, Неопределено, ТекстСообщения);
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Истина;
	
КонецПроцедуры

Процедура ЗаполнитьИДВРегистре(ДокСсылка, ИдентификаторСтроки)
	
	НаборЗаписей = РегистрыСведений.РезультатыГолосованияКомиссий.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДокументОснование.Установить(ДокСсылка);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Запись.ИдентификаторСтроки = ИдентификаторСтроки;
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли