
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ИмяПоля = "";
	Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.Студенты") Тогда
		ИмяПоля = "Студент";
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура(ИмяПоля, ПараметрКоманды);
	ПараметрыФормы = Новый Структура("Отбор", СтруктураОтбора);
	
	ОткрытьФорму("РегистрСведений.ПлательщикиПоДоговоруОбразование.ФормаСписка", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	
КонецПроцедуры
