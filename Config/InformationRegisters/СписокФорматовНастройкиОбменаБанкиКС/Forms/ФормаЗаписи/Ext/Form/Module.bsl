
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.НастройкаФормата.ТолькоПросмотр = ЗначениеЗаполнено(Запись.НастройкаФормата);
	
КонецПроцедуры

&НаКлиенте
Процедура ФорматНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("ТекущаяСтрока", Запись.Формат);
	ПараметрыВыбора.Вставить("ФорматОбмена", Запись.Формат);
	ПараметрыВыбора.Вставить("НаправлениеОбмена", ПредопределенноеЗначение("Перечисление.НаправлениеОбменаБанкиКС.Экспорт"));

	ОткрытьФорму("Справочник.ФорматыОбменаБанкиКС.ФормаВыбора", ПараметрыВыбора, Элемент);	
	
КонецПроцедуры
