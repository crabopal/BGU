////////////////////////////////////////////////////////////////////////////////
// Обработчики событий формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаписьКакСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(ГражданствоФизическихЛиц, Метаданные.РегистрыСведений.ГражданствоФизическихЛиц);
	ГражданствоФизическихЛицПрежняя = Новый ФиксированнаяСтруктура(ЗаписьКакСтруктура);
	ГражданствоФизическихЛицЛицоБезГражданства = НЕ ЗначениеЗаполнено(ЗаписьКакСтруктура.Страна);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьОтображениеФормы();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если НЕ ГражданствоФизическихЛицЛицоБезГражданства Тогда
		Если НЕ ЗначениеЗаполнено(ГражданствоФизическихЛиц.Страна) Тогда
			Сообщить(Нстр("ru='Не указана страна гражданства!'"));
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Обработчики событий элементов управления

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	ОбновитьОтображениеФормы();
КонецПроцедуры

&НаКлиенте
Процедура ГражданствоФизическихЛицЛицоБезГражданстваПриИзменении(Элемент)
	КорреспондентыКлиент.ГражданствоФизическихЛицЛицоБезГражданстваПриИзменении(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СтранаПриИзменении(Элемент)
	КорреспондентыКлиент.ГражданствоФизическихЛицСтранаПриИзменении(ЭтаФорма);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Прочие процедуры и функции

&НаКлиенте
Процедура ОбновитьОтображениеФормы()
	КорреспондентыКлиент.ОбновитьОтображениеПолейВводаГражданства(ЭтаФорма);
КонецПроцедуры




