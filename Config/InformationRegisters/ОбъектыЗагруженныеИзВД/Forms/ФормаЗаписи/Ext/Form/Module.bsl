
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьПоИдентификаторуИсточника();
	УстановитьЗначенияФлагов();
	УстановитьЗаголовки();
	УстановитьВидимостьЭлементовФормы();
КонецПроцедуры   

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ЗаписатьИзмененияВСвязанныеДокументы();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗагруженныеОбъекты

&НаКлиенте
Процедура ЗагруженныеОбъектыПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	ТекущиеДанные = Элементы.ЗагруженныеОбъекты.ТекущиеДанные;
	ОткрытьФорму(ИмяФормыДокумента(ТекущиеДанные.ЗагруженныйДокумент),
		Новый Структура("Ключ, ТолькоПросмотр", ТекущиеДанные.ЗагруженныйДокумент, Истина));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаЗаписатьИЗакрыть(Команда)
	ЗаписатьИзмененияНаКлиенте();
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаписать(Команда)
	ЗаписатьИзмененияНаКлиенте();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьЗаголовки()
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияУстановленЗапрет",
		"Заголовок",
		РегистрыСведений.ОбъектыЗагруженныеИзВД.НаименованиеПричины("УстановленЗапрет"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияРучнаяКорректировка",
		"Заголовок",
		РегистрыСведений.ОбъектыЗагруженныеИзВД.НаименованиеПричины("РучнаяКорректировка"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияНачатПроцессВнутреннегоЭДО",
		"Заголовок",
		РегистрыСведений.ОбъектыЗагруженныеИзВД.НаименованиеПричины("НачатПроцессВнутреннегоЭДО"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияНачатПроцессПОД",
		"Заголовок",
		РегистрыСведений.ОбъектыЗагруженныеИзВД.НаименованиеПричины("НачатПроцессПОД"));
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияФлагов()
	СостояниеЗапрета = РегистрыСведений.ОбъектыЗагруженныеИзВД.СостояниеЗапретаЗагрузкиДокументов(
		ЗагруженныеДокументы());
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, СостояниеЗапрета);
КонецПроцедуры

&НаСервере
Функция ЗагруженныеДокументы()
	Результат = Новый Массив;
	Для Каждого Строка Из ЗагруженныеОбъекты Цикл
		Результат.Добавить(Строка.ЗагруженныйДокумент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	ДокументНеМожетБытьЗагружен = Запись.ЗапретЗагрузкиПользовательский Или РучнаяКорректировка;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияДокументМожетБытьЗагружен",
		"Видимость", Не ДокументНеМожетБытьЗагружен); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияДокументНеМожетБытьЗагружен",
		"Видимость", ДокументНеМожетБытьЗагружен); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияУстановленЗапрет",
		"Видимость", Запись.ЗапретЗагрузкиПользовательский); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияРучнаяКорректировка",
		"Видимость", РучнаяКорректировка); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияНачатПроцессВнутреннегоЭДО",
		"Видимость", НачатПроцессВнутреннегоЭДО); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияНачатПроцессПОД",
		"Видимость", НачатПроцессПОД); 
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяФормыДокумента(Знач ЗагруженныйДокумент)
	Возврат ЗагруженныйДокумент.Метаданные().ПолноеИмя() + ".ФормаОбъекта";
КонецФункции

&НаСервере
Процедура ЗаполнитьПоИдентификаторуИсточника()
	ЗагруженныеОбъекты.Очистить();
	РучнаяКорректировка = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбъектыЗагруженныеИзВД.Объект КАК ЗагруженныйДокумент,
	|	ТИПЗНАЧЕНИЯ(ОбъектыЗагруженныеИзВД.Объект) КАК ТипДокумента,
	|	ОбъектыЗагруженныеИзВД.УзелИнформационнойБазы,
	|	ОбъектыЗагруженныеИзВД.ЗапретЗагрузкиПользовательский,
	|	ОбъектыЗагруженныеИзВД.ЗапретЗагрузкиВнутреннийЭДО,
	|	ОбъектыЗагруженныеИзВД.ЗапретЗагрузкиПОД,
	|	ОбъектыЗагруженныеИзВД.Дата,
	|	ОбъектыЗагруженныеИзВД.Номер,
	|	ОбъектыЗагруженныеИзВД.ПредставлениеДокументаВД,
	|	ОбъектыЗагруженныеИзВД.УникальныйИдентификаторДокументаВД,
	|	ОбъектыЗагруженныеИзВД.Организация,
	|	ОбъектыЗагруженныеИзВД.Контрагент,
	|	ОбъектыЗагруженныеИзВД.ЦМООтправитель,
	|	ОбъектыЗагруженныеИзВД.ЦМОПолучатель,
	|	ОбъектыЗагруженныеИзВД.Комментарий КАК Комментарий,
	|	ОбъектыЗагруженныеИзВД.ПометкаУдаления,
	|	ОбъектыЗагруженныеИзВД.Проведен,
	|	ОперацииДокументов.ДокументСторнирован,
	|	ОперацииДокументов.ЕстьПроводки,
	|	ОперацииДокументов.ИсправлениеОшибки,
	|	ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) КАК РучнаяКорректировка
	|ИЗ
	|	РегистрСведений.ОбъектыЗагруженныеИзВД КАК ОбъектыЗагруженныеИзВД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ОбъектыЗагруженныеИзВД.Объект = ОперацииДокументов.Документ
	|ГДЕ
	|	ОбъектыЗагруженныеИзВД.УникальныйИдентификаторДокументаВД = &УникальныйИдентификаторДокументаВД";
	Запрос.УстановитьПараметр("УникальныйИдентификаторДокументаВД", Запись.УникальныйИдентификаторДокументаВД);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ЗагруженныеОбъекты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.СостояниеДокумента = СостояниеДокумента(Выборка);
		НоваяСтрока.СостояниеОперации = СостояниеОперацииКод(Выборка);
		НоваяСтрока.ТипДокумента = Новый ОписаниеТипов(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Выборка.ТипДокумента));
		РучнаяКорректировка = РучнаяКорректировка Или Выборка.РучнаяКорректировка;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СостояниеОперацииКод(Выборка)
	Если Выборка.ЕстьПроводки = NULL Тогда
		Возврат 0;
	ИначеЕсли Не Выборка.ЕстьПроводки Тогда
		Возврат 1;
	ИначеЕсли Выборка.ДокументСторнирован = Истина Тогда
		Возврат 4
	ИначеЕсли Выборка.РучнаяКорректировка = Истина Тогда
		Возврат 3;
	ИначеЕсли Выборка.ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода
			Или Выборка.ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода Тогда
		Возврат 5;
	Иначе
		Возврат 2;
	КонецЕсли;	
КонецФункции

&НаСервере
Функция СостояниеДокумента(Выборка)

	Если Выборка.Проведен Тогда
		Возврат 2;
	ИначеЕсли Выборка.ПометкаУдаления Тогда
		Возврат 3
	Иначе
		Возврат 1;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ЗаписатьИзмененияНаКлиенте()
//	ЗаписатьИзменения();
	Оповестить("РегистрацияЗапретаПовторнойЗагрузкиОбъектаВД", Запись.УникальныйИдентификаторДокументаВД, ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ЗаписатьИзмененияВСвязанныеДокументы()
	НачатьТранзакцию();
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ОбъектыЗагруженныеИзВД.Объект,
		|	ОбъектыЗагруженныеИзВД.УзелИнформационнойБазы
		|ИЗ
		|	РегистрСведений.ОбъектыЗагруженныеИзВД КАК ОбъектыЗагруженныеИзВД
		|ГДЕ
		|	ОбъектыЗагруженныеИзВД.УникальныйИдентификаторДокументаВД = &УникальныйИдентификаторДокументаВД
		|	И ОбъектыЗагруженныеИзВД.Объект <> &Ссылка";
		Запрос.УстановитьПараметр("УникальныйИдентификаторДокументаВД", Запись.УникальныйИдентификаторДокументаВД);
		Запрос.УстановитьПараметр("Ссылка", Запись.Объект);
		РезультатЗапроса = Запрос.Выполнить();
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОбъектыЗагруженныеИзВД");
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("УзелИнформационнойБазы", "УзелИнформационнойБазы");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Объект", "Объект");
		Блокировка.Заблокировать();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			НаборЗаписей = РегистрыСведений.ОбъектыЗагруженныеИзВД.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Объект.Установить(Выборка.Объект);
			НаборЗаписей.Отбор.УзелИнформационнойБазы.Установить(Выборка.УзелИнформационнойБазы);
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() > 0 Тогда
				НаборЗаписей[0].ЗапретЗагрузкиПользовательский = Запись.ЗапретЗагрузкиПользовательский;
				НаборЗаписей.Записать(Истина);
			КонецЕсли;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
