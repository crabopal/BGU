// Обновить запись.
// 
// Параметры:
//  Объект - ОпределяемыйТип.ДокументыЗагружаемыеИзВД
Процедура ОбновитьЗапись(Объект) Экспорт
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОбъектыЗагруженныеИзВД");
		ЭлементБлокировки.УстановитьЗначение("Объект", Объект.Ссылка);
		Блокировка.Заблокировать();
		
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(Объект.Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(НаборЗаписей[0], ДанныеДокументаДляЗаписи(Объект));
			НаборЗаписей.Записать(Истина);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Обновить запись при загрузке.
// 
// Параметры:
//  Объект - ДокументОбъект
//  УзелИнформационнойБазы - ПланОбменаСсылка.ОбменВДБГУ2
//  ЗапретЗагрузкиПользовательский - Булево
//  ПредставлениеДокументаВД - Строка
//  УникальныйИдентификаторДокументаВД - Строка
Процедура ОбновитьЗаписьПриЗагрузке(Объект, УзелИнформационнойБазы, ЗапретЗагрузкиПользовательский,
	ПредставлениеДокументаВД, УникальныйИдентификаторДокументаВД) Экспорт

	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;

	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(Объект));

	ТребуемыеРеквизиты = ИменаРеквизитовДокументов(МетаданныеДокумента);
	ДанныеДляЗаписи = СтруктураДанныхДокументаДляЗаписи();
	ЗаполнитьДанныеДокументаИзОбъекта(ДанныеДляЗаписи, ТребуемыеРеквизиты, Объект);
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОбъектыЗагруженныеИзВД");
		ЭлементБлокировки.УстановитьЗначение("Объект", Объект.Ссылка);
		Блокировка.Заблокировать();
		
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(Объект.Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
			Запись.Объект = Объект.Ссылка;
			Запись.УзелИнформационнойБазы = УзелИнформационнойБазы;
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Запись, ДанныеДокументаДляЗаписи(Объект));
		Запись.ПредставлениеДокументаВД = ПредставлениеДокументаВД;
		Запись.УникальныйИдентификаторДокументаВД = УникальныйИдентификаторДокументаВД;
		Запись.ЗапретЗагрузкиПользовательский = ЗапретЗагрузкиПользовательский;
		НаборЗаписей.Записать(Истина);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Состояние запрета загрузки документов.
// 
// Параметры:
//  ЗагружаемыеДокументы - ДокументСсылка
//                       - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//  Структура - Состояние запрета загрузки документов:
// * УстановленЗапрет - Булево - 
// * РучнаяКорректировка - Булево - 
// * НачатПроцессВнутреннегоЭДО - Булево - 
// * НачатПроцессПОД - Булево - 
Функция СостояниеЗапретаЗагрузкиДокументов(ЗагружаемыеДокументы) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("УстановленЗапрет", Ложь);
	Результат.Вставить("РучнаяКорректировка", Ложь);
	Результат.Вставить("НачатПроцессВнутреннегоЭДО", Ложь);
	Результат.Вставить("НачатПроцессПОД", Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ОбъектыЗагруженныеИзВД.ЗапретЗагрузкиПользовательский) КАК ЗапретЗагрузкиПользовательский,
	|	МАКСИМУМ(ОбъектыЗагруженныеИзВД.ЗапретЗагрузкиВнутреннийЭДО) КАК ЗапретЗагрузкиВнутреннийЭДО,
	|	МАКСИМУМ(ОбъектыЗагруженныеИзВД.ЗапретЗагрузкиПОД) КАК ЗапретЗагрузкиПОД
	|ИЗ
	|	РегистрСведений.ОбъектыЗагруженныеИзВД КАК ОбъектыЗагруженныеИзВД
	|ГДЕ
	|	ОбъектыЗагруженныеИзВД.Объект В (&ЗагружаемыеДокументы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|ГДЕ
	|	ОперацииДокументов.Документ В (&ЗагружаемыеДокументы)
	|	И ОперацииДокументов.РучнаяКорректировка";
	Запрос.УстановитьПараметр("ЗагружаемыеДокументы", ЗагружаемыеДокументы);
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	Выборка = РезультатЗапроса[0].Выбрать();
	Если Выборка.Следующий() Тогда
		//@skip-check statement-type-change
		//@skip-check property-return-type
		Результат.УстановленЗапрет = Выборка.ЗапретЗагрузкиПользовательский;
		//@skip-check statement-type-change
		//@skip-check property-return-type
		Результат.НачатПроцессВнутреннегоЭДО = Выборка.ЗапретЗагрузкиВнутреннийЭДО;
		//@skip-check statement-type-change
		//@skip-check property-return-type
		Результат.НачатПроцессПОД = Выборка.ЗапретЗагрузкиПОД;
	КонецЕсли;	
	Результат.РучнаяКорректировка = Не РезультатЗапроса[1].Пустой();
	
	Возврат Результат;
	
КонецФункции

// Причины блокировки. Если блокировка не установлена, возвращается Неопределено.
// 
// Параметры:
//  ЗагружаемыеДокументы - ДокументСсылка
//                       - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//  Неопределено, Структура - Причины блокировки:
// * УстановленЗапрет - Булево - 
// * РучнаяКорректировка - Булево - 
// * НачатПроцессВнутреннегоЭДО - Булево - 
// * НачатПроцессПОД - Булево - 
Функция ПричиныБлокировки(ЗагружаемыеДокументы) Экспорт
	СостояниеЗапрета = СостояниеЗапретаЗагрузкиДокументов(ЗагружаемыеДокументы);
	УдаляемыеКлючи = Новый Массив; // Массив из Строка
	Для Каждого КлючИЗначение Из СостояниеЗапрета Цикл
		Если КлючИЗначение.Значение <> Истина Тогда
			УдаляемыеКлючи.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ключ Из УдаляемыеКлючи Цикл
		СостояниеЗапрета.Удалить(Ключ);
	КонецЦикла;
	Если ЗначениеЗаполнено(СостояниеЗапрета) Тогда
		Возврат СостояниеЗапрета;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Наименование причины.
// 
// Параметры:
//  КлючПричины - Строка
//  КодЯзыка - Строка - Код языка
// 
// Возвращаемое значение:
//  Строка - Наименование причины
Функция НаименованиеПричины(КлючПричины, КодЯзыка = "") Экспорт
	Если КлючПричины = "УстановленЗапрет" Тогда
		Возврат НСтр("ru = 'Установлен запрет на загрузку'", КодЯзыка);
	ИначеЕсли КлючПричины = "РучнаяКорректировка" Тогда
		Возврат НСтр("ru = 'Включена ручная корректировка проводок'", КодЯзыка);
	ИначеЕсли КлючПричины = "НачатПроцессВнутреннегоЭДО" Тогда
		Возврат НСтр("ru = 'Начат процесс подписания с использованием внутреннего ЭДО'", КодЯзыка);
	ИначеЕсли КлючПричины = "НачатПроцессПОД" Тогда
		Возврат НСтр("ru = 'Начат процесс обработки документа'", КодЯзыка);
	Иначе
		ВызватьИсключение НСтр("ru = 'Неизвестный ключ причины в функции РегистрыСведений.ОбъектыЗагруженныеИзВД.НаименованиеПричины'");
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Зарегистрировать данные к обработке для перехода на новую версию.
// 
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	// Параметры выборки данных для многопоточного обновления.
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.ПолныеИменаРегистров = "РегистрСведений.ОбъектыЗагруженныеИзВД";
	ПараметрыВыборки.СпособВыборки = ОбновлениеИнформационнойБазы.СпособВыборкиИзмеренияНезависимогоРегистраСведений();
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = "РегистрСведений.ОбъектыЗагруженныеИзВД";

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы КАК УзелИнформационнойБазы,
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника КАК Объект
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника) = ТИП(Документ.ПоступлениеМЗ)
	|	ИЛИ ТИПЗНАЧЕНИЯ(СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника) = Тип(Документ.ТребованиеНакладная0315006)
	|	ИЛИ ТИПЗНАЧЕНИЯ(СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника) = Тип(Документ.НакладнаяНаОтпускМ15)
	|	ИЛИ ТИПЗНАЧЕНИЯ(СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника) = Тип(Документ.АктСписанияМЗ)
	|	ИЛИ ТИПЗНАЧЕНИЯ(СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника) = Тип(Документ.АктСписанияМягкогоИХозИнвентаря)
	|	ИЛИ ТИПЗНАЧЕНИЯ(СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника) = Тип(Документ.ВедомостьНаВыдачуМЗНаНуждыУчреждения)
	|";
	ДопустимыеТипы = Новый Массив; // Массив из Тип
	ДопустимыеТипы.Добавить(Тип("ДокументСсылка.ПоступлениеМЗ"));
	ДопустимыеТипы.Добавить(Тип("ДокументСсылка.ТребованиеНакладная0315006"));
	ДопустимыеТипы.Добавить(Тип("ДокументСсылка.НакладнаяНаОтпускМ15"));
	ДопустимыеТипы.Добавить(Тип("ДокументСсылка.АктСписанияМЗ"));
	ДопустимыеТипы.Добавить(Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаря"));
	ДопустимыеТипы.Добавить(Тип("ДокументСсылка.ВедомостьНаВыдачуМЗНаНуждыУчреждения"));
	Запрос.УстановитьПараметр("ДопустимыеТипы", ДопустимыеТипы);

	РегистрируемыеСсылки = Новый ТаблицаЗначений;
	РегистрируемыеСсылки.Колонки.Добавить("Объект", Документы.ТипВсеСсылки());
	РегистрируемыеСсылки.Колонки.Добавить("УзелИнформационнойБазы", Новый ОписаниеТипов("ПланОбменаСсылка.ОбменВДБГУ2"));
	КоличествоСсылок = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(РегистрируемыеСсылки.Добавить(), Выборка);
		КоличествоСсылок = КоличествоСсылок + 1;
		Если КоличествоСсылок = 1000 Тогда
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, РегистрируемыеСсылки, ДополнительныеПараметры);
			РегистрируемыеСсылки.Очистить();
			КоличествоСсылок = 0;
		КонецЕсли;
	КонецЦикла;
	
	Если РегистрируемыеСсылки.Количество() > 0 Тогда
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, РегистрируемыеСсылки, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

// Обработать данные для перехода на новую версию.
// 
// Параметры:
//  Параметры - Структура -
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	ПроблемныхОбъектов = 0;
	ОбъектовОбработано = 0;
	
	ОбъектМетаданных = Метаданные.РегистрыСведений.ОбъектыЗагруженныеИзВД;
	ПолноеИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
	
	ТаблицаОбработки = Новый ТаблицаЗначений;
	ТаблицаОбработки.Колонки.Добавить("Объект", Документы.ТипВсеСсылки());
	ТаблицаОбработки.Колонки.Добавить("УзелИнформационнойБазы", Новый ОписаниеТипов("ПланОбменаСсылка.ОбменВДБГУ2"));
	// В таблице есть только 1 строка, которая заполняется из очередной порции данных 
	ТаблицаОбработки.Добавить();
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ПолноеИмяРегистра = ПолноеИмяОбъекта;
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
	
	// Выборка данных для многопоточного обновления.
	ОбрабатываемыеДокументы = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	Для каждого ОбрабатываемыйДокумент Из ОбрабатываемыеДокументы Цикл
		//@skip-check property-return-type
		ПредставлениеСсылки = Строка(ОбрабатываемыйДокумент.Объект);
		ЗаполнитьЗначенияСвойств(ТаблицаОбработки[0], ОбрабатываемыйДокумент);
		Попытка
			//@skip-check query-in-loop
			ОбработатьДокументПриОбновлении(ТаблицаОбработки, ОбъектМетаданных, ДополнительныеПараметры);
			ОбъектовОбработано = ОбъектовОбработано + 1;
		Исключение
			// Если не удалось обработать какой-либо документ, повторяем попытку снова.
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеСсылки);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%",
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				ОбъектМетаданных,
				,
				ТекстСообщения);
		КонецПопытки;
		
	КонецЦИкла;
	
	//@skip-check property-return-type
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь,
		ПолноеИмяОбъекта);
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Не удалось обработать некоторые ""%2"" (пропущены): %1'"), 
			ПроблемныхОбъектов,
			ПолноеИмяОбъекта);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			ОбъектМетаданных,,
			СтрШаблон(
				НСтр("ru = 'Обработана очередная порция ""%2"": %1'"),
				ОбъектовОбработано,
				ПолноеИмяОбъекта));
	КонецЕсли;
КонецПроцедуры

// Обработать документ при обновлении.
// 
// Параметры:
//  ТаблицаОбработки - ТаблицаЗначений:
// * Объект - ЛюбаяСсылка - 
// * УзелИнформационнойБазы - ПланОбменаСсылка.ОбменВДБГУ2 - 
//  ОбъектМетаданных - ОбъектМетаданныхРегистрСведений - Объект метаданных
//  ДополнительныеПараметры - см. ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки
Процедура ОбработатьДокументПриОбновлении(ТаблицаОбработки, ОбъектМетаданных, ДополнительныеПараметры)
	ОбрабатываемыйДокумент = ТаблицаОбработки[0];
	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ОбрабатываемыйДокумент.Объект));
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		
		ЭлементБлокировки = Блокировка.Добавить(ОбъектМетаданных.ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Объект", ОбрабатываемыйДокумент.Объект);
		ЭлементБлокировки.УстановитьЗначение("УзелИнформационнойБазы", ОбрабатываемыйДокумент.УзелИнформационнойБазы);
		
		ЭлементБлокировки = Блокировка.Добавить(МетаданныеДокумента.ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ОбрабатываемыйДокумент.Объект);
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОбъектыЗапрещенныеКПовторнойЗагрузкеВД");
		ЭлементБлокировки.УстановитьЗначение("ЗагруженныйОбъект", ОбрабатываемыйДокумент.Объект);
		
		Блокировка.Заблокировать();
		
		ВыполнятьОбработку = Истина;
		ДокументОбъект = ОбрабатываемыйДокумент.Объект.ПолучитьОбъект();
		ВыполнятьОбработку = (ДокументОбъект <> Неопределено);
		
		Если ВыполнятьОбработку Тогда 
			// Блокировка для запрета интерактивной работы с документом
			ДокументОбъект.Заблокировать();
			
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Объект.Установить(ОбрабатываемыйДокумент.Объект);
			НаборЗаписей.Отбор.УзелИнформационнойБазы.Установить(ОбрабатываемыйДокумент.УзелИнформационнойБазы);
			
			НаборЗаписей.Прочитать();
			ВыполнятьОбработку = (НаборЗаписей.Количество() = 0);
		КонецЕсли;
		
		Если ВыполнятьОбработку Тогда
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.УзелИнформационнойБазы = ОбрабатываемыйДокумент.УзелИнформационнойБазы;
			НоваяЗапись.Объект = ОбрабатываемыйДокумент.Объект;
			
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ДанныеДокументаДляЗаписиНовойЗаписи(ДокументОбъект));
			
			НоваяЗапись.ЗапретЗагрузкиПользовательский = РегистрыСведений.ОбъектыЗапрещенныеКПовторнойЗагрузкеВД
				.СостояниеЗапретаЗагрузкиДокументов(ДокументОбъект.Ссылка).УстановленЗапрет;
		
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, Ложь);
		Иначе
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ТаблицаОбработки, ДополнительныеПараметры);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Функция ДанныеДокументаДляЗаписиНовойЗаписи(СсылкаИлиОбъект)
	ДанныеДляЗаписи = ДанныеДокументаДляЗаписи(СсылкаИлиОбъект);

	Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(СсылкаИлиОбъект)) Тогда
		ДанныеДляЗаписи.УникальныйИдентификаторДокументаВД = УникальныйИдентификаторВДругойБазе(СсылкаИлиОбъект);
	Иначе
		ДанныеДляЗаписи.УникальныйИдентификаторДокументаВД = УникальныйИдентификаторВДругойБазе(СсылкаИлиОбъект.Ссылка);
	КонецЕсли;

	ДанныеДляЗаписи.ПредставлениеДокументаВД = ПредставлениеДокументаВДИзКомментария(
		ДанныеДляЗаписи.Комментарий);
	
	Возврат ДанныеДляЗаписи;
КонецФункции

Функция ДанныеДокументаДляЗаписи(СсылкаИлиОбъект)
	
	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(СсылкаИлиОбъект));

	ТребуемыеРеквизиты = ИменаРеквизитовДокументов(МетаданныеДокумента);
	ДанныеДляЗаписи = СтруктураДанныхДокументаДляЗаписи();
	Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(СсылкаИлиОбъект)) Тогда
		ЗаполнитьДанныеДокументаИзСсылки(ДанныеДляЗаписи, ТребуемыеРеквизиты, СсылкаИлиОбъект);
	Иначе
		ЗаполнитьДанныеДокументаИзОбъекта(ДанныеДляЗаписи, ТребуемыеРеквизиты, СсылкаИлиОбъект);
	КонецЕсли;
	
	Возврат ДанныеДляЗаписи;
	
КонецФункции

// Получить представление документа ВД из комментария
// 
// Параметры:
//  Комментарий - Строка 
//  
// Возвращаемое значение:
//  Строка
Функция ПредставлениеДокументаВДИзКомментария(Комментарий)
	РезультатыПоиска = СтрНайтиВсеПоРегулярномуВыражению(Комментарий,
		"//(.*\d+ от \d{2}\.\d{2}\.\d{4} \d{2}\:\d{2}\:\d{2})");
	Если РезультатыПоиска.Количество() > 0 Тогда
		Группы = РезультатыПоиска[РезультатыПоиска.ВГраница()].ПолучитьГруппы();
		Возврат Группы[Группы.ВГраница()].Значение;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция УникальныйИдентификаторВДругойБазе(Ссылка)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	|ГДЕ
	|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		//@skip-check property-return-type
		Возврат Выборка.УникальныйИдентификаторПриемника;
	КонецЕсли;
	Возврат "";		
КонецФункции

// Заполнить данные документа из объекта.
// 
// Параметры:
//  ДанныеДляЗаписи - см. СтруктураДанныхДокументаДляЗаписи 
//  ТребуемыеРеквизиты - см. ТребуемыеРеквизиты 
//  Объект - ЗадачаОбъект, СправочникОбъект, ПланВидовХарактеристикОбъект, БизнесПроцессОбъект, ПланВидовРасчетаОбъект, ПланСчетовОбъект, ПланОбменаОбъект, Неопределено, ДокументОбъект - Объект
Процедура ЗаполнитьДанныеДокументаИзОбъекта(ДанныеДляЗаписи, ТребуемыеРеквизиты, Объект)
	ИмяРеквизитаДокумента = Неопределено;
	Для Каждого КлючИЗначение Из ДанныеДляЗаписи Цикл
		Если ТребуемыеРеквизиты.Свойство(КлючИЗначение.Ключ, ИмяРеквизитаДокумента) Тогда
			//@skip-check statement-type-change
			ДанныеДляЗаписи[КлючИЗначение.Ключ] = Объект[ИмяРеквизитаДокумента];
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Заполнить данные документа из ссылки.
// 
// Параметры:
//  ДанныеДляЗаписи - см. СтруктураДанныхДокументаДляЗаписи 
//  ТребуемыеРеквизиты - см. ТребуемыеРеквизиты 
//  Ссылка - ЛюбаяСсылка - Ссылка
Процедура ЗаполнитьДанныеДокументаИзСсылки(ДанныеДляЗаписи, ТребуемыеРеквизиты, Ссылка)
	РеквизитыСсылки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, ТребуемыеРеквизиты);
	Для Каждого КлючИЗначение Из ДанныеДляЗаписи Цикл
		РеквизитыСсылки.Свойство(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
КонецПроцедуры

// Структура данных документа для записи.
// 
// Возвращаемое значение:
//  Структура - Структура данных документа для записи:
// * Дата - Дата - 
// * Номер - Строка - 
// * Организация - СправочникСсылка.Организации - 
// * ПометкаУдаления - Булево - 
// * Проведен - Булево - 
// * ПредставлениеДокументаВД - Строка - 
// * Контрагент - СправочникСсылка.Контрагенты - 
// * ЦМООтправитель - СправочникСсылка.ЦМО - 
// * ЦМОПолучатель - СправочникСсылка.ЦМО - 
// * УникальныйИдентификаторДокументаВД - Строка - 
// * Комментарий - Строка - 
Функция СтруктураДанныхДокументаДляЗаписи()
	ТребуемыеРеквизиты = Новый Структура;
	ТребуемыеРеквизиты.Вставить("Дата", '00010101');
	ТребуемыеРеквизиты.Вставить("Номер", "");
	ТребуемыеРеквизиты.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ТребуемыеРеквизиты.Вставить("ПометкаУдаления", Ложь);
	ТребуемыеРеквизиты.Вставить("Проведен", Ложь);
	ТребуемыеРеквизиты.Вставить("ПредставлениеДокументаВД", "");
	ТребуемыеРеквизиты.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	ТребуемыеРеквизиты.Вставить("ЦМООтправитель", Справочники.ЦМО.ПустаяСсылка());
	ТребуемыеРеквизиты.Вставить("ЦМОПолучатель", Справочники.ЦМО.ПустаяСсылка());
	ТребуемыеРеквизиты.Вставить("УникальныйИдентификаторДокументаВД", "");
	ТребуемыеРеквизиты.Вставить("Комментарий", "");
	Возврат ТребуемыеРеквизиты;
КонецФункции

// Имена реквизитов документов.
// 
// Параметры:
//  МетаданныеДокумента - ОбъектМетаданных
// 
// Возвращаемое значение:
//  Структура - Имена реквизитов документов:
// * Дата - Строка - 
// * Номер - Строка - 
// * Организация - Строка - 
// * ПометкаУдаления - Строка - 
// * Проведен - Строка - 
// * Комментарий - Строка - 
// * Контрагент - Строка - 
// * ЦМООтправитель - Строка - 
// * ЦМОПолучатель - Строка - 
Функция ИменаРеквизитовДокументов(МетаданныеДокумента)
	ТребуемыеРеквизиты = Новый Структура;
	ТребуемыеРеквизиты.Вставить("Дата", "Дата");
	ТребуемыеРеквизиты.Вставить("Номер", "Номер");
	ТребуемыеРеквизиты.Вставить("Организация", "Организация");
	ТребуемыеРеквизиты.Вставить("ПометкаУдаления", "ПометкаУдаления");
	ТребуемыеРеквизиты.Вставить("Проведен", "Проведен");
	ТребуемыеРеквизиты.Вставить("Комментарий", "Комментарий");
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Контрагент", МетаданныеДокумента) Тогда
		ТребуемыеРеквизиты.Вставить("Контрагент", "Контрагент");
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЦМООтправитель", МетаданныеДокумента) Тогда
		ТребуемыеРеквизиты.Вставить("ЦМООтправитель", "ЦМООтправитель");
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЦМОПолучатель", МетаданныеДокумента) Тогда
		ТребуемыеРеквизиты.Вставить("ЦМОПолучатель", "ЦМОПолучатель");
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЦМО", МетаданныеДокумента) Тогда
		Если МетаданныеДокумента.Имя = "ПоступлениеМЗ" Тогда
			ТребуемыеРеквизиты.Вставить("ЦМОПолучатель", "ЦМО");
		Иначе
			ТребуемыеРеквизиты.Вставить("ЦМООтправитель","ЦМО");
		КонецЕсли;
	КонецЕсли;
	Возврат ТребуемыеРеквизиты;
	
КонецФункции

#КонецОбласти

#КонецЕсли
