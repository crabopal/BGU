
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоКопирование = Параметры.Свойство("Копирование");
	ЭтоНовый = Параметры.Свойство("Новый");
	
	Если Параметры.Свойство("ЗначенияЗаполнения") Тогда
		Для Каждого СвойствоСтруктуры Из Параметры.ЗначенияЗаполнения Цикл
			Если Элементы.Найти(СвойствоСтруктуры.Ключ) <> Неопределено Тогда
				ЭтотОбъект[СвойствоСтруктуры.Ключ] = СвойствоСтруктуры.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Период) Тогда
		Период = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	КонецЕсли;
	
	Если Не ЭтоНовый Тогда
		ЗаполнитьКоллекцияВидыОпераций(Не ЭтоКопирование);
	КонецЕсли;
		
	ПоказатьТолькоВыбранныеОперации = КоллекцияВидыОпераций.Количество() <> 0;
	
	ОбновитьТаблицуВидыОпераций(ПоказатьТолькоВыбранныеОперации);
	Элементы.ВидыОперацийПоказатьТолькоВыбранныеОперации.Пометка = ПоказатьТолькоВыбранныеОперации;
	
	УстановитьУсловноеОформление();
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтаФорма);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Оповестить("РегистрСведений_НастройкаСтатейФинансированияЗарплата_ДобавленаИзмененаЗапись");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	ПериодПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПериодПриИзмененииНаСервере()
	Период = НачалоМесяца(Период);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВидыОперацийПриИзменении(Элемент)
	
	Если Элемент.ТекущийЭлемент.Имя = "ВидыОперацийПометка" Тогда
		
		ТекСтрока = Элемент.ТекущиеДанные;
		
		Если ТекСтрока.Включить = 2 Тогда
			ТекСтрока.Включить = 0;
		КонецЕсли;
		
		УстановитьПометкиПодчиненных(ТекСтрока);
		УстановитьПометкиРодителей(ТекСтрока);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элементы.КПС, 
														СтандартнаяОбработка, 
														КПС, 
														Организация,
														ИФО,
														КФО,
														Неопределено,
														Период);
	
КонецПроцедуры

&НаКлиенте
Процедура КФОНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СписокЗначенийКФО = ЗаполнитьСписокВыбораКФОСервер();
		
	Элементы.КФО.СписокВыбора.ЗагрузитьЗначения(СписокЗначенийКФО.ВыгрузитьЗначения());
	Элементы.КФО.РежимВыбораИзСписка = Истина;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьТолькоВыбранныеОперации(Команда)
	ПоказатьТолькоВыбранныеОперации = НЕ Элементы.ВидыОперацийПоказатьТолькоВыбранныеОперации.Пометка; 
	Элементы.ВидыОперацийПоказатьТолькоВыбранныеОперации.Пометка = ПоказатьТолькоВыбранныеОперации;
	
	ОбновитьТаблицуВидыОпераций(ПоказатьТолькоВыбранныеОперации);
КонецПроцедуры

&НаКлиенте
Процедура ВключитьОперации(Команда)
	
	Для Каждого Строка Из ВидыОпераций.ПолучитьЭлементы() Цикл
		Строка.Включить = 1;
		УстановитьПометкиПодчиненных(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключитьОперации(Команда)
	
	Для Каждого Строка Из ВидыОпераций.ПолучитьЭлементы() Цикл
		Строка.Включить = 0;
		УстановитьПометкиПодчиненных(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	ЗаписатьИЗакрытьЗавершение();	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьКоллекцияВидыОпераций(ЗагрузитьЭталон = Истина)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",							Период);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СтатьяФинансированияЗарплата",	СтатьяФинансированияЗарплата);
	Запрос.УстановитьПараметр("КЭК",							КЭК);
	Запрос.УстановитьПараметр("ИФО",							ИФО);
	Запрос.УстановитьПараметр("КФО",							КФО);
	Запрос.УстановитьПараметр("КПС",							КПС);
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкаСтатейФинансированияЗарплата.ВидОперации КАК ВидОперации,
	               |	НастройкаСтатейФинансированияЗарплата.Период КАК Период,
	               |	НастройкаСтатейФинансированияЗарплата.Организация КАК Организация,
	               |	НастройкаСтатейФинансированияЗарплата.СтатьяФинансированияЗарплата КАК СтатьяФинансированияЗарплата,
	               |	НастройкаСтатейФинансированияЗарплата.КЭК КАК КЭК
	               |ИЗ
	               |	РегистрСведений.НастройкаСтатейФинансированияЗарплата КАК НастройкаСтатейФинансированияЗарплата
	               |ГДЕ
	               |	НастройкаСтатейФинансированияЗарплата.Период = &Период
	               |	И НастройкаСтатейФинансированияЗарплата.Организация = &Организация
	               |	И НастройкаСтатейФинансированияЗарплата.СтатьяФинансированияЗарплата = &СтатьяФинансированияЗарплата
	               |	И НастройкаСтатейФинансированияЗарплата.КЭК = &КЭК
	               |	И НастройкаСтатейФинансированияЗарплата.ИФО = &ИФО
	               |	И НастройкаСтатейФинансированияЗарплата.КФО = &КФО
	               |	И НастройкаСтатейФинансированияЗарплата.КПС = &КПС";
	
	ТЗВидыОпераций = Запрос.Выполнить().Выгрузить();
	
	Если ЗагрузитьЭталон Тогда
		КоллекцияВидыОперацийЭталон.Загрузить(ТЗВидыОпераций);
	КонецЕсли;

	КоллекцияВидыОпераций.ЗагрузитьЗначения(ТЗВидыОпераций.ВыгрузитьКолонку("ВидОперации"));
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуВидыОпераций(ПоказатьТолькоВыбранныеОперации = Истина)
	
	ОперацииНачисления				= Перечисления.ВидыОперацийПоЗарплате.ВидыОперацийПоГруппам("Начисления");
	ОперацииЕжегодныеОтпуска		= Перечисления.ВидыОперацийПоЗарплате.ВидыОперацийПоГруппам("НачисленияОценочныеОбязательстваИРезервы");
	ОперацииЕжегодныеОтпускаВзносы	= Перечисления.ВидыОперацийПоЗарплате.ВидыОперацийПоГруппам("ВзносыОценочныеОбязательстваИРезервы");
	ОперацииНачислениеРезервов		= Перечисления.ВидыОперацийПоЗарплате.ВидыОперацийПоГруппам("НачислениеРезервов");
	ОперацииВзносы					= Перечисления.ВидыОперацийПоЗарплате.ВидыОперацийПоГруппам("Взносы");
	ОперацииУдержания				= Перечисления.ВидыОперацийПоЗарплате.ВидыОперацийПоГруппам("Удержания");
	ОперацииНДФЛ					= Перечисления.ВидыОперацийПоЗарплате.ВидыОперацийПоГруппам("НДФЛ");
	ОперацииВедомостьВБанк			= Перечисления.ВидыОперацийПоЗарплате.ВидыОперацийПоГруппам("ВедомостьВБанк");
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ВидыОперацийПоЗарплате.Ссылка КАК ВидОперации,
	               |	ВЫБОР
	               |		КОГДА ВидыОперацийПоЗарплате.Ссылка В (&ОперацииНачисления)
	               |			ТОГДА &ТекстНачисления
	               |		КОГДА ВидыОперацийПоЗарплате.Ссылка В (&ОперацииВзносы)
	               |			ТОГДА &ТекстВзносы
	               |		КОГДА ВидыОперацийПоЗарплате.Ссылка В (&ОперацииУдержания)
	               |			ТОГДА &ТекстУдержания
	               |		КОГДА ВидыОперацийПоЗарплате.Ссылка В (&ОперацииНДФЛ)
	               |			ТОГДА &ТекстНДФЛ
	               |		КОГДА ВидыОперацийПоЗарплате.Ссылка В (&ОперацииЕжегодныеОтпуска)
	               |			ТОГДА &ТекстЕжегодныеОтпуска
	               |		КОГДА ВидыОперацийПоЗарплате.Ссылка В (&ОперацииЕжегодныеОтпускаВзносы)
	               |			ТОГДА &ТекстЕжегодныеОтпускаВзносы
	               |		КОГДА ВидыОперацийПоЗарплате.Ссылка В (&ОперацииНачислениеРезервов)
	               |			ТОГДА &ТекстНачислениеРезервов
	               |		КОГДА ВидыОперацийПоЗарплате.Ссылка В (&ОперацииВедомостьВБанк)
	               |			ТОГДА &ТекстВедомостьВБанк
	               |	КОНЕЦ КАК Группа,
	               |	ВЫБОР
	               |		КОГДА ВидыОперацийПоЗарплате.Ссылка В (&КоллекцияВидыОпераций)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Включить,
	               |	ВидыОперацийПоЗарплате.Порядок КАК Порядок
	               |ИЗ
	               |	Перечисление.ВидыОперацийПоЗарплате КАК ВидыОперацийПоЗарплате
	               |ГДЕ
	               |	ВидыОперацийПоЗарплате.Ссылка В (&ОперацииНачисления,
	               |								&ОперацииВзносы,
	               |								&ОперацииУдержания, 
	               |								&ОперацииНДФЛ, 
	               |								&ОперацииЕжегодныеОтпуска, 
	               |								&ОперацииЕжегодныеОтпускаВзносы, 
	               |								&ОперацииНачислениеРезервов,
	               |								&ОперацииВедомостьВБанк)
	               |	[ОтборПоПричине]
	               |
	               |ИТОГИ
	               |	Группа КАК ВидОперации,
	               |	МАКСИМУМ(Включить)
	               |ПО
	               |	Группа";
	
	Если ПоказатьТолькоВыбранныеОперации Тогда
		СтрокаОтбора = "И ВидыОперацийПоЗарплате.Ссылка В(&КоллекцияВидыОпераций)";
	Иначе
		СтрокаОтбора = "";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[ОтборПоПричине]", СтрокаОтбора);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОперацииНачисления", 			ОперацииНачисления);
	Запрос.УстановитьПараметр("ОперацииЕжегодныеОтпуска",		ОперацииЕжегодныеОтпуска);
	Запрос.УстановитьПараметр("ОперацииВзносы",					ОперацииВзносы);
	Запрос.УстановитьПараметр("ОперацииУдержания",				ОперацииУдержания);
	Запрос.УстановитьПараметр("ОперацииНДФЛ",					ОперацииНДФЛ);
	Запрос.УстановитьПараметр("ОперацииЕжегодныеОтпускаВзносы",	ОперацииЕжегодныеОтпускаВзносы);
	Запрос.УстановитьПараметр("ОперацииНачислениеРезервов",		ОперацииНачислениеРезервов);
	Запрос.УстановитьПараметр("ОперацииВедомостьВБанк",			ОперацииВедомостьВБанк);
	Запрос.УстановитьПараметр("КоллекцияВидыОпераций",			КоллекцияВидыОпераций.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ТекстНачисления",				НСтр("ru='Начисления'")); 
	Запрос.УстановитьПараметр("ТекстЕжегодныеОтпуска",			НСтр("ru='Начисления за счет оценочных обязательств и резервов'")); 
	Запрос.УстановитьПараметр("ТекстВзносы",					НСтр("ru='Взносы'"));
	Запрос.УстановитьПараметр("ТекстУдержания",					НСтр("ru='Удержания'"));
	Запрос.УстановитьПараметр("ТекстНДФЛ",						НСтр("ru='НДФЛ'"));
	Запрос.УстановитьПараметр("ТекстЕжегодныеОтпускаВзносы",	НСтр("ru='Взносы за счет оценочных обязательств и резервов'"));
	Запрос.УстановитьПараметр("ТекстНачислениеРезервов",		НСтр("ru='Начисление резервов по отпускам'"));
	Запрос.УстановитьПараметр("ТекстВедомостьВБанк",			НСтр("ru='Ведомость в банк'"));
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ЗначениеВРеквизитФормы(Выборка,"ВидыОпераций");
	
КонецПроцедуры

&НаСервере
Процедура ВидыОперацийПометкаПриИзмененииНаСервере(ВидОперации, ДобавитьВидОперации)
	
	НайденныйВидОперации = КоллекцияВидыОпераций.НайтиПоЗначению(ВидОперации);
	
	Если ДобавитьВидОперации Тогда
		Если НайденныйВидОперации = Неопределено Тогда
			КоллекцияВидыОпераций.Добавить(ВидОперации);
		КонецЕсли;
	Иначе
		Если НайденныйВидОперации <> Неопределено Тогда
			КоллекцияВидыОпераций.Удалить(НайденныйВидОперации);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкиПодчиненных(ТекСтрока)
	
	Если ЗначениеЗаполнено(ТекСтрока.ВидОперации) Тогда
		ВидыОперацийПометкаПриИзмененииНаСервере(ТекСтрока.ВидОперации, ТекСтрока.Включить);
	КонецЕсли;
		
	Подчиненные = ТекСтрока.ПолучитьЭлементы();
	
	Если Подчиненные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из Подчиненные Цикл
		Строка.Включить = ТекСтрока.Включить;
		УстановитьПометкиПодчиненных(Строка);
	КонецЦикла;
		
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьПометкиРодителей(ТекСтрока)
	
	Родитель = ТекСтрока.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ТекСостояние = Родитель.Включить;
	
	НайденыВключенные  = Ложь;
	НайденыВыключенные = Ложь;
	
	Для Каждого Строка Из Родитель.ПолучитьЭлементы() Цикл
		Если Строка.Включить = 0 Тогда
			НайденыВыключенные = Истина;
		ИначеЕсли Строка.Включить = 1
			ИЛИ Строка.Включить = 2 Тогда
			НайденыВключенные  = Истина;
		КонецЕсли; 
		Если НайденыВключенные И НайденыВыключенные Тогда
			Прервать;
		КонецЕсли; 
	КонецЦикла;
	
	Если НайденыВключенные И НайденыВыключенные Тогда
		Включить = 2;
	ИначеЕсли НайденыВключенные И (Не НайденыВыключенные) Тогда
		Включить = 1;
	ИначеЕсли (Не НайденыВключенные) И НайденыВыключенные Тогда
		Включить = 0;
	ИначеЕсли (Не НайденыВключенные) И (Не НайденыВыключенные) Тогда
		Включить = 2;
	КонецЕсли;
	
	Если Включить = ТекСостояние Тогда
		Возврат;
	Иначе
		Родитель.Включить = Включить;
		УстановитьПометкиРодителей(Родитель);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрытьЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Отказ = ПроверитьЗаполнениеФормы();
	
	Если Не Отказ Тогда
		ЗаписатьДвижения();
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДвижения()
	
	НачатьТранзакцию();
	
	Попытка
		
		Для Каждого СтрокаТаблицы Из КоллекцияВидыОперацийЭталон Цикл
			НаборЗаписейЭталон = РегистрыСведений.НастройкаСтатейФинансированияЗарплата.СоздатьНаборЗаписей();
			НаборЗаписейЭталон.Отбор.Период.Установить(СтрокаТаблицы.Период);
			НаборЗаписейЭталон.Отбор.Организация.Установить(СтрокаТаблицы.Организация);
			НаборЗаписейЭталон.Отбор.ВидОперации.Установить(СтрокаТаблицы.ВидОперации);
			НаборЗаписейЭталон.Отбор.СтатьяФинансированияЗарплата.Установить(СтрокаТаблицы.СтатьяФинансированияЗарплата);
			НаборЗаписейЭталон.Отбор.КЭК.Установить(СтрокаТаблицы.КЭК);
			НаборЗаписейЭталон.Очистить();
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписейЭталон);
		КонецЦикла;
		
		НовыйНаборЗаписей = РегистрыСведений.НастройкаСтатейФинансированияЗарплата.СоздатьНаборЗаписей();
		НовыйНаборЗаписей.Отбор.Период.Установить(НачалоМесяца(Период));
		НовыйНаборЗаписей.Отбор.Организация.Установить(Организация);
		НовыйНаборЗаписей.Отбор.СтатьяФинансированияЗарплата.Установить(СтатьяФинансированияЗарплата);
		НовыйНаборЗаписей.Отбор.КЭК.Установить(КЭК);
		НовыйНаборЗаписей.Прочитать();
		
		Если КоллекцияВидыОпераций.Количество() > 0 Тогда
			Для Каждого СтрокаТаблицы Из КоллекцияВидыОпераций Цикл
				НоваяЗапись = НовыйНаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяЗапись, ЭтотОбъект);
				НоваяЗапись.ВидОперации = СтрокаТаблицы.Значение;
			КонецЦикла;
		Иначе
			НоваяЗапись = НовыйНаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ЭтотОбъект);	
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НовыйНаборЗаписей, Истина, Истина);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеФормы()
	
	ПроверяемыеРеквизиты = Новый Структура;	
		
	ПроверяемыеРеквизиты.Вставить("Организация",						НСтр("ru = 'Организация'"));
	ПроверяемыеРеквизиты.Вставить("Период",								НСтр("ru = 'Настройка действует с'"));
	ПроверяемыеРеквизиты.Вставить("СтатьяФинансированияЗарплата",		НСтр("ru = 'Статья финансирования'"));

	Ошибки = Неопределено;
	Для Каждого ПроверяемыйРеквизит Из ПроверяемыеРеквизиты Цикл
		Если НЕ ЗначениеЗаполнено(ЭтаФорма[ПроверяемыйРеквизит.Ключ]) Тогда
			ШаблонОшибки = НСтр("ru = 'Не заполнено обязательное поле ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОшибки, ПроверяемыйРеквизит.Значение);
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,	ПроверяемыйРеквизит.Ключ, ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	
	Отказ = Ложь;
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	
	Возврат Отказ;

КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
 	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ВидыОперацийГруппа.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидыОпераций.ВидОперации");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;

	Элемент.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);

КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокВыбораКФОСервер()
	
	СписокЗначенийКФО = Новый СписокЗначений;
	
	БухгалтерскийУчет.ЗаполнитьСписокКФО(
			СписокЗначенийКФО,
			КФО,
			ПолучитьМассивКФО(),
			"КФО",
			"",
			Новый Структура("Организация, ИФО, Дата, НаНачалоСледующегоГода", Организация, ИФО, Период, Истина));
	
	Возврат СписокЗначенийКФО;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьМассивКФО()
	
	Результат = Новый Массив;
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.Бюджет"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.Внебюджет"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаГосзадание"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаИныеЦели"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.БюджетныеИнвестиции"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.СредстваОМС"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение"));
	Возврат Результат;
	
КонецФункции

#КонецОбласти


