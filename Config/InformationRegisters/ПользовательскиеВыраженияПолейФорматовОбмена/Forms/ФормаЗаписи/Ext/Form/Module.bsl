
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВыражениеВФорматеОбмена = Параметры.ВыражениеВФорматеОбмена;
	
	Если ЗначениеЗаполнено(Параметры.ФорматОбмена) Тогда
		ЗаполнитьЗначенияСвойств(Запись,Параметры);		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВыражениеВФорматеОбмена) Тогда
		ОбновитьВыражениеФорматаСервер();
	КонецЕсли;
	
	ЗаписьРС = РеквизитФормыВЗначение("Запись");
	ЗаписьРС.Прочитать();
	
	Если ЗаписьРС.Выбран() Тогда
		ЗначениеВРеквизитФормы(ЗаписьРС,"Запись");
	Иначе
		//это новая запись, установим начальное значение пользовательского выражения
	
		Если НЕ ЗначениеЗаполнено(Запись.ПользовательскоеВыражение) Тогда 
			Запись.ПользовательскоеВыражение = ВыражениеВФорматеОбмена;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ВыбранноеПоле = "";
		ВыбранноеЗначение.Свойство("ПолеФайла",Запись.ПолеФайла);
		
		ВыбранноеЗначение.Свойство("ОбрабатываемоеПоле",Запись.ОбрабатываемоеПоле);
		
		ВыбранноеЗначение.Свойство("НомерСтроки",Запись.НомерСтрокиПравил);
		
		СтароеВыражение = ВыражениеВФорматеОбмена;
		
		ВыбранноеЗначение.Свойство("ВыражениеВФорматеОбмена",ВыражениеВФорматеОбмена);
		
		Если НЕ ЗначениеЗаполнено(Запись.ПользовательскоеВыражение) 
			ИЛИ СтароеВыражение = Запись.ПользовательскоеВыражение Тогда
			Запись.ПользовательскоеВыражение = ВыражениеВФорматеОбмена;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Запись.ОбрабатываемоеПоле) Тогда
		Запись.ОбрабатываемоеПоле = "ПолеОбъекта";
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ПолеФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПараметрыФормы = Новый Структура("ФорматОбмена",Запись.ФорматОбмена);
	
	ОткрытьФорму("РегистрСведений.ПользовательскиеВыраженияПолейФорматовОбмена.Форма.ФормаВыбораСтрокиФормата", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ОбновитьВыражениеФормата(Команда)
	
	Если ЗначениеЗаполнено(Запись.ФорматОбмена) 
		И ЗначениеЗаполнено(Запись.ПолеФайла)
		И ЗначениеЗаполнено(Запись.ОбрабатываемоеПоле) Тогда
		ОбновитьВыражениеФорматаСервер();
	Иначе
		ВыражениеВФорматеОбмена = "";
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ОбновитьВыражениеФорматаСервер()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КС_ФорматыПравилаОбмена.ПолеОбъекта КАК ПолеОбъекта,
		|	КС_ФорматыПравилаОбмена.ПорядокЗаполнения КАК ПорядокЗаполнения,
		|	КС_ФорматыПравилаОбмена.Условие КАК Условие,
		|	КС_ФорматыПравилаОбмена.ПроверкаВалидностиДанных КАК ПроверкаВалидностиДанных,
		|	КС_ФорматыПравилаОбмена.ДопДействия КАК ДопДействия,
		|	КС_ФорматыПравилаОбмена.ОграничениеРазмерности КАК ОграничениеРазмерности,
		|	КС_ФорматыПравилаОбмена.СообщениеПриОшибкеВалидности КАК СообщениеПриОшибкеВалидности
		|ИЗ
		|	Справочник.ФорматыОбменаБанкиКС.ПравилаОбмена КАК КС_ФорматыПравилаОбмена
		|ГДЕ
		|	(ВЫРАЗИТЬ(КС_ФорматыПравилаОбмена.ПолеФайлаПередачи КАК СТРОКА(1000))) = &ПолеФайлаПередачи
		|	И КС_ФорматыПравилаОбмена.Ссылка = &Ссылка
		|	И ВЫБОР
		|			КОГДА &НомерСтроки > 0
		|				ТОГДА КС_ФорматыПравилаОбмена.НомерСтроки = &НомерСтроки
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";

	Запрос.УстановитьПараметр("Ссылка", Запись.ФорматОбмена);
	Запрос.УстановитьПараметр("ПолеФайлаПередачи", Запись.ПолеФайла);
    Запрос.УстановитьПараметр("НомерСтроки", Запись.НомерСтрокиПравил);
	
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ВыражениеВФорматеОбмена = ВыборкаДетальныеЗаписи[Запись.ОбрабатываемоеПоле];
	Иначе
		ВыражениеВФорматеОбмена = "";
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("ЗаписьПереопределяемогоПоля",Запись.ФорматОбмена,ЭтаФорма);
КонецПроцедуры
