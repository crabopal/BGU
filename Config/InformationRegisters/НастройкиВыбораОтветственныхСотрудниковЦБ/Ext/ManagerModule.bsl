#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает сохраненные настройки по объекту метаданных
// 
// Параметры:
//  ИдентификаторОбъекта - СправочникСсылка.ИдентификаторыОбъектовМетаданных
//  ИмяРеквизита - Строка
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Настройки по объекту:
//   * ИмяРеквизита - Строка
//   * СпособВыбора - ПеречислениеСсылка.СпособВыбораОтветственногоЦБ 
Функция НастройкиПоОбъекту(ИдентификаторОбъекта, ИмяРеквизита = "") Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиВыбораОтветственныхСотрудниковЦБ.ИмяРеквизита,
	|	НастройкиВыбораОтветственныхСотрудниковЦБ.СпособВыбора
	|ИЗ
	|	РегистрСведений.НастройкиВыбораОтветственныхСотрудниковЦБ КАК НастройкиВыбораОтветственныхСотрудниковЦБ
	|ГДЕ
	|	НастройкиВыбораОтветственныхСотрудниковЦБ.ВидОбъекта = &ВидОбъекта
	|	И НастройкиВыбораОтветственныхСотрудниковЦБ.СпособВыбора <> ЗНАЧЕНИЕ(Перечисление.СпособВыбораОтветственногоЦБ.ПустаяСсылка)";
	Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И НастройкиВыбораОтветственныхСотрудниковЦБ.ИмяРеквизита = &ИмяРеквизита";
		Запрос.УстановитьПараметр("ИмяРеквизита", ИмяРеквизита);
	КонецЕсли;
	Запрос.УстановитьПараметр("ВидОбъекта", ИдентификаторОбъекта);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ЗагрузитьЭлементы(Очищать = Ложь) Экспорт
	
	Если НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.НастройкиВыбораОтветственныхСотрудниковЦБ) Тогда
		Возврат;
	КонецЕсли;
	
	Если Очищать Тогда
		Регистр = РегистрыСведений.НастройкиВыбораОтветственныхСотрудниковЦБ.СоздатьНаборЗаписей();
		Регистр.Очистить();
		Регистр.Записать();
	КонецЕсли;
	
	Макет = ПолучитьМакет("НастройкиВыбораПоУмолчанию");
	Для ТекСтр=2 По Макет.ВысотаТаблицы Цикл
	
		СоздатьЭлемент(Макет.Область("R"+ТекСтр+"C1").Текст,
						Макет.Область("R"+ТекСтр+"C2").Текст,
						Макет.Область("R"+ТекСтр+"C3").Текст);
	
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьЭлементы()()

Процедура СоздатьЭлемент(ВидОбъекта, ИмяРеквизита, СпособВыбора) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ИдентификаторыОбъектовМетаданных.Ссылка
	|ИЗ
	|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	|ГДЕ
	|	ИдентификаторыОбъектовМетаданных.ПолноеИмя = &ПолноеИмя");
	Запрос.УстановитьПараметр("ПолноеИмя", ВидОбъекта);
	
	РезультатВыборки = Запрос.Выполнить().Выбрать();
	Если НЕ РезультатВыборки.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.НастройкиВыбораОтветственныхСотрудниковЦБ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВидОбъекта.Установить(РезультатВыборки.Ссылка);
	НаборЗаписей.Отбор.ИмяРеквизита.Установить(ИмяРеквизита);
	
	НовЗапись = НаборЗаписей.Добавить();
	НовЗапись.ВидОбъекта	= РезультатВыборки.Ссылка;
	НовЗапись.ИмяРеквизита	= ИмяРеквизита;
	
	ОбъектМетаданные = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(НовЗапись.ВидОбъекта);
	Если ОбъектМетаданные.Реквизиты.Найти(НовЗапись.ИмяРеквизита) <> Неопределено Тогда
		НовЗапись.ПредставлениеИмениРеквизита = ОбъектМетаданные.Реквизиты[НовЗапись.ИмяРеквизита].Синоним;
	КонецЕсли;
	
	НовЗапись.СпособВыбора = Перечисления.СпособВыбораОтветственногоЦБ[СпособВыбора];
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры // СоздатьЭлемент()

#КонецОбласти

#КонецЕсли
