#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьНастройкуПоУмолчанию(Команда)
	
	ЕстьДанныеВРегистре = ВРегистреНастройкиВыбораОтветственныхЕстьДанные();
	
	ТекстВопроса = "";
	Если ЕстьДанныеВРегистре Тогда
		ТекстВопроса = НСтр("ru = 'Текущие настройки выбора ответственных будут очищены. Продолжить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьРегистрЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьРегистрНаСервере();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВопросЗаполнитьРегистрЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьРегистрНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВРегистреНастройкиВыбораОтветственныхЕстьДанные()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НастройкиВыбораОтветственныхСотрудниковЦБ.ВидОбъекта
	|ИЗ
	|	РегистрСведений.НастройкиВыбораОтветственныхСотрудниковЦБ КАК НастройкиВыбораОтветственныхСотрудниковЦБ";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРегистрНаСервере()
	
	РегистрыСведений.НастройкиВыбораОтветственныхСотрудниковЦБ.ЗагрузитьЭлементы(Истина);
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

#КонецОбласти
