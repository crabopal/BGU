#Область ПрограммныйИнтерфейс

// Возвращает результат запроса к данным расчета
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ОтчетныйПериод - Дата
//  НалоговыйОрган - СправочникСсылка.РегистрацииВНалоговомОргане
//
// Возвращаемое значение:
//   ТаблицаЗначений
//
Функция ДанныеРасчетаДляДекларации(Организация, ОтчетныйПериод, НалоговыйОрган) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОтчетныйПериод", ОтчетныйПериод);
	Запрос.УстановитьПараметр("НалоговыйОрган", НалоговыйОрган);

	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.Организация КАК Организация,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.НалоговыйОрган КАК НалоговыйОрган,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.КодПоОКТМО КАК КодПоОКТМО,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОсновноеСредство КАК ОсновноеСредство,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.КодВидаИмущества КАК КодВидаИмущества,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ДоляСтоимостиЧислитель КАК ДоляСтоимостиЧислитель,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ДоляСтоимостиЗнаменатель КАК ДоляСтоимостиЗнаменатель,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.НалоговаяСтавка КАК НалоговаяСтавка,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ПорядокНалогообложения КАК ПорядокНалогообложения,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.КодНалоговойЛьготыОсвобождениеОтНалогообложения КАК КодНалоговойЛьготыОсвобождениеОтНалогообложения,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.КодОснованияЛьготы КАК КодОснованияЛьготы,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.СуммаУменьшенияСуммыНалога КАК СуммаУменьшенияСуммыНалога,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа0101 КАК ОстаточнаяСтоимостьНа0101,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа0102 КАК ОстаточнаяСтоимостьНа0102,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа0103 КАК ОстаточнаяСтоимостьНа0103,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа0104 КАК ОстаточнаяСтоимостьНа0104,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа0105 КАК ОстаточнаяСтоимостьНа0105,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа0106 КАК ОстаточнаяСтоимостьНа0106,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа0107 КАК ОстаточнаяСтоимостьНа0107,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа0108 КАК ОстаточнаяСтоимостьНа0108,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа0109 КАК ОстаточнаяСтоимостьНа0109,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа0110 КАК ОстаточнаяСтоимостьНа0110,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа0111 КАК ОстаточнаяСтоимостьНа0111,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа0112 КАК ОстаточнаяСтоимостьНа0112,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОстаточнаяСтоимостьНа3112 КАК ОстаточнаяСтоимостьНа3112,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.СуммаАвансовыхПлатежей1Кв КАК СуммаАвансовыхПлатежей1Кв,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.СуммаАвансовыхПлатежей2Кв КАК СуммаАвансовыхПлатежей2Кв,
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.СуммаАвансовыхПлатежей3Кв КАК СуммаАвансовыхПлатежей3Кв
		|ПОМЕСТИТЬ ВТОстаточнаяСтоимость
		|ИЗ
		|	РегистрСведений.РасчетНалогаНаИмуществоПоСреднегодовойСтоимости КАК РасчетНалогаНаИмуществоПоСреднегодовойСтоимости
		|ГДЕ
		|	РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.Организация = &Организация
		|	И РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.ОтчетныйПериод = &ОтчетныйПериод
		|	И РасчетНалогаНаИмуществоПоСреднегодовойСтоимости.НалоговыйОрган = &НалоговыйОрган
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СобытияОССрезПоследних.Организация КАК Организация,
		|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
		|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
		|	СобытияОССрезПоследних.ДатаСобытия КАК ДатаСобытия
		|ПОМЕСТИТЬ ВТДатыСписания
		|ИЗ
		|	РегистрСведений.СобытияОС.СрезПоследних(
		|			&ОтчетныйПериод,
		|			(Организация, ОсновноеСредство, ИнвНомер, Событие) В
		|				(ВЫБРАТЬ
		|					ВТОстаточнаяСтоимость.Организация,
		|					ВТОстаточнаяСтоимость.ОсновноеСредство,
		|					ВТОстаточнаяСтоимость.ИнвентарныйНомер,
		|					ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
		|				ИЗ
		|					ВТОстаточнаяСтоимость КАК ВТОстаточнаяСтоимость)) КАК СобытияОССрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СобытияОССрезПоследних.Организация КАК Организация,
		|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
		|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
		|	СобытияОССрезПоследних.ДатаСобытия КАК ДатаСобытия
		|ПОМЕСТИТЬ ВТДатыПринятияКУчету
		|ИЗ
		|	РегистрСведений.СобытияОС.СрезПоследних(
		|			&ОтчетныйПериод,
		|			(Организация, ОсновноеСредство, ИнвНомер, Событие) В
		|				(ВЫБРАТЬ
		|					ВТОстаточнаяСтоимость.Организация,
		|					ВТОстаточнаяСтоимость.ОсновноеСредство,
		|					ВТОстаточнаяСтоимость.ИнвентарныйНомер,
		|					ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
		|				ИЗ
		|					ВТОстаточнаяСтоимость КАК ВТОстаточнаяСтоимость)) КАК СобытияОССрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТОстаточнаяСтоимость.Организация КАК Организация,
		|	ВТОстаточнаяСтоимость.НалоговыйОрган КАК НалоговыйОрган,
		|	ВТОстаточнаяСтоимость.КодПоОКТМО КАК КодПоОКАТО,
		|	ВТОстаточнаяСтоимость.ОсновноеСредство КАК ОсновноеСредство,
		|	ВТОстаточнаяСтоимость.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ВТОстаточнаяСтоимость.КодВидаИмущества КАК КодВидаИмущества,
		|	ВЫБОР
		|		КОГДА ВТОстаточнаяСтоимость.КодВидаИмущества = ""01""
		|			ТОГДА ""18210602020021000110""
		|		ИНАЧЕ ""18210602010021000110""
		|	КОНЕЦ КАК КБК,
		|	ВТОстаточнаяСтоимость.ДоляСтоимостиЧислитель КАК ДоляСтоимостиЧислитель,
		|	ВТОстаточнаяСтоимость.ДоляСтоимостиЗнаменатель КАК ДоляСтоимостиЗнаменатель,
		|	ВТОстаточнаяСтоимость.НалоговаяСтавка КАК НалоговаяСтавка,
		|	ВТОстаточнаяСтоимость.ПорядокНалогообложения КАК ПорядокНалогообложения,
		|	ВТОстаточнаяСтоимость.КодНалоговойЛьготыОсвобождениеОтНалогообложения КАК КодНалоговойЛьготыОсвобождениеОтНалогообложения,
		|	ВТОстаточнаяСтоимость.КодОснованияЛьготы КАК КодОснованияЛьготы,
		|	ВТОстаточнаяСтоимость.СуммаУменьшенияСуммыНалога КАК СуммаУменьшенияСуммыНалога,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа0101 КАК ОстаточнаяСтоимостьНа0101,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа0102 КАК ОстаточнаяСтоимостьНа0102,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа0103 КАК ОстаточнаяСтоимостьНа0103,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа0104 КАК ОстаточнаяСтоимостьНа0104,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа0105 КАК ОстаточнаяСтоимостьНа0105,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа0106 КАК ОстаточнаяСтоимостьНа0106,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа0107 КАК ОстаточнаяСтоимостьНа0107,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа0108 КАК ОстаточнаяСтоимостьНа0108,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа0109 КАК ОстаточнаяСтоимостьНа0109,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа0110 КАК ОстаточнаяСтоимостьНа0110,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа0111 КАК ОстаточнаяСтоимостьНа0111,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа0112 КАК ОстаточнаяСтоимостьНа0112,
		|	ВТОстаточнаяСтоимость.ОстаточнаяСтоимостьНа3112 КАК ОстаточнаяСтоимостьНа3112,
		|	ВТОстаточнаяСтоимость.СуммаАвансовыхПлатежей1Кв КАК СуммаАвансовыхПлатежей1Кв,
		|	ВТОстаточнаяСтоимость.СуммаАвансовыхПлатежей2Кв КАК СуммаАвансовыхПлатежей2Кв,
		|	ВТОстаточнаяСтоимость.СуммаАвансовыхПлатежей3Кв КАК СуммаАвансовыхПлатежей3Кв,
		|	ЕСТЬNULL(ВТДатыСписания.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаСписания,
		|	ЕСТЬNULL(ВТДатыПринятияКУчету.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПринятияКУчету
		|ИЗ
		|	ВТОстаточнаяСтоимость КАК ВТОстаточнаяСтоимость
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДатыСписания КАК ВТДатыСписания
		|		ПО ВТОстаточнаяСтоимость.Организация = ВТДатыСписания.Организация
		|			И ВТОстаточнаяСтоимость.ОсновноеСредство = ВТДатыСписания.ОсновноеСредство
		|			И ВТОстаточнаяСтоимость.ИнвентарныйНомер = ВТДатыСписания.ИнвентарныйНомер
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДатыПринятияКУчету КАК ВТДатыПринятияКУчету
		|		ПО ВТОстаточнаяСтоимость.Организация = ВТДатыПринятияКУчету.Организация
		|			И ВТОстаточнаяСтоимость.ОсновноеСредство = ВТДатыПринятияКУчету.ОсновноеСредство
		|			И ВТОстаточнаяСтоимость.ИнвентарныйНомер = ВТДатыПринятияКУчету.ИнвентарныйНомер";
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#Область ДляВызоваИзДругихПодсистем

