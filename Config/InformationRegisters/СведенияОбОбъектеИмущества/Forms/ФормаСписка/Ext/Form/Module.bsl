
///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Свойство("ОбъектУчета") Тогда
		
		Элементы.ОтборОбъектУчета.Видимость	= Ложь;
		Элементы.ОбъектУчета.Видимость		= Ложь;
		
		ОтборОбъектУчета = Параметры.Отбор.ОбъектУчета;
		
	КонецЕсли;
	
	Если Параметры.Отбор.Свойство("Регистратор") Тогда
		
		Элементы.ОтборОбъектУчета.Видимость	= Ложь;
		Элементы.ОтборРегистратор.Видимость		= Ложь;
		
		Элементы.Период.Видимость				= Ложь;
		Элементы.Организация.Видимость			= Ложь;
		Элементы.ОбъектУчета.Видимость			= Ложь;
		
    КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура ОтборОбъектУчетаПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ОбъектУчета", ОтборОбъектУчета, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОбъектУчета));
	Элементы.ОбъектУчета.Видимость = Не ЗначениеЗаполнено(ОтборОбъектУчета);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборРегистраторПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Регистратор", ОтборРегистратор, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборРегистратор));
    Элементы.ОтборОбъектУчета.ТолькоПросмотр = ЗначениеЗаполнено(ОтборРегистратор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборРегистраторНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Не ОтборОбъектУчета.Пустая() Тогда
		
		СтандартнаяОбработка = Ложь;
		ПараметрыОткрытия = Новый Структура("Отбор", Новый Структура);
		ПараметрыОткрытия.Отбор.Вставить("ОбъектУчета", ОтборОбъектУчета);
		ОткрытьФорму("Документ.РегистрацияСведенийОбИмуществе.ФормаВыбора", ПараметрыОткрытия, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры
