

&НаСервере
Функция НайтиВариантНастроек(Знач СхемаКомпоновки, Знач ИмяВарианта)

	Перем НайденныйВариант;
	
	Для Каждого Вариант Из СхемаКомпоновки.ВариантыНастроек Цикл
		Если Вариант.Имя = ИмяВарианта Тогда
			НайденныйВариант = Вариант.Настройки;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат НайденныйВариант;
	
КонецФункции // НайтиВариантНастроек()


&НаСервере
Процедура ВывестиОтчетПоВарианту(Знач ИмяВарианта)

	ТекущийВариант = ИмяВарианта;
	
	СхемаКомпоновки     = РегистрыСведений.УстановленныеКомплектыОтчетности.ПолучитьМакет("ОтчетПоВерсиям");
	НастройкиКомпоновки = НайтиВариантНастроек(СхемаКомпоновки, ИмяВарианта);
	
	Если НастройкиКомпоновки = Неопределено Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'Не найден вариант отчета с именем «%1»'"),
								ИмяВарианта);
	КонецЕсли;
	
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, НастройкиКомпоновки, ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,ДанныеРасшифровки);
	
	ПроцессорВывода   = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ТабличныйДокумент = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	АдресДанныхРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, УникальныйИдентификатор);
	АдресСхемыКомпоновки   = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);

КонецПроцедуры // ВывестиОтчетПоВарианту()


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ПустаяСтрока(Параметры.Вариант) Тогда
		ВывестиОтчетПоВарианту("ВерсииКомплектов");
	Иначе
		ВывестиОтчетПоВарианту(Параметры.Вариант);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеПоляРасшифровки(Знач ИдентификаторРасшифровки, Знач АдресДанныхРасшифровки, ИмяПоляРасшифровки = Неопределено)

	ДанныеРасшифровки  = ПолучитьИзВременногоХранилища(АдресДанныхРасшифровки);
	ЭлементРасшифровки = ДанныеРасшифровки.Элементы[ИдентификаторРасшифровки];
	
	ПоляРасшифровки = ЭлементРасшифровки.ПолучитьПоля();
	Если ПоляРасшифровки.Количество() Тогда
		ИмяПоляРасшифровки = Строка(ПоляРасшифровки[0].Поле);
		Возврат ПоляРасшифровки[0].Значение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // ПолучитьЗначениеПоляРасшифровки()

&НаКлиенте
Процедура ТабличныйДокументОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяПоля = "";
	ИдентификаторКомплекта = ПолучитьЗначениеПоляРасшифровки(Расшифровка, АдресДанныхРасшифровки, ИмяПоля);
	
	Если ИдентификаторКомплекта <> Неопределено и ИмяПоля = "ИдентификаторКомплекта" Тогда
		ПараметрыФормы = Новый Структура("КлючДанных",Новый Структура);
		ПараметрыФормы.КлючДанных.Вставить("ИдентификаторКомплекта",ИдентификаторКомплекта);
		ОткрытьФорму("РегистрСведений.УстановленныеКомплектыОтчетности.Форма.ИнформацияОКомплекте",ПараметрыФормы, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры
