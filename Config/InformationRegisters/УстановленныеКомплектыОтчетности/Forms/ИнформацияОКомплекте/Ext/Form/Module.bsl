
&НаСервере
Процедура УстановитьHTML(Знач ТекстHTML)

	ОтображаемыйДокумент = ТекстHTML;

КонецПроцедуры // УстановитьHTML()


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.АдресДанных) Тогда
		УстановитьHTML(ПолучитьИзВременногоХранилища(Параметры.АдресДанных));
	ИначеЕсли ТипЗнч(Параметры.КлючДанных) = Тип("РегистрСведенийКлючЗаписи.УстановленныеКомплектыОтчетности")
		      или ТипЗнч(Параметры.КлючДанных) = Тип("Структура") Тогда
		
		Запрос       = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановленныеКомплектыОтчетности.ОписаниеИзмененийHTML
		|ИЗ
		|	РегистрСведений.УстановленныеКомплектыОтчетности КАК УстановленныеКомплектыОтчетности
		|ГДЕ
		|	УстановленныеКомплектыОтчетности.ИдентификаторКомплекта = &ИдентификаторКомплекта";
		
		Запрос.УстановитьПараметр("ИдентификаторКомплекта", Параметры.КлючДанных.ИдентификаторКомплекта);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			УстановитьHTML(Выборка.ОписаниеИзмененийHTML.Получить());
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
