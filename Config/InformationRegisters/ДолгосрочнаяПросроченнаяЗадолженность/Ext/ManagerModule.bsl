#КонецОбласти

//Если ДатаПолученияОстатков (дата получения остатков для инвентаризации) >=01.07.2025,
//то в регистр ДолгосрочнаяПросроченнаяЗадолженность данные пишутся только документом
//РегистрацияДолгосрочнойИПросроченнойЗадолженности
Функция РазрешеноФормированиеДвиженийСтороннимиДокументами(ДатаПолученияОстатков) Экспорт
	
	РазрешеноФормированиеДвижений = Истина;
	Если ДатаПолученияОстатков>='20250701' Тогда
		РазрешеноФормированиеДвижений = Ложь;
	КонецЕсли;
	
	Возврат РазрешеноФормированиеДвижений;
	
КонецФункции

Функция ПолучитьДанныеДействующегоДокумента(Организация,ДатаИнвентаризации) Экспорт
	
	ДанныеДокумента = Новый Структура("ДействующийДокумент,Период");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДолгосрочнаяПросроченнаяЗадолженность.Регистратор КАК Регистратор,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Период КАК Период
		|ИЗ
		|	РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность КАК ДолгосрочнаяПросроченнаяЗадолженность
		|ГДЕ
		|	ДолгосрочнаяПросроченнаяЗадолженность.ДатаИнвентаризации = &ДатаИнвентаризации
		|	И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("ДатаИнвентаризации",ДатаИнвентаризации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДанныеДокумента.ДействующийДокумент = Выборка.Регистратор;
		ДанныеДокумента.Период = Выборка.Период;
	КонецЕсли;
	
	Возврат ДанныеДокумента;
	
КонецФункции

Функция ПолучитьДанныеПредыдущегоДокумента(Организация,ДатаИнвентаризации,ДействующийДокумент) Экспорт
	
	ДанныеДокумента = Новый Структура("ПредыдущийДокумент,Период");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДолгосрочнаяПросроченнаяЗадолженность.Регистратор КАК Регистратор,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Период КАК Период
		|ИЗ
		|	РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность КАК ДолгосрочнаяПросроченнаяЗадолженность
		|ГДЕ
		|	ДолгосрочнаяПросроченнаяЗадолженность.ДатаИнвентаризации = &ДатаИнвентаризации
		|	И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация
		|	И ДолгосрочнаяПросроченнаяЗадолженность.Регистратор <> &ДействующийДокумент 
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("ДатаИнвентаризации",ДатаИнвентаризации);
	Запрос.УстановитьПараметр("ДействующийДокумент",ДействующийДокумент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДанныеДокумента.ПредыдущийДокумент = Выборка.Регистратор;
		ДанныеДокумента.Период = Выборка.Период;
	КонецЕсли;
	
	Возврат ДанныеДокумента;
	
КонецФункции

Функция ПолучитьДанныеСледующегоДокумента(Организация,ДатаИнвентаризации,ДокументСсылка) Экспорт
	
	ДанныеДокумента = Новый Структура("СледующийДокумент,Период");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДолгосрочнаяПросроченнаяЗадолженность.Регистратор КАК Регистратор,
		|	ДолгосрочнаяПросроченнаяЗадолженность.Период КАК Период
		|ПОМЕСТИТЬ ВсеДокументы
		|ИЗ
		|	РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность КАК ДолгосрочнаяПросроченнаяЗадолженность
		|ГДЕ
		|	ДолгосрочнаяПросроченнаяЗадолженность.ДатаИнвентаризации = &ДатаИнвентаризации
		|	И ДолгосрочнаяПросроченнаяЗадолженность.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВсеДокументы.Регистратор КАК Регистратор,
		|	ВсеДокументы.Период КАК Период
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВсеДокументы.Период КАК Период
		|	ИЗ
		|		ВсеДокументы КАК ВсеДокументы
		|	ГДЕ
		|		ВсеДокументы.Регистратор = &ДокументСсылка) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВсеДокументы КАК ВсеДокументы
		|		ПО ВложенныйЗапрос.Период < ВсеДокументы.Период
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("ДатаИнвентаризации",ДатаИнвентаризации);
	Запрос.УстановитьПараметр("ДокументСсылка",ДокументСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДанныеДокумента.СледующийДокумент = Выборка.Регистратор;
		ДанныеДокумента.Период = Выборка.Период;
	КонецЕсли;
	
	Возврат ДанныеДокумента;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра = "РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало2026",Дата(2026,1,1));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДолгосрочнаяПросроченнаяЗадолженность.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ТаблицаРегистраторов
	|ИЗ
	|	РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность КАК ДолгосрочнаяПросроченнаяЗадолженность
	|ГДЕ
	|	ДолгосрочнаяПросроченнаяЗадолженность.Период = &Начало2026
	|	И ДолгосрочнаяПросроченнаяЗадолженность.ДатаИнвентаризации = &Начало2026
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРегистраторов.Регистратор КАК Регистратор
	|ИЗ
	|	ТаблицаРегистраторов КАК ТаблицаРегистраторов
	|ГДЕ
	|	ТаблицаРегистраторов.Регистратор.Дата <> &Начало2026";
	
	Регистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	
	ОбновлениеИнформационнойБазы.ОтметитьРегистраторыКОбработке(Параметры, Регистраторы, ПолноеИмяРегистра);
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра = "РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность";
		
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьРегистраторыРегистраДляОбработки(
		Параметры.Очередь, Неопределено, ПолноеИмяРегистра);
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоДвижения = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = ПолноеИмяРегистра;
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ПредставлениеРегистратора = Строка(Выборка.Регистратор);
			ЗаполнитьПериодВДвижениях(Выборка.Регистратор);
		
		Исключение
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не удалось обработать движения документа: %1 по причине:
					|%2'"), 
					ПредставлениеРегистратора, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.РегистрыСведений.ЖурналУчетаКомпенсацииРодительскойПлаты, , ТекстСообщения);
		КонецПопытки;
				
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяРегистра);
	
КонецПроцедуры

Процедура ЗаполнитьПериодВДвижениях(Документ)

	НачатьТранзакцию();
	Попытка
	
		// Блокируем объект от изменения другими сеансами.
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность.НаборЗаписей");
		ЭлементБлокировки.УстановитьЗначение("Регистратор", Документ);
		Блокировка.Заблокировать();
		
		ДокументОбъект = Документ.ПолучитьОбъект();
		
		Если ДокументОбъект <> Неопределено Тогда
			
			ДокументОбъект.Заблокировать();
			
			НаборЗаписей = РегистрыСведений.ДолгосрочнаяПросроченнаяЗадолженность.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(Документ);
			НаборЗаписей.Прочитать();
			Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
				ЗаписьНабора.Период = ДокументОбъект.Дата;
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			
		Иначе
			// Документ удален или движения документа не соответствуют ожидаемым
			ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
			ДополнительныеПараметры.ПолноеИмяРегистра = "РегистрСведений.ДолгосрочнаяПросроченнаяЗадолженность";
			ДополнительныеПараметры.ЭтоДвижения = Истина;
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Документ, ДополнительныеПараметры);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
