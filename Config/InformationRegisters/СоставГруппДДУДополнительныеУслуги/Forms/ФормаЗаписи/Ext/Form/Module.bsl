
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура")  тогда
		
		Если Параметры.ЗначенияЗаполнения.Свойство("Ребенок") тогда
			Элементы.Ребенок.ТолькоПросмотр 					= ЗначениеЗаполнено(Параметры.ЗначенияЗаполнения.Ребенок);
		КонецЕсли;	
		
		Если Параметры.ЗначенияЗаполнения.Свойство("ГруппаДетскогоУчреждения") тогда
			Элементы.ГруппаДетскогоУчреждения.ТолькоПросмотр 	= ЗначениеЗаполнено(Параметры.ЗначенияЗаполнения.ГруппаДетскогоУчреждения);
		КонецЕсли;	
		
	КонецЕсли;
	
	Элементы.Ребенок.ТолькоПросмотр = Элементы.Ребенок.ТолькоПросмотр ИЛИ ЗначениеЗаполнено(Параметры.Ключ.Ребенок);
	Элементы.ГруппаДетскогоУчреждения.ТолькоПросмотр = Элементы.ГруппаДетскогоУчреждения.ТолькоПросмотр ИЛИ ЗначениеЗаполнено(Параметры.Ключ.ГруппаДетскогоУчреждения);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	Если ТипЗнч(НовыйОбъект) = Тип("СправочникСсылка.Договоры") Тогда
		
		// Записан новый договор
		СоставГруппДДУДополнительныеУслуги.Договор = НовыйОбъект;
		Модифицированность = Истина;
		
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Модифицированность Тогда
		Отказ = Истина;
		
		НоваяДата = СоставГруппДДУДополнительныеУслуги.Период;
		
		Оповещение = Новый ОписаниеОповещения("ОбработкаВводаДаты", ЭтотОбъект);
		ПоказатьВводДаты(Оповещение, НоваяДата, НСтр("ru='Изменения вступают в силу с:'"), ЧастиДаты.Дата);
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Перем НоваяДата;
	
	Если ПараметрыЗаписи.Свойство("НоваяДата", НоваяДата) Тогда	
		
		НоваяЗапись = РегистрыСведений.СоставГруппДДУДополнительныеУслуги.СоздатьМенеджерЗаписи();	
		НоваяЗапись.Период = НоваяДата;
		НоваяЗапись.Ребенок = СоставГруппДДУДополнительныеУслуги.Ребенок;
		НоваяЗапись.ГруппаДетскогоУчреждения = СоставГруппДДУДополнительныеУслуги.ГруппаДетскогоУчреждения;
		НоваяЗапись.Прочитать();

		ЗаполнитьЗначенияСвойств(НоваяЗапись, СоставГруппДДУДополнительныеУслуги);
		НоваяЗапись.Период = НоваяДата;
		
		НоваяЗапись.Записать();
						
		ЗначениеВРеквизитФормы(НоваяЗапись, "СоставГруппДДУДополнительныеУслуги");
		
		Отказ = Истина;
		
		Модифицированность = Ложь;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ИмяСобытия = "ИзменениеСоставаГруппДДУДополнительныеУслуги";
	Параметр = СоставГруппДДУДополнительныеУслуги["Ребенок"];
	Оповестить(ИмяСобытия, Параметр);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РебенокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор",Новый Структура("Организация",ОрганизацияГруппыДетскогоУчреждения(СоставГруппДДУДополнительныеУслуги.ГруппаДетскогоУчреждения)));
	ОткрытьФорму("Справочник.Дети.ФормаВыбора",ПараметрыФормы,Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ГруппаДетскогоУчрежденияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор",Новый Структура("Владелец",ОрганизацияРебенка(СоставГруппДДУДополнительныеУслуги.Ребенок)));
	ОткрытьФорму("Справочник.ГруппыДетскогоУчреждения.ФормаВыбора",ПараметрыФормы,Элемент);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьДоговор(Команда)
	
	Отказ = Ложь;
	
	Если СоставГруппДДУДополнительныеУслуги.Ребенок.Пустая() Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено поле ""%1"".'"), "Ребенок"); 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,	"СоставГруппДДУДополнительныеУслуги.Ребенок", , Отказ);
		
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
	ЗначенияЗаполнения = РеквизитыРебенка(СоставГруппДДУДополнительныеУслуги.Ребенок);
	
	Если НЕ ЗначениеЗаполнено(ЗначенияЗаполнения.Организация) Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнен реквизит ребенка ""%1"".'"), "Организация"); 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,	"СоставГруппДДУДополнительныеУслуги.Ребенок", , Отказ);
		
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ЗначенияЗаполнения.Контрагент) Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнен реквизит ребенка ""%1"".'"), "Контрагент"); 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,	"СоставГруппДДУДополнительныеУслуги.Ребенок", , Отказ);
		
	КонецЕсли;	
	
	Если НЕ СоставГруппДДУДополнительныеУслуги.Договор.Пустая() Тогда
		
		Кнопки = Новый СписокЗначений();
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Заменить договор'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
		
		ТекстВопроса = НСтр("ru =  'Заменить текущий договор на вновь созданный?'");
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
		Оповещение = Новый ОписаниеОповещения("ЗапросОЗаменеДоговора", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Отмена);
		
		Возврат;
	КонецЕсли; 
	
	Если НЕ Отказ Тогда
		
		ОткрытьФормуСозданиеДоговора(ЗначенияЗаполнения);

	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ЗапросОЗаменеДоговора(ОтветНаВопрос, ДопПараметры) Экспорт
	Если ОтветНаВопрос <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли; 	
	
	ЗначенияЗаполнения = Неопределено;
	ДопПараметры.Свойство("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФормуСозданиеДоговора(ЗначенияЗаполнения);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВводаДаты(Результат, ДопПараметры) Экспорт
	Если Результат <> Неопределено И ТипЗнч(Результат) = Тип("Дата") Тогда
		НоваяДата = Результат;
		
		Если ДопПараметры = Неопределено Тогда
			ДопПараметры = Новый Структура;
		КонецЕсли;
		
		Если ПроверитьСуществованиеЗаписиНаВыбраннуюДату(НоваяДата, СоставГруппДДУДополнительныеУслуги.Ребенок, СоставГруппДДУДополнительныеУслуги.ГруппаДетскогоУчреждения) Тогда
			СтрВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'На %1 уже есть запись. Заменить?'"),НоваяДата);
			
			ДопПараметры.Вставить("НоваяДата", НоваяДата);
			
			Оповещение = Новый ОписаниеОповещения("ОбработатьОтветОПерезаписи", ЭтотОбъект, ДопПараметры);
			ПоказатьВопрос(Оповещение, СтрВопроса, РежимДиалогаВопрос.ДаНет, 10, КодВозвратаДиалога.Нет, , КодВозвратаДиалога.Нет);  
		Иначе
			Модифицированность = Ложь;
			
			ДопПараметры.Вставить("НоваяДата", НоваяДата);
			
			Записать(ДопПараметры);
			
			ИмяСобытия = "ИзменениеСоставаГруппДДУДополнительныеУслуги";
			Параметр = СоставГруппДДУДополнительныеУслуги["Ребенок"];
			Оповестить(ИмяСобытия, Параметр);
        КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОтветОПерезаписи(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Модифицированность = Ложь;
		Записать(ДопПараметры);
		
		ИмяСобытия = "ИзменениеСоставаГруппДДУДополнительныеУслуги";
		Параметр = СоставГруппДДУДополнительныеУслуги["Ребенок"];
		Оповестить(ИмяСобытия, Параметр);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьФормуСозданиеДоговора(ЗначенияЗаполнения)
	ЗначенияЗаполнения.Вставить("ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"));
	ДополнительныеЗначенияЗаполнения = Новый Структура("ВидОбязательства, Наименование, КонтрольЗаполненияРабочегоНаименования");
	ДополнительныеЗначенияЗаполнения.ВидОбязательства = "Договор на дополнительные услуги ДДУ";
	ДополнительныеЗначенияЗаполнения.Наименование = "Доп. услуги ДДУ " + ЗначенияЗаполнения.Наименование;
	ДополнительныеЗначенияЗаполнения.КонтрольЗаполненияРабочегоНаименования = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",						ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("ДополнительныеЗначенияЗаполнения",			ДополнительныеЗначенияЗаполнения);
	ПараметрыФормы.Вставить("ЗаполнятьДополнительныеЗначенияЗаполнения",Истина);
	ПараметрыФормы.Вставить("ИменаНедоступныхРеквизитов",				"Организация,Контрагент,ВидДоговора");
	
	ОткрытьФорму("Справочник.Договоры.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыРебенка(РебенокСсылка)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РебенокСсылка, "Организация, Контрагент, Наименование");
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПроверитьСуществованиеЗаписиНаВыбраннуюДату(ПроверяемаяДата, РебенокСсылка, ГруппаСсылка)
	
	НоваяЗапись = РегистрыСведений.СоставГруппДДУДополнительныеУслуги.СоздатьМенеджерЗаписи();	
	НоваяЗапись.Период = ПроверяемаяДата;
	НоваяЗапись.Ребенок = РебенокСсылка;
	НоваяЗапись.ГруппаДетскогоУчреждения = ГруппаСсылка;
	НоваяЗапись.Прочитать();
	
	Возврат НоваяЗапись.Выбран();
	
КонецФункции

&НаСервереБезКонтекста
Функция ОрганизацияГруппыДетскогоУчреждения(ГруппаДетскогоУчреждения)
	Возврат ГруппаДетскогоУчреждения.Владелец;
КонецФункции	

&НаСервереБезКонтекста
Функция ОрганизацияРебенка(Ребенок)
	Возврат Ребенок.Организация;
КонецФункции

#КонецОбласти