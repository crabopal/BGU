#Область ПрограммныйИнтерфейс

// Вносит запись в регистр сведений по переданным параметрам.
//
// Параметры:
//  ДополнительныеПараметры - Структура - содержит свойства:
//  	* Период   				   - 	Дата
//  	* Организация	 		   - 	СправочникСсылка.Организации
//  	* ИдентификаторЗадания     - 	УникальныйИдентификатор
//  	* ВидСведений	 		   - 	ПеречислениеСсылка.ВидыСведенийЕСМВСМЭВ
//  	* Статус	 		 	   - 	ПеречислениеСсылка.СтатусыЗаданийМСД 
//  	* ТекстОшибки	 		   - 	Строка 
//  	* ДополнительнаяИнформация -    Строка
//
Процедура ОтразитьДанныеЗадания(ДополнительныеПараметры) Экспорт

	Попытка
		ЗаписьНабора = РегистрыСведений.ЗаданияОбменаКлиентМСД.СоздатьМенеджерЗаписи();		
		ЗаполнитьЗначенияСвойств(ЗаписьНабора, ДополнительныеПараметры);
		ЗаписьНабора.Записать();		
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'ОтражениеДанныхЗаданияКлиентМСД'", ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;	
	КонецПопытки;	
		
КонецПроцедуры

