#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция НайтиДокументРасписки(ДокументОписи) Экспорт
	
	ЗначениеПоУмолчанию = Неопределено;
	
	Если Не ЗначениеЗаполнено(ДокументОписи) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументОписи", ДокументОписи);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	ДокументРасписки
	|ИЗ
	|	РегистрСведений.СоответствияДокументовИнвентаризационныхОписейИРасписок
	|ГДЕ
	|	ДокументОписи = &ДокументОписи";
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ДокументРасписки;
	КонецЦикла;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом
// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(ДокументОписи)";

КонецПроцедуры
