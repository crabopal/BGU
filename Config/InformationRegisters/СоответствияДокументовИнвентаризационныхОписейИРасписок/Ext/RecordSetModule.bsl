#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДополнительныеСвойства.Свойство("ЗаписьИзДокументаРасписки") Тогда
		Отказ = Истина;
		
		ТекстСообщения = НСтр("ru='Интерактивное редактирование записей регистра сведений ""Соответствие документов инвентаризационных описей и расписок"" не предусмотрено'");
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Запись");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
