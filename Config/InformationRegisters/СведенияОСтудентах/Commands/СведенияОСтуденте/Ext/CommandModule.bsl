
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ИмяПоля = "";
	Если ТипЗнч(ПараметрКоманды) = Тип("СправочникСсылка.Студенты") Тогда
		ИмяПоля = "Студент";
		
	ИначеЕсли ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.ВводНачальныхОстатков") Тогда
		ИмяПоля = "Регистратор";
		
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура(ИмяПоля, ПараметрКоманды);
	
	ПараметрыФормы = Новый Структура("Отбор", СтруктураОтбора);
	
	ОткрытьФорму("РегистрСведений.СведенияОСтудентах.ФормаСписка", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно);
	
КонецПроцедуры
