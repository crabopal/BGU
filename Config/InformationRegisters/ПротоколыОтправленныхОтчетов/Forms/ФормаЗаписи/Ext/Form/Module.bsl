
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	
	Если ОбновитьДанные Тогда
		ЭтаФорма.Прочитать();
	КонецЕсли;
	ТолькоПросмотр = Истина;
	Элементы.ГруппаРеквизитов.ТекущаяСтраница = Элементы.ГруппаПротокол;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	HTMLПротокол = ТекущийОбъект.Протокол.Получить();
	Протокол = HTMLПротокол.ПолучитьТекст();
	
	Если ТекущийОбъект.Прочитано = Ложь Тогда
		ОбновитьДанные = Истина;
		ТекущийОбъект.Прочитано = Истина;
		ТекущийОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ОбновитьДанные Тогда
		ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.ПротоколыОтправленныхОтчетов"));
	КонецЕсли;
КонецПроцедуры


