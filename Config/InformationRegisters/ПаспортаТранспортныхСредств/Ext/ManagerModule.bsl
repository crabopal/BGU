#КонецОбласти

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Регистрация данных к обработке не производится. Все данные выбираются в обработчике
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПаспортаТранспортныхСредств.Период КАК Период
	|ИЗ
	|	РегистрСведений.ПаспортаТранспортныхСредств КАК ПаспортаТранспортныхСредств
	|ГДЕ
	|	(ПаспортаТранспортныхСредств.Марка ССЫЛКА Справочник.ЗначенияСвойствОбъектов
	|			ИЛИ ПаспортаТранспортныхСредств.Модель ССЫЛКА Справочник.ЗначенияСвойствОбъектов
	|			ИЛИ ПаспортаТранспортныхСредств.Тип ССЫЛКА Справочник.ЗначенияСвойствОбъектов)";
	
	Если Запрос.Выполнить().Пустой() Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Ссылка КАК Ссылка,
	|	ЗначенияСвойствОбъектов.Наименование КАК Наименование,
	|	ЗначенияСвойствОбъектов.ПолноеНаименование КАК ПолноеНаименование
	|ИЗ
	|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Ссылка В
	|			(ВЫБРАТЬ
	|				ПаспортаТранспортныхСредств.Марка КАК Марка
	|			ИЗ
	|				РегистрСведений.ПаспортаТранспортныхСредств КАК ПаспортаТранспортныхСредств
	|			ГДЕ
	|				ПаспортаТранспортныхСредств.Марка ССЫЛКА Справочник.ЗначенияСвойствОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Ссылка КАК Ссылка,
	|	ЗначенияСвойствОбъектов.Наименование КАК Наименование,
	|	ЗначенияСвойствОбъектов.ПолноеНаименование КАК ПолноеНаименование
	|ИЗ
	|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Ссылка В
	|			(ВЫБРАТЬ
	|				ПаспортаТранспортныхСредств.Модель КАК Модель
	|			ИЗ
	|				РегистрСведений.ПаспортаТранспортныхСредств КАК ПаспортаТранспортныхСредств
	|			ГДЕ
	|				ПаспортаТранспортныхСредств.Модель ССЫЛКА Справочник.ЗначенияСвойствОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Ссылка КАК Ссылка,
	|	ЗначенияСвойствОбъектов.Наименование КАК Наименование,
	|	ЗначенияСвойствОбъектов.ПолноеНаименование КАК ПолноеНаименование
	|ИЗ
	|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Ссылка В
	|			(ВЫБРАТЬ
	|				ПаспортаТранспортныхСредств.Тип КАК Тип
	|			ИЗ
	|				РегистрСведений.ПаспортаТранспортныхСредств КАК ПаспортаТранспортныхСредств
	|			ГДЕ
	|				ПаспортаТранспортныхСредств.Тип ССЫЛКА Справочник.ЗначенияСвойствОбъектов)";
	
	Результат		= Запрос.ВыполнитьПакет();
	ВыборкаМарка	= Результат[0].Выбрать();
	ВыборкаМодель	= Результат[1].Выбрать();
	ВыборкаТип		= Результат[2].Выбрать();
	
	ДанныеМарка = Новый Соответствие;
	Пока ВыборкаМарка.Следующий() Цикл
		ДанныеМарка.Вставить(ВыборкаМарка.Ссылка, ?(ЗначениеЗаполнено(ВыборкаМарка.ПолноеНаименование), ВыборкаМарка.ПолноеНаименование, ВыборкаМарка.Наименование));
	КонецЦикла;
	
	ДанныеМодель = Новый Соответствие;
	Пока ВыборкаМодель.Следующий() Цикл
		ДанныеМодель.Вставить(ВыборкаМодель.Ссылка, ?(ЗначениеЗаполнено(ВыборкаМодель.ПолноеНаименование), ВыборкаМодель.ПолноеНаименование, ВыборкаМодель.Наименование));
	КонецЦикла;
	
	ДанныеТип = Новый Соответствие;
	Пока ВыборкаТип.Следующий() Цикл
		ДанныеТип.Вставить(ВыборкаТип.Ссылка, ?(ЗначениеЗаполнено(ВыборкаТип.ПолноеНаименование), ВыборкаТип.ПолноеНаименование, ВыборкаТип.Наименование));
	КонецЦикла;
	
	НаборЗаписей = РегистрыСведений.ПаспортаТранспортныхСредств.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	
	ТипСвойство = Тип("СправочникСсылка.ЗначенияСвойствОбъектов");
	
	Для Каждого Запись Из НаборЗаписей Цикл
		
		Если ЗначениеЗаполнено(Запись.Марка) Тогда
			Если ТипЗнч(Запись.Марка) = ТипСвойство Тогда
				Запись.Марка = ДанныеМарка[Запись.Марка];
			КонецЕсли;
		Иначе
			Запись.Марка = "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Запись.Модель) Тогда
			Если ТипЗнч(Запись.Модель) = ТипСвойство Тогда
				Запись.Модель = ДанныеМодель[Запись.Модель];
			КонецЕсли;
		Иначе
			Запись.Модель = "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Запись.Тип) Тогда
			Если ТипЗнч(Запись.Тип) = ТипСвойство Тогда
				Запись.Тип = ДанныеТип[Запись.Тип];
			КонецЕсли;
		Иначе
			Запись.Тип = "";
		КонецЕсли;
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
	Параметры.ОбработкаЗавершена = Истина;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
