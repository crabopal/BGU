#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНастройкаСписка

&НаКлиенте
Процедура НастройкаСпискаНеВключатьПриИзменении(Элемент)
	ЗаписатьИзменения(Элементы.НастройкаСписка.ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
// Код процедур и функций
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуНастройкаСписка()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыНалоговИПлатежей.Ссылка КАК ВидНалогаИлиПлатежа,
		|	ВидыНалоговИПлатежей.СчетУчета КАК СчетУчета,
		|	ВидыНалоговИПлатежей.КодГлавыБК + ВидыНалоговИПлатежей.Классификатор КАК КБК,
		|	ЕСТЬNULL(НастройкаСпискаПлатежиВСоставеЕНП.НеВключать, ЛОЖЬ) КАК НеВключать,
		|	ВидыНалоговИПлатежей.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ВидыНалоговИПлатежей КАК ВидыНалоговИПлатежей
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаСпискаПлатежиВСоставеЕНП КАК НастройкаСпискаПлатежиВСоставеЕНП
		|		ПО ВидыНалоговИПлатежей.Ссылка = НастройкаСпискаПлатежиВСоставеЕНП.ВидНалогаИлиПлатежа
		|			И (НастройкаСпискаПлатежиВСоставеЕНП.Организация = &Организация)
		|ГДЕ
		|	ВидыНалоговИПлатежей.Ссылка В(&ВидыНалогаСписка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НастройкаСпискаПлатежиВСоставеЕНП.ВидНалогаИлиПлатежа,
		|	ЕСТЬNULL(ВидыНалоговИПлатежей.СчетУчета, """"),
		|	ЕСТЬNULL(ВидыНалоговИПлатежей.КодГлавыБК, """") + ЕСТЬNULL(ВидыНалоговИПлатежей.Классификатор, """"),
		|	НастройкаСпискаПлатежиВСоставеЕНП.НеВключать,
		|	ВидыНалоговИПлатежей.Наименование
		|ИЗ
		|	РегистрСведений.НастройкаСпискаПлатежиВСоставеЕНП КАК НастройкаСпискаПлатежиВСоставеЕНП
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНалоговИПлатежей КАК ВидыНалоговИПлатежей
		|		ПО НастройкаСпискаПлатежиВСоставеЕНП.ВидНалогаИлиПлатежа = ВидыНалоговИПлатежей.Ссылка
		|ГДЕ
		|	НастройкаСпискаПлатежиВСоставеЕНП.Организация = &Организация
		|	И НастройкаСпискаПлатежиВСоставеЕНП.НеВключать
		|	И НЕ НастройкаСпискаПлатежиВСоставеЕНП.ВидНалогаИлиПлатежа В (&ВидыНалогаСписка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетУчета,
		|	Наименование";
	
	ВидыНалогаСписка = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	Запрос.УстановитьПараметр("ВидыНалогаСписка", ВидыНалогаСписка);
	Запрос.УстановитьПараметр("Организация",      Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаСписка = НастройкаСписка.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписка, ВыборкаДетальныеЗаписи);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИзменения(ТекущиеДанные)
	
	СтруктураЗаписи = Новый Структура;
	
	СтруктураЗаписи.Вставить("Организация", 		Организация); 
	СтруктураЗаписи.Вставить("ВидНалогаИлиПлатежа",	ТекущиеДанные.ВидНалогаИлиПлатежа);
	
 	СтруктураЗаписи.Вставить("НеВключать",			ТекущиеДанные.НеВключать); 

	Попытка
		ЗаписатьИзмененияНаСервере(СтруктураЗаписи);
	Исключение
        ТекущиеДанные.НеВключать = Не ТекущиеДанные.НеВключать;
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьИзмененияНаСервере(Знач СтруктураЗаписи)
	
	МенеджерЗаписи = РегистрыСведений.НастройкаСпискаПлатежиВСоставеЕНП.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураЗаписи);
	Если СтруктураЗаписи.НеВключать Тогда
		МенеджерЗаписи.Записать();
	Иначе
		МенеджерЗаписи.Удалить();
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НастройкаСпискаВидНалогаИлиПлатежа");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НастройкаСпискаСчетУчета");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "НастройкаСпискаКБК");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор, "НастройкаСписка.НеВключать",
		Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	
КонецПроцедуры

#КонецОбласти