
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СписокПередУдалением(Элемент, Отказ)
	ТекущаяЗапись = Элементы.Список.ТекущиеДанные;
	ОрганизацияЗаписиНаУдаление = ТекущаяЗапись.Организация;
	ОсновноеСредствоЗаписиНаУдаление = ТекущаяЗапись.ОсновноеСредство;
КонецПроцедуры

&НаКлиенте
Процедура СписокПослеУдаления(Элемент)
	ОчиститьНастройки(ОрганизацияЗаписиНаУдаление, ОсновноеСредствоЗаписиНаУдаление);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьСервисныеФункцииУчетаГСМ(Команда)
	
	ОткрытьФорму("РегистрСведений.НастройкиДокументовУчетаГСМ.Форма.ФормаСервисныеФункции");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОчиститьНастройки(Организация, ОсновноеСредство)
	Набор = РегистрыСведений.АдресаТС.СоздатьНаборЗаписей(); 
	Набор.Отбор.Организация.Установить(Организация); 
	Набор.Отбор.ТранспортноеСредство.Установить(ОсновноеСредство); 
	Набор.Записать();
	
	Набор = РегистрыСведений.ГорючееТС.СоздатьНаборЗаписей(); 
	Набор.Отбор.Организация.Установить(Организация); 
	Набор.Отбор.ТранспортноеСредство.Установить(ОсновноеСредство); 
	Набор.Записать();
	
	Набор = РегистрыСведений.ПрицепыТС.СоздатьНаборЗаписей(); 
	Набор.Отбор.Организация.Установить(Организация); 
	Набор.Отбор.ТранспортноеСредство.Установить(ОсновноеСредство); 
	Набор.Записать();
КонецПроцедуры	

#КонецОбласти
