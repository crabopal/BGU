
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация = ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	ДатаСведений = ТекущаяДатаСеанса();
	ДатаНачалаОтбора = НачалоГода(ДатаСведений);
	ДатаОкончанияОтбора = КонецГода(ДатаСведений);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьПериод(Команда)
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("ДатаНачалаОтбора",	ДатаНачалаОтбора);
	СтруктураПараметров.Вставить("ДатаОкончанияОтбора",	ДатаОкончанияОтбора);
	
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(СтруктураПараметров, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументы(Команда)
	ЗаполнитьДокументыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДокументы(Команда)
	ОбработатьДокументыНаСервере();
	
	Сообщить(НСтр("ru='Операция завершена.'"));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьПериод_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		ДатаНачалаОтбора = РезультатВыбора["НачалоПериода"];
		ДатаОкончанияОтбора = РезультатВыбора["КонецПериода"];
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументыНаСервере()
	Если ВидОперации = 0 Тогда
		ЗаполнитьДокументыДляОперацииЗаполненияГаражныхНомеровНаСервере();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОбработатьДокументыНаСервере()
	Если ВидОперации = 0 Тогда
		ОбработатьДокументыДляОперацииЗаполненияГаражныхНомеровНаСервере();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументыДляОперацииЗаполненияГаражныхНомеровНаСервере()
	ДокументыУчетаГСМ.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЖурналПутевыхЛистов.Ссылка КАК ДокументСсылка,
	|	ЖурналПутевыхЛистов.ГаражныйНомер КАК ДокументГаражныйНомер,
	|	ЖурналПутевыхЛистов.ТранспортноеСредство КАК ТранспортноеСредство,
	|	ПаспортаТранспортныхСредствСрезПоследних.ГаражныйНомер КАК ПаспортГаражныйНомер,
	|	ПаспортаТранспортныхСредствСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ИСТИНА КАК ДокументВыбран
	|ИЗ
	|	ЖурналДокументов.ЖурналПутевыхЛистов КАК ЖурналПутевыхЛистов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПаспортаТранспортныхСредств.СрезПоследних(&ДатаСведений, Организация = &Организация) КАК ПаспортаТранспортныхСредствСрезПоследних
	|		ПО ЖурналПутевыхЛистов.ТранспортноеСредство = ПаспортаТранспортныхСредствСрезПоследних.ОсновноеСредство
	|ГДЕ
	|	ЖурналПутевыхЛистов.ГаражныйНомер <> ПаспортаТранспортныхСредствСрезПоследних.ГаражныйНомер
	|	И НЕ ПаспортаТранспортныхСредствСрезПоследних.ГаражныйНомер = &ПустойГаражныйНомер
	|	И ЖурналПутевыхЛистов.Организация = &Организация
	|	И ЖурналПутевыхЛистов.Дата МЕЖДУ &ДатаНачалоПериода И &ДатаКонецПериода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаксировкаПутевогоЛиста.Ссылка,
	|	ТаксировкаПутевогоЛиста.ГаражныйНомер,
	|	ТаксировкаПутевогоЛиста.ТранспортноеСредство,
	|	ПаспортаТранспортныхСредствСрезПоследних.ГаражныйНомер,
	|	ПаспортаТранспортныхСредствСрезПоследних.ОсновноеСредство,
	|	ИСТИНА
	|ИЗ
	|	Документ.ТаксировкаПутевогоЛиста КАК ТаксировкаПутевогоЛиста
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПаспортаТранспортныхСредств.СрезПоследних(&ДатаСведений, Организация = &Организация) КАК ПаспортаТранспортныхСредствСрезПоследних
	|		ПО ТаксировкаПутевогоЛиста.ТранспортноеСредство = ПаспортаТранспортныхСредствСрезПоследних.ОсновноеСредство
	|ГДЕ
	|	ТаксировкаПутевогоЛиста.ГаражныйНомер <> ПаспортаТранспортныхСредствСрезПоследних.ГаражныйНомер
	|	И НЕ ПаспортаТранспортныхСредствСрезПоследних.ГаражныйНомер = &ПустойГаражныйНомер
	|	И ТаксировкаПутевогоЛиста.Организация = &Организация
	|	И ТаксировкаПутевогоЛиста.Дата МЕЖДУ &ДатаНачалоПериода И &ДатаКонецПериода";	
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачалоПериода", ДатаНачалаОтбора);
	Запрос.УстановитьПараметр("ДатаКонецПериода", ДатаОкончанияОтбора);
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Запрос.УстановитьПараметр("ПустойГаражныйНомер", "");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ДокументыУчетаГСМ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка); 	
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ОбработатьДокументыДляОперацииЗаполненияГаражныхНомеровНаСервере()
	Для Каждого ТекСтрока Из ДокументыУчетаГСМ Цикл
		Если ТекСтрока.ДокументВыбран И ЗначениеЗаполнено(ТекСтрока.ДокументСсылка) И ЗначениеЗаполнено(ТекСтрока.ПаспортГаражныйНомер) Тогда
			Регистратор = ТекСтрока.ДокументСсылка;
			Попытка
				
				НачатьТранзакцию();
				
				// Заполниим новый реквизит ДатаИнвентаризации значением по-умолчанию.
				ДокументОбъект = Регистратор.ПолучитьОбъект();
				ДокументОбъект.ГаражныйНомер = ТекСтрока.ПаспортГаражныйНомер;
				
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				
				ОтменитьТранзакцию();
				ВызватьИсключение;
				
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти


