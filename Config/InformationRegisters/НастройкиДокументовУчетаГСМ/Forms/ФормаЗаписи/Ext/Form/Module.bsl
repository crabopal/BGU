#Область ОбработчикиСобытийЭлементовТаблицыФормыПрицепы

&НаКлиенте
Процедура ПрицепыТСПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока ИЛИ Копирование Тогда
		СтрокаТаблицы = Элементы.ПрицепыТС.ТекущиеДанные;	
		СтрокаТаблицы.НомерПрицепа = НовыйНомерПрицепа();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВодители

&НаКлиенте
Процедура ВодителиТСПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока ИЛИ Копирование Тогда
		СтрокаТаблицы = Элементы.ВодителиТС.ТекущиеДанные;	
		СтрокаТаблицы.Приоритет = НовыйНомерВодителя();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СкопироватьАдресаОС(Команда)
	ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ФормаВыбора",,Элементы.АдресаТС);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьЗаголовокОС()
	Если Запись.ВидОбъектаРасходаГСМ = Перечисления.ВидыОбъектовРасходаГСМ.ТранспортныеСредства Тогда
		Элементы.ОсновноеСредство.Заголовок = "Транспортное средство";
		Элементы.ГруппаВодители.Заголовок = "Водители";
	Иначе
		Элементы.ОсновноеСредство.Заголовок = "Агрегат/машина";
		Элементы.ГруппаВодители.Заголовок = "Машинисты";
	КонецЕсли;
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьНаименованиеФормы(ИдентификаторФормы)
	Если ИдентификаторФормы = "ПЛ3" Тогда
		Результат = "Путевой лист легкового автомобиля (форма № 3)";
	ИначеЕсли ИдентификаторФормы = "ПЛ3С" Тогда
		Результат = "Путевой лист специального автомобиля (форма № 3 спец)";
	ИначеЕсли ИдентификаторФормы = "ПЛ4П" Тогда
		Результат = "Путевой лист грузового автомобиля (форма № 4-П)";
	ИначеЕсли ИдентификаторФормы = "ПЛ4С" Тогда
		Результат = "Путевой лист грузового автомобиля (форма № 4-С)";
	ИначеЕсли ИдентификаторФормы = "ПЛ6" Тогда
		Результат = "Путевой лист автобуса (форма № 6)";
	ИначеЕсли ИдентификаторФормы = "ПЛ6С" Тогда
		Результат = "Путевой лист автобуса необщего пользования (форма № 6 спец)";
	ИначеЕсли ИдентификаторФормы = "ПЛЭ2" Тогда
		Результат = "Путевой лист строительной машины (форма № ЭСМ-2)";
	ИначеЕсли ИдентификаторФормы = "ПЛТ" Тогда
		Результат = "Путевой лист трактора (форма № 412-АПК)";
	ИначеЕсли ИдентификаторФормы = "РЛА" Тогда
		Результат = "Рабочий лист агрегата";
	ИначеЕсли ИдентификаторФормы = "УЛТМ" Тогда
		Результат = "Учетный лист тракториста-машиниста (форма № 411-АПК)";
	Конецесли;	
	
	Возврат Результат;
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПолноеИмяФормы(НаименованиеФормы)
	Если НаименованиеФормы = ПолучитьНаименованиеФормы("ПЛ3") Тогда
		Результат = "Документ.ПутевойЛист3";
	ИначеЕсли НаименованиеФормы = ПолучитьНаименованиеФормы("ПЛ3С") Тогда
		Результат = "Документ.ПутевойЛист3спец";
	ИначеЕсли НаименованиеФормы = ПолучитьНаименованиеФормы("ПЛ4П") Тогда
		Результат = "Документ.ПутевойЛист4П";
	ИначеЕсли НаименованиеФормы = ПолучитьНаименованиеФормы("ПЛ4С") Тогда
		Результат = "Документ.ПутевойЛист4С";
	ИначеЕсли НаименованиеФормы = ПолучитьНаименованиеФормы("ПЛ6") Тогда
		Результат = "Документ.ПутевойЛист6";
	ИначеЕсли НаименованиеФормы = ПолучитьНаименованиеФормы("ПЛ6С") Тогда
		Результат = "Документ.ПутевойЛист6спец";
	ИначеЕсли НаименованиеФормы = ПолучитьНаименованиеФормы("ПЛЭ2") Тогда
		Результат = "Документ.ПутевойЛистЭСМ2";
	ИначеЕсли НаименованиеФормы = ПолучитьНаименованиеФормы("ПЛТ") Тогда
		Результат = "Документ.ПутевойЛист412АПК";
	ИначеЕсли НаименованиеФормы = ПолучитьНаименованиеФормы("РЛА") Тогда
		Результат = "Документ.РабочийЛистАгрегата";
	ИначеЕсли НаименованиеФормы = ПолучитьНаименованиеФормы("УЛТМ") Тогда
		Результат = "Документ.УчетныйЛистТрактористаМашиниста";
	Конецесли;	
	
	Возврат Результат;
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьМассивНаименованийПечатныхФорм(ВидОбъектаРасхода)
	МассивФормТС = Новый Массив;
	МассивФормТС.Добавить(ПолучитьНаименованиеФормы("ПЛ3"));
	МассивФормТС.Добавить(ПолучитьНаименованиеФормы("ПЛ3С"));
	МассивФормТС.Добавить(ПолучитьНаименованиеФормы("ПЛ4П"));
	МассивФормТС.Добавить(ПолучитьНаименованиеФормы("ПЛ4С"));
	МассивФормТС.Добавить(ПолучитьНаименованиеФормы("ПЛ6"));
	МассивФормТС.Добавить(ПолучитьНаименованиеФормы("ПЛ6С"));
	МассивФормТС.Добавить(ПолучитьНаименованиеФормы("ПЛЭ2"));
	МассивФормТС.Добавить(ПолучитьНаименованиеФормы("ПЛТ"));
	
	МассивФормАгрегатов = Новый Массив;
	МассивФормАгрегатов.Добавить(ПолучитьНаименованиеФормы("РЛА"));
	МассивФормАгрегатов.Добавить(ПолучитьНаименованиеФормы("УЛТМ"));
	
	Если ВидОбъектаРасхода = ПредопределенноеЗначение("Перечисление.ВидыОбъектовРасходаГСМ.Агрегаты") Тогда
		Возврат МассивФормАгрегатов;
	КонецЕсли;
	
	Возврат МассивФормТС;
КонецФункции	

