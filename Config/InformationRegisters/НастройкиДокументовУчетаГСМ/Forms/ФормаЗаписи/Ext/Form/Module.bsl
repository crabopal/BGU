&НаКлиенте
Перем ЭтоНоваяСтрока;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	МассивИменПечатныхФорм = ПолучитьМассивНаименованийПечатныхФорм(Запись.ВидОбъектаРасходаГСМ);
	
	Если Параметры.Ключ.Пустой() Тогда
		Запись.Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();

		Запись.ВидОбъектаРасходаГСМ = Перечисления.ВидыОбъектовРасходаГСМ.ТранспортныеСредства;
		НаименованиеВидаДокументаУчетаГСМ = МассивИменПечатныхФорм[0];
	Иначе
		НаименованиеВидаДокументаУчетаГСМ = Запись.ВидДокументаУчетаГСМ.Синоним;
	КонецЕсли;
	
	Элементы.НаименованиеВидаДокументаУчетаГСМ.СписокВыбора.ЗагрузитьЗначения(МассивИменПечатныхФорм);
	УстановитьЗаголовокОС();
	
	СоздатьКнопкуДляАдреса(ЭтаФорма,"АдресПодачи",Элементы.ГруппаАдресПодачи);
	СоздатьКнопкуДляВидаПеревозки(ЭтаФорма,"ВидПеревозки",Элементы.ГруппаВидПеревозки);
	
	ИнициализироватьПрицепыДляРедактированияНаФорме(ЭтаФорма, Запись.Организация, Запись.ОсновноеСредство);
	ИнициализироватьАдресаДляРедактированияНаФорме(ЭтаФорма, Запись.Организация, Запись.ОсновноеСредство);
	ИнициализироватьГорючееДляРедактированияНаФорме(ЭтаФорма, Запись.Организация, Запись.ОсновноеСредство);
	ИнициализироватьВодителейДляРедактированияНаФорме(ЭтаФорма, Запись.Организация, Запись.ОсновноеСредство);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВизуализацияНастроекДокументов(ЭтаФорма);
	ПоказатьЕдиницуРаботы(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ИнициализироватьПрицепыДляРедактированияНаФорме(ЭтаФорма, Запись.Организация, Запись.ОсновноеСредство);
	ИнициализироватьАдресаДляРедактированияНаФорме(ЭтаФорма, Запись.Организация, Запись.ОсновноеСредство);
	ИнициализироватьГорючееДляРедактированияНаФорме(ЭтаФорма, Запись.Организация, Запись.ОсновноеСредство);
	ИнициализироватьВодителейДляРедактированияНаФорме(ЭтаФорма, Запись.Организация, Запись.ОсновноеСредство);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	//Прицепы
	Набор = РегистрыСведений.ПрицепыТС.СоздатьНаборЗаписей(); 
	Набор.Отбор.Организация.Установить(Запись.Организация); 
	Набор.Отбор.ТранспортноеСредство.Установить(Запись.ОсновноеСредство); 
	Для Каждого СтрокаТаблицы Из ЭтаФорма["ПрицепыТС"] Цикл 
		Если ЗначениеЗаполнено(Запись.ОсновноеСредство) Тогда
		 	НоваяЗапись = Набор.Добавить(); 
		 	НоваяЗапись.Организация = Запись.Организация; 
		 	НоваяЗапись.ТранспортноеСредство = Запись.ОсновноеСредство; 
		 	НоваяЗапись.НомерПрицепа = СтрокаТаблицы.НомерПрицепа;
		 	НоваяЗапись.Прицеп = СтрокаТаблицы.Прицеп;
		КонецЕсли;	
	КонецЦикла; 
	Набор.Записать();
	
	//Адреса
	Набор = РегистрыСведений.АдресаТС.СоздатьНаборЗаписей(); 
	Набор.Отбор.Организация.Установить(Запись.Организация); 
	Набор.Отбор.ТранспортноеСредство.Установить(Запись.ОсновноеСредство); 
	Для Каждого СтрокаТаблицы Из ЭтаФорма["АдресаТС"] Цикл 
		Если СокрЛП(СтрокаТаблицы.Адрес) <> "" Тогда
		 	НоваяЗапись = Набор.Добавить(); 
		 	НоваяЗапись.Организация = Запись.Организация; 
		 	НоваяЗапись.ТранспортноеСредство = Запись.ОсновноеСредство; 
		 	НоваяЗапись.Приоритет = СтрокаТаблицы.Приоритет;
		 	НоваяЗапись.Адрес = СтрокаТаблицы.Адрес;
		КонецЕсли;	
	КонецЦикла; 
	Набор.Записать();
	
	//Горючее
	Набор = РегистрыСведений.ГорючееТС.СоздатьНаборЗаписей(); 
	Набор.Отбор.Организация.Установить(Запись.Организация); 
	Набор.Отбор.ТранспортноеСредство.Установить(Запись.ОсновноеСредство); 
	Для Каждого СтрокаТаблицы Из ЭтаФорма["ГорючееТС"] Цикл 
		Если ЗначениеЗаполнено(СтрокаТаблицы.МаркаГорючего) Тогда
		 	НоваяЗапись = Набор.Добавить(); 
		 	НоваяЗапись.Организация = Запись.Организация; 
		 	НоваяЗапись.ТранспортноеСредство = Запись.ОсновноеСредство; 
		 	НоваяЗапись.Приоритет = СтрокаТаблицы.Приоритет;
		 	НоваяЗапись.МаркаГорючего = СтрокаТаблицы.МаркаГорючего;
		КонецЕсли;	
	КонецЦикла; 
	Набор.Записать();
	
	//Водители
	Набор = РегистрыСведений.ВодителиТС.СоздатьНаборЗаписей(); 
	Набор.Отбор.Организация.Установить(Запись.Организация); 
	Набор.Отбор.ТранспортноеСредство.Установить(Запись.ОсновноеСредство); 
	Для Каждого СтрокаТаблицы Из ЭтаФорма["ВодителиТС"] Цикл 
		Если ЗначениеЗаполнено(СтрокаТаблицы.Водитель) Тогда
		 	НоваяЗапись = Набор.Добавить(); 
		 	НоваяЗапись.Организация = Запись.Организация; 
		 	НоваяЗапись.ТранспортноеСредство = Запись.ОсновноеСредство; 
		 	НоваяЗапись.Приоритет = СтрокаТаблицы.Приоритет;
		 	НоваяЗапись.Водитель = СтрокаТаблицы.Водитель;
		КонецЕсли;	
	КонецЦикла; 
	Набор.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Запись.ВидДокументаУчетаГСМ = ОбщегоНазначенияБГУВызовСервераПовтИсп.СсылкаИдентификатораОбъектаМетаданных(ПолучитьПолноеИмяФормы(НаименованиеВидаДокументаУчетаГСМ));
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидОбъектаРасходаГСМПриИзменении(Элемент)
	МассивИменПечатныхФорм = ПолучитьМассивНаименованийПечатныхФорм(Запись.ВидОбъектаРасходаГСМ);
	Элементы.НаименованиеВидаДокументаУчетаГСМ.СписокВыбора.ЗагрузитьЗначения(МассивИменПечатныхФорм);
	
	НаименованиеВидаДокументаУчетаГСМ = МассивИменПечатныхФорм[0];
	
	УстановитьЗаголовокОС();
	ВизуализацияНастроекДокументов(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеВидаДокументаУчетаГСМПриИзменении(Элемент)
	ВизуализацияНастроекДокументов(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ВРаспоряжениеНаименованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Владелец",Запись.Организация);	
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ОткрытьФорму("Справочник.Сотрудники.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ВРаспоряжениеНаименованиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
		СписокСотрудников = ВыбранноеЗначение;
		СтрокаВРаспоряжениеНаименование = Элементы.ВРаспоряжениеНаименование.ТекстРедактирования;
		Для н = 1 По ВыбранноеЗначение.Количество() Цикл
			СтрокаВРаспоряжениеНаименование = СтрокаВРаспоряжениеНаименование + ?(СокрЛП(СтрокаВРаспоряжениеНаименование) = "","",", ")+ КорреспондентыКлиентСервер.ФИО(Строка(ВыбранноеЗначение[н-1]), Ложь);
		КонецЦикла;	
		ВыбранноеЗначение = СтрокаВРаспоряжениеНаименование;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВРаспоряжениеОрганизацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ВРаспоряжениеОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
		СтрокаКонтрагентов = Элементы.ВРаспоряжениеОрганизация.ТекстРедактирования;
		Для н = 1 По ВыбранноеЗначение.Количество() Цикл
			СтруктураДанных = ПолучитьНаименованиеКонтрагента(ВыбранноеЗначение[н-1], ТекущаяДата());
			СтрокаКонтрагентов = СтрокаКонтрагентов + ?(СокрЛП(СтрокаКонтрагентов) = "","",", ")+ ?(ЗначениеЗаполнено(СтруктураДанных.НаименованиеСокращенное),СтруктураДанных.НаименованиеСокращенное,СтруктураДанных.НаименованиеПолное);
		КонецЦикла;	
		ВыбранноеЗначение = СтрокаКонтрагентов;
	КонецЕсли;
КонецПроцедуры

