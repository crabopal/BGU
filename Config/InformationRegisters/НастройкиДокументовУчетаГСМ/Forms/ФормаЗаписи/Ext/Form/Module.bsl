&НаСервере
Процедура СоздатьКнопкуДляАдреса(Форма, ИмяРеквизита, ГруппаРеквизита)
	
	ИмяКоманды = "Заполнить" + ИмяРеквизита;  
	Команда = Форма.Команды.Добавить(ИмяКоманды);
	Команда.Отображение = ОтображениеКнопки.Картинка;
	Команда.Действие = "ОбработкаНажатияКнопкиЗаполненияАдреса";
	
	Элемент = Форма.Элементы.Добавить(ИмяКоманды,Тип("КнопкаФормы"), ГруппаРеквизита);
	Элемент.ИмяКоманды = ИмяКоманды;
	
	Элемент.Заголовок = НСтр("ru = 'Заполнить'");
	Команда.Подсказка = НСтр("ru = 'Заполнить адрес из другого поля'");
	Команда.Картинка = БиблиотекаКартинок.ПереместитьВлево;
	Команда.ИзменяетСохраняемыеДанные = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНажатияКнопкиЗаполненияАдреса(КомандаФормы)
	Элемент = ЭтаФорма.Элементы.Найти(КомандаФормы.Имя);
	СписокАдресов = СписокЧастоПосещаемыхАдресовТС(Запись.Организация, Запись.ОсновноеСредство);
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораАдреса", ЭтотОбъект, Новый Структура);
	Оповещение.ДополнительныеПараметры.Вставить("Элемент", Элемент);
	ЭтаФорма.ПоказатьВыборИзМеню(Оповещение, СписокАдресов, Элемент);
КонецПроцедуры	

&НаКлиенте
Процедура ВыполнитьПослеВыбораАдреса(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = Сред(ДополнительныеПараметры.Элемент.Имя,10);
	ВырезатьС = Найти(ВыбранныйЭлемент, ": ");
	ВырезатьС = ?(ВырезатьС>0, ВырезатьС+1, 0);
	ЗначениеЗаполнения = Сред(ВыбранныйЭлемент, ВырезатьС+1);
	
	Запись[ИмяРеквизита] = ЗначениеЗаполнения; 
	
КонецПроцедуры	

