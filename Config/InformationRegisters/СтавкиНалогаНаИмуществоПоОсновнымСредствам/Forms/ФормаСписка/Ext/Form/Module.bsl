
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Перем ОтборРегистратор;
	
	Документы.РегистрацияСтавкиНалогаНаИмущество.УстановитьУсловноеОформление(Элементы, УсловноеОформление);
	УстановитьУсловноеОформление();
	
	Если Не Параметры.Отбор.Свойство("Регистратор", ОтборРегистратор) Тогда
		Параметры.Свойство("Регистратор", ОтборРегистратор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборРегистратор) Тогда
		Элементы.Регистратор.Видимость 			= Ложь;
		Элементы.ГруппаБыстрыеОтборы.Видимость	= Ложь;
		Элементы.Организация.Видимость 			= Ложь;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
			Список.Отбор, "Регистратор", ОтборРегистратор,
			ВидСравненияКомпоновкиДанных.Равно,, Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
	Иначе
		
		Параметры.Отбор.Свойство("ОсновноеСредство", ОтборОсновноеСредство);
		Если Не ЗначениеЗаполнено(ОтборОсновноеСредство) Тогда
			Параметры.Свойство("ОсновноеСредство", ОтборОсновноеСредство);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОтборОсновноеСредство) Тогда
			Элементы.ОтборОрганизация.Видимость = Ложь;
			Элементы.ОтборОсновноеСредство.ТолькоПросмотр = Истина;
			Элементы.ОтборОсновноеСредство.КнопкаОткрытия = Ложь;
			Элементы.ОсновноеСредство.Видимость = Ложь;
			Элементы.Организация.Видимость = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Список.Отбор, "Организация", ОтборОрганизация,,,
		ЗначениеЗаполнено(ОтборОрганизация),
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОсновноеСредствоПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Список.Отбор, "ОсновноеСредство", ОтборОсновноеСредство,,,
		ЗначениеЗаполнено(ОтборОсновноеСредство),
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "КодЛьготы");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Список.ПорядокНалогообложения",
		Перечисления.ПорядокНалогообложенияИмущества.ОблагаетсяПоСниженнойСтавке,
		ВидСравненияКомпоновкиДанных.Равно);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "2012400");
 
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "КодЛьготы");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Список.ПорядокНалогообложения",
		Перечисления.ПорядокНалогообложенияИмущества.СнижениеСуммыНаПроцент,
		ВидСравненияКомпоновкиДанных.Равно);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "2012500");
 
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "КодЛьготы");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Список.ПорядокНалогообложения",
		Перечисления.ПорядокНалогообложенияИмущества.СнижениеСуммыНаСумму,
		ВидСравненияКомпоновкиДанных.Равно);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "2012500");

КонецПроцедуры

#КонецОбласти
