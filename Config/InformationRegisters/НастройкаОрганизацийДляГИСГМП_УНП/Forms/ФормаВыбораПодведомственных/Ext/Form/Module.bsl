
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗакрыватьПриВыборе = Ложь;
	Если Параметры.Подбор Тогда
		Элементы.СписокПодведомственных.РежимВыделения = РежимВыделенияТаблицы.Множественный;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	ВыбратьПодведомственных();	
КонецПроцедуры

&НаКлиенте
Процедура СписокПодведомственныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ВыбратьПодведомственных();	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПодведомственных()
	МассивВыбранных = Новый Массив;
	Для Каждого ВыдСтр Из Элементы.СписокПодведомственных.ВыделенныеСтроки Цикл
		
		ДанныеСтроки = Элементы.СписокПодведомственных.ДанныеСтроки(ВыдСтр);
		МассивВыбранных.Добавить(Новый Структура("Подведомственный,УРН",ДанныеСтроки.Подведомственный,ДанныеСтроки.УРН));
	КонецЦикла;
	ОповеститьОВыборе(МассивВыбранных);
	Закрыть();	
КонецПроцедуры

&НаКлиенте
Процедура СписокПодведомственныхВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ВыбратьПодведомственных();
КонецПроцедуры
