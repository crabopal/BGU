#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)    
	Если Параметры.Ключ.Пустой() Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Модифицированность Тогда
		Отказ = Истина;
		ВопросПередЗакрытиемАсинх();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	ПериодТекущейЗаписи = Запись.Период;
	ПодготовитьФормуНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	ПериодТекущейЗаписи = Запись.Период;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	Если КадастроваяСтоимостьОпределенаПоПлощади И Запись.ДоляПлощадиЧислитель = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не указан числитель дроби - Доля площади'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ДоляПлощадиЧислитель", "Запись", Отказ);
	КонецЕсли;
	Если КадастроваяСтоимостьОпределенаПоПлощади И Запись.ДоляПлощадиЗнаменатель = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не указан знаменатель дроби - Доля площади'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ДоляПлощадиЗнаменатель", "Запись", Отказ);
	КонецЕсли;
	Если Запись.ДоляПлощадиЧислитель <> 0
	   И Запись.ДоляПлощадиЗнаменатель <> 0
	   И Запись.ДоляПлощадиЧислитель > Запись.ДоляПлощадиЗнаменатель Тогда
		ТекстСообщения = НСтр("ru = 'Доля площади: числитель дроби больше знаменателя'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ДоляПлощадиЧислитель", "Запись", Отказ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	УправлениеИзменениемКадастровойСтоимости();
КонецПроцедуры

&НаКлиенте
Процедура ПереписатьТекущуюЗаписьПриИзменении(Элемент)
	УправлениеИзменениемКадастровойСтоимости();
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОрганизацияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоПриИзменении(Элемент)
	ОсновноеСредствоПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныйНомерПриИзменении(Элемент)
	УправлениеИзменениемКадастровойСтоимости();
КонецПроцедуры

&НаКлиенте
Процедура КадастроваяСтоимостьПриИзменении(Элемент)
	УправлениеИзменениемКадастровойСтоимости();
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьДатуНачалаПриИзменении(Элемент)
	
	Если Не ИзменитьДатуНачала Тогда
		
		Запись.ДатаПримененияНовойСтоимостиКРасчетуНалога = Дата(1,1,1);
		ДатаПримененияНовойСтоимости = ДатаПримененияНовойСтоимости(ДатаИзмененияКадастровойСтоимости,
			КадастроваяСтоимостьИзменилась);
		
	КонецЕсли;

	УправлениеРеквизитомДатаПримененияНовойСтоимости(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтоПомещениеПриИзменении(Элемент)
	
	Элементы.КадастровыйНомерЗдания.Доступность = Запись.ЭтоПомещение;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОбъектаНедвижимостиПриИзменении(Элемент)
	
	Если Запись.ВидОбъектаНедвижимости <> 
		ПредопределенноеЗначение("Перечисление.ВидыОбъектовНедвижимости.Помещение") Тогда
	
		КадастроваяСтоимостьОпределенаПоПлощади = Ложь;
		Запись.ДоляПлощадиЧислитель = 0;
		Запись.ДоляПлощадиЗнаменатель = 0;
	
	КонецЕсли;
	
	ВидимостьДоляПлощади(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура КадастроваяСтоимостьОпределенаПоПлощадиПриИзменении(Элемент)

	Если Не КадастроваяСтоимостьОпределенаПоПлощади Тогда
		Запись.ДоляПлощадиЧислитель = 0;
		Запись.ДоляПлощадиЗнаменатель = 0;
	КонецЕсли;

	ВидимостьДоляПлощади(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаЗаписатьИЗакрыть(Команда)
	Если ЗаписатьНаСервере() Тогда
		Закрыть();
		Оповестить("СведенияКадастровогоУчетаЗаписаны");
		ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.СведенияКадастровогоУчета"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаписать(Команда)
	Если ЗаписатьНаСервере() Тогда
		Оповестить("СведенияКадастровогоУчетаЗаписаны");
		ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.СведенияКадастровогоУчета"));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	ПроверитьРегистрациюЗемельногоУчастка();
	УправлениеИзменениемКадастровойСтоимости();
КонецПроцедуры

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере()
	ПроверитьРегистрациюЗемельногоУчастка();
	УправлениеИзменениемКадастровойСтоимости();
	ВидимостьИнвентарногоНомера();
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()

	КадастроваяСтоимостьОпределенаПоПлощади = Запись.ДоляПлощадиЧислитель > 0 ИЛИ Запись.ДоляПлощадиЗнаменатель > 0;
	
	ПроверитьРегистрациюЗемельногоУчастка();
	УправлениеИзменениемКадастровойСтоимости();
	ВидимостьИнвентарногоНомера();
	ВидимостьДоляПлощади(ЭтотОбъект);
	Элементы.КадастровыйНомерЗдания.Доступность = Запись.ЭтоПомещение;

КонецПроцедуры

&НаСервере
Процедура ПроверитьРегистрациюЗемельногоУчастка()

	ЭтоРегистрацияЗемельногоУчастка = РегистрыСведений.РегистрацияЗемельныхУчастков.ЕстьРегистрацияЗемельногоУчастка(
		Запись.Организация, Запись.ОсновноеСредство)
		Или Запись.ВидОбъектаНедвижимости = Перечисления.ВидыОбъектовНедвижимости.ЗемельныйУчасток;
		
КонецПроцедуры

&НаСервере
Процедура УправлениеИзменениемКадастровойСтоимости()
	
	ПроверитьКадастроваяСтоимостьИзменилась();
	ЗаполнитьПодсказкуКадастроваяСтоимость();
	
	Если ЭтоРегистрацияЗемельногоУчастка Тогда
		
		Если Запись.ДатаПримененияНовойСтоимостиКРасчетуНалога = Дата(1,1,1) Тогда
			ДатаПримененияНовойСтоимости = ДатаПримененияНовойСтоимости(ДатаИзмененияКадастровойСтоимости,
				КадастроваяСтоимостьИзменилась);
			ИзменитьДатуНачала = Ложь;
		Иначе
			ДатаПримененияНовойСтоимости = Запись.ДатаПримененияНовойСтоимостиКРасчетуНалога;
			ИзменитьДатуНачала = Истина;
		КонецЕсли;
		
		УправлениеРеквизитомДатаПримененияНовойСтоимости(ЭтотОбъект);

	КонецЕсли;

	Элементы.ГруппаРасчетЗемельногоНалога.Видимость = ЭтоРегистрацияЗемельногоУчастка;  

КонецПроцедуры

&НаСервере
Процедура ПроверитьКадастроваяСтоимостьИзменилась()
	
	КадастроваяСтоимостьБыла = 0;
	КадастроваяСтоимостьИзменилась = Ложь;
	ДатаПоследнейУстановки = Дата(1,1,1);
	ДатаИзмененияКадастровойСтоимости = Запись.Период;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СведенияКадастровогоУчета.КадастроваяСтоимость КАК КадастроваяСтоимость,
		|	СведенияКадастровогоУчета.Период КАК Период
		|ИЗ
		|	РегистрСведений.СведенияКадастровогоУчета КАК СведенияКадастровогоУчета
		|ГДЕ
		|	СведенияКадастровогоУчета.Период < &Период
		|	И СведенияКадастровогоУчета.Период <> &ПериодТекущейЗаписи
		|	И СведенияКадастровогоУчета.Организация = &Организация
		|	И СведенияКадастровогоУчета.ОсновноеСредство = &ОсновноеСредство
		|	И СведенияКадастровогоУчета.ИнвентарныйНомер = &ИнвентарныйНомер
		|	И СведенияКадастровогоУчета.КадастроваяСтоимость <> 0
		|	И СведенияКадастровогоУчета.КадастроваяСтоимость <> &КадастроваяСтоимость
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Период", Запись.Период);
	Запрос.УстановитьПараметр("ПериодТекущейЗаписи", ?(ПереписатьТекущуюЗапись, ПериодТекущейЗаписи, Запись.Период));
	Запрос.УстановитьПараметр("Организация", Запись.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", Запись.ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвентарныйНомер", Запись.ИнвентарныйНомер);
	Запрос.УстановитьПараметр("КадастроваяСтоимость", Запись.КадастроваяСтоимость);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		КадастроваяСтоимостьБыла = ВыборкаДетальныеЗаписи.КадастроваяСтоимость;
		КадастроваяСтоимостьИзменилась = Запись.КадастроваяСтоимость <> КадастроваяСтоимостьБыла;
		ДатаПоследнейУстановки = ВыборкаДетальныеЗаписи.Период;
	КонецЕсли;
	
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СведенияКадастровогоУчета.Период КАК Период
		|ИЗ
		|	РегистрСведений.СведенияКадастровогоУчета КАК СведенияКадастровогоУчета
		|ГДЕ
		|	СведенияКадастровогоУчета.Период < &Период
		|	И СведенияКадастровогоУчета.Период > &ДатаПоследнейУстановки
		|	И СведенияКадастровогоУчета.Период <> &ПериодТекущейЗаписи
		|	И СведенияКадастровогоУчета.Организация = &Организация
		|	И СведенияКадастровогоУчета.ОсновноеСредство = &ОсновноеСредство
		|	И СведенияКадастровогоУчета.ИнвентарныйНомер = &ИнвентарныйНомер
		|	И СведенияКадастровогоУчета.КадастроваяСтоимость = &КадастроваяСтоимость
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	
	Запрос.УстановитьПараметр("ДатаПоследнейУстановки", ДатаПоследнейУстановки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		ДатаИзмененияКадастровойСтоимости = ВыборкаДетальныеЗаписи.Период;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодсказкуКадастроваяСтоимость()
	
	Подсказки = Новый Массив;

	Если ЗначениеЗаполнено(ДатаИзмененияКадастровойСтоимости)
		И ДатаИзмененияКадастровойСтоимости <> Запись.Период Тогда

		ШаблонПодсказки = НСтр("ru = 'Установлена с %1'");
		ТекстПодсказки = СтрШаблон(ШаблонПодсказки, Формат(ДатаИзмененияКадастровойСтоимости, "ДЛФ=D"));
		Подсказки.Добавить(ТекстПодсказки);

	КонецЕсли;
	
	Если КадастроваяСтоимостьИзменилась Тогда

		ШаблонПодсказки = НСтр("ru = 'Кадастровая стоимость до %1: %2 руб.'");
		ТекстПодсказки = СтрШаблон(ШаблонПодсказки,
			Формат(ДатаИзмененияКадастровойСтоимости, "ДЛФ=D"),
			Формат(КадастроваяСтоимостьБыла, "ЧДЦ=2"));
		Подсказки.Добавить(ТекстПодсказки);

	КонецЕсли;

	Элементы.КадастроваяСтоимость.РасширеннаяПодсказка.Заголовок = СтрСоединить(Подсказки, Символы.ПС);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДатаПримененияНовойСтоимости(ДатаИзмененияКадастровойСтоимости, КадастроваяСтоимостьИзменилась)

//	Изменение кадастровой стоимости земельного участка в течение налогового периода не учитывается при определении
//	налоговой базы в этом и предыдущих налоговых периодах, если иное не предусмотрено законодательством
//	Российской Федерации (п.1.1. ст. 391 НК РФ)
	
	Если КадастроваяСтоимостьИзменилась
		И НачалоГода(ДатаИзмененияКадастровойСтоимости) <> ДатаИзмененияКадастровойСтоимости Тогда
			
		ДатаПримененияНовойСтоимости = НачалоГода(ДобавитьМесяц(ДатаИзмененияКадастровойСтоимости, 12));
		
	Иначе
		
		ДатаПримененияНовойСтоимости = ДатаИзмененияКадастровойСтоимости;
		
	КонецЕсли;
	
	Возврат ДатаПримененияНовойСтоимости;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеРеквизитомДатаПримененияНовойСтоимости(Форма)

	Если Форма.ИзменитьДатуНачала Тогда
		ТекстПодсказки = НСтр("ru = 'Дата начала применения новой стоимости устанавливается вручную'");
	Иначе
		ТекстПодсказки = НСтр("ru = 'При изменении кадастровой стоимости в течении налогового периода, новая кадастровая стоимость применяется с 1 января следующего налогового периода в соответствии с п.1.1. ст. 391 НК РФ'");
	КонецЕсли;

	Форма.Элементы.ИзменитьДатуНачала.Подсказка = ТекстПодсказки;
	Форма.Элементы.ДатаПримененияНовойСтоимости.ТолькоПросмотр = Не Форма.ИзменитьДатуНачала;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьДоляПлощади(Форма)

	Запись   = Форма.Запись;
	Элементы = Форма.Элементы;
	
	Элементы.КадастроваяСтоимостьОпределенаПоПлощади.Видимость = Запись.ВидОбъектаНедвижимости = 
		ПредопределенноеЗначение("Перечисление.ВидыОбъектовНедвижимости.Помещение");
		
	Элементы.ГруппаДоляПлощади.Видимость = Форма.КадастроваяСтоимостьОпределенаПоПлощади;	

КонецПроцедуры

&НаСервере
Процедура ВидимостьИнвентарногоНомера()
	
	ВидНФА = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.ОсновноеСредство, "ВидНФА");
	Элементы.ИнвентарныйНомер.Видимость = ВидНФА <> Перечисления.ВидыНФА.КапВложения;
		
КонецПроцедуры	

&НаКлиенте
Асинх Процедура ВопросПередЗакрытиемАсинх()

	ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, ,КодВозвратаДиалога.Да);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если ЗаписатьНаСервере() Тогда
			Закрыть();
			Оповестить("СведенияКадастровогоУчетаЗаписаны");
		КонецЕсли;
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ЗаписатьНаСервере()
	
	Если ЭтоРегистрацияЗемельногоУчастка И ИзменитьДатуНачала Тогда
		Запись.ДатаПримененияНовойСтоимостиКРасчетуНалога = ДатаПримененияНовойСтоимости;
	Иначе
		Запись.ДатаПримененияНовойСтоимостиКРасчетуНалога = Дата(1,1,1);
	КонецЕсли;

	Возврат 
		?(ПереписатьТекущуюЗапись,
		Записать(),
		ДобавитьЗаписьНаСервере());
	
КонецФункции

&НаСервере
Функция ДобавитьЗаписьНаСервере()
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат Ложь;	
	КонецЕсли;

	МенЗаписи = РегистрыСведений.СведенияКадастровогоУчета.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенЗаписи, Запись);
	МенЗаписи.Записать(Истина);

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, МенЗаписи, Новый Структура); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ЗначениеВРеквизитФормы(МенЗаписи, "Запись");
	ПериодТекущейЗаписи = Запись.Период;
	Модифицированность = Ложь;   

	Возврат Истина;	
КонецФункции

#КонецОбласти

