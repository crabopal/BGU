
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения <> Неопределено И ДанныеЗаполнения.Свойство("ОсновноеСредство") Тогда		
		
		ЗаписьСведений = ЭтотОбъект[0];
		
		ОтборСреза = Новый Структура("ОсновноеСредство", ДанныеЗаполнения.ОсновноеСредство);
		ПоследниеСведения = РегистрыСведений.СведенияКадастровогоУчета.СрезПоследних(, ОтборСреза);
		Если ПоследниеСведения.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(ЗаписьСведений, ПоследниеСведения[0],, "Период");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ЗаписьСведений.Организация) Тогда
			ЗаписьСведений.Организация = ДанныеЗаполнения.ОсновноеСредство.Организация;
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры
