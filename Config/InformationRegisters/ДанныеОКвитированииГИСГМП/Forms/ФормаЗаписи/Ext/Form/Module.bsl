
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТолькоПросмотр = Истина;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ТекстФайла = ТекущийОбъект.ТекстКвитанции.Получить();
КонецПроцедуры

&НаКлиенте
Процедура СодержимоеФайла(Команда)
	ПараметрыФормы = Новый Структура("ТекстФайла",ТекстФайла);
	ПараметрыФормы.Вставить("Заголовок","Содержимое полученного файла, по которому сформирована данная запись");
	ОткрытьФорму("ОбщаяФорма.ФормаПросмотраXML",ПараметрыФормы,ЭтотОбъект);
КонецПроцедуры
