Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию_2_0_106(Параметры) Экспорт

	ОбработкаВсехВидовДокументовЗавершена = Истина; // Начальное значение определяется алгоритмом дальнейшей обработки
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	ИменаДокументов = ПолучитьИменаДокументовДляПереходаНаНовуюВерсию_2_0_106();
	
	Для Каждого ИмяДокумента Из	ИменаДокументов Цикл
		ПолноеИмяОбъекта = "Документ." + ИмяДокумента;

		Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);

		Параметры.ОбработкаЗавершена = Ложь;
		
		Пока Выборка.Следующий() Цикл
			
			ДокументСсылка = Выборка.Ссылка;
			ДокументПередачиНФА = ДокументСсылка;
			
			МетаданныеДокумента = ДокументСсылка.Метаданные();
			
			НачатьТранзакцию();
			
			Попытка
				СостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ОбменЗавершен;
				
				Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
					Реквизиты = "ТипЭлектронногоАкта, ДокументОснование";
					ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, Реквизиты);
					Если ЗначенияРеквизитов.ТипЭлектронногоАкта = 2 Тогда
						СостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПолученОтветныйАкт;
						РеквизитыИсходящегоАкта = "ДокументОснование";
						ЗначенияРеквизитовИсходящегоАкта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначенияРеквизитов.ДокументОснование, РеквизитыИсходящегоАкта);
						
						ДокументПередачиНФА = ЗначенияРеквизитовИсходящегоАкта.ДокументОснование;
					Иначе
						СостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПолученВходящийАкт;
						//Нет возможности определить документ передачи НФА без вложенных запросов
						ДокументПередачиНФА = Неопределено;
					КонецЕсли;	
				ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий") Тогда
					Реквизиты = "ТипЭлектронногоАкта, ДокументОснование";
					ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, Реквизиты);
					Если ЗначенияРеквизитов.ТипЭлектронногоАкта = 2 Тогда
						СостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПодготовленОтветныйАкт;

						ДокументПередачиНФА = ЗначенияРеквизитов.ДокументОснование;
					Иначе
						СостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПодготовленИсходящийАкт;
						
						ДокументПередачиНФА = ЗначенияРеквизитов.ДокументОснование;
					КонецЕсли;	
				КонецЕсли;	
				
				Если ЗначениеЗаполнено(ДокументПередачиНФА) Тогда
					НаборЗаписей = РегистрыСведений.СостоянияПоДокументамАктовЭДОБГУ.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.СсылкаНаОбъект.Установить(ДокументПередачиНФА);
					Запись = НаборЗаписей.Добавить();
					Запись.СсылкаНаОбъект = ДокументПередачиНФА;
					Запись.СостояниеЭДО = СостояниеЭДО;
					ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
				КонецЕсли;	

				ЗафиксироватьТранзакцию();
				
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Исключение
				ОтменитьТранзакцию();
					
				ТекстСообщения = СтрШаблон(
					НСтр("ru='Не удалось записать состояние ЭДО актами для документа %1 по причине: %2'"),
					Выборка.Ссылка,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					
				ЗаписьЖурналаРегистрации(
					ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Предупреждение,
					,
					,
					ТекстСообщения);
					
				ВызватьИсключение;
					
			КонецПопытки;
		
		КонецЦикла;
		
		ОбработкаТекущегоВидаДокументовЗавершена = НЕ ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
		
		ОбработкаВсехВидовДокументовЗавершена = ОбработкаВсехВидовДокументовЗавершена И ОбработкаТекущегоВидаДокументовЗавершена;
	КонецЦикла;

	Параметры.ОбработкаЗавершена = ОбработкаВсехВидовДокументовЗавершена;
	
КонецПроцедуры

#КонецОбласти

