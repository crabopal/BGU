	ИменаДокументов.Добавить("НакладнаяНаОтпускМ15");
	ИменаДокументов.Добавить("ПередачаОбъектовИК");
	ИменаДокументов.Добавить("ПринятиеКУчетуОбъектовОС");
	ИменаДокументов.Добавить("ПринятиеКУчетуОбъектовИК");
	ИменаДокументов.Добавить("ПоступлениеОС");
	ИменаДокументов.Добавить("ПоступлениеМЗ");
