
#Область ОбработчикиКомандФормы

&НаСервере
Процедура НачальноеЗаполнениеНаСервере()
	МодульСбораДанных.ИнициализацияДанныеПодключенияЕСМВСМЭВ();
КонецПроцедуры

&НаКлиенте
Процедура НачальноеЗаполнение(Команда)
	НачальноеЗаполнениеНаСервере();  
	Элементы.Список.Обновить();
	ОчиститьСообщения();
	ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Заполнение выполнено.'"));
КонецПроцедуры

#КонецОбласти