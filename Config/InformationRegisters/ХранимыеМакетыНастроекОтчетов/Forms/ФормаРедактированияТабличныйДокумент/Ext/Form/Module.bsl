
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаписьОбъект = РеквизитФормыВЗначение("Запись");
	Данные = ЗаписьОбъект.Макет.Получить();
	
	Если ТипЗнч(Данные) <> Тип("ТабличныйДокумент") Тогда
		Данные = Новый ТабличныйДокумент;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(Данные);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Данные = ТабличныйДокумент.ПолучитьОбласть();
	
	ТекущийОбъект.Макет = Новый ХранилищеЗначения(Данные);
	
КонецПроцедуры
