////////////////////////////////////////////////////////////////////
#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаписьОбъект = РеквизитФормыВЗначение("Запись");
	Данные = ЗаписьОбъект.Макет.Получить();
	
	Если ТипЗнч(Данные) <> Тип("Структура")
		Или Не Данные.Свойство("ИсточникДанных")
		Или Не Данные.Свойство("НастройкиКомпоновки") Тогда 
		Данные = ИнициироватьСтруктуруХранимыхДанных();
	КонецЕсли;	
	
	ВидОтчета = Запись.Владелец.Владелец;
	ЗапонитьВспомогательныеДанные();
	
	АдресСКД = ПоместитьВоВременноеХранилище(Данные.ИсточникДанных.СхемаКомпоновки,УникальныйИдентификатор);
	ИнициализироватьНастройкиПоСхеме();
	
	РазобратьДанныеОбИсточникеДанных(Данные.ИсточникДанных);
	
	
	НастройкиКомпоновки.Загрузить(Данные.НастройкиКомпоновки);
	
	РедактируемаяСтрокаНастроек = -1;
	РедактируемыйРаздел = Элементы.ГруппаСтраницыОсновные.ТекущаяСтраница.Имя;
	
	#Если ТолстыйКлиентОбычноеПриложение или ТолстыйКлиентУправляемоеПриложение Тогда
		Элементы.РедактироватьВКонструктореСКД.Доступность = Истина;
	#КонецЕсли
	
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьСтраницуПоТипуИсточника();
КонецПроцедуры


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.Макет = Новый ХранилищеЗначения(ПодготовитьДанныеКСохранению());
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	Если РежимПроверкиЗаполнения <> "ПроверкаПередТестированиемСКД" Тогда 
		НепроверяемыеРеквизиты.Добавить("ОтчетДляПроверки");
	КонецЕсли;
	
	
	//Задвоение имен настроек
	КоллекцияДляПроверки = НастройкиКомпоновки.Выгрузить();
	КоллекцияДляПроверки.Колонки.Добавить("Счетчик");
	КоллекцияДляПроверки.ЗаполнитьЗначения(1,"Счетчик");
	КоллекцияДляПроверки.Свернуть("ИмяНастройки","Счетчик");
	
	Для Каждого СтрокаКоллнецииДляПроверки из КоллекцияДляПроверки Цикл 
		Если СтрокаКоллнецииДляПроверки.Счетчик = 1 Тогда 
			Продолжить;
		КонецЕсли;	
		
		Отказ = Истина;
		ЗадвоенныеСтроки = НастройкиКомпоновки.НайтиСтроки(Новый Структура("ИмяНастройки",СтрокаКоллнецииДляПроверки.ИмяНастройки));
		
		Для Каждого ЗадвоеннаяСтрока из ЗадвоенныеСтроки Цикл 
			
			Шаблон = НСтр(
			"ru = 'Существует несколько настроек с одинаковым именем ""%1"".'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,СтрокаКоллнецииДляПроверки.ИмяНастройки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение,,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("НастройкиКомпоновки",НастройкиКомпоновки.Индекс(ЗадвоеннаяСтрока)+1,"ИмяНастройки"));
			
		КонецЦикла;
		
	КонецЦикла;	
	
	
	
	
	
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты,НепроверяемыеРеквизиты);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ИсточникВыбора) = тип("КонструкторСхемыКомпоновкиДанных") Тогда 
		
		АдресСКД = ПоместитьВоВременноеХранилище(ВыбранноеЗначение, УникальныйИдентификатор);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыОсновныеПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если РедактируемыйРаздел = "ГруппаСтраницаИсточникДанных" и 
		(ТекущаяСтраница = Элементы.ГруппаСтраницаНастройки или 
		ТекущаяСтраница = Элементы.ГруппаСтраницаПроверка) Тогда 
		
		ОбновитьСхемуПоИсточникуДанных();
		ИнициализироватьНастройкиПоСхеме();
		
	КонецЕсли;	
	
	РедактируемыйРаздел = ТекущаяСтраница.Имя;	
КонецПроцедуры


#Область ИсточникиДанных

&НаКлиенте
Процедура РедактироватьВКонструктореСКД(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение или ТолстыйКлиентУправляемоеПриложение Тогда
		
		Конструктор = Новый КонструкторСхемыКомпоновкиДанных;
		Конструктор.УстановитьСхему(ПолучитьИзВременногоХранилища(АдресСКД));
		Конструктор.Редактировать(ЭтаФорма);
		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ТипИсточникаДанныхПриИзменении(Элемент)
	
	ТипИсточникаДанныхПриИзмененииНаСервере();
	УстановитьСтраницуПоТипуИсточника();
	
КонецПроцедуры

&НаСервере
Процедура ТипИсточникаДанныхПриИзмененииНаСервере()
	
	ПодготовитьДоступныеПоля();
	ОбновитьОтметкиДоступностиОтбораПоКонтексту();
	
КонецПроцедуры	


&НаКлиенте
Процедура ГруппаСтраницыНастроекКонструктораЗапросаПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.ГруппаСтраницаКонструктораПоля Тогда 
		
		ПодготовитьДоступныеПоля();
		
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаСтраницаКонструктораПрочее Тогда 
		
		ОбновитьТипыСвойств();
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоля(Команда)
	
	Для Каждого ИдСтроки из Элементы.ДоступныеПоля.ВыделенныеСтроки Цикл 
		
		ДанныеСтроки = ДоступныеПоля.НайтиПоИдентификатору(ИдСтроки);
		Если ДанныеСтроки.УжеИспользуется Тогда 
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Поля.Добавить(),ДанныеСтроки);
		
		ДанныеСтроки.УжеИспользуется = Истина;
		
	КонецЦикла;	
	ОбновитьОтметкиДоступностиОтбораПоКонтексту();
	
	Элементы.ДоступныеПоля.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("УжеИспользуется",Ложь));
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПоля(Команда)
	
	СтрокиДляУдаления = Новый Массив;
	
	Для Каждого ИдСтроки из Элементы.Поля.ВыделенныеСтроки Цикл 
		ДанныеСтроки = Поля.НайтиПоИдентификатору(ИдСтроки);
		СтрокиДляУдаления.Добавить(ДанныеСтроки);
		
		СтрокиДоступныхПолей = ДоступныеПоля.НайтиСтроки(Новый Структура("Имя,ПутьКДанным",ДанныеСтроки.Имя,ДанныеСтроки.ПутьКДанным));
		Для Каждого СтрокаДоступныхПолей из СтрокиДоступныхПолей Цикл
			СтрокаДоступныхПолей.УжеИспользуется = Ложь;
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого СтрокаДялУдаления из СтрокиДляУдаления Цикл 
		Поля.Удалить(СтрокаДялУдаления);
	КонецЦикла;	
	
	Элементы.ДоступныеПоля.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("УжеИспользуется",Ложь));
КонецПроцедуры



#КонецОбласти
#Область Настройки

&НаКлиенте
Процедура НастройкиКомпоновкиПриАктивизацииСтроки(Элемент)
	
	СохранитьНастройкуВТаблицу();
	ПрочитатьНастройкуИзТаблицы(Элементы.НастройкиКомпоновки.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиКомпоновкиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Копирование Тогда 
		СохранитьНастройкуВТаблицу();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиКомпоновкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если Копирование Тогда 
		ПрочитатьНастройкуИзТаблицы(Элементы.НастройкиКомпоновки.ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
#Область Проверка

&НаКлиенте
Процедура ПроверитьСКД(Команда)
	
	РежимПроверкиЗаполнения = "ПроверкаПередТестированиемСКД";
	
	Если Не ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
	
	РежимПроверкиЗаполнения = "";
	
	ВыполнитьСКДИВывестиРезультат();
	
КонецПроцедуры


#КонецОбласти
#КонецОбласти
////////////////////////////////////////////////////////////////////
#Область СлужебныеПроцедурыИФункции

&НаСервере
функция ПодготовитьДанныеКСохранению()
	
	Данные = ИнициироватьСтруктуруХранимыхДанных();	
	
	ОбновитьСхемуПоИсточникуДанных();
	ИнициализироватьНастройкиПоСхеме();
	ОбновитьДанныеИсточникаДанных(Данные.ИсточникДанных);
	
	СохранитьНастройкуВТаблицу();
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(НастройкиКомпоновки,Данные.НастройкиКомпоновки);
	
	Возврат Данные;
	
КонецФункции	

&НаСервере
Функция ИнициироватьСтруктуруХранимыхДанных()
	
	Данные = Новый Структура;
	Данные.Вставить("ИсточникДанных", Новый Структура);
	Данные.ИсточникДанных.Вставить("ВыбранныеПоля", Новый ТаблицаЗначений);
	Данные.ИсточникДанных.ВыбранныеПоля.Колонки.Добавить("Имя");
	Данные.ИсточникДанных.ВыбранныеПоля.Колонки.Добавить("ПутьКДанным");
	Данные.ИсточникДанных.ВыбранныеПоля.Колонки.Добавить("ОтборПоКонтексту", Новый ОписаниеТипов("Булево"));
	
	Данные.ИсточникДанных.Вставить("ПараметрыДанных", Новый Структура);
	Данные.ИсточникДанных.Вставить("ТипыХарактеристик", Новый Массив);
	Данные.ИсточникДанных.Вставить("ВключатьИтоги", Ложь);
	Данные.ИсточникДанных.Вставить("ТипИсточникаЗапрос", Истина);   //для совместимости со старым кодом
	Данные.ИсточникДанных.Вставить("ТипИсточника", "ПроизольнаяСхема");
	Данные.ИсточникДанных.Вставить("СхемаКомпоновки", Новый СхемаКомпоновкиДанных);
	
	Данные.Вставить("НастройкиКомпоновки" ,Новый ТаблицаЗначений);
	Данные.НастройкиКомпоновки.Колонки.Добавить("ИмяНастройки",Новый ОписаниеТипов("Строка"));
	Данные.НастройкиКомпоновки.Колонки.Добавить("Настройки",Новый ОписаниеТипов("НастройкиКомпоновкиДанных")); 
	
	Возврат Данные;
	
КонецФункции	

&НаСервере
Процедура СохранитьНастройкуВТаблицу()
	Если РедактируемаяСтрокаНастроек = -1 Тогда 
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы = НастройкиКомпоновки.НайтиПоИдентификатору(РедактируемаяСтрокаНастроек);
	Если СтрокаТаблицы = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	СтрокаТаблицы.Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьНастройкуИзТаблицы(СтрокаТаблицы = Неопределено)
	
	Если СтрокаТаблицы = Неопределено Тогда 
		Настройки = Новый НастройкиКомпоновкиДанных;
		Элементы.ГруппаНастрйка.ТолькоПросмотр = Истина;
		
	ИначеЕсли СтрокаТаблицы.Настройки = Неопределено Тогда 
		Настройки = Новый НастройкиКомпоновкиДанных;
		Элементы.ГруппаНастрйка.ТолькоПросмотр = Ложь;
		
	Иначе 
		Настройки = СтрокаТаблицы.Настройки;
		Элементы.ГруппаНастрйка.ТолькоПросмотр = Ложь;
		
	КонецЕсли;
	
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.Полное);
	
	Если СтрокаТаблицы = Неопределено Тогда 
		РедактируемаяСтрокаНастроек = -1;
	Иначе 
		РедактируемаяСтрокаНастроек = СтрокаТаблицы.ПолучитьИдентификатор();
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ВыполнитьСКДИВывестиРезультат()
	РезультатПроверки.Очистить();
	
	ОтчетОбъект = ОтчетДляПроверки.ПолучитьОбъект();
	ОтчетОбъект.ИнициализироватьКонтекст();
	
	РезультатВыполнения = ОтчетОбъект.ВыполнитьХранимыйМакетТипаСКД(ПодготовитьДанныеКСохранению(),"","ТабличныйДокумент");
	
	РезультатПроверки.Вывести(РезультатВыполнения.ТабличныйДокумент);
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьСтраницуПоТипуИсточника()
	
	Если ТипИсточникаДанных = "ЭтотОтчет" или ТипИсточникаДанных = "ВсеОтчеты" Тогда 
		Элементы.ГруппаСтраницыТиповИсточниковДанных.ТекущаяСтраница = Элементы.ГруппаСтраницаКонстрктор;
	Иначе 
		Элементы.ГруппаСтраницыТиповИсточниковДанных.ТекущаяСтраница = Элементы.ГруппаСтраницаПроизвольнаяСхема;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура РазобратьДанныеОбИсточникеДанных(ИсточникДанных)
	
	Если ИсточникДанных.Свойство("ТипИсточника") Тогда 
		ТипИсточникаДанных = ИсточникДанных.ТипИсточника;
	Иначе 
		Если ИсточникДанных.ТипИсточникаЗапрос Тогда 
			ТипИсточникаДанных = "ВсеОтчеты";
		Иначе 
			ТипИсточникаДанных = "ЭтотОтчет";
		КонецЕсли;
	КонецЕсли;
	
	
	Если ИсточникДанных.ПараметрыДанных.Свойство("Показатель") Тогда  
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоказателиОтчетов.Ссылка КАК Показатель
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|ГДЕ
		|	ПоказателиОтчетов.Владелец = &Владелец
		|	И ПоказателиОтчетов.Код В(&Коды)";
		
		Запрос.УстановитьПараметр("Владелец",ВидОтчета);
		Запрос.УстановитьПараметр("Коды"	,ИсточникДанных.ПараметрыДанных.Показатель);
		
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Запрос.Выполнить().Выгрузить(), Показатели);
	КонецЕсли;
	
	Поля.Очистить();
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ИсточникДанных.ВыбранныеПоля,Поля);
	ОбновитьОтметкиДоступностиОтбораПоКонтексту();
	
	ВключатьИтоги = ИсточникДанных.ВключатьИтоги;
	ВключитьХарактеристики = ИсточникДанных.ТипыХарактеристик.Количество() > 0;
	
	СписокТиповСвойств.ЗагрузитьЗначения(ИсточникДанных.ТипыХарактеристик );
	СписокТиповСвойств.ЗаполнитьПометки(Истина);
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьДанныеИсточникаДанных(ИсточникДанных)
	
	ИсточникДанных.ТипИсточника = ТипИсточникаДанных;
	Если ТипИсточникаДанных = "ПроизольнаяСхема" Тогда 
		
		ИсточникДанных.ТипИсточникаЗапрос = Истина;
		ИсточникДанных.ПараметрыДанных.Очистить();
		ИсточникДанных.ВыбранныеПоля.Очистить();
		Возврат;
		
	ИначеЕсли ТипИсточникаДанных = "ЭтотОтчет" Тогда  
		ИсточникДанных.ТипИсточникаЗапрос = Ложь;
		
	ИначеЕсли ТипИсточникаДанных = "ВсеОтчеты" Тогда  
		ИсточникДанных.ТипИсточникаЗапрос = Истина;
		
	КонецЕсли;	
	
	ПараметрыДанных = ПолучитьИзВременногоХранилища(АдресПараметрыДанных);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ИсточникДанных.ПараметрыДанных,ПараметрыДанных,Истина);
	
	
	ИсточникДанных.ВыбранныеПоля.Очистить();
	Для Каждого СтрокаПоля из Поля Цикл
		
		НоваяСтрока = ИсточникДанных.ВыбранныеПоля.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПоля);
		НоваяСтрока.ОтборПоКонтексту = СтрокаПоля.ОтборПоКонтексту и СтрокаПоля.ДоступенОтборПоКонтексту;
		
	КонецЦикла;	
	
	ИсточникДанных.ВключатьИтоги = ВключатьИтоги;
	
	ИсточникДанных.ТипыХарактеристик.Очистить();
	Если  ВключитьХарактеристики Тогда
		
		ИсточникДанных.ТипыХарактеристик = МассивОтмеченныхЭлементовСписка(СписокТиповСвойств);
		
	КонецЕсли;
	
	
	ИсточникДанных.СхемаКомпоновки = ПолучитьИзВременногоХранилища(АдресСКД);
	
КонецПроцедуры

&НаСервере
Функция МассивОтмеченныхЭлементовСписка(Список) Экспорт
	
	// Возвращаемое значение функции.
	Массив = Новый Массив;
	
	Для Каждого Элемент Из Список Цикл
		
		Если Элемент.Пометка Тогда
			
			Массив.Добавить(Элемент.Значение);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Массив;
КонецФункции

&НаСервере
Процедура ОбновитьСхемуПоИсточникуДанных()
	
	Если ТипИсточникаДанных <> "ЭтотОтчет" и ТипИсточникаДанных <> "ВсеОтчеты" Тогда  
		Возврат;
	КонецЕсли;

	
	ПодготовитьПарметрыДанных();
	
	Запрос = ПодготовитьЗапросПоВнешнимДанным(Ложь);
	
	Построитель = Новый ПостроительОтчета;
	
	Построитель.Текст = Запрос.Текст;
	Построитель.ЗаполнитьНастройки();
	
	Построитель.ВыбранныеПоля.Очистить();
	Для Каждого Поле из Поля Цикл 
		Построитель.ВыбранныеПоля.Добавить(Поле.ПутьКДанным,Поле.Имя);
	КонецЦикла;	
	
	Для Каждого Параметр Из Запрос.Параметры Цикл
		Построитель.Параметры.Вставить(Параметр.Ключ,Параметр.Значение);
	КонецЦикла;
	
	Запрос = Построитель.ПолучитьЗапрос();
	
	ПараметрыДанных = ПолучитьИзВременногоХранилища(АдресПараметрыДанных);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыДанных,Запрос.Параметры,Ложь);
	АдресПараметрыДанных = ПоместитьВоВременноеХранилище(ПараметрыДанных);
	
	//показатели 
	Если Показатели.Количество() = 0 Тогда
		УсловиеПоказателя = "ИСТИНА";
	Иначе
		УсловиеПоказателя = "ЗначенияПоказателейОтчетов.Показатель.Код В(&Показатель)";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"ЗначенияПоказателейОтчетов.Показатель В(&Показатель)",УсловиеПоказателя);
	
	//отборы по контексту
	Если ЗначениеЗаполнено(Поля.НайтиСтроки(Новый Структура("ОтборПоКонтексту",Истина))) Тогда 
		
		Запрос.Текст = Запрос.Текст + " 
		|//%УСЛОВИЕ ОТБОРА ПО КОНТЕКСТУ%";
		
	КонецЕсли;
	
	
	//Характеристики
	Если  ВключитьХарактеристики Тогда
		
		ТекстХарактеристик = "";
		Для Каждого ТипСвойства Из СписокТиповСвойств Цикл
			
			Если Не ТипСвойства.Пометка Тогда
				Продолжить;
			КонецЕсли;
			
			Шаблон = "
			|{ХАРАКТЕРИСТИКИ
			|ТИП(Справочник.КолонкиОтчетов)
			|СПИСОК (ВЫБРАТЬ
			|			НазначенияСвойствОбъектов.Свойство.Ссылка КАК Свойство,
			|			НазначенияСвойствОбъектов.Свойство.Наименование КАК Наименование,
			|			НазначенияСвойствОбъектов.Свойство.ТипЗначения КАК ТипЗначения
			|		ИЗ
			|			РегистрСведений.НазначенияСвойствОбъектов КАК НазначенияСвойствОбъектов
			|		ГДЕ
			|			НазначенияСвойствОбъектов.НазначениеСвойства = &ХарактеристикаПоля%1)
			|ИДЕНТИФИКАТОР Свойство
			|ИМЯ Наименование
			|ТИПЗНАЧЕНИЯ ТипЗначения
			|ЗНАЧЕНИЯ РегистрСведений.ЗначенияСвойствОбъектов
			|ОБЪЕКТ Объект
			|ХАРАКТЕРИСТИКА Свойство
			|ЗНАЧЕНИЕ Значение }";
			
			ИмяПараметра = ОбщегоНазначения.ИмяЗначенияПеречисления(ТипСвойства.Значение);
			ДобавляемыйТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ИмяПараметра);
			
			ТекстХарактеристик = ТекстХарактеристик + ДобавляемыйТекст;
			
		КонецЦикла;
		
		Запрос.Текст = Запрос.Текст + "
		|" + ТекстХарактеристик;
		
	КонецЕсли;
	
	
	СКД = СформироватьСхемуКомпоновки(Запрос.Текст);
	
	АдресСКД = ПоместитьВоВременноеХранилище(СКД, УникальныйИдентификатор);
	
КонецПроцедуры	

&НаСервере
Процедура ПодготовитьПарметрыДанных()
	
	ПараметрыДанных = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Показатели",Показатели.Выгрузить().ВыгрузитьКолонку("Показатель"));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоказателиОтчетов.Код КАК Код
	|ИЗ
	|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|ГДЕ
	|	ПоказателиОтчетов.Ссылка в (&Показатели)";
	
	ПараметрыДанных.Вставить("Показатель",Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Код"));
	
	Если  ВключитьХарактеристики Тогда
		Для Каждого ТипСвойства Из СписокТиповСвойств Цикл
			Если Не ТипСвойства.Пометка Тогда
				Продолжить;
			КонецЕсли;	
			
			ПараметрыДанных.Вставить("ХарактеристикаПоля"+ОбщегоНазначения.ИмяЗначенияПеречисления(ТипСвойства.Значение),
			ТипСвойства.Значение);
			
			
			
		КонецЦикла;
	КонецЕсли;
	
	АдресПараметрыДанных = ПоместитьВоВременноеХранилище(ПараметрыДанных,УникальныйИдентификатор);;
	
КонецПроцедуры	

&НаСервере
Функция СформироватьСхемуКомпоновки(ТекстЗапроса = "")
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	НовыйИсточник = СхемаКомпоновки.ИсточникиДанных.Добавить();
	НовыйИсточник.Имя = "ИсточникДанных1";
	НовыйИсточник.ТипИсточникаДанных = "Local";
	
	Если Не ПустаяСтрока(ТекстЗапроса) Тогда
		
		Набор = СхемаКомпоновки.НаборыДанных.Найти("ЗапросПоВидуОтчета");
		Если Не Набор = Неопределено Тогда
			СхемаКомпоновки.НаборыДанных.Удалить(Набор);
		КонецЕсли;
		
		Набор 			 	 = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		Набор.Имя 		 	 = "ЗапросПоВидуОтчета";
		Набор.ИсточникДанных =  "ИсточникДанных1";
		Набор.АвтоЗаполнениеДоступныхПолей = Истина;
		
		Набор.Запрос 		 = ТекстЗапроса;
		
	КонецЕсли;
	
	ПараметрыДанных = ПолучитьИзВременногоХранилища(АдресПараметрыДанных);
	
	Для Каждого Параметр Из ПараметрыДанных Цикл
		
		ПараметрСхемы = СхемаКомпоновки.Параметры.Найти(Параметр.Ключ);
		Если ПараметрСхемы = Неопределено Тогда
			ПараметрСхемы 			= СхемаКомпоновки.Параметры.Добавить();
			ПараметрСхемы.Имя  		= Параметр.Ключ;
			ПараметрСхемы.Заголовок	= Параметр.Ключ;
		КонецЕсли;
		
		ПараметрСхемы.ВключатьВДоступныеПоля 	= Ложь;			
		ПараметрСхемы.ОграничениеИспользования 	= Истина;
		
		Если ТипЗнч(Параметр.Значение) = Тип("Массив") Тогда
			ПараметрСписок = Новый СписокЗначений;
			ПараметрСписок.ЗагрузитьЗначения(Параметр.Значение);
			
			ПараметрСхемы.ТипЗначения = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(Параметр.Значение[0])));
			
			ПараметрСхемы.ДоступенСписокЗначений = Истина;
			ПараметрСхемы.Значение = ПараметрСписок;
			
		Иначе
			ПараметрСхемы.ТипЗначения = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТипЗнч(Параметр.Значение)));
			ПараметрСхемы.Значение = Параметр.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
	// Поля итога
	Если СхемаКомпоновки.ПоляИтога.Количество() = 0 Тогда
		Если ЗначениеЗаполнено( Поля.НайтиСтроки(Новый Структура("Имя","Значение")) ) Тогда
			ПолеИтога 				= СхемаКомпоновки.ПоляИтога.Добавить();
			ПолеИтога.Выражение 	= "Количество(Различные Значение)";
			ПолеИтога.ПутьКДанным 	= "Значение";
		ИначеЕсли ЗначениеЗаполнено(Поля.НайтиСтроки(Новый Структура("Имя","ЗначениеЧисло")) ) Тогда
			ПолеИтога 				= СхемаКомпоновки.ПоляИтога.Добавить();
			ПолеИтога.Выражение 	= "Сумма(ЗначениеЧисло)";
			ПолеИтога.ПутьКДанным 	= "ЗначениеЧисло";
		КонецЕсли;
	КонецЕсли;
	
	Возврат СхемаКомпоновки;
	
КонецФункции 


&НаСервере
Процедура ИнициализироватьНастройкиПоСхеме()
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСКД));
	
КонецПроцедуры	

&НаСервере
Процедура ПодготовитьДоступныеПоля()
	
	Если ТипИсточникаДанных <> "ЭтотОтчет" и ТипИсточникаДанных <> "ВсеОтчеты" Тогда
		Возврат;
	КонецЕсли;	
	
	ПостроительОтчета = Новый ПостроительОтчета;
	
	Запрос = ПодготовитьЗапросПоВнешнимДанным(Истина);
	
	ПостроительОтчета.Текст = Запрос.Текст;
	
	Для Каждого Параметр Из Запрос.Параметры Цикл
		
		ПостроительОтчета.Параметры.Вставить(Параметр.Ключ,Параметр.Значение);
		
	КонецЦикла;
	
	ПостроительОтчета.ЗаполнитьНастройки();
	
	ДоступныеПоля.Очистить();
	Для Каждого ДоступноеПоле из ПостроительОтчета.ДоступныеПоля Цикл 
		
		Если ДоступноеПоле.Имя = "ВидОтчета" Тогда 
			Продолжить;
		КонецЕсли;
		Если ТипИсточникаДанных = "ЭтотОтчет" Тогда 
			Если ДоступноеПоле.Имя = "ЭкземплярОтчета" Тогда 
				Продолжить;
			КонецЕсли;
			Если ДоступноеПоле.Имя = "Организация" Тогда 
				Продолжить;
			КонецЕсли;
			Если ДоступноеПоле.Имя = "ПериодОтчета" Тогда 
				Продолжить;
			КонецЕсли;
			Если ДоступноеПоле.Имя = "ИтогПоПоказателю" Тогда 
				Продолжить;
			КонецЕсли;
		КонецЕсли;	
		
		НоваяСтрока = ДоступныеПоля.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ДоступноеПоле);
		
		Если ДоступноеПоле.Имя = "Значение" или ДоступноеПоле.Имя = "ЗначениеЧисло" Тогда
			НоваяСтрока.КартинкаСтроки = БиблиотекаКартинок.ДоступноеПолеПоказатели;
		Иначе
			НоваяСтрока.КартинкаСтроки = БиблиотекаКартинок.ДоступноеПолеГруппировки;
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокиДляУдаления = Новый Массив;
	Для Каждого СтрокаИспользуемыхПолей из Поля Цикл 
		
		НайденныеСтроки = ДоступныеПоля.НайтиСтроки(Новый Структура("Имя,ПутьКДанным",СтрокаИспользуемыхПолей.Имя, СтрокаИспользуемыхПолей.ПутьКДанным));
		Если не ЗначениеЗаполнено(НайденныеСтроки) Тогда 
			СтрокиДляУдаления.Добавить(СтрокаИспользуемыхПолей);
		Иначе 
			Для Каждого НайденаяСтрока из НайденныеСтроки Цикл
				НайденаяСтрока.УжеИспользуется = Истина;
			КонецЦикла;	
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Для Каждого СтрокаДляУдаления из СтрокиДляУдаления Цикл 
		Поля.Удалить(СтрокаДляУдаления);
	КонецЦикла;	
	
	Элементы.ДоступныеПоля.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("УжеИспользуется",Ложь));
	
КонецПроцедуры	



&НаСервере
Функция ПодготовитьЗапросПоВнешнимДанным(РежимОбщейНастройки = Истина)
	
	Перем Отбор;
	Перем ОтборАналитик;
	
	Если РежимОбщейНастройки Тогда
		ПодготовитьОбщуюНастройкуЗапроса(Отбор,ОтборАналитик);
	Иначе
		ПодготовитьНастройкуОсновногоЗапроса(Отбор,ОтборАналитик);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ПараметрыДопРеквизитов = БюджетнаяОтчетность.ЗаполнитьВидыАналитикОтчета(ВидОтчета);
	
	ТекстДопРек 	= "("+БюджетнаяОтчетность.ПодготовитьЗапросПоДопРеквизитам(Отбор,Запрос,ПараметрыДопРеквизитов,Ложь,Ложь)+")";
	
	ТекстАналитика  = "("+БюджетнаяОтчетность.ПодготовитьЗапросПоказателейСАналитикой(Показатели.выгрузить().ВыгрузитьКолонку("Показатель"),ОтборАналитик,Запрос,Ложь,Ложь,ВключатьИтоги)+")";
	
	ТекстЗапроса = "ВЫБРАТЬ 
	|	ТаблицаДопРеквизитов.*,	
	|   ЗначенияСАналитикой.Показатель,
	|   ЗначенияСАналитикой.ИтогПоПоказателю,
	|   ЗначенияСАналитикой.Значение,
	|   ЗначенияСАналитикой.ЗначениеЧисло";
	Для Каждого ПолеАналитики Из ОтборАналитик Цикл
		
		ТекстЗапроса = ТекстЗапроса + ",
		|   ЗначенияСАналитикой."+ПолеАналитики.ИмяПараметра
		
	КонецЦикла;
	ТекстЗапроса = ТекстЗапроса + "
	|ИЗ
	|	"+ТекстДопРек+" КАК ТаблицаДопРеквизитов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ " + ТекстАналитика + " КАК ЗначенияСАналитикой
	|		ПО ТаблицаДопРеквизитов.ЭкземплярОтчета = ЗначенияСАналитикой.ЭкземплярОтчета";
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗначенияПоказателейОтчетов.*
	|ИЗ
	|	("+ТекстЗапроса+") КАК ЗначенияПоказателейОтчетов";
	
	Возврат Запрос;
	
КонецФункции

&НаСервере
Процедура ПодготовитьОбщуюНастройкуЗапроса(ОтборДопРеквизитов,ОтборАналитик)
	
	ОтборДопРеквизитов = БюджетнаяОтчетность.ПолучитьТаблицуНастроекОтбора();
	БюджетнаяОтчетность.ДобавитьОтборПоРеквизиту(ОтборДопРеквизитов,"ВидОтчета",ВидОтчета,ВидСравнения.Равно);
	
	Если ТипИсточникаДанных = "ВсеОтчеты" Тогда
		
		ВспомогательныеДанные = ПолучитьИзВременногоХранилища(АдресХранилищаВспомогательныхДанныхПоОтчету);
		ДополнительныеРеквизиты = ВспомогательныеДанные.ДополнительныеРеквизиты;
		Для Каждого СтрокаТаблицы Из ДополнительныеРеквизиты Цикл
			БюджетнаяОтчетность.ДобавитьОтборПоРеквизиту(ОтборДопРеквизитов,СтрокаТаблицы.Код,Неопределено);
		КонецЦикла;
		
	КонецЕсли;
	
	ОтборАналитик = БюджетнаяОтчетность.ПолучитьТаблицуНастроекОтбора();
	
	// Поля аналитики
	
	ПереченьГрупп = СформироватьПереченьГрупп();
	
	Если ПереченьГрупп.Количество() = 0 Тогда
		ЧислоАналитик = 0;
	Иначе
		ЧислоАналитик = ПереченьГрупп[0].Аналитика.Количество();
	КонецЕсли;
	
	Для Сч = 1 По ЧислоАналитик Цикл
		БюджетнаяОтчетность.ДобавитьОтборПоРеквизиту(ОтборАналитик,"Аналитика"+Сч,Неопределено);
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура ПодготовитьНастройкуОсновногоЗапроса(ОтборДопРеквизитов,ОтборАналитик)
	
	ОтборДопРеквизитов = БюджетнаяОтчетность.ПолучитьТаблицуНастроекОтбора();
	БюджетнаяОтчетность.ДобавитьОтборПоРеквизиту(ОтборДопРеквизитов,"ВидОтчета",ВидОтчета,ВидСравнения.Равно);
	
	ОтборАналитик = БюджетнаяОтчетность.ПолучитьТаблицуНастроекОтбора();
	
	ВспомогательныеДанные = ПолучитьИзВременногоХранилища(АдресХранилищаВспомогательныхДанныхПоОтчету);
	ДополнительныеРеквизиты = ВспомогательныеДанные.ДополнительныеРеквизиты;
	
	
	Для Каждого Поле Из Поля Цикл
		Если ТипИсточникаДанных = "ВсеОтчеты" и ДополнительныеРеквизиты.Найти(Поле.Имя,"Код") <> Неопределено Тогда
			БюджетнаяОтчетность.ДобавитьОтборПоРеквизиту(ОтборДопРеквизитов,Поле.Имя,Поле.ОтборПоКонтексту);
		ИначеЕсли Лев(Поле.Имя,9) = "Аналитика" Тогда
			БюджетнаяОтчетность.ДобавитьОтборПоРеквизиту(ОтборАналитик,Поле.Имя,Неопределено);
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
функция СформироватьПереченьГрупп()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПоказателиОтчетов.ГруппаРаскрытия
	|ИЗ
	|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|ГДЕ
	|	ПоказателиОтчетов.Ссылка В(&Показатели)";
	
	Запрос.УстановитьПараметр("Показатели",Показатели.Выгрузить().ВыгрузитьКолонку("Показатель"));
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ГруппаРаскрытия");
	
КонецФункции

&НаСервере
Процедура ЗапонитьВспомогательныеДанные()
	
	Данные = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДополнительныеРеквизитыОтчетов.Код,
	|	ДополнительныеРеквизитыОтчетов.ВидАналитики.ТипЗначения КАК ТипЗначения,
	|	ДополнительныеРеквизитыОтчетов.Наименование
	|ИЗ
	|	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
	|ГДЕ
	|	ДополнительныеРеквизитыОтчетов.Владелец = &ВидОтчета";
	
	Запрос.УстановитьПараметр("ВидОтчета",ВидОтчета);
	
	ДополнительныеРеквизиты = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы из ДополнительныеРеквизиты Цикл
		СтрокаТаблицы.Код = СокрП(СтрокаТаблицы.Код);
	КонецЦикла;
	Данные.Вставить("ДополнительныеРеквизиты",ДополнительныеРеквизиты);
	
	
	
	
	
	
	
	АдресХранилищаВспомогательныхДанныхПоОтчету = ПоместитьВоВременноеХранилище(Данные,УникальныйИдентификатор);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбновитьТипыСвойств()
	ТекущиеОтметки = СписокТиповСвойств.Скопировать();
	
	
	МассивЗначений = Новый Массив;
	
	Для Каждого Поле Из Поля Цикл
		
		Если Поле.Имя = "ЭкземплярОтчета" Тогда
			МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.НазначенияСвойств.Организации"));
			МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.НазначенияСвойств.ВидыОтчетов"));
			
		ИначеЕсли Поле.Имя = "Показатель" Тогда
			МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.НазначенияСвойств.ВидыОтчетов"));
			МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.НазначенияСвойств.СтрокиОтчетов"));
			МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.НазначенияСвойств.КолонкиОтчетов"));
			
		Иначе
			ПоляНастройки = ДоступныеПоля.НайтиСтроки(Новый Структура("Имя",Поле.Имя));
			Если Не ЗначениеЗаполнено(ПоляНастройки) Тогда
				Продолжить;
			КонецЕсли;
			ПолеНастройки = ПоляНастройки[0];
			
			Если ПолеНастройки.ТипЗначения.СодержитТип(Тип("СправочникСсылка.СтрокиОтчетов")) Тогда
				МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.НазначенияСвойств.СтрокиОтчетов"));
				
			ИначеЕсли ПолеНастройки.ТипЗначения.СодержитТип(Тип("СправочникСсылка.КолонкиОтчетов")) Тогда
				МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.НазначенияСвойств.КолонкиОтчетов"));
				
			ИначеЕсли ПолеНастройки.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ВидыОтчетов")) Тогда
				МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.НазначенияСвойств.ВидыОтчетов"));
				
			ИначеЕсли ПолеНастройки.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Организации")) Тогда
				МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.НазначенияСвойств.Организации"));
				
			ИначеЕсли ПолеНастройки.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Субконто")) Тогда
				МассивЗначений.Добавить(ПредопределенноеЗначение("Перечисление.НазначенияСвойств.Субконто"));
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	МассивЗначений = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивЗначений);
	
	СписокТиповСвойств.ЗагрузитьЗначения(МассивЗначений);
	
	Для Каждого СтрокаСписка из СписокТиповСвойств Цикл 
		НайденаяСтрока =  ТекущиеОтметки.НайтиПоЗначению(СтрокаСписка.Значение);
		Если НайденаяСтрока = Неопределено Тогда 
			СтрокаСписка.Пометка = Ложь;
		Иначе 
			СтрокаСписка.Пометка = НайденаяСтрока.Пометка;
		КонецЕсли;
		
	КонецЦикла;	
	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтметкиДоступностиОтбораПоКонтексту()
	Если ТипИсточникаДанных = "ПроизольнаяСхема" Тогда 
		Возврат;
		
	ИначеЕсли ТипИсточникаДанных = "ЭтотОтчет" Тогда  
		
		ТаблицаПолей = Поля.Выгрузить();
		ТаблицаПолей.ЗаполнитьЗначения(Ложь,"ДоступенОтборПоКонтексту");
		Поля.Загрузить(ТаблицаПолей);
		Возврат;
		
	ИначеЕсли ТипИсточникаДанных = "ВсеОтчеты" Тогда  
		
		МассивДоступныхКодов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок("ЭкземплярОтчета,Организация,Период");
		
		ВспомогательныеДанные = ПолучитьИзВременногоХранилища(АдресХранилищаВспомогательныхДанныхПоОтчету);
		ДополнительныеРеквизиты = ВспомогательныеДанные.ДополнительныеРеквизиты;
		КодыДопРеквизитов = ДополнительныеРеквизиты.ВыгрузитьКолонку("Код");
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивДоступныхКодов,КодыДопРеквизитов); 

		Для Каждого ВыбранноеПоле из Поля Цикл
			
			ВыбранноеПоле.ДоступенОтборПоКонтексту = МассивДоступныхКодов.Найти(ВыбранноеПоле.Имя)<> Неопределено;	
			
		КонецЦикла;	
			
		
		
	КонецЕсли;	
	
КонецПроцедуры	



#КонецОбласти





