
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если (Не ЗначениеЗаполнено(Параметры.Проверка) И Не ЗначениеЗаполнено(Параметры.ИдентификаторПроверки))
		Или Не ЗначениеЗаполнено(Параметры.Проблема) Тогда
		// Форма предназначена только для отображения сведений о существующей проблеме.
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Проверка = Параметры.Проверка;
	Если Не ЗначениеЗаполнено(Проверка) Тогда
		Проверка = АудитСостоянияСистемы.ПроверкаПоИдентификатору(Параметры.ИдентификаторПроверки);
	КонецЕсли;
	
	ОписаниеПроблемы.Проверка 		= Проверка;
	ОписаниеПроблемы.Проблема 		= Параметры.Проблема;
	ОписаниеПроблемы.Организация 	= Параметры.Организация;
	
	МенеджерЗаписи = РеквизитФормыВЗначение("ОписаниеПроблемы");
	МенеджерЗаписи.Прочитать();
	
	ЗаполнитьЗначенияСвойств(ОписаниеПроблемы, МенеджерЗаписи);
	
	ПрочитатьОбъектыПроблемы();
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОбъектыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПоказатьЗначение(, Объекты.НайтиПоИдентификатору(ВыбраннаяСтрока).Объект);
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

#КонецОбласти



#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьОбъектыПроблемы()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектыПроблемСостоянияСистемы.Объект
	|ИЗ
	|	РегистрСведений.ОбъектыПроблемСостоянияСистемы КАК ОбъектыПроблемСостоянияСистемы
	|ГДЕ
	|	ОбъектыПроблемСостоянияСистемы.Проверка = &Проверка
	|	И ОбъектыПроблемСостоянияСистемы.Проблема = &Проблема";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Проверка", ОписаниеПроблемы.Проверка);
	Запрос.УстановитьПараметр("Проблема", ОписаниеПроблемы.Проблема);
	
	Объекты.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Объекты.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
