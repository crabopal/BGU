
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Запись.ИсходныйКлючЗаписи.Пустой() Тогда
		ТипПС = Новый Массив;
		ТипПС.Добавить(БухгалтерскийУчетПовтИсп.ТекущийПланСчетов());
		ТипПС = Новый ОписаниеТипов(ТипПС);
		Запись.Счет = ТипПС.ПривестиЗначение(Запись.Счет);
		Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьНесколькоОрганизаций") И НЕ ЗначениеЗаполнено(Запись.Организация) Тогда
			Запись.Организация = ОбщегоНазначенияБГУ.ТекущаяОрганизация();
		КонецЕсли;
	КонецЕсли;	
		
	Элементы.КПС.Доступность = ЗначениеЗаполнено(Запись.Организация) И ЗначениеЗаполнено(Запись.КФО) И ЗначениеЗаполнено(Запись.Счет);
	
	ТипИспользуемыхСчетов = Перечисления.ТипыСчетов.Бухгалтерский;
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Элементы.Организация.ТолькоПросмотр = ЗначениеЗаполнено(Запись.Организация);
	Элементы.КФО.ТолькоПросмотр 		= ЗначениеЗаполнено(Запись.КФО);
	Элементы.Счет.ТолькоПросмотр 		= ЗначениеЗаполнено(Запись.Счет); 
	Элементы.ИФО.ТолькоПросмотр 		= ЗначениеЗаполнено(Запись.ИФО) И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") ;
	
    Элементы.ИФО.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") ИЛИ ЗначениеЗаполнено(Запись.ИФО);  
	Элементы.ИФО.КнопкаОчистки = Элементы.ИФО.Видимость И НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	УстановитьСписокКФО();
	Элементы.КПС.Доступность = ЗначениеЗаполнено(Запись.Организация) И ЗначениеЗаполнено(Запись.КФО) И ЗначениеЗаполнено(Запись.Счет);
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	УстановитьСписокКФО();
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	Элементы.КПС.Доступность = ЗначениеЗаполнено(Запись.Организация) И ЗначениеЗаполнено(Запись.КФО) И ЗначениеЗаполнено(Запись.Счет);
	ПроверитьВидКПС();
КонецПроцедуры

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	Элементы.КПС.Доступность = ЗначениеЗаполнено(Запись.Организация) И ЗначениеЗаполнено(Запись.КФО) И ЗначениеЗаполнено(Запись.Счет);
	ПроверитьВидКПС();
КонецПроцедуры

&НаКлиенте
Процедура СчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("ТипСчета, НеВыбиратьЗабалансовые, ВыбиратьЗапрещенныеВПроводках", ТипИспользуемыхСчетов, Истина, Ложь);
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КПСПриИзменении(Элемент)
	Запись.Период = УстановитьПериод(Запись);
КонецПроцедуры

&НаКлиенте
Процедура КПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
												  	СтандартнаяОбработка,
												  	Запись.КПС,
													Запись.Организация, 
													Запись.ИФО, 
													Запись.КФО, 
													Запись.Счет, 
													?(ЗначениеЗаполнено(Запись.Период), Запись.Период, Неопределено));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Процедура ПолучитьСписокОграниченийКФО(Знач Запись, СписокКФО)
	СписокКФО = БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(Запись.Организация, Запись.ИФО, ?(ЗначениеЗаполнено(Запись.Период), Запись.Период, Неопределено));
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПроверитьКПСПоСчетуИУчетнойПолитике(Знач Запись)
	
	ВидыКПС = ОбщегоНазначенияБГУ.ПолучитьПересечениеМассивов(	БухгалтерскийУчетПовтИсп.ПолучитьДопустимыеВидыКПССчета(Запись.Счет),
																БухгалтерскийУчетПовтИсп.ВидыКПСПоУчетнойПолитике(Запись.Организация, Запись.ИФО, Запись.КФО, ?(ЗначениеЗаполнено(Запись.Период), Запись.Период, Неопределено)));
	
	Если ВидыКПС.Найти(Запись.КПС.ВидПоказателя) = Неопределено Тогда
		Возврат Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	Иначе
		Возврат Запись.КПС;
	КонецЕсли;	
	
КонецФункции	

&НаСервереБезКонтекста
Функция УстановитьПериод(Знач Запись)
	Возврат Макс(НачалоГода(Запись.Период), Запись.КПС.ДатаНачалаДействия);
КонецФункции	
	
&НаКлиенте
Процедура ПроверитьВидКПС()
	
	Если ЗначениеЗаполнено(Запись.КПС) Тогда
		Запись.КПС = ПроверитьКПСПоСчетуИУчетнойПолитике(Запись); 
		Если НЕ ЗначениеЗаполнено(Запись.КПС) Тогда
			Элементы.КПС.ТолькоПросмотр = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры	
	
&НаКлиенте
Процедура УстановитьСписокКФО()
	
	Перем СписокКФО;
	
	ПолучитьСписокОграниченийКФО(Запись, СписокКФО);
	
	Если СписокКФО.Найти(Запись.КФО) = Неопределено Тогда
		Запись.КФО = "";  
		Элементы.КФО.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	ПроверитьВидКПС();

КонецПроцедуры	

#КонецОбласти

