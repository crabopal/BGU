
#Область ОбработчикиСобытийФормы

// Процедура - обработчик события "ПриСозданииНаСервере" формы.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьОрганизацию();
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);   
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Элементы.ИФО.Видимость = Истина;
		Элементы.ФормаОчиститьИФО.Видимость = Ложь;
	Иначе
		ЕстьЗаполненныйИФО = РегистрыСведений.РабочиеСчета.НаличиеИФОВСписке();
		Элементы.ИФО.Видимость = ЕстьЗаполненныйИФО;
		Элементы.ФормаОчиститьИФО.Видимость = ЕстьЗаполненныйИФО И Пользователи.ЭтоПолноправныйПользователь();
	КонецЕсли;

	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));

	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

#КонецОбласти   

#Область ОбработчикиКомандФормы      

&НаКлиенте
Процедура ОчиститьИФО(Команда) 
	
		ТекстВопроса = НСтр("ru = 'Реквизит ""ИФО"" будет очищен во всех рабочих счетах всех организаций без возможности восстановления.
								|Очистить ""ИФО""?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Очистить ""ИФО""'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		Оповещение = Новый ОписаниеОповещения("ОчиститьИФОЗавершение", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Отмена);

КонецПроцедуры 

&НаКлиенте
Процедура ОчиститьИФОЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОчиститьИФОНаСервере();
		Элементы.Список.Обновить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура устанавливает Учреждение в форме по данным переданного отбора.
//
&НаСервере
Процедура УстановитьОрганизацию()
	
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Организация") Тогда
		
		ОтборОрганизация = Параметры.Отбор.Организация;
		Элементы.ОтборОрганизация.ТолькоПросмотр = Истина;
		Элементы.ОтборОрганизация.КнопкаОткрытия = Ложь;

	КонецЕсли;
	
КонецПроцедуры // УстановитьОрганизацию()

&НаСервереБезКонтекста
Процедура ОчиститьИФОНаСервере()
	РегистрыСведений.РабочиеСчета.ОчиститьИФОВРабочихСчетах();
КонецПроцедуры

#КонецОбласти
