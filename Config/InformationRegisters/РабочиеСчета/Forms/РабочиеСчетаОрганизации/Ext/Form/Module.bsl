
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ОбщегоНазначенияБГУ.УстановитьОтборСпискаПоОрганизации(ЭтотОбъект);
	
	Если НЕ ЗначениеЗаполнено(Параметры.НаДату) Тогда
		Параметры.НаДату = ТекущаяДатаСеанса();
	Конецесли;
	
	НаДату = Параметры.НаДату;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Период", НаДату, Истина);
	
	БюджетнаяКлассификация.УстановитьУсловноеОформлениеПоляВидКПСБУАУВСписке(Список, "КПС.ВидПоказателя", "КПС.УточнениеПоказателя");  
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Элементы.СписокИФО.Видимость = Истина;
		Элементы.СписокОчиститьИФО.Видимость = Ложь;
	Иначе
		ЕстьЗаполненныйИФО = РегистрыСведений.РабочиеСчета.НаличиеИФОВСписке();
		Элементы.СписокИФО.Видимость = ЕстьЗаполненныйИФО;
		Элементы.СписокОчиститьИФО.Видимость = ЕстьЗаполненныйИФО И Пользователи.ЭтоПолноправныйПользователь();
	КонецЕсли;
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаДатуПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Период", НаДату, ЗначениеЗаполнено(НаДату));

КонецПроцедуры

#Область ПроцедурыПодсистемыИнформационныйЦентр

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыСписок

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РабочийПланСчетовОрганизации(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	ПараметрыФормы.Вставить("Отбор", СтруктураОтбораДляОтчета());
	ПараметрыФормы.Вставить("КлючВарианта", "ОсновнойКонтекст"); 
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "РабочийПланСчетовОрганизации");
	
	ОткрытьФорму("Отчет.ПечатьРабочегоПланаСчетов.Форма", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьИФО(Команда) 
	
		ТекстВопроса = НСтр("ru = 'Реквизит ""ИФО"" будет очищен во всех рабочих счетах всех организаций без возможности восстановления.
								|Очистить ""ИФО""?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Очистить ""ИФО""'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		Оповещение = Новый ОписаниеОповещения("ОчиститьИФОЗавершение", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Отмена);

КонецПроцедуры 

&НаКлиенте
Процедура ОчиститьИФОЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОчиститьИФОНаСервере(); 
		Элементы.Список.Обновить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СтруктураОтбораДляОтчета()
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Период", НаДату);
	
	Для Каждого ЭлементКомпоновки Из Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		
		Если ТипЗнч(ЭлементКомпоновки) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			
			Если ЭлементКомпоновки.Использование И 
				ЭлементКомпоновки.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно И
				ЭлементКомпоновки.ИдентификаторПользовательскойНастройки = "Организация" Тогда
				СтруктураОтбора.Вставить("Организация", ЭлементКомпоновки.ПравоеЗначение);
			КонецЕсли;	
			
		КонецЕсли;	
		
		Если ТипЗнч(ЭлементКомпоновки) = Тип("ОтборКомпоновкиДанных") Тогда
			
			Для Каждого ЭлементОтбора Из ЭлементКомпоновки.Элементы Цикл
				
				Если ЭлементОтбора.Использование Тогда
					
					Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Актуален") И
						ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
						СтруктураОтбора.Вставить("Актуален", ЭлементОтбора.ПравоеЗначение);
					КонецЕсли;
					
					Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КФО") И
						ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
						СтруктураОтбора.Вставить("КФО", ЭлементОтбора.ПравоеЗначение);
					КонецЕсли;

					Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИФО") И
						ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
						СтруктураОтбора.Вставить("ИФО", ЭлементОтбора.ПравоеЗначение);
					КонецЕсли;
					
					Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("КПС.ВидПоказателя") И
						ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
						СтруктураОтбора.Вставить("ВидКПС", ЭлементОтбора.ПравоеЗначение);
					КонецЕсли;
					
					Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Счет") И
						(ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно ИЛИ
						ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии)	Тогда
						СтруктураОтбора.Вставить("Счет", ЭлементОтбора.ПравоеЗначение);
					КонецЕсли;


				КонецЕсли;	
				
			КонецЦикла;	
			
		КонецЕсли	
		
	Конеццикла;	
	
	Возврат СтруктураОтбора;
	
КонецФункции	

&НаСервереБезКонтекста
Процедура ОчиститьИФОНаСервере()
	РегистрыСведений.РабочиеСчета.ОчиститьИФОВРабочихСчетах();
КонецПроцедуры

#КонецОбласти








