// Проверяет, существует ли в списке рабочих счетов хотя бы один
// с заполненным ИФО
//
Функция НаличиеИФОВСписке() Экспорт 
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	РабочиеСчета.ИФО КАК ИФО
	|ИЗ
	|	РегистрСведений.РабочиеСчета КАК РабочиеСчета
	|ГДЕ
	|	НЕ РабочиеСчета.ИФО = ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");   
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции  

// Очищает реквизит "ИФО" во всех записях регистра "Рабочие счета".
//
Процедура ОчиститьИФОВРабочихСчетах() Экспорт
	
	НачатьТранзакцию();

	Попытка

		БлокировкаДанных = Новый БлокировкаДанных;
		БлокировкаДанных.Добавить("РегистрСведений.РабочиеСчета");
		БлокировкаДанных.Заблокировать();    
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	РабочиеСчета.Период КАК Период,
		|	РабочиеСчета.Организация КАК Организация,
		|	РабочиеСчета.ИФО КАК ИФО,
		|	РабочиеСчета.КФО КАК КФО,
		|	РабочиеСчета.Счет КАК Счет,
		|	РабочиеСчета.КПС КАК КПС,
		|	РабочиеСчета.Актуален КАК Актуален
		|ИЗ
		|	РегистрСведений.РабочиеСчета КАК РабочиеСчета");
		
		ТабРабочихСчетов = Запрос.Выполнить().Выгрузить();
		ТабРабочихСчетов.ЗаполнитьЗначения(ПредопределенноеЗначение("Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка"), "ИФО");
		ТабРабочихСчетов.Свернуть("Период, Организация,ИФО,КФО,Счет,КПС,Актуален");
		
		РабочиеСчета = РегистрыСведений.РабочиеСчета.СоздатьНаборЗаписей();
		РабочиеСчета.Загрузить(ТабРабочихСчетов);
		РабочиеСчета.Записать();

		ЗафиксироватьТранзакцию();
	Исключение
		
		ОтменитьТранзакцию();
		
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Не удалось очистить реквизит ""ИФО"" в рабочих счетах.'",
			ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(
			ИнформацияОбОшибке()));
			
		ВызватьИсключение;
	КонецПопытки;
		
КонецПроцедуры	

#КонецОбласти

#КонецЕсли
