// Вносит запись в регистр сведений по переданным параметрам.
//
// Параметры:
//  ДополнительныеПараметры - Структура - содержит свойства:
//  	* Период	 	- 	Дата
//  	* ТипСообщения	 		 - 	ПеречислениеСсылка.ТипыСообщенийМСД
//  	* Статус				 - 	ПеречислениеСсылка.СтатусыСверкиМСД
//
Процедура ОтразитьСтатусСверки(ДополнительныеПараметры) Экспорт
	
	НоваяЗапись = РегистрыСведений.ЗапросыНаСверкуДанныхМСД.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(НоваяЗапись, ДополнительныеПараметры);
	НоваяЗапись.Записать();	
	
КонецПроцедуры

// Вносит запись об ошибке в регистр сведений по переданным параметрам.
//
// Параметры:
//  ДополнительныеПараметры - Структура - содержит свойства:
//  	* Период	 	- 	Дата
//  	* ТипСообщения	- 	ПеречислениеСсылка.ТипыСообщенийМСД 
//  Текст - Строка - Описание ошибки
//
Процедура ОтразитьСтатусСверкиОшибка(ДополнительныеПараметры, Текст) Экспорт
	
	ДополнительныеПараметры.Вставить("Статус", Перечисления.СтатусыСверкиМСД.ОшибкаСверки);
	ДополнительныеПараметры.Вставить("ОписаниеОшибки", Текст);
	ОтразитьСтатусСверки(ДополнительныеПараметры);
	
КонецПроцедуры

