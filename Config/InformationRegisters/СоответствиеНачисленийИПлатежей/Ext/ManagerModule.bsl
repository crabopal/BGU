// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Платеж.Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

Процедура ОбновитьСуммыНачислений(МассивНачислений) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивНачислений",МассивНачислений);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоответствиеНачисленийИПлатежей.Начисление КАК Начисление,
		|	СоответствиеНачисленийИПлатежей.Платеж КАК Платеж
		|ПОМЕСТИТЬ ДанныеПлатежей
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.БанковскийИдентификаторПлатежаЗаполнен = ИСТИНА
		|	И СоответствиеНачисленийИПлатежей.Начисление В(&МассивНачислений)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеПлатежей.Начисление КАК Начисление,
		|	СУММА(ДанныеПлатежей.Платеж.СуммаДокумента) КАК СуммаПлатежей,
		|	СУММА(ДанныеПлатежей.Платеж.СуммаВозврата) КАК СуммаВозвратов
		|ИЗ
		|	ДанныеПлатежей КАК ДанныеПлатежей
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеПлатежей.Начисление";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СоответствиеОбработанныхНачисление = Новый Соответствие;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СоответствиеОбработанныхНачисление.Вставить(ВыборкаДетальныеЗаписи.Начисление,Истина);
		Запись = РегистрыСведений.СуммаПлатежейПоНачислениям.СоздатьМенеджерЗаписи();
		Запись.Начисление = ВыборкаДетальныеЗаписи.Начисление;
		Запись.СуммаПлатежей = ВыборкаДетальныеЗаписи.СуммаПлатежей;
		Запись.СуммаВозвратов = ВыборкаДетальныеЗаписи.СуммаВозвратов;
		Запись.Записать(Истина);
	КонецЦикла;
	
	Для Каждого ТекНачисление Из МассивНачислений Цикл
		Если СоответствиеОбработанныхНачисление[ТекНачисление] = Истина Тогда
			Продолжить;
		КонецЕсли;
		Запись = РегистрыСведений.СуммаПлатежейПоНачислениям.СоздатьМенеджерЗаписи();
		Запись.Начисление = ТекНачисление;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Удалить();
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ПолучитьСуммуКоличествоПлатежейПоНачислению(Начисление) Экспорт
	
	СтруктураОтвета = Новый Структура("Сумма,Количество",0,0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(ЕСТЬNULL(СоответствиеНачисленийИПлатежей.Платеж.СуммаДокумента, 0) - ЕСТЬNULL(СоответствиеНачисленийИПлатежей.Платеж.СуммаВозврата, 0)), 0) КАК Сумма,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СоответствиеНачисленийИПлатежей.Платеж) КАК Количество
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Начисление = &Начисление
		|	И СоответствиеНачисленийИПлатежей.Платеж.ПометкаУдаления = ЛОЖЬ
		|	И СоответствиеНачисленийИПлатежей.Платеж.БанковскийИдентификаторПлатежаЗаполнен";

	Запрос.УстановитьПараметр("Начисление", Начисление);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураОтвета,ВыборкаДетальныеЗаписи);
	КонецЕсли;

	Возврат СтруктураОтвета;
			
КонецФункции

Функция ПолучитьНачислениеПоПлатежу(Платеж) Экспорт
	
	Начисление = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоответствиеНачисленийИПлатежей.Начисление
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Платеж = &Платеж";

	Запрос.УстановитьПараметр("Платеж", Платеж);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Начисление = ВыборкаДетальныеЗаписи.Начисление;
	КонецЕсли;

	Возврат Начисление;
			
КонецФункции

Процедура ЗаполнитьРеквизитРС() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоответствиеНачисленийИПлатежей.Платеж КАК Платеж,
		|	СоответствиеНачисленийИПлатежей.Начисление КАК Начисление,
		|	СоответствиеНачисленийИПлатежей.БанковскийИдентификаторПлатежаЗаполнен КАК БанковскийИдентификаторПлатежаЗаполнен
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.БанковскийИдентификаторПлатежаЗаполнен = ЛОЖЬ
		|	И ПОДСТРОКА(СоответствиеНачисленийИПлатежей.Платеж.БанковскийИдентификаторПлатежа, 2, 1) <> """"";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Запись = РегистрыСведений.СоответствиеНачисленийИПлатежей.СоздатьМенеджерЗаписи();
		Запись.Платеж = ВыборкаДетальныеЗаписи.Платеж;
		Запись.Начисление = ВыборкаДетальныеЗаписи.Начисление;
		Запись.БанковскийИдентификаторПлатежаЗаполнен = Истина;
		Запись.Записать(Истина);
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#КонецЕсли