#Область СлужебныйПрограммныйИнтерфейс

// Структура - описание данных для записи в регистр Операциидокументов.
// 
// Параметры:
// 	Документ - ДокументСсылка -
// Возвращаемое значение:
// 	Структура - Описание:
// * Документ - ДокументСсылка, Неопределено - документ, 
// * Операция - СправочникСсылка.ТиповыеОперации - типовая операция,
// * Дата - Дата - дата бух. операции,
// * Организация - СправочникСсылка.Организации - организация бух. операции,
// * Курс - Число - курс валюты бух. операции,
// * Кратность - Число - кратность валюты бух. операции,
// * СуммаОперации - Число - сумма бух. операции,
// * РучнаяКорректировка - Булево - признак ручной корректировки (по умолчанию Ложь),
// * ДокументСторнирован - Булево - по документу введен документ Сторно (по умолчанию Ложь),
// * ЕстьПроводки - Булево - по документу сформированы проводки (по умолчанию Ложь),
// * ИсправлениеОшибки - ПеречислениеСсылка.ПорядокИсправленияОшибокПрошлыхЛет - признак исправления ошибки (по умолчанию НеОшибка).
// * ВыявительОшибки - ПеречислениеСсылка.ВыявительОшибокПрошлыхЛет - 
// * ПричинаОшибки - СправочникСсылка.ПричиныОшибокПрошлыхЛет -
// * ОтветственныйИсполнитель - СправочникСсылка.Сотрудники
//
Функция ДанныеДляЗаписи(Документ = Неопределено) Экспорт
	
	Данные = Новый Структура;
	
	Данные.Вставить("Документ",            Документ);
	Данные.Вставить("Операция",            Справочники.ТиповыеОперации.ПустаяСсылка());
	Данные.Вставить("Дата",                '00010101');
	Данные.Вставить("Организация",         Справочники.Организации.ПустаяСсылка());
	Данные.Вставить("Курс",                1);
	Данные.Вставить("Кратность",           1);
	Данные.Вставить("СуммаОперации",       0);
	Данные.Вставить("РучнаяКорректировка", Ложь);
	Данные.Вставить("ДокументСторнирован", Ложь);
	Данные.Вставить("ЕстьПроводки",        Ложь);
	Данные.Вставить("ИсправлениеОшибки",   Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка);
	Данные.Вставить("ВыявительОшибки",     Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка());
	Данные.Вставить("ПричинаОшибки",       Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка());
	Данные.Вставить("ОтветственныйИсполнитель", Справочники.Сотрудники.ПустаяСсылка());
	
	Возврат Данные;
	
КонецФункции

// Записывает в регистр сведений ОперацииДокументов данные типовой операции.
// Если в структуре Данные не заполнен ключ Операция, то данные по документу удаляются (очищается используемая операция).
// 
// Параметры:
// 	Документ - ДокументСсылка - документ.
// 	Данные - Структура - данные операции.(См. РегистрыСведений.ОперацииДокументов.ДанныеДляЗаписи)
// 	Замещать - Булево - Передается в стандартный параметр метода Записать() набора записей регистра сведений.
// 	РегистрироватьНаУзлахПлановОбмена - Булево -
//
Процедура ЗаписатьОперацию(Документ, Данные, Замещать = Неопределено, Знач РегистрироватьНаУзлахПлановОбмена = Истина) Экспорт

	ЕстьДанныеДляЗаписи = ЗначениеЗаполнено(Данные.Операция) Или Данные.РучнаяКорректировка;
	ЗаписанныеДанные = ПрочитатьОперацию(Документ);
	ЕстьЗаписанныеДанные = ЗначениеЗаполнено(ЗаписанныеДанные.Документ);
	
	Если ЕстьДанныеДляЗаписи Тогда
		УстановитьЗначенияИсправленияОшибок(Данные);
	КонецЕсли;
	
	РежимЗаписиЭтогоНабора = Неопределено;
	Если ТипЗнч(Замещать) = Тип("Булево") Или ТипЗнч(Замещать) = Тип("РежимЗамещения") Тогда
		РежимЗаписиЭтогоНабора = Замещать;
	Иначе
		Если ЕстьЗаписанныеДанные Тогда
			Если ЕстьДанныеДляЗаписи Тогда
				Если НаборИзменился(Данные, ЗаписанныеДанные) Тогда
					РежимЗаписиЭтогоНабора = РежимЗамещения.Обновление;
				КонецЕсли;
			Иначе
				РежимЗаписиЭтогоНабора = РежимЗамещения.Удаление;
			КонецЕсли;
		Иначе
			Если ЕстьДанныеДляЗаписи Тогда
				РежимЗаписиЭтогоНабора = РежимЗамещения.Добавление;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если РежимЗаписиЭтогоНабора = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(Документ);
	
	НоваяЗапись = НаборЗаписей.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяЗапись, Данные);
	// В переменной Данные может быть не заполнен Документ.
	// Если набор записывается в режиме Удаление, нужно обязательно заполнять измерения регистра.
	НоваяЗапись.Документ = Документ;
	
	Если Не РегистрироватьНаУзлахПлановОбмена Тогда
		НаборЗаписей.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
		НаборЗаписей.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
	КонецЕсли;
	
	НаборЗаписей.Записать(РежимЗаписиЭтогоНабора);
	
КонецПроцедуры

// Возвращает структуру, содержащую значения запись регистра для документа.
// Если запись, отсутствует, то структура содержит значения данных типов по умолчанию
// 
// Параметры:
// 	Документ - ДокументСсылка - документ, операцию которого нужно прочитать
// Возвращаемое значение:
// 	см. ДанныеДляЗаписи
Функция ПрочитатьОперацию(Документ) Экспорт

	ТиповаяОперацияЗапись = СоздатьМенеджерЗаписи();
	Если ДокументПроводитсяПоРегиструБухгалтерии(Документ) Тогда
		ТиповаяОперацияЗапись.Документ = Документ;
		ТиповаяОперацияЗапись.Прочитать();
	КонецЕсли;

	ДанныеРегистра = ДанныеДляЗаписи();
	ЗаполнитьЗначенияСвойств(ДанныеРегистра, ТиповаяОперацияЗапись);
	
	Возврат ДанныеРегистра;
	
КонецФункции

// Дописывает в запись регистра ОперацииДокументов реквизиты СуммаОперации и ЕстьПроводки при записи набора проводок РБ.
//
// Параметры:
//  Документ		 - ДокументСсылка - Документ.
//  СуммаОперации	 - Число - сумма операции.
//  ЕстьПроводки	 - Булево - признак наличия проводок.
//
Процедура ЗаписатьДанныеОперации(Документ, СуммаОперации, ЕстьПроводки) Экспорт

	ДанныеДляЗаписи = ПрочитатьОперацию(Документ);
	
	Если Не ЗначениеЗаполнено(ДанныеДляЗаписи.Документ) Тогда
		// Такой записи в базе нет
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	Если ДанныеДляЗаписи.СуммаОперации <> СуммаОперации Тогда
		ДанныеДляЗаписи.СуммаОперации = СуммаОперации;
		Модифицированность = Истина;
	КонецЕсли;
	
	Если ДанныеДляЗаписи.ЕстьПроводки <> ЕстьПроводки Тогда
		ДанныеДляЗаписи.ЕстьПроводки = ЕстьПроводки;
		Модифицированность = Истина;
	КонецЕсли;
	
	Если Модифицированность Тогда
		ЗаписатьОперацию(Документ, ДанныеДляЗаписи);
	КонецЕсли;

КонецПроцедуры

// Устанавливает значение реквизита РучнаяКорректировка в ЛОЖЬ при отмене проведения
// Параметры:
//  Документ		 - ДокументСсылка
//
Процедура ОбновитьЗаписьПриОтменеПроведения(Документ) Экспорт
	
	ДанныеДляЗаписи = ПрочитатьОперацию(Документ);
	
	Если ЗначениеЗаполнено(ДанныеДляЗаписи.Операция) И ДанныеДляЗаписи.РучнаяКорректировка Тогда
		ДанныеДляЗаписи.РучнаяКорректировка = Ложь;
		ЗаписатьОперацию(Документ, ДанныеДляЗаписи);
	КонецЕсли;

КонецПроцедуры

#Область УстаревшиеПроцедурыИФункции

// Устарела. См. ПрочитатьОперацию()
// Возвращает структуру, содержащую значения записи для документа.
// Если запись, отсутствует, то структура содержит значения данных типов по умолчанию
// 
// Параметры:
//  Документ		 - ДокументСсылка
//
// Возвращаемое значение:
// 	см. ДанныеДляЗаписи
Функция ЗначенияРеквизитовОперации(Документ) Экспорт

	Возврат ПрочитатьОперацию(Документ);

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сравнивает 2 набора данных для записи
// 
// Параметры:
//  СтарыеДанные - см. ДанныеДляЗаписи 
//  НовыеДанные - см. ДанныеДляЗаписи
// 
// Возвращаемое значение:
//	Булево  
Функция НаборИзменился(СтарыеДанные, НовыеДанные)
	Для Каждого КлючИЗначение Из СтарыеДанные Цикл
		Если КлючИЗначение.Ключ <> "Документ" Тогда
			ЗначениеКлюча = Неопределено;
			НовыеДанные.Свойство(КлючИЗначение.Ключ, ЗначениеКлюча);
			Если КлючИЗначение.Значение <> ЗначениеКлюча Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура УстановитьЗначенияИсправленияОшибок(НоваяЗапись)
	Если НоваяЗапись.ИсправлениеОшибки <> Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода
			И НоваяЗапись.ИсправлениеОшибки <> Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода Тогда
		НоваяЗапись.ВыявительОшибки = Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка();
	КонецЕсли;
	Если НоваяЗапись.ВыявительОшибки <> Перечисления.ВыявительОшибокПрошлыхЛет.Самостоятельно Тогда
		НоваяЗапись.ПричинаОшибки = Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка();
	КонецЕсли; 
КонецПроцедуры

// Документ проводится по регистру бухгалтерии.
// 
// Параметры:
//  Документ - ДокументСсылка, ДокументОбъект - Документ
// 
// Возвращаемое значение:
//  Булево - Документ проводится по регистру бухгалтерии
Функция ДокументПроводитсяПоРегиструБухгалтерии(Документ)
	
	ЭтоСсылка = Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Документ)); 

	Если ЭтоСсылка Тогда
		Возврат Документ.Метаданные().Движения.Содержит(Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ);
	Иначе
		Возврат Документ.Движения.Найти("ЖурналПроводокЕПСБУ") <> Неопределено;
	КонецЕсли;
		
КонецФункции

#Область ОбновлениеИнформационнойБазы

// Регистрирует данные к обновлению в плане обмена ОбновлениеИнформационнойБазы.
//
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = "РегистрСведений.ОперацииДокументов";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЖурналПроводокЕПСБУ.Регистратор КАК Документ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ЖурналПроводокЕПСБУ.Регистратор = ОперацииДокументов.Документ
	|ГДЕ
	|	ОперацииДокументов.Документ ЕСТЬ NULL
	|	И НЕ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ОперацияБух
	|	И НЕ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.Сторно
	|	И НЕ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ВводНачальныхОстатков
	|	И НЕ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ЗакрытиеГодаТехнологическое
	|	И НЕ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ЗакрытиеГодаТехнологическоеГрупповое
	|	И НЕ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ФормированиеОстатковПоРасчетам
	|	И НЕ ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ.ЗакрытиеОстатковПоЖурналамСлужебный";
	
	Выборка = Запрос.Выполнить().Выбрать();
	ТаблицаРегистрации = СоздатьНаборЗаписей().ВыгрузитьКолонки("Документ");
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаРегистрации.Добавить(), Выборка);
		Счетчик = Счетчик + 1;
		Если Счетчик = 1000 Тогда
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ТаблицаРегистрации, ДополнительныеПараметры);
			Счетчик = 0;
			ТаблицаРегистрации.Очистить();
		КонецЕсли;
	КонецЦикла;

	Если Счетчик > 0 Тогда
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ТаблицаРегистрации, ДополнительныеПараметры);
	КонецЕсли;

КонецПроцедуры

// Обрабатывает данные, зарегистрированные в плане обмена ОбновлениеИнформационнойБазы.
//
// Параметры:
//  Параметры - Структура
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "РегистрСведений.ОперацииДокументов";
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьИзмеренияНезависимогоРегистраСведенийДляОбработки(
		Параметры.Очередь, ПолноеИмяОбъекта);
	КоличествоУспешных = 0;
	КоличествоОшибок = 0;

	ОбрабатываемыеДанные = Новый ТаблицаЗначений;
	ОбрабатываемыеДанные.Колонки.Добавить("Документ");

	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = ПолноеИмяОбъекта;
		
	Пока Выборка.Следующий() Цикл
		
		ОбрабатываемыеДанные.Очистить();
		ОбрабатываемыеДанные.Добавить().Документ = Выборка.Документ;
		
		Если ЗаписатьТиповуюОперациюПриОбновленииЕслиНеСуществует(ОбрабатываемыеДанные, ДополнительныеПараметры) Тогда
			КоличествоУспешных = КоличествоУспешных + 1;
		Иначе
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Выполнена порция обработчика обновления ""РегистрыСведений.ОперацииДокументов.ОбработатьДанныеДляПереходаНаНовуюВерсию""
				   |Обработано: %1,
				   |Ошибок: %2'"),
		КоличествоУспешных, КоличествоОшибок);
	ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
		УровеньЖурналаРегистрации.Информация,
		Метаданные.РегистрыСведений.ОперацииДокументов,
		,
		ТекстСообщения);
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта);
	
КонецПроцедуры

Функция ЗаписатьТиповуюОперациюПриОбновленииЕслиНеСуществует(ОбрабатываемыеДанные, ДополнительныеПараметры)
	
	Документ = ОбрабатываемыеДанные[0].Документ; // ДокументСсылка
	
	// Если в конфигурации есть расширение, в котором добавлены документы, формирующие проводки без использования ТиповыхОпераций
	// и не переопределен тип изменения Документ, то в таблице изменений будет запись в которой Документ = Неопределено.
	// Такие документы обрабатывать не нужно.
	Если Документ = Неопределено Тогда
		ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ОбрабатываемыеДанные, ДополнительныеПараметры); 
		Возврат Истина;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		ПредставлениеСсылки = Строка(Документ);
		
		// На время выполнения блокируется документ и проводки
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(Документ.Метаданные().ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Документ);
		ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ.НаборЗаписей");
		ЭлементБлокировки.УстановитьЗначение("Регистратор", Документ);
		Блокировка.Заблокировать();
		
		Проводки = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
		Проводки.Отбор.Регистратор.Установить(Документ);
		Проводки.Прочитать();
		
		// За время работы обработчика ручные проводки могли быть удалены.
		// В этом случае не нужно делать запись в регистр.
		Если Проводки.Количество() > 0 Тогда
			ДанныеОперации = ПрочитатьОперацию(Документ);
			// За время работы обработчика проводки могли быть записаны повторно
			// и в регистре уже есть запись.
			Если Не ЗначениеЗаполнено(ДанныеОперации.Документ) Тогда 
				ДанныеОперации.Документ = Документ;
				ДанныеОперации.Дата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Дата");
				ДанныеОперации.СуммаОперации = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ
					.СуммаПроводокПоНастройкамПоУмолчанию(Проводки);
				ДанныеОперации.ЕстьПроводки = Истина;
				ДанныеОперации.РучнаяКорректировка = Истина;
				ЗаписатьОперацию(Документ, ДанныеОперации, РежимЗамещения.Добавление);
			КонецЕсли;
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ОбрабатываемыеДанные, ДополнительныеПараметры); 
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ОбновлениеИнформационнойБазы.ЗаписатьОшибкуВЖурналРегистрации(
			Метаданные.РегистрыСведений.ОперацииДокументов,
			ПредставлениеСсылки,
			ИнформацияОбОшибке());

		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
