
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Организация 	= Параметры.Организация;
	ВидОбщихЗатрат	= Параметры.ВидОбщихЗатрат;
	НаДату 			= Параметры.НаДату;
	
	Если НЕ ЗначениеЗаполнено(Организация) ИЛИ НЕ ЗначениеЗаполнено(ВидОбщихЗатрат) Тогда
		ВызватьИсключение НСтр("ru = 'Ввод и редактирование методов распределения косвенных затрат производится из
									|списка методов распределения в регистре ""Учетная политика организаций""'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	НаДату = КонецМесяца(НаДату);
	
	ЗаполнитьТекущиеМетодыРаспределения();
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТекущиеМетодыРаспределения()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МетодыРаспределенияКосвенныхЗатратОрганизацийСрезПоследних.КФО,
	               |	МетодыРаспределенияКосвенныхЗатратОрганизацийСрезПоследних.ИФО,
	               |	МетодыРаспределенияКосвенныхЗатратОрганизацийСрезПоследних.БазаРаспределения,
	               |	МетодыРаспределенияКосвенныхЗатратОрганизацийСрезПоследних.ОсновнаяБаза,
	               |	МетодыРаспределенияКосвенныхЗатратОрганизацийСрезПоследних.ВключатьВБазуОплатаТрудаКЭК212,
	               |	МетодыРаспределенияКосвенныхЗатратОрганизацийСрезПоследних.ВключатьВБазуОплатаТрудаКЭК213,
	               |	МетодыРаспределенияКосвенныхЗатратОрганизацийСрезПоследних.ВключатьВБазуОплатаТрудаКЭК214
	               |ИЗ
	               |	РегистрСведений.МетодыРаспределенияКосвенныхЗатратОрганизаций.СрезПоследних(
	               |			&НаДату,
	               |			Организация = &Организация
	               |				И ВидОбщихЗатратНаПроизводство = &ВидОбщихЗатратНаПроизводство) КАК МетодыРаспределенияКосвенныхЗатратОрганизацийСрезПоследних
	               |ГДЕ
	               |	МетодыРаспределенияКосвенныхЗатратОрганизацийСрезПоследних.НеДействует = ЛОЖЬ";
	Запрос.УстановитьПараметр("Организация", 					Организация);
	Запрос.УстановитьПараметр("ВидОбщихЗатратНаПроизводство",	ВидОбщихЗатрат);
	
	НастройкаБазыРаспределения.Очистить();
	ОсновнаяБазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.ПустаяСсылка();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		Если Выборка.ОсновнаяБаза Тогда
			ОсновнаяБазаРаспределения = Выборка.БазаРаспределения;
		Иначе
			ЗаполнитьЗначенияСвойств(НастройкаБазыРаспределения.Добавить(), Выборка);	
		КонецЕсли;
	
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти
