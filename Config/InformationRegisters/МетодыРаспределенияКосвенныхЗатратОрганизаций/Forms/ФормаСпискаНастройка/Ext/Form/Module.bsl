
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтборОрганизация = Параметры.Организация;
	ЗаполнитьТаблицыМетодовРаспределения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УстановитьОтборРасширеннойНастрокиОПЗ(Элементы.ДатыИзмененияОПЗ, Элементы.РасширеннаяНастройкаОПЗ);
	УстановитьОтборРасширеннойНастрокиОПЗ(Элементы.ДатыИзмененияОХЗ, Элементы.РасширеннаяНастройкаОХЗ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ИзменениеМетодовРаспределенияКосвенныхЗатрат" Тогда
		ЗаполнитьТаблицыМетодовРаспределения();
	КонецЕсли;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ ДатыИзмененияОПЗ

&НаКлиенте
Процедура ДатыИзмененияОПЗПриАктивизацииСтроки(Элемент)
	УстановитьОтборРасширеннойНастрокиОПЗ(Элементы.ДатыИзмененияОПЗ, Элементы.РасширеннаяНастройкаОПЗ);
КонецПроцедуры

&НаКлиенте
Процедура ДатыИзмененияОПЗПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", ОтборОрганизация);
	ПараметрыФормы.Вставить("ВидОбщихЗатратНаПроизводство",	ПредопределенноеЗначение("Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты"));
	ОткрытьФорму("РегистрСведений.МетодыРаспределенияКосвенныхЗатратОрганизаций.Форма.ФормаЗаписиНастройка", ПараметрыФормы);
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДатыИзмененияОПЗПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	ТекущиеДанные = Элементы.ДатыИзмененияОПЗ.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КОнецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", ОтборОрганизация);
	ПараметрыФормы.Вставить("ВидОбщихЗатратНаПроизводство",	ПредопределенноеЗначение("Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты"));
	ПараметрыФормы.Вставить("Период", ТекущиеДанные.Период);
	ПараметрыФормы.Вставить("ВключатьВБазуОплатаТрудаКЭК212", ТекущиеДанные.ВключатьВБазуОплатаТрудаКЭК212);
	ПараметрыФормы.Вставить("ВключатьВБазуОплатаТрудаКЭК213", ТекущиеДанные.ВключатьВБазуОплатаТрудаКЭК213);
	ПараметрыФормы.Вставить("ВключатьВБазуОплатаТрудаКЭК214", ТекущиеДанные.ВключатьВБазуОплатаТрудаКЭК214);
	ОткрытьФорму("РегистрСведений.МетодыРаспределенияКосвенныхЗатратОрганизаций.Форма.ФормаЗаписиНастройка", ПараметрыФормы);
КонецПроцедуры

&НаКлиенте
Процедура ДатыИзмененияОПЗПередУдалением(Элемент, Отказ)
	ТекущиеДанные = Элементы.ДатыИзмененияОПЗ.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыУдаления = Новый Структура;
	ПараметрыУдаления.Вставить("ВидОбщихЗатратНаПроизводство",	ПредопределенноеЗначение("Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты"));
	ПараметрыУдаления.Вставить("Период", ТекущиеДанные.Период);
	УдалитьЗаписиРегистра(ПараметрыУдаления);
	Отказ = Истина;
	ЗаполнитьТаблицыМетодовРаспределения();
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ ДатыИзмененияОПЗ

&НаКлиенте
Процедура ДатыИзмененияОХЗПриАктивизацииСтроки(Элемент)
	УстановитьОтборРасширеннойНастрокиОПЗ(Элементы.ДатыИзмененияОХЗ, Элементы.РасширеннаяНастройкаОХЗ);
КонецПроцедуры

&НаКлиенте
Процедура ДатыИзмененияОХЗПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", ОтборОрганизация);
	ПараметрыФормы.Вставить("ВидОбщихЗатратНаПроизводство",	ПредопределенноеЗначение("Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты"));
	ОткрытьФорму("РегистрСведений.МетодыРаспределенияКосвенныхЗатратОрганизаций.Форма.ФормаЗаписиНастройка", ПараметрыФормы);
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДатыИзмененияОХЗПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	ТекущиеДанные = Элементы.ДатыИзмененияОХЗ.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", ОтборОрганизация);
	ПараметрыФормы.Вставить("ВидОбщихЗатратНаПроизводство",	ПредопределенноеЗначение("Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты"));
	ПараметрыФормы.Вставить("Период", ТекущиеДанные.Период);
	ОткрытьФорму("РегистрСведений.МетодыРаспределенияКосвенныхЗатратОрганизаций.Форма.ФормаЗаписиНастройка", ПараметрыФормы);
КонецПроцедуры

&НаКлиенте
Процедура ДатыИзмененияОХЗПередУдалением(Элемент, Отказ)
	ТекущиеДанные = Элементы.ДатыИзмененияОХЗ.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыУдаления = Новый Структура;
	ПараметрыУдаления.Вставить("ВидОбщихЗатратНаПроизводство",	ПредопределенноеЗначение("Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты"));
	ПараметрыУдаления.Вставить("Период", ТекущиеДанные.Период);
	УдалитьЗаписиРегистра(ПараметрыУдаления);
	Отказ = Истина;
	ЗаполнитьТаблицыМетодовРаспределения();
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ЗаполнитьТаблицыМетодовРаспределения()

	ДатыИзмененияОПЗ.Очистить();
	ДатыИзмененияОХЗ.Очистить();
	РасширеннаяНастройкаОПЗ.Очистить();
	РасширеннаяНастройкаОХЗ.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МетодыРаспределенияКосвенныхЗатратОрганизаций.Период,
	|	МетодыРаспределенияКосвенныхЗатратОрганизаций.Организация,
	|	МетодыРаспределенияКосвенныхЗатратОрганизаций.ВидОбщихЗатратНаПроизводство,
	|	МетодыРаспределенияКосвенныхЗатратОрганизаций.КФО,
	|	МетодыРаспределенияКосвенныхЗатратОрганизаций.ИФО,
	|	МетодыРаспределенияКосвенныхЗатратОрганизаций.БазаРаспределения,
	|	МетодыРаспределенияКосвенныхЗатратОрганизаций.ОсновнаяБаза,
	|	МетодыРаспределенияКосвенныхЗатратОрганизаций.НеДействует,
	|	МетодыРаспределенияКосвенныхЗатратОрганизаций.ВключатьВБазуОплатаТрудаКЭК212,
	|	МетодыРаспределенияКосвенныхЗатратОрганизаций.ВключатьВБазуОплатаТрудаКЭК213,
	|	МетодыРаспределенияКосвенныхЗатратОрганизаций.ВключатьВБазуОплатаТрудаКЭК214
	|ПОМЕСТИТЬ МетодыРаспределения
	|ИЗ
	|	РегистрСведений.МетодыРаспределенияКосвенныхЗатратОрганизаций КАК МетодыРаспределенияКосвенныхЗатратОрганизаций
	|ГДЕ
	|	МетодыРаспределенияКосвенныхЗатратОрганизаций.Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МетодыРаспределения.Организация,
	|	МетодыРаспределения.ВидОбщихЗатратНаПроизводство,
	|	МетодыРаспределения.Период
	|ПОМЕСТИТЬ ПериодыИзменения
	|ИЗ
	|	МетодыРаспределения КАК МетодыРаспределения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПериодыИзменения.Организация,
	|	ПериодыИзменения.ВидОбщихЗатратНаПроизводство,
	|	ПериодыИзменения.Период,
	|	МАКСИМУМ(МетодыРаспределения.Период) КАК НачалоДействия,
	|	МетодыРаспределения.КФО,
	|	МетодыРаспределения.ИФО
	|ПОМЕСТИТЬ МетодыРаспределенияСПериодами
	|ИЗ
	|	ПериодыИзменения КАК ПериодыИзменения,
	|	МетодыРаспределения КАК МетодыРаспределения
	|ГДЕ
	|	МетодыРаспределения.Организация = ПериодыИзменения.Организация
	|	И МетодыРаспределения.ВидОбщихЗатратНаПроизводство = ПериодыИзменения.ВидОбщихЗатратНаПроизводство
	|	И ПериодыИзменения.Период >= МетодыРаспределения.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	ПериодыИзменения.Организация,
	|	ПериодыИзменения.ВидОбщихЗатратНаПроизводство,
	|	ПериодыИзменения.Период,
	|	МетодыРаспределения.КФО,
	|	МетодыРаспределения.ИФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МетодыРаспределенияСПериодами.Организация,
	|	МетодыРаспределенияСПериодами.ВидОбщихЗатратНаПроизводство КАК ВидОбщихЗатратНаПроизводство,
	|	МетодыРаспределенияСПериодами.Период КАК Период,
	|	МетодыРаспределенияСПериодами.НачалоДействия,
	|	МетодыРаспределенияСПериодами.КФО,
	|	МетодыРаспределенияСПериодами.ИФО,
	|	МетодыРаспределения.БазаРаспределения,
	|	МетодыРаспределения.ОсновнаяБаза,
	|	МетодыРаспределения.ВключатьВБазуОплатаТрудаКЭК212,
	|	МетодыРаспределения.ВключатьВБазуОплатаТрудаКЭК213,
	|	МетодыРаспределения.ВключатьВБазуОплатаТрудаКЭК214
	|ИЗ
	|	МетодыРаспределенияСПериодами КАК МетодыРаспределенияСПериодами
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МетодыРаспределения КАК МетодыРаспределения
	|		ПО МетодыРаспределенияСПериодами.Организация = МетодыРаспределения.Организация
	|			И МетодыРаспределенияСПериодами.ВидОбщихЗатратНаПроизводство = МетодыРаспределения.ВидОбщихЗатратНаПроизводство
	|			И МетодыРаспределенияСПериодами.НачалоДействия = МетодыРаспределения.Период
	|			И МетодыРаспределенияСПериодами.КФО = МетодыРаспределения.КФО
	|			И МетодыРаспределенияСПериодами.ИФО = МетодыРаспределения.ИФО
	|ГДЕ
	|	МетодыРаспределения.НеДействует = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидОбщихЗатратНаПроизводство,
	|	Период УБЫВ
	|ИТОГИ ПО
	|	ВидОбщихЗатратНаПроизводство,
	|	Период";
	
	Запрос.УстановитьПараметр("Организация", ОтборОрганизация);
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
	
		Если Выборка.ВидОбщихЗатратНаПроизводство = Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты Тогда
			ДатыИзменения			= ДатыИзмененияОПЗ;
			РасширеннаяНастройка	= РасширеннаяНастройкаОПЗ;
		Иначе
			ДатыИзменения			= ДатыИзмененияОХЗ;
			РасширеннаяНастройка	= РасширеннаяНастройкаОХЗ;
		КонецЕсли;
		
		ВыборкаПериоды = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Если ВыборкаПериоды.Количество() > 0 Тогда
			Пока ВыборкаПериоды.Следующий() Цикл
				СтрокаПериода = ДатыИзменения.Добавить();
				СтрокаПериода.Период = ВыборкаПериоды.Период;
				ВыборкаДетальная = ВыборкаПериоды.Выбрать(ОбходРезультатаЗапроса.Прямой);
				Пока ВыборкаДетальная.Следующий() Цикл
					Если ВыборкаДетальная.ОсновнаяБаза Тогда
						СтрокаПериода.БазаРаспределения = ВыборкаДетальная.БазаРаспределения;
						СтрокаПериода.ВключатьВБазуОплатаТрудаКЭК212 = ВыборкаДетальная.ВключатьВБазуОплатаТрудаКЭК212;
						СтрокаПериода.ВключатьВБазуОплатаТрудаКЭК213 = ВыборкаДетальная.ВключатьВБазуОплатаТрудаКЭК213;
						СтрокаПериода.ВключатьВБазуОплатаТрудаКЭК214 = ВыборкаДетальная.ВключатьВБазуОплатаТрудаКЭК214;
					Иначе
						СтрокаДетальная = РасширеннаяНастройка.Добавить();
						СтрокаДетальная.Период				= ВыборкаДетальная.Период;
						СтрокаДетальная.ИФО					= ВыборкаДетальная.ИФО;
						СтрокаДетальная.КФО					= ВыборкаДетальная.КФО;
						СтрокаДетальная.БазаРаспределения	= ВыборкаДетальная.БазаРаспределения;
						СтрокаДетальная.ВключатьВБазуОплатаТрудаКЭК212 = ВыборкаДетальная.ВключатьВБазуОплатаТрудаКЭК212;
						СтрокаДетальная.ВключатьВБазуОплатаТрудаКЭК213 = ВыборкаДетальная.ВключатьВБазуОплатаТрудаКЭК213;
						СтрокаДетальная.ВключатьВБазуОплатаТрудаКЭК214 = ВыборкаДетальная.ВключатьВБазуОплатаТрудаКЭК214;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборРасширеннойНастрокиОПЗ(ДатыИзменения, РасширеннаяНастройка)

	ТекущиеДанные = ДатыИзменения.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Отбор = Новый Структура("Период", ТекущиеДанные.Период);
	Иначе
		Отбор = Новый Структура("Период", Дата("00010101"));
	КонецЕсли;
	
	РасширеннаяНастройка.ОтборСтрок = Новый ФиксированнаяСтруктура(Отбор);

КонецПроцедуры // УстановитьОтборРасширеннойНастрокиОПЗ()

&НаСервере
Процедура УдалитьЗаписиРегистра(ПараметрыУдаления)

	НаборЗаписей = РегистрыСведений.МетодыРаспределенияКосвенныхЗатратОрганизаций.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(ПараметрыУдаления.Период);
	НаборЗаписей.Отбор.ВидОбщихЗатратНаПроизводство.Установить(ПараметрыУдаления.ВидОбщихЗатратНаПроизводство);
	НаборЗаписей.Отбор.Организация.Установить(ОтборОрганизация);
	НаборЗаписей.Записать(Истина);

КонецПроцедуры // УдалитьЗаписиРегистра()
 