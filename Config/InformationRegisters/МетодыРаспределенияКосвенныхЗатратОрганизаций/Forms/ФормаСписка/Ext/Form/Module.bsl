
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ Параметры.Отбор.Свойство("Организация", ОтборОрганизация) Тогда
		Если Параметры.Свойство("Организация", ОтборОрганизация) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
																 "Организация",
																 ОтборОрганизация,
																 ,
																 ,
																 ЗначениеЗаполнено(ОтборОрганизация));	
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
		
		Элементы.ОтборОрганизация.ТолькоПросмотр = Истина;
		Элементы.ОтборОрганизация.РедактированиеТекста = Ложь;
		Элементы.ОтборОрганизация.КнопкаОткрытия = Ложь;
		
	КонецЕсли;
	
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
КонецПроцедуры

#КонецОбласти