Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.Регистратор
	|ИЗ
	|	РегистрСведений.ЖурналУчетаКомпенсацииРодительскойПлаты КАК ЖурналУчетаКомпенсацииРодительскойПлаты
	|ГДЕ
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.ПроцентКомпенсации = &ПроцентКомпенсации";
	Запрос.УстановитьПараметр("ПроцентКомпенсации", 99);

	ОбновлениеИнформационнойБазы.ОтметитьРегистраторыКОбработке(
		Параметры,
		Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор"),
		"РегистрСведений.ЖурналУчетаКомпенсацииРодительскойПлаты");

КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяРегистра = "РегистрСведений.ЖурналУчетаКомпенсацииРодительскойПлаты";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ВыбиратьПорциями = Ложь;
	
	РезультатВыборки = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуРегистраторовРегистраДляОбработки(
		Параметры.Очередь,
		Неопределено,
		ПолноеИмяРегистра,
		МенеджерВременныхТаблиц,
		ДополнительныеПараметры);
	
	Если НЕ РезультатВыборки.ЕстьДанныеДляОбработки Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	ИначеЕсли НЕ РезультатВыборки.ЕстьЗаписиВоВременнойТаблице Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВременнойТаблицы = РезультатВыборки.ИмяВременнойТаблицы;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	КомпенсацияРодительскойПлатыДети.Ссылка.НачалоПериода КАК НачалоПериода,
	|	КомпенсацияРодительскойПлатыДети.Ссылка.КонецПериода КАК КонецПериода,
	|	КомпенсацияРодительскойПлатыДети.Ссылка.Организация КАК Организация,
	|	КомпенсацияРодительскойПлатыДети.Ребенок КАК Ребенок,
	|	КомпенсацияРодительскойПлатыДети.Плательщик КАК Плательщик,
	|	КомпенсацияРодительскойПлатыДети.СчетПлательщика КАК СчетПлательщика,
	|	КомпенсацияРодительскойПлатыДети.ПроцентКомпенсации КАК ПроцентКомпенсации,
	|	КомпенсацияРодительскойПлатыДети.Сумма КАК СуммаОплаты,
	|	КомпенсацияРодительскойПлатыДети.СуммаКомпенсации КАК СуммаКомпенсации,
	|	КомпенсацияРодительскойПлатыДети.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	КомпенсацияРодительскойПлатыДети.Ссылка КАК Регистратор
	|ИЗ
	|	Документ.КомпенсацияРодительскойПлаты.Дети КАК КомпенсацияРодительскойПлатыДети
	|ГДЕ
	|	КомпенсацияРодительскойПлатыДети.Ссылка В(&ЗапросИзВременнойТаблицы)
	|	И КомпенсацияРодительскойПлатыДети.Ссылка ССЫЛКА Документ.КомпенсацияРодительскойПлаты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.НачалоПериода,
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.КонецПериода,
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.Организация,
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.Ребенок,
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.Плательщик,
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.СчетПлательщика,
	|	ВЫБОР
	|		КОГДА ЖурналУчетаКомпенсацииРодительскойПлаты.ПроцентКомпенсации = 99
	|				И ЖурналУчетаКомпенсацииРодительскойПлаты.СуммаОплаты = ЖурналУчетаКомпенсацииРодительскойПлаты.СуммаКомпенсации
	|			ТОГДА 100
	|		ИНАЧЕ ЖурналУчетаКомпенсацииРодительскойПлаты.ПроцентКомпенсации
	|	КОНЕЦ,
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.СуммаОплаты,
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.СуммаКомпенсации,
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.ГруппаДетскогоУчреждения,
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.Регистратор
	|ИЗ
	|	РегистрСведений.ЖурналУчетаКомпенсацииРодительскойПлаты КАК ЖурналУчетаКомпенсацииРодительскойПлаты
	|ГДЕ
	|	ЖурналУчетаКомпенсацииРодительскойПлаты.Регистратор В(&ЗапросИзВременнойТаблицы)
	|	И ЖурналУчетаКомпенсацииРодительскойПлаты.Регистратор ССЫЛКА Документ.КорректировкаРегистров
	|ИТОГИ ПО
	|	Регистратор";
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ЗапросИзВременнойТаблицы",
		"ВЫБРАТЬ
		|	ВТ.Регистратор
		|ИЗ " + ИмяВременнойТаблицы + " КАК ВТ");
	
	ВыборкаРегистратор = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДополнительныеПараметрыОтметкиОбработки = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметрыОтметкиОбработки.ПолноеИмяРегистра = ПолноеИмяРегистра;
	ДополнительныеПараметрыОтметкиОбработки.ЭтоДвижения = Истина;
	
	Пока ВыборкаРегистратор.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			
			ПредставлениеОбъекта = Строка(ВыборкаРегистратор.Регистратор);
			
			Блокировка = Новый БлокировкаДанных();
			
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЖурналУчетаКомпенсацииРодительскойПлаты.НаборЗаписей");
			ЭлементБлокировки.УстановитьЗначение("Регистратор", ВыборкаРегистратор.Регистратор);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = ВыборкаРегистратор.Регистратор.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				// Объект был удален
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ВыборкаРегистратор.Регистратор,
					 ДополнительныеПараметрыОтметкиОбработки);
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			НаборЗаписей = РегистрыСведений.ЖурналУчетаКомпенсацииРодительскойПлаты.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
			
			ВыборкаДвижения = ВыборкаРегистратор.Выбрать();
			Пока ВыборкаДвижения.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), ВыборкаДвижения);
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось обработать объект: %Объект% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Объект%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
									УровеньЖурналаРегистрации.Ошибка,
									ВыборкаРегистратор.Регистратор.Метаданные(),
									ВыборкаРегистратор.Регистратор,
									ТекстСообщения);
				
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = НЕ ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь,
		ПолноеИмяРегистра);

КонецПроцедуры

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию_2_0_89_1(Параметры) Экспорт
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Если ИспользоватьУчетПоИФО Тогда
	
		ПолноеИмяРегистра = "РегистрСведений.ЖурналУчетаКомпенсацииРодительскойПлаты";
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЖурналУчетаКомпенсацииРодительскойПлаты.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ЖурналУчетаКомпенсацииРодительскойПлаты КАК ЖурналУчетаКомпенсацииРодительскойПлаты
		|ГДЕ
		|	ЖурналУчетаКомпенсацииРодительскойПлаты.Регистратор ССЫЛКА Документ.КомпенсацияРодительскойПлаты";
		
		Регистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
		
		ОбновлениеИнформационнойБазы.ОтметитьРегистраторыКОбработке(Параметры, Регистраторы, ПолноеИмяРегистра);
		
	КонецЕсли;	

КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию_2_0_89_1(Параметры) Экспорт
	
	ПолноеИмяРегистра = "РегистрСведений.ЖурналУчетаКомпенсацииРодительскойПлаты";
	ПолноеИмяДокумента = "Документ.КомпенсацияРодительскойПлаты";
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьРегистраторыРегистраДляОбработки(
		Параметры.Очередь, ПолноеИмяДокумента, ПолноеИмяРегистра);
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоДвижения = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = ПолноеИмяРегистра;
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ПредставлениеРегистратора = Строка(Выборка.Регистратор);
			ЗаполнитьИФОВДвижениях(Выборка.Регистратор);
		
		Исключение
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не удалось обработать движения документа: %1 по причине:
					|%2'"), 
					ПредставлениеРегистратора, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.РегистрыСведений.ЖурналУчетаКомпенсацииРодительскойПлаты, , ТекстСообщения);
		КонецПопытки;
				
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяРегистра);
	
КонецПроцедуры

Процедура ЗаполнитьИФОВДвижениях(Документ)

	НачатьТранзакцию();
	Попытка
	
		// Блокируем объект от изменения другими сеансами.
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЖурналУчетаКомпенсацииРодительскойПлаты.НаборЗаписей");
		ЭлементБлокировки.УстановитьЗначение("Регистратор", Документ);
		Блокировка.Заблокировать();
		
		ДокументОбъект = Документ.ПолучитьОбъект();
		
		Если ДокументОбъект <> Неопределено Тогда
			
			ДокументОбъект.Заблокировать();
			
			ИФОДокумента = Неопределено;
			
			ТипДокумента = ТипЗнч(Документ);
			Если ТипДокумента = Тип("ДокументСсылка.КомпенсацияРодительскойПлаты") Тогда
				ИФОДокумента = Документ.ИФО;
			Иначе	
				ВызватьИсключение "Неправильный тип документа " + ТипДокумента;
			КонецЕсли;
			
			НаборЗаписей = РегистрыСведений.ЖурналУчетаКомпенсацииРодительскойПлаты.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(Документ);
			НаборЗаписей.Прочитать();
			Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
				ЗаписьНабора.ИФО = ИФОДокумента;
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			
		Иначе
			// Документ удален или движения документа не соответствуют ожидаемым
			ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
			ДополнительныеПараметры.ПолноеИмяРегистра = "РегистрСведений.ЖурналУчетаКомпенсацииРодительскойПлаты";
			ДополнительныеПараметры.ЭтоДвижения = Истина;
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Документ, ДополнительныеПараметры);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
