
////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Отбор.Свойство("Ребенок", ОтборРебенок) Тогда
		
		Параметры.Свойство("Ребенок", ОтборРебенок)
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборРебенок) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ребенок", ОтборРебенок,,, ЗначениеЗаполнено(ОтборРебенок));
		ОтборОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборРебенок, "Организация");
		Элементы.ОтборОрганизация.ТолькоПросмотр			= Истина;
		Элементы.ОтборРебенок.ТолькоПросмотр				= Истина;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Ребенок", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Организация", "Видимость", Ложь);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОтборОрганизация) Тогда
		
		ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация, "Организация");	
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Организация", "Видимость", НЕ ЗначениеЗаполнено(ОтборОрганизация));

	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения) Тогда
		
		ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборГруппаДетскогоУчреждения, "ГруппаДетскогоУчреждения");	
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДетскогоУчреждения", "Видимость", НЕ ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));

	КонецЕсли;
 
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Организация", "Видимость", НЕ ЗначениеЗаполнено(ОтборОрганизация));
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборГруппаДетскогоУчрежденияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ГруппаДетскогоУчреждения", ОтборГруппаДетскогоУчреждения,,, ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДетскогоУчреждения", "Видимость", НЕ ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборРебенокПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ребенок", ОтборРебенок,,, ЗначениеЗаполнено(ОтборРебенок));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Ребенок", "Видимость", НЕ ЗначениеЗаполнено(ОтборРебенок));
	
КонецПроцедуры

