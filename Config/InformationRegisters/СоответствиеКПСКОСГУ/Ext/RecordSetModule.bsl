Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекЗапись Из ЭтотОбъект Цикл
		Если ТекЗапись.ТипДанных = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ") Тогда
			ТекЗапись.АналитическийКодДохода = "";
			ТекЗапись.ВидДохода = "";
		Иначе
			ТекЗапись.ВидРасхода = "";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

