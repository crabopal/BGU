
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	НеДобавлятьСубсчета = ПараметрыЗаписи.Свойство("НеДобавлятьСубсчета") И ПараметрыЗаписи.НеДобавлятьСубсчета; 
	Если НЕ НеДобавлятьСубсчета
		И ЗначениеЗаполнено(Запись.СчетДт) И ЗначениеЗаполнено(Запись.СчетКт)
		И ЕстьСубсчетаУСчетов(Запись.СчетДт, Запись.СчетКт) Тогда
		
		ТекстВопроса = НСтр("ru = 'В указанной корреспонденции обнаружены счета, имеющие подчиненные счета (субсчета).
		|
		|Добавить субсчета в набор корреспонденций (будет открыта форма выбора субсчетов)?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Добавить субсчета'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Добавить только указанную корреспонденцию'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ДобавитьСубсчетаЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки);
		
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ДобавитьСубсчетаЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Записать(Новый Структура("НеДобавлятьСубсчета", Истина));
		Закрыть();
	ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда
		ПараметрыФормы = Новый Структура("СчетДт, СчетКт, Комментарий", Запись.СчетДт, Запись.СчетКт, Запись.Комментарий);
		ОткрытьФорму("РегистрСведений.КорректныеКорреспонденцииСчетов.Форма.ФормаСпискаКорреспонденций", ПараметрыФормы);
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьСубсчетаУСчетов(СчетДт, СчетКт)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИСТИНА
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	ЕПСБУ.Родитель = &СчетДт
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИСТИНА
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	ЕПСБУ.Родитель = &СчетКт";
	Запрос.УстановитьПараметр("СчетДт", СчетДт);
	Запрос.УстановитьПараметр("СчетКт", СчетКт);
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции // ЕстьСубсчетаУСчетов()

#КонецОбласти
