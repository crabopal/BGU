
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список,
		"ВспомогательныеСчетаВводаНачальныхОстатков", БухгалтерскийУчет.СписокСчетов("000, 00"));
	
	Если ЗначениеЗаполнено(Параметры.Счет) Тогда
		
		ГруппаОтбораСчетов = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
			Список.КомпоновщикНастроек.Настройки.Отбор.Элементы,
			"Счет", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораСчетов,
			"СчетДт", Параметры.Счет, ВидСравненияКомпоновкиДанных.Равно, , Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораСчетов,
			"СчетКт", Параметры.Счет, ВидСравненияКомпоновкиДанных.Равно, , Истина);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьКорректныеПроводки(Команда)
	
	ОткрытьФорму("РегистрСведений.КорректныеКорреспонденцииСчетов.Форма.ФормаЗагрузки",,
		ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьКорректныеПроводкиВФайл(Команда)
	
	// Покажем диалог выбора файла.
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогОткрытияФайла.Фильтр = НСтр("ru='Файлы MXL'")+"(*.mxl)|*.mxl";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите файл для выгрузки";
	ДиалогОткрытияФайла.Показать(Новый ОписаниеОповещения("СохранитьКорректныеПроводкиВФайлЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьКорректныеПроводкиВФайлЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если (ВыбранныеФайлы <> Неопределено) И ВыбранныеФайлы.Количество() > 0 Тогда
		
		ИмяФайлаВыгрузки = ВыбранныеФайлы[0];
		
		АдресФайлаВыгрузки = СохранитьКорректныеПроводкиВФайлНаСервере();
		Если АдресФайлаВыгрузки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		#Если ВебКлиент Тогда
		// В вебклиенте всегда интерактивно запрашиваем сохраняемый файл.
		ПолучитьФайл(АдресФайлаВыгрузки, "КорректныеКорреспонденцииСчетов.xml", Истина);
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Корректные корреспонденции счетов выгружены. Сохраните файл на диск.'"));
		#Иначе
		Если ПолучитьФайл(АдресФайлаВыгрузки, ИмяФайлаВыгрузки, Ложь) Тогда
			ПоказатьПредупреждение(Неопределено, НСтр("ru='Корректные корреспонденции счетов выгружены.'"));
		Иначе
			ПоказатьПредупреждение(Неопределено, НСтр("ru='Корректные корреспонденции счетов не выгружены.'"));
		КонецЕсли;
		#КонецЕсли
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СохранитьКорректныеПроводкиВФайлНаСервере()
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		
		ФоновыеЗаданияБухгалтерскийУчет.ВыполнитьВыгрузкуКорреспондирующихСчетовВОбщемМодуле(АдресХранилища);
		
		Результат = ПолучитьИзВременногоХранилища(АдресХранилища);
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			АдресФайлаВыгрузки = ПоместитьВоВременноеХранилище(Результат.ДанныеФайла, УникальныйИдентификатор);
			Возврат АдресФайлаВыгрузки;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	НаименованиеЗадания = НСтр("ru = 'Сохранить корректные проводки в файл'");
	
	ПараметрыЭкспортнойПроцедуры = Новый Массив;
	ПараметрыЭкспортнойПроцедуры.Добавить(АдресХранилища);
	
	Если ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая Тогда
		ВремяОжидания = 4;
	Иначе
		ВремяОжидания = 2;
	КонецЕсли;
	
	Задание = ФоновыеЗадания.Выполнить(
		"ФоновыеЗаданияБухгалтерскийУчет.ВыполнитьВыгрузкуКорреспондирующихСчетовВОбщемМодуле", 
		ПараметрыЭкспортнойПроцедуры, , НаименованиеЗадания);
	Попытка
		Задание.ОжидатьЗавершения(ВремяОжидания);
	Исключение
		// Специальная обработка не требуется. Предположительно, исключение вызвано истечением времени ожидания.
	КонецПопытки;
	
	ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	Если ДлительныеОперации.ЗаданиеВыполнено(Задание.УникальныйИдентификатор) Тогда
		Результат = ПолучитьИзВременногоХранилища(АдресХранилища);
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			АдресФайлаВыгрузки = ПоместитьВоВременноеХранилище(Результат.ДанныеФайла, УникальныйИдентификатор);
			Возврат АдресФайлаВыгрузки;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

