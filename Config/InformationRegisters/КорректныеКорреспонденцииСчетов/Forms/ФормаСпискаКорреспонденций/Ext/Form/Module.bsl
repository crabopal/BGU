
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АдресТаблицыКорреспонденций") Тогда
		Если ЗначениеЗаполнено(Параметры.АдресТаблицыКорреспонденций) Тогда
			Корреспонденции = ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыКорреспонденций);
			
			Для Каждого СтрокаТаблицы Из Корреспонденции Цикл
				НоваяСтрока = ТаблицаКорреспонденций.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
				НоваяСтрока.Использование = Истина;
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Параметры.СчетДт) И ЗначениеЗаполнено(Параметры.СчетКт) Тогда
		
		ЗаполнитьТаблицуКорреспонденций(Параметры.СчетДт, Параметры.СчетКт);	
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	Если ЗаписатьНаборКорреспонденцийСервер() Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для Каждого СтрокаТаблицы Из ТаблицаКорреспонденций Цикл
		СтрокаТаблицы.Использование = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для Каждого СтрокаТаблицы Из ТаблицаКорреспонденций Цикл
		СтрокаТаблицы.Использование = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьНаборКорреспонденцийСервер()

	Попытка
	
		Для Каждого Корреспонденция Из ТаблицаКорреспонденций Цикл
			Если Корреспонденция.Использование Тогда
		    	МенеджерЗаписи = РегистрыСведений.КорректныеКорреспонденцииСчетов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.СчетДт = Корреспонденция.СчетДт;
				МенеджерЗаписи.СчетКт = Корреспонденция.СчетКт;
				МенеджерЗаписи.Прочитать();
				Если НЕ МенеджерЗаписи.Выбран() Тогда
					МенеджерЗаписи.СчетДт = Корреспонденция.СчетДт;
					МенеджерЗаписи.СчетКт = Корреспонденция.СчетКт;
					МенеджерЗаписи.Комментарий = Корреспонденция.Комментарий;
					МенеджерЗаписи.Записать(Ложь);
					Корреспонденция.Использование = Ложь;
				Иначе
					МенеджерЗаписи.Комментарий = Корреспонденция.Комментарий;
					МенеджерЗаписи.Записать(Истина);
					Корреспонденция.Использование = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Возврат Истина;
		
	Исключение
		
		Возврат Ложь;
		
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуКорреспонденций(СчетДт, СчетКт)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СчетаДт.Ссылка КАК СчетДт,
	               |	СчетаКт.Ссылка КАК СчетКт,
	               |	СчетаДт.Порядок КАК ПорядокДт,
	               |	СчетаКт.Порядок КАК ПорядокКт
	               |ПОМЕСТИТЬ ТаблицаКорреспонденций
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК СчетаДт,
	               |	ПланСчетов.ЕПСБУ КАК СчетаКт
	               |ГДЕ
	               |	СчетаДт.Ссылка В ИЕРАРХИИ(&СчетДт)
	               |	И СчетаКт.Ссылка В ИЕРАРХИИ(&СчетКт)
	               |	И НЕ(СчетаДт.ЭлементГруппа = ИСТИНА
	               |				И СчетаКт.ЭлементГруппа = ИСТИНА)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаКорреспонденций.СчетДт,
	               |	ТаблицаКорреспонденций.СчетКт,
	               |	&Комментарий,
	               |	ВЫБОР
	               |		КОГДА КорректныеКорреспонденцииСчетов.СчетДт ЕСТЬ NULL 
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Использование
	               |ИЗ
	               |	ТаблицаКорреспонденций КАК ТаблицаКорреспонденций
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КорректныеКорреспонденцииСчетов КАК КорректныеКорреспонденцииСчетов
	               |		ПО ТаблицаКорреспонденций.СчетДт = КорректныеКорреспонденцииСчетов.СчетДт
	               |			И ТаблицаКорреспонденций.СчетКт = КорректныеКорреспонденцииСчетов.СчетКт
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТаблицаКорреспонденций.ПорядокДт,
	               |	ТаблицаКорреспонденций.ПорядокКт";
	Запрос.УстановитьПараметр("СчетДт",			СчетДт);
	Запрос.УстановитьПараметр("СчетКт", 		СчетКт);
	Запрос.УстановитьПараметр("Комментарий",	Параметры.Комментарий);
	
	ТаблицаКорреспонденций.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

#КонецОбласти
