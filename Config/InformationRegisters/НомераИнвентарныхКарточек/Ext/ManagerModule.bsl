#Область СлужебныеПроцедурыИФункции

Функция ПоследнийНомер(Организация, ДанныеШаблона = Неопределено, НовыеНомера = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	НовыеНомера.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_НовыеНомера
	|ИЗ
	|	&НовыеНомера КАК НовыеНомера
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НомераИнвентарныхКарточек.НомерИнвентарнойКарточки КАК Значение
	|ПОМЕСТИТЬ НовыеНомера
	|ИЗ
	|	РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(, Организация = &Организация) КАК НомераИнвентарныхКарточек
	|ГДЕ
	|	НомераИнвентарныхКарточек.НомерИнвентарнойКарточки <> """"
	|	И НомераИнвентарныхКарточек.НомерИнвентарнойКарточки ПОДОБНО &ШаблонПоиска
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НовыеНомера.Значение
	|ИЗ
	|	ВТ_НовыеНомера КАК НовыеНомера
	|ГДЕ
	|	НовыеНомера.Значение ПОДОБНО &ШаблонПоиска
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	НовыеНомера2.Значение КАК Значение
	|ИЗ
	|	НовыеНомера КАК НовыеНомера2
	|
	|УПОРЯДОЧИТЬ ПО
	|	Значение УБЫВ";	
	
	ТаблицаНовыеНомера = Новый ТаблицаЗначений;
	ТаблицаНовыеНомера.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(20)));
	Если НовыеНомера <> Неопределено Тогда
		Для Каждого Номер Из НовыеНомера Цикл
			ТаблицаНовыеНомера.Добавить().Значение = Номер;
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НовыеНомера", ТаблицаНовыеНомера);
	
	Если ДанныеШаблона = Неопределено Тогда	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НомераИнвентарныхКарточек.НомерИнвентарнойКарточки ПОДОБНО &ШаблонПоиска", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НовыеНомера.Значение ПОДОБНО &ШаблонПоиска", "ИСТИНА");	
	Иначе
		Если ДанныеШаблона.БезУчетаПрефикса Тогда
			ДлинаПрефикса = СтрДлина(ДанныеШаблона.Префикс);		
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "НовыеНомера2.Значение КАК Значение", "ПОДСТРОКА(НовыеНомера2.Значение, &НачальнаяПозиция, &Длина) КАК Значение");
			Запрос.УстановитьПараметр("НачальнаяПозиция", ДлинаПрефикса + 1);
			Запрос.УстановитьПараметр("Длина", ДанныеШаблона.ДлинаНомера);	
			ШаблонПоиска = Лев("______________________________", ДлинаПрефикса);
		Иначе
			ШаблонПоиска = ДанныеШаблона.Префикс;	
		КонецЕсли;		
		Для Сч = 1 По ДанныеШаблона.ДлинаНомера Цикл
			ШаблонПоиска = ШаблонПоиска + "[0-9]"; 
		КонецЦикла;
		Запрос.УстановитьПараметр("ШаблонПоиска", ШаблонПоиска);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = СокрП(Выборка.Значение);
		Если ДанныеШаблона <> Неопределено Тогда
			Результат = Прав(Результат, ДанныеШаблона.ДлинаНомера);
		КонецЕсли;
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьУникальность(Объект, Отказ) Экспорт
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Объект.Организация, Объект.Дата); 
	Если УчетнаяПолитика.КонтрольУникальностиИнвентарныхКарточек = 2 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.ИзменениеДанныхОС") Тогда
		ТаблицаНомеров = Новый ТаблицаЗначений;
		ТаблицаНомеров.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ТаблицаНомеров.Колонки.Добавить("НомерИнвентарнойКарточки", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(20)));
		Для Каждого СтрокаТаблицы ИЗ Объект.ИзмененияУчетныхДанных Цикл
			Если СтрокаТаблицы.НомерИнвентарнойКарточкиНовый <> СтрокаТаблицы.НомерИнвентарнойКарточки
				Или СтрокаТаблицы.ДатаИнвентарнойКарточкиНовая <> СтрокаТаблицы.ДатаИнвентарнойКарточки Тогда
				НоваяСтрока = ТаблицаНомеров.Добавить();
				НоваяСтрока.ОсновноеСредство = СтрокаТаблицы.ОсновноеСредство;
				НоваяСтрока.НомерИнвентарнойКарточки =  СтрокаТаблицы.НомерИнвентарнойКарточкиНовый;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Отбор = Новый Структура("СоздатьИнвентарнуюКарточку", Истина);
		ТаблицаНомеров = Объект.ОсновныеСредства.Выгрузить(Отбор, "ОсновноеСредство,НомерИнвентарнойКарточки");
	КонецЕсли;
	
	СписокНомеров = ТаблицаНомеров.ВыгрузитьКолонку("НомерИнвентарнойКарточки");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"		, Объект.Организация);
	Запрос.УстановитьПараметр("Период"			, Объект.Дата);
	Запрос.УстановитьПараметр("Ссылка"			, Объект.Ссылка);
	Запрос.УстановитьПараметр("ТаблицаНомеров"	, ТаблицаНомеров);
	Запрос.УстановитьПараметр("СписокНомеров"	, СписокНомеров);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаНомеров.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаНомеров.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТаблицаНомеров КАК ТаблицаНомеров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НомераИнвентарныхКарточекСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Регистратор <> &Ссылка) КАК НомераИнвентарныхКарточекСрезПоследних
	|ГДЕ
	|	НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки В(&СписокНомеров)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ.ОсновноеСредство,
	|	ВТ.НомерИнвентарнойКарточки
	|ИЗ
	|	ВТ КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки
	|ИЗ
	|	Таблица КАК Таблица
	|ГДЕ
	|	Таблица.НомерИнвентарнойКарточки <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Таблица.НомерИнвентарнойКарточки
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Таблица.ОсновноеСредство) > 1";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Шаблон = НСтр("ru = 'Номер инвентарной карточки ""%1"" не уникален.'");
	
	КакОшибка = (УчетнаяПолитика.КонтрольУникальностиИнвентарныхКарточек = 0);
	
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = СтрЗаменить(Шаблон, "%1", Выборка.НомерИнвентарнойКарточки);
		Если КакОшибка Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,, Отказ);
		Иначе
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли