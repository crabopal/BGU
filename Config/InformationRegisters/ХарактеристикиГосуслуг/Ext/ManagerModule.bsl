Процедура ПеренестиНастройкиИдентификатораПлательщика() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ХарактеристикиГосуслуг.Период,
		|	ХарактеристикиГосуслуг.Номенклатура,
		|	ХарактеристикиГосуслуг.УдалитьВидАльтернативногоИдентификатора КАК ВидАльтернативногоИдентификатора,
		|	ХарактеристикиГосуслуг.ЗначениеНастройки,
		|	ХарактеристикиГосуслуг.УдалитьТипИдентификатораПлательщика КАК ТипИдентификатораПлательщика
		|ИЗ
		|	РегистрСведений.ХарактеристикиГосуслуг КАК ХарактеристикиГосуслуг";

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВидАльтернативногоИдентификатора) Тогда
			Продолжить;
		КонецЕсли;	
		ТекЗначениеНастройки = ВыборкаДетальныеЗаписи.ЗначениеНастройки.Получить();
		Если ТипЗнч(ТекЗначениеНастройки) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ТекЗначениеНастройки.Свойство("ТаблицаИдентификаторов") Тогда
			Продолжить;
		КонецЕсли;
		НужнаЗапись = Ложь;
		Для Каждого СтрТЧ Из ТекЗначениеНастройки.ТаблицаИдентификаторов Цикл
			Если СтрТЧ.ТипПоля = "АльтернативныйИдентификатор" И НЕ ЗначениеЗаполнено(СтрТЧ.РеквизитИдентификатор) Тогда
				СтрТЧ.РеквизитИдентификатор = ВыборкаДетальныеЗаписи.ВидАльтернативногоИдентификатора;
				НужнаЗапись = Истина;
			КонецЕсли;			
		КонецЦикла;
		Если НужнаЗапись Тогда
			Запись = РегистрыСведений.ХарактеристикиГосуслуг.СоздатьМенеджерЗаписи();
			Запись.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
			Запись.Период = ВыборкаДетальныеЗаписи.Период;
			Запись.Прочитать();
			Запись.ЗначениеНастройки = Новый ХранилищеЗначения(ТекЗначениеНастройки,Новый СжатиеДанных(9));
            Запись.Записать(Истина);
		КонецЕсли;
	КонецЦикла;

	Если ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП") Тогда		
		ВыборкаДетальныеЗаписи.Сбросить();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ТипИдентификатораПлательщика) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ (ВыборкаДетальныеЗаписи.ТипИдентификатораПлательщика = Перечисления.ТипИдентификатораПолучателяГосуслуг.Единый
				ИЛИ (ВыборкаДетальныеЗаписи.ТипИдентификатораПлательщика = Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный
					И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВидАльтернативногоИдентификатора))) Тогда
				Продолжить;
			КонецЕсли;
			
			Набор = РегистрыСведений.НастройкаИспользованияИдентификаторовПлательщика.СоздатьНаборЗаписей();
			
			Набор.Отбор.Номенклатура.Значение = ВыборкаДетальныеЗаписи.Номенклатура;
			Набор.Отбор.Номенклатура.Использование = Истина;
			
			Набор.Отбор.Период.Значение = ВыборкаДетальныеЗаписи.Период;
			Набор.Отбор.Период.Использование = Истина;
			
			Набор.Прочитать();
			Если Набор.Количество()=0 Тогда
				// обновление не проходило, заполним
				ЗаписьНабора = Набор.Добавить();
				
				ТекВид = Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка();
				Если ВыборкаДетальныеЗаписи.ТипИдентификатораПлательщика = Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный Тогда
					ТекВид = ВыборкаДетальныеЗаписи.ВидАльтернативногоИдентификатора;
				КонецЕсли;
				ЗаписьНабора.ВидАльтИдентификатора = ТекВид;
				ЗаписьНабора.Период = ВыборкаДетальныеЗаписи.Период;
				ЗаписьНабора.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
				ЗаписьНабора.Использовать = Истина;
				
				Набор.Записывать = Истина;
				
				Набор.Записать();
						
			КонецЕсли;			
		КонецЦикла;		
	КонецЕсли;
КонецПроцедуры