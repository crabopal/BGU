#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП") Тогда 
		//Элементы.ТипИдентификатораПлательщика.Видимость = Истина;
		Элементы.НастройкаДополнительныхХарактеристикНоменклатуры.Видимость = Ложь;
		Элементы.НастроитьДопХарактеристики.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("ИзменениеХарактеристикГосуслуги", Запись.Номенклатура);// Вставить содержимое обработчика.
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КодОКВЭД2НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	 
	 СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", 				"Выбор вида деятельности по ОКВЭД");
	ПараметрыФормы.Вставить("НазваниеМакета",  			"ОКВЭД2");
	ПараметрыФормы.Вставить("Префикс",					"Классификатор");
	ПараметрыФормы.Вставить("ИмяРеквизитаКод",  		"КодОКВЭД2");
	ПараметрыФормы.Вставить("ИмяРеквизитаНаименование",	"НаименованиеОКВЭД2");
	
	ВыбратьИзКлассификатора(ПараметрыФормы);
	 
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИзКлассификатора(ПараметрыФормы)
	 
	 ПараметрыФормы.Вставить("ТекущийПериод",   		?(ЗначениеЗаполнено(Запись.Период),Запись.Период,ТекущаяДата()));
	 ПараметрыФормы.Вставить("ТекущийКод",      		Запись[ПараметрыФормы.ИмяРеквизитаКод]);
	 ПараметрыФормы.Вставить("ВернутьВсеРеквизиты",		Истина);
	 
	 ДополнительныеПараметры = Новый Структура("ИмяРеквизитаКод, ИмяРеквизитаНаименование", ПараметрыФормы.ИмяРеквизитаКод, ПараметрыФормы.ИмяРеквизитаНаименование);
	 
	 ОповещениеОЗакрытии = Новый ОписаниеОповещения("ВыбратьИзКлассификатораЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	 
	 ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы,,,,, ОповещениеОЗакрытии);
	 
КонецПроцедуры	
 
&НаКлиенте
Процедура ВыбратьИзКлассификатораЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		
		Модифицированность = Истина;
		
		Запись[ДополнительныеПараметры.ИмяРеквизитаКод] = РезультатЗакрытия.Код;
		
		Запись[ДополнительныеПараметры.ИмяРеквизитаНаименование] = РезультатЗакрытия.Наименование;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НастроитьДопХарактеристики(Команда)
	
	Если НЕ ЗначениеЗаполнено(Запись.НастройкаДополнительныхХарактеристикНоменклатуры) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не выбрана настройка доп. характеристик номенклатуры.'"));
		Возврат;	
	КонецЕсли;

	Если Модифицированность Тогда
		Текст = НСтр("ru = 'Перед установкой дополнительных параметров, необходимо записать. Записать?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("НастроитьДопХарактеристикиЗавершение", ЭтотОбъект), Текст,РежимДиалогаВопрос.ОКОтмена);
        Возврат;
	КонецЕсли;
	
	НастроитьДопХарактеристикиФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДопХарактеристикиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
        Возврат;
    КонецЕсли;
    Записать();
    
    НастроитьДопХарактеристикиФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура НастроитьДопХарактеристикиФрагмент()
    
    Перем ПараметрыФормы;
    
    ПараметрыФормы = Новый Структура("НастройкаДополнительныхХарактеристикНоменклатуры,Номенклатура,Период",Запись.НастройкаДополнительныхХарактеристикНоменклатуры,Запись.Номенклатура,Запись.Период);	
    ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаДополнительныхХарактеристик", ПараметрыФормы);
    
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
