
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Свойство("Номенклатура", ОтборНоменклатура) ИЛИ
		Параметры.Свойство("Номенклатура", ОтборНоменклатура) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
																 "Номенклатура",
																 ОтборНоменклатура,
																 ,
																 ,
																 ЗначениеЗаполнено(ОтборНоменклатура));	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборНоменклатура) Тогда
		
		Элементы.ОтборНоменклатура.ТолькоПросмотр 		= Истина;
		Элементы.ОтборНоменклатура.РедактированиеТекста 	= Ложь;
		Элементы.ОтборНоменклатура.КнопкаОткрытия 		= Ложь;
		
	КонецЕсли;
	
	Элементы.Номенклатура.Видимость = НЕ ЗначениеЗаполнено(ОтборНоменклатура);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборНоменклатураПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Номенклатура", ОтборНоменклатура,,, ЗначениеЗаполнено(ОтборНоменклатура));
	Элементы.Номенклатура.Видимость = НЕ ЗначениеЗаполнено(ОтборНоменклатура);
	
КонецПроцедуры

#КонецОбласти