#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбновлениеИнформационнойБазы

// Заполняет ставки налога на прибыль, введенные на период с 2025 по 2030 годы (176-ФЗ).
// Если в каком-то году введены "нестандартные" ставки, то обновления настроек не происходит.
//
Процедура ЗаполнитьСтавкиНалогаНаПрибыльС2025По2030Года() Экспорт
	
	НачалоПериода 	= '2025-01-01';
	КонецПериода 	= КонецДня('2030-12-31');
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);	
	
	// Выбираем "стандартные" настройки ставок налога на прибыль (3% и 17%) с целью их дальнейшей перезаписи с новыми значениями.
	// (1) Выбираем установленные "стандартные" настройки налога на прибыль за период с 2025 по 2030 годы.
	// (2) Если на 2025 год настройка не устанавливалась, то проверяем действующие настройки на начало 2025 года.
	
	// Вторая таблица запроса выбирает записи в срез последних только в том случае,
	// если последняя запись ранее 2025 года (см. условие "ГДЕ НастройкиСрезПоследних.Период < &НачалоПериода").
	// В этом случае первый запрос объединения заведомо не вернет запись за 2025 год (ее не будет в базе).
	
	// Все выбранные таким образом настройки подлежат изменению - см. ниже.
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Настройки.Период КАК Период
	|ИЗ
	|	РегистрСведений.СтавкиНалогаНаПрибыльДляВсехОрганизаций КАК Настройки
	|ГДЕ
	|	Настройки.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Настройки.СтавкаФБ = 3
	|	И Настройки.СтавкаСубъектРФ = 17
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&НачалоПериода
	|ИЗ
	|	РегистрСведений.СтавкиНалогаНаПрибыльДляВсехОрганизаций.СрезПоследних(&НачалоПериода, ) КАК НастройкиСрезПоследних
	|ГДЕ
	|	НастройкиСрезПоследних.Период < &НачалоПериода
	|	И НастройкиСрезПоследних.СтавкаФБ = 3
	|	И НастройкиСрезПоследних.СтавкаСубъектРФ = 17";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	ВыборкаНастройки = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаНастройки.Следующий() Цикл
		
		Запись = РегистрыСведений.СтавкиНалогаНаПрибыльДляВсехОрганизаций.СоздатьМенеджерЗаписи();
		
		Запись.Период			= ВыборкаНастройки.Период;
		Запись.СтавкаФБ        	= 8;
		Запись.СтавкаСубъектРФ 	= 17;
		
		Запись.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗаполнитьСтавкиНалогаНаПрибыльС2025По2030Года");
КонецПроцедуры

#КонецЕсли
