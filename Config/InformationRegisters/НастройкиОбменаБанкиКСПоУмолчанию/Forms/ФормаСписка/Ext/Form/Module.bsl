////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Процедура устанавливает Учреждение в форме по данным переданного отбора.
//
&НаСервере
Процедура УстановитьОрганизацию()
	
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Организация") Тогда
		
		ОтборОрганизация = Параметры.Отбор.Организация;
		Элементы.ОтборОрганизация.ТолькоПросмотр = Истина;
		Элементы.ОтборОрганизация.КнопкаОткрытия = Ложь;

	КонецЕсли;
	
КонецПроцедуры // УстановитьОрганизацию()

&НаКлиенте
Процедура ОсуществитьВыбор()
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура("Организация, КассовыйОрган, ВидОбмена, НастройкаОбмена, НастройкаФорматов");
	
	ЗаполнитьЗначенияСвойств(Результат, ТекДанные);
	
	Оповестить("ВыбранаНастройкаОбменаБанкиКС", Результат, ЭтаФорма.ВладелецФормы);
	Закрыть();

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.Список.РежимВыбора = Ложь;
	Параметры.Свойство("РежимВыбора", 	Элементы.Список.РежимВыбора);
	
	УстановитьОрганизацию();

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));

	Если Элементы.Список.РежимВыбора Тогда
		ЭтаФорма.РежимОткрытияОкна 	= РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	КонецЕсли;
	
	Элементы.Организация.Видимость = Не ЗначениеЗаполнено(ОтборОрганизация);
	
	ЗначенияКлюча = Новый Структура("Организация, КассовыйОрган");
	ЗначенияКлюча.Организация  = ОтборОрганизация;
	Параметры.Свойство("КассовыйОрган", ЗначенияКлюча.КассовыйОрган);

	Параметры.ТекущаяСтрока = РегистрыСведений.НастройкиОбменаБанкиКСПоУмолчанию.СоздатьКлючЗаписи(ЗначенияКлюча);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.Организация.Видимость = Не ЗначениеЗаполнено(ОтборОрганизация);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ Список

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Элементы.Список.РежимВыбора Тогда
		СтандартнаяОбработка = Ложь;		
		ОсуществитьВыбор();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	Если Элементы.Список.РежимВыбора Тогда
		СтандартнаяОбработка = Ложь;		
		ОсуществитьВыбор();
    КонецЕсли;
КонецПроцедуры
