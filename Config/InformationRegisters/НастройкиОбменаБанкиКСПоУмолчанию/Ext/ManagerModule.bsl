Функция ПолучитьОсновнуюНастройкуОбменаОрганизации(Организация, КассовыйОрган = Неопределено) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	НастройкиОбменаБанкиКСПоУмолчанию.КассовыйОрган,
	               |	НастройкиОбменаБанкиКСПоУмолчанию.ВидОбмена,
	               |	НастройкиОбменаБанкиКСПоУмолчанию.НастройкаФорматов,
	               |	НастройкиОбменаБанкиКСПоУмолчанию.НастройкаОбмена,
	               |	НастройкиОбменаБанкиКСПоУмолчанию.Основная
	               |ПОМЕСТИТЬ Настройки
	               |ИЗ
	               |	РегистрСведений.НастройкиОбменаБанкиКСПоУмолчанию КАК НастройкиОбменаБанкиКСПоУмолчанию
	               |ГДЕ
	               |	НастройкиОбменаБанкиКСПоУмолчанию.Организация = &Организация
	               |	И &КассовыйОрган
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ВЫБОР
	               |			КОГДА Настройки.Основная
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК КоличествоОсновных,
	               |	СУММА(ВЫБОР
	               |			КОГДА НЕ Настройки.Основная
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК КоличествоНеОсновных
	               |ПОМЕСТИТЬ ВыборНастроек
	               |ИЗ
	               |	Настройки КАК Настройки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Настройки.КассовыйОрган,
	               |	Настройки.ВидОбмена,
	               |	Настройки.НастройкаФорматов,
	               |	Настройки.НастройкаОбмена,
	               |	Настройки.Основная
	               |ИЗ
	               |	Настройки КАК Настройки,
	               |	ВыборНастроек КАК ВыборНастроек
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ВыборНастроек.КоличествоОсновных = 0
	               |				ТОГДА ВЫБОР
	               |						КОГДА ВыборНастроек.КоличествоНеОсновных = 1
	               |							ТОГДА НЕ Настройки.Основная
	               |						ИНАЧЕ ЛОЖЬ
	               |					КОНЕЦ
	               |			КОГДА ВыборНастроек.КоличествоОсновных = 1
	               |				ТОГДА Настройки.Основная
	               |			ИНАЧЕ ЛОЖЬ
	               |		КОНЕЦ";
				   
				   
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Условие = "";
	Если КассовыйОрган <> Неопределено Тогда
		Запрос.УстановитьПараметр("КассовыйОрган", КассовыйОрган);
		Условие = "И НастройкиОбменаБанкиКСПоУмолчанию.КассовыйОрган = &КассовыйОрган";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "И &КассовыйОрган", Условие);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Новый Структура("КассовыйОрган,ВидОбмена,НастройкаОбмена,НастройкаФорматов");
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Иначе
		Результат = Новый Структура;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
