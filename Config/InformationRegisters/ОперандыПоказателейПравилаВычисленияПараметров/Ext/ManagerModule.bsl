#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ОчиститьНеКорректныеЗаписи(НаборЗаписей) Экспорт
	
	МассивЗаписейКУдалению = Новый Массив;
	Для Каждого ТекЗапись Из НаборЗаписей Цикл
		Если НЕ ЗначениеЗаполнено(ТекЗапись.ИмяПараметра)
			ИЛИ ТекЗапись.ИмяПараметра = "Аналитика"
			ИЛИ ТекЗапись.ИмяПараметра = "Реквизит_" Тогда
			МассивЗаписейКУдалению.Добавить(ТекЗапись);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивЗаписейКУдалению Цикл
		НаборЗаписей.Удалить(ЭлМас);
	КонецЦикла;
		
КонецПроцедуры

Процедура ЗаполнитьХешОтборовОперандов() Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;//только в главном узле
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперандыПоказателей.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ТабОперанды
		|ИЗ
		|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХешОтборовОперандов КАК ХешОтборовОперандов
		|		ПО (ХешОтборовОперандов.Операнд = ОперандыПоказателей.Ссылка)
		|ГДЕ
		|	ХешОтборовОперандов.Операнд ЕСТЬ NULL
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОперандыПоказателейПравилаВычисленияПараметров.Операнд КАК Операнд,
		|	ОперандыПоказателейПравилаВычисленияПараметров.ИмяПараметра КАК ИмяПараметра,
		|	ОперандыПоказателейПравилаВычисленияПараметров.СпособВычисленияПараметра КАК СпособВычисленияПараметра,
		|	ОперандыПоказателейПравилаВычисленияПараметров.УточнениеСпособаОпределения КАК УточнениеСпособаОпределения,
		|	ОперандыПоказателейПравилаВычисленияПараметров.ВидАналитикиОтбор КАК ВидАналитикиОтбор,
		|	ОперандыПоказателейПравилаВычисленияПараметров.РеквизитАналитики КАК РеквизитАналитики
		|ИЗ
		|	ТабОперанды КАК ТабОперанды
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОперандыПоказателейПравилаВычисленияПараметров КАК ОперандыПоказателейПравилаВычисленияПараметров
		|		ПО ТабОперанды.Ссылка = ОперандыПоказателейПравилаВычисленияПараметров.Операнд";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВсяТаблица = РезультатЗапроса.Выгрузить();
	
	ТабОперандов = ВсяТаблица.Скопировать(,"Операнд");
	ТабОперандов.Свернуть("Операнд");
	ВсяТаблица.Индексы.Добавить("Операнд");
	
	Для Каждого СтрОперанда Из ТабОперандов Цикл
		ТаблицаДляОбработки = ВсяТаблица.Скопировать(Новый Структура("Операнд",СтрОперанда.Операнд));
		ЗаписатьХешОтборовОперанда(ТаблицаДляОбработки, Истина);
	КонецЦикла;
		
КонецПроцедуры

Процедура ЗаписатьХешОтборовОперанда(НаборЗаписей, ОбновлениеИБ = Ложь) Экспорт
	
	ОперандСсылка = Неопределено;
	Если НаборЗаписей.Количество() Тогда
		ОперандСсылка = НаборЗаписей[0].Операнд;
	Иначе
		
		ЭлементОтбора = НаборЗаписей.Отбор.Найти("Операнд");
		Если ЭлементОтбора <> Неопределено Тогда
			Если ЭлементОтбора.ВидСравнения = ВидСравнения.Равно Тогда
				ОперандСсылка = ЭлементОтбора.Значение;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОперандСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	
	ХешОтборовОперандов = "";
	Если ЕстьОтборПоСсылке(НаборЗаписей) = Ложь Тогда
		
		Если ТипЗнч(НаборЗаписей) = Тип("ТаблицаЗначений") Тогда
			ТаблицаДляХеша = НаборЗаписей;	
		Иначе
			ТаблицаДляХеша = НаборЗаписей.Выгрузить(,"ИмяПараметра,РеквизитАналитики,ВидАналитикиОтбор,СпособВычисленияПараметра,УточнениеСпособаОпределения");
		КонецЕсли;
		ТаблицаДляХеша.Сортировать("ИмяПараметра Возр");
		
		МассивФормированияХеша = Новый Массив;
		
		СоответствиеИмяПеречисленияСВПО = БюджетнаяОтчетностьПовтИсп.ПолучитьИменаПеречисленияСпособыВычисленияПараметровОперандов();
		ТипСписок = Тип("СписокЗначений");
		ТипыПеречислений = БюджетнаяОтчетностьПовтИсп.ОписаниеТиповВсеПеречисления();
		
		СоответствиеИдентификаторовАналитик = БюджетнаяОтчетностьПовтИсп.ПолучитьИдентификаторыВидовАналитик();
		
		СоответствиеИсключаемыхСпособов = БюджетнаяОтчетностьПовтИсп.ПолучитьСоответствиеИсключаемыхСпособовВычисления();
		
		Для Каждого СтрПараметр ИЗ ТаблицаДляХеша Цикл
									
			МассивФормированияХеша.Добавить(СтрПараметр.ИмяПараметра);
			МассивФормированияХеша.Добавить(СтрПараметр.РеквизитАналитики);
			Если ЗначениеЗаполнено(СтрПараметр.ВидАналитикиОтбор) Тогда
				МассивФормированияХеша.Добавить(СоответствиеИдентификаторовАналитик[СтрПараметр.ВидАналитикиОтбор]);	
			КонецЕсли;
			МассивФормированияХеша.Добавить(СоответствиеИмяПеречисленияСВПО[СтрПараметр.СпособВычисленияПараметра]);	
			
			Если СоответствиеИсключаемыхСпособов[СтрПараметр.СпособВычисленияПараметра] = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			ТекЗначение = СтрПараметр.УточнениеСпособаОпределения.Получить();
						
			ТипТекЗначения = ТипЗнч(ТекЗначение);
			Если ТипТекЗначения = ТипСписок Тогда
				ТекЗначение.СортироватьПоЗначению(НаправлениеСортировки.Возр);
				Для Каждого СтрСписка Из ТекЗначение Цикл
					Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(СтрСписка.Значение)) Тогда
						
						Если ТипыПеречислений.СодержитТип(ТипЗнч(СтрСписка.Значение)) Тогда
							Если ЗначениеЗаполнено(СтрСписка.Значение) Тогда
								ДобавляемоеЗначение = ОбщегоНазначения.ИмяЗначенияПеречисления(СтрСписка.Значение);
							Иначе
								ДобавляемоеЗначение = "";
							КонецЕсли;
						Иначе
							//не должно такого быть
							ДобавляемоеЗначение = "НЕТ";
						КонецЕсли;
											
					Иначе
						ДобавляемоеЗначение = Строка(СтрСписка.Значение);
					КонецЕсли;
					МассивФормированияХеша.Добавить(ДобавляемоеЗначение);
					
				КонецЦикла;
			Иначе
				Если ОбщегоНазначения.ЭтоСсылка(ТипТекЗначения) Тогда
					Если ТипыПеречислений.СодержитТип(ТипТекЗначения) Тогда
						Если ЗначениеЗаполнено(ТекЗначение) Тогда
							ДобавляемоеЗначение = ОбщегоНазначения.ИмяЗначенияПеречисления(ТекЗначение);
						Иначе
							ДобавляемоеЗначение = "";
						КонецЕсли;
					Иначе
						//не должно такого быть
						ДобавляемоеЗначение = "НЕТ";
					КонецЕсли;
				Иначе
					ДобавляемоеЗначение = Строка(ТекЗначение);
				КонецЕсли;
					
				МассивФормированияХеша.Добавить(ДобавляемоеЗначение);
				
			КонецЕсли;
			
		КонецЦикла;
		
		СтрокаХеша = СтрСоединить(МассивФормированияХеша);
		ХешированиеД = Новый ХешированиеДанных(ХешФункция.MD5);
		ХешированиеД.Добавить(СтрокаХеша);
		//хеш для оптимизации загрузки операндов 
		ХешОтборовОперандов = Base64Строка(ХешированиеД.ХешСумма);
		//
		ХешированиеД = Неопределено;
		МассивФормированияХеша = Неопределено;
		
	КонецЕсли;
	
	Если ОбновлениеИБ Тогда
		Если ЗначениеЗаполнено(ХешОтборовОперандов) Тогда
			//при обновлении ИБ просто запишем в регистр 
			ЗаписьРС = РегистрыСведений.ХешОтборовОперандов.СоздатьМенеджерЗаписи();
			ЗаписьРС.Операнд = ОперандСсылка;
			ЗаписьРС.Хеш = ХешОтборовОперандов;
			ЗаписьРС.Записать();
		КонецЕсли;
	Иначе
		ЗаписьРС = РегистрыСведений.ХешОтборовОперандов.СоздатьМенеджерЗаписи();
		ЗаписьРС.Операнд = ОперандСсылка;
		Если ЗначениеЗаполнено(ХешОтборовОперандов) Тогда			
			
			ЗаписьРС.Прочитать();
			Если ЗаписьРС.Хеш <> ХешОтборовОперандов Тогда
				ЗаписьРС.Операнд = ОперандСсылка;
				ЗаписьРС.Хеш = ХешОтборовОперандов;
				ЗаписьРС.Записать();
			КонецЕсли;							
		Иначе
		    ЗаписьРС.Прочитать();
			Если ЗаписьРС.Выбран() Тогда
				ЗаписьРС.Удалить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьОтборПоСсылке(ТаблицаПравилаВычисления) 
	//проверим, есть ли в операнде отбор по ссылке на справочник 
	ЕстьОтборПоСсылке = Ложь;
	СоответствиеПроверяемыхСпособовВычисления = БюджетнаяОтчетностьПовтИсп.ПолучитьСоответствиеПроверяемыхСпособовВычисления();
	ТипСписок = Тип("СписокЗначений");
	ТипыПеречислений = БюджетнаяОтчетностьПовтИсп.ОписаниеТиповВсеПеречисления();
	
	Для Каждого СтрПВ Из ТаблицаПравилаВычисления Цикл
		
		Если СоответствиеПроверяемыхСпособовВычисления[СтрПВ.СпособВычисленияПараметра]<>Истина Тогда
			Продолжить;
		КонецЕсли; 
		
		Если СтрПВ.ИмяПараметра = "Сценарий" Тогда
			//не выгружаются значения сценария в поставке, если задан отбор по ссылке 
			Продолжить;	
		КонецЕсли;
		
		Попытка
			ТекЗначение = СтрПВ.УточнениеСпособаОпределения.Получить();
		Исключение
			//битое хранилище значения, считаем что есть ссылка, чтобы не рассчитывать хеш, и не продолжаем
			ЕстьОтборПоСсылке = Истина;
			Прервать;
		КонецПопытки;
		
		Если ТипЗнч(ТекЗначение) = ТипСписок Тогда
			Для Каждого СтрСписка Из ТекЗначение Цикл
				Если СтрСписка.Значение = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ТекТип = ТипЗнч(СтрСписка.Значение);
				Если ОбщегоНазначения.ЭтоСсылка(ТекТип)
					И ТипыПеречислений.СодержитТип(ТекТип) = Ложь Тогда
				
					ЕстьОтборПоСсылке = Истина;
					Прервать;	
				КонецЕсли;	
			КонецЦикла;
		Иначе
			Если ТекЗначение <> Неопределено Тогда
				
				ТекТип = ТипЗнч(ТекЗначение);
				Если ОбщегоНазначения.ЭтоСсылка(ТекТип)
					И ТипыПеречислений.СодержитТип(ТекТип) = Ложь Тогда
				
					ЕстьОтборПоСсылке = Истина;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьОтборПоСсылке Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьОтборПоСсылке;
	
КонецФункции

#КонецЕсли