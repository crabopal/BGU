&НаКлиенте
Перем ТекстЗаголовкаСообщений;

&НаКлиенте
Перем РедактируетсяТекущаяСтрока;

&НаКлиенте
Перем ЖелаемЗакрытьФормуБезСохраненияДанных;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "Организация, Дата, ИФО");
	
	ДокументОбъект = Новый Структура();
	ДокументОбъект.Вставить("Организация", Организация);
	
	НастройкиДляФормы = Документы.ИнвентаризацияМЗ.ПолучитьНастройкиВсехГруппДляФормыРедактированияГруппСчетов(ДокументОбъект);
	
	ТаблицаВсехГруппСчетов.Загрузить(НастройкиДляФормы["ТаблицаНастроек"]);
	
	// Статистика
	ЗаполнитьЗначенияСвойств(ЭтаФорма, НастройкиДляФормы["Статистика"]);
	
	// Ограничение выбора счета
	// (допустимо указывать лишь возможные пользовательские группы счетов)
	МассивПараметров = Новый Массив();
	НовыйПараметр = Новый ПараметрВыбора("ОграниченияСписокСчетов", НастройкиДляФормы["СписокВыбораСчета"]);
	МассивПараметров.Добавить(НовыйПараметр);
	НовыйПараметр = Новый ПараметрВыбора("ВидСравненияВСписке", Истина);
	МассивПараметров.Добавить(НовыйПараметр);
	Элементы["ТаблицаВсехГруппСчетовОсновнойСчетГруппы"].ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	
	УстановитьУсловноеОформление();
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы["ФормаЗаписать"].Доступность			= Ложь;
		Элементы["СписокПереместитьВверх"].Доступность	= Ложь;
		Элементы["СписокПереместитьВниз"].Доступность	= Ложь;
		
		ТекстСообщения = НСтр("ru='Не указана организация.
			|Отключена возможность задать пользовательские группы счетов.
			|Показаны лишь предопределенные группы счетов.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Счета учета для инвентаризации МЗ'");
	
	НайтиИВыбратьТекущуюСтроку();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	ПроверитьМодифицированностьИЗакрыть(Отказ);
	
КонецПроцедуры
	
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Отказ = ЕстьОшибкиЗаполнения();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
//Код процедур и функций
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаВсехГруппСчетов
&НаКлиенте
Процедура ТаблицаВсехГруппСчетовПриИзменении(Элемент)
	
	Если РедактируетсяТекущаяСтрока = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьНомераСтрок();
	
	ОбновитьСтатистику();

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВсехГруппСчетовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Копирование Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВсехГруппСчетовПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекДанные = Элементы["ТаблицаВсехГруппСчетов"].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные["ГруппаСчетовПредопределенная"] Тогда
		// Предопределенные группы счетов удалять нельзя
		Возврат;
	КонецЕсли;
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ИндексСтроки", ТаблицаВсехГруппСчетов.Индекс(ТекДанные));
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Удалить из списка?
			|
			|%1'"),
		ТекДанные["Наименование"]);
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ТаблицаВсехГруппСчетовПередУдалением_Ответ", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ТаблицаВсехГруппСчетовПередУдалением_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ТаблицаВсехГруппСчетов.Удалить(ПараметрыОповещения["ИндексСтроки"]);
		ЭтаФорма.Модифицированность = Истина;
		
		ОбновитьНомераСтрок();
		
		ОбновитьСтатистику()
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВсехГруппСчетовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	РедактируетсяТекущаяСтрока = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВсехГруппСчетовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	РедактируетсяТекущаяСтрока = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВсехГруппСчетовОсновнойСчетГруппыПриИзменении(Элемент)
	
	ТекДанные = Элементы["ТаблицаВсехГруппСчетов"].ТекущиеДанные;
	
	НастройкиГруппыСчетов = ПолучитьНастройкиГруппыСчетов(ТекДанные["ОсновнойСчетГруппы"]);
	
	ЗаполнитьЗначенияСвойств(ТекДанные, НастройкиГруппыСчетов);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВсехГруппСчетовИспользуетсяДополнительноеСубконтоПриИзменении(Элемент)
	
	ТекДанные = Элементы["ТаблицаВсехГруппСчетов"].ТекущиеДанные;
	
	УстановленФлажок		= ТекДанные["ИспользуетсяДополнительноеСубконто"];
	ЗначениеЕдинственное	= (ТекДанные["ПотенциальныеДополнительныеСубконто"].Количество() = 1);
	
	НовоеЗначение			= Неопределено;
	
	Если УстановленФлажок И ЗначениеЕдинственное Тогда
		НовоеЗначение		= ТекДанные["ПотенциальныеДополнительныеСубконто"][0];
	КонецЕсли;
	
	ТекДанные["ДополнительноеСубконто"] = НовоеЗначение;
	
	УстановитьАвтоматическиЗаголовокДополнительногоСубконто(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВсехГруппСчетовДополнительноеСубконтоПриИзменении(Элемент)
	
	ТекДанные = Элементы["ТаблицаВсехГруппСчетов"].ТекущиеДанные;
	
	УстановитьАвтоматическиЗаголовокДополнительногоСубконто(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВсехГруппСчетовДополнительноеСубконтоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МассивЗначений = Элементы["ТаблицаВсехГруппСчетов"].ТекущиеДанные["ПотенциальныеДополнительныеСубконто"];
	
	ДанныеВыбора = Новый СписокЗначений();
	ДанныеВыбора.ЗагрузитьЗначения(Новый Массив(МассивЗначений));
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВсехГруппСчетовЗаголовокДополнительногоСубконтоПриИзменении(Элемент)
	
	ТекДанные = Элементы["ТаблицаВсехГруппСчетов"].ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекДанные["ЗаголовокДополнительногоСубконто"]) Тогда
		УстановитьАвтоматическиЗаголовокДополнительногоСубконто(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	
	ПроверитьЗаполнениеИЗаписатьВРегистр();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьВРегистр()
	
	Если КоличествоСтрокПользовательские > 0 Тогда
		НаборЗаписей = РегистрыСведений.ДополнительныеГруппыСчетовИнвентаризацииМЗ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор["Организация"].Установить(Организация);
		
		НПП = -1;
		Для Каждого СтрокаТаблицы Из ТаблицаВсехГруппСчетов Цикл
			Если СтрокаТаблицы["ГруппаСчетовПредопределенная"] Тогда
				Продолжить;
			КонецЕсли;
			
			НПП = НПП + 1;
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись["НПП"]									= НПП;
			НоваяЗапись["Организация"]							= Организация;
			НоваяЗапись["СчетГруппа"]							= СтрокаТаблицы["ОсновнойСчетГруппы"];
			НоваяЗапись["СубконтоДляМОЛ"]						= СтрокаТаблицы["СубконтоДляМОЛ"];
			НоваяЗапись["ИспользуетсяДополнительноеСубконто"]	= СтрокаТаблицы["ИспользуетсяДополнительноеСубконто"];
			НоваяЗапись["ДополнительноеСубконто"]				= СтрокаТаблицы["ДополнительноеСубконто"];
			НоваяЗапись["ЗаголовокДополнительногоСубконто"]		= СтрокаТаблицы["ЗаголовокДополнительногоСубконто"];
		КонецЦикла;
		
		Попытка
			НаборЗаписей.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не удалось записать дополнительные группы счетов учета! Возможно, нет доступа по записи.'"));
			Возврат Ложь;
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЦветТолькоПросмотр = Новый Цвет(96, 96, 96);
	
	//
	// Предопределенная группа счетов
	//
	НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = "Предопределенная группа счетов - разрешен только просмотр";
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетов.ГруппаСчетовПредопределенная");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		ЦветТолькоПросмотр);
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетов");
	
	
	//
	// Субконто для МОЛ
	//
	НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = "Единственно возможное значение Субконто для МОЛ - недоступно изменение";
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетов.КоличествоПотенциальныхСубконтоДляМОЛ");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = 1;
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		ЦветТолькоПросмотр);
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетовСубконтоДляМОЛ");
	
	
	// 
	// Дополнительное субконто
	//
	НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = "Не используется доп.субконто - недоступны реквизиты доп. субконто";
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетов.ИспользуетсяДополнительноеСубконто");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетовДополнительноеСубконто");
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетовЗаголовокДополнительногоСубконто");
	
	
	НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = "Единственно возможное значение Дополнительного субконто - недоступно изменение";
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетов.КоличествоПотенциальныхДополнительныхСубконто");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = 1;
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		ЦветТолькоПросмотр);
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетовДополнительноеСубконто");
	
	
	НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = "Отсутствуют вообще возможные значения Дополнительного субконто - недоступен весь блок доп.субконто";
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетов.КоличествоПотенциальныхДополнительныхСубконто");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = 0;
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетов.ИспользуетсяДополнительноеСубконто");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		ЦветТолькоПросмотр);
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",	Истина);
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетовИспользуетсяДополнительноеСубконто");
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетовДополнительноеСубконто");
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетовЗаголовокДополнительногоСубконто");
	
	
	НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = "Существует несколько возможных значений Дополнительного субконто - текст <Несколько видов>";
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетов.КоличествоПотенциальныхДополнительныхСубконто");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	Условие.ПравоеЗначение = 1;
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетов.ДополнительноеСубконто");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Условие.ПравоеЗначение = Истина;
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетов.ИспользуетсяДополнительноеСубконто");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",			НСтр("ru='<Несколько видов>'"));
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",		ЦветТолькоПросмотр);
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаВсехГруппСчетовДополнительноеСубконто");
	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьАвтоматическиЗаголовокДополнительногоСубконто(ТекущиеДанные)
	
	СледуетИспользоватьНесколькоЗначений = (ТекущиеДанные["ИспользуетсяДополнительноеСубконто"]
		И ТекущиеДанные["КоличествоПотенциальныхДополнительныхСубконто"] > 1);
		
	ПараметрыОпределенияЗаголовка = Новый Структура();
	ПараметрыОпределенияЗаголовка.Вставить("ВидСубконто",							ТекущиеДанные["ДополнительноеСубконто"]);
	ПараметрыОпределенияЗаголовка.Вставить("СледуетИспользоватьНесколькоЗначений",	СледуетИспользоватьНесколькоЗначений);
	
	НовоеЗначение = ОпределитьАвтоматическиЗаголовокДополнительногоСубконто(ПараметрыОпределенияЗаголовка);
	
	ТекущиеДанные["ЗаголовокДополнительногоСубконто"] = НовоеЗначение;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьАвтоматическиЗаголовокДополнительногоСубконто(ПараметрыОпределенияЗаголовка)
	
	Возврат Документы.ИнвентаризацияМЗ.ОпределитьАвтоматическиЗаголовокДополнительногоСубконто(ПараметрыОпределенияЗаголовка);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНастройкиГруппыСчетов(ОсновнойСчетГруппы)
	
	Возврат Документы.ИнвентаризацияМЗ.ПолучитьНастройкиОднойГруппыДляФормыРедактированияГруппСчетов(ОсновнойСчетГруппы);
	
КонецФункции

&НаКлиенте
Процедура ТаблицаВсехГруппСчетовСубконтоДляМОЛНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МассивЗначений = Элементы["ТаблицаВсехГруппСчетов"].ТекущиеДанные["ПотенциальныеСубконтоДляМОЛ"];
	
	ДанныеВыбора = Новый СписокЗначений();
	ДанныеВыбора.ЗагрузитьЗначения(Новый Массив(МассивЗначений));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНомераСтрок()
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТаблицы Из ТаблицаВсехГруппСчетов Цикл
		НомерСтроки = НомерСтроки + 1;
		
		СтрокаТаблицы["НомерГруппы"] = НомерСтроки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатистику()
	
	КоличествоСтрокПользовательские = ТаблицаВсехГруппСчетов.Количество() - КоличествоСтрокПредопределенные;
	
КонецПроцедуры

&НаСервере
Функция ЕстьОшибкиЗаполнения()
	
	Если КоличествоСтрокПользовательские = 0 Тогда
		// Выходим сразу, т.к. проверяются лишь пользовательские группы счетов
		// Ошибок заполнения нет
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	
	ТаблицаИмя				= "ТаблицаВсехГруппСчетов";
	ТаблицаПредставление	= НСтр("ru='Группы счетов учета'");
	
	ТекстШаблонПустоеПоле			= НСтр("ru='Поле ""[ПолеПредставление]"" не заполнено (строка [НомерСтроки])'");
	ТекстШаблонНекорректноеЗначение	= НСтр("ru='Указано некорректное значение ""[ПолеПредставление]"" ([ОписаниеОшибки]; строка [НомерСтроки])'");
	ТекстШаблонСубконтоСовпадают	= НСтр("ru='Поле ""[ПолеПредставление]"" совпадает с полем ""[ПолеПредставление2]"" (строка [НомерСтроки])'");
	
	ВставляемыеЗначения = Новый Структура();
	
	Для Каждого СтрокаТаблицы Из ТаблицаВсехГруппСчетов Цикл
		Если СтрокаТаблицы["ГруппаСчетовПредопределенная"] Тогда
			// Предопределенные группы счетов не проверяем
			Продолжить;
		КонецЕсли;
		
		НомерСтроки		= СтрокаТаблицы["НомерГруппы"];
		ИндексСтрокой	= Формат(НомерСтроки - 1, "ЧГ=0");
		
		//
		// Пустое поле ОсновнойСчетГруппы
		//
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы["ОсновнойСчетГруппы"]) Тогда
			ЕстьОшибки = Истина;
			
			ПолеИмя				= "ОсновнойСчетГруппы";
			ПолеПредставление	= "Группа счетов";
			
			ВставляемыеЗначения.Вставить("ПолеПредставление",	ПолеПредставление);
			ВставляемыеЗначения.Вставить("НомерСтроки",			НомерСтроки);
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстШаблонПустоеПоле, ВставляемыеЗначения);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				,
				ТаблицаИмя + "[" + ИндексСтрокой + "]." + ПолеИмя);
		КонецЕсли;
		
		//
		// Пустое поле СубконтоДляМОЛ
		// 
		Если ЗначениеЗаполнено(СтрокаТаблицы["ОсновнойСчетГруппы"])
			И НЕ ЗначениеЗаполнено(СтрокаТаблицы["СубконтоДляМОЛ"]) Тогда
			ЕстьОшибки = Истина;
			
			ПолеИмя				= "СубконтоДляМОЛ";
			ПолеПредставление	= "Субконто для МОЛ";
			
			ВставляемыеЗначения.Вставить("ПолеПредставление",	ПолеПредставление);
			ВставляемыеЗначения.Вставить("НомерСтроки",			НомерСтроки);
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстШаблонПустоеПоле, ВставляемыеЗначения);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				,
				ТаблицаИмя + "[" + ИндексСтрокой + "]." + ПолеИмя);
		КонецЕсли;
		
		//
		// Некорректное значение поля СубконтоДляМОЛ
		//
		ВыполнятьПроверку = ЗначениеЗаполнено(СтрокаТаблицы["СубконтоДляМОЛ"]);
		ЗначениеКорректное = ЗначениеЗаполнено(СтрокаТаблицы["СубконтоДляМОЛ"])
			И НЕ СтрокаТаблицы["ПотенциальныеСубконтоДляМОЛ"].Найти(СтрокаТаблицы["СубконтоДляМОЛ"]) = Неопределено;
		Если ВыполнятьПроверку И НЕ ЗначениеКорректное Тогда
			ЕстьОшибки = Истина;
			
			ПолеИмя				= "СубконтоДляМОЛ";
			ПолеПредставление	= "Субконто для МОЛ";
			
			ВставляемыеЗначения.Вставить("ПолеПредставление",	ПолеПредставление);
			ВставляемыеЗначения.Вставить("НомерСтроки",			НомерСтроки);
			ВставляемыеЗначения.Вставить("ОписаниеОшибки",		НСтр("ru='Значение отсутствует в списке допустимых значений'"));

			ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстШаблонНекорректноеЗначение, ВставляемыеЗначения);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				,
				ТаблицаИмя + "[" + ИндексСтрокой + "]." + ПолеИмя);
		КонецЕсли;
			
		//
		// Проверки поля ДополнительноеСубконто
		//
		КорректностьНастроек = Документы.ИнвентаризацияМЗ.ПроверитьКорректностьНастроекДополнительногоСубконто(
			СтрокаТаблицы,
			СтрокаТаблицы["ПотенциальныеДополнительныеСубконто"]);
			
		// Некорректное значение 
		Если НЕ КорректностьНастроек["НастройкиКорректные"] Тогда
			ЕстьОшибки = Истина;
			
			ПолеИмя				= "ДополнительноеСубконто";
			ПолеПредставление	= "Дополнительное субконто";
			
			ВставляемыеЗначения.Вставить("ПолеПредставление",	ПолеПредставление);
			ВставляемыеЗначения.Вставить("НомерСтроки",			НомерСтроки);
			ВставляемыеЗначения.Вставить("ОписаниеОшибки",		КорректностьНастроек["ОписаниеОшибки"]);
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстШаблонНекорректноеЗначение, ВставляемыеЗначения);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				,
				ТаблицаИмя + "[" + ИндексСтрокой + "]." + ПолеИмя);
		КонецЕсли;
		
		// Значение, совпадающее со значением СубконтоДляМОЛ
		Если КорректностьНастроек["НастройкиКорректные"]
			И ЗначениеЗаполнено(СтрокаТаблицы["ДополнительноеСубконто"])
			И ЗначениеЗаполнено(СтрокаТаблицы["СубконтоДляМОЛ"])
			И СтрокаТаблицы["ДополнительноеСубконто"] = СтрокаТаблицы["СубконтоДляМОЛ"] Тогда
			
			ЕстьОшибки = Истина;
			
			ПолеИмя				= "ДополнительноеСубконто";
			ПолеПредставление	= "Дополнительное субконто";
			ПолеПредставление2	= "Субконто для МОЛ";
			
			ВставляемыеЗначения.Вставить("ПолеПредставление",	ПолеПредставление);
			ВставляемыеЗначения.Вставить("ПолеПредставление2",	ПолеПредставление2);
			ВставляемыеЗначения.Вставить("НомерСтроки",			НомерСтроки);
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстШаблонСубконтоСовпадают, ВставляемыеЗначения);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				,
				ТаблицаИмя + "[" + ИндексСтрокой + "]." + ПолеИмя);
		КонецЕсли;
	КонецЦикла;
		
	//
	// Дубли строк
	//
	ТаблицаДублейСтрок = УчетНДС.НайтиДублиСтрок(ТаблицаВсехГруппСчетов, "ОсновнойСчетГруппы");
	
	Если ТаблицаДублейСтрок.Количество() > 0 Тогда
		ЕстьОшибки = Истина;
		
		ПараметрыВывода = Новый Структура();
		ПараметрыВывода.Вставить("ТаблицаИмя",					"ТаблицаВсехГруппСчетов");
		ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений",	"ОсновнойСчетГруппы");
		
		УчетНДС.ВывестиСообщенияОДубляхСтрок(ТаблицаДублейСтрок, ПараметрыВывода);
	КонецЕсли;
	
	
	Возврат ЕстьОшибки;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьЗаполнениеИЗаписатьВРегистр()
	
	Если НЕ ПроверитьЗаполнение() Тогда
		// Не закрываем форму при наличии ошибок заполнения
		
		Возврат;
	КонецЕсли;
	
	Если ЗаписатьВРегистр() Тогда
		// Закрываем форму, изменения успешно сохранены
		
		ЭтаФорма.Модифицированность = Ложь;
		ЭтаФорма.Закрыть();
		
		// Оповещаем форму документа "Инвентаризация МЗ"
		ИмяСобытия	= "ЗаписанСписокДополнительныхГруппСчетовУчета";
		Параметр	= Организация;
		Оповестить(ИмяСобытия, Параметр);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМодифицированностьИЗакрыть(Отказ)
	
	Если НЕ ЭтаФорма.Модифицированность
		ИЛИ ЖелаемЗакрытьФормуБезСохраненияДанных = Истина Тогда
		// Не отменяем выполняющееся закрытие формы,
		// Форма закроется автоматически
		
	Иначе
		Отказ = Истина;
		
		ТекстСообщения = НСтр("ru='Данные были изменены. Сохранить изменения?'");
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьМодифицированностьИЗакрыть_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНетОтмена, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Отмена);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМодифицированностьИЗакрыть_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Сначала записываем данные, затем закрываем форму
		
		ПроверитьЗаполнениеИЗаписатьВРегистр();
		
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		// Закрываем форму без сохранения
		
		ЖелаемЗакрытьФормуБезСохраненияДанных = Истина;
		
		ЭтаФорма.Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиИВыбратьТекущуюСтроку()
	
	Поиск = Новый Структура("ОсновнойСчетГруппы", Параметры["СчетГруппа"]);
	
	МассивСтрок = ТаблицаВсехГруппСчетов.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		ТекущаяСтрока = МассивСтрок[0].ПолучитьИдентификатор();
		
		Элементы["ТаблицаВсехГруппСчетов"].ТекущаяСтрока = ТекущаяСтрока;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
