&НаКлиенте
Перем ЗакрытьФормуБезусловно;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Перем	СтруктураНастроек,
			СтруктураЗначенияЗаполнения;
	
	Если Параметры.Свойство("ПомощникВводаПлановыхПоказателей", СтруктураНастроек) Тогда
		// Так как не все измерения заполняются из данных заполнения, устанавливаем их значения вручную
		Если СтруктураНастроек.Свойство("ЗначенияЗаполнения", СтруктураЗначенияЗаполнения) Тогда
			Для Каждого Элемент Из СтруктураЗначенияЗаполнения Цикл
				ИмяПоля			= Элемент.Ключ;
				ЗначениеПоля	= Элемент.Значение;
				
				Запись[ИмяПоля] = ЗначениеПоля;
			КонецЦикла;
		КонецЕсли;
		
		// Настраиваем форму
		ЭтаФорма.Заголовок					= НСтр("ru='Назначение плана поступлений и выбытий'");
		ЭтаФорма.АвтоЗаголовок				= Ложь;
		Элементы["Учреждение"].Доступность	= Ложь;
	КонецЕсли;
	
	Элементы.УточнениеПоказателя.Видимость = Запись.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ");
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи); 
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	// Эмулируем стандартное закрытие формы, но с одной разницей -
	// - чтобы форма при закрытии возвратила значение.
	//
	// Используется в Помощнике ввода плановых показателей.
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗакрытьФормуБезусловно = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		Отказ = Истина;
		
		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = НСтр("ru='Данные были изменены. Все изменения будут потеряны.'");
			Возврат;
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru='Данные были изменены. Сохранить изменения?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПередЗакрытиемКлиент_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да, , КодВозвратаДиалога.Нет);
		
	Иначе
		ЗакрытьФормуБезусловно = Истина;
		
		ЭтаФорма.Закрыть(ПолучитьВозвращаемоеЗначение());
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидПоказателяПриИзменении(Элемент)
	
	Если  Запись.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") Тогда
		Элементы.УточнениеПоказателя.Видимость = Истина;
	Иначе
		Элементы.УточнениеПоказателя.Видимость = Ложь;
		Запись.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.ПустаяСсылка");
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередЗакрытиемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗакрытьФормуБезусловно = Истина;
		
		ЭтаФорма.Закрыть(ПолучитьВозвращаемоеЗначение());
		
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		ЗакрытьФормуБезусловно = Истина;
		
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьВозвращаемоеЗначение()
	
	// Все поля записи
	ВозвращаемоеЗначение = Новый Структура("
		|Организация,
		|КФО,
		|ВидПоказателя,
		|Субсидия,
		|ИФО,
		|УточнениеПоказателя,
		|ПланПоступленийВыбытий");
		
	ЗаполнитьЗначенияСвойств(ВозвращаемоеЗначение, Запись);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#КонецОбласти

