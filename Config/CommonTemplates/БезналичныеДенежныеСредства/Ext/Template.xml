////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕПСБУОстаткиИОбороты.КПС,
	ЕПСБУОстаткиИОбороты.КЭК,
	ВЫРАЗИТЬ(ЕПСБУОстаткиИОбороты.Субконто1 КАК Справочник.РазделыЛицевыхСчетов).ИсточникСредств КАК ИсточникСредств,
	ВЫРАЗИТЬ(ЕПСБУОстаткиИОбороты.Субконто1 КАК Справочник.РазделыЛицевыхСчетов).Владелец КАК ЛицевойСчет,
	ВЫБОР
		КОГДА ЕПСБУОстаткиИОбороты.Счет В (&amp;Счет20111)
			ТОГДА ЕПСБУОстаткиИОбороты.СуммаКонечныйОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК ОстатокКО,
	ВЫБОР
		КОГДА ЕПСБУОстаткиИОбороты.Счет В (&amp;Счет501)
			ТОГДА ЕПСБУОстаткиИОбороты.СуммаОборотКт
		ИНАЧЕ 0
	КОНЕЦ КАК ЛимитБО,
	ВЫБОР
		КОГДА ЕПСБУОстаткиИОбороты.Счет В (&amp;Счет503)
			ТОГДА ЕПСБУОстаткиИОбороты.СуммаОборотКт
		ИНАЧЕ 0
	КОНЕЦ КАК Ассигнования,
	ВЫБОР
		КОГДА ЕПСБУОстаткиИОбороты.Счет В (&amp;Счет304)
			ТОГДА ЕПСБУОстаткиИОбороты.СуммаОборотКт - ЕПСБУОстаткиИОбороты.СуммаОборотДт
		ИНАЧЕ 0
	КОНЕЦ КАК Исполнено,
	0 КАК Зарезервировано
ПОМЕСТИТЬ СводнаяТаблица
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
			&amp;Старт,
			{(&amp;Стоп)},
			,
			,
			Счет В (&amp;Счет20111)
				ИЛИ Счет В (&amp;Счет501)
				ИЛИ Счет В (&amp;Счет503)
				ИЛИ Счет В (&amp;Счет304),
			,
			ВЫБОР
				КОГДА &amp;Организация &lt;&gt; НЕОПРЕДЕЛЕНО
					ТОГДА Организация = &amp;Организация
				ИНАЧЕ Организация В
						(ВЫБРАТЬ
							СписокОрганизаций.Ссылка
						ИЗ
							СписокОрганизаций КАК СписокОрганизаций)
			КОНЕЦ) КАК ЕПСБУОстаткиИОбороты

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	БезналичныеДенежныеСредстваОстатки.КПС,
	БезналичныеДенежныеСредстваОстатки.КЭК,
	БезналичныеДенежныеСредстваОстатки.ИсточникСредств,
	БезналичныеДенежныеСредстваОстатки.ЛицевойСчет,
	0,
	0,
	0,
	0,
	БезналичныеДенежныеСредстваОстатки.ЗарезервированоОстаток
ИЗ
	РегистрНакопления.БезналичныеДенежныеСредства.Остатки(
			,
			ВЫБОР
				КОГДА &amp;Организация &lt;&gt; НЕОПРЕДЕЛЕНО
					ТОГДА ЛицевойСчет.Владелец = &amp;Организация
				ИНАЧЕ ЛицевойСчет.Владелец В
						(ВЫБРАТЬ
							СписокОрганизаций.Ссылка
						ИЗ
							СписокОрганизаций КАК СписокОрганизаций)
			КОНЕЦ) КАК БезналичныеДенежныеСредстваОстатки
;

