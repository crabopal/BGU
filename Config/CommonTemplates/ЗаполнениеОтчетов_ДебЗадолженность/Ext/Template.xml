					<v8:content>Аванс процентом</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ОбъединениеДанных.ВидРасчетов КАК ВидРасчетов,
	ОбъединениеДанных.КФО КАК КФО,
	ОбъединениеДанных.Организация КАК Организация,
	ОбъединениеДанных.ИФО КАК ИФО,
	ОбъединениеДанных.Счет КАК Счет,
	ОбъединениеДанных.Контрагент КАК Контрагент,
	ОбъединениеДанных.Договор КАК Договор,
	ОбъединениеДанных.Сумма КАК Сумма,
	ВЫРАЗИТЬ(ЕСТЬNULL(ДоговорыДР_Срок.Значение, ДАТАВРЕМЯ(1, 1, 1)) КАК ДАТА) КАК СрокИсполнения,
	ВЫРАЗИТЬ(ЕСТЬNULL(ДоговорыДР_Просрочен.Значение, ЛОЖЬ) КАК БУЛЕВО) КАК Просрочен
ПОМЕСТИТЬ ОстаткиДЗПредв
{ВЫБРАТЬ
	Счет.*,
	Контрагент.*,
	Договор.*,
	Организация.*,
	ИФО.*,
	КФО.*,
	Сумма}
ИЗ
	(ВЫБРАТЬ
		"206" КАК ВидРасчетов,
		ЕПСБУОстатки.КФО КАК КФО,
		ЕПСБУОстатки.Организация КАК Организация,
		ЕПСБУОстатки.ИФО КАК ИФО,
		ЕПСБУОстатки.Счет КАК Счет,
		ЕПСБУОстатки.Субконто1 КАК Контрагент,
		ВЫБОР
			КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.Договоры
				ТОГДА ЕПСБУОстатки.Субконто2
			КОГДА ЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Договоры
				ТОГДА ЕПСБУОстатки.Субконто3
			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		КОНЕЦ КАК Договор,
		СУММА(ЕПСБУОстатки.СуммаОстатокДт) КАК Сумма
	ИЗ
		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({(&amp;ПериодОтчета)}, Счет В (&amp;Счета206) {(Счет).*}, , {(ИФО).* КАК ИФО, (Организация).* КАК Организация}) КАК ЕПСБУОстатки
	
	СГРУППИРОВАТЬ ПО
		ЕПСБУОстатки.КФО,
		ЕПСБУОстатки.Организация,
		ЕПСБУОстатки.ИФО,
		ЕПСБУОстатки.Счет,
		ЕПСБУОстатки.Субконто1,
		ВЫБОР
			КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.Договоры
				ТОГДА ЕПСБУОстатки.Субконто2
			КОГДА ЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Договоры
				ТОГДА ЕПСБУОстатки.Субконто3
			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		КОНЕЦ
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		"209",
		ЕПСБУОстатки.КФО,
		ЕПСБУОстатки.Организация,
		ЕПСБУОстатки.ИФО,
		ЕПСБУОстатки.Счет,
		ЕПСБУОстатки.Субконто1,
		ВЫБОР
			КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.Договоры
				ТОГДА ЕПСБУОстатки.Субконто2
			КОГДА ЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Договоры
				ТОГДА ЕПСБУОстатки.Субконто3
			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		КОНЕЦ,
		СУММА(ЕПСБУОстатки.СуммаОстатокДт)
	ИЗ
		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({(&amp;ПериодОтчета)}, Счет В (&amp;Счета20930) {(Счет).*}, , {(ИФО).* КАК ИФО, (Организация).* КАК Организация}) КАК ЕПСБУОстатки
	
	СГРУППИРОВАТЬ ПО
		ЕПСБУОстатки.КФО,
		ЕПСБУОстатки.Организация,
		ЕПСБУОстатки.ИФО,
		ЕПСБУОстатки.Счет,
		ЕПСБУОстатки.Субконто1,
		ВЫБОР
			КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.Договоры
				ТОГДА ЕПСБУОстатки.Субконто2
			КОГДА ЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Договоры
				ТОГДА ЕПСБУОстатки.Субконто3
			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		КОНЕЦ) КАК ОбъединениеДанных
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры.ДополнительныеРеквизиты КАК ДоговорыДР_Срок
		ПО ОбъединениеДанных.Договор = ДоговорыДР_Срок.Ссылка
			И (ДоговорыДР_Срок.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ОкончаниеДоговора))
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры.ДополнительныеРеквизиты КАК ДоговорыДР_Просрочен
		ПО ОбъединениеДанных.Договор = ДоговорыДР_Просрочен.Ссылка
			И (ДоговорыДР_Просрочен.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ДоговорПросрочен))
ГДЕ
	ОбъединениеДанных.Сумма &gt; 0
{ГДЕ
	ОбъединениеДанных.Сумма,
	ОбъединениеДанных.Счет.*,
	ОбъединениеДанных.ИФО.*,
	ОбъединениеДанных.КФО.*,
	ОбъединениеДанных.Организация.*,
	ОбъединениеДанных.Контрагент.*,
	ОбъединениеДанных.Договор.*,
	ОбъединениеДанных.ВидРасчетов}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СрокИсполненияИСуммаДоговоровСрезПоследних.Обязательство КАК Договор,
	СрокИсполненияИСуммаДоговоровСрезПоследних.Сумма КАК Сумма,
	СрокИсполненияИСуммаДоговоровСрезПоследних.АвансПроцентом КАК АвансПроцентом,
	СрокИсполненияИСуммаДоговоровСрезПоследних.СрокИсполнения КАК СрокИсполнения,
	ВЫБОР
		КОГДА СрокИсполненияИСуммаДоговоровСрезПоследних.СрокИсполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
				И НАЧАЛОПЕРИОДА(СрокИсполненияИСуммаДоговоровСрезПоследних.СрокИсполнения, ДЕНЬ) &lt; &amp;КонецПериодаДата
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК Просрочен
ПОМЕСТИТЬ СрокиИСуммы
ИЗ
	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(
			{(&amp;КонецПериодаДата)},
			Обязательство В
				(ВЫБРАТЬ
					Таб.Договор
				ИЗ
					ОстаткиДЗПредв КАК Таб)) КАК СрокИсполненияИСуммаДоговоровСрезПоследних
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОстаткиДЗПредв.ВидРасчетов КАК ВидРасчетов,
	ОстаткиДЗПредв.КФО КАК КФО,
	ОстаткиДЗПредв.Организация КАК Организация,
	ОстаткиДЗПредв.ИФО КАК ИФО,
	ОстаткиДЗПредв.Счет КАК Счет,
	ОстаткиДЗПредв.Контрагент КАК Контрагент,
	ОстаткиДЗПредв.Договор КАК Договор,
	ОстаткиДЗПредв.Сумма КАК Сумма,
	ВЫБОР
		КОГДА &amp;СрокИзРегистра
			ТОГДА СрокиИСуммы.СрокИсполнения
		ИНАЧЕ ОстаткиДЗПредв.СрокИсполнения
	КОНЕЦ КАК СрокИсполнения,
	ВЫБОР
		КОГДА &amp;СрокИзРегистра
			ТОГДА СрокиИСуммы.Просрочен
		ИНАЧЕ ОстаткиДЗПредв.Просрочен
	КОНЕЦ КАК Просрочен
ПОМЕСТИТЬ ОстаткиДЗ
ИЗ
	ОстаткиДЗПредв КАК ОстаткиДЗПредв
		ЛЕВОЕ СОЕДИНЕНИЕ СрокиИСуммы КАК СрокиИСуммы
		ПО ОстаткиДЗПредв.Договор = СрокиИСуммы.Договор
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОстаткиДЗ.ВидРасчетов КАК ВидРасчетов,
	ОстаткиДЗ.КФО КАК КФО,
	ОстаткиДЗ.Счет КАК Счет,
	ОстаткиДЗ.Организация КАК Организация,
	ОстаткиДЗ.ИФО КАК ИФО,
	ОстаткиДЗ.Контрагент КАК Контрагент,
	ОстаткиДЗ.Договор КАК Договор,
	ОстаткиДЗ.Сумма КАК Всего,
	ОстаткиДЗ.СрокИсполнения КАК СрокИсполнения,
	ОстаткиДЗ.Просрочен КАК Просрочен,
	ЕСТЬNULL(СрокиИСуммы.Сумма, 0) КАК СуммаОбязательства,
	ВЫБОР
		КОГДА НЕ ОстаткиДЗ.СрокИсполнения ЕСТЬ NULL
				И НЕ ОстаткиДЗ.СрокИсполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
				И НАЧАЛОПЕРИОДА(ОстаткиДЗ.СрокИсполнения, ДЕНЬ) &lt; &amp;НачалоДняДляРасчетов
			ТОГДА ОстаткиДЗ.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаПросрочено,
	ВЫБОР
		КОГДА НЕ ОстаткиДЗ.СрокИсполнения ЕСТЬ NULL
				И НЕ ОстаткиДЗ.СрокИсполнения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
