// Чтение сериализованного объекта XDTO из строки в формате XML
//
Функция ПрочитатьXMLИзСтроки(Строка) Экспорт
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Строка);
	ЧтениеXML.ПерейтиКСодержимому();
	
	Возврат СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	
КонецФункции // ПрочитатьXMLИзСтроки() 

// Функция формирует массив «на лету».
//
Функция Массив(Значение1, Значение2 = Неопределено, Значение3 = Неопределено,
	Значение4 = Неопределено, Значение5 = Неопределено, Значение6 = Неопределено,
	Значение7 = Неопределено, Значение8 = Неопределено, Значение9 = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	Структура = Новый Структура("Значение1,Значение2,Значение3,Значение4,Значение5,Значение6,Значение7,Значение8,Значение9",
		Значение1,Значение2,Значение3,Значение4,Значение5,Значение6,Значение7,Значение8,Значение9);							

	Для Н = 1 По 9 Цикл
		
		Значение = Структура["Значение" + Н];
		
		Если Значение = Неопределено Тогда
			Прервать;
			
		ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
			
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Значение);
			
		Иначе
			Результат.Добавить(Значение)
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // Массив()

// Возвращает различные характеристики ссылочного типа.
//
// Параметры:
//  ТипМетаданные - Тип, ОбъектМетаданных - ссылочный тип или метаданные.
//  КлассХарактеристик - Строка - "Имена", "Менеджеры" или "Типы" - инструкция
//                 функции о том, какие характеристики требуются - только имена
//                 вида, типа и таблицы («Имена»), менеджеры в дополнение
//                 к этому («Менеджеры»), типы - <Вид>Ссылка.<Имя>
//                 и <Вид>Объект.<Имя> («Типы»).
// КлючевыеРеквизиты - Булево - заполнить массив ключевых реквизитов (объектами
//                 со свойствами «Имя» (Строка) и «Тип» (ОписаниеТипов)).
//
// Возвращаемое значение:
//  Структура. Не все члены могут быть заполнены, зависит от заказанного класса.
//
Функция ПолучитьХарактеристикиТипа(ТипМетаданные, КлассХарактеристик = "Типы", КлючевыеРеквизиты = Ложь) Экспорт
	
	Результат = Новый Структура("ОбъектМетаданных, ИмяВида, ИмяТипа, ИмяТаблицы, МенеджерВида, Менеджер, ТипСсылки, ТипОбъекта, КлючевыеРеквизиты");
	
	Если ТипЗнч(ТипМетаданные) = Тип("ОбъектМетаданных") Тогда
		Результат.ОбъектМетаданных = ТипМетаданные
	Иначе
		Результат.ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипМетаданные);
	КонецЕсли;
	
	ПолноеИмя = Результат.ОбъектМетаданных.ПолноеИмя();
	
	КомпонентыИмениТаблицы = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПолноеИмя, ".");
	
	Если КомпонентыИмениТаблицы.Количество() > 1 Тогда
		
		Если КомпонентыИмениТаблицы.Количество() = 4 Тогда // таб. часть
			
			Результат.ИмяВида = КомпонентыИмениТаблицы[2]; // = "ТабличнаяЧасть"
			Результат.ИмяТипа = КомпонентыИмениТаблицы[3];
			Результат.ИмяТаблицы = КомпонентыИмениТаблицы[0] + "." + КомпонентыИмениТаблицы[1] + "." + КомпонентыИмениТаблицы[3];
			
		Иначе
			
			Результат.ИмяВида = КомпонентыИмениТаблицы[0];
			Результат.ИмяТипа = КомпонентыИмениТаблицы[1];
			Результат.ИмяТаблицы = ПолноеИмя;
			
		КонецЕсли;
		
		Если КлючевыеРеквизиты Тогда
			
			Результат.КлючевыеРеквизиты = Новый Массив;
			Если Результат.ИмяВида = "Справочник" Тогда
				
				Если Результат.ОбъектМетаданных.КонтрольУникальности Тогда
					Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип",
						"Код",
						ПолучитьОписаниеТиповКодаНомера(Результат.ОбъектМетаданных.ТипКода, Результат.ОбъектМетаданных.ДлинаКода)));
					Если Результат.ОбъектМетаданных.СерииКодов = Метаданные.СвойстваОбъектов.СерииКодовСправочника.ВПределахПодчинения Тогда
						Результат.КлючевыеРеквизиты.Добавить(
							Новый Структура("Имя, Тип",
								"Родитель",
								Новый ОписаниеТипов(
									Массив(
										ТипЗнч(
											Справочники[Результат.ИмяТипа].ПустаяСсылка()
										)
									)
								)
							)
						);
					ИначеЕсли Результат.ОбъектМетаданных.СерииКодов = Метаданные.СвойстваОбъектов.СерииКодовСправочника.ВПределахПодчиненияВладельцу Тогда
						МассивТиповВладельцев = Новый Массив;
						Для Каждого Владелец Из Результат.ОбъектМетаданных.Владельцы Цикл
							МассивТиповВладельцев.Добавить(ПолучитьХарактеристикиТипа(Владелец, "Типы").ТипСсылки);
						КонецЦикла;
						Результат.КлючевыеРеквизиты.Вставить("Владелец", Новый ОписаниеТипов(МассивТиповВладельцев));
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли Результат.ИмяВида = "ПланСчетов" Тогда
				
				Если Результат.ОбъектМетаданных.КонтрольУникальности Тогда
					Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип",
						"Код",
						ПолучитьОписаниеТиповКодаНомера(Неопределено, Результат.ОбъектМетаданных.ДлинаКода)));
					Если Результат.ОбъектМетаданных.СерииКодов = Метаданные.СвойстваОбъектов.СерииКодовПланаСчетов.ВПределахПодчинения Тогда
						Результат.КлючевыеРеквизиты.Добавить(
							Новый Структура("Имя, Тип",
								"Родитель",
								Новый ОписаниеТипов(
									Массив(
										ТипЗнч(
											ПланыСчетов[Результат.ИмяТипа].ПустаяСсылка()
										)
									)
								)
							)
						);
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли Результат.ИмяВида = "ПланВидовХарактеристик" Тогда
				
				Если Результат.ОбъектМетаданных.КонтрольУникальности Тогда
					Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип",
						"Код",
						ПолучитьОписаниеТиповКодаНомера(Неопределено, Результат.ОбъектМетаданных.ДлинаКода)));
					Если Результат.ОбъектМетаданных.СерииКодов = Метаданные.СвойстваОбъектов.СерииКодовПланаВидовХарактеристик.ВПределахПодчинения
					   И Результат.ОбъектМетаданных.Иерархический Тогда
						Результат.КлючевыеРеквизиты.Добавить(
							Новый Структура("Имя, Тип",
								"Родитель",
								Новый ОписаниеТипов(
									Массив(
										ТипЗнч(
											ПланыВидовХарактеристик[Результат.ИмяТипа].ПустаяСсылка()
										)
									)
								)
							)
						);
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли Результат.ИмяВида = "ПланВидовРасчета" Тогда
				
				Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип",
					"Код",
					ПолучитьОписаниеТиповКодаНомера(Результат.ОбъектМетаданных.ТипКода, Результат.ОбъектМетаданных.ДлинаКода)));
				
			ИначеЕсли Результат.ИмяВида = "Документ" Тогда
				
				ОбъектМетаданных = ?(Результат.ОбъектМетаданных.Нумератор <> Неопределено,
					Результат.ОбъектМетаданных.Нумератор,
					Результат.ОбъектМетаданных);
				Если ОбъектМетаданных.КонтрольУникальности Тогда
					Результат.КлючевыеРеквизиты.Добавить(
						Новый Структура("Имя, Тип",
							"Номер",
							ПолучитьОписаниеТиповКодаНомера(ОбъектМетаданных.ТипНомера, ОбъектМетаданных.ДлинаНомера)));
					Если ОбъектМетаданных.ПериодичностьНомера <> Метаданные.СвойстваОбъектов.ПериодичностьНомераДокумента.Непериодический Тогда
						Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип", "Дата", Новый ОписаниеТипов("Дата")));
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли Результат.ИмяВида = "БизнесПроцесс" Тогда
				
				Если Результат.ОбъектМетаданных.КонтрольУникальности Тогда
					Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип",
						"Номер",
						ПолучитьОписаниеТиповКодаНомера(ОбъектМетаданных.ТипНомера, ОбъектМетаданных.ДлинаНомера)));
					Если Результат.ОбъектМетаданных.ПериодичностьНомера <> Метаданные.СвойстваОбъектов.ПериодичностьНомераБизнесПроцесса.Непериодический Тогда
						Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип", "Дата", Новый ОписаниеТипов("Дата")));
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли Результат.ИмяВида = "Задача" Тогда
				
				Если Результат.ОбъектМетаданных.КонтрольУникальности Тогда
					Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип",
						"Номер",
						ПолучитьОписаниеТиповКодаНомера(ОбъектМетаданных.ТипНомера, ОбъектМетаданных.ДлинаНомера)));
				КонецЕсли;
				
			ИначеЕсли Результат.ИмяВида = "ПланОбмена" Тогда
				
				Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип",
					"Код",
					ПолучитьОписаниеТиповКодаНомера(Неопределено, ОбъектМетаданных.ДлинаКода)));
				
			ИначеЕсли Результат.ИмяВида = "РегистрСведений" Тогда
				
				Если Результат.ОбъектМетаданных.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
					
					Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип", "Регистратор", Документы.ТипВсеСсылки()));
					Результат.КлючевыеРеквизиты.Вставить(Новый Структура("Имя, Тип", "НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(6,, ДопустимыйЗнак.Неотрицательный))));
					
				Иначе
					
					Для Каждого Измерение Из Результат.ОбъектМетаданных.Измерения Цикл
						Если Измерение.ОсновнойОтбор Тогда
							Результат.КлючевыеРеквизиты.Вставить(Измерение);
						КонецЕсли;
					КонецЦикла;
					
					Если Результат.ОбъектМетаданных.ПериодичностьРегистраСведений
						<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический
						И Результат.ОбъектМетаданных.ОсновнойОтборПоПериоду Тогда
						
						Результат.КлючевыеРеквизиты.Вставить(Новый Структура("Имя, Тип", "Период", Новый ОписаниеТипов("Дата")));
						
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли Результат.ИмяВида = "РегистрНакопления" Или Результат.ИмяВида = "РегистрБухгалтерии" Или Результат.ИмяВида = "РегистрРасчета" Тогда
				
				Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип", "Регистратор", Документы.ТипВсеСсылки()));
				Результат.КлючевыеРеквизиты.Вставить(Новый Структура("Имя, Тип", "НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(6,, ДопустимыйЗнак.Неотрицательный))));
				
			ИначеЕсли Результат.ИмяВида = "ТабличнаяЧасть" Тогда
				
				Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип", "Ссылка", Новый ОписаниеТипов()));
				Результат.КлючевыеРеквизиты.Добавить(Новый Структура("Имя, Тип", "НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(6,, ДопустимыйЗнак.Неотрицательный))));
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если КлассХарактеристик = "Менеджеры" Или КлассХарактеристик = "Типы" Тогда
			
			СоответствиеВидаОбъектаМенеджеру = Новый Соответствие;
			СоответствиеВидаОбъектаМенеджеру.Вставить("ПланОбмена",             ПланыОбмена);
			СоответствиеВидаОбъектаМенеджеру.Вставить("Константа",              Константы);
			СоответствиеВидаОбъектаМенеджеру.Вставить("Справочник",             Справочники);
			СоответствиеВидаОбъектаМенеджеру.Вставить("Документ",               Документы);
			СоответствиеВидаОбъектаМенеджеру.Вставить("ЖурналДокументов",       ЖурналыДокументов);
			СоответствиеВидаОбъектаМенеджеру.Вставить("Перечисление",           Перечисления);
			СоответствиеВидаОбъектаМенеджеру.Вставить("Отчет",                  Отчеты);
			СоответствиеВидаОбъектаМенеджеру.Вставить("Обработка",              Обработки);
			СоответствиеВидаОбъектаМенеджеру.Вставить("ПланВидовХарактеристик", ПланыВидовХарактеристик);
			СоответствиеВидаОбъектаМенеджеру.Вставить("ПланСчетов",             ПланыСчетов);
			СоответствиеВидаОбъектаМенеджеру.Вставить("ПланВидовРасчета",       ПланыВидовРасчета);
			СоответствиеВидаОбъектаМенеджеру.Вставить("РегистрСведений",        РегистрыСведений);
			СоответствиеВидаОбъектаМенеджеру.Вставить("РегистрНакопления",      РегистрыНакопления);
			СоответствиеВидаОбъектаМенеджеру.Вставить("РегистрБухгалтерии",     РегистрыБухгалтерии);
			СоответствиеВидаОбъектаМенеджеру.Вставить("РегистрРасчета",         РегистрыРасчета);
			СоответствиеВидаОбъектаМенеджеру.Вставить("БизнесПроцесс",          БизнесПроцессы);
			СоответствиеВидаОбъектаМенеджеру.Вставить("Задача",                 Задачи);
			
			Результат.МенеджерВида = СоответствиеВидаОбъектаМенеджеру[Результат.ИмяВида];
			Результат.Менеджер     = Результат.МенеджерВида[Результат.ИмяТипа];
			
			Если КлассХарактеристик = "Типы" Тогда
				
				Если Лев(Результат.ИмяВида, 7) = "Регистр" Тогда
					Результат.ТипОбъекта = ТипЗнч(Результат.Менеджер.СоздатьНаборЗаписей());
				ИначеЕсли Результат.ИмяВида = "Обработка" Или Результат.ИмяВида = "Отчет" Тогда
					Результат.ТипОбъекта = ТипЗнч(Результат.Менеджер.Создать());
				ИначеЕсли Результат.ИмяВида = "Константа" Тогда
					Результат.ТипОбъекта = ТипЗнч(Результат.Менеджер.СоздатьМенеджерЗначения());
				ИначеЕсли Результат.ИмяВида = "Перечисление" Тогда
					Результат.ТипСсылки = ТипЗнч(Результат.Менеджер.ПустаяСсылка());
				Иначе
					Результат.ТипСсылки  = ТипЗнч(Результат.Менеджер.ПустаяСсылка());
					Попытка
						Результат.ТипОбъекта = Тип(Результат.ИмяВида + "Объект." + Результат.ИмяТипа);
					Исключение
					КонецПопытки;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает новый объект ссылочного типа или набор записей.
//
// Параметры:
//  ХарактеристикиТипа - Структура - результат вызова функции
//                 ПолучитьХарактеристикиТипа().
//  СоздаватьГруппу - Булево - создавать группу вместо элемента (для
//                 справочников и планов видов характеристик).
//
// Возвращаемое значение:
//  Новый объект нужного типа, который может быть записан в ИБ.
//
Функция СоздатьНовыйОбъект(ХарактеристикиТипа, СоздаватьГруппу = Ложь) Экспорт
	
	Менеджер = ХарактеристикиТипа.Менеджер;
	Вид      = ХарактеристикиТипа.ИмяВида;
	
	Если Вид = "Справочник" Или Вид = "ПланВидовХарактеристик" Тогда
		
		Если СоздаватьГруппу
			И ХарактеристикиТипа.ОбъектМетаданных.Иерархический
			И Вид = "ПланВидовХарактеристик"
				Или ХарактеристикиТипа.ОбъектМетаданных.ВидИерархии
					= Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
			Результат = Менеджер.СоздатьГруппу()
		Иначе
			Результат = Менеджер.СоздатьЭлемент();
		КонецЕсли;
		
	ИначеЕсли Вид = "Документ" Тогда
		Результат = Менеджер.СоздатьДокумент();
		
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Результат = Менеджер.СоздатьСчет();
		
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Результат = Менеджер.СоздатьВидРасчета();
		
	ИначеЕсли Найти(Вид, "Регистр") = 1 Тогда
		Результат = Менеджер.СоздатьНаборЗаписей();
		
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Результат = Менеджер.СоздатьБизнесПроцесс();
		
	ИначеЕсли Вид = "Задача" Тогда
		Результат = Менеджер.СоздатьЗадачу();
		
	ИначеЕсли Вид = "Константа" Тогда
		Результат = Менеджер.СоздатьМенеджерЗначения();
		
	ИначеЕсли Вид = "Обработка" Или Вид = "Отчет" Тогда
		Результат = Менеджер.Создать();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


