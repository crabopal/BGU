// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


// ПолучитьОписаниеТиповКодаНомера()
//
// Параметры:
//  ТипКодаНомера - ПеречислимыеСвойстваОбъектаМетаданных, Неопределено.
//  Длина        - Число - длина кода или номера.
//
// Возвращаемое значение:
//  ОписаниеТипов. Описание типов для кода/номера объекта ИБ.
//
Функция ПолучитьОписаниеТиповКодаНомера(ТипКодаНомера, Длина)
	
	ПСОМД = Метаданные.СвойстваОбъектов;
	Если Массив(
		ПСОМД.ТипНомераДокумента.Число,
		ПСОМД.ТипНомераБизнесПроцесса.Число,
		ПСОМД.ТипНомераЗадачи.Число,
		ПСОМД.ТипКодаСправочника.Число,
		ПСОМД.ТипКодаПланаВидовРасчета.Число).Найти(ТипКодаНомера) <> Неопределено Тогда
		
		Возврат Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(Длина,, ДопустимыйЗнак.Неотрицательный))
		
	Иначе
		
		Возврат Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(Длина, ДопустимаяДлина.Фиксированная));
		
	КонецЕсли;
	
КонецФункции // ПолучитьОписаниеТиповКодаНомера()

#КонецЕсли