// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция СериализаторXDTOXMLТипЗнч(Значение)
	
	Результат = мСтандартныеТипы[ТипЗнч(Значение)]; // строка, число, булево, дата
	
	Если Результат = Неопределено Тогда
		Результат = СериализаторXDTO.XMLТипЗнч(Значение)
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СериализаторXDTOXMLТипЗнч()

Функция СериализаторXDTOXMLТип(Тип)
	
	Результат = мСтандартныеТипы[Тип]; // строка, число, дата, булево
	
	Если Результат = Неопределено Тогда
		Результат = СериализаторXDTO.XMLТип(Тип)
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция предназначена для создания структуры параметров, передаваемых
// функции ПрочитатьXDTO() «на лету».
//
// Возвращаемое значение:
//  Структура. Параметры чтения XDTO для одноименной функции.
//
Функция ПараметрыЧтенияXDTO(ДобавлятьОбъекты = Ложь, ОбновлятьОбъекты = Ложь, ТипЗначения = Неопределено) Экспорт
	
	Результат = Новый Соответствие;
	Результат.Вставить("ДобавлятьОбъекты", ДобавлятьОбъекты);
	Результат.Вставить("ОбновлятьОбъекты", ОбновлятьОбъекты);
	Если ТипЗначения <> Неопределено Тогда
		Результат.Вставить("ТипЗначения", ТипЗначения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбеспечитьПараметрыЧтенияXDTO(ПараметрыЧтенияXDTO)
	
	Если ТипЗнч(ПараметрыЧтенияXDTO) = Тип("Соответствие") Тогда
		Результат = ПараметрыЧтенияXDTO;
	ИначеЕсли ТипЗнч(ПараметрыЧтенияXDTO) = Тип("Структура") Тогда
		Результат = ПараметрыЧтенияXDTO();
		Для Каждого КлючИЗначение Из ПараметрыЧтенияXDTO Цикл
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение)
		КонецЦикла;
	Иначе
		Результат = ПараметрыЧтенияXDTO();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыЗаписиXDTO(XMLТипURIПространстваИменИлиРасширенноеИмяXML = Неопределено, XMLТипЛокальноеИмя = Неопределено) Экспорт
	
	Результат = Новый Соответствие;
	
	Если ТипЗнч(XMLТипURIПространстваИменИлиРасширенноеИмяXML) = Тип("РасширенноеИмяXML") Тогда
		Результат.Вставить("XMLТип", XMLТипURIПространстваИменИлиРасширенноеИмяXML);
	ИначеЕсли ТипЗнч(XMLТипURIПространстваИменИлиРасширенноеИмяXML) = Тип("Строка") Тогда
		Результат.Вставить("XMLТип", Новый РасширенноеИмяXML(XMLТипЛокальноеИмя, XMLТипURIПространстваИменИлиРасширенноеИмяXML));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбеспечитьПараметрыЗаписиXDTO(ПараметрыЗаписиXDTO)
	
	Если ТипЗнч(ПараметрыЗаписиXDTO) = Тип("Соответствие") Тогда
		Результат = ПараметрыЗаписиXDTO;
	ИначеЕсли ТипЗнч(ПараметрыЗаписиXDTO) = Тип("Структура") Тогда
		Результат = ПараметрыЗаписиXDTO();
		Для Каждого КлючИЗначение Из ПараметрыЗаписиXDTO Цикл
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение)
		КонецЦикла;
	Иначе
		Результат = ПараметрыЗаписиXDTO();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ВыбратьПодсистемыПоОбъекту(Знач Массив, Знач Подсистемы, Знач ОбъектМетаданных)
	
	Для Каждого Подсистема Из Подсистемы Цикл
		
		Если Подсистема.Состав.Содержит(ОбъектМетаданных) Тогда
			Массив.Добавить(Подсистема);
		КонецЕсли;
		
		ВыбратьПодсистемыПоОбъекту(Массив, Подсистема.Подсистемы, ОбъектМетаданных);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПодсистемыОбъектаМетаданных(Знач ОбъектМетаданных)
	
	Результат = Новый Массив;
	ВыбратьПодсистемыПоОбъекту(Результат, Метаданные.Подсистемы, ОбъектМетаданных);
	
	Возврат Результат;
	
КонецФункции

