#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда
	
Перем ПустоеЗначениеXML Экспорт;
Перем XMLТипЛюбой Экспорт;

Перем мСоответствияТипов;        // таблица значений
Перем мСозданныеСериализаторы;   // соответствие

Перем мСтандартныеТипы;

Перем мКэшКартXMLID;

Перем мФабрикаXDTO;

Перем мТипОбъектаXDTO, мТипОбъект;
Перем ЭтоЗагрузкаКомплекта Экспорт;

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура Инициализация() Экспорт
	
	Если мСоответствияТипов <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	мСозданныеСериализаторы = Новый Соответствие;
	
	мСоответствияТипов = Новый ТаблицаЗначений;
	мСоответствияТипов.Колонки.Добавить("ИмяXML",              Новый ОписаниеТипов("РасширенноеИмяXML"));
	мСоответствияТипов.Колонки.Добавить("Тип",                 Новый ОписаниеТипов("Тип"));
	мСоответствияТипов.Колонки.Добавить("ИдСозданногоОбъекта");
	мСоответствияТипов.Колонки.Добавить("ПокрытиеXML",         БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(1));
	мСоответствияТипов.Колонки.Добавить("ПокрытиеПрикладного", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(1));
	
	мСоответствияТипов.Индексы.Добавить("ПокрытиеПрикладного,ИмяXML");
	мСоответствияТипов.Индексы.Добавить("ПокрытиеXML,Тип");
	
	
	МассивИменСериализаторов = СериализацияСлужебный.ПолучитьМассивСериализаторов();
	ИмяКонфигурации = БюджетнаяОтчетностьСерверПереопределяемый.ПолучитьИмяКонфигурации();
	
	Для Каждого ИмяСериализатора из МассивИменСериализаторов Цикл
		
		МенеджерСериализатора = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Обработка."+ИмяСериализатора);
		ОбработкаОбъект = МенеджерСериализатора.Создать();
		МетаданныеОбработки = ОбработкаОбъект.Метаданные();
		
		Если Не ПравоДоступа("Использование",МетаданныеОбработки) Тогда 
			Продолжить;
		КонецЕсли;
		
		МакетНайден = Ложь;
		
		Для Каждого МакетСоответствий Из МетаданныеОбработки.Макеты Цикл
			
			Если Найти(МакетСоответствий.Имя, "СоответствияТиповТипамXML") <> 1 Тогда
				Продолжить;
			КонецЕсли;
			
			// Отсеим макеты, работающие в других конфигурациях.
			Если Не ПустаяСтрока(МакетСоответствий.Комментарий) Тогда 
				МассивПотребителей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(МакетСоответствий.Комментарий, ",");
				ЭтоЧужойМакет = Истина;
				Для Каждого Потребитель из МассивПотребителей Цикл 
					
					Если Найти(СокрЛП(Потребитель) , ИмяКонфигурации) = 0 Тогда 
						Продолжить;
					КонецЕсли;
					
					ЭтоЧужойМакет = Ложь;
					Прервать;
					
				КонецЦикла;
				
				Если ЭтоЧужойМакет Тогда 
					Продолжить;
				КонецЕсли;	
				
			КонецЕсли;
			
			ТекстМакета = МенеджерСериализатора.ПолучитьМакет(МакетСоответствий).ПолучитьТекст();
			ТаблицаСоответствийОбработки = Обработки.ДиспетчерСериализации.ПрочитатьXMLИзСтроки(ТекстМакета);
			
			МакетНайден = Истина;
			
			Прервать;
			
		КонецЦикла;	
		
		Если не МакетНайден Тогда 
			Продолжить;
		КонецЕсли;	
		
		мСозданныеСериализаторы.Вставить(МетаданныеОбработки, ОбработкаОбъект);
		
		ОбработкаОбъект.мДиспетчерXDTO = ЭтотОбъект;
		
		Для Каждого СтрокаСоответствия Из ТаблицаСоответствийОбработки Цикл
			
			ЗаписьСоответствия = мСоответствияТипов.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаписьСоответствия, СтрокаСоответствия);
			ЗаписьСоответствия.ИдСозданногоОбъекта = МетаданныеОбработки;
			
		КонецЦикла;

		
	КонецЦикла;	
	
		
	
КонецПроцедуры // Инициализация()

Функция ПолучитьXMLТипИзТипа(Тип, ТипРезультата =  Неопределено) Экспорт
	
	Результат = ПолучитьXMLТипИзТипаВнутр(Тип);
	
	Если Результат = Неопределено Тогда
		Результат = СериализаторXDTOXMLТип(Тип);
	КонецЕсли;
	
	Если ТипРезультата = Неопределено Тогда
		ТипРезультата = Тип("ТипДанныхXML");
	КонецЕсли;
	
	Если Результат <> Неопределено И ТипЗнч(Результат) <> ТипРезультата Тогда
		ЛокальноеИмя = ?(ТипЗнч(Результат) = Тип("ТипДанныхXML"), Результат.ИмяТипа, Результат.ЛокальноеИмя);
		Если ТипРезультата = Тип("РасширенноеИмяXML") Тогда
			Результат = Новый РасширенноеИмяXML(Результат.URIПространстваИмен, ЛокальноеИмя);
		Иначе
			Результат = Новый ТипДанныхXML(ЛокальноеИмя, Результат.URIПространстваИмен);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьXMLТип()

Функция ПолучитьТипИзXMLТипа(XMLТип) Экспорт
	
	Если ТипЗнч(XMLТип) = Тип("ТипДанныхXML") Тогда
		ИмяXML = Новый РасширенноеИмяXML(XMLТип.URIПространстваИмен, XMLТип.ИмяТипа);
	Иначе
		ИмяXML = XMLТип;
	КонецЕсли;
	
	Возврат ПолучитьТипИзXMLТипаВнутр(ИмяXML);
	
КонецФункции

// ПолучитьXMLТипЗнч()
//
// Параметры:
//  Значение     - Произвольный - значение, тип XML которого нужно получить.
//
// Возвращаемое значение:
//  ТипДанныхXML, Неопределено.
//
Функция ПолучитьXMLТипЗнч(Значение, ТипРезультата) Экспорт
	
	Результат = ПолучитьXMLТипЗнчВнутр(Значение);
	
	Если Результат = Неопределено Тогда
		Результат = СериализаторXDTOXMLТипЗнч(Значение)
	КонецЕсли;
	
	Если ТипРезультата = Неопределено Тогда
		ТипРезультата = Тип("ТипДанныхXML");
	КонецЕсли;
	
	Если Результат <> Неопределено И ТипЗнч(Результат) <> ТипРезультата Тогда
		ЛокальноеИмя = ?(ТипЗнч(Результат) = Тип("ТипДанныхXML"), Результат.ИмяТипа, Результат.ЛокальноеИмя);
		Если ТипРезультата = Тип("РасширенноеИмяXML") Тогда
			Результат = Новый РасширенноеИмяXML(Результат.URIПространстваИмен, ЛокальноеИмя)
		Иначе
			Результат = Новый ТипДанныхXML(ЛокальноеИмя, Результат.URIПространстваИмен)
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьXMLТипЗнч()

// Сериализует значение в XDTO.
//
// Параметры:
//  Значение    - Произвольный - значение, которое нужно представить в XDTO.
//  XMLТип      - РасширенноеИмяXML - имя XML-типа, в котором нужно отобразить
//                значение.
//  ПараметрыЗаписи - Произвольный - специфические параметры, передаваемые
//                обработке-сериализатору.
//
// Возвращаемое значение:
//  ОбъектXDTO, ЗначениеXDTO, Неопределено. Результат сериализации объекта.
//
Функция ЗаписатьXDTO(Значение, ПараметрыЗаписиXDTO = Неопределено) Экспорт
	
	Инициализация();
	
	Попытка
		
		Возврат ЗаписатьXDTOВнутр(Значение, ПараметрыЗаписиXDTO)
		
	Исключение
		
		ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ЗаписатьXDTO()
			НСтр("ru = 'Не удается отобразить ‘%Значение%’ в XDTO.'; en = 'Cannot cast ‘%Значение%’ to XDTO.'"),
			Новый Структура("Значение", Строка(Значение)),
			ИнформацияОбОшибке(),
			"{urn:entities-1c-ru:serialization/errors}SDXC0100", // #err: Ошибка при записи
			Значение);
		
	КонецПопытки;
	
КонецФункции // ЗаписатьXDTO()

// Преобразовывает объект XDTO в значение.
//
// Параметры:
//  ОбъектXDTO   - ОбъектXDTO - читаемый объект.
//  ТипЗначения  - Тип - требуемый тип результата.
//  ПараметрыЧтения - Произвольный - специфические параметры, передаваемые
//                 обработке-сериализатору.
//
// Возвращаемое значение:
//  Произвольный, Неопределено. Прочитанное значение. Неопределено - если
//  значению не найдено соответствия в ИБ.
//
Функция ПрочитатьXDTO(ОбъектXDTO, ПараметрыЧтенияXDTO = Неопределено) Экспорт
	
	Инициализация();
	
	Попытка
		
		Возврат ПрочитатьXDTOВнутр(ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	Исключение
		
		ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ПрочитатьXDTO()
			НСтр("ru = 'Объект XDTO ‘%ПредставлениеОбъекта%’ не может быть прочитан.'; en = 'Error while reading ‘%ПредставлениеОбъекта%’ XDTO object.'"),
			Новый Структура("ПредставлениеОбъекта", ПолучитьПредставлениеОбъектаXDTO(ОбъектXDTO)),
			ИнформацияОбОшибке(),
			"{urn:entities-1c-ru:serialization/errors}SDXC0200" // #err: Ошибка при чтении
			);
		
	КонецПопытки;
	
КонецФункции // ПрочитатьXDTO()

// Читает свойства объекта XDTO в регистр сведений СвойстваОбъектов.
//
// Параметры:
//  ОбъектXDTO   - ОбъектXDTO - читаемый объект.
//  ПараметрыЧтения - Произвольный - специфические параметры, передаваемые
//                 обработке-сериализатору.
