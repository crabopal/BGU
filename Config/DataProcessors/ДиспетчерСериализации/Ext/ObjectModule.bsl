Функция XDTOПолучить(ОбъектXDTO, ВыражениеXPath, Список = Ложь) Экспорт
	
	Попытка
		Если Список Тогда
			Возврат ОбъектXDTO.ПолучитьСписок(ВыражениеXPath)
		Иначе
			Возврат ОбъектXDTO.ПолучитьXDTO(ВыражениеXPath)
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецФункции // XDTOПолучить()

Процедура ЗаполнитьКартуXMLID(КартаXMLID, ОбъектXDTO)
	
	Если ТипЗнч(ОбъектXDTO) <> мТипОбъект Тогда
		Возврат;
	КонецЕсли;
	
	ВсеСвойства = ОбъектXDTO.Свойства();
	Если ВсеСвойства.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Свойство_id = ВсеСвойства.Получить("id");
	Если Свойство_id<>Неопределено Тогда
		Если Свойство_id.Форма = ФормаXML.Атрибут
			И Свойство_id.URIПространстваИмен = "http://www.w3.org/XML/1998/namespace" Тогда
			ЗначениеИдентификатора = ОбъектXDTO.Получить(Свойство_id);
			Если Не ПустаяСтрока(ЗначениеИдентификатора) Тогда
				КартаXMLID[ЗначениеИдентификатора] = ОбъектXDTO
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Свойство Из ВсеСвойства Цикл
				
		Если ТипЗнч(Свойство.Тип) = мТипОбъектаXDTO Тогда
			Если Свойство.ВерхняяГраница = 1 Тогда
				ЗаполнитьКартуXMLID(КартаXMLID, ОбъектXDTO.ПолучитьXDTO(Свойство));
			Иначе
				Для Каждого ЗначениеСвойства Из ОбъектXDTO.ПолучитьСписок(Свойство) Цикл
					ЗаполнитьКартуXMLID(КартаXMLID, ЗначениеСвойства);
				КонецЦикла;
			КонецЕсли;		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСоздатьКартуXMLID(ОбъектXDTO)
	
	Если мКэшКартXMLID = Неопределено Тогда
		мКэшКартXMLID = Новый Соответствие;
	КонецЕсли;
	
	КартаXMLID = мКэшКартXMLID[ОбъектXDTO];
	
	Если КартаXMLID = Неопределено Тогда
		
		КартаXMLID = Новый Соответствие;
		ЗаполнитьКартуXMLID(КартаXMLID, ОбъектXDTO);
		мКэшКартXMLID.Вставить(ОбъектXDTO, КартаXMLID);
		
	КонецЕсли;
	
	Возврат КартаXMLID;
	
КонецФункции

Функция XDTOПолучитьПоID(ОбъектXDTO, XMLID) Экспорт
	
	КорневойОбъектXDTO = ОбъектXDTO.Получить("/");
	КартаXMLID = ПолучитьСоздатьКартуXMLID(КорневойОбъектXDTO);
	Возврат КартаXMLID[XMLID];
	
КонецФункции

Функция НормализоватьСтроку(Значение, ОбработкаПробельныхСимволов = "collapse") Экспорт
	
	Результат = Значение;
	
	Если ОбработкаПробельныхСимволов = "collapse" Или ОбработкаПробельныхСимволов = "replace" Тогда
		
		Результат = СтрЗаменить(Результат, Символы.Таб, " ");
		Результат = СтрЗаменить(Результат, Символы.ПС, " ");
		Результат = СтрЗаменить(Результат, Символы.ПФ, " ");
		
	КонецЕсли;
	
	Если ОбработкаПробельныхСимволов = "collapse" Тогда
		
		Результат = СокрЛП(Результат);
		Р = "";
		Пока Р <> Результат Цикл
			Р = Результат;
			Результат = СтрЗаменить(Результат, "  ", " ");
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПредставлениеОбъектаXDTO(ОбъектXDTO) Экспорт
	
	Если ТипЗнч(ОбъектXDTO) <> Тип("ОбъектXDTO") Тогда
		Возврат НСтр("ru = '<узел не указан>'; en = '<no node>'");
	Иначе
		
		Результат = "";
		
		Свойство = ОбъектXDTO.ВладеющееСвойство();
		ТекЗначениеСвойства = ОбъектXDTO;
		
		Пока Свойство <> Неопределено Цикл
			
			ПредставлениеСвойства = Свойство.Имя;
			
			Если Свойство.ВерхняяГраница <> 1 Тогда
				Индекс = 1;
				Для Каждого ЭлементСписка Из ТекЗначениеСвойства.Владелец().ПолучитьСписок(Свойство) Цикл
					Если ЭлементСписка = ТекЗначениеСвойства Тогда
						Прервать;
					КонецЕсли;
					Индекс = Индекс + 1;
				КонецЦикла;
				ПредставлениеСвойства = ПредставлениеСвойства + "[" + Формат(Индекс, "ЧГ=0") + "]";
			КонецЕсли;
			
			Результат = "/" + ПредставлениеСвойства + Результат;
			
			ТекЗначениеСвойства = ТекЗначениеСвойства.Владелец();
			Свойство = ТекЗначениеСвойства.ВладеющееСвойство();
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет принадлежность объекта XDTO типу XDTO.
//
// Параметры:
//  ОбъектXDTO   - ОбъектXDTO, ЗначениеXDTO - проверяемый объект.
//  XMLТип       - РасширенноеИмяXML, ТипДанныхXML - имя типа.
//
// Возвращаемое значение:
//  Булево.
//
Функция ОбъектXDTOСоответствуетТипу(ОбъектXDTO, XMLТип, ФабрикаXDTO) Экспорт
	
	Если ОбъектXDTO = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипXDTO = ФабрикаXDTO.Тип(XMLТип);
	ТипОбъектаXDTO = ОбъектXDTO.Тип();
	
	// ТипЗначенияXDTO и ТипОбъектаXDTO - несовместимы
	Если ТипЗнч(ТипОбъектаXDTO) <> ТипЗнч(ТипXDTO) Тогда
		
		// Если проверяется принадлежность к xs:anyType, то всегда Истина.
		Если ТипXDTO.URIПространстваИмен = "http://www.w3.org/2001/XMLSchema"
		   И ТипXDTO.Имя = "anyType" Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТипXDTO = ТипОбъектаXDTO Или ТипXDTO.ЭтоПотомок(ТипОбъектаXDTO);
	
КонецФункции // ОбъектXDTOСоответствуетТипу() 

// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ МЕХАНИЗМА КОНТРОЛЯ ОШИБОК

Функция ОшибкаНеожиданныйXMLТип(ОбъектXDTO, ОжидаемыеТипы)
	
	СтрокаСписокТипов = "";
	Для Каждого ОжидаемыйТип Из ОжидаемыеТипы Цикл
		СтрокаСписокТипов = СтрокаСписокТипов + ", ‘" + ОжидаемыйТип + "’";
	КонецЦикла;
	СтрокаСписокТипов = Сред(СтрокаСписокТипов, 3);
	
	Возврат ДиагностикаСлужебный.СоздатьОшибку(
		НСтр("ru='Обнаруженный XML тип узла - ‘%РеальныйТип%’ - не является ожидаемым в данном контексте; ожидаемые типы узла: %СписокТипов%'"),
		Новый Структура("РеальныйТип,СписокТипов", ОбъектXDTO.Тип(), СтрокаСписокТипов),
		,
		"{urn:entities-1c-ru:serialization/errors}SDXC0210" // #err: Неожиданный XML-тип
		);
	
КонецФункции // ОшибкаНеожиданныйXMLТип()

 // ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ МЕХАНИЗМА КОНТРОЛЯ ВХОДНЫХ ДАННЫХ

Процедура ПроверитьНаличиеПакетаXDTO(ФабрикаXDTO, URIПространстваИмен) Экспорт
	
	Если ФабрикаXDTO.Пакеты.Получить(URIПространстваИмен) = Неопределено Тогда
		
		ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ПроверитьНаличиеПакетаXDTO()
			НСтр("ru = 'Конфигурация не содержит пакета XDTO пространства имен ‘%URIПространстваИмен’.'"),
			Новый Структура("URIПространстваИмен", URIПространстваИмен),,
			"{urn:entities-1c-ru:serialization/errors}SDXC0050" // #err: Не обнаружен необходимый XDTO-пакет.
			);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьXMLТипОбъекта(ОбъектXDTO, ОжидаемыеТипы, ФабрикаXDTO, ВызыватьИсключение = Истина) Экспорт
	
	Перем Результат;
	
	Если ТипЗнч(ОжидаемыеТипы) = Тип("Массив") Тогда
		МассивОжидаемыхТипов = ОжидаемыеТипы;
	Иначе
		МассивОжидаемыхТипов = Обработки.ДиспетчерСериализации.Массив(ОжидаемыеТипы);
	КонецЕсли;
	
	Для Каждого ОжидаемыйТип Из МассивОжидаемыхТипов Цикл
		Если ОбъектXDTOСоответствуетТипу(ОбъектXDTO, ОжидаемыйТип, ФабрикаXDTO) Тогда
			Результат = ОжидаемыйТип;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Результат = Неопределено И ВызыватьИсключение Тогда
		ВызватьИсключение ОшибкаНеожиданныйXMLТип(ОбъектXDTO, Обработки.ДиспетчерСериализации.Массив(ОжидаемыеТипы));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьЗаказанныйТип(ЗаказанныйТип, ВозможныеТипы, ОбъектXDTO, ВызыватьИсключение = Истина) Экспорт
	
	Если ТипЗнч(ВозможныеТипы) = Тип("Массив") Тогда
		МассивВозможныхТипов = ВозможныеТипы;
	Иначе
		МассивВозможныхТипов = Обработки.ДиспетчерСериализации.Массив(ВозможныеТипы);
	КонецЕсли;
	
	Если ЗаказанныйТип = Неопределено Тогда
		
		Возврат МассивВозможныхТипов[0];
		
	ИначеЕсли ТипЗнч(ЗаказанныйТип) = Тип("Тип") Тогда
		
		Индекс = МассивВозможныхТипов.Найти(ЗаказанныйТип);
		Если Индекс <> Неопределено Тогда
			Возврат ЗаказанныйТип; // ВозможныеТипы[Индекс]
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ЗаказанныйТип) = Тип("ОписаниеТипов") Тогда
		
		Для Каждого ВозможныйТип Из МассивВозможныхТипов Цикл
			Если ЗаказанныйТип.СодержитТип(ВозможныйТип) Тогда
				Возврат ВозможныйТип
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ВызыватьИсключение Тогда
		
		ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку(
			НСтр("ru = 'Узел XML типа ‘%ИмяXML%’ невозможно отобразить в тип «%ТипЗначения%»'"),
			Новый Структура("ИмяXML,ТипЗначения", ОбъектXDTO.Тип(), ЗаказанныйТип),,
			"{urn:entities-1c-ru:serialization/errors}SDXC0220" // #err: Нельзя представить заказанным типом
			);
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьXMLТипИзТипаВнутр(Тип, Сериализатор = Неопределено)
	
	// Ищем XML-типы, покрывающие область значений данного типа полностью.
	НайденныеСоответствия = мСоответствияТипов.НайтиСтроки(Новый Структура("ПокрытиеXML,Тип", 1, Тип));
	
	Для Каждого НайденноеСоответствие Из НайденныеСоответствия Цикл
		
		Если НайденноеСоответствие.ИмяXML <> Неопределено Тогда
			Возврат НайденноеСоответствие.ИмяXML;
		КонецЕсли;
		
	КонецЦикла;
	
	// Теперь ищем XML-типы, могущие отражать лишь некоторые значения данного типа.
	НайденныеСоответствия = мСоответствияТипов.НайтиСтроки(Новый Структура("ПокрытиеXML,Тип", 0, Тип));
	
	Если НайденныеСоответствия.Количество() = 1 Тогда
		Возврат НайденныеСоответствия[0].ИмяXML;
	// Считаем, что раз в системе XML-типов, частично покрывающих область значений
	// данного типа несколько, то все они в совокупности покрывают всю область
	// значений. Вернем их общего предка.
	ИначеЕсли НайденныеСоответствия.Количество() > 1 Тогда
		
		Фабрика = ПолучитьФабрикуXDTO();
		
		ПервыйXMLТип = Фабрика.Тип(НайденныеСоответствия[0].ИмяXML);
		ОбщийПредок = ПервыйXMLТип;
		
		Для Н = 1 По НайденныеСоответствия.Количество() - 1 Цикл
			
			XMLТип = Фабрика.Тип(НайденныеСоответствия[Н].ИмяXML);
			Если ТипЗнч(XMLТип) <> ТипЗнч(ОбщийПредок) Тогда
				Возврат XMLТипЛюбой;
			КонецЕсли;
			
			Если XMLТип.ЭтоПотомок(ОбщийПредок) Тогда
				ОбщийПредок = XMLТип;
			ИначеЕсли XMLТип <> ОбщийПредок Тогда
				Пока ОбщийПредок <> Неопределено И Не ОбщийПредок.ЭтоПотомок(XMLТип) Цикл
					ОбщийПредок = ОбщийПредок.БазовыйТип;
				КонецЦикла;
			КонецЕсли;
			
			Если ОбщийПредок = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат Новый РасширенноеИмяXML(ОбщийПредок.URIПространстваИмен, ОбщийПредок.Имя)
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТипИзXMLТипаВнутр(XMLТип, Сериализатор = Неопределено)
	
	НайденныеСоответствия = мСоответствияТипов.НайтиСтроки(Новый Структура("ПокрытиеПрикладного,ИмяXML", 1, XMLТип));
	
	Для Каждого НайденноеСоответствие Из НайденныеСоответствия Цикл
		
		Если НайденноеСоответствие.Тип <> Неопределено Тогда
			Возврат НайденноеСоответствие.Тип;
		КонецЕсли;
		
	КонецЦикла;
	
	НайденныеСоответствия = мСоответствияТипов.НайтиСтроки(Новый Структура("ПокрытиеПрикладного,ИмяXML", 0, XMLТип));
	
	Если НайденныеСоответствия.Количество() = 1 Тогда
		Возврат НайденныеСоответствия[0].Тип;
	ИначеЕсли НайденныеСоответствия.Количество() > 1 Тогда
		
		Тип = НайденныеСоответствия[0].Тип;
		Для Н = 1 По НайденныеСоответствия.Количество() - 1 Цикл
			
			Если НайденныеСоответствия[Н].Тип <> Тип Тогда
				Возврат Неопределено
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат Тип;
		
	КонецЕсли;
	
	Возврат СериализаторXDTO.ИзXMLТипа(XMLТип.ЛокальноеИмя, XMLТип.URIПространстваИмен);
	
КонецФункции

// ПолучитьXMLТипЗнчВнутр()
//
// Параметры:
//  Значение     - Произвольный - значение, тип XML которого нужно получить.
//  Сериализатор - ОбработкаОбъект - (вых.) обработка-сериализатор.
//
// Возвращаемое значение:
//  РасширенноеИмяXML, Неопределено.
//
Функция ПолучитьXMLТипЗнчВнутр(Значение, Сериализатор = Неопределено)
	
	ТипыXMLКандидаты = Новый Массив;
	ТекТипЗначения = ТипЗнч(Значение);
	// Ищем XML-типы, покрывающие область значений данного типа полностью.
	НайденныеСоответствия = мСоответствияТипов.НайтиСтроки(Новый Структура("ПокрытиеXML,Тип", 1, ТекТипЗначения));
	
	Для Каждого НайденноеСоответствие Из НайденныеСоответствия Цикл
		
		Сериализатор = мСозданныеСериализаторы[НайденноеСоответствие.ИдСозданногоОбъекта];
		ТипXML = Сериализатор.ПолучитьXMLТипЗнч(Значение);
		
		Если ТипXML <> Неопределено Тогда
			Возврат ТипXML;
		Иначе
			ТипыXMLКандидаты.Добавить(НайденноеСоответствие.ИмяXML);
		КонецЕсли;
		
	КонецЦикла;
	
	МассивСтрокТип0 = мСоответствияТипов.НайтиСтроки(Новый Структура("ПокрытиеXML,Тип", 0, ТекТипЗначения));
	Если МассивСтрокТип0.Количество()>0 Тогда
		
		// Теперь ищем XML-типы, могущие отражать лишь некоторые значения данного типа.
		НайденныеСоответствия = мСоответствияТипов.Скопировать(МассивСтрокТип0,"ИмяXML,ИдСозданногоОбъекта");
		НайденныеСоответствия.Колонки.Добавить("Поколение", Новый ОписаниеТипов("Число"));
		
		Фабрика = ПолучитьФабрикуXDTO();
		
		Для Каждого НайденноеСоответствие Из НайденныеСоответствия Цикл
			
			XMLТип = Фабрика.Тип(НайденноеСоответствие.ИмяXML);
			
			Поколение = 0;
			Пока XMLТип.БазовыйТип <> Неопределено Цикл
				Поколение = Поколение + 1;
				XMLТип = XMLТип.БазовыйТип;
			КонецЦикла;
			
			НайденноеСоответствие.Поколение = Поколение;
			
		КонецЦикла;
		
		НайденныеСоответствия.Сортировать("Поколение Убыв");
		
		Для Каждого НайденноеСоответствие Из НайденныеСоответствия Цикл
			
			Сериализатор = мСозданныеСериализаторы[НайденноеСоответствие.ИдСозданногоОбъекта];
			ТипXML = Сериализатор.ПолучитьXMLТипЗнч(Значение);
			
			Если ТипXML <> Неопределено Тогда
				Возврат ТипXML;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого ТипXMLКандидат Из ТипыXMLКандидаты Цикл
		
		
		
	КонецЦикла;
	
	Возврат ТипXMLКандидат;
	
КонецФункции

Функция ЗаписатьXDTOВнутр(Значение, ПараметрыЗаписиXDTO)
	
	Перем Сериализатор;
	
	Инициализация();
	
	Если Значение = Неопределено Тогда Возврат Неопределено КонецЕсли;
	
	РабПараметрыЗаписиXDTO = ОбеспечитьПараметрыЗаписиXDTO(ПараметрыЗаписиXDTO);
	
	XMLТип = РабПараметрыЗаписиXDTO["XMLТип"];
	
	Если XMLТип = Неопределено Тогда
		XMLТип = ПолучитьXMLТипЗнчВнутр(Значение, Сериализатор);
	КонецЕсли;
	
	Если XMLТип = Неопределено Тогда
		
		ТипДанныхXML = СериализаторXDTOXMLТипЗнч(Значение);
		Если ТипДанныхXML <> Неопределено Тогда
			
			Фабрика = ПолучитьФабрикуXDTO();
			
			ТипXDTO = Фабрика.Тип(ТипДанныхXML);
			Если ТипЗнч(ТипXDTO) = Тип("ТипЗначенияXDTO") Тогда
				Возврат Фабрика.Создать(ТипXDTO, Значение);
			Иначе
				Возврат СериализаторXDTO.ЗаписатьXDTO(Значение);
			КонецЕсли;
			
		КонецЕсли;
		
		ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ЗаписатьXDTOВнутр()
			НСтр("ru = 'Отсутствует отображение для типа %Тип%."),
			Новый Структура("Тип", ТипЗнч(Значение)),,
			"{urn:entities-1c-ru:serialization/errors}SDXC0120" // #err: Тип не сериализуется
			);
		
	Иначе
		
		НайденноеСоответствие = мСоответствияТипов.Найти(XMLТип, "ИмяXML");
		Если НайденноеСоответствие <> Неопределено Тогда
			Сериализатор = мСозданныеСериализаторы[НайденноеСоответствие.ИдСозданногоОбъекта];
		КонецЕсли;
		
	КонецЕсли;
	
	Если XMLТип = ПустоеЗначениеXML Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Фабрика = Сериализатор.ПолучитьФабрикуXDTO();
	Если Фабрика = Неопределено Тогда Фабрика = ФабрикаXDTO КонецЕсли;
	
	Попытка
		ТипXDTO = Фабрика.Тип(XMLТип);
	Исключение
		ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ЗаписатьXDTOВнутр()
			НСтр("ru = 'Фабрика XDTO сериализатора не содержит тип ‘%XMLТип%’."), Новый Структура("XMLТип", XMLТип),
			Неопределено, // создаваемая ошибка не следствие возникшего исключения, а его более информативная версия
			"{urn:entities-1c-ru:serialization/errors}SDXC0083" //# err: Не найден XML-тип
			);
	КонецПопытки;
	
	Объект = Неопределено;
	Попытка
		
		РабПараметрыЗаписиXDTO.Удалить("XMLТип");
		Если ТипЗнч(ТипXDTO) = Тип("ТипЗначенияXDTO") Тогда
			XMLСтрока = Сериализатор.ПодготовитьЗначениеXDTO(ТипXDTO, Значение, РабПараметрыЗаписиXDTO);
			ОбъектПодготовлен = XMLСтрока <> Неопределено;
			Если ОбъектПодготовлен Тогда
				Объект = Фабрика.Создать(ТипXDTO, XMLСтрока);
			КонецЕсли;
		Иначе //Если ТипЗнч(ТипXDTO) = Тип("ТипОбъектаXDTO") Тогда
			Объект = Фабрика.Создать(ТипXDTO);
			ОбъектПодготовлен = Сериализатор.ПодготовитьОбъектXDTO(Объект, Значение, РабПараметрыЗаписиXDTO);
		КонецЕсли;
		ПричинаОшибки = Неопределено;
		
	Исключение
		ОбъектПодготовлен = Ложь;
		ПричинаОшибки = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ОбъектПодготовлен Тогда
		ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ЗаписатьXDTOВнутр()
			НСтр("ru = 'Значение ‘%Значение%’ не было корректно преобразовано в XDTO (имя сериализатора: «%Сериализатор%»).'"),
			Новый Структура("Сериализатор, Значение", Сериализатор.Метаданные().Представление(), Значение),
			ПричинаОшибки,
			"{urn:entities-1c-ru:serialization/errors}SDXC0140", // #err: Сериализатор не подготовил объект
			);
	КонецЕсли;
	
	Возврат Объект;
	
КонецФункции // ЗаписатьXDTOВнутр()

Функция ПрочитатьXDTOВнутр(ОбъектXDTO, ПараметрыЧтенияXDTO)
	
	Перем Сериализатор;
	
	Если ОбъектXDTO = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Инициализация();
	
	ТипXDTO = ОбъектXDTO.Тип();
	
	Пока ТипXDTO <> Неопределено Цикл
		
		НайденныеСоответствия = мСоответствияТипов.НайтиСтроки(Новый Структура("ИмяXML",
			Новый РасширенноеИмяXML(ТипXDTO.URIПространстваИмен, ТипXDTO.Имя)));
		
		Если НайденныеСоответствия.Количество() > 0 Тогда
			
			Сериализатор = мСозданныеСериализаторы[НайденныеСоответствия[0].ИдСозданногоОбъекта];
			Прервать;
			
		КонецЕсли;
		
		ТипXDTO = ТипXDTO.БазовыйТип;
		
	КонецЦикла;
	
	Если Сериализатор <> Неопределено Тогда
		ПараметрыЧтения = ОбеспечитьПараметрыЧтенияXDTO(ПараметрыЧтенияXDTO);
		Если ТипЗнч(ТипXDTO) = Тип("ТипЗначенияXDTO") Тогда
			Возврат Сериализатор.ПрочитатьЗначениеXDTO(ОбъектXDTO, ПараметрыЧтения);
		Иначе
			Возврат Сериализатор.ПрочитатьОбъектXDTO(ОбъектXDTO, ПараметрыЧтения);
		КонецЕсли;
	Иначе
		Если ТипЗнч(ОбъектXDTO.Тип()) = Тип("ТипЗначенияXDTO") Тогда
			Возврат ОбъектXDTO.Значение;
		Иначе
			Возврат СериализаторXDTO.ПрочитатьXDTO(ОбъектXDTO);
		КонецЕсли;
	КонецЕсли;
	
КонецФункции // ПрочитатьXDTOВнутр()

