
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокПользователейПараметр = Неопределено;
	Параметры.Свойство("СписокПользователей", СписокПользователейПараметр);
	Параметры.Свойство("Организация", Организация); 
	
	Если ЗначениеЗаполнено(СписокПользователейПараметр) Тогда
		СписокПользователей.ЗагрузитьЗначения(СписокПользователейПараметр);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СформироватьЛистОзнакомления(Команда)
	
	УведомленияОбИспользованииПЭП = ШаблонУведомленияОбИспользованииПЭП(Организация,
		СписокПользователей.ВыгрузитьЗначения(), ДобавитьВыбранныхПользователейВРеестрКлючейПЭП);
	
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("УведомленияОбИспользованииПЭП");
	ОписаниеПечатнойФормы = УправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, "УведомленияОбИспользованииПЭП"); 
	ОписаниеПечатнойФормы.ТабличныйДокумент = УведомленияОбИспользованииПЭП;
	
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм);
	
	Закрыть();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ШаблонУведомленияОбИспользованииПЭП(Организация, Пользователи, ДобавитьПользователейВРеестр)
	
	Если ДобавитьПользователейВРеестр Тогда
		ДобавитьПользователейВРеестрКлючейПЭП(Организация, Пользователи);
	КонецЕсли;
	
	Возврат ВнутреннийЭДО.ШаблонУведомленияОбИспользованииПЭП(Организация, Пользователи);
	
КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьПользователейВРеестрКлючейПЭП(Организация, Пользователи)
	
	ДатаУведомления = НачалоДня(ТекущаяДатаСеанса());
	
	// поиск непересекающихся записей
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.РеестрКлючейПростыхЭлектронныхПодписей.СрезПоследних(
	|			&ДатаУведомления,
	|			Организация = &Организация
	|				И Пользователь В (&Пользователи)) КАК РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних
	|ГДЕ
	|	РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних.ДатаОтзыва = ДАТАВРЕМЯ(1, 1, 1)
	|	ИЛИ РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних.ДатаОтзыва >= &ДатаУведомления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних.Пользователь
	|ИЗ
	|	РегистрСведений.РеестрКлючейПростыхЭлектронныхПодписей.СрезПоследних(
	|			,
	|			Организация = &Организация
	|				И Пользователь В (&Пользователи)) КАК РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Пользователи", Пользователи);
	Запрос.УстановитьПараметр("ДатаУведомления", ДатаУведомления);
	
	ПользователиСПересечениемПоПериоду = Новый Соответствие;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПользователиСПересечениемПоПериоду.Вставить(Выборка.Пользователь, Истина);
	КонецЦикла;
	
	Для Каждого Пользователь Из Пользователи Цикл
		
		Если Не ЗначениеЗаполнено(Пользователь) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПользователиСПересечениемПоПериоду[Пользователь] <> Неопределено Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Ключ простой электронной подписи пользователя ""%1"" уже есть в реестре'"),
				Пользователь);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.РеестрКлючейПростыхЭлектронныхПодписей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(Организация);
		НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
		
		Запись = НаборЗаписей.Добавить();
		Запись.Период = ДатаУведомления;
		Запись.Организация = Организация;
		Запись.Пользователь = Пользователь;
		
		НаборЗаписей.Записать();
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Ключ простой электронной подписи пользователя ""%1"" добавлен в реестр'"),
			Пользователь);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	КонецЦикла;
	
КонецФункции

#КонецОбласти
