&НаКлиенте
Процедура ОткрытьДействующуюРедакцию()
	
	Если Элементы.ОбъектыУчета.ТекущиеДанные <> Неопределено Тогда		
		ДействующаяРедакция = Элементы.ОбъектыУчета.ТекущиеДанные.ДействующаяРедакция;
		Если ЗначениеЗаполнено(ДействующаяРедакция) Тогда
			ПоказатьЗначение(, ДействующаяРедакция);
		Иначе
			ТекстОповещения = НСтр("ru = 'Открыть карту'");
			Пояснение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'У объекта учета имущества ""%1"" отсутсвует действующая редакция карты'"), Строка(Элементы.ОбъектыУчета.ТекущиеДанные.ОбъектУчетаИмущества));
			ПоказатьОповещениеПользователя(ТекстОповещения,, Пояснение);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

