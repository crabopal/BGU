
// Переменные для работы обработки в фоновом режиме
&НаКлиенте
Перем ПараметрыОбработчикаОжидания, ФормаДлительнойОперации, ТекущаяОперация, Цвета;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	УстановитьНастройки();
	
	Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	ОрганизацияПриИзмененииСервер();
	
	ЗагрузкаОтборПредставление = "Отбор: не установлен";
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьНадписи();
	ПроверкаВыбранногоДействия();
	
	ТолькоНеподтвержденныеРедакцииКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы = "Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ФормаВыбора" Тогда
		ОткрытьФормуРезультата(ВыбранноеЗначение);
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.НастройкиОбменаСистемаУчетаИмущества.Форма.ФормаВыбора" Тогда
		НастройкаОбмена = ВыбранноеЗначение;
		ОбновитьНадписи();
		УстановитьНастройки();
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаНастройкиОтбора" Тогда
		ЗагрузкаОтбор = ВыбранноеЗначение.НастройкиОтбора;
		ЗагрузкаОтборПредставление = ВыбранноеЗначение.ПредставлениеОтбора;
		ЗагрузкаОтборПредставление = "Отбор: " + ?(ЗначениеЗаполнено(ЗагрузкаОтборПредставление), ЗагрузкаОтборПредставление, "не установлен");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗагрузкаКартИзАСУФИ" Тогда
		// Позволяет получить данные карт, вычисленные другим путем
		АдресХранилища = Параметр;
		ВывестиПолученныеДанные();		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ЗначениеЗаполнено(НастройкаОбмена) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не указана настройка обмена.'"),,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
		
	ОрганизацияПриИзмененииСервер();
	//ОбновитьНадписи();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОбменаНажатие(Элемент, СтандартнаяОбработка = Истина)

	СтандартнаяОбработка = Ложь;

	ПараметрыФормы = Новый Структура("ТекущаяСтрока", НастройкаОбмена);
	ОткрытьФорму("Справочник.НастройкиОбменаСистемаУчетаИмущества.ФормаВыбора", ПараметрыФормы, ЭтаФорма);	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументыОбмена

&НаКлиенте
Процедура ДокументыОбменаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ОбъектУчетаИмущества = Элемент.ТекущиеДанные.ОбъектУчетаИмущества;
	Документ = ПолучитьПоследнююРедакцию(ОбъектУчетаИмущества);
	
	Если Не Документ.Пустая() Тогда
		ПоказатьЗначение(,Документ); 
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПоследнююРедакцию(ОбъектУчетаИмущества)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	РегистрацияСведенийОбИмуществе.Ссылка
	               |ИЗ
	               |	Документ.РегистрацияСведенийОбИмуществе КАК РегистрацияСведенийОбИмуществе
	               |ГДЕ
	               |	РегистрацияСведенийОбИмуществе.ОбъектУчетаИмущества = &Объект
	               |	И НЕ РегистрацияСведенийОбИмуществе.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	РегистрацияСведенийОбИмуществе.Дата УБЫВ";
				   
	Запрос.УстановитьПараметр("Объект", ОбъектУчетаИмущества);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Документы.РегистрацияСведенийОбИмуществе.ПустаяСсылка());	
	
КонецФункции

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	ИзменитьФлажки(Ложь)

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВсе(Команда)
	
	ИзменитьФлажки(Истина)
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	ЗаполнитьСписокДокументов();	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбмен(Команда)
	
	ВыполнитьДлительнуюОперацию("ОбменДанными");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	ПараметрыФормы = Новый Структура("НачалоПериода, КонецПериода", Период.ДатаНачала, Период.ДатаОкончания);
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Период.ДатаНачала = РезультатВыбора.НачалоПериода;
		Период.ДатаОкончания = РезультатВыбора.КонецПериода;
		Элементы.УстановитьПериод.Заголовок = ПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания);
		ЗаполнитьСписокДокументов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРезультат(Команда)
	
	Отбор = ПолучитьПараметрыНастройкиОбмена(НастройкаОбмена);
	Отбор.Вставить("Организация", Организация);
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	ОткрытьФорму("Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ФормаВыбора", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеКартПредставлениеОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьДанныеКартыДляПросмотра();

КонецПроцедуры

&НаКлиенте
Процедура СменитьСтраницу(Команда)
	
	Если Команда.Имя = "СменитьСтраницуЗагрузка" Тогда
		
		Элементы.КнопкаСтраницаЗагрузка.Пометка = Истина;
		Элементы.КнопкаСтраницаВыгрузка.Пометка = Ложь;
		Элементы.СтраницыОбмена.ТекущаяСтраница = Элементы.СтраницыОбмена.ПодчиненныеЭлементы.СтраницаЗагрузка;
		
	ИначеЕсли Команда.Имя = "СменитьСтраницуВыгрузка" Тогда
		
		Элементы.КнопкаСтраницаЗагрузка.Пометка = Ложь;
		Элементы.КнопкаСтраницаВыгрузка.Пометка = Истина;
		Элементы.СтраницыОбмена.ТекущаяСтраница = Элементы.СтраницыОбмена.ПодчиненныеЭлементы.СтраницаВыгрузка;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
	
	ЧастиВопроса = Новый Массив;
	ЧастиВопроса.Добавить(НСтр("ru = 'Будет выполнена загрузка '"));
	Если КоличествоЗагружаемыхКарт = 0 Тогда
		ЧастиВопроса.Добавить("карт");
	Иначе
		ЧастиВопроса.Добавить(Новый ФорматированнаяСтрока(Строка(КоличествоЗагружаемыхКарт), Новый Шрифт(,, Истина)));
		ЧастиВопроса.Добавить(?(КоличествоЗагружаемыхКарт = 1, НСтр("ru = ' карты'"), НСтр("ru = ' карт'")));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗагрузкаОтбор) Тогда
		ЧастиВопроса.Добавить(?(КоличествоЗагружаемыхКарт = 1, НСтр("ru = ', удовлетворяющей'"), НСтр("ru = ', удовлетворяющих'")));
		ЧастиВопроса.Добавить(НСтр("ru = ' условию:'") + Символы.ПС);
		ЧастиВопроса.Добавить(Новый ФорматированнаяСтрока(Сред(ЗагрузкаОтборПредставление, 8),, Цвета.ПоясняющийТекст));
		ЧастиВопроса.Добавить(Символы.ПС);
	КонецЕсли;	
	
	Если ДанныеКарт.Количество() > 0 Тогда
		Если Не ЗначениеЗаполнено(ЗагрузкаОтбор) Тогда
			ЧастиВопроса.Добавить(Символы.ПС);
		КонецЕсли;
		ЧастиВопроса.Добавить(Символы.ПС);
		ТекстПредупреждение = НСтр("ru = 'Таблица ""Сведения карт"" не пустая! Таблица будет очищена'");		
		ЧастиВопроса.Добавить(Новый ФорматированнаяСтрока(ТекстПредупреждение,, Цвета.ПоясняющийОшибкуТекст));
		ЧастиВопроса.Добавить(Символы.ПС);
	КонецЕсли;
	
	ЧастиВопроса.Добавить(Символы.ПС + НСтр("ru = 'Продолжить?'"));
	
	ТекстВопроса = Новый ФорматированнаяСтрока(ЧастиВопроса); 
	
	ПараметрыВопроса = Новый Структура("Операция", "ЗагрузитьДанные");
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаВыполненияДлительнойОперации", ЭтотОбъект, ПараметрыВопроса);	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКарты(Команда)
	
	ВыбранныеКарты = ДанныеКарт.НайтиСтроки(Новый Структура("Пометка", Истина));
	
	Если ВыбранныеКарты.Количество() > 0 Тогда		
		ПараметрыВопроса = Новый Структура("Операция", "СоздатьКарты");
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаВыполненияДлительнойОперации", ЭтотОбъект, ПараметрыВопроса);
		ТекстВопроса = НСтр("ru = 'Выбранные карты буду созданы. Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе		
		ПоказатьПредупреждение(,НСтр("ru = 'Не выбрано ни одной карты для создания!'"));		
	КонецЕсли;
	
	//ВыполнитьДлительнуюОперацию("СоздатьКарты");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСправочники(Команда)
	
	ВыполнитьДлительнуюОперацию("ЗагрузитьСправочники");

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВсеСтатусы(Команда)
	
	ВыполнитьДлительнуюОперацию("ОбновитьВсеСтатусы");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаВыполненияДлительнойОперации(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
        ВыполнитьДлительнуюОперацию(Параметры.Операция);
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаОтборПредставлениеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СостояниеОбъектовУчетаРеестраИмущества.Период,
	               |	СостояниеОбъектовУчетаРеестраИмущества.ОбъектУчетаИмущества.ВидКарты КАК ВидКарты,
	               |	СостояниеОбъектовУчетаРеестраИмущества.Статус,
	               |	СостояниеОбъектовУчетаРеестраИмущества.ОбъектУчетаИмущества.Идентификатор КАК Идентификатор,
	               |	ИСТИНА КАК Отсутствует
	               |ИЗ
	               |	РегистрСведений.СостояниеОбъектовУчетаРеестраИмущества КАК СостояниеОбъектовУчетаРеестраИмущества";					   
	
	ПараметрыФормы = Новый Структура("ТекстЗапроса, НастройкиОтбора", ТекстЗапроса, ЗагрузкаОтбор);		
	ОткрытьФорму("ОбщаяФорма.ФормаНастройкиОтбора", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Действующая редакция документа в таблице редакций карт
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ВерсииКарт");
		
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВерсииКарт.ЭтоДействующаяРедакция");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина));
	
	
	// Не выбранные объекты учета для обмена в таблице Обмен
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДокументыОбмена");
		
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДокументыОбмена.Пометка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	
	// Раскраска фона объекта учета имущества в таблице первоначальной загрузки объектов
	// Полностью не заполненный
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДанныеКартОбъектУчетаИмущества");
		
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеКарт.ОбъектУчетаИмущества");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеКарт.ОбъектУчета");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветЗаполняемогоПоказателя);
	
	// С заполненым объектом учета
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДанныеКартОбъектУчетаИмущества");
		
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеКарт.ОбъектУчетаИмущества");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДанныеКарт.ОбъектУчета");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаУдачнойОтправки);
	
	
	// Раскраска статусов
	Справочники.СтатусыКартРеестраИмущества.УстановитьЦветПоСтатусу(УсловноеОформление,, "ОбъектыУчета.Статус", "ОбъектыУчетаСтатус"); 
	Справочники.СтатусыКартРеестраИмущества.УстановитьЦветПоСтатусу(УсловноеОформление,, "ВерсииКарт.Статус", "ВерсииКартСтатус");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНастройки()
	
	Если Не ЗначениеЗаполнено(НастройкаОбмена) Тогда
		
		Запрос = Новый Запрос;
		
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	Настройки.Ссылка
		               |ИЗ
		               |	Справочник.НастройкиОбменаСистемаУчетаИмущества КАК Настройки
		               |ГДЕ
		               |	НЕ Настройки.ПометкаУдаления
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Настройки.Основная УБЫВ";
		
		Запрос.Текст = ТекстЗапроса;
		Настройки = Запрос.Выполнить().Выбрать();
		
		Если Настройки.Следующий() Тогда
			НастройкаОбмена = Настройки.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	СписокДействий.Очистить();
	Действия.Очистить();
	
	Для Каждого СтрокаДействия Из НастройкаОбмена.Действия Цикл
		
		Ключ = "СлужебноеПоле_КомандаОбмена_" + СтрокаДействия.НомерСтроки;
				
		СписокДействий.Добавить(Ключ, СтрокаДействия.Действие); 
		
		НовоеДействие = Действия.Добавить();
		НовоеДействие.Ключ				= Ключ;
		НовоеДействие.ВидОбмена			= НастройкаОбмена.ВидОбмена;
		НовоеДействие.НастройкаОбмена	= ?(ЗначениеЗаполнено(СтрокаДействия.НастройкаОбмена), СтрокаДействия.НастройкаОбмена, НастройкаОбмена.НастройкаОбмена);
		НовоеДействие.Отбор				= СтрокаДействия.Отбор;
		НовоеДействие.ОтборПодбора		= СтрокаДействия.ОтборПодбора;
		
	КонецЦикла;
	
	ЗаполнитьСписокДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписи()

	НастройкаОбменаУказана = ЗначениеЗаполнено(НастройкаОбмена);
	Элементы.НастройкаОбмена.Видимость			= НастройкаОбменаУказана;
	Элементы.НастройкаОбменаНеУказана.Видимость	= Не НастройкаОбменаУказана;
		
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаВыбранногоДействия()
	
	Если Элементы.ДействияСписок.ТекущаяСтрока <> Неопределено И Элементы.ДействияСписок.ТекущиеДанные.Значение <> ТекущееДействие Тогда
		ТекущееДействие = Элементы.ДействияСписок.ТекущиеДанные.Значение;
		ЗаполнитьСписокДокументов();
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПроверкаВыбранногоДействия", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьФлажки(Флаг)
	
	Для Каждого Строка Из ДокументыОбмена Цикл
		Строка.Пометка = Флаг;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ОткрытьФормуРезультата(Документ)
	
	ПараметрыФормы = Новый Структура("Документ", Документ);
	Форма = ОткрытьФорму("Обработка.ОбменВФорматахУФК_УФЭБС.Форма.РезультатОбмена", ПараметрыФормы, ЭтаФорма);
	
	Возврат Форма;
	
КонецФункции

&НаСервере
Процедура ОрганизацияПриИзмененииСервер()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ОбъектыУчета, "Организация", Организация);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДокументов()
	
	НастройкаДействия = ПолучитьНастройкиДействия();
	Если НастройкаДействия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Таблица.Пометка,
	               |	Таблица.ОбъектУчетаИмущества
	               |ПОМЕСТИТЬ Таблица
	               |ИЗ
	               |	&Таблица КАК Таблица
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОбъектыУчетаСистемыУчетаИмущества.Ссылка КАК ОбъектУчетаИмущества,
	               |	СостояниеКартРеестраИмущества.Статус КАК Статус,
	               |	СведенияРеестровогоУчетаИмущества.РеестровыйНомер,
	               |	СведенияРеестровогоУчетаИмущества.ДатаУчета,
	               |	СведенияРеестровогоУчетаИмущества.НомерКарты,
	               |	ЕСТЬNULL(Таблица.Пометка, ИСТИНА) КАК Пометка
	               |ПОМЕСТИТЬ ОсновнаяТаблица
	               |ИЗ
	               |	Справочник.ОбъектыУчетаСистемыУчетаИмущества КАК ОбъектыУчетаСистемыУчетаИмущества
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияРеестровогоУчетаИмущества КАК СведенияРеестровогоУчетаИмущества
	               |		ПО ОбъектыУчетаСистемыУчетаИмущества.Организация = СведенияРеестровогоУчетаИмущества.Организация
	               |			И ОбъектыУчетаСистемыУчетаИмущества.Ссылка = СведенияРеестровогоУчетаИмущества.ОбъектУчетаИмущества
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Таблица КАК Таблица
	               |		ПО ОбъектыУчетаСистемыУчетаИмущества.Ссылка = Таблица.ОбъектУчетаИмущества
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеКартРеестраИмущества КАК СостояниеКартРеестраИмущества
	               |		ПО (СостояниеКартРеестраИмущества.Карта В
	               |				(ВЫБРАТЬ ПЕРВЫЕ 1
	               |					ВТ.Карта
	               |				ИЗ
	               |					РегистрСведений.СостояниеКартРеестраИмущества КАК ВТ
	               |				ГДЕ
	               |					НЕ ВТ.Карта.ПометкаУдаления
	               |					И ВТ.Карта.ОбъектУчетаИмущества = ОбъектыУчетаСистемыУчетаИмущества.Ссылка
	               |				УПОРЯДОЧИТЬ ПО
	               |					ВТ.Карта.Дата УБЫВ))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОсновнаяТаблица.ОбъектУчетаИмущества КАК ОбъектУчетаИмущества,
	               |	ОсновнаяТаблица.РеестровыйНомер,
	               |	ОсновнаяТаблица.ДатаУчета,
	               |	ОсновнаяТаблица.НомерКарты,
	               |	ОсновнаяТаблица.Пометка,
	               |	ОсновнаяТаблица.Статус
	               |ИЗ
	               |	ОсновнаяТаблица КАК ОсновнаяТаблица";					  
				   
	Запрос = Новый Запрос;
	
	УсловиеДаты = "ВЫБРАТЬ
	              |	РегистрацияСведенийОбИмуществе.ОбъектУчетаИмущества КАК ОбъектУчетаИмущества
	              |ИЗ
	              |	Документ.РегистрацияСведенийОбИмуществе КАК РегистрацияСведенийОбИмуществе
	              |ГДЕ
	              |	РегистрацияСведенийОбИмуществе.Организация = &Организация
	              |	И НЕ РегистрацияСведенийОбИмуществе.ПометкаУдаления";
	
	Если ЗначениеЗаполнено(Период.ДатаНачала) И ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		УсловиеДаты = УсловиеДаты + " И РегистрацияСведенийОбИмуществе.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
		Запрос.УстановитьПараметр("НачалоПериода",	Период.ДатаНачала);
		Запрос.УстановитьПараметр("КонецПериода",	Период.ДатаОкончания);		
	ИначеЕсли ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		УсловиеДаты = УсловиеДаты + "И РегистрацияСведенийОбИмуществе.Дата >= &НачалоПериода";
		Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	ИначеЕсли ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		УсловиеДаты = УсловиеДаты + "И РегистрацияСведенийОбИмуществе.Дата <= &КонецПериода";
		Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Иначе
		УсловиеДаты = "";
	КонецЕсли;
								  
	Запрос.Текст = ТекстЗапроса;
	Условие = РеестрИмуществаСервер.СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, НастройкаДействия.ОтборПодбора);

	Если УсловиеДаты <> "" Тогда
		Запрос.Текст = Запрос.Текст + ?(Условие = "", " ГДЕ " , " И ") + "ОсновнаяТаблица.ОбъектУчетаИмущества В (" + УсловиеДаты + ")"; 	
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
	               |УПОРЯДОЧИТЬ ПО
	               |	ОбъектУчетаИмущества";
		
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Таблица",	 ДокументыОбмена.Выгрузить());
		
	Результат = Запрос.Выполнить().Выгрузить();
	ДокументыОбмена.Загрузить(Результат);	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкиДействия()
	
	Если Не ЗначениеЗаполнено(НастройкаОбмена) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущееДействие) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДействиеКлюча = Действия.НайтиСтроки(Новый Структура("Ключ", ТекущееДействие));
	
	Если ДействиеКлюча.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДействиеКлюча[0];
	
КонецФункции

&НаКлиенте
Процедура ОткрытьДанныеКартыДляПросмотра()
	
	ТекущиеДанные = Элементы.ДанныеКарт.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущиеДанные.ВидКарты) Тогда
		ТекстОповещения = НСтр("ru = 'Просмотр сведений карты'");
		Пояснение = НСтр("ru = 'Вид карты объекта учета имущества не определен, сведения не загружены.
								|Просмотр невозможен'");
		ПоказатьОповещениеПользователя(ТекстОповещения,, Пояснение);			
		Возврат;
	КонецЕсли;	
	
	ИсточникиДанных = ПолучитьИсточникиДанных(Элементы.ДанныеКарт.ТекущаяСтрока);
	ПараметрыФормы = Новый Структура("ВладелецРеквизитов,ИсточникиДанных,ДанныеОбъекта", ТекущиеДанные.ВидКарты, ИсточникиДанных, ТекущиеДанные.ЗначенияРеквизитов); 
		
	ОткрытьФорму("Справочник.РеквизитыСведенийОбИмуществе.Форма.ФормаДополнительная", ПараметрыФормы, ЭтаФорма);		
	
КонецПроцедуры
 
&НаСервере
Функция ПолучитьИсточникиДанных(ТекущаяСтрока)
	
	Данные = ДанныеКарт.НайтиПоИдентификатору(ТекущаяСтрока);
	
	ДокументОбъект.Дата = ТекущаяДата();
	ДокументОбъект.ОбъектУчетаИмущества = Данные.ОбъектУчетаИмущества;
	ДокументОбъект.ЗначенияРеквизитов.Загрузить(Данные.ЗначенияРеквизитов.Выгрузить());
	
	ЗаполнитьЗначенияСвойств(РеестровыйУчет, Данные);
	
	ИсточникиДанных = Новый Массив;
	ИсточникиДанных.Добавить(Новый Структура("ИмяИсточника,Источник,ТипИсточника", "Объект", ДокументОбъект, "ДокументОбъект.РегистрацияСведенийОбИмуществе"));
	ИсточникиДанных.Добавить(Новый Структура("ИмяИсточника,Источник,ТипИсточника", "РеестровыйУчет", РеестровыйУчет, "РегистрСведенийМенеджерЗаписи.СведенияРеестровогоУчетаИмущества"));
	
	Возврат ИсточникиДанных;
	
КонецФункции

