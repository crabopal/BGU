Процедура ДанныеКартОбъектУчетаИмуществаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Элементы.ДанныеКарт.ТекущиеДанные.Пометка = Истина;
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаСоздатьОбъектыУчетаИмущества(Команда)
	
	ОчиститьСообщения();
	//Попытка
		Ошибки = ЗагрузкаСоздатьОбъектыУчетаИмуществаНаСервере();
	//Исключение
	//	ТекстСообщения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	//	Предупреждение(НСтр("ru = 'Операция не может быть выполнена по причине:'") + Символы.ПС + ТекстСообщения);
	//КонецПопытки;
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);

КонецПроцедуры

&НаСервере
Функция ЗагрузкаСоздатьОбъектыУчетаИмуществаНаСервере()

	Ошибки = Неопределено;
	
	//РеквизитФормыВЗначение("ДанныеКарт")
	
	Для Каждого СтрокаТаблицы Из ДанныеКарт Цикл		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ОбъектУчетаИмущества) И ЗначениеЗаполнено(СтрокаТаблицы.ОбъектУчета) Тогда
			
			ОбъектУИ = Справочники.ОбъектыУчетаСистемыУчетаИмущества.СоздатьЭлемент();
			ОбъектУИ.Организация = Организация;
			
			ЗаполнитьЗначенияСвойств(ОбъектУИ, СтрокаТаблицы, "ОбъектУчета,ВидКарты,Идентификатор");
			
			Попытка
				ОбъектУИ.Записать();
				СтрокаТаблицы.ОбъектУчетаИмущества = ОбъектУИ.Ссылка;
				СтрокаТаблицы.Пометка = Истина;
			Исключение
				// Сообщаем: в строке № не удалось создать объект учета имущества (ссылка на строку)
				ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				//ПоказатьИнформациюОбОшибке(Инфо);
				//ВызватьИсключение ;
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, Выборка.Ссылка,,, Отказ);
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "ДанныеКарт[%1].ОбъектУчетаИмущества", ТекстОшибки, "", ДанныеКарт.Индекс(СтрокаТаблицы));
			КонецПопытки;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСтатусыЗапросов(Команда)
	
	ДокументыЗапросы = Элементы.ВерсииКарт.ВыделенныеСтроки;

	Если ДокументыЗапросы.Количество()> 0 Тогда
		ДопПараметры = Новый Структура("Документы", ДокументыЗапросы);
		ВыполнитьДлительнуюОперацию("ОбновитьСтатусыЗапросов", ДопПараметры);		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыКарт(Команда)
	
	ОбъектыУчетаИмущества = Новый Массив;
	Для Каждого Строка Из Элементы.ОбъектыУчета.ВыделенныеСтроки Цикл
		ОбъектыУчетаИмущества.Добавить(Строка.ОбъектУчетаИмущества);
	КонецЦикла;
	
	Если ОбъектыУчетаИмущества.Количество()> 0 Тогда
		ДопПараметры = Новый Структура("ОбъектыУчетаИмущества", ОбъектыУчетаИмущества);
		ВыполнитьДлительнуюОперацию("ОбновитьСтатусыКарт", ДопПараметры);		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦвета()
	
	Цвета = Новый Структура;
	Цвета.Вставить("ПоясняющийТекст", ЦветаСтиля.ПоясняющийТекст);
	Цвета.Вставить("ПоясняющийОшибкуТекст", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
	Возврат Цвета;
	
КонецФункции

#КонецОбласти

Цвета = ПолучитьЦвета();
