	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ДанныеКарт.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ОбъектУчетаИмущества) Тогда
		
		ТекстОповещения = НСтр("ru = 'Выбор объекта учета имущества'");
		Пояснение = НСтр("ru = 'Объект учета уже выбран. Изменение объекта учета имущества невозможно'");
		ПоказатьОповещениеПользователя(ТекстОповещения,, Пояснение);
		
	Иначе
		
		Данные = Новый Структура("Организация,ВидКарты,Идентификатор,ОбъектУчета", Организация);
		ЗаполнитьЗначенияСвойств(Данные, ТекущиеДанные);
		
		ПараметрыФормы = Новый Структура("Основание", Данные);
		ОткрытьФорму("Обработка.ОбменССистемойУчетаИмущества.Форма.ФормаОбъектаУчетаИмущества", ПараметрыФормы, Элемент);
		
	КонецЕсли;
		
