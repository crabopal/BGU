&НаКлиенте
Процедура ВыполнитьДлительнуюОперацию(Операция, ДопПараметры = Неопределено)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
			
	ЗаданиеВыполнено = ВыполнитьДлительнуюОперациюСервер(Операция, ДопПараметры);	
	Если ЗаданиеВыполнено Тогда
		ВыполнитьПоЗавершениюДлительнойОперации(Операция);
	Иначе
		ТекущаяОперация = Операция;
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания);
	КонецЕсли;		
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьДлительнуюОперациюСервер(Операция, ДопПараметры)
	
	// Подготовка параметров запуска процедуры
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);	
	
	Если Операция = "ОбменДанными" Тогда
		НастройкаДействия = ПолучитьНастройкиДействия();
		Если НастройкаДействия = Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		ПараметрыОбработки = Новый Структура("ВидОбмена,НастройкаОбмена,Отбор");
		ЗаполнитьЗначенияСвойств(ПараметрыОбработки, НастройкаДействия);
	Иначе
		ПараметрыОбработки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаОбмена, "ВидОбмена,НастройкаОбмена");
	КонецЕсли;
	
	ПараметрыОбработки.Вставить("Организация", Организация);	
	
	Если Операция = "ОбменДанными" Тогда
		
		ОбъектыУчетаИмущества = ДокументыОбмена.Выгрузить(Новый Структура("Пометка", Истина), "ОбъектУчетаИмущества").ВыгрузитьКолонку("ОбъектУчетаИмущества");
		ПараметрыОбработки.Вставить("ОбъектыУчетаИмущества", ОбъектыУчетаИмущества);
	
	ИначеЕсли Операция = "ЗагрузитьДанные" Тогда
			
		ТаблицаДанныеКарт = РеквизитФормыВЗначение("ДанныеКарт");
		ТаблицаДанныеКарт.Очистить();
		ПараметрыОбработки.Вставить("ДанныеКарт",	ТаблицаДанныеКарт);
		ПараметрыОбработки.Вставить("Отбор",		ЗагрузкаОтбор);
		ПараметрыОбработки.Вставить("Количество",	КоличествоЗагружаемыхКарт);
		
	ИначеЕсли Операция = "СоздатьКарты" Тогда
		
		ТаблицаДанныеКарт = РеквизитФормыВЗначение("ДанныеКарт");
		ТаблицаДанныеКарт = ТаблицаДанныеКарт.Скопировать(Новый Структура("Пометка", Истина),
			"ОбъектУчетаИмущества,Статус,ДатаСтатуса,СистемныйНомер,НомерКарты,РеестровыйНомер,ДатаУчета,ЗначенияРеквизитов");
		
		Если ТаблицаДанныеКарт.Количество() = 0 Тогда
			Возврат Истина;
		КонецЕсли;
		
		ПараметрыОбработки = Новый Структура;
		ПараметрыОбработки.Вставить("Организация", Организация);
		ПараметрыОбработки.Вставить("ДанныеКарт", ТаблицаДанныеКарт);
		
	ИначеЕсли Операция = "ЗагрузитьСправочники" Тогда
		//
		
	ИначеЕсли Операция = "ОбновитьСтатусыЗапросов" Тогда
		
		//ПараметрыОбработки.Вставить("Документы", ОбщегоНазначенияБГУ.Массив(Элементы.ВерсииКарт.ТекущаяСтрока.Ссылка));
		//Операция = "ОбновитьСтатусы";
		
	ИначеЕсли Операция = "ОбновитьВсеСтатусы" Тогда
		
		//ПараметрыОбработки.Вставить("Документы", ОбщегоНазначенияБГУ.Массив(Документы.РегистрацияСведенийОбИмуществе.ПустаяСсылка()));

	КонецЕсли;
	
	Если ДопПараметры <> Неопределено Тогда
		Для Каждого ДопПараметр Из ДопПараметры Цикл
			ПараметрыОбработки.Вставить(ДопПараметр.Ключ, ДопПараметр.Значение);
		КонецЦикла;
	КонецЕсли;
	
	// Запуск в зависимости от режима работы
	
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда	
		Обработки.ОбменССистемойУчетаИмущества.ВыполнитьОперацию(Операция, ПараметрыОбработки, АдресХранилища);
		Возврат Истина;		
	КонецЕсли;			
	
	Если ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая Тогда
		ВремяОжидания = 4;
	Иначе
		ВремяОжидания = 2;
	КонецЕсли;
	
	ПараметрыЭкспортнойПроцедуры = Новый Массив;
	ПараметрыЭкспортнойПроцедуры.Добавить(Операция);
	ПараметрыЭкспортнойПроцедуры.Добавить(ПараметрыОбработки);
	ПараметрыЭкспортнойПроцедуры.Добавить(АдресХранилища);

	Задание = ФоновыеЗадания.Выполнить("ФоновыеЗаданияБухгалтерскийУчет.ВыполнитьОперациюОбменаССистемойУчетаИмущества",
										ПараметрыЭкспортнойПроцедуры,
										"Операция обмена с системой учета имущества");
	
	Попытка
		Задание.ОжидатьЗавершения(ВремяОжидания);
	Исключение		
		// Специальная обработка не требуется. Предположительно, исключение вызвано истечением времени ожидания.
	КонецПопытки;
	
	ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	Возврат ДлительныеОперации.ЗаданиеВыполнено(Задание.УникальныйИдентификатор);		
		
КонецФункции

 &НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка 
		
		Если ПроверитьВыполнениеФоновогоЗаданияНаСервере(ИдентификаторЗадания) Тогда									
			ВыполнитьПоЗавершениюДлительнойОперации(ТекущаяОперация);
			Возврат;
		КонецЕсли;
		
	Исключение
		
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВызватьИсключение ОписаниеОшибки();
		
	КонецПопытки;	
	
	ПараметрыОбработчикаОжидания.ТекущийИнтервал = ПараметрыОбработчикаОжидания.ТекущийИнтервал * ПараметрыОбработчикаОжидания.КоэффициентУвеличенияИнтервала;
	Если ПараметрыОбработчикаОжидания.ТекущийИнтервал > ПараметрыОбработчикаОжидания.МаксимальныйИнтервал Тогда
		ПараметрыОбработчикаОжидания.ТекущийИнтервал = ПараметрыОбработчикаОжидания.МаксимальныйИнтервал;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", ПараметрыОбработчикаОжидания.ТекущийИнтервал, Истина);
	
КонецПроцедуры

 &НаСервереБезКонтекста
Функция ПроверитьВыполнениеФоновогоЗаданияНаСервере(ФоновоеЗаданиеИдентификатор)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ФоновоеЗаданиеИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПоЗавершениюДлительнойОперации(Операция)
	
	ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
	МассивСообщений = ПолучитьВсеСообщения(ИдентификаторЗадания);
	
	Если МассивСообщений <> Неопределено Тогда
		ОчиститьСообщения();
		Для Каждого Сообщение Из МассивСообщений Цикл
			Сообщение.ИдентификаторНазначения = УникальныйИдентификатор;
			Сообщение.Сообщить();
		КонецЦикла;
	КонецЕсли;
		
	Если Операция = "ОбменДанными" Тогда
		
		ЗаданиеНаЭкспорт = ПолучитьИзВременногоХранилища(АдресХранилища);		
		Если ЗаданиеНаЭкспорт <> Неопределено Тогда			
			ЗаполнитьСписокДокументов();
			ФормаРезультат = ОткрытьФормуРезультата(ЗаданиеНаЭкспорт);				
		КонецЕсли;
		
	ИначеЕсли Операция = "ЗагрузитьДанные" Тогда
		
		ВывестиПолученныеДанные();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Загрузка сведений карт выполнена'"));
		
	ИначеЕсли Операция = "СоздатьКарты" Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Карты созданы'"));
		
	ИначеЕсли Операция = "ЗагрузитьСправочники" Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Классификаторы загружены'"));
		
	ИначеЕсли Операция = "ОбновитьСтатус" Тогда
		
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Статусы карт обновлены'"));
		
	ИначеЕсли Операция = "ОбновитьВсеСтатусы" Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Статусы карт обновлены'"));	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВсеСообщения(ИдентификаторЗадания)
	
	МассивСообщений = Неопределено;
	
	Если Не ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
		Если Задание <> Неопределено Тогда
			МассивСообщений = Задание.ПолучитьСообщенияПользователю();
		КонецЕсли; 
		
	КонецЕсли;
	
	Возврат МассивСообщений;

КонецФункции

&НаСервере
Процедура ВывестиПолученныеДанные()
	
	Результат = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	Для Каждого СтрокаТаблицы Из Результат Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.ОбъектУчетаИмущества) Тогда
			СтрокаТаблицы.Пометка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Результат, "ДанныеКарт");				
	
КонецПроцедуры

