#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область СлужебныеПроцедурыИФункции

Процедура ЗаписьСобытияВЖурналРегистрации(ТекстСообщения, Уровень = Неопределено)

	Если Уровень = Неопределено Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("Обработки.ВыгрузкаЗагрузкаДокументовПриОбменеСГИИСЭБ", Уровень,,, ТекстСообщения, РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
	
КонецПроцедуры

Процедура ОтразитьВУчете(ПараметрыФЗ, АдресВоВременномХранилище) Экспорт

	СтруктураВозврат   = Новый Структура();
	СтруктураВозврат.Вставить("ИмяПроцедуры", "ОтразитьВУчете");
	
	КоличествоОшибок = 0;
	
	МассивОтражаемыхДокументов = ПараметрыФЗ.МассивОтражаемыхДокументов;
	
	// Установка статуса "Подписан в ГИИС ЭБ"
		                               
	СтатусПодписанВГИИСЭБ = 2;  
	
	СостояниеДокументов = Новый Массив;
	СостояниеДокументов.Добавить(СтатусПодписанВГИИСЭБ);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИзвещениеИсходящее.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ИзвещениеИсходящее КАК ИзвещениеИсходящее
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументовПриОбменеСГИИСЭБ.СрезПоследних(&Период, ) КАК СтатусыДокументовПриОбменеСГИИСЭБ
	               |		ПО (СтатусыДокументовПриОбменеСГИИСЭБ.ДокументУчета = ИзвещениеИсходящее.Ссылка)
	               |			И (НЕ СтатусыДокументовПриОбменеСГИИСЭБ.СтатусОбмена В (&СостояниеДокументов))
	               |ГДЕ
	               |	ИзвещениеИсходящее.Ссылка В(&ЗагружаемыеДокументы)";
	
	Запрос.УстановитьПараметр("ЗагружаемыеДокументы", МассивОтражаемыхДокументов);
	Запрос.УстановитьПараметр("СостояниеДокументов", СостояниеДокументов);  
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	
	Результат = Запрос.Выполнить().Выгрузить();
	МассивДокУчета = Результат.ВыгрузитьКолонку("Ссылка"); 
	
	Если МассивДокУчета.Количество() > 0 Тогда
		
		Для Каждого ТекДокум Из МассивДокУчета Цикл 
			
			НаборЗаписей = РегистрыСведений.СтатусыДокументовПриОбменеСГИИСЭБ.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ДокументУчета.Установить(ТекДокум);
			НаборЗаписей.Прочитать();
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ДокументУчета = ТекДокум; 
			НоваяЗапись.Регистратор = ТекДокум;
			НоваяЗапись.СтатусОбмена = СтатусПодписанВГИИСЭБ;
			НоваяЗапись.Период = ТекущаяДата();  
			
			Попытка
				НаборЗаписей.Записать();	
			Исключение  
				КоличествоОшибок = КоличествоОшибок + 1;
				ТекстОшибки = СтрШаблон("Не удалось установить документу ""%1"" статус ""Подписан в ГИИС ЭБ"".", ТекДокум);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецПопытки;
		КонецЦикла;	 
	КонецЕсли;
	
	Если МассивДокУчета.Количество() > КоличествоОшибок Тогда
		ТекстСообщения = "Статусы документов учета изменены на ""Подписан в ГИИС ЭБ"".";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;

КонецПроцедуры

Процедура ВыгрузитьДокументыУчета(ПараметрыФЗ, АдресВоВременномХранилище) Экспорт

	АдресХранилища 			 = ПараметрыФЗ.АдресХранилища;
	АдресМассиваОшибок 		 = ПараметрыФЗ.АдресМассиваОшибок;
	АдресХранилищаАрхиваZip  = ПараметрыФЗ.АдресХранилищаАрхиваZip;
	Период					 = ПараметрыФЗ.Период;
	КодФормы				 = "805h";
	НачальныйНомер			 = ПараметрыФЗ.НачальныйНомер;
	ФорматОбмена 			 = ПараметрыФЗ.ФорматВыгрузки;
	ВыгрузитьВZipАхив		 = ПараметрыФЗ.ВыгрузитьВZipАхив;
	ЭтоВебКлиент             = ПараметрыФЗ.ЭтоВебКлиент;
	
	СтатусНаОтправку 		= 0;
	СтатусВыгружено 		= 1;
	СтатусПодписанВГИИСЭБ 	= 2;
	
	СтруктураВозврат = Новый Структура;
	СтруктураВозврат.Вставить("ИмяПроцедуры", "ВыгрузитьДокументыУчета"); 
	
	МассивВыгруженныхФайлов = Новый Массив;
	МассивВыгруженныхДокументов = Новый Массив;
	
	ТДПротоколОшибок = Новый ТабличныйДокумент;
	МакетПротокола   = ПолучитьМакет("ПротоколВыгрузки");
	ОбластьШапка  = МакетПротокола.ПолучитьОбласть("ОбластьШапка");
	ТДПротоколОшибок.Вывести(ОбластьШапка);
	ОбластьСтрока = МакетПротокола.ПолучитьОбласть("ОбластьИтог");
	КоличествоОшибок = 0;
	
	// Выгрузка
			
	МассивДляВыгрузки = ПараметрыФЗ.МассивДокументов;
	ПорядковыйНомер  = НачальныйНомер;	
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", МассивДляВыгрузки);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Таб.Объект КАК Документ,
	               |	Таб.Значение КАК ЗначениеДопКолонки,
	               |	Таб.НомерСтрокиДокумента КАК НомерСтроки,
	               |	ЕСТЬNULL(ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК ОсновноеСредство
	               |ИЗ
	               |	РегистрСведений.ЗначенияКолонокДополнительныхТабличныхЧастей КАК Таб
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КолонкиДополнительныхТабличныхЧастей КАК КолонкиДополнительныхТабличныхЧастей
	               |		ПО Таб.КолонкаТабличнойЧасти = КолонкиДополнительныхТабличныхЧастей.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ПередачаОбъектовОСОсновныеСредства
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзвещениеИсходящее.ДокументыПередачи КАК ИзвещениеИсходящееДокументыПередачи
	               |			ПО ПередачаОбъектовОСОсновныеСредства.Ссылка = ИзвещениеИсходящееДокументыПередачи.ДокументПередачи
	               |		ПО Таб.Объект = ПередачаОбъектовОСОсновныеСредства.Ссылка
	               |			И Таб.НомерСтрокиДокумента = ПередачаОбъектовОСОсновныеСредства.НомерСтроки
	               |ГДЕ
	               |	Таб.Объект ССЫЛКА Документ.ПередачаОбъектовОС
	               |	И КолонкиДополнительныхТабличныхЧастей.Наименование = &КолонкиДопЧастей
	               |	И ИзвещениеИсходящееДокументыПередачи.Ссылка В(&Ссылка)";
	
	Запрос.УстановитьПараметр("КолонкиДопЧастей", НСтр("ru='Получаемые ОС'"));
	ТаблицаЗначенийДопКолонок = Запрос.Выполнить().Выгрузить();
	
	Если ВыгрузитьВZipАхив Тогда

		ИмяВременногоФайлаАрхива = ПолучитьИмяВременногоФайла("zip");
		
		ЗаписьВZipАрхив = Новый ЗаписьZipФайла(ИмяВременногоФайлаАрхива,
			, 
			"Содержит выгрузку файлов исходящих извешщений для ГИИС ""Электронный бюджет"".",
			МетодСжатияZIP.Сжатие,
			УровеньСжатияZIP.Оптимальный,
			МетодШифрованияZIP.Zip20);
			
		МассивВременныхФайлов = Новый Массив;	
			
	КонецЕсли;
	
	Для Каждого Документ Из МассивДляВыгрузки Цикл
		
		СтруктураФайла = ПолучитьПустуюСтруктуруФайла();
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ПорядковыйНомер", ПорядковыйНомер);
		ДополнительныеПараметры.Вставить("КодФормы", КодФормы);
		ДополнительныеПараметры.Вставить("Период", Период);
		ДополнительныеПараметры.Вставить("форматВыгрузки",ФорматОбмена);
		
		СообщениеРезультат = ПреобразоватьДокументПоФормату(Документ, СтруктураФайла, ДополнительныеПараметры, ТаблицаЗначенийДопКолонок);
		Если СообщениеРезультат = "Успешно" Тогда
			МассивВыгруженныхФайлов.Добавить(СтруктураФайла);
			МассивВыгруженныхДокументов.Добавить(Документ);
			ПорядковыйНомер = ПорядковыйНомер + 1; 
			
			КоличествоОшибок = КоличествоОшибок + 1;
			ОбластьСтрока.Параметры.Номер = КоличествоОшибок;
			ОбластьСтрока.Параметры.Документ = Документ;
			ОбластьСтрока.Параметры.Файл = СтруктураФайла.ИмяФайла;
			ОбластьСтрока.Параметры.Текст = "Документ выгружен.";
			ТДПротоколОшибок.Вывести(ОбластьСтрока); 
			
			//Заполенние  zip архива 
			Если ВыгрузитьВZipАхив Тогда
				ДвоичныеДанныеФайла = СтруктураФайла.ДвоичныеДанные;
				
				ВременныйФайл = Новый Файл(СтруктураФайла.ИмяФайла);
				ИмяВременногоФайла = ВременныйФайл.Имя;
				
				ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
				ЗаписьВZipАрхив.Добавить(ИмяВременногоФайла,РежимСохраненияПутейZIP.НеСохранятьПути,);

				МассивВременныхФайлов.Добавить(ИмяВременногоФайла);
				
			КонецЕсли;
			
		Иначе         
			КоличествоОшибок = КоличествоОшибок + 1;
			ОбластьСтрока.Параметры.Номер = КоличествоОшибок;
			ОбластьСтрока.Параметры.Документ = Документ;
			ОбластьСтрока.Параметры.Файл = "";
			ОбластьСтрока.Параметры.Текст = "Документ не выгружен. " + СообщениеРезультат;
			ТДПротоколОшибок.Вывести(ОбластьСтрока); 
			ТекстОшибки = СтрШаблон("Документ ""%1"" не выгружен. " + СообщениеРезультат, Документ);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
	КонецЦикла;
	
	Если ВыгрузитьВZipАхив Тогда
		
		ЗаписьВZipАрхив.Записать();
		
		Для Каждого Строка Из МассивВременныхФайлов Цикл
			УдалитьФайлы(Строка);
		КонецЦикла;
		
		ИмяАрхива = "Выгрузка в ГИИС ЭБ от " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ".zip";
		
		СтруктураАрхива = Новый Структура;
		СтруктураАрхива.Вставить("ИмяАрхива", ИмяАрхива); 
		СтруктураАрхива.Вставить("ДанныеАрхива", Новый ДвоичныеДанные(ИмяВременногоФайлаАрхива));
        СтруктураАрхива.Вставить("ИмяВременнногоФайла", ИмяВременногоФайлаАрхива);  
		Если ЭтоВебКлиент Тогда
			УдалитьФайлы(ИмяВременногоФайлаАрхива);	
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураОшибок = Новый Структура;
	СтруктураОшибок.Вставить("ПротоколОшибок", ТДПротоколОшибок);
	СтруктураОшибок.Вставить("КоличествоОшибок", КоличествоОшибок);
	
	СтруктураВозврат.Вставить("МассивВыгруженныхФайлов", МассивВыгруженныхФайлов);
	
	// Установка статуса "Выгружен"
	Если МассивВыгруженныхДокументов.Количество() = 0 Тогда
		ПоместитьВоВременноеХранилище(СтруктураВозврат, АдресХранилища);
		ПоместитьВоВременноеХранилище(СтруктураОшибок, АдресМассиваОшибок);
		Если ВыгрузитьВZipАхив Тогда
			ПоместитьВоВременноеХранилище(СтруктураАрхива, АдресХранилищаАрхиваZip);	
		КонецЕсли;
		Возврат
	Иначе
		
		Для Каждого ТекСтрока Из МассивВыгруженныхДокументов Цикл
			
			НаборЗаписей = РегистрыСведений.СтатусыДокументовПриОбменеСГИИСЭБ.СоздатьНаборЗаписей();
	    	НаборЗаписей.Отбор.ДокументУчета.Установить(ТекСтрока);
			НаборЗаписей.Прочитать();
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ДокументУчета = ТекСтрока; 
			НоваяЗапись.СтатусОбмена = СтатусВыгружено;
			НоваяЗапись.Период = ТекущаяДата();   
			
			Попытка
				НаборЗаписей.Записать();
			Исключение
				ТекстОшибки = СтрШаблон("Не удалось установить статус ""Выгружен"" для документа %1.",ТекСтрока); 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецПопытки 
			
		КонецЦикла;
	КонецЕсли;	
	
	ПоместитьВоВременноеХранилище(СтруктураВозврат, АдресХранилища);
	ПоместитьВоВременноеХранилище(СтруктураОшибок, АдресМассиваОшибок);
	Если ВыгрузитьВZipАхив Тогда
		ПоместитьВоВременноеХранилище(СтруктураАрхива, АдресХранилищаАрхиваZip);	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПустуюСтруктуруФайла()
	
	СтруктураФайла = Новый Структура;
	СтруктураФайла.Вставить("ИмяФайла", "");
	СтруктураФайла.Вставить("ДвоичныеДанные", "");
	
	Возврат СтруктураФайла
	
КонецФункции  

Функция ПреобразоватьДокументПоФормату(Документ, СтруктураФайла, ДополнительныеПараметры, ТаблицаЗначенийДопКолонок)
	
	Организация 	= Документ.Организация;
	ВременныйФайл 	= ПолучитьИмяВременногоФайла("txt");
	СчетаИсключения	= БухгалтерскийУчет.СписокСчетов("104.00,Н02,ОЦИ,МЦК");
	ПорядковыйНомер = ДополнительныеПараметры.ПорядковыйНомер;
	
	ИмяДокумента 	= Документ.Метаданные().Имя;
	ФорматЭкспорта 	= ДополнительныеПараметры.ФорматВыгрузки;

	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		ТекстСообщения = НСтр("ru='Не указан формат выгрузки.
		|Невозможно выполнить выгрузку файла.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат "Ошибка";		
	КонецЕсли;
	
	СчетМЦК = БухгалтерскийУчет.СчетПоКоду("МЦК");
	
	ФорматнаяСтрокаПорядковогоНомера = "ЧЦ=2; ЧВН=";
	
	Если ПорядковыйНомер >= 100 Тогда
		ФорматнаяСтрокаПорядковогоНомера = "ЧДЦ=0; ЧГ=0";
	КонецЕсли;
	
	Период = ДополнительныеПараметры.Период;
	
	Периодичность = "Q";
	ПериодичностьПРД = 4;
	Если Период.Периодичность = Перечисления.Периодичность.Месяц Тогда
		Периодичность = "M"; 
		ПериодичностьПРД = 3;
	ИначеЕсли Период.Периодичность = Перечисления.Периодичность.Год Тогда
		Периодичность = "Y"; 
		ПериодичностьПРД = 5;
	ИначеЕсли Период.Периодичность = Перечисления.Периодичность.День Тогда
		Периодичность = "D"; 
		ПериодичностьПРД = 1;
	КонецЕсли;
	ПериодичностьРДТ = ?(Периодичность = "D", Формат(Документ.Дата,"ДЛФ=D"), Формат(КонецДня(Период.ДатаОкончания) + 1,"ДЛФ=D"));
	
	МассивВидовИзвещенияСПередаваемымиПроводками = Новый Массив;
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаТребований);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаОбязательств);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаФинансовыхВложений);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаВложенийВФинансовыеАктивы);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаРБП);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.НачислениеДохода);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.РасчетыПоМБТ);
	
	СписокСчетов26 = БухгалтерскийУчет.СписокСчетов("26");
	
	УчетныйНомерБО = РегистрыСведений.УчетныеНомераОбязательств.Получить(Новый Структура("Обязательство", Документ.Договор));
	УчетныйНомерБО.Свойство("УчетныйНомерОбязательства", УчетныйНомерБО);   
	
	ОбщаяСуммаДт = 0;
	ОбщаяСуммаКт = 0;

	Если МассивВидовИзвещенияСПередаваемымиПроводками.Найти(Документ.ВидИзвещения) <> Неопределено Тогда
		
		Если Документ.ПередаваемыеПроводки.Количество() = 0 Тогда
			Возврат "Документ пуст.";
		КонецЕсли;
			
		КБК_ФИН = ?(Документ.ПередаваемыеПроводки.Количество(), Документ.ПередаваемыеПроводки[0].КПСДт, "-");
	
		Для Каждого СтрокаТЧ Из Документ.ПередаваемыеПроводки Цикл
			
			СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТЧ.СчетДт);
			СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТЧ.СчетКт);
			
			Если СчетМЦК = СтрокаТЧ.СчетКт ИЛИ СчетМЦК = СтрокаТЧ.СчетДт
				ИЛИ СписокСчетов26.Найти(СтрокаТЧ.СчетДт) <> Неопределено ИЛИ СписокСчетов26.Найти(СтрокаТЧ.СчетКт) <> Неопределено 
				ИЛИ СвойстваСчетаДт.Забалансовый ИЛИ СвойстваСчетаКт.Забалансовый Тогда
				Продолжить;
			КонецЕсли;

			ОбщаяСуммаДт = ОбщаяСуммаДт + СтрокаТЧ.Сумма;
			ОбщаяСуммаКт = ОбщаяСуммаКт + СтрокаТЧ.Сумма;
		
		КонецЦикла;	

	Иначе
		
		Если Документ.ДокументыПередачи.Количество() = 0 Тогда
			Возврат "Документ пуст.";
		КонецЕсли;

		РегистрБухгалтерииВыборка = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ВыбратьПоРегистратору(Документ.ДокументыПередачи[0].ДокументПередачи);
		РегистрБухгалтерииВыборка.Следующий();
		КБК_ФИН = РегистрБухгалтерииВыборка.КПСДт;

		МассивСтруктурСтрок = Новый Массив;
		
		Для Каждого СтрокаТЧ Из Документ.ДокументыПередачи Цикл
			
			ВыполнятьПоискДопКолонок = Ложь;
			НайденныеСтрокиЗначенийДопКолонок = ТаблицаЗначенийДопКолонок.НайтиСтроки(Новый Структура("Документ", СтрокаТЧ.ДокументПередачи));
				Если НайденныеСтрокиЗначенийДопКолонок.Количество() И СтрокаТЧ.ДокументПередачи.ОсновныеСредства.Количество() = НайденныеСтрокиЗначенийДопКолонок.Количество() Тогда
					ВыполнятьПоискДопКолонок = Истина;
				КонецЕсли;
						
			РегистрБухгалтерииВыборка = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ВыбратьПоРегистратору(СтрокаТЧ.ДокументПередачи);
			Пока РегистрБухгалтерииВыборка.Следующий() Цикл
				
				СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РегистрБухгалтерииВыборка.СчетДт);
				СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РегистрБухгалтерииВыборка.СчетКт);
					
				Если СчетаИсключения.Найти(РегистрБухгалтерииВыборка.СчетКт) <> Неопределено ИЛИ СчетМЦК = РегистрБухгалтерииВыборка.СчетДт 
					Или СписокСчетов26.Найти(РегистрБухгалтерииВыборка.СчетДт) <> Неопределено ИЛИ СписокСчетов26.Найти(РегистрБухгалтерииВыборка.СчетКт) <> Неопределено
					ИЛИ СвойстваСчетаДт.Забалансовый ИЛИ СвойстваСчетаКт.Забалансовый Тогда
					Продолжить;
				КонецЕсли;
					
				СтруктураСтроки = Новый Структура;
				СтруктураСтроки.Вставить("Запись", РегистрБухгалтерииВыборка.Содержание); 

				ОбщаяСуммаДт = ОбщаяСуммаДт + РегистрБухгалтерииВыборка.Сумма;
				ОбщаяСуммаКт = ОбщаяСуммаКт + РегистрБухгалтерииВыборка.Сумма;
	
				МассивСтруктурСтрок.Добавить(СтруктураСтроки);
			КонецЦикла;
		КонецЦикла;	
		
		Если МассивСтруктурСтрок.Количество() = 0 Тогда
			Возврат "В извещении документы передачи не проведены.";
		КонецЕсли;
	КонецЕсли;	
		
	ДополнительныеПараметрыФорматов = Новый Структура;
	ДополнительныеПараметрыФорматов.Вставить("Периодичность", 		Периодичность);  
	ДополнительныеПараметрыФорматов.Вставить("ПериодичностьПРД", 	ПериодичностьПРД);
	ДополнительныеПараметрыФорматов.Вставить("ПериодичностьРДТ", 	ПериодичностьРДТ);
	ДополнительныеПараметрыформатов.Вставить("УчетныйНомерБО", 		УчетныйНомерБО);
	ДополнительныеПараметрыформатов.Вставить("КБК_ФИН", 			КБК_ФИН);
	ДополнительныеПараметрыформатов.Вставить("ОбщаяСуммаДт", 		ОбщаяСуммаДт);
	ДополнительныеПараметрыформатов.Вставить("ОбщаяСуммаКт", 		ОбщаяСуммаКт);
	
	СтруктураДляФормирования = Новый Структура; 
	СтруктураДляФормирования.Вставить("КассовыйОрган"); // Не используется
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", ФорматЭкспорта.Владелец);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", Справочники.НастройкиОбменаБанкиКС.ПустаяСсылка());
	СтруктураДляФормирования.Вставить("Организация", Организация);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка()); 
	
	ОбщОбъектыОбмена = Новый ТаблицаЗначений;
	ОбщОбъектыОбмена.Колонки.Добавить("ОписаниеОшибки");
	ОбщОбъектыОбмена.Колонки.Добавить("ИмяФайлаВыгрузки");
	ОбщОбъектыОбмена.Колонки.Добавить("Формат");
	ОбщОбъектыОбмена.Колонки.Добавить("Объект");
	ОбщОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	СтрокаОбмена = ОбщОбъектыОбмена.Добавить();
	СтрокаОбмена.Объект = Документ;
	СтрокаОбмена.Формат = ФорматЭкспорта;			
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена", ОбщОбъектыОбмена);	
	
	ОбработкаФормирования = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();  
	ОбработкаФормирования.ИдентификаторСообщения = "";
	ОбработкаФормирования.мОрганизация = Организация;
	ОбработкаФормирования.СоответствиеОбработанныхФорматов = Неопределено;
	ОбработкаФормирования.ДополнительныеПараметрыЭкспорта = ДополнительныеПараметрыФорматов;
	ОбработкаФормирования.СформироватьФайлы(СтруктураДляФормирования);
	
	РезультатФормирования = "";
	ТаблицаОписанияОшибокСтрокой = "";
	Для Каждого СтрокаОбмена Из СтруктураДляФормирования.ОбъектыОбмена Цикл 
		РезультатФормирования = СтрокаОбмена.РезультатФормирования;
		ТаблицаОписанияОшибокСтрокой = СтрокаОбмена.ОписаниеОшибки;
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(РезультатФормирования) Тогда
		ПричинаОшибок = "";
		Если ЗначениеЗаполнено(ТаблицаОписанияОшибокСтрокой) Тогда
			ТаблицаОписанияОшибок = ЗначениеИзСтрокиВнутр(ТаблицаОписанияОшибокСтрокой);
			МассивСтрокОшибок = Новый Массив;
			Для Каждого СтрТЧ Из ТаблицаОписанияОшибок Цикл
				СтрокаОшибки = "";
				Если ЗначениеЗаполнено(СтрТЧ.ПолеФайла) Тогда
					СтрокаОшибки = "Поле файла: "+СтрТЧ.ПолеФайла+". ";
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрТЧ.Ошибка) Тогда
					СтрокаОшибки = СтрокаОшибки +"Описание ошибки: "+СтрТЧ.Ошибка;
				КонецЕсли;
				МассивСтрокОшибок.Добавить(СтрокаОшибки);
			КонецЦикла;
			ПричинаОшибок = СтрСоединить(МассивСтрокОшибок,Символы.ПС);
		КонецЕсли;
		ТекстСообщения = НСтр("ru='Не удалось сформивовать txt файл по документу ""%1"" по причине:
		|%2
		|Невозможно выгрузить файл.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Документ, ПричинаОшибок);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);  
		Возврат "Ошибка";
	КонецЕсли;  

	ЗаписьТекста = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.ANSI);
	ЗаписьТекста.Записать(РезультатФормирования);  
	ЗаписьТекста.Закрыть();

	СтруктураФайла.ДвоичныеДанные = Новый ДвоичныеДанные(ВременныйФайл);
	СтруктураФайла.ИмяФайла = СтрШаблон("%1%2%3.txt", ДополнительныеПараметры.КодФормы, Периодичность, Формат(ПорядковыйНомер, ФорматнаяСтрокаПорядковогоНомера));
	
	Попытка
		УдалитьФайлы(ВременныйФайл);
	Исключение
		ЗаписьСобытияВЖурналРегистрации("Не удалось удалить файл: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;
	
	Возврат "Успешно";
	
КонецФункции 

Функция ПреобразоватьМассивВТаблицуЗначений(мсДанные) Экспорт
    
    тзДанные = Новый ТаблицаЗначений;
    Для Каждого ЭлементМассива Из мсДанные Цикл
        Если тзДанные.Колонки.Количество() = 0 Тогда
            Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
				МассивДопустимыеТипы = Новый Массив; 
				Если ЗначениеСтруктуры.Ключ = "СуммаДт" ИЛИ ЗначениеСтруктуры.Ключ = "СуммаКт" Тогда
					ТипКолонки = Тип("Число");
				Иначе
					ТипКолонки = ТипЗнч(ЗначениеСтруктуры.Значение);
				КонецЕсли;
    			МассивДопустимыеТипы.Добавить(ТипКолонки);                     
    			Описание_Типов = Новый ОписаниеТипов(МассивДопустимыеТипы);
				тзДанные.Колонки.Добавить(ЗначениеСтруктуры.Ключ,Описание_Типов);
            КонецЦикла;
        КонецЕсли;
        НоваяСтрока = тзДанные.Добавить();
        Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
            НоваяСтрока[ЗначениеСтруктуры.Ключ] = ЗначениеСтруктуры.Значение;
        КонецЦикла;
    КонецЦикла;
    
    Возврат тзДанные;
    
КонецФункции

#КонецОбласти

#КонецЕсли