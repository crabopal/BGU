
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбработкаСсылка", ОбъектСсылка);   
	
	ТекстЗаголовка = "Загрузка статусов исходящих извещений из файлов ГИИС ""Электронный бюджет""";		
	ЭтотОбъект.Заголовок = ТекстЗаголовка;
	
	КлиентТекущегоПользователя = ПолучитьТекущийСеансИнформационнойБазы().ИмяПриложения; 
	Если КлиентТекущегоПользователя = "WebClient" Тогда
		ЗагрузитьИзКаталога = Ложь;
		ЭтоВебКлиент = Истина;
	КонецЕсли;  
	
	УстановитьВидимостьФормы(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСообытийТаблицыФайлыДокументовУчета

&НаКлиенте
Процедура ТаблицаФайлыИзвещенийПометкаПриИзменении(Элемент)
	
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);	
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ОтметитьВсеИзвещения(Команда)
	УстановитьПометкиИзвещений(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометкиИзвещения(Команда)
	УстановитьПометкиИзвещений(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиВыделенным(Команда)
	
	ДокСУстановленнойПометкой = ТаблицаФайлыДокументовУчета.НайтиСтроки(Новый Структура("Пометка", Истина));
	
	ВыбраннаяТаблица = Элементы.ТаблицаФайлыДокументовУчета;
	МассивВыделенныхСтрок = ВыбраннаяТаблица.ВыделенныеСтроки;
		
	ИзменитьПометкуВыделенныхДокументов(МассивВыделенныхСтрок, ДокСУстановленнойПометкой.Количество());
	
КонецПроцедуры

&НаКлиенте    
Процедура ИзменитьСтатус(Команда)
	
	Если ТаблицаФайлыДокументовУчета.Количество() = 0 Тогда    
		ПоказатьПредупреждение(,"Таблица извещений пуста.");
		Возврат
	КонецЕсли;
	
	Выбран = Ложь;
	Для каждого Стр Из ТаблицаФайлыДокументовУчета Цикл
		Если Стр.Пометка Тогда
			Выбран = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла; 
	
	Если Не Выбран Тогда  
		ПоказатьПредупреждение(,"Не выбраны извещения.");
		Возврат
	КонецЕсли;
	
	ПараметрыЗапуска = Новый Структура("ТекстСообщения", "Изменение статуса");
	ПараметрыВыполнения = Новый Структура;
	ЗапуститьФоновоеЗадание(ПараметрыЗапуска, ПараметрыВыполнения);  
	
КонецПроцедуры    

&НаКлиенте
Процедура НайтиФайлыИзвещений(Команда)
	
		ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
		ПараметрыДиалога.Фильтр = НСтр("ru = 'Текстовый файл'; en = 'Text file'") + "(*.txt)|*.txt|";
		
		Оповещение = Новый ОписаниеОповещения("НачатьЗагрузкуДокументовУчета", ЭтотОбъект);
		
		НачатьПомещениеФайловНаСервер(
			Оповещение,
			,,
			ПараметрыДиалога);	
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьФормы(Форма)
	
	Объект 	 = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ЗагрузитьИзКаталога", "Видимость", Не Форма.ЭтоВебКлиент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ПутьЗагрузки", "Видимость", Не Форма.ЭтоВебКлиент); 
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ВыгрузитьДокументыУчета", "Заголовок", ?(Форма.ЗагрузитьИзКаталога, "Выгрузить", "Выгрузить Архив"));
		
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПометкуВыделенныхДокументов(МассивВыделенныхСтрок, КоличестовУстОтметок)

	ТаблицаДокументовУчета = ТаблицаФайлыДокументовУчета; 
			
	Для Каждого Строка Из МассивВыделенныхСтрок Цикл
		
		Если Строка = МассивВыделенныхСтрок[МассивВыделенныхСтрок.Количество() - 1] Тогда
			ИндексСтроки = МассивВыделенныхСтрок[МассивВыделенныхСтрок.Количество() - 2];
			ЭтоПоследнийЭлемент = Истина;
		Иначе
			ИндексСтроки = Строка - 1;	
		КонецЕсли;
		
		ДанныеСтроки = Элементы.ТаблицаФайлыДокументовУчета.ДанныеСтроки(ИндексСтроки);
		ДанныеСтроки.Пометка = Истина;

	КонецЦикла;	
		
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);

КонецПроцедуры	

&НаКлиенте
Асинх Процедура НачатьЗагрузкуДокументовУчета(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ПомещенныеФайлы = Новый Массив; 
	
	Для Каждого Строка Из ВыбранныеФайлы Цикл
		
		#Если ВебКлиент Тогда
			ОписаниеФайла = Новый Структура; 
			ОписаниеФайла.Вставить("ИмяФайла", Строка.СсылкаНаФайл.Имя);

			ПоместитьФайлыВМасивВебКлиент(Строка.Адрес, ОписаниеФайла, ПомещенныеФайлы);
			
		#Иначе
			Файл = Строка.СсылкаНаФайл.Файл;  
			
			Если Файл.Расширение = ".txt" Тогда
				
				ДанныеФайла = Ждать СоздатьДвоичныеДанныеИзФайлаАсинх(Файл.ПолноеИмя);
				
				ОписаниеФайла = Новый Структура; 
				ОписаниеФайла.Вставить("ЭтоВременныйФайл", Ложь);
				ОписаниеФайла.Вставить("ИмяФайла", Файл.Имя);
				ОписаниеФайла.Вставить("ПолноеИмя", файл.ПолноеИмя);
				ОписаниеФайла.Вставить("ДанныеФайла", ДанныеФайла);
				ПомещенныеФайлы.Добавить(ОписаниеФайла);
			Иначе
				Продолжить;
			КонецЕсли;
		#КонецЕсли 
	КонецЦикла; 
		
	Если ТипЗнч(ПомещенныеФайлы) = Тип("Массив") Тогда
		ПрочитатьФайлыИзвещенийНаСервере(ПомещенныеФайлы); 
	КонецЕсли;
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьФайлыВМасивВебКлиент(Знач Адрес, ОписаниеФайла , ПомещенныеФайлы)
	
	ФайлВременногоХранилища = ПолучитьИзВременногоХранилища(Адрес);
	
	СтароеИмяВременногоФайла = ПолучитьИмяВременногоФайла(".txt");
	ВременныйФайл = Новый Файл(СтароеИмяВременногоФайла);  
	ИмяФайла = ОписаниеФайла.ИмяФайла;
	ИмяВременногоФайла = ВременныйФайл.Путь + ИмяФайла;
		
	ФайлВременногоХранилища.Записать(ИмяВременногоФайла);
								 
	ДанныеФайла = Новый ДвоичныеДанные(ИмяВременногоФайла); 
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	ОписаниеФайла = Новый Структура;
	ОписаниеФайла.Вставить("ЭтоВременныйФайл", Истина);
	ОписаниеФайла.Вставить("ИмяФайла", ИмяФайла);
	ОписаниеФайла.Вставить("ПолноеИмя", ИмяВременногоФайла);
	ОписаниеФайла.Вставить("ДанныеФайла", ДанныеФайла);
	ПомещенныеФайлы.Добавить(ОписаниеФайла);
		
КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлыИзвещенийНаСервере(ПомещенныеФайлы)

	ТаблицаФайлыДокументовУчета.Очистить();
	
	ТаблицаДанныхИзвещений = Новый ТаблицаЗначений;
	ТаблицаДанныхИзвещений.Колонки.Добавить("Номер", ОбщегоНазначения.ОписаниеТипаСтрока(11));
	ТаблицаДанныхИзвещений.Колонки.Добавить("ИмяФайла", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	ТаблицаДанныхИзвещений.Колонки.Добавить("Дата", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	
	Для Каждого ДанныеФайла Из ПомещенныеФайлы Цикл

		ИмяВременногоФайла  = ПолучитьИмяВременногоФайла("txt");
		ДвоичныеДанныеФайла = ДанныеФайла.ДанныеФайла;
		Попытка
			ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
		Исключение  
			ТекстОшибки = "Не удалось загрузить файл. " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			УдалитьФайлы(ИмяВременногоФайла);
			Продолжить;
		КонецПопытки;
		
		ЧтениеТекста = Новый ЧтениеТекста(ИмяВременногоФайла);
		
		СтрокаФайла = ЧтениеТекста.ПрочитатьСтроку();
		
		НоваяСтрокаТаблицыИзвещений = ТаблицаДанныхИзвещений.Добавить();
		
		ДанныхНет = Истина;
		МассивОтсутствующихРеквизитов = Новый Массив;
		
		Пока СтрокаФайла <> Неопределено Цикл
			
			Если СтрНачинаетсяС(СтрокаФайла, "НОМ_ДОК=") Тогда
				НоваяСтрокаТаблицыИзвещений.Номер = СтрЗаменить(СтрокаФайла, "НОМ_ДОК=", "");
				ДанныхНет = Ложь;
			КонецЕсли;
			
			Если СтрНачинаетсяС(СтрокаФайла, "Д_ДОК=") Тогда
				НоваяСтрокаТаблицыИзвещений.Дата = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрЗаменить(СтрокаФайла, "Д_ДОК=", ""), ЧастиДаты.ДатаВремя);
				ДанныхНет = Ложь;
			КонецЕсли;
	
			МассивРазделеннойСтроки = СтрРазделить(СтрокаФайла, "|", Истина);
			Если МассивРазделеннойСтроки.Количество() > 5 Тогда
				ПроверкаСтроки = СтрЗаменить(МассивРазделеннойСтроки[1], "*", "");
				Если СтрДлина(ПроверкаСтроки) = 0 Тогда
					СтрокаФайла = ЧтениеТекста.ПрочитатьСтроку();
					Продолжить;
				КонецЕсли;
				
				Для Каждого Подстрока Из МассивРазделеннойСтроки Цикл
					ПроверкаСтроки = СтрЗаменить(Подстрока, "*", "");
					ДлинаПодстроки = СтрДлина(Подстрока);
					Если СтрДлина(ПроверкаСтроки) = 0 И ДлинаПодстроки > 0 Тогда
						Если ДлинаПодстроки = 17 Тогда
							МассивОтсутствующихРеквизитов.Добавить("КБК");
						ИначеЕсли ДлинаПодстроки = 1 Тогда
							МассивОтсутствующихРеквизитов.Добавить("КФО");
					    ИначеЕсли ДлинаПодстроки = 5 Тогда
							МассивОтсутствующихРеквизитов.Добавить("счет");
						ИначеЕсли ДлинаПодстроки = 3 Тогда
							МассивОтсутствующихРеквизитов.Добавить("КОСГУ");
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
				
			СтрокаФайла = ЧтениеТекста.ПрочитатьСтроку();
			
		КонецЦикла;
		
		ЧтениеТекста.Закрыть();
		
		Если ДанныхНет Тогда
			ТаблицаДанныхИзвещений.Удалить(НоваяСтрокаТаблицыИзвещений);	
			Продолжить;	
		КонецЕсли;
		
		МассивОтсутствующихРеквизитов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивОтсутствующихРеквизитов);
		
		Если МассивОтсутствующихРеквизитов.Количество() Тогда
			ТекстОшибки = "Файл не загружен.
						|Загружаемый файл не соответствует формату подписанного в ГИИС ЭБ извещения. В файле не указаны реквизиты: КФО, КБК, счет, КОСГУ принимающей стороны. Необходимо подписать Документ учета в ГИИС ""Электронный бюджет"", выгрузить и загрузить повторно.";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			ТаблицаДанныхИзвещений.Удалить(НоваяСтрокаТаблицыИзвещений);
			Продолжить;	
		КонецЕсли;
		
		НоваяСтрокаТаблицыИзвещений.ИмяФайла = ДанныеФайла.ИмяФайла;
		Если ДанныеФайла.ЭтоВременныйФайл Тогда
			УдалитьФайлы(ДанныеФайла.ПолноеИмя);
		КонецЕсли;
		
	КонецЦикла;

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаДанныхИзвещений.Номер КАК Номер,
			|	ТаблицаДанныхИзвещений.Дата КАК Дата,
			|	ТаблицаДанныхИзвещений.ИмяФайла КАК ИмяФайла
			|ПОМЕСТИТЬ ВТ_ВнешняяТаблица
			|ИЗ
			|	&ТаблицаДанныхИзвещений КАК ТаблицаДанныхИзвещений
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ВнешняяТаблица.ИмяФайла КАК ИмяФайла,
			|	ЕСТЬNULL(ИзвещениеИсходящее.Ссылка, ЗНАЧЕНИЕ(Документ.ИзвещениеИсходящее.ПустаяСсылка)) КАК ДокументУчета,
			|	ИСТИНА КАК Пометка,
			|	ЕСТЬNULL(СтатусыДокументовИзвещения.СтатусОбмена, НЕОПРЕДЕЛЕНО) КАК Статус,
			|	ВТ_ВнешняяТаблица.Дата КАК Дата,
			|	ВТ_ВнешняяТаблица.Номер КАК Номер
			|ИЗ
			|	ВТ_ВнешняяТаблица КАК ВТ_ВнешняяТаблица
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИзвещениеИсходящее КАК ИзвещениеИсходящее
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументовПриОбменеСГИИСЭБ.СрезПоследних КАК СтатусыДокументовИзвещения
			|			ПО (СтатусыДокументовИзвещения.ДокументУчета = ИзвещениеИсходящее.Ссылка)
			|		ПО ВТ_ВнешняяТаблица.Номер = ИзвещениеИсходящее.Номер
			|			И (ВТ_ВнешняяТаблица.Дата = НАЧАЛОПЕРИОДА(ИзвещениеИсходящее.Дата, ДЕНЬ))";
		 	
	Запрос.УстановитьПараметр("ТаблицаДанныхИзвещений", ТаблицаДанныхИзвещений);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр Из РезультатЗапроса Цикл
		
		Если Не ЗначениеЗаполнено(Стр.ДокументУчета) Тогда
			ТекстОшибки = СтрШаблон("Для файла %1, не найдено соответствующее ДокументУчета %2, %3. 
									|Файл не загружен.", Стр.ИмяФайла, Стр.Дата, Стр.Номер);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Продолжить;
		КонецЕсли;
		
		Если Стр.Статус = 2 Тогда 
			
			ТекстОписания = "Файл %1 соответствующий Документу учета %2 уже находится в состоянии ""Подписан в ГИИС ЭБ"". 
							|Файл не загружен.";	
			
			ТекстОшибки = СтрШаблон(ТекстОписания, Стр.ИмяФайла, Стр.ДокументУчета);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаФайлыДокументовУчета.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеВыбранныхДокументов(Форма)
	
	ШаблонЗаголовка = НСтр("ru = 'Выбрано: %1'"); 
			
	ЗагружаемыеДокументы = ТаблицаФайлыДокументовУчета.НайтиСтроки(Новый Структура("Пометка", Истина));
	Форма.Элементы.ДекорацияЗагружаемыеДокументы.Заголовок = СтрШаблон(ШаблонЗаголовка, ЗагружаемыеДокументы.Количество());
			
КонецПроцедуры 

&НаСервере
Процедура ЗаписьСобытияВЖурналРегистрации(ТекстСообщения)
	
	ЗаписьЖурналаРегистрации("ДополнительныеОтчетыОбработки.БГУ_ВыгрузкаЗагрузкаИзвещений", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения, РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкиИзвещений(Значение)
	
	ТаблицаДокументовУчета = ТаблицаФайлыДокументовУчета; 	
	
	НомерВыделенногоДокумента = 0;
	
	Для Каждого СтрокаТЗ Из ТаблицаДокументовУчета Цикл
		
		СтрокаТЗ.Пометка = Значение;	

	КонецЦикла;
	
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьФоновоеЗадание(ПараметрыЗапуска, ПараметрыВыполнения, ДополнительныеПараметры = Неопределено)

	ПараметрыВыполнения.Вставить("Описание", "Начало подготовки данных обработки");
	ПараметрыВыполнения.Вставить("ТекстСообщения", ПараметрыЗапуска.ТекстСообщения);
	
	Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаданиеНаОбработкуВыполнено", ЭтотОбъект, ПараметрыВыполнения);
		ДлительнаяОперация = ВыполнитьФоновоеЗаданиеНаСервере(ПараметрыВыполнения, ПараметрыЗапуска.ТекстСообщения, ИмяФормы, ОбъектСсылка, УникальныйИдентификатор);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
		ПараметрыОжидания.Интервал = 1;
		ПараметрыОжидания.ТекстСообщения = ПараметрыЗапуска.ТекстСообщения;
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
		
	Иначе
		ЗаписьСобытияВЖурналРегистрации("Запуск в синхронном режиме");
		ЗапуститьОбработкуВСинхронномРежиме(ПараметрыЗапуска, ПараметрыВыполнения, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьФоновоеЗаданиеНаСервере(Знач ПараметрыВыполнения, НаименованиеЗадания, ИмяФормы, ОбработкаСсылка, УникальныйИдентификатор)
	
	ДополнитьПараметрыВыполненияНаСервере(ПараметрыВыполнения, "ОтразитьВУчете");
	
	ПараметрыЗадания = Новый Структура;

	ПараметрыЗадания.Вставить("ИмяОбработки", СтрРазделить(ИмяФормы, ".")[1]);
	ПараметрыЗадания.Вставить("ИмяМетода", "ОтразитьВУчете");
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
	ПараметрыЗадания.Вставить("ОбработкаСсылка", ОбработкаСсылка);
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	РезультатФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне("ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки", ПараметрыЗадания, ПараметрыВыполнения);
	Возврат РезультатФоновогоЗадания;
	
КонецФункции

&НаКлиенте
Процедура ЗаданиеНаОбработкуВыполнено(Результат, ДополнительныеПараметры) Экспорт
		
	ОчиститьСообщения();
	
	Если Результат = Неопределено Тогда
		Возврат;
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	ИначеЕсли Результат.Статус = "Выполнено" Тогда    
		ТаблицаФайлыДокументовУчета.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаДвижений_Синхронно(ПараметрыЗапуска, Знач ПараметрыВыполнения, ДополнительныеПараметры)
	
	ДополнитьПараметрыВыполненияНаСервере(ПараметрыВыполнения, "ОтразитьВУчете");
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	МассивПараметров = Новый Массив();
	МассивПараметров.Добавить(ПараметрыВыполнения);
	МассивПараметров.Добавить(АдресВоВременномХранилище);
	ОбщегоНазначения.ВыполнитьМетодОбъекта(ОбработкаОбъект, "ОтразитьВУчете", МассивПараметров);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОбработкуВСинхронномРежиме(ПараметрыЗапуска, Знач ПараметрыВыполнения, ДополнительныеПараметры)
	
	ОбработкаДвижений_Синхронно(ПараметрыЗапуска, ПараметрыВыполнения, ДополнительныеПараметры);
	ТаблицаФайлыДокументовУчета.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьПараметрыВыполненияНаСервере(ПараметрыВыполнения, ИмяПроцедуры)

	Если ИмяПроцедуры = "ОтразитьВУчете" Тогда
		
		МассивДокументов = ТаблицаФайлыДокументовУчета.Выгрузить(Новый Структура("Пометка", Истина)).ВыгрузитьКолонку("ДокументУчета");
		ПараметрыВыполнения.Вставить("МассивОтражаемыхДокументов", МассивДокументов);
			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
