
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбработкаСсылка", ОбъектСсылка);
	
	Если НЕ ЗначениеЗаполнено(Параметры.Организация) Тогда
		ОрганизацияОтбора = ОбщегоНазначенияБГУ.ТекущаяОрганизация();	
	Иначе
		ОрганизацияОтбора = Параметры.Организация;
	КонецЕсли;
	Организация = ОрганизацияОтбора; 
	
	КлиентТекущегоПользователя = ПолучитьТекущийСеансИнформационнойБазы().ИмяПриложения; 
	Если КлиентТекущегоПользователя = "WebClient" Тогда
		ВыгрузитьВКаталог = Ложь;
		ЭтоВебКлиент = Истина;
	КонецЕсли;
	
	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	
	ДокументИсходящееИзвещение = Документы.ИзвещениеИсходящее.ПустаяСсылка();
	ИдентификаторОбъектовМетаданных = Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("Имя", ДокументИсходящееИзвещение.Метаданные().Имя);
	Объект.ФорматОбмена = ПолучитьФормат(ИдентификаторОбъектовМетаданных);
	
	ТекстЗаголовка = "Выгрузка исходящих извещений в файлы для ГИИС ""Электронный бюджет""";
	ЭтотОбъект.Заголовок = ТекстЗаголовка;
	УстановитьВидимостьФормы(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапки

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	НайтиИзвещенияНаСервере(); 
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПериодВыгрузкиПриИзменении(Элемент)
	НайтиИзвещенияНаСервере(); 
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСообытийТаблицыНайденныеДокументыУчета

&НаКлиенте
Процедура ТаблицаНайденныеИзвещенияПометкаПриИзменении(Элемент)
	
	ОтмеченныеДокументы = ТаблицаНайденныеДокументыУчета.НайтиСтроки(Новый Структура("Пометка", Истина));
	
	Если ОтмеченныеДокументы.Количество() > 99 Тогда
		ТекущаяСтрока = Элементы.ТаблицаНайденныеДокументыУчета.ТекущиеДанные;
		ТекущаяСтрока.Пометка = Ложь;
		
		ТекстПредупреждения = "Не может быть выгружено больше 99 документов учета, из-за ограничений формата обмена с ГИИС ""Электронный бюджет""";
		ПоказатьПредупреждение(,ТекстПредупреждения);
	Иначе
		ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ОтметитьВсеИзвещения(Команда)
	УстановитьПометкиИзвещений(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометкиИзвещения(Команда)
	УстановитьПометкиИзвещений(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиВыделенным(Команда)
	
	ДокСУстановленнойПометкой = ТаблицаНайденныеДокументыУчета.НайтиСтроки(Новый Структура("Пометка", Истина));
	
	ВыбраннаяТаблица = Элементы.ТаблицаНайденныеДокументыУчета;
	МассивВыделенныхСтрок = ВыбраннаяТаблица.ВыделенныеСтроки;	
		
	ИзменитьПометкуВыделенныхДокументов(МассивВыделенныхСтрок, ДокСУстановленнойПометкой.Количество());
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДокументыУчета(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат
	КонецЕсли;
	
	Если ТаблицаНайденныеДокументыУчета.Количество() = 0 Тогда    
		ПоказатьПредупреждение(,"Таблица извещений пуста.");
		Возврат
	КонецЕсли;
	
	Выбран = Ложь;
	Для Каждого Стр Из ТаблицаНайденныеДокументыУчета Цикл
		Если Стр.Пометка Тогда
			Выбран = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла; 
	
	Если Не Выбран Тогда  
		ПоказатьПредупреждение(,"Не выбраны извещения.");
		Возврат
	КонецЕсли;
	
	Если КоличествоОшибокВВыгружаемыхДокументах() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ФорматОбмена) Тогда
		ТекстСообщения = НСтр("ru='Не указан формат выгрузки.
		|Невозможно выполнить выгрузку.'");
		ПоказатьПредупреждение(,ТекстСообщения);
		Возврат;		
	КонецЕсли;
	
	ВыгрузитьВКаталог = Истина;
	МассивНайденныхФайлов = Новый Массив;
	ИмяКаталога = "";   
	
	ОбменДаннымиКлиент.ОбработчикВыбораФайловогоКаталога(Объект, "КаталогДляВыгрузки", Ложь); 
	ИмяКаталога = Объект.КаталогДляВыгрузки;
	Маска = СтрШаблон("*805h??%1.txt", ПолучитьПериодичностьВыгружаемогоФайла(ПериодВыгрузки));
	МассивНайденныхФайлов = НайтиФайлы(ИмяКаталога, Маска);
	
	Если МассивНайденныхФайлов.Количество() > 0 Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗагрузкеФайлвВКатаог", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Каталог: "+ ИмяКаталога +" не пустой, продолжение выгрузки приведет к перезаписи файлов.
							|Продолжить выгрузку?'"), Режим, 0);
		
	Иначе
		ВыполнитьВыгрузкуФайловИзвещения();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДокументыУчетаВАрхив(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат
	КонецЕсли;
	
	Если ТаблицаНайденныеДокументыУчета.Количество() = 0 Тогда    
		ПоказатьПредупреждение(,"Таблица извещений пуста.");
		Возврат
	КонецЕсли;
	
	Выбран = Ложь;
	Для Каждого Стр Из ТаблицаНайденныеДокументыУчета Цикл
		Если Стр.Пометка Тогда
			Выбран = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла; 
	
	Если Не Выбран Тогда  
		ПоказатьПредупреждение(,"Не выбраны извещения.");
		Возврат
	КонецЕсли;
	
	Если КоличествоОшибокВВыгружаемыхДокументах() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ФорматОбмена) Тогда
		ТекстСообщения = НСтр("ru='Не указан формат выгрузки.
		|Невозможно выполнить выгрузку.'");
		ПоказатьПредупреждение(,ТекстСообщения);
		Возврат;		
	КонецЕсли;
	
	ВыгрузитьВКаталог = Ложь;
	
	ВыполнитьВыгрузкуФайловИзвещения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументУчета(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаНайденныеДокументыУчета.ТекущиеДанные;  
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДокументУчета = ТекущиеДанные.ДокументУчета;
	Если ЗначениеЗаполнено(ДокументУчета) Тогда  
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ",ДокументУчета);
		ОткрытьФорму("Документ.ИзвещениеИсходящее.ФормаОбъекта", ПараметрыФормы);	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьПериодичностьВыгружаемогоФайла(Период) 

	Периодичность = "Q";
	Если Период.Периодичность = Перечисления.Периодичность.Месяц Тогда
		Периодичность = "M"; 
	ИначеЕсли Период.Периодичность = Перечисления.Периодичность.Год Тогда
		Периодичность = "Y"; 
	ИначеЕсли Период.Периодичность = Перечисления.Периодичность.День Тогда
		Периодичность = "D"; 
	КонецЕсли;
	
	Возврат Периодичность; 

КонецФункции

&НаСервере
Функция ПолучитьФормат(ИдентификаторОбъектовМетаданных)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторОбъектовМетаданных", ИдентификаторОбъектовМетаданных);
	Запрос.УстановитьПараметр("ДатаДействия", ТекущаяДата());

	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
	               |ИЗ
	               |	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
	               |ГДЕ
	               |	ВЫРАЗИТЬ(СписокФорматовНастройкиОбменаБанкиКС.Формат КАК Справочник.ФорматыОбменаБанкиКС).ИдентификаторОбъекта = &ИдентификаторОбъектовМетаданных
	               |	И ВЫБОР
	               |			КОГДА ВЫРАЗИТЬ(СписокФорматовНастройкиОбменаБанкиКС.Формат КАК Справочник.ФорматыОбменаБанкиКС).ДатаДействия <> ДАТАВРЕМЯ(1, 1, 1)
	               |				ТОГДА ВЫРАЗИТЬ(СписокФорматовНастройкиОбменаБанкиКС.Формат КАК Справочник.ФорматыОбменаБанкиКС).ДатаДействия <= &ДатаДействия
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ФорматЭкспорта;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаОЗагрузкеФайлвВКатаог(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВыполнитьВыгрузкуФайловИзвещения();
	Иначе
		ТекстСообщения = "Выгрузка отменена.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыгрузкуФайловИзвещения()
	
		ПараметрыЗапуска = Новый Структура("ТекстСообщения", "Формирование файлов выгрузки");
		ПараметрыВыполнения = Новый Структура;
		ПараметрыВыполнения.Вставить("Режим", "ПоДокументам");
		ПараметрыВыполнения.Вставить("Период", ПериодВыгрузки);
		ПараметрыВыполнения.Вставить("НачальныйНомер", 1);
		ПараметрыВыполнения.Вставить("ФорматВыгрузки", Объект.ФорматОбмена);
		ПараметрыВыполнения.Вставить("ВыгрузитьВZipАхив", Не ВыгрузитьВКаталог);
		ПараметрыВыполнения.Вставить("ПапкаДляСохраненияАрхива", ПутьКФайлуАрхива);
	 	ЗапуститьФоновоеЗадание(ПараметрыЗапуска, ПараметрыВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПометкуВыделенныхДокументов(МассивВыделенныхСтрок, КоличестовУстОтметок)

	ТаблицаДокументовУчета = ТаблицаНайденныеДокументыУчета;
	
	КонтрольУстОтметок = КоличестовУстОтметок;
	НеУдалосьУстОтметок = 0;
	ЭтоПоследнийЭлемент = Ложь;

	Для Каждого Строка Из МассивВыделенныхСтрок Цикл
		
		Если Строка = МассивВыделенныхСтрок[МассивВыделенныхСтрок.Количество() - 1] И МассивВыделенныхСтрок.Количество() > 1 Тогда
			ИндексСтроки = МассивВыделенныхСтрок[МассивВыделенныхСтрок.Количество() - 2];
			ЭтоПоследнийЭлемент = Истина;   
		Иначе
			ИндексСтроки = ?(Строка = 0 ИЛИ МассивВыделенныхСтрок.Количество() = 1, Строка, Строка - 1);	
		КонецЕсли;
		
		ДанныеСтроки = Элементы.ТаблицаНайденныеДокументыУчета.ДанныеСтроки(ИндексСтроки);
		
		Если КонтрольУстОтметок < 99 И НЕ ДанныеСтроки.Пометка Тогда 
			ДанныеСтроки.Пометка = Истина; 
			КонтрольУстОтметок = КонтрольУстОтметок + 1; 
		ИначеЕсли НЕ ДанныеСтроки.Пометка Тогда
			НеУдалосьУстОтметок = НеУдалосьУстОтметок + 1;
		КонецЕсли;

	КонецЦикла;
	
	ВсегоОтмеченоДокументов = КонтрольУстОтметок + НеУдалосьУстОтметок;
	
	Если ВсегоОтмеченоДокументов > 99 Тогда
		ТекстОшибки = "Нельзя выбрать для сохранения в файлы более 99 документов учета из-за ограничений формата выгрузки.";
		ПоказатьПредупреждение(,ТекстОшибки);	
	КонецЕсли;
	
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);

КонецПроцедуры	
	
&НаКлиенте
Процедура ОбновитьОтображениеВыбранныхДокументов(Форма)
	
	ШаблонЗаголовка = НСтр("ru = 'Выбрано: %1'"); 
	
	ВыгружаемыеДокументы = ТаблицаНайденныеДокументыУчета.НайтиСтроки(Новый Структура("Пометка", Истина));
	Форма.Элементы.ДекорацияВыгружаемыеДокументы.Заголовок = СтрШаблон(ШаблонЗаголовка, ВыгружаемыеДокументы.Количество());
		
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьФормы(Форма)
	
	Объект 	 = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ВыгрузитьДокументыУчетаВАрхивВебКлиент", "Видимость", Форма.ЭтоВебКлиент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаКомандВыгрузкиФормы", "Видимость", Не Форма.ЭтоВебКлиент); 
		
КонецПроцедуры	

&НаСервере
Процедура ЗаписьСобытияВЖурналРегистрации(ТекстСообщения)
	
	ЗаписьЖурналаРегистрации("ДополнительныеОтчетыОбработки.БГУ_ВыгрузкаЗагрузкаИзвещений", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения, РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкиИзвещений(Значение)
	
	ТаблицаДокументовУчета = ТаблицаНайденныеДокументыУчета;
	
	НомерВыделенногоДокумента = 0;
	
	Для Каждого СтрокаТЗ Из ТаблицаДокументовУчета Цикл
		Если Значение И НомерВыделенногоДокумента < 99 Тогда 
			СтрокаТЗ.Пометка = Значение;
			НомерВыделенногоДокумента = НомерВыделенногоДокумента + 1;
		Иначе
			СтрокаТЗ.Пометка = Ложь;	
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаДокументовУчета.Количество() > 99 И Значение Тогда
		ТекстОшибки = "Нельзя выбрать для сохранения в файлы более 99 документов учета из-за ограничений формата выгрузки.";
		ПоказатьПредупреждение(, ТекстОшибки);	
	КонецЕсли;
	
	ОбновитьОтображениеВыбранныхДокументов(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура НайтиИзвещенияНаСервере()
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не заполнено обязательное поле ""Организация""'"),, "Организация");
		Возврат;
	КонецЕсли;
	
	РеквизитВидИзвещения = Новый Массив;
	РеквизитВидИзвещения.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаНФАСоСклада);
	РеквизитВидИзвещения.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика);
	РеквизитВидИзвещения.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаТребований);
	РеквизитВидИзвещения.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаОбязательств);
	
	СостояниеПодписанВГИИСЭБ = 2;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
		|	ИзвещениеИсходящее.Ссылка КАК ДокументУчета,
		|	1 КАК Номер,
		|	ЕСТЬNULL(СтатусыДокументовПриОбменеСГИИСЭБ.СтатусОбмена, 0) КАК СтатусОбмена
		|ПОМЕСТИТЬ ВыгружаемыеДокументыУчета
		|ИЗ
		|	Документ.ИзвещениеИсходящее КАК ИзвещениеИсходящее
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументовПриОбменеСГИИСЭБ.СрезПоследних КАК СтатусыДокументовПриОбменеСГИИСЭБ
		|		ПО ИзвещениеИсходящее.Ссылка = СтатусыДокументовПриОбменеСГИИСЭБ.ДокументУчета
		|ГДЕ
		|	ИзвещениеИсходящее.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И НЕ ИзвещениеИсходящее.ПометкаУдаления
		|	И ИзвещениеИсходящее.ВидИзвещения В(&ВидИзвещения)
		|	И ИзвещениеИсходящее.Проведен = ИСТИНА
		|	И ИзвещениеИсходящее.Организация = &Организация
		|	И (НЕ СтатусыДокументовПриОбменеСГИИСЭБ.СтатусОбмена = &ПодписанВГИИСЭБ
		|			ИЛИ СтатусыДокументовПриОбменеСГИИСЭБ.СтатусОбмена ЕСТЬ NULL)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ВыгружаемыеДокументыУчета.НомерСтроки > 99
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Пометка,
		|	ВыгружаемыеДокументыУчета.ДокументУчета КАК ДокументУчета,
		|	ВыгружаемыеДокументыУчета.НомерСтроки КАК Номер,
		|	ВЫРАЗИТЬ(ВыгружаемыеДокументыУчета.ДокументУчета КАК Документ.ИзвещениеИсходящее).Номер КАК НомерДокументаУчета,
		|	ВЫРАЗИТЬ(ВыгружаемыеДокументыУчета.ДокументУчета КАК Документ.ИзвещениеИсходящее).Дата КАК ДатаДокументаУчета,
		|	ВЫРАЗИТЬ(ВыгружаемыеДокументыУчета.ДокументУчета КАК Документ.ИзвещениеИсходящее).Договор КАК Договор,
		|	ВЫРАЗИТЬ(ВыгружаемыеДокументыУчета.ДокументУчета КАК Документ.ИзвещениеИсходящее).Ответственный КАК Ответственный,
		|	ВЫРАЗИТЬ(ВыгружаемыеДокументыУчета.ДокументУчета КАК Документ.ИзвещениеИсходящее).Получатель КАК Контрагент
		|ИЗ
		|	ВыгружаемыеДокументыУчета КАК ВыгружаемыеДокументыУчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВыгружаемыеДокументыУчета.НомерСтроки";	
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", ПериодВыгрузки.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ПериодВыгрузки.ДатаОкончания));
	Запрос.УстановитьПараметр("ВидИзвещения", РеквизитВидИзвещения);
	Запрос.УстановитьПараметр("ПодписанВГИИСЭБ", СостояниеПодписанВГИИСЭБ);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() > 99 Тогда
		ТекстПредупреждения = СтрШаблон("Выбрано 99 из %1 документов учета.", РезультатЗапроса.Количество());
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПредупреждения);	
	КонецЕсли;
	
	ТаблицаНайденныеДокументыУчета.Загрузить(РезультатЗапроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьФоновоеЗадание(ПараметрыЗапуска, ПараметрыВыполнения, ДополнительныеПараметры = Неопределено)

	АдресМассиваОшибок 		= ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);		
	АдресХранилища 			= ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
    АдресХранилищаАрхиваZip = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыВыполнения.Вставить("Описание", "Начало подготовки данных обработки");
	ПараметрыВыполнения.Вставить("ТекстСообщения", ПараметрыЗапуска.ТекстСообщения);
	ПараметрыВыполнения.Вставить("АдресХранилища", АдресХранилища);
	ПараметрыВыполнения.Вставить("АдресМассиваОшибок", АдресМассиваОшибок);
	ПараметрыВыполнения.Вставить("АдресХранилищаАрхиваZip", АдресХранилищаАрхиваZip);
	ПараметрыВыполнения.Вставить("ЭтоВебКлиент", ЭтоВебКлиент);
	Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаданиеНаОбработкуВыполнено", ЭтотОбъект, ПараметрыВыполнения);
		ДлительнаяОперация = ВыполнитьФоновоеЗаданиеНаСервере(ПараметрыВыполнения, ПараметрыЗапуска.ТекстСообщения, ИмяФормы, ОбъектСсылка, УникальныйИдентификатор);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
		ПараметрыОжидания.Интервал = 1;
		ПараметрыОжидания.ТекстСообщения = ПараметрыЗапуска.ТекстСообщения;
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
		
	Иначе
		ЗаписьСобытияВЖурналРегистрации("Запуск в синхронном режиме");
		ЗапуститьОбработкуВСинхронномРежиме(ПараметрыЗапуска, ПараметрыВыполнения, ДополнительныеПараметры);
		
	КонецЕсли;
	
	ОповеститьОбИзмененииСтатусаОбменаСГИИСЭБ();
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьФоновоеЗаданиеНаСервере( Знач ПараметрыВыполнения, НаименованиеЗадания, ИмяФормы, ОбработкаСсылка, УникальныйИдентификатор)
	
	ДополнитьПараметрыВыполненияНаСервере(ПараметрыВыполнения, "ВыгрузитьДокументыУчета");
	
	ПараметрыЗадания = Новый Структура;

	ПараметрыЗадания.Вставить("ИмяОбработки", СтрРазделить(ИмяФормы, ".")[1]);
	ПараметрыЗадания.Вставить("ИмяМетода", "ВыгрузитьДокументыУчета");
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Истина);
	ПараметрыЗадания.Вставить("ОбработкаСсылка", ОбработкаСсылка);
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	РезультатФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне("ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки", ПараметрыЗадания, ПараметрыВыполнения);
	Возврат РезультатФоновогоЗадания;
	
КонецФункции

&НаКлиенте
Процедура ЗаданиеНаОбработкуВыполнено(Результат, ДополнительныеПараметры) Экспорт
		
	ОчиститьСообщения();
	
	Если Результат = Неопределено Тогда
		Возврат;
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
				
		Если ВыгрузитьВКаталог Тогда 
			ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботы1СПредприятия(Новый ОписаниеОповещения("НачатьПроверкуСуществованияКаталогаПослеПодключенияРасширенияРаботыСФайлами", ЭтотОбъект));
		Иначе
			
			#Если НЕ ВебКлиент Тогда
			
				ВременныйФайлАрхива = ПолучитьИзВременногоХранилища(АдресХранилищаАрхиваZip);
				ИмяФайла  = ВременныйФайлАрхива.ИмяАрхива;
			
				ДиалогСохраненияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
				ДиалогСохраненияФайла.МножественныйВыбор = Ложь;
				ДиалогСохраненияФайла.Фильтр 		 = "(*.zip)|*.zip";
				ДиалогСохраненияФайла.Расширение 	 = ".zip";
				ДиалогСохраненияФайла.ПолноеИмяФайла = ИмяФайла;
				
				Если ДиалогСохраненияФайла.Выбрать() Тогда
					ПутьКФайлуАрхива = ДиалогСохраненияФайла.ПолноеИмяФайла;
					ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботы1СПредприятия(
						Новый ОписаниеОповещения("НачатьПроверкуСуществованияАрхиваПослеПодключенияРасширенияРаботыСФайлами", ЭтотОбъект));
				Иначе
					Возврат;
				КонецЕсли;
		
			#Иначе	
				СтруктураВременногоФайла = ПоместитьФайлВыгрузкиВоВременноеХранилищеНаСервере();
				НачатьПолучениеФайлаССервера(СтруктураВременногоФайла.Адрес, СтруктураВременногоФайла.ИмяФайла);
			#КонецЕсли
			
		КонецЕсли;
		
		Если ЭтоАдресВременногоХранилища(АдресМассиваОшибок) Тогда
			СтруктураВозврат = ПолучитьИзВременногоХранилища(АдресМассиваОшибок);
			Если ТипЗнч(СтруктураВозврат) = Тип("Структура") И СтруктураВозврат.КоличествоОшибок Тогда
				ЗаписьСобытияВЖурналРегистрации("Вывод протокола");
				
				ПротоколФормирования = СтруктураВозврат.ПротоколОшибок;
		        ПротоколФормирования.ТолькоПросмотр = Истина;
				ПротоколФормирования.Защита = Истина;
	            ПараметрыПечати = УправлениеПечатьюКлиент.ПараметрыПечати();
	            ПараметрыПечати.ВладелецФормы = ЭтаФорма;
	            ПараметрыПечати.ЗаголовокФормы = "Протокол";
	            КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("Отчет");    
	            КоллекцияПечатныхФорм[0].ТабличныйДокумент = ПротоколФормирования;
	            КоллекцияПечатныхФорм[0].Экземпляров = 1;
	            КоллекцияПечатныхФорм[0].СинонимМакета = "Протокол ошибок";    
	            УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм,Неопределено,ПараметрыПечати);

			КонецЕсли;
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаДвижений_Синхронно(ПараметрыЗапуска, Знач ПараметрыВыполнения, ДополнительныеПараметры)
	
	ДополнитьПараметрыВыполненияНаСервере(ПараметрыВыполнения, "ВыгрузитьДокументыУчета");
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	МассивПараметров = Новый Массив();
	МассивПараметров.Добавить(ПараметрыВыполнения);
	МассивПараметров.Добавить(АдресВоВременномХранилище);
	ОбщегоНазначения.ВыполнитьМетодОбъекта(ОбработкаОбъект, "ВыгрузитьДокументыУчета", МассивПараметров);

КонецПроцедуры

&НаКлиенте
Процедура ОповеститьОбИзмененииСтатусаОбменаСГИИСЭБ()
	
	ВыгружаемыеДокументы = ТаблицаНайденныеДокументыУчета.НайтиСтроки(Новый Структура("Пометка", Истина));
	Для Каждого ТекДокумент Из ВыгружаемыеДокументы Цикл
		ОповеститьОбИзменении(ТекДокумент.ДокументУчета);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОбработкуВСинхронномРежиме(ПараметрыЗапуска, Знач ПараметрыВыполнения, ДополнительныеПараметры)
	
	ОбработкаДвижений_Синхронно(ПараметрыЗапуска, ПараметрыВыполнения, ДополнительныеПараметры);
	
	Если ВыгрузитьВКаталог Тогда
		ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботы1СПредприятия(Новый ОписаниеОповещения("НачатьПроверкуСуществованияКаталогаПослеПодключенияРасширенияРаботыСФайлами", ЭтотОбъект));
	Иначе
		
		#Если НЕ ВебКлиент Тогда
			
			ВременныйФайлАрхива = ПолучитьИзВременногоХранилища(АдресХранилищаАрхиваZip);
			ИмяФайла  = ВременныйФайлАрхива.ИмяАрхива;
		
			ДиалогСохраненияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
			ДиалогСохраненияФайла.МножественныйВыбор = Ложь;
			ДиалогСохраненияФайла.Фильтр 		 = "(*.zip)|*.zip";
			ДиалогСохраненияФайла.Расширение 	 = ".zip";
			ДиалогСохраненияФайла.ПолноеИмяФайла = ИмяФайла;
			
			Если ДиалогСохраненияФайла.Выбрать() Тогда
				ПутьКФайлуАрхива = ДиалогСохраненияФайла.ПолноеИмяФайла;
				ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботы1СПредприятия(
					Новый ОписаниеОповещения("НачатьПроверкуСуществованияАрхиваПослеПодключенияРасширенияРаботыСФайлами", ЭтотОбъект));
			Иначе
				Возврат;
			КонецЕсли;
		
		#Иначе	
			СтруктураВременногоФайла = ПоместитьФайлВыгрузкиВоВременноеХранилищеНаСервере();
			НачатьПолучениеФайлаССервера(СтруктураВременногоФайла.Адрес, СтруктураВременногоФайла.ИмяФайла);
		#КонецЕсли
			
	КонецЕсли;
	
	Если ЭтоАдресВременногоХранилища(АдресМассиваОшибок) Тогда
		СтруктураВозврат = ПолучитьИзВременногоХранилища(АдресМассиваОшибок);
		Если ТипЗнч(СтруктураВозврат) = Тип("Структура") И СтруктураВозврат.КоличествоОшибок Тогда
			ЗаписьСобытияВЖурналРегистрации("Вывод протокола");
			
			ПротоколФормирования = СтруктураВозврат.ПротоколОшибок;
	        ПротоколФормирования.ТолькоПросмотр = Истина;
			ПротоколФормирования.Защита = Истина;
            ПараметрыПечати = УправлениеПечатьюКлиент.ПараметрыПечати();
            ПараметрыПечати.ВладелецФормы = ЭтаФорма;
            ПараметрыПечати.ЗаголовокФормы = "Протокол";
            КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("Отчет");    
            КоллекцияПечатныхФорм[0].ТабличныйДокумент = ПротоколФормирования;
            КоллекцияПечатныхФорм[0].Экземпляров = 1;
            КоллекцияПечатныхФорм[0].СинонимМакета = "Протокол ошибок";    
            УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм,Неопределено,ПараметрыПечати);

		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьФайлВыгрузкиВоВременноеХранилищеНаСервере(УникальныйИДФормы = Неопределено)
		
	СтруктураАрхива = ПолучитьИзВременногоХранилища(АдресХранилищаАрхиваZip);
	
	АдресАрхива  = СтруктураАрхива.ИмяВременнногоФайла;
	ДанныеАрхива = СтруктураАрхива.ДанныеАрхива;
	ИмяФайла  	 = СтруктураАрхива.ИмяАрхива;
	
	Адрес = ПоместитьВоВременноеХранилище(ДанныеАрхива, ?(ЗначениеЗаполнено(УникальныйИДФормы) = Истина, УникальныйИДФормы, Новый УникальныйИдентификатор()));
	
	УдалитьФайлы(АдресАрхива); 
	
	СтруктураВременногоФайла = Новый Структура;
	СтруктураВременногоФайла.Вставить("ИмяФайла", ИмяФайла);
	СтруктураВременногоФайла.Вставить("Адрес", Адрес);
	
	Возврат СтруктураВременногоФайла;
	
КонецФункции

&НаСервере
Процедура ДополнитьПараметрыВыполненияНаСервере(ПараметрыВыполнения, ИмяПроцедуры)

	Если ИмяПроцедуры = "ВыгрузитьДокументыУчета" И ПараметрыВыполнения.Режим = "ПоДокументам" Тогда
			
		МассивДокументов = ТаблицаНайденныеДокументыУчета.Выгрузить(Новый Структура("Пометка", Истина)).ВыгрузитьКолонку("ДокументУчета");
		ПараметрыВыполнения.Вставить("МассивДокументов", МассивДокументов);
			
		ПараметрыВыполнения.Вставить("МассивОтражаемыхДокументов", МассивДокументов);
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция КоличествоОшибокВВыгружаемыхДокументах()
	
	МассивДокументов = ТаблицаНайденныеДокументыУчета.Выгрузить(Новый Структура("Пометка", Истина)).ВыгрузитьКолонку("ДокументУчета");
	КоличествоОшибок = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИзвещениеИсходящее.Ссылка КАК ДокументУчета,
	               |	ЕСТЬNULL(Договоры.ДатаДоговора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДоговора,
	               |	ЕСТЬNULL(Договоры.НомерДоговора, """") КАК НомерДоговора,
	               |	ИзвещениеИсходящее.Договор КАК Договор,
	               |	ИзвещениеИсходящее.ВидИзвещения КАК ВидИзвещения
	               |ИЗ
	               |	Документ.ИзвещениеИсходящее КАК ИзвещениеИсходящее
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
	               |		ПО ИзвещениеИсходящее.Договор = Договоры.Ссылка
	               |ГДЕ
	               |	ИзвещениеИсходящее.Ссылка В(&Ссылка)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДокументУчета"; 
	
	Запрос.УстановитьПараметр("Ссылка", МассивДокументов);
	Проверка = Запрос.Выполнить().Выгрузить();
	
	МассивДляВыгрузки = Новый Массив;
	
	Для Каждого Стр Из Проверка Цикл
		
		Если Стр.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаОбязательств Тогда   
			МассивДляВыгрузки.Добавить(Стр.ДокументУчета);
		Иначе
			Если Не ЗначениеЗаполнено(Стр.Договор) Тогда  
				КоличествоОшибок = КоличествоОшибок + 1;
				ТекстОшибки = СтрШаблон("В выгружаемом документе учета ""%1"" не указан договор.", Стр.ДокументУчета); 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Продолжить;	
			Иначе
				МассивОшибокДоговора = Новый Массив;
				Если Стр.ДатаДоговора = Дата(1, 1, 1) Тогда
					МассивОшибокДоговора.Добавить("дата договора");
				КонецЕсли;
				Если Не ЗначениеЗаполнено(Стр.НомерДоговора) Тогда
					МассивОшибокДоговора.Добавить("номер договора");
				КонецЕсли;
				
				Если МассивОшибокДоговора.Количество() Тогда
					КоличествоОшибок = КоличествоОшибок + 1;
					ТекстОшибки = СтрШаблон("В выгружаемом документе учета ""%1"" в договоре ""%2"" не указаны обязательные реквизиты: " 
												+ СтрСоединить(МассивОшибокДоговора, ", ") + ".", Стр.ДокументУчета, Стр.Договор); 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
					Продолжить;
				КонецЕсли; 
			КонецЕсли;  
		КонецЕсли;	
	КонецЦикла;
	
	Возврат КоличествоОшибок;
		
КонецФункции 

&НаКлиенте
Процедура НачатьПроверкуСуществованияАрхиваПослеПодключенияРасширенияРаботыСФайлами(РасширениеПодключено, ДополнительныеПараметры) Экспорт
	
	Если Не РасширениеПодключено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Чтобы продолжить, необходимо установить расширение работы с файлами 1С:Предприятие." + Символы.ПС
			+ "Для установки расширения, повторите операцию, или воспользуйтесь формой Мои настройки в разделе Администрирование формы Быстрый доступ к формулярам и справочникам, нажав на гипперсылку Установить расширение работы с файлами.");
		Возврат;
	КонецЕсли;
	
	СтруктураРезультат = ПолучитьИзВременногоХранилища(АдресХранилищаАрхиваZip);
	
	ДвоичныеДанныеФайла = СтруктураРезультат.ДанныеАрхива; 		
	ДвоичныеДанныеФайла.НачатьЗапись(Новый ОписаниеОповещения(), ПутьКФайлуАрхива);
		
КонецПроцедуры

&НаКлиенте
Процедура НачатьПроверкуСуществованияКаталогаПослеПодключенияРасширенияРаботыСФайлами(РасширениеПодключено, ДополнительныеПараметры) Экспорт
	
	Если Не РасширениеПодключено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Чтобы продолжить, необходимо установить расширение работы с файлами 1С:Предприятие." + Символы.ПС
			+ "Для установки расширения, повторите операцию, или воспользуйтесь формой Мои настройки в разделе Администрирование формы Быстрый доступ к формулярам и справочникам, нажав на гипперсылку Установить расширение работы с файлами.");
		Возврат;
	КонецЕсли;
	
	СтруктураРезультат = ПолучитьИзВременногоХранилища(АдресХранилища);
		
	Для Каждого Файл Из СтруктураРезультат.МассивВыгруженныхФайлов Цикл
		
		ДвоичныеДанныеФайла = Файл.ДвоичныеДанные; 		
		ПутьКФайлу = Объект.КаталогДляВыгрузки + ПолучитьРазделительПути() + Файл.ИмяФайла;
		ДвоичныеДанныеФайла.НачатьЗапись(Новый ОписаниеОповещения(), ПутьКФайлу);
			
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
