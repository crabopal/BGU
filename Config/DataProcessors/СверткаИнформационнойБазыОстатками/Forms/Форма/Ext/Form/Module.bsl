
#Область Переменные

&НаКлиенте
Перем ПараметрыОбработчикаОжидания, ЗакрытьФорму;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	//Проверка прав - на всякий случай
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Недостаточно прав для выполнения операции'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Картинки = Новый Структура;
	Картинки.Вставить("Картинка1", Новый Картинка);
	Картинки.Вставить("Картинка2", БиблиотекаКартинок.ДлительнаяОперация48БСП);
	Картинки.Вставить("Картинка3", БиблиотекаКартинок.ЗеленаяГалка);
	Картинки.Вставить("Картинка4", БиблиотекаКартинок.Ошибка32);
	
	ПрочитатьПараметрыСвертки();
	
	ГодСвертки = Год(ДатаСверткиИБ) + 1;
	ИмяСобытияЖурналаРегистрации = Обработки.СверткаИнформационнойБазыОстатками.ИмяСобытияЖурналаРегистрации();
	
	Элементы.ГруппаСинхронизацияДанных.Видимость = ПолучитьФункциональнуюОпцию("ИспользоватьСинхронизациюДанных");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗакрытьФорму = Ложь;
	
	УстановитьПредставлениеКнопкиНастройки();
	
	Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		СведенияЗадания = СведенияЗапущеногоЗадания(ИдентификаторЗадания);
		СведенияЗадания.Вставить("ИдентификаторЗадания", ИдентификаторЗадания);
		ОтобразитьВыполнениеДлительнойОперации(СведенияЗадания);
	КонецЕсли;
	
	ОтобразитьСтраницуСвертки();
	
	ВидимостьЭлементовПоРеорганизации();
	
	УстановитьПредставлениеКнопкиСчетКорреспондент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
		
		Если НомерЭтапа = 1 Тогда
			Отказ = Истина;
			ТекстПредупреждения = НСтр("ru = 'Во избежании потери настроек свертки перед закрытием программы закройте помощник свертки.'");
		КонецЕсли;
		
	ИначеЕсли Не ЗакрытьФорму Тогда
		
		Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
			Если НомерСтраницы = 1 Тогда
				СохранитьПараметрыСвертки("Настройки");
			КонецЕсли;
		Иначе
			Отказ = Истина;
			ТекстВопроса = НСтр("ru = 'Свертка информационной базы продолжится в фоновом режиме.
				|Закрыть помощник?'");
			Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДекорацияРезервнаяКопияНажатие(Элемент)
	
	ОткрытьФорму("Обработка.РезервноеКопированиеИБ.Форма");
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиСинхронизацииДанных(Команда)
	
	ОбменДаннымиКлиент.ОткрытьНастройкиСинхронизацииДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ГодСверткиПриИзменении(Элемент)
	
	ДатаСверткиИБ = Дата(Формат(Макс(ГодСвертки-1,0), "ЧН=0001; ЧГ=") + "1231");
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаСверткиИБПриИзменении(Элемент)
	
	ГодСвертки = Год(ДатаСверткиИБ) + 1;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизвольнаяДатаПриИзменении(Элемент)
	
	ВидимостьЭлементовПоРеорганизации();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияСчетКорреспондентНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ВидимостьКПС"			, Истина);
	ПараметрыФормы.Вставить("ВидимостьКЭК"			, Истина);
	ПараметрыФормы.Вставить("ВидимостьКФО"			, Ложь);
	ПараметрыФормы.Вставить("ВидимостьКоличество"	, Ложь);
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО"		, Истина);
	ПараметрыФормы.Вставить("ОбязательностьКПС"		, Ложь);
	
	СписокСчетов = Новый Массив;
	СписокСчетов.Добавить("304.06");
	ПараметрыСчета = Новый Структура("ОграниченияСписокСчетов", СписокСчетов);
	ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
	
	ПараметрыКЭК = Новый Структура("ДопустимыеКЭК", "831,832,833,834,835,836,837,838");
	ПараметрыФормы.Вставить("ПараметрыКЭК", ПараметрыКЭК);
	
	Если ТипЗнч(СчетКорреспондент) = Тип("Структура") Тогда
		
		// Бухгалтерский учет
		ПараметрыФормы.Вставить("Счет"		, СчетКорреспондент.Счет);
		ПараметрыФормы.Вставить("КПС"		, СчетКорреспондент.КПС);
		ПараметрыФормы.Вставить("КЭК"		, СчетКорреспондент.КЭК);
		ПараметрыФормы.Вставить("Субконто1"	, СчетКорреспондент.Субконто1);
		ПараметрыФормы.Вставить("Субконто2"	, СчетКорреспондент.Субконто2);
		ПараметрыФормы.Вставить("Субконто3"	, СчетКорреспондент.Субконто3);
		
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Отражение остатков при реорганизации'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Счет корреспондент'"));
	
	Оповещение = Новый ОписаниеОповещения("СчетСчетКорреспондентВыбор", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма,,,, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетСчетКорреспондентВыбор(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		СчетКорреспондент = Результат;
		УстановитьПредставлениеКнопкиСчетКорреспондент();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТолькоВыбранныеОрганизацииПриИзменении(Элемент)
	
	УстановитьПредставлениеКнопкиНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьСписокОрганизаций(Команда)
	
	ПараметрыФормы = Новый Структура("Организации", Настройки_Организации);
	Оповещение = Новый ОписаниеОповещения("НастроитьСписокОрганизацийВыбор", ЭтотОбъект);
	ОткрытьФорму("Обработка.СверткаИнформационнойБазыОстатками.Форма.ФормаОрганизации", ПараметрыФормы, ЭтаФорма,,,, Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьСписокОрганизацийВыбор(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("СписокЗначений") Тогда
		Настройки_Организации = ОбщегоНазначенияКлиентСервер.СкопироватьСписокЗначений(Результат);
		УстановитьПредставлениеКнопкиНастройки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияДокументыВводаОстатковНажатие(Элемент)
	
	ОткрытьФорму("Обработка.ПомощникВводаНачальныхОстатков.Форма");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЖурналРегистрацииЭтапыСвертки(Элемент)
	
	ПараметрыФормы = Новый Структура("СобытиеЖурналаРегистрации", ИмяСобытияЖурналаРегистрации);
	ОткрытьФорму("Обработка.ЖурналРегистрации.Форма", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЖурналРегистрацииОшибки(Элемент)
	
	ПараметрыФормы = Новый Структура("СобытиеЖурналаРегистрации", ИмяСобытияЖурналаРегистрации);
	ПараметрыФормы.Вставить("Уровень", "Ошибка");
	ОткрытьФорму("Обработка.ЖурналРегистрации.Форма", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияУдалениеПомеченныхОбъектовНажатие(Элемент)
	
	ОткрытьФорму("Обработка.УдалениеПомеченныхОбъектов.Форма");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаНазад(Команда)
	
	Если НомерСтраницы = 0 Тогда
		Закрыть();
		ПараметрыФормы = Новый Структура("ОбработкаСвертки", 0);
		ОткрытьФорму("Обработка.СверткаИнформационнойБазыОстатками.Форма.Старт", ПараметрыФормы);
		Возврат;
	КонецЕсли;
	
	НомерСтраницы = НомерСтраницы - 1;
	
	СохранитьПараметрыСвертки("НомерСтраницы");
	
	ОтобразитьСтраницуСвертки();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДалее(Команда)
	
	ОчиститьСообщения();
	
	Если НомерСтраницы = 1 Тогда
		СохранитьПараметрыСвертки("Настройки");
		НомерСтраницы = НомерСтраницы + 1;
		СохранитьПараметрыСвертки("НомерСтраницы");
	ИначеЕсли НомерСтраницы = 3 Тогда
		СохранитьПараметрыСвертки("Очистить");
		ЗакрытьФорму = Истина;
		Закрыть();
		Возврат;
	КонецЕсли;
	
	Если НомерСтраницы = 2 Тогда
		Если НомерЭтапа >= 3 И НомерЭтапаВыполнен >= НомерЭтапа Тогда
			НомерСтраницы = НомерСтраницы + 1;
			СохранитьПараметрыСвертки("НомерСтраницы");
		Иначе
			Если НомерЭтапа = НомерЭтапаВыполнен Тогда
				НомерЭтапа = НомерЭтапа + 1;
			КонецЕсли;
			ВыполнитьДлительнуюОперацию();
		КонецЕсли;
	Иначе
		НомерСтраницы = НомерСтраницы + 1;
		СохранитьПараметрыСвертки("НомерСтраницы");
	КонецЕсли;
	
	ОтобразитьСтраницуСвертки();
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяОперацияПрервать(Команда)
	
	Если Команда.Имя = "ПрерватьЭтап1" Тогда
		ТекстВопроса = НСтр("ru = 'Не рекомендуется прерывать этап 1.
                             |При повторном запуске этапа ранее созданные документы будут удалены,
                             |формирование документов ввода остатков начнется сначала.
                             |Прервать этап свертки?'");
	Иначе
		ТекстВопроса = НСтр("ru = 'Прервать этап свертки?'");
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПрерватьОперациюПослеОтветаНаВопрос", ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОтобразитьСтраницуСвертки()
	
	Если НомерСтраницы = 0 Тогда
		
		Элементы.ПанельНавигации1.Видимость	= Истина;
		Элементы.КомандаДалее.Заголовок		= "Далее >";
		Элементы.КомандаЗакрыть.Видимость	= Истина;
		Элементы.Страницы.ТекущаяСтраница	= Элементы.СтраницаПодготовка;
		
	ИначеЕсли НомерСтраницы = 1 Тогда
		
		Элементы.ПанельНавигации1.Видимость	= Истина;
		Элементы.КомандаДалее.Заголовок		= "Далее >";
		Элементы.КомандаЗакрыть.Видимость	= Истина;
		Элементы.Страницы.ТекущаяСтраница	= Элементы.СтраницаНастройка;
		
	ИначеЕсли НомерСтраницы = 2 Тогда
		
		Элементы.ПанельНавигации1.Видимость	= Ложь;
		Элементы.КомандаДалее.Заголовок		= "Далее >";
		Элементы.КомандаЗакрыть.Видимость	= Истина;
		Элементы.Страницы.ТекущаяСтраница	= Элементы.СтраницаСвертка;
		
		ОтобразитьЭтапыСвертки();
		
	ИначеЕсли НомерСтраницы = 3 Тогда
		
		Элементы.ПанельНавигации1.Видимость	= Ложь;
		Элементы.КомандаДалее.Заголовок		= "Готово";
		Элементы.КомандаЗакрыть.Видимость	= Ложь;
		Элементы.Страницы.ТекущаяСтраница	= Элементы.СтраницаЗавершение;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьЭтапыСвертки()
	
	ОшибкаНаЭтапе = (НомерЭтапаВыполнен < НомерЭтапа);
	
	Для Сч = 1 По 3 Цикл
		Если Сч < НомерЭтапа Тогда
			НомерКартинки = 3; // Зеленая галка
		ИначеЕсли Сч = НомерЭтапа Тогда
			Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
				НомерКартинки = 2; // Колесико
			ИначеЕсли ОшибкаНаЭтапе Тогда
				НомерКартинки = 4; // Ошибка
			Иначе
				НомерКартинки = 3; // Зеленая галка
			КонецЕсли;
		Иначе
			НомерКартинки = 1; // Пустая картинка
		КонецЕсли;
		ВключитьКартинкуЭтапа(Сч, НомерКартинки);
	КонецЦикла;
	
	Элементы.СтраницыПереключаемые.ТекущаяСтраница =
		?(ЗначениеЗаполнено(ИдентификаторЗадания) Или Не ОшибкаНаЭтапе,
		Элементы.СтраницаПроцессВыполняется,
		Элементы.СтраницаВозниклиОшибки);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьПараметрыСвертки()
	
	//Номера страниц:
	//	0: Подготовка
	//	1: Настройка
	//	2: Свертка
	//	3: Завершение
	
	ДатаСверткиИБ							= НачалоГода(ТекущаяДата()) - 1;
	УстановитьДатуЗапретаИзмененияДанных	= Истина;
	ТолькоВыбранныеОрганизации				= Ложь;
	Организации								= Новый Массив;
	ПроизвольнаяДата						= Ложь;
	РежимСвертки							= 0;
	НомерСтраницы							= 0;
	НомерЭтапа								= 0;
	НомерЭтапаВыполнен						= 0;
	СчетКорреспондент						= Неопределено;
	
	ПараметрыСвертки = Обработки.СверткаИнформационнойБазыОстатками.ПрочитатьПараметрыСвертки();
	
	Если ТипЗнч(ПараметрыСвертки) = Тип("Структура") Тогда
		
		ПараметрыСвертки.Свойство("ДатаСверткиИБ"							, ДатаСверткиИБ);
		ПараметрыСвертки.Свойство("ПроизвольнаяДата"						, ПроизвольнаяДата);
		ПараметрыСвертки.Свойство("УстановитьДатуЗапретаИзмененияДанных"	, УстановитьДатуЗапретаИзмененияДанных);
		ПараметрыСвертки.Свойство("ТолькоВыбранныеОрганизации"				, ТолькоВыбранныеОрганизации);
		ПараметрыСвертки.Свойство("Организации"								, Организации);
		ПараметрыСвертки.Свойство("РежимСвертки"							, РежимСвертки);
		ПараметрыСвертки.Свойство("НомерСтраницы"							, НомерСтраницы);
		ПараметрыСвертки.Свойство("НомерЭтапа"								, НомерЭтапа);
		ПараметрыСвертки.Свойство("НомерЭтапаВыполнен"						, НомерЭтапаВыполнен);
		ПараметрыСвертки.Свойство("СчетКорреспондент"						, СчетКорреспондент);
		
		Если Организации = Неопределено Тогда
			Организации = Новый Массив;
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьСписокОрганизаций(Организации);
	
	// Если свертка уже выполняется, то получим идентификатор задания
	
	Отбор = Новый Структура;
	Отбор.Вставить("Наименование", "Свертка информационной базы");
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	
	Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	Если Задания.Количество() > 0 Тогда
		ИдентификаторЗадания = Задания[0].УникальныйИдентификатор;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПараметрыСвертки(Режим)
	
	Если Режим = "Настройки" Тогда
		
		Организации = Новый Массив;
		Для Каждого ТекСтрока Из Настройки_Организации Цикл
			Если ТекСтрока.Пометка Тогда
				Организации.Добавить(ТекСтрока.Значение);
			КонецЕсли;
		КонецЦикла;
		
		пСчетКорреспондент = СчетКорреспондент;
		Если Не ТипЗнч(СчетКорреспондент) = Тип("Структура") Или Не ЗначениеЗаполнено(СчетКорреспондент.Счет) Тогда
			пСчетКорреспондент = Неопределено;
		КонецЕсли;
		
		ПараметрыСвертки = Новый Структура;
		ПараметрыСвертки.Вставить("ДатаСверткиИБ"							, ?(ПроизвольнаяДата, ДатаСверткиИБ, КонецГода(ДатаСверткиИБ)));
		ПараметрыСвертки.Вставить("ПроизвольнаяДата"						, ПроизвольнаяДата);
		ПараметрыСвертки.Вставить("УстановитьДатуЗапретаИзмененияДанных"	, УстановитьДатуЗапретаИзмененияДанных);
		ПараметрыСвертки.Вставить("ТолькоВыбранныеОрганизации"				, ТолькоВыбранныеОрганизации);
		ПараметрыСвертки.Вставить("Организации"								, Организации);
		ПараметрыСвертки.Вставить("РежимСвертки"							, РежимСвертки);
		ПараметрыСвертки.Вставить("СчетКорреспондент"						, пСчетКорреспондент);
		
	ИначеЕсли Режим = "НомерСтраницы" Тогда
		
		ПараметрыСвертки = Новый Структура;
		ПараметрыСвертки.Вставить("НомерСтраницы", НомерСтраницы);
		
	ИначеЕсли Режим = "Очистить" Тогда
		
		ПараметрыСвертки = Неопределено;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	СохранитьПараметрыСверткиСервер(ПараметрыСвертки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьПараметрыСверткиСервер(ПараметрыСвертки)
	
	Обработки.СверткаИнформационнойБазыОстатками.СохранитьПараметрыСвертки(ПараметрыСвертки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗакрытьФорму = Истина;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьКартинкуЭтапа(НомерЭтапа, НомерКартинки)
	
	Элементы["КартинкаЭтап"+НомерЭтапа].Картинка			= Картинки["Картинка"+НомерКартинки];
	Элементы["ПрерватьЭтап"+НомерЭтапа].Видимость			= (НомерКартинки = 2);
	Элементы["ПрерватьЭтапЗаглушка"+НомерЭтапа].Видимость	= (НомерКартинки <> 2);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокОрганизаций(Организации)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организации", Организации);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Все
	|ИЗ
	|	Справочник.Организации КАК Организации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Выбранные
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка В(&Организации)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Все.Ссылка КАК Значение,
	|	ВЫБОР
	|		КОГДА ВТ_Выбранные.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Пометка
	|ИЗ
	|	ВТ_Все КАК ВТ_Все
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Выбранные КАК ВТ_Выбранные
	|		ПО ВТ_Все.Ссылка = ВТ_Выбранные.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Все.Ссылка.Наименование";
	
	Настройки_Организации.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Настройки_Организации.Добавить(Выборка.Значение,, Выборка.Пометка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПредставлениеКнопкиНастройки()
	
	Если ТолькоВыбранныеОрганизации = 0 Тогда
		ТекстКнопки = НСтр("ru = 'Отметить'");
	Иначе
		ОргВсего = 0;
		ОргОтмечено = 0;
		Для Каждого ТекСтрока Из Настройки_Организации Цикл
			ОргВсего = ОргВсего + 1;
			Если ТекСтрока.Пометка Тогда 
				ОргОтмечено = ОргОтмечено + 1;
			КонецЕсли;
		КонецЦикла;		
		Шаблон = НСтр("ru = 'Отметить (%1 из %2)'");
		ТекстКнопки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ОргОтмечено, ОргВсего);
	КонецЕсли;
	
	Элементы.НастроитьСписокОрганизаций.Заголовок = ТекстКнопки;
	Элементы.НастроитьСписокОрганизаций.Доступность = (ТолькоВыбранныеОрганизации = 1);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьЭлементовПоРеорганизации()
	
	Элементы.ГодСвертки.Видимость = Не ПроизвольнаяДата;
	Элементы.ГруппаРеорганизация.Видимость = ПроизвольнаяДата;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПредставлениеКнопкиСчетКорреспондент()
	
	ТекстКнопки = "000";
	
	Если ТипЗнч(СчетКорреспондент) = Тип("Структура") Тогда
		Если ЗначениеЗаполнено(СчетКорреспондент.Счет) Тогда
			ТекстКнопки = ПредставлениеСчетаКредита(СчетКорреспондент.Счет);
		КонецЕсли;
	КонецЕсли;
	
	Шаблон = НСтр("ru = 'Счет корреспондент: %1'");
	Элементы.ДекорацияСчетКорреспондент.Заголовок = СтрШаблон(Шаблон, ТекстКнопки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеСчетаКредита(Счет)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "Код");
	
КонецФункции

#Область ДлительныеОперации

&НаКлиенте
Процедура ВыполнитьДлительнуюОперацию()
	
	СведенияЗадания = ВыполнитьДлительнуюОперациюСервер();
	
	ИдентификаторЗадания = СведенияЗадания.ИдентификаторЗадания;
	
	Если СведенияЗадания.Статус = "Выполнено" Тогда
		ВыполнитьПоЗавершениюДлительнойОперации(СведенияЗадания.Сообщения);
	Иначе
		ОтобразитьВыполнениеДлительнойОперации(СведенияЗадания);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьВыполнениеДлительнойОперации(СведенияЗадания)
	
	Элементы.СтраницыПереключаемые.ТекущаяСтраница = Элементы.СтраницаПроцессВыполняется;
	
	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	НастройкиОжидания.ВыводитьОкноОжидания = Ложь;
	НастройкиОжидания.ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ПрогрессВыполнения", ЭтотОбъект);
	НастройкиОжидания.ОтменятьПриЗакрытииФормыВладельца = Ложь;
	
	Обработчик = Новый ОписаниеОповещения("ПослеВыполненияСвертки", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(СведенияЗадания, Обработчик, НастройкиОжидания);
	
	ОтобразитьСостояниеДлительнойОперации(Истина);
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьДлительнуюОперациюСервер()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Свертка информационной базы";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	СведенияЗадания = ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.СверткаИнформационнойБазыОстатками.ВыполнитьОперацию",, ПараметрыВыполнения);
	
	Возврат СведенияЗадания;
	
КонецФункции

&НаКлиенте
Процедура ПрогрессВыполнения(Результат, ДополнительныеПараметры) Экспорт
	
	ПоказатьСообщенияФоновогоЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыполненияСвертки(Задание, ДополнительныеПараметры) Экспорт
	
	Если Задание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Задание.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось выполнить свертку'"));
		ИдентификаторЗадания = Неопределено;
		ОтобразитьСтраницуСвертки();
		ОтобразитьСостояниеДлительнойОперации(Ложь);
	ИначеЕсли Задание.Статус = "Выполнено" Тогда
		ВыполнитьПоЗавершениюДлительнойОперации(Задание.Сообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоЗавершениюДлительнойОперации(Сообщения = Неопределено)
	
	ПоказатьСообщенияФоновогоЗадания(Сообщения);
	
	ИдентификаторЗадания = Неопределено;
	
	Если НомерСтраницы = 2 И НомерЭтапа = 3 И НомерЭтапаВыполнен = НомерЭтапа Тогда
		НомерСтраницы = 3;
	КонецЕсли;
	
	ОтобразитьСтраницуСвертки();
	ОтобразитьСостояниеДлительнойОперации(Ложь);
	
	ОбменДаннымиКлиент.ОбновитьВсеОткрытыеДинамическиеСписки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьСостояниеДлительнойОперации(ВыполняетсяОперация)
	
	Элементы.КомандаДалее.Доступность = Не ВыполняетсяОперация;
	
	Элементы.Прогресс.Видимость = ВыполняетсяОперация;
	Если ВыполняетсяОперация Тогда
		Элементы.Прогресс.Заголовок = НСтр("ru = 'Подготовка...'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСообщенияФоновогоЗадания(Знач Сообщения = Неопределено)
	
	Если Сообщения = Неопределено Тогда
		Сообщения = ПолучитьСообщенияФоновогоЗадания(ИдентификаторЗадания);
	КонецЕсли;
	
	СообщениеПрогресса = Неопределено;
	
	Для Каждого Сообщение Из Сообщения Цикл
		Если Лев(Сообщение.Текст, 10) = "#Прогресс#" Тогда
			СообщениеПрогресса = Сообщение;
		ИначеЕсли Лев(Сообщение.Текст, 12) = "#НомерЭтапа#" Тогда
			НомерЭтапа = Число(Сред(Сообщение.Текст, 13));
			ОтобразитьЭтапыСвертки();
		ИначеЕсли Лев(Сообщение.Текст, 20) = "#НомерЭтапаВыполнен#" Тогда
			НомерЭтапаВыполнен = Число(Сред(Сообщение.Текст, 21));
			ОтобразитьЭтапыСвертки();
		Иначе
			Сообщение.ИдентификаторНазначения = УникальныйИдентификатор;
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЦикла;
	
	Если СообщениеПрогресса <> Неопределено Тогда
		Элементы.Прогресс.Заголовок = Сред(СообщениеПрогресса.Текст, 11);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СведенияЗапущеногоЗадания(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.ОперацияВыполнена(ИдентификаторЗадания);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСообщенияФоновогоЗадания(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.СообщенияПользователю(Истина, ИдентификаторЗадания);
	
КонецФункции

&НаКлиенте
Процедура ПрерватьОперациюПослеОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ОтключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания");
		ОтменитьВыполнениеЗаданияСервер(ИдентификаторЗадания, ИмяСобытияЖурналаРегистрации);
		ИдентификаторЗадания = Неопределено;
		ОтобразитьСтраницуСвертки();
		ОтобразитьСостояниеДлительнойОперации(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьВыполнениеЗаданияСервер(ИдентификаторЗадания, ИмяСобытияЖурналаРегистрации)
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	
	Комментарий = НСтр("ru = 'Этап свертки прерван пользователем'");
	ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации,
		УровеньЖурналаРегистрации.Ошибка,,, Комментарий);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
