		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(Настройка.Регистры[1]);
		НоваяНастройка.Регистры = Настройка.Регистры.Скопировать(МассивСтрок);
		Настройка.Регистры.Удалить(1);
	КонецЦикла;
	
	// Добавим в комментарий название регистра, по которому создается документ
	Для Сч = КоличествоНастроекДо По ТаблицаНастроек.Количество() - 1 Цикл
		ТаблицаНастроек[Сч].Комментарий = "[" + ТаблицаНастроек[Сч].Регистры[0].ИмяОбъекта + "]";
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Процедура ДобавитьНастройкуРегистра(Настройка, ТипОбъекта, ИмяОбъекта, СпособСвертки,
	ДополнительныеПоля = "", ПолеОрганизации = "Организация", Условие = "", 
	БудущиеЗаписи = Ложь, КлючОтбора = Неопределено) Экспорт
	
	Если Настройка.Регистры.Колонки.Количество() = 0 Тогда
		
		Настройка.Регистры.Колонки.Добавить("Документ"				, Новый ОписаниеТипов("ОбъектМетаданных"));
		Настройка.Регистры.Колонки.Добавить("ТипОбъекта"			, Новый ОписаниеТипов("Строка"));
		Настройка.Регистры.Колонки.Добавить("ИмяОбъекта"			, Новый ОписаниеТипов("Строка"));
		Настройка.Регистры.Колонки.Добавить("СпособСвертки"			, Новый ОписаниеТипов("Строка"));
		Настройка.Регистры.Колонки.Добавить("ДополнительныеПоля"	, Новый ОписаниеТипов("Структура"));
		Настройка.Регистры.Колонки.Добавить("ПолеОрганизации"		, Новый ОписаниеТипов("Строка"));
		Настройка.Регистры.Колонки.Добавить("Условие"				, Новый ОписаниеТипов("Строка"));
		Настройка.Регистры.Колонки.Добавить("БудущиеЗаписи"		, Новый ОписаниеТипов("Булево"));
		Настройка.Регистры.Колонки.Добавить("КлючОтбора");
		
	КонецЕсли;
	
	НастройкаРегистра							= Настройка.Регистры.Добавить();
	НастройкаРегистра.Документ				= Настройка.Документ;
	НастройкаРегистра.ТипОбъекта				= ТипОбъекта;
	НастройкаРегистра.ИмяОбъекта				= ИмяОбъекта;
	НастройкаРегистра.СпособСвертки			= СпособСвертки;
	НастройкаРегистра.ДополнительныеПоля	= ДополнительныеПоля;
	НастройкаРегистра.ПолеОрганизации		= ПолеОрганизации;
	НастройкаРегистра.Условие					= Условие;
	НастройкаРегистра.БудущиеЗаписи			= БудущиеЗаписи;
	НастройкаРегистра.КлючОтбора				= КлючОтбора;
	
КонецПроцедуры

Процедура ДополнитьТаблицуНастроекИнформацией(ТаблицаНастроек)
	
	ТаблицаНастроек.Колонки.Добавить("Параметры"			, Новый ОписаниеТипов("Структура"));
	ТаблицаНастроек.Колонки.Добавить("Прогресс"				, Новый ОписаниеТипов("Структура"));
	ТаблицаНастроек.Колонки.Добавить("ОграничениеПоТаблице"	, Новый ОписаниеТипов("Булево"));
	ТаблицаНастроек.Колонки.Добавить("КоличествоИтогов"		, Новый ОписаниеТипов("Число"));
	
	// Заполнение списка счетов
	
	ИспользуемыеСчета = Новый Массив;
	НастройкаВсеСчета = Неопределено;
	
	Для Каждого Настройка Из ТаблицаНастроек Цикл
		
		СписокСчетов = Неопределено;
		Настройка.ПараметрыЗапроса.Свойство("Счет", СписокСчетов);
		
		Если СписокСчетов = Неопределено Тогда
			Если Не ЗначениеЗаполнено(Настройка.СписокСчетов) Тогда
				СписокСчетов = Новый Массив;
			ИначеЕсли Настройка.СписокСчетов = "*" Тогда
				Если НастройкаВсеСчета = Неопределено Тогда
					НастройкаВсеСчета = Настройка;
				КонецЕсли;
				СписокСчетов = Новый Массив;
			Иначе
				СписокСчетов = СписокСчетовПоСтроке(Настройка.СписокСчетов);
			КонецЕсли;
			Настройка.ПараметрыЗапроса.Вставить("Счет", СписокСчетов);
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ИспользуемыеСчета, СписокСчетов);
		
	КонецЦикла;
	
	Если НастройкаВсеСчета <> Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Счета", ИспользуемыеСчета);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	НЕ ЕПСБУ.Ссылка В (&Счета)
		|	И НЕ ЕПСБУ.ЭлементГруппа
		|	И ЕПСБУ.ТипСчета <> ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Вспомогательный)";
		
		СписокСчетов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
		НастройкаВсеСчета.ПараметрыЗапроса.Вставить("Счет", СписокСчетов);
		
	КонецЕсли;
	
	// Заполнение комментария, количества итогов, способа ограничения записей, текста прогресса
	
	ДатаДляКомментария = Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
	ПараметрыШаблона = Новый Структура("ТекущаяДата", ДатаДляКомментария);
	
	КоличествоНастроек = ТаблицаНастроек.Количество();
	
	Для Каждого Настройка Из ТаблицаНастроек Цикл
		
		Шаблон = НСтр("ru = '[Сформирован обработкой свертки базы. [ТекущаяДата]]'");
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ПараметрыШаблона);
		Настройка.Комментарий = Комментарий + Настройка.Комментарий;
		
		Если ЗначениеЗаполнено(Настройка.ТекстЗапроса) Тогда
			СхемаЗапроса = Новый СхемаЗапроса();
			СхемаЗапроса.УстановитьТекстЗапроса(Настройка.ТекстЗапроса);
			КолВоТаблиц = СхемаЗапроса.ПакетЗапросов.Количество();
			Настройка.КоличествоИтогов = СхемаЗапроса.ПакетЗапросов[КолВоТаблиц-1].КонтрольныеТочкиИтогов.Количество();
		КонецЕсли;
		
		Настройка.ОграничениеПоТаблице = Ложь;
		Если Настройка.КоличествоИтогов = 0 Тогда
			Таблиц = 0;
			Для Каждого НастройкаРегистра Из Настройка.Регистры Цикл
				Если НастройкаРегистра.СпособСвертки <> "Очистить" Тогда
					Таблиц = Таблиц + 1;
				КонецЕсли;
			КонецЦикла;
			Если Таблиц = 1 Тогда
				Настройка.ОграничениеПоТаблице = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Настройка.Прогресс = Новый Структура("Текст,Всего,Выполнено", "", 0, 0);
		
		ЧастиТекста = Новый Массив;
		ПоЭтапу = НСтр("ru = 'Этап: %1 из %2'");
		ПоЭтапу = СтрШаблон(ПоЭтапу, ТаблицаНастроек.Индекс(Настройка) + 1, КоличествоНастроек);
		ЧастиТекста.Добавить(ПоЭтапу);		
		ЧастиТекста.Добавить(НСтр("ru = 'Документ'") + ": " + Настройка.Документ.Синоним);
		Если ЗначениеЗаполнено(Настройка.РазделУчета) Тогда
			ЧастиТекста.Добавить(НСтр("ru = 'Раздел учета'") + ": " + Строка(Настройка.РазделУчета));
		КонецЕсли;
		Если Настройка.Документ = Метаданные.Документы.КорректировкаРегистров
			И Настройка.Регистры.Количество() = 1 Тогда
			ПараметрыРегистра = Настройка.Регистры[0];
			Если ПараметрыРегистра.ТипОбъекта = "РегистрСведений" Тогда
				ПоРегистру = НСтр("ru = 'По регистру сведений: %1'");
			ИначеЕсли ПараметрыРегистра.ТипОбъекта = "РегистрНакопления" Тогда
				ПоРегистру = НСтр("ru = 'По регистру накопления: %1'");
			Иначе
				ПоРегистру = НСтр("ru = 'По регистру: %1'");
			КонецЕсли;
			СинонимРегистра = Метаданные[СтрЗаменить(ПараметрыРегистра.ТипОбъекта, "Регистр", "Регистры")][ПараметрыРегистра.ИмяОбъекта].Синоним;
			ЧастиТекста.Добавить(СтрЗаменить(ПоРегистру, "%1", СинонимРегистра));
		КонецЕсли;
		
		Настройка.Прогресс.Текст = СтрСоединить(ЧастиТекста, Символы.ПС);
		
	КонецЦикла;
	
	// Получение настроек регистров для обработки дублей записей регистров сведений
	
	Для Каждого Настройка Из ТаблицаНастроек Цикл
		
		Настройка.Регистры.Колонки.Добавить("Измерения"			, Новый ОписаниеТипов("Структура"));
		Настройка.Регистры.Колонки.Добавить("ИсключитьДубли"	, Новый ОписаниеТипов("Булево"));
		Настройка.Регистры.Колонки.Добавить("ЗамещатьПриЗаписи"	, Новый ОписаниеТипов("Булево"));
		Настройка.Регистры.Колонки.Добавить("Периодичность"		, Новый ОписаниеТипов("Строка"));
		Настройка.Регистры.Колонки.Добавить("Данные"			, Новый ОписаниеТипов("ТаблицаЗначений"));
		
		Для Каждого НастройкаРегистра Из Настройка.Регистры Цикл
			
			Если НастройкаРегистра.ТипОбъекта = "РегистрСведений" Тогда
				
				МетаданныеРег = Метаданные.РегистрыСведений[НастройкаРегистра.ИмяОбъекта];
				
				ПериодичностьРС = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений;
				ПоРегистратору  = (МетаданныеРег.ПериодичностьРегистраСведений = ПериодичностьРС.ПозицияРегистратора);
				Непериодический = (МетаданныеРег.ПериодичностьРегистраСведений = ПериодичностьРС.Непериодический);
				ПоСекунде		= (МетаданныеРег.ПериодичностьРегистраСведений = ПериодичностьРС.Секунда);
				
				Если ПоРегистратору Тогда
					НастройкаРегистра.ИсключитьДубли = (НастройкаРегистра.СпособСвертки = "Перенести"); // Возможны дубли при переносе
				Иначе
					НастройкаРегистра.ЗамещатьПриЗаписи = Истина;
					НастройкаРегистра.Периодичность = ?(Непериодический Или ПоСекунде, "", Строка(МетаданныеРег.ПериодичностьРегистраСведений));
				КонецЕсли;
				
				Если НастройкаРегистра.ИсключитьДубли Или НастройкаРегистра.ЗамещатьПриЗаписи Тогда // получаем измерения
					Если Не Непериодический Тогда
						НастройкаРегистра.Измерения.Вставить("Период");
					КонецЕсли;
					Для Каждого Измерение Из МетаданныеРег.Измерения Цикл
						НастройкаРегистра.Измерения.Вставить(Измерение.Имя);
					КонецЦикла;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция СписокОрганизаций(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка,
	|	Организации.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	&Условие
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организации.Код";
	
	Если Параметры.Организации = Неопределено Тогда
		Условие = "ИСТИНА";
	Иначе
		Условие = "Организации.Ссылка В (&Организации)";
		Запрос.УстановитьПараметр("Организации", Параметры.Организации);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", Условие);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьДатуЗапретаИзмененияДанных(ДатаЗапрета, СписокОрганизаций)
	
	Если СписокОрганизаций = Неопределено Тогда
		
		НаборЗаписей = РегистрыСведений.ДатыЗапретаИзменения.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Раздел.Установить(ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка());
		НаборЗаписей.Отбор.Объект.Установить(ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка());
		НаборЗаписей.Отбор.Пользователь.Установить(Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей);
		
		НаборЗаписей.Прочитать();
		
		Запись = ?(НаборЗаписей.Количество() > 0, НаборЗаписей[0], НаборЗаписей.Добавить());
		
		Если Запись.ДатаЗапрета <> ДатаЗапрета Тогда
			
			Запись.Раздел		= ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка();
			Запись.Объект		= ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка();
			Запись.Пользователь	= Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей;
			Запись.ДатаЗапрета	= ДатаЗапрета;
			
			Попытка
				
				ОтключитьМеханизмыОбъекта(НаборЗаписей);
				НаборЗаписей.Записать();
				
				Шаблон = НСтр("ru = 'Установлена новая общая дата запрета изменения данных: %1'");
				Комментарий = СтрШаблон(Шаблон, Формат(ДатаЗапрета, "ДЛФ=D"));
				ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация); 
				
			Исключение
				
				Комментарий = НСтр("ru = 'Не удалось установить новую общую дату запрета изменения данных'");
				ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Ошибка);
				
				ВызватьИсключение;
				
			КонецПопытки;
			
		КонецЕсли;
		
	Иначе
		
		Для Каждого СтрокаОрганизации Из СписокОрганизаций Цикл
			
			НаборЗаписей = РегистрыСведений.ДатыЗапретаИзменения.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Раздел.Установить(ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка());
			НаборЗаписей.Отбор.Объект.Установить(СтрокаОрганизации.Ссылка);
			НаборЗаписей.Отбор.Пользователь.Установить(Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей);
			
			НаборЗаписей.Прочитать();
			
			Запись = ?(НаборЗаписей.Количество() > 0, НаборЗаписей[0], НаборЗаписей.Добавить());
			
			Если Запись.ДатаЗапрета <> ДатаЗапрета Тогда
				
				Запись.Раздел		= ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка();
				Запись.Объект		= СтрокаОрганизации.Ссылка;
				Запись.Пользователь	= Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей;
				Запись.ДатаЗапрета	= ДатаЗапрета;
				
				Попытка
					
					ОтключитьМеханизмыОбъекта(НаборЗаписей);
					НаборЗаписей.Записать();
					
					Шаблон = НСтр("ru = 'Установлена новая общая дата запрета изменения данных для организации ""%1"": %2'");
					Комментарий = СтрШаблон(Шаблон, СтрокаОрганизации.Наименование, Формат(ДатаЗапрета, "ДЛФ=D"));
					ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация); 
					
				Исключение
					
					Шаблон = НСтр("ru = 'Не удалось установить новую общую дату запрета изменения данных для организации ""%1""'");
					Комментарий = СтрШаблон(Шаблон, СтрокаОрганизации.Наименование);
					ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Ошибка);
					
					ВызватьИсключение;
					
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьДатуВводаОстатков(ДатаВвода, СписокОрганизаций)
	
	Для Каждого СтрокаОрганизации Из СписокОрганизаций Цикл
		
		НаборЗаписей = РегистрыСведений.ДатыВводаНачальныхОстатков.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(СтрокаОрганизации.Ссылка);
		НаборЗаписей.Прочитать();
		
		Запись = ?(НаборЗаписей.Количество() > 0, НаборЗаписей[0], НаборЗаписей.Добавить());
		
		Если Запись.ДатаВводаНачальныхОстатков <> ДатаВвода Тогда
			
			Запись.Организация = СтрокаОрганизации.Ссылка;
			Запись.ДатаВводаНачальныхОстатков = ДатаВвода;
			
			Попытка
				
				ОтключитьМеханизмыОбъекта(НаборЗаписей);
				НаборЗаписей.Записать();
				
				Шаблон = НСтр("ru = 'Установлена новая дата ввода остатков для организации ""%1"": %2'");
				Комментарий = СтрШаблон(Шаблон, СтрокаОрганизации.Наименование, Формат(ДатаВвода, "ДЛФ=D"));
				ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация);
				
			Исключение
				
				Шаблон = НСтр("ru = 'Не удалось установить новую дату ввода остатков для организации ""%1""'");
				Комментарий = СтрШаблон(Шаблон, СтрокаОрганизации.Наименование);
				ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Ошибка);
				
				ВызватьИсключение;
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМассивДокументовВводаОстатков(ДатаДокумента)
	
	ТаблицаНастроек = ТаблицаНастроекСвертки();
	
	ДокументыВводаОстатков = Новый Соответствие;
	
	Для Каждого Настройка Из ТаблицаНастроек Цикл
		ДокументыВводаОстатков.Вставить(Настройка.Документ);
	КонецЦикла;
	
	Если ДокументыВводаОстатков.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Шаблон =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.%1 КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &НачДата И &КонДата
	|	И Док.Комментарий ПОДОБНО &Комментарий
	|	И НЕ Док.ПометкаУдаления
	|	И НЕ Док.Проведен
	|	И Док.ЭтоАгрегаторДвижений";
	
	Разделитель = "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|";
	
	ЧастиЗапроса = Новый Массив;
	Для Каждого ЗаписьДокумента Из ДокументыВводаОстатков Цикл
		ДокументОстатков = ЗаписьДокумента.Ключ;
		ТекстДокумента = Шаблон;
		Если ДокументОстатков.Реквизиты.Найти("ЭтоАгрегаторДвижений") = Неопределено Тогда
			ТекстДокумента = СтрЗаменить(ТекстДокумента, "И Док.ЭтоАгрегаторДвижений", "");
		КонецЕсли;
		ТекстДокумента = СтрЗаменить(ТекстДокумента, "%1", ДокументОстатков.Имя);
		// Пока есть "старая" свертка, нужно исключить документы, созданные при "старой" свертке на ту же дату
		Если ДокументОстатков.Имя = "КорректировкаРегистров" Тогда
			ДопУсловие = "И НЕ Док.Комментарий ПОДОБНО ""%1""";
			ДопУсловие = СтрЗаменить(ДопУсловие, "%1", "%"+НСтр("ru = 'Ввод остатков по регистр'")+"%");
			ТекстДокумента = ТекстДокумента + Символы.ПС + Символы.Таб + ДопУсловие;
		КонецЕсли;
		//
		ЧастиЗапроса.Добавить(ТекстДокумента);
	КонецЦикла;
	
	ТекстЗапроса = СтрСоединить(ЧастиЗапроса, Разделитель);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачДата"		, НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("КонДата"		, КонецДня(ДатаДокумента));
	Запрос.УстановитьПараметр("Комментарий"	, "%"+НСтр("ru='Сформирован обработкой свертки базы'")+"%");
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Процедура ПолучитьДанныеРазделаУчета(ПараметрыРаздела, Запрос)
	
	Если ПараметрыРаздела.Документ.Имя = "ВводИсторииКапвложений" Тогда
		Данные = Документы.ВводИсторииКапвложений.ТаблицаИсторииКапвложений(
			ПараметрыРаздела.Параметры.ДатаСверткиИБ, ПараметрыРаздела.Параметры.Организации);
		ПараметрыРаздела.Регистры[0].Данные = Данные;
		Возврат;
	КонецЕсли;
	
	Данные			= Новый Структура;
	ТекстыТаблиц	= Новый Массив;
	ТаблицыЗапроса	= Новый Соответствие;
	Сч				= 0;
	
	НуженОтборПоОрганизации = (ПараметрыРаздела.Параметры.Организации <> Неопределено);
	Для Каждого НастройкаРаздела Из ПараметрыРаздела.Регистры Цикл
		Если НастройкаРаздела.СпособСвертки = "Свернуть" Или НастройкаРаздела.СпособСвертки = "Перенести" Тогда
			ИндексТаблицыСРезультатом = 0;
			ТекстТаблицы = ПолучитьТекстТаблицы(НастройкаРаздела, НуженОтборПоОрганизации,ИндексТаблицыСРезультатом);
			ТекстыТаблиц.Добавить(ТекстТаблицы);
			Сч = Сч + ИндексТаблицыСРезультатом;
			ТаблицыЗапроса.Вставить(НастройкаРаздела, Сч);
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если ТекстыТаблиц.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = СтрСоединить(ТекстыТаблиц, ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета());
	
	Попытка
		Результат = Запрос.ВыполнитьПакет();
	Исключение
		ОтразитьВЖурналеРегистрации(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
		ВызватьИсключение;
	КонецПопытки;
	
	Для Каждого ТаблицаЗапроса Из ТаблицыЗапроса Цикл
		ТаблицаДанных = Результат[ТаблицаЗапроса.Значение].Выгрузить();
		
		КолонкиИндекса = ПараметрыРаздела.КлючОтбора;
		Если ЗначениеЗаполнено(ТаблицаЗапроса.Ключ.КлючОтбора) Тогда
			// Колонки индекса (поиска) для конкретного регистра могут отличаться от заданных в
			// настроке раздела. Если для регистра указан свой набор колонок, то нужно исполльзовать его.
			КолонкиИндекса = ТаблицаЗапроса.Ключ.КлючОтбора;
		КонецЕсли;	
		ТаблицаДанных.Индексы.Добавить(КолонкиИндекса);
		ТаблицаЗапроса.Ключ.Данные = ТаблицаДанных;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТекстТаблицы(НастройкаРаздела, НуженОтборПоОрганизации, ИндексТаблицыСРезультатом = 0)
	
	ТекущийРегистр = Метаданные[СтрЗаменить(НастройкаРаздела.ТипОбъекта, "Регистр", "Регистры")][НастройкаРаздела.ИмяОбъекта];
	
	ПоляТаблицы = Новый Структура;
	
	ЭтоНепериодическийРС = (НастройкаРаздела.ТипОбъекта = "РегистрСведений"
		И ТекущийРегистр.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический);
	
	Если Не ЭтоНепериодическийРС Тогда
		ПоляТаблицы.Вставить("Период", ?(НастройкаРаздела.СпособСвертки = "Свернуть", "&Период", "Период"));
	КонецЕсли;
	
	ЕстьАктивность = Ложь;
	
	Для Каждого ТекИзмерение Из ТекущийРегистр.СтандартныеРеквизиты Цикл
		Если ТекИзмерение.Имя = "Активность" Тогда
			ПоляТаблицы.Вставить(ТекИзмерение.Имя, "ЛОЖЬ");
			ЕстьАктивность = Истина;
		КонецЕсли;
		Если НастройкаРаздела.СпособСвертки = "Перенести" И ТекИзмерение.Имя = "ВидДвижения" Тогда
			ПоляТаблицы.Вставить(ТекИзмерение.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Если НастройкаРаздела.ТипОбъекта = "РегистрБухгалтерии" Тогда
		Если НастройкаРаздела.СпособСвертки = "Перенести" Тогда
			ПоляТаблицы.Вставить("СчетДт");
			ПоляТаблицы.Вставить("СчетКт");
			Для Каждого ТекИзмерение Из ТекущийРегистр.СтандартныеРеквизиты Цикл
				Если СтрНачинаетсяС(ТекИзмерение.Имя, "Субконто") Тогда
					ПоляТаблицы.Вставить(Лев(ТекИзмерение.Имя,8)+"Дт"+Сред(ТекИзмерение.Имя,9));
					ПоляТаблицы.Вставить(Лев(ТекИзмерение.Имя,8)+"Кт"+Сред(ТекИзмерение.Имя,9));
				ИначеЕсли СтрНачинаетсяС(ТекИзмерение.Имя, "ВидСубконто") Тогда
					ПоляТаблицы.Вставить(Лев(ТекИзмерение.Имя,11)+"Дт"+Сред(ТекИзмерение.Имя,12));
					ПоляТаблицы.Вставить(Лев(ТекИзмерение.Имя,11)+"Кт"+Сред(ТекИзмерение.Имя,12));
				КонецЕсли;
			КонецЦикла;
		Иначе
			ПоляТаблицы.Вставить("Счет");
			Для Каждого ТекИзмерение Из ТекущийРегистр.СтандартныеРеквизиты Цикл
				Если СтрНайти(ТекИзмерение.Имя, "Субконто") = 1 Тогда
					ПоляТаблицы.Вставить(ТекИзмерение.Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	
		
	Если НастройкаРаздела.ТипОбъекта = "РегистрБухгалтерии"
		И НастройкаРаздела.СпособСвертки = "Перенести" Тогда
		
		Для Каждого ТекИзмерение Из ТекущийРегистр.Измерения Цикл
			Если ТекИзмерение.Балансовый Тогда
				ПоляТаблицы.Вставить(ТекИзмерение.Имя);
			Иначе
				ПоляТаблицы.Вставить(ТекИзмерение.Имя+"Дт");
				ПоляТаблицы.Вставить(ТекИзмерение.Имя+"Кт");
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекРесурс Из ТекущийРегистр.Ресурсы Цикл
			Если ТекРесурс.Балансовый Тогда
				ПоляТаблицы.Вставить(ТекРесурс.Имя, ТекРесурс.Имя);
			Иначе
				ПоляТаблицы.Вставить(ТекРесурс.Имя+"Дт", ТекРесурс.Имя+"Дт");
				ПоляТаблицы.Вставить(ТекРесурс.Имя+"Кт", ТекРесурс.Имя+"Кт");
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Для Каждого ТекИзмерение Из ТекущийРегистр.Измерения Цикл
			ПоляТаблицы.Вставить(ТекИзмерение.Имя);
		КонецЦикла;
		
		ЭтоОстатки = (НастройкаРаздела.СпособСвертки = "Свернуть"
			И (НастройкаРаздела.ТипОбъекта = "РегистрНакопления" Или НастройкаРаздела.ТипОбъекта = "РегистрБухгалтерии"));
		
		Для Каждого ТекРесурс Из ТекущийРегистр.Ресурсы Цикл
			ПоляТаблицы.Вставить(ТекРесурс.Имя, ТекРесурс.Имя + ?(ЭтоОстатки, "Остаток", ""));
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого ТекРесурс Из ТекущийРегистр.Реквизиты Цикл
		Если НастройкаРаздела.СпособСвертки = "Перенести" Или НастройкаРаздела.ТипОбъекта = "РегистрСведений" Тогда
			ПоляТаблицы.Вставить(ТекРесурс.Имя);
		//Иначе
		//	ПоляТаблицы.Вставить(ТекРесурс.Имя, "NULL");
		КонецЕсли;
	КонецЦикла;
	
	Если НастройкаРаздела.ТипОбъекта = "РегистрБухгалтерии" Тогда
		СкорректироватьПоляРБ(ПоляТаблицы, НастройкаРаздела);
	КонецЕсли;
	
	Для Каждого ДопПоле Из НастройкаРаздела.ДополнительныеПоля Цикл
		ПоляТаблицы.Вставить(ДопПоле.Ключ, ДопПоле.Значение);
	КонецЦикла;
	
	мПоляТаблицы = Новый Массив;
	Для Каждого ПолеТаблицы Из ПоляТаблицы Цикл
		Если ЗначениеЗаполнено(ПолеТаблицы.Значение) Тогда
			Формула = ПолеТаблицы.Значение;
		Иначе
			Формула = "ТаблицаРегистра." + ПолеТаблицы.Ключ;
		КонецЕсли;
		мПоляТаблицы.Добавить(Формула + " КАК " + ПолеТаблицы.Ключ);
	КонецЦикла;
	
	Разделитель = ",
	|	";
	ПоляТаблицы = СтрСоединить(мПоляТаблицы, Разделитель);
	
	ТипТаблицы = "";
	
	Условия = Новый Массив;
	УсловиеВиртуальное = "";
	
	ТребуетсяСоединениеСРСДатыПроведения = Ложь;
	
	ТекстПредварительногоЗапроса = "";
	Если НастройкаРаздела.СпособСвертки = "Свернуть" Тогда
		Если НастройкаРаздела.ТипОбъекта = "РегистрСведений" Тогда
			ТипТаблицы = ".СрезПоследних(&ГраницаОстатков, [УсловиеВиртуальное])";
			// регистр сведений "УчетныеДанныеОбъектаОС" сворачиваем в документ "КорректировкаРегистров" только если счет учета 106.6Х,
			// это капвложения в права пользования НМА. Эти данные в дальнейшем будут нужны для определения КЭК при
			// формировании проводок в документах учета (352, 452 с определенными СПИ ИЛИ 353, 453 без определенного СПИ)
			// СПИ - срок полезного использования.
			Если НастройкаРаздела.ИмяОбъекта = "УчетныеДанныеОбъектОС"
				И НастройкаРаздела.Владелец().Колонки.Найти("Документ") <> Неопределено
				И НастройкаРаздела.Документ = Метаданные.Документы.КорректировкаРегистров Тогда
				Условия.Добавить("ПОДСТРОКА(СчетУчета.Код, 1, 5 = ""106.6""");
			КонецЕсли;
		ИначеЕсли НастройкаРаздела.ТипОбъекта = "РегистрНакопления" Тогда
			ТипТаблицы = ".Остатки(&ГраницаОстатков, [УсловиеВиртуальное])";
		ИначеЕсли НастройкаРаздела.ТипОбъекта = "РегистрБухгалтерии" Тогда
			ТипТаблицы = ".Остатки(&ГраницаОстатков, Счет В (&Счет), , [УсловиеВиртуальное])";
		КонецЕсли;
	ИначеЕсли НастройкаРаздела.СпособСвертки = "Перенести" Тогда
		Если НастройкаРаздела.ТипОбъекта = "РегистрБухгалтерии"
			И НастройкаРаздела.БудущиеЗаписи Тогда
			
			ТребуетсяСоединениеСРСДатыПроведения = Истина;
			
			ТипТаблицы = ".ДвиженияССубконто(&ПериодПосле, , [УсловиеВиртуальное], , )";
			
			//Дата проведения больше даты свертки, а движения до даты свертки и после даты свертки
			ТекстПредварительногоЗапроса = "ВЫБРАТЬ
			|	ТТ.Регистратор КАК Регистратор
			|ПОМЕСТИТЬ ТабРегистраторы
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ТТ
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
			|		ПО (ДатыПроведенияДокументов.Документ = ТТ.Регистратор)
			|ГДЕ
			|	ВЫБОР
			|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
			|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|			ТОГДА ТТ.Регистратор.Дата
			|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
			|	КОНЕЦ > &Период
			|
			|СГРУППИРОВАТЬ ПО
			|	ТТ.Регистратор
			|
			|ИМЕЮЩИЕ
			|	МАКСИМУМ(ТТ.Период) > &Период
			|	И МИНИМУМ(ТТ.Период) <= &Период
			|;
			|";
			
			//дата проведения до даты свертки или документ в списке документов из запроса выше
			Условия.Добавить("
			|	(ВЫБОР
			|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
			|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|			ТОГДА ТаблицаРегистра.Регистратор.Дата
			|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
			|	КОНЕЦ <= &Период
			|	ИЛИ ИСТИНА В (ВЫБРАТЬ ПЕРВЫЕ 1
			| 				ИСТИНА
			|				ИЗ ТабРегистраторы КАК Таб
			|				ГДЕ Таб.Регистратор = ТаблицаРегистра.Регистратор))");
			Условия.Добавить("ТаблицаРегистра.Активность");
			
			ИндексТаблицыСРезультатом = 1;
		КонецЕсли;
	КонецЕсли;
		
	Если ТипТаблицы = "" Тогда
				
		Если ЭтоНепериодическийРС Тогда
			
			ТребуетсяСоединениеСРСДатыПроведения = Истина;
			//дата проведения до даты свертки
			Условия.Добавить("ВЫБОР
				|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
				|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
				|			ТОГДА ТаблицаРегистра.Регистратор.Дата
				|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
				|	КОНЕЦ <= &Период");
		Иначе
			Если НастройкаРаздела.БудущиеЗаписи Тогда
				
				ТребуетсяСоединениеСРСДатыПроведения = Истина;
				//дата проведения до даты свертки и есть движения после даты свертки
				Условия.Добавить("ТаблицаРегистра.Период > &Период 
				|	И ВЫБОР
				|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
				|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
				|			ТОГДА ТаблицаРегистра.Регистратор.Дата
				|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
				|	КОНЕЦ <= &Период");
			Иначе
				Условия.Добавить("ТаблицаРегистра.Период <= &Период");
			КонецЕсли;
		КонецЕсли;
		Если ЕстьАктивность Тогда
			Условия.Добавить("ТаблицаРегистра.Активность");
		КонецЕсли;	
	КонецЕсли;
	
	Если НастройкаРаздела.ПолеОрганизации <> "" И НуженОтборПоОрганизации Тогда
		Если ТипТаблицы = "" Тогда
			Условия.Добавить("ТаблицаРегистра.[ПолеОрганизации] В (&Организации)");
		Иначе
			УсловиеВиртуальное = "[ПолеОрганизации] В (&Организации)";
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкаРаздела.Условие) Тогда
		Если ТипТаблицы = "" Тогда
			Условия.Добавить("(" + НастройкаРаздела.Условие + ")");
		Иначе
			УсловиеВиртуальное = ?(ЗначениеЗаполнено(УсловиеВиртуальное), УсловиеВиртуальное + " И ", "")
				+ "(" + НастройкаРаздела.Условие + ")";
		КонецЕсли;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	[ПоляТаблицы]
	|ИЗ
	|	[ТипОбъекта].[ИмяОбъекта][ТипТаблицы] КАК ТаблицаРегистра
	|	[ДатыПроведенияДокументов]
	| 	[Условие]";
	
	Условие = ?(Условия.Количество() = 0, "", "ГДЕ
	|	" + СтрСоединить(Условия, "
	|	И "));
	
	ЧастиТекста = Новый Структура;
	ЧастиТекста.Вставить("ПоляТаблицы"	, ПоляТаблицы);
	ЧастиТекста.Вставить("ТипОбъекта"	, НастройкаРаздела.ТипОбъекта);
	ЧастиТекста.Вставить("ИмяОбъекта"	, НастройкаРаздела.ИмяОбъекта);
	ЧастиТекста.Вставить("ТипТаблицы"	, ТипТаблицы);
	ЧастиТекста.Вставить("Условие"		, Условие);
	
	ДатыПроведенияДокументов = "";	
	Если ТребуетсяСоединениеСРСДатыПроведения Тогда
		ДатыПроведенияДокументов = "ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
		|		ПО (ДатыПроведенияДокументов.Документ = ТаблицаРегистра.Регистратор)"; 	
	КонецЕсли;
	ЧастиТекста.Вставить("ДатыПроведенияДокументов", ДатыПроведенияДокументов);
	
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстЗапроса, ЧастиТекста);
	
	ЧастиТекста = Новый Структура;
	ЧастиТекста.Вставить("УсловиеВиртуальное", УсловиеВиртуальное);
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстЗапроса, ЧастиТекста);
	
	ЧастиТекста = Новый Структура;
	ЧастиТекста.Вставить("ПолеОрганизации", НастройкаРаздела.ПолеОрганизации);
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстЗапроса, ЧастиТекста);
	
	Если ЗначениеЗаполнено(ТекстПредварительногоЗапроса) Тогда
		ТекстЗапроса = ТекстПредварительногоЗапроса + ТекстЗапроса;
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура СкорректироватьПоляРБ(ПоляТаблицы, НастройкаРаздела)
	
	ПереопределяемыеПоля = Новый Структура;
	
	ПереопределяемыеПоля.Вставить("КПС"				, "ЕСТЬNULL(ТаблицаРегистра.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))");
	ПереопределяемыеПоля.Вставить("КЭК"				, "ЕСТЬNULL(ТаблицаРегистра.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка))");
	ПереопределяемыеПоля.Вставить("ИФО"				, "ЕСТЬNULL(ТаблицаРегистра.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))");
	ПереопределяемыеПоля.Вставить("Валюта"			, "ЕСТЬNULL(ТаблицаРегистра.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))");
	ПереопределяемыеПоля.Вставить("Подразделение"	, "ЕСТЬNULL(ТаблицаРегистра.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))");
	
	ПереопределяемыеПоля.Вставить("КПСДт"			, "ЕСТЬNULL(ТаблицаРегистра.КПСДт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))");
	ПереопределяемыеПоля.Вставить("КПСКт"			, "ЕСТЬNULL(ТаблицаРегистра.КПСКт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))");
	
	ПереопределяемыеПоля.Вставить("КЭКДт"			, "ЕСТЬNULL(ТаблицаРегистра.КЭКДт, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка))");
	ПереопределяемыеПоля.Вставить("КЭККт"			, "ЕСТЬNULL(ТаблицаРегистра.КЭККт, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка))");
	
	ПереопределяемыеПоля.Вставить("ВалютаДт"		, "ЕСТЬNULL(ТаблицаРегистра.ВалютаДт, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))");
	ПереопределяемыеПоля.Вставить("ВалютаКт"		, "ЕСТЬNULL(ТаблицаРегистра.ВалютаКт, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))");
	ПереопределяемыеПоля.Вставить("ПодразделениеДт"	, "ЕСТЬNULL(ТаблицаРегистра.ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))");
	ПереопределяемыеПоля.Вставить("ПодразделениеКт"	, "ЕСТЬNULL(ТаблицаРегистра.ПодразделениеКт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))");
	
	Для Каждого Поле Из ПереопределяемыеПоля Цикл
		Если ПоляТаблицы.Свойство(Поле.Ключ) Тогда
			ПоляТаблицы.Вставить(Поле.Ключ, Поле.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если НастройкаРаздела.СпособСвертки = "Свернуть" И ПоляТаблицы.Свойство("ЖурналОпераций") Тогда
		ПоляТаблицы.Удалить("ЖурналОпераций");
	КонецЕсли;
	Если ПоляТаблицы.Свойство("УдалитьЖурналОпераций") Тогда
		ПоляТаблицы.Удалить("УдалитьЖурналОпераций");
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьРанееСозданныеДокументыВводаОстатков(Параметры)
	
	МассивДокументов = ПолучитьМассивДокументовВводаОстатков(Параметры.Дата);
	КоличествоДокументов = МассивДокументов.Количество();
	
	Если КоличествоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Текст = НСтр("ru = 'Удаляются ранее созданные документы ввода остатков (%1 шт.)...'");
	Текст = СтрЗаменить(Текст, "%1", КоличествоДокументов);
	СообщениеПрогресса(Текст);
	
	Для Каждого ДокСсылка Из МассивДокументов Цикл
		ДокументОбъект = ДокСсылка.ПолучитьОбъект();
		ОтключитьМеханизмыОбъекта(ДокументОбъект);
		ДокументОбъект.Удалить();
	КонецЦикла;
	
	Комментарий = НСтр("ru = 'Удалены ранее созданные документы ввода остатков: %1 шт.'");
	Комментарий = СтрЗаменить(Комментарий, "%1", КоличествоДокументов);
	ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация);
	
КонецПроцедуры

Процедура СформироватьДокументыВводаОстатков(Параметры)
	
	ТаблицаНастроек = ТаблицаНастроекСвертки();
	
	ДополнитьТаблицуНастроекИнформацией(ТаблицаНастроек);
	
	ОпределитьСчетКорреспондент(Параметры);
	
	СообщениеПрогресса(НСтр("ru = 'Создаются документы ввода остатков...'"));
	
	Для Каждого НастройкиРаздела Из ТаблицаНастроек Цикл
		
		НастройкиРаздела.Параметры = Параметры;
		СформироватьДокументыРазделаУчета(НастройкиРаздела);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОпределитьСчетКорреспондент(Параметры)
	
	ДанныСчета = Неопределено;
	Параметры.Свойство("СчетКорреспондент", ДанныСчета);
	
	// Реквизиты счета для проводок
	
	СчетКорреспондент = Новый Структура;
	СчетКорреспондент.Вставить("Счет"				, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	СчетКорреспондент.Вставить("КПС"				, Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
	СчетКорреспондент.Вставить("КЭКДт"				, Справочники.КОСГУ.ПустаяСсылка());
	СчетКорреспондент.Вставить("КЭККт"				, Справочники.КОСГУ.ПустаяСсылка());
	СчетКорреспондент.Вставить("ЗначенияСубконто"	, Новый Соответствие);
	СчетКорреспондент.Вставить("ЗаполнитьКПС"		, Ложь);
	СчетКорреспондент.Вставить("ЗаполнитьКЭК"		, Ложь);
	
	// Дополнительные реквизиты типовой операции
	
	ДопРеквизитыТО = Новый Структура;
	
	Если ДанныСчета = Неопределено Тогда
		
		СчетКорреспондент.Счет = ПланыСчетов.ЕПСБУ.Вспомогательный;
		
	Иначе
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ДанныСчета.Счет);
		
		СчетКорреспондент.Счет			= ДанныСчета.Счет;
		СчетКорреспондент.КПС			= ДанныСчета.КПС;
		СчетКорреспондент.КЭКДт			= ДанныСчета.КЭК;
		СчетКорреспондент.КЭККт			= Справочники.КОСГУ.НайтиПоКоду("7" + Сред(ДанныСчета.КЭК.Код, 2));
		СчетКорреспондент.ЗаполнитьКПС	= СвойстваСчета.УчетПоКПС;
		СчетКорреспондент.ЗаполнитьКЭК	= СвойстваСчета.УчетПоКЭК;
		
		ДопРеквизитыТО.Вставить("КорСчет"		, ДанныСчета.Счет);
		ДопРеквизитыТО.Вставить("КПСКорСчет"	, ДанныСчета.КПС);
		ДопРеквизитыТО.Вставить("КЭККорСчет"	, ДанныСчета.КЭК);
		
		Для к = 1 По СвойстваСчета.КоличествоСубконто Цикл
			СчетКорреспондент.ЗначенияСубконто.Вставить(СвойстваСчета["ВидСубконто"+к], ДанныСчета["Субконто"+к]);
			ДопРеквизитыТО.Вставить("СубконтоКорСчет"+к, ДанныСчета["Субконто"+к]);
		КонецЦикла;
		
	КонецЕсли;
	
	Параметры.Вставить("СчетКорреспондент", СчетКорреспондент);
	Параметры.Вставить("ДопРеквизитыТО", ДопРеквизитыТО);
	
КонецПроцедуры

Процедура СформироватьДокументыРазделаУчета(ПараметрыРаздела)
	
	Запрос = Новый Запрос(ПараметрыРаздела.ТекстЗапроса);
	Запрос.УстановитьПараметр("Период"			, ПараметрыРаздела.Параметры.Дата);
	Запрос.УстановитьПараметр("ПериодПосле"		, ПараметрыРаздела.Параметры.Дата+1);
	Запрос.УстановитьПараметр("ГраницаОстатков"	, ПараметрыРаздела.Параметры.ГраницаОстатков);
	Запрос.УстановитьПараметр("Организации"		, ПараметрыРаздела.Параметры.Организации);
	Для Каждого Параметр Из ПараметрыРаздела.ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	Условие = ?(ПараметрыРаздела.Параметры.Организации = Неопределено, "ИСТИНА", "Организация В (&Организации)");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", Условие);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		ПолучитьДанныеРазделаУчета(ПараметрыРаздела, Запрос);
		ВыполнитьОбходПоГруппировке(Результат, ПараметрыРаздела);
		ПараметрыРаздела.Регистры.Колонки.Удалить("Данные");
	КонецЕсли;
	
	Комментарий = НСтр("ru = 'Создано документов: %1'");
	Комментарий = СтрЗаменить(Комментарий, "%1", Формат(ПараметрыРаздела.Прогресс.Выполнено, "ЧН=0"));
	Комментарий = ПараметрыРаздела.Прогресс.Текст + Символы.ПС + Комментарий;
	ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация);
	
КонецПроцедуры

Процедура ВыполнитьОбходПоГруппировке(РезультатЗапроса, ПараметрыРаздела, Уровень = 1)
	
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если Уровень <= ПараметрыРаздела.КоличествоИтогов Тогда
		Пока Выборка.Следующий() Цикл
			ВыполнитьОбходПоГруппировке(Выборка, ПараметрыРаздела, Уровень + 1);
		КонецЦикла;
	Иначе
		
		Если ПараметрыРаздела.ОграничениеПоТаблице Тогда
			СформироватьДокументыРазделаУчетаПоТаблице(ПараметрыРаздела, Выборка);
		Иначе
			СформироватьДокументыРазделаУчетаПоОбъектамУчета(ПараметрыРаздела, Выборка);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьДокументыРазделаУчетаПоТаблице(ПараметрыРаздела, Выборка)
	
	НастройкаРегистра = ПараметрыРаздела.Регистры[0];
	
	Если НастройкаРегистра.Данные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура(ПараметрыРаздела.КлючОтбора);
	
	ЭтоРБ = (НастройкаРегистра.ТипОбъекта = "РегистрБухгалтерии");
	ОтборСтрок = ?(НастройкаРегистра.ИсключитьДубли, НастройкаРегистра.Измерения, Новый Структура);
	
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(Отбор, Выборка);
		
		СтрокиДанных = НастройкаРегистра.Данные.НайтиСтроки(Отбор);
		
		КоличествоЗаписей = СтрокиДанных.Количество();
		Счетчик = 0;
		
		Для Каждого СтрокаДанных Из СтрокиДанных Цикл
			
			Если Счетчик = 0 Тогда
				
				НовыйДокумент = Документы[ПараметрыРаздела.Документ.Имя].СоздатьДокумент();
				
				ТаблицаДвижений = НовыйДокумент.Движения[НастройкаРегистра.ИмяОбъекта];
				ТаблицаДвижений.Записывать = Истина;
				ОтключитьМеханизмыОбъекта(ТаблицаДвижений);
				
			КонецЕсли;
			
			ДобавитьСтрокуДвижения(ТаблицаДвижений, СтрокаДанных, ЭтоРБ, ОтборСтрок, ПараметрыРаздела.Параметры.СчетКорреспондент);
			
			Счетчик = Счетчик + 1;
			
			Если Счетчик >= ПараметрыРаздела.Ограничение Или Счетчик >= КоличествоЗаписей Тогда
				ЗаписатьДокументВводаОстатков(НовыйДокумент, ПараметрыРаздела, Отбор, НастройкаРегистра.СпособСвертки);
				КоличествоЗаписей = КоличествоЗаписей - Счетчик;
				Счетчик = 0;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьДокументыРазделаУчетаПоОбъектамУчета(ПараметрыРаздела, Выборка)
	
	Отбор = Новый Структура(ПараметрыРаздела.КлючОтбора);
	
	КоличествоЗаписей = Выборка.Количество();
	Счетчик = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Если Счетчик = 0 Тогда
			НовыйДокумент = Документы[ПараметрыРаздела.Документ.Имя].СоздатьДокумент();
			ЕстьДанныеДокумента = Ложь;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Отбор, Выборка);
		
		Для Каждого НастройкаРегистра Из ПараметрыРаздела.Регистры Цикл
			
			ТекОтбор = Отбор;
			Если ЗначениеЗаполнено(НастройкаРегистра.КлючОтбора) Тогда
				ТекОтбор = Новый Структура(НастройкаРегистра.КлючОтбора);
				ЗаполнитьЗначенияСвойств(ТекОтбор, Выборка);
			КонецЕсли;	
			
			ТаблицаДвижений = НовыйДокумент.Движения[НастройкаРегистра.ИмяОбъекта];
			ТаблицаДвижений.Записывать = Истина;
			ОтключитьМеханизмыОбъекта(ТаблицаДвижений);
			
			ЭтоРБ = (НастройкаРегистра.ТипОбъекта = "РегистрБухгалтерии");
			ОтборСтрок = ?(НастройкаРегистра.ИсключитьДубли, НастройкаРегистра.Измерения, Новый Структура);
			
			СтрокиДанных = НастройкаРегистра.Данные.НайтиСтроки(ТекОтбор);
			
			Для Каждого СтрокаДанных Из СтрокиДанных Цикл
				
				ДобавитьСтрокуДвижения(ТаблицаДвижений, СтрокаДанных, ЭтоРБ, ОтборСтрок, ПараметрыРаздела.Параметры.СчетКорреспондент);
				
				ЕстьДанныеДокумента = Истина;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если ЕстьДанныеДокумента Тогда
			Счетчик = Счетчик + 1;
		КонецЕсли;
		
		Если Счетчик >= ПараметрыРаздела.Ограничение Или Счетчик >= КоличествоЗаписей Тогда
			ЗаписатьДокументВводаОстатков(НовыйДокумент, ПараметрыРаздела, Отбор);
			КоличествоЗаписей = КоличествоЗаписей - Счетчик;
			Счетчик = 0;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьСообщениеПрогрессаРаздела(ПараметрыРаздела)
	
	ПараметрыРаздела.Прогресс.Выполнено = ПараметрыРаздела.Прогресс.Выполнено + 1;
	
	ТекстСообщения = НСтр("ru = 'Выполнено: %1...'");
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%1", ПараметрыРаздела.Прогресс.Выполнено);
	ТекстСообщения = ПараметрыРаздела.Прогресс.Текст + Символы.ПС + ТекстСообщения;
	
	СообщениеПрогресса(ТекстСообщения);
	
КонецПроцедуры

Процедура ДобавитьСтрокуДвижения(ТаблицаДвижений, СтрокаДанных, ЭтоРБ, ОтборСтрок, СчетКорреспондент)
	
	Если ЭтоРБ Тогда
		НоваяСтрока = ТаблицаДвижений.Добавить();
		ЗаполнитьЗначенияПроводки(НоваяСтрока, СтрокаДанных, СчетКорреспондент);
	Иначе
		НоваяСтрока = ПолучитьСтрокуНабора(ТаблицаДвижений, СтрокаДанных, ОтборСтрок);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЗначенияПроводки(НоваяСтрока, СтрокаОС, СчетКорреспондент)
	
	ТЗ = СтрокаОС.Владелец();
	Если ТЗ.Колонки.Найти("Счет") = Неопределено Тогда
		//это перенос движений, есть счет Дт и счет Кт
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаОС);
		Для к = 1 По БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто() Цикл
			НоваяСтрока["СубконтоДт"][СтрокаОС["ВидСубконтоДт"+к]] = СтрокаОС["СубконтоДт"+к];		
			НоваяСтрока["СубконтоКт"][СтрокаОС["ВидСубконтоКт"+к]] = СтрокаОС["СубконтоКт"+к];
		КонецЦикла;	
	Иначе
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаОС.Счет);
		
		ДтКт	= ?(СвойстваСчета.Вид = ВидСчета.Пассивный, "Кт", "Дт");
		к		= ?(СвойстваСчета.Вид = ВидСчета.Пассивный, -1, 1);
		
		НоваяСтрока["Период"			  ] = 												  СтрокаОС.Период;
		НоваяСтрока["Активность"		  ] = 												  СтрокаОС.Активность;
		НоваяСтрока["Счет"			+ ДтКт] = 												  СтрокаОС.Счет;
		НоваяСтрока["Организация"		  ] = 												  СтрокаОС.Организация;
		НоваяСтрока["КПС"			+ ДтКт] = ?(СвойстваСчета.УчетПоКПС						, СтрокаОС.КПС						, Null);
		НоваяСтрока["КЭК"			+ ДтКт] = ?(СвойстваСчета.УчетПоКЭК						, СтрокаОС.КЭК						, Null);
		НоваяСтрока["ИФО"				  ] = 												  СтрокаОС.ИФО;
		НоваяСтрока["Валюта"		+ ДтКт] = ?(СвойстваСчета.Валютный						, СтрокаОС.Валюта					, Null);
		НоваяСтрока["Подразделение"	+ ДтКт] = ?(СвойстваСчета.УчетПоПодразделениям			, СтрокаОС.Подразделение			, Null);
		НоваяСтрока["КФО"				  ] = 												  СтрокаОС.КФО;
		НоваяСтрока["Сумма"				  ] =												  СтрокаОС.Сумма				* к;
		НоваяСтрока["ВалютнаяСумма"	+ ДтКт] = ?(СвойстваСчета.Валютный						, СтрокаОС.ВалютнаяСумма		* к	, Null);
		НоваяСтрока["Количество"	+ ДтКт] = ?(СвойстваСчета.Количественный				, СтрокаОС.Количество			* к	, Null);
		НоваяСтрока["СуммаНеУчитываетсяНУ"] = ?(СвойстваСчета.НалоговыйУчетНеУчитываемых	, СтрокаОС.СуммаНеУчитываетсяНУ	* к	, Null);
		НоваяСтрока["СуммаЕНВД"			  ] = ?(СвойстваСчета.НалоговыйУчетЕНВД				, СтрокаОС.СуммаЕНВД			* к	, Null);
		НоваяСтрока["СуммаНДС"			  ] = ?(СвойстваСчета.НалоговыйУчетНДС				, СтрокаОС.СуммаНДС				* к	, Null);
		
		Для к = 1 По СвойстваСчета.КоличествоСубконто Цикл
			НоваяСтрока["Субконто"+ДтКт][СвойстваСчета["ВидСубконто"+к]] = СтрокаОС["Субконто"+к];
		КонецЦикла;
		
		Если Не СвойстваСчета.Забалансовый Тогда
			
			ДтКтКор = ?(ДтКт = "Дт", "Кт", "Дт");
			
			НоваяСтрока["Счет"+ ДтКтКор] = СчетКорреспондент.Счет;
			
			Если СчетКорреспондент.ЗаполнитьКЭК Тогда
				НоваяСтрока["КЭК" + ДтКтКор] = СчетКорреспондент["КЭК" + ДтКтКор];
			КонецЕсли;
			
			Если СчетКорреспондент.ЗаполнитьКПС Тогда
				НоваяСтрока["КПС" + ДтКтКор] =
					?(ЗначениеЗаполнено(СчетКорреспондент.КПС) И Лев(СвойстваСчета.Код, 1) = "1",
						СчетКорреспондент.КПС, СтрокаОС.КПС);
			КонецЕсли;
			
			Для Каждого СтрокаСубконто Из СчетКорреспондент.ЗначенияСубконто Цикл
				НоваяСтрока["Субконто" + ДтКтКор][СтрокаСубконто.Ключ] = СтрокаСубконто.Значение;
			КонецЦикла;
			
		КонецЕсли;
		
		НоваяСтрока.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяСтрока.СчетДт, НоваяСтрока.СчетКт);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтрокуНабора(НаборЗаписей, Запись, Отбор)
	
	ВозможныДубли = (Отбор.Количество() > 0);
	
	Если ВозможныДубли Тогда
		
		ЗаполнитьЗначенияСвойств(Отбор, Запись);
		Для Каждого СтрокаНабора Из НаборЗаписей Цикл
			СтрокаНайдена = Истина;
			Для Каждого КлючОтбора Из Отбор Цикл
				Если СтрокаНабора[КлючОтбора.Ключ] <> КлючОтбора.Значение Тогда
					СтрокаНайдена = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если СтрокаНайдена Тогда
				Возврат СтрокаНабора;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат НаборЗаписей.Добавить();
	
КонецФункции

Процедура ЗаписатьДокументВводаОстатков(НовыйДокумент, ПараметрыРаздела, Отбор, СпособСвертки = "")
	
	Если ЗначениеЗаполнено(ПараметрыРаздела.РазделУчета) Тогда
		НовыйДокумент.ДополнительныеСвойства.Вставить("РазделУчета", ПараметрыРаздела.РазделУчета);
	КонецЕсли;
	
	НовыйДокумент.ДополнительныеСвойства.Вставить("Дата", ПараметрыРаздела.Параметры.Дата);
	НовыйДокумент.ДополнительныеСвойства.Вставить("Отбор", Отбор);
	НовыйДокумент.ДополнительныеСвойства.Вставить("ДополнительныеПараметры", ПараметрыРаздела.ДополнительныеПараметры);
	
	Попытка
		
		НовыйДокумент.Заполнить("ИзДвиженийДокумента");
		
		НовыйДокумент.Дата = ПараметрыРаздела.Параметры.Дата;
		НовыйДокумент.УстановитьНовыйНомер();
		НовыйДокумент.Комментарий = ПараметрыРаздела.Комментарий;
		НовыйДокумент.Проведен = Ложь;
		
		Если ПараметрыРаздела.Документ = Метаданные.Документы.КорректировкаРегистров Тогда
			Если Отбор.Свойство("Организация") Тогда
				НовыйДокумент.Организация = Отбор.Организация;
			КонецЕсли;
			НовыйДокумент.СпособЗаполнения = НСтр("ru = 'Вручную'");
			НовыйДокумент.ПроизвольнаяДатаДвижений = (СпособСвертки <> "Свернуть");
		КонецЕсли;
		
		УдалитьЗамещаемыеДвижения(НовыйДокумент, ПараметрыРаздела);
		
		ОтключитьМеханизмыОбъекта(НовыйДокумент);
		НовыйДокумент.Записать();
		
	Исключение
		
		ОтразитьВЖурналеРегистрации(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
		ВызватьИсключение;
		
	КонецПопытки;
	
	// Типовую операцию записываем отдельно, не в транзакции с документом,
	// т.к. неудачная попытка записи типовой операции не должна отменять запись документа
	
	Если ЗначениеЗаполнено(ПараметрыРаздела.ТиповаяОперация) Тогда
		БухгалтерскиеОперацииСервер.ЗаписатьДанныеТиповойОперацииОбъекта(НовыйДокумент,
			ПараметрыРаздела.ТиповаяОперация, ПараметрыРаздела.Параметры.ДопРеквизитыТО,,,, Ложь);
	КонецЕсли;
	
	СформироватьСообщениеПрогрессаРаздела(ПараметрыРаздела);
	
КонецПроцедуры

Функция СписокСчетовПоСтроке(СписокСчетов)
	
	ЧастиСтроки = СтрРазделить(СписокСчетов, "|", Ложь);
	
	СтрокаКодыСчетов = СтрЗаменить(СтрЗаменить(ЧастиСтроки[0], " ", ""), Символы.ПС, "");
	МассивСчетов = СтрРазделить(СтрокаКодыСчетов, ",", Ложь);
	
	Если ЧастиСтроки.Количество() > 1 Тогда
		СтрокаСубконто = СтрЗаменить(СтрЗаменить(ЧастиСтроки[1], " ", ""), Символы.ПС, "");
		МассивСубконто = СтрРазделить(СтрокаСубконто, ",", Ложь);
	Иначе
		МассивСубконто = Новый Массив;
	КонецЕсли;
	
	СчетаНужные		= Новый Массив;
	СчетаИсключить	= Новый Массив;
	
	Для Каждого Счет Из МассивСчетов Цикл
		Если Лев(Счет, 1) = "-" Тогда
			СчетаИсключить.Добавить(Сред(Счет, 2));
		Иначе
			СчетаНужные.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Нужные
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код В(&КодНужные)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Ненужные
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код В(&КодНенужные)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|	[Субконто]
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ВТ_Нужные.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТ_Нужные КАК ВТ_Нужные)
	|	И НЕ ЕПСБУ.Ссылка В ИЕРАРХИИ
	|				(ВЫБРАТЬ
	|					ВТ_Ненужные.Ссылка КАК Ссылка
	|				ИЗ
	|					ВТ_Ненужные КАК ВТ_Ненужные)
	|	И НЕ ЕПСБУ.ЭлементГруппа";
	
	Шаблон =
	"ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто%1
	|	ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто%1.Ссылка
	|	И ЕПСБУВидыСубконто%1.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.%2)";
	
	ЧастиСубконто = Новый Массив;
	Для Каждого ИмяСубконто Из МассивСубконто Цикл
		ЧастиСубконто.Добавить(СтрШаблон(Шаблон, ЧастиСубконто.Количество() + 1, ИмяСубконто));
	КонецЦикла;
	
	СтрокаСубконто = СтрСоединить(ЧастиСубконто, Символы.ПС);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[Субконто]", СтрокаСубконто);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("КодНужные"	, СчетаНужные);
	Запрос.УстановитьПараметр("КодНенужные"	, СчетаИсключить);
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Процедура УдалитьЗамещаемыеДвижения(НовыйДокумент, ПараметрыРаздела)
	
	Для Каждого НастройкаРегистра Из ПараметрыРаздела.Регистры Цикл
		Если НастройкаРегистра.ЗамещатьПриЗаписи Тогда
			
			Данные = НовыйДокумент.Движения[НастройкаРегистра.ИмяОбъекта];
			Если Данные.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Данные", Данные);
			Запрос.Текст = ТекстЗапросаЗамещенияДвижений(НастройкаРегистра);
			Результат = Запрос.Выполнить();
			
			ВыборкаПоРегистратору = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПоРегистратору.Следующий() Цикл
				
				НаборЗаписей = РегистрыСведений[НастройкаРегистра.ИмяОбъекта].СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаПоРегистратору.Регистратор);
				НаборЗаписей.Прочитать();
				
				Выборка = ВыборкаПоРегистратору.Выбрать();
				Пока Выборка.Следующий() Цикл
					НаборЗаписей.Удалить(Выборка.НомерСтроки-1);
				КонецЦикла;
				
				ОтключитьМеханизмыОбъекта(НаборЗаписей);
				НаборЗаписей.Записать();
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстЗапросаЗамещенияДвижений(НастройкаРегистра)
	
	Шаблон =
	"ВЫБРАТЬ
	|	[ПоляДанные]
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Данные КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	[ПоляДанные],
	|	Регистр.Регистратор КАК Регистратор,
	|	Регистр.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.[ИмяРегистра] КАК Регистр
	|		ПО [ПоляСвязей]
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки УБЫВ
	|ИТОГИ ПО
	|	Регистратор";
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяРегистра", НастройкаРегистра.ИмяОбъекта);
	
	СписокПолей  = Новый Массив;
	СписокСвязей = Новый Массив;
	Для Каждого Измерение Из НастройкаРегистра.Измерения Цикл
		ИмяПоля = Измерение.Ключ;
		СписокПолей.Добавить("ВТ." + ИмяПоля + " КАК " + ИмяПоля);
		Если ИмяПоля = "Период" И НастройкаРегистра.Периодичность <> "" Тогда
			СписокСвязей.Добавить("(НАЧАЛОПЕРИОДА(ВТ.Период, " + ВРег(НастройкаРегистра.Периодичность) + ") = Регистр.Период)");
		Иначе
			СписокСвязей.Добавить("ВТ." + ИмяПоля + " = " + "Регистр." + ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Параметры.Вставить("ПоляДанные"	, СтрСоединить(СписокПолей , "," + Символы.ПС + "	"));
	Параметры.Вставить("ПоляСвязей"	, СтрСоединить(СписокСвязей, Символы.ПС + "			И "));
	
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, Параметры);
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область Этап_2

Функция СписокТиповДокументовКУдалению() Экспорт
	
	СписокДокументов = Новый Структура;
	
	// Получаем список подситем, объекты которых подлежать свертке
	КорневыеПодсистемы = Новый Массив;
	КорневыеПодсистемы.Добавить(Метаданные.Подсистемы.УчетГосУчрежденийПодсистемы);
	КорневыеПодсистемы.Добавить(Метаданные.Подсистемы.ЭлектронноеВзаимодействие);
	
	МассивПодсистем = Новый Массив;
	Для Каждого КорневаяПодсистема Из КорневыеПодсистемы Цикл
		ДобавитьПодсистемуСПодчиненными(МассивПодсистем, КорневаяПодсистема);
	КонецЦикла;
	
	Для Каждого ТекПодсистема Из МассивПодсистем Цикл
		Для Каждого ТекОбъект Из ТекПодсистема.Состав Цикл
			Если ОбщегоНазначения.ЭтоДокумент(ТекОбъект) Тогда
				СписокДокументов.Вставить(ТекОбъект.Имя, "Пометить");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Переопределяем
	СписокДокументов.Вставить("РегистрацияОбязательствИСведенийПоДоговорам"	, "Не помечать");
	СписокДокументов.Вставить("РегистрацияСведенийОбИмуществе"				, "Не помечать");
	СписокДокументов.Вставить("УниверсальныйРегламентированныйОтчет"		, "Не помечать");
	СписокДокументов.Вставить("ПлатежКонтрагентовГИСГМП"					, "Не помечать");
	СписокДокументов.Вставить("НачислениеКонтрагентамГИСГМП"				, "Не помечать");
	
	СписокДокументов.Вставить("КвитанцияНаОплатуГосуслуг"					, "Не помечать");
	СписокДокументов.Вставить("ПакетНачисленийГИСГМП"						, "Не помечать");
	СписокДокументов.Вставить("НачислениеОтПодведомственного"				, "Не помечать");
	СписокДокументов.Вставить("ПакетНачисленийГИСГМПОтПодведомственного"	, "Не помечать");
	СписокДокументов.Вставить("ПлатежВОплатуГосуслуг"						, "Не помечать");
	СписокДокументов.Вставить("ПлатежПодведомственному"						, "Не помечать");
	//СписокДокументов.Вставить("ВводИсторииКапвложений"						, "Не помечать");
	
	СверткаИнформационнойБазыПереопределяемый.НастроитьСоставСворачиваемыхДокументов(СписокДокументов);
	
	СпДокументов = Новый ТаблицаЗначений;
	СпДокументов.Колонки.Добавить("ИмяДокумента");
	СпДокументов.Колонки.Добавить("ТипДокумента");
	СпДокументов.Колонки.Добавить("ТабличныеЧасти");
	СпДокументов.Колонки.Добавить("Менеджер");
	СпДокументов.Колонки.Добавить("ЕстьКомментарий");
	СпДокументов.Колонки.Добавить("РегистраторРБ");
	
	ЖурналПроводок = Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ;
	
	Для Каждого НастройкаДокумента Из СписокДокументов Цикл
		Если НастройкаДокумента.Значение = "Пометить" Тогда
			
			ИмяДокумента = НастройкаДокумента.Ключ;
			ТипДокумента = Тип("ДокументСсылка." + ИмяДокумента);
			
			МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипДокумента);
			
			ТабличныеЧасти = Новый Массив;
			//Для Каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
			//	ТабличныеЧасти.Добавить(ТабличнаяЧасть.Имя);
			//КонецЦикла;
			
			НоваяСтрока					= СпДокументов.Добавить();
			НоваяСтрока.ИмяДокумента	= ИмяДокумента;
			НоваяСтрока.ТипДокумента	= ТипДокумента;
			НоваяСтрока.ТабличныеЧасти	= ТабличныеЧасти;
			НоваяСтрока.Менеджер		= ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(МетаданныеДокумента.ПолноеИмя());
			НоваяСтрока.ЕстьКомментарий	= (МетаданныеДокумента.Реквизиты.Найти("Комментарий") <> Неопределено);
			НоваяСтрока.РегистраторРБ	= МетаданныеДокумента.Движения.Содержит(ЖурналПроводок);
			
		КонецЕсли;
	КонецЦикла;
	
	СпДокументов.Индексы.Добавить("ТипДокумента");
	
	Возврат СпДокументов;
	
КонецФункции

Функция НастройкиСверткиНеподчиненныхРегистров() Экспорт
	
	ТаблицаНастроек = Новый ТаблицаЗначений;
	
	ТаблицаНастроек.Колонки.Добавить("ТипОбъекта"			, Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("ИмяОбъекта"			, Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("СпособСвертки"		, Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("ДополнительныеПоля"	, Новый ОписаниеТипов("Структура"));
	ТаблицаНастроек.Колонки.Добавить("ПолеОрганизации"		, Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("Условие"				, Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("БудущиеЗаписи"		, Новый ОписаниеТипов("Булево"));
	
	// Всего 139 регистров. Чтобы все здесь не перечислять достаточно добавить настройки
	// только для регистров, у которых способ свертки отличается от "Не сворачивать".
	// Возможные варианты: Не сворачивать, Свернуть, Очистить.
	
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "НастройкаАналитическогоУчетаИмущественныхНалогов"		, "Свернуть", "Организация");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "НастройкаСпособовОтраженияЗарплатыВБухУчете"			, "Свернуть", "Организация");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "НастройкаСтатейФинансированияЗарплата"					, "Свернуть", "Организация");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам"	, "Свернуть", "Организация");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "ПараметрыНачисленийЗаПрочиеУслугиСтудентам"			, "Свернуть");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "ПаспортаТранспортныхСредств"							, "Свернуть", "Организация");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "ПротоколыОтправленныхОтчетов"							, "Свернуть", "Организация");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "РегистрацияЗемельныхУчастков"							, "Свернуть", "Организация");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "РегистрацияТранспортныхСредств"						, "Свернуть", "Организация");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "СведенияКадастровогоУчета"								, "Свернуть", "Организация");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "СостояниеОбъектовУчетаРеестраИмущества"				, "Свернуть", "Организация");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "СостоянияОтправленныхОтчетов"							, "Свернуть", "Организация");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "СтавкаКомпенсацииРодительскойПлаты"					, "Свернуть");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "СтавкиНалогаНаПрибыльДляВсехОрганизаций"				, "Свернуть");
	ДобавитьНастройкуРегистраН(ТаблицаНастроек, "ЧисленностьДовольствующихся"							, "Свернуть", "Организация");
	
	СверткаИнформационнойБазыПереопределяемый.ДополнитьНастройкиСверткиНеподчиненныхРегистров(ТаблицаНастроек);
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Процедура УдалитьДанные(Параметры)
	
	СписокТиповДокументов = СписокТиповДокументовКУдалению();
	
	Если СписокТиповДокументов.Количество() > 0 Тогда
		ПометитьНаУдалениеДокументыДоДатыСвертки(Параметры, СписокТиповДокументов);
		// Документы до даты свертки помечены на удаление. Если есть проводки до даты свертки,
		// то они сформированы документами после даты свертки. Эти документы помечаем на удаление.
		ПометитьНаУдалениеДокументыПослеДатыСвертки(Параметры, СписокТиповДокументов);
	КонецЕсли;
	
	УдалитьДвиженияДокументаРегистрацияОбязательствИСведенийПоДоговорам(Параметры);
	
	УстановитьПризнакИспользованияДокументовВОстатках();
	
	ПометитьНаУдалениеЗадания();
	
	ПометитьНаУдалениеПрисоединенныеФайлы();
	
	ПометитьНаУдалениеУстаревшиеСчета(Параметры);
	
	СвернутьНеподчиненныеРегистры(Параметры);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПометитьНаУдалениеДанныеПриСверткеИнформационнойБазы(
			Параметры.Дата, ИмяСобытияЖурналаРегистрации());
	КонецЕсли;
	
КонецПроцедуры

Процедура ПометитьНаУдалениеДокументыДоДатыСвертки(Параметры, СписокТиповДокументов)
	
	СообщениеПрогресса(НСтр("ru = 'Получение списка документов...'"));
	
	Запрос = Новый Запрос;
	ТекстыЗапросов = Новый Массив;
	Шаблон =
	"ВЫБРАТЬ
	|	Док.Ссылка %1,
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА Док.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ %2
	|	%3
	|ИЗ
	|	Документ.%4 КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = Док.Ссылка)
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|					ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|				ТОГДА Док.Дата
	|			ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|		КОНЕЦ <= &Дата
	|	%5
	|	%6";
	
	Если Параметры.Организации = Неопределено Тогда
		Условие = "";
	Иначе
		Условие = "И Док.Организация В (&Организации)";
		Запрос.УстановитьПараметр("Организации", Параметры.Организации);
	КонецЕсли;
	
	ЕстьПриказыОбразования = Ложь;
	
	Для Каждого СтрокаДокумента Из СписокТиповДокументов Цикл
		Если ТекстыЗапросов.Количество() = 0 Тогда
			Псевдоним_1 = "КАК Ссылка";
			Псевдоним_2 = "КАК Дата";
			ТекстПоместить = "ПОМЕСТИТЬ ВТ";
		Иначе 
			Псевдоним_1 = "";
			Псевдоним_2 = "";
			ТекстПоместить = "";
		КонецЕсли;
		Если СтрокаДокумента.ИмяДокумента = "СообщениеЭДО" Тогда
			пУсловие = СтрЗаменить(Условие, "Организация", "ЭлектронныйДокумент.Организация");
		Иначе
			пУсловие = Условие;
		КонецЕсли;
		Если СтрокаДокумента.ИмяДокумента = "ПриказОбразование" Тогда
			УсловиеПриказы = "И Не Док.Ссылка В (&ПриказыОбразованияБезУдаления)";
			ЕстьПриказыОбразования = Истина;
		Иначе
			УсловиеПриказы = "";
		КонецЕсли;
		ТекстыЗапросов.Добавить(СтрШаблон(Шаблон, Псевдоним_1, Псевдоним_2, ТекстПоместить, СтрокаДокумента.ИмяДокумента, пУсловие, УсловиеПриказы));
	КонецЦикла;
	
	ТекстОбъединитьВсе =
	"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|";
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ТекстОбъединитьВсе) + ";" + Символы.ПС +
	"ВЫБРАТЬ
	|	ВТ.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	НЕ ВТ.Ссылка В (&ДокументыВводаОстатков)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ.Дата УБЫВ";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Дата", Параметры.Дата);
	Запрос.УстановитьПараметр("ДокументыВводаОстатков", ПолучитьМассивДокументовВводаОстатков(Параметры.Дата));
	Если ЕстьПриказыОбразования Тогда
		Запрос.УстановитьПараметр("ПриказыОбразованияБезУдаления", ПриказыОбразованияБезУдаления(Параметры.Дата, Параметры.Организации));
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КоличествоДокументов = Выборка.Количество();
	
	Если КоличествоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Шаблон = НСтр("ru = 'Выполнено: %1 из %2...'");
	Шаблон = СтрЗаменить(Шаблон, "%2", КоличествоДокументов);
	Сч = 0;
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			ПометитьДокумент(Выборка.Ссылка, Параметры, СписокТиповДокументов);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ОтразитьВЖурналеРегистрации(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
			ВызватьИсключение;
		КонецПопытки;
		
		Сч = Сч + 1;
		ТекстСообщения = СтрЗаменить(Шаблон, "%1", Сч);
		СообщениеПрогресса(ТекстСообщения);
		
	КонецЦикла;
	
	Комментарий = НСтр("ru = 'Документы до даты свертки помечены на удаление: %1 шт.'");
	Комментарий = СтрЗаменить(Комментарий, "%1", КоличествоДокументов);
	ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация);
	
КонецПроцедуры

Процедура ПометитьНаУдалениеДокументыПослеДатыСвертки(Параметры, СписокТиповДокументов)
	
	СообщениеПрогресса(НСтр("ru = 'Получение списка документов...'"));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Параметры.Дата);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУ.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Активность
	|	И ЖурналПроводокЕПСБУ.Период <= &Период
	|	И &Условие1
	|	И &Условие2
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУ.Регистратор";
	
	Если Параметры.Организации = Неопределено Тогда
		Условие1 = "";
	Иначе
		Условие1 = "И ЖурналПроводокЕПСБУ.Организация В (&Организации)";
		Запрос.УстановитьПараметр("Организации", Параметры.Организации);
	КонецЕсли;
	
	УсловияДок = Новый Массив;
	Для Каждого СтрокаДокумента Из СписокТиповДокументов Цикл
		Если СтрокаДокумента.РегистраторРБ Тогда
			УсловияДок.Добавить("ЖурналПроводокЕПСБУ.Регистратор ССЫЛКА Документ." + СтрокаДокумента.ИмяДокумента);
		КонецЕсли;
	КонецЦикла;
	Условие2 = "И (" + СтрСоединить(УсловияДок, " ИЛИ ") + ")";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &Условие1", Условие1);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &Условие2", Условие2);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КоличествоДокументов = Выборка.Количество();
	
	Если КоличествоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Шаблон = НСтр("ru = 'Выполнено: %1 из %2...'");
	Шаблон = СтрЗаменить(Шаблон, "%2", КоличествоДокументов);
	Сч = 0;
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			ПометитьДокумент(Выборка.Регистратор, Параметры, СписокТиповДокументов);
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ОтразитьВЖурналеРегистрации(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
			ВызватьИсключение;
			
		КонецПопытки;
		
		Сч = Сч + 1;
		ТекстСообщения = СтрЗаменить(Шаблон, "%1", Сч);
		СообщениеПрогресса(ТекстСообщения);
		
	КонецЦикла;
	
	Комментарий = НСтр("ru = 'Документы после даты свертки помечены на удаление: %1 шт.'");
	Комментарий = СтрЗаменить(Комментарий, "%1", КоличествоДокументов);
	ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация);
	
КонецПроцедуры

Процедура УстановитьПризнакИспользованияДокументовВОстатках()
	
	СообщениеПрогресса(НСтр("ru = 'Выделяются документы, испольуемые в остатках...'"));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВводНачальныхОстатковНДС.СчетФактура КАК Документ
	|ПОМЕСТИТЬ ВТ_Док
	|ИЗ
	|	Документ.ВводНачальныхОстатков.НДС КАК ВводНачальныхОстатковНДС
	|ГДЕ
	|	НЕ ВводНачальныхОстатковНДС.Ссылка.ПометкаУдаления
	|	И ВводНачальныхОстатковНДС.Ссылка.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.НДС)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВводНачальныхОстатковНДС.ДокументКорректировки
	|ИЗ
	|	Документ.ВводНачальныхОстатков.НДС КАК ВводНачальныхОстатковНДС
	|ГДЕ
	|	НЕ ВводНачальныхОстатковНДС.Ссылка.ПометкаУдаления
	|	И ВводНачальныхОстатковНДС.Ссылка.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.НДС)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Док.Документ КАК Документ
	|ИЗ
	|	ВТ_Док КАК ВТ_Док
	|ГДЕ
	|	(ВТ_Док.Документ.ПометкаУдаления
	|			ИЛИ НЕ ВТ_Док.Документ.ВводНачальныхОстатков)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КоличествоДокументов = Выборка.Количество();
	
	Если КоличествоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Шаблон = НСтр("ru = 'Выделяются документы, испольуемые в остатках (найдено: %1)...'");
	ТекстСообщения = СтрЗаменить(Шаблон, "%1", КоличествоДокументов);
	СообщениеПрогресса(ТекстСообщения);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			ДокументОбъект = Выборка.Документ.ПолучитьОбъект();
			ДокументОбъект.ПометкаУдаления = Ложь;
			ДокументОбъект.ВводНачальныхОстатков = Истина;
			ОтключитьМеханизмыОбъекта(ДокументОбъект);
			
			ДокументОбъект.Записать();
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ОтразитьВЖурналеРегистрации(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПометитьНаУдалениеЗадания()
	
	ТекстСообщения = НСтр("ru = 'Пометка на удаление задач и бизнес-процесов...'");
	СообщениеПрогресса(ТекстСообщения);
	
	// Пометка задач
	
	ТипыПредмета	= Метаданные.Задачи.ЗадачаИсполнителя.Реквизиты.Предмет.Тип.Типы();
	ИмяТаблицы		= "Задача.ЗадачаИсполнителя";
	Сообщение		= НСтр("ru = 'Помечено на удаление задач: %1 шт.'");
	
	ПолучитьПометитьЗадания(ТипыПредмета, ИмяТаблицы, Сообщение);
	
	// Пометка заданий
	
	ТипыПредмета	= Метаданные.БизнесПроцессы.Задание.Реквизиты.Предмет.Тип.Типы();
	ИмяТаблицы		= "БизнесПроцесс.Задание";
	Сообщение		= НСтр("ru = 'Помечено на удаление бизнес-процесов: %1 шт.'");
	
	ПолучитьПометитьЗадания(ТипыПредмета, ИмяТаблицы, Сообщение);
	
КонецПроцедуры

Процедура ПолучитьПометитьЗадания(ТипыПредмета, ИмяТаблицы, Сообщение)
	
	Если ТипыПредмета.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Шаблон = "ВЫБРАТЬ Таблица.Ссылка %1 ИЗ %2 КАК Таблица ГДЕ Таблица.ПометкаУдаления";
	ЧастьПервогоЗапроса = "КАК Ссылка ПОМЕСТИТЬ ВТ_Предметы";
	
	СписокПодзапросов = Новый Массив;
	Для Каждого ТипПредмета Из ТипыПредмета Цикл
		мОбъект = Метаданные.НайтиПоТипу(ТипПредмета);
		Если ПравоДоступа("Чтение", мОбъект) Тогда
			Подзапрос = СтрШаблон(Шаблон, ЧастьПервогоЗапроса, мОбъект.ПолноеИмя());
			СписокПодзапросов.Добавить(Подзапрос);
			ЧастьПервогоЗапроса = "";
		КонецЕсли;
	КонецЦикла;
	
	ШаблонТаблицы =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.Ссылка КАК Ссылка
	|ИЗ
	|	%1 КАК Таблица
	|ГДЕ
	|	Таблица.Предмет В
	|			(ВЫБРАТЬ
	|				ВТ.Ссылка
	|			ИЗ
	|				ВТ_Предметы КАК ВТ)
	|	И НЕ Таблица.ПометкаУдаления";
	
	ТекстЗапроса = СтрСоединить(СписокПодзапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС)
		+ ";" + Символы.ПС + СтрШаблон(ШаблонТаблицы, ИмяТаблицы);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ТекОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ТекОбъект.ПометкаУдаления = Истина;
		ОтключитьМеханизмыОбъекта(ТекОбъект);
		ТекОбъект.Записать();
	КонецЦикла;
	
	Комментарий = СтрШаблон(Сообщение, Формат(Выборка.Количество(), "ЧН=0"));
	ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация);
	
КонецПроцедуры

Процедура ПометитьНаУдалениеПрисоединенныеФайлы()
	
	ТекстСообщения = НСтр("ru = 'Пометка на удаление присоединенных файлов...'");
	СообщениеПрогресса(ТекстСообщения);
	
	ЧастиТекста = Новый Массив;
	
	ТекстОбъединитьВсе =
	"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|";
	
	// Справочник Файлы
	
	Шаблон = "ВЫБРАТЬ Таблица.Ссылка %1 ИЗ %2 КАК Таблица ГДЕ Таблица.ПометкаУдаления";
	ЧастьПервогоЗапроса = "КАК Ссылка ПОМЕСТИТЬ ВТ_Владельцы";
	
	ТипыВладельцев = Метаданные.ОпределяемыеТипы.ВладелецФайлов.Тип.Типы();
	
	СписокПодзапросов = Новый Массив;
	Для Каждого ТипВладельца Из ТипыВладельцев Цикл
		мОбъект = Метаданные.НайтиПоТипу(ТипВладельца);
		Если ПравоДоступа("Чтение", мОбъект) Тогда
			Подзапрос = СтрШаблон(Шаблон, ЧастьПервогоЗапроса, мОбъект.ПолноеИмя());
			СписокПодзапросов.Добавить(Подзапрос);
			ЧастьПервогоЗапроса = "";
		КонецЕсли;
	КонецЦикла;
	
	Если СписокПодзапросов.Количество() > 0 Тогда
		
		ШаблонТаблицы =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Файлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|ГДЕ
		|	Файлы.ВладелецФайла В
		|			(ВЫБРАТЬ
		|				ВТ.Ссылка
		|			ИЗ
		|				ВТ_Владельцы КАК ВТ)
		|	И НЕ Файлы.ПометкаУдаления";
		
		ТекстПодЗапроса = СтрСоединить(СписокПодзапросов, ТекстОбъединитьВсе) + ";" + Символы.ПС + ШаблонТаблицы;
		ЧастиТекста.Добавить(ТекстПодЗапроса);
		
	КонецЕсли;
	
	// Справочники ..ПрисоединенныеФайлы
	
	СписокСправочников = Новый Массив;
	
	СтрПоиска = "ПрисоединенныеФайлы";
	ДлинаСтрПоиска = СтрДлина(СтрПоиска);
	
	Для Каждого мСправочник Из Метаданные.Справочники Цикл
		Если Прав(мСправочник.Имя, ДлинаСтрПоиска) = СтрПоиска Тогда
			Если ПравоДоступа("Изменение", мСправочник) Тогда
				СписокСправочников.Добавить(мСправочник.Имя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ПодЗапрос =
	"ВЫБРАТЬ
	|	ПрисоединенныеФайлы.Ссылка
	|ИЗ
	|	Справочник.%1 КАК ПрисоединенныеФайлы
	|ГДЕ
	|	ПрисоединенныеФайлы.ВладелецФайла.ПометкаУдаления
	|	И НЕ ПрисоединенныеФайлы.ПометкаУдаления";
	
	Для Каждого ИмяСправочника Из СписокСправочников Цикл
		ЧастиТекста.Добавить(СтрЗаменить(ПодЗапрос, "%1", ИмяСправочника));
	КонецЦикла;
	
	Если ЧастиТекста.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединить(ЧастиТекста, ТекстОбъединитьВсе);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ФайлОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ФайлОбъект.ПометкаУдаления = Истина;
		ОтключитьМеханизмыОбъекта(ФайлОбъект);
		ФайлОбъект.Записать();
	КонецЦикла;
	
	Шаблон = НСтр("ru = 'Помечено на удаление присоединенных файлов: %1 шт.'");
	Комментарий = СтрЗаменить(Шаблон, "%1", Формат(Выборка.Количество(), "ЧН=0"));
	ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация);
	
КонецПроцедуры

Процедура ПометитьНаУдалениеУстаревшиеСчета(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Параметры.Дата);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.ДатаОкончанияДействия <> ДАТАВРЕМЯ(1, 1, 1)
	|	И ЕПСБУ.ДатаОкончанияДействия <= &Период
	|	И НЕ ЕПСБУ.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СчетОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СчетОбъект.ПометкаУдаления = Истина;
		ОтключитьМеханизмыОбъекта(СчетОбъект);
		СчетОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПометитьДокумент(Документ, Параметры, СписокТиповДокументов)
	
	// Читаем данные
	
	СведенияДокумента = СписокТиповДокументов.Найти(ТипЗнч(Документ), "ТипДокумента");
	
	ДокументОбъект = Документ.ПолучитьОбъект();
	
	Если ДокументОбъект = Неопределено Тогда // Если ссылка битая, то объекта нет. Создадим его
		ДокументОбъект = СведенияДокумента.Менеджер.СоздатьДокумент();
		ДокументОбъект.УстановитьСсылкуНового(Документ);
		ДокументОбъект.Дата = Параметры.Дата;
		Если СведенияДокумента.ЕстьКомментарий Тогда
			ДокументОбъект.Комментарий = НСтр("ru = 'Документ создан при свертке базы'");
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект.Проведен = Ложь;
	ДокументОбъект.ПометкаУдаления = Истина;
	ОтключитьМеханизмыОбъекта(ДокументОбъект);
	
	//Для Каждого ТабЧасть Из СведенияДокумента.ТабличныеЧасти Цикл
	//	ДокументОбъект[ТабЧасть].Очистить();
	//КонецЦикла;
	
	Для Каждого НаборЗаписей Из ДокументОбъект.Движения Цикл
		НаборЗаписей.Записывать = Истина;
		ОтключитьМеханизмыОбъекта(НаборЗаписей);
	КонецЦикла;
	
	ОперацияДокумента = РегистрыСведений.ОперацииДокументов.СоздатьНаборЗаписей();
	ОперацияДокумента.Отбор.Документ.Установить(Документ);
	ОперацияДокумента.Прочитать();
	
	ОтключитьМеханизмыОбъекта(ОперацияДокумента);
	
	Для Каждого Запись Из ОперацияДокумента Цикл
		Запись.ЕстьПроводки = Ложь;
		Запись.РучнаяКорректировка = Ложь;
	КонецЦикла;
	
	// Пишем данные
	
	ДокументОбъект.Записать();
	ОперацияДокумента.Записать();
	
КонецПроцедуры

Процедура СвернутьНеподчиненныеРегистры(Параметры)
	
	ШаблонСообщения = НСтр("ru = 'Свертка регистра ""%1""...'");
	
	ТаблицаНастроек = НастройкиСверткиНеподчиненныхРегистров();
	
	НуженОтборПоОрганизации = (Параметры.Организации <> Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"			, Параметры.Дата);
	Запрос.УстановитьПараметр("ГраницаОстатков"	, Параметры.ГраницаОстатков);
	Запрос.УстановитьПараметр("Организации"		, Параметры.Организации);
	
	Для Каждого Настройка Из ТаблицаНастроек Цикл
		
		Если Настройка.СпособСвертки = "Не сворачивать" Или НуженОтборПоОрганизации И Настройка.ПолеОрганизации = "" Тогда
			Продолжить;
		КонецЕсли;
		
		СинонимРегистра = Метаданные.РегистрыСведений[Настройка.ИмяОбъекта].Синоним;
		
		ТекстСообщения = СтрЗаменить(ШаблонСообщения, "%1", СинонимРегистра);
		СообщениеПрогресса(ТекстСообщения);
		
		ЧастиЗапроса = Новый Массив;
		
		Если Настройка.СпособСвертки = "Свернуть" Тогда
			// Получаем записи по выбранным организациям (или по всем, если нет отбора)
			ТекстЗапроса = ПолучитьТекстТаблицы(Настройка, НуженОтборПоОрганизации);
			ЧастиЗапроса.Добавить(ТекстЗапроса);
		КонецЕсли;
		
		Если НуженОтборПоОрганизации Тогда
			// Получаем записи по остальным организациям (если есть отбор по организациям)
			Настройка.СпособСвертки = "Перенести";
			ТекстЗапроса = ПолучитьТекстТаблицы(Настройка, НуженОтборПоОрганизации);
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "В (&Организации)", "НЕ В (&Организации)");
			ЧастиЗапроса.Добавить(ТекстЗапроса);
		КонецЕсли;
		
		// Получаем записи после даты свертки по всем организациям
		Настройка.СпособСвертки = "Перенести";
		ТекстЗапроса = ПолучитьТекстТаблицы(Настройка, Ложь);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<= &Период", "> &Период");
		ЧастиЗапроса.Добавить(ТекстЗапроса);
		
		Разделитель = "
		|ОБЪЕДИНИТЬ ВСЕ
		|";
		
		Запрос.Текст = СтрСоединить(ЧастиЗапроса, Разделитель);
		Результат = Запрос.Выполнить().Выгрузить();
		
		НаборЗаписей = РегистрыСведений[Настройка.ИмяОбъекта].СоздатьНаборЗаписей();
		НаборЗаписей.Загрузить(Результат);
		ОтключитьМеханизмыОбъекта(НаборЗаписей);
		НаборЗаписей.Записать();
		
		ЕстьЗаписи = (Результат.Количество() > 0);
		СинонимРегистра = Метаданные.РегистрыСведений[Настройка.ИмяОбъекта].Синоним;
		Если Настройка.СпособСвертки = "Очистить" Тогда
			Комментарий = НСтр("ru = 'Регистр ""%1"" очищен'");
		ИначеЕсли ЕстьЗаписи Тогда
			Комментарий = НСтр("ru = 'Регистр ""%1"" свернут'");
		Иначе
			Комментарий = НСтр("ru = 'Регистр ""%1"" пустой'");
		КонецЕсли;
		Комментарий = СтрЗаменить(Комментарий, "%1", СинонимРегистра);
		ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьНастройкуРегистраН(ТаблицаНастроек, ИмяОбъекта, СпособСвертки, ПолеОрганизации = "") Экспорт
	
	НастройкаРегистра					= ТаблицаНастроек.Добавить();
	НастройкаРегистра.ТипОбъекта		= "РегистрСведений";
	НастройкаРегистра.ИмяОбъекта		= ИмяОбъекта;
	НастройкаРегистра.СпособСвертки		= СпособСвертки;
	НастройкаРегистра.ПолеОрганизации	= ПолеОрганизации;
	
КонецПроцедуры

Процедура ДобавитьПодсистемуСПодчиненными(МассивПодсистем, ТекущаяПодсистема)
	
	МассивПодсистем.Добавить(ТекущаяПодсистема);
	
	Для Каждого ПодчиненнаяПодсистема Из ТекущаяПодсистема.Подсистемы Цикл
		ДобавитьПодсистемуСПодчиненными(МассивПодсистем, ПодчиненнаяПодсистема);
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьДвиженияДокументаРегистрацияОбязательствИСведенийПоДоговорам(Параметры)
	
	//необходимо удалить движения по регистрам, кроме РС: ПланФинансированияОбязательств и СрокиИсполненияИСуммыОбязательств
	//то есть сейчас надо удалять по РБ и РН:
	//1) когда дата документа меньше даты свертки - такие движения перенесутся
	//2) когда дата документа больше даты свертки, а движения меньше - часть движений перенесется, и их надо удалить из исходного
	
	Шаблон = НСтр("ru = 'Удаление движений документа ""%1""...'");
	ТекстСообщения = СтрЗаменить(Шаблон, "%1", Метаданные.Документы.РегистрацияОбязательствИСведенийПоДоговорам.Синоним);
	СообщениеПрогресса(ТекстСообщения);
	
	ОчищаемыеРегистры = Новый Массив;
	ОчищаемыеРегистры.Добавить("ОплатаОтПокупателейДебиторов");
	ОчищаемыеРегистры.Добавить("ОплатаПоставщикамКредиторам");
	ОчищаемыеРегистры.Добавить("ИсполнениеДоговоровСПокупателями");
	ОчищаемыеРегистры.Добавить("ИсполнениеОбязательствПоставщиками");
	ОчищаемыеРегистры.Добавить("ИсполнениеОбязательствПоставщиками");
	ОчищаемыеРегистры.Добавить("ЖурналПроводокЕПСБУ");
	
	ВидРН = "РегистрНакопления";
	ВидРБ = "РегистрБухгалтерии";
	Для Каждого ИмяРегистра Из ОчищаемыеРегистры Цикл
		
		Если ИмяРегистра = "ЖурналПроводокЕПСБУ" Тогда
			ВидРегистра = ВидРБ;	
		Иначе
			ВидРегистра = ВидРН;
		КонецЕсли;
		
		//1) когда дата документа меньше даты свертки - такие движения по РН перенесутся как остатки или на другой регистратор, если дата движений больше
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Дата", Параметры.Дата);
		Запрос.УстановитьПараметр("Организации", Параметры.Организации);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Документ.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РегистрацияОбязательствИСведенийПоДоговорам КАК Документ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ "+ВидРегистра+"."+ИмяРегистра+" КАК ТТ
		|		ПО Документ.Ссылка = ТТ.Регистратор
		|			И (ТТ.НомерСтроки = 1)
		|ГДЕ
		|	Документ.Дата <= &Дата
		|	И Документ.Организация В(&Организации)";
		
		Если Параметры.Организации = Неопределено Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Документ.Организация В(&Организации)", "");
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НачатьТранзакцию();
			
			Попытка
				Если ВидРегистра = ВидРБ Тогда
					
					НаборЗаписей = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Ссылка);
					ОтключитьМеханизмыОбъекта(НаборЗаписей);
					НаборЗаписей.Записать();
					
					ОперацияДокумента = РегистрыСведений.ОперацииДокументов.СоздатьНаборЗаписей();
					ОперацияДокумента.Отбор.Документ.Установить(Выборка.Ссылка);
					ОтключитьМеханизмыОбъекта(ОперацияДокумента);
					ОперацияДокумента.Записать();
					
					ДополнительныеРеквизиты = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
					ДополнительныеРеквизиты.Отбор.Объект.Установить(Выборка.Ссылка);
					ОтключитьМеханизмыОбъекта(ДополнительныеРеквизиты);
					ДополнительныеРеквизиты.Записать();
					
				Иначе
					
					НаборЗаписей = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Ссылка);
					ОтключитьМеханизмыОбъекта(НаборЗаписей);
					НаборЗаписей.Записать();
									
				КонецЕсли;
				
				ЗафиксироватьТранзакцию();
			Исключение
				
				ОтменитьТранзакцию();
				ОтразитьВЖурналеРегистрации(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
				ВызватьИсключение;
				
			КонецПопытки;
			
		КонецЦикла;
		
		//2) когда дата документа больше даты свертки, а движения меньше - часть движений перенесется, и их надо удалить из исходного
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Дата", Параметры.Дата);
		Запрос.УстановитьПараметр("Организации", Параметры.Организации);
		Запрос.Текст =
		"ВЫБРАТЬ Различные
		|	ТТ.Регистратор КАК Ссылка
		|ИЗ
		|	"+ВидРегистра+"."+ИмяРегистра+" КАК ТТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РегистрацияОбязательствИСведенийПоДоговорам КАК Документ
		|		ПО Документ.Ссылка = ТТ.Регистратор
		|ГДЕ
		|	Документ.Дата > &Дата
		|	И ТТ.Период <= &Дата
		|	И Документ.Организация В(&Организации)";
		
		Если Параметры.Организации = Неопределено Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Документ.Организация В(&Организации)", "");
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НачатьТранзакцию();
			
			Попытка
				ТребуетсяЗаписьОперацииДокументов = Ложь;
				Если ВидРегистра = ВидРБ Тогда
					НаборЗаписей = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();	
				Иначе
					НаборЗаписей = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
				КонецЕсли;
				
				НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Ссылка);
				
				НаборЗаписей.Прочитать();
					
				НомерТекущейЗаписи = 0;
				
				Пока НомерТекущейЗаписи < НаборЗаписей.Количество() Цикл
					Если (НаборЗаписей[НомерТекущейЗаписи].Период <= Параметры.Дата) Тогда
						НаборЗаписей.Удалить(НомерТекущейЗаписи);
					Иначе
						НомерТекущейЗаписи = НомерТекущейЗаписи + 1;
					КонецЕсли;
				КонецЦикла;
													
				ОтключитьМеханизмыОбъекта(НаборЗаписей);
				НаборЗаписей.Записать();
				
				Если ТребуетсяЗаписьОперацииДокументов Тогда
					//Нужно установить в РС ОперацииДокументов признак РучнойКорректировки
					ЗаписьОперацииДокументов = РегистрыСведений.ОперацииДокументов.СоздатьМенеджерЗаписи();
					ЗаписьОперацииДокументов.Документ = Выборка.Ссылка;
					ЗаписьОперацииДокументов.Прочитать();
					Если ЗаписьОперацииДокументов.Выбран() Тогда
						НаборЗаписейОперацииДокументов = РегистрыСведений.ОперацииДокументов.СоздатьНаборЗаписей();
						НаборЗаписейОперацииДокументов.Отбор.Документ.Значение = Выборка.Ссылка;
						НаборЗаписейОперацииДокументов.Отбор.Документ.Использование = Истина;
						ЗаписьНабора = НаборЗаписейОперацииДокументов.Добавить();
						ЗаполнитьЗначенияСвойств(ЗаписьНабора,ЗаписьОперацииДокументов);						
						ЗаписьНабора.РучнаяКорректировка = Истина;
						ОтключитьМеханизмыОбъекта(НаборЗаписейОперацииДокументов);
						НаборЗаписейОперацииДокументов.Записать();
					КонецЕсли;
				КонецЕсли;
								
				ЗафиксироватьТранзакцию();
				
			Исключение
				
				ОтменитьТранзакцию();
				ОтразитьВЖурналеРегистрации(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
				ВызватьИсключение;
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры

Функция ПриказыОбразованияБезУдаления(Дата, Организации = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ПрочиеУслуги.Регистратор КАК Документ.ПриказОбразование) КАК ДокументПриказ
	|ИЗ
	|	РегистрСведений.СведенияОПрочихУслугахСтудентам КАК ПрочиеУслуги
	|ГДЕ
	|	ПрочиеУслуги.Регистратор ССЫЛКА Документ.ПриказОбразование
	|	И ВЫРАЗИТЬ(ПрочиеУслуги.Регистратор КАК Документ.ПриказОбразование).Дата <= &Дата
	|	И &Организации";
	Запрос.УстановитьПараметр("Дата", Дата);
	СписокОрганизаций = Истина;
	Если Организации <> Неопределено Тогда
		СтрокаЗамены = "ВЫРАЗИТЬ(ПрочиеУслуги.Регистратор КАК Документ.ПриказОбразование).Организация В (&Организации)";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Организации", СтрокаЗамены);
		СписокОрганизаций = Организации;
	КонецЕсли;
	Запрос.УстановитьПараметр("Организации", СписокОрганизаций);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	СписокПриказов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		СписокПриказов.Добавить(Выборка.ДокументПриказ);
	КонецЦикла;
	
	Возврат СписокПриказов;
	
КонецФункции

#КонецОбласти

#Область Этап_3

Процедура ПровестиДокументыВводаОстатков(Параметры)
	
	МассивДокументов = ПолучитьМассивДокументовВводаОстатков(Параметры.Дата);
	КоличествоДокументов = МассивДокументов.Количество();
	
	ТипКорректировка = Тип("ДокументСсылка.КорректировкаРегистров");
	
	ШаблонСообщения = НСтр("ru = 'Выполнено: %1 из %2...'");
	ШаблонСообщения = СтрЗаменить(ШаблонСообщения, "%2", КоличествоДокументов);
	Сч = 0;
	
	Для Каждого Документ Из МассивДокументов Цикл
		
		НачатьТранзакцию();
		
		Попытка
			
			// Читаем документ с движениями, и типовую операцию
			
			ДокументОбъект = Документ.ПолучитьОбъект();
			ДокументОбъект.Проведен = Истина;
			ОтключитьМеханизмыОбъекта(ДокументОбъект);
			
			Если ТипЗнч(Документ) = ТипКорректировка Тогда
				// Заменяем комментарий в корректировке, т.к. в документе признак Проведен всегда Ложь,
				// и комментарий является ключевым полем, разделяющий документы, созданные при текущей свертке 
				// от ранее созданных.
				ТекстДо		= НСтр("ru='Сформирован обработкой свертки базы'");
				ТекстПосле	= НСтр("ru='Создан обработкой свертки базы'");
				ДокументОбъект.Комментарий = СтрЗаменить(ДокументОбъект.Комментарий, ТекстДо, ТекстПосле);
			КонецЕсли;
			
			Для Каждого ТаблицаДвижений Из ДокументОбъект.Движения Цикл
				
				ТаблицаДвижений.Прочитать();
				ТаблицаДвижений.УстановитьАктивность(Истина);
				ТаблицаДвижений.Записывать = Истина;
				ОтключитьМеханизмыОбъекта(ТаблицаДвижений);
				
			КонецЦикла;
			
			ОперацияДокумента = РегистрыСведений.ОперацииДокументов.СоздатьНаборЗаписей();
			ОперацияДокумента.Отбор.Документ.Установить(Документ);
			ОперацияДокумента.Прочитать();
			
			
			// Записываем документ с движениями
			
			ДокументОбъект.Записать();
			
			Для Каждого Запись Из ОперацияДокумента Цикл
				Запись.ЕстьПроводки = (ДокументОбъект.Движения["ЖурналПроводокЕПСБУ"].Количество() > 0);
			КонецЦикла;
			
			ОтключитьМеханизмыОбъекта(ОперацияДокумента);
			ОперацияДокумента.Записать();
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ОтразитьВЖурналеРегистрации(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
			ВызватьИсключение;
			
		КонецПопытки;
		
		Сч = Сч + 1;
		ТекстСообщения = СтрЗаменить(ШаблонСообщения, "%1", Сч);
		СообщениеПрогресса(ТекстСообщения);
		
	КонецЦикла;
	
	Комментарий = НСтр("ru = 'Документы ввода остатков проведены: %1 шт.'");
	Комментарий = СтрЗаменить(Комментарий, "%1", КоличествоДокументов);
	ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация);
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

Функция ИмяСобытияЖурналаРегистрации() Экспорт
	
	Возврат НСтр("ru = 'Свертка информационной базы'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	
КонецФункции

Процедура ОтразитьВЖурналеРегистрации(Комментарий, Уровень)
	
	ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), Уровень,,, Комментарий);
	
КонецПроцедуры

Процедура СообщениеПрогресса(Текст)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "#Прогресс#" + Текст;
	Сообщение.Сообщить();
	
КонецПроцедуры

Процедура УстановитьИспользованиеИтогов(Признак)
	
	Текст = ?(Признак,
		НСтр("ru = 'Выполняется расчет итогов...'"),
		НСтр("ru = 'Выполняется отключение расчета итогов...'"));
	СообщениеПрогресса(Текст);
	
	ТаблицаРегистров = Новый ТаблицаЗначений;
	ТаблицаРегистров.Колонки.Добавить("Тип");
	ТаблицаРегистров.Колонки.Добавить("Имя");
	
	ТаблицаНастроек = ТаблицаНастроекСвертки();
	Для Каждого СтрокаНастроек Из ТаблицаНастроек Цикл
		Для Каждого СтрокаРегистра Из СтрокаНастроек.Регистры Цикл
			Если СтрокаРегистра.СпособСвертки <> "Не сворачивать" Тогда
				НоваяСтрока = ТаблицаРегистров.Добавить();
				НоваяСтрока.Тип = СтрокаРегистра.ТипОбъекта;
				НоваяСтрока.Имя = СтрокаРегистра.ИмяОбъекта;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаНастроек = НастройкиСверткиНеподчиненныхРегистров();
	Для Каждого СтрокаРегистра Из ТаблицаНастроек Цикл
		Если СтрокаРегистра.СпособСвертки <> "Не сворачивать" Тогда
			НоваяСтрока = ТаблицаРегистров.Добавить();
			НоваяСтрока.Тип = СтрокаРегистра.ТипОбъекта;
			НоваяСтрока.Имя = СтрокаРегистра.ИмяОбъекта;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаРегистров.Свернуть("Тип,Имя");
	
	БылиИзменения = Ложь;
	
	Для Каждого СтрокаРегистра Из ТаблицаРегистров Цикл
		
		Если СтрокаРегистра.Тип = "РегистрСведений" Тогда
			ТипРегистра = РегистрыСведений;
		ИначеЕсли СтрокаРегистра.Тип = "РегистрНакопления" Тогда
			ТипРегистра = РегистрыНакопления;
		ИначеЕсли СтрокаРегистра.Тип = "РегистрБухгалтерии" Тогда
			ТипРегистра = РегистрыБухгалтерии;
		Иначе
			Продолжить;
		КонецЕсли;
		
		МенеджерРегистра = ТипРегистра[СтрокаРегистра.Имя];
		
		НужноИзменить = (Признак <> МенеджерРегистра.ПолучитьИспользованиеИтогов());
		
		Если НужноИзменить Тогда
			УстановитьИспользованиеИтоговРегистра(МенеджерРегистра, Признак);
			БылиИзменения = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если БылиИзменения Тогда
		
		Комментарий = ?(Признак,
			НСтр("ru = 'Итоги регистров включены'"),
			НСтр("ru = 'Итоги регистров отключены'"));
		ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьИспользованиеИтоговРегистра(МенеджерРегистра, Признак)
	
	// Непосредственное изменение использования итогов вынесено в отдельну процедуру
	// чтобы оптимальнее занимать и освобождать память
	
	МенеджерРегистра.УстановитьИспользованиеИтогов(Признак);
	
	Если Признак Тогда
		МенеджерРегистра.ПересчитатьИтоги();
	КонецЕсли;
	
КонецПроцедуры

Функция ПрочитатьПараметрыСвертки() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ПараметрыСвертки = Константы.ПараметрыСверткиИБ.Получить().Получить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ПараметрыСвертки;
	
КонецФункции

Процедура СохранитьПараметрыСвертки(ПараметрыСвертки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПараметрыСвертки = Неопределено Тогда
		
		Результат = Неопределено;
		
	Иначе
		
		ТекущиеЗначения = Константы.ПараметрыСверткиИБ.Получить().Получить();
		Если ТипЗнч(ТекущиеЗначения) <> Тип("Структура") Тогда
			ТекущиеЗначения = Новый Структура;
		КонецЕсли;
		
		Для Каждого КлючЗначение Из ПараметрыСвертки Цикл
			ТекущиеЗначения.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
		
		Результат = Новый ХранилищеЗначения(ТекущиеЗначения);
		
	КонецЕсли;
	
	Константы.ПараметрыСверткиИБ.Установить(Результат);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура СохранитьНачалоЭтапа(НомерЭтапа)
	
	ПараметрыСвертки = Новый Структура("НомерЭтапа", НомерЭтапа);
	СохранитьПараметрыСвертки(ПараметрыСвертки);
	
	Шаблон = НСтр("ru = 'Свертка информационной базы (этап %1 начат)'");
	Комментарий = СтрЗаменить(Шаблон, "%1", НомерЭтапа);
	ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация);
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "#НомерЭтапа#" + Строка(НомерЭтапа);
	Сообщение.Сообщить();
	
КонецПроцедуры

Процедура СохранитьЗавершениеЭтапа(НомерЭтапа)
	
	ПараметрыСвертки = Новый Структура("НомерЭтапаВыполнен", НомерЭтапа);
	Если НомерЭтапа = 3 Тогда
		ПараметрыСвертки.Вставить("НомерСтраницы", 3);
	КонецЕсли;
	СохранитьПараметрыСвертки(ПараметрыСвертки);
	
	Шаблон = НСтр("ru = 'Свертка информационной базы (этап %1 завершен)'");
	Комментарий = СтрЗаменить(Шаблон, "%1", НомерЭтапа);
	ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Информация);
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "#НомерЭтапаВыполнен#" + Строка(НомерЭтапа);
	Сообщение.Сообщить();
	
КонецПроцедуры

Процедура ОтключитьМеханизмыОбъекта(Объект)
	
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
	Объект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
	
КонецПроцедуры

