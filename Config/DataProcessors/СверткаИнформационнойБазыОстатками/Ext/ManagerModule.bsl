#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ВыполнитьОперацию", Истина);
КонецПроцедуры

#КонецОбласти

Процедура ВыполнитьОперацию(Параметры, АдресХранилища) Экспорт
	
	ПараметрыСвертки = ПрочитатьПараметрыСвертки();
	
	Если ТипЗнч(ПараметрыСвертки) <> Тип("Структура") Тогда
		Комментарий = НСтр("ru = 'Не удалось получить параметры свертки. Свертка не выполнена.'");
		ОтразитьВЖурналеРегистрации(Комментарий, УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецЕсли;
	
	ПараметрыСвертки.Вставить("Дата", КонецДня(ПараметрыСвертки.ДатаСверткиИБ));
	ПараметрыСвертки.Вставить("ГраницаОстатков", Новый Граница(ПараметрыСвертки.Дата+1, ВидГраницы.Исключая));
	
	Если Не ПараметрыСвертки.ТолькоВыбранныеОрганизации Тогда
		ПараметрыСвертки.Организации = Неопределено;
	КонецЕсли;
	
	НомерЭтапа = ?(ПараметрыСвертки.Свойство("НомерЭтапа"), ПараметрыСвертки.НомерЭтапа, 0);
	НомерЭтапаВыполнен = ?(ПараметрыСвертки.Свойство("НомерЭтапаВыполнен"), ПараметрыСвертки.НомерЭтапаВыполнен, 0);
	ВыполнитьЭтап = ?(НомерЭтапа > НомерЭтапаВыполнен, НомерЭтапа, НомерЭтапа + 1);
	
	АвтоматическийРежимСвертки = (ПараметрыСвертки.РежимСвертки = 0);
	КонтролируемыйРежимСвертки = (ПараметрыСвертки.РежимСвертки = 1);
	
	// Сформировать документы ввода остатков
	Если ВыполнитьЭтап = 1 Тогда
		
		СохранитьНачалоЭтапа(1);
		
		СписокОрганизаций = СписокОрганизаций(ПараметрыСвертки);
		
		Если ПараметрыСвертки.УстановитьДатуЗапретаИзмененияДанных Тогда
			пСписокОрганизаций = ?(ПараметрыСвертки.Организации = Неопределено, Неопределено, СписокОрганизаций);
			УстановитьДатуЗапретаИзмененияДанных(НачалоДня(ПараметрыСвертки.Дата), пСписокОрганизаций);
		КонецЕсли;
		
		// Установка новой даты ввода остатков для организаций
		ЗаписатьДатуВводаОстатков(НачалоДня(ПараметрыСвертки.Дата), СписокОрганизаций);
		
		// Если это повторный запуск, то надо удалить документы, которые могли быть созданы
		УдалитьРанееСозданныеДокументыВводаОстатков(ПараметрыСвертки);
		
		СформироватьДокументыВводаОстатков(ПараметрыСвертки);
		
		СохранитьЗавершениеЭтапа(1);
		
		Если АвтоматическийРежимСвертки Тогда
			ВыполнитьЭтап = 2;
		КонецЕсли;
		
	КонецЕсли;
	
	// Удалить движения по дату свертки
	Если ВыполнитьЭтап = 2 Тогда
		
		СохранитьНачалоЭтапа(2);
		
		УстановитьИспользованиеИтогов(Ложь);
		
		УдалитьДанные(ПараметрыСвертки);
		
		Если КонтролируемыйРежимСвертки Тогда
			УстановитьИспользованиеИтогов(Истина);
		КонецЕсли;
		
		СохранитьЗавершениеЭтапа(2);
		
		Если АвтоматическийРежимСвертки Тогда
			ВыполнитьЭтап = 3;
		КонецЕсли;
		
	КонецЕсли;
	
	// Провести документы ввода остатков
	Если ВыполнитьЭтап = 3 Тогда
		
		СохранитьНачалоЭтапа(3);
		
		Если КонтролируемыйРежимСвертки Тогда
			УстановитьИспользованиеИтогов(Ложь);
		КонецЕсли;
		
		ПровестиДокументыВводаОстатков(ПараметрыСвертки);
		
		УстановитьИспользованиеИтогов(Истина);
		
		СохранитьЗавершениеЭтапа(3);
		
	КонецЕсли;
	
КонецПроцедуры

#Область Этап_1

Функция ТаблицаНастроекСвертки() Экспорт
	
	ТаблицаНастроек = Новый ТаблицаЗначений;
	ТаблицаНастроек.Колонки.Добавить("Документ"					, Новый ОписаниеТипов("ОбъектМетаданных"));
	ТаблицаНастроек.Колонки.Добавить("РазделУчета"				, Новый ОписаниеТипов("ПеречислениеСсылка.РазделыУчетаДляВводаОстатков"));
	ТаблицаНастроек.Колонки.Добавить("ТиповаяОперация"			, Новый ОписаниеТипов("СправочникСсылка.ТиповыеОперации"));
	ТаблицаНастроек.Колонки.Добавить("ТекстЗапроса"				, Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("ПараметрыЗапроса"			, Новый ОписаниеТипов("Структура"));
	ТаблицаНастроек.Колонки.Добавить("СписокСчетов"				, Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("КлючОтбора"				, Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("Ограничение"				, Новый ОписаниеТипов("Число"));
	ТаблицаНастроек.Колонки.Добавить("Регистры"					, Новый ОписаниеТипов("ТаблицаЗначений"));
	ТаблицаНастроек.Колонки.Добавить("Комментарий"				, Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("ДополнительныеПараметры"	, Новый ОписаниеТипов("Структура"));
	
	НастройкиРаздела_ОС(ТаблицаНастроек);						// Ввод остатков ОС, НМА, НПА
	
	НастройкиРаздела_МЗ_ИК(ТаблицаНастроек);					// ИмуществоКазныМЗ
	НастройкиРаздела_Забаланс(ТаблицаНастроек);					// ОсновныеСредстваНаЗабалансе
	НастройкиРаздела_Материалы(ТаблицаНастроек);				// Материалы
	НастройкиРаздела_Покупка(ТаблицаНастроек);					// ПоСчету106хП
	НастройкиРаздела_БСО(ТаблицаНастроек);						// БСО
	НастройкиРаздела_НДС_Входящий(ТаблицаНастроек);				// НДС (входящий)
	НастройкиРаздела_НДС_Исходящий(ТаблицаНастроек);			// НДС (исходящий)
	НастройкиРаздела_Прочее(ТаблицаНастроек);					// ПрочиеСчетаБухгалтерскогоУчета
	
	НастройкиРаздела_ЦеныНоменклатуры(ТаблицаНастроек);			// Установка цен номенклатуры
	
	НастройкиРаздела_КарточкиКапвложений(ТаблицаНастроек);		// Карточки капвложений
	
	НастройкиРаздела_КорректировкаРегистров(ТаблицаНастроек);	// Корректировка регистров
	
	СверткаИнформационнойБазыПереопределяемый.ДополнитьНастройкиСверткиПодчиненныхРегистров(ТаблицаНастроек);
	
	Возврат ТаблицаНастроек;
	
КонецФункции

#Область ПроцедурыФормированияНастроекСвертки

Процедура НастройкиРаздела_ОС(ТаблицаНастроек)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Остатки.Организация КАК Организация,
	|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ГраницаОстатков, Счет В (&Счет), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства), &Условие) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОССрезПоследних.Организация КАК Организация,
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ УчетныеДанные
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&Период,
	|			&Условие
	|				И СчетУчета В (&Счет)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	УчетныеДанныеОбъектаОССрезПоследних.Организация,
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.Организация КАК Организация,
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА Остатки.ОсновноеСредство ЕСТЬ NULL
	|			ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ДопПорядок
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО ОсновныеСредства.Организация = Остатки.Организация
	|			И ОсновныеСредства.Ссылка = Остатки.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанные КАК УчетныеДанные
	|		ПО ОсновныеСредства.Организация = УчетныеДанные.Организация
	|			И ОсновныеСредства.Ссылка = УчетныеДанные.ОсновноеСредство
	|ГДЕ
	|	(НЕ Остатки.ОсновноеСредство ЕСТЬ NULL
	|			ИЛИ НЕ УчетныеДанные.ОсновноеСредство ЕСТЬ NULL)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Организация КАК Организация,
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	&Условие
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	ОсновноеСредство,
	|	ВТ.ДопПорядок
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Настройка					= ТаблицаНастроек.Добавить();
	Настройка.Документ			= Метаданные.Документы.ВводНачальныхОстатковОС;
	Настройка.ТиповаяОперация	= Справочники.ТиповыеОперации.ВводНачальныхОстатковОС_ВводНачальныхОстатковОС;
	Настройка.ТекстЗапроса		= ТекстЗапроса;
	Настройка.СписокСчетов		= "101.00,102.00,103.00,104.00,-104.40,108.00,111.60,114.10,114.20,114.30,114.60,114.70,21,25,26|ОсновныеСредства";
	Настройка.КлючОтбора		= "Организация,ОсновноеСредство";
	Настройка.Ограничение		= 1;
	
	РБПолеОС =
	"	ВЫБОР
	|		КОГДА Субконто2 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА Субконто2
	|		КОГДА Субконто1 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА Субконто1
	|		ИНАЧЕ Субконто3
	|	КОНЕЦ";
	
	
	ТекстДатаСобытия = "ВЫБОР КОГДА ДатаСобытия = ДатаВремя(1, 1, 1) ТОГДА Период ИНАЧЕ ДатаСобытия КОНЕЦ";
	ПоляРН = Новый Структура("Период, ДатаСобытия", "&Период", ТекстДатаСобытия);
	
	УсловиеРН =
	"ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВАренду)
	| ИЛИ ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВПользование)";
	
	УсловиеДраг = "ОбъектНФА ССЫЛКА Справочник.ОсновныеСредства";
	
	ДобавитьНастройкуРегистра(Настройка, "РегистрБухгалтерии"	, "ЖурналПроводокЕПСБУ"							, "Свернуть"	, Новый Структура("ОсновноеСредство", РБПолеОС));
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "АмортизацияОС"								, "Свернуть"	);
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "КапРемонтОС"									, "Перенести"	, Новый Структура("ОсновноеСредство", "ОС"));
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "НачислениеАмортизацииОСБухгалтерскийУчет"	, "Перенести"	);
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "НачислениеАмортизацииОСНалоговыйУчет"		, "Свернуть"	);
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "НачислениеАмортизацииОССпециальныйКоэффициентНалоговыйУчет"	, "Свернуть");
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "НомераИнвентарныхКарточек"					, "Свернуть"	);
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "ПараметрыАмортизацииОСБухгалтерскийУчет"		, "Перенести"	);
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "ПараметрыАмортизацииОСНалоговыйУчет"			, "Свернуть"	);
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "ПервоначальныеСведенияОСБухгалтерскийУчет"	, "Свернуть"	);
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "ПервоначальныеСведенияОСНалоговыйУчет"		, "Свернуть"	);
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "ПервоначальныеСведенияОСНалоговыйУчетУСН"	, "Свернуть"	);
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "ПереоценкаНФА"								, "Перенести"	, Новый Структура("ОсновноеСредство", "НФА"));
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "РасчетАмортизацииОС"							, "Перенести"	);
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "СобытияОС"									, "Свернуть"	);
	ДобавитьНастройкуРегистра(Настройка, "РегистрСведений"		, "УчетныеДанныеОбъектаОС"						, "Свернуть"	,,, "ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаБалансе)");
	ДобавитьНастройкуРегистра(Настройка, "РегистрНакопления"	, "АмортизацияОбъектовОС"						, "Перенести"	, ПоляРН);
	ДобавитьНастройкуРегистра(Настройка, "РегистрНакопления"	, "НаличиеДрагМатериаловВОбъектахНФА"			, "Свернуть"	, Новый Структура("ОсновноеСредство", "ОбъектНФА"),, УсловиеДраг);
	ДобавитьНастройкуРегистра(Настройка, "РегистрНакопления"	, "СтоимостьОбъектовОС"							, "Перенести"	, ПоляРН);
	ДобавитьНастройкуРегистра(Настройка, "РегистрНакопления"	, "СтоимостьОбъектовОСПоКонтрагентам"			, "Свернуть"	,,, УсловиеРН);
	
КонецПроцедуры

Процедура НастройкиРаздела_МЗ_ИК(ТаблицаНастроек)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Остатки.Организация КАК Организация,
	|	Остатки.Счет КАК Счет,
	|	Остатки.КФО КАК КФО,
	|	ЕСТЬNULL(Остатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(Остатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ГраницаОстатков, Счет В (&Счет), , &Условие) КАК Остатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	Счет,
	|	ИФО,
	|	КФО,
	|	КПС";
	
	Настройка					= ТаблицаНастроек.Добавить();
	Настройка.Документ			= Метаданные.Документы.ВводНачальныхОстатков;
	Настройка.РазделУчета		= Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазныМЗ;
	Настройка.ТиповаяОперация	= Справочники.ТиповыеОперации.ВводНачальныхОстатков_ИмуществоКазны;
	Настройка.ТекстЗапроса		= ТекстЗапроса;
	Настройка.СписокСчетов		= "108.00|Номенклатура";
	Настройка.КлючОтбора		= "Организация,Счет,ИФО,КФО,КПС";
	Настройка.Ограничение		= 1000;
	
	ДобавитьНастройкуРегистра(Настройка, "РегистрБухгалтерии", "ЖурналПроводокЕПСБУ", "Свернуть");
	
КонецПроцедуры

Процедура НастройкиРаздела_Забаланс(ТаблицаНастроек)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Остатки.Организация КАК Организация,
	|	Остатки.Счет КАК Счет,
	|	Остатки.КФО КАК КФО,
