Процедура НастройкиРаздела_Материалы(ТаблицаНастроек)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Остатки.Организация КАК Организация,
	|	Остатки.Счет КАК Счет,
	|	ЕСТЬNULL(Остатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ГраницаОстатков, Счет В (&Счет), , &Условие) КАК Остатки
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	ИФО,
	|	Счет";
	
	Настройка					= ТаблицаНастроек.Добавить();
	Настройка.Документ			= Метаданные.Документы.ВводНачальныхОстатков;
	Настройка.РазделУчета		= Перечисления.РазделыУчетаДляВводаОстатков.Материалы;
	Настройка.ТиповаяОперация	= Справочники.ТиповыеОперации.ВводНачальныхОстатков_Материалы;
	Настройка.ТекстЗапроса		= ТекстЗапроса;
	Настройка.КлючОтбора		= "Организация,ИФО,Счет";
	Настройка.Ограничение		= 100;
	
	ТаблицаСчетов = Документы.ВводНачальныхОстатков.ПолучитьТаблицуСчетов_Материалы_ДляСвертки();
	СписокСчетов  = Документы.ВводНачальныхОстатков.ПолучитьМассивСчетов_Материалы_ДляСвертки(, ТаблицаСчетов);
	
	Настройка.ПараметрыЗапроса.Вставить("Счет", СписокСчетов);
	Настройка.ДополнительныеПараметры.Вставить("ТаблицаСчетов", ТаблицаСчетов);
	
	ДобавитьНастройкуРегистра(Настройка, "РегистрБухгалтерии", "ЖурналПроводокЕПСБУ", "Свернуть");
	
	// В документе ввода остатков отсутствует ввод драг. материалов
	// Собираем их отдельной настройкой в процедуре "НастройкиРаздела_КорректировкаРегистров";
	
КонецПроцедуры

