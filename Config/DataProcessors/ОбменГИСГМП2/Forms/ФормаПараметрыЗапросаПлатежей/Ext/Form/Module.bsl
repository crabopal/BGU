
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,Параметры,"КоличествоЧасов,ПериодЗапросаПлатежей,Участник");
	
	Элементы.ТаблицаУчастников.Видимость = Параметры.НуженОтборУчастников;
	
	Если Параметры.НуженОтборУчастников Тогда
		
		Если ЭтоАдресВременногоХранилища(Параметры.АдресТаблицыУчастников) Тогда
			
			ТаблицаУчастников.Загрузить(ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыУчастников));
			УдалитьИзВременногоХранилища(Параметры.АдресТаблицыУчастников);
			
		КонецЕсли;

	КонецЕсли;
	
	ВидПлатежей = "PAYMENT"; //все активные платежи
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидПлатежейОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура КоличествоЧасовОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаУчастников

&НаКлиенте
Процедура ТаблицаУчастниковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ИзменитьОтметкиУчастников(Ложь);
	ТекДанные = Элементы.ТаблицаУчастников.ТекущиеДанные;
	ТекДанные.Использовать = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ЗапроситьПлатежи(Команда)
	
	Если НЕ ЗначениеЗаполнено(ВидПлатежей) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не указан вид запрашиваемых платежей.'"),,"ВидПлатежей");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПериодЗапросаПлатежей.ДатаНачала)
		ИЛИ НЕ ЗначениеЗаполнено(ПериодЗапросаПлатежей.ДатаОкончания) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не заполнен период за который необходимо получить платежи из сервиса.'"),,"ПериодЗапросаПлатежей");
		Возврат;
	КонецЕсли;
	
	//Из ГИС ГМП можно получать данные за 3 года + текущий год
	НачальныйГод = Год(ТекущаяДата()) - 3;
	МинимальнаяДатаНачала = Дата(НачальныйГод,1,1); 
	
	Если ПериодЗапросаПлатежей.ДатаНачала < МинимальнаяДатаНачала Тогда
		
		ТекстВопроса = НСтр("ru='Указана некорректная дата начала. 
			|Из сервиса допустимо запрашивать данные о платежах совершеных не ранее %1.
			|Вы уверены, что хотите запросить данные о платежах, совершенных ранее этой даты?'");
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса,Формат(МинимальнаяДатаНачала,"ДФ=dd.MM.yyyy"));
		Ответ = Ждать ВопросАсинх(ТекстВопроса,РежимДиалогаВопрос.ОКОтмена,,КодВозвратаДиалога.Отмена);
		
		Если Ответ <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не заполнен период за который необходимо получить платежи из сервиса.'"),,"ПериодЗапросаПлатежей");
		Возврат;
	КонецЕсли;
	
	МассивУчастников = Новый Массив;
	Если Параметры.НуженОтборУчастников Тогда
		Для Каждого СтрТч Из ТаблицаУчастников Цикл
			Если СтрТч.Использовать Тогда
				МассивУчастников.Добавить(СтрТч.Участник);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("КоличествоЧасов",КоличествоЧасов);
	СтруктураРезультата.Вставить("ПериодЗапросаПлатежей",ПериодЗапросаПлатежей);
	СтруктураРезультата.Вставить("МассивУчастников",МассивУчастников);
	СтруктураРезультата.Вставить("ВидПлатежей",ВидПлатежей);
	
	Закрыть(СтруктураРезультата);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьУчастников(Команда)
	
	ИзменитьОтметкиУчастников(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкиУчастников(Команда)
	
	ИзменитьОтметкиУчастников(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИзменитьОтметкиУчастников(ЗначениеОтметки)
	
	Для Каждого ТекЭлемент Из ТаблицаУчастников Цикл
		ТекЭлемент.Использовать = ЗначениеОтметки;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти







