&НаСервереБезКонтекста
Процедура ЗапросыОбщиеПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	МассивОрганизаций = Новый Массив;
	МассивУИД = Новый Массив;
	Для Каждого ТекСтрока Из Строки Цикл
		ДанныеСтроки = ТекСтрока.Значение.Данные;
		Если МассивОрганизаций.Найти(ДанныеСтроки.Организация) = Неопределено Тогда
			МассивОрганизаций.Добавить(ДанныеСтроки.Организация);
		КонецЕсли;
		МассивУИД.Добавить(ДанныеСтроки.УИДНастройкиОбщегоЗапроса);
	КонецЦикла;
	
	МассивСтатусовВОбработке = Новый Массив;
	МассивСтатусовВОбработке.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВРаботе);
	МассивСтатусовВОбработке.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Запланирован);
	МассивСтатусовВОбработке.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Отправлен);
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("МассивОрганизаций",МассивОрганизаций);
	Запрос.Параметры.Вставить("МассивУИД",МассивУИД);
	Запрос.Параметры.Вставить("МассивСтатусовВОбработке",МассивСтатусовВОбработке);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДВыполняемогоЗапросаКГИСГМП КАК УИДВыполняемогоЗапросаКГИСГМП,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиОбщегоЗапроса КАК УИДНастройкиОбщегоЗапроса,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.СтатусВыполняемогоЗапроса КАК СтатусВыполняемогоЗапроса
		|ПОМЕСТИТЬ ТабДанных
		|ИЗ
		|	РегистрСведений.ВыполняемыеЗапросыОчередиКГИСГМП КАК ВыполняемыеЗапросыОчередиКГИСГМП
		|ГДЕ
		|	ВыполняемыеЗапросыОчередиКГИСГМП.Организация В(&МассивОрганизаций)
		|	И ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиОбщегоЗапроса В(&МассивУИД)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	УИДВыполняемогоЗапросаКГИСГМП
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(ТабДанных.УИДВыполняемогоЗапросаКГИСГМП) КАК Всего,
		|	ТабДанных.УИДНастройкиОбщегоЗапроса КАК УИДНастройкиОбщегоЗапроса,
		|	СУММА(ВЫБОР
		|			КОГДА ТабДанных.СтатусВыполняемогоЗапроса В (&МассивСтатусовВОбработке)
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК Обработано
		|ПОМЕСТИТЬ ПрогрессВыполнения
		|ИЗ
		|	ТабДанных КАК ТабДанных
		|
		|СГРУППИРОВАТЬ ПО
		|	ТабДанных.УИДНастройкиОбщегоЗапроса
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПрогрессВыполнения.Всего КАК Всего,
		|	ПрогрессВыполнения.Обработано КАК Обработано,
		|	ПрогрессВыполнения.УИДНастройкиОбщегоЗапроса КАК УИДНастройкиОбщегоЗапроса,
		|	Данные.КоличествоДокументов КАК КоличествоДокументов
		|ИЗ
		|	ПрогрессВыполнения КАК ПрогрессВыполнения
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.ЗагруженныйОбъект) КАК КоличествоДокументов,
		|			ТабДанных.УИДНастройкиОбщегоЗапроса КАК УИДНастройкиОбщегоЗапроса
		|		ИЗ
		|			РегистрСведений.ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3 КАК ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабДанных КАК ТабДанных
		|				ПО ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.УИДВыполняемогоЗапросаКГИСГМП = ТабДанных.УИДВыполняемогоЗапросаКГИСГМП
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ТабДанных.УИДНастройкиОбщегоЗапроса) КАК Данные
		|		ПО Данные.УИДНастройкиОбщегоЗапроса = ПрогрессВыполнения.УИДНастройкиОбщегоЗапроса";
	
	Реузльтат = Запрос.Выполнить();
	
	ТабРезультата = Реузльтат.Выгрузить();
	ТабРезультата.Индексы.Добавить("УИДНастройкиОбщегоЗапроса");
	Для Каждого ТекСтрока Из Строки Цикл
		ДанныеСтроки = ТекСтрока.Значение.Данные;
		СтрокаРезультата = ТабРезультата.Найти(ДанныеСтроки.УИДНастройкиОбщегоЗапроса);
		Если СтрокаРезультата <> Неопределено Тогда
			ПрогрессВыполнения = Нстр("ru='%1 из %2'");
			ПрогрессВыполнения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПрогрессВыполнения,СтрокаРезультата.Обработано,СтрокаРезультата.Всего);
			ДанныеСтроки.ПрогрессВыполнения = ПрогрессВыполнения;
			ДанныеСтроки.ДокументовПолучено = СтрокаРезультата.КоличествоДокументов;
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗапросыОбщиеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ЗапросыОбщие.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекДанные.УИДНастройкиОбщегоЗапроса)Тогда
		Возврат;
	КонецЕсли;
		
	Если СтрЗаканчиваетсяНа(Поле.Имя,"ДокументовПолучено") Тогда
		СтандартнаяОбработка = Ложь;
		Если ТекДанные.ДокументовПолучено = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("УИДНастройкиОбщегоЗапроса",ТекДанные.УИДНастройкиОбщегоЗапроса);
		ОткрытьФорму("РегистрСведений.ЗагруженныеДанныеСМЭВ3.Форма.ФормаОтображенияЗагруженныхДанных",ПараметрыФормы,ЭтотОбъект,ТекДанные.УИДНастройкиОбщегоЗапроса);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗапросыДетальныеПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	МассивОрганизаций = Новый Массив;
	МассивУИД = Новый Массив;
	Для Каждого ТекСтрока Из Строки Цикл
		ДанныеСтроки = ТекСтрока.Значение.Данные;
		Если МассивОрганизаций.Найти(ДанныеСтроки.Организация) = Неопределено Тогда
			МассивОрганизаций.Добавить(ДанныеСтроки.Организация);
		КонецЕсли;
		МассивУИД.Добавить(ДанныеСтроки.УИДНастройкиДетальногоЗапроса);
	КонецЦикла;
	
	МассивСтатусовВОбработке = Новый Массив;
	МассивСтатусовВОбработке.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВРаботе);
	МассивСтатусовВОбработке.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Запланирован);
	МассивСтатусовВОбработке.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Отправлен);
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("МассивОрганизаций",МассивОрганизаций);
	Запрос.Параметры.Вставить("МассивУИД",МассивУИД);
	Запрос.Параметры.Вставить("МассивСтатусовВОбработке",МассивСтатусовВОбработке);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДВыполняемогоЗапросаКГИСГМП КАК УИДВыполняемогоЗапросаКГИСГМП,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиДетальногоЗапроса КАК УИДНастройкиДетальногоЗапроса,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.СтатусВыполняемогоЗапроса КАК СтатусВыполняемогоЗапроса
		|ПОМЕСТИТЬ ТабДанных
		|ИЗ
		|	РегистрСведений.ВыполняемыеЗапросыОчередиКГИСГМП КАК ВыполняемыеЗапросыОчередиКГИСГМП
		|ГДЕ
		|	ВыполняемыеЗапросыОчередиКГИСГМП.Организация В(&МассивОрганизаций)
		|	И ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиДетальногоЗапроса В(&МассивУИД)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	УИДВыполняемогоЗапросаКГИСГМП
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(ТабДанных.УИДВыполняемогоЗапросаКГИСГМП) КАК Всего,
		|	ТабДанных.УИДНастройкиДетальногоЗапроса КАК УИДНастройкиДетальногоЗапроса,
		|	СУММА(ВЫБОР
		|			КОГДА ТабДанных.СтатусВыполняемогоЗапроса В (&МассивСтатусовВОбработке)
		|				ТОГДА 0
		|			ИНАЧЕ 1
		|		КОНЕЦ) КАК Обработано
		|ПОМЕСТИТЬ ПрогрессВыполнения
		|ИЗ
		|	ТабДанных КАК ТабДанных
		|
		|СГРУППИРОВАТЬ ПО
		|	ТабДанных.УИДНастройкиДетальногоЗапроса
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПрогрессВыполнения.Всего КАК Всего,
		|	ПрогрессВыполнения.Обработано КАК Обработано,
		|	ПрогрессВыполнения.УИДНастройкиДетальногоЗапроса КАК УИДНастройкиДетальногоЗапроса,
		|	Данные.КоличествоДокументов КАК КоличествоДокументов
		|ИЗ
		|	ПрогрессВыполнения КАК ПрогрессВыполнения
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.ЗагруженныйОбъект) КАК КоличествоДокументов,
		|			ТабДанных.УИДНастройкиДетальногоЗапроса КАК УИДНастройкиДетальногоЗапроса
		|		ИЗ
		|			РегистрСведений.ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3 КАК ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабДанных КАК ТабДанных
		|				ПО ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.УИДВыполняемогоЗапросаКГИСГМП = ТабДанных.УИДВыполняемогоЗапросаКГИСГМП
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ТабДанных.УИДНастройкиДетальногоЗапроса) КАК Данные
		|		ПО Данные.УИДНастройкиДетальногоЗапроса = ПрогрессВыполнения.УИДНастройкиДетальногоЗапроса";
	
	Реузльтат = Запрос.Выполнить();
	
	ТабРезультата = Реузльтат.Выгрузить();
	ТабРезультата.Индексы.Добавить("УИДНастройкиДетальногоЗапроса");
	Для Каждого ТекСтрока Из Строки Цикл
		ДанныеСтроки = ТекСтрока.Значение.Данные;
		СтрокаРезультата = ТабРезультата.Найти(ДанныеСтроки.УИДНастройкиДетальногоЗапроса);
		Если СтрокаРезультата <> Неопределено Тогда
			ПрогрессВыполнения = Нстр("ru='%1 из %2'");
			ПрогрессВыполнения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПрогрессВыполнения,СтрокаРезультата.Обработано,СтрокаРезультата.Всего);
			ДанныеСтроки.ПрогрессВыполнения = ПрогрессВыполнения;
			ДанныеСтроки.ДокументовПолучено = СтрокаРезультата.КоличествоДокументов;
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗапросыДетальныеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ЗапросыДетальные.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекДанные.УИДНастройкиДетальногоЗапроса)Тогда
		Возврат;
	КонецЕсли;
		
	Если СтрЗаканчиваетсяНа(Поле.Имя,"ДокументовПолучено") Тогда
		СтандартнаяОбработка = Ложь;
		Если ТекДанные.ДокументовПолучено = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("УИДНастройкиДетальногоЗапроса",ТекДанные.УИДНастройкиДетальногоЗапроса);
		ОткрытьФорму("РегистрСведений.ЗагруженныеДанныеСМЭВ3.Форма.ФормаОтображенияЗагруженныхДанных",ПараметрыФормы,ЭтотОбъект,ТекДанные.УИДНастройкиДетальногоЗапроса);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапросыВыполняемыеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ЗапросыВыполняемые.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекДанные.УИДВыполняемогоЗапросаКГИСГМП)Тогда
		Возврат;
	КонецЕсли;
		
	Если СтрЗаканчиваетсяНа(Поле.Имя,"РезультатОбработки") Тогда
		СтандартнаяОбработка = Ложь;
		Если ТекДанные.ДокументовВОтвете = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("УИДВыполняемогоЗапросаКГИСГМП",ТекДанные.УИДВыполняемогоЗапросаКГИСГМП);
		ОткрытьФорму("РегистрСведений.ЗагруженныеДанныеСМЭВ3.Форма.ФормаОтображенияЗагруженныхДанных",ПараметрыФормы,ЭтотОбъект,ТекДанные.УИДВыполняемогоЗапросаКГИСГМП);
	КонецЕсли;
КонецПроцедуры

