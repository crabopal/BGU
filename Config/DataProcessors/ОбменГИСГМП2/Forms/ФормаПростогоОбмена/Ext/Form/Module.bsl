&НаКлиенте
Процедура СоздатьНачисление(Команда)
	ТекДанные = Элементы.СписокКонтрагентовИШаблонов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ТекстСообщения = НСтр("ru='Не выбрана строка таблицы шаблонов, по которому требуется создать Начисление от посредника.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("ШаблонНачисления",ТекДанные.ШаблонНачисления);
	СтруктураЗаполнения.Вставить("КонтрагентПолучатель",ТекДанные.КонтрагентПолучатель);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",СтруктураЗаполнения);
	ОткрытьФорму("Документ.НачислениеОтПосредникаГИСГМП.ФормаОбъекта",ПараметрыФормы,,Истина);
	
КонецПроцедуры

