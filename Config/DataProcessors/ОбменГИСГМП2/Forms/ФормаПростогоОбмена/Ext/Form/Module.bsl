Процедура ДеревоУчастниковИспользоватьПриИзменении(Элемент)
	ПриИзмененииСпискаУчастников();	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСпискаУчастников(ЭтоИзменениеУчастника = Ложь)
	
	мМассивУчастниковОрганизаций = Новый Массив;
	мМассивУчастниковКонтрагентов = Новый Массив;
	СоответствиеОтмеченныхУчастников = Новый Соответствие;
	
	НужноСохранятьОтмеченныхУчастников = Ложь;
	Если ЭтоБазаГАН = Ложь
		ИЛИ ТаблицаУчастников.Количество() = 1 Тогда
		
		//Подведомственных нет
		мМассивУчастниковОрганизаций.Добавить(Объект.Участник);
		
	Иначе
		
		НужноСохранятьОтмеченныхУчастников = Истина;
		
		Для Каждого СтрТЧ Из ТаблицаУчастников Цикл
			Если СтрТЧ.Использовать Тогда
				Если СтрТЧ.ВидУчастника = 0 Тогда
					мМассивУчастниковОрганизаций.Добавить(СтрТЧ.Участник);
				Иначе
					мМассивУчастниковКонтрагентов.Добавить(СтрТЧ.Участник);
				КонецЕсли;
				СоответствиеОтмеченныхУчастников.Вставить(СтрТЧ.Участник,Истина);
			КонецЕсли;
		КонецЦикла;		 

	КонецЕсли;
	
	Если НужноСохранятьОтмеченныхУчастников Тогда
		КлючНастроек = "Участник_"+Строка(Объект.Участник.УникальныйИдентификатор());
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ОбменГИСГМП2",КлючНастроек,СоответствиеОтмеченныхУчастников);
	КонецЕсли;
	
	ВсегоУчастников = ТаблицаУчастников.Количество();
	ОтмеченоУчастников = мМассивУчастниковОрганизаций.Количество() + мМассивУчастниковКонтрагентов.Количество(); 
	ВыбраноУчастников = "%1 из %2";
	ВыбраноУчастников = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ВыбраноУчастников,ОтмеченоУчастников,ВсегоУчастников);
	
	МассивУчастниковОрганизаций = Новый ФиксированныйМассив(мМассивУчастниковОрганизаций);
	МассивУчастниковКонтрагентов = Новый ФиксированныйМассив(мМассивУчастниковКонтрагентов);
	
	ЗаполнитьСписокПакетов(Истина);
	
	УстановитьОтборСпискаЗапросовПоУчастникам(ЭтоИзменениеУчастника);
	УстановитьОтборСпискаЗапросовНачисленийАЗПоУчастникам(ЭтоИзменениеУчастника);	
	УстановитьОтборСпискаЗапросовПлатежейАЗПоУчастникам(ЭтоИзменениеУчастника);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗапросыОбщие,"Организация",МассивУчастниковОрганизаций,ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗапросыДетальные,"Организация",МассивУчастниковОрганизаций,ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗапросыВыполняемые,"Организация",МассивУчастниковОрганизаций,ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНачисленийОтПосредника,"Организация",МассивУчастниковОрганизаций,ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
	
	ЗаполнитьСписокКвитанций(Истина);
	ЗаполнитьСписокВозвратов(Истина);
	ЗаполнитьСписокНачисленийОтПосредника(Истина);
	
КонецПроцедуры


&НаСервере
Процедура УстановитьОтборСпискаЗапросовПоУчастникам(ЭтоИзменениеУчастника = Ложь)
	
	Если ЭтоИзменениеУчастника = Истина Тогда
		//удалим предыдущие отборы
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(СписокЗапросов.Отбор,"Организация");
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(СписокЗапросов.Отбор,,"ОтборУчастников");
	КонецЕсли;
	
	Если ЭтоБазаГАН = Ложь
		ИЛИ ТаблицаУчастников.Количество() = 1 Тогда
		//Подведомственных нет
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокЗапросов,"Организация",Объект.Участник);
	Иначе
			 
		ГруппаОтбораУчастников = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(СписокЗапросов.Отбор.Элементы,"ОтборУчастников",ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбораУчастников,"Организация",ВидСравненияКомпоновкиДанных.ВСписке,МассивУчастниковОрганизаций,,МассивУчастниковОрганизаций.Количество());
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбораУчастников,"Участник",ВидСравненияКомпоновкиДанных.ВСписке,МассивУчастниковКонтрагентов,,МассивУчастниковКонтрагентов.Количество());

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
