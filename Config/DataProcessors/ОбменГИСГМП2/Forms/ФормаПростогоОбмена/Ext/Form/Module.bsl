	ТекДанные = Элементы.СписокКаталогов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ТекущийКаталог = Неопределено;
	Иначе
		ТекущийКаталог = ТекДанные.ДокСсылка;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПоказатьИсториюОбмена",0.5,Истина);
	
