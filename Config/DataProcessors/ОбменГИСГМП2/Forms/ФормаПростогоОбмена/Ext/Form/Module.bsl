	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","ПодпискаНаУведомлениеГИСГМП","SendRequestRequest_CS");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	МассивУИНБезПодписки = Новый Массив;
	МассивВыденных = Элементы.СписокНачисленийОтПосредника.ВыделенныеСтроки;
	Для Каждого ЭлМас Из МассивВыденных Цикл
		ТекДанные = Элементы.СписокНачисленийОтПосредника.ДанныеСтроки(ЭлМас);
		Если ЗначениеЗаполнено(ТекДанные.УИН)
			И ТекДанные.ЕстьПодпискаНаКвитанции = 1 Тогда//1 это подписка есть
			МассивУИНБезПодписки.Добавить(ТекДанные.УИН);
		КонецЕсли;
	КонецЦикла;
	Если МассивУИНБезПодписки.Количество() = 0 Тогда
		Если МассивВыденных.Количество() Тогда
			ТекстСообщения = НСтр("ru='В выделенных документах еще нет УИН или на документы не подключена подписка на квитанции по УИН.'");
		Иначе
			ТекстСообщения = НСтр("ru='Не выделены документы для отключения подписки на квитанции по УИН.'");
		КонецЕсли;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	мМассивУИНДляПодписок = Новый ФиксированныйМассив(МассивУИНБезПодписки);
	ТекущееДействие = "ОтписатьсяОтКвитанцийДляПосредникаПоУИН";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыДляПодпискиНаНачисленияПоУИН(ЕстьОшибки)
		
	СформироватьФайлыДляПодключенияВыбраннойПодпискиПоУИН(ЕстьОшибки,ПодпискаДляНачислений);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыДляПодпискиНаКвитанцииНачисленийСПлатежамиПоУИН(ЕстьОшибки)
	
	СформироватьФайлыДляПодключенияВыбраннойПодпискиПоУИН(ЕстьОшибки,ПодпискаДляКвитанций);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыДляПодключенияВыбраннойПодпискиПоУИН(ЕстьОшибки,ПодключаемаяПодписка)
	
	//Если подписки еще нет, можно создать только один документ подписки - для новой подписки,
	//тогда в ответ будет присоен идентификатор подписки, и можно будет изменять ее 
	МассивДокументов = Новый Массив;
	НуженДокумент = Истина;

	ИдентификаторПодписки = Документы.ПодпискаНаУведомлениеГИСГМП.ПолучитьИдентификаторПодписки(Объект.Участник, ПодключаемаяПодписка);
	
	Кол = 0;
	Для Каждого ТекУИН Из мМассивУИНДляПодписок Цикл
		Если НуженДокумент Тогда
			ДокПодписка = Документы.ПодпискаНаУведомлениеГИСГМП.СоздатьДокумент();	
			ДокПодписка.Организация = Объект.Участник;
			ДокПодписка.Подписка = ПодключаемаяПодписка;
			ДокПодписка.Дата = ТекущаяДатаСеанса();
			 
			ДокПодписка.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
			ДокПодписка.ЗаполнитьПараметрыПодписки();
			
			Если ЗначениеЗаполнено(ИдентификаторПодписки) Тогда
				ДокПодписка.СтатусПодписки = 2;//изменение
				ДокПодписка.ИдентификаторПодписки = ИдентификаторПодписки;
			Иначе
				ДокПодписка.СтатусПодписки = 1;//новая
			КонецЕсли;
			
			СтрокаПараметра = ДокПодписка.ПараметрыПодписки[0];//в подписке должен быть один параметр
			НуженДокумент = Ложь;
		КонецЕсли;
	
		СтрокаГруппы = ДокПодписка.ГруппыПараметров.Добавить();
		СтрокаГруппы.КлючСтроки = "P"+Строка(Новый УникальныйИдентификатор);
		СтрокаГруппы.СтатусПараметра = 1;
		
		СтрокаЗначения = ДокПодписка.ЗначенияПараметровПодписки.Добавить(); 
		СтрокаЗначения.КлючСтроки = СтрокаГруппы.КлючСтроки;
		СтрокаЗначения.КодПараметра = СтрокаПараметра.КодПараметра;
		СтрокаЗначения.ЗначениеПараметра = ТекУИН;
		
		Кол = Кол + 1;
		
		Если Кол >=100 Тогда
			ДокПодписка.Записать();
			МассивДокументов.Добавить(ДокПодписка.Ссылка);
			ДокПодписка = Неопределено;
			НуженДокумент = Истина;
			Если НЕ ЗначениеЗаполнено(ИдентификаторПодписки)
				И мМассивУИНДляПодписок.Количество()>100 Тогда
				ТекстСообщения = НСтр("ru='Т.к. для участника ""%1"" подписка ""%2"" еще не подключена,
				|то подготовлен документ для подключения подписки по УИН, для первых 100 документов.
				|После подключения подписки можно будет подключить в подписку следующие документы.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,Объект.Участник,ПодключаемаяПодписка);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Если ДокПодписка <> Неопределено Тогда
		ДокПодписка.Записать();
		МассивДокументов.Добавить(ДокПодписка.Ссылка);
		ДокПодписка = Неопределено;
	КонецЕсли;
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
		
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
			
	Организация = Объект.Участник;
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
						
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Объект.Участник);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
	
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	Для Каждого ТекДок Из МассивДокументов Цикл
		НовСтр = ТекОбъектыОбмена.Добавить();
		НовСтр.Объект = ТекДок;
		НовСтр.Формат = ФорматЭкспорта;
	КонецЦикла;
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
	
	МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортДанныхВСМЭВ,ЕстьОшибки);			
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыДляОтключенияПодпискиНаНачисленияПоУИН(ЕстьОшибки)
		
	СформироватьФайлыДляОтключенияВыбраннойПодпискиПоУИН(ЕстьОшибки,ПодпискаДляНачислений);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыДляОтключенияПодпискиНаКвитанцииНачисленийСПлатежамиПоУИН(ЕстьОшибки)
	
	СформироватьФайлыДляОтключенияВыбраннойПодпискиПоУИН(ЕстьОшибки,ПодпискаДляКвитанций);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыДляОтключенияВыбраннойПодпискиПоУИН(ЕстьОшибки,ОтключаемаяПодписка)
	
	//Если идентификатор подписки не заполнен, значит она не подключена, значить отключить ее нельзя 

	ИдентификаторПодписки = Документы.ПодпискаНаУведомлениеГИСГМП.ПолучитьИдентификаторПодписки(Объект.Участник, ОтключаемаяПодписка);
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторПодписки) Тогда
		//не должно такого быть
		ЕстьОшибки = Истина;
		ТекстСообщения = НСтр("ru='Для выбранной подписки ""%1"" не обнаружен идентификатор подключенной подписки.
			|Отключить выбранную подписку для выделенных документов не удалось.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ОтключаемаяПодписка);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыПодписокГИСГМПСрезПоследних.ИдентификаторГруппыПараметров КАК ИдентификаторГруппыПараметров,
		|	ПараметрыПодписокГИСГМПСрезПоследних.ЗначениеПараметра КАК ТекУИН,
		|	ПараметрыПодписокГИСГМПСрезПоследних.КодПараметра КАК КодПараметра,
		|	ПараметрыПодписокГИСГМПСрезПоследних.ИдентификаторПодписки КАК ИдентификаторПодписки
		|ИЗ
		|	РегистрСведений.ПараметрыПодписокГИСГМП.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И Подписка = &Подписка
		|				И ЗначениеПараметра В (&МассивУИН)) КАК ПараметрыПодписокГИСГМПСрезПоследних
		|ГДЕ
		|	ПараметрыПодписокГИСГМПСрезПоследних.ПараметрАктивен
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИдентификаторПодписки";
	
	Запрос.УстановитьПараметр("МассивУИН", мМассивУИНДляПодписок);
	Запрос.УстановитьПараметр("Организация", Объект.Участник);
	Запрос.УстановитьПараметр("Подписка", ОтключаемаяПодписка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Кол = 0;
	
	НуженДокумент = Истина;
	МассивДокументов = Новый Массив;
	
	ИспользуемыйИдПодписки = Неопределено;
	ДокПодписка = Неопределено;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ИспользуемыйИдПодписки)
			И ИспользуемыйИдПодписки <> ВыборкаДетальныеЗаписи.ИдентификаторПодписки Тогда
			//если идентификатор подписки другой, запишем документ
			//в обмене с ИС РНИП можно подключить несколько подписок одного типа, и у них будет разный идентификатор подписки
			ДокПодписка.Записать();
			МассивДокументов.Добавить(ДокПодписка.Ссылка);
			ДокПодписка = Неопределено;
			НуженДокумент = Истина;
			
		КонецЕсли;
		
		Если НуженДокумент Тогда
			ДокПодписка = Документы.ПодпискаНаУведомлениеГИСГМП.СоздатьДокумент();	
			ДокПодписка.Организация = Объект.Участник;
			ДокПодписка.Подписка = ОтключаемаяПодписка;
			ДокПодписка.Дата = ТекущаяДатаСеанса();
			 
			ДокПодписка.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
			ДокПодписка.ЗаполнитьПараметрыПодписки();
			
			ДокПодписка.СтатусПодписки = 2;//изменение
			ДокПодписка.ИдентификаторПодписки = ВыборкаДетальныеЗаписи.ИдентификаторПодписки;			
			
			СтрокаПараметра = ДокПодписка.ПараметрыПодписки[0];//в подписке должен быть один параметр
			НуженДокумент = Ложь;
		КонецЕсли;
	
		СтрокаГруппы = ДокПодписка.ГруппыПараметров.Добавить();
		СтрокаГруппы.КлючСтроки = ВыборкаДетальныеЗаписи.ИдентификаторГруппыПараметров;
		СтрокаГруппы.СтатусПараметра = 3;//отключение
		
		СтрокаЗначения = ДокПодписка.ЗначенияПараметровПодписки.Добавить(); 
		СтрокаЗначения.КлючСтроки = СтрокаГруппы.КлючСтроки;
		СтрокаЗначения.КодПараметра = СтрокаПараметра.КодПараметра;
		СтрокаЗначения.ЗначениеПараметра = ВыборкаДетальныеЗаписи.ТекУИН;
		
		Кол = Кол + 1;
		
		ИспользуемыйИдПодписки = ВыборкаДетальныеЗаписи.ИдентификаторПодписки;
		
		Если Кол >=100 Тогда
			ДокПодписка.Записать();
			МассивДокументов.Добавить(ДокПодписка.Ссылка);
			ДокПодписка = Неопределено;
			НуженДокумент = Истина;
			
		КонецЕсли;
	КонецЦикла;
	
	Если ДокПодписка <> Неопределено Тогда
		ДокПодписка.Записать();
		МассивДокументов.Добавить(ДокПодписка.Ссылка);
		ДокПодписка = Неопределено;
	КонецЕсли;
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
		
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
			
	Организация = Объект.Участник;
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
						
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Объект.Участник);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
	
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	Для Каждого ТекДок Из МассивДокументов Цикл
		НовСтр = ТекОбъектыОбмена.Добавить();
		НовСтр.Объект = ТекДок;
		НовСтр.Формат = ФорматЭкспорта;
	КонецЦикла;
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
	
	МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортДанныхВСМЭВ,ЕстьОшибки);			
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));
	
КонецПроцедуры


&НаСервере
Процедура ОбновитьСписокОтмеченныхДокументовПоДаннымСпискаНачисленийОтПосредника()
	СписокОтмеченныеНачисленияОтПосредника.ЗагрузитьЗначения(ПолучитьОтмеченныеНачисленияОтПосредника());
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокНачисленийОтПосредника,"ОтмеченныеДокументы",СписокОтмеченныеНачисленияОтПосредника,Истина);
КонецПроцедуры

&НаСервере
Функция ПолучитьОтмеченныеНачисленияОтПосредника()
    //чтобы при изменении отборов или списка участников можно было получить отмеченные в текущем списке
	Схема = Элементы.СписокНачисленийОтПосредника.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	НастройкиСхемы = Элементы.СписокНачисленийОтПосредника.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиСхемы);
	КомпоновщикНастроек.Восстановить();
	
	КомпоновщикНастроек.Настройки.Структура.Очистить();
	
	ДетальныеЗаписи = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ДетальныеЗаписи.Имя = "ДетальныеЗаписи";
	ДетальныеЗаписи.Использование = Истина;
	
	ПолеОтчет = ДетальныеЗаписи.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ПолеОтчет.Поле = Новый ПолеКомпоновкиДанных("ДокСсылка");
	ПолеОтчет.Использование = Истина;
				
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(КомпоновщикНастроек.Настройки.Отбор,"Использовать",2,ВидСравненияКомпоновкиДанных.Равно,Истина);
		
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(Схема, КомпоновщикНастроек.ПолучитьНастройки(), , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных);
	ПроцессорВыводаРезультатаОтчета = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	РезультатСхемы = ПроцессорВыводаРезультатаОтчета.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат РезультатСхемы.ВыгрузитьКолонку("ДокСсылка");

КонецФункции

&НаСервере
Процедура ЗаполнитьСписокНачисленийОтПосредника(ОбновлятьСписокОтмеченных = Ложь)
			
	ЗаполнитьНастройкиДССписокНачисленийОтПосредника();
		
	Если ОбновлятьСписокОтмеченных Тогда
		ОбновитьСписокОтмеченныхДокументовПоДаннымСпискаНачисленийОтПосредника();
	КонецЕсли;
		
