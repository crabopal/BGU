&НаКлиенте
Асинх Процедура ОтправитьЗапросыАЗ(Команда)
	
	ОчиститьСообщения();
	
	ТипЗапрашиваемыхДанных = "";//так как запросов несколько, то проверять тип запроса не будем
	
	МассивВыделенныхСтрок = Новый Массив;
	
	Если Элементы.СтраницыЗапросыАЗ.ТекущаяСтраница = Элементы.СтраницаЗапросыНачислений Тогда
		//это запрос начислений
		МассивВыделенныхСтрок = Элементы.ЗапросыНачисленийАЗ.ВыделенныеСтроки;
	ИначеЕсли Элементы.СтраницыЗапросыАЗ.ТекущаяСтраница = Элементы.СтраницаЗапросыПлатежей Тогда
		МассивВыделенныхСтрок = Элементы.ЗапросыПлатежейАЗ.ВыделенныеСтроки;
	КонецЕсли;
	
	Если МассивВыделенныхСтрок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны запросы для отправки.'"));
		Возврат;
	КонецЕсли;
	
	Если ПроверитьВозможностьФормированияПоПараметрамДляПрозвольногоЗапроса(ТипЗапрашиваемыхДанных) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	мМассивЗапросов = Новый ФиксированныйМассив(МассивВыделенныхСтрок);
	
	ТекущееДействие = "ОтправитьЗапросыАЗ";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

