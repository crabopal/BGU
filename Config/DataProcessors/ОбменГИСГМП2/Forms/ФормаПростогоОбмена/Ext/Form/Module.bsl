&НаКлиенте
Процедура ОтметитьДляКвитирования(Команда)
	ОтметитьНачисленияИПлатежиДляКвитирования();
КонецПроцедуры

&НаСервере
Процедура ОтметитьНачисленияИПлатежиДляКвитирования()
	СоответствиеДокументов = Новый Соответствие;
	СписокОтмеченныеКвитанции.Очистить();
	СписокОтмеченныеПлатежиДляКвитирования.Очистить();
	
	Запрос = Новый Запрос;
				
	СтруктураОтбора = Новый Структура("ЕстьПлатеж",Истина);
	Запрос.УстановитьПараметр("МассивНачислений",ПолучитьДоступныеДляОтметкиКвитанции(СтруктураОтбора));
					
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоответствиеНачисленийИПлатежей.Платеж КАК Платеж,
		|	СоответствиеНачисленийИПлатежей.Начисление КАК Начисление
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Начисление В(&МассивНачислений)
		|	И СоответствиеНачисленийИПлатежей.ТребуетсяКвитирование = 1";

	РезультатЗапроса = Запрос.Выполнить();
	Таб = РезультатЗапроса.Выгрузить();
	СписокОтмеченныеПлатежиДляКвитирования.ЗагрузитьЗначения(Таб.ВыгрузитьКолонку("Платеж"));
    Таб.Свернуть("Начисление");
	
	СписокОтмеченныеКвитанции.ЗагрузитьЗначения(Таб.ВыгрузитьКолонку("Начисление"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПлатежиДляКвитирования,"ОтмеченныеПлатежи",СписокОтмеченныеПлатежиДляКвитирования,Истина);		
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокКвитанций,"ОтмеченныеКвитанции",СписокОтмеченныеКвитанции,Истина);

КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокНастройкеЗапросаДанныхИзОчереди()
	Если ВыполнятьЗапросДанныхПослеОтправкиСообщения
		И ВремяЗапросаДанныхИзОчереди>0 Тогда
		
		ТекстЗаголовка = НСтр("ru='Настройка запроса данных из очереди (%1 сек.)'");
		ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка,ВремяЗапросаДанныхИзОчереди);
		Элементы.ФормаНастройкаЗапросаДанныхИзОчереди.Заголовок = ТекстЗаголовка;
	КонецЕсли;	
КонецПроцедуры


#Область ОчередьЗапросовКСервису

&НаКлиенте
Асинх Процедура ОбработатьОчередьЗапросов(Команда)
	
	Если ВключенАвтоматическийОбменОчереди Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Включена автоматическая обработка очереди запросов к сервису.'"));
		Возврат;	
	КонецЕсли;
	
	Элементы.ОбработатьОчередьЗапросов.Пометка = НЕ Элементы.ОбработатьОчередьЗапросов.Пометка;
		
	Если Элементы.ОбработатьОчередьЗапросов.Пометка Тогда
		ВыполнятьОбработкуОчередиЗапросов = Истина;	
		ЕстьЗапросыВОчередиВОбработке = Истина;
		Элементы.ОбработатьОчередьЗапросов.Отображение = ОтображениеКнопки.КартинкаИТекст;
	Иначе
		ВыполнятьОбработкуОчередиЗапросов = Ложь;
		Элементы.ОбработатьОчередьЗапросов.Отображение = ОтображениеКнопки.Текст;
	КонецЕсли;
	
	Если ВыполнятьОбработкуОчередиЗапросов = Ложь Тогда
		ВключитьОтключитьАвтоматическийОбменОчередиЗапросов();
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПриступитьКОбработкеОчередиЗапросов",0.2,Истина);
		
КонецПроцедуры

&НаКлиенте
Асинх Процедура ОбрабатыватьОчередьЗапросовПостоянно(Команда)
	
	Если Элементы.ОбрабатыватьОчередьЗапросовПостоянно.Пометка = Ложь Тогда
		ТекстВопроса = НСтр("ru='После включения автоматического обмена работа пользователей в данном сеансе не рекомендуется. 
		|Включить автоматический обмен?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса,РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ОбрабатыватьОчередьЗапросовПостоянно.Пометка = НЕ Элементы.ОбрабатыватьОчередьЗапросовПостоянно.Пометка;
	
	Если Элементы.ОбрабатыватьОчередьЗапросовПостоянно.Пометка Тогда
		ВыполнятьОбработкуОчередиЗапросов = Истина;	
		ЕстьЗапросыВОчередиВОбработке = Истина;
		ВключенАвтоматическийОбменОчереди = Истина;
		
		Если Элементы.ОбработатьОчередьЗапросов.Пометка Тогда
			Элементы.ОбработатьОчередьЗапросов.Пометка = Ложь;
			Элементы.ОбработатьОчередьЗапросов.Отображение = ОтображениеКнопки.Текст;
		КонецЕсли;
		
		Элементы.ОбрабатыватьОчередьЗапросовПостоянно.Отображение = ОтображениеКнопки.КартинкаИТекст;
		
	Иначе
		ВыполнятьОбработкуОчередиЗапросов = Ложь;
		ВключенАвтоматическийОбменОчереди = Ложь;
		Элементы.ОбрабатыватьОчередьЗапросовПостоянно.Отображение = ОтображениеКнопки.Текст;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаАвтоматическийОбменОчереди","Видимость",ВключенАвтоматическийОбменОчереди);
	
	Если ВключенАвтоматическийОбменОчереди = Ложь Тогда
		ВключитьОтключитьАвтоматическийОбменОчередиЗапросов();
		Возврат;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПриступитьКОбработкеОчередиЗапросов",0.2,Истина);
	
КонецПроцедуры


&НаКлиенте
Асинх Процедура ПриступитьКОбработкеОчередиЗапросов() Экспорт
	
	ТекущееДействие = "ОбработатьЗапросы";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
	
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры


&НаСервере
Процедура ОбработатьПользовательскиеЗапросыНаСервере(ЕстьОшибка,ПродолжениеНеТребуется)
		
	РезультатФормирования.Очистить();         
	ФайлыРезультатаФормирования.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();		
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 10
		|	ВыполняемыеЗапросыОчередиКГИСГМП.Организация КАК Организация,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиОбщегоЗапроса КАК УИДНастройкиОбщегоЗапроса,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиДетальногоЗапроса КАК УИДНастройкиДетальногоЗапроса,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДВыполняемогоЗапросаКГИСГМП КАК УИДВыполняемогоЗапросаКГИСГМП,
		|	ОчередьЗапросовКГИСГМПДетальные.ФорматОбмена КАК ФорматОбмена,
		|	ОчередьЗапросовКГИСГМПДетальные.ЭталонноеСообщение КАК ЭталонноеСообщение,
		|	ОчередьЗапросовКГИСГМПДетальные.ДатаНачалаДетальная КАК ДатаНачалаДетальная,
		|	ОчередьЗапросовКГИСГМПДетальные.ДатаОкончанияДетальная КАК ДатаОкончанияДетальная,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.СтатусВыполняемогоЗапроса КАК СтатусВыполняемогоЗапроса,
		|	ОчередьЗапросовКГИСГМПДетальные.СтатусДетальногоЗапроса КАК СтатусДетальногоЗапроса,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.СтраницаРезультата КАК СтраницаРезультата,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.РезультатОбработки КАК РезультатОбработки,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.ДокументовВОтвете КАК ДокументовВОтвете,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.ЕстьОшибка КАК ЕстьОшибка,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.ТекстОшибки КАК ТекстОшибки,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.ИдентификаторСообщения КАК ИдентификаторСообщения,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.НуженСледующийЗапрос КАК НуженСледующийЗапрос,
		|	ВЫБОР
		|		КОГДА ВыполняемыеЗапросыОчередиКГИСГМП.СтатусВыполняемогоЗапроса = &ВРаботе
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПолеПорядка1,
		|	ВЫБОР
		|		КОГДА ОчередьЗапросовКГИСГМПДетальные.СтатусДетальногоЗапроса = &ВРаботе
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПолеПорядка2,
		|	ОчередьЗапросовКГИСГМПДетальные.ТипУчастникаГИСГМП КАК ТипУчастникаГИСГМП,
		|	ОчередьЗапросовКГИСГМПДетальные.ДатаСоздания КАК ДатаСоздания,
		|	ОчередьЗапросовКГИСГМПОбщие.СтатусОбщегоЗапроса КАК СтатусОбщегоЗапроса
		|ИЗ
		|	РегистрСведений.ВыполняемыеЗапросыОчередиКГИСГМП КАК ВыполняемыеЗапросыОчередиКГИСГМП
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОчередьЗапросовКГИСГМПДетальные КАК ОчередьЗапросовКГИСГМПДетальные
		|		ПО ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиДетальногоЗапроса = ОчередьЗапросовКГИСГМПДетальные.УИДНастройкиДетальногоЗапроса
		|			И ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиОбщегоЗапроса = ОчередьЗапросовКГИСГМПДетальные.УИДНастройкиОбщегоЗапроса
		|			И ВыполняемыеЗапросыОчередиКГИСГМП.Организация = ОчередьЗапросовКГИСГМПДетальные.Организация
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОчередьЗапросовКГИСГМПОбщие КАК ОчередьЗапросовКГИСГМПОбщие
		|		ПО ВыполняемыеЗапросыОчередиКГИСГМП.Организация = ОчередьЗапросовКГИСГМПОбщие.Организация
		|			И ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиОбщегоЗапроса = ОчередьЗапросовКГИСГМПОбщие.УИДНастройкиОбщегоЗапроса
		|ГДЕ
		|	ВыполняемыеЗапросыОчередиКГИСГМП.Организация В(&МассивУчастниковОрганизаций)
		|	И ВыполняемыеЗапросыОчередиКГИСГМП.СтатусВыполняемогоЗапроса В(&СтатусыВыполняемогоЗапроса)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтраницаРезультата УБЫВ,
		|	ПолеПорядка1,
		|	ПолеПорядка2,
		|	ОчередьЗапросовКГИСГМПДетальные.ДатаСоздания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК Поле1
		|ИЗ
		|	РегистрСведений.ВыполняемыеЗапросыОчередиКГИСГМП КАК ВыполняемыеЗапросыОчередиКГИСГМП
		|ГДЕ
		|	ВыполняемыеЗапросыОчередиКГИСГМП.Организация В(&МассивУчастниковОрганизаций)
		|	И ВыполняемыеЗапросыОчередиКГИСГМП.СтатусВыполняемогоЗапроса В(&СтатусыВыполняемогоЗапроса)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА
		|ИЗ
		|	РегистрСведений.ВыполняемыеЗапросыОчередиКГИСГМП КАК ВыполняемыеЗапросыОчередиКГИСГМП
		|ГДЕ
		|	ВыполняемыеЗапросыОчередиКГИСГМП.Организация В(&МассивУчастниковОрганизаций)
		|	И ВыполняемыеЗапросыОчередиКГИСГМП.СтатусВыполняемогоЗапроса = &СтатусОтправлен
		|	И ВыполняемыеЗапросыОчередиКГИСГМП.ДатаОбмена >= &КонечнаяДатаОбмена";
	
	//в работе устанавливается, когда мы сформировали xml по записи для последующей отвправки,
	//а также когда создается запись для получения следуюей страницы для уже обработанного запроса

	СтатусыВыполняемогоЗапроса = Новый Массив;
	СтатусыВыполняемогоЗапроса.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Запланирован);
	СтатусыВыполняемогоЗапроса.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВРаботе);
	
	Запрос.УстановитьПараметр("МассивУчастниковОрганизаций", МассивУчастниковОрганизаций);
	Запрос.УстановитьПараметр("СтатусыВыполняемогоЗапроса", СтатусыВыполняемогоЗапроса);
	Запрос.УстановитьПараметр("ВРаботе", Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВРаботе);
	
    //в ГИС ГМП хранятся сообщения не более 15 дней, в ИС УНП/ИС РНИП - 30 дней
	//Поэтому если сообщение отрпавлено более 15/30 дней назад, и ответ не получен (в статусе Отпавлено), то ожидать ответа смысла нет, 
	//и не считаем что наличие только таких сообщений необходимость продолжать обработку.
	
	Если ОбменГИСГМП Тогда
		КолДней = 15;
	Иначе
		КолДней = 30;
	КонецЕсли;
	ТекДатаКонечная = ТекущаяДата()-КолДней*86400;
	
	Запрос.УстановитьПараметр("СтатусОтправлен", Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Отправлен);
	Запрос.УстановитьПараметр("КонечнаяДатаОбмена", ТекДатаКонечная);
		
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика;
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();
	
	ЕстьЗапросыВОчередиВОбработке = НЕ РезультатыЗапроса[1].Пустой(); 
	
	ТекМассивФорматовЭкспорта = Новый Массив;
	
	ЕстьЗапросыДляОбмена = Ложь;
	
	НомерТек = 1;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ЗаписьВыполняемогоЗапроса = РегистрыСведений.ВыполняемыеЗапросыОчередиКГИСГМП.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьВыполняемогоЗапроса,ВыборкаДетальныеЗаписи,"Организация,УИДНастройкиОбщегоЗапроса,УИДНастройкиДетальногоЗапроса,УИДВыполняемогоЗапросаКГИСГМП");

		ЗаписьВыполняемогоЗапроса.Прочитать();
		Если ЗаписьВыполняемогоЗапроса.Выбран() Тогда
			
			ТекСодержимоеФайла = ВыборкаДетальныеЗаписи.ЭталонноеСообщение.Получить();
			
			ТекUUID = БиблиотекаФункцийОбмена.ПолучитьUUIDТекущегоВремени();				
			ТекСодержимоеФайла = СтрЗаменить(ТекСодержимоеФайла,"%ИдентификаторСообщения%",ТекUUID);
			
			ТекДата = Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()),"ДФ=yyyy-MM-ddTHH:mm:ssZ");
			ТекСодержимоеФайла = СтрЗаменить(ТекСодержимоеФайла,"%ТекущаяДата%",ТекДата);
			
			ТекСтраница = Формат(ВыборкаДетальныеЗаписи.СтраницаРезультата,"ЧГ=0");
			ТекСодержимоеФайла = СтрЗаменить(ТекСодержимоеФайла,"%СтраницаРезультата%",ТекСтраница);
			
			СтрФайлов = ФайлыРезультатаФормирования.Добавить();
			СтрФайлов.НомерПакета = НомерТек;
			СтрФайлов.СодержимоеФайла = ТекСодержимоеФайла;
			СтрФайлов.ИдентификаторСообщения = ТекUUID;
			СтрФайлов.ФорматОбмена = ВыборкаДетальныеЗаписи.ФорматОбмена;
				
			СтрФайлов.ТекущийУчастник = ВыборкаДетальныеЗаписи.Организация;
			СтрФайлов.ВидСообщения = ВидСообщения;
			СтрФайлов.ТипУчастника = ВыборкаДетальныеЗаписи.ТипУчастникаГИСГМП;
			
			НовСтр = РезультатФормирования.Добавить();
			НовСтр.Формат = ВыборкаДетальныеЗаписи.ФорматОбмена;
			НовСтр.Объект = ВыборкаДетальныеЗаписи.УИДВыполняемогоЗапросаКГИСГМП;
			НовСтр.ТекущийУчастник = ВыборкаДетальныеЗаписи.Организация;
			НовСтр.НомерПакета = НомерТек;
			
			ЗаписьВыполняемогоЗапроса.ИдентификаторСообщения = ТекUUID;
			ЗаписьВыполняемогоЗапроса.СтатусВыполняемогоЗапроса = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВРаботе;
			ЗаписьВыполняемогоЗапроса.Записать();
			//ЕстьОшибки = ЕстьОшибки ИЛИ ЗначениеЗаполнено(НовСтр.ОписаниеОшибки);
						
			НомерТек = НомерТек + 1;
			
			Если ТекМассивФорматовЭкспорта.Найти(ВыборкаДетальныеЗаписи.ФорматОбмена) = Неопределено Тогда
				ТекМассивФорматовЭкспорта.Добавить(ВыборкаДетальныеЗаписи.ФорматОбмена);	
			КонецЕсли;
			
			ЕстьЗапросыДляОбмена = Истина;
			
			Если ВыборкаДетальныеЗаписи.СтатусДетальногоЗапроса = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Запланирован Тогда
				ЗаписьДетальногоЗапроса = РегистрыСведений.ОчередьЗапросовКГИСГМПДетальные.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(ЗаписьДетальногоЗапроса,ВыборкаДетальныеЗаписи,"Организация,УИДНастройкиОбщегоЗапроса,УИДНастройкиДетальногоЗапроса");
		        ЗаписьДетальногоЗапроса.Прочитать();
				
				ЗаписьДетальногоЗапроса.СтатусДетальногоЗапроса = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВРаботе;
				ЗаписьДетальногоЗапроса.Записать();
				
			КонецЕсли;
			
			Если ВыборкаДетальныеЗаписи.СтатусОбщегоЗапроса = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Запланирован Тогда
				ЗаписьОбщегоЗапроса = РегистрыСведений.ОчередьЗапросовКГИСГМПОбщие.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(ЗаписьОбщегоЗапроса,ВыборкаДетальныеЗаписи,"Организация,УИДНастройкиОбщегоЗапроса");
		        ЗаписьОбщегоЗапроса.Прочитать();
				
				ЗаписьОбщегоЗапроса.СтатусОбщегоЗапроса = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВРаботе;
				ЗаписьОбщегоЗапроса.Записать();
				
			КонецЕсли;
			
		КонецЕсли;			
						
	КонецЦикла;
	
	Если ЕстьЗапросыДляОбмена = Ложь
		И ЕстьЗапросыВОчередиВОбработке = Ложь Тогда
		// обработка завершена, если нет запросов для обработки и все запросы обработаны - если это не постоянный обмен 
		
		Если ВключенАвтоматическийОбменОчереди = Ложь Тогда
			ВыполнятьОбработкуОчередиЗапросов = Ложь;
			Элементы.ОбработатьОчередьЗапросов.Отображение = ОтображениеКнопки.Текст;
			Элементы.ОбработатьОчередьЗапросов.Пометка = Ложь;			
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Обработка очереди запросов к серверу завершена.'"));
		КонецЕсли;
		
		
	КонецЕсли;
		 
	ПродолжениеНеТребуется = (ЕстьЗапросыДляОбмена = Ложь);
	
	// если есть записи в РС ОчередиЗапросовКГИСГМП, то через 20 секунд будем запрашивать результат, если нет то 40
	Если ЕстьЗапросыДляОбмена Тогда
		ПериодЗапросаДанныхИзОчереди = 20;
	Иначе
		ПериодЗапросаДанныхИзОчереди = 40;
	КонецЕсли;
	
	//Заполним настройку заголовков
	Если ТребуетсяПодтверждениеПолученныхСообщений
		И ЗначениеЗаполнено(ФорматПодтверждения) Тогда
		ТекМассивФорматовЭкспорта.Добавить(ФорматПодтверждения);	
	КонецЕсли;
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ТекМассивФорматовЭкспорта));


КонецПроцедуры

&НаСервере
Процедура ЗапросыОбщиеПередУдалениемНаСервере(ВыделенныеСтроки)
	Для Каждого ЭлМас Из ВыделенныеСтроки Цикл
		НаборЗаписей = РегистрыСведений.ОчередьЗапросовКГИСГМПДетальные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(ЭлМас.Организация);
		НаборЗаписей.Отбор.УИДНастройкиОбщегоЗапроса.Установить(ЭлМас.УИДНастройкиОбщегоЗапроса);
		НаборЗаписей.Записать(Истина);
		
		НаборЗаписей = РегистрыСведений.ВыполняемыеЗапросыОчередиКГИСГМП.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(ЭлМас.Организация);
		НаборЗаписей.Отбор.УИДНастройкиОбщегоЗапроса.Установить(ЭлМас.УИДНастройкиОбщегоЗапроса);
		НаборЗаписей.Записать(Истина);
		
		НаборЗаписей = РегистрыСведений.ОчередьЗапросовКГИСГМПОбщие.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(ЭлМас.Организация);
		НаборЗаписей.Отбор.УИДНастройкиОбщегоЗапроса.Установить(ЭлМас.УИДНастройкиОбщегоЗапроса);
		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
	Элементы.ЗапросыОбщие.Обновить();
	Элементы.ЗапросыДетальные.Обновить();
	Элементы.ЗапросыВыполняемые.Обновить();
КонецПроцедуры

