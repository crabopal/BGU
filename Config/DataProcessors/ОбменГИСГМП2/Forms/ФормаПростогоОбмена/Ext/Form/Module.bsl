#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаПлатежиДляКвитирования

&НаКлиенте
Процедура СписокПлатежиДляКвитированияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если Поле.Имя = "СписокПлатежиДляКвитированияИспользовать" Тогда 
		СтандартнаяОбработка = Ложь;
		ОбновлятьПараметрКвитанций = Ложь;
		//1 - не отмечено, 2 - отмечено
		Если ТекДанные.Использовать = 1 Тогда
			
			СписокОтмеченныеПлатежиДляКвитирования.Добавить(ТекДанные.ПлатежСсылка);
			
			Если СписокОтмеченныеКвитанции.НайтиПоЗначению(ТекущаяКвитанция) = Неопределено Тогда
				СписокОтмеченныеКвитанции.Добавить(ТекущаяКвитанция);
				ОбновлятьПараметрКвитанций = Истина;
			КонецЕсли;
			
		Иначе
			
			СтрокаСписка = СписокОтмеченныеПлатежиДляКвитирования.НайтиПоЗначению(ТекДанные.ПлатежСсылка);
			Если СтрокаСписка<>Неопределено Тогда
				СписокОтмеченныеПлатежиДляКвитирования.Удалить(СтрокаСписка);
			КонецЕсли;
			ЕстьОтмеченныеПлатежи = ПроверитьОтмеченныеПлатежиПоНачислению(СписокОтмеченныеПлатежиДляКвитирования,ТекущаяКвитанция);
			
			Если ЕстьОтмеченныеПлатежи = Ложь Тогда
				СтрокаСписка = СписокОтмеченныеКвитанции.НайтиПоЗначению(ТекущаяКвитанция);
				Если СтрокаСписка <> Неопределено Тогда
					СписокОтмеченныеКвитанции.Удалить(СтрокаСписка);
					ОбновлятьПараметрКвитанций = Истина;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПлатежиДляКвитирования,"ОтмеченныеПлатежи",СписокОтмеченныеПлатежиДляКвитирования,Истина);
		
		Если ОбновлятьПараметрКвитанций Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокКвитанций,"ОтмеченныеКвитанции",СписокОтмеченныеКвитанции,Истина);
		КонецЕсли;
	Иначе
		
		ПоказатьЗначение(,ТекДанные.ПлатежСсылка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьОтмеченныеПлатежиПоНачислению(Знач СписокОтмеченныеПлатежиДляКвитирования,Начисление)	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоответствиеНачисленийИПлатежей.Платеж КАК Платеж
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Начисление = &Начисление
		|	И СоответствиеНачисленийИПлатежей.БанковскийИдентификаторПлатежаЗаполнен
		|	И СоответствиеНачисленийИПлатежей.Платеж В(&Платежи)";
	
	Запрос.УстановитьПараметр("Начисление", Начисление);
	Запрос.УстановитьПараметр("Платежи", СписокОтмеченныеПлатежиДляКвитирования);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокЗапросов

&НаКлиенте
Процедура СписокЗапросовПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ТекущийЗапрос = Неопределено;
	Иначе
		ТекущийЗапрос = ТекДанные.Ссылка;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПоказатьИсториюОбмена",0.5,Истина);
	
	ИмяТабЧасти = "СписокЗапросов";
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура СписокЗапросовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекДанные.Ссылка) <> Тип("ДокументСсылка.ЗапросУНИФО") Тогда
		Возврат;
	КонецЕсли;
		
	Если СтрЗаканчиваетсяНа(Поле.Имя,"РезультатЗагрузки") Тогда
		СтандартнаяОбработка = Ложь;
		Если ТекДанные.ЗагруженоДанных = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура("ЗапросСМЭВ",ТекДанные.Ссылка);
		ОткрытьФорму("РегистрСведений.ЗагруженныеДанныеСМЭВ3.Форма.ФормаОтображенияЗагруженныхДанных",ПараметрыФормы,ЭтотОбъект,ТекДанные.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗапросыНачисленийАЗ

&НаКлиенте
Процедура ЗапросыНачисленийАЗПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.ЗапросыНачисленийАЗ.ТекущиеДанные;
