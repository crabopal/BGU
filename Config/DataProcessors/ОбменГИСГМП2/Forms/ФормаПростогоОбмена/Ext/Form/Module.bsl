&НаСервере
Функция СформироватьВыгрузку(Знач ВыгружаемыеОбъекты, Знач ПоместитьВАрхив = Ложь)

	ВыгруженныеФайлы = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДляСвязи.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|	ОчередьЗапросовКГИСГМПОбщие.ТипЗапрашиваемыхДанных КАК ТипЗапрашиваемыхДанных,
	|	ДанныеДляСвязи.СтраницаРезультата КАК СтраницаРезультата
	|ПОМЕСТИТЬ ДанныеТипаЗапроса
	|ИЗ
	|	РегистрСведений.ОчередьЗапросовКГИСГМПОбщие КАК ОчередьЗапросовКГИСГМПОбщие
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВыполняемыеЗапросыОчередиКГИСГМП.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|			ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиОбщегоЗапроса КАК УИДНастройкиОбщегоЗапроса,
	|			ВыполняемыеЗапросыОчередиКГИСГМП.Организация КАК Организация,
	|			ВыполняемыеЗапросыОчередиКГИСГМП.СтраницаРезультата КАК СтраницаРезультата
	|		ИЗ
	|			РегистрСведений.ВыполняемыеЗапросыОчередиКГИСГМП КАК ВыполняемыеЗапросыОчередиКГИСГМП
	|		ГДЕ
	|			ВыполняемыеЗапросыОчередиКГИСГМП.ИдентификаторСообщения В(&ИдентификаторыСообщения)) КАК ДанныеДляСвязи
	|		ПО ОчередьЗапросовКГИСГМПОбщие.Организация = ДанныеДляСвязи.Организация
	|			И ОчередьЗапросовКГИСГМПОбщие.УИДНастройкиОбщегоЗапроса = ДанныеДляСвязи.УИДНастройкиОбщегоЗапроса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодготовленныеДанные.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|	ПодготовленныеДанные.ДатаОтправкиСообщенияВСервис КАК ДатаОтправкиСообщенияВСервис,
	|	ПодготовленныеДанные.ДатаРезультатаИзСервиса КАК ДатаРезультатаИзСервиса,
	|	ПодготовленныеДанные.SendRequestRequest КАК SendRequestRequest,
	|	ПодготовленныеДанные.SendRequestResponse КАК SendRequestResponse,
	|	ПодготовленныеДанные.GetResponseRequest КАК GetResponseRequest,
	|	ПодготовленныеДанные.GetResponseResponse КАК GetResponseResponse,
	|	ПодготовленныеДанные.Данные КАК Данные,
	|	СообщенияПодтвержденияПолученияДанныхИзСМЭВ3.ДатаЗапроса КАК ДатаПодтверждения,
	|	СообщенияПодтвержденияПолученияДанныхИзСМЭВ3.СообщениеЗапросПодтверждения КАК AckRequest,
	|	СообщенияПодтвержденияПолученияДанныхИзСМЭВ3.СообщениеОтветПодтверждения КАК AckResponse,
	|	ЕСТЬNULL(ДанныеТипаЗапроса.ТипЗапрашиваемыхДанных, """") КАК ТипЗапрашиваемыхДанных,
	|	ЕСТЬNULL(ДанныеТипаЗапроса.СтраницаРезультата, """") КАК СтраницаРезультата,
	|	ПРЕДСТАВЛЕНИЕ(ПодготовленныеДанные.ФорматОбмена) КАК ФорматОбмена
	|ИЗ
	|	(ВЫБРАТЬ
	|		СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|		СообщенияИмпортаДанныхВСМЭВ3.ДатаОбмена КАК ДатаОтправкиСообщенияВСервис,
	|		СообщенияЗапросаДанныхОчередиСМЭВ3.ДатаЗапроса КАК ДатаРезультатаИзСервиса,
	|		СообщенияИмпортаДанныхВСМЭВ3.СообщениеЗапрос КАК SendRequestRequest,
	|		СообщенияИмпортаДанныхВСМЭВ3.СообщениеОтвет КАК SendRequestResponse,
	|		СообщенияЗапросаДанныхОчередиСМЭВ3.СообщениеЗапрос КАК GetResponseRequest,
	|		СообщенияЗапросаДанныхОчередиСМЭВ3.СообщениеОтвет КАК GetResponseResponse,
	|		СообщенияЗапросаДанныхОчередиСМЭВ3.ИдентификаторСообщенияСМЭВ КАК ИдентификаторСообщенияСМЭВ,
	|		ДанныеИсходящихСообщенийСМЭВ3.Данные КАК Данные,
	|		СообщенияИмпортаДанныхВСМЭВ3.ФорматОбмена КАК ФорматОбмена
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ПРЕДСТАВЛЕНИЕ(ДанныеИсходящихСообщенийСМЭВ3.Данные) КАК Данные,
	|			ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения
	|		ИЗ
	|			РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК ДанныеИсходящихСообщенийСМЭВ3
	|		ГДЕ
	|			ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения В(&ИдентификаторыСообщения)) КАК ДанныеИсходящихСообщенийСМЭВ3
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
	|			ПО ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения = СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СообщенияЗапросаДанныхОчередиСМЭВ3 КАК СообщенияЗапросаДанныхОчередиСМЭВ3
	|			ПО ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения = СообщенияЗапросаДанныхОчередиСМЭВ3.ИдентификаторСообщенияУчастника) КАК ПодготовленныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СообщенияПодтвержденияПолученияДанныхИзСМЭВ3 КАК СообщенияПодтвержденияПолученияДанныхИзСМЭВ3
	|		ПО ПодготовленныеДанные.ИдентификаторСообщенияСМЭВ = СообщенияПодтвержденияПолученияДанныхИзСМЭВ3.ИдентификаторСообщенияСМЭВ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеТипаЗапроса КАК ДанныеТипаЗапроса
	|		ПО ПодготовленныеДанные.ИдентификаторСообщения = ДанныеТипаЗапроса.ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторыСообщения", ВыгружаемыеОбъекты);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если ПоместитьВАрхив Тогда
		ИмяАрхива     = ПолучитьИмяВременногоФайла("zip");
		КаталогАрхива = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПолучитьИмяВременногоФайла());
		СоздатьКаталог(КаталогАрхива);
		АрхиваторОбщий= Новый ЗаписьZipФайла(ИмяАрхива);
	КонецЕсли;
	
	ТаблицаИменИПояснений = Новый ТаблицаЗначений;
	ТаблицаИменИПояснений.Колонки.Добавить("ИмяЗначения");
	ТаблицаИменИПояснений.Колонки.Добавить("ИмяФайла");
	
	НовСтр = ТаблицаИменИПояснений.Добавить();
	НовСтр.ИмяЗначения = "SendRequestRequest";
	НовСтр.ИмяФайла = "1.1.SendRequestRequest - шаг 1 (запрос).txt";
	
	НовСтр = ТаблицаИменИПояснений.Добавить();
	НовСтр.ИмяЗначения = "SendRequestResponse";
	НовСтр.ИмяФайла = "1.2.SendRequestResponse - шаг 1 (ответ).txt";
	
	НовСтр = ТаблицаИменИПояснений.Добавить();
	НовСтр.ИмяЗначения = "GetResponseRequest";
	НовСтр.ИмяФайла = "2.1.GetResponseRequest - шаг 2 (запрос).txt";
	
	НовСтр = ТаблицаИменИПояснений.Добавить();
	НовСтр.ИмяЗначения = "GetResponseResponse";
	НовСтр.ИмяФайла = "2.2.GetResponseResponse - шаг 2 (ответ).txt";
	
	НовСтр = ТаблицаИменИПояснений.Добавить();
	НовСтр.ИмяЗначения = "AckRequest";
	НовСтр.ИмяФайла = "3.1.AckRequest - шаг 3 (запрос).txt";
	
	НовСтр = ТаблицаИменИПояснений.Добавить();
	НовСтр.ИмяЗначения = "AckResponse";
	НовСтр.ИмяФайла = "3.2.AckResponse - шаг 3 (ответ).txt";
	
	Инд = 0;
	МассивИменФайлов = Новый Массив; //бывает по одному документу несколько сообщений, поэтому для корректной выгрузки нужно добавлять суффикс
	
	Пока Выборка.Следующий() Цикл
		ТекИмяАрхива     = ПолучитьИмяВременногоФайла("zip");
		ТекКаталогАрхива = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПолучитьИмяВременногоФайла());
		СоздатьКаталог(ТекКаталогАрхива);
		ТекАрхиватор = Новый ЗаписьZipФайла(ТекИмяАрхива);
		
		Если ЗначениеЗаполнено(Выборка.Данные) Тогда
			НачалоИмени = Строка(Выборка.Данные);
		ИначеЕсли ЗначениеЗаполнено(Выборка.ТипЗапрашиваемыхДанных) Тогда
			НачалоИмени = "Очередь запросов " + Выборка.ТипЗапрашиваемыхДанных + ", стр. "+ Выборка.СтраницаРезультата;
		ИначеЕсли ЗначениеЗаполнено(Выборка.ФорматОбмена) Тогда
			НачалоИмени = Выборка.ФорматОбмена;	
		Иначе
			НачалоИмени = "Очередь запросов";
		КонецЕсли;
		
		СохраняемоеИмяОтдельногоАрхива = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(НачалоИмени+" обмен от "+Выборка.ДатаОтправкиСообщенияВСервис," ");
				
		Если МассивИменФайлов.Найти(СохраняемоеИмяОтдельногоАрхива) = Неопределено Тогда
			МассивИменФайлов.Добавить(СохраняемоеИмяОтдельногоАрхива);
		Иначе
			Инд = Инд + 1;
			СохраняемоеИмяОтдельногоАрхива = СохраняемоеИмяОтдельногоАрхива + "("+Инд+")";
			МассивИменФайлов.Добавить(СохраняемоеИмяОтдельногоАрхива);
		КонецЕсли;
		
		СохраняемоеИмяОтдельногоАрхива = СохраняемоеИмяОтдельногоАрхива + ".zip";
		
		Для Каждого СтрТЧ Из ТаблицаИменИПояснений Цикл
			Если ТипЗнч(Выборка[СтрТЧ.ИмяЗначения]) = Тип("ХранилищеЗначения") Тогда
				ЗаписываемоеЗначение = Выборка[СтрТЧ.ИмяЗначения].Получить();
				Если ЗначениеЗаполнено(ЗаписываемоеЗначение) Тогда
					ТекИмя = ПолучитьИмяВременногоФайла("txt");
					ЗаписьТекста = Новый ЗаписьТекста(ТекИмя,КодировкаТекста.UTF8);
					ЗаписьТекста.Записать(ЗаписываемоеЗначение);
					ЗаписьТекста.Закрыть();
					
					ДДанные = Новый ДвоичныеДанные(ТекИмя);				
					Если Сред(ДДанные, 1, 8) = "EF BB BF" Тогда
						Строка64 = Base64Строка(ДДанные);
						Строка64 = Прав(Строка64,СтрДлина(Строка64)-4); // Удаляем 3 символа BOM
						ДДанные = Base64Значение(Строка64);
						ДДанные.Записать(ТекИмя);
						
						Строка64 = Неопределено
					КонецЕсли;
					ДДанные = Неопределено;
					
					ПереместитьФайл(ТекИмя, ТекКаталогАрхива + СтрТЧ.ИмяФайла);
					ТекАрхиватор.Добавить(ТекКаталогАрхива + СтрТЧ.ИмяФайла);
			
				КонецЕсли;
			ИначеЕсли СтрТЧ.ИмяЗначения = "GetResponseRequest" Тогда
				//если ответа с данными на запрос нет (сервис еще не прислал или потерял),
				//то выгрузим файлы запросов и ответов по всем форматам запроса данных "GetResponseRequest",
				//чтобы предоставить в тех.поддержку все возможные файлы.
				
				ВыгрузитьПустыеФайлыЗапросаОчередиИОтвета(ТекКаталогАрхива,ТекАрхиватор);
				
			КонецЕсли;
				
		КонецЦикла;
		
		ТекАрхиватор.Записать();
		
		Если ПоместитьВАрхив Тогда
			
			ПереместитьФайл(ТекИмяАрхива, КаталогАрхива + СохраняемоеИмяОтдельногоАрхива);
			АрхиваторОбщий.Добавить(КаталогАрхива + СохраняемоеИмяОтдельногоАрхива);
			
		Иначе
			
			ОписаниеФайла = ОписаниеВыгруженногоФайла(ТекИмяАрхива, СохраняемоеИмяОтдельногоАрхива);
			Если ОписаниеФайла <> Неопределено Тогда	
				ВыгруженныеФайлы.Добавить(ОписаниеФайла);
			КонецЕсли;
			УдалитьФайлы(ТекИмяАрхива);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПоместитьВАрхив Тогда
		
		АрхиваторОбщий.Записать();
		ДанныеФайла   = Новый ДвоичныеДанные(ИмяАрхива);
		ОписаниеФайла = ОписаниеВыгруженногоФайла(ИмяАрхива, "Файлы обмена "+Формат(ТекущаяДатаСеанса(),"ДФ=yyyyMMdd")+".zip");
		Если ОписаниеФайла <> Неопределено Тогда	
			ВыгруженныеФайлы.Добавить(ОписаниеФайла);
		КонецЕсли;
		УдалитьФайлы(ИмяАрхива);
		
	КонецЕсли;
	
	Возврат ВыгруженныеФайлы;

КонецФункции // СформироватьВыгрузку()

&НаСервере
Процедура ВыгрузитьПустыеФайлыЗапросаОчередиИОтвета(ТекКаталогАрхива,ТекАрхиватор)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 50
		|	СообщенияЗапросаДанныхОчередиСМЭВ3.СообщениеЗапрос КАК GetResponseRequest,
		|	СообщенияЗапросаДанныхОчередиСМЭВ3.СообщениеОтвет КАК GetResponseResponse,
		|	СообщенияЗапросаДанныхОчередиСМЭВ3.ДатаЗапроса КАК ДатаЗапроса,
		|	ПРЕДСТАВЛЕНИЕ(СообщенияЗапросаДанныхОчередиСМЭВ3.ФорматОбмена) КАК ФорматПредставление,
		|	СообщенияЗапросаДанныхОчередиСМЭВ3.ФорматОбмена КАК ФорматСсылка
		|ИЗ
		|	РегистрСведений.СообщенияЗапросаДанныхОчередиСМЭВ3 КАК СообщенияЗапросаДанныхОчередиСМЭВ3
		|ГДЕ
		|	СообщенияЗапросаДанныхОчередиСМЭВ3.ЕстьДанные = ЛОЖЬ
		|	И СообщенияЗапросаДанныхОчередиСМЭВ3.СтатусОтправки = &СтатусОтправки
		|	И СообщенияЗапросаДанныхОчередиСМЭВ3.Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаЗапроса УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", УчастникОтправитель);
	Запрос.УстановитьПараметр("СтатусОтправки", Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Отправлен);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ТаблицаИменИПояснений = Новый ТаблицаЗначений;
	ТаблицаИменИПояснений.Колонки.Добавить("ИмяЗначения");
	ТаблицаИменИПояснений.Колонки.Добавить("ИмяФайла");
	
	НовСтр = ТаблицаИменИПояснений.Добавить();
	НовСтр.ИмяЗначения = "GetResponseRequest";
	НовСтр.ИмяФайла = "2.1.GetResponseRequest - шаг 2 (запрос %1).txt";
	
	НовСтр = ТаблицаИменИПояснений.Добавить();
	НовСтр.ИмяЗначения = "GetResponseResponse";
	НовСтр.ИмяФайла = "2.2.GetResponseResponse - шаг 2 (ответ %1) - данных нет.txt";
	
	МассивОбработанныхФорматов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		
		Если МассивОбработанныхФорматов.Найти(Выборка.ФорматСсылка) = Неопределено Тогда
			МассивОбработанныхФорматов.Добавить(Выборка.ФорматСсылка);
		Иначе
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрТЧ Из ТаблицаИменИПояснений Цикл
		
			ЗаписываемоеЗначение = Выборка[СтрТЧ.ИмяЗначения].Получить();
			Если ЗначениеЗаполнено(ЗаписываемоеЗначение) Тогда
				ТекИмя = ПолучитьИмяВременногоФайла("txt");
				ЗаписьТекста = Новый ЗаписьТекста(ТекИмя,КодировкаТекста.UTF8);
				ЗаписьТекста.Записать(ЗаписываемоеЗначение);
				ЗаписьТекста.Закрыть();
				
				ДДанные = Новый ДвоичныеДанные(ТекИмя);				
				Если Сред(ДДанные, 1, 8) = "EF BB BF" Тогда
					Строка64 = Base64Строка(ДДанные);
					Строка64 = Прав(Строка64,СтрДлина(Строка64)-4); // Удаляем 3 символа BOM
					ДДанные = Base64Значение(Строка64);
					ДДанные.Записать(ТекИмя);
					
					Строка64 = Неопределено
				КонецЕсли;
				ДДанные = Неопределено;
				
				ВыгружаемоеИмя = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрТЧ.ИмяФайла,Выборка.ФорматПредставление);
				
				ПереместитьФайл(ТекИмя, ТекКаталогАрхива + ВыгружаемоеИмя);
				ТекАрхиватор.Добавить(ТекКаталогАрхива + ВыгружаемоеИмя);
		
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ОписаниеВыгруженногоФайла(Знач ПолноеИмя, Знач ХранимоеИмя = "")

	Описание = Неопределено;
	
	Файл = Новый Файл(ПолноеИмя);
		
	Если Файл.Существует() Тогда
		Описание = Новый ОписаниеПередаваемогоФайла;
		Описание.Имя = ?(ПустаяСтрока(ХранимоеИмя),Файл.Имя,ХранимоеИмя);
		ДанныеФайла = Новый ДвоичныеДанные(Файл.ПолноеИмя);
		Описание.Хранение = ПоместитьВоВременноеХранилище(ДанныеФайла,УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции // ОписаниеВыгруженногоФайла()

#КонецОбласти


#КонецОбласти

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
		
	Если ТипЗнч(ЭтотОбъект.ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
		ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, ЭтотОбъект.ТекущийЭлемент);
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, ЭтотОбъект.ТекущийЭлемент, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	
	Если Элементы.ГруппаСтраницыОбмена.ТекущаяСтраница.Имя = "ГруппаАдминистраторЗапросов" Тогда
		Если Элементы.СтраницыЗапросыАЗ.ТекущаяСтраница.Имя = "СтраницаЗапросыНачислений" Тогда
			ИмяТабЧасти = "ЗапросыНачисленийАЗ";
		ИначеЕсли Элементы.СтраницыЗапросыАЗ.ТекущаяСтраница.Имя = "СтраницаЗапросыПлатежей" Тогда
			ИмяТабЧасти = "ЗапросыПлатежейАЗ";
		Иначе
			Возврат;
		КонецЕсли;
	ИначеЕсли Элементы.ГруппаСтраницыОбмена.ТекущаяСтраница.Имя = "ГруппаСтраницаСообщения" Тогда
		ИмяТабЧасти = "СписокЗапросов";
	Иначе
		Возврат;
	КонецЕсли;
	
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы[ИмяТабЧасти]);

КонецПроцедуры

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура ЗагруженныеНачисленияАЗ(Команда)
	ОткрытьФорму("Документ.НачислениеКонтрагентамГИСГМП.ФормаСписка");
КонецПроцедуры

&НаКлиенте
Процедура ЗагруженныеПлатежиАЗ(Команда)
	ОткрытьФорму("Документ.ПлатежКонтрагентовГИСГМП.ФормаСписка");
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьИсториюОбмена(Команда)
	ОткрытьФорму("Обработка.ОбменГИСГМП2.Форма.ФормаУдалениеИсторииОбмена",,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЗагруженныеДокументы(Команда)
	ОчиститьСообщения();
	
	ТекЗапись = Элементы.ИсторияОбменаЗапросовНачисленийВозвратов.ТекущиеДанные;
	Если ТекЗапись <> Неопределено Тогда
		ТекДок = ТекЗапись.ДокСсылка;
		Если ЗначениеЗаполнено(ТекДок) Тогда
			ПараметрыФормы = Новый Структура("ЗапросСМЭВ",ТекДок);
			ОткрытьФорму("РегистрСведений.ЗагруженныеДанныеСМЭВ3.Форма.ФормаОтображенияЗагруженныхДанных",ПараметрыФормы,ЭтотОбъект,ТекДок);	
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры


&НаКлиенте
Процедура НастройкаЗапросаДанныхИзОчереди(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВыполнятьЗапросДанныхПослеОтправкиСообщения",ВыполнятьЗапросДанныхПослеОтправкиСообщения);
	ПараметрыФормы.Вставить("ВремяЗапросаДанныхИзОчереди",ВремяЗапросаДанныхИзОчереди);
	
	ОписаниеОпов = Новый ОписаниеОповещения("ПослеИзмененияНастроекЗапросаДанныхИзОчереди",ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ОбменГИСГМП2.Форма.ФормаНастройкиЗапросаДанныхИзОчереди",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОпов,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияНастроекЗапросаДанныхИзОчереди(Результат,ДопПараметры)Экспорт
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Результат.Свойство("ВыполнятьЗапросДанныхПослеОтправкиСообщения",ВыполнятьЗапросДанныхПослеОтправкиСообщения);
	Результат.Свойство("ВремяЗапросаДанныхИзОчереди",ВремяЗапросаДанныхИзОчереди);	
	
	УстановитьЗаголовокНастройкеЗапросаДанныхИзОчереди();
КонецПроцедуры



#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьИсториюОбмена() Экспорт
	ОбновитьОтборИсторииОбмена();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтборИсторииОбмена()
	
	Если ОтображатьПанельОтборов
		И ИспользоватьОтборИстории Тогда
		
		Если Элементы.ГруппаСтраницыОбмена.ТекущаяСтраница = Элементы.ГруппаФормированиеПакетов Тогда
			
			Если Элементы.ГруппаСтраницыПакетыЗапросы.ТекущаяСтраница = Элементы.ГруппаПакетыНачисленийВозвратов Тогда
				
				Если Элементы.ГруппаДокументыДляПакетов.ТекущаяСтраница = Элементы.ГруппаФормированиеНачислений Тогда
									
					ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбменаНачисленийВозвратов,"ДокСсылка",ТекущаяКвитанция,Истина);
					
				ИначеЕсли Элементы.ГруппаДокументыДляПакетов.ТекущаяСтраница = Элементы.ГруппаФормированиеВозвратов Тогда
					
					ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбменаНачисленийВозвратов,"ДокСсылка",ТекущийВозврат,Истина);
					
				КонецЕсли;
				
			ИначеЕсли Элементы.ГруппаСтраницыПакетыЗапросы.ТекущаяСтраница = Элементы.ГруппаЗапросыНачисленийВозвратов Тогда
				
				МассивЗапросов = Новый Массив;
				
				Если Элементы.ГруппаДокументыДляПакетов.ТекущаяСтраница = Элементы.ГруппаФормированиеНачислений Тогда
					
					Если ЗначениеЗаполнено(ТекущаяКвитанция) Тогда
						МассивЗапросов = ПолучитьПараметрИсторияОбменаЗапросовНачисленийВозвратов(ТекущаяКвитанция);
					КонецЕсли;
					
					
				ИначеЕсли Элементы.ГруппаДокументыДляПакетов.ТекущаяСтраница = Элементы.ГруппаФормированиеВозвратов Тогда
					
					Если ЗначениеЗаполнено(ТекущийВозврат) Тогда
						МассивЗапросов = ПолучитьПараметрИсторияОбменаЗапросовНачисленийВозвратов(ТекущийВозврат);
					КонецЕсли;
					
				КонецЕсли;
				
				ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбменаЗапросовНачисленийВозвратов,"МассивЗапросов",МассивЗапросов,Истина);

							
			КонецЕсли;
			
		ИначеЕсли Элементы.ГруппаСтраницыОбмена.ТекущаяСтраница = Элементы.ГруппаПакетыДокументов Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбмена,"Данные",ТекущийПакет,Истина);
			
		ИначеЕсли Элементы.ГруппаСтраницыОбмена.ТекущаяСтраница = Элементы.ГруппаСтраницаСообщения Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбмена,"Данные",ТекущийЗапрос,Истина);
			
		ИначеЕсли Элементы.ГруппаСтраницыОбмена.ТекущаяСтраница = Элементы.ГруппаКаталогУслуг Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбмена,"Данные",ТекущийКаталог,Истина);
			
		ИначеЕсли Элементы.ГруппаСтраницыОбмена.ТекущаяСтраница = Элементы.ГруппаПодписки Тогда
			
			МассивДокументовПодписок = Новый Массив;
			МассивДокументовПодписок.Добавить(ТекущийДокументПодписки);
			МассивДокументовПодписок.Добавить(ПредопределенноеЗначение("Документ.ПодпискаНаУведомлениеГИСГМП.ПустаяСсылка"));//для вывода сообщений запроса доступных подписок
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбмена,"Данные",МассивДокументовПодписок,Истина);
			
		ИначеЕсли Элементы.ГруппаСтраницыОбмена.ТекущаяСтраница = Элементы.ГруппаАдминистраторЗапросов Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбмена,"Данные",ТекущийЗапрос,Истина);
			
		ИначеЕсли Элементы.ГруппаСтраницыОбмена.ТекущаяСтраница = Элементы.ГруппаДляПосредника Тогда
			
			МассивДокументовПосредника = Новый Массив;
			МассивДокументовПосредника.Добавить(ТекущееНачислениеОтПосредника);
			МассивДокументовПосредника.Добавить(ПредопределенноеЗначение("Документ.ЗапросУНИФО.ПустаяСсылка"));//для вывода сообщений запроса НСИ
			
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбмена,"Данные",МассивДокументовПосредника,Истина);
				
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрИсторияОбменаЗапросовНачисленийВозвратов(ДокументОтбора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗапросУНИФО.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ Таб
		|ИЗ
		|	Документ.ЗапросУНИФО КАК ЗапросУНИФО
		|ГДЕ
		|	ЗапросУНИФО.Начисление = &ДокументОтбора
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗапросУНИФО.Ссылка
		|ИЗ
		|	Документ.ЗапросУНИФО КАК ЗапросУНИФО
		|ГДЕ
		|	ЗапросУНИФО.ЗапрашиваемыеДанные.Источник = &ДокументОтбора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Таб.Ссылка КАК Ссылка
		|ИЗ
		|	Таб КАК Таб";
	
	Запрос.УстановитьПараметр("ДокументОтбора", ДокументОтбора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивЗапросов = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
    Возврат МассивЗапросов;
	
КонецФункции


#Область ПодключениеКомпонентыПодписиНаКлиенте

&НаКлиенте
Асинх Процедура ПослеПодключенияКомпонентыПодписи()
	
	Если ОбщегоНазначенияКлиентСервер.ЭтоLinuxКлиент() Тогда
		Если ЗначениеЗаполнено(ПутьКПрограмме) Тогда
			Ждать КомпонентаПодписи.УстановитьПутьККриптопровайдеруАсинх(ПутьКПрограмме);
		Иначе
			ПерсональныеНастройки = ЭлектроннаяПодписьКлиент.ПерсональныеНастройки();
			
			ДополнительныеПараметры = Новый Структура("СоответствиеПутей",ПерсональныеНастройки.ПутиКПрограммамЭлектроннойПодписиИШифрования);
			
			ПослеСозданияМК(Неопределено,ДополнительныеПараметры);
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПослеСозданияМК(Результат,ДопПараметры)Экспорт
	Если Результат = Неопределено Тогда
		Если ДопПараметры.Свойство("ТекущаяПрограмма") Тогда
			ДопПараметры.СоответствиеПутей.Удалить(ДопПараметры.ТекущаяПрограмма);
		КонецЕсли;
		Для Каждого КлючИЗначение Из ДопПараметры.СоответствиеПутей Цикл
			ДопПараметры.Вставить("ТекущаяПрограмма",КлючИЗначение.Ключ);
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияМК",ЭтотОбъект,ДопПараметры);
			ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(ОписаниеОповещения,"",Ложь,КлючИЗначение.Ключ);
			Возврат;
		КонецЦикла;
	Иначе
		Результат = Неопределено;
		ПутьКПрограмме = ДопПараметры.СоответствиеПутей[ДопПараметры.ТекущаяПрограмма];
		Ждать КомпонентаПодписи.УстановитьПутьККриптопровайдеруАсинх(ПутьКПрограмме);
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();	
		
КонецПроцедуры

#КонецОбласти


&НаСервере
Функция ПолучитьМассивУчастников()
	МассивУчастников = Новый Массив;
	
	Если НЕ ЭтоБазаГАН 
		ИЛИ ТаблицаУчастников.Количество() = 1 Тогда
		МассивУчастников.Добавить(Объект.Участник);
		Возврат МассивУчастников;
	КонецЕсли;
	
	Для Каждого СтрокаТЧ Из ТаблицаУчастников Цикл
		Если СтрокаТЧ.Использовать Тогда
			МассивУчастников.Добавить(СтрокаТЧ.Участник);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивУчастников;
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуУчастников()
	
	ТаблицаУчастников.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация КАК Организация,
		|	НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный КАК Подведомственный,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ВерсияФорматов КАК ВерсияФорматов,
		|	ВЫБОР
		|		КОГДА НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = НЕОПРЕДЕЛЕНО
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ПорядокУчастников
		|ИЗ
		|	РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|ГДЕ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокУчастников,
		|	НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный.Наименование";
	
	Запрос.УстановитьПараметр("Организация", Объект.Участник);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ГлавныйУчастник = ТаблицаУчастников.Добавить();
	ГлавныйУчастник.Участник = Объект.Участник;
	ГлавныйУчастник.Использовать = Истина;
	
	ЗагружатьОтметки = Ложь;
	Если ВыборкаДетальныеЗаписи.Количество()>1 Тогда
		КлючНастроек = "Участник_"+Строка(Объект.Участник.УникальныйИдентификатор());
		СоответствиеОтмеченныхУчастников = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ОбменГИСГМП2",КлючНастроек,Неопределено);
		Если СоответствиеОтмеченныхУчастников <> Неопределено
			И ТипЗнч(СоответствиеОтмеченныхУчастников) = Тип("Соответствие") Тогда
			ЗагружатьОтметки = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ПорядокУчастников = 1 Тогда
			ГлавныйУчастник.ЕстьНастройка = ВыборкаДетальныеЗаписи.ВерсияФорматов = "2.00";
			ГлавныйУчастник.Использовать = ГлавныйУчастник.ЕстьНастройка;
			
			Если ЗагружатьОтметки Тогда
				ГлавныйУчастник.Использовать = (СоответствиеОтмеченныхУчастников[ГлавныйУчастник.Участник] = Истина);		
			КонецЕсли;
		Иначе
			Подвед = ТаблицаУчастников.Добавить();
			Подвед.Участник = ВыборкаДетальныеЗаписи.Подведомственный;
			Подвед.ЕстьНастройка = ВыборкаДетальныеЗаписи.ВерсияФорматов = "2.00";
			Подвед.Использовать = Подвед.ЕстьНастройка;
			Если ТипЗнч(Подвед.Участник) = Тип("СправочникСсылка.Контрагенты") Тогда
				Подвед.ВидУчастника = 1;
			КонецЕсли;
			
			Если ЗагружатьОтметки Тогда
				Подвед.Использовать = (СоответствиеОтмеченныхУчастников[Подвед.Участник] = Истина);		
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаУчастников.Количество() = 1 Тогда
		//в таблице только этот участник, смысла показывать таблицу нет
		Элементы.ДеревоУчастников.Видимость = Ложь;
		Элементы.СписокЗапросовУчастник.Видимость = Ложь;
	Иначе
		Элементы.ДеревоУчастников.Видимость = Истина;
		Элементы.СписокЗапросовУчастник.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьОтборажениеПанелиОтборовНаСервере()
	
	Элементы.ОтображениеПанелиОтборов.Пометка = ОтображатьПанельОтборов;
	Элементы.ГруппаОтборИсторияОбщие.Видимость = ОтображатьПанельОтборов;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокКвитанций(ОбновлятьСписокОтмеченных = Ложь)
		
	ЗаполнитьНастройкиДССписокКвитанций();
	
	Если ОбновлятьСписокОтмеченных Тогда
		ОбновитьСписокОтмеченныхКвитанцийПоДаннымСпискаКвитанций();
	КонецЕсли;
		
	ОбновитьИнформациюОНераспределенныхПлатежах();
			
	ОбновитьИнформациюОПлатежахДляКвитирования();	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнформациюОНераспределенныхПлатежах()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ЕСТЬNULL(ТекПлатежи.КолДок, 0)) КАК КолДок,
		|	СУММА(ЕСТЬNULL(ТекПлатежи.СумДок, 0)) КАК СумДок
		|ИЗ
		|	(ВЫБРАТЬ
		|		КОЛИЧЕСТВО(ДокументПлатежВОплатуГосуслуг.Ссылка) КАК КолДок,
		|		СУММА(ЕСТЬNULL(ДокументПлатежВОплатуГосуслуг.СуммаДокумента, 0)) КАК СумДок
		|	ИЗ
		|		Документ.ПлатежВОплатуГосуслуг КАК ДокументПлатежВОплатуГосуслуг
		|	ГДЕ
		|		ДокументПлатежВОплатуГосуслуг.Организация В(&МассивУчастниковОрганизаций)
		|		И ДокументПлатежВОплатуГосуслуг.БанковскийИдентификаторПлатежаЗаполнен
		|		И ДокументПлатежВОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ
		|		И НЕ ИСТИНА В
		|					(ВЫБРАТЬ ПЕРВЫЕ 1
		|						ИСТИНА
		|					ИЗ
		|						РегистрСведений.СоответствиеНачисленийИПлатежей КАК Т1
		|					ГДЕ
		|						Т1.Платеж = ДокументПлатежВОплатуГосуслуг.Ссылка)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПлатежПодведомственному.Ссылка),
		|		СУММА(ЕСТЬNULL(ПлатежПодведомственному.СуммаДокумента, 0))
		|	ИЗ
		|		Документ.ПлатежПодведомственному КАК ПлатежПодведомственному
		|	ГДЕ
		|		ПлатежПодведомственному.Организация = &Участник
		|		И ПлатежПодведомственному.БанковскийИдентификаторПлатежаЗаполнен
		|		И ПлатежПодведомственному.Получатель В(&МассивУчастниковКонтрагентов)
		|		И ПлатежПодведомственному.ПометкаУдаления = ЛОЖЬ
		|		И НЕ ИСТИНА В
		|					(ВЫБРАТЬ ПЕРВЫЕ 1
		|						ИСТИНА
		|					ИЗ
		|						РегистрСведений.СоответствиеНачисленийИПлатежей КАК Т1
		|					ГДЕ
		|						Т1.Платеж = ПлатежПодведомственному.Ссылка)) КАК ТекПлатежи";
	
	
	Если РежимРаботыКвитанции <> 1 Тогда
		//Если это не формирование пакетов, то документы Начисление от подведомственного можно показывать в списке
		Запрос.УстановитьПараметр("МассивУчастниковКонтрагентов",МассивУчастниковКонтрагентов);
	Иначе
		Запрос.УстановитьПараметр("МассивУчастниковКонтрагентов",Новый Массив);
	КонецЕсли;
	Запрос.УстановитьПараметр("МассивУчастниковОрганизаций",МассивУчастниковОрганизаций);
	Запрос.УстановитьПараметр("Участник",Объект.Участник);	
	
	ДанныеНераспределенныхПлатежей = Запрос.Выполнить().Выбрать();
	
	Элементы.СписокКвитанцийРаспределитьПлатежиПоНачислению.Заголовок = НСтр("ru='Распределить платежи (нет)'");
	
	Если ДанныеНераспределенныхПлатежей.Следующий() Тогда
		Если ДанныеНераспределенныхПлатежей.КолДок > 0 Тогда
			ТекстЗаголовка = НСтр("ru='Распределить платежи (%1 шт., %2р.)'");	
			ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка,ДанныеНераспределенныхПлатежей.КолДок,ДанныеНераспределенныхПлатежей.СумДок);
			Элементы.СписокКвитанцийРаспределитьПлатежиПоНачислению.Заголовок = ТекстЗаголовка;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнформациюОПлатежахДляКвитирования()
	КоличествоПлатежейДляКвитирования = 0;
	
	Если РежимРаботыКвитанции = 3 Тогда//Квитирование
		
		ЗаполнитьНастройкиДССписокПлатежиДляКвитирования();
		
		Запрос = Новый Запрос;
				
		СтруктураОтбора = Новый Структура("ЕстьПлатеж",Истина);
		Запрос.УстановитьПараметр("МассивНачислений",ПолучитьДоступныеДляОтметкиКвитанции(СтруктураОтбора));
						
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КОЛИЧЕСТВО(СоответствиеНачисленийИПлатежей.Платеж) КАК КолДок
			|ИЗ
			|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
			|ГДЕ
			|	СоответствиеНачисленийИПлатежей.Начисление В(&МассивНачислений)
			|	И СоответствиеНачисленийИПлатежей.ТребуетсяКвитирование = 1";

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			КоличествоПлатежейДляКвитирования = Выборка.КолДок;	
		КонецЕсли;

	КонецЕсли;
	
	Если КоличествоПлатежейДляКвитирования>0 Тогда
		ТекстЗаголовка = НСтр("ru='Отметить распределенные платежи для квитирования (%1 шт.)'");
		
		ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка,КоличествоПлатежейДляКвитирования);
	Иначе
		ТекстЗаголовка = НСтр("ru='Отметить распределенные платежи для квитирования (нет)'");
	КонецЕсли;
			
	Элементы.ОтметитьДляКвитирования.Заголовок = ТекстЗаголовка;
	Элементы.СписокКвитанцийКонтекстноеМенюОтметитьДляКвитирования.Заголовок = ТекстЗаголовка;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиДССписокПлатежиДляКвитирования()
							
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПлатежиДляКвитирования,"МассивУчастниковКонтрагентов",МассивУчастниковКонтрагентов,Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПлатежиДляКвитирования,"МассивУчастниковОрганизаций",МассивУчастниковОрганизаций,Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПлатежиДляКвитирования,"Начисление",ТекущаяКвитанция,Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПлатежиДляКвитирования,"ОтмеченныеПлатежи",СписокОтмеченныеПлатежиДляКвитирования,Истина);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиДССписокКвитанций()
	
	Перем ГруппаДатаНачала, ГруппаДатаОкончания, НайденныеЭлементы, СтатусыНеДляКвитирования;
	
	Если РежимРаботыКвитанции <> 1 Тогда
		//Если это не формирование пакетов, то документы Начисление от подведомственного можно показывать в списке
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокКвитанций,"МассивУчастниковКонтрагентов",МассивУчастниковКонтрагентов,Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокКвитанций,"МассивУчастниковКонтрагентов",Новый Массив,Истина);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокКвитанций,"МассивУчастниковОрганизаций",МассивУчастниковОрганизаций,Истина);
	
	//ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокКвитанций,"ФормированиеПакетов",РежимРаботыКвитанции = 1,Истина);
	//ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокКвитанций,"ЗапросОплаты",РежимРаботыКвитанции = 2,Истина);
