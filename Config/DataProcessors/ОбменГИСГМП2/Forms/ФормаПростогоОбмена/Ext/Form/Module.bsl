&НаКлиенте
Перем КомпонентаПодписи;
&НаКлиенте
Перем ПутьКПрограмме;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВыполнятьПодписьНаСервере = Константы.ПодписыватьСообщенияДляГИСГМПНаСервере.Получить();
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СоставПакетаНачислений,"Пакет",Неопределено,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СоставПакетаВозвратов,"Пакет",Неопределено,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбменаНачисленийВозвратов,"ДокСсылка",Неопределено,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбменаЗапросовНачисленийВозвратов,"МассивЗапросов",Новый Массив,Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбмена,"Данные",Неопределено,Истина);
	
	ОбменРНИП_УНП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО");
	ОбменГИСГМП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	ЭтоБазаГАН = ПолучитьФункциональнуюОпцию("ЭтоБазаГАН") И ОбменГИСГМП;
	
	ЕстьАЗ = ПолучитьФункциональнуюОпцию("ИспользоватьОбменСГИСГМП_АЗ");
	
	Элементы.СписокЗапросовТипУчастника.Видимость = ЕстьАЗ;
	Элементы.ГруппаАдминистраторЗапросов.Видимость = ЕстьАЗ;
	Элементы.ГруппаТипУчастника.Видимость = ЕстьАЗ;
	
	Элементы.ГруппаКаталогУслуг.Видимость = ОбменРНИП_УНП;
	//Элементы.ГруппаПодписки.Видимость = ОбменГИСГМП;//для обмена с ИС РНИП и ИС УНП пока не поддерживается
	
	РежимРаботыКвитанции = 1;//формирование пакетов
	РежимРаботыВозвраты = 1; //формирование пакетов
	РежимРаботыПакеты = 1; //Отправка пакетов
	
	ВидПлатежей = "PAYMENT";//только активные платежи, т.к. аннулирование платежей отменили в ГИС ГМП
	//заполним по умолчанию - далее период сохраняется
	ПериодЗапросаПлатежей.ДатаНачала = НачалоМесяца(ТекущаяДата());
	ПериодЗапросаПлатежей.ДатаОкончания = ТекущаяДата();
	
	ИзменитьВидимостьКомандПоРежимуРаботыКвитанций();
	ИзменитьВидимостьКомандПоРежимуРаботыВозвратов();
	ИзменитьВидимостьКомандПоРежимуРаботыПакетов();
	
	мМассивПакетов = Новый ФиксированныйМассив(Новый Массив);
	
	Элементы.ГруппаЭмулятор.Видимость = ОбменСЭмулятором И ОбменГИСГМП;
	Элементы.ФормаВыполнятьОбменСЭмулятором.Видимость = ОбменГИСГМП;
	
	Элементы.ГруппаАвтоматическийОбменОчереди.Видимость = ВключенАвтоматическийОбменОчереди;
	
	ТребуетсяПодтверждениеПолученныхСообщений = Истина;//не требуется только для обмена с ИС УНП
		
	// Печать ЗапросыНачисленийАЗ
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ЗапросыНачисленийАЗ.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.ЗапросУНИФО);
	ПараметрыРазмещения.ПрефиксГрупп = "ЗапросыНачисленийАЗ";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец Печать ЗапросыНачисленийАЗ
	
	// Печать ЗапросыПлатежейАЗ
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ЗапросыПлатежейАЗ.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.ЗапросУНИФО);
	ПараметрыРазмещения.ПрефиксГрупп = "ЗапросыПлатежейАЗ";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец Печать ЗапросыПлатежейАЗ
	
	// Печать СписокЗапросов
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.СписокЗапросов.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.ЗапросУНИФО);
	ПараметрыРазмещения.ПрефиксГрупп = "СписокЗапросов";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец Печать СписокЗапросов
	
	ЗаполнитьНастройкиДССписокКвитанций();
	ЗаполнитьНастройкиДССписокПакетов();
	ЗаполнитьНастройкиДССписокВозвратов();
	ЗаполнитьНастройкиДССписокПлатежиДляКвитирования();
	ЗаполнитьНастройкиДССписокНачисленийОтПосредника();
	
	ИспользоватьОчередьЗапросовГИСГМП = Константы.ИспользоватьОчередьЗапросовГИСГМП.Получить();
	
	Элементы.ГруппаПользовательскиеЗапросыКСервису.Видимость = ИспользоватьОчередьЗапросовГИСГМП;
	
	ПериодЗапросаДанныхИзОчереди = 40;// если есть записи в РС ОчередиЗапросовКГИСГМП, то 20, если нет то 40
		
	УбратьКнопкуЗагрузкиПодписокВПодменю();

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
		
	Если ЗначениеЗаполнено(Объект.Участник) Тогда
		УчастникПриИзмененииНаСервере();
	КонецЕсли;
	
	ИзменитьВидимостьКомандПоРежимуРаботыКвитанций();
	ИзменитьВидимостьКомандПоРежимуРаботыВозвратов();
	ИзменитьВидимостьКомандПоРежимуРаботыПакетов();
	
	Элементы.ФормаОтображатьВыполнениеПоШагам.Пометка = Тестирование;
	
	ИзменитьОтборажениеПанелиОтборовНаСервере();
	
	ТекстЗаголовка = НСтр("ru='Действие после формирования пакетов: %1 (изменить)'");
	ТекДействие = "";
	Если ПриФормированииПакетов = 0 Тогда
		ТекДействие = "Нет";
	ИначеЕсли ПриФормированииПакетов = 1 Тогда
		ТекДействие = "Задавать вопрос";
	ИначеЕсли ПриФормированииПакетов = 2 Тогда
		ТекДействие = "Отправлять в сервис";
	КонецЕсли;
	
	ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка,ТекДействие);
	
	Элементы.СписокКвитанцийКонтекстноеМенюИзменитьДействиеПриФормированииПакетов.Заголовок = ТекстЗаголовка;
	Элементы.СписокВозвратовКонтекстноеМенюИзменитьДействиеПриФормированииПакетов.Заголовок = ТекстЗаголовка;
	
	УстановитьЗаголовокНастройкеЗапросаДанныхИзОчереди();
	
	//установка загруженных отборов для динамических списков
	//Каталог услуг
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокКаталогов,"СтатусОбработки",СтатусОбработкиКаталог,,,СтатусОбработкиКаталогУсловие);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокКаталогов,"Состояние",СтатусДокументаКаталогОтбор,,,СтатусДокументаКаталогОтборУсловие);
	
	//Запросы к сервису
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокЗапросов,"ТипЗапрашиваемыхДанных",ВидЗапроса,,,ВидЗапросаУсловие);
	
	ГруппаОтбораУчастников = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(СписокЗапросов.Отбор.Элементы,"ОтборПериод",ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбораУчастников,"Дата",ВидСравненияКомпоновкиДанных.БольшеИлиРавно,ПериодОтбораЗапросов.ДатаНачала,"ДатаНачала",ПериодОтбораЗапросовУсловие);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбораУчастников,"Дата",ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,ПериодОтбораЗапросов.ДатаОкончания,"ДатаОкончания",ПериодОтбораЗапросовУсловие И ЗначениеЗаполнено(ПериодОтбораЗапросов.ДатаОкончания));
	//тип участника не сохраняем и не загружаем	
	//ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокЗапросов,"ТипУчастника",ТипУчастника,,,ЗначениеЗаполнено(ТипУчастника));	
	
	//Запросы начислений АЗ
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗапросыНачисленийАЗ,"ТипЗапрашиваемыхДанных",ВидЗапросаНачисленийАЗ,,,ВидЗапросаНачисленийАЗУсловие);
	
	ГруппаОтбораУчастников = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЗапросыНачисленийАЗ.Отбор.Элементы,"ОтборПериод",ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбораУчастников,"Дата",ВидСравненияКомпоновкиДанных.БольшеИлиРавно,ПериодОтбораЗапросовНачисленийАЗ.ДатаНачала,"ДатаНачала",ПериодОтбораЗапросовНачисленийАЗУсловие);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбораУчастников,"Дата",ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,ПериодОтбораЗапросовНачисленийАЗ.ДатаОкончания,"ДатаОкончания",ПериодОтбораЗапросовНачисленийАЗУсловие И ЗначениеЗаполнено(ПериодОтбораЗапросовНачисленийАЗ.ДатаОкончания));
	
	//Запросы платежей АЗ
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗапросыПлатежейАЗ,"ТипЗапрашиваемыхДанных",ВидЗапросаПлатежейАЗ,,,ВидЗапросаПлатежейАЗУсловие);
	
	ГруппаОтбораУчастников = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЗапросыПлатежейАЗ.Отбор.Элементы,"ОтборПериод",ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбораУчастников,"Дата",ВидСравненияКомпоновкиДанных.БольшеИлиРавно,ПериодОтбораЗапросовПлатежейАЗ.ДатаНачала,"ДатаНачала",ПериодОтбораЗапросовПлатежейАЗУсловие);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбораУчастников,"Дата",ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,ПериодОтбораЗапросовПлатежейАЗ.ДатаОкончания,"ДатаОкончания",ПериодОтбораЗапросовПлатежейАЗУсловие И ЗначениеЗаполнено(ПериодОтбораЗапросовПлатежейАЗ.ДатаОкончания));
	
	//запросы общие
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗапросыОбщие,"ТипЗапрашиваемыхДанных",ВидЗапросаОчередь,,,ВидЗапросаОчередьУсловие);
	
	ГруппаОтбораУчастников = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЗапросыОбщие.Отбор.Элементы,"ОтборПериод",ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбораУчастников,"ДатаСоздания",ВидСравненияКомпоновкиДанных.БольшеИлиРавно,ПериодСоздания.ДатаНачала,"ДатаНачала",ПериодСозданияУсловие);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбораУчастников,"ДатаСоздания",ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,ПериодСоздания.ДатаОкончания,"ДатаОкончания",ПериодСозданияУсловие И ЗначениеЗаполнено(ПериодСоздания.ДатаОкончания));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗапросыОбщие,"ТипУчастникаГИСГМП",ТипУчастникаОчередьОтбор,,,ЗначениеЗаполнено(ТипУчастникаОчередьОтбор));

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗапросыОбщие,"СтатусОбщегоЗапроса",СтатусОчередьОтбор,,,СтатусОчередьОтборУсловие);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗапросыОбщие,"ЕстьОшибка",ЕстьОшибкаОчередьОтбор,,,ЕстьОшибкаОчередьОтборУсловие);
	
	//Подписки на уведомления
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыПодписок,"Подписка",ПодпискаОтбор,,,ПодпискаОтборУсловие);
	
	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ДокументыПодписок.Отбор.Элементы,"ОтборПериод",ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора,"Дата",ВидСравненияКомпоновкиДанных.БольшеИлиРавно,ПериодОтбораПодписки.ДатаНачала,"ДатаНачала",ПериодОтбораПодпискиУсловие);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора,"Дата",ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,ПериодОтбораПодписки.ДатаОкончания,"ДатаОкончания",ПериодОтбораПодпискиУсловие И ЗначениеЗаполнено(ПериодОтбораПодписки.ДатаОкончания));
	
	//Для посредника
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНачисленийОтПосредника,"Получатель",ПолучательПосредникОтбор,,,ПолучательПосредникОтборУсловие);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНачисленийОтПосредника,"Плательщик",ПлательщикПосредникОтбор,,,ПлательщикПосредникОтборУсловие);

	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(СписокНачисленийОтПосредника.Отбор.Элементы,"ОтборПериод",ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора,"Дата",ВидСравненияКомпоновкиДанных.БольшеИлиРавно,ПериодОтбораПосредник.ДатаНачала,"ДатаНачала",ПериодОтбораПосредникУсловие);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаОтбора,"Дата",ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,ПериодОтбораПосредник.ДатаОкончания,"ДатаОкончания",ПериодОтбораПосредникУсловие И ЗначениеЗаполнено(ПериодОтбораПосредник.ДатаОкончания));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНачисленийОтПосредника,"Статус",СтатусДокументаПосредникОтбор,,,СтатусДокументаПосредникОтборУсловие);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНачисленийОтПосредника,"СтатусОбработки",СтатусОбработкиПоредникОтбор,,,СтатусОбработкиПоредникОтборУсловие);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНачисленийОтПосредника,"ВидКвитанции",ВидДокументаПосредникОтбор,,,ВидДокументаПосредникОтборУсловие);

	ОбновитьДопСвойстваСпискаНачисленийОтПосредника();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОбновлениеНастройкиУчастников"
		И Параметр = Объект.Участник Тогда
		ДействияПриИзменениУчастника();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВключитьОтключитьАвтоматическийОбменОчередиЗапросов()
	
	Если ВыполнятьОбработкуОчередиЗапросов Тогда
		
		ПодключитьОбработчикОжидания("НачатьПолучениеДанныхИзСервиса",ПериодЗапросаДанныхИзОчереди,Истина);
		
	Иначе
		
		ОтключитьОбработчикОжидания("НачатьПолучениеДанныхИзСервиса");	
		
	КонецЕсли;
	
		
КонецПроцедуры

&НаКлиенте
Процедура НачатьПолучениеДанныхИзСервиса() Экспорт
	Если ЕстьЗапросПоID Тогда				
		ЗапроситьРезультатОбработкиОтправленныхСообщений(Неопределено);
	Иначе
		ЗапроситьДанныеИзОчередиОтветов(Неопределено);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УчастникПриИзменении(Элемент)
	
	ДействияПриИзменениУчастника();
	
КонецПроцедуры

&НаСервере
Процедура ДействияПриИзменениУчастника()
	УчастникПриИзмененииНаСервере();
	ИзменитьВидимостьКомандПоРежимуРаботыКвитанций();
	ИзменитьВидимостьКомандПоРежимуРаботыВозвратов();
	ИзменитьВидимостьКомандПоРежимуРаботыПакетов();
КонецПроцедуры

&НаСервере
Процедура УчастникПриИзмененииНаСервере()
	
	//заполнение настроек участника-отправителя
	СоответствиеУчастников = ГосУслуги.ПолучитьСоответствиеУчастников(Объект.Участник);
	УчастникОтправитель = СоответствиеУчастников[Объект.Участник];
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(УчастникОтправитель);
	НастройкаОбмена = НастройкиУчастника.НастройкаОбмена;
	
	ЕстьЗапросПоID = Ложь;
	
	ТребуетсяПодтверждениеПолученныхСообщений = Истина;
	ЕстьФорматыЗапросаУведомлений = Ложь;
	Если ОбменРНИП_УНП Тогда
		Если ЗначениеЗаполнено(НастройкиУчастника.ВидОбмена) Тогда
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкиУчастника.ВидОбмена,"ПредставлениеВНомереВерсии") = "UNP2" Тогда
				ТребуетсяПодтверждениеПолученныхСообщений = Ложь;
			КонецЕсли;
		КонецЕсли;
			
		НастройкаФорматов = НастройкиУчастника.НастройкаФорматов;
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
			|ИЗ
			|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
			|ГДЕ
			|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
			|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя
			|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.Наименование = &GetResponseRequestByID
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
			|ИЗ
			|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
			|ГДЕ
			|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
			|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя
			|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.Наименование = &GetRequestRequest";

		Запрос.УстановитьПараметр("НастройкаФормата", НастройкаФорматов);
		Запрос.УстановитьПараметр("ПолноеИмя", "Документ.ЗапросУНИФО");
		Запрос.УстановитьПараметр("GetResponseRequestByID", "GetResponseRequestByID");
		Запрос.УстановитьПараметр("GetRequestRequest", "GetRequestRequest");
		Результаты = Запрос.ВыполнитьПакет();
		
		ЕстьЗапросПоID = НЕ Результаты[0].Пустой();
		ЕстьФорматыЗапросаУведомлений = НЕ Результаты[1].Пустой();	
		
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВзаимодействиеГИСГМПЧерезГАН")
		И НастройкиУчастника.РежимВзаимодействия = "Косвенное" Тогда
		//это участник - подвед. АН, сам участник напрямую с сервисом не взаимодействует.
		МожноИспользоватьКомандыЭкспорта = Ложь;
	Иначе
		МожноИспользоватьКомандыЭкспорта = Истина;
	КонецЕсли;
	//установим ранее остальных, чтобы потом установить видимость команды в зависимости от вида обмена	
	Элементы.ЗапроситьДанныеИзОчередиОтветов.Видимость = МожноИспользоватьКомандыЭкспорта;
		
	//изменим видимость полей подтверждения сообщений, если подтверждения нет или есть
	Элементы.ИсторияОбменаНачисленийДатаПодтверждения.Видимость = ТребуетсяПодтверждениеПолученныхСообщений;
	Элементы.ИсторияОбменаЗапросовНачисленийВозвратовДатаПодтверждения.Видимость = ТребуетсяПодтверждениеПолученныхСообщений;	
	Элементы.ИсторияОбменаДатаПодтверждения.Видимость = ТребуетсяПодтверждениеПолученныхСообщений;	
	
	Элементы.ФормаГруппаЗапросРезультатаОбработки.Видимость = ЕстьЗапросПоID;
	Элементы.ФормаЗапроситьРезультатОбработкиОтправленныхСообщений.Видимость = ЕстьЗапросПоID;//используется в функции ЗадатьЗаголовокКнопкеЗапросаПоID
	
	//если не надо подтверждать, значит это обмен с ИС УНП, в котором нет запроса из очереди
	Элементы.ЗапроситьДанныеИзОчередиОтветов.Видимость = ТребуетсяПодтверждениеПолученныхСообщений;
	
	ЗадатьЗаголовокКнопкеЗапросаПоID();
	
	Если ЕстьЗапросПоID 
		И ТребуетсяПодтверждениеПолученныхСообщений Тогда
		//если есть оба варианта, то это обмен с ИС РНИП
		//скроем кнопку запроса из очереди во всех действиях
		Элементы.ЗапроситьДанныеИзОчередиОтветов.ТолькоВоВсехДействиях = Истина;
	Иначе
		Элементы.ЗапроситьДанныеИзОчередиОтветов.ТолькоВоВсехДействиях = Ложь;
	КонецЕсли;
		
	Элементы.СписокКвитанцийЗапроситьПлатежиПоНачислению.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.СписокКвитанцийЗапроситьПлатежиЗаПериод.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.СписокКвитанцийЗапроситьСтатус.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.СписокКвитанцийСквитироватьСПлатежами.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.СписокКвитанцийСквитироватьБезПлатежа.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.СписокКвитанцийОтменитьКвитированиеБезПлатежа.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.СписокКвитанцийКонтекстноеМенюЗапроситьКвитанции.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.ТаблицаПлатежиДляОтменыКвитированияОтменитьКвитированиеСПлатежами.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.СписокВозвратовКонтекстноеМенюЗапроситьВозврат.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.СписокКвитанцийОтправитьКвитанции.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.СписокПакетовКонтекстноеМенюОтправитьПакетПовторно.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.СписокЗапросовОтправитьПроизвольныйЗапрос.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.ЗапроситьСледующуюПорциюДанных.Видимость = МожноИспользоватьКомандыЭкспорта;
	
	Элементы.ЗапросыНачисленийАЗОтправитьЗапросыНачисленийАЗ.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.ЗапросыПлатежейАЗОтправитьЗапросыАЗ.Видимость = МожноИспользоватьКомандыЭкспорта;
	
	Элементы.СписокКвитанцийКонтекстноеМенюИзменитьДействиеПриФормированииПакетов.Видимость = МожноИспользоватьКомандыЭкспорта;
	Элементы.СписокВозвратовКонтекстноеМенюИзменитьДействиеПриФормированииПакетов.Видимость = МожноИспользоватьКомандыЭкспорта;
	
	Если МожноИспользоватьКомандыЭкспорта = Ложь Тогда
		ПриФормированииПакетов = 0;//ничего не делать
	КонецЕсли;
	
	//в истории отключим даты, т.к. регистры обмена не перадаются
	Элементы.ИсторияОбменаНачисленийГруппаГоризонтальная.Видимость = МожноИспользоватьКомандыЭкспорта;
	
	Если Не ЗначениеЗаполнено(НастройкаОбмена) Тогда
		ТекстСообщения = Нстр("ru='Для участника ""%1"" в настройках участника не задана настройка обмена с сервисом.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,УчастникОтправитель);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ПараметрыНастройкиОбмена = Неопределено;
	Иначе
		ПараметрыНастройкиОбмена = Новый ФиксированнаяСтруктура(ЭкспортФайлов.ПолучитьДанныеНастройкиОбмена(НастройкаОбмена));
	КонецЕсли;
	
	ЗаполнитьТаблицуУчастников();
	
	ПриИзмененииСпискаУчастников(Истина);
	
	ЭтоПосредник = БиблиотекаФункцийОбмена.ПолучитьЗначениеТребуемойНастройкиОрганизация(Объект.Участник,,"ЭтоУчастникПосредник");
	Элементы.ГруппаДляПосредника.Видимость = ЭтоПосредник;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокКаталогов,"Организация",Объект.Участник);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДокументыПодписок,"Организация",Объект.Участник);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДействующиеПодписки,"Организация",Объект.Участник);
	
	ЗаполнитьКоличествоДействующихПодписок();
	
	ОбновитьДопСвойстваСпискаНачисленийОтПосредника();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКоличествоДействующихПодписок()
		
	КоличествоДействующихПодписок = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ПодключенныеПодпискиГИСГМПСрезПоследних.Подписка) КАК КоличествоПодписок
	|ИЗ
	|	РегистрСведений.ПодключенныеПодпискиГИСГМП.СрезПоследних КАК ПодключенныеПодпискиГИСГМПСрезПоследних
	|ГДЕ
	|	ПодключенныеПодпискиГИСГМПСрезПоследних.ПодпискаАктивна
	|	И ПодключенныеПодпискиГИСГМПСрезПоследних.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Объект.Участник);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		КоличествоДействующихПодписок = ВыборкаДетальныеЗаписи.КоличествоПодписок;
	КонецЕсли;

КонецПроцедуры

