Процедура ОтборПоОбщимЗапросам() Экспорт
	ТекДанные = Элементы.ЗапросыОбщие.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		ТекУИДНастройкиОбщегоЗапроса = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Иначе
		ТекУИДНастройкиОбщегоЗапроса = ТекДанные.УИДНастройкиОбщегоЗапроса;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗапросыДетальные,"УИДНастройкиОбщегоЗапроса",ТекУИДНастройкиОбщегоЗапроса,,,Истина);
	
