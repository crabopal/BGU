&НаКлиенте
Процедура СтраницыЗапросыАЗПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Элементы.СтраницыЗапросыАЗ.ТекущаяСтраница = Элементы.СтраницаЗапросыНачислений Тогда
			
		Элементы.ГруппаСтраницыОтборов.ТекущаяСтраница = Элементы.ПанельОтборовЗапросыНачисленийАЗ;
		
		ТекДанные = Элементы.ЗапросыНачисленийАЗ.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			ТекущийЗапрос = Неопределено;
		Иначе
			ТекущийЗапрос = ТекДанные.Ссылка;
		КонецЕсли;
	Иначе
		
		Элементы.ГруппаСтраницыОтборов.ТекущаяСтраница = Элементы.ПанельОтборовЗапросыПлатежейАЗ;
		
		ТекДанные = Элементы.ЗапросыПлатежейАЗ.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			ТекущийЗапрос = Неопределено;
		Иначе
			ТекущийЗапрос = ТекДанные.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПоказатьИсториюОбмена",0.5,Истина);
КонецПроцедуры

