	Элементы.СписокНачисленийОтПосредника.Обновить();
КонецПроцедуры

&НаСервере
Процедура ОбновитьДопСвойстваСпискаНачисленийОтПосредника()
	ДопСвойства = СписокНачисленийОтПосредника.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	ДопСвойства.Вставить("Организация",Объект.Участник);
	ДопСвойства.Вставить("ПодпискаДляНачислений",ПодпискаДляНачислений);
	ДопСвойства.Вставить("ПодпискаДляКвитанций",ПодпискаДляКвитанций);
КонецПроцедуры
	
&НаКлиенте
Асинх Процедура ОтправитьНачисленияОтПосредника(Команда)
	
	ОчиститьСообщения();
	
	ОбновитьСписокОтмеченныхДокументовПоДаннымСпискаНачисленийОтПосредника();
	Если СписокОтмеченныеНачисленияОтПосредника.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отмечены начисления от посредника для отправки.'"));
		Возврат;
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматНП","НачислениеОтПосредникаГИСГМП","SendRequestRequest_НП");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееДействие = "ОтправитьНачисленияОтПосредника";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
		
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоНачислениямОтПосредника(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
			
	МассивДокументов = СписокОтмеченныеНачисленияОтПосредника.ВыгрузитьЗначения();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НачислениеОтПосредникаГИСГМП.Ссылка КАК Ссылка,
		|	НачислениеОтПосредникаГИСГМП.Организация КАК Организация
		|ИЗ
		|	Документ.НачислениеОтПосредникаГИСГМП КАК НачислениеОтПосредникаГИСГМП
		|ГДЕ
		|	НачислениеОтПосредникаГИСГМП.Ссылка В(&МассивДокументов)
		|ИТОГИ ПО
		|	Организация";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	ОбработкаФормирования = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	ОбработкаФормирования.ОбменСЭмулятором = ОбменСЭмулятором;
	
	ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	НомерТек = 1;
	НуженНовыйПул = Истина;
		
	Пока ВыборкаОрганизация.Следующий() Цикл
		
		Организация = ВыборкаОрганизация.Организация;
		НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Организация);
				
		ВыборкаДетальныеЗаписи = ВыборкаОрганизация.Выбрать();
		
		СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
		СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
		СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
		СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
		СтруктураДляФормирования.Вставить("Организация", Организация);
		СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
		//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
		
		ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
		ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
		
		ТекстЗапросаДляЭмулятораНП = "";
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
						
			НовСтр = ТекОбъектыОбмена.Добавить();
			НовСтр.Объект = ВыборкаДетальныеЗаписи.Ссылка;
			ТекстЗапросаДляЭмулятора = "";
			
			НовСтр.Формат = ФорматНП;
			
			Если ОбменСЭмулятором
				И НЕ ЗначениеЗаполнено(ТекстЗапросаДляЭмулятораНП) Тогда
				ТекстЗапросаДляЭмулятораНП = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросСозданияНачисления",ЕстьОшибки);
			КонецЕсли;
									
		КонецЦикла;
		
		СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
		
		МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
	КонецЦикла;	
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортДанныхВСМЭВ,ЕстьОшибки);
	
	Если ОбменСЭмулятором Тогда
		
		ТекстЗапросаДляЭмулятора = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросСозданияНачисления",ЕстьОшибки);
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			СтрТЧ.ОбменСЭмулятором = Истина;
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		КонецЦикла;
		
	КонецЕсли;
	
	МассивФ = Новый Массив;
	МассивФ.Добавить(ФорматНП);
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, МассивФ));

КонецПроцедуры

&НаКлиенте
Асинх Процедура ПодписатьсяНаНачисления(Команда)
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(ПодпискаДляНачислений) Тогда
		ТекстСообщения = НСтр("ru='Не выбрана подписка для начислений по УИН.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","ПодпискаНаУведомлениеГИСГМП","SendRequestRequest_CS");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	МассивУИНБезПодписки = Новый Массив;
	МассивВыденных = Элементы.СписокНачисленийОтПосредника.ВыделенныеСтроки;
	Для Каждого ЭлМас Из МассивВыденных Цикл
		ТекДанные = Элементы.СписокНачисленийОтПосредника.ДанныеСтроки(ЭлМас);
		Если ЗначениеЗаполнено(ТекДанные.УИН)
			И ТекДанные.ЕстьПодпискаНаНачисления = -1 Тогда//-1 это подписки нет
			МассивУИНБезПодписки.Добавить(ТекДанные.УИН);
		КонецЕсли;
	КонецЦикла;
	Если МассивУИНБезПодписки.Количество() = 0 Тогда
		Если МассивВыденных.Количество() Тогда
			ТекстСообщения = НСтр("ru='В выделенных документах еще нет УИН или на документы уже подключена подписка на начисления по УИН.'");
		Иначе
			ТекстСообщения = НСтр("ru='Не выделены документы для оформения подписки на начисления по УИН.'");
		КонецЕсли;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	мМассивУИНДляПодписок = Новый ФиксированныйМассив(МассивУИНБезПодписки);
	ТекущееДействие = "ПодписатьсяНаНачисленияДляПосредникаПоУИН";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();	
	
КонецПроцедуры

