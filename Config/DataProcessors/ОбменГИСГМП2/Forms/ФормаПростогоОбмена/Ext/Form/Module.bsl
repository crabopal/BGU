&НаСервере
Процедура СформироватьФайлыПоСпискуЗапросов(ЕстьОшибки)
	
	РезультатФормирования.Очистить();         
	ФайлыРезультатаФормирования.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();		
		
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
	
	//РеквизитыЗапроса = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущийЗапрос,"Организация,ТипЗапрашиваемыхДанных");
	
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Объект.Участник); 
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
	
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	МассивТекстовДляЭмулятора = Новый Массив;
	
	Для Каждого ТекДок Из мМассивЗапросов Цикл
		Для Каждого ТекФормат Из МассивФорматовЭкспорта Цикл
			СтрокаОбмена = ТекОбъектыОбмена.Добавить();
			СтрокаОбмена.Объект = ТекДок;
			СтрокаОбмена.Формат = ТекФормат;
		КонецЦикла;
	КонецЦикла;
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);			
	МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
			
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);
	
	Если ОбменСЭмулятором Тогда
		
		МассивДок = Новый Массив(мМассивЗапросов);
		РеквизитыДокументов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивДок,"ТипЗапрашиваемыхДанных");
	
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			
			НомерПакета = СтрТЧ.НомерПакета;
			
			СтрРезультата = РезультатФормирования.НайтиСтроки(Новый Структура("НомерПакета",НомерПакета));
			
			ТекстЗапросаДляЭмулятора = "";
			
			ТекДокЗапроса = Неопределено;
			Если СтрРезультата.Количество()>0 Тогда
				ТекДокЗапроса = СтрРезультата[0].Объект;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекДокЗапроса) Тогда
				ТипСообщенияЗапроса = "";
				Если РеквизитыДокументов[ТекДокЗапроса] = "DOACKNOWLEDGMENTREQUEST" Тогда
					ТипСообщенияЗапроса = "ЗапросНаКвитирование";
				ИначеЕсли РеквизитыДокументов[ТекДокЗапроса] = "QUITTANCE" Тогда
					ТипСообщенияЗапроса = "ЗапросРезультатаКвитирования";
				ИначеЕсли РеквизитыДокументов[ТекДокЗапроса] = "REFUND" Тогда
					ТипСообщенияЗапроса = "ЗапросВозврата";
				ИначеЕсли РеквизитыДокументов[ТекДокЗапроса] = "PAYMENT"
					ИЛИ РеквизитыДокументов[ТекДокЗапроса] = "PAYMENTCANCELLED" Тогда
					ТипСообщенияЗапроса = "ЗапросПлатежей";
				ИначеЕсли РеквизитыДокументов[ТекДокЗапроса] = "CHARGE"
					ИЛИ РеквизитыДокументов[ТекДокЗапроса] = "CHARGESTATUS" Тогда
					ТипСообщенияЗапроса = "ЗапросСтатуса";
				ИначеЕсли РеквизитыДокументов[ТекДокЗапроса] = "APPEND"
					ИЛИ РеквизитыДокументов[ТекДокЗапроса] = "REPLACE" Тогда
					ТипСообщенияЗапроса = "ИмпортСертификата";
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ТипСообщенияЗапроса) Тогда
					ТекстЗапросаДляЭмулятора = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,ТипСообщенияЗапроса,ЕстьОшибки);
		   		КонецЕсли;
			КонецЕсли;
			
			СтрТЧ.ОбменСЭмулятором = Истина;
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		КонецЦикла;
	КонецЕсли;
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, Новый Массив(МассивФорматовЭкспорта)));

КонецПроцедуры

#КонецОбласти
		

#Область СохранитьФайлыОбмена

&НаКлиенте
Асинх Процедура СохранитьФайлыОбмена(Команда)
	ТекДанные = Элементы.ИсторияОбмена.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивИдентификаторов = Новый Массив;
		
	МассивВыделенных = Новый Массив;
	Для Каждого ТекВыд Из Элементы.ИсторияОбмена.ВыделенныеСтроки Цикл
		МассивВыделенных.Добавить(ТекВыд);
	КонецЦикла;
	
	Для Каждого ТекСтр Из МассивВыделенных Цикл
		Элементы.ИсторияОбмена.ТекущаяСтрока = ТекСтр;
		ТекДанные = Элементы.ИсторияОбмена.ТекущиеДанные;
		МассивИдентификаторов.Добавить(ТекДанные.ИдентификаторСообщения);
	КонецЦикла;
	
	ПоместитьВАрхив = Ложь;
	МассивОписанийФайлов = СформироватьВыгрузку(МассивИдентификаторов, ПоместитьВАрхив);
	
	Если МассивОписанийФайлов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ПараметрыДиалогаПолученияФайлов;
	Диалог.ВыборКаталога = Истина;
	
	Ждать ПолучитьФайлыССервераАсинх(МассивОписанийФайлов,Диалог);
КонецПроцедуры

