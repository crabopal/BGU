	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","УведомлениеОВозвратеГИСГМП","SendRequestRequest_УВ");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
		
	ТекущееДействие = "СформироватьПакетыВозвратов";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыполнитьДействияФормированияПакетовНаКлиенте()
	
	ЕстьОшибки = Ложь;
	
	Если ФайлыСформированы = Ложь Тогда
				
		ДопПараметры = Новый Структура;
		ТекстОшибки = "";
	
		//формирования файлов всегда выполняется на сервере, перейдем в главную процедуру сервера
		
		ВыполнитьДействияФормированияПакетовНаСервере(ЕстьОшибки,ТекстОшибки,ДопПараметры);
		
		Если ЕстьОшибки
			ИЛИ Тестирование Тогда
			ОбработатьОшибки(ЕстьОшибки,ТекстОшибки,ДопПараметры);
			Возврат;
		КонецЕсли;
	КонецЕсли;
		
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Ложь Тогда
		
		ДопПараметры = Новый Структура;
		ТекстОшибки = "";
		
		ИмяПодписываемогоУзла = "ImportChargesRequest";
		
		Если ТекущееДействие = "СформироватьПакетыВозвратов" Тогда
			ИмяПодписываемогоУзла = "ImportRefundsRequest";
		КонецЕсли;
		
		Если ВыполнятьПодписьНаСервере Тогда
			ВыполнитьДействияФормированияПакетовНаСервере(ЕстьОшибки,ТекстОшибки,ДопПараметры);
		Иначе
			ТекстОшибки = Ждать ГосУслугиКлиент.ПодписатьДанныеПоФорматуГИСГМП20НаКлиенте(КомпонентаПодписи,Объект.Участник,ФайлыРезультатаФормирования,ИмяПодписываемогоУзла);
			
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				ЕстьОшибки = Истина;
			КонецЕсли;
			
			ФайлыПодписаны = Истина;
		КонецЕсли;
		
		Если ЕстьОшибки
			ИЛИ Тестирование Тогда
			ОбработатьОшибки(ЕстьОшибки,ТекстОшибки,ДопПараметры);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Истина
		И ПакетыСозданы = Ложь Тогда
			
		ВыполнитьДействияФормированияПакетовНаСервере(ЕстьОшибки,ТекстОшибки,ДопПараметры);
		
	КонецЕсли;

	Если ФайлыСформированы
		И ФайлыПодписаны = Истина
		И ПакетыСозданы = Истина Тогда
		
		Если ПриФормированииПакетов = 0 Тогда
			//Ничего не делать
			Возврат;
		КонецЕсли;
		
		КоличествоПакетов = мМассивПакетов.Количество();
		
		Если ПриФормированииПакетов = 1
			И КоличествоПакетов > 0 Тогда
			//Задавать вопрос
			
			ТекстВопроса = НСтр("ru='Сформировано пакетов: %1. Отправить пакеты в сервис?'");
			ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса,КоличествоПакетов);
			ОписаниеОп = Новый ОписаниеОповещения("ПослеОтветаНаВопросОбИзмененииДействияПриФП",ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОп,ТекстВопроса,РежимДиалогаВопрос.ДаНет);
			Возврат;
			
		ИначеЕсли ПриФормированииПакетов = 2
			И КоличествоПакетов > 0 Тогда
		    //Сразу отправлять
			
			ОтправитьПакетыПослеФормирования();		
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ОтправитьПакетыПослеФормирования()
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматПВ","ПакетУведомленийОВозвратеГИСГМП","SendRequestRequest_ПВ");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматПН","ПакетНачисленийГИСГМП","SendRequestRequest_ПН");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееДействие = "ОтправитьПакеты";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
        ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
			
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросПриФормированииПакетов(Результат,ДопПараметры) Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		ОтправитьПакетыПослеФормирования();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействияФормированияПакетовНаСервере(ЕстьОшибки,ТекстОшибки,ДопПараметры)
	
	ЕстьОшибки = Ложь;
	
	Если ФайлыСформированы = Ложь Тогда
		
		Если ТекущееДействие = "СформироватьПакетыНачислений" Тогда
			СформироватьФайлыПоНачислениямВозвратам(СписокОтмеченныеКвитанции,ЕстьОшибки);
		Иначе
			СформироватьФайлыПоНачислениямВозвратам(СписокОтмеченныеВозвраты,ЕстьОшибки);
		КонецЕсли;
		//
		ФайлыСформированы = Истина;
		//
		Если ЕстьОшибки
			ИЛИ Тестирование Тогда
			//ДопПараметры.Вставить("АдресРезультата",АдресРезультата);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Ложь Тогда
		ТекстОшибки = "";
		Если ВыполнятьПодписьНаСервере Тогда
			
			ИмяПодписываемогоУзла = "ImportChargesRequest";
			Если ТекущееДействие = "СформироватьПакетыВозвратов" Тогда
				ИмяПодписываемогоУзла = "ImportRefundsRequest";
			КонецЕсли;
		
			ГосУслуги.ПодписатьДанныеПоФорматуГИСГМП20НаСервере(Объект.Участник,ФайлыРезультатаФормирования,ТекстОшибки,ИмяПодписываемогоУзла);
			//
			ФайлыПодписаны = Истина;
			//
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				ЕстьОшибки = Истина;
			КонецЕсли;
			
			Если ЕстьОшибки 
				ИЛИ Тестирование Тогда
				//Можно указать дополнительные параметры
				Возврат;
			КонецЕсли;
		Иначе
			Возврат;//выполним подпись на клиенте
		КонецЕсли;
	КонецЕсли;
	
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Истина
		И ПакетыСозданы = Ложь Тогда
		
		СоздатьПакетыНачисленийВозвратов();
		
		ПакетыСозданы = Истина;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоНачислениямВозвратам(СписокОтмеченныхДокументов,ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	
	МассивДокументов = СписокОтмеченныхДокументов.ВыгрузитьЗначения();
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
	
	//Размер пакета не может быть больше 100
	Если НЕ ЗначениеЗаполнено(НастройкиУчастника.РазмерПакетаНачислений) Тогда
		РазмерПакета = 50;
	Иначе
		РазмерПакета = Мин(НастройкиУчастника.РазмерПакетаНачислений,100); 
	КонецЕсли;
	
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	МассивСтруктурФормированияФайлов = Новый Массив;
		
	НовыйФайл = Истина;
	ДобавленДляФормированияФайла = Ложь;
	//Все отмеченные документы передаются в обработку за один раз (по каждой организации), а при формировании файла,
	//выгруженные документы делятся по пачкам, равным размеру пакета.
	//Поэтому разделять сейчас на несколько партий особого смысла не имеет.
	
	//В данном запросе только документы участников текущей базы, 
	//т.к. формирование пакетов выполняется в той базе, где участник ведет учет.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Ссылка КАК Ссылка,
		|	КвитанцияНаОплатуГосуслуг.Организация КАК Организация,
		|	ВЫБОР
		|		КОГДА КвитанцияНаОплатуГосуслуг.ВидКвитанции <= 1
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоНовыйДокумент
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивДокументов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УведомлениеОВозвратеГИСГМП.Ссылка,
		|	УведомлениеОВозвратеГИСГМП.Организация,
		|	ВЫБОР
		|		КОГДА УведомлениеОВозвратеГИСГМП.ВидУведомления <= 1
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|ИЗ
		|	Документ.УведомлениеОВозвратеГИСГМП КАК УведомлениеОВозвратеГИСГМП
		|ГДЕ
		|	УведомлениеОВозвратеГИСГМП.Ссылка В(&МассивДокументов)
		|ИТОГИ ПО
		|	Организация,
		|	ЭтоНовыйДокумент";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОрганизация.Следующий() Цикл
		//Отдельно формируются пакеты с новыми документами (начислениями/возвратам) и отдельно с изменениями/аннулированием/деаннулированием,
		//т.к. по форматам 2.1 ГИС ГМП и ИС УНП в пакете могут быть либо только новые, либо только изменения.
		
		ВыборкаВидДокумента = ВыборкаОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаВидДокумента.Следующий() Цикл
			СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
			СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
			СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
			СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
			СтруктураДляФормирования.Вставить("Организация", ВыборкаОрганизация.Организация);
			СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
			СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
			ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
		
			ВыборкаДетальныеЗаписи = ВыборкаВидДокумента.Выбрать();
						
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл		
				НовСтр = ТекОбъектыОбмена.Добавить();
				НовСтр.Объект = ВыборкаДетальныеЗаписи.Ссылка;
				
				НовСтр.Формат = ФорматЭкспорта;
			КонецЦикла;
			
			СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
			МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
		КонецЦикла;
	КонецЦикла;
			
	ОбработкаФормирования = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	ОбработкаФормирования.КоличествоДокументовВОдномФайле = РазмерПакета;
	ОбработкаФормирования.ОбменСЭмулятором = ОбменСЭмулятором;
	
	ФразаИдентификатор = "%ТутБудетИдентификаторСообщения%";
	НуженНовыйПул = Истина;
	
	СоответствиеНомеровПакетов = Новый Соответствие;
	НомерТек = 1;
	Для Инд = 0 По МассивСтруктурФормированияФайлов.Количество()-1 Цикл
		ОбработкаФормирования.ИдентификаторСообщения = ФразаИдентификатор;//БиблиотекаФункцийОбмена.ПолучитьUUIDТекущегоВремени();
		ОбработкаФормирования.мОрганизация = МассивСтруктурФормированияФайлов[Инд].Организация;
		ОбработкаФормирования.СоответствиеОбработанныхФорматов = Неопределено;
		ОбработкаФормирования.СформироватьФайлы(МассивСтруктурФормированияФайлов[Инд]);
				
		Для Каждого КлючИЗначение Из МассивСтруктурФормированияФайлов[Инд].РезультатФормирования Цикл
			
			ТекUUID = БиблиотекаФункцийОбмена.ПолучитьUUIDТекущегоВремени(НуженНовыйПул);
			
			СоответствиеНомеровПакетов.Вставить(КлючИЗначение.Ключ,НомерТек);
						
			СтрФайлов = ФайлыРезультатаФормирования.Добавить();
			СтрФайлов.НомерПакета = НомерТек;
			СтрФайлов.СодержимоеФайла = СтрЗаменить(КлючИЗначение.Значение,ФразаИдентификатор,ТекUUID);
			//СтрФайлов.ИдентификаторСообщения = ОбработкаФормирования.ИдентификаторСообщения;
			СтрФайлов.ФорматОбмена = ФорматЭкспорта;
			СтрФайлов.ТекущийУчастник = МассивСтруктурФормированияФайлов[Инд].Организация;
			
			НомерТек = НомерТек + 1;
			НуженНовыйПул = Ложь;
		КонецЦикла;
		
		Для Каждого СтрокаОбмена Из МассивСтруктурФормированияФайлов[Инд].ОбъектыОбмена Цикл
			НовСтр = РезультатФормирования.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,СтрокаОбмена);
			НовСтр.ТекущийУчастник = МассивСтруктурФормированияФайлов[Инд].Организация;
			НовСтр.НомерПакета = СоответствиеНомеровПакетов[СтрокаОбмена.ИмяФайлаВыгрузки];
			ЕстьОшибки = ЕстьОшибки ИЛИ ЗначениеЗаполнено(НовСтр.ОписаниеОшибки);
		КонецЦикла;
				
	КонецЦикла;
		
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));

КонецПроцедуры

&НаСервере
Процедура СоздатьПакетыНачисленийВозвратов()
	
	ТабРезультатФормирования = РеквизитФормыВЗначение("РезультатФормирования");
	ТабРезультатФормирования.Индексы.Добавить("НомерПакета");
		
	МассивСертификатов = Новый Массив;
	Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.СодержимоеФайла) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрТЧ.Подписано Тогда
			Если МассивСертификатов.Найти(СтрТЧ.Сертификат) = Неопределено Тогда
				МассивСертификатов.Добавить(СтрТЧ.Сертификат);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеСертификатов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивСертификатов,"ДанныеСертификата,КомуВыдан");
	
	УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.ОжидаетОтправки;
	
	Если ТекущееДействие = "СформироватьПакетыНачислений" Тогда
		ИмяДок = "ПакетНачисленийГИСГМП";
		СписокОтмеченныеКвитанции.Очистить();
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокКвитанций,"ОтмеченныеКвитанции",СписокОтмеченныеКвитанции,Истина);
	Иначе
		ИмяДок = "ПакетУведомленийОВозвратеГИСГМП";
		СписокОтмеченныеВозвраты.Очистить();
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"ОтмеченныеВозвраты",СписокОтмеченныеВозвраты,Истина);
	КонецЕсли;
		
	МассивПакетов = Новый Массив;
	
	Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.СодержимоеФайла) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрТЧ.Подписано Тогда
			НовПакет = Документы[ИмяДок].СоздатьДокумент();
			НовПакет.Дата = ТекущаяДатаСеанса();
			НовПакет.Организация = СтрТЧ.ТекущийУчастник;
			НовПакет.ДанныеДокумента = Новый ХранилищеЗначения(СтрТЧ.СодержимоеФайла);
			НовПакет.ДанныеПодписи = Новый ХранилищеЗначения(СтрТЧ.Подпись);
						
			СтрокиРезультата = ТабРезультатФормирования.НайтиСтроки(Новый Структура("НомерПакета",СтрТЧ.НомерПакета));
			
			МассивДокументов = Новый Массив;
			
			Для Каждого СтрРезультата Из СтрокиРезультата Цикл
				Если ЗначениеЗаполнено(СтрРезультата.ОписаниеОшибки) Тогда
					Продолжить;
				КонецЕсли;
				
				МассивДокументов.Добавить(СтрРезультата.Объект);
				
				СтруктураРекв = Новый Структура;
				СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",СтрРезультата.Объект);
				СтруктураРекв.Вставить("Статус",УстанавливаемыйСтатус);
				ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
		
			КонецЦикла;
			
			НовПакет.ЗаполнитьДанныеТЧПоДокументам(МассивДокументов);
			
			НовПакет.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
			
			НовПакет.УстановившийПодпись = Пользователи.ТекущийПользователь();
			НовПакет.ДанныеСертификата = ДанныеСертификатов[СтрТЧ.Сертификат].ДанныеСертификата;
			НовПакет.КомуВыданСертификат = ДанныеСертификатов[СтрТЧ.Сертификат].КомуВыдан;
			
			НовПакет.Записать();
			МассивПакетов.Добавить(НовПакет.Ссылка);
		КонецЕсли;	
	КонецЦикла;
	
	ТекстСообщения = Нстр("ru='Создано пакетов: %1'");
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,МассивПакетов.Количество());
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
	Если ПриФормированииПакетов <> 0 Тогда
		//Нужен массив пакетов
		мМассивПакетов = Новый ФиксированныйМассив(МассивПакетов);
	Иначе
		мМассивПакетов = Новый ФиксированныйМассив(Новый Массив);
	КонецЕсли;
	
	ЗаполнитьСписокПакетов();
	
	Если ТекущееДействие = "СформироватьПакетыНачислений" Тогда		
		Элементы.СписокКвитанций.Обновить();
		//ЗаполнитьСписокКвитанций(Истина);
	Иначе
		Элементы.СписокВозвратов.Обновить();
		//ЗаполнитьСписокВозвратов(Истина);
	КонецЕсли;
	
	//Очистим таблицы формирования файлов, т.к. это был последний этап текущего действия
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область ОбщиеПроцедурыОбмена

&НаСервере
Функция ПроверитьВозможностьФормированияПоПараметрам(ИмяТаблицы,МассивПараметров,СтруктураОтбора = Неопределено,ТекстСообщения=Неопределено)
	
	//ТекстПользовательскогоСообщения = "";
	Если СтруктураОтбора = Неопределено Тогда
		СтруктураОтбора = Новый Структура("Использовать",Истина);
	КонецЕсли;
	Если ТекстСообщения = Неопределено Тогда
		ТекстСообщения = Нстр("ru='Не выбраны документы.'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
		СтрокиЭкспорта = ЭтотОбъект[ИмяТаблицы].НайтиСтроки(СтруктураОтбора);
		
		КоличествоСтрок = СтрокиЭкспорта.Количество();
		
		Если СтрокиЭкспорта.Количество()= 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат Ложь;	
		КонецЕсли;
	КонецЕсли;
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
	
	НастройкаФорматов = НастройкиУчастника.НастройкаФорматов;
	
	Для Каждого ТекНастройка Из МассивПараметров Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
			|ИЗ
			|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
			|ГДЕ
			|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
			|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя
			|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.Наименование В (&ИмяФормата)";

		Запрос.УстановитьПараметр("НастройкаФормата", НастройкаФорматов);
		Запрос.УстановитьПараметр("ПолноеИмя", "Документ."+ТекНастройка.ИмяДокумента);
		Запрос.УстановитьПараметр("ИмяФормата", ТекНастройка.ИмяФормата);
		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		Если СтрНачинаетсяС(ТекНастройка.РеквизитФормата,"Массив") Тогда
			ТекМассив = Новый Массив;
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ТекМассив.Добавить(ВыборкаДетальныеЗаписи.ФорматЭкспорта);
			КонецЦикла;
			ЭтотОбъект[ТекНастройка.РеквизитФормата] = Новый ФиксированныйМассив(ТекМассив);
		Иначе
			ЭтотОбъект[ТекНастройка.РеквизитФормата] = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка(); 
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				ЭтотОбъект[ТекНастройка.РеквизитФормата] = ВыборкаДетальныеЗаписи.ФорматЭкспорта;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект[ТекНастройка.РеквизитФормата]) Тогда
			ПредставлениеДокумента = Метаданные.Документы[ТекНастройка.ИмяДокумента].Синоним;
			Текст = Нстр("ru='Не задан формат экспорта с кодом ""%1"" для документа ""%2""'");
			Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,ТекНастройка.ИмяФормата,ПредставлениеДокумента);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
			Возврат Ложь;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Асинх Процедура ВыполнитьДействияОтправкиСообщенийНаКлиенте()
	
	ЕстьОшибки = Ложь;
	
	Если ФайлыСформированы = Ложь Тогда
			
		ДопПараметры = Новый Структура;
		ТекстОшибки = "";
	
		//формирования файлов всегда выполняется на сервере, перейдем в главную процедуру сервера
		
		ВыполнитьДействияОтправкиСообщенийНаСервере(ЕстьОшибки,ТекстОшибки,ДопПараметры);
		
		Если ЕстьОшибки
			ИЛИ Тестирование Тогда
			ОбработатьОшибки(ЕстьОшибки,ТекстОшибки,ДопПараметры);
			Возврат;
		КонецЕсли;
		
		Если ФайлыСформированы = Ложь Тогда
			//Файлы не сформированы, но ошибок нет, значит нет данных для формирования файлов
			ФайлыСформированы = Ложь;
			ФайлыПодписаны = Ложь;
			ФайлыОтправлены = Ложь;
			НеобходимоЕщеРазЗапроситьОчередь = Ложь;
			
			Если ТекущееДействие = "ОбработатьЗапросы" Тогда
								
				//если обрабатываем запросы из очереди, и запросов в очереди нет, то запросим данные из сервиса,
				//если включено автоматическое получение данных			
			
				ВключитьОтключитьАвтоматическийОбменОчередиЗапросов();
				
				Возврат;
				
			ИначеЕсли ТекущееДействие = "ЗапроситьРезультатОбработки"
				И ВыполнятьОбработкуОчередиЗапросов Тогда
				
				//если включено автоматическое получение данных, и для запроса результата обработки (по ID) из ИС РНИП/ИС УНП данных нет,
				//то снова обработаем запросы очереди
				
				ТекущееДействие = "ОбработатьЗапросы";
				
				ПодключитьОбработчикОжидания("ПриступитьКОбработкеОчередиЗапросов",3,Истина);
				
				Возврат;
			ИначеЕсли ТекущееДействие = "ЗапросПлатежейЗаПериод" Тогда
				//добавлен в очередь сервиса
				Возврат;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
		
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Ложь Тогда
				
		ДопПараметры = Новый Структура;
		ТекстОшибки = "";
		
		Если ВыполнятьПодписьНаСервере Тогда
			ВыполнитьДействияОтправкиСообщенийНаСервере(ЕстьОшибки,ТекстОшибки,ДопПараметры);
		Иначе
			
			ИмяУзлаСП = "";
			
			Если ТекущееДействие = "ОтправитьКаталог" Тогда
				ИмяУзлаСП = "ImportCatalogRequest";//остальные уже подписаны, или подпись не нужна
			КонецЕсли;
			
			ТекстОшибки = Ждать ГосУслугиКлиент.ПодписатьДанныеПоФорматуГИСГМП20НаКлиенте(КомпонентаПодписи,Объект.Участник,ФайлыРезультатаФормирования,ИмяУзлаСП,"Авто");
							
 			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				ЕстьОшибки = Истина;
			КонецЕсли;
			
			ФайлыПодписаны = Истина;
		КонецЕсли;
		
		Если ЕстьОшибки
			ИЛИ Тестирование Тогда
			ОбработатьОшибки(ЕстьОшибки,ТекстОшибки,ДопПараметры);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Истина
		И ФайлыОтправлены = Ложь Тогда
		
		ДопПараметры = Новый Структура;
		ТекстОшибки = "";
	
		ЭтоВебКлиент = ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент();
		
		ВыполнятьОбменНаСервере = (ПараметрыНастройкиОбмена.ОбменНаКлиенте = Ложь);
		
		Если ПараметрыНастройкиОбмена.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.WebСервис") Тогда
			Если ВыполнятьОбменНаСервере 
				ИЛИ ЭтоВебКлиент Тогда			
			    ВыполнитьДействияОтправкиСообщенийНаСервере(ЕстьОшибки,ТекстОшибки,ДопПараметры);
			Иначе
				ОграничениеОчереди = ОграничениеОчередиЗапросов(ВыполнятьОбработкуОчередиЗапросов);
				
				ТекстОшибки = Ждать ЭкспортФайловКлиент.ОтправитьФайлыВСервисНаКлиенте(ФайлыРезультатаФормирования,СоответствиеЗаголовковФорматов,ПараметрыНастройкиОбмена,ОграничениеОчереди,ФорматПодтверждения,КомпонентаПодписи); 
				Если ЗначениеЗаполнено(ТекстОшибки) Тогда
					ЕстьОшибки = Истина;
				КонецЕсли;
				ОбработатьОтветыОбменаСоСМЭВ(ЕстьОшибки);
				ФайлыОтправлены = Истина;
			КонецЕсли;
			
			Если ЕстьОшибки
				ИЛИ Тестирование Тогда
				ОбработатьОшибки(ЕстьОшибки,ТекстОшибки,ДопПараметры);
				Возврат;
			КонецЕсли;
			
			Если НЕ (ФайлыСформированы = Истина
				И ФайлыПодписаны = Истина
				И ФайлыОтправлены = Истина) Тогда
				//значит на сервере после отправки начали новое действие - подтверждение полученных сообщений
				//для этого закончим эту процедуру и вызовем ее заново для прохождения всех этапов
				ВыполнитьДействияОтправкиСообщенийНаКлиенте();
				Возврат;
			КонецЕсли;
		Иначе
			//В каталог или ftp
			ОписаниеОпов = Новый ОписаниеОповещения("ПослеЛокальнойВыгрузкиФайлов",ЭтотОбъект);
			ЭкспортФайловКлиент.ВыгрузитьФайлыЛокально(ФайлыРезультатаФормирования,РезультатФормирования,ПараметрыНастройкиОбмена,ЕстьОшибки,ТекстОшибки,ОписаниеОпов);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Истина
		И ФайлыОтправлены = Истина Тогда
		
		КоличествоСообщенийПолучено = 0; //ТаблицаПодтвержденияПолученияСообщений.Количество();
		КоличествоСообщенийОтправлено = 0;
		КоличествоСообщенийПодтверждено = 0;
		ОбщееКолВо = 0;
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			ОбщееКолВо = ОбщееКолВо + 1;
			Если НЕ ЗначениеЗаполнено(СтрТЧ.СтатусОтправки)
				ИЛИ СтрТЧ.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен") Тогда
				//Обмен не выполнялся
				Продолжить;
			КонецЕсли;
			Если СтрТЧ.ЕстьДанные Тогда
				КоличествоСообщенийПолучено = КоличествоСообщенийПолучено + 1;
			КонецЕсли; 
			Если СтрТЧ.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ПодтверждениеПолученияСообщенияСМЭВ") Тогда
				КоличествоСообщенийПодтверждено = КоличествоСообщенийПодтверждено + 1;	
			КонецЕсли;
			КоличествоСообщенийОтправлено = КоличествоСообщенийОтправлено + 1;
		КонецЦикла;
		
		//Сообщим о результате обмена
		ТекстСообщения = "";
		Если ТекущееДействие = "ПодтвердитьПолучениеСообщения" Тогда
			
			ТекстСообщения = НСтр("ru='Обмен %1. Подтверждено получение сообщений %2 из %3.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ТекущаяДата(),КоличествоСообщенийОтправлено,ОбщееКолВо);

		ИначеЕсли ТекущееДействие = "ЗапроситьДанныеИзОчередиОтветов"
			ИЛИ ТекущееДействие = "ЗапроситьДанныеИзОчередиСтатусов"
			ИЛИ ТекущееДействие  = "ЗапроситьРезультатОбработки" Тогда
			
			Если КоличествоСообщенийПодтверждено = 0 Тогда
				ТекстСообщения = НСтр("ru='Обмен %1. Отправлено сообщений %2 из %3, получено ответов с данными %4.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ТекущаяДата(),КоличествоСообщенийОтправлено,ОбщееКолВо,КоличествоСообщенийПолучено);
			Иначе
				ТекстСообщения = НСтр("ru='Обмен %1. Отправлено сообщений %2 из %3, получено ответов с данными %4, подтверждено %5.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ТекущаяДата(),КоличествоСообщенийОтправлено,ОбщееКолВо,КоличествоСообщенийПолучено,КоличествоСообщенийПодтверждено);	
			КонецЕсли;
            Если ЗначениеЗаполнено(ДополнительныйТекстСообщенияОЗагрузкеДанных) Тогда
				ТекстСообщения = ТекстСообщения +"
				|"+ДополнительныйТекстСообщенияОЗагрузкеДанных;
			КонецЕсли;
		Иначе
			
			ТекстСообщения = НСтр("ru='Обмен %1. Отправлено сообщений %2 из %3.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ТекущаяДата(),КоличествоСообщенийОтправлено,ОбщееКолВо);

		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстСообщения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
		//После того, как было завершено действие запроса данных из очереди СМЭВ,
		//необходимо выполнить действие - подтверждение получения сообщения данных из очереди,
		//если еще не все сообщения подтверждены.
		Если КоличествоСообщенийПолучено > 0
			И КоличествоСообщенийПолучено <> КоличествоСообщенийПодтверждено
			И ТребуетсяПодтверждениеПолученныхСообщений Тогда
			
			ЭтоБылЗапросРезультатаПоID = (ТекущееДействие = "ЗапроситьРезультатОбработки");
			
			//Текущее действие могло быть изменено в серверной процедуре
			Если ТекущееДействие <> "ПодтвердитьПолучениеСообщения" Тогда
								
				ТекущееДействие = "ПодтвердитьПолучениеСообщения";
				ФайлыСформированы = Ложь;
				ФайлыПодписаны = Ложь;
				ФайлыОтправлены = Ложь;
			КонецЕсли;
			
			Если НЕ ЭтоБылЗапросРезультатаПоID Тогда
				//Если это был запрос результата по ID, то ничего из очереди больше запрашивать не надо.
				//Если это запрос очереди, то запросим те сообщения, на который был ответ.
				
				СоответствиеФорматовРезультатов = Новый Соответствие;
				//в таблице будут по каждой строке - есть данные в ответе или нет
				//если есть данные и очередь позволяет получать все сообщения сразу,
				//то в конец таблицы копируется строка с форматом по которому есть данные и запрашивается еще раз.
				//и так пока данные не закончатся в сервисе - так работает СМЭВ 3.
				//Если обмен с ИС РНИП - то очередь возвращает только один ответ и пока его не подтвердить,
				//следующий получить нельзя.
				//Поэтому если в тч по формату нет строки, в котрой для него в ответе нет данных,
				//то надо запросить очередь еще раз.
				Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
				 	СоответствиеФорматовРезультатов.Вставить(СтрТЧ.ФорматОбмена,СтрТЧ.ЕстьДанные);				
				КонецЦикла;
				Для Каждого КлючИЗначение Из СоответствиеФорматовРезультатов Цикл
					Если КлючИЗначение.Значение = Истина Тогда
						НеобходимоЕщеРазЗапроситьОчередь = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
					
			ВыполнитьДействияОтправкиСообщенийНаКлиенте();
			Возврат;//здесь прерываем, чтобы вопрос о запросе новой порции был задан после подтверждения получения уже полученных сообщений 
		КонецЕсли;
		
		Если ТекущееДействие = "ПодтвердитьПолучениеСообщения"
			И НеобходимоЕщеРазЗапроситьОчередь Тогда
								
			ТекущееДействие = "ЗапроситьДанныеИзОчередиОтветов";
			ФайлыСформированы = Ложь;
			ФайлыПодписаны = Ложь;
			ФайлыОтправлены = Ложь;
			НеобходимоЕщеРазЗапроситьОчередь = Ложь;
			
			ВыполнитьДействияОтправкиСообщенийНаКлиенте();
			Возврат;
		КонецЕсли;
		
		//После того, как было завершено действие подтверждения получения данных из очереди СМЭВ,
		//необходимо выполнить действие - запрос следующей порции данных, если в ответ вернулся признак hasMore = true.
		
		//При отправке запросов по настройкам регистра, КоличествоЗапросовНовыхДанных не заполняется, и вопрос задаваться не будет 
		Если КоличествоЗапросовНовыхДанных >0
			И ПредКоличествоЗапросов <> КоличествоЗапросовНовыхДанных Тогда
			
			ПредКоличествоЗапросов = КоличествоЗапросовНовыхДанных;
			
			СписокОтветов = Новый СписокЗначений;
			СписокОтветов.Добавить(КодВозвратаДиалога.ОК,"Запросить");
			СписокОтветов.Добавить(КодВозвратаДиалога.Отмена,"Не сейчас");
			СписокОтветов.Добавить(КодВозвратаДиалога.Пропустить,"Не требуется");
		
			ОписаниеОп = Новый ОписаниеОповещения("ПослеОтветаНаВопросОЗапросеДанных",ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОп,НСтр("ru='В ответе из сервиса вернулись не все запрашиваемые данные.
				|Запросить следующую порцию данных?'"),СписокОтветов);
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ВыполнятьЗапросДанныхПослеОтправкиСообщения
		И ВремяЗапросаДанныхИзОчереди >0
		И ПараметрыНастройкиОбмена.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.WebСервис") Тогда
		
		МассивДействийДляЗапросаДанныхИзОчереди = Новый Массив;
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ОтправитьПакеты");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ОтправитьПакетПовторно");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ОтправитьКаталог");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапросСтатусаНачислений");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапросНаКвитированиеСПлатежами");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапросНаКвитированиеБезПлатежа");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапросНаКвитированиеБезПлатежаСУказаниемСуммы");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапросНаОтменуКвитированияБезПлатежа");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапросНаОтменуКвитированияСПлатежами");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапросПлатежейПоНачислению");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапросПлатежейЗаПериод");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапросВозврата");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапросКвитанций");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ОтправитьПроизвольныйЗапрос");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапроситьДоступныеПодписки");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапроситьНСИ");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ОтправитьНачисленияОтПосредника");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ОтправитьПодписку");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ПодписатьсяНаНачисленияДляПосредникаПоУИН");		
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ОтписатьсяОтНачисленийДляПосредникаПоУИН");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ПодписатьсяНаКвитанцииДляПосредникаПоУИН");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ОтписатьсяОтКвитанцийДляПосредникаПоУИН");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("ЗапроситьНовуюПорциюДанных");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("Квитирование_ВыполнитьОбменСЭмулятором");
		МассивДействийДляЗапросаДанныхИзОчереди.Добавить("УведомленияПоПодписке_ВыполнитьОбменСЭмулятором");
		//"ЗапроситьДанныеИзОчередиОтветов", "ПодтвердитьПолучениеСообщения", "ЗапроситьРезультатОбработки" - не учитываем 
	
		Если МассивДействийДляЗапросаДанныхИзОчереди.Найти(ТекущееДействие) <> Неопределено Тогда
			ПодключитьОбработчикОжидания("ЗапросДанныхИзОчередиПослеОтправкиПоНастройке",ВремяЗапросаДанныхИзОчереди,Истина);
			Возврат;
		КонецЕсли;
				
	КонецЕсли;
	
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Истина
		И ФайлыОтправлены = Истина Тогда
		
		Если ТекущееДействие = "ОбработатьЗапросы" Тогда
			//если это обработка запросов очереди к сервису (из регистра) то после отправки запросов обязательно надо получить результат обработки
			
			ФайлыСформированы = Ложь;
			ФайлыПодписаны = Ложь;
			ФайлыОтправлены = Ложь;
			НеобходимоЕщеРазЗапроситьОчередь = Ложь;
			
			НачатьПолучениеДанныхИзСервиса();
			
		ИначеЕсли ТекущееДействие = "ПодтвердитьПолучениеСообщения"
			И ВыполнятьОбработкуОчередиЗапросов Тогда
			
			//если мы что-то подтвердили и выполняется автоматический обмен очереди, то снова обработаем регистр очереди запросов 
			
			ТекущееДействие = "ОбработатьЗапросы";
			
			ФайлыСформированы = Ложь;
			ФайлыПодписаны = Ложь;
			ФайлыОтправлены = Ложь;
			НеобходимоЕщеРазЗапроситьОчередь = Ложь;
				
			ПодключитьОбработчикОжидания("ПриступитьКОбработкеОчередиЗапросов",3,Истина);
			
		ИначеЕсли (ТекущееДействие = "ЗапроситьДанныеИзОчередиОтветов"
				ИЛИ ТекущееДействие = "ЗапроситьДанныеИзОчередиСтатусов"
				ИЛИ ТекущееДействие  = "ЗапроситьРезультатОбработки")
			И ( КоличествоСообщенийПолучено = 0
				ИЛИ КоличествоСообщенийПолучено = КоличествоСообщенийПодтверждено)
			И ВыполнятьОбработкуОчередиЗапросов Тогда
			
			// если был запрос из очереди ГИС ГМП, но в ответе данных нет, то снова обработаем регистр очереди запросов
			
			ТекущееДействие = "ОбработатьЗапросы";
			
			ФайлыСформированы = Ложь;
			ФайлыПодписаны = Ложь;
			ФайлыОтправлены = Ложь;
			НеобходимоЕщеРазЗапроситьОчередь = Ложь;
				
			ПодключитьОбработчикОжидания("ПриступитьКОбработкеОчередиЗапросов",3,Истина);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОграничениеОчередиЗапросов(ВыполнятьОбменОчередиЗапросов)
	//при автоматическом обмене ограничим в 30
	ОграничениеОчереди = 0;//настройки по умолчанию - по данным константы
	Если ВыполнятьОбменОчередиЗапросов Тогда
		ОграничениеОчереди = 30;
	КонецЕсли;
	Возврат ОграничениеОчереди;
КонецФункции

&НаКлиенте
Процедура ЗапросДанныхИзОчередиПослеОтправкиПоНастройке() Экспорт
	Если Элементы.ФормаГруппаЗапросРезультатаОбработки.Видимость Тогда
		
		Если НуженЗапросРезультатовОбработки() Тогда 
			ЗапроситьРезультатОбработкиОтправленныхСообщений(Неопределено);//обмен с ИС РНИП или ИС УНП, запросим отправленные сообщения по ID
		КонецЕсли;
	Иначе
		ЗапроситьДанныеИзОчередиОтветов(Неопределено);//обмен с ГИС ГМП, запросим данные из очереди
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НуженЗапросРезультатовОбработки()
	НуженЗапрос = Ложь;
	
	РезультатЗапроса = ПолучитьСообщенияДляЗапросаПоID();
		
	ИдентификаторыДляЗапроса = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ИдентификаторСообщения");
	Если ИдентификаторыДляЗапроса.Количество() Тогда
		НуженЗапрос = Истина;
	КонецЕсли;
	
	Возврат НуженЗапрос;
КонецФункции



&НаКлиенте
Процедура ПослеЛокальнойВыгрузкиФайлов(Результат,ДопПараметры) Экспорт
	ОбработатьОтветыОбменаСоСМЭВ(Ложь);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьДействияОтправкиСообщенийНаСервере(ЕстьОшибки,ТекстОшибки,ДопПараметры)
	
	ЕстьОшибки = Ложь;
	
	Если ФайлыСформированы = Ложь Тогда
		
		ПродолжениеНеТребуется = Ложь;
		
		//тут можно добавить процедуры формирования файлов
		Если ТекущееДействие = "ОтправитьПакеты"
			ИЛИ ТекущееДействие = "ОтправитьПакетПовторно" Тогда				
			СформироватьФайлыПоПакетам(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ОтправитьКаталог" Тогда
			СформироватьФайлыПоКаталогуУслуг(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ЗапроситьДоступныеПодписки" Тогда
			СформироватьФайлыПоЗапросуДоступныхПодписок(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ОтправитьПодписку" Тогда
			СформироватьФайлыДляФормированияПодписки(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ПодписатьсяНаНачисленияДляПосредникаПоУИН" Тогда
			СформироватьФайлыДляПодпискиНаНачисленияПоУИН(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ПодписатьсяНаКвитанцииДляПосредникаПоУИН" Тогда
			СформироватьФайлыДляПодпискиНаКвитанцииНачисленийСПлатежамиПоУИН(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ОтписатьсяОтНачисленийДляПосредникаПоУИН" Тогда
			СформироватьФайлыДляОтключенияПодпискиНаНачисленияПоУИН(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ОтписатьсяОтКвитанцийДляПосредникаПоУИН" Тогда
			СформироватьФайлыДляОтключенияПодпискиНаКвитанцииНачисленийСПлатежамиПоУИН(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ЗапроситьНСИ" Тогда
			СформироватьФайлыПоЗапросуНСИ(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ОтправитьНачисленияОтПосредника" Тогда
			СформироватьФайлыПоНачислениямОтПосредника(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ЗапросСтатусаНачислений" Тогда
			СформироватьФайлыПоЗапросамСтатусаНачислений(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ЗапросНаКвитированиеСПлатежами" Тогда
		    СформироватьФайлыПоЗапросуКвитированияНачисленийСПлатежами(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ЗапросНаКвитированиеБезПлатежа" Тогда
			СформироватьФайлыПоЗапросуКвитированияНачисленийБезПлатежа(ЕстьОшибки);			
		ИначеЕсли ТекущееДействие = "ЗапросНаКвитированиеБезПлатежаСУказаниемСуммы" Тогда			
			СформироватьФайлыПоЗапросуКвитированияНачисленийБезПлатежаСУказаниемСуммы(ЕстьОшибки);			
		ИначеЕсли ТекущееДействие = "ЗапросНаОтменуКвитированияБезПлатежа" Тогда
			СформироватьФайлыПоЗапросуНаОтменуКвитированияНачисленийБезПлатежа(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ЗапросНаОтменуКвитированияСПлатежами" Тогда
			СформироватьФайлыПоЗапросуНаОтменуКвитированияНачисленийСПлатежами(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ЗапросПлатежейПоНачислению" Тогда
			СформироватьЗапросПлатежейПоНачислению(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ЗапросПлатежейЗаПериод" Тогда			
			СформироватьЗапросПлатежейЗаПериод(ЕстьОшибки,ПродолжениеНеТребуется);
		ИначеЕсли ТекущееДействие = "ЗапросВозврата" Тогда
			СформироватьФайлыПоЗапросуВозвратов(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ЗапросКвитанций" Тогда
			СформироватьФайлыПоЗапросуКвитанций(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ОтправитьПроизвольныйЗапрос" Тогда
			СформироватьФайлыПроизвольногоЗапроса(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ОтправитьЗапросыАЗ" Тогда
			
			СформироватьФайлыПоСпискуЗапросов(ЕстьОшибки);
			
		ИначеЕсли ТекущееДействие = "ЗапроситьДанныеИзОчередиОтветов" Тогда
			СформироватьЗапросДанныхИзОчереди(ЕстьОшибки,Перечисления.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСМЭВ);
		ИначеЕсли ТекущееДействие = "ЗапроситьНовуюПорциюДанных" Тогда
			СформироватьФайлыСообщенияЗапросаНовойПорцииДанных(ЕстьОшибки);
		ИначеЕсли ТекущееДействие = "ЗапроситьДанныеИзОчередиСтатусов" Тогда
			СформироватьЗапросДанныхИзОчереди(ЕстьОшибки,Перечисления.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСтатусов);
		ИначеЕсли ТекущееДействие = "ПодтвердитьПолучениеСообщения" Тогда
			СформироватьПодтверждениеПолученияСообщения(ЕстьОшибки);
			
		ИначеЕсли ТекущееДействие = "Квитирование_ВыполнитьОбменСЭмулятором" Тогда
			СформироватьФайлыПоЗапросуКвитированияСЭмулятором(ЕстьОшибки);
			
		ИначеЕсли ТекущееДействие = "УведомленияПоПодписке_ВыполнитьОбменСЭмулятором" Тогда
			СформироватьФайлыУведомленияПоПодпискеСЭмулятором(ЕстьОшибки);
			
		ИначеЕсли ТекущееДействие = "ОбработатьЗапросы" Тогда
			ОбработатьПользовательскиеЗапросыНаСервере(ЕстьОшибки,ПродолжениеНеТребуется);	
						
		//УНП/ИС РНИП - запрос по отправленным
		ИначеЕсли ТекущееДействие = "ЗапроситьРезультатОбработки" Тогда
		    ПрерватьОбмен = Ложь;
			СформироватьФайлыПоЗапросуРезультатаОбработки(ЕстьОшибки, ПрерватьОбмен);
			Если ПрерватьОбмен Тогда
				//если нет ID сообщений, по которым нужно запросить, то обмен прервем
				
				Возврат;
			КонецЕсли;
		Иначе
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		Если ПродолжениеНеТребуется Тогда
			//запросы добавлены в регистры очередей
			Возврат;
		КонецЕсли;
		
		//заполняем признак, что сообщение можно отправить повторно для получения следующего сообщения очереди,
		//если предыдущие мы подтвердим сразу после получения
		
		СоответствиеНастройкиФорматов = Новый Соответствие;
		
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			Если СтрТЧ.ВидСообщения	= Перечисления.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСМЭВ
				ИЛИ СтрТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСтатусов Тогда
				
				ПоддерживаетПовторныйЗапрос = СоответствиеНастройкиФорматов[СтрТЧ.ФорматОбмена];
				Если ПоддерживаетПовторныйЗапрос = Неопределено Тогда
					ИмяФормата = ВРег(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрТЧ.ФорматОбмена,"Наименование"));
				    ПоддерживаетПовторныйЗапрос = (СтрЗаканчиваетсяНа(ИмяФормата,"BYID") = Ложь);
					СоответствиеНастройкиФорматов.Вставить(СтрТЧ.ФорматОбмена,ПоддерживаетПовторныйЗапрос);
				КонецЕсли;
				СтрТЧ.ПоддерживаетПовторныйЗапрос = ПоддерживаетПовторныйЗапрос;	
				
			КонецЕсли;
		КонецЦикла;
		
		//
		ФайлыСформированы = Истина;
		//
		Если ЕстьОшибки
			ИЛИ Тестирование Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Ложь Тогда
		ТекстОшибки = "";
				
		Если ВыполнятьПодписьНаСервере Тогда
			
			ИмяУзлаСП = "";
			
			Если ТекущееДействие = "ОтправитьКаталог" Тогда
				ИмяУзлаСП = "ImportCatalogRequest";//остальные уже подписаны, или подпись не нужна
			КонецЕсли;
		
			ГосУслуги.ПодписатьДанныеПоФорматуГИСГМП20НаСервере(Объект.Участник,ФайлыРезультатаФормирования,ТекстОшибки,ИмяУзлаСП,"Авто");
			//
			ФайлыПодписаны = Истина;
			//
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				ЕстьОшибки = Истина;
			КонецЕсли;
			
			Если ЕстьОшибки 
				ИЛИ Тестирование Тогда
				//Можно указать дополнительные параметры
				Возврат;
			КонецЕсли;
		Иначе
			Возврат;//выполним подпись на клиенте
		КонецЕсли;
	КонецЕсли;
	
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Истина
		И ФайлыОтправлены = Ложь Тогда
		
		ЭтоВебКлиент = ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент();
		
		ВыполнятьОбменНаСервере = (ПараметрыНастройкиОбмена.ОбменНаКлиенте = Ложь);
		
		Если ПараметрыНастройкиОбмена.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.WebСервис")
			И (ВыполнятьОбменНаСервере 
				ИЛИ ЭтоВебКлиент) Тогда
			//тут отправка на сервере
			
			ОграничениеОчереди = ОграничениеОчередиЗапросов(ВыполнятьОбработкуОчередиЗапросов);
			
			ЭкспортФайлов.ОтправитьФайлыВСервисНаСервере(ФайлыРезультатаФормирования,СоответствиеЗаголовковФорматов,ПараметрыНастройкиОбмена,ЕстьОшибки,ТекстОшибки,ОграничениеОчереди,ФорматПодтверждения); 
			ОбработатьОтветыОбменаСоСМЭВ(ЕстьОшибки);
			ФайлыОтправлены = Истина;
			Если ЕстьОшибки 
				ИЛИ Тестирование Тогда
				Возврат;
			КонецЕсли;
		Иначе
			Возврат;//выполним отправку на клиенте
		КонецЕсли;
	КонецЕсли;
	
	//Вернем управление на клиент. Если возникнет необходимость посылать новые запросы, будем вызывать их с клиента.
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,ВидСообщения,ЕстьОшибки,ДополнительныеПараметрыФорматов = Неопределено)
	
	ОбработкаФормирования = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	ОбработкаФормирования.ОбменСЭмулятором = ОбменСЭмулятором;
	ОбработкаФормирования.ДополнительныеПараметрыЭкспорта = ДополнительныеПараметрыФорматов;//если доп.параметры заданы общие
	НомерТек = 1;
	ФразаИдентификатор = "%ТутБудетИдентификаторСообщения%";
	Для Инд = 0 По МассивСтруктурФормированияФайлов.Количество()-1 Цикл
		ОбработкаФормирования.ИдентификаторСообщения = ФразаИдентификатор;
		ОбработкаФормирования.мОрганизация = МассивСтруктурФормированияФайлов[Инд].Организация;
		ОбработкаФормирования.СоответствиеОбработанныхФорматов = Неопределено;
		Если МассивСтруктурФормированияФайлов[Инд].Свойство("ДополнительныеПараметрыФорматов") Тогда
			//если доп.параметры заданы для каждого элемента массива
			ОбработкаФормирования.ДополнительныеПараметрыЭкспорта = МассивСтруктурФормированияФайлов[Инд].ДополнительныеПараметрыФорматов;
		КонецЕсли;
		ОбработкаФормирования.СформироватьФайлы(МассивСтруктурФормированияФайлов[Инд]);
				
		Для Каждого СтрокаОбмена Из МассивСтруктурФормированияФайлов[Инд].ОбъектыОбмена Цикл
			//Т.к. в каждом сообщении должен быть уникальный UUID, то будем его присваивать после
			//формирования файлов, это будет значительно быстрее.
			ТекUUID = БиблиотекаФункцийОбмена.ПолучитьUUIDТекущегоВремени();
				
			СтрФайлов = ФайлыРезультатаФормирования.Добавить();
			СтрФайлов.НомерПакета = НомерТек;
			СтрФайлов.СодержимоеФайла = СтрЗаменить(СтрокаОбмена.РезультатФормирования,ФразаИдентификатор,ТекUUID);
			СтрФайлов.ИдентификаторСообщения = ТекUUID;
			СтрФайлов.ФорматОбмена = СтрокаОбмена.Формат;
			
			СтрФайлов.ТекущийУчастник = МассивСтруктурФормированияФайлов[Инд].Организация;
			СтрФайлов.ВидСообщения = ВидСообщения;
			
			НовСтр = РезультатФормирования.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,СтрокаОбмена);
			НовСтр.ТекущийУчастник = МассивСтруктурФормированияФайлов[Инд].Организация;
			НовСтр.НомерПакета = НомерТек;
			ЕстьОшибки = ЕстьОшибки ИЛИ ЗначениеЗаполнено(НовСтр.ОписаниеОшибки);
			
			НомерТек = НомерТек + 1;
			
		КонецЦикла;
				
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьОтветыОбменаСоСМЭВ(ЕстьОшибки)
	
	ДополнительныйТекстСообщенияОЗагрузкеДанных = "";
	ДополнительныеДанные = Новый Структура;
	ДополнительныеДанные.Вставить("ПолученоПлатежейВсего",0);
	ДополнительныеДанные.Вставить("ПолученоПлатежейНовых",0);

	ГосУслуги.ОбработатьОтветыИзСервисаСМЭВ(ФайлыРезультатаФормирования,РезультатФормирования,ТаблицаПодтвержденияПолученияСообщений,ТаблицаДляЗапросаНовыхДанных,ДополнительныеДанные);
	КоличествоЗапросовНовыхДанных = ТаблицаДляЗапросаНовыхДанных.Количество();
	
	Элементы.ЗапроситьСледующуюПорциюДанных.Заголовок = "Запросить следующую порцию данных ("+КоличествоЗапросовНовыхДанных+")";
	
	Если ДополнительныеДанные.ПолученоПлатежейВсего>0 Тогда
		ДополнительныйТекстСообщенияОЗагрузкеДанных = НСтр("ru='Получено платежей из сервиса: %1, в том числе новых (измененных): %2.'");
		ДополнительныйТекстСообщенияОЗагрузкеДанных = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ДополнительныйТекстСообщенияОЗагрузкеДанных,
			ДополнительныеДанные.ПолученоПлатежейВсего, ДополнительныеДанные.ПолученоПлатежейНовых);
	КонецЕсли;
	
	//проверим, есть ли ошибки в таблице
	Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
		Если СтрТЧ.ТаблицаОшибок.Количество() > 0  Тогда
			ЕстьОшибки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЗаписатьРезультатОбменаВРегистрыОбменаСМЭВ();
	
	МассивКУдалению = Новый Массив;
	Для Каждого СтрТЧ Из ТаблицаПодтвержденияПолученияСообщений Цикл
		Если СтрТЧ.Подтверждено Тогда
			МассивКУдалению.Добавить(СтрТЧ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЭлМас Из МассивКУдалению Цикл
		ТаблицаПодтвержденияПолученияСообщений.Удалить(ЭлМас);				
	КонецЦикла;
	
	ИмяТЧ = "";
	Если ТекущееДействие = "ОтправитьПакеты" Тогда

		СписокОтмеченныеПакеты.Очистить();
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПакетов,"ОтмеченныеПакеты",СписокОтмеченныеПакеты,Истина);
		
	ИначеЕсли ТекущееДействие = "ЗапросСтатусаНачислений"
		ИЛИ ТекущееДействие = "ЗапросНаКвитированиеСПлатежами"
		ИЛИ ТекущееДействие = "ЗапросНаКвитированиеБезПлатежа"
		ИЛИ ТекущееДействие = "ЗапросПлатежейПоНачислению"
		ИЛИ ТекущееДействие = "ЗапросНаОтменуКвитированияБезПлатежа" Тогда
		
		СписокОтмеченныеКвитанции.Очистить();
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокКвитанций,"ОтмеченныеКвитанции",СписокОтмеченныеКвитанции,Истина);
		
	ИначеЕсли ТекущееДействие = "ЗапросНаОтменуКвитированияСПлатежами" Тогда
		ИмяТЧ = "ТаблицаПлатежиДляОтменыКвитирования";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяТЧ) Тогда
		СтрокиДляСнятияОтметок = ЭтотОбъект[ИмяТЧ].НайтиСтроки(Новый Структура("Использовать",Истина));
		Для Каждого СтрТЧ Из СтрокиДляСнятияОтметок Цикл
			СтрТЧ.Использовать = Ложь;
		КонецЦикла;	
	КонецЕсли;
	
	Если ТекущееДействие = "ЗапросНаКвитированиеСПлатежами" Тогда
		СписокОтмеченныеПлатежиДляКвитирования.Очистить();
		Элементы.СписокПлатежиДляКвитирования.Обновить();
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПлатежиДляКвитирования,"ОтмеченныеПлатежи",СписокОтмеченныеПлатежиДляКвитирования,Истина);		

	КонецЕсли;
	
	Если ТекущееДействие = "ЗапроситьДанныеИзОчередиОтветов"
		ИЛИ ТекущееДействие = "ЗапроситьДанныеИзОчередиСтатусов"
		ИЛИ ТекущееДействие  = "ЗапроситьРезультатОбработки"
		ИЛИ ТекущееДействие = "ОбработатьЗапросы" Тогда
		Элементы.ЗапросыВыполняемые.Обновить();
		Элементы.ЗапросыОбщие.Обновить();
		Элементы.ЗапросыДетальные.Обновить();
	КонецЕсли;
	
	Элементы.СписокВозвратов.Обновить();
	Элементы.СписокПакетов.Обновить();
	Элементы.СписокКвитанций.Обновить();
	
	Элементы.СоставПакетаВозвратов.Обновить();
	Элементы.СоставПакетаНачислений.Обновить();
	
	Элементы.ИсторияОбмена.Обновить();
	
	Элементы.СписокКаталогов.Обновить();
	Элементы.ДокументыПодписок.Обновить();
	Элементы.ДействующиеПодписки.Обновить();
	ЗаполнитьКоличествоДействующихПодписок();
	
	Элементы.СписокНачисленийОтПосредника.Обновить();
	Элементы.СписокКонтрагентовИШаблонов.Обновить();
	
	ЗадатьЗаголовокКнопкеЗапросаПоID();
КонецПроцедуры


&НаКлиенте
Процедура ОбработатьОшибки(ЕстьОшибки,ТекстОшибки,ДопПараметры)
	
	ТекстПользовательскогоСообщения = "";
	
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Ложь Тогда
		
		ПараметрыФормы = ПолучитьСтруктуруПараметровОшибок();
		//ошибка этапа формирования файлов	
		
		Если ТекущееДействие = "СформироватьПакетыНачислений" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов по документам ""Квитанция на оплату"" произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы по документам ""Квитанция на оплату"" сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "СформироватьПакетыВозвратов" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов по документам ""Уведомление о возврате в ГИС ГМП"" произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы по документам ""Уведомление о возврате в ГИС ГМП"" сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ЗапросПлатежейПоНачислению" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов запроса платежей по начислениям произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы запроса платежей по начислениям сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ЗапросПлатежейЗаПериод" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов запроса платежей за период произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы запроса платежей за период сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ОтправитьПроизвольныйЗапрос" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов запроса произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы запроса за период сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ОтправитьПакеты" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов по пакетам документов произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы по пакетам документов сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ОтправитьКаталог" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов по каталогу услуг произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы по каталогу услуг сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ЗапроситьДоступныеПодписки" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов запроса доступных подписок произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы запроса доступных подписок сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ОтправитьПодписку"
			ИЛИ ТекущееДействие = "ПодписатьсяНаНачисленияДляПосредникаПоУИН"
			ИЛИ ТекущееДействие = "ОтписатьсяОтНачисленийДляПосредникаПоУИН"
			ИЛИ ТекущееДействие = "ПодписатьсяНаКвитанцииДляПосредникаПоУИН"
			ИЛИ ТекущееДействие = "ОтписатьсяОтКвитанцийДляПосредникаПоУИН" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов для добавления/изменения подписки произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы по подписке на уведомление сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ЗапроситьНСИ" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов запроса НСИ произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы запроса НСИ сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ОтправитьНачисленияОтПосредника" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов по начислениям от посредника произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы по начислениям от посредника сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ОтправитьПакетПовторно" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов по пакету документов произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы по пакету документов сформированы успешно'");
			КонецЕсли;	
		ИначеЕсли ТекущееДействие = "ЗапросСтатусаНачислений" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов запроса статуса квитирования начислений произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы запроса статуса квитирования начислений сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ЗапросНаКвитированиеСПлатежами"
			ИЛИ ТекущееДействие = "ЗапросНаКвитированиеБезПлатежа"
			ИЛИ ТекущееДействие = "ЗапросНаКвитированиеБезПлатежаСУказаниемСуммы" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов запроса квитирования начислений произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы запроса квитирования начислений сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ЗапросНаОтменуКвитированияСПлатежами"
			ИЛИ ТекущееДействие = "ЗапросНаОтменуКвитированияБезПлатежа" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов запроса на отмену квитирования начисления произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы запроса на отмену квитирования начисления сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ЗапроситьДанныеИзОчередиОтветов"
			ИЛИ ТекущееДействие = "ЗапроситьРезультатОбработки" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов запроса данных из очереди СМЭВ произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы запроса данных из очереди СМЭВ сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ЗапроситьНовуюПорциюДанных" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов запроса новой порции данных произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы запроса данных новой порции данных сформированы успешно'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ПодтвердитьПолучениеСообщения" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов подтверждения получения произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы подтверждения получения сообщения сформированы успешно'");
			КонецЕсли;
		Иначе
			//Если вдруг действие, для которого не прописан отдельный заголовок
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При формирования файлов произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы сформированы успешно'");
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыФормы.Вставить("Заголовок",ТекстПользовательскогоСообщения);
		ПараметрыФормы.Вставить("ЕстьОшибки",ЕстьОшибки);
		
		ОписаниеОп = Новый ОписаниеОповещения("ПослеЗакрытияФормыОшибок",ЭтотОбъект);
		ОткрытьФорму("Обработка.ОбменГИСГМП2.Форма.ФормаОтображенияОшибок",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Возврат;
			
	ИначеЕсли ФайлыСформированы = Истина
		И ФайлыПодписаны = Истина
		И ФайлыОтправлены = Ложь Тогда
		//ошибка этапа подписи файлов
		
		ПараметрыФормы = ПолучитьСтруктуруПараметровОшибок();
		ПараметрыФормы.Вставить("ЕстьОшибки",ЕстьОшибки);
		
		Если ЕстьОшибки Тогда		
			ТекстПользовательскогоСообщения = Нстр("ru='При подписи файлов произошли ошибки'");
		Иначе
			ТекстПользовательскогоСообщения = Нстр("ru='Файлы успешно подписаны ЭП'");
		КонецЕсли;		
		
		ПараметрыФормы.Вставить("Заголовок",ТекстПользовательскогоСообщения);
		
		ОписаниеОп = Новый ОписаниеОповещения("ПослеЗакрытияФормыОшибок",ЭтотОбъект);
		ОткрытьФорму("Обработка.ОбменГИСГМП2.Форма.ФормаОтображенияОшибок",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
		
		Возврат;		
		
	ИначеЕсли ФайлыСформированы = Истина
		И ФайлыПодписаны = Истина
		И ФайлыОтправлены = Истина Тогда
		//ошибка этапа отправки файлов
		
		ПараметрыФормы = ПолучитьСтруктуруПараметровОшибок();
		ПараметрыФормы.Вставить("ЕстьОшибки",ЕстьОшибки);
		
		Если ТекущееДействие = "ПодтвердитьПолучениеСообщения" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При отправке подтверждения получения сообщения произошли ошибки.'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Подтверждение получения сообщения отправлено успешно.'");
			КонецЕсли;
		ИначеЕсли ТекущееДействие = "ЗапроситьДанныеИзОчередиОтветов"
			ИЛИ ТекущееДействие = "ЗапроситьДанныеИзОчередиСтатусов"
			ИЛИ ТекущееДействие = "ЗапроситьРезультатОбработки" Тогда
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При отправке файлов произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Данные из очереди получены успешно.'");
			КонецЕсли;
		Иначе
			Если ЕстьОшибки Тогда		
				ТекстПользовательскогоСообщения = Нстр("ru='При отправке файлов произошли ошибки'");
			Иначе
				ТекстПользовательскогоСообщения = Нстр("ru='Файлы отправлены успешно и приняты в очередь обработки СМЭВ'");
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыФормы.Вставить("Заголовок",ТекстПользовательскогоСообщения);
		
		ОписаниеОп = Новый ОписаниеОповещения("ПослеЗакрытияФормыОшибок",ЭтотОбъект);
		ОткрытьФорму("Обработка.ОбменГИСГМП2.Форма.ФормаОтображенияОшибок",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруПараметровОшибок()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТекущееДействие",ТекущееДействие);
	СтруктураПараметров.Вставить("ТребуетсяПодтверждение",Ложь);
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Ложь Тогда
		
		СтруктураПараметров.Вставить("АдресОбъектыОбмена", ПоместитьВоВременноеХранилище(РеквизитФормыВЗначение("РезультатФормирования"),УникальныйИдентификатор));
		СтруктураПараметров.Вставить("ЭтапОбмена","Формирование");
		
	ИначеЕсли ФайлыСформированы = Истина
		И ФайлыПодписаны = Истина
		И ФайлыОтправлены = Ложь Тогда
		
		СтруктураПараметров.Вставить("ЭтапОбмена","Подпись");
		СтруктураПараметров.Вставить("АдресОбъектыОбмена", ПоместитьВоВременноеХранилище(РеквизитФормыВЗначение("РезультатФормирования"),УникальныйИдентификатор));
		СтруктураПараметров.Вставить("АдресСообщенияОбмена", ПоместитьВоВременноеХранилище(РеквизитФормыВЗначение("ФайлыРезультатаФормирования"),УникальныйИдентификатор));
		
		
	ИначеЕсли ФайлыСформированы = Истина
		И ФайлыПодписаны = Истина
		И ФайлыОтправлены = Истина Тогда
		
		СтруктураПараметров.Вставить("ЭтапОбмена","Отправка");		
	    СтруктураПараметров.Вставить("АдресОбъектыОбмена", ПоместитьВоВременноеХранилище(РеквизитФормыВЗначение("РезультатФормирования"),УникальныйИдентификатор));		
		СтруктураПараметров.Вставить("АдресСообщенияОбмена", ПоместитьВоВременноеХранилище(РеквизитФормыВЗначение("ФайлыРезультатаФормирования"),УникальныйИдентификатор));
		
		ТребуетсяПодтверждение = Ложь;
		Если ТребуетсяПодтверждениеПолученныхСообщений Тогда
			Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
				Если СтрТЧ.ЕстьДанные 
					И СтрТЧ.Подтверждено = Ложь Тогда
					//требуется подтверждение только если мы еще не подтвердили
					ТребуетсяПодтверждение = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		СтруктураПараметров.Вставить("ТребуетсяПодтверждение",ТребуетсяПодтверждение);
	КонецЕсли;
		
	Возврат СтруктураПараметров;	
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияФормыОшибок(Результат,ДопПараметры)Экспорт
	
	ПрерватьОбмен = Ложь;
	Если Результат = Неопределено Тогда
		ПрерватьОбмен = Истина;
	КонецЕсли;
	
	Если Результат = "Прервать" Тогда
		ПрерватьОбмен = Истина;
	КонецЕсли;
	
	Если ПрерватьОбмен Тогда
		РезультатФормирования.Очистить();
		ФайлыРезультатаФормирования.Очистить();
		ТаблицаПодтвержденияПолученияСообщений.Очистить();
		//ТаблицаДляЗапросаНовыхДанных.Очистить();
		Возврат;
	КонецЕсли;
	
	Если ФайлыСформированы = Истина
		И ФайлыПодписаны = Ложь Тогда
		
		МассивСтрок = Новый Массив;
		Для Каждого СтрТЧ Из РезультатФормирования Цикл
			Если ЗначениеЗаполнено(СтрТЧ.ОписаниеОшибки) Тогда
				МассивСтрок.Добавить(СтрТЧ);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ЭлМас Из МассивСтрок Цикл
			РезультатФормирования.Удалить(ЭлМас);
		КонецЦикла;
		
		Если РезультатФормирования.Количество() = 0 Тогда
			Возврат;//нет файлов для продолжения
		КонецЕсли;
		
	Иначе
		
		Если ТекущееДействие = "СформироватьПакетыНачислений"
			ИЛИ ТекущееДействие = "СформироватьПакетыВозвратов" Тогда
			
			Если ФайлыСформированы = Истина
				И ФайлыПодписаны = Истина
				И ПакетыСозданы = Ложь Тогда
				
				// нужно ли что-то делать, если при подписи обнаружилась проблема?
				МассивСтрок = Новый Массив;
				Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
					Если СтрТЧ.Подписано = Ложь Тогда
						МассивСтрок.Добавить(СтрТЧ);
					КонецЕсли;
				КонецЦикла;
				
				Для Каждого ЭлМас Из МассивСтрок Цикл
					ФайлыРезультатаФормирования.Удалить(ЭлМас);
				КонецЦикла;
				
				Если ФайлыРезультатаФормирования.Количество() = 0 Тогда
					Возврат;//нет файлов для продолжения
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если ФайлыСформированы = Истина
				И ФайлыПодписаны = Истина
				И ФайлыОтправлены = Ложь Тогда
				
				// нужно ли что-то делать, если при подписи обнаружилась проблема?
				МассивСтрок = Новый Массив;
				Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
					Если СтрТЧ.Подписано = Ложь Тогда
						МассивСтрок.Добавить(СтрТЧ);
					КонецЕсли;
				КонецЦикла;
				
				Для Каждого ЭлМас Из МассивСтрок Цикл
					ФайлыРезультатаФормирования.Удалить(ЭлМас);
				КонецЦикла;
				
				Если ФайлыРезультатаФормирования.Количество() = 0 Тогда
					Возврат;//нет файлов для продолжения
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
		
	КонецЕсли;
	
	//Вернемся в главную процедуру
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеОбменаНаКлиенте()
	
	//если пользователь стал сам что-то делать в обработке, то прервем	
	ОтключитьОбработчикОжидания("ЗапросДанныхИзОчередиПослеОтправкиПоНастройке");
	
	Если ПараметрыНастройкиОбмена = Неопределено Тогда
		ТекстСообщения = Нстр("ru='Для участника ""%1"" в настройках участника не задана настройка обмена с сервисом.
		|Обмен с сервисом не возможен.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,УчастникОтправитель);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если ТекущееДействие = "СформироватьПакетыНачислений"
		ИЛИ ТекущееДействие = "СформироватьПакетыВозвратов" Тогда
		
		ВыполнитьДействияФормированияПакетовНаКлиенте();
		
	Иначе
		
		ВыполнитьДействияОтправкиСообщенийНаКлиенте();
		
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти

#Область ОтправитьПакеты

&НаКлиенте
Асинх Процедура ОтправитьПакеты(Команда)
	
	ОчиститьСообщения();
	
	ОбновитьСписокОтмеченныхПакетовПоДаннымСпискаПакетов();
	Если СписокОтмеченныеПакеты.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отмечены пакеты для отправки.'"));
		Возврат;
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматПВ","ПакетУведомленийОВозвратеГИСГМП","SendRequestRequest_ПВ");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматПН","ПакетНачисленийГИСГМП","SendRequestRequest_ПН");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	Если ЭтоБазаГАН Тогда
		ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматПНП","ПакетНачисленийГИСГМПОтПодведомственного","SendRequestRequest_ПНП");
		МассивСтруктурФорматов.Добавить(ТекСтруктура);
		ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматПВП","ПакетУведомленийОВозвратеГИСГМПОтПодведомственного","SendRequestRequest_ПВП");
		МассивСтруктурФорматов.Добавить(ТекСтруктура);
	КонецЕсли;	
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееДействие = "ОтправитьПакеты";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
		
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();			
	 
КонецПроцедуры

