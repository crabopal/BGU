#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокКвитанций

&НаКлиенте
Процедура СписокКвитанцийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если Поле.Имя = "СписокКвитанцийИспользовать" Тогда 
		СтандартнаяОбработка = Ложь;
		
		//1 - не отмечено, 2 - отмечено
		ЗначениеОтметки = Ложь;
		Если ТекДанные.Использовать = 1 Тогда
			
			ЗначениеОтметки = Истина;
			
			Для Каждого ТекДок Из Элемент.ВыделенныеСтроки Цикл
				СтрокаСписка = СписокОтмеченныеКвитанции.НайтиПоЗначению(ТекДок);
				Если СтрокаСписка=Неопределено Тогда
					СписокОтмеченныеКвитанции.Добавить(ТекДок);
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			ЗначениеОтметки = Ложь;
			
			Для Каждого ТекДок Из Элемент.ВыделенныеСтроки Цикл
				СтрокаСписка = СписокОтмеченныеКвитанции.НайтиПоЗначению(ТекДок);
				Если СтрокаСписка<>Неопределено Тогда
					СписокОтмеченныеКвитанции.Удалить(СтрокаСписка);
				КонецЕсли;
			КонецЦикла;
						
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокКвитанций,"ОтмеченныеКвитанции",СписокОтмеченныеКвитанции,Истина);
		
		Если РежимРаботыКвитанции = 3 Тогда
			
			МассивПлатежей = ПолучитьПлатежиПоНачислениям(Элемент.ВыделенныеСтроки);
			
			Если МассивПлатежей.Количество() Тогда
				Для Каждого ТекДок Из МассивПлатежей Цикл
					СтрокаСписка = СписокОтмеченныеПлатежиДляКвитирования.НайтиПоЗначению(ТекДок);
					Если ЗначениеОтметки Тогда
						Если СтрокаСписка=Неопределено Тогда
							СписокОтмеченныеПлатежиДляКвитирования.Добавить(ТекДок);
						КонецЕсли;	
					Иначе
						Если СтрокаСписка<>Неопределено Тогда
							СписокОтмеченныеПлатежиДляКвитирования.Удалить(СтрокаСписка);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПлатежиДляКвитирования,"ОтмеченныеПлатежи",СписокОтмеченныеПлатежиДляКвитирования,Истина);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		ПоказатьЗначение(,ТекДанные.Квитанция);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокКвитанцийПриАктивизацииСтроки(Элемент)
	ТекДанные = Элементы.СписокКвитанций.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ТекущаяКвитанция = ТекДанные.Квитанция;
	Иначе
		ТекущаяКвитанция = Неопределено;
	КонецЕсли;
	ЗадержкаОбработчика = 0.5;
	Если РежимРаботыКвитанции = 3 Тогда//Квитирование
	    ЗадержкаОбработчика = 0.3;
	КонецЕсли;
	ПодключитьОбработчикОжидания("ПриАктивизацииКвитанции",ЗадержкаОбработчика,Истина);
	ПодключитьОбработчикОжидания("ПоказатьИсториюОбмена",0.5,Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизацииКвитанции() Экспорт
	
	Если Элементы.ТаблицаПлатежиДляОтменыКвитирования.Видимость Тогда
		ОбновитьСписокПлатежей();
	ИначеЕсли РежимРаботыКвитанции = 3 Тогда //Квитирование		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПлатежиДляКвитирования,"Начисление",ТекущаяКвитанция,Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПлатежиПоНачислениям(Знач МассивНачислений)	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоответствиеНачисленийИПлатежей.Платеж КАК Платеж
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Начисление В(&МассивНачислений)
		|	И СоответствиеНачисленийИПлатежей.БанковскийИдентификаторПлатежаЗаполнен";
	
	Запрос.УстановитьПараметр("МассивНачислений", МассивНачислений);
	
	МассивПлатежей = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Платеж");
	Возврат МассивПлатежей;
	
КонецФункции


&НаСервере
Процедура ПриИзмененииОтметкиСпискаКвитанций(Знач МассивНачислений,ЗначениеОтметки)
	
	Если ЗначениеОтметки Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СоответствиеНачисленийИПлатежей.Платеж КАК Платеж
			|ИЗ
			|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
			|ГДЕ
			|	СоответствиеНачисленийИПлатежей.Начисление В(&МассивНачислений)
			|	И СоответствиеНачисленийИПлатежей.БанковскийИдентификаторПлатежаЗаполнен
			|	И НЕ СоответствиеНачисленийИПлатежей.Платеж В(&ОтмеченныеПлатежи)";
		
		Запрос.УстановитьПараметр("МассивНачислений", МассивНачислений);
		Запрос.УстановитьПараметр("ОтмеченныеПлатежи", СписокОтмеченныеПлатежиДляКвитирования.ВыгрузитьЗначения());
	
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СписокОтмеченныеПлатежиДляКвитирования.Добавить(ВыборкаДетальныеЗаписи.Платеж);						
		КонецЦикла;
		
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СоответствиеНачисленийИПлатежей.Платеж КАК Платеж
			|ИЗ
			|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
			|ГДЕ
			|	СоответствиеНачисленийИПлатежей.Начисление В(&МассивНачислений)
			|	И СоответствиеНачисленийИПлатежей.БанковскийИдентификаторПлатежаЗаполнен
			|	И СоответствиеНачисленийИПлатежей.Платеж В(&ОтмеченныеПлатежи)";
		
		Запрос.УстановитьПараметр("МассивНачислений", МассивНачислений);
		Запрос.УстановитьПараметр("ОтмеченныеПлатежи", СписокОтмеченныеПлатежиДляКвитирования.ВыгрузитьЗначения());
	
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СтрокаСписка = СписокОтмеченныеПлатежиДляКвитирования.НайтиПоЗначению(ВыборкаДетальныеЗаписи.Платеж);
			Если СтрокаСписка <> Неопределено Тогда
				СписокОтмеченныеПлатежиДляКвитирования.Удалить(СтрокаСписка);	
			КонецЕсли;
		КонецЦикла;	
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПлатежиДляКвитирования,"ОтмеченныеПлатежи",СписокОтмеченныеПлатежиДляКвитирования,Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаПлатежиДляОтменыКвитирования

&НаКлиенте
Процедура ТаблицаПлатежиДляОтменыКвитированияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ТаблицаПлатежиДляОтменыКвитирования.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПоказатьЗначение(,ТекДанные.ПлатежСсылка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПлатежиДляОтменыКвитированияИспользоватьПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТаблицаПлатежиДляОтменыКвитирования.ТекущиеДанные;
	
	Для Каждого ТекИД Из Элементы.ТаблицаПлатежиДляОтменыКвитирования.ВыделенныеСтроки Цикл
		ТекСтр = ТаблицаПлатежиДляОтменыКвитирования.НайтиПоИдентификатору(ТекИД);
		ТекСтр.Использовать = ТекДанные.Использовать;
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокПакетов

&НаКлиенте
Процедура СписокПакетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элемент.ТекущиеДанные;
	Если Поле.Имя = "СписокПакетовИспользовать" Тогда 
		СтандартнаяОбработка = Ложь;
		
		//1 - не отмечено, 2 - отмечено, 0 - не отмечать
		Если ТекДанные.Использовать = 0 Тогда 
			Возврат;
		КонецЕсли;		
		
		Если ТекДанные.Использовать = 1 Тогда
			
			Для Каждого ТекДок Из Элемент.ВыделенныеСтроки Цикл
				ДанныеТекСтроки = Элементы.СписокПакетов.ДанныеСтроки(ТекДок);
				Если ДанныеТекСтроки.Использовать = 1 Тогда
					СписокОтмеченныеПакеты.Добавить(ТекДок);
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			Для Каждого ТекДок Из Элемент.ВыделенныеСтроки Цикл
				ДанныеТекСтроки = Элементы.СписокПакетов.ДанныеСтроки(ТекДок);
				Если ДанныеТекСтроки.Использовать = 2 Тогда
					СтрокаСписка = СписокОтмеченныеПакеты.НайтиПоЗначению(ТекДок);
					Если СтрокаСписка<>Неопределено Тогда
						СписокОтмеченныеПакеты.Удалить(СтрокаСписка);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
						
		КонецЕсли;
				
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПакетов,"ОтмеченныеПакеты",СписокОтмеченныеПакеты,Истина);
				
	Иначе
		
		ПоказатьЗначение(,ТекДанные.ПакетСсылка);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокПакетовПриАктивизацииСтроки(Элемент)
	ТекДанные = Элементы.СписокПакетов.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ТекущийПакет = ТекДанные.ПакетСсылка;
	Иначе
		ТекущийПакет = Неопределено;
	КонецЕсли;
	ПодключитьОбработчикОжидания("ПоказатьДанныеПакетаНачислений",0.1,Истина);
	ПодключитьОбработчикОжидания("ПоказатьИсториюОбмена",0.5,Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДанныеПакетаНачислений() Экспорт
	
	ТекДанные = Элементы.СписокПакетов.ТекущиеДанные;
	ТекВидПакета = "Начисления";
	Если ТекДанные = Неопределено Тогда
		ТекПакет = Неопределено;
	Иначе
		Если ТекДанные.ВидПакета <> ТекВидПакета Тогда
			ТекВидПакета = ТекДанные.ВидПакета;
		КонецЕсли;
		ТекПакет = ТекДанные.ПакетСсылка;
	КонецЕсли;
	
	Если ТекВидПакета = "Начисления" Тогда
		Элементы.ГруппаСоставПакетов.ТекущаяСтраница = Элементы.СоставНачисления;
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СоставПакетаНачислений,"Пакет",ТекПакет,Истина);
	Иначе
		Элементы.ГруппаСоставПакетов.ТекущаяСтраница = Элементы.СоставВозвраты;
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СоставПакетаВозвратов,"Пакет",ТекПакет,Истина);
	КонецЕсли;
	
КонецПроцедуры

