&НаКлиенте
Асинх Процедура СохранитьФайлыОчередиЗапросов(Команда)
	
	ТекДанные = Элементы.ЗапросыВыполняемые.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивИдентификаторов = Новый Массив;
		
	МассивВыделенных = Новый Массив;
	Для Каждого ТекВыд Из Элементы.ЗапросыВыполняемые.ВыделенныеСтроки Цикл
		МассивВыделенных.Добавить(ТекВыд);
	КонецЦикла;
	
	Для Каждого ТекСтр Из МассивВыделенных Цикл	
		ТекДанные = Элементы.ЗапросыВыполняемые.ДанныеСтроки(ТекСтр);
		Если ЗначениеЗаполнено(ТекДанные.ИдентификаторСообщения) Тогда
			МассивИдентификаторов.Добавить(ТекДанные.ИдентификаторСообщения);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивВыделенных.Количество()> 0 
		И МассивИдентификаторов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='По выбранным строкам обмен еще не выполнялся.'"));
		Возврат;
	КонецЕсли;
	
	ПоместитьВАрхив = Ложь;
	МассивОписанийФайлов = СформироватьВыгрузку(МассивИдентификаторов, ПоместитьВАрхив);
	
	Если МассивОписанийФайлов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ПараметрыДиалогаПолученияФайлов;
	Диалог.ВыборКаталога = Истина;
	
	Ждать ПолучитьФайлыССервераАсинх(МассивОписанийФайлов,Диалог);	
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПовторитьЗапрос(Команда)
	ТекДанные = Элементы.ЗапросыОбщие.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru='Скопировать данный запрос к сервису?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса,РежимДиалогаВопрос.ОКОтмена);
	
	Если Ответ <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормата = "SendRequestRequest_NewQuery";
	ИмяРеквизита = "МассивФорматовОчереди";
	
	МассивСтруктурФорматов = Новый Массив;
		
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата",ИмяРеквизита,"ЗапросУНИФО",ИмяФормата);
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
		
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	СкопироватьОбщийЗапрос(ТекДанные.УИДНастройкиОбщегоЗапроса);
КонецПроцедуры

&НаСервере
Процедура СкопироватьОбщийЗапрос(УИДНастройкиОбщегоЗапроса)
	ОшибкаСозданияЗапроса = Ложь;	
	ТекстОшибки = "";
	ГосУслуги.СкопироватьЗапросИзРегистровЗапросаКГИСГМП(УИДНастройкиОбщегоЗапроса, МассивФорматовОчереди, ОшибкаСозданияЗапроса, ТекстОшибки);	
	
	Если ОшибкаСозданияЗапроса Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки); 
		Возврат;
	Иначе
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Запрос добавлен в очередь запросов к сервису'"));	
	КонецЕсли;
	
	Элементы.ЗапросыОбщие.Обновить();	
КонецПроцедуры

