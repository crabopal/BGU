&НаКлиенте
Процедура СписокВозвратовПриАктивизацииСтроки(Элемент)
	ТекДанные = Элементы.СписокВозвратов.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ТекущийВозврат = ТекДанные.ДокСсылка;
	Иначе
		ТекущийВозврат = Неопределено;
	КонецЕсли;
	ПодключитьОбработчикОжидания("ПоказатьИсториюОбмена",0.5,Истина);
КонецПроцедуры

&НаКлиенте
Процедура СписокВозвратовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекДанные = Элемент.ТекущиеДанные;
	Если Поле.Имя = "СписокВозвратовИспользовать" Тогда 
		СтандартнаяОбработка = Ложь;
		
		//1 - не отмечено, 2 - отмечено
		
		Если ТекДанные.Использовать = 1 Тогда
			
			Для Каждого ТекДок Из Элемент.ВыделенныеСтроки Цикл
				ДанныеТекСтроки = Элементы.СписокВозвратов.ДанныеСтроки(ТекДок);
				Если ДанныеТекСтроки.Использовать = 1 Тогда
					СписокОтмеченныеВозвраты.Добавить(ТекДок);
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			Для Каждого ТекДок Из Элемент.ВыделенныеСтроки Цикл
				ДанныеТекСтроки = Элементы.СписокВозвратов.ДанныеСтроки(ТекДок);
				Если ДанныеТекСтроки.Использовать = 2 Тогда
					СтрокаСписка = СписокОтмеченныеВозвраты.НайтиПоЗначению(ТекДок);
					Если СтрокаСписка<>Неопределено Тогда
						СписокОтмеченныеВозвраты.Удалить(СтрокаСписка);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
						
		КонецЕсли;
		
		//Если ТекДанные.Использовать = 1 Тогда
		//	СписокОтмеченныеВозвраты.Добавить(ТекДанные.ДокСсылка);	
		//Иначе
		//	СтрокаСписка = СписокОтмеченныеВозвраты.НайтиПоЗначению(ТекДанные.ДокСсылка);
		//	Если СтрокаСписка<>Неопределено Тогда
		//		СписокОтмеченныеВозвраты.Удалить(СтрокаСписка);
		//	КонецЕсли;
		//	
		//КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"ОтмеченныеВозвраты",СписокОтмеченныеВозвраты,Истина);
				
	Иначе
		
		ПоказатьЗначение(,ТекДанные.ДокСсылка);
		
	КонецЕсли
	
КонецПроцедуры

