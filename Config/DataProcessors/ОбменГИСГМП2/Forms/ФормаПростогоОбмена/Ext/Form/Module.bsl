Процедура СформироватьФайлыДляФормированияПодписки(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
		
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
			
	Организация = Объект.Участник;
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
						
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Объект.Участник);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
	
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");

	НовСтр = ТекОбъектыОбмена.Добавить();
	НовСтр.Объект = ТекущийДокументПодписки;
	НовСтр.Формат = ФорматЭкспорта;
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
	
	МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортДанныхВСМЭВ,ЕстьОшибки);			
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));

КонецПроцедуры

&НаКлиенте
Процедура ДокументыПодписокПриАктивизацииСтроки(Элемент)
		
	ТекДанные = Элементы.ДокументыПодписок.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ТекущийДокументПодписки = Неопределено;
	Иначе
		ТекущийДокументПодписки = ТекДанные.Ссылка;
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ПоказатьИсториюОбмена",0.5,Истина);
КонецПроцедуры

&НаКлиенте
Процедура ДокументыЗагруженныеПоПодписке(Команда)
	
	ПараметрыФормы = Новый Структура("ПоПодписке,Организация",Истина,Объект.Участник);
	ОткрытьФорму("РегистрСведений.ЗагруженныеДанныеСМЭВ3.Форма.ФормаОтображенияЗагруженныхДанных",ПараметрыФормы,ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПодписку(Команда)
	
	СтатусПодписки = 2;
	НовыйДокументПодписки(СтатусПодписки);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПодписку(Команда)
	
	СтатусПодписки = 3;
	НовыйДокументПодписки(СтатусПодписки);
	
КонецПроцедуры

&НаКлиенте
Процедура НовыйДокументПодписки(СтатусПодписки)
	
	ТекДанные = Элементы.ДействующиеПодписки.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ТекстСообщения = НСтр("ru='Не выделена строка из списка действующих подписок для %1 подписки'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,?(СтатусПодписки=2,"изменения","удаления"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	ПараметрыЗаполнения = Новый Структура("Организация,Подписка,ИдентификаторПодписки,СтатусПодписки",
		ТекДанные.Организация,ТекДанные.Подписка,ТекДанные.ИдентификаторПодписки,СтатусПодписки);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",ПараметрыЗаполнения);
	ОткрытьФорму("Документ.ПодпискаНаУведомлениеГИСГМП.Форма.ФормаДокумента",ПараметрыФормы,ЭтотОбъект,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Процедура УбратьКнопкуЗагрузкиПодписокВПодменю()
	
	Перем ВыборкаДетальныеЗаписи, Запрос, РезультатЗапроса;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(ПодпискиГИСГМП.Ссылка) КАК Количество
	|ИЗ
	|	Справочник.ПодпискиГИСГМП КАК ПодпискиГИСГМП";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.Количество > 0 Тогда
			Элементы.ЗапроситьДоступныеПодписки.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВДополнительномПодменю;	
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИсторияЗагрузкиУведомлений(Команда)
	ОткрытьФорму("Обработка.ОбменГИСГМП2.Форма.ФормаИсторияЗагрузкиУведомлений",Новый Структура("Участник",Объект.Участник));
КонецПроцедуры

&НаКлиенте
Асинх Процедура УведомленияПоПодписке_ВыполнитьОбменСЭмулятором(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(ТекущийДокументПодписки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбран документ подписки на уведомление для обмена с эмулятором вида сведений.'"));
		Возврат;
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","ПодпискаНаУведомлениеГИСГМП","SendRequestRequest_CS");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
			
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущееДействие = "УведомленияПоПодписке_ВыполнитьОбменСЭмулятором";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыУведомленияПоПодпискеСЭмулятором(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
		
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
						
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
	
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Объект.Участник);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
		
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
										
	МассивФорматовДляЭмулятора = ПолучитьМассивФорматовДляЭмулятораВС(НастройкиУчастника.ВидОбмена,"EMU_УведомленияПоПодписке");
		
	Для Каждого ТекФормат Из МассивФорматовДляЭмулятора Цикл
		СтрокаОбмена = ТекОбъектыОбмена.Добавить();
		СтрокаОбмена.Объект = ТекущийДокументПодписки;
		СтрокаОбмена.Формат = ТекФормат;
	КонецЦикла;
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
	
	МассивСтруктурФормированияФайлов = Новый Массив;
	МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);
		
	Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
		СтрТЧ.ОбменСЭмулятором = Истина;			
	КонецЦикла;	
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, МассивФорматовДляЭмулятора));

КонецПроцедуры

#КонецОбласти

#Область ПолучениеНСИ

&НаКлиенте
Асинх Процедура ЗапроситьНСИ(Команда)
	ОчиститьСообщения();
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","ЗапросУНИФО","SendRequestRequest_NSI");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееДействие = "ЗапроситьНСИ";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоЗапросуНСИ(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
		
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
			
	Организация = Объект.Участник;
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
						
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Объект.Участник);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
	
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	Если ОбменСЭмулятором Тогда
		
		МассивФорматовДляЭмулятора = ПолучитьМассивФорматовДляЭмулятораВС(НастройкиУчастника.ВидОбмена,"EMU_ЗапросНСИ");
	
		МассивТекстовДляЭмулятора = Новый Массив;
		Для Каждого ТекФорматЭмулятора Из МассивФорматовДляЭмулятора Цикл	
			МассивТекстовДляЭмулятора.Добавить(ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросНСИ",ЕстьОшибки,ТекФорматЭмулятора));
		КонецЦикла;
	
		//необходимо сформировать 2 сообщения с разными идентификаторами
		Для Инд = 1 По МассивТекстовДляЭмулятора.Количество() Цикл
			СтрокаОбмена = ТекОбъектыОбмена.Добавить();
			СтрокаОбмена.Объект = Документы.ЗапросУНИФО.ПустаяСсылка();
			СтрокаОбмена.Формат = ФорматЭкспорта;
		КонецЦикла;
		
		СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
		
		МассивСтруктурФормированияФайлов = Новый Массив;
		МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
		
		СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);
			
		Инд = 0;
		КолТЭ = МассивТекстовДляЭмулятора.Количество();
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			Если Инд < КолТЭ Тогда
				ТекстЗапросаДляЭмулятора = МассивТекстовДляЭмулятора[Инд];
			Иначе
				ТекстЗапросаДляЭмулятора = "";
			КонецЕсли;
			СтрТЧ.ОбменСЭмулятором = Истина;
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
			Инд = Инд + 1;
		КонецЦикла;
	
	Иначе
	
		НовСтр = ТекОбъектыОбмена.Добавить();
		НовСтр.Объект = Документы.ЗапросУНИФО.ПустаяСсылка();
		НовСтр.Формат = ФорматЭкспорта;
		
		СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
		
		МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
		
		ДополнительныеПараметрыФорматов = Новый Структура("Контрагент",КонтрагентДляНСИ);
		
		СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортДанныхВСМЭВ,ЕстьОшибки,ДополнительныеПараметрыФорматов);			
		
	КонецЕсли;
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));

КонецПроцедуры

#КонецОбласти

#Область ОтправитьНачисленияОтПосредника

&НаКлиенте
Процедура ПодпискаДляНачисленийПриИзменении(Элемент)
	ПриИзмененииВыбраннойПодписки();
КонецПроцедуры

