	Если ТекДанные <> Неопределено Тогда
		ПоказатьЗначение(,ТекДанные.ДокСсылка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИсторияОбменаЗапросовНачисленийВозвратовПриАктивизацииСтроки(Элемент)
	ТекДанные = Элементы.ИсторияОбменаЗапросовНачисленийВозвратов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Элементы.ПоказатьЗагруженныеДокументы.Доступность = Ложь;
	    Возврат;
	КонецЕсли;
	
	Если ТекДанные.ВозможныДанные = Истина
		И ТекДанные.ОбменСЭмулятором = Ложь Тогда
		Элементы.ПоказатьЗагруженныеДокументы.Доступность = Истина;
	Иначе
		Элементы.ПоказатьЗагруженныеДокументы.Доступность = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокНачисленийОтПосредника

&НаКлиенте
Процедура СписокНачисленийОтПосредникаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если Поле.Имя = "СписокНачисленийОтПосредникаИспользовать" Тогда 
		СтандартнаяОбработка = Ложь;
		
		//1 - не отмечено, 2 - отмечено, 0 - не отмечать
		Если ТекДанные.Использовать = 0 Тогда 
			Возврат;
		КонецЕсли;		
		
		Если ТекДанные.Использовать = 1 Тогда
			
			Для Каждого ТекДок Из Элемент.ВыделенныеСтроки Цикл
				ДанныеТекСтроки = Элементы.СписокНачисленийОтПосредника.ДанныеСтроки(ТекДок);
				Если ДанныеТекСтроки.Использовать = 1
					И ДанныеТекСтроки.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Подготовлен") Тогда
					СписокОтмеченныеНачисленияОтПосредника.Добавить(ТекДок);
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			
			Для Каждого ТекДок Из Элемент.ВыделенныеСтроки Цикл
				ДанныеТекСтроки = Элементы.СписокНачисленийОтПосредника.ДанныеСтроки(ТекДок);
				Если ДанныеТекСтроки.Использовать = 2 Тогда
					СтрокаСписка = СписокОтмеченныеНачисленияОтПосредника.НайтиПоЗначению(ТекДок);
					Если СтрокаСписка<>Неопределено Тогда
						СписокОтмеченныеНачисленияОтПосредника.Удалить(СтрокаСписка);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
						
		КонецЕсли;
				
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокНачисленийОтПосредника,"ОтмеченныеДокументы",СписокОтмеченныеНачисленияОтПосредника,Истина);
				
	Иначе
		
		ПоказатьЗначение(,ТекДанные.ДокСсылка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНачисленийОтПосредникаПриАктивизацииСтроки(Элемент)
	ТекДанные = Элементы.СписокНачисленийОтПосредника.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ТекущееНачислениеОтПосредника = ТекДанные.ДокСсылка;
	Иначе
		ТекущееНачислениеОтПосредника = Неопределено;
	КонецЕсли;
	ПодключитьОбработчикОжидания("ПоказатьИсториюОбмена",0.5,Истина);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокНачисленийОтПосредникаПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	// тут надо получать признак - подписан документ на подписку на начисление и квитанции
	// и сумму платежей
	МассивУИН = Новый Массив;
	Для Каждого КлючИЗначение Из Строки Цикл
		Если ЗначениеЗаполнено(КлючИЗначение.Значение.Данные.УИН) Тогда
			МассивУИН.Добавить(КлючИЗначение.Значение.Данные.УИН);
		КонецЕсли;
	КонецЦикла;
	
	мПодпискаДляНачислений = Неопределено;
	мПодпискаДляКвитанций = Неопределено;
	мОрганизация = Неопределено;
	
	Настройки.ДополнительныеСвойства.Свойство("ПодпискаДляНачислений",мПодпискаДляНачислений);
	Настройки.ДополнительныеСвойства.Свойство("ПодпискаДляКвитанций",мПодпискаДляКвитанций);
	Настройки.ДополнительныеСвойства.Свойство("Организация",мОрганизация);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыПодписокГИСГМПСрезПоследних.ЗначениеПараметра КАК УИН,
		|	ПараметрыПодписокГИСГМПСрезПоследних.ПараметрАктивен КАК ПараметрАктивен,
		|	МАКСИМУМ(ПараметрыПодписокГИСГМПСрезПоследних.Период) КАК Период
		|ИЗ
		|	РегистрСведений.ПараметрыПодписокГИСГМП.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И Подписка = &ПодпискаНаНачисления
		|				И ЗначениеПараметра В (&МассивУИН)) КАК ПараметрыПодписокГИСГМПСрезПоследних
		|ГДЕ
		|	ПараметрыПодписокГИСГМПСрезПоследних.ПараметрАктивен
		|
		|СГРУППИРОВАТЬ ПО
		|	ПараметрыПодписокГИСГМПСрезПоследних.ЗначениеПараметра,
		|	ПараметрыПодписокГИСГМПСрезПоследних.ПараметрАктивен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПараметрыПодписокГИСГМПСрезПоследних.ЗначениеПараметра КАК УИН,
		|	ПараметрыПодписокГИСГМПСрезПоследних.ПараметрАктивен КАК ПараметрАктивен,
		|	МАКСИМУМ(ПараметрыПодписокГИСГМПСрезПоследних.Период) КАК Период
		|ИЗ
		|	РегистрСведений.ПараметрыПодписокГИСГМП.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И Подписка = &ПодпискаНаКвитанции
		|				И ЗначениеПараметра В (&МассивУИН)) КАК ПараметрыПодписокГИСГМПСрезПоследних
		|ГДЕ
		|	ПараметрыПодписокГИСГМПСрезПоследних.ПараметрАктивен
		|
		|СГРУППИРОВАТЬ ПО
		|	ПараметрыПодписокГИСГМПСрезПоследних.ЗначениеПараметра,
		|	ПараметрыПодписокГИСГМПСрезПоследних.ПараметрАктивен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка,
		|	Док.Подписка КАК Подписка,
		|	ДанныеИсходящихСообщенийСМЭВ3.ДатаОбмена КАК ДатаОбмена
		|ПОМЕСТИТЬ ДокументыПодписокВРаботе
		|ИЗ
		|	(ВЫБРАТЬ
		|		ПодпискаНаУведомлениеГИСГМП.Ссылка КАК Ссылка,
		|		ПодпискаНаУведомлениеГИСГМП.Подписка КАК Подписка
		|	ИЗ
		|		Документ.ПодпискаНаУведомлениеГИСГМП КАК ПодпискаНаУведомлениеГИСГМП
		|	ГДЕ
		|		ПодпискаНаУведомлениеГИСГМП.Организация = &Организация
		|		И ПодпискаНаУведомлениеГИСГМП.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|		И ПодпискаНаУведомлениеГИСГМП.СтатусОбработки = &СтатусОбработки
		|		И ПодпискаНаУведомлениеГИСГМП.СтатусПодписки В(&СтатусыПодписки)
		|		И ПодпискаНаУведомлениеГИСГМП.Подписка В (&ПодпискаНаНачисления, &ПодпискаНаКвитанции)) КАК Док
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК ДанныеИсходящихСообщенийСМЭВ3
		|		ПО Док.Ссылка = ДанныеИсходящихСообщенийСМЭВ3.Данные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПодпискаНаУведомлениеГИСГМПЗначенияПараметровПодписки.ЗначениеПараметра КАК УИН,
		|	МАКСИМУМ(ДокументыПодписокВРаботе.ДатаОбмена) КАК ДатаОбмена
		|ИЗ
		|	Документ.ПодпискаНаУведомлениеГИСГМП.ЗначенияПараметровПодписки КАК ПодпискаНаУведомлениеГИСГМПЗначенияПараметровПодписки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДокументыПодписокВРаботе КАК ДокументыПодписокВРаботе
		|		ПО ПодпискаНаУведомлениеГИСГМПЗначенияПараметровПодписки.Ссылка = ДокументыПодписокВРаботе.Ссылка
		|ГДЕ
		|	ИСТИНА В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИСТИНА
		|			ИЗ
		|				ДокументыПодписокВРаботе КАК ТТ
		|			ГДЕ
		|				ТТ.Ссылка = ПодпискаНаУведомлениеГИСГМПЗначенияПараметровПодписки.Ссылка
		|				И ТТ.Подписка = &ПодпискаНаНачисления)
		|	И ПодпискаНаУведомлениеГИСГМПЗначенияПараметровПодписки.ЗначениеПараметра В(&МассивУИН)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПодпискаНаУведомлениеГИСГМПЗначенияПараметровПодписки.ЗначениеПараметра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПодпискаНаУведомлениеГИСГМПЗначенияПараметровПодписки.ЗначениеПараметра КАК УИН,
		|	МАКСИМУМ(ДокументыПодписокВРаботе.ДатаОбмена) КАК ДатаОбмена
		|ИЗ
		|	Документ.ПодпискаНаУведомлениеГИСГМП.ЗначенияПараметровПодписки КАК ПодпискаНаУведомлениеГИСГМПЗначенияПараметровПодписки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДокументыПодписокВРаботе КАК ДокументыПодписокВРаботе
		|		ПО ПодпискаНаУведомлениеГИСГМПЗначенияПараметровПодписки.Ссылка = ДокументыПодписокВРаботе.Ссылка
		|ГДЕ
		|	ИСТИНА В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИСТИНА
		|			ИЗ
		|				ДокументыПодписокВРаботе КАК ТТ
		|			ГДЕ
		|				ТТ.Ссылка = ПодпискаНаУведомлениеГИСГМПЗначенияПараметровПодписки.Ссылка
		|				И ТТ.Подписка = &ПодпискаНаКвитанции)
		|	И ПодпискаНаУведомлениеГИСГМПЗначенияПараметровПодписки.ЗначениеПараметра В(&МассивУИН)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПодпискаНаУведомлениеГИСГМПЗначенияПараметровПодписки.ЗначениеПараметра
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ДанныеОКвитированииГИСГМП.СуммаПлатежа) КАК СуммаПлатежа,
		|	ДанныеОКвитированииГИСГМП.УИН КАК УИН
		|ИЗ
		|	РегистрСведений.ДанныеОКвитированииГИСГМП КАК ДанныеОКвитированииГИСГМП
		|ГДЕ
		|	ДанныеОКвитированииГИСГМП.УИН В(&МассивУИН)
		|	И ДанныеОКвитированииГИСГМП.КвитанцияАннулирована = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеОКвитированииГИСГМП.УИН";
	
	Запрос.УстановитьПараметр("МассивУИН", МассивУИН);
	Запрос.УстановитьПараметр("Организация", мОрганизация);
	Запрос.УстановитьПараметр("ПодпискаНаНачисления", мПодпискаДляНачислений);
	Запрос.УстановитьПараметр("ПодпискаНаКвитанции", мПодпискаДляКвитанций);
	
	СтатусыПодписки = Новый Массив;
	СтатусыПодписки.Добавить(1);
	СтатусыПодписки.Добавить(2);
	Запрос.УстановитьПараметр("СтатусыПодписки", СтатусыПодписки);
	
	Запрос.УстановитьПараметр("СтатусОбработки", Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВОчереди);
	//если есть успешно отправленный документ в работе за последние 30 дней (30*24*60*60=2 592 000)
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ТекущаяДатаСеанса()) - 2592000);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДатаСеанса()));
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаНачисления = РезультатыЗапроса[0].Выгрузить();
	ТаблицаНачисления.Индексы.Добавить("УИН,ПараметрАктивен");
	
	ТаблицаНачисленияВРаботе = РезультатыЗапроса[3].Выгрузить();
	ТаблицаНачисленияВРаботе.Индексы.Добавить("УИН");
	
	ТаблицаКвитанции = РезультатыЗапроса[1].Выгрузить();
	ТаблицаКвитанции.Индексы.Добавить("УИН,ПараметрАктивен");
	
	ТаблицаКвитанцииВРаботе = РезультатыЗапроса[4].Выгрузить();
	ТаблицаКвитанцииВРаботе.Индексы.Добавить("УИН");
	
	ТаблицаСуммыПлатежей = РезультатыЗапроса[5].Выгрузить();
	ТаблицаСуммыПлатежей.Индексы.Добавить("УИН");
	
	СтруктураПоиска = Новый Структура("УИН,ПараметрАктивен","",Истина);
	
	Для Каждого КлючИЗначение Из Строки Цикл
		КлючИЗначение.Значение.Данные.ЕстьПодпискаНаКвитанции = -1;
		КлючИЗначение.Значение.Данные.ЕстьПодпискаНаНачисления = -1;
		
		Если ЗначениеЗаполнено(КлючИЗначение.Значение.Данные.УИН) Тогда
			СтруктураПоиска.УИН = КлючИЗначение.Значение.Данные.УИН;
			НайденныеСтроки = ТаблицаНачисления.НайтиСтроки(СтруктураПоиска);
			ТекПериод = Неопределено;
			Если НайденныеСтроки.Количество() Тогда
				ТекПериод = НайденныеСтроки[0].Период;
				КлючИЗначение.Значение.Данные.ЕстьПодпискаНаНачисления = 1;
			КонецЕсли;
			
			СтрокаДок = ТаблицаНачисленияВРаботе.Найти(СтруктураПоиска.УИН,"УИН");
			Если СтрокаДок <> Неопределено Тогда
				//если в регистре подписка НЕ подключена для данного УИН,
				//или подключена, но после даты подключения был обмен с подпиской с данным УИН 
				Если НЕ ЗначениеЗаполнено(ТекПериод)
					ИЛИ (ЗначениеЗаполнено(ТекПериод)
						И ТекПериод < СтрокаДок.ДатаОбмена) Тогда
					КлючИЗначение.Значение.Данные.ЕстьПодпискаНаНачисления = 0;
				КонецЕсли;
			КонецЕсли;
						
			НайденныеСтроки = ТаблицаКвитанции.НайтиСтроки(СтруктураПоиска);
			ТекПериод = Неопределено;
			Если НайденныеСтроки.Количество() Тогда
				ТекПериод = НайденныеСтроки[0].Период;
				КлючИЗначение.Значение.Данные.ЕстьПодпискаНаКвитанции = 1;
			КонецЕсли;
			СтрокаДок = ТаблицаКвитанцииВРаботе.Найти(СтруктураПоиска.УИН,"УИН");
			Если СтрокаДок<> Неопределено Тогда
				//если в регистре подписка НЕ подключена для данного УИН,
				//или подключена, но после даты подключения был обмен с подпиской с данным УИН 
				Если НЕ ЗначениеЗаполнено(ТекПериод)
					ИЛИ (ЗначениеЗаполнено(ТекПериод)
						И ТекПериод < СтрокаДок.ДатаОбмена) Тогда
					КлючИЗначение.Значение.Данные.ЕстьПодпискаНаКвитанции = 0;	
				КонецЕсли;
			КонецЕсли;
			
			СтрокаДок = ТаблицаСуммыПлатежей.Найти(СтруктураПоиска.УИН,"УИН");
			Если СтрокаДок <> Неопределено Тогда
				//сумма сквитированных платежей 
				КлючИЗначение.Значение.Данные.СуммаПлатежей = СтрокаДок.СуммаПлатежа;
			Иначе
				КлючИЗначение.Значение.Данные.СуммаПлатежей = 0;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИзменитьДействиеПриФормированииПакетов(Команда)
	
	СписокОтветов = Новый СписокЗначений;
	СписокОтветов.Добавить(0,"Ничего не делать");
	СписокОтветов.Добавить(1,"Задавать вопрос");
	СписокОтветов.Добавить(2,"Отправлять в сервис");
	
	
	ТекстВопроса = НСтр("ru='Выберите, что делать после формирования пакетов начислений и возвратов:'");
	ОписаниеОп = Новый ОписаниеОповещения("ПослеОтветаНаВопросОбИзмененииДействияПриФП",ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОп,ТекстВопроса,СписокОтветов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОбИзмененииДействияПриФП(Результат,ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПриФормированииПакетов = Результат;
	
	ТекстЗаголовка = НСтр("ru='Действие после формирования пакетов: %1 (изменить)'");
	ТекДействие = "";
	Если ПриФормированииПакетов = 0 Тогда
		ТекДействие = "Нет";
	ИначеЕсли ПриФормированииПакетов = 1 Тогда
		ТекДействие = "Задавать вопрос";
	ИначеЕсли ПриФормированииПакетов = 2 Тогда
		ТекДействие = "Отправлять в сервис";
	КонецЕсли;
	
	ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка,ТекДействие);
	
	Элементы.СписокКвитанцийКонтекстноеМенюИзменитьДействиеПриФормированииПакетов.Заголовок = ТекстЗаголовка;
	Элементы.СписокВозвратовКонтекстноеМенюИзменитьДействиеПриФормированииПакетов.Заголовок = ТекстЗаголовка;
	
КонецПроцедуры

