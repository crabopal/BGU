&НаСервере
Процедура ОбновитьСписокПлатежей()
		
	МассивОтмеченных = Новый Массив;
	Для Каждого СтрТЧ Из ТаблицаПлатежиДляОтменыКвитирования Цикл
		Если СтрТЧ.Использовать Тогда
			МассивОтмеченных.Добавить(СтрТЧ.ПлатежСсылка);
		КонецЕсли;
	КонецЦикла;
	ТаблицаПлатежиДляОтменыКвитирования.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоответствиеНачисленийИПлатежей.Платеж КАК ПлатежСсылка,
		|	СоответствиеНачисленийИПлатежей.Платеж.СуммаДокумента КАК Сумма,
		|	ВЫБОР
		|		КОГДА СоответствиеНачисленийИПлатежей.Платеж ССЫЛКА Документ.ПлатежВОплатуГосуслуг
		|			ТОГДА ВЫРАЗИТЬ(СоответствиеНачисленийИПлатежей.Платеж КАК Документ.ПлатежВОплатуГосуслуг).Плательщик
		|		ИНАЧЕ ВЫРАЗИТЬ(СоответствиеНачисленийИПлатежей.Платеж КАК Документ.ПлатежПодведомственному).ПлательщикНаименование
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА СоответствиеНачисленийИПлатежей.Платеж В (&МассивОтмеченных)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Использовать,
		|	СоответствиеНачисленийИПлатежей.Платеж.БанковскийИдентификаторПлатежа КАК УИП
		|ПОМЕСТИТЬ ТабПлатежей
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Начисление = &Начисление
		|	И СоответствиеНачисленийИПлатежей.БанковскийИдентификаторПлатежаЗаполнен
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ПлатежСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТабПлатежей.ПлатежСсылка КАК ПлатежСсылка,
		|	ТабПлатежей.Сумма КАК Сумма,
		|	ТабПлатежей.Контрагент КАК Контрагент,
		|	ТабПлатежей.Использовать КАК Использовать,
		|	ТабПлатежей.УИП КАК УИП,
		|	СУММА(ЕСТЬNULL(УведомлениеОВозвратеГИСГМП.СуммаДокумента, 0) + ЕСТЬNULL(УведомлениеОВозвратеГИСГМПОтПодведомственного.СуммаДокумента, 0)) КАК СуммаВозвратов
		|ИЗ
		|	ТабПлатежей КАК ТабПлатежей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОВозвратеГИСГМП КАК УведомлениеОВозвратеГИСГМП
		|		ПО ТабПлатежей.ПлатежСсылка = УведомлениеОВозвратеГИСГМП.ВозвращаемыйПлатеж
		|			И (УведомлениеОВозвратеГИСГМП.ПометкаУдаления = ЛОЖЬ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОВозвратеГИСГМПОтПодведомственного КАК УведомлениеОВозвратеГИСГМПОтПодведомственного
		|		ПО ТабПлатежей.ПлатежСсылка = УведомлениеОВозвратеГИСГМПОтПодведомственного.ВозвращаемыйПлатеж
		|			И (УведомлениеОВозвратеГИСГМПОтПодведомственного.ПометкаУдаления = ЛОЖЬ)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТабПлатежей.Использовать,
		|	ТабПлатежей.УИП,
		|	ТабПлатежей.ПлатежСсылка,
		|	ТабПлатежей.Контрагент,
		|	ТабПлатежей.Сумма";
	
	Запрос.УстановитьПараметр("Начисление", ТекущаяКвитанция);
	Запрос.УстановитьПараметр("МассивОтмеченных", МассивОтмеченных);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаПлатежиДляОтменыКвитирования.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРезультатОбменаВРегистрыОбменаСМЭВ()
	 
	ТабРезультатФормирования = РеквизитФормыВЗначение("РезультатФормирования");
	ТабРезультатФормирования.Индексы.Добавить("НомерПакета");
	
	//МассивПодтвержденныхИдентификаторов = Новый Массив;
	
	ТаблицаПодтв = РеквизитФормыВЗначение("ТаблицаПодтвержденияПолученияСообщений");
	ТаблицаПодтв.Индексы.Добавить("ИдентификаторСообщенияЗапроса");
	
	ТипУИД = Тип("УникальныйИдентификатор");
	ТипЗапросУнифо = Тип("ДокументСсылка.ЗапросУНИФО");
	
	Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.СодержимоеФайла) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ИмпортДанныхВСМЭВ
			ИЛИ СтрТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика Тогда
			
			ТипУчастника = Перечисления.ТипыУчастниковГИСГМП.АН;
			
			Если СтрТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика Тогда
				
				Если ЗначениеЗаполнено(СтрТЧ.ТипУчастника) Тогда
					ТипУчастника = СтрТЧ.ТипУчастника;
				Иначе
					//Только запросы к сервису, определим от кого был запрос АН или АЗ.
					//Тип участника нужен для того, чтобы определять, куда загружать ответ.
				    СтрокиРезультата = ТабРезультатФормирования.НайтиСтроки(Новый Структура("НомерПакета",СтрТЧ.НомерПакета));
					Для Каждого СтрРезультата Из СтрокиРезультата Цикл
						Если ЗначениеЗаполнено(СтрРезультата.Объект) Тогда
							ТипОбъектаСтроки = ТипЗнч(СтрРезультата.Объект);
							Если ТипОбъектаСтроки = ТипЗапросУнифо Тогда
								ТипУчастника = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрРезультата.Объект,"ТипУчастника");
							ИначеЕсли ТипОбъектаСтроки = ТипУИД Тогда//если это запрос по данным регистра
								ТипУчастника = СтрТЧ.ТипУчастника;									
							КонецЕсли;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
			ЗаписьСИ = РегистрыСведений.СообщенияИмпортаДанныхВСМЭВ3.СоздатьМенеджерЗаписи();
			//Измерения
			ЗаписьСИ.Организация = УчастникОтправитель;//это организация - участник прямого взаимодействия
			
			ЗаписьСИ.ИдентификаторСообщения = СтрТЧ.ИдентификаторСообщения;
			//Ресурсы
			ЗаписьСИ.Участник = СтрТЧ.ТекущийУчастник;//в данном случае он совпадает
			ЗаписьСИ.СообщениеЗапрос = Новый ХранилищеЗначения(СтрТЧ.СодержимоеФайла);//Сформированный xml SOAP пакета
			ЗаписьСИ.ФорматОбмена = СтрТЧ.ФорматОбмена;//Формат обмена в данном регистре нужен для получения заголовков, которые необходимо добавить в http запрос
			ЗаписьСИ.СообщениеОтвет = Новый ХранилищеЗначения(СтрТЧ.СообщениеОтвет);
			ЗаписьСИ.ДатаОбмена = СтрТЧ.ДатаОбмена;
			ЗаписьСИ.СтатусОтправки = ?(ЗначениеЗаполнено(СтрТЧ.СтатусОтправки), СтрТЧ.СтатусОтправки, Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен); 
			
			ЗаписьСИ.ЕстьОшибка = СтрТЧ.ТаблицаОшибок.Количество()>0;
			ЗаписьСИ.ОбменСЭмулятором = СтрТЧ.ОбменСЭмулятором;
			
			ЗаписьСИ.ТипУчастника = ТипУчастника;
			
			МассивСообщений = Новый Массив;
			
			Для Каждого СтрОшибки Из СтрТЧ.ТаблицаОшибок Цикл
				
				Если НЕ ЗначениеЗаполнено(СтрОшибки.ПолеФайла)
					И НЕ ЗначениеЗаполнено(СтрОшибки.Ошибка) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрОшибки.ПолеФайла) Тогда
					МассивСообщений.Добавить(СтрОшибки.ПолеФайла +", "+ СтрОшибки.Ошибка);
				Иначе
					МассивСообщений.Добавить(СтрОшибки.Ошибка);
				КонецЕсли;
				
			КонецЦикла;
			
			ЗаписьСИ.РезультатОбработки = СтрСоединить(МассивСообщений,Символы.ПС);//текст ошибок при отправке сообщения в сервис		
			
			ЗаписьСИ.Записать();
										
			СтрокиРезультата = ТабРезультатФормирования.НайтиСтроки(Новый Структура("НомерПакета",СтрТЧ.НомерПакета));
			Для Каждого СтрРезультата Из СтрокиРезультата Цикл
				//Записываем даже если есть ошибка, чтобы можно было сохранить историю обмена.
				//Если ЗначениеЗаполнено(СтрРезультата.ОписаниеОшибки) Тогда
				//	Продолжить;
				//КонецЕсли;
				
				ЗаписьДИС = РегистрыСведений.ДанныеИсходящихСообщенийСМЭВ3.СоздатьМенеджерЗаписи();
				//Измерения
				ЗаписьДИС.Организация = УчастникОтправитель;
				ЗаписьДИС.ИдентификаторСообщения = СтрТЧ.ИдентификаторСообщения;
				ЗаписьДИС.ДатаОбмена = СтрТЧ.ДатаОбмена;
				ЗаписьДИС.Участник = СтрРезультата.ТекущийУчастник;
				
				//если объект это УникальныйИдентификатор, то это запрос по данным регистра, без документа, 
				//поэтому в вместо Данные заполняем УИДВыполняемогоЗапросаКГИСГМП 
				Если ТипЗнч(СтрРезультата.Объект) = ТипУИД Тогда
					ЗаписьДИС.ИдентификаторДанных = "N_"+СтрРезультата.Объект;
					ЗаписьДИС.УИДВыполняемогоЗапросаКГИСГМП = СтрРезультата.Объект;
				Иначе
					ЗаписьДИС.ИдентификаторДанных = "N_"+СтрРезультата.Объект.УникальныйИдентификатор();		
					ЗаписьДИС.Данные = СтрРезультата.Объект;
				КонецЕсли;
				ЗаписьДИС.Записать();
			КонецЦикла;
			
		ИначеЕсли СтрТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ПодтверждениеПолученияСообщенияСМЭВ Тогда
			ЗаписьСИ = РегистрыСведений.СообщенияПодтвержденияПолученияДанныхИзСМЭВ3.СоздатьМенеджерЗаписи();
			//Измерения
			ЗаписьСИ.Организация = УчастникОтправитель;
			ЗаписьСИ.ИдентификаторСообщенияСМЭВ = СтрТЧ.ИдентификаторСообщения;//СтрТЧ.ИдентификаторСообщенияСМЭВ;
			
			ЗаписьСИ.СообщениеЗапросПодтверждения = Новый ХранилищеЗначения(СтрТЧ.СодержимоеФайла);//Сформированный xml SOAP пакета
			ЗаписьСИ.СообщениеОтветПодтверждения = Новый ХранилищеЗначения(СтрТЧ.СообщениеОтвет);
			
			//Ресурсы
			
			ЗаписьСИ.ФорматОбмена = СтрТЧ.ФорматОбмена;//Формат обмена в данном регистре нужен для получения заголовков, которые необходимо добавить в http запрос		
			ЗаписьСИ.ДатаЗапроса = СтрТЧ.ДатаОбмена;
			
			ЗаписьСИ.Записать();
						
		ИначеЕсли СтрТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСМЭВ
			ИЛИ СтрТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСтатусов Тогда
			
			ЗаписьСИ = РегистрыСведений.СообщенияЗапросаДанныхОчередиСМЭВ3.СоздатьМенеджерЗаписи();
			//Измерения
			ЗаписьСИ.Организация = УчастникОтправитель;
			
			//в процедуре ГосУслуги.ОбработатьОтветыИзСервисаСМЭВ
			//СтрТЧ.ИдентификаторСообщения заполняется как новый уникальный идентификатор
			
			ЗаписьСИ.ГУИД = СтрТЧ.ИдентификаторСообщения;
			ЗаписьСИ.ЕстьДанные = СтрТЧ.ЕстьДанные;
			
			СтрТаблицыИд = ТаблицаПодтв.Найти(СтрТЧ.ИдентификаторСообщения,"ИдентификаторСообщенияЗапроса");
			Если СтрТаблицыИд <> Неопределено Тогда
				ЗаписьСИ.ИдентификаторСообщенияСМЭВ = СтрТаблицыИд.ИдентификаторСообщенияСМЭВ;
				ЗаписьСИ.ИдентификаторСообщенияУчастника = СтрТаблицыИд.ИдентификаторСообщенияУчастника;
			КонецЕсли;
			
			//Ресурсы
			ЗаписьСИ.СообщениеЗапрос = Новый ХранилищеЗначения(СтрТЧ.СодержимоеФайла);//Сформированный xml SOAP пакета
			ЗаписьСИ.СообщениеОтвет = Новый ХранилищеЗначения(СтрТЧ.СообщениеОтвет);					
			ЗаписьСИ.СтатусОтправки = ?(ЗначениеЗаполнено(СтрТЧ.СтатусОтправки), СтрТЧ.СтатусОтправки, Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен);
			ЗаписьСИ.ФорматОбмена = СтрТЧ.ФорматОбмена;//Формат обмена в данном регистре нужен для получения заголовков, которые необходимо добавить в http запрос		
			ЗаписьСИ.ДатаЗапроса = СтрТЧ.ДатаОбмена;
			ЗаписьСИ.Записать();
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПакетов(ОбновлятьСписокОтмеченных = Ложь)
			
	ЗаполнитьНастройкиДССписокПакетов();
		
	Если ОбновлятьСписокОтмеченных Тогда
		ОбновитьСписокОтмеченныхПакетовПоДаннымСпискаПакетов();
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиДССписокПакетов()
	
	Перем ГруппаДатаНачала, ГруппаДатаОкончания, НайденныеЭлементы, СтатусыДляОтправки;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПакетов,"ОтмеченныеПакеты",СписокОтмеченныеПакеты,Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПакетов,"РежимРаботы",РежимРаботыПакеты,Истина);
	
	//Вид пакета: 0 - все, 1 - начисления, 2 - возвраты
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПакетов,"НужныПакетыНачислений",ВидПакетаОтбор < 2,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПакетов,"НужныПакетыВозвратов",ВидПакетаОтбор <> 1,Истина);
	
	СтатусыДляОтправки = Новый Массив;
	СтатусыДляОтправки.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен);
	СтатусыДляОтправки.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОбработан);
	СтатусыДляОтправки.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ПереведенВАрхив);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПакетов,"СтатусыДляОтправки",СтатусыДляОтправки,Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПакетов,"МассивУчастниковОрганизаций",МассивУчастниковОрганизаций,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПакетов,"МассивУчастниковКонтрагентов",МассивУчастниковКонтрагентов,Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПакетов,"Участник",Объект.Участник, Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокПакетов,"Статус",СтатусОбработкиПакеты,,,СтатусОбработкиПакетыУсловие);
	
	// отбор по периоду
	НайденныеЭлементы = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(СписокПакетов.Отбор,,"ГруппаДатаНачала");
	Если НайденныеЭлементы.Количество() Тогда
		ГруппаДатаНачала = НайденныеЭлементы[0];
	Иначе
		ГруппаДатаНачала = СписокПакетов.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаДатаНачала.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		ГруппаДатаНачала.Представление = "ГруппаДатаНачала";
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаДатаНачала,"Дата",ПериодОтбора.ДатаНачала,ВидСравненияКомпоновкиДанных.БольшеИлиРавно,,ПериодОтбораУсловие И ЗначениеЗаполнено(ПериодОтбораПакеты.ДатаНачала));
	
	НайденныеЭлементы = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(СписокПакетов.Отбор,,"ГруппаДатаОкончания");
	Если НайденныеЭлементы.Количество() Тогда
		ГруппаДатаОкончания = НайденныеЭлементы[0];
	Иначе
		ГруппаДатаОкончания = СписокПакетов.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаДатаОкончания.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		ГруппаДатаОкончания.Представление = "ГруппаДатаОкончания";
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаДатаОкончания,"Дата",ПериодОтбора.ДатаОкончания,ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,,ПериодОтбораУсловие И ЗначениеЗаполнено(ПериодОтбораПакеты.ДатаОкончания));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВозвратов(ОбновлятьСписокОтмеченных = Ложь)
	ЗаполнитьНастройкиДССписокВозвратов();
	
	Если ОбновлятьСписокОтмеченных Тогда
		ОбновитьСписокОтмеченныхВозвратовПоДаннымСпискаВозвратов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиДССписокВозвратов()
	
	Перем ГруппаДатаНачала, ГруппаДатаОкончания, НайденныеЭлементы, СтатусыНеДляКвитирования;
					
	Если РежимРаботыВозвраты <> 1 Тогда
		//Если это не формирование пакетов, то документы Уведомление... от подведомственного можно показывать в списке
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"МассивУчастниковКонтрагентов",МассивУчастниковКонтрагентов,Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"МассивУчастниковКонтрагентов",Новый Массив,Истина);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"МассивУчастниковОрганизаций",МассивУчастниковОрганизаций,Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"РежимРаботы", РежимРаботыВозвраты,Истина);
			
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"НеОплаченные",Ложь,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"СтатусПодготовлен",Перечисления.СтатусыИсполненияДокумента.Подготовлен,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"СтатусНаИсполнении",Перечисления.СтатусыИсполненияДокумента.НаИсполнении,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"Участник",Объект.Участник,Истина);
	
	// отбор по периоду
	НайденныеЭлементы = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(СписокВозвратов.Отбор,,"ГруппаДатаНачала");
	Если НайденныеЭлементы.Количество() Тогда
		ГруппаДатаНачала = НайденныеЭлементы[0];
	Иначе
		ГруппаДатаНачала = СписокВозвратов.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаДатаНачала.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		ГруппаДатаНачала.Представление = "ГруппаДатаНачала";
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаДатаНачала,"Дата",ПериодОтбора.ДатаНачала,ВидСравненияКомпоновкиДанных.БольшеИлиРавно,,ПериодОтбораУсловие И ЗначениеЗаполнено(ПериодОтбора.ДатаНачала));
	
	НайденныеЭлементы = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(СписокВозвратов.Отбор,,"ГруппаДатаОкончания");
	Если НайденныеЭлементы.Количество() Тогда
		ГруппаДатаОкончания = НайденныеЭлементы[0];
	Иначе
		ГруппаДатаОкончания = СписокВозвратов.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаДатаОкончания.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		ГруппаДатаОкончания.Представление = "ГруппаДатаОкончания";
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаДатаОкончания,"Дата",ПериодОтбора.ДатаОкончания,ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,,ПериодОтбораУсловие И ЗначениеЗаполнено(ПериодОтбора.ДатаОкончания));	
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"КонтрагентОтборУсловие",ПлательщикОтборУсловие,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"КонтрагентОтбор",ПлательщикОтбор,Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокВозвратов,"Статус",СтатусДокументаОтбор,,,СтатусДокументаОтборУсловие);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВозвратов,"ОтмеченныеВозвраты",СписокОтмеченныеВозвраты,Истина);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтатусПродолжение(НужныйСтатус,ВидДокумента) Экспорт
	
	Если НужныйСтатус = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидДокумента = "Начисления" Тогда
		
		ИмяТаблицы = "СписокКвитанций";
		ИмяПоляДокумента = "Квитанция";
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг"));
		МассивТипов.Добавить(Тип("ДокументСсылка.НачислениеОтПодведомственного"));
		
	Иначе
		
		ИмяТаблицы = "СписокВозвратов";
		ИмяПоляДокумента = "ДокСсылка";
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("ДокументСсылка.УведомлениеОВозвратеГИСГМП"));
		МассивТипов.Добавить(Тип("ДокументСсылка.УведомлениеОВозвратеГИСГМПОтПодведомственного"));
		
	КонецЕсли;
	
	МассивДокументов = Новый Массив;
	Для Каждого ТекСтр Из Элементы[ИмяТаблицы].ВыделенныеСтроки Цикл
		ТекДанные = Элементы[ИмяТаблицы].ДанныеСтроки(ТекСтр);
		МассивДокументов.Добавить(ТекДанные[ИмяПоляДокумента]);
	КонецЦикла;
	
	Если МассивДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИзменитьСтатусДокументовНаСервере(НужныйСтатус,МассивДокументов,ИмяТаблицы);
	
	Если МассивДокументов.Количество() = 1 Тогда
		ОповеститьОбИзменении(МассивДокументов[0]);	
	ИначеЕсли МассивДокументов.Количество()>1 Тогда
		Для Каждого ТекТип Из МассивТипов Цикл
			ОповеститьОбИзменении(ТекТип);
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ИзменитьСтатусДокументовНаСервере(НужныйСтатус,Знач МассивДокументов,ИмяТаблицы)
	
	Для Каждого ЭлМас Из МассивДокументов Цикл
		
		РеквизитыРегистрации = Новый Структура;	
		РеквизитыРегистрации.Вставить("ПлатежноРасчетныйДокумент", ЭлМас);
		РеквизитыРегистрации.Вставить("Статус", НужныйСтатус);
		
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(РеквизитыРегистрации);
	КонецЦикла;
	
	Элементы[ИмяТаблицы].Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьИдПлательщикаПродолжение(РезультатОтвета,ДопПараметры) Экспорт
	
	Если РезультатОтвета = КодВозвратаДиалога.ОК Тогда
		ПерезаполнитьИдПлательщикаНаСервере(Элементы.СписокКвитанций.ВыделенныеСтроки);
		ОповеститьОбИзменении(Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг"));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьИдПлательщикаНаСервере(Знач МассивВыделенныхСтрок)
	
	ИспользоватьИнтеграциюСУНИФО = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО");
	ИспользоватьИнтеграциюГИСГМП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	КоличествоОбновлено = 0;
	
	Для Каждого ЭлМас Из МассивВыделенныхСтрок Цикл
		
		Если ТипЗнч(ЭлМас) <> Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг") Тогда
			Продолжить;
		КонецЕсли;
		//если это документ был подписан для формата 1.16
		НельзяРедактировать = БиблиотекаФункцийОбмена.СуществуетПодписанноеНачисление(ЭлМас);
		Если НельзяРедактировать Тогда
			ТекстТекущегоСообщения = Нстр("ru='Документ %1 подписан ЭП. До снятия подписи изменения запрещены.'");
			ТекстТекущегоСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстТекущегоСообщения,ЭлМас);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстТекущегоСообщения);
			Продолжить;
		КонецЕсли;
		
		ТекОбъект = ЭлМас.ПолучитьОбъект();
		ТекОбъект.ОсновнойИдентификаторПлательщика = "";
		ТекОбъект.ДополнительныйИдентификаторПлательщика = "";
		
		ТекОбъект.ТаблицаИдентификаторов.Очистить();	
				
		Если ИспользоватьИнтеграциюСУНИФО Тогда
			ТекХарактеристики = Справочники.Номенклатура.ПолучитьХарактеристикиГосуслуги(ТекОбъект.Номенклатура, ТекОбъект.Дата);
			// Идентификаторы плательщика
			ТекОбъект.СформироватьТаблицуИдентификаторов(ТекХарактеристики.ЗначениеНастройки);
		ИначеЕсли ИспользоватьИнтеграциюГИСГМП Тогда
			ДатаНастроек = ГосУслугиПовтИсп.ВернутьПериодАктуальныхНастроек(ТекОбъект.Номенклатура,ТекОбъект.Дата);
			Если ДатаНастроек = Неопределено Тогда
				ТекстТекущегоСообщения = Нстр("ru='Для документа %1 не удалось обновить идентификаторы плательщика. 
				|На дату %2 в госуслуге ""%3"" не задана настройка формирования идентификаторов плательщика.'");
				ТекстТекущегоСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстТекущегоСообщения,ЭлМас,Формат(ТекОбъект.Дата,"ДФ=dd.MM.yyyy"),ТекОбъект.Номенклатура);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстТекущегоСообщения);

				Продолжить;
			КонецЕсли;
			РезультатЗапроса = ГосУслугиПовтИсп.ВернутьНастройкуИспользуемыхИдентификаторов(ТекОбъект.Номенклатура,ДатаНастроек);			
			ГосУслуги.ЗаполнитьИдентификаторПлательщикаДляГИСГМП(ТекОбъект,РезультатЗапроса.Выгрузить());
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекОбъект.ОсновнойИдентификаторПлательщика)
			И НЕ ЗначениеЗаполнено(ТекОбъект.ЕдиныйИдентификаторПлательщика)
			И НЕ ЗначениеЗаполнено(ТекОбъект.АльтернативныйИдентификаторПлательщика) Тогда
			
			Если Лев(ТекОбъект.ОсновнойИдентификаторПлательщика,1) = "1" Тогда
				//физлица
				ТекОбъект.АльтернативныйИдентификаторПлательщика = ГосУслуги.ПреобразоватьИдентификаторПлательщикаИз20В116(ТекОбъект.ОсновнойИдентификаторПлательщика);
			Иначе
				ТекОбъект.ЕдиныйИдентификаторПлательщика = ГосУслуги.ПреобразоватьИдентификаторПлательщикаИз20В116(ТекОбъект.ОсновнойИдентификаторПлательщика);
			КонецЕсли;			
			
		КонецЕсли;
			
		ТекОбъект.Записать();
		КоличествоОбновлено = КоличествоОбновлено +1;
	КонецЦикла;
	
	ТекстТекущегоСообщения = Нстр("ru='Обновлено документов %1'");
	ТекстТекущегоСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстТекущегоСообщения,КоличествоОбновлено);

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстТекущегоСообщения);
	
	Элементы.СписокКвитанций.Обновить();
	//ЗаполнитьСписокКвитанций();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииРежимаРаботыКвитанций()
	ИзменитьВидимостьКомандПоРежимуРаботыКвитанций();
	ЗаполнитьСписокКвитанций(Истина);
КонецПроцедуры

&НаСервере
Процедура ИзменитьВидимостьКомандПоРежимуРаботыКвитанций()
	
	Элементы.ГруппаКВФП.ЦветФона = ?(РежимРаботыКвитанции = 1,ЦветаСтиля.ФонУправляющегоПоля,ЦветаСтиля.ЦветФонаФормы);
	Элементы.ГруппаКВЗП.ЦветФона = ?(РежимРаботыКвитанции = 2,ЦветаСтиля.ФонУправляющегоПоля,ЦветаСтиля.ЦветФонаФормы);
	Элементы.ГруппаКВКвит.ЦветФона = ?(РежимРаботыКвитанции = 3,ЦветаСтиля.ФонУправляющегоПоля,ЦветаСтиля.ЦветФонаФормы);
	Элементы.ГруппаКВОтмКВ.ЦветФона = ?(РежимРаботыКвитанции = 4,ЦветаСтиля.ФонУправляющегоПоля,ЦветаСтиля.ЦветФонаФормы);
	Элементы.ГруппаКВВсе.ЦветФона = ?(РежимРаботыКвитанции = 9,ЦветаСтиля.ФонУправляющегоПоля,ЦветаСтиля.ЦветФонаФормы);
	
	Элементы.СписокКвитанцийСформироватьПакеты.Видимость = (РежимРаботыКвитанции = 1);
	Элементы.СписокКвитанцийЗапроситьПлатежиПоНачислению.Видимость = (РежимРаботыКвитанции = 2);
	Элементы.СписокКвитанцийЗапроситьПлатежиЗаПериод.Видимость = (РежимРаботыКвитанции = 2);
	Элементы.СписокКвитанцийЗапроситьСтатус.Видимость = (РежимРаботыКвитанции = 3 ИЛИ РежимРаботыКвитанции = 4);
	Элементы.СписокКвитанцийСквитироватьСПлатежами.Видимость = (РежимРаботыКвитанции = 3);
	Элементы.СписокКвитанцийСквитироватьБезПлатежа.Видимость = (РежимРаботыКвитанции = 3);
	Элементы.СписокПлатежиДляКвитирования.Видимость = (РежимРаботыКвитанции = 3);
	
	Элементы.ОтметитьДляКвитирования.Видимость = (РежимРаботыКвитанции = 3);
	Элементы.СписокКвитанцийКонтекстноеМенюОтметитьДляКвитирования.Видимость = (РежимРаботыКвитанции = 3);
	Элементы.СписокКвитанцийКонтекстноеМенюСквитироватьБезПлатежаНаСумму.Видимость = (РежимРаботыКвитанции = 3);
	
	Элементы.СписокКвитанцийОтменитьКвитированиеБезПлатежа.Видимость = (РежимРаботыКвитанции = 4);
	Элементы.ТаблицаПлатежиДляОтменыКвитирования.Видимость = (РежимРаботыКвитанции = 4);	
	Элементы.ОставлятьРаспределенныеПлатежи.Видимость = (РежимРаботыКвитанции = 4);
	
	Элементы.СписокКвитанцийКонтекстноеМенюКвитирование_ВыполнитьОбменСЭмулятором.Видимость = (РежимРаботыКвитанции = 3 И ОбменСЭмулятором);
КонецПроцедуры

