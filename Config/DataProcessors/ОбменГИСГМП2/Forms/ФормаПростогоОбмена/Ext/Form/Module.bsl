&НаСервере
Процедура СформироватьФайлыПоПакетам(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
		
	МассивДокументов = Новый Массив;
	
	Если ТекущееДействие = "ОтправитьПакеты" Тогда
		Если мМассивПакетов.Количество() > 0 Тогда
			//отправка пакетов после формирования
			МассивДокументов = Новый Массив(мМассивПакетов);
			мМассивПакетов = Новый ФиксированныйМассив(Новый Массив);
		Иначе
			МассивДокументов = СписокОтмеченныеПакеты.ВыгрузитьЗначения();
		КонецЕсли;
	ИначеЕсли ТекущееДействие = "ОтправитьПакетПовторно" Тогда
		МассивДокументов.Добавить(ТекущийПакет);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПакетН.Ссылка КАК Ссылка,
		|	ПакетН.Организация КАК Организация,
		|	ПакетН.ДанныеПодписи КАК ДанныеПодписи,
		|	ПакетН.ДанныеДокумента КАК ДанныеДокумента
		|ИЗ
		|	Документ.ПакетНачисленийГИСГМП КАК ПакетН
		|ГДЕ
		|	ПакетН.Ссылка В(&МассивДокументов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПакетВ.Ссылка,
		|	ПакетВ.Организация,
		|	ПакетВ.ДанныеПодписи,
		|	ПакетВ.ДанныеДокумента
		|ИЗ
		|	Документ.ПакетУведомленийОВозвратеГИСГМП КАК ПакетВ
		|ГДЕ
		|	ПакетВ.Ссылка В(&МассивДокументов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПакетНП.Ссылка,
		|	ПакетНП.Организация,
		|	ПакетНП.ДанныеПодписи,
		|	ПакетНП.ДанныеДокумента
		|ИЗ
		|	Документ.ПакетНачисленийГИСГМПОтПодведомственного КАК ПакетНП
		|ГДЕ
		|	ПакетНП.Ссылка В(&МассивДокументов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПакетВП.Ссылка,
		|	ПакетВП.Организация,
		|	ПакетВП.ДанныеПодписи,
		|	ПакетВП.ДанныеДокумента
		|ИЗ
		|	Документ.ПакетУведомленийОВозвратеГИСГМПОтПодведомственного КАК ПакетВП
		|ГДЕ
		|	ПакетВП.Ссылка В(&МассивДокументов)
		|ИТОГИ ПО
		|	Организация";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	ОбработкаФормирования = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	ОбработкаФормирования.ОбменСЭмулятором = ОбменСЭмулятором;
	
	ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	НомерТек = 1;
	НуженНовыйПул = Истина;
	
	ТекстЗапросаДляЭмулятораПН = "";
	ТекстЗапросаДляЭмулятораПВ = "";
	
	Пока ВыборкаОрганизация.Следующий() Цикл
		
		Организация = ВыборкаОрганизация.Организация;
		НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Организация);
				
		ВыборкаДетальныеЗаписи = ВыборкаОрганизация.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			//каждый пакет нужно формировать отдельно, чтобы у каждого пакета был свой идентификатор сообщения
		
			СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
			СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
			СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
			СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
			СтруктураДляФормирования.Вставить("Организация", Организация);
			СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
			//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
			
			ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
			ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
		
			НовСтр = ТекОбъектыОбмена.Добавить();
			НовСтр.Объект = ВыборкаДетальныеЗаписи.Ссылка;
			ТекстЗапросаДляЭмулятора = "";
			Если ТипЗнч(ВыборкаДетальныеЗаписи.Ссылка) = Тип("ДокументСсылка.ПакетНачисленийГИСГМП") Тогда
				НовСтр.Формат = ФорматПН;
				
				Если ОбменСЭмулятором
					И НЕ ЗначениеЗаполнено(ТекстЗапросаДляЭмулятораПН) Тогда
					ТекстЗапросаДляЭмулятораПН = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ИмпортНачисления",ЕстьОшибки);
				КонецЕсли;
				
				ТекстЗапросаДляЭмулятора = ТекстЗапросаДляЭмулятораПН;
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Ссылка) = Тип("ДокументСсылка.ПакетУведомленийОВозвратеГИСГМП") Тогда
				НовСтр.Формат = ФорматПВ;
				
				Если ОбменСЭмулятором
					И НЕ ЗначениеЗаполнено(ТекстЗапросаДляЭмулятораПВ) Тогда
					ТекстЗапросаДляЭмулятораПВ = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ИмпортВозвратов",ЕстьОшибки);
				КонецЕсли;
				
				ТекстЗапросаДляЭмулятора = ТекстЗапросаДляЭмулятораПВ;
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Ссылка) = Тип("ДокументСсылка.ПакетНачисленийГИСГМПОтПодведомственного") Тогда
				НовСтр.Формат = ФорматПНП;
				
				Если ОбменСЭмулятором
					И НЕ ЗначениеЗаполнено(ТекстЗапросаДляЭмулятораПН) Тогда
					ТекстЗапросаДляЭмулятораПН = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ИмпортНачисления",ЕстьОшибки);
				КонецЕсли;
				
				ТекстЗапросаДляЭмулятора = ТекстЗапросаДляЭмулятораПН;
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Ссылка) = Тип("ДокументСсылка.ПакетУведомленийОВозвратеГИСГМПОтПодведомственного") Тогда
				НовСтр.Формат = ФорматПВП;
				
				Если ОбменСЭмулятором
					И НЕ ЗначениеЗаполнено(ТекстЗапросаДляЭмулятораПВ) Тогда
					ТекстЗапросаДляЭмулятораПВ = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ИмпортВозвратов",ЕстьОшибки);
				КонецЕсли;
				
				ТекстЗапросаДляЭмулятора = ТекстЗапросаДляЭмулятораПВ;
			КонецЕсли;
			
			СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
			
			ОбработкаФормирования.мОрганизация = Организация;
			ОбработкаФормирования.ИдентификаторСообщения = БиблиотекаФункцийОбмена.ПолучитьUUIDТекущегоВремени(НуженНовыйПул);
			ОбработкаФормирования.СоответствиеОбработанныхФорматов = Неопределено;
			ОбработкаФормирования.СформироватьФайлы(СтруктураДляФормирования);
			
			НуженНовыйПул = Ложь;
			
			Для Каждого СтрокаОбмена Из СтруктураДляФормирования.ОбъектыОбмена Цикл
				НовСтр = РезультатФормирования.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,СтрокаОбмена);
				НовСтр.НомерПакета = НомерТек;
				НовСтр.ТекущийУчастник = Организация;
				
				СтрФайлов = ФайлыРезультатаФормирования.Добавить();
				СтрФайлов.НомерПакета = НомерТек;
				СтрФайлов.СодержимоеФайла = СтрокаОбмена.РезультатФормирования;
				СтрФайлов.ИдентификаторСообщения = ОбработкаФормирования.ИдентификаторСообщения;
				СтрФайлов.ФорматОбмена = СтрокаОбмена.Формат;
				СтрФайлов.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ИмпортДанныхВСМЭВ;
				СтрФайлов.ОбменСЭмулятором = ОбменСЭмулятором;
				
				Если ЗначениеЗаполнено(СтрФайлов.СодержимоеФайла) Тогда
					
					Если ОбменСЭмулятором Тогда
						СтрФайлов.СодержимоеФайла = СтрЗаменить(СтрФайлов.СодержимоеФайла,"%ДанныеДокумента%",ТекстЗапросаДляЭмулятора);
						СтрФайлов.СодержимоеФайла = СтрЗаменить(СтрФайлов.СодержимоеФайла,"%ДанныеПодписи%","%ПодписьСП%");//укажем, что требуется подписывать
					Иначе					
						СтрФайлов.СодержимоеФайла = СтрЗаменить(СтрФайлов.СодержимоеФайла,"%ДанныеДокумента%",ВыборкаДетальныеЗаписи.ДанныеДокумента.Получить());
						СтрФайлов.СодержимоеФайла = СтрЗаменить(СтрФайлов.СодержимоеФайла,"%ДанныеПодписи%",ВыборкаДетальныеЗаписи.ДанныеПодписи.Получить());						
					КонецЕсли;
				КонецЕсли;
				
				СтрФайлов.ТекущийУчастник = Организация;
				
				ЕстьОшибки = ЕстьОшибки ИЛИ ЗначениеЗаполнено(НовСтр.ОписаниеОшибки);
				
				НомерТек = НомерТек + 1;
							
			КонецЦикла;
		
		КонецЦикла;
	КонецЦикла;	
		
	ТаблицаДанныхПакетов = Неопределено;
	
	МассивФ = Новый Массив;
	МассивФ.Добавить(ФорматПВ);
	МассивФ.Добавить(ФорматПН);
	МассивФ.Добавить(ФорматПНП);
	МассивФ.Добавить(ФорматПВП);
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, МассивФ));

КонецПроцедуры

&НаСервере
Функция ПолучитьТекстЗапросаДляЭмулятора(ВидОбмена, НастройкаОбмена, ТипСообщенияДляЭмулятора,ЕстьОшибки, ТекущийФорматЭмулятора = Неопределено)
	
	ТекОбъект = Неопределено;
	Если ТипСообщенияДляЭмулятора = "ИмпортНачисления" Тогда  
		
		ТекОбъект = Документы.ПакетНачисленийГИСГМП.ПустаяСсылка();
		
	ИначеЕсли ТипСообщенияДляЭмулятора = "ИмпортВозвратов" Тогда 
		
		ТекОбъект = Документы.ПакетУведомленийОВозвратеГИСГМП.ПустаяСсылка();
		
	ИначеЕсли ТипСообщенияДляЭмулятора = "ЗапросСтатуса" Тогда 
		
		ТекОбъект = Документы.ЗапросУНИФО.ПустаяСсылка();
		
	ИначеЕсли ТипСообщенияДляЭмулятора = "ЗапросВозврата" Тогда
		
		ТекОбъект = Документы.ЗапросУНИФО.ПустаяСсылка();
		
	ИначеЕсли ТипСообщенияДляЭмулятора = "ЗапросПлатежей" Тогда 
		
		ТекОбъект = Документы.ЗапросУНИФО.ПустаяСсылка();
		
	ИначеЕсли ТипСообщенияДляЭмулятора = "ЗапросРезультатаКвитирования" Тогда 
		
		ТекОбъект = Документы.ЗапросУНИФО.ПустаяСсылка();
		
	ИначеЕсли ТипСообщенияДляЭмулятора = "ЗапросНаКвитирование" Тогда 
		
		ТекОбъект = Документы.ЗапросУНИФО.ПустаяСсылка();
		
	ИначеЕсли ТипСообщенияДляЭмулятора = "ИмпортСертификата" Тогда
		
		ТекОбъект = Документы.ЗапросУНИФО.ПустаяСсылка();
		
	ИначеЕсли ТипСообщенияДляЭмулятора = "ЗапросНСИ" Тогда
		
		ТекОбъект = Документы.ЗапросУНИФО.ПустаяСсылка();
		
	ИначеЕсли ТипСообщенияДляЭмулятора = "ЗапросСозданияНачисления" Тогда
		
		ТекОбъект = Документы.НачислениеОтПосредникаГИСГМП.ПустаяСсылка();
		
	Иначе
		
		Текст = Нстр("ru='Неизвестный тип сообщения ""%1"" для обмена с эмулятором.'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,ТипСообщенияДляЭмулятора);

		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		
		ЕстьОшибки = Истина;
		Возврат "";
		
	КонецЕсли;
	
	Если ТекущийФорматЭмулятора = Неопределено Тогда
		НаименованиеФормата = "EMU_"+ТипСообщенияДляЭмулятора;
	    МассивФорматов = ПолучитьМассивФорматовДляЭмулятораВС(ВидОбмена,НаименованиеФормата);
		Если МассивФорматов.Количество() Тогда
			ФорматДляЭмулятора = МассивФорматов[0];
		Иначе
			ФорматДляЭмулятора = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
		КонецЕсли;
	Иначе
		ФорматДляЭмулятора = ТекущийФорматЭмулятора;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ФорматДляЭмулятора) Тогда
		ЕстьОшибки = Истина;
		Текст = Нстр("ru='Не найден формат экспорта с кодом ""%1"" для сообщения к эмулятору вида сведений.
			|Обновите форматы обмена.'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,НаименованиеФормата);

		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		
		Возврат "";
	КонецЕсли;
	
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Объект.Участник);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	
	ОбъектыОбмена = Новый ТаблицаЗначений;
	ОбъектыОбмена.Колонки.Добавить("ИмяФайлаВыгрузки");	   
	ОбъектыОбмена.Колонки.Добавить("Формат");    
	ОбъектыОбмена.Колонки.Добавить("Объект");   
	ОбъектыОбмена.Колонки.Добавить("ОписаниеОшибки");
	ОбъектыОбмена.Колонки.Добавить("Описание"); 
	ОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	НовСтр = ОбъектыОбмена.Добавить();
	НовСтр.Объект = ТекОбъект;
	НовСтр.Формат = ФорматДляЭмулятора;
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ОбъектыОбмена);
	
	ОбработкаФормирования = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	ОбработкаФормирования.ОбменСЭмулятором = ОбменСЭмулятором;
	ОбработкаФормирования.мОрганизация = Объект.Участник;
	ОбработкаФормирования.ИдентификаторСообщения = БиблиотекаФункцийОбмена.ПолучитьUUIDТекущегоВремени(Ложь);
	ОбработкаФормирования.СоответствиеОбработанныхФорматов = Неопределено;
	ОбработкаФормирования.СформироватьФайлы(СтруктураДляФормирования);
	
	СтрокаРезультата = СтруктураДляФормирования.ОбъектыОбмена[0].РезультатФормирования;
	
	ПозицияНачалаФайла = 1;
	Если Лев(СтрокаРезультата,2) = "<?" Тогда
		ПозицияНачалаФайла = СтрНайти(СтрокаРезультата,"?>")+2;
		СтрокаРезультата = СокрЛП(Сред(СтрокаРезультата,ПозицияНачалаФайла));
	КонецЕсли;
	
	Возврат СтрокаРезультата;
	
КонецФункции

&НаСервере
Функция ПолучитьМассивФорматовДляЭмулятораВС(ВидОбмена,НаименованиеФормата)
	НаименованиеВидаОбмена = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидОбмена,"Наименование"));
	
	МассивЧастейНаименования = СтрРазделить(НаименованиеВидаОбмена," ",Ложь);
	ВерсияВидаОбмена = МассивЧастейНаименования[МассивЧастейНаименования.Количество()-1];
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФорматыОбменаБанкиКС.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ФорматыОбменаБанкиКС КАК ФорматыОбменаБанкиКС
		|ГДЕ
		|	ФорматыОбменаБанкиКС.Владелец = &Владелец
		|	И ФорматыОбменаБанкиКС.НаправлениеОбмена = &НаправлениеОбмена
		|	И ФорматыОбменаБанкиКС.Наименование = &НаименованиеСВерсией
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФорматыОбменаБанкиКС.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ФорматыОбменаБанкиКС КАК ФорматыОбменаБанкиКС
		|ГДЕ
		|	ФорматыОбменаБанкиКС.Владелец = &Владелец
		|	И ФорматыОбменаБанкиКС.НаправлениеОбмена = &НаправлениеОбмена
		|	И ФорматыОбменаБанкиКС.Наименование = &НаименованиеБезВерсии";
	
	Запрос.УстановитьПараметр("Владелец", ВидОбмена);
	Запрос.УстановитьПараметр("НаправлениеОбмена", Перечисления.НаправлениеОбменаБанкиКС.Экспорт);
	Запрос.УстановитьПараметр("НаименованиеБезВерсии", НаименованиеФормата);
	Запрос.УстановитьПараметр("НаименованиеСВерсией", НаименованиеФормата+"_"+ВерсияВидаОбмена);
	
	Результаты = Запрос.ВыполнитьПакет();
	
	//В разных версиях вида сведения "Прием информации о погашении начисления, учете платежа" разное количество эталонных сценариев - от 1 до 4.
	//Поэтому сначала в запросе получаем форматы вида "EMU_ЗапросНаКвитирование_2.Х", где 2.Х берем из наименования вида обмена
	//если же таких форматов нет, то берем форматы вида "EMU_ЗапросНаКвитирование". 
	
	МассивФорматовДляЭмулятора = Новый Массив;
	
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивФорматовДляЭмулятора.Добавить(Выборка.Ссылка);	
	КонецЦикла;
	
	Если МассивФорматовДляЭмулятора.Количество() = 0 Тогда
		Выборка = Результаты[1].Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивФорматовДляЭмулятора.Добавить(Выборка.Ссылка);	
		КонецЦикла;	
	КонецЕсли;
	
	Возврат МассивФорматовДляЭмулятора;
КонецФункции

#КонецОбласти

#Область ЗапросСтатусаКвитированияНачислений

&НаКлиенте
Асинх Процедура ЗапроситьСтатус(Команда)
	
	ОчиститьСообщения();
	
	ТекстСообщения = Нстр("ru='Не отмечены документы.'");
	ОбновитьСписокОтмеченныхКвитанцийПоДаннымСпискаКвитанций();
	Если СписокОтмеченныеКвитанции.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","ЗапросУНИФО","SendRequestRequest_ЗД");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
			
	ТекущееДействие = "ЗапросСтатусаНачислений";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоЗапросамСтатусаНачислений(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
		
	МассивДокументов = СписокОтмеченныеКвитанции.ВыгрузитьЗначения();
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Ссылка КАК Ссылка,
		|	КвитанцияНаОплатуГосуслуг.Организация КАК Организация,
		|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления КАК УникальныйИдентификаторНачисления,
		|	КвитанцияНаОплатуГосуслуг.Предварительное КАК Предварительное
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивДокументов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеОтПодведомственного.Ссылка,
		|	НачислениеОтПодведомственного.Организация,
		|	НачислениеОтПодведомственного.УникальныйИдентификаторНачисления,
		|	НачислениеОтПодведомственного.Предварительное
		|ИЗ
		|	Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
		|ГДЕ
		|	НачислениеОтПодведомственного.Ссылка В(&МассивДокументов)
		|ИТОГИ ПО
		|	Организация,
		|	Предварительное";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
	
	//Размер пакета не может быть больше 100
	Если НЕ ЗначениеЗаполнено(НастройкиУчастника.РазмерПакетаНачислений) Тогда
		РазмерПакета = 50;
	Иначе
		РазмерПакета = Мин(НастройкиУчастника.РазмерПакетаНачислений,100); 
	КонецЕсли;
	
	ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	НомерТек = 1;
	
	ТипЗапроса = "CHARGESTATUS";
	
	ТекОрганизация = Неопределено;
	Пока ВыборкаОрганизация.Следующий() Цикл
			
		МассивДокументовЗапросов = Новый Массив;
		
		НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(ВыборкаОрганизация.Организация);
	    ТекОрганизация = ВыборкаОрганизация.Организация;
		
		//Размер пакета не может быть больше 100
		Если НЕ ЗначениеЗаполнено(НастройкиУчастника.РазмерПакетаНачислений) Тогда
			РазмерПакета = 50;
		Иначе
			РазмерПакета = Мин(НастройкиУчастника.РазмерПакетаНачислений,100); 
		КонецЕсли;
		
		ВыборкаТипНачисления = ВыборкаОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаТипНачисления.Следующий() Цикл
			
			Если ВыборкаТипНачисления.Предварительное = Ложь Тогда
				ТипЗапроса = "CHARGESTATUS";	
			Иначе
				ТипЗапроса = "CHARGE-PRIOR-STATUS";
			КонецЕсли;
					
			ДокументЗаписан = Истина;
					
			ВыборкаДетальныеЗаписи = ВыборкаТипНачисления.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Если ДокументЗаписан Тогда
					ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
					
					ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
					ДокументЗапрос.Организация 				= ВыборкаОрганизация.Организация;
									
					ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапроса;//МассивЗапросов[0];
					ДокументЗапрос.ТипИдентификатораДанных 	= "УИН";
					ДокументЗапрос.ТипУчастника 	= Перечисления.ТипыУчастниковГИСГМП.АН;
					
					ДокументЗапрос.СтраницаРезультата = 1;
					ДокументЗапрос.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
					
					ДокументЗаписан = Ложь;
				КонецЕсли;
				
				СтрокаДок = ДокументЗапрос.ЗапрашиваемыеДанные.Добавить();
				СтрокаДок.УИД = ВыборкаДетальныеЗаписи.УникальныйИдентификаторНачисления;
				СтрокаДок.Источник = ВыборкаДетальныеЗаписи.Ссылка;
				
				Если ДокументЗапрос.ЗапрашиваемыеДанные.Количество()>=РазмерПакета Тогда
					ДокументЗапрос.Записать();
					МассивДокументовЗапросов.Добавить(ДокументЗапрос.Ссылка);
					
					СтруктураРекв = Новый Структура;
					СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
					СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
					ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
					
					ДокументЗаписан = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ ДокументЗаписан Тогда
				ДокументЗапрос.Записать();
				МассивДокументовЗапросов.Добавить(ДокументЗапрос.Ссылка);
				
				СтруктураРекв = Новый Структура;
				СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
				СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
				ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
						
			КонецЕсли;
		
		КонецЦикла;
		
		НоваяСтруктураФормирования = Истина;
		
		Для Каждого ДокЗапроса Из МассивДокументовЗапросов Цикл
			
			Если НоваяСтруктураФормирования Тогда
				СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
				СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
				СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
				СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
				СтруктураДляФормирования.Вставить("Организация", ВыборкаОрганизация.Организация);
				СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
				//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
				
				ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
				ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
			
				НоваяСтруктураФормирования = Ложь;
			КонецЕсли;
			
			СтрокаОбмена = ТекОбъектыОбмена.Добавить();
			СтрокаОбмена.Объект = ДокЗапроса;
			СтрокаОбмена.Формат = ФорматЭкспорта;			
			
			Если ТекОбъектыОбмена.Количество()>100 Тогда
				СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);				
				МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
				НоваяСтруктураФормирования = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если НоваяСтруктураФормирования = Ложь Тогда
			//значит последняя структура не добавлена
			СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);			
			МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
		КонецЕсли;
			
	КонецЦикла;	
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);
		
	Если ОбменСЭмулятором Тогда
		
		ТекстЗапросаДляЭмулятора = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросСтатуса",ЕстьОшибки);
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			СтрТЧ.ОбменСЭмулятором = Истина;
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		КонецЦикла;
	КонецЕсли;
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));

КонецПроцедуры

#КонецОбласти

#Область ЗапросНаКвитированиеИОтменуКвитированияНачислений

&НаКлиенте
Асинх Процедура СквитироватьСПлатежами(Команда)
		
	ОчиститьСообщения();
	
	ТекстСообщения = Нстр("ru='Не выбраны документы с платежами для квитирования.'");
	ОбновитьСписокОтмеченныхКвитанцийПоДаннымСпискаКвитанций();
	
	мМассивНачисленийДляКвитирования = Новый Массив;
	Для Каждого СтрСписка Из СписокОтмеченныеКвитанции Цикл
		ТекДанные = Элементы.СписокКвитанций.ДанныеСтроки(СтрСписка.Значение);
		Если ТекДанные.ЕстьПлатеж Тогда
			мМассивНачисленийДляКвитирования.Добавить(ТекДанные.Квитанция);
		КонецЕсли;
	КонецЦикла;
	
	Если мМассивНачисленийДляКвитирования.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	МассивНачисленийДляКвитирования = Новый ФиксированныйМассив(мМассивНачисленийДляКвитирования);
		
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","ЗапросУНИФО","SendRequestRequest_ЗД");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);	
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущееДействие = "ЗапросНаКвитированиеСПлатежами";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоЗапросуКвитированияНачисленийСПлатежами(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	
	МассивДокументовПлатежей = СписокОтмеченныеПлатежиДляКвитирования.ВыгрузитьЗначения();
		
	Если ТипЗнч(МассивНачисленийДляКвитирования) = Тип("ФиксированныйМассив") Тогда
		МассивДокументов = Новый Массив(МассивНачисленийДляКвитирования);
	Иначе
		Возврат;
	КонецЕсли;
	
	МассивНачисленийДляКвитирования = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СоответствиеНачисленийИПлатежей.Начисление КАК Начисление,
				   |	СоответствиеНачисленийИПлатежей.Начисление.Организация КАК Организация,
				   |	СоответствиеНачисленийИПлатежей.Начисление.УникальныйИдентификаторНачисления КАК УИН,
	               |	СоответствиеНачисленийИПлатежей.Платеж КАК Источник,
	               |	СоответствиеНачисленийИПлатежей.Платеж.БанковскийИдентификаторПлатежа КАК УИД,
	               |	СоответствиеНачисленийИПлатежей.Платеж.СуммаДокумента КАК Сумма
	               |ИЗ
	               |	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
	               |ГДЕ
	               |	СоответствиеНачисленийИПлатежей.Начисление В (&МассивДокументов)
				   |	И СоответствиеНачисленийИПлатежей.Платеж В (&МассивПлатежей)
	               |	И СоответствиеНачисленийИПлатежей.Платеж.БанковскийИдентификаторПлатежаЗаполнен
	               |	И СоответствиеНачисленийИПлатежей.Платеж.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Начисление
	               |ИТОГИ ПО
				   |	Организация,
	               |	Начисление";
	
	Запрос.УстановитьПараметр("МассивДокументов",МассивДокументов);
	Запрос.УстановитьПараметр("МассивПлатежей",МассивДокументовПлатежей);
	
	Результат = Запрос.Выполнить();
	ВыборкаПоОрганизациям = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	ТипЗапроса = "DOACKNOWLEDGMENTREQUEST";
	
	Пока ВыборкаПоОрганизациям.Следующий() Цикл
		
		МассивДокументовЗапросов = Новый Массив;
		
		НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(ВыборкаПоОрганизациям.Организация);
		
		СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
		СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
		СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
		СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
		СтруктураДляФормирования.Вставить("Организация", ВыборкаПоОрганизациям.Организация);
		СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
		//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
		
		ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
		ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
						
		ВыборкаПоНачислениям = ВыборкаПоОрганизациям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

		Пока ВыборкаПоНачислениям.Следующий() Цикл
								
			ВыборкаТЧ = ВыборкаПоНачислениям.Выбрать();
			ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
			ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
			ДокументЗапрос.Организация 				= ВыборкаПоОрганизациям.Организация;
			//ДокументЗапрос.ДатаНачала 			= Объект.ДатаНачала;
			//ДокументЗапрос.ДатаОкончания 			= Объект.ДатаОкончания;
			ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапроса;
			ДокументЗапрос.ТипУчастника 	= Перечисления.ТипыУчастниковГИСГМП.АН;
			ДокументЗапрос.Начисление = ВыборкаПоНачислениям.Начисление;
			
			ДокументЗапрос.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
			
			Пока ВыборкаТЧ.Следующий() Цикл
						
				ЗаполнитьЗначенияСвойств(ДокументЗапрос.ЗапрашиваемыеДанные.Добавить(),ВыборкаТЧ);
							
			КонецЦикла;
			
			ДокументЗапрос.Записать(РежимЗаписиДокумента.Запись);
				
			СтруктураРекв = Новый Структура;
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
			СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
			СтрокаОбмена = ТекОбъектыОбмена.Добавить();
			СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
			СтрокаОбмена.Формат = ФорматЭкспорта;
								
		КонецЦикла;	
		
		СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
			
		МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
				
	КонецЦикла;
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);	
	
	Если ОбменСЭмулятором Тогда
		ТекстЗапросаДляЭмулятора = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросНаКвитирование",ЕстьОшибки);
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			СтрТЧ.ОбменСЭмулятором = Истина;
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		КонецЦикла;
	КонецЕсли;
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));

КонецПроцедуры

&НаКлиенте
Асинх Процедура СквитироватьБезПлатежа(Команда)
	ОчиститьСообщения();
	
	ТекстСообщения = Нстр("ru='Не выбраны документы без платежей для квитирования.'");
	ОбновитьСписокОтмеченныхКвитанцийПоДаннымСпискаКвитанций();
	
	мМассивНачисленийДляКвитирования = Новый Массив;
	
	Если ОбменСЭмулятором Тогда
		мМассивНачисленийДляКвитирования = СписокОтмеченныеКвитанции.ВыгрузитьЗначения();	
	Иначе
		//только без платежа
		Для Каждого СтрСписка Из СписокОтмеченныеКвитанции Цикл
			ТекДанные = Элементы.СписокКвитанций.ДанныеСтроки(СтрСписка.Значение);
			Если ТекДанные.ЕстьПлатеж = Ложь Тогда
				мМассивНачисленийДляКвитирования.Добавить(ТекДанные.Квитанция);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если мМассивНачисленийДляКвитирования.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	МассивНачисленийДляКвитирования = Новый ФиксированныйМассив(мМассивНачисленийДляКвитирования);
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","ЗапросУНИФО","SendRequestRequest_ЗД");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
		
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущееДействие = "ЗапросНаКвитированиеБезПлатежа";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоЗапросуКвитированияНачисленийБезПлатежа(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	
	Если ТипЗнч(МассивНачисленийДляКвитирования) = Тип("ФиксированныйМассив") Тогда
		МассивДокументов = Новый Массив(МассивНачисленийДляКвитирования);
	Иначе
		Возврат;
	КонецЕсли;
	
	МассивНачисленийДляКвитирования = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КвитанцияНаОплатуГосуслуг.Ссылка КАК Начисление,
	               |	КвитанцияНаОплатуГосуслуг.Организация КАК Организация
	               |ИЗ
	               |	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
	               |ГДЕ
	               |	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивНачислений)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НачислениеОтПодведомственного.Ссылка,
	               |	НачислениеОтПодведомственного.Организация
	               |ИЗ
	               |	Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
	               |ГДЕ
	               |	НачислениеОтПодведомственного.Ссылка В(&МассивНачислений)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Начисление
	               |ИТОГИ ПО
	               |	Организация
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	
	Запрос.УстановитьПараметр("МассивНачислений", МассивДокументов);
		
	Результат = Запрос.Выполнить();
	ВыборкаПоОрганизациям = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	ТипЗапроса = "DOACKNOWLEDGMENTREQUEST";
	
	Пока ВыборкаПоОрганизациям.Следующий() Цикл
		
		МассивДокументовЗапросов = Новый Массив;
		
		НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(ВыборкаПоОрганизациям.Организация);
		
		СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
		СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
		СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
		СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
		СтруктураДляФормирования.Вставить("Организация", ВыборкаПоОрганизациям.Организация);
		СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
		//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
		
		ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
		ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
						
		ВыборкаПоНачислениям = ВыборкаПоОрганизациям.Выбрать();

		Пока ВыборкаПоНачислениям.Следующий() Цикл
								
			ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
			ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
			ДокументЗапрос.Организация 				= ВыборкаПоОрганизациям.Организация;
			//ДокументЗапрос.ДатаНачала 			= Объект.ДатаНачала;
			//ДокументЗапрос.ДатаОкончания 			= Объект.ДатаОкончания;
			ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапроса;	
			ДокументЗапрос.Начисление = ВыборкаПоНачислениям.Начисление;
			ДокументЗапрос.ТипУчастника 	= Перечисления.ТипыУчастниковГИСГМП.АН;
			
			ДокументЗапрос.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
			
			ДокументЗапрос.КвитированиеБезПлатежа = Истина;
			
			ДокументЗапрос.Записать(РежимЗаписиДокумента.Запись);
				
			СтруктураРекв = Новый Структура;
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
			СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
			СтрокаОбмена = ТекОбъектыОбмена.Добавить();
			СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
			СтрокаОбмена.Формат = ФорматЭкспорта;
								
		КонецЦикла;	
		
		СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
			
		МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
				
	КонецЦикла;
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);	
	
	Если ОбменСЭмулятором Тогда
		ТекстЗапросаДляЭмулятора = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросНаКвитирование",ЕстьОшибки);
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			СтрТЧ.ОбменСЭмулятором = Истина;
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		КонецЦикла;
	КонецЕсли;
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));

КонецПроцедуры

&НаКлиенте
Асинх Процедура ОтменитьКвитированиеБезПлатежа(Команда)
	ОчиститьСообщения();
	
	ТекстСообщения = Нстр("ru='Не выбраны документы, сквитированные без платежей, для отмены квитирования.'");
	ОбновитьСписокОтмеченныхКвитанцийПоДаннымСпискаКвитанций();
	
	мМассивНачисленийДляКвитирования = Новый Массив;
	
	Если ОбменСЭмулятором Тогда
		мМассивНачисленийДляКвитирования = СписокОтмеченныеКвитанции.ВыгрузитьЗначения();	
	Иначе
		//только без платежа
		Для Каждого СтрСписка Из СписокОтмеченныеКвитанции Цикл
			ТекДанные = Элементы.СписокКвитанций.ДанныеСтроки(СтрСписка.Значение);
			Если ТекДанные.СтатусКвитирования = 4 Тогда //4-скв. без платежа, 5-скв. с платежом
				мМассивНачисленийДляКвитирования.Добавить(ТекДанные.Квитанция);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если мМассивНачисленийДляКвитирования.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	МассивНачисленийДляКвитирования = Новый ФиксированныйМассив(мМассивНачисленийДляКвитирования);
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","ЗапросУНИФО","SendRequestRequest_ЗД");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущееДействие = "ЗапросНаОтменуКвитированияБезПлатежа";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоЗапросуНаОтменуКвитированияНачисленийБезПлатежа(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	
	Если ТипЗнч(МассивНачисленийДляКвитирования) = Тип("ФиксированныйМассив") Тогда
		МассивДокументов = Новый Массив(МассивНачисленийДляКвитирования);
	Иначе
		Возврат;
	КонецЕсли;
	
	МассивНачисленийДляКвитирования = Неопределено;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка КАК Начисление,
		|	КвитанцияНаОплатуГосуслуг.Организация КАК Организация
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивДокументов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеОтПодведомственного.Ссылка,
		|	НачислениеОтПодведомственного.Организация
		|ИЗ
		|	Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
		|ГДЕ
		|	НачислениеОтПодведомственного.Ссылка В(&МассивДокументов)
		|ИТОГИ ПО
		|	Организация";
	
	Запрос.УстановитьПараметр("МассивДокументов",МассивДокументов);
	
	Результат = Запрос.Выполнить();
	ВыборкаПоОрганизациям = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	ТипЗапроса = "ANNULMENTRECONCILE"; //- аннулирование квитирования //"DOACKNOWLEDGMENTREQUEST" - квитирование;
	
	Пока ВыборкаПоОрганизациям.Следующий() Цикл
				
		НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(ВыборкаПоОрганизациям.Организация);
		
		СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
		СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
		СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
		СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
		СтруктураДляФормирования.Вставить("Организация", ВыборкаПоОрганизациям.Организация);
		СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
		//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
		
		ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
		ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
						
		ВыборкаПоНачислениям = ВыборкаПоОрганизациям.Выбрать();

		Пока ВыборкаПоНачислениям.Следующий() Цикл
								
			ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
			ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
			ДокументЗапрос.Организация 				= ВыборкаПоОрганизациям.Организация;
			//ДокументЗапрос.ДатаНачала 			= Объект.ДатаНачала;
			//ДокументЗапрос.ДатаОкончания 			= Объект.ДатаОкончания;
			ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапроса;	
			ДокументЗапрос.Начисление = ВыборкаПоНачислениям.Начисление;
			ДокументЗапрос.ТипУчастника 	= Перечисления.ТипыУчастниковГИСГМП.АН;
			
			ДокументЗапрос.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
			
			ДокументЗапрос.КвитированиеБезПлатежа = Истина;
			
			ДокументЗапрос.Записать(РежимЗаписиДокумента.Запись);
				
			СтруктураРекв = Новый Структура;
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
			СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
			СтрокаОбмена = ТекОбъектыОбмена.Добавить();
			СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
			СтрокаОбмена.Формат = ФорматЭкспорта;
								
		КонецЦикла;	
		
		СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
			
		МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
				
	КонецЦикла;
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);	
	
	Если ОбменСЭмулятором Тогда
		ТекстЗапросаДляЭмулятора = "";
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			СтрТЧ.ОбменСЭмулятором = Истина;
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		КонецЦикла;
	КонецЕсли;
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));

КонецПроцедуры

&НаКлиенте
Асинх Процедура ОтменитьКвитированиеСПлатежами(Команда)
	
	ОчиститьСообщения();
	
	ТекДанные = Элементы.СписокКвитанций.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ТекущаяКвитанция = Неопределено;
	Иначе
		ТекущаяКвитанция = ТекДанные.Квитанция;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяКвитанция) Тогда
		ТекстСообщения = Нстр("ru='Не выбрано начисление для отмены квитирования с платежами.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","ЗапросУНИФО","SendRequestRequest_ЗД");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	СтруктураОтбора = Новый Структура("Использовать",Истина);
	ТекстСообщения = Нстр("ru='Не отмечены платежи для отмены квитирования с начислением.'");
	
	Если ПроверитьВозможностьФормированияПоПараметрам("ТаблицаПлатежиДляОтменыКвитирования",МассивСтруктурФорматов,СтруктураОтбора,ТекстСообщения) = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущееДействие = "ЗапросНаОтменуКвитированияСПлатежами";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоЗапросуНаОтменуКвитированияНачисленийСПлатежами(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
						
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	ТипЗапроса = "ANNULMENTRECONCILE"; //- аннулирование квитирования //"DOACKNOWLEDGMENTREQUEST" - квитирование;
	
	ТекОрг = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяКвитанция,"Организация");
				
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(ТекОрг);
	
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", ТекОрг);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
		
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
							
	ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
	ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
	ДокументЗапрос.Организация 				= ТекОрг;
	//ДокументЗапрос.ДатаНачала 			= Объект.ДатаНачала;
	//ДокументЗапрос.ДатаОкончания 			= Объект.ДатаОкончания;
	ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапроса;	
	ДокументЗапрос.Начисление = ТекущаяКвитанция;
	ДокументЗапрос.ТипУчастника 	= Перечисления.ТипыУчастниковГИСГМП.АН;
	ДокументЗапрос.ОставлятьРаспределенныеПлатежи = ОставлятьРаспределенныеПлатежи;
	ДокументЗапрос.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
		
	МассивСтрок = ТаблицаПлатежиДляОтменыКвитирования.НайтиСтроки(Новый Структура("Использовать",Истина));
	Для Каждого СтрПлат Из МассивСтрок Цикл
		НовСтр = ДокументЗапрос.ЗапрашиваемыеДанные.Добавить();
		НовСтр.Источник = СтрПлат.ПлатежСсылка;
		НовСтр.УИД = СтрПлат.УИП;
		НовСтр.Сумма = СтрПлат.Сумма;
	КонецЦикла;
	
	ДокументЗапрос.Записать(РежимЗаписиДокумента.Запись);
		
	СтруктураРекв = Новый Структура;
	СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
	СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
	
	СтрокаОбмена = ТекОбъектыОбмена.Добавить();
	СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
	СтрокаОбмена.Формат = ФорматЭкспорта;
									
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
	
	МассивСтруктурФормированияФайлов = Новый Массив;
	МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);
	
	Если ОбменСЭмулятором Тогда
		ТекстЗапросаДляЭмулятора = "";
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			СтрТЧ.ОбменСЭмулятором = Истина;
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		КонецЦикла;
	КонецЕсли;
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));

КонецПроцедуры

&НаКлиенте
Процедура СквитироватьБезПлатежаНаСумму(Команда)
	ОчиститьСообщения();
	
	СуммаЧастичногоКвитирования = 0;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","ЗапросУНИФО","SendRequestRequest_ЗД");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	ТекДанные = Элементы.СписокКвитанций.ТекущиеДанные;
	Отказ = Ложь;
	
	Если ТекДанные = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ = Истина Тогда
		ТекстСообщения = Нстр("ru='Выделите начисление для квитирования с указанием суммы.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
		
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов,,ТекстСообщения) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	//тут открытваем форму где показываем начисление с суммой и указываем сумму для квитирования
	ОписаниеОп = Новый ОписаниеОповещения("ПослеУказанияСуммы",ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Начисление",ТекущаяКвитанция);
	
	ОткрытьФорму("Обработка.ОбменГИСГМП2.Форма.ФормаПараметровЧастичногоКвитирования",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПослеУказанияСуммы(Результат,ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Результат.Свойство("СуммаЧастичногоКвитирования",СуммаЧастичногоКвитирования);
	Если НЕ ЗначениеЗаполнено(СуммаЧастичногоКвитирования) Тогда
		Возврат;
	КонецЕсли;
	//после того как указали сумму для квитирования, стандарная процедура
	
	ТекущееДействие = "ЗапросНаКвитированиеБезПлатежаСУказаниемСуммы";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоЗапросуКвитированияНачисленийБезПлатежаСУказаниемСуммы(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
				
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	ТипЗапроса = "DOACKNOWLEDGMENTREQUEST";
	
	РевизитыВозврата = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущаяКвитанция,"Организация,УникальныйИдентификаторНачисления,СуммаДокумента");
	
	Организация = РевизитыВозврата.Организация;
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Организация);
	
	ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
	ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
	ДокументЗапрос.Организация 				= Организация;
	//ДокументЗапрос.ДатаНачала 			= Объект.ДатаНачала;
	//ДокументЗапрос.ДатаОкончания 			= Объект.ДатаОкончания;
	ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапроса;	
	ДокументЗапрос.Начисление = ТекущаяКвитанция;
	ДокументЗапрос.ТипУчастника 	= Перечисления.ТипыУчастниковГИСГМП.АН;
	
	ДокументЗапрос.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
	
	ДокументЗапрос.КвитированиеБезПлатежа = Истина;
	ДокументЗапрос.СуммаЧастичногоКвитирования = СуммаЧастичногоКвитирования;
	
	ДокументЗапрос.Записать(РежимЗаписиДокумента.Запись);
		
	СтруктураРекв = Новый Структура;
	СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
	СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
		
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Организация);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
		
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
						
	СтрокаОбмена = ТекОбъектыОбмена.Добавить();
	СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
	СтрокаОбмена.Формат = ФорматЭкспорта;
									
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
			
	МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
					
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);	
	
	Если ОбменСЭмулятором Тогда
		ТекстЗапросаДляЭмулятора = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросНаКвитирование",ЕстьОшибки);
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			СтрТЧ.ОбменСЭмулятором = Истина;
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		КонецЦикла;
	КонецЕсли;
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));

КонецПроцедуры

#КонецОбласти

#Область Квитирование_ВыполнитьОбменСЭмулятором

&НаКлиенте
Асинх Процедура Квитирование_ВыполнитьОбменСЭмулятором(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(ТекущаяКвитанция) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбрано начисление для обмена с эмулятором вида сведений.'"));
		Возврат;
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","ЗапросУНИФО","SendRequestRequest_ЗД");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
			
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущееДействие = "Квитирование_ВыполнитьОбменСЭмулятором";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоЗапросуКвитированияСЭмулятором(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
		
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	ТипЗапроса = "EMU_DOACKNOWLEDGMENTREQUEST"; //для обмена с эмулятором;
	
	ТекОрг = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяКвитанция,"Организация");
				
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(ТекОрг);
	
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", ТекОрг);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
		
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
							
	ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
	ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
	ДокументЗапрос.Организация 				= ТекОрг;
	//ДокументЗапрос.ДатаНачала 			= Объект.ДатаНачала;
	//ДокументЗапрос.ДатаОкончания 			= Объект.ДатаОкончания;
	ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапроса;	
	ДокументЗапрос.Начисление = ТекущаяКвитанция;
	ДокументЗапрос.ТипУчастника 	= Перечисления.ТипыУчастниковГИСГМП.АН;
	
	ДокументЗапрос.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
	
	ДокументЗапрос.Записать(РежимЗаписиДокумента.Запись);
		
	СтруктураРекв = Новый Структура;
	СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
	СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
	
	МассивФорматовДляЭмулятора = ПолучитьМассивФорматовДляЭмулятораВС(НастройкиУчастника.ВидОбмена,"EMU_ЗапросНаКвитирование");
	
	МассивТекстовДляЭмулятора = Новый Массив;
	Для Каждого ТекФорматЭмулятора Из МассивФорматовДляЭмулятора Цикл	
		МассивТекстовДляЭмулятора.Добавить(ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросНаКвитирование",ЕстьОшибки,ТекФорматЭмулятора));
	КонецЦикла;
	
	//необходимо сформировать 4 сообщения с разными идентификаторами
	Для Инд = 1 По МассивТекстовДляЭмулятора.Количество() Цикл
		СтрокаОбмена = ТекОбъектыОбмена.Добавить();
		СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
		СтрокаОбмена.Формат = ФорматЭкспорта;
	КонецЦикла;
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
	
	МассивСтруктурФормированияФайлов = Новый Массив;
	МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);
		
	Инд = 0;
	КолТЭ = МассивТекстовДляЭмулятора.Количество();
	Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
		Если Инд < КолТЭ Тогда
			ТекстЗапросаДляЭмулятора = МассивТекстовДляЭмулятора[Инд];
		Иначе
			ТекстЗапросаДляЭмулятора = "";
		КонецЕсли;
		СтрТЧ.ОбменСЭмулятором = Истина;
		СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
		СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		Инд = Инд + 1;
	КонецЦикла;	
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));

КонецПроцедуры

#КонецОбласти

#Область ЗапросПлатежей

&НаКлиенте
Асинх Процедура ЗапроситьПлатежиПоНачислению(Команда)
	
	ОчиститьСообщения();
	
	ТекстСообщения = Нстр("ru='Не отмечены документы для котрых необходимо выполинть запрос оплаты.'");
	
	ОбновитьСписокОтмеченныхКвитанцийПоДаннымСпискаКвитанций();
	Если СписокОтмеченныеКвитанции.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","МассивФорматовЭкспорта","ЗапросУНИФО","SendRequestRequest_ЗД");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
			
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущееДействие = "ЗапросПлатежейПоНачислению";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЗапросПлатежейПоНачислению(ЕстьОшибки)
	
	РезультатФормирования.Очистить();         
	ФайлыРезультатаФормирования.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
		
	МассивДокументов = СписокОтмеченныеКвитанции.ВыгрузитьЗначения();
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка КАК Ссылка,
		|	КвитанцияНаОплатуГосуслуг.Организация КАК Организация,
		|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления КАК УникальныйИдентификаторНачисления
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивДокументов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеОтПодведомственного.Ссылка,
		|	НачислениеОтПодведомственного.Организация,
		|	НачислениеОтПодведомственного.УникальныйИдентификаторНачисления
		|ИЗ
		|	Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
		|ГДЕ
		|	НачислениеОтПодведомственного.Ссылка В(&МассивДокументов)
		|ИТОГИ ПО
		|	Организация";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
	
	//Размер пакета не может быть больше 100
	Если НЕ ЗначениеЗаполнено(НастройкиУчастника.РазмерПакетаНачислений) Тогда
		РазмерПакета = 50;
	Иначе
		РазмерПакета = Мин(НастройкиУчастника.РазмерПакетаНачислений,100); 
	КонецЕсли;
	
	ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	НомерТек = 1;
	
	ВидПлатежей = "PAYMENT";
	МассивТиповЗапроса = СтрРазделить(ВидПлатежей,",");
	
	ТипЗапроса = МассивТиповЗапроса[0];
	Пока ВыборкаОрганизация.Следующий() Цикл
		
		МассивДокументовЗапросов = Новый Массив;
		
		НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(ВыборкаОрганизация.Организация);
	
		//Размер пакета не может быть больше 100
		Если НЕ ЗначениеЗаполнено(НастройкиУчастника.РазмерПакетаНачислений) Тогда
			РазмерПакета = 50;
		Иначе
			РазмерПакета = Мин(НастройкиУчастника.РазмерПакетаНачислений,100); 
		КонецЕсли;
	
		ВыборкаДетальныеЗаписи = ВыборкаОрганизация.Выбрать();
		
		ДокументЗаписан = Истина;
				
		ВыборкаДетальныеЗаписи = ВыборкаОрганизация.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ДокументЗаписан Тогда
				ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
				
				ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
				ДокументЗапрос.Организация 				= ВыборкаОрганизация.Организация;
				
				ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапроса;//МассивЗапросов[0];
				ДокументЗапрос.ТипИдентификатораДанных 	= "УИН";
				ДокументЗапрос.ТипУчастника 	= Перечисления.ТипыУчастниковГИСГМП.АН;
				
				ДокументЗапрос.СтраницаРезультата = 1;
				ДокументЗапрос.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
				
				ДокументЗаписан = Ложь;
			КонецЕсли;
			
			СтрокаДок = ДокументЗапрос.ЗапрашиваемыеДанные.Добавить();
			СтрокаДок.УИД = ВыборкаДетальныеЗаписи.УникальныйИдентификаторНачисления;
			СтрокаДок.Источник = ВыборкаДетальныеЗаписи.Ссылка; 
			
			Если ДокументЗапрос.ЗапрашиваемыеДанные.Количество()>=РазмерПакета Тогда
				ДокументЗапрос.Записать();
				
				МассивДокументовЗапросов.Добавить(ДокументЗапрос.Ссылка);
				
				СтруктураРекв = Новый Структура;
				СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
				СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
				ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
				
				ДокументЗаписан = Истина;
				
				Если МассивТиповЗапроса.Количество()>1 Тогда
					Для Инд = 1 По МассивТиповЗапроса.Количество()-1 Цикл
						ТекТипЗапроса = МассивТиповЗапроса[Инд];
						ДокЗапроса = ДокументЗапрос.Скопировать();
						ДокЗапроса.Дата = ТекущаяДатаСеанса();
						ДокЗапроса.ТипЗапрашиваемыхДанных = ТекТипЗапроса;
						
						ДокЗапроса.Записать();
				
						МассивДокументовЗапросов.Добавить(ДокЗапроса.Ссылка);
						
						СтруктураРекв = Новый Структура;
						СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокЗапроса.Ссылка);
						СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
						ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
				
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ДокументЗаписан Тогда
			ДокументЗапрос.Записать();
			МассивДокументовЗапросов.Добавить(ДокументЗапрос.Ссылка);
			
			СтруктураРекв = Новый Структура;
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
			СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
			Если МассивТиповЗапроса.Количество()>1 Тогда
				Для Инд = 1 По МассивТиповЗапроса.Количество()-1 Цикл
					ТекТипЗапроса = МассивТиповЗапроса[Инд];
					ДокЗапроса = ДокументЗапрос.Скопировать();
					ДокЗапроса.Дата = ТекущаяДатаСеанса();
					ДокЗапроса.ТипЗапрашиваемыхДанных = ТекТипЗапроса;
					
					ДокЗапроса.Записать();
			
					МассивДокументовЗапросов.Добавить(ДокЗапроса.Ссылка);
					
					СтруктураРекв = Новый Структура;
					СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокЗапроса.Ссылка);
					СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
					ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
				КонецЦикла;
			КонецЕсли;
				
		КонецЕсли;
		
		
		НоваяСтруктураФормирования = Истина;
		Для Каждого ДокЗапроса Из МассивДокументовЗапросов Цикл
			
			Если НоваяСтруктураФормирования Тогда
				СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
				СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
				СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
				СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
				СтруктураДляФормирования.Вставить("Организация", ВыборкаОрганизация.Организация);
				СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
				//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
				
				ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
				ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
				
				НоваяСтруктураФормирования = Ложь;
			КонецЕсли;
			
			Для Каждого ТекФормат Из МассивФорматовЭкспорта Цикл
				СтрокаОбмена = ТекОбъектыОбмена.Добавить();
				СтрокаОбмена.Объект = ДокЗапроса;
				СтрокаОбмена.Формат = ТекФормат;
			КонецЦикла;
			
			Если ТекОбъектыОбмена.Количество()>100 Тогда
				//разделим формируемые объекты на порции, по 100 шт, +-несколько - норма
				
				СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);				
				МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
				
				НоваяСтруктураФормирования = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если НоваяСтруктураФормирования = Ложь Тогда
			//значит последняя структура не добавлена
			
			СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);			
			МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
		КонецЕсли;
		
			
	КонецЦикла;	
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);
	
	Если ОбменСЭмулятором Тогда
		ТекстЗапросаДляЭмулятора = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросПлатежей",ЕстьОшибки);
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			СтрТЧ.ОбменСЭмулятором = Истина;
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		КонецЦикла;
	КонецЕсли;
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, Новый Массив(МассивФорматовЭкспорта)));

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьПлатежиЗаПериод(Команда)
	ОчиститьСообщения();
	
	Если ИспользоватьОчередьЗапросовГИСГМП Тогда
		ИмяФормата = "SendRequestRequest_NewQuery";
		ИмяРеквизита = "МассивФорматовОчереди";
	Иначе
		ИмяФормата = "SendRequestRequest_ЗД";
		ИмяРеквизита = "МассивФорматовЭкспорта";
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
		
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата",ИмяРеквизита,"ЗапросУНИФО",ИмяФормата);
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
		
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	 
	ПараметрыФормы.Вставить("КоличествоЧасов",КоличествоЧасов);
	ПараметрыФормы.Вставить("ПериодЗапросаПлатежей",ПериодЗапросаПлатежей);
	ПараметрыФормы.Вставить("Участник",Объект.Участник);
	
	Если ОбменРНИП_УНП 
		ИЛИ ЭтоБазаГАН = Ложь
		ИЛИ ТаблицаУчастников.Количество() = 1 Тогда
		ПараметрыФормы.Вставить("НуженОтборУчастников",Ложь);
	Иначе
		ПараметрыФормы.Вставить("НуженОтборУчастников",Истина);
		ПараметрыФормы.Вставить("АдресТаблицыУчастников",ПолучитьАдресТаблицыУчастников());
	КонецЕсли;
	
	ОписаниеОп = Новый ОписаниеОповещения("ПослеВыбораПараметровЗапросаПлатежей",ЭтотОбъект);
	ОткрытьФорму("Обработка.ОбменГИСГМП2.Форма.ФормаПараметрыЗапросаПлатежей",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТаблицыУчастников()
	Возврат ПоместитьВоВременноеХранилище(ТаблицаУчастников.Выгрузить(),УникальныйИдентификатор);	
КонецФункции

&НаКлиенте
Асинх Процедура ПослеВыбораПараметровЗапросаПлатежей(Результат,ДопПараметры)Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,Результат,"КоличествоЧасов,ПериодЗапросаПлатежей,ВидПлатежей");
		
	//Если массив участников пустой - может тогда всегда передавать только текущего участника?
	ТекМассив = Результат.МассивУчастников;
	Если ТекМассив.Количество() = 0 Тогда
		ТекМассив.Добавить(Объект.Участник);
	КонецЕсли;
	//
	мМассивУчастников = Новый ФиксированныйМассив(Результат.МассивУчастников);
	
	ТекущееДействие = "ЗапросПлатежейЗаПериод";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЗапросПлатежейЗаПериод(ЕстьОшибки, ПродолжениеНеТребуется)
	
	РезультатФормирования.Очистить();         
	ФайлыРезультатаФормирования.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	
	Если Не ЗначениеЗаполнено(ВидПлатежей) Тогда
		ВидПлатежей = "PAYMENT";
	КонецЕсли;
	МассивТиповЗапроса = СтрРазделить(ВидПлатежей,",");
	
	ТипЗапроса = МассивТиповЗапроса[0];
	
	МассивДокументовЗапросов = Новый Массив;
		
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
	
	ТекДатаНачала = ПериодЗапросаПлатежей.ДатаНачала;
	КонечнаяДата = КонецДня(ПериодЗапросаПлатежей.ДатаОкончания);
	
	Если КоличествоЧасов = 0 Тогда
		ТекДатаОкончания = КонечнаяДата;
	Иначе
		ТекДатаОкончания = ТекДатаНачала + 3600*КоличествоЧасов-1;
		ТекДатаОкончания = Мин(ТекДатаОкончания,КонечнаяДата);
	КонецЕсли;
			
	Если ИспользоватьОчередьЗапросовГИСГМП Тогда
		//создать запись общего запроса к ГИС ГМП - регистр нужен для просмотра пользователями в списке существующих запросов к сервису
		ТипИдентификатораДанных = "НЕТ";//без отбора по идентификаторам
		ТипУчастникаГИСГМП = Перечисления.ТипыУчастниковГИСГМП.АН;
		СтруктураПараметров = ГосУслуги.ПараметрыДляФормированияЗаписейРегистровЗапросаКГИСГМП(ПериодЗапросаПлатежей.ДатаНачала,
			ПериодЗапросаПлатежей.ДатаОкончания,КоличествоЧасов,ТипЗапроса,ТипИдентификатораДанных,ТипУчастникаГИСГМП);
			
		СтруктураПараметров.МассивУчастников = Новый Массив(мМассивУчастников);	
			
		ОшибкаСозданияЗапроса = Ложь;
		ТекстОшибки = "";
		ГосУслуги.СформироватьЗаписиРегистровЗапросаКГИСГМП(Объект.Участник, СтруктураПараметров, МассивФорматовОчереди,ОшибкаСозданияЗапроса,ТекстОшибки);	
		
		Если ОшибкаСозданияЗапроса Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки); 
			Возврат;
		Иначе
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Запрос добавлен в очередь запросов к сервису'"));	
		КонецЕсли;
		
		ПродолжениеНеТребуется = Истина;
	Иначе
		
		КоличествоУч = мМассивУчастников.Количество();
		
		ЦикловУч = 0;
		//максимальное количество участников в отборе - 10
		Если КоличествоУч >0 Тогда	
			Если КоличествоУч/10 = Цел(КоличествоУч/10) Тогда
				ЦикловУч = КоличествоУч/10-1;
			Иначе
				ЦикловУч = КоличествоУч/10;
			КонецЕсли;
		КонецЕсли;
		
		Пока ТекДатаНачала<КонечнаяДата Цикл
			
			Для ТекЦиклУч = 0 По ЦикловУч Цикл
			
				ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
				ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
				ДокументЗапрос.Организация 				= Объект.Участник;
				ДокументЗапрос.ТипЗапрашиваемыхДанных 	= МассивТиповЗапроса[0];
				ДокументЗапрос.ТипИдентификатораДанных 	= "НЕТ";
				ДокументЗапрос.ДатаНачала				= ТекДатаНачала;
				ДокументЗапрос.ДатаОкончания			= ТекДатаОкончания;
				ДокументЗапрос.ТипУчастника 	= Перечисления.ТипыУчастниковГИСГМП.АН;
				ДокументЗапрос.СтраницаРезультата = 1;
				ДокументЗапрос.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
							
				Для Инд = ТекЦиклУч*10 По ТекЦиклУч*10 + 9  Цикл
					Если КоличествоУч>Инд Тогда
						СтрУч = ДокументЗапрос.Участники.Добавить();
						СтрУч.Участник = мМассивУчастников[Инд];
					Иначе
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				ДокументЗапрос.Записать();
				
				СтруктураРекв = Новый Структура;
				СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
				СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
				ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
				
				МассивДокументовЗапросов.Добавить(ДокументЗапрос.Ссылка);
				
				Для Инд = 1 По МассивТиповЗапроса.Количество()-1 Цикл
					КопияЗапроса = ДокументЗапрос.Скопировать();
					КопияЗапроса.Дата = ТекущаяДатаСеанса();
					КопияЗапроса.ТипЗапрашиваемыхДанных = МассивТиповЗапроса[Инд];
					КопияЗапроса.Записать();
					
					СтруктураРекв = Новый Структура;
					СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",КопияЗапроса.Ссылка);
					СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
					ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
					
					МассивДокументовЗапросов.Добавить(КопияЗапроса.Ссылка);
					
				КонецЦикла;
			КонецЦикла;
			
			ТекДатаНачала = ТекДатаОкончания+1;
			
			ТекДатаОкончания = ТекДатаНачала + 3600*КоличествоЧасов-1;
			ТекДатаОкончания = Мин(ТекДатаОкончания,КонечнаяДата);
		КонецЦикла;
		
		МассивСтруктурФормированияФайлов = Новый Массив;
		ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
		
		мМассивУчастников = Неопределено;
		
		НоваяСтруктураФормирования = Истина;
		Для Каждого ДокЗапроса Из МассивДокументовЗапросов Цикл
			
			Если НоваяСтруктураФормирования Тогда
				СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
				СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
				СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
				СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
				СтруктураДляФормирования.Вставить("Организация", Объект.Участник);
				СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
				//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
				
				ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
				ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
				
				НоваяСтруктураФормирования = Ложь;
			КонецЕсли;
			
			Для Каждого ТекФормат Из МассивФорматовЭкспорта Цикл
				СтрокаОбмена = ТекОбъектыОбмена.Добавить();
				СтрокаОбмена.Объект = ДокЗапроса;
				СтрокаОбмена.Формат = ТекФормат;
			КонецЦикла;
			
			Если ТекОбъектыОбмена.Количество()>100 Тогда
				//разделим формируемые объекты на порции, по 100 шт, +-несколько - норма
				
				СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);				
				МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
				
				НоваяСтруктураФормирования = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если НоваяСтруктураФормирования = Ложь Тогда
			//значит последняя структура не добавлена
			
			СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);			
			МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
		КонецЕсли;
					
		СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);
		
		Если ОбменСЭмулятором Тогда
			ТекстЗапросаДляЭмулятора = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросПлатежей",ЕстьОшибки);
			Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
				СтрТЧ.ОбменСЭмулятором = Истина;
				СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
				СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
			КонецЦикла;
		КонецЕсли;
		
		//Заполним настройку заголовков
		СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, Новый Массив(МассивФорматовЭкспорта)));

	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

#Область ЗапросВозврата

&НаКлиенте
Асинх Процедура ЗапроситьВозврат(Команда)
	
	ОчиститьСообщения();
	
	ТекДанные = Элементы.СписокВозвратов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ТекущийВозврат = Неопределено;
	Иначе
		ТекущийВозврат = ТекДанные.ДокСсылка;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущийВозврат) Тогда
		ТекстСообщения = Нстр("ru='Не выбран возврат для запроса из сервиса.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","МассивФорматовЭкспорта","ЗапросУНИФО","SendRequestRequest_ЗД");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
		
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущееДействие = "ЗапросВозврата";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();

КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоЗапросуВозвратов(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
		
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
		
	ТипЗапроса = "REFUND";
	
	РевизитыВозврата = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущийВозврат,"Организация,УИВ,СуммаДокумента");
	
	Организация = РевизитыВозврата.Организация;
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Организация);
	
	ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
	
	ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
	ДокументЗапрос.Организация 				= Организация;
	
	ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапроса;//МассивЗапросов[0];
	ДокументЗапрос.ТипИдентификатораДанных 	= "УИВ";
	ДокументЗапрос.ТипУчастника 	= Перечисления.ТипыУчастниковГИСГМП.АН;
	
	ДокументЗапрос.СтраницаРезультата = 1;
	ДокументЗапрос.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
						
	СтрокаДок = ДокументЗапрос.ЗапрашиваемыеДанные.Добавить();
	СтрокаДок.УИД = РевизитыВозврата.УИВ;
	СтрокаДок.Источник = ТекущийВозврат;
	СтрокаДок.Сумма = РевизитыВозврата.СуммаДокумента;
			
	ДокументЗапрос.Записать();
	
	ДокЗапроса = ДокументЗапрос.Ссылка;
	
	СтруктураРекв = Новый Структура;
	СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокЗапроса);
	СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
							
		
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Организация);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);

	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	Для Каждого ТекФормат Из МассивФорматовЭкспорта Цикл
		СтрокаОбмена = ТекОбъектыОбмена.Добавить();
		СтрокаОбмена.Объект = ДокЗапроса;
		СтрокаОбмена.Формат = ТекФормат;			
			
	КонецЦикла;
		
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);			
	МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
		
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);
	
	Если ОбменСЭмулятором Тогда
		ТекстЗапросаДляЭмулятора = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросВозврата",ЕстьОшибки);
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			СтрТЧ.ОбменСЭмулятором = Истина;
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		КонецЦикла;
	КонецЕсли;
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, МассивФорматовЭкспорта));

КонецПроцедуры

#КонецОбласти

#Область ЗапросРезультатаКвитирования

&НаКлиенте
Асинх Процедура ЗапроситьКвитанции(Команда)
	
	ОчиститьСообщения();
	
	ТекДанные = Элементы.СписокКвитанций.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ТекущаяКвитанция = Неопределено;
	Иначе
		ТекущаяКвитанция = ТекДанные.Квитанция;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяКвитанция) Тогда
		ТекстСообщения = Нстр("ru='Не выбрано начисление для запроса квитанций из сервиса.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","МассивФорматовЭкспорта","ЗапросУНИФО","SendRequestRequest_ЗД");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
		
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущееДействие = "ЗапросКвитанций";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоЗапросуКвитанций(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
		
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
		
	ТипЗапроса = "QUITTANCE";
	
	РевизитыВозврата = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущаяКвитанция,"Организация,УникальныйИдентификаторНачисления,СуммаДокумента");
	
	Организация = РевизитыВозврата.Организация;
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Организация);
	
	ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
	
	ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
	ДокументЗапрос.Организация 				= Организация;
	
	ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапроса;//МассивЗапросов[0];
	ДокументЗапрос.ТипИдентификатораДанных 	= "УИН";
	ДокументЗапрос.ТипУчастника 	= Перечисления.ТипыУчастниковГИСГМП.АН;
	
	ДокументЗапрос.СтраницаРезультата = 1;
	ДокументЗапрос.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
						
	СтрокаДок = ДокументЗапрос.ЗапрашиваемыеДанные.Добавить();
	СтрокаДок.УИД = РевизитыВозврата.УникальныйИдентификаторНачисления;
	СтрокаДок.Источник = ТекущаяКвитанция;
	СтрокаДок.Сумма = РевизитыВозврата.СуммаДокумента;
			
	ДокументЗапрос.Записать();
	
	ДокЗапроса = ДокументЗапрос.Ссылка;
	
	СтруктураРекв = Новый Структура;
	СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокЗапроса);
	СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
							
		
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Организация);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);

	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	Для Каждого ТекФормат Из МассивФорматовЭкспорта Цикл
		СтрокаОбмена = ТекОбъектыОбмена.Добавить();
		СтрокаОбмена.Объект = ДокЗапроса;
		СтрокаОбмена.Формат = ТекФормат;			
			
	КонецЦикла;
		
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);			
	МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
		
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);
	
	Если ОбменСЭмулятором Тогда
		ТекстЗапросаДляЭмулятора = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросРезультатаКвитирования",ЕстьОшибки);
		Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
			СтрТЧ.ОбменСЭмулятором = Истина;
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
			СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
		КонецЦикла;
	КонецЕсли;
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, МассивФорматовЭкспорта));

КонецПроцедуры

#КонецОбласти

#Область ЗапросДанныхИзОчередиСМЭВ

&НаКлиенте
Асинх Процедура ЗапроситьДанныеИзОчередиОтветов(Команда)
	
	ОчиститьСообщения();
	
	//"GetResponseRequest" - запрос результатов из очереди как потребителя
	//"GetRequestRequest" - запрос запросов из очереди как поставщика
	МассивСтруктурФорматов = Новый Массив;
	                 
	НужныеИменаФорматов = "GetResponseRequest,GetRequestRequest"; 
	Если ОбменСЭмулятором Тогда
		//формат EMU_GetResponseRequest - используется только для запроса ответа от эмулятора и в реальном обмене не применяется
		НужныеИменаФорматов = НужныеИменаФорматов + ",EMU_GetResponseRequest";
	КонецЕсли;	
	МассивНужныхИменФорматов = СтрРазделить(НужныеИменаФорматов,",",Ложь);
	
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","МассивФорматовЗапросаРезультатов","ЗапросУНИФО",МассивНужныхИменФорматов);
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматПодтверждения","ЗапросУНИФО","AckRequest");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
		
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееДействие = "ЗапроситьДанныеИзОчередиОтветов";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
	
	НеобходимоЕщеРазЗапроситьОчередь = Ложь;
	
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗапроситьДанныеИзОчередиСтатусов(Команда)
	//Очередь статусов не используется
	ОчиститьСообщения();
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","МассивФорматовЭкспорта","ЗапросУНИФО","GetStatusRequest");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматПодтверждения","ЗапросУНИФО","AckRequest");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
		
	ТекущееДействие = "ЗапроситьДанныеИзОчередиСтатусов";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
	
	
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
КонецПроцедуры

&НаСервере
Процедура СформироватьЗапросДанныхИзОчереди(ЕстьОшибки,ВидСообщения)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить(); - не очищаем
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
		
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
		
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Объект.Участник);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	Для Каждого ТекФормат Из МассивФорматовЗапросаРезультатов Цикл			
		НовСтр = ТекОбъектыОбмена.Добавить();
		НовСтр.Объект = Документы.ЗапросУНИФО.ПустаяСсылка();
		НовСтр.Формат = ТекФормат;
	КонецЦикла;
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);	
		
				
	ОбработкаФормирования = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	ОбработкаФормирования.ОбменСЭмулятором = ОбменСЭмулятором;
	
	НомерТек = 1;	
	
	ОбработкаФормирования.мОрганизация = УчастникОтправитель;
	ОбработкаФормирования.СоответствиеОбработанныхФорматов = Неопределено;
	ОбработкаФормирования.СформироватьФайлы(СтруктураДляФормирования);
			
	Для Каждого СтрокаОбмена Из СтруктураДляФормирования.ОбъектыОбмена Цикл
		НовСтр = РезультатФормирования.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрокаОбмена);
		НовСтр.НомерПакета = НомерТек;
		НовСтр.ТекущийУчастник = УчастникОтправитель;//при запросе данных из сервиса всегда будет Участник-отправитель 
		
		СтрФайлов = ФайлыРезультатаФормирования.Добавить();
		СтрФайлов.НомерПакета = НомерТек;
		СтрФайлов.СодержимоеФайла = СтрокаОбмена.РезультатФормирования;
		СтрФайлов.ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор());//при запросе данных очереди нет UUID-а
		СтрФайлов.ФорматОбмена = СтрокаОбмена.Формат;
		СтрФайлов.ВидСообщения = ВидСообщения;
		СтрФайлов.ТекущийУчастник = УчастникОтправитель;//при запросе данных из сервиса всегда будет Участник-отправитель
		
		ЕстьОшибки = ЕстьОшибки ИЛИ ЗначениеЗаполнено(НовСтр.ОписаниеОшибки);
		
		НомерТек = НомерТек + 1;
					
	КонецЦикла;
		
	//Заполним настройку заголовков
	
	Массивф = Новый Массив(МассивФорматовЗапросаРезультатов);
	Если ТребуетсяПодтверждениеПолученныхСообщений
		И ЗначениеЗаполнено(ФорматПодтверждения) Тогда
		Массивф.Добавить(ФорматПодтверждения);
	КонецЕсли;
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, Массивф));

КонецПроцедуры

#КонецОбласти

#Область ЗапросРезультатаОбработкиРанееОтправленныхСообщений

&НаКлиенте
Асинх Процедура ЗапроситьРезультатОбработкиОтправленныхСообщений(Команда)
	ОчиститьСообщения();
	
	//Если это вид обмена с идентификатором = "G2" - это означает, что требуется подтверждение полученного сообщения.
	//То есть это обмен с ГИС ГМП или ИС РНИП. Какой из них - можно оперделить по функциональным опциям.
	//Если это вид обмена с идентификатором = "UNP2" - это означает, что НЕ требуется подтверждение полученного сообщения.
	//Необходимо доработать получение сообщений, чтобы не отправлять подтверждение, где оно не нужно.
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЗапросаРезультатов","ЗапросУНИФО","GetResponseRequestByID");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	Если ТребуетсяПодтверждениеПолученныхСообщений Тогда
		ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматПодтверждения","ЗапросУНИФО","AckRequest");
		МассивСтруктурФорматов.Добавить(ТекСтруктура);
	КонецЕсли;
	
	Если ЕстьФорматыЗапросаУведомлений Тогда
		ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","МассивФорматовЗапросаУведомлений","ЗапросУНИФО","GetRequestRequest");
		МассивСтруктурФорматов.Добавить(ТекСтруктура);
	КонецЕсли;
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееДействие = "ЗапроситьРезультатОбработки";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
	
	НеобходимоЕщеРазЗапроситьОчередь = Ложь;
	
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьРезультатОбработкиОтправленныхСообщенийСНастройкой(Команда)
	ОчиститьСообщения();
	
	//Если это вид обмена с идентификатором = "G2" - это означает, что требуется подтверждение полученного сообщения.
	//То есть это обмен с ГИС ГМП или ИС РНИП. Какой из них - можно оперделить по функциональным опциям.
	//Если это вид обмена с идентификатором = "UNP2" - это означает, что НЕ требуется подтверждение полученного сообщения.
	//Необходимо доработать получение сообщений, чтобы не отправлять подтверждение, где оно не нужно.
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЗапросаРезультатов","ЗапросУНИФО","GetResponseRequestByID");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	Если ТребуетсяПодтверждениеПолученныхСообщений Тогда
		ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматПодтверждения","ЗапросУНИФО","AckRequest");
		МассивСтруктурФорматов.Добавить(ТекСтруктура);
	КонецЕсли;
	
	Если ЕстьФорматыЗапросаУведомлений Тогда
		ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","МассивФорматовЗапросаУведомлений","ЗапросУНИФО","GetRequestRequest");
		МассивСтруктурФорматов.Добавить(ТекСтруктура);
	КонецЕсли;
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
	ОписаниеОпов = Новый ОписаниеОповещения("ПослеВыбораИдентификаторовДляЗапроса",ЭтотОбъект);
	ОткрытьФорму("Обработка.ОбменГИСГМП2.Форма.ФормаЗапросаРезультатаОбработкиПоID",Новый Структура("Участник",Объект.Участник),ЭтотОбъект,,,,ОписаниеОпов,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры


&НаКлиенте
Асинх Процедура ПослеВыбораИдентификаторовДляЗапроса(РезультатВыбора,ДополнительныеПараметры) Экспорт	
	//Возможно, что в форме настроек отменили обработку
	ЗадатьЗаголовокКнопкеЗапросаПоID();
	
	Если РезультатВыбора = Неопределено Тогда
		МассивИдентификаторовДляЗапроса = Неопределено;
		Возврат;
	КонецЕсли;
	
	МассивИдентификаторовДляЗапроса = Новый ФиксированныйМассив(РезультатВыбора);
	
	ТекущееДействие = "ЗапроситьРезультатОбработки";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
	
	НеобходимоЕщеРазЗапроситьОчередь = Ложь;
	
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоЗапросуРезультатаОбработки(ЕстьОшибки,ПрерватьОбмен)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить(); - не очищаем
	
	Если МассивИдентификаторовДляЗапроса = Неопределено Тогда
		
		РезультатЗапроса = ПолучитьСообщенияДляЗапросаПоID();
		
		ИдентификаторыДляЗапроса = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ИдентификаторСообщения");	
	Иначе
		
		ИдентификаторыДляЗапроса = Новый Массив(МассивИдентификаторовДляЗапроса);
	КонецЕсли;
	
	//если нет идентификаторов ранее отправленных сообщений, на который еще не был получен ответ
	//и нет форматов запроса уведомлений, то дальше делать ничего не надо
	Если ИдентификаторыДляЗапроса.Количество() = 0
		И ЕстьФорматыЗапросаУведомлений = Ложь Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Все отправленные за последние 30 дней сообщения обработаны.'"));
		ПрерватьОбмен = Истина;
		Возврат;
	КонецЕсли;
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
		
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
		
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Объект.Участник);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	ФразаИдентификатор = "%ТутБудетИдентификаторСообщения%";
		
	ОбработкаФормирования = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	ОбработкаФормирования.ОбменСЭмулятором = ОбменСЭмулятором;
	ОбработкаФормирования.ИдентификаторСообщения = ФразаИдентификатор;
	
	НомерТек = 1;
	Если ИдентификаторыДляЗапроса.Количество() Тогда
		
		НовСтр = ТекОбъектыОбмена.Добавить();
		НовСтр.Объект = Документы.ЗапросУНИФО.ПустаяСсылка();
		НовСтр.Формат = ФорматЗапросаРезультатов;
		
		СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);	
				
		ОбработкаФормирования.мОрганизация = УчастникОтправитель;
		ОбработкаФормирования.СоответствиеОбработанныхФорматов = Неопределено;
		ОбработкаФормирования.СформироватьФайлы(СтруктураДляФормирования);
				
		Для Каждого СтрокаОбмена Из СтруктураДляФормирования.ОбъектыОбмена Цикл
			
			Для Каждого ТекИД Из ИдентификаторыДляЗапроса Цикл
				
				НовСтр = РезультатФормирования.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,СтрокаОбмена);
				НовСтр.НомерПакета = НомерТек;
				НовСтр.ТекущийУчастник = УчастникОтправитель;//при запросе данных из сервиса всегда будет Участник-отправитель 
				
				
				СтрФайлов = ФайлыРезультатаФормирования.Добавить();
				СтрФайлов.НомерПакета = НомерТек;
				СтрФайлов.СодержимоеФайла = СтрЗаменить(СтрокаОбмена.РезультатФормирования,ФразаИдентификатор,ТекИД);
				
				СтрФайлов.ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор());//при запросе данных очереди нет UUID-а
				СтрФайлов.ФорматОбмена = СтрокаОбмена.Формат;
				СтрФайлов.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСМЭВ;
				СтрФайлов.ТекущийУчастник = УчастникОтправитель;//при запросе данных из сервиса всегда будет Участник-отправитель
				
				ЕстьОшибки = ЕстьОшибки ИЛИ ЗначениеЗаполнено(НовСтр.ОписаниеОшибки);
				
				НомерТек = НомерТек + 1;
			
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если ЕстьФорматыЗапросаУведомлений Тогда
		
		ТекОбъектыОбмена.Очистить();
	
		Для Каждого ТекФормат Из МассивФорматовЗапросаУведомлений Цикл
			НовСтр = ТекОбъектыОбмена.Добавить();
			НовСтр.Объект = Документы.ЗапросУНИФО.ПустаяСсылка();
			НовСтр.Формат = ТекФормат;
		КонецЦикла;
		
		СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);	
								
		ОбработкаФормирования.мОрганизация = УчастникОтправитель;
		ОбработкаФормирования.СоответствиеОбработанныхФорматов = Неопределено;
		ОбработкаФормирования.СформироватьФайлы(СтруктураДляФормирования);
		
		Для Каждого СтрокаОбмена Из СтруктураДляФормирования.ОбъектыОбмена Цикл
			НовСтр = РезультатФормирования.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,СтрокаОбмена);
			НовСтр.НомерПакета = НомерТек;
			НовСтр.ТекущийУчастник = УчастникОтправитель;//при запросе данных из сервиса всегда будет Участник-отправитель 
			
			СтрФайлов = ФайлыРезультатаФормирования.Добавить();
			СтрФайлов.НомерПакета = НомерТек;
			СтрФайлов.СодержимоеФайла = СтрЗаменить(СтрокаОбмена.РезультатФормирования,ФразаИдентификатор,ТекИД);
			
			СтрФайлов.ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор());//при запросе данных очереди нет UUID-а
			СтрФайлов.ФорматОбмена = СтрокаОбмена.Формат;
			СтрФайлов.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСМЭВ;
			СтрФайлов.ТекущийУчастник = УчастникОтправитель;//при запросе данных из сервиса всегда будет Участник-отправитель
			
			ЕстьОшибки = ЕстьОшибки ИЛИ ЗначениеЗаполнено(НовСтр.ОписаниеОшибки);
			
			НомерТек = НомерТек + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	МассивИдентификаторовДляЗапроса = Неопределено;
	
	//Заполним настройку заголовков
	Массивф = Новый Массив;
	Массивф.Добавить(ФорматЗапросаРезультатов);
	Если ЕстьФорматыЗапросаУведомлений Тогда
		Для Каждого ТекФормат Из МассивФорматовЗапросаУведомлений Цикл
			Массивф.Добавить(ТекФормат);	
		КонецЦикла;
	КонецЕсли;
	Если ТребуетсяПодтверждениеПолученныхСообщений
		И ЗначениеЗаполнено(ФорматПодтверждения) Тогда
		Массивф.Добавить(ФорматПодтверждения);
	КонецЕсли;
	
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, Массивф));

КонецПроцедуры

&НаСервере
Функция ПолучитьСообщенияДляЗапросаПоID()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
		|ГДЕ
		|	СообщенияИмпортаДанныхВСМЭВ3.Организация = &Организация
		|	И СообщенияИмпортаДанныхВСМЭВ3.ДатаОбмена >= &ДатаОбмена
		|	И СообщенияИмпортаДанныхВСМЭВ3.СтатусОтправки В(&СтатусОтправки)";
	
	Запрос.УстановитьПараметр("Организация", Объект.Участник);
	
	//ответы на сообщения хранятся не более 30 дней, 
	//поэтому автоматически запрашиваем результат обработки сообщений,
	//которые были отправлены в последние 30 дней от текущей даты,
	//и на которые еще не был получен результат.
	
	ДатаОбмена = НачалоДня(ТекущаяДата()) - 30*86400;	
	Запрос.УстановитьПараметр("ДатаОбмена", ДатаОбмена);
	
	//отбор по статусу, если сообщение не было загружено или вернулась ошибка,
	//то и запрашивать ничего не нужно
	
	ЗапрашиваемыеСтатусы = Новый Массив;
	ЗапрашиваемыеСтатусы.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВОчереди);//передано в очередь
	ЗапрашиваемыеСтатусы.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ПолученПолучателем);//не известно, в каком случает устанавливается, но запросим
	ЗапрашиваемыеСтатусы.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВПроцессеОбработки);//обрабатывается, еще не готово
	
	Запрос.УстановитьПараметр("СтатусОтправки", ЗапрашиваемыеСтатусы);
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса;
	
КонецФункции

&НаСервере
Процедура ЗадатьЗаголовокКнопкеЗапросаПоID()
	Если Элементы.ФормаЗапроситьРезультатОбработкиОтправленныхСообщений.Видимость Тогда
		РезультатЗапроса = ПолучитьСообщенияДляЗапросаПоID();
		КоличествоСообщенийДляЗапроса = РезультатЗапроса.Выбрать().Количество();
		
		Если КоличествоСообщенийДляЗапроса = 0 Тогда
			Элементы.ФормаЗапроситьРезультатОбработкиОтправленныхСообщений.Заголовок = "Запросить результат обработки (0)"
		Иначе
			Элементы.ФормаЗапроситьРезультатОбработкиОтправленныхСообщений.Заголовок = "Запросить результат обработки ("+КоличествоСообщенийДляЗапроса+")";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ПодтверждениеПолученияСообщенияСМЭВ

&НаСервере
Процедура СформироватьПодтверждениеПолученияСообщения(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	
	ФразаИдентификатор = "%ТутБудетИдентификаторСообщения%";
	ШаблонСообщенияПодтверждения = ГосУслуги.СформироватьШаблонСообщенияПодтверждения(УчастникОтправитель,ФорматПодтверждения);
		
	ПозицияНачалаФайла = 1;
	Если СтрНачинаетсяС(ШаблонСообщенияПодтверждения,"<?")  Тогда
		ПозицияНачалаФайла = СтрНайти(ШаблонСообщенияПодтверждения,"?>")+2;
		ШаблонСообщенияПодтверждения = СокрЛП(Сред(ШаблонСообщенияПодтверждения,ПозицияНачалаФайла));
	КонецЕсли;
	
	НомерТек = 1;
	//каждый пакет нужно формировать отдельно, чтобы у каждого пакета был свой идентификатор сообщения
	Для Инд = 0 По ТаблицаПодтвержденияПолученияСообщений.Количество()-1 Цикл
		
		ИдентификаторСообщенияДляПодтверждения = ТаблицаПодтвержденияПолученияСообщений[Инд].ИдентификаторСообщенияСМЭВ;
		СообщениеДляПодтверждения = СтрЗаменить(ШаблонСообщенияПодтверждения,ФразаИдентификатор,ИдентификаторСообщенияДляПодтверждения);
		
		НовСтр = РезультатФормирования.Добавить();
		НовСтр.Формат = ФорматПодтверждения;
		НовСтр.Объект = Документы.ЗапросУНИФО.ПустаяСсылка();
		НовСтр.НомерПакета = НомерТек;
		НовСтр.ТекущийУчастник = УчастникОтправитель;
		
		СтрФайлов = ФайлыРезультатаФормирования.Добавить();
		СтрФайлов.НомерПакета = НомерТек;
		СтрФайлов.СодержимоеФайла = СообщениеДляПодтверждения;
		СтрФайлов.ИдентификаторСообщения = ИдентификаторСообщенияДляПодтверждения;
		СтрФайлов.ФорматОбмена = ФорматПодтверждения;
		СтрФайлов.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ПодтверждениеПолученияСообщенияСМЭВ;
		СтрФайлов.ТекущийУчастник = УчастникОтправитель;
				
		НомерТек = НомерТек + 1;
		
	КонецЦикла;
					
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматПодтверждения));

КонецПроцедуры

#КонецОбласти

#Область ЗапроситьНовуюПорциюДанных

&НаКлиенте
Процедура ЗапроситьСледующуюПорциюДанных(Команда)
	
	Если КоличествоЗапросовНовыхДанных >0 Тогда
		
		СписокОтветов = Новый СписокЗначений;
		СписокОтветов.Добавить(КодВозвратаДиалога.ОК,"Запросить");
		СписокОтветов.Добавить(КодВозвратаДиалога.Отмена,"Не сейчас");
		СписокОтветов.Добавить(КодВозвратаДиалога.Пропустить,"Не требуется");
		
		
		ТекстВопроса = НСтр("ru='Запросить следующую порцию данных (%1 запросов)?'");
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса,КоличествоЗапросовНовыхДанных);
		ОписаниеОп = Новый ОписаниеОповещения("ПослеОтветаНаВопросОЗапросеДанных",ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОп,ТекстВопроса,СписокОтветов);
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Нет запросов для получения следующей порции данных.'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОЗапросеДанных(Результат,ДопПараметры) Экспорт
		
	Если Результат=КодВозвратаДиалога.Пропустить Тогда
		ТаблицаДляЗапросаНовыхДанных.Очистить();
		КоличествоЗапросовНовыхДанных = 0;
		ПредКоличествоЗапросов = 0;
		Элементы.ЗапроситьСледующуюПорциюДанных.Заголовок = "Запросить следующую порцию данных ("+КоличествоЗапросовНовыхДанных+")";
		Возврат;
	ИначеЕсли Результат<>КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущееДействие <> "ЗапроситьНовуюПорциюДанных" Тогда		
		ТекущееДействие = "ЗапроситьНовуюПорциюДанных";
		ФайлыСформированы = Ложь;
		ФайлыПодписаны = Ложь;
		ФайлыОтправлены = Ложь;
	КонецЕсли;
	
	ВыполнитьДействияОтправкиСообщенийНаКлиенте();
			
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыСообщенияЗапросаНовойПорцииДанных(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	//Таблицу ТаблицаДляЗапросаНовыхДанных сейчас НЕ очищаем
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
		
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	МассивСтруктурФормированияФайлов = Новый Массив;
	
	УстановитьПривилегированныйРежим(Истина);
	
	//каждый пакет нужно формировать отдельно, чтобы у каждого пакета был свой идентификатор сообщения
	Для Каждого СтрТЧ Из ТаблицаДляЗапросаНовыхДанных Цикл
		
		НовДок = СтрТЧ.Объект.ПолучитьОбъект().Скопировать();
		
		НовДок.Дата = ТекущаяДатаСеанса();
		НовДок.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
		НовДок.РезультатЗагрузки = "";
		НовДок.ЗагруженоДанных = 0;
		
		Если НЕ ЗначениеЗаполнено(НовДок.СтраницаРезультата) Тогда
			//если не заполнена, то возвращается всегда 1 страница, и надо запрашивать вторую
			НовДок.СтраницаРезультата = 2;
		Иначе
			НовДок.СтраницаРезультата = НовДок.СтраницаРезультата + 1;
		КонецЕсли;
		
		НовДок.Записать();
		СтрТЧ.Объект = НовДок.Ссылка;
		
		СтруктураРекв = Новый Структура;
		СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",СтрТЧ.Объект);
		СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивСтруктурФормированияФайлов = Новый Массив;
	
	МассивФ = Новый Массив;
	
	НоваяСтруктураФормирования = Истина;
	
	Для Инд = 0 По ТаблицаДляЗапросаНовыхДанных.Количество()-1 Цикл
		
		Если НоваяСтруктураФормирования Тогда
			
			СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
			СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
			СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
			СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
			СтруктураДляФормирования.Вставить("Организация", УчастникОтправитель);//отправляет и подтверждает всегда отправитель
			СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
			//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
			
			ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
			ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
		    НоваяСтруктураФормирования = Ложь;
			
		КонецЕсли;
		
		НовСтр = ТекОбъектыОбмена.Добавить();
		НовСтр.Объект = ТаблицаДляЗапросаНовыхДанных[Инд].Объект;
		НовСтр.Формат = ТаблицаДляЗапросаНовыхДанных[Инд].ФорматОбмена;
		
		Если МассивФ.Найти(НовСтр.Формат) = Неопределено Тогда
			МассивФ.Добавить(НовСтр.Формат);
		КонецЕсли;
		
		Если ТекОбъектыОбмена.Количество()>100 Тогда
			СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);			
			МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
			НоваяСтруктураФормирования = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НоваяСтруктураФормирования = Ложь Тогда
		//значит последняя структура не добавлена		
		СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);			
		МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
	КонецЕсли;
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);			
	
	ТаблицаДляЗапросаНовыхДанных.Очистить();
	КоличествоЗапросовНовыхДанных = 0;
	ПредКоличествоЗапросов = 0;
	//Заполним настройку заголовков
	
	Если ТребуетсяПодтверждениеПолученныхСообщений
		И ЗначениеЗаполнено(ФорматПодтверждения) Тогда
		МассивФ.Добавить(ФорматПодтверждения);
	КонецЕсли;
	
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, МассивФ));

КонецПроцедуры

#КонецОбласти

#Область ОтправкаКаталога

&НаКлиенте
Асинх Процедура ОтправитьКаталог(Команда)
	ОчиститьСообщения();
	
	ТекДанные = Элементы.СписокКаталогов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ТекущийКаталог = Неопределено;
	Иначе
		ТекущийКаталог = ТекДанные.ДокСсылка;
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(ТекущийКаталог) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбран каталог для отправки.'"));
		Возврат;
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","КаталогГосУслуг","SendRequestRequest_КУ");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееДействие = "ОтправитьКаталог";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
КонецПроцедуры

&НаСервере
Процедура СформироватьФайлыПоКаталогуУслуг(ЕстьОшибки)
	
	РезультатФормирования.Очистить();
	ФайлыРезультатаФормирования.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
		
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
			
	Организация = Объект.Участник;
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
						
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Объект.Участник);
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
	
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");

	НовСтр = ТекОбъектыОбмена.Добавить();
	НовСтр.Объект = ТекущийКаталог;
	НовСтр.Формат = ФорматЭкспорта;
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);
	
	МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
	
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортДанныхВСМЭВ,ЕстьОшибки);			
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, ФорматЭкспорта));

КонецПроцедуры

#КонецОбласти

#Область ОтправитьПроизвольныйЗапрос

&НаКлиенте
Асинх Процедура ОтправитьПроизвольныйЗапрос(Команда)
	
	ОчиститьСообщения();
	
	ТипЗапрашиваемыхДанных = "";
	ТекДанные = Элементы.СписокЗапросов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ТекущийЗапрос = Неопределено;
	Иначе
		ТипЗапрашиваемыхДанных = ТекДанные.ТипЗапрашиваемыхДанных;
		ТекущийЗапрос = ТекДанные.Ссылка;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ТекущийЗапрос) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбран запрос для отправки.'"));
		Возврат;
	КонецЕсли;
	
	Если ПроверитьВозможностьФормированияПоПараметрамДляПрозвольногоЗапроса(ТипЗапрашиваемыхДанных) = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееДействие = "ОтправитьПроизвольныйЗапрос";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

&НаСервере
Функция ПроверитьВозможностьФормированияПоПараметрамДляПрозвольногоЗапроса(ТипЗапрашиваемыхДанных)
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","МассивФорматовЭкспорта","ЗапросУНИФО","SendRequestRequest_ЗД");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
		
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//Если тип запроса - квитирование, отмена квитирования, импорт сертификата, то для запроса достаточно 1 формата,
	//для всех остальных запросов данных - оба - внутренний (только в ИС РНИП/ИС УНП) и внешний (только в ГИС ГМП)
	
	Если МассивФорматовЭкспорта.Количество() > 1 Тогда
		Если ТипЗапрашиваемыхДанных = "DOACKNOWLEDGMENTREQUEST"
			ИЛИ ТипЗапрашиваемыхДанных = "ANNULMENTRECONCILE"
			ИЛИ ТипЗапрашиваемыхДанных = "APPEND"
			ИЛИ ТипЗапрашиваемыхДанных = "REPLACE" Тогда
			ТекМассив = Новый Массив;
			ТекМассив.Добавить(МассивФорматовЭкспорта[0]);
			МассивФорматовЭкспорта = Новый ФиксированныйМассив(ТекМассив);
		КонецЕсли;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура СформироватьФайлыПроизвольногоЗапроса(ЕстьОшибки)
	
	РезультатФормирования.Очистить();         
	ФайлыРезультатаФормирования.Очистить();
	ТаблицаПодтвержденияПолученияСообщений.Очистить();
	//ТаблицаДляЗапросаНовыхДанных.Очистить();		
		
	МассивСтруктурФормированияФайлов = Новый Массив;
	ОбщОбъектыОбмена = РеквизитФормыВЗначение("РезультатФормирования");
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Участник);
	
	РеквизитыЗапроса = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущийЗапрос,"Организация,ТипЗапрашиваемыхДанных");
	
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", РеквизитыЗапроса.Организация); 
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
	
	ТекОбъектыОбмена = ОбщОбъектыОбмена.СкопироватьКолонки();
	ТекОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	МассивТекстовДляЭмулятора = Новый Массив;
	Если ОбменСЭмулятором
		И РеквизитыЗапроса.ТипЗапрашиваемыхДанных = "EMU_DOACKNOWLEDGMENTREQUEST" Тогда
		
		МассивТекстовДляЭмулятора.Добавить(ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,"ЗапросНаКвитирование",ЕстьОшибки));
		
		Для Каждого ТекФормат Из МассивФорматовЭкспорта Цикл 
			//необходимо сформировать 4 сообщения с разными идентификаторами
			Для Инд = 1 По МассивТекстовДляЭмулятора.Количество() Цикл
				СтрокаОбмена = ТекОбъектыОбмена.Добавить();
				СтрокаОбмена.Объект = ТекущийЗапрос;
				СтрокаОбмена.Формат = ТекФормат;
			КонецЦикла;
		КонецЦикла;
			
	Иначе
		Для Каждого ТекФормат Из МассивФорматовЭкспорта Цикл
			СтрокаОбмена = ТекОбъектыОбмена.Добавить();
			СтрокаОбмена.Объект = ТекущийЗапрос;
			СтрокаОбмена.Формат = ТекФормат;
		КонецЦикла;
	КонецЕсли;
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ТекОбъектыОбмена);			
	МассивСтруктурФормированияФайлов.Добавить(СтруктураДляФормирования);
			
	СформироватьФайлыПоНастройке(МассивСтруктурФормированияФайлов,Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика,ЕстьОшибки);
	
	Если ОбменСЭмулятором Тогда
		
		Если РеквизитыЗапроса.ТипЗапрашиваемыхДанных = "EMU_DOACKNOWLEDGMENTREQUEST" Тогда	
			Инд = 0;
			КолТЭ = МассивТекстовДляЭмулятора.Количество();
			Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
				Если Инд < КолТЭ Тогда
					ТекстЗапросаДляЭмулятора = МассивТекстовДляЭмулятора[Инд];
				Иначе
					ТекстЗапросаДляЭмулятора = "";
				КонецЕсли;
				СтрТЧ.ОбменСЭмулятором = Истина;
				СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
				СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
				Инд = Инд + 1;
			КонецЦикла;
		Иначе
			ТекстЗапросаДляЭмулятора = "";
			ТипСообщенияЗапроса = "";
			Если РеквизитыЗапроса.ТипЗапрашиваемыхДанных = "DOACKNOWLEDGMENTREQUEST" Тогда
				ТипСообщенияЗапроса = "ЗапросНаКвитирование";				
			ИначеЕсли РеквизитыЗапроса.ТипЗапрашиваемыхДанных = "QUITTANCE" Тогда
			    ТипСообщенияЗапроса = "ЗапросРезультатаКвитирования";
			ИначеЕсли РеквизитыЗапроса.ТипЗапрашиваемыхДанных = "REFUND" Тогда
				ТипСообщенияЗапроса = "ЗапросВозврата";
			ИначеЕсли РеквизитыЗапроса.ТипЗапрашиваемыхДанных = "PAYMENT"
				ИЛИ РеквизитыЗапроса.ТипЗапрашиваемыхДанных = "PAYMENTCANCELLED" Тогда
				ТипСообщенияЗапроса = "ЗапросПлатежей";
			ИначеЕсли РеквизитыЗапроса.ТипЗапрашиваемыхДанных = "CHARGE"
				ИЛИ РеквизитыЗапроса.ТипЗапрашиваемыхДанных = "CHARGESTATUS" Тогда
				ТипСообщенияЗапроса = "ЗапросСтатуса";
			ИначеЕсли РеквизитыЗапроса.ТипЗапрашиваемыхДанных = "APPEND"
				ИЛИ РеквизитыЗапроса.ТипЗапрашиваемыхДанных = "REPLACE" Тогда
				ТипСообщенияЗапроса = "ИмпортСертификата";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТипСообщенияЗапроса) Тогда
				ТекстЗапросаДляЭмулятора = ПолучитьТекстЗапросаДляЭмулятора(НастройкиУчастника.ВидОбмена,НастройкиУчастника.НастройкаОбмена,ТипСообщенияЗапроса,ЕстьОшибки);
			КонецЕсли;
			
			Для Каждого СтрТЧ Из ФайлыРезультатаФормирования Цикл
				СтрТЧ.ОбменСЭмулятором = Истина;
				СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%ТекстЗапросаДляЭмулятора%",ТекстЗапросаДляЭмулятора);
				СтрТЧ.СодержимоеФайла = СтрЗаменить(СтрТЧ.СодержимоеФайла,"%timestamp%",Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекущаяДатаСеанса()), "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	//Заполним настройку заголовков
	СоответствиеЗаголовковФорматов = Новый ФиксированноеСоответствие(ЭкспортФайлов.ПолучитьЗаголовкиМассиваФорматов(НастройкаОбмена, Новый Массив(МассивФорматовЭкспорта)));

КонецПроцедуры

#КонецОбласти

