&НаКлиенте
Процедура СформироватьЗапросАЗ(Команда)
	
	ТипЗапрашиваемыхДанных = "";
	
	Если ИспользоватьОчередьЗапросовГИСГМП Тогда
		ИмяРеквизитаФорматов = "МассивФорматовОчереди";
		МассивСтруктурФорматов = Новый Массив;
		ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата",ИмяРеквизитаФорматов,"ЗапросУНИФО","SendRequestRequest_NewQuery");
		МассивСтруктурФорматов.Добавить(ТекСтруктура);
			
		Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
			Возврат;
		КонецЕсли;
	Иначе
		ИмяРеквизитаФорматов = "МассивФорматовЭкспорта";
		Если ПроверитьВозможностьФормированияПоПараметрамДляПрозвольногоЗапроса(ТипЗапрашиваемыхДанных) = Ложь Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	
	ОписаниеОпов = Новый ОписаниеОповещения("ПослеСозданияЗапросовАЗ",ЭтотОбъект);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидЗапроса","Начисления");
	ПараметрыФормы.Вставить("Участник",Объект.Участник);
	ПараметрыФормы.Вставить("МассивФорматовЭкспорта",ЭтотОбъект[ИмяРеквизитаФорматов]);
	ПараметрыФормы.Вставить("ИспользоватьОчередьЗапросовГИСГМП",ИспользоватьОчередьЗапросовГИСГМП);
	ОткрытьФорму("Обработка.ОбменГИСГМП2.Форма.ФормаСозданияЗапросаАЗ",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОпов,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

