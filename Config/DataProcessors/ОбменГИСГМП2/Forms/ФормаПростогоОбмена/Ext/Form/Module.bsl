	Элементы.ДокументыПодписокУведомленияПоПодписке_ВыполнитьОбменСЭмулятором.Видимость = ОбменСЭмулятором;
КонецПроцедуры

#Область СформироватьПакетыНачисленийИВозвратов

&НаКлиенте
Асинх Процедура СформироватьПакетыНачислений(Команда)
	
	ОчиститьСообщения();
	
	ОбновитьСписокОтмеченныхКвитанцийПоДаннымСпискаКвитанций();
	Если СписокОтмеченныеКвитанции.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отмечены документы для формирования пакета начислений.'"));
		Возврат;
	КонецЕсли;
	
	МассивСтруктурФорматов = Новый Массив;
	ТекСтруктура = Новый Структура("РеквизитФормата,ИмяДокумента,ИмяФормата","ФорматЭкспорта","КвитанцияНаОплатуГосуслуг","SendRequestRequest_КВ");
	МассивСтруктурФорматов.Добавить(ТекСтруктура);
	
	
	Если ПроверитьВозможностьФормированияПоПараметрам("",МассивСтруктурФорматов) = Ложь Тогда
		Возврат;
	КонецЕсли;
			
	ТекущееДействие = "СформироватьПакетыНачислений";
	
	ФайлыСформированы = Ложь;
	ФайлыПодписаны = Ложь;
	ФайлыОтправлены = Ложь;
	ПакетыСозданы = Ложь;
		
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
						
		ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента ExtraCryptoAPI.'");
		
		КомпонентаПодписи = Ждать ЭлектроннаяПодписьСлужебныйКлиент.ОбъектВнешнейКомпонентыExtraCryptoAPI(Истина,ТекстПояснения);
		ПослеПодключенияКомпонентыПодписи();
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеОбменаНаКлиенте();
	
КонецПроцедуры

