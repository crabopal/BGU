
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Начисление = Параметры.Начисление;
	
	Если ЗначениеЗаполнено(Начисление) Тогда
		СуммаНачисления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Начисление,"СуммаДокумента");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СквитироватьНаСумму(Команда)
	Если НЕ ЗначениеЗаполнено(СуммаЧастичногоКвитирования) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Укажите сумму квитирования'"),,"СуммаЧастичногоКвитирования","СуммаЧастичногоКвитирования");
		Возврат;
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("СуммаЧастичногоКвитирования",СуммаЧастичногоКвитирования);
	Закрыть(СтруктураВозврата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
