			КонецЦикла;
		КонецЕсли;
					
	КонецЕсли;
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	МассивДокументов = Новый Массив;
	СформироватьЗапросыНаСервере(МассивДокументов);
	Если МассивДокументов.Количество()= 1 Тогда
		ОповеститьОбИзменении(МассивДокументов[0]);
	ИначеЕсли МассивДокументов.Количество()>1 Тогда
		ОповеститьОбИзменении(Тип("ДокументСсылка.ЗапросУНИФО"));
	КонецЕсли;
	
	Закрыть(МассивДокументов);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИдентификатор(Команда)
	ПараметрыФормы = Новый Структура("ВидПлательщика",ВидПлательщика);
	
	ОписаниеОпов = Новый ОписаниеОповещения("ПослеФормированияИдентификатора",ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ОбменГИСГМП2.Форма.ФормаФормированияИдентификатора",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОпов,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПослеФормированияИдентификатора(Результат,ДопПараметры)Экспорт
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьИдентификаторВТаблицу(Результат);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуОрганизаций(Команда)
	ЗаполнитьТаблицуОрганизацийНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	ИзменитьОтметку(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуВсе(Команда)
	ИзменитьОтметку(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ДобавитьИдентификаторВТаблицу(ДобавляемыйИдентификатор)
	
	Если ТаблицаИдентификаторов.НайтиСтроки(Новый Структура("ИдентификаторПлательщика",ДобавляемыйИдентификатор)).Количество()>0 Тогда
		ТекстСообщения = Нстр("ru='Идентификатор %1 уже есть в списке запрашиваемых'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ДобавляемыйИдентификатор);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	НовСтр = ТаблицаИдентификаторов.Добавить();
	НовСтр.ИдентификаторПлательщика = ДобавляемыйИдентификатор;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЗапросыНаСервере(МассивДокументов)
		
	Если ЭтоЗапросНачислений Тогда
		
		Если УсловияОтборовНачислений = 0 Тогда // ИдПлат
			
			МассивИНН = Новый Массив;
			МассивИдПлат = Новый Массив;
			Для Каждого СтрТЧ Из ТаблицаИдентификаторов Цикл
				ТекЗначение = СокрЛП(СтрТЧ.ИдентификаторПлательщика);
				ДлинаПоля = СтрДлина(ТекЗначение);
				Если ДлинаПоля = 22 Тогда
					МассивИдПлат.Добавить(ТекЗначение);
				ИначеЕсли ДлинаПоля = 10 Тогда
					МассивИНН.Добавить(ТекЗначение);
				КонецЕсли;
			КонецЦикла;			
			
			Если МассивИдПлат.Количество()>0 Тогда
				СоздатьДокументыЗапросаПоПараметрам(ТипЗапросаНачислений,"УИП",МассивИдПлат,Истина,ДатаНачала,ДатаОкончания,МассивДокументов);
				//МассивДокументов.Добавить(ЗапросСсылка);
			КонецЕсли;
			
			Если МассивИНН.Количество()>0 Тогда
				СоздатьДокументыЗапросаПоПараметрам(ТипЗапросаНачислений,"ИНН",МассивИНН,Истина,ДатаНачала,ДатаОкончания,МассивДокументов);
				//МассивДокументов.Добавить(ЗапросСсылка);
			КонецЕсли; 
			
		ИначеЕсли УсловияОтборовНачислений = 1 Тогда //УИН
			
			МассивУИН = ТаблицаУИН.Выгрузить().ВыгрузитьКолонку("УИН");
			СоздатьДокументыЗапросаПоПараметрам(ТипЗапросаНачислений,"УИН",МассивУИН,Ложь,Неопределено,Неопределено,МассивДокументов);
			//МассивДокументов.Добавить(ЗапросСсылка);
			
		ИначеЕсли УсловияОтборовНачислений = 2 Тогда //за временной интервал
			
			МассивПустой = Новый Массив;
			СоздатьДокументыЗапросаПоПараметрам(ТипЗапросаНачислений,"НЕТ",МассивПустой,Истина,ДатаНачала,ДатаОкончания,МассивДокументов);
			//МассивДокументов.Добавить(ЗапросСсылка);
			
		ИначеЕсли УсловияОтборовНачислений = 3 Тогда // Организации
			
			МассивИНН = Новый Массив;
			Для Каждого СтрТЧ Из ТаблицаОрганизации Цикл
				Если СтрТЧ.Использовать = Ложь Тогда
					Продолжить;
				КонецЕсли;
				ТекЗначение = СокрЛП(СтрТЧ.ИНН);
				ДлинаПоля = СтрДлина(ТекЗначение);
				Если ДлинаПоля = 10 Тогда
					МассивИНН.Добавить(ТекЗначение);
				КонецЕсли;
			КонецЦикла;			
						
			Если МассивИНН.Количество()>0 Тогда
				СоздатьДокументыЗапросаПоПараметрам(ТипЗапросаНачислений,"ИНН",МассивИНН,Истина,ДатаНачала,ДатаОкончания,МассивДокументов);
				//МассивДокументов.Добавить(ЗапросСсылка);
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		//платежи
		
		Если УсловияОтборовПлатежей = 0 Тогда //УИН
			
			МассивУИН = ТаблицаУИН.Выгрузить().ВыгрузитьКолонку("УИН");
			СоздатьДокументыЗапросаПоПараметрам(ТипЗапросаПлатежей,"УИН",МассивУИН,Ложь,ДатаНачала,ДатаОкончания,МассивДокументов);
			//МассивДокументов.Добавить(ЗапросСсылка);	
			
		ИначеЕсли УсловияОтборовПлатежей = 1 Тогда //Ид.Плат.
			
			МассивИдПлат = ТаблицаИдентификаторов.Выгрузить().ВыгрузитьКолонку("ИдентификаторПлательщика");
			СоздатьДокументыЗапросаПоПараметрам(ТипЗапросаПлатежей,"УИП",МассивИдПлат,Истина,ДатаНачала,ДатаОкончания,МассивДокументов);
			//МассивДокументов.Добавить(ЗапросСсылка);
			
		ИначеЕсли УсловияОтборовПлатежей = 2 Тогда //идентификаторы платежа
			
			МассивБИП = ТаблицаУИП.Выгрузить().ВыгрузитьКолонку("УИП");
			СоздатьДокументыЗапросаПоПараметрам(ТипЗапросаПлатежей,"БИП",МассивБИП,Ложь,Неопределено,Неопределено,МассивДокументов);
			//МассивДокументов.Добавить(ЗапросСсылка);
			
		ИначеЕсли УсловияОтборовПлатежей = 3 Тогда //за временной интервал
			
			МассивПустой = Новый Массив;
			СоздатьДокументыЗапросаПоПараметрам(ТипЗапросаПлатежей,"НЕТ",МассивПустой,Истина,ДатаНачала,ДатаОкончания,МассивДокументов);
			//МассивДокументов.Добавить(ЗапросСсылка);
			
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыЗапросаПоПараметрам(ТипЗапрашиваемыхДанных,ТипИдентификатораДанных,МассивИдентификаторов,ИспользуетсяОтборПоКБК,ТекДатаНачала,ТекДатаОкончания,МассивДокументов)
	
	Если Параметры.ИспользоватьОчередьЗапросовГИСГМП Тогда
		
		КоличествоЧасов = 0; // сейчас не разделяется на периоды
		
		ТипУчастникаГИСГМП = Перечисления.ТипыУчастниковГИСГМП.АЗ;
		СтруктураПараметров = ГосУслуги.ПараметрыДляФормированияЗаписейРегистровЗапросаКГИСГМП(ТекДатаНачала,
			ТекДатаОкончания,КоличествоЧасов,ТипЗапрашиваемыхДанных,ТипИдентификатораДанных,ТипУчастникаГИСГМП);
			
		Если МассивИдентификаторов<>Неопределено Тогда
			СтруктураПараметров.МассивОтборПоИдентификаторам = МассивИдентификаторов;		
		КонецЕсли;
		
		Если ИспользуетсяОтборПоКБК Тогда
			МассивКБК = ТаблицаКБК.Выгрузить().ВыгрузитьКолонку("КБК");
			СтруктураПараметров.МассивОтборПоКБК = МассивКБК;
		КонецЕсли;
		ОшибкаСозданияЗапроса = Ложь;
		ТекстОшибки = "";	
		ГосУслуги.СформироватьЗаписиРегистровЗапросаКГИСГМП(Параметры.Участник, СтруктураПараметров, Параметры.МассивФорматовЭкспорта,ОшибкаСозданияЗапроса,ТекстОшибки);
		
		Если ОшибкаСозданияЗапроса Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки); 
			Возврат;
		Иначе
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Запрос добавлен в очередь запросов к сервису'"));	
		КонецЕсли;
	Иначе
	
		ДокОбъект = Документы.ЗапросУНИФО.СоздатьДокумент();
		ДокОбъект.Дата = ТекущаяДата();
		ДокОбъект.Организация = Параметры.Участник;
		ДокОбъект.ТипЗапрашиваемыхДанных = ТипЗапрашиваемыхДанных;
		ДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
		ДокОбъект.Комментарий = Комментарий;
		ДокОбъект.СтраницаРезультата = 1;
		ДокОбъект.ТипУчастника = Перечисления.ТипыУчастниковГИСГМП.АЗ;
		
		ДокОбъект.ТипИдентификатораДанных = ТипИдентификатораДанных;
		
		Если МассивИдентификаторов <> Неопределено Тогда
			Для Каждого ТекИд Из МассивИдентификаторов Цикл
				НовСтр = ДокОбъект.ЗапрашиваемыеДанные.Добавить();
				НовСтр.УИД = ТекИд;
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДатаНачала)
			И ЗначениеЗаполнено(ТекДатаОкончания) Тогда
			ДокОбъект.ДатаНачала = ТекДатаНачала;
			ДокОбъект.ДатаОкончания = ТекДатаОкончания;
		КонецЕсли;
		
		Если ИспользуетсяОтборПоКБК = Истина Тогда
			КоличествоКБК = 0;
			
			Для Каждого СтрТЧ Из ТаблицаКБК Цикл
				
				Если КоличествоКБК = 10 Тогда
					//В документе не может быть более 10 КБК - ограничение формата
					ДокОбъект.Записать();
					МассивДокументов.Добавить(ДокОбъект.Ссылка);
					
					ДокОбъект = ДокОбъект.Скопировать();
					ДокОбъект.Дата = ТекущаяДата();
					ДокОбъект.ОтборПоКБК.Очистить();
					
					КоличествоКБК = 0;
				КонецЕсли;
				
				НовСтр = ДокОбъект.ОтборПоКБК.Добавить();
				НовСтр.КБК = СтрТЧ.КБК;
				
				КоличествоКБК = КоличествоКБК + 1;
				
			КонецЦикла;
		КонецЕсли;
			
		ДокОбъект.Записать();
		
		МассивДокументов.Добавить(ДокОбъект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуОрганизацийНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация,
		|	Организации.ИНН КАК ИНН,
		|	ВЫБОР
		|		КОГДА ДЛИНАСТРОКИ(СОКРЛП(Организации.ИНН)) = 10
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Использовать
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Организации.Ссылка
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
		
	ТаблицаОрганизации.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОтметку(Значение)
	Для Каждого СтрТЧ Из ТаблицаОрганизации Цикл
		Если СтрДлина(СокрЛП(СтрТЧ.ИНН)) = 10 Тогда
			СтрТЧ.Использовать = Значение;
		Иначе
			СтрТЧ.Использовать = Ложь;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры




#КонецОбласти


