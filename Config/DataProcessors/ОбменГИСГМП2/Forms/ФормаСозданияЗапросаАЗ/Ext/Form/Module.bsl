#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтоЗапросНачислений = (Параметры.ВидЗапроса = "Начисления");
	
	Если ЭтоЗапросНачислений Тогда
		Элементы.ГруппаСтраницыЗапросов.ТекущаяСтраница = Элементы.ГруппаСтраницаЗапросаНачислений;
	Иначе
		Элементы.ГруппаСтраницыЗапросов.ТекущаяСтраница = Элементы.ГруппаСтраницаЗапросаПлатежей;
	КонецЕсли;
	
	ЗаполнитьТаблицуОрганизацийНаСервере();
	
	ТипЗапросаНачислений = "CHARGE";//по умолчанию
	ТипЗапросаПлатежей = "PAYMENT";//по умолчанию
	ВидПлательщика = "2";//юр. лицо - резидент
	
	Элементы.ГруппаСтраницыУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаИдПлат;// по умолчанию
	Элементы.ГруппаСтраницыОрганизацииОбычныеПлательщики.ТекущаяСтраница = Элементы.ГруппаОбычныеПлательщики;//по умолчанию
	Если Параметры.ЗапросНачисленийОрганизаций Тогда
		УсловияОтборовНачислений = 3;
		Элементы.ГруппаСтраницыОрганизацииОбычныеПлательщики.ТекущаяСтраница = Элементы.ГруппаСтраницаОрганизации;	
	КонецЕсли;
	Элементы.ГруппаСтраницыУсловийЗапросаПлатежей.ТекущаяСтраница = Элементы.ГруппаПлатежиПоУИН;// по умолчанию
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	КолКБК = ТаблицаКБК.Количество();
КонецПроцедуры


#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура УсловияОтборовНачилсенийПриИзменении(Элемент)
	Если УсловияОтборовНачислений = 0 Тогда
		Элементы.ГруппаСтраницыУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаИдПлат;
		Элементы.ГруппаСтраницыОрганизацииОбычныеПлательщики.ТекущаяСтраница = Элементы.ГруппаОбычныеПлательщики;
	ИначеЕсли УсловияОтборовНачислений = 1 Тогда
		Элементы.ГруппаСтраницыУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаУИН;
	ИначеЕсли УсловияОтборовНачислений = 2 Тогда
		Элементы.ГруппаСтраницыУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаВременнойИнтервал;
	ИначеЕсли УсловияОтборовНачислений = 3 Тогда
		Элементы.ГруппаСтраницыУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаИдПлат;
		Элементы.ГруппаСтраницыОрганизацииОбычныеПлательщики.ТекущаяСтраница = Элементы.ГруппаСтраницаОрганизации;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УсловияОтборовПлатежейПриИзменении(Элемент)
	Если УсловияОтборовПлатежей = 0 Тогда
		Элементы.ГруппаСтраницыУсловийЗапросаПлатежей.ТекущаяСтраница = Элементы.ГруппаПлатежиПоУИН;
	ИначеЕсли УсловияОтборовПлатежей = 1 Тогда
		Элементы.ГруппаСтраницыУсловийЗапросаПлатежей.ТекущаяСтраница = Элементы.ГруппаПлатежиПоИдПлат;
	ИначеЕсли УсловияОтборовПлатежей = 2 Тогда
		Элементы.ГруппаСтраницыУсловийЗапросаПлатежей.ТекущаяСтраница = Элементы.ГруппаПлатежиПоУИП;
	ИначеЕсли УсловияОтборовПлатежей = 3 Тогда
		Элементы.ГруппаСтраницыУсловийЗапросаПлатежей.ТекущаяСтраница = Элементы.ГруппаПлатежиЗаВременнойИнтервал;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидИдентификатораПриИзменении(Элемент)
	Если ВидИдентификатора = 0 Тогда
		Элементы.ГруппаИдентификаторПлательщикаИНН.ТекущаяСтраница = Элементы.ГруппаИдПлат;
	Иначе
		Элементы.ГруппаИдентификаторПлательщикаИНН.ТекущаяСтраница = Элементы.ГруппаИНН;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидПлательщикаПриИзменении(Элемент)
	Если ВидПлательщика = "1" Тогда
		ВидИдентификатора = 0;		
	ИначеЕсли ВидПлательщика = "2" Тогда
		//ничего не надо
	ИначеЕсли ВидПлательщика = "3" Тогда
		ВидИдентификатора = 0;
	ИначеЕсли ВидПлательщика = "4" Тогда
		ВидИдентификатора = 0;
	КонецЕсли;
	
	Элементы.ВидИдентификатора.ТолькоПросмотр = (ВидПлательщика <> "2");
	
	Если ВидИдентификатора = 0 Тогда
		Элементы.ГруппаИдентификаторПлательщикаИНН.ТекущаяСтраница = Элементы.ГруппаИдПлат;
	Иначе
		Элементы.ГруппаИдентификаторПлательщикаИНН.ТекущаяСтраница = Элементы.ГруппаИНН;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаОрганизации

&НаКлиенте
Процедура ТаблицаУчастникиИспользоватьПриИзменении(Элемент)
	ТекДанные = Элементы.ТаблицаОрганизации.ТекущиеДанные;
	Для Каждого ТекИд Из Элементы.ТаблицаОрганизации.ВыделенныеСтроки Цикл
		ТекСтр = ТаблицаОрганизации.НайтиПоИдентификатору(ТекИд);
		ТекСтр.Использовать = ТекДанные.Использовать;		
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

