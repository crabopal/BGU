#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьИдентификатор(Команда)
	ДобавляемыйИдентификатор = "";
	ТекстСообщения = "";
	Отказ = Ложь;
		
	Если ВидПлательщика = "2"
		И ВидИдентификатора = 1 Тогда
		//это юр. лицо
		//это ИНН юр. лица
		ТекИНН = СокрЛП(ИНН);
		Если ЗначениеЗаполнено(ТекИНН) Тогда
			
			Если СтрДлина(ТекИНН) = 10 Тогда
				//все ок
			Иначе
				ТекстСообщения = Нстр("ru='Поле ""ИНН"" заполнено не корректно.
					|Значение должно быть 10 символов.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ИНН",,Отказ);
			КонецЕсли;
			
		Иначе
			ТекстСообщения = Нстр("ru='Поле ""ИНН"" не заполнено.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ИНН",,Отказ);
		КонецЕсли;
		Если Отказ = Ложь Тогда
			ДобавляемыйИдентификатор = ТекИНН;
		КонецЕсли;
	Иначе
		//идентификатор плательщика
		
		ТекИД = СокрЛП(ИдентификаторПлательщика);
		Если ЗначениеЗаполнено(ТекИД) Тогда
			
			ДлинаПоля = СтрДлина(ТекИД);
			Если ДлинаПоля = 22 Тогда
				//все ок
			Иначе
				
				ТекстСообщения = Нстр("ru='Поле ""Идентификатор плательщика"" заполнено не корректно.
					|Значение должно быть 22 символа. Сейчас %1'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ДлинаПоля);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ИдентификаторПлательщика",,Отказ);
			КонецЕсли;
			
		Иначе
			ТекстСообщения = Нстр("ru='Поле ""Идентификатор плательщика"" не заполнено.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ИдентификаторПлательщика",,Отказ);
		КонецЕсли;
		Если Отказ = Ложь Тогда
			ДобавляемыйИдентификатор = ТекИД;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДобавляемыйИдентификатор) Тогда
		ДобавитьИдентификаторВТаблицу(ДобавляемыйИдентификатор);
		ИдентификаторПлательщика = "";
		ИНН = "";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗапросы(Команда)
	Отказ = Ложь;
	
	//проверка заполнения
	Если ЭтоЗапросНачислений Тогда
		Если УсловияОтборовНачислений = 0 Тогда // ИдПлат
			Если ТаблицаИдентификаторов.Количество()=0 Тогда
				ТекстСообщения = Нстр("ru='Не указаны идентификаторы плательщика для запроса.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ТаблицаИдентификаторов",,Отказ);
			КонецЕсли;
			
			Если ТаблицаИдентификаторов.Количество()>100 Тогда
				ТекстСообщения = Нстр("ru='Допустимо указывать не более 100 идентификаторов плательщика для отбора.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ТаблицаИдентификаторов",,Отказ);
			КонецЕсли; 
			
			Для Каждого СтрТЧ Из ТаблицаИдентификаторов Цикл
				ДлинаПоля = СтрДлина(СтрТЧ.ИдентификаторПлательщика);
				Если ДлинаПоля <> 22
					И ДлинаПоля <> 10 Тогда
					ТекстСообщения = Нстр("ru='В таблице идентификаторов плательщика указано значение %1 длиной %2.
						|Допустимы значения длиной 10 (ИНН юр. лица) или 22(идентификатор) симоволов.'");
					
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,СтрТЧ.ИдентификаторПлательщика,ДлинаПоля);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ТаблицаИдентификаторов",,Отказ);
				КонецЕсли;
			КонецЦикла;
				
			Если ЗначениеЗаполнено(ДатаНачала)
				ИЛИ ЗначениеЗаполнено(ДатаОкончания) Тогда
				
				//если заполнена одна дата, надо заполнить обе
				Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
					ТекстСообщения = Нстр("ru='Если требуется запрос за определенный временной интервал,
						|то нужно заполнить обе даты - начала и окончания.'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ДатаНачала",,Отказ);
				КонецЕсли;	
				Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
					ТекстСообщения = Нстр("ru='Если требуется запрос за определенный временной интервал,
						|то нужно заполнить обе даты - начала и окончания.'");
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ДатаОкончания",,Отказ);
				КонецЕсли;
				
			КонецЕсли;
						
			Для Каждого СтрТЧ Из ТаблицаКБК Цикл
				Если СтрТЧ.КБК = "0" 
					ИЛИ СтрДлина(СокрЛП(СтрТЧ.КБК)) = 20 Тогда
					//все ок
				Иначе
					ТекстСообщения = Нстр("ru='В таблице КБК указано значение %1 длиной %2.
						|Допустимые значения: 0, КБК из 20 символов.'");
					
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,СтрТЧ.КБК,СтрДлина(СтрТЧ.КБК));
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ТаблицаКБК",,Отказ);
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли УсловияОтборовНачислений = 1 Тогда
			//по УИН
			
			Если ТаблицаУИН.Количество()=0 Тогда
				ТекстСообщения = Нстр("ru='Не указаны идентификаторы начислений для запроса.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ТаблицаУИН",,Отказ);
			КонецЕсли;
			
			Если ТаблицаУИН.Количество()>100 Тогда
				ТекстСообщения = Нстр("ru='Допустимо указывать не более 100 идентификаторов начислений для отбора.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ТаблицаУИН",,Отказ);
			КонецЕсли;
			
			Для Каждого СтрТЧ Из ТаблицаУИН Цикл
				ДлинаУИН = СтрДлина(СтрТЧ.УИН);
				Если ДлинаУИН <> 20
					И ДлинаУИН <> 25 Тогда
					ТекстСообщения = Нстр("ru='В таблице уникальных иденитификаторов начислений указано значение %1 длиной %2.
						|Допустимы значения длиной 20 или 25 симоволов'");
					
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,СтрТЧ.УИН,ДлинаУИН);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ТаблицаУИН",,Отказ);
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли УсловияОтборовНачислений = 2 Тогда
			//за временной интервал
			
			//надо заполнить обе даты
			Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
				ТекстСообщения = Нстр("ru='Если требуется запрос за определенный временной интервал,
					|то нужно заполнить обе даты - начала и окончания.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ДатаНачала",,Отказ);
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
				ТекстСообщения = Нстр("ru='Если требуется запрос за определенный временной интервал,
					|то нужно заполнить обе даты - начала и окончания.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ДатаОкончания",,Отказ);
			КонецЕсли;
						
			Для Каждого СтрТЧ Из ТаблицаКБК Цикл
				Если СтрТЧ.КБК = "0" 
					ИЛИ СтрДлина(СокрЛП(СтрТЧ.КБК)) = 20 Тогда
					//все ок
				Иначе
					ТекстСообщения = Нстр("ru='В таблице КБК указано значение %1 длиной %2.
						|Допустимые значения: 0, КБК из 20 символов.'");
					
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,СтрТЧ.КБК,СтрДлина(СтрТЧ.КБК));
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ТаблицаКБК",,Отказ);
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли УсловияОтборовНачислений = 3 Тогда // организации ИБ
			КоличествоОтмеченныхОрганизаций = ТаблицаОрганизации.НайтиСтроки(Новый Структура("Использовать",Истина)).Количество();
			Если КоличествоОтмеченныхОрганизаций=0 Тогда
				ТекстСообщения = Нстр("ru='Не отмечены организации для запроса данных.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ТаблицаОрганизаций",,Отказ);
			КонецЕсли;
			
			Если КоличествоОтмеченныхОрганизаций>100 Тогда
