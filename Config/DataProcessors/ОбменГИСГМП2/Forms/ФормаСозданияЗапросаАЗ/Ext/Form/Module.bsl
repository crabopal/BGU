					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ДатаОкончания",,Отказ);
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли УсловияОтборовПлатежей = 1 Тогда
