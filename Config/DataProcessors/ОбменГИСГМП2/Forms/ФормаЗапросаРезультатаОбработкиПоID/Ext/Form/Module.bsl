
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения,
		|	ДанныеИсходящихСообщенийСМЭВ3.Данные КАК Данные,
		|	СообщенияИмпортаДанныхВСМЭВ3.ДатаОбмена КАК ДатаОбмена,
		|	СообщенияИмпортаДанныхВСМЭВ3.СтатусОтправки КАК СтатусОтправки,
		|	ВЫБОР
		|		КОГДА СообщенияИмпортаДанныхВСМЭВ3.СтатусОтправки В (&СтатусОтправки) И СообщенияЗапросаДанныхОчередиСМЭВ3.ГУИД ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Запросить
		|ИЗ
		|	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СообщенияЗапросаДанныхОчередиСМЭВ3 КАК СообщенияЗапросаДанныхОчередиСМЭВ3
		|		ПО СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = СообщенияЗапросаДанныхОчередиСМЭВ3.ИдентификаторСообщенияУчастника
		|			И СообщенияИмпортаДанныхВСМЭВ3.Организация = СообщенияЗапросаДанныхОчередиСМЭВ3.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК ДанныеИсходящихСообщенийСМЭВ3
		|		ПО СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения
		|ГДЕ
		|	СообщенияИмпортаДанныхВСМЭВ3.Организация = &Организация
		|	И СообщенияИмпортаДанныхВСМЭВ3.ДатаОбмена >= &ДатаОбмена
		|	И СообщенияИмпортаДанныхВСМЭВ3.СтатусОтправки В (&СтатусОтправки)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаОбмена УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", Параметры.Участник);
	
	ДатаОбмена = НачалоДня(ТекущаяДата()) - 30*86400;	
	Запрос.УстановитьПараметр("ДатаОбмена", ДатаОбмена);
	
	//отбор по статусу, если сообщение не было загружено или вернулась ошибка,
	//то и запрашивать ничего не нужно
	
	ЗапрашиваемыеСтатусы = Новый Массив;
	ЗапрашиваемыеСтатусы.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВОчереди);//передано в очередь
	ЗапрашиваемыеСтатусы.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ПолученПолучателем);//не известно, в каком случает устанавливается, но запросим
	ЗапрашиваемыеСтатусы.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВПроцессеОбработки);//обрабатывается, еще не готово
	
	Запрос.УстановитьПараметр("СтатусОтправки", ЗапрашиваемыеСтатусы);
	
	Результат = Запрос.Выполнить();
	ТаблицаОтправленныхСообщений.Загрузить(Результат.Выгрузить());
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаОтправленныхСообщений

&НаКлиенте
Процедура ТаблицаОтправленныхСообщенийЗапроситьПриИзменении(Элемент)
	
	УстанавливаемоеЗначение = Элементы.ТаблицаОтправленныхСообщений.ТекущиеДанные.Запросить;
	
	Для Каждого ТекИд Из Элементы.ТаблицаОтправленныхСообщений.ВыделенныеСтроки Цикл
		СтрТЧ = ТаблицаОтправленныхСообщений.НайтиПоИдентификатору(ТекИд);
		СтрТЧ.Запросить = УстанавливаемоеЗначение;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапроситьОтмеченные(Команда)
	
	МассивСтрок = ТаблицаОтправленныхСообщений.НайтиСтроки(Новый Структура("Запросить",Истина));
	Если МассивСтрок.Количество() = 0 Тогда
		Закрыть(Новый Массив);
		Возврат;
	КонецЕсли;
	
	МассивОтмеченных = Новый Массив;
	Для Каждого ТекСтр Из МассивСтрок Цикл
		МассивОтмеченных.Добавить(ТекСтр.ИдентификаторСообщения);	
	КонецЦикла;
	
	Закрыть(МассивОтмеченных);
	
КонецПроцедуры

&НаСервере
Процедура НеОбрабатыватьНаСервере(Знач ВыделенныеСтроки)
	ЗапрашиваемыеСтатусы = Новый Массив;
	ЗапрашиваемыеСтатусы.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВОчереди);//передано в очередь
	ЗапрашиваемыеСтатусы.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ПолученПолучателем);//не известно, в каком случает устанавливается, но запросим
	ЗапрашиваемыеСтатусы.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВПроцессеОбработки);
	
	Для Каждого ТекИд Из ВыделенныеСтроки Цикл
		СтрТЧ = ТаблицаОтправленныхСообщений.НайтиПоИдентификатору(ТекИД);
		Если ЗапрашиваемыеСтатусы.Найти(СтрТЧ.СтатусОтправки) <> Неопределено Тогда
			Запись = РегистрыСведений.СообщенияИмпортаДанныхВСМЭВ3.СоздатьМенеджерЗаписи();
			Запись.ИдентификаторСообщения = СтрТЧ.ИдентификаторСообщения;
			Запись.Организация = Параметры.Участник;
			Запись.Прочитать();
			Если Запись.Выбран() Тогда
				Запись.ИдентификаторСообщения = СтрТЧ.ИдентификаторСообщения;
				Запись.Организация = Параметры.Участник;
				Запись.СтатусОтправки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОбработан;
				Запись.Записать(Истина);
			КонецЕсли;
			СтрТЧ.Запросить = Ложь;
			СтрТЧ.СтатусОтправки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОбработан;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура НеОбрабатывать(Команда)
	
	НеОбрабатыватьНаСервере(Элементы.ТаблицаОтправленныхСообщений.ВыделенныеСтроки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

