				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ЗагруженныйОбъект</dcssch:dataPath>
					<dcssch:field>ЗагруженныйОбъект</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ДатаОбмена</dcssch:dataPath>
