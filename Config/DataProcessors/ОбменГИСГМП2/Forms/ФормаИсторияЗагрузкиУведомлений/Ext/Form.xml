				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ЕстьДанные</dcssch:dataPath>
					<dcssch:field>ЕстьДанные</dcssch:field>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ФорматОбмена</dcssch:dataPath>
