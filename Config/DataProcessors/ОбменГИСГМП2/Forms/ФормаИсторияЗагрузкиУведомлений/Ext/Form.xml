							<v8:content>Дата подтверждения</v8:content>
						</v8:item>
					</dcssch:title>
				</Field>
				<Field xsi:type="dcssch:DataSetFieldField">
					<dcssch:dataPath>ИдентификаторСообщенияСМЭВ</dcssch:dataPath>
					<dcssch:field>ИдентификаторСообщенияСМЭВ</dcssch:field>
