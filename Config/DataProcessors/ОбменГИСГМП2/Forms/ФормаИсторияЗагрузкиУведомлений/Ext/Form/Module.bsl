&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.Участник = Параметры.Участник;
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбмена,"Организация",Объект.Участник,Истина);
КонецПроцедуры

&НаКлиенте
Процедура ИсторияОбменаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ИсторияОбмена.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекДанные.ЗагруженныйОбъект) Тогда
		ПоказатьЗначение(,ТекДанные.ЗагруженныйОбъект);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Асинх Процедура СохранитьФайлыОбмена(Команда)
	
	ТекДанные = Элементы.ИсторияОбмена.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторСообщенияСМЭВ = ТекДанные.ИдентификаторСообщенияСМЭВ;
	ОписаниеФайла = СохранитьФайлыОбменаНаСервере(ИдентификаторСообщенияСМЭВ,УникальныйИдентификатор);
	
	Если ОписаниеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Диалог = Новый ПараметрыДиалогаПолученияФайлов;
	Диалог.ВыборКаталога = Истина;
	ПолучитьФайлССервераАсинх(ОписаниеФайла.Адрес,ОписаниеФайла.ИмяФайла,Диалог);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СохранитьФайлыОбменаНаСервере(ИдентификаторСообщенияСМЭВ, УникальныйИдентификатор)
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СообщенияПодтвержденияПолученияДанныхИзСМЭВ3.ДатаЗапроса КАК ДатаПодтверждения,
		|	ВложенныйЗапрос.ДатаОтвета КАК ДатаОтвета,
		|	ВложенныйЗапрос.ЗагруженныйОбъект КАК ЗагруженныйОбъект,
		|	ВложенныйЗапрос.БылИзменен КАК БылИзменен,
		|	ВложенныйЗапрос.ИдентификаторСообщенияСМЭВ КАК ИдентификаторСообщенияСМЭВ,
		|	ВложенныйЗапрос.ФорматОбмена КАК ФорматОбмена,
		|	СообщенияПодтвержденияПолученияДанныхИзСМЭВ3.СообщениеЗапросПодтверждения КАК AckRequest,
		|	СообщенияПодтвержденияПолученияДанныхИзСМЭВ3.СообщениеОтветПодтверждения КАК AckResponse,
		|	ВложенныйЗапрос.СообщениеЗапрос КАК GetRequestRequest,
		|	ВложенныйЗапрос.СообщениеОтвет КАК GetRequestResponse
		|ИЗ
		|	(ВЫБРАТЬ
		|		СообщенияЗапросаДанныхОчередиСМЭВ3.ДатаОтвета КАК ДатаОтвета,
		|		СообщенияЗапросаДанныхОчередиСМЭВ3.ИдентификаторСообщенияСМЭВ КАК ИдентификаторСообщенияСМЭВ,
		|		СообщенияЗапросаДанныхОчередиСМЭВ3.ЕстьДанные КАК ЕстьДанные,
		|		СообщенияЗапросаДанныхОчередиСМЭВ3.ФорматОбмена КАК ФорматОбмена,
		|		ЗагруженныеДанныеСМЭВ3.ЗагруженныйОбъект КАК ЗагруженныйОбъект,
		|		ЗагруженныеДанныеСМЭВ3.БылИзменен КАК БылИзменен,
		|		СообщенияЗапросаДанныхОчередиСМЭВ3.Организация КАК Организация,
		|		СообщенияЗапросаДанныхОчередиСМЭВ3.СообщениеЗапрос КАК СообщениеЗапрос,
		|		СообщенияЗапросаДанныхОчередиСМЭВ3.СообщениеОтвет КАК СообщениеОтвет
		|	ИЗ
		|		(ВЫБРАТЬ
		|			СообщенияЗапросаДанныхОчередиСМЭВ3.ДатаЗапроса КАК ДатаОтвета,
		|			СообщенияЗапросаДанныхОчередиСМЭВ3.ИдентификаторСообщенияСМЭВ КАК ИдентификаторСообщенияСМЭВ,
		|			СообщенияЗапросаДанныхОчередиСМЭВ3.ЕстьДанные КАК ЕстьДанные,
		|			СообщенияЗапросаДанныхОчередиСМЭВ3.ФорматОбмена КАК ФорматОбмена,
		|			СообщенияЗапросаДанныхОчередиСМЭВ3.Организация КАК Организация,
		|			СообщенияЗапросаДанныхОчередиСМЭВ3.СообщениеЗапрос КАК СообщениеЗапрос,
		|			СообщенияЗапросаДанныхОчередиСМЭВ3.СообщениеОтвет КАК СообщениеОтвет
		|		ИЗ
		|			РегистрСведений.СообщенияЗапросаДанныхОчередиСМЭВ3 КАК СообщенияЗапросаДанныхОчередиСМЭВ3
		|		ГДЕ
		|			СообщенияЗапросаДанныхОчередиСМЭВ3.ИдентификаторСообщенияСМЭВ В(&ИдентификаторСообщенияСМЭВ)) КАК СообщенияЗапросаДанныхОчередиСМЭВ3
		|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				ЗагруженныеДанныеСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения,
		|				ЗагруженныеДанныеСМЭВ3.ЗагруженныйОбъект КАК ЗагруженныйОбъект,
		|				ЗагруженныеДанныеСМЭВ3.ДатаОбмена КАК ДатаОбмена,
		|				ЗагруженныеДанныеСМЭВ3.БылИзменен КАК БылИзменен
		|			ИЗ
		|				РегистрСведений.ЗагруженныеДанныеСМЭВ3 КАК ЗагруженныеДанныеСМЭВ3
		|			ГДЕ
		|				ЗагруженныеДанныеСМЭВ3.ИдентификаторСообщения В(&ИдентификаторСообщенияСМЭВ)) КАК ЗагруженныеДанныеСМЭВ3
		|			ПО (ЗагруженныеДанныеСМЭВ3.ИдентификаторСообщения = СообщенияЗапросаДанныхОчередиСМЭВ3.ИдентификаторСообщенияСМЭВ)) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СообщенияПодтвержденияПолученияДанныхИзСМЭВ3 КАК СообщенияПодтвержденияПолученияДанныхИзСМЭВ3
		|		ПО ВложенныйЗапрос.ИдентификаторСообщенияСМЭВ = СообщенияПодтвержденияПолученияДанныхИзСМЭВ3.ИдентификаторСообщенияСМЭВ
		|			И ВложенныйЗапрос.Организация = СообщенияПодтвержденияПолученияДанныхИзСМЭВ3.Организация";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщенияСМЭВ", ИдентификаторСообщенияСМЭВ);
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	ТаблицаИменИПояснений = Новый ТаблицаЗначений;
	ТаблицаИменИПояснений.Колонки.Добавить("ИмяЗначения");
	ТаблицаИменИПояснений.Колонки.Добавить("ИмяФайла");
		
	НовСтр = ТаблицаИменИПояснений.Добавить();
	НовСтр.ИмяЗначения = "GetRequestRequest";
	НовСтр.ИмяФайла = "1.1.GetRequestRequest - шаг 1 (запрос).txt";
	
	НовСтр = ТаблицаИменИПояснений.Добавить();
	НовСтр.ИмяЗначения = "GetRequestResponse";
	НовСтр.ИмяФайла = "1.2.GetRequestResponse - шаг 1 (ответ).txt";
	
	НовСтр = ТаблицаИменИПояснений.Добавить();
	НовСтр.ИмяЗначения = "AckRequest";
	НовСтр.ИмяФайла = "2.1.AckRequest - шаг 2 (запрос).txt";
	
	НовСтр = ТаблицаИменИПояснений.Добавить();
	НовСтр.ИмяЗначения = "AckResponse";
	НовСтр.ИмяФайла = "2.2.AckResponse - шаг 2 (ответ).txt";
	
	Инд = 0;
	МассивИменФайлов = Новый Массив; //бывает по одному документу несколько сообщений, поэтому для корректной выгрузки нужно добавлять суффикс
	
	Пока Выборка.Следующий() Цикл
		ТекКаталогАрхива = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПолучитьИмяВременногоФайла());
		СоздатьКаталог(ТекКаталогАрхива);
		ТекАрхиватор = Новый ЗаписьZipФайла();
		
		Если ЗначениеЗаполнено(Выборка.ЗагруженныйОбъект) Тогда
			НачалоИмени = Строка(Выборка.ЗагруженныйОбъект)+", по подписке,";
		Иначе
			НачалоИмени = "Уведомление по подписке, ";
		КонецЕсли;
		
		СохраняемоеИмяОтдельногоАрхива = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(НачалоИмени+" обмен от "+Выборка.ДатаОтвета," ");
				
		Если МассивИменФайлов.Найти(СохраняемоеИмяОтдельногоАрхива) = Неопределено Тогда
			МассивИменФайлов.Добавить(СохраняемоеИмяОтдельногоАрхива);
		Иначе
			Инд = Инд + 1;
			СохраняемоеИмяОтдельногоАрхива = СохраняемоеИмяОтдельногоАрхива + "("+Инд+")";
			МассивИменФайлов.Добавить(СохраняемоеИмяОтдельногоАрхива);
		КонецЕсли;
		
		СохраняемоеИмяОтдельногоАрхива = СохраняемоеИмяОтдельногоАрхива + ".zip";
		
		Для Каждого СтрТЧ Из ТаблицаИменИПояснений Цикл
			Если ТипЗнч(Выборка[СтрТЧ.ИмяЗначения]) = Тип("ХранилищеЗначения") Тогда
				ЗаписываемоеЗначение = Выборка[СтрТЧ.ИмяЗначения].Получить();
				Если ЗначениеЗаполнено(ЗаписываемоеЗначение) Тогда
					ТекИмя = ПолучитьИмяВременногоФайла("txt");
					ЗаписьТекста = Новый ЗаписьТекста(ТекИмя,КодировкаТекста.UTF8);
					ЗаписьТекста.Записать(ЗаписываемоеЗначение);
					ЗаписьТекста.Закрыть();
					
					ДДанные = Новый ДвоичныеДанные(ТекИмя);				
					Если Сред(ДДанные, 1, 8) = "EF BB BF" Тогда
						Строка64 = Base64Строка(ДДанные);
						Строка64 = Прав(Строка64,СтрДлина(Строка64)-4); // Удаляем 3 символа BOM
						ДДанные = Base64Значение(Строка64);
						ДДанные.Записать(ТекИмя);
						
						Строка64 = Неопределено
					КонецЕсли;
					ДДанные = Неопределено;
					
					ПереместитьФайл(ТекИмя, ТекКаталогАрхива + СтрТЧ.ИмяФайла);
					ТекАрхиватор.Добавить(ТекКаталогАрхива + СтрТЧ.ИмяФайла);
			
				КонецЕсли;
							
			КонецЕсли;
				
		КонецЦикла;
		
		ДДАрхива = ТекАрхиватор.ПолучитьДвоичныеДанные();
		ТекАрхиватор = Неопределено;
		Попытка
			УдалитьФайлы(ТекКаталогАрхива);
		Исключение
			
		КонецПопытки;
		
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("ИмяФайла", СохраняемоеИмяОтдельногоАрхива);
		ОписаниеФайла.Вставить("Адрес", ПоместитьВоВременноеХранилище(ДДАрхива,УникальныйИдентификатор));		
		
		Возврат ОписаниеФайла;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура УчастникПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбмена,"Организация",Объект.Участник,Истина);
КонецПроцедуры




