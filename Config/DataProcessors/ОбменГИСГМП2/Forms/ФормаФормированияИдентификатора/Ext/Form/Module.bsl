

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВидПлательщика = Параметры.ВидПлательщика;
	
	Если НЕ ЗначениеЗаполнено(ВидДок) Тогда
		ВидДок = "01";//паспорт РФ
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидПлательщика) Тогда
		ВидПлательщика = "2";//юр.лицо
	КонецЕсли;
	
	УстановитьВидимостьЭлементов(ЭтотОбъект,ВидПлательщика);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидПлательщикаПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов(ЭтотОбъект,ВидПлательщика);	
	 
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	ИдентификаторПлательщика = "";
	Отказ = Ложь;
	
	Если ВидПлательщика = "4" Тогда
		//ИП
		ТекИННИП = СокрЛП(ИННИП);
		Если ЗначениеЗаполнено(ТекИННИП)
			И СтрДлина(СокрЛП(ТекИННИП)) = 12 Тогда
			//все ок
		Иначе
			Если НЕ ЗначениеЗаполнено(ТекИННИП) Тогда
				ТекстСообщения = Нстр("ru='Поле ""ИНН физ. лица"" не заполнено.'");
			Иначе
				ТекстСообщения = Нстр("ru='Поле ""ИНН физ. лица"" заполнено не корректно. 
					|ИНН физ.лица должно быть 12 символов.'");
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ИННИП",,Отказ);
		КонецЕсли;
		
		Если Отказ = Ложь Тогда
			ТекИд = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ТекИННИП,21,"0","Слева");
			ИдентификаторПлательщика = ВидПлательщика + ТекИд;
		КонецЕсли;
		
	ИначеЕсли ВидПлательщика = "3" Тогда
		
		ТекИНН = СокрЛП(ИНН);
		ДлинаИНН = СтрДлина(ТекИНН);
		Если ЗначениеЗаполнено(ТекИНН) Тогда
			Если (ДлинаИНН = 5
				ИЛИ ДлинаИНН = 10) Тогда
				//Все ок
			Иначе
				ТекстСообщения = Нстр("ru='Поле ""ИНН/КИО"" заполнено не корректно.
					|Значение должно быть 5 (КИО) или 10 (ИНН) символов.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ИНН",,Отказ);
			КонецЕсли;
		Иначе
			ТекстСообщения = Нстр("ru='Поле ""ИНН/КИО"" не заполнено.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ИНН",,Отказ);
		КонецЕсли;
		
		ТекКПП = СокрЛП(КПП);
		Если ЗначениеЗаполнено(ТекКПП) Тогда
			Если СтрДлина(ТекКПП) = 9 Тогда
				//Все ок
			Иначе
				ТекстСообщения = Нстр("ru='Поле ""КПП"" заполнено не корректно.
					|Значение должно быть 9 символов.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"КПП",,Отказ);
			КонецЕсли;
		Иначе
			ТекстСообщения = Нстр("ru='Поле """"КПП"""" не заполнено.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"КПП",,Отказ);
		КонецЕсли;
		
		Если Отказ = Ложь Тогда
			ТекИд = ТекИНН + ТекКПП;
			ТекИд = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ТекИд,21,"0","Слева");
			ИдентификаторПлательщика = ВидПлательщика + ТекИд;
		КонецЕсли;
	ИначеЕсли ВидПлательщика = "2" Тогда
		
		ТекИНН = СокрЛП(ИНН);
		ДлинаИНН = СтрДлина(ТекИНН);
		Если ЗначениеЗаполнено(ТекИНН) Тогда
			Если ДлинаИНН = 10 Тогда
				//Все ок
			Иначе
				ТекстСообщения = Нстр("ru='Поле ""ИНН"" заполнено не корректно.
					|Значение должно быть 10 символов.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ИНН",,Отказ);
			КонецЕсли;
		Иначе
			ТекстСообщения = Нстр("ru='Поле ""ИНН"" не заполнено.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ИНН",,Отказ);
		КонецЕсли;
		
		ТекКПП = СокрЛП(КПП);
		Если ЗначениеЗаполнено(ТекКПП) Тогда
			Если СтрДлина(ТекКПП) = 9 Тогда
				//Все ок
			Иначе
				ТекстСообщения = Нстр("ru='Поле ""КПП"" заполнено не корректно.
					|Значение должно быть 9 символов.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"КПП",,Отказ);
			КонецЕсли;
		Иначе
			ТекстСообщения = Нстр("ru='Поле ""КПП"" не заполнено.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"КПП",,Отказ);
		КонецЕсли;
		
		Если Отказ = Ложь Тогда
			ТекИд = ТекИНН + ТекКПП;
			ТекИд = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ТекИд,21,"0","Слева");
			ИдентификаторПлательщика = ВидПлательщика + ТекИд;
		КонецЕсли;
		
	ИначеЕсли ВидПлательщика = "1" Тогда
		Если ЗначениеЗаполнено(ВидДок) Тогда
			//все ок
		Иначе
			ТекстСообщения = Нстр("ru='Поле ""Вид документа"" не заполнено.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ВидДок",,Отказ);
		КонецЕсли;
		
		ТекСерияИНомер = СокрЛП(СерияИНомер);
		
		ДлинаИдн = СтрДлина(ТекСерияИНомер);  
		
		Диапазоны = Новый Массив;
		Диапазоны.Добавить(Новый Структура("Мин,Макс", 48, 57)); 		// цифры
		Диапазоны.Добавить(Новый Структура("Мин,Макс", 65, 90)); 		// латиница большие
		Диапазоны.Добавить(Новый Структура("Мин,Макс", 97, 122)); 		// латиница маленькие
		Диапазоны.Добавить(Новый Структура("Мин,Макс", 1040, 1103)); 	// кириллица
		КонечныйИдн = "";
		Для Идн = 1 По ДлинаИдн Цикл
			Символ = Сред(ТекСерияИНомер,Идн,1);
			КодСимвола = КодСимвола(Символ);
			Для Каждого Диапазон Из Диапазоны Цикл
				Если КодСимвола >= Диапазон.Мин И КодСимвола <= Диапазон.Макс Тогда
					КонечныйИдн = КонечныйИдн + Символ;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	
		Если ЗначениеЗаполнено(КонечныйИдн) Тогда
			//все ок
		Иначе
			ТекстСообщения = Нстр("ru='Поле """"Серия и номер"""" не заполнено.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"СерияИНомер",,Отказ);
		КонецЕсли;
		
		Если Отказ = Ложь Тогда
			ТекИд = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(КонечныйИдн,19,"0","Слева");
			ТекИд = ВидДок + ТекИд;
			ИдентификаторПлательщика = ВидПлательщика + ТекИд;
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ИдентификаторПлательщика) Тогда
		Закрыть(ИдентификаторПлательщика);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(ТекФорма,ВидПлательщика)
	Если ВидПлательщика = "2"
		ИЛИ ВидПлательщика = "3" Тогда
		
		Если ВидПлательщика = "3" Тогда
			ТекФорма.Элементы.ИНН.Заголовок = "ИНН / КИО";
		Иначе
			ТекФорма.Элементы.ИНН.Заголовок = "ИНН";
		КонецЕсли;
		
		ТекФорма.Элементы.ГруппаВидыИдентификаторов.ТекущаяСтраница = ТекФорма.Элементы.ГруппаЮрЛицо;
		
	ИначеЕсли ВидПлательщика = "4" Тогда
		ТекФорма.Элементы.ГруппаВидыИдентификаторов.ТекущаяСтраница = ТекФорма.Элементы.ГруппаИП;
	Иначе
		ТекФорма.Элементы.ГруппаВидыИдентификаторов.ТекущаяСтраница = ТекФорма.Элементы.ГруппаФизЛицо;		
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти