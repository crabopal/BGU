
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ВремяЗапросаДанныхИзОчереди = Параметры.ВремяЗапросаДанныхИзОчереди;
	ВыполнятьЗапросДанныхПослеОтправкиСообщения = Параметры.ВыполнятьЗапросДанныхПослеОтправкиСообщения;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВремяЗапросаДанныхИзОчередиПриИзменении(Элемент)
	Если ВремяЗапросаДанныхИзОчереди = 0 Тогда
		ВыполнятьЗапросДанныхПослеОтправкиСообщения = Ложь;
	Иначе
		ВыполнятьЗапросДанныхПослеОтправкиСообщения = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Применить(Команда)
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("ВыполнятьЗапросДанныхПослеОтправкиСообщения",ВыполнятьЗапросДанныхПослеОтправкиСообщения);
	СтруктураРезультата.Вставить("ВремяЗапросаДанныхИзОчереди",ВремяЗапросаДанныхИзОчереди);
	
	Закрыть(СтруктураРезультата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти






