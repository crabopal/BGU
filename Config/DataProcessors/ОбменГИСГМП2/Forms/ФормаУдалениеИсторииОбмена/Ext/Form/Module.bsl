
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Период = НачалоГода(ТекущаяДата())-1;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьИсториюОбмена(Команда)
	ОчиститьСообщения();
	ОчиститьИсториюОбменаНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОчиститьИсториюОбменаНаСервере()
	
	Обработки.ОбменГИСГМП2.УдалитьИсториюОбменаНаСервере(Период,Истина);	
	
	ОчиститьСлужебныеСообщенияОбменаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСлужебныеСообщенияОбмена(Команда)
	ОчиститьСообщения();
	ОчиститьСлужебныеСообщенияОбменаНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОчиститьСлужебныеСообщенияОбменаНаСервере()
	
	Обработки.ОбменГИСГМП2.УдалитьСлужебныеСообщенияОбмена(Истина);
	
КонецПроцедуры




