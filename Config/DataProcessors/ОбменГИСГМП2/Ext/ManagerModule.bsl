		ЗаполнитьЗначенияСвойств(Запись,Выборка);
		Запись.Удалить();
		
	КонецЦикла;
	
	//СообщенияПодтвержденияПолученияДанныхИзСМЭВ3
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	   |	ДанныеРС.Организация КАК Организация,
	   |	ДанныеРС.ИдентификаторСообщенияСМЭВ КАК ИдентификаторСообщенияСМЭВ
	   |ИЗ
	   |	РегистрСведений.СообщенияПодтвержденияПолученияДанныхИзСМЭВ3 КАК ДанныеРС
	   |ГДЕ
	   |	ДанныеРС.ДатаЗапроса <= &ДатаОбмена";
	
	Запрос.УстановитьПараметр("ДатаОбмена",КонецДня(Период));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Количество + Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.СообщенияПодтвержденияПолученияДанныхИзСМЭВ3.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись,Выборка);
		Запись.Удалить();
		
	КонецЦикла;
	
	//ЗагруженныеДанныеСМЭВ3
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	   |	ДанныеРС.ЗапросКСМЭВ КАК ЗапросКСМЭВ,
	   |	ДанныеРС.ЗагруженныйОбъект КАК ЗагруженныйОбъект,
	   |	ДанныеРС.ИдентификаторСообщения КАК ИдентификаторСообщения
	   |ИЗ
	   |	РегистрСведений.ЗагруженныеДанныеСМЭВ3 КАК ДанныеРС
	   |ГДЕ
	   |	ДанныеРС.ДатаОбмена <= &ДатаОбмена";
	
	Запрос.УстановитьПараметр("ДатаОбмена",КонецДня(Период));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Количество + Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.ЗагруженныеДанныеСМЭВ3.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись,Выборка);
		Запись.Удалить();
		
	КонецЦикла;
	
	//СообщенияЗапросаДанныхОчередиСМЭВ3
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	   |	ДанныеРС.Организация КАК Организация,
	   |	ДанныеРС.ГУИД КАК ГУИД
	   |ИЗ
	   |	РегистрСведений.СообщенияЗапросаДанныхОчередиСМЭВ3 КАК ДанныеРС
	   |ГДЕ
	   |	ДанныеРС.ДатаЗапроса <= &ДатаОбмена";
	
	Запрос.УстановитьПараметр("ДатаОбмена",КонецДня(Период));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Количество + Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.СообщенияЗапросаДанныхОчередиСМЭВ3.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись,Выборка);
		Запись.Удалить();
		
	КонецЦикла;
	
	Если СообщатьОРезультате = Истина Тогда
		Текст = Нстр("ru='Удалено записей истории: %1'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,Количество);	
		ОбщегоНазначения.СообщитьПользователю(Текст);
	КонецЕсли;
	
КонецПроцедуры
	
