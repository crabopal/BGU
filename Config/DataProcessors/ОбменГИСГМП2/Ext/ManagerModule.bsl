#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура УдалитьСлужебныеСообщенияОбмена(СообщатьОРезультате = Истина) Экспорт
	
	Количество = 0;
	//СообщенияЗапросаДанныхОчередиСМЭВ3
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	   |	ДанныеРС.Организация КАК Организация,
	   |	ДанныеРС.ГУИД КАК ГУИД
	   |ИЗ
	   |	РегистрСведений.СообщенияЗапросаДанныхОчередиСМЭВ3 КАК ДанныеРС
	   |ГДЕ
	   |	ДанныеРС.ЕстьДанные = ЛОЖЬ";
		
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.СообщенияЗапросаДанныхОчередиСМЭВ3.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись,Выборка);
		Запись.Удалить();
		
	КонецЦикла;
	Если СообщатьОРезультате = Истина Тогда
		Текст = Нстр("ru='Удалено служебных записей: %1'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,Количество);
		ОбщегоНазначения.СообщитьПользователю(Текст);
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьИсториюОбменаНаСервере(Период, СообщатьОРезультате = Истина) Экспорт
	
	Количество = 0;
	
	//ДанныеИсходящихСообщенийСМЭВ3
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
       |	ДанныеИсходящихСообщенийСМЭВ3.Организация КАК Организация,
       |	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения,
       |	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторДанных КАК ИдентификаторДанных
       |ИЗ
       |	РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК ДанныеИсходящихСообщенийСМЭВ3
       |ГДЕ
       |	ДанныеИсходящихСообщенийСМЭВ3.ДатаОбмена <= &ДатаОбмена";
	
	Запрос.УстановитьПараметр("ДатаОбмена",КонецДня(Период));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Количество + Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.ДанныеИсходящихСообщенийСМЭВ3.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись,Выборка);
		Запись.Удалить();
		
	КонецЦикла;
	
	//СообщенияИмпортаДанныхВСМЭВ3
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	   |	ДанныеРС.Организация КАК Организация,
	   |	ДанныеРС.ИдентификаторСообщения КАК ИдентификаторСообщения
	   |ИЗ
	   |	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК ДанныеРС
	   |ГДЕ
	   |	ДанныеРС.ДатаОбмена <= &ДатаОбмена";
	
	Запрос.УстановитьПараметр("ДатаОбмена",КонецДня(Период));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Количество + Выборка.Количество();
