
#Область ОбъявлениеПеременныхМодуля

&НаКлиенте
Перем ВыполняетсяЗакрытие; // используется для проверки необходимости вызова вопроса при закрытии
&НаКлиенте
Перем ИндексДобавленнойСтроки; // используется для активизации последней добавленной строки

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ЗакрыватьПриВыборе = Ложь;
	
	СписокСвойств = "ДатаРасчетов, ЕстьЦена, Заголовок, Организация, ПоказыватьОстатки, ТипЦен, ЦМО";
		
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, СписокСвойств);
	
	Если Параметры.Свойство("ЭтоРМК") Тогда 
		ЭтоРМК = Параметры.ЭтоРМК;		
	Иначе	
		ЭтоРМК = Ложь;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДатаРасчетов) Тогда
		ДатаРасчетов = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Параметры.ИспользуетсяДоговорПлатежногоАгента Тогда 
		Если ЗначениеЗаполнено(Параметры.ПараметрыДоговораПлатежногоАгента) Тогда
			БыстрыйОтборПараметрыДоговораПлатежногоАгента = Параметры.Подразделение;
			ЭтаФорма.БыстрыйОтборПараметрыДоговораПлатежногоАгентаИспользование = Истина;
			ЭтаФорма.БыстрыйОтборПараметрыДоговораПлатежногоАгента = Параметры.ПараметрыДоговораПлатежногоАгента;
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Параметры.Подразделение) Тогда 
		БыстрыйОтборПодразделение = Параметры.Подразделение;
		ЭтаФорма.БыстрыйОтборПодразделениеИспользование = Истина;
		ЭтаФорма.БыстрыйОтборПодразделение = Параметры.Подразделение;
	КонецЕсли;	
		
	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ПодборНоменклатурыИзПрейскуранта", "");
	Если Настройки <> Неопределено Тогда
		Если Настройки.Свойство("ИсторияПоискаНоменклатуры") Тогда
			Элементы.СтрокаПоиска.СписокВыбора.ЗагрузитьЗначения(Настройки.ИсторияПоискаНоменклатуры);
		КонецЕсли;
		Если Настройки.Свойство("ЗапрашиватьКоличество") Тогда
			ЗапрашиватьКоличество = Настройки.ЗапрашиватьКоличество;
		КонецЕсли;
		Если Настройки.Свойство("ЗапрашиватьЦену") Тогда
			ЗапрашиватьЦену = Настройки.ЗапрашиватьЦену;
		КонецЕсли;
		Если Настройки.Свойство("НеВыводитьНоменклатуруБезЦены") Тогда
			НеВыводитьНоменклатуруБезЦены = Настройки.НеВыводитьНоменклатуруБезЦены;
		КонецЕсли;
		Если Настройки.Свойство("ПоказыватьСнятыеСПродажи") Тогда
			ПоказыватьСнятыеСПродажи = Настройки.ПоказыватьСнятыеСПродажи;
		КонецЕсли;
		Если Настройки.Свойство("НеВыводитьНоменклатуруБезОстатка") Тогда
			НеВыводитьНоменклатуруБезОстатка = Настройки.НеВыводитьНоменклатуруБезОстатка;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.Заголовок) Тогда
		Заголовок = Параметры.Заголовок;
		АвтоЗаголовок = Ложь;
	КонецЕсли;
	
	УправлениеСписком();
	СформироватьИнформационнуюНадпись(ЭтаФорма);
	УстановитьВидимостьЭлементов();
	УстановитьОтборСпискаНоменклатуры(ЭтаФорма, Новый Структура("ПоказыватьСнятыеСПродажи, НеВыводитьНоменклатуруБезЦены, ЕстьЦена, НеВыводитьНоменклатуруБезОстатка, ПоказыватьОстатки", 
		ПоказыватьСнятыеСПродажи, НеВыводитьНоменклатуруБезЦены, ЕстьЦена, НеВыводитьНоменклатуруБезОстатка, ПоказыватьОстатки));
	УстановитьОтборПодразделение(ЭтаФорма);
	
	УстановитьОтборПараметрыДоговораПлатежногоАгента(ЭтаФорма);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ВыполняетсяЗакрытие <> Истина Тогда
		Если Не ПеренестиВДокумент И Объект.ПодобраннаяНоменклатура.Количество() > 0 Тогда

			Отказ = Истина;
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
				НСтр("ru = 'Подобранные товары не перенесены в документ.
				|
				|Перенести?'"), РежимДиалогаВопрос.ДаНетОтмена);
			
			Возврат;

		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("ИсторияПоискаНоменклатуры"			, Элементы.СтрокаПоиска.СписокВыбора.ВыгрузитьЗначения());
	ПараметрыЗакрытия.Вставить("ЗапрашиватьКоличество"    			, ЗапрашиватьКоличество);
	ПараметрыЗакрытия.Вставить("ЗапрашиватьЦену"          			, ЗапрашиватьЦену);
	ПараметрыЗакрытия.Вставить("НеВыводитьНоменклатуруБезЦены"		, НеВыводитьНоменклатуруБезЦены);
	ПараметрыЗакрытия.Вставить("ПоказыватьСнятыеСПродажи"			, ПоказыватьСнятыеСПродажи);
	ПараметрыЗакрытия.Вставить("НеВыводитьНоменклатуруБезОстатка"	, НеВыводитьНоменклатуруБезОстатка);

	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("ПодборНоменклатурыИзПрейскуранта", "", ПараметрыЗакрытия);
	ПеренестиНоменклатуруВДокумент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.ВладелецФормы.Объект.Ссылка) Тогда
		ПозицияВ = Найти(ЭтаФорма.Заголовок," в ");
		ЭтаФорма.Заголовок = Лев(ЭтаФорма.Заголовок,ПозицияВ+2) + """"
		+ ТипЗнч(ЭтаФорма.ВладелецФормы.Объект.Ссылка) + " от " + ЭтаФорма.ВладелецФормы.Объект.Дата + """ "
		+ Сред(ЭтаФорма.Заголовок,ПозицияВ+3);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)
	
	ПрименитьПоиск();

КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборПодразделениеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(БыстрыйОтборПодразделение) Тогда
		БыстрыйОтборПодразделениеИспользование = Истина;
	КонецЕсли;
	УстановитьОтборПодразделение(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборПодразделениеИспользованиеПриИзменении(Элемент)
	
	УстановитьОтборПодразделение(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Выбор(Команда)
	
	Если НЕ Элементы.СписокНоменклатуры.ТекущиеДанные = Неопределено Тогда 
		ВыполнитьИтерациюВыбораНоменклатуры(Элементы.СписокНоменклатуры.ВыделенныеСтроки, 0);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборПараметрыДоговораПлатежногоАгентаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(БыстрыйОтборПараметрыДоговораПлатежногоАгента) Тогда
		БыстрыйОтборПараметрыДоговораПлатежногоАгентаИспользование = Истина;
	КонецЕсли;
	УстановитьОтборПараметрыДоговораПлатежногоАгента(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборПараметрыДоговораПлатежногоАгентаИспользованиеПриИзменении(Элемент)
	
	УстановитьОтборПараметрыДоговораПлатежногоАгента(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СПИСОК_НОМЕНКЛАТУРЫ

&НаКлиенте
Процедура СписокНоменклатурыВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ВыполнитьИтерациюВыбораНоменклатуры(Элементы.СписокНоменклатуры.ВыделенныеСтроки, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ВыполнитьИтерациюВыбораНоменклатуры(Элементы.СписокНоменклатуры.ВыделенныеСтроки, 0);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ПОДОБРАННАЯ_НОМЕНКЛАТУРА

&НаКлиенте
Процедура ПодобраннаяНоменклатураКоличествоПриИзменении(Элемент)
	
	ПересчитатьСумму();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобраннаяНоменклатураЦенаПриИзменении(Элемент)
	
	ПересчитатьСумму();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобраннаяНоменклатураПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобраннаяНоменклатураПослеУдаления(Элемент)
	
	СформироватьИнформационнуюНадпись(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ИЕРАРХИЯ_НОМЕНКЛАТУРЫ

&НаКлиенте
Процедура ИерархияНоменклатурыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	УстановитьОтборПоИерархииНоменклатуры(ВыбраннаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ИерархияНоменклатурыПриАктивизацииСтроки(Элемент)

	УстановитьОтборПоИерархииНоменклатуры(Элементы.ИерархияНоменклатуры.ТекущаяСтрока);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Настройки(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЕстьЦена"					, ЕстьЦена);
	ПараметрыФормы.Вставить("ВедетсяКонтрольОстатков"	, ПоказыватьОстатки);
	Результат = Неопределено;

	ОткрытьФорму("Обработка.ПодборИзПрейскуранта.Форма.НастройкиПодбора", ПараметрыФормы, ЭтаФорма,,,,
		Новый ОписаниеОповещения("НастройкиЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбрать(Команда)
	
	Если НЕ Элементы.СписокНоменклатуры.ТекущиеДанные = Неопределено Тогда 
		ВыполнитьИтерациюВыбораНоменклатуры(Элементы.СписокНоменклатуры.ВыделенныеСтроки, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУдалитьСтроку(Команда)
	
	ТекущаяСтрока = Элементы.ПодобраннаяНоменклатура.ТекущиеДанные;
	Если НЕ ТекущаяСтрока = Неопределено Тогда 
		Объект.ПодобраннаяНоменклатура.Удалить(ТекущаяСтрока.НомерСтроки - 1);
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаОчиститьПодбор(Команда)
	
	Объект.ПодобраннаяНоменклатура.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		ВыполняетсяЗакрытие = Истина;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
	Иначе
		Возврат;
	КонецЕсли;
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()

		// Остатки
	ИменаЭлементовОстатков = Новый Массив;
	ИменаЭлементовОстатков.Добавить("СписокНоменклатурыКоличествоОстаток");
	ИменаЭлементовОстатков.Добавить("ПодбиратьВсе");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовОстатков, "Видимость", ПоказыватьОстатки);
			
	// Цены и тип цены
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СписокНоменклатурыЦена", "Видимость",
		(ЕстьЦена));
		
	//Панель РМК
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПанельДляРМК", "Видимость", ЭтоРМК);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаКомандныеПанели", "Видимость", НЕ ЭтоРМК);
	
		Если ЕстьЦена Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ДекорацияТипЦен", "Заголовок", СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Тип цен: %1'"), ТипЦен));
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ДекорацияТипЦен", "Видимость", Ложь);
		КонецЕсли;
	
	
	ИменаЭлементовЦены = Новый Массив;
	ИменаЭлементовЦены.Добавить("ПодобраннаяНоменклатураЦена");
	ИменаЭлементовЦены.Добавить("ПодобраннаяНоменклатураСумма");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовЦены, "Видимость", ЕстьЦена);
		
		
КонецПроцедуры // УстановитьВидимостьКолонок()

&НаСервере
Процедура УправлениеСписком()
	
	ДополнительныеСвойства = СписокНоменклатуры.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	ДополнительныеСвойства.Вставить("ПоказыватьОстатки"	, ПоказыватьОстатки);
	ДополнительныеСвойства.Вставить("ТипЦен"			, ТипЦен);
	ДополнительныеСвойства.Вставить("ДатаРасчетов"		, ?(ЗначениеЗаполнено(ДатаРасчетов), ДатаРасчетов, ТекущаяДатаСеанса()));
	ДополнительныеСвойства.Вставить("Организация"		, Организация);
	ДополнительныеСвойства.Вставить("ЦМО"				, ЦМО);
	
	Если ЕстьЦена И ЗначениеЗаполнено(ТипЦен) Тогда
		УстановитьТекстЗапроса_СЦенами();
	Иначе
		УстановитьТекстЗапроса_ПоСправочнику();
	КонецЕсли;
	
	УстановитьЗначенияДоступныхПараметров();
	
КонецПроцедуры

&НаСервере
Функция ПоместитьПодобраннуюНоменклатуруВХранилище()

	ТаблицаДляДокумента = Объект.ПодобраннаяНоменклатура.Выгрузить();
			
	АдресПодобраннойНоменклатурыВХранилище = ПоместитьВоВременноеХранилище(ТаблицаДляДокумента, УникальныйИдентификатор);

	Возврат АдресПодобраннойНоменклатурыВХранилище;

КонецФункции

&НаКлиенте
Функция НайтиСтрокуКорзины(ПараметрыПоиска)
	
	РезультатПоиска = Объект.ПодобраннаяНоменклатура.НайтиСтроки(ПараметрыПоиска);
	Если РезультатПоиска.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат РезультатПоиска[0].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьВыбраннуюНоменклатуру(ПараметрыНоменклатуры, Количество)
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("Номенклатура", ПредопределенноеЗначение("Справочник.Прейскурант.ПустаяСсылка"));
		
	Если ПараметрыНоменклатуры.Свойство("Цена") Тогда
		ПараметрыПоиска.Вставить("Цена");
	КонецЕсли;
		
	ЗаполнитьЗначенияСвойств(ПараметрыПоиска, ПараметрыНоменклатуры);

	НайденнаяСтрока = НайтиСтрокуКорзины(ПараметрыПоиска);
	Если НайденнаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Объект.ПодобраннаяНоменклатура.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПараметрыНоменклатуры);
	Иначе
		ТекущаяСтрока = Объект.ПодобраннаяНоменклатура.НайтиПоИдентификатору(НайденнаяСтрока);
		ТекущаяСтрока.СтавкаНДС = ПараметрыНоменклатуры.СтавкаНДС;
	КонецЕсли;

	ТекущаяСтрока.Количество = ТекущаяСтрока.Количество + Количество;
	
	Если ПараметрыНоменклатуры.Свойство("Цена") Тогда 
		ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	КонецЕсли;
	
	ИндексДобавленнойСтроки = ТекущаяСтрока.ПолучитьИдентификатор();

	СформироватьИнформационнуюНадпись(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьПоиск()

	Использование = ЗначениеЗаполнено(СтрокаПоиска);

	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
		СписокНоменклатуры.Отбор.Элементы, "ПоискПоПодстроке",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Наименование", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Код", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);

	Если ПустаяСтрока(СтрокаПоиска) Тогда
		Возврат;
	КонецЕслИ;
	
	// Удалим элемент из истории поиска если он там был
	НомерНайденногоЭлементаСписка = Элементы.СтрокаПоиска.СписокВыбора.НайтиПоЗначению(СтрокаПоиска);
	Пока НомерНайденногоЭлементаСписка <> Неопределено Цикл
		Элементы.СтрокаПоиска.СписокВыбора.Удалить(НомерНайденногоЭлементаСписка);
		НомерНайденногоЭлементаСписка = Элементы.СтрокаПоиска.СписокВыбора.НайтиПоЗначению(СтрокаПоиска);
	КонецЦикла;	
	
	// И поставим его на первое место
	Элементы.СтрокаПоиска.СписокВыбора.Вставить(0, СтрокаПоиска);
	Пока Элементы.СтрокаПоиска.СписокВыбора.Количество() > 1000 Цикл
		Элементы.СтрокаПоиска.СписокВыбора.Удалить(Элементы.СтрокаПоиска.СписокВыбора.Количество() - 1);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСумму()
	
	ТекущиеДанные = Элементы.ПодобраннаяНоменклатура.ТекущиеДанные;
	ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиНоменклатуруВДокумент()
	
	Если ПеренестиВДокумент Тогда
		АдресВХранилище = ПоместитьПодобраннуюНоменклатуруВХранилище();
		Структура = Новый Структура("АдресПодобраннойНоменклатурыВХранилище", АдресВХранилище);
		ПеренестиВДокумент = Истина;
		ОповеститьОВыборе(Структура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоИерархииНоменклатуры(ГруппаНоменклатуры)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		СписокНоменклатуры.Отбор, "Родитель", ГруппаНоменклатуры,
		ВидСравненияКомпоновкиДанных.ВИерархии,,ЗначениеЗаполнено(ГруппаНоменклатуры));
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьИнформационнуюНадпись(Форма)

	ШаблонНадписи = НСтр("ru = 'Всего подобрано %1 позиции(ия)'");
	Форма.ИнформационнаяНадпись = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонНадписи,
		Форма.Объект.ПодобраннаяНоменклатура.Количество());

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИтерациюВыбораНоменклатуры(ВыделенныеСтроки, ТекущийИндекс)

	Если ТекущийИндекс > ВыделенныеСтроки.Вграница() Тогда
		
		Элементы.ПодобраннаяНоменклатура.ТекущаяСтрока = ИндексДобавленнойСтроки;
		
		Возврат;
	КонецЕсли;
	
	ОжидатьВводДанных = Ложь;
	Пока ТекущийИндекс <= ВыделенныеСтроки.Вграница() Цикл
		ДобавитьТекущуюСтроку(ВыделенныеСтроки, ТекущийИндекс, ОжидатьВводДанных);
		Если ОжидатьВводДанных Тогда
			Возврат;
		КонецЕсли;
		
		ТекущийИндекс = ТекущийИндекс + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТекущуюСтроку(ВыделенныеСтроки, ТекущийИндекс, ОжидатьВводДанных)
	
	Перем ВалютаПараметров;
	
	ТекущиеДанные = Элементы.СписокНоменклатуры.ДанныеСтроки(ВыделенныеСтроки[ТекущийИндекс]);
	
	СтруктураПараметрыНоменклатуры = Новый Структура;
	СтруктураПараметрыНоменклатуры.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
		
	Если ТекущиеДанные.Свойство("Цена") И ЕстьЦена Тогда
		СтруктураПараметрыНоменклатуры.Вставить("Цена", ТекущиеДанные.Цена);
	КонецЕсли;
	СтруктураПараметрыНоменклатуры.Вставить("СтавкаНДС", ТекущиеДанные.СтавкаНДС);
	СтруктураПараметрыНоменклатуры.Вставить("ЕдиницаИзмерения", ТекущиеДанные.ЕдиницаИзмерения);
				
	Если ПодбиратьВсе И ПоказыватьОстатки Тогда 
		Количество = ТекущиеДанные.КоличествоОстаток;
	Иначе 	
		Количество = ПолучитьКоличествоПоУмолчнаию(ТекущиеДанные.Номенклатура);
	КонецЕсли;	
	Количество = ?(Количество <= 0, 1, Количество);
		
	ЗапроситьДополнительныеДанные = (ЗапрашиватьКоличество И НЕ ПодбиратьВсе) ИЛИ (ЗапрашиватьЦену И ЕстьЦена);
	
	ДопПараметрыОповещения = Новый Структура;
	ДопПараметрыОповещения.Вставить("ТекущийИндекс"					, ТекущийИндекс);
	ДопПараметрыОповещения.Вставить("ВыделенныеСтроки"				, ВыделенныеСтроки);
	ДопПараметрыОповещения.Вставить("СтруктураПараметрыНоменклатуры", СтруктураПараметрыНоменклатуры);
	
	Если ЗапроситьДополнительныеДанные Тогда
		
		ОжидатьВводДанных = Истина;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Номенклатура"		, СтруктураПараметрыНоменклатуры.Номенклатура);
		ПараметрыФормы.Вставить("Цена"				, ?(СтруктураПараметрыНоменклатуры.Свойство("Цена"), СтруктураПараметрыНоменклатуры.Цена, 0));
		ПараметрыФормы.Вставить("Количество"		, Количество);
		ПараметрыФормы.Вставить("ЕстьЦена"			, ЗапрашиватьЦену И ЕстьЦена);
		ПараметрыФормы.Вставить("ЕстьКоличество"	, ЗапрашиватьКоличество);

		ОткрытьФорму("Обработка.ПодборИзПрейскуранта.Форма.ФормаВводаЦенаКоличество", ПараметрыФормы, ЭтаФорма,,,,
			Новый ОписаниеОповещения("ДобавитьТекущуюСтрокуЗавершение", ЭтотОбъект, ДопПараметрыОповещения),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Возврат;
		
	КонецЕсли;
	
	ДобавитьВыбраннуюНоменклатуру(СтруктураПараметрыНоменклатуры, Количество);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТекущуюСтрокуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Элементы.ПодобраннаяНоменклатура.ТекущаяСтрока = ИндексДобавленнойСтроки;
		Возврат;
	КонецЕсли;
	
	СтруктураПараметрыНоменклатуры = ДополнительныеПараметры.СтруктураПараметрыНоменклатуры;
	СтруктураПараметрыНоменклатуры.Вставить("Цена", Результат.Цена);
	Количество 			= Результат.Количество;
	ТекущийИндекс 		= ДополнительныеПараметры.ТекущийИндекс;
	ВыделенныеСтроки 	= ДополнительныеПараметры.ВыделенныеСтроки;
	
	ДобавитьВыбраннуюНоменклатуру(СтруктураПараметрыНоменклатуры, Количество);
	ВыполнитьИтерациюВыбораНоменклатуры(ВыделенныеСтроки, ТекущийИндекс + 1);

КонецПроцедуры

&НаКлиенте
Процедура НастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ЗапрашиватьКоличество 				= Результат.ЗапрашиватьКоличество;
		ЗапрашиватьЦену       				= Результат.ЗапрашиватьЦену;
		НеВыводитьНоменклатуруБезЦены 		= Результат.НеВыводитьНоменклатуруБезЦены;
		ПоказыватьСнятыеСПродажи			= Результат.ПоказыватьСнятыеСПродажи;
		НеВыводитьНоменклатуруБезОстатка	= Результат.НеВыводитьНоменклатуруБезОстатка;
	КонецЕсли;
	
	СписокЦен = Новый СписокЗначений;
	СписокЦен.Добавить(ТипЦен);
	УстановитьОтборСпискаНоменклатуры(ЭтаФорма, Новый Структура("ПоказыватьСнятыеСПродажи, НеВыводитьНоменклатуруБезЦены, ЕстьЦена, НеВыводитьНоменклатуруБезОстатка, ПоказыватьОстатки", 
		ПоказыватьСнятыеСПродажи, НеВыводитьНоменклатуруБезЦены, ЕстьЦена, НеВыводитьНоменклатуруБезОстатка, ПоказыватьОстатки));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборПодразделение(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.СписокНоменклатуры.Отбор, "Подразделение",
		Форма.БыстрыйОтборПодразделение,,, Форма.БыстрыйОтборПодразделениеИспользование,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
КонецПроцедуры	
	
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСпискаНоменклатуры(Форма, СписокПараметровОтбора)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.СписокНоменклатуры.Отбор, "СнятаСПродажи",
	Ложь,,, Не СписокПараметровОтбора.ПоказыватьСнятыеСПродажи,
	РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
	Если СписокПараметровОтбора.ЕстьЦена Тогда 
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.СписокНоменклатуры.Отбор, "Цена",
		0, ВидСравненияКомпоновкиДанных.НеРавно,, СписокПараметровОтбора.НеВыводитьНоменклатуруБезЦены,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
	КонецЕсли;	
	
	Если СписокПараметровОтбора.ПоказыватьОстатки Тогда 
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.СписокНоменклатуры.Отбор, "ЕстьОстаток",
		Истина, ВидСравненияКомпоновкиДанных.Равно,, СписокПараметровОтбора.НеВыводитьНоменклатуруБезОстатка,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	КонецЕсли;
	
КонецПроцедуры		

&НаСервереБезКонтекста
Функция ПолучитьКоличествоПоУмолчнаию(Номенклатура)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Количество");
	
КонецФункции	

#Область УстановкаТекстаЗапросаДинамическогоСписка

&НаСервере
Процедура УстановитьТекстЗапроса_СЦенами()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Прейскурант.Ссылка КАК Номенклатура,
	|	Прейскурант.Код КАК Код,
	|	Прейскурант.Артикул КАК Артикул,
	|	ЕСТЬNULL(ТоварыВТорговыхТочкахОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
	|	Прейскурант.Номенклатура.СтавкаНДС КАК СтавкаНДС,
	|	Прейскурант.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА Прейскурант.Номенклатура.ТипНоменклатуры В (&ВидыУслуг)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(ТоварыВТорговыхТочкахОстатки.КоличествоОстаток, 0) > 0
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|	КОНЕЦ КАК ЕстьОстаток
	|{ВЫБРАТЬ
	|	Номенклатура.*,
	|	Код,
	|	Артикул,
	|	КоличествоОстаток,
	|	Цена,
	|	СтавкаНДС,
	|	ЕдиницаИзмерения,
	|	ЕстьОстаток}
	|ИЗ
	|	Справочник.Прейскурант КАК Прейскурант
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				&РасчетнаяДата,
	|				Организация = &Организация
	|					И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних
	|		ПО Прейскурант.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВТорговыхТочках.Остатки(
	|				&РасчетнаяДата,
	|				Организация = &Организация
	|					И ЦМО = &ЦМО
	|					И &ПоказыватьОстатки) КАК ТоварыВТорговыхТочкахОстатки
	|		ПО Прейскурант.Номенклатура = ТоварыВТорговыхТочкахОстатки.Номенклатура
	|ГДЕ
	|	НЕ Прейскурант.ЭтоГруппа
	|{ГДЕ
	|	Прейскурант.Ссылка.* КАК Номенклатруа,
	|	Прейскурант.Код,
	|	Прейскурант.Артикул,
	|	Прейскурант.Подразделение,
	|	Прейскурант.СнятаСПродажи,
	|	ЦеныНоменклатурыСрезПоследних.Цена,
	|	(ВЫБОР
	|			КОГДА Прейскурант.Номенклатура.ТипНоменклатуры В (&ВидыУслуг)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ЕСТЬNULL(ТоварыВТорговыхТочкахОстатки.КоличествоОстаток, 0) > 0
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ
	|		КОНЕЦ) КАК ЕстьОстаток}";
	
	СвойстваСписка 								= ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица 				= "Справочник.Прейскурант";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Ложь;
	СвойстваСписка.ТекстЗапроса 				= ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.СписокНоменклатуры, СвойстваСписка);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстЗапроса_ПоСправочнику()

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Прейскурант.Ссылка КАК Номенклатура,
	|	Прейскурант.Код КАК Код,
	|	Прейскурант.Артикул КАК Артикул,
	|	ЕСТЬNULL(ТоварыВТорговыхТочкахОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	0 КАК Цена,
	|	Прейскурант.Номенклатура.СтавкаНДС КАК СтавкаНДС,
	|	Прейскурант.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА Прейскурант.Номенклатура.ТипНоменклатуры В (&ВидыУслуг)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(ТоварыВТорговыхТочкахОстатки.КоличествоОстаток, 0) > 0
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|	КОНЕЦ КАК ЕстьОстаток
	|{ВЫБРАТЬ
	|	Номенклатура.*,
	|	Код,
	|	Артикул,
	|	КоличествоОстаток,
	|	Цена,
	|	СтавкаНДС,
	|	ЕдиницаИзмерения,
	|	ЕстьОстаток}
	|ИЗ
	|	Справочник.Прейскурант КАК Прейскурант
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВТорговыхТочках.Остатки(
	|				&РасчетнаяДата,
	|				Организация = &Организация
	|					И ЦМО = &ЦМО
	|					И &ПоказыватьОстатки) КАК ТоварыВТорговыхТочкахОстатки
	|		ПО Прейскурант.Номенклатура = ТоварыВТорговыхТочкахОстатки.Номенклатура
	|ГДЕ
	|	НЕ Прейскурант.ЭтоГруппа
	|{ГДЕ
	|	Прейскурант.Ссылка.* КАК Номенклатруа,
	|	Прейскурант.Код,
	|	Прейскурант.Артикул,
	|	Прейскурант.Подразделение,
	|	Прейскурант.СнятаСПродажи,
	|	(ВЫБОР
	|			КОГДА Прейскурант.Номенклатура.ТипНоменклатуры В (&ВидыУслуг)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ЕСТЬNULL(ТоварыВТорговыхТочкахОстатки.КоличествоОстаток, 0) > 0
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ
	|		КОНЕЦ) КАК ЕстьОстаток}";
	
	СвойстваСписка 								= ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица 				= "Справочник.Прейскурант";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Истина;
	СвойстваСписка.ТекстЗапроса 				= ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.СписокНоменклатуры, СвойстваСписка);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияДоступныхПараметров()

	ДоступныеПараметры = СписокНоменклатуры.Параметры.ДоступныеПараметры;
	
	ДатаЦены    = ?(НЕ ЗначениеЗаполнено(ДатаРасчетов), Неопределено, ДатаРасчетов);
	Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("РасчетнаяДата")) <> Неопределено Тогда
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("РасчетнаяДата", ДатаЦены);
	КонецЕсли;
	Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("Организация")) <> Неопределено Тогда
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("Организация", Организация);
	КонецЕсли;
    Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ТипЦен")) <> Неопределено Тогда
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ТипЦен", ТипЦен);
	КонецЕсли;
	Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ЦМО")) <> Неопределено Тогда
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЦМО", ЦМО);
	КонецЕсли;
	Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ПоказыватьОстатки")) <> Неопределено Тогда
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ПоказыватьОстатки", ПоказыватьОстатки);
	КонецЕсли;
	Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ВидыУслуг")) <> Неопределено Тогда
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ВидыУслуг", РозничныеПродажиБГУ.ТипыУслугРабот());
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
	
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборПараметрыДоговораПлатежногоАгента(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.СписокНоменклатуры.Отбор, "ПараметрыДоговораПлатежногоАгента",
		Форма.БыстрыйОтборПараметрыДоговораПлатежногоАгента,,, Форма.БыстрыйОтборПараметрыДоговораПлатежногоАгентаИспользование,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
КонецПроцедуры

#КонецОбласти
