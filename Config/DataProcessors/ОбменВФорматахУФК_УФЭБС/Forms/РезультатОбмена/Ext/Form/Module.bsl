
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Параметры.Свойство("Этап",Этап);
	Параметры.Свойство("ВидДанных",ВидДанных);
	Параметры.Свойство("ЭтоИмпорт",ЭтоИмпорт);
	Параметры.Свойство("Версия",Версия);
	
	ЗаголовокПродолжить	= "";
	ЗаголовокПрервать	= "";
	ТекстОшибки			= "";
	Элементы.Продолжить.Видимость			= Параметры.Свойство("Продолжить",ЗаголовокПродолжить);
	Элементы.Прервать.Видимость				= Параметры.Свойство("Прервать",ЗаголовокПрервать);
	Элементы.СообщениеОбОшибке.Видимость	= Параметры.Свойство("ТекстОшибки",ТекстОшибки);
	
	Если ЗначениеЗаполнено(ЗаголовокПродолжить) Тогда
		Элементы.Продолжить.Заголовок = ЗаголовокПродолжить;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаголовокПрервать) Тогда
		Элементы.Прервать.Заголовок = ЗаголовокПрервать;
	КонецЕсли;
	
	Элементы.СообщениеОбОшибке.Заголовок = ТекстОшибки;

	Если Параметры.Свойство("Документ") Тогда
		ЗаполнитьДеревоДокументов(Параметры.Документ);
	КонецЕсли; 
	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыДеревоДокументов

&НаКлиенте
Процедура ДеревоДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ДеревоДокументовПредставление" Тогда
		
		ТекущаяСтрока = ДеревоДокументов.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если ЗначениеЗаполнено(ТекущаяСтрока.Ссылка) Тогда
			СтандартнаяОбработка = Ложь;
			ПоказатьЗначение(, ТекущаяСтрока.Ссылка);			
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ДеревоДокументовПротокол" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекущаяСтрока = ДеревоДокументов.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если ЗначениеЗаполнено(ТекущаяСтрока.Ссылка) Тогда
			ЗаданиеНаЭкспорт = ТекущаяСтрока.ПолучитьРодителя().ПолучитьРодителя().Ссылка;
			ТекстПротокола = ПолучитьТекстПротокола(ЗаданиеНаЭкспорт, ТекущаяСтрока.Ссылка);
			ТекстовыйДокумент = Новый ТекстовыйДокумент;
			ТекстовыйДокумент.УстановитьТекст(ТекстПротокола);
			ТекстовыйДокумент.Показать("Протокол");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПродолжитьОбмен(Команда)
	ОповеститьОВыборе(Новый Структура("Этап,Действие,ВидДанных,Версия",Этап,"Продолжить",ВидДанных,Версия));	
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьОбмен(Команда)
	ОповеститьОВыборе(Новый Структура("Этап,Действие,ВидДанных",Этап,"Прервать",ВидДанных));
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	
	Для Каждого СтрокаОрганизация Из ДеревоДокументов.ПолучитьЭлементы() Цикл
		Элементы.ДеревоДокументов.Развернуть(СтрокаОрганизация.ПолучитьИдентификатор(), Истина);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	
	Для Каждого СтрокаОрганизация Из ДеревоДокументов.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаДокумент Из СтрокаОрганизация.ПолучитьЭлементы() Цикл
			Элементы.ДеревоДокументов.Свернуть(СтрокаДокумент.ПолучитьИдентификатор());
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДеревоДокументовПредставление");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоДокументов.Ссылка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,,,Истина));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветГиперссылки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоДокументов(Документ)
	
	СерыйШар	= 2;
	ЗеленыйШар	= 1;
	ЗолотойШар	= 3;
	КрасныйШар	= 6;
	
	Дерево = РеквизитФормыВЗначение("ДеревоДокументов");
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ОбъектыОбмена.Описание,
	               |	ОбъектыОбмена.ОписаниеОшибки,
	               |	ОбъектыОбмена.Объект,
	               |	ПРЕДСТАВЛЕНИЕ(ОбъектыОбмена.Объект) КАК ОбъектПредставление,
	               |	ОбъектыОбмена.Ссылка КАК Задание,
	               |	ПРЕДСТАВЛЕНИЕ(ОбъектыОбмена.Ссылка) КАК ЗаданиеПредставление,
	               |	ОбъектыОбмена.Ссылка.Номер КАК Номер,
	               |	ОбъектыОбмена.НомерСтроки КАК НомерСтроки,
	               |	ОбъектыОбмена.Ссылка.Организация КАК Организация,
	               |	ПРЕДСТАВЛЕНИЕ(ОбъектыОбмена.Ссылка.Организация) КАК ОрганизацияПредставление
	               |ИЗ
	               |	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК ОбъектыОбмена
	               |ГДЕ
	               |	ОбъектыОбмена.Ссылка В(&Задания)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номер,
	               |	НомерСтроки
	               |ИТОГИ ПО
	               |	Организация,
	               |	Задание";
				   
	Если ЭтоИмпорт Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Экспорт", "Импорт");
	КонецЕсли;
					  
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Задания",Документ);
	Результат = Запрос.Выполнить();
	
	ВыборкаОрганизаций = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	
	Пока ВыборкаОрганизаций.Следующий() Цикл
		
		СтрокаОрг = ДобавитьСтрокуВДерево(Дерево, ВыборкаОрганизаций.Организация, ВыборкаОрганизаций.ОрганизацияПредставление, ЗолотойШар);
		
		ВыборкаЗаданий = ВыборкаОрганизаций.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);				
		
		Пока ВыборкаЗаданий.Следующий() Цикл
			
			ДокументВДереве = ДобавитьСтрокуВДерево(СтрокаОрг, ВыборкаЗаданий.Задание, ВыборкаЗаданий.ЗаданиеПредставление, СерыйШар);
			
			ВыборкаДетальная = ВыборкаЗаданий.Выбрать();	
						
			НеОтправленные	= Неопределено;
			Успешные		= Неопределено;			
			НеУспешные		= Неопределено;
			
			Пока ВыборкаДетальная.Следующий() Цикл
				Если ПустаяСтрока(ВыборкаДетальная.Описание) Тогда
					НеОтправленные = ДобавитьСтрокуВДерево(ДокументВДереве,, НСтр("ru = 'Не отправленные'"), СерыйШар, НеОтправленные);
					ДобавитьСтрокуВДерево(НеОтправленные, ВыборкаДетальная.Объект, ВыборкаДетальная.ОбъектПредставление, СерыйШар);		
				ИначеЕсли ПустаяСтрока(ВыборкаДетальная.ОписаниеОшибки) Тогда
					Успешные = ДобавитьСтрокуВДерево(ДокументВДереве,, НСтр("ru = 'Успешные'"), ЗеленыйШар, Успешные);
					ДобавитьСтрокуВДерево(Успешные, ВыборкаДетальная.Объект, ВыборкаДетальная.ОбъектПредставление, ЗеленыйШар);
				Иначе
					НеУспешные = ДобавитьСтрокуВДерево(ДокументВДереве,, НСтр("ru = 'Не успешные'"), КрасныйШар, НеУспешные);
					СтрокаНеУспешногоДокумента = ДобавитьСтрокуВДерево(НеУспешные, ВыборкаДетальная.Объект, ВыборкаДетальная.ОбъектПредставление, КрасныйШар);
					СтрокаНеУспешногоДокумента.Протокол = "Протокол";
								
					Ошибки = ЗначениеИзСтрокиВнутр(ВыборкаДетальная.ОписаниеОшибки);
					
					ПолеФайла = "";
					Для Каждого СтрОшибка Из Ошибки Цикл
						Если СтрОшибка.ПолеФайла <> ПолеФайла 
							И ЗначениеЗаполнено(СтрОшибка.ПолеФайла) Тогда
							КореньОшибки = ДобавитьСтрокуВДерево(СтрокаНеУспешногоДокумента,, СтрОшибка.ПолеФайла, КрасныйШар);
							ПолеФайла = СтрОшибка.ПолеФайла;
						Иначе
							КореньОшибки = СтрокаНеУспешногоДокумента;
						КонецЕсли;
						ДобавитьСтрокуВДерево(КореньОшибки,, СтрОшибка.Ошибка, ЗолотойШар);
					КонецЦикла;				
				КонецЕсли;
			КонецЦикла;
			
			Если НеОтправленные <> Неопределено Тогда	
				НеОтправленные.Представление = НеОтправленные.Представление + " (" + НеОтправленные.Строки.Количество() + ")";
			КонецЕсли;			
			Если Успешные <> Неопределено Тогда	
				Успешные.Представление = Успешные.Представление + " (" + Успешные.Строки.Количество() + ")";
			КонецЕсли;			
			Если НеУспешные <> Неопределено Тогда
				НеУспешные.Представление = НеУспешные.Представление + " (" + НеУспешные.Строки.Количество() + ")";
			КонецЕсли;
			
		КонецЦикла;
		
		КолВоБезОшибок		= ?(Успешные = Неопределено, 0, Успешные.Строки.Количество());
		КолВоОтправленные	= ?(НеУспешные = Неопределено, 0, НеУспешные.Строки.Количество()) + КолВоБезОшибок;
		КолВоВсего			= ?(НеОтправленные = Неопределено, 0, НеОтправленные.Строки.Количество()) + КолВоОтправленные;
		
		ПредставлениеДокумента = НСтр("ru = '%1 (всего: %2, отправлено: %3, без ошибок: %4)'");
		ПредставлениеДокумента = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПредставлениеДокумента,
									ДокументВДереве.Представление, КолВоВсего, КолВоОтправленные, КолВоБезОшибок);																	
		ДокументВДереве.Представление = ПредставлениеДокумента;

	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоДокументов");
	
КонецПроцедуры

&НаСервере
Функция ДобавитьСтрокуВДерево(Корень, Ссылка = Неопределено, Представление, Картинка, СуществующаяСтрока = Неопределено)
	
	Если СуществующаяСтрока = Неопределено Тогда
		НоваяСтрока = Корень.Строки.Добавить();
		НоваяСтрока.Представление	= Представление;
		НоваяСтрока.Картинка		= Картинка;
		НоваяСтрока.Ссылка			= Ссылка;
	Иначе
		НоваяСтрока = СуществующаяСтрока;
	КонецЕсли;
	
	Возврат НоваяСтрока;
		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекстПротокола(ЗаданиеНаЭкспорт, Объект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Файлы.Ссылка КАК ФайлЗапроса,
	               |	ОбъектыОбмена.ОтветWebСервиса КАК Ответ,
	               |	ОбъектыОбмена.ИмяФайлаВыгрузки КАК ИмяФайла
	               |ИЗ
	               |	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК ОбъектыОбмена
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗаданиеНаЭкспортДанныхВБанкиКСПрисоединенныеФайлы КАК Файлы
	               |		ПО ОбъектыОбмена.Ссылка = Файлы.ВладелецФайла
	               |			И (ОбъектыОбмена.ИмяФайлаВыгрузки = Файлы.Наименование + ""."" + Файлы.Расширение)
	               |ГДЕ
	               |	ОбъектыОбмена.Ссылка = &Ссылка
	               |	И ОбъектыОбмена.Объект = &Объект";
				   
	Запрос.УстановитьПараметр("Ссылка", ЗаданиеНаЭкспорт);
	Запрос.УстановитьПараметр("Объект", Объект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстЗапроса = "";
	Если Выборка.Следующий() Тогда
		
		Если ЗначениеЗаполнено(Выборка.ФайлЗапроса) Тогда
			Ответ = Выборка.Ответ.Получить();
			Возврат СформироватьТекстПротокола(Выборка,Ответ);
			
		Иначе
			ОтветИзСервиса = ЭкспортФайлов.РазобратьОтветИзСервиса(Выборка.Ответ);			
			
			Если ОтветИзСервиса.Количество() = 0 Тогда
				Возврат "";
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
	           |	Файлы.Ссылка КАК ФайлЗапроса,
			   |	Файлы.Наименование + ""."" + Файлы.Расширение КАК ИмяФайла
	           |ИЗ
	           |	Справочник.ЗаданиеНаЭкспортДанныхВБанкиКСПрисоединенныеФайлы КАК Файлы
	           |ГДЕ
	           |	Файлы.ВладелецФайла = &Ссылка
	           |	И Файлы.Наименование + ""."" + Файлы.Расширение В (&МассивИменФайлов)";
					   
			Запрос.УстановитьПараметр("Ссылка", ЗаданиеНаЭкспорт);
			МассивИменФайлов = ОтветИзСервиса.ВыгрузитьКолонку("ИмяФайла");
			Запрос.УстановитьПараметр("МассивИменФайлов", МассивИменФайлов);
		
			Выборка = Запрос.Выполнить().Выбрать();
			Результат = "";
			Для Каждого СтрТЧ Из ОтветИзСервиса Цикл
				Если ЗначениеЗаполнено(СтрТЧ.ИмяФайла) Тогда
					Выборка.Сбросить();
					Если Выборка.НайтиСледующий(Новый Структура("ИмяФайла",СтрТЧ.ИмяФайла)) Тогда
						Результат = Результат + СформироватьТекстПротокола(Выборка,СтрТЧ.Ответ);
						Результат = Результат + "
						|
						|////////////////////////////////////////////////////////////////////////////////
						|"
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Возврат Результат;
			
		КонецЕсли;
				
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьТекстПротокола(СтрокаВыборки,Ответ)
	
	Если ЗначениеЗаполнено(СтрокаВыборки.ФайлЗапроса) Тогда
		ДвочныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(СтрокаВыборки.ФайлЗапроса);
		ВременныйФайл = ПолучитьИмяВременногоФайла();
		ДвочныеДанные.Записать(ВременныйФайл);
		ДвочныеДанные = Неопределено;
		
		ЧтениеТекста = Новый ЧтениеТекста(ВременныйФайл);
		ТекстЗапроса = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();		
		ЧтениеТекста = Неопределено;
		
		УдалитьФайлы(ВременныйФайл);
	Иначе
		ТекстЗапроса = "";
	КонецЕсли;
	
	Результат = "
				|Файл: " + СтрокаВыборки.ИмяФайла + "
				|
				|" + ТекстЗапроса + "
				|
				|////////////////////////////////////////////////////////////////////////////////
				|
				|Ответ web-сервиса:
				|
				|" + Ответ;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти