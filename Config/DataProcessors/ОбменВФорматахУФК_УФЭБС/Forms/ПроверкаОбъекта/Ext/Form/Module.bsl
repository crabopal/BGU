
&НаСервере
Процедура ПроверитьНаСервере()
	
	ОбработкаОбмена      = Справочники.ТипыОбменаБанкиКС.ПолучитьОбработку(ВидОбмена);
	Если ОбработкаОбмена = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ФорматОбмена) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не заполнен формат обмена.'"));
		Возврат;
	КонецЕсли;	  
	
	Если Не ЗначениеЗаполнено(ВидОбмена) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не заполнен вид обмена.'"));
		Возврат;
	КонецЕсли;	
	
	Ошибки               = "";
		
	ОбработкаОбмена.ПроверитьОбъект(ДокументОбъект, ФорматОбмена, Ошибки);
	
	Если ЗначениеЗаполнено(Ошибки) Тогда
		
		Сведения = ЗначениеИзСтрокиВнутр(Ошибки);
	
		Если ТипЗнч(Сведения) <> Тип("ТаблицаЗначений") Тогда
			Возврат;	
		КонецЕсли; 
		
		ЭтаФорма.СведенияОбОшибках.Загрузить(Сведения);
				
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)
		
	Элементы.СведенияОбОшибках.Видимость = Ложь;
	Элементы.Пройдена.Видимость          = Ложь;
    СведенияОбОшибках.Очистить(); 
	
	ПроверитьНаСервере();  
	
	Если Не ЗначениеЗаполнено(ФорматОбмена) ИЛИ Не ЗначениеЗаполнено(ВидОбмена) Тогда
		Возврат;	
	КонецЕсли;
	
	Если СведенияОбОшибках.Количество() > 0 Тогда
		
		Элементы.СведенияОбОшибках.Видимость = Истина;

	Иначе
		
		Элементы.Пройдена.Видимость = Истина;
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНастройкиОбменаПоУмолчанию(Организация, КассовыйОрган = Неопределено)
	
	Возврат РегистрыСведений.НастройкиОбменаБанкиКСПоУмолчанию.ПолучитьОсновнуюНастройкуОбменаОрганизации(Организация, КассовыйОрган);
	
КонецФункции	

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОбъектОтбора", ДокументОбъект);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПолучитьНастройкиОбменаПоУмолчанию(ДокументОбъект.Организация));
	
КонецПроцедуры

&НаСервере
Функция ВернутьИдентификатор()
	
	Возврат Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("Имя", ДокументОбъект.Метаданные().Имя);
	
КонецФункции

&НаКлиенте
Процедура ФорматОбменаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("Отбор, ТекущаяСтрока",
										 Новый Структура("ИдентификаторОбъекта, Владелец", ВернутьИдентификатор(), ВидОбмена),
										 ФорматОбмена);
	ОткрытьФорму("Справочник.ФорматыОбменаБанкиКС.ФормаВыбора", ПараметрыФормы, Элемент);

	
КонецПроцедуры
