#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСсылкуНаОбъект(ВидОбъекта, Условия)

	Запрос = Новый Запрос;
	
	ТекстЗапроса = "Выбрать Первые 1
					|Т1.Ссылка
					|ИЗ
					|"+ВидОбъекта+" как Т1
					|ГДЕ
					|";
	Счетчик = 0;
	
	Для каждого Условие Из Условия Цикл
	
		ТекстЗапроса = ТекстЗапроса + "
						|"+?(Счетчик>0, "И ", "")+"Т1."+СтрЗаменить(Условие.Ключ, "point", ".")+" = &П" + Счетчик;
		Запрос.УстановитьПараметр("П"+ Счетчик, Условие.Значение);
		
		Если  Условие.Значение = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
	
	КонецЦикла; 						
	
	Запрос.Текст = ТекстЗапроса;
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		ВыборкаЗапроса.Следующий();
		Возврат ВыборкаЗапроса.Ссылка;	
	КонецЕсли;	

КонецФункции // ПолучитьСсылкуНаОбъект()
 
Процедура ВставитьОшибкуВДокумент(Объект, Ошибка, НомерСтроки)
	
	Объект.ФайлыОбмена[НомерСтроки - 1].Описание 	   = "Подробно...";
	Объект.ФайлыОбмена[НомерСтроки - 1].ОписаниеОшибки = Ошибка;
	
КонецПроцедуры	

