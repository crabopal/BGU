				   ?(ВидОбмена.ПредставлениеВНомереВерсии = "KB", "ФайлыОбмена.ИмяФайлаЗагрузки          КАК ИмяФайла," , "
	               |	ВложенныйЗапрос.ИмяФайла, ") + "
	               |	ФайлыОбмена.НомерСтроки               КАК НомерСтроки,
	               |	ФайлыОбмена.ОписаниеОшибки,
	               |	ФайлыОбмена.Описание," + 
				   ?(ВидОбмена.ПредставлениеВНомереВерсии = "KB", "&Ссылка КАК Регистратор", "
	               |	ВложенныйЗапрос.Регистратор")  + "
	               |ИЗ
	               |	Документ.ЗаданиеНаИмпортДанныхБанкиКС.ФайлыОбмена КАК ФайлыОбмена " + 
				   ?(ВидОбмена.ПредставлениеВНомереВерсии = "KB", "", "
