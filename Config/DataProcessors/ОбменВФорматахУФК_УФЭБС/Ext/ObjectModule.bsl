            ОбъектыВФайл.Удалить(ОбъектыВФайл.Количество()-1);
			Если ОбъектыВФайл.Количество() = 0 Тогда
				ИндексВТаблВыгрузки = ИндексВТаблВыгрузки + 1;
                Продолжить;
            КонецЕсли;
			
			// за ним есть еще файлы на обработку
            Если (ОбрабатываемыйФормат = СледФормат) И (ИндексВТаблВыгрузки < (ТаблицаВыгрузки.Количество()-1)) Тогда
				ИндексВТаблВыгрузки = ИндексВТаблВыгрузки + 1;
				Продолжить;
            КонецЕсли;
            
        КонецЕсли;    
        
        НачалоЗаписиФайла = Ложь;
		//ПодвалЗаписан = Истина; 
		//Если дошли до данной строки, значит документ выгрузился в файл,
		//и строки от *КонецОбъекта до конца ТЧ выгрузились
		
        Если НЕ ВсеОбъектыВОдномФайле Тогда
            
            Если (ОбрабатываемыйФормат.ФорматВОтдельномФайле) Тогда
                //ОбрабатываемыйФормат.ОдинОбъектВОдномФайле
                Если ОбрабатываемыйФормат.ОбъектВОдномФайле = 0 Тогда
                    
                    ПодготовитьФайлВыгрузки(ОбрабатываемыйФормат, , Строка.Объект, КодКлиента);
                    
                    СхемаДанныхДляФайлаПередачи.Очистить();
                    НачалоЗаписиФайла     = Истина;
                    ОбъектыВФайл.Очистить();
					
					ЭтоПродолжениеВыгрузкиПредыдущегоФормата = Ложь;
					
                ИначеЕсли ОбрабатываемыйФормат.ОбъектВОдномФайле = 1 Тогда
					
					ФормируемФайл = Ложь;
					Если ИндексВТаблВыгрузки = ТаблицаВыгрузки.Количество()-1 Тогда
						//это последний документ из таблицы выгружаемых документов, нужно формировать файл
						ФормируемФайл = Истина;
					КонецЕсли;
					
					Если КодКлиента <> СледКодКлиента Тогда
						//КодКлиента - Код УБП (РПБС) организации - для форматов ОФК
						//по каждому коду клиента нужно формировать свой файл
						ФормируемФайл = Истина;
					КонецЕсли;
					
					Если КоличествоДокументовВОдномФайле > 0 И ОбъектыВФайл.Количество() >= КоличествоДокументовВОдномФайле Тогда
						//В обработке задано ограничение на количество документов в файле, нужно формировать файл.
						ФормируемФайл = Истина;
					КонецЕсли;
					
					Если ОбрабатываемыйФормат <> СледФормат
						И ФормируемФайл = Ложь Тогда
						МассивФорматов = Новый Массив;
						МассивФорматов.Добавить(ОбрабатываемыйФормат);
						МассивФорматов.Добавить(СледФормат);
						РеквизитыФ = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивФорматов,"КодГруппировкиФорматов,ФорматВОтдельномФайле,ОбъектВОдномФайле");
						
						Если ЗначениеЗаполнено(РеквизитыФ[ОбрабатываемыйФормат].КодГруппировкиФорматов)
							И ЗначениеЗаполнено(РеквизитыФ[СледФормат].КодГруппировкиФорматов)
							И РеквизитыФ[ОбрабатываемыйФормат].КодГруппировкиФорматов = РеквизитыФ[СледФормат].КодГруппировкиФорматов
							И РеквизитыФ[СледФормат].ФорматВОтдельномФайле
							И РеквизитыФ[СледФормат].ОбъектВОдномФайле = 1 Тогда
							//если у следующего формата такие же настройки выгрузки - несколько объектов в один файл и формат в отдельном файле,
							//и задан КодГруппировкиФорматов, совпадающий с КодГруппировкиФорматов текущего формата,
							//то следующий формат надо выгружать в этот же файл.
							//Используется для форматов обмена с ГИС ГМП, когда необходимо несколько видов документов выгрузить в один файл.
							ФормируемФайл = Ложь;
							ЭтоПродолжениеВыгрузкиПредыдущегоФормата = Истина; 
						Иначе
							ФормируемФайл = Истина;
						КонецЕсли;
					КонецЕсли;
					
					Если ФормируемФайл Тогда
						ЭтоПродолжениеВыгрузкиПредыдущегоФормата = Ложь;
						
						//Если СоответствиеФорматовВыгрузиПодвалов[ОбрабатываемыйФормат]<>Неопределено Тогда
						//	СоответствиеФорматовВыгрузиПодвалов.Удалить(ОбрабатываемыйФормат);
						//КонецЕсли;
						
                        //--------------------------------------
                        СтрокаКоличество = СхемаДанныхДляФайлаПередачи.Найти("ОК", "СпецПометка");
                        Если ЗначениеЗаполнено(СтрокаКоличество) Тогда
                            СтрокаКоличество.Значение = Строка(ОбъектыВФайл.Количество());
                        КонецЕсли;
                        
                        СтрокаСумма = СхемаДанныхДляФайлаПередачи.Найти("ОС", "СпецПометка");
                        Если ЗначениеЗаполнено(СтрокаСумма) Тогда
                            
                            ОбщаяСумма = 0;
                            
                            Отбор = Новый Структура();
                            Отбор.Вставить("СпецПометка", "СУ");
                            
                            СтрокиСуммы = СхемаДанныхДляФайлаПередачи.НайтиСтроки(Отбор);
                            
                            Для Каждого Сумма Из СтрокиСуммы Цикл
                                ОбщаяСумма = ОбщаяСумма + Число(Сумма.Значение);
                            КонецЦикла;
                            
                            Значение        = ОбщаяСумма;
                            ФорматнаяСтрока = "ЧЦ=18; ЧГ=";
                            ПозицияФормат = Найти(ВРег(ПорядокФорматированияОбщейСуммы), ВРег("Формат("));
                            Если ПозицияФормат>0 Тогда
                                БлокДляПоискаНачало = Сред(ПорядокФорматированияОбщейСуммы,ПозицияФормат);
                                ПозицияКавычкиНачало = Найти(БлокДляПоискаНачало,"""");
                                БлокДляПоискаКонец = Сред(БлокДляПоискаНачало,ПозицияКавычкиНачало+1);
                                ПозицияКвычкиКонец = Найти(БлокДляПоискаКонец,"""");
                                Если ПозицияКавычкиНачало>0 И ПозицияКвычкиКонец>0 Тогда
                                    ФорматнаяСтрока = Сред(БлокДляПоискаКонец,1,ПозицияКвычкиКонец-1);
                                КонецЕсли;
                            КонецЕсли;
                            Если ЗначениеЗаполнено(ФорматнаяСтрока) Тогда
                                Попытка
                                    СтрокаСумма.Значение = Формат(Значение,ФорматнаяСтрока);
                                Исключение
                                    СтрокаСумма.Значение = ОбщаяСумма;
                                КонецПопытки;
                            Иначе
                                СтрокаСумма.Значение = ОбщаяСумма;
                            КонецЕсли;
                            
                            //СтрокаСумма.Значение = Вычислить(ПорядокФорматированияОбщейСуммы);
                            
                        КонецЕсли;
                        //--------------------------------------
                        
                        ПодготовитьФайлВыгрузки(ОбрабатываемыйФормат, , , КодКлиента);
                        
                        СхемаДанныхДляФайлаПередачи.Очистить();
                        НачалоЗаписиФайла = Истина;
						//ПодвалЗаписан = Ложь;
                        ОбъектыВФайл.Очистить();
                        
                    КонецЕсли;    
				Иначе				
					ОбъектыВФайл.Очистить();
					НачалоЗаписиФайла = Истина;
					//ПодвалЗаписан = Ложь;
					СхемаДанныхДляФайлаПередачи.Очистить();
					
					ЭтоПродолжениеВыгрузкиПредыдущегоФормата = Ложь;
                КонецЕсли;    	
				
			КонецЕсли;
			
        КонецЕсли;    
        
        ИндексВТаблВыгрузки = ИндексВТаблВыгрузки + 1;
        
    КонецЦикла;
    
    Если ВсеОбъектыВОдномФайле И (ОбъектыВФайл.Количество() > 0) Тогда
        ПодготовитьФайлВыгрузки(ОбрабатываемыйФормат, , , КодКлиента);
    КонецЕсли;
    
КонецПроцедуры

Функция ПолучитьПравилаОбменаФорматов(МассивФорматов, ПолныйСписок = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПользовательскиеВыраженияПолейФорматовОбмена.ФорматОбмена КАК ФорматОбмена,
		|	ПользовательскиеВыраженияПолейФорматовОбмена.ОбрабатываемоеПоле КАК ОбрабатываемоеПоле,
		|	ПользовательскиеВыраженияПолейФорматовОбмена.ПолеФайла КАК ПолеФайла,
		|	ПользовательскиеВыраженияПолейФорматовОбмена.НомерСтрокиПравил КАК НомерСтрокиПравил,
		|	ПользовательскиеВыраженияПолейФорматовОбмена.ПользовательскоеВыражение КАК ПользовательскоеВыражение
		|ПОМЕСТИТЬ ПереопределяемыеПоля
		|ИЗ
		|	РегистрСведений.ПользовательскиеВыраженияПолейФорматовОбмена КАК ПользовательскиеВыраженияПолейФорматовОбмена
		|ГДЕ
		|	ПользовательскиеВыраженияПолейФорматовОбмена.Использовать
		|	И ПользовательскиеВыраженияПолейФорматовОбмена.ФорматОбмена В(&МассивФорматов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФорматыОбменаБанкиКСПравилаОбмена.Ссылка КАК Формат,
		|	ФорматыОбменаБанкиКСПравилаОбмена.НомерСтроки КАК НомерСтроки,
		|	ФорматыОбменаБанкиКСПравилаОбмена.ПолеФайлаПередачи КАК ПолеФайлаПередачи,
		|	ФорматыОбменаБанкиКСПравилаОбмена.ТипПоляФайлаПередачи КАК ТипПоляФайлаПередачи,
		|	ФорматыОбменаБанкиКСПравилаОбмена.ОписаниеПоляФайлаПередачи КАК ОписаниеПоляФайлаПередачи,
		|	ФорматыОбменаБанкиКСПравилаОбмена.ОбязательностьЗаполнения КАК ОбязательностьЗаполнения,
		|	ФорматыОбменаБанкиКСПравилаОбмена.ТабличнаяЧасть КАК ТабличнаяЧасть,
		|	ФорматыОбменаБанкиКСПравилаОбмена.СекцияПечати КАК СекцияПечати,
		|	ФорматыОбменаБанкиКСПравилаОбмена.ПеременнаяПечати КАК ПеременнаяПечати,
		|	ЕСТЬNULL(ФорматыОбменаБанкиКСПравилаОбмена.ТипПоляФайлаПередачи.ПравилоФорматирования, """") КАК ПравилоФорматирования,
		|	ЕСТЬNULL(ФорматыОбменаБанкиКСПравилаОбмена.ТипПоляФайлаПередачи.СтрогоРавноМаксимальномуРазмеру, ЛОЖЬ) КАК СтрогоРавноМаксимальномуРазмеру,
		|	ВЫБОР
		|		КОГДА НЕ ПереопределяемыеПоля_ОграничениеРазмерности_Номер.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_ОграничениеРазмерности_Номер.ПользовательскоеВыражение
		|		КОГДА НЕ ПереопределяемыеПоля_ОграничениеРазмерности_Ноль.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_ОграничениеРазмерности_Ноль.ПользовательскоеВыражение
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ОграничениеРазмерностиПВ,
		|	ФорматыОбменаБанкиКСПравилаОбмена.ОграничениеРазмерности КАК ОграничениеРазмерности,
		|	ВЫБОР
		|		КОГДА НЕ ПереопределяемыеПоля_ПолеОбъекта_Номер.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_ПолеОбъекта_Номер.ПользовательскоеВыражение
		|		КОГДА НЕ ПереопределяемыеПоля_ПолеОбъекта_Ноль.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_ПолеОбъекта_Ноль.ПользовательскоеВыражение
		|		ИНАЧЕ ФорматыОбменаБанкиКСПравилаОбмена.ПолеОбъекта
		|	КОНЕЦ КАК ПолеОбъекта,
		|	ВЫБОР
		|		КОГДА НЕ ПереопределяемыеПоля_ПорядокЗаполнения_Номер.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_ПорядокЗаполнения_Номер.ПользовательскоеВыражение
		|		КОГДА НЕ ПереопределяемыеПоля_ПорядокЗаполнения_Ноль.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_ПорядокЗаполнения_Ноль.ПользовательскоеВыражение
		|		ИНАЧЕ ФорматыОбменаБанкиКСПравилаОбмена.ПорядокЗаполнения
		|	КОНЕЦ КАК ПорядокЗаполнения,
		|	ВЫБОР
		|		КОГДА НЕ ПереопределяемыеПоля_Условие_Номер.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_Условие_Номер.ПользовательскоеВыражение
		|		КОГДА НЕ ПереопределяемыеПоля_Условие_Ноль.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_Условие_Ноль.ПользовательскоеВыражение
		|		ИНАЧЕ ФорматыОбменаБанкиКСПравилаОбмена.Условие
		|	КОНЕЦ КАК Условие,
		|	ВЫБОР
		|		КОГДА НЕ ПереопределяемыеПоля_ПроверкаВалидностиДанных_Номер.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_ПроверкаВалидностиДанных_Номер.ПользовательскоеВыражение
		|		КОГДА НЕ ПереопределяемыеПоля_ПроверкаВалидностиДанных_Ноль.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_ПроверкаВалидностиДанных_Ноль.ПользовательскоеВыражение
		|		ИНАЧЕ ФорматыОбменаБанкиКСПравилаОбмена.ПроверкаВалидностиДанных
		|	КОНЕЦ КАК ПроверкаВалидностиДанных,
		|	ВЫБОР
		|		КОГДА НЕ ПереопределяемыеПоля_СообщениеПриОшибкеВалидности_Номер.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_СообщениеПриОшибкеВалидности_Номер.ПользовательскоеВыражение
		|		КОГДА НЕ ПереопределяемыеПоля_СообщениеПриОшибкеВалидности_Ноль.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_СообщениеПриОшибкеВалидности_Ноль.ПользовательскоеВыражение
		|		ИНАЧЕ ФорматыОбменаБанкиКСПравилаОбмена.СообщениеПриОшибкеВалидности
		|	КОНЕЦ КАК СообщениеПриОшибкеВалидности,
		|	ВЫБОР
		|		КОГДА НЕ ПереопределяемыеПоля_ДопДействия_Номер.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_ДопДействия_Номер.ПользовательскоеВыражение
		|		КОГДА НЕ ПереопределяемыеПоля_ДопДействия_Ноль.ПользовательскоеВыражение ЕСТЬ NULL
		|			ТОГДА ПереопределяемыеПоля_ДопДействия_Ноль.ПользовательскоеВыражение
		|		ИНАЧЕ ФорматыОбменаБанкиКСПравилаОбмена.ДопДействия
		|	КОНЕЦ КАК ДопДействия
		|ИЗ
		|	Справочник.ФорматыОбменаБанкиКС.ПравилаОбмена КАК ФорматыОбменаБанкиКСПравилаОбмена
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПереопределяемыеПоля КАК ПереопределяемыеПоля_ПолеОбъекта_Номер
		|		ПО ФорматыОбменаБанкиКСПравилаОбмена.Ссылка = ПереопределяемыеПоля_ПолеОбъекта_Номер.ФорматОбмена
		|			И ((ВЫРАЗИТЬ(ФорматыОбменаБанкиКСПравилаОбмена.ПолеФайлаПередачи КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ПереопределяемыеПоля_ПолеОбъекта_Номер.ПолеФайла КАК СТРОКА(1000))))
		|			И (ПереопределяемыеПоля_ПолеОбъекта_Номер.ОбрабатываемоеПоле = ""ПолеОбъекта"")
		|			И ФорматыОбменаБанкиКСПравилаОбмена.НомерСтроки = ПереопределяемыеПоля_ПолеОбъекта_Номер.НомерСтрокиПравил
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПереопределяемыеПоля КАК ПереопределяемыеПоля_ПолеОбъекта_Ноль
		|		ПО ФорматыОбменаБанкиКСПравилаОбмена.Ссылка = ПереопределяемыеПоля_ПолеОбъекта_Ноль.ФорматОбмена
		|			И ((ВЫРАЗИТЬ(ФорматыОбменаБанкиКСПравилаОбмена.ПолеФайлаПередачи КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ПереопределяемыеПоля_ПолеОбъекта_Ноль.ПолеФайла КАК СТРОКА(1000))))
		|			И (ПереопределяемыеПоля_ПолеОбъекта_Ноль.ОбрабатываемоеПоле = ""ПолеОбъекта"")
		|			И (ПереопределяемыеПоля_ПолеОбъекта_Ноль.НомерСтрокиПравил = 0)
