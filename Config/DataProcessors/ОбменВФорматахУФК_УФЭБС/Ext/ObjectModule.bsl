						НовПоле.Роль.Обязательное = Истина;
					Конеццикла;
					
				КонецЕсли;
				
				// Обратную связь с шапкой делаем с предыдущим источником
				ОбратнаяСвязь = СхемаКомпоновки.СвязиНаборовДанных.Добавить();
				ОбратнаяСвязь.НаборДанныхИсточник	= ТекущееПравило.ИсточникДанных + "1_BH";
				ОбратнаяСвязь.НаборДанныхПриемник	= ТекущееПравило.ИсточникДанных + "_" + ИдентификаторСтрокФормата;
		 		ОбратнаяСвязь.ВыражениеИсточник		= ТекущееПравило.ИсточникДанных + "1_BH.ID";   // связь считаем по гуиду
				ОбратнаяСвязь.ВыражениеПриемник		= ТекущееПравило.ИсточникДанных + "_" + ИдентификаторСтрокФормата+".ID";
								
				// создадим подчиненную группировку для файла структуры
				ГруппировкаБД = ТекущаяГруппировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
				ГруппировкаБД.Имя = "BH."+ТекущееПравило.ИсточникДанных;
				ГруппировкаБД.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
							
				// дополним группировку полями расшифровки
				ДополнитьПоляГруппировкиПолямиРасшифровки_ВО(ГруппировкаБД, ПоляРасшифровки_ВО, ТекущееПравило.ИсточникДанных+"1_", Новый Соответствие, 0);
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(ПравилаРасшифровки_ВС)  Тогда
				// создаем источник данных расшифровки для текущего заголовка
				// источник данных полностью повторяет расшифровку. меняется только ПутьКДанным
				ДопНаборДанныхРасшифровка                   = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
				ДопНаборДанныхРасшифровка.ИсточникДанных	= "ИсточникДанных1";
				ДопНаборДанныхРасшифровка.Имя 				= ТекущееПравило.ИсточникДанных+"2_SP";
				ДопНаборДанныхРасшифровка.ИмяОбъекта 		= "SP";
				
				Для каждого ТекСтрока Из ПоляРасшифровки_ВC Цикл
					
					ПолеФайла = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекСтрока.Поле, ".");
					ИмяПоля = ПолеФайла[0]+"_"+ПолеФайла[1];
					ПутьКДанным	= ТекущееПравило.ИсточникДанных+"2_"+ПолеФайла[0]+"."+ПолеФайла[1];
					
					Если ДопНаборДанныхРасшифровка.Поля.Найти(ПутьКДанным) = Неопределено Тогда
						
						НовПоле = ДопНаборДанныхРасшифровка.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
						НовПоле.Поле		= ИмяПоля;
						НовПоле.ПутьКДанным	= ТекущееПравило.ИсточникДанных+"2_"+ПолеФайла[0]+"."+ПолеФайла[1];
						НовПоле.Роль.Обязательное = Истина;
												
					КонецЕсли;
						
					Если НЕ ПустаяСтрока(ТекСтрока.ПутьКДанным) Тогда
						ПутьКДаннымРасшифровки 		= ТекущееПравило.ИсточникДанных+"2_"+ТекСтрока.ПутьКДанным;
						Если ПустаяСтрока(ТекСтрока.Выражение) Тогда
							ВыражениеПоляРасшифровки = ТекущееПравило.ИсточникДанных+"2_"+ТекСтрока.Поле;
						Иначе
							ВыражениеПоляРасшифровки 	= СтрЗаменить(ВРЕГ(ТекСтрока.Выражение), ТекСтрока.Поле, ТекущееПравило.ИсточникДанных+"2_"+ТекСтрока.Поле);
							ВыражениеПоляРасшифровки	= ОбщийМодульСКД.ПреобразоватьВыражениеСКД(ВыражениеПоляРасшифровки, РазрешенныеОбщиеМодули, ЗаменяемыеСлова, ЗаменяющиеСлова,, Отказ, ОписаниеОшибки);
						КонецЕсли;
						ЗаголовокПоляРасшифровки	= ТекущееПравило.ИсточникДанных+"2."+ТекСтрока.Поле;
						ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновки, ПутьКДаннымРасшифровки, ВыражениеПоляРасшифровки, ЗаголовокПоляРасшифровки);
					КонецЕсли;
					
				КонецЦикла; 
				
				// зададим связь источников данных
				НовыеСвязиНаборовДанных.Добавить(Новый Структура("НаборДанныхИсточник, НаборДанныхПриемник, ВыражениеИсточник, ВыражениеПриемник",
																 ТекущееПравило.ИсточникДанных,
																 ТекущееПравило.ИсточникДанных + "2_SP",
																 ТекущееПравило.ИсточникДанных  + ".GUID",
																 ТекущееПравило.ИсточникДанных + "2_SPD.GUID_FK"));
				
						
				// создадим источник данных для соединения текущего источника с таблицей строки
				
				Если СхемаКомпоновки.НаборыДанных.Найти(ТекущееПравило.ИсточникДанных+"_"+ИдентификаторСтрокФормата) = Неопределено Тогда
					
					НовыйНаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
					НовыйНаборДанных.ИсточникДанных	= "ИсточникДанных1";
					НовыйНаборДанных.Имя 			= ТекущееПравило.ИсточникДанных+"_"+ИдентификаторСтрокФормата;
					НовыйНаборДанных.ИмяОбъекта 	= ИдентификаторСтрокФормата;
					
					Для Каждого ТекПолеШапки Из НаборДанныхШапка.Поля Цикл
						НовПоле = НовыйНаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
						НовПоле.Поле		= ТекПолеШапки.Поле;
						НовПоле.ПутьКДанным = ТекущееПравило.ИсточникДанных + "_" + ТекПолеШапки.ПутьКДанным;
						НовПоле.Роль.Обязательное = Истина;
					Конеццикла;
					
				КонецЕсли;
				
				// Обратную связь с шапкой делаем с предыдущим источником
				ОбратнаяСвязь = СхемаКомпоновки.СвязиНаборовДанных.Добавить();
				ОбратнаяСвязь.НаборДанныхИсточник	= ТекущееПравило.ИсточникДанных + "2_SP";
				ОбратнаяСвязь.НаборДанныхПриемник	= ТекущееПравило.ИсточникДанных + "_" + ИдентификаторСтрокФормата;
		 		ОбратнаяСвязь.ВыражениеИсточник		= ТекущееПравило.ИсточникДанных + "2_SP.ID";   // связь считаем по гуиду
				ОбратнаяСвязь.ВыражениеПриемник		= ТекущееПравило.ИсточникДанных + "_" + ИдентификаторСтрокФормата+".ID";
								
				// создадим подчиненную группировку для файла структуры
				ГруппировкаБД = ТекущаяГруппировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
				ГруппировкаБД.Имя = "SP."+ТекущееПравило.ИсточникДанных;
				ГруппировкаБД.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
							
				// дополним группировку полями расшифровки
				ДополнитьПоляГруппировкиПолямиРасшифровки_ВС(ГруппировкаБД, ПоляРасшифровки_ВC, ТекущееПравило.ИсточникДанных+"2_", Новый Соответствие, 0);
			КонецЕсли;	

		КонецЕсли;
		
	КонецЦикла; 
	
	Для каждого ТекНоваяСвязь Из НовыеСвязиНаборовДанных Цикл
	
		ВыражениеИсточник = Неопределено;
		
		Для Каждого ПолеНабора Из СхемаКомпоновки.НаборыДанных.Найти(ТекНоваяСвязь.НаборДанныхИсточник).Поля Цикл
			Если ПолеНабора.Поле = СтрЗаменить(ТекНоваяСвязь.ВыражениеИсточник, ".", "_") Тогда
				ВыражениеИсточник = ПолеНабора.ПутьКДанным;
			КонецЕсли;
		КонецЦикла;
		ПолеПриемник = СхемаКомпоновки.НаборыДанных.Найти(ТекНоваяСвязь.НаборДанныхПриемник).Поля.Найти(ТекНоваяСвязь.ВыражениеПриемник);
		Если ПолеПриемник = Неопределено Тогда
			Для Каждого ПолеНабора Из СхемаКомпоновки.НаборыДанных.Найти(ТекНоваяСвязь.НаборДанныхПриемник).Поля Цикл
				Если ПолеНабора.Поле = СтрЗаменить(ТекНоваяСвязь.ВыражениеПриемник, ".", "_") Тогда
					ВыражениеПриемник = ПолеНабора.ПутьКДанным;
				КонецЕсли;
			КонецЦикла;
		Иначе
			ВыражениеПриемник = ПолеПриемник.ПутьКДанным;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыражениеИсточник) И ЗначениеЗаполнено(ВыражениеПриемник) Тогда		
			СвязьОстатков                       = СхемаКомпоновки.СвязиНаборовДанных.Добавить();
			СвязьОстатков.НаборДанныхИсточник	= ТекНоваяСвязь.НаборДанныхИсточник;
			СвязьОстатков.НаборДанныхПриемник	= ТекНоваяСвязь.НаборДанныхПриемник;
			СвязьОстатков.ВыражениеИсточник		= ВыражениеИсточник;   // связь считаем по гуиду
			СвязьОстатков.ВыражениеПриемник		= ВыражениеПриемник;
		КонецЕсли;	
	КонецЦикла; 
	
	Возврат СхемаКомпоновки;	
	
КонецФункции

Функция СодержимоеФайла(СсылкаДокумент, ИмяФайла, ВидОбмена, ИмяФайлаБезРасширения = "")
	
	Попытка
		КодировкаТекстаФайла	= КодировкаТекста[ВидОбмена.КодировкаТекстаФайла]
	Исключение
		КодировкаТекстаФайла    = ВидОбмена.КодировкаТекстаФайла;
	КонецПопытки;
	
	СодержимоеФайла = "";
	
	ВладелецФайла 	= СсылкаДокумент;
	
	МассивФайлов 	= Новый Массив;
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ВладелецФайла,МассивФайлов);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для каждого ПрисоединенныйФайл Из МассивФайлов Цикл
		Если (ПрисоединенныйФайл.Наименование + "." + ПрисоединенныйФайл.Расширение) = ИмяФайла тогда
			ИнформацияОФайле = РаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл);
			ИмяФайлаБезРасширения = ИнформацияОФайле.Наименование;
			
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла);
			
			Если ЭтоАдресВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла) Тогда
				ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
				ПолучитьИзВременногоХранилища(ИнформацияОФайле.СсылкаНаДвоичныеДанныеФайла).Записать(ИмяВременногоФайла);
				
				ТекстовыйФайл = Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекстаФайла);
				СодержимоеФайла = ТекстовыйФайл.Прочитать();
				ТекстовыйФайл.Закрыть();
				УдалитьФайлы(ИмяВременногоФайла);
				Прервать;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;   
	
	Если ВидОбмена.ПредставлениеВНомереВерсии  = "TX" Тогда
		СодержимоеФайла = ПреобразоватьТекстФайла(СодержимоеФайла);	
	КонецЕсли;  
	
	Если ВидОбмена.ПредставлениеВНомереВерсии = "UFBS" Тогда  
		
		ПостроительDOM = Новый ПостроительDOM;
	
		ЧтениеXML      = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(СодержимоеФайла); 
		
		ДокументDOM             = ПостроительDOM.Прочитать(ЧтениеXML);  
		ЗакодированноеСообщение = ДокументDOM.ПолучитьЭлементыПоИмени("Object");
		
		Если ЗакодированноеСообщение.Количество() > 0 Тогда  
			
			СодержимоеСообщения = Base64Значение(ЗакодированноеСообщение[0].ТекстовоеСодержимое); 
			
			ВременныйФайл       = ПолучитьИмяВременногоФайла();
	        СодержимоеСообщения.Записать(ВременныйФайл);      
								
			Чтение              = Новый ЧтениеТекста(ВременныйФайл, КодировкаТекстаФайла);
	        СодержимоеФайла     = Чтение.Прочитать();  
			
			Чтение.Закрыть();
			УдалитьФайлы(ВременныйФайл);
						
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СодержимоеФайла;
	
КонецФункции

Процедура ДобавитьПоляВСтруктуру(КоллекцияСтрок, КоллекцияСтруктуры)

	Если КоллекцияСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрокаСтруктуры = КоллекцияСтруктуры.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	
	Для каждого ТекСтрокаКоллекции Из КоллекцияСтрок Цикл
	
		Если Не ПустаяСтрока(ТекСтрокаКоллекции.ПоляГруппировки) Тогда
			ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(КоллекцияСтруктуры, ТекСтрокаКоллекции.ПоляГруппировки);
		Иначе
			ДобавитьПоляВСтруктуру(ТекСтрокаКоллекции.Строки, КоллекцияСтруктуры.Структура);
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры  

Функция СодержитТолькоЛатинскиеСимволы(Строка)
	
	ДопустимыеСимволы = "ABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789";
	
	Для поз = 0 по СтрДлина(Строка) - 1 Цикл
		Символ = Сред(Строка, поз, 1);
		Если СтрНайти(ДопустимыеСимволы, Символ) = 0 Тогда
			Возврат Ложь;
	    КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;   
	
КонецФункции	

Функция ПреобразоватьТекстФайла(ТекстФайла)
	
	ТекстФайлаДанных   = Новый ТекстовыйДокумент;
	ТекстФайлаДанных.УстановитьТекст(ТекстФайла);
	
	ИтоговыйТекстФайла = Новый ТекстовыйДокумент;      
	
	Для СчетчикСтрок = 1 По ТекстФайлаДанных.КоличествоСтрок() Цикл   
		
		РазбираемаяСтрока = ТекстФайлаДанных.ПолучитьСтроку(СчетчикСтрок);
		
		РазборСтроки = СтрРазделить(РазбираемаяСтрока, "|", Ложь); 
		
		Если РазборСтроки.Количество() = 0 Тогда 
		//если в файле ошибочно содержатся пустые строки	
			Продолжить; 
		КонецЕсли;	
		
		ИмяИсточника = РазборСтроки[0];
		
		Если НЕ СодержитТолькоЛатинскиеСимволы(ИмяИсточника) Тогда
		//это перенос строки	
		     НомерПоследнейИтоговойСтроки = ИтоговыйТекстФайла.КоличествоСтрок();
		     ИтоговыйТекстФайла.ЗаменитьСтроку(НомерПоследнейИтоговойСтроки, 
			 ИтоговыйТекстФайла.ПолучитьСтроку(НомерПоследнейИтоговойСтроки) + РазбираемаяСтрока);  
		Иначе	 
			 ИтоговыйТекстФайла.ДобавитьСтроку(РазбираемаяСтрока)
		КонецЕсли;	 
	КонецЦикла;	
	
	Возврат ИтоговыйТекстФайла.ПолучитьТекст(); 
	
КонецФункции

Процедура ЗагрузитьИзТекстовогоФайла(ТекстФайла, Формат, Задание, ИмяФайла, ДанныеНовыхКонтрагентов) 
	
	ТекстФайла = СтрЗаменить(ТекстФайла,"=-","=");  
		
	//Запрос = Новый Запрос("ВЫБРАТЬ
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.Ссылка,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.НомерСтроки КАК НомерСтроки,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.ПолеФайлаПередачи,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.ТипПоляФайлаПередачи,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.ОграничениеРазмерности,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.ОписаниеПоляФайлаПередачи,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.ПолеОбъекта,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.ПорядокЗаполнения,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.ОбязательностьЗаполнения,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.ТабличнаяЧасть,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.Условие,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.ДопДействия,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.СекцияПечати,
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.ПеременнаяПечати
	//					  |ИЗ
	//					  |	Справочник.ФорматыОбменаБанкиКС.ПравилаОбмена КАК ФорматыОбменаБанкиКСПравилаОбмена
	//					  |ГДЕ
	//					  |	ФорматыОбменаБанкиКСПравилаОбмена.Ссылка = &Ссылка
	//					  |
	//					  |УПОРЯДОЧИТЬ ПО
	//					  |	НомерСтроки");
	//					  
	//					  
	//Запрос.УстановитьПараметр("Ссылка", Формат);
	//ПравилаЗагрузки = Запрос.Выполнить().Выгрузить();
	
	ПравилаЗагрузки = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(Формат);
	
	ДеревоСтруктуры = Новый ДеревоЗначений;
	ДеревоСтруктуры.Колонки.Добавить("ИмяПоля",				Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПолноеИмяПоля",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ИмяПоляТаблицы",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПорядокЗаполнения", 	Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПолеОбъекта",			Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ТабличнаяЧасть",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ДопДействия",			Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("Условие",				Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("КонечныйЭлемент", 	Новый ОписаниеТипов("Булево"));
	ДеревоСтруктуры.Колонки.Добавить("Группировка",			Новый ОписаниеТипов("Строка"));
	
	СоответствиеВетвей = Новый Соответствие;
	Для каждого ТекПравило Из ПравилаЗагрузки Цикл
		Если Найти(ТекПравило.ПолеОбъекта, ".") = 0 и ПустаяСтрока(ТекПравило.ТабличнаяЧасть) Тогда
			КоллекцияСтрокДерева = СоответствиеВетвей.Получить("Объект");	
			Если КоллекцияСтрокДерева = Неопределено Тогда
				КоллекцияСтрокДерева = ДеревоСтруктуры.Строки.Добавить();
				КоллекцияСтрокДерева.Группировка = "Объект";
				СоответствиеВетвей.Вставить("Объект", КоллекцияСтрокДерева);
			КонецЕсли;
		    ТекСтрокаДерева = КоллекцияСтрокДерева.Строки.Добавить();
			ТекСтрокаДерева.ИмяПоля = "";
            ТекСтрокаДерева.Группировка = "Объект";
			ТекСтрокаДерева.ПолноеИмяПоля 		= ТекПравило.ПолеФайлаПередачи;
			ТекСтрокаДерева.ПолеОбъекта 		= ТекПравило.ПолеОбъекта;
			ТекСтрокаДерева.ПорядокЗаполнения	= ТекПравило.ПорядокЗаполнения;
			ТекСтрокаДерева.ТабличнаяЧасть 		= ТекПравило.ТабличнаяЧасть;
			ТекСтрокаДерева.ДопДействия 		= ТекПравило.ДопДействия;
			ТекСтрокаДерева.Условие		 		= ТекПравило.Условие;
		ИначеЕсли ЗначениеЗаполнено(ТекПравило.ТабличнаяЧасть) Тогда
			КоллекцияСтрокДерева = СоответствиеВетвей.Получить(ТекПравило.ТабличнаяЧасть);
			Если КоллекцияСтрокДерева = Неопределено Тогда
				СтрокаРодитель = СоответствиеВетвей.Получить("Объект");
				Если СтрокаРодитель = Неопределено Тогда
					СтрокаРодитель = ДеревоСтруктуры;
				КонецЕсли;
				КоллекцияСтрокДерева = СтрокаРодитель.Строки.Добавить();
				КоллекцияСтрокДерева.Группировка = ТекПравило.ТабличнаяЧасть;
				СоответствиеВетвей.Вставить(ТекПравило.ТабличнаяЧасть, КоллекцияСтрокДерева);
			КонецЕсли;
		    ТекСтрокаДерева = КоллекцияСтрокДерева.Строки.Добавить();
			ТекСтрокаДерева.ИмяПоля = "";
            ТекСтрокаДерева.Группировка 		= ТекПравило.ТабличнаяЧасть;
			ТекСтрокаДерева.ПолноеИмяПоля 		= ТекПравило.ПолеФайлаПередачи;
			ТекСтрокаДерева.ПолеОбъекта 		= ТекПравило.ПолеОбъекта;
			ТекСтрокаДерева.ПорядокЗаполнения	= ТекПравило.ПорядокЗаполнения;
			ТекСтрокаДерева.ТабличнаяЧасть 		= ТекПравило.ТабличнаяЧасть;
			ТекСтрокаДерева.ДопДействия 		= ТекПравило.ДопДействия;
			ТекСтрокаДерева.Условие		 		= ТекПравило.Условие;
		ИначеЕсли ВРЕГ(Лев(ТекПравило.ПолеОбъекта, 22)) = "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ." Тогда
			КоллекцияСтрокДерева = СоответствиеВетвей.Получить("ПроизвольныеПараметры");
			Если КоллекцияСтрокДерева = Неопределено Тогда
				СтрокаРодитель = СоответствиеВетвей.Получить("Объект");
				Если СтрокаРодитель = Неопределено Тогда
					СтрокаРодитель = ДеревоСтруктуры;
				КонецЕсли;
				КоллекцияСтрокДерева = СтрокаРодитель.Строки.Добавить();
				КоллекцияСтрокДерева.Группировка = "ПроизвольныеПараметры";
				СоответствиеВетвей.Вставить("ПроизвольныеПараметры", КоллекцияСтрокДерева);
			КонецЕсли;
		    ТекСтрокаДерева = КоллекцияСтрокДерева.Строки.Добавить();
			ТекСтрокаДерева.ИмяПоля = "";
            ТекСтрокаДерева.Группировка 		= "ПроизвольныеПараметры";
			ТекСтрокаДерева.ПолноеИмяПоля 		= ТекПравило.ПолеФайлаПередачи;
			ТекСтрокаДерева.ПолеОбъекта 		= ТекПравило.ПолеОбъекта;
			ТекСтрокаДерева.ПорядокЗаполнения	= ТекПравило.ПорядокЗаполнения;
			ТекСтрокаДерева.ТабличнаяЧасть 		= ТекПравило.ТабличнаяЧасть;
			ТекСтрокаДерева.ДопДействия 		= ТекПравило.ДопДействия;
			ТекСтрокаДерева.Условие		 		= ТекПравило.Условие;
		КонецЕсли;
	КонецЦикла;
	
	// произвольные параметры используются для группировки ДокументыДвижений. Перенесем их в эту ветвь ....
	СкопироватьВетвьДерева(СоответствиеВетвей["ПроизвольныеПараметры"], СоответствиеВетвей["ДокументыДвижений"], Новый Структура("Группировка", "ДокументыДвижений"));
	// ... и удалим ненужную более ветвь ПроизвольныеПараметры
	СоответствиеВетвей["Объект"].Строки.Удалить(СоответствиеВетвей["ПроизвольныеПараметры"]);
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("КонечныйЭлемент", Новый ОписаниеТипов("Булево"));
	СчетчикКолонок = 1;
	ЗаполнитьИменаПолейДереваСтруктуры(ДеревоСтруктуры, ТаблицаДанных, СчетчикКолонок);
	СтрокаТаблицы = Неопределено;
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстФайла);
	ЭтоСекцияРасчСчет = Ложь;
	
	ТаблицаОстатковПоЛС = Новый ТаблицаЗначений;
	ТаблицаОстатковПоЛС.Колонки.Добавить("ЛицевойСчет");
	ТаблицаОстатковПоЛС.Колонки.Добавить("ЛицевойСчетСтрока");
	ТаблицаОстатковПоЛС.Колонки.Добавить("НачальныйОстаток");
	ТаблицаОстатковПоЛС.Колонки.Добавить("КонечныйОстаток");
	ТаблицаОстатковПоЛС.Колонки.Добавить("Отработано",Новый ОписаниеТипов("Булево"));
	
	МассивСчетов         = Новый Массив;
	ТекущийРасчетныйСчет = "";
	
	ТаблицаДанныхКопия   = "";
	
	НовСтрДанных = Ложь;
	ПерваяСекция = Истина;
	Для Счетчик=1 По ТекстовыйДокумент.КоличествоСтрок() Цикл
		ТекСтр = ТекстовыйДокумент.ПолучитьСтроку(Счетчик);
		Поз = Найти(ТекСтр, "=");
		Если Поз = 0 Тогда
			// обрабатываем служебные поля
			ИмяПоля = СокрЛП(ТекСтр);
			Если ИмяПоля = "СекцияРасчСчет" Тогда
				
		//		Если МассивСчетов.Найти(ТекущийРасчетныйСчет) =  Неопределено Тогда    //исправление ошибки: дублирование документов движений
				ЭтоСекцияРасчСчет  = Истина;
				НовСтрДанных       = Истина;
		//		КонецЕсли;
				
				ТаблицаДанныхКопия = ТаблицаДанных.Скопировать();
				
			ИначеЕсли ИмяПоля = "КонецРасчСчет" Тогда
				
				ЭтоСекцияРасчСчет                    = Ложь;	
				
				Если ЗначениеЗаполнено(ТекущийРасчетныйСчет) Тогда
					//если этот расчетный счет не повторялся в файле передачи ранее, 
					//чтобы не приводить к дублированию документов движений
					Если МассивСчетов.Найти(ТекущийРасчетныйСчет) = Неопределено Тогда
						МассивСчетов.Добавить(ТекущийРасчетныйСчет);
						СтрокаТаблицы                 = ТаблицаДанных.Добавить();
						СтрокаТаблицы.КонечныйЭлемент = Истина;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			Если ИмяПоля = "КонецДокумента" Тогда				
				СтрокаТаблицы = ТаблицаДанных.Добавить();
				СтрокаТаблицы.КонечныйЭлемент = Истина;
			КонецЕсли;
			//Если ТекСтр = "1CClientBankExchange" Тогда       
			//	СтрокаТаблицы = ТаблицаДанных.Добавить();
			//КонецЕсли;
		Иначе
			ИмяПоля = Лев(ТекСтр, Поз-1);
			Значение = Сред(ТекСтр, Поз+1);    
			
			Если ИмяПоля = "КонецДокумента" Тогда				
				СтрокаТаблицы = ТаблицаДанных.Добавить();
				СтрокаТаблицы.КонечныйЭлемент = Истина;
			КонецЕсли;  
			
			Если ИмяПоля = "СекцияДокумент" Тогда				
				СтрокаТаблицы.КонечныйЭлемент = Истина;
			КонецЕсли; 
			
			Если ЭтоСекцияРасчСчет Тогда   
				
				Если НовСтрДанных Тогда
			    	НовСтр = ТаблицаОстатковПоЛС.Добавить();
				КонецЕсли;
				Если ИмяПоля = "РасчСчет" Тогда
					ТекущийРасчетныйСчет     = Значение;
					Если МассивСчетов.Найти(ТекущийРасчетныйСчет) <> Неопределено Тогда
						 НовСтрДанных        = Ложь;
					//	 ТаблицаДанных       = ТаблицаДанныхКопия.Скопировать();                             //исправление ошибки: в ходе импорта данных не загружался первый
					КонецЕсли;                                                                               //документ движения выписки
					ТекЛС                    = БиблиотекаФункцийОбмена.НайтиЛицевойСчетПоНомеру(Значение);    
					Если НЕ ЗначениеЗаполнено(ТекЛС) Тогда
						БиблиотекаФункцийОбмена.ПрерватьЗагрузкуФайла("Не найден лицевой счет %1", Значение);		
					КонецЕсли;
					НовСтр.ЛицевойСчетСтрока = Значение;
					НовСтр.ЛицевойСчет       = ТекЛС;
				ИначеЕсли ИмяПоля = "НачальныйОстаток" ИЛИ ИмяПоля = "КонечныйОстаток" Тогда
					НовСтр[ИмяПоля] = БиблиотекаФункцийОбмена.СтрокаВЧисло(Значение);
				КонецЕсли;
				
			КонецЕсли;
			
			СтрокаСтруктуры = ДеревоСтруктуры.Строки.Найти(ИмяПоля ,"ПолноеИмяПоля", Истина);
			
			Если СтрокаСтруктуры = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаТаблицы = Неопределено Тогда
				НовСтрДанных = Ложь;
				Если СтрокаСтруктуры.Группировка = "Объект" Тогда
					СтрокаТаблицы = ТаблицаДанных.Добавить();
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если НовСтрДанных Тогда
				СтрокаТаблицы = ТаблицаДанных.Добавить();
			КонецЕсли;
			
			СтрокаТаблицы[СтрокаСтруктуры.ИмяПоляТаблицы] = Значение;
			
			Если Найти(СтрокаСтруктуры.ПолеОбъекта, "ДатаДвижения") > 0 И Значение = "" Тогда
				 СтрокаТаблицы[СтрокаСтруктуры.ИмяПоляТаблицы] = "Х"
			КонецЕсли;
			//КонецЕсли;	
						
		КонецЕсли;
		
	КонецЦикла;
	
	// Разделим таблицу на таблицу выписок и таблицу документов движений
	// Массив имен колонок, по которым будем разделять таблицу. Т.к. поля не обязательны, используем массив.
	МассивИмен = Новый Массив;
	МассивИмен.Добавить("КонецРасчСчет");
	МассивИмен.Добавить("КонечныйОстаток");
	МассивИмен.Добавить("ВсегоСписано");
    МассивИмен.Добавить("ВсегоПоступило");
	МассивИмен.Добавить("НачальныйОстаток");
	ИмяПоля = "";    // Имя колонки, по которой будем делить
	Для Каждого ЭлементМассива Из МассивИмен Цикл
		СтрокаДерева = ДеревоСтруктуры.Строки.Найти(ЭлементМассива,"ПолноеИмяПоля",Истина);
		Если СтрокаДерева <> Неопределено Тогда
			ИмяПоля = СтрокаДерева.ИмяПоляТаблицы;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ПерваяТаблица = Истина;
	ИменаКолонокВып = "КонечныйЭлемент";
	ИменаКолонокДвиж = "КонечныйЭлемент";
	КоличествоКолонок = ТаблицаДанных.Колонки.Количество()-1;
	//ИменаКолонок	= Новый Массив(КоличествоКолонок);
	Для i=1 По КоличествоКолонок Цикл
		ИмяКолонки = ТаблицаДанных.Колонки[i].Имя;
		Если ПерваяТаблица Тогда
			Если ИмяКолонки = ИмяПоля Тогда
				ПерваяТаблица = Ложь;
			КонецЕсли;
			ИменаКолонокВып = ИменаКолонокВып + ", "+ ИмяКолонки;
		Иначе			
			ИменаКолонокДвиж = ИменаКолонокДвиж + ", "+ ИмяКолонки;
		КонецЕсли;
	КонецЦикла;
	//ИменаКолонокВып = Сред(ИменаКолонокВып,3);
	//ИменаКолонокДвиж = Сред(ИменаКолонокДвиж,3);
	ТаблицаВыписок = ТаблицаДанных.Скопировать(,ИменаКолонокВып);
	ТаблицаДокДвиж = ТаблицаДанных.Скопировать(,ИменаКолонокДвиж);
	
	МассивИменСтрок = Новый Массив;
	МассивИменСтрок.Добавить("ВерсияФормата");
	МассивИменПолейТД = Новый Массив;
	Для Каждого ЭлМас Из МассивИменСтрок Цикл
		ТекСтрока = ДеревоСтруктуры.Строки.Найти(ЭлМас, "ПолноеИмяПоля",Истина);
		Если ТекСтрока <> Неопределено Тогда
			МассивИменПолейТД.Добавить(ТекСтрока.ИмяПоляТаблицы);	
		КонецЕсли;
	КонецЦикла;
	
	СвернутьТаблицуЗначений(ТаблицаВыписок,МассивИменПолейТД);
	
	МассивИменСтрок = Новый Массив;
	МассивИменСтрок.Добавить("СекцияДокумент");
	МассивИменПолейТД = Новый Массив;
	Для Каждого ЭлМас Из МассивИменСтрок Цикл
		ТекСтрока = ДеревоСтруктуры.Строки.Найти(ЭлМас, "ПолноеИмяПоля", Истина);
		Если ТекСтрока <> Неопределено Тогда
			МассивИменПолейТД.Добавить(ТекСтрока.ИмяПоляТаблицы);	
		КонецЕсли;
	КонецЦикла;
	
	СвернутьТаблицуЗначений(ТаблицаДокДвиж, МассивИменПолейТД);
	
	Для каждого Строка Из ТаблицаДокДвиж Цикл
		Для каждого Колонка Из ТаблицаДокДвиж.Колонки Цикл
			Если Строка[Колонка.Имя] = "Х" Тогда
				 Строка[Колонка.Имя] = ""
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаВыписок.Свернуть(ИменаКолонокВып);
	
	МассивСтрокКУдалению = Новый Массив;
	ИмяПоля = "ПлательщикСчет";
	СтрДер =  ДеревоСтруктуры.Строки.Найти(ИмяПоля,"ПолноеИмяПоля",Истина);
	
	Для Каждого СтрТЧ Из ТаблицаДокДвиж Цикл
		Если Не ЗначениеЗаполнено(СтрТЧ[СтрДер.ИмяПоляТаблицы]) Тогда
			МассивСтрокКУдалению.Добавить(СтрТЧ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЭлМас Из МассивСтрокКУдалению Цикл
		ТаблицаДокДвиж.Удалить(ЭлМас);
	КонецЦикла;
		
    ИмяПоляПлательщикСчет 			= ДеревоСтруктуры.Строки.Найти("ПлательщикСчет", "ПолноеИмяПоля",Истина).ИмяПоляТаблицы;
	ИмяПоляПолучательСчет 			= ДеревоСтруктуры.Строки.Найти("ПолучательСчет", "ПолноеИмяПоля",Истина).ИмяПоляТаблицы;
	ИмяПоляРасчСчет 				= ДеревоСтруктуры.Строки.Найти("РасчСчет",       "ПолноеИмяПоля",Истина).ИмяПоляТаблицы;
	ИмяПоляДатаПоступило 			= ДеревоСтруктуры.Строки.Найти("ДатаПоступило",  "ПолноеИмяПоля",Истина).ИмяПоляТаблицы;
	ИмяПоляДатаСписано 				= ДеревоСтруктуры.Строки.Найти("ДатаСписано",    "ПолноеИмяПоля",Истина).ИмяПоляТаблицы;
	
	Запрос 							= Новый Запрос;
	Запрос.УстановитьПараметр("ТабВып",ТаблицаВыписок);
	Запрос.УстановитьПараметр("ТабДвиж",ТаблицаДокДвиж);
	
	СтрКолонкиВып 					= "";
	Для Каждого КолонкаТЧ Из ТаблицаВыписок.Колонки Цикл
		Если КолонкаТЧ.Имя = "КонечныйЭлемент" Тогда
			Продолжить;
		КонецЕсли;
		СтрКолонкиВып = СтрКолонкиВып +?(СтрКолонкиВып="","",", ") + КолонкаТЧ.Имя+" КАК  "+ КолонкаТЧ.Имя;// "ВЫРАЗИТЬ("+КолонкаТЧ.Имя+" КАК СТРОКА(1000))"
	КонецЦикла;
	
	СтрКолонкиДвиж = "";
	Для Каждого КолонкаТЧ Из ТаблицаДокДвиж.Колонки Цикл
		Если КолонкаТЧ.Имя = "КонечныйЭлемент" Тогда
			Продолжить;
		КонецЕсли;
		СтрКолонкиДвиж = СтрКолонкиДвиж +?(СтрКолонкиДвиж = "","",", ") + КолонкаТЧ.Имя+" КАК  "+ КолонкаТЧ.Имя;//"ВЫРАЗИТЬ("+КолонкаТЧ.Имя+" КАК СТРОКА(1000))"
	КонецЦикла;
	
	Запрос.Текст = 
			"ВЫБРАТЬ
			| "+СтрКолонкиВып+"
			|ПОМЕСТИТЬ ТабВыписок
			|ИЗ
			|	&ТабВып КАК ТабВып
			|;
            |
			|////////////////////////////////////////////////////////////////////////////////
            |
			|ВЫБРАТЬ
			|	"+СтрКолонкиДвиж+"
			|ПОМЕСТИТЬ ТабДокументов
			|ИЗ
			|	&ТабДвиж КАК ТабДвиж
			|;
            |
			|////////////////////////////////////////////////////////////////////////////////
            |
			|Выбрать
			|*
			|Из 
			|ТабВыписок
			|Левое Соединение ТабДокументов По
			|ТабВыписок."+ИмяПоляРасчСчет+" = ТабДокументов."+ИмяПоляПлательщикСчет+" И ТабДокументов."+ИмяПоляДатаСписано+"<>"""" ИЛИ ТабВыписок."+ИмяПоляРасчСчет+" = ТабДокументов."+ИмяПоляПолучательСчет+" И ТабДокументов."+ИмяПоляДатаПоступило+"<>""""";
			
	Результат = Запрос.Выполнить();

	ОбщаяТаблица = Результат.Выгрузить();

	//СвернутьТаблицуЗначений(ТаблицаДанных);
	
	// создание схемы компоновки данных
	СхемаКомпоновкиРезультата = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновкиРезультата.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = СхемаКомпоновкиРезультата.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя 			= "НаборДанных1";
	НаборДанных.ИмяОбъекта 		= "ВходящиеДанные";
	НаборДанных.ИсточникДанных 	= "ИсточникДанных1";
	
	РазрешенныеМодули = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("БИБЛИОТЕКАФУНКЦИЙОБМЕНА");
	СоответствиеГруппировок = Новый Соответствие;
	СоздатьСтруктуруСхемыКомпоновкиИзДерева(ДеревоСтруктуры, СхемаКомпоновкиРезультата.НастройкиПоУмолчанию, СхемаКомпоновкиРезультата, НаборДанных, РазрешенныеМодули, СоответствиеГруппировок);	
	
	ВнешниеНаборы = Новый Структура("ВходящиеДанные", ОбщаяТаблица);
	ФорматЗагрузки = Формат;
	
	Параметр = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя = "КассовыйОрган";
	Параметр.Значение = Задание.КассовыйОрган;
	Параметр.ВключатьВДоступныеПоля = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	//Параметр = СхемаКомпоновкиРезультата.Параметры.Добавить();
	//Параметр.Имя = "Задание";
	//Параметр.Значение = Задание.Ссылка;
	//Параметр.ВключатьВДоступныеПоля = Ложь;
	//Параметр.ОграничениеИспользования = Истина;
	
	НастройкиКомпоновки = СхемаКомпоновкиРезультата.НастройкиПоУмолчанию;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиРезультата, НастройкиКомпоновки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); 
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы,,Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	РезультатВыполнения = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	СокращенноеДеревоСтруктуры = Новый ДеревоЗначений;
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Группировка", Новый ОписаниеТипов("Строка"));
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Поля", Новый ОписаниеТипов("Массив"));
	СократитьДерево(ДеревоСтруктуры, СокращенноеДеревоСтруктуры, СоответствиеГруппировок); 
	ЭтоПервый = Истина;

	
	Для каждого СтрокаРезультата Из РезультатВыполнения.Строки Цикл
		
		СтрокаГруппировки = СокращенноеДеревоСтруктуры.Строки[0];
		Попытка
			СтрокаРезультата.Строки.Сортировать("ПроизвольныеПараметрыДатаДвижения Возр");
		Исключение
			
		КонецПопытки;
		
		СтрокаРеквизитов = "";
		Для каждого ТекПоле Из СтрокаГруппировки.Поля Цикл
			СтрокаРеквизитов = СтрокаРеквизитов + "," +ТекПоле;
		КонецЦикла;
		СтрокаРеквизитов = Сред(СтрокаРеквизитов, 2);
		//ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаРезультата, СтрокаРеквизитов);
		//ЗаполнитьЗначенияСвойств(ДокументОбъект, Задание, "Организация");
		//Если ДокументОбъект.Ссылка.Пустая() Тогда
		//	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		//КонецЕсли;
		ДокументОбъект = Неопределено;
		Для каждого ВложеннаяГруппировка Из СтрокаГруппировки.Строки Цикл
			//Если ЭтоПервый И КоличествоСтрок>0 Тогда
			//	ДатаДокумента = СтрокаРезультата.Строки[1].ПроизвольныеПараметрыДатаДок;
			//ДокументОбъект = ПолучитьВыпискуИзЛицевогоСчета(ДокументОбъект, Задание.Организация, СтрокаРезультата.ЛицевойСчет, ДатаДокумента, СтрокаРеквизитов, СтрокаРезультата);
			
			СтрокаРеквизитов = "";
			Для каждого ТекПоле Из ВложеннаяГруппировка.Поля Цикл
				Если Лев(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка)+1) = ВложеннаяГруппировка.Группировка+"." Тогда
					СтрокаРеквизитов = СтрокаРеквизитов + "," +Сред(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка)+2);	
				Иначе
					СтрокаРеквизитов = СтрокаРеквизитов + "," +ТекПоле;
				КонецЕсли;
			КонецЦикла;
			СтрокаРеквизитов = Сред(СтрокаРеквизитов, 2);
			Если Найти(СтрокаРеквизитов, ".") = 0 Тогда
				
				Попытка
					Если СтрокаРезультата.Строки[1].ПроизвольныеПараметрыВидДокумента = Null Тогда
						//Нет документов движений
						ДатаВыписки = СтрокаРезультата.Дата;
					Иначе
						ДатаВыписки = СтрокаРезультата.Строки[1].ПроизвольныеПараметрыДатаДвижения;
						Если Не ЗначениеЗаполнено(ДатаВыписки) Тогда
							ДатаВыписки = СтрокаРезультата.Дата;
						КонецЕсли;
					КонецЕсли;
				Исключение
					ДатаВыписки = СтрокаРезультата.Дата;
				КонецПопытки;
				
				ЛицевойСчет = СтрокаРезультата.ЛицевойСчет;

				ДокументОбъект = ПолучитьВыпискуИзЛицевогоСчета(ДокументОбъект, Задание, ЛицевойСчет, ДатаВыписки, СтрокаРеквизитов, СтрокаРезультата, Формат, ИмяФайла);
			
				// в СтрокаРеквизитов только имена табличной части
				СтруктураПроверки = Новый Структура(СтрокаРеквизитов);
				Для каждого ВложеннаяСтрока Из СтрокаРезультата.Строки Цикл
					ЕстьЗаполненные = Ложь;
					Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
						СтруктураПроверки[ЗначениеПроверки.Ключ] = ВложеннаяСтрока[ВложеннаяГруппировка.Группировка+ЗначениеПроверки.Ключ];	
						ЕстьЗаполненные = Макс(ЕстьЗаполненные, ЗначениеЗаполнено(СтруктураПроверки[ЗначениеПроверки.Ключ]));
					КонецЦикла;
					Если ЕстьЗаполненные Тогда
						ЗаполнитьЗначенияСвойств(ДокументОбъект[ВложеннаяГруппировка.Группировка].Добавить(), СтруктураПроверки);
					КонецЕсли;
				КонецЦикла; 
			Иначе
				// в СтрокаРеквизитов есть дополнительные параметры. Требуется выделение параметров и вызов процедуры
				СтруктураПроверки = Новый Структура(СтрЗаменить(СтрокаРеквизитов, ".", ""));	
				Для каждого ВложеннаяСтрока Из СтрокаРезультата.Строки Цикл
					ЕстьЗаполненные = Ложь;
					ЗаполнитьЗначенияСвойств(СтруктураПроверки, ВложеннаяСтрока);
					Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
						ЕстьЗаполненные = Макс(ЕстьЗаполненные, ЗначениеЗаполнено(СтруктураПроверки[ЗначениеПроверки.Ключ]));
						Если ЕстьЗаполненные Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если ЕстьЗаполненные Тогда
						Попытка
							ДатаДокумента = ВложеннаяСтрока.ПроизвольныеПараметрыДатаДвижения;
						Исключение
							ДатаДокумента = ВложеннаяСтрока.Дата;
						КонецПопытки;
						
						ЛицевойСчет = ВложеннаяСтрока.ЛицевойСчет;
						
						ДокументОбъект = ПолучитьВыпискуИзЛицевогоСчета(ДокументОбъект, Задание, ЛицевойСчет, ДатаДокумента, СтрокаРеквизитов, ВложеннаяСтрока, Формат, ИмяФайла);

						ФункцияЗаполнения = ВложеннаяСтрока["ДокументыДвиженийИсполняющийДокумент"];
						ДеревоВыполнения = СоздатьДеревоВыполнения(ФункцияЗаполнения);
						ПараметрыВызоваФункции = Новый Структура;
						Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
							Если ВРЕГ(Лев(ЗначениеПроверки.Ключ, 21)) = "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ" Тогда
								ПараметрыВызоваФункции.Вставить(Сред(ЗначениеПроверки.Ключ, 22), ЗначениеПроверки.Значение);
							КонецЕсли;
						КонецЦикла; 
						
						ИсполняющийДокумент = Неопределено;
						ОбработатьДеревоВариантов(ДеревоВыполнения, ПараметрыВызоваФункции, ИсполняющийДокумент, ДокументОбъект, Задание, ДанныеНовыхКонтрагентов);	
											
						Если ЗначениеЗаполнено(ИсполняющийДокумент) Тогда
							ДокументОбъект.ДокументыДвижений.Добавить().ИсполняющийДокумент = ИсполняющийДокумент;
						КонецЕсли;
						
					КонецЕсли;
				КонецЦикла; 
			КонецЕсли;
		КонецЦикла; 
		
		Если Задание.ОбъектыОбмена.Найти(ДокументОбъект.Ссылка) = Неопределено Тогда
			
			ПересчитатьСуммуОстатковВыпискиИзЛС(Задание, ДокументОбъект);
			
			НовСтрокаЗадания = Задание.ОбъектыОбмена.Добавить();
			НовСтрокаЗадания.ИмяФайлаЗагрузки	    = ИмяФайла;
			НовСтрокаЗадания.Формат				    = Формат;
			НовСтрокаЗадания.Объект				    = ДокументОбъект.Ссылка;
			
		КонецЕсли;
				
	КонецЦикла; 
КонецПроцедуры

Функция ПолучитьВыпискуИзЛицевогоСчета(Знач ИсхДокументОбъект, Задание, ЛицевойСчет, ДатаВыписки, СтрокаРеквизитов, СтрокаРезультата, Формат, ИмяФайла)
	
	Если ТипЗнч(ИсхДокументОбъект) = Тип("ДокументОбъект.ВыпискаИзЛицевогоСчета") Тогда
		Если ИсхДокументОбъект.ДатаВыписки = ДатаВыписки И ИсхДокументОбъект.ЛицевойСчет = ЛицевойСчет Тогда
			Возврат ИсхДокументОбъект;
		Иначе
			Если Задание.ОбъектыОбмена.Найти(ИсхДокументОбъект.Ссылка) = Неопределено Тогда

				ПересчитатьСуммуОстатковВыпискиИзЛС(Задание,ИсхДокументОбъект);
				
				НовСтрокаЗадания = Задание.ОбъектыОбмена.Добавить();
				НовСтрокаЗадания.ИмяФайлаЗагрузки	= ИмяФайла;
				НовСтрокаЗадания.Формат				= Формат;
				НовСтрокаЗадания.Объект				= ИсхДокументОбъект.Ссылка;
				
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ВыпискаИзЛицевогоСчета.Ссылка
	                      |ИЗ
	                      |	Документ.ВыпискаИзЛицевогоСчета КАК ВыпискаИзЛицевогоСчета
	                      |ГДЕ
	                      |	ВыпискаИзЛицевогоСчета.ДатаВыписки = &ДатаВыписки
	                      |	И ВыпискаИзЛицевогоСчета.ЛицевойСчет = &ЛицевойСчет
	                      |	И ВыпискаИзЛицевогоСчета.Организация = &Организация
	                      |	И НЕ ВыпискаИзЛицевогоСчета.ПометкаУдаления");
	Запрос.УстановитьПараметр("Организация", Задание.Организация);							  
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);							  
	Запрос.УстановитьПараметр("ДатаВыписки", ДатаВыписки);
	СохраненныйДокумент = Запрос.Выполнить().Выгрузить();
	Если СохраненныйДокумент.Количество() = 0 Тогда
		ДокументОбъект = Документы.ВыпискаИзЛицевогоСчета.СоздатьДокумент();
	Иначе
		ДокументОбъект = СохраненныйДокумент[0].Ссылка.ПолучитьОбъект();
		Попытка
			ЗаблокироватьДанныеДляРедактирования(ДокументОбъект.Ссылка);
		Исключение
			ВызватьИсключение НСтр("ru='Невозможно заблокировать для редактирования документ '")+СохраненныйДокумент;
		КонецПопытки;
		ДокументОбъект.Остатки.Очистить();
		ДокументОбъект.ДокументыДвижений.Очистить();
	КонецЕсли;
	//Если НЕ ЭтоОстатки Тогда
	//	ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаРезультата, СтрокаРеквизитов);
	//КонецЕсли;
	ДокументОбъект.Дата = ДатаВыписки;
	ДокументОбъект.ДатаВыписки = ДатаВыписки;
	ДокументОбъект.Организация = Задание.Организация;
	ДокументОбъект.ЛицевойСчет = ЛицевойСчет;
	ДокументОбъект.КассовыйОрган = Задание.КассовыйОрган;

	Если ДокументОбъект.Ссылка.Пустая() Тогда
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	Возврат ДокументОбъект;

КонецФункции // ()

Процедура СвернутьТаблицуЗначений(ТаблицаДанных, МассивИменПолей) Экспорт
	ИмяПоля = "";
	ЕстьПроверка = Ложь;
	Если МассивИменПолей.Количество()> 0 Тогда
		ЕстьПроверка = Истина;
	КонецЕсли;
	// заполним колонки конечных элементов значениями из вышестоящих неконечных элементов
	КоличествоКолонок = ТаблицаДанных.Колонки.Количество()-1;
	ИменаКолонок	= Новый Массив(КоличествоКолонок);
	Для i=1 По КоличествоКолонок Цикл
		ИменаКолонок[i-1] = ТаблицаДанных.Колонки[i].Имя;
	КонецЦикла;
		
	ДанныеЗаполнения = Новый Массив(КоличествоКолонок);
	Для каждого ТекСтрока Из ТаблицаДанных Цикл
		Если ТекСтрока.КонечныйЭлемент Тогда
			Для i=0 По КоличествоКолонок-1 Цикл
				Если Не ЗначениеЗаполнено(ТекСтрока[ИменаКолонок[i]]) И ЗначениеЗаполнено(ДанныеЗаполнения[i]) Тогда
					ТекСтрока[ИменаКолонок[i]] = ДанныеЗаполнения[i];
				КонецЕсли;
			КонецЦикла;
		Иначе
			Если ЕстьПроверка Тогда
				Для Каждого ИмяПоля Из МассивИменПолей Цикл
					Если ТаблицаДанных.Колонки.Найти(ИмяПоля)= Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Если ТекСтрока[ИмяПоля] <> "" Тогда
						ДанныеЗаполнения = Новый Массив(КоличествоКолонок);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Для i=0 По КоличествоКолонок-1 Цикл			
				Если ЗначениеЗаполнено(ТекСтрока[ИменаКолонок[i]]) Тогда
					ДанныеЗаполнения[i] = ТекСтрока[ИменаКолонок[i]];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла; 
	// удалим все неконечные элементы из таблицы данных
	НеконечныеЭлементы = ТаблицаДанных.НайтиСтроки(Новый Структура("КонечныйЭлемент", Ложь));
	Для каждого ТекЭлемент Из НеконечныеЭлементы Цикл
		Если ТаблицаДанных.Количество() > 1 Тогда
		//оставить хотя бы один элемент, если все неконечные
			ТаблицаДанных.Удалить(ТекЭлемент);
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Процедура ПолучитьСуммыПоступленияСписанияИзВыписки(ВыпискаСсылка,СуммаПоступило,СуммаСписано)

	СуммаПоступило = 0;
	СуммаСписано = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыпискаИзЛицевогоСчетаДокументыДвижений.ИсполняющийДокумент,
		|	ВЫБОР
		|		КОГДА ВыпискаИзЛицевогоСчетаДокументыДвижений.ИсполняющийДокумент ССЫЛКА Документ.КассовоеПоступление
		|			ТОГДА ВыпискаИзЛицевогоСчетаДокументыДвижений.ИсполняющийДокумент.СуммаДокумента
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаПоступило,
		|	ВЫБОР
		|		КОГДА ВыпискаИзЛицевогоСчетаДокументыДвижений.ИсполняющийДокумент ССЫЛКА Документ.КассовоеПоступление
		|			ТОГДА 0
		|		ИНАЧЕ ВыпискаИзЛицевогоСчетаДокументыДвижений.ИсполняющийДокумент.СуммаДокумента
		|	КОНЕЦ КАК СуммаСписано
		|ИЗ
		|	Документ.ВыпискаИзЛицевогоСчета.ДокументыДвижений КАК ВыпискаИзЛицевогоСчетаДокументыДвижений
		|ГДЕ
		|	ВыпискаИзЛицевогоСчетаДокументыДвижений.Ссылка = &Ссылка
		|ИТОГИ
		|	СУММА(СуммаПоступило),
		|	СУММА(СуммаСписано)
		|ПО
		|	ОБЩИЕ";

	Запрос.УстановитьПараметр("Ссылка", ВыпискаСсылка);

	Результат = Запрос.Выполнить();

	Выгрузка = Результат.Выгрузить();

	Если Выгрузка.Количество()>0 Тогда
		СуммаПоступило = Выгрузка[0].СуммаПоступило;
		СуммаСписано = Выгрузка[0].СуммаСписано;
	КонецЕсли;
КонецПроцедуры

Процедура ПересчитатьСуммуОстатковВыпискиИзЛС(Задание,ВыпискаОбъект)
	
	Перем СуммаПоступило;
	Перем СуммаСписано;
	
	ОстНаНачало = 0;
	
	Если Задание.ОбъектыОбмена.Количество() > 0 Тогда
		ПоследняяВыписка = Задание.ОбъектыОбмена[Задание.ОбъектыОбмена.Количество()-1].Объект;
		Если ПоследняяВыписка.Остатки.Количество() > 0 И ПоследняяВыписка.ЛицевойСчет = ВыпискаОбъект.ЛицевойСчет Тогда
			ОстНаНачало     = ПоследняяВыписка.Остатки[0].ОстатокНаКонецДня;
			ИсточникСредств = ПоследняяВыписка.Остатки[0].ИсточникСредств;
			Показатель      = ПоследняяВыписка.Остатки[0].Показатель;
		КонецЕсли;	
		ВыпискаОбъект.ДатаПредыдущейВыписки = ПоследняяВыписка.ДатаВыписки;
	КонецЕсли;
	//Записываем документ перед тем как пересчитать ТЧ Остатки
	ВыпискаОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	ПолучитьСуммыПоступленияСписанияИзВыписки(ВыпискаОбъект.Ссылка, СуммаПоступило, СуммаСписано);
	
	Если ВыпискаОбъект.Остатки.Количество() = 0 Тогда
		СтрокаОстатков                      = ВыпискаОбъект.Остатки.Добавить();
		СтрокаОстатков.ИсточникСредств      = ИсточникСредств;
		СтрокаОстатков.Показатель           = Показатель;
		СтрокаОстатков.ОстатокНаНачалоДня   = ОстНаНачало;
		СтрокаОстатков.ОстатокНаКонецДня    = ОстНаНачало + СуммаПоступило - СуммаСписано;
	Иначе
		СтрокаОстатков = ВыпискаОбъект.Остатки[0];
		СтрокаОстатков.ОстатокНаКонецДня = СтрокаОстатков.ОстатокНаНачалоДня + СуммаПоступило - СуммаСписано;
	КонецЕсли;
	
	ВыпискаОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

Процедура ОбработатьДеревоВариантов(ДеревоВыполнения, ПараметрыВызоваФункции, ИсполняющийДокумент, Объект, Задание, ДанныеНовыхКонтрагентов)
	
	Для каждого ТекВариантВыполнения Из ДеревоВыполнения.Строки Цикл
	
		Если ЗначениеЗаполнено(ИсполняющийДокумент) Тогда
			Возврат;
		КонецЕсли;
		
		Если ТекВариантВыполнения.Вариант = "Действие" Тогда
			ИсполняющийДокумент = ВыполнитьТекущееДействие(ТекВариантВыполнения.Действие, ПараметрыВызоваФункции, Объект, Задание, ДанныеНовыхКонтрагентов);
		ИначеЕсли ТекВариантВыполнения.Вариант = "Вариант" Тогда
			УсловиеВыполнено = ПроверитьВыполнениеУсловияВыполнения(ТекВариантВыполнения.Условие, ПараметрыВызоваФункции);
			ТекВетка = ДеревоВыполнения.Строки[0].Строки.Найти(Строка(УсловиеВыполнено), "Вариант", Ложь); 
			ОбработатьДеревоВариантов(ТекВетка, ПараметрыВызоваФункции, ИсполняющийДокумент, Объект, Задание, ДанныеНовыхКонтрагентов);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Функция ВыполнитьТекущееДействие(Знач Действие, Параметры, Объект, Задание, ДанныеНовыхКонтрагентов)
	Действие = ВРег(Действие);
	Если Действие = "ОПРЕДЕЛИТЬПЛАТЕЖНОЕПОРУЧЕНИЕ" Тогда
		Возврат БиблиотекаФункцийОбмена.ОпределитьПлатежноеПоручение(Объект.ЛицевойСчет.Код, Объект.Организация, Параметры);
	ИначеЕсли Действие = "СОЗДАТЬПП" Тогда
		Возврат БиблиотекаФункцийОбмена.СоздатьПП(Параметры, Объект);
	ИначеЕсли Действие = "СОЗДАТЬПЛАТЕЖНОЕТРЕБОВАНИЕ" Тогда
		Возврат БиблиотекаФункцийОбмена.СоздатьПлатежноеТребование(Параметры, Объект);
	ИначеЕсли Действие = "КАССОВОЕПОСТУПЛЕНИЕПОПП" Тогда
		Возврат БиблиотекаФункцийОбмена.КассовоеПоступлениеПоПП(Параметры, Объект, Истина, Истина, Задание.ВидОбмена, ДанныеНовыхКонтрагентов);
	ИначеЕсли Действие = "КАССОВОЕВЫБЫТИЕПОПП" Тогда
		Возврат БиблиотекаФункцийОбмена.КассовоеВыбытиеПоПП(Параметры, Объект, Истина, Задание.ВидОбмена, ДанныеНовыхКонтрагентов);
	КонецЕсли;
	Возврат Неопределено;		
КонецФункции

Функция ПроверитьВыполнениеУсловияВыполнения(Условие, Параметры)
	ВидыСравнений = Новый Массив;
	ВидыСравнений.Добавить("=");
	ВидыСравнений.Добавить("<>");
	ВидыСравнений.Добавить(">");
	ВидыСравнений.Добавить("<");
	
	Результат = Ложь;
	
	Для каждого ТекВидСравнения Из ВидыСравнений Цикл
	
		Поз = Найти(Условие, ТекВидСравнения);
		Если Поз>0 Тогда
			ЛеваяСтрона = СокрЛП(Лев(Условие, Поз-1));
			ПраваяСторона = СокрЛП(Сред(Условие, Поз+СтрДлина(ТекВидСравнения)));
			
			Если ВРЕГ(Лев(ЛеваяСтрона, 22)) = "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ." Тогда
				ЗначениеПараметра = Неопределено;
				Параметры.Свойство(Сред(ЛеваяСтрона,23), ЗначениеПараметра);
			Иначе
				ЗначениеПараметра = ЛеваяСтрона;
			КонецЕсли;
			Если ВРЕГ(Лев(ПраваяСторона, 22)) = "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ." Тогда
				ЗначениеСравнения = Неопределено;
				Параметры.Свойство(Сред(ПраваяСторона,23), ЗначениеСравнения);
			Иначе
				ЗначениеСравнения = ПраваяСторона;
			КонецЕсли;
			
			Если ТипЗнч(ЗначениеПараметра) = Тип("Строка") Тогда
				Если Лев(ПраваяСторона,1) = Строка("""") Тогда
					ЗначениеСравнения = Сред(ПраваяСторона, 2, СтрДлина(ПраваяСторона)-2);
				Иначе
					ЗначениеСравнения = ПраваяСторона;
				КонецЕсли;
			ИначеЕсли ТипЗнч(ЗначениеПараметра) = Тип("Число") Тогда
				ЗначениеСравнения = Число(ПраваяСторона);
			КонецЕсли;
			Если ТекВидСравнения = "=" Тогда
				Результат = ЗначениеПараметра = ЗначениеСравнения;
			ИначеЕсли ТекВидСравнения = "<>" Тогда
				Результат = ЗначениеПараметра <> ЗначениеСравнения;
			ИначеЕсли ТекВидСравнения = ">" Тогда
				Результат = ЗначениеПараметра > ЗначениеСравнения;
			ИначеЕсли ТекВидСравнения = "<" Тогда
				Результат = ЗначениеПараметра < ЗначениеСравнения;
			КонецЕсли;
			Прервать;
		КонецЕсли;
	
	КонецЦикла;
	
	Если Результат Тогда
		Возврат "Истина";
	Иначе
		Возврат "Ложь";
	КонецЕсли;
	
КонецФункции

Функция СоздатьДеревоВыполнения(Знач ФункцияЗаполнения)
	ДеревоДействий = Новый ДеревоЗначений;
	ДеревоДействий.Колонки.Добавить("Условие", Новый ОписаниеТипов("Строка"));
	ДеревоДействий.Колонки.Добавить("Действие", Новый ОписаниеТипов("Строка"));
	ДеревоДействий.Колонки.Добавить("Вариант", Новый ОписаниеТипов("Строка"));
	ДеревоДействий.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	
	СоздатьВетвьВарианта(ФункцияЗаполнения, ДеревоДействий);
	
	ДеревоРезультат = Новый ДеревоЗначений;
	ДеревоРезультат.Колонки.Добавить("Условие", Новый ОписаниеТипов("Строка"));
	ДеревоРезультат.Колонки.Добавить("Действие", Новый ОписаниеТипов("Строка"));
	ДеревоРезультат.Колонки.Добавить("Вариант", Новый ОписаниеТипов("Строка"));
	ДеревоРезультат.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	
	СобратьДеревоВариантов(ФункцияЗаполнения, ДеревоДействий, ДеревоРезультат);
	
	Возврат ДеревоРезультат;
	
КонецФункции

Процедура СобратьДеревоВариантов(Формула, ДеревоДействий, ДеревоРезультат)
	ЧастиФормулы = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Формула, ";", Истина);	
	Для каждого ЧастьФормулы Из ЧастиФормулы Цикл
		
		ЧастьФормулы = СокрЛП(ЧастьФормулы);
		ТекДействие = ДеревоРезультат.Строки.Добавить();
		Если Лев(ЧастьФормулы, 1) = "[" Тогда
			НомерВарианта = Сред(ЧастьФормулы, 9, СтрДлина(ЧастьФормулы)-9);
			Вариант = ДеревоДействий.Строки.НайтиСтроки(Новый Структура("Вариант, Номер", "Вариант", НомерВарианта), Истина)[0];
			ЗаполнитьЗначенияСвойств(ТекДействие, Вариант, "Вариант, Условие");
			
			ВеткаИстина = ТекДействие.Строки.Добавить();
			ВеткаИстина.Вариант = "Истина";
			ВариантИстина = Вариант.Строки.Найти("Истина", "Вариант");
			СобратьДеревоВариантов(ВариантИстина["Действие"], ДеревоДействий, ВеткаИстина);
			
			ВеткаЛожь = ТекДействие.Строки.Добавить();
			ВеткаЛожь.Вариант = "Ложь";
			ВариантЛожь = Вариант.Строки.Найти("Ложь", "Вариант");
			СобратьДеревоВариантов(ВариантЛожь["Действие"], ДеревоДействий, ВеткаЛожь);
		Иначе 
			ТекДействие.Вариант = "Действие";
			ТекДействие.Действие = ЧастьФормулы;
		КонецЕсли;
	
	КонецЦикла; 
	
КонецПроцедуры

Процедура СоздатьВетвьВарианта(Формула, Корень, Номер = 1)
	Если Найти(Формула, "?")=0 Тогда
		Возврат;
	КонецЕсли;
	
	ВременнаяСтрока = Формула;
	Позиция = 0;
	Поз = Найти(ВременнаяСтрока, "?");
	Пока Поз>0 Цикл
		Позиция = Позиция + Поз;
		ВременнаяСтрока = Сред(ВременнаяСтрока, Поз+1);
		Поз = Найти(ВременнаяСтрока, "?");
	КонецЦикла;
	ПозицияК = Позиция + Найти(ВременнаяСтрока, ")");
	ВременнаяСтрока = Сред(Формула, Позиция+1, ПозицияК - Позиция - 1);
	ВременнаяСтрока = Сред(ВременнаяСтрока, Найти(ВременнаяСтрока, "(")+1);
	СоставФормулы = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВременнаяСтрока, ",", Ложь);
	Пока СоставФормулы.Количество()<3 Цикл
		СоставФормулы.Добавить("");
	КонецЦикла;
	
	НовВыбор = Корень.Строки.Добавить();
	НовВыбор.Номер = Номер;
	НовВыбор.Вариант = "Вариант";
	НовВыбор.Условие = СоставФормулы[0];
	
	ДействиеИстина = НовВыбор.Строки.Добавить();
	ДействиеИстина.Номер = Номер;
	ДействиеИстина.Вариант = "Истина";
	ДействиеИстина.Действие = СоставФормулы[1];	
	
	ДействиеИстина = НовВыбор.Строки.Добавить();
	ДействиеИстина.Номер = Номер;
	ДействиеИстина.Вариант = "Ложь";
	ДействиеИстина.Действие = СоставФормулы[2];	
	
	Формула = Лев(Формула, Позиция-1) + "[Вариант"+Номер+"]" + Сред(Формула, ПозицияК + 1);
	
	СоздатьВетвьВарианта(Формула, Корень, Номер+1);	

КонецПроцедуры
 
Процедура СкопироватьВетвьДерева(Источник, Приемник, ЗначенияРеквизитов = Неопределено)   Экспорт

	Для каждого ТекСтр Из Источник.Строки Цикл
	
		НовСтр = Приемник.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, ТекСтр,,"Родитель, Строки");
		Если ТипЗнч(ЗначенияРеквизитов) = Тип("Структура") Тогда
			// в параметре значенияРеквизитов может быть структура для заполнения значений создаваемой ветви
			ЗаполнитьЗначенияСвойств(НовСтр, ЗначенияРеквизитов);
		КонецЕсли;
		СкопироватьВетвьДерева(ТекСтр, НовСтр, ЗначенияРеквизитов);
	
	КонецЦикла; 

КонецПроцедуры

Процедура ЗаполнитьИменаПолейДереваСтруктуры(ДеревоСтруктуры, ТаблицаДанных, СчетчикКолонок)   Экспорт
	Для каждого ТекСтрока Из ДеревоСтруктуры.Строки Цикл
		Если ТекСтрока.Строки.Количество() = 0  Тогда
			ТекСтрока.ИмяПоляТаблицы = "Поле"+СчетчикКолонок;
			ТаблицаДанных.Колонки.Добавить("Поле"+СчетчикКолонок,Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(1000)));
			СчетчикКолонок = СчетчикКолонок+1;
		КонецЕсли;
		Если ПустаяСтрока(ТекСтрока.ПолноеИмяПоля) Тогда
			Если ТекСтрока.Родитель<>Неопределено Тогда
				ТекСтрока.ПолноеИмяПоля = ТекСтрока.Родитель.ПолноеИмяПоля+"/"+ТекСтрока.ИмяПоля;
			Иначе
				ТекСтрока.ПолноеИмяПоля = "/"+ТекСтрока.ИмяПоля;
			КонецЕсли;
		КонецЕсли;
		ЗаполнитьИменаПолейДереваСтруктуры(ТекСтрока, ТаблицаДанных, СчетчикКолонок);
	КонецЦикла; 
КонецПроцедуры

Процедура ОбозначитьЛистьяДерева(Ветвь)  Экспорт  
	
	Лист = Истина;
	Для каждого ТекСтрока Из Ветвь.Строки Цикл
		Если ТекСтрока.Строки.Количество()>0 Тогда
			Лист = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если Не Лист Тогда
		Для каждого ТекСтрока Из Ветвь.Строки Цикл
			ТекСтрока.КонечныйЭлемент = Ложь;
			ОбозначитьЛистьяДерева(ТекСтрока);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьСтруктуруСхемыКомпоновкиИзДерева(ДеревоСтруктуры, Группировка, СхемаКомпоновкиРезультата, НаборДанных, РазрешенныеМодули, СоответствиеГруппировок) Экспорт
	
	Для каждого СтрокаДерева Из ДеревоСтруктуры.Строки Цикл
		
		Если ПустаяСтрока(СтрокаДерева.ИмяПоляТаблицы) Тогда	
			//ГруппировкаСхемы = Группировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
			//ГруппировкаСхемы.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			ГруппировкаСхемы          = СоответствиеГруппировок[СтрокаДерева.Группировка];
			
			Если ГруппировкаСхемы     = Неопределено Тогда
				СоответствиеГруппировок.Вставить(СтрокаДерева.Группировка, Группировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных")));
				ГруппировкаСхемы      = СоответствиеГруппировок[СтрокаДерева.Группировка];
				ГруппировкаСхемы.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
			КонецЕсли;
			
			СоздатьСтруктуруСхемыКомпоновкиИзДерева(СтрокаДерева, ГруппировкаСхемы, СхемаКомпоновкиРезультата, НаборДанных, РазрешенныеМодули, СоответствиеГруппировок);
			
		Иначе
			
			НовПоле                   = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			НовПоле.Поле 		      = СтрокаДерева.ИмяПоляТаблицы;
			НовПоле.ПутьКДанным	      = СтрокаДерева.ИмяПоляТаблицы;
			НовПоле.Роль.Обязательное = Истина;
			
			ГруппировкаСхемы          = СоответствиеГруппировок[СтрокаДерева.Группировка];
			
			Если ГруппировкаСхемы     = Неопределено Тогда
				
				СоответствиеГруппировок.Вставить(СтрокаДерева.Группировка, Группировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных")));
				ГруппировкаСхемы      = СоответствиеГруппировок[СтрокаДерева.Группировка];
				ГруппировкаСхемы.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
				
			КонецЕсли;
			
			ЗаменяемыеЗначения        = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВРЕГ("Значение"));
			ЗаменяющиеЗначения        = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаДерева.ИмяПоляТаблицы);
			
			РазложениеПолей           = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаДерева.ПолеОбъекта, ";");			
			// для каждого поля объекта сделаем вычисляемое поле
			Для Каждого ТекПолеОбъекта Из РазложениеПолей Цикл
				
				Если ЗначениеЗаполнено(ТекПолеОбъекта) Тогда
					
					ПутьКДаннымВычисляемогоПоля      = ТекПолеОбъекта;
					
					Если Не ПустаяСтрока(СтрокаДерева.ТабличнаяЧасть) Тогда
						ПутьКДаннымВычисляемогоПоля  = СтрокаДерева.ТабличнаяЧасть + "." + ПутьКДаннымВычисляемогоПоля;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(СтрокаДерева.Условие) Тогда
						ВыражениеВычисляемогоПоля 	 = 	""""+СтрЗаменить(СтрокаДерева.Условие,"""","""""")+"""";
					Иначе
						ВыражениеВычисляемогоПоля 	 = ОбщийМодульСКД.ПреобразоватьВыражениеСКД(СтрокаДерева.ПорядокЗаполнения, РазрешенныеМодули, ЗаменяемыеЗначения, ЗаменяющиеЗначения);
					КонецЕсли;
					
					ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновкиРезультата, ПутьКДаннымВычисляемогоПоля, ВыражениеВычисляемогоПоля);
					
					ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(ГруппировкаСхемы, ПутьКДаннымВычисляемогоПоля);
					
					Если Не ПустаяСтрока(СтрокаДерева.ДопДействия) Тогда
						// разберем доп.действия. в них могут быть заданы явно поля объекта
						
						Действия                                    = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаДерева.ДопДействия, ";", Истина);
						Для каждого Действие Из Действия Цикл
						
							ЧастиДействия = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СокрЛП(Действие), "=", Истина);
							
							Если ЧастиДействия.Количество()         = 2 Тогда
								
								ЧастиЛевойСтороны                   = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ЧастиДействия[0], ".", Истина);
								
								Если ЧастиЛевойСтороны.Количество() = 2 И ВРЕГ(ЧастиЛевойСтороны[0]) = "СТРОКА" Тогда
									
									ПутьКДаннымВычисляемогоПоля     = СокрЛП(ЧастиЛевойСтороны[1]);	
									
									Если Не ПустаяСтрока(СтрокаДерева.ТабличнаяЧасть) Тогда
										ПутьКДаннымВычисляемогоПоля = СтрокаДерева.ТабличнаяЧасть + "." + ПутьКДаннымВычисляемогоПоля;
									КонецЕсли;
									
									ВыражениеВычисляемогоПоля       = ЧастиДействия[1];	
									ВыражениеВычисляемогоПоля       = СтрЗаменить(ВыражениеВычисляемогоПоля, "Значение", СтрокаДерева.ИмяПоляТаблицы);
									
									ОбщийМодульСКД.ПроверитьПолучениеПредопределенныхЭлементов(ВыражениеВычисляемогоПоля);
								    ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновкиРезультата, СокрЛП(ПутьКДаннымВычисляемогоПоля), ВыражениеВычисляемогоПоля);
									ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(ГруппировкаСхемы, ПутьКДаннымВычисляемогоПоля);
									
								Иначе
									
									ПутьКДаннымВычисляемогоПоля     = СокрЛП(ЧастиДействия[0]);
									
									Если Не ПустаяСтрока(СтрокаДерева.ТабличнаяЧасть) Тогда
										ПутьКДаннымВычисляемогоПоля  = СтрокаДерева.ТабличнаяЧасть + "." + ПутьКДаннымВычисляемогоПоля;
									КонецЕсли;
								
									ВыражениеВычисляемогоПоля       = ЧастиДействия[1];
									ВыражениеВычисляемогоПоля       = СтрЗаменить(ВыражениеВычисляемогоПоля, "Значение", СтрокаДерева.ИмяПоляТаблицы);
									
									ВыражениеВычисляемогоПоля 	    = ОбщийМодульСКД.ПреобразоватьВыражениеСКД(ВыражениеВычисляемогоПоля, РазрешенныеМодули, ЗаменяемыеЗначения, ЗаменяющиеЗначения);

									
									ОбщийМодульСКД.ПроверитьПолучениеПредопределенныхЭлементов(ВыражениеВычисляемогоПоля);
								    ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновкиРезультата, СокрЛП(ПутьКДаннымВычисляемогоПоля), ВыражениеВычисляемогоПоля);
									ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(ГруппировкаСхемы, ПутьКДаннымВычисляемогоПоля);
									
								КонецЕсли;
								
								
							КонецЕсли;
							
						КонецЦикла; 
						
					КонецЕсли;
					
					//ДобавитьИмяРеквизитаВСтруктуру(ТекПолеОбъекта, ИменаРеквизитов);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбозначитьГруппировкиВДереве(Дерево)  Экспорт
	Для каждого СтрокаДерева Из Дерево.Строки Цикл
		
		Если ЗначениеЗаполнено(СтрокаДерева.Группировка) Тогда
			УстановитьГруппировкуВетви(СтрокаДерева, СтрокаДерева.Группировка);
		КонецЕсли;
	    ОбозначитьГруппировкиВДереве(СтрокаДерева)
	КонецЦикла; 
КонецПроцедуры

Процедура УстановитьГруппировкуВетви(Ветвь, Группировка)
	Если Ветвь = Неопределено ИЛИ Ветвь.Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ТекСтрока Из Ветвь.Родитель.Строки Цикл
		Если ПустаяСтрока(ТекСтрока.Группировка) Тогда
			ТекСтрока.Группировка = Группировка;
		КонецЕсли;
		УстановитьГруппировкуВетви(ТекСтрока.Родитель, Группировка);
	КонецЦикла;
КонецПроцедуры

Процедура СократитьДерево(ДеревоСтруктуры, СокращенноеДеревоСтруктуры, СоответствиеГруппировок) Экспорт

	Для каждого СтрокаСтруктуры Из ДеревоСтруктуры.Строки Цикл
		
		Если ТипЗнч(СокращенноеДеревоСтруктуры) = Тип("СтрокаДереваЗначений") И СтрокаСтруктуры.Группировка = СокращенноеДеревоСтруктуры.Группировка Тогда
			
			СократитьДерево(СтрокаСтруктуры, СокращенноеДеревоСтруктуры, СоответствиеГруппировок);
			
		Иначе	
			
			ТекСтрока                 = СокращенноеДеревоСтруктуры.Строки.Найти(СтрокаСтруктуры.Группировка, "Группировка");
			
			Если ТекСтрока            = Неопределено Тогда
				
				ТекСтрока             = СокращенноеДеревоСтруктуры.Строки.Добавить();
				ТекСтрока.Группировка = СтрокаСтруктуры.Группировка;
				ОписаниеГруппировки   = СоответствиеГруппировок[СтрокаСтруктуры.Группировка];
				
				Если ОписаниеГруппировки <> Неопределено Тогда
					
					Для каждого ПолеГруппировки Из ОписаниеГруппировки.ПоляГруппировки.Элементы Цикл
						ТекСтрока.Поля.Добавить(Строка(ПолеГруппировки.Поле));
					КонецЦикла; 
					
				КонецЕсли;
				
			КонецЕсли;
			
			СократитьДерево(СтрокаСтруктуры, ТекСтрока, СоответствиеГруппировок);
			
		КонецЕсли;
		
	КонецЦикла; 

КонецПроцедуры

Процедура ЗагрузитьИзФайлаXML_AZK(ТекстФайла, Формат, Задание, ИмяФайла, ДанныеНовыхКонтрагентов)
	
	ПравилаЗагрузки = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(Формат);
	
	СоответствиеКолонок                                   = Новый Соответствие;
	ДеревоСтруктуры                                       = Новый ДеревоЗначений;
	
	ДеревоСтруктуры.Колонки.Добавить("ИмяПоля",				Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПолноеИмяПоля",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ИмяПоляТаблицы",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПорядокЗаполнения", 	Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПолеОбъекта",			Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ТабличнаяЧасть",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ДопДействия",			Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("Условие",				Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("КонечныйЭлемент", 	Новый ОписаниеТипов("Булево"));
	ДеревоСтруктуры.Колонки.Добавить("Группировка",			Новый ОписаниеТипов("Строка"));
	
	Для каждого ТекПравило Из ПравилаЗагрузки Цикл
		// если поле объекта не задано, то мы не учитываем узел
		Если ЗначениеЗаполнено(ТекПравило.ПолеОбъекта) Тогда
			
			КоллекцияСтрокДерева = ДеревоСтруктуры.Строки;
			ЧастиИмени           = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекПравило.ПолеФайлаПередачи, "/");
			МаксИндекс           = ЧастиИмени.ВГраница();
			
			Для Индекс           = 0 По МаксИндекс Цикл
				ЧастьИмени       = ЧастиИмени[Индекс];
				
				Если ПустаяСтрока(ЧастьИмени) Тогда
					Продолжить;
				КонецЕсли;
				
				ТекСтрокаДерева                     = КоллекцияСтрокДерева.Найти(ЧастьИмени, "ИмяПоля");
				
				Если ТекСтрокаДерева = Неопределено Тогда
					
					ТекСтрокаДерева                 = КоллекцияСтрокДерева.Добавить();
					ТекСтрокаДерева.ИмяПоля         = ЧастьИмени;
					
					Если ЗначениеЗаполнено(ТекПравило.ТабличнаяЧасть) Тогда
						ТекСтрокаДерева.Группировка = ТекПравило.ТабличнаяЧасть;
					ИначеЕсли ЗначениеЗаполнено(ТекПравило.ПолеОбъекта) И Найти(ТекПравило.ПолеОбъекта, ".") = 0 Тогда
						ТекСтрокаДерева.Группировка = "Объект";
					КонецЕсли;
					
					Если Индекс = МаксИндекс Тогда
						
						ТекСтрокаДерева.ПолноеИмяПоля 		= ВРег(ТекПравило.ПолеФайлаПередачи);
						ТекСтрокаДерева.ПолеОбъекта 		= ТекПравило.ПолеОбъекта;
						ТекСтрокаДерева.ПорядокЗаполнения	= ТекПравило.ПорядокЗаполнения;
						ТекСтрокаДерева.ТабличнаяЧасть 		= ТекПравило.ТабличнаяЧасть;
						ТекСтрокаДерева.ДопДействия 		= ТекПравило.ДопДействия;
						ТекСтрокаДерева.Условие		 		= ТекПравило.Условие;
						ТекСтрокаДерева.КонечныйЭлемент		= Истина;
						
					КонецЕсли;
					
				КонецЕсли;
				
				КоллекцияСтрокДерева = ТекСтрокаДерева.Строки;
				
			КонецЦикла; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбозначитьЛистьяДерева(ДеревоСтруктуры);
	ОбозначитьГруппировкиВДереве(ДеревоСтруктуры);
		
	// для каждого поля зададим имя поля таблицы и сразу создадим структуру таблицы
	ТаблицаДанных                = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("КонечныйЭлемент");
	СчетчикКолонок               = 1;
	ЗаполнитьИменаПолейДереваСтруктуры(ДеревоСтруктуры, ТаблицаДанных, СчетчикКолонок);
	
	ЧтениеXML 			         = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);

	ПутьПравилаОбработки         = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		// Обработка узла XML           	
		Если ЧтениеXML.ТипУзла   = ТипУзлаXML.НачалоЭлемента Тогда
			ИмяПоля              = ЧтениеXML.Имя;		
			ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ВРег(ИмяПоля);
			
			ТекСтрока            = ДеревоСтруктуры.Строки.Найти(ПутьПравилаОбработки, "ПолноеИмяПоля",Истина);
			Если ТекСтрока<>Неопределено Тогда
				СтрокаДанных     = ТаблицаДанных.Добавить();
				
				Для каждого ПоляСтроки Из ТекСтрока.Строки Цикл
					СтрокаДанных.КонечныйЭлемент        = ПоляСтроки.КонечныйЭлемент;
					Если ПоляСтроки.Строки.Количество() = 0 Тогда					
						Если Лев(ПоляСтроки.ИмяПоля, 1) = "@" Тогда
							// добавитьСтроку
							ЗначениеПоля = ""; 
							
							Если ЧтениеXML.ПолучитьАтрибут(Сред(ПоляСтроки.ИмяПоля, 2))<> Неопределено Тогда
								ЗначениеПоля = ЧтениеXML.ПолучитьАтрибут(Сред(ПоляСтроки.ИмяПоля, 2))
							ИначеЕсли ЧтениеXML.ПолучитьАтрибут(Сред(НРег(ПоляСтроки.ИмяПоля), 2))<> Неопределено Тогда
	                            ЗначениеПоля = ЧтениеXML.ПолучитьАтрибут(Сред(НРег(ПоляСтроки.ИмяПоля), 2))
							КонецЕсли;	
							
							СтрокаДанных[ПоляСтроки.ИмяПоляТаблицы] = ЗначениеПоля;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла; 
			КонецЕсли;
		ИначеЕсли ЧтениеXML.ТипУзла  = ТипУзлаXML.КонецЭлемента Тогда 			
			ПутьПравилаОбработки     = Лев(ПутьПравилаОбработки, СтрДлина(ПутьПравилаОбработки) - (СтрДлина(ЧтениеXML.Имя)+1));
		КонецЕсли;
		
	КонецЦикла;
	
	МассивИменСтрок                  = Новый Массив;
	МассивИменСтрок.Добавить("/EXTRWT/WTFORMAT/DOCAZKREQUESTS/DOCAZKREQUEST/@DOCUMENTNUMBER");
	
	МассивИменПолейТД                = Новый Массив;
	
	Для Каждого ЭлМас Из МассивИменСтрок Цикл
		ТекСтрока                    = ДеревоСтруктуры.Строки.Найти(ЭлМас, "ПолноеИмяПоля",Истина);
		Если ТекСтрока <> Неопределено Тогда
			МассивИменПолейТД.Добавить(ТекСтрока.ИмяПоляТаблицы);	
		КонецЕсли;
	КонецЦикла;
	
	// заполним колонки конечных элементов значениями из вышестоящих неконечных элементов
	СвернутьТаблицуЗначений(ТаблицаДанных, МассивИменПолейТД);
	
	// создание схемы компоновки данных
	СхемаКомпоновкиРезультата         = Новый СхемаКомпоновкиДанных;
	ИсточникДанных                    = СхемаКомпоновкиРезультата.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя                = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных                       = СхемаКомпоновкиРезультата.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя 			      = "НаборДанных1";
	НаборДанных.ИмяОбъекта 		      = "ВходящиеДанные";
	НаборДанных.ИсточникДанных 	      = "ИсточникДанных1";
	
	РазрешенныеМодули                 = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("БИБЛИОТЕКАФУНКЦИЙОБМЕНА");
	СоответствиеГруппировок           = Новый Соответствие;
	СоздатьСтруктуруСхемыКомпоновкиИзДерева(ДеревоСтруктуры, СхемаКомпоновкиРезультата.НастройкиПоУмолчанию, СхемаКомпоновкиРезультата, НаборДанных, РазрешенныеМодули, СоответствиеГруппировок);	
	
	ВнешниеНаборы                     = Новый Структура("ВходящиеДанные", ТаблицаДанных);
	ФорматЗагрузки                    = Формат;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "КассовыйОрган";
	Параметр.Значение                 = Задание.КассовыйОрган;
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "Организация";
	Параметр.Значение                 = Задание.Организация;
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "ВалютаРеглУчета";
	Параметр.Значение                 = Константы.ВалютаРегламентированногоУчета.Получить();
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	НастройкиКомпоновки               = СхемаКомпоновкиРезультата.НастройкиПоУмолчанию;
	
	КомпоновщикМакета                 = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки                   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиРезультата, НастройкиКомпоновки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); 
	ПроцессорКомпоновки               = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы,,Истина);
	ПроцессорВывода                   = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	РезультатВыполнения               = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	СокращенноеДеревоСтруктуры        = Новый ДеревоЗначений;
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Группировка", Новый ОписаниеТипов("Строка"));
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Поля", Новый ОписаниеТипов("Массив"));
	
	СократитьДерево(ДеревоСтруктуры, СокращенноеДеревоСтруктуры, СоответствиеГруппировок); 
	
	Для каждого СтрокаДокумента Из РезультатВыполнения.Строки Цикл
		
		СтрокаГруппировки             = СокращенноеДеревоСтруктуры.Строки[0];
		
		// выделяем объект для импорта
		Попытка
			СохраненныйДокумент       = Документы[Формат.ИдентификаторОбъекта.Имя].НайтиПоНомеру(СтрокаДокумента.Номер, СтрокаДокумента.Дата);
		Исключение
			СохраненныйДокумент       = Документы[Формат.ИдентификаторОбъекта.Имя].ПустаяСсылка();
		КонецПопытки;

		Если СохраненныйДокумент.Пустая() Тогда
			ДокументОбъект            = Документы[Формат.ИдентификаторОбъекта.Имя].СоздатьДокумент();
		Иначе
			ДокументОбъект            = СохраненныйДокумент.ПолучитьОбъект();
			Если БиблиотекаФункцийОбмена.ПолучитьСтатусДокумента(ДокументОбъект.Ссылка) <> Перечисления.СтатусыИсполненияДокумента.ВРаботе Тогда
				ВызватьИсключение НСтр("ru='Документ с таким же номером был обработан ранее (его статус отличен от статуса <<в работе>>) '") + СохраненныйДокумент;
			КонецЕсли;	
			Попытка
				ЗаблокироватьДанныеДляРедактирования(ДокументОбъект.Ссылка);
			Исключение
				ВызватьИсключение НСтр("ru='Невозможно заблокировать для редактирования документ '") + СохраненныйДокумент;
			КонецПопытки;
			ДокументОбъект.РеквизитыДокументаОснования.Очистить();
			ДокументОбъект.РасшифровкаПлатежа.Очистить();
		КонецЕсли;
		
		// запись реквизитов шапки документа
		СтрокаРеквизитов              = "";
		СтрокаРеквизитовПП            = "";
		
		ПроизвольныеПараметры         = Новый Структура;
		
		ПроизвольныеПараметры.Вставить("МесяцОплаты",    "");
        ПроизвольныеПараметры.Вставить("ГодОплаты",      "");	
		
		Для каждого ТекПоле Из СтрокаГруппировки.Поля Цикл
			Если Найти(ВРЕГ(ТекПоле), "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ") = 0 Тогда
				СтрокаРеквизитов    = СтрокаРеквизитов   + "," + ТекПоле;
			Иначе
				СтрокаРеквизитовПП  = СтрокаРеквизитовПП + "," + ТекПоле;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаРеквизитов            = Сред(СтрокаРеквизитов, 2);
		СтрокаРеквизитовПП          = Сред(СтрокаРеквизитовПП, 2);
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаДокумента, СтрокаРеквизитов);
		ЗаполнитьЗначенияСвойств(ДокументОбъект, Задание, "Организация");
		
		СтруктураПроверки           = Новый Структура(СтрЗаменить(СтрокаРеквизитовПП, ".", ""));
						
		ЗаполнитьЗначенияСвойств(СтруктураПроверки, СтрокаДокумента);
		
		Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
			Если ВРЕГ(Лев(ЗначениеПроверки.Ключ, 21)) = "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ" Тогда
				ПроизвольныеПараметры.Вставить(Сред(ЗначениеПроверки.Ключ, 22), ЗначениеПроверки.Значение);
			КонецЕсли;
		КонецЦикла; 

		
		// обработка реквизитов табличных частей
		Для каждого ВложеннаяГруппировка Из СтрокаГруппировки.Строки Цикл
			
			СтрокаРеквизитов          = "";
			СтрокаРеквизитовПП        = "";
			
			Для каждого ТекПоле Из ВложеннаяГруппировка.Поля Цикл
				
				Если Найти(ВРЕГ(ТекПоле), "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ") = 0 Тогда
				
					Если Лев(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 1) = ВложеннаяГруппировка.Группировка + "." Тогда
						СтрокаРеквизитов  = СтрокаРеквизитов + "," + Сред(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 2);	
					Иначе
						СтрокаРеквизитов  = СтрокаРеквизитов + "," + ТекПоле;
					КонецЕсли;
					
				Иначе
					
					СтрокаРеквизитовПП  = СтрокаРеквизитовПП + "," + ТекПоле;
					
				КонецЕсли;
				
			КонецЦикла;
			
			СтрокаРеквизитов          = Сред(СтрокаРеквизитов, 2);
			СтрокаРеквизитовПП        = Сред(СтрокаРеквизитовПП, 2);
			КБКНазначения             = "";  
			
			ПараметрыВызоваФункции    = Новый Структура;
						
			ПараметрыВызоваФункции.Вставить("ИННПлательщика", "");
			ПараметрыВызоваФункции.Вставить("КПППлательщика", "");	
				
			// в СтрокаРеквизитов только имена табличной части
			
			Для каждого ВложеннаяСтрока Из СтрокаДокумента.Строки Цикл
				
								
				Если ВложеннаяГруппировка.Группировка  =  "РасшифровкаПлатежа" Тогда
					
					ФункцияЗаполнения                                 = ВложеннаяСтрока["РасшифровкаПлатежаКБКНазначениеПлатежа"];
					
					Если ФункцияЗаполнения                            = "НайтиКБКПоНаименованию" Тогда
						
						ПараметрыВызоваФункции.Вставить("ППП",            "");
						ПараметрыВызоваФункции.Вставить("КФСР",           "");
						ПараметрыВызоваФункции.Вставить("КЦСР",           "");
						ПараметрыВызоваФункции.Вставить("КВР",            "");
						ПараметрыВызоваФункции.Вставить("КИФ",            "");
						ПараметрыВызоваФункции.Вставить("КД",             "");
						ПараметрыВызоваФункции.Вставить("АУБУ",           Ложь);
						ПараметрыВызоваФункции.Вставить("ИННПлательщика", "");
						ПараметрыВызоваФункции.Вставить("КПППлательщика", "");
						
						СтруктураПроверки                             = Новый Структура(СтрЗаменить(СтрокаРеквизитовПП, ".", ""));
						
						ЗаполнитьЗначенияСвойств(СтруктураПроверки, ВложеннаяСтрока);
						
						Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
							Если ВРЕГ(Лев(ЗначениеПроверки.Ключ, 39)) = "РАСШИФРОВКАПЛАТЕЖАПРОИЗВОЛЬНЫЕПАРАМЕТРЫ" Тогда
								ПараметрыВызоваФункции.Вставить(Сред(ЗначениеПроверки.Ключ, 40), ЗначениеПроверки.Значение);
							КонецЕсли;
						КонецЦикла; 
						
						Если ЗначениеЗаполнено(ПараметрыВызоваФункции.КИФ) Тогда
							
							КБКНазначения                                 = БиблиотекаФункцийОбмена.НайтиКБКПоНаименованию(Строка(ПараметрыВызоваФункции.КИФ), Перечисления.ВидыКБК.КИФ, Ложь, , , ДокументОбъект.Дата); 					
							
						Иначе
							
							Если ПараметрыВызоваФункции.АУБУ Тогда  //для заявок АУ/БУ
								
								Если ЗначениеЗаполнено(ПараметрыВызоваФункции.КД) И ПараметрыВызоваФункции.КД <> "000"  Тогда
									КодБК                                     = Строка(ПараметрыВызоваФункции.ППП)  + Строка(ПараметрыВызоваФункции.КФСР)  + 
								                                                Строка(ПараметрыВызоваФункции.КЦСР) + Строка(ПараметрыВызоваФункции.КД); 
									ВидБК									  = Перечисления.ВидыКБК.КДБ;		
								Иначе
									КодБК                                     = Строка(ПараметрыВызоваФункции.ППП)  + Строка(ПараметрыВызоваФункции.КФСР)  + 
								                                                Строка(ПараметрыВызоваФункции.КЦСР) + Строка(ПараметрыВызоваФункции.КВР);
									ВидБК									  = Перечисления.ВидыКБК.КРБ;											
								КонецЕсли;
								
								КБКНазначения                                 = БиблиотекаФункцийОбмена.НайтиКБКПоНаименованию(Прав(КодБК, 17), ВидБК, Ложь, Истина, , ДокументОбъект.Дата);
							
							Иначе
								КодБК                                         = Строка(ПараметрыВызоваФункции.ППП)  + Строка(ПараметрыВызоваФункции.КФСР)  + 
								                                                Строка(ПараметрыВызоваФункции.КЦСР) + Строка(ПараметрыВызоваФункции.КВР); 
																				
								КБКНазначения                                 = БиблиотекаФункцийОбмена.НайтиКБКПоНаименованию(Прав(КодБК, 17), Перечисления.ВидыКБК.КРБ, Ложь, , , ДокументОбъект.Дата);
							КонецЕсли;
							
						КонецЕсли;
											
					КонецЕсли;	
				КонецЕсли;

				ЕстьЗаполненные       = Ложь;
				СтруктураПроверки     = Новый Структура(СтрокаРеквизитов);
				
				Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
					СтруктураПроверки[ЗначениеПроверки.Ключ]          = ВложеннаяСтрока[ВложеннаяГруппировка.Группировка+ЗначениеПроверки.Ключ];	
					ЕстьЗаполненные                                   = Макс(ЕстьЗаполненные, ЗначениеЗаполнено(СтруктураПроверки[ЗначениеПроверки.Ключ]));
				КонецЦикла;
				
				Если ЕстьЗаполненные Тогда
					ЗаполнитьЗначенияСвойств(ДокументОбъект[ВложеннаяГруппировка.Группировка].Добавить(), СтруктураПроверки);
					
					Если ВложеннаяГруппировка.Группировка  =  "РасшифровкаПлатежа" Тогда
						 ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].КБКНазначениеПлатежа = КБКНазначения;
						 ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].Сумма                = ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].СуммаВал; 
						 
						 Если ЗначениеЗаполнено(ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].КФО) Тогда
						 
						 	СписокИсточников = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(ДокументОбъект.ЛицевойСчет, ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].КФО);
	
							Если СписокИсточников.Количество() > 0 Тогда
								 ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].ИсточникСредств = СписокИсточников[0];
							КонецЕсли; 
							 
						 КонецЕсли;	
									 
						 Если ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].Сумма = 0 Тогда
							  ДокументОбъект.РасшифровкаПлатежа.Удалить(ДокументОбъект.РасшифровкаПлатежа.Количество() - 1)
						 КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла; 
				
		КонецЦикла; 
		
		ДокументОбъект.СуммаДокументаВВалюте = ДокументОбъект.РасшифровкаПлатежа.Итог("СуммаВал");
		ДокументОбъект.СуммаДокумента        = ДокументОбъект.РасшифровкаПлатежа.Итог("Сумма");
		
		ДокументОбъект.Контрагент            = БиблиотекаФункцийОбмена.ОпределитьКонтрагента(ДокументОбъект.КонтрагентИНН, ДокументОбъект.КонтрагентКПП, ДокументОбъект.КонтрагентНаименование, , , ВидОбмена, ДанныеНовыхКонтрагентов);
		
		Если ЗначениеЗаполнено(ДокументОбъект.ИнойПлательщикИНН) ИЛИ ЗначениеЗаполнено(ДокументОбъект.ИнойПлательщикКПП) ИЛИ ЗначениеЗаполнено(ДокументОбъект.ИнойПлательщиеНаименование) Тогда  
			 ДокументОбъект.ИнойПлательщик   = БиблиотекаФункцийОбмена.ОпределитьКонтрагента(ДокументОбъект.ИнойПлательщикИНН, ДокументОбъект.ИнойПлательщикКПП, ДокументОбъект.ИнойПлательщиеНаименование, , , ВидОбмена, ДанныеНовыхКонтрагентов);
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Контрагент) И ТипЗнч(ДанныеНовыхКонтрагентов) = Тип("ТаблицаЗначений") Тогда
			Если ДанныеНовыхКонтрагентов.Количество() > 0 И НЕ ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
				 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ДокументСсылка     = ДокументОбъект.Ссылка;
				 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ИмяРеквизита       = "Контрагент";	 
			КонецЕсли;
		КонецЕсли;
		
		ДокументОбъект.ИННПлательщика        = ?(ЗначениеЗаполнено(ПараметрыВызоваФункции.ИННПлательщика), ПараметрыВызоваФункции.ИННПлательщика, ДокументОбъект.ИННПлательщика);
		ДокументОбъект.КПППлательщика        = ?(ЗначениеЗаполнено(ПараметрыВызоваФункции.КПППлательщика), ПараметрыВызоваФункции.КПППлательщика, ДокументОбъект.КПППлательщика);
		
		ДокументОбъект.ПериодОплатыЖКХ       = БиблиотекаФункцийОбмена.ПреобразованиеСтрокиВДату( "01." + Формат(ПроизвольныеПараметры.МесяцОплаты,  "ЧЦ=2; ЧВН=") + "." + Формат(ПроизвольныеПараметры.ГодОплаты,  "ЧЦ=4; ЧВН="));
		
		Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
			
			ДокументОбъект.СчетКонтрагента  = БиблиотекаФункцийОбмена.ОпределитьСчетКонтрагента(ДокументОбъект.Контрагент, ДокументОбъект.КонтрагентЛицевойСчет, 
			                                  ДокументОбъект.КонтрагентБИКБанка, ДокументОбъект.КонтрагентНаименованиеБанка, ДокументОбъект.КонтрагентКорСчетБанка);
											  
            МенеджерПечати                  = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Документ." + Формат.ИдентификаторОбъекта.Имя);											  
											  
			МенеджерПечати.ЗаполнитьРеквизитыПолучателя(ДокументОбъект);
								  
		КонецЕсли;		
		
		Если ДокументОбъект.Ссылка.Пустая() ИЛИ ДокументОбъект.Модифицированность() Тогда					
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);	
		КонецЕсли;			
		
		Если Задание.ОбъектыОбмена.Найти(ДокументОбъект.Ссылка) = Неопределено Тогда    
			
			НовСтрокаЗадания                    = Задание.ОбъектыОбмена.Добавить();
			НовСтрокаЗадания.ИмяФайлаЗагрузки	= ИмяФайла;
			НовСтрокаЗадания.Формат				= Формат;
			НовСтрокаЗадания.Объект				= ДокументОбъект.Ссылка;  
			
		КонецЕсли;
		//-------------------------------------
		
    КонецЦикла;

КонецПроцедуры 

Процедура ЗагрузитьИзФайлаXML_RMS(ТекстФайла, Формат, Задание, ИмяФайла, ДанныеНовыхКонтрагентов)
	
	ПравилаЗагрузки = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(Формат);
	
	СоответствиеКолонок                                   = Новый Соответствие;
	ДеревоСтруктуры                                       = Новый ДеревоЗначений;
	
	ДеревоСтруктуры.Колонки.Добавить("ИмяПоля",				Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПолноеИмяПоля",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ИмяПоляТаблицы",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПорядокЗаполнения", 	Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПолеОбъекта",			Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ТабличнаяЧасть",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ДопДействия",			Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("Условие",				Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("КонечныйЭлемент", 	Новый ОписаниеТипов("Булево"));
	ДеревоСтруктуры.Колонки.Добавить("Группировка",			Новый ОписаниеТипов("Строка"));     
	
	НомерСтрокиОсновногоФайла                            = Задание.ФайлыОбмена.НайтиСтроки(Новый Структура("ИмяФайлаЗагрузки", ИмяФайла))[0].НомерСтроки;
	
	Для каждого ТекПравило Из ПравилаЗагрузки Цикл
		// если поле объекта не задано, то мы не учитываем узел
		Если ЗначениеЗаполнено(ТекПравило.ПолеОбъекта) Тогда
			
			КоллекцияСтрокДерева = ДеревоСтруктуры.Строки;
			ЧастиИмени           = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекПравило.ПолеФайлаПередачи, "/");
			МаксИндекс           = ЧастиИмени.ВГраница();
			
			Для Индекс           = 0 По МаксИндекс Цикл
				ЧастьИмени       = ЧастиИмени[Индекс];
				
				Если ПустаяСтрока(ЧастьИмени) Тогда
					Продолжить;
				КонецЕсли;
				
				ТекСтрокаДерева                     = КоллекцияСтрокДерева.Найти(ЧастьИмени, "ИмяПоля");
				
				Если ТекСтрокаДерева = Неопределено Тогда
					
					ТекСтрокаДерева                 = КоллекцияСтрокДерева.Добавить();
					ТекСтрокаДерева.ИмяПоля         = ЧастьИмени;
					
					Если ЗначениеЗаполнено(ТекПравило.ТабличнаяЧасть) Тогда
						ТекСтрокаДерева.Группировка = ТекПравило.ТабличнаяЧасть;
					ИначеЕсли ЗначениеЗаполнено(ТекПравило.ПолеОбъекта) И Найти(ТекПравило.ПолеОбъекта, ".") = 0 Тогда
						ТекСтрокаДерева.Группировка = "Объект";
					КонецЕсли;
					
					Если Индекс = МаксИндекс Тогда
						
						ТекСтрокаДерева.ПолноеИмяПоля 		= ВРег(ТекПравило.ПолеФайлаПередачи);
						ТекСтрокаДерева.ПолеОбъекта 		= ТекПравило.ПолеОбъекта;
						ТекСтрокаДерева.ПорядокЗаполнения	= ТекПравило.ПорядокЗаполнения;
						ТекСтрокаДерева.ТабличнаяЧасть 		= ТекПравило.ТабличнаяЧасть;
						ТекСтрокаДерева.ДопДействия 		= ТекПравило.ДопДействия;
						ТекСтрокаДерева.Условие		 		= ТекПравило.Условие;
						ТекСтрокаДерева.КонечныйЭлемент		= Истина;
						
					КонецЕсли;
					
				КонецЕсли;
				
				КоллекцияСтрокДерева = ТекСтрокаДерева.Строки;
				
			КонецЦикла; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбозначитьЛистьяДерева(ДеревоСтруктуры);
	ОбозначитьГруппировкиВДереве(ДеревоСтруктуры);
		
	// для каждого поля зададим имя поля таблицы и сразу создадим структуру таблицы
	ТаблицаДанных                = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("КонечныйЭлемент");
	СчетчикКолонок               = 1;
	ЗаполнитьИменаПолейДереваСтруктуры(ДеревоСтруктуры, ТаблицаДанных, СчетчикКолонок);
			
	ЧтениеXML 			         = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM    = ПостроительDOM.Прочитать(ЧтениеXML);

	ПутьПравилаОбработки         = "";
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	
	СписокКонечныхЭлементов       = Новый СписокЗначений;
	СписокКонечныхЭлементов.Добавить("bscDcmnts");
	
	СоответствиеИндексов          = Новый Соответствие;
	
	Пока ЧтениеXML.Прочитать() Цикл
		// Обработка узла XML           	
		Если ЧтениеXML.ТипУзла   = ТипУзлаXML.НачалоЭлемента Тогда
			
			ИмяПоля              = ЧтениеXML.ЛокальноеИмя;	
			ИмяПоляDOM           = ЧтениеXML.ЛокальноеИмя;
			ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ИмяПоля;
			
			ТекСтрока            = ДеревоСтруктуры.Строки.Найти(ПутьПравилаОбработки, "ПолноеИмяПоля",Истина);
			Если ТекСтрока <> Неопределено Тогда
				
				//Индекс = ПолучитьИндекс(ИмяПоля, СоответствиеИндексов);
				
				Если (ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[0].ДочерниеУзлы.Количество()> 0) 
				//	 И (СписокКонечныхЭлементов.НайтиПоЗначению(ИмяПоля) <> Неопределено) 
					 И (ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[0].ДочерниеУзлы[0].ИмяУзла) <> "#text" Тогда
					СтрокаДанных     = ТаблицаДанных.Добавить();
				КонецЕсли;
				
				РодительскийУзел     = "";
				
				Для каждого ПоляСтроки Из ТекСтрока.Строки Цикл
					
					СтрокаДанных.КонечныйЭлемент = Ложь; //(ПоляСтроки.КонечныйЭлемент); 
					
					Если ПоляСтроки.ИмяПоля = "baseDocId" ИЛИ ПоляСтроки.ИмяПоля = "paymentPurpose" Тогда
						СтрокаДанных.КонечныйЭлемент = Истина;	
					КонецЕсли;	
					
					Если ПоляСтроки.Строки.Количество() = 0 Тогда					
						Если Лев(ПоляСтроки.ИмяПоля, 1) = "@" Тогда
							// добавитьСтроку
							СтрокаДанных[ПоляСтроки.ИмяПоляТаблицы] = ЧтениеXML.ПолучитьАтрибут(Сред(ПоляСтроки.ИмяПоля, 2));
						Иначе
							Индекс                                  = ПолучитьИндекс(ПоляСтроки.ИмяПоля, СоответствиеИндексов);
														
							Если ДокументDOM.ПолучитьЭлементыПоИмени(ПоляСтроки.ИмяПоля).Количество() > Индекс Тогда
								
								Если РодительскийУзел = "" Тогда
								
								   РодительскийУзел = ДокументDOM.ПолучитьЭлементыПоИмени(ПоляСтроки.ИмяПоля)[Индекс].РодительскийУзел;
								  
							    ИначеЕсли ДокументDOM.ПолучитьЭлементыПоИмени(ПоляСтроки.ИмяПоля)[Индекс].РодительскийУзел <> РодительскийУзел Тогда
									 //Узлы не одного уровня
									 ДекрементироватьИндекс(ПоляСтроки.ИмяПоля, СоответствиеИндексов);
									 //так как ранее инкрементировался вызовом
									 Продолжить;
								КонецЕсли;	
								
								СтрокаДанных[ПоляСтроки.ИмяПоляТаблицы] = ДокументDOM.ПолучитьЭлементыПоИмени(ПоляСтроки.ИмяПоля)[Индекс].ТекстовоеСодержимое;
							Иначе
								СтрокаДанных[ПоляСтроки.ИмяПоляТаблицы] = "";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла; 
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла  = ТипУзлаXML.КонецЭлемента Тогда 			
			ПутьПравилаОбработки     = Лев(ПутьПравилаОбработки, СтрДлина(ПутьПравилаОбработки) - (СтрДлина(ЧтениеXML.Имя)+1));
		КонецЕсли;
		
	КонецЦикла;	  
	
	СтруктураКлючей                  = Новый Структура;
			
	МассивИменСтрок                  = Новый Массив;
	МассивИменСтрок.Добавить("/GENERALDATAVOS/COUNT/RSKPVOS/RSKPN/RSKPN/RSKPDATE");
	
	МассивИменПолейТД                = Новый Массив;
	
	Для Каждого ЭлМас Из МассивИменСтрок Цикл
		ТекСтрока                    = ДеревоСтруктуры.Строки.Найти(ЭлМас, "ПолноеИмяПоля",Истина);
		Если ТекСтрока <> Неопределено Тогда
			МассивИменПолейТД.Добавить(ТекСтрока.ИмяПоляТаблицы);	
		КонецЕсли;
	КонецЦикла;  
	
	ТаблицаДанных.Сортировать("КонечныйЭлемент");
	
	// заполним колонки конечных элементов значениями из вышестоящих неконечных элементов
	СвернутьТаблицуЗначений(ТаблицаДанных, МассивИменПолейТД);
	
	// создание схемы компоновки данных
	СхемаКомпоновкиРезультата         = Новый СхемаКомпоновкиДанных;
	ИсточникДанных                    = СхемаКомпоновкиРезультата.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя                = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных                       = СхемаКомпоновкиРезультата.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя 			      = "НаборДанных1";
	НаборДанных.ИмяОбъекта 		      = "ВходящиеДанные";
	НаборДанных.ИсточникДанных 	      = "ИсточникДанных1";
	
	РазрешенныеМодули                 = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("БИБЛИОТЕКАФУНКЦИЙОБМЕНА");
	СоответствиеГруппировок           = Новый Соответствие;
	СоздатьСтруктуруСхемыКомпоновкиИзДерева(ДеревоСтруктуры, СхемаКомпоновкиРезультата.НастройкиПоУмолчанию, СхемаКомпоновкиРезультата, НаборДанных, РазрешенныеМодули, СоответствиеГруппировок);	
	
	ВнешниеНаборы                     = Новый Структура("ВходящиеДанные", ТаблицаДанных);
	ФорматЗагрузки                    = Формат;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "КассовыйОрган";
	Параметр.Значение                 = Задание.КассовыйОрган;
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "Организация";
	Параметр.Значение                 = Задание.Организация;
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;   
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "ДатаФормирования";
	Параметр.Значение                 = Задание.Дата;
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "ВалютаРеглУчета";
	Параметр.Значение                 = Константы.ВалютаРегламентированногоУчета.Получить();
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	НастройкиКомпоновки               = СхемаКомпоновкиРезультата.НастройкиПоУмолчанию;
	
	КомпоновщикМакета                 = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки                   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиРезультата, НастройкиКомпоновки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); 
	ПроцессорКомпоновки               = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы,,Истина);
	ПроцессорВывода                   = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	РезультатВыполнения               = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	СокращенноеДеревоСтруктуры        = Новый ДеревоЗначений;
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Группировка", Новый ОписаниеТипов("Строка"));
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Поля", Новый ОписаниеТипов("Массив"));
	
	СократитьДерево(ДеревоСтруктуры, СокращенноеДеревоСтруктуры, СоответствиеГруппировок); 
	
	Для каждого СтрокаДокумента Из РезультатВыполнения.Строки Цикл
		
		СтрокаГруппировки             = СокращенноеДеревоСтруктуры.Строки[0];
	
	    СтрокаДокумента               = РезультатВыполнения.Строки[0];
		// выделяем объект для импорта
		Попытка
			СохраненныйДокумент       = Документы[Формат.ИдентификаторОбъекта.Имя].НайтиПоРеквизиту("GUID", СтрокаДокумента.GUID);
		Исключение
			СохраненныйДокумент       = Документы[Формат.ИдентификаторОбъекта.Имя].ПустаяСсылка();
		КонецПопытки;

		Если СохраненныйДокумент.Пустая() Тогда
			ДокументОбъект            = Документы[Формат.ИдентификаторОбъекта.Имя].СоздатьДокумент();
		Иначе
			
			Если Задание.ВидОбмена.ОтменаПовторнойЗагрузкиПроведенныхДокументов И СохраненныйДокумент.Проведен Тогда 
				
				Если Задание.ОбъектыОбмена.Найти(СохраненныйДокумент) = Неопределено Тогда    
			
					НовСтрокаЗадания                    = Задание.ОбъектыОбмена.Добавить();
					НовСтрокаЗадания.ИмяФайлаЗагрузки	= ИмяФайла;
					НовСтрокаЗадания.Формат				= Формат;
					НовСтрокаЗадания.Объект				= СохраненныйДокумент;  
					
				КонецЕсли; 
				
				Сообщение    = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НСтр("ru='В файле [ИмяФайла] есть ссылка на документ [Документ], загруженный ранее и проведенный. Он останется без изменений.'"),
																									Новый Структура("Документ, ИмяФайла", 
																													СохраненныйДокумент, 
																													ИмяФайла));
				ОбщегоНазначения.СообщитьПользователю(Сообщение,,"ФайлыОбмена["+НомерСтрокиОсновногоФайла+"].ИмяФайлаЗагрузки");


				Продолжить;
			КонецЕсли;
			
			ДокументОбъект            = СохраненныйДокумент.ПолучитьОбъект(); 
						
			Если БиблиотекаФункцийОбмена.ПолучитьСтатусДокумента(ДокументОбъект.Ссылка) <> Перечисления.СтатусыИсполненияДокумента.ВРаботе Тогда
				ВызватьИсключение СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НСтр("ru='Документ [Документ] с таким же GUID [GUID] был обработан ранее (его статус отличен от статуса <<в работе>>)'"), 
				                                                                                    Новый Структура("Документ, GUID", 
																													СохраненныйДокумент, 
																													СтрокаДокумента.GUID));   
			КонецЕсли;	
			Попытка
				ЗаблокироватьДанныеДляРедактирования(ДокументОбъект.Ссылка);
			Исключение
				ВызватьИсключение НСтр("ru='Невозможно заблокировать для редактирования документ '") + СохраненныйДокумент;
			КонецПопытки;     
			
			Если Метаданные.Документы[Формат.ИдентификаторОбъекта.Имя].ТабличныеЧасти.Найти("ДокументыОснования") <> Неопределено Тогда
				ДокументОбъект.ДокументыОснования.Очистить();
			КонецЕсли;	
			
			Если Метаданные.Документы[Формат.ИдентификаторОбъекта.Имя].ТабличныеЧасти.Найти("РеквизитыПлатежногоДокумента") <> Неопределено Тогда
				ДокументОбъект.РеквизитыПлатежногоДокумента.Очистить();
			КонецЕсли;	

			Если Метаданные.Документы[Формат.ИдентификаторОбъекта.Имя].ТабличныеЧасти.Найти("ИзмененныеРеквизиты") <> Неопределено Тогда
				ДокументОбъект.ИзмененныеРеквизиты.Очистить();
			КонецЕсли;	
			
		КонецЕсли;
		
		// запись реквизитов шапки документа
		СтрокаРеквизитов              = "";
		СтрокаРеквизитовПП            = "";
		
		ПроизвольныеПараметры         = Новый Структура;
		
		ПроизвольныеПараметры.Вставить("МесяцОплаты",    "");
        ПроизвольныеПараметры.Вставить("ГодОплаты",      "");	
		
		Для каждого ТекПоле Из СтрокаГруппировки.Поля Цикл
			Если Найти(ВРЕГ(ТекПоле), "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ") = 0 Тогда
				СтрокаРеквизитов    = СтрокаРеквизитов   + "," + ТекПоле;
			Иначе
				СтрокаРеквизитовПП  = СтрокаРеквизитовПП + "," + ТекПоле;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаРеквизитов            = Сред(СтрокаРеквизитов, 2);
		СтрокаРеквизитовПП          = Сред(СтрокаРеквизитовПП, 2);
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаДокумента, СтрокаРеквизитов);
		ЗаполнитьЗначенияСвойств(ДокументОбъект, Задание, "Организация");
		
		СтруктураПроверки           = Новый Структура(СтрЗаменить(СтрокаРеквизитовПП, ".", ""));
						
		ЗаполнитьЗначенияСвойств(СтруктураПроверки, СтрокаДокумента);
		
		Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
			Если ВРЕГ(Лев(ЗначениеПроверки.Ключ, 21)) = "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ" Тогда
				ПроизвольныеПараметры.Вставить(Сред(ЗначениеПроверки.Ключ, 22), ЗначениеПроверки.Значение);
			КонецЕсли;
		КонецЦикла; 

		
		// обработка реквизитов табличных частей
		Для каждого ВложеннаяГруппировка Из СтрокаГруппировки.Строки Цикл
			
			СтрокаРеквизитов          = "";
			СтрокаРеквизитовПП        = "";
			
			Для каждого ТекПоле Из ВложеннаяГруппировка.Поля Цикл
				
				Если Найти(ВРЕГ(ТекПоле), "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ") = 0 Тогда
				
					Если Лев(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 1) = ВложеннаяГруппировка.Группировка + "." Тогда
						СтрокаРеквизитов  = СтрокаРеквизитов + "," + Сред(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 2);	
					Иначе
						СтрокаРеквизитов  = СтрокаРеквизитов + "," + ТекПоле;
					КонецЕсли;
					
				Иначе
					
					СтрокаРеквизитовПП  = СтрокаРеквизитовПП + "," + ТекПоле;
					
				КонецЕсли;
				
			КонецЦикла;
			
			СтрокаРеквизитов          = Сред(СтрокаРеквизитов, 2);
			СтрокаРеквизитовПП        = Сред(СтрокаРеквизитовПП, 2);
			КБКНазначения             = "";  
			
			ПараметрыВызоваФункции    = Новый Структура;
						
			ПараметрыВызоваФункции.Вставить("ИННПлательщика", "");
			ПараметрыВызоваФункции.Вставить("КПППлательщика", "");	
				
			// в СтрокаРеквизитов только имена табличной части
			
			Для каждого ВложеннаяСтрока Из СтрокаДокумента.Строки Цикл
				
								
				ЕстьЗаполненные       = Ложь;
				СтруктураПроверки     = Новый Структура(СтрокаРеквизитов);
				
				Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
					СтруктураПроверки[ЗначениеПроверки.Ключ]          = ВложеннаяСтрока[ВложеннаяГруппировка.Группировка+ЗначениеПроверки.Ключ];	
					ЕстьЗаполненные                                   = Макс(ЕстьЗаполненные, ЗначениеЗаполнено(СтруктураПроверки[ЗначениеПроверки.Ключ]));
				КонецЦикла;
				
				Если ЕстьЗаполненные Тогда   
					
					Если ВложеннаяГруппировка.Группировка  =  "ДокументыОснования" И (СтрокаДокумента.Строки.Количество() = 1) Тогда
						
						ЗаполнитьЗначенияСвойств(ДокументОбъект, СтруктураПроверки);   
						
					ИначеЕсли ВложеннаяГруппировка.Группировка  =  "РеквизитыПлатежногоДокумента" Тогда  
						
						ЗаполнитьЗначенияСвойств(ДокументОбъект[ВложеннаяГруппировка.Группировка].Добавить(), СтруктураПроверки); 
						ДокументОбъект[ВложеннаяГруппировка.Группировка][ДокументОбъект[ВложеннаяГруппировка.Группировка].Количество()-1].КлючСтроки = Новый УникальныйИдентификатор;   
						
						СтруктураКлючей.Вставить("_" + СтруктураПроверки["НомерСтроки"], ДокументОбъект[ВложеннаяГруппировка.Группировка][ДокументОбъект[ВложеннаяГруппировка.Группировка].Количество()-1].КлючСтроки);
						
					ИначеЕсли ВложеннаяГруппировка.Группировка  =  "ИзмененныеРеквизиты" Тогда 
						
						ЗаполнитьЗначенияСвойств(ДокументОбъект[ВложеннаяГруппировка.Группировка].Добавить(), СтруктураПроверки); 
						
						Если ЗначениеЗаполнено(СтруктураПроверки.НомерСтроки) И СтруктураПроверки.НомерСтроки <= ДокументОбъект.РеквизитыПлатежногоДокумента.Количество() Тогда 
							ДокументОбъект[ВложеннаяГруппировка.Группировка][ДокументОбъект[ВложеннаяГруппировка.Группировка].Количество()-1].КлючСтроки = СтруктураКлючей["_" + СтруктураПроверки["НомерСтроки"]]; 
						КонецЕсли;	
						
					Иначе
						
						ЗаполнитьЗначенияСвойств(ДокументОбъект[ВложеннаяГруппировка.Группировка].Добавить(), СтруктураПроверки);	
						
					КонецЕсли;	
																			
				КонецЕсли;
				
			КонецЦикла; 
				
		КонецЦикла; 
				
		Если Метаданные.Документы[Формат.ИдентификаторОбъекта.Имя].Реквизиты.Найти("КонтрагентИНН") <> Неопределено Тогда
		
			ДокументОбъект.Контрагент            = БиблиотекаФункцийОбмена.ОпределитьКонтрагента(ДокументОбъект.КонтрагентИНН, ДокументОбъект.КонтрагентКПП, ДокументОбъект.КонтрагентНаименование, , , ВидОбмена, ДанныеНовыхКонтрагентов);
			
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Контрагент) И ТипЗнч(ДанныеНовыхКонтрагентов) = Тип("ТаблицаЗначений") Тогда
				Если ДанныеНовыхКонтрагентов.Количество() > 0 И НЕ ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
					 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ДокументСсылка     = ДокументОбъект.Ссылка;
					 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ИмяРеквизита       = "Контрагент";	 
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
			
			ДокументОбъект.СчетКонтрагента  = БиблиотекаФункцийОбмена.ОпределитьСчетКонтрагента(ДокументОбъект.Контрагент, ?(ЗначениеЗаполнено(ДокументОбъект.КонтрагентЛицевойСчет), ДокументОбъект.КонтрагентЛицевойСчет, ДокументОбъект.КонтрагентБанковскийСчет), 
			                                  ДокументОбъект.КонтрагентБИКБанка, ДокументОбъект.КонтрагентНаименованиеБанка, ДокументОбъект.КонтрагентКорСчетБанка);
											  								  
		КонецЕсли;		
		
		Если ДокументОбъект.Ссылка.Пустая() ИЛИ ДокументОбъект.Модифицированность() Тогда					
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);	
		КонецЕсли;			
		
		Если Задание.ОбъектыОбмена.Найти(ДокументОбъект.Ссылка) = Неопределено Тогда    
			
			НовСтрокаЗадания                    = Задание.ОбъектыОбмена.Добавить();
			НовСтрокаЗадания.ИмяФайлаЗагрузки	= ИмяФайла;
			НовСтрокаЗадания.Формат				= Формат;
			НовСтрокаЗадания.Объект				= ДокументОбъект.Ссылка;  
			
		КонецЕсли;
		//-------------------------------------
		
    КонецЦикла;

КонецПроцедуры 

Функция ПолучитьИндекс(ИмяПоля, СоответствиеИндексов) Экспорт
	
    Индекс = СоответствиеИндексов.Получить(ИмяПоля);
	
	Если Индекс = Неопределено Тогда
		 Индекс = 0;
	КонецЕсли;  
	 
	СоответствиеИндексов.Вставить(ИмяПоля, Индекс + 1); 
		
	Возврат Индекс;
	
КонецФункции  

Процедура ДекрементироватьИндекс(ИмяПоля, СоответствиеИндексов) Экспорт
	
    Индекс = СоответствиеИндексов.Получить(ИмяПоля);
	
	Если Индекс = Неопределено Тогда
		 Индекс = 0;
	КонецЕсли;
	
	СоответствиеИндексов.Вставить(ИмяПоля, ?(Индекс > 0, Индекс - 1, 0));
		
КонецПроцедуры


Процедура ЗагрузитьИзФайлаXML_TXL(ТекстФайла, Формат, Задание, ИмяФайла, ДанныеНовыхКонтрагентов, СтруктураВыписки)
	
	Перем СостояниеПлатежноРасчетныхДокументов;	
	
	СписокСтрокПП = Новый ТаблицаЗначений; 
	СписокСтрокПП.Колонки.Добавить("НомерСтр");
	СписокСтрокПП.Колонки.Добавить("КБК"); 
	СписокСтрокПП.Колонки.Добавить("ТипКБК"); 
	СписокСтрокПП.Колонки.Добавить("КодЦели"); 
	СписокСтрокПП.Колонки.Добавить("НомерБО"); 
	СписокСтрокПП.Колонки.Добавить("ОКАТО"); 
	СписокСтрокПП.Колонки.Добавить("Сумма"); 
	СписокСтрокПП.Колонки.Добавить("ЭтоСписание");
	СписокСтрокПП.Колонки.Добавить("Операция");
	СписокСтрокПП.Колонки.Добавить("Дебет");
    СписокСтрокПП.Колонки.Добавить("Кредит");     
	СписокСтрокПП.Колонки.Добавить("Примечание");  
	СписокСтрокПП.Колонки.Добавить("ИНН");     
	СписокСтрокПП.Колонки.Добавить("КПП");
    СписокСтрокПП.Колонки.Добавить("Наименование"); 
	СписокСтрокПП.Колонки.Добавить("ФИО");
	
	СостояниеПлатежноРасчетныхДокументов = Новый Структура;
	
	НомерСтрокиОсновногоФайла            = Задание.ФайлыОбмена.НайтиСтроки(Новый Структура("ИмяФайлаЗагрузки", ИмяФайла))[0].НомерСтроки;
	
	СоответствиеКолонок                  = Новый Соответствие; 
	ДеревоСтруктуры                      = СоотвествиеФорматовРабочимСтруктурам.Получить(Формат.Наименование);
	
	Если ДеревоСтруктуры = Неопределено Тогда
				
		ПравилаЗагрузки                                       = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(Формат);	
		ДеревоСтруктуры                                       = Новый ДеревоЗначений;
		
		ДеревоСтруктуры.Колонки.Добавить("ИмяПоля",				Новый ОписаниеТипов("Строка"));
		ДеревоСтруктуры.Колонки.Добавить("ПолноеИмяПоля",		Новый ОписаниеТипов("Строка"));
		ДеревоСтруктуры.Колонки.Добавить("ИмяПоляТаблицы",		Новый ОписаниеТипов("Строка"));
		ДеревоСтруктуры.Колонки.Добавить("ПорядокЗаполнения", 	Новый ОписаниеТипов("Строка"));
		ДеревоСтруктуры.Колонки.Добавить("ПолеОбъекта",			Новый ОписаниеТипов("Строка"));
		ДеревоСтруктуры.Колонки.Добавить("ТабличнаяЧасть",		Новый ОписаниеТипов("Строка"));
		ДеревоСтруктуры.Колонки.Добавить("ДопДействия",			Новый ОписаниеТипов("Строка"));
		ДеревоСтруктуры.Колонки.Добавить("Условие",				Новый ОписаниеТипов("Строка"));
		ДеревоСтруктуры.Колонки.Добавить("КонечныйЭлемент", 	Новый ОписаниеТипов("Булево"));
		ДеревоСтруктуры.Колонки.Добавить("Группировка",			Новый ОписаниеТипов("Строка"));
		
		ОписаниеОбъектаОшибки = Новый ТаблицаЗначений;
		ОписаниеОбъектаОшибки.Колонки.Добавить("ПолеФайла", , "Поле файла передачи");
		ОписаниеОбъектаОшибки.Колонки.Добавить("Ошибка",    , "Ошибка заполнения поля файла передачи");
		
		Для каждого ТекПравило Из ПравилаЗагрузки Цикл
			// если поле объекта не задано, то мы не учитываем узел
			Если ЗначениеЗаполнено(ТекПравило.ПолеОбъекта) Тогда
				
				КоллекцияСтрокДерева = ДеревоСтруктуры.Строки;
				ЧастиИмени           = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекПравило.ПолеФайлаПередачи, "/");
				МаксИндекс           = ЧастиИмени.ВГраница();
				
				Для Индекс           = 0 По МаксИндекс Цикл
					ЧастьИмени       = ЧастиИмени[Индекс];
					
					Если ПустаяСтрока(ЧастьИмени) Тогда
						Продолжить;
					КонецЕсли;
					
					ТекСтрокаДерева                     = КоллекцияСтрокДерева.Найти(ЧастьИмени, "ИмяПоля");
					
					Если ТекСтрокаДерева = Неопределено Тогда
						
						ТекСтрокаДерева                 = КоллекцияСтрокДерева.Добавить();
						ТекСтрокаДерева.ИмяПоля         = ЧастьИмени;
						
						Если ЗначениеЗаполнено(ТекПравило.ТабличнаяЧасть) Тогда
							ТекСтрокаДерева.Группировка = ТекПравило.ТабличнаяЧасть;
						ИначеЕсли ЗначениеЗаполнено(ТекПравило.ПолеОбъекта) И Найти(ТекПравило.ПолеОбъекта, ".") = 0 Тогда
							ТекСтрокаДерева.Группировка = "Объект";
						КонецЕсли;
						
						Если Индекс = МаксИндекс Тогда
							
							ТекСтрокаДерева.ПолноеИмяПоля 		= ТекПравило.ПолеФайлаПередачи;
							ТекСтрокаДерева.ПолеОбъекта 		= ТекПравило.ПолеОбъекта;
							ТекСтрокаДерева.ПорядокЗаполнения	= ТекПравило.ПорядокЗаполнения;
							ТекСтрокаДерева.ТабличнаяЧасть 		= ТекПравило.ТабличнаяЧасть;
							ТекСтрокаДерева.ДопДействия 		= ТекПравило.ДопДействия;
							ТекСтрокаДерева.Условие		 		= ТекПравило.Условие;
							ТекСтрокаДерева.КонечныйЭлемент		= Истина;
							
						КонецЕсли;
						
					КонецЕсли;
					
					КоллекцияСтрокДерева = ТекСтрокаДерева.Строки;
					
				КонецЦикла; 
				
			КонецЕсли;
			
		КонецЦикла;
		
		ОбозначитьЛистьяДерева(ДеревоСтруктуры);
		ОбозначитьГруппировкиВДереве(ДеревоСтруктуры);  
		
		СоотвествиеФорматовРабочимСтруктурам.Вставить(Формат.Наименование, ДеревоСтруктуры);
		
	КонецЕсли;	
		
	// для каждого поля зададим имя поля таблицы и сразу создадим структуру таблицы
	ТаблицаДанных                = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("КонечныйЭлемент");
	СчетчикКолонок               = 1;
	ЗаполнитьИменаПолейДереваСтруктуры(ДеревоСтруктуры, ТаблицаДанных, СчетчикКолонок);
	
	ЧтениеXML 			         = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM    = ПостроительDOM.Прочитать(ЧтениеXML);

	ПутьПравилаОбработки         = "";
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	СоответствиеИндексов          = Новый Соответствие;
	
	Пока ЧтениеXML.Прочитать() Цикл
		// Обработка узла XML           	
		Если ЧтениеXML.ТипУзла   = ТипУзлаXML.НачалоЭлемента Тогда
			
			ИмяПоля              = ЧтениеXML.ЛокальноеИмя;	
			ИмяПоляDOM           = ЧтениеXML.ЛокальноеИмя;
			ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ИмяПоля;
			
			ТекСтрока            = ДеревоСтруктуры.Строки.Найти(ПутьПравилаОбработки, "ПолноеИмяПоля",Истина);
			Если ТекСтрока <> Неопределено Тогда
				
				Если (ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[0].ДочерниеУзлы.Количество()> 0) И 
					 (ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[0].ДочерниеУзлы[0].ИмяУзла) <> "#text" Тогда
					СтрокаДанных                 = ТаблицаДанных.Добавить(); 
					СтрокаДанных.КонечныйЭлемент = Ложь;
				КонецЕсли;
				
				РодительскийУзел     = "";  
				
				Индекс                                  = ПолучитьИндекс(ИмяПоля, СоответствиеИндексов);
				Если ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля).Количество() > Индекс Тогда 
					
					РодительскийУзел = ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[Индекс];
					
					Для Каждого ДочернийУзел Из ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[Индекс].ДочерниеУзлы Цикл
						
						ОбрабатываемоеПравило = ТекСтрока.Строки.Найти(ДочернийУзел.ИмяУзла, "ИмяПоля"); 
												
						Если ОбрабатываемоеПравило <> Неопределено Тогда   
							
							 Если НЕ ЗначениеЗаполнено(ОбрабатываемоеПравило.ИмяПоляТаблицы) Тогда 
								Продолжить;
							 КонецЕсли;
							 
							 СтрокаДанных.КонечныйЭлемент = ОбрабатываемоеПравило.КонечныйЭлемент;
							 СтрокаДанных[ОбрабатываемоеПравило.ИмяПоляТаблицы] = ДочернийУзел.ТекстовоеСодержимое;
							 
						КонецЕсли;
						
					КонецЦикла;	
						
				КонецЕсли;	
				
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла  = ТипУзлаXML.КонецЭлемента Тогда 			
			ПутьПравилаОбработки     = Лев(ПутьПравилаОбработки, СтрДлина(ПутьПравилаОбработки) - (СтрДлина(ЧтениеXML.Имя)+1));
		КонецЕсли;
		
	КонецЦикла;	
			
	МассивИменСтрок                  = Новый Массив;
	МассивИменСтрок.Добавить("/self:Rep_ADI/BasicInform_DocGuid");
	
	МассивИменПолейТД                = Новый Массив;
	
	Для Каждого ЭлМас Из МассивИменСтрок Цикл
		ТекСтрока                    = ДеревоСтруктуры.Строки.Найти(ЭлМас, "ПолноеИмяПоля",Истина);
		Если ТекСтрока <> Неопределено Тогда
			МассивИменПолейТД.Добавить(ТекСтрока.ИмяПоляТаблицы);	
		КонецЕсли;
	КонецЦикла;
	
	// заполним колонки конечных элементов значениями из вышестоящих неконечных элементов
	СвернутьТаблицуЗначений(ТаблицаДанных, МассивИменПолейТД);
	
	// создание схемы компоновки данных
	СхемаКомпоновкиРезультата         = Новый СхемаКомпоновкиДанных;
	ИсточникДанных                    = СхемаКомпоновкиРезультата.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя                = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных                       = СхемаКомпоновкиРезультата.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя 			      = "НаборДанных1";
	НаборДанных.ИмяОбъекта 		      = "ВходящиеДанные";
	НаборДанных.ИсточникДанных 	      = "ИсточникДанных1";
	
	РазрешенныеМодули                 = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("БИБЛИОТЕКАФУНКЦИЙОБМЕНА");
	СоответствиеГруппировок           = Новый Соответствие;
	СоздатьСтруктуруСхемыКомпоновкиИзДерева(ДеревоСтруктуры, СхемаКомпоновкиРезультата.НастройкиПоУмолчанию, СхемаКомпоновкиРезультата, НаборДанных, РазрешенныеМодули, СоответствиеГруппировок);	
	
	ВнешниеНаборы                     = Новый Структура("ВходящиеДанные", ТаблицаДанных);
	ФорматЗагрузки                    = Формат;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "КассовыйОрган";
	Параметр.Значение                 = Задание.КассовыйОрган;
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "Организация";
	Параметр.Значение                 = Задание.Организация;
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "ВалютаРеглУчета";
	Параметр.Значение                 = Константы.ВалютаРегламентированногоУчета.Получить();
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	НастройкиКомпоновки               = СхемаКомпоновкиРезультата.НастройкиПоУмолчанию;
	
	КомпоновщикМакета                 = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки                   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиРезультата, НастройкиКомпоновки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); 
	ПроцессорКомпоновки               = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы,,Истина);
	ПроцессорВывода                   = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	РезультатВыполнения               = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	СокращенноеДеревоСтруктуры        = Новый ДеревоЗначений;
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Группировка", Новый ОписаниеТипов("Строка"));
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Поля", Новый ОписаниеТипов("Массив"));
	
	СократитьДерево(ДеревоСтруктуры, СокращенноеДеревоСтруктуры, СоответствиеГруппировок); 
	
	ПараметрыВызоваФункции = Новый Структура;
	
	//--------------------------------------------------------------
	//обработка структуры с расчетными документами
	
	Если НЕ ЗначениеЗаполнено(Формат.ИдентификаторОбъекта) Тогда
		
		Для каждого СтрокаДокумента Из РезультатВыполнения.Строки Цикл
			
			СтрокаГруппировки               = СокращенноеДеревоСтруктуры.Строки[0];
			
			РасчетныйДокумент               = СтруктураВыписки[0].СписокПП.Добавить();
			РасчетныйДокумент.ПечатныйОбраз = Новый Структура;
			РасчетныйДокумент.СписокСтрокПП = СписокСтрокПП;
			
			СтрокаРеквизитов                = "";
			СтрокаРеквизитовПО              = "";
								
			Для каждого ТекПоле Из СтрокаГруппировки.Поля Цикл
				Если Найти(ВРЕГ(ТекПоле), "ПЕЧАТНЫЙОБРАЗ") <> 0 Тогда
					СтрокаРеквизитовПО  = СтрокаРеквизитовПО + "," + ТекПоле;					
				Иначе
					СтрокаРеквизитов    = СтрокаРеквизитов   + "," + ТекПоле;
				КонецЕсли;
			КонецЦикла;
			
			СтрокаРеквизитов            = Сред(СтрокаРеквизитов,   2);
			СтрокаРеквизитовПО          = Сред(СтрокаРеквизитовПО, 2);
			
			ЗаполнитьЗначенияСвойств(РасчетныйДокумент, СтрокаДокумента, СтрокаРеквизитов);
			
			СтруктураПроверки           = Новый Структура(СтрЗаменить(СтрокаРеквизитовПО, ".", ""));
					
			ЗаполнитьЗначенияСвойств(СтруктураПроверки, СтрокаДокумента);
			
			Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
				Если ВРЕГ(Лев(ЗначениеПроверки.Ключ, 13)) = "ПЕЧАТНЫЙОБРАЗ" Тогда
					РасчетныйДокумент.ПечатныйОбраз.Вставить(Сред(ЗначениеПроверки.Ключ, 14), ЗначениеПроверки.Значение);
				КонецЕсли;
			КонецЦикла; 
			
			Для каждого ВложеннаяГруппировка Из СтрокаГруппировки.Строки Цикл
				
				СтрокаРеквизитов          = "";   
				СтрокаРеквизитовПО        = "";
								
				Для каждого ТекПоле Из ВложеннаяГруппировка.Поля Цикл
					
					Если Найти(ВРЕГ(ТекПоле), "ПЕЧАТНЫЙОБРАЗ") <> 0 Тогда  
						Если Лев(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 1) = ВложеннаяГруппировка.Группировка + "." Тогда
							СтрокаРеквизитовПО  = СтрокаРеквизитовПО + "," + Сред(ТекПоле, СтрНайти(ТекПоле, ".", НаправлениеПоиска.СКонца)+1);	
						Иначе
							СтрокаРеквизитовПО  = СтрокаРеквизитовПО + "," + ТекПоле;
						КонецЕсли;
					Иначе
						Если Лев(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 1) = ВложеннаяГруппировка.Группировка + "." Тогда
							СтрокаРеквизитов  = СтрокаРеквизитов + "," + Сред(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 2);	
						Иначе
							СтрокаРеквизитов  = СтрокаРеквизитов + "," + ТекПоле;
						КонецЕсли;   
					КонецЕсли;	
																					
				КонецЦикла;
				
				СтрокаРеквизитов          = Сред(СтрокаРеквизитов, 2);  
				СтрокаРеквизитовПО        = Сред(СтрокаРеквизитовПО, 2);
				
				Если Врег(ВложеннаяГруппировка.Группировка)  <>  "СТРОКАПП" Тогда  
					 РасчетныйДокумент.ПечатныйОбраз.Вставить(Строка(ВложеннаяГруппировка.Группировка), Новый Массив); 
				КонецЕсли;	 
		
				Для каждого ВложеннаяСтрока Из СтрокаДокумента.Строки Цикл  
					
					//реквизиты для печатного образа
					
				    ЕстьЗаполненные       = Ложь;
					СтруктураПроверки     = Новый Структура(СтрЗаменить(СтрокаРеквизитовПО, ".", ""));
					
					Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл 
						
						СтруктураПроверки[ЗначениеПроверки.Ключ]          = ?(РезультатВыполнения.Колонки.Найти(ВложеннаяГруппировка.Группировка + "_ПечатныйОбраз_" + ЗначениеПроверки.Ключ) <> Неопределено,
						                                                      ВложеннаяСтрока[ВложеннаяГруппировка.Группировка + "_ПечатныйОбраз_" + ЗначениеПроверки.Ключ],
																			  ВложеннаяСтрока[ВложеннаяГруппировка.Группировка + "ПечатныйОбраз" + ЗначениеПроверки.Ключ]);	
						ЕстьЗаполненные                                   = Макс(ЕстьЗаполненные, ЗначениеЗаполнено(СтруктураПроверки[ЗначениеПроверки.Ключ]));
					КонецЦикла;
					
					Если ЕстьЗаполненные Тогда
						РасчетныйДокумент.ПечатныйОбраз[ВложеннаяГруппировка.Группировка].Добавить(СтруктураПроверки);								
					КонецЕсли; 			
	
				
					Если (Врег(ВложеннаяГруппировка.Группировка)  =  "СТРОКАПП") ИЛИ 
						 (Врег(ВложеннаяГруппировка.Группировка)  =  "РЕКВИЗИТЫПЛАТЕЖНОГОДОКУМЕНТА") Тогда
						
						ЕстьЗаполненные       = Ложь;
						СтруктураПроверки     = Новый Структура(СтрЗаменить(СтрокаРеквизитов, ".", ""));
						
						Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
							СтруктураПроверки[ЗначениеПроверки.Ключ]          = ВложеннаяСтрока[ВложеннаяГруппировка.Группировка + ЗначениеПроверки.Ключ];	
							ЕстьЗаполненные                                   = Макс(ЕстьЗаполненные, ЗначениеЗаполнено(СтруктураПроверки[ЗначениеПроверки.Ключ]));
						КонецЦикла;
						
						Если ЕстьЗаполненные Тогда
							ЗаполнитьЗначенияСвойств(РасчетныйДокумент.СписокСтрокПП.Добавить(), СтруктураПроверки);								
						КонецЕсли; 			
						
					ИначеЕсли (Врег(ВложеннаяГруппировка.Группировка)  =  "ИЗМЕНЕННЫЕРЕКВИЗИТЫ") Тогда
						
						ЕстьЗаполненные       = Ложь;
						СтруктураПроверки     = Новый Структура(СтрЗаменить(СтрокаРеквизитов, ".", ""));
						
						Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
							СтруктураПроверки[ЗначениеПроверки.Ключ]          = ВложеннаяСтрока[ВложеннаяГруппировка.Группировка + ЗначениеПроверки.Ключ];	
							ЕстьЗаполненные                                   = Макс(ЕстьЗаполненные, ЗначениеЗаполнено(СтруктураПроверки[ЗначениеПроверки.Ключ]));
						КонецЦикла;
						
						Если (ЕстьЗаполненные) И ЗначениеЗаполнено(СтруктураПроверки.НомерСтр) Тогда
                        	ЗаполнитьЗначенияСвойств(РасчетныйДокумент.СписокСтрокПП[СтруктураПроверки.НомерСтр - 1], СтруктураПроверки);								
						КонецЕсли; 
						
					КонецЕсли;
					
				КонецЦикла;	

			КонецЦикла;	
				
		КонецЦикла;	
			
		Возврат;
		
	КонецЕсли;
	
	//--------------------------------------------------------------
	
	Для каждого СтрокаДокумента Из РезультатВыполнения.Строки Цикл
		
		Если РезультатВыполнения.Колонки.Найти("ЛицевойСчет") <> Неопределено И НЕ ЗначениеЗаполнено(СтрокаДокумента["ЛицевойСчет"]) Тогда		    
			
			    СтрокаОписания = ОписаниеОбъектаОшибки.Добавить();
				СтрокаОписания.ПолеФайла = НСтр("ru='Не найден лицевой счет'"); 
				СтрокаОписания.Ошибка    = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(	НСтр("ru='Не найден лицевой счет №[ЛицевойСчет], указанный в файле [ИмяФайла]'"),
																									Новый Структура("ЛицевойСчет, ИмяФайла", 
																													СтрокаДокумента["НомерЛицевогоСчетаФайла"], 
																													ИмяФайла));
				ОбщегоНазначения.СообщитьПользователю(СтрокаОписания.Ошибка,,"ФайлыОбмена["+НомерСтрокиОсновногоФайла+"].ИмяФайлаЗагрузки");
				ВставитьОшибкуВДокумент(Задание, ЗначениеВСтрокуВнутр(ОписаниеОбъектаОшибки), НомерСтрокиОсновногоФайла);
				Продолжить;
				
        КонецЕсли;
		
		СтрокаГруппировки             = СокращенноеДеревоСтруктуры.Строки[0];
		
		// выделяем объект для импорта
		Если РезультатВыполнения.Колонки.Найти("СостояниеПлатежноРасчетныхДокументовGUIDКО") <> Неопределено Тогда		
			СохраненныйДокумент       = БиблиотекаФункцийОбмена.НайтиДокументПоGUID(Формат.ИдентификаторОбъекта.Имя, СтрокаДокумента.СостояниеПлатежноРасчетныхДокументовGUIDКО);
		Иначе
			СохраненныйДокумент       = "";
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СохраненныйДокумент) Тогда		
			СохраненныйДокумент       = Документы[Формат.ИдентификаторОбъекта.Имя].ПустаяСсылка();
		КонецЕсли;

		Если СохраненныйДокумент.Пустая() Тогда
			ДокументОбъект            = Документы[Формат.ИдентификаторОбъекта.Имя].СоздатьДокумент();
			ДокументОбъект.Дата       = ТекущаяДатаСеанса();
		Иначе 
			
			Если Задание.ВидОбмена.ОтменаПовторнойЗагрузкиПроведенныхДокументов И СохраненныйДокумент.Проведен Тогда 
				
				Если Задание.ОбъектыОбмена.Найти(СохраненныйДокумент) = Неопределено Тогда    
			
					НовСтрокаЗадания                    = Задание.ОбъектыОбмена.Добавить();
					НовСтрокаЗадания.ИмяФайлаЗагрузки	= ИмяФайла;
					НовСтрокаЗадания.Формат				= Формат;
					НовСтрокаЗадания.Объект				= СохраненныйДокумент;  
					
				КонецЕсли;   
				
				Сообщение    = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НСтр("ru='В файле [ИмяФайла] есть ссылка на документ [Документ], загруженный ранее и проведенный. Он останется без изменений.'"),
																									Новый Структура("Документ, ИмяФайла", 
																													СохраненныйДокумент, 
																													ИмяФайла));
				ОбщегоНазначения.СообщитьПользователю(Сообщение,,"ФайлыОбмена["+НомерСтрокиОсновногоФайла+"].ИмяФайлаЗагрузки");


				Продолжить;
			КонецЕсли;
						
			ДокументОбъект            = СохраненныйДокумент.ПолучитьОбъект();     
						
			Если БиблиотекаФункцийОбмена.ПолучитьСтатусДокумента(ДокументОбъект.Ссылка) <> Перечисления.СтатусыИсполненияДокумента.ВРаботе Тогда
				ВызватьИсключение НСтр("ru='Документ с таким же GUID был обработан ранее (его статус отличен от статуса <<в работе>>) '") + СохраненныйДокумент;
			КонецЕсли;	
			Попытка
				ЗаблокироватьДанныеДляРедактирования(ДокументОбъект.Ссылка);
			Исключение
				ВызватьИсключение НСтр("ru='Невозможно заблокировать для редактирования документ '") + СохраненныйДокумент;
			КонецПопытки;
			
			Для каждого ТабЧасть Из Метаданные.Документы[Формат.ИдентификаторОбъекта.Имя].ТабличныеЧасти Цикл
				ДокументОбъект[ТабЧасть.Имя].Очистить();
			КонецЦикла;
			
		КонецЕсли;
		
		//настроим расшифровку под эту Выписку, так как в оригинале она к Выпискам вообще не привязана
		
		СтруктураВыписки[0].GUIDВыписки    = ?(РезультатВыполнения.Колонки.Найти("СостояниеПлатежноРасчетныхДокументовGUIDКО") <> Неопределено, СтрокаДокумента.СостояниеПлатежноРасчетныхДокументовGUIDКО, "");
		СтруктураВыписки[0].НомерЛС        = СтрокаДокумента.ЛицевойСчет.Код;
		СтруктураВыписки[0].ДатаВыписки    = ДокументОбъект.Дата;
		
		//----------------------------------
		
		// запись реквизитов шапки документа
		СтрокаРеквизитов              = "";
		СтрокаРеквизитовПП            = "";
		СтрокаРеквизитовСР            = ""; 
				
		ПроизвольныеПараметры         = Новый Структура;
				
		Для каждого ТекПоле Из СтрокаГруппировки.Поля Цикл
			Если Найти(ВРЕГ(ТекПоле), "СОСТОЯНИЕПЛАТЕЖНОРАСЧЕТНЫХДОКУМЕНТОВ") <> 0 Тогда
				СтрокаРеквизитовСР  = СтрокаРеквизитовСР + "," + ТекПоле;			
			ИначеЕсли Найти(ВРЕГ(ТекПоле), "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ") <> 0 Тогда
				СтрокаРеквизитовПП  = СтрокаРеквизитовПП + "," + ТекПоле;				
			ИначеЕсли Найти(ВРЕГ(ТекПоле), "ФАЙЛА") = 0 Тогда  
				//не относится к сообщениям об ошибках с данными из файла
				СтрокаРеквизитов    = СтрокаРеквизитов   + "," + ТекПоле;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаРеквизитов            = Сред(СтрокаРеквизитов,   2);
		СтрокаРеквизитовПП          = Сред(СтрокаРеквизитовПП, 2);
		СтрокаРеквизитовСР          = Сред(СтрокаРеквизитовСР, 2);
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаДокумента, СтрокаРеквизитов);
		ЗаполнитьЗначенияСвойств(ДокументОбъект, Задание, "Организация");
		
		Если ДокументОбъект.ЭтоНовый() Тогда
			ДокументОбъект.Записать();
		КонецЕсли;
		
		//------------------------------------
		Если ЗначениеЗаполнено(СтрокаРеквизитовСР) Тогда
			
			Запись                              = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьМенеджерЗаписи();
			Запись.ПлатежноРасчетныйДокумент 	= ДокументОбъект.Ссылка;
			
			РеквизитыСР                         = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаРеквизитовСР, ",");
			
			Для каждого РеквизитСР Из РеквизитыСР Цикл			
				Запись[Сред(РеквизитСР, 38)]    = СтрокаДокумента[СтрЗаменить(РеквизитСР, ".", "")];
			КонецЦикла;
				
			Запись.Записать();
			
		КонецЕсли;
        //------------------------------------
		
		СтруктураПроверки           = Новый Структура(СтрЗаменить(СтрокаРеквизитовПП, ".", ""));
						
		ЗаполнитьЗначенияСвойств(СтруктураПроверки, СтрокаДокумента);
		
		// обработка реквизитов табличных частей
		Для каждого ВложеннаяГруппировка Из СтрокаГруппировки.Строки Цикл
			
			СтрокаРеквизитов          = "";
			СтрокаРеквизитовПП        = "";
			
			Для каждого ТекПоле Из ВложеннаяГруппировка.Поля Цикл
				
				Если Найти(ВРЕГ(ТекПоле), "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ") = 0 Тогда
				
					Если Лев(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 1) = ВложеннаяГруппировка.Группировка + "." Тогда
						СтрокаРеквизитов  = СтрокаРеквизитов + "," + Сред(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 2);	
					Иначе
						СтрокаРеквизитов  = СтрокаРеквизитов + "," + ТекПоле;
					КонецЕсли;
					
					Если Найти(ВРЕГ(ТекПоле), "СОСТОЯНИЕПЛАТЕЖНОРАСЧЕТНЫХДОКУМЕНТОВ") > 0 Тогда
						 СтрокаРеквизитовСР = СтрокаРеквизитовСР + "," + ТекПоле;
					КонецЕсли;
					
				Иначе
					
					СтрокаРеквизитовПП  = СтрокаРеквизитовПП + "," + ТекПоле;
										
				КонецЕсли;
				
			КонецЦикла;
			
			СтрокаРеквизитов          = Сред(СтрокаРеквизитов, 2);
			СтрокаРеквизитовПП        = Сред(СтрокаРеквизитовПП, 2); 
			
			ПараметрыВызоваФункции    = Новый Соответствие;
			
			н = " ";
			
			Для каждого ВложеннаяСтрока Из СтрокаДокумента.Строки Цикл
				
				Для каждого Параметр Из РезультатВыполнения.Колонки  Цикл
					Если Найти(Параметр.Имя, "__") > 0 И ЗначениеЗаполнено(ВложеннаяСтрока[Параметр.Имя]) Тогда
						
						Если Сред(Параметр.Имя, Найти(Параметр.Имя, "__") + 2) <> н Тогда
							РабочаяСтрока = СтрокаДокумента.Строки.Добавить();
							н             = Сред(Параметр.Имя, Найти(Параметр.Имя, "__") + 2);
						КонецЕсли;
						
						РабочаяСтрока[Лев(Параметр.Имя, Найти(Параметр.Имя, "__")-1)] = ВложеннаяСтрока[Параметр.Имя];
						
					КонецЕсли;	
				КонецЦикла;
				
			КонецЦикла;
						
			
			Для каждого ВложеннаяСтрока Из СтрокаДокумента.Строки Цикл
				
				Если ВложеннаяГруппировка.Группировка  =  "ДокументыДвижений" Тогда
					
					ФункцияЗаполнения                  = ВложеннаяСтрока["ДокументыДвиженийИсполняющийДокумент"];
					
					РазложениеИсполняемыхДействий = СтрРазделить(ФункцияЗаполнения, ";");
					ИсполняющийДокумент           = Неопределено;	
					
					ПараметрыВызоваФункции.Вставить("НомерДок",            "");
					ПараметрыВызоваФункции.Вставить("ДатаДок",             "");
					ПараметрыВызоваФункции.Вставить("СуммаСписания",       "");
					
																	
					СтруктураПроверки                             = Новый Структура(СтрЗаменить(СтрокаРеквизитовПП, ".", ""));
					
					ЗаполнитьЗначенияСвойств(СтруктураПроверки, ВложеннаяСтрока);
					
					Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
						Если ВРЕГ(Лев(ЗначениеПроверки.Ключ, 38)) = "ДОКУМЕНТЫДВИЖЕНИЙПРОИЗВОЛЬНЫЕПАРАМЕТРЫ" Тогда
							ПараметрыВызоваФункции.Вставить(Сред(ЗначениеПроверки.Ключ, 39), ЗначениеПроверки.Значение);
						КонецЕсли;
					КонецЦикла; 
					
					//****************************************************************************
					
					ПараметрНомерДок 			= ?(ЗначениеЗаполнено(ПараметрыВызоваФункции.Получить("НомерДок")), ПараметрыВызоваФункции.Получить("НомерДок"), ПараметрыВызоваФункции.Получить("НомерПодтверждающегоДокумента"));
					ПараметрДатаДок 			= ?(ЗначениеЗаполнено(ПараметрыВызоваФункции.Получить("ДатаДок")),  ПараметрыВызоваФункции.Получить("ДатаДок"),  ПараметрыВызоваФункции.Получить("ДатаПодтверждающегоДокумента"));
					ПараметрИмяДок              = ПараметрыВызоваФункции.Получить("ИмяДок");
					ПараметрГУИД 				= ПараметрыВызоваФункции.Получить("GUIDПП");
					ПараметрСуммаПоступления	= ПараметрыВызоваФункции.Получить("СуммаПоступления");
					ПараметрСуммаСписания 		= ПараметрыВызоваФункции.Получить("СуммаСписания");     
					ПараметрСуммаКорректировки  = ПараметрыВызоваФункции.Получить("СуммаКорректировки"); 
					ПараметрКВД					= ПараметрыВызоваФункции.Получить("КВД");
					ПараметрИсточникиСтредств	= ПараметрыВызоваФункции.Получить("ИсточникиСредств");
					ПараметрНомерКОО        	= ПараметрыВызоваФункции.Получить("НомерКОО");
					ПараметрНомерПодтверДок     = ПараметрыВызоваФункции.Получить("НомерПодтверждающегоДокумента");
				    ПараметрДатаПодтверДок      = ПараметрыВызоваФункции.Получить("ДатаПодтверждающегоДокумента");
					
					Если ПараметрСуммаПоступления<>Неопределено Тогда
						ПараметрСуммаПоступления =  БиблиотекаФункцийОбмена.СтрокаВЧисло(ПараметрСуммаПоступления);
					Иначе
						ПараметрСуммаПоступления = 0;
					КонецЕсли;
					Если ПараметрСуммаСписания<>Неопределено Тогда
						ПараметрСуммаСписания = БиблиотекаФункцийОбмена.СтрокаВЧисло(ПараметрСуммаСписания);
					Иначе
						ПараметрСуммаСписания = 0;
					КонецЕсли;
										
					Для каждого ВыполняемоеДействие Из РазложениеИсполняемыхДействий Цикл
						// выполняем действие для данной строки
						Если ВРЕГ(ВыполняемоеДействие) = ВРЕГ("НовоеКассовоеПоступление") Тогда
							Если ПараметрСуммаПоступления>0 Тогда
																
								Если НЕ ЗначениеЗаполнено(ИсполняющийДокумент) Тогда
									 ИсполняющийДокумент = БиблиотекаФункцийОбмена.СоздатьКассовоеПоступление(СтруктураВыписки,
																											  ДокументОбъект.Ссылка, 
																											  ПараметрГУИД, 
																											  ПараметрКВД, 
																											  ПараметрИсточникиСтредств,
																											  ПараметрСуммаПоступления,
								      																	      ПараметрыВызоваФункции,
																											  ВидОбмена,
																											  ДанныеНовыхКонтрагентов);
								КонецЕсли;																			  																													  
							КонецЕсли;	
							
						ИначеЕсли ВРЕГ(ВыполняемоеДействие) = ВРЕГ("ПолучитьЗаявку") Тогда
							Если (ПараметрСуммаСписания>0) ИЛИ (ПараметрСуммаКорректировки>0) Тогда
								ИсполняющийДокумент = БиблиотекаФункцийОбмена.ОпределитьЗаявку(	ДокументОбъект.Организация,
																								ДокументОбъект.ЛицевойСчет.Код,
																								ПараметрНомерДок, 
																								ПараметрДатаДок,
																								?(ПараметрСуммаСписания>0, ПараметрСуммаСписания, ПараметрСуммаКорректировки),
																								ПараметрГУИД);
																							
							КонецЕсли;																										
							Если НЕ ЗначениеЗаполнено(ИсполняющийДокумент) Тогда   
																								
								Если ПараметрСуммаСписания > 0 Тогда 
							  		ИсполняющийДокумент =  БиблиотекаФункцийОбмена.СоздатьКассовоеВыбытие(	СтруктураВыписки, 
																											ДокументОбъект.Ссылка, 
																											ПараметрГУИД,
									 																		ПараметрКВД, 
																											ПараметрИсточникиСтредств, 
																											ПараметрСуммаСписания,
																											ПараметрыВызоваФункции,
																											ВидОбмена,
																										    ДанныеНовыхКонтрагентов);   
								КонецЕсли;

                                Если НЕ ЗначениеЗаполнено(ИсполняющийДокумент) И (ПараметрСуммаСписания > 0) И (ЗначениеЗаполнено(ПараметрНомерКОО)) Тогда 
                                	ИсполняющийДокумент = БиблиотекаФункцийОбмена.СоздатьКассовоеВыбытиеНаОснованииЗаявленияНаАккредитив(ПараметрНомерКОО, ПараметрСуммаСписания, ДокументОбъект.ДатаВыписки);
								КонецЕсли;

							Иначе    
								 Если ТипЗнч(ИсполняющийДокумент) = Тип("ДокументСсылка.ВнешнееРСКП") Тогда
											 ИсполняющийДокумент = БиблиотекаФункцийОбмена.СоздатьКассовоеВыбытиеНаОснованииРСКП(ИсполняющийДокумент, ДокументОбъект.Ссылка, СтруктураВыписки, ПараметрГУИД, ПараметрыВызоваФункции)
										Иначе

								 			 БиблиотекаФункцийОбмена.ЗаписатьОбразПервичногоДокументаЗаявки(ИсполняющийДокумент, 
								 																	СтруктураВыписки, 
																									ДокументОбъект.Ссылка, 
																									ДокументОбъект.ДатаВыписки,
																									ПараметрГУИД,
								 																	ПараметрыВызоваФункции);  
								 КонецЕсли;																	
							КонецЕсли; 					
						КонецЕсли;
						
					КонецЦикла; 

					
					
					//****************************************************************************
																	
					Если ЗначениеЗаполнено(ИсполняющийДокумент) Тогда
						ДокументОбъект.ДокументыДвижений.Добавить().ИсполняющийДокумент = ИсполняющийДокумент;
					КонецЕсли;					 		
							
                    Продолжить;
						
                КонецЕсли;
								 
				ЕстьЗаполненные       = Ложь;
				СтруктураПроверки     = Новый Структура(СтрЗаменить(СтрокаРеквизитов, ".", ""));
				
				Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
					СтруктураПроверки[ЗначениеПроверки.Ключ]          = ВложеннаяСтрока[ВложеннаяГруппировка.Группировка + ЗначениеПроверки.Ключ];	
					ЕстьЗаполненные                                   = Макс(ЕстьЗаполненные, ЗначениеЗаполнено(СтруктураПроверки[ЗначениеПроверки.Ключ]));
				КонецЦикла;
				
				Если ВложеннаяГруппировка.Группировка  =  "Остатки" Тогда
					
					Если (СтруктураПроверки["ОстатокНаНачалоДня"] = 0 И СтруктураПроверки["ОстатокНаКонецДня"] = 0) ИЛИ
						ДокументОбъект.Остатки.Количество()> 0 Тогда
						 Продолжить;
					КонецЕсли;	
						
				КонецЕсли;
				
				Если ВложеннаяГруппировка.Группировка  =  "" Тогда
					
					 Если ЕстьЗаполненные Тогда
					      ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтруктураПроверки);
					 КонецЕсли;
					
					 Продолжить;					
				КонецЕсли;

				
				Если ЕстьЗаполненные Тогда
					ЗаполнитьЗначенияСвойств(ДокументОбъект[ВложеннаяГруппировка.Группировка].Добавить(), СтруктураПроверки);   
					
					Если ВложеннаяГруппировка.Группировка  =  "Остатки" Тогда
						
						НомерСтроки = 1;  
						
						Пока Найти(СтрокаРеквизитов, "__" + Строка(НомерСтроки)) > 0 Цикл
							
							СтрокаОстатков = ДокументОбъект.Остатки.Добавить();
							Если Найти(СтрокаРеквизитов, "ОстатокНаНачалоДня__" + Строка(НомерСтроки)) > 0 Тогда
								СтрокаОстатков.ОстатокНаНачалоДня = СтруктураПроверки["ОстатокНаНачалоДня__" + Строка(НомерСтроки)];				 		
							КонецЕсли;	
							Если Найти(СтрокаРеквизитов, "ОстатокНаКонецДня__" + Строка(НомерСтроки)) > 0 Тогда
								СтрокаОстатков.ОстатокНаКонецДня = СтруктураПроверки["ОстатокНаКонецДня__" + Строка(НомерСтроки)];				 		
							КонецЕсли;	
							Если Найти(СтрокаРеквизитов, "ИсточникСредств__" + Строка(НомерСтроки)) > 0 Тогда
								СтрокаОстатков.ИсточникСредств = СтруктураПроверки["ИсточникСредств__" + Строка(НомерСтроки)];				 		
							КонецЕсли;	
							Если Найти(СтрокаРеквизитов, "Показатель__" + Строка(НомерСтроки)) > 0 Тогда
								СтрокаОстатков.Показатель = СтруктураПроверки["Показатель__" + Строка(НомерСтроки)]; 		
							КонецЕсли;	
							
							НомерСтроки    = НомерСтроки + 1;
							
						КонецЦикла;	
							
					КонецЕсли;		
										
				КонецЕсли; 				
					
			КонецЦикла;	
			
		КонецЦикла;
        		
								
		Если  ДокументОбъект.Модифицированность() Тогда					
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);	
		КонецЕсли;		
		
		Если Задание.ОбъектыОбмена.Найти(ДокументОбъект.Ссылка) = Неопределено Тогда  
			
			НовСтрокаЗадания                    = Задание.ОбъектыОбмена.Добавить();
			НовСтрокаЗадания.ИмяФайлаЗагрузки	= ИмяФайла;
			НовСтрокаЗадания.Формат				= Формат;
			НовСтрокаЗадания.Объект				= ДокументОбъект.Ссылка;      
			
			Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ВыпискаИзЛицевогоСчета") Тогда  
				
				Для каждого СтрокаВыписки Из ДокументОбъект.ДокументыДвижений Цикл
					
					СтрокаЗадания = Задание.ОбъектыОбмена.Найти(СтрокаВыписки.ИсполняющийДокумент, "Объект");
					
					Если СтрокаЗадания <> Неопределено Тогда 
						 Задание.ОбъектыОбмена.Удалить(СтрокаЗадания);
					КонецЕсли;  
					 
				КонецЦикла;	
				
			КонецЕсли;	
			
		КонецЕсли;
		//-------------------------------------
		
    КонецЦикла;
	
КонецПроцедуры     

Функция НайтиСтрокиРаспоряженияНаКартыМИР(Ссылка, НомерПлатежнойКарты, ДатаРожденияДержателяКарты, ВидВыплатНаКартуМИР)
	
	Запрос       = Новый Запрос;   
	Запрос.УстановитьПараметр("Ссылка", 	                Ссылка);
	Запрос.УстановитьПараметр("НомерПлатежнойКарты", 	    НомерПлатежнойКарты);
	Запрос.УстановитьПараметр("ДатаРожденияДержателяКарты", ДатаРожденияДержателяКарты);  
	Запрос.УстановитьПараметр("ВидВыплатНаКартуМИР",        ВидВыплатНаКартуМИР);
	Запрос.Текст = "ВЫБРАТЬ
    |	РаспоряжениеОПеречисленииНаКартыМирСостав.НомерСтроки КАК НомерСтроки
	|ИЗ
    |	Документ.РаспоряжениеОПеречисленииНаКартыМир.Состав КАК РаспоряжениеОПеречисленииНаКартыМирСостав 
	|ГДЕ
	|	(РаспоряжениеОПеречисленииНаКартыМирСостав.Ссылка = &Ссылка) И 
	|   ((РаспоряжениеОПеречисленииНаКартыМирСостав.НомерПлатежнойКарты = &НомерПлатежнойКарты) ИЛИ (РаспоряжениеОПеречисленииНаКартыМирСостав.ПлатежнаяКарта.Код = &НомерПлатежнойКарты)) И
	|   (РаспоряжениеОПеречисленииНаКартыМирСостав.ВидВыплатНаКартуМИР.Код = &ВидВыплатНаКартуМИР)";
	
	Если ЗначениеЗаполнено(ДатаРожденияДержателяКарты) Тогда
		Запрос.Текст = Запрос.Текст + "
		| И ((РаспоряжениеОПеречисленииНаКартыМирСостав.ДатаРожденияДержателяКарты = &ДатаРожденияДержателяКарты) 
		|ИЛИ (РаспоряжениеОПеречисленииНаКартыМирСостав.Контрагент.ЮридическоеФизическоеЛицо.ДатаРождения = &ДатаРожденияДержателяКарты))  
		|";
	КонецЕсли;	
	
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции	

Процедура ЗагрузитьИзФайлаXML_EB(ТекстФайла, Формат, Задание, ИмяФайла, ДанныеНовыхКонтрагентов, ОписаниеОбъектаОшибки)
	
	Перем СостояниеПлатежноРасчетныхДокументов;
	
	СостояниеПлатежноРасчетныхДокументов = Новый Структура;
	
	ПравилаЗагрузки                      = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(Формат);
	
	СоответствиеКолонок                                   = Новый Соответствие;
	ДеревоСтруктуры                                       = Новый ДеревоЗначений;
	
	ДеревоСтруктуры.Колонки.Добавить("ИмяПоля",				Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПолноеИмяПоля",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ИмяПоляТаблицы",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПорядокЗаполнения", 	Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПолеОбъекта",			Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ТабличнаяЧасть",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ДопДействия",			Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("Условие",				Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("КонечныйЭлемент", 	Новый ОписаниеТипов("Булево"));
	ДеревоСтруктуры.Колонки.Добавить("Группировка",			Новый ОписаниеТипов("Строка"));
	
	Для каждого ТекПравило Из ПравилаЗагрузки Цикл
		// если поле объекта не задано, то мы не учитываем узел
		Если ЗначениеЗаполнено(ТекПравило.ПолеОбъекта) Тогда
			
			КоллекцияСтрокДерева = ДеревоСтруктуры.Строки;
			ЧастиИмени           = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекПравило.ПолеФайлаПередачи, "/");
			МаксИндекс           = ЧастиИмени.ВГраница();
			
			Для Индекс           = 0 По МаксИндекс Цикл
				ЧастьИмени       = ЧастиИмени[Индекс];
				
				Если ПустаяСтрока(ЧастьИмени) Тогда
					Продолжить;
				КонецЕсли;
				
				ТекСтрокаДерева                     = КоллекцияСтрокДерева.Найти(ЧастьИмени, "ИмяПоля");
				
				Если ТекСтрокаДерева = Неопределено Тогда
					
					ТекСтрокаДерева                 = КоллекцияСтрокДерева.Добавить();
					ТекСтрокаДерева.ИмяПоля         = ЧастьИмени;
					
					Если ЗначениеЗаполнено(ТекПравило.ТабличнаяЧасть) Тогда
						ТекСтрокаДерева.Группировка = ТекПравило.ТабличнаяЧасть;
					ИначеЕсли ЗначениеЗаполнено(ТекПравило.ПолеОбъекта) И Найти(ТекПравило.ПолеОбъекта, ".") = 0 Тогда
						ТекСтрокаДерева.Группировка = "Объект";
					КонецЕсли;
					
					Если Индекс = МаксИндекс Тогда
						
						ТекСтрокаДерева.ПолноеИмяПоля 		= ТекПравило.ПолеФайлаПередачи;
						ТекСтрокаДерева.ПолеОбъекта 		= ТекПравило.ПолеОбъекта;
						ТекСтрокаДерева.ПорядокЗаполнения	= ТекПравило.ПорядокЗаполнения;
						ТекСтрокаДерева.ТабличнаяЧасть 		= ТекПравило.ТабличнаяЧасть;
						ТекСтрокаДерева.ДопДействия 		= ТекПравило.ДопДействия;
						ТекСтрокаДерева.Условие		 		= ТекПравило.Условие;
						ТекСтрокаДерева.КонечныйЭлемент		= Истина;
						
					КонецЕсли;
					
				КонецЕсли;
				
				КоллекцияСтрокДерева = ТекСтрокаДерева.Строки;
				
			КонецЦикла; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбозначитьЛистьяДерева(ДеревоСтруктуры);
	ОбозначитьГруппировкиВДереве(ДеревоСтруктуры);
		
	// для каждого поля зададим имя поля таблицы и сразу создадим структуру таблицы
	ТаблицаДанных                = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("КонечныйЭлемент");
	СчетчикКолонок               = 1;
	ЗаполнитьИменаПолейДереваСтруктуры(ДеревоСтруктуры, ТаблицаДанных, СчетчикКолонок);
	
	ЧтениеXML 			         = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM    = ПостроительDOM.Прочитать(ЧтениеXML);

	ПутьПравилаОбработки         = "";
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	СоответствиеИндексов          = Новый Соответствие;
	
	Пока ЧтениеXML.Прочитать() Цикл
		// Обработка узла XML           	
		Если ЧтениеXML.ТипУзла   = ТипУзлаXML.НачалоЭлемента Тогда
			
			ИмяПоля              = ЧтениеXML.ЛокальноеИмя;	
			ИмяПоляDOM           = ЧтениеXML.ЛокальноеИмя;
			ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ИмяПоля;
			
			ТекСтрока            = ДеревоСтруктуры.Строки.Найти(ПутьПравилаОбработки, "ПолноеИмяПоля",Истина);
			Если ТекСтрока <> Неопределено Тогда
				
				Если (ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[0].ДочерниеУзлы.Количество()> 0) И 
					 (ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[0].ДочерниеУзлы[0].ИмяУзла) <> "#text" Тогда
					СтрокаДанных                 = ТаблицаДанных.Добавить(); 
					СтрокаДанных.КонечныйЭлемент = Ложь;
				КонецЕсли;
				
				РодительскийУзел     = "";  
				
				Индекс                                  = ПолучитьИндекс(ИмяПоля, СоответствиеИндексов);
				Если ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля).Количество() > Индекс Тогда 
					
					РодительскийУзел = ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[Индекс];
					
					Для Каждого ДочернийУзел Из ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[Индекс].ДочерниеУзлы Цикл
						
						ОбрабатываемоеПравило = ТекСтрока.Строки.Найти(?(ЗначениеЗаполнено(ДочернийУзел.ЛокальноеИмя), ДочернийУзел.ЛокальноеИмя, ДочернийУзел.ИмяУзла) , "ИмяПоля"); 
												
						Если ОбрабатываемоеПравило <> Неопределено Тогда   
							
							 Если НЕ ЗначениеЗаполнено(ОбрабатываемоеПравило.ИмяПоляТаблицы) Тогда 
								Продолжить;
							 КонецЕсли;
							 
							 СтрокаДанных.КонечныйЭлемент = ОбрабатываемоеПравило.КонечныйЭлемент;
							 СтрокаДанных[ОбрабатываемоеПравило.ИмяПоляТаблицы] = ДочернийУзел.ТекстовоеСодержимое;
							 
						КонецЕсли;
						
					КонецЦикла;	
						
				КонецЕсли;	
				
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла  = ТипУзлаXML.КонецЭлемента Тогда 			
			ПутьПравилаОбработки     = Лев(ПутьПравилаОбработки, СтрДлина(ПутьПравилаОбработки) - (СтрДлина(ЧтениеXML.Имя)+1));
		КонецЕсли;
		
	КонецЦикла;	
			
	МассивИменСтрок                  = Новый Массив;
	МассивИменСтрок.Добавить("exchangePacket/formularCollection/formular/GUID_Ord");
	
	МассивИменПолейТД                = Новый Массив;
	
	Для Каждого ЭлМас Из МассивИменСтрок Цикл
		ТекСтрока                    = ДеревоСтруктуры.Строки.Найти(ЭлМас, "ПолноеИмяПоля",Истина);
		Если ТекСтрока <> Неопределено Тогда
			МассивИменПолейТД.Добавить(ТекСтрока.ИмяПоляТаблицы);	
		КонецЕсли;
	КонецЦикла;   
	
	Если ДокументDOM.ПолучитьЭлементыПоИмени("Inf_Signs").Количество() > 0 Тогда  
	//в файле есть секция с подписями ответственного исполнителя, то информацию о нем нужно сдвинуть в шапку документа,
	//чтобы не множить количество строк результата запроса
	    		
		Если ТаблицаДанных.Количество()>1 Тогда
			
			ЕстьСтрокиСКомментариями = Ложь;    
			
			Для к = 0 По ТаблицаДанных.Количество()- 2 Цикл   
				Если ТаблицаДанных[к].КонечныйЭлемент Тогда
					 ЕстьСтрокиСКомментариями = Истина;
					 Продолжить;
				 КонецЕсли;
			КонецЦикла;	 
			
			Если ЕстьСтрокиСКомментариями Тогда
				ТаблицаДанных[ТаблицаДанных.Количество()-1].КонечныйЭлемент = Ложь;
				ТаблицаДанных.Сдвинуть(ТаблицаДанных.Количество()-1, (-1)*(ТаблицаДанных.Количество()-1));   
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	// заполним колонки конечных элементов значениями из вышестоящих неконечных элементов
	СвернутьТаблицуЗначений(ТаблицаДанных, МассивИменПолейТД);
	
	// создание схемы компоновки данных
	СхемаКомпоновкиРезультата         = Новый СхемаКомпоновкиДанных;
	ИсточникДанных                    = СхемаКомпоновкиРезультата.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя                = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных                       = СхемаКомпоновкиРезультата.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя 			      = "НаборДанных1";
	НаборДанных.ИмяОбъекта 		      = "ВходящиеДанные";
	НаборДанных.ИсточникДанных 	      = "ИсточникДанных1";
	
	РазрешенныеМодули                 = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("БИБЛИОТЕКАФУНКЦИЙОБМЕНА");
	СоответствиеГруппировок           = Новый Соответствие;
	СоздатьСтруктуруСхемыКомпоновкиИзДерева(ДеревоСтруктуры, СхемаКомпоновкиРезультата.НастройкиПоУмолчанию, СхемаКомпоновкиРезультата, НаборДанных, РазрешенныеМодули, СоответствиеГруппировок);	
	
	ВнешниеНаборы                     = Новый Структура("ВходящиеДанные", ТаблицаДанных);
	ФорматЗагрузки                    = Формат;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "КассовыйОрган";
	Параметр.Значение                 = Задание.КассовыйОрган;
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "Организация";
	Параметр.Значение                 = Задание.Организация;
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "ВалютаРеглУчета";
	Параметр.Значение                 = Константы.ВалютаРегламентированногоУчета.Получить();
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	НастройкиКомпоновки               = СхемаКомпоновкиРезультата.НастройкиПоУмолчанию;
	
	КомпоновщикМакета                 = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки                   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиРезультата, НастройкиКомпоновки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); 
	ПроцессорКомпоновки               = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы,,Истина);
	ПроцессорВывода                   = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	РезультатВыполнения               = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	СокращенноеДеревоСтруктуры        = Новый ДеревоЗначений;
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Группировка", Новый ОписаниеТипов("Строка"));
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Поля", Новый ОписаниеТипов("Массив"));
	
	СократитьДерево(ДеревоСтруктуры, СокращенноеДеревоСтруктуры, СоответствиеГруппировок); 
	
	ПараметрыВызоваФункции = Новый Структура;
	
	Для каждого СтрокаДокумента Из РезультатВыполнения.Строки[0].Строки Цикл
		
		СтрокаГруппировки             = СокращенноеДеревоСтруктуры.Строки[0].Строки[0];
		
		// выделяем объект для импорта
		СохраненныйДокумент           = БиблиотекаФункцийОбмена.НайтиДокументПоРеквизитуGUID(Формат.ИдентификаторОбъекта.Имя, СтрокаДокумента.ПроизвольныеПараметрыGUIDРаспоряжения);
		
		Если НЕ ЗначениеЗаполнено(СохраненныйДокумент) Тогда  
			
			СтрокаОписания = ОписаниеОбъектаОшибки.Добавить();
			СтрокаОписания.ПолеФайла = НСтр("ru='Не найдено Распоряжение о перечислении на карты МИР'"); 
			СтрокаОписания.Ошибка    = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
			                                                        НСтр("ru='Отсутсвует документ для обработки с GUID: [GUID]'"),
																	Новый Структура("GUID", Строка(СтрокаДокумента.ПроизвольныеПараметрыGUIDРаспоряжения))
																	);
			ВставитьОшибкуВДокумент(Задание, ЗначениеВСтрокуВнутр(ОписаниеОбъектаОшибки), Задание.ФайлыОбмена.Найти(ИмяФайла, "ИмяФайлаЗагрузки").НомерСтроки);
			
			Возврат;
			
		Иначе
			ДокументОбъект            = СохраненныйДокумент.ПолучитьОбъект();
			//Если БиблиотекаФункцийОбмена.ПолучитьСтатусДокумента(ДокументОбъект.Ссылка) <> Перечисления.СтатусыИсполненияДокумента.ВРаботе Тогда
			//	ВызватьИсключение НСтр("ru='Документ с таким же номером был обработан ранее (его статус отличен от статуса <<в работе>>) '") + СохраненныйДокумент;
			//КонецЕсли;	
			Попытка
				ЗаблокироватьДанныеДляРедактирования(ДокументОбъект.Ссылка);
			Исключение
				ВызватьИсключение НСтр("ru='Невозможно заблокировать для редактирования документ '") + СохраненныйДокумент;
			КонецПопытки;
			
		КонецЕсли;
		
		
		
		// запись реквизитов шапки документа
		СтрокаРеквизитов              = "";
		СтрокаРеквизитовПП            = "";
		СтрокаРеквизитовСР            = ""; 
				
		ПроизвольныеПараметры         = Новый Структура;
				
		Для каждого ТекПоле Из СтрокаГруппировки.Поля Цикл
			Если Найти(ВРЕГ(ТекПоле), "СОСТОЯНИЕПЛАТЕЖНОРАСЧЕТНЫХДОКУМЕНТОВ") <> 0 Тогда
				СтрокаРеквизитовСР  = СтрокаРеквизитовСР + "," + ТекПоле;			
			ИначеЕсли Найти(ВРЕГ(ТекПоле), "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ") <> 0 Тогда
				СтрокаРеквизитовПП  = СтрокаРеквизитовПП + "," + ТекПоле;				
			ИначеЕсли Найти(ВРЕГ(ТекПоле), "ФАЙЛА") = 0 Тогда  
				//не относится к сообщениям об ошибках с данными из файла
				СтрокаРеквизитов    = СтрокаРеквизитов   + "," + ТекПоле;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаРеквизитов            = Сред(СтрокаРеквизитов,   2);
		СтрокаРеквизитовПП          = Сред(СтрокаРеквизитовПП, 2);
		СтрокаРеквизитовСР          = Сред(СтрокаРеквизитовСР, 2);  
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаДокумента, СтрокаРеквизитов);   
		//по умолчанию Извещение согласует выплату во всех строках Распоряжения
		Для каждого СтрокаСостав Из ДокументОбъект.Состав Цикл
			
			СтрокаСостав.Выплачено      = Истина;
			СтрокаСостав.Ошибка         = 1;
			СтрокаСостав.ОписаниеОшибки = "";
			
		КонецЦикла;    
		
			//------------------------------------
		Если ЗначениеЗаполнено(СтрокаРеквизитовСР) Тогда
			
			Запись                              = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьМенеджерЗаписи();
			Запись.ПлатежноРасчетныйДокумент 	= ДокументОбъект.Ссылка;
			
			РеквизитыСР                         = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаРеквизитовСР, ",");
			
			Для каждого РеквизитСР Из РеквизитыСР Цикл			
				Запись[Сред(РеквизитСР, 38)]    = СтрокаДокумента[СтрЗаменить(РеквизитСР, ".", "")];
			КонецЦикла;
				
			Запись.Записать();
			
		КонецЕсли;
        //------------------------------------
		
		// обработка реквизитов табличных частей
		Для каждого ВложеннаяГруппировка Из СтрокаГруппировки.Строки Цикл
			
			СтрокаРеквизитов          = "";
			СтрокаРеквизитовПП        = "";   // ревизиты произвольных параметров
			СтрокаРеквизитовСР        = "";   // реквизиты состояния РП документов
			
			Для каждого ТекПоле Из ВложеннаяГруппировка.Поля Цикл
				
				Если (Найти(ВРЕГ(ТекПоле), "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ") = 0) И (Найти(ВРЕГ(ТекПоле), "СОСТОЯНИЕПЛАТЕЖНОРАСЧЕТНЫХДОКУМЕНТОВ") = 0) Тогда
				
					Если Лев(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 1) = ВложеннаяГруппировка.Группировка + "." Тогда
						СтрокаРеквизитов  = СтрокаРеквизитов + "," +Сред(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 2);	
					Иначе
						СтрокаРеквизитов  = СтрокаРеквизитов + "," +ТекПоле;
					КонецЕсли;
					
				ИначеЕсли  Найти(ВРЕГ(ТекПоле), "СОСТОЯНИЕПЛАТЕЖНОРАСЧЕТНЫХДОКУМЕНТОВ") = 0 Тогда
					
					СтрокаРеквизитовПП  = СтрокаРеквизитовПП + "," +ТекПоле;
					
				Иначе
					
					СтрокаРеквизитовСР  = СтрокаРеквизитовСР + "," +ТекПоле;
				
				КонецЕсли;
				
			КонецЦикла;	
							
			// в СтрокаРеквизитов только имена табличной части
			
			Для каждого ВложеннаяСтрока Из СтрокаДокумента.Строки Цикл
				
								
				Если ВложеннаяГруппировка.Группировка  =  "Состав" Тогда
					
												
					ЕстьЗаполненные       = Ложь;
					СтруктураПроверки     = Новый Структура(СтрокаРеквизитов);  
										
					Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
						
						СтруктураПроверки[ЗначениеПроверки.Ключ]          = ВложеннаяСтрока[ВложеннаяГруппировка.Группировка + ЗначениеПроверки.Ключ];	
						ЕстьЗаполненные                                   = Макс(ЕстьЗаполненные, ЗначениеЗаполнено(СтруктураПроверки[ЗначениеПроверки.Ключ]));
											 
					КонецЦикла;
					
					
					Если ЕстьЗаполненные Тогда
						
						 НомераСтрокРаспоряжения = НайтиСтрокиРаспоряженияНаКартыМИР(ДокументОбъект.Ссылка, ВложеннаяСтрока.СоставНомерПлатежнойКарты, ВложеннаяСтрока.СоставДатаРожденияДержателяКарты, ВложеннаяСтрока.СоставВидВыплатНаКартуМИР);
						 
						 Для Каждого НомерСтроки Из НомераСтрокРаспоряжения Цикл
							 ДокументОбъект.Состав[НомерСтроки.НомерСтроки - 1].Выплачено = Ложь; 
						 КонецЦикла;	 
									           						
						Если НомераСтрокРаспоряжения.Количество() > 0 Тогда 
							
							Для каждого ВложеннаяГруппировка_2 Из ВложеннаяГруппировка.Строки Цикл
					
								Если ВложеннаяГруппировка_2.Группировка = "Ошибки" Тогда												
									
									Для каждого НомерСтроки Из НомераСтрокРаспоряжения  Цикл 
										
										ТаблицаОшибок = Новый ТаблицаЗначений;   
										ТаблицаОшибок.Колонки.Добавить("Код",      Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(4)));  
										ТаблицаОшибок.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
										
										Для каждого ВложеннаяСтрока_2 Из ВложеннаяСтрока.Строки Цикл
											
											СтрокаОшибка          = ТаблицаОшибок.Добавить();
											СтрокаОшибка.Код      = ВложеннаяСтрока_2.ОшибкиКодОшибки;
											СтрокаОшибка.Описание = ВложеннаяСтрока_2.ОшибкиТекстОшибки;
																						
										КонецЦикла;	    
										
										ДокументОбъект.Состав[НомерСтроки.НомерСтроки - 1].ОписаниеОшибки = ЗначениеВСтрокуВнутр(ТаблицаОшибок);
										Если ТаблицаОшибок.Количество()>0 Тогда
											ДокументОбъект.Состав[НомерСтроки.НомерСтроки - 1].Ошибка = 0;
										КонецЕсли;
										
									КонецЦикла;
								КонецЕсли;	
									
							КонецЦикла;
							
						КонецЕсли;   
						
					КонецЕсли;
									
				КонецЕсли;	
								
			КонецЦикла; 
				
		КонецЦикла; 
		
				
		Если  ДокументОбъект.Модифицированность() Тогда					
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);	
		КонецЕсли;			
		
		Если Задание.ОбъектыОбмена.Найти(ДокументОбъект.Ссылка) = Неопределено Тогда   
			
			НовСтрокаЗадания                    = Задание.ОбъектыОбмена.Добавить();
			НовСтрокаЗадания.ИмяФайлаЗагрузки	= ИмяФайла;
			НовСтрокаЗадания.Формат				= Формат;
			НовСтрокаЗадания.Объект				= ДокументОбъект.Ссылка;     
			
		КонецЕсли;
		//-------------------------------------
		
    КонецЦикла;
		
КонецПроцедуры

Процедура ЗагрузитьИзФайлаXML_RPP(ТекстФайла, Формат, Задание, ИмяФайла, ДанныеНовыхКонтрагентов, ОписаниеОбъектаОшибки)
	
	Перем СостояниеПлатежноРасчетныхДокументов;
	
	СостояниеПлатежноРасчетныхДокументов = Новый Структура;
	
	ПравилаЗагрузки                      = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(Формат);
	
	СоответствиеКолонок                                   = Новый Соответствие;
	ДеревоСтруктуры                                       = Новый ДеревоЗначений;
	
	ДеревоСтруктуры.Колонки.Добавить("ИмяПоля",				Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПолноеИмяПоля",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ИмяПоляТаблицы",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПорядокЗаполнения", 	Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПолеОбъекта",			Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ТабличнаяЧасть",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ДопДействия",			Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("Условие",				Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("КонечныйЭлемент", 	Новый ОписаниеТипов("Булево"));
	ДеревоСтруктуры.Колонки.Добавить("Группировка",			Новый ОписаниеТипов("Строка"));
	
	Для каждого ТекПравило Из ПравилаЗагрузки Цикл
		// если поле объекта не задано, то мы не учитываем узел
		Если ЗначениеЗаполнено(ТекПравило.ПолеОбъекта) Тогда
			
			КоллекцияСтрокДерева = ДеревоСтруктуры.Строки;
			ЧастиИмени           = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекПравило.ПолеФайлаПередачи, "/");
			МаксИндекс           = ЧастиИмени.ВГраница();
			
			Для Индекс           = 0 По МаксИндекс Цикл
				ЧастьИмени       = ЧастиИмени[Индекс];
				
				Если ПустаяСтрока(ЧастьИмени) Тогда
					Продолжить;
				КонецЕсли;
				
				ТекСтрокаДерева                     = КоллекцияСтрокДерева.Найти(ЧастьИмени, "ИмяПоля");
				
				Если ТекСтрокаДерева = Неопределено Тогда
					
					ТекСтрокаДерева                 = КоллекцияСтрокДерева.Добавить();
					ТекСтрокаДерева.ИмяПоля         = ЧастьИмени;
					
					Если ЗначениеЗаполнено(ТекПравило.ТабличнаяЧасть) Тогда
						ТекСтрокаДерева.Группировка = ТекПравило.ТабличнаяЧасть;
					ИначеЕсли ЗначениеЗаполнено(ТекПравило.ПолеОбъекта) И Найти(ТекПравило.ПолеОбъекта, ".") = 0 Тогда
						ТекСтрокаДерева.Группировка = "Объект";
					КонецЕсли;
					
					Если Индекс = МаксИндекс Тогда
						
						ТекСтрокаДерева.ПолноеИмяПоля 		= ТекПравило.ПолеФайлаПередачи;
						ТекСтрокаДерева.ПолеОбъекта 		= ТекПравило.ПолеОбъекта;
						ТекСтрокаДерева.ПорядокЗаполнения	= ТекПравило.ПорядокЗаполнения;
						ТекСтрокаДерева.ТабличнаяЧасть 		= ТекПравило.ТабличнаяЧасть;
						ТекСтрокаДерева.ДопДействия 		= ТекПравило.ДопДействия;
						ТекСтрокаДерева.Условие		 		= ТекПравило.Условие;
						ТекСтрокаДерева.КонечныйЭлемент		= Истина;
						
					КонецЕсли;
					
				КонецЕсли;
				
				КоллекцияСтрокДерева = ТекСтрокаДерева.Строки;
				
			КонецЦикла; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбозначитьЛистьяДерева(ДеревоСтруктуры);
	ОбозначитьГруппировкиВДереве(ДеревоСтруктуры);
		
	// для каждого поля зададим имя поля таблицы и сразу создадим структуру таблицы
	ТаблицаДанных                = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("КонечныйЭлемент");
	СчетчикКолонок               = 1;
	ЗаполнитьИменаПолейДереваСтруктуры(ДеревоСтруктуры, ТаблицаДанных, СчетчикКолонок);
	
	ЧтениеXML 			         = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM    = ПостроительDOM.Прочитать(ЧтениеXML);

	ПутьПравилаОбработки         = "";
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	СоответствиеИндексов          = Новый Соответствие;
	
	Пока ЧтениеXML.Прочитать() Цикл
		// Обработка узла XML           	
		Если ЧтениеXML.ТипУзла   = ТипУзлаXML.НачалоЭлемента Тогда
			
			ИмяПоля              = ЧтениеXML.Имя;		
			ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ИмяПоля;
			
			ТекСтрока            = ДеревоСтруктуры.Строки.Найти(ПутьПравилаОбработки, "ПолноеИмяПоля",Истина);
			Если ТекСтрока <> Неопределено Тогда
				
				//Индекс = ПолучитьИндекс(ИмяПоля, СоответствиеИндексов);
				
				Если (ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[0].ДочерниеУзлы.Количество()> 0) И 
					 (ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[0].ДочерниеУзлы[0].ИмяУзла) <> "#text" Тогда
					СтрокаДанных     = ТаблицаДанных.Добавить();
				КонецЕсли;
				
				Для каждого ПоляСтроки Из ТекСтрока.Строки Цикл
					
					СтрокаДанных.КонечныйЭлемент = ПоляСтроки.КонечныйЭлемент;
					
					Если ПоляСтроки.Строки.Количество() = 0 Тогда					
						Если Лев(ПоляСтроки.ИмяПоля, 1) = "@" Тогда
							// добавитьСтроку
							СтрокаДанных[ПоляСтроки.ИмяПоляТаблицы] = ЧтениеXML.ПолучитьАтрибут(Сред(ПоляСтроки.ИмяПоля, 2));
						Иначе
							Индекс                                  = ПолучитьИндекс(ПоляСтроки.ИмяПоля, СоответствиеИндексов);
							Если ДокументDOM.ПолучитьЭлементыПоИмени(ПоляСтроки.ИмяПоля).Количество() > Индекс Тогда
								СтрокаДанных[ПоляСтроки.ИмяПоляТаблицы] = ДокументDOM.ПолучитьЭлементыПоИмени(ПоляСтроки.ИмяПоля)[Индекс].ТекстовоеСодержимое;
							Иначе
								СтрокаДанных[ПоляСтроки.ИмяПоляТаблицы] = "";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла; 
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла  = ТипУзлаXML.КонецЭлемента Тогда 			
			ПутьПравилаОбработки     = Лев(ПутьПравилаОбработки, СтрДлина(ПутьПравилаОбработки) - (СтрДлина(ЧтениеXML.Имя)+1));
		КонецЕсли;
		
	КонецЦикла;
			
	МассивИменСтрок                  = Новый Массив;
	МассивИменСтрок.Добавить("/ProcessRegPayOrder/DataArea/Header/Report/GUID_FK");
	
	МассивИменПолейТД                = Новый Массив;
	
	Для Каждого ЭлМас Из МассивИменСтрок Цикл
		ТекСтрока                    = ДеревоСтруктуры.Строки.Найти(ЭлМас, "ПолноеИмяПоля",Истина);
		Если ТекСтрока <> Неопределено Тогда
			МассивИменПолейТД.Добавить(ТекСтрока.ИмяПоляТаблицы);	
		КонецЕсли;
	КонецЦикла;
	
	// заполним колонки конечных элементов значениями из вышестоящих неконечных элементов
	СвернутьТаблицуЗначений(ТаблицаДанных, МассивИменПолейТД);
	
	// создание схемы компоновки данных
	СхемаКомпоновкиРезультата         = Новый СхемаКомпоновкиДанных;
	ИсточникДанных                    = СхемаКомпоновкиРезультата.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя                = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных                       = СхемаКомпоновкиРезультата.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя 			      = "НаборДанных1";
	НаборДанных.ИмяОбъекта 		      = "ВходящиеДанные";
	НаборДанных.ИсточникДанных 	      = "ИсточникДанных1";
	
	РазрешенныеМодули                 = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("БИБЛИОТЕКАФУНКЦИЙОБМЕНА");
	СоответствиеГруппировок           = Новый Соответствие;
	СоздатьСтруктуруСхемыКомпоновкиИзДерева(ДеревоСтруктуры, СхемаКомпоновкиРезультата.НастройкиПоУмолчанию, СхемаКомпоновкиРезультата, НаборДанных, РазрешенныеМодули, СоответствиеГруппировок);	
	
	ВнешниеНаборы                     = Новый Структура("ВходящиеДанные", ТаблицаДанных);
	ФорматЗагрузки                    = Формат;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "КассовыйОрган";
	Параметр.Значение                 = Задание.КассовыйОрган;
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "Организация";
	Параметр.Значение                 = Задание.Организация;
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "ВалютаРеглУчета";
	Параметр.Значение                 = Константы.ВалютаРегламентированногоУчета.Получить();
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	НастройкиКомпоновки               = СхемаКомпоновкиРезультата.НастройкиПоУмолчанию;
	
	КомпоновщикМакета                 = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки                   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиРезультата, НастройкиКомпоновки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); 
	ПроцессорКомпоновки               = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы,,Истина);
	ПроцессорВывода                   = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	РезультатВыполнения               = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	СокращенноеДеревоСтруктуры        = Новый ДеревоЗначений;
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Группировка", Новый ОписаниеТипов("Строка"));
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Поля", Новый ОписаниеТипов("Массив"));
	
	СократитьДерево(ДеревоСтруктуры, СокращенноеДеревоСтруктуры, СоответствиеГруппировок); 
	
	ПараметрыВызоваФункции = Новый Структура;
	
	Для каждого СтрокаДокумента Из РезультатВыполнения.Строки[0].Строки Цикл
		
		СтрокаГруппировки             = СокращенноеДеревоСтруктуры.Строки[0];
		
		// выделяем объект для импорта
		СохраненныйДокумент           = БиблиотекаФункцийОбмена.НайтиДокументПоGUID(Формат.ИдентификаторОбъекта.Имя, СтрокаДокумента.СостояниеПлатежноРасчетныхДокументовGUIDКО);
		
		Если НЕ ЗначениеЗаполнено(СохраненныйДокумент) Тогда  
			
			СтрокаОписания = ОписаниеОбъектаОшибки.Добавить();
			СтрокаОписания.ПолеФайла = НСтр("ru='Не найден документ для расшифровки'"); 
			СтрокаОписания.Ошибка    = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
			                                                        НСтр("ru='Отсутсвует документ для обработки с GUID: [GUID]'"),
																	Новый Структура("GUID", Строка(СтрокаДокумента.СостояниеПлатежноРасчетныхДокументовGUIDКО))
																	);
			ВставитьОшибкуВДокумент(Задание, ЗначениеВСтрокуВнутр(ОписаниеОбъектаОшибки), Задание.ФайлыОбмена.Найти(ИмяФайла, "ИмяФайлаЗагрузки").НомерСтроки);
			
			Возврат;
			
		Иначе
			ДокументОбъект            = СохраненныйДокумент.ПолучитьОбъект();
			//Если БиблиотекаФункцийОбмена.ПолучитьСтатусДокумента(ДокументОбъект.Ссылка) <> Перечисления.СтатусыИсполненияДокумента.ВРаботе Тогда
			//	ВызватьИсключение НСтр("ru='Документ с таким же номером был обработан ранее (его статус отличен от статуса <<в работе>>) '") + СохраненныйДокумент;
			//КонецЕсли;	
			Попытка
				ЗаблокироватьДанныеДляРедактирования(ДокументОбъект.Ссылка);
			Исключение
				ВызватьИсключение НСтр("ru='Невозможно заблокировать для редактирования документ '") + СохраненныйДокумент;
			КонецПопытки;
			
			Если ДокументОбъект.РасшифровкаПлатежа.Количество() > 0 Тогда
				
				 КБКНазначениеПлатежа   =  ДокументОбъект.РасшифровкаПлатежа[0].КБКНазначениеПлатежа;
				 КОСГУНазначениеПлатежа =  ДокументОбъект.РасшифровкаПлатежа[0].КОСГУНазначениеПлатежа;
				 ИсточникСредств        =  ДокументОбъект.РасшифровкаПлатежа[0].ИсточникСредств; 
				 
			КонецЕсли;
			
			ДокументОбъект.РасшифровкаПлатежа.Очистить();
		КонецЕсли;
		
		// запись реквизитов шапки документа
		СтрокаРеквизитов              = "";
		
		Для каждого ТекПоле Из СтрокаГруппировки.Поля Цикл
			Если (Найти(ВРЕГ(ТекПоле), "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ") = 0) И (Найти(ВРЕГ(ТекПоле), "СОСТОЯНИЕПЛАТЕЖНОРАСЧЕТНЫХДОКУМЕНТОВ") = 0) Тогда
				СтрокаРеквизитов          = СтрокаРеквизитов + "," +ТекПоле;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаРеквизитов              = Сред(СтрокаРеквизитов, 2);
		ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаДокумента, СтрокаРеквизитов);
		ЗаполнитьЗначенияСвойств(ДокументОбъект, Задание, "Организация");
		
		
		// обработка реквизитов табличных частей
		Для каждого ВложеннаяГруппировка Из СтрокаГруппировки.Строки[0].Строки Цикл
			
			СтрокаРеквизитов          = "";
			СтрокаРеквизитовПП        = "";   // ревизиты произвольных параметров
			СтрокаРеквизитовСР        = "";   // реквизиты состояния РП документов
			
			Для каждого ТекПоле Из ВложеннаяГруппировка.Поля Цикл
				
				Если (Найти(ВРЕГ(ТекПоле), "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ") = 0) И (Найти(ВРЕГ(ТекПоле), "СОСТОЯНИЕПЛАТЕЖНОРАСЧЕТНЫХДОКУМЕНТОВ") = 0) Тогда
				
					Если Лев(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 1) = ВложеннаяГруппировка.Группировка + "." Тогда
						СтрокаРеквизитов  = СтрокаРеквизитов + "," +Сред(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 2);	
					Иначе
						СтрокаРеквизитов  = СтрокаРеквизитов + "," +ТекПоле;
					КонецЕсли;
					
				ИначеЕсли  Найти(ВРЕГ(ТекПоле), "СОСТОЯНИЕПЛАТЕЖНОРАСЧЕТНЫХДОКУМЕНТОВ") = 0 Тогда
					
					СтрокаРеквизитовПП  = СтрокаРеквизитовПП + "," +ТекПоле;
					
				Иначе
					
					СтрокаРеквизитовСР  = СтрокаРеквизитовСР + "," +ТекПоле;
				
				КонецЕсли;
				
			КонецЦикла;	
							
			// в СтрокаРеквизитов только имена табличной части
			
			Для каждого ВложеннаяСтрока Из СтрокаДокумента.Строки Цикл
				
								
				Если ВложеннаяГруппировка.Группировка  =  "РасшифровкаПлатежа" Тогда
					
												
					ЕстьЗаполненные       = Ложь;
					СтруктураПроверки     = Новый Структура(СтрокаРеквизитов);
					
					Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
						СтруктураПроверки[ЗначениеПроверки.Ключ]          = ВложеннаяСтрока[ВложеннаяГруппировка.Группировка+ЗначениеПроверки.Ключ];	
						ЕстьЗаполненные                                   = Макс(ЕстьЗаполненные, ЗначениеЗаполнено(СтруктураПроверки[ЗначениеПроверки.Ключ]));
					КонецЦикла;
					
					
					Если ЕстьЗаполненные Тогда
						
						ЗаполнитьЗначенияСвойств(ДокументОбъект[ВложеннаяГруппировка.Группировка].Добавить(), СтруктураПроверки);
						
						ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].КБКНазначениеПлатежа   = КБКНазначениеПлатежа;
						ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].КОСГУНазначениеПлатежа = КОСГУНазначениеПлатежа;
						ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].ИсточникСредств        = ИсточникСредств;
						ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].Сумма                  = ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].СуммаВал;
						
						ПараметрыВызоваФункции.Вставить("ИННПлательщика",           "");
						ПараметрыВызоваФункции.Вставить("КПППлательщика",           "");
						ПараметрыВызоваФункции.Вставить("ФИОПлательщика",           "");
						ПараметрыВызоваФункции.Вставить("НаименованиеПлательщика",  "");
						
						СтруктураПроверки                             = Новый Структура(СтрЗаменить(СтрокаРеквизитовПП, ".", ""));
						
						ЗаполнитьЗначенияСвойств(СтруктураПроверки, ВложеннаяСтрока);
						
						Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
							Если ВРЕГ(Лев(ЗначениеПроверки.Ключ, 39)) = "РАСШИФРОВКАПЛАТЕЖАПРОИЗВОЛЬНЫЕПАРАМЕТРЫ" Тогда
								ПараметрыВызоваФункции.Вставить(Сред(ЗначениеПроверки.Ключ, 40), ЗначениеПроверки.Значение);
							КонецЕсли;
						КонецЦикла; 
						
						Если НЕ ЗначениеЗаполнено(ПараметрыВызоваФункции.ФИОПлательщика) И СтрНайти(ПараметрыВызоваФункции.НаименованиеПлательщика, "//") > 0 Тогда
						// признаки оформления наименования для физлица при отсутствии другой информации из банка
						
						Массив                           = Новый Массив;
						Массив.Добавить("СокращатьНаименованиеПлательщика");
						ДанныеПараметров                 = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(Массив, Задание.НастройкаОбмена);
						СокращатьНаименованиеПлательщика = ДанныеПараметров.Получить("СокращатьНаименованиеПлательщика");
						СокращатьНаименованиеПлательщика = ?(СокращатьНаименованиеПлательщика = Неопределено, Ложь, СокращатьНаименованиеПлательщика);
						
							Если СокращатьНаименованиеПлательщика Тогда
								ПредполагаемоеФИО = СокрЛП(Сред(ПараметрыВызоваФункции.НаименованиеПлательщика, СтрНайти(ПараметрыВызоваФункции.НаименованиеПлательщика, "//") + 2));
								Если СтрНайти(ПредполагаемоеФИО, "//") > 0 Тогда
									ПредполагаемоеФИО = СокрЛП(Лев(ПредполагаемоеФИО, СтрНайти(ПредполагаемоеФИО, "//") - 1));  
								КонецЕсли;
								
								ПараметрыВызоваФункции.ФИОПлательщика = ТРег(ПредполагаемоеФИО);
							КонецЕсли;
						
						КонецЕсли;

						ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].Контрагент = 
						               БиблиотекаФункцийОбмена.ОпределитьКонтрагента(ПараметрыВызоваФункции.ИННПлательщика, 
									   ПараметрыВызоваФункции.КПППлательщика, ПараметрыВызоваФункции.НаименованиеПлательщика,
									   ПараметрыВызоваФункции.ФИОПлательщика,, ВидОбмена, ДанныеНовыхКонтрагентов);
									   
					    Если НЕ ЗначениеЗаполнено(ДокументОбъект.РасшифровкаПлатежа[ДокументОбъект.РасшифровкаПлатежа.Количество() - 1].Контрагент) И ТипЗнч(ДанныеНовыхКонтрагентов) = Тип("ТаблицаЗначений") Тогда
							
							Если ДанныеНовыхКонтрагентов.Количество() > 0 И НЕ ЗначениеЗаполнено(ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество() - 1].ДокументСсылка) Тогда
								
								 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ДокументСсылка     = ДокументОбъект.Ссылка;
								 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ИмяТабличнойЧасти  = "РасшифровкаПлатежа";
								 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].НомерСтроки        = ДокументОбъект.РасшифровкаПлатежа.Количество() - 1;
								 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ИмяРеквизита       = "Контрагент";
								 
							КонецЕсли;
							 
						КонецЕсли;
			           						
					КонецЕсли;

                КонецЕсли;	
								
			КонецЦикла; 
				
		КонецЦикла; 
		
				
		Если  ДокументОбъект.Модифицированность() Тогда					
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);	
		КонецЕсли;			
		
		Если Задание.ОбъектыОбмена.Найти(ДокументОбъект.Ссылка) = Неопределено Тогда   
			
			НовСтрокаЗадания                    = Задание.ОбъектыОбмена.Добавить();
			НовСтрокаЗадания.ИмяФайлаЗагрузки	= ИмяФайла;
			НовСтрокаЗадания.Формат				= Формат;
			НовСтрокаЗадания.Объект				= ДокументОбъект.Ссылка;     
			
		КонецЕсли;
		//-------------------------------------
		
    КонецЦикла;
	
	
КонецПроцедуры

Процедура ЗагрузитьИзФайлаXML2(ТекстФайла, Формат, Задание, ИмяФайла, ДанныеНовыхКонтрагентов)
	
		
	ПравилаЗагрузки = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(Формат);
	
	
	СоответствиеКолонок                                   = Новый Соответствие;
	ДеревоСтруктуры                                       = Новый ДеревоЗначений;
	
	ДеревоСтруктуры.Колонки.Добавить("ИмяПоля",				Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПолноеИмяПоля",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ИмяПоляТаблицы",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПорядокЗаполнения", 	Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ПолеОбъекта",			Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ТабличнаяЧасть",		Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("ДопДействия",			Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("Условие",				Новый ОписаниеТипов("Строка"));
	ДеревоСтруктуры.Колонки.Добавить("КонечныйЭлемент", 	Новый ОписаниеТипов("Булево"));
	ДеревоСтруктуры.Колонки.Добавить("Группировка",			Новый ОписаниеТипов("Строка"));
	
	Для каждого ТекПравило Из ПравилаЗагрузки Цикл
		// если поле объекта не задано, то мы не учитываем узел
		Если ЗначениеЗаполнено(ТекПравило.ПолеОбъекта) Тогда
			
			КоллекцияСтрокДерева = ДеревоСтруктуры.Строки;
			ЧастиИмени           = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекПравило.ПолеФайлаПередачи, "/");
			МаксИндекс           = ЧастиИмени.ВГраница();
			
			Для Индекс           = 0 По МаксИндекс Цикл
				ЧастьИмени       = ЧастиИмени[Индекс];
				
				Если ПустаяСтрока(ЧастьИмени) Тогда
					Продолжить;
				КонецЕсли;
				
				ТекСтрокаДерева                     = КоллекцияСтрокДерева.Найти(ЧастьИмени, "ИмяПоля");
				
				Если ТекСтрокаДерева = Неопределено Тогда
					
					ТекСтрокаДерева                 = КоллекцияСтрокДерева.Добавить();
					ТекСтрокаДерева.ИмяПоля         = ЧастьИмени;
					
					Если ЗначениеЗаполнено(ТекПравило.ТабличнаяЧасть) Тогда
						ТекСтрокаДерева.Группировка = ТекПравило.ТабличнаяЧасть;
					ИначеЕсли ЗначениеЗаполнено(ТекПравило.ПолеОбъекта) И Найти(ТекПравило.ПолеОбъекта, ".") = 0 Тогда
						ТекСтрокаДерева.Группировка = "Объект";
					КонецЕсли;
					
					Если Индекс = МаксИндекс Тогда
						
						ТекСтрокаДерева.ПолноеИмяПоля 		= ТекПравило.ПолеФайлаПередачи;
						ТекСтрокаДерева.ПолеОбъекта 		= ТекПравило.ПолеОбъекта;
						ТекСтрокаДерева.ПорядокЗаполнения	= ТекПравило.ПорядокЗаполнения;
						ТекСтрокаДерева.ТабличнаяЧасть 		= ТекПравило.ТабличнаяЧасть;
						ТекСтрокаДерева.ДопДействия 		= ТекПравило.ДопДействия;
						ТекСтрокаДерева.Условие		 		= ТекПравило.Условие;
						ТекСтрокаДерева.КонечныйЭлемент		= Истина;
						
					КонецЕсли;
					
				КонецЕсли;
				
				КоллекцияСтрокДерева = ТекСтрокаДерева.Строки;
				
			КонецЦикла; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбозначитьЛистьяДерева(ДеревоСтруктуры);
	ОбозначитьГруппировкиВДереве(ДеревоСтруктуры);
	
	// получили дерево вида
	//		ИмяПоляТаблицы			ПолноеИмяПоля								КонечныйЭлемент		   								
	//	PacketESID					/PacketESID                                 Ложь
	//		ED211                   /PacketESID/ED211                           Ложь
	//			@EDNo				/PacketESID/ED211/@EDNo                     Ложь
	// 			@OutBal            	/PacketESID/ED211/@OutBal                   Ложь
	//      	TransInfo           /PacketESID/ED211/TransInfo                 Ложь
	//				@DC				/PacketESID/ED211/TransInfo/@DC	            Ложь
	//				@Sum			/PacketESID/ED211/TransInfo/@Sum            Ложь
	//				EDRefID         /PacketESID/ED211/TransInfo/EDRefID         Ложь
	//					@EDNo		/PacketESID/ED211/TransInfo/EDRefID/@EDNo	Истина	
	// некоторые узлы (PacketESID) используются в файле только для группировки и не содержат сами никаких данных.
	// для таких узлов добавим поле для группировки
	
	// для каждого поля зададим имя поля таблицы и сразу создадим структуру таблицы
	ТаблицаДанных                = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("КонечныйЭлемент");        
	
	СчетчикКолонок               = 1;
	ЗаполнитьИменаПолейДереваСтруктуры(ДеревоСтруктуры, ТаблицаДанных, СчетчикКолонок);
	
	ЧтениеXML 			         = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);

	ПутьПравилаОбработки         = "";    
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM    = ПостроительDOM.Прочитать(ЧтениеXML);

	ПутьПравилаОбработки         = "";
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	СоответствиеИндексов          = Новый Соответствие;
	
	Пока ЧтениеXML.Прочитать() Цикл
		// Обработка узла XML           	
		Если ЧтениеXML.ТипУзла   = ТипУзлаXML.НачалоЭлемента Тогда
			
			ИмяПоля              = ЧтениеXML.ЛокальноеИмя;		
			ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ИмяПоля;
			
			ТекСтрока            = ДеревоСтруктуры.Строки.Найти(ПутьПравилаОбработки, "ПолноеИмяПоля",Истина);
			Если ТекСтрока <> Неопределено Тогда
				
				//Индекс = ПолучитьИндекс(ИмяПоля, СоответствиеИндексов);
				
				Если (ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[0].ДочерниеУзлы.Количество()> 0) И 
					 (ДокументDOM.ПолучитьЭлементыПоИмени(ИмяПоля)[0].ДочерниеУзлы[0].ИмяУзла) <> "#text" Тогда
					СтрокаДанных     = ТаблицаДанных.Добавить();
				КонецЕсли;
				
				Для каждого ПоляСтроки Из ТекСтрока.Строки Цикл
					
					СтрокаДанных.КонечныйЭлемент = ПоляСтроки.КонечныйЭлемент;  
					
					Если ПоляСтроки.Строки.Количество() = 0 Тогда					
						Если Лев(ПоляСтроки.ИмяПоля, 1) = "@" Тогда
							// добавитьСтроку
							СтрокаДанных[ПоляСтроки.ИмяПоляТаблицы] = ЧтениеXML.ПолучитьАтрибут(Сред(ПоляСтроки.ИмяПоля, 2));
						Иначе
							Индекс                                  = ПолучитьИндекс(ПоляСтроки.ИмяПоля, СоответствиеИндексов);
							Если ДокументDOM.ПолучитьЭлементыПоИмени(ПоляСтроки.ИмяПоля).Количество() > Индекс Тогда
								СтрокаДанных[ПоляСтроки.ИмяПоляТаблицы] = ДокументDOM.ПолучитьЭлементыПоИмени(ПоляСтроки.ИмяПоля)[Индекс].ТекстовоеСодержимое;
							Иначе
								СтрокаДанных[ПоляСтроки.ИмяПоляТаблицы] = "";
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла; 
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла  = ТипУзлаXML.КонецЭлемента Тогда 			
			ПутьПравилаОбработки     = Лев(ПутьПравилаОбработки, СтрДлина(ПутьПравилаОбработки) - (СтрДлина(ЧтениеXML.ЛокальноеИмя)+1));
		КонецЕсли;
		
	КонецЦикла;
	
	//Пока ЧтениеXML.Прочитать() Цикл
	//	// Обработка узла XML           	
	//	Если ЧтениеXML.ТипУзла   = ТипУзлаXML.НачалоЭлемента Тогда
	//		ИмяПоля              = ЧтениеXML.ЛокальноеИмя;		
	//		ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ИмяПоля;
	//		
	//		ТекСтрока            = ДеревоСтруктуры.Строки.Найти(ПутьПравилаОбработки, "ПолноеИмяПоля",Истина);
	//		Если ТекСтрока <> Неопределено Тогда 
	//							
	//			СтрокаДанных     = ТаблицаДанных.Добавить();
	//			
	//			Для каждого ПоляСтроки Из ТекСтрока.Строки Цикл
	//				СтрокаДанных.КонечныйЭлемент        = ПоляСтроки.КонечныйЭлемент;
	//			//	Если ПоляСтроки.Строки.Количество() = 0 Тогда					
	//					Если Лев(ПоляСтроки.ИмяПоля, 1) = "@" Тогда
	//						// добавитьСтроку
	//						СтрокаДанных[ПоляСтроки.ИмяПоляТаблицы] = ЧтениеXML.ПолучитьАтрибут(Сред(ПоляСтроки.ИмяПоля, 2));
	//					КонецЕсли;
	//			//	КонецЕсли;
	//			КонецЦикла; 
	//		КонецЕсли;
	//	ИначеЕсли ЧтениеXML.ТипУзла  = ТипУзлаXML.КонецЭлемента Тогда 	
	//		ПутьПравилаОбработки     = Лев(ПутьПравилаОбработки, СтрДлина(ПутьПравилаОбработки) - (СтрДлина(ЧтениеXML.ЛокальноеИмя)+1));			
	//	КонецЕсли;
	//	
	//КонецЦикла;
	
	МассивИменСтрок                  = Новый Массив;
	МассивИменСтрок.Добавить("/PacketESID/ED211/@EDNo");
	МассивИменСтрок.Добавить("/ED211/@EDNo");
	
	МассивИменПолейТД                = Новый Массив;
	
	Для Каждого ЭлМас Из МассивИменСтрок Цикл
		ТекСтрока                    = ДеревоСтруктуры.Строки.Найти(ЭлМас, "ПолноеИмяПоля",Истина);
		Если ТекСтрока <> Неопределено Тогда
			МассивИменПолейТД.Добавить(ТекСтрока.ИмяПоляТаблицы);	
		КонецЕсли;
	КонецЦикла;	
	
	Если Формат.ИдентификаторОбъекта.Имя = "КассовоеПоступление" Тогда 
		Для к = 1 по ТаблицаДанных.Количество()-1 Цикл
			
			Если ТаблицаДанных[к].КонечныйЭлемент И ТаблицаДанных[к - 1].КонечныйЭлемент Тогда
				 ТаблицаДанных[к - 1].КонечныйЭлемент = Ложь;
			КонецЕсли;
			
		КонецЦикла; 
	КонецЕсли;
	
	// заполним колонки конечных элементов значениями из вышестоящих неконечных элементов
	СвернутьТаблицуЗначений(ТаблицаДанных, МассивИменПолейТД);
	
	// создание схемы компоновки данных
	СхемаКомпоновкиРезультата         = Новый СхемаКомпоновкиДанных;
	ИсточникДанных                    = СхемаКомпоновкиРезультата.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя                = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных                       = СхемаКомпоновкиРезультата.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя 			      = "НаборДанных1";
	НаборДанных.ИмяОбъекта 		      = "ВходящиеДанные";
	НаборДанных.ИсточникДанных 	      = "ИсточникДанных1";
	
	РазрешенныеМодули                 = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("БИБЛИОТЕКАФУНКЦИЙОБМЕНА");
	СоответствиеГруппировок           = Новый Соответствие;
	СоздатьСтруктуруСхемыКомпоновкиИзДерева(ДеревоСтруктуры, СхемаКомпоновкиРезультата.НастройкиПоУмолчанию, СхемаКомпоновкиРезультата, НаборДанных, РазрешенныеМодули, СоответствиеГруппировок);	
	
	ВнешниеНаборы                     = Новый Структура("ВходящиеДанные", ТаблицаДанных);
	ФорматЗагрузки                    = Формат;
	
	Параметр                          = СхемаКомпоновкиРезультата.Параметры.Добавить();
	Параметр.Имя                      = "КассовыйОрган";
	Параметр.Значение                 = Задание.КассовыйОрган;
	Параметр.ВключатьВДоступныеПоля   = Ложь;
	Параметр.ОграничениеИспользования = Истина;
	
	НастройкиКомпоновки               = СхемаКомпоновкиРезультата.НастройкиПоУмолчанию;
	
	КомпоновщикМакета                 = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки                   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиРезультата, НастройкиКомпоновки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); 
	ПроцессорКомпоновки               = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы,,Истина);
	ПроцессорВывода                   = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	РезультатВыполнения               = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	СокращенноеДеревоСтруктуры        = Новый ДеревоЗначений;
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Группировка", Новый ОписаниеТипов("Строка"));
	СокращенноеДеревоСтруктуры.Колонки.Добавить("Поля", Новый ОписаниеТипов("Массив"));
	
	СократитьДерево(ДеревоСтруктуры, СокращенноеДеревоСтруктуры, СоответствиеГруппировок);  
	
	Для каждого СтрокаРезультата Из РезультатВыполнения.Строки Цикл  
		
		Если Формат.ИдентификаторОбъекта.Имя = "" Тогда   
			Продолжить;   
			
		ИначеЕсли Формат.ИдентификаторОбъекта.Имя = "ПлатежноеПоручение" Тогда	
			
			ДокументОбъект     = Документы.ПлатежноеПоручение.ПустаяСсылка();
			
			СтрокаГруппировки  = СокращенноеДеревоСтруктуры.Строки[0];   
			ПечатныйОбраз      = Новый Структура;
			
			СтрокаРеквизитовПО = "";
								
			Для каждого ТекПоле Из СтрокаГруппировки.Поля Цикл
				Если Найти(ВРЕГ(ТекПоле), "ПЕЧАТНЫЙОБРАЗ") <> 0 Тогда
					СтрокаРеквизитовПО  = СтрокаРеквизитовПО + "," + ТекПоле;					
				КонецЕсли;
			КонецЦикла;
			
			СтрокаРеквизитовПО          = Сред(СтрокаРеквизитовПО, 2);			
			СтруктураПроверки           = Новый Структура(СтрЗаменить(СтрокаРеквизитовПО, ".", ""));
					
			ЗаполнитьЗначенияСвойств(СтруктураПроверки, СтрокаРезультата);
			
			Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
				Если ВРЕГ(Лев(ЗначениеПроверки.Ключ, 13)) = "ПЕЧАТНЫЙОБРАЗ" Тогда
					ПечатныйОбраз.Вставить(Сред(ЗначениеПроверки.Ключ, 14), ЗначениеПроверки.Значение);
				КонецЕсли;
			КонецЦикла;    
			
			ДокументОбъект = БиблиотекаФункцийОбмена.ПодобратьППЗаписатьОбразУФЭБС(ПечатныйОбраз, Задание.Ссылка);	
			
		ИначеЕсли Формат.ИдентификаторОбъекта.Имя = "ЗаявкаНаСдачуПолучениеНаличных" Тогда	
			
			ДокументОбъект     = Документы.ЗаявкаНаСдачуПолучениеНаличных.ПустаяСсылка();
			
			СтрокаГруппировки  = СокращенноеДеревоСтруктуры.Строки[0];   
			ПечатныйОбраз      = Новый Структура;
			
			СтрокаРеквизитовПО = "";
								
			Для каждого ТекПоле Из СтрокаГруппировки.Поля Цикл
				Если Найти(ВРЕГ(ТекПоле), "ПЕЧАТНЫЙОБРАЗ") <> 0 Тогда
					СтрокаРеквизитовПО  = СтрокаРеквизитовПО + "," + ТекПоле;					
				КонецЕсли;
			КонецЦикла;
			
			СтрокаРеквизитовПО          = Сред(СтрокаРеквизитовПО, 2);			
			СтруктураПроверки           = Новый Структура(СтрЗаменить(СтрокаРеквизитовПО, ".", ""));
					
			ЗаполнитьЗначенияСвойств(СтруктураПроверки, СтрокаРезультата);
			
			Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
				Если ВРЕГ(Лев(ЗначениеПроверки.Ключ, 13)) = "ПЕЧАТНЫЙОБРАЗ" Тогда
					ПечатныйОбраз.Вставить(Сред(ЗначениеПроверки.Ключ, 14), ЗначениеПроверки.Значение);
				КонецЕсли;
			КонецЦикла;    
			
			ДокументОбъект = БиблиотекаФункцийОбмена.ПодобратьЗаявкуНДЗаписатьОбразУФЭБС(ПечатныйОбраз, Задание.Ссылка);	
		
		ИначеЕсли Формат.ИдентификаторОбъекта.Имя = "КассовоеПоступление" Тогда    
						
			СтрокаГруппировки  = СокращенноеДеревоСтруктуры.Строки[0];   
			ДокументОбъект     = Документы.КассовоеПоступление.ПустаяСсылка();
			ПечатныйОбраз      = Новый Структура;
			
			СтрокаРеквизитовПО = "";
								
			Для каждого ТекПоле Из СтрокаГруппировки.Поля Цикл
				Если Найти(ВРЕГ(ТекПоле), "ПЕЧАТНЫЙОБРАЗ") <> 0 Тогда
					СтрокаРеквизитовПО  = СтрокаРеквизитовПО + "," + ТекПоле;					
				КонецЕсли;
			КонецЦикла;
			
			СтрокаРеквизитовПО          = Сред(СтрокаРеквизитовПО, 2);			
			СтруктураПроверки           = Новый Структура(СтрЗаменить(СтрокаРеквизитовПО, ".", ""));
					
			ЗаполнитьЗначенияСвойств(СтруктураПроверки, СтрокаРезультата);
			
			Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
				Если ВРЕГ(Лев(ЗначениеПроверки.Ключ, 13)) = "ПЕЧАТНЫЙОБРАЗ" Тогда
					ПечатныйОбраз.Вставить(Сред(ЗначениеПроверки.Ключ, 14), ЗначениеПроверки.Значение);
				КонецЕсли;
			КонецЦикла; 
			
			ДокументОбъект = БиблиотекаФункцийОбмена.СоздатьКассовоеПоступлениеНаОснованииПечатногоОбразаПП(ПечатныйОбраз, Задание.Ссылка, ДанныеНовыхКонтрагентов);
			
		ИначеЕсли Формат.ИдентификаторОбъекта.Имя = "ВыпискаИзЛицевогоСчета" Тогда	
			
			СтрокаГруппировки             = СокращенноеДеревоСтруктуры.Строки[0]; 

			// выделяем объект для импорта
			СохраненныйДокумент           = Документы.ВыпискаИзЛицевогоСчета.НайтиПоНомеру(СтрокаРезультата.Номер, СтрокаРезультата.Дата);
			
			Если СохраненныйДокумент.Пустая() Тогда
				ДокументОбъект            = Документы.ВыпискаИзЛицевогоСчета.СоздатьДокумент();
			Иначе
				ДокументОбъект            = СохраненныйДокумент.ПолучитьОбъект();
				Попытка
					ЗаблокироватьДанныеДляРедактирования(ДокументОбъект.Ссылка);
				Исключение
					ВызватьИсключение НСтр("ru='Невозможно заблокировать для редактирования документ '") + СохраненныйДокумент;
				КонецПопытки;
				ДокументОбъект.Остатки.Очистить();
				ДокументОбъект.ДокументыДвижений.Очистить();
			КонецЕсли;
			
			// запись реквизитов шапки документа
			СтрокаРеквизитов              = "";
			
			Для каждого ТекПоле Из СтрокаГруппировки.Поля Цикл
				СтрокаРеквизитов          = СтрокаРеквизитов + "," + ТекПоле;
			КонецЦикла;
			
			СтрокаРеквизитов              = Сред(СтрокаРеквизитов, 2);
			ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаРезультата, СтрокаРеквизитов);
			ЗаполнитьЗначенияСвойств(ДокументОбъект, Задание, "Организация");
			
			Если ДокументОбъект.Ссылка.Пустая() Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
			// обработка реквизитов табличных частей
			Для каждого ВложеннаяГруппировка Из СтрокаГруппировки.Строки Цикл
				
				СтрокаРеквизитов          = "";
				
				Для каждого ТекПоле Из ВложеннаяГруппировка.Поля Цикл
					
					Если Лев(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 1) = ВложеннаяГруппировка.Группировка + "." Тогда
						СтрокаРеквизитов  = СтрокаРеквизитов + "," +Сред(ТекПоле, СтрДлина(ВложеннаяГруппировка.Группировка) + 2);	
					Иначе
						СтрокаРеквизитов  = СтрокаРеквизитов + "," +ТекПоле;
					КонецЕсли;
					
				КонецЦикла;
				
				СтрокаРеквизитов          = Сред(СтрокаРеквизитов, 2);
				
				Если Найти(СтрокаРеквизитов, ".") = 0 Тогда
					
					// в СтрокаРеквизитов только имена табличной части
					СтруктураПроверки     = Новый Структура(СтрокаРеквизитов);
					Для каждого ВложеннаяСтрока Из СтрокаРезультата.Строки Цикл
						
						ЕстьЗаполненные   = Ложь;
						
						Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
							СтруктураПроверки[ЗначениеПроверки.Ключ]          = ВложеннаяСтрока[ВложеннаяГруппировка.Группировка+ЗначениеПроверки.Ключ];	
							ЕстьЗаполненные                                   = Макс(ЕстьЗаполненные, ЗначениеЗаполнено(СтруктураПроверки[ЗначениеПроверки.Ключ]));
						КонецЦикла;
						
						Если ЕстьЗаполненные Тогда
							ЗаполнитьЗначенияСвойств(ДокументОбъект[ВложеннаяГруппировка.Группировка].Добавить(), СтруктураПроверки);
						КонецЕсли;
						
					КонецЦикла; 
					
				Иначе
					
					// в СтрокаРеквизитов есть дополнительные параметры. Требуется выделение параметров и вызов процедуры
					СтруктураПроверки                                         = Новый Структура(СтрЗаменить(СтрокаРеквизитов, ".", ""));	
					
					Для каждого ВложеннаяСтрока Из СтрокаРезультата.Строки Цикл
						
						ЕстьЗаполненные                                       = Ложь;
						ЗаполнитьЗначенияСвойств(СтруктураПроверки, ВложеннаяСтрока);
						
						Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
							ЕстьЗаполненные                                   = Макс(ЕстьЗаполненные, ЗначениеЗаполнено(СтруктураПроверки[ЗначениеПроверки.Ключ]));
							Если ЕстьЗаполненные Тогда
								Прервать;
							КонецЕсли;
						КонецЦикла;
						
						Если ЕстьЗаполненные Тогда
							
							ФункцияЗаполнения                                 = ВложеннаяСтрока["ДокументыДвиженийИсполняющийДокумент"];
						    ИсполняющийДокумент                               = "";	
							
							Если ФункцияЗаполнения                       = "ОпределитьПлатежныйДокумент" Тогда
								
								ПараметрыВызоваФункции                        = Новый Структура;
								
								Для каждого ЗначениеПроверки Из СтруктураПроверки Цикл
									Если ВРЕГ(Лев(ЗначениеПроверки.Ключ, 21)) = "ПРОИЗВОЛЬНЫЕПАРАМЕТРЫ" Тогда
										ПараметрыВызоваФункции.Вставить(Сред(ЗначениеПроверки.Ключ, 22), ЗначениеПроверки.Значение);
									КонецЕсли;
								КонецЦикла; 
								
								ИсполняющийДокумент                           = БиблиотекаФункцийОбмена.ОпределитьПлатежныйДокументУФЭБС(ПараметрыВызоваФункции, ДокументОбъект.Ссылка);							
								
								Если ЗначениеЗаполнено(ИсполняющийДокумент) Тогда

									СостояниеПлатежноРасчетныхДокументов = Новый Структура("ПлатежноРасчетныйДокумент, Статус, ДатаПроведения", ИсполняющийДокумент.Ссылка, 
									                                       Перечисления.СтатусыИсполненияДокумента.Исполнен, ДокументОбъект.ДатаВыписки); 
									ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СостояниеПлатежноРасчетныхДокументов);

								КонецЕсли;				
						
							КонецЕсли;
							
							Если ЗначениеЗаполнено(ИсполняющийДокумент) Тогда
								ДокументОбъект.ДокументыДвижений.Добавить().ИсполняющийДокумент = ИсполняющийДокумент;
							КонецЕсли;	
							
						КонецЕсли;
						
					КонецЦикла; 
				КонецЕсли;
			КонецЦикла; 
			
			// записываем импортированный документ
			Если ДокументОбъект.Модифицированность() Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;  
			
		КонецЕсли;	
						
		Если НЕ (ДокументОбъект.Ссылка.Пустая()) И Задание.ОбъектыОбмена.Найти(ДокументОбъект.Ссылка) = Неопределено Тогда 
			
			НовСтрокаЗадания                    = Задание.ОбъектыОбмена.Добавить();
			НовСтрокаЗадания.ИмяФайлаЗагрузки	= ИмяФайла;
			НовСтрокаЗадания.Формат				= Формат;
			НовСтрокаЗадания.Объект				= ДокументОбъект.Ссылка;  
			
		КонецЕсли;
		//-------------------------------------
	КонецЦикла; 	
	
КонецПроцедуры

///////////////////////////////////////////////////
Процедура ПрочитатьЗначениеПутиПравила(ПараметрыЧтения, ПутьПравила)
	
	СтруктураПоиска = Новый Структура("ПолеФайлаПередачи",ПутьПравила);
	Правила = ПараметрыЧтения.ПравилаОбмена.НайтиСтроки(СтруктураПоиска);
	
	ЧтениеXML = ПараметрыЧтения.ЧтениеXML;
	
	Для Каждого Правило Из Правила Цикл
				
		ТабличнаяЧасть = ПолучитьТабличнуюЧасть(Правило.ТабличнаяЧасть, ПараметрыЧтения.ТабЧасти);
		
		Если (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента) И Найти(Врег(Правило.Условие), ВРег("*НоваяСтрока")) > 0 Тогда
			ТекущаяСтрокаДанных = ПараметрыЧтения.ТаблицаДанных.Добавить();
			ЗаполнитьЗначенияСвойств(ТекущаяСтрокаДанных, ЗначенияСлужебныхПолей(ТабличнаяЧасть, ПараметрыЧтения.НомераОбходовТаблиц, Истина));
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Тогда
			ПрочитатьДополнительныеДействия(ПараметрыЧтения, Правило, ЧтениеXML.Значение);
		КонецЕсли;
	
		Если ЗначениеЗаполнено(Правило.ПолеОбъекта) И ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Тогда
			
			Отбор = ЗначенияСлужебныхПолей(ТабличнаяЧасть, ПараметрыЧтения.НомераОбходовТаблиц);
			СтрокиОтбора = ПараметрыЧтения.ТаблицаДанных.НайтиСтроки(Отбор);
			Если СтрокиОтбора.Количество() > 0 Тогда
				ТекущаяСтрокаДанных = СтрокиОтбора[0];
			Иначе
				ТекущаяСтрокаДанных = ПараметрыЧтения.ТаблицаДанных.Добавить();
				ЗаполнитьЗначенияСвойств(ТекущаяСтрокаДанных, Отбор);
			КонецЕсли;
						
			ИмяПоля = ПолучитьИмяПоля(ПараметрыЧтения.СоответствиеКолонок, Правило, ПараметрыЧтения.ТаблицаДанных);
			
			Если ИмяПоля <> Неопределено И ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
				ТекущаяСтрокаДанных[ИмяПоля] = ЧтениеXML.Значение;
			КонецЕсли;
		
			Правило.Отключить = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТабличнуюЧасть(Знач ТабличнаяЧасть, ТабЧасти)
	
	Для Каждого ИмяТабЧасти Из ТабЧасти Цикл
		ТабличнаяЧасть = СтрЗаменить(ТабличнаяЧасть, "[" + ИмяТабЧасти.Ключ + "]", ИмяТабЧасти.Значение);
	КонецЦикла;
	
	Возврат ВРег(ТабличнаяЧасть);
	
КонецФункции

Процедура ПрочитатьДополнительныеДействия(ПараметрыЧтения, Правило, ЗначениеXML)
		
	Если Не ПустаяСтрока(Правило.ДопДействия) Тогда
		
		ДопДействия = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Правило.ДопДействия, ";");
		Для Каждого ТекДопДействие Из ДопДействия Цикл
			Если Не ПустаяСтрока(ТекДопДействие) Тогда					
				
				ЧастиРавенства = РазобратьРавенство(ТекДопДействие);
				Если ЧастиРавенства.Количество() = 2 Тогда
					
					Если Найти(Врег(Правило.Условие), ВРег("*УсловиеТЧ")) > 0 Тогда
						
						Значение = ПолучитьЗначениеПоСтроковомуПредставлению(ЧастиРавенства[1], ЗначениеXML);
						ПараметрыЧтения.ТабЧасти.Вставить(ЧастиРавенства[0], Значение);
						
					Иначе
						
						ТабличнаяЧасть = ПолучитьТабличнуюЧасть(Правило.ТабличнаяЧасть, ПараметрыЧтения.ТабЧасти);
						
						Отбор = ЗначенияСлужебныхПолей(ТабличнаяЧасть, ПараметрыЧтения.НомераОбходовТаблиц);
						СтрокиОтбора = ПараметрыЧтения.ТаблицаДанных.НайтиСтроки(Отбор);
						Если СтрокиОтбора.Количество() > 0 Тогда
							ТекущаяСтрокаДанных = СтрокиОтбора[0];
						Иначе
							ТекущаяСтрокаДанных = ПараметрыЧтения.ТаблицаДанных.Добавить();
							ЗаполнитьЗначенияСвойств(ТекущаяСтрокаДанных, Отбор);
						КонецЕсли;
						
						ИмяПоля = СтрЗаменить(ЧастиРавенства[0], ".", "_");
						Если ПараметрыЧтения.ТаблицаДанных.Колонки.Найти(ИмяПоля) = Неопределено Тогда
							ПараметрыЧтения.ТаблицаДанных.Колонки.Добавить(ИмяПоля);
						КонецЕсли;
						
						Если ПараметрыЧтения.КолонкиТаблицы.Найти(ИмяПоля) = Неопределено Тогда
							ПараметрыЧтения.КолонкиТаблицы.Добавить(ИмяПоля);
						КонецЕсли;
						
						Значение = ПолучитьЗначениеПоСтроковомуПредставлению(ЧастиРавенства[1], ЗначениеXML);
						
						ТекущаяСтрокаДанных[ИмяПоля] = Значение;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;	
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьЗначениеПоСтроковомуПредставлению(Представление, Параметр = Неопределено)
	
	Запрос = Новый Запрос("ВЫБРАТЬ " + Представление + " КАК Результат");
	
	Если Параметр <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(ВРег(Запрос.Текст), "ЗНАЧЕНИЕ", "&ЗНАЧЕНИЕ");
		Запрос.УстановитьПараметр("Значение", Параметр);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Результат;	
	
КонецФункции

Функция ПолучитьИмяПоля(ТаблицаКолонок, Правило, ТаблицаДанных = Неопределено)
	
	Если СокрЛП(Правило.ПолеОбъекта) = "" Тогда
		ИмяПоля = Неопределено;
		
	Иначе
		
		Отбор = Новый Структура("ПутьПравила,ИмяКолонки", Правило.ПолеФайлаПередачи, Правило.ПолеОбъекта);
		Результат = ТаблицаКолонок.НайтиСтроки(Отбор);
		
		Если Результат.Количество() > 0 Тогда
			ИмяПоля = Результат[0].ИмяПоля;
		Иначе
			ИмяПоля = ?(ЗначениеЗаполнено(Правило.ПорядокЗаполнения), "Поле" + Формат(ТаблицаКолонок.Количество() + 1,"ЧГ="), СтрЗаменить(Правило.ПолеОбъекта, ".", "_"));
					
			НовоеПоле = ТаблицаКолонок.Добавить();
			НовоеПоле.ПутьПравила = Отбор.ПутьПравила;
			НовоеПоле.ИмяКолонки = Отбор.ИмяКолонки;
			НовоеПоле.ИмяПоля = ИмяПоля;
			Если ТаблицаДанных <> Неопределено Тогда
				Если ТаблицаДанных.Колонки.Найти(ИмяПоля) = Неопределено Тогда
					ТаблицаДанных.Колонки.Добавить(ИмяПоля);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат ИмяПоля;	
	
КонецФункции

Функция ПолучитьДанныеИмпортаПоСхемеФормата(ПравилаЗагрузки, ТаблицаДанных, СоответствиеКолонок, ПоляГруппировки, ЗаданиеСсылка)
	
	СхемаКомпоновкиРезультата = Новый СхемаКомпоновкиДанных;
	
	ТаблицаДанных.Колонки.Добавить("СлужебноеПоле_ПолеСвязи");
	ТаблицаДанных.ЗаполнитьЗначения(Истина, "СлужебноеПоле_ПолеСвязи"); 
	ВнешниеНаборы = Новый Структура("ВходящиеДанные", ТаблицаДанных);
	
	ВычисляемыеПоля = Новый ТаблицаЗначений;
	ВычисляемыеПоля.Колонки.Добавить("Путь");
	ВычисляемыеПоля.Колонки.Добавить("Выражение");	
	
	БюджетнаяОтчетность.ДобавитьТаблицуЗначенийВНаборыДанныхСхемыКомпоновкиДанных(СхемаКомпоновкиРезультата, ТаблицаДанных, "ВходящиеДанные");
	
	Для Каждого ТекПравилоЗагрузки Из ПравилаЗагрузки Цикл
		Если ЗначениеЗаполнено(ТекПравилоЗагрузки.ПолеОбъекта) И Не ТекПравилоЗагрузки.Отключить Тогда
			
			ВычПоле = ВычисляемыеПоля.Добавить();		
			ВычПоле.Путь = СтрЗаменить(ТекПравилоЗагрузки.ПолеОбъекта, ".", "_");
			
			ВыражениеВычисляемогоПоля = ПолучитьИмяПоля(СоответствиеКолонок, ТекПравилоЗагрузки);
			
			Если ЗначениеЗаполнено(ТекПравилоЗагрузки.ПорядокЗаполнения) Тогда
				ВыражениеВычисляемогоПоля = ПодставитьФормулуВместоЗначения(ТекПравилоЗагрузки.ПорядокЗаполнения, ВыражениеВычисляемогоПоля);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекПравилоЗагрузки.ПравилоФорматированияИмпорт) Тогда
				ВыражениеВычисляемогоПоля = ПодставитьФормулуВместоЗначения(ТекПравилоЗагрузки.ПравилоФорматированияИмпорт, ВыражениеВычисляемогоПоля);	
			КонецЕсли;	
			
			//ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновкиРезультата, ПутьКДаннымВычисляемогоПоля, ВыражениеВычисляемогоПоля);			
			//
			//Если ПоляГруппировки.Найти(ПутьКДаннымВычисляемогоПоля) = Неопределено Тогда
			//	ПоляГруппировки.Добавить(ПутьКДаннымВычисляемогоПоля);
			//КонецЕсли;
			
			ВычПоле.Выражение = ВыражениеВычисляемогоПоля;
			
		КонецЕсли;		
	КонецЦикла;
	
	ДобавитьВычисляемыеПоляВСхему(СхемаКомпоновкиРезультата, ВычисляемыеПоля, ПоляГруппировки);
	Если ЗначениеЗаполнено(ЗаданиеСсылка) Тогда
		НаборЗадание = СхемаКомпоновкиРезультата.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		НаборЗадание.Имя = "НаборЗадание";
		НаборЗадание.ИсточникДанных	= СхемаКомпоновкиРезультата.НаборыДанных.Найти("ВходящиеДанные").ИсточникДанных;
		НаборЗадание.АвтоЗаполнениеДоступныхПолей = Истина;

		НаборЗадание.Запрос = "ВЫБРАТЬ
		                      |	ЗаданиеНаИмпортДанныхБанкиКС.Ссылка КАК Задание,
		                      |	ИСТИНА КАК ПолеСвязи
		                      |ИЗ
		                      |	Документ.ЗаданиеНаИмпортДанныхБанкиКС КАК ЗаданиеНаИмпортДанныхБанкиКС
		                      |ГДЕ
		                      |	ЗаданиеНаИмпортДанныхБанкиКС.Ссылка = &Задание";
							  
		ПараметрЗадание = СхемаКомпоновкиРезультата.Параметры.Добавить();
		ПараметрЗадание.Имя = "Задание";
		ПараметрЗадание.Значение = ЗаданиеСсылка;
		ПараметрЗадание.ДоступенСписокЗначений = Ложь;	
		ПараметрЗадание.ОграничениеИспользования = Истина;
								  
		
		СвязьНаборовДанных = СхемаКомпоновкиРезультата.СвязиНаборовДанных.Добавить();
		СвязьНаборовДанных.НаборДанныхИсточник	= "НаборЗадание";   
		СвязьНаборовДанных.НаборДанныхПриемник	= "ВходящиеДанные";
		СвязьНаборовДанных.ВыражениеИсточник	= "ПолеСвязи";
		СвязьНаборовДанных.ВыражениеПриемник	= "СлужебноеПоле_ПолеСвязи";
	КонецЕсли;	
	
	Настройки = СхемаКомпоновкиРезультата.НастройкиПоУмолчанию;
	
	ГруппировкаСхемы = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаСхемы.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Для Каждого ПолеГруппировки Из ПоляГруппировки Цикл
		ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(ГруппировкаСхемы, ПолеГруппировки);	
	КонецЦикла;
	ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(ГруппировкаСхемы, "СлужебноеПоле_ТабличнаяЧасть");
	ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(ГруппировкаСхемы, "СлужебноеПоле_ИдентификаторСтроки");
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиРезультата, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); 
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы,,Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	
	РезультатВыполнения = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	
	Возврат РезультатВыполнения;  
	
КонецФункции

Функция ПодставитьФормулуВместоЗначения(СтрокаСоЗначением, Формула)
	
		РезультатОбработки = "";
		Попытка
			БухгалтерскиеОперацииСервер.ОбработатьФормулуРеквизитаПроводки(СтрокаСоЗначением,РезультатОбработки,"Порядок заполнения",Новый Массив,"","",ОписаниеОшибки, Ложь);
		Исключение
			ТекстОшибки = ИнформацияОбОшибке().Описание;
			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
		
		Результат = СтрЗаменить(РезультатОбработки,"<ЗНАЧЕНИЕ>",Формула);		
		
		Возврат Результат;
		
КонецФункции

Функция ЗначенияСлужебныхПолей(ИмяТабЧасти, НомераОбходовТаблиц, Инкрементировать = Ложь)
	
	Результат = Новый Структура("СлужебноеПоле_ТабличнаяЧасть, СлужебноеПоле_ИдентификаторСтроки", "", ""); 
	
	//Если ПустаяСтрока(ИмяТабЧасти) Тогда
	//	Возврат Результат;
	//КонецЕсли;
	//
	//Таблицы = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяТабЧасти, ".");
	
	Если ПустаяСтрока(ИмяТабЧасти) Тогда
		Таблицы = ОбщегоНазначенияБГУ.Массив("");
	Иначе
		Таблицы = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок("." + ИмяТабЧасти, ".");
	КонецЕсли;
	
	Если НомераОбходовТаблиц = Неопределено Тогда
		НомераОбходовТаблиц = Новый ДеревоЗначений;
		НомераОбходовТаблиц.Колонки.Добавить("ИмяТаблицы");
		НомераОбходовТаблиц.Колонки.Добавить("Количество");
	КонецЕсли;

	ТекСтрока = НомераОбходовТаблиц;
	БылаДобавлена = Ложь;
	Идентификаторы = Новый Массив;	
	
	Для Каждого Таблица Из Таблицы Цикл
		ИндексТаблицы = ТекСтрока.Строки.Найти(Таблица, "ИмяТаблицы");
		Если ИндексТаблицы = Неопределено Тогда
			ТекСтрока = ТекСтрока.Строки.Добавить();	
			ТекСтрока.ИмяТаблицы = Таблица;
			ТекСтрока.Количество = 1;
			БылаДобавлена = Истина;
		Иначе
			//ИндексТаблицы.Количество = ИндексТаблицы.Количество + 1;
			ТекСтрока = ИндексТаблицы;
		КонецЕсли;
		
		Идентификаторы.Добавить(ТекСтрока.Количество);
		
	КонецЦикла;
	
	Если Инкрементировать И Не БылаДобавлена Тогда
		ТекСтрока.Количество = ТекСтрока.Количество + 1;
		Идентификаторы[Идентификаторы.ВГраница()] = Идентификаторы[Идентификаторы.ВГраница()] + 1;
		ТекСтрока.Строки.Очистить();
	КонецЕсли;
	
	ИдентификаторСтроки = СтрСоединить(Идентификаторы, "/");
	
	Результат.СлужебноеПоле_ТабличнаяЧасть = ИмяТабЧасти;
	Результат.СлужебноеПоле_ИдентификаторСтроки = ИдентификаторСтроки;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьВычисляемыеПоляВСхему(СхемаКомпоновки, ВычисляемыеПоля, ПоляГруппировки)
	
	ВычисляемыеПоля.Свернуть("Путь,Выражение");
	
	ВычПоля = ВычисляемыеПоля.Скопировать(, "Путь");
	ВычПоля.Свернуть("Путь");
	ВычПоля = ВычПоля.ВыгрузитьКолонку("Путь");
	
	Для Каждого ВычПоле Из ВычПоля Цикл
		
		Если ПоляГруппировки.Найти(ВычПоле) = Неопределено Тогда
			ПоляГруппировки.Добавить(ВычПоле);
		КонецЕсли;
		
		ВыраженияПоля = ВычисляемыеПоля.НайтиСтроки(Новый Структура("Путь", ВычПоле));
		
		Если ВыраженияПоля.Количество() = 1 И ВыраженияПоля[0].Выражение = ВычПоле Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Выражение Из ВыраженияПоля Цикл
			ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновки, ВычПоле, Выражение.Выражение);			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

