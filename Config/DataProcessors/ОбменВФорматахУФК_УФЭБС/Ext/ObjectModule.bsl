				ВычисляемоеВыражение 	= СтрЗаменить(ВычисляемоеВыражение, "<ЗНАЧЕНИЕ>", ТекущееПравило.ПолеФайлаПередачи);
				//КонецЕсли;
				Если ПустаяСтрока(ВычисляемоеВыражение) Тогда
					ВычисляемоеВыражение = ТекущееПравило.ПолеФайлаПередачи;
				КонецЕсли;
			КонецЕсли;
			Если СоставЗагружаемогоПоляТекущегоПоля.Количество() = 2 И ВРЕГ(СоставЗагружаемогоПоляТекущегоПоля[0]) = "УСЛОВИЕФОРМИРОВАНИЯ" Тогда
				СписокУсловий.Добавить(""+СоставЗагружаемогоПоляТекущегоПоля[0]+СоставЗагружаемогоПоляТекущегоПоля[1]);
