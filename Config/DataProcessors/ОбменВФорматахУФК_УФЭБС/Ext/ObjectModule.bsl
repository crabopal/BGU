Процедура СформироватьТаблицуДанных(ПравилаЗагрузки, ТаблицаДанных, СоответствиеКолонок, СхемаКомпоновкиРезультата, ИменаРеквизитов) 	
	
	СхемаКомпоновкиРезультата = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновкиРезультата.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = СхемаКомпоновкиРезультата.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя 			= "НаборДанных1";
	НаборДанных.ИмяОбъекта 		= "ВходящиеДанные";
	НаборДанных.ИсточникДанных 	= "ИсточникДанных1";
	
	ГруппировкаСхемы = СхемаКомпоновкиРезультата.НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаСхемы.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	
	СоответствиеКолонок = Новый Соответствие;
	ТаблицаДанных = Новый ТаблицаЗначений;
	Для каждого ТекПравилоЗагрузки Из ПравилаЗагрузки Цикл
		Если ЗначениеЗаполнено(ТекПравилоЗагрузки.ПолеОбъекта) Тогда
			Если Найти(ТекПравилоЗагрузки.ПолеОбъекта, ";")=0 Тогда
				// задано поле объекта. Причем одно поле. 
				// в этом случае может быть заполнен порядок заполнения
				ИмяПоля = "Поле"+(СоответствиеКолонок.Количество()+1);
				
				ТаблицаДанных.Колонки.Добавить(ИмяПоля);
				СоответствиеКолонок.Вставить(СокрЛП(ТекПравилоЗагрузки.ПолеФайлаПередачи), ИмяПоля);
				
				Если ЗначениеЗаполнено(ТекПравилоЗагрузки.ПорядокЗаполнения) Тогда
					НовПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
					НовПоле.Поле 		= ИмяПоля;
					НовПоле.ПутьКДанным	= ИмяПоля;
					НовПоле.Роль.Обязательное = Истина;
				
					ПутьКДаннымВычисляемогоПоля = ТекПравилоЗагрузки.ПолеОбъекта;
					ВыражениеВычисляемогоПоля = СтрЗаменить(ТекПравилоЗагрузки.ПорядокЗаполнения, "Значение", ИмяПоля);
					
					Если Не ПустаяСтрока(ТекПравилоЗагрузки.ПравилоФорматированияИмпорт) Тогда
						ВыражениеВычисляемогоПоля = СтрЗаменить(ТекПравилоЗагрузки.ПравилоФорматированияИмпорт, "Значение", ВыражениеВычисляемогоПоля);	
					КонецЕсли;	
					
					ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновкиРезультата, ПутьКДаннымВычисляемогоПоля, ВыражениеВычисляемогоПоля);
					
				Иначе
					НовПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
					НовПоле.Поле 		= ИмяПоля;
					НовПоле.ПутьКДанным	= ТекПравилоЗагрузки.ПолеОбъекта;
					НовПоле.Роль.Обязательное = Истина;
				КонецЕсли;
				
				ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(ГруппировкаСхемы, ТекПравилоЗагрузки.ПолеОбъекта);
				ДобавитьИмяРеквизитаВСтруктуру(ТекПравилоЗагрузки.ПолеОбъекта, ИменаРеквизитов);
			Иначе
				// задано несколько полей.
				// поле набора данных будет одно
				ИмяПоля = "Поле"+(СоответствиеКолонок.Количество()+1);
				
				ТаблицаДанных.Колонки.Добавить(ИмяПоля);
				СоответствиеКолонок.Вставить(СокрЛП(ТекПравилоЗагрузки.ПолеФайлаПередачи), ИмяПоля);
				
				НовПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
				НовПоле.Поле 		= ИмяПоля;
				НовПоле.ПутьКДанным	= ИмяПоля;
				НовПоле.Роль.Обязательное = Истина;
				
				РазложениеПолей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекПравилоЗагрузки.ПолеОбъекта, ";");
				// для каждого поля объекта сделаем вычисляемое поле
				Для Каждого ТекПолеОбъекта Из РазложениеПолей Цикл
					
					Если ЗначениеЗаполнено(ТекПолеОбъекта) Тогда
						ПутьКДаннымВычисляемогоПоля = ТекПолеОбъекта;
						ВыражениеВычисляемогоПоля 	= ИмяПоля;
						ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновкиРезультата, ПутьКДаннымВычисляемогоПоля, ВыражениеВычисляемогоПоля);
						
						ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(ГруппировкаСхемы, ТекПолеОбъекта);
						ДобавитьИмяРеквизитаВСтруктуру(ТекПолеОбъекта, ИменаРеквизитов);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
				
		КонецЕсли;		
	КонецЦикла; 
КонецПроцедуры

Процедура ДобавитьИмяРеквизитаВСтруктуру(ПолеОбъекта, ИменаРеквизитов)
	Если ИменаРеквизитов = Неопределено Тогда
		ИменаРеквизитов = Новый Соответствие;
	КонецЕсли;
	СоставИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПолеОбъекта, ".");
	Если ИменаРеквизитов.Получить(СоставИмени[0]) = Неопределено Тогда
		Если СоставИмени.Количество() = 2 Тогда
			ИменаРеквизитов.Вставить(СоставИмени[0], Новый Соответствие);
		Иначе
			ИменаРеквизитов.Вставить(СоставИмени[0], СоставИмени[0]);
		КонецЕсли;			
	КонецЕсли;
	Если СоставИмени.Количество() = 2 Тогда
		ИменаРеквизитов[СоставИмени[0]].Вставить(СоставИмени[1], СоставИмени[0]+СоставИмени[1]);
	КонецЕсли;
КонецПроцедуры

Процедура ОчиститьТабличныеЧасти(ДокументОбъект)
