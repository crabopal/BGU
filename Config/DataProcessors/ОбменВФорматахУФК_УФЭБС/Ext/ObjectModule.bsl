		ДокументОбъект[ТабличнаяЧасть.Имя].Очистить();
	КонецЦикла;	
КонецПроцедуры	

// Заменяет некоторые ключевые слова встроенного языка, чтобы код работал в вычисляемом поле СКД
//
Функция ПреобразоватьПодСКД(Знач Строка)
	Возврат Строка;
	Результат = "";
	Если Лев(ВРЕГ(Строка), 13) = "ПЕРЕЧИСЛЕНИЯ." Тогда
		Результат = "Значение(Перечисление.";
		Строка = Сред(Строка, 14);
		Результат = Результат + Строка+")";
	ИначеЕсли Лев(ВРЕГ(Строка), 12) = "СПРАВОЧНИКИ." Тогда
		Результат = "Значение(Справочник.";
		Строка = Сред(Строка, 13);
		Результат = Результат + Строка+")";
	ИначеЕсли ЛЕВ(ВРЕГ(Строка), 6) = "ЧИСЛО(" Тогда
		Результат = СтрЗаменить(ВРЕГ(Строка), "ЧИСЛО(", "БиблиотекаФункцийОбмена.СтрокаВЧисло(");
		//Результат = "Выразить("+Сред(Строка, 7, СтрДлина(Строка)-7)+", ""Число"")" ;
	Иначе
		Результат = Строка;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Получает выражение для вычисляемого поля СКД из текста на встроенном языке
Функция ФункцияВычисленияПараметра(СтрокаФункции, ИмяПараметра, ФункцияВычисления = "")
	Результат = Ложь;
	СтрокиФункции = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаФункции, ";");
	Для каждого ТекСтрокаФункции Из СтрокиФункции Цикл
	
		Если Найти(ТекСтрокаФункции, "=")>0 Тогда
			ЧастиРавенства = РазобратьРавенство(ТекСтрокаФункции);
			Если ВРЕГ(ЧастиРавенства[0])=ВРЕГ(ИмяПараметра) Тогда
				ФункцияВычисления = ПреобразоватьПодСКД(ЧастиРавенства[1]);
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура УстановитьСоответствующееПолеРасшифровки(СтруктураТекущегоПоля, РеквизитыСтруктурыВРасшифровке)
	
	РазложениеПутиКДанным = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтруктураТекущегоПоля.ПутьКДанным, ".");
	
	Если Найти(СтруктураТекущегоПоля.Поле, ".") > 0 Тогда
		ТекущаяСекция         = Лев(СтруктураТекущегоПоля.Поле, Найти(СтруктураТекущегоПоля.Поле, ".") - 1); 
	КонецЕсли;
		
	Если РазложениеПутиКДанным.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоля = РазложениеПутиКДанным[РазложениеПутиКДанным.ВГраница()];
	
	Если РеквизитыСтруктурыВРасшифровке[ТекущаяСекция].Получить(ИмяПоля) <> Неопределено Тогда
		
		РеквизитыСтруктурыВРасшифровке[ТекущаяСекция][ИмяПоля] = СтруктураТекущегоПоля.ПутьКДанным;
		
	ИначеЕсли РазложениеПутиКДанным.Количество() = 2 Тогда
		
		Если РеквизитыСтруктурыВРасшифровке[ТекущаяСекция].Получить(РазложениеПутиКДанным[0]) = Неопределено Тогда
			РеквизитыСтруктурыВРасшифровке[ТекущаяСекция].Вставить(РазложениеПутиКДанным[0], Новый Структура);
		ИначеЕсли ТипЗнч(РеквизитыСтруктурыВРасшифровке[ТекущаяСекция][РазложениеПутиКДанным[0]]) <> Тип("Структура") Тогда
			РеквизитыСтруктурыВРасшифровке[ТекущаяСекция][РазложениеПутиКДанным[0]] = Новый Структура;
		КонецЕсли;
		
		Если НЕ РеквизитыСтруктурыВРасшифровке[ТекущаяСекция][РазложениеПутиКДанным[0]].Свойство(РазложениеПутиКДанным[1]) Тогда
			РеквизитыСтруктурыВРасшифровке[ТекущаяСекция][РазложениеПутиКДанным[0]].Вставить(РазложениеПутиКДанным[1], СтруктураТекущегоПоля.ПутьКДанным);
		Иначе
			РеквизитыСтруктурыВРасшифровке[ТекущаяСекция][РазложениеПутиКДанным[0]][РазложениеПутиКДанным[1]] = СтруктураТекущегоПоля.ПутьКДанным;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоПроизвольныеПараметры(ДопДействия)
