// создает таблицу значений для хранения данных из файла расшифровки
//
Функция СоздатьИсточник_Расшифровка(ЭлементБД, Идендификатор)
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	
	ПравилаОбмена = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(ЭлементБД);
	
	Для каждого ТекСтрока Из ПравилаОбмена Цикл
		
		Если Лев(ТекСтрока.ПолеФайлаПередачи, 3)    = "FK."
			ИЛИ Лев(ТекСтрока.ПолеФайлаПередачи, 5) = "FROM."
			ИЛИ Лев(ТекСтрока.ПолеФайлаПередачи, 7) = "SECURE."
			ИЛИ Лев(ТекСтрока.ПолеФайлаПередачи, 3) = "TO."    
			ИЛИ Сред(ТекСтрока.ПолеФайлаПередачи, 5, 5) = "CONTR" Тогда
			Продолжить;
		КонецЕсли;
	
		ТаблицаРезультат.Колонки.Добавить(СтрЗаменить(ТекСтрока.ПолеФайлаПередачи, ".", "_"));
	
	КонецЦикла;
	
	ТаблицаРезультат.Колонки.Добавить(Идендификатор + "_ID");
	
	Возврат ТаблицаРезультат;
	
Конецфункции

// заполняет таблицу для хранения входящих данных из файла "структура" 
//
Процедура ЗагрузитьИсточник_Расшифровка(Знач Текст, ТаблицаРезультат, ИдентификаторДокумента)
	
	Если ТипЗнч(Текст) <> Тип("ТекстовыйДокумент") Тогда
		ВрТекст = Текст;
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(ВрТекст);
	КонецЕсли;
	
	МассивКолонок = Новый Массив;
	НачалоБДПЛ    = 0;
	
	Для каждого ТекКолонка Из ТаблицаРезультат.Колонки Цикл
		МассивКолонок.Добавить(ТекКолонка.Имя);
		Если Лев(ТекКолонка.Имя, 4) = "BDPL" и НачалоБДПЛ = 0 Тогда
			 НачалоБДПЛ     = МассивКолонок.ВГраница();
		КонецЕсли;
	КонецЦикла; 
	
	ТаблицаРезультат.Колонки.Добавить("BD_GUID_ONE");
	
	МассивБД   = Новый Массив; 	// для хранения данных строки BD
	МассивБДПД = Новый Массив;	// для хранения данных строки BDPD
	МассивБДПЛ = Новый Массив;  // для хранения данных строки BDPL
	
	КоличествоСтрок = Текст.КоличествоСтрок();
	Для СчетчикСтрок=1 По КоличествоСтрок Цикл
		
		ТекущаяСтрока = Текст.ПолучитьСтроку(СчетчикСтрок);
		
		Если Лев(ТекущаяСтрока, 3) = "FK|"
			ИЛИ Лев(ТекущаяСтрока, 5) = "FROM|"
			ИЛИ Лев(ТекущаяСтрока, 7) = "SECURE|"
			ИЛИ Лев(ТекущаяСтрока, 3) = "TO|"
			ИЛИ Сред(ТекущаяСтрока, 5, 5) = "CONTR" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Лев(ТекущаяСтрока, 3) = "BD|" Тогда
			МассивБД = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивБД.Удалить(МассивБД.ВГраница());
		ИначеЕсли СокрЛП(ТекущаяСтрока) = "" Тогда   //если это пустая строка
			Продолжить;
		ИначеЕсли Лев(ТекущаяСтрока, 5) = "BDPD|" Тогда
			МассивБДПД = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивБДПД.Удалить(МассивБДПД.ВГраница());
		ИначеЕсли Лев(ТекущаяСтрока, 7) = "BDPDST|" Тогда
			МассивБДПДСТ = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивБДПДСТ.Удалить(МассивБДПДСТ.ВГраница());
			
			НоваяСтрока = ТаблицаРезультат.Добавить();
			НоваяСтрока.BD_ID = ИдентификаторДокумента;
			СчетчикКолонок = 0;
			Для СчетчикМассива = 1 По МассивБД.ВГраница() Цикл
				Если СчетчикКолонок > МассивКолонок.ВГраница() Тогда
					ВызватьИсключение НСтр("ru = 'Структура файла BD не соостветствует структуре формата'");
				КонецЕсли;
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивБД[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			Для СчетчикМассива = 1 По МассивБДПД.ВГраница() Цикл
				Если СчетчикКолонок > МассивКолонок.ВГраница() Тогда
					ВызватьИсключение НСтр("ru = 'Структура файла BD не соостветствует структуре формата'");
				КонецЕсли;
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивБДПД[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			Для СчетчикМассива = 1 По МассивБДПДСТ.ВГраница() Цикл
				Если СчетчикКолонок > МассивКолонок.ВГраница() Тогда
					ВызватьИсключение НСтр("ru = 'Структура файла BD не соостветствует структуре формата'");
				КонецЕсли;
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивБДПДСТ[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			
			НоваяСтрока["BD_GUID_ONE"] =  НоваяСтрока["BDPD_GUID"];
			
		ИначеЕсли Лев(ТекущаяСтрока, 5) = "BDPL|" Тогда
			МассивБДПЛ = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивБДПЛ.Удалить(МассивБДПЛ.ВГраница());
		ИначеЕсли Лев(ТекущаяСтрока, 7) = "BDPLST|" Тогда
			МассивБДПЛСТ = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивБДПЛСТ.Удалить(МассивБДПЛСТ.ВГраница());
			
			НоваяСтрока        = ТаблицаРезультат.Добавить();
			НоваяСтрока.BD_ID  = ИдентификаторДокумента;
			СчетчикКолонок     = 0;
			
			Для СчетчикМассива = 1 По МассивБД.ВГраница() Цикл
				Если СчетчикКолонок > МассивКолонок.ВГраница() Тогда
					ВызватьИсключение НСтр("ru = 'Структура файла BD не соостветствует структуре формата'");
				КонецЕсли;
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивБД[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			
			СчетчикКолонок     = НачалоБДПЛ;
			
			Для СчетчикМассива = 1 По МассивБДПЛ.ВГраница() Цикл
				Если СчетчикКолонок > МассивКолонок.ВГраница() Тогда
					ВызватьИсключение НСтр("ru = 'Структура файла BD не соостветствует структуре формата'");
				КонецЕсли;
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивБДПЛ[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			Для СчетчикМассива = 1 По МассивБДПЛСТ.ВГраница() Цикл
				Если СчетчикКолонок > МассивКолонок.ВГраница() Тогда
					ВызватьИсключение НСтр("ru = 'Структура файла BD не соостветствует структуре формата'");
				КонецЕсли;
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивБДПЛСТ[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;	
			
			НоваяСтрока["BD_GUID_ONE"] =  НоваяСтрока["BDPL_GUID"];
			
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьИсточник_Расшифровка_ВО(Знач Текст, ТаблицаРезультат, ИдентификаторДокумента)
	
	Если ТипЗнч(Текст) <> Тип("ТекстовыйДокумент") Тогда
		ВрТекст = Текст;
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(ВрТекст);
	КонецЕсли;
	
	МассивКолонок = Новый Массив;
	
	НачалоЗКР     = 0;
	НачалоЗВ      = 0;
	НачалоПП      = 0;
	НачалоЗВосн   = 0;
	НачалоЗВконтр = 0;
	
	Для каждого ТекКолонка Из ТаблицаРезультат.Колонки Цикл
		
		МассивКолонок.Добавить(ТекКолонка.Имя);
		
		Если Лев(ТекКолонка.Имя, 2) = "ZR" и НачалоЗКР = 0 Тогда
			 НачалоЗКР     = МассивКолонок.ВГраница();
		ИначеЕсли Лев(ТекКолонка.Имя, 2) = "ZV" и НачалоЗВ = 0 Тогда
			 НачалоЗВ      = МассивКолонок.ВГраница();
	    ИначеЕсли Лев(ТекКолонка.Имя, 8) = "ZVDOCOSN" и НачалоЗВосн = 0 Тогда
			 НачалоЗВосн   = МассивКолонок.ВГраница();
		ИначеЕсли Лев(ТекКолонка.Имя, 8) = "ZVDOCPOL" и НачалоЗВконтр = 0 Тогда
			 НачалоЗВконтр = МассивКолонок.ВГраница();
		ИначеЕсли Лев(ТекКолонка.Имя, 2) = "PP" и НачалоПП = 0 Тогда
			 НачалоПП      = МассивКолонок.ВГраница();	 
		КонецЕсли;
		
	КонецЦикла; 
	
	ТаблицаРезультат.Колонки.Добавить("BH_GUID_ONE");
	
	МассивГрупп    = Новый Массив; 	
	МассивЗКР      = Новый Массив;	
	МассивЗКРосн   = Новый Массив;
	МассивЗВ       = Новый Массив;
    МассивЗВдок    = Новый Массив;	
	МассивЗВ1      = Новый Массив;
	МассивЗВ2      = Новый Массив;
	МассивПП       = Новый Массив;
	МассивППст     = Новый Массив;
	
	КоличествоСтрок = Текст.КоличествоСтрок();   
	
	Для СчетчикСтрок=1 По КоличествоСтрок Цикл
		
		ТекущаяСтрока = Текст.ПолучитьСтроку(СчетчикСтрок);
		
		Если Лев(ТекущаяСтрока, 3) = "FK|"
			ИЛИ Лев(ТекущаяСтрока, 5) = "FROM|"
			ИЛИ Лев(ТекущаяСтрока, 3) = "TO|" Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(ТекущаяСтрока, 3) = "BH|" Тогда
			МассивГрупп = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивГрупп.Удалить(МассивГрупп.ВГраница());
		ИначеЕсли Лев(ТекущаяСтрока, 3) = "ZR|" Тогда
			МассивЗКР = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивЗКР.Удалить(МассивЗКР.ВГраница());
		ИначеЕсли Лев(ТекущаяСтрока, 6) = "ZROSN|" Тогда
			МассивЗКРосн = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивЗКРосн.Удалить(МассивЗКРосн.ВГраница());
		ИначеЕсли Лев(ТекущаяСтрока, 5) = "ZRST|" Тогда
			МассивЗКРСтр = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивЗКРСтр.Удалить(МассивЗКРСтр.ВГраница());
			
			НоваяСтрока       = ТаблицаРезультат.Добавить();
			НоваяСтрока.BH_ID = ИдентификаторДокумента;
			СчетчикКолонок    = 0;
			
			Для СчетчикМассива = 1 По МассивГрупп.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивГрупп[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			Для СчетчикМассива = 1 По МассивЗКР.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивЗКР[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			Для СчетчикМассива = 1 По МассивЗКРосн.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивЗКРосн[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			Для СчетчикМассива = 1 По МассивЗКРСтр.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивЗКРСтр[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			
			НоваяСтрока["BH_GUID_ONE"] =  НоваяСтрока["ZR_GUID_FK"];
			
		ИначеЕсли Лев(ТекущаяСтрока, 3) = "ZV|" Тогда
			МассивЗВ = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивЗВ.Удалить(МассивЗВ.ВГраница());
		ИначеЕсли Лев(ТекущаяСтрока, 6) = "ZVDOC|" Тогда
			МассивЗВдок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивЗВдок.Удалить(МассивЗВдок.ВГраница());
			
			НоваяСтрока       = ТаблицаРезультат.Добавить();
			НоваяСтрока.BH_ID = ИдентификаторДокумента;
			СчетчикКолонок    = 0;
			
			Для СчетчикМассива = 1 По МассивГрупп.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивГрупп[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;

			СчетчикКолонок = НачалоЗВ;
			
			Для СчетчикМассива = 1 По МассивЗВ.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивЗВ[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
            Для СчетчикМассива = 1 По МассивЗВдок.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивЗВдок[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			
			НоваяСтрока["BH_GUID_ONE"] =  НоваяСтрока["ZV_GUID_FK"];
			
        ИначеЕсли Лев(ТекущаяСтрока, 9) = "ZVDOCOSN|" Тогда
			МассивЗВ1 = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивЗВ1.Удалить(МассивЗВ1.ВГраница());
			
			СчетчикКолонок = НачалоЗВосн;
			
			Для СчетчикМассива = 1 По МассивЗВ1.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивЗВ1[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			
	    ИначеЕсли Лев(ТекущаяСтрока, 9) = "ZVDOCPOL|" Тогда
			МассивЗВ2 = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивЗВ2.Удалить(МассивЗВ2.ВГраница());
			
			СчетчикКолонок = НачалоЗВконтр;
			
			Для СчетчикМассива = 1 По МассивЗВ2.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивЗВ2[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			
		ИначеЕсли Лев(ТекущаяСтрока, 4) = "PPT|" Тогда
			МассивПП = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивПП.Удалить(МассивПП.ВГраница());
        ИначеЕсли Лев(ТекущаяСтрока, 5) = "PPST|" Тогда
			МассивППст = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСтрока, "|");
			МассивППст.Удалить(МассивППст.ВГраница());
			
			НоваяСтрока       = ТаблицаРезультат.Добавить();
			НоваяСтрока.BH_ID = ИдентификаторДокумента;
			СчетчикКолонок    = 0;
			
			Для СчетчикМассива = 1 По МассивГрупп.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивГрупп[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;

			СчетчикКолонок = НачалоПП;
		
			Для СчетчикМассива = 1 По МассивПП.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивПП[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
            Для СчетчикМассива = 1 По МассивППст.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивППст[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;  
			
			НоваяСтрока["BH_GUID_ONE"] =  НоваяСтрока["PPT_GUID_FK"];
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


// возвращает схему компоновки данных на основании правил загрузки документов
//
//Функция СоздатьСКДПоПравиламОбмена(ПравилаВыписки, ПравилаРасшифровки, ПравилаРасшифровки_ВО, ИсточникиДанных, ПараметрыГруппировок, 
//	СоответствиеРеквизитовШапки, РеквизитыСтруктурыВРасшифровке, СоответствиеРеквизитовГруппировок = Неопределено, 
//	ПроцедурыОбработкиСтрок, СписокУсловий = Неопределено, НомерДокумента = 0)
	
Функция СоздатьСКДПоПравиламОбмена(ДанныеДляИсточника, ИсточникиДанных, ПараметрыГруппировок, 
	СоответствиеРеквизитовШапки, РеквизитыСтруктурыВРасшифровке, СоответствиеРеквизитовГруппировок = Неопределено, 
	ПроцедурыОбработкиСтрок, СписокУсловий = Неопределено, НомерДокумента = 0)
	
	Перем Отказ; 
	Перем ОписаниеОшибки;
	Перем ПравилаВыписки;
	Перем ПравилаРасшифровки;
	Перем ПравилаРасшифровки_ВО;
	Перем ПравилаРасшифровки_ВС;
	
	ДанныеДляИсточника.Свойство("ФорматОсновногоФайла", 	ПравилаВыписки);
	ДанныеДляИсточника.Свойство("ФорматФайлаСтруктура", 	ПравилаРасшифровки);
	ДанныеДляИсточника.Свойство("ФорматФайлаСтруктура_ВО", 	ПравилаРасшифровки_ВО);
	ДанныеДляИсточника.Свойство("ФорматФайлаСтруктура_ВС", 	ПравилаРасшифровки_ВС);
	
	Отказ = Ложь;
	
	Если СписокУсловий = Неопределено Тогда    // условия, которые заданы ключом  УСЛОВИЕФОРМИРОВАНИЯ.<ИмяУсловия>
		СписокУсловий = Новый СписокЗначений;
	КонецЕсли;
	
	// зададим параметры для обработки выражений вычисляемых полей СКД
	РазрешенныеОбщиеМодули = Новый Массив;
	РазрешенныеОбщиеМодули.Добавить(ВРЕГ("БиблиотекаФункцийОбмена")); 
	
	ЗаменяемыеСлова = Новый Массив;
	ЗаменяемыеСлова.Добавить(ВРЕГ("Значение"));
	
	ЗаменяющиеСлова = Новый Массив;
	ЗаменяющиеСлова.Добавить("<ЗНАЧЕНИЕ>");
	//
	
	СоответствиеРеквизитовГруппировок = Новый Соответствие;
	ПараметрыГруппировок = Новый Соответствие;
	СоответствиеРеквизитовШапки	= Новый Соответствие;
	
	// заполняем структуру 
	РеквизитыСтруктурыВРасшифровке    = ЧистаяСтруктураРасшифровки();
			
	ПравилаОбмена = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(ПравилаВыписки);
	ОписаниеТипаСтроки = ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(150);
	ПравилаОбмена.Колонки.Добавить("ИмяПоляОбъекта", ОписаниеТипаСтроки);
